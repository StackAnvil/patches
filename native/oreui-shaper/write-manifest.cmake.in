set(directory "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@resource@")
file(SHA256 "${directory}/${library_name}" library_sha256)
file(WRITE "${directory}/manifest.json"
"{\n  \"format\": 1,\n  \"engine\": \"HarfBuzz\",\n  \"version\": \"@HARFBUZZ_VERSION@\",\n  \"target\": \"Bedrock 1.26.60.5 OreUI\",\n  \"platform\": \"@platform@\",\n  \"architecture\": \"@architecture@\",\n  \"sourceSha256\": \"@HARFBUZZ_SHA256@\",\n  \"patchSha256\": \"@COMPATIBILITY_SHA256@\",\n  \"library\": \"${library_name}\",\n  \"sha256\": \"${library_sha256}\"\n}\n")
