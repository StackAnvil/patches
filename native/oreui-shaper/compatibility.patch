+#ifndef OT_LAYOUT_GPOS_NATIVEINTEGERANCHOR_HH
+#define OT_LAYOUT_GPOS_NATIVEINTEGERANCHOR_HH
+
+#ifdef STACKANVIL_OREUI_COMPATIBILITY
+namespace OT { namespace Layout { namespace GPOS_impl {
+// Bedrock 1.26.60.5 rounds each signed anchor before subtracting mark positions.
+static inline float native_integer_anchor (hb_font_t *font, int16_t coordinate, int32_t scale)
+{
+  int64_t upem = font->face->get_upem ();
+  int64_t product = int64_t (coordinate) * scale;
+  return float ((product + (product < 0 ? -(upem / 2) : upem / 2)) / upem);
+}
+}}}
+#endif
+
+#endif
