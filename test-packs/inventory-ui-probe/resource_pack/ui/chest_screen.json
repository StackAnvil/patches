{
  "namespace": "chest",
  "small_chest_screen": {
    "$screen_content": "chest.small_chest_panel",
    "variables": [
      {
        "requires": "($container_title = 'StackAnvil count-one probe')",
        "$screen_content": "chest.stackanvil_count_one_panel"
      }
    ]
  },
  "stackanvil_count_one_panel": {
    "type": "panel",
    "size": [
      176,
      168
    ],
    "controls": [
      {
        "background@common.common_panel": {
          "$show_close_button": false
        }
      },
      {
        "title": {
          "type": "label",
          "text": "Move one emerald",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            24,
            8
          ],
          "layer": 3,
          "color": [
            0.25,
            0.25,
            0.25
          ]
        }
      },
      {
        "items": {
          "type": "grid",
          "collection_name": "container_items",
          "grid_dimensions": [
            9,
            3
          ],
          "size": [
            162,
            54
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            7,
            20
          ],
          "layer": 3,
          "controls": [
            {
              "source@chest.stackanvil_count_one_cell": {
                "grid_position": [
                  0,
                  1
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "stackanvil_count_one_cell": {
    "type": "button",
    "size": [
      18,
      18
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place_one",
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/item_cell",
          "size": [
            18,
            18
          ]
        }
      },
      {
        "item": {
          "type": "custom",
          "renderer": "inventory_item_renderer",
          "size": [
            16,
            16
          ],
          "layer": 1,
          "bindings": [
            {
              "binding_name": "#item_renderer_data",
              "binding_name_override": "#item_id_aux"
            }
          ]
        }
      }
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  }
}
