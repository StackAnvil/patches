{
  "format_version": "1.8.0",
  "animations": {
    "animation.stackanvil.probe.spin": { "loop": true, "animation_length": 2, "bones": { "rotor": { "rotation": { "0.0": [0, 0, 0], "2.0": [0, 360, 0] } } } },
    "animation.stackanvil.probe.phase": {
      "loop": true,
      "bones": {
        "body": { "rotation": [0, "query.property('stackanvil:phase') * 30", 0] },
        "head": { "scale": "0.75 + query.property('stackanvil:health') * 0.25" },
        "left": { "rotation": ["math.sin(query.life_time * 180) * 20", 0, 0] },
        "right": { "rotation": ["-math.sin(query.life_time * 180) * 20", 0, 0] }
      }
    }
  }
}
