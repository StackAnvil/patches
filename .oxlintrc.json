{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/strict.json",
    "./node_modules/@effect/tsgo/oxlint-presets/antipattern.json"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "effecttsgo"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/styles/app.css"
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/generated/**",
    "**/gen/**",
    ".repos/**",
    "site/.source/**",
    "site/src/routeTree.gen.ts"
  ],
  "rules": {
    // Existing code uses truthiness checks for strings, numbers, and nullable values.
    "effecttsgo/strict-boolean-expressions": "off",
    "effecttsgo/acquire-release-disposable": "error",
    "effecttsgo/all-of-map-to-for-each": "error",
    "effecttsgo/catch-all-tag-dispatch-to-catch-tag": "error",
    "effecttsgo/catch-all-to-map-error": "error",
    "effecttsgo/catch-chain-to-first-success-of": "error",
    "effecttsgo/catch-conditional-refail-to-catch-if": "error",
    "effecttsgo/catch-die-to-or-die": "error",
    "effecttsgo/catch-if-tag-to-catch-tag": "error",
    "effecttsgo/catch-refail-to-tap-error": "error",
    "effecttsgo/catch-tag-to-catch-reason": "error",
    "effecttsgo/catch-to-ignore": "error",
    "effecttsgo/catch-to-or-else-succeed": "error",
    "effecttsgo/catch-unfailable-effect": "error",
    "effecttsgo/deterministic-keys": "error",
    "effecttsgo/effect-do-notation": "error",
    "effecttsgo/effect-fn-iife": "error",
    "effecttsgo/effect-fn-opportunity": "error",
    "effecttsgo/effect-gen-uses-adapter": "error",
    "effecttsgo/effect-in-failure": "error",
    "effecttsgo/effect-in-void-success": "error",
    "effecttsgo/effect-map-flatten": "error",
    "effecttsgo/effect-map-void": "error",
    "effecttsgo/effect-sleep-zero-to-yield-now": "error",
    "effecttsgo/effect-succeed-with-undefined": "error",
    "effecttsgo/effect-succeed-with-void": "error",
    "effecttsgo/effect-try-without-catch": "error",
    "effecttsgo/fail-cause-to-constructor": "error",
    "effecttsgo/flat-map-conditional-to-filter-or-fail": "error",
    "effecttsgo/flat-map-identity-to-flatten": "error",
    "effecttsgo/flat-map-ignored-param-to-and-then": "error",
    "effecttsgo/flat-map-provide-service-to-provide-service-effect": "error",
    "effecttsgo/flat-map-to-map": "error",
    "effecttsgo/flat-map-to-tap": "error",
    "effecttsgo/for-loop-push-to-for-each": "error",
    "effecttsgo/global-error-in-effect-catch": "error",
    "effecttsgo/global-error-in-effect-failure": "error",
    "effecttsgo/layer-merge-all-with-dependencies": "error",
    "effecttsgo/lazy-effect": "error",
    "effecttsgo/lazy-promise-in-effect-sync": "error",
    "effecttsgo/leaking-requirements": "error",
    "effecttsgo/manual-metric-tap-to-track": "error",
    "effecttsgo/map-const-to-as": "error",
    "effecttsgo/map-map-error-to-map-both": "error",
    "effecttsgo/map-some-catch-no-such-element": "error",
    "effecttsgo/map-some-to-as-some": "error",
    "effecttsgo/match-boolean-to-is-success": "error",
    "effecttsgo/match-effect-to-map-both": "error",
    "effecttsgo/match-effect-to-match": "error",
    "effecttsgo/match-to-result-or-option": "error",
    "effecttsgo/missed-pipeable-opportunity": "error",
    "effecttsgo/missing-concurrency-option": "error",
    "effecttsgo/missing-effect-service-dependency": "error",
    "effecttsgo/multiple-catch-tag": "error",
    "effecttsgo/multiple-effect-provide": "error",
    "effecttsgo/nested-effect-gen-yield": "error",
    "effecttsgo/new-schema-class": "error",
    "effecttsgo/on-exit-failure-to-on-error": "error",
    "effecttsgo/option-match-to-from-option": "error",
    "effecttsgo/prefer-barrel-import": "error",
    "effecttsgo/prefer-namespace-import": "error",
    "effecttsgo/prefer-schema-type-property": "error",
    "effecttsgo/prefer-succeed-some-or-none": "error",
    "effecttsgo/prefer-typed-schema-decoder": "error",
    "effecttsgo/prefer-unsafe-constructor": "error",
    "effecttsgo/provide-layer-succeed-to-provide-service": "error",
    "effecttsgo/provide-merge-all-to-array": "error",
    "effecttsgo/race-first-with-sleep-to-timeout": "error",
    "effecttsgo/redundant-map-error": "error",
    "effecttsgo/redundant-or-die": "error",
    "effecttsgo/redundant-schema-tag-identifier": "error",
    "effecttsgo/result-match-to-from-result": "error",
    "effecttsgo/return-effect-in-gen": "error",
    "effecttsgo/run-effect-inside-effect": "error",
    "effecttsgo/run-of-exit-to-run-exit": "error",
    "effecttsgo/schema-number": "error",
    "effecttsgo/schema-struct-with-tag": "error",
    "effecttsgo/schema-sync-in-effect": "error",
    "effecttsgo/schema-union-of-literals": "error",
    "effecttsgo/scope-in-layer-effect": "error",
    "effecttsgo/service-not-as-class": "error",
    "effecttsgo/suspend-fail-to-fail-sync": "error",
    "effecttsgo/sync-to-succeed": "error",
    "effecttsgo/timeout-catch-tag-to-timeout-or-else": "error",
    "effecttsgo/try-catch-in-effect-gen": "error",
    "effecttsgo/type-union-to-schema-union": "error",
    "effecttsgo/unknown-in-effect-catch": "error",
    "effecttsgo/unnecessary-arrow-block": "error",
    "effecttsgo/unnecessary-effect-gen": "error",
    "effecttsgo/unnecessary-fail-yieldable-error": "error",
    "effecttsgo/unnecessary-pipe": "error",
    "effecttsgo/unnecessary-pipe-chain": "error",
    "effecttsgo/unnecessary-typeof-type": "error",

    "typescript/consistent-return": "error",
    // Consistent returns can require an explicit return undefined.
    "unicorn/no-useless-undefined": "off",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-import-type-side-effects": "error",
    "unicorn/error-message": "error",
    "unicorn/throw-new-error": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-shadow": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/no-alert": "error",
    "eslint/no-script-url": "error",
    "unicorn/no-document-cookie": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-template": "error",
    "eslint/logical-assignment-operators": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-response-static-json": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "oxc/no-map-spread": "error",
    "oxc/no-barrel-file": "error",
    "effecttsgo/global-date-in-effect": "error",
    "effecttsgo/global-json-in-effect": "error",
    "effecttsgo/process-env-in-effect": "error",
    "effecttsgo/crypto-random-uuid-in-effect": "error",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/prefer-schema-over-json": "error",
    "effecttsgo/prefer-schema-tagged-error": "error",
    "effecttsgo/extends-native-error": "error",
    "effecttsgo/yield-in-call-argument": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "effecttsgo/strict-effect-provide": "off",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["__typename"]
      }
    ],
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    // A default clause handles undefined in switches over optional CLI arguments.
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-console": "error",
    "eslint/no-await-in-loop": "off",
    "import/no-duplicates": "error",
    "import/no-cycle": ["error", { "ignoreTypes": true }],
    "promise/catch-or-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/no-useless-call": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-useless-empty-export": "error",
    // Stream readers loop with `while (true)` until `done`.
    "typescript/no-unnecessary-condition": [
      "error",
      { "allowConstantLoopConditions": "only-allowed-literals" }
    ],
    // Empty environment strings fall back to defaults, so `||` stays valid for strings.
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "typescript/require-await": "error",
    "typescript/no-non-null-assertion": "error",
    // Pedantic rules that only measure size, encode style opinions, or duplicate configured rules.
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    // typescript/require-await covers this and understands type information.
    "eslint/require-await": "off",
    // Conflicts with the prefer-nullish-coalescing ignorePrimitives setup above.
    "typescript/strict-boolean-expressions": "off",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/array-type": "error",
    // Effect.fn generators type defaulted parameters as `any` unless they are annotated.
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/prefer-function-type": "error",
    "typescript/consistent-indexed-object-style": "error",
    "unicorn/switch-case-braces": "error",
    "eslint/no-useless-assignment": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "scripts/**/*.ts", "site/scripts/**/*.ts"],
      "rules": {
        "effecttsgo/global-timers": "error",
        "effecttsgo/global-random": "error",
        "effecttsgo/crypto-random-uuid": "error",
        "effecttsgo/global-console": "error"
      }
    },
    {
      "files": ["site/**"],
      "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/self-closing-comp": "error",
        "react/jsx-boolean-value": "error",
        "react/jsx-curly-brace-presence": "error",
        "react/jsx-fragments": "error",
        "react/hook-use-state": "error",
        "react/react-in-jsx-scope": "off",
        "react/jsx-no-target-blank": "error",
        "react/button-has-type": "error",
        "react/no-danger": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/no-unknown-property": "error",
        "react/only-export-components": "error",
        "react/jsx-no-constructed-context-values": "error",
        "react/no-array-index-key": "error",
        "react/no-deriving-state-in-effects": "error",
        "react/no-object-type-as-default-prop": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/enforce-canonical-classes": "error",
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "ignore": [
              "^actions$",
              "^anvil$",
              "^brand$",
              "^button$",
              "^chip-icon$",
              "^chip-size$",
              "^chip-text$",
              "^compatibility-line$",
              "^dark$",
              "^desktop-nav$",
              "^dev-links$",
              "^docs-shell$",
              "^download-chip$",
              "^download-details$",
              "^download-fallback$",
              "^download-files$",
              "^downloads$",
              "^experimental-note$",
              "^face-left$",
              "^face-right$",
              "^face-top$",
              "^faq$",
              "^faq-answer$",
              "^faq-icon$",
              "^faq-item$",
              "^faq-section$",
              "^feature-note$",
              "^feature-panel$",
              "^feature-panel-icon$",
              "^finale$",
              "^finale-inner$",
              "^finale-sparks$",
              "^floor-line$",
              "^footer-brand$",
              "^footer-inner$",
              "^footer-note$",
              "^forge$",
              "^forge-scene$",
              "^ghost$",
              "^glow$",
              "^glow-stop$",
              "^header-download$",
              "^header-download-label$",
              "^header-inner$",
              "^header-tools$",
              "^hero$",
              "^hero-facts$",
              "^hero-intro$",
              "^home$",
              "^hotbar$",
              "^hotbar-wrap$",
              "^icon-button$",
              "^iso$",
              "^label-anvil$",
              "^label-client$",
              "^label-server$",
              "^lane$",
              "^lane-track$",
              "^large$",
              "^lead$",
              "^led$",
              "^lost-blocks$",
              "^mark-base$",
              "^mark-slab$",
              "^mobile-menu-toggle$",
              "^mobile-nav$",
              "^modpack-frame$",
              "^modpack-tag$",
              "^molten$",
              "^mono$",
              "^next-steps$",
              "^noscript-note$",
              "^note-links$",
              "^not-found$",
              "^not-found-code$",
              "^packet$",
              "^page-heading$",
              "^patch-block$",
              "^patch-blocks$",
              "^patch-legend$",
              "^patch-readout$",
              "^patch-stack$",
              "^patch-stack-head$",
              "^patch-stacks$",
              "^scene-label$",
              "^scene-labels$",
              "^screen$",
              "^screen-scan$",
              "^search-trigger$",
              "^section-heading$",
              "^setup-switch$",
              "^shell-width$",
              "^sidebar-community$",
              "^site-footer$",
              "^site-header$",
              "^skip-link$",
              "^slot$",
              "^slot-key$",
              "^spark$",
              "^stage$",
              "^stage-bottom$",
              "^stage-copy$",
              "^stage-links$",
              "^stage-top$",
              "^step-number$",
              "^steps-section$",
              "^switch-option$",
              "^switch-thumb$",
              "^theme-moon$",
              "^theme-sun$",
              "^theme-toggle$",
              "^upstream-copy$",
              "^upstream-section$",
              "^works-intro$",
              "^works-layout$",
              "^works-section$"
            ]
          }
        ]
      },
      "jsPlugins": ["./site/node_modules/eslint-plugin-better-tailwindcss"]
    },
    {
      "files": ["site/src/**/*.{ts,tsx}"],
      "jsPlugins": [
        {
          "name": "tanstack-router",
          "specifier": "./site/node_modules/@tanstack/eslint-plugin-router"
        },
        {
          "name": "react-hooks-js",
          "specifier": "./site/node_modules/eslint-plugin-react-hooks"
        }
      ],
      "rules": {
        "tanstack-router/create-route-property-order": "error",
        "tanstack-router/route-param-names": "error",
        "react-hooks-js/static-components": "error",
        "react-hooks-js/use-memo": "error",
        "react-hooks-js/preserve-manual-memoization": "error",
        "react-hooks-js/incompatible-library": "error",
        "react-hooks-js/immutability": "error",
        "react-hooks-js/globals": "error",
        "react-hooks-js/refs": "error",
        "react-hooks-js/set-state-in-effect": "error",
        "react-hooks-js/error-boundaries": "error",
        "react-hooks-js/purity": "error",
        "react-hooks-js/set-state-in-render": "error",
        "react-hooks-js/unsupported-syntax": "error",
        "react-hooks-js/config": "error",
        "react-hooks-js/gating": "error",
        "react-hooks-js/component-hook-factories": "error"
      }
    },
    {
      "files": ["site/e2e/**/*.ts"],
      "jsPlugins": [
        {
          "name": "playwright",
          "specifier": "./site/node_modules/eslint-plugin-playwright"
        }
      ],
      "rules": {
        "playwright/missing-playwright-await": "error",
        "playwright/no-focused-test": "error",
        "playwright/no-skipped-test": "error",
        "playwright/no-wait-for-timeout": "error",
        "playwright/no-wait-for-selector": "error",
        "playwright/prefer-web-first-assertions": "error",
        "playwright/no-force-option": "error",
        "playwright/no-networkidle": "error",
        "playwright/no-page-pause": "error",
        "playwright/no-useless-await": "error",
        "playwright/valid-expect": "error"
      }
    },
    {
      // TanStack Router file routes must export Route beside their local page components.
      // allowExportNames does not cover the local components, and the router plugin owns their HMR.
      "files": ["site/src/routes/**"],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // Augmenting React's CSSProperties needs an interface with an index signature.
      "files": ["site/src/css-properties.d.ts"],
      "rules": {
        "typescript/consistent-indexed-object-style": "off"
      }
    },
    {
      // effecttsgo/missing-return-yield-star requires `return yield*` for failures in Effect
      // generators that otherwise return nothing, which typescript/consistent-return reports.
      "files": [
        "src/stack.ts",
        "src/dev.ts",
        "src/integration/cli.ts",
        "src/integration/resources.ts",
        "src/lab/cli.ts"
      ],
      "rules": {
        "typescript/consistent-return": "off"
      }
    }
  ]
}
