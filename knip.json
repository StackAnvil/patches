{
  "$schema": "https://unpkg.com/knip@6.44.1/schema.json",
  "ignoreBinaries": ["quickemu", "quickget", "spicy"],
  "workspaces": {
    ".": {
      "entry": ["src/lab/audio-guard.ts", "test-packs/entity-probe/src/main.ts"],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "test-packs/entity-probe/src/**/*.ts"
      ]
    },
    "site": {
      "ignoreDependencies": [
        "@tanstack/eslint-plugin-router",
        // Peer dependency loaded by the TanStack Router plugin.
        "eslint",
        "eslint-plugin-better-tailwindcss",
        "eslint-plugin-playwright",
        "eslint-plugin-react-hooks"
      ]
    }
  }
}
