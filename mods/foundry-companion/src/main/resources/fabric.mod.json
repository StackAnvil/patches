{
  "schemaVersion": 1,
  "id": "stackanvil_foundry",
  "version": "${version}",
  "name": "StackAnvil Foundry Companion",
  "description": "Start your Bedrock Foundry servers from Minecraft Java Edition and join them through the StackAnvil Bedrock add-on.",
  "authors": ["StackAnvil contributors"],
  "contact": {
    "homepage": "https://github.com/StackAnvil/patches",
    "sources": "https://github.com/StackAnvil/patches/tree/main/mods/foundry-companion"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "mixins": ["stackanvil_foundry.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "viafabricplus": "*",
    "viafabricplus-bedrock": "*"
  }
}
