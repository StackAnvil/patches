From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:33 +0200
Subject: [PATCH] chore(build): configure StackAnvil identity and compatibility

Keep branded artifacts and local dependency routing together with the 1 GiB Checkstyle worker allocation required by the enlarged local source tree. Exclude these build compatibility changes from upstream PRs.

Retain the unchanged legacy RakNet codec API while the pinned add-on,
ViaProxy and capture tooling still import it. Core upstream removes these
classes in1d76de72. Keep this host compatibility bridge in setup, outside
all upstream PR branches. Preserve the original license and packet
implementation; transport feature patches declare the compile APIs.

Route the local CubeConverter declaration through withDependencies so both resolution and the published POM select the same StackAnvil artifact. Leave the upstream declaration untouched so a dependency-only PR applies without setup.

diff --git a/build.gradle b/build.gradle
index 44920ebc9b1cee3ddcf1a67e0e67e0ef7048dfed..568fc5441c0117d171a2c617f18db5ada3e8418f 100644
--- a/build.gradle
+++ b/build.gradle
@@ -8,6 +8,10 @@ plugins {
     id "net.raphimc.class-token-replacer" version "1.1.7"
 }
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
+}
+
 checkstyleMain {
     exclude("**/generated/**")
 }
@@ -19,7 +23,31 @@ sourceSets {
     tool.runtimeClasspath += tool.compileClasspath
 }
 
+def stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+if (stackAnvilMavenRepo.present) {
+    configurations.configureEach {
+        withDependencies { declaredDependencies ->
+            def upstreamCubeConverter = declaredDependencies.find {
+                (it.group == "com.github.oryxel1" && it.name == "CubeConverter") ||
+                        (it.group == "com.github.oryxel1.CubeConverter" && it.name == "vv-json")
+            }
+            if (upstreamCubeConverter != null) {
+                declaredDependencies.remove(upstreamCubeConverter)
+                def localCubeConverter = project.dependencies.create("org.oryxel.cube:vv-json:1.3-StackAnvil")
+                localCubeConverter.transitive = upstreamCubeConverter.transitive
+                declaredDependencies.add(localCubeConverter)
+            }
+        }
+    }
+}
+
 repositories {
+    if (stackAnvilMavenRepo.present) {
+        maven {
+            name = "StackAnvilLocal"
+            url = uri(stackAnvilMavenRepo.get())
+        }
+    }
     //mavenLocal() // Uncomment when updating
     maven {
         name = "ViaVersion"
