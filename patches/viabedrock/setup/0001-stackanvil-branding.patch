From 990829d4d21786f4729dd1ac82603eb3872f0b20 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:51:34 +0200
Subject: [PATCH] chore(branding): identify StackAnvil builds and route
 dependencies

Use the StackAnvil CubeConverter publication when the stack build supplies its local Maven repository. Keep the upstream coordinate for direct Gradle builds so this downstream routing stays out of upstream PRs.
---
 build.gradle      | 17 ++++++++++++++++-
 gradle.properties |  2 +-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/build.gradle b/build.gradle
index 7da08481..c064146a 100644
--- a/build.gradle
+++ b/build.gradle
@@ -8,6 +8,10 @@ plugins {
     id "net.raphimc.class-token-replacer" version "1.1.7"
 }
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
+}
+
 checkstyleMain {
     exclude("**/generated/**")
 }
@@ -19,7 +23,18 @@ sourceSets {
     tool.runtimeClasspath += tool.compileClasspath
 }
 
+def stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+def cubeConverterDependency = stackAnvilMavenRepo.present
+    ? "org.oryxel.cube:cubeconverter:1.3-StackAnvil"
+    : "com.github.oryxel1:CubeConverter:abecffaaea"
+
 repositories {
+    if (stackAnvilMavenRepo.present) {
+        maven {
+            name = "StackAnvilLocal"
+            url = uri(stackAnvilMavenRepo.get())
+        }
+    }
     //mavenLocal() // Uncomment when updating
     maven {
         name = "ViaVersion"
@@ -91,7 +106,7 @@ dependencies {
     api "com.vdurmont:semver4j:3.1.0"
     api "com.mojang:brigadier:1.3.10"
     api "at.yawk.lz4:lz4-java:1.11.3"
-    api("com.github.oryxel1:CubeConverter:abecffaaea") {
+    api(cubeConverterDependency) {
         transitive = false
     }
     api("team.unnamed:mocha:3.0.1") {
diff --git a/gradle.properties b/gradle.properties
index 94da90ec..44cfd647 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -4,4 +4,4 @@ org.gradle.configuration-cache=true
 java_version=17
 maven_group=net.raphimc
 maven_name=ViaBedrock
-maven_version=0.0.31-SNAPSHOT
+maven_version=0.0.31-StackAnvil
-- 
2.55.0
