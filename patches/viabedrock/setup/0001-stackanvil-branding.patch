From 4686c8d95ea9cd188d599627d1caa13860d25027 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:33 +0200
Subject: [PATCH] chore(build): configure StackAnvil identity and compatibility

Keep branded artifacts and local dependency routing together with the 1 GiB Checkstyle worker allocation required by the enlarged local source tree. Exclude these build compatibility changes from upstream PRs.
---
 build.gradle                                    | 17 ++++++++++++++++-
 .../main/groovy/viabedrock.checkstyle.gradle    |  1 +
 gradle.properties                               |  2 +-
 3 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/build.gradle b/build.gradle
index 11733de3d..87bb06ad5 100644
--- a/build.gradle
+++ b/build.gradle
@@ -8,6 +8,10 @@ plugins {
     id "net.raphimc.class-token-replacer" version "1.1.7"
 }
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
+}
+
 checkstyleMain {
     exclude("**/generated/**")
 }
@@ -19,7 +23,18 @@ sourceSets {
     tool.runtimeClasspath += tool.compileClasspath
 }
 
+def stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+def cubeConverterDependency = stackAnvilMavenRepo.present
+    ? "org.oryxel.cube:cubeconverter:1.3-StackAnvil"
+    : "com.github.oryxel1:CubeConverter:abecffaaea"
+
 repositories {
+    if (stackAnvilMavenRepo.present) {
+        maven {
+            name = "StackAnvilLocal"
+            url = uri(stackAnvilMavenRepo.get())
+        }
+    }
     //mavenLocal() // Uncomment when updating
     maven {
         name = "ViaVersion"
@@ -91,7 +106,7 @@ dependencies {
     api "com.vdurmont:semver4j:3.1.0"
     api "com.mojang:brigadier:1.3.10"
     api "at.yawk.lz4:lz4-java:1.12.0"
-    api("com.github.oryxel1:CubeConverter:abecffaaea") {
+    api(cubeConverterDependency) {
         transitive = false
     }
     api("team.unnamed:mocha:3.0.1") {
diff --git a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
index 55dbc1bde..f15973780 100644
--- a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
+++ b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
@@ -217,6 +217,7 @@ checkstyle {
 }
 
 tasks.withType(Checkstyle).configureEach {
+    maxHeapSize = "1g"
     javaLauncher = javaToolchains.launcherFor {
         languageVersion = JavaLanguageVersion.of(21)
     }
diff --git a/gradle.properties b/gradle.properties
index 94da90ec7..44cfd6474 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -4,4 +4,4 @@ org.gradle.configuration-cache=true
 java_version=17
 maven_group=net.raphimc
 maven_name=ViaBedrock
-maven_version=0.0.31-SNAPSHOT
+maven_version=0.0.31-StackAnvil
-- 
2.56.0
