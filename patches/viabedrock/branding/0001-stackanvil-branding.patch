From 89399583355b50fdb560b8aa5f7151b65a445705 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:51:34 +0200
Subject: [PATCH] chore(branding): identify StackAnvil builds

Mark distributed artifacts with a StackAnvil version suffix and manifest vendor so testers can distinguish them from upstream builds.
---
 build.gradle      | 4 ++++
 gradle.properties | 2 +-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 7da0848..d9af3ca 100644
--- a/build.gradle
+++ b/build.gradle
@@ -8,6 +8,10 @@ plugins {
     id "net.raphimc.class-token-replacer" version "1.1.7"
 }
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
+}
+
 checkstyleMain {
     exclude("**/generated/**")
 }
diff --git a/gradle.properties b/gradle.properties
index 94da90e..44cfd64 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -4,4 +4,4 @@ org.gradle.configuration-cache=true
 java_version=17
 maven_group=net.raphimc
 maven_name=ViaBedrock
-maven_version=0.0.31-SNAPSHOT
+maven_version=0.0.31-StackAnvil
-- 
2.55.0

