@@ -37,6 +44,43 @@ import static org.junit.jupiter.api.Assertions.assertTrue;
 
 class InventoryPacketsTest {
 
+    @Test
+    void creativeDescriptorsConsumeEmptyIconBeforeTaggedFirework() throws InformativeException {
+        final CompoundTag fireworks = new CompoundTag();
+        fireworks.putByte("Flight", (byte) 1);
+        final CompoundTag tag = new CompoundTag();
+        tag.put("Fireworks", fireworks);
+
+        final ByteBuf userData = Unpooled.buffer();
+        userData.writeShortLE(-1);
+        userData.writeByte(1);
+        BedrockTypes.TAG_LE.write(userData, tag);
+        BedrockTypes.UTF8_STRING_ARRAY.write(userData, new String[0]);
+        BedrockTypes.UTF8_STRING_ARRAY.write(userData, new String[0]);
+
+        final ByteBuf descriptors = Unpooled.buffer();
+        writeCreativeDescriptor(descriptors, 0, new byte[0]);
+        final byte[] fireworkData = new byte[userData.readableBytes()];
+        userData.readBytes(fireworkData);
+        writeCreativeDescriptor(descriptors, 529, fireworkData);
+        final PacketWrapper wrapper = new PacketWrapperImpl(0, descriptors, null);
+
+        assertTrue(InventoryPackets.readCreativeItem(wrapper, 0).isEmpty());
+        final BedrockItem firework = InventoryPackets.readCreativeItem(wrapper, 0);
+        assertEquals(529, firework.identifier());
+        assertEquals(1, firework.tag().getCompoundTag("Fireworks").getByte("Flight"));
+        assertEquals(0, descriptors.readableBytes());
+    }
+
+    private static void writeCreativeDescriptor(
+            final ByteBuf buffer, final int id, final byte[] userData) {
+        BedrockTypes.VAR_INT.write(buffer, id);
+        buffer.writeShortLE(1);
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 0);
+        BedrockTypes.VAR_INT.write(buffer, 0);
+        BedrockTypes.BYTE_ARRAY.write(buffer, userData);
+    }
+
