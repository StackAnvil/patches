 import net.raphimc.viabedrock.protocol.types.recipe.CraftingDataReader;
 
 import java.util.ArrayList;
@@ -104,19 +107,19 @@ public final class InventoryPackets {
     public static void register(final BedrockProtocol protocol) {
         protocol.registerClientbound(ClientboundBedrockPackets.CREATIVE_CONTENT, null, wrapper -> {
             wrapper.cancel();
+            final ItemRewriter itemRewriter = wrapper.user().get(ItemRewriter.class);
             final int groups = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
             for (int i = 0; i < groups; i++) {
                 wrapper.read(Types.UNSIGNED_BYTE); // category
                 wrapper.read(BedrockTypes.STRING); // name
-                readCreativeItem(wrapper); // icon
+                readCreativeItem(wrapper, itemRewriter); // icon
             }
 
-            final ItemRewriter itemRewriter = wrapper.user().get(ItemRewriter.class);
             itemRewriter.clearCreativeItems();
             final int entries = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
             for (int i = 0; i < entries; i++) {
                 wrapper.read(BedrockTypes.UNSIGNED_VAR_INT); // creative net ID
-                final BedrockItem item = readCreativeItem(wrapper);
+                final BedrockItem item = readCreativeItem(wrapper, itemRewriter);
                 wrapper.read(BedrockTypes.UNSIGNED_VAR_INT); // group index
                 if (!item.isEmpty()) {
                     itemRewriter.addCreativeItem(item);
@@ -1332,12 +1335,18 @@ public final class InventoryPackets {
                 new InventoryTransactionData.NormalTransactionData());
     }
 
-    private static BedrockItem readCreativeItem(final PacketWrapper wrapper) throws InformativeException {
+    private static BedrockItem readCreativeItem(final PacketWrapper wrapper, final ItemRewriter itemRewriter)
+            throws InformativeException {
+        return readCreativeItem(wrapper, itemRewriter.getItems().getOrDefault("minecraft:shield", 0));
+    }
+
+    static BedrockItem readCreativeItem(final PacketWrapper wrapper, final int blockingId)
+            throws InformativeException {
         final int id = wrapper.read(BedrockTypes.VAR_INT);
         final int amount = wrapper.read(BedrockTypes.UNSIGNED_SHORT_LE);
         final int data = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
         final int blockRuntimeId = wrapper.read(BedrockTypes.VAR_INT);
-        wrapper.read(BedrockTypes.BYTE_ARRAY); // user data
+        final byte[] userData = wrapper.read(BedrockTypes.BYTE_ARRAY);
         if (id == 0) {
             return BedrockItem.empty();
         }
@@ -1345,6 +1354,12 @@ public final class InventoryPackets {
         item.setAmount(amount);
         item.setData(data);
         item.setBlockRuntimeId(blockRuntimeId);
+        final ByteBuf buffer = Unpooled.wrappedBuffer(userData);
+        try {
+            BedrockItemType.readUserData(buffer, item, blockingId);
+        } finally {
+            buffer.release();
+        }
         return item;
     }
 
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/types/item/BedrockItemType.java b/src/main/java/net/raphimc/viabedrock/protocol/types/item/BedrockItemType.java
index 5bad4270..64fcb078 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/types/item/BedrockItemType.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/types/item/BedrockItemType.java
@@ -65,10 +65,16 @@ public class BedrockItemType extends Type<BedrockItem> {
         }
 
         final ByteBuf userData = buffer.readSlice(BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+        readUserData(userData, item, this.blockingId);
+
+        return item;
+    }
+
+    public static void readUserData(final ByteBuf userData, final BedrockItem item, final int blockingId) {
         try {
             final short marker = userData.readShortLE();
             if (marker == 0) {
-                return item;
+                return;
             } else if (marker != -1) { // Bedrock client crashes if marker isn't -1
                 throw new IllegalStateException("Expected -1 marker but got " + marker);
             }
@@ -77,15 +83,13 @@ public class BedrockItemType extends Type<BedrockItem> {
                 item.setTag((CompoundTag) BedrockTypes.TAG_LE.read(userData));
                 item.setCanPlace(BedrockTypes.UTF8_STRING_ARRAY.read(userData));
                 item.setCanBreak(BedrockTypes.UTF8_STRING_ARRAY.read(userData));
-                if (item.identifier() == this.blockingId) {
+                if (item.identifier() == blockingId) {
                     item.setBlockingTicks(userData.readLongLE());
                 }
             }
         } catch (final IndexOutOfBoundsException ignored) {
             // Bedrock client stops reading at whatever point and loads whatever it has read successfully
         }
-
-        return item;
     }
 
     @Override
