+    private static void addTropicalFishVariant(final Entity entity, final List<EntityData> javaEntityData) {
+        final int variant = tropicalFishVariant(entity);
+        if (variant >= 0) {
+            javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.TYPE_VARIANT),
+                    VersionedTypes.V26_3.entityDataTypes().varIntType, variant));
+        }
+    }
+
+    static int tropicalFishVariant(final Entity entity) {
+        final int base = tropicalFishComponent(entity, ActorDataIds.VARIANT, 1);
+        final int pattern = tropicalFishComponent(entity, ActorDataIds.MARK_VARIANT, 5);
+        final int baseColor = tropicalFishComponent(entity, ActorDataIds.COLOR_INDEX, 15);
+        final int patternColor = tropicalFishComponent(entity, ActorDataIds.COLOR_2_INDEX, 15);
+        if (base < 0 || pattern < 0 || baseColor < 0 || patternColor < 0) {
+            return -1;
+        }
+        return base | pattern << 8 | baseColor << 16 | patternColor << 24;
+    }
+
+    private static int tropicalFishComponent(final Entity entity, final ActorDataIds id, final int maximum) {
+        final EntityData data = entity.entityData().get(id);
+        if (data == null) {
+            return 0;
+        }
+        final int value = readNumber(data).intValue();
+        return value >= 0 && value <= maximum ? value : -1;
+    }
+
+    static boolean boatPaddleTurning(final Entity entity, final ActorDataIds id) {
+        final EntityData data = entity.entityData().get(id);
+        return data != null && readNumber(data).floatValue() > 0f;
+    }
+
+    static int minecartDisplayBlockState(final Entity entity, final IntUnaryOperator bedrockToJavaBlockState) {
+        final EntityData customDisplay = entity.entityData().get(ActorDataIds.CUSTOM_DISPLAY);
+        final EntityData displayTile = entity.entityData().get(ActorDataIds.DISPLAY_TILE_RUNTIME_ID);
+        if (customDisplay == null || displayTile == null || readNumber(customDisplay).intValue() == 0) {
+            return 0;
+        }
+        return Math.max(0, bedrockToJavaBlockState.applyAsInt(readNumber(displayTile).intValue()));
+    }
+
