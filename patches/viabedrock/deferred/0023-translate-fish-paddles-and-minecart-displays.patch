     }
 
+    @Test
+    void combinesTropicalFishPatternAndColorsAcrossPartialUpdates() {
+        final Entity fish = new Entity(null, 1, 1, EntityTypes26_3.TROPICAL_FISH.identifier(), 1, null, EntityTypes26_3.TROPICAL_FISH);
+        fish.entityData().put(ActorDataIds.VARIANT, new EntityData(ActorDataIds.VARIANT.getValue(), EntityDataTypesBedrock.INT, 1));
+        fish.entityData().put(ActorDataIds.MARK_VARIANT, new EntityData(ActorDataIds.MARK_VARIANT.getValue(), EntityDataTypesBedrock.INT, 4));
+        fish.entityData().put(ActorDataIds.COLOR_INDEX, new EntityData(ActorDataIds.COLOR_INDEX.getValue(), EntityDataTypesBedrock.INT, 3));
+        fish.entityData().put(ActorDataIds.COLOR_2_INDEX, new EntityData(ActorDataIds.COLOR_2_INDEX.getValue(), EntityDataTypesBedrock.INT, 14));
+
+        assertEquals(0x0E030401, EntityMetadataRewriter.tropicalFishVariant(fish));
+
+        fish.entityData().put(ActorDataIds.MARK_VARIANT, new EntityData(ActorDataIds.MARK_VARIANT.getValue(), EntityDataTypesBedrock.INT, 2));
+        assertEquals(0x0E030201, EntityMetadataRewriter.tropicalFishVariant(fish));
+    }
+
+    @Test
+    void translatesBoatPaddleTimesToTurningFlags() {
+        final Entity boat = new Entity(null, 1, 1, EntityTypes26_3.OAK_BOAT.identifier(), 1, null, EntityTypes26_3.OAK_BOAT);
+        assertFalse(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_LEFT));
+
+        boat.entityData().put(ActorDataIds.ROW_TIME_LEFT,
+                new EntityData(ActorDataIds.ROW_TIME_LEFT.getValue(), EntityDataTypesBedrock.FLOAT, 0.4f));
+        assertTrue(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_LEFT));
+        assertFalse(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_RIGHT));
+    }
+
+    @Test
+    void onlyDisplaysMinecartBlockWhenBedrockEnablesIt() {
+        final Entity minecart = new Entity(null, 1, 1, EntityTypes26_3.MINECART.identifier(), 1, null, EntityTypes26_3.MINECART);
+        minecart.entityData().put(ActorDataIds.DISPLAY_TILE_RUNTIME_ID,
+                new EntityData(ActorDataIds.DISPLAY_TILE_RUNTIME_ID.getValue(), EntityDataTypesBedrock.INT, 42));
+        assertEquals(0, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> id + 100));
+
+        minecart.entityData().put(ActorDataIds.CUSTOM_DISPLAY,
+                new EntityData(ActorDataIds.CUSTOM_DISPLAY.getValue(), EntityDataTypesBedrock.BYTE, (byte) 1));
+        assertEquals(142, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> id + 100));
+        assertEquals(0, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> -1));
+    }
