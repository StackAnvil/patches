From d8cd7bcb90b4ebb319090d88f398938c5769ee5f Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 13:41:46 +0200
Subject: [PATCH] fix(smithing): support quick moving crafted output

Handle Java shift-clicks on smithing results with a Bedrock craft request that places the output into an empty player inventory slot. Preserve the pre-request container and inventory snapshots for authoritative recovery.
---
 .../container/block/SmithingContainer.java    | 39 ++++++++++++++++---
 1 file changed, 33 insertions(+), 6 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/block/SmithingContainer.java b/src/main/java/net/raphimc/viabedrock/api/model/container/block/SmithingContainer.java
index 0117d468d..690c2fab4 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/container/block/SmithingContainer.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/container/block/SmithingContainer.java
@@ -22,6 +22,7 @@ import com.viaversion.viaversion.api.minecraft.BlockPosition;
 import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
 
 import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
 import net.raphimc.viabedrock.api.util.PacketFactory;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
@@ -116,11 +117,17 @@ public class SmithingContainer extends Container {
         if (javaSlot != 3) {
             return super.handleClick(revision, javaSlot, button, action);
         }
-        if (action != ContainerInput.PICKUP || button != 0) {
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE) {
+            return false;
+        }
+        if (action == ContainerInput.PICKUP && button != 0) {
             return false;
         }
 
         final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final InventoryContainer player = inventory.getInventoryContainer();
+        final boolean toInventory = action == ContainerInput.QUICK_MOVE;
+        final int destination = toInventory ? firstEmptySlot(player) : 0;
         final BedrockItem template = this.getItem(TEMPLATE_SLOT);
         final BedrockItem input = this.getItem(INPUT_SLOT);
         final BedrockItem material = this.getItem(MATERIAL_SLOT);
@@ -129,7 +136,8 @@ public class SmithingContainer extends Container {
                 || input.isEmpty()
                 || material.isEmpty()
                 || output.isEmpty()
-                || !inventory.getHudContainer().getItem(0).isEmpty()) {
+                || destination < 0
+                || (!toInventory && !inventory.getHudContainer().getItem(0).isEmpty())) {
             return false;
         }
         if (template.netId() == null || input.netId() == null || material.netId() == null) {
@@ -172,8 +180,9 @@ public class SmithingContainer extends Container {
                                         (byte) RESULT_SLOT,
                                         requestId),
                                 new ItemStackRequestSlotInfo(
-                                        inventory.getHudContainer().getFullContainerName(0),
-                                        (byte) 0,
+                                        toInventory ? player.getFullContainerName(destination)
+                                                : inventory.getHudContainer().getFullContainerName(0),
+                                        (byte) destination,
                                         0)));
         final ItemStackRequestInfo request =
                 new ItemStackRequestInfo(
@@ -183,14 +192,32 @@ public class SmithingContainer extends Container {
                         request,
                         revision,
                         inventory.getHudContainer().copy(),
-                        List.of(this.copy())));
+                        toInventory ? List.of(this.copy(), player.copy()) : List.of(this.copy())));
         this.setItem(TEMPLATE_SLOT, this.itemAfterRemovingAmount(template, 1));
         this.setItem(INPUT_SLOT, this.itemAfterRemovingAmount(input, 1));
         this.setItem(MATERIAL_SLOT, this.itemAfterRemovingAmount(material, 1));
         this.setItem(RESULT_SLOT, BedrockItem.empty());
-        inventory.getHudContainer().setItem(0, output.copy());
+        if (toInventory) {
+            player.setItem(destination, output.copy());
+        } else {
+            inventory.getHudContainer().setItem(0, output.copy());
+        }
         PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
         return true;
     }
 
+    private static int firstEmptySlot(final InventoryContainer inventory) {
+        for (int slot = 9; slot < inventory.size(); slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        return -1;
+    }
+
 }
-- 
2.55.0
