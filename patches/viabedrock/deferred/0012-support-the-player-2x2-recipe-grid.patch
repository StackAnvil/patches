+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapedRecipe;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.BiPredicate;
+import java.util.function.ToIntFunction;
+
+public final class CraftingPlacement {
+
+    private CraftingPlacement() {
+    }
+
+    public static Placement plan(final CraftingDataStorage recipe, final int gridWidth,
+            final int firstGridSlot, final Container grid, final InventoryContainer inventory,
+            final boolean maxItems, final ToIntFunction<BedrockItem> maxStackSize,
+            final BiPredicate<ItemDescriptor, BedrockItem> matches) {
+        final List<Ingredient> ingredients = ingredients(recipe, gridWidth, firstGridSlot);
+        if (ingredients == null || ingredients.isEmpty()) {
+            return null;
+        }
+        final BedrockItem[] available = Arrays.stream(inventory.getItems())
+                .map(BedrockItem::copy).toArray(BedrockItem[]::new);
+        final boolean[] clearedIntoInventory = new boolean[available.length];
+        final int[] clearDestinations = new int[gridWidth * gridWidth];
+        Arrays.fill(clearDestinations, -1);
+        for (int gridSlot = 0; gridSlot < clearDestinations.length; gridSlot++) {
+            final BedrockItem item = grid.getItem(firstGridSlot + gridSlot);
+            if (item.isEmpty()) {
+                continue;
+            }
+            if (item.netId() == null) {
+                return null;
+            }
+            final int destination = firstEmptySlot(available);
+            if (destination < 0) {
+                return null;
+            }
+            clearDestinations[gridSlot] = destination;
+            available[destination] = item.copy();
+            clearedIntoInventory[destination] = true;
+        }
+
+        final int maxCrafts = maxItems ? 64 : 1;
+        for (int crafts = maxCrafts; crafts >= 1; crafts--) {
+            final SourcePlan sourcePlan = planSources(ingredients, available,
+                    clearedIntoInventory, maxStackSize, matches, crafts);
+            if (sourcePlan != null) {
+                return new Placement(firstGridSlot, ingredients, clearDestinations,
+                        sourcePlan.sources(), sourcePlan.amounts());
+            }
+        }
+        return null;
+    }
+
+    public static List<ItemStackRequestAction> actions(final Placement placement,
+            final Container grid, final InventoryContainer inventory) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        for (int gridSlot = 0; gridSlot < placement.clearDestinations().length; gridSlot++) {
+            final int destination = placement.clearDestinations()[gridSlot];
+            if (destination < 0) {
+                continue;
+            }
+            final int source = placement.firstGridSlot() + gridSlot;
+            final BedrockItem item = grid.getItem(source);
+            actions.add(new ItemStackRequestAction.PlaceAction(item.amount(),
+                    new ItemStackRequestSlotInfo(grid.getFullContainerName(source),
+                            (byte) source, item.netId()),
+                    new ItemStackRequestSlotInfo(inventory.getFullContainerName(destination),
+                            (byte) destination, 0)));
+        }
+        for (int index = 0; index < placement.ingredients().size(); index++) {
+            final int source = placement.sources()[index];
+            final int destination = placement.ingredients().get(index).gridSlot();
+            final BedrockItem item = inventory.getItem(source);
+            actions.add(new ItemStackRequestAction.PlaceAction(placement.amounts()[index],
+                    new ItemStackRequestSlotInfo(inventory.getFullContainerName(source),
+                            (byte) source, item.netId()),
+                    new ItemStackRequestSlotInfo(grid.getFullContainerName(destination),
+                            (byte) destination, 0)));
+        }
+        return actions;
+    }
+
+    public static void apply(final Placement placement, final Container grid,
+            final InventoryContainer inventory) {
+        for (int gridSlot = 0; gridSlot < placement.clearDestinations().length; gridSlot++) {
+            final int destination = placement.clearDestinations()[gridSlot];
+            if (destination >= 0) {
+                inventory.setItem(destination,
+                        grid.getItem(placement.firstGridSlot() + gridSlot).copy());
+                grid.setItem(placement.firstGridSlot() + gridSlot, BedrockItem.empty());
+            }
+        }
+        for (int index = 0; index < placement.ingredients().size(); index++) {
+            final int source = placement.sources()[index];
+            final BedrockItem item = inventory.getItem(source);
+            final BedrockItem gridItem = item.copy();
+            gridItem.setAmount(placement.amounts()[index]);
+            grid.setItem(placement.ingredients().get(index).gridSlot(), gridItem);
+            final int remaining = item.amount() - placement.amounts()[index];
+            final BedrockItem rest = remaining > 0 ? item.copy() : BedrockItem.empty();
+            if (remaining > 0) {
+                rest.setAmount(remaining);
+            }
+            inventory.setItem(source, rest);
+        }
+    }
+
+    static List<Ingredient> ingredients(final CraftingDataStorage data,
+            final int gridWidth, final int firstGridSlot) {
+        final List<Ingredient> ingredients = new ArrayList<>();
+        if (data.recipe() instanceof ShapedRecipe shaped) {
+            final ItemDescriptor[][] pattern = shaped.getPattern();
+            if (pattern.length == 0 || pattern.length > gridWidth
+                    || Arrays.stream(pattern).anyMatch(row -> row.length > gridWidth)) {
+                return null;
+            }
+            for (int y = 0; y < pattern.length; y++) {
+                for (int x = 0; x < pattern[y].length; x++) {
+                    if (!(pattern[y][x] instanceof ItemDescriptor.InvalidDescriptor)) {
+                        ingredients.add(new Ingredient(
+                                firstGridSlot + y * gridWidth + x, pattern[y][x]));
+                    }
+                }
+            }
+        } else if (data.recipe() instanceof ShapelessRecipe shapeless) {
+            if (shapeless.getIngredients().size() > gridWidth * gridWidth) {
+                return null;
+            }
+            for (int index = 0; index < shapeless.getIngredients().size(); index++) {
+                ingredients.add(new Ingredient(
+                        firstGridSlot + index, shapeless.getIngredients().get(index)));
+            }
+        }
+        return ingredients;
+    }
+
+    private static int firstEmptySlot(final BedrockItem[] items) {
+        for (int slot = 9; slot < items.length; slot++) {
+            if (items[slot].isEmpty()) {
+                return slot;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (items[slot].isEmpty()) {
+                return slot;
+            }
+        }
+        return -1;
+    }
+
+    static SourcePlan planSources(final List<Ingredient> ingredients,
+            final BedrockItem[] available, final boolean[] clearedIntoInventory,
+            final ToIntFunction<BedrockItem> maxStackSize,
+            final BiPredicate<ItemDescriptor, BedrockItem> matches, final int crafts) {
+        final int[] remaining = Arrays.stream(available).mapToInt(BedrockItem::amount).toArray();
+        final int[] sources = new int[ingredients.size()];
+        final int[] amounts = new int[ingredients.size()];
+        return assignSources(ingredients, available, clearedIntoInventory, maxStackSize,
+                matches, crafts, remaining, sources, amounts, 0)
+                ? new SourcePlan(sources, amounts) : null;
+    }
+
+    private static boolean assignSources(final List<Ingredient> ingredients,
+            final BedrockItem[] available, final boolean[] clearedIntoInventory,
+            final ToIntFunction<BedrockItem> maxStackSize,
+            final BiPredicate<ItemDescriptor, BedrockItem> matches, final int crafts,
+            final int[] remaining, final int[] sources, final int[] amounts, final int index) {
+        if (index == ingredients.size()) {
+            return true;
+        }
+        final Ingredient ingredient = ingredients.get(index);
+        final long required = (long) ingredient.descriptor().amount() * crafts;
+        if (required <= 0 || required > 255) {
+            return false;
+        }
+        final int count = (int) required;
+        for (int source = 0; source < available.length; source++) {
+            final BedrockItem item = available[source];
+            if (clearedIntoInventory[source] || item.isEmpty() || item.netId() == null
+                    || remaining[source] < count || maxStackSize.applyAsInt(item) < count
+                    || !matches.test(ingredient.descriptor(), item)) {
+                continue;
+            }
+            remaining[source] -= count;
+            sources[index] = source;
+            amounts[index] = count;
+            if (assignSources(ingredients, available, clearedIntoInventory, maxStackSize,
+                    matches, crafts, remaining, sources, amounts, index + 1)) {
+                return true;
+            }
+            remaining[source] += count;
+        }
+        return false;
+    }
+
+    public record Placement(int firstGridSlot, List<Ingredient> ingredients,
+            int[] clearDestinations, int[] sources, int[] amounts) {
+    }
+
+    public record Ingredient(int gridSlot, ItemDescriptor descriptor) {
+    }
+
+    record SourcePlan(int[] sources, int[] amounts) {
+    }
+
+}
