+    private boolean handleCraftingOutput(final int revision, final byte button,
+            final ContainerInput action) {
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE) {
+            return false;
+        }
+        if (action == ContainerInput.PICKUP && button != 0) {
+            return false;
+        }
+        final CraftingDataTracker.RecipeMatch match = this.user.get(CraftingDataTracker.class)
+                .getRecipeMatch(this, "crafting_table");
+        if (match == null) {
+            return false;
+        }
+        final BedrockItem result = craftingResult(match.data());
+        if (result.isEmpty()) {
+            return false;
+        }
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final HudContainer hud = inventory.getHudContainer();
+        final boolean toInventory = action == ContainerInput.QUICK_MOVE;
+        if (!toInventory && !hud.getItem(0).isEmpty()) {
+            return false;
+        }
+        final int destination = toInventory ? this.firstEmptySlot() : 0;
+        if (destination < 0) {
+            return false;
+        }
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final List<ItemStackRequestAction> actions = craftingOutputActions(match, result, hud,
+                this, destination, toInventory, requestId);
+        if (actions == null) {
+            return false;
+        }
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId, actions,
+                List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, revision, hud.copy(),
+                List.of(this.copy())));
+        for (int index = 0; index < match.amounts().length; index++) {
+            final int amount = match.amounts()[index];
+            if (amount == 0) {
+                continue;
+            }
+            final int slot = 28 + index;
+            final BedrockItem ingredient = hud.getItem(slot);
+            hud.setItem(slot, this.itemAfterRemovingAmount(ingredient, amount));
+        }
+        if (toInventory) {
+            this.setItem(destination, result.copy());
+        } else {
+            hud.setItem(0, result.copy());
+        }
+        this.refreshCraftingOutput();
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    static List<ItemStackRequestAction> craftingOutputActions(
+            final CraftingDataTracker.RecipeMatch match, final BedrockItem result,
+            final HudContainer hud, final InventoryContainer inventory,
+            final int destination, final boolean toInventory, final int requestId) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeAction(match.data().networkId(), 1));
+        for (int index = 0; index < match.amounts().length; index++) {
+            final int amount = match.amounts()[index];
+            if (amount == 0) {
+                continue;
+            }
+            final int slot = 28 + index;
+            final BedrockItem ingredient = hud.getItem(slot);
+            if (ingredient.netId() == null) {
+                return null;
+            }
+            actions.add(new ItemStackRequestAction.ConsumeAction(amount,
+                    new ItemStackRequestSlotInfo(hud.getFullContainerName(slot),
+                            (byte) slot, ingredient.netId())));
+        }
+        actions.add(new ItemStackRequestAction.PlaceAction(result.amount(),
+                new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                        (byte) 50, requestId),
+                new ItemStackRequestSlotInfo(toInventory
+                        ? inventory.getFullContainerName(destination) : hud.getFullContainerName(0),
+                        (byte) destination, 0)));
+        return actions;
+    }
+
+    private int firstEmptySlot() {
+        for (int slot = 9; slot < this.size(); slot++) {
+            if (this.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (this.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        return -1;
+    }
+
+    private static BedrockItem craftingResult(final CraftingDataStorage data) {
+        if (data.recipe() instanceof ShapedRecipe recipe) {
+            return recipe.getResults().get(0);
+        }
+        if (data.recipe() instanceof ShapelessRecipe recipe) {
+            return recipe.getResults().get(0);
+        }
+        return BedrockItem.empty();
+    }
