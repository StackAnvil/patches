+package net.raphimc.viabedrock.api.model.container.player;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptorType;
+import net.raphimc.viabedrock.protocol.model.recipe.RecipeType;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapedRecipe;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataTracker;
+
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+
+class InventoryContainerTest {
+
+    @Test
+    void playerCraftRequestConsumesHudInputsAndPlacesCreatedOutputOnCursor() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+        final HudContainer hud = new HudContainer(user);
+        final BedrockItem ingredient = new BedrockItem(1);
+        ingredient.setNetId(19);
+        hud.setItem(30, ingredient);
+        final InventoryContainer inventory = new InventoryContainer(user);
+        final ShapedRecipe recipe = new ShapedRecipe("test", UUID.randomUUID(),
+                "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor()}},
+                List.of(new BedrockItem(2)), false);
+        final CraftingDataTracker.RecipeMatch match = new CraftingDataTracker.RecipeMatch(
+                new CraftingDataStorage(RecipeType.SHAPED, 37, recipe, true),
+                new int[] {0, 0, 1, 0});
+
+        final List<ItemStackRequestAction> actions = InventoryContainer.craftingOutputActions(
+                match, new BedrockItem(2), hud, inventory, 0, false, -3);
+        final ItemStackRequestAction.CraftRecipeAction craft = assertInstanceOf(
+                ItemStackRequestAction.CraftRecipeAction.class, actions.get(0));
+        assertEquals(37, craft.recipeNetworkId());
+        final ItemStackRequestAction.ConsumeAction consume = assertInstanceOf(
+                ItemStackRequestAction.ConsumeAction.class, actions.get(1));
+        assertEquals(30, consume.item().slot());
+        assertEquals(19, consume.item().stackNetworkId());
+        final ItemStackRequestAction.PlaceAction place = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class, actions.get(2));
+        assertEquals(ContainerEnumName.CreatedOutputContainer, place.source().container().name());
+        assertEquals(50, place.source().slot());
+        assertEquals(-3, place.source().stackNetworkId());
+        assertEquals(ContainerEnumName.CursorContainer, place.destination().container().name());
+        assertEquals(0, place.destination().slot());
+    }
+
+    private record TestDescriptor() implements ItemDescriptor {
+        @Override
+        public ItemDescriptorType getType() {
+            return ItemDescriptorType.ITEM_NAME;
+        }
+
+        @Override
+        public boolean matchesItem(final UserConnection user, final BedrockItem item) {
+            return !item.isEmpty();
+        }
+
+        @Override
+        public ItemDescriptor withAmount(final int amount) {
+            return this;
+        }
+    }
+
+}
