From a523b5ae38f75886b04a3deaa49c4917f864d469 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:25:45 +0200
Subject: [PATCH] fix(inventory): route creative equipment to Bedrock slots

Java creative slot packets include armor and offhand positions. Send their transactions to the corresponding Bedrock inventory containers and retain the previous stack when replacing an occupied equipment slot.
---
 .../protocol/packet/InventoryPackets.java        | 16 ++++++++++------
 .../protocol/packet/InventoryPacketsTest.java    | 16 ++++++++++++++--
 2 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
index 18528e83..a89a2e27 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
@@ -1129,24 +1129,28 @@ public final class InventoryPackets {
                     final InventoryTracker inventoryTracker =
                             wrapper.user().get(InventoryTracker.class);
                     final InventoryContainer inventory = inventoryTracker.getInventoryContainer();
-                    if (javaSlot < 9 || javaSlot >= 45
+                    if (javaSlot < 5 || javaSlot > 45
                             || inventoryTracker.getPendingCloseContainer() != null) {
                         PacketFactory.sendJavaContainerSetContent(wrapper.user(), inventory);
                         return;
                     }
+                    final Container target = javaSlot < 9
+                            ? inventoryTracker.getArmorContainer()
+                            : javaSlot == 45 ? inventoryTracker.getOffhandContainer() : inventory;
                     final ItemRewriter itemRewriter = wrapper.user().get(ItemRewriter.class);
                     final BedrockItem creativeItem =
                             javaItem.isEmpty() ? BedrockItem.empty() : itemRewriter.creativeItem(javaItem);
-                    final int slot = inventory.bedrockSlot(javaSlot);
+                    final int slot = target.bedrockSlot(javaSlot);
                     if (creativeItem == null) {
                         PacketFactory.sendJavaContainerSetContent(wrapper.user(), inventory);
                         return;
                     }
-                    if (creativeItem.isEmpty() && inventory.getItem(slot).isEmpty()) {
+                    final BedrockItem previousItem = target.getItem(slot);
+                    if (creativeItem.isEmpty() && previousItem.isEmpty()) {
                         return;
                     }
                     final BedrockInventoryTransaction transaction = creativeSlotTransaction(
-                            slot, inventory.getItem(slot), creativeItem);
+                            target.containerId() & 0xFF, slot, previousItem, creativeItem);
                     final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION, wrapper.user());
                     packet.write(wrapper.user().get(InventoryTransactionRewriter.class).getInventoryTransactionType(), transaction);
                     packet.sendToServer(BedrockProtocol.class);
@@ -1309,7 +1313,7 @@ public final class InventoryPackets {
     }
 
     static BedrockInventoryTransaction creativeSlotTransaction(
-            final int slot, final BedrockItem previousItem, final BedrockItem creativeItem) {
+            final int containerId, final int slot, final BedrockItem previousItem, final BedrockItem creativeItem) {
         final InventorySource creativeSource = new InventorySource(
                 InventorySourceType.Creative_Inventory,
                 ContainerID.CONTAINER_ID_NONE.getValue(),
@@ -1326,7 +1330,7 @@ public final class InventoryPackets {
         actions.add(new InventoryActionData(
                 new InventorySource(
                         InventorySourceType.Container_Inventory,
-                        ContainerID.CONTAINER_ID_INVENTORY.getValue(),
+                        containerId,
                         InventorySourceFlags.No_Flag),
                 slot, previousItem, creativeItem));
         return new BedrockInventoryTransaction(
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/InventoryPacketsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/InventoryPacketsTest.java
index 75d090f3..cf8d3ac8 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/packet/InventoryPacketsTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/InventoryPacketsTest.java
@@ -115,7 +115,7 @@ class InventoryPacketsTest {
         final BedrockItem oldItem = new BedrockItem(1);
         final BedrockItem newItem = new BedrockItem(2);
         final BedrockInventoryTransaction transaction =
-                InventoryPackets.creativeSlotTransaction(4, oldItem, newItem);
+                InventoryPackets.creativeSlotTransaction(ContainerID.CONTAINER_ID_INVENTORY.getValue(), 4, oldItem, newItem);
 
         assertEquals(3, transaction.actions().size());
         final InventoryActionData delete = transaction.actions().get(0);
@@ -142,7 +142,7 @@ class InventoryPacketsTest {
     void clearingOccupiedCreativeSlotOnlyDeletesTheOldItem() {
         final BedrockItem oldItem = new BedrockItem(1);
         final BedrockInventoryTransaction transaction =
-                InventoryPackets.creativeSlotTransaction(12, oldItem, BedrockItem.empty());
+                InventoryPackets.creativeSlotTransaction(ContainerID.CONTAINER_ID_INVENTORY.getValue(), 12, oldItem, BedrockItem.empty());
 
         assertEquals(2, transaction.actions().size());
         final InventoryActionData delete = transaction.actions().get(0);
@@ -158,4 +158,16 @@ class InventoryPacketsTest {
         assertTrue(clear.toItem().isEmpty());
     }
 
+    @Test
+    void creativeTransactionsAddressArmorAndOffhandContainers() {
+        for (int containerId : new int[]{ContainerID.CONTAINER_ID_ARMOR.getValue(), ContainerID.CONTAINER_ID_OFFHAND.getValue()}) {
+            final BedrockInventoryTransaction transaction = InventoryPackets.creativeSlotTransaction(
+                    containerId, 0, BedrockItem.empty(), new BedrockItem(1));
+            final InventoryActionData target = transaction.actions().get(transaction.actions().size() - 1);
+            assertEquals(InventorySourceType.Container_Inventory, target.source().type());
+            assertEquals(containerId, target.source().containerId());
+            assertEquals(0, target.slot());
+        }
+    }
+
 }
