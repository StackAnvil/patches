+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ItemStackRequestResultTypeTest {
+
+    @Test
+    void resultUsesNamedItemDescriptorAndPreservesUserData() {
+        final String name = "minecraft:iron_sword";
+        final ItemStackRequestResultType type = new ItemStackRequestResultType(id -> id == 42 ? name : null, 0);
+        final BedrockItem result = new BedrockItem(42);
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("Damage", 5);
+        result.setTag(tag);
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            type.write(buffer, result);
+
+            assertEquals(1, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertEquals(1, buffer.readUnsignedByte());
+            assertEquals(name, BedrockTypes.STRING.read(buffer));
+            assertEquals(0, BedrockTypes.VAR_INT.read(buffer));
+            assertEquals(1, buffer.readUnsignedShortLE());
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            final ByteBuf userData = buffer.readSlice(BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertEquals(-1, userData.readShortLE());
+            assertEquals(1, userData.readUnsignedByte());
+            final CompoundTag decoded = (CompoundTag) BedrockTypes.TAG_LE.read(userData);
+            assertEquals(5, decoded.getInt("Damage", -1));
+            assertEquals(0, BedrockTypes.UTF8_STRING_ARRAY.read(userData).length);
+            assertEquals(0, BedrockTypes.UTF8_STRING_ARRAY.read(userData).length);
+            assertEquals(0, userData.readableBytes());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
