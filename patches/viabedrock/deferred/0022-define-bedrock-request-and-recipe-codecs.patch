+package net.raphimc.viabedrock.protocol.model.inventory;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemStackRequestActionType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+
+import java.util.List;
+
+public sealed interface ItemStackRequestAction permits ItemStackRequestAction.TakeAction, ItemStackRequestAction.PlaceAction, ItemStackRequestAction.SwapAction, ItemStackRequestAction.DropAction, ItemStackRequestAction.DestroyAction, ItemStackRequestAction.ConsumeAction, ItemStackRequestAction.BeaconPaymentAction, ItemStackRequestAction.CraftRecipeAction, ItemStackRequestAction.CraftCreativeAction, ItemStackRequestAction.CraftRecipeOptionalAction, ItemStackRequestAction.CraftResultsDeprecatedAction, ItemStackRequestAction.CraftLoomAction {
+
+    ItemStackRequestActionType getType();
+
+    record TakeAction(
+            int count, ItemStackRequestSlotInfo source, ItemStackRequestSlotInfo destination)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Take;
+        }
+    }
+
+    record PlaceAction(
+            int count, ItemStackRequestSlotInfo source, ItemStackRequestSlotInfo destination)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Place;
+        }
+    }
+
+    record SwapAction(ItemStackRequestSlotInfo source, ItemStackRequestSlotInfo destination)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Swap;
+        }
+    }
+
+    record DropAction(int count, ItemStackRequestSlotInfo item, boolean randomly)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Drop;
+        }
+    }
+
+    record DestroyAction(int count, ItemStackRequestSlotInfo item)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Destroy;
+        }
+    }
+
+    record ConsumeAction(int count, ItemStackRequestSlotInfo item)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.Consume;
+        }
+    }
+
+    record BeaconPaymentAction(int primaryEvent, int secondaryEvent)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.ScreenBeaconPayment;
+        }
+    }
+
+    record CraftRecipeAction(int recipeNetworkId, int numberOfRequestedCrafts)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.CraftRecipe;
+        }
+    }
+
+    record CraftCreativeAction(int creativeItemNetworkId, int numberOfRequestedCrafts)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.CraftCreative;
+        }
+    }
+
+    record CraftRecipeOptionalAction(int recipeNetworkId, int filteredStringIndex)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.CraftRecipeOptional;
+        }
+    }
+
+    record CraftLoomAction(String pattern, int timesCrafted) implements ItemStackRequestAction {
+        public CraftLoomAction {
+            if (pattern == null || pattern.isEmpty() || timesCrafted < 1 || timesCrafted > 255) {
+                throw new IllegalArgumentException("Invalid loom craft action");
+            }
+        }
+
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.CraftLoom;
+        }
+    }
+
+    record CraftResultsDeprecatedAction(List<BedrockItem> resultItems, int timesCrafted)
+            implements ItemStackRequestAction {
+        @Override
+        public ItemStackRequestActionType getType() {
+            return ItemStackRequestActionType.CraftResults;
+        }
+    }
+
+}
