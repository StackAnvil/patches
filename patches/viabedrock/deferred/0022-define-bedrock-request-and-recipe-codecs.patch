+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class CraftingDataReaderTest {
+
+    @Test
+    void retainsDynamicRecipeIdsWithoutConsumingFollowingArrays() {
+        // Target protocol 2193: three cartography switches plus an unknown unsigned network ID.
+        final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(
+                "00000443457282ed852d445dd0de908f41f1a69825"
+                        + "3c4829188c26368bf2a856713b99f1a09a25"
+                        + "5343c1cae43422604b0270ffebb1b78b9b25"
+                        + "00112233445566778899aabbccddeeff98f5f2f60f"
+                        + "000000000001020406080a0c0000015a"));
+        try {
+            final var data = CraftingDataReader.read(new PacketWrapperImpl(0, buffer, connection()));
+            final UUID[] ids = {
+                UUID.fromString("442d85ed-8272-4543-a6f1-418f90ded05d"),
+                UUID.fromString("8b36268c-1829-483c-a0f1-993b7156a8f2"),
+                UUID.fromString("602234e4-cac1-4353-8bb7-b1ebff70024b"),
+                new UUID(0x7766554433221100L, 0xFFEEDDCCBBAA9988L)
+            };
+            final int[] networkIds = {4760, 4762, 4763, 0xFEDCBA98};
+            assertEquals(ids.length, data.recipes().size());
+            for (int index = 0; index < ids.length; index++) {
+                final var recipe = data.recipes().get(index);
+                assertEquals(RecipeType.MULTI, recipe.type());
+                assertEquals(networkIds[index], recipe.networkId());
+                assertEquals(ids[index], assertInstanceOf(MultiRecipe.class, recipe.recipe()).getRecipeId());
+            }
+            assertTrue(data.clearRecipes());
+            assertEquals(0x5A, buffer.readUnsignedByte());
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsIncompleteDynamicRecipeBeforeReadingLaterArrays() {
+        final var buffer = Unpooled.wrappedBuffer(new byte[]{0, 0, 1, 1, 2, 3});
+        try {
+            assertThrows(InformativeException.class, () -> CraftingDataReader.read(
+                    new PacketWrapperImpl(0, buffer, connection())));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static UserConnection connection() {
+        // These packets have no item descriptors or item results, so no item rewriter is required.
+        return (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> {
+                    return switch (method.getName()) {
+                        case "get" -> null;
+                        case "getProtocolInfo" -> new ProtocolInfoImpl();
+                        default -> throw new UnsupportedOperationException(method.getName());
+                    };
+                });
+    }
+
+}
