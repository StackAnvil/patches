+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.protocol.types.inventory;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.function.IntFunction;
+
+/** The result descriptor inside a stack request uses an item name, unlike inventory slot items. */
+public final class ItemStackRequestResultType extends Type<BedrockItem> {
+
+    private final IntFunction<String> itemName;
+    private final int blockingId;
+
+    public ItemStackRequestResultType(final IntFunction<String> itemName, final int blockingId) {
+        super(BedrockItem.class);
+        this.itemName = itemName;
+        this.blockingId = blockingId;
+    }
+
+    @Override
+    public BedrockItem read(final ByteBuf buffer) {
+        throw new UnsupportedOperationException("Item stack request results are serverbound only");
+    }
+
+    @Override
+    public void write(final ByteBuf buffer, final BedrockItem item) {
+        if (item.isEmpty()) {
+            throw new IllegalArgumentException("An item stack request result must contain an item");
+        }
+        final String name = this.itemName.apply(item.identifier());
+        if (name == null) {
+            throw new IllegalArgumentException("Unknown result item ID: " + item.identifier());
+        }
+
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 1); // ItemNameDescriptor union variant
+        buffer.writeByte(1); // ItemNameDescriptor type
+        BedrockTypes.STRING.write(buffer, name);
+        BedrockTypes.VAR_INT.write(buffer, (int) item.data());
+        buffer.writeShortLE(item.amount());
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, item.blockRuntimeId());
+
+        final ByteBuf userData = buffer.alloc().buffer();
+        try {
+            if (item.tag() != null) {
+                userData.writeShortLE(-1);
+                userData.writeByte(1);
+                BedrockTypes.TAG_LE.write(userData, item.tag());
+            } else {
+                userData.writeShortLE(0);
+            }
+            BedrockTypes.UTF8_STRING_ARRAY.write(userData, item.canPlace());
+            BedrockTypes.UTF8_STRING_ARRAY.write(userData, item.canBreak());
+            if (item.identifier() == this.blockingId) {
+                userData.writeLongLE(item.blockingTicks());
+            }
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, userData.readableBytes());
+            buffer.writeBytes(userData);
+        } finally {
+            userData.release();
+        }
+    }
+
+}
