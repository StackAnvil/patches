From 0ee1301787857f810afc4999e91b30c118bf947b Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:23:07 +0200
Subject: [PATCH] fix(inventory): accept armor and offhand response slots

Inventory responses use Bedrock-local slot numbers for armor and offhand. Validate those bounds directly so successful server responses can update the Java equipment slots instead of being discarded as unknown.
---
 .../player/InventorySubContainer.java         |  6 ++++++
 .../storage/InventoryTrackerTest.java         | 19 +++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/player/InventorySubContainer.java b/src/main/java/net/raphimc/viabedrock/api/model/container/player/InventorySubContainer.java
index fd2bae8b..fc71bb2f 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/container/player/InventorySubContainer.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/container/player/InventorySubContainer.java
@@ -20,6 +20,7 @@ package net.raphimc.viabedrock.api.model.container.player;
 import com.viaversion.viaversion.api.connection.UserConnection;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
 import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
 
 public abstract class InventorySubContainer extends InventoryRedirectContainer {
 
@@ -27,6 +28,11 @@ public abstract class InventorySubContainer extends InventoryRedirectContainer {
         super(user, containerId, type, size);
     }
 
+    @Override
+    public boolean ownsBedrockSlot(final FullContainerName name, final int slot) {
+        return slot >= 0 && slot < this.size() && name.equals(this.getFullContainerName(slot));
+    }
+
     @Override
     public boolean setItems(BedrockItem[] items) {
         if (items.length != this.size()) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java
index 41728653..3dfdf85b 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java
@@ -42,6 +42,25 @@ class InventoryTrackerTest {
         assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 36));
     }
 
+    @Test
+    void armorAndOffhandResponsesUseBedrockSlotBounds() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final FullContainerName armorName = new FullContainerName(ContainerEnumName.ArmorContainer, null);
+        final FullContainerName offhandName = new FullContainerName(ContainerEnumName.OffhandContainer, null);
+
+        for (int slot = 0; slot < 4; slot++) {
+            assertSame(tracker.getArmorContainer(), tracker.getContainerFromName(armorName, slot));
+            assertTrue(tracker.getArmorContainer().ownsBedrockSlot(armorName, slot));
+        }
+        assertFalse(tracker.getArmorContainer().ownsBedrockSlot(armorName, 4));
+        assertSame(tracker.getOffhandContainer(), tracker.getContainerFromName(offhandName, 0));
+        assertTrue(tracker.getOffhandContainer().ownsBedrockSlot(offhandName, 0));
+        assertFalse(tracker.getOffhandContainer().ownsBedrockSlot(offhandName, 1));
+    }
+
