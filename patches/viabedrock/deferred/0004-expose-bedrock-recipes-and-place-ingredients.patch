+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class CookingRecipeBookTest {
+
+    @Test
+    void catalogUsesStationItemsUnlocksAndSingleInputRecipes() throws ClassNotFoundException {
+        Class.forName(StructuredDataKey.class.getName());
+        final UserConnection user = mock(UserConnection.class);
+        final ItemRewriter items = mock(ItemRewriter.class);
+        when(items.getItems()).thenReturn(HashBiMap.create(Map.of(
+                "minecraft:furnace", 11, "minecraft:blast_furnace", 12, "minecraft:smoker", 13,
+                "minecraft:input", 2)));
+        when(items.javaItem(any(BedrockItem.class))).thenAnswer(call -> {
+            final BedrockItem item = call.getArgument(0);
+            return item.isEmpty() ? StructuredItem.empty() : new StructuredItem(item.identifier() + 100, item.amount());
+        });
+        final CraftingDataTracker tracker = new CraftingDataTracker(user);
+        final var input = new ItemDescriptor.ItemNameDescriptor("minecraft:input", 0);
+        final var locked = recipe(1, "locked", "furnace", List.of(input), false);
+        tracker.updateCraftingDataList(List.of(
+                recipe(2, "furnace", "furnace", List.of(input), true),
+                recipe(3, "blast", "blast_furnace", List.of(input), true),
+                recipe(4, "smoker", "smoker", List.of(input), true), locked,
+                recipe(5, "multiple", "furnace", List.of(input, input), true),
+                recipe(6, "unsupported", "campfire", List.of(input), true)), true);
+        final var displays = tracker.recipeBookDisplays(items);
+        assertEquals(List.of(111, 112, 113), displays.stream()
+                .map(CraftingDataTracker.RecipeDisplay::craftingStationId).toList());
+        assertEquals(List.of(6, 8, 9), displays.stream().map(display -> display.station().category()).toList());
+        assertTrue(displays.stream().allMatch(display -> display.ingredients().size() == 1
+                && display.ingredients().get(0).ids()[0] == 102));
+        tracker.updateUnlockedRecipes(2, List.of(locked.recipe().getUniqueId()));
+        assertEquals(4, tracker.recipeBookDisplays(items).size());
+        tracker.updateUnlockedRecipes(3, List.of(locked.recipe().getUniqueId()));
+        assertEquals(3, tracker.recipeBookDisplays(items).size());
+    }
+
+    @Test
+    void publishedBookRejectsRetiredIdsAndUnlockSnapshots() throws ClassNotFoundException {
+        Class.forName(StructuredDataKey.class.getName());
+        final var items = mock(ItemRewriter.class);
+        when(items.getItems()).thenReturn(HashBiMap.create(Map.of("minecraft:furnace", 11, "minecraft:input", 2)));
+        when(items.javaItem(any(BedrockItem.class))).thenAnswer(call -> {
+            final BedrockItem item = call.getArgument(0);
+            return item.isEmpty() ? StructuredItem.empty() : new StructuredItem(item.identifier() + 100, item.amount());
+        });
+        final var tracker = new CraftingDataTracker(mock(UserConnection.class));
+        final var original = recipe(1, "cook", "furnace",
+                List.of(new ItemDescriptor.ItemNameDescriptor("minecraft:input", 0)), false);
+        tracker.updateCraftingDataList(List.of(original), true);
+        tracker.updateUnlockedRecipes(2, List.of("cook"));
+        final int oldId = tracker.prepareJavaRecipeBook(items).keySet().iterator().next();
+        assertSame(original, tracker.getDisplayedRecipe(oldId));
+        tracker.updateUnlockedRecipes(3, List.of("cook"));
+        assertNull(tracker.getDisplayedRecipe(oldId));
+        assertTrue(tracker.prepareJavaRecipeBook(items).isEmpty());
+        tracker.updateUnlockedRecipes(2, List.of("cook"));
+        assertEquals(oldId, tracker.prepareJavaRecipeBook(items).keySet().iterator().next());
+        final var replacement = new CraftingDataStorage(RecipeType.SHAPELESS, 2,
+                new ShapelessRecipe("cook", original.recipe().getRecipeId(), "furnace", 0,
+                        List.of(new ItemDescriptor.ItemNameDescriptor("minecraft:input", 0)), List.of(new BedrockItem(4))), false);
+        tracker.updateCraftingDataList(List.of(replacement), true);
+        assertNull(tracker.getDisplayedRecipe(oldId));
+        final int newId = tracker.prepareJavaRecipeBook(items).keySet().iterator().next();
+        assertNotEquals(oldId, newId);
+        assertNull(tracker.getDisplayedRecipe(oldId));
+        assertSame(replacement, tracker.getDisplayedRecipe(newId));
+        tracker.updateUnlockedRecipes(0, List.of());
+        assertSame(replacement, tracker.getDisplayedRecipe(newId));
+        tracker.updateCraftingDataList(List.of(), true);
+        assertNull(tracker.getDisplayedRecipe(newId));
+    }
+
+    @Test
+    void furnaceDisplayHasTheTargetCodecFieldOrderForTypedAndDirectConnections() throws ClassNotFoundException {
+        Class.forName(StructuredDataKey.class.getName());
+        final var packet = new PacketWrapperImpl(0, null, null);
+        final var output = new StructuredItem(320, 2, new StructuredDataContainer());
+        final var display = new CraftingDataTracker.RecipeDisplay(null, 0, 0,
+                List.of(HolderSet.of(new int[]{319})), output,
+                CraftingDataTracker.RecipeBookStation.SMOKER, 321);
+        // Use deliberately non-default registry IDs so the codec cannot assume slot display order.
+        final var slotDisplayIds = Map.of("minecraft:item", 93,
+                "minecraft:any_fuel", 92, "minecraft:item_stack", 94);
+        CraftingDataTracker.writeRecipeDisplay(packet, display, slotDisplayIds::get);
+        packet.resetReader();
+        assertEquals(2, packet.passthrough(Types.VAR_INT)); // furnace recipe display
+        assertEquals(93, packet.passthrough(Types.VAR_INT)); // input slot display
+        assertEquals(319, packet.passthrough(Types.VAR_INT));
+        assertEquals(92, packet.passthrough(Types.VAR_INT)); // any fuel, no payload
+        assertEquals(94, packet.passthrough(Types.VAR_INT));
+        assertSame(output, packet.passthrough(VersionedTypes.V26_3.itemTemplate));
+        assertEquals(93, packet.passthrough(Types.VAR_INT));
+        assertEquals(321, packet.passthrough(Types.VAR_INT));
+        assertEquals(0, packet.passthrough(Types.VAR_INT)); // no timing in Bedrock CraftingData
+        assertEquals(0F, packet.passthrough(Types.FLOAT));
+        final var buffer = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(buffer);
+            assertEquals(0, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(2, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(93, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(319, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(92, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(94, Types.VAR_INT.readPrimitive(buffer));
+            final var decoded = VersionedTypes.V26_3.itemTemplate.read(buffer);
+            assertEquals(output.identifier(), decoded.identifier());
+            assertEquals(output.amount(), decoded.amount());
+            assertEquals(93, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(321, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(0, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(0F, Types.FLOAT.readPrimitive(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static CraftingDataStorage recipe(final int networkId, final String name, final String tag,
+            final List<ItemDescriptor> inputs, final boolean unlocked) {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, networkId,
+                new ShapelessRecipe(name, UUID.randomUUID(), tag, 0, inputs, List.of(new BedrockItem(3))), unlocked);
+    }
+
+}
