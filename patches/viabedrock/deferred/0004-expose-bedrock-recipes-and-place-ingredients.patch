@@ -0,0 +1,81 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.container.block.FurnaceContainer;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingRecipeOrder;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataTracker;
+
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Authoritative station catalog, including all unlocked input alternatives for each displayed output. */
+public final class CookingRecipeCatalog {
+
+    private final UserConnection user;
+    private final CraftingDataTracker.RecipeCatalog catalog;
+    private final List<CraftingDataTracker.CatalogEntry> entries;
+    private final Map<CraftingDataStorage, List<BedrockItem>> inputs = new IdentityHashMap<>();
+
+    public CookingRecipeCatalog(final UserConnection user, final FurnaceContainer container) {
+        this.user = user;
+        final var items = user.get(ItemRewriter.class);
+        this.catalog = user.get(CraftingDataTracker.class).recipeCatalog(data -> container.acceptsRecipe(data) && output(items, data) != null);
+        this.entries = CookingRecipeOrder.registryOrder(this.catalog.entries(), entry -> entry.data().recipe().getUniqueId());
+        for (final var entry : this.entries) {
+            final BedrockItem output = output(items, entry.data());
+            if (!entry.unlocked() || output == null) {
+                continue;
+            }
+            final List<BedrockItem> alternatives = new ArrayList<>();
+            for (final var candidate : this.entries) {
+                final BedrockItem result = output(items, candidate.data());
+                if (candidate.unlocked() && result != null && items.matchesStackQuery(output, result)) {
+                    alternatives.addAll(CookingRecipeInputs.expand(user,
+                            ((ShapelessRecipe) candidate.data().recipe()).getIngredients().getFirst()));
+                }
+            }
+            this.inputs.put(entry.data(), List.copyOf(alternatives));
+        }
+    }
+
+    private static BedrockItem output(final ItemRewriter items, final CraftingDataStorage data) {
+        final BedrockItem output = ((ShapelessRecipe) data.recipe()).getResults().getFirst();
+        final var definition = items.getItemRegistry().definition(output.identifier());
+        return output.isEmpty() || definition == null || "minecraft:air".equals(definition.identifier()) ? null : output;
+    }
+
+    public boolean current(final CraftingDataTracker tracker) {
+        return this.catalog.current(tracker);
+    }
+
+    public long revision() {
+        return this.catalog.revision();
+    }
+
+    public List<CraftingDataTracker.CatalogEntry> entries() {
+        return this.entries;
+    }
+
+    public CraftingDataStorage recipe(final int id) {
+        return this.current(this.user.get(CraftingDataTracker.class)) ? this.catalog.recipe(id) : null;
+    }
+
+    /** A stale catalog cannot provide action inputs, including after unlock-only changes. */
+    public List<BedrockItem> inputs(final CraftingDataStorage data) {
+        final List<BedrockItem> alternatives = this.inputs.get(data);
+        return this.current(this.user.get(CraftingDataTracker.class)) && alternatives != null
+                ? alternatives.stream().map(BedrockItem::copy).toList() : null;
+    }
+
+}
