+/** Negotiated native preferences, independent of Java recipe-book state and connection route. */
+public final class NativeFurnaceOptions {
+
+    public static final String CHANNEL = "viabedrock:furnace_options";
+    public static final Type<FurnaceOptions> TYPE = new Type<>(FurnaceOptions.class) {
+
+        @Override
+        public FurnaceOptions read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 32 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native furnace preferences");
+            }
+            final FurnaceOptions options = BedrockTypes.FURNACE_OPTIONS.read(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native furnace preferences");
+            }
+            return options;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final FurnaceOptions value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            BedrockTypes.FURNACE_OPTIONS.write(buffer, value);
+        }
+    };
+
+    private NativeFurnaceOptions() { }
+
+}
