+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.ByteTag;
+import net.raphimc.viabedrock.api.model.container.block.FurnaceContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.BiPredicate;
+import java.util.function.Function;
+import java.util.function.ToIntFunction;
+
+/** Native output selection, ingredient collection, and item return. This is not Java recipe placement. */
+public final class NativeCookingRecipeSelection {
+
+    private NativeCookingRecipeSelection() { }
+
+    public static Plan plan(final FurnaceContainer station, final InventoryContainer inventory,
+                            final List<BedrockItem> inputs, final BedrockItem output, final Selection previous,
+                            final ToIntFunction<BedrockItem> maximum, final Function<BedrockItem, ItemRecipeKey> identity,
+                            final BiPredicate<BedrockItem, BedrockItem> recipeMatches,
+                            final BiPredicate<BedrockItem, BedrockItem> matches,
+                            final BiPredicate<BedrockItem, BedrockItem> canMerge) {
+        if (station.size() != 3 || inventory.size() != 36 || inputs == null || inputs.isEmpty() || output.isEmpty()) {
+            return null;
+        }
+        final var planner = new Planner(station, inventory, previous, maximum, matches, canMerge);
+        if (!previous.output.isEmpty() && matches.test(previous.output, output)) {
+            planner.returnSlot(0);
+            planner.returnSlot(2);
+            return planner.finish(BedrockItem.empty());
+        }
+        final BedrockItem ingredient = planner.stationItems[0];
+        if (!ingredient.isEmpty() && inputs.stream().anyMatch(input -> matches.test(input, ingredient))) {
+            return planner.finish(output);
+        }
+        final List<Provider> providers = List.of(
+                new Provider(station, planner.stationItems, 1, 2, ContainerEnumName.FurnaceFuelContainer),
+                new Provider(inventory, planner.playerItems, 0, 9, ContainerEnumName.HotbarContainer),
+                new Provider(inventory, planner.playerItems, 9, 36, ContainerEnumName.InventoryContainer));
+        CookingRecipeSources.Result<Provider> best = null;
+        BedrockItem selected = inputs.getFirst();
+        for (final var input : inputs) {
+            final var candidates = CookingRecipeSources.collect(providers, Provider::items, identity,
+                    item -> recipeMatches.test(input, item));
+            if (best == null || candidates.amount() > best.amount()) {
+                best = candidates;
+                selected = input;
+            }
+        }
+        // The native model compares Item IDs before deciding whether to return the ingredient.
+        if (best.amount() == 0 || ingredient.isEmpty() || ingredient.identifier() != selected.identifier()) {
+            planner.returnSlot(0);
+        }
+        for (final var reference : best.sources()) {
+            final var provider = reference.container();
+            final int slot = provider.begin + reference.slot();
+            final BedrockItem source = provider.contents[slot];
+            final BedrockItem current = planner.stationItems[0];
+            if (!current.isEmpty() && !matches.test(current, source)) {
+                break;
+            }
+            planner.move(new Slot(provider.owner, slot, provider.collection),
+                    new Slot(station, 0, station.getFullContainerName(0).name()), source.amount());
+        }
+        // Both return calls replace history. Output return captures the post-placement inventory.
+        planner.returnSlot(2);
+        return planner.finish(output);
+    }
+
+    private static BedrockItem[] copies(final BedrockItem[] items) {
+        return Arrays.stream(items).map(BedrockItem::copy).toArray(BedrockItem[]::new);
+    }
+
+    private static boolean unlocked(final BedrockItem item) {
+        return item.tag() == null || !(item.tag().get("minecraft:item_lock") instanceof ByteTag lock && lock.asByte() != 0);
+    }
+
+    public static BedrockItem remainder(final BedrockItem source, final int count) {
+        if (source.amount() == count) {
+            return BedrockItem.empty();
+        }
+        final var remaining = source.copy();
+        remaining.setAmount(source.amount() - count);
+        return remaining;
+    }
+
+    public static final class Selection {
+        private final BedrockItem output;
+        private final BedrockItem[] history;
+
+        public Selection() {
+            this(BedrockItem.empty(), null);
+        }
+
+        private Selection(final BedrockItem output, final BedrockItem[] history) {
+            this.output = output.copy();
+            this.history = history == null ? null : copies(history);
+        }
+
+    }
+
+    public record Slot(Container owner, int index, ContainerEnumName collection) { }
+
+    public record Transfer(Slot source, Slot destination, int count) { }
+
+    public record Plan(List<Transfer> transfers, Selection selection) {
+        public Plan {
+            transfers = List.copyOf(transfers);
+        }
+    }
+
+    private record Provider(Container owner, BedrockItem[] contents, int begin, int end, ContainerEnumName collection) {
+        private BedrockItem[] items() {
+            return Arrays.copyOfRange(this.contents, this.begin, this.end);
+        }
+    }
+
+    private static final class Planner {
+        private final FurnaceContainer station;
+        private final InventoryContainer player;
+        private final BedrockItem[] stationItems;
+        private final BedrockItem[] playerItems;
+        private BedrockItem[] history;
+        private final ToIntFunction<BedrockItem> maximum;
+        private final BiPredicate<BedrockItem, BedrockItem> matches;
+        private final BiPredicate<BedrockItem, BedrockItem> canMerge;
+        private final List<Transfer> transfers = new ArrayList<>();
+
+        private Planner(final FurnaceContainer station, final InventoryContainer player, final Selection previous,
+                        final ToIntFunction<BedrockItem> maximum, final BiPredicate<BedrockItem, BedrockItem> matches,
+                        final BiPredicate<BedrockItem, BedrockItem> canMerge) {
+            this.station = station;
+            this.player = player;
+            this.stationItems = copies(station.getItems());
+            this.playerItems = copies(player.getItems());
+            this.history = previous.history == null ? BedrockItem.emptyArray(36) : copies(previous.history);
+            this.maximum = maximum;
+            this.matches = matches;
+            this.canMerge = canMerge;
+        }
+
+        private Plan finish(final BedrockItem output) {
+            return new Plan(this.transfers, new Selection(output, this.history));
+        }
+
+        private void returnSlot(final int slot) {
+            final Slot source = new Slot(this.station, slot, this.station.getFullContainerName(slot).name());
+            // Native capture order examines inventory deficits before hotbar deficits.
+            for (int index = 9; index < 45 && !this.stationItems[slot].isEmpty(); index++) {
+                final int destination = index % 36;
+                final BedrockItem stored = this.history[destination];
+                final BedrockItem current = this.playerItems[destination];
+                if (!stored.isEmpty() && this.matches.test(stored, this.stationItems[slot])
+                        && (current.isEmpty() || this.matches.test(stored, current)) && stored.amount() > current.amount()) {
+                    this.move(source, new Slot(this.player, destination, destination < 9
+                                    ? ContainerEnumName.HotbarContainer : ContainerEnumName.InventoryContainer),
+                            stored.amount() - current.amount());
+                }
+            }
+            for (final boolean merge : new boolean[]{true, false}) {
+                for (int destination = 0; destination < 36 && !this.stationItems[slot].isEmpty(); destination++) {
+                    final BedrockItem target = this.playerItems[destination];
+                    if (merge ? target.isEmpty() : !target.isEmpty()) {
+                        continue;
+                    }
+                    this.move(source, new Slot(this.player, destination, ContainerEnumName.CombinedHotbarAndInventoryContainer),
+                            this.stationItems[slot].amount());
+                }
+            }
+            this.history = copies(this.playerItems);
+        }
+
+        private void move(final Slot source, final Slot destination, final int requested) {
+            final BedrockItem[] sourceItems = source.owner == this.station ? this.stationItems : this.playerItems;
+            final BedrockItem[] destinationItems = destination.owner == this.station ? this.stationItems : this.playerItems;
+            final BedrockItem from = sourceItems[source.index];
+            final BedrockItem to = destinationItems[destination.index];
+            if (from.isEmpty() || !unlocked(from) || !unlocked(to)
+                    || !destination.owner.canPlaceItem(destination.index, from)
+                    || !to.isEmpty() && !this.canMerge.test(from, to)) {
+                return;
+            }
+            final int capacity = this.maximum.applyAsInt(to.isEmpty() ? from : to);
+            final int count = Math.min(Math.min(requested, from.amount()), Math.min(255, capacity) - to.amount());
+            if (count <= 0) {
+                return;
+            }
+            this.transfers.add(new Transfer(source, destination, count));
+            final BedrockItem moved = to.isEmpty() ? from.copy() : to.copy();
+            moved.setAmount(to.amount() + count);
+            destinationItems[destination.index] = moved;
+            sourceItems[source.index] = remainder(from, count);
+        }
+    }
+
+}
