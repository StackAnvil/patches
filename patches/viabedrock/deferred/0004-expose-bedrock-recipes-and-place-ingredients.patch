+class CraftingCursorTest {
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void repeatedPickupMergesResultsUsingConfirmedCursorIdentityAndRollsBack(final boolean table) {
+        final Fixture fixture = new Fixture(table);
+        final List<ItemStackRequestInfo> sent = new ArrayList<>();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            packets.when(() -> PacketFactory.sendBedrockInventoryRequest(eq(fixture.user), any()))
+                    .thenAnswer(call -> {
+                        final var request = ((ItemStackRequestInfo[]) call.getArgument(1))[0];
+                        sent.add(request);
+                        fixture.requests.getRequest(request.requestId()).capturePrediction(fixture.inventory);
+                        return null;
+                    });
+            assertTrue(fixture.output.handleClick(0, (short) 0, (byte) 0, ContainerInput.PICKUP));
+            assertEquals(4, fixture.cursor().amount());
+            assertEquals(1, fixture.ingredient().amount());
+            fixture.cursor().setNetId(23);
+            fixture.ingredient().setNetId(18);
+            fixture.requests.removeRequest(sent.getFirst().requestId());
+
+            assertTrue(fixture.output.handleClick(1, (short) 0, (byte) 0, ContainerInput.PICKUP));
+            assertEquals(8, fixture.cursor().amount());
+            assertTrue(fixture.ingredient().isEmpty());
+            final var request = sent.getLast();
+            final var craft = assertInstanceOf(ItemStackRequestAction.CraftRecipeAction.class, request.actions().get(0));
+            final var consume = assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, request.actions().get(2));
+            final var place = assertInstanceOf(ItemStackRequestAction.PlaceAction.class, request.actions().get(3));
+            assertEquals(1, craft.numberOfRequestedCrafts());
+            assertEquals(1, consume.count());
+            assertEquals(18, consume.item().stackNetworkId());
+            assertEquals(4, place.count());
+            assertEquals(23, place.destination().stackNetworkId());
+
+            fixture.requests.restoreRejectedRequest(fixture.requests.getRequest(request.requestId()));
+            assertEquals(4, fixture.cursor().amount());
+            assertEquals(23, fixture.cursor().netId());
+            assertEquals(1, fixture.ingredient().amount());
+            assertEquals(18, fixture.ingredient().netId());
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void refusesIncompatibleFullOrUnconfirmedCursorWithoutConsumingInputs(final boolean table) {
+        final Fixture fixture = new Fixture(table);
+        try (var packets = mockStatic(PacketFactory.class)) {
+            for (final BedrockItem cursor : List.of(item(3, 4, 23), item(2, 61, 23), item(2, 4, null))) {
+                fixture.inventory.getHudContainer().setItem(0, cursor);
+                assertFalse(fixture.output.handleClick(0, (short) 0, (byte) 0, ContainerInput.PICKUP));
+                assertEquals(cursor, fixture.cursor());
+                assertEquals(2, fixture.ingredient().amount());
+            }
+            packets.verify(() -> PacketFactory.sendBedrockInventoryRequest(eq(fixture.user), any()), never());
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void shiftPickupStillCraftsBothLogsInOneRequest(final boolean table) {
+        final Fixture fixture = new Fixture(table);
+        try (var packets = mockStatic(PacketFactory.class)) {
+            assertTrue(fixture.output.handleClick(0, (short) 0, (byte) 0, ContainerInput.QUICK_MOVE));
+            assertEquals(8, fixture.inventory.getInventoryContainer().getItem(9).amount());
+            assertTrue(fixture.cursor().isEmpty());
+            assertTrue(fixture.ingredient().isEmpty());
+        }
+    }
+
+    private static BedrockItem item(final int id, final int count, final Integer netId) {
+        final BedrockItem item = new BedrockItem(id);
+        item.setAmount(count);
+        item.setNetId(netId);
+        return item;
+    }
+
+    private static final class Fixture {
+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? this.storage.get(args[0]) : null);
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final InventoryRequestTracker requests = new InventoryRequestTracker(this.user);
+        private final Container output;
+        private final Container grid;
+        private final int gridSlot;
+
+        private Fixture(final boolean table) {
+            this.output = table ? new CraftingTableContainer(this.user, (byte) 5, null, null)
+                    : this.inventory.getInventoryContainer();
+            this.grid = table ? this.output : this.inventory.getHudContainer();
+            this.gridSlot = table ? 32 : 28;
+            if (table) {
+                this.inventory.setCurrentContainer(this.output);
+            }
+            this.storage.put(InventoryTracker.class, this.inventory);
+            this.storage.put(InventoryRequestTracker.class, this.requests);
+            final ItemRewriter items = mock(ItemRewriter.class);
+            when(items.maxStackSize(any())).thenReturn(64);
+            this.storage.put(ItemRewriter.class, items);
+            final CraftingDataTracker recipes = mock(CraftingDataTracker.class);
+            this.storage.put(CraftingDataTracker.class, recipes);
+            final var recipe = new ShapelessRecipe("test", UUID.randomUUID(), "crafting_table", 0,
+                    List.of(), List.of(item(2, 4, null)));
+            final int[] amounts = new int[table ? 9 : 4];
+            amounts[0] = 1;
+            final var match = new CraftingDataTracker.RecipeMatch(
+                    new CraftingDataStorage(RecipeType.SHAPELESS, 37, recipe, true), amounts);
+            when(recipes.getRecipeMatch(any(), eq("crafting_table")))
+                    .thenAnswer(_ -> this.ingredient().isEmpty() ? null : match);
+            this.grid.setItem(this.gridSlot, item(1, 2, 19));
+        }
+
+        private BedrockItem cursor() {
+            return this.inventory.getHudContainer().getItem(0);
+        }
+
+        private BedrockItem ingredient() {
+            return this.grid.getItem(this.gridSlot);
+        }
+
+    }
+
+}
