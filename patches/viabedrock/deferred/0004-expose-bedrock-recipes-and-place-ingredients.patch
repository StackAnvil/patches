+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class CraftingPlacementTest {
+
+    @Test
+    void recipePlacementBacktracksInventorySourcesWithoutConsumingClearedGridItems() {
+        final BedrockItem[] inventory = BedrockItem.emptyArray(36);
+        inventory[0] = new BedrockItem(1, (short) 0, (byte) 4);
+        inventory[0].setNetId(17);
+        inventory[1] = new BedrockItem(2, (short) 0, (byte) 2);
+        inventory[1].setNetId(18);
+        inventory[9] = new BedrockItem(1);
+        inventory[9].setNetId(19);
+
+        final List<CraftingPlacement.Ingredient> ingredients = List.of(
+                new CraftingPlacement.Ingredient(32, new TestDescriptor(0, 1)),
+                new CraftingPlacement.Ingredient(33, new TestDescriptor(1, 2)),
+                new CraftingPlacement.Ingredient(34, new TestDescriptor(1, 2)));
+        final boolean[] clearedGridItems = new boolean[36];
+        clearedGridItems[9] = true;
+        final CraftingPlacement.SourcePlan plan = CraftingPlacement.planSources(
+                ingredients, inventory, clearedGridItems, item -> 64,
+                (descriptor, item) -> descriptor.matchesItem(null, item), 1);
+
+        assertArrayEquals(new int[] {1, 0, 0}, plan.sources());
+        assertArrayEquals(new int[] {1, 2, 2}, plan.amounts());
+        assertNull(CraftingPlacement.planSources(ingredients, inventory,
+                clearedGridItems, item -> 64,
+                (descriptor, item) -> descriptor.matchesItem(null, item), 2));
+    }
+
+    @Test
+    void playerGridPlacementUsesHudSlotsAndClearsExistingIngredients() {
+        final UserConnection user = user();
+        final InventoryContainer inventory = inventory(user);
+        final HudContainer hud = new HudContainer(user);
+        final BedrockItem first = new BedrockItem(1, (short) 0, (byte) 4);
+        first.setNetId(11);
+        inventory.setItem(0, first);
+        final BedrockItem second = new BedrockItem(2, (short) 0, (byte) 4);
+        second.setNetId(12);
+        inventory.setItem(1, second);
+        final BedrockItem oldGridItem = new BedrockItem(3);
+        oldGridItem.setNetId(13);
+        hud.setItem(28, oldGridItem);
+
+        final ShapedRecipe shaped = new ShapedRecipe("player", UUID.randomUUID(),
+                "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 1), new TestDescriptor(2, 1)}},
+                List.of(new BedrockItem(4)), false);
+        final CraftingDataStorage recipe = new CraftingDataStorage(RecipeType.SHAPED, 7,
+                shaped, true);
+        final CraftingPlacement.Placement placement = CraftingPlacement.plan(recipe, 2, 28,
+                hud, inventory, false, item -> 64,
+                (descriptor, item) -> descriptor.matchesItem(null, item));
+        final List<ItemStackRequestAction> actions = CraftingPlacement.actions(placement,
+                hud, inventory);
+
+        final ItemStackRequestAction.PlaceAction clear = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class, actions.get(0));
+        assertEquals(28, clear.source().slot());
+        assertEquals(ContainerEnumName.CraftingInputContainer,
+                clear.source().container().name());
+        assertEquals(9, clear.destination().slot());
+        final ItemStackRequestAction.PlaceAction placeFirst = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class, actions.get(1));
+        assertEquals(0, placeFirst.source().slot());
+        assertEquals(28, placeFirst.destination().slot());
+        assertEquals(11, placeFirst.source().stackNetworkId());
+        final ItemStackRequestAction.PlaceAction placeSecond = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class, actions.get(2));
+        assertEquals(29, placeSecond.destination().slot());
+
+        CraftingPlacement.apply(placement, hud, inventory);
+        assertEquals(3, inventory.getItem(9).identifier());
+        assertEquals(1, hud.getItem(28).identifier());
+        assertEquals(2, hud.getItem(29).identifier());
+        assertEquals(3, inventory.getItem(0).amount());
+    }
+
+    @Test
+    void threeWideRecipeDoesNotFitPlayerGrid() {
+        final UserConnection user = user();
+        final ShapedRecipe shaped = new ShapedRecipe("wide", UUID.randomUUID(),
+                "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 1),
+                        new TestDescriptor(1, 1), new TestDescriptor(1, 1)}},
+                List.of(new BedrockItem(4)), false);
+        final CraftingDataStorage recipe = new CraftingDataStorage(RecipeType.SHAPED, 7,
+                shaped, true);
+        assertNull(CraftingPlacement.plan(recipe, 2, 28, new HudContainer(user),
+                inventory(user), false, item -> 64,
+                (descriptor, item) -> descriptor.matchesItem(null, item)));
+    }
+
+    private static InventoryContainer inventory(final UserConnection user) {
+        return new InventoryContainer(user) {
+            @Override
+            protected void onSlotChanged(final int slot, final BedrockItem previous,
+                    final BedrockItem current) {
+            }
+        };
+    }
+
+    private static UserConnection user() {
+        return (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[] {UserConnection.class}, (proxy, method, args) -> null);
+    }
+
+    private record TestDescriptor(int id, int amount) implements ItemDescriptor {
+
+        @Override
+        public ItemDescriptorType getType() {
+            return ItemDescriptorType.ITEM_NAME;
+        }
+
+        @Override
+        public boolean matchesItem(final UserConnection user, final BedrockItem item) {
+            return !item.isEmpty() && (this.id == 0 || this.id == item.identifier());
+        }
+
+        @Override
+        public ItemDescriptor withAmount(final int amount) {
+            return new TestDescriptor(this.id, amount);
+        }
+    }
+
+}
