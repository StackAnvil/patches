+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.NativeFurnaceOptions;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.FurnaceLayout;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.FurnaceLeftTabIndex;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.SetPlayerFurnaceOptionsPacketPayload_FurnaceType;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Connection-local native options and the separate Java recipe-book projection. */
+public final class FurnaceOptionsStorage implements StorableObject {
+
+    private final Map<Integer, FurnaceOptions> options = new HashMap<>();
+    private final BookSettings[] javaBooks = {
+        new BookSettings(false, false), new BookSettings(false, false),
+        new BookSettings(false, false), new BookSettings(false, false)
+    };
+
+    public FurnaceOptions options(final int furnaceType) {
+        return this.options.get(furnaceType);
+    }
+
+    public List<FurnaceOptions> snapshot() {
+        return this.options.values().stream().sorted(Comparator.comparingInt(FurnaceOptions::furnaceType)).toList();
+    }
+
+    public void sendNativeSnapshot(final UserConnection user) {
+        if (!canSend(user)) {
+            return;
+        }
+        sendNativeCapability(user, true);
+        for (final FurnaceOptions value : this.snapshot()) {
+            sendNativeUpdate(user, value);
+        }
+    }
+
+    public static void sendNativeCapability(final UserConnection user, final boolean registered) {
+        if (user.getProtocolInfo().getClientState() != State.PLAY) {
+            return;
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        packet.write(Types.STRING, registered ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, NativeFurnaceOptions.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private static boolean canSend(final UserConnection user) {
+        return user.getProtocolInfo().getClientState() == State.PLAY
+                && user.get(ChannelStorage.class).hasChannel(NativeFurnaceOptions.CHANNEL);
+    }
+
+    public static void sendNativeUpdate(final UserConnection user, final FurnaceOptions value) {
+        if (!canSend(user)) {
+            return;
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        packet.write(Types.STRING, NativeFurnaceOptions.CHANNEL);
+        packet.write(NativeFurnaceOptions.TYPE, value);
+        packet.send(BedrockProtocol.class);
+    }
+
+    public boolean apply(final FurnaceOptions value) {
+        this.options.put(value.furnaceType(), value);
+        final int bookType = javaBook(value.furnaceType());
+        if (bookType < 0) {
+            return false;
+        }
+        final boolean open = switch (FurnaceLayout.getByValue(value.layout(), FurnaceLayout.None)) {
+            case Default -> true;
+            case InventoryOnly -> false;
+            case None -> this.javaBooks[bookType].open();
+        };
+        this.javaBooks[bookType] = new BookSettings(open, value.filtering());
+        return true;
+    }
+
+    /** Java can express layout and filtering, but not native tab selection. */
+    public FurnaceOptions changeJavaBook(final int bookType, final boolean open, final boolean filtering) {
+        if (bookType < 0 || bookType >= this.javaBooks.length) {
+            return null;
+        }
+        this.javaBooks[bookType] = new BookSettings(open, filtering);
+        final var type = switch (bookType) {
+            case 1 -> SetPlayerFurnaceOptionsPacketPayload_FurnaceType.Furnace;
+            case 2 -> SetPlayerFurnaceOptionsPacketPayload_FurnaceType.BlastFurnace;
+            case 3 -> SetPlayerFurnaceOptionsPacketPayload_FurnaceType.Smoker;
+            default -> null;
+        };
+        if (type == null) {
+            return null;
+        }
+        final FurnaceOptions previous = this.options(type.getValue());
+        final FurnaceOptions value = new FurnaceOptions(type.getValue(),
+                previous == null ? FurnaceLeftTabIndex.None.getValue() : previous.leftTab(), filtering,
+                (open ? FurnaceLayout.Default : FurnaceLayout.InventoryOnly).getValue());
+        this.apply(value);
+        return value;
+    }
+
+    public void writeJavaSettings(final PacketWrapper packet) {
+        for (final BookSettings book : this.javaBooks) {
+            packet.write(Types.BOOLEAN, book.open());
+            packet.write(Types.BOOLEAN, book.filtering());
+        }
+    }
+
+    private static int javaBook(final int furnaceType) {
+        final var type = SetPlayerFurnaceOptionsPacketPayload_FurnaceType.getByValue(furnaceType);
+        if (type == null) {
+            return -1;
+        }
+        return switch (type) {
+            case Furnace -> 1;
+            case BlastFurnace -> 2;
+            case Smoker -> 3;
+            case None -> -1;
+        };
+    }
+
+    private record BookSettings(boolean open, boolean filtering) { }
+
+}
