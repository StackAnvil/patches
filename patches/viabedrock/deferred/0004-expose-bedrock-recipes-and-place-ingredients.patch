+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class CraftingDataTrackerTest {
+
+    @Test
+    void blockItemWireMetadataMatchesPlayerGridIngredients() {
+        // Native protocol 2193 PoF sends stripped oak wood with aux 8 and requires aux 8 for planks.
+        final int itemId = -819;
+        final var states = new Int2ObjectOpenHashMap<IntSortedSet>();
+        states.put(itemId, IntSortedSets.singleton(123));
+        final var user = Mockito.mock(UserConnection.class);
+        final var rewriter = Mockito.mock(ItemRewriter.class);
+        final var names = HashBiMap.<String, Integer>create();
+        names.put("minecraft:stripped_oak_wood", itemId);
+        Mockito.when(user.get(ItemRewriter.class)).thenReturn(rewriter);
+        Mockito.when(rewriter.getItems()).thenReturn(names);
+        final var ingredient = new ItemDescriptor.ItemNameDescriptor("minecraft:stripped_oak_wood", 8);
+        for (final var codec : List.of(
+                new BedrockItemType(0, states, false),
+                new NetworkItemStackDescriptorType(0, states, true))) {
+            final var wire = Unpooled.buffer();
+            try {
+                if (codec instanceof BedrockItemType) {
+                    BedrockTypes.VAR_INT.write(wire, itemId);
+                } else {
+                    wire.writeShortLE(itemId);
+                }
+                wire.writeShortLE(1);
+                BedrockTypes.UNSIGNED_VAR_INT.write(wire, 8);
+                if (codec instanceof NetworkItemStackDescriptorType) {
+                    wire.writeBoolean(false);
+                }
+                if (codec instanceof BedrockItemType) {
+                    BedrockTypes.VAR_INT.write(wire, 123);
+                } else {
+                    BedrockTypes.UNSIGNED_VAR_INT.write(wire, 123);
+                }
+                BedrockTypes.UNSIGNED_VAR_INT.write(wire, 2);
+                wire.writeShortLE(0);
+                final BedrockItem decoded = codec.read(wire);
+                assertEquals(8, decoded.data());
+                assertEquals(123, decoded.blockRuntimeId());
+                final BedrockItem[] grid = BedrockItem.emptyArray(4);
+                grid[2] = decoded;
+                assertArrayEquals(new int[]{0, 0, 1, 0}, CraftingDataTracker.matchShapeless(
+                        List.of(ingredient), grid, (descriptor, item) -> descriptor.matchesItem(user, item)));
+                decoded.setData(0);
+                assertNull(CraftingDataTracker.matchShapeless(List.of(ingredient), grid,
+                        (descriptor, item) -> descriptor.matchesItem(user, item)));
+            } finally {
+                wire.release();
+            }
+        }
+    }
+
+    @Test
+    void overlappingShapelessDescriptorsFindValidAssignment() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(9);
+        grid[0] = new BedrockItem(1, (short) 0, (byte) 2);
+        grid[1] = new BedrockItem(2);
+        final int[] amounts = CraftingDataTracker.matchShapeless(
+                List.of(new TestDescriptor(0, 1), new TestDescriptor(1, 2)),
+                grid, (descriptor, item) -> descriptor.matchesItem(null, item)
+                        && item.amount() >= descriptor.amount());
+        assertArrayEquals(new int[] {2, 1, 0, 0, 0, 0, 0, 0, 0}, amounts);
+    }
+
+    @Test
+    void shapedMatchKeepsTheIngredientCountAtTheMirroredSlot() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(9);
+        grid[3] = new BedrockItem(2);
+        grid[4] = new BedrockItem(1, (short) 0, (byte) 3);
+        final ShapedRecipe recipe = new ShapedRecipe(
+                "test", UUID.randomUUID(), "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 3), new TestDescriptor(2, 1)}},
+                List.of(new BedrockItem(3)), true);
+        final int[] amounts = CraftingDataTracker.matchShaped(
+                recipe, grid, (descriptor, item) -> descriptor.matchesItem(null, item)
+                        && item.amount() >= descriptor.amount());
+        assertArrayEquals(new int[] {0, 0, 0, 1, 3, 0, 0, 0, 0}, amounts);
+    }
+
+    @Test
+    void playerGridMatchesShiftedTwoByTwoRecipeButRejectsThreeWideRecipe() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(4);
+        grid[2] = new BedrockItem(1);
+        grid[3] = new BedrockItem(2);
+        final ShapedRecipe twoWide = new ShapedRecipe(
+                "two-wide", UUID.randomUUID(), "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 1), new TestDescriptor(2, 1)}},
+                List.of(new BedrockItem(3)), false);
+        assertArrayEquals(new int[] {0, 0, 1, 1}, CraftingDataTracker.matchShaped(
+                twoWide, grid, 2, (descriptor, item) -> descriptor.matchesItem(null, item)));
+
+        final ShapedRecipe threeWide = new ShapedRecipe(
+                "three-wide", UUID.randomUUID(), "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 1), new TestDescriptor(2, 1),
+                        new TestDescriptor(1, 1)}}, List.of(new BedrockItem(3)), false);
+        assertNull(CraftingDataTracker.matchShaped(
+                threeWide, grid, 2, (descriptor, item) -> descriptor.matchesItem(null, item)));
+    }
+
+    @Test
+    void extraItemsRejectRecipe() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(9);
+        grid[0] = new BedrockItem(1);
+        grid[1] = new BedrockItem(2);
+        assertNull(CraftingDataTracker.matchShapeless(
+                List.of(new TestDescriptor(1, 1)), grid,
+                (descriptor, item) -> descriptor.matchesItem(null, item)));
+    }
+
+    @Test
+    void recipeDisplayIdsSurviveCatalogUpdatesWithoutReusingRemovedIds() {
+        final CraftingDataTracker tracker = new CraftingDataTracker(user());
+        final UUID recipeId = UUID.randomUUID();
+        final CraftingDataStorage first = recipe("first", recipeId, 10, false);
+        final CraftingDataStorage updated = recipe("first", recipeId, 20, false);
+        final CraftingDataStorage replacement = recipe("second", UUID.randomUUID(), 10, false);
+
+        final int firstId = tracker.displayIdFor(first);
+        assertEquals(firstId, tracker.displayIdFor(updated));
+        assertNotEquals(firstId, tracker.displayIdFor(replacement));
+    }
+
+    @Test
+    void recipeDisplayIdentityIncludesTheCookingStation() {
+        final CraftingDataTracker tracker = new CraftingDataTracker(user());
+        final UUID id = UUID.randomUUID();
+        final var furnace = new CraftingDataStorage(RecipeType.SHAPELESS, 7,
+                new ShapelessRecipe("cooking", id, "furnace", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(2))), true);
+        final var smoker = new CraftingDataStorage(RecipeType.SHAPELESS, 8,
+                new ShapelessRecipe("cooking", id, "smoker", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(2))), true);
+        assertNotEquals(tracker.displayIdFor(furnace), tracker.displayIdFor(smoker));
+        assertEquals(tracker.displayIdFor(furnace), tracker.displayIdFor(
+                new CraftingDataStorage(furnace.type(), 9, furnace.recipe(), true)));
+    }
+
+    @Test
+    void unlockUpdatesAddRemoveAndReplaceRecipeAvailability() {
+        final CraftingDataTracker tracker = new CraftingDataTracker(user());
+        final CraftingDataStorage locked = recipe("locked", UUID.randomUUID(), 1, false);
+        final CraftingDataStorage automatic = recipe("automatic", UUID.randomUUID(), 2, true);
+        assertFalse(tracker.isRecipeUnlocked(locked));
+        assertTrue(tracker.isRecipeUnlocked(automatic));
+
+        tracker.updateUnlockedRecipes(2, List.of("locked"));
+        assertTrue(tracker.isRecipeUnlocked(locked));
+        tracker.updateUnlockedRecipes(3, List.of("locked"));
+        assertFalse(tracker.isRecipeUnlocked(locked));
+        tracker.updateUnlockedRecipes(1, List.of("locked"));
+        assertTrue(tracker.isRecipeUnlocked(locked));
+        tracker.updateUnlockedRecipes(4, List.of());
+        assertFalse(tracker.isRecipeUnlocked(locked));
+    }
+
+    @Test
+    void recipeDisplayUsesDefaultMetadataForWildcardIngredients() {
+        assertEquals(0, CraftingDataTracker.javaDisplayAuxValue(-1));
+        assertEquals(0, CraftingDataTracker.javaDisplayAuxValue(Short.MAX_VALUE));
+        assertEquals(7, CraftingDataTracker.javaDisplayAuxValue(7));
+    }
+
+    private static CraftingDataStorage recipe(final String name, final UUID id,
+            final int networkId, final boolean alwaysUnlocked) {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, networkId,
+                new ShapelessRecipe(name, id, "crafting_table", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(2))),
+                alwaysUnlocked);
+    }
+
+    private static UserConnection user() {
+        return (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+    }
+
+    private record TestDescriptor(int id, int amount) implements ItemDescriptor {
+
+        @Override
+        public ItemDescriptorType getType() {
+            return ItemDescriptorType.ITEM_NAME;
+        }
+
+        @Override
+        public boolean matchesItem(final UserConnection user, final BedrockItem item) {
+            return !item.isEmpty() && (this.id == 0 || this.id == item.identifier());
+        }
+
+        @Override
+        public ItemDescriptor withAmount(final int amount) {
+            return new TestDescriptor(this.id, amount);
+        }
+    }
+
+}
