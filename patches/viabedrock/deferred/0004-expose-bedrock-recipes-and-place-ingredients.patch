+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FurnaceOptionsPacketTest {
+
+    @Test
+    void registeredDirectionsTranslateRealOptionsAndPreserveOtherBooks() throws Exception {
+        final BedrockProtocol protocol = mock(BedrockProtocol.class);
+        InventoryPackets.register(protocol);
+        final var inbound = ArgumentCaptor.forClass(PacketHandler.class);
+        final var outbound = ArgumentCaptor.forClass(PacketHandler.class);
+        verify(protocol).registerClientbound(eq(ClientboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS),
+                eq(ClientboundPackets26_3.RECIPE_BOOK_SETTINGS), inbound.capture());
+        verify(protocol).registerServerbound(eq(ServerboundPackets26_3.RECIPE_BOOK_CHANGE_SETTINGS),
+                eq(ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS), outbound.capture());
+        assertEquals(351, ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS.getId());
+        assertSame(ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS,
+                ServerboundBedrockPackets.getPacket(351));
+        final var fixture = new Fixture();
+        fixture.preferences.changeJavaBook(0, true, true);
+        fixture.preferences.apply(new FurnaceOptions(2, 3, true, 1));
+        fixture.preferences.apply(new FurnaceOptions(3, 1, false, 2));
+        final var packet = fixture.nativePacket(new FurnaceOptions(1, 4, true, 2));
+        inbound.getValue().handle(packet);
+        assertFalse(packet.isCancelled());
+        assertArrayEquals(new boolean[]{true, true, true, true, false, true, true, false}, snapshot(packet));
+        final var updated = fixture.javaPacket(1, false, false);
+        outbound.getValue().handle(updated);
+        assertFalse(updated.isCancelled());
+        assertEquals(new FurnaceOptions(1, 4, false, 1), updated.get(BedrockTypes.FURNACE_OPTIONS, 0));
+        assertEquals(new FurnaceOptions(2, 3, true, 1), fixture.preferences.options(2));
+        assertEquals(new FurnaceOptions(3, 1, false, 2), fixture.preferences.options(3));
+        final ByteBuf bytes = Unpooled.buffer();
+        try {
+            updated.writeToBuffer(bytes);
+            assertEquals(351, Types.VAR_INT.readPrimitive(bytes));
+            assertEquals(1, bytes.readUnsignedByte());
+            assertEquals(8, bytes.readUnsignedByte());
+            assertEquals(0, bytes.readUnsignedByte());
+            assertEquals(2, bytes.readUnsignedByte());
+            assertFalse(bytes.isReadable());
+        } finally {
+            bytes.release();
+        }
+    }
+
+    @Test
+    void unknownEnumsStayNativeAndDoNotResetUnrelatedJavaPreferences() {
+        final var fixture = new Fixture();
+        fixture.preferences.changeJavaBook(0, true, false);
+        fixture.preferences.changeJavaBook(1, true, false);
+        final var none = fixture.nativePacket(new FurnaceOptions(0, 0, true, 0));
+        InventoryPackets.handleFurnaceOptions(none);
+        assertTrue(none.isCancelled());
+        final var unknown = fixture.nativePacket(new FurnaceOptions(255, -4, true, -8));
+        InventoryPackets.handleFurnaceOptions(unknown);
+        assertTrue(unknown.isCancelled());
+        assertEquals(new FurnaceOptions(255, -4, true, -8), fixture.preferences.options(255));
+        final var rawLayout = fixture.nativePacket(new FurnaceOptions(1, -4, true, -8));
+        InventoryPackets.handleFurnaceOptions(rawLayout);
+        assertFalse(rawLayout.isCancelled());
+        assertArrayEquals(new boolean[]{true, false, true, true, false, false, false, false}, snapshot(rawLayout));
+        final var client = fixture.javaPacket(1, false, false);
+        InventoryPackets.handleJavaRecipeBookSettings(client);
+        assertEquals(new FurnaceOptions(1, -4, false, 1), client.get(BedrockTypes.FURNACE_OPTIONS, 0));
+        final var invalid = fixture.javaPacket(255, false, false);
+        InventoryPackets.handleJavaRecipeBookSettings(invalid);
+        assertTrue(invalid.isCancelled());
+        final var crafting = fixture.javaPacket(0, true, true);
+        InventoryPackets.handleJavaRecipeBookSettings(crafting);
+        assertTrue(crafting.isCancelled());
+        assertEquals(new FurnaceOptions(0, 0, true, 0), fixture.preferences.options(0));
+    }
+
+    @Test
+    void independentFamiliesRetainTabChoicesAcrossServerAndClientUpdates() {
+        final var fixture = new Fixture();
+        for (int family = 1; family <= 3; family++) {
+            final var server = fixture.nativePacket(new FurnaceOptions(family, 6 - family, family != 2, 2));
+            InventoryPackets.handleFurnaceOptions(server);
+            final var client = fixture.javaPacket(family, false, family == 2);
+            InventoryPackets.handleJavaRecipeBookSettings(client);
+            assertEquals(new FurnaceOptions(family, 6 - family, family == 2, 1),
+                    client.get(BedrockTypes.FURNACE_OPTIONS, 0));
+        }
+        final var reopened = fixture.nativePacket(new FurnaceOptions(2, 1, false, 2));
+        InventoryPackets.handleFurnaceOptions(reopened);
+        assertArrayEquals(new boolean[]{false, false, false, false, true, false, false, false}, snapshot(reopened));
+        assertNull(new FurnaceOptionsStorage().options(2));
+    }
+
+    private static boolean[] snapshot(final PacketWrapper packet) {
+        final boolean[] result = new boolean[8];
+        for (int index = 0; index < result.length; index++) {
+            result[index] = packet.get(Types.BOOLEAN, index);
+        }
+        return result;
+    }
+
+    private static final class Fixture {
+        private final FurnaceOptionsStorage preferences = new FurnaceOptionsStorage();
+        private final UserConnection user = mock(UserConnection.class);
+
+        private Fixture() {
+            when(this.user.get(FurnaceOptionsStorage.class)).thenReturn(this.preferences);
+            when(this.user.get(ChannelStorage.class)).thenReturn(new ChannelStorage());
+            final var info = mock(com.viaversion.viaversion.api.connection.ProtocolInfo.class);
+            when(this.user.getProtocolInfo()).thenReturn(info);
+            when(info.getClientState()).thenReturn(State.PLAY);
+        }
+
+        private PacketWrapper nativePacket(final FurnaceOptions options) {
+            final var packet = new PacketWrapperImpl(ClientboundPackets26_3.RECIPE_BOOK_SETTINGS, null, this.user);
+            packet.write(BedrockTypes.FURNACE_OPTIONS, options);
+            packet.resetReader();
+            return packet;
+        }
+
+        private PacketWrapper javaPacket(final int book, final boolean open, final boolean filtering) {
+            final var packet = new PacketWrapperImpl(ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS, null, this.user);
+            packet.write(Types.VAR_INT, book);
+            packet.write(Types.BOOLEAN, open);
+            packet.write(Types.BOOLEAN, filtering);
+            packet.resetReader();
+            return packet;
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/NativeFurnaceOptionsPacketTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/NativeFurnaceOptionsPacketTest.java
