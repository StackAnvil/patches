+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemEntry;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Cooking descriptor visitation constructs default Items rather than retaining the declared auxiliary value. */
+public final class CookingRecipeInputs {
+
+    private CookingRecipeInputs() { }
+
+    public static List<BedrockItem> expand(final UserConnection user, final ItemDescriptor descriptor) {
+        final var items = user.get(ItemRewriter.class);
+        final List<ItemEntry> definitions;
+        if (descriptor instanceof ItemDescriptor.ItemNameDescriptor named) {
+            final var definition = items.getItemRegistry().definition(named.fullName());
+            if (definition == null) {
+                return List.of();
+            }
+            final String association = items.cookingProperties(new BedrockItem(definition.id())).blockIdentifier();
+            if (association != null && user.get(BlockStateRewriter.class).blockItemState(association, (short) named.auxValue()) == null) {
+                return List.of();
+            }
+            definitions = List.of(definition);
+        } else if (descriptor instanceof ItemDescriptor.ItemTagDescriptor || descriptor instanceof ItemDescriptor.MolangDescriptor) {
+            definitions = items.getItemRegistry().entries().stream()
+                    .filter(definition -> descriptor.matchesItem(user, new BedrockItem(definition.id()))).toList();
+        } else {
+            return List.of();
+        }
+        final List<BedrockItem> result = new ArrayList<>();
+        for (final var definition : definitions) {
+            // No runtime candidate: the shared native constructor resolves this Item's default association.
+            final var input = items.createNetworkItem(definition.id(), (short) 0, (byte) 1, 0);
+            if (!input.isEmpty()) {
+                result.add(input);
+            }
+        }
+        return List.copyOf(result);
+    }
+
+}
