+        final BedrockItem result = match == null ? BedrockItem.empty() : craftingResult(match.data());
+        this.craftingPreview = result.copy();
+        final InventoryContainer inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        if (inventory != this) {
+            inventory.craftingPreview = result.copy();
+        }
+    }
+
+    public boolean handleRecipePlacement(final CraftingDataStorage recipe,
+            final boolean maxItems) {
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        if (!requests.canStartRecipePlacement()) {
+            return false;
+        }
+        final HudContainer hud = this.user.get(InventoryTracker.class).getHudContainer();
+        final CraftingPlacement.Placement placement = CraftingPlacement.plan(recipe, 2, 28,
+                hud, this, maxItems, this.user.get(ItemRewriter.class)::maxStackSize,
+                (descriptor, item) -> descriptor.matchesItem(this.user, item));
+        if (placement == null) {
+            return false;
+        }
+
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(
+                requests.nextRequestId(), CraftingPlacement.actions(placement, hud, this),
+                List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0, hud.copy(),
+                List.of(this.copy())));
+        CraftingPlacement.apply(placement, hud, this);
+        this.refreshCraftingOutput();
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    private boolean handleCraftingOutput(final int revision, final byte button,
+            final ContainerInput action) {
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE) {
+            return false;
+        }
+        if (action == ContainerInput.PICKUP && button != 0) {
+            return false;
+        }
+        final CraftingDataTracker.RecipeMatch match = this.user.get(CraftingDataTracker.class)
+                .getRecipeMatch(this, "crafting_table");
+        if (match == null) {
+            return false;
+        }
+        final BedrockItem result = craftingResult(match.data());
+        if (result.isEmpty()) {
+            return false;
+        }
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final HudContainer hud = inventory.getHudContainer();
+        final boolean toInventory = action == ContainerInput.QUICK_MOVE;
+        final int maxStackSize = this.user.get(ItemRewriter.class).maxStackSize(result);
+        final CraftingOutputPlan plan = toInventory
+                ? CraftingOutputPlan.plan(this, result, hud, 28, match.amounts(), maxStackSize)
+                : CraftingOutputPlan.pickup(hud, result, maxStackSize);
+        if (plan == null) {
+            return false;
+        }
+        final int destination = plan.destination();
+        final int crafts = plan.crafts();
+        final int outputAmount = plan.outputAmount();
+        final int destinationNetId = plan.destinationNetId();
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final List<ItemStackRequestAction> actions = craftingOutputActions(match, hud,
+                this, destination, toInventory, requestId, crafts, outputAmount,
+                destinationNetId);
+        if (actions == null) {
+            return false;
+        }
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId, actions,
+                List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, revision, hud.copy(),
+                List.of(this.copy())));
+        for (int index = 0; index < match.amounts().length; index++) {
+            final int amount = match.amounts()[index];
+            if (amount == 0) {
+                continue;
+            }
+            final int slot = 28 + index;
+            final BedrockItem ingredient = hud.getItem(slot);
+            hud.setItem(slot, this.itemAfterRemovingAmount(ingredient, amount * crafts));
+        }
+        plan.apply(toInventory ? this : hud, result);
+        this.refreshCraftingOutput();
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    static List<ItemStackRequestAction> craftingOutputActions(
+            final CraftingDataTracker.RecipeMatch match, final HudContainer hud,
+            final InventoryContainer inventory,
+            final int destination, final boolean toInventory, final int requestId,
+            final int crafts, final int outputAmount, final int destinationNetId) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeAction(match.data().networkId(), crafts));
+        actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(
+                List.of(craftingResult(match.data()).copy()), crafts));
+        for (int index = 0; index < match.amounts().length; index++) {
+            final int amount = match.amounts()[index];
+            if (amount == 0) {
+                continue;
+            }
+            final int slot = 28 + index;
+            final BedrockItem ingredient = hud.getItem(slot);
+            if (ingredient.netId() == null) {
+                return null;
+            }
+            actions.add(new ItemStackRequestAction.ConsumeAction(amount * crafts,
+                    new ItemStackRequestSlotInfo(hud.getFullContainerName(slot),
+                            (byte) slot, ingredient.netId())));
+        }
+        actions.add(new ItemStackRequestAction.PlaceAction(outputAmount,
+                new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                        (byte) 50, requestId),
+                new ItemStackRequestSlotInfo(toInventory
+                        ? inventory.getFullContainerName(destination) : hud.getFullContainerName(0),
+                        (byte) destination, destinationNetId)));
+        return actions;
+    }
+
+    private static BedrockItem craftingResult(final CraftingDataStorage data) {
+        if (data.recipe() instanceof ShapedRecipe recipe) {
+            return recipe.getResults().get(0);
+        }
+        if (data.recipe() instanceof ShapelessRecipe recipe) {
+            return recipe.getResults().get(0);
+        }
+        return BedrockItem.empty();
+    }
+
     public byte getSelectedHotbarSlot() {
         return this.selectedHotbarSlot;
     }
