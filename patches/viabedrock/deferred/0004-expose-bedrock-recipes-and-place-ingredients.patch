@@ -0,0 +1,87 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.ListTag;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingRecipeOrder;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/** Native cooking collection caches eligibility by concrete descriptor before ordering source groups. */
+public final class CookingRecipeSources {
+
+    private CookingRecipeSources() { }
+
+    public static <C> Result<C> collect(final List<C> containers, final Function<C, BedrockItem[]> contents,
+                                        final Function<BedrockItem, ItemRecipeKey> identity,
+                                        final Predicate<BedrockItem> matches) {
+        final Map<Integer, Group<C>> groups = new LinkedHashMap<>();
+        for (final C container : containers) {
+            if (container == null) {
+                continue;
+            }
+            final BedrockItem[] items = contents.apply(container);
+            for (int slot = 0; slot < items.length; slot++) {
+                final BedrockItem item = items[slot];
+                if (item.amount() == 0) {
+                    continue;
+                }
+                final ItemRecipeKey key = identity.apply(item);
+                final int hash = key != null ? key.descriptorHash() : 0;
+                final Group<C> group = groups.computeIfAbsent(hash, ignored -> new Group<>(
+                        key != null && eligible(item) && matches.test(item)));
+                if (group.accepted) {
+                    group.sources.add(new Source<>(container, slot));
+                    group.amount += item.amount();
+                }
+            }
+        }
+        final List<Source<C>> sources = new ArrayList<>();
+        int amount = 0;
+        // Rejected groups stay in the sort: removing them first changes equal-count tie order.
+        for (final Group<C> group : CookingRecipeOrder.sorted(new ArrayList<>(groups.values()), entry -> -entry.amount)) {
+            if (group.amount > 0) {
+                sources.addAll(group.sources);
+                amount += group.amount;
+            }
+        }
+        return new Result<>(sources, amount);
+    }
+
+    private static boolean eligible(final BedrockItem item) {
+        return item.tag() == null || !(item.tag().get("ench") instanceof ListTag<?>)
+                && !(item.tag().get("minecraft:item_lock") instanceof ByteTag lock && lock.asByte() != 0);
+    }
+
+    public record Source<C>(C container, int slot) { }
+
+    public record Result<C>(List<Source<C>> sources, int amount) {
+
+        public Result {
+            sources = List.copyOf(sources);
+        }
+    }
+
+    private static final class Group<C> {
+
+        private final boolean accepted;
+        private final List<Source<C>> sources = new ArrayList<>();
+        private int amount;
+
+        private Group(final boolean accepted) {
+            this.accepted = accepted;
+        }
+    }
+
+}
