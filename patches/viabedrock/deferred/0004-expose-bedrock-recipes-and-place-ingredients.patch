+        assertEquals(ContainerEnumName.CreatedOutputContainer, place.source().container().name());
+        assertEquals(50, place.source().slot());
+        assertEquals(-3, place.source().stackNetworkId());
+        assertEquals(ContainerEnumName.CursorContainer, place.destination().container().name());
+        assertEquals(0, place.destination().slot());
