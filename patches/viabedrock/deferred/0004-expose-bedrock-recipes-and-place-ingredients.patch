+    @Test
+    void nativeCatalogKeepsUndisplayedRecipesAndRejectsStaleOrForeignOwnership() {
+        final var tracker = new CraftingDataTracker(user());
+        final var locked = recipe("locked", UUID.randomUUID(), 1, false);
+        final var automatic = recipe("automatic", UUID.randomUUID(), 2, true);
+        tracker.updateCraftingDataList(List.of(locked, automatic), true);
+        final var catalog = tracker.recipeCatalog(data -> true);
+        final int lockedId = catalog.entries().get(0).id();
+        final int automaticId = catalog.entries().get(1).id();
+        assertTrue(catalog.current(tracker));
+        assertFalse(catalog.current(new CraftingDataTracker(user())));
+        assertNull(tracker.getDisplayedRecipe(automaticId));
+        assertSame(automatic, catalog.recipe(automaticId));
+        assertNull(catalog.recipe(lockedId));
+        assertNull(catalog.recipe(-1));
+        assertThrows(UnsupportedOperationException.class, () -> catalog.entries().clear());
+
+        tracker.updateUnlockedRecipes(2, List.of(locked.recipe().getUniqueId()));
+        assertFalse(catalog.current(tracker));
+        assertNull(catalog.recipe(automaticId));
+        final var unlocked = tracker.recipeCatalog(data -> true);
+        assertSame(locked, unlocked.recipe(lockedId));
+        assertSame(automatic, unlocked.recipe(automaticId));
+        tracker.updateUnlockedRecipes(0, List.of());
+        assertTrue(unlocked.current(tracker));
+        tracker.updateUnlockedRecipes(3, List.of(locked.recipe().getUniqueId()));
+        assertNull(unlocked.recipe(lockedId));
+        assertNull(tracker.recipeCatalog(data -> true).recipe(lockedId));
+    }
