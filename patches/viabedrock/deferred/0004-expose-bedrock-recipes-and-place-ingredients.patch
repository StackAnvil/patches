+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemEntry;
+import net.raphimc.viabedrock.protocol.model.ItemRegistry;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CookingRecipeAvailabilityTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_AVAILABILITY", matches = ".+")
+    void matchesNativeEvaluatorWithRealDescriptorCollectionAndOrderedProviders() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_AVAILABILITY")))).getAsJsonObject();
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:ordinary", 1, false, ItemVersion.Legacy, null)});
+        int compared = 0;
+        for (final var element : reference.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            // Non-boolean flag bytes are retained as native research controls, outside the controller's bool contract.
+            final int flag = row.get("base").getAsInt();
+            if (flag > 1) {
+                continue;
+            }
+            final var providers = new ArrayList<BedrockItem[]>();
+            for (int index = 0; index < row.getAsJsonArray("counts").size(); index++) {
+                final var item = new BedrockItem(1, row.getAsJsonArray("auxiliary").get(index).getAsShort(),
+                        row.getAsJsonArray("counts").get(index).getAsByte());
+                if (row.getAsJsonArray("blocked").get(index).getAsBoolean()) {
+                    final var tag = new CompoundTag();
+                    tag.put("ench", new ListTag<>(CompoundTag.class));
+                    item.setTag(tag);
+                }
+                providers.add(index < 4 || row.get("includeOptional").getAsBoolean() && row.get("optionalPresent").getAsBoolean()
+                        ? new BedrockItem[]{item} : new BedrockItem[0]);
+            }
+            final List<ItemRecipeKey> alternatives = new ArrayList<>();
+            for (final var requirement : row.getAsJsonArray("requirements")) {
+                alternatives.add(new ItemRecipeKey(1, requirement.getAsJsonArray().get(0).getAsShort()));
+            }
+            final boolean valid = row.get("guard").getAsString().equals("valid");
+            final int result = CookingRecipeAvailability.evaluate(valid, flag != 0, alternatives, query -> {
+                assertTrue(valid);
+                return CookingRecipeSources.collect(providers, Function.identity(), item -> registry.recipeKey(item, null),
+                        item -> query.matches(registry.recipeKey(item, null), ignored -> null));
+            });
+            assertEquals(row.get("result").getAsInt(), result, row::toString);
+            compared++;
+        }
+        assertTrue(compared > 0);
+    }
+
+    @Test
+    void presenceStopsAtAnyUsableAlternativeWithoutApplyingPlacementLimits() {
+        final var source = new CookingRecipeSources.Source<>(new Object(), 0);
+        for (final boolean filtering : new boolean[]{false, true}) {
+            final var queried = new ArrayList<Integer>();
+            final int evaluation = CookingRecipeAvailability.evaluate(true, filtering, List.of(0, 1, 2), alternative -> {
+                queried.add(alternative);
+                return alternative == 0 ? new CookingRecipeSources.Result<>(List.of(), 0)
+                        : new CookingRecipeSources.Result<>(List.of(source), 1);
+            });
+            assertEquals(filtering ? 0 : 1, evaluation);
+            assertEquals(List.of(0, 1), queried);
+            assertEquals(filtering ? 3 : 2, CookingRecipeAvailability.evaluate(false, filtering, List.of(1),
+                    ignored -> fail("Invalid outputs must not collect sources")));
+            assertEquals(filtering ? 3 : 2, CookingRecipeAvailability.evaluate(true, filtering, List.of(),
+                    ignored -> fail("An empty alternative catalog must not collect sources")));
+            for (final var unusable : List.of(new CookingRecipeSources.Result<>(List.of(source), 0),
+                    new CookingRecipeSources.Result<>(List.of(), 1))) {
+                assertEquals(filtering ? 3 : 2, CookingRecipeAvailability.evaluate(true, filtering, List.of(1), ignored -> unusable));
+            }
+        }
+    }
+
+}
