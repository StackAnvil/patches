+package net.raphimc.viabedrock.api.model.container;
+
+import java.util.List;
+import java.util.function.Function;
+
+/** Native availability tests alternative input presence, independently of placement capacity. */
+public final class CookingRecipeAvailability {
+
+    private CookingRecipeAvailability() { }
+
+    public static <D> int evaluate(final boolean validOutput, final boolean filtering, final List<D> alternatives,
+                                    final Function<D, CookingRecipeSources.Result<?>> collect) {
+        final int flag = filtering ? 1 : 0;
+        if (validOutput) {
+            for (final D alternative : alternatives) {
+                final var sources = collect.apply(alternative);
+                if (!sources.sources().isEmpty() && sources.amount() != 0) {
+                    return flag ^ 1;
+                }
+            }
+        }
+        return flag | 2;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/CookingRecipeCatalog.java b/src/main/java/net/raphimc/viabedrock/api/model/container/CookingRecipeCatalog.java
