+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FurnaceRecipeRequestTest {
+
+    @Test
+    void placementWaitsForAcknowledgmentAndRejectionRestoresBothInventories() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+        final InventoryTracker inventory = new InventoryTracker(user);
+        final InventoryRequestTracker requests = new InventoryRequestTracker(user);
+        final ItemRewriter items = mock(ItemRewriter.class);
+        when(items.maxStackSize(any())).thenReturn(64);
+        when(items.getItems()).thenReturn(HashBiMap.create(Map.of("test:input", 2)));
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        storage.put(ItemRewriter.class, items);
+        requests.setPredictingClick(true);
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        inventory.setCurrentContainer(furnace);
+        furnace.setItem(0, item(3, 2, 17));
+        furnace.setItem(1, item(5, 4, 18));
+        furnace.setItem(2, item(6, 1, 19));
+        final InventoryContainer player = inventory.getInventoryContainer();
+        player.setItem(0, item(2, 8, 20));
+        final CraftingDataStorage recipe = recipe();
+        final ItemStackRequestInfo[] sent = new ItemStackRequestInfo[1];
+        try (var packets = mockStatic(PacketFactory.class)) {
+            packets.when(() -> PacketFactory.sendBedrockInventoryRequest(eq(user), any())).thenAnswer(call -> {
+                sent[0] = ((ItemStackRequestInfo[]) call.getArgument(1))[0];
+                requests.getRequest(sent[0].requestId()).capturePrediction(inventory);
+                return null;
+            });
+            assertTrue(requests.beginInventoryOpen());
+            assertFalse(furnace.handleRecipePlacement(recipe, true));
+            requests.handleInventoryOpen(player);
+            assertTrue(furnace.handleRecipePlacement(recipe, true));
+            assertEquals(8, furnace.getItem(0).amount());
+            assertTrue(player.getItem(0).isEmpty());
+            assertEquals(2, player.getItem(1).amount());
+            assertFalse(furnace.handleRecipePlacement(recipe, false));
+            final InventoryRequestStorage pending = requests.getRequest(sent[0].requestId());
+            assertEquals(2, pending.prevContainers().size());
+            assertEquals(3, pending.prevContainers().get(0).getItem(0).identifier());
+            assertEquals(2, pending.predictedItem(furnace, 0).identifier());
+            requests.restoreRejectedRequest(pending);
+            requests.removeRequest(sent[0].requestId());
+            assertEquals(item(3, 2, 17), furnace.getItem(0));
+            assertEquals(item(2, 8, 20), player.getItem(0));
+            assertTrue(player.getItem(1).isEmpty());
+            assertEquals(item(5, 4, 18), furnace.getItem(1));
+            assertEquals(item(6, 1, 19), furnace.getItem(2));
+            inventory.getHudContainer().setItem(0, item(3, 1, 23));
+            assertFalse(furnace.handleRecipePlacement(recipe, false));
+            inventory.getHudContainer().setItem(0, BedrockItem.empty());
+            assertTrue(furnace.handleRecipePlacement(recipe, false));
+            final InventoryRequestStorage accepted = requests.getRequest(sent[0].requestId());
+            requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success,
+                    sent[0].requestId(), List.of(
+                        new ItemStackResponseContainerInfo(furnace.getFullContainerName(0),
+                                List.of(new ItemStackResponseSlotInfo((byte) 0, (byte) 0, (byte) 1,
+                                        90, "", null, 0))),
+                        new ItemStackResponseContainerInfo(player.getFullContainerName(0),
+                                List.of(new ItemStackResponseSlotInfo((byte) 0, (byte) 0, (byte) 7,
+                                        91, "", null, 0))))), accepted);
+            requests.removeRequest(sent[0].requestId());
+            assertEquals(90, furnace.getItem(0).netId());
+            assertEquals(91, player.getItem(0).netId());
+            assertTrue(furnace.handleRecipePlacement(recipe, false));
+            final var transfer = (ItemStackRequestAction.PlaceAction) sent[0].actions().get(0);
+            assertEquals(91, transfer.source().stackNetworkId());
+            assertEquals(90, transfer.destination().stackNetworkId());
+            assertEquals(1, transfer.count());
+            inventory.setCurrentContainerClosed(false);
+            assertFalse(furnace.handleRecipePlacement(recipe, false));
+            packets.verify(() -> PacketFactory.sendBedrockInventoryRequest(eq(user), any()), times(3));
+        }
+    }
+
+    private static CraftingDataStorage recipe() {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, 7,
+                new ShapelessRecipe("cooking", UUID.randomUUID(), "furnace", 0,
+                        List.of(new ItemDescriptor.ItemNameDescriptor("test:input", 0)),
+                        List.of(new BedrockItem(4))), true);
+    }
+
+    private static BedrockItem item(final int id, final int amount, final int netId) {
+        final BedrockItem item = new BedrockItem(id, (short) 0, (byte) amount);
+        item.setNetId(netId);
+        return item;
+    }
+
+}
