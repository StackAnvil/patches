+    @Test
+    void overlappingShapelessDescriptorsFindValidAssignment() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(9);
+        grid[0] = new BedrockItem(1, (short) 0, (byte) 2);
+        grid[1] = new BedrockItem(2);
+        final int[] amounts = CraftingDataTracker.matchShapeless(
+                List.of(new TestDescriptor(0, 1), new TestDescriptor(1, 2)),
+                grid, (descriptor, item) -> descriptor.matchesItem(null, item)
+                        && item.amount() >= descriptor.amount());
+        assertArrayEquals(new int[] {2, 1, 0, 0, 0, 0, 0, 0, 0}, amounts);
+    }
+
+    @Test
+    void shapedMatchKeepsTheIngredientCountAtTheMirroredSlot() {
+        final BedrockItem[] grid = BedrockItem.emptyArray(9);
+        grid[3] = new BedrockItem(2);
+        grid[4] = new BedrockItem(1, (short) 0, (byte) 3);
+        final ShapedRecipe recipe = new ShapedRecipe(
+                "test", UUID.randomUUID(), "crafting_table", 0,
+                new ItemDescriptor[][] {{new TestDescriptor(1, 3), new TestDescriptor(2, 1)}},
+                List.of(new BedrockItem(3)), true);
+        final int[] amounts = CraftingDataTracker.matchShaped(
+                recipe, grid, (descriptor, item) -> descriptor.matchesItem(null, item)
+                        && item.amount() >= descriptor.amount());
+        assertArrayEquals(new int[] {0, 0, 0, 1, 3, 0, 0, 0, 0}, amounts);
+    }
