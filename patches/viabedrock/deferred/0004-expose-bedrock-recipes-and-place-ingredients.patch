+package net.raphimc.viabedrock.protocol.types.model;
+
+import io.netty.buffer.ByteBufUtil;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FurnaceOptionsTypeTest {
+
+    @Test
+    void nativeOptionsUseByteFamilyAndSignedCompressedEnums() {
+        final byte[] wire = {3, 8, 1, 4};
+        final var buffer = Unpooled.wrappedBuffer(wire);
+        final var encoded = Unpooled.buffer();
+        try {
+            final var value = BedrockTypes.FURNACE_OPTIONS.read(buffer);
+            assertEquals(new FurnaceOptions(3, 4, true, 2), value);
+            assertFalse(buffer.isReadable());
+            BedrockTypes.FURNACE_OPTIONS.write(encoded, value);
+            assertArrayEquals(wire, ByteBufUtil.getBytes(encoded));
+        } finally {
+            buffer.release();
+            encoded.release();
+        }
+    }
+
+    @Test
+    void completeTargetDomainAndOpaqueValuesSurviveTheCodec() {
+        final int[] families = {0, 1, 2, 3, 255};
+        final int[] tabs = {0, 1, 2, 3, 4, 5, -1, Integer.MIN_VALUE, Integer.MAX_VALUE};
+        final int[] layouts = {0, 1, 2, -1, Integer.MIN_VALUE, Integer.MAX_VALUE};
+        final var buffer = Unpooled.buffer();
+        try {
+            for (final int family : families) {
+                for (final int tab : tabs) {
+                    for (final int layout : layouts) {
+                        for (final boolean filtering : new boolean[]{false, true}) {
+                            final var value = new FurnaceOptions(family, tab, filtering, layout);
+                            BedrockTypes.FURNACE_OPTIONS.write(buffer, value);
+                            assertEquals(value, BedrockTypes.FURNACE_OPTIONS.read(buffer));
+                            assertFalse(buffer.isReadable());
+                            buffer.clear();
+                        }
+                    }
+                }
+            }
+        } finally {
+            buffer.release();
+        }
+        assertThrows(IllegalArgumentException.class, () -> new FurnaceOptions(-1, 0, false, 0));
+        assertThrows(IllegalArgumentException.class, () -> new FurnaceOptions(256, 0, false, 0));
+    }
+
+    @Test
+    void truncatedOptionsDoNotDecodeAsDefaults() {
+        final byte[] wire = {2, 6, 0, 2};
+        for (int length = 0; length < wire.length; length++) {
+            final var buffer = Unpooled.wrappedBuffer(wire, 0, length);
+            try {
+                assertThrows(IndexOutOfBoundsException.class, () -> BedrockTypes.FURNACE_OPTIONS.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+}
