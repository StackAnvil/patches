+    @Test
+    void wireMetadataResolvesToCanonicalBlockRecipeIdentity() throws Exception {
+        // PoF's aux-8 ingredient and canonical aux-0 inventory state resolve to the same native Block.
+        final int itemId = -819;
+        final var user = Mockito.mock(UserConnection.class);
+        final var rewriter = Mockito.mock(ItemRewriter.class, Mockito.CALLS_REAL_METHODS);
+        final var blocks = Mockito.mock(BlockStateRewriter.class);
+        final String identifier = "minecraft:stripped_oak_wood";
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry(identifier, itemId, false, ItemVersion.Legacy, null)});
+        for (final var fieldValue : Map.of(
+                "registry", registry,
+                "items", registry.ids(),
+                "cookingProperties", Map.of(identifier, new ItemCookingProperties(false, identifier, false))).entrySet()) {
+            final var field = ItemRewriter.class.getDeclaredField(fieldValue.getKey());
+            field.setAccessible(true);
+            field.set(rewriter, fieldValue.getValue());
+        }
+        final var defaultBlock = blockState(identifier, "y");
+        final var variantBlock = blockState(identifier, "x");
+        Mockito.when(blocks.blockState(123)).thenReturn(defaultBlock);
+        Mockito.when(blocks.blockState(124)).thenReturn(variantBlock);
+        Mockito.when(blocks.blockItemNumericId(123)).thenReturn(itemId & 0xFFFF);
+        Mockito.when(blocks.blockItemNumericId(124)).thenReturn(itemId & 0xFFFF);
+        Mockito.doReturn(user).when(rewriter).user();
+        Mockito.when(user.get(ItemRewriter.class)).thenReturn(rewriter);
+        Mockito.when(user.get(BlockStateRewriter.class)).thenReturn(blocks);
+        Mockito.when(blocks.blockItemState(Mockito.eq(identifier), Mockito.anyShort()))
+                .thenAnswer(call -> (short) call.getArgument(1) == 1 ? variantBlock : defaultBlock);
+        Mockito.when(blocks.blockItemRecipeDescriptor(123)).thenReturn(
+                new BlockItemDescriptor(1074, (short) 0));
+        Mockito.when(blocks.blockItemRecipeDescriptor(124)).thenReturn(
+                new BlockItemDescriptor(1074, (short) 1));
+        Mockito.when(blocks.blockItemRecipeDescriptor(Mockito.eq(identifier), Mockito.anyShort())).thenReturn(
+                new BlockItemDescriptor(1074, (short) 0));
+        final var ingredient = new ItemDescriptor.ItemNameDescriptor("minecraft:stripped_oak_wood", 8);
+        for (final var codec : List.of(new BedrockItemType(0, false, rewriter),
+                new NetworkItemStackDescriptorType(0, true, rewriter))) {
+            for (final int auxiliary : new int[]{0, 8}) {
+                final BedrockItem decoded = NetworkItemStackFixtures.decode(codec, itemId, 1, auxiliary, 123);
+                assertEquals(0, decoded.data());
+                assertEquals(123, decoded.blockRuntimeId());
+                final BedrockItem[] grid = BedrockItem.emptyArray(4);
+                grid[2] = decoded;
+                assertArrayEquals(new int[]{0, 0, 1, 0}, CraftingDataTracker.matchShapeless(
+                        List.of(ingredient), grid, (descriptor, item) -> descriptor.matchesItem(user, item)));
+                decoded.setBlockRuntimeId(124);
+                assertNull(CraftingDataTracker.matchShapeless(List.of(ingredient), grid,
+                        (descriptor, item) -> descriptor.matchesItem(user, item)));
+            }
+        }
+    }
