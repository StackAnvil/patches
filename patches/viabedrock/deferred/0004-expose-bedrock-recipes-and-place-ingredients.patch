+    @Test
+    void nativeCatalogDimensionsRemainSeparateFromJavaGridEligibility() {
+        final var user = Mockito.mock(UserConnection.class);
+        final var rewriter = Mockito.mock(ItemRewriter.class);
+        final var names = HashBiMap.<String, Integer>create();
+        names.put("minecraft:crafting_table", 100);
+        Mockito.when(rewriter.getItems()).thenReturn(names);
+        final var javaItem = Mockito.mock(com.viaversion.viaversion.api.minecraft.item.Item.class);
+        Mockito.when(javaItem.identifier()).thenReturn(1);
+        Mockito.when(rewriter.javaItem(Mockito.any(BedrockItem.class))).thenReturn(javaItem);
+        final var tracker = new CraftingDataTracker(user);
+        final int[][] dimensions = {{0, Integer.MAX_VALUE}, {Integer.MAX_VALUE, 0}, {4, 4}, {1, 1}};
+        final var recipes = new ArrayList<CraftingDataStorage>();
+        for (int index = 0; index < dimensions.length; index++) {
+            final int width = dimensions[index][0];
+            final int height = dimensions[index][1];
+            final var ingredients = java.util.Collections.<ItemDescriptor>nCopies(
+                    Math.toIntExact((long) width * height), new ItemDescriptor.InvalidDescriptor());
+            final var shaped = new ShapedRecipe("dimension:" + index, UUID.randomUUID(),
+                    "crafting_table", 0, width, height, ingredients, List.of(new BedrockItem(20)), false);
+            recipes.add(new CraftingDataStorage(RecipeType.SHAPED, index + 1, shaped, true));
+            if (width != 1 || height != 1) {
+                assertNull(CraftingDataTracker.matchShaped(shaped, BedrockItem.emptyArray(9),
+                        (descriptor, item) -> {
+                            throw new AssertionError("Ineligible Java grid attempted matching");
+                        }));
+            }
+        }
+        tracker.updateCraftingDataList(recipes, true);
+        assertEquals(dimensions.length, tracker.recipeCatalog(recipe -> true).entries().size());
+        final var displays = tracker.recipeBookDisplays(rewriter);
+        assertEquals(1, displays.size());
+        assertSame(recipes.getLast(), displays.getFirst().data());
+    }
+
+    private static CraftingDataStorage recipe(final String name, final UUID id,
+            final int networkId, final boolean alwaysUnlocked) {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, networkId,
+                new ShapelessRecipe(name, id, "crafting_table", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(2))),
+                alwaysUnlocked);
+    }
+
+    private static UserConnection user() {
+        return (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+    }
+
+    private record TestDescriptor(int id, int amount) implements ItemDescriptor {
+
+        @Override
+        public ItemDescriptorType getType() {
+            return ItemDescriptorType.ITEM_NAME;
+        }
+
+        @Override
+        public boolean matchesItem(final UserConnection user, final BedrockItem item) {
+            return !item.isEmpty() && (this.id == 0 || this.id == item.identifier());
+        }
+
+        @Override
+        public ItemDescriptor withAmount(final int amount) {
+            return new TestDescriptor(this.id, amount);
+        }
+    }
+
+}
