+package net.raphimc.viabedrock.protocol.types.item;
+
+import com.google.gson.JsonParser;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import com.viaversion.viaversion.libs.fastutil.ints.IntSortedSet;
+import com.viaversion.viaversion.libs.fastutil.ints.IntSortedSets;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockRecipeResultTypeTest {
+
+    @Test
+    void decodesSignedWireCountsWithoutLosingUnsignedStackCountsOrBlockMetadata() {
+        final int[][] counts = {
+            {0, 0}, {1, 1}, {127, 127}, {128, 128}, {255, 255},
+            {256, 0}, {257, 1}, {32767, 255}, {32768, 0}, {65535, 0}
+        };
+        final var states = new Int2ObjectOpenHashMap<IntSortedSet>();
+        states.put(-819, IntSortedSets.singleton(123));
+        final var codec = new BedrockRecipeResultType(0, states);
+        final var buffer = Unpooled.buffer();
+        try {
+            for (final int[] count : counts) {
+                writeResult(buffer, count[0]);
+                final var item = codec.read(buffer);
+                assertEquals(count[1], item.amount());
+                assertEquals(count[1] == 0, item.isEmpty());
+                assertEquals(8, item.data());
+                assertEquals(123, item.blockRuntimeId());
+                assertFalse(buffer.isReadable());
+                buffer.clear();
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_RECIPE_REGISTRATION", matches = ".+")
+    void matchesEveryNativeSignedWireCountConversion() throws Exception {
+        final var root = Path.of(System.getenv("STACKANVIL_NATIVE_RECIPE_REGISTRATION"));
+        final var fixture = JsonParser.parseString(Files.readString(root.resolve("recipe-result-count-reference.json"))).getAsJsonObject();
+        final var digest = MessageDigest.getInstance("SHA-256");
+        final var codec = new BedrockRecipeResultType(0, new Int2ObjectOpenHashMap<>());
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int wire = 0; wire <= 0xFFFF; wire++) {
+                writeResult(buffer, wire);
+                final var item = codec.read(buffer);
+                digest.update((byte) item.amount());
+                assertEquals(item.amount() == 0, item.isEmpty());
+                assertFalse(buffer.isReadable());
+                buffer.clear();
+            }
+        } finally {
+            buffer.release();
+        }
+        assertEquals(65536, fixture.get("cases").getAsInt());
+        assertEquals(fixture.get("outputSha256").getAsString(), HexFormat.of().formatHex(digest.digest()));
+    }
+
+    private static void writeResult(final ByteBuf buffer, final int count) {
+        BedrockTypes.VAR_INT.write(buffer, -819);
+        buffer.writeShortLE(count);
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 8);
+        BedrockTypes.VAR_INT.write(buffer, 123);
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 2);
+        buffer.writeShortLE(0);
+    }
+
+}
