+
+    @Test
+    void playerShiftCraftRequestBatchesConsumptionAndMergesOutput() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+        final HudContainer hud = new HudContainer(user);
+        final BedrockItem ingredient = new BedrockItem(1);
+        ingredient.setAmount(5);
+        ingredient.setNetId(19);
+        hud.setItem(28, ingredient);
+        final InventoryContainer inventory = new InventoryContainer(user);
+        final ShapedRecipe recipe = new ShapedRecipe("test", UUID.randomUUID(),
+                "crafting_table", 0, new ItemDescriptor[][] {{new TestDescriptor()}},
+                List.of(new BedrockItem(2)), false);
+        final CraftingDataTracker.RecipeMatch match = new CraftingDataTracker.RecipeMatch(
+                new CraftingDataStorage(RecipeType.SHAPED, 37, recipe, true),
+                new int[] {1, 0, 0, 0});
+
+        final List<ItemStackRequestAction> actions = InventoryContainer.craftingOutputActions(
+                match, hud, inventory, 9, true, -3, 4, 4, 23);
+
+        final ItemStackRequestAction.CraftRecipeAction craft = assertInstanceOf(
+                ItemStackRequestAction.CraftRecipeAction.class, actions.get(0));
+        assertEquals(4, craft.numberOfRequestedCrafts());
+        final ItemStackRequestAction.CraftResultsDeprecatedAction results = assertInstanceOf(
+                ItemStackRequestAction.CraftResultsDeprecatedAction.class, actions.get(1));
+        assertEquals(4, results.timesCrafted());
+        assertEquals(1, results.resultItems().get(0).amount());
+        final ItemStackRequestAction.ConsumeAction consume = assertInstanceOf(
+                ItemStackRequestAction.ConsumeAction.class, actions.get(2));
+        assertEquals(4, consume.count());
+        final ItemStackRequestAction.PlaceAction place = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class, actions.get(3));
+        assertEquals(4, place.count());
+        assertEquals(23, place.destination().stackNetworkId());
+    }
+
+    private record TestDescriptor() implements ItemDescriptor {
+        @Override
+        public ItemDescriptorType getType() {
+            return ItemDescriptorType.ITEM_NAME;
