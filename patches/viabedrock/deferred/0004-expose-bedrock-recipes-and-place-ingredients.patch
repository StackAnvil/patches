+package net.raphimc.viabedrock.protocol.storage;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.MultiRecipe;
+import net.raphimc.viabedrock.protocol.model.recipe.RecipeType;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapedRecipe;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+@EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_RECIPE_REGISTRATION", matches = ".+")
+class NativeRecipeRegistrationReferenceTest {
+
+    @Test
+    void matchesNativeStationNameAndNetworkIdRejection() throws Exception {
+        for (final var element : fixture("recipe-registration-reference.json").getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var first = recipe(row.get("existing").getAsString(), 1, "furnace");
+            final var incoming = recipe(row.get("incoming").getAsString(), 2, "furnace");
+            final var tracker = new CraftingDataTracker(mock(UserConnection.class));
+            tracker.updateCraftingDataList(List.of(first, incoming), true);
+            assertEquals(row.get("decision").getAsString().equals("continue_registration"), tracker.getCraftingDataList().contains(incoming));
+        }
+        for (final var element : fixture("recipe-network-registration-reference.json").getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            if (row.get("local").getAsBoolean()) {
+                continue; // The tracker receives network registrations, not local factory entries.
+            }
+            final var existing = new ArrayList<CraftingDataStorage>();
+            for (final var id : row.getAsJsonArray("existing")) {
+                existing.add(recipe("existing:" + id.getAsLong(), (int) id.getAsLong(), "smoker"));
+            }
+            final var incoming = recipe("incoming", (int) row.get("incoming").getAsLong(), "furnace");
+            final var tracker = new CraftingDataTracker(mock(UserConnection.class));
+            tracker.updateCraftingDataList(existing, true);
+            tracker.updateCraftingDataList(List.of(incoming), false);
+            assertEquals(row.get("decision").getAsString().equals("accept"), tracker.getCraftingDataList().contains(incoming));
+        }
+    }
+
+    @Test
+    void matchesNativeShapeAdmissionBeforeJavaGridFiltering() throws Exception {
+        for (final var element : fixture("recipe-dimensions-reference.json").getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            assertEquals(row.get("decision").getAsString().equals("accept"),
+                    ShapedRecipe.validDimensions(row.get("width").getAsInt(), row.get("height").getAsInt(), row.get("count").getAsLong()));
+        }
+    }
+
+    @Test
+    void matchesNativeDynamicFactoryDispatch() throws Exception {
+        final var names = Map.ofEntries(
+                Map.entry("repair", "RepairItemRecipe"), Map.entry("map_clone", "MapCloningRecipe"),
+                Map.entry("map_extend", "MapExtendingRecipe"), Map.entry("map_upgrade", "MapUpgradingRecipe"),
+                Map.entry("map_lock", "MapLockingRecipe"), Map.entry("book_clone", "BookCloningRecipe"),
+                Map.entry("banner_duplicate", "BannerDuplicateRecipe"), Map.entry("banner_pattern", "BannerAddPatternRecipe"),
+                Map.entry("fireworks", "FireworksRecipe"), Map.entry("decorated_pot", "DecoratedPotRecipe"), Map.entry("shield", "ShieldRecipe"));
+        for (final var element : fixture("multi-recipe-registration-reference.json").getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            final String expected = names.get(row.get("factory").getAsString());
+            final var recipe = MultiRecipe.fromUuid(UUID.fromString(row.get("uuid").getAsString()));
+            if (expected == null) {
+                assertNull(recipe);
+            } else {
+                assertNotNull(recipe);
+                assertEquals(expected, recipe.getUniqueId());
+            }
+        }
+        final var crafting = MultiRecipe.fromUuid(UUID.fromString("85939755-ba10-4d9d-a4cc-efb7a8e943c4"));
+        final var cartography = MultiRecipe.fromUuid(UUID.fromString("442d85ed-8272-4543-a6f1-418f90ded05d"));
+        assertEquals(crafting.getUniqueId(), cartography.getUniqueId());
+        assertNotEquals(crafting.getRecipeTag(), cartography.getRecipeTag());
+    }
+
+    private static JsonObject fixture(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_RECIPE_REGISTRATION")).resolve(name))).getAsJsonObject();
+    }
+
+    private static CraftingDataStorage recipe(final String name, final int networkId, final String station) {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, networkId,
+                new ShapelessRecipe(name, UUID.randomUUID(), station, 0,
+                        List.of(new ItemDescriptor.InvalidDescriptor()), List.of(new BedrockItem(1))), true);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/types/item/BedrockRecipeResultTypeTest.java b/src/test/java/net/raphimc/viabedrock/protocol/types/item/BedrockRecipeResultTypeTest.java
