+package net.raphimc.viabedrock.protocol.model.recipe;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class MolangTagQueryTest {
+
+    @Test
+    void matchesOnlyKnownItemTagsWithTheRequestedAnyOrAllSemantics() {
+        final Set<String> itemTags = Set.of("minecraft:logs", "minecraft:logs_that_burn");
+        assertTrue(MolangTagQuery.parse("query.any_tag('minecraft:planks', 'minecraft:logs')")
+                .orElseThrow().matches(itemTags));
+        assertFalse(MolangTagQuery.parse("query.any_tag('minecraft:planks')")
+                .orElseThrow().matches(itemTags));
+        assertTrue(MolangTagQuery.parse("query.all_tags('minecraft:logs', 'minecraft:logs_that_burn')")
+                .orElseThrow().matches(itemTags));
+        assertFalse(MolangTagQuery.parse("query.all_tags('minecraft:logs', 'minecraft:planks')")
+                .orElseThrow().matches(itemTags));
+    }
+
+    @Test
+    void ignoresFunctionCaseButPreservesQuotedTagCase() {
+        final MolangTagQuery query = MolangTagQuery.parse("QUERY.ALL_TAGS('example:MixedCase')")
+                .orElseThrow();
+        assertTrue(query.matches(Set.of("example:MixedCase")));
+        assertFalse(query.matches(Set.of("example:mixedcase")));
+        assertTrue(MolangTagQuery.parse("Q.AnY_tAg('example:MixedCase')")
+                .orElseThrow().matches(Set.of("example:MixedCase")));
+    }
+
+    @Test
+    void rejectsExpressionsOutsideTheLiteralTagSubset() {
+        assertTrue(MolangTagQuery.parse("query.any_tag('minecraft:logs') || 1").isEmpty());
+        assertTrue(MolangTagQuery.parse("query.any_tag(variable.tag)").isEmpty());
+        assertTrue(MolangTagQuery.parse("query.any_tag()").isEmpty());
+        assertTrue(MolangTagQuery.parse("query.all_tags('minecraft:logs',)").isEmpty());
+        assertTrue(MolangTagQuery.parse("query.is_item_name_any('minecraft:oak_log')").isEmpty());
+    }
+
+}
