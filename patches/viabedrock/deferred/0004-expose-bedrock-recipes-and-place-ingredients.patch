+class FurnaceRecipePlacementTest {
+
+    @Test
+    void placementUsesEachStationsInputProviderAndLeavesCookingSlotsUntouched() {
+        final UserConnection user = user();
+        final FurnaceContainer[] furnaces = {
+            new FurnaceContainer(user, (byte) 5, null, null),
+            new BlastFurnaceContainer(user, (byte) 6, null, null),
+            new SmokerContainer(user, (byte) 7, null, null)
+        };
+        final String[] tags = {"furnace", "blast_furnace", "smoker"};
+        final ContainerEnumName[] providers = {
+            ContainerEnumName.FurnaceIngredientContainer,
+            ContainerEnumName.BlastFurnaceIngredientContainer, ContainerEnumName.SmokerIngredientContainer
+        };
+        for (int variant = 0; variant < furnaces.length; variant++) {
+            final FurnaceContainer furnace = furnaces[variant];
+            final InventoryContainer inventory = inventory(user);
+            inventory.setItem(0, item(2, 4, 21));
+            furnace.setItem(1, item(3, 20, 22));
+            furnace.setItem(2, item(4, 6, 23));
+            final FurnaceRecipePlacement.Plan plan = plan(recipe(tags[variant], 2, 1), furnace, inventory, false, 64);
+            assertNotNull(plan);
+            assertTrue(furnace.getItem(0).isEmpty());
+            assertEquals(4, inventory.getItem(0).amount());
+            final var action = assertInstanceOf(ItemStackRequestAction.PlaceAction.class, plan.actions(-3).get(0));
+            assertEquals(1, action.count());
+            assertEquals(21, action.source().stackNetworkId());
+            assertEquals(0, action.destination().stackNetworkId());
+            assertEquals(providers[variant], action.destination().container().name());
+            plan.apply(furnace, inventory);
+            assertEquals(1, furnace.getItem(0).amount());
+            assertEquals(3, inventory.getItem(0).amount());
+            assertEquals(item(3, 20, 22), furnace.getItem(1));
+            assertEquals(item(4, 6, 23), furnace.getItem(2));
+            assertNull(plan(recipe(tags[(variant + 1) % tags.length], 2, 1), furnace, inventory, false, 64));
+        }
+    }
+
+    @Test
+    void bulkPlacementCombinesPartialStacksAndReferencesTheChangedInputByRequestId() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        inventory.setItem(0, item(2, 3, 11));
+        inventory.setItem(9, item(2, 20, 12));
+        inventory.setItem(10, item(2, 60, 13));
+        final var plan = plan(recipe("furnace", 2, 1), furnace, inventory, true, 64);
+        assertNotNull(plan);
+        final var actions = plan.actions(-7);
+        assertEquals(3, actions.size());
+        assertEquals(List.of(3, 20, 41), actions.stream()
+                .map(action -> ((ItemStackRequestAction.PlaceAction) action).count()).toList());
+        assertEquals(0, ((ItemStackRequestAction.PlaceAction) actions.get(0)).destination().stackNetworkId());
+        assertEquals(-7, ((ItemStackRequestAction.PlaceAction) actions.get(1)).destination().stackNetworkId());
+        assertEquals(-7, ((ItemStackRequestAction.PlaceAction) actions.get(2)).destination().stackNetworkId());
+        plan.apply(furnace, inventory);
+        assertEquals(64, furnace.getItem(0).amount());
+        assertTrue(inventory.getItem(0).isEmpty());
+        assertTrue(inventory.getItem(9).isEmpty());
+        assertEquals(19, inventory.getItem(10).amount());
+        assertEquals(13, inventory.getItem(10).netId());
+        assertThrows(IllegalArgumentException.class, () -> plan.actions(3));
+        assertThrows(IllegalArgumentException.class, () -> plan.actions(-4));
+    }
+
+    @Test
+    void existingInputIncrementsByRecipeCountAndBulkHonorsTheStackLimit() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        furnace.setItem(0, item(2, 5, 11));
+        inventory.setItem(0, item(2, 64, 12));
+        final var recipe = recipe("furnace", 2, 2);
+        final var single = plan(recipe, furnace, inventory, false, 16);
+        assertNotNull(single);
+        single.apply(furnace, inventory);
+        assertEquals(6, furnace.getItem(0).amount());
+        assertEquals(63, inventory.getItem(0).amount());
+        final var bulk = plan(recipe, furnace, inventory, true, 16);
+        assertNotNull(bulk);
+        bulk.apply(furnace, inventory);
+        assertEquals(16, furnace.getItem(0).amount());
+        assertEquals(53, inventory.getItem(0).amount());
+        assertFalse(plan(recipe, furnace, inventory, true, 16).hasTransfers());
+    }
+
+    @Test
+    void mismatchedInputCanMergeIntoFullInventoryBeforePlacement() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        for (int slot = 0; slot < inventory.size(); slot++) {
+            inventory.setItem(slot, item(9, 64, 100 + slot));
+        }
+        inventory.setItem(9, item(9, 60, 109));
+        inventory.setItem(0, item(2, 3, 100));
+        furnace.setItem(0, item(9, 4, 17));
+        final var plan = plan(recipe("furnace", 2, 1), furnace, inventory, false, 64);
+        assertNotNull(plan);
+        assertEquals(4, furnace.getItem(0).amount());
+        final var actions = plan.actions(-3);
+        final var clear = (ItemStackRequestAction.PlaceAction) actions.get(0);
+        assertEquals(109, clear.destination().stackNetworkId());
+        assertEquals(4, clear.count());
+        final var fill = (ItemStackRequestAction.PlaceAction) actions.get(1);
+        assertEquals(-3, fill.destination().stackNetworkId());
+        plan.apply(furnace, inventory);
+        assertEquals(64, inventory.getItem(9).amount());
+        assertEquals(2, inventory.getItem(0).amount());
+        assertEquals(item(2, 1, 100), furnace.getItem(0));
+    }
+
+    @Test
+    void failedClearOrMissingIngredientsNeverMutatesEitherInventory() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        for (int slot = 0; slot < inventory.size(); slot++) {
+            inventory.setItem(slot, item(9, 64, 100 + slot));
+        }
+        furnace.setItem(0, item(3, 4, 17));
+        final BedrockItem[] previous = Arrays.stream(inventory.getItems()).map(BedrockItem::copy).toArray(BedrockItem[]::new);
+        assertNull(plan(recipe("furnace", 2, 1), furnace, inventory, false, 64));
+        assertArrayEquals(previous, inventory.getItems());
+        assertEquals(item(3, 4, 17), furnace.getItem(0));
+        inventory.setItem(0, BedrockItem.empty());
+        assertNull(plan(recipe("furnace", 2, 1), furnace, inventory, false, 64));
+        assertTrue(inventory.getItem(0).isEmpty());
+        assertEquals(item(3, 4, 17), furnace.getItem(0));
+    }
+
+    @Test
+    void broadIngredientSelectsUsableVariantAndBulkChoosesTheLargerStack() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        inventory.setItem(0, item(1, 1, 11));
+        inventory.setItem(1, item(2, 64, 12));
+        final var single = plan(recipe("furnace", 0, 2), furnace, inventory, false, 64);
+        assertNotNull(single);
+        single.apply(furnace, inventory);
+        assertEquals(2, furnace.getItem(0).identifier());
+        assertEquals(2, furnace.getItem(0).amount());
+        furnace.setItem(0, BedrockItem.empty());
+        final var bulk = plan(recipe("furnace", 0, 1), furnace, inventory, true, 64);
+        bulk.apply(furnace, inventory);
+        assertEquals(2, furnace.getItem(0).identifier());
+        assertEquals(62, furnace.getItem(0).amount());
+        assertEquals(1, inventory.getItem(0).amount());
+    }
+
+    @Test
+    void variantsWithDifferentDataOrNbtCannotBeCombined() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        inventory.setItem(0, item(2, 1, 11));
+        final BedrockItem different = item(2, 1, 12);
+        different.setData((short) 1);
+        inventory.setItem(1, different);
+        assertNull(plan(recipe("furnace", 2, 2), furnace, inventory, false, 64));
+        different.setData((short) 0);
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("Damage", 1);
+        different.setTag(tag);
+        assertNull(plan(recipe("furnace", 2, 2), furnace, inventory, false, 64));
+        inventory.getItem(0).setTag(tag.copy());
+        final var plan = plan(recipe("furnace", 2, 2), furnace, inventory, false, 64);
+        assertNotNull(plan);
+        plan.apply(furnace, inventory);
+        tag.putInt("Damage", 2);
+        assertEquals(1, furnace.getItem(0).tag().getInt("Damage"));
+    }
+
+    @Test
+    void nonemptyStacksRequireKnownPositiveServerIds() {
+        final UserConnection user = user();
+        final FurnaceContainer furnace = new FurnaceContainer(user, (byte) 5, null, null);
+        final InventoryContainer inventory = inventory(user);
+        for (final Integer id : Arrays.asList(null, 0, -3)) {
+            final BedrockItem unknown = item(2, 8, 11);
+            unknown.setNetId(id);
+            inventory.setItem(0, unknown);
+            assertNull(plan(recipe("furnace", 2, 1), furnace, inventory, false, 64));
+            furnace.setItem(0, unknown);
+            inventory.setItem(0, item(2, 8, 12));
+            assertNull(plan(recipe("furnace", 2, 1), furnace, inventory, false, 64));
+            furnace.setItem(0, BedrockItem.empty());
+        }
+    }
+
+    private static FurnaceRecipePlacement.Plan plan(final CraftingDataStorage recipe,
+            final FurnaceContainer furnace, final InventoryContainer inventory, final boolean max, final int limit) {
+        return FurnaceRecipePlacement.plan(recipe, furnace, inventory, max, item -> limit,
+                (descriptor, item) -> descriptor.matchesItem(null, item));
+    }
+
+    private static CraftingDataStorage recipe(final String tag, final int input, final int amount) {
+        return new CraftingDataStorage(RecipeType.SHAPELESS, 7,
+                new ShapelessRecipe("cooking", UUID.randomUUID(), tag, 0,
