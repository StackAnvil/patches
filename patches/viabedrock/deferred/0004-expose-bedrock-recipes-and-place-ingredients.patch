+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeFurnaceOptionsPacketTest {
+
+    @Test
+    void lateNegotiationSendsRetainedFamiliesAndWithdrawalStopsBothDirections() throws Exception {
+        try (var fixture = new Fixture()) {
+            final var first = new FurnaceOptions(1, 4, true, 2);
+            final var other = new FurnaceOptions(3, 1, false, 1);
+            fixture.preferences.apply(other);
+            fixture.preferences.apply(first);
+            fixture.preferences.sendNativeSnapshot(fixture.user);
+            assertTrue(fixture.sent.isEmpty());
+            fixture.channels("minecraft:register");
+            assertEquals(List.of(first, other), fixture.nativeUpdates());
+            final var capability = fixture.sent.stream().filter(packet -> packet.getPacketType() == ClientboundPackets26_3.CUSTOM_PAYLOAD
+                    && packet.get(Types.STRING, 0).equals("minecraft:register")
+                    && new String(packet.get(Types.REMAINING_BYTES, 0), StandardCharsets.UTF_8).equals(NativeFurnaceOptions.CHANNEL)).count();
+            assertEquals(1, capability);
+            fixture.sent.clear();
+            fixture.channels("minecraft:unregister");
+            assertFalse(fixture.channels.hasChannel(NativeFurnaceOptions.CHANNEL));
+            fixture.preferences.sendNativeSnapshot(fixture.user);
+            fixture.nativeInput(new FurnaceOptions(2, 2, true, 2));
+            assertNull(fixture.preferences.options(2));
+            assertTrue(fixture.nativeUpdates().isEmpty());
+            assertEquals(List.of(first, other), fixture.preferences.snapshot());
+            fixture.channels("minecraft:register");
+            assertEquals(List.of(first, other), fixture.nativeUpdates());
+        }
+    }
+
+    @Test
+    void nativeChangesForwardAllFieldsAndSynchronizeJavaWithoutResettingOtherBooks() throws Exception {
+        try (var fixture = new Fixture()) {
+            fixture.channels.addChannels(List.of(NativeFurnaceOptions.CHANNEL));
+            fixture.preferences.changeJavaBook(0, true, true);
+            fixture.preferences.apply(new FurnaceOptions(3, 1, true, 1));
+            final var change = new FurnaceOptions(2, 3, false, 2);
+            fixture.nativeInput(change);
+            assertEquals(change, fixture.preferences.options(2));
+            final var outbound = fixture.sent.stream().filter(packet -> packet.getPacketType() == ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS).toList();
+            assertEquals(1, outbound.size());
+            assertEquals(change, outbound.getFirst().get(BedrockTypes.FURNACE_OPTIONS, 0));
+            final var javaSettings = fixture.sent.stream().filter(packet -> packet.getPacketType() == ClientboundPackets26_3.RECIPE_BOOK_SETTINGS).findFirst().orElseThrow();
+            final boolean[] settings = new boolean[8];
+            for (int index = 0; index < settings.length; index++) {
+                settings[index] = javaSettings.get(Types.BOOLEAN, index);
+            }
+            assertArrayEquals(new boolean[]{true, true, false, false, true, false, false, true}, settings);
+            assertEquals(List.of(change), fixture.nativeUpdates());
+            fixture.sent.clear();
+            final var unknown = new FurnaceOptions(255, Integer.MIN_VALUE, true, Integer.MAX_VALUE);
+            fixture.nativeInput(unknown);
+            assertEquals(unknown, fixture.preferences.options(255));
+            assertEquals(List.of(unknown), fixture.nativeUpdates());
+            assertEquals(2, fixture.sent.size());
+        }
+    }
+
+    @Test
+    void nativeStateTracksServerAndJavaChangesWithoutLosingOpaqueValuesOrTabChoices() {
+        try (var fixture = new Fixture()) {
+            fixture.channels.addChannels(List.of(NativeFurnaceOptions.CHANNEL));
+            final var initial = new FurnaceOptions(1, 4, true, 2);
+            final var server = new PacketWrapperImpl(ClientboundPackets26_3.RECIPE_BOOK_SETTINGS, null, fixture.user);
+            server.write(BedrockTypes.FURNACE_OPTIONS, initial);
+            server.resetReader();
+            InventoryPackets.handleFurnaceOptions(server);
+            assertEquals(List.of(initial), fixture.nativeUpdates());
+            final var client = new PacketWrapperImpl(ServerboundBedrockPackets.SET_PLAYER_FURNACE_OPTIONS, null, fixture.user);
+            client.write(Types.VAR_INT, 1);
+            client.write(Types.BOOLEAN, false);
+            client.write(Types.BOOLEAN, false);
+            client.resetReader();
+            InventoryPackets.handleJavaRecipeBookSettings(client);
+            final var changed = new FurnaceOptions(1, 4, false, 1);
+            assertEquals(List.of(initial, changed), fixture.nativeUpdates());
+            assertEquals(changed, client.get(BedrockTypes.FURNACE_OPTIONS, 0));
+            final var opaque = new FurnaceOptions(255, -8, true, -4);
+            final var unknown = new PacketWrapperImpl(ClientboundPackets26_3.RECIPE_BOOK_SETTINGS, null, fixture.user);
+            unknown.write(BedrockTypes.FURNACE_OPTIONS, opaque);
+            unknown.resetReader();
+            InventoryPackets.handleFurnaceOptions(unknown);
+            assertTrue(unknown.isCancelled());
+            assertEquals(List.of(initial, changed, opaque), fixture.nativeUpdates());
+        }
+    }
+
+    @Test
+    void configurationAndMalformedEnvelopesNeverMutatePreferencesOrForwardRequests() throws Exception {
+        try (var fixture = new Fixture()) {
+            fixture.channels.addChannels(List.of(NativeFurnaceOptions.CHANNEL));
+            when(fixture.info.getClientState()).thenReturn(State.CONFIGURATION);
+            fixture.preferences.sendNativeSnapshot(fixture.user);
+            fixture.nativeInput(new FurnaceOptions(1, 2, true, 2));
+            assertTrue(fixture.sent.isEmpty());
+            assertTrue(fixture.preferences.snapshot().isEmpty());
+            when(fixture.info.getClientState()).thenReturn(State.PLAY);
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.STRING.write(buffer, NativeFurnaceOptions.CHANNEL);
+                NativeFurnaceOptions.TYPE.write(buffer, new FurnaceOptions(1, 2, true, 2));
+                buffer.writeByte(0);
+                final var packet = new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, buffer, fixture.user);
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+                assertTrue(packet.isCancelled());
+                assertTrue(fixture.sent.isEmpty());
+                assertTrue(fixture.preferences.snapshot().isEmpty());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final UserConnection user = mock(UserConnection.class);
+        private final ProtocolInfo info = mock(ProtocolInfo.class);
+        private final ChannelStorage channels = new ChannelStorage();
+        private final FurnaceOptionsStorage preferences = new FurnaceOptionsStorage();
+        private final List<PacketWrapper> sent = new ArrayList<>();
+        private final MockedStatic<PacketWrapper> factory = mockStatic(PacketWrapper.class);
+
+        private Fixture() {
+            when(this.user.getProtocolInfo()).thenReturn(this.info);
+            when(this.info.getClientState()).thenReturn(State.PLAY);
+            when(this.user.get(ChannelStorage.class)).thenReturn(this.channels);
+            when(this.user.get(FurnaceOptionsStorage.class)).thenReturn(this.preferences);
+            when(this.user.has(FurnaceOptionsStorage.class)).thenReturn(true);
+            when(this.user.get(NativeSkinStorage.class)).thenReturn(mock(NativeSkinStorage.class));
+            when(this.user.get(PlayerInputStorage.class)).thenReturn(mock(PlayerInputStorage.class));
+            when(this.user.get(HudVisibilityStorage.class)).thenReturn(mock(HudVisibilityStorage.class));
+            when(this.user.get(CameraEffectsStorage.class)).thenReturn(mock(CameraEffectsStorage.class));
+            this.factory.when(() -> PacketWrapper.create(any(PacketType.class), eq(this.user))).thenAnswer(call -> {
+                final var packet = spy(new PacketWrapperImpl(call.getArgument(0, PacketType.class), null, this.user));
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).send(BedrockProtocol.class);
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).sendToServer(BedrockProtocol.class);
+                return packet;
+            });
+        }
+
+        private List<FurnaceOptions> nativeUpdates() {
+            return this.sent.stream().filter(packet -> packet.getPacketType() == ClientboundPackets26_3.CUSTOM_PAYLOAD
+                    && packet.get(Types.STRING, 0).equals(NativeFurnaceOptions.CHANNEL))
+                    .map(packet -> packet.get(NativeFurnaceOptions.TYPE, 0)).toList();
+        }
+
+        private void nativeInput(final FurnaceOptions value) throws Exception {
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.STRING.write(buffer, NativeFurnaceOptions.CHANNEL);
+                NativeFurnaceOptions.TYPE.write(buffer, value);
+                final var packet = new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, buffer, this.user);
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+                assertTrue(packet.isCancelled());
+            } finally {
+                buffer.release();
+            }
+        }
+
+        private void channels(final String operation) throws Exception {
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.STRING.write(buffer, operation);
+                buffer.writeBytes(NativeFurnaceOptions.CHANNEL.getBytes(StandardCharsets.UTF_8));
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, buffer, this.user));
+            } finally {
+                buffer.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.factory.close();
+        }
+    }
