+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeFurnaceOptionsTest {
+
+    @Test
+    void envelopePreservesTheEntireNativeNumericDomainAndRejectsUnsupportedOrTruncatedData() {
+        for (final var value : new FurnaceOptions[]{new FurnaceOptions(0, 0, false, 0), new FurnaceOptions(1, 4, true, 2),
+            new FurnaceOptions(255, Integer.MIN_VALUE, true, Integer.MAX_VALUE)}) {
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeFurnaceOptions.TYPE.write(buffer, value);
+                final byte[] bytes = new byte[buffer.readableBytes()];
+                buffer.getBytes(0, bytes);
+                assertEquals(value, NativeFurnaceOptions.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+                for (int size = 0; size < bytes.length; size++) {
+                    final var truncated = Unpooled.wrappedBuffer(bytes, 0, size);
+                    try {
+                        assertThrows(RuntimeException.class, () -> NativeFurnaceOptions.TYPE.read(truncated));
+                    } finally {
+                        truncated.release();
+                    }
+                }
+                buffer.clear();
+                NativeFurnaceOptions.TYPE.write(buffer, value);
+                buffer.writeByte(0);
+                assertThrows(IllegalArgumentException.class, () -> NativeFurnaceOptions.TYPE.read(buffer));
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 2);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                assertThrows(IllegalArgumentException.class, () -> NativeFurnaceOptions.TYPE.read(buffer));
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+                assertThrows(IllegalArgumentException.class, () -> NativeFurnaceOptions.TYPE.read(buffer));
+                buffer.clear().writeZero(33);
+                assertThrows(IllegalArgumentException.class, () -> NativeFurnaceOptions.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+}
