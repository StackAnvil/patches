+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+
+import java.util.Arrays;
+
+/** One server-authoritative craft request whose output fits in one inventory or cursor slot. */
+public record CraftingOutputPlan(int destination, int crafts, int outputAmount,
+                                 int destinationNetId) {
+
+    public static CraftingOutputPlan plan(final InventoryContainer inventory,
+            final BedrockItem result, final Container grid, final int firstGridSlot,
+            final int[] amountsPerCraft, final int maxStackSize) {
+        if (result.isEmpty() || amountsPerCraft.length == 0 || maxStackSize < result.amount()) {
+            return null;
+        }
+        int maxCrafts = 255;
+        boolean hasIngredient = false;
+        for (int index = 0; index < amountsPerCraft.length; index++) {
+            final int required = amountsPerCraft[index];
+            if (required <= 0) {
+                continue;
+            }
+            hasIngredient = true;
+            final BedrockItem ingredient = grid.getItem(firstGridSlot + index);
+            if (ingredient.isEmpty() || ingredient.netId() == null) {
+                return null;
+            }
+            maxCrafts = Math.min(maxCrafts, ingredient.amount() / required);
+        }
+        if (!hasIngredient || maxCrafts == 0) {
+            return null;
+        }
+
+        for (int pass = 0; pass < 2; pass++) {
+            for (int slot = 9; slot < inventory.size() + 9; slot++) {
+                final int destination = slot % inventory.size();
+                final BedrockItem existing = inventory.getItem(destination);
+                final int networkId;
+                final int freeSpace;
+                if (pass == 0) {
+                    if (existing.isEmpty() || !canStack(existing, result)
+                            || existing.netId() == null) {
+                        continue;
+                    }
+                    networkId = existing.netId();
+                    freeSpace = Math.min(255, maxStackSize - existing.amount());
+                } else {
+                    if (!existing.isEmpty()) {
+                        continue;
+                    }
+                    networkId = 0;
+                    freeSpace = Math.min(255, maxStackSize);
+                }
+                final int crafts = Math.min(maxCrafts, freeSpace / result.amount());
+                if (crafts > 0) {
+                    return new CraftingOutputPlan(destination, crafts,
+                            crafts * result.amount(), networkId);
+                }
+            }
+        }
+        return null;
+    }
+
+    public static CraftingOutputPlan pickup(final Container hud, final BedrockItem result,
+            final int maxStackSize) {
+        final BedrockItem cursor = hud.getItem(0);
+        if (result.isEmpty() || result.amount() > Math.min(255, maxStackSize) - cursor.amount()) {
+            return null;
+        }
+        if (!cursor.isEmpty() && (!canStack(cursor, result) || cursor.netId() == null)) {
+            return null;
+        }
+        return new CraftingOutputPlan(0, 1, result.amount(), cursor.isEmpty() ? 0 : cursor.netId());
+    }
+
+    private static boolean canStack(final BedrockItem existing, final BedrockItem result) {
+        return !existing.isDifferent(result)
+                && Arrays.equals(existing.canPlace(), result.canPlace())
+                && Arrays.equals(existing.canBreak(), result.canBreak())
+                && existing.blockingTicks() == result.blockingTicks();
+    }
+
+    public void apply(final Container inventory, final BedrockItem result) {
+        final BedrockItem existing = inventory.getItem(this.destination);
+        final BedrockItem updated = existing.isEmpty() ? result.copy() : existing.copy();
+        updated.setAmount(existing.amount() + this.outputAmount);
+        inventory.setItem(this.destination, updated);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/CraftingPlacement.java b/src/main/java/net/raphimc/viabedrock/api/model/container/CraftingPlacement.java
new file mode 100644
