+/** Publishes one exact menu's authoritative cooking state; progress does not replace item authority. */
+public final class NativeCookingUiState extends StoredObject {
+
+    private long sequence;
+    private InventoryTracker inventoryOwner;
+    private FurnaceContainer container;
+    private long generation;
+    private ContainerUi.Title title;
+    private CookingRecipeCatalog catalog;
+    private CookingUi ui;
+    private FurnaceOptions options;
+    private NativeCookingMessage message;
+    private BedrockItem[] stationItems;
+    private BedrockItem[] playerItems;
+    private BedrockItem[] cursorItems;
+    private long dataRevision;
+    private boolean publishing;
+    private boolean handlingAction;
+    private NativeCookingAction gesture;
+    private NativeCookingAction focus;
+    private Set<String> gestureCommands = Set.of();
+    private long lastRequestSequence;
+    private CookingUi.Selection selection = new CookingUi.Selection("", -1);
+    private CookingUi.Selection publishedSelection;
+    private boolean actionsAdvertised;
+
+    public NativeCookingUiState(final UserConnection user) {
+        super(user);
+    }
+
+    public static boolean enabled(final UserConnection user) {
+        final var channels = user.get(ChannelStorage.class);
+        return channels != null && channels.hasChannel(NativeCookingMessage.CHANNEL) && channels.hasChannel(NativeCookingProgress.CHANNEL)
+                && user.getProtocolInfo().getClientState() == State.PLAY
+                && user.get(GameSessionStorage.class).isInventoryServerAuthoritative();
+    }
+
+    /** The client receives results; the core receives actions on a separate channel. */
+    public static boolean actionsEnabled(final UserConnection user) {
+        return enabled(user) && user.get(ChannelStorage.class).hasChannel(NativeCookingActionResult.CHANNEL);
+    }
+
+    public void refreshActionCapability() {
+        if (this.user().getProtocolInfo().getClientState() != State.PLAY) {
+            this.actionsAdvertised = false;
+            this.clearActions();
+            return;
+        }
+        final boolean available = actionsEnabled(this.user());
+        if (!available) {
+            this.clearActions();
+        }
+        if (available == this.actionsAdvertised) {
+            return;
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, available ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, NativeCookingAction.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+        this.actionsAdvertised = available;
+    }
+
+    private void clearActions() {
+        this.gesture = null;
+        this.focus = null;
+        this.gestureCommands = Set.of();
+        this.selection = new CookingUi.Selection("", -1);
+    }
+
+    public static void sendOpening(final UserConnection user, final ContainerUi.Title title) {
+        final var state = user.get(NativeCookingUiState.class);
+        if (state == null) {
+            return;
+        }
+        state.refreshActionCapability();
+        if (enabled(user)) {
+            state.publish(() -> state.begin(title));
+        }
+    }
+
+    public static void sendUpdate(final UserConnection user) {
+        final var state = user.get(NativeCookingUiState.class);
+        if (state == null || state.container == null) {
+            return;
+        }
+        if (enabled(user)) {
+            state.publish(state::update);
+        } else {
+            state.refreshActionCapability();
+            state.clear();
+        }
+    }
+
+    /** Flush the genuine Java update before publishing the state derived from it. */
+    public static void after(final PacketWrapper wrapper) {
+        final var state = wrapper.user().get(NativeCookingUiState.class);
+        if (state == null || state.container == null) {
+            return;
+        }
+        if (!wrapper.isCancelled()) {
+            wrapper.send(BedrockProtocol.class);
+            wrapper.cancel();
+        }
+        sendUpdate(wrapper.user());
+    }
+
+    private void publish(final Supplier<Publication> update) {
+        if (this.publishing || this.handlingAction) {
+            return;
+        }
+        this.publishing = true;
+        try {
+            final var publication = update.get();
+            if (publication == null) {
+                return;
+            }
+            final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+            if (publication.message != null) {
+                packet.write(Types.STRING, NativeCookingMessage.CHANNEL);
+                packet.write(NativeCookingMessage.TYPE, publication.message);
+            } else {
+                packet.write(Types.STRING, NativeCookingProgress.CHANNEL);
+                packet.write(NativeCookingProgress.TYPE, publication.progress);
+            }
+            packet.send(BedrockProtocol.class);
+        } catch (final RuntimeException unsupported) {
+            this.clear();
+            ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Unable to publish native cooking presentation", unsupported);
+        } finally {
+            this.publishing = false;
+        }
+    }
+
+    /** Begin only for the currently opened menu, then wait for its first authoritative contents. */
+    public Publication begin(final ContainerUi.Title title) {
+        this.clear();
+        final var inventory = this.user().get(InventoryTracker.class);
+        if (!(inventory.getCurrentContainer() instanceof FurnaceContainer cooking)
+                || inventory.getPendingCloseContainer() != null || this.sequence == Long.MAX_VALUE) {
+            return null;
+        }
+        this.sequence++;
+        this.inventoryOwner = inventory;
+        this.container = cooking;
+        this.generation = inventory.currentContainerGeneration();
+        this.title = Objects.requireNonNull(title);
+        return this.update();
+    }
+
+    public Publication update() {
+        if (!this.ownsMenu()) {
+            this.clear();
+            return null;
+        }
+        if (this.container.serverRevision() == 0) {
+            return null;
+        }
+        if (this.message == null || !this.currentAuthority()) {
+            if (this.message != null && this.message.updateSequence() == Long.MAX_VALUE) {
+                this.clear();
+                return null;
+            }
+            return new Publication(this.snapshot(), null);
+        }
+        if (this.dataRevision != this.container.serverDataRevision()) {
+            this.dataRevision = this.container.serverDataRevision();
+            return new Publication(null, new NativeCookingProgress(this.message.menuId(), this.message.sequence(),
+                    this.message.updateSequence(), this.dataRevision, CookingUi.Progress.fromProperties(this.container.getData())));
+        }
+        return null;
+    }
+
+    public boolean current(final NativeCookingControl control) {
+        return this.message != null && this.currentAuthority()
+                && NativeCookingControl.forMessage(this.message, control.mode()).equals(control);
+    }
+
+    public boolean current(final NativeCookingAction action) {
+        return this.current(new NativeCookingControl(action.menuId(), action.sequence(), action.updateSequence(),
+                action.menuRevision(), action.inventoryRevision(), action.cursorRevision(), NativeCookingControl.Mode.ACTIVATE));
+    }
+
+    /** Admit one exact authored cell. Follow-up phases retire the original gesture without transferring again. */
+    public boolean handleAction(final NativeCookingAction action) {
+        if (this.handlingAction || this.publishing) {
+            return false;
+        }
+        this.handlingAction = true;
+        try {
+            return this.applyAction(action);
+        } finally {
+            this.handlingAction = false;
+        }
+    }
+
+    private boolean applyAction(final NativeCookingAction action) {
+        if (!this.user().get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                || !this.ownsMenu() || action.requestSequence() <= this.lastRequestSequence) {
+            return false;
+        }
+        if (action.eventPhase() == 2 && this.focus != null && action.mode() == NativeCookingAction.Mode.PRIMARY) {
+            if (!sameGesture(this.focus, action)) {
+                return false;
+            }
+            this.focus = null;
+            this.lastRequestSequence = action.requestSequence();
+            return true;
+        }
+        if (action.eventPhase() != 0 && this.gesture != null && sameGesture(this.gesture, action)
+                && this.gestureCommands.contains(action.mode().button())) {
+            this.lastRequestSequence = action.requestSequence();
+            if (action.eventPhase() == 2 && action.mode() != NativeCookingAction.Mode.TERTIARY) {
+                this.gesture = null;
+                this.gestureCommands = Set.of();
+                this.selection = new CookingUi.Selection("", -1);
+            }
+            return true;
+        }
+        if (!this.current(action)) {
+            return false;
+        }
+        final var view = this.message.view();
+        final var scope = CookingUi.actionScope(this.ui.resolve(view), view.book());
+        if (!scope.actions().getOrDefault(action.recipeId(), Set.of()).contains(action.mode().button())) {
+            return false;
+        }
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        if (!requests.canStartRecipePlacement() || requests.isPredictingClick()) {
+            return false;
+        }
+        if (action.mode() != NativeCookingAction.Mode.PRIMARY || action.eventPhase() != 0) {
+            // The mode-two focus entry precedes selection and does not transfer the carried Item.
+            if (this.gesture == null && this.focus == null && action.mode() == NativeCookingAction.Mode.PRIMARY
+                    && action.controllerInputMode() == 2 && action.eventPhase() == 1) {
+                this.focus = action;
+            }
+            this.lastRequestSequence = action.requestSequence();
+            return true;
+        }
+        if (this.focus == null && !this.user().get(InventoryTracker.class).getHudContainer().getItem(0).isEmpty()) {
+            return false;
+        }
+        final var expectedContainer = this.container;
+        final long expectedGeneration = this.generation;
+        final long expectedSequence = this.sequence;
+        if (this.gesture != null || !this.container.handleNativeRecipeSelection(this.catalog, this.catalog.recipe(action.recipeId()), this.focus != null)) {
+            return false;
+        }
+        if (!this.ownsMenu() || this.container != expectedContainer || this.generation != expectedGeneration
+                || this.sequence != expectedSequence) {
+            return false;
+        }
+        final List<CookingUi.Recipe> visible = view.book().recipes().stream()
+                .filter(recipe -> view.book().visibleRecipes().contains(recipe.id())).toList();
+        for (int index = 0; index < visible.size(); index++) {
+            if (visible.get(index).id() == action.recipeId()) {
+                this.selection = new CookingUi.Selection("recipe_book", index);
+                break;
+            }
+        }
+        this.focus = null;
+        this.gesture = action;
+        this.gestureCommands = scope.actions().get(action.recipeId());
+        this.lastRequestSequence = action.requestSequence();
+        return true;
+    }
+
+    private static boolean sameGesture(final NativeCookingAction original, final NativeCookingAction action) {
+        return original.menuId() == action.menuId() && original.sequence() == action.sequence()
+                && original.updateSequence() == action.updateSequence() && original.menuRevision() == action.menuRevision()
+                && original.inventoryRevision() == action.inventoryRevision() && original.cursorRevision() == action.cursorRevision()
+                && original.recipeId() == action.recipeId() && original.controllerInputMode() == action.controllerInputMode();
+    }
+
+    private boolean ownsMenu() {
+        final var inventory = this.user().get(InventoryTracker.class);
+        return this.container != null && inventory == this.inventoryOwner && inventory.getCurrentContainer() == this.container
+                && inventory.currentContainerGeneration() == this.generation && inventory.getPendingCloseContainer() == null;
+    }
+
+    private boolean currentAuthority() {
+        if (!this.ownsMenu() || this.catalog == null || !this.catalog.current(this.user().get(CraftingDataTracker.class))) {
+            return false;
+        }
+        final var inventory = this.user().get(InventoryTracker.class);
+        return this.container.serverRevision() == this.message.menuRevision()
+                && inventory.getInventoryContainer().serverRevision() == this.message.inventoryRevision()
+                && inventory.getHudContainer().serverRevision() == this.message.cursorRevision()
+                && Arrays.equals(this.stationItems, this.container.getItems())
+                && Arrays.equals(this.playerItems, inventory.getInventoryContainer().getItems())
+                && Arrays.equals(this.cursorItems, inventory.getHudContainer().getItems())
+                && Objects.equals(this.publishedSelection, this.selection)
+                && Objects.equals(this.options, this.preferences())
+                && this.ui == this.user().get(ResourcePackStorage.class).getCookingUi();
+    }
+
+    private NativeCookingMessage snapshot() {
+        final var expectedContainer = this.container;
+        final long expectedGeneration = this.generation;
+        final long expectedSequence = this.sequence;
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var items = this.user().get(ItemRewriter.class);
+        final var catalog = this.container.recipeCatalog();
+        final var ui = this.user().get(ResourcePackStorage.class).getCookingUi();
+        final var options = this.preferences();
+        final var selectionBefore = this.selection;
+        final var gesture = this.gesture;
+        final BedrockItem[] stationItems = copy(this.container.getItems());
+        final BedrockItem[] playerItems = copy(inventory.getInventoryContainer().getItems());
+        final BedrockItem[] cursorItems = copy(inventory.getHudContainer().getItems());
+        final long menuRevision = this.container.serverRevision();
+        final long inventoryRevision = inventory.getInventoryContainer().serverRevision();
+        final long cursorRevision = inventory.getHudContainer().serverRevision();
+        final boolean filtering = options != null && options.filtering();
+        final List<CookingUi.Recipe> recipes = new ArrayList<>();
+        final Map<Integer, Item> previews = new HashMap<>();
+        final Map<Integer, ItemCookingProperties.Category> categories = new HashMap<>();
+        for (final var entry : catalog.entries()) {
+            final var recipe = entry.data().recipe();
+            final BedrockItem output = ((ShapelessRecipe) recipe).getResults().getFirst();
+            final String identifier = items.getItemRegistry().definition(output.identifier()).identifier();
+            final int evaluation = this.container.recipeAvailability(catalog, entry.data(), filtering, true);
+            recipes.add(new CookingUi.Recipe(entry.id(), recipe.getUniqueId(), recipe.getPriority(), entry.unlocked(),
+                    identifier.substring(identifier.indexOf(':') + 1), evaluation,
+                    Map.of("#container_item_background", new JsonPrimitive(evaluation))));
+            previews.put(entry.id(), items.javaItem(output.copy()));
+            categories.put(entry.id(), items.cookingProperties(output).category());
+        }
+        final var ordered = CookingRecipeOrder.bookOrder(recipes, CookingUi.Recipe::uniqueId, CookingUi.Recipe::unlocked,
+                CookingUi.Recipe::outputName, CookingUi.Recipe::priority);
+        final int food = count(ordered, categories, ItemCookingProperties.Category.FOOD);
+        final int ordinary = count(ordered, categories, ItemCookingProperties.Category.ITEMS);
+        final int blocks = count(ordered, categories, ItemCookingProperties.Category.BLOCKS);
+        final CookingUi.Family family = this.family();
+        int tab = options == null ? 0 : options.leftTab();
+        if (tab == 0) {
+            tab = family == CookingUi.Family.FURNACE ? CookingNavigation.tabs(false, food, ordinary, blocks).getFirst() : 4;
+        }
+        final Set<Integer> visible = new HashSet<>();
+        for (final var recipe : ordered) {
+            if (tab == 4 || tab >= 1 && tab <= 3 && categoryTab(categories.get(recipe.id())) == tab) {
+                visible.add(recipe.id());
+            }
+        }
+        final List<CookingUi.Recipe> displayed = CookingRecipeOrder.visibleOrder(ordered, CookingUi.Recipe::evaluation, filtering)
+                .stream().filter(recipe -> visible.contains(recipe.id())).toList();
+        CookingUi.Selection selection = new CookingUi.Selection("", -1);
+        if (gesture != null) {
+            for (int index = 0; index < displayed.size(); index++) {
+                if (displayed.get(index).id() == gesture.recipeId()) {
+                    selection = new CookingUi.Selection("recipe_book", index);
+                    break;
+                }
+            }
+        }
+        final var book = new CookingUi.Book(options == null ? 2 : options.layout(), false, tab, filtering,
+                food, ordinary, blocks, CookingNavigation.tabLabel(tab, family, filtering), "", selection, recipes, visible);
+        final List<ContainerUi.Slot> slots = new ArrayList<>(39);
+        for (int slot = 0; slot < 3; slot++) {
+            slots.add(new ContainerUi.Slot(slot, count(stationItems[slot], false)));
+        }
+        for (int slot = 0; slot < 36; slot++) {
+            slots.add(new ContainerUi.Slot(slot + 3, count(playerItems[slot < 27 ? slot + 9 : slot - 27], false)));
+        }
+        final var view = new CookingUi.MenuView(Byte.toUnsignedInt(this.container.javaContainerId()), family, this.title, slots,
+                count(cursorItems[0], true), CookingUi.Progress.fromProperties(this.container.getData()), book);
+        final var next = NativeCookingMessage.create(ui, view, expectedSequence,
+                this.message == null ? 1 : this.message.updateSequence() + 1, menuRevision, inventoryRevision, cursorRevision, previews);
+        if (this.container != expectedContainer || this.generation != expectedGeneration || this.sequence != expectedSequence
+                || !this.ownsMenu() || !catalog.current(this.user().get(CraftingDataTracker.class))
+                || menuRevision != this.container.serverRevision() || inventoryRevision != inventory.getInventoryContainer().serverRevision()
+                || cursorRevision != inventory.getHudContainer().serverRevision()
+                || !Arrays.equals(stationItems, this.container.getItems()) || !Arrays.equals(playerItems, inventory.getInventoryContainer().getItems())
+                || !Arrays.equals(cursorItems, inventory.getHudContainer().getItems()) || !Objects.equals(options, this.preferences())
+                || gesture != this.gesture || !selectionBefore.equals(this.selection)
+                || ui != this.user().get(ResourcePackStorage.class).getCookingUi()) {
+            throw new IllegalStateException("Cooking authority changed during item conversion");
+        }
+        this.stationItems = stationItems;
+        this.catalog = catalog;
+        this.ui = ui;
+        this.options = options;
+        this.selection = selection;
+        this.publishedSelection = selection;
+        this.playerItems = playerItems;
+        this.cursorItems = cursorItems;
+        this.dataRevision = this.container.serverDataRevision();
+        this.message = next;
+        return next;
+    }
+
+    private FurnaceOptions preferences() {
+        return this.user().get(FurnaceOptionsStorage.class).options(switch (this.family()) {
+            case FURNACE -> 1;
+            case BLAST_FURNACE -> 2;
+            case SMOKER -> 3;
+        });
+    }
+
+    private CookingUi.Family family() {
+        return switch (this.container.type()) {
+            case FURNACE -> CookingUi.Family.FURNACE;
+            case BLAST_FURNACE -> CookingUi.Family.BLAST_FURNACE;
+            case SMOKER -> CookingUi.Family.SMOKER;
+            default -> throw new IllegalStateException("Not a cooking menu");
+        };
+    }
+
+    private static BedrockItem[] copy(final BedrockItem[] items) {
+        return Arrays.stream(items).map(BedrockItem::copy).toArray(BedrockItem[]::new);
+    }
+
+    private static int categoryTab(final ItemCookingProperties.Category category) {
+        return switch (category) {
+            case FOOD -> 1;
+            case ITEMS -> 2;
+            case BLOCKS -> 3;
+        };
+    }
+
+    private static int count(final List<CookingUi.Recipe> recipes, final Map<Integer, ItemCookingProperties.Category> categories,
+                             final ItemCookingProperties.Category category) {
+        return (int) recipes.stream().filter(recipe -> categories.get(recipe.id()) == category).count();
+    }
+
+    private static Map<String, JsonElement> count(final BedrockItem item, final boolean cursor) {
+        return Map.of(cursor ? "#inventory_selected_item_stack_count" : "#inventory_stack_count", new JsonPrimitive(item.amount()));
+    }
+
+    public void clear() {
+        this.inventoryOwner = null;
+        this.container = null;
+        this.title = null;
+        this.catalog = null;
+        this.ui = null;
+        this.options = null;
+        this.message = null;
+        this.stationItems = null;
+        this.playerItems = null;
+        this.cursorItems = null;
+        this.clearActions();
+        this.lastRequestSequence = 0;
+        this.publishedSelection = null;
+    }
+
+    public record Publication(NativeCookingMessage message, NativeCookingProgress progress) {
+
+        public Publication {
+            if ((message == null) == (progress == null)) {
+                throw new IllegalArgumentException("Cooking publication requires exactly one update");
+            }
+        }
+    }
+
+}
