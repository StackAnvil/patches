+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemEntry;
+import net.raphimc.viabedrock.protocol.model.ItemRegistry;
+import net.raphimc.viabedrock.protocol.model.ItemCookingProperties;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class CookingRecipeInputsTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_INPUTS", matches = ".+")
+    void expandedNamedInputsMatchTheCompleteNativeExtractor() throws Exception {
+        final var rows = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_INPUTS")))).getAsJsonObject().getAsJsonArray("rows");
+        final Map<Integer, ItemEntry> entries = new LinkedHashMap<>();
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final int id = row.get("identifier").getAsInt();
+            entries.put(id, new ItemEntry(row.get("name").getAsString(), id, false, ItemVersion.Legacy, null));
+        }
+        final var user = user(new ItemRegistry(entries.values().toArray(ItemEntry[]::new)));
+        int compared = 0;
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            if (row.get("kind").getAsString().equals("concrete")) {
+                continue;
+            }
+            final boolean unknown = row.get("kind").getAsString().equals("unknown");
+            final String name = unknown ? "not:registered" : row.get("name").getAsString();
+            final var inputs = CookingRecipeInputs.expand(user,
+                    new ItemDescriptor.ItemNameDescriptor(name, row.get("metadata").getAsInt()));
+            final var expected = row.getAsJsonArray("expanded");
+            assertEquals(expected.size(), inputs.size(), row::toString);
+            for (int index = 0; index < inputs.size(); index++) {
+                final var input = inputs.get(index);
+                final var nativeInput = expected.get(index).getAsJsonObject();
+                assertEquals(nativeInput.get("identifier").getAsInt(), input.identifier(), row::toString);
+                assertEquals(nativeInput.get("metadata").getAsInt(), input.data(), row::toString);
+                assertEquals(nativeInput.get("count").getAsInt(), input.amount(), row::toString);
+                assertEquals(nativeInput.get("hasBlock").getAsBoolean(), input.hasBlockState(), row::toString);
+            }
+            compared++;
+        }
+        assertTrue(compared > 0);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_INPUTS", matches = ".+")
+    void associatedDefaultConstructionMatchesNativeOwnershipAndAdmission() throws Exception {
+        final var rows = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_INPUTS")))).getAsJsonObject().getAsJsonArray("associatedRows");
+        assertFalse(rows.isEmpty());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            if (!row.get("kind").getAsString().equals("named")) {
+                continue;
+            }
+            final String name = row.get("name").getAsString();
+            final int id = row.get("identifier").getAsInt();
+            final int owner = row.get("owner").getAsInt();
+            final var registry = new ItemRegistry(new ItemEntry[]{
+                new ItemEntry(name, id, false, ItemVersion.Legacy, null),
+                new ItemEntry("test:owner", 2, false, ItemVersion.Legacy, null)});
+            final var user = user(registry, Map.of(name, new ItemCookingProperties(false, name, false)));
+            final var blocks = user.get(BlockStateRewriter.class);
+            final var state = blockState(name, "y");
+            when(blocks.blockItemState(eq(name), anyShort())).thenAnswer(call ->
+                    (short) call.getArgument(1) == 4 ? null : state);
+            when(blocks.registeredRuntimeId(state)).thenReturn(0);
+            when(blocks.blockItemNumericId(0)).thenReturn(owner);
+            final var inputs = CookingRecipeInputs.expand(user,
+                    new ItemDescriptor.ItemNameDescriptor(name, row.get("metadata").getAsInt()));
+            assertEquals(row.getAsJsonArray("expanded").size(), inputs.size(), row::toString);
+            if (!inputs.isEmpty()) {
+                final var expected = row.getAsJsonArray("expanded").get(0).getAsJsonObject();
+                assertEquals(expected.get("identifier").getAsInt(), inputs.getFirst().identifier(), row::toString);
+                assertEquals(expected.get("metadata").getAsInt(), inputs.getFirst().data(), row::toString);
+                assertEquals(expected.get("count").getAsInt(), inputs.getFirst().amount(), row::toString);
+                assertEquals(expected.get("hasBlock").getAsBoolean(), inputs.getFirst().hasBlockState(), row::toString);
+                assertEquals(0, inputs.getFirst().blockRuntimeId());
+            }
+        }
+    }
+
+    @Test
+    void declaredBlockVariantAdmitsTheDescriptorButTheExpandedQueryUsesItsDefaultBlock() throws Exception {
+        final String name = "test:pillar";
+        final int id = -819;
+        final var user = user(new ItemRegistry(new ItemEntry[]{new ItemEntry(name, id, false, ItemVersion.Legacy, null)}),
+                Map.of(name, new ItemCookingProperties(false, name, false)));
+        final var blocks = user.get(BlockStateRewriter.class);
+        final var defaultBlock = blockState(name, "y");
+        final var variantBlock = blockState(name, "x");
+        when(blocks.blockItemState(eq(name), anyShort())).thenAnswer(call ->
+                (short) call.getArgument(1) == 3 ? variantBlock : defaultBlock);
+        when(blocks.registeredRuntimeId(defaultBlock)).thenReturn(0);
+        when(blocks.blockItemNumericId(0)).thenReturn(id & 0xFFFF);
+        when(blocks.blockItemRecipeDescriptor(0)).thenReturn(new BlockItemDescriptor(1074, (short) 0));
+        when(blocks.blockItemRecipeDescriptor(1)).thenReturn(new BlockItemDescriptor(1074, (short) 3));
+        final var query = CookingRecipeInputs.expand(user, new ItemDescriptor.ItemNameDescriptor(name, 3)).getFirst();
+        assertTrue(query.hasBlockState());
+        assertEquals(0, query.blockRuntimeId());
+        final var candidate = new BedrockItem(id, (short) 0, (byte) 1);
+        candidate.setBlockRuntimeId(0);
+        assertTrue(user.get(ItemRewriter.class).matchesRecipeStack(query, candidate));
+        candidate.setBlockRuntimeId(1);
+        assertFalse(user.get(ItemRewriter.class).matchesRecipeStack(query, candidate));
+    }
+
+    @Test
+    void concreteDefaultQueriesIgnoreDeclaredMetadataAndKeepSourceWildcards() throws Exception {
+        final var user = user(new ItemRegistry(new ItemEntry[]{new ItemEntry("test:input", 321, false, ItemVersion.Legacy, null)}));
+        final var items = user.get(ItemRewriter.class);
+        final var inputs = CookingRecipeInputs.expand(user, new ItemDescriptor.ItemNameDescriptor("test:input", 3, 255));
+        assertEquals(1, inputs.size());
+        final var query = inputs.getFirst();
+        assertEquals(0, query.data());
+        assertEquals(1, query.amount());
+        assertTrue(items.matchesRecipeStack(query, new BedrockItem(321, (short) 0, (byte) 1)));
+        assertFalse(items.matchesRecipeStack(query, new BedrockItem(321, (short) 3, (byte) 1)));
+        assertTrue(items.matchesRecipeStack(query, new BedrockItem(321, Short.MAX_VALUE, (byte) 1)));
+        assertFalse(items.matchesRecipeStack(query, BedrockItem.empty()));
+        assertFalse(items.matchesRecipeStack(BedrockItem.empty(), query));
+        assertTrue(CookingRecipeInputs.expand(user, new ItemDescriptor.InvalidDescriptor()).isEmpty());
+        assertThrows(UnsupportedOperationException.class, inputs::clear);
+    }
+
+    private static UserConnection user(final ItemRegistry registry) throws Exception {
+        return user(registry, Map.of());
+    }
+
+    private static UserConnection user(final ItemRegistry registry, final Map<String, ItemCookingProperties> properties) throws Exception {
+        final var user = mock(UserConnection.class);
+        final var items = mock(ItemRewriter.class, CALLS_REAL_METHODS);
+        final var blocks = mock(BlockStateRewriter.class);
+        for (final var fieldValue : Map.of("registry", registry, "items", registry.ids(), "cookingProperties", properties).entrySet()) {
+            final var field = ItemRewriter.class.getDeclaredField(fieldValue.getKey());
+            field.setAccessible(true);
+            field.set(items, fieldValue.getValue());
+        }
+        doReturn(user).when(items).user();
+        when(user.get(ItemRewriter.class)).thenReturn(items);
+        when(user.get(BlockStateRewriter.class)).thenReturn(blocks);
+        return user;
+    }
+
+    private static BedrockBlockState blockState(final String name, final String axis) {
+        final var tag = new CompoundTag();
+        tag.putString("name", name);
+        final var states = new CompoundTag();
+        states.putString("pillar_axis", axis);
+        tag.put("states", states);
+        return BedrockBlockState.fromNbt(tag);
+    }
+
+}
