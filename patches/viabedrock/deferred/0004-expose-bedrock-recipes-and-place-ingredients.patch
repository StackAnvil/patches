+package net.raphimc.viabedrock.protocol.types.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Protocol 2193: byte family, signed VarInt tab, boolean filter, signed VarInt layout. */
+public final class FurnaceOptionsType extends Type<FurnaceOptions> {
+
+    public FurnaceOptionsType() {
+        super(FurnaceOptions.class);
+    }
+
+    @Override
+    public FurnaceOptions read(final ByteBuf buffer) {
+        return new FurnaceOptions(buffer.readUnsignedByte(), BedrockTypes.VAR_INT.readPrimitive(buffer),
+                buffer.readBoolean(), BedrockTypes.VAR_INT.readPrimitive(buffer));
+    }
+
+    @Override
+    public void write(final ByteBuf buffer, final FurnaceOptions value) {
+        buffer.writeByte(value.furnaceType());
+        BedrockTypes.VAR_INT.writePrimitive(buffer, value.leftTab());
+        buffer.writeBoolean(value.filtering());
+        BedrockTypes.VAR_INT.writePrimitive(buffer, value.layout());
+    }
+
+}
