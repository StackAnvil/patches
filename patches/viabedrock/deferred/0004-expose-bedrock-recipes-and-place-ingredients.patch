+
+class CraftingOutputPlanTest {
+
+    @Test
+    void shiftCraftMergesIntoAnOccupiedStackAndCraftsAsManyAsFit() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryContainer inventory = new InventoryContainer(user);
+        final BedrockItem existing = new BedrockItem(2);
+        existing.setAmount(60);
+        existing.setNetId(19);
+        inventory.setItem(9, existing);
+        final BedrockItem result = new BedrockItem(2);
+        result.setAmount(2);
+        final HudContainer grid = new HudContainer(user);
+        final BedrockItem first = new BedrockItem(1);
+        first.setAmount(7);
+        first.setNetId(21);
+        grid.setItem(28, first);
+        final BedrockItem second = new BedrockItem(1);
+        second.setAmount(5);
+        second.setNetId(22);
+        grid.setItem(29, second);
+
+        final CraftingOutputPlan plan = CraftingOutputPlan.plan(
+                inventory, result, grid, 28, new int[] {1, 1}, 64);
+
+        assertEquals(9, plan.destination());
+        assertEquals(2, plan.crafts());
+        assertEquals(4, plan.outputAmount());
+        assertEquals(19, plan.destinationNetId());
+    }
+
+    @Test
+    void shiftCraftDoesNotMergeItemsWithDifferentUserData() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryContainer inventory = new InventoryContainer(user);
+        final BedrockItem restricted = new BedrockItem(2);
+        restricted.setAmount(60);
+        restricted.setNetId(19);
+        restricted.setCanPlace(new String[] {"minecraft:stone"});
+        inventory.setItem(9, restricted);
+        final HudContainer grid = new HudContainer(user);
+        final BedrockItem ingredient = new BedrockItem(1);
+        ingredient.setAmount(5);
+        ingredient.setNetId(21);
+        grid.setItem(28, ingredient);
+
+        final CraftingOutputPlan plan = CraftingOutputPlan.plan(
+                inventory, new BedrockItem(2), grid, 28, new int[] {1}, 64);
+
+        assertEquals(10, plan.destination());
+        assertEquals(5, plan.crafts());
+        assertEquals(0, plan.destinationNetId());
+    }
+
+    @Test
+    void shiftCraftRejectsRecipesWithoutIngredients() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[] {UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryContainer inventory = new InventoryContainer(user);
+        final HudContainer grid = new HudContainer(user);
+
+        assertNull(CraftingOutputPlan.plan(inventory, new BedrockItem(2),
+                grid, 28, new int[] {0, 0, 0, 0}, 64));
+    }
+
+}
