+    private static BedrockBlockState blockState(final String identifier, final String axis) {
+        final var tag = new CompoundTag();
+        tag.putString("name", identifier);
+        final var properties = new CompoundTag();
+        properties.putString("pillar_axis", axis);
+        tag.put("states", properties);
+        return BedrockBlockState.fromNbt(tag);
+    }
