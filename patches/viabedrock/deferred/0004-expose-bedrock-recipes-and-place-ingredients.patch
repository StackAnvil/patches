+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Function;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CookingRecipeSourcesTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_SOURCES", matches = ".+")
+    void matchesCompleteNativeCollectionAcrossGroupCacheAndSortBoundaries() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_SOURCES")))).getAsJsonObject();
+        final var registry = registry();
+        final var rows = reference.getAsJsonArray("rows");
+        assertFalse(rows.isEmpty());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var auxiliary = row.getAsJsonArray("auxiliary");
+            final BedrockItem[] items = new BedrockItem[auxiliary.size()];
+            for (int slot = 0; slot < items.length; slot++) {
+                items[slot] = item(auxiliary.get(slot).getAsInt(), row.getAsJsonArray("counts").get(slot).getAsInt());
+                if (row.getAsJsonArray("blocked").get(slot).getAsBoolean()) {
+                    items[slot].setTag(enchantments());
+                }
+                if (row.has("locks") && !row.getAsJsonArray("locks").get(slot).isJsonNull()) {
+                    final var lock = row.getAsJsonArray("locks").get(slot).getAsJsonArray();
+                    final var tag = items[slot].tag() != null ? items[slot].tag() : new CompoundTag();
+                    final int value = lock.get(1).getAsInt();
+                    switch (lock.get(0).getAsInt()) {
+                        case 1 -> tag.putByte("minecraft:item_lock", (byte) value);
+                        case 2 -> tag.putShort("minecraft:item_lock", (short) value);
+                        case 3 -> tag.putInt("minecraft:item_lock", value);
+                        default -> fail("Unsupported fixture tag type");
+                    }
+                    items[slot].setTag(tag);
+                }
+            }
+            final var containers = items.length == 2
+                    ? List.of(new BedrockItem[]{items[0]}, new BedrockItem[]{items[1]})
+                    : List.of(items, new BedrockItem[0]);
+            final var query = new ItemRecipeKey(1, row.get("queryAuxiliary").getAsShort());
+            final var result = CookingRecipeSources.collect(containers, Function.identity(),
+                    item -> registry.recipeKey(item, null), item -> query.matches(registry.recipeKey(item, null), ignored -> null));
+            assertEquals(row.get("total").getAsInt(), result.amount(), row::toString);
+            final var expected = row.getAsJsonArray("sources");
+            assertEquals(expected.size(), result.sources().size(), row::toString);
+            for (int index = 0; index < expected.size(); index++) {
+                final var source = expected.get(index).getAsJsonArray();
+                assertSame(containers.get(source.get(0).getAsInt()), result.sources().get(index).container(), row::toString);
+                assertEquals(source.get(1).getAsInt(), result.sources().get(index).slot(), row::toString);
+            }
+        }
+    }
+
+    @Test
+    void firstNonemptyDescriptorCachesEligibilityAcrossContainers() {
+        final var first = item(0, 255);
+        final var enchanted = item(0, 128);
+        enchanted.setTag(enchantments());
+        final var locked = item(0, 1);
+        final var lock = new CompoundTag();
+        lock.putByte("minecraft:item_lock", (byte) 2);
+        locked.setTag(lock);
+        final var skipped = item(0, 0);
+        skipped.setTag(enchantments());
+        final var containers = List.of(new BedrockItem[]{skipped, first}, new BedrockItem[]{enchanted, locked});
+        final var registry = registry();
+        final var calls = new AtomicInteger();
+        final var result = CookingRecipeSources.collect(containers, Function.identity(), item -> registry.recipeKey(item, null), item -> {
+            calls.incrementAndGet();
+            return true;
+        });
+        assertEquals(384, result.amount());
+        assertEquals(1, calls.get());
+        assertEquals(List.of(1, 0, 1), result.sources().stream().map(CookingRecipeSources.Source::slot).toList());
+        assertSame(containers.getFirst(), result.sources().getFirst().container());
+        assertSame(containers.getLast(), result.sources().getLast().container());
+        assertThrows(UnsupportedOperationException.class, () -> result.sources().clear());
+        assertEquals(255, first.amount());
+        for (final var rejected : List.of(enchanted, locked)) {
+            final var blocked = CookingRecipeSources.collect(List.<BedrockItem[]>of(new BedrockItem[]{rejected, first}),
+                    Function.identity(), item -> registry.recipeKey(item, null), item -> fail("Cached rejection must skip query evaluation"));
+            assertEquals(0, blocked.amount());
+            assertTrue(blocked.sources().isEmpty());
+        }
+    }
+
+    @Test
+    void locksRequireNonzeroBytesAndEnchantmentListsNeedNotContainEntries() {
+        final var registry = registry();
+        final BedrockItem[] items = new BedrockItem[5];
+        Arrays.setAll(items, slot -> item(slot, 1));
+        final var zero = new CompoundTag();
+        zero.putByte("minecraft:item_lock", (byte) 0);
+        items[0].setTag(zero);
+        final var wrongType = new CompoundTag();
+        wrongType.putInt("minecraft:item_lock", 2);
+        wrongType.putInt("ench", 1);
+        items[1].setTag(wrongType);
+        final var negative = new CompoundTag();
+        negative.putByte("minecraft:item_lock", (byte) -1);
+        items[2].setTag(negative);
+        items[3].setTag(enchantments());
+        final var result = CookingRecipeSources.collect(List.<BedrockItem[]>of(items), Function.identity(),
+                item -> registry.recipeKey(item, null), item -> true);
+        assertEquals(3, result.amount());
+        assertEquals(List.of(0, 1, 4), result.sources().stream().map(CookingRecipeSources.Source::slot).toList());
+    }
+
+    private static ItemRegistry registry() {
+        return new ItemRegistry(new ItemEntry[]{new ItemEntry("test:ordinary", 1, false, ItemVersion.Legacy, null)});
+    }
+
+    private static BedrockItem item(final int metadata, final int amount) {
+        return new BedrockItem(1, (short) metadata, (byte) amount);
+    }
+
+    private static CompoundTag enchantments() {
+        final var tag = new CompoundTag();
+        tag.put("ench", new ListTag<>(CompoundTag.class));
+        return tag;
+    }
+
+}
