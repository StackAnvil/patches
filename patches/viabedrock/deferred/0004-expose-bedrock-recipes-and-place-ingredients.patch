+package net.raphimc.viabedrock.protocol.model.recipe;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class RecipeOwnershipTest {
+
+    @Test
+    void recipeSnapshotsOwnTheirIngredientsAndResultData() {
+        final var input = new ItemDescriptor.ItemNameDescriptor("probe:input", 0);
+        final var inputs = new ArrayList<ItemDescriptor>(List.of(input));
+        final var tag = new CompoundTag();
+        tag.putInt("value", 7);
+        final var output = new BedrockItem(1, (short) 0, (byte) 2, tag);
+        final var outputs = new ArrayList<>(List.of(output));
+        final var pattern = new ItemDescriptor[][]{{input}};
+        final var shapeless = new ShapelessRecipe("one", UUID.randomUUID(), "furnace", 0, inputs, outputs);
+        final var shaped = new ShapedRecipe("two", UUID.randomUUID(), "crafting_table", 0, pattern, outputs, false);
+        final var smithing = new SmithingRecipe("three", UUID.randomUUID(), "smithing_table", 0, input, input, input, output);
+        inputs.clear();
+        outputs.clear();
+        pattern[0][0] = new ItemDescriptor.InvalidDescriptor();
+        output.setAmount(9);
+        tag.putInt("value", 99);
+        for (final var result : List.of(shapeless.getResults().getFirst(), shaped.getResults().getFirst(), smithing.getResult())) {
+            assertEquals(2, result.amount());
+            assertEquals(7, result.tag().getInt("value"));
+            result.setAmount(12);
+            result.tag().putInt("value", 100);
+        }
+        assertEquals(2, shapeless.getResults().getFirst().amount());
+        assertEquals(7, shaped.getResults().getFirst().tag().getInt("value"));
+        assertEquals(7, smithing.getResult().tag().getInt("value"));
+        assertEquals(List.of(input), shapeless.getIngredients());
+        assertEquals(List.of(input), shaped.getIngredients());
+        assertThrows(UnsupportedOperationException.class, () -> shapeless.getIngredients().clear());
+        assertThrows(UnsupportedOperationException.class, () -> shaped.getIngredients().clear());
+    }
+
+}
