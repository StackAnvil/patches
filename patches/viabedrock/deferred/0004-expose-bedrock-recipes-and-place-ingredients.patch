+    @Test
+    void registrationRejectsConflictsWithoutReservingEitherUnusedKey() {
+        final var tracker = new CraftingDataTracker(user());
+        final var first = recipe("first", UUID.randomUUID(), 1, true);
+        final var conflictingName = recipe("first", UUID.randomUUID(), 2, true);
+        final var afterRejectedName = recipe("second", UUID.randomUUID(), 2, true);
+        final var conflictingNetworkId = new CraftingDataStorage(RecipeType.SHAPELESS, 1,
+                new ShapelessRecipe("third", UUID.randomUUID(), "furnace", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(3))), true);
+        final var afterRejectedNetworkId = new CraftingDataStorage(RecipeType.SHAPELESS, Integer.MIN_VALUE,
+                conflictingNetworkId.recipe(), true);
+        final var zero = recipe("zero", UUID.randomUUID(), 0, true);
+        final var afterZero = recipe("zero", UUID.randomUUID(), -1, true);
+        tracker.updateCraftingDataList(List.of(first, conflictingName, afterRejectedName,
+                conflictingNetworkId, afterRejectedNetworkId, zero, afterZero), true);
+        assertEquals(List.of(first, afterRejectedName, afterRejectedNetworkId, afterZero), tracker.getCraftingDataList());
+        assertThrows(UnsupportedOperationException.class, () -> tracker.getCraftingDataList().clear());
+
+        final var replacement = recipe("replacement", UUID.randomUUID(), 2, true);
+        tracker.updateCraftingDataList(List.of(replacement), false);
+        assertEquals(4, tracker.getCraftingDataList().size());
+        tracker.updateCraftingDataList(List.of(replacement), true);
+        assertEquals(List.of(replacement), tracker.getCraftingDataList());
+        tracker.updateCraftingDataList(List.of(afterRejectedName), false);
+        assertEquals(List.of(replacement), tracker.getCraftingDataList());
+    }
