+                List.of(new BedrockItem(2)), false);
+        final CraftingDataTracker.RecipeMatch match = new CraftingDataTracker.RecipeMatch(
+                new CraftingDataStorage(RecipeType.SHAPED, 37, recipe, true),
+                new int[] {0, 0, 1, 0});
+
+        final List<ItemStackRequestAction> actions = InventoryContainer.craftingOutputActions(
+                match, hud, inventory, 0, false, -3, 1, 1, 0);
+        final ItemStackRequestAction.CraftRecipeAction craft = assertInstanceOf(
+                ItemStackRequestAction.CraftRecipeAction.class, actions.get(0));
+        assertEquals(37, craft.recipeNetworkId());
+        final ItemStackRequestAction.CraftResultsDeprecatedAction results = assertInstanceOf(
+                ItemStackRequestAction.CraftResultsDeprecatedAction.class, actions.get(1));
+        assertEquals(1, results.timesCrafted());
+        assertEquals(1, results.resultItems().size());
+        assertEquals(2, results.resultItems().get(0).identifier());
+        assertEquals(1, results.resultItems().get(0).amount());
+        final ItemStackRequestAction.ConsumeAction consume = assertInstanceOf(
+                ItemStackRequestAction.ConsumeAction.class, actions.get(2));
+        assertEquals(30, consume.item().slot());
+        assertEquals(19, consume.item().stackNetworkId());
+        final ItemStackRequestAction.PlaceAction place = assertInstanceOf(
