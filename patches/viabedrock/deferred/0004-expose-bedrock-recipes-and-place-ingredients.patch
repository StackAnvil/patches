+    @Test
+    void nativeCatalogRefreshKeepsIdentitiesButNeverRetargetsAnOlderSnapshot() {
+        final var tracker = new CraftingDataTracker(user());
+        final UUID id = UUID.randomUUID();
+        final var original = recipe("first", id, 1, true);
+        final var replaced = recipe("first", id, 2, true);
+        tracker.updateCraftingDataList(List.of(original), true);
+        final var catalog = tracker.recipeCatalog(data -> true);
+        final int identity = catalog.entries().getFirst().id();
+        tracker.updateCraftingDataList(List.of(replaced), true);
+        final var refreshed = tracker.recipeCatalog(data -> true);
+        assertNotEquals(identity, refreshed.entries().getFirst().id());
+        assertNull(catalog.recipe(identity));
+        assertSame(replaced, refreshed.recipe(refreshed.entries().getFirst().id()));
+        tracker.updateCraftingDataList(List.of(), true);
+        assertNull(refreshed.recipe(identity));
+        final var newRecipe = recipe("new", UUID.randomUUID(), 1, true);
+        tracker.updateCraftingDataList(List.of(newRecipe), false);
+        assertNotEquals(identity, tracker.recipeCatalog(data -> true).entries().getFirst().id());
+    }
+
+    @Test
+    void nativeRegistrationKeepsFirstStationIdentityBeforeControllerFiltering() {
+        final var tracker = new CraftingDataTracker(user());
+        final var first = recipe("duplicate", UUID.randomUUID(), 1, false);
+        final var duplicate = recipe("duplicate", UUID.randomUUID(), 2, true);
+        final var sameDisplayIdentity = recipe("duplicate", first.recipe().getRecipeId(), 3, true);
+        final var otherStation = new CraftingDataStorage(RecipeType.SHAPELESS, 4,
+                new ShapelessRecipe(first.recipe().getUniqueId(), first.recipe().getRecipeId(), "furnace", 0,
+                        List.of(new TestDescriptor(1, 1)), List.of(new BedrockItem(3))), true);
+        tracker.updateCraftingDataList(List.of(first, duplicate, sameDisplayIdentity, otherStation), true);
+
+        assertEquals(List.of(first, otherStation), tracker.getCraftingDataList());
+        final var catalog = tracker.recipeCatalog(data -> true);
+        assertEquals(2, catalog.entries().size());
+        final int identity = catalog.entries().getFirst().id();
+        assertSame(first, catalog.entries().getFirst().data());
+        assertNull(catalog.recipe(identity));
+        assertSame(otherStation, catalog.recipe(catalog.entries().getLast().id()));
+        // A controller cannot select a later duplicate simply because it does not
+        // support the first entry, or because the duplicate is always unlocked.
+        assertTrue(tracker.recipeCatalog(data -> data == duplicate).entries().isEmpty());
+        tracker.updateUnlockedRecipes(2, List.of(first.recipe().getUniqueId()));
+        assertFalse(catalog.current(tracker));
+        assertSame(first, tracker.recipeCatalog(data -> true).recipe(identity));
+
+        tracker.updateCraftingDataList(List.of(duplicate), false);
+        assertSame(first, tracker.recipeCatalog(data -> true).recipe(identity));
+        tracker.updateCraftingDataList(List.of(sameDisplayIdentity), true);
+        assertNull(tracker.recipeCatalog(data -> true).recipe(identity));
+        assertSame(sameDisplayIdentity, tracker.recipeCatalog(data -> true).recipe(tracker.displayIdFor(sameDisplayIdentity)));
+    }
