+    @Test
+    void recipeDisplayIdsSurviveCatalogUpdatesWithoutReusingRemovedIds() {
+        final CraftingDataTracker tracker = new CraftingDataTracker(user());
+        final UUID recipeId = UUID.randomUUID();
+        final CraftingDataStorage first = recipe("first", recipeId, 10, false);
+        final CraftingDataStorage updated = recipe("first", recipeId, 20, false);
+        final CraftingDataStorage replacement = recipe("second", UUID.randomUUID(), 10, false);
+
+        final int firstId = tracker.displayIdFor(first);
+        assertEquals(firstId, tracker.displayIdFor(first));
+        assertNotEquals(firstId, tracker.displayIdFor(updated));
+        assertNotEquals(firstId, tracker.displayIdFor(replacement));
+    }
