+    private static void acknowledge(final Fixture fixture, final ItemStackRequestInfo[] batch) {
+        int nextId = 3000;
+        for (final var request : batch) {
+            final var pending = fixture.requests.getRequest(request.requestId());
+            final var action = (ItemStackRequestAction.PlaceAction) request.actions().getFirst();
+            final Map<FullContainerName, List<ItemStackResponseSlotInfo>> containers = new LinkedHashMap<>();
+            for (final var slot : List.of(action.source(), action.destination())) {
+                final int index = Byte.toUnsignedInt(slot.slot());
+                final var owner = fixture.inventory.getContainerFromName(slot.container(), index);
+                final var item = pending.predictedItem(owner, owner.slotFromRequest(index));
+                containers.computeIfAbsent(slot.container(), _ -> new ArrayList<>()).add(new ItemStackResponseSlotInfo(
+                        slot.slot(), slot.slot(), (byte) item.amount(), item.isEmpty() ? 0 : nextId++, "", null, 0));
+            }
+            fixture.requests.handleResponse(new ItemStackResponseInfo(ItemStackNetResult.Success, request.requestId(),
+                    containers.entrySet().stream().map(entry -> new ItemStackResponseContainerInfo(entry.getKey(), entry.getValue())).toList()));
+        }
+    }
