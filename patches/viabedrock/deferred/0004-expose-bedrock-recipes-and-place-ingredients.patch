+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.api.model.container.block.FurnaceContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.BiPredicate;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import java.util.function.ToIntFunction;
+
+/** Plans ingredient transfers only. Cooking, fuel consumption and output remain server owned. */
+public final class FurnaceRecipePlacement {
+
+    private FurnaceRecipePlacement() { }
+
+    public static Plan plan(final CraftingDataStorage data, final FurnaceContainer furnace,
+            final InventoryContainer inventory, final boolean maxItems,
+            final ToIntFunction<BedrockItem> maximum, final Function<BedrockItem, ItemRecipeKey> identity,
+            final BiPredicate<BedrockItem, BedrockItem> canMerge,
+            final Predicate<BedrockItem> matches) {
+        if (!furnace.acceptsRecipe(data) || inventory.size() != 36) {
+            return null;
+        }
+        final ItemDescriptor ingredient = ((ShapelessRecipe) data.recipe()).getIngredients().get(0);
+        if (ingredient.amount() < 1 || ingredient.amount() > 255) {
+            return null;
+        }
+        final BedrockItem[] available = Arrays.stream(inventory.getItems())
+                .map(BedrockItem::copy).toArray(BedrockItem[]::new);
+        BedrockItem input = furnace.getItem(0).copy();
+        if (!input.isEmpty() && !hasServerId(input)) {
+            return null;
+        }
+        final List<ItemStackRequestAction.PlaceAction> actions = new ArrayList<>();
+        final Map<Integer, BedrockItem> updates = new HashMap<>();
+        if (!input.isEmpty() && !matches.test(input)) {
+            // Clear into compatible stacks before using empty slots. Plan everything before mutation.
+            final int limit = Math.min(255, maximum.applyAsInt(input));
+            if (limit < 1) {
+                return null;
+            }
+            for (final boolean merge : new boolean[]{true, false}) {
+                for (int slot = 0; slot < available.length && !input.isEmpty(); slot++) {
+                    final BedrockItem destination = available[slot];
+                    if (!inventory.canPlaceItem(slot, input) || (merge
+                            ? destination.isEmpty() || !hasServerId(destination) || !canMerge.test(input, destination)
+                            : !destination.isEmpty())) {
+                        continue;
+                    }
+                    final int count = Math.min(input.amount(), limit - destination.amount());
+                    if (count < 1) {
+                        continue;
+                    }
+                    actions.add(new ItemStackRequestAction.PlaceAction(count,
+                            furnace.requestSlotInfo(0, input.netId()),
+                            inventory.requestSlotInfo(slot, destination.isEmpty() ? 0 : destination.netId())));
+                    final BedrockItem moved = destination.isEmpty() ? input.copy() : destination.copy();
+                    moved.setAmount(destination.amount() + count);
+                    available[slot] = moved;
+                    updates.put(slot, moved);
+                    input = remainder(input, count);
+                }
+            }
+            if (!input.isEmpty()) {
+                return null;
+            }
+        }
+        final var sources = CookingRecipeSources.collect(List.<BedrockItem[]>of(available), Function.identity(),
+                identity, matches).sources();
+        final List<BedrockItem> candidates = input.isEmpty()
+                ? sources.stream().map(source -> available[source.slot()]).toList() : List.of(input);
+        BedrockItem selected = null;
+        int target = 0;
+        for (final BedrockItem candidate : candidates) {
+            if (candidate.isEmpty() || !hasServerId(candidate) || !matches.test(candidate)
+                    || !furnace.canPlaceItem(0, candidate)) {
+                continue;
+            }
+            final int limit = Math.min(255, maximum.applyAsInt(candidate));
+            int total = input.amount();
+            for (final var source : sources) {
+                final BedrockItem item = available[source.slot()];
+                if (!item.isEmpty() && hasServerId(item) && !item.isDifferent(candidate)
+                        && furnace.canPlaceItem(0, item)) {
+                    total += item.amount();
+                }
+            }
+            final int amount = Math.min(limit / ingredient.amount(), maxItems
+                    ? total / ingredient.amount() : input.amount() / ingredient.amount() + 1) * ingredient.amount();
+            if (amount < ingredient.amount() || total < amount || amount < input.amount()) {
+                continue;
+            }
+            if (selected == null || amount > target) {
+                selected = candidate;
+                target = amount;
+            }
+            if (!maxItems) {
+                break;
+            }
+        }
+        if (selected == null) {
+            return null;
+        }
+        for (final var reference : sources) {
+            if (input.amount() >= target) {
+                break;
+            }
+            final int slot = reference.slot();
+            final BedrockItem source = available[slot];
+            if (source.isEmpty() || !hasServerId(source) || source.isDifferent(selected)
+                    || !furnace.canPlaceItem(0, source)) {
+                continue;
+            }
+            final int count = Math.min(source.amount(), target - input.amount());
+            actions.add(new ItemStackRequestAction.PlaceAction(count,
+                    new ItemStackRequestSlotInfo(new FullContainerName(slot < 9
+                            ? ContainerEnumName.HotbarContainer : ContainerEnumName.InventoryContainer, null),
+                            (byte) slot, source.netId()),
+                    furnace.requestSlotInfo(0, input.isEmpty() ? 0 : input.netId())));
+            final BedrockItem moved = input.isEmpty() ? source.copy() : input.copy();
+            moved.setAmount(input.amount() + count);
+            input = moved;
+            available[slot] = remainder(source, count);
+            updates.put(slot, available[slot]);
+        }
+        return input.amount() == target ? new Plan(actions, input, updates) : null;
+    }
+
+    private static boolean hasServerId(final BedrockItem item) {
+        return item.netId() != null && item.netId() > 0;
+    }
+
+    private static BedrockItem remainder(final BedrockItem item, final int count) {
+        if (item.amount() == count) {
+            return BedrockItem.empty();
+        }
+        final BedrockItem remaining = item.copy();
+        remaining.setAmount(item.amount() - count);
+        return remaining;
+    }
+
+    public static final class Plan {
+
+        private final List<ItemStackRequestAction.PlaceAction> actions;
+        private final BedrockItem input;
+        private final Map<Integer, BedrockItem> inventoryUpdates;
+
+        private Plan(final List<ItemStackRequestAction.PlaceAction> actions,
+                final BedrockItem input, final Map<Integer, BedrockItem> updates) {
+            this.actions = List.copyOf(actions);
+            this.input = input.copy();
+            this.inventoryUpdates = Map.copyOf(updates);
+        }
+
+        public boolean hasTransfers() {
+            return !this.actions.isEmpty();
+        }
+
+        public List<ItemStackRequestAction> actions(final int requestId) {
+            final Set<SlotKey> changed = new HashSet<>();
+            final List<ItemStackRequestAction> result = new ArrayList<>(this.actions.size());
+            for (final ItemStackRequestAction.PlaceAction transfer : this.actions) {
+                result.add(new ItemStackRequestAction.PlaceAction(transfer.count(),
+                        requestSlot(transfer.source(), changed, requestId),
+                        requestSlot(transfer.destination(), changed, requestId)));
+                changed.add(SlotKey.of(transfer.source()));
+                changed.add(SlotKey.of(transfer.destination()));
+            }
+            return List.copyOf(result);
+        }
+
+        private static ItemStackRequestSlotInfo requestSlot(final ItemStackRequestSlotInfo slot,
+                final Set<SlotKey> changed, final int requestId) {
+            // Native predicted-container callbacks assign the request ID even to emptied slots.
+            return changed.contains(SlotKey.of(slot))
+                    ? new ItemStackRequestSlotInfo(slot.container(), slot.slot(), requestId) : slot;
+        }
+
+        public void apply(final FurnaceContainer furnace, final InventoryContainer inventory) {
+            furnace.setItem(0, this.input.copy());
+            this.inventoryUpdates.forEach((slot, item) -> inventory.setItem(slot, item.copy()));
+        }
+
+        private record SlotKey(FullContainerName container, byte slot) {
+
+            private static SlotKey of(final ItemStackRequestSlotInfo slot) {
+                final FullContainerName container = switch (slot.container().name()) {
+                    case HotbarContainer, InventoryContainer, CombinedHotbarAndInventoryContainer ->
+                        new FullContainerName(ContainerEnumName.CombinedHotbarAndInventoryContainer,
+                                    slot.container().dynamicId());
+                    default -> slot.container();
+                };
+                return new SlotKey(container, slot.slot());
+            }
+        }
+    }
+
+}
