+        private final List<PacketWrapper> sent = new ArrayList<>();
+        private final MockedStatic<PacketWrapper> factory = mockStatic(PacketWrapper.class);
+
+        private Fixture() {
+            when(this.user.getProtocolInfo()).thenReturn(this.info);
+            when(this.info.getClientState()).thenReturn(State.PLAY);
+            when(this.user.get(ChannelStorage.class)).thenReturn(this.channels);
+            when(this.user.get(FurnaceOptionsStorage.class)).thenReturn(this.preferences);
+            when(this.user.has(FurnaceOptionsStorage.class)).thenReturn(true);
+            when(this.user.get(NativeSkinStorage.class)).thenReturn(mock(NativeSkinStorage.class));
+            when(this.user.get(PlayerInputStorage.class)).thenReturn(mock(PlayerInputStorage.class));
+            when(this.user.get(HudVisibilityStorage.class)).thenReturn(mock(HudVisibilityStorage.class));
+            when(this.user.get(CameraEffectsStorage.class)).thenReturn(mock(CameraEffectsStorage.class));
+            this.factory.when(() -> PacketWrapper.create(any(PacketType.class), eq(this.user))).thenAnswer(call -> {
+                final var packet = spy(new PacketWrapperImpl(call.getArgument(0, PacketType.class), null, this.user));
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).send(BedrockProtocol.class);
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).sendToServer(BedrockProtocol.class);
+                return packet;
+            });
+        }
+
+        private List<FurnaceOptions> nativeUpdates() {
+            return this.sent.stream().filter(packet -> packet.getPacketType() == ClientboundPackets26_3.CUSTOM_PAYLOAD
+                    && packet.get(Types.STRING, 0).equals(NativeFurnaceOptions.CHANNEL))
+                    .map(packet -> packet.get(NativeFurnaceOptions.TYPE, 0)).toList();
+        }
+
+        private void nativeInput(final FurnaceOptions value) throws Exception {
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.STRING.write(buffer, NativeFurnaceOptions.CHANNEL);
+                NativeFurnaceOptions.TYPE.write(buffer, value);
+                final var packet = new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, buffer, this.user);
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+                assertTrue(packet.isCancelled());
+            } finally {
+                buffer.release();
+            }
+        }
+
+        private void channels(final String operation) throws Exception {
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.STRING.write(buffer, operation);
+                buffer.writeBytes(NativeFurnaceOptions.CHANNEL.getBytes(StandardCharsets.UTF_8));
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, buffer, this.user));
+            } finally {
+                buffer.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.factory.close();
+        }
+    }
+
+}
