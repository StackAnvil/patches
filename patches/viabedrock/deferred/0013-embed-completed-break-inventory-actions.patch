+    static BedrockItem predictedMinedItem(final BedrockItem item,
+                                          final boolean damageableWithoutTag) {
+        if (item.isEmpty()) {
+            return null;
+        }
+        final int damage;
+        if (item.tag() != null && item.tag().get("Damage") instanceof NumberTag currentDamage) {
+            damage = currentDamage.asInt();
+        } else if (damageableWithoutTag) {
+            damage = 0;
+        } else {
+            return null;
+        }
+        final BedrockItem predicted = item.copy();
+        final CompoundTag tag = predicted.tag() != null ? predicted.tag() : new CompoundTag();
+        tag.put("Damage", new IntTag(damage + 1));
+        predicted.setTag(tag);
+        return predicted;
+    }
