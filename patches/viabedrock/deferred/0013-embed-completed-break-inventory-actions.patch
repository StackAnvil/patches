+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerActionType;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class MiningInputPacketTest {
+
+    @Test
+    void validServerboundInputRetainsMiningWithoutClientboundChannelAdvertisement() throws Exception {
+        final UserConnection user = mock(UserConnection.class);
+        final ProtocolInfo info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getClientState()).thenReturn(State.PLAY);
+        final ChannelStorage channels = new ChannelStorage();
+        channels.addChannels(List.of(PlayerInputPermissions.CHANNEL));
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final GameSessionStorage session = mock(GameSessionStorage.class);
+        when(session.isBlockBreakingServerAuthoritative()).thenReturn(true);
+        when(session.getLevelGameType()).thenReturn(GameType.Survival);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        final ClientPlayerEntity player = new ClientPlayerEntity(user, 1, UUID.randomUUID(),
+                new PlayerAbilities(1, (byte) 0, (byte) 0));
+        player.setGameType(GameType.Survival);
+        final EntityTracker entities = mock(EntityTracker.class);
+        when(user.get(EntityTracker.class)).thenReturn(entities);
+        when(entities.getClientPlayer()).thenReturn(player);
+        assertFalse(player.hasNativeMiningInput());
+
+        // Fabric registers this payload as serverbound; it does not advertise a clientbound receiver.
+        accept(user, new PlayerMiningInput(true));
+        assertTrue(player.hasNativeMiningInput());
+        final BlockPosition first = new BlockPosition(0, 66, 3);
+        final BlockPosition next = new BlockPosition(0, 66, 4);
+        ClientPlayerPackets.queueCompletedDestroyActions(player, first, Direction.NORTH);
+        player.completeAuthInputFrame();
+        assertTrue(player.authInputBlockActions().isEmpty());
+        ClientPlayerPackets.queueStartDestroyAction(player, next, Direction.NORTH, false);
+        assertEquals(List.of(new ClientPlayerEntity.AuthInputBlockAction(
+                PlayerActionType.ContinueDestroyBlock, next, Direction.NORTH.ordinal())), player.authInputBlockActions());
+
+        player.completeAuthInputFrame();
+        ClientPlayerPackets.queueCompletedDestroyActions(player, next, Direction.NORTH);
+        player.completeAuthInputFrame();
+        accept(user, new PlayerMiningInput(false));
+        accept(user, new PlayerMiningInput(false));
+        ClientPlayerPackets.queueStartDestroyAction(player, next, Direction.EAST, false);
+        assertEquals(List.of(new ClientPlayerEntity.AuthInputBlockAction(
+                PlayerActionType.AbortDestroyBlock, next, Direction.NORTH.ordinal())), player.authInputBlockActions());
+        player.completeAuthInputFrame();
+        assertEquals(List.of(new ClientPlayerEntity.AuthInputBlockAction(
+                PlayerActionType.StartDestroyBlock, next, Direction.EAST.ordinal())), player.authInputBlockActions());
+    }
+
+    private static void accept(final UserConnection user, final PlayerMiningInput value) throws Exception {
+        final var input = Unpooled.buffer();
+        try {
+            Types.STRING.write(input, PlayerMiningInput.CHANNEL);
+            PlayerMiningInput.TYPE.write(input, value);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, input, user);
+            MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(input.isReadable());
+        } finally {
+            input.release();
+        }
+    }
+
+}
