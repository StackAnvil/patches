+    private void handleMineBlockResponse(final MineBlockRequest request,
+                                         final ItemStackResponseInfo response) {
+        if (response.result() != ItemStackNetResult.Success) {
+            return;
+        }
+        final InventoryContainer inventory = this.user().get(InventoryTracker.class)
+                .getInventoryContainer();
+        final BedrockItem current = inventory.getItem(request.hotbarSlot());
+        for (ItemStackResponseContainerInfo containerInfo : response.containers()) {
+            final ContainerEnumName name = containerInfo.containerName().name();
+            if (name != ContainerEnumName.CombinedHotbarAndInventoryContainer
+                    && name != ContainerEnumName.HotbarContainer
+                    && name != ContainerEnumName.InventoryContainer) {
+                continue;
+            }
+            for (ItemStackResponseSlotInfo slotInfo : containerInfo.slots()) {
+                if (Byte.toUnsignedInt(slotInfo.slot()) != request.hotbarSlot()) {
+                    continue;
+                }
+                final BedrockItem corrected = correctedMineBlockItem(
+                        current, request.stackNetworkId(), slotInfo);
+                if (corrected == null) {
+                    return;
+                }
+                inventory.setItem(request.hotbarSlot(), corrected);
+                PacketFactory.sendJavaContainerSetContent(this.user(), inventory);
+                return;
+            }
+        }
+    }
+
+    static BedrockItem correctedMineBlockItem(final BedrockItem current,
+                                              final int expectedNetId,
+                                              final ItemStackResponseSlotInfo slotInfo) {
+        if (current.isEmpty() || !java.util.Objects.equals(current.netId(), expectedNetId)) {
+            return null;
+        }
+        if (slotInfo.amount() == 0) {
+            return BedrockItem.empty();
+        }
+        final BedrockItem corrected = current.copy();
+        corrected.setAmount(Byte.toUnsignedInt(slotInfo.amount()));
+        corrected.setNetId(slotInfo.itemNetId());
+        final CompoundTag tag = corrected.tag() != null
+                ? corrected.tag() : new CompoundTag();
+        tag.put("Damage", new IntTag(slotInfo.durability()));
+        corrected.setTag(tag);
+        return corrected;
+    }
