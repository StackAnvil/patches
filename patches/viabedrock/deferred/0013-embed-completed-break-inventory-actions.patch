+        final String identifier = itemRewriter.itemIdentifier(item);
+        final Set<String> tags = BedrockProtocol.MAPPINGS.getBedrockItemTags()
+                .getOrDefault(identifier, Set.of());
+        return tags.contains("minecraft:is_tool") || tags.contains("minecraft:is_shears");
+    }
