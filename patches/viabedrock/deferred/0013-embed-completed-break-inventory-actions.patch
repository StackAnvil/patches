+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Whether held attack still admits a block target before Java's mining callbacks. */
+public record PlayerMiningInput(boolean continuing) {
+
+    public static final String CHANNEL = "viabedrock:mining_input";
+    public static final Type<PlayerMiningInput> TYPE = new Type<>(PlayerMiningInput.class) {
+        @Override
+        public PlayerMiningInput read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported mining input");
+            }
+            return new PlayerMiningInput(buffer.readBoolean());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerMiningInput value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeBoolean(value.continuing());
+        }
+    };
+
+}
