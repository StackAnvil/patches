+    static BedrockItem predictedMinedItem(final BedrockItem item,
+                                          final boolean damageableWithoutTag) {
+        if (item.isEmpty()) {
+            return null;
+        }
+        final int damage;
+        if (item.tag() != null && item.tag().get("Damage") instanceof NumberTag currentDamage) {
+            damage = currentDamage.asInt();
+        } else if (damageableWithoutTag) {
+            damage = 0;
+        } else {
+            return null;
+        }
+        final BedrockItem predicted = item.copy();
+        final CompoundTag tag = predicted.tag() != null ? predicted.tag() : new CompoundTag();
+        tag.put("Damage", new IntTag(damage + 1));
+        predicted.setTag(tag);
+        return predicted;
+    }
+
+    private static boolean damageableMiningItem(final BedrockItem item,
+                                                final ItemRewriter itemRewriter) {
+        final String identifier = itemRewriter.getItems().inverse().get(item.identifier());
+        final Set<String> tags = BedrockProtocol.MAPPINGS.getBedrockItemTags()
+                .getOrDefault(identifier, Set.of());
+        return tags.contains("minecraft:is_tool") || tags.contains("minecraft:is_shears");
+    }
+
+    private static void queueMineBlockRequest(final ClientPlayerEntity player,
+                                              final InventoryTracker inventory,
+                                              final InventoryRequestTracker requests,
+                                              final ItemRewriter itemRewriter) {
+        if (player.authInputItemStackRequest() != null || requests.hasPending()
+                || requests.hasPendingMineBlockRequest()) {
+            return;
+        }
+        final InventoryContainer hotbar = inventory.getInventoryContainer();
+        final BedrockItem held = hotbar.getSelectedHotbarItem();
+        final BedrockItem predicted = predictedMinedItem(
+                held, damageableMiningItem(held, itemRewriter));
+        if (predicted == null || held.netId() == null || held.netId() <= 0) {
+            return;
+        }
+        final int slot = Byte.toUnsignedInt(hotbar.getSelectedHotbarSlot());
+        player.setAuthInputItemStackRequest(new ItemStackRequestInfo(
+                requests.nextRequestId(),
+                List.of(new ItemStackRequestAction.MineBlockAction(
+                        slot, predicted.tag().getIntTag("Damage").asInt(), held.netId())),
+                List.of(), TextProcessingEventOrigin.unknown));
+    }
