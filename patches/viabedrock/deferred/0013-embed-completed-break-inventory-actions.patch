+                new ItemStackResponseSlotInfo((byte) 2, (byte) 2, (byte) 1,
+                        13, "", null, 6);
+
+        assertNull(InventoryRequestTracker.correctedMineBlockItem(
+                replacement, 12, oldResponse));
