+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseSlotInfo;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class InventoryRequestTrackerMiningTest {
+
+    @Test
+    void acceptedMiningResponseUpdatesDurabilityWithoutMutatingPriorItem() {
+        final CompoundTag tag = new CompoundTag();
+        tag.put("Damage", new IntTag(5));
+        final BedrockItem held = new BedrockItem(1, (short) 0, (byte) 1, tag);
+        held.setNetId(12);
+        final ItemStackResponseSlotInfo response =
+                new ItemStackResponseSlotInfo((byte) 2, (byte) 2, (byte) 1,
+                        13, "", null, 6);
+
+        final BedrockItem corrected =
+                InventoryRequestTracker.correctedMineBlockItem(held, 12, response);
+
+        assertNotSame(held, corrected);
+        assertEquals(5, held.tag().getIntTag("Damage").asInt());
+        assertEquals(6, corrected.tag().getIntTag("Damage").asInt());
+        assertEquals(13, corrected.netId());
+    }
+
+    @Test
+    void staleMiningResponseCannotDamageReplacedTool() {
+        final BedrockItem replacement = new BedrockItem(1);
+        replacement.setNetId(29);
+        final ItemStackResponseSlotInfo oldResponse =
+                new ItemStackResponseSlotInfo((byte) 2, (byte) 2, (byte) 1,
+                        13, "", null, 6);
+
+        assertNull(InventoryRequestTracker.correctedMineBlockItem(
+                replacement, 12, oldResponse));
+    }
+
+}
