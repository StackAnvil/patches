+    @Test
+    void acceptedMiningResponseUpdatesDurabilityWithoutMutatingPriorItem() {
+        final CompoundTag tag = new CompoundTag();
+        tag.put("Damage", new IntTag(5));
+        final BedrockItem held = new BedrockItem(1, (short) 0, (byte) 1, tag);
+        held.setNetId(12);
+        final ItemStackResponseSlotInfo response =
+                new ItemStackResponseSlotInfo((byte) 2, (byte) 2, (byte) 1,
+                        13, "", null, 6);
+
+        final BedrockItem corrected =
+                InventoryRequestTracker.correctedMineBlockItem(held, 12, response);
+
+        assertNotSame(held, corrected);
+        assertEquals(5, held.tag().getIntTag("Damage").asInt());
+        assertEquals(6, corrected.tag().getIntTag("Damage").asInt());
+        assertEquals(13, corrected.netId());
+    }
