+package net.raphimc.viabedrock.api.model.container.block;
+
+import com.viaversion.nbt.io.NBTIO;
+import com.viaversion.nbt.limiter.TagLimiter;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntArrayTag;
+import com.viaversion.nbt.tag.ListTag;
+import net.raphimc.viabedrock.protocol.data.enums.DyeColor;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import org.junit.jupiter.api.Test;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.io.DataInputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashSet;
+import java.util.zip.GZIPInputStream;
+import java.util.Map;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LoomPatternsTest {
+
+    @Test
+    void selectsFromAdvertisedTagOrderInsteadOfRegistryOrdinal() {
+        final CompoundTag registry = new CompoundTag();
+        registry.put("probe:first", new CompoundTag());
+        registry.put("probe:second", new CompoundTag());
+        registry.put("probe:third", new CompoundTag());
+        final var choices = new IntArrayTag(new int[]{2, 0});
+        final var mappings = Map.of("probe:first", "a", "probe:second", "b", "probe:third", "c");
+        assertEquals(mappings.get("probe:third"), LoomPatterns.button(0, registry, choices, mappings));
+        assertEquals(mappings.get("probe:first"), LoomPatterns.button(1, registry, choices, mappings));
+        assertNull(LoomPatterns.button(-1, registry, choices, mappings));
+        assertNull(LoomPatterns.button(2, registry, choices, mappings));
+        assertNull(LoomPatterns.button(0, registry, new IntArrayTag(new int[]{4}), mappings));
+    }
+
+    @Test
+    void addsColoredLayerWithoutMutatingInputOrDiscardingItsMetadata() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putString("custom", "retained");
+        final ListTag<CompoundTag> layers = new ListTag<>(CompoundTag.class);
+        final CompoundTag old = new CompoundTag();
+        old.putString("Pattern", "hh");
+        old.putInt("Color", DyeColor.RED.bedrockId());
+        layers.add(old);
+        tag.put("Patterns", layers);
+        final BedrockItem banner = new BedrockItem(24, (short) 15, (byte) 8, tag);
+        banner.setNetId(123);
+        final var result = LoomPatterns.result(banner, DyeColor.BLUE, "cre");
+        assertEquals(1, result.amount());
+        assertEquals(banner.data(), result.data());
+        assertNull(result.netId());
+        assertEquals(tag.getString("custom"), result.tag().getString("custom"));
+        final var converted = ItemDataRewriter.bannerPatterns(result.tag(), registry(), Map.of("hh", "probe:first", "cre", "probe:second"));
+        assertEquals(2, converted.length);
+        assertEquals(0, converted[0].pattern().id());
+        assertEquals(DyeColor.RED.javaId(), converted[0].dyeColor());
+        assertEquals(1, converted[1].pattern().id());
+        assertEquals(DyeColor.BLUE.javaId(), converted[1].dyeColor());
+        assertEquals(1, layers.size());
+        assertEquals(8, banner.amount());
+        assertEquals(123, banner.netId());
+    }
+
+    @Test
+    void stopsAtSixLayersAndRejectsMalformedOrOminousInputs() {
+        BedrockItem banner = new BedrockItem(24);
+        for (int i = 0; i < 6; i++) {
+            banner = LoomPatterns.result(banner, DyeColor.RED, "hh");
+            assertFalse(banner.isEmpty());
+        }
+        assertTrue(LoomPatterns.result(banner, DyeColor.RED, "hh").isEmpty());
+        final var tag = new CompoundTag();
+        tag.putInt("Patterns", 3);
+        banner.setTag(tag);
+        assertTrue(LoomPatterns.result(banner, DyeColor.RED, "hh").isEmpty());
+        tag.remove("Patterns");
+        tag.putInt("Type", 1);
+        assertTrue(LoomPatterns.result(banner, DyeColor.RED, "hh").isEmpty());
+        assertTrue(LoomPatterns.result(BedrockItem.empty(), DyeColor.RED, "hh").isEmpty());
+    }
+
+    @Test
+    void craftConsumesInputsAndPlacesCreatedOutputWithoutConsumingTheMaterial() {
+        final var banner = new BedrockItem(24);
+        banner.setNetId(101);
+        final var dye = new BedrockItem(25);
+        dye.setNetId(102);
+        final var result = LoomPatterns.result(banner, DyeColor.RED, "cre");
+        final var destination = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CursorContainer, null), (byte) 0, 0);
+        final var actions = LoomContainer.resultActions("cre", banner, dye, result, -7, destination);
+        assertEquals(5, actions.size());
+        assertEquals(1, assertInstanceOf(ItemStackRequestAction.CraftLoomAction.class, actions.get(0)).timesCrafted());
+        assertEquals(result, assertInstanceOf(ItemStackRequestAction.CraftResultsDeprecatedAction.class, actions.get(1)).resultItems().get(0));
+        final var consumeBanner = assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, actions.get(2));
+        assertEquals(101, consumeBanner.item().stackNetworkId());
+        assertEquals(9, consumeBanner.item().slot());
+        final var consumeDye = assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, actions.get(3));
+        assertEquals(102, consumeDye.item().stackNetworkId());
+        assertEquals(10, consumeDye.item().slot());
+        final var place = assertInstanceOf(ItemStackRequestAction.PlaceAction.class, actions.get(4));
+        assertEquals(ContainerEnumName.CreatedOutputContainer, place.source().container().name());
+        assertEquals(-7, place.source().stackNetworkId());
+        assertEquals(50, place.source().slot());
+        assertEquals(destination, place.destination());
+    }
+
+    @Test
+    void legacyAndNamedDyesUseTheSameNativeColorOrder() {
+        for (final DyeColor color : DyeColor.values()) {
+            assertEquals(color, LoomPatterns.dye("minecraft:" + color.name().toLowerCase(java.util.Locale.ROOT) + "_dye", 0));
+            assertEquals(color, LoomPatterns.dye("minecraft:dye", color.bedrockId()));
+        }
+        assertNull(LoomPatterns.dye("minecraft:diamond", 0));
+        assertNull(LoomPatterns.dye("minecraft:dye", 16));
+    }
+
+    @Test
+    void advertisedPatternTagsMatchMaterialAndResultRegistries() throws Exception {
+        final CompoundTag registry = this.asset("registries.nbt").getCompoundTag("minecraft:banner_pattern");
+        final CompoundTag tags = this.asset("tags.nbt").getCompoundTag("minecraft:banner_pattern");
+        final var identifiers = registry.keySet().stream().toList();
+        final var special = new HashSet<Integer>();
+        try (var stream = getClass().getResourceAsStream("/assets/viabedrock/data/custom/banner_pattern_mappings.json")) {
+            assertNotNull(stream);
+            final var mappings = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final String tag : tags.keySet()) {
+                final String prefix = "minecraft:pattern_item/";
+                if (!tag.startsWith(prefix)) {
+                    continue;
+                }
+                final int[] choices = ((IntArrayTag) tags.get(tag)).getValue();
+                assertEquals(1, choices.length);
+                final int choice = choices[0];
+                assertTrue(choice >= 0 && choice < identifiers.size());
+                final String pattern = LoomPatterns.material("minecraft:" + tag.substring(prefix.length()) + "_banner_pattern");
+                assertNotNull(pattern);
+                assertEquals(mappings.get(pattern).getAsString(), identifiers.get(choice));
+                assertTrue(special.add(choice));
+            }
+        }
+        final var covered = new HashSet<>(special);
+        final int base = identifiers.indexOf("minecraft:base");
+        assertTrue(base >= 0);
+        covered.add(base);
+        for (final int choice : ((IntArrayTag) tags.get("minecraft:no_item_required")).getValue()) {
+            assertTrue(choice >= 0 && choice < identifiers.size());
+            assertTrue(covered.add(choice));
+        }
+        assertEquals(identifiers.size(), covered.size());
+    }
+
+    private CompoundTag asset(final String name) throws Exception {
+        try (var stream = getClass().getResourceAsStream("/assets/viabedrock/data/java/" + name)) {
+            assertNotNull(stream);
+            return NBTIO.readTag(new DataInputStream(new GZIPInputStream(stream)), TagLimiter.noop(), true, CompoundTag.class);
+        }
+    }
+
+    private static CompoundTag registry() {
+        final var registry = new CompoundTag();
+        registry.put("probe:first", new CompoundTag());
+        registry.put("probe:second", new CompoundTag());
+        return registry;
+    }
+
+}
