+package net.raphimc.viabedrock.api.model.container.block;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntArrayTag;
+import com.viaversion.nbt.tag.ListTag;
+import net.raphimc.viabedrock.protocol.data.enums.DyeColor;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Resolves loom choices from Java's advertised registry and preserves native banner data. */
+final class LoomPatterns {
+
+    private static final Map<String, String> MATERIALS = Map.ofEntries(
+            Map.entry("minecraft:flower_banner_pattern", "flo"),
+            Map.entry("minecraft:creeper_banner_pattern", "cre"),
+            Map.entry("minecraft:skull_banner_pattern", "sku"),
+            Map.entry("minecraft:mojang_banner_pattern", "moj"),
+            Map.entry("minecraft:field_masoned_banner_pattern", "bri"),
+            Map.entry("minecraft:bordure_indented_banner_pattern", "cbo"),
+            Map.entry("minecraft:piglin_banner_pattern", "pig"),
+            Map.entry("minecraft:globe_banner_pattern", "glb"),
+            Map.entry("minecraft:flow_banner_pattern", "flw"),
+            Map.entry("minecraft:guster_banner_pattern", "gus"));
+
+    private LoomPatterns() {
+    }
+
+    static String material(final String identifier) {
+        return MATERIALS.get(identifier);
+    }
+
+    static String button(final int button, final CompoundTag registry, final IntArrayTag choices,
+                         final Map<String, String> javaToBedrock) {
+        if (choices == null || button < 0 || button >= choices.getValue().length) {
+            return null;
+        }
+        final int id = choices.getValue()[button];
+        final List<String> identifiers = registry.keySet().stream().toList();
+        return id < 0 || id >= identifiers.size() ? null : javaToBedrock.get(identifiers.get(id));
+    }
+
+    static DyeColor dye(final String identifier, final int metadata) {
+        if ("minecraft:dye".equals(identifier)) {
+            return DyeColor.getByBedrockId(metadata);
+        }
+        if (identifier == null || !identifier.startsWith("minecraft:") || !identifier.endsWith("_dye")) {
+            return null;
+        }
+        final String color = identifier.substring(10, identifier.length() - 4);
+        for (final DyeColor dye : DyeColor.values()) {
+            if (dye.name().toLowerCase(Locale.ROOT).equals(color)) {
+                return dye;
+            }
+        }
+        return null;
+    }
+
+    static BedrockItem result(final BedrockItem banner, final DyeColor color, final String pattern) {
+        if (banner.isEmpty() || color == null || pattern == null) {
+            return BedrockItem.empty();
+        }
+        final CompoundTag tag = banner.tag() == null ? new CompoundTag() : banner.tag().copy();
+        final ListTag<CompoundTag> existing = tag.getListTag("Patterns", CompoundTag.class);
+        if (tag.getInt("Type", 0) == 1 || tag.contains("Patterns") && existing == null
+                || existing != null && existing.size() >= 6) {
+            return BedrockItem.empty();
+        }
+        final ListTag<CompoundTag> patterns = existing == null ? new ListTag<>(CompoundTag.class) : existing;
+        final CompoundTag layer = new CompoundTag();
+        layer.putString("Pattern", pattern);
+        layer.putInt("Color", color.bedrockId());
+        patterns.add(layer);
+        tag.put("Patterns", patterns);
+        tag.putInt("Type", 0);
+        final BedrockItem result = banner.copy();
+        result.setAmount(1);
+        result.setNetId(null);
+        result.setTag(tag);
+        return result;
+    }
+
+}
