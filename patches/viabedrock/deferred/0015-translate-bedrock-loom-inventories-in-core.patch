+    public static BannerPatternLayer[] bannerPatterns(final CompoundTag tag, final CompoundTag registry,
+                                                     final Map<String, String> mappings) {
+        final ListTag<CompoundTag> patterns = tag.getListTag("Patterns", CompoundTag.class);
+        if (patterns == null) {
+            return new BannerPatternLayer[0];
+        }
+        final List<BannerPatternLayer> result = new ArrayList<>();
+        for (final CompoundTag layer : patterns) {
+            final String name = mappings.get(layer.getString("Pattern", ""));
+            final DyeColor color = DyeColor.getByBedrockId(layer.getInt("Color", DyeColor.BLACK.bedrockId()));
+            final int id = name == null ? -1 : registryIndex(registry, name);
+            if (id >= 0 && color != null) {
+                result.add(new BannerPatternLayer(Holder.of(id), color.javaId()));
+            }
+        }
+        return result.toArray(BannerPatternLayer[]::new);
+    }
