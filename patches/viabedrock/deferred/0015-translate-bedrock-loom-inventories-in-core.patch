+package net.raphimc.viabedrock.api.model.container.block;
+
+import com.viaversion.nbt.tag.IntArrayTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.InputContainer;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.TextProcessingEventOrigin;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.ContainerInput;
+import net.raphimc.viabedrock.protocol.data.generated.bedrock.CustomBlockTags;
+import net.raphimc.viabedrock.protocol.data.generated.java.RegistryKeys;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import java.util.List;
+
+public final class LoomContainer extends InputContainer {
+
+    private String selectedPattern;
+    private Integer pendingResult;
+    private boolean repeatQuickMove;
+    private int resultRevision;
+
+    public LoomContainer(final UserConnection user, final byte containerId, final TextComponent title,
+                         final BlockPosition position) {
+        super(user, containerId, ContainerType.LOOM, title, position, 4, CustomBlockTags.LOOM);
+    }
+
+    @Override
+    protected int[] inputSlots() {
+        return new int[]{9, 10, 11};
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        final ContainerEnumName name = switch (slot) {
+            case 9 -> ContainerEnumName.LoomInputContainer;
+            case 10 -> ContainerEnumName.LoomDyeContainer;
+            case 11 -> ContainerEnumName.LoomMaterialContainer;
+            case 50 -> ContainerEnumName.LoomResultPreviewContainer;
+            default -> throw new IllegalArgumentException("Invalid loom slot: " + slot);
+        };
+        return new FullContainerName(name, null);
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return slot >= 9 && slot <= 11 ? slot - 9 : slot == 50 ? 3 : -1;
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return slot >= 0 && slot <= 2 ? slot + 9 : slot == 3 ? 50 : -1;
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return this.javaSlot(slot);
+    }
+
+    private String identifier(final BedrockItem item) {
+        return this.user.get(ItemRewriter.class).getItems().inverse().get(item.identifier());
+    }
+
+    @Override
+    protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem item) {
+        if (slot < 3) {
+            if (slot == 2 && previous.isDifferent(item)) {
+                this.selectedPattern = item.isEmpty() ? null : LoomPatterns.material(this.identifier(item));
+            }
+            this.refreshOutput();
+        }
+    }
+
+    private void refreshOutput() {
+        this.items[3] = "minecraft:banner".equals(this.identifier(this.items[0])) && !this.items[1].isEmpty()
+                ? LoomPatterns.result(this.items[0], LoomPatterns.dye(this.identifier(this.items[1]), this.items[1].data()), this.selectedPattern)
+                : BedrockItem.empty();
+    }
+
+    @Override
+    public boolean handleButtonClick(final int button) {
+        if (this.isClosing()) {
+            return false;
+        }
+        final var registry = BedrockProtocol.MAPPINGS.getJavaRegistries().getCompoundTag(RegistryKeys.BANNER_PATTERN);
+        final var tags = BedrockProtocol.MAPPINGS.getJavaTags().getCompoundTag(RegistryKeys.BANNER_PATTERN);
+        final String requested = LoomPatterns.button(button, registry,
+                tags.get("minecraft:no_item_required") instanceof IntArrayTag choices ? choices : null,
+                BedrockProtocol.MAPPINGS.getBedrockToJavaBannerPatterns().inverse());
+        if (requested == null || !this.items[2].isEmpty()) {
+            return false;
+        }
+        this.selectedPattern = requested;
+        this.refreshOutput();
+        PacketFactory.sendJavaContainerSetContent(this.user, this);
+        return true;
+    }
+
+    @Override
+    protected List<QuickMoveRange> quickMoveRanges(final short javaSlot, final SlotRef source) {
+        final var inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        if (source.container() != inventory) {
+            return super.quickMoveRanges(javaSlot, source);
+        }
+        final BedrockItem item = source.container().getItem(source.bedrockSlot());
+        final String identifier = this.identifier(item);
+        final int input = "minecraft:banner".equals(identifier) ? 0
+                : LoomPatterns.dye(identifier, item.data()) != null ? 1
+                : LoomPatterns.material(identifier) != null ? 2 : -1;
+        if (input >= 0) {
+            return List.of(new QuickMoveRange(this, input, input + 1, false));
+        }
+        return source.bedrockSlot() < 9 ? List.of(new QuickMoveRange(inventory, 9, inventory.size(), false))
+                : List.of(new QuickMoveRange(inventory, 0, 9, false));
+    }
+
+    @Override
+    public boolean handleClick(final int revision, final short slot, final byte button, final ContainerInput action) {
+        if (this.isClosing()) {
+            return false;
+        }
+        if (slot != 3) {
+            return super.handleClick(revision, slot, button, action);
+        }
+        if (this.pendingResult != null || action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE
+                || action == ContainerInput.PICKUP && button != 0) {
+            return false;
+        }
+        this.refreshOutput();
+        final BedrockItem result = this.items[3];
+        if (result.isEmpty() || this.items[0].netId() == null || this.items[1].netId() == null) {
+            return false;
+        }
+        final var inventory = this.user.get(InventoryTracker.class);
+        final boolean quickMove = action == ContainerInput.QUICK_MOVE;
+        final Container target = quickMove ? inventory.getInventoryContainer() : inventory.getHudContainer();
+        final int max = this.user.get(ItemRewriter.class).maxStackSize(result);
+        final int destination = quickMove ? this.destination(target, result, max) : 0;
+        if (destination < 0) {
+            return false;
+        }
+        final BedrockItem current = target.getItem(destination);
+        if (!current.isEmpty() && (current.isDifferent(result) || current.netId() == null || current.amount() >= max)) {
+            return false;
+        }
+        final var requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId, resultActions(this.selectedPattern, this.items[0], this.items[1], this.items[3], requestId,
+                target.requestSlotInfo(destination, current.isEmpty() ? 0 : current.netId())), List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, revision, inventory.getHudContainer().copy(),
+                quickMove ? List.of(this.copy(), target.copy()) : List.of(this.copy())));
+        this.pendingResult = requestId;
+        this.repeatQuickMove = quickMove;
+        this.resultRevision = revision;
+        this.setItem(9, this.itemAfterRemovingAmount(this.items[0], 1));
+        this.setItem(10, this.itemAfterRemovingAmount(this.items[1], 1));
+        final BedrockItem placed = current.isEmpty() ? result.copy() : current.copy();
+        placed.setAmount(current.amount() + 1);
+        target.setItem(destination, placed);
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[]{request});
+        return true;
+    }
+
+    static List<ItemStackRequestAction> resultActions(final String pattern, final BedrockItem banner, final BedrockItem dye,
+                                                    final BedrockItem result, final int requestId,
+                                                    final ItemStackRequestSlotInfo destination) {
+        return List.of(new ItemStackRequestAction.CraftLoomAction(pattern, 1),
+                new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(result.copy()), 1),
+                new ItemStackRequestAction.ConsumeAction(1, new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.LoomInputContainer, null), (byte) 9, banner.netId())),
+                new ItemStackRequestAction.ConsumeAction(1, new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.LoomDyeContainer, null), (byte) 10, dye.netId())),
+                new ItemStackRequestAction.PlaceAction(1,
+                        new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null), (byte) 50, requestId), destination));
+    }
+
+    @Override
+    public boolean handleResponse(final int requestId, final boolean success) {
+        super.handleResponse(requestId, success);
+        if (this.pendingResult != null && this.pendingResult == requestId) {
+            this.pendingResult = null;
+            this.refreshOutput();
+            if (success && this.repeatQuickMove && !this.isClosing()) {
+                this.user.get(InventoryRequestTracker.class).queueClick(this, this.resultRevision, (short) 3, (byte) 0, ContainerInput.QUICK_MOVE);
+            }
+        }
+        return false;
+    }
+
+    private int destination(final Container inventory, final BedrockItem result, final int maximum) {
+        for (final boolean merge : new boolean[]{true, false}) {
+            for (int slot = 0; slot < inventory.size(); slot++) {
+                final BedrockItem item = inventory.getItem(slot);
+                if (merge ? !item.isEmpty() && !item.isDifferent(result) && item.netId() != null && item.amount() < maximum : item.isEmpty()) {
+                    return slot;
+                }
+            }
+        }
+        return -1;
+    }
+
+}
