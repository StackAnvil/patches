+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ServerboundPackets26_3;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.NativeContainerAction;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.model.NativeContainerStatus;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.NativeContainerUiState;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeContainerOffhandGuardTest {
+
+    @Test
+    void pendingOffhandOwnershipBlocksNativeTransfersButAlwaysAllowsDeactivation() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        final var game = mock(GameSessionStorage.class);
+        final var state = mock(NativeContainerUiState.class);
+        final var requests = new InventoryRequestTracker(user);
+        final var channels = new ChannelStorage();
+        channels.addChannels(java.util.List.of(NativeContainerMessage.CURRENT_CHANNEL, NativeContainerStatus.CHANNEL));
+        final Map<Class<?>, Object> stores = Map.of(GameSessionStorage.class, game, NativeContainerUiState.class, state,
+                InventoryRequestTracker.class, requests, ChannelStorage.class, channels);
+        when(user.get(any())).thenAnswer(call -> stores.get(call.getArgument(0)));
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getClientState()).thenReturn(State.PLAY);
+        final var transfer = new NativeContainerAction(6, 1, 0, NativeContainerAction.Mode.AUTO_PLACE_ONE, 9);
+        send(user, transfer);
+        verify(state).handleAction(transfer);
+        clearInvocations(state);
+        when(user.get(GameSessionStorage.class)).thenReturn(null);
+        send(user, transfer);
+        verifyNoInteractions(state);
+        when(user.get(GameSessionStorage.class)).thenReturn(game);
+        requests.awaitLegacyOffhand(new BedrockItem(1));
+        assertTrue(requests.isWaitingForLegacyOffhand());
+        send(user, transfer);
+        verifyNoInteractions(state);
+        final var deactivate = new NativeContainerAction(6, 1, 0, NativeContainerAction.Mode.DEACTIVATE, -1);
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            final var response = mock(PacketWrapper.class);
+            packets.when(() -> PacketWrapper.create(
+                    ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(response);
+            final var activate = new NativeContainerAction(6, 1, 0, NativeContainerAction.Mode.ACTIVATE, -1);
+            send(user, activate);
+            verify(state).handleAction(deactivate);
+            verify(state, never()).handleAction(activate);
+            final var status = ArgumentCaptor.forClass(NativeContainerStatus.class);
+            verify(response).write(eq(NativeContainerStatus.TYPE), status.capture());
+            assertFalse(status.getValue().accepted());
+        }
+        clearInvocations(state);
+        send(user, deactivate);
+        verify(state).handleAction(deactivate);
+        // The server-authoritative session checks its own pending request/response ownership.
+        when(game.isInventoryServerAuthoritative()).thenReturn(true);
+        send(user, transfer);
+        verify(state).handleAction(transfer);
+    }
+
+    private static void send(final UserConnection user, final NativeContainerAction action) throws Exception {
+        final var input = Unpooled.buffer();
+        try {
+            Types.STRING.write(input, NativeContainerMessage.CURRENT_CHANNEL);
+            NativeContainerAction.TYPE.write(input, action);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, input, user);
+            MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(input.isReadable());
+        } finally {
+            input.release();
+        }
+    }
+
+}
