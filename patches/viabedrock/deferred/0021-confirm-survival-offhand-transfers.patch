+    public void awaitLegacyOffhand(final BedrockItem item) {
+        if (this.pendingLegacyOffhand != null) {
+            throw new IllegalStateException("An offhand transfer is already pending");
+        }
+        this.pendingLegacyOffhand = new PendingLegacyOffhand(item.copy(), false, System.nanoTime());
+    }
+
+    public void awaitLegacyOffhandTake(final BedrockItem item) {
+        if (this.pendingLegacyOffhand != null) {
+            throw new IllegalStateException("An offhand transfer is already pending");
+        }
+        this.pendingLegacyOffhand = new PendingLegacyOffhand(item.copy(), true, System.nanoTime());
+    }
+
+    public boolean handleLegacyOffhandUpdate(final Container container) {
+        if (this.pendingLegacyOffhand == null
+                || container != this.user().get(InventoryTracker.class).getOffhandContainer()
+                || !this.pendingLegacyOffhand.matches(container.getItem(0))) {
+            return false;
+        }
+        final PendingLegacyOffhand pending = this.pendingLegacyOffhand;
+        this.pendingLegacyOffhand = null;
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        if (pending.taking()) {
+            if (tracker.getHudContainer().getItem(0).isEmpty()) {
+                tracker.getHudContainer().setItem(0, pending.item());
+                this.legacyOffhandCursor = pending.item();
+            }
+        } else {
+            tracker.getHudContainer().setItem(0, BedrockItem.empty());
+            this.legacyOffhandCursor = null;
+        }
+        this.drainQueuedInteractions();
+        return true;
+    }
+
+    public void awaitLegacyCursorPlacement(final BedrockItem item, final int inventorySlot) {
+        if (this.pendingLegacyCursorPlacement != null || this.pendingLegacyOffhand != null) {
+            throw new IllegalStateException("A legacy inventory transfer is already pending");
+        }
+        this.pendingLegacyCursorPlacement = new PendingLegacyCursorPlacement(
+                item.copy(), inventorySlot, System.nanoTime());
+    }
+
+    public boolean handleLegacyCursorPlacementUpdate(final Container container) {
+        if (this.pendingLegacyCursorPlacement == null
+                || container != this.user().get(InventoryTracker.class).getInventoryContainer()
+                || !this.pendingLegacyCursorPlacement.matches(
+                        container.getItem(this.pendingLegacyCursorPlacement.inventorySlot()))) {
+            return false;
+        }
+        this.pendingLegacyCursorPlacement = null;
+        this.legacyOffhandCursor = null;
+        this.user().get(InventoryTracker.class).getHudContainer().setItem(0, BedrockItem.empty());
+        this.drainQueuedInteractions();
+        return true;
+    }
