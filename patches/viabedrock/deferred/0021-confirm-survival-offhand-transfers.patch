+    @Test
+    void legacyOffhandAcceptsReassignedNetIdForSameStack() {
+        final BedrockItem shield = new BedrockItem(358);
+        shield.setAmount(1);
+        shield.setNetId(12);
+        final InventoryRequestTracker.PendingLegacyOffhand pending =
+                new InventoryRequestTracker.PendingLegacyOffhand(shield, 0);
+
+        final BedrockItem accepted = shield.copy();
+        assertTrue(pending.matches(accepted));
+
+        accepted.setNetId(13);
+        assertTrue(pending.matches(accepted));
+        accepted.setNetId(12);
+        accepted.setAmount(2);
+        assertFalse(pending.matches(accepted));
+        accepted.setAmount(1);
+        accepted.setIdentifier(359);
+        assertFalse(pending.matches(accepted));
+    }
