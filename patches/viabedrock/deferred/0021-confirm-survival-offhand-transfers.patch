+    @Test
+    void legacyOffhandTransferMovesTheAuthoritativePlayerUiCursor() {
+        final BedrockItem shield = new BedrockItem(358);
+        shield.setAmount(1);
+        shield.setNetId(17);
+
+        final BedrockInventoryTransaction transaction =
+                InventoryPackets.legacyOffhandTransaction(shield);
+        assertEquals(2, transaction.actions().size());
+        final InventoryActionData take = transaction.actions().get(0);
+        final InventoryActionData place = transaction.actions().get(1);
+        assertEquals(InventorySourceType.Container_Inventory, take.source().type());
+        assertEquals(ContainerID.CONTAINER_ID_PLAYER_ONLY_UI.getValue(), take.source().containerId());
+        assertEquals(0, take.slot());
+        assertSame(shield, take.fromItem());
+        assertTrue(take.toItem().isEmpty());
+        assertEquals(InventorySourceType.Container_Inventory, place.source().type());
+        assertEquals(ContainerID.CONTAINER_ID_OFFHAND.getValue(), place.source().containerId());
+        assertEquals(0, place.slot());
+        assertTrue(place.fromItem().isEmpty());
+        assertSame(shield, place.toItem());
+    }
