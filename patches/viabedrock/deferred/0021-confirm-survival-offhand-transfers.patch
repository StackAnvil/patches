+    public static boolean handleLegacyOffhandClick(final UserConnection user, final Container container,
+                                                   final short slot, final byte button, final ContainerInput action) {
+        final InventoryTracker inventoryTracker = user.get(InventoryTracker.class);
+        final InventoryRequestTracker requestTracker = user.get(InventoryRequestTracker.class);
+        final BedrockItem cursor = inventoryTracker.getHudContainer().getItem(0);
+        final boolean offhandSlotClick = container instanceof InventoryContainer
+                && slot == 45 && button == 0 && action == ContainerInput.PICKUP;
+        if (!offhandSlotClick && !requestTracker.hasLegacyOffhandCursor()) {
+            return false;
+        }
+        if (user.get(GameSessionStorage.class).isInventoryServerAuthoritative()) {
+            return false;
+        }
+        if (requestTracker.hasLegacyOffhandCursor() && !offhandSlotClick) {
+            if (container instanceof InventoryContainer inventory
+                    && slot >= 9 && slot < 45 && button == 0 && action == ContainerInput.PICKUP) {
+                final int inventorySlot = inventory.bedrockSlot(slot);
+                if (!cursor.isEmpty() && inventory.getItem(inventorySlot).isEmpty()) {
+                    final BedrockInventoryTransaction transaction =
+                            legacyCursorInventoryTransaction(cursor, inventorySlot);
+                    requestTracker.awaitLegacyCursorPlacement(cursor, inventorySlot);
+                    sendLegacyInventoryTransaction(user, transaction);
+                    return true;
+                }
+            }
+            PacketFactory.sendJavaContainerSetContent(user, container);
+            return true;
+        }
+        if (!offhandSlotClick) {
+            return false;
+        }
+        final BedrockItem offhand = inventoryTracker.getOffhandContainer().getItem(0);
+        final BedrockInventoryTransaction transaction;
+        if (!cursor.isEmpty() && offhand.isEmpty()) {
+            transaction = legacyOffhandTransaction(cursor);
+            requestTracker.awaitLegacyOffhand(cursor);
+        } else if (cursor.isEmpty() && !offhand.isEmpty()) {
+            transaction = legacyOffhandTakeTransaction(offhand);
+            requestTracker.awaitLegacyOffhandTake(offhand);
+        } else {
+            return false;
+        }
+        sendLegacyInventoryTransaction(user, transaction);
+        return true;
+    }
+
+    private static void sendLegacyInventoryTransaction(
+            final UserConnection user, final BedrockInventoryTransaction transaction) {
+        final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION, user);
+        packet.write(user.get(InventoryTransactionRewriter.class).getInventoryTransactionType(), transaction);
+        packet.sendToServer(BedrockProtocol.class);
+    }
+
+    static BedrockInventoryTransaction legacyCursorInventoryTransaction(
+            final BedrockItem cursor, final int inventorySlot) {
+        final InventorySource playerUi = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_PLAYER_ONLY_UI.getValue(),
+                InventorySourceFlags.No_Flag);
+        final InventorySource inventory = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_INVENTORY.getValue(),
+                InventorySourceFlags.No_Flag);
+        return new BedrockInventoryTransaction(
+                0, null, List.of(
+                        new InventoryActionData(playerUi, 0, cursor, BedrockItem.empty()),
+                        new InventoryActionData(inventory, inventorySlot, BedrockItem.empty(), cursor)),
+                ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+    }
+
+    static BedrockInventoryTransaction legacyOffhandTransaction(final BedrockItem cursor) {
+        final InventorySource playerUi = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_PLAYER_ONLY_UI.getValue(),
+                InventorySourceFlags.No_Flag);
+        final InventorySource offhand = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_OFFHAND.getValue(),
+                InventorySourceFlags.No_Flag);
+        return new BedrockInventoryTransaction(
+                0, null, List.of(
+                        new InventoryActionData(playerUi, 0, cursor, BedrockItem.empty()),
+                        new InventoryActionData(offhand, 0, BedrockItem.empty(), cursor)),
+                ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+    }
+
+    static BedrockInventoryTransaction legacyOffhandTakeTransaction(final BedrockItem item) {
+        final InventorySource offhand = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_OFFHAND.getValue(),
+                InventorySourceFlags.No_Flag);
+        final InventorySource playerUi = new InventorySource(
+                InventorySourceType.Container_Inventory,
+                ContainerID.CONTAINER_ID_PLAYER_ONLY_UI.getValue(),
+                InventorySourceFlags.No_Flag);
+        return new BedrockInventoryTransaction(
+                0, null, List.of(
+                        new InventoryActionData(offhand, 0, item, BedrockItem.empty()),
+                        new InventoryActionData(playerUi, 0, BedrockItem.empty(), item)),
+                ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+    }
+
