 import java.util.logging.Level;
@@ -57,6 +58,8 @@ public class InventoryRequestTracker extends StoredObject {
             new Int2ObjectOpenHashMap<>();
     private final InventoryRequestRecovery recovery = new InventoryRequestRecovery();
     private final ArrayDeque<QueuedInteraction> queuedInteractions = new ArrayDeque<>();
+    private final PendingInventoryOpenClicks pendingInventoryOpenClicks =
+            new PendingInventoryOpenClicks();
     private int requestIdCounter = -1;
     private long pendingSinceNanos;
     private MineBlockRequest mineBlockRequest;
@@ -100,6 +103,32 @@ public class InventoryRequestTracker extends StoredObject {
         return this.queueInteraction(new QueuedClick(container, revision, slot, button, action));
     }
 
+    public boolean isWaitingForInventoryOpen() {
+        return !this.pendingInventoryOpenClicks.isEmpty();
+    }
+
+    public boolean queueInventoryOpenClick(final int revision, final short slot,
+                                           final byte button, final ContainerInput action) {
+        return this.pendingInventoryOpenClicks.add(
+                new InventoryOpenClick(revision, slot, button, action), System.nanoTime());
+    }
+
+    public void handleInventoryOpen(final Container container) {
+        for (final InventoryOpenClick click : this.pendingInventoryOpenClicks.drain()) {
+            if (this.hasPending()) {
+                if (!this.queueClick(container, click.revision(), click.slot(),
+                        click.button(), click.action())) {
+                    this.clearQueuedInteractions();
+                    PacketFactory.sendJavaContainerSetContent(this.user(), container);
+                    return;
+                }
+            } else if (!container.handleClick(
+                    click.revision(), click.slot(), click.button(), click.action())) {
+                PacketFactory.sendJavaContainerSetContent(this.user(), container);
+            }
+        }
+    }
+
     public boolean queueButtonClick(final Container container, final int button) {
         return this.queueInteraction(new QueuedButtonClick(container, button));
     }
@@ -115,6 +144,7 @@ public class InventoryRequestTracker extends StoredObject {
 
     public void clearQueuedInteractions() {
         this.queuedInteractions.clear();
+        this.pendingInventoryOpenClicks.clear();
     }
 
     public InventoryRequestStorage getRequest(final int requestId) {
@@ -129,6 +159,11 @@ public class InventoryRequestTracker extends StoredObject {
     }
 
     public void tick() {
+        if (this.pendingInventoryOpenClicks.expire(
+                System.nanoTime(), RESPONSE_TIMEOUT_NANOS)) {
+            PacketFactory.sendJavaContainerSetContent(this.user(),
+                    this.user().get(InventoryTracker.class).getInventoryContainer());
+        }
         if (this.mineBlockRequest != null
                 && System.nanoTime() - this.mineBlockRequest.sentAtNanos()
                 >= RESPONSE_TIMEOUT_NANOS) {
@@ -366,6 +401,49 @@ public class InventoryRequestTracker extends StoredObject {
     private record MineBlockRequest(int requestId, int hotbarSlot, int stackNetworkId,
                                     long sentAtNanos) { }
 
+    static final class PendingInventoryOpenClicks {
+
+        private final ArrayDeque<InventoryOpenClick> clicks = new ArrayDeque<>();
+        private long firstClickAtNanos;
+
+        boolean add(final InventoryOpenClick click, final long now) {
+            if (this.clicks.size() >= MAX_QUEUED_INTERACTIONS) {
+                this.clear();
+                return false;
+            }
+            if (this.clicks.isEmpty()) {
+                this.firstClickAtNanos = now;
+            }
+            this.clicks.addLast(click);
+            return true;
+        }
+
+        boolean isEmpty() {
+            return this.clicks.isEmpty();
+        }
+
+        List<InventoryOpenClick> drain() {
+            final List<InventoryOpenClick> pending = List.copyOf(this.clicks);
+            this.clear();
+            return pending;
+        }
+
+        boolean expire(final long now, final long timeoutNanos) {
+            if (this.clicks.isEmpty() || now - this.firstClickAtNanos < timeoutNanos) {
+                return false;
+            }
+            this.clear();
+            return true;
+        }
+
+        void clear() {
+            this.clicks.clear();
+            this.firstClickAtNanos = 0;
+        }
+    }
+
+    record InventoryOpenClick(int revision, short slot, byte button, ContainerInput action) { }
+
     private sealed interface QueuedInteraction permits QueuedClick, QueuedButtonClick {
 
         Container container();
