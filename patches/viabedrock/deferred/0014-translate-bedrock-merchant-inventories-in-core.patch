+package net.raphimc.viabedrock.api.model.container.entity;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.TradeOffer;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MerchantContainerTest {
+
+    @Test
+    void acceptedResultsAdvanceStockOnceAndRefreshThePreview() {
+        final TradeOffer offer = offer(14);
+        final MerchantContainer merchant = merchant(offer);
+        merchant.setItem(4, new BedrockItem(1, (short) 0, (byte) 64));
+        merchant.trackResultRequest(-3, offer, 2, 0, false);
+        assertFalse(merchant.handleResponse(-5, true));
+        assertEquals(14, merchant.selectedOffer().uses());
+        assertTrue(merchant.handleResponse(-3, true));
+        assertEquals(16, merchant.selectedOffer().uses());
+        assertTrue(merchant.getItem(50).isEmpty());
+        assertFalse(merchant.handleResponse(-3, true));
+        assertEquals(16, merchant.selectedOffer().uses());
+    }
+
+    @Test
+    void rejectedResultsPreserveStockAfterSnapshotRestoration() {
+        final TradeOffer offer = offer(0);
+        final MerchantContainer merchant = merchant(offer);
+        final BedrockItem input = new BedrockItem(1, (short) 0, (byte) 24);
+        input.setNetId(14);
+        merchant.setItem(4, input);
+        final var snapshot = merchant.copy();
+        merchant.trackResultRequest(-3, offer, 1, 0, false);
+        merchant.setItem(4, BedrockItem.empty());
+        merchant.setItems(snapshot.getItems());
+        assertFalse(merchant.handleResponse(-3, false));
+        assertEquals(0, merchant.selectedOffer().uses());
+        assertEquals(24, merchant.getItem(4).amount());
+        assertEquals(14, merchant.getItem(4).netId());
+        assertEquals(3, merchant.getItem(50).identifier());
+    }
+
+    @Test
+    void authoritativeOfferUpdatesPreventDoubleCountingAcceptedTrades() {
+        final TradeOffer offer = offer(0);
+        final MerchantContainer merchant = merchant(offer);
+        merchant.trackResultRequest(-3, offer, 2, 0, false);
+        merchant.replaceOffers(1, List.of(offer.used(2)));
+        assertFalse(merchant.handleResponse(-3, true));
+        assertEquals(2, merchant.selectedOffer().uses());
+        assertEquals(1, merchant.tier());
+    }
+
+    private static MerchantContainer merchant(final TradeOffer offer) {
+        return new MerchantContainer(null, (byte) 2, null, -42, true, true, 0, List.of(offer));
+    }
+
+    private static TradeOffer offer(final int uses) {
+        return new TradeOffer(4925, 0,
+                new TradeOffer.Ingredient(new BedrockItem(1, (short) 0, (byte) 24), true, 24),
+                null, new BedrockItem(3), uses, 16, 2);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/model/TradeOfferTest.java b/src/test/java/net/raphimc/viabedrock/protocol/model/TradeOfferTest.java
