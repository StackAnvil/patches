+package net.raphimc.viabedrock.api.model.container.entity;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.InputContainer;
+import net.raphimc.viabedrock.api.model.container.InventoryPlacement;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.TextProcessingEventOrigin;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.ContainerInput;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.TradeOffer;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.packet.TradePackets;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class MerchantContainer extends InputContainer {
+
+    private final long traderId;
+    private final boolean newTradeUi;
+    private final boolean economy;
+    private List<TradeOffer> offers;
+    private int tier;
+    private int experience;
+    private int selected;
+    private long offerRevision;
+    private PendingTrade pendingTrade;
+
+    public MerchantContainer(final UserConnection user, final byte containerId, final TextComponent title,
+                             final long traderId, final boolean newTradeUi, final boolean economy,
+                             final int tier, final List<TradeOffer> offers) {
+        super(user, containerId, ContainerType.TRADE, title, null, 3);
+        this.traderId = traderId;
+        this.newTradeUi = newTradeUi;
+        this.economy = economy;
+        this.replaceOffers(tier, offers);
+    }
+
+    @Override
+    protected int[] inputSlots() {
+        return new int[]{4, 5};
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        final ContainerEnumName name = switch (slot) {
+            case 4 -> this.newTradeUi ? ContainerEnumName.Trade2Ingredient1Container : ContainerEnumName.TradeIngredient1Container;
+            case 5 -> this.newTradeUi ? ContainerEnumName.Trade2Ingredient2Container : ContainerEnumName.TradeIngredient2Container;
+            case 50 -> this.newTradeUi ? ContainerEnumName.Trade2ResultPreviewContainer : ContainerEnumName.TradeResultPreviewContainer;
+            default -> throw new IllegalArgumentException("Invalid trade slot: " + slot);
+        };
+        return new FullContainerName(name, null);
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return switch (slot) {
+            case 4 -> 0;
+            case 5 -> 1;
+            case 50 -> 2;
+            default -> -1;
+        };
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return switch (slot) {
+            case 0 -> 4;
+            case 1 -> 5;
+            case 2 -> 50;
+            default -> -1;
+        };
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return this.javaSlot(slot);
+    }
+
+    @Override
+    protected void onSlotChanged(final int slot, final BedrockItem oldItem, final BedrockItem newItem) {
+        if (slot < 2) {
+            this.refreshOutput();
+        }
+    }
+
+    private void refreshOutput() {
+        final TradeOffer offer = this.selectedOffer();
+        this.items[2] = offer != null && offer.crafts(this.items[0], this.items[1], this.tier) > 0
+                ? offer.result().copy() : BedrockItem.empty();
+    }
+
+    public void replaceOffers(final int tier, final List<TradeOffer> offers) {
+        this.tier = Math.max(0, tier);
+        this.offers = List.copyOf(offers);
+        this.offerRevision++;
+        if (this.selected >= this.offers.size()) {
+            this.selected = 0;
+        }
+        this.refreshOutput();
+    }
+
+    public void updateActorState(final Entity actor) {
+        boolean changed = false;
+        final EntityData tierData = actor.entityData().get(ActorDataIds.TRADE_TIER);
+        if (tierData != null && tierData.value() instanceof Number number && this.tier != number.intValue()) {
+            this.tier = Math.max(0, number.intValue());
+            this.refreshOutput();
+            changed = true;
+        }
+        final EntityData data = actor.entityData().get(ActorDataIds.TRADE_EXPERIENCE);
+        if (data != null && data.value() instanceof Number number && this.experience != number.intValue()) {
+            this.experience = Math.max(0, number.intValue());
+            changed = true;
+        }
+        if (changed) {
+            TradePackets.sendOffers(this.user, this);
+        }
+    }
+
+    @Override
+    public boolean handleClick(final int revision, final short slot, final byte button, final ContainerInput action) {
+        if (this.isClosing()) {
+            return false;
+        }
+        if (slot == 2) {
+            return this.takeResult(revision, button, action);
+        }
+        final boolean handled = super.handleClick(revision, slot, button, action);
+        if (handled) {
+            this.refreshOutput();
+            PacketFactory.sendJavaContainerSetContent(this.user, this);
+        }
+        return handled;
+    }
+
+    @Override
+    protected List<QuickMoveRange> quickMoveRanges(final short javaSlot, final SlotRef source) {
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        if (source.container() != inventory.getInventoryContainer()) {
+            return super.quickMoveRanges(javaSlot, source);
+        }
+        final TradeOffer offer = this.selectedOffer();
+        if (offer == null || !offer.available(this.tier)) {
+            return List.of();
+        }
+        final BedrockItem item = source.container().getItem(source.bedrockSlot());
+        final List<QuickMoveRange> ranges = new ArrayList<>(2);
+        if (offer.first().matches(item)) {
+            ranges.add(new QuickMoveRange(this, 0, 1, false));
+        }
+        if (offer.second() != null && offer.second().matches(item)) {
+            ranges.add(new QuickMoveRange(this, 1, 2, false));
+        }
+        return ranges;
+    }
+
+    @Override
+    public boolean handleButtonClick(final int button) {
+        if (this.isClosing() || button < 0 || button >= this.offers.size()) {
+            return false;
+        }
+        this.selected = button;
+        this.refreshOutput();
+        final TradeOffer offer = this.selectedOffer();
+        if (!offer.available(this.tier)) {
+            PacketFactory.sendJavaContainerSetContent(this.user, this);
+            return true;
+        }
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final Container player = inventory.getInventoryContainer();
+        final InventoryPlacement.Plan plan = InventoryPlacement.plan(offer,
+                new BedrockItem[]{this.items[0], this.items[1]}, player.getItems(),
+                this.user.get(ItemRewriter.class)::maxStackSize);
+        if (plan == null) {
+            PacketFactory.sendJavaContainerSetContent(this.user, this);
+            return true;
+        }
+        if (!plan.transfers().isEmpty()) {
+            final List<ItemStackRequestAction> actions = new ArrayList<>();
+            for (final InventoryPlacement.Transfer transfer : plan.transfers()) {
+                final Container from = transfer.fromInventory() ? player : this;
+                final Container to = transfer.fromInventory() ? this : player;
+                final int source = transfer.fromInventory() ? transfer.source() : this.bedrockSlot(transfer.source());
+                final int destination = transfer.fromInventory() ? this.bedrockSlot(transfer.destination()) : transfer.destination();
+                final BedrockItem target = to.getItem(destination);
+                actions.add(new ItemStackRequestAction.PlaceAction(transfer.amount(),
+                        from.requestSlotInfo(source, from.getItem(source).netId()),
+                        to.requestSlotInfo(destination, target.isEmpty() ? 0 : target.netId())));
+            }
+            final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+            final ItemStackRequestInfo request = new ItemStackRequestInfo(requests.nextRequestId(), actions,
+                    List.of(), TextProcessingEventOrigin.unknown);
+            requests.addRequest(new InventoryRequestStorage(request, 0, inventory.getHudContainer().copy(),
+                    List.of(this.copy(), player.copy())));
+            player.setItems(plan.inventory());
+            this.setItem(4, plan.inputs()[0]);
+            this.setItem(5, plan.inputs()[1]);
+            PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[]{request});
+            if (plan.repeat()) {
+                requests.queueButtonClick(this, button);
+            }
+        }
+        PacketFactory.sendJavaContainerSetContent(this.user, this);
+        return true;
+    }
+
+    private boolean takeResult(final int revision, final byte button, final ContainerInput action) {
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE
+                || action == ContainerInput.PICKUP && button != 0 || this.pendingTrade != null) {
+            return false;
+        }
+        final TradeOffer offer = this.selectedOffer();
+        if (offer == null) {
+            return false;
+        }
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final Container target = action == ContainerInput.QUICK_MOVE ? inventory.getInventoryContainer() : inventory.getHudContainer();
+        final int maximum = this.user.get(ItemRewriter.class).maxStackSize(offer.result());
+        final int destination = action == ContainerInput.QUICK_MOVE ? this.resultDestination(target, offer.result(), maximum) : 0;
+        if (destination < 0) {
+            return false;
+        }
+        final BedrockItem current = target.getItem(destination);
+        if (!current.isEmpty() && (current.isDifferent(offer.result()) || current.netId() == null)) {
+            return false;
+        }
+        final int available = offer.crafts(this.items[0], this.items[1], this.tier);
+        final int capacity = (maximum - current.amount()) / offer.result().amount();
+        final int crafts = Math.min(Math.min(available, capacity), action == ContainerInput.QUICK_MOVE ? 255 : 1);
+        if (crafts <= 0 || this.items[0].netId() == null || offer.second() != null && this.items[1].netId() == null) {
+            return false;
+        }
+
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final List<ItemStackRequestAction> actions = this.resultActions(offer, crafts, requestId,
+                target.requestSlotInfo(destination, current.isEmpty() ? 0 : current.netId()));
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId, actions, List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, revision, inventory.getHudContainer().copy(),
+                action == ContainerInput.QUICK_MOVE ? List.of(this.copy(), target.copy()) : List.of(this.copy())));
+        this.trackResultRequest(requestId, offer, crafts, revision, action == ContainerInput.QUICK_MOVE);
+        this.setItem(4, this.itemAfterRemovingAmount(this.items[0], offer.first().item().amount() * crafts));
+        if (offer.second() != null) {
+            this.setItem(5, this.itemAfterRemovingAmount(this.items[1], offer.second().item().amount() * crafts));
+        }
+        final BedrockItem placed = current.isEmpty() ? offer.result().copy() : current.copy();
+        placed.setAmount(current.amount() + offer.result().amount() * crafts);
+        target.setItem(destination, placed);
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[]{request});
+        return true;
+    }
+
+    public List<ItemStackRequestAction> resultActions(final TradeOffer offer, final int crafts, final int requestId,
+                                                     final ItemStackRequestSlotInfo destination) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeAction(offer.networkId(), crafts));
+        actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(offer.result().copy()), crafts));
+        actions.add(new ItemStackRequestAction.ConsumeAction(offer.first().item().amount() * crafts,
+                this.requestSlotInfo(4, this.items[0].netId())));
+        if (offer.second() != null) {
+            actions.add(new ItemStackRequestAction.ConsumeAction(offer.second().item().amount() * crafts,
+                    this.requestSlotInfo(5, this.items[1].netId())));
+        }
+        actions.add(new ItemStackRequestAction.PlaceAction(offer.result().amount() * crafts,
+                new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                        (byte) 50, requestId), destination));
+        return List.copyOf(actions);
+    }
+
+    void trackResultRequest(final int requestId, final TradeOffer offer, final int crafts,
+                            final int revision, final boolean quickMove) {
+        this.pendingTrade = new PendingTrade(requestId, offer.networkId(), crafts, this.offerRevision, revision, quickMove);
+    }
+
+    public boolean handleResponse(final int requestId, final boolean success) {
+        super.handleResponse(requestId, success);
+        final PendingTrade pending = this.pendingTrade;
+        if (pending == null || pending.requestId() != requestId) {
+            return false;
+        }
+        this.pendingTrade = null;
+        final boolean changed = success && pending.offerRevision() == this.offerRevision;
+        if (changed) {
+            this.offers = this.offers.stream().map(offer -> offer.networkId() == pending.networkId()
+                    ? offer.used(pending.crafts()) : offer).toList();
+        }
+        this.refreshOutput();
+        if (success && pending.quickMove() && !this.isClosing()) {
+            this.user.get(InventoryRequestTracker.class).queueMerchantResult(this, pending.networkId(), pending.javaRevision());
+        }
+        return changed;
+    }
+
+    public boolean continueQuickMove(final int networkId, final int revision) {
+        final TradeOffer offer = this.selectedOffer();
+        if (offer != null && offer.networkId() == networkId) {
+            this.takeResult(revision, (byte) 0, ContainerInput.QUICK_MOVE);
+        }
+        // Exhausted stock, full inventory, or a changed selection ends the
+        // continuation without discarding subsequent user interactions.
+        return true;
+    }
+
+    private int resultDestination(final Container inventory, final BedrockItem result, final int maximum) {
+        for (final boolean merge : new boolean[]{true, false}) {
+            for (int slot = 0; slot < inventory.size(); slot++) {
+                final BedrockItem item = inventory.getItem(slot);
+                if (merge ? !item.isEmpty() && !item.isDifferent(result) && item.netId() != null
+                        && maximum - item.amount() >= result.amount() : item.isEmpty()) {
+                    return slot;
+                }
+            }
+        }
+        return -1;
+    }
+
+    public TradeOffer selectedOffer() {
+        return this.offers.isEmpty() ? null : this.offers.get(this.selected);
+    }
+
+    public long traderId() {
+        return this.traderId;
+    }
+
+    public List<TradeOffer> offers() {
+        return this.offers;
+    }
+
+    public int tier() {
+        return this.tier;
+    }
+
+    public int experience() {
+        return this.experience;
+    }
+
+    public boolean economy() {
+        return this.economy;
+    }
+
+    private record PendingTrade(int requestId, int networkId, int crafts, long offerRevision, int javaRevision, boolean quickMove) {
+    }
+
+}
