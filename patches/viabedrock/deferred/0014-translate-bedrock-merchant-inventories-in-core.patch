+        final var bytes = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(bytes);
+            assertEquals(0, Types.VAR_INT.read(bytes));
+            assertEquals(24, VersionedTypes.V26_3.itemCost.read(bytes).amount());
+            assertEquals(3, VersionedTypes.V26_3.item.read(bytes).identifier());
+            assertNull(VersionedTypes.V26_3.optionalItemCost.read(bytes));
+            assertTrue(bytes.readBoolean());
+            assertEquals(0, bytes.readInt());
+            assertEquals(16, bytes.readInt());
+            assertEquals(2, bytes.readInt());
+            assertEquals(-8, bytes.readInt());
