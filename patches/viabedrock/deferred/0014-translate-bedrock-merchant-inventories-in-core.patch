+            assertEquals(2, update.containerId());
+            assertEquals(ContainerType.TRADE, update.type());
+            assertEquals(1, update.tier());
+            assertEquals(-8589934485L, update.traderId());
+            assertEquals(-1L, update.playerId());
+            assertTrue(update.newTradeUi());
+            assertTrue(update.economy());
+            assertEquals(offers, update.data());
+            assertEquals(0, bytes.readableBytes());
+        } finally {
+            bytes.release();
+        }
+    }
