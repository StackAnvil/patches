+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.TradeOffer;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class InventoryPlacementTest {
+
+    @Test
+    void returnsAnOldInputIntoExistingStacksBeforeFillingTheNextOffer() {
+        final BedrockItem[] inputs = {stack(2, 40, 11), BedrockItem.empty()};
+        final BedrockItem[] inventory = {stack(2, 50, 12), BedrockItem.empty(), stack(1, 64, 13)};
+        final var plan = InventoryPlacement.plan(offer(24, null), inputs, inventory, item -> 64);
+        assertNotNull(plan);
+        assertTrue(plan.repeat());
+        assertEquals(2, plan.transfers().size());
+        assertEquals(14, plan.transfers().get(0).amount());
+        assertEquals(26, plan.transfers().get(1).amount());
+        assertEquals(64, plan.inventory()[0].amount());
+        assertEquals(26, plan.inventory()[1].amount());
+        assertTrue(plan.inputs()[0].isEmpty());
+        assertEquals(40, inputs[0].amount());
+        assertEquals(50, inventory[0].amount());
+    }
+
+    @Test
+    void refusesToClearInputsWhenThereIsNoInventoryCapacity() {
+        final BedrockItem[] inputs = {stack(2, 40, 11), BedrockItem.empty()};
+        final BedrockItem[] inventory = {stack(2, 64, 12), stack(1, 64, 13)};
+        assertNull(InventoryPlacement.plan(offer(24, null), inputs, inventory, item -> 64));
+        assertEquals(40, inputs[0].amount());
+    }
+
+    @Test
+    void combinesSeveralSourceStacksAcrossAcknowledgedRequests() {
+        final BedrockItem[] inputs = BedrockItem.emptyArray(2);
+        final BedrockItem[] inventory = {stack(1, 16, 10), stack(1, 20, 11), stack(1, 12, 12)};
+        final var first = InventoryPlacement.plan(offer(24, null), inputs, inventory, item -> 64);
+        assertNotNull(first);
+        assertEquals(20, first.inputs()[0].amount());
+        assertTrue(first.repeat());
+        first.inputs()[0].setNetId(15); // A split stack receives its authoritative ID.
+        final var second = InventoryPlacement.plan(offer(24, null), first.inputs(), first.inventory(), item -> 64);
+        assertEquals(36, second.inputs()[0].amount());
+        assertTrue(second.repeat());
+        final var third = InventoryPlacement.plan(offer(24, null), second.inputs(), second.inventory(), item -> 64);
+        assertEquals(48, third.inputs()[0].amount());
+        assertFalse(third.repeat());
+        assertEquals(2, offer(24, null).crafts(third.inputs()[0], third.inputs()[1], 0));
+    }
+
+    @Test
+    void allocatesOneSharedSourceBetweenBothTradeIngredients() {
+        final var second = new TradeOffer.Ingredient(new BedrockItem(1), true, 1);
+        final var plan = InventoryPlacement.plan(offer(1, second), BedrockItem.emptyArray(2),
+                new BedrockItem[]{stack(1, 20, 10)}, item -> 64);
+        assertNotNull(plan);
+        assertEquals(10, plan.inputs()[0].amount());
+        assertEquals(10, plan.inputs()[1].amount());
+        assertTrue(plan.inventory()[0].isEmpty());
+        assertFalse(plan.repeat());
+    }
+
+    @Test
+    void doesNotMergeDifferentDamageVariantsIntoTheSameInput() {
+        final BedrockItem existing = stack(1, 24, 10);
+        existing.setData(1);
+        final var plan = InventoryPlacement.plan(offer(24, null), new BedrockItem[]{existing, BedrockItem.empty()},
+                new BedrockItem[]{stack(1, 64, 11)}, item -> 64);
+        assertNotNull(plan);
+        assertTrue(plan.transfers().isEmpty());
+        assertEquals(24, plan.inputs()[0].amount());
+    }
+
+    @Test
+    void fillsNativeInputCapacityEvenWhenThePriceDoesNotDivideTheStack() {
+        for (final int count : new int[]{5, 64}) {
+            final var plan = InventoryPlacement.plan(offer(24, null), BedrockItem.emptyArray(2),
+                    new BedrockItem[]{stack(1, count, 10)}, item -> 64);
+            assertNotNull(plan);
+            assertEquals(count, plan.inputs()[0].amount());
+            assertTrue(plan.inventory()[0].isEmpty());
+            assertFalse(plan.repeat());
+        }
+    }
+
+    @Test
+    void closingReturnsWhatFitsAndDropsOnlyTheOverflow() {
+        final BedrockItem input = stack(2, 40, 11);
+        final BedrockItem[] inventory = {stack(2, 50, 12), stack(1, 64, 13)};
+        final var returned = InventoryPlacement.returnInput(input, inventory, item -> 64, true);
+        assertNotNull(returned);
+        assertEquals(14, returned.transfers().get(0).amount());
+        assertEquals(26, returned.dropped());
+        assertEquals(64, returned.inventory()[0].amount());
+        assertEquals(50, inventory[0].amount());
+        assertEquals(40, input.amount());
+        assertNull(InventoryPlacement.returnInput(input, inventory, item -> 64, false));
+    }
+
+    @Test
+    void closingSplitsAcrossDestinationsWithoutUsingUnconfirmedStacks() {
+        final BedrockItem input = stack(2, 40, 11);
+        final BedrockItem[] inventory = {stack(2, 50, 12), BedrockItem.empty()};
+        final var returned = InventoryPlacement.returnInput(input, inventory, item -> 64, true);
+        assertNotNull(returned);
+        assertEquals(2, returned.transfers().size());
+        assertEquals(26, returned.inventory()[1].amount());
+        assertEquals(0, returned.dropped());
+        input.setNetId(null);
+        assertNull(InventoryPlacement.returnInput(input, inventory, item -> 64, true));
+    }
+
+    private static TradeOffer offer(final int firstCount, final TradeOffer.Ingredient second) {
+        final var first = new TradeOffer.Ingredient(new BedrockItem(1, (short) 0, (byte) firstCount), true, firstCount);
+        return new TradeOffer(4925, 0, first, second, new BedrockItem(3), 0, 16, 2);
+    }
+
+    private static BedrockItem stack(final int id, final int amount, final int networkId) {
+        return new BedrockItem(id, (short) 0, (byte) amount, null, new String[0], new String[0], 0, 0, networkId);
+    }
+
+}
