+        assertEquals(0, merchant.javaSlot(4));
+        assertEquals(1, merchant.javaSlot(5));
+        assertEquals(50, merchant.bedrockSlot(2));
+        assertEquals(ContainerEnumName.Trade2Ingredient1Container, merchant.getFullContainerName(4).name());
+        assertFalse(merchant.ownsBedrockSlot(new FullContainerName(ContainerEnumName.Trade2Ingredient2Container, null), 4));
+        assertEquals(3, merchant.getItem(50).identifier());
+
+        final var target = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CombinedHotbarAndInventoryContainer, null),
