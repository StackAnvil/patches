+            assertEquals(10, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(12, bytes.readUnsignedByte());
+            assertEquals(4925, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(2, bytes.readUnsignedByte());
+            assertEquals(17, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(19, bytes.readUnsignedByte());
+            assertEquals(1, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(1, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(1, bytes.readUnsignedByte());
+            assertEquals("minecraft:emerald", BedrockTypes.STRING.read(bytes));
+            assertEquals(0, BedrockTypes.VAR_INT.read(bytes));
+            assertEquals(1, bytes.readUnsignedShortLE());
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            final int length = BedrockTypes.UNSIGNED_VAR_INT.read(bytes);
+            bytes.skipBytes(length);
+            assertEquals(2, bytes.readUnsignedByte());
+            assertEquals(5, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(5, bytes.readUnsignedByte());
+            assertEquals(48, bytes.readUnsignedByte());
+            final var consumed = InventoryTypes.ITEM_STACK_REQUEST_SLOT.read(bytes);
+            assertEquals(ContainerEnumName.Trade2Ingredient1Container, consumed.container().name());
+            assertEquals(4, consumed.slot());
+            assertEquals(14, consumed.stackNetworkId());
+            assertEquals(1, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(1, bytes.readUnsignedByte());
+            assertEquals(2, bytes.readUnsignedByte());
+            final var source = InventoryTypes.ITEM_STACK_REQUEST_SLOT.read(bytes);
+            assertEquals(ContainerEnumName.CreatedOutputContainer, source.container().name());
+            assertEquals(50, source.slot());
+            assertEquals(-5, source.stackNetworkId());
+            assertEquals(target, InventoryTypes.ITEM_STACK_REQUEST_SLOT.read(bytes));
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(bytes));
+            assertEquals(-1, bytes.readIntLE());
+            assertEquals(0, bytes.readableBytes());
+        } finally {
+            bytes.release();
+        }
+    }
