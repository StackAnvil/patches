+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.Tag;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+public record TradeOffer(int networkId, int tier, Ingredient first, Ingredient second,
+                         BedrockItem result, int uses, int maxUses, int experience) {
+
+    public static List<TradeOffer> read(final CompoundTag data,
+                                       final Function<CompoundTag, BedrockItem> decoder) {
+        final var recipes = data.getListTag("Recipes", CompoundTag.class);
+        if (recipes == null || recipes.size() > 1024) {
+            throw new IllegalArgumentException("Invalid trade recipe list");
+        }
+        final List<TradeOffer> offers = new ArrayList<>(recipes.size());
+        for (final CompoundTag recipe : recipes) {
+            final Ingredient first = ingredient(recipe.getCompoundTag("buyA"), recipe.getInt("buyCountA"), decoder);
+            final Ingredient second = ingredient(recipe.getCompoundTag("buyB"), recipe.getInt("buyCountB"), decoder);
+            final CompoundTag resultTag = recipe.getCompoundTag("sell");
+            if (first == null || resultTag == null) {
+                throw new IllegalArgumentException("Trade has no cost or result");
+            }
+            final BedrockItem result = decoder.apply(resultTag);
+            final int networkId = recipe.getInt("netId");
+            if (result.isEmpty() || networkId == 0) {
+                throw new IllegalArgumentException("Trade has an invalid result or recipe ID");
+            }
+            result.setData(resultTag.getShort("Damage"));
+            offers.add(new TradeOffer(networkId, Math.max(0, recipe.getInt("tier")), first, second,
+                    result, Math.max(0, recipe.getInt("uses")), Math.max(0, recipe.getInt("maxUses")),
+                    Math.max(0, recipe.getInt("traderExp"))));
+        }
+        return List.copyOf(offers);
+    }
+
+    private static Ingredient ingredient(final CompoundTag tag, final int baseCount,
+                                         final Function<CompoundTag, BedrockItem> decoder) {
+        if (tag == null) {
+            return null;
+        }
+        final BedrockItem item = decoder.apply(tag);
+        if (item.isEmpty()) {
+            throw new IllegalArgumentException("Trade has an invalid ingredient");
+        }
+        final short damage = tag.getShort("Damage");
+        final boolean wildcard = damage == Short.MAX_VALUE;
+        item.setData(wildcard ? 0 : damage);
+        return new Ingredient(item, wildcard, baseCount > 0 ? baseCount : item.amount());
+    }
+
+    public boolean available(final int traderTier) {
+        return this.tier <= traderTier && this.uses < this.maxUses;
+    }
+
+    public TradeOffer used(final int count) {
+        return new TradeOffer(this.networkId, this.tier, this.first, this.second, this.result,
+                (int) Math.min(this.maxUses, (long) this.uses + count), this.maxUses, this.experience);
+    }
+
+    public int crafts(final BedrockItem firstItem, final BedrockItem secondItem, final int traderTier) {
+        if (!this.available(traderTier) || !this.first.matches(firstItem)
+                || (this.second == null ? !secondItem.isEmpty() : !this.second.matches(secondItem))) {
+            return 0;
+        }
+        final int firstCrafts = firstItem.amount() / this.first.item.amount();
+        final int secondCrafts = this.second == null ? Integer.MAX_VALUE : secondItem.amount() / this.second.item.amount();
+        return Math.min(this.maxUses - this.uses, Math.min(firstCrafts, secondCrafts));
+    }
+
+    public record Ingredient(BedrockItem item, boolean wildcardDamage, int baseCount) {
+
+        public boolean matches(final BedrockItem candidate) {
+            return !candidate.isEmpty() && candidate.identifier() == this.item.identifier()
+                    && (this.wildcardDamage || candidate.data() == this.item.data())
+                    && (this.item.blockRuntimeId() == 0 || candidate.blockRuntimeId() == this.item.blockRuntimeId())
+                    && includes(candidate.tag(), this.item.tag());
+        }
+
+        private static boolean includes(final CompoundTag actual, final CompoundTag required) {
+            if (required == null || required.isEmpty()) {
+                return true;
+            }
+            if (actual == null) {
+                return false;
+            }
+            for (final var entry : required.entrySet()) {
+                final Tag value = actual.get(entry.getKey());
+                if (entry.getValue() instanceof CompoundTag nested) {
+                    if (!(value instanceof CompoundTag compound) || !includes(compound, nested)) {
+                        return false;
+                    }
+                } else if (!entry.getValue().equals(value)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+    }
+
+}
