+            BedrockTypes.VAR_LONG.write(bytes, -8589934485L);
+            BedrockTypes.VAR_LONG.write(bytes, -1L);
+            BedrockTypes.STRING.write(bytes, "entity.villager.librarian");
+            bytes.writeBoolean(true);
+            bytes.writeBoolean(true);
