@@ -0,0 +1,169 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.TradeOffer;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.ToIntFunction;
+
+public final class InventoryPlacement {
+
+    private InventoryPlacement() {
+    }
+
+    public static Plan plan(final TradeOffer offer, final BedrockItem[] inputs,
+                            final BedrockItem[] inventory, final ToIntFunction<BedrockItem> maxStack) {
+        final BedrockItem[] nextInputs = copy(inputs);
+        final BedrockItem[] nextInventory = copy(inventory);
+        final List<Transfer> transfers = new ArrayList<>();
+        for (int input = 0; input < 2; input++) {
+            final TradeOffer.Ingredient ingredient = input == 0 ? offer.first() : offer.second();
+            final BedrockItem item = inputs[input];
+            if (!item.isEmpty() && item.netId() == null) {
+                return null;
+            }
+            if (item.isEmpty() || ingredient != null && ingredient.matches(item)) {
+                continue;
+            }
+            final ReturnedInput returned = returnInput(item, inventory, maxStack, false);
+            if (returned == null) {
+                return null;
+            }
+            for (final ReturnTransfer transfer : returned.transfers()) {
+                transfers.add(new Transfer(false, input, transfer.destination(), transfer.amount()));
+            }
+            nextInputs[input] = BedrockItem.empty();
+            // Wait for authoritative IDs before returning another input into
+            // a destination that this request has just created.
+            return new Plan(List.copyOf(transfers), nextInputs, returned.inventory(), true);
+        }
+
+        final int limit = Math.min(255, Math.max(0, offer.maxUses() - offer.uses()));
+        int crafts = limit;
+        final int[] targets = new int[2];
+        for (int input = 0; input < 2; input++) {
+            final TradeOffer.Ingredient ingredient = input == 0 ? offer.first() : offer.second();
+            if (ingredient == null) {
+                continue;
+            }
+            int available = inputs[input].amount();
+            for (final BedrockItem item : inventory) {
+                if (item.netId() != null && matchesInto(ingredient, item, inputs[input])) {
+                    available += item.amount();
+                }
+            }
+            targets[input] = Math.min(available, maxStack.applyAsInt(ingredient.item()));
+            crafts = Math.min(crafts, available / ingredient.item().amount());
+            crafts = Math.min(crafts, maxStack.applyAsInt(ingredient.item()) / ingredient.item().amount());
+        }
+        if (offer.second() != null && offer.first().matches(offer.second().item())
+                && offer.second().matches(offer.first().item())) {
+            int shared = inputs[0].amount() + inputs[1].amount();
+            for (final BedrockItem item : inventory) {
+                if (item.netId() != null && offer.first().matches(item)) {
+                    shared += item.amount();
+                }
+            }
+            crafts = Math.min(crafts, shared / (offer.first().item().amount() + offer.second().item().amount()));
+            targets[0] = Math.max(inputs[0].amount(), crafts * offer.first().item().amount());
+            targets[1] = Math.max(inputs[1].amount(), crafts * offer.second().item().amount());
+        }
+
+        boolean repeat = false;
+        // Fill the more constrained ingredient first when only it requires NBT.
+        final int[] order = offer.second() != null && offer.second().item().tag() != null
+                && offer.first().item().tag() == null ? new int[]{1, 0} : new int[]{0, 1};
+        for (final int input : order) {
+            final TradeOffer.Ingredient ingredient = input == 0 ? offer.first() : offer.second();
+            if (ingredient == null) {
+                continue;
+            }
+            final int required = targets[input];
+            final int missing = required - nextInputs[input].amount();
+            if (missing <= 0) {
+                continue;
+            }
+            int source = -1;
+            for (int slot = 0; slot < nextInventory.length; slot++) {
+                final BedrockItem item = nextInventory[slot];
+                if (item.netId() != null && matchesInto(ingredient, item, nextInputs[input])
+                        && (source < 0 || item.amount() > nextInventory[source].amount())) {
+                    source = slot;
+                }
+            }
+            if (source < 0) {
+                continue;
+            }
+            final BedrockItem item = nextInventory[source];
+            final int amount = Math.min(missing, item.amount());
+            transfers.add(new Transfer(true, source, input, amount));
+            final BedrockItem placed = nextInputs[input].isEmpty() ? item.copy() : nextInputs[input].copy();
+            placed.setAmount(nextInputs[input].amount() + amount);
+            nextInputs[input] = placed;
+            nextInventory[source] = remaining(item, amount);
+            repeat |= amount < missing;
+        }
+        return new Plan(List.copyOf(transfers), nextInputs, nextInventory, repeat);
+    }
+
+    public static ReturnedInput returnInput(final BedrockItem item, final BedrockItem[] inventory,
+                                           final ToIntFunction<BedrockItem> maxStack, final boolean dropOverflow) {
+        if (item.netId() == null) {
+            return null;
+        }
+        final BedrockItem[] next = copy(inventory);
+        final List<ReturnTransfer> transfers = new ArrayList<>();
+        int remaining = item.amount();
+        for (final boolean merge : new boolean[]{true, false}) {
+            for (int slot = 0; slot < next.length && remaining > 0; slot++) {
+                final BedrockItem target = next[slot];
+                if (merge ? target.isEmpty() || target.isDifferent(item) || target.netId() == null : !target.isEmpty()) {
+                    continue;
+                }
+                final int amount = Math.min(remaining, maxStack.applyAsInt(item) - target.amount());
+                if (amount <= 0) {
+                    continue;
+                }
+                transfers.add(new ReturnTransfer(slot, amount));
+                final BedrockItem placed = target.isEmpty() ? item.copy() : target.copy();
+                placed.setAmount(target.amount() + amount);
+                next[slot] = placed;
+                remaining -= amount;
+            }
+        }
+        return remaining > 0 && !dropOverflow ? null : new ReturnedInput(List.copyOf(transfers), next, remaining);
+    }
+
+    private static boolean matchesInto(final TradeOffer.Ingredient ingredient,
+                                       final BedrockItem item, final BedrockItem target) {
+        return ingredient.matches(item) && (target.isEmpty() || !target.isDifferent(item));
+    }
+
+    private static BedrockItem[] copy(final BedrockItem[] items) {
+        return Arrays.stream(items).map(BedrockItem::copy).toArray(BedrockItem[]::new);
+    }
+
+    private static BedrockItem remaining(final BedrockItem item, final int amount) {
+        final BedrockItem copy = item.copy();
+        copy.setAmount(item.amount() - amount);
+        return copy.isEmpty() ? BedrockItem.empty() : copy;
+    }
+
+    public record ReturnTransfer(int destination, int amount) { }
+
+    public record ReturnedInput(List<ReturnTransfer> transfers, BedrockItem[] inventory, int dropped) { }
+
+    public record Transfer(boolean fromInventory, int source, int destination, int amount) {
+    }
+
+    public record Plan(List<Transfer> transfers, BedrockItem[] inputs, BedrockItem[] inventory, boolean repeat) {
+    }
+
+}
