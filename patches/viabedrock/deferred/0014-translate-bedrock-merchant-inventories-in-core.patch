+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ServerboundPackets26_3;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.container.entity.MerchantContainer;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.api.util.TextUtil;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.TradeOffer;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.List;
+import java.util.function.Function;
+import java.util.logging.Level;
+
+public final class TradePackets {
+
+    private TradePackets() {
+    }
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.UPDATE_TRADE, ClientboundPackets26_3.OPEN_SCREEN, wrapper -> {
+            final Update update = Update.read(wrapper);
+            final InventoryTracker inventory = wrapper.user().get(InventoryTracker.class);
+            final EntityTracker entities = wrapper.user().get(EntityTracker.class);
+            final Entity actor = entities.getEntityByUid(update.traderId());
+            final MerchantContainer current = inventory.getCurrentContainer() instanceof MerchantContainer merchant ? merchant : null;
+            if (current != null && current.isClosing()) {
+                wrapper.cancel();
+                return;
+            }
+            if (update.type() != ContainerType.TRADE || actor == null
+                    || update.playerId() != -1 && update.playerId() != entities.getClientPlayer().uniqueId()
+                    || current == null && inventory.isAnyScreenOpen()
+                    || current != null && (current.containerId() != update.containerId() || current.traderId() != update.traderId())) {
+                wrapper.cancel();
+                PacketFactory.sendBedrockContainerClose(wrapper.user(), update.containerId(), ContainerType.NONE);
+                return;
+            }
+            final List<TradeOffer> offers;
+            try {
+                offers = TradeOffer.read(update.data(), tag -> readItem(wrapper.user(), tag));
+            } catch (final IllegalArgumentException exception) {
+                ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Could not read Bedrock trade offers", exception);
+                wrapper.cancel();
+                PacketFactory.sendBedrockContainerClose(wrapper.user(), update.containerId(), ContainerType.NONE);
+                return;
+            }
+            final MerchantContainer merchant;
+            if (current != null) {
+                merchant = current;
+                merchant.replaceOffers(update.tier(), offers);
+            } else {
+                merchant = new MerchantContainer(wrapper.user(), update.containerId(),
+                        TextUtil.stringToTextComponent(wrapper.user().get(ResourcePackStorage.class)
+                                .getTexts().translate(update.title())), update.traderId(), update.newTradeUi(),
+                        update.economy(), update.tier(), offers);
+                inventory.setCurrentContainer(merchant);
+                wrapper.write(Types.VAR_INT, Byte.toUnsignedInt(merchant.javaContainerId()));
+                wrapper.write(Types.VAR_INT, BedrockProtocol.MAPPINGS.getJavaMenuId("minecraft:merchant"));
+                wrapper.write(Types.TAG, TextUtil.textComponentToNbt(merchant.title()));
+                wrapper.send(BedrockProtocol.class);
+            }
+            wrapper.cancel();
+            merchant.updateActorState(actor);
+            sendOffers(wrapper.user(), merchant);
+            PacketFactory.sendJavaContainerSetContent(wrapper.user(), merchant);
+        });
+        protocol.registerServerbound(ServerboundPackets26_3.SELECT_TRADE, null, wrapper -> {
+            wrapper.cancel();
+            final int selection = wrapper.read(Types.VAR_INT);
+            final InventoryTracker inventory = wrapper.user().get(InventoryTracker.class);
+            if (!(inventory.getCurrentContainer() instanceof MerchantContainer merchant)
+                    || merchant.isClosing() || inventory.getPendingCloseContainer() != null) {
+                return;
+            }
+            final InventoryRequestTracker requests = wrapper.user().get(InventoryRequestTracker.class);
+            if (requests.isRecoveringLegacyOffhand()) {
+                return;
+            }
+            if (requests.hasPending() || requests.isWaitingForLegacyOffhand()) {
+                requests.queueButtonClick(merchant, selection);
+            } else if (!merchant.handleButtonClick(selection)) {
+                PacketFactory.sendJavaContainerSetContent(wrapper.user(), merchant);
+            }
+        });
+    }
+
+    private static BedrockItem readItem(final UserConnection user, final CompoundTag tag) {
+        final BedrockItem item = user.get(ItemRewriter.class).bedrockItemStack(tag);
+        final CompoundTag block = tag.getCompoundTag("Block");
+        if (block != null) {
+            item.setBlockRuntimeId(user.get(BlockStateRewriter.class).bedrockId(block));
+        }
+        return item;
+    }
+
+    public static void sendOffers(final UserConnection user, final MerchantContainer merchant) {
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.MERCHANT_OFFERS, user);
+        packet.write(Types.VAR_INT, Byte.toUnsignedInt(merchant.javaContainerId()));
+        packet.write(Types.VAR_INT, merchant.offers().size());
+        for (final TradeOffer offer : merchant.offers()) {
+            writeOffer(packet, offer, merchant.tier(), user.get(ItemRewriter.class)::javaItem);
+        }
+        packet.write(Types.VAR_INT, merchant.economy() ? merchant.tier() + 1 : 0);
+        packet.write(Types.VAR_INT, merchant.experience());
+        packet.write(Types.BOOLEAN, merchant.economy());
+        packet.write(Types.BOOLEAN, merchant.economy());
+        packet.send(BedrockProtocol.class);
+    }
+
+    static void writeOffer(final PacketWrapper packet, final TradeOffer offer, final int tier,
+                           final Function<BedrockItem, Item> convert) {
+        final BedrockItem baseCost = offer.first().item().copy();
+        baseCost.setAmount(offer.first().baseCount());
+        packet.write(VersionedTypes.V26_3.itemCost, convert.apply(baseCost));
+        packet.write(VersionedTypes.V26_3.item, convert.apply(offer.result()));
+        // Java supports a price modifier only for the first cost. Keep the native
+        // resolved amount for a discounted second ingredient.
+        packet.write(VersionedTypes.V26_3.optionalItemCost,
+                offer.second() == null ? null : convert.apply(offer.second().item()));
+        packet.write(Types.BOOLEAN, !offer.available(tier));
+        packet.write(Types.INT, offer.uses());
+        packet.write(Types.INT, offer.maxUses());
+        packet.write(Types.INT, offer.experience());
+        packet.write(Types.INT, offer.first().item().amount() - offer.first().baseCount());
+        packet.write(Types.FLOAT, 0F);
+        packet.write(Types.INT, 0);
+    }
+
+    record Update(byte containerId, ContainerType type, int tier, long traderId, long playerId,
+                  String title, boolean newTradeUi, boolean economy, CompoundTag data) {
+
+        static Update read(final PacketWrapper wrapper) {
+            final byte id = wrapper.read(Types.BYTE);
+            final ContainerType type = ContainerType.getByValue(wrapper.read(Types.UNSIGNED_BYTE));
+            wrapper.read(BedrockTypes.VAR_INT); // legacy size, zero for native economy trades
+            final int tier = wrapper.read(BedrockTypes.VAR_INT);
+            final long trader = wrapper.read(BedrockTypes.VAR_LONG);
+            final long player = wrapper.read(BedrockTypes.VAR_LONG);
+            final String title = wrapper.read(BedrockTypes.STRING);
+            final boolean newUi = wrapper.read(Types.BOOLEAN);
+            final boolean economy = wrapper.read(Types.BOOLEAN);
+            final var tag = wrapper.read(BedrockTypes.NETWORK_TAG);
+            if (!(tag instanceof CompoundTag compound)) {
+                throw new IllegalArgumentException("Trade data is not a compound");
+            }
+            return new Update(id, type, tier, trader, player, title, newUi, economy, compound);
+        }
+    }
+
+}
