+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class TradeOfferTest {
+
+    @Test
+    void decodesDiscountedCostsWildcardDamageAndTaggedResults() {
+        final CompoundTag first = item((byte) 16, Short.MAX_VALUE);
+        final CompoundTag second = item((byte) 1, (short) 3);
+        final CompoundTag result = item((byte) 1, (short) 5);
+        final CompoundTag enchant = new CompoundTag();
+        enchant.putShort("id", (short) 39);
+        enchant.putShort("lvl", (short) 3);
+        final CompoundTag resultData = new CompoundTag();
+        resultData.put("ench", new ListTag<>(List.of(enchant)));
+        result.put("tag", resultData);
+        final CompoundTag recipe = new CompoundTag();
+        recipe.put("buyA", first);
+        recipe.putInt("buyCountA", 24);
+        recipe.put("buyB", second);
+        recipe.putInt("buyCountB", 2);
+        recipe.put("sell", result);
+        recipe.putInt("netId", 4925);
+        recipe.putInt("tier", 1);
+        recipe.putInt("uses", 2);
+        recipe.putInt("maxUses", 16);
+        recipe.putInt("traderExp", 2);
+        final CompoundTag root = new CompoundTag();
+        root.put("Recipes", new ListTag<>(List.of(recipe)));
+
+        final TradeOffer offer = TradeOffer.read(root, tag -> new BedrockItem(9, (short) 0,
+                tag.getByte("Count"), tag.getCompoundTag("tag"))).get(0);
+
+        assertEquals(16, offer.first().item().amount());
+        assertEquals(24, offer.first().baseCount());
+        assertTrue(offer.first().wildcardDamage());
+        assertEquals(0, offer.first().item().data());
+        assertEquals(3, offer.second().item().data());
+        assertEquals(5, offer.result().data());
+        assertEquals(resultData, offer.result().tag());
+        assertFalse(offer.available(0));
+        assertTrue(offer.available(1));
+        assertFalse(offer.used(14).available(1));
+        assertEquals(16, offer.used(Integer.MAX_VALUE).uses());
+    }
+
+    @Test
+    void matchesRequiredTagsWithoutRejectingAdditionalItemData() {
+        final CompoundTag required = new CompoundTag();
+        final CompoundTag display = new CompoundTag();
+        display.putString("Name", "Trade name");
+        required.put("display", display);
+        final var ingredient = new TradeOffer.Ingredient(new BedrockItem(7, (short) 2, (byte) 4, required), true, 4);
+        final CompoundTag actual = required.copy();
+        actual.putInt("RepairCost", 2);
+        final BedrockItem stack = new BedrockItem(7, (short) 20, (byte) 8, actual);
+        assertTrue(ingredient.matches(stack));
+        stack.tag().getCompoundTag("display").putString("Name", "Different");
+        assertFalse(ingredient.matches(stack));
+        assertFalse(ingredient.matches(new BedrockItem(8, (short) 0, (byte) 8)));
+    }
+
+    @Test
+    void capsCraftsByBothIngredientsStockAndUnlockedTier() {
+        final var first = new TradeOffer.Ingredient(new BedrockItem(1, (short) 0, (byte) 16), true, 24);
+        final var second = new TradeOffer.Ingredient(new BedrockItem(2), false, 1);
+        final TradeOffer offer = new TradeOffer(7, 1, first, second, new BedrockItem(3), 2, 5, 10);
+        assertEquals(2, offer.crafts(new BedrockItem(1, (short) 5, (byte) 64), new BedrockItem(2, (short) 0, (byte) 2), 1));
+        assertEquals(3, offer.crafts(new BedrockItem(1, (short) 0, (byte) 64), new BedrockItem(2, (short) 0, (byte) 64), 1));
+        assertEquals(0, offer.crafts(new BedrockItem(1, (short) 0, (byte) 64), BedrockItem.empty(), 1));
+        assertEquals(0, offer.crafts(new BedrockItem(1, (short) 0, (byte) 64), new BedrockItem(2), 0));
+    }
+
+    private static CompoundTag item(final byte count, final short damage) {
+        final CompoundTag tag = new CompoundTag();
+        tag.putByte("Count", count);
+        tag.putShort("Damage", damage);
+        return tag;
+    }
+
+}
