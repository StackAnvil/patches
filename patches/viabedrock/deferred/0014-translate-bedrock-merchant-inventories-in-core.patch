+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.TextProcessingEventOrigin;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Returns temporary inputs and the cursor before acknowledging a screen close. */
+public abstract class InputContainer extends Container {
+
+    private boolean closing;
+    private boolean closeQueued;
+    private Integer closingRequestId;
+
+    protected InputContainer(final UserConnection user, final byte containerId, final ContainerType type,
+                             final TextComponent title, final BlockPosition position, final int size,
+                             final String... validBlockTags) {
+        super(user, containerId, type, title, position, size, validBlockTags);
+    }
+
+    protected abstract int[] inputSlots();
+
+    public boolean handleResponse(final int requestId, final boolean success) {
+        if (this.closingRequestId != null && this.closingRequestId == requestId) {
+            this.closingRequestId = null;
+            if (success) {
+                this.queueClose();
+            } else {
+                BedrockProtocol.kickForIllegalState(this.user, "Container items could not be returned. Reconnect to synchronize your inventory.");
+            }
+            return false;
+        }
+        if (this.closing && !success) {
+            this.closeQueued = false; // A rejected request clears the interaction queue.
+            this.queueClose();
+        }
+        return false;
+    }
+
+    public void beginClose() {
+        if (this.closing) {
+            return;
+        }
+        this.closing = true;
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        requests.clearQueuedScreenInteractions();
+        if (requests.hasPending() || requests.isWaitingForLegacyOffhand()) {
+            this.queueClose();
+        } else {
+            this.handleClose();
+        }
+    }
+
+    private void queueClose() {
+        if (!this.closeQueued) {
+            this.closeQueued = this.user.get(InventoryRequestTracker.class).queueContainerClose(this);
+        }
+    }
+
+    public boolean handleClose() {
+        this.closeQueued = false;
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final Container player = inventory.getInventoryContainer();
+        final int[] inputs = this.inputSlots();
+        for (int index = 0; index <= inputs.length; index++) {
+            final Container source = index == inputs.length ? inventory.getHudContainer() : this;
+            final int slot = index == inputs.length ? 0 : inputs[index];
+            final BedrockItem item = source.getItem(slot);
+            if (item.isEmpty()) {
+                continue;
+            }
+            final InventoryPlacement.ReturnedInput returned = InventoryPlacement.returnInput(item, player.getItems(),
+                    this.user.get(ItemRewriter.class)::maxStackSize, true);
+            if (returned == null) {
+                BedrockProtocol.kickForIllegalState(this.user, "Container items could not be synchronized. Reconnect to refresh your inventory.");
+                return true;
+            }
+            final List<ItemStackRequestAction> actions = new ArrayList<>();
+            for (final InventoryPlacement.ReturnTransfer transfer : returned.transfers()) {
+                final BedrockItem destination = player.getItem(transfer.destination());
+                actions.add(new ItemStackRequestAction.PlaceAction(transfer.amount(), source.requestSlotInfo(slot, item.netId()),
+                        player.requestSlotInfo(transfer.destination(), destination.isEmpty() ? 0 : destination.netId())));
+            }
+            if (returned.dropped() > 0) {
+                actions.add(new ItemStackRequestAction.DropAction(returned.dropped(), source.requestSlotInfo(slot, item.netId()), false));
+            }
+            final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+            final ItemStackRequestInfo request = new ItemStackRequestInfo(requests.nextRequestId(), actions, List.of(), TextProcessingEventOrigin.unknown);
+            requests.addRequest(new InventoryRequestStorage(request, 0, inventory.getHudContainer().copy(), List.of(this.copy(), player.copy())));
+            this.closingRequestId = request.requestId();
+            player.setItems(returned.inventory());
+            source.setItem(slot, BedrockItem.empty());
+            PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[]{request});
+            return true;
+        }
+        inventory.markPendingClose(this);
+        PacketFactory.sendBedrockContainerClose(this.user, this.containerId, ContainerType.NONE);
+        return true;
+    }
+
+    public boolean isClosing() {
+        return this.closing;
+    }
+
+}
