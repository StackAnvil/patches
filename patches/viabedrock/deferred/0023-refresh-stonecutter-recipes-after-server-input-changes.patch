From bd1aad14419153ef0a591eeda8d606856b0eb4d6 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 13:41:39 +0200
Subject: [PATCH] fix(stonecutter): refresh recipes after server input changes

Stonecutter input can change through authoritative Bedrock slot or content updates after a click or rollback. Rebuild the Java preview from that input and keep recipe button indices aligned with the recipes advertised to the Java client, even when an input stack has too few items.
---
 .../container/block/StonecutterContainer.java | 27 +++++++++----------
 .../protocol/packet/InventoryPackets.java     | 10 +++++++
 2 files changed, 23 insertions(+), 14 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/block/StonecutterContainer.java b/src/main/java/net/raphimc/viabedrock/api/model/container/block/StonecutterContainer.java
index 4938719ec..914672b96 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/container/block/StonecutterContainer.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/container/block/StonecutterContainer.java
@@ -99,8 +99,7 @@ public final class StonecutterContainer extends Container {
         if (javaSlot != 1) {
             final boolean handled = super.handleClick(revision, javaSlot, button, action);
             if (handled && javaSlot == 0) {
-                this.updateRecipes();
-                this.refreshOutput();
+                this.refreshInput();
             }
             return handled;
         }
@@ -169,8 +168,7 @@ public final class StonecutterContainer extends Container {
         } else {
             inventory.getHudContainer().setItem(0, result.copy());
         }
-        this.updateRecipes();
-        this.refreshOutput();
+        this.refreshInput();
         PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
         return true;
     }
@@ -186,6 +184,11 @@ public final class StonecutterContainer extends Container {
         return true;
     }
 
+    public void refreshInput() {
+        this.updateRecipes();
+        this.refreshOutput();
+    }
+
     private void updateRecipes() {
         final BedrockItem input = this.getItem(3);
         final List<CraftingDataStorage> matches = new ArrayList<>();
@@ -196,8 +199,7 @@ public final class StonecutterContainer extends Container {
                     || recipe.getResults().isEmpty()) {
                 continue;
             }
-            if (recipe.getIngredients().get(0).matchesItem(this.user, input)
-                    && input.amount() >= recipe.getIngredients().get(0).amount()) {
+            if (recipe.getIngredients().get(0).matchesItem(this.user, input)) {
                 matches.add(data);
             }
         }
@@ -208,14 +210,11 @@ public final class StonecutterContainer extends Container {
     }
 
     private void refreshOutput() {
-        final BedrockItem result =
-                this.availableRecipes.isEmpty()
-                        ? BedrockItem.empty()
-                        : ((ShapelessRecipe)
-                                        this.availableRecipes.get(this.selectedRecipe).recipe())
-                                .getResults()
-                                .get(0)
-                                .copy();
+        final BedrockItem input = this.getItem(3);
+        final ShapelessRecipe recipe = this.availableRecipes.isEmpty() ? null
+                : (ShapelessRecipe) this.availableRecipes.get(this.selectedRecipe).recipe();
+        final BedrockItem result = recipe == null || input.amount() < recipe.getIngredients().get(0).amount()
+                ? BedrockItem.empty() : recipe.getResults().get(0).copy();
         this.setItem(50, result);
         PacketFactory.sendJavaContainerSetContent(this.user, this);
     }
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
index 4141ff340..108a8faa0 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
@@ -528,6 +528,11 @@ public final class InventoryPackets {
                         if (container.type() == ContainerType.HUD) {
                             inventoryTracker.getInventoryContainer().updateCraftingOutput();
                         }
+                        if (container instanceof StonecutterContainer stonecutter) {
+                            stonecutter.refreshInput();
+                            wrapper.cancel();
+                            return;
+                        }
                         PacketFactory.writeJavaContainerSetContent(wrapper, container);
                         PacketFactory.sendJavaCursorForHudUpdate(wrapper.user(), container);
                     } else {
@@ -577,6 +582,11 @@ public final class InventoryPackets {
                             wrapper.cancel();
                             return;
                         }
+                        if (container instanceof StonecutterContainer stonecutter && slot == 3) {
+                            stonecutter.refreshInput();
+                            wrapper.cancel();
+                            return;
+                        }
                         final boolean bundleOnCursor = container instanceof BundleContainer bundle
                                 && bundle.javaHoldingContainer() == inventoryTracker.getHudContainer()
                                 && bundle.javaSlot(slot) == 0;
-- 
2.56.0
