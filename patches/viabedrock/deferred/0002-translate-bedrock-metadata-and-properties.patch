+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.UUID;
+
+/** Separate picking geometry; physical actor dimensions are not changed. */
+public sealed interface NativeActorPickingMessage permits NativeActorPickingMessage.Snapshot, NativeActorPickingMessage.Remove {
+
+    String CHANNEL = "viabedrock:actor_picking";
+    int MAX_PAYLOAD_BYTES = 32 + NativeActorHitboxes.MAX_BOXES * 32 + 16;
+    Type<NativeActorPickingMessage> TYPE = new Type<>(NativeActorPickingMessage.class) {
+        @Override
+        public NativeActorPickingMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native actor picking state");
+            }
+            final int kind = buffer.readUnsignedByte();
+            final UUID owner = Types.UUID.read(buffer);
+            final UUID lifetime = Types.UUID.read(buffer);
+            final NativeActorPickingMessage message;
+            if (kind == 0) {
+                final int count = Types.VAR_INT.readPrimitive(buffer);
+                if (count < 0 || count > NativeActorHitboxes.MAX_BOXES) {
+                    throw new IllegalArgumentException("Invalid native picking part count");
+                }
+                final var parts = new ArrayList<Part>(count);
+                for (int i = 0; i < count; i++) {
+                    parts.add(new Part(Types.UUID.read(buffer), buffer.readFloat(), buffer.readFloat(), buffer.readFloat()));
+                }
+                message = new Snapshot(owner, lifetime, parts);
+            } else if (kind == 1) {
+                message = new Remove(owner, lifetime);
+            } else {
+                throw new IllegalArgumentException("Unknown native picking message");
+            }
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native picking data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeActorPickingMessage message) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(message instanceof Snapshot ? 0 : 1);
+            Types.UUID.write(buffer, message.owner());
+            Types.UUID.write(buffer, message.lifetime());
+            if (message instanceof Snapshot snapshot) {
+                Types.VAR_INT.writePrimitive(buffer, snapshot.parts().size());
+                for (Part part : snapshot.parts()) {
+                    Types.UUID.write(buffer, part.proxy());
+                    buffer.writeFloat(part.widthX()).writeFloat(part.height()).writeFloat(part.widthZ());
+                }
+            }
+        }
+    };
+
+    UUID owner();
+
+    UUID lifetime();
+
+    record Part(UUID proxy, float widthX, float height, float widthZ) {
+        public Part {
+            java.util.Objects.requireNonNull(proxy);
+            for (float dimension : new float[]{widthX, height, widthZ}) {
+                if (!Float.isFinite(dimension) || dimension < 0F || dimension >= 2E9F) {
+                    throw new IllegalArgumentException("Invalid native picking dimension");
+                }
+            }
+        }
+    }
+
+    record Snapshot(UUID owner, UUID lifetime, List<Part> parts) implements NativeActorPickingMessage {
+        public Snapshot {
+            java.util.Objects.requireNonNull(owner);
+            java.util.Objects.requireNonNull(lifetime);
+            parts = List.copyOf(parts);
+            final var ids = new HashSet<UUID>();
+            if (parts.size() > NativeActorHitboxes.MAX_BOXES) {
+                throw new IllegalArgumentException("Too many native picking parts");
+            }
+            for (Part part : parts) {
+                if (part.proxy().equals(owner) || !ids.add(part.proxy())) {
+                    throw new IllegalArgumentException("Invalid native picking proxy identity");
+                }
+            }
+        }
+    }
+
+    record Remove(UUID owner, UUID lifetime) implements NativeActorPickingMessage {
+        public Remove {
+            java.util.Objects.requireNonNull(owner);
+            java.util.Objects.requireNonNull(lifetime);
+        }
+    }
+
+}
