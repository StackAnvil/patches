+            final PacketWrapper packet = new PacketWrapperImpl((PacketType) args[0], (ByteBuf) args[1], (UserConnection) args[2]);
+            return proxy(PacketWrapper.class, (wrapper, operation, values) -> {
+                if (operation.getName().equals("send")) {
+                    if (packet.getPacketType() == ClientboundPackets26_3.SET_PLAYER_TEAM) {
+                        this.teamPackets.add(packet);
+                    }
+                    return null;
