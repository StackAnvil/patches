+                            final int flagsIndex = entity.getJavaEntityDataIndex(EntityDataFields.FLAGS);
+                            javaEntityData.removeIf(data -> data.id() == flagsIndex);
+                            javaEntityData.add(new EntityData(flagsIndex, VersionedTypes.V26_3.entityDataTypes().byteType, bitmask));
+                        } else {
+                            ViaBedrock.getPlatform().getLogger().warning("Received has_nectar property for non-BEE entity " + entity.type());
+                        }
+                    }
+                    default -> ViaBedrock.getPlatform().getLogger().warning("Received boolean property " + booleanProperty.identifier() + " for entity " + entity.type() + " with value " + value);
+                }
+            } else if (property instanceof EntityProperty.IntProperty integerProperty) {
+                ViaBedrock.getPlatform().getLogger().fine("Ignoring int property " + integerProperty.identifier() + " for entity " + entity.type());
+            } else if (property instanceof EntityProperty.EnumProperty enumProperty) {
+                if (i < 0 || i >= enumProperty.possibleValues().size()) {
+                    ViaBedrock.getPlatform().getLogger().warning("Received invalid value " + i + " for enum property " + enumProperty.identifier() + " on entity " + entity.type());
+                    continue;
+                }
+                final String value = enumProperty.possibleValues().get(i);
+
+                switch (enumProperty.identifier()) {
