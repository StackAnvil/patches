+        final Tag first = updateName(green, "§pA");
+        assertEquals(0x8AD22C, component(first).getStyle().getColor().getRgbValue());
+        assertEquals(0x3366CC, component(updateName(other, "§pA")).getStyle().getColor().getRgbValue());
