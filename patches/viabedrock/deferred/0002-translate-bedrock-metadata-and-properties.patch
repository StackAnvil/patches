+    static int cushionColor(final int bedrockVariant) {
+        // Bedrock's cushion render controller orders dyes black to white. Java's
+        // DyeColor metadata uses white to black, so the indexes are reversed.
+        return bedrockVariant >= 0 && bedrockVariant < 16 ? 15 - bedrockVariant : -1;
+    }
