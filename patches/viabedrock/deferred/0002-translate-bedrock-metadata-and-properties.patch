+    private static int registryIndex(final CompoundTag registry, final String name) {
+        if (registry == null) {
+            return -1;
+        }
+
+        int index = 0;
+        for (String key : registry.keySet()) {
+            if (key.equals(name)) {
+                return index;
+            }
+            index++;
+        }
+        return -1;
+    }
