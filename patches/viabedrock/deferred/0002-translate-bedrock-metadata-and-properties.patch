+    private static ResourcePackStorage palette(final double r, final double g, final double b) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final JsonArray rgb = new JsonArray();
+        rgb.add(r);
+        rgb.add(g);
+        rgb.add(b);
+        final JsonObject variables = new JsonObject();
+        variables.add("$material_gold_color", rgb);
+        content.putJson("ui/_global_variables.json", variables);
+        return new ResourcePackStorage(List.of(new ResourcePack(content)));
+    }
+
+    private static Entity actor(final boolean player, final ResourcePackStorage packs) {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> method.getName().equals("get")
+                        && args[0] == ResourcePackStorage.class ? packs : null);
+        return player ? new PlayerEntity(user, 2, 3, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0))
+                : new Entity(user, 1, 2, "example:actor", 3, UUID.randomUUID(), EntityTypes26_3.INTERACTION);
+    }
+
+    private static Tag updateName(final Entity actor, final String name) {
+        final List<EntityData> data = new ArrayList<>();
+        actor.updateEntityData(new EntityData[]{new EntityData(4, EntityDataTypesBedrock.STRING, name)}, data);
+        return data.stream().filter(value -> value.id() == FIELDS.indexOf(EntityDataFields.CUSTOM_NAME))
+                .findFirst().orElseThrow().value();
+    }
+
+    private static TextComponent component(final Tag tag) {
+        return ProtocolConstants.JAVA_TEXT_COMPONENT_SERIALIZER.deserializeNbtTree(tag);
+    }
+
+    private static List<TextComponent> parts(final TextComponent component) {
+        final List<TextComponent> parts = new ArrayList<>();
+        TextUtils.iterateAll(component, part -> {
+            if (!part.asSingleString().isEmpty()) {
+                parts.add(part);
+            }
+        });
+        return parts;
+    }
+
+    private void replaceMapping(final String name, final Object value) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.oldMappings.put(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, value);
+    }
+
+}
