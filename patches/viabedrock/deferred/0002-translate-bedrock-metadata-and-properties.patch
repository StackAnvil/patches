+        update(actor, dimension(ActorDataIds.RESERVED_054, Float.NaN));
+        assertTrue(actor.boundingBoxDimensions().height().isEmpty());
+        update(actor, dimension(ActorDataIds.RESERVED_053, -1F));
+        assertTrue(actor.boundingBoxDimensions().width().isEmpty());
+    }
+
+    private static EntityData dimension(final ActorDataIds id, final float value) {
+        return new EntityData(id.getValue(), EntityDataTypesBedrock.FLOAT, value);
+    }
+
+    private static Entity actor(final EntityTypes26_3 type) {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> {
+                    if (method.getName().equals("get")) {
+                        return null;
+                    }
+                    throw new AssertionError("Unexpected connection operation: " + method.getName());
+                });
+        return new Entity(user, 1, 2, type.identifier(), 3, null, type);
+    }
+
+    private static List<EntityData> update(final Entity actor, final EntityData... data) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(data, result);
+        return result;
+    }
+
+    private static EntityData scale(final float scale) {
+        return new EntityData(ActorDataIds.RESERVED_038.getValue(), EntityDataTypesBedrock.FLOAT, scale);
+    }
+
+    private static EntityData flags(final long flags) {
+        return new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, flags);
+    }
+
+    private static byte sharedFlags(final List<EntityData> data) {
+        return (byte) value(data, EntityDataFields.SHARED_FLAGS);
+    }
+
+    private static Object value(final List<EntityData> data, final String field) {
+        return data.stream().filter(entry -> entry.id() == FIELDS.indexOf(field)).findFirst().orElseThrow().getValue();
+    }
+
+}
