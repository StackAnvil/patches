+        assertTrue(sparse.stream().noneMatch(data -> data.id() == FIELDS.indexOf(EntityDataFields.CUSTOM_NAME)));
+        assertEquals(0x8AD22C, component(updateName(green, "§pB")).getStyle().getColor().getRgbValue());
+        assertEquals(0x8AD22C, component(first).getStyle().getColor().getRgbValue());
+        assertNull(updateName(green, ""));
+        assertEquals(0xDEB12D, component(updateName(actor(false, null), "§pA")).getStyle().getColor().getRgbValue());
+    }
