+        field.set(BedrockProtocol.MAPPINGS, replacement);
+    }
+
+    @Test
+    void retainsIndependentSparseBoundingBoxDimensionsAndPublishesInteractionMetadata() {
+        final Entity actor = actor(EntityTypes26_3.INTERACTION);
+        final List<EntityData> initial = update(actor, dimension(ActorDataIds.RESERVED_053, 0F), dimension(ActorDataIds.RESERVED_054, 2F));
