+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerCrawlingPoseTest {
+
+    private static final List<String> FIELDS = List.of(EntityDataFields.SHARED_FLAGS, EntityDataFields.SILENT,
+            EntityDataFields.NO_GRAVITY, EntityDataFields.LIVING_ENTITY_FLAGS, EntityDataFields.POSE);
+    private final Map<Field, Object> previousMappings = new HashMap<>();
+
+    @BeforeAll
+    static void initializeTypes() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+    }
+
+    @BeforeEach
+    void installMappings() throws Exception {
+        this.replaceMapping("bedrockEntityDataTypes", Map.of());
+        this.replaceMapping("javaEntityDataFields", Map.of(EntityTypes26_3.PLAYER, FIELDS));
+    }
+
+    @AfterEach
+    void restoreMappings() throws Exception {
+        for (final var entry : this.previousMappings.entrySet()) {
+            entry.getKey().set(BedrockProtocol.MAPPINGS, entry.getValue());
+        }
+    }
+
+    @Test
+    void retainsShortBodyAfterSwimmingStopsWithoutAdvertisingSwimming() {
+        final PlayerEntity player = player();
+        update(player, flags(ActorDataIds.RESERVED_0, ActorFlags.SWIMMING, ActorFlags.SPRINTING));
+        final List<EntityData> crawling = update(player, flags(ActorDataIds.RESERVED_0),
+                flags(ActorDataIds.RESERVED_092, ActorFlags.CRAWLING));
+        assertEquals(3, value(crawling, EntityDataFields.POSE));
+        assertEquals((byte) 0, value(crawling, EntityDataFields.SHARED_FLAGS));
+        assertTrue(player.entityFlags().contains(ActorFlags.CRAWLING));
+        assertFalse(player.entityFlags().contains(ActorFlags.SWIMMING));
+
+        final List<EntityData> sparse = update(player, flags(ActorDataIds.RESERVED_0, ActorFlags.ONFIRE));
+        assertEquals(3, value(sparse, EntityDataFields.POSE));
+        assertEquals((byte) 1, value(sparse, EntityDataFields.SHARED_FLAGS));
+        assertTrue(player.entityFlags().contains(ActorFlags.CRAWLING));
+    }
+
+    @Test
+    void resumesSwimmingForBothFlagWordOrdersWithoutDuplicatePoseMetadata() {
+        for (final boolean lowWordFirst : new boolean[]{false, true}) {
+            final PlayerEntity player = player();
+            update(player, flags(ActorDataIds.RESERVED_092, ActorFlags.CRAWLING));
+            final EntityData low = flags(ActorDataIds.RESERVED_0, ActorFlags.SWIMMING, ActorFlags.SPRINTING);
+            final EntityData high = flags(ActorDataIds.RESERVED_092);
+            final List<EntityData> result = lowWordFirst ? update(player, low, high) : update(player, high, low);
+            assertEquals(3, value(result, EntityDataFields.POSE));
+            assertEquals((byte) 24, value(result, EntityDataFields.SHARED_FLAGS));
+            assertEquals(1, result.stream().filter(data -> data.id() == FIELDS.indexOf(EntityDataFields.POSE)).count());
+            assertFalse(player.entityFlags().contains(ActorFlags.CRAWLING));
+        }
+    }
+
+    @Test
+    void restoresStandingSneakingAndGlidingWhenCrawlingEnds() {
+        final ActorFlags[][] lowFlags = {{}, {ActorFlags.SNEAKING}, {ActorFlags.GLIDING}};
+        final int[] poses = {0, 5, 1};
+        for (int i = 0; i < poses.length; i++) {
+            final PlayerEntity player = player();
+            update(player, flags(ActorDataIds.RESERVED_0, lowFlags[i]), flags(ActorDataIds.RESERVED_092, ActorFlags.CRAWLING));
+            assertEquals(poses[i], value(update(player, flags(ActorDataIds.RESERVED_092)), EntityDataFields.POSE));
+        }
+    }
+
+    private static PlayerEntity player() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> null);
+        return new PlayerEntity(user, 1, 1, new UUID(0, 1), new PlayerAbilities(1, (byte) 0, (byte) 0));
+    }
+
+    private static EntityData flags(final ActorDataIds word, final ActorFlags... flags) {
+        long mask = 0;
+        for (final ActorFlags flag : flags) {
+            final int bit = flag.getValue() - (word == ActorDataIds.RESERVED_092 ? Long.SIZE : 0);
+            assertTrue(bit >= 0 && bit < Long.SIZE);
+            mask |= 1L << bit;
+        }
+        return new EntityData(word.getValue(), EntityDataTypesBedrock.LONG, mask);
+    }
+
+    private static List<EntityData> update(final PlayerEntity player, final EntityData... data) {
+        final List<EntityData> result = new ArrayList<>();
+        player.updateEntityData(data, result);
+        return result;
+    }
+
+    private static Object value(final List<EntityData> data, final String field) {
+        return data.stream().filter(entry -> entry.id() == FIELDS.indexOf(field)).findFirst().orElseThrow().value();
+    }
+
+    private void replaceMapping(final String name, final Object replacement) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.previousMappings.put(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, replacement);
+    }
+
+}
