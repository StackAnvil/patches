+        super(user);
+    }
+
+    public void addEntity(final String entityId, final EntityPropertyList properties) {
+        this.entities.put(entityId, properties);
+    }
+
+    public boolean addFromTag(final Tag tag, final String fallbackType) {
+        if (!(tag instanceof CompoundTag definitions)) {
+            return false;
+        }
+        final String declaredType = definitions.getString("type");
+        final String type = declaredType != null ? declaredType : fallbackType;
+        if (type == null || type.isBlank()) {
+            return false;
+        }
+        final EntityPropertyList properties = EntityPropertyList.fromTag(definitions).orElse(null);
+        if (properties == null) {
+            return false;
+        }
+        this.addEntity(Key.namespaced(type), properties);
+        return true;
+    }
+
+    public EntityPropertyList getEntityProperties(final String entityId) {
+        return this.entities.get(entityId);
+    }
+
+}
