+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityBodyVisibilityTest {
+
+    private final Map<Field, Object> previousMappings = new HashMap<>();
+    private static final List<String> FIELDS = List.of(EntityDataFields.SHARED_FLAGS, EntityDataFields.SILENT,
+            EntityDataFields.NO_GRAVITY, EntityDataFields.LIVING_ENTITY_FLAGS,
+            EntityDataFields.CUSTOM_NAME, EntityDataFields.CUSTOM_NAME_VISIBLE, EntityDataFields.WIDTH, EntityDataFields.HEIGHT);
+
+    @BeforeAll
+    static void initializeStructuredDataKeys() throws Exception {
+        // ViaVersion's key/type initialization must start with the key registry.
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+    }
+
+    @BeforeEach
+    void installMetadataMappings() throws Exception {
+        this.replaceMapping("bedrockEntityDataTypes", Map.of());
+        this.replaceMapping("javaEntityDataFields", Map.of(EntityTypes26_3.INTERACTION, FIELDS, EntityTypes26_3.ARMOR_STAND, FIELDS, EntityTypes26_3.PLAYER, FIELDS));
+    }
+
+    @AfterEach
+    void restoreMetadataMappings() throws Exception {
+        for (final var entry : this.previousMappings.entrySet()) {
+            entry.getKey().set(BedrockProtocol.MAPPINGS, entry.getValue());
+        }
+    }
+
+    @Test
+    void hidesZeroScaleArmorStandBodyWithoutSuppressingItsAlwaysVisibleName() {
+        final Entity actor = actor(EntityTypes26_3.ARMOR_STAND);
+        final List<EntityData> result = update(actor, flags(0), scale(0),
+                new EntityData(ActorDataIds.NAME.getValue(), EntityDataTypesBedrock.STRING, "First line\nSecond line"),
+                new EntityData(ActorDataIds.NAMETAG_ALWAYS_SHOW.getValue(), EntityDataTypesBedrock.BYTE, (byte) 1));
+        assertEquals((byte) 32, sharedFlags(result));
+        assertNotNull(value(result, EntityDataFields.CUSTOM_NAME));
+        assertEquals(true, value(result, EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertFalse(actor.entityFlags().contains(ActorFlags.INVISIBLE));
+    }
+
+    @Test
+    void refreshesSparseScaleChangesAndRetainsUnrelatedNativeFlags() {
+        final Entity actor = actor(EntityTypes26_3.INTERACTION);
+        final long sprint = 1L << ActorFlags.SPRINTING.getValue();
+        assertEquals((byte) 8, sharedFlags(update(actor, flags(sprint))));
+        assertEquals((byte) 40, sharedFlags(update(actor, scale(0))));
+        assertEquals((byte) 40, sharedFlags(update(actor, flags(sprint))));
+        assertEquals((byte) 40, sharedFlags(update(actor, new EntityData(ActorDataIds.RESERVED_092.getValue(), EntityDataTypesBedrock.LONG, 0L))));
+        assertEquals((byte) 8, sharedFlags(update(actor, scale(2))));
+        assertEquals((byte) 8, EntityMetadataRewriter.sharedFlags(actor));
+    }
+
+    @Test
+    void preservesRealInvisibilityWhenScaleBecomesPositive() {
+        final Entity actor = actor(EntityTypes26_3.INTERACTION);
+        final long invisible = 1L << ActorFlags.INVISIBLE.getValue();
+        assertEquals((byte) 32, sharedFlags(update(actor, flags(invisible), scale(0))));
+        assertEquals((byte) 32, sharedFlags(update(actor, scale(1))));
+        assertEquals((byte) 0, sharedFlags(update(actor, flags(0))));
+    }
+
+    @Test
+    void usesFinalVisibilityForBothMetadataOrdersAndEmitsOneSharedFlagsValue() {
+        for (final boolean flagsFirst : new boolean[]{true, false}) {
+            final Entity actor = actor(EntityTypes26_3.INTERACTION);
+            update(actor, scale(0));
+            final EntityData flag = flags(1L << ActorFlags.SNEAKING.getValue());
+            final List<EntityData> result = flagsFirst ? update(actor, flag, scale(3)) : update(actor, scale(3), flag);
+            assertEquals((byte) 2, sharedFlags(result));
+            assertEquals(1, result.stream().filter(data -> data.id() == 0).count());
+        }
+    }
+
+    @Test
+    void leavesNonzeroAndNegativeScaleVisibilityUnchanged() {
+        final Entity actor = actor(EntityTypes26_3.INTERACTION);
+        for (final float scale : new float[]{1, 0.5F, -2}) {
+            assertEquals((byte) 0, sharedFlags(update(actor, scale(scale))));
+        }
+    }
+
+    @Test
+    void keepsBlankNamesHiddenForBothMetadataOrders() {
+        for (final boolean nameFirst : new boolean[]{true, false}) {
+            final Entity actor = actor(EntityTypes26_3.ARMOR_STAND);
+            final List<EntityData> result = nameFirst ? update(actor, name(""), alwaysShow(true))
+                    : update(actor, alwaysShow(true), name(""));
+            assertNull(value(result, EntityDataFields.CUSTOM_NAME));
+            assertEquals(false, value(result, EntityDataFields.CUSTOM_NAME_VISIBLE));
+            assertEquals(1, result.stream().filter(data -> data.id() == FIELDS.indexOf(EntityDataFields.CUSTOM_NAME_VISIBLE)).count());
+
+            final List<EntityData> named = nameFirst ? update(actor, name("Label"), alwaysShow(true))
+                    : update(actor, alwaysShow(true), name("Label"));
+            assertNotNull(value(named, EntityDataFields.CUSTOM_NAME));
+            assertEquals(true, value(named, EntityDataFields.CUSTOM_NAME_VISIBLE));
+            assertEquals(1, named.stream().filter(data -> data.id() == FIELDS.indexOf(EntityDataFields.CUSTOM_NAME_VISIBLE)).count());
+        }
+    }
+
+    @Test
+    void recomputesVisibilityForSparseNameAndAlwaysShowUpdates() {
+        final Entity actor = actor(EntityTypes26_3.ARMOR_STAND);
+        assertEquals(false, value(update(actor, alwaysShow(true)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(true, value(update(actor, name("Label")), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        final List<EntityData> cleared = update(actor, name(""));
+        assertNull(value(cleared, EntityDataFields.CUSTOM_NAME));
+        assertEquals(false, value(cleared, EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(false, value(update(actor, alwaysShow(true)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(true, value(update(actor, name("Restored")), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(false, value(update(actor, alwaysShow(false)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(false, value(update(actor, name("Replacement")), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(true, value(update(actor, alwaysShow(true)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+    }
+
+    @Test
+    void preservesPlayerProfileNameVisibilityWithoutCustomMetadata() {
+        final Entity player = actor(EntityTypes26_3.PLAYER);
+        assertEquals(true, value(update(player, alwaysShow(true)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+        final List<EntityData> cleared = update(player, name(""));
+        assertNull(value(cleared, EntityDataFields.CUSTOM_NAME));
+        assertEquals(true, value(cleared, EntityDataFields.CUSTOM_NAME_VISIBLE));
+        assertEquals(false, value(update(player, alwaysShow(false)), EntityDataFields.CUSTOM_NAME_VISIBLE));
+    }
+
+    private static EntityData name(final String name) {
+        return new EntityData(ActorDataIds.NAME.getValue(), EntityDataTypesBedrock.STRING, name);
+    }
+
+    private static EntityData alwaysShow(final boolean show) {
+        return new EntityData(ActorDataIds.NAMETAG_ALWAYS_SHOW.getValue(), EntityDataTypesBedrock.BYTE, (byte) (show ? 1 : 0));
+    }
+
+    private void replaceMapping(final String name, final Object replacement) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.previousMappings.put(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, replacement);
+    }
+
+    @Test
+    void retainsIndependentSparseBoundingBoxDimensionsAndPublishesInteractionMetadata() {
+        final Entity actor = actor(EntityTypes26_3.INTERACTION);
+        final List<EntityData> initial = update(actor, dimension(ActorDataIds.RESERVED_053, 0F), dimension(ActorDataIds.RESERVED_054, 2F));
+        final var before = actor.boundingBoxDimensions();
+        assertEquals(0.005F, before.width().orElseThrow());
+        assertEquals(2F, before.height().orElseThrow());
+        assertEquals(0.005F, value(initial, EntityDataFields.WIDTH));
+        assertEquals(2F, value(initial, EntityDataFields.HEIGHT));
+        final List<EntityData> sparse = update(actor, scale(1.9F), dimension(ActorDataIds.RESERVED_054, 2.9F));
+        assertEquals(0.005F, actor.boundingBoxDimensions().width().orElseThrow());
+        assertEquals(2.9F * 1.9F, actor.boundingBoxDimensions().height().orElseThrow());
+        assertEquals(2F, before.height().orElseThrow());
+        assertEquals(2.9F * 1.9F, value(sparse, EntityDataFields.HEIGHT));
+        assertEquals(0.005F, value(sparse, EntityDataFields.WIDTH));
+    }
+
+    @Test
+    void recomputesScaledBoundsOncePerFieldRegardlessOfMetadataOrder() {
+        for (boolean scaleFirst : new boolean[]{false, true}) {
+            final Entity actor = actor(EntityTypes26_3.INTERACTION);
+            final EntityData[] metadata = scaleFirst
+                    ? new EntityData[]{scale(1.75F), dimension(ActorDataIds.RESERVED_053, 0.6F), dimension(ActorDataIds.RESERVED_054, 2F)}
+                    : new EntityData[]{dimension(ActorDataIds.RESERVED_053, 0.6F), dimension(ActorDataIds.RESERVED_054, 2F), scale(1.75F)};
+            final List<EntityData> initial = update(actor, metadata);
+            assertEquals(1.05F, ((Number) value(initial, EntityDataFields.WIDTH)).floatValue(), 0.000001F);
+            assertEquals(3.5F, value(initial, EntityDataFields.HEIGHT));
+            assertEquals(1, initial.stream().filter(entry -> entry.id() == FIELDS.indexOf(EntityDataFields.HEIGHT)).count());
+            final List<EntityData> sparse = update(actor, scale(0F));
+            assertEquals(0.005F, value(sparse, EntityDataFields.WIDTH));
+            assertEquals(0.005F, value(sparse, EntityDataFields.HEIGHT));
+            assertEquals(2F, ((Number) actor.entityData().get(ActorDataIds.RESERVED_054).value()).floatValue());
+        }
+    }
+
+    @Test
+    void keepsMissingAndInvalidDimensionsDistinctFromZeroAndPreservesOtherEntityTypes() {
+        final Entity actor = actor(EntityTypes26_3.PLAYER);
+        assertTrue(actor.boundingBoxDimensions().height().isEmpty());
+        final List<EntityData> result = update(actor, dimension(ActorDataIds.RESERVED_054, 0F));
+        assertEquals(0.005F, actor.boundingBoxDimensions().height().orElseThrow());
+        assertTrue(result.stream().noneMatch(entry -> entry.id() == FIELDS.indexOf(EntityDataFields.HEIGHT)));
+        update(actor, dimension(ActorDataIds.RESERVED_054, Float.NaN));
+        assertTrue(actor.boundingBoxDimensions().height().isEmpty());
+        update(actor, dimension(ActorDataIds.RESERVED_053, -1F));
+        assertTrue(actor.boundingBoxDimensions().width().isEmpty());
+    }
+
+    private static EntityData dimension(final ActorDataIds id, final float value) {
+        return new EntityData(id.getValue(), EntityDataTypesBedrock.FLOAT, value);
+    }
+
+    private static Entity actor(final EntityTypes26_3 type) {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> {
+                    if (method.getName().equals("get")) {
+                        return null;
+                    }
+                    throw new AssertionError("Unexpected connection operation: " + method.getName());
+                });
+        return new Entity(user, 1, 2, type.identifier(), 3, null, type);
+    }
+
+    private static List<EntityData> update(final Entity actor, final EntityData... data) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(data, result);
+        return result;
+    }
+
+    private static EntityData scale(final float scale) {
+        return new EntityData(ActorDataIds.RESERVED_038.getValue(), EntityDataTypesBedrock.FLOAT, scale);
+    }
+
+    private static EntityData flags(final long flags) {
+        return new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, flags);
+    }
+
+    private static byte sharedFlags(final List<EntityData> data) {
+        return (byte) value(data, EntityDataFields.SHARED_FLAGS);
+    }
+
+    private static Object value(final List<EntityData> data, final String field) {
+        return data.stream().filter(entry -> entry.id() == FIELDS.indexOf(field)).findFirst().orElseThrow().getValue();
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java
