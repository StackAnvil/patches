+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ArmorStandMarkerMetadataTest {
+
+    private static final List<String> FIELDS = List.of(EntityDataFields.CLIENT_FLAGS, EntityDataFields.HEAD_POSE,
+            EntityDataFields.BODY_POSE, EntityDataFields.LEFT_ARM_POSE, EntityDataFields.RIGHT_ARM_POSE,
+            EntityDataFields.LEFT_LEG_POSE, EntityDataFields.RIGHT_LEG_POSE, EntityDataFields.SHARED_FLAGS,
+            EntityDataFields.SILENT, EntityDataFields.NO_GRAVITY, EntityDataFields.LIVING_ENTITY_FLAGS);
+    private final Map<Field, Object> previousMappings = new HashMap<>();
+
+    @BeforeAll
+    static void initializeTypes() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+    }
+
+    @BeforeEach
+    void installMappings() throws Exception {
+        this.replaceMapping("bedrockEntityDataTypes", Map.of());
+        this.replaceMapping("javaEntityDataFields", Map.of(EntityTypes26_3.ARMOR_STAND, FIELDS));
+    }
+
+    @AfterEach
+    void restoreMappings() throws Exception {
+        for (final var entry : this.previousMappings.entrySet()) {
+            entry.getKey().set(BedrockProtocol.MAPPINGS, entry.getValue());
+        }
+    }
+
+    @Test
+    void mergesEmptyBoxAndPoseForEveryBatchOrderIntoOneFlagWord() {
+        final EntityData width = dimension(ActorDataIds.RESERVED_053, 0);
+        final EntityData height = dimension(ActorDataIds.RESERVED_054, 0);
+        final EntityData pose = pose();
+        for (final EntityData[] order : new EntityData[][]{
+                {width, height, pose}, {width, pose, height}, {height, width, pose},
+                {height, pose, width}, {pose, width, height}, {pose, height, width}}) {
+            final List<EntityData> result = update(actor("minecraft:armor_stand"), order);
+            assertEquals((byte) 0x14, clientFlags(result));
+            assertEquals(1, result.stream().filter(data -> data.id() == FIELDS.indexOf(EntityDataFields.CLIENT_FLAGS)).count());
+            assertTrue(result.stream().anyMatch(data -> data.id() == FIELDS.indexOf(EntityDataFields.HEAD_POSE)));
+        }
+    }
+
+    @Test
+    void retainsSparseDimensionsAndPoseAndClearsMarkerWhenEitherDimensionIsRestored() {
+        for (final boolean widthFirst : new boolean[]{true, false}) {
+            final Entity actor = actor("minecraft:armor_stand");
+            final ActorDataIds first = widthFirst ? ActorDataIds.RESERVED_053 : ActorDataIds.RESERVED_054;
+            final ActorDataIds second = widthFirst ? ActorDataIds.RESERVED_054 : ActorDataIds.RESERVED_053;
+            assertTrue(update(actor, dimension(first, 0)).isEmpty());
+            assertEquals((byte) 0x10, clientFlags(update(actor, dimension(second, 0))));
+            assertEquals((byte) 0x14, clientFlags(update(actor, pose())));
+            assertEquals((byte) 0x04, clientFlags(update(actor, dimension(first, 0.5F))));
+            assertEquals((byte) 0x14, clientFlags(update(actor, dimension(first, 0))));
+            assertEquals((byte) 0x04, clientFlags(update(actor, dimension(second, 2))));
+        }
+    }
+
+    @Test
+    void neverTreatsMissingInvalidOrNonzeroBaseDimensionsAsMarkers() {
+        for (final float value : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY, -1, 1}) {
+            final Entity actor = actor("minecraft:armor_stand");
+            assertTrue(update(actor, dimension(ActorDataIds.RESERVED_053, value)).isEmpty());
+            assertEquals((byte) 0, clientFlags(update(actor, dimension(ActorDataIds.RESERVED_054, 0))));
+            assertEquals((byte) 0x04, clientFlags(update(actor, pose())));
+        }
+        final Entity actor = actor("minecraft:armor_stand");
+        assertEquals((byte) 0x04, clientFlags(update(actor, pose())));
+        assertEquals((byte) 0x04, clientFlags(update(actor, dimension(ActorDataIds.RESERVED_053, 0), pose())));
+    }
+
+    @Test
+    void invalidSparseDimensionClearsPreviouslyDerivedMarkerWithoutClearingArms() {
+        final Entity actor = actor("minecraft:armor_stand");
+        assertEquals((byte) 0x14, clientFlags(update(actor, pose(), dimension(ActorDataIds.RESERVED_053, 0), dimension(ActorDataIds.RESERVED_054, 0))));
+        assertEquals((byte) 0x04, clientFlags(update(actor, dimension(ActorDataIds.RESERVED_054, Float.NaN))));
+        assertEquals((byte) 0x14, clientFlags(update(actor, dimension(ActorDataIds.RESERVED_054, 0))));
+    }
+
+    @Test
+    void keepsScaleZeroAndActualInvisibilityIndependentFromMarker() {
+        final Entity actor = actor("minecraft:armor_stand");
+        assertTrue(update(actor, scale()).stream().noneMatch(data -> data.id() == FIELDS.indexOf(EntityDataFields.CLIENT_FLAGS)));
+        final List<EntityData> collapsed = update(actor, dimension(ActorDataIds.RESERVED_053, 0.5F), dimension(ActorDataIds.RESERVED_054, 2), scale());
+        assertEquals((byte) 0, clientFlags(collapsed));
+        assertEquals((byte) 0x20, value(collapsed, EntityDataFields.SHARED_FLAGS));
+        assertFalse(actor.entityFlags().contains(ActorFlags.INVISIBLE));
+        final List<EntityData> marker = update(actor, flags(), dimension(ActorDataIds.RESERVED_053, 0), dimension(ActorDataIds.RESERVED_054, 0));
+        assertEquals((byte) 0x10, clientFlags(marker));
+        assertTrue(actor.entityFlags().contains(ActorFlags.INVISIBLE));
+        assertEquals((byte) 0x20, value(marker, EntityDataFields.SHARED_FLAGS));
+    }
+
+    @Test
+    void doesNotDeriveMarkerForOtherActorsTranslatedAsArmorStands() {
+        final Entity actor = actor("minecraft:tripod_camera");
+        assertTrue(update(actor, dimension(ActorDataIds.RESERVED_053, 0), dimension(ActorDataIds.RESERVED_054, 0)).isEmpty());
+        assertEquals((byte) 0x04, clientFlags(update(actor, pose())));
+    }
+
+    private static Entity actor(final String nativeType) {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                    if (method.getName().equals("get")) {
+                        return null;
+                    }
+                    throw new AssertionError("Unexpected connection operation: " + method.getName());
+                });
+        return new Entity(user, 1, 2, nativeType, 3, null, EntityTypes26_3.ARMOR_STAND);
+    }
+
+    private static List<EntityData> update(final Entity actor, final EntityData... data) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(data, result);
+        return result;
+    }
+
+    private static EntityData dimension(final ActorDataIds id, final float value) {
+        return new EntityData(id.getValue(), EntityDataTypesBedrock.FLOAT, value);
+    }
+
+    private static EntityData pose() {
+        return new EntityData(ActorDataIds.POSE_INDEX.getValue(), EntityDataTypesBedrock.BYTE, (byte) 0);
+    }
+
+    private static EntityData scale() {
+        return new EntityData(ActorDataIds.RESERVED_038.getValue(), EntityDataTypesBedrock.FLOAT, 0F);
+    }
+
+    private static EntityData flags() {
+        return new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, 1L << ActorFlags.INVISIBLE.getValue());
+    }
+
+    private static byte clientFlags(final List<EntityData> data) {
+        return (byte) value(data, EntityDataFields.CLIENT_FLAGS);
+    }
+
+    private static Object value(final List<EntityData> data, final String field) {
+        return data.stream().filter(entry -> entry.id() == FIELDS.indexOf(field)).findFirst().orElseThrow().value();
+    }
+
+    private void replaceMapping(final String name, final Object value) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.previousMappings.put(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, value);
+    }
+
+}
