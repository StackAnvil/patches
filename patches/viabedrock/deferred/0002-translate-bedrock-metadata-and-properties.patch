+            final List<TextComponent> parts = parts(component);
+            assertEquals(3, parts.size());
+            assertEquals(0x55FF55, parts.get(0).getStyle().getColor().getRgbValue());
+            assertEquals(0x8AD22C, parts.get(1).getStyle().getColor().getRgbValue());
+            assertTrue(parts.get(0).getStyle().isBold());
+            assertTrue(parts.get(1).getStyle().isBold());
+            assertFalse(parts.get(parts.size() - 1).getStyle().isBold());
+        }
+    }
