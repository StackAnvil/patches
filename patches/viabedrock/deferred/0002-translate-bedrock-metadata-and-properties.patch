+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2IntOpenHashMap;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import net.raphimc.viabedrock.api.util.MoLangEngine;
+import net.raphimc.viabedrock.protocol.model.EntityProperties;
+import net.raphimc.viabedrock.protocol.model.entity.EntityProperty;
+import net.raphimc.viabedrock.protocol.model.entity.EntityPropertyList;
+import org.junit.jupiter.api.Test;
+import team.unnamed.mocha.runtime.Scope;
+import team.unnamed.mocha.runtime.value.MutableObjectBinding;
+
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityPropertyRenderTest {
+
+    private static final EntityPropertyList DEFINITIONS = new EntityPropertyList(List.of(
+        new EntityProperty.BooleanProperty("example:show_hat"),
+        new EntityProperty.IntProperty("example:hat", 0, 10),
+        new EntityProperty.EnumProperty("example:color", List.of("red", "blue"))
+    ), List.of(new EntityProperty.FloatProperty("example:size", 0, 2)));
+
+    @Test
+    void retainsTypedSparseUpdatesAndImmutableSnapshots() {
+        final Entity actor = new Entity(null, 1, 2, "example:actor", 3, UUID.randomUUID(), EntityTypes26_3.INTERACTION);
+        actor.retainEntityProperties(DEFINITIONS.resolveValues(values(Map.of(0, 1, 1, 2, 2, 1), Map.of(0, 1.5F))));
+        final Map<String, Object> snapshot = actor.entityProperties();
+        assertEquals(Map.of("example:show_hat", true, "example:hat", 2, "example:color", "blue", "example:size", 1.5F), snapshot);
+        assertThrows(UnsupportedOperationException.class, () -> snapshot.put("example:hat", 5));
+
+        actor.retainEntityProperties(DEFINITIONS.resolveValues(values(Map.of(0, 0), Map.of())));
+        assertEquals(false, actor.entityProperties().get("example:show_hat"));
+        assertEquals(2, actor.entityProperties().get("example:hat"));
+        assertEquals(true, snapshot.get("example:show_hat"));
+
+        actor.retainEntityProperties(DEFINITIONS.resolveValues(values(Map.of(2, 9, 99, 7), Map.of(0, Float.NaN, 99, 1F))));
+        assertEquals("blue", actor.entityProperties().get("example:color"));
+        assertEquals(1.5F, actor.entityProperties().get("example:size"));
+        assertEquals(4, actor.entityProperties().size());
+    }
+
+    @Test
+    void appliesPreAnimationBeforeSelectingThePropertyDrivenHat() throws Exception {
+        final Scope scope = Scope.create();
+        final MutableObjectBinding variables = new MutableObjectBinding();
+        scope.set("variable", variables);
+        scope.set("v", variables);
+        for (boolean show : new boolean[]{true, false, true}) {
+            final MutableObjectBinding queries = new MutableObjectBinding();
+            MoLangEngine.bindPropertyQueries(queries, Map.of("example:show_hat", show, "example:hat", 2));
+            scope.set("query", queries);
+            scope.set("q", queries);
+            MoLangEngine.runPreAnimation(scope, List.of("v.show_hat = q.has_property('example:show_hat') && q.property('example:show_hat'); v.hat = q.property('example:hat');"));
+            assertEquals(show, MoLangEngine.eval(scope, "v.show_hat").getAsBoolean());
+            assertEquals(2D, MoLangEngine.eval(scope, "v.hat").getAsNumber());
+            assertEquals(0D, MoLangEngine.eval(scope, "q.property('example:missing')").getAsNumber());
+        }
+    }
+
+    private static EntityProperties values(final Map<Integer, Integer> integers, final Map<Integer, Float> floats) {
+        return new EntityProperties(new Int2IntOpenHashMap(integers), new Int2ObjectOpenHashMap<>(floats));
+    }
+
+}
