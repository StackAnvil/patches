+                    }
+                    case "minecraft:has_nectar" -> {
+                        if (entity.javaType().is(EntityTypes26_3.BEE)) {
+                            entity.setHasNectar(value);
+                            final byte bitmask = beeFlags(entity.entityFlags(), value);
+                            final int flagsIndex = entity.getJavaEntityDataIndex(EntityDataFields.FLAGS);
+                            javaEntityData.removeIf(data -> data.id() == flagsIndex);
+                            javaEntityData.add(new EntityData(flagsIndex, VersionedTypes.V26_3.entityDataTypes().byteType, bitmask));
+                        } else {
+                            ViaBedrock.getPlatform().getLogger().warning("Received has_nectar property for non-BEE entity " + entity.type());
+                        }
+                    }
+                    default -> ViaBedrock.getPlatform().getLogger().warning("Received boolean property " + booleanProperty.identifier() + " for entity " + entity.type() + " with value " + value);
+                }
+            } else if (property instanceof EntityProperty.IntProperty integerProperty) {
+                ViaBedrock.getPlatform().getLogger().fine("Ignoring int property " + integerProperty.identifier() + " for entity " + entity.type());
+            } else if (property instanceof EntityProperty.EnumProperty enumProperty) {
+                if (i < 0 || i >= enumProperty.possibleValues().size()) {
+                    ViaBedrock.getPlatform().getLogger().warning("Received invalid value " + i + " for enum property " + enumProperty.identifier() + " on entity " + entity.type());
+                    continue;
+                }
+                final String value = enumProperty.possibleValues().get(i);
+
+                switch (enumProperty.identifier()) {
+                    case "minecraft:climate_variant" -> {
+                        final String namespacedVariant = Key.namespaced(value);
+
+                        final String registryName = switch (entity.javaType()) {
+                            case CHICKEN -> RegistryKeys.CHICKEN_VARIANT;
+                            case COW -> RegistryKeys.COW_VARIANT;
+                            case PIG -> RegistryKeys.PIG_VARIANT;
+                            default -> {
+                                ViaBedrock.getPlatform().getLogger().warning("Received climate_variant for unsupported entity " + entity.type());
+                                yield null;
+                            }
+                        };
+                        final EntityDataType variantType = switch (entity.javaType()) {
+                            case CHICKEN -> VersionedTypes.V26_3.entityDataTypes().chickenVariantType;
+                            case COW -> VersionedTypes.V26_3.entityDataTypes().cowVariantType;
+                            case PIG -> VersionedTypes.V26_3.entityDataTypes().pigVariantType;
+                            default -> null;
+                        };
+
+                        if (registryName != null && variantType != null) {
+                            final CompoundTag variantRegistry = registries.getCompoundTag(registryName);
+                            final int javaVariant = registryIndex(variantRegistry, namespacedVariant);
+
+                            if (javaVariant != -1) {
+                                javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.VARIANT), variantType, javaVariant));
+                            } else {
+                                ViaBedrock.getPlatform().getLogger().warning("Failed to find variant " + namespacedVariant + " in registry " + registryName + " for entity " + entity.type());
+                            }
+                        }
+                    }
+                    case "minecraft:sound_variant" -> {
+                        final String namespacedVariant = Key.namespaced(value);
+
+                        final String registryName = switch (entity.javaType()) {
+                            case CHICKEN -> RegistryKeys.CHICKEN_SOUND_VARIANT;
+                            case COW -> RegistryKeys.COW_SOUND_VARIANT;
+                            case PIG -> RegistryKeys.PIG_SOUND_VARIANT;
+                            case WOLF -> RegistryKeys.WOLF_SOUND_VARIANT;
+                            case CAT -> RegistryKeys.CAT_SOUND_VARIANT;
+                            default -> {
+                                ViaBedrock.getPlatform().getLogger().warning("Received sound_variant for unsupported entity " + entity.type());
+                                yield null;
+                            }
+                        };
+                        final EntityDataType variantType = switch (entity.javaType()) {
+                            case CHICKEN -> VersionedTypes.V26_3.entityDataTypes().chickenSoundVariant;
+                            case COW -> VersionedTypes.V26_3.entityDataTypes().cowSoundVariant;
+                            case PIG -> VersionedTypes.V26_3.entityDataTypes().pigSoundVariant;
+                            case WOLF -> VersionedTypes.V26_3.entityDataTypes().wolfSoundVariantType;
+                            case CAT -> VersionedTypes.V26_3.entityDataTypes().catSoundVariant;
+                            default -> null;
+                        };
+
+                        if (registryName != null && variantType != null) {
+                            final CompoundTag variantRegistry = registries.getCompoundTag(registryName);
+                            final int javaVariant = registryIndex(variantRegistry, namespacedVariant);
+
+                            if (javaVariant != -1) {
+                                javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.SOUND_VARIANT), variantType, javaVariant));
+                            } else {
+                                ViaBedrock.getPlatform().getLogger().warning("Failed to find sound variant " + namespacedVariant + " in registry " + registryName + " for entity " + entity.type());
+                            }
+                        }
+                    }
+                    case "minecraft:chest_interaction" -> {
+                        if (entity.javaType().is(EntityTypes26_3.COPPER_GOLEM)) {
+                            final int state = switch (value) {
+                                case "none" -> 0; // IDLE
+                                case "take" -> 1; // GETTING_ITEM
+                                case "take_fail" -> 2; // GETTING_NO_ITEM
+                                case "put" -> 3; // DROPPING_ITEM
+                                case "put_fail" -> 4; // DROPPING_NO_ITEM
+                                default -> -1;
+                            };
+
+                            if (state != -1) {
+                                javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.COPPER_GOLEM_STATE), VersionedTypes.V26_3.entityDataTypes().copperGolemState, state));
+                            } else {
+                                ViaBedrock.getPlatform().getLogger().warning("Received unknown chest_interaction state " + value + " for COPPER_GOLEM entity " + entity.type());
+                            }
+                        } else {
+                            ViaBedrock.getPlatform().getLogger().warning("Received chest_interaction for non-COPPER_GOLEM entity " + entity.type());
+                        }
+                    }
+                    case "minecraft:oxidation_level" -> {
+                        if (entity.javaType().is(EntityTypes26_3.COPPER_GOLEM)) {
+                            final int state = switch (value) {
+                                case "unoxidized" -> 0; // UNAFFECTED
+                                case "exposed" -> 1; // EXPOSED
+                                case "weathered" -> 2; // WEATHERED
+                                case "oxidized" -> 3; // OXIDIZED
+                                default -> -1;
+                            };
+
+                            if (state != -1) {
+                                javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.WEATHER_STATE), VersionedTypes.V26_3.entityDataTypes().weatheringCopperState, state));
+                            } else {
+                                ViaBedrock.getPlatform().getLogger().warning("Received unknown oxidation_level state " + value + " for COPPER_GOLEM entity " + entity.type());
+                            }
+                        } else {
+                            ViaBedrock.getPlatform().getLogger().warning("Received oxidation_level for non-COPPER_GOLEM entity " + entity.type());
+                        }
+                    }
+                    default -> ViaBedrock.getPlatform().getLogger().fine("Ignoring enum property " + enumProperty.identifier() + " for entity " + entity.type());
+                }
+            }
+        }
+
+        for (EntityPropertyList.FloatValue propertyValue : expectedProperties.resolveFloats(properties.floatProperties())) {
+            ViaBedrock.getPlatform().getLogger().fine("Ignoring float property " + propertyValue.property().identifier() + " for entity " + entity.type());
+        }
+    }
+
+    private static int registryIndex(final CompoundTag registry, final String name) {
+        if (registry == null) {
+            return -1;
+        }
+
+        int index = 0;
+        for (String key : registry.keySet()) {
+            if (key.equals(name)) {
+                return index;
+            }
+            index++;
+        }
+        return -1;
+    }
+
+    static boolean shouldTranslateName(final Entity entity) {
+        // Bedrock uses NAME for an item's label, a projectile's source item, and
+        // experience orbs. Java treats these as visible custom entity names.
+        return !entity.javaType().is(EntityTypes26_3.ITEM)
+                && !entity.javaType().isOrHasParent(EntityTypes26_3.PROJECTILE)
+                && !entity.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_FIREBALL)
+                && !entity.javaType().is(EntityTypes26_3.EYE_OF_ENDER)
+                && !entity.javaType().is(EntityTypes26_3.EXPERIENCE_ORB);
+    }
+
+    static int cushionColor(final int bedrockVariant) {
+        // Bedrock's cushion render controller orders dyes black to white. Java's
+        // DyeColor metadata uses white to black, so the indexes are reversed.
+        return bedrockVariant >= 0 && bedrockVariant < 16 ? 15 - bedrockVariant : -1;
+    }
+
+    static byte beeFlags(final Set<ActorFlags> flags, final boolean hasNectar) {
+        byte javaFlags = 0;
+        if (flags.contains(ActorFlags.ANGRY)) {
+            javaFlags |= 0x02;
+        }
+        if (hasNectar) {
+            javaFlags |= 0x08;
+        }
+        return javaFlags;
+    }
+
+    static byte livingUseFlags(final Set<ActorFlags> flags, final boolean offhandShield) {
+        if (!flags.contains(ActorFlags.USINGITEM) && !flags.contains(ActorFlags.BLOCKING)) {
+            return 0;
+        }
+        return (byte) (1 | (flags.contains(ActorFlags.BLOCKING) && offhandShield ? 2 : 0));
+    }
+
+    public static EntityData livingUseMetadata(final Entity entity) {
+        final boolean offhandShield = entity instanceof ClientPlayerEntity clientPlayer && clientPlayer.isShieldBlocking()
+                ? clientPlayer.shieldBlockingHand() == InteractionHand.OFF_HAND
+                : entity.isOffhandShield();
+        return new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.LIVING_ENTITY_FLAGS),
+                VersionedTypes.V26_3.entityDataTypes().byteType, livingUseFlags(entity.entityFlags(), offhandShield));
+    }
+
+    static byte sheepWool(final Entity entity) {
+        final EntityData colorData = entity.entityData().get(ActorDataIds.COLOR_INDEX);
+        final int color = colorData != null ? readNumber(colorData).intValue() & 0x0F : 0;
+        return (byte) (color | (entity.entityFlags().contains(ActorFlags.SHEARED) ? 0x10 : 0));
+    }
+
+    private static void addTropicalFishVariant(final Entity entity, final List<EntityData> javaEntityData) {
+        final int variant = tropicalFishVariant(entity);
+        if (variant >= 0) {
+            javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.TYPE_VARIANT),
+                    VersionedTypes.V26_3.entityDataTypes().varIntType, variant));
+        }
+    }
+
+    static int tropicalFishVariant(final Entity entity) {
+        final int base = tropicalFishComponent(entity, ActorDataIds.VARIANT, 1);
+        final int pattern = tropicalFishComponent(entity, ActorDataIds.MARK_VARIANT, 5);
+        final int baseColor = tropicalFishComponent(entity, ActorDataIds.COLOR_INDEX, 15);
+        final int patternColor = tropicalFishComponent(entity, ActorDataIds.COLOR_2_INDEX, 15);
+        if (base < 0 || pattern < 0 || baseColor < 0 || patternColor < 0) {
+            return -1;
+        }
+        return base | pattern << 8 | baseColor << 16 | patternColor << 24;
+    }
+
+    private static int tropicalFishComponent(final Entity entity, final ActorDataIds id, final int maximum) {
+        final EntityData data = entity.entityData().get(id);
+        if (data == null) {
+            return 0;
+        }
+        final int value = readNumber(data).intValue();
+        return value >= 0 && value <= maximum ? value : -1;
+    }
+
+    static boolean boatPaddleTurning(final Entity entity, final ActorDataIds id) {
+        final EntityData data = entity.entityData().get(id);
+        return data != null && readNumber(data).floatValue() > 0f;
+    }
+
+    static int minecartDisplayBlockState(final Entity entity, final IntUnaryOperator bedrockToJavaBlockState) {
+        final EntityData customDisplay = entity.entityData().get(ActorDataIds.CUSTOM_DISPLAY);
+        final EntityData displayTile = entity.entityData().get(ActorDataIds.DISPLAY_TILE_RUNTIME_ID);
+        if (customDisplay == null || displayTile == null || readNumber(customDisplay).intValue() == 0) {
+            return 0;
+        }
+        return Math.max(0, bedrockToJavaBlockState.applyAsInt(readNumber(displayTile).intValue()));
+    }
+
+    private static void updateScale(final Entity entity, final float scale, final List<EntityData> javaEntityData) {
+        if (!entity.javaType().isOrHasParent(EntityTypes26_3.LIVING_ENTITY) || scale == 0f) {
+            return;
+        }
+
+        if (entity.javaType().is(EntityTypes26_3.SALMON)) {
+            final int type = salmonType(scale);
+            javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.TYPE), VersionedTypes.V26_3.entityDataTypes().varIntType, type));
+        }
+
+        final LivingEntity livingEntity = (LivingEntity) entity;
+        livingEntity.updateAttributes(new EntityAttribute("minecraft:scale", javaScale(entity, scale), (float) 1 / 16, 16));
+    }
+
+    static float javaScale(final Entity entity, final float bedrockScale) {
+        // Java salmon sizes and baby models are already represented by their entity data.
+        if (entity.javaType().is(EntityTypes26_3.SALMON) && (bedrockScale == 0.5f || bedrockScale == 1f || bedrockScale == 1.5f)) {
+            return 1f;
+        }
+        if (hasBedrockBabyRenderCompensation(entity) && entity.entityFlags().contains(ActorFlags.BABY)) {
+            return bedrockScale * 2f;
+        }
+        return bedrockScale;
+    }
+
+    private static boolean hasBedrockBabyRenderCompensation(final Entity entity) {
+        // These vanilla Bedrock baby models render at twice their entity scale.
+        return switch (entity.javaType()) {
+            case AXOLOTL, BEE, CHICKEN, COW, FOX, GOAT, MOOSHROOM, OCELOT, PIG, SHEEP, WOLF -> true;
+            default -> false;
+        };
+    }
+
+    static int salmonType(final float scale) {
+        if (scale == 0.5f) {
+            return 0; // SMALL
+        }
+        if (scale == 1.5f) {
+            return 2; // LARGE
+        }
+        return 1; // MEDIUM, including custom scales
+    }
