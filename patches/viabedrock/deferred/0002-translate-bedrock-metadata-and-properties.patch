@@ -0,0 +1,79 @@
+package net.raphimc.viabedrock.protocol.model.entity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2IntOpenHashMap;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class EntityPropertyListTest {
+
+    @Test
+    void resolvesSparseValuesByTheirWireIndices() {
+        final EntityPropertyList definitions = new EntityPropertyList(List.of(
+                new EntityProperty.BooleanProperty("minecraft:first"),
+                new EntityProperty.IntProperty("minecraft:unused", 0, 10),
+                new EntityProperty.EnumProperty("minecraft:variant", List.of("temperate", "warm"))
+        ), List.of(new EntityProperty.FloatProperty("minecraft:float", 0, 1)));
+        final Int2IntOpenHashMap integers = new Int2IntOpenHashMap();
+        integers.put(2, 1);
+        integers.put(0, 0);
+        integers.put(7, 99);
+        final Int2ObjectOpenHashMap<Float> floats = new Int2ObjectOpenHashMap<>();
+        floats.put(Integer.valueOf(0), Float.valueOf(0.5F));
+
+        final List<EntityPropertyList.IntValue> resolved = definitions.resolveInts(integers);
+        assertEquals(2, resolved.size());
+        assertTrue(resolved.stream().anyMatch(value -> value.property() instanceof EntityProperty.BooleanProperty && value.value() == 0));
+        assertTrue(resolved.stream().anyMatch(value -> value.property() instanceof EntityProperty.EnumProperty && value.value() == 1));
+        assertEquals(0.5F, definitions.resolveFloats(floats).get(0).value());
+    }
+
+    @Test
+    void parsesSeparateIntegerAndFloatIndexSpaces() {
+        final CompoundTag root = new CompoundTag();
+        final ListTag<CompoundTag> properties = new ListTag<>(CompoundTag.class);
+        final CompoundTag booleanProperty = new CompoundTag();
+        booleanProperty.put("name", new StringTag("minecraft:can_move"));
+        booleanProperty.put("type", new IntTag(2));
+        properties.add(booleanProperty);
+        final CompoundTag floatProperty = new CompoundTag();
+        floatProperty.put("name", new StringTag("minecraft:speed"));
+        floatProperty.put("type", new IntTag(1));
+        floatProperty.put("min", new FloatTag(0));
+        floatProperty.put("max", new FloatTag(2));
+        properties.add(floatProperty);
+        final CompoundTag enumProperty = new CompoundTag();
+        enumProperty.put("name", new StringTag("minecraft:climate_variant"));
+        enumProperty.put("type", new IntTag(3));
+        enumProperty.put("enum", new ListTag<>(List.of(new StringTag("temperate"), new StringTag("warm"))));
+        properties.add(enumProperty);
+        root.put("properties", properties);
+
+        final EntityPropertyList definitions = EntityPropertyList.fromTag(root).orElseThrow();
+        assertEquals(2, definitions.intProperties().size());
+        assertEquals(1, definitions.floatProperties().size());
+        assertInstanceOf(EntityProperty.EnumProperty.class, definitions.intProperties().get(1));
+    }
+
+    @Test
+    void rejectsUnknownPropertyKindsBecauseTheirIndexSpaceIsUnknown() {
+        final CompoundTag root = new CompoundTag();
+        final CompoundTag property = new CompoundTag();
+        property.put("name", new StringTag("minecraft:unknown"));
+        property.put("type", new IntTag(9));
+        root.put("properties", new ListTag<>(List.of(property)));
+
+        assertTrue(EntityPropertyList.fromTag(root).isEmpty());
+    }
+
+}
