+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class EntityMetadataRewriterTest {
+
+    @Test
+    void omitsBedrockItemProjectileAndExperienceOrbLabelsFromJavaCustomNames() {
+        for (final EntityTypes26_3 type : new EntityTypes26_3[] {
+            EntityTypes26_3.ITEM, EntityTypes26_3.EGG, EntityTypes26_3.ARROW,
+            EntityTypes26_3.FIREBALL, EntityTypes26_3.SMALL_FIREBALL,
+            EntityTypes26_3.EYE_OF_ENDER, EntityTypes26_3.EXPERIENCE_ORB
+        }) {
+            final Entity entity = new Entity(null, 1, 1, type.identifier(), 1, null, type);
+            assertFalse(EntityMetadataRewriter.shouldTranslateName(entity), type.name());
+        }
+
+        for (final EntityTypes26_3 type : new EntityTypes26_3[] {EntityTypes26_3.PLAYER, EntityTypes26_3.SHEEP, EntityTypes26_3.CUSHION}) {
+            final Entity entity = new Entity(null, 1, 1, type.identifier(), 1, null, type);
+            assertTrue(EntityMetadataRewriter.shouldTranslateName(entity), type.name());
+        }
+    }
+
+    @Test
+    void reversesBedrockCushionVariantsForJavaDyeColors() {
+        for (int bedrockVariant = 0; bedrockVariant < 16; bedrockVariant++) {
+            assertEquals(15 - bedrockVariant, EntityMetadataRewriter.cushionColor(bedrockVariant));
+        }
+        assertEquals(-1, EntityMetadataRewriter.cushionColor(-1));
+        assertEquals(-1, EntityMetadataRewriter.cushionColor(16));
+    }
+
+    @Test
+    void mapsBlockingAndItemUseToJavaActiveHandFlags() {
+        assertEquals((byte) 0, EntityMetadataRewriter.livingUseFlags(Set.of(), true));
+        assertEquals((byte) 1, EntityMetadataRewriter.livingUseFlags(Set.of(ActorFlags.USINGITEM), true));
+        assertEquals((byte) 1, EntityMetadataRewriter.livingUseFlags(Set.of(ActorFlags.BLOCKING), false));
+        assertEquals((byte) 3, EntityMetadataRewriter.livingUseFlags(Set.of(ActorFlags.BLOCKING), true));
+    }
+
+    @Test
+    void keepsBeeAngerWhenNectarChanges() {
+        assertEquals((byte) 0x0A, EntityMetadataRewriter.beeFlags(Set.of(ActorFlags.ANGRY), true));
+        assertEquals((byte) 0x02, EntityMetadataRewriter.beeFlags(Set.of(ActorFlags.ANGRY), false));
+        assertEquals((byte) 0x08, EntityMetadataRewriter.beeFlags(Set.of(), true));
+    }
+
+    @Test
+    void keepsSheepColorAndShearedStateAcrossPartialUpdates() {
+        final Entity sheep = new Entity(null, 1, 1, EntityTypes26_3.SHEEP.identifier(), 1, null, EntityTypes26_3.SHEEP);
+        sheep.entityData().put(ActorDataIds.COLOR_INDEX, new EntityData(ActorDataIds.COLOR_INDEX.getValue(), EntityDataTypesBedrock.INT, 14));
+        assertEquals((byte) 14, EntityMetadataRewriter.sheepWool(sheep));
+
+        sheep.entityData().put(ActorDataIds.RESERVED_0, new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, 1L << ActorFlags.SHEARED.getValue()));
+        assertEquals((byte) 30, EntityMetadataRewriter.sheepWool(sheep));
+
+        sheep.entityData().put(ActorDataIds.COLOR_INDEX, new EntityData(ActorDataIds.COLOR_INDEX.getValue(), EntityDataTypesBedrock.INT, 3));
+        assertEquals((byte) 19, EntityMetadataRewriter.sheepWool(sheep));
+    }
+
+    @Test
+    void usesSalmonModelSizeWithoutScalingItTwice() {
+        final Entity salmon = new Entity(null, 1, 1, EntityTypes26_3.SALMON.identifier(), 1, null, EntityTypes26_3.SALMON);
+
+        assertEquals(0, EntityMetadataRewriter.salmonType(0.5f));
+        assertEquals(1, EntityMetadataRewriter.salmonType(1f));
+        assertEquals(2, EntityMetadataRewriter.salmonType(1.5f));
+        assertEquals(1f, EntityMetadataRewriter.javaScale(salmon, 0.5f));
+        assertEquals(1f, EntityMetadataRewriter.javaScale(salmon, 1.5f));
+        assertEquals(0.8f, EntityMetadataRewriter.javaScale(salmon, 0.8f));
+    }
+
+    @Test
+    void compensatesForGoatBabyModelScaleWhenAgeChanges() {
+        final Entity goat = new Entity(null, 1, 1, EntityTypes26_3.GOAT.identifier(), 1, null, EntityTypes26_3.GOAT);
+        goat.entityData().put(ActorDataIds.RESERVED_0, new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, 1L << ActorFlags.BABY.getValue()));
+        assertEquals(1f, EntityMetadataRewriter.javaScale(goat, 0.5f));
+
+        goat.entityData().put(ActorDataIds.RESERVED_0, new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, 0L));
+        assertEquals(0.5f, EntityMetadataRewriter.javaScale(goat, 0.5f));
+    }
+
+    @Test
+    void usesJavaBabyModelsWithoutApplyingBedrockRenderScaleTwice() {
+        for (final EntityTypes26_3 type : new EntityTypes26_3[] {
+            EntityTypes26_3.CHICKEN, EntityTypes26_3.COW, EntityTypes26_3.SHEEP,
+            EntityTypes26_3.WOLF, EntityTypes26_3.AXOLOTL
+        }) {
+            final Entity baby = new Entity(null, 1, 1, type.identifier(), 1, null, type);
+            baby.entityData().put(ActorDataIds.RESERVED_0, new EntityData(
+                    ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG,
+                    1L << ActorFlags.BABY.getValue()));
+            assertEquals(1f, EntityMetadataRewriter.javaScale(baby, 0.5f), type.name());
+
+            baby.entityData().put(ActorDataIds.RESERVED_0, new EntityData(
+                    ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG, 0L));
+            assertEquals(0.5f, EntityMetadataRewriter.javaScale(baby, 0.5f), type.name());
+        }
+    }
+
+    @Test
+    void combinesTropicalFishPatternAndColorsAcrossPartialUpdates() {
+        final Entity fish = new Entity(null, 1, 1, EntityTypes26_3.TROPICAL_FISH.identifier(), 1, null, EntityTypes26_3.TROPICAL_FISH);
+        fish.entityData().put(ActorDataIds.VARIANT, new EntityData(ActorDataIds.VARIANT.getValue(), EntityDataTypesBedrock.INT, 1));
+        fish.entityData().put(ActorDataIds.MARK_VARIANT, new EntityData(ActorDataIds.MARK_VARIANT.getValue(), EntityDataTypesBedrock.INT, 4));
+        fish.entityData().put(ActorDataIds.COLOR_INDEX, new EntityData(ActorDataIds.COLOR_INDEX.getValue(), EntityDataTypesBedrock.INT, 3));
+        fish.entityData().put(ActorDataIds.COLOR_2_INDEX, new EntityData(ActorDataIds.COLOR_2_INDEX.getValue(), EntityDataTypesBedrock.INT, 14));
+
+        assertEquals(0x0E030401, EntityMetadataRewriter.tropicalFishVariant(fish));
+
+        fish.entityData().put(ActorDataIds.MARK_VARIANT, new EntityData(ActorDataIds.MARK_VARIANT.getValue(), EntityDataTypesBedrock.INT, 2));
+        assertEquals(0x0E030201, EntityMetadataRewriter.tropicalFishVariant(fish));
+    }
+
+    @Test
+    void translatesBoatPaddleTimesToTurningFlags() {
+        final Entity boat = new Entity(null, 1, 1, EntityTypes26_3.OAK_BOAT.identifier(), 1, null, EntityTypes26_3.OAK_BOAT);
+        assertFalse(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_LEFT));
+
+        boat.entityData().put(ActorDataIds.ROW_TIME_LEFT,
+                new EntityData(ActorDataIds.ROW_TIME_LEFT.getValue(), EntityDataTypesBedrock.FLOAT, 0.4f));
+        assertTrue(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_LEFT));
+        assertFalse(EntityMetadataRewriter.boatPaddleTurning(boat, ActorDataIds.ROW_TIME_RIGHT));
+    }
+
+    @Test
+    void onlyDisplaysMinecartBlockWhenBedrockEnablesIt() {
+        final Entity minecart = new Entity(null, 1, 1, EntityTypes26_3.MINECART.identifier(), 1, null, EntityTypes26_3.MINECART);
+        minecart.entityData().put(ActorDataIds.DISPLAY_TILE_RUNTIME_ID,
+                new EntityData(ActorDataIds.DISPLAY_TILE_RUNTIME_ID.getValue(), EntityDataTypesBedrock.INT, 42));
+        assertEquals(0, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> id + 100));
+
+        minecart.entityData().put(ActorDataIds.CUSTOM_DISPLAY,
+                new EntityData(ActorDataIds.CUSTOM_DISPLAY.getValue(), EntityDataTypesBedrock.BYTE, (byte) 1));
+        assertEquals(142, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> id + 100));
+        assertEquals(0, EntityMetadataRewriter.minecartDisplayBlockState(minecart, id -> -1));
+    }
+
+}
