+        final String label = "§aVisible";
+        updateName(player, label);
+        final TextComponent prefix = this.teamPrefix();
+        assertEquals(originalProfile, player.name());
+        player.updateName("InitializedProfile");
+        assertEquals("InitializedProfile", player.name());
+        assertEquals(prefix.asUnformattedString(), this.teamPrefix().asUnformattedString());
+        assertEquals(0x55FF55, this.teamPrefix().getStyle().getColor().getRgbValue());
