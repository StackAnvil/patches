+public record EntityPropertyList(List<EntityProperty> intProperties, List<EntityProperty.FloatProperty> floatProperties) {
+
+    public EntityPropertyList {
+        intProperties = List.copyOf(intProperties);
+        floatProperties = List.copyOf(floatProperties);
+    }
+
+    public static Optional<EntityPropertyList> fromTag(final CompoundTag tag) {
+        final ListTag<CompoundTag> definitions = tag.getListTag("properties", CompoundTag.class);
+        if (definitions == null) {
+            return Optional.empty();
+        }
+
+        final List<EntityProperty> integers = new ArrayList<>();
+        final List<EntityProperty.FloatProperty> floats = new ArrayList<>();
+        for (CompoundTag definition : definitions) {
+            final String name = definition.getString("name");
+            if (name == null || name.isBlank() || !definition.contains("type")) {
+                return Optional.empty();
+            }
+            switch (definition.getInt("type")) {
+                case 0 -> integers.add(new EntityProperty.IntProperty(name, definition.getInt("min"), definition.getInt("max")));
+                case 1 -> floats.add(new EntityProperty.FloatProperty(name, definition.getFloat("min"), definition.getFloat("max")));
+                case 2 -> integers.add(new EntityProperty.BooleanProperty(name));
+                case 3 -> {
+                    final ListTag<StringTag> values = definition.getListTag("enum", StringTag.class);
+                    if (values == null || values.isEmpty()) {
+                        return Optional.empty();
+                    }
+                    integers.add(new EntityProperty.EnumProperty(name, values.stream().map(StringTag::getValue).toList()));
+                }
+                default -> {
+                    return Optional.empty();
+                }
+            }
+        }
+        return Optional.of(new EntityPropertyList(integers, floats));
+    }
+
+    public List<IntValue> resolveInts(final Int2IntMap values) {
+        final List<IntValue> resolved = new ArrayList<>(values.size());
+        for (Int2IntMap.Entry entry : values.int2IntEntrySet()) {
+            final int index = entry.getIntKey();
+            if (index >= 0 && index < this.intProperties.size()) {
+                resolved.add(new IntValue(this.intProperties.get(index), entry.getIntValue()));
+            }
+        }
+        return resolved;
+    }
+
+    public List<FloatValue> resolveFloats(final Int2ObjectMap<Float> values) {
+        final List<FloatValue> resolved = new ArrayList<>(values.size());
+        for (Int2ObjectMap.Entry<Float> entry : values.int2ObjectEntrySet()) {
+            final int index = entry.getIntKey();
+            if (index >= 0 && index < this.floatProperties.size()) {
+                resolved.add(new FloatValue(this.floatProperties.get(index), entry.getValue()));
+            }
+        }
+        return resolved;
+    }
+
+    public Map<String, Object> resolveValues(final EntityProperties values) {
+        final Map<String, Object> resolved = new HashMap<>();
+        for (IntValue entry : this.resolveInts(values.intProperties())) {
+            if (entry.property() instanceof EntityProperty.BooleanProperty property) {
+                resolved.put(property.identifier(), entry.value() != 0);
+            } else if (entry.property() instanceof EntityProperty.IntProperty property) {
+                resolved.put(property.identifier(), entry.value());
+            } else if (entry.property() instanceof EntityProperty.EnumProperty property) {
+                if (entry.value() >= 0 && entry.value() < property.possibleValues().size()) {
+                    resolved.put(property.identifier(), property.possibleValues().get(entry.value()));
+                }
+            }
+        }
+        for (FloatValue entry : this.resolveFloats(values.floatProperties())) {
+            if (Float.isFinite(entry.value())) {
+                resolved.put(entry.property().identifier(), entry.value());
+            }
+        }
+        return Map.copyOf(resolved);
+    }
+
+    public record IntValue(EntityProperty property, int value) {
+    }
+
+    public record FloatValue(EntityProperty.FloatProperty property, float value) {
+    }
+
+}
