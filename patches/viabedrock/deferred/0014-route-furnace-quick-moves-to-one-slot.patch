From 7c4b500ff991b65c6bb6e1803562c1322022b40c Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 09:30:18 +0200
Subject: [PATCH] fix(inventory): route furnace quick moves to one slot

A stack partly merged into the furnace input must not also move into the fuel slot in one request. Route known fuels directly to fuel and stop after the first furnace destination range that accepts items. Moves out of the furnace still scan both player inventory ranges. Unclassified fuels retain the existing input-then-fuel fallback.
---
 .../api/model/container/Container.java        | 41 +++++++++++++++++--
 1 file changed, 38 insertions(+), 3 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/Container.java b/src/main/java/net/raphimc/viabedrock/api/model/container/Container.java
index 6a31d0fb..309ce162 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/container/Container.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/container/Container.java
@@ -23,6 +23,7 @@ import com.viaversion.viaversion.api.minecraft.item.Item;
 import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
 
 import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
 import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
 import net.raphimc.viabedrock.api.util.PacketFactory;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
@@ -48,6 +49,14 @@ import java.util.logging.Level;
 
 public abstract class Container {
 
+    private static final Set<String> FURNACE_FUEL_ITEMS = Set.of(
+            "minecraft:coal_block", "minecraft:blaze_rod", "minecraft:lava_bucket",
+            "minecraft:dried_kelp_block", "minecraft:stick", "minecraft:bamboo",
+            "minecraft:scaffolding", "minecraft:bamboo_mosaic");
+    private static final Set<String> FURNACE_FUEL_TAGS = Set.of(
+            "minecraft:coals", "minecraft:planks", "minecraft:wooden_slabs",
+            "minecraft:wooden_tier", "minecraft:boats");
+
     protected final UserConnection user;
     protected final byte containerId;
     protected final ContainerType type;
@@ -345,8 +354,10 @@ public abstract class Container {
 
         final List<ItemStackRequestAction> actions = new ArrayList<>();
         final List<QuickMoveRange> ranges = this.quickMoveRanges(javaSlot, source);
+        furnaceMove:
         for (boolean mergePass : new boolean[] {true, false}) {
             for (QuickMoveRange range : ranges) {
+                final int actionsBeforeRange = actions.size();
                 final int start =
                         range.backwards() ? range.endJavaSlot() - 1 : range.startJavaSlot();
                 final int end = range.backwards() ? range.startJavaSlot() - 1 : range.endJavaSlot();
@@ -409,6 +420,10 @@ public abstract class Container {
                     }
                     sourceItem = newSourceItem;
                 }
+                if (this.isFurnace() && range.container() == this
+                        && actions.size() > actionsBeforeRange) {
+                    break furnaceMove;
+                }
             }
         }
 
@@ -680,9 +695,18 @@ public abstract class Container {
         }
 
         return switch (this.type) {
-            case FURNACE, BLAST_FURNACE, SMOKER -> List.of(
-                            new QuickMoveRange(this, 0, 1, false),
-                            new QuickMoveRange(this, 1, 2, false));
+            case FURNACE, BLAST_FURNACE, SMOKER -> {
+                final BedrockItem item = source.container().getItem(source.bedrockSlot());
+                final String identifier = this.user.get(ItemRewriter.class)
+                        .getItems().inverse().get(item.identifier());
+                final Set<String> tags = BedrockProtocol.MAPPINGS.getBedrockItemTags()
+                        .getOrDefault(identifier, Set.of());
+                if (isKnownFurnaceFuel(identifier, tags)) {
+                    yield List.of(new QuickMoveRange(this, 1, 2, false));
+                }
+                yield List.of(new QuickMoveRange(this, 0, 1, false),
+                        new QuickMoveRange(this, 1, 2, false));
+            }
             case BREWING_STAND -> List.of(new QuickMoveRange(this, 3, 4, false));
             case BEACON -> List.of(new QuickMoveRange(this, 0, 1, false));
             case ANVIL -> List.of(new QuickMoveRange(this, 0, 2, false));
@@ -698,6 +722,17 @@ public abstract class Container {
         };
     }
 
+    private boolean isFurnace() {
+        return this.type == ContainerType.FURNACE
+                || this.type == ContainerType.BLAST_FURNACE
+                || this.type == ContainerType.SMOKER;
+    }
+
+    private static boolean isKnownFurnaceFuel(final String identifier, final Set<String> tags) {
+        return FURNACE_FUEL_ITEMS.contains(identifier)
+                || tags.stream().anyMatch(FURNACE_FUEL_TAGS::contains);
+    }
+
     private QuickMoveRange equipmentQuickMoveRange(
             final SlotRef source, final InventoryTracker inventoryTracker) {
         final BedrockItem item = source.container().getItem(source.bedrockSlot());
-- 
