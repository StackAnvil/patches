+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Identifies one installed player screen, independently of Java's persistent menu zero. */
+public record PlayerInventoryScreenRequest(long opening, boolean open) {
+
+    public static final String CHANNEL = "viabedrock:player_inventory_screen_request_v1";
+    public static final Type<PlayerInventoryScreenRequest> TYPE = new Type<>(PlayerInventoryScreenRequest.class) {
+
+        @Override
+        public PlayerInventoryScreenRequest read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 18 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported inventory screen message");
+            }
+            final long opening = Types.VAR_LONG.readPrimitive(buffer);
+            final int flag = buffer.readUnsignedByte();
+            if (flag > 1) {
+                throw new IllegalArgumentException("Invalid inventory screen flag");
+            }
+            final var result = new PlayerInventoryScreenRequest(opening, flag == 1);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing inventory screen fields");
+            }
+            return result;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerInventoryScreenRequest value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_LONG.writePrimitive(buffer, value.opening);
+            buffer.writeBoolean(value.open);
+        }
+    };
+
+    public PlayerInventoryScreenRequest {
+        if (opening <= 0) {
+            throw new IllegalArgumentException("Invalid inventory screen opening");
+        }
+    }
+
+}
