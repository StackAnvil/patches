+        this.binding = binding;
+        this.menuId = menuId;
+        this.actionSlots = actionSlots;
+    }
+
+    public boolean hasActions() {
+        return !this.actionSlots.get().isEmpty();
+    }
+
+    public boolean autoPlaceOne(
+            final UserConnection user,
+            final int menuId,
+            final long sequence,
+            final int revision,
+            final int sourceSlot) {
+        return this.autoPlaceOne(
+                user,
+                menuId,
+                sequence,
+                revision,
+                sourceSlot,
+                user.get(net.raphimc.viabedrock.protocol.rewriter.ItemRewriter.class)::maxStackSize,
+                user.get(net.raphimc.viabedrock.protocol.rewriter.ItemRewriter.class)::canMerge,
+                request ->
+                        net.raphimc.viabedrock.api.util.PacketFactory.sendBedrockInventoryRequest(
+                                user, new ItemStackRequestInfo[] {request}));
+    }
+
+    boolean autoPlaceOne(
+            final UserConnection user,
+            final int menuId,
+            final long sequence,
+            final int revision,
+            final int sourceSlot,
+            final ToIntFunction<BedrockItem> maximumStackSize,
+            final BiPredicate<BedrockItem, BedrockItem> canMerge,
+            final Consumer<ItemStackRequestInfo> sender) {
+        final InventoryTracker inventory = user.get(InventoryTracker.class);
+        final InventoryRequestTracker requests = user.get(InventoryRequestTracker.class);
+        if (this.menuId != menuId
+                || !this.actionSlots.get().contains(sourceSlot)
+                || !this.binding.current(
+                        inventory.getCurrentContainer(),
+                        inventory.currentContainerGeneration(),
+                        sequence)
+                || !user.get(GameSessionStorage.class).isInventoryServerAuthoritative()) {
+            return false;
+        }
+        if (requests.hasPending() || requests.isPredictingClick()) {
+            return false;
+        }
+        final Container source = inventory.getCurrentContainer();
+        final var player = inventory.getInventoryContainer();
+        final var plan =
+                NativeContainerAutoPlacement.plan(
+                        this.binding,
+                        source,
+                        inventory.currentContainerGeneration(),
+                        sequence,
+                        sourceSlot,
+                        player,
+                        maximumStackSize.applyAsInt(source.getItem(sourceSlot)), canMerge);
+        if (plan == null) {
+            return false;
+        }
+        final Container previousSource = source.copy();
+        final Container previousPlayer = player.copy();
+        final Container previousCursor = inventory.getHudContainer().copy();
+        final var request =
+                new ItemStackRequestInfo(
+                        requests.nextRequestId(),
+                        List.of(plan.action()),
+                        List.of(),
+                        TextProcessingEventOrigin.unknown);
+        requests.setPredictingClick(true);
+        try {
+            source.setItem(plan.sourceSlot(), plan.transfer().sourceAfter());
+            player.setItem(plan.transfer().destinationSlot(), plan.transfer().destinationAfter());
+            requests.addRequest(
+                    new InventoryRequestStorage(
+                            request,
+                            revision,
+                            previousCursor,
+                            List.of(previousSource, previousPlayer),
+                            InventoryRequestStorage.ResponsePolicy.REPORTED_SLOTS));
+            sender.accept(request);
+        } catch (final RuntimeException error) {
+            requests.removeRequest(request.requestId());
+            source.setItems(previousSource.getItems());
+            player.setItems(previousPlayer.getItems());
+            throw error;
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        return true;
+    }
+
+}
