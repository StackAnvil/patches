+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.LongTag;
+import com.viaversion.nbt.tag.ShortTag;
+import com.viaversion.nbt.tag.StringTag;
+import org.junit.jupiter.api.Test;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.List;
+import java.util.HexFormat;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class ComponentItemStackingPropertiesTest {
+
+    @Test
+    void stackabilityUsesTypedUnbreakableAndSignedIntegerDamage() {
+        final var damageable = new ComponentItemStackingProperties(16, null, false, true);
+        final var ordinary = new ComponentItemStackingProperties(16, null, false, false);
+        final var item = new BedrockItem(2);
+        final var data = new CompoundTag();
+        item.setTag(data);
+        for (final var value : List.of(
+                Map.entry(new IntTag(1), false), Map.entry(new IntTag(32767), false),
+                Map.entry(new IntTag(32768), true), Map.entry(new IntTag(65535), true),
+                Map.entry(new IntTag(65536), true), Map.entry(new IntTag(-1), true),
+                Map.entry(new ByteTag((byte) 1), true), Map.entry(new ShortTag((short) 1), true))) {
+            data.put("Damage", value.getKey());
+            assertEquals(value.getValue(), damageable.stackable(item));
+            assertTrue(ordinary.stackable(item));
+        }
+        data.putInt("Damage", 1);
+        for (final var value : List.of(
+                Map.entry(new ByteTag((byte) 0), false), Map.entry(new ByteTag((byte) 1), true),
+                Map.entry(new ByteTag((byte) -1), true), Map.entry(new IntTag(1), false),
+                Map.entry(new StringTag("true"), false))) {
+            data.put("Unbreakable", value.getKey());
+            assertEquals(value.getValue(), damageable.stackable(item));
+        }
+        assertFalse(new ComponentItemStackingProperties(1, null, false, false).stackable(item));
+        assertFalse(new ComponentItemStackingProperties(64, 0, false, false).stackable(item));
+    }
+
+    @Test
+    void componentStateMatchesCompleteNativeTypedUpdatesAndSequences() throws Exception {
+        final String reference = System.getenv("STACKANVIL_COMPONENT_RETURN_PROPERTY_REFERENCE");
+        assumeTrue(reference != null);
+        try (var input = Files.newBufferedReader(Path.of(reference))) {
+            final var root = JsonParser.parseReader(input).getAsJsonObject();
+            for (final var entry : root.getAsJsonArray("cases")) {
+                final var row = entry.getAsJsonObject();
+                final var before = ComponentItemStackingProperties.DEFAULT.withComponentData(readComponents(row.get("initialNbtHex").getAsString()));
+                assertProperties(before, row.getAsJsonObject("before"));
+                final var after = before.withComponentData(readComponents(row.get("updateNbtHex").getAsString()));
+                assertProperties(after, row.getAsJsonObject("after"));
+            }
+            var properties = ComponentItemStackingProperties.DEFAULT;
+            for (final var entry : root.getAsJsonArray("sequence")) {
+                final var row = entry.getAsJsonObject();
+                properties = properties.withComponentData(readComponents(row.get("nbtHex").getAsString()));
+                assertProperties(properties, row.getAsJsonObject("native"));
+            }
+        }
+    }
+
+    private static void assertProperties(final ComponentItemStackingProperties properties, final JsonObject nativeState) {
+        assertEquals(nativeState.get("maximum").getAsInt(), properties.maximum(), nativeState::toString);
+        assertEquals(nativeState.get("stackedByData").getAsBoolean(), properties.stackedByData(), nativeState::toString);
+        assertEquals(nativeState.get("damageable").getAsBoolean(), properties.damageable(), nativeState::toString);
+    }
+
+    private static CompoundTag readComponents(final String encoded) {
+        final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(encoded));
+        try {
+            final var components = (CompoundTag) BedrockTypes.TAG_LE.read(buffer);
+            assertFalse(buffer.isReadable());
+            return components;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void namedComponentSurvivesOmittedUpdatesAndCompiledPropertyResets() {
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 16);
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        var size = ComponentItemStackingProperties.DEFAULT.withComponentData(components);
+        assertEquals(16, size.maximum());
+        size = size.withComponentData(new CompoundTag());
+        assertEquals(16, size.maximum());
+        components.getValue().clear();
+        final var named = new CompoundTag();
+        named.putByte("value", (byte) 32);
+        components.put("minecraft:max_stack_size", named);
+        size = size.withComponentData(components);
+        assertEquals(32, size.maximum());
+        components.getValue().clear();
+        components.put("item_properties", new CompoundTag());
+        size = size.withComponentData(components);
+        assertEquals(0, size.compiledMaximum());
+        assertEquals(32, size.maximum());
+        size = size.withComponentData(new CompoundTag());
+        assertEquals(32, size.maximum());
+        components.putByte("minecraft:max_stack_size", (byte) 1);
+        assertEquals(32, size.withComponentData(components).maximum());
+        components.put("minecraft:max_stack_size", new CompoundTag());
+        assertEquals(1, size.withComponentData(components).maximum());
+    }
+
+    @Test
+    void compiledMaximumUsesTypedIntegerByteSemantics() {
+        final var properties = new CompoundTag();
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        for (final var value : List.of(
+                Map.entry(new IntTag(16), 16), Map.entry(new IntTag(257), 1),
+                Map.entry(new IntTag(-1), 255), Map.entry(new IntTag(256), 0),
+                Map.entry(new ByteTag((byte) 64), 0), Map.entry(new ShortTag((short) 64), 0),
+                Map.entry(new LongTag(64), 0), Map.entry(new StringTag("64"), 0))) {
+            properties.put("max_stack_size", value.getKey());
+            assertEquals(value.getValue(), ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+        }
+    }
+
+    @Test
+    void namedMaximumUsesTypedByteOrNativeDefault() {
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 16);
+        final var size = new CompoundTag();
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        components.put("minecraft:max_stack_size", size);
+        assertEquals(1, ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+        for (final var value : List.of(
+                Map.entry(new ByteTag((byte) 0), 0), Map.entry(new ByteTag((byte) 128), 128),
+                Map.entry(new ByteTag((byte) 255), 255), Map.entry(new IntTag(64), 1),
+                Map.entry(new ShortTag((short) 64), 1), Map.entry(new StringTag("64"), 1))) {
+            size.put("value", value.getKey());
+            assertEquals(value.getValue(), ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+        }
+        components.putByte("minecraft:max_stack_size", (byte) 64);
+        assertEquals(16, ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+    }
+
+    @Test
+    void missingPropertiesDifferFromAnEmptyPropertyCompound() {
+        final var components = new CompoundTag();
+        assertEquals(64, ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+        final var properties = new CompoundTag();
+        components.put("item_properties", properties);
+        assertEquals(0, ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+        properties.putInt("minecraft:max_stack_size", 16);
+        assertEquals(0, ComponentItemStackingProperties.DEFAULT.withComponentData(components).maximum());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/model/ItemCookingPropertiesTest.java b/src/test/java/net/raphimc/viabedrock/protocol/model/ItemCookingPropertiesTest.java
