+
+/** Identifies one installed player screen, independently of Java's persistent menu zero. */
+public record PlayerInventoryScreenClose(long opening) {
+
+    public static final String CHANNEL = "viabedrock:player_inventory_screen_close_v1";
+    public static final Type<PlayerInventoryScreenClose> TYPE = new Type<>(PlayerInventoryScreenClose.class) {
+
+        @Override
+        public PlayerInventoryScreenClose read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 18 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported inventory screen message");
+            }
+            final var result = new PlayerInventoryScreenClose(Types.VAR_LONG.readPrimitive(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing inventory screen fields");
+            }
+            return result;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerInventoryScreenClose value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_LONG.writePrimitive(buffer, value.opening);
+        }
+    };
+
+    public PlayerInventoryScreenClose {
+        if (opening <= 0) {
+            throw new IllegalArgumentException("Invalid inventory screen opening");
+        }
+    }
+
+}
