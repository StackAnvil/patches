+    @Test
+    void responsesWaitForTheWholeBatchAndReconcileInRequestOrder() {
+        try (var fixture = new Fixture()) {
+            final var batch = fixture.prepare();
+            fixture.requests.sendTransferBatch(batch);
+            fixture.packets.verify(() -> PacketFactory.sendBedrockInventoryRequest(eq(fixture.user), any()));
+            fixture.packets.clearInvocations();
+            final List<Integer> observed = new ArrayList<>();
+            assertTrue(fixture.requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+                @Override
+                public Container container() {
+                    return fixture.furnace;
+                }
+
+                @Override
+                public boolean apply() {
+                    observed.add(fixture.furnace.getItem(0).netId());
+                    return true;
+                }
+            }));
+            fixture.requests.handleResponse(fixture.response(batch.getLast(), 9, 12, 202));
+            fixture.requests.handleResponse(fixture.response(batch.getLast(), 9, 12, 202));
+            assertTrue(fixture.requests.hasPending());
+            assertEquals(12, fixture.furnace.getItem(0).amount());
+            assertEquals(-5, fixture.furnace.getItem(0).netId());
+            fixture.packets.verifyNoInteractions();
+            assertTrue(observed.isEmpty());
+
+            fixture.requests.handleResponse(fixture.response(batch.getFirst(), 0, 7, 201));
+            assertFalse(fixture.requests.hasPending());
+            assertEquals(item(12, 202), fixture.furnace.getItem(0));
+            assertEquals(List.of(202), observed);
+            assertTrue(fixture.inventory.getInventoryContainer().getItem(0).isEmpty());
+            assertTrue(fixture.inventory.getInventoryContainer().getItem(9).isEmpty());
+        }
