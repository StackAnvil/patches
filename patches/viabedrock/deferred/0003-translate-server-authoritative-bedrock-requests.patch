+
+    public FurnaceContainer(
+            final UserConnection user,
+            final byte containerId,
+            final ContainerType type,
+            final TextComponent title,
+            final BlockPosition position,
+            final String... validBlockTags) {
+        super(user, containerId, type, title, position, 3, validBlockTags);
