+package net.raphimc.viabedrock.protocol.types.inventory;
+
+import com.viaversion.viaversion.api.type.Type;
+
+import io.netty.buffer.ByteBuf;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.types.InventoryTypes;
+import net.raphimc.viabedrock.protocol.types.array.ArrayType;
+
+public final class ItemStackActionType extends Type<ItemStackRequestAction> {
+
+    private final Type<BedrockItem[]> results;
+
+    public ItemStackActionType(final Type<BedrockItem> resultItem) {
+        super(ItemStackRequestAction.class);
+        this.results = new ArrayType<>(resultItem, BedrockTypes.UNSIGNED_VAR_INT);
+    }
+
+    @Override
+    public ItemStackRequestAction read(final ByteBuf buffer) {
+        throw new UnsupportedOperationException("Item stack requests are serverbound only");
+    }
+
+    @Override
+    public void write(final ByteBuf buffer, final ItemStackRequestAction value) {
+        // Cereal writes the oneOf variant index before the action's own type field.
+        BedrockTypes.UNSIGNED_VAR_INT.write(buffer, value.getType().getValue());
+        buffer.writeByte(value.getType().getValue());
+        if (value instanceof ItemStackRequestAction.TakeAction action) {
+            buffer.writeByte(action.count());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.source());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.destination());
+        } else if (value instanceof ItemStackRequestAction.PlaceAction action) {
+            buffer.writeByte(action.count());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.source());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.destination());
+        } else if (value instanceof ItemStackRequestAction.SwapAction action) {
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.source());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.destination());
+        } else if (value instanceof ItemStackRequestAction.DropAction action) {
+            buffer.writeByte(action.count());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.item());
+            buffer.writeBoolean(action.randomly());
+        } else if (value instanceof ItemStackRequestAction.DestroyAction action) {
+            buffer.writeByte(action.count());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.item());
+        } else if (value instanceof ItemStackRequestAction.ConsumeAction action) {
+            buffer.writeByte(action.count());
+            InventoryTypes.ITEM_STACK_REQUEST_SLOT.write(buffer, action.item());
+        } else if (value instanceof ItemStackRequestAction.BeaconPaymentAction action) {
+            BedrockTypes.VAR_INT.write(buffer, action.primaryEvent());
+            BedrockTypes.VAR_INT.write(buffer, action.secondaryEvent());
+        } else if (value instanceof ItemStackRequestAction.CraftRecipeAction action) {
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, action.recipeNetworkId());
+            buffer.writeByte(action.numberOfRequestedCrafts());
+        } else if (value instanceof ItemStackRequestAction.CraftRecipeOptionalAction action) {
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, action.recipeNetworkId());
+            BedrockTypes.INT_LE.write(buffer, action.filteredStringIndex());
+        } else if (value instanceof ItemStackRequestAction.CraftResultsDeprecatedAction action) {
+            this.results.write(buffer, action.resultItems().toArray(new BedrockItem[0]));
+            buffer.writeByte(action.timesCrafted());
+        } else {
+            throw new IllegalArgumentException(
+                    "Unsupported item stack action: " + value.getClass().getSimpleName());
+        }
+    }
+
+}
