+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.api.model.container.block;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.ContainerInput;
+import net.raphimc.viabedrock.protocol.data.generated.bedrock.CustomBlockTags;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+
+public final class LecternContainer extends Container {
+
+    private int page;
+    private int totalPages;
+
+    public LecternContainer(
+            final UserConnection user,
+            final byte containerId,
+            final TextComponent title,
+            final BlockPosition position,
+            final CompoundTag blockEntityTag) {
+        super(user, containerId, ContainerType.LECTERN, title, position, 1, CustomBlockTags.LECTERN);
+        this.applyBlockEntity(blockEntityTag, false);
+    }
+
+    public static int javaPage(final CompoundTag blockEntityTag) {
+        return Math.max(0, Math.min(blockEntityTag.getInt("page", 0), 127)) * 2;
+    }
+
+    public static int totalPages(final CompoundTag blockEntityTag) {
+        final int statedPages = blockEntityTag.getInt("totalPages", 0);
+        if (statedPages > 0) {
+            return Math.min(statedPages, 255);
+        }
+        final CompoundTag book = blockEntityTag.getCompoundTag("book");
+        final CompoundTag bookData = book != null ? book.getCompoundTag("tag") : null;
+        final Tag pages = bookData != null ? bookData.get("pages") : null;
+        return pages instanceof ListTag<?> pageList ? Math.min(pageList.size(), 255) : 0;
+    }
+
+    public static int bedrockPage(final int javaPage) {
+        return Math.max(0, javaPage) / 2;
+    }
+
+    public static int pageAfterButton(final int page, final int button, final int totalPages) {
+        final int requestedPage = switch (button) {
+            case 1 -> page - 1;
+            case 2 -> page + 1;
+            default -> button >= 100 ? button - 100 : page;
+        };
+        return Math.max(0, Math.min(requestedPage, Math.max(0, totalPages - 1)));
+    }
+
+    public void updateFromBlockEntity(final CompoundTag blockEntityTag) {
+        this.applyBlockEntity(blockEntityTag, true);
+    }
+
+    private void applyBlockEntity(final CompoundTag blockEntityTag, final boolean notifyClient) {
+        if (blockEntityTag == null) {
+            return;
+        }
+        this.totalPages = totalPages(blockEntityTag);
+        final int newPage = Math.min(javaPage(blockEntityTag), Math.max(0, this.totalPages - 1));
+        if (this.totalPages == 0 || bedrockPage(this.page) != bedrockPage(newPage)) {
+            this.page = newPage;
+            if (notifyClient) {
+                PacketFactory.sendJavaContainerProperties(this.user, this, (short) 0, (short) this.page);
+            }
+        }
+        final CompoundTag bookTag = blockEntityTag.getCompoundTag("book");
+        if (bookTag != null || blockEntityTag.getByte("hasBook", (byte) 0) == 0) {
+            final BedrockItem book = bookTag == null
+                    ? BedrockItem.empty()
+                    : this.user.get(ItemRewriter.class).bedrockItemStack(bookTag);
+            if (!this.items[0].equals(book)) {
+                this.items[0] = book;
+                if (notifyClient) {
+                    PacketFactory.sendJavaContainerSetContent(this.user, this);
+                }
+            }
+        }
+    }
+
+    public void sendInitialState() {
+        final PacketWrapper content = PacketWrapper.create(ClientboundPackets26_3.CONTAINER_SET_CONTENT, this.user);
+        PacketFactory.writeJavaContainerSetContent(content, this);
+        content.scheduleSend(BedrockProtocol.class);
+        final PacketWrapper pageData = PacketWrapper.create(ClientboundPackets26_3.CONTAINER_SET_DATA, this.user);
+        pageData.write(Types.VAR_INT, Byte.toUnsignedInt(this.javaContainerId()));
+        pageData.write(Types.SHORT, (short) 0);
+        pageData.write(Types.SHORT, (short) this.page);
+        pageData.scheduleSend(BedrockProtocol.class);
+    }
+
+    @Override
+    public boolean setItems(final BedrockItem[] items) {
+        return items.length == 0 || super.setItems(items);
+    }
+
+    @Override
+    public boolean handleClick(
+            final int revision,
+            final short javaSlot,
+            final byte button,
+            final ContainerInput action) {
+        return false;
+    }
+
+    @Override
+    public boolean handleButtonClick(final int button) {
+        // Protocol 2193 has no drop-book field in LecternUpdate. Do not predict taking a book.
+        if (button != 1 && button != 2 && button < 100) {
+            return false;
+        }
+        final int newPage = pageAfterButton(this.page, button, this.totalPages);
+        if (newPage == this.page) {
+            return true;
+        }
+        final int previousBedrockPage = bedrockPage(this.page);
+        this.page = newPage;
+        PacketFactory.sendJavaContainerProperties(this.user, this, (short) 0, (short) this.page);
+        if (bedrockPage(newPage) != previousBedrockPage) {
+            this.sendPageUpdate();
+        }
+        return true;
+    }
+
+    public void sendPageUpdate() {
+        final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.LECTERN_UPDATE, this.user);
+        writePageUpdate(packet, bedrockPage(this.page), this.totalPages, this.position);
+        packet.sendToServer(BedrockProtocol.class);
+    }
+
+    static void writePageUpdate(
+            final PacketWrapper packet,
+            final int page,
+            final int totalPages,
+            final BlockPosition position) {
+        packet.write(Types.UNSIGNED_BYTE, (short) page);
+        packet.write(Types.UNSIGNED_BYTE, (short) totalPages);
+        packet.write(BedrockTypes.BLOCK_POSITION, position);
+    }
+
+}
