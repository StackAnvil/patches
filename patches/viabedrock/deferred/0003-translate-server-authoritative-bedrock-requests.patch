+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+
+class LecternContainerTest {
+
+    @Test
+    void pagesInBedrockSpreadsMapToJavaPages() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("page", 2);
+        tag.putInt("totalPages", 5);
+
+        assertEquals(4, LecternContainer.javaPage(tag));
+        assertEquals(2, LecternContainer.bedrockPage(4));
+        assertEquals(2, LecternContainer.bedrockPage(5));
+    }
+
+    @Test
+    void pageButtonsClampToTheActualBookLength() {
+        assertEquals(1, LecternContainer.pageAfterButton(0, 2, 5));
+        assertEquals(0, LecternContainer.pageAfterButton(0, 1, 5));
+        assertEquals(4, LecternContainer.pageAfterButton(4, 2, 5));
+        assertEquals(3, LecternContainer.pageAfterButton(1, 103, 5));
+        assertEquals(4, LecternContainer.pageAfterButton(1, 199, 5));
+        assertEquals(LecternContainer.bedrockPage(0),
+                LecternContainer.bedrockPage(LecternContainer.pageAfterButton(0, 2, 5)));
+        assertNotEquals(LecternContainer.bedrockPage(1),
+                LecternContainer.bedrockPage(LecternContainer.pageAfterButton(1, 2, 5)));
+    }
+
+    @Test
+    void pageCountFallsBackToBookWhenBlockEntityOmitsIt() {
+        final ListTag<CompoundTag> pages = new ListTag<>(CompoundTag.class);
+        for (int index = 0; index < 3; index++) {
+            final CompoundTag page = new CompoundTag();
+            page.putString("text", "Page " + index);
+            pages.add(page);
+        }
+        final CompoundTag bookData = new CompoundTag();
+        bookData.put("pages", pages);
+        final CompoundTag book = new CompoundTag();
+        book.putString("Name", "minecraft:written_book");
+        book.putByte("Count", (byte) 1);
+        book.put("tag", bookData);
+        final CompoundTag blockEntity = new CompoundTag();
+        blockEntity.put("book", book);
+
+        assertEquals(3, LecternContainer.totalPages(blockEntity));
+        assertEquals(2, LecternContainer.pageAfterButton(2, 2, LecternContainer.totalPages(blockEntity)));
+    }
+
+    @Test
+    void pageUpdateWritesTheSpreadAndBookLengthBeforePosition() {
+        final BlockPosition position = new BlockPosition(12, 70, -3);
+        final PacketWrapper packet = new PacketWrapperImpl(0, Unpooled.buffer(), null);
+
+        LecternContainer.writePageUpdate(packet, LecternContainer.bedrockPage(3), 5, position);
+
+        assertEquals((short) 1, packet.get(Types.UNSIGNED_BYTE, 0));
+        assertEquals((short) 5, packet.get(Types.UNSIGNED_BYTE, 1));
+        assertEquals(position, packet.get(BedrockTypes.BLOCK_POSITION, 0));
+    }
+
+}
