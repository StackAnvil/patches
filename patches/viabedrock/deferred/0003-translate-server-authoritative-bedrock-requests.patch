+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class HorseContainer extends Container {
+
+    private final long entityUniqueId;
+    private final int javaEntityId;
+    private final int equipmentSlots;
+    private final int storageColumns;
+    private final Map<Integer, List<EquipmentItem>> acceptedItems = new HashMap<>();
+
+    private HorseContainer(final UserConnection user, final byte containerId, final Entity entity,
+                           final int equipmentSlots, final int storageColumns, final int nativeSize) {
+        super(user, containerId, ContainerType.HORSE,
+                new TranslationComponent("container.horse"), null, nativeSize);
+        this.entityUniqueId = entity.uniqueId();
+        this.javaEntityId = entity.javaId();
+        this.equipmentSlots = equipmentSlots;
+        this.storageColumns = storageColumns;
+    }
+
+    public static HorseContainer create(final UserConnection user, final byte containerId, final Entity entity) {
+        if (entity == null || entity.type() == null) {
+            return null;
+        }
+        final int equipmentSlots;
+        final int storageColumns;
+        final int defaultSize;
+        switch (entity.type()) {
+            case "minecraft:horse" -> {
+                equipmentSlots = 2;
+                storageColumns = 0;
+                defaultSize = 2;
+            }
+            case "minecraft:donkey", "minecraft:mule" -> {
+                equipmentSlots = 1;
+                storageColumns = entity.entityFlags().contains(ActorFlags.CHESTED) ? 5 : 0;
+                defaultSize = 16;
+            }
+            default -> {
+                return null;
+            }
+        }
+        final var sizeData = entity.entityData().get(ActorDataIds.CONTAINER_SIZE);
+        final int nativeSize = sizeData != null && sizeData.value() instanceof Number size
+                && size.intValue() > 0 ? size.intValue() : defaultSize;
+        if (nativeSize < equipmentSlots + storageColumns * 3 || nativeSize > defaultSize) {
+            return null;
+        }
+        return new HorseContainer(user, containerId, entity, equipmentSlots, storageColumns, nativeSize);
+    }
+
+    @Override
+    public boolean setItems(final BedrockItem[] items) {
+        if (items.length == this.equipmentSlots + this.storageColumns * 3 && items.length != this.size()) {
+            final BedrockItem[] complete = BedrockItem.emptyArray(this.size());
+            System.arraycopy(items, 0, complete, 0, items.length);
+            return super.setItems(complete);
+        }
+        return super.setItems(items);
+    }
+
+    public void updateEquipment(final CompoundTag tag) {
+        final ListTag<CompoundTag> slots = tag.getListTag("slots", CompoundTag.class);
+        if (slots == null) {
+            return;
+        }
+        this.acceptedItems.clear();
+        for (final CompoundTag slot : slots) {
+            final int slotNumber = slot.getInt("slotNumber", -1);
+            if (slotNumber < 0 || slotNumber >= this.equipmentSlots) {
+                continue;
+            }
+            final List<EquipmentItem> accepted = new ArrayList<>();
+            final ListTag<CompoundTag> entries = slot.getListTag("acceptedItems", CompoundTag.class);
+            if (entries != null) {
+                for (final CompoundTag entry : entries) {
+                    final CompoundTag item = entry.getCompoundTag("slotItem");
+                    if (item != null && item.getString("Name") != null) {
+                        accepted.add(new EquipmentItem(item.getString("Name"), item.getShort("Aux", Short.MAX_VALUE)));
+                    }
+                }
+            }
+            this.acceptedItems.put(slotNumber, List.copyOf(accepted));
+        }
+    }
+
+    public boolean matches(final byte containerId, final long entityUniqueId) {
+        return this.containerId == containerId && this.entityUniqueId == entityUniqueId;
+    }
+
+    public void writeJavaOpen(final PacketWrapper wrapper) {
+        wrapper.setPacketType(ClientboundPackets26_3.MOUNT_SCREEN_OPEN);
+        wrapper.write(Types.VAR_INT, Byte.toUnsignedInt(this.containerId));
+        wrapper.write(Types.VAR_INT, this.storageColumns);
+        wrapper.write(Types.INT, this.javaEntityId);
+    }
+
+    @Override
+    public int javaSize() {
+        return 2 + this.storageColumns * 3;
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        if (slot < 0 || slot >= this.size()) {
+            return -1;
+        }
+        if (slot < this.equipmentSlots) {
+            return slot;
+        }
+        return slot < this.equipmentSlots + this.storageColumns * 3
+                ? 2 + slot - this.equipmentSlots : -1;
+    }
+
+    @Override
+    public int bedrockSlot(final int javaSlot) {
+        if (javaSlot < 0 || javaSlot >= this.javaSize()) {
+            return -1;
+        }
+        if (javaSlot < 2) {
+            return javaSlot < this.equipmentSlots ? javaSlot : -1;
+        }
+        return this.equipmentSlots + javaSlot - 2;
+    }
+
+    @Override
+    protected BedrockItem[] itemsInJavaOrder(final BedrockItem[] items) {
+        final BedrockItem[] mapped = BedrockItem.emptyArray(this.javaSize());
+        for (int slot = 0; slot < items.length; slot++) {
+            final int javaSlot = this.javaSlot(slot);
+            if (javaSlot >= 0) {
+                mapped[javaSlot] = items[slot];
+            }
+        }
+        return mapped;
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        if (slot < 0 || slot >= this.size()) {
+            throw new IllegalArgumentException("Invalid mount inventory slot: " + slot);
+        }
+        return new FullContainerName(slot < this.equipmentSlots
+                ? ContainerEnumName.HorseEquipContainer : ContainerEnumName.LevelEntityContainer, null);
+    }
+
+    @Override
+    public boolean canPlaceItem(final int slot, final BedrockItem item, final int amount) {
+        if (amount < 0 || amount > item.amount() || this.javaSlot(slot) < 0) {
+            return false;
+        }
+        if (item.isEmpty()) {
+            return true;
+        }
+        if (slot >= this.equipmentSlots) {
+            return true;
+        }
+        final String identifier = this.user.get(ItemRewriter.class).itemIdentifier(item);
+        return this.acceptsEquipment(slot, identifier, item.data());
+    }
+
+    boolean acceptsEquipment(final int slot, final String identifier, final short aux) {
+        final List<EquipmentItem> accepted = this.acceptedItems.get(slot);
+        if (accepted != null) {
+            return accepted.stream().anyMatch(candidate -> candidate.identifier().equals(identifier)
+                    && (candidate.aux() == Short.MAX_VALUE || candidate.aux() == aux));
+        }
+        // A ContainerOpen may precede UpdateEquip. Vanilla rules remain safe until it arrives.
+        return slot == 0 ? "minecraft:saddle".equals(identifier)
+                : identifier != null && identifier.startsWith("minecraft:")
+                && (identifier.startsWith("minecraft:horsearmor") || identifier.endsWith("_horse_armor"));
+    }
+
+    @Override
+    protected List<QuickMoveRange> quickMoveRanges(final short javaSlot, final SlotRef source) {
+        final var inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        if (source.container() != inventory) {
+            return super.quickMoveRanges(javaSlot, source);
+        }
+        final List<QuickMoveRange> ranges = new ArrayList<>();
+        final BedrockItem item = source.container().getItem(source.bedrockSlot());
+        for (int slot = 0; slot < this.equipmentSlots; slot++) {
+            if (this.getItem(slot).isEmpty() && this.canPlaceItem(slot, item, Math.min(item.amount(), this.maxStackSize(slot, item)))) {
+                ranges.add(new QuickMoveRange(this, slot, slot + 1, false));
+                break;
+            }
+        }
+        if (this.storageColumns > 0) {
+            ranges.add(new QuickMoveRange(this, 2, this.javaSize(), false));
+        } else if (ranges.isEmpty()) {
+            // An unchested mount still allows moving between the player's main inventory and hotbar.
+            ranges.add(new QuickMoveRange(inventory, javaSlot < this.javaSize() + 27 ? 36 : 9,
+                    javaSlot < this.javaSize() + 27 ? 45 : 36, false));
+        }
+        return ranges;
+    }
+
+    private record EquipmentItem(String identifier, short aux) { }
+
+}
