+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.player.ArmorContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.api.model.container.player.OffhandContainer;
+
+final class InventoryRequestRecovery {
+
+    private long startedAtNanos;
+    private boolean inventoryRefreshed;
+    private boolean cursorRefreshed;
+    private boolean armorRequired;
+    private boolean armorRefreshed;
+    private boolean offhandRequired;
+    private boolean offhandRefreshed;
+
+    void begin(final long now, final boolean armorRequired, final boolean offhandRequired) {
+        this.startedAtNanos = now;
+        this.inventoryRefreshed = false;
+        this.cursorRefreshed = false;
+        this.armorRequired = armorRequired;
+        this.armorRefreshed = false;
+        this.offhandRequired = offhandRequired;
+        this.offhandRefreshed = false;
+    }
+
+    boolean isActive() {
+        return this.startedAtNanos != 0;
+    }
+
+    boolean hasTimedOut(final long now, final long timeoutNanos) {
+        return this.isActive() && now - this.startedAtNanos >= timeoutNanos;
+    }
+
+    boolean observe(
+            final Container container,
+            final Container hud,
+            final boolean fullContent,
+            final int slot) {
+        if (!this.isActive()) {
+            return false;
+        }
+        if (fullContent && container instanceof InventoryContainer) {
+            this.inventoryRefreshed = true;
+        }
+        if (container == hud && (fullContent || slot == 0)) {
+            this.cursorRefreshed = true;
+        }
+        if (fullContent && container instanceof ArmorContainer) {
+            this.armorRefreshed = true;
+        }
+        if (container instanceof OffhandContainer && (fullContent || slot == 0)) {
+            this.offhandRefreshed = true;
+        }
+        return this.inventoryRefreshed && this.cursorRefreshed
+                && (!this.armorRequired || this.armorRefreshed)
+                && (!this.offhandRequired || this.offhandRefreshed);
+    }
+
+    void reset() {
+        this.startedAtNanos = 0;
+        this.inventoryRefreshed = false;
+        this.cursorRefreshed = false;
+        this.armorRequired = false;
+        this.armorRefreshed = false;
+        this.offhandRequired = false;
+        this.offhandRefreshed = false;
+    }
+
+}
