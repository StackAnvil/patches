+    void matchesNativeMergeDecisionsThroughAllOrdinaryActionPaths() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_CONTAINER_MERGE")))).getAsJsonObject();
+        Fixture fixture = null;
+        Configuration previousProperties = null;
+        for (final var element : reference.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var properties = new Configuration(row.get("stackedByData").getAsBoolean(),
+                    row.get("damageable").getAsBoolean(), row.get("maximum").getAsInt());
+            if (!properties.equals(previousProperties)) {
+                fixture = new Fixture(properties.subtype(), properties.damageable(), properties.maximum());
+                previousProperties = properties;
+            }
+            final var source = fixture.item(row.get("sourceAux").getAsShort(), 4, 11);
+            final var destination = fixture.item(row.get("destinationAux").getAsShort(), 1, 12);
+            if (!row.get("nbtHex").isJsonNull()) {
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+                try {
+                    source.setTag((CompoundTag) BedrockTypes.TAG_LE.read(bytes));
+                    destination.setTag(source.tag().copy());
+                    assertFalse(bytes.isReadable());
+                } finally {
+                    bytes.release();
+                }
+            }
+            final boolean merge = row.get("nativeCanMerge").getAsBoolean();
+            fixture.reset();
+            fixture.inventory.getHudContainer().setItem(0, source.copy());
+            fixture.menu.setItem(9, destination.copy());
+            final var pickup = fixture.click(9, 0, ContainerInput.PICKUP);
+            assertEquals(merge, pickup.actions().getFirst() instanceof ItemStackRequestAction.PlaceAction, row::toString);
+
+            fixture.reset();
+            fixture.menu.setItem(9, source.copy());
+            fixture.inventory.getInventoryContainer().setItem(9, destination.copy());
+            final var quickMove = fixture.click(9, 0, ContainerInput.QUICK_MOVE);
+            final var placement = assertInstanceOf(ItemStackRequestAction.PlaceAction.class, quickMove.actions().getFirst());
+            // Preserve the existing Java quick-move order; this control compares occupied-slot admission.
+            assertEquals(merge ? 9 : 8, placement.destination().slot(), row::toString);
+
+            fixture.reset();
+            fixture.inventory.getHudContainer().setItem(0, source.copy());
+            fixture.menu.setItem(9, destination.copy());
+            fixture.menu.handleClick(0, (short) -999, (byte) 0, ContainerInput.QUICK_CRAFT);
+            fixture.menu.handleClick(0, (short) 9, (byte) 1, ContainerInput.QUICK_CRAFT);
+            fixture.menu.handleClick(0, (short) 10, (byte) 1, ContainerInput.QUICK_CRAFT);
+            final var drag = fixture.click(-999, 2, ContainerInput.QUICK_CRAFT);
+            assertEquals(merge ? 2 : 1, drag.actions().size(), row::toString);
+
+            fixture.reset();
+            fixture.inventory.getHudContainer().setItem(0, destination.copy());
+            fixture.menu.setItem(9, source.copy());
+            final var collect = fixture.click(9, 0, ContainerInput.PICKUP_ALL);
+            assertEquals(merge, collect != null, row::toString);
+        }
+    }
