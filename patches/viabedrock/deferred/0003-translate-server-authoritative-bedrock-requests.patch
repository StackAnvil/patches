+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.libs.mcstructs.text.components.StringComponent;
+import net.raphimc.viabedrock.api.model.container.ChestContainer;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.ContainerOpenContext;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class InventoryContainerGenerationTest {
+
+    @Test
+    void pendingCloseRetainsOriginAndReusedContainerIdGetsNewGeneration() {
+        final UserConnection user = mock(UserConnection.class);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final Container first = container(user);
+        final ContainerOpenContext firstOrigin = origin(47);
+        tracker.setCurrentContainer(first, firstOrigin);
+        assertEquals(1, tracker.currentContainerGeneration());
+        tracker.markPendingClose(first);
+        assertNull(tracker.getCurrentContainer());
+        assertEquals(0, tracker.currentContainerGeneration());
+        assertNull(tracker.currentContainerOpenContext());
+        assertSame(first, tracker.getPendingCloseContainer());
+        assertEquals(1, tracker.pendingCloseContainerGeneration());
+        assertSame(firstOrigin, tracker.pendingCloseContainerOpenContext());
+        assertThrows(IllegalStateException.class, () -> tracker.setCurrentContainer(container(user), origin(48)));
+        tracker.setCurrentContainerClosed(false);
+        assertEquals(0, tracker.pendingCloseContainerGeneration());
+        assertNull(tracker.pendingCloseContainerOpenContext());
+        tracker.setCurrentContainer(container(user), origin(48));
+        assertEquals(2, tracker.currentContainerGeneration());
+        assertEquals(48, tracker.currentContainerOpenContext().actorUniqueId());
+        assertEquals(first.containerId(), tracker.getCurrentContainer().containerId());
+    }
+
+    @Test
+    void competingOrStaleOpeningCannotChangeCurrentIdentity() {
+        final UserConnection user = mock(UserConnection.class);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final Container first = container(user);
+        final Container second = container(user);
+        final ContainerOpenContext initial = origin(47);
+        tracker.setCurrentContainer(first, initial);
+        assertThrows(IllegalStateException.class, () -> tracker.setCurrentContainer(second, origin(48)));
+        assertThrows(IllegalStateException.class, () -> tracker.retainCurrentContainerOpenContext(second, origin(48)));
+        assertSame(first, tracker.getCurrentContainer());
+        assertSame(initial, tracker.currentContainerOpenContext());
+        assertEquals(1, tracker.currentContainerGeneration());
+        tracker.setCurrentContainerClosed(false);
+        tracker.setCurrentContainer(second, origin(48));
+        assertEquals(2, tracker.currentContainerGeneration());
+        assertThrows(IllegalStateException.class, () -> tracker.retainCurrentContainerOpenContext(first, initial));
+        assertEquals(48, tracker.currentContainerOpenContext().actorUniqueId());
+    }
+
+    @Test
+    void openingWithoutNativeOpenPacketDoesNotFabricateItsFields() {
+        final UserConnection user = mock(UserConnection.class);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final Container menu = container(user);
+        tracker.setCurrentContainer(menu);
+        assertEquals(1, tracker.currentContainerGeneration());
+        assertNull(tracker.currentContainerOpenContext());
+        final ContainerOpenContext actualPacket = origin(47);
+        tracker.retainCurrentContainerOpenContext(menu, actualPacket);
+        assertSame(actualPacket, tracker.currentContainerOpenContext());
+        assertEquals(1, tracker.currentContainerGeneration());
+        tracker.markPendingClose(menu);
+        assertSame(actualPacket, tracker.pendingCloseContainerOpenContext());
+    }
+
+    @Test
+    void recoveryClearsActiveAndPendingIdentityWithoutReusingGeneration() {
+        final UserConnection user = mock(UserConnection.class);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        try (var packets = mockStatic(PacketFactory.class)) {
+            final Container menu = container(user);
+            tracker.setCurrentContainer(menu, origin(47));
+            tracker.closeScreenForInventoryRecovery();
+            packets.verify(() -> PacketFactory.sendJavaContainerClose(user, menu.javaContainerId()));
+            packets.verify(() -> PacketFactory.sendBedrockContainerClose(user, menu.containerId(), ContainerType.NONE));
+            assertNull(tracker.getCurrentContainer());
+            assertEquals(0, tracker.currentContainerGeneration());
+            assertNull(tracker.currentContainerOpenContext());
+            tracker.setCurrentContainer(container(user), origin(48));
+            assertEquals(2, tracker.currentContainerGeneration());
+            tracker.markPendingClose(tracker.getCurrentContainer());
+            tracker.closeScreenForInventoryRecovery();
+            assertNull(tracker.getPendingCloseContainer());
+            assertEquals(0, tracker.pendingCloseContainerGeneration());
+            assertNull(tracker.pendingCloseContainerOpenContext());
+            tracker.setCurrentContainer(container(user));
+            assertEquals(3, tracker.currentContainerGeneration());
+            assertNull(tracker.currentContainerOpenContext());
+        }
+    }
+
+    private static Container container(final UserConnection user) {
+        return new ChestContainer(user, (byte) 8, new StringComponent("Menu"), null, 27);
+    }
+
+    private static ContainerOpenContext origin(final long actorUniqueId) {
+        return new ContainerOpenContext((byte) ContainerType.CONTAINER.getValue(), new BlockPosition(1, 64, 2), actorUniqueId);
+    }
+
+}
