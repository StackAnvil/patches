+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.HexFormat;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeItemPermissionsTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PROVIDER_LOCKS", matches = ".+")
+    void matchesInstalledNativeSourceAndIncomingLockPolicies() throws Exception {
+        try (var stream = new GZIPInputStream(Files.newInputStream(Path.of(System.getenv("STACKANVIL_NATIVE_PROVIDER_LOCKS"))));
+             var reader = new InputStreamReader(stream, StandardCharsets.UTF_8)) {
+            final var reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertTrue(reference.getAsJsonArray("remainingAllocations").isEmpty());
+            assertTrue(reference.getAsJsonObject("heldLocks").isEmpty());
+            assertTrue(reference.get("backingCleanupCompleted").getAsBoolean());
+            final var inputs = new ArrayList<BedrockItem>();
+            for (final var element : reference.getAsJsonArray("inputs")) {
+                final var input = element.getAsJsonObject();
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(input.get("nbtHex").getAsString()));
+                try {
+                    final var saved = (CompoundTag) BedrockTypes.TAG_LE.read(bytes);
+                    assertFalse(bytes.isReadable());
+                    final var item = new BedrockItem(257, (short) 0, saved.getByte("Count"));
+                    final var userdata = saved.getCompoundTag("tag");
+                    item.setTag(userdata != null ? userdata.copy() : null);
+                    inputs.add(item);
+                } finally {
+                    bytes.release();
+                }
+            }
+            final var providers = new EnumMap<ContainerEnumName, Provider>(ContainerEnumName.class);
+            for (final var element : reference.getAsJsonArray("sourceRows")) {
+                final var row = element.getAsJsonObject();
+                final var name = ContainerEnumName.getByValue(row.get("collection").getAsInt());
+                final var provider = providers.computeIfAbsent(name, Provider::new);
+                provider.item = inputs.get(row.get("input").getAsInt());
+                assertEquals(row.get("allowed").getAsBoolean(),
+                        provider.canTakeItem(row.get("slot").getAsInt(), row.get("quantity").getAsInt()), row::toString);
+            }
+            for (final var element : reference.getAsJsonArray("incomingRows")) {
+                final var row = element.getAsJsonObject();
+                final var name = ContainerEnumName.getByValue(row.get("collection").getAsInt());
+                final var provider = providers.get(name);
+                final var item = inputs.get(row.get("input").getAsInt());
+                // Absent callbacks retain the separately recorded native default branch.
+                assertEquals(row.get("allowed").getAsBoolean(), provider.canPlaceItem(0, item, item.amount()), row::toString);
+            }
+            for (final var element : reference.getAsJsonArray("lockGetterRows")) {
+                final var row = element.getAsJsonObject();
+                assertEquals(row.get("value").getAsInt(), inputs.get(row.get("input").getAsInt()).itemLockMode(), row::toString);
+            }
+        }
+    }
+
+    /** Read-only slot backing, matching the declared native storage interface. */
+    private static final class Provider extends Container {
+        private final ContainerEnumName name;
+        private BedrockItem item;
+
+        private Provider(final ContainerEnumName name) {
+            super(null, (byte) 0, ContainerType.CONTAINER, null, null, 36);
+            this.name = name;
+        }
+
+        @Override
+        public BedrockItem getItem(final int slot) {
+            return this.item;
+        }
+
+        @Override
+        public FullContainerName getFullContainerName(final int slot) {
+            return new FullContainerName(this.name, null);
+        }
+    }
+
+}
