+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import java.util.function.BiPredicate;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+
+/** Server-owned plan for the ordinary container_items count-one native action. */
+public final class NativeContainerAutoPlacement {
+
+    private NativeContainerAutoPlacement() { }
+
+    public static Plan plan(
+            final Binding binding,
+            final Container current,
+            final long generation,
+            final long presentationSequence,
+            final int sourceSlot,
+            final InventoryContainer inventory,
+            final int maximumStackSize,
+            final BiPredicate<BedrockItem, BedrockItem> canMerge) {
+        if (!binding.current(current, generation, presentationSequence)) {
+            throw new IllegalArgumentException("Native container action belongs to a stale menu");
+        }
+        if (!supported(current)
+                || inventory.size() != 36
+                || maximumStackSize < 1
+                || maximumStackSize > 255
+                || sourceSlot < 0
+                || sourceSlot >= current.size()) {
+            throw new IllegalArgumentException("Unsupported native container action provider");
+        }
+        final BedrockItem source = current.getItem(sourceSlot);
+        if (source.isEmpty() || !hasServerIdentity(source)) {
+            return null;
+        }
+        final var transfer = NativeContainerTransfer.plan(source, inventory.getItems(), maximumStackSize, canMerge,
+                slot -> inventory.canPlaceItem(slot, source, 1)
+                        && (inventory.getItem(slot).isEmpty() || hasServerIdentity(inventory.getItem(slot))));
+        if (transfer == null) {
+            return null;
+        }
+        final var action = new ItemStackRequestAction.PlaceAction(
+                NativeTransferQuantity.ONE.count(source.amount()),
+                current.requestSlotInfo(sourceSlot, source.netId()),
+                inventory.requestSlotInfo(transfer.destinationSlot(), transfer.destinationBefore().isEmpty()
+                        ? 0 : transfer.destinationBefore().netId()));
+        return new Plan(sourceSlot, transfer, action);
+    }
+
+    static boolean supported(final Container container) {
+        if (!NativeStorageContainers.supported(container)) {
+            return false;
+        }
+        final ContainerEnumName requestName = container.getFullContainerName(0).name();
+        return requestName == ContainerEnumName.LevelEntityContainer
+                || container.type() == ContainerType.CONTAINER
+                && (requestName == ContainerEnumName.BarrelContainer || requestName == ContainerEnumName.ShulkerBoxContainer);
+    }
+
+    private static boolean hasServerIdentity(final BedrockItem item) {
+        return item.netId() != null && item.netId() > 0;
+    }
+
+    public record Binding(Container menu, long generation, long presentationSequence) {
+
+        public Binding {
+            if (menu == null || generation <= 0 || presentationSequence <= 0) {
+                throw new IllegalArgumentException("Invalid native container lifetime");
+            }
+        }
+
+        public boolean current(
+                final Container current, final long currentGeneration, final long currentSequence) {
+            return this.menu == current
+                    && this.generation == currentGeneration
+                    && this.presentationSequence == currentSequence;
+        }
+    }
+
+    public record Plan(int sourceSlot, NativeContainerTransfer.Plan transfer,
+                       ItemStackRequestAction.PlaceAction action) { }
+
+}
