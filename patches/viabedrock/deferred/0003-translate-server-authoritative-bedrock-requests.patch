+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.*;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.GameMode;
+import net.raphimc.viabedrock.protocol.data.generated.bedrock.CustomBlockTags;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.recipe.EnchantData;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.logging.Level;
+
+public class EnchantmentContainer extends Container {
+
+    private List<EnchantData> data = List.of();
+
+    public EnchantmentContainer(
+            final UserConnection user, final byte containerId, final TextComponent title, final BlockPosition position) {
+        super(
+                user,
+                containerId,
+                ContainerType.ENCHANTMENT,
+                title,
+                position,
+                2,
+                CustomBlockTags.ENCHANTING_TABLE);
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        return switch (slot) {
+            case 14 -> new FullContainerName(ContainerEnumName.EnchantingInputContainer, null);
+            case 15 -> new FullContainerName(ContainerEnumName.EnchantingMaterialContainer, null);
+            default ->
+                    throw new IllegalArgumentException(
+                            "Invalid slot for Enchantment Container: " + slot);
+        };
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return switch (slot) {
+            case 14 -> 0;
+            case 15 -> 1;
+            default -> super.javaSlot(slot);
+        };
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return switch (slot) {
+            case 0 -> 14;
+            case 1 -> 15;
+            default -> super.bedrockSlot(slot);
+        };
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return slot - 14;
+    }
+
+    @Override
+    public boolean handleButtonClick(final int button) {
+        if (button < 0 || button > 2 || button >= this.data.size()) {
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .log(
+                            Level.WARNING,
+                            "Received invalid enchantment option button click: " + button);
+            return false;
+        }
+
+        final InventoryTracker inventoryTracker = user.get(InventoryTracker.class);
+        final InventoryRequestTracker inventoryRequestTracker = user.get(InventoryRequestTracker.class);
+        final EntityTracker entityTracker = user.get(EntityTracker.class);
+        final GameMode gameMode = entityTracker.getClientPlayer().javaGameMode();
+        final boolean consumesLapis = gameMode == GameMode.SURVIVAL || gameMode == GameMode.ADVENTURE;
+        if (inventoryRequestTracker.hasPending()
+                || !canEnchant(this.data.get(button), this.getItem(14), this.getItem(15),
+                        button + 1, consumesLapis)) {
+            return false;
+        }
+
+        final List<Container> prevContainers = new ArrayList<>();
+        final Container prevCursorContainer = inventoryTracker.getHudContainer().copy();
+
+        prevContainers.add(this.copy());
+
+        final int reqId = inventoryRequestTracker.nextRequestId();
+
+        final List<ItemStackRequestAction> actions = this.requestActions(
+                this.data.get(button), button + 1, consumesLapis, reqId);
+
+        final ItemStackRequestInfo request =
+                new ItemStackRequestInfo(
+                        reqId, actions, List.of(), TextProcessingEventOrigin.unknown);
+
+        inventoryRequestTracker.addRequest(
+                new InventoryRequestStorage(
+                        request,
+                        0,
+                        prevCursorContainer,
+                        prevContainers)); // Store the request to track it later
+        PacketFactory.sendBedrockInventoryRequest(user, new ItemStackRequestInfo[] {request});
+
+        return true;
+    }
+
+    public void setEnchantData(final List<EnchantData> data) {
+        this.data = List.copyOf(data);
+
+        // Send to java client
+        for (int i = 0; i < 3; i++) {
+            final EnchantData d = i < this.data.size() ? this.data.get(i) : null;
+            final EnchantData.Enchantment display = d == null ? null : d.enchantments().stream()
+                    .filter(enchantment -> Enchant_Type.getByValue(enchantment.typeId()) != null)
+                    .findFirst().orElse(null);
+            final Enchant_Type displayType = display == null ? null : Enchant_Type.getByValue(display.typeId());
+            PacketFactory.sendJavaContainerProperties(
+                    this.user, this, (short) i, (short) (d == null ? 0 : d.cost()));
+
+            final String javaEnchant = displayType == null ? null
+                    : BedrockProtocol.MAPPINGS.getBedrockToJavaEnchantments().get(displayType);
+            int javaId = -1;
+            // Update the java item with the enchantment
+            if (javaEnchant != null) {
+                final CompoundTag enchantmentsRegistry =
+                        (CompoundTag)
+                                BedrockProtocol.MAPPINGS
+                                        .getJavaRegistries()
+                                        .get("minecraft:enchantment");
+                final CompoundTag enchantmentEntry = (CompoundTag) enchantmentsRegistry.get(javaEnchant);
+                if (enchantmentEntry == null) {
+                    ViaBedrock.getPlatform()
+                            .getLogger()
+                            .log(
+                                    Level.WARNING,
+                                    "Enchantment entry is null for enchantment " + javaEnchant);
+                } else {
+                    javaId = RegistryUtil.getRegistryIndex(enchantmentsRegistry, enchantmentEntry);
+                }
+            } else if (displayType != null) {
+                ViaBedrock.getPlatform()
+                        .getLogger()
+                        .log(
+                                Level.WARNING,
+                                "Unknown enchantment with id "
+                                        + displayType
+                                        + " and level "
+                                        + display.level());
+            }
+            PacketFactory.sendJavaContainerProperties(
+                    this.user, this, (short) (i + 4), (short) javaId);
+            PacketFactory.sendJavaContainerProperties(
+                    this.user, this, (short) (i + 7), (short) (display == null ? 0 : display.level()));
+        }
+    }
+
+    static BedrockItem resultItem(final BedrockItem input, final EnchantData option) {
+        final BedrockItem result = input.copy();
+        result.setNetId(null);
+        final CompoundTag tag = result.tag() == null ? new CompoundTag() : result.tag();
+        if (tag.get("Damage") == null) {
+            tag.putInt("Damage", 0);
+        }
+        ListTag<CompoundTag> enchantments = tag.getListTag("ench", CompoundTag.class);
+        if (enchantments == null) {
+            enchantments = new ListTag<>(CompoundTag.class);
+            tag.put("ench", enchantments);
+        }
+        for (EnchantData.Enchantment enchantment : option.enchantments()) {
+            final CompoundTag entry = new CompoundTag();
+            entry.putShort("id", (short) enchantment.typeId());
+            entry.putShort("lvl", (short) enchantment.level());
+            enchantments.add(entry);
+        }
+        result.setTag(tag);
+        return result;
+    }
+
+    List<ItemStackRequestAction> requestActions(final EnchantData option, final int lapisCost,
+            final boolean consumesLapis, final int requestId) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeAction(option.netId(), 1));
+        actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(
+                List.of(resultItem(this.getItem(14), option)), 1));
+        actions.add(new ItemStackRequestAction.ConsumeAction(1,
+                new ItemStackRequestSlotInfo(this.getFullContainerName(14), (byte) 14,
+                        this.getItem(14).netId())));
+        actions.add(new ItemStackRequestAction.PlaceAction(1,
+                new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                        (byte) 50, requestId),
+                new ItemStackRequestSlotInfo(this.getFullContainerName(14), (byte) 14, requestId)));
+        if (consumesLapis) {
+            actions.add(new ItemStackRequestAction.ConsumeAction(lapisCost,
+                    new ItemStackRequestSlotInfo(this.getFullContainerName(15), (byte) 15,
+                            this.getItem(15).netId())));
+        }
+        return actions;
+    }
+
+    static boolean canEnchant(final EnchantData option, final BedrockItem input,
+            final BedrockItem material, final int requiredLapis, final boolean consumesLapis) {
+        return option.netId() > 0
+                && !input.isEmpty() && input.netId() != null
+                && (!consumesLapis || (!material.isEmpty() && material.netId() != null
+                        && material.amount() >= requiredLapis));
+    }
+
+}
