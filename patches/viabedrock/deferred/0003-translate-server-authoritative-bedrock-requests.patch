+        auxiliary = (short) Math.max(0, auxiliary);
+        final byte amount = source.get("Count") instanceof ByteTag count ? count.asByte() : 0;
+        CompoundTag userdata = source.get("tag") instanceof CompoundTag data ? data.copy() : null;
+        final ItemStackHeader.Block block = source.get("Block") instanceof CompoundTag state
+                ? context.serializedBlock(state) : context.associatedBlock(definition, auxiliary);
+        if (block != null) {
+            final String blockName = context.blockIdentifier(block);
+            if (!blockName.equals(definition.identifier()) || context.isBlockGroup(name)) {
+                final var selected = registry.lookup(blockName, 0);
+                if (selected.definition() != null) {
+                    definition = registry.definition(selected.definition().id());
+                    auxiliary = (short) selected.auxiliary();
+                    if (definition == null) {
+                        return BedrockItem.empty();
+                    }
+                }
+            }
+        }
+        final var properties = ((ItemDefinitionProperties) definition.receiver()).stacking();
+        if (properties instanceof LegacyItemStackingProperties legacy && legacy.maximumDamage() > 0
+                && (userdata == null || !userdata.contains("Damage"))) {
+            if (userdata == null) {
+                userdata = new CompoundTag();
+            }
+            userdata.putInt("Damage", effectiveAuxiliary(auxiliary, block));
+            auxiliary = 0;
+        }
+        if (effectiveAuxiliary(auxiliary, block) == Short.MAX_VALUE) {
+            auxiliary = 0;
+        }
+        final BedrockItem result;
+        if (target == Target.ITEM_STACK) {
+            // ItemStack reconstructs its base header. ItemInstance assignment preserves the loaded fields.
+            final var header = ItemStackHeader.initialize(definition.id(), auxiliary, Byte.toUnsignedInt(amount), block, false,
+                    context::associatedBlock, registry::definition, registry::canonicalDefinition);
+            result = ItemRegistry.construct(header);
+        } else {
+            result = new BedrockItem(definition, auxiliary, amount);
+            if (block != null) {
+                result.setBlockRuntimeId(block.runtimeId());
+            }
+        }
+        result.setTag(userdata);
+        result.setCanPlace(strings(source, "CanPlaceOn"));
+        result.setCanBreak(strings(source, "CanDestroy"));
+        result.setWasPickedUp(source.get("WasPickedUp") instanceof ByteTag flag && flag.asByte() != 0);
+        return result;
+    }
+
+    private static short effectiveAuxiliary(final short auxiliary, final ItemStackHeader.Block block) {
+        if (block == null || auxiliary == Short.MAX_VALUE) {
+            return auxiliary;
+        }
+        if (block.canonicalAuxiliary() == null) {
+            throw new IllegalArgumentException("Missing native Block auxiliary for saved Item");
+        }
+        return block.canonicalAuxiliary();
+    }
+
+    private static String[] strings(final CompoundTag source, final String key) {
+        if (!(source.get(key) instanceof ListTag<?> list)) {
+            return new String[0];
+        }
+        return list.getValue().stream().map(value -> value instanceof StringTag text ? text.getValue() : "").toArray(String[]::new);
+    }
+
+    private static LegacyIds loadLegacyIds() {
+        final String path = "/assets/viabedrock/data/bedrock/saved_item_ids.json";
+        try (var stream = SavedItemStack.class.getResourceAsStream(path)) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native saved Item IDs");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Saved Item IDs do not match the target protocol");
+            }
+            final Map<Short, String> names = new HashMap<>();
+            data.getAsJsonObject("names").entrySet().forEach(entry -> names.put(Short.parseShort(entry.getKey()), entry.getValue().getAsString()));
+            final Map<LegacyKey, LegacyKey> upgrades = new HashMap<>();
+            for (final var entry : data.getAsJsonArray("upgrades")) {
+                final var row = entry.getAsJsonObject();
+                final var oldKey = new LegacyKey(row.get("oldId").getAsShort(), row.get("oldAux").getAsShort());
+                final var newKey = new LegacyKey(row.get("newId").getAsShort(), row.get("newAux").getAsShort());
+                if (upgrades.put(oldKey, newKey) != null) {
+                    throw new IllegalStateException("Duplicate saved Item ID upgrade");
+                }
+            }
+            return new LegacyIds(Map.copyOf(names), Map.copyOf(upgrades));
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native saved Item IDs", error);
+        }
+    }
+
+    public enum Target {
+        ITEM_INSTANCE, ITEM_STACK
+    }
+
+    public interface Context {
+        ItemRegistry registry();
+
+        ItemStackHeader.Block associatedBlock(NativeItemDefinitions.Definition<?> definition, short auxiliary);
+
+        ItemStackHeader.Block serializedBlock(CompoundTag block);
+
+        String blockIdentifier(ItemStackHeader.Block block);
+
+        boolean isBlockGroup(String identifier);
+    }
+
+    private record LegacyKey(short identifier, short auxiliary) { }
+
+    private record LegacyIds(Map<Short, String> names, Map<LegacyKey, LegacyKey> upgrades) { }
+
+}
