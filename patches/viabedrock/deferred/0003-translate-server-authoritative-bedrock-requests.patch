+    private static final class Fixture implements AutoCloseable {
+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final UserConnection user = mock(UserConnection.class, RETURNS_DEEP_STUBS);
+        private final InventoryTracker inventory;
+        private final InventoryRequestTracker requests;
+        private final PlayerInventoryScreenTracker screens;
+        private final List<PacketWrapper> sent = new ArrayList<>();
+        private final MockedStatic<PacketWrapper> packets = mockStatic(PacketWrapper.class);
+
+        private Fixture() throws Exception {
+            when(this.user.get(any())).thenAnswer(call -> this.storage.get(call.getArgument(0)));
+            when(this.user.getProtocolInfo().getClientState()).thenReturn(State.PLAY);
+            final var channels = new ChannelStorage();
+            channels.addChannels(List.of(PlayerInventoryScreenClose.CHANNEL));
+            this.storage.put(ChannelStorage.class, channels);
+            this.inventory = new InventoryTracker(this.user);
+            this.requests = spy(new InventoryRequestTracker(this.user));
+            this.screens = new PlayerInventoryScreenTracker(this.user);
+            this.storage.put(InventoryTracker.class, this.inventory);
+            this.storage.put(InventoryRequestTracker.class, this.requests);
+            this.storage.put(PlayerInventoryScreenTracker.class, this.screens);
+            final var entities = mock(EntityTracker.class);
+            final var player = mock(ClientPlayerEntity.class);
+            when(player.runtimeId()).thenReturn(101L);
+            when(entities.getClientPlayer()).thenReturn(player);
+            this.storage.put(EntityTracker.class, entities);
+            this.packets.when(() -> PacketWrapper.create(any(PacketType.class), eq(this.user))).thenAnswer(call -> {
+                final var packet = spy(new PacketWrapperImpl(call.getArgument(0, PacketType.class), null, this.user));
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).send(BedrockProtocol.class);
+                doAnswer(send -> {
+                    this.sent.add(packet);
+                    return null;
+                }).when(packet).sendToServer(BedrockProtocol.class);
+                return packet;
+            });
+        }
+
+        private void request(final long opening, final boolean open) {
+            this.screens.request(new PlayerInventoryScreenRequest(opening, open));
+        }
+
+        private InventoryContainer newInventory() {
+            return new InventoryContainer(this.user, (byte) 0, null, this.inventory.getInventoryContainer());
+        }
+
+        private void acknowledge() {
+            final var inventory = this.newInventory();
+            this.inventory.setCurrentContainer(inventory);
+            this.screens.opened();
+            this.requests.handleInventoryOpen(inventory);
+        }
+
+        private long opens() {
+            return this.sent.stream().filter(p -> p.getPacketType() == ServerboundBedrockPackets.INTERACT).count();
+        }
+
+        private List<Long> closedScreens() {
+            return this.sent.stream().filter(p -> p.getPacketType() != ServerboundBedrockPackets.CONTAINER_CLOSE
+                            && p.getPacketType() != ServerboundBedrockPackets.INTERACT)
+                    .map(p -> p.get(PlayerInventoryScreenClose.TYPE, 0).opening()).toList();
+        }
+
+        @Override
+        public void close() {
+            this.packets.close();
+        }
+    }
+
+}
