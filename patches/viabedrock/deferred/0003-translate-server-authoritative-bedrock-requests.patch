+        final ByteBuf output = Unpooled.buffer();
+        try {
+            final PacketWrapper packet = fixture.translate(ClientboundBedrockPackets.UPDATE_EQUIP, input);
+            packet.writeToBuffer(output);
+            assertEquals(ClientboundPackets26_3.MOUNT_SCREEN_OPEN.getId(), Types.VAR_INT.read(output));
+            assertEquals(8, Types.VAR_INT.read(output));
+            assertEquals(5, Types.VAR_INT.read(output));
+            assertEquals(47, Types.INT.read(output));
+            assertEquals(0, input.readableBytes());
+            assertEquals(0, output.readableBytes());
+            assertEquals(16, fixture.inventory.getCurrentContainer().size());
+            assertEquals(17, fixture.inventory.getCurrentContainer().javaSize());
+            assertEquals(1, fixture.inventory.currentContainerGeneration());
+            assertNull(fixture.inventory.currentContainerOpenContext());
