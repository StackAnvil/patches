+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemStackHeaderTest {
+
+    @Test
+    void runtimeOwnershipWinsBeforeAssociatedAuxiliaryResolution() {
+        final var registry = new ItemRegistry(new ItemEntry[0]);
+        final var runtime = new ItemStackHeader.Block(Integer.MIN_VALUE, 1, (short) 0);
+        final var header = ItemStackHeader.fromNetwork(1, Short.MAX_VALUE, (byte) 1, runtime,
+                (definition, auxiliary) -> {
+                    throw new AssertionError("A matching runtime Block does not resolve associated auxiliary data");
+                }, registry::definition, registry::canonicalDefinition);
+        assertEquals(new ItemStackHeader(registry.definition(1), (short) 0, (byte) 1, runtime), header);
+        assertNull(ItemStackHeader.fromNetwork(1, (short) 0, (byte) 1, runtime,
+                (definition, auxiliary) -> {
+                    throw new AssertionError("A missing Item does not resolve associated auxiliary data");
+                }, id -> null, registry::canonicalDefinition));
+    }
+
+    @Test
+    void metadataIndependentDefinitionsRetainRuntimeBlocksWithoutAnArchetypeConverter() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:item", 30000, false, ItemVersion.Legacy, null)});
+        final var runtime = new ItemStackHeader.Block(7, 30000, null);
+        final var result = ItemStackHeader.fromNetwork(30000, (short) 3, (byte) 1, runtime,
+                (definition, auxiliary) -> {
+                    throw new AssertionError("A matching runtime Block does not need an associated converter");
+                }, registry::definition, registry::canonicalDefinition);
+        assertSame(runtime, result.block());
+        assertSame(registry.definition(30000), result.definition());
+        assertThrows(IllegalArgumentException.class, () -> registry.canonicalDefinition(registry.definition("minecraft:coal"), null));
+    }
+
+    @Test
+    void associatedBlocksRetainRuntimeZeroAndSeparateOrdinaryItemOwnership() {
+        final var registry = new ItemRegistry(new ItemEntry[0]);
+        final var associated = new ItemStackHeader.Block(0, 65233, (short) 0);
+        final var runtime = new ItemStackHeader.Block(7, 2, (short) 0);
+        assertEquals(new ItemStackHeader(registry.definition(65233), (short) 0, (byte) 1, associated),
+                ItemStackHeader.fromNetwork(1, Short.MIN_VALUE, (byte) 1, runtime, (definition, auxiliary) -> associated,
+                        registry::definition, registry::canonicalDefinition));
+        assertEquals(new ItemStackHeader(registry.definition(65233), Short.MAX_VALUE, (byte) 1, associated),
+                ItemStackHeader.fromNetwork(1, Short.MAX_VALUE, (byte) 1, runtime, (definition, auxiliary) -> associated,
+                        registry::definition, registry::canonicalDefinition));
+        assertEquals(new ItemStackHeader(registry.definition(321), (short) 0, (byte) 1, associated),
+                ItemStackHeader.fromNetwork(321, Short.MAX_VALUE, (byte) 1, runtime, (definition, auxiliary) -> associated,
+                        registry::definition, registry::canonicalDefinition));
+        assertEquals(new ItemStackHeader(registry.definition(321), (short) 3, (byte) 1, null),
+                ItemStackHeader.fromNetwork(321, (short) 3, (byte) 1, new ItemStackHeader.Block(0, 1, (short) 0),
+                        (definition, auxiliary) -> null, registry::definition, registry::canonicalDefinition));
+        assertNull(ItemStackHeader.fromNetwork(1, (short) 3, (byte) 1, null, (definition, auxiliary) -> associated,
+                id -> id == 1 ? registry.definition(1) : null, registry::canonicalDefinition));
+        assertEquals(new ItemStackHeader(null, Short.MAX_VALUE, (byte) 0, null),
+                ItemStackHeader.fromNetwork(1, Short.MAX_VALUE, (byte) 0, new ItemStackHeader.Block(7, 1, (short) 0),
+                        (definition, auxiliary) -> associated, registry::definition, registry::canonicalDefinition));
+    }
+
