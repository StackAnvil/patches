+                    this.user().get(InventoryTracker.class).getInventoryContainer());
+        }
+        if (!this.hasPending()) {
+            return;
+        }
+        final long now = System.nanoTime();
+        if (this.recovery.isActive()) {
+            if (this.recovery.hasTimedOut(now, RECOVERY_TIMEOUT_NANOS)) {
