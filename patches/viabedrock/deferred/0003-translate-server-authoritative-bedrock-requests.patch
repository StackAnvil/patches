+    private ItemStackRequestAction handleSwapClick(
+            final ClickContext clickContext, final short javaSlot, final byte button) {
+        if (button < 0 || button > 8) {
+            return null;
+        }
+        final SlotRef source = this.resolveJavaSlot(clickContext, javaSlot);
+        if (source == null) {
+            return null;
+        }
+        final Container container = source.container();
+        final int sourceSlot = source.bedrockSlot();
+        final Container hotbarContainer = clickContext.inventoryTracker.getInventoryContainer();
+        if (container == hotbarContainer && sourceSlot == button) {
+            return null;
+        }
+        clickContext.snapshot(container);
+        clickContext.snapshot(hotbarContainer);
+
+        final BedrockItem item = container.getItem(sourceSlot).copy();
+        final BedrockItem hotbarItem = hotbarContainer.getItem(button).copy();
+
+        if (item.isEmpty() && hotbarItem.isEmpty()) {
+            return null;
+        }
+
+        container.setItem(sourceSlot, hotbarItem);
+        hotbarContainer.setItem(button, item);
+
+        if (hotbarItem.isEmpty()) {
+            return new ItemStackRequestAction.PlaceAction(
+                    item.amount(),
+                    new ItemStackRequestSlotInfo(
+                            container.getFullContainerName(sourceSlot),
+                            (byte) sourceSlot,
+                            item.netId()),
+                    new ItemStackRequestSlotInfo(
+                            hotbarContainer.getFullContainerName(button), button, 0));
+        } else if (item.isEmpty()) {
+            return new ItemStackRequestAction.PlaceAction(
+                    hotbarItem.amount(),
+                    new ItemStackRequestSlotInfo(
+                            hotbarContainer.getFullContainerName(button),
+                            button,
+                            hotbarItem.netId()),
+                    new ItemStackRequestSlotInfo(
+                            container.getFullContainerName(sourceSlot), (byte) sourceSlot, 0));
+        }
+
+        return new ItemStackRequestAction.SwapAction(
+                new ItemStackRequestSlotInfo(
+                        hotbarContainer.getFullContainerName(button), button, hotbarItem.netId()),
+                new ItemStackRequestSlotInfo(
+                        container.getFullContainerName(sourceSlot),
+                        (byte) sourceSlot,
+                        item.netId()));
