+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+/** Native transfer quantity decoding, after source validation and available-count resolution. */
+public record NativeTransferQuantity(int kind, int value) {
+
+    public static final NativeTransferQuantity ALL = new NativeTransferQuantity(1, 0);
+    public static final NativeTransferQuantity HALF = new NativeTransferQuantity(1, 1);
+    public static final NativeTransferQuantity ONE = new NativeTransferQuantity(1, 2);
+
+    /**
+     * Resolve the descriptor before source-count and destination-capacity limits are applied.
+     * The native executor narrows its resolved available count to an unsigned byte here.
+     * In particular, the one modes return one even for zero at this internal boundary;
+     * callers must reject an empty source before decoding a transfer.
+     */
+    public int count(final int available) {
+        final int count = available & 0xFF;
+        return switch (this.kind) {
+            case 0 -> Math.max(0, Math.min(count, this.value));
+            case 1 -> switch (this.value) {
+                case 0 -> count;
+                case 1 -> (count + 1) >>> 1;
+                case 2 -> 1;
+                default -> 0;
+            };
+            case 2 -> switch (this.value) {
+                case 0 -> count;
+                case 1 -> 1;
+                default -> 0;
+            };
+            default -> 0;
+        };
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/RecipeIngredientMatcher.java b/src/main/java/net/raphimc/viabedrock/api/model/container/RecipeIngredientMatcher.java
