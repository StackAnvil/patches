+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class HorseContainer extends Container {
+
+    private final long entityUniqueId;
+    private final int javaEntityId;
+    private final int equipmentSlots;
+    private final int storageColumns;
+    private final Map<Integer, List<EquipmentItem>> acceptedItems = new HashMap<>();
+
+    private HorseContainer(final UserConnection user, final byte containerId, final Entity entity,
+                           final int equipmentSlots, final int storageColumns, final int nativeSize) {
+        super(user, containerId, ContainerType.HORSE,
+                new TranslationComponent("container.horse"), null, nativeSize);
+        this.entityUniqueId = entity.uniqueId();
+        this.javaEntityId = entity.javaId();
+        this.equipmentSlots = equipmentSlots;
+        this.storageColumns = storageColumns;
+    }
+
+    public static HorseContainer create(final UserConnection user, final byte containerId, final Entity entity) {
+        if (entity == null || entity.type() == null) {
+            return null;
+        }
+        final int equipmentSlots;
+        final int storageColumns;
+        final int defaultSize;
+        switch (entity.type()) {
+            case "minecraft:horse" -> {
+                equipmentSlots = 2;
+                storageColumns = 0;
+                defaultSize = 2;
+            }
+            case "minecraft:donkey", "minecraft:mule" -> {
+                equipmentSlots = 1;
+                storageColumns = entity.entityFlags().contains(ActorFlags.CHESTED) ? 5 : 0;
+                defaultSize = 16;
+            }
+            default -> {
+                return null;
+            }
+        }
+        final var sizeData = entity.entityData().get(ActorDataIds.CONTAINER_SIZE);
+        final int nativeSize = sizeData != null && sizeData.value() instanceof Number size
+                && size.intValue() > 0 ? size.intValue() : defaultSize;
+        if (nativeSize < equipmentSlots + storageColumns * 3 || nativeSize > defaultSize) {
+            return null;
+        }
+        return new HorseContainer(user, containerId, entity, equipmentSlots, storageColumns, nativeSize);
+    }
+
+    @Override
+    public boolean setItems(final BedrockItem[] items) {
+        if (items.length == this.equipmentSlots + this.storageColumns * 3 && items.length != this.size()) {
+            final BedrockItem[] complete = BedrockItem.emptyArray(this.size());
+            System.arraycopy(items, 0, complete, 0, items.length);
+            return super.setItems(complete);
+        }
+        return super.setItems(items);
+    }
+
+    public void updateEquipment(final CompoundTag tag) {
+        final ListTag<CompoundTag> slots = tag.getListTag("slots", CompoundTag.class);
+        if (slots == null) {
+            return;
+        }
+        this.acceptedItems.clear();
+        for (final CompoundTag slot : slots) {
+            final int slotNumber = slot.getInt("slotNumber", -1);
+            if (slotNumber < 0 || slotNumber >= this.equipmentSlots) {
+                continue;
+            }
+            final List<EquipmentItem> accepted = new ArrayList<>();
+            final ListTag<CompoundTag> entries = slot.getListTag("acceptedItems", CompoundTag.class);
+            if (entries != null) {
+                for (final CompoundTag entry : entries) {
+                    final CompoundTag item = entry.getCompoundTag("slotItem");
+                    if (item != null && item.getString("Name") != null) {
+                        accepted.add(new EquipmentItem(item.getString("Name"), item.getShort("Aux", Short.MAX_VALUE)));
+                    }
+                }
+            }
+            this.acceptedItems.put(slotNumber, List.copyOf(accepted));
+        }
+    }
+
+    public boolean matches(final byte containerId, final long entityUniqueId) {
+        return this.containerId == containerId && this.entityUniqueId == entityUniqueId;
+    }
+
+    public void writeJavaOpen(final PacketWrapper wrapper) {
+        wrapper.setPacketType(ClientboundPackets26_3.MOUNT_SCREEN_OPEN);
+        wrapper.write(Types.VAR_INT, Byte.toUnsignedInt(this.containerId));
+        wrapper.write(Types.VAR_INT, this.storageColumns);
