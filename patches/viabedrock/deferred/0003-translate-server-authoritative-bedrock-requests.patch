+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeArmorPermissionsTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ARMOR_REMOVAL", matches = ".+")
+    void matchesOriginalArmorSourceDecisionsWithTypedItemsAndActorModes() throws Exception {
+        try (var stream = new GZIPInputStream(Files.newInputStream(Path.of(System.getenv("STACKANVIL_NATIVE_ARMOR_REMOVAL"))));
+             var reader = new InputStreamReader(stream, StandardCharsets.UTF_8)) {
+            final var reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertTrue(reference.getAsJsonArray("remainingAllocations").isEmpty());
+            assertTrue(reference.getAsJsonObject("heldLocks").isEmpty());
+            assertTrue(reference.get("backingCleanupCompleted").getAsBoolean());
+            final var user = mock(UserConnection.class);
+            final var entities = mock(EntityTracker.class);
+            final var player = mock(ClientPlayerEntity.class);
+            final var game = mock(GameSessionStorage.class);
+            when(user.get(EntityTracker.class)).thenReturn(entities);
+            when(user.get(GameSessionStorage.class)).thenReturn(game);
+            final Container armor = new ArmorContainer(user);
+            final var inputs = new ArrayList<BedrockItem>();
+            for (final var element : reference.getAsJsonArray("inputs")) {
+                final var input = element.getAsJsonObject();
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(input.get("nbtHex").getAsString()));
+                try {
+                    final var saved = (CompoundTag) BedrockTypes.TAG_LE.read(bytes);
+                    assertFalse(bytes.isReadable());
+                    final var item = new BedrockItem(1, (short) 0, saved.getByte("Count"));
+                    final var userdata = saved.getCompoundTag("tag");
+                    item.setTag(userdata != null ? userdata.copy() : null);
+                    assertEquals(input.get("nativeCount").getAsInt(), item.amount());
+                    assertEquals(input.get("nativeLock").getAsInt(), item.itemLockMode());
+                    if (!item.isEmpty()) {
+                        assertEquals(input.get("nativeHasBinding").getAsBoolean(),
+                                item.enchantmentLevel(Enchant_Type.CurseOfBinding) > 0, input::toString);
+                    }
+                    inputs.add(item);
+                } finally {
+                    bytes.release();
+                }
+            }
+            int previousInput = -1;
+            int previousMode = -1;
+            for (final var element : reference.getAsJsonArray("sourceRows")) {
+                final var row = element.getAsJsonObject();
+                final int inputIndex = row.get("input").getAsInt();
+                final int modeIndex = row.get("mode").getAsInt();
+                if (inputIndex != previousInput) {
+                    // Declared slot contents match the native read-only storage interface.
+                    final var slots = BedrockItem.emptyArray(armor.size());
+                    Arrays.fill(slots, inputs.get(inputIndex));
+                    armor.setItems(slots);
+                    previousInput = inputIndex;
+                }
+                if (modeIndex != previousMode) {
+                    final var mode = reference.getAsJsonArray("modes").get(modeIndex).getAsJsonObject();
+                    when(entities.getClientPlayer()).thenReturn(mode.get("state").getAsString().equals("present") ? player : null);
+                    when(player.gameType()).thenReturn(GameType.getByValue(mode.get("nativeRaw").getAsInt(), GameType.Undefined));
+                    when(game.getLevelGameType()).thenReturn(GameType.getByValue(mode.get("fallback").getAsInt(), GameType.Undefined));
+                    previousMode = modeIndex;
+                }
+                assertEquals(row.get("allowed").getAsBoolean(),
+                        armor.canTakeItem(row.get("slot").getAsInt(), row.get("quantity").getAsInt()), row::toString);
+            }
+        }
+    }
+
+}
