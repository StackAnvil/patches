+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.EnumMap;
+import java.util.HexFormat;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeDiscardPermissionsTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_DISCARD", matches = ".+")
+    void matchesOriginalSourceAndDiscardPredicatesThroughNativeWeakViews() throws Exception {
+        try (var stream = new GZIPInputStream(Files.newInputStream(Path.of(System.getenv("STACKANVIL_NATIVE_DISCARD"))));
+             var reader = new InputStreamReader(stream, StandardCharsets.UTF_8)) {
+            final var reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertTrue(reference.getAsJsonArray("remainingAllocations").isEmpty());
+            assertTrue(reference.getAsJsonObject("heldLocks").isEmpty());
+            assertTrue(reference.get("backingCleanupCompleted").getAsBoolean());
+            assertTrue(reference.get("nativeViewsCleanupCompleted").getAsBoolean());
+            assertTrue(reference.get("foreignRootPinsReturnedToBaseline").getAsBoolean());
+            final var user = mock(UserConnection.class);
+            final var entities = mock(EntityTracker.class);
+            final var player = mock(ClientPlayerEntity.class);
+            final var game = mock(GameSessionStorage.class);
+            when(user.get(EntityTracker.class)).thenReturn(entities);
+            when(user.get(GameSessionStorage.class)).thenReturn(game);
+            final var providers = new EnumMap<ContainerEnumName, Container>(ContainerEnumName.class);
+            for (final var value : reference.getAsJsonArray("providers")) {
+                final var name = ContainerEnumName.getByValue(value.getAsInt());
+                providers.put(name, name == ContainerEnumName.ArmorContainer ? new ArmorContainer(user)
+                        : new Container(user, (byte) 0, ContainerType.CONTAINER, null, null, 36) {
+                            @Override
+                            public FullContainerName getFullContainerName(final int slot) {
+                                return new FullContainerName(name, null);
+                            }
+                        });
+            }
+            final var inputs = new ArrayList<BedrockItem>();
+            for (final var element : reference.getAsJsonArray("inputs")) {
+                final var input = element.getAsJsonObject();
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(input.get("nbtHex").getAsString()));
+                try {
+                    final var saved = (CompoundTag) BedrockTypes.TAG_LE.read(bytes);
+                    assertFalse(bytes.isReadable());
+                    final var item = new BedrockItem(1, (short) 0, saved.getByte("Count"));
+                    final var data = saved.getCompoundTag("tag");
+                    item.setTag(data != null ? data.copy() : null);
+                    assertEquals(input.get("nativeCount").getAsInt(), item.amount());
+                    assertEquals(input.get("nativeLock").getAsInt(), item.itemLockMode());
+                    inputs.add(item);
+                } finally {
+                    bytes.release();
+                }
+            }
+            int previousInput = -1;
+            int previousMode = -1;
+            for (final var element : reference.getAsJsonArray("rows")) {
+                final var row = element.getAsJsonObject();
+                final int input = row.get("input").getAsInt();
+                if (input != previousInput) {
+                    for (final var provider : providers.values()) {
+                        final var slots = BedrockItem.emptyArray(provider.size());
+                        Arrays.fill(slots, inputs.get(input));
+                        provider.setItems(slots);
+                    }
+                    previousInput = input;
+                }
+                final int mode = row.get("mode").getAsInt();
+                if (mode != previousMode) {
+                    final var state = reference.getAsJsonArray("modes").get(mode).getAsJsonObject();
+                    when(entities.getClientPlayer()).thenReturn(state.get("state").getAsString().equals("present") ? player : null);
+                    when(player.gameType()).thenReturn(GameType.getByValue(state.get("nativeRaw").getAsInt(), GameType.Undefined));
+                    when(game.getLevelGameType()).thenReturn(GameType.getByValue(state.get("fallback").getAsInt(), GameType.Undefined));
+                    previousMode = mode;
+                }
+                final var provider = providers.get(ContainerEnumName.getByValue(row.get("collection").getAsInt()));
+                final int slot = row.get("slot").getAsInt();
+                final int quantity = row.get("quantity").getAsInt();
+                assertEquals(row.get("source").getAsBoolean(), provider.canTakeItem(slot, quantity), row::toString);
+                assertEquals(row.get("allowed").getAsBoolean(), provider.canDiscardItem(slot, quantity), row::toString);
+            }
+        }
+    }
+
+}
