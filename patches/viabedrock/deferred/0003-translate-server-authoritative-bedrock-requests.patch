+
+class InventoryRequestTrackerQueueTest {
+
+    @Test
+    void queuedClicksUseStateUpdatedByThePreviousResponse() {
+        final Fixture fixture = new Fixture();
+        fixture.container.netId = 11;
+        assertTrue(fixture.requests.queueClick(fixture.container, 0, (short) 0, (byte) 0, ContainerInput.PICKUP));
+        assertTrue(fixture.requests.queueClick(fixture.container, 1, (short) 1, (byte) 0, ContainerInput.PICKUP));
+
+        fixture.requests.drainQueuedInteractions();
+        assertEquals(List.of(11), fixture.container.netIdsAtClick);
+        assertTrue(fixture.requests.hasPending());
+
+        fixture.container.netId = 37;
+        fixture.requests.removeRequest(fixture.container.requestIds.get(0));
+        fixture.requests.drainQueuedInteractions();
+        assertEquals(List.of(11, 37), fixture.container.netIdsAtClick);
+        assertTrue(fixture.requests.hasPending());
+    }
+
+    @Test
+    void closingTheOriginalScreenDiscardsQueuedClicks() {
+        final Fixture fixture = new Fixture();
+        assertTrue(fixture.requests.queueClick(fixture.container, 0, (short) 0, (byte) 0, ContainerInput.PICKUP));
+
+        fixture.inventory.markPendingClose(fixture.container);
+        fixture.requests.drainQueuedInteractions();
+
+        assertTrue(fixture.container.netIdsAtClick.isEmpty());
+        assertFalse(fixture.requests.hasPending());
+    }
+
+    @Test
+    void globalInventoryInteractionsWaitForOpenAcknowledgementAfterLocalScreenClose() {
+        final Fixture fixture = new Fixture();
+        final List<Integer> applied = new ArrayList<>();
+        assertTrue(fixture.requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+            @Override
+            public Container container() {
