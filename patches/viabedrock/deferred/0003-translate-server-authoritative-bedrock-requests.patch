+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Waits for full item data absent from a successful crafting acknowledgment. */
+final class CraftedItemSynchronization {
+
+    private final Set<Target> targets;
+    private final Set<Container> inventories;
+    private final Set<Target> refreshedTargets = new HashSet<>();
+
+    private CraftedItemSynchronization(final Set<Target> targets, final InventoryTracker inventory) {
+        this.targets = new HashSet<>(targets);
+        this.inventories = new HashSet<>(List.of(inventory.getInventoryContainer(),
+                inventory.getHudContainer(), inventory.getArmorContainer(), inventory.getOffhandContainer()));
+    }
+
+    static CraftedItemSynchronization from(final InventoryRequestStorage request,
+                                           final ItemStackResponseInfo response,
+                                           final InventoryTracker inventory) {
+        final Set<Target> targets = new HashSet<>();
+        for (final ItemStackRequestAction action : request.requestInfo().actions()) {
+            final ItemStackRequestSlotInfo source;
+            final ItemStackRequestSlotInfo destination;
+            if (action instanceof ItemStackRequestAction.TakeAction take) {
+                source = take.source();
+                destination = take.destination();
+            } else if (action instanceof ItemStackRequestAction.PlaceAction place) {
+                source = place.source();
+                destination = place.destination();
+            } else {
+                continue;
+            }
+            if (source.container().name() != ContainerEnumName.CreatedOutputContainer) {
+                continue;
+            }
+            final int requestSlot = Byte.toUnsignedInt(destination.slot());
+            final Container target = inventory.getContainerFromName(destination.container(), requestSlot);
+            if (target == null || !target.ownsBedrockSlot(destination.container(), requestSlot)) {
+                continue;
+            }
+            final int slot = target.slotFromRequest(requestSlot);
+            for (final var containerInfo : response.containers()) {
+                for (final var slotInfo : containerInfo.slots()) {
+                    final int responseSlot = Byte.toUnsignedInt(slotInfo.slot());
+                    final Container container = inventory.getContainerFromName(
+                            containerInfo.containerName(), responseSlot);
+                    if (container == target && container.ownsBedrockSlot(containerInfo.containerName(), responseSlot)
+                            && container.slotFromRequest(responseSlot) == slot && slotInfo.amount() != 0) {
+                        targets.add(new Target(target, slot, slotInfo.itemNetId(),
+                                Byte.toUnsignedInt(slotInfo.amount())));
+                    }
+                }
+            }
+        }
+        return targets.isEmpty() ? null : new CraftedItemSynchronization(targets, inventory);
+    }
+
+    void observe(final Container container, final boolean fullContent, final int slot) {
+        if (fullContent) {
+            this.inventories.remove(container);
+        }
+        for (final Target target : this.targets) {
+            if (target.container() == container && (fullContent || target.slot() == slot)) {
+                if (target.matches()) {
+                    this.refreshedTargets.add(target);
+                } else {
+                    this.refreshedTargets.remove(target);
+                }
+            }
+        }
+    }
+
+    boolean isComplete() {
+        return this.refreshedTargets.containsAll(this.targets) && this.inventories.isEmpty();
+    }
+
+    private record Target(Container container, int slot, int networkId, int amount) {
+
+        boolean matches() {
+            final BedrockItem item = this.container.getItem(this.slot);
+            return !item.isEmpty() && item.netId() != null
+                    && item.netId() == this.networkId && item.amount() == this.amount;
+        }
+    }
+
+}
