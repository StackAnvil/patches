+
+class InventoryRequestTrackerTest {
+
+    @Test
+    void successfulOffhandResponseOverridesContentReceivedDuringPredictionBeforeQueuedPlacement() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+        final InventoryTracker inventory = new InventoryTracker(user);
+        final InventoryRequestTracker requests = new InventoryRequestTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        inventory.setCurrentContainer(inventory.getInventoryContainer());
+        requests.setPredictingClick(true);
+        final BedrockItem shield = new BedrockItem(358);
+        shield.setAmount(1);
+        shield.setNetId(2);
+        inventory.getOffhandContainer().setItem(0, shield.copy());
+        final Container previousOffhand = inventory.getOffhandContainer().copy();
+        final Container previousCursor = inventory.getHudContainer().copy();
+        final int takeId = requests.nextRequestId();
+        requests.addRequest(new InventoryRequestStorage(new ItemStackRequestInfo(takeId,
+                List.of(), List.of(), TextProcessingEventOrigin.unknown), 0, previousCursor,
+                List.of(previousOffhand)));
+        inventory.getOffhandContainer().setItem(0, BedrockItem.empty());
+        inventory.getHudContainer().setItem(0, shield.copy());
+        requests.getRequest(takeId).capturePrediction(inventory);
+
+        // The inventory-open snapshot arrives after the locally predicted take.
+        inventory.getOffhandContainer().setItems(new BedrockItem[] {shield.copy()});
+        inventory.getOffhandContainer().markServerUpdate();
+        inventory.getHudContainer().setItem(0, shield.copy());
+        inventory.getHudContainer().markServerUpdate();
+        final List<ItemStackRequestAction.PlaceAction> placements = new ArrayList<>();
+        assertTrue(requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+            @Override
+            public Container container() {
+                return inventory.getInventoryContainer();
+            }
+
+            @Override
+            public boolean apply() {
+                final BedrockItem cursor = inventory.getHudContainer().getItem(0);
+                placements.add(new ItemStackRequestAction.PlaceAction(cursor.amount(),
+                        inventory.getHudContainer().requestSlotInfo(0, cursor.netId()),
+                        this.container().requestSlotInfo(9, 0)));
+                final InventoryRequestStorage placement = new InventoryRequestStorage(new ItemStackRequestInfo(
+                        requests.nextRequestId(), List.of(), List.of(), TextProcessingEventOrigin.unknown),
+                        0, inventory.getHudContainer().copy(), List.of(this.container().copy()));
+                requests.addRequest(placement);
+                placement.capturePrediction(inventory);
+                return true;
+            }
+        }));
+        requests.drainQueuedInteractions();
+        assertTrue(placements.isEmpty());
+
+        requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success, takeId,
+                List.of(new ItemStackResponseContainerInfo(
+                                new FullContainerName(ContainerEnumName.OffhandContainer, null),
+                                List.of(new ItemStackResponseSlotInfo((byte) 1, (byte) 1, (byte) 0,
+                                        0, "", null, 0))),
+                        new ItemStackResponseContainerInfo(
+                                new FullContainerName(ContainerEnumName.CursorContainer, null),
+                                List.of(new ItemStackResponseSlotInfo((byte) 0, (byte) 0, (byte) 1,
+                                        3, "", null, 0))))), requests.getRequest(takeId));
+        requests.removeRequest(takeId);
+        requests.drainQueuedInteractions();
+
+        assertTrue(inventory.getOffhandContainer().getItem(0).isEmpty());
+        assertEquals(1, inventory.getHudContainer().getItem(0).amount());
+        assertEquals(3, inventory.getHudContainer().getItem(0).netId());
+        assertEquals(1, placements.size());
+        assertEquals(3, placements.get(0).source().stackNetworkId());
+        assertTrue(requests.hasPending());
+        requests.drainQueuedInteractions();
+        assertEquals(1, placements.size());
+    }
+
+    @Test
+    void inventoryOpenWithoutScreenClicksRemainsPendingUntilAcknowledgedOrExpired() {
+        final InventoryRequestTracker.PendingInventoryOpenClicks pending =
+                new InventoryRequestTracker.PendingInventoryOpenClicks();
+        assertTrue(pending.begin(100));
+        assertFalse(pending.begin(104));
+        assertTrue(pending.isWaiting());
+        assertFalse(pending.expire(104, 5));
+        assertTrue(pending.expire(105, 5));
+        assertFalse(pending.isWaiting());
+
+        assertTrue(pending.begin(200));
+        assertTrue(pending.drain().isEmpty());
+        assertFalse(pending.isWaiting());
+    }
+
+    @Test
+    void successfulResponseRestoresPredictedIdentityAfterEmptyOrReplacedInventoryContent() {
+        for (int scenario = 0; scenario < 3; scenario++) {
+            final boolean offhand = scenario == 0;
+            final Map<Class<?>, Object> storage = new HashMap<>();
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                    UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                    (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+            final InventoryTracker inventory = new InventoryTracker(user);
+            final InventoryRequestTracker requests = new InventoryRequestTracker(user);
+            storage.put(InventoryTracker.class, inventory);
+            storage.put(InventoryRequestTracker.class, requests);
+            requests.setPredictingClick(true);
+            final Container target = offhand ? inventory.getOffhandContainer() : inventory.getInventoryContainer();
+            final int slot = offhand ? 0 : 9;
+            final BedrockItem previous = offhand ? BedrockItem.empty() : new BedrockItem(388);
+            if (!previous.isEmpty()) {
+                previous.setAmount(1);
+                previous.setNetId(2);
+            }
+            target.setItem(slot, previous.copy());
+            final InventoryRequestStorage request = new InventoryRequestStorage(
+                    new ItemStackRequestInfo(-3, List.of(), List.of(), TextProcessingEventOrigin.unknown),
+                    0, inventory.getHudContainer().copy(), List.of(target.copy()));
+            final BedrockItem predicted = new BedrockItem(offhand ? 358 : 399);
+            predicted.setAmount(1);
+            target.setItem(slot, predicted);
+            request.capturePrediction(inventory);
+            final BedrockItem authoritative = predicted.copy();
+            authoritative.setNetId(3);
+            final CompoundTag authoritativeTag = new CompoundTag();
+            authoritativeTag.putInt("Damage", 7);
+            authoritative.setTag(authoritativeTag);
+            predicted.setIdentifier(1);
+            predicted.setAmount(64);
+            target.setItem(slot, scenario == 2 ? authoritative : previous.copy());
+            target.markServerUpdate();
+
+            final ContainerEnumName name = offhand ? ContainerEnumName.OffhandContainer
+                    : ContainerEnumName.CombinedHotbarAndInventoryContainer;
+            final byte requestSlot = (byte) target.requestSlot(slot);
+            requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success, -3,
+                    List.of(new ItemStackResponseContainerInfo(new FullContainerName(name, null),
+                            List.of(new ItemStackResponseSlotInfo(requestSlot, requestSlot,
+                                    (byte) 1, 3, "", null, 0))))), request);
+
+            assertEquals(offhand ? 358 : 399, target.getItem(slot).identifier());
+            assertEquals(1, target.getItem(slot).amount());
+            assertEquals(3, target.getItem(slot).netId());
+            if (scenario == 2) {
+                assertEquals(7, target.getItem(slot).tag().getInt("Damage"));
+            }
+            assertEquals(offhand ? 0 : 388, request.prevContainers().get(0).getItem(slot).identifier());
+        }
+    }
+
+    @Test
+    void successfulResponseRestoresPlayerWindowPredictionAfterWindowCloses() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+        final InventoryTracker inventory = new InventoryTracker(user);
+        final InventoryRequestTracker requests = new InventoryRequestTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        final InventoryContainer playerWindow = new InventoryContainer(user, (byte) 7, null,
+                inventory.getInventoryContainer());
+        inventory.setCurrentContainer(playerWindow);
+        final BedrockItem emerald = new BedrockItem(388);
+        emerald.setAmount(1);
+        emerald.setNetId(2);
+        playerWindow.setItem(9, emerald.copy());
+        final InventoryRequestStorage request = new InventoryRequestStorage(
+                new ItemStackRequestInfo(-3, List.of(), List.of(), TextProcessingEventOrigin.unknown),
+                0, inventory.getHudContainer().copy(), List.of(playerWindow.copy()));
+        final BedrockItem result = new BedrockItem(399);
+        result.setAmount(1);
+        playerWindow.setItem(9, result);
+        request.capturePrediction(inventory);
+        inventory.setCurrentContainerClosed(false);
+        inventory.getInventoryContainer().setItem(9, emerald.copy());
+        inventory.getInventoryContainer().markServerUpdate();
+
+        requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success, -3,
+                List.of(new ItemStackResponseContainerInfo(
+                        new FullContainerName(ContainerEnumName.CombinedHotbarAndInventoryContainer, null),
+                        List.of(new ItemStackResponseSlotInfo((byte) 9, (byte) 9,
+                                (byte) 1, 3, "", null, 0))))), request);
+
+        assertEquals(399, inventory.getInventoryContainer().getItem(9).identifier());
+        assertEquals(1, playerWindow.getItem(9).amount());
+        assertEquals(3, playerWindow.getItem(9).netId());
+        assertEquals(388, request.prevContainers().get(0).getItem(9).identifier());
+        assertEquals(2, request.prevContainers().get(0).getItem(9).netId());
+    }
+
+    @Test
+    void requestPredictionSnapshotsPreserveCraftingAndEnchantingWireSlotMappings() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+        final InventoryTracker inventory = new InventoryTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        final Container[] containers = {
+            new CraftingTableContainer(user, (byte) 5, null, null),
+            new EnchantmentContainer(user, (byte) 6, null, null)
+        };
+        for (final Container container : containers) {
+            inventory.setCurrentContainer(container);
+            final int slot = container instanceof CraftingTableContainer ? 32 : 14;
+            final InventoryRequestStorage request = new InventoryRequestStorage(
+                    new ItemStackRequestInfo(-3, List.of(), List.of(), TextProcessingEventOrigin.unknown),
+                    0, inventory.getHudContainer().copy(), List.of(container.copy()));
+            final BedrockItem predicted = new BedrockItem(358);
+            predicted.setAmount(1);
+            predicted.setNetId(2);
+            container.setItem(slot, predicted);
+            request.capturePrediction(inventory);
+            container.setItem(slot, BedrockItem.empty());
+
+            assertTrue(request.prevContainers().get(0).getItem(slot).isEmpty());
+            assertEquals(358, request.predictedItem(container, slot).identifier());
+            assertEquals(2, request.predictedItem(container, slot).netId());
+            inventory.setCurrentContainerClosed(false);
+        }
+    }
+
+    @Test
+    void successfulResponseUpdatesNameAndCountWithoutTreatingDurabilityCorrectionAsDamage() {
+        final BedrockItem current = new BedrockItem(276);
+        current.setAmount(1);
+        current.setNetId(17);
+        final CompoundTag originalTag = new CompoundTag();
+        originalTag.putInt("Damage", 7);
+        current.setTag(originalTag);
+        final ItemStackResponseSlotInfo slot = new ItemStackResponseSlotInfo(
+                (byte) 4, (byte) 4, (byte) 2, 29, "Repaired", null, 3);
+
+        final BedrockItem reconciled = InventoryRequestTracker.reconcileResponseItem(current, slot);
+
+        assertEquals(2, reconciled.amount());
+        assertEquals(29, reconciled.netId());
+        final CompoundTag tag = reconciled.tag();
+        assertEquals(7, tag.getInt("Damage"));
+        assertEquals("Repaired", tag.getCompoundTag("display").getString("Name"));
+    }
+
+    @Test
+    void inventoryClicksWaitForOpenInOrderAndExpireWhenItNeverArrives() {
+        final InventoryRequestTracker.PendingInventoryOpenClicks pending =
+                new InventoryRequestTracker.PendingInventoryOpenClicks();
+        final InventoryRequestTracker.InventoryOpenClick first =
+                new InventoryRequestTracker.InventoryOpenClick(1, (short) 37, (byte) 0,
+                        ContainerInput.PICKUP);
+        final InventoryRequestTracker.InventoryOpenClick second =
+                new InventoryRequestTracker.InventoryOpenClick(2, (short) 45, (byte) 0,
+                        ContainerInput.PICKUP);
+
+        assertTrue(pending.add(first, 100));
+        assertTrue(pending.add(second, 101));
+        assertFalse(pending.expire(104, 5));
+        assertEquals(List.of(first, second), pending.drain());
+        assertTrue(pending.isEmpty());
+
+        assertTrue(pending.add(first, 200));
+        assertTrue(pending.expire(205, 5));
+        assertTrue(pending.isEmpty());
+    }
+
+    @Test
+    void inventoryOpenQueueRejectsUnboundedOptimisticClicks() {
+        final InventoryRequestTracker.PendingInventoryOpenClicks pending =
+                new InventoryRequestTracker.PendingInventoryOpenClicks();
+        final InventoryRequestTracker.InventoryOpenClick click =
+                new InventoryRequestTracker.InventoryOpenClick(0, (short) 36, (byte) 0,
+                        ContainerInput.PICKUP);
+
+        for (int i = 0; i < 32; i++) {
+            assertTrue(pending.add(click, i));
+        }
+        assertFalse(pending.add(click, 32));
+        assertTrue(pending.isEmpty());
+    }
+
+}
