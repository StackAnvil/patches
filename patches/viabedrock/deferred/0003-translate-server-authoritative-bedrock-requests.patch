+package net.raphimc.viabedrock.protocol.types.recipe;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class NetworkItemDescriptorTypeTest {
+
+    private final NetworkItemDescriptorType type = new NetworkItemDescriptorType();
+
+    @Test
+    void encodesNamedIngredientWithSubtypeAndVarintCount() {
+        this.assertWire(
+                new ItemDescriptor.ItemNameDescriptor("x", -1, 2),
+                new byte[] {1, 4, 'n', 'a', 'm', 'e', 1, 'x', 1, 4});
+    }
+
+    @Test
+    void encodesTagIngredientWithAuxValue() {
+        this.assertWire(
+                new ItemDescriptor.ItemTagDescriptor("t", 3),
+                new byte[] {1, 8, 'i', 't', 'e', 'm', '_', 't', 'a', 'g',
+                            1, 't', (byte) 0xFE, (byte) 0xFF, 3, 6});
+    }
+
+    @Test
+    void encodesMolangIngredientAndLargeCount() {
+        this.assertWire(
+                new ItemDescriptor.MolangDescriptor("q", 2, 300),
+                new byte[] {1, 6, 'm', 'o', 'l', 'a', 'n', 'g', 1, 'q', 2, 0,
+                            (byte) 0xD8, 4});
+    }
+
+    @Test
+    void encodesEmptyIngredient() {
+        this.assertWire(new ItemDescriptor.InvalidDescriptor(),
+                new byte[] {0, (byte) 0xFE, (byte) 0xFF, 3, 2});
+    }
+
+    @Test
+    void rejectsUnknownDescriptorVariant() {
+        final ByteBuf buffer = Unpooled.wrappedBuffer(new byte[] {2});
+        try {
+            assertThrows(IllegalArgumentException.class, () -> this.type.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnknownDescriptorSubtype() {
+        final ByteBuf buffer = Unpooled.wrappedBuffer(new byte[] {1, 3, 'b', 'a', 'd'});
+        try {
+            assertThrows(IllegalArgumentException.class, () -> this.type.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private void assertWire(final ItemDescriptor descriptor, final byte[] expected) {
+        final ByteBuf input = Unpooled.wrappedBuffer(expected);
+        final ByteBuf output = Unpooled.buffer();
+        try {
+            assertEquals(descriptor, this.type.read(input));
+            assertEquals(0, input.readableBytes());
+            this.type.write(output, descriptor);
+            final byte[] actual = new byte[output.readableBytes()];
+            output.readBytes(actual);
+            assertArrayEquals(expected, actual);
+        } finally {
+            input.release();
+            output.release();
+        }
+    }
+
+}
