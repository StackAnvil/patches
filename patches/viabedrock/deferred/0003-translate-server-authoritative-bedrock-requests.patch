+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.storage.*;
+
+import java.util.List;
+
+public class SmithingContainer extends Container {
+
+    public static final int RESULT_SLOT = 50;
+    public static final int INPUT_SLOT = 51;
+    public static final int MATERIAL_SLOT = 52;
+    public static final int TEMPLATE_SLOT = 53;
+
+    public SmithingContainer(
+            final UserConnection user, final byte containerId, final TextComponent title, final BlockPosition position) {
+        super(
+                user,
+                containerId,
+                ContainerType.SMITHING_TABLE,
+                title,
+                position,
+                4,
+                CustomBlockTags.SMITHING_TABLE);
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        return switch (slot) {
+            case TEMPLATE_SLOT ->
+                new FullContainerName(ContainerEnumName.SmithingTableTemplateContainer, null);
+            case INPUT_SLOT ->
+                new FullContainerName(ContainerEnumName.SmithingTableInputContainer, null);
+            case MATERIAL_SLOT ->
+                new FullContainerName(ContainerEnumName.SmithingTableMaterialContainer, null);
+            case RESULT_SLOT ->
+                new FullContainerName(
+                            ContainerEnumName.SmithingTableResultPreviewContainer, null);
+            default ->
+                    throw new IllegalArgumentException(
+                            "Invalid slot for Smithing Container: " + slot);
+        };
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return switch (slot) {
+            case TEMPLATE_SLOT -> 0;
+            case INPUT_SLOT -> 1;
+            case MATERIAL_SLOT -> 2;
+            case RESULT_SLOT -> 3;
+            default -> super.javaSlot(slot);
+        };
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return switch (slot) {
+            case 0 -> TEMPLATE_SLOT;
+            case 1 -> INPUT_SLOT;
+            case 2 -> MATERIAL_SLOT;
+            case 3 -> RESULT_SLOT;
+            default -> super.bedrockSlot(slot);
+        };
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return switch (slot) {
+            case TEMPLATE_SLOT -> 0;
+            case INPUT_SLOT -> 1;
+            case MATERIAL_SLOT -> 2;
+            case RESULT_SLOT -> 3;
+            default -> throw new IllegalArgumentException("Invalid slot for Smithing Container: " + slot);
+        };
+    }
+
+    @Override
+    public boolean handleClick(
+            final int revision,
+            final short javaSlot,
+            final byte button,
+            final ContainerInput action) {
+        if (javaSlot != 3) {
+            return super.handleClick(revision, javaSlot, button, action);
+        }
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE) {
+            return false;
+        }
+        if (action == ContainerInput.PICKUP && button != 0) {
+            return false;
+        }
+
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final InventoryContainer player = inventory.getInventoryContainer();
+        final boolean toInventory = action == ContainerInput.QUICK_MOVE;
+        final int destination = toInventory ? firstEmptySlot(player) : 0;
+        final BedrockItem template = this.getItem(TEMPLATE_SLOT);
+        final BedrockItem input = this.getItem(INPUT_SLOT);
+        final BedrockItem material = this.getItem(MATERIAL_SLOT);
+        final BedrockItem output = this.getItem(RESULT_SLOT);
+        if (template.isEmpty()
+                || input.isEmpty()
+                || material.isEmpty()
+                || output.isEmpty()
+                || destination < 0
+                || (!toInventory && !inventory.getHudContainer().getItem(0).isEmpty())) {
+            return false;
+        }
+        if (template.netId() == null || input.netId() == null || material.netId() == null) {
+            return false;
+        }
+
+        final CraftingDataStorage recipe =
+                this.user.get(CraftingDataTracker.class).getRecipeData(this, "smithing_table");
+        if (recipe == null) {
+            return false;
+        }
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final List<ItemStackRequestAction> actions =
+                List.of(
+                        new ItemStackRequestAction.CraftRecipeAction(recipe.networkId(), 1),
+                        new ItemStackRequestAction.ConsumeAction(
+                                1,
+                                new ItemStackRequestSlotInfo(
+                                        this.getFullContainerName(TEMPLATE_SLOT),
+                                        (byte) TEMPLATE_SLOT,
+                                        template.netId())),
+                        new ItemStackRequestAction.ConsumeAction(
+                                1,
+                                new ItemStackRequestSlotInfo(
+                                        this.getFullContainerName(INPUT_SLOT),
+                                        (byte) INPUT_SLOT,
+                                        input.netId())),
+                        new ItemStackRequestAction.ConsumeAction(
+                                1,
+                                new ItemStackRequestSlotInfo(
+                                        this.getFullContainerName(MATERIAL_SLOT),
+                                        (byte) MATERIAL_SLOT,
+                                        material.netId())),
+                        new ItemStackRequestAction.PlaceAction(
+                                output.amount(),
+                                new ItemStackRequestSlotInfo(
+                                        new FullContainerName(
+                                                ContainerEnumName.CreatedOutputContainer, null),
+                                        (byte) RESULT_SLOT,
+                                        requestId),
+                                new ItemStackRequestSlotInfo(
+                                        toInventory ? player.getFullContainerName(destination)
+                                                : inventory.getHudContainer().getFullContainerName(0),
+                                        (byte) destination,
+                                        0)));
+        final ItemStackRequestInfo request =
+                new ItemStackRequestInfo(
+                        requestId, actions, List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(
+                new InventoryRequestStorage(
+                        request,
+                        revision,
+                        inventory.getHudContainer().copy(),
+                        toInventory ? List.of(this.copy(), player.copy()) : List.of(this.copy())));
+        this.setItem(TEMPLATE_SLOT, this.itemAfterRemovingAmount(template, 1));
+        this.setItem(INPUT_SLOT, this.itemAfterRemovingAmount(input, 1));
+        this.setItem(MATERIAL_SLOT, this.itemAfterRemovingAmount(material, 1));
+        this.setItem(RESULT_SLOT, BedrockItem.empty());
+        if (toInventory) {
+            player.setItem(destination, output.copy());
+        } else {
+            inventory.getHudContainer().setItem(0, output.copy());
+        }
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    private static int firstEmptySlot(final InventoryContainer inventory) {
+        for (int slot = 9; slot < inventory.size(); slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        return -1;
+    }
+
+}
