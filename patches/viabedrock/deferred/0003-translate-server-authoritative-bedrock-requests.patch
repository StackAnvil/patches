+    void quickMoveMatchesOriginalPlayerPlannerPhysicalDestinations() throws Exception {
+        try (var input = new GZIPInputStream(Files.newInputStream(Path.of(System.getenv("STACKANVIL_NATIVE_PLAYER_PLANNER"))));
+             var reader = new InputStreamReader(input, StandardCharsets.UTF_8)) {
+            final var reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertTrue(reference.getAsJsonArray("remainingAllocations").isEmpty());
