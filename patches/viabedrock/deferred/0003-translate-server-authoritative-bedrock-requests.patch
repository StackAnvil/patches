+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.UUID;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+
+class HorseContainerTest {
+
+    @Test
+    void saddleAndArmorUseHorseEquipmentSlots() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final HorseContainer horse = HorseContainer.create(user, (byte) 8, entity(user, "minecraft:horse", false, 2));
+
+        assertEquals(2, horse.size());
+        assertEquals(ContainerEnumName.HorseEquipContainer, horse.getFullContainerName(0).name());
+        assertEquals(ContainerEnumName.HorseEquipContainer, horse.getFullContainerName(1).name());
+        assertTrue(horse.ownsBedrockSlot(horse.getFullContainerName(0), 0));
+        assertTrue(horse.ownsBedrockSlot(horse.getFullContainerName(1), 1));
+        assertFalse(horse.ownsBedrockSlot(horse.getFullContainerName(0), 2));
+        assertThrows(IllegalArgumentException.class, () -> horse.getFullContainerName(2));
+
+        final PacketWrapper open = new PacketWrapperImpl(0, Unpooled.buffer(), user);
+        horse.writeJavaOpen(open);
+        assertEquals(ClientboundPackets26_3.MOUNT_SCREEN_OPEN, open.getPacketType());
+        assertEquals(8, open.get(Types.VAR_INT, 0));
+        assertEquals(0, open.get(Types.VAR_INT, 1));
+        assertEquals(47, open.get(Types.INT, 0));
+    }
+
+    @Test
+    void muleCargoMapsAroundTheHiddenArmorSlotWithoutShiftingPlayerItems() {
+        for (final String type : List.of("minecraft:mule", "minecraft:donkey")) {
+            final HorseContainer mount = HorseContainer.create(null, (byte) 8, entity(null, type, true, 16));
+            final InventoryTracker tracker = new InventoryTracker(null);
+            tracker.setCurrentContainer(mount);
+            assertEquals(16, mount.size());
+            assertEquals(17, mount.javaSize());
+            assertEquals(-1, mount.bedrockSlot(1));
+            assertNull(((Container) mount).resolveJavaSlot(tracker, (short) 1));
+            for (int slot = 1; slot < 16; slot++) {
+                assertEquals(slot + 1, mount.javaSlot(slot));
+                assertEquals(slot, mount.bedrockSlot(slot + 1));
+                final var request = mount.requestSlotInfo(slot, 100 + slot);
+                assertEquals(ContainerEnumName.LevelEntityContainer, request.container().name());
+                assertEquals(slot, request.slot());
+                assertEquals(100 + slot, request.stackNetworkId());
+                assertSame(mount, tracker.getContainerFromName(request.container(), slot));
+            }
+            for (short cell = 0; cell < 36; cell++) {
+                final var slot = ((Container) mount).resolveJavaSlot(tracker, (short) (17 + cell));
+                assertSame(tracker.getInventoryContainer(), slot.container());
+                assertEquals(cell < 27 ? cell + 9 : cell - 27, slot.bedrockSlot());
+            }
+            assertNull(((Container) mount).resolveJavaSlot(tracker, (short) 53));
+            final PacketWrapper open = new PacketWrapperImpl(0, Unpooled.buffer(), null);
+            mount.writeJavaOpen(open);
+            assertEquals(5, open.get(Types.VAR_INT, 1));
+        }
+    }
+
+    @Test
+    void unchestedMuleRetainsNativeCapacityAndHidesCargoFromJavaRequests() {
+        final HorseContainer mule = HorseContainer.create(null, (byte) 8,
+                entity(null, "minecraft:mule", false, 16));
+        assertEquals(16, mule.size());
+        assertEquals(2, mule.javaSize());
+        for (int slot = 1; slot < 16; slot++) {
+            assertEquals(-1, mule.javaSlot(slot));
+            assertFalse(mule.ownsBedrockSlot(new FullContainerName(ContainerEnumName.LevelEntityContainer, null), slot));
+        }
+        final BedrockItem saddle = new BedrockItem(3);
+        saddle.setNetId(91);
+        assertTrue(mule.setItems(new BedrockItem[]{saddle}));
+        assertSame(saddle, mule.itemsInJavaOrder(mule.getItems())[0]);
+        assertTrue(mule.itemsInJavaOrder(mule.getItems())[1].isEmpty());
+        final InventoryTracker tracker = new InventoryTracker(null);
+        assertEquals(9, ((Container) mule).resolveJavaSlot(tracker, (short) 2).bedrockSlot());
+        assertNull(((Container) mule).resolveJavaSlot(tracker, (short) 1));
+    }
+
+    @Test
+    void rollbackSnapshotKeepsNativeContentsAndJavaSlotMapping() {
+        final HorseContainer mule = HorseContainer.create(null, (byte) 8,
+                entity(null, "minecraft:mule", true, 16));
+        final BedrockItem cargo = new BedrockItem(7);
+        cargo.setAmount(4);
+        cargo.setNetId(81);
+        mule.setItem(15, cargo);
+        final Container snapshot = mule.copy();
+        mule.setItem(15, BedrockItem.empty());
+        assertEquals(16, snapshot.size());
+        assertEquals(17, snapshot.javaSize());
+        assertEquals(16, snapshot.javaSlot(15));
+        assertEquals(15, snapshot.bedrockSlot(16));
+        assertNotSame(cargo, snapshot.getItem(15));
+        assertEquals(81, snapshot.itemsInJavaOrder(snapshot.getItems())[16].netId());
+        assertEquals(4, snapshot.itemsInJavaOrder(snapshot.getItems())[16].amount());
+        assertTrue(snapshot.itemsInJavaOrder(snapshot.getItems())[1].isEmpty());
+        assertTrue(mule.setItems(snapshot.getItems()));
+        assertEquals(81, mule.getItem(15).netId());
+    }
+
+    @Test
+    void equipmentRestrictionsHonorServerItemNamesAuxAndEmptyAcceptedLists() {
+        final HorseContainer horse = HorseContainer.create(null, (byte) 8,
+                entity(null, "minecraft:horse", false, 2));
+        final CompoundTag item = new CompoundTag();
+        item.putString("Name", "example:armor");
+        item.putShort("Aux", (short) 4);
+        final CompoundTag entry = new CompoundTag();
+        entry.put("slotItem", item);
+        final CompoundTag armor = new CompoundTag();
+        armor.putInt("slotNumber", 1);
+        armor.put("acceptedItems", new ListTag<>(List.of(entry)));
+        final CompoundTag saddle = new CompoundTag();
+        saddle.putInt("slotNumber", 0);
+        saddle.put("acceptedItems", new ListTag<>(CompoundTag.class));
+        final CompoundTag tag = new CompoundTag();
+        tag.put("slots", new ListTag<>(List.of(saddle, armor)));
+        horse.updateEquipment(tag);
+        assertTrue(horse.acceptsEquipment(1, "example:armor", (short) 4));
+        assertFalse(horse.acceptsEquipment(1, "example:armor", (short) 5));
+        assertFalse(horse.acceptsEquipment(1, "minecraft:horsearmoriron", (short) 4));
+        assertFalse(horse.acceptsEquipment(0, "minecraft:saddle", (short) 0));
+        item.putShort("Aux", Short.MAX_VALUE);
+        horse.updateEquipment(tag);
+        assertTrue(horse.acceptsEquipment(1, "example:armor", (short) 5));
+    }
+
+    @Test
+    void unsupportedMountsAndImpossibleCargoLayoutsAreRejected() {
+        assertNull(HorseContainer.create(null, (byte) 8, entity(null, "minecraft:pig", false, 16)));
+        assertNull(HorseContainer.create(null, (byte) 8, entity(null, "minecraft:mule", true, 2)));
+        assertNull(HorseContainer.create(null, (byte) 8, entity(null, "minecraft:horse", false, 16)));
+        assertNull(HorseContainer.create(null, (byte) 8, null));
+    }
+
+    private static Entity entity(final UserConnection user, final String type, final boolean chested, final int size) {
+        final Entity entity = new Entity(user, 33, 45, type, 47, new UUID(0, 1), null);
+        entity.entityData().put(ActorDataIds.CONTAINER_SIZE,
+                new EntityData(45, EntityDataTypesBedrock.INT, size));
+        if (chested) {
+            entity.entityData().put(ActorDataIds.RESERVED_0,
+                    new EntityData(0, EntityDataTypesBedrock.LONG, 1L << ActorFlags.CHESTED.getValue()));
+        }
+        return entity;
+    }
+
+}
