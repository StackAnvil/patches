+    private ItemStackRequestAction handlePickupClick(
+            final ClickContext clickContext, final short javaSlot, final byte button) {
+        final BedrockItem cursorItem = clickContext.inventoryTracker.getHudContainer().getItem(0);
+        if (javaSlot == -999) {
+            return this.dropCursorItem(clickContext.inventoryTracker, button);
+        }
+        final SlotRef destination = this.resolveJavaSlot(clickContext.inventoryTracker, javaSlot);
+        if (destination == null) {
+            return null;
+        }
+        final Container container = destination.container();
+        final int bedrockSlot = destination.bedrockSlot();
+        clickContext.container = container;
+        clickContext.bedrockSlot = bedrockSlot;
+        clickContext.snapshot(container);
+
+        final BedrockItem item = container.getItem(bedrockSlot);
+        if (item.isEmpty() && cursorItem.isEmpty()) {
+            return null;
+        }
+
+        if (cursorItem.isEmpty()) {
+            return this.handlePickupTake(clickContext, container, bedrockSlot, button, item);
+        }
+
+        final ItemRewriter itemRewriter = this.user.get(ItemRewriter.class);
+
+        if (item.isEmpty()
+                || (!item.isDifferent(cursorItem)
+                        && item.amount() < itemRewriter.maxStackSize(item))) {
+            return this.handlePickupPlace(
+                    clickContext, container, bedrockSlot, button, cursorItem, item);
+        }
+
+        return this.handlePickupSwap(clickContext, container, bedrockSlot, cursorItem, item);
+    }
+
+    private ItemStackRequestAction handlePickupTake(
+            final ClickContext clickContext,
+            final Container container,
+            final int bedrockSlot,
+            final byte button,
+            final BedrockItem item) {
+        final int amountToTake = button == 0 ? item.amount() : (item.amount() + 1) / 2;
+
+        final BedrockItem finalCursorItem = this.copyStackWithAmount(item, amountToTake);
+        clickContext.inventoryTracker.getHudContainer().setItem(0, finalCursorItem);
+
+        final BedrockItem finalContainerItem = this.itemAfterRemovingAmount(item, amountToTake);
+        container.setItem(bedrockSlot, finalContainerItem);
+
+        return new ItemStackRequestAction.TakeAction(
+                amountToTake,
+                container.requestSlotInfo(bedrockSlot, finalCursorItem.netId()),
+                clickContext.inventoryTracker.getHudContainer().requestSlotInfo(0, 0));
+    }
+
+    private ItemStackRequestAction handlePickupPlace(
+            final ClickContext clickContext,
+            final Container container,
+            final int bedrockSlot,
+            final byte button,
+            final BedrockItem cursorItem,
+            final BedrockItem item) {
+        if (!container.canPlaceItem(bedrockSlot, cursorItem)) {
+            return null;
+        }
+        final int amt = button == 0 ? cursorItem.amount() : 1;
+        final int amountToPlace =
+                item.isDifferent(cursorItem)
+                        ? Math.min(amt, this.user.get(ItemRewriter.class).maxStackSize(cursorItem))
+                        : Math.min(
+                                this.user.get(ItemRewriter.class).maxStackSize(item)
+                                        - item.amount(),
+                                amt);
+        if (amountToPlace <= 0) {
+            return null;
+        }
+
+        final int containerNetId = item.netId() != null ? item.netId() : 0;
+        BedrockItem finalContainerItem = item.copy();
+        if (item.isDifferent(cursorItem)) {
+            finalContainerItem = cursorItem.copy();
+            finalContainerItem.setAmount(amountToPlace);
+        } else {
+            finalContainerItem.setAmount(item.amount() + amountToPlace);
+        }
+        container.setItem(bedrockSlot, finalContainerItem);
+
+        final int cursorNetId = cursorItem.netId();
+        final BedrockItem finalCursorItem = this.itemAfterRemovingAmount(cursorItem, amountToPlace);
+        clickContext.inventoryTracker.getHudContainer().setItem(0, finalCursorItem);
+
+        return new ItemStackRequestAction.PlaceAction(
+                amountToPlace,
+                clickContext.inventoryTracker.getHudContainer().requestSlotInfo(0, cursorNetId),
+                container.requestSlotInfo(bedrockSlot, containerNetId));
+    }
+
+    private ItemStackRequestAction handlePickupSwap(
+            final ClickContext clickContext,
+            final Container container,
+            final int bedrockSlot,
+            final BedrockItem cursorItem,
+            final BedrockItem item) {
+        if (!container.canPlaceItem(bedrockSlot, cursorItem)) {
+            return null;
+        }
+        final BedrockItem cursorCopy = cursorItem.copy();
+        final BedrockItem itemCopy = item.copy();
+
+        container.setItem(bedrockSlot, cursorCopy);
+        clickContext.inventoryTracker.getHudContainer().setItem(0, itemCopy);
+
+        return new ItemStackRequestAction.SwapAction(
+                clickContext.inventoryTracker.getHudContainer().requestSlotInfo(0, cursorItem.netId()),
+                container.requestSlotInfo(bedrockSlot, item.netId()));
+    }
+
+    private ItemStackRequestAction handleSwapClick(
+            final ClickContext clickContext, final short javaSlot, final byte button) {
+        if (button != 40 && (button < 0 || button > 8)) {
+            return null;
+        }
+        final SlotRef source = this.resolveJavaSlot(clickContext.inventoryTracker, javaSlot);
+        if (source == null) {
+            return null;
+        }
+        final Container container = source.container();
+        final int sourceSlot = source.bedrockSlot();
+        final Container targetContainer = button == 40
+                ? clickContext.inventoryTracker.getOffhandContainer()
+                : clickContext.inventoryTracker.getInventoryContainer();
+        final int targetSlot = button == 40 ? 0 : button;
+        if (container == targetContainer && sourceSlot == targetSlot) {
+            return null;
+        }
+        clickContext.snapshot(container);
+        clickContext.snapshot(targetContainer);
+
+        final BedrockItem item = container.getItem(sourceSlot).copy();
+        final BedrockItem targetItem = targetContainer.getItem(targetSlot).copy();
+
+        if (item.isEmpty() && targetItem.isEmpty()) {
+            return null;
+        }
+
+        if (!container.canPlaceItem(sourceSlot, targetItem)
+                || !targetContainer.canPlaceItem(targetSlot, item)) {
+            return null;
+        }
+        container.setItem(sourceSlot, targetItem);
+        targetContainer.setItem(targetSlot, item);
+
+        return swapAction(container, sourceSlot, item, targetContainer, targetSlot, targetItem);
+    }
+
+    static ItemStackRequestAction swapAction(final Container container, final int sourceSlot,
+                                             final BedrockItem item, final Container targetContainer,
+                                             final int targetSlot, final BedrockItem targetItem) {
+        if (targetItem.isEmpty()) {
+            return new ItemStackRequestAction.PlaceAction(
+                    item.amount(),
+                    container.requestSlotInfo(sourceSlot, item.netId()),
+                    targetContainer.requestSlotInfo(targetSlot, 0));
+        } else if (item.isEmpty()) {
+            return new ItemStackRequestAction.PlaceAction(
+                    targetItem.amount(),
+                    targetContainer.requestSlotInfo(targetSlot, targetItem.netId()),
+                    container.requestSlotInfo(sourceSlot, 0));
+        }
+
+        return new ItemStackRequestAction.SwapAction(
+                targetContainer.requestSlotInfo(targetSlot, targetItem.netId()),
+                container.requestSlotInfo(sourceSlot, item.netId()));
+    }
