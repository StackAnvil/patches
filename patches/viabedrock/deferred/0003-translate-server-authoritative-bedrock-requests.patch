+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ComplexInventoryTransaction_Type;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryTransactionData;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.rewriter.InventoryTransactionRewriter;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InteractPacketPayload_Action;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemStackNetResult;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.ContainerInput;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseContainerInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseSlotInfo;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayDeque;
+import java.util.HashSet;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Level;
+
+public class InventoryRequestTracker extends StoredObject {
+
+    private static final long RESPONSE_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(5);
+    private static final long RECOVERY_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(10);
+    private static final int MAX_QUEUED_INTERACTIONS = 32;
+
+    private final Int2ObjectOpenHashMap<InventoryRequestStorage> requests =
+            new Int2ObjectOpenHashMap<>();
+    private final InventoryRequestRecovery recovery = new InventoryRequestRecovery();
+    private final ArrayDeque<QueuedInteraction> queuedInteractions = new ArrayDeque<>();
+    private final PendingInventoryOpenClicks pendingInventoryOpenClicks =
+            new PendingInventoryOpenClicks();
+    private int requestIdCounter = -1;
+    private int legacyRequestIdCounter = -2;
+    private long pendingSinceNanos;
+    private boolean closeTemporaryInventory;
+    private boolean predictingClick;
+    private CraftedItemSynchronization craftedItemSynchronization;
+    private TransferBatch transferBatch;
+    private Set<Container> batchChanges;
+
+    public InventoryRequestTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public int nextRequestId() {
+        return this.requestIdCounter -= 2;
+    }
+
+    public int nextLegacyRequestId() {
+        this.legacyRequestIdCounter = Math.min(this.legacyRequestIdCounter, -2) - 2;
+        return this.legacyRequestIdCounter;
+    }
+
+    public void addRequest(final InventoryRequestStorage info) {
+        if (this.hasPending()) {
+            throw new IllegalStateException("An inventory request is already pending");
+        }
+        this.requests.put(info.requestInfo().requestId(), info);
+        this.pendingSinceNanos = System.nanoTime();
+        this.recovery.reset();
+    }
+
+    /** Send one input's separately scoped transfers, each with its intermediate prediction captured. */
+    public void sendTransferBatch(final List<InventoryRequestStorage> batch) {
+        this.addTransferBatch(batch);
+        try {
+            PacketFactory.sendBedrockInventoryRequest(this.user(), batch.stream()
+                    .map(InventoryRequestStorage::requestInfo)
+                    .toArray(ItemStackRequestInfo[]::new));
+        } catch (final RuntimeException error) {
+            final boolean wasPredicting = this.predictingClick;
+            this.predictingClick = true;
+            try {
+                for (final var request : batch.reversed()) {
+                    this.restoreRejectedRequest(request);
+                }
+            } finally {
+                this.predictingClick = wasPredicting;
+                this.requests.clear();
+                this.transferBatch = null;
+                this.resetRecovery();
+                this.clearQueuedInteractions();
+            }
+            throw error;
+        }
+    }
+
+    void addTransferBatch(final List<InventoryRequestStorage> batch) {
+        if (this.hasPending() || batch.isEmpty()) {
+            throw new IllegalStateException("An inventory transfer batch cannot start");
+        }
+        final Set<Integer> ids = new HashSet<>();
+        for (final var request : batch) {
+            if (!request.hasPrediction() || !request.hasCurrentMenu(this.user().get(InventoryTracker.class))
+                    || !ids.add(request.requestInfo().requestId())
+                    || request.requestInfo().actions().isEmpty()
+                    || !request.requestInfo().actions().stream().allMatch(InventoryRequestTracker::ordinaryTransfer)) {
+                throw new IllegalArgumentException("A transfer batch requires distinct, predicted ordinary requests");
+            }
+        }
+        this.transferBatch = new TransferBatch(List.copyOf(batch), new Int2ObjectOpenHashMap<>());
+        for (final var request : batch) {
+            this.requests.put(request.requestInfo().requestId(), request);
+        }
+        this.pendingSinceNanos = System.nanoTime();
+        this.recovery.reset();
+    }
+
+    private static boolean ordinaryTransfer(final ItemStackRequestAction action) {
+        if (action instanceof ItemStackRequestAction.TakeAction take) {
+            return take.source().container().name() != ContainerEnumName.CreatedOutputContainer
+                    && take.destination().container().name() != ContainerEnumName.CreatedOutputContainer;
+        }
+        if (action instanceof ItemStackRequestAction.PlaceAction place) {
+            return place.source().container().name() != ContainerEnumName.CreatedOutputContainer
+                    && place.destination().container().name() != ContainerEnumName.CreatedOutputContainer;
+        }
+        return action instanceof ItemStackRequestAction.SwapAction swap
+                && swap.source().container().name() != ContainerEnumName.CreatedOutputContainer
+                && swap.destination().container().name() != ContainerEnumName.CreatedOutputContainer;
+    }
+
+    public boolean hasPending() {
+        return !this.requests.isEmpty() || this.craftedItemSynchronization != null || this.batchChanges != null;
+    }
+
+    public boolean isPredictingClick() {
+        return this.predictingClick;
+    }
+
+    public void setPredictingClick(final boolean predictingClick) {
+        this.predictingClick = predictingClick;
+    }
+
+    public boolean queueClick(final Container container, final int revision, final short slot,
+                              final byte button, final ContainerInput action) {
+        return this.queueInteraction(new QueuedClick(container, revision, slot, button, action));
+    }
+
+    public boolean isWaitingForInventoryOpen() {
+        final var screens = this.user().get(PlayerInventoryScreenTracker.class);
+        return this.pendingInventoryOpenClicks.isWaiting() || screens != null && screens.hasPendingOpen();
+    }
+
+    public boolean beginInventoryOpen() {
+        final var screens = this.user().get(PlayerInventoryScreenTracker.class);
+        return (screens == null || !screens.hasPendingOpen())
+                && this.pendingInventoryOpenClicks.begin(System.nanoTime());
+    }
+
+    public boolean isRecovering() {
+        return this.recovery.isActive();
+    }
+
+    public boolean queueInventoryOpenClick(final int revision, final short slot,
+                                           final byte button, final ContainerInput action) {
+        return this.pendingInventoryOpenClicks.add(
+                new InventoryOpenClick(revision, slot, button, action), System.nanoTime());
+    }
+
+    public void openPlayerInventoryTemporarily() {
+        this.closeTemporaryInventory = true;
+    }
+
+    public void keepPlayerInventoryOpen() {
+        this.closeTemporaryInventory = false;
+    }
+
+    void closeTemporaryInventoryIfIdle() {
+        if (!this.closeTemporaryInventory || this.hasPending()
+                || this.isWaitingForInventoryOpen() || !this.queuedInteractions.isEmpty()) {
+            return;
+        }
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        if (tracker.getCurrentContainer() instanceof InventoryContainer) {
+            this.closeTemporaryInventory = false;
+            tracker.closeTemporaryPlayerInventory();
+        }
+    }
+
+    public void handleInventoryOpen(final Container container) {
+        for (final InventoryOpenClick click : this.pendingInventoryOpenClicks.drain()) {
+            if (this.hasPending()) {
+                if (!this.queueClick(container, click.revision(), click.slot(),
+                        click.button(), click.action())) {
+                    this.clearQueuedInteractions();
+                    PacketFactory.sendJavaContainerSetContent(this.user(), container);
+                    return;
+                }
+            } else if (!container.handleClick(
+                    click.revision(), click.slot(), click.button(), click.action())) {
+                PacketFactory.sendJavaContainerSetContent(this.user(), container);
+            }
+        }
+        this.drainQueuedInteractions();
+        this.closeTemporaryInventoryIfIdle();
+    }
+
+    public boolean queueBundleSelection(final Container screen, final short slot, final int selectedItem) {
+        return this.queueInteraction(new QueuedInteraction() {
+            @Override
+            public Container container() {
+                return screen;
+            }
+
+            @Override
+            public boolean apply() {
+                screen.selectBundleItem(slot, selectedItem);
+                return true;
+            }
+        });
+    }
+
+    public boolean queueButtonClick(final Container container, final int button) {
+        return this.queueInteraction(new QueuedButtonClick(container, button));
+    }
+
+    boolean queueInteraction(final QueuedInteraction interaction) {
+        if (this.recovery.isActive() || this.queuedInteractions.size() >= MAX_QUEUED_INTERACTIONS) {
+            this.queuedInteractions.clear();
+            return false;
+        }
+        this.queuedInteractions.addLast(interaction);
+        return true;
+    }
+
+    public void clearQueuedScreenInteractions() {
+        this.queuedInteractions.removeIf(QueuedInteraction::isScreenInteraction);
+        if (this.queuedInteractions.isEmpty()) {
+            this.pendingInventoryOpenClicks.clear();
+        } else {
+            this.pendingInventoryOpenClicks.discardClicks();
+        }
+    }
+
+    public void clearQueuedInteractions() {
+        this.queuedInteractions.clear();
+        this.pendingInventoryOpenClicks.clear();
+    }
+
+    public InventoryRequestStorage getRequest(final int requestId) {
+        return this.requests.get(requestId);
+    }
+
+    public void removeRequest(final int requestId) {
+        if (this.transferBatch != null || this.batchChanges != null) {
+            throw new IllegalStateException("A transfer batch must complete as a whole");
+        }
+        this.requests.remove(requestId);
+        if (!this.hasPending()) {
+            this.resetRecovery();
+        }
+    }
+
+    public void tick() {
+        if (this.pendingInventoryOpenClicks.expire(
+                System.nanoTime(), RESPONSE_TIMEOUT_NANOS)) {
+            this.clearQueuedInteractions();
+            PacketFactory.sendJavaContainerSetContent(this.user(),
+                    this.user().get(InventoryTracker.class).getInventoryContainer());
+        }
+        if (!this.hasPending()) {
+            return;
+        }
+        final long now = System.nanoTime();
+        if (this.recovery.isActive()) {
+            if (this.recovery.hasTimedOut(now, RECOVERY_TIMEOUT_NANOS)) {
+                BedrockProtocol.kickForIllegalState(this.user(),
+                        "Inventory state could not be synchronized with the Bedrock server. Reconnect to refresh your items.");
+            }
+            return;
+        }
+        if (now - this.pendingSinceNanos < RESPONSE_TIMEOUT_NANOS) {
+            return;
+        }
+
+        ViaBedrock.getPlatform().getLogger().log(Level.WARNING,
+                "Inventory request timed out; reopening player inventory for authoritative state");
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final boolean armorTouched = this.requests.isEmpty() || this.requests.values().stream()
+                .flatMap(request -> request.prevContainers().stream())
+                .anyMatch(container -> container.containerId() == tracker.getArmorContainer().containerId());
+        final boolean offhandTouched = this.requests.isEmpty() || this.requests.values().stream()
+                .flatMap(request -> request.prevContainers().stream())
+                .anyMatch(container -> container.containerId() == tracker.getOffhandContainer().containerId());
+        this.recovery.begin(now, armorTouched, offhandTouched);
+        this.clearQueuedInteractions();
+        tracker.closeScreenForInventoryRecovery();
+        final var screens = this.user().get(PlayerInventoryScreenTracker.class);
+        if (screens == null || !screens.hasPendingOpen()) {
+            final PacketWrapper interact = PacketWrapper.create(ServerboundBedrockPackets.INTERACT, this.user());
+            interact.write(Types.UNSIGNED_BYTE,
+                    (short) InteractPacketPayload_Action.OpenInventory.getValue());
+            interact.write(BedrockTypes.UNSIGNED_VAR_LONG,
+                    this.user().get(EntityTracker.class).getClientPlayer().runtimeId());
+            interact.write(BedrockTypes.OPTIONAL_POSITION_3F, null);
+            interact.sendToServer(BedrockProtocol.class);
+        }
+        this.requestInventoryRefresh();
+    }
+
+    public void handleAuthoritativeContent(final Container container) {
+        this.noteAuthoritativeUpdate(container, true, -1);
+    }
+
+    public void handleAuthoritativeSlot(final Container container, final int slot) {
+        this.noteAuthoritativeUpdate(container, false, slot);
+    }
+
+    private void noteAuthoritativeUpdate(
+            final Container container, final boolean fullContent, final int slot) {
+        if (!this.recovery.isActive() && this.craftedItemSynchronization != null) {
+            this.craftedItemSynchronization.observe(container, fullContent, slot);
+            if (this.craftedItemSynchronization.isComplete()) {
+                this.craftedItemSynchronization = null;
+                this.resetRecovery();
+                this.drainQueuedInteractions();
+                this.closeTemporaryInventoryIfIdle();
+            }
+        }
+        if (!this.recovery.isActive() || !this.hasPending()) {
+            return;
+        }
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        if (this.recovery.observe(container, tracker.getHudContainer(), fullContent, slot)) {
+            this.requests.clear();
+            this.transferBatch = null;
+            this.craftedItemSynchronization = null;
+            this.resetRecovery();
+            PacketFactory.sendJavaContainerSetContent(this.user(), tracker.getInventoryContainer());
+        }
+    }
+
+    private void resetRecovery() {
+        this.pendingSinceNanos = 0;
+        this.recovery.reset();
+    }
+
+    public void handleResponse(final ItemStackResponseInfo response) {
+        if (this.recovery.isActive() && this.requests.containsKey(response.requestId())) {
+            // The original screen has been closed. Its response cannot restore a complete
+            // player inventory or cursor, and its slot IDs may now refer to another screen.
+            return;
+        }
+        if (this.transferBatch != null && this.requests.containsKey(response.requestId())) {
+            this.transferBatch.responses().putIfAbsent(response.requestId(), this.captureTransferResponse(response));
+            if (this.transferBatch.responses().size() == this.transferBatch.requests().size()) {
+                this.completeTransferBatch();
+            }
+            return;
+        }
+        final InventoryRequestStorage request = this.requests.remove(response.requestId());
+        if (request == null) {
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Received unknown inventory request response: " + response.requestId());
+            return;
+        }
+        this.resetRecovery();
+
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        if (response.result() != ItemStackNetResult.Success) {
+            this.clearQueuedInteractions();
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Inventory request "
+                                    + response.requestId()
+                                    + " failed: "
+                                    + response.result());
+            if (this.batchChanges == null) {
+                changed.addAll(this.restoreRejectedRequest(request));
+            }
+        } else {
+            changed.addAll(this.applySuccessfulResponse(response, request));
+            if (this.synchronizeCraftedItems(request, response)) {
+                this.requestInventoryRefresh();
+            }
+        }
+
+        if (this.batchChanges != null) {
+            this.batchChanges.addAll(changed);
+            return;
+        }
+        if (response.result() == ItemStackNetResult.Success) {
+            this.drainQueuedInteractions();
+        }
+
+        for (Container container : changed) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), container);
+        }
+        PacketFactory.sendJavaContainerSetContent(this.user(), tracker.getInventoryContainer());
+        this.closeTemporaryInventoryIfIdle();
+    }
+
+    private void completeTransferBatch() {
+        final TransferBatch batch = this.transferBatch;
+        final InventoryTracker inventory = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        this.transferBatch = null;
+        this.batchChanges = changed;
+        final boolean wasPredicting = this.predictingClick;
+        this.predictingClick = true;
+        try {
+            // Restore the oldest snapshot of each touched container, then replay accepted deltas.
+            // A rejected later request must not restore an intermediate, unconfirmed network ID.
+            for (final var request : batch.requests().reversed()) {
+                changed.addAll(this.restoreRejectedRequest(request));
+            }
+            for (final var request : batch.requests()) {
+                final var response = batch.responses().get(request.requestInfo().requestId()).current(inventory);
+                if (response.result() == ItemStackNetResult.Success) {
+                    changed.addAll(request.applyPrediction(inventory));
+                }
+                this.handleResponse(response);
+            }
+        } finally {
+            this.predictingClick = wasPredicting;
+            this.batchChanges = null;
+        }
+        if (batch.responses().values().stream().allMatch(response -> response.response().result() == ItemStackNetResult.Success)) {
+            this.drainQueuedInteractions();
+        }
+        for (final var container : changed) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), container);
+        }
+        PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getInventoryContainer());
+        this.closeTemporaryInventoryIfIdle();
+    }
+
+    private BufferedTransferResponse captureTransferResponse(final ItemStackResponseInfo response) {
+        final InventoryTracker inventory = this.user().get(InventoryTracker.class);
+        final Map<Container, Long> revisions = new HashMap<>();
+        for (final var info : response.containers()) {
+            for (final var slot : info.slots()) {
+                final var owner = inventory.getContainerFromName(info.containerName(), Byte.toUnsignedInt(slot.slot()));
+                if (owner != null) {
+                    revisions.put(owner, owner.serverRevision());
+                }
+            }
+        }
+        return new BufferedTransferResponse(response, Map.copyOf(revisions));
+    }
+
+    private void requestInventoryRefresh() {
+        final PacketWrapper refresh = PacketWrapper.create(
+                ServerboundBedrockPackets.INVENTORY_TRANSACTION, this.user());
+        refresh.write(this.user().get(InventoryTransactionRewriter.class).getInventoryTransactionType(),
+                new BedrockInventoryTransaction(0, List.of(), List.of(),
+                        ComplexInventoryTransaction_Type.InventoryMismatch,
+                        new InventoryTransactionData.MismatchTransactionData()));
+        refresh.sendToServer(BedrockProtocol.class);
+    }
+
+    boolean synchronizeCraftedItems(final InventoryRequestStorage request,
+                                     final ItemStackResponseInfo response) {
+        this.craftedItemSynchronization = CraftedItemSynchronization.from(
+                request, response, this.user().get(InventoryTracker.class));
+        if (this.craftedItemSynchronization == null) {
+            return false;
+        }
+        this.pendingSinceNanos = System.nanoTime();
+        return true;
+    }
+
+    Set<Container> restoreRejectedRequest(final InventoryRequestStorage request) {
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        if (tracker.getHudContainer().serverRevision() == request.prevCursorContainer().serverRevision()) {
+            if (request.hasCurrentMenu(tracker)) {
+                tracker.getHudContainer().setItems(request.prevCursorContainer().getItems());
+            } else {
+                // The cursor survives a screen transition; temporary crafting cells do not.
+                tracker.getHudContainer().setItem(0, request.prevCursorContainer().getItem(0).copy());
+            }
+        }
+        changed.add(tracker.getInventoryContainer());
+        for (final Container snapshot : request.prevContainers()) {
+            final Container container = InventoryRequestStorage.resolveSnapshotContainer(tracker, snapshot);
+            if (container != null && request.acceptsResponse(tracker, container)
+                    && container.serverRevision() == snapshot.serverRevision()
+                    && (container != tracker.getHudContainer() || request.hasCurrentMenu(tracker))) {
+                container.setItems(snapshot.getItems());
+                changed.add(container);
+            }
+        }
+        return changed;
+    }
+
+    Set<Container> applySuccessfulResponse(final ItemStackResponseInfo response,
+                                           final InventoryRequestStorage request) {
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>(request.restoreUnconfirmedPredictions(tracker, response));
+        if (!changed.isEmpty()) {
+            this.clearQueuedInteractions();
+        }
+        for (ItemStackResponseContainerInfo containerInfo : response.containers()) {
+            for (ItemStackResponseSlotInfo slotInfo : containerInfo.slots()) {
+                final int requestSlot = Byte.toUnsignedInt(slotInfo.slot());
+                final Container container =
+                        tracker.getContainerFromName(containerInfo.containerName(), requestSlot);
+                if (container != null && !request.acceptsResponse(tracker, container)) {
+                    continue;
+                }
+                if (container == null
+                        || !container.ownsBedrockSlot(containerInfo.containerName(), requestSlot)) {
+                    ViaBedrock.getPlatform()
+                            .getLogger()
+                            .warning(
+                                    "Inventory response refers to unknown slot: "
+                                            + containerInfo.containerName()
+                                            + "/"
+                                            + requestSlot);
+                    continue;
+                }
+                final int slot = container.slotFromRequest(requestSlot);
+                if (!request.acceptsResponse(tracker, container, slot)) {
+                    continue;
+                }
+                final BedrockItem current = container.getItem(slot);
+                final BedrockItem predicted = request.predictedItem(container, slot);
+                // A full slot update with this network ID carries metadata absent from the response.
+                final boolean authoritativeIdentity = current.netId() != null
+                        && current.netId() == slotInfo.itemNetId();
+                final BedrockItem identity = authoritativeIdentity || predicted == null || predicted.isEmpty()
+                        ? current : predicted;
+                container.setItem(slot, reconcileResponseItem(identity, slotInfo));
+                changed.add(container);
+            }
+        }
+        return changed;
+    }
+
+    static BedrockItem reconcileResponseItem(final BedrockItem current,
+                                             final ItemStackResponseSlotInfo slotInfo) {
+        if (slotInfo.amount() == 0) {
+            return BedrockItem.empty();
+        }
+        final BedrockItem item = current.copy();
+        item.setAmount(Byte.toUnsignedInt(slotInfo.amount()));
+        item.setNetId(slotInfo.itemNetId());
+
+        final CompoundTag tag = item.tag() == null ? new CompoundTag() : item.tag();
+        final CompoundTag display = tag.getCompoundTag("display");
+        if (slotInfo.customName() != null && !slotInfo.customName().isEmpty()) {
+            final CompoundTag updatedDisplay = display == null ? new CompoundTag() : display;
+            updatedDisplay.putString("Name", slotInfo.customName());
+            tag.put("display", updatedDisplay);
+        } else if (display != null) {
+            display.remove("Name");
+            if (display.isEmpty()) {
+                tag.remove("display");
+            }
+        }
+        item.setTag(tag.isEmpty() ? null : tag);
+        return item;
+    }
+
+    void drainQueuedInteractions() {
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        while (!this.hasPending() && tracker.getPendingCloseContainer() == null
+                && !this.isWaitingForInventoryOpen()
+                && !this.queuedInteractions.isEmpty()) {
+            final QueuedInteraction interaction = this.queuedInteractions.removeFirst();
+            if (!interaction.isValid(tracker) || !interaction.apply()) {
+                this.clearQueuedInteractions();
+                final Container current = tracker.getCurrentContainer();
+                PacketFactory.sendJavaContainerSetContent(this.user(),
+                        current != null ? current : tracker.getInventoryContainer());
+                return;
+            }
+        }
+    }
+
+    static final class PendingInventoryOpenClicks {
+
+        private final ArrayDeque<InventoryOpenClick> clicks = new ArrayDeque<>();
+        private long openedAtNanos;
+        private boolean waiting;
+
+        boolean begin(final long now) {
+            if (this.waiting) {
+                return false;
+            }
+            this.waiting = true;
+            this.openedAtNanos = now;
+            return true;
+        }
+
+        boolean isWaiting() {
+            return this.waiting;
+        }
+
+        boolean add(final InventoryOpenClick click, final long now) {
+            if (this.clicks.size() >= MAX_QUEUED_INTERACTIONS) {
+                this.clear();
+                return false;
+            }
+            this.begin(now);
+            this.clicks.addLast(click);
+            return true;
+        }
+
+        boolean isEmpty() {
+            return this.clicks.isEmpty();
+        }
+
+        List<InventoryOpenClick> drain() {
+            final List<InventoryOpenClick> pending = List.copyOf(this.clicks);
+            this.clear();
+            return pending;
+        }
+
+        boolean expire(final long now, final long timeoutNanos) {
+            if (!this.waiting || now - this.openedAtNanos < timeoutNanos) {
+                return false;
+            }
+            this.clear();
+            return true;
+        }
+
+        void discardClicks() {
+            this.clicks.clear();
+        }
+
+        void clear() {
+            this.discardClicks();
+            this.openedAtNanos = 0;
+            this.waiting = false;
+        }
+    }
+
+    record InventoryOpenClick(int revision, short slot, byte button, ContainerInput action) { }
+
+    private record TransferBatch(List<InventoryRequestStorage> requests,
+                                 Int2ObjectOpenHashMap<BufferedTransferResponse> responses) { }
+
+    private record BufferedTransferResponse(ItemStackResponseInfo response, Map<Container, Long> revisions) {
+
+        private ItemStackResponseInfo current(final InventoryTracker inventory) {
+            final List<ItemStackResponseContainerInfo> containers = this.response.containers().stream().map(info ->
+                    new ItemStackResponseContainerInfo(info.containerName(), info.slots().stream().filter(slot -> {
+                        final var owner = inventory.getContainerFromName(info.containerName(), Byte.toUnsignedInt(slot.slot()));
+                        // Keep unknown slots for the normal response diagnostic. A new owner or
+                        // a later contents update supersedes an earlier buffered acknowledgment.
+                        return owner == null || Long.valueOf(owner.serverRevision()).equals(this.revisions.get(owner));
+                    }).toList())).filter(info -> !info.slots().isEmpty()).toList();
+            return new ItemStackResponseInfo(this.response.result(), this.response.requestId(), containers);
+        }
+
+    }
+
+    interface QueuedInteraction {
+
+        Container container();
+
+        default boolean isScreenInteraction() {
+            return true;
+        }
+
+        default boolean isValid(final InventoryTracker tracker) {
+            return tracker.getContainerServerbound(this.container().javaContainerId()) == this.container();
+        }
+
+        boolean apply();
+    }
+
+    private record QueuedClick(Container container, int revision, short slot, byte button,
+                               ContainerInput action) implements QueuedInteraction {
+
+        @Override
+        public boolean apply() {
+            return this.container.handleClick(this.revision, this.slot, this.button, this.action);
+        }
+    }
+
+    private record QueuedButtonClick(Container container, int button) implements QueuedInteraction {
+
+        @Override
+        public boolean apply() {
+            return this.container.handleButtonClick(this.button);
+        }
+    }
