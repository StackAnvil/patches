+        stored.putString("Name", "minecraft:arrow");
+        stored.putByte("Count", (byte) 1);
+        final CompoundTag nested = new CompoundTag();
+        nested.putInt("customColor", 0x123456);
+        stored.put("tag", nested);
+        for (short data : new short[]{0, 15, 42, Short.MAX_VALUE}) {
+            stored.putShort("Damage", data);
+            final BedrockItem decoded = items.bedrockItemStack(stored);
+            assertEquals(data == Short.MAX_VALUE ? 0 : data, decoded.data());
+            assertEquals(1, decoded.amount());
+            assertNotSame(nested, decoded.tag());
+            assertEquals(nested, decoded.tag());
+            assertEquals(data, stored.getShort("Damage"));
