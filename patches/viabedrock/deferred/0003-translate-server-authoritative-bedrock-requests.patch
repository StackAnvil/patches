+                    final var value = destination.getAsJsonObject();
+                    final var container = containers.get(value.get("collection").getAsString());
+                    assertNotNull(container, value::toString);
+                    // Compare physical destinations. Native wire-role encoding has a separate caller boundary.
+                    final int offset = container == ContainerEnumName.OffhandContainer ? 1
+                            : container == ContainerEnumName.CombinedHotbarAndInventoryContainer ? 9 : 0;
