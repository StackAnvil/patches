+package net.raphimc.viabedrock.protocol.packet;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryActionData;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class DropTransactionTest {
+
+    @Test
+    void dropTransactionsDebitTheSelectedContainerBeforeCreditingTheWorld() {
+        final BedrockItem held = new BedrockItem(42);
+        held.setAmount(4);
+        for (final boolean dropAll : new boolean[] {false, true}) {
+            final BedrockInventoryTransaction transaction =
+                    InteractionPackets.dropTransaction(held, 7, dropAll);
+            assertEquals(2, transaction.actions().size());
+            final InventoryActionData debit = transaction.actions().get(0);
+            final InventoryActionData world = transaction.actions().get(1);
+            assertEquals(InventorySourceType.Container_Inventory, debit.source().type());
+            assertEquals(7, debit.slot());
+            assertEquals(4, debit.fromItem().amount());
+            assertEquals(dropAll ? 0 : 3, debit.toItem().amount());
+            assertEquals(InventorySourceType.World_Interaction, world.source().type());
+            assertEquals(0, world.source().flags().getValue()); // Bedrock drop interaction
+            assertTrue(world.fromItem().isEmpty());
+            assertEquals(dropAll ? 4 : 1, world.toItem().amount());
+            assertEquals(held.amount(), debit.toItem().amount() + world.toItem().amount());
+        }
+        assertEquals(4, held.amount());
+    }
+
+}
