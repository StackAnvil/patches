+            }
+
+            @Override
+            public boolean isScreenInteraction() {
+                return false;
+            }
+
+            @Override
+            public boolean apply() {
+                applied.add(1);
+                return true;
+            }
+        }));
+        assertTrue(fixture.requests.beginInventoryOpen());
+        fixture.requests.clearQueuedScreenInteractions();
+        fixture.requests.drainQueuedInteractions();
+        assertTrue(applied.isEmpty());
+        assertTrue(fixture.requests.isWaitingForInventoryOpen());
+
+        fixture.requests.handleInventoryOpen(fixture.container);
+        assertEquals(List.of(1), applied);
+        assertFalse(fixture.requests.isWaitingForInventoryOpen());
+    }
+
+    private static final class Fixture {
+
+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? this.storage.get(args[0]) : null);
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final InventoryRequestTracker requests = new InventoryRequestTracker(this.user);
+        private final TestContainer container = new TestContainer(this.user, this.requests);
+
+        private Fixture() {
+            this.storage.put(InventoryTracker.class, this.inventory);
+            this.storage.put(InventoryRequestTracker.class, this.requests);
+            this.inventory.setCurrentContainer(this.container);
+        }
+    }
+
+    private static final class TestContainer extends Container {
+
+        private final InventoryRequestTracker requests;
+        private final List<Integer> netIdsAtClick = new ArrayList<>();
+        private final List<Integer> requestIds = new ArrayList<>();
+        private int netId;
+
+        private TestContainer(final UserConnection user, final InventoryRequestTracker requests) {
+            super(user, (byte) 5, ContainerType.CONTAINER, null, null, 9);
+            this.requests = requests;
+        }
+
+        @Override
+        public boolean handleClick(final int revision, final short javaSlot, final byte button,
+                                   final ContainerInput action) {
+            this.netIdsAtClick.add(this.netId);
+            final int requestId = this.requests.nextRequestId();
+            this.requestIds.add(requestId);
+            this.requests.addRequest(new InventoryRequestStorage(
+                    new ItemStackRequestInfo(requestId, List.of(), List.of(), TextProcessingEventOrigin.unknown),
+                    revision, null, List.of()));
+            return true;
+        }
+    }
+
+}
