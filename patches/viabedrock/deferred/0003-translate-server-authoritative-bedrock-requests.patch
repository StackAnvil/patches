+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataContainer;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class StonecutterRecipePacketTest {
+
+    @Test
+    void ingredientSupportsTypedTranslationAndDirectWireEncoding() throws ClassNotFoundException {
+        // Match ViaVersion's component initialization order outside its platform bootstrap.
+        Class.forName(StructuredDataKey.class.getName());
+        final var packet = new PacketWrapperImpl(0, null, null);
+        final var output = new StructuredItem(320, 2, new StructuredDataContainer());
+        CraftingDataTracker.writeStonecutterRecipe(packet, 319, 4, output);
+        packet.resetReader();
+
+        // ViaBackwards reads typed fields before the packet reaches the wire.
+        assertArrayEquals(new int[]{319}, packet.passthrough(Types.HOLDER_SET).ids());
+        assertEquals(4, packet.passthrough(Types.VAR_INT));
+        assertSame(output, packet.passthrough(VersionedTypes.V26_3.itemTemplate));
+
+        final var buffer = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(buffer);
+            assertEquals(0, Types.VAR_INT.readPrimitive(buffer)); // packet id
+            assertEquals(2, Types.VAR_INT.readPrimitive(buffer)); // one explicit holder id
+            assertEquals(319, Types.VAR_INT.readPrimitive(buffer));
+            assertEquals(4, Types.VAR_INT.readPrimitive(buffer));
+            final var decodedOutput = VersionedTypes.V26_3.itemTemplate.read(buffer);
+            assertEquals(output.identifier(), decodedOutput.identifier());
+            assertEquals(output.amount(), decodedOutput.amount());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
