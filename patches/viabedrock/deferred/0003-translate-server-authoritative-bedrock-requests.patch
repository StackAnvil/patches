+    @Override
+    public boolean hasComplexAlias(final String name) {
+        return this.items.hasComplexAlias(name);
+    }
+
+    @Override
+    public NativeRecipeDescriptor.Lookup lookupItem(final String name, final short auxiliary) {
+        final var lookup = this.items.lookup(name, auxiliary);
+        return new NativeRecipeDescriptor.Lookup(lookup.definition(), lookup.auxiliary());
+    }
+
+    @Override
+    public NativeItemDefinitions.Definition<?> fallbackBlockItem(final String name) {
+        final Integer id = this.blocks.registeredBlockItemId(name);
+        return id != null ? this.items.definition(id) : null;
+    }
+
+    @Override
+    public boolean hasAssociatedBlock(final NativeItemDefinitions.Definition<?> item) {
+        return this.items.associatedBlock(item) != null;
+    }
+
+    @Override
+    public Object blockState(final NativeItemDefinitions.Definition<?> item, final short auxiliary) {
+        final String association = this.items.associatedBlock(item);
+        return association != null ? this.blocks.blockItemState(association, auxiliary) : null;
+    }
+
+    @Override
+    public NativeItemDefinitions.Definition<?> aliasRepresentative(final String name) {
+        return this.items.lookup(name, 0).definition();
+    }
+
+    @Override
+    public List<String> aliasMembers(final String name) {
+        return this.items.complexAliasMembers(name);
+    }
+
+    @Override
+    public NativeItemDefinitions.Definition<?> aliasMember(final String name) {
+        return this.items.directDefinition(name);
+    }
+
+}
