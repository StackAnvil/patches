+    }
+
+    @Override
+    public int bedrockSlot(final int javaSlot) {
+        if (javaSlot < 0 || javaSlot >= this.javaSize()) {
+            return -1;
+        }
+        if (javaSlot < 2) {
+            return javaSlot < this.equipmentSlots ? javaSlot : -1;
+        }
+        return this.equipmentSlots + javaSlot - 2;
+    }
+
+    @Override
+    protected BedrockItem[] itemsInJavaOrder(final BedrockItem[] items) {
+        final BedrockItem[] mapped = BedrockItem.emptyArray(this.javaSize());
+        for (int slot = 0; slot < items.length; slot++) {
+            final int javaSlot = this.javaSlot(slot);
+            if (javaSlot >= 0) {
+                mapped[javaSlot] = items[slot];
+            }
+        }
+        return mapped;
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        if (slot < 0 || slot >= this.size()) {
+            throw new IllegalArgumentException("Invalid mount inventory slot: " + slot);
+        }
+        return new FullContainerName(slot < this.equipmentSlots
+                ? ContainerEnumName.HorseEquipContainer : ContainerEnumName.LevelEntityContainer, null);
+    }
+
+    @Override
+    protected boolean canPlaceItem(final int slot, final BedrockItem item) {
+        if (item.isEmpty()) {
+            return true;
+        }
+        if (this.javaSlot(slot) < 0) {
+            return false;
+        }
+        if (slot >= this.equipmentSlots) {
+            return true;
+        }
+        final String identifier = this.user.get(ItemRewriter.class).getItems().inverse().get(item.identifier());
+        return this.acceptsEquipment(slot, identifier, item.data());
+    }
+
+    boolean acceptsEquipment(final int slot, final String identifier, final short aux) {
+        final List<EquipmentItem> accepted = this.acceptedItems.get(slot);
+        if (accepted != null) {
+            return accepted.stream().anyMatch(candidate -> candidate.identifier().equals(identifier)
+                    && (candidate.aux() == Short.MAX_VALUE || candidate.aux() == aux));
+        }
+        // A ContainerOpen may precede UpdateEquip. Vanilla rules remain safe until it arrives.
+        return slot == 0 ? "minecraft:saddle".equals(identifier)
+                : identifier != null && identifier.startsWith("minecraft:")
+                && (identifier.startsWith("minecraft:horsearmor") || identifier.endsWith("_horse_armor"));
+    }
+
+    @Override
+    protected List<QuickMoveRange> quickMoveRanges(final short javaSlot, final SlotRef source) {
+        final var inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        if (source.container() != inventory) {
+            return super.quickMoveRanges(javaSlot, source);
+        }
+        final List<QuickMoveRange> ranges = new ArrayList<>();
+        final BedrockItem item = source.container().getItem(source.bedrockSlot());
+        for (int slot = 0; slot < this.equipmentSlots; slot++) {
+            if (this.getItem(slot).isEmpty() && this.canPlaceItem(slot, item)) {
+                ranges.add(new QuickMoveRange(this, slot, slot + 1, false));
+                break;
+            }
+        }
+        if (this.storageColumns > 0) {
+            ranges.add(new QuickMoveRange(this, 2, this.javaSize(), false));
+        } else if (ranges.isEmpty()) {
+            // An unchested mount still allows moving between the player's main inventory and hotbar.
+            ranges.add(new QuickMoveRange(inventory, javaSlot < this.javaSize() + 27 ? 36 : 9,
+                    javaSlot < this.javaSize() + 27 ? 45 : 36, false));
+        }
+        return ranges;
+    }
+
+    private record EquipmentItem(String identifier, short aux) { }
+
