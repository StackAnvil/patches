+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PlayerInventoryScreenTrackerTest {
+
+    @Test
+    void retiresAnEarlyCloseBeforeOpeningTheNewScreen() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.request(1, false);
+            f.request(2, true);
+            assertEquals(1, f.opens());
+            assertFalse(f.screens.acceptsClicks());
+            f.acknowledge();
+            assertNotNull(f.inventory.getPendingCloseContainer());
+            assertEquals(1, f.opens());
+            f.inventory.setCurrentContainerClosed(false);
+            assertEquals(2, f.opens());
+            f.acknowledge();
+            f.request(1, false);
+            assertTrue(f.screens.acceptsClicks());
+            assertNull(f.inventory.getPendingCloseContainer());
+        }
+    }
+
+    @Test
+    void serializesReopeningTheSameJavaMenuAfterNativeClose() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.acknowledge();
+            final long oldGeneration = f.inventory.currentContainerGeneration();
+            f.request(1, true);
+            assertEquals(1, f.opens());
+            f.request(1, false);
+            f.request(2, true);
+            assertEquals(1, f.opens());
+            f.inventory.setCurrentContainerClosed(false);
+            assertEquals(2, f.opens());
+            f.acknowledge();
+            assertTrue(f.inventory.currentContainerGeneration() > oldGeneration);
+        }
+    }
+
+    @Test
+    void timeoutRetainsTheUncorrelatedAcknowledgmentTombstone() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.screens.tick(System.nanoTime() + TimeUnit.SECONDS.toNanos(6));
+            assertEquals(List.of(1L), f.closedScreens());
+            f.request(2, true);
+            assertEquals(1, f.opens());
+            f.acknowledge();
+            f.inventory.setCurrentContainerClosed(false);
+            assertEquals(2, f.opens());
+            f.acknowledge();
+        }
+    }
+
+    @Test
+    void adoptsAnExistingTemporaryInventoryWithoutSendingAnotherOpen() throws Exception {
+        try (var f = new Fixture()) {
+            f.inventory.setCurrentContainer(f.newInventory());
+            f.requests.openPlayerInventoryTemporarily();
+            f.request(1, true);
+            assertEquals(0, f.opens());
+            assertTrue(f.screens.acceptsClicks());
+            f.requests.handleInventoryOpen(f.inventory.getCurrentContainer());
+            assertNotNull(f.inventory.getCurrentContainer());
+            f.request(1, false);
+            assertNotNull(f.inventory.getPendingCloseContainer());
+        }
+    }
+
+    @Test
+    void serverCloseTargetsOnlyTheOwningClientOpening() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.acknowledge();
+            f.inventory.setCurrentContainerClosed(true);
+            assertEquals(List.of(1L), f.closedScreens());
+            assertFalse(f.screens.ownsClose());
+            f.request(2, true);
+            f.acknowledge();
+            f.request(1, false);
+            assertTrue(f.screens.acceptsClicks());
+        }
+    }
+
+    @Test
+    void anUnrelatedNativeMenuRejectsThePlayerScreenWithoutClosingTheMenu() throws Exception {
+        try (var f = new Fixture()) {
+            final var chest = mock(Container.class);
+            when(chest.type()).thenReturn(ContainerType.CONTAINER);
+            f.inventory.setCurrentContainer(chest);
+            f.request(1, true);
+            assertEquals(List.of(1L), f.closedScreens());
+            assertSame(chest, f.inventory.getCurrentContainer());
+            assertEquals(0, f.opens());
+        }
+    }
+
+    @Test
+    void retainsTheNativeWaitAcrossScreenRetirementAndRunsLaterGlobalActions() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.request(1, false);
+            assertTrue(f.requests.isWaitingForInventoryOpen());
+            assertFalse(f.requests.beginInventoryOpen());
+            final var applied = new ArrayList<Integer>();
+            assertTrue(f.requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+
+                @Override
+                public Container container() {
+                    return f.inventory.getInventoryContainer();
+                }
+
+                @Override
+                public boolean isScreenInteraction() {
+                    return false;
+                }
+
+                @Override
+                public boolean isValid(final InventoryTracker tracker) {
+                    return tracker.getCurrentContainer() instanceof InventoryContainer;
+                }
+
+                @Override
+                public boolean apply() {
+                    applied.add(1);
+                    return true;
+                }
+            }));
+            f.acknowledge();
+            assertEquals(List.of(1), applied);
+            assertEquals(1, f.opens());
+            assertNotNull(f.inventory.getPendingCloseContainer());
+        }
+    }
+
+    @Test
+    void formReplacementUsesOnlyTheCorrelatedPlayerCloseWhileAnActionIsPending() throws Exception {
+        try (var f = new Fixture()) {
+            f.request(1, true);
+            f.acknowledge();
+            doReturn(true).when(f.requests).hasPending();
+            f.inventory.closeContainerForForm();
+            assertEquals(List.of(1L), f.closedScreens());
+            assertNotNull(f.inventory.getPendingCloseContainer());
+        }
+    }
+
+    @Test
+    void reconfigurationRetiresTheScreenWithoutSendingPlayPayloadsDuringConfiguration() throws Exception {
+        try (var f = new Fixture()) {
+            f.screens.refreshCapability();
+            f.request(1, true);
+            assertEquals(2, f.sent.size());
+            when(f.user.getProtocolInfo().getClientState()).thenReturn(State.CONFIGURATION);
+            f.screens.refreshCapability();
+            assertEquals(2, f.sent.size());
+            assertTrue(f.screens.hasPendingOpen());
+            assertFalse(f.screens.acceptsClicks());
+            when(f.user.getProtocolInfo().getClientState()).thenReturn(State.PLAY);
+            f.screens.refreshCapability();
+            f.request(2, true);
+            assertEquals(1, f.opens());
+            f.acknowledge();
+            f.inventory.setCurrentContainerClosed(false);
+            assertEquals(2, f.opens());
+        }
+    }
