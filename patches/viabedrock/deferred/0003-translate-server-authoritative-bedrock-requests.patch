+
+final class NativeContainerResponseTest {
+
+    @Test
+    void cursorOnlySuccessDoesNotConfirmThePredictedTransfer() {
+        try (var fixture = new Fixture()) {
+            final var changed = fixture.respond(List.of(ack(ContainerEnumName.CursorContainer, 0, 0, 0)));
+            assertEquals(4, fixture.menu.getItem(9).amount());
+            assertEquals(1008, fixture.menu.getItem(9).netId());
+            assertTrue(fixture.inventory.getInventoryContainer().getItem(0).isEmpty());
+            assertTrue(fixture.inventory.getHudContainer().getItem(0).isEmpty());
+            assertTrue(changed.contains(fixture.menu));
+        }
+    }
+
+    @Test
+    void completeResponsesRetainTheTransferAndUseAcknowledgedNetworkIds() {
+        for (final ContainerEnumName inventoryName : List.of(ContainerEnumName.CombinedHotbarAndInventoryContainer,
+                ContainerEnumName.HotbarContainer, ContainerEnumName.InventoryContainer)) {
+            try (var fixture = new Fixture()) {
+                fixture.respond(List.of(ack(ContainerEnumName.LevelEntityContainer, 9, 3, 1008),
+                        ack(inventoryName, 0, 1, 2001)));
+                assertEquals(3, fixture.menu.getItem(9).amount());
+                assertEquals(1, fixture.inventory.getInventoryContainer().getItem(0).amount());
+                assertEquals(2001, fixture.inventory.getInventoryContainer().getItem(0).netId());
+                assertEquals(4, fixture.inventory.getHudContainer().getItem(0).amount());
+            }
+        }
+    }
+
+    @Test
+    void partialResponsesRetainOnlyExplicitlyAcknowledgedSlotChanges() {
+        for (final boolean sourceAcknowledged : new boolean[] {false, true}) {
+            try (var fixture = new Fixture()) {
+                fixture.respond(List.of(sourceAcknowledged
+                        ? ack(ContainerEnumName.LevelEntityContainer, 9, 3, 1008)
+                        : ack(ContainerEnumName.CombinedHotbarAndInventoryContainer, 0, 1, 2001)));
+                assertEquals(sourceAcknowledged ? 3 : 4, fixture.menu.getItem(9).amount());
+                assertEquals(sourceAcknowledged ? 0 : 1, fixture.inventory.getInventoryContainer().getItem(0).amount());
+                assertEquals(4, fixture.inventory.getHudContainer().getItem(0).amount());
+            }
+        }
+    }
+
+    @Test
+    void unconfirmedTransfersDiscardClicksQueuedAgainstThePredictedContents() {
+        try (var fixture = new Fixture()) {
+            final var applied = new AtomicInteger();
