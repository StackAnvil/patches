+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeTransferQuantityTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_TRANSFER_QUANTITIES", matches = ".+")
+    void matchesOriginalNativeDecoderIncludingRejectedDescriptors() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_TRANSFER_QUANTITIES")))).getAsJsonObject();
+        final var rows = reference.getAsJsonArray("rows");
+        assertFalse(rows.isEmpty());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var quantity = new NativeTransferQuantity(row.get("kind").getAsInt(), row.get("value").getAsInt());
+            assertEquals(row.get("result").getAsInt(), quantity.count(row.get("available").getAsInt()), row::toString);
+        }
+    }
+
+    @Test
+    void preservesTheDistinctNativeDescriptorDomains() {
+        assertEquals(4, new NativeTransferQuantity(0, 4).count(9));
+        assertEquals(9, new NativeTransferQuantity(0, Integer.MAX_VALUE).count(9));
+        assertEquals(0, new NativeTransferQuantity(0, Integer.MIN_VALUE).count(9));
+        assertEquals(9, NativeTransferQuantity.ALL.count(9));
+        assertEquals(5, NativeTransferQuantity.HALF.count(9));
+        assertEquals(1, NativeTransferQuantity.ONE.count(9));
+        assertEquals(9, new NativeTransferQuantity(2, 0).count(9));
+        assertEquals(1, new NativeTransferQuantity(2, 1).count(9));
+        assertEquals(0, new NativeTransferQuantity(2, 2).count(9));
+        assertEquals(0, new NativeTransferQuantity(1, -1).count(9));
+        assertEquals(0, new NativeTransferQuantity(3, 0).count(9));
+        // This is the decoder boundary. The executor's empty-source guard precedes it.
+        assertEquals(1, NativeTransferQuantity.ONE.count(0));
+        assertEquals(0, NativeTransferQuantity.ALL.count(0));
+    }
+
+    @Test
+    void narrowsAvailableCountsBeforeQuantitySelection() {
+        assertEquals(255, NativeTransferQuantity.ALL.count(-1));
+        assertEquals(128, NativeTransferQuantity.HALF.count(-1));
+        assertEquals(0, NativeTransferQuantity.ALL.count(256));
+        assertEquals(1, NativeTransferQuantity.ALL.count(257));
+        assertEquals(255, new NativeTransferQuantity(0, 300).count(511));
+    }
+
+}
