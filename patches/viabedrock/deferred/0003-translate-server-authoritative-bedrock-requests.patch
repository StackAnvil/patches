+        assertTrue(fixture.receive((byte) 6, 0, 9).isCancelled());
+        assertTrue(fixture.furnace.getData().isEmpty());
+        fixture.receive((byte) 5, 0, 7);
+        fixture.inventory.markPendingClose(fixture.furnace);
+        assertTrue(fixture.receive((byte) 5, 0, 8).isCancelled());
+        fixture.inventory.setCurrentContainerClosed(false);
+        assertTrue(fixture.receive((byte) 5, 0, 9).isCancelled());
+        final var reopened = new FurnaceContainer(fixture.user, (byte) 5, null, null);
+        fixture.inventory.setCurrentContainer(reopened);
+        assertTrue(reopened.getData().isEmpty());
+        assertEquals(0, reopened.serverDataRevision());
+        fixture.receive((byte) 5, 0, 10);
+        assertEquals(Integer.valueOf(7), fixture.furnace.getData(0));
+        assertEquals(Integer.valueOf(10), reopened.getData(0));
+    }
+
+    private static final class Fixture {
+        private final UserConnection user = mock(UserConnection.class);
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final FurnaceContainer furnace = new FurnaceContainer(this.user, (byte) 5, null, null);
+
+        private Fixture() {
+            when(this.user.get(InventoryTracker.class)).thenReturn(this.inventory);
+            this.inventory.setCurrentContainer(this.furnace);
+        }
+
+        private PacketWrapper receive(final byte containerId, final int property, final int value) throws Exception {
+            return this.receive(containerId, property, value, InventoryPackets::handleContainerData);
+        }
+
+        private PacketWrapper receive(final byte containerId, final int property, final int value,
+                                      final PacketHandler handler) throws Exception {
+            final ByteBuf bytes = Unpooled.buffer();
+            try {
+                bytes.writeByte(containerId);
+                BedrockTypes.VAR_INT.writePrimitive(bytes, property);
+                BedrockTypes.VAR_INT.writePrimitive(bytes, value);
+                final var packet = new PacketWrapperImpl(ClientboundPackets26_3.CONTAINER_SET_DATA, bytes, this.user);
+                handler.handle(packet);
+                assertFalse(bytes.isReadable());
+                return packet;
+            } finally {
+                bytes.release();
+            }
+        }
+    }
+
+}
