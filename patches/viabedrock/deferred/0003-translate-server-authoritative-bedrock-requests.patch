+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+
+import net.raphimc.viabedrock.api.model.container.block.CraftingTableContainer;
+import net.raphimc.viabedrock.api.model.container.block.EnchantmentContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class InventoryTrackerTest {
+
+    @Test
+    void hotbarResponseSlotsBelongToTheInventory() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final FullContainerName inventoryName =
+                new FullContainerName(ContainerEnumName.CombinedHotbarAndInventoryContainer, null);
+
+        assertSame(tracker.getInventoryContainer(), tracker.getContainerFromName(inventoryName, 8));
+        assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 0));
+        assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 8));
+        assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 35));
+        assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 36));
+    }
+
+    @Test
+    void craftingInputResponseUsesOpenTableInsteadOfPlayerGrid() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final FullContainerName craftingInput = new FullContainerName(ContainerEnumName.CraftingInputContainer, null);
+
+        assertSame(tracker.getHudContainer(), tracker.getContainerFromName(craftingInput, 28));
+        final CraftingTableContainer table = new CraftingTableContainer(user, (byte) 5, null, null);
+        tracker.setCurrentContainer(table);
+        assertSame(table, tracker.getContainerFromName(craftingInput, 32));
+        assertSame(tracker.getHudContainer(), tracker.getContainerFromName(craftingInput, 28));
+    }
+
+    @Test
+    void playerUiCraftingSlotsUpdateTheOpenTable() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final CraftingTableContainer table = new CraftingTableContainer(user, (byte) 5, null, null);
+        tracker.setCurrentContainer(table);
+
+        final FullContainerName input = new FullContainerName(ContainerEnumName.CraftingInputContainer, null);
+        assertSame(table, tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 32, input, null));
+        assertSame(table, tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 32, null, null));
+        assertSame(tracker.getHudContainer(), tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 28, input, null));
+        assertSame(tracker.getHudContainer(), tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 50, null, null));
+    }
+
+    @Test
+    void playerUiEnchantingSlotsUpdateTheOpenTable() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final EnchantmentContainer table = new EnchantmentContainer(user, (byte) 5, null, null);
+        tracker.setCurrentContainer(table);
+
+        final FullContainerName input = new FullContainerName(ContainerEnumName.EnchantingInputContainer, null);
+        assertSame(table, tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 14, input, null));
+        assertSame(table, tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 14, null, null));
+        assertSame(tracker.getHudContainer(), tracker.getContainerClientboundSlot(
+                tracker.getHudContainer().containerId(), 14,
+                new FullContainerName(ContainerEnumName.EnchantingMaterialContainer, null), null));
+    }
+
+}
