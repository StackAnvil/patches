+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.container.player.ArmorContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeArmorPlacementTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ARMOR_PLACEMENT", matches = ".+")
+    void matchesSelectedDefinitionsAndCompleteArmorDestinationDecisions() throws Exception {
+        try (var stream = new GZIPInputStream(Files.newInputStream(Path.of(System.getenv("STACKANVIL_NATIVE_ARMOR_PLACEMENT"))));
+             var reader = new InputStreamReader(stream, StandardCharsets.UTF_8)) {
+            for (final var element : JsonParser.parseReader(reader).getAsJsonArray()) {
+                this.checkControl(element.getAsJsonObject());
+            }
+        }
+    }
+
+    private void checkControl(final JsonObject reference) {
+        assertTrue(reference.getAsJsonArray("remainingAllocations").isEmpty());
+        assertTrue(reference.getAsJsonObject("heldLocks").isEmpty());
+        assertTrue(reference.get("backingCleanupCompleted").getAsBoolean());
+        assertTrue(reference.get("capacityPolicyCleanupCompleted").getAsBoolean());
+        final var entries = new ArrayList<ItemEntry>();
+        for (final var element : reference.getAsJsonObject("fixture").getAsJsonArray("items")) {
+            final var row = element.getAsJsonObject();
+            entries.add(new ItemEntry(row.get("name").getAsString(), row.get("id").getAsInt(),
+                    row.get("componentBased").getAsBoolean(), ItemVersion.getByValue(row.get("version").getAsInt()),
+                    decode(row.get("nbtHex").getAsString())));
+        }
+        final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+        final var user = mock(UserConnection.class);
+        final var rewriter = mock(ItemRewriter.class);
+        when(user.get(ItemRewriter.class)).thenReturn(rewriter);
+        when(rewriter.getItemRegistry()).thenReturn(registry);
+        final var armor = new ArmorContainer(user) {
+            boolean admits(final int slot, final BedrockItem item, final int amount) {
+                return this.canPlaceItem(slot, item, amount);
+            }
+        };
+        final var inputs = new ArrayList<BedrockItem>();
+        for (final var element : reference.getAsJsonArray("inputs")) {
+            final var row = element.getAsJsonObject();
+            // Native constructors already selected these receivers. Construction and Block palette parity have separate controls.
+            final var definition = row.get("storedName").isJsonNull() ? null : registry.definition(row.get("storedName").getAsString());
+            if (!row.get("item").isJsonNull()) {
+                assertNotNull(definition, row::toString);
+                assertEquals(row.get("id").getAsInt(), definition.id(), row::toString);
+            }
+            final var item = definition != null
+                    ? new BedrockItem(definition, row.get("aux").getAsShort(), (byte) row.get("count").getAsInt())
+                    : new BedrockItem(0, row.get("aux").getAsShort(), (byte) row.get("count").getAsInt());
+            if (row.get("kind").getAsString().equals("saved")) {
+                final var userdata = decode(row.get("nbtHex").getAsString()).getCompoundTag("tag");
+                item.setTag(userdata != null ? userdata.copy() : null);
+            }
+            final Integer expected = row.get("isArmor").getAsBoolean() ? row.get("armorSlot").getAsInt() : null;
+            assertEquals(expected, registry.armorSlot(item), row::toString);
+            inputs.add(item);
+        }
+        for (final var element : reference.getAsJsonArray("callbackRows")) {
+            final var row = element.getAsJsonObject();
+            final var item = inputs.get(row.get("input").getAsInt());
+            final Integer slot = registry.armorSlot(item);
+            assertEquals(row.get("allowed").getAsBoolean(), row.get("quantity").getAsInt() == 1
+                    && slot != null && slot == row.get("slot").getAsInt(), row::toString);
+        }
+        int previousInput = -1;
+        boolean previousOccupied = false;
+        for (final var element : reference.getAsJsonArray("destinationRows")) {
+            final var row = element.getAsJsonObject();
+            final int input = row.get("input").getAsInt();
+            final boolean occupied = row.get("occupied").getAsBoolean();
+            if (input != previousInput || occupied != previousOccupied) {
+                final var contents = BedrockItem.emptyArray(4);
+                if (occupied) {
+                    Arrays.fill(contents, inputs.get(input));
+                }
+                armor.setItems(contents);
+                previousInput = input;
+                previousOccupied = occupied;
+            }
+            assertEquals(row.get("result").getAsInt() != 3,
+                    armor.admits(row.get("slot").getAsInt(), inputs.get(input), row.get("quantity").getAsInt()), row::toString);
+        }
+    }
+
+    private static CompoundTag decode(final String hexadecimal) {
+        final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(hexadecimal));
+        try {
+            final var tag = (CompoundTag) BedrockTypes.TAG_LE.read(bytes);
+            assertFalse(bytes.isReadable());
+            return tag;
+        } finally {
+            bytes.release();
+        }
+    }
+
+}
