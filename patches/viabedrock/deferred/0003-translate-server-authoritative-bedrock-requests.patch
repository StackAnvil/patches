+
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+final class NativeAutoPlacementRecoveryTest {
+
+    @org.junit.jupiter.api.Test
+    void usesExistingResponseRecoveryWithoutChangingTheHeldCursor() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user =
+                (UserConnection)
+                        Proxy.newProxyInstance(
+                                UserConnection.class.getClassLoader(),
+                                new Class<?>[] {UserConnection.class},
+                                (proxy, method, values) ->
+                                        method.getName().equals("get")
+                                                ? storage.get(values[0])
+                                                : null);
+        final var inventory = new InventoryTracker(user);
+        final var requests = new InventoryRequestTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        requests.setPredictingClick(true);
+        final var menu = new ChestContainer(user, (byte) 6, null, null, 27);
+        inventory.setCurrentContainer(menu);
+        menu.setItem(9, item(4, 1008));
+        menu.setData(0, 12);
+        inventory.getHudContainer().setItem(0, item(4, 5001));
+        final var binding =
+                new NativeContainerAutoPlacement.Binding(
+                        menu, inventory.currentContainerGeneration(), 1);
+        final var plan =
+                NativeContainerAutoPlacement.plan(
+                        binding,
+                        menu,
+                        inventory.currentContainerGeneration(),
+                        1,
+                        9,
+                        inventory.getInventoryContainer(),
+                        64, NativeAutoPlacementRecoveryTest::matches);
+        final var previous =
+                new InventoryRequestStorage(
+                        new ItemStackRequestInfo(
+                                requests.nextRequestId(),
+                                List.of(plan.action()),
+                                List.of(),
+                                TextProcessingEventOrigin.unknown),
+                        7,
+                        inventory.getHudContainer().copy(),
+                        List.of(menu.copy(), inventory.getInventoryContainer().copy()));
+        menu.setItem(9, plan.transfer().sourceAfter());
+        inventory.getInventoryContainer().setItem(plan.transfer().destinationSlot(), plan.transfer().destinationAfter());
+        previous.capturePrediction(inventory);
+        menu.setData(0, 13);
+        requests.restoreRejectedRequest(previous);
+        check(menu.getData(0) == 13 && menu.serverDataRevision() == 2);
+        check(previous.prevContainers().get(0).getData(0) == 12);
+        check(
+                menu.getItem(9).amount() == 4
+                        && inventory.getInventoryContainer().getItem(0).isEmpty());
+        check(
+                inventory.getHudContainer().getItem(0).amount() == 4
+                        && inventory.getHudContainer().getItem(0).netId() == 5001);
+        menu.setItem(9, plan.transfer().sourceAfter());
+        inventory.getInventoryContainer().setItem(0, plan.transfer().destinationAfter());
+        requests.applySuccessfulResponse(
+                new ItemStackResponseInfo(
+                        ItemStackNetResult.Success,
+                        previous.requestInfo().requestId(),
+                        List.of(
+                                new ItemStackResponseContainerInfo(
+                                        plan.action().source().container(),
+                                        List.of(
+                                                new ItemStackResponseSlotInfo(
+                                                        (byte) 9, (byte) 9, (byte) 3, 1008, "",
+                                                        null, 0))),
+                                new ItemStackResponseContainerInfo(
+                                        plan.action().destination().container(),
+                                        List.of(
+                                                new ItemStackResponseSlotInfo(
+                                                        (byte) 0, (byte) 0, (byte) 1, 3012, "",
+                                                        null, 0))))),
+                previous);
+        check(
+                menu.getItem(9).amount() == 3
+                        && inventory.getInventoryContainer().getItem(0).netId() == 3012);
+        check(
+                inventory.getHudContainer().getItem(0).amount() == 4
+                        && inventory.getHudContainer().getItem(0).netId() == 5001);
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem item(final int count, final int netId) {
+        final var result = new BedrockItem(1);
+        result.setAmount(count);
+        result.setNetId(netId);
+        return result;
+    }
+
+    private static void check(final boolean value) {
+        org.junit.jupiter.api.Assertions.assertTrue(value);
+    }
+
+}
