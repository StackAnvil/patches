+                (short) InteractPacketPayload_Action.OpenInventory.getValue());
+        interact.write(BedrockTypes.UNSIGNED_VAR_LONG,
+                this.user().get(EntityTracker.class).getClientPlayer().runtimeId());
+        interact.write(BedrockTypes.OPTIONAL_POSITION_3F, null);
+        interact.sendToServer(BedrockProtocol.class);
+        this.requestInventoryRefresh();
+    }
