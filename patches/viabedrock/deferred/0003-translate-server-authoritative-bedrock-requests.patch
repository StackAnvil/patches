diff --git a/src/test/java/net/raphimc/viabedrock/api/model/container/ContainerTest.java b/src/test/java/net/raphimc/viabedrock/api/model/container/ContainerTest.java
new file mode 100644
index 000000000..be1b704b4
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/container/ContainerTest.java
@@ -0,0 +1,179 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.container.block.EnchantmentContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.api.model.container.player.OffhandContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+
+class ContainerTest {
+
+    @Test
+    void repeatedSnapshotRetainsNetworkIdsWithoutRepeatedSlotEvents() {
+        final SnapshotContainer container = new SnapshotContainer();
+        final BedrockItem held = new BedrockItem(258);
+        held.setAmount(32);
+        held.setNetId(85);
+        container.setItems(new BedrockItem[]{held, BedrockItem.empty()});
+        container.changedSlots.clear();
+
+        final BedrockItem repeated = held.copy();
+        container.setItems(new BedrockItem[]{repeated, BedrockItem.empty()});
+        assertEquals(List.of(), container.changedSlots);
+        assertSame(repeated, container.getItem(0));
+
+        final BedrockItem consumed = repeated.copy();
+        consumed.setAmount(31);
+        consumed.setNetId(86);
+        container.setItems(new BedrockItem[]{consumed, BedrockItem.empty()});
+        assertEquals(List.of(0), container.changedSlots);
+        assertEquals(31, container.getItem(0).amount());
+        assertEquals(86, container.getItem(0).netId());
+
+        container.changedSlots.clear();
+        final BedrockItem renewedId = consumed.copy();
+        renewedId.setNetId(87);
+        container.setItems(new BedrockItem[]{renewedId, BedrockItem.empty()});
+        assertEquals(List.of(0), container.changedSlots);
+        assertEquals(87, container.getItem(0).netId());
+    }
+
+    @Test
+    void snapshotCallbacksObserveTheCompleteReplacement() {
+        final SnapshotContainer container = new SnapshotContainer();
+        final BedrockItem first = new BedrockItem(1);
+        final BedrockItem second = new BedrockItem(2);
+        final BedrockItem[] incoming = {first, second};
+        container.setItems(incoming);
+        assertEquals(List.of(0, 1), container.changedSlots);
+        for (BedrockItem[] observed : container.observedSnapshots) {
+            assertSame(first, observed[0]);
+            assertSame(second, observed[1]);
+        }
+        incoming[0] = BedrockItem.empty();
+        assertSame(first, container.getItem(0));
+    }
+
+    @Test
+    void offhandSwapPreservesBothNetworkIdsAndUsesEquipmentSlot() {
+        final InventoryContainer inventory = new InventoryContainer(null);
+        final OffhandContainer offhand = new OffhandContainer(null);
+        final BedrockItem shield = new BedrockItem(1);
+        shield.setNetId(19);
+        final BedrockItem totem = new BedrockItem(2);
+        totem.setNetId(23);
+
+        final ItemStackRequestAction.SwapAction swap = assertInstanceOf(
+                ItemStackRequestAction.SwapAction.class,
+                Container.swapAction(inventory, 8, shield, offhand, 0, totem));
+        assertEquals(ContainerEnumName.OffhandContainer, swap.source().container().name());
+        assertEquals(1, swap.source().slot());
+        assertEquals(23, swap.source().stackNetworkId());
+        assertEquals(ContainerEnumName.CombinedHotbarAndInventoryContainer, swap.destination().container().name());
+        assertEquals(8, swap.destination().slot());
+        assertEquals(19, swap.destination().stackNetworkId());
+
+        final ItemStackRequestAction.PlaceAction equip = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class,
+                Container.swapAction(inventory, 8, shield, offhand, 0, BedrockItem.empty()));
+        assertEquals(8, equip.source().slot());
+        assertEquals(19, equip.source().stackNetworkId());
+        assertEquals(1, equip.destination().slot());
+        assertEquals(0, equip.destination().stackNetworkId());
+
+        final ItemStackRequestAction.PlaceAction remove = assertInstanceOf(
+                ItemStackRequestAction.PlaceAction.class,
+                Container.swapAction(inventory, 8, BedrockItem.empty(), offhand, 0, totem));
+        assertEquals(1, remove.source().slot());
+        assertEquals(23, remove.source().stackNetworkId());
+        assertEquals(8, remove.destination().slot());
+        assertEquals(0, remove.destination().stackNetworkId());
+    }
+
+    @Test
+    void leftDragLeavesRemainderOnCursorWhileRightDragPlacesOnePerSlot() {
+        assertEquals(2, Container.quickCraftAmount(5, 2, 0));
+        assertEquals(1, Container.quickCraftAmount(5, 2, 1));
+        assertEquals(0, Container.quickCraftAmount(2, 3, 0));
+        assertEquals(0, Container.quickCraftAmount(0, 3, 1));
+    }
+
+    @Test
+    void pickupAllScansEachContainerSlotAfterTheClickedStackIsRemoved() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final Container chest = new Container(user, (byte) 2, ContainerType.CONTAINER,
+                null, null, 27) {
+            @Override
+            public FullContainerName getFullContainerName(final int slot) {
+                return new FullContainerName(ContainerEnumName.LevelEntityContainer, null);
+            }
+        };
+
+        assertSame(chest, chest.resolveJavaSlot(tracker, (short) 1).container());
+        assertEquals(1, chest.resolveJavaSlot(tracker, (short) 1).bedrockSlot());
+        assertEquals(2, chest.resolveJavaSlot(tracker, (short) 2).bedrockSlot());
+
+        final EnchantmentContainer enchantment = new EnchantmentContainer(user, (byte) 3, null, null);
+        assertEquals(14, ((Container) enchantment).resolveJavaSlot(tracker, (short) 0).bedrockSlot());
+        assertEquals(15, ((Container) enchantment).resolveJavaSlot(tracker, (short) 1).bedrockSlot());
+    }
+
+    @Test
+    void inventoryCellsInSmallScreensUseInventorySlotsInsteadOfPlayerCraftingSlots() {
+        final InventoryTracker tracker = new InventoryTracker(null);
+        for (final int size : new int[]{2, 3}) {
+            final Container screen = new Container(null, (byte) 2, ContainerType.CONTAINER, null, null, size) { };
+            for (short cell = 0; cell < 36; cell++) {
+                final Container.SlotRef slot = screen.resolveJavaSlot(tracker, (short) (size + cell));
+                assertSame(tracker.getInventoryContainer(), slot.container());
+                assertEquals(cell < 27 ? cell + 9 : cell - 27, slot.bedrockSlot());
+            }
+        }
+        final InventoryContainer player = tracker.getInventoryContainer();
+        assertSame(tracker.getHudContainer(), ((Container) player).resolveJavaSlot(tracker, (short) 1).container());
+        assertSame(tracker.getArmorContainer(), ((Container) player).resolveJavaSlot(tracker, (short) 5).container());
+        assertSame(tracker.getOffhandContainer(), ((Container) player).resolveJavaSlot(tracker, (short) 45).container());
+    }
+
+    private static final class SnapshotContainer extends Container {
+        private final List<Integer> changedSlots = new ArrayList<>();
+        private final List<BedrockItem[]> observedSnapshots = new ArrayList<>();
+
+        private SnapshotContainer() {
+            super(null, (byte) 0, ContainerType.CONTAINER, null, null, 2);
+        }
+
+        @Override
+        protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem item) {
+            this.changedSlots.add(slot);
+            this.observedSnapshots.add(this.getItems());
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/container/HorseContainerTest.java b/src/test/java/net/raphimc/viabedrock/api/model/container/HorseContainerTest.java
