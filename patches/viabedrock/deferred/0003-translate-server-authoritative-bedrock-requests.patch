+/** Supplied construction boundary for tests that isolate packet layout. */
+public final class NetworkItemStackFixtures {
+
+    public static final NetworkItemStackContext CONTEXT = new NetworkItemStackContext() {
+        @Override
+        public BedrockItem createNetworkItem(final int identifier, final short metadata, final byte amount, final int runtimeId) {
+            final var item = new BedrockItem(identifier, metadata, amount);
+            if (runtimeId != 0) {
+                item.setBlockRuntimeId(runtimeId);
+            }
+            return item;
+        }
+
+        @Override
+        public ItemRecipeKey recipeKey(final BedrockItem item) {
+            return item != null && !item.isEmpty() ? new ItemRecipeKey(item.identifier() & 0xFFFF, item.data()) : null;
+        }
+    };
+
+    private NetworkItemStackFixtures() { }
+
+    public static BedrockItem decode(final Type<BedrockItem> codec, final int id, final int count,
+                                      final int auxiliary, final int runtimeId) {
+        return decode(codec, id, count, auxiliary, runtimeId, new byte[]{0, 0});
+    }
+
+    public static BedrockItem decode(final Type<BedrockItem> codec, final int id, final int count,
+                                      final int auxiliary, final int runtimeId, final byte[] userData) {
+        final var buffer = Unpooled.buffer();
+        try {
+            if (codec instanceof BedrockItemType) {
+                BedrockTypes.VAR_INT.write(buffer, id);
+            } else {
+                buffer.writeShortLE(id);
+            }
+            buffer.writeShortLE(count);
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, auxiliary);
+            if (codec instanceof BedrockItemType) {
+                BedrockTypes.VAR_INT.write(buffer, runtimeId);
+            } else {
+                buffer.writeBoolean(false);
+                BedrockTypes.UNSIGNED_VAR_INT.write(buffer, runtimeId);
+            }
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, userData.length);
+            buffer.writeBytes(userData);
+            final BedrockItem item = codec.read(buffer);
+            assertFalse(buffer.isReadable());
+            return item;
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
