+package net.raphimc.viabedrock.protocol.model.recipe;
+
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectMap;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+
+public enum ItemDescriptorType {
+
+    INVALID(0),
+    ITEM_NAME(1),
+    MOLANG(2),
+    ITEM_TAG(3);
+
+    private static final Int2ObjectMap<ItemDescriptorType> BY_VALUE = new Int2ObjectOpenHashMap<>();
+    private final int value;
+
+    static {
+        for (ItemDescriptorType value : values()) {
+            if (!BY_VALUE.containsKey(value.value)) {
+                BY_VALUE.put(value.value, value);
+            }
+        }
+    }
+
+    public static ItemDescriptorType getByValue(final int value) {
+        return BY_VALUE.get(value);
+    }
+
+    public static ItemDescriptorType getByValue(
+            final int value, final ItemDescriptorType fallback) {
+        return BY_VALUE.getOrDefault(value, fallback);
+    }
+
+    public static ItemDescriptorType getByName(final String name) {
+        for (ItemDescriptorType value : values()) {
+            if (value.name().equalsIgnoreCase(name)) {
+                return value;
+            }
+        }
+        return null;
+    }
+
+    public static ItemDescriptorType getByName(
+            final String name, final ItemDescriptorType fallback) {
+        for (ItemDescriptorType value : values()) {
+            if (value.name().equalsIgnoreCase(name)) {
+                return value;
+            }
+        }
+        return fallback;
+    }
+
+    ItemDescriptorType(final ItemDescriptorType value) {
+        this(value.value);
+    }
+
+    ItemDescriptorType(final int value) {
+        this.value = value;
+    }
+
+    public int getValue() {
+        return this.value;
+    }
