+
+import java.util.List;
+import java.lang.reflect.Proxy;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class EnchantmentContainerTest {
+
+    @Test
+    void enchantRequestPlacesTheResultBeforeConsumingLapis() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final EnchantmentContainer table = new EnchantmentContainer(user, (byte) 3, null, null);
+        final BedrockItem sword = new BedrockItem(1);
+        sword.setNetId(11);
+        final BedrockItem lapis = new BedrockItem(2, (short) 0, (byte) 3);
+        lapis.setNetId(12);
+        table.setItem(14, sword);
+        table.setItem(15, lapis);
+        final EnchantData option = new EnchantData(7,
+                List.of(new EnchantData.Enchantment(9, 1)), 42);
+
+        final List<ItemStackRequestAction> actions = table.requestActions(option, 2, true, -15);
+        assertEquals(5, actions.size());
+        assertInstanceOf(ItemStackRequestAction.CraftRecipeAction.class, actions.get(0));
+        final ItemStackRequestAction.CraftResultsDeprecatedAction results =
+                assertInstanceOf(ItemStackRequestAction.CraftResultsDeprecatedAction.class, actions.get(1));
+        assertEquals(0, results.resultItems().get(0).tag().getInt("Damage", -1));
+        assertNull(results.resultItems().get(0).netId());
+        final ItemStackRequestAction.ConsumeAction swordConsume =
+                assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, actions.get(2));
+        final ItemStackRequestAction.PlaceAction place =
+                assertInstanceOf(ItemStackRequestAction.PlaceAction.class, actions.get(3));
+        final ItemStackRequestAction.ConsumeAction lapisConsume =
+                assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, actions.get(4));
+        assertEquals(ContainerEnumName.EnchantingInputContainer, swordConsume.item().container().name());
+        assertEquals(11, swordConsume.item().stackNetworkId());
+        assertEquals(ContainerEnumName.CreatedOutputContainer, place.source().container().name());
+        assertEquals(50, place.source().slot());
+        assertEquals(-15, place.source().stackNetworkId());
+        assertEquals(ContainerEnumName.EnchantingInputContainer, place.destination().container().name());
+        assertEquals(-15, place.destination().stackNetworkId());
+        assertEquals(ContainerEnumName.EnchantingMaterialContainer, lapisConsume.item().container().name());
+        assertEquals(12, lapisConsume.item().stackNetworkId());
+        assertEquals(2, lapisConsume.count());
+        assertEquals(4, table.requestActions(option, 2, false, -15).size());
+    }
+
+    @Test
+    void survivalEnchantRequiresCurrentNetworkIdsAndEnoughLapis() {
+        final EnchantData option = new EnchantData(7, List.of(), 42);
+        final BedrockItem input = new BedrockItem(1);
+        final BedrockItem lapis = new BedrockItem(2, (short) 0, (byte) 2);
+        input.setNetId(11);
+        lapis.setNetId(12);
+
+        assertTrue(EnchantmentContainer.canEnchant(option, input, lapis, 2, true));
+        assertFalse(EnchantmentContainer.canEnchant(option, input, lapis, 3, true));
+        lapis.setNetId(null);
+        assertFalse(EnchantmentContainer.canEnchant(option, input, lapis, 1, true));
+        assertTrue(EnchantmentContainer.canEnchant(option, input, lapis, 1, false));
+        input.setNetId(null);
+        assertFalse(EnchantmentContainer.canEnchant(option, input, lapis, 1, false));
+    }
+
+    @Test
+    void resultItemKeepsInputDataAndEverySelectedEnchantment() {
+        final BedrockItem input = new BedrockItem(1);
+        final CompoundTag inputTag = new CompoundTag();
+        inputTag.putInt("Damage", 5);
+        input.setTag(inputTag);
+        input.setNetId(42);
+        final EnchantData option = new EnchantData(7, List.of(
+                new EnchantData.Enchantment(9, 2), new EnchantData.Enchantment(10, 1)), 77);
+
+        final BedrockItem result = EnchantmentContainer.resultItem(input, option);
+        final ListTag<CompoundTag> enchants = result.tag().getListTag("ench", CompoundTag.class);
+
+        assertEquals(5, result.tag().getInt("Damage", -1));
+        assertEquals(2, enchants.size());
+        assertEquals(9, enchants.get(0).getShortTag("id").asInt());
+        assertEquals(2, enchants.get(0).getShortTag("lvl").asInt());
+        assertEquals(10, enchants.get(1).getShortTag("id").asInt());
+        assertEquals(1, enchants.get(1).getShortTag("lvl").asInt());
+        assertNull(result.netId());
+        assertNull(input.tag().get("ench"));
+        assertEquals(42, input.netId());
+
+        final BedrockItem pristine = new BedrockItem(1);
+        final BedrockItem pristineResult = EnchantmentContainer.resultItem(pristine, option);
+        assertEquals(0, pristineResult.tag().getInt("Damage", -1));
+        assertNull(pristine.tag());
+    }
+
+}
