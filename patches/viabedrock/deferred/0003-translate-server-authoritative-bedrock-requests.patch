+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+
+final class NativeContainerActionSessionTest {
+
+    @org.junit.jupiter.api.Test
+    void rejectsStaleActionsAndRestoresPredictionWhenTransportFails() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user =
+                (UserConnection)
+                        Proxy.newProxyInstance(
+                                UserConnection.class.getClassLoader(),
+                                new Class<?>[] {UserConnection.class},
+                                (proxy, method, values) ->
+                                        method.getName().equals("get")
+                                                ? storage.get(values[0])
+                                                : null);
+        final var inventory = new InventoryTracker(user);
+        final var requests = new InventoryRequestTracker(user);
+        // Only this stored Java StartGame boolean is needed; native/world initialization is not
+        // claimed.
+        final var game = org.mockito.Mockito.mock(GameSessionStorage.class);
+        org.mockito.Mockito.when(game.isInventoryServerAuthoritative()).thenReturn(true);
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        storage.put(GameSessionStorage.class, game);
+        final var menu = new ChestContainer(user, (byte) 6, null, null, 27);
+        inventory.setCurrentContainer(menu);
+        requests.setPredictingClick(true);
+        menu.setItem(9, item(4, 1008));
+        inventory.getHudContainer().setItem(0, item(4, 5001));
+        requests.setPredictingClick(false);
+        final var session =
+                new NativeContainerActionSession(
+                        new NativeContainerAutoPlacement.Binding(
+                                menu, inventory.currentContainerGeneration(), 8),
+                        6,
+                        () -> Set.of(9));
+        final var sent = new AtomicInteger();
+        final Consumer<
+                        ItemStackRequestInfo>
+                sender =
+                        request -> {
+                            sent.incrementAndGet();
+                            requests.getRequest(request.requestId()).capturePrediction(inventory);
+                        };
+        check(!session.autoPlaceOne(user, 7, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        check(!session.autoPlaceOne(user, 6, 9, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        check(!session.autoPlaceOne(user, 6, 8, 0, 26, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        org.mockito.Mockito.when(game.isInventoryServerAuthoritative()).thenReturn(false);
+        check(!session.autoPlaceOne(user, 6, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        org.mockito.Mockito.when(game.isInventoryServerAuthoritative()).thenReturn(true);
+        for (final Integer networkId : java.util.Arrays.asList(null, 0, -3)) {
+            final var unresolved = item(4, 1008);
+            unresolved.setNetId(networkId);
+            requests.setPredictingClick(true);
+            menu.setItem(9, unresolved);
+            requests.setPredictingClick(false);
+            check(!session.autoPlaceOne(user, 6, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+            check(sent.get() == 0 && !requests.hasPending() && !requests.isPredictingClick());
+            check(menu.getItem(9).amount() == 4 && inventory.getInventoryContainer().getItem(0).isEmpty());
+        }
+        requests.setPredictingClick(true);
+        menu.setItem(9, item(4, 1008));
+        requests.setPredictingClick(false);
+        check(session.autoPlaceOne(user, 6, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        check(
+                menu.getItem(9).amount() == 3
+                        && inventory.getInventoryContainer().getItem(0).amount() == 1
+                        && inventory.getHudContainer().getItem(0).amount() == 4
+                        && sent.get() == 1);
+        check(!session.autoPlaceOne(user, 6, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        requests.removeRequest(-3);
+        try {
+            session.autoPlaceOne(
+                    user,
+                    6,
+                    8,
+                    0,
+                    9,
+                    item -> 64, NativeContainerActionSessionTest::matches,
+                    request -> {
+                        throw new IllegalStateException("Transport failed");
+                    });
+            throw new AssertionError();
+        } catch (final IllegalStateException expected) {
+            check(
+                    menu.getItem(9).amount() == 3
+                            && inventory.getInventoryContainer().getItem(0).amount() == 1
+                            && !requests.hasPending()
+                            && !requests.isPredictingClick());
+        }
+        inventory.setCurrentContainerClosed(false);
+        inventory.setCurrentContainer(new ChestContainer(user, (byte) 6, null, null, 27));
+        check(!session.autoPlaceOne(user, 6, 8, 0, 9, item -> 64, NativeContainerActionSessionTest::matches, sender));
+        check(sent.get() == 1 && inventory.getHudContainer().getItem(0).netId() == 5001);
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem item(final int count, final int netId) {
+        final var item = new BedrockItem(1);
+        item.setAmount(count);
+        item.setNetId(netId);
+        return item;
+    }
+
+    private static void check(final boolean value) {
+        org.junit.jupiter.api.Assertions.assertTrue(value);
+    }
+
+}
