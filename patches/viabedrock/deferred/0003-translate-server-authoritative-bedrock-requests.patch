+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ItemDefinitionsTest {
+
+    @Test
+    void readsPinnedSpearAndLegacyIconShapes() {
+        assertEquals("stone_spear", ItemDefinitions.icon(JsonParser.parseString(
+                "{\"textures\":{\"default\":\"stone_spear\"}}")));
+        assertEquals("stone_spear", ItemDefinitions.icon(JsonParser.parseString("\"stone_spear\"")));
+        assertEquals("stone_spear", ItemDefinitions.icon(JsonParser.parseString("{\"texture\":\"stone_spear\"}")));
+        assertNull(ItemDefinitions.icon(JsonParser.parseString("{}")));
+        assertEquals("item.stone_spear.name", ItemDefinitions.stringValue(JsonParser.parseString(
+                "{\"value\":\"item.stone_spear.name\"}")));
+    }
+
+    @Test
+    void readsGeyserNetworkIcon() {
+        final ResourcePackStorage packs = mock(ResourcePackStorage.class);
+        when(packs.getPackStackBottomToTop()).thenReturn(List.of());
+        final ItemDefinitions definitions = new ItemDefinitions(packs);
+        final CompoundTag properties = new CompoundTag();
+        final CompoundTag textures = new CompoundTag();
+        textures.putString("default", "minecart_furnace");
+        final CompoundTag icon = new CompoundTag();
+        icon.put("textures", textures);
+        properties.put("minecraft:icon", icon);
+        final CompoundTag components = new CompoundTag();
+        components.put("item_properties", properties);
+        final CompoundTag data = new CompoundTag();
+        data.put("components", components);
+        definitions.addFromNetworkTag("geysermc:furnace_minecart", data);
+        assertEquals("minecart_furnace", definitions.get("geysermc:furnace_minecart").iconComponent());
+    }
+
+    @Test
+    void emptyPackDisplayNameOverridesLowerPackWithoutHidingOrdinaryName() {
+        final String identifier = "custom:probe";
+        final ResourcePackStorage packs = mock(ResourcePackStorage.class);
+        for (final boolean objectForm : List.of(false, true)) {
+            for (final String value : List.of("", " ", identifier)) {
+                final ResourcePack lower = itemPack(identifier, identifier, false);
+                final ResourcePack upper = itemPack(identifier, value, objectForm);
+                when(packs.getPackStackBottomToTop()).thenReturn(List.of(lower, upper));
+                final var definition = new ItemDefinitions(packs).get(identifier);
+                assertEquals(value.isEmpty() ? null : value, definition.displayNameComponent());
+            }
+        }
+    }
+
+    private static ResourcePack itemPack(final String identifier, final String name, final boolean objectForm) {
+        final var content = new InMemoryContent();
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        final JsonObject components = new JsonObject();
+        if (objectForm) {
+            final JsonObject value = new JsonObject();
+            value.addProperty("value", name);
+            components.add("minecraft:display_name", value);
+        } else {
+            components.addProperty("minecraft:display_name", name);
+        }
+        final JsonObject item = new JsonObject();
+        item.add("description", description);
+        item.add("components", components);
+        final JsonObject file = new JsonObject();
+        file.add("minecraft:item", item);
+        content.putJson("items/probe.json", file);
+        final ResourcePack pack = mock(ResourcePack.class);
+        when(pack.content()).thenReturn(content);
+        return pack;
+    }
+
+}
