+
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ContainerContentPacketTest {
+
+    @Test
+    void playerContentsStartAfterJavaMountSlotsRatherThanNativeCapacity() throws ClassNotFoundException {
+        // Initialize components before versioned types, as ViaVersion does during platform bootstrap.
+        Class.forName(StructuredDataKey.class.getName());
+        for (final int javaSize : new int[]{2, 17}) {
+            final Map<Class<?>, Object> storage = new HashMap<>();
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                    UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                    (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+            final Item[] playerItems = new Item[46];
+            for (int slot = 9; slot < 45; slot++) {
+                playerItems[slot] = new StructuredItem(slot, 1, new StructuredDataContainer());
+            }
+            final InventoryTracker tracker = new InventoryTracker(user) {
+                private final InventoryContainer inventory = new InventoryContainer(user) {
+                    @Override
+                    public Item[] getJavaItems() {
+                        return playerItems;
+                    }
+                };
+                private final HudContainer hud = new HudContainer(user) {
+                    @Override
+                    public Item getJavaItem(final int slot) {
+                        return null;
+                    }
+                };
+                @Override
+                public InventoryContainer getInventoryContainer() {
+                    return this.inventory;
+                }
+
+                @Override
+                public HudContainer getHudContainer() {
+                    return this.hud;
+                }
+            };
+            storage.put(InventoryTracker.class, tracker);
+            final Item lastCargo = new StructuredItem(81, 4, new StructuredDataContainer());
+            final Item[] mountItems = new Item[javaSize];
+            mountItems[javaSize - 1] = lastCargo;
+            final Container mount = new Container(user, (byte) 8, ContainerType.HORSE, null, null, 16) {
+                @Override
+                public int javaSize() {
+                    return javaSize;
+                }
+
+                @Override
+                public Item[] getJavaItems() {
+                    return mountItems;
+                }
+            };
+            tracker.setCurrentContainer(mount);
+            final PacketWrapper packet = new PacketWrapperImpl(0, Unpooled.buffer(), user);
+            PacketFactory.writeJavaContainerSetContent(packet, mount);
+            final Item[] contents = packet.get(VersionedTypes.V26_3.itemArray, 0);
+            assertEquals(javaSize + 36, contents.length);
+            assertSame(lastCargo, contents[javaSize - 1]);
+            for (int cell = 0; cell < 36; cell++) {
+                assertSame(playerItems[cell + 9], contents[javaSize + cell]);
+            }
+        }
+    }
+
+}
