+    void eitherOpeningOrderRetainsOneContainerAndDoesNotLoseItsContents() throws Exception {
+        for (final boolean equipmentFirst : new boolean[]{false, true}) {
+            final Fixture fixture = new Fixture();
+            final ByteBuf first = equipmentFirst ? fixture.equipment(16) : fixture.open();
+            final ByteBuf second = equipmentFirst ? fixture.open() : fixture.equipment(16);
+            try {
+                final PacketWrapper firstPacket = fixture.translate(equipmentFirst
+                        ? ClientboundBedrockPackets.UPDATE_EQUIP : ClientboundBedrockPackets.CONTAINER_OPEN, first);
+                assertFalse(firstPacket.isCancelled());
+                final var container = fixture.inventory.getCurrentContainer();
+                final var item = new BedrockItem(1);
+                item.setNetId(51);
+                container.setItem(15, item);
+                final PacketWrapper secondPacket = fixture.translate(equipmentFirst
+                        ? ClientboundBedrockPackets.CONTAINER_OPEN : ClientboundBedrockPackets.UPDATE_EQUIP, second);
+                assertTrue(secondPacket.isCancelled());
+                assertSame(container, fixture.inventory.getCurrentContainer());
+                assertEquals(51, container.getItem(15).netId());
+                assertEquals(0, first.readableBytes());
+                assertEquals(0, second.readableBytes());
+            } finally {
+                first.release();
+                second.release();
+            }
+        }
+    }
+
+    private static final class Fixture {
+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? this.storage.get(args[0]) : null);
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final Entity mule = new Entity(this.user, 33, 45, "minecraft:mule", 47, new UUID(0, 1), null);
+        private final TestProtocol protocol = new TestProtocol();
+
+        private Fixture() {
+            this.mule.entityData().put(ActorDataIds.CONTAINER_SIZE,
+                    new EntityData(45, EntityDataTypesBedrock.INT, 16));
+            this.mule.entityData().put(ActorDataIds.RESERVED_0,
+                    new EntityData(0, EntityDataTypesBedrock.LONG, 1L << ActorFlags.CHESTED.getValue()));
+            this.storage.put(InventoryTracker.class, this.inventory);
+            this.storage.put(EntityTracker.class, new EntityTracker(this.user) {
+                @Override
+                public Entity getEntityByUid(final long uniqueId) {
+                    return uniqueId == Fixture.this.mule.uniqueId() ? Fixture.this.mule : null;
+                }
+            });
+        }
+
+        private ByteBuf equipment(final int size) {
+            final ByteBuf input = Unpooled.buffer();
+            input.writeByte(8);
+            input.writeByte(ContainerType.HORSE.getValue());
+            BedrockTypes.VAR_INT.write(input, size);
+            BedrockTypes.VAR_LONG.write(input, this.mule.uniqueId());
+            BedrockTypes.NETWORK_TAG.write(input, new CompoundTag());
+            return input;
+        }
+
+        private ByteBuf open() {
+            final ByteBuf input = Unpooled.buffer();
+            input.writeByte(8);
+            input.writeByte(ContainerType.HORSE.getValue());
+            BedrockTypes.BLOCK_POSITION.write(input, new BlockPosition(0, 64, 0));
+            BedrockTypes.VAR_LONG.write(input, this.mule.uniqueId());
+            return input;
+        }
+
+        private PacketWrapper translate(final ClientboundBedrockPackets type, final ByteBuf input) throws Exception {
+            final PacketWrapper packet = new PacketWrapperImpl(type, input, this.user);
+            this.protocol.translate(packet);
+            return packet;
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            InventoryPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
