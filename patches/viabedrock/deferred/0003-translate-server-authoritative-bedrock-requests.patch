+
+final class NativeContainerAutoPlacementTest {
+
+    @org.junit.jupiter.api.Test
+    void retainsLockedMenuItemsAndTheirNetworkIdentitiesDuringOneItemPlacement() {
+        final var source = new ChestContainer(null, (byte) 6, null, null, 27);
+        final var inventory = new Player();
+        final var binding = new NativeContainerAutoPlacement.Binding(source, 7, 8);
+        for (final int mode : new int[]{1, 2, 127, 128, 255}) {
+            final var tag = new CompoundTag();
+            tag.putByte("minecraft:item_lock", (byte) mode);
+            final var from = item(4, 1008);
+            from.setTag(tag);
+            final var to = item(3, 2012);
+            to.setTag(tag.copy());
+            source.items[0] = from;
+            inventory.put(0, to);
+            final var plan = NativeContainerAutoPlacement.plan(binding, source, 7, 8, 0, inventory, 64,
+                    NativeContainerAutoPlacementTest::matches);
+            org.junit.jupiter.api.Assertions.assertEquals(source.requestSlotInfo(0, 1008), plan.action().source());
+            org.junit.jupiter.api.Assertions.assertEquals(inventory.requestSlotInfo(0, 2012), plan.action().destination());
+            org.junit.jupiter.api.Assertions.assertEquals(3, plan.transfer().sourceAfter().amount());
+            org.junit.jupiter.api.Assertions.assertEquals(4, plan.transfer().destinationAfter().amount());
+            org.junit.jupiter.api.Assertions.assertEquals(mode, plan.transfer().sourceAfter().itemLockMode());
+            org.junit.jupiter.api.Assertions.assertEquals(mode, plan.transfer().destinationAfter().itemLockMode());
+            org.junit.jupiter.api.Assertions.assertEquals(4, from.amount());
+            org.junit.jupiter.api.Assertions.assertEquals(3, to.amount());
+        }
+    }
+
+    @org.junit.jupiter.api.Test
+    void plansOneItemFromRealProvidersWithoutTouchingTheCursor() {
+        final var source = new ChestContainer(null, (byte) 6, null, null, 27);
+        final var inventory = new Player();
+        final var binding = new NativeContainerAutoPlacement.Binding(source, 7, 8);
+        source.items[9] = item(4, 1008);
+        inventory.put(1, item(63, 2012));
+        final var cursor = item(4, 5001);
+        final var plan = NativeContainerAutoPlacement.plan(binding, source, 7, 8, 9, inventory, 64, NativeContainerAutoPlacementTest::matches);
+        check(plan.transfer().destinationSlot() == 1 && plan.action().count() == 1);
+        check(
+                plan.action().source().stackNetworkId() == 1008
+                        && plan.action().destination().stackNetworkId() == 2012);
+        check(
+                plan.action().destination().container().name()
+                        == ContainerEnumName.CombinedHotbarAndInventoryContainer);
+        check(plan.transfer().sourceAfter().amount() == 3 && plan.transfer().destinationAfter().amount() == 64);
+        check(
+                source.getItem(9).amount() == 4
+                        && inventory.getItem(1).amount() == 63
+                        && cursor.amount() == 4);
+        inventory.put(1, item(64, 2012));
+        final var emptyPlan =
+                NativeContainerAutoPlacement.plan(binding, source, 7, 8, 9, inventory, 64, NativeContainerAutoPlacementTest::matches);
+        check(
+                emptyPlan.transfer().destinationSlot() == 0
+                        && emptyPlan.action().destination().stackNetworkId() == 0);
+        inventory.forbid(0);
+        check(
+                NativeContainerAutoPlacement.plan(binding, source, 7, 8, 9, inventory, 64, NativeContainerAutoPlacementTest::matches)
+                                .transfer().destinationSlot()
+                        == 2);
+        Arrays.fill(inventory.items, item(64, 2012));
+        check(NativeContainerAutoPlacement.plan(binding, source, 7, 8, 9, inventory, 64, NativeContainerAutoPlacementTest::matches) == null);
+        reject(
+                () ->
+                        NativeContainerAutoPlacement.plan(
+                                binding,
+                                new ChestContainer(null, (byte) 6, null, null, 27),
+                                7,
+                                8,
+                                9,
+                                inventory,
+                                64, NativeContainerAutoPlacementTest::matches));
+        reject(() -> NativeContainerAutoPlacement.plan(binding, source, 8, 8, 9, inventory, 64, NativeContainerAutoPlacementTest::matches));
+        reject(() -> NativeContainerAutoPlacement.plan(binding, source, 7, 9, 9, inventory, 64, NativeContainerAutoPlacementTest::matches));
+        reject(() -> NativeContainerAutoPlacement.plan(binding, source, 7, 8, 27, inventory, 64, NativeContainerAutoPlacementTest::matches));
+    }
+
+    @org.junit.jupiter.api.Test
+    void transfersUseTheActualStorageProviderAndRejectWorkstationProviders() {
+        final var sources = java.util.List.of(
+                new ChestContainer(null, (byte) 6, null, null, 27),
+                new ChestContainer(null, (byte) 6,
+                        ContainerType.CHEST_BOAT, null, null, 27),
+                new ChestContainer(null, (byte) 6,
+                        ContainerType.MINECART_CHEST, null, null, 27),
+                new HopperContainer(null, (byte) 6, null, null),
+                new HopperContainer(null, (byte) 6, ContainerType.MINECART_HOPPER, null, null),
+                new HopperContainer(null, (byte) 6, ContainerType.CONTAINER, null, null),
+                new Generic3x3Container(null, (byte) 6,
+                        ContainerType.DISPENSER, null, null),
+                new Generic3x3Container(null, (byte) 6,
+                        ContainerType.DROPPER, null, null));
+        for (final Container source : sources) {
+            source.items[0] = item(4, 1008);
+            final var inventory = new Player();
+            final var binding = new NativeContainerAutoPlacement.Binding(source, 7, 8);
+            final var plan = NativeContainerAutoPlacement.plan(binding, source, 7, 8, 0, inventory, 64, NativeContainerAutoPlacementTest::matches);
+            org.junit.jupiter.api.Assertions.assertEquals(source.requestSlotInfo(0, 1008), plan.action().source());
+            check(plan.transfer().sourceAfter().amount() == 3 && plan.transfer().destinationAfter().amount() == 1);
+            check(source.getItem(0).amount() == 4 && inventory.getItem(0).isEmpty());
+            reject(() -> NativeContainerAutoPlacement.plan(binding, source, 7, 8, source.size(), inventory, 64, NativeContainerAutoPlacementTest::matches));
+        }
+        final var furnace = new FurnaceContainer(null, (byte) 6, null, null);
+        reject(() -> NativeContainerAutoPlacement.plan(new NativeContainerAutoPlacement.Binding(furnace, 7, 8),
+                furnace, 7, 8, 0, new Player(), 64, NativeContainerAutoPlacementTest::matches));
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem item(final int count, final int networkId) {
+        final var item = new BedrockItem(1);
+        item.setAmount(count);
+        item.setNetId(networkId);
+        return item;
+    }
+
+    @org.junit.jupiter.api.Test
+    void refusesUnresolvedSourceIdentitiesAndSkipsUnresolvedMergeDestinations() {
+        final var source = new ChestContainer(null, (byte) 6, null, null, 27);
+        final var inventory = new Player();
+        final var binding = new NativeContainerAutoPlacement.Binding(source, 7, 8);
+        for (final Integer networkId : Arrays.asList(null, 0, -3, Integer.MIN_VALUE)) {
+            final var unresolved = item(4, 1);
+            unresolved.setNetId(networkId);
+            source.items[0] = unresolved;
+            org.junit.jupiter.api.Assertions.assertNull(
+                    NativeContainerAutoPlacement.plan(binding, source, 7, 8, 0, inventory, 64, NativeContainerAutoPlacementTest::matches));
+            check(source.getItem(0).amount() == 4 && inventory.getItem(0).isEmpty());
+            source.items[0] = item(4, 1008);
+            inventory.put(0, unresolved);
+            final var plan = NativeContainerAutoPlacement.plan(binding, source, 7, 8, 0, inventory, 64, NativeContainerAutoPlacementTest::matches);
+            check(plan.transfer().destinationSlot() == 1 && plan.action().destination().stackNetworkId() == 0);
+            check(inventory.getItem(0).amount() == 4 && inventory.getItem(1).isEmpty());
+            inventory.put(0, BedrockItem.empty());
+        }
+        source.items[0] = item(255, Integer.MAX_VALUE);
+        inventory.put(0, item(254, Integer.MAX_VALUE - 1));
+        final var plan = NativeContainerAutoPlacement.plan(binding, source, 7, 8, 0, inventory, 255, NativeContainerAutoPlacementTest::matches);
+        check(plan.action().count() == 1 && plan.transfer().sourceAfter().amount() == 254 && plan.transfer().destinationAfter().amount() == 255);
+        check(source.getItem(0).amount() == 255 && inventory.getItem(0).amount() == 254);
+    }
+
+    private static void check(final boolean condition) {
+        org.junit.jupiter.api.Assertions.assertTrue(condition);
+    }
+
+    private static void reject(final Runnable action) {
+        try {
+            action.run();
+        } catch (final IllegalArgumentException expected) {
+            return;
+        }
+        throw new AssertionError("Stale or invalid action accepted");
+    }
+
+    private static final class Player extends InventoryContainer {
+
+        private int forbidden = -1;
+
+        Player() {
+            super(null);
+        }
+
+        void put(final int slot, final BedrockItem item) {
+            this.items[slot] = item;
+        }
+
+        void forbid(final int slot) {
+            this.forbidden = slot;
+        }
+
+        @Override
+        public boolean canPlaceItem(final int slot, final BedrockItem item, final int amount) {
+            return slot != this.forbidden;
+        }
+    }
+
+}
