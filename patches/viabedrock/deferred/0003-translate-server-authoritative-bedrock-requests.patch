+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.HolderSet;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.*;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class CraftingDataTracker extends StoredObject {
+
+    private List<CraftingDataStorage> recipes = List.of();
+
+    public CraftingDataTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public List<CraftingDataStorage> getCraftingDataList() {
+        return this.recipes;
+    }
+
+    public void updateCraftingDataList(final List<CraftingDataStorage> recipes, final boolean clear) {
+        if (clear) {
+            this.recipes = List.copyOf(recipes);
+        } else {
+            final List<CraftingDataStorage> combined = new ArrayList<>(this.recipes);
+            combined.addAll(recipes);
+            this.recipes = List.copyOf(combined);
+        }
+    }
+
+    public CraftingDataStorage getRecipeData(final Container container, final String tag) {
+        for (final CraftingDataStorage data : this.recipes) {
+            if (!data.recipe().getRecipeTag().equals(tag)) {
+                continue;
+            }
+            final boolean matches =
+                switch (data.type()) {
+                    case SHAPELESS, USER_DATA_SHAPELESS ->
+                        this.matchesShapeless(container, (ShapelessRecipe) data.recipe());
+                    case SHAPED -> this.matchesShaped(container, (ShapedRecipe) data.recipe());
+                    case SMITHING_TRIM, SMITHING_TRANSFORM ->
+                        this.matchesSmithing(container, (SmithingRecipe) data.recipe());
+                    default -> false;
+                };
+            if (matches) {
+                return data;
+            }
+        }
+        return null;
+    }
+
+    private boolean matchesSmithing(final Container container, final SmithingRecipe recipe) {
+        return this.matches(recipe.getTemplate(), container.getItem(53))
+                && this.matches(recipe.getBaseIngredient(), container.getItem(51))
+                && this.matches(recipe.getAdditionIngredient(), container.getItem(52));
+    }
+
+    private boolean matchesShapeless(final Container container, final ShapelessRecipe recipe) {
+        if (recipe.getIngredients().size() > 9) {
+            return false;
+        }
+        final boolean[] used = new boolean[9];
+        for (final ItemDescriptor ingredient : recipe.getIngredients()) {
+            boolean found = false;
+            for (int slot = 0; slot < 9; slot++) {
+                if (!used[slot] && this.matches(ingredient, this.input(container, slot))) {
+                    used[slot] = true;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                return false;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (!used[slot] && !this.input(container, slot).isEmpty()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private boolean matchesShaped(final Container container, final ShapedRecipe recipe) {
+        final ItemDescriptor[][] pattern = recipe.getPattern();
+        final int height = pattern.length;
+        final int width = pattern[0].length;
+        if (width > 3 || height > 3) {
+            return false;
+        }
+        for (int startY = 0; startY <= 3 - height; startY++) {
+            for (int startX = 0; startX <= 3 - width; startX++) {
+                if (this.matchesPattern(container, pattern, startX, startY, false)) {
+                    return true;
+                }
+                if (recipe.isMirrored() && this.matchesPattern(container, pattern, startX, startY, true)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private boolean matchesPattern(
+            final Container container,
+            final ItemDescriptor[][] pattern,
+            final int startX,
+            final int startY,
+            final boolean mirror) {
+        for (int y = 0; y < 3; y++) {
+            for (int x = 0; x < 3; x++) {
+                final int py = y - startY;
+                final int px = x - startX;
+                final BedrockItem item = this.input(container, y * 3 + x);
+                if (py < 0 || py >= pattern.length || px < 0 || px >= pattern[0].length) {
+                    if (!item.isEmpty()) {
+                        return false;
+                    }
+                } else {
+                    final int column = mirror ? pattern[0].length - 1 - px : px;
+                    if (!this.matches(pattern[py][column], item)) {
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    private BedrockItem input(final Container container, final int index) {
+        return container.getItem(container.bedrockSlot(index + 1));
+    }
+
+    private boolean matches(final ItemDescriptor descriptor, final BedrockItem item) {
+        return descriptor.matchesItem(this.user(), item)
+                && (item.isEmpty() || item.amount() >= descriptor.amount());
+    }
+
+    public void sendJavaUpdateRecipes(final UserConnection user) {
+        final ItemRewriter rewriter = user.get(ItemRewriter.class);
+        final List<StonecutterEntry> entries = new ArrayList<>();
+        for (final CraftingDataStorage data : this.recipes) {
+            if (!(data.recipe() instanceof ShapelessRecipe recipe)
+                    || !"stonecutter".equals(recipe.getRecipeTag())
+                    || recipe.getIngredients().size() != 1
+                    || recipe.getResults().isEmpty()) {
+                continue;
+            }
+            final ItemDescriptor descriptor = recipe.getIngredients().get(0);
+            if (!(descriptor instanceof ItemDescriptor.ItemNameDescriptor ingredient)) {
+                continue;
+            }
+            final Integer bedrockId = rewriter.getItems().get(ingredient.fullName());
+            if (bedrockId == null) {
+                continue;
+            }
+            final Item javaInput = rewriter.javaItem(new BedrockItem(bedrockId));
+            final Item javaOutput = rewriter.javaItem(recipe.getResults().get(0));
+            if (javaInput.isEmpty() || javaOutput.isEmpty()) {
+                continue;
+            }
+            entries.add(new StonecutterEntry(javaInput.identifier(), javaOutput));
+        }
+
+        final PacketWrapper packet =
+                PacketWrapper.create(ClientboundPackets26_3.UPDATE_RECIPES, user);
+        packet.write(Types.VAR_INT, 0); // property sets
+        packet.write(Types.VAR_INT, entries.size());
+        for (final StonecutterEntry entry : entries) {
+            writeStonecutterRecipe(packet, entry.inputId(),
+                    BedrockProtocol.MAPPINGS.getJavaSlotDisplayId("minecraft:item_stack"), entry.output());
+        }
+        packet.send(BedrockProtocol.class);
+    }
+
+    static void writeStonecutterRecipe(final PacketWrapper packet, final int inputId,
+            final int outputDisplayId, final Item output) {
+        packet.write(Types.HOLDER_SET, HolderSet.of(new int[]{inputId}));
+        packet.write(Types.VAR_INT, outputDisplayId);
+        packet.write(VersionedTypes.V26_3.itemTemplate, output);
+    }
+
+    private record StonecutterEntry(int inputId, Item output) { }
+
+}
