+    private List<ItemStackRequestAction> handleQuickMoveClick(
+            final ClickContext clickContext, final short javaSlot) {
+        final SlotRef source = this.resolveJavaSlot(clickContext.inventoryTracker, javaSlot);
+        if (source == null) {
+            return List.of();
+        }
+
+        BedrockItem sourceItem = source.container().getItem(source.bedrockSlot());
+        if (sourceItem.isEmpty()) {
+            return List.of();
+        }
+
+        final ItemRewriter itemRewriter = this.user.get(ItemRewriter.class);
+
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        final List<QuickMoveRange> ranges = this.quickMoveRanges(javaSlot, source);
+        for (boolean mergePass : new boolean[] {true, false}) {
+            for (QuickMoveRange range : ranges) {
+                final int start =
+                        range.backwards() ? range.endJavaSlot() - 1 : range.startJavaSlot();
+                final int end = range.backwards() ? range.startJavaSlot() - 1 : range.endJavaSlot();
+                final int step = range.backwards() ? -1 : 1;
+                for (int javaDestSlot = start;
+                        javaDestSlot != end && !sourceItem.isEmpty();
+                        javaDestSlot += step) {
+                    final int bedrockDestSlot = range.container().bedrockSlot(javaDestSlot);
+                    if (source.container() == range.container()
+                            && source.bedrockSlot() == bedrockDestSlot) {
+                        continue;
+                    }
+                    if (range.container().itemIndex(bedrockDestSlot) < 0
+                            || range.container().itemIndex(bedrockDestSlot) >= range.container().size()
+                            || !range.container().canPlaceItem(bedrockDestSlot, sourceItem)) {
+                        continue;
+                    }
+                    final BedrockItem destinationItem = range.container().getItem(bedrockDestSlot);
+                    final int slotMaxStackSize = itemRewriter.maxStackSize(sourceItem);
+                    if (mergePass) {
+                        if (destinationItem == null
+                                || destinationItem.isEmpty()
+                                || destinationItem.isDifferent(sourceItem)
+                                || destinationItem.amount() >= slotMaxStackSize) {
+                            continue;
+                        }
+                    } else if (destinationItem != null && !destinationItem.isEmpty()) {
+                        continue;
+                    }
+
+                    final int amountToMove =
+                            mergePass
+                                    ? Math.min(
+                                            sourceItem.amount(),
+                                            slotMaxStackSize - destinationItem.amount())
+                                    : Math.min(sourceItem.amount(), slotMaxStackSize);
+                    if (amountToMove <= 0) {
+                        continue;
+                    }
+
+                    final int destNetId =
+                            destinationItem != null && !destinationItem.isEmpty()
+                                    ? destinationItem.netId()
+                                    : 0;
+
+                    clickContext.snapshot(source.container());
+                    clickContext.snapshot(range.container());
+                    actions.add(
+                            new ItemStackRequestAction.PlaceAction(
+                                    amountToMove,
+                                    source.container().requestSlotInfo(source.bedrockSlot(), sourceItem.netId()),
+                                    range.container().requestSlotInfo(bedrockDestSlot, destNetId)));
+
+                    final BedrockItem newSourceItem =
+                            this.itemAfterRemovingAmount(sourceItem, amountToMove);
+                    source.container().setItem(source.bedrockSlot(), newSourceItem);
+                    if (destinationItem == null || destinationItem.isEmpty()) {
+                        final BedrockItem newDestinationItem = sourceItem.copy();
+                        newDestinationItem.setAmount(amountToMove);
+                        range.container().setItem(bedrockDestSlot, newDestinationItem);
+                    } else {
+                        final BedrockItem newDestinationItem = destinationItem.copy();
+                        newDestinationItem.setAmount(destinationItem.amount() + amountToMove);
+                        range.container().setItem(bedrockDestSlot, newDestinationItem);
+                    }
+                    sourceItem = newSourceItem;
+                }
+            }
+        }
+
+        return actions;
+    }
+
+    private ItemStackRequestAction handleThrowClick(
+            final ClickContext clickContext, final short javaSlot, final byte button) {
+        if (javaSlot == -999) {
+            return this.dropCursorItem(clickContext.inventoryTracker, button);
+        }
+
+        final SlotRef source = this.resolveJavaSlot(clickContext.inventoryTracker, javaSlot);
+        if (source == null) {
+            return null;
+        }
+        final Container container = source.container();
+        clickContext.snapshot(container);
+        final BedrockItem item = container.getItem(source.bedrockSlot());
+
+        if (item.isEmpty()) {
+            return null;
+        }
+
+        final int amountToDrop = button == 0 ? 1 : item.amount();
+
+        final BedrockItem finalContainerItem = this.itemAfterRemovingAmount(item, amountToDrop);
+        container.setItem(source.bedrockSlot(), finalContainerItem);
+
+        return new ItemStackRequestAction.DropAction(
+                amountToDrop,
+                container.requestSlotInfo(source.bedrockSlot(), item.netId()),
+                false);
+    }
+
+    private boolean handleQuickCraftPhase(final short javaSlot, final byte button) {
+        final int mode = button >> 2;
+        final int phase = button & 3;
+        if (mode != 0 && mode != 1) {
+            this.quickCraftState = null;
+            return false;
+        }
+        if (phase == 0) {
+            final BedrockItem cursor = this.user.get(InventoryTracker.class).getHudContainer().getItem(0);
+            this.quickCraftState = cursor.isEmpty() ? null : new QuickCraftState(mode);
+            return this.quickCraftState != null;
+        }
+        if (phase == 1 && this.quickCraftState != null && this.quickCraftState.mode == mode) {
+            if (javaSlot >= 0) {
+                this.quickCraftState.javaSlots.add(javaSlot);
+            }
+            return true;
+        }
+        return false;
+    }
+
+    private List<ItemStackRequestAction> handleQuickCraftClick(
+            final ClickContext clickContext, final byte button) {
+        final QuickCraftState state = this.quickCraftState;
+        this.quickCraftState = null;
+        if (state == null || (button & 3) != 2 || (button >> 2) != state.mode) {
+            return List.of();
+        }
+
+        final Container cursorContainer = clickContext.inventoryTracker.getHudContainer();
+        BedrockItem cursor = cursorContainer.getItem(0);
+        if (cursor.isEmpty() || cursor.netId() == null) {
+            return List.of();
+        }
+        final List<SlotRef> destinations = new ArrayList<>();
+        for (final short javaSlot : state.javaSlots) {
+            final SlotRef destination = this.resolveJavaSlot(clickContext.inventoryTracker, javaSlot);
+            if (destination != null && this.canDistributeTo(clickContext, destination, cursor)) {
+                destinations.add(destination);
+            }
+        }
+        if (destinations.isEmpty()) {
+            return List.of();
+        }
+
+        final int amountPerSlot = quickCraftAmount(cursor.amount(), destinations.size(), state.mode);
+        if (amountPerSlot == 0) {
+            return List.of();
+        }
+        final List<ItemStackRequestAction> actions = new ArrayList<>(destinations.size());
+        for (final SlotRef destination : destinations) {
+            final Container container = destination.container();
+            final int slot = destination.bedrockSlot();
+            final BedrockItem existing = container.getItem(slot);
+            final int capacity = this.user.get(ItemRewriter.class).maxStackSize(cursor)
+                    - existing.amount();
+            final int amount = Math.min(Math.min(amountPerSlot, capacity), cursor.amount());
+            if (amount <= 0) {
+                continue;
+            }
+
+            clickContext.snapshot(container);
+            actions.add(new ItemStackRequestAction.PlaceAction(
+                    amount,
+                    cursorContainer.requestSlotInfo(0, cursor.netId()),
+                    container.requestSlotInfo(slot, existing.isEmpty() ? 0 : existing.netId())));
+            final BedrockItem placed = existing.isEmpty() ? cursor.copy() : existing.copy();
+            placed.setAmount(existing.amount() + amount);
+            container.setItem(slot, placed);
+            cursor = this.itemAfterRemovingAmount(cursor, amount);
+            cursorContainer.setItem(0, cursor);
+            if (cursor.isEmpty()) {
+                break;
+            }
+        }
+        return actions;
+    }
+
+    private List<ItemStackRequestAction> handlePickupAllClick(
+            final ClickContext clickContext, final short javaSlot) {
+        final Container cursorContainer = clickContext.inventoryTracker.getHudContainer();
+        BedrockItem cursor = cursorContainer.getItem(0);
+        if (cursor.isEmpty() || cursor.netId() == null || javaSlot < 0) {
+            return List.of();
+        }
+
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        final int visibleSlots = this instanceof InventoryContainer ? 46 : this.javaSize() + 36;
+        for (int offset = 0; offset < visibleSlots; offset++) {
+            final short candidateSlot = (short) ((javaSlot + offset) % visibleSlots);
+            final SlotRef source = this.resolveJavaSlot(clickContext.inventoryTracker, candidateSlot);
+            if (source == null || !this.canCollectFrom(clickContext, source, cursor)) {
+                continue;
+            }
+            final Container container = source.container();
+            final int slot = source.bedrockSlot();
+            final BedrockItem item = container.getItem(slot);
+            if (item.netId() == null) {
+                continue;
+            }
+            final int amount = Math.min(item.amount(),
+                    this.user.get(ItemRewriter.class).maxStackSize(cursor) - cursor.amount());
+            if (amount <= 0) {
+                break;
+            }
+
+            clickContext.snapshot(container);
+            actions.add(new ItemStackRequestAction.TakeAction(
+                    amount,
+                    container.requestSlotInfo(slot, item.netId()),
+                    cursorContainer.requestSlotInfo(0, cursor.netId())));
+            container.setItem(slot, this.itemAfterRemovingAmount(item, amount));
+            final BedrockItem collected = cursor.copy();
+            collected.setAmount(cursor.amount() + amount);
+            cursorContainer.setItem(0, collected);
+            cursor = collected;
+        }
+        return actions;
+    }
+
+    private boolean canDistributeTo(
+            final ClickContext clickContext, final SlotRef destination, final BedrockItem cursor) {
+        final Container container = destination.container();
+        if (!this.isOrdinaryItemSlot(clickContext, destination)) {
+            return false;
+        }
+        final BedrockItem item = container.getItem(destination.bedrockSlot());
+        if (!item.isEmpty() && item.netId() == null) {
+            return false;
+        }
+        return container.canPlaceItem(destination.bedrockSlot(), cursor)
+                && (item.isEmpty() || !item.isDifferent(cursor))
+                && item.amount() < this.user.get(ItemRewriter.class).maxStackSize(cursor);
+    }
+
+    private boolean canCollectFrom(
+            final ClickContext clickContext, final SlotRef source, final BedrockItem cursor) {
+        if (!this.isOrdinaryItemSlot(clickContext, source)) {
+            return false;
+        }
+        final BedrockItem item = source.container().getItem(source.bedrockSlot());
+        return !item.isEmpty() && !item.isDifferent(cursor);
+    }
+
+    private boolean isOrdinaryItemSlot(
+            final ClickContext clickContext, final SlotRef slot) {
+        final Container container = slot.container();
+        if (container == clickContext.inventoryTracker.getArmorContainer()
+                || container == clickContext.inventoryTracker.getOffhandContainer()) {
+            return false;
+        }
+        try {
+            final String name = container.getFullContainerName(slot.bedrockSlot()).name().name();
+            return !name.contains("Output") && !name.contains("Result")
+                    && container.getFullContainerName(slot.bedrockSlot()).name()
+                            != ContainerEnumName.HorseEquipContainer;
+        } catch (final IllegalArgumentException exception) {
+            return false;
+        }
+    }
+
+    static int quickCraftAmount(final int cursorAmount, final int destinations, final int mode) {
+        if (cursorAmount <= 0 || destinations <= 0) {
+            return 0;
+        }
+        return mode == 1 ? 1 : cursorAmount / destinations;
+    }
+
+    private ItemStackRequestAction dropCursorItem(
+            final InventoryTracker inventoryTracker, final byte button) {
+        final BedrockItem cursorItem = inventoryTracker.getHudContainer().getItem(0);
+        if (cursorItem.isEmpty()) {
+            return null;
+        }
+
+        final int amountToDrop = button == 0 ? cursorItem.amount() : 1;
+        inventoryTracker
+                .getHudContainer()
+                .setItem(0, this.itemAfterRemovingAmount(cursorItem, amountToDrop));
+
+        return new ItemStackRequestAction.DropAction(
+                amountToDrop,
+                inventoryTracker.getHudContainer().requestSlotInfo(0, cursorItem.netId()),
+                false);
+    }
+
+    protected ItemStackRequestAction dropItem(
+            final Container container, final int bedrockSlot, final int amountToDrop) {
+        final BedrockItem item = container.getItem(bedrockSlot);
+        if (item.isEmpty()) {
+            return null;
+        }
+
+        final BedrockItem finalContainerItem = this.itemAfterRemovingAmount(item, amountToDrop);
+        container.setItem(bedrockSlot, finalContainerItem);
+
+        return new ItemStackRequestAction.DropAction(
+                amountToDrop,
+                container.requestSlotInfo(bedrockSlot, item.netId()),
+                false);
+    }
+
+    private List<ItemStackRequestAction> singletonAction(final ItemStackRequestAction action) {
+        return action == null ? List.of() : List.of(action);
+    }
