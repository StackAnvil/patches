+    public short translateContainerData(final int containerData) {
+        return switch (containerData) {
+            case 0 -> 2; // Progress arrow
+            case 1 -> 0; // Fuel progress
+            case 2 -> 1; // Max fuel progress
+            case 3 -> 3; // Max progress arrow
+            default -> -1; // Unknown
+        };
+    }
+
+}
