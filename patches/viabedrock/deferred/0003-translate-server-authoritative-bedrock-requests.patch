+            fixture.requests.drainQueuedInteractions();
+            assertEquals(0, applied.get());
+            assertEquals(4, fixture.menu.getItem(9).amount());
+        }
+    }
+
+    @Test
+    void omittedSlotsKeepNewerAuthoritativeContentsAndUnrelatedCells() {
+        try (var fixture = new Fixture()) {
+            fixture.requests.setPredictingClick(true);
+            fixture.menu.setItem(9, item(7, 3001));
+            fixture.menu.markServerUpdate();
+            fixture.inventory.getInventoryContainer().setItem(0, item(2, 3002));
+            fixture.inventory.getInventoryContainer().markServerUpdate();
+            fixture.requests.setPredictingClick(false);
+            fixture.respond(List.of(ack(ContainerEnumName.CursorContainer, 0, 0, 0)));
