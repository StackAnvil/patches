@@ -0,0 +1,174 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.protocol.types.recipe;
+
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.*;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.types.array.ArrayType;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.UUID;
+
+/** Reads the separate recipe arrays introduced by Bedrock protocol 2193. */
+public final class CraftingDataReader {
+
+    private static final Type<ItemDescriptor> INGREDIENT = new NetworkItemDescriptorType();
+    private static final Type<ItemDescriptor[]> INGREDIENTS =
+            new ArrayType<>(INGREDIENT, BedrockTypes.UNSIGNED_VAR_INT);
+
+    public static Data read(final PacketWrapper packet) {
+        final ItemRewriter items = packet.user().get(ItemRewriter.class);
+        final List<CraftingDataStorage> recipes = new ArrayList<>();
+        readShaped(packet, items, recipes, RecipeType.SHAPED);
+        readShapeless(packet, items, recipes, RecipeType.SHAPELESS);
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            packet.read(BedrockTypes.UUID);
+            packet.read(BedrockTypes.UNSIGNED_VAR_INT);
+        }
+        readShapeless(packet, items, recipes, RecipeType.USER_DATA_SHAPELESS);
+        readShapeless(packet, items, recipes, RecipeType.SHAPELESS_CHEMISTRY);
+        readShaped(packet, items, recipes, RecipeType.SHAPED_CHEMISTRY);
+        readSmithing(packet, items, recipes, true);
+        readSmithing(packet, items, recipes, false);
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            for (int field = 0; field < 6; field++) {
+                packet.read(BedrockTypes.VAR_INT);
+            }
+        }
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            for (int field = 0; field < 3; field++) {
+                packet.read(BedrockTypes.VAR_INT);
+            }
+        }
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            packet.read(BedrockTypes.VAR_INT);
+            for (int j = 0, outputs = packet.read(BedrockTypes.UNSIGNED_VAR_INT);
+                    j < outputs;
+                    j++) {
+                packet.read(BedrockTypes.VAR_INT);
+                packet.read(BedrockTypes.VAR_INT);
+            }
+        }
+        final boolean clearRecipes = packet.read(Types.BOOLEAN);
+        return new Data(recipes, clearRecipes);
+    }
+
+    private static void readShaped(
+            final PacketWrapper packet,
+            final ItemRewriter items,
+            final List<CraftingDataStorage> recipes,
+            final RecipeType type) {
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            final String id = packet.read(BedrockTypes.STRING);
+            final int width = packet.read(BedrockTypes.VAR_INT);
+            final int height = packet.read(BedrockTypes.VAR_INT);
+            final ItemDescriptor[] flat = packet.read(INGREDIENTS);
+            final List<BedrockItem> results = Arrays.asList(packet.read(items.itemArrayType()));
+            final UUID uuid = packet.read(BedrockTypes.UUID);
+            final String tag = packet.read(BedrockTypes.STRING);
+            final int priority = packet.read(BedrockTypes.VAR_INT);
+            final boolean symmetric = packet.read(Types.BOOLEAN);
+            readUnlocking(packet);
+            final int netId = packet.read(BedrockTypes.UNSIGNED_VAR_INT);
+            if (width <= 0
+                    || height <= 0
+                    || width > 3
+                    || height > 3
+                    || flat.length != width * height
+                    || results.isEmpty()) {
+                continue;
+            }
+            final ItemDescriptor[][] pattern = new ItemDescriptor[height][width];
+            for (int y = 0; y < height; y++) {
+                System.arraycopy(flat, y * width, pattern[y], 0, width);
+            }
+            recipes.add(
+                    new CraftingDataStorage(
+                            type,
+                            netId,
+                            new ShapedRecipe(
+                                    id, uuid, tag, priority, pattern, results, symmetric)));
+        }
+    }
+
+    private static void readShapeless(
+            final PacketWrapper packet,
+            final ItemRewriter items,
+            final List<CraftingDataStorage> recipes,
+            final RecipeType type) {
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            final String id = packet.read(BedrockTypes.STRING);
+            final List<ItemDescriptor> ingredients = Arrays.asList(packet.read(INGREDIENTS));
+            final List<BedrockItem> results = Arrays.asList(packet.read(items.itemArrayType()));
+            final UUID uuid = packet.read(BedrockTypes.UUID);
+            final String tag = packet.read(BedrockTypes.STRING);
+            final int priority = packet.read(BedrockTypes.VAR_INT);
+            readUnlocking(packet);
+            final int netId = packet.read(BedrockTypes.UNSIGNED_VAR_INT);
+            if (!results.isEmpty()) {
+                recipes.add(
+                        new CraftingDataStorage(
+                                type,
+                                netId,
+                                new ShapelessRecipe(
+                                        id, uuid, tag, priority, ingredients, results)));
+            }
+        }
+    }
+
+    private static void readSmithing(
+            final PacketWrapper packet,
+            final ItemRewriter items,
+            final List<CraftingDataStorage> recipes,
+            final boolean transform) {
+        for (int i = 0, size = packet.read(BedrockTypes.UNSIGNED_VAR_INT); i < size; i++) {
+            final String id = packet.read(BedrockTypes.STRING);
+            final ItemDescriptor template = packet.read(INGREDIENT);
+            final ItemDescriptor base = packet.read(INGREDIENT);
+            final ItemDescriptor addition = packet.read(INGREDIENT);
+            final BedrockItem result =
+                    transform ? packet.read(items.itemType()) : BedrockItem.empty();
+            final String tag = packet.read(BedrockTypes.STRING);
+            final int netId = packet.read(BedrockTypes.UNSIGNED_VAR_INT);
+            final UUID uuid = UUID.nameUUIDFromBytes(id.getBytes(StandardCharsets.UTF_8));
+            recipes.add(
+                    new CraftingDataStorage(
+                            transform ? RecipeType.SMITHING_TRANSFORM : RecipeType.SMITHING_TRIM,
+                            netId,
+                            new SmithingRecipe(
+                                    id, uuid, tag, 0, template, base, addition, result)));
+        }
+    }
+
+    private static void readUnlocking(final PacketWrapper packet) {
+        if (!packet.read(Types.BOOLEAN)) {
+            return;
+        }
+        packet.read(BedrockTypes.VAR_INT); // unlock context
+        if (packet.read(Types.BOOLEAN)) {
+            packet.read(INGREDIENTS);
+        }
+    }
+
+    private CraftingDataReader() { }
+
+    public record Data(List<CraftingDataStorage> recipes, boolean clearRecipes) { }
+
+}
