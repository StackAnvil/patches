+package net.raphimc.viabedrock.protocol.packet;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerID;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryActionData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class InventoryPacketsTest {
+
+    @Test
+    void replacingOccupiedCreativeSlotDeletesTheOldItemBeforePickingTheNewItem() {
+        final BedrockItem oldItem = new BedrockItem(1);
+        final BedrockItem newItem = new BedrockItem(2);
+        final BedrockInventoryTransaction transaction =
+                InventoryPackets.creativeSlotTransaction(4, oldItem, newItem);
+
+        assertEquals(3, transaction.actions().size());
+        final InventoryActionData delete = transaction.actions().get(0);
+        assertEquals(InventorySourceType.Creative_Inventory, delete.source().type());
+        assertEquals(0, delete.slot());
+        assertTrue(delete.fromItem().isEmpty());
+        assertSame(oldItem, delete.toItem());
+
+        final InventoryActionData pick = transaction.actions().get(1);
+        assertEquals(InventorySourceType.Creative_Inventory, pick.source().type());
+        assertEquals(1, pick.slot());
+        assertSame(newItem, pick.fromItem());
+        assertTrue(pick.toItem().isEmpty());
+
+        final InventoryActionData replace = transaction.actions().get(2);
+        assertEquals(InventorySourceType.Container_Inventory, replace.source().type());
+        assertEquals(ContainerID.CONTAINER_ID_INVENTORY.getValue(), replace.source().containerId());
+        assertEquals(4, replace.slot());
+        assertSame(oldItem, replace.fromItem());
+        assertSame(newItem, replace.toItem());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/InventoryTrackerTest.java
