+package net.raphimc.viabedrock.protocol.model.recipe;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.chunk.blockstate.BlockItemDescriptor;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class ItemRecipeKeyTest {
+
+    @Test
+    void ingredientComparisonUsesBlockIdentityAndBothWildcardPositions() {
+        final Object defaultBlock = new Object();
+        final Object variantBlock = new Object();
+        final var query = new ItemRecipeKey(1, (short) 8);
+        final var candidate = new ItemRecipeKey(1, (short) 0);
+        assertTrue(query.matches(candidate, metadata -> defaultBlock));
+        assertFalse(query.matches(candidate, metadata -> metadata == 8 ? defaultBlock : variantBlock));
+        assertFalse(query.matches(candidate, metadata -> null));
+        assertFalse(query.matches(new ItemRecipeKey(2, (short) 8), metadata -> defaultBlock));
+        assertFalse(query.matches(null, metadata -> defaultBlock));
+        assertTrue(query.matches(new ItemRecipeKey(1, Short.MAX_VALUE), metadata -> null));
+        assertTrue(new ItemRecipeKey(1, Short.MAX_VALUE).matches(candidate, metadata -> null));
+        // Equal values from different registries cannot stand in for the same native Block.
+        record State(int value) { }
+
+        assertFalse(query.matches(candidate, metadata -> new State(1)));
+    }
+
+    @Test
+    void descriptorIdentityDiffersFromRawMetadataAndNumericLookupKeys() {
+        final var block = new BlockItemDescriptor(256, (short) 7);
+        assertEquals(new ItemRecipeKey(42, (short) 7), ItemRecipeKey.fromDefinition(42, (short) 3, block, id -> 42));
+        assertEquals(new ItemRecipeKey(55, Short.MAX_VALUE),
+                ItemRecipeKey.fromDefinition(42, Short.MAX_VALUE, block, id -> 55));
+        assertEquals(new ItemRecipeKey(42, (short) 0),
+                ItemRecipeKey.fromDefinition(42, (short) -1, block, id -> id == 42 ? 42 : 55));
+        assertNull(ItemRecipeKey.fromDefinition(42, Short.MAX_VALUE, block, id -> null));
+        assertNull(ItemRecipeKey.fromDefinition(-1, (short) 1, block, id -> null));
+        assertNotEquals(new ItemRecipeKey(1, (short) 0), new ItemRecipeKey(0, (short) 1));
+    }
+
+    @Test
+    void matchesNativeRegistryOwnershipAndMissingDescriptorBoundaries() throws Exception {
+        final String reference = System.getenv("STACKANVIL_DESCRIPTOR_REGISTRY_REFERENCE");
+        assumeTrue(reference != null);
+        try (var input = Files.newBufferedReader(Path.of(reference))) {
+            for (var entry : JsonParser.parseReader(input).getAsJsonObject().getAsJsonArray("rows")) {
+                final var row = entry.getAsJsonObject();
+                final int original = row.get("originalId").getAsInt();
+                final var block = new BlockItemDescriptor(row.get("legacyId").getAsInt(), (short) row.get("metadata").getAsInt());
+                final var registry = new HashMap<Integer, Integer>();
+                final String mode = row.get("blockLookup").getAsString();
+                if (!mode.equals("missing")) {
+                    registry.put(block.numericItemId(), mode.equals("exact") ? original : (original + 1) & 0xFFFF);
+                }
+                if (row.get("originalRegistered").getAsBoolean()) {
+                    registry.put(original, original);
+                }
+                final List<Integer> lookups = new ArrayList<>();
+                final var actual = ItemRecipeKey.fromDefinition(original, (short) row.get("rawAux").getAsInt(), block, id -> {
+                    lookups.add(id);
+                    return registry.get(id);
+                });
+                final List<Integer> expectedLookups = new ArrayList<>();
+                row.getAsJsonArray("lookups").forEach(value -> expectedLookups.add(value.getAsInt()));
+                assertEquals(expectedLookups, lookups, row::toString);
+                if (row.get("descriptor").isJsonNull()) {
+                    assertNull(actual, row::toString);
+                } else {
+                    final var descriptor = row.getAsJsonArray("descriptor");
+                    assertEquals(new ItemRecipeKey(descriptor.get(0).getAsInt(), descriptor.get(1).getAsShort()), actual, row::toString);
+                    assertEquals(row.get("hash").getAsLong(), Integer.toUnsignedLong(actual.descriptorHash()), row::toString);
+                }
+            }
+        }
+    }
+
+}
