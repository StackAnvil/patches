+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.dynamic.BundleContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerID;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public final class InventoryRequestStorage {
+
+    private final ItemStackRequestInfo requestInfo;
+    private final int javaRevision;
+    private final Container prevCursorContainer;
+    private final List<Container> prevContainers;
+    private final ResponsePolicy responsePolicy;
+    private Prediction prediction;
+
+    public InventoryRequestStorage(final ItemStackRequestInfo requestInfo, final int javaRevision,
+                                   final Container prevCursorContainer, final List<Container> prevContainers) {
+        this(requestInfo, javaRevision, prevCursorContainer, prevContainers, ResponsePolicy.PREDICTED_SLOTS);
+    }
+
+    public InventoryRequestStorage(final ItemStackRequestInfo requestInfo, final int javaRevision,
+                                   final Container prevCursorContainer, final List<Container> prevContainers,
+                                   final ResponsePolicy responsePolicy) {
+        this.requestInfo = requestInfo;
+        this.javaRevision = javaRevision;
+        this.prevCursorContainer = prevCursorContainer;
+        this.prevContainers = List.copyOf(prevContainers);
+        this.responsePolicy = java.util.Objects.requireNonNull(responsePolicy, "responsePolicy");
+    }
+
+    public ItemStackRequestInfo requestInfo() {
+        return this.requestInfo;
+    }
+
+    public int javaRevision() {
+        return this.javaRevision;
+    }
+
+    public Container prevCursorContainer() {
+        return this.prevCursorContainer;
+    }
+
+    public List<Container> prevContainers() {
+        return this.prevContainers;
+    }
+
+    public boolean hasPrediction() {
+        return this.prediction != null;
+    }
+
+    public void capturePrediction(final InventoryTracker tracker) {
+        if (this.prediction != null) {
+            throw new IllegalStateException("Inventory request prediction was already captured");
+        }
+        final List<ContainerPrediction> containers = new ArrayList<>(this.prevContainers.size());
+        for (final Container previous : this.prevContainers) {
+            Container current = resolveSnapshotContainer(tracker, previous);
+            if (current == null) {
+                throw new IllegalStateException("Inventory request container is no longer available");
+            }
+            // Open player windows share the permanent inventory, which receives named responses.
+            if (current instanceof InventoryContainer) {
+                current = tracker.getInventoryContainer();
+            }
+            containers.add(new ContainerPrediction(current, previous, current.copy()));
+        }
+        this.prediction = new Prediction(
+                new ContainerPrediction(tracker.getHudContainer(), this.prevCursorContainer, tracker.getHudContainer().copy()),
+                List.copyOf(containers), tracker.getCurrentContainer(), tracker.latestContainerGeneration());
+    }
+
+    /** Replay only this request's delta after restoring the batch's initial snapshot. */
+    Set<Container> applyPrediction(final InventoryTracker tracker) {
+        final Set<Container> changed = new HashSet<>();
+        this.applyPrediction(tracker, this.prediction.cursor(), changed);
+        for (final ContainerPrediction snapshot : this.prediction.containers()) {
+            this.applyPrediction(tracker, snapshot, changed);
+        }
+        return changed;
+    }
+
+    private void applyPrediction(final InventoryTracker tracker, final ContainerPrediction snapshot,
+                                 final Set<Container> changed) {
+        final Container owner = snapshot.owner();
+        if (resolveSnapshotContainer(tracker, owner) != owner || !this.acceptsResponse(tracker, owner)
+                || owner.serverRevision() != snapshot.before().serverRevision()) {
+            return;
+        }
+        for (int slot = 0; slot < owner.size(); slot++) {
+            if (this.acceptsResponse(tracker, owner, slot)
+                    && !snapshot.before().getItem(slot).equals(snapshot.after().getItem(slot))) {
+                owner.setItem(slot, snapshot.after().getItem(slot).copy());
+                changed.add(owner);
+            }
+        }
+    }
+
+    public BedrockItem predictedItem(final Container target, final int slot) {
+        if (this.prediction == null) {
+            throw new IllegalStateException("Inventory request prediction has not been captured");
+        }
+        if (this.prediction.cursor().after().containerId() == target.containerId()) {
+            return this.prediction.cursor().after().getItem(slot);
+        }
+        for (final ContainerPrediction snapshot : this.prediction.containers()) {
+            final Container container = snapshot.after();
+            if (container.containerId() == target.containerId()
+                    && container.getFullContainerName(slot).equals(target.getFullContainerName(slot))) {
+                return container.getItem(slot);
+            }
+        }
+        return null;
+    }
+
+    boolean acceptsResponse(final InventoryTracker tracker, final Container container) {
+        if (this.prediction == null) {
+            throw new IllegalStateException("Inventory request prediction has not been captured");
+        }
+        if (container instanceof BundleContainer) {
+            return this.prediction.containers().stream().anyMatch(snapshot -> snapshot.owner() == container);
+        }
+        return container != tracker.getCurrentContainer() || container == tracker.getInventoryContainer()
+                || this.hasCurrentMenu(tracker);
+    }
+
+    boolean hasCurrentMenu(final InventoryTracker tracker) {
+        if (this.prediction == null) {
+            throw new IllegalStateException("Inventory request prediction has not been captured");
+        }
+        return tracker.getCurrentContainer() == this.prediction.menu()
+                && tracker.latestContainerGeneration() == this.prediction.menuGeneration();
+    }
+
+    boolean acceptsResponse(final InventoryTracker tracker, final Container container, final int slot) {
+        return this.acceptsResponse(tracker, container)
+                && (container != tracker.getHudContainer() || slot == 0 || this.hasCurrentMenu(tracker));
+    }
+
+    Set<Container> restoreUnconfirmedPredictions(final InventoryTracker tracker, final ItemStackResponseInfo response) {
+        if (this.responsePolicy == ResponsePolicy.PREDICTED_SLOTS) {
+            return Set.of();
+        }
+        if (this.prediction == null) {
+            throw new IllegalStateException("Inventory request prediction has not been captured");
+        }
+        final Map<Container, Set<Integer>> reported = new HashMap<>();
+        for (final var containerInfo : response.containers()) {
+            for (final var slotInfo : containerInfo.slots()) {
+                final int requestSlot = Byte.toUnsignedInt(slotInfo.slot());
+                final Container container = tracker.getContainerFromName(containerInfo.containerName(), requestSlot);
+                if (container != null && container.ownsBedrockSlot(containerInfo.containerName(), requestSlot)
+                        && this.acceptsResponse(tracker, container, container.slotFromRequest(requestSlot))) {
+                    reported.computeIfAbsent(container, key -> new HashSet<>()).add(container.slotFromRequest(requestSlot));
+                }
+            }
+        }
+        final Set<Container> restored = new HashSet<>();
+        this.restoreUnconfirmedSlots(tracker, this.prediction.cursor(), reported, restored);
+        for (final ContainerPrediction snapshot : this.prediction.containers()) {
+            this.restoreUnconfirmedSlots(tracker, snapshot, reported, restored);
+        }
+        return restored;
+    }
+
+    private void restoreUnconfirmedSlots(final InventoryTracker tracker, final ContainerPrediction snapshot,
+                                        final Map<Container, Set<Integer>> reported, final Set<Container> restored) {
+        final Container owner = snapshot.owner();
+        if (resolveSnapshotContainer(tracker, owner) != owner || !this.acceptsResponse(tracker, owner)
+                || owner.serverRevision() != snapshot.before().serverRevision()) {
+            return;
+        }
+        final Set<Integer> acknowledged = reported.getOrDefault(owner, Set.of());
+        for (int slot = 0; slot < owner.size(); slot++) {
+            if (!this.acceptsResponse(tracker, owner, slot)) {
+                continue;
+            }
+            final BedrockItem before = snapshot.before().getItem(slot);
+            final BedrockItem after = snapshot.after().getItem(slot);
+            if (!acknowledged.contains(slot) && !before.equals(after) && owner.getItem(slot).equals(after)) {
+                owner.setItem(slot, before.copy());
+                restored.add(owner);
+            }
+        }
+    }
+
+    static Container resolveSnapshotContainer(final InventoryTracker tracker, final Container snapshot) {
+        Container current = tracker.getContainerClientbound(snapshot.containerId(), null, null);
+        if (current == null && snapshot.containerId() == ContainerID.CONTAINER_ID_REGISTRY.getValue()) {
+            current = tracker.getContainerFromName(snapshot.getFullContainerName(0), 0);
+        }
+        return current;
+    }
+
+    public enum ResponsePolicy {
+        PREDICTED_SLOTS,
+        REPORTED_SLOTS
+    }
+
+    private record ContainerPrediction(Container owner, Container before, Container after) { }
+
+    private record Prediction(ContainerPrediction cursor, List<ContainerPrediction> containers,
+                              Container menu, long menuGeneration) { }
+
+}
