+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NamedItemConstructionTest {
+
+    @Test
+    void namedAndDefinitionConstructorsKeepTheirDifferentOrdinaryUpgradeFlags() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("minecraft:charcoal", 257, false, ItemVersion.Legacy, null),
+            new ItemEntry("test:coal_collision", 304, false, ItemVersion.Legacy, null)});
+        final var named = registry.createNamedItem("test:coal_collision", 1, 1, (definition, auxiliary) -> null);
+        final var direct = registry.createDefinitionItem(registry.definition("test:coal_collision"), 1, 1, (definition, auxiliary) -> null);
+        assertSame(registry.definition("minecraft:coal"), named.definition());
+        assertEquals(1, named.data());
+        assertSame(registry.definition("minecraft:charcoal"), direct.definition());
+        assertEquals(257, direct.identifier());
+        assertEquals(0, direct.data());
+        assertNotSame(registry.definition(257), direct.definition());
+    }
+
+    @Test
+    void sourceAssociationPrecedesNumericSelectionAndWideWildcardComparison() {
+        final var components = new CompoundTag();
+        components.putString("minecraft:block", "minecraft:stone");
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:block", 4, false, ItemVersion.Legacy, data)});
+        final var source = registry.definition("test:block");
+        assertNotSame(source, registry.definition(4));
+        final var block = new ItemStackHeader.Block(11, 1, (short) 0);
+        final BiFunction<NativeItemDefinitions.Definition<?>, Short, ItemStackHeader.Block> association = (definition, auxiliary) -> {
+            assertSame(source, definition);
+            return block;
+        };
+        final var direct = registry.createDefinitionItem(source, 0, 1, association);
+        final var named = registry.createNamedItem("test:block", 0, 1, association);
+        assertSame(registry.definition(1), direct.definition());
+        assertEquals(direct, named);
+        assertEquals(11, direct.blockRuntimeId());
+        assertEquals(0, registry.createDefinitionItem(source, 65536 + Short.MAX_VALUE, 1, association).data());
+        final var invalidated = registry.createDefinitionItem(source, Short.MAX_VALUE, 256, association);
+        assertTrue(invalidated.isEmpty());
+        assertEquals(Short.MAX_VALUE, invalidated.data());
+        assertFalse(invalidated.hasBlockState());
+    }
+
+    @Test
+    void numericZeroRetainsRawFieldsUntilCountInvalidation() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("minecraft:air", 0, false, ItemVersion.None, null)});
+        final var raw = registry.createNamedItem("minecraft:air", 65537, 257, (definition, auxiliary) -> null);
+        assertTrue(raw.isEmpty());
+        assertNull(raw.definition());
+        assertEquals(1, raw.data());
+        assertEquals(1, raw.amount());
+        final var wrapped = registry.createNamedItem("minecraft:air", 1, 256, (definition, auxiliary) -> null);
+        assertEquals(0, wrapped.amount());
+        assertEquals(0, wrapped.data());
+        final var negative = registry.createNamedItem("minecraft:air", 1, -1, (definition, auxiliary) -> null);
+        assertEquals(0, negative.amount());
+        assertEquals(0, negative.data());
+        final var missing = registry.createNamedItem("test:missing", 1, 257, (definition, auxiliary) -> null);
+        assertEquals(0, missing.amount());
+        assertEquals(0, missing.data());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/model/NativeArmorPlacementTest.java b/src/test/java/net/raphimc/viabedrock/protocol/model/NativeArmorPlacementTest.java
