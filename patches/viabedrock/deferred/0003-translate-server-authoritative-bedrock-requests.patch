+package net.raphimc.viabedrock.protocol.model;
+
+import java.util.function.BiFunction;
+import java.util.function.IntFunction;
+
+/** Constructed native Item ownership, auxiliary metadata and optional Block identity. */
+public record ItemStackHeader(NativeItemDefinitions.Definition<?> definition, short metadata, byte amount, Block block) {
+
+    public ItemStackHeader {
+        if (metadata < 0) {
+            throw new IllegalArgumentException("Expected nonnegative stack metadata");
+        }
+    }
+
+    public int identifier() {
+        return this.definition != null ? this.definition.id() & 0xFFFF : 0;
+    }
+
+    public static ItemStackHeader fromNetwork(final int identifier, final short metadata, final byte amount,
+                                               final Block runtimeBlock,
+                                               final BiFunction<NativeItemDefinitions.Definition<?>, Short, Block> associatedBlock,
+                                               final IntFunction<NativeItemDefinitions.Definition<?>> lookup,
+                                               final BiFunction<NativeItemDefinitions.Definition<?>, Short, NativeItemDefinitions.Definition<?>> canonical) {
+        final var item = lookup.apply(identifier & 0xFFFF);
+        if (item == null) {
+            return null;
+        }
+        final int quantity = Byte.toUnsignedInt(amount);
+        if (runtimeBlock != null && runtimeBlock.runtimeId != 0) {
+            final var candidate = initialize(runtimeBlock.numericItemId, (short) 0, quantity, runtimeBlock, true, associatedBlock, lookup, canonical);
+            if (candidate != null && candidate.amount != 0 && candidate.identifier() == (identifier & 0xFFFF)) {
+                return candidate;
+            }
+        }
+        return construct(item, metadata, quantity, true, associatedBlock, lookup, canonical);
+    }
+
+    /** The definition-pointer constructor enables canonical upgrade for an ordinary Item. */
+    public static ItemStackHeader fromDefinition(final NativeItemDefinitions.Definition<?> definition, final int metadata, final int amount,
+                                                  final BiFunction<NativeItemDefinitions.Definition<?>, Short, Block> associatedBlock,
+                                                  final IntFunction<NativeItemDefinitions.Definition<?>> lookup,
+                                                  final BiFunction<NativeItemDefinitions.Definition<?>, Short, NativeItemDefinitions.Definition<?>> canonical) {
+        return construct(definition, metadata, amount, true, associatedBlock, lookup, canonical);
+    }
+
+    /** Named lookup preserves its wide auxiliary until the class-specific constructor selects its branch. */
+    public static ItemStackHeader fromNamed(final NativeItemDefinitions.Lookup<?> named, final int amount,
+                                             final BiFunction<NativeItemDefinitions.Definition<?>, Short, Block> associatedBlock,
+                                             final IntFunction<NativeItemDefinitions.Definition<?>> lookup,
+                                             final BiFunction<NativeItemDefinitions.Definition<?>, Short, NativeItemDefinitions.Definition<?>> canonical) {
+        return construct(named.definition(), named.auxiliary(), amount, false, associatedBlock, lookup, canonical);
+    }
+
+    private static ItemStackHeader construct(final NativeItemDefinitions.Definition<?> definition, final int metadata, final int amount,
+                                              final boolean upgradeOrdinary,
+                                              final BiFunction<NativeItemDefinitions.Definition<?>, Short, Block> associatedBlock,
+                                              final IntFunction<NativeItemDefinitions.Definition<?>> lookup,
+                                              final BiFunction<NativeItemDefinitions.Definition<?>, Short, NativeItemDefinitions.Definition<?>> canonical) {
+        if (definition == null) {
+            return null;
+        }
+        // Association belongs to the original definition, before numeric initialization selects its own Item.
+        final Block block = associatedBlock.apply(definition, (short) metadata);
+        final boolean blockConstructor = block != null && definition.id() <= 255;
+        final Integer identifier = blockConstructor ? block.numericItemId : Integer.valueOf(definition.id());
+        final var result = initialize(identifier, (short) metadata, amount, block,
+                block != null || upgradeOrdinary, associatedBlock, lookup, canonical);
+        if (result == null) {
+            return null;
+        }
+        // The BlockLegacy constructor compares the original int, then reapplies its wildcard after count invalidation.
+        return blockConstructor && metadata == Short.MAX_VALUE
+                ? new ItemStackHeader(result.definition, Short.MAX_VALUE, result.amount, result.block) : result;
+    }
+
+    static ItemStackHeader initialize(final Integer identifier, final short metadata, final int amount, final Block block,
+                                               final boolean upgrade,
+                                               final BiFunction<NativeItemDefinitions.Definition<?>, Short, Block> associatedBlock,
+                                               final IntFunction<NativeItemDefinitions.Definition<?>> lookup,
+                                               final BiFunction<NativeItemDefinitions.Definition<?>, Short, NativeItemDefinitions.Definition<?>> canonical) {
+        if (identifier == null) {
+            return null;
+        }
+        final var selected = lookup.apply(identifier & 0xFFFF);
+        if (selected == null && (short) identifier.intValue() != 0) {
+            return null;
+        }
+        short auxiliary = block != null ? 0 : (short) Math.max(0, metadata);
+        var definition = selected;
+        Block resolvedBlock = block;
+        if (selected != null && upgrade) {
+            final Short queryAuxiliary = block != null ? block.canonicalAuxiliary : Short.valueOf(auxiliary);
+            final var replacement = canonical.apply(selected, queryAuxiliary);
+            if (replacement != null && replacement != selected) {
+                final Block replacementBlock = associatedBlock.apply(replacement, Short.MAX_VALUE);
+                if (replacementBlock != null) {
+                    resolvedBlock = replacementBlock;
+                }
+                definition = replacement;
+                auxiliary = 0;
+            }
+        }
+        final byte quantity = (byte) Math.max(0, amount);
+        // Numeric zero can retain raw count and auxiliary without a resolved Item. Count invalidation still clears both.
+        return quantity == 0 ? new ItemStackHeader(null, (short) 0, (byte) 0, null)
+                : new ItemStackHeader(definition, auxiliary, quantity, resolvedBlock);
+    }
+
+    /** Runtime IDs identify exact palette slots. Canonical auxiliary belongs to that actual Block. */
+    public record Block(int runtimeId, Integer numericItemId, Short canonicalAuxiliary) { }
+
+}
