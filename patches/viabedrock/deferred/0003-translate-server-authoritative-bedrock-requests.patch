+class CraftedItemSynchronizationTest {
+
+    @Test
+    void waitsForFinalMapIdentityAndAllSnapshotsBeforeQueuedPlacement() {
+        final Fixture fixture = new Fixture();
+        final Container cursor = fixture.inventory.getHudContainer();
+        cursor.setItem(0, map(20, 1, 3387645893L));
+        final var destination = cursor.requestSlotInfo(0, 0);
+        final InventoryRequestStorage request = fixture.request(List.of(take(destination)));
+        final ItemStackResponseInfo response = response(destination, 20, 1);
+        assertTrue(fixture.requests.synchronizeCraftedItems(request, response));
+        final AtomicLong placedMapId = new AtomicLong();
+        assertTrue(fixture.requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+            @Override
+            public Container container() {
+                return fixture.inventory.getInventoryContainer();
+            }
+
+            @Override
+            public boolean apply() {
+                placedMapId.set(cursor.getItem(0).tag().getLong("map_uuid"));
+                return true;
+            }
+        }));
+        fixture.requests.drainQueuedInteractions();
+        assertEquals(0, placedMapId.get());
+
+        // The acknowledgment alone installed the correct network ID, but retained a preview UUID.
+        cursor.setItem(0, map(20, 1, 824460016L));
+        fixture.requests.handleAuthoritativeSlot(cursor, 0);
+        assertTrue(fixture.requests.hasPending());
+        for (final Container container : fixture.playerContainers()) {
+            fixture.requests.handleAuthoritativeContent(container);
+        }
+        assertFalse(fixture.requests.hasPending());
+        assertEquals(824460016L, placedMapId.get());
+        fixture.requests.handleAuthoritativeContent(cursor);
+        assertEquals(824460016L, placedMapId.get());
+    }
+
+    @Test
+    void ignoresWrongSlotOldNetworkIdAndOldAmount() {
+        final Fixture fixture = new Fixture();
+        final Container inventory = fixture.inventory.getInventoryContainer();
+        final var destination = inventory.requestSlotInfo(9, 0);
+        final var synchronization = CraftedItemSynchronization.from(
+                fixture.request(List.of(take(destination))), response(destination, 30, 2), fixture.inventory);
+        inventory.setItem(9, map(29, 2, 1));
+        for (final Container container : fixture.playerContainers()) {
+            synchronization.observe(container, true, -1);
+        }
+        assertFalse(synchronization.isComplete());
+        inventory.setItem(9, map(30, 1, 1));
+        synchronization.observe(inventory, false, 9);
+        assertFalse(synchronization.isComplete());
+        inventory.setItem(9, map(30, 2, 1));
+        synchronization.observe(inventory, false, 10);
+        assertFalse(synchronization.isComplete());
+        synchronization.observe(inventory, false, 9);
+        assertTrue(synchronization.isComplete());
+    }
+
+    @Test
+    void laterSnapshotCanInvalidateEarlierMatchingSlot() {
+        final Fixture fixture = new Fixture();
+        final Container cursor = fixture.inventory.getHudContainer();
+        final var destination = cursor.requestSlotInfo(0, 0);
+        final var synchronization = CraftedItemSynchronization.from(
+                fixture.request(List.of(take(destination))), response(destination, 30, 1), fixture.inventory);
+        cursor.setItem(0, map(30, 1, 2));
+        synchronization.observe(cursor, false, 0);
+        cursor.setItem(0, map(29, 1, 1));
+        for (final Container container : fixture.playerContainers()) {
+            synchronization.observe(container, true, -1);
+        }
+        assertFalse(synchronization.isComplete());
+        cursor.setItem(0, map(30, 1, 2));
+        synchronization.observe(cursor, false, 0);
+        assertTrue(synchronization.isComplete());
+    }
+
+    @Test
+    void waitsForEveryCraftDestinationAndMatchesInventoryAliases() {
+        final Fixture fixture = new Fixture();
+        final Container inventory = fixture.inventory.getInventoryContainer();
+        final var first = inventory.requestSlotInfo(0, 0);
+        final var second = inventory.requestSlotInfo(9, 0);
+        final var request = fixture.request(List.of(take(first),
+                new ItemStackRequestAction.PlaceAction(1, output(), second)));
+        final var response = new ItemStackResponseInfo(ItemStackNetResult.Success, -5, List.of(
+                new ItemStackResponseContainerInfo(new FullContainerName(
+                        ContainerEnumName.HotbarContainer, null), List.of(slot(0, 30, 1))),
+                new ItemStackResponseContainerInfo(new FullContainerName(
+                        ContainerEnumName.InventoryContainer, null), List.of(slot(9, 31, 1)))));
+        final var synchronization = CraftedItemSynchronization.from(request, response, fixture.inventory);
+        inventory.setItem(0, map(30, 1, 1));
+        for (final Container container : fixture.playerContainers()) {
+            synchronization.observe(container, true, -1);
+        }
+        assertFalse(synchronization.isComplete());
+        inventory.setItem(9, map(31, 1, 2));
+        synchronization.observe(inventory, false, 9);
+        assertTrue(synchronization.isComplete());
+    }
+
+    @Test
+    void ordinaryTransfersAndEmptyCraftDestinationsNeedNoRefresh() {
+        final Fixture fixture = new Fixture();
+        final var destination = fixture.inventory.getHudContainer().requestSlotInfo(0, 0);
+        final var source = fixture.inventory.getInventoryContainer().requestSlotInfo(9, 1);
+        assertNull(CraftedItemSynchronization.from(fixture.request(List.of(
+                        new ItemStackRequestAction.TakeAction(1, source, destination))),
+                response(destination, 30, 1), fixture.inventory));
+        assertNull(CraftedItemSynchronization.from(fixture.request(List.of(take(destination))),
+                response(destination, 0, 0), fixture.inventory));
+    }
+
+    private static BedrockItem map(final int networkId, final int amount, final long mapId) {
+        final BedrockItem item = new BedrockItem(423);
+        item.setAmount(amount);
+        item.setNetId(networkId);
+        final CompoundTag tag = new CompoundTag();
+        tag.putLong("map_uuid", mapId);
+        item.setTag(tag);
+        return item;
+    }
+
+    private static ItemStackRequestSlotInfo output() {
+        return new ItemStackRequestSlotInfo(new FullContainerName(
+                ContainerEnumName.CreatedOutputContainer, null), (byte) 50, -5);
+    }
+
+    private static ItemStackRequestAction.TakeAction take(final ItemStackRequestSlotInfo destination) {
+        return new ItemStackRequestAction.TakeAction(1, output(), destination);
+    }
+
+    private static ItemStackResponseSlotInfo slot(final int slot, final int networkId, final int amount) {
+        return new ItemStackResponseSlotInfo((byte) slot, (byte) slot, (byte) amount,
+                networkId, "", null, 0);
+    }
+
+    private static ItemStackResponseInfo response(final ItemStackRequestSlotInfo destination,
+                                                final int networkId, final int amount) {
+        return new ItemStackResponseInfo(ItemStackNetResult.Success, -5, List.of(
+                new ItemStackResponseContainerInfo(destination.container(), List.of(
+                        slot(Byte.toUnsignedInt(destination.slot()), networkId, amount)))));
+    }
+
+    private static final class Fixture {
+
+        private final InventoryTracker inventory;
+        private final InventoryRequestTracker requests;
+
+        private Fixture() {
+            final Map<Class<?>, Object> storage = new HashMap<>();
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                    UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                    (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+            this.inventory = new InventoryTracker(user);
+            this.requests = new InventoryRequestTracker(user);
+            storage.put(InventoryTracker.class, this.inventory);
+            storage.put(InventoryRequestTracker.class, this.requests);
+            this.inventory.setCurrentContainer(this.inventory.getInventoryContainer());
+            this.requests.setPredictingClick(true);
+        }
+
+        private List<Container> playerContainers() {
+            return List.of(this.inventory.getInventoryContainer(), this.inventory.getArmorContainer(),
+                    this.inventory.getHudContainer(), this.inventory.getOffhandContainer());
+        }
+
+        private InventoryRequestStorage request(final List<ItemStackRequestAction> actions) {
+            return new InventoryRequestStorage(new ItemStackRequestInfo(-5, actions, List.of(),
+                    TextProcessingEventOrigin.unknown), 0, this.inventory.getHudContainer().copy(),
+                    List.of(this.inventory.getInventoryContainer().copy()));
+        }
+    }
