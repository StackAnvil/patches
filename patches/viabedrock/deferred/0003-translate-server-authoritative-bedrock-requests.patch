+                @Override
+                public Container container() {
+                    return fixture.menu;
+                }
+
+                @Override
+                public boolean apply() {
+                    applied.incrementAndGet();
+                    return true;
+                }
+            }));
+            fixture.respond(List.of(ack(ContainerEnumName.CursorContainer, 0, 0, 0)));
