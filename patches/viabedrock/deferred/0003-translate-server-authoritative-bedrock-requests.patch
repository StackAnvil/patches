+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class InventoryRequestRecoveryTest {
+
+    @Test
+    void requiresFullInventoryAndCursorUpdateBeforeReleasingRequest() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final InventoryRequestRecovery recovery = new InventoryRequestRecovery();
+        recovery.begin(100, false, false);
+
+        assertFalse(recovery.observe(tracker.getInventoryContainer(),
+                tracker.getHudContainer(), false, 0));
+        assertFalse(recovery.observe(tracker.getInventoryContainer(),
+                tracker.getHudContainer(), true, -1));
+        assertTrue(recovery.observe(tracker.getHudContainer(),
+                tracker.getHudContainer(), false, 0));
+        assertFalse(recovery.hasTimedOut(1099, 1000));
+        assertTrue(recovery.hasTimedOut(1100, 1000));
+
+        recovery.reset();
+        assertFalse(recovery.isActive());
+        assertFalse(recovery.observe(tracker.getHudContainer(),
+                tracker.getHudContainer(), true, -1));
+    }
+
+    @Test
+    void alsoRequiresFreshEquipmentWhenRequestTouchedIt() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final InventoryRequestRecovery recovery = new InventoryRequestRecovery();
+        recovery.begin(100, true, true);
+
+        assertFalse(recovery.observe(tracker.getInventoryContainer(),
+                tracker.getHudContainer(), true, -1));
+        assertFalse(recovery.observe(tracker.getHudContainer(),
+                tracker.getHudContainer(), false, 0));
+        assertFalse(recovery.observe(tracker.getArmorContainer(),
+                tracker.getHudContainer(), false, 0));
+        assertFalse(recovery.observe(tracker.getArmorContainer(),
+                tracker.getHudContainer(), true, -1));
+        assertTrue(recovery.observe(tracker.getOffhandContainer(),
+                tracker.getHudContainer(), false, 0));
+    }
+
+}
