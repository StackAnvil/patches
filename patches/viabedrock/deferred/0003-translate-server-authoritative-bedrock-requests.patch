+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.TimeUnit;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenClose;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InteractPacketPayload_Action;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Serializes uncorrelated Bedrock opens and retains retired openings until their acknowledgments arrive. */
+public final class PlayerInventoryScreenTracker extends StoredObject {
+
+    private static final long OPEN_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(5);
+    private long latestOpening;
+    private boolean requested;
+    private long inFlight;
+    private long requestedSince;
+    private long nativeOpening;
+    private boolean advertised;
+
+    public PlayerInventoryScreenTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public boolean enabled() {
+        final var channels = this.user().get(ChannelStorage.class);
+        return channels != null && channels.hasChannel(PlayerInventoryScreenClose.CHANNEL)
+                && this.user().getProtocolInfo().getClientState() == State.PLAY;
+    }
+
+    public void refreshCapability() {
+        if (this.user().getProtocolInfo().getClientState() != State.PLAY) {
+            this.advertised = false;
+            this.retire();
+            return;
+        }
+        final boolean enabled = this.enabled();
+        if (enabled == this.advertised) {
+            return;
+        }
+        this.advertised = enabled;
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, enabled ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, PlayerInventoryScreenRequest.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+        if (!enabled) {
+            this.retire();
+        }
+    }
+
+    public void request(final PlayerInventoryScreenRequest request) {
+        if (!this.enabled()) {
+            return;
+        }
+        if (request.open()) {
+            if (request.opening() <= this.latestOpening) {
+                return;
+            }
+            this.requests().clearQueuedScreenInteractions();
+            this.latestOpening = request.opening();
+            this.requested = true;
+            this.requestedSince = System.nanoTime();
+        } else {
+            if (request.opening() != this.latestOpening || !this.requested) {
+                return;
+            }
+            this.requested = false;
+            this.requests().clearQueuedScreenInteractions();
+        }
+        this.service();
+    }
+
+    /** Ordinary close-zero packets cannot identify which of two player openings they belong to. */
+    public boolean ownsClose() {
+        return this.requested || this.inFlight != 0 || this.nativeOpening != 0;
+    }
+
+    public boolean hasPendingOpen() {
+        return this.inFlight != 0;
+    }
+
+    public boolean acceptsClicks() {
+        return this.requested && (this.inFlight == this.latestOpening
+                || this.nativeOpening == this.latestOpening && this.inventory().getCurrentContainer() instanceof InventoryContainer);
+    }
+
+    /** Called after the native container is installed, before any queued Java clicks are replayed. */
+    public void opened() {
+        if (this.inFlight == 0) {
+            return;
+        }
+        final long opening = this.inFlight;
+        this.inFlight = 0;
+        this.nativeOpening = opening;
+        if (this.enabled() && this.requested && opening == this.latestOpening) {
+            this.requests().keepPlayerInventoryOpen();
+            return;
+        }
+        // Old screen clicks were discarded when its request retired. Later global offhand
+        // actions can still use this acknowledgment, then close the temporary inventory.
+        this.requests().openPlayerInventoryTemporarily();
+    }
+
+    /** The next request starts only after the previous native close acknowledgment. */
+    public void closed(final boolean serverInitiated) {
+        final long opening = this.nativeOpening;
+        this.nativeOpening = 0;
+        if (serverInitiated && opening != 0 && opening == this.latestOpening) {
+            this.retire();
+        }
+        this.service();
+    }
+
+    public void retire() {
+        if (this.requested) {
+            this.requested = false;
+            if (this.enabled()) {
+                final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+                packet.write(Types.STRING, PlayerInventoryScreenClose.CHANNEL);
+                packet.write(PlayerInventoryScreenClose.TYPE, new PlayerInventoryScreenClose(this.latestOpening));
+                packet.send(BedrockProtocol.class);
+            }
+        }
+        this.requests().clearQueuedScreenInteractions();
+        this.service();
+    }
+
+    public void recovering() {
+        this.retire();
+        this.nativeOpening = 0;
+    }
+
+    public void tick(final long now) {
+        if (this.requested && (this.nativeOpening != this.latestOpening || this.inventory().getCurrentContainer() == null)
+                && now - this.requestedSince >= OPEN_TIMEOUT_NANOS) {
+            // Keep inFlight: a timeout cannot attach an eventual old acknowledgment to a new screen.
+            this.retire();
+        }
+        this.service();
+    }
+
+    private void service() {
+        final var inventory = this.inventory();
+        if (this.nativeOpening != 0 && inventory.getCurrentContainer() instanceof InventoryContainer
+                && (!this.requested || this.nativeOpening != this.latestOpening)) {
+            this.requests().openPlayerInventoryTemporarily();
+            this.requests().closeTemporaryInventoryIfIdle();
+            return;
+        }
+        if (!this.requested || this.inFlight != 0 || inventory.getPendingCloseContainer() != null) {
+            return;
+        }
+        if (!this.enabled() || this.requests().isRecovering()) {
+            this.retire();
+            return;
+        }
+        if (inventory.isNonInventoryScreenOpen()
+                || inventory.getCurrentContainer() != null && !(inventory.getCurrentContainer() instanceof InventoryContainer)) {
+            this.retire();
+            return;
+        }
+        this.requests().keepPlayerInventoryOpen();
+        if (inventory.getCurrentContainer() instanceof InventoryContainer) {
+            // A temporary offhand opening can become the actual installed player screen.
+            this.nativeOpening = this.latestOpening;
+            return;
+        }
+        final boolean send = this.requests().beginInventoryOpen();
+        this.inFlight = this.latestOpening;
+        if (!send) {
+            return;
+        }
+        final var packet = PacketWrapper.create(ServerboundBedrockPackets.INTERACT, this.user());
+        packet.write(Types.UNSIGNED_BYTE, (short) InteractPacketPayload_Action.OpenInventory.getValue());
+        packet.write(BedrockTypes.UNSIGNED_VAR_LONG, this.user().get(EntityTracker.class).getClientPlayer().runtimeId());
+        packet.write(BedrockTypes.OPTIONAL_POSITION_3F, null);
+        packet.sendToServer(BedrockProtocol.class);
+    }
+
+    private InventoryTracker inventory() {
+        return this.user().get(InventoryTracker.class);
+    }
+
+    private InventoryRequestTracker requests() {
+        return this.user().get(InventoryRequestTracker.class);
+    }
+
+}
