+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.ShortTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemCookingPropertiesTest {
+
+    @Test
+    void foodTakesPrecedenceOverBothBlockSources() {
+        assertEquals(ItemCookingProperties.Category.FOOD, new ItemCookingProperties(true, "test:block", true).category());
+        assertEquals(ItemCookingProperties.Category.BLOCKS, new ItemCookingProperties(false, "test:block", false).category());
+        assertEquals(ItemCookingProperties.Category.BLOCKS, new ItemCookingProperties(false, null, true).category());
+        assertEquals(ItemCookingProperties.Category.ITEMS, ItemCookingProperties.NONE.category());
+    }
+
+    @Test
+    void componentUpdatesPreserveOmittedAndIncorrectlyTypedComponents() {
+        final var previous = new ItemCookingProperties(true, "test:block", true);
+        final var components = new CompoundTag();
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", ignored -> null));
+        for (final Tag malformed : List.of(new ByteTag((byte) 1), new StringTag(""), new IntTag(1))) {
+            components.put("minecraft:food", malformed);
+            components.put("minecraft:block_placer", malformed);
+            components.put("item_properties", malformed);
+            assertEquals(previous, previous.withComponentItemData(components, "test:block", ignored -> null));
+        }
+        final var food = new CompoundTag();
+        components.put("minecraft:food", food);
+        assertTrue(ItemCookingProperties.NONE.withComponentItemData(components, "test:block", ignored -> null).food());
+        components.remove("minecraft:food");
+        assertTrue(previous.withComponentItemData(components, "test:block", ignored -> null).food());
+    }
+
+    @Test
+    void blockAssociationDistinguishesOmissionFromClearingAndResolution() {
+        final var previous = new ItemCookingProperties(false, "test:block", false);
+        final var properties = new CompoundTag();
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", ignored -> null));
+        for (final Tag invalid : List.of(new ByteTag((byte) 1), new ShortTag((short) 1), new IntTag(1), new StringTag(""))) {
+            properties.put("block", invalid);
+            assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", ignored -> null));
+        }
+        properties.putString("block", "test:block");
+        assertEquals(previous, ItemCookingProperties.NONE.withComponentItemData(components, "test:block", block -> "test:block".equals(block) ? block : null));
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", ignored -> null));
+        properties.remove("block");
+        properties.putString("minecraft:block", "test:block");
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", ignored -> null));
+    }
+
+    @Test
+    void updatesRetainTheResolvedBlockIdentityAcrossDifferentItemDefinitions() {
+        final String first = "test:first_block";
+        final String second = "test:second_block";
+        final Set<String> blocks = Set.of(first, second);
+        final var properties = new CompoundTag();
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        properties.putString("block", first);
+        final var initial = ItemCookingProperties.NONE.withComponentItemData(components, "test:block", block -> blocks.contains(block) ? block : null);
+        properties.putString("block", second);
+        final var changed = initial.withComponentItemData(components, "test:block", block -> blocks.contains(block) ? block : null);
+
+        assertNotEquals(initial, changed);
+        assertEquals(first, initial.blockIdentifier());
+        assertEquals(second, changed.blockIdentifier());
+        assertEquals(initial.category(), changed.category());
+        properties.remove("block");
+        assertEquals(changed, changed.withComponentItemData(components, "test:block", block -> blocks.contains(block) ? block : null));
+        properties.putString("block", "test:unknown");
+        assertNull(changed.withComponentItemData(components, "test:block", block -> blocks.contains(block) ? block : null).blockIdentifier());
+
+        components.putString("minecraft:block", second);
+        final var legacy = initial.withLegacyItemData(components, block -> blocks.contains(block) ? block : null);
+        assertEquals(changed, legacy);
+        components.remove("minecraft:block");
+        assertEquals(legacy, legacy.withLegacyItemData(components, block -> blocks.contains(block) ? block : null));
+        components.put("minecraft:block", new IntTag(1));
+        assertNull(legacy.withLegacyItemData(components, block -> blocks.contains(block) ? block : null).blockIdentifier());
+    }
+
+    @Test
+    void bothReadersRetainTheRegisteredBlockRatherThanItsAlias() {
+        final Map<String, String> aliases = Map.of("minecraft:wool", "minecraft:white_wool");
+        final var components = new CompoundTag();
+        final var properties = new CompoundTag();
+        properties.putString("block", "minecraft:wool");
+        components.put("item_properties", properties);
+        components.putString("minecraft:block", "minecraft:wool");
+        final var expected = new ItemCookingProperties(false, "minecraft:white_wool", false);
+        assertEquals(expected, ItemCookingProperties.NONE.withComponentItemData(components, "test:block", aliases::get));
+        assertEquals(expected, ItemCookingProperties.NONE.withLegacyItemData(components, aliases::get));
+        properties.remove("block");
+        components.remove("minecraft:block");
+        assertEquals(expected, expected.withComponentItemData(components, "test:block", aliases::get));
+        assertEquals(expected, expected.withLegacyItemData(components, aliases::get));
+    }
+
+    @Test
+    void blockPlacerFlagsRequireValidBlockDataAndTheOwningItemName() {
+        final var previous = new ItemCookingProperties(false, null, true);
+        final var placer = new CompoundTag();
+        final var components = new CompoundTag();
+        components.put("minecraft:block_placer", placer);
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", block -> block));
+        placer.putString("block", "test:block");
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", block -> block));
+        for (final byte flag : new byte[]{1, -1, Byte.MIN_VALUE}) {
+            placer.putByte("replaceBlockItem", flag);
+            assertEquals(previous, ItemCookingProperties.NONE.withComponentItemData(components, "test:block", block -> block));
+        }
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:other", block -> block));
+        for (final Tag invalid : List.of(new ByteTag((byte) 0), new ShortTag((short) 1), new IntTag(1), new StringTag("1"))) {
+            placer.put("replaceBlockItem", invalid);
+            assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", block -> block));
+        }
+        placer.remove("replaceBlockItem");
+        placer.putByte("replace_block_item", (byte) 1);
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", block -> block));
+    }
+
+    @Test
+    void legacyDataUsesDirectBlockNamesAndRetainsFoodAcrossMissingUpdates() {
+        final var previous = new ItemCookingProperties(true, "test:block", false);
+        final var components = new CompoundTag();
+        final var properties = new CompoundTag();
+        properties.putString("block", "test:block");
+        components.put("item_properties", properties);
+        final var placer = new CompoundTag();
+        placer.putByte("replaceBlockItem", (byte) 1);
+        components.put("minecraft:block_placer", placer);
+        assertEquals(previous, previous.withLegacyItemData(components, ignored -> null));
+        for (final Tag invalid : List.of(new ByteTag((byte) 1), new IntTag(1), new CompoundTag(), new StringTag(""))) {
+            components.put("minecraft:block", invalid);
+            assertEquals(new ItemCookingProperties(true, null, false), previous.withLegacyItemData(components, ignored -> null));
+        }
+        components.putString("minecraft:block", "test:block");
+        assertEquals(new ItemCookingProperties(false, "test:block", false),
+                ItemCookingProperties.NONE.withLegacyItemData(components, block -> "test:block".equals(block) ? block : null));
+        components.put("minecraft:food", new CompoundTag());
+        assertTrue(ItemCookingProperties.NONE.withLegacyItemData(components, ignored -> null).food());
+        for (final Tag malformed : List.of(new ByteTag((byte) 1), new IntTag(1), new StringTag(""))) {
+            components.put("minecraft:food", malformed);
+            assertFalse(ItemCookingProperties.NONE.withLegacyItemData(components, ignored -> null).food());
+            assertTrue(previous.withLegacyItemData(components, ignored -> null).food());
+        }
+    }
+
+    @Test
+    void failedBlockPlacerSelectorReadsRetainFlagsAndStillBindTheUpdatedBlock() {
+        final var previous = new ItemCookingProperties(false, null, true);
+        final var placer = new CompoundTag();
+        placer.putString("block", "test:block");
+        placer.putInt("use_on", 1);
+        final var components = new CompoundTag();
+        components.put("minecraft:block_placer", placer);
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", block -> block));
+        placer.putString("block", "test:other");
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", block -> block));
+        placer.putString("block", "test:block");
+        final var descriptors = new ListTag<>(CompoundTag.class);
+        final var descriptor = new CompoundTag();
+        descriptor.putInt("name", 1);
+        descriptors.add(descriptor);
+        placer.put("use_on", descriptors);
+        assertEquals(previous, previous.withComponentItemData(components, "test:block", block -> block));
+        descriptor.remove("name");
+        assertEquals(ItemCookingProperties.NONE, previous.withComponentItemData(components, "test:block", block -> block));
+    }
+
+    @Test
+    void nativeConstructorDefaultsDoNotFollowRuntimeIdNamesOrFoodTags() {
+        assertEquals(new ItemCookingProperties(false, "minecraft:stone", false), BuiltinItemFactories.get("minecraft:stone").cooking());
+        assertEquals(new ItemCookingProperties(false, "minecraft:camera", false), BuiltinItemFactories.get("minecraft:item.camera").cooking());
+        assertEquals(ItemCookingProperties.NONE, BuiltinItemFactories.get("minecraft:camera").cooking());
+        assertEquals(ItemCookingProperties.NONE, BuiltinItemFactories.get("minecraft:copper_door").cooking());
+        assertEquals(ItemCookingProperties.NONE, BuiltinItemFactories.get("minecraft:apple").cooking());
+        assertNull(BuiltinItemFactories.get("minecraft:glow_berries"));
+        assertNull(BuiltinItemFactories.get("minecraft:red_shrub"));
+    }
+
+}
