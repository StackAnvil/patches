+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class ItemRegistryComponentUpdatesTest {
+
+    @Test
+    void matchesOriginalNonemptyReadersAndRetainedUpdatesAcrossRegistration() throws Exception {
+        final String path = System.getenv("STACKANVIL_NATIVE_REGISTRY_COMPONENTS");
+        assumeTrue(path != null && !path.isBlank(), "Native registry component corpus is optional");
+        try (var reader = new InputStreamReader(new GZIPInputStream(Files.newInputStream(Path.of(path))), StandardCharsets.UTF_8)) {
+            final JsonObject reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertEquals(ProtocolConstants.BEDROCK_PROTOCOL_VERSION, reference.get("protocol").getAsInt());
+            for (final JsonElement value : reference.getAsJsonArray("controls")) {
+                compare(value.getAsJsonObject());
+            }
+        }
+    }
+
+    private static void compare(final JsonObject control) {
+        final List<ItemEntry> entries = new ArrayList<>();
+        for (final JsonElement value : control.getAsJsonObject("input").getAsJsonArray("items")) {
+            final JsonObject row = value.getAsJsonObject();
+            final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+            try {
+                entries.add(new ItemEntry(row.get("name").getAsString(), row.get("id").getAsInt(), row.get("componentBased").getAsBoolean(),
+                        ItemVersion.getByValue(row.get("version").getAsInt()), (CompoundTag) BedrockTypes.TAG_LE.read(bytes)));
+                assertFalse(bytes.isReadable());
+            } finally {
+                bytes.release();
+            }
+        }
+        final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+        final Map<String, String> names = new HashMap<>();
+        final List<String> order = new ArrayList<>();
+        for (final JsonElement value : control.getAsJsonArray("ordinary")) {
+            final JsonObject row = value.getAsJsonObject();
+            final String name = row.get("storedName").getAsString();
+            names.put(row.get("item").getAsString(), name);
+            order.add(name);
+            final var definition = registry.definition(name);
+            assertNotNull(definition, name);
+            assertEquals(row.get("id").getAsInt(), definition.id(), name);
+        }
+        assertEquals(order, registry.definitions().stream().map(NativeItemDefinitions.Definition::identifier).toList());
+        for (final JsonElement value : control.getAsJsonArray("numeric")) {
+            final JsonObject row = value.getAsJsonObject();
+            final int id = row.get("key").getAsInt();
+            final String expected = row.get("item").isJsonNull() || (short) id == 0 || (short) id == -1
+                    ? null : names.get(row.get("item").getAsString());
+            assertEquals(expected, registry.identifier(id), () -> "Numeric owner: " + id);
+        }
+        for (final JsonElement value : control.getAsJsonArray("named")) {
+            final JsonObject row = value.getAsJsonObject();
+            final var selected = row.getAsJsonArray("selectedDefinitions");
+            final var lookup = registry.lookup(row.get("inputName").getAsString(), row.get("inputAux").getAsInt());
+            assertEquals(selected.isEmpty() ? null : selected.get(0).getAsJsonObject().get("storedName").getAsString(),
+                    lookup.definition() == null ? null : lookup.definition().identifier(), row::toString);
+            if (!selected.isEmpty()) {
+                assertEquals((int) selected.get(0).getAsJsonObject().get("aux").getAsLong(), lookup.auxiliary(), row::toString);
+            }
+        }
+        for (final JsonElement value : control.getAsJsonArray("properties")) {
+            compareProperties(value.getAsJsonObject(), registry);
+        }
+    }
+
+    private static void compareProperties(final JsonObject row, final ItemRegistry registry) {
+        final String name = row.get("name").getAsString();
+        final var properties = (ItemDefinitionProperties) registry.definition(name).receiver();
+        assertEquals(row.get("component").getAsBoolean(), properties.component(), name);
+        assertEquals(row.get("maximum").getAsInt(), properties.stacking().maximum(), name);
+        assertEquals(row.get("stackedByData").getAsBoolean(), properties.stacking().stackedByData(), name);
+        assertEquals(row.get("damageable").getAsBoolean(), properties.stacking().damageable(), name);
+        if (properties.stacking() instanceof LegacyItemStackingProperties legacy) {
+            assertEquals(row.get("maximumDamage").getAsInt(), (int) legacy.maximumDamage(), name);
+        }
+        assertEquals(row.get("food").getAsBoolean(), properties.cooking().food(), name);
+        assertEquals(nullableString(row.get("associatedBlock")), properties.cooking().blockIdentifier(), name);
+        assertEquals(nullableString(row.get("placerBlock")), properties.blockPlacer().blockIdentifier(), name);
+        final JsonElement flags = row.get("placerFlags");
+        assertEquals(!flags.isJsonNull() && flags.getAsJsonArray().get(0).getAsInt() != 0, properties.blockPlacer().canUseBlockAsIcon(), name);
+        assertEquals(!flags.isJsonNull() && flags.getAsJsonArray().get(1).getAsInt() != 0, properties.blockPlacer().replacementBlockItem(), name);
+        assertEquals(!flags.isJsonNull() && flags.getAsJsonArray().get(2).getAsInt() != 0, properties.blockPlacer().alignedPlacement(), name);
+    }
+
+    private static String nullableString(final JsonElement value) {
+        return value.isJsonNull() ? null : value.getAsString();
+    }
+
+}
