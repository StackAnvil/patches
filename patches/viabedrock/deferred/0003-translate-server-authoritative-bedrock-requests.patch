+
+    boolean queueInteraction(final QueuedInteraction interaction) {
+        if (this.recovery.isActive() || this.queuedInteractions.size() >= MAX_QUEUED_INTERACTIONS) {
+            this.queuedInteractions.clear();
+            return false;
+        }
+        this.queuedInteractions.addLast(interaction);
+        return true;
+    }
+
+    public void clearQueuedScreenInteractions() {
+        this.queuedInteractions.removeIf(QueuedInteraction::isScreenInteraction);
+        if (this.queuedInteractions.isEmpty()) {
+            this.pendingInventoryOpenClicks.clear();
+        } else {
+            this.pendingInventoryOpenClicks.discardClicks();
+        }
+    }
+
+    public void clearQueuedInteractions() {
+        this.queuedInteractions.clear();
+        this.pendingInventoryOpenClicks.clear();
+    }
+
+    public InventoryRequestStorage getRequest(final int requestId) {
+        return this.requests.get(requestId);
+    }
+
