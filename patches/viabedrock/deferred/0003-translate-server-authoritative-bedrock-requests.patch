+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class StonecutterContainer extends Container {
+
+    private List<CraftingDataStorage> availableRecipes = List.of();
+    private int selectedRecipe;
+
+    public StonecutterContainer(
+            final UserConnection user,
+            final byte containerId,
+            final TextComponent title,
+            final BlockPosition position) {
+        super(
+                user,
+                containerId,
+                ContainerType.STONECUTTER,
+                title,
+                position,
+                2,
+                "stonecutter_block",
+                "stonecutter");
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        return switch (slot) {
+            case 3 -> new FullContainerName(ContainerEnumName.StonecutterInputContainer, null);
+            case 50 ->
+                new FullContainerName(
+                            ContainerEnumName.StonecutterResultPreviewContainer, null);
+            default -> throw new IllegalArgumentException("Invalid stonecutter slot: " + slot);
+        };
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return slot == 3 ? 0 : slot == 50 ? 1 : super.javaSlot(slot);
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return slot == 0 ? 3 : slot == 1 ? 50 : super.bedrockSlot(slot);
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return this.javaSlot(slot);
+    }
+
+    @Override
+    public boolean handleClick(
+            final int revision,
+            final short javaSlot,
+            final byte button,
+            final ContainerInput action) {
+        if (javaSlot != 1) {
+            final boolean handled = super.handleClick(revision, javaSlot, button, action);
+            if (handled && javaSlot == 0) {
+                this.updateRecipes();
+                this.refreshOutput();
+            }
+            return handled;
+        }
+        if (action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE) {
+            return false;
+        }
+        if (action == ContainerInput.PICKUP && button != 0) {
+            return false;
+        }
+        this.updateRecipes();
+        if (this.availableRecipes.isEmpty()) {
+            return false;
+        }
+
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final InventoryContainer player = inventory.getInventoryContainer();
+        final boolean toInventory = action == ContainerInput.QUICK_MOVE;
+        if (!toInventory && !inventory.getHudContainer().getItem(0).isEmpty()) {
+            return false;
+        }
+        final int destination = toInventory ? firstEmptySlot(player) : 0;
+        if (destination < 0) {
+            return false;
+        }
+        final CraftingDataStorage recipe = this.availableRecipes.get(this.selectedRecipe);
+        final ShapelessRecipe shapeless = (ShapelessRecipe) recipe.recipe();
+        final BedrockItem input = this.getItem(3);
+        final BedrockItem result = shapeless.getResults().get(0);
+        final int amount = shapeless.getIngredients().get(0).amount();
+        if (input.netId() == null || input.amount() < amount || result.isEmpty()) {
+            return false;
+        }
+
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final FullContainerName targetName =
+                toInventory
+                        ? player.getFullContainerName(destination)
+                        : inventory.getHudContainer().getFullContainerName(0);
+        final List<ItemStackRequestAction> actions =
+                List.of(
+                        new ItemStackRequestAction.CraftRecipeAction(recipe.networkId(), 1),
+                        new ItemStackRequestAction.ConsumeAction(
+                                amount,
+                                new ItemStackRequestSlotInfo(
+                                        this.getFullContainerName(3), (byte) 3, input.netId())),
+                        new ItemStackRequestAction.PlaceAction(
+                                result.amount(),
+                                new ItemStackRequestSlotInfo(
+                                        new FullContainerName(
+                                                ContainerEnumName.CreatedOutputContainer, null),
+                                        (byte) 50,
+                                        requestId),
+                                new ItemStackRequestSlotInfo(targetName, (byte) destination, 0)));
+        final ItemStackRequestInfo request =
+                new ItemStackRequestInfo(
+                        requestId, actions, List.of(), TextProcessingEventOrigin.unknown);
+        final List<Container> snapshots =
+                toInventory ? List.of(this.copy(), player.copy()) : List.of(this.copy());
+        requests.addRequest(
+                new InventoryRequestStorage(
+                        request, revision, inventory.getHudContainer().copy(), snapshots));
+        this.setItem(3, this.itemAfterRemovingAmount(input, amount));
+        if (toInventory) {
+            player.setItem(destination, result.copy());
+        } else {
+            inventory.getHudContainer().setItem(0, result.copy());
+        }
+        this.updateRecipes();
+        this.refreshOutput();
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    @Override
+    public boolean handleButtonClick(final int button) {
+        this.updateRecipes();
+        if (button < 0 || button >= this.availableRecipes.size()) {
+            return false;
+        }
+        this.selectedRecipe = button;
+        this.refreshOutput();
+        return true;
+    }
+
+    private void updateRecipes() {
+        final BedrockItem input = this.getItem(3);
+        final List<CraftingDataStorage> matches = new ArrayList<>();
+        for (final CraftingDataStorage data : this.user.get(CraftingDataTracker.class).getCraftingDataList()) {
+            if (!(data.recipe() instanceof ShapelessRecipe recipe)
+                    || !"stonecutter".equals(recipe.getRecipeTag())
+                    || recipe.getIngredients().size() != 1
+                    || recipe.getResults().isEmpty()) {
+                continue;
+            }
+            if (recipe.getIngredients().get(0).matchesItem(this.user, input)
+                    && input.amount() >= recipe.getIngredients().get(0).amount()) {
+                matches.add(data);
+            }
+        }
+        this.availableRecipes = List.copyOf(matches);
+        if (this.selectedRecipe >= this.availableRecipes.size()) {
+            this.selectedRecipe = 0;
+        }
+    }
+
+    private void refreshOutput() {
+        final BedrockItem result =
+                this.availableRecipes.isEmpty()
+                        ? BedrockItem.empty()
+                        : ((ShapelessRecipe)
+                                        this.availableRecipes.get(this.selectedRecipe).recipe())
+                                .getResults()
+                                .get(0)
+                                .copy();
+        this.setItem(50, result);
+        PacketFactory.sendJavaContainerSetContent(this.user, this);
+    }
+
+    private static int firstEmptySlot(final InventoryContainer inventory) {
+        for (int slot = 9; slot < inventory.size(); slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        for (int slot = 0; slot < 9; slot++) {
+            if (inventory.getItem(slot).isEmpty()) {
+                return slot;
+            }
+        }
+        return -1;
+    }
+
+}
