+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class LegacyItemStackingPropertiesTest {
+
+    @Test
+    void independentScalarUpdatesPreserveAbsentFieldsAndClearWrongTypes() {
+        final var update = new CompoundTag();
+        update.putInt("minecraft:max_stack_size", 16);
+        update.putByte("minecraft:stacked_by_data", (byte) 1);
+        update.putInt("minecraft:max_damage", 64);
+        final var initial = LegacyItemStackingProperties.DEFAULT.withComponentData(update);
+        assertEquals(new LegacyItemStackingProperties(16, true, (short) 64), initial);
+        assertEquals(initial, initial.withComponentData(new CompoundTag()));
+        update.getValue().clear();
+        update.put("item_properties", new CompoundTag());
+        update.put("minecraft:durability", new CompoundTag());
+        assertEquals(initial, initial.withComponentData(update));
+        update.put("minecraft:max_stack_size", new CompoundTag());
+        update.putInt("minecraft:stacked_by_data", 1);
+        update.putByte("minecraft:max_damage", (byte) 64);
+        final var cleared = initial.withComponentData(update);
+        assertEquals(new LegacyItemStackingProperties(0, false, (short) 0), cleared);
+        assertFalse(cleared.damageable());
+    }
+
+    @Test
+    void maximumDamageUsesSignedLowWordsAndCanBecomeNondamageableAgain() {
+        final var update = new CompoundTag();
+        update.putInt("minecraft:max_damage", 65537);
+        var properties = LegacyItemStackingProperties.DEFAULT.withComponentData(update);
+        assertEquals(1, properties.maximumDamage());
+        assertTrue(properties.damageable());
+        update.putInt("minecraft:max_damage", 32768);
+        properties = properties.withComponentData(update);
+        assertEquals(Short.MIN_VALUE, properties.maximumDamage());
+        assertFalse(properties.damageable());
+        update.putInt("minecraft:max_damage", -1);
+        properties = properties.withComponentData(update);
+        assertEquals(-1, properties.maximumDamage());
+        assertFalse(properties.damageable());
+        assertEquals(properties, properties.withComponentData(new CompoundTag()));
+    }
+
+    @Test
+    void propertiesMatchCompleteNativeTypedLoadsAndStatefulUpdates() throws Exception {
+        final String reference = System.getenv("STACKANVIL_LEGACY_STACKING_PROPERTIES_REFERENCE");
+        assumeTrue(reference != null);
+        int compared = 0;
+        try (var input = Files.newBufferedReader(Path.of(reference))) {
+            final var root = JsonParser.parseReader(input).getAsJsonObject();
+            for (final var entry : root.getAsJsonArray("cases")) {
+                final var row = entry.getAsJsonObject();
+                assertProperties(LegacyItemStackingProperties.DEFAULT.withComponentData(decode(row.get("nbtHex").getAsString())), row.getAsJsonObject("native"));
+                compared++;
+            }
+            var properties = LegacyItemStackingProperties.DEFAULT;
+            for (final var entry : root.getAsJsonArray("sequence")) {
+                final var row = entry.getAsJsonObject();
+                properties = properties.withComponentData(decode(row.get("nbtHex").getAsString()));
+                assertProperties(properties, row.getAsJsonObject("native"));
+                compared++;
+            }
+        }
+        assertTrue(compared > 0);
+    }
+
+    private static void assertProperties(final LegacyItemStackingProperties properties, final JsonObject nativeState) {
+        assertEquals(nativeState.get("maximum").getAsInt(), properties.maximum(), nativeState::toString);
+        assertEquals(nativeState.get("stackedByData").getAsBoolean(), properties.stackedByData(), nativeState::toString);
+        assertEquals(nativeState.get("maximumDamageWord").getAsInt(), Short.toUnsignedInt(properties.maximumDamage()), nativeState::toString);
+        assertEquals(nativeState.get("damageable").getAsBoolean(), properties.damageable(), nativeState::toString);
+    }
+
+    private static CompoundTag decode(final String encoded) {
+        final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(encoded));
+        try {
+            final var tag = (CompoundTag) BedrockTypes.TAG_LE.read(buffer);
+            assertFalse(buffer.isReadable());
+            return tag;
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
