+import static org.mockito.Mockito.*;
+
+final class NativeContainerActionBackendTest {
+
+    @Test
+    void waitsForCurrentItemsAndNeverBlocksLegacyOrReusedMenus() {
+        final var user = mock(UserConnection.class);
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        when(user.get(any())).thenAnswer(call -> stores.get(call.getArgument(0)));
+        final var tracker = new InventoryTracker(user);
+        final var requests = new InventoryRequestTracker(user);
+        final var state = new NativeContainerUiState();
+        final var game = mock(GameSessionStorage.class);
+        stores.put(InventoryTracker.class, tracker);
+        stores.put(InventoryRequestTracker.class, requests);
+        stores.put(NativeContainerUiState.class, state);
+        stores.put(GameSessionStorage.class, game);
+        when(game.isInventoryServerAuthoritative()).thenReturn(true);
+        final var menu = new ChestContainer(user, (byte) 6, null, null, 27);
+        tracker.setCurrentContainer(menu);
+        final var ui = program();
+        final var title = new ContainerUi.Title("Actual", false);
+        final var message = state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS, title, ui,
+                value -> net.raphimc.viabedrock.api.model.container.NativeContainerActionBackend.create(user, value));
+        assertNotNull(message);
+        final var activate = new NativeContainerAction(6, message.sequence(), 0, NativeContainerAction.Mode.ACTIVATE, -1);
+        assertFalse(state.handleAction(activate));
+        assertFalse(state.blocksVanillaClicks());
+        requests.setPredictingClick(true);
+        menu.setItem(9, named());
+        requests.setPredictingClick(false);
+        assertTrue(state.handleAction(activate));
+        assertTrue(state.blocksVanillaClicks());
+        when(game.isInventoryServerAuthoritative()).thenReturn(false);
+        assertFalse(state.handleAction(activate));
+        assertFalse(state.blocksVanillaClicks());
+        assertNull(state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS, title, ui,
+                value -> net.raphimc.viabedrock.api.model.container.NativeContainerActionBackend.create(user, value)));
+        when(game.isInventoryServerAuthoritative()).thenReturn(true);
+        final var reopened = state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS, title, ui,
+                value -> net.raphimc.viabedrock.api.model.container.NativeContainerActionBackend.create(user, value));
+        assertNotNull(reopened);
+        assertFalse(state.handleAction(activate));
+        assertTrue(state.handleAction(new NativeContainerAction(6, reopened.sequence(), 0, NativeContainerAction.Mode.ACTIVATE, -1)));
+        tracker.setCurrentContainerClosed(false);
+        tracker.setCurrentContainer(new ChestContainer(user, (byte) 6, null, null, 27));
+        assertFalse(state.handleAction(new NativeContainerAction(6, reopened.sequence(), 0, NativeContainerAction.Mode.ACTIVATE, -1)));
+        assertFalse(state.blocksVanillaClicks());
+    }
+
+    private static BedrockItem named() {
+        final var display = new CompoundTag();
+        display.putString("Name", "Action");
+        final var tag = new CompoundTag();
+        tag.put("display", display);
+        final var item = new BedrockItem(1);
+        item.setAmount(4);
+        item.setNetId(1009);
+        item.setTag(tag);
+        return item;
+    }
+
+    private static ContainerUi program() {
+        return ContainerUi.fromProgram(JsonParser.parseString("""
+                {"definitions": {
+                  "chest.small_chest_screen": {"parent":"", "value":{"$screen_content":"chest.small_chest_panel"}},
+                  "chest.small_chest_panel": {"parent":"", "value":{"type":"grid", "collection_name":"container_items",
+                    "grid_dimensions":[27,1], "controls":[{"action":{"type":"button", "grid_position":[9,0],
+                      "bindings":[
+                        {"binding_type":"collection", "binding_collection_name":"container_items", "binding_name":"#hover_text", "binding_name_override":"#caption"},
+                        {"binding_type":"view", "source_property_name":"(not (#caption = ''))", "target_property_name":"#visible"}],
+                      "button_mappings":[{"from_button_id":"button.menu_select", "to_button_id":"button.container_auto_place_one", "mapping_type":"pressed"}]}}]}}
+                }}
+                """).getAsJsonObject());
+    }
+
+}
