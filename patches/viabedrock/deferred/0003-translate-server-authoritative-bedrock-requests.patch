+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenClose;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerInventoryScreenCodecTest {
+
+    @Test
+    void roundTripsOpeningIdentityAndRejectsTruncatedOrTrailingRequests() {
+        for (final long opening : new long[]{1, 127, 128, Integer.MAX_VALUE, Long.MAX_VALUE}) {
+            for (final boolean open : new boolean[]{false, true}) {
+                final var request = new PlayerInventoryScreenRequest(opening, open);
+                final var buffer = Unpooled.buffer();
+                try {
+                    PlayerInventoryScreenRequest.TYPE.write(buffer, request);
+                    final int size = buffer.readableBytes();
+                    for (int length = 0; length < size; length++) {
+                        final var truncated = buffer.slice(0, length);
+                        assertThrows(RuntimeException.class, () -> PlayerInventoryScreenRequest.TYPE.read(truncated));
+                    }
+                    assertEquals(request, PlayerInventoryScreenRequest.TYPE.read(buffer));
+                    buffer.clear();
+                    PlayerInventoryScreenRequest.TYPE.write(buffer, request);
+                    buffer.writeByte(0);
+                    assertThrows(IllegalArgumentException.class, () -> PlayerInventoryScreenRequest.TYPE.read(buffer));
+                    buffer.clear();
+                    final var close = new PlayerInventoryScreenClose(opening);
+                    PlayerInventoryScreenClose.TYPE.write(buffer, close);
+                    assertEquals(close, PlayerInventoryScreenClose.TYPE.read(buffer));
+                } finally {
+                    buffer.release();
+                }
+            }
+        }
+    }
+
+    @Test
+    void rejectsUnsupportedVersionsInvalidIdentitiesAndNonBooleanFlags() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (final int version : new int[]{0, 2}) {
+                Types.VAR_INT.writePrimitive(buffer, version);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                Types.VAR_LONG.writePrimitive(buffer, 1);
+                buffer.writeByte(1);
+                assertThrows(IllegalArgumentException.class, () -> PlayerInventoryScreenRequest.TYPE.read(buffer));
+                buffer.clear();
+            }
+            for (final long opening : new long[]{0, -1}) {
+                assertThrows(IllegalArgumentException.class, () -> new PlayerInventoryScreenRequest(opening, true));
+                assertThrows(IllegalArgumentException.class, () -> new PlayerInventoryScreenClose(opening));
+            }
+            PlayerInventoryScreenRequest.TYPE.write(buffer, new PlayerInventoryScreenRequest(1, true));
+            buffer.setByte(buffer.writerIndex() - 1, 2);
+            assertThrows(IllegalArgumentException.class, () -> PlayerInventoryScreenRequest.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
