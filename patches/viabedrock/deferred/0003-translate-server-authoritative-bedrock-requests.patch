@@ -0,0 +1,172 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.NativeItemDefinitions;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+
+/** Resolved native descriptor values. Registry queries remain live for alias enumeration. */
+public sealed interface NativeRecipeDescriptor permits NativeRecipeDescriptor.Empty, NativeRecipeDescriptor.Ordinary,
+        NativeRecipeDescriptor.ComplexAlias, NativeRecipeDescriptor.Deferred {
+
+    static NativeRecipeDescriptor resolveName(final String name, final int auxiliary, final Registry registry) {
+        if (name.isEmpty()) {
+            return Empty.INSTANCE;
+        }
+        final short requested = (short) auxiliary;
+        if (requested == Short.MAX_VALUE && registry.hasComplexAlias(name)) {
+            return new ComplexAlias(name, registry.aliasRepresentative(name));
+        }
+        final Lookup lookup = registry.lookupItem(name, requested);
+        if (lookup == null || lookup.item == null) {
+            final NativeItemDefinitions.Definition<?> fallback = registry.fallbackBlockItem(name);
+            return fallback == null ? Empty.INSTANCE : new Ordinary(fallback, Short.MAX_VALUE);
+        }
+        final short resolved = (short) lookup.auxiliary;
+        if (resolved != Short.MAX_VALUE && registry.hasAssociatedBlock(lookup.item)
+                && registry.blockState(lookup.item, resolved) == null) {
+            return Empty.INSTANCE;
+        }
+        return new Ordinary(lookup.item, (short) Math.max(0, resolved));
+    }
+
+    boolean isEmpty(Registry registry);
+
+    /** Match the default concrete descriptor produced from a source stack after native source guards. */
+    default boolean matchesSource(final BedrockItem source, final Registry registry,
+                                  final Function<BedrockItem, ItemRecipeKey> descriptor) {
+        if (!RecipeIngredientMatcher.eligible(source)) {
+            return false;
+        }
+        return this.matchesStack(source, registry, descriptor);
+    }
+
+    /** Compare constructed descriptors independently of the caller's recipe-source admission. */
+    default boolean matchesStack(final BedrockItem source, final Registry registry,
+                                 final Function<BedrockItem, ItemRecipeKey> descriptor) {
+        final ItemRecipeKey candidate = descriptor.apply(source);
+        return this.matchesCandidate(candidate, source.tag() != null, registry);
+    }
+
+    private boolean matchesCandidate(final ItemRecipeKey candidate, final boolean userdata, final Registry registry) {
+        return switch (this) {
+            case Empty _ -> candidate == null && !userdata;
+            case Deferred deferred -> deferred.value(registry).matchesCandidate(candidate, userdata, registry);
+            case Ordinary ordinary -> candidate != null && candidate.matches(ordinary.key(), auxiliary -> registry.hasAssociatedBlock(ordinary.item)
+                    ? registry.blockState(ordinary.item, (short) auxiliary) : null);
+            case ComplexAlias alias -> {
+                if (candidate == null) {
+                    yield false;
+                }
+                boolean matched = false;
+                for (final String member : registry.aliasMembers(alias.name)) {
+                    final NativeItemDefinitions.Definition<?> item = registry.aliasMember(member);
+                    if (item != null && (item.id() & 0xFFFF) == candidate.identifier()) {
+                        matched = true;
+                        break;
+                    }
+                }
+                yield matched;
+            }
+        };
+    }
+
+    /** These are native registry/block interfaces, not a fallback policy for unavailable data. */
+    interface Registry {
+        boolean hasComplexAlias(String name);
+
+        Lookup lookupItem(String name, short auxiliary);
+
+        NativeItemDefinitions.Definition<?> fallbackBlockItem(String name);
+
+        boolean hasAssociatedBlock(NativeItemDefinitions.Definition<?> item);
+
+        Object blockState(NativeItemDefinitions.Definition<?> item, short auxiliary);
+
+        NativeItemDefinitions.Definition<?> aliasRepresentative(String name);
+
+        List<String> aliasMembers(String name);
+
+        NativeItemDefinitions.Definition<?> aliasMember(String name);
+    }
+
+    record Lookup(NativeItemDefinitions.Definition<?> item, int auxiliary) { }
+
+    /** Each native ingredient position owns its deferred value and retains the first resolution. */
+    final class Deferred implements NativeRecipeDescriptor {
+        private final String name;
+        private final short auxiliary;
+        private NativeRecipeDescriptor resolved;
+
+        public Deferred(final String name, final int auxiliary) {
+            this.name = Objects.requireNonNull(name);
+            this.auxiliary = (short) auxiliary;
+        }
+
+        private NativeRecipeDescriptor value(final Registry registry) {
+            if (this.resolved == null) {
+                this.resolved = resolveName(this.name, this.auxiliary, registry);
+            }
+            return this.resolved;
+        }
+
+        @Override
+        public boolean isEmpty(final Registry registry) {
+            return this.value(registry).isEmpty(registry);
+        }
+    }
+
+    enum Empty implements NativeRecipeDescriptor {
+        INSTANCE;
+
+        @Override
+        public boolean isEmpty(final Registry registry) {
+            return true;
+        }
+    }
+
+    record Ordinary(NativeItemDefinitions.Definition<?> item, short auxiliary) implements NativeRecipeDescriptor {
+        public Ordinary {
+            Objects.requireNonNull(item);
+            if (auxiliary < 0) {
+                throw new IllegalArgumentException("Resolved descriptor auxiliary must be nonnegative");
+            }
+        }
+
+        public ItemRecipeKey key() {
+            return new ItemRecipeKey(this.item.id() & 0xFFFF, this.auxiliary);
+        }
+
+        @Override
+        public boolean isEmpty(final Registry registry) {
+            return this.item.identifier().equals("minecraft:air");
+        }
+    }
+
+    /** The representative is retained for presentation. Membership controls emptiness and matching. */
+    record ComplexAlias(String name, NativeItemDefinitions.Definition<?> representative) implements NativeRecipeDescriptor {
+        public ComplexAlias {
+            Objects.requireNonNull(name);
+        }
+
+        @Override
+        public boolean isEmpty(final Registry registry) {
+            for (final String member : registry.aliasMembers(this.name)) {
+                final NativeItemDefinitions.Definition<?> item = registry.aliasMember(member);
+                if (item != null && !item.identifier().equals("minecraft:air")) {
+                    return false;
+                }
+            }
+            return true;
+        }
+    }
+
+}
