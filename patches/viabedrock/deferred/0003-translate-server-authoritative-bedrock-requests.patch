+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ItemEquipmentTest {
+
+    @Test
+    void admissionUsesConstructedFactoriesRatherThanNameSuffixesOrArmorStatistics() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:fake_helmet", 30010, false, ItemVersion.Legacy, null)});
+        assertNull(registry.armorSlot(item(registry, "test:fake_helmet")));
+        assertNull(registry.armorSlot(item(registry, "minecraft:pumpkin")));
+        assertNull(registry.armorSlot(item(registry, "minecraft:shield")));
+        assertEquals(0, registry.armorSlot(item(registry, "minecraft:diamond_helmet")));
+        assertEquals(1, registry.armorSlot(item(registry, "minecraft:elytra")));
+        assertEquals(2, registry.armorSlot(item(registry, "minecraft:copper_leggings")));
+        assertEquals(3, registry.armorSlot(item(registry, "minecraft:leather_boots")));
+        assertEquals(0, registry.armorSlot(item(registry, "minecraft:carved_pumpkin")));
+    }
+
+    @Test
+    void retainedDefinitionsKeepEquipmentIdentityAcrossNumericCollisionsAndCopies() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:armor_collision", 350, false, ItemVersion.Legacy, null)});
+        final var armor = item(registry, "minecraft:diamond_helmet");
+        final var ordinary = item(registry, "test:armor_collision");
+        assertEquals(armor.identifier(), ordinary.identifier());
+        assertEquals(0, registry.armorSlot(armor.copy()));
+        assertNull(registry.armorSlot(ordinary.copy()));
+    }
+
+    @Test
+    void headAdmissionFollowsTheDefinitionsCompiledBlockAssociation() {
+        final var components = new CompoundTag();
+        components.putString("minecraft:block", "minecraft:skeleton_skull");
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:head", 30010, false, ItemVersion.Legacy, data)});
+        final var stack = item(registry, "test:head");
+        assertEquals(0, registry.armorSlot(stack));
+        stack.setBlockRuntimeId(1234);
+        assertEquals(0, registry.armorSlot(stack));
+        final var apple = item(registry, "minecraft:apple");
+        apple.setBlockRuntimeId(1234);
+        assertNull(registry.armorSlot(apple));
+    }
+
+    @Test
+    void wearableReadersRetainOmittedAndMistypedUpdatesButHonorValidSlotChanges() {
+        final var wearable = new CompoundTag();
+        wearable.putString("slot", "SLOT.ARMOR.HEAD");
+        final var components = new CompoundTag();
+        components.put("minecraft:wearable", wearable);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var initial = new ItemEntry("test:wearable", 30010, true, ItemVersion.DataDriven, data);
+        wearable.remove("slot");
+        final var empty = new ItemEntry("test:wearable", 30010, true, ItemVersion.DataDriven, data);
+        wearable.putInt("slot", 5);
+        final var wrongType = new ItemEntry("test:wearable", 30010, true, ItemVersion.DataDriven, data);
+        final var retained = new ItemRegistry(new ItemEntry[]{initial, empty, wrongType});
+        assertEquals(0, retained.armorSlot(item(retained, "test:wearable")));
+        final var missing = new ItemRegistry(new ItemEntry[]{wrongType});
+        assertNull(missing.armorSlot(item(missing, "test:wearable")));
+        for (final String invalid : new String[]{"slot.none", "", " slot.armor.head", "slot.armor.head\0suffix"}) {
+            wearable.putString("slot", invalid);
+            final var update = new ItemEntry("test:wearable", 30010, true, ItemVersion.DataDriven, data);
+            final var unchanged = new ItemRegistry(new ItemEntry[]{initial, update});
+            assertEquals(0, unchanged.armorSlot(item(unchanged, "test:wearable")));
+        }
+        wearable.putString("slot", "slot.armor.feet");
+        final var changed = new ItemEntry("test:wearable", 30010, true, ItemVersion.DataDriven, data);
+        final var updated = new ItemRegistry(new ItemEntry[]{initial, changed});
+        assertEquals(3, updated.armorSlot(item(updated, "test:wearable")));
+        final var unread = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:wearable", 30010, true, ItemVersion.None, data)});
+        assertNull(unread.armorSlot(item(unread, "test:wearable")));
+    }
+
+    @Test
+    void offhandAdmissionRetainsTheSelectedDefinitionAcrossCopiesAndIdCollisions() {
+        final var enabled = offhandEntry("test:offhand_enabled", true);
+        final var disabled = offhandEntry("test:offhand_disabled", false);
+        final var registry = new ItemRegistry(new ItemEntry[]{enabled, disabled});
+        final var first = item(registry, enabled.identifier());
+        final var second = item(registry, disabled.identifier());
+        assertEquals(first.identifier(), second.identifier());
+        assertTrue(registry.allowsOffhand(first.copy()));
+        assertFalse(registry.allowsOffhand(second.copy()));
+        assertFalse(registry.allowsOffhand(item(registry, "minecraft:apple")));
+    }
+
+    @Test
+    void offhandReadersRetainOmittedPropertiesAndResetMissingOrMistypedByteFields() {
+        final var initial = offhandEntry("test:offhand_update", true);
+        final var omitted = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, new CompoundTag());
+        var registry = new ItemRegistry(new ItemEntry[]{initial, omitted});
+        assertTrue(registry.allowsOffhand(item(registry, initial.identifier())));
+        final var data = new CompoundTag();
+        final var components = new CompoundTag();
+        final var properties = new CompoundTag();
+        data.put("components", components);
+        components.put("item_properties", properties);
+        for (final int value : new int[]{2, 255}) {
+            properties.putByte("allow_off_hand", (byte) value);
+            final var update = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+            registry = new ItemRegistry(new ItemEntry[]{initial, update});
+            assertTrue(registry.allowsOffhand(item(registry, initial.identifier())));
+        }
+        properties.putInt("allow_off_hand", 1);
+        final var mistyped = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        properties.remove("allow_off_hand");
+        final var missing = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        for (final var update : new ItemEntry[]{mistyped, missing}) {
+            registry = new ItemRegistry(new ItemEntry[]{initial, update});
+            assertFalse(registry.allowsOffhand(item(registry, initial.identifier())));
+        }
+        final var unread = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.None, initial.componentData());
+        registry = new ItemRegistry(new ItemEntry[]{unread});
+        assertFalse(registry.allowsOffhand(item(registry, initial.identifier())));
+    }
+
+    @Test
+    void installedOffhandComponentsRetainTypedStateAndOverrideCommonProperties() {
+        final var data = new CompoundTag();
+        final var components = new CompoundTag();
+        final var allow = new CompoundTag();
+        data.put("components", components);
+        components.put("minecraft:allow_off_hand", allow);
+        allow.putByte("value", (byte) 1);
+        final var initial = new ItemEntry("test:offhand_component", 31099, true, ItemVersion.DataDriven, data);
+        allow.putInt("value", 0);
+        components.put("item_properties", new CompoundTag());
+        final var mistyped = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        var registry = new ItemRegistry(new ItemEntry[]{initial, mistyped});
+        assertTrue(registry.allowsOffhand(item(registry, initial.identifier())));
+        allow.putByte("value", (byte) 0);
+        final var disabled = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        registry = new ItemRegistry(new ItemEntry[]{initial, disabled});
+        assertFalse(registry.allowsOffhand(item(registry, initial.identifier())));
+    }
+
+    @Test
+    void retainedWearablesFinalizeOffhandPermissionAndArmorCapacity() {
+        final var data = new CompoundTag();
+        final var components = new CompoundTag();
+        final var wearable = new CompoundTag();
+        final var allow = new CompoundTag();
+        data.put("components", components);
+        components.put("minecraft:wearable", wearable);
+        components.put("minecraft:allow_off_hand", allow);
+        allow.putByte("value", (byte) 0);
+        wearable.putString("slot", "slot.weapon.offhand");
+        final var initial = new ItemEntry("test:wearable_capacity", 31099, true, ItemVersion.DataDriven, data);
+        var registry = new ItemRegistry(new ItemEntry[]{initial});
+        assertTrue(registry.allowsOffhand(item(registry, initial.identifier())));
+        wearable.putString("slot", "slot.armor.head");
+        final var head = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        registry = new ItemRegistry(new ItemEntry[]{initial, head});
+        final var stack = item(registry, initial.identifier());
+        assertFalse(registry.allowsOffhand(stack));
+        assertEquals(1, registry.stackingProperties(stack).maximum());
+        final var maximum = new CompoundTag();
+        maximum.putByte("value", (byte) 64);
+        components.put("minecraft:max_stack_size", maximum);
+        final var explicit = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, data);
+        final var omitted = new ItemEntry(initial.identifier(), initial.id(), true, ItemVersion.DataDriven, new CompoundTag());
+        registry = new ItemRegistry(new ItemEntry[]{initial, head, explicit, omitted});
+        assertEquals(64, registry.stackingProperties(item(registry, initial.identifier())).maximum());
+    }
+
+    private static ItemEntry offhandEntry(final String name, final boolean enabled) {
+        final var properties = new CompoundTag();
+        properties.putByte("allow_off_hand", (byte) (enabled ? 1 : 0));
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        return new ItemEntry(name, 31099, true, ItemVersion.DataDriven, data);
+    }
+
+    private static BedrockItem item(final ItemRegistry registry, final String name) {
+        return new BedrockItem(registry.definition(name), (short) 0, (byte) 1);
+    }
+
+}
