+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.NativeItemStacking;
+import net.raphimc.viabedrock.api.model.container.NativeItemStackMatcher;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Set;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class CanonicalNetworkStackTest {
+
+    @Test
+    void retainsOriginalCanonicalDefinitionsAndTheirPropertiesAfterNumericCollisions() throws Exception {
+        final String path = System.getenv("STACKANVIL_NATIVE_CANONICAL_STACKS");
+        assumeTrue(path != null && !path.isBlank(), "Native canonical stack corpus is optional");
+        try (var reader = new InputStreamReader(new GZIPInputStream(Files.newInputStream(Path.of(path))), StandardCharsets.UTF_8)) {
+            final JsonObject reference = JsonParser.parseReader(reader).getAsJsonObject();
+            assertEquals(ProtocolConstants.BEDROCK_PROTOCOL_VERSION, reference.get("protocol").getAsInt());
+            final List<ItemEntry> entries = new ArrayList<>();
+            for (final JsonElement value : reference.getAsJsonObject("input").getAsJsonArray("items")) {
+                final JsonObject row = value.getAsJsonObject();
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+                try {
+                    entries.add(new ItemEntry(row.get("name").getAsString(), row.get("id").getAsInt(), row.get("componentBased").getAsBoolean(),
+                            ItemVersion.getByValue(row.get("version").getAsInt()), (CompoundTag) BedrockTypes.TAG_LE.read(bytes)));
+                    assertFalse(bytes.isReadable());
+                } finally {
+                    bytes.release();
+                }
+            }
+            final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+            int compared = 0;
+            for (final JsonElement value : reference.getAsJsonArray("rows")) {
+                final JsonObject row = value.getAsJsonObject();
+                final int id = row.get("inputId").getAsInt();
+                // This regression covers actual no-associated-block inputs. The full palette control covers Block construction.
+                if (registry.associatedBlock(registry.definition(id)) != null) {
+                    continue;
+                }
+                final var item = construct(registry, id, row.get("inputAux").getAsShort(),
+                        (byte) Math.max(0, row.get("inputCount").getAsShort()));
+                assertTrue(row.get("blockState").isJsonNull(), row::toString);
+                compareHeader(row, item, registry);
+                compared++;
+            }
+            assertTrue(compared > 100);
+            assertFalse(reference.getAsJsonArray("pairs").isEmpty());
+            for (final JsonElement value : reference.getAsJsonArray("pairs")) {
+                final JsonObject row = value.getAsJsonObject();
+                final var leftInput = row.getAsJsonArray("leftInput");
+                final var rightInput = row.getAsJsonArray("rightInput");
+                final var left = construct(registry, leftInput.get(0).getAsInt(), leftInput.get(1).getAsShort(), (byte) 1);
+                final var right = construct(registry, rightInput.get(0).getAsInt(), rightInput.get(1).getAsShort(), (byte) 1);
+                compareHeader(row.getAsJsonObject("left"), left, registry);
+                compareHeader(row.getAsJsonObject("right"), right, registry);
+                assertEquals(row.get("sameDefinition").getAsBoolean(), registry.sameDefinition(left, right), row::toString);
+                assertEquals(row.get("matches").getAsBoolean(), registry.sameItem(left, right)
+                        && NativeItemStackMatcher.matches(left, right, ignored -> null, ignored -> Set.of()), row::toString);
+                assertEquals(row.get("canMerge").getAsBoolean(), registry.sameDefinition(left, right)
+                        && NativeItemStacking.canMerge(left, right, registry.stackingProperties(right), BedrockItem::data, ignored -> Set.of()), row::toString);
+                for (final var side : List.of("left", "right")) {
+                    final var properties = registry.stackingProperties(side.equals("left") ? left : right);
+                    final var expected = row.getAsJsonObject(side + "Properties");
+                    assertEquals(expected.get("maximum").getAsInt(), properties.maximum(), row::toString);
+                    assertEquals(expected.get("stackedByData").getAsBoolean(), properties.stackedByData(), row::toString);
+                }
+            }
+        }
+    }
+
+    private static BedrockItem construct(final ItemRegistry registry, final int id, final short auxiliary, final byte amount) {
+        return registry.createNetworkItem(id, auxiliary, amount, null, (definition, metadata) -> {
+            assertNull(registry.associatedBlock(definition));
+            return null;
+        });
+    }
+
+    private static void compareHeader(final JsonObject expected, final BedrockItem item, final ItemRegistry registry) {
+        assertEquals(expected.get("storedName").isJsonNull() ? null : expected.get("storedName").getAsString(),
+                registry.identifier(item), expected::toString);
+        assertEquals(expected.get("id").isJsonNull() ? 0 : expected.get("id").getAsInt(), item.identifier(), expected::toString);
+        assertEquals(expected.get("aux").getAsInt(), (int) item.data(), expected::toString);
+        assertEquals(expected.get("quantity").getAsInt(), item.amount(), expected::toString);
+    }
+
+}
