+    private static void swapOffhand(final PacketWrapper wrapper) {
+        final InventoryTracker inventory = wrapper.user().get(InventoryTracker.class);
+        final InventoryContainer hotbar = inventory.getInventoryContainer();
+        final OffhandContainer offhand = inventory.getOffhandContainer();
+        final int slot = Byte.toUnsignedInt(hotbar.getSelectedHotbarSlot());
+        final BedrockItem held = hotbar.getItem(slot);
+        final BedrockItem equipped = offhand.getItem(0);
+        if (held.isEmpty() && equipped.isEmpty()) {
+            return;
+        }
+
+        final BedrockInventoryTransaction transaction = new BedrockInventoryTransaction(
+                0, null,
+                List.of(
+                        new InventoryActionData(
+                                new InventorySource(InventorySourceType.Container_Inventory, ContainerID.CONTAINER_ID_INVENTORY.getValue(), InventorySourceFlags.No_Flag),
+                                slot, held, equipped),
+                        new InventoryActionData(
+                                new InventorySource(InventorySourceType.Container_Inventory, ContainerID.CONTAINER_ID_OFFHAND.getValue(), InventorySourceFlags.No_Flag),
+                                0, equipped, held)),
+                ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+        final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION, wrapper.user());
+        packet.write(wrapper.user().get(InventoryTransactionRewriter.class).getInventoryTransactionType(), transaction);
+        packet.sendToServer(BedrockProtocol.class);
+        hotbar.setItem(slot, equipped.copy());
+        offhand.setItem(0, held.copy());
+    }
+
     private ClientPlayerPackets() {
     }
 
