+            case 1, 2, 3 -> slot - 1;
+            case 4 -> 4;
+            default -> super.javaSlot(slot);
+        };
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return switch (slot) {
+            case 4 -> 4;
+            case 0, 1, 2 -> slot + 1;
+            case 3 -> 0;
+            default -> super.bedrockSlot(slot);
+        };
+    }
+
+    @Override
+    public Item[] getJavaItems() {
+        final Item[] translated = new Item[this.size()];
+        final ItemRewriter rewriter = this.user.get(ItemRewriter.class);
+        for (int slot = 0; slot < this.size(); slot++) {
+            translated[this.javaSlot(slot)] = rewriter.javaItem(this.items[slot]);
+        }
+        return translated;
+    }
+
+    @Override
+    public short translateContainerData(final int containerData) {
+        return switch (containerData) {
+            case 0 -> 0; // Progress arrow
+            case 1 -> 1; // Fuel progress
+            default -> -1; // Unknown
+        };
