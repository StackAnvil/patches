+import static org.junit.jupiter.api.Assertions.*;
+
+class HotbarSelectionPacketTest {
+
+    @Test
+    void serverSelectionReconcilesHeldStackWithoutSendingClientEquipment() throws Exception {
+        final Fixture fixture = new Fixture();
+        final BedrockItem[] items = fixture.inventory.getItems();
+        for (int slot = 0; slot < 9; slot++) {
+            final BedrockItem item = new BedrockItem(slot + 1);
+            item.setAmount(slot + 2);
+            items[slot] = item;
+        }
+        fixture.inventory.setItems(items);
+
+        for (int slot : new int[]{8, 3, 0, 3, 3, 7}) {
+            fixture.serverSelection(slot, true, true);
+            assertEquals(slot, fixture.inventory.getSelectedHotbarSlot());
+            assertSame(items[slot], fixture.inventory.getSelectedHotbarItem());
+            assertArrayEquals(items, fixture.inventory.getItems());
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {Integer.MIN_VALUE, -1, 9, 255, 256, 264, Integer.MAX_VALUE})
+    void invalidServerSelectionsLeaveHeldStateUntouched(final int slot) throws Exception {
+        final Fixture fixture = new Fixture();
+        assertTrue(fixture.inventory.setSelectedHotbarSlot(4));
+        fixture.serverSelection(slot, true, false);
+        assertEquals(4, fixture.inventory.getSelectedHotbarSlot());
+    }
+
+    @Test
+    void serverNotificationWithoutSelectionDoesNotChangeHeldState() throws Exception {
+        final Fixture fixture = new Fixture();
+        assertTrue(fixture.inventory.setSelectedHotbarSlot(4));
+        fixture.serverSelection(8, false, false);
+        assertEquals(4, fixture.inventory.getSelectedHotbarSlot());
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {Short.MIN_VALUE, -257, -256, -1, 9, 255, 256, 264, Short.MAX_VALUE})
+    void javaSlotsAreRejectedBeforeByteNarrowing(final int slot) throws Exception {
+        final Fixture fixture = new Fixture();
+        assertTrue(fixture.inventory.setSelectedHotbarSlot(4));
+        final var input = Unpooled.buffer();
+        try {
+            input.writeShort(slot);
+            final PacketWrapper packet = new PacketWrapperImpl(ServerboundPackets26_3.SET_CARRIED_ITEM, input, fixture.user);
+            fixture.protocol.serverbound(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(input.isReadable());
+            assertEquals(4, fixture.inventory.getSelectedHotbarSlot());
+        } finally {
+            input.release();
+        }
+    }
+
+    private static final class Fixture {
+        private final Map<Class<?>, Object> stores = new HashMap<>();
+        private final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                    if (method.getName().equals("get")) {
+                        return this.stores.get(args[0]);
+                    }
+                    throw new AssertionError(method);
+                });
+        private final TestProtocol protocol = new TestProtocol();
+        private final InventoryContainer inventory;
+
+        private Fixture() {
+            this.stores.put(InventoryRequestTracker.class, new InventoryRequestTracker(this.user) {
+                @Override
+                public boolean isPredictingClick() {
+                    return true;
+                }
+            });
+            final InventoryTracker tracker = new InventoryTracker(this.user);
+            this.stores.put(InventoryTracker.class, tracker);
+            this.inventory = tracker.getInventoryContainer();
+        }
+
+        private void serverSelection(final int slot, final boolean select, final boolean accepted) throws Exception {
+            final var input = Unpooled.buffer();
+            final var output = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_INT.write(input, slot);
+                input.writeByte(this.inventory.containerId());
+                input.writeBoolean(select);
+                final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.PLAYER_HOTBAR, input, this.user);
+                this.protocol.clientbound(packet);
+                assertEquals(!accepted, packet.isCancelled());
+                assertFalse(input.isReadable());
+                if (accepted) {
+                    packet.writeToBuffer(output);
+                    assertEquals(ClientboundPackets26_3.SET_HELD_SLOT.getId(), Types.VAR_INT.readPrimitive(output));
+                    assertEquals(slot, Types.VAR_INT.readPrimitive(output));
+                    assertFalse(output.isReadable());
+                }
+            } finally {
+                input.release();
+                output.release();
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            InventoryPackets.register(this);
+        }
+
+        private void clientbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+        private void serverbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
