+            assertTrue(reference.get("foreignPinsReturnedToBaseline").getAsBoolean());
+            final var names = reference.getAsJsonObject("collectionNames");
+            final Map<String, ContainerEnumName> containers = Map.of(
+                    names.get("6").getAsString(), ContainerEnumName.ArmorContainer,
+                    names.get("34").getAsString(), ContainerEnumName.OffhandContainer,
+                    names.get("29").getAsString(), ContainerEnumName.CombinedHotbarAndInventoryContainer);
+            for (final var element : reference.getAsJsonArray("rows")) {
+                final var row = element.getAsJsonObject();
