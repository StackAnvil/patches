+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class InventoryRequestStorage {
+
+    private final ItemStackRequestInfo requestInfo;
+    private final int javaRevision;
+    private final Container prevCursorContainer;
+    private final List<Container> prevContainers;
+    private Prediction prediction;
+
+    public InventoryRequestStorage(final ItemStackRequestInfo requestInfo, final int javaRevision,
+                                   final Container prevCursorContainer, final List<Container> prevContainers) {
+        this.requestInfo = requestInfo;
+        this.javaRevision = javaRevision;
+        this.prevCursorContainer = prevCursorContainer;
+        this.prevContainers = List.copyOf(prevContainers);
+    }
+
+    public ItemStackRequestInfo requestInfo() {
+        return this.requestInfo;
+    }
+
+    public int javaRevision() {
+        return this.javaRevision;
+    }
+
+    public Container prevCursorContainer() {
+        return this.prevCursorContainer;
+    }
+
+    public List<Container> prevContainers() {
+        return this.prevContainers;
+    }
+
+    public void capturePrediction(final InventoryTracker tracker) {
+        if (this.prediction != null) {
+            throw new IllegalStateException("Inventory request prediction was already captured");
+        }
+        final List<Container> containers = new ArrayList<>(this.prevContainers.size());
+        for (final Container previous : this.prevContainers) {
+            Container current = tracker.getContainerClientbound(previous.containerId(), null, null);
+            if (current == null) {
+                current = tracker.getContainerFromName(previous.getFullContainerName(0), 0);
+            }
+            if (current == null) {
+                throw new IllegalStateException("Inventory request container is no longer available");
+            }
+            // Open player windows share the permanent inventory, which receives named responses.
+            if (current instanceof InventoryContainer) {
+                current = tracker.getInventoryContainer();
+            }
+            containers.add(current.copy());
+        }
+        this.prediction = new Prediction(tracker.getHudContainer().copy(), List.copyOf(containers));
+    }
+
+    public BedrockItem predictedItem(final Container target, final int slot) {
+        if (this.prediction == null) {
+            throw new IllegalStateException("Inventory request prediction has not been captured");
+        }
+        if (this.prediction.cursor().containerId() == target.containerId()) {
+            return this.prediction.cursor().getItem(slot);
+        }
+        for (final Container container : this.prediction.containers()) {
+            if (container.containerId() == target.containerId()
+                    && container.getFullContainerName(slot).equals(target.getFullContainerName(slot))) {
+                return container.getItem(slot);
+            }
+        }
+        return null;
+    }
+
+    private record Prediction(Container cursor, List<Container> containers) { }
+
+}
