+package net.raphimc.viabedrock.protocol.model.recipe;
+
+import net.raphimc.viabedrock.api.chunk.blockstate.BlockItemDescriptor;
+
+import java.util.function.IntFunction;
+
+/** Concrete descriptor identity used by native recipe grouping and availability caches. */
+public record ItemRecipeKey(int identifier, short metadata) {
+
+    public ItemRecipeKey {
+        if (identifier < 0 || identifier > 0xFFFF || metadata < 0) {
+            throw new IllegalArgumentException("Expected an unsigned item ID and nonnegative descriptor metadata");
+        }
+    }
+
+    /** The lookup returns the resolved Item's numeric ID, which can differ from the lookup key. */
+    public static ItemRecipeKey fromDefinition(final int identifier, final short metadata,
+                                               final BlockItemDescriptor block, final IntFunction<Integer> lookup) {
+        final int original = identifier & 0xFFFF;
+        if (block != null) {
+            final Integer resolved = lookup.apply(block.numericItemId());
+            if (metadata == Short.MAX_VALUE) {
+                return resolved != null ? new ItemRecipeKey(resolved & 0xFFFF, Short.MAX_VALUE) : null;
+            }
+            if (resolved != null && (resolved & 0xFFFF) == original) {
+                return new ItemRecipeKey(original, normalize(block.auxiliary()));
+            }
+            // The native invalid descriptor reports ID 0xFFFF. That comparison
+            // can retain the invalid result instead of falling back to the Item.
+            if (resolved == null && original == 0xFFFF) {
+                return null;
+            }
+        }
+        final Integer resolved = lookup.apply(original);
+        return resolved != null ? new ItemRecipeKey(resolved & 0xFFFF, normalize(metadata)) : null;
+    }
+
+    private static short normalize(final short metadata) {
+        return (short) Math.max(0, metadata);
+    }
+
+    /** Compare query-first, using exact canonical Block ownership for associated block items. */
+    public boolean matches(final ItemRecipeKey candidate, final IntFunction<?> blockStates) {
+        if (candidate == null || this.identifier != candidate.identifier) {
+            return false;
+        }
+        if (this.metadata == Short.MAX_VALUE || candidate.metadata == Short.MAX_VALUE) {
+            return true;
+        }
+        final Object queryBlock = blockStates.apply(this.metadata);
+        return queryBlock != null ? queryBlock == blockStates.apply(candidate.metadata) : this.metadata == candidate.metadata;
+    }
+
+    public int descriptorHash() {
+        return this.identifier << 16 | this.metadata;
+    }
+
+}
