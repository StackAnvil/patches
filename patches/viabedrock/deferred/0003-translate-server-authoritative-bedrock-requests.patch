+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.ListTag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeKey;
+
+import java.util.function.Function;
+import java.util.function.IntFunction;
+
+/** Native Recipe source matching after ordinary ingredient descriptors resolve. */
+public final class RecipeIngredientMatcher {
+
+    private RecipeIngredientMatcher() { }
+
+    public static boolean eligible(final BedrockItem source) {
+        return source.tag() == null || !(source.tag().get("ench") instanceof ListTag<?>)
+                && !(source.tag().get("minecraft:item_lock") instanceof ByteTag lock && lock.asByte() != 0);
+    }
+
+    /** A null key represents the native empty descriptor, independently of its outer quantity. */
+    public static boolean matches(final ItemRecipeKey ingredient, final BedrockItem source,
+                                  final Function<BedrockItem, ItemRecipeKey> descriptor,
+                                  final IntFunction<?> ingredientBlocks) {
+        if (!eligible(source)) {
+            return false;
+        }
+        final ItemRecipeKey candidate = descriptor.apply(source);
+        return ingredient == null ? candidate == null && source.tag() == null
+                : candidate != null && candidate.matches(ingredient, ingredientBlocks);
+    }
+
+}
