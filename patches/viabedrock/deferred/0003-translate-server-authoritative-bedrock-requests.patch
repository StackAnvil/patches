+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemStackNetResult;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.ContainerInput;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseContainerInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseSlotInfo;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayDeque;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import java.util.logging.Level;
+
+public class InventoryRequestTracker extends StoredObject {
+
+    private static final long RESPONSE_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(5);
+    private static final long RECOVERY_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(10);
+    private static final int MAX_QUEUED_INTERACTIONS = 32;
+
+    private final Int2ObjectOpenHashMap<InventoryRequestStorage> requests =
+            new Int2ObjectOpenHashMap<>();
+    private final InventoryRequestRecovery recovery = new InventoryRequestRecovery();
+    private final ArrayDeque<QueuedInteraction> queuedInteractions = new ArrayDeque<>();
+    private final PendingInventoryOpenClicks pendingInventoryOpenClicks =
+            new PendingInventoryOpenClicks();
+    private int requestIdCounter = -1;
+    private int legacyRequestIdCounter = -2;
+    private long pendingSinceNanos;
+    private boolean closeTemporaryInventory;
+    private boolean predictingClick;
+    private CraftedItemSynchronization craftedItemSynchronization;
+
+    public InventoryRequestTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public int nextRequestId() {
+        return this.requestIdCounter -= 2;
+    }
+
+    public int nextLegacyRequestId() {
+        this.legacyRequestIdCounter = Math.min(this.legacyRequestIdCounter, -2) - 2;
+        return this.legacyRequestIdCounter;
+    }
+
+    public void addRequest(final InventoryRequestStorage info) {
+        if (this.hasPending()) {
+            throw new IllegalStateException("An inventory request is already pending");
+        }
+        this.requests.put(info.requestInfo().requestId(), info);
+        this.pendingSinceNanos = System.nanoTime();
+        this.recovery.reset();
+    }
+
+    public boolean hasPending() {
+        return !this.requests.isEmpty() || this.craftedItemSynchronization != null;
+    }
+
+    public boolean isPredictingClick() {
+        return this.predictingClick;
+    }
+
+    public void setPredictingClick(final boolean predictingClick) {
+        this.predictingClick = predictingClick;
+    }
+
+    public boolean queueClick(final Container container, final int revision, final short slot,
+                              final byte button, final ContainerInput action) {
+        return this.queueInteraction(new QueuedClick(container, revision, slot, button, action));
+    }
+
+    public boolean isWaitingForInventoryOpen() {
+        return this.pendingInventoryOpenClicks.isWaiting();
+    }
+
+    public boolean beginInventoryOpen() {
+        return this.pendingInventoryOpenClicks.begin(System.nanoTime());
+    }
+
+    public boolean queueInventoryOpenClick(final int revision, final short slot,
+                                           final byte button, final ContainerInput action) {
+        return this.pendingInventoryOpenClicks.add(
+                new InventoryOpenClick(revision, slot, button, action), System.nanoTime());
+    }
+
+    public void openPlayerInventoryTemporarily() {
+        this.closeTemporaryInventory = true;
+    }
+
+    public void keepPlayerInventoryOpen() {
+        this.closeTemporaryInventory = false;
+    }
+
+    private void closeTemporaryInventoryIfIdle() {
+        if (!this.closeTemporaryInventory || this.hasPending()
+                || this.isWaitingForInventoryOpen() || !this.queuedInteractions.isEmpty()) {
+            return;
+        }
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        if (tracker.getCurrentContainer() instanceof InventoryContainer) {
+            this.closeTemporaryInventory = false;
+            tracker.closeTemporaryPlayerInventory();
+        }
+    }
+
+    public void handleInventoryOpen(final Container container) {
+        for (final InventoryOpenClick click : this.pendingInventoryOpenClicks.drain()) {
+            if (this.hasPending()) {
+                if (!this.queueClick(container, click.revision(), click.slot(),
+                        click.button(), click.action())) {
+                    this.clearQueuedInteractions();
+                    PacketFactory.sendJavaContainerSetContent(this.user(), container);
+                    return;
+                }
+            } else if (!container.handleClick(
+                    click.revision(), click.slot(), click.button(), click.action())) {
+                PacketFactory.sendJavaContainerSetContent(this.user(), container);
+            }
+        }
+        this.drainQueuedInteractions();
