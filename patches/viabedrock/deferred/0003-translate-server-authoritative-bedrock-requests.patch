+    }
+
+    private void noteAuthoritativeUpdate(
+            final Container container, final boolean fullContent, final int slot) {
+        if (!this.recovery.isActive() && this.craftedItemSynchronization != null) {
+            this.craftedItemSynchronization.observe(container, fullContent, slot);
+            if (this.craftedItemSynchronization.isComplete()) {
+                this.craftedItemSynchronization = null;
+                this.resetRecovery();
+                this.drainQueuedInteractions();
+                this.closeTemporaryInventoryIfIdle();
+            }
+        }
+        if (!this.recovery.isActive() || !this.hasPending()) {
+            return;
+        }
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        if (this.recovery.observe(container, tracker.getHudContainer(), fullContent, slot)) {
+            this.requests.clear();
+            this.craftedItemSynchronization = null;
+            this.resetRecovery();
+            PacketFactory.sendJavaContainerSetContent(this.user(), tracker.getInventoryContainer());
+        }
+    }
+
+    private void resetRecovery() {
+        this.pendingSinceNanos = 0;
+        this.recovery.reset();
+    }
+
+    public void handleResponse(final ItemStackResponseInfo response) {
+        if (this.recovery.isActive() && this.requests.containsKey(response.requestId())) {
+            // The original screen has been closed. Its response cannot restore a complete
+            // player inventory or cursor, and its slot IDs may now refer to another screen.
+            return;
+        }
+        final InventoryRequestStorage request = this.requests.remove(response.requestId());
+        if (request == null) {
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Received unknown inventory request response: " + response.requestId());
+            return;
+        }
+        this.resetRecovery();
+
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        if (response.result() != ItemStackNetResult.Success) {
+            this.clearQueuedInteractions();
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Inventory request "
+                                    + response.requestId()
+                                    + " failed: "
+                                    + response.result());
+            if (tracker.getHudContainer().serverRevision()
+                    == request.prevCursorContainer().serverRevision()) {
+                tracker.getHudContainer().setItems(request.prevCursorContainer().getItems());
+            }
+            changed.add(tracker.getInventoryContainer());
+            for (Container snapshot : request.prevContainers()) {
+                final Container container =
+                        tracker.getContainerClientbound(snapshot.containerId(), null, null);
+                if (container != null && container.serverRevision() == snapshot.serverRevision()) {
+                    container.setItems(snapshot.getItems());
+                    changed.add(container);
+                }
+            }
+        } else {
+            changed.addAll(this.applySuccessfulResponse(response, request));
+            if (this.synchronizeCraftedItems(request, response)) {
+                this.requestInventoryRefresh();
+            }
+        }
+
+        if (response.result() == ItemStackNetResult.Success) {
+            this.drainQueuedInteractions();
+        }
+
+        for (Container container : changed) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), container);
+        }
+        PacketFactory.sendJavaContainerSetContent(this.user(), tracker.getInventoryContainer());
+        this.closeTemporaryInventoryIfIdle();
+    }
+
+    private void requestInventoryRefresh() {
+        final PacketWrapper refresh = PacketWrapper.create(
+                ServerboundBedrockPackets.INVENTORY_TRANSACTION, this.user());
+        refresh.write(this.user().get(InventoryTransactionRewriter.class).getInventoryTransactionType(),
+                new BedrockInventoryTransaction(0, List.of(), List.of(),
+                        ComplexInventoryTransaction_Type.InventoryMismatch,
+                        new InventoryTransactionData.MismatchTransactionData()));
+        refresh.sendToServer(BedrockProtocol.class);
+    }
+
+    boolean synchronizeCraftedItems(final InventoryRequestStorage request,
+                                     final ItemStackResponseInfo response) {
+        this.craftedItemSynchronization = CraftedItemSynchronization.from(
+                request, response, this.user().get(InventoryTracker.class));
+        if (this.craftedItemSynchronization == null) {
+            return false;
+        }
+        this.pendingSinceNanos = System.nanoTime();
+        return true;
+    }
+
+    Set<Container> applySuccessfulResponse(final ItemStackResponseInfo response,
+                                           final InventoryRequestStorage request) {
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        for (ItemStackResponseContainerInfo containerInfo : response.containers()) {
+            for (ItemStackResponseSlotInfo slotInfo : containerInfo.slots()) {
+                final int requestSlot = Byte.toUnsignedInt(slotInfo.slot());
+                final Container container =
+                        tracker.getContainerFromName(containerInfo.containerName(), requestSlot);
+                if (container == null
+                        || !container.ownsBedrockSlot(containerInfo.containerName(), requestSlot)) {
+                    ViaBedrock.getPlatform()
+                            .getLogger()
+                            .warning(
+                                    "Inventory response refers to unknown slot: "
+                                            + containerInfo.containerName()
+                                            + "/"
+                                            + requestSlot);
+                    continue;
+                }
+                final int slot = container.slotFromRequest(requestSlot);
+                final BedrockItem current = container.getItem(slot);
+                final BedrockItem predicted = request.predictedItem(container, slot);
+                // A full slot update with this network ID carries metadata absent from the response.
+                final boolean authoritativeIdentity = current.netId() != null
+                        && current.netId() == slotInfo.itemNetId();
+                final BedrockItem identity = authoritativeIdentity || predicted == null || predicted.isEmpty()
+                        ? current : predicted;
+                container.setItem(slot, reconcileResponseItem(identity, slotInfo));
+                changed.add(container);
+            }
+        }
+        return changed;
+    }
+
+    static BedrockItem reconcileResponseItem(final BedrockItem current,
+                                             final ItemStackResponseSlotInfo slotInfo) {
+        if (slotInfo.amount() == 0) {
+            return BedrockItem.empty();
+        }
+        final BedrockItem item = current.copy();
+        item.setAmount(Byte.toUnsignedInt(slotInfo.amount()));
+        item.setNetId(slotInfo.itemNetId());
+
+        final CompoundTag tag = item.tag() == null ? new CompoundTag() : item.tag();
+        final CompoundTag display = tag.getCompoundTag("display");
+        if (slotInfo.customName() != null && !slotInfo.customName().isEmpty()) {
+            final CompoundTag updatedDisplay = display == null ? new CompoundTag() : display;
+            updatedDisplay.putString("Name", slotInfo.customName());
+            tag.put("display", updatedDisplay);
+        } else if (display != null) {
+            display.remove("Name");
+            if (display.isEmpty()) {
+                tag.remove("display");
+            }
+        }
+        item.setTag(tag.isEmpty() ? null : tag);
+        return item;
+    }
+
+    void drainQueuedInteractions() {
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        while (!this.hasPending() && tracker.getPendingCloseContainer() == null
+                && !this.isWaitingForInventoryOpen()
+                && !this.queuedInteractions.isEmpty()) {
+            final QueuedInteraction interaction = this.queuedInteractions.removeFirst();
+            if (!interaction.isValid(tracker) || !interaction.apply()) {
+                this.clearQueuedInteractions();
+                final Container current = tracker.getCurrentContainer();
+                PacketFactory.sendJavaContainerSetContent(this.user(),
+                        current != null ? current : tracker.getInventoryContainer());
+                return;
+            }
+        }
+    }
+
+    static final class PendingInventoryOpenClicks {
+
+        private final ArrayDeque<InventoryOpenClick> clicks = new ArrayDeque<>();
+        private long openedAtNanos;
+        private boolean waiting;
+
+        boolean begin(final long now) {
+            if (this.waiting) {
+                return false;
+            }
+            this.waiting = true;
+            this.openedAtNanos = now;
+            return true;
+        }
+
+        boolean isWaiting() {
+            return this.waiting;
+        }
+
+        boolean add(final InventoryOpenClick click, final long now) {
+            if (this.clicks.size() >= MAX_QUEUED_INTERACTIONS) {
+                this.clear();
+                return false;
+            }
+            this.begin(now);
+            this.clicks.addLast(click);
+            return true;
+        }
+
+        boolean isEmpty() {
+            return this.clicks.isEmpty();
+        }
+
+        List<InventoryOpenClick> drain() {
+            final List<InventoryOpenClick> pending = List.copyOf(this.clicks);
+            this.clear();
+            return pending;
+        }
+
+        boolean expire(final long now, final long timeoutNanos) {
+            if (!this.waiting || now - this.openedAtNanos < timeoutNanos) {
+                return false;
+            }
+            this.clear();
+            return true;
+        }
+
+        void discardClicks() {
+            this.clicks.clear();
+        }
+
+        void clear() {
+            this.discardClicks();
+            this.openedAtNanos = 0;
+            this.waiting = false;
+        }
+    }
+
+    record InventoryOpenClick(int revision, short slot, byte button, ContainerInput action) { }
+
+    interface QueuedInteraction {
+
+        Container container();
+
+        default boolean isScreenInteraction() {
+            return true;
+        }
+
+        default boolean isValid(final InventoryTracker tracker) {
+            return tracker.getContainerServerbound(this.container().javaContainerId()) == this.container();
+        }
+
+        boolean apply();
+    }
+
+    private record QueuedClick(Container container, int revision, short slot, byte button,
+                               ContainerInput action) implements QueuedInteraction {
+
+        @Override
+        public boolean apply() {
+            return this.container.handleClick(this.revision, this.slot, this.button, this.action);
+        }
+    }
+
+    private record QueuedButtonClick(Container container, int button) implements QueuedInteraction {
+
+        @Override
+        public boolean apply() {
+            return this.container.handleButtonClick(this.button);
+        }
+    }
+
+}
