+            assertEquals(3001, fixture.menu.getItem(9).netId());
+            assertEquals(2, fixture.inventory.getInventoryContainer().getItem(0).amount());
+            assertEquals(3002, fixture.inventory.getInventoryContainer().getItem(0).netId());
+            assertEquals(6, fixture.menu.getItem(17).amount());
+        }
+    }
+
+    @Test
+    void staleMenuResponsesCannotReplaceReusedMenusEvenWhenTheSameObjectReopens() {
+        for (final boolean authored : new boolean[] {false, true}) {
+            for (final boolean rejected : new boolean[] {false, true}) {
+                for (final boolean sameObject : new boolean[] {false, true}) {
+                    try (var fixture = new Fixture(authored)) {
+                        fixture.inventory.setCurrentContainerClosed(false);
+                        final var reopened = sameObject ? fixture.menu : new ChestContainer(fixture.user, (byte) 6, null, null, 27);
+                        fixture.inventory.setCurrentContainer(reopened);
+                        fixture.requests.setPredictingClick(true);
+                        reopened.setItem(9, item(8, 3003));
+                        fixture.requests.setPredictingClick(false);
+                        if (rejected) {
+                            fixture.requests.setPredictingClick(true);
+                            fixture.requests.restoreRejectedRequest(fixture.requests.getRequest(fixture.requestId));
+                            fixture.requests.setPredictingClick(false);
+                        } else {
+                            fixture.respond(List.of(ack(ContainerEnumName.LevelEntityContainer, 9, 3, 1008)));
+                        }
+                        assertEquals(8, reopened.getItem(9).amount());
+                        assertEquals(3003, reopened.getItem(9).netId());
+                        assertTrue(fixture.inventory.getInventoryContainer().getItem(0).isEmpty());
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void screenChangesPreserveNewHudCellsWhileReconcilingPermanentInventoryAndCursor() {
+        for (final var policy : InventoryRequestStorage.ResponsePolicy.values()) {
+            for (final boolean rejected : new boolean[] {false, true}) {
+                for (final boolean workstationOpen : new boolean[] {false, true}) {
+                    final UserConnection user = mock(UserConnection.class);
+                    final var inventory = new InventoryTracker(user);
+                    final var requests = new InventoryRequestTracker(user);
+                    when(user.get(InventoryTracker.class)).thenReturn(inventory);
+                    when(user.get(InventoryRequestTracker.class)).thenReturn(requests);
+                    requests.setPredictingClick(true);
+                    final var table = new CraftingTableContainer(user, (byte) 6, null, null);
+                    if (workstationOpen) {
+                        inventory.setCurrentContainer(table);
+                    }
+                    table.setItem(32, item(4, 1008));
+                    final var request = new InventoryRequestStorage(new ItemStackRequestInfo(-3, List.of(), List.of(),
+                            TextProcessingEventOrigin.unknown), 0, inventory.getHudContainer().copy(),
+                            workstationOpen ? List.of(table.copy()) : List.of(), policy);
+                    table.setItem(32, item(2, 1008));
+                    inventory.getHudContainer().setItem(0, item(2, 5001));
+                    request.capturePrediction(inventory);
+                    inventory.setCurrentContainerClosed(false);
+                    inventory.setCurrentContainer(new EnchantmentContainer(user, (byte) 6, null, null));
+                    if (!workstationOpen) {
+                        inventory.setCurrentContainerClosed(false);
+                    }
+                    inventory.getHudContainer().setItem(32, item(8, 3003));
+                    inventory.getHudContainer().setItem(50, item(1, 3004));
+                    inventory.getInventoryContainer().setItem(0, item(8, 3005));
+                    if (rejected) {
+                        requests.restoreRejectedRequest(request);
+                        assertTrue(inventory.getHudContainer().getItem(0).isEmpty());
+                        assertEquals(8, inventory.getInventoryContainer().getItem(0).amount());
+                    } else {
+                        requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success, -3, List.of(
+                                ack(ContainerEnumName.CraftingInputContainer, 32, 2, 1008),
+                                ack(ContainerEnumName.CreatedOutputContainer, 50, 0, 0),
+                                ack(ContainerEnumName.CursorContainer, 0, 1, 5001),
+                                ack(ContainerEnumName.CombinedHotbarAndInventoryContainer, 0, 6, 3005))), request);
+                        assertEquals(1, inventory.getHudContainer().getItem(0).amount());
+                        assertEquals(5001, inventory.getHudContainer().getItem(0).netId());
+                        assertEquals(6, inventory.getInventoryContainer().getItem(0).amount());
+                        assertEquals(3005, inventory.getInventoryContainer().getItem(0).netId());
+                    }
+                    assertEquals(8, inventory.getHudContainer().getItem(32).amount());
+                    assertEquals(3003, inventory.getHudContainer().getItem(32).netId());
+                    assertEquals(1, inventory.getHudContainer().getItem(50).amount());
+                    assertEquals(3004, inventory.getHudContainer().getItem(50).netId());
+                }
+            }
+        }
+    }
+
+    private static ItemStackResponseContainerInfo ack(final ContainerEnumName name, final int slot, final int count, final int networkId) {
+        return new ItemStackResponseContainerInfo(new FullContainerName(name, null),
+                List.of(new ItemStackResponseSlotInfo((byte) slot, (byte) slot, (byte) count, networkId, "", null, 0)));
+    }
+
+    private static BedrockItem item(final int count, final int networkId) {
+        final var item = new BedrockItem(1);
+        item.setAmount(count);
+        item.setNetId(networkId);
+        return item;
+    }
+
+    private static final class Fixture implements AutoCloseable {
+
+        private final UserConnection user = mock(UserConnection.class);
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final InventoryRequestTracker requests = new InventoryRequestTracker(this.user);
+        private final ChestContainer menu = new ChestContainer(this.user, (byte) 6, null, null, 27);
+        private final MockedStatic<PacketFactory> packets = mockStatic(PacketFactory.class);
+        private int requestId;
+
+        private Fixture() {
+            this(true);
+        }
+
+        private Fixture(final boolean authored) {
+            final Map<Class<?>, Object> stores = new HashMap<>();
+            final var game = mock(GameSessionStorage.class);
+            final var items = mock(ItemRewriter.class);
+            stores.put(InventoryTracker.class, this.inventory);
+            stores.put(InventoryRequestTracker.class, this.requests);
+            stores.put(GameSessionStorage.class, game);
+            stores.put(ItemRewriter.class, items);
+            when(this.user.get(any())).thenAnswer(call -> stores.get(call.getArgument(0)));
+            when(game.isInventoryServerAuthoritative()).thenReturn(true);
+            when(items.maxStackSize(any())).thenReturn(64);
+            this.inventory.setCurrentContainer(this.menu);
+            this.requests.setPredictingClick(true);
+            this.menu.setItem(9, item(4, 1008));
+            this.menu.setItem(17, item(6, 1009));
+            if (authored) {
+                this.inventory.getHudContainer().setItem(0, item(4, 5001));
+            }
+            this.requests.setPredictingClick(false);
+            this.packets.when(() -> PacketFactory.sendBedrockInventoryRequest(eq(this.user), any())).thenAnswer(call -> {
+                final ItemStackRequestInfo[] sent = call.getArgument(1);
+                assertEquals(1, sent.length);
+                this.requestId = sent[0].requestId();
+                this.requests.getRequest(this.requestId).capturePrediction(this.inventory);
+                return null;
+            });
+            if (authored) {
+                final var session = new NativeContainerActionSession(new NativeContainerAutoPlacement.Binding(
+                        this.menu, this.inventory.currentContainerGeneration(), 8), 6, () -> Set.of(9));
+                assertTrue(session.autoPlaceOne(this.user, 6, 8, 0, 9));
+                assertEquals(3, this.menu.getItem(9).amount());
+                assertEquals(1, this.inventory.getInventoryContainer().getItem(0).amount());
+            } else {
+                assertTrue(this.menu.handleClick(0, (short) 9, (byte) 1, ContainerInput.PICKUP));
+                assertEquals(2, this.menu.getItem(9).amount());
+                assertEquals(2, this.inventory.getHudContainer().getItem(0).amount());
+            }
+        }
+
+        private Set<Container> respond(final List<ItemStackResponseContainerInfo> containers) {
+            this.requests.setPredictingClick(true);
+            try {
+                return this.requests.applySuccessfulResponse(new ItemStackResponseInfo(ItemStackNetResult.Success,
+                        this.requestId, containers), this.requests.getRequest(this.requestId));
+            } finally {
+                this.requests.setPredictingClick(false);
+            }
+        }
+
+        @Override
+        public void close() {
+            this.packets.close();
+        }
+
+    }
+
+}
