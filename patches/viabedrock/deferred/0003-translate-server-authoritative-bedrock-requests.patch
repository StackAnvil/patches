+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.Set;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.NativeContainerUiState;
+
+/** Server-authoritative request adapter for the negotiated count-one manual presentation. */
+public final class NativeContainerActionBackend implements NativeContainerUiState.Actions {
+
+    private final UserConnection user;
+    private final NativeContainerAutoPlacement.Binding binding;
+    private final int menuId;
+    private final NativeContainerActionSession actions;
+
+    private NativeContainerActionBackend(final UserConnection user, final NativeContainerAutoPlacement.Binding binding,
+                                         final NativeContainerMessage message) {
+        this.user = user;
+        this.binding = binding;
+        this.menuId = message.menuId();
+        final var program = ContainerUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+        this.actions = new NativeContainerActionSession(binding, this.menuId,
+                () -> allowedSlots(user, binding, this.menuId, message.kind(), message.conditionTitle(), program));
+    }
+
+    public static NativeContainerActionBackend create(final UserConnection user, final NativeContainerMessage message) {
+        final var tracker = user.get(InventoryTracker.class);
+        final Container menu = tracker.getCurrentContainer();
+        if (!user.get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                || menu == null || tracker.currentContainerGeneration() <= 0
+                || !NativeContainerAutoPlacement.supported(menu)
+                || Byte.toUnsignedInt(menu.javaContainerId()) != message.menuId()
+                || !NativeStorageContainers.matches(menu, message.kind())
+                || menu.size() != message.kind().containerSlots()) {
+            return null;
+        }
+        return new NativeContainerActionBackend(user,
+                new NativeContainerAutoPlacement.Binding(menu, tracker.currentContainerGeneration(), message.sequence()), message);
+    }
+
+    @Override
+    public boolean current() {
+        final var tracker = this.user.get(InventoryTracker.class);
+        return this.user.get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                && this.binding.current(tracker.getCurrentContainer(), tracker.currentContainerGeneration(), this.binding.presentationSequence());
+    }
+
+    @Override
+    public boolean hasActions() {
+        return this.current() && this.actions.hasActions();
+    }
+
+    @Override
+    public boolean autoPlaceOne(final int revision, final int sourceSlot) {
+        return this.current() && this.actions.autoPlaceOne(this.user, this.menuId,
+                this.binding.presentationSequence(), revision, sourceSlot);
+    }
+
+    private static Set<Integer> allowedSlots(
+            final UserConnection user,
+            final NativeContainerAutoPlacement.Binding binding,
+            final int menuId,
+            final ContainerUi.Kind kind,
+            final String title,
+            final ContainerUi program) {
+        final var tracker = user.get(InventoryTracker.class);
+        if (!binding.current(
+                tracker.getCurrentContainer(),
+                tracker.currentContainerGeneration(),
+                binding.presentationSequence())) {
+            return Set.of();
+        }
+        return NativeContainerActionSlots.resolve(user, binding.menu(), menuId, kind, title, program);
+    }
+
+}
