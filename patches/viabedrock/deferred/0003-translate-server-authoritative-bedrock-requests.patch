+        final InventoryRequestStorage request = this.requests.isEmpty() ? null
+                : this.requests.values().iterator().next();
+        final boolean armorTouched = request == null || request.prevContainers().stream()
+                .anyMatch(container -> container.containerId() == tracker.getArmorContainer().containerId());
+        final boolean offhandTouched = request == null || request.prevContainers().stream()
+                .anyMatch(container -> container.containerId() == tracker.getOffhandContainer().containerId());
