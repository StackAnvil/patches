+            default ->
+                    throw new IllegalArgumentException(
+                            "Invalid slot for Anvil Container: " + bedrockSlot);
+        };
+    }
+
+    @Override
+    public boolean handleClick(
+            final int revision,
+            final short javaSlot,
+            final byte button,
+            final ContainerInput action) {
+        if (javaSlot != 2) {
+            return super.handleClick(revision, javaSlot, button, action);
+        }
+        if (action != ContainerInput.PICKUP || button != 0) {
+            return false;
+        }
+
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final BedrockItem input = this.getItem(1);
+        final BedrockItem material = this.getItem(2);
+        final BedrockItem result = this.getItem(50);
+        if (input.isEmpty()
+                || result.isEmpty()
+                || !inventory.getHudContainer().getItem(0).isEmpty()) {
+            return false;
+        }
+        if (input.netId() == null || (!material.isEmpty() && material.netId() == null)) {
+            return false;
+        }
+
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeOptionalAction(0, 0));
+        if (!material.isEmpty()) {
+            actions.add(
+                    new ItemStackRequestAction.ConsumeAction(
+                            1,
+                            new ItemStackRequestSlotInfo(
+                                    this.getFullContainerName(2), (byte) 2, material.netId())));
+        }
+        actions.add(
+                new ItemStackRequestAction.ConsumeAction(
+                        1,
+                        new ItemStackRequestSlotInfo(
+                                this.getFullContainerName(1), (byte) 1, input.netId())));
+        actions.add(
+                new ItemStackRequestAction.PlaceAction(
+                        result.amount(),
+                        new ItemStackRequestSlotInfo(
+                                new FullContainerName(
+                                        ContainerEnumName.CreatedOutputContainer, null),
+                                (byte) 50,
+                                requestId),
+                        new ItemStackRequestSlotInfo(
+                                inventory.getHudContainer().getFullContainerName(0), (byte) 0, 0)));
+
+        final boolean rename = !this.renameText.isEmpty();
+        final ItemStackRequestInfo request =
+                new ItemStackRequestInfo(
+                        requestId,
+                        actions,
+                        rename ? List.of(this.renameText) : List.of(),
+                        rename
+                                ? TextProcessingEventOrigin.AnvilText
+                                : TextProcessingEventOrigin.unknown);
+        requests.addRequest(
+                new InventoryRequestStorage(
+                        request,
+                        revision,
+                        inventory.getHudContainer().copy(),
+                        List.of(this.copy())));
+        this.setItem(1, this.itemAfterRemovingAmount(input, 1));
+        if (!material.isEmpty()) {
+            this.setItem(2, this.itemAfterRemovingAmount(material, 1));
+        }
+        inventory.getHudContainer().setItem(0, result.copy());
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[] {request});
+        return true;
+    }
+
+    public String getRenameText() {
+        return this.renameText;
+    }
+
+    public void setRenameText(final String renameText) {
+        this.renameText = renameText;
+    }
+
+}
