+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.container.NativeRecipeDescriptor;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeRecipeRegistryTest {
+
+    @Test
+    void keepsAliasRepresentativeAndMemberLookupSemanticsSeparate() {
+        final var items = new ItemRegistry(new ItemEntry[0]);
+        final var context = new NativeRecipeRegistry(items, mock(BlockStateRewriter.class));
+        final var target = items.definition("minecraft:jungle_planks");
+        final var lookup = context.lookupItem("PLANKS", (short) 3);
+        assertSame(target, lookup.item());
+        assertEquals(0, lookup.auxiliary());
+        assertSame(items.definition("minecraft:oak_planks"), context.aliasRepresentative("minecraft:planks"));
+        assertSame(items.definition("minecraft:planks"), context.aliasMember("minecraft:planks"));
+        assertNotSame(context.aliasRepresentative("minecraft:planks"), context.aliasMember("minecraft:planks"));
+        assertSame(target, context.aliasMember("MINECRAFT:JUNGLE_PLANKS"));
+        final var descriptor = NativeRecipeDescriptor.resolveName("minecraft:planks", Short.MAX_VALUE, context);
+        assertInstanceOf(NativeRecipeDescriptor.ComplexAlias.class, descriptor);
+        assertFalse(descriptor.isEmpty(context));
+        assertTrue(descriptor.matchesSource(new BedrockItem(target.id()), context, item -> items.recipeKey(item, null)));
+        assertFalse(descriptor.matchesSource(new BedrockItem(items.definition("minecraft:apple").id()), context,
+                item -> items.recipeKey(item, null)));
+    }
+
+    @Test
+    void resolvesBlockAssociationFromTheSelectedDefinitionAfterNumericCollision() {
+        final var components = new CompoundTag();
+        components.putString("minecraft:block", "stone");
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var items = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:block", 4, false, ItemVersion.Legacy, data)});
+        final var selected = items.definition("test:block");
+        final var blocks = mock(BlockStateRewriter.class);
+        final var state = mock(BedrockBlockState.class);
+        when(blocks.blockItemState("minecraft:stone", (short) 3)).thenReturn(state);
+        final var context = new NativeRecipeRegistry(items, blocks);
+        assertNotSame(selected, items.definition(4));
+        assertSame(selected, context.lookupItem("test:block", (short) 3).item());
+        assertTrue(context.hasAssociatedBlock(selected));
+        assertSame(state, context.blockState(selected, (short) 3));
+        final var resolved = assertInstanceOf(NativeRecipeDescriptor.Ordinary.class,
+                NativeRecipeDescriptor.resolveName("test:block", 3, context));
+        assertSame(selected, resolved.item());
+        assertEquals(3, resolved.auxiliary());
+        when(blocks.blockItemState("minecraft:stone", (short) 3)).thenReturn(null);
+        assertSame(NativeRecipeDescriptor.Empty.INSTANCE, NativeRecipeDescriptor.resolveName("test:block", 3, context));
+        assertSame(selected, assertInstanceOf(NativeRecipeDescriptor.Ordinary.class,
+                NativeRecipeDescriptor.resolveName("test:block", Short.MAX_VALUE, context)).item());
+    }
+
+    @Test
+    void usesTheRegisteredBlockNumericOwnerForMissingNamedItems() {
+        final var items = new ItemRegistry(new ItemEntry[0]);
+        final var blocks = mock(BlockStateRewriter.class);
+        when(blocks.registeredBlockItemId("test:block_only")).thenReturn(1);
+        final var context = new NativeRecipeRegistry(items, blocks);
+        final var resolved = assertInstanceOf(NativeRecipeDescriptor.Ordinary.class,
+                NativeRecipeDescriptor.resolveName("test:block_only", 3, context));
+        assertSame(items.definition(1), resolved.item());
+        assertEquals(Short.MAX_VALUE, resolved.auxiliary());
+        when(blocks.registeredBlockItemId("test:block_only")).thenReturn(0);
+        assertSame(NativeRecipeDescriptor.Empty.INSTANCE, NativeRecipeDescriptor.resolveName("test:block_only", 3, context));
+        assertSame(NativeRecipeDescriptor.Empty.INSTANCE, NativeRecipeDescriptor.resolveName("test:missing", 3, context));
+    }
+
+    @Test
+    void keepsDescriptorMatchingIndependentOfRecipeSourceAdmission() {
+        final var items = new ItemRegistry(new ItemEntry[0]);
+        final var context = new NativeRecipeRegistry(items, mock(BlockStateRewriter.class));
+        final var descriptor = NativeRecipeDescriptor.resolveName("minecraft:apple", 0, context);
+        final var source = new BedrockItem(items.definition("minecraft:apple").id());
+        final var tag = new CompoundTag();
+        tag.put("ench", new ListTag<>(IntTag.class));
+        source.setTag(tag);
+        assertTrue(descriptor.matchesStack(source, context, item -> items.recipeKey(item, null)));
+        assertFalse(descriptor.matchesSource(source, context, item -> items.recipeKey(item, null)));
+        tag.remove("ench");
+        tag.putByte("minecraft:item_lock", (byte) -1);
+        assertTrue(descriptor.matchesStack(source, context, item -> items.recipeKey(item, null)));
+        assertFalse(descriptor.matchesSource(source, context, item -> items.recipeKey(item, null)));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/model/SavedItemStackTest.java b/src/test/java/net/raphimc/viabedrock/protocol/model/SavedItemStackTest.java
new file mode 100644
index 000000000..b73681c71
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/model/SavedItemStackTest.java
@@ -0,0 +1,128 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SavedItemStackTest {
+
+    @Test
+    void savedLoadingSelectsTheNumericAssociationAndKeepsTheConstructorTailsDistinct() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:block_collision", 4, false, ItemVersion.Legacy, null)});
+        final var context = context(registry);
+        final var source = saved("test:block_collision", 3, 1);
+        final var instance = SavedItemStack.read(source, context, SavedItemStack.Target.ITEM_INSTANCE);
+        final var stack = SavedItemStack.read(source, context, SavedItemStack.Target.ITEM_STACK);
+        assertSame(registry.definition(4), instance.definition());
+        assertSame(instance.definition(), stack.definition());
+        assertEquals(11, instance.blockRuntimeId());
+        assertEquals(11, stack.blockRuntimeId());
+        assertEquals(3, instance.data());
+        assertEquals(0, stack.data());
+    }
+
+    @Test
+    void zeroCountReconstructionClearsTheStackHeaderButKeepsOwnedUserdataAndFlags() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:coal_collision", 304, false, ItemVersion.Legacy, null)});
+        final var source = saved("test:coal_collision", 3, 0);
+        source.putByte("WasPickedUp", (byte) 1);
+        final var data = new CompoundTag();
+        data.putInt("value", 37);
+        source.put("tag", data);
+        final var instance = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_INSTANCE);
+        final var stack = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_STACK);
+        assertNotNull(instance.definition());
+        assertEquals(3, instance.data());
+        assertNull(stack.definition());
+        assertEquals(0, stack.data());
+        assertFalse(stack.hasBlockState());
+        assertEquals(data, stack.tag());
+        assertNotSame(data, stack.tag());
+        assertTrue(stack.wasPickedUp());
+        assertEquals(stack, stack.copy());
+        assertTrue(stack.copy().wasPickedUp());
+        stack.tag().putInt("value", 38);
+        assertEquals(37, data.getInt("value"));
+    }
+
+    @Test
+    void legacyIdsResolveSavedNamesBeforeTheConnectionNumericOwner() {
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("minecraft:charcoal", 257, false, ItemVersion.Legacy, null)});
+        final var source = new CompoundTag();
+        source.putShort("id", (short) 263);
+        source.putShort("Damage", (short) 1);
+        source.putByte("Count", (byte) 1);
+        final var stack = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_STACK);
+        assertSame(registry.definition("minecraft:apple"), stack.definition());
+        assertEquals(0, stack.data());
+        source.putInt("Name", 1);
+        assertTrue(SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_STACK).isEmpty());
+        source.remove("Name");
+        source.putInt("Count", 1);
+        final var instance = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_INSTANCE);
+        assertSame(stack.definition(), instance.definition());
+        assertEquals(0, instance.amount());
+    }
+
+    @Test
+    void durablePostLoadMovesAuxiliaryOnlyWhenTheUserdataDamageKeyIsAbsent() {
+        final var registry = new ItemRegistry(new ItemEntry[0]);
+        final var source = saved("minecraft:diamond_sword", 17, 1);
+        final var stack = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_STACK);
+        assertEquals(0, stack.data());
+        assertEquals(17, stack.tag().getInt("Damage"));
+        final var tag = new CompoundTag();
+        tag.putString("Damage", "typed-data");
+        source.put("tag", tag);
+        final var retained = SavedItemStack.read(source, context(registry), SavedItemStack.Target.ITEM_STACK);
+        assertEquals(17, retained.data());
+        assertEquals(tag, retained.tag());
+        assertNotSame(tag, retained.tag());
+    }
+
+    private static CompoundTag saved(final String name, final int auxiliary, final int amount) {
+        final var source = new CompoundTag();
+        source.putString("Name", name);
+        source.putShort("Damage", (short) auxiliary);
+        source.putByte("Count", (byte) amount);
+        return source;
