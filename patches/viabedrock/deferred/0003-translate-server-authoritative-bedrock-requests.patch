+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.TextProcessingEventOrigin;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.InventorySource;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseSlotInfo;
+import net.raphimc.viabedrock.protocol.types.item.BedrockItemType;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class ItemStackCodecTest {
+
+    @Test
+    void failureResponseCarriesAbsentContainers() {
+        final ItemStackResponseType type = new ItemStackResponseType();
+        final ByteBuf buffer = Unpooled.buffer();
+        type.write(buffer, new ItemStackResponseInfo(ItemStackNetResult.Error, -3, null));
+
+        assertArrayEquals(new byte[]{1, 5, 0}, bytes(buffer));
+        final ItemStackResponseInfo decoded = type.read(buffer);
+        assertEquals(ItemStackNetResult.Error, decoded.result());
+        assertEquals(-3, decoded.requestId());
+        assertNull(decoded.containers());
+        assertEquals(0, buffer.readableBytes());
+    }
+
+    @Test
+    void successResponseCarriesPresentEmptyContainers() {
+        final ItemStackResponseType type = new ItemStackResponseType();
+        final ByteBuf buffer = Unpooled.buffer();
+        type.write(buffer, new ItemStackResponseInfo(ItemStackNetResult.Success, -3, List.of()));
+
+        assertArrayEquals(new byte[]{0, 5, 1, 0}, bytes(buffer));
+        final ItemStackResponseInfo decoded = type.read(buffer);
+        assertEquals(List.of(), decoded.containers());
+        assertEquals(0, buffer.readableBytes());
+    }
+
+    @Test
+    void emptySlotOmitsItemNetworkId() {
+        final ItemStackSlotResponseType type = new ItemStackSlotResponseType();
+        final ByteBuf buffer = Unpooled.buffer();
+        type.write(buffer, new ItemStackResponseSlotInfo((byte) 4, (byte) 5, (byte) 0, 0, "", null, 0));
+
+        assertArrayEquals(new byte[]{4, 5, 0, 0, 0, 0, 0}, bytes(buffer));
+        assertEquals(0, type.read(buffer).itemNetId());
+        assertEquals(0, buffer.readableBytes());
+    }
+
+    @Test
+    void requestSlotRetainsNegativeClientRequestId() {
+        final ItemStackSlotRequestType type = new ItemStackSlotRequestType();
+        final ByteBuf buffer = Unpooled.buffer();
+        final ItemStackRequestSlotInfo slot = new ItemStackRequestSlotInfo(FullContainerName.EMPTY, (byte) 50, -57);
+        type.write(buffer, slot);
+
+        assertArrayEquals(new byte[]{0, 0, 50, (byte) 0xC7, -1, -1, -1}, bytes(buffer));
+        assertEquals(slot, type.read(buffer));
+        assertEquals(0, buffer.readableBytes());
+    }
+
+    @Test
+    void protocol2193CraftRequestUsesActionAndOriginIds() {
+        final ItemStackRequestType type = new ItemStackRequestType(
+                new BedrockItemType(0, new Int2ObjectOpenHashMap<>(), false));
+        final ByteBuf buffer = Unpooled.buffer();
+        type.write(buffer, new ItemStackRequestInfo(-1,
+                List.of(new ItemStackRequestAction.CraftRecipeAction(42, 1)), List.of(),
+                TextProcessingEventOrigin.AnvilText));
+
+        assertArrayEquals(new byte[]{1, 1, 10, 10, 42, 1, 0, 4, 0, 0, 0}, bytes(buffer));
+    }
+
+    @Test
+    void protocol2193ContainerAndInventorySourceIds() {
+        final ByteBuf container = Unpooled.buffer();
+        new ItemStackSlotRequestType().write(container,
+                new ItemStackRequestSlotInfo(
+                        new FullContainerName(ContainerEnumName.CombinedHotbarAndInventoryContainer, null),
+                        (byte) 5, 0));
+        assertArrayEquals(new byte[]{12, 0, 5, 0, 0, 0, 0}, bytes(container));
+
+        final ByteBuf source = Unpooled.buffer();
+        new InventorySourcePacketType().write(source,
+                new InventorySource(InventorySourceType.Non_Implemented_Feature_TODO, 7,
+                        InventorySourceFlags.No_Flag));
+        assertArrayEquals(new byte[]{4, 1, 7, 0}, bytes(source));
+    }
+
+    private static byte[] bytes(final ByteBuf buffer) {
+        final byte[] bytes = new byte[buffer.readableBytes()];
+        buffer.getBytes(buffer.readerIndex(), bytes);
+        return bytes;
+    }
+
+}
