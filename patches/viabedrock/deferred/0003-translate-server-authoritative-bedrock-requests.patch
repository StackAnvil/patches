+
+class InventoryTrackerTest {
+
+    @Test
+    void hotbarResponseSlotsBelongToTheInventory() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        for (final ContainerEnumName name : new ContainerEnumName[] {
+            ContainerEnumName.CombinedHotbarAndInventoryContainer,
+            ContainerEnumName.HotbarContainer, ContainerEnumName.InventoryContainer}) {
+            final FullContainerName inventoryName = new FullContainerName(name, null);
+            assertSame(tracker.getInventoryContainer(), tracker.getContainerFromName(inventoryName, 8));
+            assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 0));
+            assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 8));
+            assertTrue(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 35));
+            assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, -1));
+            assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(inventoryName, 36));
+            assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(new FullContainerName(name, 1), 8));
+        }
+        assertFalse(tracker.getInventoryContainer().ownsBedrockSlot(
+                new FullContainerName(ContainerEnumName.ArmorContainer, null), 0));
+    }
+
+    @Test
+    void armorAndOffhandResponsesUseBedrockSlotBounds() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final FullContainerName armorName = new FullContainerName(ContainerEnumName.ArmorContainer, null);
+        final FullContainerName offhandName = new FullContainerName(ContainerEnumName.OffhandContainer, null);
+
+        for (int slot = 0; slot < 4; slot++) {
+            assertSame(tracker.getArmorContainer(), tracker.getContainerFromName(armorName, slot));
+            assertTrue(tracker.getArmorContainer().ownsBedrockSlot(armorName, slot));
+        }
+        assertFalse(tracker.getArmorContainer().ownsBedrockSlot(armorName, 4));
+        assertSame(tracker.getOffhandContainer(), tracker.getContainerFromName(offhandName, 0));
+        assertFalse(tracker.getOffhandContainer().ownsBedrockSlot(offhandName, 0));
+        assertTrue(tracker.getOffhandContainer().ownsBedrockSlot(offhandName, 1));
+    }
+
+    @Test
+    void craftingInputResponseUsesOpenTableInsteadOfPlayerGrid() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+        final InventoryTracker tracker = new InventoryTracker(user);
+        final FullContainerName craftingInput = new FullContainerName(ContainerEnumName.CraftingInputContainer, null);
+
+        assertSame(tracker.getHudContainer(), tracker.getContainerFromName(craftingInput, 28));
+        final CraftingTableContainer table = new CraftingTableContainer(user, (byte) 5, null, null);
+        tracker.setCurrentContainer(table);
+        assertSame(table, tracker.getContainerFromName(craftingInput, 32));
+        assertSame(tracker.getHudContainer(), tracker.getContainerFromName(craftingInput, 28));
+    }
