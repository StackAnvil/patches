+class NetworkItemConstructionTest {
+
+    @Test
+    void absentNbtStillLoadsRestrictionsAndShieldTicksInBothWireFormats() throws Exception {
+        final var fixture = fixture();
+        final var tail = Unpooled.buffer();
+        try {
+            tail.writeShortLE(0);
+            BedrockTypes.UTF8_STRING_ARRAY.write(tail, new String[]{"stone", "minecraft:dirt"});
+            final int placeEnd = tail.writerIndex();
+            BedrockTypes.UTF8_STRING_ARRAY.write(tail, new String[]{"log"});
+            tail.writeLongLE(0x123456789ABCDEFL);
+            final byte[] bytes = new byte[tail.readableBytes()];
+            tail.getBytes(0, bytes);
+            for (final var codec : List.of(new BedrockItemType(2, false, fixture.items),
+                    new NetworkItemStackDescriptorType(2, true, fixture.items))) {
+                final var item = NetworkItemStackFixtures.decode(codec, 2, 1, 0, 0, bytes);
+                assertNull(item.tag());
+                assertArrayEquals(new String[]{"stone", "minecraft:dirt"}, item.canPlace());
+                assertArrayEquals(new String[]{"log"}, item.canBreak());
+                assertEquals(0x123456789ABCDEFL, item.blockingTicks());
+                // Partial tails retain fields read before the truncated array.
+                final var truncated = NetworkItemStackFixtures.decode(codec, 2, 1, 0, 0,
+                        Arrays.copyOf(bytes, placeEnd + 2));
+                assertArrayEquals(item.canPlace(), truncated.canPlace());
+                assertEquals(0, truncated.blockingTicks());
+            }
+        } finally {
+            tail.release();
+        }
+    }
+
+    @Test
+    void associatedConstructionReceivesRawNegativeAuxiliaryAndRetainsBlockAtRuntimeZero() throws Exception {
+        final var fixture = fixture();
+        final var state = state();
+        when(fixture.blocks.blockItemState("test:block", Short.MIN_VALUE)).thenReturn(state);
+        when(fixture.blocks.registeredRuntimeId(state)).thenReturn(0);
+        when(fixture.blocks.blockItemNumericId(0)).thenReturn(2);
+        when(fixture.blocks.blockState(9)).thenReturn(state);
+        when(fixture.blocks.blockItemNumericId(9)).thenReturn(2);
+        for (final var codec : codecs(fixture.items)) {
+            for (final int runtime : new int[]{0, 9, 999}) {
+                final var item = NetworkItemStackFixtures.decode(codec, 1, 1, 32768, runtime);
+                assertEquals(2, item.identifier());
+                assertEquals(0, item.data());
+                assertTrue(item.hasBlockState());
+                assertEquals(0, item.blockRuntimeId());
+            }
+        }
+        verify(fixture.blocks, never()).blockItemState("test:block", (short) 0);
+    }
+
+    @Test
+    void matchingRuntimeOwnershipDoesNotConsultTheAssociatedAuxiliaryCache() throws Exception {
+        final var fixture = fixture();
+        when(fixture.blocks.blockState(4)).thenReturn(state());
+        when(fixture.blocks.blockItemNumericId(4)).thenReturn(1);
+        for (final var codec : codecs(fixture.items)) {
+            final var item = NetworkItemStackFixtures.decode(codec, 1, 1, 32768, 4);
+            assertEquals(1, item.identifier());
+            assertEquals(0, item.data());
+            assertEquals(4, item.blockRuntimeId());
+        }
+        verify(fixture.blocks, never()).blockItemState(anyString(), anyShort());
+    }
+
+    @Test
+    void countInvalidationSkipsUserDataLoadingWithoutLosingPacketAlignment() throws Exception {
+        final var fixture = fixture();
+        for (final var codec : codecs(fixture.items)) {
+            final var item = NetworkItemStackFixtures.decode(codec, 1, 256, 3, 0, new byte[]{1, 0});
+            assertTrue(item.isEmpty());
+            assertEquals(0, item.identifier());
+            assertFalse(item.hasBlockState());
+            assertNull(item.tag());
+            assertThrows(IllegalStateException.class,
+                    () -> NetworkItemStackFixtures.decode(codec, 1, 1, 3, 0, new byte[]{1, 0}));
+        }
+    }
+
+    @Test
+    void emptyNetworkDescriptorsKeepOuterNetworkIdsWithoutUserData() {
+        final var item = BedrockItem.empty();
+        item.setNetId(17);
+        final var codec = new NetworkItemStackDescriptorType(0, true, NetworkItemStackFixtures.CONTEXT);
+        final var buffer = Unpooled.buffer();
+        try {
+            codec.write(buffer, item);
+            assertEquals(0, buffer.readShortLE());
+            assertEquals(0, buffer.readShortLE());
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertTrue(buffer.readBoolean());
+            assertEquals(17, BedrockTypes.VAR_INT.read(buffer));
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static List<Type<BedrockItem>> codecs(final ItemRewriter context) {
+        return List.of(new BedrockItemType(0, false, context), new NetworkItemStackDescriptorType(0, true, context));
+    }
+
+    private static Fixture fixture() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var items = mock(ItemRewriter.class, CALLS_REAL_METHODS);
+        final var blocks = mock(BlockStateRewriter.class);
+        final var registry = spy(new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:first", 1, false, ItemVersion.Legacy, null),
+            new ItemEntry("test:second", 2, false, ItemVersion.Legacy, null)}));
+        final var first = registry.definition(1);
+        final var second = registry.definition(2);
+        doReturn("test:block").when(registry).associatedBlock(first);
+        doReturn(null).when(registry).associatedBlock(second);
+        when(blocks.blockItemState(eq("test:block"), anyShort())).thenReturn(state());
+        when(blocks.blockItemNumericId(0)).thenReturn(2);
+        when(blocks.blockItemRecipeDescriptor(anyInt())).thenReturn(new BlockItemDescriptor(1, (short) 0));
+        for (final var value : Map.of(
+                "registry", registry,
+                "items", registry.ids()).entrySet()) {
+            final var field = ItemRewriter.class.getDeclaredField(value.getKey());
+            field.setAccessible(true);
+            field.set(items, value.getValue());
+        }
+        doReturn(user).when(items).user();
+        when(user.get(BlockStateRewriter.class)).thenReturn(blocks);
+        return new Fixture(items, blocks);
+    }
+
+    private static BedrockBlockState state() {
+        final var tag = new CompoundTag();
+        tag.putString("name", "test:block");
+        tag.put("states", new CompoundTag());
+        return BedrockBlockState.fromNbt(tag);
+    }
+
+    private record Fixture(ItemRewriter items, BlockStateRewriter blocks) { }
+
+}
