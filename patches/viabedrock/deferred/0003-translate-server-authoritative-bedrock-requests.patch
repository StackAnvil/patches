+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemStackNetResult;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseContainerInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseInfo;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackResponseSlotInfo;
+
+import java.util.HashSet;
+import java.util.Set;
+
+public class InventoryRequestTracker extends StoredObject {
+
+    private final Int2ObjectOpenHashMap<InventoryRequestStorage> requests =
+            new Int2ObjectOpenHashMap<>();
+    private int requestIdCounter = -1;
+
+    public InventoryRequestTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public int nextRequestId() {
+        return this.requestIdCounter -= 2;
+    }
+
+    public void addRequest(final InventoryRequestStorage info) {
+        if (this.hasPending()) {
+            throw new IllegalStateException("An inventory request is already pending");
+        }
+        this.requests.put(info.requestInfo().requestId(), info);
+    }
+
+    public boolean hasPending() {
+        return !this.requests.isEmpty();
+    }
+
+    public InventoryRequestStorage getRequest(final int requestId) {
+        return this.requests.get(requestId);
+    }
+
+    public void removeRequest(final int requestId) {
+        this.requests.remove(requestId);
+    }
+
+    public void handleResponse(final ItemStackResponseInfo response) {
+        final InventoryRequestStorage request = this.requests.remove(response.requestId());
+        if (request == null) {
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Received unknown inventory request response: " + response.requestId());
+            return;
+        }
+
+        final InventoryTracker tracker = this.user().get(InventoryTracker.class);
+        final Set<Container> changed = new HashSet<>();
+        if (response.result() != ItemStackNetResult.Success) {
+            ViaBedrock.getPlatform()
+                    .getLogger()
+                    .warning(
+                            "Inventory request "
+                                    + response.requestId()
+                                    + " failed: "
+                                    + response.result());
+            if (tracker.getHudContainer().serverRevision()
+                    == request.prevCursorContainer().serverRevision()) {
+                tracker.getHudContainer().setItems(request.prevCursorContainer().getItems());
+            }
+            changed.add(tracker.getInventoryContainer());
+            for (Container snapshot : request.prevContainers()) {
+                final Container container =
+                        tracker.getContainerClientbound(snapshot.containerId(), null, null);
+                if (container != null && container.serverRevision() == snapshot.serverRevision()) {
+                    container.setItems(snapshot.getItems());
+                    changed.add(container);
+                }
+            }
+        } else {
+            for (ItemStackResponseContainerInfo containerInfo : response.containers()) {
+                for (ItemStackResponseSlotInfo slotInfo : containerInfo.slots()) {
+                    final int slot = Byte.toUnsignedInt(slotInfo.slot());
+                    final Container container =
+                            tracker.getContainerFromName(containerInfo.containerName(), slot);
+                    if (container == null
+                            || !container.ownsBedrockSlot(containerInfo.containerName(), slot)) {
+                        ViaBedrock.getPlatform()
+                                .getLogger()
+                                .warning(
+                                        "Inventory response refers to unknown slot: "
+                                                + containerInfo.containerName()
+                                                + "/"
+                                                + slot);
+                        continue;
+                    }
+                    if (updatedSinceRequest(container, request)) {
+                        continue;
+                    }
+                    final BedrockItem item = container.getItem(slot).copy();
+                    item.setAmount(Byte.toUnsignedInt(slotInfo.amount()));
+                    item.setNetId(slotInfo.itemNetId());
+                    container.setItem(slot, item.amount() == 0 ? BedrockItem.empty() : item);
+                    changed.add(container);
+                }
+            }
+        }
+
+        for (Container container : changed) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), container);
+        }
+        PacketFactory.sendJavaContainerSetContent(this.user(), tracker.getInventoryContainer());
+    }
+
+    private static boolean updatedSinceRequest(
+            final Container container, final InventoryRequestStorage request) {
+        if (container.containerId() == request.prevCursorContainer().containerId()) {
+            return container.serverRevision() != request.prevCursorContainer().serverRevision();
+        }
+        for (final Container snapshot : request.prevContainers()) {
+            if (snapshot.containerId() == container.containerId()) {
+                return container.serverRevision() != snapshot.serverRevision();
+            }
+        }
+        return false;
+    }
+
+}
