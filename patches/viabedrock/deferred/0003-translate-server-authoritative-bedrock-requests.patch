+    static BedrockInventoryTransaction creativeSlotTransaction(
+            final int slot, final BedrockItem previousItem, final BedrockItem creativeItem) {
+        final InventorySource creativeSource = new InventorySource(
+                InventorySourceType.Creative_Inventory,
+                ContainerID.CONTAINER_ID_NONE.getValue(),
+                InventorySourceFlags.No_Flag);
+        final List<InventoryActionData> actions = new ArrayList<>(previousItem.isEmpty() ? 2 : 3);
+        if (!previousItem.isEmpty()) {
+            actions.add(new InventoryActionData(
+                    creativeSource, 0, BedrockItem.empty(), previousItem));
+        }
+        actions.add(new InventoryActionData(
+                creativeSource, 1, creativeItem, BedrockItem.empty()));
+        actions.add(new InventoryActionData(
+                new InventorySource(
+                        InventorySourceType.Container_Inventory,
+                        ContainerID.CONTAINER_ID_INVENTORY.getValue(),
+                        InventorySourceFlags.No_Flag),
+                slot, previousItem, creativeItem));
+        return new BedrockInventoryTransaction(
+                0, null, actions,
+                ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+    }
+
+    private static BedrockItem readCreativeItem(final PacketWrapper wrapper) throws InformativeException {
+        final int id = wrapper.read(BedrockTypes.VAR_INT);
+        final int amount = wrapper.read(BedrockTypes.UNSIGNED_SHORT_LE);
+        final int data = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
+        final int blockRuntimeId = wrapper.read(BedrockTypes.VAR_INT);
+        wrapper.read(BedrockTypes.BYTE_ARRAY); // user data
+        if (id == 0) {
+            return BedrockItem.empty();
+        }
+        final BedrockItem item = new BedrockItem(id);
+        item.setAmount(amount);
+        item.setData(data);
+        item.setBlockRuntimeId(blockRuntimeId);
+        return item;
     }
 
