+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+
+/** Advertised native food eligibility, independent of the mapped Java item. */
+public record ItemFoodProperties(boolean food, boolean canAlwaysEat) {
+
+    public static final ItemFoodProperties NONE = new ItemFoodProperties(false, false);
+
+    public ItemFoodProperties withComponentData(final CompoundTag components) {
+        if (!(components.get("minecraft:food") instanceof CompoundTag component)) {
+            return this;
+        }
+        return new ItemFoodProperties(true, component.get("can_always_eat") instanceof ByteTag value && value.asByte() != 0);
+    }
+
+    public boolean allowsUse(final float hunger, final float maximumHunger, final boolean creative) {
+        return !this.food || this.canAlwaysEat || creative || hunger < maximumHunger;
+    }
+
+}
