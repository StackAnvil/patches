+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.minecraft.item.data.FoodProperties1_21_2;
+import com.viaversion.viaversion.api.minecraft.item.data.consumable.Consumable1_21_2;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemFoodPropertiesTest {
+
+    @Test
+    void preservesOmittedComponentsAndAppliesCurrentDefinitionUpdates() {
+        final CompoundTag components = new CompoundTag();
+        final CompoundTag food = new CompoundTag();
+        components.put("minecraft:food", food);
+        final var ordinary = ItemFoodProperties.NONE.withComponentData(components, true);
+        assertTrue(ordinary.food());
+        assertFalse(ordinary.canAlwaysEat());
+        assertSame(ordinary, ordinary.withComponentData(new CompoundTag(), true));
+        food.putBoolean("can_always_eat", true);
+        final var always = ordinary.withComponentData(components, true);
+        assertTrue(always.canAlwaysEat());
+        food.remove("can_always_eat");
+        assertFalse(always.withComponentData(components, true).canAlwaysEat());
+    }
+
+    @Test
+    void comparesNativeHungerLimitsWithoutRestrictingCreativeOrAlwaysEdibleFood() {
+        final var food = new ItemFoodProperties(true, false, false, 0, 0F, "none");
+        assertFalse(food.allowsUse(20F, 20F, false));
+        assertTrue(food.allowsUse(Math.nextDown(20F), 20F, false));
+        assertFalse(food.allowsUse(12F, 12F, false));
+        assertTrue(food.allowsUse(20F, 20F, true));
+        assertTrue(new ItemFoodProperties(true, true, false, 0, 0F, "none").allowsUse(20F, 20F, false));
+        assertTrue(ItemFoodProperties.NONE.allowsUse(20F, 20F, false));
+    }
+
+    @Test
+    void retainsFoodAcrossOmittedUpdatesAndNumericCollisions() {
+        final CompoundTag components = new CompoundTag();
+        final CompoundTag food = new CompoundTag();
+        food.putBoolean("can_always_eat", true);
+        components.put("minecraft:food", food);
+        final CompoundTag data = new CompoundTag();
+        data.put("components", components);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:first", 1, true, ItemVersion.DataDriven, data),
+            new ItemEntry("test:first", 2, true, ItemVersion.None, new CompoundTag()),
+            new ItemEntry("test:second", 1, true, ItemVersion.DataDriven, null)
+        });
+        assertEquals(new ItemFoodProperties(true, true, false, 0, 0F, "none"), registry.foodProperties().get("test:first"));
+        final var replaced = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:first", 1, true, ItemVersion.DataDriven, data),
+            new ItemEntry("test:second", 1, true, ItemVersion.DataDriven, null)
+        });
+        assertEquals(new ItemFoodProperties(true, true, false, 0, 0F, "none"), replaced.foodProperties().get("test:first"));
+        assertEquals(ItemFoodProperties.NONE, replaced.foodProperties().get("test:second"));
+    }
+
+    @Test
+    void componentUseModifiersAdmitFullHungerAndSurviveOmittedReads() {
+        final var food = new CompoundTag();
+        food.putBoolean("can_always_eat", false);
+        food.putInt("nutrition", 4);
+        food.putFloat("saturation_modifier", 0.3F);
+        final var bare = new CompoundTag();
+        bare.put("minecraft:food", food);
+        final var animation = new CompoundTag();
+        animation.putString("value", "eat");
+        bare.put("minecraft:use_animation", animation);
+        final var timed = bare.copy();
+        final var modifiers = new CompoundTag();
+        modifiers.putString("start_using", "if_first");
+        modifiers.putFloat("use_duration", 0F);
+        timed.put("minecraft:use_modifiers", modifiers);
+        final var bareData = new CompoundTag();
+        bareData.put("components", bare);
+        final var timedData = new CompoundTag();
+        timedData.put("components", timed);
+        final var omittedFood = new CompoundTag();
+        omittedFood.put("components", new CompoundTag());
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:timed", 1, true, ItemVersion.DataDriven, timedData),
+            new ItemEntry("test:timed", 1, true, ItemVersion.None, omittedFood),
+            new ItemEntry("test:bare", 2, true, ItemVersion.DataDriven, bareData),
+            new ItemEntry("test:legacy", 3, false, ItemVersion.Legacy, timedData)
+        });
+        final var component = registry.foodProperties().get("test:timed");
+        final var ordinary = registry.foodProperties().get("test:bare");
+        assertFalse(component.canAlwaysEat());
+        assertTrue(component.allowsUse(20F, 20F, false));
+        assertFalse(ordinary.allowsUse(20F, 20F, false));
+        assertTrue(ordinary.allowsUse(10F, 20F, false));
+        assertFalse(registry.foodProperties().get("test:legacy").allowsUse(20F, 20F, false));
+        final var wire = Unpooled.buffer();
+        try {
+            FoodProperties1_21_2.TYPE.write(wire, component.javaComponent());
+            assertEquals(new FoodProperties1_21_2(4, 2.4F, true), FoodProperties1_21_2.TYPE.read(wire));
+            assertFalse(wire.isReadable());
+            assertEquals(new FoodProperties1_21_2(4, 2.4F, false), ordinary.javaComponent());
+            Consumable1_21_2.TYPE26_3.write(wire, component.javaConsumable(32));
+            final var consumable = Consumable1_21_2.TYPE26_3.read(wire);
+            assertEquals(1.6F, consumable.consumeSeconds());
+            assertEquals(1, consumable.animationType());
+            assertTrue(consumable.hasConsumeParticles());
+            assertEquals(0, consumable.consumeEffects().length);
+            assertFalse(wire.isReadable());
+            assertEquals(0F, ordinary.javaConsumable(0).consumeSeconds());
+        } finally {
+            wire.release();
+        }
+    }
+
+}
