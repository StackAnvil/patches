+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.api.minecraft.Holder;
+import com.viaversion.viaversion.api.minecraft.SoundEvent;
+import com.viaversion.viaversion.api.minecraft.item.data.FoodProperties1_21_2;
+import com.viaversion.viaversion.api.minecraft.item.data.consumable.Consumable1_21_2;
+import com.viaversion.viaversion.api.minecraft.item.data.consumable.ConsumeEffect;
+
+/** Native food admission includes other installed components that can start use. */
+public record ItemFoodProperties(boolean food, boolean canAlwaysEat, boolean useModifiers, int nutrition, float saturationModifier, String useAnimation) {
+
+    public static final ItemFoodProperties NONE = new ItemFoodProperties(false, false, false, 0, 0F, "none");
+
+    public ItemFoodProperties withComponentData(final CompoundTag components, final boolean componentItem) {
+        final boolean useModifiers = this.useModifiers || componentItem && components.get("minecraft:use_modifiers") instanceof CompoundTag;
+        final String useAnimation = componentItem && components.get("minecraft:use_animation") instanceof CompoundTag animation
+                && animation.get("value") instanceof StringTag value ? value.getValue() : this.useAnimation;
+        if (!(components.get("minecraft:food") instanceof CompoundTag component)) {
+            return useModifiers == this.useModifiers && useAnimation.equals(this.useAnimation) ? this
+                    : new ItemFoodProperties(this.food, this.canAlwaysEat, useModifiers, this.nutrition, this.saturationModifier, useAnimation);
+        }
+        return new ItemFoodProperties(true, component.get("can_always_eat") instanceof ByteTag value && value.asByte() != 0,
+                useModifiers, component.get("nutrition") instanceof NumberTag value ? value.asInt() : 0,
+                component.get("saturation_modifier") instanceof NumberTag value ? value.asFloat() : 0F, useAnimation);
+    }
+
+    public boolean allowsUse(final float hunger, final float maximumHunger, final boolean ignoresHunger) {
+        // Food refusal does not veto an installed use-modifier component's independent start.
+        return !this.food || this.canAlwaysEat || this.useModifiers || ignoresHunger || hunger < maximumHunger;
+    }
+
+    public FoodProperties1_21_2 javaComponent() {
+        return new FoodProperties1_21_2(this.nutrition, (float) this.nutrition * 2F * this.saturationModifier,
+                this.canAlwaysEat || this.useModifiers);
+    }
+
+    public Consumable1_21_2 javaConsumable(final Integer useDurationTicks) {
+        final int animation = switch (this.useAnimation) {
+            case "eat" -> 1;
+            case "drink" -> 2;
+            default -> 0;
+        };
+        final String sound = animation == 2 ? "minecraft:entity.generic.drink" : "minecraft:entity.generic.eat";
+        return new Consumable1_21_2(useDurationTicks == null ? 0F : useDurationTicks / 20F,
+                animation, Holder.of(new SoundEvent(sound, null)), animation == 1, new ConsumeEffect<?>[0]);
+    }
+
+}
