+    /** Food component updates retain omitted components and resolve through the current registry identity. */
+    public Map<String, ItemFoodProperties> foodProperties() {
+        final Map<String, ItemFoodProperties> properties = new HashMap<>();
+        for (final ItemEntry entry : this.registrations) {
+            final CompoundTag data = entry.componentData();
+            if (data != null && data.get("components") instanceof CompoundTag components) {
+                properties.compute(entry.identifier(), (identifier, previous) ->
+                        (previous == null ? ItemFoodProperties.NONE : previous).withComponentData(components));
+            }
+        }
+        properties.keySet().retainAll(this.ids.keySet());
+        return Map.copyOf(properties);
+    }
