+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemFoodPropertiesTest {
+
+    @Test
+    void preservesOmittedComponentsAndAppliesCurrentDefinitionUpdates() {
+        final CompoundTag components = new CompoundTag();
+        final CompoundTag food = new CompoundTag();
+        components.put("minecraft:food", food);
+        final var ordinary = ItemFoodProperties.NONE.withComponentData(components);
+        assertTrue(ordinary.food());
+        assertFalse(ordinary.canAlwaysEat());
+        assertSame(ordinary, ordinary.withComponentData(new CompoundTag()));
+        food.putBoolean("can_always_eat", true);
+        final var always = ordinary.withComponentData(components);
+        assertTrue(always.canAlwaysEat());
+        food.remove("can_always_eat");
+        assertFalse(always.withComponentData(components).canAlwaysEat());
+    }
+
+    @Test
+    void comparesNativeHungerLimitsWithoutRestrictingCreativeOrAlwaysEdibleFood() {
+        final var food = new ItemFoodProperties(true, false);
+        assertFalse(food.allowsUse(20F, 20F, false));
+        assertTrue(food.allowsUse(Math.nextDown(20F), 20F, false));
+        assertFalse(food.allowsUse(12F, 12F, false));
+        assertTrue(food.allowsUse(20F, 20F, true));
+        assertTrue(new ItemFoodProperties(true, true).allowsUse(20F, 20F, false));
+        assertTrue(ItemFoodProperties.NONE.allowsUse(20F, 20F, false));
+    }
+
+    @Test
+    void retainsFoodAcrossOmittedUpdatesAndDropsDefinitionsThatLoseTheirRegistryIdentity() {
+        final CompoundTag components = new CompoundTag();
+        final CompoundTag food = new CompoundTag();
+        food.putBoolean("can_always_eat", true);
+        components.put("minecraft:food", food);
+        final CompoundTag data = new CompoundTag();
+        data.put("components", components);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:first", 1, true, ItemVersion.DataDriven, data),
+            new ItemEntry("test:first", 2, true, ItemVersion.None, new CompoundTag()),
+            new ItemEntry("test:second", 1, true, ItemVersion.DataDriven, null)
+        });
+        assertEquals(new ItemFoodProperties(true, true), registry.foodProperties().get("test:first"));
+        final var replaced = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry("test:first", 1, true, ItemVersion.DataDriven, data),
+            new ItemEntry("test:second", 1, true, ItemVersion.DataDriven, null)
+        });
+        assertFalse(replaced.foodProperties().containsKey("test:first"));
+    }
+
+}
