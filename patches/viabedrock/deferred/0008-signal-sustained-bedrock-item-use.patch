+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FoodUseAdmissionPacketTest {
+
+    @ParameterizedTest
+    @EnumSource(InteractionHand.class)
+    void sendsRefusedFoodWithoutStartingUseAndKeepsOffhandResynchronization(final InteractionHand hand) throws Exception {
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> method.getName().equals("get") ? stores.get(args[0]) : null);
+        final EntityTracker entities = new EntityTracker(user);
+        stores.put(EntityTracker.class, entities);
+        final var player = entities.addEntity(new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+        stores.put(InventoryRequestTracker.class, new InventoryRequestTracker(user) {
+            @Override
+            public boolean isPredictingClick() {
+                return true;
+            }
+        });
+        final var inventory = new InventoryTracker(user);
+        stores.put(InventoryTracker.class, inventory);
+        final var held = new BedrockItem(261);
+        held.setAmount(8);
+        inventory.getInventoryContainer().setItem(0, held);
+        inventory.getOffhandContainer().setItem(0, held);
+        final var items = mock(ItemRewriter.class);
+        when(items.getItems()).thenReturn(hand == InteractionHand.MAIN_HAND ? ImmutableBiMap.of("minecraft:bread", 261) : ImmutableBiMap.of());
+        when(items.foodProperties(held)).thenReturn(new ItemFoodProperties(true, false, false, 0, 0F, "none"));
+        stores.put(ItemRewriter.class, items);
+        final var transactions = new InventoryTransactionRewriter(user);
+        stores.put(InventoryTransactionRewriter.class, transactions);
+        final var input = Unpooled.buffer();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            Types.VAR_INT.writePrimitive(input, hand.ordinal());
+            Types.VAR_INT.writePrimitive(input, 1);
+            input.writeFloat(0F).writeFloat(0F);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.USE_ITEM, input, user);
+            new TestProtocol().translate(packet);
+            assertEquals(hand == InteractionHand.OFF_HAND, packet.isCancelled());
+            if (hand == InteractionHand.MAIN_HAND) {
+                final var transaction = packet.get(transactions.getInventoryTransactionType(), 0);
+                final var use = assertInstanceOf(InventoryTransactionData.UseItemTransactionData.class, transaction.transactionData());
+                assertEquals(261, use.itemInHand().identifier());
+                assertEquals(8, use.itemInHand().amount());
+                assertEquals(0, use.hotbarSlot());
+                assertEquals(0, transaction.legacyRequestId());
+                assertTrue(transaction.actions() == null || transaction.actions().isEmpty());
+            }
+            assertFalse(input.isReadable());
+            assertTrue(player.authInputData().isEmpty());
+            assertEquals(8, held.amount());
+            if (hand == InteractionHand.OFF_HAND) {
+                packets.verify(() -> PacketFactory.sendJavaContainerSetContent(user, inventory.getInventoryContainer()));
+            } else {
+                packets.verifyNoInteractions();
+            }
+        } finally {
+            input.release();
+        }
+    }
+
+    @Test
+    void confirmedDifficultyAndComponentUseAdmitFoodWithoutConsumingInventory() throws Exception {
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> method.getName().equals("get") ? stores.get(args[0]) : null);
+        final var session = mock(GameSessionStorage.class, CALLS_REAL_METHODS);
+        stores.put(GameSessionStorage.class, session);
+        final var entities = new EntityTracker(user);
+        stores.put(EntityTracker.class, entities);
+        entities.addEntity(new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+        final var requests = new InventoryRequestTracker(user);
+        requests.setPredictingClick(true);
+        stores.put(InventoryRequestTracker.class, requests);
+        final var inventory = new InventoryTracker(user);
+        stores.put(InventoryTracker.class, inventory);
+        final var held = new BedrockItem(1);
+        held.setAmount(8);
+        inventory.getInventoryContainer().setItem(0, held);
+        final var items = mock(ItemRewriter.class);
+        when(items.foodProperties(held)).thenReturn(new ItemFoodProperties(true, false, false, 0, 0F, "none"));
+        stores.put(ItemRewriter.class, items);
+        final var transactions = new InventoryTransactionRewriter(user);
+        stores.put(InventoryTransactionRewriter.class, transactions);
+        final var protocol = new TestProtocol();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            final Difficulty[] difficulties = {Difficulty.Normal, Difficulty.Peaceful, Difficulty.Normal, Difficulty.Normal};
+            for (int index = 0; index < difficulties.length; index++) {
+                final Difficulty difficulty = difficulties[index];
+                final boolean useModifiers = index == 3;
+                entities.getClientPlayer().authInputData().clear();
+                when(items.foodProperties(held)).thenReturn(new ItemFoodProperties(true, false, useModifiers, 0, 0F, "none"));
+                final var update = Unpooled.buffer();
+                final var input = Unpooled.buffer();
+                try {
+                    BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(update, difficulty.getValue());
+                    protocol.clientbound(new PacketWrapperImpl(ClientboundBedrockPackets.SET_DIFFICULTY, update, user));
+                    Types.VAR_INT.writePrimitive(input, InteractionHand.MAIN_HAND.ordinal());
+                    Types.VAR_INT.writePrimitive(input, 1);
+                    input.writeFloat(0F).writeFloat(0F);
+                    final var packet = new PacketWrapperImpl(ServerboundPackets26_3.USE_ITEM, input, user);
+                    protocol.translate(packet);
+                    assertFalse(packet.isCancelled());
+                    if (!packet.isCancelled()) {
+                        final var transaction = packet.get(transactions.getInventoryTransactionType(), 0);
+                        final var use = assertInstanceOf(InventoryTransactionData.UseItemTransactionData.class, transaction.transactionData());
+                        assertEquals(8, use.itemInHand().amount());
+                    }
+                    assertEquals(8, held.amount());
+                    assertEquals(difficulty == Difficulty.Peaceful || useModifiers, entities.getClientPlayer().authInputData().contains(PlayerAuthInputData.StartUsingItem));
+                    assertFalse(input.isReadable());
+                } finally {
+                    update.release();
+                    input.release();
+                }
+            }
+            packets.verifyNoInteractions();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            InteractionPackets.register(this);
+            PlayPackets.register(this);
+        }
+
+        private void clientbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
