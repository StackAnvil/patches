+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.java.EntityEvent;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CompletedItemUsePacketTest {
+
+    @ParameterizedTest
+    @ValueSource(ints = {Integer.MIN_VALUE, -1, 0, 1, 3, 5, 15, 16, 17, Integer.MAX_VALUE})
+    void completesOnlyValidMatchingUsesWithoutChangingAuthoritativeInventory(final int useMethod) throws Exception {
+        for (short itemId : new short[]{258, -1234}) {
+            for (boolean matching : new boolean[]{false, true}) {
+                final Map<Class<?>, Object> stores = new HashMap<>();
+                final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                        new Class<?>[]{UserConnection.class}, (proxy, method, args) ->
+                                method.getName().equals("get") ? stores.get(args[0]) : null);
+                final EntityTracker entities = new EntityTracker(user);
+                stores.put(EntityTracker.class, entities);
+                final ClientPlayerEntity player = entities.addEntity(new ClientPlayerEntity(user, 1,
+                        UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+                stores.put(InventoryRequestTracker.class, new InventoryRequestTracker(user) {
+                    @Override
+                    public boolean isPredictingClick() {
+                        return true;
+                    }
+                });
+                final InventoryTracker inventory = new InventoryTracker(user);
+                stores.put(InventoryTracker.class, inventory);
+                final BedrockItem held = new BedrockItem(matching ? itemId : itemId + 1);
+                held.setAmount(8);
+                inventory.getInventoryContainer().setItem(0, held);
+                final var input = Unpooled.buffer();
+                final var output = Unpooled.buffer();
+                try {
+                    input.writeShortLE(itemId);
+                    input.writeIntLE(useMethod);
+                    final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.COMPLETED_USING_ITEM, input, user);
+                    new TestProtocol().translate(packet);
+                    final boolean completes = matching && useMethod >= 0 && useMethod <= 16;
+                    assertEquals(!completes, packet.isCancelled());
+                    assertEquals(8, inventory.getInventoryContainer().getSelectedHotbarItem().amount());
+                    assertFalse(input.isReadable());
+                    if (completes) {
+                        packet.writeToBuffer(output);
+                        assertEquals(ClientboundPackets26_3.ENTITY_EVENT.getId(), Types.VAR_INT.readPrimitive(output));
+                        assertEquals(player.javaId(), output.readInt());
+                        assertEquals(EntityEvent.USE_ITEM_COMPLETE.getValue(), output.readByte());
+                        assertFalse(output.isReadable());
+                    }
+                } finally {
+                    input.release();
+                    output.release();
+                }
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            InteractionPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
