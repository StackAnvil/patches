+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FoodUseAdmissionPacketTest {
+
+    @ParameterizedTest
+    @EnumSource(InteractionHand.class)
+    void rejectsFullHungerUseWithoutLosingOffhandResynchronization(final InteractionHand hand) throws Exception {
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> method.getName().equals("get") ? stores.get(args[0]) : null);
+        final EntityTracker entities = new EntityTracker(user);
+        stores.put(EntityTracker.class, entities);
+        final var player = entities.addEntity(new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+        stores.put(InventoryRequestTracker.class, new InventoryRequestTracker(user) {
+            @Override
+            public boolean isPredictingClick() {
+                return true;
+            }
+        });
+        final var inventory = new InventoryTracker(user);
+        stores.put(InventoryTracker.class, inventory);
+        final var held = new BedrockItem(1);
+        held.setAmount(8);
+        inventory.getInventoryContainer().setItem(0, held);
+        inventory.getOffhandContainer().setItem(0, held);
+        final var items = mock(ItemRewriter.class);
+        when(items.getItems()).thenReturn(hand == InteractionHand.MAIN_HAND ? ImmutableBiMap.of("test:food", 1) : ImmutableBiMap.of());
+        when(items.foodProperties(held)).thenReturn(new ItemFoodProperties(true, false));
+        stores.put(ItemRewriter.class, items);
+        final var input = Unpooled.buffer();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            Types.VAR_INT.writePrimitive(input, hand.ordinal());
+            Types.VAR_INT.writePrimitive(input, 1);
+            input.writeFloat(0F).writeFloat(0F);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.USE_ITEM, input, user);
+            new TestProtocol().translate(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(input.isReadable());
+            assertTrue(player.authInputData().isEmpty());
+            assertEquals(8, held.amount());
+            if (hand == InteractionHand.OFF_HAND) {
+                packets.verify(() -> PacketFactory.sendJavaContainerSetContent(user, inventory.getInventoryContainer()));
+            } else {
+                packets.verifyNoInteractions();
+            }
+        } finally {
+            input.release();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            InteractionPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
