+package net.raphimc.viabedrock.protocol.packet;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class InteractionPacketsTest {
+
+    @Test
+    void sustainedUseSignalsCoverFoodAndChargeItemsWithoutInstantRockets() {
+        assertTrue(InteractionPackets.isContinuousUseItem("minecraft:apple", Set.of("minecraft:is_food")));
+        assertTrue(InteractionPackets.isContinuousUseItem("minecraft:bow", Set.of()));
+        assertTrue(InteractionPackets.isContinuousUseItem("minecraft:potion", Set.of()));
+        assertFalse(InteractionPackets.isContinuousUseItem("minecraft:firework_rocket", Set.of()));
+        assertFalse(InteractionPackets.isContinuousUseItem("minecraft:shield", Set.of()));
+        assertFalse(InteractionPackets.isContinuousUseItem(null, Set.of()));
+    }
+
+}
