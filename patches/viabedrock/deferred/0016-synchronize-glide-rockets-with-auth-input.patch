+            final InventoryTracker inventory = new InventoryTracker(user());
+            final InventoryContainer contents = new InventoryContainer(user()) {
+                @Override
+                public Item getJavaItem(final int slot) {
+                    final var item = this.getItem(slot);
+                    return item.isEmpty() ? StructuredItem.empty()
+                            : new StructuredItem(1, item.amount(), new StructuredDataContainer());
+                }
+
+                @Override
+                protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem current) {
+                    // Observe local quantities without the fixture emitting equipment packets.
+                }
+            };
+            final List<Integer> amountsAtSend = new ArrayList<>();
+            final BedrockInventoryTransaction[] written = new BedrockInventoryTransaction[1];
+            final PacketWrapper packet = (PacketWrapper) Proxy.newProxyInstance(PacketWrapper.class.getClassLoader(),
+                    new Class<?>[]{PacketWrapper.class}, (proxy, method, args) -> {
+                        if (method.getName().equals("write")) {
+                            written[0] = (BedrockInventoryTransaction) args[1];
+                        }
+                        if (method.getName().equals("sendToServer")) {
+                            final var use = (InventoryTransactionData.UseItemTransactionData) written[0].transactionData();
+                            amountsAtSend.add(contents.getItem(use.hotbarSlot()).amount());
+                        }
+                        return null;
+                    });
+            final var type = new InventoryTransactionPacketType(() -> null, null);
+            final BedrockItem pearl = new BedrockItem(425);
+            pearl.setAmount(16);
+            pearl.setNetId(27);
+            contents.setItem(0, pearl);
+            final var first = InteractionPackets.beginItemUse(player, inventory, InteractionHand.MAIN_HAND,
+                    0, pearl, "minecraft:ender_pearl", false);
+            assertEquals(-4, first.legacyRequestId());
+            assertEquals(ContainerEnumName.InventoryContainer, first.legacySlots().getFirst().container());
+            assertArrayEquals(new byte[]{0}, first.legacySlots().getFirst().slots());
+            assertEquals(0, first.actions().getFirst().slot());
+            assertEquals(16, first.actions().getFirst().fromItem().amount());
+            assertEquals(15, first.actions().getFirst().toItem().amount());
+            assertNull(first.actions().getFirst().fromItem().netId());
+            assertNull(first.actions().getFirst().toItem().netId());
+            assertNull(((InventoryTransactionData.UseItemTransactionData) first.transactionData()).itemInHand().netId());
+
+            InteractionPackets.writeItemUse(packet, type, first, contents);
+            assertEquals(15, contents.getItem(0).amount());
+            assertEquals(27, contents.getItem(0).netId());
+
+            final BedrockItem windCharge = new BedrockItem(882);
+            windCharge.setNetId(28);
+            contents.setItem(1, windCharge);
+            final var second = InteractionPackets.beginItemUse(player, inventory, InteractionHand.MAIN_HAND,
+                    1, windCharge, "minecraft:wind_charge", false);
+            assertEquals(-6, second.legacyRequestId());
+            assertArrayEquals(new byte[]{1}, second.legacySlots().getFirst().slots());
+            assertEquals(1, second.actions().getFirst().slot());
+            assertEquals(1, second.actions().getFirst().fromItem().amount());
+            assertTrue(second.actions().getFirst().toItem().isEmpty());
+            assertEquals(1, ((InventoryTransactionData.UseItemTransactionData) second.transactionData()).hotbarSlot());
+            InteractionPackets.writeItemUse(packet, type, second, contents);
+            assertTrue(contents.getItem(1).isEmpty());
+            final var repeated = InteractionPackets.beginItemUse(player, inventory, InteractionHand.MAIN_HAND,
+                    0, contents.getItem(0), "minecraft:ender_pearl", false);
+            assertEquals(-8, repeated.legacyRequestId());
+            assertEquals(15, repeated.actions().getFirst().fromItem().amount());
+            assertEquals(14, repeated.actions().getFirst().toItem().amount());
+            InteractionPackets.writeItemUse(packet, type, repeated, contents);
+            assertEquals(14, contents.getItem(0).amount());
+            assertEquals(27, contents.getItem(0).netId());
+            assertEquals(List.of(16, 1, 15), amountsAtSend);
+            assertTrue(player.pendingFlightItemUses().isEmpty());
+            assertTrue(player.authInputData().isEmpty());
+            assertEquals(16, pearl.amount());
+            assertEquals(27, pearl.netId());
+            assertEquals(1, windCharge.amount());
+            assertEquals(28, windCharge.netId());
+        }
+    }
+
+    private static UserConnection user() {
+        return (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> null);
+    }
+
+    private static ClientPlayerEntity player() {
+        return new ClientPlayerEntity(user(), 1, UUID.randomUUID(),
+                new PlayerAbilities(1, (byte) 0, (byte) 0));
+    }
+
 }
