+package net.raphimc.viabedrock.protocol.types.inventory;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ComplexInventoryTransaction_Type;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HandSlot;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseActionType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseClientCooldownState;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUsePredictedResult;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryActionData;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryTransactionData;
+import net.raphimc.viabedrock.protocol.model.inventory.LegacySetItemSlotData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class InventoryTransactionPacketTypeTest {
+
+    private static final Type<BedrockItem> ITEM_TYPE = new Type<>(BedrockItem.class) {
+        @Override
+        public BedrockItem read(final ByteBuf buffer) {
+            return new BedrockItem(buffer.readUnsignedByte());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final BedrockItem value) {
+            buffer.writeByte(value.identifier());
+        }
+    };
+
+    private static final Type<InventoryActionData[]> ACTIONS_TYPE = new Type<>(InventoryActionData[].class) {
+        @Override
+        public InventoryActionData[] read(final ByteBuf buffer) {
+            assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            return new InventoryActionData[0];
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final InventoryActionData[] value) {
+            assertEquals(0, value.length);
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 0);
+        }
+    };
+
+    @Test
+    void authInputItemUseOmitsInventoryTransactionDiscriminant() {
+        final BedrockInventoryTransaction transaction = new BedrockInventoryTransaction(
+                0, null, null, ComplexInventoryTransaction_Type.ItemUseTransaction,
+                new InventoryTransactionData.UseItemTransactionData(
+                        ItemUseActionType.Use, ItemUseTriggerType.Player_Input,
+                        new BlockPosition(0, 0, 0), 255, 0, HandSlot.Offhand,
+                        new BedrockItem(12), new Position3f(1F, 2F, 3F), Position3f.ZERO,
+                        0, ItemUsePredictedResult.Success, ItemUseClientCooldownState.Off));
+        final InventoryTransactionPacketType packetType = new InventoryTransactionPacketType(
+                () -> ITEM_TYPE, ACTIONS_TYPE);
+        final InventoryTransactionPacketType packedType = new InventoryTransactionPacketType(
+                () -> ITEM_TYPE, ACTIONS_TYPE, true);
+        final ByteBuf packet = Unpooled.buffer();
+        final ByteBuf packed = Unpooled.buffer();
+        packetType.write(packet, transaction);
+        packedType.write(packed, transaction);
+
+        final byte[] packetBytes = new byte[packet.readableBytes()];
+        packet.getBytes(0, packetBytes);
+        final byte[] packedBytes = new byte[packed.readableBytes()];
+        packed.getBytes(0, packedBytes);
+        assertArrayEquals(new byte[]{0, 0, 2, 0}, Arrays.copyOf(packetBytes, 4));
+        assertArrayEquals(new byte[]{0, 0, 0}, Arrays.copyOf(packedBytes, 3));
+        assertArrayEquals(Arrays.copyOfRange(packetBytes, 3, packetBytes.length),
+                Arrays.copyOfRange(packedBytes, 2, packedBytes.length));
+
+        final BedrockInventoryTransaction decoded = packedType.read(packed);
+        assertEquals(ComplexInventoryTransaction_Type.ItemUseTransaction, decoded.transactionType());
+        final InventoryTransactionData.UseItemTransactionData decodedUse =
+                (InventoryTransactionData.UseItemTransactionData) decoded.transactionData();
+        assertEquals(HandSlot.Offhand, decodedUse.handSlot());
+        assertEquals(ItemUsePredictedResult.Success, decodedUse.predictedResult());
+        assertEquals(0, packed.readableBytes());
+    }
+
+    @Test
+    void legacyItemUseEncodesNegativeEvenIdAndPhysicalInventorySlotMetadata() {
+        final BedrockInventoryTransaction transaction = new BedrockInventoryTransaction(
+                -4, List.of(new LegacySetItemSlotData(ContainerEnumName.InventoryContainer, new byte[]{0})),
+                null, ComplexInventoryTransaction_Type.ItemUseTransaction,
+                new InventoryTransactionData.UseItemTransactionData(
+                        ItemUseActionType.Use, ItemUseTriggerType.Unknown,
+                        new BlockPosition(0, 0, 0), 255, 0, HandSlot.Mainhand,
+                        new BedrockItem(12), new Position3f(1F, 2F, 3F), Position3f.ZERO,
+                        0, ItemUsePredictedResult.Failure, ItemUseClientCooldownState.Off));
+        final InventoryTransactionPacketType type = new InventoryTransactionPacketType(
+                () -> ITEM_TYPE, ACTIONS_TYPE);
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            type.write(buffer, transaction);
+            final byte[] header = new byte[8];
+            buffer.getBytes(buffer.readerIndex(), header);
+            assertArrayEquals(new byte[]{7, 1, 1, 29, 1, 0, 2, 0}, header);
+            final BedrockInventoryTransaction decoded = type.read(buffer);
+            assertEquals(-4, decoded.legacyRequestId());
+            assertEquals(1, decoded.legacySlots().size());
+            assertEquals(ContainerEnumName.InventoryContainer, decoded.legacySlots().get(0).container());
+            assertArrayEquals(new byte[]{0}, decoded.legacySlots().get(0).slots());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void authInputRejectsOtherTransactionKinds() {
+        final InventoryTransactionPacketType packedType = new InventoryTransactionPacketType(
+                () -> ITEM_TYPE, ACTIONS_TYPE, true);
+        final BedrockInventoryTransaction transaction = new BedrockInventoryTransaction(
+                0, null, null, ComplexInventoryTransaction_Type.NormalTransaction,
+                new InventoryTransactionData.NormalTransactionData());
+
+        assertThrows(IllegalArgumentException.class, () -> packedType.write(Unpooled.buffer(), transaction));
+    }
+
+}
