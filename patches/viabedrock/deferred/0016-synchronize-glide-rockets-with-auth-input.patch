+    static BedrockInventoryTransaction beginItemUse(final ClientPlayerEntity player,
+            final InventoryRequestTracker requests, final InteractionHand hand, final int hotbarSlot, final BedrockItem item,
+            final String identifier, final Set<String> tags) {
+        if (item.isEmpty()) {
+            return null;
+        }
+        if ("minecraft:shield".equals(identifier)) {
+            player.setShieldBlockingHand(hand);
+            return null;
+        }
+        if (hand == InteractionHand.OFF_HAND) {
+            return null;
+        }
+        player.setShieldBlockingHand(null);
+        if (isContinuousUseItem(identifier, tags)) {
+            player.addAuthInputData(PlayerAuthInputData.StartUsingItem);
+        }
+        final boolean flightRocket = isFlightRocket(identifier, player.isGliding());
+        int legacyRequestId = 0;
+        List<LegacySetItemSlotData> legacySlots = null;
+        List<InventoryActionData> actions = null;
+        final BedrockItem heldItem = item.copy();
+        if (flightRocket) {
+            heldItem.setNetId(null);
+        }
+        if (flightRocket && player.javaGameMode() != GameMode.CREATIVE) {
+            final BedrockItem remaining = heldItem.copy();
+            remaining.setAmount(remaining.amount() - 1);
+            legacyRequestId = requests.nextLegacyRequestId();
+            legacySlots = List.of(new LegacySetItemSlotData(
+                    ContainerEnumName.InventoryContainer, new byte[]{(byte) hotbarSlot}));
+            actions = List.of(new InventoryActionData(
+                    new InventorySource(InventorySourceType.Container_Inventory,
+                            ContainerID.CONTAINER_ID_INVENTORY.getValue(), InventorySourceFlags.No_Flag),
+                    hotbarSlot, heldItem.copy(), remaining.amount() > 0 ? remaining : BedrockItem.empty()));
+        }
+        final BedrockInventoryTransaction transaction = new BedrockInventoryTransaction(
+                legacyRequestId, legacySlots, actions, ComplexInventoryTransaction_Type.ItemUseTransaction,
+                new InventoryTransactionData.UseItemTransactionData(
+                        ItemUseActionType.Use,
+                        ItemUseTriggerType.Unknown,
+                        new BlockPosition(0, 0, 0), 255, hotbarSlot, HandSlot.Mainhand, heldItem,
+                        player.position(), Position3f.ZERO, 0,
+                        ItemUsePredictedResult.Failure,
+                        ItemUseClientCooldownState.Off));
+        if (flightRocket) {
+            player.pendingFlightItemUses().addLast(transaction);
+            return null;
+        }
+        return transaction;
+    }
