+        final InventoryTransactionPacketType packedType = new InventoryTransactionPacketType(
+                () -> ITEM_TYPE, ACTIONS_TYPE, true);
+        final ByteBuf packet = Unpooled.buffer();
+        final ByteBuf packed = Unpooled.buffer();
+        packetType.write(packet, transaction);
+        packedType.write(packed, transaction);
+
+        final byte[] packetBytes = new byte[packet.readableBytes()];
+        packet.getBytes(0, packetBytes);
+        final byte[] packedBytes = new byte[packed.readableBytes()];
+        packed.getBytes(0, packedBytes);
+        assertArrayEquals(new byte[]{0, 0, 2, 0}, Arrays.copyOf(packetBytes, 4));
+        assertArrayEquals(new byte[]{0, 0, 0}, Arrays.copyOf(packedBytes, 3));
+        assertArrayEquals(Arrays.copyOfRange(packetBytes, 3, packetBytes.length),
+                Arrays.copyOfRange(packedBytes, 2, packedBytes.length));
+
+        final BedrockInventoryTransaction decoded = packedType.read(packed);
+        assertEquals(ComplexInventoryTransaction_Type.ItemUseTransaction, decoded.transactionType());
+        final InventoryTransactionData.UseItemTransactionData decodedUse =
+                (InventoryTransactionData.UseItemTransactionData) decoded.transactionData();
+        assertEquals(HandSlot.Offhand, decodedUse.handSlot());
+        assertEquals(ItemUsePredictedResult.Success, decodedUse.predictedResult());
+        assertEquals(0, packed.readableBytes());
+    }
