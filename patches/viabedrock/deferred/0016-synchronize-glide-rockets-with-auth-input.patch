+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataContainer;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.InteractionHand;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.types.inventory.InventoryTransactionPacketType;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.spy;
+import static org.mockito.Mockito.when;
+
+class ThrowablePredictionPacketTest {
+
+    @Test
+    void publishesNativeDebitWhenJavaCooldownRetainsTheLocalStack() throws Exception {
+        Class.forName(StructuredDataKey.class.getName());
+        for (int count : new int[]{3, 1}) {
+            final UserConnection user = mock(UserConnection.class);
+            final var inventory = new InventoryContainer(user) {
+                @Override
+                protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem current) {
+                    // This fixture observes the Java quantity update independently of Bedrock equipment transport.
+                }
+
+                @Override
+                public Item getJavaItem(final int slot) {
+                    final var item = this.getItem(slot);
+                    return item.isEmpty() ? StructuredItem.empty()
+                            : new StructuredItem(425, item.amount(), new StructuredDataContainer());
+                }
+            };
+            final var pearl = new BedrockItem(425, (short) 0, (byte) count);
+            pearl.setNetId(27);
+            inventory.setItem(0, pearl);
+            final var player = new ClientPlayerEntity(user, 1, UUID.randomUUID(),
+                    new PlayerAbilities(1, (byte) 0, (byte) 0));
+            final var transaction = InteractionPackets.beginItemUse(player, new InventoryTracker(user),
+                    InteractionHand.MAIN_HAND, 0, pearl, "minecraft:ender_pearl", false);
+            final var request = mock(PacketWrapper.class);
+            when(request.user()).thenReturn(user);
+            doAnswer(invocation -> {
+                assertEquals(count, inventory.getItem(0).amount());
+                return null;
+            }).when(request).sendToServer(BedrockProtocol.class);
+            // A Java cooldown can emit the request without locally consuming its held stack.
+            final var displayedCount = new AtomicInteger(count);
+            final var update = spy(new PacketWrapperImpl(ClientboundPackets26_3.CONTAINER_SET_SLOT, null, user));
+            doAnswer(invocation -> {
+                final var output = Unpooled.buffer();
+                try {
+                    update.writeToBuffer(output);
+                    assertEquals(ClientboundPackets26_3.CONTAINER_SET_SLOT.getId(), Types.VAR_INT.read(output));
+                    assertEquals(0, Types.VAR_INT.read(output));
+                    assertEquals(0, Types.VAR_INT.read(output));
+                    assertEquals(36, Types.SHORT.read(output).intValue());
+                    displayedCount.set(VersionedTypes.V26_3.item.read(output).amount());
+                    assertEquals(0, output.readableBytes());
+                } finally {
+                    output.release();
+                }
+                return null;
+            }).when(update).send(BedrockProtocol.class);
+            try (var packets = mockStatic(PacketWrapper.class)) {
+                packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.CONTAINER_SET_SLOT, user)).thenReturn(update);
+                InteractionPackets.writeItemUse(request, new InventoryTransactionPacketType(() -> null, null),
+                        transaction, inventory);
+            }
+            assertEquals(count - 1, inventory.getItem(0).amount());
+            assertEquals(count - 1, displayedCount.get());
+        }
+    }
+
+}
