+    static void writeItemUse(final PacketWrapper wrapper, final Type<BedrockInventoryTransaction> transactionType,
+                             final BedrockInventoryTransaction transaction, final InventoryContainer inventory) {
+        wrapper.write(transactionType, transaction);
+        if (transaction.actions() == null || transaction.actions().isEmpty()) {
+            return;
         }
+        // Native commits its hotbar debit after the request; the resulting equipment update follows it.
+        wrapper.sendToServer(BedrockProtocol.class);
+        wrapper.cancel();
+        final var debit = transaction.actions().getFirst();
+        final BedrockItem remainder = inventory.getItem(debit.slot()).copy();
+        remainder.setAmount(debit.toItem().amount());
+        inventory.setItem(debit.slot(), remainder.isEmpty() ? BedrockItem.empty() : remainder);
+        // Java can send use while cooldown suppresses its local debit. Publish the core-owned prediction.
+        final PacketWrapper quantity = PacketWrapper.create(ClientboundPackets26_3.CONTAINER_SET_SLOT, wrapper.user());
+        quantity.write(Types.VAR_INT, (int) inventory.javaContainerId());
+        quantity.write(Types.VAR_INT, 0);
+        quantity.write(Types.SHORT, (short) inventory.javaSlot(debit.slot()));
+        quantity.write(VersionedTypes.V26_3.item, inventory.getJavaItem(debit.slot()));
+        quantity.send(BedrockProtocol.class);
