+    static void flushFlightItemUses(final PacketWrapper authInput, final ClientPlayerEntity player,
+                                    final Type<BedrockInventoryTransaction> transactionType) {
+        if (player.pendingFlightItemUses().isEmpty()) {
+            return;
+        }
+        // Establish this frame's glide start and movement before applying item use.
+        // Native air-use transactions are separate packets paired with the next input frame.
+        authInput.sendToServer(BedrockProtocol.class);
+        authInput.cancel();
+        while (!player.pendingFlightItemUses().isEmpty()) {
+            final PacketWrapper itemUse = authInput.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION);
+            itemUse.write(transactionType, player.pendingFlightItemUses().removeFirst());
+            itemUse.sendToServer(BedrockProtocol.class);
+        }
+    }
