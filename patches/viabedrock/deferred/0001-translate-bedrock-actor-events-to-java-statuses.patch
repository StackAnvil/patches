+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeParticleRangeTest {
+
+    @Test
+    void matchesNativeDistanceBoundariesAndGlobalScale() {
+        final int[] chunks = {0, 1, 4, 5, 6, 8, 16, 32};
+        final float[] viewDistance = {0F, 0.125F, 0.5F, 1F, 2F};
+        final float[][] nativeRadius = {
+                {32F, 33F, 36F, 40F, 48F}, {32F, 33F, 36F, 40F, 48F},
+                {32F, 33F, 36F, 40F, 48F}, {32F, 33F, 36F, 40F, 48F},
+                {32F, 34F, 40F, 48F, 64F}, {32F, 36F, 48F, 64F, 96F},
+                {32F, 36F, 48F, 64F, 96F}, {32F, 36F, 48F, 64F, 96F}
+        };
+        final Position3f camera = new Position3f(0F, 2F, 3F);
+        for (int c = 0; c < chunks.length; c++) {
+            for (int v = 0; v < viewDistance.length; v++) {
+                for (final boolean global : new boolean[]{false, true}) {
+                    final float radius = nativeRadius[c][v] * (global ? 5F : 1F);
+                    assertEquals(radius * radius, NativeParticleRange.radiusSquared(chunks[c], viewDistance[v], global));
+                    assertTrue(NativeParticleRange.contains(new Position3f(Math.nextDown(radius), 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                    assertTrue(NativeParticleRange.contains(new Position3f(radius, 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                    assertFalse(NativeParticleRange.contains(new Position3f(Math.nextUp(radius), 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                    assertTrue(NativeParticleRange.contains(new Position3f(Float.NaN, 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                    assertFalse(NativeParticleRange.contains(new Position3f(Float.POSITIVE_INFINITY, 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                    assertFalse(NativeParticleRange.contains(new Position3f(Float.NEGATIVE_INFINITY, 2F, 3F), camera, chunks[c], viewDistance[v], global));
+                }
+            }
+        }
+        assertFalse(NativeParticleRange.contains(camera, null, 8, 0F, false));
+        assertTrue(NativeParticleRange.contains(new Position3f(32F, 0F, 0F), new Position3f(0F, 0F, 0F), 8, 0F, false));
+        assertFalse(NativeParticleRange.contains(new Position3f(32F, 1F, 0F), new Position3f(0F, 0F, 0F), 8, 0F, false));
+    }
+
+    @Test
+    void preservesCameraSubtractionAndAxisAdditionRounding() {
+        final Position3f[] origins = {
+            new Position3f(4096F, 1F, 1F), new Position3f(1F, 4096F, 1F),
+            new Position3f(1F, 1F, 4096F), new Position3f(123.125F, -9.75F, 16.375F)
+        };
+        final Position3f[] cameras = {
+            new Position3f(0F, 0F, 0F), new Position3f(8.25F, -3.125F, 2.5F),
+            new Position3f(-1048576F, 2097152F, -4194304F)
+        };
+        final int[][] nativeBits = {
+                {1266679808, 1266612311, 1437077514}, {1266679808, 1266692640, 1437065229},
+                {1266679809, 1266659404, 1437089799}, {1181912032, 1179771568, 1437073616}
+        };
+        for (int origin = 0; origin < origins.length; origin++) {
+            for (int camera = 0; camera < cameras.length; camera++) {
+                assertEquals(nativeBits[origin][camera], Float.floatToRawIntBits(NativeParticleRange.distanceSquared(origins[origin], cameras[camera])));
+            }
+        }
+    }
+
+    @Test
+    void retainsContinuousValuesAndNativeChangeTolerance() {
+        assertEquals(0F, NativeParticleRange.DEFAULT_VIEW_DISTANCE);
+        assertEquals(0F, NativeParticleRange.updateViewDistance(0F, 0.001F));
+        assertEquals(0.0011F, NativeParticleRange.updateViewDistance(0F, 0.0011F));
+        assertEquals(0.125F, NativeParticleRange.updateViewDistance(0.125F, 0.1245F));
+        assertEquals(0.126F, NativeParticleRange.updateViewDistance(0.125F, 0.126F));
+        assertEquals(0F, NativeParticleRange.updateViewDistance(0.5F, -1F));
+        assertEquals(1F, NativeParticleRange.updateViewDistance(0.5F, 2F));
+        assertEquals(0.5F, NativeParticleRange.updateViewDistance(0.5F, Float.NaN));
+        assertEquals(1F, NativeParticleRange.updateViewDistance(0.5F, Float.POSITIVE_INFINITY));
+        assertEquals(0F, NativeParticleRange.updateViewDistance(0.5F, Float.NEGATIVE_INFINITY));
+    }
+
+}
