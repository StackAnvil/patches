+    static EntityEvent javaEntityEvent(final ActorEvent event, final EntityTypes26_3 javaEntityType) {
+        return switch (event) {
+            case TAMING_FAILED -> EntityEvent.TAMING_FAILED;
+            case TAMING_SUCCEEDED -> EntityEvent.TAMING_SUCCEEDED;
+            case SHAKE_WETNESS -> EntityEvent.SHAKE_WETNESS;
+            case EAT_GRASS -> EntityEvent.EAT_GRASS;
+            case ZOMBIE_CONVERTING -> EntityEvent.ZOMBIE_CONVERTING;
+            case START_OFFER_FLOWER -> EntityEvent.OFFER_FLOWER;
+            case STOP_OFFER_FLOWER -> EntityEvent.STOP_OFFER_FLOWER;
+            case LOVE_HEARTS -> javaEntityType.is(EntityTypes26_3.VILLAGER) ? EntityEvent.LOVE_HEARTS : EntityEvent.IN_LOVE_HEARTS;
+            case VILLAGER_ANGRY -> EntityEvent.VILLAGER_ANGRY;
+            case VILLAGER_HAPPY -> EntityEvent.VILLAGER_HAPPY;
+            case WITCH_HAT_MAGIC -> EntityEvent.WITCH_HAT_MAGIC;
+            case FIREWORKS_EXPLODE -> EntityEvent.FIREWORKS_EXPLODE;
+            case SILVERFISH_MERGE_ANIM -> EntityEvent.SILVERFISH_MERGE_ANIM;
+            case GUARDIAN_ATTACK_SOUND -> EntityEvent.GUARDIAN_ATTACK_SOUND;
+            case AIR_SUPPLY -> EntityEvent.DROWN_PARTICLES;
+            case SHAKE -> EntityEvent.SHAKE;
+            case INSTANT_DEATH -> EntityEvent.POOF;
+            case TALISMAN_ACTIVATE -> EntityEvent.PROTECTED_FROM_DEATH;
+            case TREASURE_HUNT -> EntityEvent.DOLPHIN_LOOKING_FOR_TREASURE;
+            case VIBRATION_DETECTED -> EntityEvent.TENDRILS_SHIVER;
+            case START_ATTACKING -> EntityEvent.START_ATTACKING;
+            case SHAKE_WETNESS_STOP -> EntityEvent.CANCEL_SHAKE_WETNESS;
+            default -> null;
+        };
+    }
+
     private EntityPackets() {
     }
 
