+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Fishing feedback retains the authoritative fish metadata and samples the current client hook. */
+public record NativeFishingEvent(int entityId, UUID uuid, Kind kind, float fishX, float fishZ, float fishAngle) {
+
+    public static final String CHANNEL = "viabedrock:fishing_event_v1";
+    /** Legacy WaterWake forwards to the named effect, so the two wake calls remain distinct. */
+    public static final List<String> BITE_EFFECTS = List.of("minecraft:fish_hook_particle",
+            "minecraft:water_wake_particle", "minecraft:water_wake_particle");
+    public static final Type<NativeFishingEvent> TYPE = new Type<>(NativeFishingEvent.class) {
+        @Override
+        public NativeFishingEvent read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 48 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported fishing event message");
+            }
+            final NativeFishingEvent message = new NativeFishingEvent(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer),
+                    Kind.fromId(buffer.readUnsignedByte()), buffer.readFloat(), buffer.readFloat(), buffer.readFloat());
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing fishing event data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeFishingEvent message) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, message.entityId);
+            Types.UUID.write(buffer, message.uuid);
+            buffer.writeByte(message.kind.id);
+            buffer.writeFloat(message.fishX);
+            buffer.writeFloat(message.fishZ);
+            buffer.writeFloat(message.fishAngle);
+        }
+    };
+
+    public NativeFishingEvent {
+        Objects.requireNonNull(uuid);
+        Objects.requireNonNull(kind);
+        if (!Float.isFinite(fishX) || !Float.isFinite(fishZ) || !Float.isFinite(fishAngle)) {
+            throw new IllegalArgumentException("Invalid fishing metadata");
+        }
+        if (entityId <= 0) {
+            throw new IllegalArgumentException("Invalid fishing hook entity ID");
+        }
+    }
+
+    /** Bedrock stores motion as floats and performs this addition in float precision. */
+    public static float verticalVelocity(final double current) {
+        return (float) current - 0.5F;
+    }
+
+    /** The native handler samples its current box, then emits at the next integral water surface. */
+    public static Position3f particleOrigin(final Position3f position, final float boxMinY) {
+        return new Position3f(position.x(), (float) Math.floor(boxMinY) + 1F, position.z());
+    }
+
+    /** Native Molang vector construction receives this float calculation without normalization. */
+    public static Position3f particleDirection(final float boxWidth) {
+        return new Position3f(20F * boxWidth + 1F, 0F, boxWidth);
+    }
+
+    public enum Kind {
+        APPROACH(12), BITE(13), TEASE(14);
+
+        private final int id;
+
+        Kind(final int id) {
+            this.id = id;
+        }
+
+        public static Kind fromId(final int id) {
+            return switch (id) {
+                case 12 -> APPROACH;
+                case 13 -> BITE;
+                case 14 -> TEASE;
+                default -> throw new IllegalArgumentException("Unknown fishing event: " + id);
+            };
+        }
+    }
+
+    public static NativeFishingEvent fromMetadata(final int entityId, final UUID uuid, final Kind kind,
+                                                  final Map<ActorDataIds, EntityData> metadata) {
+        return new NativeFishingEvent(entityId, uuid, kind, metadataFloat(metadata, ActorDataIds.FISHX),
+                metadataFloat(metadata, ActorDataIds.FISHZ), metadataFloat(metadata, ActorDataIds.FISHANGLE));
+    }
+
+    /** The native getter defaults absent and non-float entries to zero. Reject non-finite wire state. */
+    private static float metadataFloat(final Map<ActorDataIds, EntityData> metadata, final ActorDataIds id) {
+        final EntityData data = metadata.get(id);
+        return data != null && data.dataType() == EntityDataTypesBedrock.FLOAT && data.value() instanceof Float value
+                && Float.isFinite(value) ? value : 0F;
+    }
+
+    public Position3f waterPosition(final Position3f position, final float boxMinY) {
+        // Preserve both float additions from the native surface calculation before block flooring.
+        return new Position3f((float) Math.floor(position.x() + this.fishX),
+                (float) Math.floor((float) Math.floor(boxMinY) + 1F - 1F),
+                (float) Math.floor(position.z() + this.fishZ));
+    }
+
+    /** Named emissions bypass the legacy range gate. Preserve call order and independent directions. */
+    public List<Emission> particles(final Position3f position, final float boxMinY, final float boxWidth,
+                                    final float random, final boolean water) {
+        if (this.kind == Kind.BITE) {
+            final Position3f origin = particleOrigin(position, boxMinY);
+            final Position3f direction = particleDirection(boxWidth);
+            return List.of(new Emission(BITE_EFFECTS.getFirst(), origin, direction, false),
+                    new Emission(BITE_EFFECTS.get(1), origin, direction, true),
+                    new Emission(BITE_EFFECTS.getLast(), origin, direction, false));
+        }
+        if (this.kind == Kind.TEASE) {
+            return water ? List.of(new Emission("minecraft:water_splash_particle", this.waterPosition(position, boxMinY),
+                    new Position3f(0.1F, 0.1F, 0.1F), false)) : List.of();
+        }
+        final Position3f origin = new Position3f(position.x() + this.fishX,
+                (float) Math.floor(boxMinY) + 0.9F, position.z() + this.fishZ);
+        final float sine = BedrockTrigonometry.sine(this.fishAngle);
+        final float cosine = BedrockTrigonometry.cosine(this.fishAngle);
+        final List<Emission> effects = new ArrayList<>(3);
+        // UCOMISS followed by JBE also excludes unordered samples.
+        if (0.15F > random) {
+            effects.add(new Emission("minecraft:fish_pos_particle", origin, new Position3f(sine, 0.1F, cosine), false));
+        }
+        final float x = cosine * 0.004F;
+        final float z = sine * 0.004F;
+        effects.add(new Emission("minecraft:water_wake_particle", origin, new Position3f(-x, 0.01F, z), true));
+        effects.add(new Emission("minecraft:water_wake_particle", origin, new Position3f(x, 0.01F, -z), true));
+        return List.copyOf(effects);
+    }
+
+    public record Emission(String identifier, Position3f origin, Position3f direction, boolean legacy) { }
+
+}
