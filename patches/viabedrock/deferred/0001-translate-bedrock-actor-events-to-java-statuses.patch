+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.protocol.Protocol;
+import com.viaversion.viaversion.api.protocol.ProtocolManager;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntitySoundTest {
+
+    @Test
+    void matchesNativeSoundSuppressionAndActorArguments() throws Exception {
+        final var manager = Via.class.getDeclaredField("manager");
+        manager.setAccessible(true);
+        final Object previousManager = manager.get(null);
+        final List<PacketWrapper> sent = new ArrayList<>();
+        try {
+            final ProtocolManager protocols = proxy(ProtocolManager.class, (ignored, method, arguments) -> {
+                if (!method.getName().equals("createPacketWrapper")) {
+                    throw new AssertionError(method.getName());
+                }
+                return new PacketWrapperImpl(ClientboundBedrockPackets.LEVEL_SOUND_EVENT, null, null) {
+                    @Override
+                    public void send(final Class<? extends Protocol> protocol, final boolean skipCurrentPipeline) {
+                        assertSame(BedrockProtocol.class, protocol);
+                        assertFalse(skipCurrentPipeline);
+                        sent.add(this);
+                    }
+                };
+            });
+            manager.set(null, proxy(ViaManager.class, (ignored, method, arguments) -> protocols));
+            // Matching native cases include neighboring bits so they cannot conceal an off-by-one flag test.
+            for (final long flags : new long[]{0L, 1L << 11, 1L << 17, (1L << 11) | (1L << 17), 1L << 16, 1L << 18}) {
+                for (final long id : new long[]{-1L, -201863462911L, 1L, 1L << 62}) {
+                    for (final Position3f position : new Position3f[]{new Position3f(-0.125F, 0F, 0.25F),
+                        new Position3f(12.5F, -7.25F, 9F), new Position3f(-100F, 250F, 21F)}) {
+                        sent.clear();
+                        final Entity actor = new Entity(null, id, 1, "minecraft:fishing_hook", 2, UUID.randomUUID(), EntityTypes26_3.FISHING_BOBBER);
+                        actor.position = position;
+                        actor.entityData().put(ActorDataIds.RESERVED_0, new EntityData(0, EntityDataTypesBedrock.LONG, flags));
+                        actor.playSound("splash");
+                        if ((flags & (1L << 17)) != 0) {
+                            assertTrue(sent.isEmpty());
+                            continue;
+                        }
+                        assertEquals(1, sent.size());
+                        final PacketWrapper sound = sent.getFirst();
+                        assertEquals(position, sound.get(BedrockTypes.POSITION_3F, 0));
+                        assertEquals(-1, sound.get(BedrockTypes.VAR_INT, 0));
+                        assertEquals(id, sound.get(BedrockTypes.LONG_LE, 0));
+                        assertEquals((flags & (1L << 11)) != 0, sound.get(Types.BOOLEAN, 0));
+                        assertFalse(sound.get(Types.BOOLEAN, 1));
+                        assertNull(sound.get(BedrockTypes.OPTIONAL_POSITION_3F, 0));
+                    }
+                }
+            }
+        } finally {
+            manager.set(null, previousManager);
+        }
+    }
+
+    private static <T> T proxy(final Class<T> type, final InvocationHandler handler) {
+        return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type}, handler));
+    }
+
+}
