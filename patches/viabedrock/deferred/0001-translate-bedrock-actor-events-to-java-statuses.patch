+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonParser;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeFishingEventTest {
+
+    @Test
+    void preservesSpawnIdentityAndRejectsInvalidBodies() {
+        final var expected = new NativeFishingEvent(Integer.MAX_VALUE, UUID.randomUUID(), NativeFishingEvent.Kind.APPROACH, 0.875F, -0.5F, 7F);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeFishingEvent.TYPE.write(buffer, expected);
+            assertEquals(expected, NativeFishingEvent.TYPE.read(buffer));
+            buffer.clear();
+            NativeFishingEvent.TYPE.write(buffer, expected);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeFishingEvent.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeFishingEvent.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeFishingEvent.TYPE.read(buffer));
+            buffer.clear();
+            buffer.writeZero(49);
+            assertThrows(IllegalArgumentException.class, () -> NativeFishingEvent.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new NativeFishingEvent(0, expected.uuid(), expected.kind(), 0, 0, 0));
+            assertThrows(IllegalArgumentException.class, () -> new NativeFishingEvent(-1, expected.uuid(), expected.kind(), 0, 0, 0));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void matchesNativeFloatAdditionForExistingMotion() {
+        final double[] input = {0D, -0D, 0.4D, -0.4D, 1D, -1D, 0.00001D, -0.00001D};
+        final int[] nativeBits = {0xBF000000, 0xBF000000, 0xBDCCCCCC, 0xBF666666,
+            0x3F000000, 0xBFC00000, 0xBEFFFEB0, 0xBF0000A8};
+        for (int index = 0; index < input.length; index++) {
+            assertEquals(nativeBits[index], Float.floatToRawIntBits(NativeFishingEvent.verticalVelocity(input[index])));
+        }
+    }
+
+    @Test
+    void preservesNativeSurfaceFloorAndUnnormalizedWidthVector() {
+        final float[] minY = {-3.75F, -3F, -0.01F, 0F, 0.99F, 4.25F};
+        final float[] surface = {-3F, -2F, 0F, 1F, 1F, 5F};
+        final float[] width = {0.125F, 0.25F, 0.5F, 1F, 2F};
+        final float[] directionX = {3.5F, 6F, 11F, 21F, 41F};
+        final Position3f position = new Position3f(12.5F, 7F, -21.25F);
+        for (int height = 0; height < minY.length; height++) {
+            final Position3f origin = NativeFishingEvent.particleOrigin(position, minY[height]);
+            assertEquals(new Position3f(position.x(), surface[height], position.z()), origin);
+            for (int size = 0; size < width.length; size++) {
+                assertEquals(new Position3f(directionX[size], 0F, width[size]), NativeFishingEvent.particleDirection(width[size]));
+            }
+        }
+    }
+
+    @Test
+    void approachPreservesThresholdOppositeWakesAndSignedZero() {
+        final var event = new NativeFishingEvent(1, UUID.randomUUID(), NativeFishingEvent.Kind.APPROACH, 0.875F, -0.5F, 0F);
+        final Position3f position = new Position3f(12.5F, 7F, -21.25F);
+        final var all = event.particles(position, -3.75F, 0.15F, Math.nextDown(0.15F), false);
+        assertEquals(3, all.size());
+        assertEquals(new Position3f(13.375F, -3.1F, -21.75F), all.getFirst().origin());
+        assertFalse(all.getFirst().legacy());
+        assertTrue(all.get(1).legacy());
+        assertEquals(new Position3f(-0.004F, 0.01F, 0F), all.get(1).direction());
+        assertEquals(new Position3f(0.004F, 0.01F, -0F), all.get(2).direction());
+        for (final float sample : new float[]{0.15F, 1F, Float.NaN}) {
+            assertEquals(all.subList(1, 3), event.particles(position, -3.75F, 0.15F, sample, false));
+        }
+    }
+
+    @Test
+    void teaseFloorsOffsetWaterBlockAndRequiresWater() {
+        final var event = new NativeFishingEvent(1, UUID.randomUUID(), NativeFishingEvent.Kind.TEASE, 0.875F, -0.5F, 7F);
+        final Position3f position = new Position3f(12.5F, 7F, -21.25F);
+        assertEquals(new Position3f(13F, -4F, -22F), event.waterPosition(position, -3.75F));
+        assertTrue(event.particles(position, -3.75F, 0.15F, 0F, false).isEmpty());
+        final var effects = event.particles(position, -3.75F, 0.15F, 0F, true);
+        assertEquals(1, effects.size());
+        assertEquals(event.waterPosition(position, -3.75F), effects.getFirst().origin());
+        assertEquals(new Position3f(0.1F, 0.1F, 0.1F), effects.getFirst().direction());
+        assertFalse(effects.getFirst().legacy());
+    }
+
+    @Test
+    void metadataDefaultsWrongTypesAndRetainsFloatOffsets() {
+        final UUID uuid = UUID.randomUUID();
+        final var metadata = Map.of(
+                ActorDataIds.FISHX, new EntityData(33, EntityDataTypesBedrock.FLOAT, 0.875F),
+                ActorDataIds.FISHZ, new EntityData(34, EntityDataTypesBedrock.INT, 3),
+                ActorDataIds.FISHANGLE, new EntityData(35, EntityDataTypesBedrock.FLOAT, Float.NaN));
+        assertEquals(new NativeFishingEvent(1, uuid, NativeFishingEvent.Kind.APPROACH, 0.875F, 0F, 0F),
+                NativeFishingEvent.fromMetadata(1, uuid, NativeFishingEvent.Kind.APPROACH, metadata));
+        assertThrows(IllegalArgumentException.class, () -> NativeFishingEvent.Kind.fromId(11));
+        assertThrows(IllegalArgumentException.class, () -> new NativeFishingEvent(1, uuid, NativeFishingEvent.Kind.BITE,
+                Float.POSITIVE_INFINITY, 0, 0));
+    }
+
+    @Test
+    void matchesPinnedNativeApproachAndTeaseExecution() throws IOException {
+        final String directory = System.getenv("STACKANVIL_FISHING_REFERENCE");
+        Assumptions.assumeTrue(directory != null);
+        final var root = JsonParser.parseString(Files.readString(Path.of(directory, "native-approach-results.json"))).getAsJsonObject();
+        assertEquals(2193, root.get("protocol").getAsInt());
+        int count = 0;
+        for (final var value : root.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            final boolean typed = !row.get("metadataType").isJsonNull() && row.get("metadataType").getAsInt() == 3;
+            final var event = new NativeFishingEvent(1, new UUID(0, 1), NativeFishingEvent.Kind.fromId(row.get("event").getAsInt()),
+                    typed ? 0.875F : 0F, typed ? -0.5F : 0F, typed ? row.get("angle").getAsFloat() : 0F);
+            final var effects = event.particles(new Position3f(12.5F, 7F, -21.25F), row.get("boxMinY").getAsFloat(),
+                    0.15F, row.get("random").getAsFloat(), row.get("water").getAsBoolean());
+            final var named = row.getAsJsonArray("named");
+            final var legacy = row.getAsJsonArray("legacy");
+            assertEquals(named.size() + legacy.size(), effects.size());
+            int namedIndex = 0;
+            int legacyIndex = 0;
+            for (final var effect : effects) {
+                final var nativeEffect = (effect.legacy() ? legacy.get(legacyIndex++) : named.get(namedIndex++)).getAsJsonObject();
+                final var origin = nativeEffect.getAsJsonArray("position");
+                assertEquals(new Position3f(origin.get(0).getAsFloat(), origin.get(1).getAsFloat(), origin.get(2).getAsFloat()), effect.origin());
+                if (effect.legacy()) {
+                    assertEquals(27, nativeEffect.get("event").getAsInt());
+                    final var direction = nativeEffect.getAsJsonArray("direction");
+                    assertEquals(new Position3f(direction.get(0).getAsFloat(), direction.get(1).getAsFloat(), direction.get(2).getAsFloat()), effect.direction());
+                } else if (event.kind() == NativeFishingEvent.Kind.APPROACH) {
+                    final var direction = row.getAsJsonArray("vectors").get(0).getAsJsonArray();
+                    assertEquals(new Position3f(direction.get(0).getAsFloat(), direction.get(1).getAsFloat(), direction.get(2).getAsFloat()), effect.direction());
+                }
+            }
+            count++;
+        }
+        assertEquals(root.get("count").getAsInt(), count);
+    }
+
+}
