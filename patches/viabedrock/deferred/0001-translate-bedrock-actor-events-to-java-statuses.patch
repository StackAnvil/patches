+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** The native legacy particle path uses the rendered camera and two independent distance settings. */
+public final class NativeParticleRange {
+
+    public static final float DEFAULT_VIEW_DISTANCE = 0F;
+    private static final float CHANGE_TOLERANCE = 0.001F;
+
+    private NativeParticleRange() {
+    }
+
+    /** This is a change tolerance, not a quantization step. Unordered comparisons retain the current value. */
+    public static float updateViewDistance(final float current, final float requested) {
+        if (!(Math.abs(current - requested) > CHANGE_TOLERANCE)) {
+            return current;
+        }
+        return Math.clamp(requested, 0F, 1F);
+    }
+
+    public static float radiusSquared(final int renderDistanceChunks, final float particleViewDistance, final boolean global) {
+        float radius = (Math.clamp((float) (renderDistanceChunks << 4) * 0.5F, 40F, 64F) - 32F) * particleViewDistance + 32F;
+        if (global) {
+            radius *= 5F;
+        }
+        return radius * radius;
+    }
+
+    /** Float subtraction and addition order match the native camera-distance getter. */
+    public static float distanceSquared(final Position3f origin, final Position3f camera) {
+        final float x = origin.x() - camera.x();
+        final float y = origin.y() - camera.y();
+        final float z = origin.z() - camera.z();
+        return z * z + (y * y + x * x);
+    }
+
+    public static boolean contains(final Position3f origin, final Position3f camera, final int renderDistanceChunks,
+                                   final float particleViewDistance, final boolean global) {
+        // Native has no particle provider before a rendered camera exists. Its JBE also admits unordered distances.
+        return camera != null && !(distanceSquared(origin, camera) > radiusSquared(renderDistanceChunks, particleViewDistance, global));
+    }
+
+}
