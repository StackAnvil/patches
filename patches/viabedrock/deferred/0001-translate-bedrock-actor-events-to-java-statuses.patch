+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ActorEvent;
+import net.raphimc.viabedrock.protocol.data.enums.java.EntityEvent;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class EntityPacketsTest {
+
+    @Test
+    void loveHeartsUsesTheJavaEntityType() {
+        assertEquals(EntityEvent.LOVE_HEARTS, EntityPackets.javaEntityEvent(ActorEvent.LOVE_HEARTS, EntityTypes26_3.VILLAGER));
+        assertEquals(EntityEvent.IN_LOVE_HEARTS, EntityPackets.javaEntityEvent(ActorEvent.LOVE_HEARTS, EntityTypes26_3.PIG));
+    }
+
+    @Test
+    void eventsWithoutImplementedOutputAreDiscarded() {
+        assertNull(EntityPackets.javaEntityEvent(ActorEvent.GUARDIAN_MINING_FATIGUE, EntityTypes26_3.ELDER_GUARDIAN));
+        assertNull(EntityPackets.javaEntityEvent(ActorEvent.DRAGON_START_DEATH_ANIM, EntityTypes26_3.ENDER_DRAGON));
+        assertNull(EntityPackets.javaEntityEvent(ActorEvent.IN_LOVE_HEARTS, EntityTypes26_3.PIG));
+    }
+
+    @Test
+    void targetRocketAndCrossbowWireEventsRetainTheirSparseIds() {
+        assertEquals(EntityEvent.FIREWORKS_EXPLODE,
+                EntityPackets.javaEntityEvent(ActorEvent.getByValue(25), EntityTypes26_3.FIREWORK_ROCKET));
+        assertEquals(ActorEvent.WITCH_HAT_MAGIC, ActorEvent.getByValue(24));
+        assertEquals(ActorEvent.FINISHED_CHARGING_ITEM, ActorEvent.getByValue(74));
+        assertEquals(ActorEvent.FEED, ActorEvent.getByValue(57));
+        assertEquals(ActorEvent.TALISMAN_ACTIVATE, ActorEvent.getByValue(65));
+    }
+
+    @Test
+    void protocol2193ActorEventIdsTranslateToJavaStatuses() {
+        assertEquals(EntityEvent.EAT_GRASS,
+                EntityPackets.javaEntityEvent(ActorEvent.getByValue(10), EntityTypes26_3.SHEEP));
+        assertEquals(EntityEvent.POOF,
+                EntityPackets.javaEntityEvent(ActorEvent.getByValue(61), EntityTypes26_3.PIG));
+        assertEquals(EntityEvent.TENDRILS_SHIVER,
+                EntityPackets.javaEntityEvent(ActorEvent.getByValue(77), EntityTypes26_3.PIG));
+    }
+
+}
