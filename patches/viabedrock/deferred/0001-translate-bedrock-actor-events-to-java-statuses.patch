+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** A native bite adds an impulse to the client's current hook motion. */
+public record NativeFishingBite(int entityId, UUID uuid) {
+
+    public static final String CHANNEL = "viabedrock:fishing_bite_v1";
+    public static final Type<NativeFishingBite> TYPE = new Type<>(NativeFishingBite.class) {
+        @Override
+        public NativeFishingBite read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 32 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported fishing bite message");
+            }
+            final NativeFishingBite message = new NativeFishingBite(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing fishing bite data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeFishingBite message) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, message.entityId);
+            Types.UUID.write(buffer, message.uuid);
+        }
+    };
+
+    public NativeFishingBite {
+        Objects.requireNonNull(uuid);
+        if (entityId <= 0) {
+            throw new IllegalArgumentException("Invalid fishing hook entity ID");
+        }
+    }
+
+    /** Bedrock stores motion as floats and performs this addition in float precision. */
+    public static float verticalVelocity(final double current) {
+        return (float) current - 0.5F;
+    }
+
+}
