From 05f55473a8d3d13573565c5f82e74c0168e79c90 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 00:11:24 +0200
Subject: [PATCH] feat(entity-events): translate Bedrock actor events to Java
 statuses

Forward supported actor feedback through the current Java 26.3 status packet so taming, shaking, breeding, and other entity effects appear in the client. Preserve damage and death handling, add the missing non-player death effect, and cancel events without a translated output. Keep the mapping in a switch so unsupported Bedrock events remain explicit.

Preserve the upstream sparse ActorEvent wire IDs. Protocol documentation
renumbered omitted enum entries sequentially, but target BDS 1.26.51.1
build 51061372/protocol 2193 sends rocket explosion 25 and finished crossbow
charging 74. Matching native rocket code 143346100 also emits 25. Restore
the upstream IDs instead of applying the misleading documentation values.
Raw-ID translation tests cover the low and high sparse ranges, explosions,
totem feedback and charge completion. Raw evidence remains private.
---
 .../viabedrock/api/model/entity/Entity.java   |  2 +-
 .../protocol/packet/EntityPackets.java        | 40 +++++++++++-
 .../protocol/packet/EntityPacketsTest.java    | 63 +++++++++++++++++++
 3 files changed, 101 insertions(+), 4 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/EntityPacketsTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
index 830fc8d36..cf2576c19 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
@@ -162,7 +162,7 @@ public class Entity {
         levelSoundEvent.write(BedrockTypes.POSITION_3F, this.position); // position
         levelSoundEvent.write(BedrockTypes.VAR_INT, 0); // data
         levelSoundEvent.write(BedrockTypes.STRING, this.type); // entity identifier
-        levelSoundEvent.write(Types.BOOLEAN, false); // is baby mob
+        levelSoundEvent.write(Types.BOOLEAN, this.entityFlags().contains(ActorFlags.BABY)); // is baby mob
         levelSoundEvent.write(Types.BOOLEAN, false); // is global sound
         levelSoundEvent.write(BedrockTypes.LONG_LE, -1L); // entity unique id
         levelSoundEvent.write(BedrockTypes.OPTIONAL_POSITION_3F, null); // fire at position
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
index b066520bd..56ed15de4 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
@@ -49,6 +49,7 @@ import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
 import net.raphimc.viabedrock.protocol.data.enums.Direction;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.*;
 import net.raphimc.viabedrock.protocol.data.enums.java.AnimateAction;
+import net.raphimc.viabedrock.protocol.data.enums.java.EntityEvent;
 import net.raphimc.viabedrock.protocol.data.enums.java.Relative;
 import net.raphimc.viabedrock.protocol.data.enums.java.generated.EquipmentSlot;
 import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
@@ -502,12 +503,17 @@ public final class EntityPackets {
                     }
                     if (entity != entityTracker.getClientPlayer()) {
                         entity.playSound("death");
+                        PacketFactory.sendJavaEntityEvent(wrapper.user(), entity, EntityEvent.POOF);
                     }
                 }
                 default -> {
-                    wrapper.cancel();
-                    // TODO: Handle remaining events
-                    // throw new IllegalStateException("Unhandled ActorEvent: " + event);
+                    final EntityEvent javaEvent = javaEntityEvent(event, entity.javaType());
+                    if (javaEvent == null) {
+                        wrapper.cancel();
+                    } else {
+                        wrapper.write(Types.INT, entity.javaId()); // entity id
+                        wrapper.write(Types.BYTE, javaEvent.getValue()); // event
+                    }
                 }
             }
         });
@@ -701,6 +707,34 @@ public final class EntityPackets {
         return entity;
     }
 
+    static EntityEvent javaEntityEvent(final ActorEvent event, final EntityTypes26_3 javaEntityType) {
+        return switch (event) {
+            case TAMING_FAILED -> EntityEvent.TAMING_FAILED;
+            case TAMING_SUCCEEDED -> EntityEvent.TAMING_SUCCEEDED;
+            case SHAKE_WETNESS -> EntityEvent.SHAKE_WETNESS;
+            case EAT_GRASS -> EntityEvent.EAT_GRASS;
+            case ZOMBIE_CONVERTING -> EntityEvent.ZOMBIE_CONVERTING;
+            case START_OFFER_FLOWER -> EntityEvent.OFFER_FLOWER;
+            case STOP_OFFER_FLOWER -> EntityEvent.STOP_OFFER_FLOWER;
+            case LOVE_HEARTS -> javaEntityType.is(EntityTypes26_3.VILLAGER) ? EntityEvent.LOVE_HEARTS : EntityEvent.IN_LOVE_HEARTS;
+            case VILLAGER_ANGRY -> EntityEvent.VILLAGER_ANGRY;
+            case VILLAGER_HAPPY -> EntityEvent.VILLAGER_HAPPY;
+            case WITCH_HAT_MAGIC -> EntityEvent.WITCH_HAT_MAGIC;
+            case FIREWORKS_EXPLODE -> EntityEvent.FIREWORKS_EXPLODE;
+            case SILVERFISH_MERGE_ANIM -> EntityEvent.SILVERFISH_MERGE_ANIM;
+            case GUARDIAN_ATTACK_SOUND -> EntityEvent.GUARDIAN_ATTACK_SOUND;
+            case AIR_SUPPLY -> EntityEvent.DROWN_PARTICLES;
+            case SHAKE -> EntityEvent.SHAKE;
+            case INSTANT_DEATH -> EntityEvent.POOF;
+            case TALISMAN_ACTIVATE -> EntityEvent.PROTECTED_FROM_DEATH;
+            case TREASURE_HUNT -> EntityEvent.DOLPHIN_LOOKING_FOR_TREASURE;
+            case VIBRATION_DETECTED -> EntityEvent.TENDRILS_SHIVER;
+            case START_ATTACKING -> EntityEvent.START_ATTACKING;
+            case SHAKE_WETNESS_STOP -> EntityEvent.CANCEL_SHAKE_WETNESS;
+            default -> null;
+        };
+    }
+
     private EntityPackets() {
     }
 
