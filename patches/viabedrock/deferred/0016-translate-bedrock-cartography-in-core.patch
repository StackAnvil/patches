@@ -0,0 +1,37 @@
+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class CartographyStateTest {
+
+    @Test
+    void preservesWindowAndEditAcknowledgementsAcrossWireRoundTrip() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var state = new CartographyState(-1, 7, "clone", "Area 🌍");
+            CartographyState.TYPE.write(buffer, state);
+            assertEquals(state, CartographyState.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnsupportedVersionsAndUnboundedState() {
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeByte(2);
+            assertThrows(IllegalArgumentException.class, () -> CartographyState.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+        assertThrows(IllegalArgumentException.class, () -> new CartographyState(256, 0, "empty", ""));
+        assertThrows(IllegalArgumentException.class, () -> new CartographyState(1, -1, "empty", ""));
+        assertThrows(IllegalArgumentException.class, () -> new CartographyState(1, 0, "empty", "x".repeat(513)));
+    }
+
+}
