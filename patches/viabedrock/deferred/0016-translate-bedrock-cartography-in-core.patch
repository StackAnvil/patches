+package net.raphimc.viabedrock.api.model.container.block;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.MultiRecipe;
+import net.raphimc.viabedrock.protocol.model.recipe.ShapelessRecipe;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.storage.MapTracker;
+
+import java.util.List;
+import java.util.UUID;
+import java.util.function.BiPredicate;
+
+final class CartographyRecipes {
+
+    static Selection select(final List<CraftingDataStorage> recipes, final BedrockItem input, final String inputName,
+                            final BedrockItem additional, final String additionalName, final MapTracker.MapData map,
+                            final List<Long> family, final String name,
+                            final BiPredicate<ItemDescriptor, BedrockItem> matches) {
+        if (input.isEmpty()) {
+            if (additional.isEmpty()) {
+                return null;
+            }
+            final Selection swapped = select(recipes, additional, additionalName, input, inputName,
+                    map, family, name, matches);
+            return swapped == null ? null : new Selection(swapped.operation(), swapped.networkId(),
+                    swapped.result(), swapped.additionalCount(), swapped.inputCount());
+        }
+        if ("minecraft:paper".equals(inputName)) {
+            final boolean locator = "minecraft:compass".equals(additionalName);
+            if (!additional.isEmpty() && !locator) {
+                return null;
+            }
+            final String id = locator ? "minecraft:cartography_table_locator_map" : "minecraft:cartography_table_map";
+            for (final CraftingDataStorage entry : recipes) {
+                if (entry.recipe() instanceof ShapelessRecipe recipe && recipe.getUniqueId().equals(id)
+                        && recipe.getRecipeTag().equals("cartography_table") && recipe.getResults().size() == 1) {
+                    int inputCount = 0;
+                    int additionalCount = 0;
+                    boolean valid = true;
+                    for (final ItemDescriptor ingredient : recipe.getIngredients()) {
+                        if (matches.test(ingredient, input)) {
+                            inputCount += ingredient.amount();
+                        } else if (matches.test(ingredient, additional)) {
+                            additionalCount += ingredient.amount();
+                        } else {
+                            valid = false;
+                        }
+                    }
+                    if (valid && inputCount > 0 && input.amount() >= inputCount
+                            && additional.amount() >= additionalCount && locator == (additionalCount > 0)) {
+                        return new Selection(locator ? Operation.CREATE_LOCATOR : Operation.CREATE,
+                                entry.networkId(), named(recipe.getResults().get(0).copy(), name), inputCount, additionalCount);
+                    }
+                }
+            }
+            return null;
+        }
+        final boolean filled = "minecraft:filled_map".equals(inputName);
+        if (!filled && !"minecraft:empty_map".equals(inputName)) {
+            return null;
+        }
+        final Operation operation;
+        if (additional.isEmpty()) {
+            final BedrockItem result = input.copy();
+            result.setAmount(1);
+            return new Selection(Operation.RENAME, 0, named(result, name), 1, 0);
+        } else if ("minecraft:empty_map".equals(additionalName) && filled) {
+            operation = Operation.CLONE;
+        } else if ("minecraft:paper".equals(additionalName) && filled
+                && map != null && !map.locked() && map.scale() != null && map.scale() < 4) {
+            operation = Operation.EXTEND;
+        } else if ("minecraft:glass_pane".equals(additionalName) && filled
+                && map != null && !map.locked() && mapId(input) != null) {
+            operation = Operation.LOCK;
+        } else if ("minecraft:compass".equals(additionalName) && !hasLocator(input, filled)) {
+            operation = Operation.LOCATOR;
+        } else {
+            return null;
+        }
+        final UUID recipeId = switch (operation) {
+            case CLONE -> UUID.fromString("442d85ed-8272-4543-a6f1-418f90ded05d");
+            case EXTEND -> UUID.fromString("8b36268c-1829-483c-a0f1-993b7156a8f2");
+            case LOCK -> UUID.fromString("602234e4-cac1-4353-8bb7-b1ebff70024b");
+            case LOCATOR -> UUID.fromString("98c84b38-1085-46bd-b1ce-dd38c159e6cc");
+            default -> throw new IllegalStateException("Unexpected cartography operation: " + operation);
+        };
+        for (final CraftingDataStorage recipe : recipes) {
+            if (!(recipe.recipe() instanceof MultiRecipe) || !recipe.recipe().getRecipeId().equals(recipeId)) {
+                continue;
+            }
+            final BedrockItem result = input.copy();
+            result.setAmount(operation == Operation.CLONE ? 2 : 1);
+            if (operation == Operation.EXTEND) {
+                final Long id = mapId(input);
+                final int index = family.indexOf(id);
+                if (index >= 0 && index + 1 < family.size()) {
+                    result.tag().putLong("map_uuid", family.get(index + 1));
+                }
+            } else if (operation == Operation.LOCATOR) {
+                if (filled) {
+                    final CompoundTag tag = result.tag() == null ? new CompoundTag() : result.tag();
+                    tag.putByte("map_display_players", (byte) 1);
+                    result.setTag(tag);
+                } else {
+                    result.setData(2);
+                }
+            } else if (operation == Operation.LOCK) {
+                result.setData(6);
+            }
+            return new Selection(operation, recipe.networkId(), named(result, name), 1, 1);
+        }
+        return null;
+    }
+
+    static Long mapId(final BedrockItem item) {
+        return item.tag() != null && item.tag().get("map_uuid") instanceof NumberTag number ? number.asLong() : null;
+    }
+
+    private static boolean hasLocator(final BedrockItem map, final boolean filled) {
+        return filled ? map.tag() != null && map.tag().get("map_display_players") instanceof NumberTag flag && flag.asByte() != 0
+                : map.data() == 2;
+    }
+
+    private static BedrockItem named(final BedrockItem item, final String name) {
+        final CompoundTag tag = item.tag() == null ? new CompoundTag() : item.tag();
+        CompoundTag display = tag.getCompoundTag("display");
+        if (!name.isEmpty()) {
+            if (display == null) {
+                display = new CompoundTag();
+                tag.put("display", display);
+            }
+            display.putString("Name", name);
+        } else if (display != null) {
+            display.remove("Name");
+            if (display.isEmpty()) {
+                tag.remove("display");
+            }
+        }
+        item.setTag(tag.isEmpty() ? null : tag);
+        item.setNetId(null);
+        return item;
+    }
+
+    private CartographyRecipes() {
+    }
+
+    enum Operation {
+        CREATE, CREATE_LOCATOR, RENAME, CLONE, EXTEND, LOCK, LOCATOR
+    }
+
+    record Selection(Operation operation, int networkId, BedrockItem result, int inputCount, int additionalCount) { }
+
+}
