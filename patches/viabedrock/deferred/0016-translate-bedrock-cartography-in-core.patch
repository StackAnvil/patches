+import net.raphimc.viabedrock.protocol.storage.CraftingDataStorage;
+import net.raphimc.viabedrock.protocol.storage.MapTracker;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CartographyRecipesTest {
+
+    @Test
+    void usesAdvertisedCreationOutputAndIngredientCountsInEitherSingleSlot() {
+        final BedrockItem paper = item(1, 3);
+        final BedrockItem output = item(2, 1);
+        final var recipe = new ShapelessRecipe("minecraft:cartography_table_map", UUID.randomUUID(), "cartography_table", 0,
+                List.of(new ItemDescriptor.ItemNameDescriptor("minecraft:paper", 0, 2)), List.of(output));
+        final var recipes = List.of(new CraftingDataStorage(RecipeType.SHAPELESS, 912, recipe, false));
+        final var first = select(recipes, paper, "minecraft:paper", BedrockItem.empty(), null, null, List.of(), "");
+        assertNotNull(first);
+        assertEquals(912, first.networkId());
+        assertEquals(2, first.inputCount());
+        assertEquals(0, first.additionalCount());
+        assertEquals(output.identifier(), first.result().identifier());
+        assertNull(first.result().netId());
+        final var lower = select(recipes, BedrockItem.empty(), null, paper, "minecraft:paper", null, List.of(), "");
+        assertEquals(0, lower.inputCount());
+        assertEquals(2, lower.additionalCount());
+        assertNull(select(recipes, item(1, 1), "minecraft:paper", BedrockItem.empty(), null, null, List.of(), ""));
+        assertNull(select(List.of(), paper, "minecraft:paper", BedrockItem.empty(), null, null, List.of(), ""));
+    }
+
+    @Test
+    void extendsOnlyUnlockedMapsWithKnownScaleAndUsesSparseServerFamilies() {
+        final BedrockItem map = map(400, false);
+        final var recipes = dynamic("8b36268c-1829-483c-a0f1-993b7156a8f2", 77);
+        final BedrockItem paper = item(1, 4);
+        final var data = new MapTracker.MapData((byte) 0, false, new BlockPosition(0, 0, 0), (byte) 2, List.of());
+        final var result = select(recipes, map, "minecraft:filled_map", paper, "minecraft:paper", data,
+                List.of(5L, 70L, 400L, -19L, 6L), "");
+        assertEquals(-19L, CartographyRecipes.mapId(result.result()));
+        assertEquals(400L, CartographyRecipes.mapId(map));
+        assertEquals(77, result.networkId());
+        assertNull(select(recipes, map, "minecraft:filled_map", paper, "minecraft:paper", null, List.of(), ""));
+        for (final Byte scale : new Byte[]{null, 4}) {
+            final var unknownOrMaximum = new MapTracker.MapData((byte) 0, false, data.origin(), scale, List.of());
+            assertNull(select(recipes, map, "minecraft:filled_map", paper, "minecraft:paper", unknownOrMaximum, List.of(), ""));
+        }
+        final var locked = new MapTracker.MapData((byte) 0, true, data.origin(), (byte) 2, List.of());
+        assertNull(select(recipes, map, "minecraft:filled_map", paper, "minecraft:paper", locked, List.of(), ""));
+        final var absentFamily = select(recipes, map, "minecraft:filled_map", paper, "minecraft:paper", data, List.of(), "");
+        assertEquals(400L, CartographyRecipes.mapId(absentFamily.result()));
+    }
+
+    @Test
+    void clonesAndRenamesWithoutMutatingInputOrReusingItsNetworkIdentity() {
+        final BedrockItem map = map(700, false);
+        final CompoundTag display = new CompoundTag();
+        display.putString("Name", "old");
+        map.tag().put("display", display);
+        final var clone = select(dynamic("442d85ed-8272-4543-a6f1-418f90ded05d", 81), map,
+                "minecraft:filled_map", item(2, 8), "minecraft:empty_map", null, List.of(), "new");
+        assertEquals(2, clone.result().amount());
+        assertEquals(1, clone.inputCount());
+        assertEquals(1, clone.additionalCount());
+        assertNull(clone.result().netId());
+        assertEquals("new", clone.result().tag().getCompoundTag("display").getString("Name"));
+        assertEquals("old", display.getString("Name"));
+        final var rename = select(List.of(), BedrockItem.empty(), null, map, "minecraft:filled_map", null, List.of(), "");
+        assertEquals(0, rename.networkId());
+        assertEquals(1, rename.additionalCount());
+        assertNull(rename.result().tag().get("display"));
+        assertEquals(700L, CartographyRecipes.mapId(rename.result()));
+    }
+
+    @Test
+    void convertsEmptyAndFilledLocatorsAndRejectsAlreadyConvertedMaps() {
+        final var recipes = dynamic("98c84b38-1085-46bd-b1ce-dd38c159e6cc", 95);
+        final BedrockItem compass = item(3, 5);
+        final var empty = select(recipes, item(2, 4), "minecraft:empty_map", compass, "minecraft:compass", null, List.of(), "");
+        assertEquals(2, empty.result().data());
+        assertNull(select(recipes, empty.result(), "minecraft:empty_map", compass, "minecraft:compass", null, List.of(), ""));
+        final var filled = select(recipes, map(40, false), "minecraft:filled_map", compass, "minecraft:compass", null, List.of(), "");
+        assertEquals(40L, CartographyRecipes.mapId(filled.result()));
+        assertEquals(1, filled.result().tag().getByte("map_display_players"));
+        assertNull(select(recipes, filled.result(), "minecraft:filled_map", compass, "minecraft:compass", null, List.of(), ""));
+        assertNull(select(recipes, item(2, 1), "minecraft:empty_map", item(1, 1), "minecraft:paper", null, List.of(), ""));
+    }
+
+    @Test
+    void locksOnlyKnownUnlockedMapsAndRetainsTheirTagsForAuthoritativeRefresh() {
+        final BedrockItem map = map(40, false);
+        map.tag().putByte("map_is_init", (byte) 1);
+        final BedrockItem glass = item(5, 2);
+        final var recipes = dynamic("602234e4-cac1-4353-8bb7-b1ebff70024b", 19);
+        final var data = new MapTracker.MapData((byte) 0, false, new BlockPosition(0, 0, 0), (byte) 1, List.of());
+        final var locked = select(recipes, map, "minecraft:filled_map", glass, "minecraft:glass_pane", data, List.of(), "");
+        assertEquals(6, locked.result().data());
+        assertEquals(1, locked.result().tag().getByte("map_is_init"));
+        assertEquals(40L, CartographyRecipes.mapId(locked.result()));
+        assertEquals(0, map.data());
+        assertNull(select(recipes, map, "minecraft:filled_map", glass, "minecraft:glass_pane", null, List.of(), ""));
+        final var lockedData = new MapTracker.MapData((byte) 0, true, data.origin(), (byte) 1, List.of());
+        assertNull(select(recipes, map, "minecraft:filled_map", glass, "minecraft:glass_pane", lockedData, List.of(), ""));
+    }
+
+    @Test
+    void constructsCreatedOutputRequestsAndOmitsUnusedLowerOrUpperInputs() {
+        final var cursor = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CursorContainer, null), (byte) 0, 0);
+        final var selection = new CartographyRecipes.Selection(CartographyRecipes.Operation.RENAME, 0, item(2, 1), 0, 1);
+        final BedrockItem lower = item(2, 4);
+        final var actions = CartographyContainer.resultActions(selection, BedrockItem.empty(), lower, -7, cursor, false);
+        assertEquals(3, actions.size());
+        assertEquals(0, assertInstanceOf(ItemStackRequestAction.CraftRecipeOptionalAction.class, actions.get(0)).recipeNetworkId());
+        final var consume = assertInstanceOf(ItemStackRequestAction.ConsumeAction.class, actions.get(1));
+        assertEquals(1, consume.count());
+        assertEquals(13, consume.item().slot());
+        assertEquals(lower.netId(), consume.item().stackNetworkId());
+        final var take = assertInstanceOf(ItemStackRequestAction.TakeAction.class, actions.get(2));
+        assertEquals(50, take.source().slot());
+        assertEquals(-7, take.source().stackNetworkId());
+        assertEquals(ContainerEnumName.CreatedOutputContainer, take.source().container().name());
+        assertEquals(cursor, take.destination());
+        final var quick = CartographyContainer.resultActions(selection, BedrockItem.empty(), lower, -9, cursor, true);
+        assertInstanceOf(ItemStackRequestAction.PlaceAction.class, quick.get(2));
+    }
+
+    @Test
+    void quickMoveMergesOnlyCompleteResultsWithAcknowledgedMatchingStacks() {
+        final Container inventory = new Container(null, (byte) 0, ContainerType.INVENTORY, null, null, 4) { };
+        final BedrockItem result = item(4, 2);
+        final BedrockItem full = item(4, 63);
+        final BedrockItem unconfirmed = item(4, 2);
+        unconfirmed.setNetId(null);
+        inventory.setItems(new BedrockItem[]{full, unconfirmed, BedrockItem.empty(), item(4, 60)});
+        assertEquals(3, CartographyContainer.destination(inventory, result, 64));
+        inventory.setItem(3, item(5, 1));
+        assertEquals(2, CartographyContainer.destination(inventory, result, 64));
+        inventory.setItem(2, item(5, 1));
+        assertEquals(-1, CartographyContainer.destination(inventory, result, 64));
+    }
+
+    private static CartographyRecipes.Selection select(final List<CraftingDataStorage> recipes, final BedrockItem input,
+                                                       final String inputName, final BedrockItem additional, final String additionalName,
+                                                       final MapTracker.MapData data, final List<Long> family, final String name) {
+        return CartographyRecipes.select(recipes, input, inputName, additional, additionalName, data, family, name,
+                (descriptor, item) -> descriptor instanceof ItemDescriptor.ItemNameDescriptor standard
+                        && !item.isEmpty() && standard.fullName().equals("minecraft:paper") && item.identifier() == 1);
+    }
+
+    private static List<CraftingDataStorage> dynamic(final String id, final int networkId) {
+        return List.of(new CraftingDataStorage(RecipeType.MULTI, networkId, new MultiRecipe(UUID.fromString(id)), false));
+    }
+
+    private static BedrockItem item(final int id, final int count) {
+        final BedrockItem item = new BedrockItem(id);
+        item.setAmount(count);
+        item.setNetId(id * 10);
+        return item;
+    }
+
+    private static BedrockItem map(final long id, final boolean locator) {
+        final BedrockItem map = item(4, 6);
+        final CompoundTag tag = new CompoundTag();
+        tag.putLong("map_uuid", id);
+        if (locator) {
+            tag.putByte("map_display_players", (byte) 1);
+        }
+        map.setTag(tag);
+        return map;
+    }
+
+}
