+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.StringType;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Versioned presentation state. Recipes and inventory requests remain authoritative in core. */
+public record CartographyState(int windowId, int editAcknowledgements, String operation, String name) {
+
+    public static final String CHANNEL = "viabedrock:cartography";
+    public static final Type<CartographyState> TYPE = new Type<>(CartographyState.class) {
+        private final StringType operationType = new StringType(16);
+        private final StringType nameType = new StringType(512);
+
+        @Override
+        public CartographyState read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported cartography state");
+            }
+            return new CartographyState(Types.VAR_INT.readPrimitive(buffer), Types.VAR_INT.readPrimitive(buffer),
+                    this.operationType.read(buffer), this.nameType.read(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final CartographyState value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.windowId());
+            Types.VAR_INT.writePrimitive(buffer, value.editAcknowledgements());
+            this.operationType.write(buffer, value.operation());
+            this.nameType.write(buffer, value.name());
+        }
+    };
+
+    public CartographyState {
+        if (windowId < Byte.MIN_VALUE || windowId > 255 || editAcknowledgements < 0 || name.length() > 512
+                || !java.util.Set.of("empty", "create", "create_locator", "rename", "clone", "extend", "lock", "locator").contains(operation)) {
+            throw new IllegalArgumentException("Invalid cartography state");
+        }
+    }
+
+}
