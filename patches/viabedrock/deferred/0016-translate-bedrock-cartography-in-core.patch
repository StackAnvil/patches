+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.MapTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.ThreadLocalRandom;
+
+public final class CartographyContainer extends InputContainer {
+
+    public static final String NAME_RESPONSE_PREFIX = "viabedrock:cartography_name/";
+    private CartographyState sentState;
+    private int editAcknowledgements;
+    private boolean updatingContent;
+    private String renameText = "";
+    private String nameResponseId;
+    private Long lockedSourceId;
+    private Long lockedPreviewId;
+    private Integer pendingResult;
+    private CartographyRecipes.Selection selection;
+
+    public CartographyContainer(final UserConnection user, final byte containerId, final TextComponent title,
+                                final BlockPosition position) {
+        super(user, containerId, ContainerType.CARTOGRAPHY, title, position, 3, CustomBlockTags.CARTOGRAPHY_TABLE);
+    }
+
+    @Override
+    protected int[] inputSlots() {
+        return new int[]{12, 13};
+    }
+
+    @Override
+    public FullContainerName getFullContainerName(final int slot) {
+        final ContainerEnumName name = switch (slot) {
+            case 12 -> ContainerEnumName.CartographyInputContainer;
+            case 13 -> ContainerEnumName.CartographyAdditionalContainer;
+            case 50 -> ContainerEnumName.CartographyResultPreviewContainer;
+            default -> throw new IllegalArgumentException("Invalid cartography slot: " + slot);
+        };
+        return new FullContainerName(name, null);
+    }
+
+    @Override
+    public int javaSlot(final int slot) {
+        return slot == 12 ? 0 : slot == 13 ? 1 : slot == 50 ? 2 : -1;
+    }
+
+    @Override
+    public int bedrockSlot(final int slot) {
+        return slot == 0 ? 12 : slot == 1 ? 13 : slot == 2 ? 50 : -1;
+    }
+
+    @Override
+    protected int itemIndex(final int slot) {
+        return this.javaSlot(slot);
+    }
+
+    private String identifier(final BedrockItem item) {
+        return this.user.get(ItemRewriter.class).getItems().inverse().get(item.identifier());
+    }
+
+    @Override
+    public boolean setItems(final BedrockItem[] items) {
+        this.updatingContent = true;
+        final boolean updated;
+        try {
+            updated = super.setItems(items);
+        } finally {
+            this.updatingContent = false;
+        }
+        if (updated) {
+            this.refreshOutput();
+        }
+        return updated;
+    }
+
+    @Override
+    protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem item) {
+        if (slot < 2) {
+            final String identifier = this.identifier(item);
+            if (previous.isEmpty() && !item.isEmpty() && (slot == 0 || this.items[0].isEmpty())
+                    && ("minecraft:filled_map".equals(identifier) || "minecraft:empty_map".equals(identifier))) {
+                final CompoundTag display = item.tag() == null ? null : item.tag().getCompoundTag("display");
+                this.renameText = display == null ? "" : display.getString("Name", "");
+            }
+            if (!this.updatingContent) {
+                this.refreshOutput();
+            }
+        }
+    }
+
+    private void refreshOutput() {
+        final MapTracker maps = this.user.get(MapTracker.class);
+        final Long id = CartographyRecipes.mapId(this.items[0].isEmpty() ? this.items[1] : this.items[0]);
+        this.selection = CartographyRecipes.select(this.user.get(CraftingDataTracker.class).getCraftingDataList(),
+                this.items[0], this.identifier(this.items[0]), this.items[1], this.identifier(this.items[1]),
+                id == null ? null : maps.mapData(id), id == null ? List.of() : maps.creationMapIds(id),
+                this.renameText, (ingredient, item) -> ingredient.matchesItem(this.user, item));
+        this.items[2] = this.selection == null ? BedrockItem.empty() : this.selection.result();
+        if (this.selection != null && this.selection.operation() == CartographyRecipes.Operation.LOCK) {
+            if (!id.equals(this.lockedSourceId)) {
+                this.lockedSourceId = id;
+                this.lockedPreviewId = ThreadLocalRandom.current().nextLong(1, 1L << 32);
+                final PacketWrapper preview = PacketWrapper.create(ServerboundBedrockPackets.MAP_CREATE_LOCKED_COPY, this.user);
+                preview.write(BedrockTypes.VAR_LONG, id);
+                preview.write(BedrockTypes.VAR_LONG, this.lockedPreviewId);
+                preview.sendToServer(BedrockProtocol.class);
+            }
+            this.items[2].tag().putLong("map_uuid", this.lockedPreviewId);
+        }
+        this.sendState();
+    }
+
+    public void sendState() {
+        final String operation = this.selection == null ? "empty" : this.selection.operation().name().toLowerCase(java.util.Locale.ROOT);
+        final CartographyState state = new CartographyState(this.javaContainerId(), this.editAcknowledgements, operation, this.renameText);
+        if (!state.equals(this.sentState)) {
+            final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user);
+            packet.write(Types.STRING, CartographyState.CHANNEL);
+            packet.write(CartographyState.TYPE, state);
+            packet.send(BedrockProtocol.class);
+            this.sentState = state;
+        }
+    }
+
+    public void refresh() {
+        final BedrockItem previous = this.items[2].copy();
+        this.refreshOutput();
+        if (previous.isDifferent(this.items[2]) || previous.amount() != this.items[2].amount()) {
+            PacketFactory.sendJavaContainerSetContent(this.user, this);
+        }
+    }
+
+    public void setRenameText(final String text) {
+        if (this.isClosing() || text.length() > 30) {
+            return;
+        }
+        this.renameText = text;
+        this.editAcknowledgements++;
+        this.refreshOutput();
+        PacketFactory.sendJavaContainerSetContent(this.user, this);
+    }
+
+    @Override
+    protected List<QuickMoveRange> quickMoveRanges(final short javaSlot, final SlotRef source) {
+        final Container inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        if (source.container() != inventory) {
+            return super.quickMoveRanges(javaSlot, source);
+        }
+        final String name = this.identifier(source.container().getItem(source.bedrockSlot()));
+        final int input = switch (name == null ? "" : name) {
+            case "minecraft:filled_map", "minecraft:paper" -> 0;
+            case "minecraft:compass", "minecraft:empty_map", "minecraft:glass_pane" -> 1;
+            default -> -1;
+        };
+        if (input >= 0) {
+            return List.of(new QuickMoveRange(this, input, input + 1, false));
+        }
+        return source.bedrockSlot() < 9 ? List.of(new QuickMoveRange(inventory, 9, inventory.size(), false))
+                : List.of(new QuickMoveRange(inventory, 0, 9, false));
+    }
+
+    @Override
+    public boolean handleClick(final int revision, final short slot, final byte button, final ContainerInput action) {
+        if (this.isClosing()) {
+            return false;
+        }
+        if (slot != 2) {
+            return super.handleClick(revision, slot, button, action);
+        }
+        if (action == ContainerInput.QUICK_MOVE && button == 1) {
+            this.openNameDialog();
+            return true;
+        }
+        if (this.pendingResult != null || action != ContainerInput.PICKUP && action != ContainerInput.QUICK_MOVE
+                || button != 0 && button != 1) {
+            return false;
+        }
+        this.refreshOutput();
+        if (this.selection == null || button == 1 && this.items[2].amount() != 1
+                || this.selection.inputCount() > 0 && this.items[0].netId() == null
+                || this.selection.additionalCount() > 0 && this.items[1].netId() == null) {
+            return false;
+        }
+        final InventoryTracker inventory = this.user.get(InventoryTracker.class);
+        final boolean quickMove = action == ContainerInput.QUICK_MOVE;
+        final Container target = quickMove ? inventory.getInventoryContainer() : inventory.getHudContainer();
+        final BedrockItem result = this.items[2];
+        final int maximum = this.user.get(ItemRewriter.class).maxStackSize(result);
+        final int destination = quickMove ? destination(target, result, maximum) : 0;
+        if (destination < 0) {
+            return false;
+        }
+        final BedrockItem current = target.getItem(destination);
+        if (!current.isEmpty() && (current.isDifferent(result) || current.netId() == null
+                || current.amount() + result.amount() > maximum)) {
+            return false;
+        }
+        final InventoryRequestTracker requests = this.user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId,
+                resultActions(this.selection, this.items[0], this.items[1], requestId,
+                        target.requestSlotInfo(destination, current.isEmpty() ? 0 : current.netId()), quickMove),
+                List.of(this.renameText), TextProcessingEventOrigin.CartographyText);
+        requests.addRequest(new InventoryRequestStorage(request, revision, inventory.getHudContainer().copy(),
+                quickMove ? List.of(this.copy(), target.copy()) : List.of(this.copy())));
+        this.pendingResult = requestId;
+        final int inputCount = this.selection.inputCount();
+        final int additionalCount = this.selection.additionalCount();
+        if (inputCount > 0) {
+            this.setItem(12, this.itemAfterRemovingAmount(this.items[0], inputCount));
+        }
+        if (additionalCount > 0) {
+            this.setItem(13, this.itemAfterRemovingAmount(this.items[1], additionalCount));
+        }
+        final BedrockItem placed = current.isEmpty() ? result.copy() : current.copy();
+        placed.setAmount(current.amount() + result.amount());
+        target.setItem(destination, placed);
+        PacketFactory.sendBedrockInventoryRequest(this.user, new ItemStackRequestInfo[]{request});
+        return true;
+    }
+
+    static List<ItemStackRequestAction> resultActions(final CartographyRecipes.Selection selection,
+                                                    final BedrockItem input, final BedrockItem additional,
+                                                    final int requestId, final ItemStackRequestSlotInfo destination,
+                                                    final boolean quickMove) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        actions.add(new ItemStackRequestAction.CraftRecipeOptionalAction(selection.networkId(), 0));
+        if (selection.inputCount() > 0) {
+            actions.add(new ItemStackRequestAction.ConsumeAction(selection.inputCount(), new ItemStackRequestSlotInfo(
+                    new FullContainerName(ContainerEnumName.CartographyInputContainer, null), (byte) 12, input.netId())));
+        }
+        if (selection.additionalCount() > 0) {
+            actions.add(new ItemStackRequestAction.ConsumeAction(selection.additionalCount(), new ItemStackRequestSlotInfo(
+                    new FullContainerName(ContainerEnumName.CartographyAdditionalContainer, null), (byte) 13, additional.netId())));
+        }
+        final var source = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                (byte) 50, requestId);
+        actions.add(quickMove ? new ItemStackRequestAction.PlaceAction(selection.result().amount(), source, destination)
+                : new ItemStackRequestAction.TakeAction(selection.result().amount(), source, destination));
+        return actions;
+    }
+
+    @Override
+    public boolean handleResponse(final int requestId, final boolean success) {
+        super.handleResponse(requestId, success);
+        if (this.pendingResult != null && this.pendingResult == requestId) {
+            this.pendingResult = null;
+            this.refreshOutput();
+        }
+        return false;
+    }
+
+    static int destination(final Container inventory, final BedrockItem result, final int maximum) {
+        for (final boolean merge : new boolean[]{true, false}) {
+            for (int slot = 0; slot < inventory.size(); slot++) {
+                final BedrockItem item = inventory.getItem(slot);
+                if (merge ? !item.isEmpty() && !item.isDifferent(result) && item.netId() != null
+                        && item.amount() + result.amount() <= maximum : item.isEmpty()) {
+                    return slot;
+                }
+            }
+        }
+        return -1;
+    }
+
+    @Override
+    public void beginClose() {
+        this.closeNameDialog();
+        super.beginClose();
+    }
+
+    public void closeNameDialog() {
+        if (this.nameResponseId != null) {
+            this.nameResponseId = null;
+            PacketWrapper.create(ClientboundPackets26_3.CLEAR_DIALOG, this.user).send(BedrockProtocol.class);
+        }
+    }
+
+    private void openNameDialog() {
+        PacketFactory.sendJavaContainerSetContent(this.user, this);
+        this.nameResponseId = NAME_RESPONSE_PREFIX + UUID.randomUUID();
+        final var id = Identifier.of(this.nameResponseId);
+        final var dialog = new MultiActionDialog(TextUtil.stringToTextComponent("Map name"), true, false, AfterAction.CLOSE,
+                new ArrayList<>(), new ArrayList<>(), new ArrayList<>(),
+                new ActionButton(TextUtil.stringToTextComponent("Cancel"), 150, new CustomAllAction(id, new CompoundTag())), 1);
+        final TextInput input = new TextInput(TextUtil.stringToTextComponent("Map name"));
+        input.setMaxLength(30);
+        input.setInitial(this.renameText);
+        dialog.getInputs().add(new Input("name", input));
+        final CompoundTag payload = new CompoundTag();
+        payload.putBoolean("save", true);
+        dialog.getActions().add(new ActionButton(TextUtil.stringToTextComponent("Save name"), 150, new CustomAllAction(id, payload)));
+        final PacketWrapper show = PacketWrapper.create(ClientboundPackets26_3.SHOW_DIALOG, this.user);
+        show.write(Types.TRUSTED_COMPOUND_TAG_HOLDER, Holder.of((CompoundTag) DialogSerializer.V1_21_6.getDirectCodec().serialize(NbtConverter_v1_21_5.INSTANCE, dialog).get()));
+        show.send(BedrockProtocol.class);
+    }
+
+    public void handleNameResponse(final String id, final CompoundTag payload) {
+        if (!id.equals(this.nameResponseId)) {
+            return;
+        }
+        this.nameResponseId = null;
+        if (!this.isClosing() && payload != null && payload.getBoolean("save") && payload.getString("name") != null) {
+            this.setRenameText(payload.getString("name"));
+        } else if (!this.isClosing()) {
+            PacketFactory.sendJavaContainerSetContent(this.user, this);
+        }
+    }
+
+}
