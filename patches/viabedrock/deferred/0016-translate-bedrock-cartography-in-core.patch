+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class CartographyUiResourceRewriterTest {
+
+    @Test
+    void retainsHigherPackPixelsAndDoesNotExportUnrelatedAssets() {
+        final var lower = pack(0xFF112233, 2);
+        final var higher = pack(0xFF445566, 3);
+        final var output = CartographyUiResourceRewriter.convert(new ResourcePackStorage(List.of(higher, lower)));
+        final var image = output.getImage("assets/viabedrock/textures/cartography/cartography_table_copy.png").getImage();
+        assertEquals(3, image.getWidth());
+        assertEquals(0xFF445566, image.getRGB(0, 0));
+        assertEquals(1, output.getFilesDeep("", ".png").size());
+    }
+
+    @Test
+    void oversizedHigherImageDoesNotRevealLowerPack() {
+        final var output = CartographyUiResourceRewriter.convert(new ResourcePackStorage(List.of(pack(-1, 1025), pack(-1, 2))));
+        assertEquals(0, output.getFilesDeep("", ".png").size());
+    }
+
+    private static ResourcePack pack(final int color, final int width) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + java.util.UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final var image = new BufferedImage(width, 2, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, color);
+        content.putPngImage("textures/ui/cartography_table_copy.png", image);
+        content.putPngImage("textures/ui/unrelated.png", image);
+        return new ResourcePack(content);
+    }
+
+}
