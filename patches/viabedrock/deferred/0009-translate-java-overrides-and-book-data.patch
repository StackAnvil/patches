 public final class ItemDataRewriter {
 
+    static void applyJavaOverride(final CompoundTag override, final StructuredDataContainer data, final CompoundTag registries) {
+        final PotionContents potionContents = potionContents(override);
+        if (potionContents != null) {
+            data.set(StructuredDataKey.POTION_CONTENTS1_21_2, potionContents);
+        }
+
+        final BlockStateProperties blockState = blockStateProperties(override.getCompoundTag("BlockStateTag"));
+        if (blockState != null) {
+            data.set(StructuredDataKey.BLOCK_STATE, blockState);
+        }
+
+        if (override.get("instrument") instanceof StringTag instrument) {
+            final CompoundTag instrumentRegistry = registries.getCompoundTag("minecraft:instrument");
+            final int instrumentId = registryIndex(instrumentRegistry, instrument.getValue());
+            if (instrumentId >= 0) {
+                data.set(StructuredDataKey.INSTRUMENT26_1, Holder.<Instrument1_21_2>of(instrumentId));
+            }
+        }
+    }
+
+    static PotionContents potionContents(final CompoundTag override) {
+        Integer potion = null;
+        if (override.get("Potion") instanceof StringTag potionTag) {
+            final int id = enumIndex(EnumTypes.POTION.keys(), potionTag.getValue());
+            if (id >= 0) {
+                potion = id;
+            }
+        }
+
+        final Integer customColor = override.get("CustomPotionColor") instanceof NumberTag color ? color.asInt() : null;
+        final List<PotionEffect> effects = new ArrayList<>();
+        if (override.get("custom_potion_effects") instanceof ListTag<?> customEffects) {
+            for (Tag effectTag : customEffects) {
+                if (!(effectTag instanceof CompoundTag effect) || !(effect.get("id") instanceof StringTag idTag)) {
+                    continue;
+                }
+                final int effectId = enumIndex(EnumTypes.MOB_EFFECT.keys(), idTag.getValue());
+                if (effectId < 0) {
+                    continue;
+                }
+                final int amplifier = effect.get("amplifier") instanceof NumberTag value ? value.asInt() : 0;
+                final int duration = effect.get("duration") instanceof NumberTag value ? value.asInt() : 0;
+                final boolean ambient = effect.get("ambient") instanceof NumberTag value && value.asByte() != 0;
+                final boolean showParticles = !(effect.get("show_particles") instanceof NumberTag value) || value.asByte() != 0;
+                final boolean showIcon = !(effect.get("show_icon") instanceof NumberTag value) || value.asByte() != 0;
+                effects.add(new PotionEffect(effectId, new PotionEffectData(amplifier, duration, ambient, showParticles, showIcon, null)));
+            }
+        }
+
+        return potion == null && customColor == null && effects.isEmpty()
+                ? null : new PotionContents(potion, customColor, effects.toArray(PotionEffect[]::new));
+    }
+
+    static BlockStateProperties blockStateProperties(final CompoundTag blockState) {
+        if (blockState == null || blockState.isEmpty()) {
+            return null;
+        }
+        final Map<String, String> properties = new HashMap<>();
+        for (Map.Entry<String, Tag> entry : blockState.entrySet()) {
+            if (entry.getValue() instanceof StringTag string) {
+                properties.put(entry.getKey(), string.getValue());
+            } else if (entry.getValue() instanceof NumberTag number) {
+                properties.put(entry.getKey(), Integer.toString(number.asInt()));
+            }
+        }
+        return properties.isEmpty() ? null : new BlockStateProperties(properties);
+    }
+
+    static int registryIndex(final CompoundTag registry, final String identifier) {
+        if (registry == null) {
+            return -1;
+        }
+        int index = 0;
+        for (String key : registry.keySet()) {
+            if (Key.of(key).equals(Key.of(identifier))) {
+                return index;
+            }
+            index++;
+        }
+        return -1;
+    }
+
+    private static int enumIndex(final Key[] keys, final String identifier) {
+        final Key key = Key.of(identifier);
+        for (int index = 0; index < keys.length; index++) {
+            if (keys[index].equals(key)) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    static WritableBook writableBook(final CompoundTag bedrockTag) {
+        if (!(bedrockTag.get("pages") instanceof ListTag<?> pages)) {
+            return null;
+        }
+        final FilterableString[] javaPages = new FilterableString[Math.min(pages.size(), 100)];
+        for (int index = 0; index < javaPages.length; index++) {
+            final Tag page = pages.get(index);
+            final String text = page instanceof CompoundTag content ? content.getString("text", "") : "";
+            javaPages[index] = new FilterableString(text, null);
+        }
+        return new WritableBook(javaPages);
+    }
+
+    static WrittenBook writtenBook(final CompoundTag bedrockTag) {
+        if (!(bedrockTag.get("pages") instanceof ListTag<?> pages)) {
+            return null;
+        }
+        final FilterableComponent[] javaPages = new FilterableComponent[Math.min(pages.size(), 100)];
+        for (int index = 0; index < javaPages.length; index++) {
+            final Tag page = pages.get(index);
+            final String text = page instanceof CompoundTag content ? content.getString("text", "") : "";
+            javaPages[index] = new FilterableComponent(TextUtil.stringToNbt(text), null);
+        }
+        final FilterableString title = new FilterableString(bedrockTag.getString("title", ""), null);
+        final int generation = bedrockTag.get("generation") instanceof NumberTag value
+                ? Math.max(0, Math.min(value.asInt(), 3)) : 0;
+        return new WrittenBook(title, bedrockTag.getString("author", ""), generation, javaPages, true);
+    }
