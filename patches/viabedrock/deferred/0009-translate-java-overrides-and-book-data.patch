+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.minecraft.item.data.BlockStateProperties;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionContents;
+import com.viaversion.viaversion.api.minecraft.item.data.WritableBook;
+import com.viaversion.viaversion.api.minecraft.item.data.WrittenBook;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class ItemDataRewriterTest {
+
+    @Test
+    void convertsMappedPotionAndCustomEffectsToJavaComponents() {
+        final CompoundTag override = new CompoundTag();
+        override.putString("Potion", "minecraft:long_night_vision");
+        override.putInt("CustomPotionColor", 4013879);
+        final CompoundTag wither = new CompoundTag();
+        wither.putString("id", "minecraft:wither");
+        wither.putInt("amplifier", 1);
+        wither.putInt("duration", 800);
+        final ListTag<CompoundTag> effects = new ListTag<>(CompoundTag.class);
+        effects.add(wither);
+        override.put("custom_potion_effects", effects);
+
+        final PotionContents result = ItemDataRewriter.potionContents(override);
+
+        assertNotNull(result);
+        assertEquals(5, result.potion());
+        assertEquals(4013879, result.customColor());
+        assertEquals(1, result.customEffects().length);
+        assertEquals(19, result.customEffects()[0].effect());
+        assertEquals(1, result.customEffects()[0].effectData().amplifier());
+        assertEquals(800, result.customEffects()[0].effectData().duration());
+    }
+
+    @Test
+    void convertsMappedBlockStateValuesWithoutMutatingSource() {
+        final CompoundTag blockState = new CompoundTag();
+        blockState.putInt("level", 10);
+        blockState.putString("facing", "north");
+
+        final BlockStateProperties result = ItemDataRewriter.blockStateProperties(blockState);
+
+        assertNotNull(result);
+        assertEquals("10", result.properties().get("level"));
+        assertEquals("north", result.properties().get("facing"));
+        assertEquals(10, blockState.getInt("level"));
+        assertNull(ItemDataRewriter.blockStateProperties(new CompoundTag()));
+    }
+
+    @Test
+    void resolvesInstrumentFromOrderedJavaRegistry() {
+        final CompoundTag instruments = new CompoundTag();
+        instruments.put("minecraft:ponder_goat_horn", new CompoundTag());
+        instruments.put("minecraft:sing_goat_horn", new CompoundTag());
+
+        assertEquals(1, ItemDataRewriter.registryIndex(instruments, "minecraft:sing_goat_horn"));
+        assertEquals(-1, ItemDataRewriter.registryIndex(instruments, "minecraft:missing"));
+    }
+
+    @Test
+    void preservesBookPageOrderAndSignedMetadata() {
+        final CompoundTag tag = new CompoundTag();
+        final ListTag<CompoundTag> pages = new ListTag<>(CompoundTag.class);
+        final CompoundTag first = new CompoundTag();
+        first.putString("text", "First page");
+        pages.add(first);
+        final CompoundTag second = new CompoundTag();
+        second.putString("text", "Second page");
+        pages.add(second);
+        tag.put("pages", pages);
+        tag.putString("title", "Field notes");
+        tag.putString("author", "Alex");
+        tag.putInt("generation", 2);
+
+        final WritableBook writable = ItemDataRewriter.writableBook(tag);
+        final WrittenBook written = ItemDataRewriter.writtenBook(tag);
+
+        assertEquals("First page", writable.pages()[0].raw());
+        assertEquals("Second page", writable.pages()[1].raw());
+        assertEquals("Field notes", written.title().raw());
+        assertEquals("Alex", written.author());
+        assertEquals(2, written.generation());
+        assertEquals(2, written.pages().length);
+        assertNotNull(written.pages()[0].raw());
+    }
+
+}
