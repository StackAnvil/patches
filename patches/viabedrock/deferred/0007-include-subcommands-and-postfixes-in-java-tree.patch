From 4333a338868b9569d5f7884603e6ed780952c245 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 03:58:41 +0200
Subject: [PATCH] fix(commands): include subcommands and postfixes in Java tree

Translate Bedrock chained subcommand values and postfix tokens into Brigadier nodes instead of dropping them. Keep chained enums usable even when their Bedrock option flag is present, so Java completion and command dispatch retain those paths.
---
 .../protocol/storage/CommandsStorage.java     | 22 +++++---
 .../protocol/storage/CommandsStorageTest.java | 50 +++++++++++++++++++
 2 files changed, 64 insertions(+), 8 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/storage/CommandsStorageTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/CommandsStorage.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/CommandsStorage.java
index fc4f78a0..67ecff34 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/CommandsStorage.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/CommandsStorage.java
@@ -223,10 +223,6 @@ public class CommandsStorage extends StoredObject {
 
                     final ArgumentBuilder<UserConnection, ?> argument;
                     if (parameter.enumData() != null) {
-                        if ((parameter.flags() & CommandParameterOption.EnumAsChainedCommand.getValue()) != 0) {
-                            throw new UnsupportedOperationException("Enum as chained command is not supported yet");
-                        }
-
                         final String literalValue = getLiteralEnumValue(parameter);
                         if (literalValue != null) {
                             argument = literal(literalValue);
@@ -253,11 +249,9 @@ public class CommandsStorage extends StoredObject {
                             argument = argument(parameter.name() + ": " + parameter.enumData().name(), argumentType).suggests(argumentType::listSuggestions);
                         }
                     } else if (parameter.subCommandData() != null) {
-                        // TODO: Enhancement: Sub commands
-                        continue;
+                        argument = literalParameter(parameter.name() + ": subcommand", parameter.subCommandData().values().keySet());
                     } else if (parameter.postfix() != null) {
-                        // TODO: Enhancement: Postfix support
-                        continue;
+                        argument = literalParameter(parameter.name() + ": postfix", Set.of(parameter.postfix()));
                     } else if (parameter.type() != null) {
                         ArgumentType<?> argumentType = null;
                         switch (parameter.type()) {
@@ -443,4 +437,16 @@ public class CommandsStorage extends StoredObject {
         return value.isEmpty() || value.chars().anyMatch(Character::isWhitespace) ? null : value;
     }
 
+    static ArgumentBuilder<UserConnection, ?> literalParameter(final String name, final Set<String> values) {
+        if (values.size() == 1) {
+            final String value = values.iterator().next();
+            if (!value.isEmpty() && value.chars().noneMatch(Character::isWhitespace)) {
+                return literal(value);
+            }
+        }
+
+        final ArgumentType<?> argumentType = EnumArgumentType.values(values);
+        return argument(name, argumentType).suggests(argumentType::listSuggestions);
+    }
+
 }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/CommandsStorageTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/CommandsStorageTest.java
new file mode 100644
index 00000000..b8357ca9
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/CommandsStorageTest.java
@@ -0,0 +1,50 @@
