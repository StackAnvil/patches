+package net.raphimc.viabedrock.protocol.storage;
+
+import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.builder.LiteralArgumentBuilder;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class CommandsStorageTest {
+
+    @Test
+    void chainedSubcommandValuesRemainRequiredAndSelectable() throws Exception {
+        final CommandDispatcher<UserConnection> dispatcher = new CommandDispatcher<>();
+        dispatcher.register(LiteralArgumentBuilder.<UserConnection>literal("demo")
+                .then(CommandsStorage.literalParameter("action", Set.of("add", "remove"))
+                        .executes(context -> 1)));
+
+        assertEquals(1, dispatcher.execute("demo add", null));
+        assertEquals(1, dispatcher.execute("demo remove", null));
+        assertThrows(CommandSyntaxException.class, () -> dispatcher.execute("demo unknown", null));
+        assertThrows(CommandSyntaxException.class, () -> dispatcher.execute("demo", null));
+    }
+
+    @Test
+    void postfixMustBeRequiredLiteral() throws Exception {
+        final CommandDispatcher<UserConnection> dispatcher = new CommandDispatcher<>();
+        dispatcher.register(LiteralArgumentBuilder.<UserConnection>literal("demo")
+                .then(CommandsStorage.literalParameter("postfix", Set.of("days"))
+                        .executes(context -> 1)));
+
+        assertEquals(1, dispatcher.execute("demo days", null));
+        assertThrows(CommandSyntaxException.class, () -> dispatcher.execute("demo", null));
+        assertThrows(CommandSyntaxException.class, () -> dispatcher.execute("demo hours", null));
+    }
+
+}
