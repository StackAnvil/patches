+
+/** Authored player and workbench scenes retain actual slot and recipe-cell identities. */
+public final class PlayerInventoryUi {
+
+    private final JsonUiProgram program;
+    private final Boolean workbench;
+
+    public PlayerInventoryUi(final JsonUiProgram program) {
+        this(program, null);
+    }
+
+    private PlayerInventoryUi(final JsonUiProgram program, final Boolean workbench) {
+        this.program = Objects.requireNonNull(program);
+        this.workbench = workbench;
+    }
+
+    public JsonObject exportProgram(final boolean workbench) {
+        final JsonObject result = this.program.export(Set.of(host(workbench), "how_to_play.how_to_play_screen", "encyclopedia.encyclopedia_screen"), new JsonObject());
+        if (!result.getAsJsonObject("definitions").has(host(workbench))) {
+            throw new IllegalArgumentException("Missing authored player inventory host");
+        }
+        result.getAsJsonObject("translations").addProperty(BundleTooltipUi.EMPTY_DESCRIPTION, this.program.translate(BundleTooltipUi.EMPTY_DESCRIPTION));
+        result.addProperty("player_workbench", workbench);
+        this.exportHelpTranslations(result.get("definitions"), result.getAsJsonObject("translations"));
+        return result;
+    }
+
+    private void exportHelpTranslations(final JsonElement value, final JsonObject translations) {
+        if (value.isJsonArray()) {
+            for (final var child : value.getAsJsonArray()) {
+                this.exportHelpTranslations(child, translations);
+            }
+        } else if (value.isJsonObject()) {
+            for (final var entry : value.getAsJsonObject().entrySet()) {
+                final var child = entry.getValue();
+                if (Set.of("$section_topic", "$category").contains(entry.getKey()) && child.isJsonPrimitive() && child.getAsJsonPrimitive().isString()) {
+                    final String name = child.getAsString();
+                    if (!name.isEmpty() && !name.startsWith("$") && !name.startsWith("(")) {
+                        final String key = (entry.getKey().equals("$section_topic") ? "howtoplay." : "howtoplay.category.") + name;
+                        translations.addProperty(key, this.program.translate(key));
+                        if (entry.getKey().equals("$section_topic")) {
+                            translations.addProperty(key + ".title", this.program.translate(key + ".title"));
+                        }
+                    }
+                }
+                this.exportHelpTranslations(child, translations);
+            }
+        }
+    }
+
+    public static PlayerInventoryUi fromProgram(final JsonObject program) {
+        final JsonElement family = program.get("player_workbench");
+        if (family == null || !family.isJsonPrimitive() || !family.getAsJsonPrimitive().isBoolean()) {
+            throw new IllegalArgumentException("Missing player inventory program identity");
+        }
+        return new PlayerInventoryUi(JsonUiProgram.fromProgram(program), family.getAsBoolean());
+    }
+
+    private static String host(final boolean workbench) {
+        return workbench ? "crafting.crafting_screen" : "crafting.inventory_screen";
+    }
+
+    public JsonObject resolve(final MenuView menu) {
+        return this.resolve(menu, null);
+    }
+
+    /** Non-null windows opt into local cell views while retaining the complete menu model. */
+    public JsonObject resolve(final MenuView menu, final Map<String, UiBindings.Window> windows) {
+        return this.resolve(menu, windows, BundleTooltipUi.View.inactive());
+    }
+
+    public JsonObject resolve(final MenuView menu, final Map<String, UiBindings.Window> windows, final BundleTooltipUi.View tooltip) {
+        if (this.workbench != null && this.workbench != menu.state.workbench) {
+            throw new IllegalArgumentException("Player inventory program belongs to another family");
+        }
