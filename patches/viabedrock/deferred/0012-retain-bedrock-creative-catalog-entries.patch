+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class NativeRecipeQuantityTest {
+
+    @Test
+    void outputCountingSkipsEmptyPlaceholdersAndRetainsLaterValidRecipes() {
+        final var placeholders = List.of(production(0, -1, Set.of(), 1), production(1, 0, Set.of(), 1));
+        assertEquals(new NativeRecipeCounter.Quantity(0, 0), quantity(placeholders, 8, 3));
+        assertEquals(new NativeRecipeCounter.Quantity(32, 8), quantity(
+                List.of(placeholders.get(0), placeholders.get(1), production(1, -1, Set.of(1), 4)), 8, 3));
+    }
+
+    @Test
+    void alternativeLogRecipesMatchNativeDisplayedPlankQuantity() {
+        // Official 1.26.60.5 classic player inventory: eight logs and three stripped logs show 44 planks.
+        final var candidates = List.of(
+                production(1, -1, Set.of(1), 4), production(1, -1, Set.of(2), 4));
+        assertEquals(new NativeRecipeCounter.Quantity(44, 11), quantity(candidates, 8, 3));
+    }
+
+    @Test
+    void sharedPlankRoundsMatchNativeTableAndWorkbenchChestQuantities() {
+        // Same native capture: 10 oak + 2 birch show three tables; 30 oak + 2 birch show four chests.
+        assertEquals(new NativeRecipeCounter.Quantity(3, 3), quantity(
+                List.of(production(4, -1, Set.of(1, 2), 1)), 10, 2));
+        assertEquals(new NativeRecipeCounter.Quantity(4, 4), quantity(
+                List.of(production(9, 4, Set.of(1, 2), 1)), 30, 2));
+    }
+
+    private static NativeRecipeCounter.Quantity quantity(final List<NativeRecipeCounter.Production> candidates,
+                                                         final int oak, final int birch) {
+        return NativeRecipeCounter.quantity(candidates, List.of(new NativeRecipeCounter.Source(ContainerEnumName.HotbarContainer,
+                List.of(new BedrockItem(1, (short) 0, (byte) oak), new BedrockItem(2, (short) 0, (byte) birch)))), BedrockItem::identifier);
+    }
+
+    private static NativeRecipeCounter.Production production(final int slots, final int empty, final Set<Integer> ids, final int output) {
+        return new NativeRecipeCounter.Production(new NativeRecipeCounter.Candidate(0, slots > 4, new NativeRecipeCounter.Recipe() {
+            @Override
+            public int ingredientCount() {
+                return slots;
+            }
+
+            @Override
+            public boolean emptyIngredient(final int index) {
+                return index == empty;
+            }
+
+            @Override
+            public boolean matchesIngredient(final int index, final BedrockItem item) {
+                return index != empty && ids.contains(item.identifier());
+            }
+        }), output);
+    }
+
+}
