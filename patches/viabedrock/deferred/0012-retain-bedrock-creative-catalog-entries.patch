+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Published physical source values own commands independently of client item previews. */
+public final class NativeBundleInputSession {
+
+    private final UserConnection user;
+    private final InventoryTracker inventory;
+    private final ItemRegistry definitions;
+    private final Container menu;
+    private final NativePlayerInventoryMessage publication;
+    private final Map<Source, Slot> sources = new HashMap<>();
+    private final Map<Container, Container> snapshots = new LinkedHashMap<>();
+    private final Map<FullContainerName, BundleContainer> dynamic = new HashMap<>();
+
+    private NativeBundleInputSession(final UserConnection user, final NativePlayerInventoryMessage publication) {
+        this.user = user;
+        this.inventory = user.get(InventoryTracker.class);
+        this.definitions = user.get(ItemRewriter.class).getItemRegistry();
+        this.menu = this.inventory.getCurrentContainer();
+        this.publication = publication;
+        final int playerStart = this.menu instanceof InventoryContainer ? 9 : this.menu.javaSize();
+        this.add("inventory_items", playerStart, 27);
+        this.add("hotbar_items", playerStart + 27, 9);
+        this.add("container_items", 0, this.menu instanceof InventoryContainer ? 9 : this.menu.javaSize());
+        this.add("crafting_input_items", 1, this.menu instanceof CraftingTableContainer ? 9 : 4);
+        if (this.menu instanceof InventoryContainer) {
+            this.add("armor_items", 5, 4);
+            this.add("offhand_items", 45, 1);
+        }
+        for (int index = 0; index < 36; index++) {
+            this.sources.put(new Source("combined_hotbar_and_inventory_items", index), new Slot(this.inventory.getInventoryContainer(), index));
+        }
+        this.sources.put(new Source("cursor_items", 0), new Slot(this.inventory.getHudContainer(), 0));
+        final var pending = new ArrayDeque<Container>();
+        for (final var source : this.sources.values()) {
+            if (!this.snapshots.containsKey(source.owner)) {
+                this.snapshots.put(source.owner, source.owner.copy());
+                pending.add(source.owner);
+            }
+        }
+        int slots = 0;
+        while (!pending.isEmpty()) {
+            final var owner = pending.removeFirst();
+            // Bound the publication snapshot independently of native gameplay limits.
+            slots += owner.size();
+            if (slots > 4096) {
+                throw new IllegalArgumentException("Native bundle publication is too large");
+            }
+            for (final var item : this.snapshots.get(owner).getItems()) {
+                final var properties = this.definitions.storageProperties(item);
+                final Integer identity = NativeItemStorageData.containerIdentity(item);
+                if (properties == null || !properties.storage() || identity == null) {
+                    continue;
+                }
+                final var name = new FullContainerName(ContainerEnumName.DynamicContainer, identity);
+                final var container = this.inventory.getDynamicContainer(name);
+                this.dynamic.put(name, container);
+                if (container != null && !this.snapshots.containsKey(container)) {
+                    this.snapshots.put(container, container.copy());
+                    pending.add(container);
+                }
+            }
+        }
+    }
+
+    public static NativeBundleInputSession capture(final UserConnection user, final NativePlayerInventoryMessage publication) {
+        final var inventory = user.get(InventoryTracker.class);
+        final var menu = inventory.getCurrentContainer();
+        if (publication.generation() <= 0 || publication.generation() != inventory.currentContainerGeneration()
+                || !(menu instanceof InventoryContainer) && !(menu instanceof CraftingTableContainer)
+                || Byte.toUnsignedInt(menu.javaContainerId()) != publication.menuId()
+                || user.get(ItemRewriter.class).getItemRegistry() == null) {
+            return null;
+        }
+        try {
+            return new NativeBundleInputSession(user, publication);
+        } catch (final IllegalArgumentException unsupported) {
+            return null;
+        }
+    }
+
+    public boolean current() {
+        return this.inventory == this.user.get(InventoryTracker.class)
+                && this.definitions == this.user.get(ItemRewriter.class).getItemRegistry()
+                && this.menu == this.inventory.getCurrentContainer() && this.inventory.getPendingCloseContainer() == null
+                && this.sources.get(new Source("cursor_items", 0)).owner == this.inventory.getHudContainer()
+                && this.sources.get(new Source("combined_hotbar_and_inventory_items", 0)).owner == this.inventory.getInventoryContainer()
+                && this.publication.generation() == this.inventory.currentContainerGeneration()
+                && this.dynamic.entrySet().stream().allMatch(entry -> this.inventory.getDynamicContainer(entry.getKey()) == entry.getValue())
+                && this.snapshots.entrySet().stream().allMatch(entry -> entry.getKey().serverRevision() == entry.getValue().serverRevision()
+                    && Arrays.equals(entry.getKey().getItems(), entry.getValue().getItems()));
+    }
+
+    public NativeBundleActionSession.Outcome execute(final NativeBundleAction action) {
+        final var requests = this.user.get(InventoryRequestTracker.class);
+        if (!action.belongsTo(this.publication, 0) || !this.current() || !requests.canStartRecipePlacement() || requests.isPredictingClick()) {
+            return null;
+        }
+        final var clicked = this.sources.get(new Source(action.collection(), action.index()));
+        if (clicked == null || clicked.owner == this.inventory.getHudContainer() && clicked.index == 0) {
+            return null;
+        }
+        final var cursor = new Slot(this.inventory.getHudContainer(), 0);
+        final var held = cursor.owner.getItem(cursor.index);
+        final var target = clicked.owner.getItem(clicked.index);
+        final boolean heldStorage = this.storage(held);
+        final boolean targetStorage = this.storage(target);
+        final Slot root;
+        final Slot external;
+        if (action.kind() == NativeBundleAction.Kind.PRIMARY) {
+            if (heldStorage && !target.isEmpty()) {
+                root = cursor;
+                external = clicked;
+            } else if (!heldStorage && !held.isEmpty() && targetStorage) {
+                root = clicked;
+                external = cursor;
+            } else {
+                return null;
+            }
+        } else if (heldStorage && target.isEmpty()) {
+            root = cursor;
+            external = clicked;
+        } else if (held.isEmpty() && targetStorage && action.tooltipMode() == 2) {
+            root = clicked;
+            external = cursor;
+        } else {
+            return null;
+        }
+        final var session = NativeBundleActionSession.create(this.user, root.owner, root.index);
+        return session == null ? null : action.kind() == NativeBundleAction.Kind.PRIMARY
+                ? session.insert(external.owner, external.index, null, 0) : session.extractLast(external.owner, external.index, 0);
+    }
+
+    private boolean storage(final BedrockItem item) {
+        final var properties = this.definitions.storageProperties(item);
+        final Integer identity = NativeItemStorageData.containerIdentity(item);
+        return properties != null && properties.storage() && properties.viewableSlots() != null && identity != null
+                && this.inventory.getDynamicContainer(new FullContainerName(ContainerEnumName.DynamicContainer, identity)) != null;
+    }
+
+    private void add(final String collection, final int first, final int count) {
+        for (int index = 0; index < count; index++) {
+            final var slot = this.menu.resolveJavaSlot(this.inventory, (short) (first + index));
+            if (slot == null) {
+                continue;
+            }
+            final var owner = slot.container() instanceof InventoryContainer ? this.inventory.getInventoryContainer() : slot.container();
+            final var name = owner.getFullContainerName(slot.bedrockSlot()).name();
+            if (name != ContainerEnumName.CreatedOutputContainer && name != ContainerEnumName.CraftingOutputPreviewContainer) {
+                this.sources.put(new Source(collection, index), new Slot(owner, slot.bedrockSlot()));
+            }
+        }
+    }
+
+    private record Source(String collection, int index) { }
+
+    private record Slot(Container owner, int index) { }
+
+}
