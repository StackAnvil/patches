+                new CreativeCatalog.Entry(21, 0, new BedrockItem(200), mapped, true, false),
+                new CreativeCatalog.Entry(22, 0, new BedrockItem(201), mapped, false, true)));
+
+        assertEquals(201, catalog.creativeEntry(mapped).bedrockItem().identifier());
+        assertEquals(22, catalog.creativeEntry(mapped).netId());
+        assertEquals(200, catalog.creativeEntry(catalog.entries().get(0).javaItem()).bedrockItem().identifier());
+        assertEquals(201, catalog.creativeEntry(catalog.entries().get(1).javaItem()).bedrockItem().identifier());
+    }
+
+    @Test
+    void retainsPotionVariantIdentityThroughCreativeSelectionAndOwnedStacks() throws ReflectiveOperationException {
+        final Item strength = javaItem(3);
+        final Item oozing = javaItem(3);
+        strength.dataContainer().set(StructuredDataKey.POTION_CONTENTS1_21_2,
+                new PotionContents(30, null,
+                        new PotionEffect[0]));
+        oozing.dataContainer().set(StructuredDataKey.POTION_CONTENTS1_21_2,
+                new PotionContents(42, null,
+                        new PotionEffect[0]));
+        final BedrockItem nativeStrength = new BedrockItem(100, (short) 31, (byte) 1, null);
+        final BedrockItem nativeOozing = new BedrockItem(100, (short) 43, (byte) 1, null);
+        final CreativeCatalog catalog = new CreativeCatalog(List.of(), List.of(
+                new CreativeCatalog.Entry(11, 0, nativeStrength, strength, false, true),
+                new CreativeCatalog.Entry(12, 0, nativeOozing, oozing, false, true)));
+        assertEquals(11, catalog.creativeEntry(strength.copy()).netId());
+        assertEquals(12, catalog.creativeEntry(oozing.copy()).netId());
+        assertNull(catalog.creativeEntry(javaItem(3)));
+        final Item owned = javaItem(3);
+        final var context = new CompoundTag();
+        context.put(net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter.BEDROCK_STACK_TAG,
+                net.raphimc.viabedrock.api.model.NativeItemStackData.fromItem(nativeStrength).toTag());
+        owned.dataContainer().set(StructuredDataKey.CUSTOM_DATA, context);
+        assertEquals(11, catalog.creativeEntry(owned).netId());
+    }
+
+    @Test
+    void rejectsAmbiguousFireworkAndBookVariantsWithoutPaletteOrNativeIdentity() throws ReflectiveOperationException {
+        final Item item = javaItem(5);
+        final var firstTag = new CompoundTag();
+        firstTag.putInt("value", 1);
+        final var secondTag = new CompoundTag();
+        secondTag.putInt("value", 2);
+        final var first = new BedrockItem(100, (short) 0, (byte) 1, firstTag);
+        final var second = new BedrockItem(100, (short) 0, (byte) 1, secondTag);
+        final var catalog = new CreativeCatalog(List.of(), List.of(
+                new CreativeCatalog.Entry(31, 0, first, item, false, true),
+                new CreativeCatalog.Entry(32, 0, second, item, false, true)));
+        assertNull(catalog.creativeEntry(item));
+        final Item owned = javaItem(5);
+        final var context = new CompoundTag();
+        context.put(net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter.BEDROCK_STACK_TAG,
+                net.raphimc.viabedrock.api.model.NativeItemStackData.fromItem(second).toTag());
+        owned.dataContainer().set(StructuredDataKey.CUSTOM_DATA, context);
+        assertEquals(32, catalog.creativeEntry(owned).netId());
+        assertEquals(31, catalog.creativeEntry(catalog.entries().getFirst().javaItem()).netId());
+    }
+
+    private static Item javaItem(final int identifier) throws ReflectiveOperationException {
+        final StructuredDataContainer data = new StructuredDataContainer();
+        final FullMappings mappings = (FullMappings) Proxy.newProxyInstance(FullMappings.class.getClassLoader(),
+                new Class<?>[]{FullMappings.class}, (proxy, method, args) -> 0);
+        final Field lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        lookup.set(data, mappings);
+        return new StructuredItem(identifier, 1, data);
+    }
+
