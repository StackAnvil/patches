+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeBundleActionTest {
+
+    @Test
+    void wireRoundTripPreservesTypedSourceAndPublicationScope() {
+        final var action = new NativeBundleAction(0, 7, 3, 11, 2, "combined_hotbar_and_inventory_items", 35,
+                NativeBundleAction.Kind.SECONDARY, 2);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeBundleAction.TYPE.write(buffer, action);
+            final var decoded = NativeBundleAction.TYPE.read(buffer);
+            assertEquals(action, decoded);
+            assertFalse(buffer.isReadable());
+            final var message = mock(NativePlayerInventoryMessage.class);
+            when(message.menuId()).thenReturn(0);
+            when(message.opening()).thenReturn(7L);
+            when(message.generation()).thenReturn(3L);
+            when(message.revision()).thenReturn(11L);
+            assertTrue(decoded.belongsTo(message, 1));
+            assertFalse(decoded.belongsTo(message, 2));
+            when(message.generation()).thenReturn(4L);
+            assertFalse(decoded.belongsTo(message, 1));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void decoderRejectsTrailingFieldsUnknownKindsAndUnboundedInput() {
+        final var action = new NativeBundleAction(0, 7, 3, 11, 2, "inventory_items", 1, NativeBundleAction.Kind.PRIMARY, 0);
+        for (int mutation = 0; mutation < 4; mutation++) {
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeBundleAction.TYPE.write(buffer, action);
+                switch (mutation) {
+                    case 0 -> buffer.writeByte(0);
+                    case 1 -> buffer.setByte(buffer.writerIndex() - 2, 255);
+                    case 2 -> buffer.setByte(0, 2);
+                    case 3 -> buffer.writeZero(256);
+                    default -> throw new AssertionError();
+                }
+                assertThrows(IllegalArgumentException.class, () -> NativeBundleAction.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+}
