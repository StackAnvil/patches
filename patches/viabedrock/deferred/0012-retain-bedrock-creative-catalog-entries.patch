+    static void handleCreativeSlotPacket(final PacketWrapper wrapper) {
+        wrapper.cancel();
+        final int javaSlot = wrapper.read(Types.SHORT);
+        final Item javaItem = wrapper.read(VersionedTypes.V26_3.lengthPrefixedItem);
+
+        final InventoryTracker inventoryTracker = wrapper.user().get(InventoryTracker.class);
+        final InventoryRequestTracker requests = wrapper.user().get(InventoryRequestTracker.class);
+        if (requests.hasPending() || requests.isWaitingForLegacyOffhand()
+                || requests.isWaitingForInventoryOpen()
+                || inventoryTracker.getPendingCloseContainer() != null) {
+            if (!requests.queueCreativeSlot(inventoryTracker.getInventoryContainer(), javaSlot, javaItem)) {
+                PacketFactory.sendJavaContainerSetContent(wrapper.user(), inventoryTracker.getInventoryContainer());
+            }
+            return;
+        }
+        if (!handleCreativeSlot(wrapper.user(), javaSlot, javaItem)) {
+            PacketFactory.sendJavaContainerSetContent(wrapper.user(), inventoryTracker.getInventoryContainer());
+        }
+    }
