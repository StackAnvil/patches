+                .filter(node -> node.has("text") && node.get("text").getAsString().equals("Native §ggrid§f instructions"))
+                .findFirst().orElseThrow();
+        assertTrue(paragraph.get("text_component").toString().contains("#efce16"));
+        assertFalse(paragraph.get("text_component").toString().contains("#pre_process_"));
+        final var labels = nodes(scene.getAsJsonObject("root")).stream().filter(node -> node.has("text"))
+                .map(node -> node.get("text").getAsString()).toList();
