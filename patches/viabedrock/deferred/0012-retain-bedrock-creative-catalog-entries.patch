+    private static Context context(final boolean instabuild, final boolean filtering) throws Exception {
+        final var inventory = PlayerRecipeAvailabilityTest.context(false, IDENTIFIER - 1);
+        final var items = inventory.items();
+        final var recipes = new CraftingDataTracker(items.user());
+        when(items.user().get(CraftingDataTracker.class)).thenReturn(recipes);
+        final var abilities = RegisteredPlayerRecipeAvailabilityTest.playerAbilities(inventory);
+        abilities.getOrCreateLayer(SerializedAbilitiesData_SerializedAbilitiesLayer.Base).setAbility(AbilitiesIndex.Instabuild, instabuild);
+        final var rules = mock(GameRulesStorage.class);
+        when(items.user().get(GameRulesStorage.class)).thenReturn(rules);
+        when(rules.getGameRule("recipesUnlock")).thenReturn(true);
+        recipes.updateCraftingDataList(List.of(new CraftingDataStorage(RecipeType.SHAPED, 1,
+                new ShapedRecipe("a", new UUID(0, 1), "crafting_table", 0, 1, 1,
+                        List.of(new ItemDescriptor.ItemNameDescriptor("test:ordinary_1", 0, 1)),
+                        List.of(new BedrockItem(IDENTIFIER)), false), false)), true);
+        recipes.updateUnlockedRecipes(1, List.of("a"));
+        inventory.inventory().getInventoryContainer().setItem(9, new BedrockItem(IDENTIFIER, (short) 0, (byte) 3));
+        final var entries = new ArrayList<CreativeCatalog.Entry>();
+        for (int metadata = 0; metadata < 4; metadata++) {
+            entries.add(new CreativeCatalog.Entry(metadata + 1, 0,
+                    new BedrockItem(IDENTIFIER, (short) metadata, (byte) 1), javaItem(), false, false));
+        }
+        items.setCreativeCatalog(List.of(new CreativeCatalog.Group(1, "g", new BedrockItem(IDENTIFIER), javaItem())), entries);
+        final var primary = new AtomicInteger();
+        final var secondary = new AtomicInteger();
+        doAnswer(call -> {
+            primary.incrementAndGet();
+            return "stone";
+        }).when(items).itemPrimaryName(any());
+        doAnswer(call -> {
+            secondary.incrementAndGet();
+            return "other";
+        }).when(items).itemSecondaryDescription(any());
+        final var model = items.playerRecipeModel(inventory.owner(), filtering, true, new byte[0]);
+        return new Context(inventory, items, abilities, model, primary, secondary);
+    }
+
+    private static StructuredItem javaItem() throws ReflectiveOperationException {
+        final var data = new StructuredDataContainer();
+        final var lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        lookup.set(data, mock(FullMappings.class));
+        return new StructuredItem(1, 1, data);
+    }
+
+    private static byte[] previewBytes(final Item item) {
+        final var buffer = Unpooled.buffer();
+        try {
+            VersionedTypes.V26_3.item.write(buffer, item);
+            return ByteBufUtil.getBytes(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private record Installed(Context context, PlayerInventoryScreenTracker screens, NativePlayerRecipeState state) {
+        private void acknowledge() {
+            final var owner = new InventoryContainer(this.context.items.user(), (byte) 0, null,
+                    this.context.inventory.inventory().getInventoryContainer());
+            this.context.inventory.inventory().setCurrentContainer(owner);
+            this.screens.opened();
+        }
+    }
+
+    private record Context(PlayerRecipeAvailabilityTest.Context inventory, ItemRewriter items, PlayerAbilities abilities,
+                           PlayerRecipeModel model, AtomicInteger primary, AtomicInteger secondary) { }
+
