+            tag.putInt("custom", 5);
+            previous.setTag(tag);
+            fixture.selected.setTag(tag.copy());
+            fixture.inventory.getInventoryContainer().setItem(0, previous);
+            if (!open) {
+                fixture.inventory.setCurrentContainerClosed(false);
