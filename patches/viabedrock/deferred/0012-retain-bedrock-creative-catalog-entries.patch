+                + "howtoplay.yourFirstCraft=Your First Craft\nhowtoplay.category.gettingStarted=Getting Started\n");
+        final var ui = new PlayerInventoryUi(new ResourcePackStorage(List.of(new ResourcePack(content))).getJsonUiProgram());
+        final var scene = ui.help(false, 5);
+        final var paragraph = nodes(scene.getAsJsonObject("root")).stream()
+                .filter(node -> node.has("text") && node.get("text").getAsString().equals("Native §ggrid§f instructions"))
+                .findFirst().orElseThrow();
+        assertTrue(paragraph.get("text_component").toString().contains("#ded605"));
+        assertFalse(paragraph.get("text_component").toString().contains("#pre_process_"));
+        final var labels = nodes(scene.getAsJsonObject("root")).stream().filter(node -> node.has("text"))
+                .map(node -> node.get("text").getAsString()).toList();
+        assertTrue(labels.contains("Your First Craft"));
+        assertTrue(labels.contains("Getting Started"));
+        assertEquals(scene, PlayerInventoryUi.fromProgram(ui.exportProgram(false)).help(false, 5));
+    }
+
+    private static List<JsonObject> nodes(final JsonObject node) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(node);
+        if (node.has("children")) {
+            for (final var child : node.getAsJsonArray("children")) {
+                result.addAll(nodes(child.getAsJsonObject()));
+            }
+        }
+        return result;
+    }
+
+}
