+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.Objects;
+
+/** Optional bundle reply keeps operation sounds distinct from unavailable or stale input. */
+public record NativeBundleResult(NativePlayerInventoryResult result, Sound sound) {
+
+    public static final String CHANNEL = "viabedrock:native_bundle_result";
+    public static final Type<NativeBundleResult> TYPE = new Type<>(NativeBundleResult.class) {
+        @Override
+        public NativeBundleResult read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 52 || buffer.readUnsignedByte() != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native bundle reply");
+            }
+            final int sound = buffer.readUnsignedByte();
+            if (sound >= Sound.values().length) {
+                throw new IllegalArgumentException("Unknown native bundle sound");
+            }
+            return new NativeBundleResult(NativePlayerInventoryResult.TYPE.read(buffer), Sound.values()[sound]);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeBundleResult value) {
+            buffer.writeByte(1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(value.sound.ordinal());
+            NativePlayerInventoryResult.TYPE.write(buffer, value.result);
+        }
+    };
+
+    public NativeBundleResult {
+        Objects.requireNonNull(result);
+        Objects.requireNonNull(sound);
+        if (sound != Sound.NONE && result.accepted() != (sound != Sound.INSERT_FAIL)) {
+            throw new IllegalArgumentException("Bundle sound differs from its operation result");
+        }
+    }
+
+    /** Null means no operation ran, including a stale publication or unavailable source. */
+    public static NativeBundleResult reply(final NativeBundleAction action, final long revision, final Boolean successful) {
+        final Sound sound = successful == null ? Sound.NONE : action.kind() == NativeBundleAction.Kind.PRIMARY
+                ? successful ? Sound.INSERT : Sound.INSERT_FAIL : successful ? Sound.REMOVE_ONE : Sound.NONE;
+        return new NativeBundleResult(new NativePlayerInventoryResult(action.opening(), action.generation(), action.request(), revision,
+                Boolean.TRUE.equals(successful)), sound);
+    }
+
+    public enum Sound {
+        NONE(""), INSERT("bundle.insert"), INSERT_FAIL("bundle.insert_fail"), REMOVE_ONE("bundle.remove_one");
+
+        private final String event;
+
+        Sound(final String event) {
+            this.event = event;
+        }
+
+        public String event() {
+            return this.event;
+        }
+    }
+
+}
