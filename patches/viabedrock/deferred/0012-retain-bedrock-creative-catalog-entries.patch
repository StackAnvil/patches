+    private static CreativeInventoryModel playerModel(final CreativeCatalog catalog) {
+        return new CreativeInventoryModel(catalog, (view, item) -> 1,
+                (first, second) -> NativeItemStackMatcher.matchesIdentity(first, second, ignored -> null, ignored -> Set.of()));
