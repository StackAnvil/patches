+    /** Refresh before admitting a command: an older preview cannot authorize a changed source or opening. */
+    public NativeBundleActionSession.Outcome handleBundleAction(final NativeBundleAction action) {
+        this.tick();
+        final var message = this.publication();
+        if (!this.actionsEnabled() || !action.belongsTo(message, this.lastRequest) || !this.canRequest(message)) {
+            return null;
+        }
+        this.lastRequest = action.request();
+        final var result = this.bundleInputs == null ? null : this.bundleInputs.execute(action);
+        if (result == null) {
+            return null;
+        }
+        this.presentationDirty = true;
+        final var inventory = this.user().get(InventoryTracker.class);
+        PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getCurrentContainer());
+        if (inventory.getCurrentContainer() != inventory.getInventoryContainer()) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getInventoryContainer());
+        }
+        return result;
+    }
+
+    /** Refresh before admitting a command: an older preview cannot authorize a changed source or opening. */
+    public boolean handleAction(final NativePlayerInventoryAction action) {
+        this.tick();
+        final var message = this.publication();
+        if (!this.actionsEnabled() || !action.belongsTo(message, this.lastRequest)) {
+            return false;
+        }
+        this.lastRequest = action.request();
+        if (action.kind() == NativePlayerInventoryAction.Kind.PREFERENCES) {
+            final var options = this.user().get(InventoryOptionsStorage.class);
+            options.applyInventory(action.options(), this.context.workbench());
+            final var packet = PacketWrapper.create(ServerboundBedrockPackets.SET_PLAYER_INVENTORY_OPTIONS, this.user());
+            packet.write(BedrockTypes.INVENTORY_OPTIONS, action.options());
+            packet.sendToServer(BedrockProtocol.class);
+            options.sendJavaSettings(this.user());
+            this.presentationDirty = true;
+            return true;
+        }
+        if (action.kind() == NativePlayerInventoryAction.Kind.SEARCH) {
+            this.model.updateQuery(action.query());
+            this.presentationDirty = true;
+            return true;
+        }
+        final var state = message.state();
+        if (action.kind() == NativePlayerInventoryAction.Kind.AUTO_DESTROY) {
+            return state.creative() && !state.workbench() && state.effectiveLayout() == 3 && this.canRequest(message)
+                    && this.destroyCreativeHotbar(action.target() - 36);
+        }
+        if (action.target() >= state.cells().size() || state.cells().get(action.target()).id() != action.target()
+                || state.cells().get(action.target()).disabled() && action.kind() != NativePlayerInventoryAction.Kind.PRIMARY) {
+            return false;
+        }
+        final var view = Arrays.stream(CreativeInventoryModel.View.values()).filter(value -> value.leftTab() == state.leftTab()).findFirst().orElse(null);
+        if (view == null) {
+            return false;
+        }
+        final var collection = this.model.collections().collection(view);
+        if (action.target() >= collection.snapshot().rows().size()) {
+            return false;
+        }
+        final var row = collection.snapshot().rows().get(action.target());
+        if (row instanceof RecipeCollection.Header<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> header) {
+            if (state.cells().get(action.target()).disabled() || action.kind() != NativePlayerInventoryAction.Kind.PRIMARY) {
+                return false;
+            }
+            final boolean changed = collection.toggleHeader(header.group()) != null;
+            this.presentationDirty |= changed;
+            return changed;
+        }
+        final var entry = row instanceof RecipeCollection.Item<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> item
+                ? item.entry() : ((RecipeCollection.Member<CreativeCatalog.CollectionEntry, CreativeCatalog.Group>) row).entry();
+        final var inventory = this.user().get(InventoryTracker.class);
+        if (!this.canRequest(message)) {
+            return false;
+        }
+        final var owner = inventory.getCurrentContainer();
+        this.model.selectOutput(entry.item());
+        this.presentationDirty = true;
+        if (state.creative()) {
+            return action.kind() == NativePlayerInventoryAction.Kind.BULK ? this.placeCreative(entry)
+                    : this.pickCreative(entry, action.kind() == NativePlayerInventoryAction.Kind.SECONDARY);
+        }
+        if (action.kind() == NativePlayerInventoryAction.Kind.BULK) {
+            return this.placeSurvival(entry);
+        }
+        if (action.kind() == NativePlayerInventoryAction.Kind.SECONDARY && !state.creative()) {
+            return true;
+        }
+        if (action.kind() != NativePlayerInventoryAction.Kind.PRIMARY) {
+            return false;
+        }
+        final var recipes = this.user().get(CraftingDataTracker.class);
+        final var preview = recipes.playerRecipePreview(entry.item(), this.context);
+        if (preview == null) {
+            return false;
+        }
+        this.craftingPreview = preview;
+        if (state.cells().get(action.target()).disabled()) {
+            return true;
+        }
+        final boolean placed = owner instanceof InventoryContainer player ? player.handleRecipePlacement(preview.recipe(), true)
+                : owner instanceof CraftingTableContainer table && table.handleRecipePlacement(preview.recipe(), true);
+        if (placed) {
+            PacketFactory.sendJavaContainerSetContent(this.user(), owner);
+            PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getInventoryContainer());
+        }
+        return true;
+    }
