+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.data.FullMappings;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataContainer;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class CreativeCatalogTest {
+
+    @Test
+    void resolvesDistinctBedrockEntriesMappedToTheSameJavaItem() throws ReflectiveOperationException {
+        final Item paper = javaItem(1);
+        final CreativeCatalog catalog = new CreativeCatalog(List.of(), List.of(
+                new CreativeCatalog.Entry(11, 0, new BedrockItem(100), paper, true, false),
+                new CreativeCatalog.Entry(12, 0, new BedrockItem(101), paper, true, false)));
+
+        assertEquals(100, catalog.creativeItem(catalog.entries().get(0).javaItem()).identifier());
+        assertEquals(101, catalog.creativeItem(catalog.entries().get(1).javaItem()).identifier());
+        assertEquals(11, catalog.entries().get(0).javaItem().dataContainer().get(StructuredDataKey.CUSTOM_DATA)
+                .getInt("viabedrock:creative_entry"));
+        assertEquals(100, catalog.creativeItem(paper).identifier());
+        assertNull(catalog.creativeItem(javaItem(2)));
+    }
+
+    @Test
+    void prefersCanonicalEntryForUntaggedJavaItems() throws ReflectiveOperationException {
+        final Item mapped = javaItem(2);
+        final CreativeCatalog catalog = new CreativeCatalog(List.of(), List.of(
+                new CreativeCatalog.Entry(21, 0, new BedrockItem(200), mapped, true, false),
+                new CreativeCatalog.Entry(22, 0, new BedrockItem(201), mapped, false, true)));
+
+        assertEquals(201, catalog.creativeItem(mapped).identifier());
+        assertEquals(200, catalog.creativeItem(catalog.entries().get(0).javaItem()).identifier());
+        assertEquals(201, catalog.creativeItem(catalog.entries().get(1).javaItem()).identifier());
+    }
+
+    private static Item javaItem(final int identifier) throws ReflectiveOperationException {
+        final StructuredDataContainer data = new StructuredDataContainer();
+        final FullMappings mappings = (FullMappings) Proxy.newProxyInstance(FullMappings.class.getClassLoader(),
+                new Class<?>[]{FullMappings.class}, (proxy, method, args) -> 0);
+        final Field lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        lookup.set(data, mappings);
+        return new StructuredItem(identifier, 1, data);
+    }
+
+}
