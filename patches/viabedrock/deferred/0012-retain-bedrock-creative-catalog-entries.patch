+import net.raphimc.viabedrock.protocol.storage.NativePlayerRecipeState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeBundleResultPacketTest {
+
+    @Test
+    void bundleRepliesUseTheOptionalEnvelopeOnlyForClientsThatAdvertiseIt() throws Exception {
+        for (final boolean extended : new boolean[]{false, true}) {
+            for (final Boolean success : new Boolean[]{null, false, true}) {
+                final var user = mock(UserConnection.class);
+                final var state = mock(NativePlayerRecipeState.class);
+                final var channels = mock(ChannelStorage.class);
+                final var published = mock(NativePlayerInventoryMessage.class);
+                when(user.get(NativePlayerRecipeState.class)).thenReturn(state);
+                when(user.get(ChannelStorage.class)).thenReturn(channels);
+                when(channels.hasChannel(NativeBundleResult.CHANNEL)).thenReturn(extended);
+                when(state.actionsEnabled()).thenReturn(true);
+                when(state.publication()).thenReturn(published);
+                when(published.revision()).thenReturn(12L);
+                final var command = new NativeBundleAction(0, 7, 3, 11, 2, "inventory_items", 0, NativeBundleAction.Kind.PRIMARY, 2);
+                when(state.handleBundleAction(command)).thenReturn(success == null ? null : new NativeBundleActionSession.Outcome(success, 0));
+                final var request = new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, null, user);
+                request.write(Types.STRING, NativeBundleAction.CHANNEL);
+                request.write(NativeBundleAction.TYPE, command);
+                request.resetReader();
+                final var reply = spy(new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, null, user));
+                doNothing().when(reply).send(BedrockProtocol.class);
+                try (var factory = mockStatic(PacketWrapper.class)) {
+                    factory.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(reply);
+                    MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(request);
+                    assertTrue(request.isCancelled());
+                    verify(reply).send(BedrockProtocol.class);
+                    if (extended) {
+                        assertEquals(NativeBundleResult.CHANNEL, reply.get(Types.STRING, 0));
+                        final var result = reply.get(NativeBundleResult.TYPE, 0);
+                        assertEquals(success == null ? "" : success ? "bundle.insert" : "bundle.insert_fail", result.sound().event());
+                        assertEquals(new NativePlayerInventoryResult(7, 3, 2, 12, Boolean.TRUE.equals(success)), result.result());
+                    } else {
+                        assertEquals(NativePlayerInventoryResult.CHANNEL, reply.get(Types.STRING, 0));
+                        assertEquals(new NativePlayerInventoryResult(7, 3, 2, 12, Boolean.TRUE.equals(success)), reply.get(NativePlayerInventoryResult.TYPE, 0));
+                    }
+                }
+            }
+        }
+    }
+
+}
