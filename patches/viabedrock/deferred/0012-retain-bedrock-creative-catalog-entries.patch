+            model.tick(6, true, false);
+        }
+        assertTrue(model.ready());
+        assertTrue(model.collection(CreativeInventoryModel.View.CONSTRUCTION).snapshot().rows().isEmpty());
+        assertTrue(model.tick(1, true, false));
+        final var collection = model.collection(CreativeInventoryModel.View.CONSTRUCTION);
+        assertEquals(4, collection.toggleHeader(catalog.groups().getFirst()).memberCount());
+        model.invalidate(CreativeInventoryModel.View.CONSTRUCTION);
