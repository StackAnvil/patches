+    private void refreshCapability() {
+        final boolean available = this.actionsEnabled();
+        if (available == this.actionsAdvertised) {
+            return;
+        }
+        if (this.user().getProtocolInfo().getClientState() != State.PLAY) {
+            this.actionsAdvertised = false;
+            return;
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, available ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, (NativePlayerInventoryAction.CHANNEL + "\0" + NativePlayerInventoryAction.AUTO_DESTROY_CHANNEL
+                + "\0" + NativeBundleAction.CHANNEL).getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+        this.actionsAdvertised = available;
+    }
