+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeBundleResultTest {
+
+    @Test
+    void extendedReplyPreservesTheLegacyReplyAndScopesItsNativeSound() {
+        final var reply = new NativeBundleResult(new NativePlayerInventoryResult(7, 3, 2, 12, true), NativeBundleResult.Sound.INSERT);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeBundleResult.TYPE.write(buffer, reply);
+            final byte[] bytes = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, bytes);
+            assertArrayEquals(new byte[]{1, (byte) 0xB1, 0x11, 1, 1, 7, 3, 2, 12, 1}, bytes);
+            assertEquals(reply, NativeBundleResult.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            // The optional envelope retains the exact original v1 result encoding.
+            buffer.readerIndex(4);
+            assertEquals(reply.result(), NativePlayerInventoryResult.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnknownSoundsWrongProtocolsTrailingFieldsAndConflictingAcceptance() {
+        final var reply = new NativeBundleResult(new NativePlayerInventoryResult(7, 3, 2, 12, false), NativeBundleResult.Sound.INSERT_FAIL);
+        for (int mutation = 0; mutation < 5; mutation++) {
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeBundleResult.TYPE.write(buffer, reply);
+                switch (mutation) {
+                    case 0 -> buffer.setByte(3, 255);
+                    case 1 -> buffer.setByte(1, 0xB2);
+                    case 2 -> buffer.writeByte(0);
+                    case 3 -> buffer.setByte(buffer.writerIndex() - 1, 1);
+                    case 4 -> buffer.writeZero(52);
+                    default -> throw new AssertionError();
+                }
+                assertThrows(IllegalArgumentException.class, () -> NativeBundleResult.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+}
