+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Only a displayed source and input are client supplied; stacks and physical contents remain server owned. */
+public record NativeBundleAction(int menuId, long opening, long generation, long revision, long request,
+                                 String collection, int index, Kind kind, int tooltipMode) {
+
+    public static final String CHANNEL = "viabedrock:native_bundle_input";
+    public static final Type<NativeBundleAction> TYPE = new Type<>(NativeBundleAction.class) {
+        @Override
+        public NativeBundleAction read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 256 || buffer.readUnsignedByte() != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native bundle input");
+            }
+            final int menu = Types.VAR_INT.readPrimitive(buffer);
+            final long opening = Types.VAR_LONG.readPrimitive(buffer);
+            final long generation = Types.VAR_LONG.readPrimitive(buffer);
+            final long revision = Types.VAR_LONG.readPrimitive(buffer);
+            final long request = Types.VAR_LONG.readPrimitive(buffer);
+            final String collection = Types.STRING.read(buffer);
+            final int index = Types.VAR_INT.readPrimitive(buffer);
+            final int kind = buffer.readUnsignedByte();
+            if (kind >= Kind.values().length) {
+                throw new IllegalArgumentException("Unknown native bundle input kind");
+            }
+            final var action = new NativeBundleAction(menu, opening, generation, revision, request, collection, index,
+                    Kind.values()[kind], buffer.readUnsignedByte());
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native bundle input");
+            }
+            return action;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeBundleAction action) {
+            buffer.writeByte(1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, action.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, action.opening);
+            Types.VAR_LONG.writePrimitive(buffer, action.generation);
+            Types.VAR_LONG.writePrimitive(buffer, action.revision);
+            Types.VAR_LONG.writePrimitive(buffer, action.request);
+            Types.STRING.write(buffer, action.collection);
+            Types.VAR_INT.writePrimitive(buffer, action.index);
+            buffer.writeByte(action.kind.ordinal()).writeByte(action.tooltipMode);
+        }
+    };
+
+    public NativeBundleAction {
+        if (menuId < 0 || menuId > 255 || opening < 0 || generation <= 0 || revision <= 0 || request <= 0
+                || collection == null || !collection.matches("[a-z_]{1,64}") || index < 0 || index > 255
+                || kind == null || tooltipMode != 0 && tooltipMode != 2) {
+            throw new IllegalArgumentException("Invalid native bundle input");
+        }
+    }
+
+    public boolean belongsTo(final NativePlayerInventoryMessage message, final long lastRequest) {
+        return message != null && this.menuId == message.menuId() && this.opening == message.opening()
+                && this.generation == message.generation() && this.revision == message.revision() && this.request > lastRequest;
+    }
+
+    public enum Kind {
+        PRIMARY, SECONDARY
+    }
+
+}
