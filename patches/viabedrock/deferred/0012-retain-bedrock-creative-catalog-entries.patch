+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+
+/** A reply releases only the command which belongs to the same opening and generation. */
+public record NativePlayerInventoryResult(long opening, long generation, long request, long revision, boolean accepted) {
+
+    public static final String CHANNEL = "viabedrock:native_player_result";
+    public static final Type<NativePlayerInventoryResult> TYPE = new Type<>(NativePlayerInventoryResult.class) {
+        @Override
+        public NativePlayerInventoryResult read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 48 || buffer.readUnsignedByte() != 1) {
+                throw new IllegalArgumentException("Unsupported player inventory reply");
+            }
+            final var result = new NativePlayerInventoryResult(Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), buffer.readBoolean());
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing player inventory reply");
+            }
+            return result;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativePlayerInventoryResult value) {
+            buffer.writeByte(1);
+            Types.VAR_LONG.writePrimitive(buffer, value.opening);
+            Types.VAR_LONG.writePrimitive(buffer, value.generation);
+            Types.VAR_LONG.writePrimitive(buffer, value.request);
+            Types.VAR_LONG.writePrimitive(buffer, value.revision);
+            buffer.writeBoolean(value.accepted);
+        }
+    };
+
+    public NativePlayerInventoryResult {
+        if (opening < 0 || generation < 0 || request <= 0 || revision < 0) {
+            throw new IllegalArgumentException("Invalid player inventory reply");
+        }
+    }
+
+}
