+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.AbilitiesIndex;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataTracker;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+
+import java.util.Arrays;
+import java.util.Objects;
+
+/** One backend's recipe query, selected output and collections, independent of screen presentation. */
+public final class PlayerRecipeModel {
+
+    private final CraftingDataTracker recipes;
+    private final PlayerRecipeContext owner;
+    private final boolean categoryGrouping;
+    private final boolean includeCursor;
+    private CreativeInventoryModel collections;
+    private CraftingDataTracker.PlayerRecipeSearch search;
+    private boolean filtering;
+    private byte[] query;
+    private BedrockItem selectedOutput = BedrockItem.empty();
+
+    /** Filtering is the effective backend policy; profile preferences belong to the screen controller. */
+    public PlayerRecipeModel(final ItemRewriter items, final CraftingDataTracker recipes, final Container owner,
+                             final boolean filtering, final boolean includeCursor, final byte[] query) {
+        this(items, recipes, PlayerRecipeContext.forContainer(items.user(), owner), filtering, includeCursor, query);
+    }
+
+    public PlayerRecipeModel(final ItemRewriter items, final CraftingDataTracker recipes, final PlayerRecipeContext owner,
+                             final boolean filtering, final boolean includeCursor, final byte[] query) {
+        Objects.requireNonNull(items);
+        this.recipes = Objects.requireNonNull(recipes);
+        this.owner = Objects.requireNonNull(owner);
+        this.requireCurrentOwner();
+        this.query = query.clone();
+        this.categoryGrouping = items.user().get(EntityTracker.class).getClientPlayer().abilities().getBooleanValue(AbilitiesIndex.Instabuild);
+        this.includeCursor = includeCursor;
+        this.reinstallPolicies(filtering);
+        this.replaceCatalog(items);
+    }
+
+    /** New catalog sources do not reconstruct the backend or recapture its installed ability policies. */
+    public void replaceCatalog(final ItemRewriter items) {
+        this.requireCurrentOwner();
+        this.collections = items.creativeInventoryModel(this::availability);
+    }
+
+    public int availability(final CreativeInventoryModel.View view, final BedrockItem output) {
+        this.requireCurrentOwner();
+        return view == CreativeInventoryModel.View.SEARCH
+                ? this.search.availability(output, this.selectedOutput, this.owner, this.filtering, this.includeCursor)
+                : this.recipes.playerRecipeCategoryAvailability(output, this.selectedOutput, this.owner, this.filtering, this.includeCursor);
+    }
+
+    /** Explicit callback installation captures current search abilities without replacing collection sources or expansion. */
+    public void reinstallPolicies(final boolean filtering) {
+        this.requireCurrentOwner();
+        this.filtering = filtering;
+        this.search = this.recipes.playerRecipeSearch(this.query);
+    }
+
+    public boolean tick(final int leftTab) {
+        this.requireCurrentOwner();
+        return this.collections.tick(leftTab, this.categoryGrouping && leftTab != CreativeInventoryModel.View.SEARCH.leftTab(), this.filtering);
+    }
+
+    public void refresh(final CreativeInventoryModel.View view, final boolean resetExpansion) {
+        this.requireCurrentOwner();
+        this.collections.refresh(view, this.categoryGrouping && view != CreativeInventoryModel.View.SEARCH, this.filtering, resetExpansion);
+    }
+
+    public boolean updateQuery(final String query) {
+        return this.updateQuery(NbtUtf8.encode(query));
+    }
+
+    /** Raw equality retains selection. Every raw change refreshes search, even when normalization produces identical text. */
+    public boolean updateQuery(final byte[] query) {
+        Objects.requireNonNull(query);
+        if (Arrays.equals(this.query, query)) {
+            return false;
+        }
+        this.requireCurrentOwner();
+        this.selectedOutput = BedrockItem.empty();
+        this.query = query.clone();
+        this.search.updateQuery(this.query);
+        this.refresh(CreativeInventoryModel.View.SEARCH, false);
+        return true;
+    }
+
+    public byte[] query() {
+        return this.query.clone();
+    }
+
+    public void selectOutput(final BedrockItem output) {
+        this.requireCurrentOwner();
+        this.selectedOutput = Objects.requireNonNull(output).copy();
+    }
+
+    /** Native count text reads output quantity, never the collection's availability state. */
+    public int outputCount(final BedrockItem output) {
+        this.requireCurrentOwner();
+        return this.recipes.playerRecipeOutputCount(output, this.owner, this.includeCursor);
+    }
+
+    public BedrockItem selectedOutput() {
+        return this.selectedOutput.copy();
+    }
+
+    public CreativeInventoryModel collections() {
+        return this.collections;
+    }
+
+    private void requireCurrentOwner() {
+        this.owner.requireCurrent();
+    }
+
+}
