+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.container.Container;
+import net.raphimc.viabedrock.api.model.container.NativeRecipeCounter;
+import net.raphimc.viabedrock.api.model.container.block.CraftingTableContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.protocol.storage.CraftingDataTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerInventoryScreenTracker;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.function.BooleanSupplier;
+import java.util.function.Supplier;
+
+/** Read-only recipe sources follow the presentation lifetime, independently of item-request authority. */
+public final class PlayerRecipeContext {
+
+    private final UserConnection user;
+    private final InventoryTracker inventory;
+    private final boolean workbench;
+    private final BooleanSupplier current;
+    private final Supplier<Container> anchor;
+    private final Container acknowledged;
+
+    private PlayerRecipeContext(final UserConnection user, final boolean workbench, final BooleanSupplier current,
+                                final Supplier<Container> anchor, final Container acknowledged) {
+        this.user = Objects.requireNonNull(user);
+        this.inventory = Objects.requireNonNull(user.get(InventoryTracker.class));
+        this.workbench = workbench;
+        this.current = current;
+        this.anchor = anchor;
+        this.acknowledged = acknowledged;
+    }
+
+    /** A workstation model still belongs to one exact acknowledged container generation. */
+    public static PlayerRecipeContext forContainer(final UserConnection user, final Container owner) {
+        final var inventory = Objects.requireNonNull(user.get(InventoryTracker.class));
+        final long generation = inventory.currentContainerGeneration();
+        return new PlayerRecipeContext(user, owner instanceof CraftingTableContainer,
+                () -> owner != null && generation != 0 && inventory.getCurrentContainer() == owner
+                        && inventory.currentContainerGeneration() == generation,
+                () -> owner, owner);
+    }
+
+    /** An installed E-key screen can read cached player slots while its native open is pending. */
+    public static PlayerRecipeContext forPlayerOpening(final UserConnection user, final PlayerInventoryScreenTracker screens,
+                                                       final long opening) {
+        Objects.requireNonNull(screens);
+        final var inventory = Objects.requireNonNull(user.get(InventoryTracker.class));
+        return new PlayerRecipeContext(user, false,
+                () -> user.get(PlayerInventoryScreenTracker.class) == screens && screens.ownsPresentation(opening),
+                () -> screens.acknowledgedContainer(opening) instanceof InventoryContainer owner
+                        ? owner : inventory.getInventoryContainer(), null);
+    }
+
+    public void requireCurrent() {
+        if (!this.isCurrent()) {
+            throw new IllegalStateException("Player recipe model belongs to a retired inventory opening");
+        }
+    }
+
+    public boolean isCurrent() {
+        return this.user.get(InventoryTracker.class) == this.inventory && this.current.getAsBoolean();
+    }
+
+    public boolean workbench() {
+        return this.workbench;
+    }
+
+    /** Actual position/name source; this read does not grant item-request authority. */
+    public Container craftingAnchor() {
+        this.requireCurrent();
+        return this.anchor.get();
+    }
+
+    public List<String> recipeTags(final CraftingDataTracker recipes) {
+        if (this.acknowledged == null) {
+            this.requireCurrent();
+        }
+        return recipes.recipeContexts(this.anchor.get());
+    }
+
+    public List<NativeRecipeCounter.Source> sources(final boolean includeCursor) {
+        this.requireCurrent();
+        return this.acknowledged != null ? this.inventory.craftingSources(this.acknowledged, includeCursor)
+                : this.inventory.playerCraftingSources(includeCursor);
+    }
+
+}
