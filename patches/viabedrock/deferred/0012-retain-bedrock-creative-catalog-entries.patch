+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemStoragePolicy;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.RecipeMolangExpression;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+
+/** Descriptor bindings belong to the storage definition and its connection registry. */
+public final class NativeStoragePolicy {
+
+    private final ItemStoragePolicy policy;
+    private final NativeRecipeDescriptor.Registry registry;
+    private final List<NativeRecipeDescriptor> allowed;
+    private final List<NativeRecipeDescriptor> banned;
+    private final Integer molangVersion;
+
+    private NativeStoragePolicy(final ItemStoragePolicy policy, final NativeRecipeDescriptor.Registry registry,
+                                final List<NativeRecipeDescriptor> allowed, final List<NativeRecipeDescriptor> banned,
+                                final Integer molangVersion) {
+        this.policy = policy;
+        this.registry = registry;
+        this.allowed = List.copyOf(allowed);
+        this.banned = List.copyOf(banned);
+        this.molangVersion = molangVersion;
+    }
+
+    /** The caller must supply a known language context; raw storage metadata does not establish one. */
+    public static NativeStoragePolicy bind(final ItemStoragePolicy policy, final NativeRecipeDescriptor.Registry registry,
+                                           final Integer molangVersion) {
+        if (policy == null) {
+            return null;
+        }
+        final var allowed = descriptors(policy.allowedItems(), registry, molangVersion);
+        final var banned = descriptors(policy.bannedItems(), registry, molangVersion);
+        if (allowed == null || banned == null) {
+            return null;
+        }
+        final boolean expressions = allowed.stream().anyMatch(NativeRecipeDescriptor.Molang.class::isInstance)
+                || banned.stream().anyMatch(NativeRecipeDescriptor.Molang.class::isInstance);
+        return new NativeStoragePolicy(policy, registry, allowed, banned, expressions ? molangVersion : null);
+    }
+
+    /** Filter admission is independent of recipe-source locks, quantity and slot permissions. */
+    public boolean accepts(final BedrockItem item, final Function<BedrockItem, ItemRecipeDescriptor> descriptor) {
+        final var candidate = descriptor.apply(item);
+        final Function<BedrockItem, ItemRecipeDescriptor> snapshot = ignored -> candidate;
+        return (this.allowed.isEmpty() || this.allowed.stream().anyMatch(value -> value.matchesStack(item, this.registry, snapshot)))
+                && this.banned.stream().noneMatch(value -> value.matchesStack(item, this.registry, snapshot));
+    }
+
+    public int maxSlots() {
+        return this.policy.maxSlots();
+    }
+
+    public boolean allowNested() {
+        return this.policy.allowNested();
+    }
+
+    public Integer molangVersion() {
+        return this.molangVersion;
+    }
+
+    private static List<NativeRecipeDescriptor> descriptors(final List<Map<String, String>> input,
+                                                           final NativeRecipeDescriptor.Registry registry,
+                                                           final Integer molangVersion) {
+        final List<NativeRecipeDescriptor> result = new ArrayList<>(input.size());
+        for (final var fields : input) {
+            if (fields.containsKey("tags")) {
+                // The bounded tag-expression compiler targets the latest language context only.
+                // Unsupported compilation must not turn a banned predicate into an empty filter.
+                if (molangVersion == null || molangVersion != 65535) {
+                    return null;
+                }
+                final var expression = RecipeMolangExpression.compile(fields.get("tags"));
+                if (expression.isEmpty()) {
+                    return null;
+                }
+                result.add(new NativeRecipeDescriptor.Molang(expression.get()));
+            } else if (fields.containsKey("name")) {
+                final String name = fields.get("name");
+                result.add(name.isEmpty() ? NativeRecipeDescriptor.Empty.INSTANCE
+                        : new NativeRecipeDescriptor.Deferred(name, Short.MAX_VALUE));
+            } else if (fields.containsKey("item_tag")) {
+                result.add(NativeRecipeDescriptor.resolveTag(fields.get("item_tag"), registry));
+            } else {
+                // Storage vector conversion initializes each descriptor empty before reading its map.
+                result.add(NativeRecipeDescriptor.Empty.INSTANCE);
+            }
+        }
+        return result;
+    }
+
+}
