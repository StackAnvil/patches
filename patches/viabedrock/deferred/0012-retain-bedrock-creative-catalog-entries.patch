+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_QUERY_COLLECTIONS", matches = ".+")
+    void matchesOriginalQuerySetterThroughRealCollectionRefresh() throws Exception {
+        try (var input = new InputStreamReader(new GZIPInputStream(Files.newInputStream(
+                Path.of(System.getenv("STACKANVIL_NATIVE_QUERY_COLLECTIONS")))), StandardCharsets.UTF_8)) {
+            verify(JsonParser.parseReader(input).getAsJsonObject());
+        }
+    }
+
+    static int verify(final JsonObject fixture) throws Exception {
+        int count = 0;
+        for (final var value : fixture.getAsJsonArray("cases")) {
+            final var test = value.getAsJsonObject();
+            final var context = context(test.get("installed").getAsBoolean(), test.get("filtering").getAsBoolean());
+            final var model = context.model;
+            populate(model);
+            model.refresh(CreativeInventoryModel.View.SEARCH, false);
+            context.abilities.getOrCreateLayer(SerializedAbilitiesData_SerializedAbilitiesLayer.Base)
+                    .setAbility(AbilitiesIndex.Instabuild, test.get("current").getAsBoolean());
+            for (final var step : test.getAsJsonArray("rows")) {
+                final var row = step.getAsJsonObject();
+                if (row.get("reinstall").getAsBoolean()) {
+                    model.reinstallPolicies(test.get("filtering").getAsBoolean());
+                }
+                model.selectOutput(new BedrockItem(IDENTIFIER));
+                context.primary.set(0);
+                context.secondary.set(0);
+                final byte[] query = HexFormat.of().parseHex(row.get("query").getAsString());
+                final boolean changed = (count & 1) == 0 ? model.updateQuery(query) : model.updateQuery(NbtUtf8.decode(query));
+                final String description = test.get("installed") + "/" + test.get("current") + "/" + test.get("filtering") + "/" + row;
+                assertEquals(!row.getAsJsonArray("refreshes").isEmpty(), changed, description);
+                assertArrayEquals(HexFormat.of().parseHex(row.get("raw").getAsString()), model.query(), description);
+                assertEquals(row.get("selectionRetained").getAsBoolean(), !model.selectedOutput().isEmpty(), description);
+                final var snapshot = model.collections().collection(CreativeInventoryModel.View.SEARCH).snapshot();
+                assertEquals(row.get("count").getAsInt(), snapshot.eligibleCount(), description);
+                final var order = new ArrayList<Integer>();
+                for (final var metadata : row.getAsJsonArray("ordered")) {
+                    order.add(metadata.getAsInt());
+                }
+                assertEquals(order, snapshot.ordered().stream().map(entry -> (int) entry.item().data()).toList(), description);
+                assertEquals(row.get("primaryCalls").getAsInt(), context.primary.get(), description);
+                assertEquals(row.get("secondaryCalls").getAsInt(), context.secondary.get(), description);
+                count++;
+            }
+        }
+        assertTrue(count > 0);
+        return count;
+    }
