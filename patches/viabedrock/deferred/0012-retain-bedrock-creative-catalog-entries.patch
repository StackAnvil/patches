+        assertEquals(101, catalog.creativeEntry(catalog.entries().get(1).javaItem()).bedrockItem().identifier());
+        assertEquals(11, catalog.creativeEntry(catalog.entries().get(0).javaItem()).netId());
+        assertEquals(12, catalog.creativeEntry(catalog.entries().get(1).javaItem()).netId());
+        assertEquals(11, catalog.entries().get(0).javaItem().dataContainer().get(StructuredDataKey.CUSTOM_DATA)
+                .getInt("viabedrock:creative_entry"));
+        assertNull(catalog.creativeEntry(paper));
+        assertNull(catalog.creativeEntry(javaItem(2)));
