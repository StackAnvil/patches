+/** Retains the installed player/workbench model without granting it item-request ownership. */
+public final class NativePlayerRecipeState extends StoredObject {
+
+    private long opening;
+    private PlayerRecipeContext context;
+    private PlayerRecipeModel model;
+    private CreativeCatalog catalog;
+    private InventoryOptions preferences;
+    private Inputs inputs;
+    private NativePlayerInventoryMessage publication;
+    private JsonUiProgram publishedProgram;
+    private boolean publicationFailed;
+    private boolean presentationDirty = true;
+    private boolean actionsAdvertised;
+    private long lastRequest;
+
+    public NativePlayerRecipeState(final UserConnection user) {
+        super(user);
+    }
+
+    public void openPlayer(final long opening) {
+        if (this.opening == opening && this.model() != null) {
+            return;
+        }
+        this.begin(PlayerRecipeContext.forPlayerOpening(this.user(), this.user().get(PlayerInventoryScreenTracker.class), opening));
+        this.opening = opening;
+    }
+
+    public void containerOpened(final Container container) {
+        if (!this.user().get(PlayerInventoryScreenTracker.class).enabled()) {
+            this.clear();
+        } else if (container instanceof CraftingTableContainer) {
+            this.begin(PlayerRecipeContext.forContainer(this.user(), container));
+        } else if (!(container instanceof InventoryContainer)) {
+            this.clear();
+        }
+    }
+
+    private void begin(final PlayerRecipeContext context) {
+        this.clear();
+        context.requireCurrent();
+        this.context = context;
+        this.preferences = this.user().get(InventoryOptionsStorage.class).inventoryOptions();
+        final var items = this.user().get(ItemRewriter.class);
+        this.catalog = items.creativeCatalog();
+        // The 1.26.60 controller initializes filtering to true before profile callbacks arrive.
+        this.model = items.playerRecipeModel(context, this.preferences == null || this.preferences.filtering(), true, new byte[0]);
+    }
+
+    public void closePlayer(final long opening) {
+        if (this.opening == opening) {
+            this.clear();
+        }
+    }
+
+    /** Null means the presentation retired; it never means that an empty catalog was substituted. */
+    public PlayerRecipeModel model() {
+        if (this.context != null && !this.context.isCurrent()) {
+            this.clear();
+        }
+        return this.model;
+    }
+
+    public InventoryOptions preferences() {
+        return this.preferences;
+    }
+
+    public void tick() {
+        this.refreshCapability();
+        if (this.model() == null) {
+            return;
+        }
+        final var items = this.user().get(ItemRewriter.class);
+        final var preferences = this.user().get(InventoryOptionsStorage.class).inventoryOptions();
+        if (items.creativeCatalog() != this.catalog) {
+            this.catalog = items.creativeCatalog();
+            this.model.replaceCatalog(items);
+            this.inputs = null;
+        }
+        if (preferences != null && (this.preferences == null || preferences.filtering() != this.preferences.filtering())) {
+            this.model.reinstallPolicies(preferences.filtering());
+        }
+        this.preferences = preferences;
+        final var rules = this.user().get(GameRulesStorage.class);
+        final var player = this.user().get(EntityTracker.class).getClientPlayer();
+        final var session = this.user().get(GameSessionStorage.class);
+        final var inputs = new Inputs(this.context.sources(true), this.context.recipeTags(this.user().get(CraftingDataTracker.class)),
+                this.user().get(CraftingDataTracker.class).catalogRevision(),
+                this.user().get(EntityTracker.class).getClientPlayer().abilities().getBooleanValue(AbilitiesIndex.Instabuild),
+                rules != null && Boolean.TRUE.equals(rules.getGameRule("recipesUnlock")),
+                rules != null && Boolean.TRUE.equals(rules.getGameRule("doLimitedCrafting")), preferences,
+                player.gameType(), session == null ? null : session.getLevelGameType());
+        if (!Objects.equals(this.inputs, inputs)) {
+            this.model.collections().invalidateAll();
+            this.inputs = inputs;
+            this.presentationDirty = true;
+            this.publicationFailed = false;
+        }
+        // None advances population without inventing a native profile's selected tab.
+        final boolean changed = this.model.tick(preferences == null ? 0 : preferences.leftTab());
+        if (changed) {
+            this.presentationDirty = true;
+        }
+        this.publish();
+    }
+
+    public boolean actionsEnabled() {
+        final var channels = this.user().get(ChannelStorage.class);
+        return channels != null && channels.hasChannel(NativePlayerInventoryMessage.CHANNEL)
+                && channels.hasChannel(NativePlayerInventoryResult.CHANNEL)
+                && this.user().get(GameSessionStorage.class) != null && this.user().get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                && this.user().getProtocolInfo().getClientState() == State.PLAY;
+    }
+
+    /** Invoked on the same inventory tick after source and retained-collection updates. */
+    private void publish() {
+        if (!this.actionsEnabled() || this.publicationFailed || !this.model.collections().ready()) {
+            return;
+        }
+        final var inventory = this.user().get(InventoryTracker.class);
+        final long generation = this.context.workbench() ? inventory.currentContainerGeneration()
+                : this.user().get(PlayerInventoryScreenTracker.class).acknowledgedContainer(this.opening) == null ? 0 : inventory.currentContainerGeneration();
+        final var resources = this.user().get(ResourcePackStorage.class);
+        final var program = resources.getJsonUiProgram();
+        if (!this.presentationDirty && program == this.publishedProgram && this.publication != null && this.publication.generation() == generation) {
+            return;
+        }
+        try {
+            final var snapshot = this.snapshot();
+            final int menuId = this.context.workbench() ? Byte.toUnsignedInt(inventory.getCurrentContainer().javaContainerId()) : 0;
+            final String exported = program == this.publishedProgram && this.publication != null
+                    ? this.publication.program() : new PlayerInventoryUi(program).exportProgram(this.context.workbench()).toString();
+            final var message = new NativePlayerInventoryMessage(menuId, this.opening, generation,
+                    this.publication == null ? 1 : Math.incrementExact(this.publication.revision()), exported,
+                    GsonUtil.getGson().toJson(snapshot.state), snapshot.items);
+            this.context.requireCurrent();
+            if (this.publication == null || !message.snapshot().equals(this.publication.snapshot())
+                    || !message.items().equals(this.publication.items())
+                    || generation != this.publication.generation() || program != this.publishedProgram) {
+                final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+                packet.write(Types.STRING, NativePlayerInventoryMessage.CHANNEL);
+                packet.write(NativePlayerInventoryMessage.TYPE, message);
+                packet.send(BedrockProtocol.class);
+                this.publication = message;
+            }
+            this.publishedProgram = program;
+            this.presentationDirty = false;
+        } catch (final RuntimeException unsupported) {
+            this.publicationFailed = true;
+            ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Unable to publish authored player inventory", unsupported);
+        }
+    }
+
+    public NativePlayerInventoryMessage publication() {
+        return this.model() == null ? null : this.publication;
+    }
+
+    private void refreshCapability() {
+        final boolean available = this.actionsEnabled();
+        if (available == this.actionsAdvertised) {
+            return;
+        }
+        if (this.user().getProtocolInfo().getClientState() != State.PLAY) {
+            this.actionsAdvertised = false;
+            return;
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, available ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, NativePlayerInventoryAction.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+        this.actionsAdvertised = available;
+    }
+
+    /** Refresh before admitting a command: an older preview cannot authorize a changed source or opening. */
+    public boolean handleAction(final NativePlayerInventoryAction action) {
+        this.tick();
+        final var message = this.publication();
+        if (!this.actionsEnabled() || !action.belongsTo(message, this.lastRequest)) {
+            return false;
+        }
+        this.lastRequest = action.request();
+        if (action.kind() == NativePlayerInventoryAction.Kind.PREFERENCES) {
+            final var options = this.user().get(InventoryOptionsStorage.class);
+            options.applyInventory(action.options(), this.context.workbench());
+            final var packet = PacketWrapper.create(ServerboundBedrockPackets.SET_PLAYER_INVENTORY_OPTIONS, this.user());
+            packet.write(BedrockTypes.INVENTORY_OPTIONS, action.options());
+            packet.sendToServer(BedrockProtocol.class);
+            options.sendJavaSettings(this.user());
+            this.presentationDirty = true;
+            return true;
+        }
+        if (action.kind() == NativePlayerInventoryAction.Kind.SEARCH) {
+            this.model.updateQuery(action.query());
+            this.presentationDirty = true;
+            return true;
+        }
+        final var state = message.state();
+        if (action.cell() >= state.cells().size() || state.cells().get(action.cell()).id() != action.cell()
+                || state.cells().get(action.cell()).disabled()) {
+            return false;
+        }
+        final var view = Arrays.stream(CreativeInventoryModel.View.values()).filter(value -> value.leftTab() == state.leftTab()).findFirst().orElse(null);
+        if (view == null) {
+            return false;
+        }
+        final var collection = this.model.collections().collection(view);
+        if (action.cell() >= collection.snapshot().rows().size()) {
+            return false;
+        }
+        final var row = collection.snapshot().rows().get(action.cell());
+        if (row instanceof RecipeCollection.Header<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> header) {
+            if (action.kind() != NativePlayerInventoryAction.Kind.PRIMARY) {
+                return false;
+            }
+            final boolean changed = collection.toggleHeader(header.group()) != null;
+            this.presentationDirty |= changed;
+            return changed;
+        }
+        final var entry = row instanceof RecipeCollection.Item<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> item
+                ? item.entry() : ((RecipeCollection.Member<CreativeCatalog.CollectionEntry, CreativeCatalog.Group>) row).entry();
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        if (message.generation() == 0 || inventory.currentContainerGeneration() != message.generation()
+                || !requests.canStartRecipePlacement() || requests.isPredictingClick()) {
+            return false;
+        }
+        final var owner = inventory.getCurrentContainer();
+        if (!this.context.workbench() && this.user().get(PlayerInventoryScreenTracker.class).acknowledgedContainer(this.opening) != owner) {
+            return false;
+        }
+        if (action.kind() == NativePlayerInventoryAction.Kind.BULK) {
+            return false;
+        }
+        this.model.selectOutput(entry.item());
+        this.presentationDirty = true;
+        if (action.kind() == NativePlayerInventoryAction.Kind.SECONDARY && !state.creative()) {
+            return true;
+        }
+        if (action.kind() != NativePlayerInventoryAction.Kind.PRIMARY) {
+            return false;
+        }
+        if (state.creative()) {
+            return this.pickCreative(entry);
+        }
+        final var recipes = this.user().get(CraftingDataTracker.class);
+        for (final var candidate : NativeSort.sorted(recipes.outputCandidates(entry.item(), this.context.recipeTags(recipes)),
+                Comparator.comparingInt(data -> data.recipe().getPriority()))) {
+            final var rules = this.user().get(GameRulesStorage.class);
+            if (rules != null && Boolean.TRUE.equals(rules.getGameRule("recipesUnlock")) && !recipes.isRecipeUnlocked(candidate)) {
+                continue;
+            }
+            final boolean placed = owner instanceof InventoryContainer player ? player.handleRecipePlacement(candidate, true)
+                    : owner instanceof CraftingTableContainer table && table.handleRecipePlacement(candidate, true);
+            if (placed) {
+                PacketFactory.sendJavaContainerSetContent(this.user(), owner);
+                PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getInventoryContainer());
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Native Creative left-click requests a unit result then takes the stack to the empty cursor. */
+    private boolean pickCreative(final CreativeCatalog.CollectionEntry entry) {
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var hud = inventory.getHudContainer();
+        if (entry.catalogEntry() == null || !hud.getItem(0).isEmpty()) {
+            return false;
+        }
+        final var result = entry.catalogEntry().bedrockItem().copy();
+        final int count = Math.min(255, this.user().get(ItemRewriter.class).maxStackSize(result));
+        if (count <= 0 || !hud.canPlaceItem(0, result, count)) {
+            return false;
+        }
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        final int id = requests.nextRequestId();
+        final var request = new ItemStackRequestInfo(id, List.of(
+                new ItemStackRequestAction.CraftCreativeAction(entry.catalogEntry().netId(), 1),
+                new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(result.copy()), 1),
+                new ItemStackRequestAction.TakeAction(count,
+                        new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null), (byte) 50, id),
+                        hud.requestSlotInfo(0, 0))), List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0, hud.copy(), List.of()));
+        requests.setPredictingClick(true);
+        try {
+            result.setAmount(count);
+            hud.setItem(0, result);
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        PacketFactory.sendBedrockInventoryRequest(this.user(), new ItemStackRequestInfo[] {request});
+        PacketFactory.sendJavaContainerSetContent(this.user(), hud);
+        return true;
+    }
+
+    private Presentation snapshot() {
+        final var items = this.user().get(ItemRewriter.class);
+        final var recipes = this.user().get(CraftingDataTracker.class);
+        final var resources = this.user().get(ResourcePackStorage.class);
+        final var catalog = items.creativeCatalog();
+        final var counts = new ArrayList<Integer>();
+        for (final var view : List.of(CreativeInventoryModel.View.CONSTRUCTION, CreativeInventoryModel.View.EQUIPMENT,
+                CreativeInventoryModel.View.ITEMS, CreativeInventoryModel.View.NATURE)) {
+            this.model.refresh(view, false);
+            counts.add(this.model.collections().collection(view).snapshot().eligibleCount());
+        }
+        final int tab = this.preferences == null ? 0 : this.preferences.leftTab();
+        final var active = Arrays.stream(CreativeInventoryModel.View.values()).filter(view -> view.leftTab() == tab).findFirst().orElse(null);
+        final var cells = new ArrayList<PlayerInventoryUi.Cell>();
+        final Map<Integer, Item> previews = new HashMap<>();
+        if (active != null) {
+            this.model.refresh(active, false);
+            final var collection = this.model.collections().collection(active);
+            for (final var row : collection.snapshot().rows()) {
+                final CreativeCatalog.CollectionEntry entry = switch (row) {
+                    case RecipeCollection.Item<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> item -> item.entry();
+                    case RecipeCollection.Member<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> member -> member.entry();
+                    case RecipeCollection.Header<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> _ -> null;
+                };
+                final CreativeCatalog.Group group = switch (row) {
+                    case RecipeCollection.Header<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> header -> header.group();
+                    case RecipeCollection.Member<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> member -> member.group();
+                    default -> null;
+                };
+                final BedrockItem output = entry == null ? group.bedrockIcon() : entry.item();
+                final int state = this.model.availability(active, output);
+                final int id = cells.size();
+                final int modifier = row instanceof RecipeCollection.Header<?, ?> header ? header.expanded() ? 2 : 1 : 0;
+                final int source = entry != null && entry.catalogEntry() != null ? entry.catalogEntry().netId() : 0;
+                final boolean disabled = collection.disabled(id, new RecipeCollection.Eligibility<CreativeCatalog.CollectionEntry, CreativeCatalog.Group>() {
+                    @Override
+                    public int evaluate(final RecipeCollection.Row<CreativeCatalog.CollectionEntry, CreativeCatalog.Group> ignored) {
+                        return state;
+                    }
+
+                    @Override
+                    public boolean represents(final CreativeCatalog.CollectionEntry representative, final CreativeCatalog.Group header) {
+                        return representative.item().amount() == header.bedrockIcon().amount()
+                                && items.matchesStackQuery(representative.item(), header.bedrockIcon());
+                    }
+                });
+                final boolean needsTable = !this.context.workbench() && recipes.outputCandidates(output, this.context.recipeTags(recipes)).stream()
+                        .anyMatch(data -> data.recipe() instanceof ShapedRecipe shaped
+                                ? shaped.getWidth() >= 3 || shaped.getHeight() >= 3 : recipes.recipeIngredients(data).size() >= 5);
+                final var preview = items.javaItem(output.copy());
+                if (preview.isEmpty()) {
+                    throw new IllegalArgumentException("Unrepresentable player recipe preview");
+                }
+                previews.put(id, preview);
+                final String texture = disabled ? "textures/ui/recipe_book_red_button" : state == 1
+                        ? "textures/ui/recipe_book_light_button" : "textures/ui/recipe_book_item_bg";
+                cells.add(new PlayerInventoryUi.Cell(id, source, group == null ? -1 : catalog.groups().indexOf(group), modifier,
+                        state, this.model.outputCount(output), disabled, needsTable,
+                        group == null ? "" : resources.getTexts().translate(group.name()), Map.of(
+                            "#recipe_hover_text", new JsonPrimitive(items.itemPrimaryName(output)),
+                            "#container_item_background_texture", new JsonPrimitive(texture))));
+            }
+        }
+        final boolean creative = GameTypeRewriter.isCreativeMode(this.inputs.gameType, this.inputs.levelGameType);
+        final boolean filtering = this.preferences == null || this.preferences.filtering();
+        final String key = switch (tab) {
+            case 1 -> "craftingScreen.tab.construction";
+            case 2 -> "craftingScreen.tab.equipment";
+            case 3 -> "craftingScreen.tab.items";
+            case 4 -> "craftingScreen.tab.nature";
+            case 5 -> "craftingScreen.tab." + (creative ? filtering ? "craftableItems" : "allItems" : filtering ? "craftableRecipes" : "allRecipes");
+            case 6 -> "craftingScreen.tab.survival";
+            default -> "";
+        };
+        String label = "container.crafting";
+        final var anchor = this.context.craftingAnchor();
+        if (anchor.position() != null) {
+            final int state = this.user().get(ChunkTracker.class).getBlockState(anchor.position());
+            final var components = this.user().get(BlockStateRewriter.class).blockComponents(state);
+            if (components != null && components.get("minecraft:crafting_table") instanceof CompoundTag crafting) {
+                final String name = NativeCraftingContext.read(crafting).tableName();
+                if (!name.isEmpty()) {
+                    label = name;
+                }
+            }
+        }
+        final var state = new PlayerInventoryUi.State(this.context.workbench(), creative,
+                this.preferences == null ? 0 : this.preferences.inventoryLayout(), this.preferences == null ? 0 : this.preferences.craftingLayout(),
+                tab, this.preferences == null ? 0 : this.preferences.rightTab(), filtering, NbtUtf8.decode(this.model.query()),
+                key.isEmpty() ? "" : resources.getTexts().translate(key), resources.getTexts().translate(label), counts, cells, "", -1);
+        return new Presentation(state, previews);
+    }
+
+    private void clear() {
+        this.opening = 0;
+        this.lastRequest = 0;
+        this.context = null;
+        this.model = null;
+        this.catalog = null;
+        this.preferences = null;
+        this.inputs = null;
+        this.publication = null;
+        this.publishedProgram = null;
+        this.presentationDirty = true;
+        this.publicationFailed = false;
+    }
+
+    private record Presentation(PlayerInventoryUi.State state, Map<Integer, Item> items) { }
+
+    private record Inputs(List<NativeRecipeCounter.Source> sources, List<String> tags, long recipes,
+                          boolean instabuild, boolean unlocks, boolean limitedCrafting, InventoryOptions preferences, GameType gameType, GameType levelGameType) { }
+
+}
