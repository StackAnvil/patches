+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+
+import java.nio.charset.StandardCharsets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.InventoryOptions;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Commands bind to one displayed snapshot, independently of Java menu-zero reuse. */
+public record NativePlayerInventoryAction(int menuId, long opening, long generation, long revision, long request,
+                                         Kind kind, int target, String query, InventoryOptions options) {
+
+    public static final String CHANNEL = "viabedrock:native_player_input";
+    public static final String AUTO_DESTROY_CHANNEL = "viabedrock:native_player_auto_destroy";
+    public static final Type<NativePlayerInventoryAction> TYPE = new Type<>(NativePlayerInventoryAction.class) {
+        @Override
+        public NativePlayerInventoryAction read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 65536 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported player inventory input");
+            }
+            final int menu = Types.VAR_INT.readPrimitive(buffer);
+            final long opening = Types.VAR_LONG.readPrimitive(buffer);
+            final long generation = Types.VAR_LONG.readPrimitive(buffer);
+            final long revision = Types.VAR_LONG.readPrimitive(buffer);
+            final long request = Types.VAR_LONG.readPrimitive(buffer);
+            final int kind = buffer.readUnsignedByte();
+            if (kind >= Kind.values().length) {
+                throw new IllegalArgumentException("Unknown player inventory command");
+            }
+            final int target = Types.VAR_INT.readPrimitive(buffer);
+            final String query = Types.STRING.read(buffer);
+            final InventoryOptions options = kind == Kind.PREFERENCES.ordinal() ? BedrockTypes.INVENTORY_OPTIONS.read(buffer) : null;
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing player inventory input");
+            }
+            return new NativePlayerInventoryAction(menu, opening, generation, revision, request, Kind.values()[kind], target, query, options);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativePlayerInventoryAction value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, value.opening);
+            Types.VAR_LONG.writePrimitive(buffer, value.generation);
+            Types.VAR_LONG.writePrimitive(buffer, value.revision);
+            Types.VAR_LONG.writePrimitive(buffer, value.request);
+            buffer.writeByte(value.kind.ordinal());
+            Types.VAR_INT.writePrimitive(buffer, value.target);
+            Types.STRING.write(buffer, value.query);
+            if (value.kind == Kind.PREFERENCES) {
+                BedrockTypes.INVENTORY_OPTIONS.write(buffer, value.options);
+            }
+        }
+    };
+
+    public NativePlayerInventoryAction {
+        if (menuId < 0 || menuId > 255 || opening < 0 || generation < 0 || revision <= 0 || request <= 0
+                || kind == null || query == null || query.length() > 8192 || !StandardCharsets.UTF_8.newEncoder().canEncode(query) || target < -1
+                || (kind == Kind.PREFERENCES) != (options != null)
+                || (kind == Kind.PRIMARY || kind == Kind.SECONDARY || kind == Kind.BULK || kind == Kind.AUTO_DESTROY) != (target >= 0)
+                || kind == Kind.AUTO_DESTROY && (target < 36 || target > 44)
+                || kind != Kind.SEARCH && !query.isEmpty()) {
+            throw new IllegalArgumentException("Invalid player inventory input");
+        }
+        if (options != null && (options.leftTab() < 0 || options.leftTab() > 6 || options.rightTab() < 0 || options.rightTab() > 2
+                || options.inventoryLayout() < 0 || options.inventoryLayout() > 3 || options.craftingLayout() < 0 || options.craftingLayout() > 3)) {
+            throw new IllegalArgumentException("Invalid player inventory preferences");
+        }
+    }
+
+    public String channel() {
+        return this.kind == Kind.AUTO_DESTROY ? AUTO_DESTROY_CHANNEL : CHANNEL;
+    }
+
+    public boolean belongsTo(final NativePlayerInventoryMessage message, final long lastRequest) {
+        return message != null && this.menuId == message.menuId() && this.opening == message.opening()
+                && this.generation == message.generation() && this.revision == message.revision() && this.request > lastRequest;
+    }
+
+    public enum Kind {
+        PREFERENCES, SEARCH, PRIMARY, SECONDARY, BULK, AUTO_DESTROY
+    }
+
+}
