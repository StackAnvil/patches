+    private static Installed installed(final boolean instabuild, final boolean filtering) throws Exception {
+        final var context = context(instabuild, filtering);
+        final var user = context.items.user();
+        context.inventory.inventory().setCurrentContainerClosed(false);
+        final var screens = spy(new PlayerInventoryScreenTracker(user));
+        doReturn(true).when(screens).enabled();
+        when(user.get(PlayerInventoryScreenTracker.class)).thenReturn(screens);
+        final var options = new InventoryOptionsStorage();
+        options.applyInventory(new InventoryOptions(5, 0, filtering, 2, 2), false);
+        when(user.get(InventoryOptionsStorage.class)).thenReturn(options);
+        final var state = new NativePlayerRecipeState(user);
+        when(user.get(NativePlayerRecipeState.class)).thenReturn(state);
+        return new Installed(context, screens, state);
+    }
+
+    private static void populate(final PlayerRecipeModel model) {
+        for (int frame = 0; frame < 20 && !model.collections().ready(); frame++) {
+            model.tick(6);
+        }
+        assertTrue(model.collections().ready());
+    }
