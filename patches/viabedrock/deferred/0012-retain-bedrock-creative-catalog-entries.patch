+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionContents;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectMap;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import net.raphimc.viabedrock.api.model.NativeItemStackData;
+import net.raphimc.viabedrock.api.resourcepack.ui.RecipeCollection;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.CreativeItemCategory;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.BiPredicate;
+import java.util.function.ToIntFunction;
+
+/** The creative inventory advertised by one Bedrock server connection. */
+public final class CreativeCatalog {
+
+    private static final String ENTRY_KEY = "viabedrock:creative_entry";
+    private static final CreativeCatalog EMPTY = new CreativeCatalog(List.of(), List.of(), new ItemRegistry(new ItemEntry[0]));
+
+    private final List<Group> groups;
+    private final ItemRegistry registry;
+    private final List<Entry> entries;
+    private final List<Entry> searchEntries;
+    private final List<List<Entry>> groupEntries;
+    private final Map<CreativeItemCategory, List<Entry>> categoryEntries;
+    private final Int2ObjectMap<Entry> byEntryId = new Int2ObjectOpenHashMap<>();
+    private final Int2ObjectMap<Entry> byJavaItemId = new Int2ObjectOpenHashMap<>();
+
+    public CreativeCatalog(final List<Group> groups, final List<Entry> entries, final ItemRegistry registry) {
+        this.registry = Objects.requireNonNull(registry);
+        final List<Group> registeredGroups = new ArrayList<>(groups.size());
+        final Map<Integer, Set<String>> names = new HashMap<>();
+        for (final Group group : groups) {
+            if (group.category() < 1 || group.category() > 5) {
+                continue;
+            }
+            if (group.name().isEmpty() || names.computeIfAbsent(group.category(), ignored -> new HashSet<>()).add(group.name())) {
+                registeredGroups.add(new Group(group.category(), group.name(),
+                        group.name().isEmpty() ? BedrockItem.empty() : group.bedrockIcon().copy(),
+                        group.name().isEmpty() ? StructuredItem.empty() : group.icon().copy()));
+            }
+        }
+        this.groups = List.copyOf(registeredGroups);
+        final List<List<Entry>> members = new ArrayList<>(this.groups.size());
+        for (int index = 0; index < this.groups.size(); index++) {
+            members.add(new ArrayList<>());
+        }
+        final List<Entry> marked = new ArrayList<>(entries.size());
+        for (final Entry entry : entries) {
+            final Item javaItem = entry.javaItem().copy();
+            final CompoundTag data = javaItem.dataContainer().get(StructuredDataKey.CUSTOM_DATA);
+            final CompoundTag markedData = data != null ? data.copy() : new CompoundTag();
+            markedData.putInt(ENTRY_KEY, entry.netId());
+            javaItem.dataContainer().set(StructuredDataKey.CUSTOM_DATA, markedData);
+
+            final int groupIndex = entry.groupIndex();
+            // Wire indices address the registered group vector directly, even when earlier declarations were omitted.
+            final boolean grouped = groupIndex >= 0 && groupIndex < this.groups.size()
+                    && registry.assignCreativeCategory(entry.bedrockItem().identifier(), this.groups.get(groupIndex).category());
+            final Entry markedEntry = new Entry(entry.netId(), grouped ? groupIndex : -1, entry.bedrockItem().copy(),
+                    javaItem, entry.bedrockOnly(), entry.canonical());
+            marked.add(markedEntry);
+            if (grouped) {
+                members.get(groupIndex).add(markedEntry);
+            }
+            this.byEntryId.put(entry.netId(), markedEntry);
+            final Entry previous = this.byJavaItemId.get(javaItem.identifier());
+            if (previous == null || markedEntry.canonical()) {
+                this.byJavaItemId.put(javaItem.identifier(), markedEntry);
+            }
+        }
+        this.entries = List.copyOf(marked);
+        this.groupEntries = members.stream().map(List::copyOf).toList();
+        final Map<CreativeItemCategory, List<Entry>> categories = new EnumMap<>(CreativeItemCategory.class);
+        for (int index = 0; index < this.groups.size(); index++) {
+            categories.computeIfAbsent(CreativeItemCategory.getByValue(this.groups.get(index).category()), ignored -> new ArrayList<>())
+                    .addAll(this.groupEntries.get(index));
+        }
+        categories.replaceAll((category, values) -> List.copyOf(values));
+        this.categoryEntries = Map.copyOf(categories);
+        // Every membership update runs before search reads the final shared definition categories.
+        this.searchEntries = this.entries.stream().filter(entry -> {
+            final int category = registry.creativeCategory(entry.bedrockItem().identifier());
+            return category >= 1 && category <= 4;
+        }).toList();
+    }
+
+    public static CreativeCatalog empty() {
+        return EMPTY;
+    }
+
+    public List<Group> groups() {
+        return this.groups;
+    }
+
+    public List<Entry> entries() {
+        return this.entries;
+    }
+
+    /** Complete player search source before text, unlock and craftability evaluation. */
+    public List<Entry> searchEntries() {
+        return this.searchEntries;
+    }
+
+    public List<Entry> groupEntries(final int groupIndex) {
+        return this.groupEntries.get(groupIndex);
+    }
+
+    /** Native category group order followed by each group's member order, before availability evaluation. */
+    public List<Entry> categoryEntries(final CreativeItemCategory category) {
+        return this.categoryEntries.getOrDefault(category, List.of());
+    }
+
+    /** Bind native row population to this catalog without substituting an availability policy. */
+    public CollectionSource collectionSource(final ToIntFunction<BedrockItem> evaluation,
+                                             final BiPredicate<BedrockItem, BedrockItem> identity) {
+        return new CollectionSource(evaluation, identity);
+    }
+
+    public boolean containsJavaItem(final int identifier) {
+        return this.byJavaItemId.containsKey(identifier);
+    }
+
+    public Entry creativeEntry(final Item javaItem) {
+        final CompoundTag data = javaItem.dataContainer().get(StructuredDataKey.CUSTOM_DATA);
+        final int entryId = data != null && data.get(ENTRY_KEY) instanceof IntTag id ? id.asInt() : 0;
+        if (entryId != 0) {
+            final Entry entry = this.byEntryId.get(entryId);
+            return entry != null && entry.javaItem().identifier() == javaItem.identifier() ? entry : null;
+        }
+        final NativeItemStackData nativeStack = data == null ? null
+                : NativeItemStackData.fromTag(data.getCompoundTag(ItemDataRewriter.BEDROCK_STACK_TAG));
+        if (nativeStack != null) {
+            for (final Entry entry : this.entries) {
+                final BedrockItem item = entry.bedrockItem();
+                if (entry.javaItem().identifier() == javaItem.identifier()
+                        && nativeStack.equals(NativeItemStackData.fromItem(item))) {
+                    return entry;
+                }
+            }
+            return null;
+        }
+        Entry match = null;
+        boolean ambiguous = false;
+        for (final Entry entry : this.entries) {
+            if (entry.javaItem().identifier() != javaItem.identifier() || !sameVariants(javaItem, entry.javaItem())) {
+                continue;
+            }
+            if (match == null || entry.canonical() && !match.canonical()) {
+                match = entry;
+                ambiguous = false;
+            } else if (entry.canonical() == match.canonical()
+                    && !NativeItemStackData.fromItem(entry.bedrockItem())
+                            .equals(NativeItemStackData.fromItem(match.bedrockItem()))) {
+                ambiguous = true;
+            }
+        }
+        return ambiguous ? null : match;
+    }
+
+    private static boolean sameVariants(final Item left, final Item right) {
+        return samePotion(left.dataContainer().get(StructuredDataKey.POTION_CONTENTS1_21_2),
+                        right.dataContainer().get(StructuredDataKey.POTION_CONTENTS1_21_2))
+                && Objects.equals(left.dataContainer().get(StructuredDataKey.BLOCK_STATE),
+                        right.dataContainer().get(StructuredDataKey.BLOCK_STATE))
+                && Objects.equals(left.dataContainer().get(StructuredDataKey.INSTRUMENT26_1),
+                        right.dataContainer().get(StructuredDataKey.INSTRUMENT26_1));
+    }
+
+    private static boolean samePotion(final PotionContents left, final PotionContents right) {
+        return left == right || left != null && right != null
+                && Objects.equals(left.potion(), right.potion())
+                && Objects.equals(left.customColor(), right.customColor())
+                && Objects.equals(left.customName(), right.customName())
+                && Arrays.equals(left.customEffects(), right.customEffects());
+    }
+
+    public final class CollectionSource implements RecipeCollection.Source<CollectionEntry, Group> {
+        private final ToIntFunction<BedrockItem> evaluation;
+        private final BiPredicate<BedrockItem, BedrockItem> identity;
+
+        private CollectionSource(final ToIntFunction<BedrockItem> evaluation,
+                                 final BiPredicate<BedrockItem, BedrockItem> identity) {
+            this.evaluation = Objects.requireNonNull(evaluation);
+            this.identity = Objects.requireNonNull(identity);
+        }
+
+        /** Copy the source stack and retain the first matching catalog entry once, before evaluation. */
+        public CollectionEntry populate(final BedrockItem item) {
+            final BedrockItem snapshot = Objects.requireNonNull(item).copy();
+            for (final Entry entry : CreativeCatalog.this.entries) {
+                if (this.identity.test(entry.bedrockItem(), snapshot)) {
+                    return new CollectionEntry(snapshot, entry);
+                }
+            }
+            return new CollectionEntry(snapshot, null);
+        }
+
+        @Override
+        public int evaluate(final CollectionEntry entry) {
+            return this.evaluation.applyAsInt(entry.item());
+        }
+
+        @Override
+        public boolean valid(final CollectionEntry entry) {
+            return !entry.item().isEmpty() && CreativeCatalog.this.registry.definition(entry.item()) != null;
+        }
+
+        @Override
+        public Group group(final CollectionEntry row) {
+            final Entry entry = row.catalogEntry();
+            final int index = entry != null ? entry.groupIndex() : -1;
+            if (index < 0 || CreativeCatalog.this.groupEntries.get(index).size() < 2) {
+                return null;
+            }
+            final Group group = CreativeCatalog.this.groups.get(index);
+            // Native header admission tests the definition, not the icon quantity.
+            return CreativeCatalog.this.registry.definition(group.bedrockIcon()) != null ? group : null;
+        }
+
+        @Override
+        public boolean sameHeader(final Group first, final Group second) {
+            return first.bedrockIcon().amount() == second.bedrockIcon().amount()
+                    && this.identity.test(first.bedrockIcon(), second.bedrockIcon());
+        }
+    }
+
+    public record CollectionEntry(BedrockItem item, Entry catalogEntry) {
+    }
+
+    public record Group(int category, String name, BedrockItem bedrockIcon, Item icon) {
+    }
+
+    public record Entry(int netId, int groupIndex, BedrockItem bedrockItem, Item javaItem,
+                        boolean bedrockOnly, boolean canonical) {
+    }
+
+}
