+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.NativeItemStorageData;
+import net.raphimc.viabedrock.api.model.container.dynamic.BundleContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.TextProcessingEventOrigin;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.ItemRegistry;
+import net.raphimc.viabedrock.protocol.model.ItemStorageProperties;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestInfo;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryRequestTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** A trusted opening's physical bundle operations, separate from Java bundle item ordinals. */
+public final class NativeBundleActionSession {
+
+    private final UserConnection user;
+    private final InventoryTracker inventory;
+    private final ItemRewriter items;
+    private final ItemRegistry definitions;
+    private final Container menu;
+    private final long generation;
+    private final Container rootOwner;
+    private final int rootSlot;
+    private final BedrockItem root;
+    private final BundleContainer bundle;
+
+    private NativeBundleActionSession(final UserConnection user, final InventoryTracker inventory,
+                                      final ItemRewriter items, final Container rootOwner, final int rootSlot,
+                                      final BundleContainer bundle) {
+        this.user = user;
+        this.inventory = inventory;
+        this.items = items;
+        this.definitions = items.getItemRegistry();
+        this.menu = inventory.getCurrentContainer();
+        this.generation = inventory.currentContainerGeneration();
+        this.rootOwner = rootOwner;
+        this.rootSlot = rootSlot;
+        this.root = rootOwner.getItem(rootSlot).copy();
+        this.bundle = bundle;
+    }
+
+    /** Controller admission must resolve its source to a current server-owned slot first. */
+    public static NativeBundleActionSession create(final UserConnection user, final Container rootOwner, final int rootSlot) {
+        final var inventory = user.get(InventoryTracker.class);
+        final var items = user.get(ItemRewriter.class);
+        if (!owned(inventory, rootOwner, rootSlot)) {
+            return null;
+        }
+        final var root = rootOwner.getItem(rootSlot);
+        final var properties = items.getItemRegistry().storageProperties(root);
+        final Integer identity = NativeItemStorageData.containerIdentity(root);
+        if (root.isEmpty() || root.netId() == null || root.netId() <= 0 || identity == null
+                || !properties.storage() || properties.viewableSlots() == null) {
+            return null;
+        }
+        final var bundle = inventory.getDynamicContainer(new FullContainerName(ContainerEnumName.DynamicContainer, identity));
+        if (bundle == null || bundle == rootOwner) {
+            return null;
+        }
+        final var result = new NativeBundleActionSession(user, inventory, items, rootOwner, rootSlot, bundle);
+        return result.current() ? result : null;
+    }
+
+    public Outcome insert(final Container external, final int slot, final Integer quantity, final int revision) {
+        return this.transfer(external, slot, quantity, -1, revision, true);
+    }
+
+    public Outcome extract(final Container external, final int slot, final int selectedSlot, final int revision) {
+        return this.transfer(external, slot, null, selectedSlot, revision, false);
+    }
+
+    public Outcome extractLast(final Container external, final int slot, final int revision) {
+        return this.transfer(external, slot, null, null, revision, false);
+    }
+
+    private Outcome transfer(final Container external, final int slot, final Integer quantity,
+                             final Integer selectedSlot, final int revision, final boolean insertion) {
+        final var requests = this.user.get(InventoryRequestTracker.class);
+        if (!this.current() || revision < 0 || !requests.canStartRecipePlacement() || requests.isPredictingClick()
+                || !owned(this.inventory, external, slot) || external == this.bundle
+                || external == this.rootOwner && slot == this.rootSlot
+                || external.requestSlot(slot) > 255 || quantity != null && (quantity < 0 || quantity > 255)) {
+            return null;
+        }
+        final var policy = this.items.nativeStoragePolicy(this.root);
+        if (insertion && policy == null) {
+            return null;
+        }
+        final Map<Container, Container> before = new LinkedHashMap<>();
+        before.put(this.rootOwner, this.rootOwner.copy());
+        before.put(this.bundle, this.bundle.copy());
+        before.put(external, external.copy());
+        before.put(this.inventory.getHudContainer(), this.inventory.getHudContainer().copy());
+        final var source = new NativeBundleTransferPlan.Source() {
+            @Override
+            public ItemStorageProperties properties(final BedrockItem item) {
+                return NativeBundleActionSession.this.definitions.storageProperties(item);
+            }
+
+            @Override
+            public BedrockItem[] contents(final int identity) {
+                final var owner = NativeBundleActionSession.this.inventory.getDynamicContainer(
+                        new FullContainerName(ContainerEnumName.DynamicContainer, identity));
+                return owner == null ? null : before.computeIfAbsent(owner, Container::copy).getItems();
+            }
+
+            @Override
+            public int maximum(final BedrockItem item) {
+                return NativeBundleActionSession.this.items.maxStackSize(item);
+            }
+
+            @Override
+            public boolean canMerge(final BedrockItem first, final BedrockItem second) {
+                return NativeBundleActionSession.this.items.canMerge(first, second);
+            }
+
+            @Override
+            public boolean canTake(final NativeBundleTransferPlan.Slot from, final BedrockItem item, final int amount) {
+                // Internal slots may have been filled by an earlier planned transfer.
+                return from.bundle() ? !item.isEmpty() && amount > 0 && amount <= item.amount()
+                        : external.canTakeItem(slot, amount);
+            }
+
+            @Override
+            public boolean canPlace(final NativeBundleTransferPlan.Slot to, final BedrockItem item, final int amount) {
+                return (to.bundle() ? NativeBundleActionSession.this.bundle : external)
+                        .canPlaceItem(to.bundle() ? to.index() : slot, item, amount);
+            }
+
+            @Override
+            public boolean accepts(final BedrockItem bundle, final BedrockItem incoming) {
+                return policy.accepts(incoming, NativeBundleActionSession.this.items::recipeDescriptor);
+            }
+
+            @Override
+            public boolean allowNested(final BedrockItem bundle) {
+                return policy.allowNested();
+            }
+        };
+        final NativeBundleTransferPlan.Result plan;
+        try {
+            plan = insertion ? NativeBundleTransferPlan.insert(this.root, this.bundle.getItems(), external.getItem(slot), slot, quantity, source)
+                    : selectedSlot == null ? NativeBundleTransferPlan.extractLast(this.root, this.bundle.getItems(), external.getItem(slot), slot, source)
+                    : NativeBundleTransferPlan.extract(this.root, this.bundle.getItems(), external.getItem(slot), slot, selectedSlot, source);
+        } catch (final IllegalArgumentException unavailable) {
+            return null;
+        }
+        if (!this.current() || requests != this.user.get(InventoryRequestTracker.class)
+                || !requests.canStartRecipePlacement() || requests.isPredictingClick()
+                || before.entrySet().stream().anyMatch(entry -> !unchanged(this.inventory, entry.getKey(), entry.getValue()))) {
+            return null;
+        }
+        for (final var transfer : plan.transfers()) {
+            for (final var position : List.of(transfer.source(), transfer.destination())) {
+                final var item = this.owner(position, external).getItem(position.index());
+                if (!item.isEmpty() && (item.netId() == null || item.netId() <= 0)) {
+                    return null;
+                }
+            }
+        }
+        final var batch = new ArrayList<InventoryRequestStorage>();
+        final Map<NativeBundleTransferPlan.Slot, Integer> changed = new HashMap<>();
+        final Map<NativeBundleTransferPlan.Slot, BedrockItem> predicted = new HashMap<>();
+        requests.setPredictingClick(true);
+        try {
+            for (final var transfer : plan.transfers()) {
+                final int id = requests.nextRequestId();
+                final var from = this.owner(transfer.source(), external);
+                final var to = this.owner(transfer.destination(), external);
+                final var sourceSlot = from.requestSlotInfo(transfer.source().index(), networkId(from, transfer.source(), changed));
+                final var destinationSlot = to.requestSlotInfo(transfer.destination().index(), networkId(to, transfer.destination(), changed));
+                final ItemStackRequestAction action = switch (transfer.kind()) {
+                    case TAKE -> new ItemStackRequestAction.TakeAction(transfer.count(), sourceSlot, destinationSlot);
+                    case PLACE -> new ItemStackRequestAction.PlaceAction(transfer.count(), sourceSlot, destinationSlot);
+                    case SWAP -> new ItemStackRequestAction.SwapAction(sourceSlot, destinationSlot);
+                };
+                final var previous = new ArrayList<Container>();
+                previous.add(this.bundle.copy());
+                if (external != this.inventory.getHudContainer()) {
+                    previous.add(external.copy());
+                }
+                final var request = new InventoryRequestStorage(new ItemStackRequestInfo(id, List.of(action),
+                        List.of(), TextProcessingEventOrigin.unknown), revision, this.inventory.getHudContainer().copy(), previous);
+                final var sourceAfter = transfer.sourceAfter().copy();
+                final var destinationAfter = transfer.destinationAfter().copy();
+                sourceAfter.setNetId(id);
+                destinationAfter.setNetId(id);
+                predicted.put(transfer.source(), sourceAfter);
+                predicted.put(transfer.destination(), destinationAfter);
+                from.setItem(transfer.source().index(), sourceAfter);
+                to.setItem(transfer.destination().index(), destinationAfter);
+                changed.put(transfer.source(), id);
+                changed.put(transfer.destination(), id);
+                request.capturePrediction(this.inventory);
+                batch.add(request);
+            }
+            if (!batch.isEmpty()) {
+                requests.sendTransferBatch(batch);
+            }
+        } catch (final RuntimeException error) {
+            // The tracker restores submission failures; this also covers construction failures.
+            predicted.forEach((position, item) -> {
+                final var owner = this.owner(position, external);
+                final var snapshot = before.get(owner);
+                final boolean sameOpening = this.inventory.getCurrentContainer() == this.menu
+                        && this.inventory.currentContainerGeneration() == this.generation;
+                if (owned(this.inventory, owner, position.index()) && owner.serverRevision() == snapshot.serverRevision()
+                        && owner.getItem(position.index()).equals(item)
+                        && (owner != this.menu || owner == this.inventory.getInventoryContainer() || sameOpening)
+                        && (owner != this.inventory.getHudContainer() || position.index() == 0 || sameOpening)) {
+                    owner.setItem(position.index(), snapshot.getItem(position.index()).copy());
+                }
+            });
+            throw error;
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        return new Outcome(plan.successful(), batch.size());
+    }
+
+    private boolean current() {
+        return this.inventory == this.user.get(InventoryTracker.class) && this.items == this.user.get(ItemRewriter.class)
+                && this.definitions == this.items.getItemRegistry()
+                && this.user.get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                && this.menu != null && this.generation > 0 && this.inventory.getCurrentContainer() == this.menu
+                && this.inventory.currentContainerGeneration() == this.generation && this.inventory.getPendingCloseContainer() == null
+                && owned(this.inventory, this.rootOwner, this.rootSlot) && this.root.equals(this.rootOwner.getItem(this.rootSlot))
+                && this.inventory.getDynamicContainer(this.bundle.getFullContainerName(0)) == this.bundle;
+    }
+
+    private Container owner(final NativeBundleTransferPlan.Slot slot, final Container external) {
+        return slot.bundle() ? this.bundle : external;
+    }
+
+    private static int networkId(final Container owner, final NativeBundleTransferPlan.Slot slot,
+                                 final Map<NativeBundleTransferPlan.Slot, Integer> changed) {
+        final var item = owner.getItem(slot.index());
+        return changed.containsKey(slot) ? changed.get(slot) : item.isEmpty() ? 0 : item.netId();
+    }
+
+    private static boolean owned(final InventoryTracker inventory, final Container owner, final int slot) {
+        if (owner == null || slot < 0 || owner.itemIndex(slot) < 0 || owner.itemIndex(slot) >= owner.size()) {
+            return false;
+        }
+        try {
+            final int requestSlot = owner.requestSlot(slot);
+            final var name = owner.getFullContainerName(slot);
+            return owner.ownsBedrockSlot(name, requestSlot) && owner.slotFromRequest(requestSlot) == slot
+                    && inventory.getContainerFromName(name, requestSlot) == owner;
+        } catch (final IllegalArgumentException invalid) {
+            return false;
+        }
+    }
+
+    private static boolean unchanged(final InventoryTracker inventory, final Container owner, final Container snapshot) {
+        final boolean current = owner == inventory.getCurrentContainer() || owner == inventory.getInventoryContainer()
+                || owner == inventory.getHudContainer() || owner == inventory.getArmorContainer() || owner == inventory.getOffhandContainer()
+                || owner instanceof BundleContainer && inventory.getDynamicContainer(owner.getFullContainerName(0)) == owner;
+        return current && owner.serverRevision() == snapshot.serverRevision()
+                && Arrays.equals(owner.getItems(), snapshot.getItems());
+    }
+
+    /** A rejected insertion can still submit preparation requests. Null means the context is unavailable. */
+    public record Outcome(boolean successful, int requests) { }
+
+}
