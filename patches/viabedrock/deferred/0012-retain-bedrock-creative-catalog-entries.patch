+            throw new IllegalArgumentException("Incomplete authored player inventory scene");
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.addProperty("menu_id", menu.menuId);
+        scene.add("root", resolved.root());
+        scene.add("missing_templates", new JsonArray());
+        return scene;
+    }
+
+    /** Resolve the actual guide topics without replacing the inventory's owner or source collections. */
+    public JsonObject help(final boolean creative, final int selected) {
+        if (selected < 0) {
+            throw new IllegalArgumentException("Invalid native Help topic");
+        }
+        final String host = creative ? "encyclopedia.encyclopedia_screen" : "how_to_play.how_to_play_screen";
+        final var bindings = new HelpBindings(this.program, selected, "");
+        this.program.resolve(host, bindings);
+        if (bindings.title == null) {
+            throw new IllegalArgumentException("Missing authored Help topic");
+        }
+        final var resolved = this.program.resolve(host, new HelpBindings(this.program, selected, bindings.title));
+        if (resolved.root() == null || !resolved.missingTemplates().isEmpty()) {
+            throw new IllegalArgumentException("Incomplete authored Help scene");
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", resolved.root());
+        scene.add("missing_templates", new JsonArray());
+        return scene;
+    }
+
+    public record Cell(int id, int sourceId, int groupIndex, int modifier, int availability, int quantity,
+                       boolean disabled, boolean needsTable, String groupName, Map<String, JsonElement> presentation) {
+        public Cell {
+            if (id < 0 || groupIndex < -1 || modifier < 0 || modifier > 2 || availability < 0 || availability > 3) {
+                throw new IllegalArgumentException("Invalid player recipe cell");
+            }
+            Objects.requireNonNull(groupName);
+            presentation = ContainerUi.copy(presentation);
+        }
+    }
+
+    public record State(boolean workbench, boolean creative, int inventoryLayout, int craftingLayout, int leftTab, int rightTab, boolean filtering,
+                        String query, String tabLabel, String craftingLabel, List<Integer> categoryCounts, List<Cell> cells,
+                        String selectedCollection, int selectedIndex) {
+        public State {
+            if (inventoryLayout < 0 || inventoryLayout > 4 || craftingLayout < 0 || craftingLayout > 4 || leftTab < 0 || leftTab > 6 || rightTab < 0 || rightTab > 2
+                    || selectedIndex < -1 || categoryCounts.size() != 4 || categoryCounts.stream().anyMatch(count -> count < 0)) {
+                throw new IllegalArgumentException("Invalid player inventory state");
+            }
+            Objects.requireNonNull(query);
+            Objects.requireNonNull(tabLabel);
+            Objects.requireNonNull(craftingLabel);
+            Objects.requireNonNull(selectedCollection);
+            categoryCounts = List.copyOf(categoryCounts);
+            cells = List.copyOf(cells);
+            final Set<Integer> ids = new HashSet<>();
+            for (final Cell cell : cells) {
+                if (!ids.add(cell.id)) {
+                    throw new IllegalArgumentException("Duplicate player recipe identity");
+                }
+            }
+        }
+
+        public int effectiveLayout() {
+            final int layout = this.workbench ? this.craftingLayout : this.inventoryLayout;
+            final int selected = layout >= 1 && layout <= 3 ? layout : this.creative ? 3 : 2;
+            return this.workbench && selected == 3 ? 2 : selected;
+        }
+    }
+
+    public record MenuView(int menuId, State state, List<ContainerUi.Slot> slots, Map<String, JsonElement> cursor) {
+        public MenuView {
+            if (menuId < 0 || menuId > 255 || state == null || slots.size() != 46) {
+                throw new IllegalArgumentException("Invalid player inventory menu");
+            }
+            slots = List.copyOf(slots);
+            cursor = ContainerUi.copy(cursor);
+            final Set<Integer> ids = new HashSet<>();
+            for (final ContainerUi.Slot slot : slots) {
+                if (slot.javaSlot() < 0 || slot.javaSlot() >= 46 || !ids.add(slot.javaSlot())) {
+                    throw new IllegalArgumentException("Invalid player inventory slot");
+                }
+            }
+        }
+    }
+
+    private static final class HelpBindings implements UiBindings {
+
+        private final JsonUiProgram program;
+        private final int selected;
+        private final Map<String, JsonElement> globals;
+        private String title;
+
+        private HelpBindings(final JsonUiProgram program, final int selected, final String title) {
+            this.program = program;
+            this.selected = selected;
+            this.globals = Map.of(
+                    "#keyboard_being_used", new JsonPrimitive(true), "#gamepad_being_used", new JsonPrimitive(false),
+                    "#touch_being_used", new JsonPrimitive(false), "#help_selected_index", new JsonPrimitive(selected),
+                    "$toggle_binding_type", new JsonPrimitive("global"),
+                    "$toggle_state_binding_name", new JsonPrimitive("($toggle_group_forced_index = #help_selected_index)"),
+                    "#section_title", new JsonPrimitive(title));
+        }
+
+        @Override
+        public Map<String, JsonElement> globals() {
+            return this.globals;
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "";
+        }
+
+        @Override
+        public boolean ownsCollection(final String name) {
+            return false;
+        }
+
+        @Override
+        public Collection collection(final String name, final Scope parent) {
+            throw new IllegalArgumentException("Unsupported Help collection " + name);
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            return this.globals;
+        }
+
+        @Override
+        public Map<String, JsonElement> bindings(final Scope scope) {
+            return this.globals;
+        }
+
+        @Override
+        public String factoryKey() {
+            return "";
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            if (JsonUiProgram.string(node, "type").equals("toggle") && node.has("toggle_group_forced_index")) {
+                final int index = node.get("toggle_group_forced_index").getAsInt();
+                node.addProperty("help_topic", index);
+                if (index == this.selected && resolved.containsKey("$section_topic")) {
+                    this.title = this.program.translate("howtoplay." + resolved.get("$section_topic").getAsString() + ".title");
+                }
+            }
+            final String text = JsonUiProgram.string(node, "text");
+            if (text.startsWith("#pre_process_")) {
+                final String translated = this.program.translate(text.substring("#pre_process_".length()));
+                node.addProperty("text", translated);
+                node.add("text_component", this.program.textComponent(translated));
+                node.addProperty("localize", false);
+            }
+            if (node.has("button_mappings")) {
+                for (final var value : node.getAsJsonArray("button_mappings")) {
+                    final var mapping = value.getAsJsonObject();
+                    for (final String field : List.of("from_button_id", "to_button_id", "mapping_type")) {
+                        if (mapping.has(field)) {
+                            mapping.addProperty(field, UiExpression.text(JsonUiProgram.resolveValue(mapping.get(field), resolved, 0)));
+                        }
+                    }
+                    if (mapping.has("ignored")) {
+                        mapping.addProperty("ignored", UiExpression.truth(JsonUiProgram.resolveValue(mapping.get("ignored"), resolved, 0)));
+                    }
+                    if (JsonUiProgram.string(node, "type").equals("button") && JsonUiProgram.string(mapping, "to_button_id").equals("button.menu_exit")) {
+                        node.addProperty("help_close", true);
+                        node.addProperty("action", 0);
+                    }
+                }
+            }
+        }
+
+    }
+
+    private static final class Controller extends ContainerUi.Controller {
+        private static final Set<String> RECIPE_ACTIONS = Set.of("button.recipe_select", "button.recipe_secondary", "button.recipe_tertiary");
+        private final State state;
+        private final Map<String, UiBindings.Window> windows;
+
+        private Controller(final MenuView menu, final Map<String, UiBindings.Window> windows) {
+            super(menu.state.workbench ? 10 : 9, menu.slots, menu.cursor, new ContainerUi.Title("", false), true);
+            this.state = menu.state;
+            this.windows = windows == null ? null : Map.copyOf(windows);
+            this.globals.put("$construction_index", new JsonPrimitive(InventoryLeftTabIndex.RecipeConstruction.getValue()));
+            this.globals.put("$equipment_index", new JsonPrimitive(InventoryLeftTabIndex.RecipeEquipment.getValue()));
+            this.globals.put("$items_index", new JsonPrimitive(InventoryLeftTabIndex.RecipeItems.getValue()));
+            this.globals.put("$nature_index", new JsonPrimitive(InventoryLeftTabIndex.RecipeNature.getValue()));
+            this.globals.put("$search_index", new JsonPrimitive(InventoryLeftTabIndex.RecipeSearch.getValue()));
+            this.globals.put("$survival_layout_index", new JsonPrimitive(InventoryLayout.InventoryOnly.getValue()));
+            this.globals.put("$recipe_book_layout_index", new JsonPrimitive(InventoryLayout.Default.getValue()));
+            this.globals.put("$creative_layout_index", new JsonPrimitive(InventoryLayout.RecipeBookOnly.getValue()));
+            final Map<Integer, ContainerUi.Slot> slots = new HashMap<>();
+            menu.slots.forEach(slot -> slots.put(slot.javaSlot(), slot));
+            this.collections.put("crafting_input_items", collection(slots, 1, this.state.workbench ? 9 : 4));
+            this.registerSingleton("crafting_output_items", 0, "");
+            if (!this.state.workbench) {
+                this.collections.put("armor_items", collection(slots, 5, 4));
+                this.registerSingleton("offhand_items", 45, "#empty_offhand_image_visible");
+            }
+            final List<Map<String, JsonElement>> recipes = new ArrayList<>();
+            for (final Cell cell : this.state.cells) {
+                final Map<String, JsonElement> values = new HashMap<>(cell.presentation);
+                final JsonObject reference = new JsonObject();
+                reference.addProperty("recipe_id", cell.id);
+                values.put("#item_renderer_data", reference);
+                values.put("#recipe_craftable_count", new JsonPrimitive(InventoryStackCount.format(cell.quantity)));
+                values.put("#container_item_background", new JsonPrimitive(cell.availability));
+                values.put("#container_item_modifier", new JsonPrimitive(cell.modifier));
+                values.put("#group_item_group_name", new JsonPrimitive(cell.groupName));
+                values.put("#inactive_item", new JsonPrimitive(cell.disabled));
+                values.put("#needs_crafting_table", new JsonPrimitive(cell.needsTable));
+                values.put("#collection_index", new JsonPrimitive(recipes.size()));
+                recipes.add(values);
+            }
+            this.collections.put("recipe_book", new Collection(recipes, Map.of(
+                    "#collection_total_items", new JsonPrimitive(recipes.size()), "#recipe_book_total_items", new JsonPrimitive(recipes.size()))));
+            this.globals.put("#recipe_book_total_items", new JsonPrimitive(recipes.size()));
+            this.globals.put("#tab_label_text", new JsonPrimitive(this.state.tabLabel));
+            this.globals.put("#crafting_label_text", new JsonPrimitive(this.state.craftingLabel));
+            this.globals.put("#text_box_item_name", new JsonPrimitive(this.state.query));
+            this.globals.put("#filtering_enabled", new JsonPrimitive(this.state.filtering));
+            this.globals.put("#is_creative_mode", new JsonPrimitive(this.state.creative));
+            this.globals.put("#is_survival_layout", new JsonPrimitive(this.state.effectiveLayout() == 1));
+            this.globals.put("#is_recipe_book_layout", new JsonPrimitive(this.state.effectiveLayout() == 2));
+            this.globals.put("#is_creative_layout", new JsonPrimitive(this.state.effectiveLayout() == 3));
+            this.globals.put("#is_creative_and_recipe_book_layout", new JsonPrimitive(this.state.creative && this.state.effectiveLayout() == 2));
+            this.globals.put("#is_creative_and_creative_layout", new JsonPrimitive(this.state.creative && this.state.effectiveLayout() == 3));
+            this.globals.put("#is_creative_layout_button_visible", new JsonPrimitive(this.state.creative && !this.state.workbench));
+            final List<String> tabs = List.of("construct", "equipment", "items", "nature", "search", "inventory");
+            for (int index = 0; index < tabs.size(); index++) {
+                this.globals.put("#is_left_tab_" + tabs.get(index), new JsonPrimitive(this.state.leftTab == index + 1));
+            }
+            for (int index = 0; index < 4; index++) {
+                this.globals.put("#" + List.of("construction", "equipment", "items", "nature").get(index) + "_tab_visible",
+                        new JsonPrimitive(this.state.categoryCounts.get(index) > 0));
+            }
+            this.globals.put("#close_button_visible", new JsonPrimitive(true));
+        }
+
+        @Override
+        public Window window(final String key, final String collection, final Scope parent) {
+            return this.windows != null && collection.equals("recipe_book") ? this.windows.getOrDefault(key, new Window(0, 1)) : null;
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "inventory_items";
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            final Map<String, JsonElement> values = new HashMap<>(super.variables(scope));
+            if (scope != null) {
+                values.put("#is_recipe_selected_slot", new JsonPrimitive(this.state.selectedCollection.equals(scope.collection())
+                        && this.state.selectedIndex == scope.index()));
+                values.put("#is_creative_selected_slot", values.get("#is_recipe_selected_slot"));
+                if (scope.collection().equals("armor_items")) {
+                    values.put("#empty_armor_image_visible", new JsonPrimitive(values.get("#inventory_stack_count").getAsInt() == 0));
+                }
+            }
+            return values;
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            super.decorate(node, control, resolved, scope);
+            if (node.has("inventory_slot") && node.get("inventory_slot").getAsInt() == 0 && node.has("button_mappings")) {
+                final JsonArray outputActions = node.has("inventory_actions") ? node.getAsJsonArray("inventory_actions") : new JsonArray();
+                for (final var value : node.getAsJsonArray("button_mappings")) {
+                    final var mapping = value.getAsJsonObject();
+                    if (!UiExpression.truth(mapping.get("ignored")) && Set.of("button.crafting_output_primary",
+                            "button.crafting_output_secondary", "button.crafting_output_tertiary").contains(JsonUiProgram.string(mapping, "to_button_id"))) {
+                        outputActions.add(mapping.deepCopy());
+                    }
+                }
+                if (!outputActions.isEmpty()) {
+                    node.add("inventory_actions", outputActions);
+                }
+            }
+            if (scope == null || !scope.collection().equals("recipe_book")) {
+                return;
+            }
+            node.addProperty("recipe_id", this.state.cells.get(scope.index()).id);
+            final JsonArray actions = new JsonArray();
+            if (node.has("button_mappings")) {
+                for (final JsonElement value : node.getAsJsonArray("button_mappings")) {
+                    final JsonObject mapping = value.getAsJsonObject();
+                    if (!UiExpression.truth(mapping.get("ignored")) && RECIPE_ACTIONS.contains(JsonUiProgram.string(mapping, "to_button_id"))) {
+                        actions.add(mapping.deepCopy());
+                    }
+                }
+            }
+            if (!actions.isEmpty()) {
+                node.add("recipe_actions", actions);
+            }
+        }
+    }
+
+}
