+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.util.GsonUtil;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.resourcepack.ui.PlayerInventoryUi;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Supplier;
+import java.util.stream.Collectors;
+import java.util.zip.DataFormatException;
+import java.util.zip.Deflater;
+import java.util.zip.Inflater;
+
+/** Complete player presentations are compressed within Java's custom-payload limit. */
+public record NativePlayerInventoryMessage(int menuId, long opening, long generation, long revision,
+                                           String program, String snapshot, Map<Integer, Item> items) {
+
+    public static final String CHANNEL = "viabedrock:native_player_inventory";
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    public static final int MAX_STATE_BYTES = 8 << 20;
+    public static final Type<NativePlayerInventoryMessage> TYPE = codec(() -> VersionedTypes.V26_3.item);
+
+    static Type<NativePlayerInventoryMessage> codec(final Supplier<Type<Item>> itemType) {
+        return new Type<>(NativePlayerInventoryMessage.class) {
+            @Override
+            public NativePlayerInventoryMessage read(final ByteBuf buffer) {
+                if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                        || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                    throw new IllegalArgumentException("Unsupported player inventory message");
+                }
+                final int length = Types.VAR_INT.readPrimitive(buffer);
+                if (length <= 0 || length > MAX_STATE_BYTES) {
+                    throw new IllegalArgumentException("Invalid player inventory state length");
+                }
+                final byte[] compressed = new byte[buffer.readableBytes()];
+                buffer.readBytes(compressed);
+                final Inflater inflater = new Inflater();
+                final ByteBuf decoded = Unpooled.buffer(Math.min(length, 8192), length);
+                try {
+                    inflater.setInput(compressed);
+                    final byte[] chunk = new byte[8192];
+                    while (!inflater.finished()) {
+                        final int count = inflater.inflate(chunk);
+                        if (count == 0 && !inflater.finished() || count > length - decoded.writerIndex()) {
+                            throw new IllegalArgumentException("Invalid compressed player inventory state");
+                        }
+                        decoded.writeBytes(chunk, 0, count);
+                    }
+                    if (decoded.readableBytes() != length || inflater.getRemaining() != 0) {
+                        throw new IllegalArgumentException("Trailing or incomplete player inventory state");
+                    }
+                    final int menu = Types.VAR_INT.readPrimitive(decoded);
+                    final long opening = Types.VAR_LONG.readPrimitive(decoded);
+                    final long generation = Types.VAR_LONG.readPrimitive(decoded);
+                    final long revision = Types.VAR_LONG.readPrimitive(decoded);
+                    final String program = readString(decoded);
+                    final String state = readString(decoded);
+                    final int count = Types.VAR_INT.readPrimitive(decoded);
+                    if (count < 0 || count > 4096) {
+                        throw new IllegalArgumentException("Invalid player inventory preview count");
+                    }
+                    final Map<Integer, Item> items = new HashMap<>();
+                    for (int index = 0; index < count; index++) {
+                        final int id = Types.VAR_INT.readPrimitive(decoded);
+                        final int size = Types.VAR_INT.readPrimitive(decoded);
+                        if (id < 0 || items.containsKey(id) || size <= 0 || size > decoded.readableBytes()) {
+                            throw new IllegalArgumentException("Invalid player inventory preview boundary");
+                        }
+                        final ByteBuf itemBytes = decoded.readSlice(size);
+                        final Item item = itemType.get().read(itemBytes);
+                        if (itemBytes.isReadable()) {
+                            throw new IllegalArgumentException("Trailing player inventory preview data");
+                        }
+                        items.put(id, item);
+                    }
+                    if (decoded.isReadable()) {
+                        throw new IllegalArgumentException("Trailing player inventory state");
+                    }
+                    return new NativePlayerInventoryMessage(menu, opening, generation, revision, program, state, items);
+                } catch (final DataFormatException malformed) {
+                    throw new IllegalArgumentException("Invalid player inventory compression", malformed);
+                } finally {
+                    inflater.end();
+                    decoded.release();
+                }
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final NativePlayerInventoryMessage message) {
+                final ByteBuf state = Unpooled.buffer(8192, MAX_STATE_BYTES);
+                final ByteBuf encoded = Unpooled.buffer(8192, MAX_PAYLOAD_BYTES);
+                final Deflater deflater = new Deflater();
+                try {
+                    Types.VAR_INT.writePrimitive(state, message.menuId);
+                    Types.VAR_LONG.writePrimitive(state, message.opening);
+                    Types.VAR_LONG.writePrimitive(state, message.generation);
+                    Types.VAR_LONG.writePrimitive(state, message.revision);
+                    writeString(state, message.program);
+                    writeString(state, message.snapshot);
+                    Types.VAR_INT.writePrimitive(state, message.items.size());
+                    for (final int id : message.items.keySet().stream().sorted().toList()) {
+                        Types.VAR_INT.writePrimitive(state, id);
+                        final ByteBuf preview = Unpooled.buffer(256, MAX_STATE_BYTES);
+                        try {
+                            itemType.get().write(preview, message.items.get(id));
+                            Types.VAR_INT.writePrimitive(state, preview.readableBytes());
+                            state.writeBytes(preview);
+                        } finally {
+                            preview.release();
+                        }
+                    }
+                    Types.VAR_INT.writePrimitive(encoded, 1);
+                    Types.VAR_INT.writePrimitive(encoded, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                    Types.VAR_INT.writePrimitive(encoded, state.readableBytes());
+                    final byte[] raw = new byte[state.readableBytes()];
+                    state.readBytes(raw);
+                    deflater.setInput(raw);
+                    deflater.finish();
+                    final byte[] chunk = new byte[8192];
+                    while (!deflater.finished()) {
+                        final int count = deflater.deflate(chunk);
+                        if (count == 0) {
+                            throw new IllegalArgumentException("Unable to compress player inventory state");
+                        }
+                        encoded.writeBytes(chunk, 0, count);
+                    }
+                    buffer.writeBytes(encoded);
+                } catch (final IndexOutOfBoundsException oversized) {
+                    throw new IllegalArgumentException("Player inventory exceeds its payload limit", oversized);
+                } finally {
+                    deflater.end();
+                    encoded.release();
+                    state.release();
+                }
+            }
+        };
+    }
+
+    public NativePlayerInventoryMessage {
+        if (menuId < 0 || menuId > 255 || opening < 0 || generation < 0 || revision <= 0
+                || opening == 0 && generation == 0 || program == null || snapshot == null || items == null) {
+            throw new IllegalArgumentException("Invalid player inventory identity");
+        }
+        if ((long) program.getBytes(StandardCharsets.UTF_8).length + snapshot.getBytes(StandardCharsets.UTF_8).length > MAX_STATE_BYTES) {
+            throw new IllegalArgumentException("Player inventory state exceeds its decoded limit");
+        }
+        final var state = decode(snapshot);
+        PlayerInventoryUi.fromProgram(JsonParser.parseString(program).getAsJsonObject());
+        if (state.workbench() != JsonParser.parseString(program).getAsJsonObject().get("player_workbench").getAsBoolean()
+                || state.workbench() && (opening != 0 || generation == 0) || !state.workbench() && opening == 0) {
+            throw new IllegalArgumentException("Player inventory family differs from its opening");
+        }
+        final Set<Integer> ids = state.cells().stream().map(PlayerInventoryUi.Cell::id).collect(Collectors.toSet());
+        if (!ids.equals(items.keySet()) || items.size() > 4096) {
+            throw new IllegalArgumentException("Player inventory previews differ from its recipe cells");
+        }
+        final Map<Integer, Item> owned = new HashMap<>();
+        items.forEach((id, item) -> {
+            if (item == null || item.isEmpty() || item.amount() <= 0 || item.amount() > 255) {
+                throw new IllegalArgumentException("Invalid player inventory preview");
+            }
+            owned.put(id, item.copy());
+        });
+        items = Map.copyOf(owned);
+    }
+
+    public PlayerInventoryUi.State state() {
+        return decode(this.snapshot);
+    }
+
+    @Override
+    public Map<Integer, Item> items() {
+        final Map<Integer, Item> copy = new HashMap<>();
+        this.items.forEach((id, item) -> copy.put(id, item.copy()));
+        return Map.copyOf(copy);
+    }
+
+    private static PlayerInventoryUi.State decode(final String snapshot) {
+        final JsonObject value = JsonParser.parseString(snapshot).getAsJsonObject();
+        fields(value, Set.of("workbench", "creative", "filtering"), Set.of("inventoryLayout", "craftingLayout", "leftTab", "rightTab", "selectedIndex"),
+                Set.of("query", "tabLabel", "craftingLabel", "selectedCollection"));
+        if (!value.has("categoryCounts") || !value.get("categoryCounts").isJsonArray()
+                || !value.has("cells") || !value.get("cells").isJsonArray()) {
+            throw new IllegalArgumentException("Incomplete player inventory collections");
+        }
+        for (final var count : value.getAsJsonArray("categoryCounts")) {
+            integer(count);
+        }
+        for (final var cell : value.getAsJsonArray("cells")) {
+            final var row = cell.getAsJsonObject();
+            fields(row, Set.of("disabled", "needsTable"),
+                    Set.of("id", "sourceId", "groupIndex", "modifier", "availability", "quantity"), Set.of("groupName"));
+            if (!row.has("presentation") || !row.get("presentation").isJsonObject()) {
+                throw new IllegalArgumentException("Incomplete player inventory recipe presentation");
+            }
+        }
+        return GsonUtil.getGson().fromJson(value, PlayerInventoryUi.State.class);
+    }
+
+    private static void fields(final JsonObject value, final Set<String> booleans, final Set<String> integers, final Set<String> strings) {
+        for (final String name : booleans) {
+            if (!value.has(name) || !value.get(name).isJsonPrimitive() || !value.getAsJsonPrimitive(name).isBoolean()) {
+                throw new IllegalArgumentException("Invalid player inventory boolean: " + name);
+            }
+        }
+        for (final String name : integers) {
+            integer(value.get(name));
+        }
+        for (final String name : strings) {
+            if (!value.has(name) || !value.get(name).isJsonPrimitive() || !value.getAsJsonPrimitive(name).isString()
+                    || !StandardCharsets.UTF_8.newEncoder().canEncode(value.get(name).getAsString())) {
+                throw new IllegalArgumentException("Invalid player inventory string: " + name);
+            }
+        }
+    }
+
+    private static void integer(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("Invalid player inventory integer");
+        }
+        try {
+            value.getAsBigDecimal().intValueExact();
+        } catch (final ArithmeticException invalid) {
+            throw new IllegalArgumentException("Invalid player inventory integer", invalid);
+        }
+    }
+
+    private static String readString(final ByteBuf buffer) {
+        final int length = Types.VAR_INT.readPrimitive(buffer);
+        if (length < 0 || length > buffer.readableBytes()) {
+            throw new IllegalArgumentException("Invalid player inventory text length");
+        }
+        try {
+            final String value = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT).decode(buffer.nioBuffer(buffer.readerIndex(), length)).toString();
+            buffer.skipBytes(length);
+            return value;
+        } catch (final CharacterCodingException invalid) {
+            throw new IllegalArgumentException("Invalid player inventory UTF-8", invalid);
+        }
+    }
+
+    private static void writeString(final ByteBuf buffer, final String value) {
+        if (!StandardCharsets.UTF_8.newEncoder().canEncode(value)) {
+            throw new IllegalArgumentException("Invalid player inventory Unicode");
+        }
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        Types.VAR_INT.writePrimitive(buffer, bytes.length);
+        buffer.writeBytes(bytes);
+    }
+
+}
