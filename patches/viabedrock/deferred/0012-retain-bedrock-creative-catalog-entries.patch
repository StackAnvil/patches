+    static List<ItemStackRequestAction> creativeSlotActions(final Container container,
+            final int slot, final BedrockItem previous, final BedrockItem creativeItem,
+            final int creativeId, final int requestId) {
+        final List<ItemStackRequestAction> actions = new ArrayList<>();
+        if (!creativeItem.isEmpty()) {
+            actions.add(new ItemStackRequestAction.CraftCreativeAction(creativeId, 1));
+            actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(creativeItem.copy()), 1));
+        }
+        if (!previous.isEmpty()) {
+            actions.add(new ItemStackRequestAction.DestroyAction(previous.amount(),
+                    container.requestSlotInfo(slot, previous.netId())));
+        }
+        if (!creativeItem.isEmpty()) {
+            actions.add(new ItemStackRequestAction.PlaceAction(creativeItem.amount(),
+                    new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                            (byte) 50, requestId),
+                    container.requestSlotInfo(slot, 0)));
+        }
+        return actions;
