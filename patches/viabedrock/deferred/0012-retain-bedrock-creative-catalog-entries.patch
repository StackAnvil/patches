+
+class NativeStoragePolicyTest {
+
+    @Test
+    void storageFiltersUseDescriptorAuxiliaryValuesAndBannedMatchesOverrideAllowedMatches() {
+        final var items = registry();
+        final var context = new NativeRecipeRegistry(items, mock(BlockStateRewriter.class));
+        final var policy = NativeStoragePolicy.bind(new ItemStoragePolicy(64, true,
+                List.of(Map.of("name", "test:accepted", "item_tag", "test:other")),
+                List.of(Map.of("name", "test:accepted:3"))), context, null);
+        assertNotNull(policy);
+        final var accepted = new BedrockItem(items.definition("test:accepted"), (short) 4, (byte) 1);
+        final var tag = new CompoundTag();
+        tag.put("ench", new ListTag<>(CompoundTag.class));
+        accepted.setTag(tag);
+        assertTrue(policy.accepts(accepted, item -> items.recipeDescriptor(item, null)));
+        accepted.setData((short) 3);
+        assertFalse(policy.accepts(accepted, item -> items.recipeDescriptor(item, null)));
+        assertFalse(policy.accepts(new BedrockItem(30032), item -> items.recipeDescriptor(item, null)));
+    }
+
+    @Test
+    void expressionPrecedenceRequiresKnownVersionAndUnsupportedPredicatesCannotBecomeUnrestrictedFilters() {
+        final var items = registry();
+        final var context = new NativeRecipeRegistry(items, mock(BlockStateRewriter.class));
+        final var raw = new ItemStoragePolicy(64, true,
+                List.of(Map.of("tags", "q.any_tag('test:allowed')", "name", "test:other")), List.of());
+        assertNull(NativeStoragePolicy.bind(raw, context, null));
+        assertNull(NativeStoragePolicy.bind(raw, context, 37));
+        final var bound = NativeStoragePolicy.bind(raw, context, 65535);
+        assertNotNull(bound);
+        assertTrue(bound.accepts(new BedrockItem(30031), item -> items.recipeDescriptor(item, null)));
+        assertFalse(bound.accepts(new BedrockItem(30032), item -> items.recipeDescriptor(item, null)));
+        assertNull(NativeStoragePolicy.bind(new ItemStoragePolicy(64, true, List.of(),
+                List.of(Map.of("tags", "q.unverified_storage_query()", "name", "test:accepted"))), context, 65535));
+        final var byTag = NativeStoragePolicy.bind(new ItemStoragePolicy(64, true,
+                List.of(Map.of("item_tag", "test:allowed")), List.of()), context, null);
+        assertNotNull(byTag);
+        assertTrue(byTag.accepts(new BedrockItem(30031), item -> items.recipeDescriptor(item, null)));
+        assertFalse(byTag.accepts(new BedrockItem(30032), item -> items.recipeDescriptor(item, null)));
+    }
+
+    @Test
+    void retainedDefinitionBindingsDoNotShareLazyNameResolutionAfterNumericCollision() {
+        final var policy = new CompoundTag();
+        policy.putInt("max_slots", 64);
+        policy.putByte("allow_nested_storage_items", (byte) 1);
+        final var name = new CompoundTag();
+        name.putString("name", "test:dynamic");
+        final var allowed = new ListTag<>(CompoundTag.class);
+        allowed.add(name);
+        policy.put("allowed_items", allowed);
+        policy.put("banned_items", new ListTag<>(CompoundTag.class));
+        final var components = new CompoundTag();
+        components.put("minecraft:storage_item", policy);
+        final var items = new ItemRegistry(new ItemEntry[]{entry("test:accepted", 30031, new CompoundTag()),
+                entry("test:other", 30032, new CompoundTag()), entry("test:first", 30033, components), entry("test:second", 30033, components)});
+        final var context = spy(new NativeRecipeRegistry(items, mock(BlockStateRewriter.class)));
+        final var target = new AtomicReference<>(new NativeRecipeDescriptor.Lookup(items.definition("test:accepted"), 0));
+        doAnswer(ignored -> target.get()).when(context).lookupItem("test:dynamic", Short.MAX_VALUE);
+        final var retained = new BedrockItem(items.definition("test:first"), (short) 0, (byte) 1);
+        final var first = items.storagePolicy(retained, context, null);
+        assertNotNull(first);
+        assertTrue(first.accepts(new BedrockItem(30031), item -> items.recipeDescriptor(item, null)));
+        target.set(new NativeRecipeDescriptor.Lookup(items.definition("test:other"), 0));
+        assertSame(first, items.storagePolicy(retained, context, null));
+        assertSame(first, items.storagePolicy(retained, context, 65535));
+        assertTrue(first.accepts(new BedrockItem(30031), item -> items.recipeDescriptor(item, null)));
+        final var second = items.storagePolicy(new BedrockItem(30033), context, null);
+        assertNotNull(second);
+        assertNotSame(first, second);
+        assertFalse(second.accepts(new BedrockItem(30031), item -> items.recipeDescriptor(item, null)));
+        assertTrue(second.accepts(new BedrockItem(30032), item -> items.recipeDescriptor(item, null)));
+        verify(context, times(2)).lookupItem("test:dynamic", Short.MAX_VALUE);
+    }
+
+    private static ItemRegistry registry() {
+        final var tagged = new CompoundTag();
+        final var tags = new ListTag<>(StringTag.class);
+        tags.add(new StringTag("test:allowed"));
+        tagged.put("item_tags", tags);
+        return new ItemRegistry(new ItemEntry[]{entry("test:accepted", 30031, tagged), entry("test:other", 30032, new CompoundTag())});
+    }
+
+    private static ItemEntry entry(final String name, final int id, final CompoundTag components) {
+        final var data = new CompoundTag();
+        data.put("components", components);
+        return new ItemEntry(name, id, true, ItemVersion.DataDriven, data);
+    }
+
+}
