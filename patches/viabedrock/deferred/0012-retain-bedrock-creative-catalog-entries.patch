+    /** The catalog-only toolbar discards its selected stack without touching the held item. */
+    private boolean destroyCreativeHotbar(final int slot) {
+        final var tracker = this.user().get(InventoryTracker.class);
+        final var inventory = tracker.getInventoryContainer();
+        final var previous = inventory.getItem(slot);
+        if (previous.isEmpty()) {
+            return true;
+        }
+        if (previous.netId() == null || !inventory.canDiscardItem(slot, previous.amount())) {
+            return false;
+        }
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        final int id = requests.nextRequestId();
+        final var action = new ItemStackRequestAction.DestroyAction(previous.amount(), inventory.requestSlotInfo(slot, previous.netId()));
+        final var request = new ItemStackRequestInfo(id, List.of(action), List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0, tracker.getHudContainer().copy(), List.of(inventory.copy())));
+        requests.setPredictingClick(true);
+        try {
+            inventory.setItem(slot, BedrockItem.empty());
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        PacketFactory.sendBedrockInventoryRequest(this.user(), new ItemStackRequestInfo[] {request});
+        PacketFactory.sendJavaContainerSetContent(this.user(), inventory);
+        return true;
+    }
+
+    /** Primary takes/discards a stack; secondary takes/discards one item. */
+    private boolean pickCreative(final CreativeCatalog.CollectionEntry entry, final boolean secondary) {
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var hud = inventory.getHudContainer();
+        if (entry.catalogEntry() == null) {
+            return false;
+        }
+        final var previous = hud.getItem(0);
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        final int id;
+        final BedrockItem cursor;
+        final List<ItemStackRequestAction> actions;
+        if (!previous.isEmpty()) {
+            final int count = secondary ? 1 : previous.amount();
+            if (previous.netId() == null || !hud.canDiscardItem(0, count)) {
+                return false;
+            }
+            id = requests.nextRequestId();
+            cursor = previous.amount() == count ? BedrockItem.empty() : previous.copy();
+            if (!cursor.isEmpty()) {
+                cursor.setAmount(previous.amount() - count);
+            }
+            actions = List.of(new ItemStackRequestAction.DestroyAction(count,
+                    hud.requestSlotInfo(0, previous.netId())));
+        } else {
+            final var result = entry.catalogEntry().bedrockItem().copy();
+            final int count = Math.min(secondary ? 1 : 255, this.user().get(ItemRewriter.class).maxStackSize(result));
+            if (count <= 0) {
+                return false;
+            }
+            cursor = result.copy();
+            cursor.setAmount(count);
+            if (!hud.canPlaceItem(0, cursor, count)) {
+                return false;
+            }
+            id = requests.nextRequestId();
+            actions = List.of(
+                    new ItemStackRequestAction.CraftCreativeAction(entry.catalogEntry().netId(), 1),
+                    new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(result.copy()), 1),
+                    new ItemStackRequestAction.TakeAction(count,
+                            new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null), (byte) 50, id),
+                            hud.requestSlotInfo(0, 0)));
+        }
+        final var request = new ItemStackRequestInfo(id, actions, List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0, hud.copy(), List.of()));
+        requests.setPredictingClick(true);
+        try {
+            hud.setItem(0, cursor);
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        PacketFactory.sendBedrockInventoryRequest(this.user(), new ItemStackRequestInfo[] {request});
+        PacketFactory.sendJavaContainerSetContent(this.user(), hud);
+        return true;
+    }
+
+    /** Native Creative auto-place preserves the cursor and fills existing stacks before empty slots. */
+    private boolean placeCreative(final CreativeCatalog.CollectionEntry entry) {
+        if (entry.catalogEntry() == null) {
+            return false;
+        }
+        final var tracker = this.user().get(InventoryTracker.class);
+        final var inventory = tracker.getInventoryContainer();
+        final var items = this.user().get(ItemRewriter.class);
+        final var result = entry.catalogEntry().bedrockItem().copy();
+        final int maximum = Math.min(255, items.maxStackSize(result));
+        if (maximum <= 0) {
+            return false;
+        }
+        final var stack = result.copy();
+        stack.setAmount(maximum);
+        final var placements = new ArrayList<CreativePlacement>();
+        int remaining = maximum;
+        for (final boolean merge : new boolean[] {true, false}) {
+            for (int slot = 0; slot < inventory.size() && remaining > 0; slot++) {
+                final var previous = inventory.getItem(slot);
+                if (merge ? previous.isEmpty() || previous.netId() == null || !items.canMerge(stack, previous)
+                        : !previous.isEmpty()) {
+                    continue;
+                }
+                final int count = Math.min(remaining, maximum - previous.amount());
+                if (count <= 0 || !inventory.canPlaceItem(slot, stack, count)) {
+                    continue;
+                }
+                final var next = previous.isEmpty() ? result.copy() : previous.copy();
+                next.setAmount(previous.amount() + count);
+                placements.add(new CreativePlacement(slot, count, previous.isEmpty() ? 0 : previous.netId(), next));
+                remaining -= count;
+            }
+        }
+        if (placements.isEmpty()) {
+            return true;
+        }
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        final int id = requests.nextRequestId();
+        final var output = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null), (byte) 50, id);
+        final var actions = new ArrayList<ItemStackRequestAction>();
+        actions.add(new ItemStackRequestAction.CraftCreativeAction(entry.catalogEntry().netId(), 1));
+        actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(List.of(result.copy()), 1));
+        for (final var placement : placements) {
+            actions.add(new ItemStackRequestAction.PlaceAction(placement.count(), output,
+                    inventory.requestSlotInfo(placement.slot(), placement.networkId())));
+        }
+        final var request = new ItemStackRequestInfo(id, actions, List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0, tracker.getHudContainer().copy(), List.of(inventory.copy())));
+        requests.setPredictingClick(true);
+        try {
+            for (final var placement : placements) {
+                inventory.setItem(placement.slot(), placement.next());
+            }
+        } finally {
+            requests.setPredictingClick(false);
+        }
+        PacketFactory.sendBedrockInventoryRequest(this.user(), new ItemStackRequestInfo[] {request});
+        PacketFactory.sendJavaContainerSetContent(this.user(), inventory);
+        return true;
+    }
