+
+class NativePlayerInventoryMessageTest {
+
+    private static NativePlayerInventoryMessage message() {
+        final var state = new PlayerInventoryUi.State(false, false, 2, 0, 5, 2, true, "oak", "Recipes", "Crafting",
+                List.of(1, 0, 0, 0), List.of(), "", -1);
+        final var ui = new PlayerInventoryUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        return new NativePlayerInventoryMessage(0, 1L << 40, 0, 1L << 48, ui.exportProgram(false).toString(),
+                GsonUtil.getGson().toJson(state), Map.of());
+    }
+
+    @Test
+    void compressedSnapshotsRetainPendingOpeningAndRejectTrailingOrTruncatedFrames() {
+        final var value = message();
+        final var wire = Unpooled.buffer();
+        try {
+            NativePlayerInventoryMessage.TYPE.write(wire, value);
+            final byte[] encoded = new byte[wire.readableBytes()];
+            wire.getBytes(0, encoded);
+            final var decoded = NativePlayerInventoryMessage.TYPE.read(wire);
+            assertEquals(value, decoded);
+            assertFalse(wire.isReadable());
+            assertTrue(encoded.length < value.program().length() / 2);
+            for (final int size : new int[]{1, encoded.length / 2, encoded.length - 1}) {
+                final var truncated = Unpooled.wrappedBuffer(encoded, 0, size);
+                try {
+                    assertThrows(RuntimeException.class, () -> NativePlayerInventoryMessage.TYPE.read(truncated));
+                } finally {
+                    truncated.release();
+                }
+            }
+            final var trailing = Unpooled.buffer();
+            try {
+                trailing.writeBytes(encoded).writeByte(0);
+                assertThrows(IllegalArgumentException.class, () -> NativePlayerInventoryMessage.TYPE.read(trailing));
+            } finally {
+                trailing.release();
+            }
+            final var oversized = Unpooled.buffer();
+            try {
+                Types.VAR_INT.writePrimitive(oversized, 1);
+                Types.VAR_INT.writePrimitive(oversized, 2225);
+                Types.VAR_INT.writePrimitive(oversized, NativePlayerInventoryMessage.MAX_STATE_BYTES + 1);
+                assertThrows(IllegalArgumentException.class, () -> NativePlayerInventoryMessage.TYPE.read(oversized));
+            } finally {
+                oversized.release();
+            }
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void compressedPreviewsRetainComponentDataWithoutSharingMutableStacks() throws ClassNotFoundException {
+        Class.forName(StructuredDataKey.class.getName());
+        final var serializers = mock(FullMappings.class);
+        when(serializers.mappedSize()).thenReturn(1);
+        when(serializers.mappedId(anyString())).thenReturn(0);
+        final var mappings = mock(MappingData.class);
+        when(mappings.getDataComponentSerializerMappings()).thenReturn(serializers);
+        final var protocol = mock(Protocol.class);
+        when(protocol.getMappingData()).thenReturn(mappings);
+        final var components = new StructuredDataType();
+        components.filler(protocol).add(StructuredDataKey.CUSTOM_DATA);
+        final var codec = NativePlayerInventoryMessage.codec(() -> new ItemType1_20_5(components));
+        final var tag = new CompoundTag();
+        tag.putInt("variant", 17);
+        final var stack = new StructuredItem(320, 255, new StructuredDataContainer(new StructuredData<?>[]{
+                StructuredData.of(StructuredDataKey.CUSTOM_DATA, tag, 0)}));
+        final var source = message();
+        final var previous = source.state();
+        final var state = new PlayerInventoryUi.State(false, false, 2, 0, 5, 2, true, "oak", "Recipes", "Crafting",
+                previous.categoryCounts(), List.of(new PlayerInventoryUi.Cell(0, -1, -1, 0, 1, 44, false, false, "", Map.of())), "", -1);
+        final var message = new NativePlayerInventoryMessage(0, source.opening(), 0, 1, source.program(), GsonUtil.getGson().toJson(state), Map.of(0, stack));
+        tag.putInt("variant", 29);
+        message.items().get(0).setAmount(1);
+        final var wire = Unpooled.buffer();
+        try {
+            codec.write(wire, message);
+            final var decoded = codec.read(wire);
+            assertEquals(255, decoded.items().get(0).amount());
+            assertEquals(17, decoded.items().get(0).dataContainer().get(StructuredDataKey.CUSTOM_DATA).getInt("variant"));
+            assertFalse(wire.isReadable());
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void commandsCannotCrossMenuZeroOpeningsAcknowledgementsOrSnapshotRevisions() {
+        final var message = message();
+        final var action = new NativePlayerInventoryAction(0, message.opening(), 0, message.revision(), 1,
+                NativePlayerInventoryAction.Kind.SEARCH, -1, "birch", null);
+        assertTrue(action.belongsTo(message, 0));
+        assertFalse(action.belongsTo(message, 1));
+        for (final var replacement : List.of(
+                new NativePlayerInventoryMessage(0, message.opening() + 1, 0, message.revision(), message.program(), message.snapshot(), Map.of()),
+                new NativePlayerInventoryMessage(0, message.opening(), 1, message.revision(), message.program(), message.snapshot(), Map.of()),
+                new NativePlayerInventoryMessage(0, message.opening(), 0, message.revision() + 1, message.program(), message.snapshot(), Map.of()))) {
+            assertFalse(action.belongsTo(replacement, 0));
+        }
+        final var wire = Unpooled.buffer();
+        try {
+            NativePlayerInventoryAction.TYPE.write(wire, action);
+            assertEquals(action, NativePlayerInventoryAction.TYPE.read(wire));
+            assertFalse(wire.isReadable());
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void coercedStateAndCrossFamilyOpeningsCannotBecomePresentations() {
+        final var value = message();
+        for (final String name : List.of("creative", "leftTab", "query")) {
+            final var state = JsonParser.parseString(value.snapshot()).getAsJsonObject();
+            state.addProperty(name, name.equals("leftTab") ? "5" : "true");
+            if (name.equals("query")) {
+                state.addProperty(name, 1);
+            }
+            assertThrows(IllegalArgumentException.class, () -> new NativePlayerInventoryMessage(0, value.opening(), 0, 1,
+                    value.program(), state.toString(), Map.of()));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new NativePlayerInventoryMessage(0, 0, 1, 1,
+                value.program(), value.snapshot(), Map.of()));
+        assertThrows(IllegalArgumentException.class, () -> new NativePlayerInventoryMessage(0, 1, 1, 1,
+                value.program(), value.snapshot(), Map.of(0, StructuredItem.empty())));
+    }
+
+}
