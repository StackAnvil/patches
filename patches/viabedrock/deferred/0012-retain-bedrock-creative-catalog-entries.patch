+    private boolean canRequest(final NativePlayerInventoryMessage message) {
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var requests = this.user().get(InventoryRequestTracker.class);
+        return message.generation() != 0 && inventory.currentContainerGeneration() == message.generation()
+                && requests.canStartRecipePlacement() && !requests.isPredictingClick()
+                && (this.context.workbench() || this.user().get(PlayerInventoryScreenTracker.class).acknowledgedContainer(this.opening) == inventory.getCurrentContainer());
+    }
+
+    private boolean placeSurvival(final CreativeCatalog.CollectionEntry entry) {
+        final var inventory = this.user().get(InventoryTracker.class);
+        final var owner = inventory.getCurrentContainer();
+        final var recipes = this.user().get(CraftingDataTracker.class);
+        final var items = this.user().get(ItemRewriter.class);
+        for (final var data : NativeSort.sorted(recipes.outputCandidates(entry.item(), this.context.recipeTags(recipes)),
+                Comparator.comparingInt(candidate -> candidate.recipe().getPriority()))) {
+            final var rules = this.user().get(GameRulesStorage.class);
+            if (rules != null && Boolean.TRUE.equals(rules.getGameRule("recipesUnlock")) && !recipes.isRecipeUnlocked(data)) {
+                continue;
+            }
+            final var candidate = recipes.playerRecipeCandidate(data);
+            if (candidate.requiresCraftingTable() && !this.context.workbench()) {
+                continue;
+            }
+            final List<BedrockItem> results = switch (data.recipe()) {
+                case ShapedRecipe shaped -> shaped.getResults();
+                case ShapelessRecipe shapeless -> shapeless.getResults();
+                default -> List.of();
+            };
+            if (results.isEmpty()) {
+                continue;
+            }
+            final var plan = NativeRecipeCrafting.plan(data.networkId(), candidate.recipe(), this.context.sources(false),
+                    owner, inventory, results, items, (index, source) -> recipes.craftDescriptor(data, index, source));
+            if (plan == null) {
+                continue;
+            }
+            final var requests = this.user().get(InventoryRequestTracker.class);
+            final int id = requests.nextRequestId();
+            final var request = new ItemStackRequestInfo(id, plan.actions(id), List.of(), TextProcessingEventOrigin.unknown);
+            final var player = inventory.getInventoryContainer();
+            requests.addRequest(new InventoryRequestStorage(request, 0, inventory.getHudContainer().copy(),
+                    owner == player ? List.of(player.copy()) : List.of(owner.copy(), player.copy())));
+            requests.setPredictingClick(true);
+            try {
+                plan.apply();
+                if (owner instanceof CraftingTableContainer table) {
+                    table.refreshOutput();
+                } else if (owner instanceof InventoryContainer playerOwner) {
+                    playerOwner.refreshCraftingOutput();
+                }
+            } finally {
+                requests.setPredictingClick(false);
+            }
+            PacketFactory.sendBedrockInventoryRequest(this.user(), new ItemStackRequestInfo[] {request});
+            PacketFactory.sendJavaContainerSetContent(this.user(), inventory.getHudContainer());
+            PacketFactory.sendJavaContainerSetContent(this.user(), player);
+            PacketFactory.sendJavaContainerSetContent(this.user(), owner);
+            return true;
+        }
+        return false;
+    }
