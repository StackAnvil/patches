+        final var ui = new PlayerInventoryUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        final var slots = IntStream.range(0, 46).mapToObj(id -> new ContainerUi.Slot(id, Map.<String, JsonElement>of(
+                "#inventory_stack_count", new JsonPrimitive(0)))).toList();
+        for (final boolean table : new boolean[]{false, true}) {
+            final var state = new PlayerInventoryUi.State(table, false, 2, 2, 5, 2, true, "oak", "Recipes", "Crafting",
+                    List.of(1, 0, 0, 0), List.of(new PlayerInventoryUi.Cell(0, -1, -1, 0, 1, 44, false, false, "", Map.of())), "recipe_book", 0);
+            final var view = new PlayerInventoryUi.MenuView(table ? 7 : 0, state, slots, Map.of());
+            final var scene = ui.resolve(view);
+            final var replayed = PlayerInventoryUi.fromProgram(ui.exportProgram(table)).resolve(view);
+            assertEquals(scene, replayed);
+            final Set<Integer> inventory = new HashSet<>();
+            final Set<Integer> recipes = new HashSet<>();
+            for (final var node : nodes(scene.getAsJsonObject("root"))) {
+                if (node.has("inventory_slot")) {
+                    inventory.add(node.get("inventory_slot").getAsInt());
+                }
+                if (node.has("recipe_id")) {
+                    recipes.add(node.get("recipe_id").getAsInt());
+                }
+            }
+            assertTrue(inventory.containsAll(IntStream.range(table ? 10 : 9, table ? 46 : 45).boxed().toList()), inventory.toString());
