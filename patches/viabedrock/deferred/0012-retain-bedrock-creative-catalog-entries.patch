+    public static boolean handleCreativeSlot(final UserConnection user, final int javaSlot, final Item javaItem) {
+        final InventoryTracker tracker = user.get(InventoryTracker.class);
+        final InventoryContainer inventory = tracker.getInventoryContainer();
+        final boolean dropping = javaSlot == -1;
+        if ((!dropping && (javaSlot < 5 || javaSlot > 45)) || dropping && javaItem.isEmpty()
+                || tracker.getPendingCloseContainer() != null
+                || user.get(EntityTracker.class).getClientPlayer().javaGameMode() != GameMode.CREATIVE) {
+            return false;
+        }
+        final Container target = dropping ? inventory : javaSlot < 9 ? tracker.getArmorContainer()
+                : javaSlot == 45 ? tracker.getOffhandContainer() : inventory;
+        final int slot = dropping ? -1 : target.bedrockSlot(javaSlot);
+        final CreativeCatalog.Entry entry = javaItem.isEmpty() ? null
+                : user.get(ItemRewriter.class).creativeCatalog().creativeEntry(javaItem);
+        if (!javaItem.isEmpty() && (entry == null || javaItem.amount() < 1 || javaItem.amount() > Math.min(255,
+                user.get(ItemRewriter.class).maxStackSize(entry.bedrockItem())))) {
+            return false;
         }
+        if (tracker.getCurrentContainer() == null) {
+            final InventoryRequestTracker requests = user.get(InventoryRequestTracker.class);
+            if (!requests.queueCreativeSlot(inventory, javaSlot, javaItem)) {
+                return false;
+            }
+            if (requests.beginInventoryOpen()) {
+                requests.openPlayerInventoryTemporarily();
+                final PacketWrapper interact = PacketWrapper.create(ServerboundBedrockPackets.INTERACT, user);
+                ClientPlayerPackets.writeOpenInventoryInteraction(interact,
+                        user.get(EntityTracker.class).getClientPlayer().runtimeId());
+                interact.sendToServer(BedrockProtocol.class);
+            }
+            return true;
+        }
+        if (!(tracker.getCurrentContainer() instanceof InventoryContainer)) {
+            return false;
+        }
+        final BedrockItem creativeItem = javaItem.isEmpty() ? BedrockItem.empty() : entry.bedrockItem().copy();
         if (!creativeItem.isEmpty()) {
-            actions.add(new InventoryActionData(
-                    creativeSource, 1, creativeItem, BedrockItem.empty()));
+            creativeItem.setAmount(javaItem.amount());
         }
-        actions.add(new InventoryActionData(
-                new InventorySource(
-                        InventorySourceType.Container_Inventory,
-                        containerId,
-                        InventorySourceFlags.No_Flag),
-                slot, previousItem, creativeItem));
-        return new BedrockInventoryTransaction(
-                0, null, actions,
-                ComplexInventoryTransaction_Type.NormalTransaction,
-                new InventoryTransactionData.NormalTransactionData());
+        final BedrockItem previous = dropping ? BedrockItem.empty() : target.getItem(slot);
+        if (creativeItem.isEmpty() && previous.isEmpty()) {
+            return true;
+        }
+        if (!previous.isEmpty() && previous.netId() == null) {
+            return false;
+        }
+        final InventoryRequestTracker requests = user.get(InventoryRequestTracker.class);
+        final int requestId = requests.nextRequestId();
+        final ItemStackRequestInfo request = new ItemStackRequestInfo(requestId,
+                creativeSlotActions(target, slot, previous,
+                        creativeItem, entry == null ? 0 : entry.netId(), requestId),
+                List.of(), TextProcessingEventOrigin.unknown);
+        requests.addRequest(new InventoryRequestStorage(request, 0,
+                tracker.getHudContainer().copy(), List.of(target.copy())));
+        if (!dropping) {
+            requests.setPredictingClick(true);
+            try {
+                target.setItem(slot, creativeItem.copy());
+            } finally {
+                requests.setPredictingClick(false);
+            }
+        }
+        PacketFactory.sendBedrockInventoryRequest(user, new ItemStackRequestInfo[] {request});
+        PacketFactory.sendJavaContainerSetContent(user, inventory);
+        return true;
+    }
