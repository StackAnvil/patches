+package net.raphimc.viabedrock.api.model.container;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiFunction;
+import net.raphimc.viabedrock.api.model.container.block.CraftingTableContainer;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestAction;
+import net.raphimc.viabedrock.protocol.model.inventory.ItemStackRequestSlotInfo;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemDescriptor;
+import net.raphimc.viabedrock.protocol.model.recipe.ItemRecipeDescriptor;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+/** Plans one native catalog auto-craft without mutating its authoritative sources. */
+public final class NativeRecipeCrafting {
+
+    private NativeRecipeCrafting() { }
+
+    public static Plan plan(final int recipeId, final NativeRecipeCounter.Recipe recipe,
+                            final List<NativeRecipeCounter.Source> sources, final Container owner,
+                            final InventoryTracker inventory, final List<BedrockItem> results, final ItemRewriter items,
+                            final BiFunction<Integer, ItemRecipeDescriptor, ItemRecipeDescriptor> craftDescriptor) {
+        if (recipeId == 0 || recipe.ingredientCount() == 0 || results.isEmpty() || results.size() > 256) {
+            return null;
+        }
+        boolean hasIngredient = false;
+        for (int index = 0; index < recipe.ingredientCount(); index++) {
+            if (!recipe.emptyIngredient(index)) {
+                hasIngredient = true;
+                break;
+            }
+        }
+        if (!hasIngredient) {
+            return null;
+        }
+        for (final var output : results) {
+            if (output.isEmpty() || items.maxStackSize(output) <= 0) {
+                return null;
+            }
+        }
+        final var result = results.getFirst();
+        final int maximum = Math.min(255, items.maxStackSize(result));
+        if (result.amount() > maximum) {
+            return null;
+        }
+        final var player = inventory.getInventoryContainer();
+        final var cursorSlot = new Slot(inventory.getHudContainer(), 0);
+        final var cursor = cursorSlot.item();
+        final var stack = result.copy();
+        stack.setAmount(maximum);
+        // Native 1.26.60 checks existing capacity before ingredient consumption.
+        boolean room = false;
+        for (int slot = 0; slot < player.size(); slot++) {
+            final var previous = player.getItem(slot);
+            if ((previous.isEmpty() || previous.netId() != null && items.canMerge(stack, previous)
+                    && previous.amount() < maximum) && player.canPlaceItem(slot, stack, 1)) {
+                room = true;
+                break;
+            }
+        }
+        if (!room && !cursor.isEmpty() && (!items.canMerge(stack, cursor) || cursor.amount() >= maximum)) {
+            return null;
+        }
+
+        final var counted = NativeRecipeCounter.count(recipe, sources, item -> {
+            final var key = items.recipeKey(item);
+            return key == null ? 0 : key.descriptorHash();
+        });
+        final var round = counted.rounds().getFirst();
+        int crafts = maximum / result.amount();
+        for (int index = 0; index < round.size(); index++) {
+            if (!recipe.emptyIngredient(index)) {
+                final int amount = recipe.ingredientAmount(index);
+                if (amount <= 0) {
+                    return null;
+                }
+                crafts = Math.min(crafts, round.get(index).amount() / amount);
+            }
+        }
+        if (crafts <= 0) {
+            return null;
+        }
+
+        final var changes = new LinkedHashMap<Slot, BedrockItem>();
+        final var consumption = new ArrayList<Transfer>();
+        final var descriptors = new ArrayList<ItemDescriptor>();
+        for (int index = 0; index < round.size(); index++) {
+            if (recipe.emptyIngredient(index)) {
+                continue;
+            }
+            final var ingredient = round.get(index);
+            int remaining = crafts * recipe.ingredientAmount(index);
+            if (ingredient.sources().isEmpty()) {
+                return null;
+            }
+            final var first = source(ingredient.sources().getFirst(), owner, inventory).item();
+            final var sourceDescriptor = items.recipeDescriptor(first);
+            if (sourceDescriptor == null) {
+                return null;
+            }
+            final var descriptor = craftDescriptor.apply(index, sourceDescriptor);
+            if (descriptor == null) {
+                return null;
+            }
+            descriptors.add(new ItemDescriptor.ItemNameDescriptor(descriptor.definition().identifier(),
+                    descriptor.metadata(), recipe.ingredientAmount(index)));
+            for (final var location : ingredient.sources()) {
+                if (remaining == 0) {
+                    break;
+                }
+                final var slot = source(location, owner, inventory);
+                final var previous = changes.getOrDefault(slot, slot.item());
+                final int count = Math.min(remaining, previous.amount());
+                if (count == 0) {
+                    continue;
+                }
+                if (slot.item().netId() == null || !slot.container.canDiscardItem(slot.index, count)) {
+                    return null;
+                }
+                consumption.add(new Transfer(slot, count));
+                final var next = previous.copy();
+                next.setAmount(previous.amount() - count);
+                changes.put(slot, next.isEmpty() ? BedrockItem.empty() : next);
+                remaining -= count;
+            }
+            if (remaining != 0) {
+                return null;
+            }
+        }
+
+        final var outputs = new ArrayList<Output>();
+        // Native 1.26.60 selects secondary results before the primary result.
+        for (int resultSlot = results.size() - 1; resultSlot >= 0; resultSlot--) {
+            final var output = results.get(resultSlot);
+            final int outputMaximum = Math.min(255, items.maxStackSize(output));
+            final var outputStack = output.copy();
+            outputStack.setAmount(outputMaximum);
+            int pending = crafts * output.amount();
+            while (pending > 0) {
+                int remaining = Math.min(pending, outputMaximum);
+                pending -= remaining;
+                final var placements = new ArrayList<Transfer>();
+                for (final boolean merge : new boolean[] {true, false}) {
+                    for (int index = 0; index < player.size() && remaining > 0; index++) {
+                        final var slot = new Slot(player, index);
+                        final var previous = changes.getOrDefault(slot, slot.item());
+                        if (merge ? previous.isEmpty() || previous.netId() == null && !changes.containsKey(slot)
+                                || !items.canMerge(outputStack, previous) : !previous.isEmpty()) {
+                            continue;
+                        }
+                        final int count = Math.min(remaining, outputMaximum - previous.amount());
+                        if (count <= 0 || !player.canPlaceItem(index, outputStack, count)) {
+                            continue;
+                        }
+                        final var next = previous.isEmpty() ? output.copy() : previous.copy();
+                        next.setAmount(previous.amount() + count);
+                        changes.put(slot, next);
+                        placements.add(new Transfer(slot, count));
+                        remaining -= count;
+                    }
+                }
+                if (resultSlot == 0 && remaining > 0) {
+                    if (!cursor.isEmpty() && (cursor.netId() == null
+                            || !cursorSlot.container.canDiscardItem(0, cursor.amount()))) {
+                        return null;
+                    }
+                    if (!cursorSlot.container.canPlaceItem(0, outputStack, remaining)) {
+                        return null;
+                    }
+                    final var next = output.copy();
+                    next.setAmount(remaining);
+                    changes.put(cursorSlot, next);
+                }
+                outputs.add(new Output(resultSlot, List.copyOf(placements), resultSlot == 0 ? 0 : remaining,
+                        resultSlot == 0 ? remaining : 0));
+            }
+        }
+        return new Plan(recipeId, crafts, results.stream().map(BedrockItem::copy).toList(), List.copyOf(descriptors),
+                List.copyOf(consumption), List.copyOf(outputs), cursorSlot, new LinkedHashMap<>(changes));
+    }
+
+    private static Slot source(final NativeRecipeCounter.Location location, final Container owner,
+                               final InventoryTracker inventory) {
+        return switch (location.collection()) {
+            case CraftingInputContainer -> owner instanceof CraftingTableContainer
+                    ? new Slot(owner, 32 + location.slot()) : new Slot(inventory.getHudContainer(), 28 + location.slot());
+            case HotbarContainer -> new Slot(inventory.getInventoryContainer(), location.slot());
+            case InventoryContainer -> new Slot(inventory.getInventoryContainer(), 9 + location.slot());
+            default -> throw new IllegalArgumentException("Unsupported automatic craft source");
+        };
+    }
+
+    private record Slot(Container container, int index) {
+        BedrockItem item() {
+            return this.container.getItem(this.index);
+        }
+
+        ItemStackRequestSlotInfo reference(final int id) {
+            return this.container.requestSlotInfo(this.index, id);
+        }
+    }
+
+    private record Transfer(Slot slot, int count) { }
+
+    private record Output(int resultSlot, List<Transfer> placements, int dropped, int cursorOutput) { }
+
+    public static final class Plan {
+
+        private final int recipeId;
+        private final int crafts;
+        private final List<BedrockItem> results;
+        private final List<ItemDescriptor> ingredients;
+        private final List<Transfer> consumption;
+        private final List<Output> outputs;
+        private final Slot cursor;
+        private final Map<Slot, BedrockItem> changes;
+
+        private Plan(final int recipeId, final int crafts, final List<BedrockItem> results,
+                     final List<ItemDescriptor> ingredients, final List<Transfer> consumption,
+                     final List<Output> outputs, final Slot cursor,
+                     final Map<Slot, BedrockItem> changes) {
+            this.recipeId = recipeId;
+            this.crafts = crafts;
+            this.results = results;
+            this.ingredients = ingredients;
+            this.consumption = consumption;
+            this.outputs = outputs;
+            this.cursor = cursor;
+            this.changes = changes;
+        }
+
+        public List<ItemStackRequestAction> actions(final int requestId) {
+            final var actions = new ArrayList<ItemStackRequestAction>();
+            final var mutated = new HashSet<Slot>();
+            actions.add(new ItemStackRequestAction.CraftRecipeAutoAction(this.recipeId, this.crafts, this.ingredients));
+            actions.add(new ItemStackRequestAction.CraftResultsDeprecatedAction(this.results.stream().map(BedrockItem::copy).toList(), this.crafts));
+            for (final var transfer : this.consumption) {
+                final var slot = transfer.slot;
+                actions.add(new ItemStackRequestAction.ConsumeAction(transfer.count,
+                        slot.reference(mutated.contains(slot) ? requestId : slot.item().netId())));
+                mutated.add(slot);
+            }
+            final var output = new ItemStackRequestSlotInfo(new FullContainerName(ContainerEnumName.CreatedOutputContainer, null),
+                    (byte) 50, requestId);
+            for (final var result : this.outputs) {
+                if (this.results.size() > 1) {
+                    actions.add(new ItemStackRequestAction.CreateAction(result.resultSlot));
+                }
+                for (final var transfer : result.placements) {
+                    final var slot = transfer.slot;
+                    actions.add(new ItemStackRequestAction.PlaceAction(transfer.count, output,
+                            slot.reference(mutated.contains(slot) ? requestId : slot.item().isEmpty() ? 0 : slot.item().netId())));
+                    mutated.add(slot);
+                }
+                if (result.dropped != 0) {
+                    actions.add(new ItemStackRequestAction.DropAction(result.dropped, output, false));
+                }
+                if (result.cursorOutput != 0) {
+                    final var previous = this.cursor.item();
+                    if (!previous.isEmpty()) {
+                        actions.add(new ItemStackRequestAction.DropAction(previous.amount(), this.cursor.reference(previous.netId()), false));
+                    }
+                    actions.add(new ItemStackRequestAction.TakeAction(result.cursorOutput, output,
+                            this.cursor.reference(previous.isEmpty() ? 0 : requestId)));
+                }
+            }
+            return List.copyOf(actions);
+        }
+
+        public void apply() {
+            this.changes.forEach((slot, item) -> slot.container.setItem(slot.index, item));
+        }
+    }
+
+}
