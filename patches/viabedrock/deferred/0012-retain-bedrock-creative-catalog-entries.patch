+    @Test
+    void globalInteractionsWaitForInventoryCloseAndAuthoritativeResponses() {
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") ? storage.get(args[0]) : null);
+        final InventoryTracker inventory = new InventoryTracker(user);
+        final InventoryRequestTracker requests = new InventoryRequestTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        storage.put(InventoryRequestTracker.class, requests);
+        final List<Integer> applied = new ArrayList<>();
+        final List<Integer> requestIds = new ArrayList<>();
+        final int initialRequestId = requests.nextRequestId();
+        requests.addRequest(pendingRequest(initialRequestId, inventory));
+
+        for (int sequence = 0; sequence < 3; sequence++) {
+            final int index = sequence;
+            assertTrue(requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+                @Override
+                public Container container() {
+                    return inventory.getInventoryContainer();
+                }
+
+                @Override
+                public boolean isScreenInteraction() {
+                    return false;
+                }
+
+                @Override
+                public boolean isValid(final InventoryTracker tracker) {
+                    return tracker.getInventoryContainer() == this.container();
+                }
+
+                @Override
+                public boolean apply() {
+                    applied.add(index);
+                    final int id = requests.nextRequestId();
+                    requestIds.add(id);
+                    requests.addRequest(pendingRequest(id, inventory));
+                    return true;
+                }
+            }));
+            assertTrue(requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+                @Override
+                public Container container() {
+                    return inventory.getInventoryContainer();
+                }
+
+                @Override
+                public boolean apply() {
+                    throw new AssertionError("A closed screen interaction must be discarded");
+                }
+            }));
+        }
+        inventory.setCurrentContainer(inventory.getInventoryContainer());
+        inventory.markPendingClose(inventory.getInventoryContainer());
+        requests.drainQueuedInteractions();
+        assertTrue(applied.isEmpty());
+        requests.removeRequest(initialRequestId);
+        requests.drainQueuedInteractions();
+        assertTrue(applied.isEmpty());
+        inventory.setCurrentContainerClosed(false);
+        assertEquals(List.of(0), applied);
+        for (int sequence = 0; sequence < 3; sequence++) {
+            requests.drainQueuedInteractions();
+            assertEquals(sequence + 1, applied.size());
+            assertEquals(sequence, applied.get(sequence));
+            assertTrue(requests.hasPending());
+            requests.drainQueuedInteractions();
+            assertEquals(sequence + 1, applied.size());
+            requests.removeRequest(requestIds.get(sequence));
+        }
+        requests.drainQueuedInteractions();
+        assertEquals(List.of(0, 1, 2), applied);
+        assertFalse(requests.hasPending());
+    }
+
+    private static InventoryRequestStorage pendingRequest(final int id, final InventoryTracker inventory) {
+        return new InventoryRequestStorage(new ItemStackRequestInfo(id, List.of(), List.of(),
+                TextProcessingEventOrigin.unknown), 0, inventory.getHudContainer(),
+                List.of(inventory.getInventoryContainer()));
+    }
