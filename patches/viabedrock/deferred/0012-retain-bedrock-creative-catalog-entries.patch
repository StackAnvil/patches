+    /** Invoked on the same inventory tick after source and retained-collection updates. */
+    private void publish() {
+        if (!this.actionsEnabled() || this.publicationFailed || !this.model.collections().ready()) {
+            return;
+        }
+        final var inventory = this.user().get(InventoryTracker.class);
+        final long generation = this.context.workbench() ? inventory.currentContainerGeneration()
+                : this.user().get(PlayerInventoryScreenTracker.class).acknowledgedContainer(this.opening) == null ? 0 : inventory.currentContainerGeneration();
+        final var resources = this.user().get(ResourcePackStorage.class);
+        final var program = resources.getJsonUiProgram();
+        final boolean bundleChanged = this.bundleInputs != null && !this.bundleInputs.current();
+        if (!this.presentationDirty && !bundleChanged && program == this.publishedProgram && this.publication != null && this.publication.generation() == generation) {
+            return;
+        }
+        try {
+            final var snapshot = this.snapshot(generation);
+            final int menuId = this.context.workbench() ? Byte.toUnsignedInt(inventory.getCurrentContainer().javaContainerId()) : 0;
+            final String exported = program == this.publishedProgram && this.publication != null
+                    ? this.publication.program() : new PlayerInventoryUi(program).exportProgram(this.context.workbench()).toString();
+            final var message = new NativePlayerInventoryMessage(menuId, this.opening, generation,
+                    this.publication == null ? 1 : Math.incrementExact(this.publication.revision()), exported,
+                    GsonUtil.getGson().toJson(snapshot.state), snapshot.items, snapshot.craftingPreview);
+            this.context.requireCurrent();
+            if (this.publication == null || !message.snapshot().equals(this.publication.snapshot())
+                    || !message.items().equals(this.publication.items())
+                    || !message.craftingPreview().equals(this.publication.craftingPreview())
+                    || generation != this.publication.generation() || program != this.publishedProgram || bundleChanged) {
+                final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+                packet.write(Types.STRING, NativePlayerInventoryMessage.CHANNEL);
+                packet.write(NativePlayerInventoryMessage.TYPE, message);
+                packet.send(BedrockProtocol.class);
+                this.publication = message;
+                this.bundleInputs = NativeBundleInputSession.capture(this.user(), message);
+            }
+            this.publishedProgram = program;
+            this.presentationDirty = false;
+        } catch (final RuntimeException unsupported) {
+            this.publicationFailed = true;
+            ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Unable to publish authored player inventory", unsupported);
+        }
+    }
