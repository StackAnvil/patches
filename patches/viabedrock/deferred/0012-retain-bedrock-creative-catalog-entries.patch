+
+        assertEquals(201, catalog.creativeEntry(mapped).bedrockItem().identifier());
+        assertEquals(22, catalog.creativeEntry(mapped).netId());
+        assertEquals(200, catalog.creativeEntry(catalog.entries().get(0).javaItem()).bedrockItem().identifier());
+        assertEquals(201, catalog.creativeEntry(catalog.entries().get(1).javaItem()).bedrockItem().identifier());
