+        final var entries = new ArrayList<CreativeCatalog.Entry>();
+        final int[] identifiers = new int[count + 1];
+        identifiers[0] = 50;
+        for (int index = 0; index < count; index++) {
+            identifiers[index + 1] = 100 + index;
+            entries.add(creativeEntry(index + 1, index % 4, 100 + index, index));
+        }
+        return new CreativeCatalog(groups, entries, registry(identifiers));
+    }
+
+    private static CreativeCatalog.CollectionSource collectionSource(final CreativeCatalog catalog) {
+        return catalog.collectionSource(ignored -> 1,
+                (first, second) -> NativeItemStackMatcher.matchesIdentity(first, second, ignored -> null, ignored -> Set.of()));
+    }
+
+    private static CreativeCatalog.Entry creativeEntry(final int netId, final int group, final int identifier,
+                                                        final int metadata) throws ReflectiveOperationException {
+        return new CreativeCatalog.Entry(netId, group, new BedrockItem(identifier, (short) metadata, (byte) 1), javaItem(1), false, false);
+    }
+
+    private static ItemRegistry registry(final int... identifiers) {
+        final var entries = new ArrayList<ItemEntry>();
+        for (final int identifier : identifiers) {
+            entries.add(new ItemEntry("test:item" + identifier, identifier, false, ItemVersion.Legacy, null));
+        }
+        return new ItemRegistry(entries.toArray(ItemEntry[]::new));
+    }
+
+    private static Item javaItem(final int identifier) throws ReflectiveOperationException {
+        final StructuredDataContainer data = new StructuredDataContainer();
+        final FullMappings mappings = (FullMappings) Proxy.newProxyInstance(FullMappings.class.getClassLoader(),
+                new Class<?>[]{FullMappings.class}, (proxy, method, args) -> 0);
+        final Field lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        lookup.set(data, mappings);
+        return new StructuredItem(identifier, 1, data);
+    }
+
+}
