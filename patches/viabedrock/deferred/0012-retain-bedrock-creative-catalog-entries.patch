+    /** Count outputs across candidates without spending the same source descriptor twice. */
+    public static Quantity quantity(final List<Production> candidates,
+                                    final List<Source> sources, final ToIntFunction<BedrockItem> descriptorHash) {
+        final Map<Location, BedrockItem> stacks = new HashMap<>();
+        final Map<Integer, Integer> available = new HashMap<>();
+        for (final Source source : sources) {
+            for (int slot = 0; slot < source.items.size(); slot++) {
+                final BedrockItem item = source.items.get(slot);
+                stacks.put(new Location(source.collection, slot), item);
+                if (item.amount() != 0 && RecipeIngredientMatcher.eligible(item)) {
+                    available.merge(descriptorHash.applyAsInt(item), item.amount(), Integer::sum);
+                }
+            }
+        }
+        final Map<Integer, Integer> spent = new HashMap<>();
+        int outputCount = 0;
+        int craftCount = 0;
+        for (final Production production : NativeSort.sorted(candidates,
+                Comparator.comparingInt(value -> value.candidate.priority))) {
+            final Candidate candidate = production.candidate;
+            for (final List<IngredientCount> round : count(candidate.recipe, sources, descriptorHash).rounds) {
+                int crafts = Integer.MAX_VALUE;
+                final Map<Integer, Integer> positions = new HashMap<>();
+                final Map<Integer, Integer> consumption = new HashMap<>();
+                for (int index = 0; index < round.size(); index++) {
+                    if (candidate.recipe.emptyIngredient(index)) {
+                        continue;
+                    }
+                    final IngredientCount ingredient = round.get(index);
+                    crafts = Math.min(crafts, ingredient.amount);
+                    if (ingredient.amount <= 0 || ingredient.sources.isEmpty()) {
+                        crafts = 0;
+                        break;
+                    }
+                    final BedrockItem item = Objects.requireNonNull(stacks.get(ingredient.sources.getFirst()));
+                    final int hash = descriptorHash.applyAsInt(item);
+                    positions.merge(hash, 1, Integer::sum);
+                    consumption.merge(hash, candidate.recipe.ingredientAmount(index), Integer::sum);
+                }
+                if (crafts <= 0 || positions.isEmpty()) {
+                    continue;
+                }
+                for (final var entry : positions.entrySet()) {
+                    final int remaining = available.getOrDefault(entry.getKey(), 0) - spent.getOrDefault(entry.getKey(), 0);
+                    crafts = Math.min(crafts, Math.max(0, remaining) / entry.getValue());
+                }
+                if (crafts == 0) {
+                    continue;
+                }
+                outputCount += crafts * production.outputAmount;
+                craftCount += crafts;
+                for (final var entry : consumption.entrySet()) {
+                    spent.merge(entry.getKey(), crafts * entry.getValue(), Integer::sum);
+                }
+            }
+        }
+        return new Quantity(outputCount, craftCount);
+    }
+
