+            });
+            if (!crafting.containsKey(0)) {
+                crafting.clear();
+            }
+        }
+        return new Presentation(state, previews, crafting);
+    }
+
+    private void clear() {
+        // The text survives menu closure; collections and item authority still belong to one opening.
+        if (this.model != null) {
+            this.query = this.model.query();
+        }
+        this.opening = 0;
+        this.lastRequest = 0;
+        this.craftingPreview = null;
+        this.context = null;
+        this.model = null;
+        this.catalog = null;
+        this.preferences = null;
+        this.inputs = null;
+        this.publication = null;
+        this.bundleInputs = null;
+        this.publishedProgram = null;
+        this.presentationDirty = true;
+        this.publicationFailed = false;
+    }
+
+    private record Presentation(PlayerInventoryUi.State state, Map<Integer, Item> items, Map<Integer, Item> craftingPreview) { }
+
+    private record Inputs(List<NativeRecipeCounter.Source> sources, List<String> tags, long recipes,
+                          boolean instabuild, boolean unlocks, boolean limitedCrafting, InventoryOptions preferences, GameType gameType, GameType levelGameType) { }
+
+    private record CreativePlacement(int slot, int count, int networkId, BedrockItem next) { }
+
+}
