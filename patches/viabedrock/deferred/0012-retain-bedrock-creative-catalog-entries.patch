+
+                @Override
+                public boolean isValid(final InventoryTracker tracker) {
+                    return tracker.getInventoryContainer() == this.container();
+                }
+
+                @Override
+                public boolean apply() {
+                    applied.add(index);
+                    final int id = requests.nextRequestId();
+                    requestIds.add(id);
+                    requests.addRequest(pendingRequest(id, inventory));
+                    return true;
+                }
+            }));
+            assertTrue(requests.queueInteraction(new InventoryRequestTracker.QueuedInteraction() {
+                @Override
