+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.PlaySound;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class PlaySoundPacketsTest {
+
+    @Test
+    void preservesFractionalNegativeAndLargePositionsInJavaPacket() throws Exception {
+        for (final BlockPosition position : new BlockPosition[]{
+            new BlockPosition(-33, 567, -18),
+            new BlockPosition(Integer.MIN_VALUE, -1, Integer.MAX_VALUE)
+        }) {
+            final PlaySound sound = new PlaySound("", position, 0.5F, 1.3F, -1, false, null, null);
+            final var wrapper = new PacketWrapperImpl(ClientboundPackets26_3.SOUND, null, null);
+            WorldEffectPackets.writePlaySound(wrapper, sound, 42, 3, 17);
+            final ByteBuf buffer = Unpooled.buffer();
+            try {
+                wrapper.writeToBuffer(buffer);
+                assertEquals(ClientboundPackets26_3.SOUND.getId(), Types.VAR_INT.readPrimitive(buffer));
+                assertEquals(42, Types.SOUND_EVENT.read(buffer).id());
+                assertEquals(3, Types.VAR_INT.readPrimitive(buffer));
+                assertEquals(position.x(), buffer.readInt());
+                assertEquals(position.y(), buffer.readInt());
+                assertEquals(position.z(), buffer.readInt());
+                assertEquals(sound.volume(), buffer.readFloat());
+                assertEquals(sound.pitch(), buffer.readFloat());
+                assertEquals(17, buffer.readLong());
+                assertEquals(0, buffer.readableBytes());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void readsSignedLoopsAndIndependentOptionalFieldsWithoutConsumingNextValue() throws Exception {
+        for (final int loops : new int[]{-1, 0, 3, Integer.MAX_VALUE}) {
+            for (final Long handle : new Long[]{null, 0L, Long.MIN_VALUE}) {
+                for (final Float offset : new Float[]{null, 0F, 2.5F}) {
+                    final ByteBuf buffer = Unpooled.buffer();
+                    try {
+                        final BlockPosition position = new BlockPosition(-33, 567, -18);
+                        // Write the native wire fields independently of the codec under test.
+                        BedrockTypes.STRING.write(buffer, "");
+                        BedrockTypes.BLOCK_POSITION.write(buffer, position);
+                        buffer.writeFloatLE(0.5F).writeFloatLE(1);
+                        BedrockTypes.VAR_INT.writePrimitive(buffer, loops);
+                        buffer.writeBoolean(true).writeBoolean(handle != null);
+                        if (handle != null) {
+                            buffer.writeLongLE(handle);
+                        }
+                        buffer.writeBoolean(offset != null);
+                        if (offset != null) {
+                            buffer.writeFloatLE(offset);
+                        }
+                        buffer.writeInt(0x12345678);
+                        final PlaySound expected = new PlaySound("", position, 0.5F, 1, loops, true, handle, offset);
+                        assertEquals(expected, PlaySound.TYPE.read(buffer));
+                        assertEquals(0x12345678, buffer.readInt());
+                        assertEquals(0, buffer.readableBytes());
+
+                        PlaySound.TYPE.write(buffer, expected);
+                        assertEquals(expected, PlaySound.TYPE.read(buffer));
+                        assertEquals(0, buffer.readableBytes());
+                    } finally {
+                        buffer.release();
+                    }
+                }
+            }
+        }
+    }
+
+}
