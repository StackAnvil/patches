diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
index 19a3ae680f0b6e4371637b9ec3ab48547e36d6ed..6bad368d7ab849939911f086615a04a97536d985 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
@@ -113,8 +113,12 @@ public final class OtherPlayerPackets {
             final int buildPlatform = wrapper.read(BedrockTypes.INT_LE); // build platform
 
             final PlayerEntity entity = entityTracker.addEntity(new PlayerEntity(wrapper.user(), entityRuntimeId, entityTracker.getNextJavaEntityId(), uuid, abilities));
-            entity.setPosition(position);
+            // AddPlayer supplies feet rather than MovePlayer's eye origin.
+            entity.setJavaPosition(position);
             entity.setRotation(rotation);
+            // AddPlayer does not seed the separate absolute/delta actor movement cache.
+            entity.retainSpatialUpdate(Position3f.ZERO, Position3f.ZERO,
+                    entity.lastReceivedMovementFlags(), entity.lastReceivedInterpolationTicks());
             entity.updateName(username);
             wrapper.user().get(PlayerListStorage.class).setGameType(uuid, abilities.entityUniqueId(), gameType);
 
