+final class PlayerGameTypePacketTest {
+
+    @Test
+    void remoteUpdatesRetainRawInheritanceOutsideRenderDistance() throws Exception {
+        final var fixture = new Fixture();
+        final var players = fixture.players;
+        final UUID remote = UUID.randomUUID();
+        players.addPlayer(remote, 20, remote.toString());
+
+        for (final var mode : new GameType[]{GameType.Creative, GameType.Default, GameType.Spectator, GameType.Undefined}) {
+            final var packet = fixture.updatePlayer(20, mode);
+            assertFalse(packet.isCancelled());
+            assertEquals(ClientboundPackets26_3.PLAYER_INFO_UPDATE, packet.getPacketType());
+            assertEquals(remote, packet.get(Types.UUID, 0));
+            assertEquals(mode == GameType.Creative ? GameMode.CREATIVE.ordinal()
+                    : mode == GameType.Spectator ? GameMode.SPECTATOR.ordinal() : GameMode.SURVIVAL.ordinal(),
+                    packet.get(Types.VAR_INT, 1));
+            final boolean inherited = mode == GameType.Default || mode == GameType.Undefined;
+            assertEquals(inherited ? Map.of(remote, GameMode.SPECTATOR) : Map.of(),
+                    players.getGameModeUpdates(GameType.Survival, GameType.Spectator));
+        }
+        players.removePlayer(remote);
+        assertTrue(fixture.updatePlayer(20, GameType.Default).isCancelled());
+        assertTrue(players.getGameModeUpdates(GameType.Survival, GameType.Spectator).isEmpty());
+    }
+
+    @Test
+    void defaultPacketsRefreshOnlyChangedRemoteProfilesAndPreserveLocalEvents() throws Exception {
+        final var fixture = new Fixture();
+        final UUID inherited = UUID.randomUUID();
+        final UUID undefined = UUID.randomUUID();
+        fixture.players.setGameType(inherited, 20, GameType.Default);
+        fixture.players.setGameType(undefined, 21, GameType.Undefined);
+        fixture.players.setGameType(UUID.randomUUID(), 22, GameType.Creative);
+        fixture.players.setGameType(UUID.randomUUID(), 23, GameType.Spectator);
+        fixture.local.setGameType(GameType.Survival);
+
+        fixture.updateDefault(GameType.Spectator);
+        assertEquals(List.of(Map.of(inherited, GameMode.SPECTATOR, undefined, GameMode.SPECTATOR),
+                Map.of(fixture.local.javaUuid(), GameMode.SURVIVAL)), fixture.profileUpdates());
+        assertEquals(GameMode.SURVIVAL, fixture.local.javaGameMode());
+
+        fixture.sent.clear();
+        fixture.updateDefault(GameType.Survival);
+        assertEquals(List.of(Map.of(inherited, GameMode.SURVIVAL, undefined, GameMode.SURVIVAL),
+                Map.of(fixture.local.javaUuid(), GameMode.SURVIVAL)), fixture.profileUpdates());
+
+        fixture.players.removePlayer(inherited);
+        fixture.players.removePlayer(undefined);
+        fixture.sent.clear();
+        fixture.updateDefault(GameType.Creative);
+        assertEquals(List.of(Map.of(fixture.local.javaUuid(), GameMode.SURVIVAL)), fixture.profileUpdates());
+    }
+
+    @Test
+    void localUpdatesWithoutListEntriesKeepInheritanceAndTheGameModeEvent() throws Exception {
+        final var fixture = new Fixture();
+        final var packet = fixture.updatePlayer(10, GameType.Default);
+        assertFalse(packet.isCancelled());
+        assertEquals(fixture.local.javaUuid(), packet.get(Types.UUID, 0));
+        assertEquals(GameMode.SURVIVAL, fixture.local.javaGameMode());
+        assertTrue(fixture.profileUpdates().isEmpty());
+
+        fixture.sent.clear();
+        fixture.updateDefault(GameType.Spectator);
+        assertEquals(GameMode.SPECTATOR, fixture.local.javaGameMode());
+        assertEquals(List.of(Map.of(fixture.local.javaUuid(), GameMode.SPECTATOR)), fixture.profileUpdates());
+    }
+
+    private static final class Fixture {
+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final List<byte[]> sent = new ArrayList<>();
+        private final PlayerListStorage players = new PlayerListStorage();
+        private final TestProtocol protocol = new TestProtocol();
+        private final UserConnection user;
+        private final ClientPlayerEntity local;
+
+        private Fixture() throws Exception {
+            final ProtocolPipeline pipeline = (ProtocolPipeline) Proxy.newProxyInstance(ProtocolPipeline.class.getClassLoader(),
+                    new Class<?>[]{ProtocolPipeline.class}, (proxy, method, args) -> List.of());
+            final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+                    new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) -> switch (method.getName()) {
+                        case "getPipeline" -> pipeline;
+                        case "getServerState", "getClientState", "getState" -> State.PLAY;
+                        default -> throw new UnsupportedOperationException(method.getName());
+                    });
+            final Channel channel = (Channel) Proxy.newProxyInstance(Channel.class.getClassLoader(),
+                    new Class<?>[]{Channel.class}, (proxy, method, args) -> UnpooledByteBufAllocator.DEFAULT);
+            this.user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                    new Class<?>[]{UserConnection.class}, (proxy, method, args) -> switch (method.getName()) {
+                        case "get" -> this.storage.get(args[0]);
+                        case "getProtocolInfo" -> info;
+                        case "getChannel" -> channel;
+                        case "sendRawPacket" -> {
+                            final ByteBuf buffer = (ByteBuf) args[0];
+                            try {
+                                final byte[] bytes = new byte[buffer.readableBytes()];
+                                buffer.readBytes(bytes);
+                                this.sent.add(bytes);
+                            } finally {
+                                buffer.release();
+                            }
+                            yield null;
+                        }
+                        default -> throw new UnsupportedOperationException(method.getName());
+                    });
+            final var entities = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("bedrockEntities");
+            entities.setAccessible(true);
+            final Object previousEntities = entities.get(BedrockProtocol.MAPPINGS);
+            final GameSessionStorage session;
+            try {
+                entities.set(BedrockProtocol.MAPPINGS, HashBiMap.create());
+                session = new GameSessionStorage(this.user);
+            } finally {
+                entities.set(BedrockProtocol.MAPPINGS, previousEntities);
+            }
+            session.setLevelGameType(GameType.Survival);
+            this.storage.put(GameSessionStorage.class, session);
+            this.storage.put(PlayerListStorage.class, this.players);
+            final var tracker = new EntityTracker(this.user);
+            this.storage.put(EntityTracker.class, tracker);
+            this.local = tracker.addEntity(new ClientPlayerEntity(this.user, 100, UUID.randomUUID(),
+                    new PlayerAbilities(10, (byte) 0, (byte) 0)), false);
+        }
+
+        private PacketWrapper updatePlayer(final long uniqueId, final GameType gameType) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.VAR_INT.write(input, gameType.getValue());
+                BedrockTypes.VAR_LONG.write(input, uniqueId);
+                BedrockTypes.UNSIGNED_VAR_LONG.write(input, 0L);
+                return this.translate(ClientboundBedrockPackets.UPDATE_PLAYER_GAME_TYPE, input);
+            } finally {
+                input.release();
+            }
+        }
+
+        private void updateDefault(final GameType gameType) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.VAR_INT.write(input, gameType.getValue());
+                assertTrue(this.translate(ClientboundBedrockPackets.SET_DEFAULT_GAME_TYPE, input).isCancelled());
+            } finally {
+                input.release();
+            }
+        }
+
+        private PacketWrapper translate(final ClientboundBedrockPackets type, final ByteBuf input) throws Exception {
+            final var packet = new PacketWrapperImpl(type, input, this.user);
+            final var mapping = this.protocol.clientbound(packet);
+            mapping.applyType(packet);
+            final ProtocolManager protocolManager = (ProtocolManager) Proxy.newProxyInstance(ProtocolManager.class.getClassLoader(),
+                    new Class<?>[]{ProtocolManager.class}, (proxy, method, args) ->
+                            new PacketWrapperImpl((PacketType) args[0], (ByteBuf) args[1], (UserConnection) args[2]));
+            final ViaManager manager = (ViaManager) Proxy.newProxyInstance(ViaManager.class.getClassLoader(),
+                    new Class<?>[]{ViaManager.class}, (proxy, method, args) -> protocolManager);
+            final var managerField = Via.class.getDeclaredField("manager");
+            managerField.setAccessible(true);
+            final Object previousManager = managerField.get(null);
+            try {
+                managerField.set(null, manager);
+                mapping.handler().handle(packet);
+            } finally {
+                managerField.set(null, previousManager);
+            }
+            assertFalse(input.isReadable());
+            return packet;
+        }
+
+        private List<Map<UUID, GameMode>> profileUpdates() {
+            final var profiles = new ArrayList<Map<UUID, GameMode>>();
+            int events = 0;
+            for (final byte[] bytes : this.sent) {
+                final var input = Unpooled.wrappedBuffer(bytes);
+                try {
+                    final int id = Types.VAR_INT.read(input);
+                    if (id == ClientboundPackets26_3.PLAYER_INFO_UPDATE.getId()) {
+                        final var actions = Types.PROFILE_ACTIONS_ENUM1_21_4.read(input);
+                        assertEquals(1, actions.cardinality());
+                        assertTrue(actions.get(2)); // UPDATE_GAME_MODE
+                        final int size = Types.VAR_INT.read(input);
+                        final Map<UUID, GameMode> modes = new HashMap<>();
+                        for (int i = 0; i < size; i++) {
+                            modes.put(Types.UUID.read(input), GameMode.values()[Types.VAR_INT.read(input)]);
+                        }
+                        profiles.add(modes);
+                    } else {
+                        assertEquals(ClientboundPackets26_3.GAME_EVENT.getId(), id);
+                        assertEquals(3, Types.UNSIGNED_BYTE.read(input).intValue()); // CHANGE_GAME_MODE
+                        assertEquals((float) this.local.javaGameMode().ordinal(), Types.FLOAT.read(input));
+                        events++;
+                    }
+                    assertFalse(input.isReadable());
+                } finally {
+                    input.release();
+                }
+            }
+            assertEquals(1, events);
+            return profiles;
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            ClientPlayerPackets.register(this);
+        }
+
+        private PacketMapping clientbound(final PacketWrapper packet) {
+            return this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+        }
+    }
+
+}
