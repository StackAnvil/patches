+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.GameType;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.GameMode;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class PlayerListGameTypeTest {
+
+    @Test
+    void worldDefaultChangesRefreshInheritedModesAndKeepExplicitModes() {
+        final var players = new PlayerListStorage();
+        final UUID inherited = UUID.randomUUID();
+        final UUID undefined = UUID.randomUUID();
+        players.setGameType(inherited, 1, GameType.Default);
+        players.setGameType(undefined, 1, GameType.Undefined);
+        players.setGameType(UUID.randomUUID(), 1, GameType.Creative);
+        players.setGameType(UUID.randomUUID(), 1, GameType.Spectator);
+
+        assertEquals(Map.of(inherited, GameMode.SPECTATOR, undefined, GameMode.SPECTATOR),
+                players.getGameModeUpdates(GameType.Survival, GameType.Spectator));
+        assertEquals(Map.of(inherited, GameMode.SURVIVAL, undefined, GameMode.SURVIVAL),
+                players.getGameModeUpdates(GameType.Spectator, GameType.Survival));
+        assertTrue(players.getGameModeUpdates(GameType.Survival, GameType.Survival).isEmpty());
+
+        players.setGameType(inherited, 1, GameType.Adventure);
+        assertEquals(Map.of(undefined, GameMode.CREATIVE),
+                players.getGameModeUpdates(GameType.Survival, GameType.Creative));
+    }
+
+    @Test
+    void listRefreshKeepsTheSameActorModeAndReplacementDiscardsIt() {
+        final var players = new PlayerListStorage();
+        final UUID uuid = UUID.randomUUID();
+        // ADD_PLAYER can provide the mode before the list record arrives.
+        players.setGameType(uuid, 11, GameType.Default);
+        players.addPlayer(uuid, 11, uuid.toString());
+        players.addPlayer(uuid, 11, UUID.randomUUID().toString());
+        assertEquals(GameMode.SPECTATOR, players.getJavaGameMode(uuid, GameType.Spectator));
+        assertEquals(Map.of(uuid, GameMode.SPECTATOR),
+                players.getGameModeUpdates(GameType.Survival, GameType.Spectator));
+
+        players.addPlayer(uuid, 12, uuid.toString());
+        assertEquals(GameMode.SURVIVAL, players.getJavaGameMode(uuid, GameType.Spectator));
+        assertTrue(players.getGameModeUpdates(GameType.Survival, GameType.Spectator).isEmpty());
+        // A new spawn can precede replacement of the old list record.
+        players.setGameType(uuid, 13, GameType.Default);
+        players.addPlayer(uuid, 13, uuid.toString());
+        assertEquals(Map.of(uuid, GameMode.SPECTATOR),
+                players.getGameModeUpdates(GameType.Survival, GameType.Spectator));
+        players.removePlayer(uuid);
+        players.addPlayer(uuid, 12, uuid.toString());
+        assertEquals(GameMode.SURVIVAL, players.getJavaGameMode(uuid, GameType.Spectator));
+        assertTrue(players.getGameModeUpdates(GameType.Survival, GameType.Spectator).isEmpty());
+    }
+
+    @Test
+    void removalAlsoClearsSpawnModesWithoutListEntries() {
+        final var players = new PlayerListStorage();
+        final UUID uuid = UUID.randomUUID();
+        players.setGameType(uuid, 12, GameType.Default);
+        assertNull(players.removePlayer(uuid));
+        assertTrue(players.getGameModeUpdates(GameType.Survival, GameType.Spectator).isEmpty());
+    }
+
