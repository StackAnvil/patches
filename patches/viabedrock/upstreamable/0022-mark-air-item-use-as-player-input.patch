From 646dd76a3221e4359a08040a6adeb9436b839e5a Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:06:48 +0200
Subject: [PATCH] fix(interaction): mark air item use as player input

Java USE_ITEM represents a direct player action, including offhand firework use. Bedrock protocol 2193 distinguishes player-triggered item use from an unknown trigger; send Player_Input consistently with block use so the server receives the correct cause for air-use transactions.
---
 .../raphimc/viabedrock/protocol/packet/InteractionPackets.java  | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
index 4a69f711..9b4efb04 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
@@ -269,7 +269,7 @@ public final class InteractionPackets {
                     ComplexInventoryTransaction_Type.ItemUseTransaction,
                     new InventoryTransactionData.UseItemTransactionData(
                             ItemUseActionType.Use,
-                            ItemUseTriggerType.Unknown,
+                            ItemUseTriggerType.Player_Input,
                             new BlockPosition(0, 0, 0), // block position
                             255, // block face
                             slot,
-- 
2.55.0

