+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WorldPacketsTest {
+
+    @Test
+    void packsNegativeSectionHeightWithItsFullSignedWidth() {
+        final long packed = WorldPackets.packSectionPosition(new BlockPosition(-12, -4, 34));
+
+        assertEquals(-12, (int) (packed >> 42));
+        assertEquals(-4, (int) (packed << 44 >> 44));
+        assertEquals(34, (int) (packed << 22 >> 42));
+    }
+
+}
