From 372b4f1da3fe9c086d258452a3225834b8ce79b5 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 19:24:36 +0200
Subject: [PATCH] fix(world): preserve negative section heights in block
 updates

Java section positions reserve 20 bits for Y. Encoding only the low 12 bits turns updates below zero into high positive sections, so water, lava, and explosion changes can leave stale blocks visible. Use the full signed field when forwarding Bedrock subchunk updates.
---
 .../raphimc/viabedrock/protocol/packet/WorldPackets.java    | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
index e8c2be2f..3a98a699 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
@@ -457,7 +457,7 @@ public final class WorldPackets {
             for (Map.Entry<BlockPosition, List<BlockChangeRecord>> entry : blockChanges.entrySet()) {
                 final BlockPosition chunkPosition = entry.getKey();
                 final List<BlockChangeRecord> changes = entry.getValue();
-                final long chunkKey = (chunkPosition.x() & 0x3FFFFFL) << 42 | (chunkPosition.z() & 0x3FFFFFL) << 20 | (chunkPosition.y() & 0xFFFL);
+                final long chunkKey = packSectionPosition(chunkPosition);
 
                 final PacketWrapper multiBlockChange = wrapper.create(ClientboundPackets26_3.SECTION_BLOCKS_UPDATE);
                 multiBlockChange.write(Types.LONG, chunkKey); // chunk position
@@ -571,6 +571,10 @@ public final class WorldPackets {
         });
     }
 
+    static long packSectionPosition(final BlockPosition section) {
+        return (section.x() & 0x3FFFFFL) << 42 | (section.z() & 0x3FFFFFL) << 20 | (section.y() & 0xFFFFFL);
+    }
+
     private WorldPackets() {
     }
 
