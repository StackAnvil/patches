+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CameraTrackingRuntimeTest {
+
+    private static final CameraTrackingState.Target TARGET = new CameraTrackingState.Target(7, Vector.ZERO);
+    private static final List<CameraTrackingState.Preset> PRESETS = List.of(preset(0, 90), preset(1, 30));
+
+    @Test
+    void inactivePresetsKeepTheirOwnRotationAcrossSwitches() {
+        final var runtime = new CameraTrackingRuntime();
+        runtime.accept(new CameraTrackingState(1, 1, 1, 0, 1, TARGET, PRESETS));
+        final var actor = new CameraTrackingRuntime.Actor(UUID.randomUUID(), new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F));
+        runtime.advance(1, id -> actor);
+        assertEquals(-90, yaw(runtime.active(1, 1, 4)), .001F);
+        runtime.accept(new CameraTrackingState(2, 1, 2, 1, 1, TARGET, PRESETS));
+        runtime.advance(0, id -> actor);
+        assertEquals(-30, yaw(runtime.active(2, 1, 4)), .001F);
+        assertNull(runtime.active(1, 1, 4));
+        runtime.advance(1, id -> actor);
+        assertEquals(-60, yaw(runtime.active(2, 1, 4)), .001F);
+    }
+
+    @Test
+    void replacingActorLifetimeCannotResumeAnOldTarget() {
+        final var runtime = new CameraTrackingRuntime();
+        runtime.accept(new CameraTrackingState(1, 1, 1, 0, 1, TARGET, PRESETS));
+        runtime.advance(.1F, id -> new CameraTrackingRuntime.Actor(UUID.randomUUID(), new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F)));
+        final var first = runtime.active(1, 1, 4);
+        final var replacement = new CameraTrackingRuntime.Actor(UUID.randomUUID(), new CameraTargetTracker.Sample(new Vector(-10, 0, 0), 0F));
+        runtime.advance(1, id -> replacement);
+        assertEquals(first, runtime.active(1, 1, 4));
+        runtime.accept(new CameraTrackingState(2, 1, 1, 0, 2, TARGET, PRESETS));
+        runtime.advance(1, id -> replacement);
+        assertNotEquals(first, runtime.active(1, 1, 4));
+        runtime.clear();
+        assertNull(runtime.active(1, 1, 4));
+    }
+
+    @Test
+    void targetRemovalRetainsTheDesiredAnglesAndRejectsOldSnapshots() {
+        final var runtime = new CameraTrackingRuntime();
+        final var initial = new CameraTrackingState(1, 1, 1, 0, 1, TARGET, PRESETS);
+        runtime.accept(initial);
+        runtime.advance(.01F, id -> new CameraTrackingRuntime.Actor(UUID.randomUUID(), new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F)));
+        assertNotEquals(-90, yaw(runtime.active(1, 1, 4)), .001F);
+        runtime.accept(new CameraTrackingState(2, 1, 1, 0, 2, null, PRESETS));
+        assertEquals(-90, yaw(runtime.active(1, 1, 4)), .001F);
+        runtime.accept(initial);
+        runtime.advance(10, id -> null);
+        assertEquals(-90, yaw(runtime.active(1, 1, 4)), .001F);
+    }
+
+    @Test
+    void explicitDefaultRestoresRotationWhilePositionOnlyCommandsPreserveIt() {
+        final var runtime = new CameraTrackingRuntime();
+        final var actor = new CameraTrackingRuntime.Actor(UUID.randomUUID(), new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F));
+        runtime.accept(new CameraTrackingState(1, 1, 1, 0, 1, TARGET, PRESETS));
+        runtime.advance(.1F, id -> actor);
+        runtime.accept(new CameraTrackingState(2, 1, 1, 0, 2, null, PRESETS));
+        assertEquals(-90, yaw(runtime.active(1, 1, 4)), .001F);
+        final var p = PRESETS.getFirst();
+        final var moved = new CameraTrackingState.Preset(0, 0, 0, new Vector(2, 3, 4), 0, 0, p.settings());
+        runtime.accept(new CameraTrackingState(3, 1, 2, 0, 2, null, List.of(moved)));
+        assertEquals(-90, yaw(runtime.active(2, 1, 4)), .001F);
+        assertEquals(moved.position(), runtime.active(2, 1, 4).position());
+        final var reset = new CameraTrackingState.Preset(0, 0, 1, moved.position(), 0, 0, p.settings());
+        runtime.accept(new CameraTrackingState(4, 1, 3, 0, 2, null, List.of(reset)));
+        assertEquals(0, yaw(runtime.active(3, 1, 4)), .001F);
+    }
+
+    @Test
+    void stateRoundtripPreservesPresetIdentitiesAndRejectsDuplicatesOrTrailingData() {
+        final var state = new CameraTrackingState(2, 1, 3, 1, 1, TARGET, PRESETS);
+        final var buffer = Unpooled.buffer();
+        try {
+            CameraTrackingState.TYPE.write(buffer, state);
+            assertEquals(state, CameraTrackingState.TYPE.read(buffer));
+            buffer.clear();
+            CameraTrackingState.TYPE.write(buffer, state);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> CameraTrackingState.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new CameraTrackingState(2, 1, 3, 1, 1, TARGET, List.of(PRESETS.getFirst(), PRESETS.getFirst())));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static float yaw(final CameraPose pose) {
+        return CameraTargetTracker.wrap(CameraPose.PI - pose.orientation().angles().y()) / CameraPose.DEGREES;
+    }
+
+    private static CameraTrackingState.Preset preset(final long id, final float speed) {
+        return new CameraTrackingState.Preset(id, 0, 0, Vector.ZERO, 0, 0,
+                new CameraTargetTracker.Settings(speed, false, 0, 360, 0, 180, false, 50));
+    }
+
+}
