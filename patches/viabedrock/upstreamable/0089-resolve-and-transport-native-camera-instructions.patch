+package net.raphimc.viabedrock.protocol.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import com.google.gson.JsonObject;
+import io.netty.buffer.Unpooled;
+
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+class CameraPositionControllerTest {
+
+    @Test
+    void followOverridesAndAttachmentsKeepIndependentPresetState() {
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0),
+                preset("minecraft:follow_orbit", "", 0), preset("example:follow", "minecraft:follow_orbit", 0)));
+        final var controller = new CameraPositionController();
+        controller.apply(new CameraInstruction(new CameraInstruction.SetCamera(1, null, null, new CameraInstruction.Vec2(30, 60), null,
+                new CameraInstruction.Vec2(2, 3), new CameraInstruction.Vec3(1, 2, 3), null, false), null, null, null, null, null, null, null, null), registry);
+        assertEquals(CameraPositionState.Mode.FOLLOW_ORBIT, controller.state().mode());
+        assertTrue(controller.state().playerEffects());
+        final long positionSequence = controller.state().sequence();
+        controller.apply(new CameraInstruction(null, true, null, null, null, null, null, -9L, null), registry);
+        final var attached = controller.follow(1.62F);
+        assertEquals(-9, attached.actorUniqueId());
+        assertEquals(positionSequence, attached.positionSequence());
+        assertEquals(2, attached.presets().size());
+        assertEquals(30, attached.presets().get(0).pitch());
+        assertEquals(60, attached.presets().get(0).yaw());
+        assertEquals(2, attached.presets().get(0).viewX());
+        assertEquals(3, attached.presets().get(0).entityOffset().z());
+        controller.apply(set(0, null, null, null), registry);
+        assertEquals(-1, controller.follow(1.62F).activePreset());
+        controller.apply(set(2, null, null, null), registry);
+        assertEquals(45, controller.follow(1.62F).presets().get(1).pitch());
+        controller.apply(new CameraInstruction(null, null, null, null, null, null, null, null, true), registry);
+        assertNull(controller.follow(1.62F).actorUniqueId());
+        assertTrue(controller.follow(1.62F).attachmentSequence() > attached.attachmentSequence());
+        controller.apply(set(1, null, null, true), registry);
+        final var reset = controller.follow(1.62F).presets().get(0);
+        assertEquals(45, reset.pitch());
+        assertEquals(0, reset.viewX());
+        assertEquals(0, reset.entityOffset().z());
+    }
+
+    @Test
+    void targetActionsTakePrecedenceOverClearWithoutRestartingThePositionBlend() {
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0)));
+        final var controller = new CameraPositionController();
+        controller.apply(set(0, null, null, null), registry);
+        final long sequence = controller.state().sequence();
+        assertFalse(controller.apply(new CameraInstruction(null, true, null, new CameraInstruction.Target(null, 9),
+                false, null, null, null, false), registry));
+        assertEquals(9, controller.tracking().target().actorUniqueId());
+        assertEquals(sequence, controller.state().sequence());
+        assertFalse(controller.apply(new CameraInstruction(null, true, null, new CameraInstruction.Target(null, 10),
+                true, null, null, null, null), registry));
+        assertNull(controller.tracking().target());
+        assertEquals(sequence, controller.state().sequence());
+        assertEquals(0, controller.tracking().activePreset());
+        assertTrue(controller.apply(new CameraInstruction(null, true, null, null, false, null, null, null, false), registry));
+        assertEquals(CameraPositionState.Mode.LOCAL, controller.state().mode());
+    }
+
+    @Test
+    void higherPriorityActionsDoNotFallThroughToClearOrTarget() {
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0)));
+        final var controller = new CameraPositionController();
+        controller.apply(set(0, null, null, null), registry);
+        final long sequence = controller.state().sequence();
+        final var target = new CameraInstruction.Target(null, 9);
+        assertFalse(controller.apply(new CameraInstruction(null, true, null, target, true, null, null, -8L, true), registry));
+        assertNull(controller.tracking().target());
+        assertFalse(controller.apply(new CameraInstruction(null, true, null, target, true, null, null, null, true), registry));
+        assertNull(controller.tracking().target());
+        final var spline = new CameraInstruction.Spline(1, null, List.of(), List.of(), List.of(), null, null);
+        final var fov = new CameraInstruction(null, true, null, null, false,
+                new CameraInstruction.FieldOfView(30, 0, "linear", false), spline, null, false);
+        assertEquals(CameraInstruction.Action.FIELD_OF_VIEW, fov.action());
+        assertFalse(controller.apply(fov, registry));
+        assertFalse(controller.apply(new CameraInstruction(null, true, null, null, false, null, spline, null, false), registry));
+        assertEquals(sequence, controller.state().sequence());
+        assertEquals(0, controller.tracking().activePreset());
+    }
+
+    @Test
+    void nativeActionDispatchSelectsOneActionFromCombinedOptionalFields() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_DISPATCH");
+        assumeTrue(source != null);
+        final var rows = com.google.gson.JsonParser.parseString(Files.readString(Path.of(source)))
+                .getAsJsonObject().getAsJsonArray("cases");
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0)));
+        for (final var row : rows) {
+            final var sample = row.getAsJsonObject();
+            final var controller = new CameraPositionController();
+            controller.apply(set(0, null, null, null), registry);
+            controller.apply(new CameraInstruction(null, null, null, new CameraInstruction.Target(null, 8), null, null, null, null, null), registry);
+            final var spline = new CameraInstruction.Spline(1, null, List.of(), List.of(), List.of(), null, null);
+            final var instruction = new CameraInstruction(sample.get("set").getAsBoolean() ? set(0, null, null, null).set() : null,
+                    optionalBoolean(sample, "clear"), null, sample.get("target").getAsBoolean() ? new CameraInstruction.Target(null, 9) : null,
+                    optionalBoolean(sample, "remove"), sample.get("fov").getAsBoolean() ? new CameraInstruction.FieldOfView(30, 0, "linear", false) : null,
+                    sample.get("spline").getAsBoolean() ? spline : null, sample.get("attach").getAsBoolean() ? -8L : null, optionalBoolean(sample, "detach"));
+            final var action = CameraInstruction.Action.valueOf(sample.get("observed").getAsString());
+            assertEquals(action, instruction.action());
+            assertEquals(action == CameraInstruction.Action.SET || action == CameraInstruction.Action.CLEAR, controller.apply(instruction, registry));
+            assertEquals(action == CameraInstruction.Action.CLEAR ? CameraPositionState.Mode.LOCAL : CameraPositionState.Mode.FREE, controller.state().mode());
+            if (action == CameraInstruction.Action.REMOVE_TARGET || action == CameraInstruction.Action.CLEAR) {
+                assertNull(controller.tracking().target());
+            } else {
+                assertEquals(action == CameraInstruction.Action.TARGET ? 9 : 8, controller.tracking().target().actorUniqueId());
+            }
+        }
+        assertEquals(864, rows.size());
+    }
+
+    private static Boolean optionalBoolean(final JsonObject sample, final String key) {
+        return sample.get(key).isJsonNull() ? null : sample.get(key).getAsBoolean();
+    }
+
+    @Test
+    void targetCommandsKeepPositionBlendSequenceAndApplyToInactiveFreePresets() {
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0), preset("example:other", "minecraft:free", 10)));
+        final var controller = new CameraPositionController();
+        controller.apply(set(0, null, null, null), registry);
+        final long positionSequence = controller.state().sequence();
+        final var offset = new CameraInstruction.Vec3(1, 2, 3);
+        assertFalse(controller.apply(new CameraInstruction(null, null, null, new CameraInstruction.Target(offset, -8), null, null, null, null, null), registry));
+        assertEquals(positionSequence, controller.state().sequence());
+        assertEquals(2, controller.tracking().presets().size());
+        assertEquals(-8, controller.tracking().target().actorUniqueId());
+        final var originalOffset = controller.tracking().target().offset();
+        final long generation = controller.tracking().targetSequence();
+        controller.apply(new CameraInstruction(null, null, null, new CameraInstruction.Target(null, 9), null, null, null, null, null), registry);
+        assertEquals(originalOffset, controller.tracking().target().offset());
+        assertTrue(controller.tracking().targetSequence() > generation);
+        controller.apply(set(1, null, null, null), registry);
+        assertEquals(9, controller.tracking().target().actorUniqueId());
+        assertEquals(1, controller.tracking().activePreset());
+        controller.apply(new CameraInstruction(null, true, null, null, null, null, null, null, null), registry);
+        assertNull(controller.tracking().target());
+        assertEquals(-1, controller.tracking().activePreset());
+    }
+
+    @Test
+    void listenerChoiceFollowsInheritedMarkerWithoutWaitingForTheBlend() {
+        final var registry = new CameraPresetRegistry(List.of(
+                preset("minecraft:free", "", 0),
+                preset("minecraft:third_person", "", 0),
+                listenerPreset("example:player", "minecraft:free", 1),
+                listenerPreset("example:inherited", "example:player", null),
+                listenerPreset("example:camera", "example:player", 0)));
+        final var controller = new CameraPositionController();
+        controller.apply(set(1, null, null, null), registry);
+        assertFalse(controller.state().playerAudio());
+        controller.apply(new CameraInstruction(new CameraInstruction.SetCamera(3,
+                new CameraInstruction.Ease(0, 4), null, null, null, null, null, null, false),
+                null, null, null, null, null, null, null, null), registry);
+        assertTrue(controller.state().playerAudio());
+        assertEquals(4, controller.state().duration());
+        controller.apply(set(4, null, null, null), registry);
+        assertFalse(controller.state().playerAudio());
+        controller.apply(new CameraInstruction(null, true, null, null, null, null, null, null, null), registry);
+        assertFalse(controller.state().playerAudio());
+    }
+
+    @Test
+    void overridesPersistPerPresetAndDefaultClearsThem() {
+        final var root = preset("minecraft:free", "", 0);
+        final var child = preset("example:child", root.name(), 10);
+        final var registry = new CameraPresetRegistry(List.of(root, child));
+        final var controller = new CameraPositionController();
+        controller.apply(
+                set(
+                        1,
+                        new CameraInstruction.Vec3(20, 21, 22),
+                        new CameraInstruction.Vec2(15, 170),
+                        null),
+                registry);
+        controller.apply(set(0, null, null, null), registry);
+        assertEquals(0, controller.state().position().x());
+        controller.apply(set(1, null, null, false), registry);
+        assertEquals(20, controller.state().position().x());
+        assertEquals(15, controller.state().pitch());
+        controller.apply(set(1, null, null, true), registry);
+        assertEquals(10, controller.state().position().x());
+        assertEquals(0, controller.state().pitch());
+        final long before = controller.state().sequence();
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> controller.apply(set(100, null, null, null), registry));
+        assertEquals(before, controller.state().sequence());
+        controller.apply(
+                new CameraInstruction(null, true, null, null, null, null, null, null, null),
+                registry);
+        assertEquals(CameraPositionState.Mode.LOCAL, controller.state().mode());
+    }
+
+    @Test
+    void nativeRecordedCommandsResolveInheritedChildAndCorrectEasing() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_COMMANDS");
+        assumeTrue(source != null);
+        final var directory = Path.of(source);
+        final var presets =
+                Unpooled.wrappedBuffer(Files.readAllBytes(directory.resolve("custom-198-1.bin")));
+        final CameraPresetRegistry registry;
+        try {
+            registry = new CameraPresetRegistry(CameraPreset.LIST_TYPE.read(presets));
+        } finally {
+            presets.release();
+        }
+        final var controller = new CameraPositionController();
+        for (int i = 1; i <= 9; i++) {
+            final var b =
+                    Unpooled.wrappedBuffer(
+                            Files.readAllBytes(directory.resolve("custom-300-" + i + ".bin")));
+            try {
+                assertTrue(controller.apply(CameraInstruction.TYPE.read(b), registry));
+            } finally {
+                b.release();
+            }
+            final var state = controller.state();
+            assertEquals(i, state.sequence());
+            if (i == 2) {
+                assertEquals(-75.5F, state.position().x());
+                assertEquals(134, state.position().y());
+                assertEquals(32.5F, state.position().z());
+                assertEquals(15, state.pitch());
+                assertEquals(-170, state.yaw());
+                assertTrue(state.playerAudio());
+                assertFalse(state.playerEffects());
+            }
+            if (i == 4) {
+                assertEquals(CameraEase.LINEAR, state.ease());
+                assertEquals(2, state.duration());
+            }
+            if (i == 5) {
+                assertEquals(CameraEase.OUT_BACK, state.ease());
+                assertEquals(4, state.duration());
+            }
+        }
+        assertEquals(CameraPositionState.Mode.LOCAL, controller.state().mode());
+    }
+
+    @Test
+    void nativeFacingThresholdsAndVerticalTargetsPreserveFallbackAngles() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FACING");
+        assumeTrue(source != null);
+        final var rows = com.google.gson.JsonParser.parseString(Files.readString(Path.of(source)))
+                .getAsJsonObject().getAsJsonArray("cases");
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0)));
+        int checked = 0;
+        for (final var row : rows) {
+            final var sample = row.getAsJsonObject();
+            final var target = sample.getAsJsonArray("target");
+            final var previous = sample.getAsJsonArray("previous");
+            final var expected = sample.getAsJsonArray("rotation");
+            final var controller = new CameraPositionController();
+            controller.apply(new CameraInstruction(new CameraInstruction.SetCamera(0, null,
+                    new CameraInstruction.Vec3(0, 0, 0),
+                    new CameraInstruction.Vec2(previous.get(0).getAsFloat(), previous.get(1).getAsFloat()),
+                    new CameraInstruction.Vec3(target.get(0).getAsFloat(), target.get(1).getAsFloat(), target.get(2).getAsFloat()),
+                    null, null, null, false), null, null, null, null, null, null, null, null), registry);
+            assertEquals(expected.get(0).getAsFloat(), controller.state().pitch(), .00001F);
+            assertEquals(expected.get(1).getAsFloat(), controller.state().yaw(), .00001F);
+            checked++;
+        }
+        assertEquals(12, checked);
+    }
+
+    private static CameraInstruction set(
+            final long preset,
+            final CameraInstruction.Vec3 position,
+            final CameraInstruction.Vec2 rotation,
+            final Boolean defaults) {
+        return new CameraInstruction(
+                new CameraInstruction.SetCamera(
+                        preset, null, position, rotation, null, null, null, defaults, false),
+                null,
+                null,
+                null,
+                null,
+                null,
+                null,
+                null,
+                null);
+    }
+
+    private static CameraPreset preset(final String name, final String parent, final float x) {
+        return new CameraPreset(
+                name, parent, x, 0F, 0F, 0F, 0F, null, null, null, null, null, null, null, null,
+                null, null, null, null, null, null, null, false, null);
+    }
+
+    private static CameraPreset listenerPreset(final String name, final String parent, final Integer listener) {
+        return new CameraPreset(name, parent, null, null, null, null, null, null, null, null, null,
+                null, null, null, null, null, null, null, listener, null, null, null, false, null);
+    }
+
+}
