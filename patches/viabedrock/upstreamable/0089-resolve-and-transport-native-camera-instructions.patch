--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/CameraEffectsStorage.java
@@ -0,0 +1,253 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraFollowState;
+import net.raphimc.viabedrock.api.model.CameraFadeState;
+import net.raphimc.viabedrock.api.model.CameraFadeTimeline;
+import net.raphimc.viabedrock.api.model.CameraFovState;
+import net.raphimc.viabedrock.api.model.CameraFovTimeline;
+import net.raphimc.viabedrock.api.model.CameraShakeState;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraTrackingState;
+import net.raphimc.viabedrock.protocol.model.CameraPositionController;
+import net.raphimc.viabedrock.api.model.CameraShakeTimeline;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import net.raphimc.viabedrock.protocol.model.CameraPresetRegistry;
+
+import java.util.concurrent.ThreadLocalRandom;
+
+public final class CameraEffectsStorage extends StoredObject {
+
+    private final CameraFadeTimeline fade = new CameraFadeTimeline();
+    private long updatedAt;
+    private final CameraFovTimeline fov = new CameraFovTimeline();
+    private long fovUpdatedAt;
+    private long fovSequence;
+    private final CameraShakeTimeline shake = new CameraShakeTimeline();
+    private long shakeUpdatedAt;
+    private long shakeSequence;
+    private boolean joined;
+    private CameraInstruction lastInstruction;
+    private final CameraPositionController position = new CameraPositionController();
+    private long positionUpdatedAt;
+    private CameraPresetRegistry presets = CameraPresetRegistry.EMPTY;
+
+    public CameraEffectsStorage(final UserConnection user) {
+        super(user);
+    }
+
+    public CameraInstruction lastInstruction() {
+        return this.lastInstruction;
+    }
+
+    public CameraPresetRegistry presets() {
+        return this.presets;
+    }
+
+    public void setPresets(final CameraPresetRegistry presets) {
+        this.presets = presets;
+        this.position.resetPresets(presets);
+        this.sendTracking();
+        this.sendFollow();
+    }
+
+    public CameraPositionState position() {
+        return this.position.state();
+    }
+
+    public void apply(final CameraInstruction instruction) {
+        this.lastInstruction = instruction;
+        final CameraInstruction.Action action = instruction.action();
+        final CameraFovState.Command fovCommand;
+        if (action == CameraInstruction.Action.FIELD_OF_VIEW) {
+            fovCommand =
+                    new CameraFovState.Command(
+                            instruction.fieldOfView().value(),
+                            instruction.fieldOfView().easeTime(),
+                            CameraEase.fromName(instruction.fieldOfView().easeType()),
+                            instruction.fieldOfView().clear());
+        } else if (action == CameraInstruction.Action.CLEAR) {
+            fovCommand = new CameraFovState.Command(0, 0, CameraEase.LINEAR, true);
+        } else {
+            fovCommand = null;
+        }
+        if (instruction.fade() != null) {
+            final long now = System.nanoTime();
+            this.fade.apply(instruction.fade(), this.elapsed(now));
+            this.updatedAt = now;
+            this.sendFade();
+        }
+        if (fovCommand != null) {
+            final long now = System.nanoTime();
+            this.fov.advance(elapsed(this.fovUpdatedAt, now));
+            final var rendered =
+                    this.fov.state().active()
+                            ? this.fov.state().current()
+                            : CameraFovState.Value.LOCAL;
+            this.fov.apply(fovCommand, rendered, CameraFovState.Value.LOCAL);
+            this.fovUpdatedAt = now;
+            this.fovSequence++;
+            this.sendFov(fovCommand);
+        }
+        this.applyPosition(instruction);
+    }
+
+    private void applyPosition(final CameraInstruction instruction) {
+        try {
+            final long previousTracking = this.position.tracking().sequence();
+            if (this.position.apply(instruction, this.presets)) {
+                this.positionUpdatedAt = System.nanoTime();
+                this.sendPosition(true);
+            }
+            if (this.position.tracking().sequence() != previousTracking) {
+                this.sendTracking();
+                this.sendFollow();
+            }
+        } catch (final IllegalArgumentException exception) {
+            ViaBedrock.getPlatform().getLogger().warning("Ignoring camera position: " + exception.getMessage());
+        }
+    }
+
+    public void markJoined() {
+        this.joined = true;
+    }
+
+    public void sendSnapshot() {
+        this.sendPosition(false);
+        this.sendTracking();
+        this.sendFollow();
+        this.sendFade();
+        this.sendFov(null);
+        this.tickShake();
+        this.sendShake(null);
+    }
+
+    public void applyShake(final CameraShakeState.Command command) {
+        this.tickShake();
+        this.shake.apply(command, ThreadLocalRandom.current().nextLong());
+        this.shakeUpdatedAt = System.nanoTime();
+        this.shakeSequence++;
+        this.sendShake(command);
+    }
+
+    public void tickShake() {
+        final long now = System.nanoTime();
+        this.shake.advance(
+                this.shakeUpdatedAt == 0
+                        ? 0
+                        : Math.max(0, (now - this.shakeUpdatedAt) / 1_000_000_000D));
+        this.shakeUpdatedAt = now;
+    }
+
+    private void sendShake(final CameraShakeState.Command command) {
+        if (!this.canSend(CameraShakeState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet =
+                PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, CameraShakeState.CHANNEL);
+        packet.write(
+                CameraShakeState.TYPE,
+                new CameraShakeState(
+                        this.shakeSequence,
+                        elapsed(this.shakeUpdatedAt, System.nanoTime()),
+                        this.shake.snapshot(),
+                        command));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private void sendFade() {
+        if (this.canSend(CameraFadeState.CHANNEL)) {
+            final PacketWrapper packet =
+                    PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+            packet.write(Types.STRING, CameraFadeState.CHANNEL);
+            packet.write(CameraFadeState.TYPE, this.fade.snapshot(this.elapsed(System.nanoTime())));
+            packet.send(BedrockProtocol.class);
+        }
+    }
+
+    private void sendFov(final CameraFovState.Command command) {
+        if (!this.canSend(CameraFovState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet =
+                PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, CameraFovState.CHANNEL);
+        packet.write(
+                CameraFovState.TYPE,
+                new CameraFovState(
+                        this.fovSequence,
+                        elapsed(this.fovUpdatedAt, System.nanoTime()),
+                        this.fov.state(),
+                        command));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private void sendTracking() {
+        if (!this.canSend(CameraTrackingState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, CameraTrackingState.CHANNEL);
+        packet.write(CameraTrackingState.TYPE, this.position.tracking());
+        packet.send(BedrockProtocol.class);
+    }
+
+    private void sendFollow() {
+        if (!this.canSend(CameraFollowState.CHANNEL)) {
+            return;
+        }
+        final var entities = this.user().get(EntityTracker.class);
+        if (entities == null || entities.getClientPlayer() == null) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, CameraFollowState.CHANNEL);
+        packet.write(CameraFollowState.TYPE, this.position.follow(entities.getClientPlayer().eyeOffset()));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private void sendPosition(final boolean live) {
+        if (!this.canSend(CameraPositionState.CHANNEL)) {
+            return;
+        }
+        final CameraPositionState state = this.position.state();
+        if (state.mode() == CameraPositionState.Mode.FOLLOW_ORBIT && !this.canSend(CameraFollowState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, CameraPositionState.CHANNEL);
+        packet.write(CameraPositionState.TYPE, new CameraPositionState(state.sequence(), elapsed(this.positionUpdatedAt, System.nanoTime()),
+                live, state.mode(), state.position(), state.pitch(), state.yaw(), state.duration(), state.ease(), state.playerEffects(), state.playerAudio()));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private boolean canSend(final String channel) {
+        return this.joined
+                && this.user().getProtocolInfo().getServerState() == State.PLAY
+                && this.user().get(ChannelStorage.class).hasChannel(channel);
+    }
+
+    private float elapsed(final long now) {
+        return elapsed(this.updatedAt, now);
+    }
+
+    private static float elapsed(final long updatedAt, final long now) {
+        return updatedAt == 0 ? 0 : Math.max(0, (now - updatedAt) / 1_000_000_000F);
+    }
+
+}
