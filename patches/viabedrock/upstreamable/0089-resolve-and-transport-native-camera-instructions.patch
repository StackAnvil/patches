@@ -0,0 +1,145 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram.Keyframe;
+
+import java.util.List;
+
+/** Native channel interpolation and chord-weighted linear or Catmull-Rom curves. */
+public final class CameraSplinePlayback {
+
+    private static final float EPSILON = Math.ulp(1F);
+    private final CameraSplineProgram program;
+    private final Curve curve;
+    private float elapsed;
+
+    public CameraSplinePlayback(final CameraSplineProgram program, final float elapsed) {
+        this(program, program == null ? null : new Curve(program.linear(), program.points()), elapsed);
+    }
+
+    CameraSplinePlayback(final CameraSplineProgram program, final Curve curve, final float elapsed) {
+        if (program == null || curve == null || program.progress().isEmpty() || program.rotations().isEmpty()
+                || !Float.isFinite(elapsed) || elapsed < 0) {
+            throw new IllegalArgumentException("Invalid camera spline playback");
+        }
+        this.program = program;
+        this.curve = curve;
+        this.elapsed = elapsed;
+    }
+
+    CameraSplinePlayback replace(final CameraSplineProgram next, final Curve curve, final float elapsed) {
+        return new CameraSplinePlayback(next.withPreviousChannels(this.program), curve, elapsed);
+    }
+
+    /** An expired update leaves the camera at its preceding frame, without an endpoint snap. */
+    public Sample advance(final float delta) {
+        if (!Float.isFinite(delta) || delta < 0) {
+            throw new IllegalArgumentException("Invalid camera spline delta");
+        }
+        this.elapsed += delta;
+        if (this.elapsed > this.program.duration()) {
+            return null;
+        }
+        try {
+            final Vector progress = interpolate(this.program.progress(), this.elapsed, this.program.duration());
+            final Vector rotation = interpolate(this.program.rotations(), this.elapsed, this.program.duration());
+            return new Sample(this.curve.evaluate(progress.x()), Quaternion.fromAngles(rotation));
+        } catch (final IllegalArgumentException exception) {
+            // Finite authored values can still overflow during easing or curve evaluation.
+            this.elapsed = Float.POSITIVE_INFINITY;
+            return null;
+        }
+    }
+
+    private static Vector interpolate(final List<Keyframe> frames, final float elapsed, final float duration) {
+        int lower = 0;
+        while (lower < frames.size() - 1 && frames.get(lower + 1).time() <= elapsed) {
+            lower++;
+        }
+        final int upper = Math.min(lower + 1, frames.size() - 1);
+        final Keyframe start = frames.get(lower);
+        final Keyframe end = frames.get(upper);
+        final float interval = (lower == upper ? duration : end.time()) - start.time();
+        final float fraction = interval > EPSILON ? (elapsed - start.time()) / interval : 0;
+        final float factor = start.ease().factor(fraction);
+        return weighted(start.value(), end.value(), factor);
+    }
+
+    private static Vector weighted(final Vector start, final Vector end, final float factor) {
+        final float remaining = 1 - factor;
+        return new Vector(remaining * start.x() + end.x() * factor,
+                start.y() * remaining + end.y() * factor, start.z() * remaining + end.z() * factor);
+    }
+
+    public record Sample(Vector position, Quaternion orientation) { }
+
+    static final class Curve {
+        private final boolean linear;
+        private final List<Vector> points;
+        private final Vector[] velocities;
+        private final float[] starts;
+
+        Curve(final boolean linear, final List<Vector> points) {
+            if (points.size() < (linear ? 3 : 4) || points.size() > CameraSplineProgram.MAX_ENTRIES) {
+                throw new IllegalArgumentException("Invalid camera spline point count");
+            }
+            this.linear = linear;
+            this.points = List.copyOf(points);
+            this.starts = new float[points.size() - 1];
+            float length = 0;
+            for (int i = 0; i < this.starts.length; i++) {
+                this.starts[i] = length;
+                final Vector delta = points.get(i + 1).subtract(points.get(i));
+                length += (float) Math.sqrt(delta.x() * delta.x() + delta.y() * delta.y() + delta.z() * delta.z());
+            }
+            if (!Float.isFinite(length) || length <= EPSILON) {
+                throw new IllegalArgumentException("Invalid camera spline length");
+            }
+            for (int i = 0; i < this.starts.length; i++) {
+                this.starts[i] /= length;
+            }
+            this.velocities = linear ? null : new Vector[points.size()];
+            if (!linear) {
+                for (int i = 0; i < this.velocities.length; i++) {
+                    final Vector delta = points.get(Math.min(i + 1, points.size() - 1)).subtract(points.get(Math.max(0, i - 1)));
+                    this.velocities[i] = new Vector(delta.x() * .5F, delta.y() * .5F, delta.z() * .5F);
+                }
+            }
+        }
+
+        Vector evaluate(final float progress) {
+            int lower = 0;
+            while (lower < this.starts.length - 1 && this.starts[lower + 1] <= progress) {
+                lower++;
+            }
+            final int next = lower + 1;
+            final float interval = (next < this.starts.length ? this.starts[next] : 1) - this.starts[lower];
+            final float t = interval > EPSILON ? (progress - this.starts[lower]) / interval : 0;
+            final Vector start = this.points.get(lower);
+            final Vector end = this.points.get(next);
+            if (this.linear) {
+                return weighted(start, end, t);
+            }
+            final float twiceSquared = (t + t) * t;
+            final float twiceCubed = t * twiceSquared;
+            final float threeSquared = 3 * t * t;
+            final float cubed = t * t * t;
+            final float h00 = (twiceCubed - threeSquared) + 1;
+            final float h10 = (cubed - twiceSquared) + t;
+            final float h01 = threeSquared - twiceCubed;
+            final float h11 = cubed - t * t;
+            final Vector v0 = this.velocities[lower];
+            final Vector v1 = this.velocities[next];
+            return new Vector(h11 * v1.x() + (h01 * end.x() + (h10 * v0.x() + h00 * start.x())),
+                    v1.y() * h11 + (end.y() * h01 + (v0.y() * h10 + start.y() * h00)),
+                    v1.z() * h11 + (end.z() * h01 + (v0.z() * h10 + start.z() * h00)));
+        }
+    }
+
+}
