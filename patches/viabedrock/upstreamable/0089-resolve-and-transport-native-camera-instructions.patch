+package net.raphimc.viabedrock.api.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+
+import io.netty.buffer.Unpooled;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+class CameraPoseTimelineTest {
+
+    @Test
+    void yawCrossesBoundaryAndRenderingFieldsChangeAtEndpoint() {
+        final var timeline = new CameraPoseTimeline();
+        final var from = CameraPose.fromDegrees(CameraPose.Vector.ZERO, 0, 170, 1, 1);
+        final var to = CameraPose.fromDegrees(new CameraPose.Vector(10, 0, 0), 0, -170, 1, 4);
+        timeline.begin(from, 2, CameraEase.LINEAR);
+        final var halfway = timeline.advance(1, to, null);
+        assertEquals(5, halfway.position().x(), .00001F);
+        assertEquals(1, halfway.renderingMode());
+        final float yaw = 180 - halfway.orientation().angles().y() / CameraPose.DEGREES;
+        assertEquals(180, yaw, .0001F);
+        assertEquals(to, timeline.advance(1, to, null));
+        assertFalse(timeline.blending());
+    }
+
+    @Test
+    void interruptUsesRenderedPoseAndPreservesOvershoot() {
+        final var timeline = new CameraPoseTimeline();
+        final var from = CameraPose.fromDegrees(CameraPose.Vector.ZERO, 0, 0, 1, 1);
+        final var to = CameraPose.fromDegrees(new CameraPose.Vector(10, 0, 0), 0, 0, 1, 4);
+        timeline.begin(from, 2, CameraEase.OUT_BACK);
+        final var overshoot = timeline.advance(1, to, null);
+        assertTrue(overshoot.position().x() > 10);
+        timeline.begin(overshoot, 1, CameraEase.LINEAR);
+        assertEquals(overshoot.position(), timeline.advance(0, from, null).position());
+        assertEquals(
+                overshoot.position().x() / 2,
+                timeline.advance(.5F, from, null).position().x(),
+                .00001F);
+        assertEquals(from, timeline.advance(.5F, from, null));
+    }
+
+    @Test
+    void versionedTransportRetainsZeroFalseAndRejectsTrailingData() {
+        final var state =
+                new CameraPositionState(
+                        3,
+                        .5F,
+                        true,
+                        CameraPositionState.Mode.FREE,
+                        CameraPose.Vector.ZERO,
+                        0,
+                        0,
+                        2,
+                        CameraEase.OUT_BACK,
+                        false,
+                        false);
+        final var b = Unpooled.buffer();
+        try {
+            CameraPositionState.TYPE.write(b, state);
+            assertEquals(state, CameraPositionState.TYPE.read(b));
+            b.clear();
+            CameraPositionState.TYPE.write(b, state);
+            b.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> CameraPositionState.TYPE.read(b));
+        } finally {
+            b.release();
+        }
+    }
+
+    @Test
+    void nativeBlendSamplesMatchTargetExecutable() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_BLEND");
+        assumeTrue(source != null);
+        final var rows =
+                JsonParser.parseString(Files.readString(Path.of(source)))
+                        .getAsJsonObject()
+                        .getAsJsonArray("cases");
+        int checked = 0;
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final var timeline = new CameraPoseTimeline();
+            timeline.begin(
+                    new CameraPose(
+                            vector(row.getAsJsonArray("startPosition")),
+                            CameraPose.Quaternion.fromAngles(
+                                    vector(row.getAsJsonArray("startAngles"))),
+                            row.get("startFov").getAsFloat(),
+                            1),
+                    row.get("duration").getAsFloat(),
+                    CameraEase.values()[row.get("ease").getAsInt()]);
+            for (final var step : row.getAsJsonArray("samples")) {
+                final var sample = step.getAsJsonObject();
+                final var q = sample.getAsJsonArray("targetQuaternion");
+                final var target =
+                        new CameraPose(
+                                vector(sample.getAsJsonArray("targetPosition")),
+                                new CameraPose.Quaternion(
+                                        q.get(0).getAsFloat(),
+                                        q.get(1).getAsFloat(),
+                                        q.get(2).getAsFloat(),
+                                        q.get(3).getAsFloat()),
+                                sample.get("targetFov").getAsFloat(),
+                                4);
+                final var actual =
+                        timeline.advance(
+                                sample.get("delta").getAsFloat(),
+                                target,
+                                vector(sample.getAsJsonArray("parentPosition")));
+                final var expected = sample.getAsJsonObject("observed");
+                final var ep = vector(expected.getAsJsonArray("position"));
+                assertEquals(ep.x(), actual.position().x(), .0001F, row.toString());
+                assertEquals(ep.y(), actual.position().y(), .0001F, row.toString());
+                assertEquals(ep.z(), actual.position().z(), .0001F, row.toString());
+                final var eq = expected.getAsJsonArray("quaternion");
+                assertEquals(
+                        eq.get(0).getAsFloat(), actual.orientation().x(), .00002F, row.toString());
+                assertEquals(
+                        eq.get(1).getAsFloat(), actual.orientation().y(), .00002F, row.toString());
+                assertEquals(
+                        eq.get(2).getAsFloat(), actual.orientation().z(), .00002F, row.toString());
+                assertEquals(
+                        eq.get(3).getAsFloat(), actual.orientation().w(), .00002F, row.toString());
+                assertEquals(
+                        expected.get("fov").getAsFloat(), actual.fov(), .00002F, row.toString());
+                assertEquals(
+                        expected.get("duration").getAsFloat() > Math.ulp(1F) ? 1 : 4,
+                        actual.renderingMode());
+                checked++;
+            }
+        }
+        assertEquals(4608, checked);
+    }
+
+    private static CameraPose.Vector vector(final JsonArray a) {
+        return new CameraPose.Vector(
+                a.get(0).getAsFloat(), a.get(1).getAsFloat(), a.get(2).getAsFloat());
+    }
+
+}
