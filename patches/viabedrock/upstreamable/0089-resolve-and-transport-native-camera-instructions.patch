--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/CameraOrbit.java
@@ -0,0 +1,132 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.Objects;
+
+/** Native orbit component math. The caller supplies the pivot, previous camera position and collision result. */
+public final class CameraOrbit {
+
+    private final Settings settings;
+    private State state;
+    private Target target;
+
+    public CameraOrbit(final Settings settings, final State state, final Target target) {
+        this.settings = Objects.requireNonNull(settings);
+        this.state = Objects.requireNonNull(state);
+        this.target = Objects.requireNonNull(target);
+    }
+
+    public State state() {
+        return this.state;
+    }
+
+    public Target target() {
+        return this.target;
+    }
+
+    public void target(final Target target) {
+        this.target = Objects.requireNonNull(target);
+    }
+
+    /** Apply the camera input after the native input collector has converted it to degree deltas. */
+    public void input(final float pitch, final float yaw) {
+        finite(pitch, yaw);
+        final float polar = (this.settings.invertX ? -pitch : pitch) * CameraPose.DEGREES + this.target.polar;
+        final float azimuth = wrap((this.settings.invertY ? -yaw : yaw) * CameraPose.DEGREES + this.target.yaw);
+        this.target = new Target(this.target.radius, Math.clamp(azimuth, this.settings.minYaw, this.settings.maxYaw),
+                Math.clamp(polar, this.settings.minPolar, this.settings.maxPolar));
+    }
+
+    /** Float.MAX_VALUE means that collision has not supplied a radius for this frame. */
+    public Vector advance(final float delta, final Vector pivot, final Vector previousPosition, final float collisionRadius) {
+        finite(delta, collisionRadius);
+        if (delta < 0 || collisionRadius < 0) {
+            throw new IllegalArgumentException("Invalid camera orbit frame");
+        }
+        // Native uses the supplied collision result directly, including a previous result above the new target radius.
+        final float radius = collisionRadius < Float.MAX_VALUE ? collisionRadius : this.target.radius;
+        final Axis radial;
+        if (this.settings.radiusSpring == 0) {
+            radial = new Axis(0, 0);
+        } else {
+            final Vector fromPivot = previousPosition.subtract(pivot);
+            final float distance = (float) Math.sqrt(fromPivot.z() * fromPivot.z() + fromPivot.y() * fromPivot.y() + fromPivot.x() * fromPivot.x());
+            radial = spring(distance - radius, this.state.radiusVelocity, this.settings.radiusSpring, delta);
+        }
+        final Axis yaw = spring(wrap(this.state.yaw - this.target.yaw), this.state.yawVelocity, this.settings.yawSpring, delta);
+        final Axis polar = spring(wrap(this.state.polar - this.target.polar), this.state.polarVelocity, this.settings.polarSpring, delta);
+        this.state = new State(radius + radial.error, this.target.yaw + yaw.error, this.target.polar + polar.error,
+                yaw.velocity, polar.velocity, radial.velocity);
+        final float sine = (float) Math.sin(this.state.polar);
+        return new Vector(pivot.x() + (float) Math.cos(this.state.yaw) * this.state.radius * sine,
+                pivot.y() + (float) Math.cos(this.state.polar) * this.state.radius,
+                pivot.z() + (float) Math.sin(this.state.yaw) * this.state.radius * sine);
+    }
+
+    private static Axis spring(final float error, final float velocity, final float rate, final float delta) {
+        if (rate == 0) {
+            return new Axis(0, 0);
+        }
+        final float scaled = rate * error;
+        final float sum = velocity + scaled;
+        final float exponent = -rate * delta;
+        final float decay = (float) Math.exp(exponent);
+        return new Axis((delta * sum + error) * decay, ((exponent * sum + sum) - scaled) * decay);
+    }
+
+    private static float wrap(final float angle) {
+        float value = (angle + CameraPose.PI) % (2 * CameraPose.PI);
+        if (value < 0) {
+            value += 2 * CameraPose.PI;
+        }
+        return value - CameraPose.PI;
+    }
+
+    private static void finite(final float... values) {
+        for (final float value : values) {
+            if (!Float.isFinite(value)) {
+                throw new IllegalArgumentException("Invalid camera orbit value");
+            }
+        }
+    }
+
+    public record Settings(float yawSpring, float polarSpring, float radiusSpring, float minPolar, float maxPolar,
+                           float minYaw, float maxYaw, boolean invertX, boolean invertY) {
+        public Settings {
+            finite(yawSpring, polarSpring, radiusSpring, minPolar, maxPolar, minYaw, maxYaw);
+            if (yawSpring < 0 || polarSpring < 0 || radiusSpring < 0 || minPolar > maxPolar || minYaw > maxYaw) {
+                throw new IllegalArgumentException("Invalid camera orbit settings");
+            }
+        }
+
+        /** These are the pinned follow_orbit definition's overrides, not the orbit component constructor defaults. */
+        public static Settings followOrbit(final float minYaw, final float maxYaw) {
+            return new Settings(0, 0, 0, .1F * CameraPose.DEGREES, 179.9F * CameraPose.DEGREES,
+                    minYaw * CameraPose.DEGREES, maxYaw * CameraPose.DEGREES, false, false);
+        }
+    }
+
+    public record State(float radius, float yaw, float polar, float yawVelocity, float polarVelocity, float radiusVelocity) {
+        public State {
+            finite(radius, yaw, polar, yawVelocity, polarVelocity, radiusVelocity);
+        }
+    }
+
+    public record Target(float radius, float yaw, float polar) {
+        public Target {
+            finite(radius, yaw, polar);
+            if (radius < 0) {
+                throw new IllegalArgumentException("Invalid camera orbit radius");
+            }
+        }
+    }
+
+    private record Axis(float error, float velocity) { }
+
+}
