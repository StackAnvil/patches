+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraSplineDefinitionTest {
+
+    @Test
+    void omittedEasingInheritsOnlyWithinItsOwnChannel() {
+        final var definition = definition(4, "LiNeAr");
+        final var program = definition.compile();
+        assertTrue(program.linear());
+        assertEquals(List.of(CameraEase.LINEAR, CameraEase.IN_QUAD, CameraEase.IN_QUAD), program.progress().stream().map(CameraSplineProgram.Keyframe::ease).toList());
+        assertEquals(List.of(CameraEase.LINEAR, CameraEase.OUT_QUAD, CameraEase.OUT_QUAD), program.rotations().stream().map(CameraSplineProgram.Keyframe::ease).toList());
+        assertEquals(30 * .017453292F, program.rotations().getLast().value().x());
+        assertThrows(IllegalArgumentException.class, () -> definition(4, "Lınear").compile());
+    }
+
+    @Test
+    void firstExactNameMatchWinsAndNamedPlaybackIgnoresInlineFields() {
+        final var first = definition(4, "linear");
+        final var later = definition(8, "linear");
+        final var registry = new CameraSplineRegistry(List.of(first, later));
+        final var instruction = named(first.name());
+        assertEquals(first.compile(), registry.resolve(instruction));
+        assertThrows(IllegalArgumentException.class, () -> registry.resolve(named(first.name().toUpperCase(Locale.ROOT))));
+        assertThrows(IllegalArgumentException.class, () -> CameraSplineRegistry.EMPTY.resolve(instruction));
+        assertThrows(IllegalArgumentException.class, () -> new CameraSplineRegistry(List.of(definition(4, "unknown"), later)).resolve(instruction));
+        assertEquals(later.compile(), new CameraSplineRegistry(List.of(later)).resolve(instruction));
+    }
+
+    @Test
+    void nestedDefinitionCountsAreRejectedBeforeAllocation() {
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> CameraSplineDefinition.LIST_TYPE.read(buffer));
+            buffer.clear();
+            BedrockTypes.STRING.write(buffer, "example:path");
+            buffer.writeFloatLE(4);
+            BedrockTypes.STRING.write(buffer, "linear");
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> CameraSplineDefinition.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void targetServerSplinePacketsConsumeAndReproduceEveryWireByte() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SPLINE_WIRE");
+        assumeTrue(source != null);
+        final var packets = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonArray();
+        CameraSplineRegistry registry = CameraSplineRegistry.EMPTY;
+        int definitions = 0;
+        int named = 0;
+        final var inlineTypes = new HashSet<Integer>();
+        for (final var row : packets) {
+            final byte[] bytes = HexFormat.of().parseHex(row.getAsJsonObject().get("hex").getAsString());
+            final var input = Unpooled.wrappedBuffer(bytes);
+            final var output = Unpooled.buffer();
+            try {
+                final int header = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(input);
+                BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(output, header);
+                if ((header & 1023) == 338) {
+                    final var table = CameraSplineDefinition.LIST_TYPE.read(input);
+                    registry = new CameraSplineRegistry(table);
+                    CameraSplineDefinition.LIST_TYPE.write(output, table);
+                    assertFalse(table.isEmpty());
+                    assertNull(table.getFirst().progress().getFirst().easeType());
+                    definitions++;
+                } else {
+                    final var instruction = CameraInstruction.TYPE.read(input);
+                    CameraInstruction.TYPE.write(output, instruction);
+                    if (instruction.spline() != null && instruction.spline().loadFromJson()) {
+                        assertEquals(4, registry.resolve(instruction.spline()).duration());
+                        named++;
+                    } else if (instruction.spline() != null) {
+                        inlineTypes.add(instruction.spline().type());
+                        assertTrue(instruction.spline().identifier().isEmpty());
+                        assertNotNull(registry.resolve(instruction.spline()));
+                    }
+                }
+                assertFalse(input.isReadable());
+                final byte[] encoded = new byte[output.readableBytes()];
+                output.readBytes(encoded);
+                assertArrayEquals(bytes, encoded);
+            } finally {
+                input.release();
+                output.release();
+            }
+        }
+        assertTrue(definitions > 0);
+        assertTrue(named > 0);
+        assertEquals(Set.of(0, 1), inlineTypes);
+    }
+
+    @Test
+    void nativeNamedCompilerAndFinalPlaybackMatch() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_NAMED_SPLINE");
+        assumeTrue(source != null);
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+        final List<CameraSplineProgram> programs = new ArrayList<>();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (final var row : cases) {
+            final var sample = row.getAsJsonObject();
+            final List<CameraSplineDefinition> definitions = new ArrayList<>();
+            sample.getAsJsonArray("definitions").forEach(value -> definitions.add(definition(value.getAsJsonObject())));
+            final var registry = new CameraSplineRegistry(definitions);
+            final var instruction = named(sample.get("identifier").getAsString());
+            if (sample.get("accepted").getAsBoolean()) {
+                final var program = registry.resolve(instruction);
+                programs.add(program);
+                assertEquals(sample.get("duration").getAsFloat(), program.duration());
+                final var compiled = sample.getAsJsonObject("compiled");
+                assertFrames(compiled.getAsJsonArray("progress"), program.progress());
+                assertFrames(compiled.getAsJsonArray("rotation"), program.rotations());
+            } else {
+                programs.add(null);
+                assertThrows(IllegalArgumentException.class, () -> registry.resolve(instruction));
+            }
+        }
+        for (final var row : fixture.getAsJsonArray("samples")) {
+            final var sample = row.getAsJsonObject();
+            final var program = programs.get(sample.get("case").getAsInt());
+            final var pose = new CameraSplinePlayback(program, sample.get("elapsed").getAsFloat()).advance(0);
+            assertVector(sample.getAsJsonArray("position"), pose.position());
+            final var q = sample.getAsJsonArray("orientation");
+            assertEquals(q.get(0).getAsFloat(), pose.orientation().x(), .000001F);
+            assertEquals(q.get(1).getAsFloat(), pose.orientation().y(), .000001F);
+            assertEquals(q.get(2).getAsFloat(), pose.orientation().z(), .000001F);
+            assertEquals(q.get(3).getAsFloat(), pose.orientation().w(), .000001F);
+        }
+        assertEquals(36, cases.size());
+        assertEquals(56, fixture.getAsJsonArray("samples").size());
+    }
+
+    private static void assertFrames(final JsonArray expected, final List<CameraSplineProgram.Keyframe> actual) {
+        assertEquals(expected.size(), actual.size());
+        for (int i = 0; i < expected.size(); i++) {
+            final var frame = expected.get(i).getAsJsonArray();
+            assertVector(frame, actual.get(i).value());
+            assertEquals(frame.get(3).getAsFloat(), actual.get(i).time());
+            assertEquals(frame.get(4).getAsInt(), actual.get(i).ease().ordinal());
+        }
+    }
+
+    private static void assertVector(final JsonArray expected, final Vector actual) {
+        assertEquals(expected.get(0).getAsFloat(), actual.x(), .00002F);
+        assertEquals(expected.get(1).getAsFloat(), actual.y(), .00002F);
+        assertEquals(expected.get(2).getAsFloat(), actual.z(), .00002F);
+    }
+
+    private static CameraSplineDefinition definition(final JsonObject value) {
+        final List<Vec3> points = new ArrayList<>();
+        value.getAsJsonArray("points").forEach(row -> points.add(vector(row.getAsJsonArray())));
+        final List<Progress> progress = new ArrayList<>();
+        for (final var row : value.getAsJsonArray("progress")) {
+            final var f = row.getAsJsonArray();
+            progress.add(new Progress(f.get(0).getAsFloat(), f.get(1).getAsFloat(), f.get(2).isJsonNull() ? null : CameraEase.values()[f.get(2).getAsInt()].name()));
+        }
+        final List<Rotation> rotations = new ArrayList<>();
+        for (final var row : value.getAsJsonArray("rotation")) {
+            final var f = row.getAsJsonArray();
+            rotations.add(new Rotation(vector(f), f.get(3).getAsFloat(), f.get(4).isJsonNull() ? null : CameraEase.values()[f.get(4).getAsInt()].name()));
+        }
+        return new CameraSplineDefinition(value.get("name").getAsString(), value.get("duration").getAsFloat(), value.get("type").getAsString(), points, progress, rotations);
+    }
+
+    private static Vec3 vector(final JsonArray value) {
+        return new Vec3(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+
+    private static Spline named(final String name) {
+        return new Spline(77, 255, List.of(), List.of(), List.of(), name, true);
+    }
+
+    private static CameraSplineDefinition definition(final float duration, final String type) {
+        return new CameraSplineDefinition("example:path", duration, type, List.of(new Vec3(0, 70, 0), new Vec3(1, 72, -1), new Vec3(10, 70, 5)),
+                List.of(new Progress(0, 0, null), new Progress(.25F, 1, "in_quad"), new Progress(1, 4, null)),
+                List.of(new Rotation(new Vec3(0, 0, 0), 0, null), new Rotation(new Vec3(10, 45, 0), 1, "out_quad"), new Rotation(new Vec3(30, 90, 10), 4, null)));
+    }
+
+}
