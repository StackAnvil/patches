@@ -0,0 +1,171 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.LongFunction;
+
+/** Runs follow-camera instances independently of the active position blend. */
+public final class CameraFollowRuntime {
+
+    private final Map<Long, Instance> instances = new HashMap<>();
+    private CameraFollowState state;
+    private UUID attachmentLifetime;
+
+    public void accept(final CameraFollowState next) {
+        if (this.state != null && next.sequence() <= this.state.sequence()) {
+            return;
+        }
+        if (this.state == null || next.epoch() != this.state.epoch()) {
+            this.instances.clear();
+            this.attachmentLifetime = null;
+        }
+        if (this.state == null || next.attachmentSequence() != this.state.attachmentSequence()) {
+            this.attachmentLifetime = null;
+        }
+        final var ids = new HashSet<Long>();
+        for (final var preset : next.presets()) {
+            ids.add(preset.id());
+            final var instance = this.instances.computeIfAbsent(preset.id(), id -> new Instance(preset));
+            if (!instance.preset.equals(preset)) {
+                final var target = instance.preset.rotationSequence() == preset.rotationSequence()
+                        ? new CameraOrbit.Target(preset.radius(), instance.orbit.target().yaw(), instance.orbit.target().polar()) : target(preset);
+                instance.orbit = new CameraOrbit(settings(preset), instance.orbit.state(), target);
+                instance.preset = preset;
+            }
+        }
+        this.instances.keySet().retainAll(ids);
+        this.state = next;
+    }
+
+    public boolean input(final long positionSequence, final float pitchDelta, final float yawDelta) {
+        if (this.state == null || this.state.positionSequence() != positionSequence) {
+            return false;
+        }
+        final var active = this.instances.get(this.state.activePreset());
+        if (active == null) {
+            return false;
+        }
+        active.orbit.input(pitchDelta, yawDelta);
+        return true;
+    }
+
+    public void advance(final float delta, final Actor localPlayer, final LongFunction<Actor> actors) {
+        if (this.state == null) {
+            return;
+        }
+        final boolean attached = this.state.actorUniqueId() != null;
+        final Actor actor = attached ? actors.apply(this.state.actorUniqueId()) : localPlayer;
+        if (actor == null) {
+            return;
+        }
+        if (attached) {
+            if (this.attachmentLifetime == null) {
+                this.attachmentLifetime = actor.lifetime;
+            }
+            if (!this.attachmentLifetime.equals(actor.lifetime)) {
+                return;
+            }
+        }
+        for (final var instance : this.instances.values()) {
+            final var p = instance.preset;
+            final Vector origin = attached ? actor.origin : actor.origin.add(new Vector(0, this.state.playerOriginOffset(), 0));
+            final var localPoint = attached ? actor.center.subtract(origin) : Vector.ZERO;
+            final Vector pivot = origin.add(attachment(localPoint, p.entityOffset(), actor.yaw));
+            instance.orbit.input(0, 0);
+            final Vector position = instance.orbit.advance(delta, pivot, instance.renderedPosition != null ? instance.renderedPosition : pivot, Float.MAX_VALUE);
+            final Vector boom = position.subtract(pivot);
+            final float squared = boom.x() * boom.x() + boom.y() * boom.y() + boom.z() * boom.z();
+            if (squared < Math.ulp(1F)) {
+                continue;
+            }
+            final Vector view = viewOffset(pivot, position, p.viewX(), p.viewY());
+            instance.renderedPosition = position.add(view);
+            final Vector direction = pivot.add(view).subtract(instance.renderedPosition);
+            instance.orientation = CameraTargetTracker.lookAt(direction, instance.orientation);
+        }
+    }
+
+    public CameraPose active(final long positionSequence, final float fov, final int renderingMode) {
+        if (this.state == null || this.state.positionSequence() != positionSequence) {
+            return null;
+        }
+        final var active = this.instances.get(this.state.activePreset());
+        return active == null ? null : active.pose(fov, renderingMode);
+    }
+
+    public void clear() {
+        this.instances.clear();
+        this.state = null;
+        this.attachmentLifetime = null;
+    }
+
+    /** The native attachment matrix rotates the local point and entity offset together. */
+    static Vector attachment(final Vector point, final Vector offset, final float yaw) {
+        final Vector local = point.add(offset);
+        final float angle = yaw * -CameraPose.DEGREES;
+        final float cosine = (float) Math.cos(angle);
+        final float sine = (float) Math.sin(angle);
+        return new Vector(local.x() * cosine + local.z() * sine, local.y() * ((1 - cosine) + cosine),
+                local.z() * cosine - local.x() * sine);
+    }
+
+    static Vector viewOffset(final Vector pivot, final Vector camera, final float x, final float y) {
+        final Vector direction = pivot.subtract(camera);
+        final float length = (float) Math.sqrt(direction.x() * direction.x() + direction.y() * direction.y() + direction.z() * direction.z());
+        final float fx = direction.x() / length;
+        final float fy = direction.y() / length;
+        final float fz = direction.z() / length;
+        final boolean vertical = Math.abs(Math.abs(fy) - 1) < Math.ulp(1F);
+        final float rx = vertical ? 0 : -fz;
+        final float ry = vertical ? fz : 0;
+        final float rz = vertical ? -fy : fx;
+        final float right = (float) Math.sqrt(rx * rx + ry * ry + rz * rz);
+        return new Vector(rx / right * x, ry / right * x + y, rz / right * x);
+    }
+
+    private static CameraOrbit.Settings settings(final CameraFollowState.Preset p) {
+        return CameraOrbit.Settings.followOrbit(p.minYaw(), p.maxYaw());
+    }
+
+    private static CameraOrbit.Target target(final CameraFollowState.Preset p) {
+        return new CameraOrbit.Target(p.radius(), p.yaw() * CameraPose.DEGREES, -(p.pitch() * CameraPose.DEGREES - CameraPose.PI * .5F));
+    }
+
+    /** Translated entity position and native physical center, sampled at the same render time. */
+    public record Actor(UUID lifetime, Vector origin, Vector center, float yaw) {
+        public Actor {
+            if (lifetime == null || origin == null || center == null || !Float.isFinite(yaw)) {
+                throw new IllegalArgumentException("Invalid follow actor");
+            }
+        }
+    }
+
+    private static final class Instance {
+        private CameraFollowState.Preset preset;
+        private CameraOrbit orbit;
+        private Vector renderedPosition;
+        private Quaternion orientation;
+
+        private CameraPose pose(final float fov, final int renderingMode) {
+            return this.renderedPosition == null ? null : new CameraPose(this.renderedPosition, this.orientation, fov, renderingMode);
+        }
+
+        private Instance(final CameraFollowState.Preset preset) {
+            this.preset = preset;
+            final var target = target(preset);
+            this.orbit = new CameraOrbit(settings(preset), new CameraOrbit.State(target.radius(), target.yaw(), target.polar(), 0, 0, 0), target);
+            this.orientation = CameraPose.fromDegrees(Vector.ZERO, preset.pitch(), preset.yaw() + 90, 0, 0).orientation();
+        }
+    }
+
+}
