+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram.Keyframe;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Progress;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Rotation;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec3;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.BiConsumer;
+import java.util.function.Function;
+
+/** Packet 338 uses a required curve type and optional easing on named keyframes. */
+public record CameraSplineDefinition(String name, float totalTime, String type, List<Vec3> curve,
+                                     List<Progress> progress, List<Rotation> rotations) {
+
+    public static final int MAX_ENTRIES = 4096;
+    public static final Type<CameraSplineDefinition> TYPE = new Type<>(CameraSplineDefinition.class) {
+        @Override
+        public CameraSplineDefinition read(final ByteBuf b) {
+            return new CameraSplineDefinition(string(b), b.readFloatLE(), string(b), list(b, CameraSplineDefinition::vector),
+                    list(b, v -> new Progress(v.readFloatLE(), v.readFloatLE(), easing(v))),
+                    list(b, v -> new Rotation(vector(v), v.readFloatLE(), easing(v))));
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraSplineDefinition d) {
+            BedrockTypes.STRING.write(b, d.name);
+            b.writeFloatLE(d.totalTime);
+            BedrockTypes.STRING.write(b, d.type);
+            list(b, d.curve, CameraSplineDefinition::vector);
+            list(b, d.progress, (v, frame) -> {
+                v.writeFloatLE(frame.value()).writeFloatLE(frame.time());
+                easing(v, frame.easeType());
+            });
+            list(b, d.rotations, (v, frame) -> {
+                vector(v, frame.value());
+                v.writeFloatLE(frame.time());
+                easing(v, frame.easeType());
+            });
+        }
+    };
+
+    public static final Type<List<CameraSplineDefinition>> LIST_TYPE = new Type<>(List.class) {
+        @Override
+        public List<CameraSplineDefinition> read(final ByteBuf b) {
+            return List.copyOf(list(b, TYPE::read));
+        }
+
+        @Override
+        public void write(final ByteBuf b, final List<CameraSplineDefinition> definitions) {
+            list(b, definitions, TYPE::write);
+        }
+    };
+
+    public CameraSplineDefinition {
+        curve = List.copyOf(curve);
+        progress = List.copyOf(progress);
+        rotations = List.copyOf(rotations);
+        if (name == null || type == null || name.length() > 1024 || type.length() > 1024
+                || curve.size() > MAX_ENTRIES || progress.size() > MAX_ENTRIES || rotations.size() > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Invalid camera spline definition");
+        }
+    }
+
+    public CameraSplineProgram compile() {
+        final boolean linear = asciiEquals(this.type, "linear");
+        if (!linear && !asciiEquals(this.type, "catmullrom")) {
+            throw new IllegalArgumentException("Unsupported camera spline type " + this.type);
+        }
+        final List<Keyframe> progress = new ArrayList<>(this.progress.size());
+        CameraEase ease = CameraEase.LINEAR;
+        for (final Progress frame : this.progress) {
+            if (frame.easeType() != null) {
+                ease = CameraEase.fromName(frame.easeType());
+            }
+            progress.add(new Keyframe(new Vector(frame.value(), 0, 0), frame.time(), ease));
+        }
+        final List<Keyframe> rotations = new ArrayList<>(this.rotations.size());
+        ease = CameraEase.LINEAR;
+        for (final Rotation frame : this.rotations) {
+            if (frame.easeType() != null) {
+                ease = CameraEase.fromName(frame.easeType());
+            }
+            final Vec3 v = frame.value();
+            rotations.add(new Keyframe(new Vector(v.x() * CameraPose.DEGREES, v.y() * CameraPose.DEGREES,
+                    v.z() * CameraPose.DEGREES), frame.time(), ease));
+        }
+        return new CameraSplineProgram(this.totalTime, linear, this.curve.stream().map(v -> new Vector(v.x(), v.y(), v.z())).toList(), progress, rotations);
+    }
+
+    private static boolean asciiEquals(final String value, final String expected) {
+        if (value.length() != expected.length()) {
+            return false;
+        }
+        for (int i = 0; i < value.length(); i++) {
+            final char c = value.charAt(i);
+            if ((c >= 'A' && c <= 'Z' ? c + 32 : c) != expected.charAt(i)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static String string(final ByteBuf b) {
+        final String value = BedrockTypes.STRING.read(b);
+        if (value.length() > 1024) {
+            throw new IllegalArgumentException("Camera string exceeds 1024 characters");
+        }
+        return value;
+    }
+
+    private static String easing(final ByteBuf b) {
+        return b.readBoolean() ? string(b) : null;
+    }
+
+    private static void easing(final ByteBuf b, final String name) {
+        b.writeBoolean(name != null);
+        if (name != null) {
+            BedrockTypes.STRING.write(b, name);
+        }
+    }
+
+    private static Vec3 vector(final ByteBuf b) {
+        return new Vec3(b.readFloatLE(), b.readFloatLE(), b.readFloatLE());
+    }
+
+    private static void vector(final ByteBuf b, final Vec3 value) {
+        b.writeFloatLE(value.x()).writeFloatLE(value.y()).writeFloatLE(value.z());
+    }
+
+    private static <T> List<T> list(final ByteBuf b, final Function<ByteBuf, T> reader) {
+        final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(b);
+        if (count < 0 || count > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Too many camera spline entries");
+        }
+        final List<T> values = new ArrayList<>(count);
+        for (int i = 0; i < count; i++) {
+            values.add(reader.apply(b));
+        }
+        return values;
+    }
+
+    private static <T> void list(final ByteBuf b, final List<T> values, final BiConsumer<ByteBuf, T> writer) {
+        if (values.size() > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Too many camera spline entries");
+        }
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(b, values.size());
+        for (final T value : values) {
+            writer.accept(b, value);
+        }
+    }
+
+}
