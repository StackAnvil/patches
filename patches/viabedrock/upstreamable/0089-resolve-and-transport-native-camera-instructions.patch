+        int count = 0;
+        for (final String source : fixtures.split(java.io.File.pathSeparator)) {
+            final byte[] bytes = Files.readAllBytes(Path.of(source));
+            final var input = Unpooled.wrappedBuffer(bytes);
+            final var output = Unpooled.buffer();
+            try {
+                final var presets = CameraPreset.LIST_TYPE.read(input);
+                assertFalse(input.isReadable());
+                assertTrue(new CameraPresetRegistry(presets).unresolved().isEmpty());
+                CameraPreset.LIST_TYPE.write(output, presets);
