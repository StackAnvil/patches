+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram.Keyframe;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import net.raphimc.viabedrock.protocol.model.CameraSplineDefinition;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraSplineLifecycleTest {
+
+    @Test
+    void liveCommandsRetainChannelsWhileSnapshotsReplaceThemAndRetirementReleasesThem() {
+        final var runtime = runtime();
+        final var first = program(4, 0, 0);
+        runtime.accept(new CameraSplineState(1, 1, 0, true, first));
+        runtime.advance(1, id -> null);
+        assertEquals(2.5F, runtime.active(1, 70, 4).position().x(), .00001F);
+        final var empty = new CameraSplineProgram(2, true, program(2, 20, 0).points(), List.of(), List.of());
+        runtime.accept(new CameraSplineState(2, 1, 0, true, empty));
+        runtime.advance(.5F, id -> null);
+        assertEquals(21.25F, runtime.active(1, 70, 4).position().x(), .00001F);
+        runtime.accept(tracking(2, 1));
+        assertEquals(21.25F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraSplineState(2, 1, 0, true, empty));
+        runtime.advance(0, id -> null);
+        assertEquals(21.25F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraSplineState(3, 1, 0, false, program(2, 20, .5F)));
+        runtime.advance(0, id -> null);
+        assertEquals(25, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraSplineState(4, 1, 0, true, empty));
+        runtime.advance(.5F, id -> null);
+        assertEquals(26.25F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.advance(3, id -> null);
+        runtime.accept(new CameraSplineState(5, 1, 0, true, empty));
+        runtime.advance(0, id -> null);
+        assertEquals(26.25F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraSplineState(6, 1, 0, true, first));
+        runtime.advance(0, id -> null);
+        assertEquals(0, runtime.active(2, 70, 4).position().x());
+    }
+
+    @Test
+    void incompleteCommandsCanTravelButFreshPlaybackAndOversizedCompositionsAreRejected() {
+        final var base = program(4, 0, 0);
+        final var empty = new CameraSplineProgram(2, true, base.points(), List.of(), List.of());
+        assertThrows(IllegalArgumentException.class, () -> new CameraSplinePlayback(empty, 0));
+        assertThrows(IllegalArgumentException.class, () -> new CameraSplineState(1, 1, 0, false, empty));
+        final var state = new CameraSplineState(1, 1, 0, true, empty);
+        final var buffer = Unpooled.buffer();
+        try {
+            CameraSplineState.TYPE.write(buffer, state);
+            assertEquals(state, CameraSplineState.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+        final var full = new CameraSplineProgram(4, true, base.points(),
+                Collections.nCopies(CameraSplineProgram.MAX_ENTRIES, base.progress().getFirst()), base.rotations());
+        assertThrows(IllegalArgumentException.class, () -> base.withPreviousChannels(full));
+    }
+
+    @Test
+    void nativeMixedReplacementsAndStrictDurationRetirementMatch() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SPLINE_LIFECYCLE");
+        assumeTrue(source != null);
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+        final var replacements = fixture.getAsJsonArray("replacement");
+        for (final var row : replacements) {
+            final var sample = row.getAsJsonObject();
+            final var first = source(sample, true);
+            final var next = source(sample, false);
+            final var composed = next.withPreviousChannels(first);
+            assertFrames(sample.getAsJsonObject("compiled").getAsJsonArray("progress"), composed.progress());
+            assertFrames(sample.getAsJsonObject("compiled").getAsJsonArray("rotation"), composed.rotations());
+            final var runtime = runtime();
+            runtime.accept(new CameraSplineState(1, 1, 0, true, first));
+            runtime.advance(1, id -> null);
+            assertPose(sample.getAsJsonObject("first"), runtime.active(1, 70, 4));
+            runtime.accept(new CameraSplineState(2, 1, 0, true, next));
+            for (final var frame : sample.getAsJsonArray("samples")) {
+                final var expected = frame.getAsJsonObject();
+                runtime.advance(expected.get("delta").getAsFloat(), id -> null);
+                assertPose(expected, runtime.active(1, 70, 4));
+            }
+        }
+        final var retirement = fixture.getAsJsonArray("retirement");
+        for (final var row : retirement) {
+            final var sample = row.getAsJsonObject();
+            final var first = source(replacements.get(0).getAsJsonObject(), true);
+            final var program = new CameraSplineProgram(sample.get("duration").getAsFloat(), sample.get("type").getAsInt() == 1,
+                    first.points(), first.progress(), first.rotations());
+            final var playback = new CameraSplinePlayback(program, 0);
+            var preceding = new CameraSplinePlayback.Sample(new Vector(90, 80, 70), new Quaternion(0, 0, 0, 1));
+            for (final var frame : sample.getAsJsonArray("samples")) {
+                final var expected = frame.getAsJsonObject();
+                final var actual = playback.advance(expected.get("delta").getAsFloat());
+                assertEquals(expected.get("stateActive").getAsBoolean(), actual != null);
+                if (actual != null) {
+                    preceding = actual;
+                }
+                assertPose(expected, new CameraPose(preceding.position(), preceding.orientation(), 70, 4));
+            }
+        }
+        assertEquals(64, replacements.size());
+        assertEquals(12, retirement.size());
+    }
+
+    private static CameraSplineProgram source(final JsonObject sample, final boolean original) {
+        final var points = new ArrayList<CameraInstruction.Vec3>();
+        for (final var row : sample.getAsJsonArray(original ? "originalPoints" : "points")) {
+            final var v = row.getAsJsonArray();
+            points.add(new CameraInstruction.Vec3(v.get(0).getAsFloat(), v.get(1).getAsFloat(), v.get(2).getAsFloat()));
+        }
+        final var progress = new ArrayList<CameraInstruction.Progress>();
+        for (final var row : sample.getAsJsonArray(original ? "originalProgress" : "progress")) {
+            final var f = row.getAsJsonArray();
+            progress.add(new CameraInstruction.Progress(f.get(0).getAsFloat(), f.get(1).getAsFloat(), CameraEase.values()[f.get(2).getAsInt()].name()));
+        }
+        final var rotation = new ArrayList<CameraInstruction.Rotation>();
+        for (final var row : sample.getAsJsonArray(original ? "originalRotation" : "rotation")) {
+            final var f = row.getAsJsonArray();
+            rotation.add(new CameraInstruction.Rotation(new CameraInstruction.Vec3(f.get(0).getAsFloat(), f.get(1).getAsFloat(), f.get(2).getAsFloat()),
+                    f.get(3).getAsFloat(), CameraEase.values()[f.get(4).getAsInt()].name()));
+        }
+        final float duration = original ? 4 : sample.get("duration").getAsFloat();
+        final int type = original ? 1 : sample.get("type").getAsInt();
+        return sample.get(original ? "firstKind" : "nextKind").getAsString().equals("named")
+                ? new CameraSplineDefinition("probe:path", duration, type == 1 ? "linear" : "catmullrom", points, progress, rotation).compile()
+                : new CameraInstruction.Spline(duration, type, points, progress, rotation, "", false).compile();
+    }
+
+    private static void assertFrames(final JsonArray expected, final List<Keyframe> actual) {
+        assertEquals(expected.size(), actual.size());
+        for (int i = 0; i < actual.size(); i++) {
+            final var f = expected.get(i).getAsJsonArray();
+            final var a = actual.get(i);
+            assertEquals(f.get(0).getAsFloat(), a.value().x());
+            assertEquals(f.get(1).getAsFloat(), a.value().y());
+            assertEquals(f.get(2).getAsFloat(), a.value().z());
+            assertEquals(f.get(3).getAsFloat(), a.time());
+            assertEquals(f.get(4).getAsInt(), a.ease().ordinal());
+        }
+    }
+
+    private static void assertPose(final JsonObject expected, final CameraPose actual) {
+        final var p = expected.getAsJsonArray("position");
+        assertEquals(p.get(0).getAsFloat(), actual.position().x(), .00002F);
+        assertEquals(p.get(1).getAsFloat(), actual.position().y(), .00002F);
+        assertEquals(p.get(2).getAsFloat(), actual.position().z(), .00002F);
+        final var q = expected.getAsJsonArray("orientation");
+        assertEquals(q.get(0).getAsFloat(), actual.orientation().x(), .000001F);
+        assertEquals(q.get(1).getAsFloat(), actual.orientation().y(), .000001F);
+        assertEquals(q.get(2).getAsFloat(), actual.orientation().z(), .000001F);
+        assertEquals(q.get(3).getAsFloat(), actual.orientation().w(), .000001F);
+    }
+
+    private static CameraSplineProgram program(final float duration, final float x, final float alpha) {
+        return new CameraSplineProgram(duration, true, List.of(new Vector(x, 70, 0), new Vector(x + 1, 70, 0), new Vector(x + 10, 70, 0)),
+                List.of(new Keyframe(new Vector(alpha, 0, 0), 0, CameraEase.LINEAR), new Keyframe(new Vector(1, 0, 0), duration, CameraEase.LINEAR)),
+                List.of(new Keyframe(Vector.ZERO, 0, CameraEase.LINEAR)));
+    }
+
+    private static CameraTrackingState tracking(final long sequence, final long active) {
+        final var settings = new CameraTargetTracker.Settings(0, false, 0, 360, 0, 180, false, 50);
+        return new CameraTrackingState(sequence, 1, sequence, active, 0, null, List.of(
+                new CameraTrackingState.Preset(0, 0, 0, new Vector(90, 80, 70), 0, 0, settings),
+                new CameraTrackingState.Preset(1, 0, 0, new Vector(90, 80, 70), 0, 0, settings)));
+    }
+
+    private static CameraTrackingRuntime runtime() {
+        final var runtime = new CameraTrackingRuntime();
+        runtime.accept(tracking(1, 0));
+        return runtime;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/CameraSplinePlaybackTest.java b/src/test/java/net/raphimc/viabedrock/api/model/CameraSplinePlaybackTest.java
