+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+
+/** Per-preset target rotation. Inactive cameras must also receive frame updates. */
+public final class CameraTargetTracker {
+
+    private final Settings settings;
+    private final Vector initial;
+    private final float horizontalCenter;
+    private Quaternion orientation;
+    private Vector offset = Vector.ZERO;
+    private final float fallbackPitch;
+    private final float fallbackYaw;
+    private float pitch;
+    private float yaw;
+    private boolean acquired;
+    private boolean snapped;
+    private boolean removed;
+
+    public CameraTargetTracker(final Settings settings, final Quaternion orientation) {
+        this.settings = settings;
+        this.orientation = orientation;
+        this.initial = orientation.angles();
+        this.horizontalCenter = this.initial.y() - (settings.right - settings.left) * .5F * CameraPose.DEGREES;
+        this.pitch = this.initial.x() * -57.295776F;
+        this.yaw = 180 - this.initial.y() * 57.295776F;
+        if (this.yaw > 180) {
+            this.yaw -= 360;
+        }
+        this.fallbackPitch = this.pitch;
+        this.fallbackYaw = this.yaw;
+    }
+
+    public boolean removed() {
+        return this.removed;
+    }
+
+    public Quaternion stoppedOrientation() {
+        return Quaternion.fromAngles(new Vector(this.pitch * -CameraPose.DEGREES, (180 - this.yaw) * CameraPose.DEGREES, 0));
+    }
+
+    public Quaternion orientation() {
+        return this.orientation;
+    }
+
+    /** A missing sample waits before acquisition and removes an acquired target after its lifetime ends. */
+    public Quaternion advance(final float delta, final Vector camera, final Sample sample, final Vector centerOffset) {
+        if (!Float.isFinite(delta) || delta < 0) {
+            throw new IllegalArgumentException("Invalid camera target frame");
+        }
+        if (this.removed) {
+            return this.orientation;
+        }
+        if (sample == null) {
+            this.removed = this.acquired;
+            return this.orientation;
+        }
+        this.acquired = true;
+        if (sample.yaw != null) {
+            final float radians = sample.yaw * CameraPose.DEGREES;
+            final float sine = BedrockTrigonometry.sine(radians);
+            final float cosine = BedrockTrigonometry.cosine(radians);
+            this.offset = new Vector(centerOffset.x() * cosine - centerOffset.z() * sine,
+                    centerOffset.y(), centerOffset.x() * sine + centerOffset.z() * cosine);
+        }
+        final Vector direction = sample.center.add(this.offset).subtract(camera);
+        final float distanceSquared = direction.x() * direction.x() + direction.y() * direction.y() + direction.z() * direction.z();
+        if ((float) Math.sqrt(distanceSquared) > 1024) {
+            this.removed = true;
+            return this.orientation;
+        }
+        final float horizontalSquared = direction.x() * direction.x() + direction.z() * direction.z();
+        final float horizontal = (float) Math.sqrt(horizontalSquared);
+        if (horizontal >= .01F) {
+            this.yaw = (float) Math.atan2(direction.x(), direction.z()) * -57.295776F;
+        } else {
+            this.yaw = this.fallbackYaw;
+        }
+        if (distanceSquared >= .0001F) {
+            this.pitch = (float) Math.atan2(direction.y(), horizontal) * -57.295776F;
+        } else {
+            this.pitch = this.fallbackPitch;
+        }
+        float pitchRadians = this.pitch * -CameraPose.DEGREES;
+        float yawRadians = (180 - this.yaw) * CameraPose.DEGREES;
+        boolean outside = (float) Math.sqrt(distanceSquared) > this.settings.radius;
+        // This is the target build's component-elision condition, including its vertical special case.
+        if (this.settings.left != 0 || this.settings.right != 360 || this.settings.down != 90 || this.settings.up != 90) {
+            if (yawRadians >= CameraPose.PI) {
+                yawRadians -= 2 * CameraPose.PI;
+            }
+            final float halfWidth = (this.settings.left + this.settings.right) * .5F * CameraPose.DEGREES;
+            final float relative = wrap(yawRadians - this.horizontalCenter);
+            final float limitedYaw = halfWidth < CameraPose.PI ? Math.clamp(relative, -halfWidth, halfWidth) : relative;
+            final float limitedPitch = Math.clamp(pitchRadians, (this.settings.down - 90) * CameraPose.DEGREES,
+                    (this.settings.up - 90) * CameraPose.DEGREES);
+            outside |= pitchRadians != limitedPitch || relative != limitedYaw;
+            pitchRadians = limitedPitch;
+            yawRadians = wrap(limitedYaw + this.horizontalCenter);
+        }
+        final Quaternion target = Quaternion.fromAngles(new Vector(pitchRadians, yawRadians, 0));
+        if (this.settings.speed <= 0) {
+            this.orientation = outside && !this.settings.continuing ? Quaternion.fromAngles(this.initial) : target;
+        } else if (this.settings.snap && !outside && !this.snapped && distanceSquared >= .0001F) {
+            this.orientation = lookAt(direction, this.orientation);
+            this.snapped = true;
+        } else {
+            final Quaternion destination = outside && !this.settings.continuing ? Quaternion.fromAngles(this.initial) : target;
+            this.orientation = turn(this.orientation, destination, delta * this.settings.speed * CameraPose.DEGREES);
+        }
+        if (outside) {
+            this.snapped = false;
+        }
+        return this.orientation;
+    }
+
+    static float wrap(final float angle) {
+        float result = (angle + CameraPose.PI) % (2 * CameraPose.PI);
+        if (result < 0) {
+            result += 2 * CameraPose.PI;
+        }
+        return result - CameraPose.PI;
+    }
+
+    static Quaternion turn(Quaternion from, Quaternion to, final float angle) {
+        if (angle < Math.ulp(1F)) {
+            return from;
+        }
+        float dot = dot(from, to);
+        if (dot > .9999998807907104F) {
+            return to;
+        }
+        if (dot < 0) {
+            from = negate(from);
+            dot = -dot;
+        }
+        final float distance = 2 * (float) Math.acos(Math.clamp(dot, -1, 1));
+        if (angle > distance) {
+            return to;
+        }
+        final float factor = angle / distance;
+        float secondDot = dot(from, to);
+        if (secondDot < 0) {
+            to = negate(to);
+            secondDot = -secondDot;
+        }
+        if (secondDot > .9999998807907104F) {
+            return combine(from, to, 1 - factor, factor, 1);
+        }
+        final float arc = (float) Math.acos(Math.clamp(secondDot, -1, 1));
+        return combine(from, to, (float) Math.sin((1 - factor) * arc), (float) Math.sin(factor * arc), (float) Math.sin(arc));
+    }
+
+    private static float dot(final Quaternion a, final Quaternion b) {
+        return a.w() * b.w() + a.x() * b.x() + a.y() * b.y() + a.z() * b.z();
+    }
+
+    private static Quaternion negate(final Quaternion q) {
+        return new Quaternion(-q.x(), -q.y(), -q.z(), -q.w());
+    }
+
+    private static Quaternion combine(final Quaternion a, final Quaternion b, final float first, final float second, final float divisor) {
+        return new Quaternion((a.x() * first + b.x() * second) / divisor, (a.y() * first + b.y() * second) / divisor,
+                (a.z() * first + b.z() * second) / divisor, (a.w() * first + b.w() * second) / divisor);
+    }
+
+    static Quaternion lookAt(final Vector direction, final Quaternion previous) {
+        final float length = (float) Math.sqrt(direction.x() * direction.x() + direction.y() * direction.y() + direction.z() * direction.z());
+        final float x = direction.x() / length;
+        final float y = direction.y() / length;
+        final float z = direction.z() / length;
+        float rx = -z;
+        float ry = 0;
+        float rz = x;
+        float rightLength = (float) Math.sqrt(rx * rx + rz * rz);
+        if (rightLength * rightLength < Math.ulp(1F)) {
+            rx = 1 - 2 * (previous.y() * previous.y() + previous.z() * previous.z());
+            ry = 2 * (previous.x() * previous.y() + previous.z() * previous.w());
+            rz = 2 * (previous.x() * previous.z() - previous.y() * previous.w());
+            rightLength = (float) Math.sqrt(rx * rx + ry * ry + rz * rz);
+        }
+        rx /= rightLength;
+        ry /= rightLength;
+        rz /= rightLength;
+        final float ux = ry * z - rz * y;
+        final float uy = rz * x - rx * z;
+        final float uz = rx * y - ry * x;
+        // Matrix columns are right, up, and backwards; choose the largest quaternion component.
+        final float[] diagonal = {rx - uy + z, uy - rx + z, -z - rx - uy, rx + uy - z};
+        int largest = 3;
+        for (int i = 0; i < 3; i++) {
+            if (diagonal[i] > diagonal[largest]) {
+                largest = i;
+            }
+        }
+        final float component = (float) Math.sqrt(diagonal[largest] + 1) * .5F;
+        final float scale = .25F / component;
+        return switch (largest) {
+            case 0 -> new Quaternion(component, (ux + ry) * scale, (rz - x) * scale, (uz + y) * scale);
+            case 1 -> new Quaternion((ux + ry) * scale, component, (uz - y) * scale, (-x - rz) * scale);
+            case 2 -> new Quaternion((rz - x) * scale, (uz - y) * scale, component, (ry - ux) * scale);
+            default -> new Quaternion((uz + y) * scale, (-x - rz) * scale, (ry - ux) * scale, component);
+        };
+    }
+
+    public record Sample(Vector center, Float yaw) {
+        public Sample {
+            if (center == null || yaw != null && !Float.isFinite(yaw)) {
+                throw new IllegalArgumentException("Invalid camera target sample");
+            }
+        }
+    }
+
+    public record Settings(float speed, boolean snap, float left, float right, float down, float up, boolean continuing, float radius) {
+        public Settings {
+            if (!Float.isFinite(speed) || !Float.isFinite(left) || !Float.isFinite(right) || !Float.isFinite(down)
+                    || !Float.isFinite(up) || !Float.isFinite(radius) || speed < 0 || radius < 0 || left < 0 || right < 0
+                    || left + right > 360 || down < 0 || up > 180 || down > up) {
+                throw new IllegalArgumentException("Invalid camera target settings");
+            }
+        }
+    }
+
+}
