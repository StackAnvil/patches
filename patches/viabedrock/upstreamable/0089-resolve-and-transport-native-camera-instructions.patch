@@ -0,0 +1,178 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import com.google.gson.JsonParser;
+
+import io.netty.buffer.Unpooled;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.IntStream;
+
+class CameraShakeTimelineTest {
+
+    @Test
+    void overlapDecaysAndFinalExpiryRemovesBothOffsets() {
+        final var t = new CameraShakeTimeline();
+        t.apply(add(0, .7F, 8), 42);
+        t.advance(.05);
+        t.apply(add(0, 1.2F, 2), 42);
+        t.apply(add(1, .3F, 4), 42);
+        t.advance(.05);
+        t.advance(1);
+        t.advance(1);
+        assertEquals(1.9F, t.snapshot().positional(), .000001F);
+        assertEquals(2, t.snapshot().events().size());
+        t.advance(.05);
+        assertEquals(1.85F, t.snapshot().positional(), .000001F);
+        assertEquals(.3F, t.snapshot().rotational(), .000001F);
+        t.advance(1.5);
+        assertEquals(.7F, t.snapshot().positional(), .000001F);
+        t.advance(6);
+        assertTrue(t.snapshot().events().isEmpty());
+        assertEquals(CameraShakeTimeline.Offset.ZERO, t.offset(0));
+        assertEquals(CameraShakeTimeline.Offset.ZERO, t.offset(1));
+    }
+
+    @Test
+    void capDoesNotDiscardIndependentEventsAndStopClearsBothQueues() {
+        final var t = new CameraShakeTimeline();
+        t.apply(add(0, 3, 8), 12);
+        t.apply(add(0, 3, 2), 12);
+        t.apply(add(1, 2, 4), 12);
+        t.advance(.05);
+        assertEquals(4, t.snapshot().positional());
+        assertEquals(2, t.snapshot().rotational());
+        assertEquals(3, t.snapshot().events().size());
+        t.apply(new CameraShakeState.Command(true, 1, Float.NaN, Float.NaN), 99);
+        assertTrue(t.snapshot().events().isEmpty());
+        assertEquals(CameraShakeTimeline.Offset.ZERO, t.offset(0));
+        t.apply(add(0, 1, 2), 99);
+        t.advance(.25);
+        assertEquals(.25F, t.snapshot().phase());
+    }
+
+    @Test
+    void snapshotRoundTripRetainsNoiseAndRemainingLifetime() {
+        final var original = new CameraShakeTimeline();
+        original.apply(add(0, .7F, 8), 1234);
+        original.apply(add(1, .3F, 4), 1234);
+        original.advance(1);
+        final var state = new CameraShakeState(3, .25F, original.snapshot(), null);
+        final var b = Unpooled.buffer();
+        try {
+            CameraShakeState.TYPE.write(b, state);
+            final var decoded = CameraShakeState.TYPE.read(b);
+            assertEquals(state, decoded);
+            final var restored = new CameraShakeTimeline();
+            restored.restore(decoded.snapshot());
+            original.advance(.25);
+            restored.advance(decoded.elapsed());
+            assertEquals(original.snapshot(), restored.snapshot());
+            assertEquals(original.offset(0), restored.offset(0));
+            assertEquals(original.offset(1), restored.offset(1));
+            CameraShakeState.TYPE.write(
+                    b, new CameraShakeState(4, 0, original.snapshot(), add(1, .2F, 3)));
+            assertEquals(add(1, .2F, 3), CameraShakeState.TYPE.read(b).command());
+        } finally {
+            b.release();
+        }
+    }
+
+    @Test
+    void rejectsInvalidInputWithoutChangingActiveState() {
+        final var t = new CameraShakeTimeline();
+        t.apply(add(0, 1, 3), 42);
+        t.advance(.5);
+        final var before = t.snapshot();
+        for (final float value : new float[] {0, -1, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> add(0, value, 1));
+            assertThrows(IllegalArgumentException.class, () -> add(0, 1, value));
+        }
+        assertThrows(IllegalArgumentException.class, () -> add(2, 1, 1));
+        assertThrows(IllegalArgumentException.class, () -> t.advance(Double.NaN));
+        assertEquals(before, t.snapshot());
+    }
+
+    @Test
+    void noiseIsContinuousAndAxesAreIndependent() {
+        final var t = new CameraShakeTimeline();
+        t.apply(add(0, 1, 3), 19);
+        t.advance(.4);
+        final var before = t.offset(0);
+        t.advance(.0001);
+        final var after = t.offset(0);
+        assertNotEquals(before.x(), before.y());
+        assertNotEquals(before.y(), before.z());
+        assertEquals(before.x(), after.x(), .002F);
+        assertEquals(before.y(), after.y(), .002F);
+        assertEquals(before.z(), after.z(), .002F);
+    }
+
+    @Test
+    void targetNativeNoiseSamplesMatch() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SHAKE_NOISE");
+        assumeTrue(source != null);
+        final var data =
+                JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+        final var entries = data.getAsJsonArray("permutation");
+        final int[] permutation =
+                IntStream.range(0, 512).map(i -> entries.get(i & 255).getAsInt()).toArray();
+        for (final var entry : data.getAsJsonArray("samples")) {
+            final var row = entry.getAsJsonObject();
+            assertEquals(
+                    row.get("value").getAsFloat(),
+                    CameraShakeNoise.sample(
+                            permutation, row.get("x").getAsFloat(), row.get("y").getAsFloat()),
+                    .000001F);
+        }
+    }
+
+    @Test
+    void targetNativeQueueUpdatesMatch() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SHAKE_QUEUE");
+        assumeTrue(source != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonArray();
+        final var t = new CameraShakeTimeline();
+        t.apply(add(0, .7F, 8), 42);
+        double previous = 0;
+        for (int i = 0; i < rows.size(); i++) {
+            if (i == 1) {
+                t.apply(add(0, 1.2F, 2), 42);
+                t.apply(add(1, .3F, 4), 42);
+            }
+            final var row = rows.get(i).getAsJsonObject();
+            final double time = row.get("time").getAsDouble();
+            t.advance(time - previous);
+            previous = time;
+            final var state = t.snapshot();
+            for (int type = 0; type < 2; type++) {
+                final int kind = type;
+                assertEquals(
+                        row.getAsJsonArray("queueSizes").get(type).getAsInt(),
+                        state.events().stream().filter(e -> e.type() == kind).count());
+            }
+            // The native component is removed when both queues become empty.
+            if (!state.events().isEmpty()) {
+                assertEquals(row.get("phase").getAsFloat(), state.phase(), .000001F);
+                assertEquals(row.get("position").getAsFloat(), state.positional(), .000001F);
+                assertEquals(row.get("rotation").getAsFloat(), state.rotational(), .000001F);
+            }
+        }
+    }
+
+    private static CameraShakeState.Command add(
+            final int type, final float intensity, final float duration) {
+        return new CameraShakeState.Command(false, type, intensity, duration);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/CameraTargetTrackerTest.java b/src/test/java/net/raphimc/viabedrock/api/model/CameraTargetTrackerTest.java
