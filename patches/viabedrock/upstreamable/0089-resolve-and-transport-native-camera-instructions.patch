+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraRaycastTest {
+
+    @Test
+    void intersectsSurfacesInsteadOfInventingAnInsideHit() {
+        final var box = new CameraRaycast.Box(0, 0, 0, 1, 1, 1);
+        final var inside = new Vector(.5F, .5F, .5F);
+        assertNull(box.intersect(0, 0, 0, inside, new Vector(.6F, .5F, .5F)));
+        assertEquals(new CameraRaycast.Hit(new Vector(1, .5F, .5F), 5), box.intersect(0, 0, 0, inside, new Vector(2, .5F, .5F)));
+        assertEquals(new CameraRaycast.Hit(Vector.ZERO, 4), box.intersect(0, 0, 0, new Vector(-1, -1, -1), new Vector(2, 2, 2)));
+        assertNull(box.intersect(0, 0, 0, new Vector(-.0001F, .5F, .5F), new Vector(.0001F, .5F, .5F)));
+    }
+
+    @Test
+    void traversalPreservesCornerPriorityAndTheNativeStepLimit() {
+        final var queries = new ArrayList<Query>();
+        final var stop = new CameraRaycast.Box(0, 0, 0, 1, 1, 1);
+        CameraRaycast.cast(new Vector(-1, -1, -1), new Vector(2, 2, 2),
+                world(Map.of(new Cell(0, 0, 0), solid(stop)), Map.of(), queries));
+        final var cells = new LinkedHashSet<Cell>();
+        queries.forEach(query -> cells.add(query.cell));
+        assertEquals(List.of(new Cell(-1, -1, -1), new Cell(-1, -1, 0), new Cell(-1, 0, 0), new Cell(0, 0, 0)), new ArrayList<>(cells));
+        final var start = new Vector(.5F, .5F, .5F);
+        final var end = new Vector(250.5F, .5F, .5F);
+        assertNotNull(CameraRaycast.cast(start, end, world(Map.of(new Cell(200, 0, 0),
+                solid(new CameraRaycast.Box(200, 0, 0, 201, 1, 1))), Map.of(), queries)));
+        assertNull(CameraRaycast.cast(start, end, world(Map.of(new Cell(201, 0, 0),
+                solid(new CameraRaycast.Box(201, 0, 0, 202, 1, 1))), Map.of(), queries)));
+    }
+
+    @Test
+    void extraLiquidChangesLayerSelectionWithoutStoppingTheCamera() {
+        final var start = new Vector(-1, .5F, .5F);
+        final var end = new Vector(3, .5F, .5F);
+        final var first = new Cell(0, 0, 0);
+        final var second = new Cell(1, 0, 0);
+        final var box = new CameraRaycast.Box(0, 0, 0, 1, 1, 1);
+        final var liquid = new CameraRaycast.Block(1, true, box, box, CameraRaycast.Pick.LIQUID);
+        final var base = Map.of(first, solid(box), second, solid(new CameraRaycast.Box(1, 0, 0, 2, 1, 1)));
+        final var queries = new ArrayList<Query>();
+        final var hit = CameraRaycast.cast(start, end, world(base, Map.of(first, liquid), queries));
+        assertEquals(new CameraRaycast.Hit(new Vector(1, .5F, .5F), 4), hit);
+        assertTrue(queries.contains(new Query(false, second)));
+        assertFalse(queries.contains(new Query(true, second)));
+        assertNull(CameraRaycast.cast(start, end, world(Map.of(first, liquid), Map.of(), queries)));
+    }
+
+    @Test
+    void customBlocksRequireCollisionEligibilityButIntersectTheirSelectionBox() {
+        final var collision = new CameraRaycast.Box(.25F, 0, .25F, .75F, 1, .75F);
+        final var selection = new CameraRaycast.Box(0, 0, 0, 1, 1, 1);
+        final var start = new Vector(-1, .5F, .5F);
+        final var end = new Vector(2, .5F, .5F);
+        final var cell = new Cell(0, 0, 0);
+        final var queries = new ArrayList<Query>();
+        assertEquals(new CameraRaycast.Hit(new Vector(0, .5F, .5F), 4), CameraRaycast.cast(start, end,
+                world(Map.of(cell, new CameraRaycast.Block(null, false, collision, selection, CameraRaycast.Pick.ALWAYS)), Map.of(), queries)));
+        assertNull(CameraRaycast.cast(start, end,
+                world(Map.of(cell, new CameraRaycast.Block(null, false, collision, null, CameraRaycast.Pick.ALWAYS)), Map.of(), queries)));
+        assertNull(CameraRaycast.cast(start, end,
+                world(Map.of(cell, new CameraRaycast.Block(null, false, null, selection, CameraRaycast.Pick.ALWAYS)), Map.of(), queries)));
+    }
+
+    @Test
+    void nativeBoxIntersectionsMatch() throws Exception {
+        final var root = nativeFixture();
+        for (final var element : root.getAsJsonArray("boxes")) {
+            final var sample = element.getAsJsonObject();
+            final var cell = cell(sample.getAsJsonArray("cell"));
+            final var actual = box(sample.getAsJsonArray("bounds")).intersect(cell.x, cell.y, cell.z,
+                    vector(sample.getAsJsonArray("start")), vector(sample.getAsJsonArray("end")));
+            assertHit(sample, actual);
+        }
+    }
+
+    @Test
+    void nativeWorldIntersectionsAndCellOrderMatch() throws Exception {
+        final var root = nativeFixture();
+        for (final var element : root.getAsJsonArray("worlds")) {
+            final var sample = element.getAsJsonObject();
+            final var visited = new ArrayList<Query>();
+            final var actual = CameraRaycast.cast(vector(sample.getAsJsonArray("start")), vector(sample.getAsJsonArray("end")),
+                    world(blocks(sample.getAsJsonArray("cells")), blocks(sample.getAsJsonArray("extras")), visited));
+            assertHit(sample, actual);
+            final var expected = new ArrayList<Query>();
+            sample.getAsJsonArray("queries").forEach(value -> {
+                final var query = value.getAsJsonObject();
+                expected.add(new Query(query.get("layer").getAsString().equals("extra"), cell(query.getAsJsonArray("position"))));
+            });
+            assertEquals(expected, visited, sample::toString);
+        }
+    }
+
+    private static Map<Cell, CameraRaycast.Block> blocks(final JsonArray cells) {
+        final var result = new HashMap<Cell, CameraRaycast.Block>();
+        for (final var element : cells) {
+            final var value = element.getAsJsonObject();
+            final var cell = cell(value.getAsJsonArray("position"));
+            result.put(cell, new CameraRaycast.Block(value.get("material").getAsLong(), value.get("liquid").getAsBoolean(),
+                    worldBox(value, "bounds", cell), worldBox(value, "selectionBounds", cell), CameraRaycast.Pick.valueOf(value.get("pick").getAsString())));
+        }
+        return result;
+    }
+
+    private static CameraRaycast.Box worldBox(final JsonObject value, final String field, final Cell cell) {
+        if (value.get(field).isJsonNull()) {
+            return null;
+        }
+        final var bounds = value.getAsJsonArray(field);
+        return new CameraRaycast.Box(bounds.get(0).getAsFloat() + cell.x, bounds.get(1).getAsFloat() + cell.y,
+                bounds.get(2).getAsFloat() + cell.z, bounds.get(3).getAsFloat() + cell.x, bounds.get(4).getAsFloat() + cell.y,
+                bounds.get(5).getAsFloat() + cell.z);
+    }
+
+    private static CameraRaycast.Block solid(final CameraRaycast.Box box) {
+        return new CameraRaycast.Block(null, false, box, box, CameraRaycast.Pick.ALWAYS);
+    }
+
+    private static CameraRaycast.World world(final Map<Cell, CameraRaycast.Block> base, final Map<Cell, CameraRaycast.Block> extra,
+                                             final List<Query> queries) {
+        return new CameraRaycast.World() {
+            @Override
+            public CameraRaycast.Block base(final int x, final int y, final int z) {
+                final var cell = new Cell(x, y, z);
+                queries.add(new Query(false, cell));
+                return base.get(cell);
+            }
+
+            @Override
+            public CameraRaycast.Block extra(final int x, final int y, final int z) {
+                final var cell = new Cell(x, y, z);
+                queries.add(new Query(true, cell));
+                return extra.get(cell);
+            }
+        };
+    }
+
+    private static JsonObject nativeFixture() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_WORLD");
+        assumeTrue(source != null);
+        return JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+    }
+
+    private static void assertHit(final JsonObject sample, final CameraRaycast.Hit actual) {
+        if (sample.get("hit").isJsonNull()) {
+            assertNull(actual, sample::toString);
+            return;
+        }
+        assertNotNull(actual, sample::toString);
+        assertEquals(sample.get("face").getAsInt(), actual.face(), sample::toString);
+        final Vector expected = vector(sample.getAsJsonArray("hit"));
+        assertEquals(expected.x(), actual.position().x(), Math.max(.000001F, Math.ulp(expected.x()) * 2), sample::toString);
+        assertEquals(expected.y(), actual.position().y(), Math.max(.000001F, Math.ulp(expected.y()) * 2), sample::toString);
+        assertEquals(expected.z(), actual.position().z(), Math.max(.000001F, Math.ulp(expected.z()) * 2), sample::toString);
+    }
+
+    private static Vector vector(final JsonArray value) {
+        return new Vector(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+
+    private static CameraRaycast.Box box(final JsonArray value) {
+        return new CameraRaycast.Box(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat(),
+                value.get(3).getAsFloat(), value.get(4).getAsFloat(), value.get(5).getAsFloat());
+    }
+
+    private static Cell cell(final JsonArray value) {
+        return new Cell(value.get(0).getAsInt(), value.get(1).getAsInt(), value.get(2).getAsInt());
+    }
+
+    private record Query(boolean extra, Cell cell) {
+    }
+
+    private record Cell(int x, int y, int z) {
+    }
+
+}
