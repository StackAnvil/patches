+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.LongFunction;
+
+/** Maintains all free-camera instances independently of the active rendered perspective. */
+public final class CameraTrackingRuntime {
+
+    private final Map<Long, Instance> instances = new HashMap<>();
+    private CameraTrackingState state;
+    private CameraSplineState pendingSpline;
+    private long appliedSpline = -1;
+    private UUID lifetime;
+
+    public void accept(final CameraSplineState next) {
+        if (next.sequence() <= this.appliedSpline || this.pendingSpline != null && next.sequence() <= this.pendingSpline.sequence()
+                || this.state != null && next.epoch() < this.state.epoch()) {
+            return;
+        }
+        this.pendingSpline = next;
+        this.applySpline();
+    }
+
+    private void applySpline() {
+        if (this.state == null || this.pendingSpline == null || this.pendingSpline.epoch() != this.state.epoch() || this.pendingSpline.sequence() <= this.appliedSpline) {
+            return;
+        }
+        final var program = this.pendingSpline.program();
+        final var curve = program == null ? null : new CameraSplinePlayback.Curve(program.linear(), program.points());
+        final Map<Instance, CameraSplinePlayback> replacements = new HashMap<>();
+        try {
+            for (final Instance instance : this.instances.values()) {
+                replacements.put(instance, program == null ? null
+                        : this.pendingSpline.live() && instance.spline != null ? instance.spline.replace(program, curve, this.pendingSpline.elapsed())
+                        : new CameraSplinePlayback(program, curve, this.pendingSpline.elapsed()));
+            }
+        } catch (final IllegalArgumentException exception) {
+            // Reject an incomplete or oversized composition without partially changing instances.
+            this.appliedSpline = this.pendingSpline.sequence();
+            this.pendingSpline = null;
+            return;
+        }
+        replacements.forEach((instance, playback) -> instance.spline = playback);
+        this.appliedSpline = this.pendingSpline.sequence();
+        this.pendingSpline = null;
+    }
+
+    public void accept(final CameraTrackingState next) {
+        if (this.state != null && next.sequence() <= this.state.sequence()) {
+            return;
+        }
+        if (this.state == null || this.state.epoch() != next.epoch()) {
+            this.instances.clear();
+            if (this.pendingSpline != null && this.pendingSpline.epoch() < next.epoch()) {
+                this.pendingSpline = null;
+            }
+        }
+        final boolean newTarget = this.state == null || this.state.targetSequence() != next.targetSequence();
+        if (newTarget) {
+            this.lifetime = null;
+        }
+        final var ids = new HashSet<Long>();
+        next.presets().forEach(p -> ids.add(p.id()));
+        this.instances.keySet().retainAll(ids);
+        for (final var preset : next.presets()) {
+            final Instance instance = this.instances.computeIfAbsent(preset.id(), id -> new Instance(preset));
+            if (!instance.preset.equals(preset)) {
+                if (instance.preset.positionSequence() != preset.positionSequence()
+                        || !instance.preset.position().equals(preset.position())) {
+                    instance.position = preset.position();
+                }
+                if (instance.tracker == null && (instance.preset.rotationSequence() != preset.rotationSequence()
+                        || instance.preset.pitch() != preset.pitch() || instance.preset.yaw() != preset.yaw())) {
+                    instance.orientation = orientation(preset);
+                }
+                instance.preset = preset;
+            }
+            if (newTarget) {
+                if (next.target() == null) {
+                    if (instance.tracker != null) {
+                        instance.orientation = instance.tracker.stoppedOrientation();
+                    }
+                    instance.tracker = null;
+                } else {
+                    instance.tracker = new CameraTargetTracker(preset.settings(), instance.orientation);
+                }
+            }
+        }
+        this.state = next;
+        this.applySpline();
+    }
+
+    public void advance(final float delta, final LongFunction<Actor> actors) {
+        if (this.state == null) {
+            return;
+        }
+        final Actor actor = this.state.target() == null ? null : actors.apply(this.state.target().actorUniqueId());
+        if (actor != null && this.lifetime == null) {
+            this.lifetime = actor.lifetime;
+        }
+        final var sample = actor != null && actor.lifetime.equals(this.lifetime) ? actor.sample : null;
+        for (final Instance instance : this.instances.values()) {
+            if (instance.tracker != null) {
+                instance.orientation = instance.tracker.advance(delta, instance.position, sample, this.state.target().offset());
+            }
+            if (instance.spline != null) {
+                final var frame = instance.spline.advance(delta);
+                if (frame == null) {
+                    instance.spline = null;
+                } else {
+                    instance.position = frame.position();
+                    instance.orientation = frame.orientation();
+                }
+            }
+        }
+    }
+
+    public CameraPose active(final long positionSequence, final float fov, final int renderingMode) {
+        if (this.state == null || this.state.positionSequence() != positionSequence) {
+            return null;
+        }
+        final Instance instance = this.instances.get(this.state.activePreset());
+        return instance == null ? null : new CameraPose(instance.position, instance.orientation, fov, renderingMode);
+    }
+
+    public void clear() {
+        this.instances.clear();
+        this.state = null;
+        this.pendingSpline = null;
+        this.appliedSpline = -1;
+        this.lifetime = null;
+    }
+
+    private static Quaternion orientation(final CameraTrackingState.Preset preset) {
+        return CameraPose.fromDegrees(Vector.ZERO, preset.pitch(), preset.yaw(), 0, 0).orientation();
+    }
+
+    public record Actor(UUID lifetime, CameraTargetTracker.Sample sample) {
+        public Actor {
+            if (lifetime == null || sample == null) {
+                throw new IllegalArgumentException("Invalid camera target actor");
+            }
+        }
+    }
+
+    private static final class Instance {
+        private CameraTrackingState.Preset preset;
+        private Vector position;
+        private Quaternion orientation;
+        private CameraTargetTracker tracker;
+        private CameraSplinePlayback spline;
+
+        private Instance(final CameraTrackingState.Preset preset) {
+            this.preset = preset;
+            this.position = preset.position();
+            this.orientation = orientation(preset);
+        }
+    }
+
+}
