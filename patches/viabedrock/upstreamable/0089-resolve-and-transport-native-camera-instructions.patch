+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraAvoidanceTest {
+
+    @Test
+    void minimumCanExpandTargetBelowItsBoundary() {
+        final var avoidance = new CameraAvoidance(CameraAvoidance.Settings.followOrbit(), new CameraAvoidance.State(10, 0));
+        final Vector target = new Vector(.1F, 0, 0);
+        assertVector(new Vector(.25F, 0, 0), avoidance.advance(.05F, Vector.ZERO, target, .1F, .1F, false, null, (start, end) -> null));
+        final var calls = new AtomicInteger();
+        final Vector stopped = avoidance.advance(.05F, Vector.ZERO, target, .1F, .1F, false, null, (start, end) -> {
+            calls.incrementAndGet();
+            return Vector.ZERO;
+        });
+        assertEquals(8, calls.get());
+        assertEquals(.25F, stopped.x(), .000001F);
+        assertEquals(.25F, avoidance.state().radius());
+    }
+
+    @Test
+    void feelerWeightsAccumulateOnlyWhenTheClosestHitImproves() {
+        final var rays = List.of(new CameraAvoidance.Ray(.15F, .25F), new CameraAvoidance.Ray(.5F, .75F));
+        final var avoidance = new CameraAvoidance(new CameraAvoidance.Settings(0, .25F, rays, List.of()), new CameraAvoidance.State(10, 0));
+        final var calls = new AtomicInteger();
+        final Vector result = avoidance.advance(.05F, Vector.ZERO, new Vector(10, 0, 0), 10F, .1F, false, null, (start, end) -> {
+            final int index = calls.getAndIncrement();
+            if (index != 8 && index != 9) {
+                return null;
+            }
+            final float scale = index == 8 ? .4F : .2F;
+            return new Vector(end.x() * scale, end.y() * scale, end.z() * scale);
+        });
+        assertEquals(12, calls.get());
+        assertEquals(7, avoidance.state().radius(), .00001F);
+        assertVector(new Vector(7, 0, 0), result);
+    }
+
+    @Test
+    void cornerHitsContractBeforeSpringRelaxationAndAnOverrideCanDisableTheSpring() {
+        final var avoidance = new CameraAvoidance(new CameraAvoidance.Settings(4, .25F, List.of(), List.of()), new CameraAvoidance.State(10, 3));
+        final Vector target = new Vector(10, 0, 0);
+        final Vector collision = avoidance.advance(0, Vector.ZERO, target, 10F, .1F, false, null, (start, end) -> new Vector(4, 0, 0));
+        assertEquals(3.9F, collision.x(), .000001F);
+        assertEquals(0, avoidance.state().velocity());
+        final Vector relaxing = avoidance.advance(.05F, Vector.ZERO, target, 10F, .1F, false, null, (start, end) -> null);
+        assertTrue(relaxing.x() > collision.x() && relaxing.x() < target.x());
+        final var beforeCollapse = avoidance.state();
+        assertVector(Vector.ZERO, avoidance.advance(.05F, Vector.ZERO, target, 10F, .1F, true, null, (start, end) -> {
+            fail();
+            return null;
+        }));
+        assertEquals(beforeCollapse, avoidance.state());
+        assertVector(target, avoidance.advance(.05F, Vector.ZERO, target, 10F, .1F, false, 0F, (start, end) -> null));
+        assertEquals(0, avoidance.state().velocity());
+    }
+
+    @Test
+    void nativeUpdaterMatchesEveryQueryAndChainedState() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_AVOIDANCE");
+        assumeTrue(source != null);
+        final var sequences = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("sequences");
+        for (final var element : sequences) {
+            final var sequence = element.getAsJsonObject();
+            final var avoidance = new CameraAvoidance(new CameraAvoidance.Settings(sequence.get("spring").getAsFloat(), .25F,
+                    rays(sequence.getAsJsonArray("yawRays")), rays(sequence.getAsJsonArray("pitchRays"))),
+                    new CameraAvoidance.State(sequence.get("initialRadius").getAsFloat(), 0));
+            final Float override = sequence.get("override").isJsonNull() ? null : sequence.get("override").getAsFloat();
+            for (final var frameElement : sequence.getAsJsonArray("frames")) {
+                final var frame = frameElement.getAsJsonObject();
+                final var queries = frame.getAsJsonArray("queries");
+                final var calls = new AtomicInteger();
+                final Float maximum = sequence.get("fixedBoom").getAsBoolean() ? null : frame.get("radius").getAsFloat();
+                final Vector observed = avoidance.advance(frame.get("delta").getAsFloat(), vector(frame.getAsJsonArray("pivot")),
+                        vector(frame.getAsJsonArray("target")), maximum, frame.get("margin").getAsFloat(), sequence.get("collapse").getAsBoolean(), override,
+                        (start, end) -> {
+                            final var query = queries.get(calls.getAndIncrement()).getAsJsonObject();
+                            assertVector(vector(query.getAsJsonArray("start")), start);
+                            assertVector(vector(query.getAsJsonArray("end")), end);
+                            return query.get("hit").isJsonNull() ? null : vector(query.getAsJsonArray("hit"));
+                        });
+                assertEquals(queries.size(), calls.get());
+                assertVector(vector(frame.getAsJsonArray("position")), observed);
+                final var state = frame.getAsJsonObject("state");
+                assertEquals(state.get("radius").getAsFloat(), avoidance.state().radius(), .00003F);
+                assertEquals(state.get("velocity").getAsFloat(), avoidance.state().velocity(), .00003F);
+            }
+        }
+    }
+
+    private static List<CameraAvoidance.Ray> rays(final JsonArray array) {
+        final var rays = new ArrayList<CameraAvoidance.Ray>();
+        for (final var element : array) {
+            final var pair = element.getAsJsonArray();
+            rays.add(new CameraAvoidance.Ray(pair.get(0).getAsFloat(), pair.get(1).getAsFloat()));
+        }
+        return rays;
+    }
+
+    private static Vector vector(final JsonArray value) {
+        return new Vector(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+
+    private static void assertVector(final Vector expected, final Vector actual) {
+        assertEquals(expected.x(), actual.x(), .00003F);
+        assertEquals(expected.y(), actual.y(), .00003F);
+        assertEquals(expected.z(), actual.z(), .00003F);
+    }
+
+}
