new file mode 100644
index 000000000..9e8ce42df
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/CameraSplineState.java
@@ -0,0 +1,112 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram.Keyframe;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** A spline command belongs to one preset epoch and does not select a camera. */
+public record CameraSplineState(long sequence, long epoch, float elapsed, boolean live, CameraSplineProgram program) {
+
+    public static final String CHANNEL = "viabedrock:camera_spline_v2";
+    public static final Type<CameraSplineState> TYPE = new Type<>(CameraSplineState.class) {
+        @Override
+        public CameraSplineState read(final ByteBuf b) {
+            if (b.readableBytes() > 1 << 20 || Types.VAR_INT.readPrimitive(b) != 2) {
+                throw new IllegalArgumentException("Unsupported camera spline state");
+            }
+            final long sequence = b.readLong();
+            final long epoch = b.readLong();
+            final float elapsed = b.readFloat();
+            final boolean live = b.readBoolean();
+            final CameraSplineProgram program;
+            if (b.readBoolean()) {
+                final float duration = b.readFloat();
+                final boolean linear = b.readBoolean();
+                final List<Vector> points = new ArrayList<>();
+                final int count = count(b);
+                for (int i = 0; i < count; i++) {
+                    points.add(vector(b));
+                }
+                program = new CameraSplineProgram(duration, linear, points, frames(b), frames(b));
+            } else {
+                program = null;
+            }
+            if (b.isReadable()) {
+                throw new IllegalArgumentException("Trailing camera spline fields");
+            }
+            return new CameraSplineState(sequence, epoch, elapsed, live, program);
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraSplineState s) {
+            Types.VAR_INT.writePrimitive(b, 2);
+            b.writeLong(s.sequence).writeLong(s.epoch).writeFloat(s.elapsed).writeBoolean(s.live).writeBoolean(s.program != null);
+            if (s.program != null) {
+                b.writeFloat(s.program.duration()).writeBoolean(s.program.linear());
+                Types.VAR_INT.writePrimitive(b, s.program.points().size());
+                for (final Vector point : s.program.points()) {
+                    vector(b, point);
+                }
+                frames(b, s.program.progress());
+                frames(b, s.program.rotations());
+            }
+        }
+    };
+
+    public CameraSplineState {
+        if (sequence < 0 || epoch < 0 || !Float.isFinite(elapsed) || elapsed < 0
+                || !live && program != null && (program.progress().isEmpty() || program.rotations().isEmpty())) {
+            throw new IllegalArgumentException("Invalid camera spline state");
+        }
+    }
+
+    private static int count(final ByteBuf b) {
+        final int count = Types.VAR_INT.readPrimitive(b);
+        if (count < 0 || count > CameraSplineProgram.MAX_ENTRIES) {
+            throw new IllegalArgumentException("Invalid camera spline entry count");
+        }
+        return count;
+    }
+
+    private static List<Keyframe> frames(final ByteBuf b) {
+        final List<Keyframe> frames = new ArrayList<>();
+        final int count = count(b);
+        for (int i = 0; i < count; i++) {
+            final Vector value = vector(b);
+            final float time = b.readFloat();
+            final int ease = b.readUnsignedByte();
+            if (ease >= CameraEase.values().length) {
+                throw new IllegalArgumentException("Invalid camera spline easing");
+            }
+            frames.add(new Keyframe(value, time, CameraEase.values()[ease]));
+        }
+        return frames;
+    }
+
+    private static void frames(final ByteBuf b, final List<Keyframe> frames) {
+        Types.VAR_INT.writePrimitive(b, frames.size());
+        for (final Keyframe frame : frames) {
+            vector(b, frame.value());
+            b.writeFloat(frame.time()).writeByte(frame.ease().ordinal());
+        }
+    }
+
+    private static Vector vector(final ByteBuf b) {
+        return new Vector(b.readFloat(), b.readFloat(), b.readFloat());
+    }
+
+    private static void vector(final ByteBuf b, final Vector v) {
+        b.writeFloat(v.x()).writeFloat(v.y()).writeFloat(v.z());
+    }
+
+}
