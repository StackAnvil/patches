+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.model.CameraSplineProgram;
+
+import java.util.List;
+
+/** Named definitions replace the table atomically. The first exact name match wins. */
+public record CameraSplineRegistry(List<CameraSplineDefinition> definitions) {
+
+    public static final CameraSplineRegistry EMPTY = new CameraSplineRegistry(List.of());
+
+    public CameraSplineRegistry {
+        definitions = List.copyOf(definitions);
+        if (definitions.size() > CameraSplineDefinition.MAX_ENTRIES) {
+            throw new IllegalArgumentException("Too many camera spline definitions");
+        }
+    }
+
+    public CameraSplineProgram resolve(final CameraInstruction.Spline instruction) {
+        if (!instruction.loadFromJson()) {
+            return instruction.compile();
+        }
+        for (final CameraSplineDefinition definition : this.definitions) {
+            if (definition.name().equals(instruction.identifier())) {
+                return definition.compile();
+            }
+        }
+        throw new IllegalArgumentException("Unresolved named camera spline " + instruction.identifier());
+    }
+
+}
