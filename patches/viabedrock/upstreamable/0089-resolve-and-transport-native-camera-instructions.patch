+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraFollowState;
+import net.raphimc.viabedrock.api.model.CameraTrackingState;
+import net.raphimc.viabedrock.api.model.CameraTargetTracker;
+
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraPositionState.Mode;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Preset instances retain instruction overrides independently of the active camera. */
+public final class CameraPositionController {
+
+    private final Map<Long, Overrides> overrides = new HashMap<>();
+    private final Map<Long, Long> positionSequences = new HashMap<>();
+    private final Map<Long, Long> rotationSequences = new HashMap<>();
+    private CameraPositionState state = CameraPositionState.EMPTY;
+    private CameraPresetRegistry registry = CameraPresetRegistry.EMPTY;
+    private long activePreset = -1;
+    private long trackingSequence;
+    private long targetSequence;
+    private long attachmentSequence;
+    private Long attachment;
+    private long epoch;
+    private CameraTrackingState.Target target;
+
+    public CameraTrackingState tracking() {
+        final var presets = new ArrayList<CameraTrackingState.Preset>();
+        for (int i = 0; i < this.registry.presets().size(); i++) {
+            final var resolved = this.registry.get(i);
+            if (resolved == null || resolved.base() != CameraPresetRegistry.Base.FREE) {
+                continue;
+            }
+            final CameraPreset p = resolved.preset();
+            final Overrides override = this.overrides.getOrDefault((long) i, Overrides.EMPTY);
+            final CameraPose.Vector position = override.position != null ? override.position
+                    : new CameraPose.Vector(value(p.posX()), value(p.posY()), value(p.posZ()));
+            final var rotation = override.rotation != null ? override.rotation : new CameraInstruction.Vec2(value(p.rotX()), value(p.rotY()));
+            final var horizontal = p.horizontalRotationLimit() != null ? p.horizontalRotationLimit() : new CameraInstruction.Vec2(0, 360);
+            final var vertical = p.verticalRotationLimit() != null ? p.verticalRotationLimit() : new CameraInstruction.Vec2(0, 180);
+            presets.add(new CameraTrackingState.Preset(i, this.positionSequences.getOrDefault((long) i, 0L), this.rotationSequences.getOrDefault((long) i, 0L), position, rotation.x(), rotation.y(),
+                    new CameraTargetTracker.Settings(value(p.rotationSpeed()), Boolean.TRUE.equals(p.snapToTarget()), horizontal.x(), horizontal.y(),
+                            vertical.x(), vertical.y(), Boolean.TRUE.equals(p.continueTargeting()), p.trackingRadius() == null ? 50 : p.trackingRadius())));
+        }
+        return new CameraTrackingState(this.trackingSequence, this.epoch, this.state.sequence(), this.activePreset, this.targetSequence, this.target, presets);
+    }
+
+    public CameraFollowState follow(final float playerOriginOffset) {
+        final var presets = new ArrayList<CameraFollowState.Preset>();
+        long active = -1;
+        for (int i = 0; i < this.registry.presets().size(); i++) {
+            final var resolved = this.registry.get(i);
+            if (resolved == null || resolved.base() != CameraPresetRegistry.Base.FOLLOW_ORBIT) {
+                continue;
+            }
+            final var p = resolved.preset();
+            final var override = this.overrides.getOrDefault((long) i, Overrides.EMPTY);
+            final var rotation = override.rotation != null ? override.rotation : followRotation(p);
+            final var view = override.viewOffset != null ? override.viewOffset : p.viewOffset();
+            final var offset = override.entityOffset != null ? override.entityOffset : p.entityOffset();
+            presets.add(new CameraFollowState.Preset(i, this.rotationSequences.getOrDefault((long) i, 0L), p.radius() == null ? 10 : p.radius(),
+                    rotation.x(), rotation.y(), view == null ? 0 : view.x(), view == null ? 0 : view.y(),
+                    offset == null ? CameraPose.Vector.ZERO : vector(offset), p.minYawLimit() == null ? -180 : p.minYawLimit(), p.maxYawLimit() == null ? 180 : p.maxYawLimit()));
+            if (this.activePreset == i) {
+                active = i;
+            }
+        }
+        return new CameraFollowState(this.trackingSequence, this.epoch, this.state.sequence(), active, this.attachmentSequence,
+                this.attachment, playerOriginOffset, presets);
+    }
+
+    public CameraPositionState state() {
+        return this.state;
+    }
+
+    public void resetPresets(final CameraPresetRegistry registry) {
+        this.overrides.clear();
+        this.positionSequences.clear();
+        this.rotationSequences.clear();
+        this.registry = registry;
+        this.target = null;
+        this.targetSequence++;
+        this.attachment = null;
+        this.attachmentSequence++;
+        this.epoch++;
+        this.trackingSequence++;
+    }
+
+    public boolean apply(final CameraInstruction instruction, final CameraPresetRegistry registry) {
+        this.registry = registry;
+        final var action = instruction.action();
+        if (action == CameraInstruction.Action.SET) {
+            final CameraInstruction.SetCamera set = instruction.set();
+            final CameraPresetRegistry.Resolved resolved = registry.get(set.preset());
+            if (resolved == null) {
+                throw new IllegalArgumentException(
+                        "Unresolved camera preset index " + set.preset());
+            }
+            final Mode mode =
+                switch (resolved.base()) {
+                    case FIRST_PERSON -> Mode.FIRST_PERSON;
+                    case THIRD_PERSON -> Mode.THIRD_PERSON;
+                    case THIRD_PERSON_FRONT -> Mode.THIRD_PERSON_FRONT;
+                    case FREE -> Mode.FREE;
+                    case FOLLOW_ORBIT -> Mode.FOLLOW_ORBIT;
+                    default ->
+                            throw new IllegalArgumentException(
+                                    "Unsupported camera base " + resolved.base());
+                };
+            final CameraPreset preset = resolved.preset();
+            Overrides values = this.overrides.getOrDefault(set.preset(), Overrides.EMPTY);
+            if (set.position() != null) {
+                values = new Overrides(vector(set.position()), values.rotation, values.viewOffset, values.entityOffset);
+            }
+            if (set.rotation() != null) {
+                values = new Overrides(values.position, set.rotation(), values.viewOffset, values.entityOffset);
+            }
+            if (set.viewOffset() != null) {
+                values = new Overrides(values.position, values.rotation, set.viewOffset(), values.entityOffset);
+            }
+            if (set.entityOffset() != null) {
+                values = new Overrides(values.position, values.rotation, values.viewOffset, set.entityOffset());
+            }
+            final CameraPose.Vector defaultPosition =
+                    new CameraPose.Vector(
+                            value(preset.posX()), value(preset.posY()), value(preset.posZ()));
+            final CameraInstruction.Vec2 defaultRotation =
+                    mode == Mode.FOLLOW_ORBIT ? followRotation(preset) : new CameraInstruction.Vec2(value(preset.rotX()), value(preset.rotY()));
+            if (set.facing() != null) {
+                final CameraPose.Vector from =
+                        values.position != null ? values.position : defaultPosition;
+                final CameraInstruction.Vec2 previous =
+                        values.rotation != null ? values.rotation : defaultRotation;
+                final CameraPose.Vector delta = vector(set.facing()).subtract(from);
+                final float horizontalSquared = delta.x() * delta.x() + delta.z() * delta.z();
+                final float horizontal = (float) Math.sqrt(horizontalSquared);
+                final float yaw =
+                        horizontal >= .01F
+                                ? -(float) Math.atan2(delta.x(), delta.z()) * 57.295776F
+                                : previous.y();
+                final float pitch =
+                        horizontalSquared + delta.y() * delta.y() >= .0001F
+                                ? -(float) Math.atan2(delta.y(), horizontal) * 57.295776F
+                                : previous.x();
+                values = new Overrides(values.position, new CameraInstruction.Vec2(pitch, yaw), values.viewOffset, values.entityOffset);
+            }
+            if (Boolean.TRUE.equals(set.defaults())) {
+                values = Overrides.EMPTY;
+            }
+            final CameraPose.Vector position =
+                    values.position != null ? values.position : defaultPosition;
+            final CameraInstruction.Vec2 rotation =
+                    values.rotation != null ? values.rotation : defaultRotation;
+            final float duration = set.ease() != null ? set.ease().duration() : 0;
+            final int easing = set.ease() != null ? set.ease().type() : 0;
+            if (easing < 0 || easing >= CameraEase.values().length) {
+                throw new IllegalArgumentException("Unsupported camera ease " + easing);
+            }
+            final CameraPositionState next =
+                    new CameraPositionState(
+                            this.state.sequence() + 1,
+                            0,
+                            true,
+                            mode,
+                            position,
+                            rotation.x(),
+                            rotation.y(),
+                            duration,
+                            CameraEase.values()[easing],
+                            preset.playerEffects() != null
+                                    ? preset.playerEffects()
+                                    : mode != Mode.FREE,
+                            Integer.valueOf(1).equals(preset.audioListener()));
+            this.overrides.put(set.preset(), values);
+            if (set.position() != null || Boolean.TRUE.equals(set.defaults())) {
+                this.positionSequences.merge(set.preset(), 1L, Long::sum);
+            }
+            if (set.rotation() != null || set.facing() != null || Boolean.TRUE.equals(set.defaults())) {
+                this.rotationSequences.merge(set.preset(), 1L, Long::sum);
+            }
+            this.state = next;
+            this.activePreset = set.preset();
+            this.trackingSequence++;
+            return true;
+        }
+        if (action == CameraInstruction.Action.ATTACH || action == CameraInstruction.Action.DETACH) {
+            this.attachment = action == CameraInstruction.Action.ATTACH ? instruction.attachToEntity() : null;
+            this.attachmentSequence++;
+            this.trackingSequence++;
+            return false;
+        }
+        if (action == CameraInstruction.Action.REMOVE_TARGET) {
+            this.target = null;
+            this.targetSequence++;
+            this.trackingSequence++;
+            return false;
+        }
+        if (action == CameraInstruction.Action.TARGET) {
+            final var requested = instruction.target();
+            final var offset = requested.centerOffset() != null ? vector(requested.centerOffset())
+                    : this.target != null ? this.target.offset() : CameraPose.Vector.ZERO;
+            this.target = new CameraTrackingState.Target(requested.actorUniqueId(), offset);
+            this.targetSequence++;
+            this.trackingSequence++;
+            return false;
+        }
+        if (action == CameraInstruction.Action.CLEAR) {
+            this.attachment = null;
+            this.attachmentSequence++;
+            this.target = null;
+            this.targetSequence++;
+            this.activePreset = -1;
+            this.trackingSequence++;
+            this.state =
+                    new CameraPositionState(
+                            this.state.sequence() + 1,
+                            0,
+                            true,
+                            Mode.LOCAL,
+                            CameraPose.Vector.ZERO,
+                            0,
+                            0,
+                            0,
+                            CameraEase.LINEAR,
+                            true,
+                            false);
+            return true;
+        }
+        return false;
+    }
+
+    private static float value(final Float value) {
+        return value == null ? 0 : value;
+    }
+
+    private static CameraPose.Vector vector(final CameraInstruction.Vec3 v) {
+        return new CameraPose.Vector(v.x(), v.y(), v.z());
+    }
+
+    private static CameraInstruction.Vec2 followRotation(final CameraPreset p) {
+        return p.startingRotation() != null ? p.startingRotation() : new CameraInstruction.Vec2(45, 45);
+    }
+
+    private record Overrides(CameraPose.Vector position, CameraInstruction.Vec2 rotation, CameraInstruction.Vec2 viewOffset, CameraInstruction.Vec3 entityOffset) {
+
+        private static final Overrides EMPTY = new Overrides(null, null, null, null);
+    }
+
+}
