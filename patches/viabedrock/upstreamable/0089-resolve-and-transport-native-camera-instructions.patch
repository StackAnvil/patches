+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraTargetTracker.Settings;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Complete preset identities and target commands; rendered rotations remain client-owned. */
+public record CameraTrackingState(long sequence, long epoch, long positionSequence, long activePreset,
+                                  long targetSequence, Target target, List<Preset> presets) {
+
+    public static final String CHANNEL = "viabedrock:camera_tracking";
+    public static final int MAX_PRESETS = 4096;
+    public static final Type<CameraTrackingState> TYPE = new Type<>(CameraTrackingState.class) {
+        @Override
+        public CameraTrackingState read(final ByteBuf b) {
+            if (b.readableBytes() > 1 << 20 || Types.VAR_INT.readPrimitive(b) != 1) {
+                throw new IllegalArgumentException("Unsupported camera tracking state");
+            }
+            final long sequence = b.readLong();
+            final long epoch = b.readLong();
+            final long positionSequence = b.readLong();
+            final long activePreset = b.readLong();
+            final long targetSequence = b.readLong();
+            final Target target = b.readBoolean() ? new Target(b.readLong(), vector(b)) : null;
+            final int count = Types.VAR_INT.readPrimitive(b);
+            if (count < 0 || count > MAX_PRESETS) {
+                throw new IllegalArgumentException("Invalid camera tracking preset count");
+            }
+            final List<Preset> presets = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                presets.add(new Preset(b.readLong(), b.readLong(), vector(b), b.readFloat(), b.readFloat(),
+                        new Settings(b.readFloat(), b.readBoolean(), b.readFloat(), b.readFloat(), b.readFloat(), b.readFloat(), b.readBoolean(), b.readFloat())));
+            }
+            if (b.isReadable()) {
+                throw new IllegalArgumentException("Trailing camera tracking fields");
+            }
+            return new CameraTrackingState(sequence, epoch, positionSequence, activePreset, targetSequence, target, presets);
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraTrackingState s) {
+            Types.VAR_INT.writePrimitive(b, 1);
+            b.writeLong(s.sequence).writeLong(s.epoch).writeLong(s.positionSequence).writeLong(s.activePreset).writeLong(s.targetSequence);
+            b.writeBoolean(s.target != null);
+            if (s.target != null) {
+                b.writeLong(s.target.actorUniqueId);
+                vector(b, s.target.offset);
+            }
+            Types.VAR_INT.writePrimitive(b, s.presets.size());
+            for (final Preset p : s.presets) {
+                b.writeLong(p.id).writeLong(p.rotationSequence);
+                vector(b, p.position);
+                b.writeFloat(p.pitch).writeFloat(p.yaw);
+                final Settings v = p.settings;
+                b.writeFloat(v.speed()).writeBoolean(v.snap()).writeFloat(v.left()).writeFloat(v.right()).writeFloat(v.down()).writeFloat(v.up())
+                        .writeBoolean(v.continuing()).writeFloat(v.radius());
+            }
+        }
+    };
+
+    public CameraTrackingState {
+        if (sequence < 0 || epoch < 0 || positionSequence < 0 || activePreset < -1 || targetSequence < 0 || presets.size() > MAX_PRESETS) {
+            throw new IllegalArgumentException("Invalid camera tracking state");
+        }
+        presets = List.copyOf(presets);
+        final Set<Long> ids = new HashSet<>();
+        for (final Preset preset : presets) {
+            if (!ids.add(preset.id)) {
+                throw new IllegalArgumentException("Duplicate tracking preset");
+            }
+        }
+    }
+
+    private static Vector vector(final ByteBuf b) {
+        return new Vector(b.readFloat(), b.readFloat(), b.readFloat());
+    }
+
+    private static void vector(final ByteBuf b, final Vector v) {
+        b.writeFloat(v.x()).writeFloat(v.y()).writeFloat(v.z());
+    }
+
+    public record Target(long actorUniqueId, Vector offset) {
+        public Target {
+            if (offset == null) {
+                throw new IllegalArgumentException("Missing target offset");
+            }
+        }
+    }
+
+    public record Preset(long id, long rotationSequence, Vector position, float pitch, float yaw, Settings settings) {
+        public Preset {
+            if (id < 0 || rotationSequence < 0 || position == null || !Float.isFinite(pitch) || !Float.isFinite(yaw) || settings == null) {
+                throw new IllegalArgumentException("Invalid tracking preset");
+            }
+        }
+    }
+
+}
