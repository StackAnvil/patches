+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Compiled spline channels. Rotation values use radians, as in native playback. */
+public record CameraSplineProgram(float duration, boolean linear, List<Vector> points,
+                                  List<Keyframe> progress, List<Keyframe> rotations) {
+
+    public static final int MAX_ENTRIES = 4096;
+
+    public CameraSplineProgram {
+        points = List.copyOf(points);
+        progress = List.copyOf(progress);
+        rotations = List.copyOf(rotations);
+        if (!Float.isFinite(duration) || duration < 0 || points.size() < (linear ? 3 : 4)
+                || points.size() > MAX_ENTRIES || progress.size() > MAX_ENTRIES
+                || rotations.size() > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Invalid camera spline program");
+        }
+    }
+
+    /** Running requests retain their channels when a new curve and duration arrive. */
+    public CameraSplineProgram withPreviousChannels(final CameraSplineProgram previous) {
+        if (previous == null) {
+            return this;
+        }
+        return new CameraSplineProgram(this.duration, this.linear, this.points,
+                append(previous.progress, this.progress), append(previous.rotations, this.rotations));
+    }
+
+    private static List<Keyframe> append(final List<Keyframe> previous, final List<Keyframe> next) {
+        if (previous.size() + next.size() > MAX_ENTRIES) {
+            throw new IllegalArgumentException("Too many retained camera spline keyframes");
+        }
+        final List<Keyframe> result = new ArrayList<>(previous.size() + next.size());
+        result.addAll(previous);
+        result.addAll(next);
+        return result;
+    }
+
+    public record Keyframe(Vector value, float time, CameraEase ease) {
+        public Keyframe {
+            if (value == null || !Float.isFinite(time) || ease == null) {
+                throw new IllegalArgumentException("Invalid camera spline keyframe");
+            }
+        }
+    }
+
+}
