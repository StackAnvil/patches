+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+
+/** A resolved FOV transition and, for live delivery, the command that changed it. */
+public record CameraFovState(long sequence, float elapsed, Transition transition, Command command) {
+
+    public static final String CHANNEL = "viabedrock:camera_fov";
+    public static final float DEGREES_TO_RADIANS = .017453292F;
+    public static final Type<CameraFovState> TYPE = new Type<>(CameraFovState.class) {
+        @Override
+        public CameraFovState read(final ByteBuf b) {
+            if (Types.VAR_INT.readPrimitive(b) != 1) {
+                throw new IllegalArgumentException("Unsupported camera FOV payload version");
+            }
+            final long sequence = b.readLong();
+            final float elapsed = b.readFloat();
+            final Transition transition = new Transition(b.readBoolean(), b.readBoolean(), b.readBoolean(),
+                    readValue(b), readValue(b), readValue(b), b.readFloat(), b.readFloat(), readEase(b));
+            final Command command = b.readBoolean() ? new Command(b.readFloat(), b.readFloat(), readEase(b), b.readBoolean()) : null;
+            if (b.isReadable()) {
+                throw new IllegalArgumentException("Unexpected camera FOV payload fields");
+            }
+            return new CameraFovState(sequence, elapsed, transition, command);
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraFovState state) {
+            Types.VAR_INT.writePrimitive(b, 1);
+            b.writeLong(state.sequence).writeFloat(state.elapsed);
+            final Transition t = state.transition;
+            b.writeBoolean(t.active).writeBoolean(t.easing).writeBoolean(t.clear);
+            writeValue(b, t.start);
+            writeValue(b, t.target);
+            writeValue(b, t.current);
+            b.writeFloat(t.progress).writeFloat(t.duration);
+            Types.VAR_INT.writePrimitive(b, t.ease.ordinal());
+            b.writeBoolean(state.command != null);
+            if (state.command != null) {
+                b.writeFloat(state.command.value).writeFloat(state.command.duration);
+                Types.VAR_INT.writePrimitive(b, state.command.ease.ordinal());
+                b.writeBoolean(state.command.clear);
+            }
+        }
+    };
+
+    public CameraFovState {
+        if (sequence < 0 || !Float.isFinite(elapsed) || elapsed < 0 || transition == null) {
+            throw new IllegalArgumentException("Invalid camera FOV state");
+        }
+    }
+
+    private static CameraEase readEase(final ByteBuf b) {
+        final int ordinal = Types.VAR_INT.readPrimitive(b);
+        if (ordinal < 0 || ordinal >= CameraEase.values().length) {
+            throw new IllegalArgumentException("Invalid camera easing function");
+        }
+        return CameraEase.values()[ordinal];
+    }
+
+    private static Value readValue(final ByteBuf b) {
+        return new Value(b.readFloat(), b.readFloat());
+    }
+
+    private static void writeValue(final ByteBuf b, final Value value) {
+        b.writeFloat(value.localFactor).writeFloat(value.radians);
+    }
+
+    /** Core retains the unresolved local projection, without substituting a fixed FOV. */
+    public record Value(float localFactor, float radians) {
+        public static final Value LOCAL = new Value(1, 0);
+
+        public Value {
+            if (!Float.isFinite(localFactor) || !Float.isFinite(radians)) {
+                throw new IllegalArgumentException("Invalid camera FOV value");
+            }
+        }
+
+        public static Value constant(final float radians) {
+            return new Value(0, radians);
+        }
+
+        public float resolve(final float localRadians) {
+            return this.localFactor * localRadians + this.radians;
+        }
+
+        public Value resolveLocal(final float localRadians) {
+            return constant(this.resolve(localRadians));
+        }
+
+        public Value interpolate(final Value target, final float factor) {
+            return new Value((target.localFactor - this.localFactor) * factor + this.localFactor,
+                    (target.radians - this.radians) * factor + this.radians);
+        }
+    }
+
+    public record Command(float value, float duration, CameraEase ease, boolean clear) {
+        public Command {
+            if (!Float.isFinite(value) || !Float.isFinite(duration) || ease == null) {
+                throw new IllegalArgumentException("Invalid camera FOV command");
+            }
+            value = Math.clamp(value, 30, 110);
+        }
+    }
+
+    public record Transition(boolean active, boolean easing, boolean clear, Value start, Value target,
+                             Value current, float progress, float duration, CameraEase ease) {
+        public static final Transition EMPTY = new Transition(false, false, false, Value.LOCAL,
+                Value.LOCAL, Value.LOCAL, 0, 0, CameraEase.LINEAR);
+
+        public Transition {
+            if (start == null || target == null || current == null || ease == null
+                    || !Float.isFinite(progress) || progress < 0 || progress > 1
+                    || !Float.isFinite(duration)) {
+                throw new IllegalArgumentException("Invalid camera FOV transition");
+            }
+        }
+
+        public Transition resolveLocal(final float localRadians) {
+            return new Transition(this.active, this.easing, this.clear, this.start.resolveLocal(localRadians),
+                    this.target.resolveLocal(localRadians), this.current.resolveLocal(localRadians),
+                    this.progress, this.duration, this.ease);
+        }
+    }
+
+}
