+package net.raphimc.viabedrock.api.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import com.google.gson.JsonArray;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+class CameraAudioListenerTest {
+
+    @Test
+    void playerBasisMatchesNativeListenerUpdater() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_LISTENER");
+        assumeTrue(source != null);
+        final var cases = com.google.gson.JsonParser.parseString(Files.readString(Path.of(source)))
+                .getAsJsonObject().getAsJsonArray("cases");
+        int checked = 0;
+        for (final var row : cases) {
+            final var sample = row.getAsJsonObject();
+            if (!sample.get("playerListener").getAsBoolean()) {
+                continue;
+            }
+            final var expected = sample.getAsJsonObject("observed");
+            final var listener = CameraAudioListener.player(vector(expected.getAsJsonArray("position")),
+                    sample.get("pitch").getAsFloat(), sample.get("yaw").getAsFloat());
+            assertVector(expected.getAsJsonArray("forward"), listener.forward());
+            assertVector(expected.getAsJsonArray("up"), listener.up());
+            checked++;
+        }
+        assertEquals(18, checked);
+    }
+
+    private static CameraPose.Vector vector(final JsonArray array) {
+        return new CameraPose.Vector(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+
+    private static void assertVector(final JsonArray expected, final CameraPose.Vector actual) {
+        assertEquals(expected.get(0).getAsFloat(), actual.x(), .000001F);
+        assertEquals(expected.get(1).getAsFloat(), actual.y(), .000001F);
+        assertEquals(expected.get(2).getAsFloat(), actual.z(), .000001F);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/CameraAvoidanceTest.java b/src/test/java/net/raphimc/viabedrock/api/model/CameraAvoidanceTest.java
