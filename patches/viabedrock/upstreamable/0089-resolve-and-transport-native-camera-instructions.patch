@@ -0,0 +1,171 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.List;
+import java.util.Objects;
+
+/** Native camera avoidance. The caller supplies world ray results and the resolved camera pivot. */
+public final class CameraAvoidance {
+
+    private final Settings settings;
+    private State state;
+
+    public CameraAvoidance(final Settings settings, final State state) {
+        this.settings = Objects.requireNonNull(settings);
+        this.state = Objects.requireNonNull(state);
+    }
+
+    public State state() {
+        return this.state;
+    }
+
+    /**
+     * A null orbit radius uses the measured camera distance, as the fixed-boom cache does.
+     * Angular feelers require a nonzero pivot-to-camera direction.
+     */
+    public Vector advance(final float delta, final Vector pivot, final Vector camera, final Float orbitRadius,
+                          final float clearance, final boolean collapseToPivot, final Float springOverride, final Raycast raycast) {
+        finite(delta, clearance);
+        if (delta < 0 || clearance < 0 || orbitRadius != null && (!Float.isFinite(orbitRadius) || orbitRadius < 0)
+                || springOverride != null && (!Float.isFinite(springOverride) || springOverride < 0)) {
+            throw new IllegalArgumentException("Invalid camera avoidance frame");
+        }
+        if (collapseToPivot) {
+            return pivot;
+        }
+        final Vector direction = camera.subtract(pivot);
+        final float measured = length(direction);
+        final float maximum = orbitRadius != null ? orbitRadius : measured;
+        float closest = Float.MAX_VALUE;
+        for (int i = 0; i < 8; i++) {
+            final Vector start = new Vector(((i & 1) * 2 - 1) * .1F + pivot.x(), ((i & 2) - 1) * .1F + pivot.y(),
+                    (((i >> 1) & 2) - 1) * .1F + pivot.z());
+            final Vector hit = raycast.cast(start, direction.add(start));
+            if (hit != null) {
+                final float distance = length(pivot.subtract(hit)) - clearance;
+                closest = Math.min(closest, Math.max(clearance, distance));
+            }
+        }
+        final float constrained = this.constrain(maximum, closest);
+        float radius = this.state.radius;
+        float velocity = this.state.velocity;
+        if (constrained < radius) {
+            radius = constrained;
+            velocity = 0;
+        }
+        float requested = constrained;
+        if (!this.settings.horizontal.isEmpty() || !this.settings.vertical.isEmpty()) {
+            if (measured == 0) {
+                throw new IllegalArgumentException("Camera feelers require a nonzero direction");
+            }
+            final float yaw = (float) Math.atan2(direction.z(), direction.x());
+            final float polar = (float) Math.acos(direction.y() / measured);
+            requested = Math.min(requested, this.feelers(this.settings.horizontal, yaw, polar, constrained, pivot, raycast, true, 1));
+            requested = Math.min(requested, this.feelers(this.settings.horizontal, yaw, polar, constrained, pivot, raycast, true, -1));
+            requested = Math.min(requested, this.feelers(this.settings.vertical, yaw, polar, constrained, pivot, raycast, false, -1));
+            requested = Math.min(requested, this.feelers(this.settings.vertical, yaw, polar, constrained, pivot, raycast, false, 1));
+        }
+        requested = this.constrain(constrained, requested);
+        final float spring = springOverride != null ? springOverride : this.settings.spring;
+        if (spring == 0) {
+            radius = requested;
+            velocity = 0;
+        } else {
+            final float error = radius - requested;
+            final float scaled = error * spring;
+            final float sum = velocity + scaled;
+            final float exponent = -spring * delta;
+            final float decay = (float) Math.exp(exponent);
+            radius = (delta * sum + error) * decay + requested;
+            velocity = ((exponent * sum + sum) - scaled) * decay;
+        }
+        this.state = new State(radius, velocity);
+        if (measured > 0 && Math.abs(measured - radius) > Math.ulp(1F)) {
+            return new Vector(direction.x() * radius / measured + pivot.x(), direction.y() * radius / measured + pivot.y(),
+                    direction.z() * radius / measured + pivot.z());
+        }
+        return camera;
+    }
+
+    private float constrain(final float maximum, final float distance) {
+        // Native tests the raw distance before applying the minimum, including equality at the boundary.
+        return maximum < distance ? maximum : Math.max(distance, this.settings.minimum);
+    }
+
+    private float feelers(final List<Ray> rays, final float yaw, final float polar, final float radius,
+                          final Vector pivot, final Raycast raycast, final boolean horizontal, final int sign) {
+        float closest = radius;
+        float weighted = radius;
+        for (final Ray ray : rays) {
+            final float azimuth = horizontal ? yaw + sign * ray.angle : yaw;
+            final float inclination = horizontal ? polar : polar + sign * ray.angle;
+            final float sine = (float) Math.sin(inclination);
+            final Vector end = new Vector((float) Math.cos(azimuth) * radius * sine + pivot.x(),
+                    (float) Math.cos(inclination) * radius + pivot.y(), (float) Math.sin(azimuth) * radius * sine + pivot.z());
+            final Vector hit = raycast.cast(pivot, end);
+            final float distance = hit != null ? length(hit.subtract(pivot)) : Float.MAX_VALUE;
+            if (distance < Float.MAX_VALUE && distance < closest) {
+                weighted -= (closest - distance) * ray.weight;
+                closest = distance;
+            }
+        }
+        return weighted;
+    }
+
+    private static float length(final Vector value) {
+        return (float) Math.sqrt(value.x() * value.x() + value.y() * value.y() + value.z() * value.z());
+    }
+
+    private static void finite(final float... values) {
+        for (final float value : values) {
+            if (!Float.isFinite(value)) {
+                throw new IllegalArgumentException("Non-finite camera avoidance value");
+            }
+        }
+    }
+
+    /** Angles are radians. Native applies weights only when a ray beats the previous closest distance. */
+    public record Ray(float angle, float weight) {
+        public Ray {
+            finite(angle, weight);
+        }
+    }
+
+    public record Settings(float spring, float minimum, List<Ray> horizontal, List<Ray> vertical) {
+        public Settings {
+            finite(spring, minimum);
+            if (spring < 0 || minimum < 0) {
+                throw new IllegalArgumentException("Invalid camera avoidance settings");
+            }
+            horizontal = List.copyOf(horizontal);
+            vertical = List.copyOf(vertical);
+        }
+
+        /** The pinned follow_orbit definition overrides the native constructor's spring and minimum. */
+        public static Settings followOrbit() {
+            return new Settings(0, .25F, List.of(), List.of());
+        }
+    }
+
+    public record State(float radius, float velocity) {
+        public State {
+            finite(radius, velocity);
+            if (radius < 0) {
+                throw new IllegalArgumentException("Invalid camera avoidance radius");
+            }
+        }
+    }
+
+    @FunctionalInterface
+    public interface Raycast {
+        /** Returns the world hit position, or null for a miss. */
+        Vector cast(Vector start, Vector end);
+    }
+
+}
