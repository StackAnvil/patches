+package net.raphimc.viabedrock.protocol.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec2;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec3;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraPresetTest {
+
+    @Test
+    void optionalFieldsAndUnknownNumericEnumsSurviveWireRoundtrip() {
+        final var full = full("example:full", "minecraft:free");
+        final var empty = empty("minecraft:free", "");
+        final var buffer = Unpooled.buffer();
+        try {
+            final var expected = List.of(full, empty);
+            CameraPreset.LIST_TYPE.write(buffer, expected);
+            assertEquals(expected, CameraPreset.LIST_TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void inheritanceResolvesForwardParentsAndPreservesWireIndexes() {
+        final var child = empty("example:child", "example:parent");
+        final var parent = full("example:parent", "minecraft:free");
+        final var registry = new CameraPresetRegistry(List.of(child, parent, empty("minecraft:free", "")));
+        final var inherited = registry.get(0).preset();
+        assertEquals(CameraPresetRegistry.Base.FREE, registry.get(0).base());
+        assertEquals(child.name(), inherited.name());
+        assertEquals(child.parent(), inherited.parent());
+        assertEquals(parent.posX(), inherited.posX());
+        assertEquals(parent.posY(), inherited.posY());
+        assertEquals(parent.posZ(), inherited.posZ());
+        assertEquals(parent.rotX(), inherited.rotX());
+        assertEquals(parent.rotY(), inherited.rotY());
+        assertEquals(parent.rotationSpeed(), inherited.rotationSpeed());
+        assertEquals(parent.snapToTarget(), inherited.snapToTarget());
+        assertEquals(parent.horizontalRotationLimit(), inherited.horizontalRotationLimit());
+        assertEquals(parent.verticalRotationLimit(), inherited.verticalRotationLimit());
+        assertEquals(parent.continueTargeting(), inherited.continueTargeting());
+        assertEquals(parent.trackingRadius(), inherited.trackingRadius());
+        assertEquals(parent.viewOffset(), inherited.viewOffset());
+        assertEquals(parent.entityOffset(), inherited.entityOffset());
+        assertEquals(parent.radius(), inherited.radius());
+        assertEquals(parent.minYawLimit(), inherited.minYawLimit());
+        assertEquals(parent.maxYawLimit(), inherited.maxYawLimit());
+        assertEquals(parent.audioListener(), inherited.audioListener());
+        assertEquals(parent.playerEffects(), inherited.playerEffects());
+        assertEquals(parent.aimAssist(), inherited.aimAssist());
+        assertEquals(parent.controlScheme(), inherited.controlScheme());
+        assertEquals(child.applyInheritedStartingRotation(), inherited.applyInheritedStartingRotation());
+        assertNull(inherited.startingRotation());
+        assertTrue(registry.unresolved().isEmpty());
+        assertNull(registry.get(-1));
+        assertNull(registry.get(0xFFFFFFFFL));
+        assertNull(registry.get(3));
+    }
+
+    @Test
+    void childFalseZeroAndWholeAimAssistObjectOverrideAncestors() {
+        final var parent = full("example:parent", "minecraft:free");
+        final var aim = new CameraPreset.AimAssist(null, null, null, null);
+        final var child = new CameraPreset("example:child", parent.name(), 0F, null, null, null, null,
+                0F, false, null, null, false, 0F, null, null, 0F, null, null,
+                0, false, aim, 0, true, new Vec2(5, 6));
+        final var registry = new CameraPresetRegistry(List.of(child, parent, empty("minecraft:free", "")));
+        final var resolved = registry.get(0).preset();
+        assertEquals(0F, resolved.posX());
+        assertEquals(parent.posY(), resolved.posY());
+        assertEquals(0F, resolved.rotationSpeed());
+        assertEquals(false, resolved.snapToTarget());
+        assertEquals(false, resolved.continueTargeting());
+        assertEquals(0F, resolved.trackingRadius());
+        assertEquals(0F, resolved.radius());
+        assertEquals(0, resolved.audioListener());
+        assertEquals(false, resolved.playerEffects());
+        assertEquals(aim, resolved.aimAssist());
+        assertEquals(0, resolved.controlScheme());
+        assertTrue(resolved.applyInheritedStartingRotation());
+        assertEquals(child.startingRotation(), resolved.startingRotation());
+    }
+
+    @Test
+    void brokenDependenciesDoNotShiftValidIndexesOrInventFreeCameras() {
+        final var registry = new CameraPresetRegistry(List.of(empty("example:a", "example:b"),
+                empty("minecraft:free", ""), empty("example:b", "example:a"),
+                empty("example:missing", "example:absent"), empty("example:root", ""),
+                empty("example:child", "example:root")));
+        assertEquals(CameraPresetRegistry.Base.FREE, registry.get(1).base());
+        assertEquals(5, registry.unresolved().size());
+        for (final int index : new int[]{0, 2, 3, 4, 5}) {
+            assertNull(registry.get(index));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new CameraPresetRegistry(
+                List.of(empty("minecraft:free", ""), empty("minecraft:free", ""))));
+    }
+
+    @Test
+    void maximumDepthResolvesWithoutRecursiveStackGrowth() {
+        final List<CameraPreset> presets = new ArrayList<>();
+        for (int i = 0; i < CameraPreset.MAX_PRESETS - 1; i++) {
+            presets.add(empty("example:" + i, i == CameraPreset.MAX_PRESETS - 2 ? "minecraft:free" : "example:" + (i + 1)));
+        }
+        presets.add(full("minecraft:free", ""));
+        final var registry = new CameraPresetRegistry(presets);
+        assertEquals(CameraPresetRegistry.Base.FREE, registry.get(0).base());
+        assertEquals(presets.getLast().posY(), registry.get(0).preset().posY());
+        assertTrue(registry.unresolved().isEmpty());
+    }
+
+    @Test
+    void rejectsOversizedCountsBeforeAllocating() {
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> CameraPreset.LIST_TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void independentNativeAndServerFixturesConsumeEveryFieldAndPreserveBytes() throws Exception {
+        final String fixtures = System.getenv("STACKANVIL_NATIVE_CAMERA_PRESETS");
+        assumeTrue(fixtures != null);
+        int count = 0;
+        for (final String source : fixtures.split(java.io.File.pathSeparator)) {
+            final byte[] bytes = Files.readAllBytes(Path.of(source));
+            final var input = Unpooled.wrappedBuffer(bytes);
+            final var output = Unpooled.buffer();
+            try {
+                final var presets = CameraPreset.LIST_TYPE.read(input);
+                assertFalse(input.isReadable());
+                assertTrue(new CameraPresetRegistry(presets).unresolved().isEmpty());
+                CameraPreset.LIST_TYPE.write(output, presets);
+                final byte[] encoded = new byte[output.readableBytes()];
+                output.readBytes(encoded);
+                assertArrayEquals(bytes, encoded);
+                count++;
+            } finally {
+                input.release();
+                output.release();
+            }
+        }
+        assertTrue(count >= 3, "Supply local, CubeCraft, and custom inheritance fixtures");
+    }
+
+    private static CameraPreset empty(final String name, final String parent) {
+        return new CameraPreset(name, parent, null, null, null, null, null, null, null,
+                null, null, null, null, null, null, null, null, null, null, null,
+                null, null, false, null);
+    }
+
+    private static CameraPreset full(final String name, final String parent) {
+        return new CameraPreset(name, parent, -3.5F, 80F, 5F, 15F, -170F, .75F, true,
+                new Vec2(-180, 180), new Vec2(-90, 90), true, 50F, new Vec2(1, 2),
+                new Vec3(3, 4, 5), 10F, -170F, 170F, 255, true,
+                new CameraPreset.AimAssist("example:assist", Integer.MIN_VALUE, new Vec2(30, 40), 5F),
+                255, true, new Vec2(25, 35));
+    }
+
+}
