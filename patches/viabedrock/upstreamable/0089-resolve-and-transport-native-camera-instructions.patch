+            controller.apply(set(0, null, null, null), registry);
+            controller.apply(new CameraInstruction(null, null, null, new CameraInstruction.Target(null, 8), null, null, null, null, null), registry);
+            final var spline = new CameraInstruction.Spline(1, 0, List.of(), List.of(), List.of(), "", false);
+            final var instruction = new CameraInstruction(sample.get("set").getAsBoolean() ? set(0, null, null, null).set() : null,
+                    optionalBoolean(sample, "clear"), null, sample.get("target").getAsBoolean() ? new CameraInstruction.Target(null, 9) : null,
+                    optionalBoolean(sample, "remove"), sample.get("fov").getAsBoolean() ? new CameraInstruction.FieldOfView(30, 0, "linear", false) : null,
+                    sample.get("spline").getAsBoolean() ? spline : null, sample.get("attach").getAsBoolean() ? -8L : null, optionalBoolean(sample, "detach"));
+            final var action = CameraInstruction.Action.valueOf(sample.get("observed").getAsString());
+            assertEquals(action, instruction.action());
+            assertEquals(action == CameraInstruction.Action.SET || action == CameraInstruction.Action.CLEAR, controller.apply(instruction, registry));
+            assertEquals(action == CameraInstruction.Action.CLEAR ? CameraPositionState.Mode.LOCAL : CameraPositionState.Mode.FREE, controller.state().mode());
+            if (action == CameraInstruction.Action.REMOVE_TARGET || action == CameraInstruction.Action.CLEAR) {
