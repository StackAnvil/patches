index 000000000..5dcfb3b0b
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/CameraSplinePlaybackTest.java
@@ -0,0 +1,175 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraSplineProgram.Keyframe;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.ArrayList;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraSplinePlaybackTest {
+
+    @Test
+    void earlierFrameEasingAndChordLengthsDetermineProgress() {
+        final var playback = new CameraSplinePlayback(program(), 0);
+        assertEquals(2.5F, playback.advance(.5F).position().x(), .00001F);
+        assertEquals(10, playback.advance(.5F).position().x(), .00001F);
+        assertNull(playback.advance(.01F));
+        assertThrows(IllegalArgumentException.class, () -> playback.advance(Float.NaN));
+        assertThrows(IllegalArgumentException.class, () -> new CameraSplinePlayback.Curve(true, List.of(Vector.ZERO, Vector.ZERO, Vector.ZERO)));
+    }
+
+    @Test
+    void arithmeticOverflowRetiresPlaybackBeforeAnInvalidPoseReachesRendering() {
+        final var base = program();
+        final var program = new CameraSplineProgram(base.duration(), base.linear(), base.points(),
+                List.of(new Keyframe(Vector.ZERO, 0, CameraEase.LINEAR),
+                        new Keyframe(new Vector(Float.MAX_VALUE, 0, 0), 1, CameraEase.LINEAR)), base.rotations());
+        final var playback = new CameraSplinePlayback(program, 0);
+        assertEquals(Vector.ZERO, playback.advance(0).position());
+        assertNull(playback.advance(1));
+        assertNull(playback.advance(0));
+    }
+
+    @Test
+    void splineCommandsAdvanceInactiveFreeInstancesWithoutSelectingThem() {
+        final var runtime = new CameraTrackingRuntime();
+        final var presets = List.of(preset(0), preset(1));
+        runtime.accept(new CameraSplineState(1, 2, 0, false, program()));
+        runtime.accept(new CameraTrackingState(1, 2, 1, -1, 0, null, presets));
+        runtime.advance(.25F, id -> null);
+        assertNull(runtime.active(1, 70, 4));
+        runtime.advance(.25F, id -> null);
+        runtime.accept(new CameraTrackingState(2, 2, 2, 1, 0, null, presets));
+        assertEquals(2.5F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.advance(.6F, id -> null);
+        assertEquals(2.5F, runtime.active(2, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraTrackingState(3, 2, 3, 0, 0, null, presets));
+        assertEquals(2.5F, runtime.active(3, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraSplineState(2, 2, 0, false, program()));
+        runtime.advance(0, id -> null);
+        assertEquals(0, runtime.active(3, 70, 4).position().x());
+        runtime.accept(new CameraSplineState(1, 2, .5F, false, program()));
+        runtime.advance(.5F, id -> null);
+        assertEquals(2.5F, runtime.active(3, 70, 4).position().x(), .00001F);
+        runtime.accept(new CameraTrackingState(4, 3, 4, 0, 0, null, presets));
+        runtime.advance(1, id -> null);
+        assertEquals(90, runtime.active(4, 70, 4).position().x());
+        runtime.clear();
+        assertNull(runtime.active(4, 70, 4));
+    }
+
+    @Test
+    void splineTransportPreservesCompiledChannelsAndRejectsTrailingData() {
+        final var state = new CameraSplineState(4, 2, .5F, false, program());
+        final var buffer = Unpooled.buffer();
+        try {
+            CameraSplineState.TYPE.write(buffer, state);
+            assertEquals(state, CameraSplineState.TYPE.read(buffer));
+            CameraSplineState.TYPE.write(buffer.clear(), state);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> CameraSplineState.TYPE.read(buffer));
+            CameraSplineState.TYPE.write(buffer.clear(), new CameraSplineState(5, 2, 0, false, null));
+            assertNull(CameraSplineState.TYPE.read(buffer).program());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void targetBuildFactoriesAndVirtualCurveEvaluatorsMatch() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SPLINE_CURVES");
+        assumeTrue(source != null);
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+        for (final var row : fixture.getAsJsonArray("validity")) {
+            final var sample = row.getAsJsonObject();
+            final var points = points(sample.getAsJsonArray("points"));
+            if (sample.get("valid").getAsBoolean()) {
+                assertDoesNotThrow(() -> new CameraSplinePlayback.Curve(sample.get("type").getAsInt() == 1, points));
+            } else {
+                assertThrows(IllegalArgumentException.class, () -> new CameraSplinePlayback.Curve(sample.get("type").getAsInt() == 1, points));
+            }
+        }
+        final var cases = fixture.getAsJsonArray("cases");
+        for (final var row : cases) {
+            final var sample = row.getAsJsonObject();
+            final var curve = new CameraSplinePlayback.Curve(sample.get("type").getAsInt() == 1, points(sample.getAsJsonArray("points")));
+            assertVector(vector(sample.getAsJsonArray("position")), curve.evaluate(sample.get("progress").getAsFloat()));
+        }
+        assertEquals(220, cases.size());
+    }
+
+    @Test
+    void targetBuildInstructionCompilationAndPlaybackMatchFinalCameraPose() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_SPLINE_PLAYBACK");
+        assumeTrue(source != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        for (final var row : cases) {
+            final var sample = row.getAsJsonObject();
+            final List<CameraInstruction.Progress> progress = new ArrayList<>();
+            for (final var item : sample.getAsJsonArray("progress")) {
+                final var f = item.getAsJsonArray();
+                progress.add(new CameraInstruction.Progress(f.get(0).getAsFloat(), f.get(1).getAsFloat(), CameraEase.values()[f.get(2).getAsInt()].name()));
+            }
+            final List<CameraInstruction.Rotation> rotations = new ArrayList<>();
+            for (final var item : sample.getAsJsonArray("rotation")) {
+                final var f = item.getAsJsonArray();
+                rotations.add(new CameraInstruction.Rotation(new CameraInstruction.Vec3(f.get(0).getAsFloat(),
+                        f.get(1).getAsFloat(), f.get(2).getAsFloat()), f.get(3).getAsFloat(), CameraEase.values()[f.get(4).getAsInt()].name()));
+            }
+            final var program = new CameraInstruction.Spline(sample.get("duration").getAsFloat(), sample.get("type").getAsInt(),
+                    points(sample.getAsJsonArray("points")).stream().map(v -> new CameraInstruction.Vec3(v.x(), v.y(), v.z())).toList(),
+                    progress, rotations, "", false).compile();
+            final var observed = new CameraSplinePlayback(program, 0).advance(sample.get("elapsed").getAsFloat());
+            assertVector(vector(sample.getAsJsonArray("position")), observed.position());
+            final var q = sample.getAsJsonArray("orientation");
+            assertEquals(q.get(0).getAsFloat(), observed.orientation().x(), .000001F);
+            assertEquals(q.get(1).getAsFloat(), observed.orientation().y(), .000001F);
+            assertEquals(q.get(2).getAsFloat(), observed.orientation().z(), .000001F);
+            assertEquals(q.get(3).getAsFloat(), observed.orientation().w(), .000001F);
+        }
+        assertEquals(84, cases.size());
+    }
+
+    private static CameraSplineProgram program() {
+        return new CameraSplineProgram(1, true, List.of(Vector.ZERO, new Vector(1, 0, 0), new Vector(10, 0, 0)),
+                List.of(new Keyframe(Vector.ZERO, 0, CameraEase.IN_QUAD), new Keyframe(new Vector(1, 0, 0), 1, CameraEase.OUT_QUAD)),
+                List.of(new Keyframe(Vector.ZERO, 0, CameraEase.LINEAR)));
+    }
+
+    private static CameraTrackingState.Preset preset(final long id) {
+        return new CameraTrackingState.Preset(id, 0, 0, new Vector(90, 0, 0), 0, 0,
+                new CameraTargetTracker.Settings(0, false, 0, 360, 0, 180, false, 50));
+    }
+
+    private static List<Vector> points(final JsonArray values) {
+        final List<Vector> result = new ArrayList<>();
+        values.forEach(value -> result.add(vector(value.getAsJsonArray())));
+        return result;
+    }
+
+    private static Vector vector(final JsonArray values) {
+        return new Vector(values.get(0).getAsFloat(), values.get(1).getAsFloat(), values.get(2).getAsFloat());
+    }
+
+    private static void assertVector(final Vector expected, final Vector actual) {
+        assertEquals(expected.x(), actual.x(), Math.max(.00002F, Math.ulp(expected.x()) * 4));
+        assertEquals(expected.y(), actual.y(), Math.max(.00002F, Math.ulp(expected.y()) * 4));
+        assertEquals(expected.z(), actual.z(), Math.max(.00002F, Math.ulp(expected.z()) * 4));
+    }
+
+}
