+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CameraPose.Quaternion;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraTargetTrackerTest {
+
+    @Test
+    void tracksWithinRadiusAndReturnsToInitialOutsideIt() {
+        final Quaternion initial = CameraPose.fromDegrees(Vector.ZERO, 0, 0, 1, 4).orientation();
+        final var tracker = new CameraTargetTracker(settings(0, false, false, 50), initial);
+        final var atBoundary = tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(50, 0, 0), 0F), Vector.ZERO);
+        assertOrientation(CameraPose.fromDegrees(Vector.ZERO, 0, -90, 1, 4).orientation(), atBoundary);
+        assertOrientation(initial, tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(50.01F, 0, 0), 0F), Vector.ZERO));
+        assertFalse(tracker.removed());
+        assertOrientation(atBoundary, tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(50, 0, 0), 0F), Vector.ZERO));
+    }
+
+    @Test
+    void degenerateDirectionsUseTheInitialAnglesInsteadOfThePreviousTarget() {
+        final var initial = CameraPose.fromDegrees(Vector.ZERO, 15, 0, 1, 4).orientation();
+        final var tracker = new CameraTargetTracker(settings(0, false, true, 50), initial);
+        tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F), Vector.ZERO);
+        assertOrientation(CameraPose.fromDegrees(Vector.ZERO, -90, 0, 1, 4).orientation(),
+                tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(0, 10, 0), 0F), Vector.ZERO));
+        assertOrientation(initial, tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(Vector.ZERO, 0F), Vector.ZERO));
+    }
+
+    @Test
+    void missingBeforeAcquisitionWaitsAndMissingAfterAcquisitionRetiresTarget() {
+        final Quaternion initial = CameraPose.fromDegrees(Vector.ZERO, 0, 0, 1, 4).orientation();
+        final var tracker = new CameraTargetTracker(settings(30, false, true, 50), initial);
+        assertEquals(initial, tracker.advance(.1F, Vector.ZERO, null, Vector.ZERO));
+        assertFalse(tracker.removed());
+        final var rotated = tracker.advance(.1F, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F), Vector.ZERO);
+        assertNotEquals(initial, rotated);
+        assertEquals(rotated, tracker.advance(.1F, Vector.ZERO, null, Vector.ZERO));
+        assertTrue(tracker.removed());
+        assertEquals(rotated, tracker.advance(1, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(-10, 0, 0), 0F), Vector.ZERO));
+    }
+
+    @Test
+    void maximumDistanceRemovalDoesNotReacquireReplacement() {
+        final Quaternion initial = CameraPose.fromDegrees(Vector.ZERO, 0, 0, 1, 4).orientation();
+        final var tracker = new CameraTargetTracker(settings(0, false, true, 2000), initial);
+        tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(1024, 0, 0), 0F), Vector.ZERO);
+        assertFalse(tracker.removed());
+        final var last = tracker.orientation();
+        assertEquals(last, tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(1024.01F, 0, 0), 0F), Vector.ZERO));
+        assertTrue(tracker.removed());
+    }
+
+    @Test
+    void snappingRearmsAfterLeavingTheTrackingRadius() {
+        final Quaternion initial = CameraPose.fromDegrees(Vector.ZERO, 0, 0, 1, 4).orientation();
+        final var tracker = new CameraTargetTracker(settings(1, true, false, 50), initial);
+        final var facingEast = CameraPose.fromDegrees(Vector.ZERO, 0, -90, 1, 4).orientation();
+        assertOrientation(facingEast, tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(10, 0, 0), 0F), Vector.ZERO));
+        final var gradual = tracker.advance(.1F, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(-10, 0, 0), 0F), Vector.ZERO);
+        assertTrue(Math.abs(gradual.y() * facingEast.y() + gradual.w() * facingEast.w()) > .999F);
+        tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(-100, 0, 0), 0F), Vector.ZERO);
+        assertOrientation(CameraPose.fromDegrees(Vector.ZERO, 0, 90, 1, 4).orientation(),
+                tracker.advance(0, Vector.ZERO, new CameraTargetTracker.Sample(new Vector(-10, 0, 0), 0F), Vector.ZERO));
+    }
+
+    @Test
+    void nativeAngularStepSamplesMatchTargetExecutable() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_TRACKING_ROTATION");
+        assumeTrue(source != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        int checked = 0;
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final Vector initial = vector(row.getAsJsonArray("initial"));
+            final var initialQ = row.getAsJsonArray("initialQuaternion");
+            Quaternion current = new Quaternion(initialQ.get(0).getAsFloat(), initialQ.get(1).getAsFloat(), initialQ.get(2).getAsFloat(), initialQ.get(3).getAsFloat());
+            final var target = row.getAsJsonArray("target");
+            final Quaternion destination = row.get("outside").getAsBoolean() && !row.get("continuing").getAsBoolean()
+                    ? Quaternion.fromAngles(initial) : Quaternion.fromAngles(new Vector(target.get(0).getAsFloat(), target.get(1).getAsFloat(), 0));
+            for (final var step : row.getAsJsonArray("samples")) {
+                final var sample = step.getAsJsonObject();
+                current = CameraTargetTracker.turn(current, destination, sample.get("delta").getAsFloat() * row.get("rate").getAsFloat() * CameraPose.DEGREES);
+                final var q = sample.getAsJsonArray("quaternion");
+                assertOrientation(new Quaternion(q.get(0).getAsFloat(), q.get(1).getAsFloat(), q.get(2).getAsFloat(), q.get(3).getAsFloat()), current);
+                checked++;
+            }
+        }
+        assertEquals(960, checked);
+    }
+
+    @Test
+    void nativeTrackingSequencesMatchInitializationLimitsAndSnapExecution() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_TRACKING");
+        assumeTrue(source != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        int checked = 0;
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final var v = row.getAsJsonObject("settings");
+            final var settings = new CameraTargetTracker.Settings(v.get("speed").getAsFloat(), v.get("snap").getAsBoolean(),
+                    v.get("left").getAsFloat(), v.get("right").getAsFloat(), v.get("down").getAsFloat(), v.get("up").getAsFloat(),
+                    v.get("continuing").getAsBoolean(), v.get("radius").getAsFloat());
+            final var q = row.getAsJsonArray("initialQuaternion");
+            final var tracker = new CameraTargetTracker(settings, new Quaternion(q.get(0).getAsFloat(), q.get(1).getAsFloat(), q.get(2).getAsFloat(), q.get(3).getAsFloat()));
+            for (final var step : row.getAsJsonArray("samples")) {
+                final var sample = step.getAsJsonObject();
+                final var actual = tracker.advance(sample.get("delta").getAsFloat(), Vector.ZERO,
+                        new CameraTargetTracker.Sample(vector(sample.getAsJsonArray("center")), 0F), Vector.ZERO);
+                final var expected = sample.getAsJsonArray("quaternion");
+                try {
+                    assertOrientation(new Quaternion(expected.get(0).getAsFloat(), expected.get(1).getAsFloat(), expected.get(2).getAsFloat(), expected.get(3).getAsFloat()), actual);
+                } catch (final AssertionError error) {
+                    throw new AssertionError("Native tracking sample " + checked + " settings " + settings, error);
+                }
+                checked++;
+            }
+        }
+        assertEquals(160, checked);
+    }
+
+    private static CameraTargetTracker.Settings settings(final float speed, final boolean snap, final boolean continuing, final float radius) {
+        return new CameraTargetTracker.Settings(speed, snap, 0, 360, 0, 180, continuing, radius);
+    }
+
+    private static Vector vector(final JsonArray a) {
+        return new Vector(a.get(0).getAsFloat(), a.get(1).getAsFloat(), a.get(2).getAsFloat());
+    }
+
+    private static void assertOrientation(final Quaternion expected, final Quaternion actual) {
+        final float sign = expected.x() * actual.x() + expected.y() * actual.y() + expected.z() * actual.z() + expected.w() * actual.w() < 0 ? -1 : 1;
+        assertEquals(expected.x(), actual.x() * sign, .00002F);
+        assertEquals(expected.y(), actual.y() * sign, .00002F);
+        assertEquals(expected.z(), actual.z() * sign, .00002F);
+        assertEquals(expected.w(), actual.w() * sign, .00002F);
+    }
+
+}
