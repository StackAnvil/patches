+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonObject;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraFollowRuntimeTest {
+
+    private static final CameraFollowRuntime.World AIR = new CameraFollowRuntime.World() {
+        @Override
+        public boolean insideSolidBlock(final Vector origin) {
+            return false;
+        }
+
+        @Override
+        public Vector cast(final Vector start, final Vector end) {
+            return null;
+        }
+    };
+
+    @Test
+    void attachmentsDoNotAcquireReusedIdentityWithoutNewGeneration() {
+        final var runtime = new CameraFollowRuntime();
+        final var preset = preset(0, 0, 10);
+        final var first = actor(UUID.randomUUID(), 0);
+        runtime.accept(state(1, 1, 0, 1, 9L, List.of(preset)));
+        runtime.advance(.05F, null, id -> first, AIR);
+        final var initial = runtime.active(1, 66, 5);
+        assertEquals(10, initial.position().x(), .00001F);
+        assertEquals(.9F, initial.position().y(), .00001F);
+        final var replacement = actor(UUID.randomUUID(), 20);
+        runtime.advance(.05F, null, id -> replacement, AIR);
+        assertEquals(initial, runtime.active(1, 66, 5));
+        runtime.accept(state(2, 1, 0, 2, 9L, List.of(preset)));
+        runtime.advance(.05F, null, id -> replacement, AIR);
+        assertEquals(30, runtime.active(1, 66, 5).position().x(), .00001F);
+        assertNull(runtime.active(0, 66, 5));
+        runtime.clear();
+        assertNull(runtime.active(1, 66, 5));
+    }
+
+    @Test
+    void inputAndExplicitRotationRevisionsRetainIndependentPresetInstances() {
+        final var runtime = new CameraFollowRuntime();
+        final var presets = List.of(preset(0, 0, 10), preset(1, 0, 5));
+        final var player = actor(UUID.randomUUID(), 0);
+        runtime.accept(state(1, 1, 0, 0, null, presets));
+        assertTrue(runtime.input(1, 0, 90));
+        runtime.advance(.05F, player, id -> null, AIR);
+        assertEquals(10, runtime.active(1, 66, 5).position().z(), .00001F);
+        runtime.accept(state(2, 2, 1, 0, null, presets));
+        runtime.advance(.05F, player, id -> null, AIR);
+        assertEquals(5, runtime.active(2, 66, 5).position().x(), .00001F);
+        runtime.accept(state(3, 3, 0, 0, null, presets));
+        runtime.advance(.05F, player, id -> null, AIR);
+        assertEquals(10, runtime.active(3, 66, 5).position().z(), .00001F);
+        runtime.accept(state(4, 4, 0, 0, null, List.of(preset(0, 1, 10), presets.get(1))));
+        runtime.advance(.05F, player, id -> null, AIR);
+        assertEquals(10, runtime.active(4, 66, 5).position().x(), .00001F);
+        assertFalse(runtime.input(3, 0, 45));
+        runtime.accept(state(2, 2, 1, 0, null, presets));
+        assertNotNull(runtime.active(4, 66, 5));
+    }
+
+    @Test
+    void avoidanceClipsTheRenderedPoseAndReleasesAfterTheObstacleDisappears() {
+        final var runtime = new CameraFollowRuntime();
+        final var player = actor(UUID.randomUUID(), 0);
+        runtime.accept(state(1, 1, 0, 0, null, List.of(preset(0, 0, 10))));
+        final var wall = new CameraFollowRuntime.World() {
+            @Override
+            public boolean insideSolidBlock(final Vector origin) {
+                assertEquals(1.62F, origin.y());
+                return false;
+            }
+
+            @Override
+            public Vector cast(final Vector start, final Vector end) {
+                final var hit = new CameraRaycast.Box(4, 0, -1, 5, 3, 1).intersect(4, 0, 0, start, end);
+                return hit != null ? hit.position() : null;
+            }
+        };
+        runtime.advance(.05F, player, id -> null, wall);
+        final var clipped = runtime.active(1, 66, 5);
+        assertTrue(clipped.position().x() > 3.9F && clipped.position().x() < 4);
+        runtime.advance(.05F, player, id -> null, AIR);
+        final var clear = runtime.active(1, 66, 5);
+        assertEquals(10, clear.position().x(), .00001F);
+        assertEquals(clear.orientation(), clipped.orientation());
+        runtime.advance(.05F, player, id -> null, new CameraFollowRuntime.World() {
+            @Override
+            public boolean insideSolidBlock(final Vector origin) {
+                return true;
+            }
+
+            @Override
+            public Vector cast(final Vector start, final Vector end) {
+                fail();
+                return null;
+            }
+        });
+        assertEquals(new Vector(0, 1.62F, 0), runtime.active(1, 66, 5).position());
+    }
+
+    @Test
+    void followPayloadBoundsAndPreservesSignedActorIds() {
+        for (final long id : new long[]{Long.MIN_VALUE, -1, Long.MAX_VALUE}) {
+            final var state = state(3, 2, 0, 4, id, List.of(preset(0, 1, 10)));
+            final var buffer = Unpooled.buffer();
+            try {
+                CameraFollowState.TYPE.write(buffer, state);
+                assertEquals(state, CameraFollowState.TYPE.read(buffer));
+                CameraFollowState.TYPE.write(buffer.clear(), state);
+                buffer.writeByte(0);
+                assertThrows(IllegalArgumentException.class, () -> CameraFollowState.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+        assertThrows(IllegalArgumentException.class, () -> state(1, 1, 0, 1, null, List.of()));
+        assertThrows(IllegalArgumentException.class, () -> state(1, 1, 0, 1, null, List.of(preset(0, 1, 10), preset(0, 2, 5))));
+    }
+
+    @Test
+    void nativeFollowComponentChainMatchesPoseWithAttachmentAndViewOffsets() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FOLLOW_FRAME");
+        assumeTrue(source != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        for (final var element : cases) {
+            assertNativeFrame(element.getAsJsonObject(), AIR);
+        }
+        assertEquals(256, cases.size());
+    }
+
+    @Test
+    void nativeFollowAvoidanceMatchesWorldQueriesAndTheFinalPose() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FOLLOW_COLLISION");
+        assumeTrue(source != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        for (final var element : cases) {
+            final var sample = element.getAsJsonObject();
+            final var queries = sample.getAsJsonArray("queries");
+            final var calls = new AtomicInteger();
+            final var world = new CameraFollowRuntime.World() {
+                @Override
+                public boolean insideSolidBlock(final Vector origin) {
+                    assertVector(vector(sample.getAsJsonArray("origin")), origin);
+                    return sample.get("collapsed").getAsBoolean();
+                }
+
+                @Override
+                public Vector cast(final Vector start, final Vector end) {
+                    final var query = queries.get(calls.getAndIncrement()).getAsJsonObject();
+                    assertVector(vector(query.getAsJsonArray("start")), start);
+                    assertVector(vector(query.getAsJsonArray("end")), end);
+                    return query.get("hit").isJsonNull() ? null : vector(query.getAsJsonArray("hit"));
+                }
+            };
+            assertNativeFrame(sample, world);
+            assertEquals(queries.size(), calls.get());
+        }
+        assertEquals(768, cases.size());
+    }
+
+    private static void assertVector(final Vector expected, final Vector actual) {
+        assertEquals(expected.x(), actual.x(), .0001F);
+        assertEquals(expected.y(), actual.y(), .0001F);
+        assertEquals(expected.z(), actual.z(), .0001F);
+    }
+
+    private static void assertNativeFrame(final JsonObject sample, final CameraFollowRuntime.World world) {
+        final var origin = vector(sample.getAsJsonArray("origin"));
+        final boolean attached = sample.get("attached").getAsBoolean();
+        final var feet = attached ? origin : origin.subtract(new Vector(0, 1.62F, 0));
+        final var actor = new CameraFollowRuntime.Actor(UUID.randomUUID(), feet, feet.add(new Vector(0, .9F, 0)), sample.get("actorYaw").getAsFloat());
+        final var view = sample.getAsJsonArray("view");
+        final var preset = new CameraFollowState.Preset(0, 0, sample.get("radius").getAsFloat(), sample.get("pitch").getAsFloat(), sample.get("yaw").getAsFloat(),
+                view.get(0).getAsFloat(), view.get(1).getAsFloat(), vector(sample.getAsJsonArray("entityOffset")), -180, 180);
+        final var runtime = new CameraFollowRuntime();
+        runtime.accept(state(1, 1, 0, 1, sample.get("attached").getAsBoolean() ? 9L : null, List.of(preset)));
+        runtime.advance(1F / 60, actor, id -> actor, world);
+        final var pose = runtime.active(1, 66, 5);
+        final var expected = vector(sample.getAsJsonArray("position"));
+        assertEquals(expected.x(), pose.position().x(), .00002F, sample::toString);
+        assertEquals(expected.y(), pose.position().y(), .00002F, sample::toString);
+        assertEquals(expected.z(), pose.position().z(), .00002F, sample::toString);
+        final var q = sample.getAsJsonArray("orientation");
+        final var observed = pose.orientation();
+        final float dot = observed.x() * q.get(0).getAsFloat() + observed.y() * q.get(1).getAsFloat()
+                + observed.z() * q.get(2).getAsFloat() + observed.w() * q.get(3).getAsFloat();
+        assertEquals(1, Math.abs(dot), .00001F, sample::toString);
+    }
+
+    private static CameraFollowState state(final long sequence, final long position, final long active, final long attachment, final Long actor,
+                                            final List<CameraFollowState.Preset> presets) {
+        return new CameraFollowState(sequence, 0, position, active, attachment, actor, 1.62F, presets);
+    }
+
+    private static CameraFollowState.Preset preset(final long id, final long revision, final float radius) {
+        return new CameraFollowState.Preset(id, revision, radius, 0, 0, 0, 0, Vector.ZERO, -180, 180);
+    }
+
+    private static CameraFollowRuntime.Actor actor(final UUID lifetime, final float x) {
+        return new CameraFollowRuntime.Actor(lifetime, new Vector(x, 0, 0), new Vector(x, .9F, 0), 0);
+    }
+
+    private static Vector vector(final JsonArray value) {
+        return new Vector(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+
+}
