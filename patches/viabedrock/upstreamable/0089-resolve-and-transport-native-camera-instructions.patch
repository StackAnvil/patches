@@ -0,0 +1,96 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+
+/** Follow-camera instances and attachment generations, independent of position-blend commands. */
+public record CameraFollowState(long sequence, long epoch, long positionSequence, long activePreset,
+                                long attachmentSequence, Long actorUniqueId, float playerOriginOffset, List<Preset> presets) {
+
+    public static final String CHANNEL = "viabedrock:camera_follow";
+    public static final int MAX_PRESETS = 4096;
+    public static final Type<CameraFollowState> TYPE = new Type<>(CameraFollowState.class) {
+        @Override
+        public CameraFollowState read(final ByteBuf b) {
+            if (b.readableBytes() > 1 << 20 || Types.VAR_INT.readPrimitive(b) != 1) {
+                throw new IllegalArgumentException("Unsupported camera follow state");
+            }
+            final long sequence = b.readLong();
+            final long epoch = b.readLong();
+            final long positionSequence = b.readLong();
+            final long activePreset = b.readLong();
+            final long attachmentSequence = b.readLong();
+            final Long actor = b.readBoolean() ? b.readLong() : null;
+            final float originOffset = b.readFloat();
+            final int count = Types.VAR_INT.readPrimitive(b);
+            if (count < 0 || count > MAX_PRESETS) {
+                throw new IllegalArgumentException("Invalid follow preset count");
+            }
+            final var presets = new ArrayList<Preset>(count);
+            for (int i = 0; i < count; i++) {
+                presets.add(new Preset(b.readLong(), b.readLong(), b.readFloat(), b.readFloat(), b.readFloat(),
+                        b.readFloat(), b.readFloat(), new Vector(b.readFloat(), b.readFloat(), b.readFloat()), b.readFloat(), b.readFloat()));
+            }
+            if (b.isReadable()) {
+                throw new IllegalArgumentException("Trailing camera follow fields");
+            }
+            return new CameraFollowState(sequence, epoch, positionSequence, activePreset, attachmentSequence, actor, originOffset, presets);
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraFollowState s) {
+            Types.VAR_INT.writePrimitive(b, 1);
+            b.writeLong(s.sequence).writeLong(s.epoch).writeLong(s.positionSequence).writeLong(s.activePreset).writeLong(s.attachmentSequence);
+            b.writeBoolean(s.actorUniqueId != null);
+            if (s.actorUniqueId != null) {
+                b.writeLong(s.actorUniqueId);
+            }
+            b.writeFloat(s.playerOriginOffset);
+            Types.VAR_INT.writePrimitive(b, s.presets.size());
+            for (final var p : s.presets) {
+                b.writeLong(p.id).writeLong(p.rotationSequence).writeFloat(p.radius).writeFloat(p.pitch).writeFloat(p.yaw)
+                        .writeFloat(p.viewX).writeFloat(p.viewY).writeFloat(p.entityOffset.x()).writeFloat(p.entityOffset.y()).writeFloat(p.entityOffset.z())
+                        .writeFloat(p.minYaw).writeFloat(p.maxYaw);
+            }
+        }
+    };
+
+    public CameraFollowState {
+        if (sequence < 0 || epoch < 0 || positionSequence < 0 || activePreset < -1 || attachmentSequence < 0
+                || !Float.isFinite(playerOriginOffset) || presets.size() > MAX_PRESETS) {
+            throw new IllegalArgumentException("Invalid camera follow state");
+        }
+        presets = List.copyOf(presets);
+        final var ids = new HashSet<Long>();
+        for (final var preset : presets) {
+            if (!ids.add(preset.id)) {
+                throw new IllegalArgumentException("Duplicate follow preset");
+            }
+        }
+        if (activePreset >= 0 && !ids.contains(activePreset)) {
+            throw new IllegalArgumentException("Missing active follow preset");
+        }
+    }
+
+    public record Preset(long id, long rotationSequence, float radius, float pitch, float yaw, float viewX, float viewY,
+                         Vector entityOffset, float minYaw, float maxYaw) {
+        public Preset {
+            if (id < 0 || rotationSequence < 0 || !Float.isFinite(radius) || radius < 0 || !Float.isFinite(pitch) || !Float.isFinite(yaw)
+                    || !Float.isFinite(viewX) || !Float.isFinite(viewY) || entityOffset == null || !Float.isFinite(minYaw) || !Float.isFinite(maxYaw) || minYaw > maxYaw) {
+                throw new IllegalArgumentException("Invalid camera follow preset");
+            }
+        }
+    }
+
+}
