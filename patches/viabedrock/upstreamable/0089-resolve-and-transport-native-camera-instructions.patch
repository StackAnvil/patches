+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraOrbitTest {
+
+    @Test
+    void zeroSpringsUseTheTargetAndTheSuppliedCollisionRadiusImmediately() {
+        final var orbit = orbit(CameraOrbit.Settings.followOrbit(-180, 180), 3, 0, CameraPose.PI * .5F);
+        final var pivot = new Vector(10, 20, 30);
+        final var position = orbit.advance(0, pivot, Vector.ZERO, 15);
+        assertEquals(15, orbit.state().radius());
+        assertEquals(25, position.x());
+        assertEquals(20, position.y(), .00001F);
+        assertEquals(30, position.z());
+        assertEquals(0, orbit.state().radiusVelocity());
+        assertEquals(13, orbit.advance(.05F, pivot, position, Float.MAX_VALUE).x());
+        assertEquals(3, orbit.state().radius());
+        assertDoesNotThrow(() -> orbit.advance(0, new Vector(-Float.MAX_VALUE, 0, 0), new Vector(Float.MAX_VALUE, 0, 0), Float.MAX_VALUE));
+    }
+
+    @Test
+    void radiusSpringMeasuresThePreviousCameraAgainstTheMovingPivot() {
+        final var settings = new CameraOrbit.Settings(4, 4, 4, 0, CameraPose.PI, -CameraPose.PI, CameraPose.PI, false, false);
+        final var orbit = orbit(settings, 3, 0, CameraPose.PI * .5F);
+        final var position = orbit.advance(0, new Vector(1, 0, 0), new Vector(10, 0, 0), Float.MAX_VALUE);
+        assertEquals(9, orbit.state().radius());
+        assertEquals(10, position.x());
+        assertEquals(0, orbit.state().radiusVelocity());
+    }
+
+    @Test
+    void inputWrapsAndClampsAfterApplyingBothInversionFlags() {
+        final var settings = new CameraOrbit.Settings(0, 0, 0, .1F, 2, -.5F, .75F, true, true);
+        final var orbit = orbit(settings, 10, 0, 1);
+        orbit.input(15, 90);
+        assertEquals(-.5F, orbit.target().yaw());
+        assertEquals(1 - 15 * CameraPose.DEGREES, orbit.target().polar());
+        orbit.input(-900, -720);
+        assertEquals(2, orbit.target().polar());
+        assertEquals(-.5F, orbit.target().yaw(), .00001F);
+        assertThrows(IllegalArgumentException.class, () -> orbit.input(Float.NaN, 0));
+        assertThrows(IllegalArgumentException.class, () -> orbit.advance(-1, Vector.ZERO, Vector.ZERO, Float.MAX_VALUE));
+    }
+
+    @Test
+    void comparesChainedOrbitFramesWithTheNativeUpdater() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_ORBIT");
+        assumeTrue(source != null);
+        final var sequences = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("sequences");
+        int checked = 0;
+        for (final var element : sequences) {
+            final var sample = element.getAsJsonObject();
+            final var rates = sample.getAsJsonArray("rates");
+            final var initial = sample.getAsJsonArray("initial");
+            final var target = sample.getAsJsonArray("target");
+            final var settings = new CameraOrbit.Settings(at(rates, 0), at(rates, 1), at(rates, 2), 0, CameraPose.PI,
+                    -CameraPose.PI, CameraPose.PI, false, false);
+            final var orbit = new CameraOrbit(settings, new CameraOrbit.State(at(initial, 0), at(initial, 1), at(initial, 2), 0, 0, 0),
+                    new CameraOrbit.Target(at(target, 0), at(target, 1), at(target, 2)));
+            Vector position = vector(sample.getAsJsonArray("initialPosition"));
+            for (final var frameElement : sample.getAsJsonArray("frames")) {
+                final var frame = frameElement.getAsJsonObject();
+                position = orbit.advance(frame.get("delta").getAsFloat(), vector(frame.getAsJsonArray("pivot")), position, sample.get("collision").getAsFloat());
+                final var expected = vector(frame.getAsJsonArray("position"));
+                assertEquals(expected.x(), position.x(), .00002F);
+                assertEquals(expected.y(), position.y(), .00002F);
+                assertEquals(expected.z(), position.z(), .00002F);
+                final var state = orbit.state();
+                final var nativeState = frame.getAsJsonArray("state");
+                assertEquals(at(nativeState, 0), state.radius(), .00002F);
+                assertEquals(at(nativeState, 1), state.yaw(), .00002F);
+                assertEquals(at(nativeState, 2), state.polar(), .00002F);
+                assertEquals(at(nativeState, 6), state.yawVelocity(), .00002F);
+                assertEquals(at(nativeState, 7), state.polarVelocity(), .00002F);
+                assertEquals(at(nativeState, 8), state.radiusVelocity(), .00002F);
+                checked++;
+            }
+        }
+        assertEquals(270, checked);
+    }
+
+    @Test
+    void comparesChainedInputWithNativeWrappingLimitsAndInversion() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_ORBIT_INPUT");
+        assumeTrue(source != null);
+        final var sequences = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("sequences");
+        int checked = 0;
+        for (final var element : sequences) {
+            final var sample = element.getAsJsonObject();
+            final var limits = sample.getAsJsonArray("limitsRadians");
+            final var initial = sample.getAsJsonArray("initialRadians");
+            final var settings = new CameraOrbit.Settings(0, 0, 0, at(limits, 0), at(limits, 1), at(limits, 2), at(limits, 3),
+                    sample.get("flipX").getAsBoolean(), sample.get("flipY").getAsBoolean());
+            final var orbit = orbit(settings, 10, at(initial, 0), at(initial, 1));
+            for (final var frameElement : sample.getAsJsonArray("frames")) {
+                final var frame = frameElement.getAsJsonObject();
+                final var delta = frame.getAsJsonArray("delta");
+                orbit.input(at(delta, 0), at(delta, 1));
+                final var expected = frame.getAsJsonArray("target");
+                assertEquals(at(expected, 0), orbit.target().yaw(), .000001F);
+                assertEquals(at(expected, 1), orbit.target().polar(), .000001F);
+                checked++;
+            }
+        }
+        assertEquals(120, checked);
+    }
+
+    private static CameraOrbit orbit(final CameraOrbit.Settings settings, final float radius, final float yaw, final float polar) {
+        return new CameraOrbit(settings, new CameraOrbit.State(radius, yaw, polar, 0, 0, 0), new CameraOrbit.Target(radius, yaw, polar));
+    }
+
+    private static float at(final JsonArray array, final int index) {
+        return array.get(index).getAsFloat();
+    }
+
+    private static Vector vector(final JsonArray array) {
+        return new Vector(at(array, 0), at(array, 1), at(array, 2));
+    }
+
+}
