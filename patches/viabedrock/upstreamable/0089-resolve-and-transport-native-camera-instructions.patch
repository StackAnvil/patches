@@ -0,0 +1,149 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+/** Float camera traversal and box surface intersections, independent of the renderer's world access. */
+public final class CameraRaycast {
+
+    private CameraRaycast() {
+    }
+
+    /**
+     * Visits the starting cell and at most 200 subsequent cells, as the native camera query does.
+     * The caller resolves block layers, camera bounds, and per-type filters before returning a box.
+     * This traversal does not implement the native fluid-material transition state machine.
+     */
+    public static Hit cast(final Vector start, final Vector end, final Shapes shapes) {
+        int x = floor(start.x());
+        int y = floor(start.y());
+        int z = floor(start.z());
+        final int endX = floor(end.x());
+        final int endY = floor(end.y());
+        final int endZ = floor(end.z());
+        float px = start.x();
+        float py = start.y();
+        float pz = start.z();
+        for (int step = 0; step <= 200; step++) {
+            final Box box = shapes.at(x, y, z);
+            if (box != null) {
+                final Hit hit = box.intersect(x, y, z, start, end);
+                if (hit != null) {
+                    return hit;
+                }
+            }
+            if (step == 200 || Float.isNaN(px) || Float.isNaN(py) || Float.isNaN(pz) || x == endX && y == endY && z == endZ) {
+                return null;
+            }
+            final float bx = x < endX ? (float) x + 1 : x > endX ? x : 0;
+            final float by = y < endY ? (float) y + 1 : y > endY ? y : 0;
+            final float bz = z < endZ ? (float) z + 1 : z > endZ ? z : 0;
+            final float dx = end.x() - px;
+            final float dy = end.y() - py;
+            final float dz = end.z() - pz;
+            final float tx = x == endX ? 999 : (bx - px) / dx;
+            final float ty = y == endY ? 999 : (by - py) / dy;
+            final float tz = z == endZ ? 999 : (bz - pz) / dz;
+            if (ty > tx && tz > tx) {
+                x += x < endX ? 1 : -1;
+                px = bx;
+                py += dy * tx;
+                pz += dz * tx;
+            } else if (ty < tz) {
+                y += y < endY ? 1 : -1;
+                px += dx * ty;
+                py = by;
+                pz += dz * ty;
+            } else {
+                z += z < endZ ? 1 : -1;
+                px += dx * tz;
+                py += dy * tz;
+                pz = bz;
+            }
+        }
+        return null;
+    }
+
+    private static int floor(final float value) {
+        final int truncated = (int) value;
+        return truncated - (value < truncated ? 1 : 0);
+    }
+
+    @FunctionalInterface
+    public interface Shapes {
+        /** Returns accepted world-space camera bounds, or null when this cell supplies no surface. */
+        Box at(int x, int y, int z);
+    }
+
+    /** World-space hit. Face values use Bedrock's down/up/north/south/west/east ordering. */
+    public record Hit(Vector position, int face) {
+    }
+
+    public record Box(float minX, float minY, float minZ, float maxX, float maxY, float maxZ) {
+
+        /**
+         * Tests actual box surfaces, including exits from inside and inclusive edges.
+         * A segment wholly inside a box has no hit. Equal-distance faces retain X, then Y, then Z priority.
+         */
+        public Hit intersect(final int x, final int y, final int z, final Vector start, final Vector end) {
+            if (this.maxX <= this.minX || this.maxY <= this.minY || this.maxZ <= this.minZ) {
+                return null;
+            }
+            final float sx = start.x() - x;
+            final float sy = start.y() - y;
+            final float sz = start.z() - z;
+            final float dx = (end.x() - x) - sx;
+            final float dy = (end.y() - y) - sy;
+            final float dz = (end.z() - z) - sz;
+            final float lx = this.minX - x;
+            final float ly = this.minY - y;
+            final float lz = this.minZ - z;
+            final float hx = this.maxX - x;
+            final float hy = this.maxY - y;
+            final float hz = this.maxZ - z;
+            float closest = Float.POSITIVE_INFINITY;
+            Hit hit = null;
+            for (int plane = 0; plane < 6; plane++) {
+                final int axis = plane / 2;
+                final float delta = axis == 0 ? dx : axis == 1 ? dy : dz;
+                if (delta * delta < 1E-7F) {
+                    continue;
+                }
+                final boolean upper = (plane & 1) != 0;
+                final float boundary = switch (axis) {
+                    case 0 -> upper ? hx : lx;
+                    case 1 -> upper ? hy : ly;
+                    default -> upper ? hz : lz;
+                };
+                final float origin = axis == 0 ? sx : axis == 1 ? sy : sz;
+                final float fraction = (boundary - origin) / delta;
+                if (!(fraction >= 0 && fraction <= 1)) {
+                    continue;
+                }
+                final float px = fraction * dx + sx;
+                final float py = fraction * dy + sy;
+                final float pz = fraction * dz + sz;
+                if (axis != 0 && !(px >= lx && px <= hx) || axis != 1 && !(py >= ly && py <= hy)
+                        || axis != 2 && !(pz >= lz && pz <= hz)) {
+                    continue;
+                }
+                final float distance = (pz - sz) * (pz - sz) + (py - sy) * (py - sy) + (px - sx) * (px - sx);
+                if (hit == null || distance < closest) {
+                    closest = distance;
+                    final int face = switch (axis) {
+                        case 0 -> 4 + (plane & 1);
+                        case 1 -> plane & 1;
+                        default -> 2 + (plane & 1);
+                    };
+                    hit = new Hit(new Vector(x + px, y + py, z + pz), face);
+                }
+            }
+            return hit;
+        }
+    }
+
+}
