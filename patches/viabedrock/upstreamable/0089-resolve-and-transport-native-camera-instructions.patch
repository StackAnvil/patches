+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+
+/** Listener orientation is independent of the rendered camera when a preset selects the player. */
+public record CameraAudioListener(CameraPose.Vector position, CameraPose.Vector forward, CameraPose.Vector up) {
+
+    public static CameraAudioListener player(final CameraPose.Vector position, final float pitch, final float yaw) {
+        final float pitchRadians = pitch * CameraPose.DEGREES;
+        final float yawRadians = yaw * CameraPose.DEGREES;
+        final float pitchSin = BedrockTrigonometry.sine(pitchRadians);
+        final float pitchCos = BedrockTrigonometry.cosine(pitchRadians);
+        final float yawSin = BedrockTrigonometry.sine(yawRadians);
+        final float yawCos = BedrockTrigonometry.cosine(yawRadians);
+        return new CameraAudioListener(position,
+                normalized(-yawSin * pitchCos, -pitchSin, yawCos * pitchCos),
+                normalized(-yawSin * pitchSin, pitchCos, yawCos * pitchSin));
+    }
+
+    private static CameraPose.Vector normalized(final float x, final float y, final float z) {
+        final float length = (float) Math.sqrt(z * z + (y * y + x * x));
+        return length < .0001F ? CameraPose.Vector.ZERO : new CameraPose.Vector(x / length, y / length, z / length);
+    }
+
+}
