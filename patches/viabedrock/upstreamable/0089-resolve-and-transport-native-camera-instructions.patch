+
+class CameraEffectsStorageTest {
+
+    @Test
+    void definitionReplacementAndRetirementKeepSnapshotsAndCommandsDistinct() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        channels.addChannels(List.of(CameraSplineState.CHANNEL));
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var now = new AtomicLong(1);
+        final var storage = new CameraEffectsStorage(user, now::get);
+        storage.markJoined();
+        final var first = new CameraSplineDefinition("example:path", 4, "linear",
+                List.of(new CameraInstruction.Vec3(0, 70, 0), new CameraInstruction.Vec3(1, 70, 0), new CameraInstruction.Vec3(10, 70, 0)),
+                List.of(new CameraInstruction.Progress(0, 0, null), new CameraInstruction.Progress(1, 4, "in_quad")),
+                List.of(new CameraInstruction.Rotation(new CameraInstruction.Vec3(0, 0, 0), 0, null)));
+        final var replacement = new CameraSplineDefinition(first.name(), 8, first.type(), first.curve(), first.progress(), first.rotations());
+        final var instruction = new CameraInstruction(null, null, null, null, null, null,
+                new CameraInstruction.Spline(77, 255, List.of(), List.of(), List.of(), first.name(), true), null, null);
+        final var packet = mock(PacketWrapper.class);
+        try (var wrappers = mockStatic(PacketWrapper.class)) {
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(packet);
+            storage.setSplines(new CameraSplineRegistry(List.of(first, replacement)));
+            storage.apply(instruction);
+            storage.setSplines(new CameraSplineRegistry(List.of(replacement)));
+            storage.sendSnapshot();
+            storage.apply(instruction);
+            storage.setSplines(CameraSplineRegistry.EMPTY);
+            storage.sendSnapshot();
+            now.addAndGet(8_000_000_000L);
+            storage.tick();
+            storage.sendSnapshot();
+            now.addAndGet(1_000L);
+            storage.tick();
+            storage.sendSnapshot();
+            storage.setSplines(new CameraSplineRegistry(List.of(replacement)));
+            storage.apply(instruction);
+            storage.sendSnapshot();
+            final var states = ArgumentCaptor.forClass(CameraSplineState.class);
+            verify(packet, times(8)).write(eq(CameraSplineState.TYPE), states.capture());
+            final var sent = states.getAllValues();
+            final var initial = sent.subList(0, 4);
+            assertEquals(List.of(4F, 4F, 8F, 8F), initial.stream().map(s -> s.program().duration()).toList());
+            assertEquals(List.of(1L, 1L, 2L, 2L), initial.stream().map(CameraSplineState::sequence).toList());
+            assertEquals(List.of(true, false, true, false), initial.stream().map(CameraSplineState::live).toList());
+            assertEquals(List.of(2, 2, 2, 4), initial.stream().map(s -> s.program().progress().size()).toList());
+            assertNotNull(sent.get(4).program());
+            assertEquals(8, sent.get(4).elapsed());
+            assertNull(sent.get(5).program());
+            assertEquals(2, sent.get(5).sequence());
+            assertEquals(3, sent.get(7).sequence());
+            assertEquals(2, sent.get(7).program().progress().size());
+        }
+    }
+
+    @Test
+    void inlineSplinesUseTheirOwnNegotiatedChannelAndPreserveActionPriority() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var storage = new CameraEffectsStorage(user);
+        storage.markJoined();
+        final var packet = mock(PacketWrapper.class);
+        final var spline = new CameraInstruction.Spline(4, 1,
+                List.of(new CameraInstruction.Vec3(0, 70, 0), new CameraInstruction.Vec3(1, 70, 0), new CameraInstruction.Vec3(10, 70, 0)),
+                List.of(new CameraInstruction.Progress(0, 0, "in_quad"), new CameraInstruction.Progress(1, 4, "linear")),
+                List.of(new CameraInstruction.Rotation(new CameraInstruction.Vec3(30, 90, 10), 0, "linear")), "", false);
+        final var instruction = new CameraInstruction(null, true, null, null, false, null, spline, null, false);
+        try (var wrappers = mockStatic(PacketWrapper.class)) {
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(packet);
+            storage.apply(instruction);
+            verifyNoInteractions(packet);
