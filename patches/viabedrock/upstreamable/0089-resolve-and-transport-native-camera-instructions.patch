+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.CameraFovState;
+import net.raphimc.viabedrock.api.model.CameraFollowState;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import net.raphimc.viabedrock.protocol.model.CameraPreset;
+import net.raphimc.viabedrock.protocol.model.CameraPresetRegistry;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class CameraEffectsStorageTest {
+
+    @Test
+    void followModesRequireTheirNegotiatedChannelAndSnapshotTheNativeOriginOffset() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        channels.addChannels(List.of(CameraPositionState.CHANNEL));
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var entities = mock(EntityTracker.class);
+        final var player = mock(ClientPlayerEntity.class);
+        when(user.get(EntityTracker.class)).thenReturn(entities);
+        when(entities.getClientPlayer()).thenReturn(player);
+        when(player.eyeOffset()).thenReturn(1.62F);
+        final var storage = new CameraEffectsStorage(user);
+        storage.setPresets(new CameraPresetRegistry(List.of(new CameraPreset("minecraft:follow_orbit", "", null, null, null, null, null,
+                null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, false, null))));
+        storage.markJoined();
+        final var packet = mock(PacketWrapper.class);
+        try (var wrappers = mockStatic(PacketWrapper.class)) {
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(packet);
+            storage.apply(new CameraInstruction(new CameraInstruction.SetCamera(0, null, null, null, null, null, null, null, false),
+                    null, null, null, null, null, null, null, null));
+            verifyNoInteractions(packet);
+            channels.addChannels(List.of(CameraFollowState.CHANNEL));
+            storage.sendSnapshot();
+            final var positions = ArgumentCaptor.forClass(CameraPositionState.class);
+            verify(packet).write(eq(CameraPositionState.TYPE), positions.capture());
+            assertEquals(CameraPositionState.Mode.FOLLOW_ORBIT, positions.getValue().mode());
+            final var follow = ArgumentCaptor.forClass(CameraFollowState.class);
+            verify(packet).write(eq(CameraFollowState.TYPE), follow.capture());
+            assertEquals(positions.getValue().sequence(), follow.getValue().positionSequence());
+            assertEquals(1.62F, follow.getValue().playerOriginOffset());
+            assertEquals(0, follow.getValue().activePreset());
+        }
+    }
+
+    @Test
+    void onlyTheSelectedActionCanChangeOrClearFov() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        channels.addChannels(List.of(CameraFovState.CHANNEL));
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var storage = new CameraEffectsStorage(user);
+        storage.markJoined();
+        final var packet = mock(PacketWrapper.class);
+        try (var wrappers = mockStatic(PacketWrapper.class)) {
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(packet);
+            final var fov = new CameraInstruction.FieldOfView(30, 0, "linear", false);
+            storage.apply(new CameraInstruction(null, null, null, null, null, fov, null, null, null));
+            storage.apply(new CameraInstruction(null, true, null, new CameraInstruction.Target(null, 9), false, fov, null, null, false));
+            storage.apply(new CameraInstruction(null, true, null, null, false, fov, null, null, true));
+            storage.apply(new CameraInstruction(null, true, null, null, false, fov, null, null, false));
+            storage.apply(new CameraInstruction(null, false, null, null, false, null, null, null, false));
+            storage.apply(new CameraInstruction(null, true, null, null, null, null, null, null, null));
+            final var states = ArgumentCaptor.forClass(CameraFovState.class);
+            verify(packet, times(3)).write(eq(CameraFovState.TYPE), states.capture());
+            final var sent = states.getAllValues();
+            assertEquals(List.of(1L, 2L, 3L), sent.stream().map(CameraFovState::sequence).toList());
+            assertFalse(sent.get(0).command().clear());
+            assertFalse(sent.get(1).command().clear());
+            assertEquals(30, sent.get(1).command().value());
+            assertTrue(sent.get(2).command().clear());
+        }
+    }
+
+}
