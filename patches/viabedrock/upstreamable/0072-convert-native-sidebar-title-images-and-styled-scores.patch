+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.ScoreboardUiResourceRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ScoreboardUiDefinitionsTest {
+
+    @Test
+    void explicitLiteralBindingProducesAnIsolatedFontAndAuthoredImageDimensions() {
+        final ResourcePack pack = pack(panel("sample.title", "textures/ui/sample", 66, 21), 0xFFFF8844);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack));
+        final var definition = storage.getScoreboardUi().image("sample.title");
+        assertNotNull(definition);
+        assertEquals(66, definition.width());
+        assertEquals(21, definition.height());
+        assertNull(storage.getScoreboardUi().image("other.title"));
+        final var output = ScoreboardUiResourceRewriter.convert(storage);
+        final var original = output.getImage("assets/viabedrock/" + definition.texture().substring(11)).getImage();
+        assertEquals(8, original.getWidth());
+        assertEquals(2, original.getHeight());
+        assertEquals(0xFFFF8844, original.getRGB(3, 1));
+        final var fallback = output.getImage("assets/viabedrock/" + definition.texture().substring(11).replace(".png", "_font.png")).getImage();
+        assertEquals(66, fallback.getWidth());
+        assertEquals(21, fallback.getHeight());
+        assertFalse(output.contains("assets/minecraft/font/default.json"));
+        assertTrue(output.contains("assets/viabedrock/font/" + definition.font().substring(11) + ".json"));
+        assertNotEquals(storage.getScoreboardUi().titleComponent("sample.title", "fallback"), storage.getScoreboardUi().titleComponent("ordinary", "fallback"));
+        assertThrows(UnsupportedOperationException.class, () -> storage.getScoreboardUi().images().clear());
+    }
+
+    @Test
+    void effectiveUiAndTextureFollowPackPriority() {
+        final var lower = pack(panel("lower.title", "textures/ui/sample", 66, 21), 0xFF112233);
+        final var higher = pack(panel("higher.title", "textures/ui/sample", 40, 12), 0xFF445566);
+        final var storage = new ResourcePackStorage(List.of(higher, lower));
+        assertNull(storage.getScoreboardUi().image("lower.title"));
+        final var image = storage.getScoreboardUi().image("higher.title");
+        assertEquals(40, image.width());
+        final var converted = ScoreboardUiResourceRewriter.convert(storage);
+        assertEquals(0xFF445566, converted.getImage("assets/viabedrock/" + image.texture().substring(11)).getImage().getRGB(0, 0));
+    }
+
+    @Test
+    void unsupportedHigherControlDoesNotResurrectLowerUi() {
+        final JsonObject upper = panel("upper", "textures/ui/sample", 40, 12);
+        image(upper).addProperty("anchor_to", "bottom_left");
+        final var storage = new ResourcePackStorage(List.of(pack(upper, -1), pack(panel("lower", "textures/ui/sample", 40, 12), -1)));
+        assertTrue(storage.getScoreboardUi().images().isEmpty());
+    }
+
+    @Test
+    void missingInverseCompanionAndAdditionalVisibilityExpressionsAreRejected() {
+        final JsonObject withoutLabel = panel("test", "textures/ui/sample", 40, 12);
+        withoutLabel.getAsJsonArray("controls").remove(0);
+        assertEmpty(withoutLabel);
+        final JsonObject expression = panel("test", "textures/ui/sample", 40, 12);
+        image(expression).getAsJsonArray("bindings").get(1).getAsJsonObject().addProperty("source_property_name", "(#objective_sidebar_name = 'test' or true)");
+        assertEmpty(expression);
+    }
+
+    @Test
+    void fractionalNonfiniteAndOversizedDimensionsNeverProduceImageTitles() {
+        for (double value : new double[]{0, -1, 4.5, 1025, Double.POSITIVE_INFINITY}) {
+            final JsonObject panel = panel("test", "textures/ui/sample", 40, 12);
+            image(panel).getAsJsonArray("size").set(0, new JsonPrimitive(value));
+            assertEmpty(panel);
+        }
+    }
+
+    @Test
+    void conflictingImagesAndMissingTexturePreserveOrdinaryTitle() {
+        final JsonObject duplicate = panel("test", "textures/ui/sample", 40, 12);
+        final JsonObject wrapped = new JsonObject();
+        wrapped.add("duplicate", image(duplicate).deepCopy());
+        wrapped.getAsJsonObject("duplicate").getAsJsonArray("bindings").get(1).getAsJsonObject().addProperty("source_control_name", "duplicate");
+        duplicate.getAsJsonArray("controls").add(wrapped);
+        assertEmpty(duplicate);
+        assertEmpty(panel("test", "textures/ui/missing", 40, 12));
+    }
+
+    @Test
+    void distinctTitlesUseDistinctFontsWithoutConsumingServerGlyphSlots() {
+        final var first = new ResourcePackStorage(List.of(pack(panel("one", "textures/ui/sample", 40, 12), -1)));
+        final var second = new ResourcePackStorage(List.of(pack(panel("two", "textures/ui/sample", 40, 12), -1)));
+        assertNotEquals(first.getScoreboardUi().image("one").font(), second.getScoreboardUi().image("two").font());
+    }
+
+    @Test
+    void explicitPlayerFactoryExportsTheStaticRowHeight() {
+        final JsonObject panel = panel("test", "textures/ui/sample", 40, 12);
+        final JsonObject players = new JsonObject();
+        players.addProperty("collection_name", "scoreboard_players");
+        final JsonObject factory = new JsonObject();
+        factory.addProperty("control_name", "scoreboard.rows");
+        players.add("factory", factory);
+        final JsonObject wrapped = new JsonObject();
+        wrapped.add("players", players);
+        panel.getAsJsonArray("controls").add(wrapped);
+        final ResourcePack pack = pack(panel, -1);
+        final JsonObject ui = pack.content().getJson("ui/example.json");
+        final JsonObject label = new JsonObject();
+        label.addProperty("type", "label");
+        label.addProperty("text", "#player_name_sidebar");
+        final JsonArray size = new JsonArray();
+        size.add("default");
+        size.add(10);
+        label.add("size", size);
+        ui.add("rows", label);
+        pack.content().putJson("ui/example.json", ui);
+        final var storage = new ResourcePackStorage(List.of(pack));
+        assertEquals(10, storage.getScoreboardUi().image("test").rowHeight());
+        assertEquals(10, ScoreboardUiResourceRewriter.convert(storage).getJson("assets/viabedrock/scoreboard_ui.json")
+                .getAsJsonArray("images").get(0).getAsJsonObject().get("row_height").getAsInt());
+    }
+
+    @Test
+    void unreferencedFilesDoNotActivateControlsButNativeVanillaOverridesDo() {
+        final ResourcePack unused = pack(panel("test", "textures/ui/sample", 40, 12), -1);
+        unused.content().putJson("ui/_ui_defs.json", new JsonObject());
+        assertTrue(new ResourcePackStorage(List.of(unused)).getScoreboardUi().images().isEmpty());
+        unused.content().copyFrom(unused.content(), "ui/example.json", "ui/scoreboards.json");
+        assertNotNull(new ResourcePackStorage(List.of(unused)).getScoreboardUi().image("test"));
+    }
+
+    @Test
+    void declaredPanelPreservesNineSlicePixelsPaddingOpacityAndRowOffsets() {
+        final var pack = backgroundPack();
+        final var storage = new ResourcePackStorage(List.of(pack));
+        final var image = storage.getScoreboardUi().image("panel.title");
+        assertNotNull(image);
+        final var background = image.background();
+        assertEquals(0.5F, background.alpha());
+        assertEquals(2, background.slice());
+        assertEquals(3, background.paddingX());
+        assertEquals(5, background.paddingY());
+        assertEquals(2, background.rowOffsetX());
+        assertEquals(-1, background.rowOffsetY());
+        final var converted = ScoreboardUiResourceRewriter.convert(storage);
+        final var metadata = converted.getJson("assets/viabedrock/scoreboard_ui.json").getAsJsonArray("images").get(0).getAsJsonObject().getAsJsonObject("background");
+        final var pixels = converted.getImage("assets/viabedrock/" + metadata.get("texture").getAsString().substring(11)).getImage();
+        assertEquals(0, pixels.getRGB(0, 0));
+        assertEquals(0xFF000000, pixels.getRGB(3, 3));
+        assertEquals(6, metadata.get("base_width").getAsInt());
+        assertEquals(-1, metadata.get("row_offset_y").getAsInt());
+    }
+
+    @Test
+    void unsupportedPanelTransformsAndNineSliceDimensionsKeepOrdinaryTitles() {
+        for (int invalid : new int[]{0, 1, 2}) {
+            final var pack = backgroundPack();
+            final var file = pack.content().getJson("ui/example.json");
+            final var background = file.getAsJsonObject("scoreboard_sidebar").getAsJsonArray("controls").get(0).getAsJsonObject().getAsJsonObject("background");
+            if (invalid == 0) {
+                background.getAsJsonArray("size").set(0, new JsonPrimitive("100%cm+$padding"));
+            }
+            if (invalid == 1) {
+                background.addProperty("anchor_to", "bottom_left");
+            }
+            if (invalid == 2) {
+                final var texture = pack.content().getJson("textures/ui/panel.json");
+                texture.addProperty("nineslice_size", 4);
+                pack.content().putJson("textures/ui/panel.json", texture);
+            }
+            pack.content().putJson("ui/example.json", file);
+            assertTrue(new ResourcePackStorage(List.of(pack)).getScoreboardUi().images().isEmpty());
+        }
+    }
+
+    private static ResourcePack backgroundPack() {
+        final var sidebar = panel("panel.title", "textures/ui/sample", 66, 21);
+        final var main = new JsonObject();
+        main.addProperty("type", "image");
+        main.addProperty("texture", "textures/ui/panel");
+        main.addProperty("anchor_from", "center");
+        main.addProperty("anchor_to", "center");
+        main.addProperty("alpha", 0.5);
+        final var size = new JsonArray();
+        size.add("100%cm+3px");
+        size.add("100%c+5px");
+        main.add("size", size);
+        main.add("controls", sidebar.getAsJsonArray("controls"));
+        final var lists = new JsonObject();
+        lists.addProperty("type", "panel");
+        lists.addProperty("anchor_from", "bottom_left");
+        lists.addProperty("anchor_to", "bottom_left");
+        final var offset = new JsonArray();
+        offset.add(2);
+        offset.add(-1);
+        lists.add("offset", offset);
+        final var players = new JsonObject();
+        players.addProperty("collection_name", "scoreboard_players");
+        final var factory = new JsonObject();
+        factory.addProperty("control_name", "scoreboard.rows");
+        players.add("factory", factory);
+        final var wrappedPlayers = new JsonObject();
+        wrappedPlayers.add("players", players);
+        final var listControls = new JsonArray();
+        listControls.add(wrappedPlayers);
+        lists.add("controls", listControls);
+        final var wrappedLists = new JsonObject();
+        wrappedLists.add("lists", lists);
+        main.getAsJsonArray("controls").add(wrappedLists);
+        final var wrappedBackground = new JsonObject();
+        wrappedBackground.add("background", main);
+        final var controls = new JsonArray();
+        controls.add(wrappedBackground);
+        sidebar.add("controls", controls);
+        final var pack = pack(sidebar, -1);
+        final var texture = new JsonObject();
+        texture.addProperty("nineslice_size", 2);
+        final var base = new JsonArray();
+        base.add(6);
+        base.add(6);
+        texture.add("base_size", base);
+        pack.content().putJson("textures/ui/panel.json", texture);
+        final var pixels = new BufferedImage(6, 6, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 6; y++) {
+            for (int x = 0; x < 6; x++) {
+                pixels.setRGB(x, y, x == 0 && y == 0 ? 0 : 0xFF000000);
+            }
+        }
+        pack.content().putPngImage("textures/ui/panel.png", pixels);
+        return pack;
+    }
+
+    private static void assertEmpty(final JsonObject panel) {
+        assertTrue(new ResourcePackStorage(List.of(pack(panel, -1))).getScoreboardUi().images().isEmpty());
+    }
+
+    private static JsonObject image(final JsonObject panel) {
+        return panel.getAsJsonArray("controls").get(1).getAsJsonObject().getAsJsonObject("image");
+    }
+
+    private static JsonObject panel(final String title, final String texture, final int width, final int height) {
+        final JsonObject label = control("label", "label", title, true);
+        label.addProperty("text", "#objective_sidebar_name");
+        final JsonObject image = control("image", "image", title, false);
+        image.addProperty("texture", texture);
+        image.addProperty("anchor_from", "top_middle");
+        image.addProperty("anchor_to", "top_middle");
+        final JsonArray size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        image.add("size", size);
+        final JsonArray controls = new JsonArray();
+        final JsonObject wrappedLabel = new JsonObject();
+        wrappedLabel.add("label", label);
+        controls.add(wrappedLabel);
+        final JsonObject wrappedImage = new JsonObject();
+        wrappedImage.add("image", image);
+        controls.add(wrappedImage);
+        final JsonObject panel = new JsonObject();
+        panel.addProperty("type", "panel");
+        panel.addProperty("anchor_from", "right_middle");
+        panel.addProperty("anchor_to", "right_middle");
+        panel.add("controls", controls);
+        return panel;
+    }
+
+    private static JsonObject control(final String type, final String name, final String title, final boolean inverse) {
+        final JsonObject control = new JsonObject();
+        control.addProperty("type", type);
+        final JsonArray bindings = new JsonArray();
+        final JsonObject global = new JsonObject();
+        global.addProperty("binding_type", "global");
+        global.addProperty("binding_name", "#objective_sidebar_name");
+        bindings.add(global);
+        final JsonObject view = new JsonObject();
+        view.addProperty("binding_type", "view");
+        view.addProperty("source_control_name", name);
+        view.addProperty("resolve_sibling_scope", true);
+        view.addProperty("target_property_name", "#visible");
+        view.addProperty("source_property_name", inverse ? "(not(#objective_sidebar_name = '" + title + "'))" : "(#objective_sidebar_name = '" + title + "')");
+        bindings.add(view);
+        control.add("bindings", bindings);
+        return control;
+    }
+
+    private static ResourcePack pack(final JsonObject panel, final int color) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final JsonObject ui = new JsonObject();
+        ui.addProperty("namespace", "scoreboard");
+        ui.add("scoreboard_sidebar", panel);
+        content.putJson("ui/example.json", ui);
+        final JsonObject definitions = new JsonObject();
+        final JsonArray files = new JsonArray();
+        files.add("ui/example.json");
+        definitions.add("ui_defs", files);
+        content.putJson("ui/_ui_defs.json", definitions);
+        final BufferedImage texture = new BufferedImage(8, 2, BufferedImage.TYPE_INT_ARGB);
+        for (int x = 0; x < 8; x++) {
+            for (int y = 0; y < 2; y++) {
+                texture.setRGB(x, y, color);
+            }
+        }
+        content.putPngImage("textures/ui/sample.png", texture);
+        return new ResourcePack(content);
+    }
+
+}
