+/** A deliberately limited subset of objective-dependent JSON UI image controls. */
+public final class ScoreboardUiDefinitions {
+
+    public static final String IMAGE_CHARACTER = Character.toString(0xE000);
+    private static final Pattern EQUALITY = Pattern.compile("\\(\\s*#objective_sidebar_name\\s*=\\s*'([^'\\r\\n]{1,256})'\\s*\\)");
+    private static final Pattern INVERSE = Pattern.compile("\\(\\s*not\\(\\s*#objective_sidebar_name\\s*=\\s*'([^'\\r\\n]{1,256})'\\s*\\)\\s*\\)");
+    private final Map<String, SidebarImage> images;
+    private final Map<Character, Integer> formattingColors;
+
+    public ScoreboardUiDefinitions(final ResourcePackStorage storage) {
+        final Map<String, SidebarImage> found = new LinkedHashMap<>();
+        final JsonObject file = effectiveFile(storage);
+        final JsonObject panel = file == null || !file.get("scoreboard_sidebar").isJsonObject() ? null : file.getAsJsonObject("scoreboard_sidebar");
+        if (panel != null && "panel".equals(string(panel, "type"))
+                && "right_middle".equals(string(panel, "anchor_from")) && "right_middle".equals(string(panel, "anchor_to"))) {
+            try {
+                collect(panel, storage, found, new int[]{0}, 0, rowHeight(file, panel));
+            } catch (final RuntimeException ignored) {
+                found.clear(); // An ambiguous or oversized UI is outside this supported subset.
+            }
+        }
+        this.images = Collections.unmodifiableMap(found);
+        this.formattingColors = storage.getTextFormatting().colors();
+    }
+
+    public Collection<SidebarImage> images() {
+        return this.images.values();
+    }
+
+    public SidebarImage image(final String rawTitle) {
+        return this.images.get(rawTitle);
+    }
+
+    public Tag titleComponent(final String rawTitle, final String fallbackText) {
+        final SidebarImage image = this.image(rawTitle);
+        if (image == null) {
+            return TextUtil.stringToNbt(fallbackText, this.formattingColors);
+        }
+        final var component = TextUtil.stringToTextComponent(IMAGE_CHARACTER);
+        component.getStyle().setFont(Identifier.of(image.font())).setColor(0xFFFFFF);
+        return TextUtil.textComponentToNbt(component);
+    }
+
+    private static JsonObject effectiveFile(final ResourcePackStorage storage) {
+        for (ResourcePack pack : storage.getPackStackTopToBottom()) {
+            if (!storage.isServerPack(pack)) {
+                continue;
+            }
+            for (String path : loadedUiPaths(pack.content())) {
+                final byte[] bytes = pack.content().get(path);
+                if (bytes == null || bytes.length > 262144) {
+                    continue;
+                }
+                try {
+                    final JsonObject file = pack.content().getJson(path);
+                    if ("scoreboard".equals(string(file, "namespace")) && file.has("scoreboard_sidebar")) {
+                        return file;
+                    }
+                } catch (final RuntimeException ignored) {
+                    // Other JSON UI files need not use the supported direct-control form.
+                }
+            }
+        }
+        return null;
+    }
+
+    private static List<String> loadedUiPaths(final Content content) {
+        // This filename is a native vanilla UI override. Additional files must be
+        // explicitly loaded by the pack, rather than discovered by their namespace.
+        final List<String> paths = new ArrayList<>();
+        paths.add("ui/scoreboards.json");
+        if (content.contains("ui/_ui_defs.json") && content.get("ui/_ui_defs.json").length <= 262144) {
+            try {
+                final JsonElement definitions = content.getJson("ui/_ui_defs.json").get("ui_defs");
+                if (definitions != null && definitions.isJsonArray() && definitions.getAsJsonArray().size() <= 128) {
+                    for (JsonElement value : definitions.getAsJsonArray()) {
+                        if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                            final String path = value.getAsString();
+                            if (path.matches("ui/[A-Za-z0-9_./-]+\\.json") && !path.contains("..")) {
+                                paths.remove(path);
+                                paths.add(path);
+                            }
+                        }
+                    }
+                }
+            } catch (final RuntimeException ignored) {
+                // Malformed additional definitions do not activate unused UI files.
+            }
+        }
+        Collections.reverse(paths);
+        return paths;
+    }
+
+    private static void collect(final JsonObject node, final ResourcePackStorage storage, final Map<String, SidebarImage> found, final int[] count, final int depth, final int rowHeight) {
+        if (++count[0] > 512 || depth > 16 || found.size() > 64) {
+            throw new IllegalArgumentException("Scoreboard UI exceeds supported bounds");
+        }
+        if (!node.has("controls") || !node.get("controls").isJsonArray()) {
+            return;
+        }
+        final JsonArray controls = node.getAsJsonArray("controls");
+        for (JsonElement element : controls) {
+            if (!element.isJsonObject() || element.getAsJsonObject().size() != 1) {
+                continue;
+            }
+            final var entry = element.getAsJsonObject().entrySet().iterator().next();
+            if (!entry.getValue().isJsonObject()) {
+                continue;
+            }
+            final JsonObject control = entry.getValue().getAsJsonObject();
+            final String title = visibility(control, entry.getKey(), false);
+            if ("image".equals(string(control, "type")) && title != null && companion(controls, title)) {
+                final SidebarImage image = parseImage(storage, node, control, title, rowHeight);
+                if (image != null && found.putIfAbsent(title, image) != null) {
+                    throw new IllegalArgumentException("Ambiguous scoreboard image binding");
+                }
+            }
+            collect(control, storage, found, count, depth + 1, rowHeight);
+        }
+    }
+
+    private static int rowHeight(final JsonObject file, final JsonObject panel) {
+        final String name = playerFactory(panel, 0);
+        if (!name.startsWith("scoreboard.") || !file.has(name.substring(11)) || !file.get(name.substring(11)).isJsonObject()) {
+            return 9;
+        }
+        final JsonObject label = file.getAsJsonObject(name.substring(11));
+        if (!"label".equals(string(label, "type")) || !"#player_name_sidebar".equals(string(label, "text"))
+                || !label.has("size") || !label.get("size").isJsonArray()) {
+            return 9;
+        }
+        final JsonArray size = label.getAsJsonArray("size");
+        if (size.size() != 2 || !size.get(0).isJsonPrimitive() || !size.get(0).getAsJsonPrimitive().isString()
+                || !"default".equals(size.get(0).getAsString())) {
+            return 9;
+        }
+        final JsonArray numeric = new JsonArray();
+        numeric.add(size.get(1));
+        numeric.add(size.get(1));
+        final int[] values = pair(numeric, 1, 64);
+        return values == null ? 9 : values[0];
+    }
+
+    private static String playerFactory(final JsonObject node, final int depth) {
+        if (depth > 16) {
+            return "";
+        }
+        if ("scoreboard_players".equals(string(node, "collection_name")) && node.has("factory") && node.get("factory").isJsonObject()) {
+            return string(node.getAsJsonObject("factory"), "control_name");
+        }
+        if (node.has("controls") && node.get("controls").isJsonArray()) {
+            for (JsonElement wrapped : node.getAsJsonArray("controls")) {
+                if (!wrapped.isJsonObject()) {
+                    continue;
+                }
+                for (JsonElement control : wrapped.getAsJsonObject().asMap().values()) {
+                    if (control.isJsonObject()) {
+                        final String name = playerFactory(control.getAsJsonObject(), depth + 1);
+                        if (!name.isEmpty()) {
+                            return name;
+                        }
+                    }
+                }
+            }
+        }
+        return "";
+    }
+
+    private static boolean companion(final JsonArray controls, final String title) {
+        for (JsonElement element : controls) {
+            if (!element.isJsonObject() || element.getAsJsonObject().size() != 1) {
+                continue;
+            }
+            final var entry = element.getAsJsonObject().entrySet().iterator().next();
+            if (!entry.getValue().isJsonObject()) {
+                continue;
+            }
+            final JsonObject control = entry.getValue().getAsJsonObject();
+            if ("label".equals(string(control, "type")) && "#objective_sidebar_name".equals(string(control, "text"))
+                    && title.equals(visibility(control, entry.getKey(), true))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String visibility(final JsonObject control, final String name, final boolean inverse) {
+        if (!control.has("bindings") || !control.get("bindings").isJsonArray()) {
+            return null;
+        }
+        boolean global = false;
+        String title = null;
+        int views = 0;
+        for (JsonElement element : control.getAsJsonArray("bindings")) {
+            if (!element.isJsonObject()) {
+                return null;
+            }
+            final JsonObject binding = element.getAsJsonObject();
+            if ("global".equals(string(binding, "binding_type")) && "#objective_sidebar_name".equals(string(binding, "binding_name"))) {
+                global = true;
+            } else if ("view".equals(string(binding, "binding_type")) && "#visible".equals(string(binding, "target_property_name"))) {
+                if (++views > 1 || !name.equals(string(binding, "source_control_name"))
+                        || !binding.has("resolve_sibling_scope") || !binding.get("resolve_sibling_scope").getAsBoolean()) {
+                    return null;
+                }
+                final var matcher = (inverse ? INVERSE : EQUALITY).matcher(string(binding, "source_property_name"));
+                if (!matcher.matches()) {
+                    return null;
+                }
+                title = matcher.group(1);
+            } else {
+                return null;
+            }
+        }
+        return global && views == 1 ? title : null;
+    }
+
+    private static SidebarImage parseImage(final ResourcePackStorage storage, final JsonObject parent, final JsonObject control, final String title, final int rowHeight) {
+        if (!"top_middle".equals(string(control, "anchor_from")) || !"top_middle".equals(string(control, "anchor_to"))
+                || control.has("visible") && !control.get("visible").getAsBoolean()
+                || control.has("alpha") && control.get("alpha").getAsDouble() != 1
+                || control.has("ignored") && control.get("ignored").getAsBoolean()) {
+            return null;
+        }
+        final int[] size = pair(control.get("size"), 1, 1024);
+        final int[] offset = control.has("offset") ? pair(control.get("offset"), -1024, 1024) : new int[]{0, 0};
+        final String path = string(control, "texture");
+        if (size == null || offset == null || !path.matches("textures/[A-Za-z0-9_./-]+") || path.contains("..")) {
+            return null;
+        }
+        final PanelBackground background;
+        if ("image".equals(string(parent, "type"))) {
+            background = parseBackground(storage, parent);
+            if (background == null) {
+                return null;
+            }
+        } else {
+            background = null;
+        }
+        for (ResourcePack pack : storage.getPackStackTopToBottom()) {
+            final String fullPath = pack.content().getFullPath(path, "png", "jpg", "tga");
+            if (fullPath == null) {
+                continue;
+            }
+            final byte[] bytes = pack.content().get(fullPath);
+            if (bytes.length > 8388608) {
+                return null;
+            }
+            final Content.LazyImage image = pack.content().getImage(fullPath);
+            if (image == null || image.getImage().getWidth() > 4096 || image.getImage().getHeight() > 4096) {
+                return null;
+            }
+            final String hash = hash(title + "\n" + path + "\n" + Arrays.toString(size) + Arrays.toString(offset) + rowHeight + background);
+            return new SidebarImage(title, "viabedrock:scoreboard/" + hash, "viabedrock:textures/scoreboard/" + hash + ".png", size[0], size[1], offset[0], offset[1], rowHeight, fullPath, background);
+        }
+        return null;
+    }
+
+    private static PanelBackground parseBackground(final ResourcePackStorage storage, final JsonObject control) {
+        if (!Set.of("type", "texture", "alpha", "size", "anchor_from", "anchor_to", "controls", "visible", "ignored").containsAll(control.keySet())
+                || !"center".equals(string(control, "anchor_from")) || !"center".equals(string(control, "anchor_to"))
+                || control.has("visible") && !control.get("visible").getAsBoolean()
+                || control.has("ignored") && control.get("ignored").getAsBoolean()) {
+            return null;
+        }
+        final JsonElement size = control.get("size");
+        if (size == null || !size.isJsonArray() || size.getAsJsonArray().size() != 2) {
+            return null;
+        }
+        final Integer paddingX = padding(size.getAsJsonArray().get(0), "100%cm");
+        final Integer paddingY = padding(size.getAsJsonArray().get(1), "100%c");
+        final double alpha = control.has("alpha") ? control.get("alpha").getAsDouble() : 1;
+        final String path = string(control, "texture");
+        if (paddingX == null || paddingY == null || !Double.isFinite(alpha) || alpha <= 0 || alpha > 1
+                || !path.matches("textures/[A-Za-z0-9_./-]+") || path.contains("..")) {
+            return null;
+        }
+        JsonObject list = null;
+        for (final JsonElement wrapped : control.getAsJsonArray("controls")) {
+            if (!wrapped.isJsonObject()) {
+                continue;
+            }
+            for (final JsonElement candidate : wrapped.getAsJsonObject().asMap().values()) {
+                if (candidate.isJsonObject() && !playerFactory(candidate.getAsJsonObject(), 0).isEmpty()) {
+                    if (list != null) {
+                        return null;
+                    }
+                    list = candidate.getAsJsonObject();
+                }
+            }
+        }
+        if (list == null || !Set.of("type", "anchor_from", "anchor_to", "offset", "size", "inherit_max_sibling_width", "controls").containsAll(list.keySet())
+                || !"panel".equals(string(list, "type"))
+                || !"bottom_left".equals(string(list, "anchor_from")) || !"bottom_left".equals(string(list, "anchor_to"))
+                || list.has("bindings") || list.has("ignored") && list.get("ignored").getAsBoolean()) {
+            return null;
+        }
+        final int[] rowOffset = list.has("offset") ? pair(list.get("offset"), -1024, 1024) : new int[]{0, 0};
+        if (rowOffset == null) {
+            return null;
+        }
+        JsonObject metadata = null;
+        for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+            if (pack.content().contains(path + ".json")) {
+                if (pack.content().get(path + ".json").length > 65536) {
+                    return null;
+                }
+                metadata = pack.content().getJson(path + ".json");
+                break;
+            }
+        }
+        if (metadata == null) {
+            return null;
+        }
+        final int[] baseSize = pair(metadata.get("base_size"), 1, 1024);
+        final JsonArray borderPair = new JsonArray();
+        if (metadata.has("nineslice_size")) {
+            borderPair.add(metadata.get("nineslice_size"));
+            borderPair.add(metadata.get("nineslice_size"));
+        }
+        final int[] border = pair(borderPair, 0, 512);
+        if (baseSize == null || border == null || border[0] * 2 > Math.min(baseSize[0], baseSize[1])) {
+            return null;
+        }
+        for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+            final String fullPath = pack.content().getFullPath(path, "png", "jpg", "tga");
+            if (fullPath == null) {
+                continue;
+            }
+            if (pack.content().get(fullPath).length > 8388608) {
+                return null;
+            }
+            final Content.LazyImage image = pack.content().getImage(fullPath);
+            if (image == null || image.getImage().getWidth() > 4096 || image.getImage().getHeight() > 4096) {
+                return null;
+            }
+            return new PanelBackground(fullPath, (float) alpha, baseSize[0], baseSize[1], border[0], paddingX, paddingY, rowOffset[0], rowOffset[1]);
+        }
+        return null;
+    }
+
+    private static Integer padding(final JsonElement value, final String size) {
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+            return null;
+        }
+        final var match = Pattern.compile(Pattern.quote(size) + "(?:\\+([0-9]{1,4})px)?").matcher(value.getAsString());
+        if (!match.matches()) {
+            return null;
+        }
+        final int padding = match.group(1) == null ? 0 : Integer.parseInt(match.group(1));
+        return padding <= 1024 ? padding : null;
+    }
+
+    public static int[] pair(final JsonElement value, final int min, final int max) {
+        if (value == null || !value.isJsonArray() || value.getAsJsonArray().size() != 2) {
+            return null;
+        }
+        final int[] result = new int[2];
+        for (int i = 0; i < 2; i++) {
+            final JsonElement number = value.getAsJsonArray().get(i);
+            if (!number.isJsonPrimitive() || !number.getAsJsonPrimitive().isNumber()) {
+                return null;
+            }
+            final double n = number.getAsDouble();
+            if (!Double.isFinite(n) || n != Math.rint(n) || n < min || n > max) {
+                return null;
+            }
+            result[i] = (int) n;
+        }
+        return result;
+    }
+
+    private static String string(final JsonObject object, final String key) {
+        final JsonElement value = object.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
+
+    private static String hash(final String value) {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(value.getBytes(StandardCharsets.UTF_8)));
+        } catch (final NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    public record PanelBackground(String sourcePath, float alpha, int baseWidth, int baseHeight, int slice, int paddingX, int paddingY, int rowOffsetX, int rowOffsetY) {
+    }
+
+    public record SidebarImage(String match, String font, String texture, int width, int height, int offsetX, int offsetY, int rowHeight, String sourcePath, PanelBackground background) {
+    }
+
+}
