+    void changedConversionFormatRebuildsDiskOutputWithoutReusingThePreviousArchive() {
+        final AtomicInteger conversions = new AtomicInteger();
+        final ConvertedResourcePackCache previous = new ConvertedResourcePackCache(this.directory, ViaBedrockConfig.PackCacheMode.DISK, storage -> {
+            conversions.incrementAndGet();
+            final InMemoryContent content = new InMemoryContent();
+            content.put("assets/example/output", new byte[]{1});
+            return content;
+        }, "previous-converter");
+        final ConvertedResourcePackCache.Pack oldOutput;
+        try {
+            oldOutput = previous.prepare(new ResourcePackStorage(List.of())).join();
+        } finally {
+            previous.stop();
+        }
+        final ConvertedResourcePackCache current = new ConvertedResourcePackCache(this.directory, ViaBedrockConfig.PackCacheMode.DISK, storage -> {
+            conversions.incrementAndGet();
