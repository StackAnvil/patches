+package net.raphimc.viabedrock.api.util;
+
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import com.viaversion.viaversion.libs.mcstructs.text.utils.TextUtils;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class TextPaletteFormattingTest {
+
+    @Test
+    void retainsStylesAcrossTargetPaletteCodesMissingFromTheFormattingLibrary() {
+        final TextComponent component = TextUtil.stringToTextComponent("§l§oA§wB§rC", Map.of('w', 0x3366CC));
+        final List<TextComponent> parts = new ArrayList<>();
+        TextUtils.iterateAll(component, part -> {
+            if (!part.asSingleString().isEmpty()) {
+                parts.add(part);
+            }
+        });
+        assertEquals(3, parts.size());
+        assertEquals(0x3366CC, parts.get(1).getStyle().getColor().getRgbValue());
+        assertTrue(parts.get(1).getStyle().isBold());
+        assertTrue(parts.get(1).getStyle().isItalic());
+        assertFalse(parts.get(parts.size() - 1).getStyle().isBold());
+        assertFalse(parts.get(parts.size() - 1).getStyle().isItalic());
+    }
+
+}
