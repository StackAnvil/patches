+package net.raphimc.viabedrock.api.model.scoreboard;
+
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.util.TextUtil;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.IdentityDefinition_Type;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ObjectiveSortOrder;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ScoreboardPresentationTest {
+
+    @Test
+    void translatesExtendedColorsWithoutChangingScoreIdentityOrOrdering() throws Exception {
+        final String rawName = "§pGold §qGreen §fName";
+        final var entry = new ScoreboardEntry(17, IdentityDefinition_Type.FakePlayer, null, rawName);
+        entry.updateJavaName(null);
+        for (final var order : new ObjectiveSortOrder[]{ObjectiveSortOrder.Ascending, ObjectiveSortOrder.Descending}) {
+            final var objective = new ScoreboardObjective("ranking", order);
+            final var packet = new PacketWrapperImpl(ClientboundPackets26_3.SET_SCORE, null, null);
+            objective.writeJavaScore(packet, entry);
+            final var buffer = Unpooled.buffer();
+            try {
+                packet.writeToBuffer(buffer);
+                assertEquals(ClientboundPackets26_3.SET_SCORE.getId(), Types.VAR_INT.read(buffer));
+                assertEquals(rawName, Types.STRING.read(buffer));
+                assertEquals("ranking", Types.STRING.read(buffer));
+                assertEquals(order == ObjectiveSortOrder.Ascending ? -17 : 17, Types.VAR_INT.read(buffer));
+                assertEquals(TextUtil.stringToNbt(rawName), Types.OPTIONAL_TAG.read(buffer));
+                assertFalse(Types.BOOLEAN.read(buffer));
+                assertEquals(0, buffer.readableBytes());
+                assertEquals(rawName, entry.javaName());
+                assertEquals(17, entry.score());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void sidebarPaletteDoesNotChangeTheOwnerOrScore() throws Exception {
+        final var objective = new ScoreboardObjective("ui", ObjectiveSortOrder.Descending);
+        objective.setFormattingColors(null, Map.of('9', 0x3AA9FF));
+        final var entry = new ScoreboardEntry(5, IdentityDefinition_Type.FakePlayer, null, "§9Player");
+        entry.updateJavaName(null);
+        final var packet = new PacketWrapperImpl(ClientboundPackets26_3.SET_SCORE, null, null);
+        objective.writeJavaScore(packet, entry);
+        assertEquals("§9Player", packet.get(Types.STRING, 0));
+        assertEquals(5, packet.get(Types.VAR_INT, 0));
+        assertEquals(TextUtil.stringToNbt("§9Player", Map.of('9', 0x3AA9FF)), packet.get(Types.OPTIONAL_TAG, 0));
+        objective.setFormattingColors(null, Map.of());
+        final var ordinary = new PacketWrapperImpl(ClientboundPackets26_3.SET_SCORE, null, null);
+        objective.writeJavaScore(ordinary, entry);
+        assertEquals(TextUtil.stringToNbt("§9Player"), ordinary.get(Types.OPTIONAL_TAG, 0));
+        assertEquals(entry.javaName(), packet.get(Types.STRING, 0));
+    }
+
+}
