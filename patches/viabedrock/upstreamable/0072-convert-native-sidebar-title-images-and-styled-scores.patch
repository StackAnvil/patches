+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.util.TextUtil;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class TextFormattingDefinitionsTest {
+
+    @Test
+    void effectiveColorsUsePackPriorityAndNearestRgbWithoutChangingDefaultFormatting() {
+        final var lower = new JsonObject();
+        lower.add("$9_color_format", rgb(1, 0, 0));
+        lower.add("$a_color_format", rgb(0, 1, 0));
+        lower.add("$b_color_format", rgb(0.5, 0.1, 1));
+        final var higher = new JsonObject();
+        higher.add("$9_color_format", rgb(0.22745098, 0.662745098, 1));
+        final var colors = new ResourcePackStorage(List.of(pack(higher), pack(lower))).getTextFormatting().colors();
+        assertEquals(0x3AA9FF, colors.get('9'));
+        assertEquals(0x00FF00, colors.get('a'));
+        assertEquals(0x801AFF, colors.get('b'));
+        assertEquals(0x3AA9FF, TextUtil.stringToTextComponent("§9Blue", colors).getStyle().getColor().getRgbValue());
+        assertEquals(0x5555FF, TextUtil.stringToTextComponent("§9Blue").getStyle().getColor().getRgbValue());
+        assertTrue(TextUtil.stringToTextComponent("§l§9Blue", colors).getStyle().isBold());
+        assertThrows(UnsupportedOperationException.class, () -> colors.put('b', 0));
+    }
+
+    @Test
+    void nativeNamedColorsBindToTheirMaterialCodesAndIgnoreExtraChannels() {
+        final String[] names = {"coin", "material_quartz", "material_iron", "material_netherite", "material_redstone",
+            "material_copper", "material_gold", "material_emerald", "material_diamond", "material_lapis",
+            "material_amethyst", "material_resin", "party_blue"};
+        final String allCodes = "ghijmnpqstuvw";
+        final var variables = new JsonObject();
+        for (int i = 0; i < names.length; i++) {
+            final var color = rgb(i / 255D, (i + 17) / 255D, (i + 33) / 255D);
+            color.add("$ignored_alpha");
+            variables.add("$" + names[i] + "_color", color);
+        }
+        final var colors = new ResourcePackStorage(List.of(pack(variables))).getTextFormatting().colors();
+        assertEquals(names.length, colors.size());
+        for (int i = 0; i < names.length; i++) {
+            assertEquals(i << 16 | i + 17 << 8 | i + 33, colors.get(allCodes.charAt(i)));
+        }
+    }
+
+    @Test
+    void materialOverrideChangesBothLowercaseAndUppercaseLegacyCodes() {
+        final var lower = new JsonObject();
+        lower.add("$material_gold_color", rgb(1, 0, 0));
+        lower.add("$material_emerald_color", rgb(0, 0, 1));
+        final var higher = new JsonObject();
+        higher.add("$material_gold_color", rgb(0.541, 0.824, 0.173));
+        final var colors = new ResourcePackStorage(List.of(pack(higher), pack(lower))).getTextFormatting().colors();
+        assertEquals(0x8AD22C, colors.get('p'));
+        assertEquals(0x0000FF, colors.get('q'));
+        assertEquals(0x8AD22C, TextUtil.stringToTextComponent("§pMaterial", colors).getStyle().getColor().getRgbValue());
+        assertEquals(0x8AD22C, TextUtil.stringToTextComponent("§PMaterial", colors).getStyle().getColor().getRgbValue());
+        assertEquals(0xDEB12D, TextUtil.stringToTextComponent("§pMaterial").getStyle().getColor().getRgbValue());
+    }
+
+    @Test
+    void unsupportedHigherColorsDoNotReviveLowerDefinitions() {
+        final var lower = new JsonObject();
+        lower.add("$9_color_format", rgb(1, 0, 0));
+        lower.add("$material_gold_color", rgb(1, 0, 0));
+        for (final var invalid : List.of(new JsonPrimitive("$dynamic_color"), rgb(-1, 0, 0), rgb(0, 2, 0),
+                rgb(0, 0, Double.POSITIVE_INFINITY), rgb(Double.NaN, 0, 0), new JsonArray())) {
+            final var higher = new JsonObject();
+            higher.add("$9_color_format", invalid);
+            higher.add("$material_gold_color", invalid);
+            final var colors = new ResourcePackStorage(List.of(pack(higher), pack(lower))).getTextFormatting().colors();
+            assertFalse(colors.containsKey('9'));
+            assertFalse(colors.containsKey('p'));
+        }
+    }
+
+    private static JsonArray rgb(final double red, final double green, final double blue) {
+        final var rgb = new JsonArray();
+        rgb.add(red);
+        rgb.add(green);
+        rgb.add(blue);
+        return rgb;
+    }
+
+    private static ResourcePack pack(final JsonObject variables) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        content.putJson("ui/_global_variables.json", variables);
+        return new ResourcePack(content);
+    }
+
+}
