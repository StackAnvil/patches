+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/** Static formatting-color overrides from the effective server UI globals. */
+public final class TextFormattingDefinitions {
+
+    private static final Map<Character, String> COLOR_VARIABLES = colorVariables();
+    private final Map<Character, Integer> colors;
+
+    public TextFormattingDefinitions(final ResourcePackStorage storage) {
+        final Map<Character, Integer> colors = new HashMap<>();
+        final Set<Character> seen = new HashSet<>();
+        for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+            if (!storage.isServerPack(pack) || !pack.content().contains("ui/_global_variables.json")
+                    || pack.content().get("ui/_global_variables.json").length > 262144) {
+                continue;
+            }
+            try {
+                final JsonObject variables = pack.content().getJson("ui/_global_variables.json");
+                for (final var entry : COLOR_VARIABLES.entrySet()) {
+                    final char code = entry.getKey();
+                    if (!variables.has(entry.getValue()) || !seen.add(code)) {
+                        continue;
+                    }
+                    final Integer color = rgb(variables.get(entry.getValue()));
+                    if (color != null) {
+                        colors.put(code, color);
+                    }
+                }
+            } catch (final RuntimeException ignored) {
+                // Dynamic variables and malformed files are outside this static subset.
+            }
+        }
+        this.colors = Map.copyOf(colors);
+    }
+
+    public Map<Character, Integer> colors() {
+        return this.colors;
+    }
+
+    private static Map<Character, String> colorVariables() {
+        final Map<Character, String> variables = new HashMap<>();
+        for (final char code : "0123456789abcdef".toCharArray()) {
+            variables.put(code, "$" + code + "_color_format");
+        }
+        // Bedrock 1.26.51.1's UI globals reader writes these named variables
+        // into the same formatting table as the ordinary color codes.
+        variables.put('g', "$coin_color");
+        variables.put('h', "$material_quartz_color");
+        variables.put('i', "$material_iron_color");
+        variables.put('j', "$material_netherite_color");
+        variables.put('m', "$material_redstone_color");
+        variables.put('n', "$material_copper_color");
+        variables.put('p', "$material_gold_color");
+        variables.put('q', "$material_emerald_color");
+        variables.put('s', "$material_diamond_color");
+        variables.put('t', "$material_lapis_color");
+        variables.put('u', "$material_amethyst_color");
+        variables.put('v', "$material_resin_color");
+        variables.put('w', "$party_blue_color");
+        return Map.copyOf(variables);
+    }
+
+    private static Integer rgb(final JsonElement value) {
+        if (!value.isJsonArray() || value.getAsJsonArray().size() < 3) {
+            return null;
+        }
+        int rgb = 0;
+        for (int i = 0; i < 3; i++) {
+            final JsonElement channel = value.getAsJsonArray().get(i);
+            if (!channel.isJsonPrimitive() || !channel.getAsJsonPrimitive().isNumber()) {
+                return null;
+            }
+            final float n = channel.getAsFloat();
+            if (!Float.isFinite(n) || n < 0F || n > 1F) {
+                return null;
+            }
+            rgb = rgb << 8 | Math.round(n * 255F);
+        }
+        return rgb;
+    }
+
+}
