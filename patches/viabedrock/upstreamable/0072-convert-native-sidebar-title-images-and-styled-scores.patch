+
+import java.awt.image.BufferedImage;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+public final class ScoreboardUiResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> convert(storage));
+    }
+
+    public static Content convert(final ResourcePackStorage storage) {
+        final Content output = new InMemoryContent();
+        final JsonArray images = new JsonArray();
+        for (ScoreboardUiDefinitions.SidebarImage image : storage.getScoreboardUi().images()) {
+            for (ResourcePack pack : storage.getPackStackTopToBottom()) {
+                if (!pack.content().contains(image.sourcePath())) {
+                    continue;
+                }
+                final String texturePath = "assets/viabedrock/" + image.texture().substring("viabedrock:".length());
+                final BufferedImage original = pack.content().getImage(image.sourcePath()).getImage();
+                output.putPngImage(texturePath, original);
+                // Vanilla Java has a nine-pixel header. Keep its fallback compact, while the
+                // add-on draws the original texture at the separately advertised authored size.
+                final BufferedImage stretched = new BufferedImage(image.width(), image.height(), BufferedImage.TYPE_INT_ARGB);
+                final var graphics = stretched.createGraphics();
+                try {
+                    graphics.drawImage(original, 0, 0, image.width(), image.height(), null);
+                } finally {
+                    graphics.dispose();
+                }
+                final String fallback = image.texture().replace(".png", "_font.png");
+                output.putPngImage("assets/viabedrock/" + fallback.substring("viabedrock:".length()), stretched);
+                final JsonObject provider = new JsonObject();
+                provider.addProperty("type", "bitmap");
+                provider.addProperty("file", fallback.replace("viabedrock:textures/", "viabedrock:"));
+                provider.addProperty("height", 9);
+                provider.addProperty("ascent", 8);
+                final JsonArray characters = new JsonArray();
+                characters.add(ScoreboardUiDefinitions.IMAGE_CHARACTER);
+                provider.add("chars", characters);
+                final JsonArray providers = new JsonArray();
+                providers.add(provider);
+                final JsonObject font = new JsonObject();
+                font.add("providers", providers);
+                output.putJson("assets/viabedrock/font/" + image.font().substring("viabedrock:".length()) + ".json", font);
+                final JsonObject entry = new JsonObject();
+                entry.addProperty("font", image.font());
+                entry.addProperty("texture", image.texture());
+                entry.addProperty("width", image.width());
+                entry.addProperty("height", image.height());
+                entry.addProperty("row_height", image.rowHeight());
+                entry.addProperty("offset_x", image.offsetX());
+                entry.addProperty("offset_y", image.offsetY());
+                if (image.background() != null) {
+                    final var background = image.background();
+                    final String backgroundTexture = image.texture().replace(".png", "_background.png");
+                    for (final ResourcePack backgroundPack : storage.getPackStackTopToBottom()) {
+                        if (backgroundPack.content().contains(background.sourcePath())) {
+                            output.putPngImage("assets/viabedrock/" + backgroundTexture.substring("viabedrock:".length()),
+                                    backgroundPack.content().getImage(background.sourcePath()).getImage());
+                            break;
+                        }
+                    }
+                    final JsonObject panel = new JsonObject();
+                    panel.addProperty("texture", backgroundTexture);
+                    panel.addProperty("alpha", background.alpha());
+                    panel.addProperty("base_width", background.baseWidth());
+                    panel.addProperty("base_height", background.baseHeight());
+                    panel.addProperty("slice", background.slice());
+                    panel.addProperty("padding_x", background.paddingX());
+                    panel.addProperty("padding_y", background.paddingY());
+                    panel.addProperty("row_offset_x", background.rowOffsetX());
+                    panel.addProperty("row_offset_y", background.rowOffsetY());
+                    entry.add("background", panel);
+                }
+                images.add(entry);
+                break;
+            }
+        }
+        if (!images.isEmpty()) {
+            final JsonObject metadata = new JsonObject();
+            metadata.addProperty("format", 1);
+            metadata.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            metadata.add("images", images);
+            output.putJson("assets/viabedrock/scoreboard_ui.json", metadata);
+        }
+        return output;
+    }
+
+}
