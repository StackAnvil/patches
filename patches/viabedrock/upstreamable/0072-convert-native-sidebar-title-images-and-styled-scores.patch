+            assertEquals(2, conversions.get());
+            assertEquals(rebuilt.sha1(), current.prepare(new ResourcePackStorage(List.of())).join().sha1());
+            assertEquals(2, conversions.get());
+        } finally {
+            current.stop();
+        }
+    }
