+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.Vector3d;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.api.model.NativeActorHitboxes;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.api.model.NativeActorPickingMessage;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.HashMap;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class InteractionHitboxProxiesTest {
+
+    @Test
+    void movesEveryPartWithoutReplacingAliasIdentityAndRemovesStaleTargets() {
+        final var ids = new AtomicInteger(100);
+        final List<InteractionHitboxProxies.Change> changes = new ArrayList<>();
+        final var proxies = new InteractionHitboxProxies(ids::getAndIncrement, changes::add);
+        final var first = box(Position3f.ZERO, new Position3f(1F, 2F, 1F));
+        final var second = box(new Position3f(3F, 1F, 0F), new Position3f(2F, 2F, 2F));
+        proxies.update(7, Position3f.ZERO, List.of(first));
+        assertTrue(changes.isEmpty());
+        proxies.spawn(7, new Position3f(10F, 20F, 30F), List.of(first, second));
+        assertEquals(2, changes.size());
+        final var original = proxies.alias(100);
+        assertEquals(new Position3f(10F, 19F, 30F), original.position());
+        assertEquals(new Position3f(13F, 20F, 30F), proxies.alias(101).position());
+        changes.clear();
+        proxies.update(7, new Position3f(11F, 22F, 33F), List.of(first, second));
+        assertEquals(2, changes.size());
+        assertEquals(original.uuid(), proxies.alias(100).uuid());
+        assertEquals(new Position3f(11F, 21F, 33F), proxies.alias(100).position());
+        proxies.update(7, new Position3f(11F, 22F, 33F), List.of(first));
+        assertNull(proxies.alias(101));
+        assertInstanceOf(InteractionHitboxProxies.Remove.class, changes.getLast());
+        proxies.remove(7);
+        assertNull(proxies.alias(100));
+        final int count = changes.size();
+        proxies.remove(7);
+        assertEquals(count, changes.size());
+    }
+
+    @Test
+    void emptyMetadataFallsBackAndLaterBoxesGetFreshAliases() {
+        final List<InteractionHitboxProxies.Change> changes = new ArrayList<>();
+        final var ids = new AtomicInteger(10);
+        final var proxies = new InteractionHitboxProxies(ids::getAndIncrement, changes::add);
+        final var box = box(Position3f.ZERO, new Position3f(1F, 2F, 1F));
+        proxies.spawn(1, Position3f.ZERO, List.of(box));
+        proxies.update(1, Position3f.ZERO, List.of());
+        assertNull(proxies.alias(10));
+        proxies.update(1, Position3f.ZERO, List.of(box));
+        assertNotNull(proxies.alias(11));
+        assertEquals(3, changes.size());
+        proxies.update(1, Position3f.ZERO, List.of(box));
+        assertEquals(3, changes.size());
+    }
+
+    @Test
+    void nonemptyDegenerateBoxesStillOwnPickingTargets() {
+        final List<InteractionHitboxProxies.Change> changes = new ArrayList<>();
+        final var proxies = new InteractionHitboxProxies(() -> 10, changes::add);
+        proxies.spawn(7, Position3f.ZERO, List.of(box(Position3f.ZERO, Position3f.ZERO)));
+        assertEquals(1, changes.size());
+        assertNotNull(proxies.alias(10));
+        assertEquals(Position3f.ZERO, proxies.alias(10).box().dimensions());
+        proxies.update(7, Position3f.ZERO, List.of());
+        assertNull(proxies.alias(10));
+    }
+
+    @Test
+    void reusesOwnerOnlyAfterRemovingAllPriorAliasTargets() {
+        final List<InteractionHitboxProxies.Change> changes = new ArrayList<>();
+        final var ids = new AtomicInteger(10);
+        final var proxies = new InteractionHitboxProxies(ids::getAndIncrement, changes::add);
+        proxies.spawn(1, Position3f.ZERO, List.of(box(Position3f.ZERO, new Position3f(1F, 2F, 1F))));
+        proxies.spawn(1, Position3f.ZERO, List.of(box(Position3f.ZERO, new Position3f(2F, 3F, 2F))));
+        assertNull(proxies.alias(10));
+        assertNotNull(proxies.alias(11));
+        assertInstanceOf(InteractionHitboxProxies.Remove.class, changes.get(1));
+    }
+
+    @Test
+    void productionTrackerRoutesAliasToNativeOwnerAndUsesClickedProxyOrigin() throws Exception {
+        final var holder = new AtomicReference<EntityTracker>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) ->
+                        method.getName().equals("get") && args[0] == EntityTracker.class ? holder.get() : null);
+        final var tracker = new EntityTracker(user);
+        holder.set(tracker);
