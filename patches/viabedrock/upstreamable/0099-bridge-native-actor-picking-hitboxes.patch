+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.GameType;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ClientPlayerInteractionRangeTest {
+
+    @Test
+    void publishesNativeReachAtJoinAndOnModeChanges() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+        final var attributes = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("javaEntityAttributes");
+        attributes.setAccessible(true);
+        final Object previous = attributes.get(BedrockProtocol.MAPPINGS);
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        final var session = mock(GameSessionStorage.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.CONFIGURATION);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        when(session.getLevelGameType()).thenReturn(GameType.Survival);
+        final var player = new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+        final List<PacketWrapper> sent = new ArrayList<>();
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            attributes.set(BedrockProtocol.MAPPINGS, HashBiMap.create(Map.of(
+                    "minecraft:block_interaction_range", 10, "minecraft:entity_interaction_range", 11)));
+            packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.UPDATE_ATTRIBUTES, user)).thenAnswer(invocation ->
+                    new PacketWrapperImpl(ClientboundPackets26_3.UPDATE_ATTRIBUTES, null, user) {
+                        @Override
+                        public void send(final Class<? extends Protocol> protocol, final boolean skipCurrentPipeline) {
+                            sent.add(this);
+                        }
+                    });
+            player.setGameType(GameType.Survival);
+            assertTrue(sent.isEmpty());
+            player.setInitiallySpawned();
+            player.sendInteractionRanges();
+            player.setGameType(GameType.Creative);
+            player.setGameType(GameType.Survival);
+            player.setGameType(GameType.Default);
+            when(session.getLevelGameType()).thenReturn(GameType.Creative);
+            player.updateJavaGameMode();
+            player.setGameType(GameType.Undefined);
+            final double[] ranges = {3D, (double) 5.7F, 3D, 3D, (double) 5.7F, 3D};
+            assertEquals(ranges.length, sent.size());
+            for (int i = 0; i < ranges.length; i++) {
+                final PacketWrapper packet = sent.get(i);
+                assertEquals(player.javaId(), packet.get(Types.VAR_INT, 0));
+                assertEquals(2, packet.get(Types.VAR_INT, 1));
+                assertEquals(10, packet.get(Types.VAR_INT, 2));
+                assertEquals((double) 5.7F, packet.get(Types.DOUBLE, 0));
+                assertEquals(0, packet.get(Types.VAR_INT, 3));
+                assertEquals(11, packet.get(Types.VAR_INT, 4));
+                assertEquals(ranges[i], packet.get(Types.DOUBLE, 1));
+                assertEquals(0, packet.get(Types.VAR_INT, 5));
+            }
+        } finally {
+            attributes.set(BedrockProtocol.MAPPINGS, previous);
+        }
+    }
+
+}
