+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorHitboxesTest {
+
+    @Test
+    void recentersPickingExtentsWithoutChangingPhysicalDimensionsOrAuthoredTag() {
+        final CompoundTag box = box(-.5F, 0F, -.5F, .5F, 2F, .5F);
+        final CompoundTag tag = root(box);
+        final CompoundTag before = tag.copy();
+        final Entity actor = new Entity(null, 1, 4, null, 1, null, EntityTypes26_3.INTERACTION);
+        actor.entityData().put(ActorDataIds.RESERVED_053, new EntityData(53, EntityDataTypesBedrock.FLOAT, 0F));
+        actor.entityData().put(ActorDataIds.RESERVED_054, new EntityData(54, EntityDataTypesBedrock.FLOAT, 0F));
+        actor.entityData().put(ActorDataIds.RESERVED_038, new EntityData(38, EntityDataTypesBedrock.FLOAT, 3F));
+        actor.entityData().put(ActorDataIds.HITBOX, metadata(tag));
+        final var picking = actor.pickingHitboxes().getFirst();
+        assertEquals(new Position3f(1F, 2F, 1F), picking.dimensions());
+        assertEquals(new Position3f(-1019.5F, 40F, -9.5F), picking.interactionPosition(new Position3f(-1019.5F, 41F, -9.5F)));
+        assertEquals(.005F, actor.boundingBoxDimensions().width().orElseThrow());
+        assertEquals(.005F, actor.boundingBoxDimensions().height().orElseThrow());
+        assertEquals(before, tag);
+    }
+
+    @Test
+    void sortsReversedEndpointsAndUsesPivotRatherThanAuthoredCenter() {
+        final CompoundTag box = box(3F, 5F, 2F, -1F, 1F, -4F);
+        box.putFloat("PivotX", 1F);
+        box.putFloat("PivotY", 2F);
+        box.putFloat("PivotZ", -3F);
+        final var picking = NativeActorHitboxes.read(metadata(root(box))).getFirst();
+        assertEquals(new Position3f(4F, 4F, 6F), picking.dimensions());
+        assertEquals(new Position3f(11F, 20F, 27F), picking.interactionPosition(new Position3f(10F, 20F, 30F)));
+        assertEquals(6F, picking.interactionWidth());
+        assertEquals(new Position3f(21F, 30F, 37F), picking.interactionPosition(new Position3f(20F, 30F, 40F)));
+    }
+
+    @Test
+    void acceptsOnlyNativeFloatTagsAndPreservesMultipartOrder() {
+        final CompoundTag first = box(-.5F, 0F, -.5F, .5F, 2F, .5F);
+        first.putInt("MaxY", 2);
+        final CompoundTag second = box(-1F, -1F, -1F, 1F, 1F, 1F);
+        final List<NativeActorHitboxes.Box> boxes = NativeActorHitboxes.read(metadata(root(first, second)));
+        assertEquals(2, boxes.size());
+        assertEquals(0F, boxes.getFirst().dimensions().y());
+        assertEquals(new Position3f(2F, 2F, 2F), boxes.getLast().dimensions());
+        assertThrows(UnsupportedOperationException.class, () -> boxes.clear());
+    }
+
+    @Test
+    void boundsMalformedMetadataAndEmptyBoxFallback() {
+        assertEquals(List.of(), NativeActorHitboxes.read(null));
+        assertEquals(List.of(), NativeActorHitboxes.read(new EntityData(118, EntityDataTypesBedrock.INT, 2)));
+        assertEquals(List.of(), NativeActorHitboxes.read(metadata(new CompoundTag())));
+        assertEquals(List.of(), NativeActorHitboxes.read(metadata(root())));
+        final CompoundTag bad = box(0F, 0F, 0F, 1F, 1F, Float.NaN);
+        assertEquals(List.of(), NativeActorHitboxes.read(metadata(root(bad))));
+        final CompoundTag[] tooMany = new CompoundTag[NativeActorHitboxes.MAX_BOXES + 1];
+        java.util.Arrays.fill(tooMany, box(0F, 0F, 0F, 1F, 1F, 1F));
+        assertEquals(List.of(), NativeActorHitboxes.read(metadata(root(tooMany))));
+    }
+
+    private static EntityData metadata(final CompoundTag root) {
+        return new EntityData(118, EntityDataTypesBedrock.TAG, root);
+    }
+
+    private static CompoundTag root(final CompoundTag... boxes) {
+        final CompoundTag root = new CompoundTag();
+        root.put("Hitboxes", new ListTag<>(List.of(boxes)));
+        return root;
+    }
+
+    private static CompoundTag box(final float minX, final float minY, final float minZ, final float maxX, final float maxY, final float maxZ) {
+        final CompoundTag box = new CompoundTag();
+        box.putFloat("MinX", minX);
+        box.putFloat("MinY", minY);
+        box.putFloat("MinZ", minZ);
+        box.putFloat("MaxX", maxX);
+        box.putFloat("MaxY", maxY);
+        box.putFloat("MaxZ", maxZ);
+        return box;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeActorPickingMessageTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeActorPickingMessageTest.java
