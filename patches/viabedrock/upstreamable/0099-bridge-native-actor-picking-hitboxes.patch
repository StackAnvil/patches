+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Native picking boxes, independent of the actor's physical collision dimensions. */
+public final class NativeActorHitboxes {
+
+    public static final int MAX_BOXES = 256;
+    private static final float MAX_COORDINATE = 1E9F;
+
+    private NativeActorHitboxes() {
+    }
+
+    public static List<Box> read(final EntityData metadata) {
+        if (metadata == null || metadata.dataType() != EntityDataTypesBedrock.TAG
+                || !(metadata.value() instanceof CompoundTag tag)
+                || !(tag.get("Hitboxes") instanceof ListTag<?> boxes) || boxes.size() > MAX_BOXES) {
+            return List.of();
+        }
+        final List<Box> result = new ArrayList<>(boxes.size());
+        for (var value : boxes) {
+            if (!(value instanceof CompoundTag box)) {
+                return List.of();
+            }
+            final Position3f first = vector(box, "Min");
+            final Position3f second = vector(box, "Max");
+            final Position3f pivot = vector(box, "Pivot");
+            if (!valid(first) || !valid(second) || !valid(pivot)) {
+                return List.of();
+            }
+            result.add(new Box(pivot,
+                    new Position3f(Math.min(first.x(), second.x()), Math.min(first.y(), second.y()), Math.min(first.z(), second.z())),
+                    new Position3f(Math.max(first.x(), second.x()), Math.max(first.y(), second.y()), Math.max(first.z(), second.z()))));
+        }
+        return List.copyOf(result);
+    }
+
+    private static Position3f vector(final CompoundTag tag, final String prefix) {
+        return new Position3f(component(tag, prefix + "X"), component(tag, prefix + "Y"), component(tag, prefix + "Z"));
+    }
+
+    private static float component(final CompoundTag tag, final String key) {
+        return tag.get(key) instanceof FloatTag value ? value.asFloat() : 0F;
+    }
+
+    private static boolean valid(final Position3f value) {
+        return Float.isFinite(value.x()) && Float.isFinite(value.y()) && Float.isFinite(value.z())
+                && Math.abs(value.x()) < MAX_COORDINATE && Math.abs(value.y()) < MAX_COORDINATE && Math.abs(value.z()) < MAX_COORDINATE;
+    }
+
+    public record Box(Position3f pivot, Position3f minimum, Position3f maximum) {
+
+        public Box {
+            if (!valid(pivot) || !valid(minimum) || !valid(maximum)
+                    || minimum.x() > maximum.x() || minimum.y() > maximum.y() || minimum.z() > maximum.z()) {
+                throw new IllegalArgumentException("Invalid native actor picking box");
+            }
+        }
+
+        public Position3f dimensions() {
+            return this.maximum.subtract(this.minimum);
+        }
+
+        /** The native position producer recenters extents around actor position plus pivot. */
+        public Position3f interactionPosition(final Position3f actorPosition) {
+            final Position3f dimensions = this.dimensions();
+            return new Position3f(actorPosition.x() + this.pivot.x(),
+                    actorPosition.y() - dimensions.y() * 0.5F + this.pivot.y(), actorPosition.z() + this.pivot.z());
+        }
+
+        /** Stock Java Interaction entities require equal X and Z extents. */
+        public float interactionWidth() {
+            final Position3f dimensions = this.dimensions();
+            return Math.max(dimensions.x(), dimensions.z());
+        }
+    }
+
+}
