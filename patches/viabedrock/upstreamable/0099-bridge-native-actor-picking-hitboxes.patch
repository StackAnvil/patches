+    @Test
+    void exactGeometryPublicationRequiresBothCapabilitiesAndCompletedPlayJoin() throws Exception {
+        final var state = new AtomicReference<>(State.PLAY);
+        final var protocolInfoType = UserConnection.class.getMethod("getProtocolInfo").getReturnType();
+        final Object protocolInfo = Proxy.newProxyInstance(protocolInfoType.getClassLoader(), new Class<?>[]{protocolInfoType},
+                (proxy, method, args) -> method.getName().equals("getServerState") ? state.get() : null);
+        final var channels = new ChannelStorage();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> switch (method.getName()) {
+                    case "getProtocolInfo" -> protocolInfo;
+                    case "has" -> args[0] == ChannelStorage.class;
+                    case "get" -> args[0] == ChannelStorage.class ? channels : null;
+                    default -> null;
+                });
+        final var tracker = new EntityTracker(user);
+        final var joined = EntityTracker.class.getDeclaredField("nativeActorsJoined");
+        joined.setAccessible(true);
+        joined.setBoolean(tracker, true);
+        final var available = EntityTracker.class.getDeclaredMethod("nativePickingAvailable");
+        available.setAccessible(true);
+        assertEquals(false, available.invoke(tracker));
+        channels.addChannels(List.of(NativeActorMessage.CHANNEL));
+        assertEquals(false, available.invoke(tracker));
+        channels.addChannels(List.of(NativeActorPickingMessage.CHANNEL));
+        assertEquals(true, available.invoke(tracker));
+        final var current = new ChannelStorage();
+        current.addChannels(List.of(NativeActorMessage.CURRENT_CHANNEL, NativeActorPickingMessage.CHANNEL));
+        final UserConnection currentUser = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> switch (method.getName()) {
+                    case "getProtocolInfo" -> protocolInfo;
+                    case "has" -> args[0] == ChannelStorage.class;
+                    case "get" -> args[0] == ChannelStorage.class ? current : null;
+                    default -> null;
+                });
+        final var currentTracker = new EntityTracker(currentUser);
+        joined.setBoolean(currentTracker, true);
+        assertEquals(true, available.invoke(currentTracker));
+        state.set(State.LOGIN);
+        assertEquals(false, available.invoke(tracker));
+        assertEquals(false, available.invoke(currentTracker));
+        state.set(State.PLAY);
+        joined.setBoolean(tracker, false);
+        assertEquals(false, available.invoke(tracker));
+    }
