+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** One complete attack, including the frontend's picked world position and actor lifetime. */
+public record NativeActorAttack(int target, UUID owner, UUID lifetime, Position3f position) {
+
+    public static final String CHANNEL = "viabedrock:actor_attack";
+    public static final Type<NativeActorAttack> TYPE = new Type<>(NativeActorAttack.class) {
+        @Override
+        public NativeActorAttack read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 56 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native actor attack");
+            }
+            final var attack = new NativeActorAttack(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer),
+                    Types.UUID.read(buffer), BedrockTypes.POSITION_3F.read(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native actor attack data");
+            }
+            return attack;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeActorAttack attack) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, attack.target());
+            Types.UUID.write(buffer, attack.owner());
+            Types.UUID.write(buffer, attack.lifetime());
+            BedrockTypes.POSITION_3F.write(buffer, attack.position());
+        }
+    };
+
+    public NativeActorAttack {
+        Objects.requireNonNull(owner);
+        Objects.requireNonNull(lifetime);
+        Objects.requireNonNull(position);
+        if (target < 0 || !Float.isFinite(position.x()) || !Float.isFinite(position.y()) || !Float.isFinite(position.z())) {
+            throw new IllegalArgumentException("Invalid native actor attack");
+        }
+    }
+
+}
