+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorAttackTest {
+
+    @Test
+    void preservesWorldHitAndActorIdentityWithoutOriginOffsets() {
+        final var attack = new NativeActorAttack(42, UUID.randomUUID(), UUID.randomUUID(),
+                new Position3f(-497.5F, 64.555F, -113.65531F));
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeActorAttack.TYPE.write(buffer, attack);
+            assertEquals(attack, NativeActorAttack.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsIncompleteTrailingAndUnsupportedFrames() {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeActorAttack.TYPE.write(buffer, new NativeActorAttack(42, UUID.randomUUID(), UUID.randomUUID(), Position3f.ZERO));
+            for (int length = 0; length < buffer.readableBytes(); length++) {
+                final var truncated = buffer.copy(0, length);
+                try {
+                    assertThrows(RuntimeException.class, () -> NativeActorAttack.TYPE.read(truncated));
+                } finally {
+                    truncated.release();
+                }
+            }
+            buffer.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorAttack.TYPE.read(buffer));
+            buffer.readerIndex(0).setByte(0, 1).setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorAttack.TYPE.read(buffer));
+            buffer.readerIndex(0).setByte(1, 0xB1).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorAttack.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsInvalidTargetsAndNonfiniteWorldCoordinates() {
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorAttack(-1, owner, lifetime, Position3f.ZERO));
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorAttack(1, owner, lifetime, new Position3f(Float.NaN, 1F, 2F)));
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorAttack(1, owner, lifetime, new Position3f(1F, Float.POSITIVE_INFINITY, 2F)));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeActorHitboxesTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeActorHitboxesTest.java
