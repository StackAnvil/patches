+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorPickingMessageTest {
+
+    @Test
+    void roundTripsMultipartSnapshotsEmptyFallbackAndLifetimeRemoval() {
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        final var parts = List.of(new NativeActorPickingMessage.Part(UUID.randomUUID(), 1F, 2F, .25F),
+                new NativeActorPickingMessage.Part(UUID.randomUUID(), 0F, 0F, 2F));
+        for (var message : List.of(new NativeActorPickingMessage.Snapshot(owner, lifetime, parts),
+                new NativeActorPickingMessage.Snapshot(owner, lifetime, List.of()), new NativeActorPickingMessage.Remove(owner, lifetime))) {
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeActorPickingMessage.TYPE.write(buffer, message);
+                assertEquals(message, NativeActorPickingMessage.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsNonfiniteDimensionsDuplicatePartsAndOwnerAlias() {
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorPickingMessage.Part(UUID.randomUUID(), Float.NaN, 1F, 1F));
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorPickingMessage.Part(UUID.randomUUID(), 1F, -1F, 1F));
+        final var part = new NativeActorPickingMessage.Part(UUID.randomUUID(), 1F, 2F, 1F);
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorPickingMessage.Snapshot(owner, lifetime, List.of(part, part)));
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorPickingMessage.Snapshot(owner, lifetime,
+                List.of(new NativeActorPickingMessage.Part(owner, 1F, 2F, 1F))));
+        assertThrows(IllegalArgumentException.class, () -> new NativeActorPickingMessage.Snapshot(owner, lifetime,
+                java.util.Collections.nCopies(NativeActorHitboxes.MAX_BOXES + 1, part)));
+    }
+
+    @Test
+    void rejectsTruncatedTrailingAndWrongVersionData() {
+        final var source = Unpooled.buffer();
+        try {
+            NativeActorPickingMessage.TYPE.write(source, new NativeActorPickingMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(),
+                    List.of(new NativeActorPickingMessage.Part(UUID.randomUUID(), 1F, 2F, 1F))));
+            for (int length = 0; length < source.readableBytes(); length++) {
+                final var truncated = source.copy(0, length);
+                try {
+                    assertThrows(RuntimeException.class, () -> NativeActorPickingMessage.TYPE.read(truncated));
+                } finally {
+                    truncated.release();
+                }
+            }
+            source.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorPickingMessage.TYPE.read(source));
+            source.readerIndex(0);
+            source.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorPickingMessage.TYPE.read(source));
+            source.readerIndex(0);
+            source.setByte(0, 1);
+            source.setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorPickingMessage.TYPE.read(source));
+        } finally {
+            source.release();
+        }
+    }
+
+}
