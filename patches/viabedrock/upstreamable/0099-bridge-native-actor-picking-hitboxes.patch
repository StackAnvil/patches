+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.Vector3d;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.NativeActorHitboxes;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.Consumer;
+import java.util.function.IntSupplier;
+
+/** Owned, nonphysical frontend targets for each native picking box. */
+public final class InteractionHitboxProxies {
+
+    private final IntSupplier ids;
+    private final Consumer<Change> sink;
+    private final Map<Long, List<Proxy>> owners = new HashMap<>();
+    private final Map<Integer, Proxy> aliases = new HashMap<>();
+
+    public InteractionHitboxProxies(final IntSupplier ids, final Consumer<Change> sink) {
+        this.ids = ids;
+        this.sink = sink;
+    }
+
+    public void spawn(final long ownerId, final Position3f position, final List<NativeActorHitboxes.Box> boxes) {
+        this.remove(ownerId);
+        this.owners.put(ownerId, List.of());
+        this.update(ownerId, position, boxes);
+    }
+
+    public void update(final long ownerId, final Position3f position, final List<NativeActorHitboxes.Box> boxes) {
+        final List<Proxy> previous = this.owners.get(ownerId);
+        if (previous == null || position == null) {
+            return;
+        }
+        final List<NativeActorHitboxes.Box> active = boxes;
+        final List<Proxy> next = new ArrayList<>(active.size());
+        for (int i = 0; i < active.size(); i++) {
+            final NativeActorHitboxes.Box box = active.get(i);
+            final Proxy prior = i < previous.size() ? previous.get(i) : null;
+            final Proxy proxy = new Proxy(prior == null ? this.ids.getAsInt() : prior.javaId(),
+                    prior == null ? UUID.randomUUID() : prior.uuid(), ownerId, box, box.interactionPosition(position));
+            next.add(proxy);
+            this.aliases.put(proxy.javaId(), proxy);
+            if (prior == null) {
+                this.sink.accept(new Spawn(proxy));
+            } else if (!prior.equals(proxy)) {
+                this.sink.accept(new Update(prior, proxy));
+            }
+        }
+        if (previous.size() > next.size()) {
+            this.removeProxies(previous.subList(next.size(), previous.size()));
+        }
+        this.owners.put(ownerId, List.copyOf(next));
+    }
+
+    public void remove(final long ownerId) {
+        final List<Proxy> removed = this.owners.remove(ownerId);
+        if (removed != null) {
+            this.removeProxies(removed);
+        }
+    }
+
+    private void removeProxies(final List<Proxy> proxies) {
+        if (!proxies.isEmpty()) {
+            proxies.forEach(proxy -> this.aliases.remove(proxy.javaId()));
+            this.sink.accept(new Remove(List.copyOf(proxies)));
+        }
+    }
+
+    public List<Proxy> parts(final long ownerId) {
+        return this.owners.getOrDefault(ownerId, List.of());
+    }
+
+    public Proxy alias(final int javaId) {
+        return this.aliases.get(javaId);
+    }
+
+    public static void send(final UserConnection user, final Change change) {
+        switch (change) {
+            case Spawn(var proxy) -> {
+                final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.ADD_ENTITY, user);
+                packet.write(Types.VAR_INT, proxy.javaId());
+                packet.write(Types.UUID, proxy.uuid());
+                packet.write(Types.VAR_INT, EntityTypes26_3.INTERACTION.getId());
+                packet.write(Types.DOUBLE, (double) proxy.position().x());
+                packet.write(Types.DOUBLE, (double) proxy.position().y());
+                packet.write(Types.DOUBLE, (double) proxy.position().z());
+                packet.write(Types.LOW_PRECISION_VECTOR, Vector3d.ZERO);
+                packet.write(Types.BYTE, (byte) 0);
+                packet.write(Types.BYTE, (byte) 0);
+                packet.write(Types.BYTE, (byte) 0);
+                packet.write(Types.VAR_INT, 0);
+                packet.send(BedrockProtocol.class);
+                sendDimensions(user, proxy);
+            }
+            case Update(var before, var proxy) -> {
+                if (!before.position().equals(proxy.position())) {
+                    final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.ENTITY_POSITION_SYNC, user);
+                    packet.write(Types.VAR_INT, proxy.javaId());
+                    packet.write(Types.VAR_INT, 1);
+                    packet.write(Types.VAR_INT, 1);
+                    packet.write(Types.DOUBLE, (double) proxy.position().x());
+                    packet.write(Types.DOUBLE, (double) proxy.position().y());
+                    packet.write(Types.DOUBLE, (double) proxy.position().z());
+                    packet.write(Types.VAR_INT, 3);
+                    packet.write(Types.FLOAT, 0F);
+                    packet.write(Types.FLOAT, 0F);
+                    packet.write(Types.BOOLEAN, false);
+                    packet.send(BedrockProtocol.class);
+                }
+                if (!before.box().equals(proxy.box())) {
+                    sendDimensions(user, proxy);
+                }
+            }
+            case Remove(var proxies) -> {
+                final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.REMOVE_ENTITIES, user);
+                packet.write(Types.VAR_INT_ARRAY_PRIMITIVE, proxies.stream().mapToInt(Proxy::javaId).toArray());
+                packet.send(BedrockProtocol.class);
+            }
+        }
+    }
+
+    private static void sendDimensions(final UserConnection user, final Proxy proxy) {
+        final var fields = BedrockProtocol.MAPPINGS.getJavaEntityDataFields().get(EntityTypes26_3.INTERACTION);
+        final var types = VersionedTypes.V26_3.entityDataTypes();
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.SET_ENTITY_DATA, user);
+        packet.write(Types.VAR_INT, proxy.javaId());
+        packet.write(VersionedTypes.V26_3.entityDataList, List.of(
+                new EntityData(fields.indexOf(EntityDataFields.WIDTH), types.floatType, proxy.box().interactionWidth()),
+                new EntityData(fields.indexOf(EntityDataFields.HEIGHT), types.floatType, proxy.box().dimensions().y()),
+                new EntityData(fields.indexOf(EntityDataFields.RESPONSE), types.booleanType, true)));
+        packet.send(BedrockProtocol.class);
+    }
+
+    public record Proxy(int javaId, UUID uuid, long ownerId, NativeActorHitboxes.Box box, Position3f position) {
+        public Position3f clickPosition(final Vector3d relative) {
+            return this.position.add((float) relative.x(), (float) relative.y(), (float) relative.z());
+        }
+    }
+
+    public sealed interface Change permits Spawn, Update, Remove {
+    }
+
+    public record Spawn(Proxy proxy) implements Change {
+    }
+
+    public record Update(Proxy before, Proxy proxy) implements Change {
+    }
+
+    public record Remove(List<Proxy> proxies) implements Change {
+    }
+
+}
