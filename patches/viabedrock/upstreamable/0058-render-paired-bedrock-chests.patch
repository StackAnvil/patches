+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
+import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.chunk.BlockEntityWithBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+public final class ChestBlockEntityRewriter extends LootableContainerBlockEntityRewriter {
+
+    @Override
+    public BlockEntity toJava(final UserConnection user, final BedrockBlockEntity bedrockBlockEntity) {
+        final BlockEntity javaBlockEntity = super.toJava(user, bedrockBlockEntity);
+        final int originalId = user.get(ChunkTracker.class).getJavaBlockState(bedrockBlockEntity.position());
+        final BlockState original = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(originalId);
+        final BlockState paired = withPair(original, bedrockBlockEntity);
+        if (paired == original) {
+            return javaBlockEntity;
+        }
+        final Integer javaId = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(paired);
+        return javaId == null ? javaBlockEntity : new BlockEntityWithBlockState(javaBlockEntity, javaId);
+    }
+
+    static BlockState withPair(final BlockState state, final BedrockBlockEntity blockEntity) {
+        if (state == null || !state.properties().containsKey("type") || !state.properties().containsKey("facing")) {
+            return state;
+        }
+        final CompoundTag tag = blockEntity.tag();
+        if (!(tag.get("pairx") instanceof IntTag pairX) || !(tag.get("pairz") instanceof IntTag pairZ)) {
+            return state;
+        }
+
+        final long dx = (long) pairX.asInt() - blockEntity.position().x();
+        final long dz = (long) pairZ.asInt() - blockEntity.position().z();
+        if (Math.abs(dx) + Math.abs(dz) != 1) {
+            return state;
+        }
+
+        final boolean left = switch (state.properties().get("facing")) {
+            case "north" -> dx == 1;
+            case "east" -> dz == 1;
+            case "south" -> dx == -1;
+            case "west" -> dz == -1;
+            default -> false;
+        };
+        final boolean right = switch (state.properties().get("facing")) {
+            case "north" -> dx == -1;
+            case "east" -> dz == -1;
+            case "south" -> dx == 1;
+            case "west" -> dz == 1;
+            default -> false;
+        };
+        return left ? state.withProperty("type", "left") : right ? state.withProperty("type", "right") : state;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ChestBlockEntityRewriterTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ChestBlockEntityRewriterTest.java
new file mode 100644
index 00000000..9d27bf12
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ChestBlockEntityRewriterTest.java
@@ -0,0 +1,45 @@
+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ChestBlockEntityRewriterTest {
+
+    @Test
+    void pairsAllChestVariantsOnEitherSide() {
+        for (String chest : new String[]{"chest", "trapped_chest", "copper_chest"}) {
+            for (String facing : new String[]{"north", "east", "south", "west"}) {
+                final BlockState state = BlockState.fromString("minecraft:" + chest + "[facing=" + facing + ",type=single,waterlogged=false]");
+                final int[] leftOffset = switch (facing) {
+                    case "north" -> new int[]{1, 0};
+                    case "east" -> new int[]{0, 1};
+                    case "south" -> new int[]{-1, 0};
+                    default -> new int[]{0, -1};
+                };
+                assertEquals(state.withProperty("type", "left"), ChestBlockEntityRewriter.withPair(state, chestAt(leftOffset[0], leftOffset[1])));
+                assertEquals(state.withProperty("type", "right"), ChestBlockEntityRewriter.withPair(state, chestAt(-leftOffset[0], -leftOffset[1])));
+            }
+        }
+    }
+
+    @Test
+    void ignoresMissingAndNonAdjacentPairs() {
+        final BlockState state = BlockState.fromString("minecraft:chest[facing=north,type=single,waterlogged=false]");
+        assertEquals(state, ChestBlockEntityRewriter.withPair(state, new BedrockBlockEntity(new BlockPosition(10, 64, 20), new CompoundTag())));
+        assertEquals(state, ChestBlockEntityRewriter.withPair(state, chestAt(2, 0)));
+        assertEquals(state, ChestBlockEntityRewriter.withPair(state, chestAt(0, 1)));
+    }
+
+    private static BedrockBlockEntity chestAt(final int dx, final int dz) {
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("pairx", 10 + dx);
+        tag.putInt("pairz", 20 + dz);
+        return new BedrockBlockEntity(new BlockPosition(10, 64, 20), tag);
+    }
+
+}
