+package net.raphimc.viabedrock.protocol.storage;
+
+import io.jsonwebtoken.Jwts;
+import io.jsonwebtoken.security.SignatureException;
+import org.junit.jupiter.api.Test;
+
+import java.util.Base64;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class AuthDataTest {
+
+    @Test
+    void offlineTokenBindsGameIdentityToTheSignalingKey() {
+        final String username = UUID.randomUUID().toString();
+        final AuthData auth = AuthData.createSelfSigned(username);
+        final var parsed = Jwts.parser().verifyWith(auth.getSessionKeyPair().getPublic()).build().parseSignedClaims(auth.getMultiplayerToken());
+        final byte[] encodedKey = auth.getSessionKeyPair().getPublic().getEncoded();
+        assertArrayEquals(encodedKey, Base64.getDecoder().decode((String) parsed.getHeader().get("x5u")));
+        assertArrayEquals(encodedKey, Base64.getDecoder().decode(parsed.getPayload().get("cpk", String.class)));
+        assertEquals(auth.getSelfSignedId(), UUID.fromString(parsed.getPayload().get("leguuid", String.class)));
+        assertEquals(username, auth.getDisplayName());
+        assertEquals(auth.getXuid(), parsed.getPayload().get("xid", String.class));
+        assertTrue(parsed.getPayload().getExpiration().after(parsed.getPayload().getIssuedAt()));
+    }
+
+    @Test
+    void reconnectPreservesPlayerIdentityWithoutReusingTheSessionKey() {
+        final String username = UUID.randomUUID().toString();
+        final AuthData first = AuthData.createSelfSigned(username);
+        final AuthData second = AuthData.createSelfSigned(username);
+        assertEquals(first.getXuid(), second.getXuid());
+        assertEquals(first.getSelfSignedId(), second.getSelfSignedId());
+        assertNotEquals(first.getSessionKeyPair().getPublic(), second.getSessionKeyPair().getPublic());
+        assertThrows(SignatureException.class, () -> Jwts.parser().verifyWith(second.getSessionKeyPair().getPublic()).build().parseSignedClaims(first.getMultiplayerToken()));
+    }
+
+}
