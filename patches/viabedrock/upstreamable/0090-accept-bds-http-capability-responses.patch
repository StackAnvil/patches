+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.protocol.ProtocolManager;
+import com.viaversion.viaversion.debug.DebugHandlerImpl;
+import com.viaversion.viaversion.api.platform.providers.ViaProviders;
+import com.viaversion.viaversion.api.protocol.packet.Direction;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.connection.UserConnectionImpl;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.base.ServerboundLoginPackets;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.platform.ViaBedrockConfig;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.provider.SkinProvider;
+import net.raphimc.viabedrock.protocol.storage.AuthData;
+import net.raphimc.viabedrock.protocol.storage.HandshakeStorage;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class LoginIdentityTest {
+
+    @Test
+    void registeredLoginPreservesOfflineIdentityAcrossLateAndEarlySignaling() throws Exception {
+        final String username = UUID.randomUUID().toString().substring(0, 16);
+        final AuthData early = AuthData.createSelfSigned(username);
+        final AuthData legacy = new AuthData(early.getMultiplayerToken(), early.getSessionKeyPair());
+        final ViaBedrockConfig config = mock(ViaBedrockConfig.class);
+        when(config.shouldDisableServerBlacklist()).thenReturn(true);
+        final ViaManager manager = mock(ViaManager.class);
+        when(manager.getProtocolManager()).thenReturn(mock(ProtocolManager.class));
+        when(manager.debugHandler()).thenReturn(new DebugHandlerImpl());
+        final ViaProviders providers = new ViaProviders();
+        final SkinProvider skins = mock(SkinProvider.class);
+        when(skins.getClientPlayerSkin(any())).thenReturn(Map.of());
+        providers.register(SkinProvider.class, skins);
+        when(manager.getProviders()).thenReturn(providers);
+        try (var platform = mockStatic(ViaBedrock.class);
+             var via = mockStatic(Via.class)) {
+            platform.when(ViaBedrock::getConfig).thenReturn(config);
+            via.when(Via::getManager).thenReturn(manager);
+            final BedrockProtocol protocol = new BedrockProtocol();
+            LoginPackets.register(protocol);
+            final UUID expected = UUID.nameUUIDFromBytes(("pocket-auth-1-xuid:" + early.getXuid()).getBytes(StandardCharsets.UTF_8));
+            Long clientRandomId = null;
+            for (final AuthData supplied : new AuthData[]{legacy, early, null}) {
+                final var user = new UserConnectionImpl(null, true);
+                user.put(new HandshakeStorage(2193, "127.0.0.1", 19132));
+                if (supplied != null) {
+                    user.put(supplied);
+                }
+                final var input = Unpooled.buffer();
+                try {
+                    Types.STRING.write(input, username);
+                    Types.UUID.write(input, UUID.randomUUID());
+                    protocol.transform(Direction.SERVERBOUND, State.LOGIN, new PacketWrapperImpl(ServerboundLoginPackets.HELLO, input, user));
+                    final AuthData actual = user.get(AuthData.class);
+                    if (supplied != null) {
+                        assertSame(supplied, actual);
+                    }
+                    assertEquals(username, user.getProtocolInfo().getUsername());
+                    assertEquals(expected, user.getProtocolInfo().getUuid());
+                    assertEquals(expected, actual.getSelfSignedId());
+                    if (clientRandomId == null) {
+                        clientRandomId = actual.getClientRandomId();
+                    }
+                    assertEquals(clientRandomId, actual.getClientRandomId());
+                    assertEquals(0, input.readableBytes());
+                } finally {
+                    input.release();
+                }
+            }
+        }
+    }
+
+}
