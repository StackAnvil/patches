+package net.raphimc.viabedrock.netty.nethernet;
+
+import org.cloudburstmc.netty.channel.nethernet.NetherNetConstants;
+import org.cloudburstmc.netty.channel.nethernet.signaling.IceServerInfo;
+import org.cloudburstmc.netty.channel.nethernet.signaling.NetherNetClientSignaling;
+
+import javax.net.ssl.SSLException;
+import java.security.cert.CertificateException;
+import java.security.cert.CertPathValidatorException;
+import java.net.ConnectException;
+import java.net.InetSocketAddress;
+import java.net.SocketAddress;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ThreadLocalRandom;
+
+/** Complete non-trickle HTTP signaling shared by direct clients and proxies. */
+public final class BedrockHttpSignaling implements NetherNetClientSignaling {
+
+    private static final Duration TIMEOUT = Duration.ofSeconds(10);
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(TIMEOUT).version(HttpClient.Version.HTTP_1_1).build();
+    private final String localNetworkId = Long.toUnsignedString(ThreadLocalRandom.current().nextLong());
+    private InetSocketAddress address;
+    private boolean secure;
+    private boolean closed;
+    private String connectionId;
+    private SignalHandler handler;
+    private FailureHandler failure;
+    private CompletableFuture<?> pending;
+
+    @Override
+    public boolean usesTrickleIce() {
+        return false;
+    }
+
+    @Override
+    public synchronized CompletableFuture<List<IceServerInfo>> connect(final SocketAddress remoteAddress) {
+        if (this.closed || this.address != null) {
+            return CompletableFuture.failedFuture(new IllegalStateException("Create HTTP signaling for each connection"));
+        }
+        if (!(remoteAddress instanceof InetSocketAddress endpoint)) {
+            return CompletableFuture.failedFuture(new IllegalArgumentException("HTTP signaling requires an internet socket address"));
+        }
+        this.address = endpoint;
+        return this.probe(true).handle((response, error) -> {
+            if (error == null) {
+                return this.acceptProbe(response, true);
+            }
+            final Throwable cause = unwrap(error);
+            // Native BDS can reject the TLS ClientHello with a fatal handshake alert.
+            // Certificate validation failures must not downgrade HTTPS to plaintext.
+            if (!(cause instanceof SSLException) || certificateFailure(cause)) {
+                return CompletableFuture.<List<IceServerInfo>>failedFuture(cause);
+            }
+            return this.probe(false).thenCompose(fallback -> this.acceptProbe(fallback, false));
+        }).thenCompose(result -> result);
+    }
+
+    private synchronized CompletableFuture<HttpResponse<Void>> probe(final boolean secure) {
+        if (this.closed) {
+            return CompletableFuture.failedFuture(new IllegalStateException("HTTP signaling is closed"));
+        }
+        final HttpRequest request = HttpRequest.newBuilder(this.uri(secure, "/v1/join"))
+                .timeout(TIMEOUT).header("Accept", "application/json").GET().build();
+        final CompletableFuture<HttpResponse<Void>> future = HTTP.sendAsync(request, HttpResponse.BodyHandlers.discarding());
+        this.pending = future;
+        return future;
+    }
+
+    private synchronized CompletableFuture<List<IceServerInfo>> acceptProbe(final HttpResponse<?> response, final boolean secure) {
+        if (this.closed) {
+            return CompletableFuture.failedFuture(new IllegalStateException("HTTP signaling is closed"));
+        }
+        if (response.statusCode() / 100 != 2) {
+            return CompletableFuture.failedFuture(new ConnectException("NetherNet capability check returned HTTP " + response.statusCode()));
+        }
+        // The capability status determines support. BDS 1.26.51.1 can return an
+        // empty metadata body, which the native client accepts before posting its offer.
+        this.secure = secure;
+        return CompletableFuture.completedFuture(List.of());
+    }
+
+    @Override
+    public synchronized void sendDescription(final String targetNetworkId, final String offer) {
+        if (this.closed) {
+            return;
+        }
+        if (this.address == null || this.connectionId == null) {
+            throw new IllegalStateException("Connect and register a signal handler before sending an offer");
+        }
+        final HttpRequest request = HttpRequest.newBuilder(this.uri(this.secure, "/v1/join/" + this.localNetworkId))
+                .timeout(TIMEOUT).header("Content-Type", "application/sdp").header("Accept", "application/sdp")
+                .POST(HttpRequest.BodyPublishers.ofString(offer)).build();
+        final CompletableFuture<HttpResponse<String>> future = HTTP.sendAsync(request, HttpResponse.BodyHandlers.ofString());
+        this.pending = future;
+        future.whenComplete(this::answer);
+    }
+
+    private synchronized void answer(final HttpResponse<String> response, final Throwable error) {
+        if (this.closed) {
+            return;
+        }
+        if (error != null) {
+            this.fail("NetherNet signaling failed: " + unwrap(error).getClass().getSimpleName());
+        } else if (response.statusCode() / 100 != 2) {
+            this.fail("NetherNet offer returned HTTP " + response.statusCode());
+        } else if (!response.body().startsWith("v=0\r\n") && !response.body().startsWith("v=0\n")) {
+            this.fail("NetherNet signaling did not return an SDP answer");
+        } else if (this.handler != null) {
+            // The transport verifies the answer's identity and DTLS fingerprints.
+            this.handler.onSignal(NetherNetConstants.buildSignalConnectResponse(this.connectionId, response.body()));
+        }
+    }
+
+    private void fail(final String reason) {
+        if (this.failure != null) {
+            this.failure.onFailure(reason);
+        }
+    }
+
+    private URI uri(final boolean secure, final String path) {
+        final String host = secure || this.address.isUnresolved() ? this.address.getHostString() : this.address.getAddress().getHostAddress();
+        return URI.create((secure ? "https://" : "http://") + (host.contains(":") ? "[" + host + "]" : host) + ":" + this.address.getPort() + path);
+    }
+
+    private static boolean certificateFailure(final Throwable error) {
+        for (Throwable cause = error; cause != null; cause = cause.getCause()) {
+            if (cause instanceof CertificateException || cause instanceof CertPathValidatorException) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static Throwable unwrap(final Throwable error) {
+        return error instanceof CompletionException && error.getCause() != null ? error.getCause() : error;
+    }
+
+    @Override
+    public synchronized void setSignalHandler(final String connectionId, final SignalHandler handler) {
+        this.connectionId = connectionId;
+        this.handler = handler;
+    }
+
+    @Override
+    public synchronized void removeSignalHandler(final String connectionId) {
+        if (connectionId.equals(this.connectionId)) {
+            this.handler = null;
+        }
+    }
+
+    @Override
+    public synchronized void setFailureHandler(final FailureHandler handler) {
+        this.failure = handler;
+    }
+
+    @Override
+    public String getLocalNetworkId() {
+        return this.localNetworkId;
+    }
+
+    @Override
+    public synchronized boolean isActive() {
+        return !this.closed;
+    }
+
+    @Override
+    public synchronized void close() {
+        this.closed = true;
+        this.handler = null;
+        this.failure = null;
+        if (this.pending != null) {
+            this.pending.cancel(true);
+        }
+    }
+
+}
