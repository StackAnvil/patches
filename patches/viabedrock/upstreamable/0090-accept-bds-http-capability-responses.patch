+package net.raphimc.viabedrock.netty.nethernet;
+
+import com.sun.net.httpserver.HttpServer;
+import com.sun.net.httpserver.HttpsServer;
+import com.sun.net.httpserver.HttpsConfigurator;
+import io.netty.handler.ssl.util.SelfSignedCertificate;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.KeyManagerFactory;
+import javax.net.ssl.SSLHandshakeException;
+import java.security.KeyStore;
+import java.security.cert.Certificate;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.net.ConnectException;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.net.InetSocketAddress;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockHttpSignalingTest {
+
+    @Test
+    void acceptsCapabilityWithoutMetadataAndDeliversOnlyAnSdpAnswer() throws Exception {
+        final HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        final AtomicInteger offers = new AtomicInteger();
+        final CompletableFuture<String> received = new CompletableFuture<>();
+        final CompletableFuture<String> failure = new CompletableFuture<>();
+        try (BedrockHttpSignaling signaling = new BedrockHttpSignaling();
+             PlaintextEndpoint endpoint = new PlaintextEndpoint(server.getAddress())) {
+            server.createContext("/v1/join", exchange -> {
+                if (exchange.getRequestMethod().equals("GET")) {
+                    exchange.sendResponseHeaders(200, -1);
+                } else {
+                    assertEquals("/v1/join/" + signaling.getLocalNetworkId(), exchange.getRequestURI().getPath());
+                    assertEquals("application/sdp", exchange.getRequestHeaders().getFirst("Content-Type"));
+                    final byte[] body = exchange.getRequestBody().readAllBytes();
+                    offers.incrementAndGet();
+                    exchange.sendResponseHeaders(200, body.length);
+                    exchange.getResponseBody().write(body);
+                }
+                exchange.close();
+            });
+            server.start();
+            signaling.setSignalHandler("connection", received::complete);
+            signaling.setFailureHandler(failure::complete);
+            assertTrue(signaling.connect(endpoint.address()).get(15, TimeUnit.SECONDS).isEmpty());
+            assertFalse(signaling.usesTrickleIce());
+            final String offer = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\n";
+            signaling.sendDescription("", offer);
+            assertTrue(received.get(5, TimeUnit.SECONDS).endsWith(offer));
+            assertEquals(1, offers.get());
+            assertFalse(failure.isDone());
+            assertThrows(ExecutionException.class, () -> signaling.connect(endpoint.address()).get());
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void rejectsUnsupportedEndpointsBeforeSendingAnOffer() throws Exception {
+        final HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        final AtomicInteger offers = new AtomicInteger();
+        server.createContext("/v1/join", exchange -> {
+            if (exchange.getRequestMethod().equals("POST")) {
+                offers.incrementAndGet();
+            }
+            exchange.sendResponseHeaders(404, -1);
+            exchange.close();
+        });
+        server.start();
+        try (BedrockHttpSignaling signaling = new BedrockHttpSignaling();
+             PlaintextEndpoint endpoint = new PlaintextEndpoint(server.getAddress())) {
+            final ExecutionException refused = assertThrows(ExecutionException.class, () -> signaling.connect(endpoint.address()).get(15, TimeUnit.SECONDS));
+            assertInstanceOf(ConnectException.class, refused.getCause());
+            assertEquals(0, offers.get());
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void reportsSuccessfulHttpWithoutSdpAsFailureAndCannotReconnectAfterClose() throws Exception {
+        final HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        server.createContext("/v1/join", exchange -> {
+            exchange.sendResponseHeaders(200, -1);
+            exchange.close();
+        });
+        server.start();
+        try (BedrockHttpSignaling signaling = new BedrockHttpSignaling();
+             PlaintextEndpoint endpoint = new PlaintextEndpoint(server.getAddress())) {
+            final CompletableFuture<String> received = new CompletableFuture<>();
+            final CompletableFuture<String> failure = new CompletableFuture<>();
+            signaling.setSignalHandler("connection", received::complete);
+            signaling.setFailureHandler(failure::complete);
+            signaling.connect(endpoint.address()).get(15, TimeUnit.SECONDS);
+            signaling.sendDescription("", "v=0\r\n");
+            failure.get(5, TimeUnit.SECONDS);
+            assertFalse(received.isDone());
+            signaling.close();
+            assertFalse(signaling.isActive());
+            assertThrows(ExecutionException.class, () -> signaling.connect(endpoint.address()).get());
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void refusesAnUntrustedCertificateWithoutPostingAnOffer() throws Exception {
+        final SelfSignedCertificate certificate = new SelfSignedCertificate("localhost");
+        final HttpsServer server = HttpsServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        final AtomicInteger requests = new AtomicInteger();
+        try {
+            final KeyStore keys = KeyStore.getInstance(KeyStore.getDefaultType());
+            keys.load(null, null);
+            final char[] password = new char[0];
+            keys.setKeyEntry("endpoint", certificate.key(), password, new Certificate[]{certificate.cert()});
+            final KeyManagerFactory managers = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm());
+            managers.init(keys, password);
+            final SSLContext context = SSLContext.getInstance("TLS");
+            context.init(managers.getKeyManagers(), null, null);
+            server.setHttpsConfigurator(new HttpsConfigurator(context));
+            server.createContext("/v1/join", exchange -> {
+                requests.incrementAndGet();
+                exchange.sendResponseHeaders(200, -1);
+                exchange.close();
+            });
+            server.start();
+            try (BedrockHttpSignaling signaling = new BedrockHttpSignaling()) {
+                final ExecutionException refused = assertThrows(ExecutionException.class, () -> signaling.connect(server.getAddress()).get(15, TimeUnit.SECONDS));
+                assertInstanceOf(SSLHandshakeException.class, refused.getCause());
+                assertEquals(0, requests.get());
+            }
+        } finally {
+            server.stop(0);
+            certificate.delete();
+        }
+    }
+
+    private static final class PlaintextEndpoint implements AutoCloseable {
+        private final ServerSocket listener = new ServerSocket(0, 8, java.net.InetAddress.getLoopbackAddress());
+        private final Set<Socket> sockets = ConcurrentHashMap.newKeySet();
+
+        private PlaintextEndpoint(final InetSocketAddress upstream) throws IOException {
+            Thread.startVirtualThread(() -> {
+                while (!this.listener.isClosed()) {
+                    try {
+                        final Socket socket = this.listener.accept();
+                        this.sockets.add(socket);
+                        Thread.startVirtualThread(() -> this.forward(socket, upstream));
+                    } catch (final IOException ignored) {
+                        break;
+                    }
+                }
+            });
+        }
+
+        private void forward(final Socket client, final InetSocketAddress address) {
+            try (client) {
+                final int first = client.getInputStream().read();
+                if (first == 22) {
+                    client.getOutputStream().write(new byte[]{21, 3, 3, 0, 2, 2, 40});
+                    return;
+                }
+                try (Socket upstream = new Socket(address.getAddress(), address.getPort())) {
+                    upstream.getOutputStream().write(first);
+                    Thread.startVirtualThread(() -> {
+                        try {
+                            client.getInputStream().transferTo(upstream.getOutputStream());
+                        } catch (final IOException ignored) {
+                            // Closing either fixture socket ends its forwarding task.
+                        }
+                    });
+                    upstream.getInputStream().transferTo(client.getOutputStream());
+                }
+            } catch (final IOException ignored) {
+                // Teardown closes sockets that are still waiting for a peer.
+            } finally {
+                this.sockets.remove(client);
+            }
+        }
+
+        private InetSocketAddress address() {
+            return new InetSocketAddress(this.listener.getInetAddress(), this.listener.getLocalPort());
+        }
+
+        @Override
+        public void close() throws IOException {
+            this.listener.close();
+            for (Socket socket : this.sockets) {
+                socket.close();
+            }
+        }
+    }
+
+}
