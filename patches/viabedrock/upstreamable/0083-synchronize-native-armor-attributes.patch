+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.nbt.tag.StringTag;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Native equipment values, indexed in Bedrock's head, chest, legs, feet order. */
+public record ItemArmorData(int slot, int protection, float toughness) {
+
+    public static final ItemArmorData NONE = new ItemArmorData(-1, 0, 0F);
+    private static final Map<String, ItemArmorData> VANILLA = createVanilla();
+
+    public ItemArmorData {
+        if (slot < -1 || slot > 3 || protection < 0 || !Float.isFinite(toughness) || toughness < 0F) {
+            throw new IllegalArgumentException("Invalid item armor properties");
+        }
+    }
+
+    public static ItemArmorData vanilla(final String identifier) {
+        return identifier == null ? NONE : VANILLA.getOrDefault(identifier, NONE);
+    }
+
+    public static ItemArmorData fromNetworkComponents(final CompoundTag components) {
+        if (!(components.get("minecraft:wearable") instanceof CompoundTag wearable)
+                || !(wearable.get("slot") instanceof StringTag slot)) {
+            return NONE;
+        }
+        final int index = switch (slot.getValue()) {
+            case "slot.armor.head" -> 0;
+            case "slot.armor.chest" -> 1;
+            case "slot.armor.legs" -> 2;
+            case "slot.armor.feet" -> 3;
+            default -> -1;
+        };
+        if (index == -1) {
+            return NONE;
+        }
+        final int protection = wearable.get("protection") instanceof NumberTag value ? Math.max(0, value.asInt()) : 0;
+        return new ItemArmorData(index, protection, 0F);
+    }
+
+    public static Totals total(final ItemArmorData[] equipment) {
+        if (equipment.length != 4) {
+            throw new IllegalArgumentException("Expected four player armor slots");
+        }
+        double protection = 0D;
+        double toughness = 0D;
+        for (int slot = 0; slot < equipment.length; slot++) {
+            final ItemArmorData item = equipment[slot];
+            if (item.slot == slot) {
+                protection += item.protection;
+                toughness += item.toughness;
+            }
+        }
+        return new Totals(protection, toughness);
+    }
+
+    private static Map<String, ItemArmorData> createVanilla() {
+        // BDS 1.26.51.1 equippable totals establish these values; vanilla registry entries omit components.
+        final Map<String, ItemArmorData> items = new HashMap<>();
+        addMaterial(items, "leather", new int[]{1, 3, 2, 1}, 0F);
+        addMaterial(items, "chainmail", new int[]{2, 5, 4, 1}, 0F);
+        addMaterial(items, "copper", new int[]{2, 4, 3, 1}, 0F);
+        addMaterial(items, "iron", new int[]{2, 6, 5, 2}, 0F);
+        addMaterial(items, "golden", new int[]{2, 5, 3, 1}, 0F);
+        addMaterial(items, "diamond", new int[]{3, 8, 6, 3}, 2F);
+        addMaterial(items, "netherite", new int[]{3, 8, 6, 3}, 3F);
+        items.put("minecraft:turtle_helmet", new ItemArmorData(0, 2, 0F));
+        return Map.copyOf(items);
+    }
+
+    private static void addMaterial(final Map<String, ItemArmorData> items, final String material, final int[] protection, final float toughness) {
+        final String[] names = {"helmet", "chestplate", "leggings", "boots"};
+        for (int slot = 0; slot < names.length; slot++) {
+            items.put("minecraft:" + material + '_' + names[slot], new ItemArmorData(slot, protection[slot], toughness));
+        }
+    }
+
+    public record Totals(double protection, double toughness) {
+    }
+
+}
