+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemArmorDataTest {
+
+    @Test
+    void totalsOnlyMatchingArmorSlotsAndPreservesNativeToughness() {
+        final ItemArmorData[] equipped = {
+                ItemArmorData.vanilla("minecraft:netherite_helmet"),
+                custom("slot.armor.chest", 7),
+                ItemArmorData.vanilla("minecraft:diamond_leggings"),
+                ItemArmorData.vanilla("minecraft:copper_boots")};
+        assertEquals(new ItemArmorData.Totals(17D, 5D), ItemArmorData.total(equipped));
+        equipped[1] = ItemArmorData.NONE;
+        assertEquals(new ItemArmorData.Totals(10D, 5D), ItemArmorData.total(equipped));
+        equipped[0] = ItemArmorData.vanilla("minecraft:diamond_chestplate");
+        assertEquals(new ItemArmorData.Totals(7D, 2D), ItemArmorData.total(equipped));
+        equipped[0] = custom("slot.weapon.mainhand", 9);
+        equipped[1] = custom("slot.weapon.offhand", 5);
+        assertEquals(new ItemArmorData.Totals(7D, 2D), ItemArmorData.total(equipped));
+    }
+
+    @Test
+    void missingAndNonArmorDefinitionsContributeNothingAndTotalsCannotOverflow() {
+        assertEquals(ItemArmorData.NONE, ItemArmorData.vanilla(null));
+        assertEquals(ItemArmorData.NONE, ItemArmorData.vanilla("minecraft:elytra"));
+        assertEquals(ItemArmorData.NONE, ItemArmorData.fromNetworkComponents(new CompoundTag()));
+        final ItemArmorData[] equipped = new ItemArmorData[4];
+        for (int slot = 0; slot < equipped.length; slot++) {
+            equipped[slot] = new ItemArmorData(slot, Integer.MAX_VALUE, 0F);
+        }
+        assertEquals(4D * Integer.MAX_VALUE, ItemArmorData.total(equipped).protection());
+        assertThrows(IllegalArgumentException.class, () -> ItemArmorData.total(new ItemArmorData[5]));
+        assertThrows(IllegalArgumentException.class, () -> new ItemArmorData(0, 1, Float.NaN));
+    }
+
+    private static ItemArmorData custom(final String slot, final int protection) {
+        final CompoundTag wearable = new CompoundTag();
+        wearable.putString("slot", slot);
+        wearable.putInt("protection", protection);
+        final CompoundTag components = new CompoundTag();
+        components.put("minecraft:wearable", wearable);
+        return ItemArmorData.fromNetworkComponents(components);
+    }
+
+}
