 package net.raphimc.viabedrock.api.model.container.player;
 
 import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerID;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+import net.raphimc.viabedrock.protocol.data.generated.java.Attributes;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemArmorData;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+
+import java.util.Arrays;
 
 public class ArmorContainer extends InventorySubContainer {
 
+    private ItemArmorData.Totals lastSent;
+    private boolean replacingItems;
+
     public ArmorContainer(final UserConnection user) {
         super(user, (byte) ContainerID.CONTAINER_ID_ARMOR.getValue(), ContainerType.ARMOR, 4);
     }
 
+    @Override
+    public boolean setItem(final int slot, final BedrockItem item) {
+        final boolean changed = super.setItem(slot, item);
+        if (changed && !this.replacingItems) {
+            this.updateAttributes(false);
+        }
+        return changed;
+    }
+
+    @Override
+    public boolean setItems(final BedrockItem[] items) {
+        final boolean changed;
+        this.replacingItems = true;
+        try {
+            changed = super.setItems(items);
+        } finally {
+            this.replacingItems = false;
+        }
+        if (changed) {
+            this.updateAttributes(false);
+        }
+        return changed;
+    }
+
+    @Override
+    public void clearItems() {
+        super.clearItems();
+        this.updateAttributes(false);
+    }
+
+    public void sendAttributes() {
+        this.updateAttributes(true);
+    }
+
+    private void updateAttributes(final boolean force) {
+        final EntityTracker entities = this.user.get(EntityTracker.class);
+        final ItemRewriter rewriter = this.user.get(ItemRewriter.class);
+        if (entities == null || entities.getClientPlayer() == null || rewriter == null
+                || this.user.getProtocolInfo().getServerState() != State.PLAY) {
+            return;
+        }
+        final ItemArmorData.Totals totals = ItemArmorData.total(Arrays.stream(this.items).map(rewriter::armorData).toArray(ItemArmorData[]::new));
+        if (!force && totals.equals(this.lastSent)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.UPDATE_ATTRIBUTES, this.user);
+        packet.write(Types.VAR_INT, entities.getClientPlayer().javaId());
+        packet.write(Types.VAR_INT, 2);
+        packet.write(Types.VAR_INT, BedrockProtocol.MAPPINGS.getJavaEntityAttributes().get(Attributes.ARMOR));
+        packet.write(Types.DOUBLE, totals.protection());
+        packet.write(Types.VAR_INT, 0);
+        packet.write(Types.VAR_INT, BedrockProtocol.MAPPINGS.getJavaEntityAttributes().get(Attributes.ARMOR_TOUGHNESS));
+        packet.write(Types.DOUBLE, totals.toughness());
+        packet.write(Types.VAR_INT, 0);
+        packet.send(BedrockProtocol.class);
+        this.lastSent = totals;
+    }
+
     @Override
     public int javaSlot(final int slot) {
         return 5 + slot;
