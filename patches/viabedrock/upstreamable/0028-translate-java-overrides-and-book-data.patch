+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import com.viaversion.viaversion.libs.mcstructs.text.utils.TextUtils;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ItemLoreTest {
+
+    @Test
+    void preservesEntryOrderBlankLinesAndEmbeddedLfThroughJavaWireData() throws Exception {
+        final var display = new CompoundTag();
+        final var entries = new ListTag<>(List.of(new StringTag("first\n\nlast\n"), new StringTag(""), new StringTag("next")));
+        display.put("Lore", entries);
+        final var before = display.copy();
+        final Tag[] lines = ItemDataRewriter.itemLore(display);
+        assertEquals(List.of("first", "", "last", "", "", "next"), texts(lines));
+        assertEquals(before, display);
+        final var buffer = Unpooled.buffer();
+        try {
+            StructuredDataKey.LORE.type().write(buffer, lines);
+            final var decoded = StructuredDataKey.LORE.type().read(buffer);
+            assertArrayEquals(lines, decoded);
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void carriesFormattingAcrossLfAndResetsItForEachNativeEntry() {
+        final var display = new CompoundTag();
+        display.put("Lore", new ListTag<>(List.of(new StringTag("§c§lfirst\nsecond"), new StringTag("third"))));
+        final Tag[] lines = ItemDataRewriter.itemLore(display);
+        for (int index = 0; index < lines.length; index++) {
+            final var parts = new ArrayList<TextComponent>();
+            TextUtils.iterateAll(component(lines[index]), part -> {
+                if (!part.asSingleString().isEmpty()) {
+                    parts.add(part);
+                }
+            });
+            assertEquals(1, parts.size());
+            final var style = parts.getFirst().getStyle();
+            assertEquals(index < 2 ? 0xFF5555 : 0xAA00AA, style.getColor().getRgbValue());
+            assertTrue(style.isItalic());
+            assertEquals(index < 2, style.isBold());
+        }
+    }
+
+    @Test
+    void retainsWrongTypedMembersAsBlankLinesAndDistinguishesAbsentLore() {
+        final var display = new CompoundTag();
+        assertNull(ItemDataRewriter.itemLore(display));
+        display.putString("Lore", "invalid");
+        assertNull(ItemDataRewriter.itemLore(display));
+        display.put("Lore", new ListTag<>(StringTag.class));
+        assertEquals(0, ItemDataRewriter.itemLore(display).length);
+        display.put("Lore", new ListTag<>(List.of(new IntTag(7), new IntTag(9))));
+        assertEquals(List.of("", ""), texts(ItemDataRewriter.itemLore(display)));
+    }
+
+    @Test
+    void resolvesNativeFireworkRawTextAndKeepsOrdinaryJsonLiteral() {
+        final var display = new CompoundTag();
+        display.put("Lore", new ListTag<>(List.of(
+                new StringTag("{\"rawtext\":[{\"translate\":\"item.fireworks.flight\",\"with\":[\"3\"]},{\"text\":\"\\nBlue\"}]}"),
+                new StringTag("{\"text\":\"literal\"}"), new StringTag("{malformed"))));
+        final Tag[] lines = ItemDataRewriter.itemLore(display,
