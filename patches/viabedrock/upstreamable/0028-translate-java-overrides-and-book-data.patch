@@ -0,0 +1,117 @@
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteArrayTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntArrayTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.api.minecraft.item.data.FireworkExplosion;
+import com.viaversion.viaversion.api.minecraft.item.data.Fireworks;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class FireworkDataTest {
+
+    @Test
+    void retainsAllExplosionFieldsAndTheirOrderWithoutMutatingTheSource() {
+        final CompoundTag star = new CompoundTag();
+        star.putByte("FireworkType", (byte) 3);
+        star.put("FireworkColor", new ByteArrayTag(new byte[]{1, 4, 1}));
+        star.put("FireworkFade", new ByteArrayTag(new byte[]{15, 8}));
+        star.putByte("FireworkTrail", (byte) 2);
+        star.putByte("FireworkFlicker", (byte) -1);
+        final CompoundTag burst = star.copy();
+        burst.putByte("FireworkType", (byte) 4);
+        final ListTag<CompoundTag> entries = new ListTag<>(CompoundTag.class);
+        entries.add(star);
+        entries.add(burst);
+        final CompoundTag rocket = new CompoundTag();
+        rocket.putByte("Flight", (byte) -1);
+        rocket.put("Explosions", entries);
+        final CompoundTag before = rocket.copy();
+
+        final ByteBuf buffer = Unpooled.buffer();
+        final Fireworks result;
+        try {
+            Fireworks.TYPE.write(buffer, FireworkData.fireworks(rocket));
+            result = Fireworks.TYPE.read(buffer);
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+        assertEquals(255, result.flightDuration());
+        assertEquals(2, result.explosions().length);
+        final FireworkExplosion first = result.explosions()[0];
+        assertEquals(3, first.shape());
+        assertEquals(4, result.explosions()[1].shape());
+        assertArrayEquals(new int[]{11546150, 3949738, 11546150}, first.colors());
+        assertArrayEquals(new int[]{15790320, 4673362}, first.fadeColors());
+        assertTrue(first.hasTrail());
+        assertTrue(first.hasTwinkle());
+        first.colors()[0] = 0;
+        assertEquals(before, rocket);
+    }
+
+    @Test
+    void matchesTargetCreativeStarColorsAndNativeInvalidIndexFallbacks() {
+        // RGB values observed independently in all 16 target BDS creative stars.
+        final int[] expected = {1908001, 11546150, 6192150, 8606770, 3949738, 8991416,
+            1481884, 10329495, 4673362, 15961002, 8439583, 16701501, 3847130,
+            13061821, 16351261, 15790320};
+        final byte[] indices = new byte[256];
+        final int[] colors = new int[256];
+        for (int index = 0; index < indices.length; index++) {
+            indices[index] = (byte) index;
+            colors[index] = index < expected.length ? expected[index] : 8991416;
+        }
+        final CompoundTag star = new CompoundTag();
+        star.put("FireworkColor", new ByteArrayTag(indices));
+        star.put("FireworkFade", new ByteArrayTag(indices));
+        final FireworkExplosion result = FireworkData.explosion(star);
+        assertArrayEquals(colors, result.colors());
+        assertArrayEquals(colors, result.fadeColors());
+        star.put("FireworkColor", new ByteArrayTag(new byte[0]));
+        assertArrayEquals(new int[]{8991416}, FireworkData.explosion(star).colors());
+    }
+
+    @Test
+    void usesNativeDefaultsForMissingAndWrongTagTypes() {
+        assertEquals(0, FireworkData.fireworks(null).flightDuration());
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("Flight", 3);
+        tag.putInt("FireworkType", 3);
+        tag.putInt("FireworkTrail", 1);
+        tag.putString("FireworkFlicker", "true");
+        tag.put("FireworkColor", new IntArrayTag(new int[]{1}));
+        tag.put("FireworkFade", new IntArrayTag(new int[]{15}));
+        final ListTag<StringTag> invalid = new ListTag<>(StringTag.class);
+        invalid.add(new StringTag("invalid"));
+        tag.put("Explosions", invalid);
+        assertEquals(0, FireworkData.fireworks(tag).flightDuration());
+        assertEquals(0, FireworkData.fireworks(tag).explosions().length);
+        final FireworkExplosion result = FireworkData.explosion(tag);
+        assertEquals(0, result.shape());
+        assertArrayEquals(new int[]{8991416}, result.colors());
+        assertEquals(0, result.fadeColors().length);
+        assertFalse(result.hasTrail());
+        assertFalse(result.hasTwinkle());
+    }
+
+    @Test
+    void preservesUnsignedFlightAndNormalizesOnlyUnsupportedShapes() {
+        final CompoundTag tag = new CompoundTag();
+        for (int value = 0; value < 256; value++) {
+            tag.putByte("Flight", (byte) value);
+            tag.putByte("FireworkType", (byte) value);
+            assertEquals(value, FireworkData.fireworks(tag).flightDuration());
+            assertEquals(value <= 4 ? value : 0, FireworkData.explosion(tag).shape());
+        }
+    }
+
+}
