+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.nbt.stringified.SNBT;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.viaversion.api.data.FullMappings;
+import com.viaversion.viaversion.api.minecraft.data.StructuredData;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataContainer;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import com.viaversion.viaversion.api.minecraft.item.data.BlockStateProperties;
+import com.viaversion.viaversion.api.minecraft.item.data.FireworkExplosion;
+import com.viaversion.viaversion.api.minecraft.item.data.Fireworks;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionContents;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionEffect;
+import com.viaversion.viaversion.api.minecraft.item.data.WritableBook;
+import com.viaversion.viaversion.api.minecraft.item.data.WrittenBook;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import java.util.function.Function;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.fail;
+
+class ItemDataRewriterTest {
+
+    @Test
+    void loadedAmmunitionPassesItsCompleteStackThroughTheItemConverter() {
+        for (String ammunition : new String[]{"minecraft:arrow", "minecraft:firework_rocket"}) {
+            final CompoundTag charged = new CompoundTag();
+            charged.putString("Name", ammunition);
+            charged.putByte("Count", (byte) 1);
+            charged.putShort("Damage", (short) 15);
+            final CompoundTag nested = new CompoundTag();
+            nested.putByte("Flight", (byte) 3);
+            charged.put("tag", nested);
+            final CompoundTag tag = new CompoundTag();
+            tag.put("chargedItem", charged);
+            final CompoundTag before = tag.copy();
+            final StructuredData<?> component = ammunition.equals("minecraft:arrow")
+                    ? StructuredData.of(StructuredDataKey.POTION_CONTENTS1_21_2,
+                            new PotionContents(14, null, new PotionEffect[0]), 1)
+                    : StructuredData.of(StructuredDataKey.FIREWORKS, new Fireworks(3, new FireworkExplosion[0]), 2);
+            final StructuredDataContainer data = new StructuredDataContainer(new StructuredData<?>[]{component});
+            final Item converted = new StructuredItem(17, 1, data);
+            final Item[] projectiles = ItemDataRewriter.chargedProjectiles(tag, input -> {
+                assertSame(charged, input);
+                assertEquals(15, input.getShort("Damage"));
+                assertSame(nested, input.getCompoundTag("tag"));
+                return converted;
+            });
+            assertEquals(1, projectiles.length);
+            assertSame(converted, projectiles[0]);
+            assertSame(data, projectiles[0].dataContainer());
+            assertEquals(before, tag);
+            tag.remove("chargedItem");
+            assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, input -> converted).length);
+        }
+    }
+
+    @Test
+    void invalidChargesAndMissingMappingsProduceNoProjectiles() {
+        final Function<CompoundTag, Item> unexpected = input -> {
+            fail("An invalid charge must not reach the nested item converter");
+            return null;
+        };
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(null, unexpected).length);
+        final CompoundTag tag = new CompoundTag();
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, unexpected).length);
+        tag.putString("chargedItem", "invalid");
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, unexpected).length);
+        final CompoundTag charged = new CompoundTag();
+        tag.put("chargedItem", charged);
+        charged.putString("Name", "minecraft:arrow");
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, unexpected).length);
+        charged.putByte("Count", (byte) 1);
+        charged.putString("Name", "minecraft:crossbow");
+        charged.put("tag", tag.copy());
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, unexpected).length);
+        charged.putString("Name", "minecraft:arrow");
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, input -> null).length);
+        assertEquals(0, ItemDataRewriter.chargedProjectiles(tag, input -> StructuredItem.empty()).length);
+    }
+
+    @Test
+    void convertsMappedPotionAndCustomEffectsToJavaComponents() {
+        final CompoundTag override = new CompoundTag();
+        override.putString("Potion", "minecraft:long_night_vision");
+        override.putInt("CustomPotionColor", 4013879);
+        final CompoundTag wither = new CompoundTag();
+        wither.putString("id", "minecraft:wither");
+        wither.putInt("amplifier", 1);
+        wither.putInt("duration", 800);
+        final ListTag<CompoundTag> effects = new ListTag<>(CompoundTag.class);
+        effects.add(wither);
+        override.put("custom_potion_effects", effects);
+
+        final PotionContents result = ItemDataRewriter.potionContents(override);
+
+        assertNotNull(result);
+        assertEquals(5, result.potion());
+        assertEquals(4013879, result.customColor());
+        assertEquals(1, result.customEffects().length);
+        assertEquals(19, result.customEffects()[0].effect());
+        assertEquals(1, result.customEffects()[0].effectData().amplifier());
+        assertEquals(800, result.customEffects()[0].effectData().duration());
+    }
+
+    @Test
+    void translatesTrialPotionVariantsFromNativeAuxiliaryValuesForEveryContainerAndArrow() throws Exception {
+        try (var input = new InputStreamReader(ItemDataRewriterTest.class.getResourceAsStream(
+                "/assets/viabedrock/data/custom/item_mappings.json"), StandardCharsets.UTF_8)) {
+            final var mappings = JsonParser.parseReader(input).getAsJsonObject();
+            for (final String item : new String[]{"minecraft:potion", "minecraft:splash_potion",
+                "minecraft:lingering_potion", "minecraft:arrow"}) {
+                final var metas = mappings.getAsJsonObject(item).getAsJsonObject("meta");
+                for (int nativePotion = 43; nativePotion <= 46; nativePotion++) {
+                    final int auxiliary = nativePotion + (item.equals("minecraft:arrow") ? 1 : 0);
+                    final var override = SNBT.deserializeCompoundTag(metas.getAsJsonObject(Integer.toString(auxiliary))
+                            .get("java_tag").getAsString());
+                    final PotionContents result = ItemDataRewriter.potionContents(override);
+                    assertNotNull(result);
+                    assertEquals(nativePotion - 1, result.potion());
+                    assertEquals(0, result.customEffects().length);
+                }
+            }
+        }
+    }
+
+    @Test
+    void nativeOminousBottleLevelsReachTheirJavaComponentWithoutNbtOverrides() throws Exception {
+        final var data = new StructuredDataContainer();
+        final var mappings = (FullMappings) Proxy.newProxyInstance(FullMappings.class.getClassLoader(),
+                new Class<?>[]{FullMappings.class}, (proxy, method, arguments) -> 0);
+        final var lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        lookup.set(data, mappings);
+        final Item javaItem = new StructuredItem(1, 1, data);
+        for (short amplifier = 0; amplifier <= 4; amplifier++) {
+            final BedrockItem nativeItem = new BedrockItem(500, amplifier, (byte) 1, null);
+            ItemDataRewriter.handleItem(null, "minecraft:ominous_bottle", nativeItem, null, javaItem);
+            assertEquals((int) amplifier, data.get(StructuredDataKey.OMINOUS_BOTTLE_AMPLIFIER));
+            assertEquals(amplifier, nativeItem.data());
+        }
+        final BedrockItem invalid = new BedrockItem(500, (short) 5, (byte) 1, null);
+        ItemDataRewriter.handleItem(null, "minecraft:ominous_bottle", invalid, null, javaItem);
+        assertEquals(4, data.get(StructuredDataKey.OMINOUS_BOTTLE_AMPLIFIER));
+    }
+
+    @Test
+    void convertsMappedBlockStateValuesWithoutMutatingSource() {
+        final CompoundTag blockState = new CompoundTag();
+        blockState.putInt("level", 10);
+        blockState.putString("facing", "north");
+
+        final BlockStateProperties result = ItemDataRewriter.blockStateProperties(blockState);
+
+        assertNotNull(result);
+        assertEquals("10", result.properties().get("level"));
+        assertEquals("north", result.properties().get("facing"));
+        assertEquals(10, blockState.getInt("level"));
+        assertNull(ItemDataRewriter.blockStateProperties(new CompoundTag()));
+    }
+
+    @Test
+    void resolvesInstrumentFromOrderedJavaRegistry() {
+        final CompoundTag instruments = new CompoundTag();
+        instruments.put("minecraft:ponder_goat_horn", new CompoundTag());
+        instruments.put("minecraft:sing_goat_horn", new CompoundTag());
+
+        assertEquals(1, ItemDataRewriter.registryIndex(instruments, "minecraft:sing_goat_horn"));
+        assertEquals(-1, ItemDataRewriter.registryIndex(instruments, "minecraft:missing"));
+    }
+
+    @Test
+    void preservesBookPageOrderAndSignedMetadata() {
+        final CompoundTag tag = new CompoundTag();
+        final ListTag<CompoundTag> pages = new ListTag<>(CompoundTag.class);
+        final CompoundTag first = new CompoundTag();
+        first.putString("text", "First page");
+        pages.add(first);
+        final CompoundTag second = new CompoundTag();
+        second.putString("text", "Second page");
+        pages.add(second);
+        tag.put("pages", pages);
+        tag.putString("title", "Field notes");
+        tag.putString("author", "Alex");
+        tag.putInt("generation", 2);
+
+        final WritableBook writable = ItemDataRewriter.writableBook(tag);
+        final WrittenBook written = ItemDataRewriter.writtenBook(tag);
+
+        assertEquals("First page", writable.pages()[0].raw());
+        assertEquals("Second page", writable.pages()[1].raw());
+        assertEquals("Field notes", written.title().raw());
+        assertEquals("Alex", written.author());
+        assertEquals(2, written.generation());
+        assertEquals(2, written.pages().length);
+        assertNotNull(written.pages()[0].raw());
+    }
+
+}
