+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteArrayTag;
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.api.minecraft.item.data.FireworkExplosion;
+import com.viaversion.viaversion.api.minecraft.item.data.Fireworks;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class FireworkData {
+
+    // Bedrock 1.26.51 native particle palette, also present in BDS creative stars.
+    // Its entries differ from Java's historical firework dye colors.
+    private static final int[] COLORS = {
+        0x1D1D21, 0xB02E26, 0x5E7C16, 0x835432,
+        0x3C44AA, 0x8932B8, 0x169C9C, 0x9D9D97,
+        0x474F52, 0xF38BAA, 0x80C71F, 0xFED83D,
+        0x3AB3DA, 0xC74EBD, 0xF9801D, 0xF0F0F0
+    };
+
+    public static Fireworks fireworks(final CompoundTag tag) {
+        final List<FireworkExplosion> explosions = new ArrayList<>();
+        if (tag != null && tag.get("Explosions") instanceof ListTag<?> entries) {
+            for (Tag entry : entries) {
+                if (entry instanceof CompoundTag explosion) {
+                    explosions.add(explosion(explosion));
+                }
+            }
+        }
+        return new Fireworks(unsignedByte(tag, "Flight"), explosions.toArray(FireworkExplosion[]::new));
+    }
+
+    public static FireworkExplosion explosion(final CompoundTag tag) {
+        final int type = unsignedByte(tag, "FireworkType");
+        int[] colors = colors(tag, "FireworkColor");
+        if (colors.length == 0) {
+            // Native inserts an out-of-range index, which the particle reader
+            // resolves to purple. Java's empty-color fallback is different.
+            colors = new int[]{COLORS[5]};
+        }
+        return new FireworkExplosion(type <= 4 ? type : 0, colors, colors(tag, "FireworkFade"),
+                unsignedByte(tag, "FireworkTrail") != 0, unsignedByte(tag, "FireworkFlicker") != 0);
+    }
+
+    private static int unsignedByte(final CompoundTag tag, final String key) {
+        return tag != null && tag.get(key) instanceof ByteTag value ? Byte.toUnsignedInt(value.asByte()) : 0;
+    }
+
+    private static int[] colors(final CompoundTag tag, final String key) {
+        if (tag == null || !(tag.get(key) instanceof ByteArrayTag value)) {
+            return new int[0];
+        }
+        final byte[] indices = value.getValue();
+        final int[] colors = new int[indices.length];
+        for (int index = 0; index < indices.length; index++) {
+            final int color = Byte.toUnsignedInt(indices[index]);
+            colors[index] = COLORS[color < COLORS.length ? color : 5];
+        }
+        return colors;
+    }
+
+    private FireworkData() {
+    }
+
+}
