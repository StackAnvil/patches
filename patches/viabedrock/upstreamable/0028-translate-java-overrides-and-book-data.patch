+    /** Resolve item rawtext while keeping ordinary and malformed text literal. */
+    public static String resolveRawText(final String value, final Function<String, String> translator) {
+        if (!value.stripLeading().startsWith("{")) {
+            return value;
+        }
+        try {
+            final var parsed = JsonParser.parseString(value);
+            if (!parsed.isJsonObject() || !parsed.getAsJsonObject().has("rawtext")) {
+                return value;
+            }
+            final var root = BedrockComponentSerializer.deserialize(value);
+            root.forEach(component -> {
+                if (component instanceof TranslationBedrockComponent translation) {
+                    translation.setTranslator(translator);
+                }
+            });
+            return root.asString();
+        } catch (final RuntimeException malformed) {
+            return value;
+        }
+    }
+
     public static String stringToJson(final String text) {
         return textComponentToJson(stringToTextComponent(text));
