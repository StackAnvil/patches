From 039d36f79e08472168af71bb1ab45db40ff9fb66 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:10:24 +0200
Subject: [PATCH] fix(sound): map goat jumps to their Java sound

Bedrock uses the generic jump_to_block sound for goats and a dedicated override for frogs. The generic sound was mapped to the player sweep attack, so each goat jump played an unrelated combat sound. Map that generic sound to the Java goat long jump while preserving the frog override.
---
 .../resources/assets/viabedrock/data/custom/sound_mappings.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main/resources/assets/viabedrock/data/custom/sound_mappings.json b/src/main/resources/assets/viabedrock/data/custom/sound_mappings.json
index 0ef9c7062..882783155 100644
--- a/src/main/resources/assets/viabedrock/data/custom/sound_mappings.json
+++ b/src/main/resources/assets/viabedrock/data/custom/sound_mappings.json
@@ -338,7 +338,7 @@
   "close.wooden_door": "minecraft:block.wooden_door.close",
   "close.wooden_trapdoor": "minecraft:block.wooden_trapdoor.close",
   "close_door.copper": "minecraft:block.copper_door.close",
-  "component.jump_to_block": "minecraft:entity.player.attack.sweep",
+  "component.jump_to_block": "minecraft:entity.goat.long_jump",
   "conduit.activate": "minecraft:block.conduit.activate",
   "conduit.ambient": "minecraft:block.conduit.ambient",
   "conduit.attack": "minecraft:block.conduit.attack.target",
-- 
2.55.0
