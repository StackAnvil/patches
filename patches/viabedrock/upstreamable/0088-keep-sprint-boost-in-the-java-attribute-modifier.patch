+package net.raphimc.viabedrock.api.model.entity;
+
+import com.google.common.collect.HashBiMap;
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.Protocol;
+import com.viaversion.viaversion.api.protocol.ProtocolManager;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.AttributeModifierOperation;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.AttributeOperands;
+import net.raphimc.viabedrock.protocol.model.EntityAttribute;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ClientPlayerMovementAttributeTest {
+
+    private final List<PacketWrapper> sent = new ArrayList<>();
+    private Field managerField;
+    private Field attributesField;
+    private Object previousManager;
+    private Object previousAttributes;
+    private ClientPlayerEntity player;
+
+    @BeforeAll
+    static void initializeStructuredDataKeys() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+    }
+
+    @BeforeEach
+    void installPacketCapture() throws Exception {
+        this.managerField = Via.class.getDeclaredField("manager");
+        this.managerField.setAccessible(true);
+        this.previousManager = this.managerField.get(null);
+        this.attributesField = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("javaEntityAttributes");
+        this.attributesField.setAccessible(true);
+        this.previousAttributes = this.attributesField.get(BedrockProtocol.MAPPINGS);
+        this.attributesField.set(BedrockProtocol.MAPPINGS, HashBiMap.create(Map.of("minecraft:movement_speed", 0)));
+        final ProtocolManager protocols = proxy(ProtocolManager.class, (ignored, method, arguments) -> {
+            if (method.getName().equals("createPacketWrapper")) {
+                return new PacketWrapperImpl(ClientboundPackets26_3.UPDATE_ATTRIBUTES, null, null) {
+                    @Override
+                    public void send(final Class<? extends Protocol> protocol, final boolean skipCurrentPipeline) {
+                        ClientPlayerMovementAttributeTest.this.sent.add(this);
+                    }
+                };
+            }
+            throw new AssertionError(method.getName());
+        });
+        this.managerField.set(null, proxy(ViaManager.class, (ignored, method, arguments) -> {
+            if (method.getName().equals("getProtocolManager")) {
+                return protocols;
+            }
+            throw new AssertionError(method.getName());
+        }));
+        final UserConnection user = proxy(UserConnection.class, (ignored, method, arguments) -> null);
+        this.player = new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+        this.player.attributes().put("minecraft:movement", movement(0.1F, 0.1F, 0F, Float.MAX_VALUE));
+    }
+
+    @AfterEach
+    void restoreGlobals() throws Exception {
+        this.managerField.set(null, this.previousManager);
+        this.attributesField.set(BedrockProtocol.MAPPINGS, this.previousAttributes);
+    }
+
+    @Test
+    void sprintTogglesSendAnUnboostedBaseAndTheJavaSprintModifier() throws Exception {
+        this.player.setSprinting(true);
+        final PacketWrapper sprint = this.lastPacket();
+        assertEquals(0.1D, sprint.get(Types.DOUBLE, 0), 0.000001D);
+        assertSprint(sprint, 0.13D);
+        for (int repeat = 0; repeat < 5; repeat++) {
+            this.player.setSprinting(true);
+            assertSprint(this.lastPacket(), 0.13D);
+            assertEquals(sprint.get(Types.DOUBLE, 0), this.lastPacket().get(Types.DOUBLE, 0));
+        }
+        this.player.setSprinting(false);
+        assertEquals(0, this.lastPacket().get(Types.VAR_INT, 3));
+        assertEquals(0.1D, this.lastPacket().get(Types.DOUBLE, 0), 0.000001D);
+    }
+
+    @Test
+    void serverUpdatesPreserveCustomEffectiveSpeedsWithoutMutatingNativeAttributes() throws Exception {
+        this.player.setSprinting(true);
+        for (final float speed : new float[]{0F, 0.065F, 0.26F}) {
+            final EntityAttribute server = movement(speed, 0.1F, 0F, Float.MAX_VALUE);
+            this.player.updateAttributes(new EntityAttribute[]{server});
+            assertSprint(this.lastPacket(), speed);
+            assertSame(server, this.player.attributes().get(server.name()));
+        }
+        this.player.setSprinting(false);
+        final EntityAttribute walking = movement(0.2F, 0.1F, 0F, Float.MAX_VALUE);
+        this.player.updateAttributes(new EntityAttribute[]{walking});
+        assertEquals(0, this.lastPacket().get(Types.VAR_INT, 3));
+        assertEquals((double) walking.currentValue(), this.lastPacket().get(Types.DOUBLE, 0));
+    }
+
+    @Test
+    void normalizesAfterNativeLimitsAndRetainsOtherNativeModifiers() throws Exception {
+        final EntityAttribute.Modifier custom = new EntityAttribute.Modifier("custom", "custom", 0.5F,
+                AttributeModifierOperation.OPERATION_MULTIPLY_TOTAL, AttributeOperands.OPERAND_CURRENT, false);
+        this.player.attributes().put("minecraft:movement", movement(0.1F, 0.1F, 0F, Float.MAX_VALUE).withModifiers(new EntityAttribute.Modifier[]{custom}));
+        this.player.setSprinting(true);
+        assertSprint(this.lastPacket(), 0.195D);
+        this.player.updateAttributes(new EntityAttribute[]{movement(0.13F, 0.1F, 0.12F, 0.125F)});
+        assertSprint(this.lastPacket(), 0.125D);
+        this.player.updateAttributes(new EntityAttribute[]{movement(0.05F, 0.1F, 0.12F, 0.125F)});
+        assertSprint(this.lastPacket(), 0.12D);
+    }
+
+    private PacketWrapper lastPacket() {
+        return this.sent.get(this.sent.size() - 1);
+    }
+
+    private static void assertSprint(final PacketWrapper packet, final double effectiveSpeed) throws Exception {
+        assertEquals(1, packet.get(Types.VAR_INT, 1)); // attribute count
+        assertEquals(1, packet.get(Types.VAR_INT, 3)); // modifier count
+        assertEquals("minecraft:sprinting", packet.get(Types.STRING, 0));
+        assertEquals((double) 0.3F, packet.get(Types.DOUBLE, 1));
+        assertEquals((byte) 2, packet.get(Types.BYTE, 0));
+        assertEquals(effectiveSpeed, packet.get(Types.DOUBLE, 0) * (1D + packet.get(Types.DOUBLE, 1)), 0.000001D);
+    }
+
+    private static EntityAttribute movement(final float current, final float defaultValue, final float min, final float max) {
+        return new EntityAttribute("minecraft:movement", current, min, max, defaultValue, min, max, new EntityAttribute.Modifier[0]);
+    }
+
+    private static <T> T proxy(final Class<T> type, final InvocationHandler handler) {
+        return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type}, handler));
+    }
+
+}
