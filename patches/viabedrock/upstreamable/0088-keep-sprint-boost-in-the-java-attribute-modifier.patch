 .../ClientPlayerMovementAttributeTest.java    | 155 ++++++++++++++++++
 2 files changed, 174 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerMovementAttributeTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
