+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.protocol.packet.mapping.PacketMapping;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.Unpooled;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.NativeHudBossBars;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BossEventAcknowledgementTest {
+
+    private static final long LOCAL_PLAYER = 36357902279722580L;
+    // Galaxite's 1.26.60 load probe for the local player, and the official client's replies.
+    private static final String ADD = "a899caa2b9d49581010003c2a77203c2a772000000000000";
+    private static final String REMOVE = "a899caa2b9d4958101020000000000000000";
+    private static final String PLAYER_ADDED = "a899caa2b9d49581010103c2a77203c2a772000000000100";
+    private static final String PLAYER_REMOVED = "a899caa2b9d4958101030000000000000100";
+    private static final String UPDATE_PERCENT = "a899caa2b9d49581010400000000003f0000";
+
+    @Test
+    void answersAddAndRemoveWithTheNativeRegistrationReplies() throws Exception {
+        final var fixture = new Fixture(LOCAL_PLAYER);
+        fixture.receive(ADD);
+        fixture.receive(REMOVE);
+        assertEquals(List.of(PLAYER_ADDED, PLAYER_REMOVED), fixture.sent);
+    }
+
+    @Test
+    void sendsNoReplyForUpdatesOrUnknownActors() throws Exception {
+        final var tracked = new Fixture(LOCAL_PLAYER);
+        tracked.receive(ADD);
+        tracked.sent.clear();
+        tracked.receive(UPDATE_PERCENT);
+        assertTrue(tracked.sent.isEmpty());
+
+        final var untracked = new Fixture(LOCAL_PLAYER + 1);
+        untracked.receive(ADD);
+        untracked.receive(REMOVE);
+        assertTrue(untracked.sent.isEmpty());
+    }
+
+    private static final class Fixture {
+
+        private final List<String> sent = new ArrayList<>();
+        private final UserConnection user = mock(UserConnection.class);
+        private final TestProtocol protocol = new TestProtocol();
+
+        private Fixture(final long trackedActor) {
+            final var tracker = mock(EntityTracker.class);
+            when(tracker.getEntityByUid(trackedActor)).thenReturn(mock(Entity.class));
+            final Map<Class<?>, Object> storage = Map.of(
+                    EntityTracker.class, tracker,
+                    NativeHudBossBars.class, new NativeHudBossBars(),
+                    ChannelStorage.class, new ChannelStorage());
+            when(this.user.get(any())).thenAnswer(call -> storage.get(call.getArgument(0)));
+            when(this.user.has(any())).thenAnswer(call -> storage.containsKey(call.getArgument(0)));
+            final var info = mock(ProtocolInfo.class);
+            when(info.getClientState()).thenReturn(State.PLAY);
+            when(this.user.getProtocolInfo()).thenReturn(info);
+        }
+
+        private void receive(final String payload) throws Exception {
+            try (var wrappers = mockStatic(PacketWrapper.class)) {
+                wrappers.when(() -> PacketWrapper.create(ServerboundBedrockPackets.BOSS_EVENT, this.user)).thenAnswer(call -> {
+                    final var reply = spy(new PacketWrapperImpl(ServerboundBedrockPackets.BOSS_EVENT, null, this.user));
+                    doAnswer(send -> {
+                        final var buffer = Unpooled.buffer();
+                        try {
+                            reply.writeToBuffer(buffer);
+                            assertEquals(ServerboundBedrockPackets.BOSS_EVENT.getId(), Types.VAR_INT.readPrimitive(buffer));
+                            final byte[] bytes = new byte[buffer.readableBytes()];
+                            buffer.readBytes(bytes);
+                            this.sent.add(HexFormat.of().formatHex(bytes));
+                        } finally {
+                            buffer.release();
+                        }
+                        return null;
+                    }).when(reply).sendToServer(BedrockProtocol.class);
+                    return reply;
+                });
+                final var input = Unpooled.wrappedBuffer(HexFormat.of().parseHex(payload));
+                try {
+                    final var packet = new PacketWrapperImpl(ClientboundBedrockPackets.BOSS_EVENT, input, this.user);
+                    final var mapping = this.protocol.mapping(packet);
+                    mapping.applyType(packet);
+                    mapping.handler().handle(packet);
+                    assertTrue(packet.isCancelled());
+                    assertFalse(input.isReadable());
+                } finally {
+                    input.release();
+                }
+            }
+        }
+
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            HudPackets.register(this);
+        }
+
+        private PacketMapping mapping(final PacketWrapper packet) {
+            return this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+        }
+
+    }
+
+}
