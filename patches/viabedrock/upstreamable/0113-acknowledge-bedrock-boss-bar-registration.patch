@@ -47,6 +47,7 @@ import net.raphimc.viabedrock.api.resourcepack.ui.JsonUiProgram;
 import net.raphimc.viabedrock.api.util.*;
 import net.raphimc.viabedrock.protocol.BedrockProtocol;
 import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.IdentityDefinition_Type;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.*;
 import net.raphimc.viabedrock.protocol.data.enums.java.ObjectiveAction;
@@ -96,6 +97,25 @@ public final class HudPackets {
         packet.send(BedrockProtocol.class);
     }
 
+    /**
+     * The Bedrock client answers each boss bar it adds or removes with PlayerAdded or PlayerRemoved for the same
+     * actor. Servers can wait for these replies before finishing a load, and repeat the request until they arrive.
+     * Native 1.26.60 replies echo the name, filtered name and percent and always carry BLUE and PROGRESS.
+     */
+    private static void acknowledgeBossEvent(final UserConnection user, final long bossEntityUniqueId, final BossEventUpdateType request,
+                                     final String name, final String filteredName, final float healthPercent) {
+        final PacketWrapper reply = PacketWrapper.create(ServerboundBedrockPackets.BOSS_EVENT, user);
+        reply.write(BedrockTypes.VAR_LONG, bossEntityUniqueId); // boss entity unique id
+        reply.write(Types.BYTE, (byte) (request == BossEventUpdateType.Add
+                ? BossEventUpdateType.PlayerAdded : BossEventUpdateType.PlayerRemoved).getValue()); // update type
+        reply.write(BedrockTypes.STRING, name); // boss name
+        reply.write(BedrockTypes.STRING, filteredName); // filtered boss name
+        reply.write(BedrockTypes.FLOAT_LE, healthPercent); // health percent
+        reply.write(Types.BYTE, (byte) BossBarColor.BLUE.getValue()); // color
+        reply.write(Types.BYTE, (byte) BossBarOverlay.PROGRESS.getValue()); // overlay
+        reply.sendToServer(BedrockProtocol.class);
+    }
+
     /**
      * Native boss bars are rows of the HUD's boss_bars collection. An accepted HUD can present a row through
      * its own controls and hide it from the native boss panel, so the Java bar follows that authored panel.
@@ -523,7 +543,7 @@ public final class HudPackets {
             }
 
             final String bossName = wrapper.read(BedrockTypes.STRING);
-            wrapper.read(BedrockTypes.STRING); // filtered boss name
+            final String filteredBossName = wrapper.read(BedrockTypes.STRING); // filtered boss name
             final float healthPercent = wrapper.read(BedrockTypes.FLOAT_LE);
             final int color = MathUtil.getOrFallback(wrapper.read(Types.BYTE), 0, 5, 0);
             final int overlay = wrapper.read(Types.BYTE);
@@ -533,6 +553,9 @@ public final class HudPackets {
             if (entity == null) {
                 return;
             }
+            if (updateType == BossEventUpdateType.Add || updateType == BossEventUpdateType.Remove) {
+                acknowledgeBossEvent(user, bossEntityUniqueId, updateType, bossName, filteredBossName, healthPercent);
+            }
             final NativeHudBossBars bossBars = user.get(NativeHudBossBars.class);
             final NativeHudBossBars.Bar bar = bossBars.get(bossEntityUniqueId);
             switch (updateType) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/BossEventAcknowledgementTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/BossEventAcknowledgementTest.java
