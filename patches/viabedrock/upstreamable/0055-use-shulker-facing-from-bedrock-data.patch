+    @Test
+    void predictionCorrectionsRetainShulkerBoxTileFacing() throws Exception {
+        final var mappings = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("javaBlockStates");
+        mappings.setAccessible(true);
+        final Object previous = mappings.get(BedrockProtocol.MAPPINGS);
+        final var down = BlockState.fromString("minecraft:red_shulker_box[facing=down]");
+        final var west = down.withProperty("facing", "west");
+        try {
+            mappings.set(BedrockProtocol.MAPPINGS, HashBiMap.create(java.util.Map.of(down, 10, west, 11)));
+            final var chunks = mock(ChunkTracker.class);
+            final var position = new BlockPosition(2, 64, 3);
+            final var section = new BedrockChunkSectionImpl();
+            final var palette = new BedrockDataPalette();
+            palette.addId(7);
+            section.addPalette(PaletteType.BLOCKS, palette);
+            when(chunks.getChunkSection(position)).thenReturn(section);
+            when(chunks.getJavaBlockState(section, 2, 0, 3)).thenReturn(10);
+            doCallRealMethod().when(chunks).getJavaBlockState(position);
+            assertEquals(10, chunks.getJavaBlockState(position));
+            when(chunks.getBlockEntity(position)).thenReturn(new BedrockBlockEntity(position, null));
+            assertEquals(10, chunks.getJavaBlockState(position));
+            final var tag = new CompoundTag();
+            tag.putByte("facing", (byte) 4);
+            when(chunks.getBlockEntity(position)).thenReturn(new BedrockBlockEntity(position, tag));
+            assertEquals(11, chunks.getJavaBlockState(position));
+            tag.putByte("facing", (byte) 0);
+            assertEquals(10, chunks.getJavaBlockState(position));
+        } finally {
+            mappings.set(BedrockProtocol.MAPPINGS, previous);
+        }
+    }
