+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ShulkerBoxBlockEntityRewriterTest {
+
+    @Test
+    void appliesBlockEntityFacingToEveryShulkerColor() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putByte("facing", (byte) 1);
+        final BlockState original = BlockState.fromString("minecraft:red_shulker_box[facing=down]");
+        assertEquals(original.withProperty("facing", "up"), ShulkerBoxBlockEntityRewriter.withFacing(original, tag));
+
+        tag.putByte("facing", (byte) 4);
+        assertEquals(original.withProperty("facing", "west"), ShulkerBoxBlockEntityRewriter.withFacing(original, tag));
+    }
+
+}
