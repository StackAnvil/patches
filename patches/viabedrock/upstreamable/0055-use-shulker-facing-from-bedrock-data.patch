+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
+import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.chunk.BlockEntityWithBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.Direction;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+import java.util.Locale;
+
+public final class ShulkerBoxBlockEntityRewriter extends LootableContainerBlockEntityRewriter {
+
+    @Override
+    public BlockEntity toJava(final UserConnection user, final BedrockBlockEntity bedrockBlockEntity) {
+        final BlockEntity javaBlockEntity = super.toJava(user, bedrockBlockEntity);
+        final int originalId = user.get(BlockStateRewriter.class).javaId(user.get(ChunkTracker.class).getBlockState(bedrockBlockEntity.position()));
+        final BlockState original = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(originalId);
+        final BlockState facing = withFacing(original, bedrockBlockEntity.tag());
+        if (facing == original) {
+            return javaBlockEntity;
+        }
+        final Integer javaId = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(facing);
+        return javaId == null ? javaBlockEntity : new BlockEntityWithBlockState(javaBlockEntity, javaId);
+    }
+
+    public static BlockState withFacing(final BlockState state, final CompoundTag tag) {
+        if (state == null || tag == null || tag.get("facing") == null) {
+            return state;
+        }
+        final Direction direction = Direction.getFromVerticalId(tag.getByte("facing", (byte) -1));
+        return direction == null ? state : state.withProperty("facing", direction.name().toLowerCase(Locale.ROOT));
+    }
+
+}
