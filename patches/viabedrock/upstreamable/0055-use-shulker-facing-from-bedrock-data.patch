Subject: [PATCH] fix(block-entities): use shulker facing from Bedrock data

Bedrock stores the placed shulker facing in its block entity. Apply that value to the Java block state so boxes placed on walls and ceilings render and open in the correct direction.
---
 .../rewriter/BlockEntityRewriter.java         |  2 +-
 .../ShulkerBoxBlockEntityRewriter.java        | 55 +++++++++++++++++++
 .../ShulkerBoxBlockEntityRewriterTest.java    | 22 ++++++++
 3 files changed, 78 insertions(+), 1 deletion(-)
 create mode 100644 src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ShulkerBoxBlockEntityRewriter.java
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ShulkerBoxBlockEntityRewriterTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/BlockEntityRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/BlockEntityRewriter.java
index e903b7de4..c7202129c 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/BlockEntityRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/BlockEntityRewriter.java
@@ -93,7 +93,7 @@ public final class BlockEntityRewriter {
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.NETHER_REACTOR, NULL_REWRITER);
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SCULK_CATALYST, NOOP_REWRITER);
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SHELF, new ShelfBlockEntityRewriter());
-        BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SHULKER_BOX, new LootableContainerBlockEntityRewriter());
+        BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SHULKER_BOX, new ShulkerBoxBlockEntityRewriter());
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SIGN, new SignBlockEntityRewriter());
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SKULL, new SkullBlockEntityRewriter());
         BLOCK_ENTITY_REWRITERS.put(CustomBlockTags.SMOKER, new FurnaceBlockEntityRewriter());
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ShulkerBoxBlockEntityRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/ShulkerBoxBlockEntityRewriter.java
