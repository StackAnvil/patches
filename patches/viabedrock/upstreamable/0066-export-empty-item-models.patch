+    private static StructuredDataContainer components() throws ReflectiveOperationException {
+        final StructuredDataContainer data = new StructuredDataContainer();
+        final var lookup = StructuredDataContainer.class.getDeclaredField("lookup");
+        lookup.setAccessible(true);
+        final var mappings = java.lang.reflect.Proxy.newProxyInstance(
+                com.viaversion.viaversion.api.data.FullMappings.class.getClassLoader(),
+                new Class<?>[]{com.viaversion.viaversion.api.data.FullMappings.class}, (proxy, method, arguments) -> 0);
+        lookup.set(data, mappings);
+        return data;
+    }
+
+    private static Content convert(final ResourcePackStorage storage, final ResourcePackRewriter.Rewriter rewriter) {
+        final Content result = new InMemoryContent();
+        rewriter.submitTasks(storage, task -> result.putAll(task.get()));
+        return result;
+    }
