+    public static String unresolvedModelAssets(final ResourcePackStorage storage, final String folder, final String identifier, final String model) {
+        final Object failure = storage.getConverterData().get("model_missing_" + folder + '/' + identifier + '/' + model);
+        return failure instanceof String message ? message : null;
+    }
+
+    public static void requireModelAssets(final ResourcePackStorage storage, final String folder, final String identifier, final String model) {
+        final String failure = unresolvedModelAssets(storage, folder, identifier, model);
+        if (failure != null) {
+            throw new IllegalStateException("Unresolved model " + identifier + '/' + model + ": " + failure);
+        }
+    }
+
+    protected void recordMissingAssets(final ResourcePackStorage storage, final String identifier, final String model, final String geometry, final String texture,
+                                       final boolean hasGeometry, final boolean hasTexture) {
+        final String key = "model_missing_" + this.subFolder + '/' + identifier + '/' + model;
+        if (hasGeometry && hasTexture) {
+            storage.getConverterData().remove(key);
+            return;
+        }
+        final String reason = (!hasGeometry ? "missing geometry " + geometry : "")
+                + (!hasGeometry && !hasTexture ? "; " : "") + (!hasTexture ? "missing texture " + texture : "");
+        storage.getConverterData().put(key, reason);
+    }
+
+    protected Set<String> copyTextures(final ResourcePackStorage storage, final Collection<String> paths, final ItemModelContent content) {
+        final Set<String> resolved = new HashSet<>();
+        for (String path : paths) {
+            if (resolved.contains(path)) {
+                continue;
+            }
+            for (ResourcePack pack : storage.getPackStackTopToBottom()) {
+                final Content.LazyImage image = pack.content().getShortnameImage(path);
+                if (image != null) {
+                    content.putPngImage("assets/viabedrock/textures/" + this.getJavaTexturePath(path) + ".png", image);
+                    resolved.add(path);
+                    break;
+                }
+            }
+        }
+        return resolved;
+    }
