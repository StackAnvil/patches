+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemModelResourceRewriterTest {
+
+    @Test
+    void rendersAnEmptyDefinitionWhenNoGeometryWasConverted() {
+        final Content content = new TestRewriter().convert(Map.of());
+        final JsonObject model = content.getJson("assets/viabedrock/items/entities/example/actor.json").getAsJsonObject("model");
+        assertEquals("minecraft:empty", model.get("type").getAsString());
+        assertFalse(model.has("cases"));
+        assertTrue(content.getFilesDeep("assets/viabedrock/models/", ".json").isEmpty());
+    }
+
+    @Test
+    void preservesEveryModelSelectionAndItsGeometry() {
+        final JsonObject firstGeometry = new JsonObject();
+        firstGeometry.addProperty("parent", "minecraft:item/generated");
+        final JsonObject secondGeometry = new JsonObject();
+        secondGeometry.addProperty("parent", "minecraft:block/cube_all");
+        final Map<String, JsonObject> geometries = Map.of("adult", firstGeometry, "baby", secondGeometry);
+        final Content content = new TestRewriter().convert(geometries);
+        final JsonObject model = content.getJson("assets/viabedrock/items/entities/example/actor.json").getAsJsonObject("model");
+
+        assertEquals("minecraft:select", model.get("type").getAsString());
+        assertEquals(geometries.size(), model.getAsJsonArray("cases").size());
+        for (var entry : model.getAsJsonArray("cases")) {
+            final JsonObject selected = entry.getAsJsonObject();
+            final String key = selected.get("when").getAsString();
+            final String path = selected.getAsJsonObject("model").get("model").getAsString().substring("viabedrock:".length());
+            assertEquals(geometries.get(key), content.getJson("assets/viabedrock/models/" + path + ".json"));
+        }
+    }
+
+    private static final class TestRewriter extends ItemModelResourceRewriter {
+
+        private TestRewriter() {
+            super("entities");
+        }
+
+        @Override
+        public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        }
+
+        private Content convert(final Map<String, JsonObject> models) {
+            final ItemModelContent content = new ItemModelContent("example:actor");
+            models.forEach(content::putModel);
+            content.generateItemDefinition();
+            return content;
+        }
+    }
+
+}
