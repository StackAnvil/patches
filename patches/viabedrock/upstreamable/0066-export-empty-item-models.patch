+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ModelResourceAssetsTest {
+
+    @Test
+    void exportsOnlyResolvedVanillaEntityVariantsWithValidParticleBindings() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack("minecraft:player", false)));
+        final Content result = convert(storage, new CustomEntityResourceRewriter());
+        final var cases = result.getJson("assets/viabedrock/items/entities/minecraft/player.json").getAsJsonObject("model").getAsJsonArray("cases");
+        assertEquals(1, cases.size());
+        final String modelPath = cases.get(0).getAsJsonObject().getAsJsonObject("model").get("model").getAsString().substring("viabedrock:".length());
+        final JsonObject textures = result.getJson("assets/viabedrock/models/" + modelPath + ".json").getAsJsonObject("textures");
+        final String particle = textures.get("particle").getAsString();
+        assertTrue(particle.startsWith("#"));
+        final String sprite = textures.get(particle.substring(1)).getAsString();
+        assertNotNull(result.getImage("assets/viabedrock/textures/" + sprite.substring("viabedrock:".length()) + ".png"));
+        assertNull(ItemModelResourceRewriter.unresolvedModelAssets(storage, "entities", "minecraft:player", "default_resolved"));
+        assertNotNull(ItemModelResourceRewriter.unresolvedModelAssets(storage, "entities", "minecraft:player", "default_default"));
+    }
+
+    @Test
+    void exportsAnEmptyVanillaAttachableWhenItsTextureIsOmitted() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack("minecraft:armor", true)));
+        final Content result = convert(storage, new CustomAttachableResourceRewriter());
+        final var model = result.getJson("assets/viabedrock/items/attachables/minecraft/armor.json").getAsJsonObject("model");
+        assertEquals("minecraft:empty", model.get("type").getAsString());
+        assertTrue(result.getFilesDeep("assets/viabedrock/models/", ".json").isEmpty());
+        assertNotNull(ItemModelResourceRewriter.unresolvedModelAssets(storage, "attachables", "minecraft:armor", "minecraft:armor_default"));
+    }
+
+    @Test
+    void retainsUnresolvedUnusedVariantsAndRejectsTheirActiveSelection() {
+        for (boolean attachable : new boolean[]{false, true}) {
+            final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack("example:actor", attachable)));
+            final ResourcePackRewriter.Rewriter rewriter = attachable ? new CustomAttachableResourceRewriter() : new CustomEntityResourceRewriter();
+            assertDoesNotThrow(() -> convert(storage, rewriter));
+            final String folder = attachable ? "attachables" : "entities";
+            final String model = attachable ? "example:actor_default" : "default_default";
+            assertThrows(IllegalStateException.class, () -> ItemModelResourceRewriter.requireModelAssets(storage, folder, "example:actor", model));
+            if (!attachable) {
+                assertDoesNotThrow(() -> ItemModelResourceRewriter.requireModelAssets(storage, folder, "example:actor", "default_resolved"));
+            }
+        }
+    }
+
+    private static Content convert(final ResourcePackStorage storage, final ResourcePackRewriter.Rewriter rewriter) {
+        final Content result = new InMemoryContent();
+        rewriter.submitTasks(storage, task -> result.putAll(task.get()));
+        return result;
+    }
+
+    private static ResourcePack pack(final String identifier, final boolean attachable) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        final JsonObject textures = new JsonObject();
+        textures.addProperty("default", "textures/omitted");
+        if (!attachable) {
+            textures.addProperty("resolved", "textures/present");
+        }
+        description.add("textures", textures);
+        final JsonObject geometry = new JsonObject();
+        geometry.addProperty("default", "geometry.test");
+        description.add("geometry", geometry);
+        final JsonObject definition = new JsonObject();
+        definition.add("description", description);
+        final JsonObject root = new JsonObject();
+        root.addProperty("format_version", "1.10.0");
+        root.add(attachable ? "minecraft:attachable" : "minecraft:client_entity", definition);
+        content.putJson((attachable ? "attachables/" : "entity/") + "test.json", root);
+        content.putPngImage("textures/present.png", new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB));
+        content.putString("models/entity/test.json", "{\"format_version\":\"1.12.0\",\"minecraft:geometry\":[{\"description\":{\"identifier\":\"geometry.test\",\"texture_width\":64,\"texture_height\":64},\"bones\":[{\"name\":\"root\",\"pivot\":[0,0,0],\"cubes\":[{\"origin\":[-8,0,-8],\"size\":[16,8,16],\"uv\":[0,0]}]}]}]}");
+        return new ResourcePack(content);
+    }
+
+}
