+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+/** Storage components belong to the selected native Item definition. */
+public record ItemStorageProperties(boolean storage, Integer modifier, Integer capacity) {
+
+    public static final ItemStorageProperties NONE = new ItemStorageProperties(false, null, null);
+
+    public ItemStorageProperties withComponentData(final CompoundTag components) {
+        final boolean storage = this.storage || components.get("minecraft:storage_item") instanceof CompoundTag;
+        return new ItemStorageProperties(storage,
+                integer(components, "minecraft:storage_weight_modifier", "weight_in_storage_item", this.modifier),
+                integer(components, "minecraft:storage_weight_limit", "max_weight_limit", this.capacity));
+    }
+
+    public boolean complete() {
+        return this.storage && this.modifier != null && this.capacity != null;
+    }
+
+    private static Integer integer(final CompoundTag components, final String component, final String field, final Integer previous) {
+        if (!(components.get(component) instanceof CompoundTag value)) {
+            return previous;
+        }
+        // An unverified component default cannot become an invented storage amount.
+        return value.get(field) instanceof IntTag integer ? integer.asInt() : null;
+    }
+
+}
