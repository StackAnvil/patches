+import java.util.function.Function;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeItemStackingTest {
+
+    @Test
+    void comparesAuxiliaryValuesOnlyForSubtypeItemsWithoutWildcardMatching() {
+        final var source = new BedrockItem(259, (short) 0, (byte) 4);
+        final var destination = new BedrockItem(259, (short) 1, (byte) 1);
+        assertTrue(canMerge(source, destination, false, false));
+        assertFalse(canMerge(source, destination, true, false));
+        source.setData(Short.MAX_VALUE);
+        assertTrue(canMerge(source, destination, false, false));
+        assertFalse(canMerge(source, destination, true, false));
+        destination.setData(Short.MAX_VALUE);
+        assertTrue(canMerge(source, destination, true, false));
+        destination.setIdentifier(260);
+        assertFalse(canMerge(source, destination, false, false));
+    }
+
+    @Test
+    void usesDestinationDurabilityAndTypedUnbreakableStateBeforeMerging() {
+        final var tag = new CompoundTag();
+        tag.putInt("Damage", 1);
+        final var source = new BedrockItem(259, (short) 0, (byte) 4, tag);
+        final var destination = source.copy();
+        assertFalse(canMerge(source, destination, false, true));
+        assertTrue(canMerge(source, destination, false, false));
+        source.tag().putByte("Unbreakable", (byte) 1);
+        destination.setTag(source.tag().copy());
+        assertTrue(canMerge(source, destination, false, true));
+        source.tag().putInt("Unbreakable", 1);
+        destination.setTag(source.tag().copy());
+        assertFalse(canMerge(source, destination, false, true));
+        source.tag().putInt("Damage", 65535);
+        destination.setTag(source.tag().copy());
+        assertTrue(canMerge(source, destination, false, true));
+    }
+
+    @Test
+    void keepsNativeUserdataRestrictionAndBlockingComparisons() {
+        final var source = new BedrockItem(259);
+        final var destination = source.copy();
+        destination.setTag(new CompoundTag());
+        assertTrue(canMerge(source, destination, false, false));
+        source.setTag(new CompoundTag());
+        source.tag().putFloat("value", 0F);
+        destination.tag().putFloat("value", -0F);
+        assertTrue(canMerge(source, destination, false, false));
+        source.tag().put("value", new ListTag<>(IntTag.class));
+        destination.tag().put("value", new ListTag<>(FloatTag.class));
+        assertFalse(canMerge(source, destination, false, false));
+        destination.setTag(source.tag().copy());
+        destination.setBlockingTicks(1);
+        assertFalse(canMerge(source, destination, false, false));
+        destination.setBlockingTicks(0);
+        source.setCanPlace(new String[] {"minecraft:stone", "minecraft:dirt", "minecraft:stone"});
+        destination.setCanPlace(new String[] {"minecraft:dirt", "minecraft:stone"});
+        assertTrue(canMerge(source, destination, false, false));
+        destination.setCanBreak(new String[] {"minecraft:stone"});
+        assertFalse(canMerge(source, destination, false, false));
+    }
+
+    @Test
+    void comparesEffectiveBlockAuxiliaryValuesInsteadOfRawRuntimeIds() {
+        final var source = new BedrockItem(259);
+        final var destination = source.copy();
+        source.setBlockRuntimeId(1);
+        destination.setBlockRuntimeId(2);
+        final var properties = new ComponentItemStackingProperties(64, null, true, false);
+        final Function<BedrockItem, Short> auxiliary = item -> item.blockRuntimeId() < 3 ? (short) 7 : (short) 8;
+        assertTrue(NativeItemStacking.canMerge(source, destination, properties, auxiliary, NativeItemStackingTest::restrictions));
+        destination.setBlockRuntimeId(3);
+        assertFalse(NativeItemStacking.canMerge(source, destination, properties, auxiliary, NativeItemStackingTest::restrictions));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_CONTAINER_MERGE", matches = ".+")
+    void matchesNativeMergePredicatesAndOccupiedDestinationSelection() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_CONTAINER_MERGE")))).getAsJsonObject();
+        for (final var element : reference.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var properties = new ComponentItemStackingProperties(row.get("maximum").getAsInt(), null,
+                    row.get("stackedByData").getAsBoolean(), row.get("damageable").getAsBoolean());
+            final var source = new BedrockItem(259, row.get("sourceAux").getAsShort(), (byte) 4);
+            final var destination = new BedrockItem(259, row.get("destinationAux").getAsShort(), (byte) 1);
+            if (!row.get("nbtHex").isJsonNull()) {
+                final var bytes = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+                try {
+                    source.setTag((CompoundTag) BedrockTypes.TAG_LE.read(bytes));
+                    assertFalse(bytes.isReadable());
+                    destination.setTag(source.tag().copy());
+                } finally {
+                    bytes.release();
+                }
+            }
+            final boolean expected = row.get("nativeCanMerge").getAsBoolean();
+            assertEquals(row.get("nativeStackable").getAsBoolean(), properties.stackable(destination), row::toString);
+            assertEquals(expected, NativeItemStacking.canMerge(source, destination, properties,
+                    BedrockItem::data, NativeItemStackingTest::restrictions), row::toString);
+            final var inventory = BedrockItem.emptyArray(36);
+            inventory[0] = destination;
+            final var plan = NativeContainerTransfer.plan(source, inventory, properties.maximum(),
+                    (from, to) -> NativeItemStacking.canMerge(from, to, properties,
+                            BedrockItem::data, NativeItemStackingTest::restrictions), slot -> true);
+            assertNotNull(plan);
+            assertEquals(expected && properties.maximum() > destination.amount() ? 0 : 1, plan.destinationSlot(), row::toString);
+        }
+    }
+
+    private static boolean canMerge(final BedrockItem source, final BedrockItem destination,
+                                    final boolean subtype, final boolean damageable) {
+        return NativeItemStacking.canMerge(source, destination,
+                new ComponentItemStackingProperties(64, null, subtype, damageable),
+                BedrockItem::data, NativeItemStackingTest::restrictions);
+    }
+
+    private static Set<String> restrictions(final String[] values) {
+        return Set.copyOf(Arrays.asList(values));
+    }
+
+}
