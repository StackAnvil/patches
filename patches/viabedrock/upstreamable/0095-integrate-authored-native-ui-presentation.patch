+package net.raphimc.viabedrock.api.model.container;
+
+import java.util.Set;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+import net.raphimc.viabedrock.api.model.NativeContainerAction;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.model.container.player.HudContainer;
+import net.raphimc.viabedrock.api.model.container.player.InventoryContainer;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ComplexInventoryTransaction_Type;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.NativeContainerUiState;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.InventoryTransactionRewriter;
+import net.raphimc.viabedrock.protocol.types.item.NetworkItemStackDescriptorType;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeContainerLegacyActionsTest {
+
+    @Test
+    void sendsBalancedNormalTransactionAndReadsCorrectionsWithoutWaitingForModernResponses() {
+        final var fixture = new Fixture();
+        fixture.inventory.setItem(3, named(63));
+        fixture.inventory.setItem(9, named(62));
+        final var sent = new AtomicReference<BedrockInventoryTransaction>();
+        assertTrue(fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches, sent::set));
+        final var transaction = sent.get();
+        assertEquals(0, transaction.legacyRequestId());
+        assertEquals(ComplexInventoryTransaction_Type.NormalTransaction, transaction.transactionType());
+        assertEquals(2, transaction.actions().size());
+        final var debit = transaction.actions().get(0);
+        final var credit = transaction.actions().get(1);
+        assertEquals(6, debit.source().containerId());
+        assertEquals(9, debit.slot());
+        assertEquals(4, debit.fromItem().amount());
+        assertEquals(3, debit.toItem().amount());
+        assertEquals(0, credit.source().containerId());
+        assertEquals(3, credit.slot());
+        assertEquals(63, credit.fromItem().amount());
+        assertEquals(64, credit.toItem().amount());
+        assertEquals(3, fixture.menu.getItem(9).amount());
+        assertEquals(64, fixture.inventory.getItem(3).amount());
+        assertEquals(62, fixture.inventory.getItem(9).amount());
+        assertEquals(0, fixture.menu.getItem(9).netId());
+        fixture.menu.setItem(9, named(4));
+        fixture.inventory.setItem(3, named(60));
+        assertTrue(fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches, sent::set));
+        assertEquals(4, sent.get().actions().get(0).fromItem().amount());
+        assertEquals(60, sent.get().actions().get(1).fromItem().amount());
+        assertEquals(61, fixture.inventory.getItem(3).amount());
+    }
+
+    @Test
+    void encodesNormalActionsWithLegacyNetworkItemDescriptors() {
+        final var fixture = new Fixture();
+        final var itemRewriter = mock(ItemRewriter.class);
+        when(fixture.user.get(ItemRewriter.class)).thenReturn(itemRewriter);
+        when(itemRewriter.newItemType()).thenReturn(
+                new NetworkItemStackDescriptorType(0,
+                        new Int2ObjectOpenHashMap<>(), false));
+        final var codec = new InventoryTransactionRewriter(fixture.user)
+                .getInventoryTransactionType();
+        final var sent = new AtomicReference<BedrockInventoryTransaction>();
+        assertTrue(fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches, sent::set));
+        final var wire = Unpooled.buffer();
+        try {
+            codec.write(wire, sent.get());
+            final byte[] header = new byte[4];
+            wire.getBytes(0, header);
+            assertArrayEquals(new byte[] {0, 0, 0, 2}, header);
+            final var decoded = codec.read(wire);
+            assertEquals(ComplexInventoryTransaction_Type.NormalTransaction, decoded.transactionType());
+            assertEquals(0, decoded.legacyRequestId());
+            assertEquals(2, decoded.actions().size());
+            final var debit = decoded.actions().get(0);
+            final var credit = decoded.actions().get(1);
+            assertEquals(6, debit.source().containerId());
+            assertEquals(9, debit.slot());
+            assertEquals(4, debit.fromItem().amount());
+            assertEquals(3, debit.toItem().amount());
+            assertEquals(0, credit.source().containerId());
+            assertEquals(0, credit.slot());
+            assertTrue(credit.fromItem().isEmpty());
+            assertEquals(1, credit.toItem().amount());
+            assertEquals(debit.fromItem().tag(), credit.toItem().tag());
+            assertNull(credit.toItem().netId());
+            assertFalse(wire.isReadable());
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void rejectsTransportFailuresAndStaleOrUnauthorizedActionsWithoutMutatingSlots() {
+        final var fixture = new Fixture();
+        assertThrows(IllegalStateException.class, () -> fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches,
+                transaction -> {
+                    throw new IllegalStateException("Transport failed");
+                }));
+        assertEquals(4, fixture.menu.getItem(9).amount());
+        assertTrue(fixture.inventory.getItem(0).isEmpty());
+        assertFalse(fixture.actions.autoPlaceOne(10, item -> 64, NativeContainerLegacyActionsTest::matches, transaction -> fail()));
+        when(fixture.game.isInventoryServerAuthoritative()).thenReturn(true);
+        assertFalse(fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches, transaction -> fail()));
+        when(fixture.game.isInventoryServerAuthoritative()).thenReturn(false);
+        when(fixture.tracker.getCurrentContainer()).thenReturn(new ChestContainer(fixture.user, (byte) 6, null, null, 27));
+        assertFalse(fixture.actions.autoPlaceOne(9, item -> 64, NativeContainerLegacyActionsTest::matches, transaction -> fail()));
+        assertFalse(fixture.state.handleAction(new NativeContainerAction(6, fixture.message.sequence(), 0,
+                NativeContainerAction.Mode.ACTIVATE, -1)));
+        assertFalse(fixture.state.blocksVanillaClicks());
+    }
+
+    @Test
+    void activationWaitsForAuthoredItemsAndRejectsAnOlderPresentation() {
+        final var fixture = new Fixture();
+        final var activation = new NativeContainerAction(6, fixture.message.sequence(), 0,
+                NativeContainerAction.Mode.ACTIVATE, -1);
+        assertTrue(fixture.state.handleAction(activation));
+        fixture.menu.clearItems();
+        assertFalse(fixture.state.handleAction(activation));
+        assertFalse(fixture.state.blocksVanillaClicks());
+        fixture.menu.setItem(9, named(4));
+        assertNotNull(fixture.state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS,
+                new ContainerUi.Title("Actual", false), program(), value -> NativeContainerLegacyActions.create(fixture.user, value)));
+        assertFalse(fixture.state.handleAction(activation));
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem named(final int amount) {
+        final var display = new CompoundTag();
+        display.putString("Name", "Action");
+        final var tag = new CompoundTag();
+        tag.put("display", display);
+        final var item = new BedrockItem(1);
+        item.setAmount(amount);
+        item.setNetId(0);
+        item.setTag(tag);
+        return item;
+    }
+
+    private static ContainerUi program() {
+        return ContainerUi.fromProgram(JsonParser.parseString("""
+                {"definitions": {
+                  "chest.small_chest_screen": {"parent":"", "value":{"$screen_content":"chest.small_chest_panel"}},
+                  "chest.small_chest_panel": {"parent":"", "value":{"type":"grid", "collection_name":"container_items",
+                    "grid_dimensions":[27,1], "controls":[{"action":{"type":"button", "grid_position":[9,0],
+                      "bindings":[
+                        {"binding_type":"collection", "binding_collection_name":"container_items", "binding_name":"#hover_text", "binding_name_override":"#caption"},
+                        {"binding_type":"view", "source_property_name":"(not (#caption = ''))", "target_property_name":"#visible"}],
+                      "button_mappings":[{"from_button_id":"button.menu_select", "to_button_id":"button.container_auto_place_one", "mapping_type":"pressed"}]}}]}}
+                }}
+                """).getAsJsonObject());
+    }
+
+    private static final class Fixture {
+        final UserConnection user = mock(UserConnection.class);
+        final InventoryTracker tracker = mock(InventoryTracker.class);
+        final GameSessionStorage game = mock(GameSessionStorage.class);
+        final NativeContainerUiState state = new NativeContainerUiState();
+        final ChestContainer menu = new ChestContainer(this.user, (byte) 6, null, null, 27);
+        final InventoryContainer inventory = new InventoryContainer(this.user) {
+            @Override
+            protected void onSlotChanged(final int slot, final BedrockItem previous, final BedrockItem next) { }
+        };
+        final NativeContainerMessage message;
+        final NativeContainerLegacyActions actions;
+
+        Fixture() {
+            final Map<Class<?>, Object> stores = Map.of(InventoryTracker.class, this.tracker,
+                    GameSessionStorage.class, this.game, NativeContainerUiState.class, this.state);
+            when(this.user.get(any())).thenAnswer(call -> stores.get(call.getArgument(0)));
+            when(this.tracker.getCurrentContainer()).thenReturn(this.menu);
+            when(this.tracker.getInventoryContainer()).thenReturn(this.inventory);
+            when(this.tracker.getHudContainer()).thenReturn(new HudContainer(this.user));
+            this.menu.setItem(9, named(4));
+            final var backend = new AtomicReference<NativeContainerLegacyActions>();
+            this.message = this.state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS,
+                    new ContainerUi.Title("Actual", false), program(), value -> {
+                        final var actions = NativeContainerLegacyActions.create(this.user, value);
+                        backend.set(actions);
+                        return actions;
+                    });
+            assertNotNull(this.message);
+            this.actions = backend.get();
+        }
+    }
+
+}
