+package net.raphimc.viabedrock.protocol.model;
+
+import java.util.Objects;
+
+/** A name and auxiliary value before native definition lookup and Item construction. */
+public record NativeItemName(String identifier, int auxiliary) {
+
+    public NativeItemName {
+        Objects.requireNonNull(identifier);
+    }
+
+    /** Parse the native legacy spelling. An absent name does not construct a lookup query. */
+    public static NativeItemName parse(final String input, final int auxiliary) {
+        if (input.isEmpty()) {
+            return null;
+        }
+        final String[] parts = input.split(":", -1);
+        final int count = parts.length - (parts[parts.length - 1].isEmpty() ? 1 : 0);
+        final boolean numeric = count >= 2 && numericSuffix(input.substring(input.indexOf(':') + 1));
+        final String namespace = count < 2 || numeric ? "minecraft" : lowercase(parts[0]);
+        String name = lowercase(parts[count < 2 || numeric ? 0 : 1]);
+        final Integer parsed = numeric ? metadata(parts[1]) : count >= 3 ? metadata(parts[2]) : null;
+        if (name.startsWith("tile.")) {
+            name = name.substring(5);
+        }
+        return new NativeItemName(namespace + ':' + name, parsed != null ? parsed : auxiliary);
+    }
+
+    private static boolean numericSuffix(final String value) {
+        // The native digit predicate reads a C string from the second field's start.
+        for (int index = 0; index < value.length() && value.charAt(index) != 0; index++) {
+            final char digit = value.charAt(index);
+            if (digit < '0' || digit > '9') {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static Integer metadata(final String value) {
+        int index = 0;
+        while (index < value.length() && whitespace(value.charAt(index))) {
+            index++;
+        }
+        final boolean negative = index < value.length() && value.charAt(index) == '-';
+        if (index < value.length() && (value.charAt(index) == '+' || negative)) {
+            index++;
+        }
+        final int start = index;
+        int result = 0;
+        while (index < value.length() && value.charAt(index) >= '0' && value.charAt(index) <= '9') {
+            result = result * 10 + value.charAt(index++) - '0';
+            if (result > 255) {
+                return null;
+            }
+        }
+        return index == start || negative && result != 0 ? null : result;
+    }
+
+    private static boolean whitespace(final char value) {
+        return value == ' ' || value >= '\t' && value <= '\r';
+    }
+
+    private static String lowercase(final String value) {
+        final StringBuilder result = new StringBuilder(value.length());
+        for (int index = 0; index < value.length(); index++) {
+            final char character = value.charAt(index);
+            result.append(character >= 'A' && character <= 'Z' ? (char) (character + ('a' - 'A')) : character);
+        }
+        return result.toString();
+    }
+
+}
