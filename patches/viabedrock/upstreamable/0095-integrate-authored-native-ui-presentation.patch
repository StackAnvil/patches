+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import java.util.Set;
+import java.util.function.BiPredicate;
+import java.util.function.Consumer;
+import java.util.function.ToIntFunction;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ComplexInventoryTransaction_Type;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceFlags;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.inventory.BedrockInventoryTransaction;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryActionData;
+import net.raphimc.viabedrock.protocol.model.inventory.InventorySource;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryTransactionData;
+import net.raphimc.viabedrock.protocol.rewriter.InventoryTransactionRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.NativeContainerUiState;
+
+/** Normal inventory transactions for a client-authoritative authored chest presentation. */
+public final class NativeContainerLegacyActions implements NativeContainerUiState.Actions {
+
+    private final UserConnection user;
+    private final Container menu;
+    private final int menuId;
+    private final ContainerUi.Kind kind;
+    private final String title;
+    private final ContainerUi program;
+
+    private NativeContainerLegacyActions(final UserConnection user, final Container menu,
+                                         final NativeContainerMessage message) {
+        this.user = user;
+        this.menu = menu;
+        this.menuId = message.menuId();
+        this.kind = message.kind();
+        this.title = message.conditionTitle();
+        this.program = ContainerUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+    }
+
+    public static NativeContainerLegacyActions create(final UserConnection user, final NativeContainerMessage message) {
+        final Container menu = user.get(InventoryTracker.class).getCurrentContainer();
+        if (user.get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                || menu == null || menu.getClass() != ChestContainer.class
+                || menu.size() != message.kind().containerSlots()
+                || menu.size() != 27 && menu.size() != 54
+                || Byte.toUnsignedInt(menu.javaContainerId()) != message.menuId()) {
+            return null;
+        }
+        return new NativeContainerLegacyActions(user, menu, message);
+    }
+
+    @Override
+    public boolean current() {
+        final var inventory = this.user.get(InventoryTracker.class);
+        return !this.user.get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                && inventory.getCurrentContainer() == this.menu
+                && inventory.getPendingCloseContainer() == null;
+    }
+
+    private Set<Integer> actionSlots() {
+        return this.current() ? NativeContainerActionSlots.resolve(this.user, this.menu, this.menuId,
+                this.kind, this.title, this.program) : Set.of();
+    }
+
+    @Override
+    public boolean hasActions() {
+        return !this.actionSlots().isEmpty();
+    }
+
+    @Override
+    public boolean autoPlaceOne(final int revision, final int sourceSlot) {
+        final boolean sent = this.autoPlaceOne(sourceSlot,
+                this.user.get(ItemRewriter.class)::maxStackSize,
+                this.user.get(ItemRewriter.class)::matchesStackQuery, transaction -> {
+                    final var packet = PacketWrapper.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION, this.user);
+                    packet.write(this.user.get(InventoryTransactionRewriter.class).getInventoryTransactionType(), transaction);
+                    packet.sendToServer(BedrockProtocol.class);
+                });
+        if (sent) {
+            // Client-authoritative transactions have no ItemStackResponse to advance the Java view.
+            PacketFactory.sendJavaContainerSetContent(this.user, this.menu);
+            PacketFactory.sendJavaContainerSetContent(this.user,
+                    this.user.get(InventoryTracker.class).getInventoryContainer());
+        }
+        return sent;
+    }
+
+    boolean autoPlaceOne(final int sourceSlot, final ToIntFunction<BedrockItem> maximumStackSize,
+                         final BiPredicate<BedrockItem, BedrockItem> matchesStackQuery,
+                         final Consumer<BedrockInventoryTransaction> sender) {
+        if (!this.actionSlots().contains(sourceSlot) || sourceSlot < 0 || sourceSlot >= this.menu.size()) {
+            return false;
+        }
+        final var inventory = this.user.get(InventoryTracker.class).getInventoryContainer();
+        final BedrockItem source = this.menu.getItem(sourceSlot);
+        final var plan = NativeContainerTransfer.plan(source, inventory.getItems(),
+                maximumStackSize.applyAsInt(source), matchesStackQuery, slot -> true);
+        if (plan == null) {
+            return false;
+        }
+        final var transaction = new BedrockInventoryTransaction(0, List.of(), List.of(
+                new InventoryActionData(source(this.menu), sourceSlot, plan.sourceBefore(), plan.sourceAfter()),
+                new InventoryActionData(source(inventory), plan.destinationSlot(), plan.destinationBefore(), plan.destinationAfter())),
+                ComplexInventoryTransaction_Type.NormalTransaction, new InventoryTransactionData.NormalTransactionData());
+        // Keep both tracked slots unchanged if serialization or transport fails.
+        sender.accept(transaction);
+        this.menu.setItem(sourceSlot, plan.sourceAfter());
+        inventory.setItem(plan.destinationSlot(), plan.destinationAfter());
+        return true;
+    }
+
+    private static InventorySource source(final Container container) {
+        return new InventorySource(InventorySourceType.Container_Inventory,
+                container.containerId(), InventorySourceFlags.No_Flag);
+    }
+
+}
