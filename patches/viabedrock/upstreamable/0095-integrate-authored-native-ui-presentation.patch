+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import net.raphimc.viabedrock.api.model.NativeHudMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.HudActionbarUi;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.SetTitlePacket_TitleType;
+
+/** Action-bar instances expire independently; title clear, reset and timing packets do not affect them. */
+public final class NativeHudActionbarState implements StorableObject {
+
+    private boolean nativeActionbar;
+
+    public NativeHudMessage update(final SetTitlePacket_TitleType type, final String text, final ResourcePackStorage resources) {
+        if (type != SetTitlePacket_TitleType.Actionbar && type != SetTitlePacket_TitleType.ActionbarTextObject) {
+            return null;
+        }
+        if (text.isEmpty()) {
+            return null;
+        }
+        final var scene = new HudActionbarUi(text).resolve(resources.getJsonUiProgram());
+        if (scene == null) {
+            if (!this.nativeActionbar) {
+                return null;
+            }
+            this.nativeActionbar = false;
+            return new NativeHudMessage("", false, 0);
+        }
+        this.nativeActionbar = true;
+        return new NativeHudMessage(scene.toString(), true, NativeHudMessage.ANIMATION_LIFETIME);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/NativeHudTitleState.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/NativeHudTitleState.java
