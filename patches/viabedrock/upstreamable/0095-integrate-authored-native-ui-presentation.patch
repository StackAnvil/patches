+        final var program = new JsonUiProgram(List.of(Map.of("ui/hud_screen.json", json)));
+        final var resources = new ResourcePackStorage(List.of()) {
+            boolean missing;
+            @Override
+            public JsonUiProgram getJsonUiProgram() {
+                return this.missing ? new JsonUiProgram(List.of()) : program;
+            }
+        };
+        final var state = new NativeHudActionbarState();
+        final var message = state.update(SetTitlePacket_TitleType.Actionbar, text, resources);
+        assertNotNull(message);
+        final var root = JsonParser.parseString(message.scene()).getAsJsonObject().getAsJsonObject("root");
+        assertEquals(1, root.getAsJsonArray("children").size());
+        final var host = root.getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(9, host.getAsJsonArray("offset").get(1).getAsInt());
+        assertEquals(text, host.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        resources.missing = true;
+        assertTrue(state.update(SetTitlePacket_TitleType.Actionbar, text, resources).scene().isEmpty());
+        assertNull(state.update(SetTitlePacket_TitleType.Actionbar, text, resources));
+    }
+
+    private static void collect(final JsonObject node, final List<JsonObject> nodes) {
+        nodes.add(node);
+        for (final var child : node.getAsJsonArray("children")) {
+            collect(child.getAsJsonObject(), nodes);
+        }
+    }
+
+}
