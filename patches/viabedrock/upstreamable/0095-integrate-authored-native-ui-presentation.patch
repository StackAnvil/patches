+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.util;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.ToLongFunction;
+
+/** MSVC unordered-map traversal for unique UTF-8 keys, with the caller's native hash function. */
+public final class NativeStringMap<V> {
+
+    private final Map<String, V> values = new HashMap<>();
+    private final ToLongFunction<byte[]> hash;
+    private Map<Integer, ArrayDeque<String>> buckets = new LinkedHashMap<>();
+    private int capacity = 8;
+
+    public NativeStringMap(final ToLongFunction<byte[]> hash) {
+        this.hash = Objects.requireNonNull(hash);
+    }
+
+    public V get(final String key) {
+        return this.values.get(key);
+    }
+
+    public void put(final String key, final V value) {
+        if (this.values.containsKey(key)) {
+            this.values.put(key, value);
+            return;
+        }
+        if (this.values.size() == this.capacity) {
+            final List<String> previous = this.keys();
+            this.capacity = Math.multiplyExact(this.capacity, this.capacity < 512 ? 8 : 2);
+            this.buckets = new LinkedHashMap<>();
+            previous.forEach(this::insert);
+        }
+        this.values.put(key, value);
+        this.insert(key);
+    }
+
+    public void remove(final String key) {
+        if (this.values.remove(key) != null) {
+            final int bucket = this.bucket(key);
+            final ArrayDeque<String> keys = this.buckets.get(bucket);
+            keys.remove(key);
+            if (keys.isEmpty()) {
+                this.buckets.remove(bucket);
+            }
+        }
+    }
+
+    public List<V> values() {
+        return this.keys().stream().map(this.values::get).toList();
+    }
+
+    private void insert(final String key) {
+        this.buckets.computeIfAbsent(this.bucket(key), ignored -> new ArrayDeque<>()).addFirst(key);
+    }
+
+    private int bucket(final String key) {
+        return (int) this.hash.applyAsLong(key.getBytes(StandardCharsets.UTF_8)) & (this.capacity - 1);
+    }
+
+    private List<String> keys() {
+        return this.buckets.values().stream().flatMap(ArrayDeque::stream).toList();
+    }
+
+}
