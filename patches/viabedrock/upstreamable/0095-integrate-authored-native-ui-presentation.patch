+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class NativeItemDefinitionsTest {
+
+    @Test
+    void emptyAliasResultsPreserveTheOriginalDefinitionAndAuxiliary() {
+        final var generic = new NativeItemDefinitions.Seed<>("minecraft:spawn_egg", "minecraft:spawn_egg", 850,
+                new Receiver("0x14e818c90", 850));
+        final var chicken = new NativeItemDefinitions.Seed<>("minecraft:chicken_spawn_egg", "minecraft:chicken_spawn_egg", 600,
+                new Receiver("0x14e818c90", 600));
+        final var model = new NativeItemDefinitions<>(new NativeItemDefinitions.Bootstrap<>(850, List.of(generic, chicken), List.of()),
+                List.of(), new CapturedFactory(new JsonArray()), BuiltinItemAliases::rewrite);
+        final var named = model.lookup("minecraft:spawn_egg", 1);
+        final var canonical = model.lookup(new NativeItemName("minecraft:spawn_egg", 1));
+        assertSame(model.exact("minecraft:spawn_egg"), named.definition());
+        assertSame(named.definition(), canonical.definition());
+        assertEquals(1, named.auxiliary());
+        assertEquals(1, canonical.auxiliary());
+        final var rewritten = model.lookup("minecraft:spawn_egg", 10);
+        assertSame(model.exact("minecraft:chicken_spawn_egg"), rewritten.definition());
+        assertEquals(0, rewritten.auxiliary());
+    }
+
+    @Test
+    void matchesOriginalConstructionLifetimesAndLookupOwners() throws Exception {
+        final String path = System.getenv("STACKANVIL_NATIVE_ITEM_DEFINITIONS");
+        assumeTrue(path != null && !path.isBlank(), "Native definition construction corpus is optional");
+        try (var reader = new InputStreamReader(new GZIPInputStream(Files.newInputStream(Path.of(path))), StandardCharsets.UTF_8)) {
+            final JsonObject reference = JsonParser.parseReader(reader).getAsJsonObject();
+            final JsonArray controls = reference.getAsJsonArray("controls");
+            final JsonObject initial = controls.get(0).getAsJsonObject().getAsJsonObject("capture")
+                    .getAsJsonObject("definitionOwnership").getAsJsonObject("initializationReturn");
+            for (final JsonElement control : controls) {
+                compare(initial, control.getAsJsonObject(), reference.getAsJsonArray("blocks"));
+            }
+        }
+    }
+
+    private static void compare(final JsonObject initial, final JsonObject control, final JsonArray blocks) {
+        final JsonObject state = control.getAsJsonObject("capture").getAsJsonObject("definitionOwnership");
+        final List<NativeItemDefinitions.Seed<Receiver>> first = new ArrayList<>();
+        final List<NativeItemDefinitions.Seed<Receiver>> staged = new ArrayList<>();
+        initial.getAsJsonArray("ordinary").forEach(row -> first.add(seed(row.getAsJsonObject())));
+        initial.getAsJsonArray("staging").forEach(row -> staged.add(seed(row.getAsJsonObject())));
+        final Map<String, ReceiverIdentity> identities = new HashMap<>();
+        for (final String field : List.of("ordinary", "staging")) {
+            for (final JsonElement value : state.getAsJsonObject("initializationReturn").getAsJsonArray(field)) {
+                final JsonObject row = value.getAsJsonObject();
+                if (!row.get("item").isJsonNull()) {
+                    identities.put(row.get("item").getAsString(), identity(row));
+                }
+            }
+        }
+        for (final JsonElement value : state.getAsJsonArray("registrationEvents")) {
+            final JsonObject row = value.getAsJsonObject();
+            identities.putIfAbsent(row.get("item").getAsString(), identity(row));
+        }
+        final List<ItemEntry> entries = new ArrayList<>();
+        for (final JsonElement value : control.getAsJsonObject("input").getAsJsonArray("items")) {
+            final JsonObject row = value.getAsJsonObject();
+            entries.add(new ItemEntry(row.get("name").getAsString(), row.get("id").getAsInt(),
+                    row.get("componentBased").getAsBoolean(), ItemVersion.getByValue(row.get("version").getAsInt()), new CompoundTag()));
+        }
+        final var model = new NativeItemDefinitions<>(
+                new NativeItemDefinitions.Bootstrap<>(initial.get("counter").getAsInt(), first, staged), entries,
+                new CapturedFactory(blocks), BuiltinItemAliases::rewrite);
+        final JsonObject after = state.getAsJsonObject("after");
+        assertEquals(after.get("counter").getAsInt(), model.constructorCounter());
+        assertEquals(after.getAsJsonArray("ordinary").size(), model.definitions().size());
+        int index = 0;
+        for (final JsonElement value : after.getAsJsonArray("ordinary")) {
+            final JsonObject row = value.getAsJsonObject();
+            final var definition = model.definitions().get(index++);
+            assertEquals(row.get("key").getAsString(), definition.identifier());
+            assertEquals(row.get("id").getAsInt(), definition.id(), definition::identifier);
+            assertEquals(identities.get(row.get("item").getAsString()), identity(definition));
+        }
+        assertEquals(after.getAsJsonArray("owned").size(), model.ownedDefinitions().size());
+        index = 0;
+        for (final JsonElement value : after.getAsJsonArray("owned")) {
+            final JsonObject row = value.getAsJsonObject();
+            assertEquals(identities.get(row.get("item").getAsString()), identity(model.ownedDefinitions().get(index++)));
+        }
+        assertEquals(after.getAsJsonArray("spares").size(), model.spareDefinitions().size());
+        index = 0;
+        for (final JsonElement value : after.getAsJsonArray("spares")) {
+            final JsonObject row = value.getAsJsonObject();
+            assertEquals(identities.getOrDefault(row.get("item").getAsString(), identity(row)), identity(model.spareDefinitions().get(index++)));
+        }
+        for (final JsonElement value : after.getAsJsonArray("numeric")) {
+            final JsonObject row = value.getAsJsonObject();
+            final int id = row.get("key").getAsInt();
+            final ReceiverIdentity expected = row.get("item").isJsonNull() || (short) id == 0 || (short) id == -1
+                    ? null : identities.get(row.get("item").getAsString());
+            assertEquals(expected, identity(model.numeric(id)), () -> "Numeric owner: " + id);
+        }
+        for (final JsonElement value : state.getAsJsonArray("namedRows")) {
+            final JsonObject row = value.getAsJsonObject();
+            final var lookup = model.lookup(row.get("inputName").getAsString(), row.get("inputAux").getAsInt());
+            final JsonArray selected = row.getAsJsonArray("selectedDefinitions");
+            assertEquals(selected.isEmpty() ? null : identities.get(selected.get(0).getAsJsonObject().get("item").getAsString()),
+                    identity(lookup.definition()), row::toString);
+            if (!selected.isEmpty()) {
+                assertEquals((int) selected.get(0).getAsJsonObject().get("aux").getAsLong(), lookup.auxiliary(), row::toString);
+            }
+        }
+        // Production bootstrap data and its block policy must also select the captured names and IDs.
+        final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+        assertEquals(model.definitions().stream().map(NativeItemDefinitions.Definition::identifier).toList(),
+                registry.definitions().stream().map(NativeItemDefinitions.Definition::identifier).toList());
+        for (final var definition : model.definitions()) {
+            assertEquals(definition.id(), registry.definition(definition.identifier()).id());
+            final var numeric = model.numeric(definition.id());
+            assertEquals(numeric != null ? numeric.identifier() : null, registry.identifier(definition.id()));
+        }
+    }
+
+    private static NativeItemDefinitions.Seed<Receiver> seed(final JsonObject row) {
+        final String name = row.get("storedName").getAsString();
+        return new NativeItemDefinitions.Seed<>(row.has("key") ? row.get("key").getAsString() : name, name,
+                row.get("id").getAsInt(), new Receiver(row.get("vtable").getAsString(), row.get("id").getAsInt()));
+    }
+
+    private static ReceiverIdentity identity(final JsonObject row) {
+        return new ReceiverIdentity(row.get("storedName").getAsString(), row.get("id").getAsInt(), row.get("vtable").getAsString());
+    }
+
+    private static ReceiverIdentity identity(final NativeItemDefinitions.Definition<Receiver> value) {
+        return value == null ? null : new ReceiverIdentity(value.identifier(), value.receiver().constructorId(), value.receiver().vtable());
+    }
+
+    private record Receiver(String vtable, int constructorId) { }
+
+    private record ReceiverIdentity(String identifier, int constructorId, String vtable) { }
+
+    /** Only caller data and class construction are supplied; post-registration decisions use their live inputs. */
+    private record CapturedFactory(JsonArray blocks) implements NativeItemDefinitions.Factory<Receiver> {
+
+        @Override
+        public NativeItemDefinitions.Seed<Receiver> construct(final ItemVersion version, final String raw, final short id) {
+            final NativeItemName parsed = NativeItemName.parse(raw, 0);
+            final String name = parsed == null ? ":" : parsed.identifier();
+            return new NativeItemDefinitions.Seed<>(name, name, id, new Receiver(
+                    version == ItemVersion.DataDriven ? "0x14e8ae710" : "0x14e818c90", id));
+        }
+
+        @Override
+        public void readComponents(final NativeItemDefinitions.Definition<Receiver> definition, final CompoundTag components) {
+            fail("This control supplies no component block");
+        }
+
+        @Override
+        public void complete(final NativeItemDefinitions<Receiver>.Builder builder) {
+            for (final JsonElement value : this.blocks) {
+                final JsonObject block = value.getAsJsonObject();
+                String name = block.get("name").getAsString();
+                final int id = block.get("itemId").getAsInt();
+                if (name.equals("minecraft:air") || builder.numeric(id) != null) {
+                    continue;
+                }
+                final var existing = builder.lookup(name, 0).definition();
+                if (existing != null) {
+                    if ((block.get("flags").getAsInt() & 2) != 0) {
+                        builder.bindNumeric(id, existing);
+                        continue;
+                    }
+                    final int separator = name.indexOf(':');
+                    name = name.substring(0, separator + 1) + "item." + name.substring(separator + 1);
+                }
+                if (builder.lookup(name, 0).definition() != null) {
+                    continue;
+                }
+                assertEquals(0, block.get("flags").getAsInt() & 2, "Missing door builtin");
+                final String table = block.get("specialPredicate").getAsBoolean() ? "0x14eaac9d0" : "0x14ea45bc0";
+                builder.construct(new NativeItemDefinitions.Seed<>(name, name, id, new Receiver(table, id)), name);
+            }
+        }
+
+    }
+
+}
