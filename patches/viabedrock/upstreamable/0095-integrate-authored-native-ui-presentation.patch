+    @Test
+    void retainsAuthoredFactoryAncestorsAndClearsAnUnsupportedReplacement() {
+        final String text = UUID.randomUUID().toString();
+        final byte[] json = """
+                {"namespace":"hud","root_panel":{"type":"panel","controls":[
+                  {"title":{"type":"panel","factory":{"name":"hud_title_text_factory","control_ids":{"hud_title_text":"hud.absent"}}}},
