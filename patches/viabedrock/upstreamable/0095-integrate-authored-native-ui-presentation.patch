+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import net.raphimc.viabedrock.api.model.container.block.Generic3x3Container;
+import net.raphimc.viabedrock.api.model.container.block.HopperContainer;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerType;
+
+/** Ordinary external storage providers with direct container slot identities. */
+public final class NativeStorageContainers {
+
+    public static boolean supported(final Container container) {
+        if (container == null) {
+            return false;
+        }
+        // Actor-backed hopper opens can retain the wire's generic CONTAINER type.
+        // Their resolved provider, not that raw type alone, owns the five slots.
+        return switch (container.type()) {
+            case CONTAINER -> container.getClass() == ChestContainer.class
+                    && (container.size() == 27 || container.size() == 54)
+                    || container.getClass() == HopperContainer.class && container.size() == 5;
+            case MINECART_CHEST, CHEST_BOAT -> container.getClass() == ChestContainer.class && container.size() == 27;
+            case HOPPER, MINECART_HOPPER -> container.getClass() == HopperContainer.class && container.size() == 5;
+            case DISPENSER, DROPPER -> container.getClass() == Generic3x3Container.class && container.size() == 9;
+            default -> false;
+        };
+    }
+
+    public static boolean matches(final Container container, final ContainerUi.Kind kind) {
+        if (!supported(container) || kind == null || container.size() != kind.containerSlots()) {
+            return false;
+        }
+        return switch (kind) {
+            case CHEST_3_ROWS, CHEST_6_ROWS, ENDER_CHEST, SHULKER_BOX, BARREL -> container.getClass() == ChestContainer.class;
+            case HOPPER -> container.getClass() == HopperContainer.class;
+            case DISPENSER -> container.type() == ContainerType.DISPENSER;
+            case DROPPER -> container.type() == ContainerType.DROPPER;
+            case BREWING_STAND -> false;
+        };
+    }
+
+    private NativeStorageContainers() {
+    }
+
+}
