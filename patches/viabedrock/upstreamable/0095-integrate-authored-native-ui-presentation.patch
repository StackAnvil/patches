@@ -0,0 +1,136 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.util.Key;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
+/** Compiled state belongs to a constructed definition, independently of its network declarations. */
+final class ItemDefinitionProperties {
+
+    enum Kind {
+        BUILTIN, LEGACY, COMPONENT, BLOCK, SLAB, DOOR
+    }
+
+    private final String identifier;
+    private final Kind kind;
+    private final BuiltinItemFactories.Definition builtin;
+    private final String block;
+    private final List<CompoundTag> updates = new ArrayList<>();
+    private ItemStackingProperties stacking;
+    private ItemStorageProperties storage = ItemStorageProperties.NONE;
+    private ItemBlockPlacer blockPlacer;
+    private int category;
+    private String description;
+
+    ItemDefinitionProperties(final String identifier, final Kind kind, final BuiltinItemFactories.Definition builtin,
+                             final String block, final boolean replacementBlockItem) {
+        this.identifier = identifier;
+        this.kind = kind;
+        this.builtin = builtin;
+        this.block = block;
+        this.stacking = builtin != null ? builtin.stacking()
+                : kind == Kind.COMPONENT ? ComponentItemStackingProperties.DEFAULT : LegacyItemStackingProperties.DEFAULT;
+        this.blockPlacer = replacementBlockItem
+                ? new ItemBlockPlacer(identifier, false, true, false) : ItemBlockPlacer.NONE;
+        this.category = builtin != null ? builtin.creativeCategory() : 4;
+        this.description = builtin != null ? builtin.componentDescription()
+                : kind == Kind.COMPONENT ? ordinaryDescription(identifier) : null;
+    }
+
+    void read(final CompoundTag components, final Function<String, String> resolveBlock) {
+        this.updates.add(components.copy());
+        this.stacking = this.stacking.withComponentData(components);
+        this.storage = this.storage.withComponentData(components);
+        if (this.component()) {
+            if (components.get("item_properties") instanceof CompoundTag properties) {
+                this.category = properties.get("creative_category") instanceof IntTag value ? value.asInt() & 0xFF : 0;
+            }
+            if (components.get("minecraft:block_placer") instanceof CompoundTag placer) {
+                this.blockPlacer = this.blockPlacer.withNetworkData(placer, this.identifier, resolveBlock);
+            }
+        }
+        if (this.kind == Kind.COMPONENT && components.get("minecraft:display_name") instanceof CompoundTag display
+                && display.get("value") instanceof StringTag value) {
+            this.description = value.getValue().isEmpty() ? ordinaryDescription(this.identifier) : value.getValue();
+        }
+    }
+
+    boolean component() {
+        return this.builtin != null ? this.builtin.version() == ItemVersion.DataDriven : this.kind == Kind.COMPONENT;
+    }
+
+    BuiltinItemFactories.Definition builtin() {
+        return this.builtin;
+    }
+
+    String block() {
+        return this.block;
+    }
+
+    ItemBlockPlacer blockPlacer() {
+        return this.blockPlacer;
+    }
+
+    ItemStackingProperties stacking() {
+        return this.stacking;
+    }
+
+    int category() {
+        return this.category;
+    }
+
+    ItemStorageProperties storage() {
+        return this.storage;
+    }
+
+    void category(final int category) {
+        this.category = category & 0xFF;
+    }
+
+    String description() {
+        return this.description;
+    }
+
+    List<CompoundTag> updates() {
+        return this.updates.stream().map(CompoundTag::copy).toList();
+    }
+
+    BuiltinItemFactories.SecondaryDescription secondaryDescription() {
+        return this.builtin != null ? this.builtin.secondaryDescription() : BuiltinItemFactories.SecondaryDescription.COMMON;
+    }
+
+    boolean writtenBook() {
+        return this.builtin != null && this.identifier.equals("minecraft:written_book") && !this.component();
+    }
+
+    String ordinaryName(final Short auxiliary, final CompoundTag data, final ItemNameContext context) {
+        if (this.description != null) {
+            return this.description;
+        }
+        if (this.builtin != null) {
+            return this.builtin.ordinaryName() != null
+                    ? this.builtin.ordinaryName().key(this.identifier, auxiliary, data, context) : null;
+        }
+        if (this.block != null && (this.kind == Kind.BLOCK || this.kind == Kind.SLAB)) {
+            return new BuiltinItemName.Block(BuiltinItemName.BlockKind.BLOCK, this.block, null, null)
+                    .key(this.identifier, auxiliary, data, context);
+        }
+        return ordinaryDescription(this.identifier) + ".name";
+    }
+
+    private static String ordinaryDescription(final String identifier) {
+        return "item." + Key.stripMinecraftNamespace(identifier);
+    }
+
+}
