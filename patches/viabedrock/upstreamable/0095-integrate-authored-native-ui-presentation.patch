+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Constructor-owned native factories, independent of advertised runtime-ID assignments. */
+final class BuiltinItemFactories {
+
+    private static final Map<String, Definition> FACTORIES = load();
+
+    static Definition get(final String identifier) {
+        return FACTORIES.get(identifier);
+    }
+
+    private static Map<String, Definition> load() {
+        final String path = "/assets/viabedrock/data/bedrock/item_factories.json";
+        try (var stream = BuiltinItemFactories.class.getResourceAsStream(path)) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native item factories");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native item factories do not match the target protocol");
+            }
+            final Map<String, Definition> factories = new HashMap<>();
+            for (final var element : data.getAsJsonArray("factories")) {
+                final var factory = element.getAsJsonObject();
+                final ItemVersion version = ItemVersion.getByValue(factory.get("version").getAsInt());
+                final int maximum = factory.get("maximum").getAsInt();
+                final boolean stackedByData = factory.get("stackedByData").getAsBoolean();
+                final ItemStackingProperties stacking = switch (version) {
+                    case DataDriven -> new ComponentItemStackingProperties(maximum, null, stackedByData, factory.get("damageable").getAsBoolean());
+                    case Legacy -> new LegacyItemStackingProperties(maximum, stackedByData, factory.get("maximumDamage").getAsShort(),
+                            factory.has("fixedMaximum") ? factory.get("fixedMaximum").getAsInt() : null,
+                            factory.has("forcedSubtype") && factory.get("forcedSubtype").getAsBoolean());
+                    default -> throw new IllegalStateException("Invalid native item factory version");
+                };
+                for (final var name : factory.getAsJsonArray("identifiers")) {
+                    final String identifier = name.getAsString();
+                    if (factories.putIfAbsent(identifier, new Definition(version, stacking)) != null) {
+                        throw new IllegalStateException("Duplicate native item factory: " + identifier);
+                    }
+                }
+            }
+            return Map.copyOf(factories);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native item factories", error);
+        }
+    }
+
+    private BuiltinItemFactories() { }
+
+    record Definition(ItemVersion version, ItemStackingProperties stacking) { }
+
+}
