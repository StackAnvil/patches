+                    () -> texts.translate(key), texts::translate, (body, arguments) -> texts.translate(body, arguments.toArray())),
+                    "native primary composition " + cases);
+            if (registered && NativeItemNames.customName(data, writtenBook) == null) {
+                assertNativeBytes(expected, NativeItemNames.ordinary(data,
+                        () -> texts.translate(key), texts::translate, (body, arguments) -> texts.translate(body, arguments.toArray())),
+                        "native ordinary composition " + cases);
+            }
+            cases++;
+        }
+        assertEquals(2442, cases);
+    }
+
+    private static void assertNativeBytes(final byte[] expected, final String actual, final String context) {
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.TAG_LE.write(buffer, new StringTag(actual));
+            assertEquals(8, buffer.readUnsignedByte());
+            assertEquals(0, buffer.readUnsignedShortLE());
+            final byte[] bytes = new byte[buffer.readUnsignedShortLE()];
+            buffer.readBytes(bytes);
+            assertFalse(buffer.isReadable());
+            assertArrayEquals(expected, bytes, context);
+        } finally {
+            buffer.release();
+        }
+    }
