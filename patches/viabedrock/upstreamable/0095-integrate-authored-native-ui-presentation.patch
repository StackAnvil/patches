@@ -0,0 +1,81 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import net.raphimc.viabedrock.api.model.NativeHudMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.HudTitleUi;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.SetTitlePacket_TitleType;
+
+/** Retains subtitle-before-title ordering without restarting a live title for subtitle updates. */
+public final class NativeHudTitleState implements StorableObject {
+
+    private String title = "";
+    private String subtitle = "";
+    private Timing configuredTiming = Timing.DEFAULT;
+    private Timing activeTiming = Timing.DEFAULT;
+    private boolean nativeTitle;
+
+    public NativeHudMessage update(final SetTitlePacket_TitleType type, final String text,
+                                   final int in, final int hold, final int out, final ResourcePackStorage resources) {
+        final boolean restart;
+        switch (type) {
+            case Title, TitleTextObject -> {
+                this.title = text;
+                this.activeTiming = this.configuredTiming;
+                restart = true;
+            }
+            case Subtitle, SubtitleTextObject -> {
+                this.subtitle = text;
+                restart = false;
+            }
+            case Times -> {
+                // Native title instances retain the timing captured when their factory was created.
+                this.configuredTiming = this.configuredTiming.update(in, hold, out);
+                return null;
+            }
+            case Clear, Reset -> {
+                this.title = "";
+                this.subtitle = "";
+                if (type == SetTitlePacket_TitleType.Reset) {
+                    this.configuredTiming = Timing.DEFAULT;
+                }
+                restart = false;
+            }
+            default -> {
+                return null;
+            }
+        }
+        final var scene = this.title.isEmpty() ? null
+                : new HudTitleUi(this.title, this.subtitle, this.activeTiming.fadeIn, this.activeTiming.stay, this.activeTiming.fadeOut).resolve(resources.getJsonUiProgram());
+        if (scene == null) {
+            if (!this.nativeTitle) {
+                return null;
+            }
+            this.nativeTitle = false;
+            return new NativeHudMessage("", false, 0);
+        }
+        this.nativeTitle = true;
+        return new NativeHudMessage(scene.toString(), restart, this.activeTiming.ticks());
+    }
+
+    private record Timing(int fadeIn, int stay, int fadeOut) {
+
+        private static final Timing DEFAULT = new Timing(10, 70, 20);
+
+        private Timing update(final int in, final int hold, final int out) {
+            return new Timing(in < 0 ? this.fadeIn : Math.min(in, 72000),
+                    hold < 0 ? this.stay : Math.min(hold, 72000),
+                    out < 0 ? this.fadeOut : Math.min(out, 72000));
+        }
+
+        private int ticks() {
+            return this.fadeIn + this.stay + this.fadeOut;
+        }
+
+    }
+
+}
