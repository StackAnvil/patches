+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+
+import java.util.function.Function;
+
+/** Compiled block-placer state, including partial reads and post-load owner binding. */
+public record ItemBlockPlacer(String blockIdentifier, boolean canUseBlockAsIcon, boolean replacementBlockItem, boolean alignedPlacement) {
+
+    public static final ItemBlockPlacer NONE = new ItemBlockPlacer(null, false, false, false);
+
+    public ItemBlockPlacer withNetworkData(final CompoundTag data, final String identifier, final Function<String, String> resolveBlock) {
+        if (!(data.get("block") instanceof StringTag block)) {
+            return this;
+        }
+        final String resolved = resolveBlock.apply(block.getValue());
+        final boolean valid = validSelectors(data);
+        final boolean icon = valid ? flag(data, "canUseBlockAsIcon") : this.canUseBlockAsIcon;
+        final boolean replacement = valid ? flag(data, "replaceBlockItem") : this.replacementBlockItem;
+        final boolean aligned = valid ? flag(data, "alignedPlacement") : this.alignedPlacement;
+        return new ItemBlockPlacer(resolved, icon, replacement && identifier.equals(resolved), aligned);
+    }
+
+    private static boolean flag(final CompoundTag data, final String name) {
+        return data.get(name) instanceof ByteTag value && value.asByte() != 0;
+    }
+
+    static boolean validSelectors(final CompoundTag data) {
+        return !data.contains("use_on") || data.get("use_on") instanceof ListTag<?> selectors
+                && selectors.getValue().stream().allMatch(ItemBlockPlacer::validBlockSelector);
+    }
+
+    private static boolean validBlockSelector(final Tag selector) {
+        if (selector instanceof StringTag) {
+            return true;
+        }
+        if (!(selector instanceof CompoundTag descriptor)
+                || descriptor.contains("name") && !(descriptor.get("name") instanceof StringTag)
+                || descriptor.contains("tags") && !(descriptor.get("tags") instanceof StringTag)) {
+            return false;
+        }
+        return !descriptor.contains("states") || descriptor.get("states") instanceof CompoundTag states
+                && states.getValue().values().stream().allMatch(value -> value instanceof ByteTag || value instanceof IntTag || value instanceof StringTag);
+    }
+
+}
