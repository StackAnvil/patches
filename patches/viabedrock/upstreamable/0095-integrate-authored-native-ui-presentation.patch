+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemRegistryTest {
+
+    @Test
+    void emptyDeclarationsKeepBuiltinAndLateBlockDefinitions() {
+        final var registry = new ItemRegistry(new ItemEntry[0]);
+        assertTrue(registry.registrations().isEmpty());
+        assertNotNull(registry.definition("minecraft:apple"));
+        assertNotNull(registry.definition("minecraft:stone"));
+        assertSame(registry.definition("minecraft:apple"), registry.definition(257));
+        assertNull(registry.definition(0));
+        assertNull(registry.definition(-1));
+        assertNull(registry.definition("test:missing"));
+        assertThrows(UnsupportedOperationException.class, () -> registry.definitions().clear());
+        assertThrows(UnsupportedOperationException.class, () -> registry.ids().clear());
+    }
+
+    @Test
+    void numericCollisionsRetainBothNamesAndSelectTheNativeTraversalOwner() {
+        final var first = entry("test:custom_first", 30010, ItemVersion.Legacy);
+        final var second = entry("test:custom_second", 30010, ItemVersion.Legacy);
+        final var registry = new ItemRegistry(new ItemEntry[]{first, second});
+        assertNotSame(registry.definition(first.identifier()), registry.definition(second.identifier()));
+        assertEquals(30010, registry.definition(first.identifier()).id());
+        assertEquals(30010, registry.definition(second.identifier()).id());
+        assertSame(registry.definition(second.identifier()), registry.definition(30010));
+        assertEquals(List.of(first, second), registry.registrations());
+        assertSame(registry.definition(30010), registry.definition(30010 + 65536));
+    }
+
+    @Test
+    void builtinNumericOwnerSurvivesCustomCollisionWithoutRemovingItsName() {
+        final var registry = new ItemRegistry(new ItemEntry[]{entry("test:apple_collision", 257, ItemVersion.Legacy)});
+        assertEquals(257, registry.definition("test:apple_collision").id());
+        assertSame(registry.definition("minecraft:apple"), registry.definition(257));
+        assertNotSame(registry.definition("test:apple_collision"), registry.definition(257));
+    }
+
+    @Test
+    void constructedStacksRetainReceiversAcrossCopiesAndExplicitIdentifierChanges() {
+        final var registry = new ItemRegistry(new ItemEntry[]{entry("minecraft:charcoal", 257, ItemVersion.Legacy)});
+        final var selected = registry.definition("minecraft:charcoal");
+        final var stack = new BedrockItem(selected, (short) 0, (byte) 1);
+        final var numeric = new BedrockItem(257);
+        assertSame(selected, registry.definition(stack));
+        assertSame(registry.definition("minecraft:apple"), registry.definition(numeric));
+        assertNotEquals(stack, numeric);
+        assertFalse(registry.sameDefinition(stack, numeric));
+        assertFalse(registry.sameItem(stack, numeric));
+        final var copy = stack.copy();
+        assertEquals(stack, copy);
+        assertEquals(stack.hashCode(), copy.hashCode());
+        assertSame(selected, registry.definition(copy));
+        assertTrue(registry.sameDefinition(stack, copy));
+        assertTrue(registry.sameItem(stack, copy));
+        final var other = new ItemRegistry(new ItemEntry[]{entry("minecraft:charcoal", 257, ItemVersion.Legacy)});
+        final var independent = new BedrockItem(other.definition("minecraft:charcoal"), (short) 0, (byte) 1);
+        assertFalse(registry.sameDefinition(stack, independent));
+        assertTrue(registry.sameItem(stack, independent));
+        copy.setIdentifier(257);
+        assertNull(copy.definition());
+        assertSame(registry.definition("minecraft:apple"), registry.definition(copy));
+        assertFalse(registry.sameItem(stack, copy));
+    }
+
+    @Test
+    void canonicalConstructionDoesNotParseAnExistingDefinitionNameAgain() {
+        final var registry = new ItemRegistry(new ItemEntry[]{entry("test:marker", 30012, ItemVersion.DataDriven), entry("test:tile.tile.marker", 30011, ItemVersion.DataDriven)});
+        final var selected = registry.definition("test:tile.marker");
+        assertNotNull(selected);
+        assertSame(selected, registry.lookup(new NativeItemName(selected.identifier(), 3)).definition());
+        assertSame(registry.definition("test:marker"), registry.lookup(selected.identifier(), 3).definition());
+        assertEquals(3, registry.lookup(new NativeItemName(selected.identifier(), 3)).auxiliary());
+    }
+
+    @Test
+    void rawStagingKeysDetermineWhetherTheBuiltinOrComponentSurvives() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                entry("element_39", 30011, ItemVersion.DataDriven),
+                entry("minecraft:element_40", 30012, ItemVersion.DataDriven)});
+        assertTrue(registry.componentItems().contains("minecraft:element_39"));
+        assertFalse(registry.componentItems().contains("minecraft:element_40"));
+        assertEquals(30011, registry.definition("minecraft:element_39").id());
+        assertEquals(30012, registry.definition("minecraft:element_40").id());
+        assertNotNull(registry.definition("minecraft:item.element_39"));
+    }
+
+    @Test
+    void explicitConstructionKeepsItsClassAcrossLaterDeclarations() {
+        for (final ItemVersion first : List.of(ItemVersion.Legacy, ItemVersion.DataDriven)) {
+            final ItemVersion second = first == ItemVersion.Legacy ? ItemVersion.DataDriven : ItemVersion.Legacy;
+            final var registry = new ItemRegistry(new ItemEntry[]{
+                    entry("test:item", 30011, first), entry("test:item", 30012, second)});
+            assertEquals(first == ItemVersion.DataDriven, registry.componentItems().contains("test:item"));
+            assertEquals(30012, registry.definition("test:item").id());
+            assertSame(registry.definition("test:item"), registry.definition(30012));
+        }
+    }
+
+    @Test
+    void invalidNetworkIdsDoNotRemoveConstructedDefinitionsOrSuppressTheirReaders() {
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 16);
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                component("test:item", -1, ItemVersion.DataDriven, components)});
+        assertNotNull(registry.definition("test:item"));
+        assertTrue(registry.definition("test:item").id() > 850);
+        assertSame(registry.definition("test:item"), registry.definition(registry.definition("test:item").id()));
+        assertEquals(16, registry.stackingProperties().get("test:item").maximum());
+        assertNull(registry.definition(-1));
+        final var absent = new ItemRegistry(new ItemEntry[]{entry("test:absent", -1, ItemVersion.None)});
+        assertNull(absent.definition("test:absent"));
+    }
+
+    @Test
+    void componentReadersUseExactRawKeysAfterEveryFactoryHasBeenConstructed() {
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 1);
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                component("test:item", 30011, ItemVersion.None, components),
+                entry("test:item", 30012, ItemVersion.DataDriven),
+                component("test:late", 30013, ItemVersion.None, components),
+                component("TEST:UPPER", 30014, ItemVersion.DataDriven, components)});
+        assertEquals(1, registry.stackingProperties().get("test:item").maximum());
+        assertEquals(ComponentItemStackingProperties.DEFAULT, registry.stackingProperties().get("test:late"));
+        assertEquals(ComponentItemStackingProperties.DEFAULT, registry.stackingProperties().get("test:upper"));
+        assertNull(registry.definition("TEST:UPPER"));
+        assertNotNull(registry.lookup("TEST:UPPER", 0).definition());
+    }
+
+    @Test
+    void legacyAndComponentReadersUseTheConstructedReceiversLayout() {
+        final var legacy = new CompoundTag();
+        legacy.putInt("minecraft:max_stack_size", 32);
+        legacy.putByte("minecraft:stacked_by_data", (byte) 1);
+        legacy.putInt("minecraft:max_damage", 20);
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 16);
+        final var component = new CompoundTag();
+        component.put("item_properties", properties);
+        component.put("minecraft:durability", new CompoundTag());
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                component("test:legacy", 30011, ItemVersion.Legacy, legacy),
+                component("test:legacy", 30012, ItemVersion.DataDriven, component),
+                component("test:component", 30013, ItemVersion.DataDriven, component),
+                component("test:component", -1, ItemVersion.None, legacy)});
+        assertEquals(new LegacyItemStackingProperties(32, true, (short) 20), registry.stackingProperties().get("test:legacy"));
+        assertEquals(new ComponentItemStackingProperties(16, null, false, true), registry.stackingProperties().get("test:component"));
+    }
+
+    @Test
+    void lateBlockProducerPreservesExplicitDefinitionsAndRegistersItemPrefixedBlocks() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                entry("minecraft:birch_standing_sign", 30011, ItemVersion.DataDriven),
+                entry("minecraft:polished_basalt", 30012, ItemVersion.Legacy),
+                entry("minecraft:nether_gold_ore", 30013, ItemVersion.None)});
+        assertTrue(registry.componentItems().contains("minecraft:birch_standing_sign"));
+        assertNotNull(registry.definition("minecraft:item.birch_standing_sign"));
+        assertNotNull(registry.definition("minecraft:item.polished_basalt"));
+        assertFalse(registry.componentItems().contains("minecraft:nether_gold_ore"));
+        assertEquals(LegacyItemStackingProperties.DEFAULT, registry.stackingProperties().get("minecraft:polished_basalt"));
+    }
+
+    @Test
+    void bookCustomNamesFollowClassIdentityAndRemainAvailableAfterIdCollision() {
+        final var data = new CompoundTag();
+        data.putString("title", "Title");
+        final String book = "minecraft:written_book";
+        final var nativeBook = new ItemRegistry(new ItemEntry[]{
+                entry(book, 30011, ItemVersion.Legacy), entry("test:replacement", 30011, ItemVersion.Legacy)});
+        assertEquals("Title", nativeBook.customName(book, data));
+        final var componentBook = new ItemRegistry(new ItemEntry[]{entry(book, 30011, ItemVersion.DataDriven)});
+        assertNull(componentBook.customName(book, data));
+        final var display = new CompoundTag();
+        display.putInt("Name", 7);
+        data.put("display", display);
+        assertEquals("", componentBook.customName(book, data));
+        display.putString("Name", "Named");
+        assertEquals("Named", nativeBook.customName(book, data));
+    }
+
+    @Test
+    void compiledCategoryUpdatesRetainOmittedFieldsAndUseTheNumericOwnersSharedState() {
+        final var properties = new CompoundTag();
+        properties.putInt("creative_category", 259);
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                component("test:category", 30011, ItemVersion.DataDriven, components),
+                component("test:category", -1, ItemVersion.None, new CompoundTag())});
+        assertEquals(3, registry.creativeCategory(30011));
+        assertTrue(registry.assignCreativeCategory(30011, 260));
+        assertEquals(4, registry.creativeCategory(30011 + 65536));
+        assertFalse(registry.assignCreativeCategory(0, 1));
+        assertFalse(registry.assignCreativeCategory(-1, 1));
+        assertFalse(new ItemRegistry(new ItemEntry[0]).ids().containsKey("test:category"));
+    }
+
+    @Test
+    void rawPacketDataRetainsItsOwnImmutableSnapshotAndWireRepresentation() {
+        final var components = new CompoundTag();
+        components.putLong("opaque", Long.MIN_VALUE);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var declaration = new ItemEntry("test:item", 30011, true, ItemVersion.DataDriven, data);
+        final ItemEntry[] input = {declaration};
+        final var registry = new ItemRegistry(input);
+        input[0] = entry("test:other", 30012, ItemVersion.Legacy);
+        data.clear();
+        registry.registrations().getFirst().componentData().clear();
+        assertEquals(declaration, registry.registrations().getFirst());
+        assertThrows(UnsupportedOperationException.class, () -> registry.registrations().clear());
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.ITEM_ENTRY.write(buffer, registry.registrations().getFirst());
+            assertEquals(declaration, BedrockTypes.ITEM_ENTRY.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void storageComponentsUseTheCapturedTypedFieldsWithoutInventingMissingCapacity() {
+        final var components = new CompoundTag();
+        components.put("minecraft:storage_item", new CompoundTag());
+        final var modifier = new CompoundTag();
+        modifier.putInt("weight_in_storage_item", 4);
+        components.put("minecraft:storage_weight_modifier", modifier);
+        final var limit = new CompoundTag();
+        limit.putInt("max_weight_limit", 64);
+        components.put("minecraft:storage_weight_limit", limit);
+        final var registry = new ItemRegistry(new ItemEntry[]{component("test:bundle", 30011, ItemVersion.DataDriven, components)});
+        assertEquals(new ItemStorageProperties(true, 4, 64), registry.storageProperties(new BedrockItem(30011)));
+        limit.putString("max_weight_limit", "64");
+        final var unavailable = new ItemRegistry(new ItemEntry[]{component("test:bundle", 30011, ItemVersion.DataDriven, components)});
+        assertTrue(unavailable.storageProperties(new BedrockItem(30011)).storage());
+        assertFalse(unavailable.storageProperties(new BedrockItem(30011)).complete());
+        assertFalse(registry.storageProperties(new BedrockItem(0)).storage());
+    }
+
+    private static ItemEntry component(final String name, final int id, final ItemVersion version, final CompoundTag components) {
+        final var data = new CompoundTag();
+        data.put("components", components);
+        return new ItemEntry(name, id, true, version, data);
+    }
+
+    private static ItemEntry entry(final String name, final int id, final ItemVersion version) {
+        return new ItemEntry(name, id, false, version, null);
+    }
+
+}
