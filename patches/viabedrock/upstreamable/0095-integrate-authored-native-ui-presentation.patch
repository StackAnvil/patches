+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+/** Compiled Item flags and persistent components have separate update lifetimes. */
+public record ComponentItemStackingProperties(int compiledMaximum, Integer componentMaximum,
+                                             boolean stackedByData, boolean damageable) implements ItemStackingProperties {
+
+    static final ComponentItemStackingProperties DEFAULT = new ComponentItemStackingProperties(64, null, false, false);
+
+    @Override
+    public ComponentItemStackingProperties withComponentData(final CompoundTag components) {
+        int compiledMaximum = this.compiledMaximum;
+        boolean stackedByData = this.stackedByData;
+        if (components.get("item_properties") instanceof CompoundTag properties) {
+            compiledMaximum = properties.get("max_stack_size") instanceof IntTag size ? size.asInt() & 0xFF : 0;
+            stackedByData = properties.get("stacked_by_data") instanceof ByteTag flag && flag.asByte() != 0;
+        }
+        Integer componentMaximum = this.componentMaximum;
+        if (components.get("minecraft:max_stack_size") instanceof CompoundTag size) {
+            componentMaximum = size.get("value") instanceof ByteTag value ? Byte.toUnsignedInt(value.asByte()) : 1;
+        }
+        // Once installed, omitted or mistyped component updates do not remove durability.
+        final boolean damageable = this.damageable || components.get("minecraft:durability") instanceof CompoundTag;
+        return new ComponentItemStackingProperties(compiledMaximum, componentMaximum, stackedByData, damageable);
+    }
+
+    @Override
+    public int maximum() {
+        return this.componentMaximum != null ? this.componentMaximum : this.compiledMaximum;
+    }
+
+}
