+            for (final var value : reference.getAsJsonArray("lookupRows")) {
+                final var row = value.getAsJsonObject();
+                final String name = row.get("name").getAsString();
+                assertEquals(row.get("hasComplexAlias").getAsBoolean(), registry.hasComplexAlias(name), name);
+                assertEquals(row.getAsJsonArray("members").asList().stream().map(member -> member.getAsString()).toList(),
