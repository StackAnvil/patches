+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Compiled native block-definition keys, before localization or item-specific dispatch. */
+public final class BuiltinBlockNames {
+
+    private static final Map<String, String> NAMES = load();
+
+    private BuiltinBlockNames() { }
+
+    /** Null leaves asset-defined and custom block names unresolved. An empty native key stays empty. */
+    public static String get(final String identifier) {
+        return NAMES.get(identifier);
+    }
+
+    private static Map<String, String> load() {
+        try (var stream = BuiltinBlockNames.class.getResourceAsStream("/assets/viabedrock/data/bedrock/block_name_keys.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native block name keys");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native block names do not match the target protocol");
+            }
+            final Map<String, String> names = new HashMap<>();
+            data.getAsJsonObject("names").entrySet().forEach(entry -> names.put(entry.getKey(), entry.getValue().getAsString()));
+            return Map.copyOf(names);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native block name keys", error);
+        }
+    }
+
+}
