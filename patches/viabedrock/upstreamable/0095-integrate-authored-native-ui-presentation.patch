+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+/** Stacking state belongs to the constructed native Item factory. */
+public sealed interface ItemStackingProperties permits ComponentItemStackingProperties, LegacyItemStackingProperties {
+
+    ItemStackingProperties withComponentData(CompoundTag components);
+
+    int maximum();
+
+    boolean stackedByData();
+
+    boolean damageable();
+
+    default boolean stackable(final BedrockItem item) {
+        if (this.maximum() < 2) {
+            return false;
+        }
+        if (!this.damageable() || item.tag() == null) {
+            return true;
+        }
+        if (item.tag().get("Unbreakable") instanceof ByteTag flag && flag.asByte() != 0) {
+            return true;
+        }
+        return !(item.tag().get("Damage") instanceof IntTag damage) || damage.asShort() <= 0;
+    }
+
+}
