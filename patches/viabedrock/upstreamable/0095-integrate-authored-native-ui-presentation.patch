+    static void sendNativeContainerPresentation(final PacketWrapper wrapper, final ContainerUi.Kind kind, final ContainerUi.Title title) {
+        final var channels = wrapper.user().get(ChannelStorage.class);
+        final boolean families = channels.hasChannel(NativeContainerMessage.FAMILIES_CHANNEL);
+        if (kind == null || kind == ContainerUi.Kind.BREWING_STAND || !kind.legacy() && !families) {
+            return;
+        }
+        final boolean nativeActions = channels.hasChannel(NativeContainerMessage.CURRENT_CHANNEL)
+                && channels.hasChannel(net.raphimc.viabedrock.api.model.NativeContainerStatus.CHANNEL)
+                && !wrapper.user().get(GameSessionStorage.class).isInventoryServerAuthoritative()
+                && NativeStorageContainers.matches(wrapper.user().get(InventoryTracker.class).getCurrentContainer(), kind);
+        if (!nativeActions && !families && !channels.hasChannel(NativeContainerMessage.CHANNEL)) {
+            return;
+        }
+        final var resources = wrapper.user().get(ResourcePackStorage.class);
+        if (!resources.isLoadedOnJavaClient()) {
+            return;
+        }
+        final var state = wrapper.user().get(NativeContainerUiState.class);
+        final var ui = resources.getContainerUi();
+        final var message = nativeActions ? state.prepareActions(wrapper.get(Types.VAR_INT, 0), kind, title, ui,
+                value -> net.raphimc.viabedrock.api.model.container.NativeContainerLegacyActions.create(wrapper.user(), value))
+                : state.prepare(wrapper.get(Types.VAR_INT, 0), kind, title, ui, List.of());
+        if (message == null) {
+            return;
+        }
+        wrapper.send(BedrockProtocol.class);
+        wrapper.cancel();
+        final PacketWrapper presentation = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, wrapper.user());
+        presentation.write(Types.STRING, families ? NativeContainerMessage.FAMILIES_CHANNEL
+                : nativeActions ? NativeContainerMessage.CURRENT_CHANNEL : NativeContainerMessage.CHANNEL);
+        presentation.write(families ? NativeContainerMessage.FAMILIES_TYPE
+                : nativeActions ? NativeContainerMessage.CURRENT_TYPE : NativeContainerMessage.TYPE, message);
+        presentation.send(BedrockProtocol.class);
+    }
