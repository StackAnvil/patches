+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Original potion registration fields, with the effect registry's world-version gates. */
+final class BuiltinPotionNames {
+
+    private static final List<Definition> DEFINITIONS = load();
+
+    static Definition get(final Short auxiliaryData, final BaseGameVersion baseGameVersion) {
+        final int auxiliary = auxiliaryData == null ? Short.MAX_VALUE : Short.toUnsignedInt(auxiliaryData);
+        final Definition definition = auxiliary < DEFINITIONS.size() ? DEFINITIONS.get(auxiliary) : DEFINITIONS.getFirst();
+        return definition.minimumVersion() != null && baseGameVersion.isLowerThan(definition.minimumVersion())
+                ? DEFINITIONS.getFirst() : definition;
+    }
+
+    private static List<Definition> load() {
+        try (var stream = BuiltinPotionNames.class.getResourceAsStream("/assets/viabedrock/data/bedrock/potion_names.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native potion names");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native potion names do not match the target protocol");
+            }
+            final List<Definition> definitions = new ArrayList<>();
+            for (final var value : data.getAsJsonArray("entries")) {
+                final var definition = value.getAsJsonObject();
+                final BaseGameVersion minimumVersion = definition.has("minimumVersion")
+                        ? BaseGameVersion.parse(definition.get("minimumVersion").getAsString()) : null;
+                if (minimumVersion != null && !minimumVersion.valid()) {
+                    throw new IllegalStateException("Invalid native potion version gate");
+                }
+                definitions.add(new Definition(definition.get("description").getAsString(),
+                        definition.has("effect") ? definition.get("effect").getAsString() : null, minimumVersion));
+            }
+            if (definitions.isEmpty()) {
+                throw new IllegalStateException("Native potion registration has no default entry");
+            }
+            return List.copyOf(definitions);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native potion names", error);
+        }
+    }
+
+    private BuiltinPotionNames() { }
+
+    record Definition(String description, String effect, BaseGameVersion minimumVersion) { }
+
+}
