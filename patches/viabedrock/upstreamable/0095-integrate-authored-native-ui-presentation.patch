+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.io.TagRegistry;
+import com.viaversion.nbt.tag.*;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.chunk.blockstate.BlockRegistryNames;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.api.model.NativeItemStacking;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.ArrayList;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeItemStackMatcherTest {
+
+    @Test
+    void queriesIgnoreRootQuantityAndNetworkIdButRetainNativeItemState() {
+        final Object block = new Object();
+        final var blocks = Map.of(0, block, 1, new Object());
+        final var registry = new BlockRegistryNames(List.of("minecraft:stone", "minecraft:dirt"));
+        final var query = new BedrockItem(321, (short) 3, (byte) 1);
+        final var result = new BedrockItem(321, Short.MAX_VALUE, (byte) 64);
+        result.setNetId(55);
+        result.setBlockRuntimeId(0);
+        assertTrue(NativeItemStackMatcher.matches(query, result, blocks::get, registry::restrictionBlocks));
+        assertFalse(NativeItemStackMatcher.matches(result, query, blocks::get, registry::restrictionBlocks));
+        query.setBlockRuntimeId(0);
+        query.setCanPlace(new String[]{"stone", "dirt", "stone", "missing"});
+        result.setCanPlace(new String[]{"minecraft:dirt", "minecraft:stone"});
+        assertTrue(NativeItemStackMatcher.matches(query, result, blocks::get, registry::restrictionBlocks));
+        result.setBlockRuntimeId(1);
+        assertFalse(NativeItemStackMatcher.matches(query, result, blocks::get, registry::restrictionBlocks));
+        result.setBlockRuntimeId(0);
+        result.setCanBreak(new String[]{"stone"});
+        assertFalse(NativeItemStackMatcher.matches(query, result, blocks::get, registry::restrictionBlocks));
+        result.setCanBreak(new String[0]);
+        result.setBlockingTicks(1);
+        assertFalse(NativeItemStackMatcher.matches(query, result, blocks::get, registry::restrictionBlocks));
+    }
+
+    @Test
+    void userdataPreservesNativeFloatingAndTypedListEqualityWithoutReferenceShortcuts() {
+        final var first = new CompoundTag();
+        final var second = new CompoundTag();
+        assertTrue(NativeItemStacking.userDataEqual(null, first));
+        first.putFloat("value", 0F);
+        second.putFloat("value", -0F);
+        assertTrue(NativeItemStacking.userDataEqual(first, second));
+        first.putFloat("value", Float.NaN);
+        assertFalse(NativeItemStacking.userDataEqual(first, first));
+        first.put("value", new ListTag<>(IntTag.class));
+        second.put("value", new ListTag<>(FloatTag.class));
+        assertFalse(NativeItemStacking.userDataEqual(first, second));
+        second.put("value", new ListTag<>(IntTag.class));
+        assertTrue(NativeItemStacking.userDataEqual(first, second));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ITEM_TAG_EQUALITY", matches = ".+")
+    void tagEqualityMatchesOriginalNativeVirtualComparatorsForValidUtf8() throws Exception {
+        final var rows = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_ITEM_TAG_EQUALITY")))).getAsJsonArray();
+        int compared = 0;
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            try {
+                final Tag first = tag(row.getAsJsonArray("left"));
+                final Tag second = row.get("sameReference").getAsBoolean() ? first : tag(row.getAsJsonArray("right"));
+                assertEquals(row.get("result").getAsBoolean(), NativeItemStacking.tagsEqual(first, second), row::toString);
+                compared++;
+            } catch (final CharacterCodingException ignored) {
+                // Java's decoded strings cannot retain malformed native UTF-8 bytes.
+            }
+        }
+        assertTrue(compared > 3000);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_OUTPUT_DATA", matches = ".+")
+    void networkUserdataAndDerivedChargedChildrenMatchTheOriginalOutputMatcher() throws Exception {
+        final var rows = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_OUTPUT_DATA")))).getAsJsonObject().getAsJsonArray("rows");
+        assertFalse(rows.isEmpty());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var query = new BedrockItem(585);
+            final var result = new BedrockItem(585);
+            query.setTag(row.get("left").isJsonNull() ? null : (CompoundTag) tag(row.getAsJsonArray("left")));
+            result.setTag(row.get("right").isJsonNull() ? null : (CompoundTag) tag(row.getAsJsonArray("right")));
+            assertEquals(row.get("result").getAsBoolean(), NativeItemStackMatcher.matches(
+                    query, result, ignored -> null, ignored -> Set.of()), row::toString);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_INPUTS", matches = ".+")
+    void outputAdmissionMatchesTheWholeNativeAlternativeExtractor() throws Exception {
+        final var rows = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COOKING_INPUTS")))).getAsJsonObject().getAsJsonArray("outputRows");
+        assertFalse(rows.isEmpty());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var query = new BedrockItem(row.get("queryId").getAsInt(),
+                    row.get("queryAuxiliary").getAsShort(), row.get("queryCount").getAsByte());
+            final List<Integer> actual = new ArrayList<>();
+            if (NativeItemStackMatcher.matches(query,
+                    new BedrockItem(100, row.get("resultAuxiliary").getAsShort(), (byte) 1), ignored -> null, ignored -> Set.of())) {
+                actual.addAll(List.of(1, 2));
+            }
+            if (NativeItemStackMatcher.matches(query, new BedrockItem(321), ignored -> null, ignored -> Set.of())) {
+                actual.add(-303);
+            }
+            assertEquals(row.getAsJsonArray("expanded").asList().stream()
+                    .map(value -> value.getAsJsonObject().get("identifier").getAsInt()).toList(), actual, row::toString);
+        }
+    }
+
+    private static String string(final String hex) throws CharacterCodingException {
+        return StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(HexFormat.of().parseHex(hex))).toString();
+    }
+
+    private static Tag tag(final JsonArray spec) throws CharacterCodingException {
+        final int kind = spec.get(0).getAsInt();
+        final var value = spec.get(1);
+        if (kind == 9) {
+            final var list = value.getAsJsonArray();
+            final int type = list.get(0).getAsInt();
+            @SuppressWarnings("unchecked")
+            final var result = new ListTag<>((Class<Tag>) (type == 0 ? null : TagRegistry.getClassFor(type)));
+            for (final var entry : list.get(1).getAsJsonArray()) {
+                result.add(tag(entry.getAsJsonArray()));
+            }
+            return result;
+        } else if (kind == 10) {
+            final var result = new CompoundTag();
+            for (final var entry : value.getAsJsonObject().entrySet()) {
+                result.put(string(entry.getKey()), tag(entry.getValue().getAsJsonArray()));
+            }
+            return result;
+        }
+        final byte[] bytes = HexFormat.of().parseHex(value.getAsString());
+        final var buffer = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        return switch (kind) {
+            case 1 -> new ByteTag(buffer.get());
+            case 2 -> new ShortTag(buffer.getShort());
+            case 3 -> new IntTag(buffer.getInt());
+            case 4 -> new LongTag(buffer.getLong());
+            case 5 -> new FloatTag(buffer.getFloat());
+            case 6 -> new DoubleTag(buffer.getDouble());
+            case 7 -> new ByteArrayTag(bytes);
+            case 8 -> new StringTag(string(value.getAsString()));
+            case 11 -> {
+                final int[] values = new int[bytes.length / Integer.BYTES];
+                buffer.asIntBuffer().get(values);
+                yield new IntArrayTag(values);
+            }
+            default -> throw new IllegalArgumentException("Unsupported native tag fixture type");
+        };
+    }
+
+}
