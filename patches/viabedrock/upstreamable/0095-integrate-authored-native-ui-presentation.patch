+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.ByteTag;
+import java.util.function.BiPredicate;
+import java.util.function.IntPredicate;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+
+/** The ordinary container_items count-one action, independent of inventory authority. */
+public final class NativeContainerTransfer {
+
+    public static Plan plan(final BedrockItem source, final BedrockItem[] inventory,
+                            final int maximumStackSize, final BiPredicate<BedrockItem, BedrockItem> canMerge,
+                            final IntPredicate destinationAllowed) {
+        if (inventory.length != 36 || maximumStackSize < 1 || maximumStackSize > 255) {
+            throw new IllegalArgumentException("Unsupported native inventory provider");
+        }
+        if (source.isEmpty()) {
+            return null;
+        }
+        requireUnlocked(source);
+        // Native combined provider order is hotbar 0..8, then inventory 9..35.
+        for (final boolean merge : new boolean[] {true, false}) {
+            for (int slot = 0; slot < inventory.length; slot++) {
+                final BedrockItem destination = inventory[slot];
+                if (!destinationAllowed.test(slot)) {
+                    continue;
+                }
+                if (merge ? destination.isEmpty() || !canMerge.test(source, destination)
+                        || destination.amount() >= maximumStackSize : !destination.isEmpty()) {
+                    continue;
+                }
+                requireUnlocked(destination);
+                return new Plan(slot, source.copy(), destination.copy());
+            }
+        }
+        return null;
+    }
+
+    private static void requireUnlocked(final BedrockItem item) {
+        if (item.tag() != null && item.tag().get("minecraft:item_lock") instanceof ByteTag value
+                && value.asByte() != 0) {
+            throw new IllegalArgumentException("Native locked-item transfer permission is not supported");
+        }
+    }
+
+    private NativeContainerTransfer() { }
+
+    public record Plan(int destinationSlot, BedrockItem sourceBefore, BedrockItem destinationBefore) {
+
+        public BedrockItem sourceAfter() {
+            if (this.sourceBefore.amount() == 1) {
+                return BedrockItem.empty();
+            }
+            final BedrockItem result = this.sourceBefore.copy();
+            result.setAmount(result.amount() - 1);
+            return result;
+        }
+
+        public BedrockItem destinationAfter() {
+            final BedrockItem result = this.destinationBefore.isEmpty()
+                    ? this.sourceBefore.copy() : this.destinationBefore.copy();
+            result.setAmount(this.destinationBefore.amount() + 1);
+            return result;
+        }
+
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/container/NativeItemStackMatcher.java b/src/main/java/net/raphimc/viabedrock/api/model/container/NativeItemStackMatcher.java
