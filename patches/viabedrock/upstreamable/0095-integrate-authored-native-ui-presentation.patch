+    private static ContainerTitle containerTitle(final UserConnection user, final ContainerType type, final Entity actor,
+                                                final BedrockBlockEntity blockEntity, final TextComponent fallback) {
+        if (type == ContainerType.CONTAINER && actor != null) {
+            final String filtered = actorTitle(actor, ActorDataIds.FILTERED_NAME);
+            final String name = filtered.isEmpty() ? actorTitle(actor, ActorDataIds.NAME) : filtered;
+            if (!name.isEmpty()) {
+                return new ContainerTitle(TextUtil.stringToTextComponent(user.get(ResourcePackStorage.class).getTexts().translate(name)), name, true);
+            }
+        }
+        if (blockEntity != null && blockEntity.tag().get("CustomName") instanceof StringTag customName) {
+            final String raw = customName.getValue();
+            return new ContainerTitle(TextUtil.stringToTextComponent(user.get(ResourcePackStorage.class).getTexts().translate(raw)), raw, false);
+        }
+        return new ContainerTitle(fallback, null, false);
+    }
+
+    private static String actorTitle(final Entity actor, final ActorDataIds field) {
+        final var data = actor.entityData().get(field);
+        return data != null && data.dataType() == EntityDataTypesBedrock.STRING && data.value() instanceof String value ? value : "";
+    }
+
+    static void sendNativeContainerPresentation(final PacketWrapper wrapper, final int javaMenuId, final ContainerUi.Title title) {
+        if (!wrapper.user().get(ChannelStorage.class).hasChannel(NativeContainerMessage.CHANNEL)) {
+            return;
+        }
+        final ContainerUi.Kind kind = javaMenuId == BedrockProtocol.MAPPINGS.getJavaMenuId("minecraft:generic_9x3")
+                ? ContainerUi.Kind.CHEST_3_ROWS : javaMenuId == BedrockProtocol.MAPPINGS.getJavaMenuId("minecraft:generic_9x6")
+                ? ContainerUi.Kind.CHEST_6_ROWS : null;
+        final var message = wrapper.user().get(NativeContainerUiState.class).prepare(
+                wrapper.get(Types.VAR_INT, 0), kind, title, wrapper.user().get(ResourcePackStorage.class).getContainerUi());
+        if (message == null) {
+            return;
+        }
+        wrapper.send(BedrockProtocol.class);
+        wrapper.cancel();
+        final PacketWrapper presentation = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, wrapper.user());
+        presentation.write(Types.STRING, NativeContainerMessage.CHANNEL);
+        presentation.write(NativeContainerMessage.TYPE, message);
+        presentation.send(BedrockProtocol.class);
+    }
