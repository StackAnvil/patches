+        tag.putInt("modifier", this.modifier);
+        tag.putInt("weight", this.weight);
+        tag.putInt("capacity", this.capacity);
+        return tag;
+    }
+
+    public static NativeItemStorageData fromTag(final CompoundTag tag) {
+        return tag != null && tag.get("version") instanceof IntTag version && version.asInt() == VERSION
+                && tag.get("modifier") instanceof IntTag modifier && tag.get("weight") instanceof IntTag weight
+                && tag.get("capacity") instanceof IntTag capacity
+                ? new NativeItemStorageData(modifier.asInt(), weight.asInt(), capacity.asInt()) : null;
+    }
+
+    public static NativeItemStorageData resolve(final BedrockItem item, final Source source) {
+        final var work = new Work();
+        return resolve(item, source, work, 0, new HashSet<>());
+    }
+
+    private static NativeItemStorageData resolve(final BedrockItem item, final Source source, final Work work,
+                                                final int depth, final Set<Integer> path) {
+        if (++work.items > MAX_ITEMS || depth > MAX_DEPTH) {
+            work.incomplete = true;
+            return null;
+        }
+        final ItemStorageProperties properties = source.properties(item);
+        if (item.isEmpty() || properties == null || !properties.complete()) {
+            return null;
+        }
+        final CompoundTag tag = item.tag();
+        if (tag != null && tag.get("bundle_weight") instanceof IntTag cached && cached.asInt() != 0) {
+            return new NativeItemStorageData(properties.modifier(), cached.asInt() - properties.modifier(), properties.capacity());
+        }
+        if (tag == null || !(tag.get("bundle_id") instanceof IntTag id)) {
+            return new NativeItemStorageData(properties.modifier(), 0, properties.capacity());
+        }
+        final int identity = id.asInt();
+        if (!path.add(identity)) {
+            work.incomplete = true;
+            return null;
+        }
+        try {
+            final BedrockItem[] contents = source.contents(identity);
+            if (contents == null) {
+                return null;
+            }
+            int weight = 0;
+            for (final BedrockItem child : contents) {
+                if (child.isEmpty()) {
+                    continue;
+                }
+                final var nested = resolve(child, source, work, depth + 1, path);
+                if (work.incomplete) {
+                    return null;
+                }
+                if (nested != null) {
+                    // The native producer adds one storage weight, independently of its count byte.
+                    weight += nested.modifier + nested.weight;
+                } else {
+                    final int maximum = source.maximum(child);
+                    if (maximum <= 0 || maximum > 255) {
+                        work.incomplete = true;
+                        return null;
+                    }
+                    weight += child.amount() * (64 / maximum);
+                }
+            }
+            return new NativeItemStorageData(properties.modifier(), weight, properties.capacity());
+        } finally {
+            path.remove(identity);
+        }
+    }
+
+    public interface Source {
+        ItemStorageProperties properties(BedrockItem item);
+
+        BedrockItem[] contents(int identity);
+
+        int maximum(BedrockItem item);
+    }
+
+    private static final class Work {
+        private int items;
+        private boolean incomplete;
+    }
+
+}
