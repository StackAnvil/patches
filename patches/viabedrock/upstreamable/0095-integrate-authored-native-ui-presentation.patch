+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.chunk.blockstate.BlockRegistryNames;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Function;
+
+/** The pinned constructor context, with staged factories and subsequent native block registration. */
+final class BuiltinItemRegistry {
+
+    private static final Data DATA = load();
+    private static final BlockRegistryNames BLOCK_NAMES = new BlockRegistryNames(
+            DATA.blocks().stream().map(Block::identifier).collect(java.util.stream.Collectors.toUnmodifiableSet()));
+
+    static NativeItemDefinitions<ItemDefinitionProperties> create(final List<ItemEntry> entries,
+                                                                 final Function<String, String> resolveBlock) {
+        final var initial = DATA.initial().stream().map(BuiltinItemRegistry::seed).toList();
+        final var staged = DATA.staged().stream().map(BuiltinItemRegistry::seed).toList();
+        return new NativeItemDefinitions<>(new NativeItemDefinitions.Bootstrap<>(DATA.counter(), initial, staged), entries,
+                new NativeItemDefinitions.Factory<>() {
+                    @Override
+                    public NativeItemDefinitions.Seed<ItemDefinitionProperties> construct(final ItemVersion version,
+                                                                                        final String rawName, final short identifier) {
+                        final NativeItemName parsed = NativeItemName.parse(rawName, 0);
+                        final String name = parsed == null ? ":" : parsed.identifier();
+                        final var kind = version == ItemVersion.DataDriven
+                                ? ItemDefinitionProperties.Kind.COMPONENT : ItemDefinitionProperties.Kind.LEGACY;
+                        return new NativeItemDefinitions.Seed<>(name, name, identifier,
+                                new ItemDefinitionProperties(name, kind, null, null, false));
+                    }
+
+                    @Override
+                    public void readComponents(final NativeItemDefinitions.Definition<ItemDefinitionProperties> definition,
+                                               final CompoundTag components) {
+                        definition.receiver().read(components, resolveBlock);
+                    }
+
+                    @Override
+                    public void complete(final NativeItemDefinitions<ItemDefinitionProperties>.Builder builder) {
+                        for (final Block block : DATA.blocks()) {
+                            if (block.identifier().equals("minecraft:air") || builder.numeric(block.id()) != null) {
+                                continue;
+                            }
+                            String name = block.identifier();
+                            final var existing = builder.lookup(name, 0).definition();
+                            if (existing != null) {
+                                if (existing.receiver().component() && existing.receiver().blockPlacer().replacementBlockItem()) {
+                                    continue;
+                                }
+                                if (block.separateItem()) {
+                                    builder.bindNumeric(block.id(), existing);
+                                    continue;
+                                }
+                                final int separator = name.indexOf(':');
+                                name = name.substring(0, separator + 1) + "item." + name.substring(separator + 1);
+                            }
+                            if (builder.lookup(name, 0).definition() != null) {
+                                continue;
+                            }
+                            final var kind = block.slab() ? ItemDefinitionProperties.Kind.SLAB
+                                    : block.separateItem() ? ItemDefinitionProperties.Kind.DOOR : ItemDefinitionProperties.Kind.BLOCK;
+                            builder.construct(new NativeItemDefinitions.Seed<>(name, name, block.id(),
+                                    new ItemDefinitionProperties(name, kind, null, block.identifier(), false)), name);
+                        }
+                    }
+                }, BuiltinItemAliases::rewrite);
+    }
+
+    static String resolveBlock(final String name) {
+        return BLOCK_NAMES.resolve(name);
+    }
+
+    private static NativeItemDefinitions.Seed<ItemDefinitionProperties> seed(final Registration registration) {
+        final var builtin = Objects.requireNonNull(BuiltinItemFactories.get(registration.identifier()),
+                "Missing constructor properties for " + registration.identifier());
+        return new NativeItemDefinitions.Seed<>(registration.key(), registration.identifier(), registration.id(),
+                new ItemDefinitionProperties(registration.identifier(), ItemDefinitionProperties.Kind.BUILTIN, builtin,
+                        null, DATA.replacements().contains(registration.identifier())));
+    }
+
+    private static Data load() {
+        final String path = "/assets/viabedrock/data/bedrock/item_registry.json";
+        try (var stream = BuiltinItemRegistry.class.getResourceAsStream(path)) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native item registry construction data");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native item registry does not match the target protocol");
+            }
+            final List<Block> blocks = new ArrayList<>();
+            final Set<String> names = new HashSet<>();
+            for (final var value : data.getAsJsonArray("blocks")) {
+                final JsonObject block = value.getAsJsonObject();
+                final String name = block.get("identifier").getAsString();
+                if (!names.add(name)) {
+                    throw new IllegalStateException("Duplicate native block factory: " + name);
+                }
+                blocks.add(new Block(name, block.get("id").getAsInt(), block.get("separateItem").getAsBoolean(), block.get("slab").getAsBoolean()));
+            }
+            final Set<String> replacements = new HashSet<>();
+            data.getAsJsonArray("replacementBlockItems").forEach(value -> replacements.add(value.getAsString()));
+            return new Data(data.get("counter").getAsInt(), registrations(data.getAsJsonArray("initial")),
+                    registrations(data.getAsJsonArray("staged")), List.copyOf(blocks), Set.copyOf(replacements));
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native item registry construction data", error);
+        }
+    }
+
+    private static List<Registration> registrations(final JsonArray values) {
+        final List<Registration> result = new ArrayList<>();
+        for (final var value : values) {
+            final var registration = value.getAsJsonObject();
+            final String name = registration.get("identifier").getAsString();
+            result.add(new Registration(registration.has("key") ? registration.get("key").getAsString() : name,
+                    name, registration.get("id").getAsInt()));
+        }
+        return List.copyOf(result);
+    }
+
+    private BuiltinItemRegistry() { }
+
+    private record Registration(String key, String identifier, int id) { }
+
+    private record Block(String identifier, int id, boolean separateItem, boolean slab) { }
+
+    private record Data(int counter, List<Registration> initial, List<Registration> staged,
+                        List<Block> blocks, Set<String> replacements) { }
+
+}
