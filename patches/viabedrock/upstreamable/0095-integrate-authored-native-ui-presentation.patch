+
+    @Test
+    void completeNetworkDefinitionsRemainStableAcrossInputAndConsumerMutation() {
+        final var flags = new CompoundTag();
+        flags.put("replaceBlockItem", new ByteTag((byte) 255));
+        final var opaqueValues = new ListTag<>(LongTag.class);
+        opaqueValues.add(new LongTag(Long.MIN_VALUE));
+        flags.put("opaque", opaqueValues);
+        final var components = new CompoundTag();
+        components.put("minecraft:block_placer", flags);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var definition = new ItemEntry("test:item", 19, true, ItemVersion.DataDriven, data);
+        final var registry = new ItemRegistry(new ItemEntry[]{definition});
+        final var expected = data.copy();
+
+        flags.remove("replaceBlockItem");
+        opaqueValues.getValue().clear();
+        data.getValue().clear();
+        definition.componentData().getValue().clear();
+        registry.definition(19).componentData().getCompoundTag("components").getValue().clear();
+
+        assertEquals(expected, registry.definition(19).componentData());
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.ITEM_ENTRY.write(buffer, registry.definition(19));
+            final var decoded = BedrockTypes.ITEM_ENTRY.read(buffer);
+            assertEquals(definition, decoded);
+            assertEquals(0, buffer.readableBytes());
+            decoded.componentData().getValue().clear();
+            assertEquals(expected, decoded.componentData());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void missingDataAndUnknownIdsDoNotAcquireDefinitions() {
+        final var definition = entry("test:item", 32767, false, ItemVersion.None);
+        final var registry = new ItemRegistry(new ItemEntry[]{definition});
+        assertNull(registry.definition(32767).componentData());
+        assertNull(registry.definition(0));
+        assertNull(registry.definition("test:missing"));
+        assertTrue(new ItemRegistry(new ItemEntry[0]).entries().isEmpty());
+    }
+
+    @Test
+    void legacyReferencesPreserveExistingBuiltinFactoriesAndTheirComponentLayout() {
+        final String identifier = "minecraft:hopper";
+        final var flat = new CompoundTag();
+        flat.putInt("minecraft:max_stack_size", 32);
+        final var registry = new ItemRegistry(new ItemEntry[]{componentEntry(identifier, 20, ItemVersion.Legacy, flat)});
+        assertEquals(Set.of(identifier), registry.componentItems());
+        assertEquals(Map.of(identifier, ComponentItemStackingProperties.DEFAULT), registry.stackingProperties());
+    }
+
+    @Test
+    void advertisedItemsDoNotBecomeBuiltinFactoriesBeforeNetworkConstruction() {
+        for (final boolean flag : new boolean[]{false, true}) {
+            final var properties = new CompoundTag();
+            properties.putInt("max_stack_size", 1);
+            final var components = new CompoundTag();
+            components.put("item_properties", properties);
+            final var data = new CompoundTag();
+            data.put("components", components);
+            final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("minecraft:bundle", 20, flag, ItemVersion.None, data)});
+            assertEquals(flag ? Set.of("minecraft:bundle") : Set.of(), registry.componentItems());
+            assertEquals(flag ? ComponentItemStackingProperties.DEFAULT : LegacyItemStackingProperties.DEFAULT,
+                    registry.stackingProperties().get("minecraft:bundle"));
+        }
+        final var apple = new ItemRegistry(new ItemEntry[]{entry("minecraft:apple", 20, true, ItemVersion.None)});
+        assertTrue(apple.componentItems().isEmpty());
+    }
+
+    private static ItemEntry entry(final String identifier, final int id, final boolean componentBased, final ItemVersion version) {
+        return new ItemEntry(identifier, id, componentBased, version, null);
+    }
+
+}
