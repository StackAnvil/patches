+            final var table = row.has("translations") ? row.getAsJsonObject("translations") : fixture.getAsJsonObject("translations");
+            final var translations = new HashMap<String, String>();
+            table.entrySet().forEach(entry -> translations.put(entry.getKey(), entry.getValue().getAsString()));
