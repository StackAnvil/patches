+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import java.util.regex.Pattern;
+
+/** Native world-version parsing strips suffixes before comparing feature gates. */
+public record BaseGameVersion(int major, int minor, int patch, boolean valid, boolean wildcard) {
+
+    public static final BaseGameVersion INVALID = new BaseGameVersion(0, 0, 0, false, false);
+    private static final Pattern VERSION = Pattern.compile("^(0|[1-9]\\d{0,4})(\\.(0|[1-9]\\d{0,4})(\\.(0|[1-9]\\d{0,4})(?:\\-((?:(?:(?:(?:0[0-9]*[A-Za-z-])|[1-9A-Za-z-])[0-9A-Za-z-]*)|0)(?:\\.(?:(?:(?:(?:0[0-9]*[A-Za-z-])|[1-9A-Za-z-])[0-9A-Za-z-]*)|0))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)?)?");
+
+    public BaseGameVersion {
+        if (major < 0 || major > 0xFFFF || minor < 0 || minor > 0xFFFF || patch < 0 || patch > 0xFFFF) {
+            throw new IllegalArgumentException("Native version components must fit unsigned shorts");
+        }
+    }
+
+    public static BaseGameVersion parse(final String value) {
+        if (value.equals("*")) {
+            return new BaseGameVersion(0, 0, 0, true, true);
+        }
+        if (value.equals("beta")) {
+            return new BaseGameVersion(9999, 9999, 9999, true, false);
+        }
+        final var matcher = VERSION.matcher(value);
+        if (!matcher.matches()) {
+            return INVALID;
+        }
+        final int major = Integer.parseInt(matcher.group(1));
+        final int minor = matcher.group(3) == null ? 0 : Integer.parseInt(matcher.group(3));
+        final int patch = matcher.group(5) == null ? 0 : Integer.parseInt(matcher.group(5));
+        return major > 0xFFFF || minor > 0xFFFF || patch > 0xFFFF
+                ? INVALID : new BaseGameVersion(major, minor, patch, true, false);
+    }
+
+    public boolean isLowerThan(final BaseGameVersion other) {
+        if (this.wildcard) {
+            return false;
+        }
+        if (other.wildcard) {
+            return true;
+        }
+        if (this.major != other.major) {
+            return this.major < other.major;
+        }
+        return this.minor != other.minor ? this.minor < other.minor : this.patch < other.patch;
+    }
+
+}
