+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.DoubleTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.Tag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemStackingProperties;
+
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Function;
+
+/** Native occupied-slot merge eligibility, separate from transfer identity and capacity. */
+public final class NativeItemStacking {
+
+    public static boolean canMerge(final BedrockItem source, final BedrockItem destination,
+                                   final ItemStackingProperties properties,
+                                   final Function<BedrockItem, Short> auxiliary,
+                                   final Function<String[], Set<String>> restrictions) {
+        if (source == null || destination == null || source.isEmpty() || destination.isEmpty()
+                || source.identifier() != destination.identifier() || properties == null
+                || !properties.stackable(destination)) {
+            return false;
+        }
+        if (properties.stackedByData()) {
+            final Short sourceAuxiliary = auxiliary.apply(source);
+            final Short destinationAuxiliary = auxiliary.apply(destination);
+            if (sourceAuxiliary == null || !sourceAuxiliary.equals(destinationAuxiliary)) {
+                return false;
+            }
+        }
+        return userDataEqual(source.tag(), destination.tag())
+                && source.blockingTicks() == destination.blockingTicks()
+                && restrictions.apply(source.canPlace()).equals(restrictions.apply(destination.canPlace()))
+                && restrictions.apply(source.canBreak()).equals(restrictions.apply(destination.canBreak()));
+    }
+
+    public static boolean userDataEqual(final CompoundTag first, final CompoundTag second) {
+        if (first == null) {
+            return second == null || second.isEmpty();
+        }
+        return second == null ? first.isEmpty() : tagsEqual(first, second);
+    }
+
+    /** Native Tag equality uses numeric floating comparison and retains empty-list element types. */
+    public static boolean tagsEqual(final Tag first, final Tag second) {
+        if (first == null || second == null || first.getClass() != second.getClass()) {
+            return false;
+        }
+        return switch (first) {
+            case FloatTag value -> value.asFloat() == ((FloatTag) second).asFloat();
+            case DoubleTag value -> value.asDouble() == ((DoubleTag) second).asDouble();
+            case ListTag<?> values -> {
+                final var other = (ListTag<?>) second;
+                boolean equal = Objects.equals(values.getElementType(), other.getElementType()) && values.size() == other.size();
+                for (int index = 0; equal && index < values.size(); index++) {
+                    equal = tagsEqual(values.get(index), other.get(index));
+                }
+                yield equal;
+            }
+            case CompoundTag values -> {
+                final var other = (CompoundTag) second;
+                boolean equal = values.keySet().equals(other.keySet());
+                for (final String key : values.keySet()) {
+                    if (!equal || !tagsEqual(values.get(key), other.get(key))) {
+                        equal = false;
+                        break;
+                    }
+                }
+                yield equal;
+            }
+            default -> first.equals(second);
+        };
+    }
+
+    private NativeItemStacking() { }
+
+}
