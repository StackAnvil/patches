+        for (int index = 0; index < updates.size(); index++) {
+            final var registry = new ItemRegistry(updates.get(index));
+            final boolean nativeBook = index < 3;
+            final var data = new CompoundTag();
+            data.putString("title", "Title");
+            data.putString("filteredTitle", "Filtered");
+            assertEquals(nativeBook ? "Title" : null, registry.customName(book, data));
+            final var display = new CompoundTag();
+            display.putInt("Name", 7);
