+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemRegistryComponentNamesTest {
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COMPONENT_DESCRIPTIONS", matches = ".+")
+    void componentDescriptionsFollowActualNativeConstructionAndOrderedReaders() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_COMPONENT_DESCRIPTIONS")))).getAsJsonObject();
+        int compared = 0;
+        for (final var input : fixture.getAsJsonArray("sets")) {
+            final var set = input.getAsJsonObject();
+            final var entries = new ArrayList<ItemEntry>();
+            for (final var value : set.getAsJsonArray("registrations")) {
+                final var row = value.getAsJsonObject();
+                final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+                try {
+                    final var tag = (CompoundTag) BedrockTypes.TAG_LE.read(buffer);
+                    assertFalse(buffer.isReadable());
+                    entries.add(new ItemEntry(row.get("name").getAsString(), row.get("id").getAsInt(),
+                            row.get("componentBased").getAsBoolean(), ItemVersion.getByValue(row.get("version").getAsInt()), tag));
+                } finally {
+                    buffer.release();
+                }
+            }
+            final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+            for (final var value : set.getAsJsonArray("outputs")) {
+                final var row = value.getAsJsonObject();
+                final String expected = row.get("component").getAsBoolean() ? row.get("description").getAsString() : null;
+                assertEquals(expected, registry.componentDescription(row.get("identifier").getAsString()), row::toString);
+                compared++;
+            }
+        }
+        assertEquals(23, compared);
+    }
+
+    @Test
+    void componentNamesRemainBoundToTheirRegistrySnapshotAndRegisteredIdentity() {
+        final String identifier = "names:first";
+        final var name = new CompoundTag();
+        name.putString("value", "first.key");
+        final var components = new CompoundTag();
+        components.put("minecraft:display_name", name);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var entry = new ItemEntry(identifier, 20, true, ItemVersion.DataDriven, data);
+        final var registry = new ItemRegistry(new ItemEntry[]{entry});
+        final String selected = registry.componentDescription(identifier);
+        name.putString("value", "later.key");
+        final var next = new ItemRegistry(new ItemEntry[]{
+            new ItemEntry(identifier, 20, true, ItemVersion.DataDriven, data)});
+        assertNotEquals(selected, next.componentDescription(identifier));
+        assertEquals(selected, registry.componentDescription(identifier));
+
+        final String replacement = "names:replacement";
+        final var reused = new ItemRegistry(new ItemEntry[]{entry,
+            new ItemEntry(replacement, 20, true, ItemVersion.None, data)});
+        assertNull(reused.componentDescription(identifier));
+        assertNotNull(reused.componentDescription(replacement));
+        assertNotEquals(next.componentDescription(identifier), reused.componentDescription(replacement));
+        assertEquals(selected, registry.componentDescription(identifier));
+    }
+
+}
