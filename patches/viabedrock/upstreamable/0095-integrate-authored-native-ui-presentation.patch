+            display.putString("Name", "Named");
+            assertEquals("Named", registry.customName(book, data));
+        }
+        final var removed = new ItemRegistry(new ItemEntry[]{entry(book, 20, false, ItemVersion.Legacy),
+                entry("test:replacement", 20, false, ItemVersion.Legacy)});
