+package net.raphimc.viabedrock.protocol.model;
+
+import com.google.common.collect.BiMap;
+import com.google.common.collect.HashBiMap;
+import com.google.common.collect.ImmutableBiMap;
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/** One connection's item IDs and the complete definitions that own those IDs. */
+public final class ItemRegistry {
+
+    private final BiMap<String, Integer> ids;
+    private final Map<String, ItemEntry> definitions;
+    private final List<ItemEntry> entries;
+    private final List<ItemEntry> registrations;
+
+    public ItemRegistry(final ItemEntry[] entries) {
+        final BiMap<String, Integer> ids = HashBiMap.create(entries.length);
+        final Map<String, ItemEntry> definitions = new LinkedHashMap<>();
+        for (final ItemEntry entry : entries) {
+            // The native runtime-ID pass skips the invalid-ID sentinel, including later references.
+            if (entry.id() == -1) {
+                continue;
+            }
+            final String previousIdentifier = ids.inverse().remove(entry.id());
+            if (previousIdentifier != null) {
+                definitions.remove(previousIdentifier);
+            }
+            ids.put(entry.identifier(), entry.id());
+            definitions.remove(entry.identifier());
+            definitions.put(entry.identifier(), entry);
+        }
+        this.registrations = List.of(entries.clone());
+        this.ids = ImmutableBiMap.copyOf(ids);
+        this.definitions = Map.copyOf(definitions);
+        this.entries = List.copyOf(definitions.values());
+    }
+
+    public BiMap<String, Integer> ids() {
+        return this.ids;
+    }
+
+    public List<ItemEntry> entries() {
+        return this.entries;
+    }
+
+    /** Ordered network updates, including entries whose ID or identifier was subsequently replaced. */
+    public List<ItemEntry> registrations() {
+        return this.registrations;
+    }
+
+    public ItemEntry definition(final String identifier) {
+        return this.definitions.get(identifier);
+    }
+
+    public ItemEntry definition(final int id) {
+        final String identifier = this.ids.inverse().get(id);
+        return identifier != null ? this.definitions.get(identifier) : null;
+    }
+
+    public Set<String> componentItems() {
+        final Map<String, ItemVersion> factories = this.factories();
+        return this.ids.keySet().stream().filter(identifier -> factories.get(identifier) == ItemVersion.DataDriven)
+                .collect(Collectors.toUnmodifiableSet());
+    }
+
+    /** Constructor-owned defaults precede every ordered network update, including None entries. */
+    public Map<String, ItemStackingProperties> stackingProperties() {
+        final Map<String, ItemVersion> factories = this.factories();
+        final Map<String, ItemStackingProperties> properties = new HashMap<>();
+        for (final ItemEntry entry : this.registrations) {
+            final BuiltinItemFactories.Definition builtin = BuiltinItemFactories.get(entry.identifier());
+            if (builtin != null) {
+                properties.putIfAbsent(entry.identifier(), builtin.stacking());
+            }
+        }
+        for (final Map.Entry<String, ItemVersion> construction : this.constructionVersions().entrySet()) {
+            if (construction.getValue() == ItemVersion.DataDriven) {
+                properties.put(construction.getKey(), ComponentItemStackingProperties.DEFAULT);
+            } else {
+                properties.putIfAbsent(construction.getKey(), LegacyItemStackingProperties.DEFAULT);
+            }
+        }
+        for (final ItemEntry entry : this.registrations) {
+            final ItemStackingProperties previous = properties.get(entry.identifier());
+            final CompoundTag data = entry.componentData();
+            if (previous != null && data != null && data.get("components") instanceof CompoundTag components) {
+                properties.put(entry.identifier(), previous.withComponentData(components));
+            }
+        }
+        final Map<String, ItemStackingProperties> result = new HashMap<>();
+        for (final String identifier : this.ids.keySet()) {
+            final ItemStackingProperties state = properties.get(identifier);
+            if (state != null) {
+                result.put(identifier, state);
+            } else {
+                // Unknown None entries are constructed after updates.
+                result.put(identifier, factories.get(identifier) == ItemVersion.DataDriven
+                        ? ComponentItemStackingProperties.DEFAULT : LegacyItemStackingProperties.DEFAULT);
+            }
+        }
+        return Map.copyOf(result);
+    }
+
+    /** The first explicit registration selects the named factory; subsequent entries only update it. */
+    private Map<String, ItemVersion> constructionVersions() {
+        final Map<String, ItemVersion> versions = new LinkedHashMap<>();
+        for (final ItemEntry entry : this.registrations) {
+            if (entry.version() != ItemVersion.None) {
+                versions.putIfAbsent(entry.identifier(), entry.version());
+            }
+        }
+        return versions;
+    }
+
+    private Map<String, ItemVersion> factories() {
+        final Map<String, ItemVersion> factories = new HashMap<>();
+        for (final ItemEntry entry : this.registrations) {
+            final BuiltinItemFactories.Definition builtin = BuiltinItemFactories.get(entry.identifier());
+            if (builtin != null) {
+                factories.putIfAbsent(entry.identifier(), builtin.version());
+            }
+        }
+        for (final Map.Entry<String, ItemVersion> construction : this.constructionVersions().entrySet()) {
+            if (construction.getValue() == ItemVersion.DataDriven) {
+                factories.put(construction.getKey(), ItemVersion.DataDriven);
+            } else {
+                factories.putIfAbsent(construction.getKey(), ItemVersion.Legacy);
+            }
+        }
+        for (final ItemEntry entry : this.registrations) {
+            if (entry.id() != -1) {
+                factories.putIfAbsent(entry.identifier(), entry.componentBased() ? ItemVersion.DataDriven : ItemVersion.Legacy);
+            }
+        }
+        return factories;
+    }
+
+}
