+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.api.chunk.blockstate.BlockRegistryNames;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerTransferTest {
+
+    @Test
+    void selectsEligibleMergesBeforeEmptySlotsInNativeProviderOrder() {
+        final var source = item(4);
+        final var inventory = BedrockItem.emptyArray(36);
+        inventory[2] = item(64);
+        inventory[9] = item(63);
+        inventory[35] = item(62);
+        final var merge = NativeContainerTransfer.plan(source, inventory, 64, NativeContainerTransferTest::matches, slot -> true);
+        assertNotNull(merge);
+        assertEquals(9, merge.destinationSlot());
+        final var later = NativeContainerTransfer.plan(source, inventory, 64, NativeContainerTransferTest::matches, slot -> slot != 9);
+        assertNotNull(later);
+        assertEquals(35, later.destinationSlot());
+        final var empty = NativeContainerTransfer.plan(source, inventory, 64, NativeContainerTransferTest::matches, slot -> slot < 9);
+        assertNotNull(empty);
+        assertEquals(0, empty.destinationSlot());
+        assertEquals(4, source.amount());
+        assertEquals(63, inventory[9].amount());
+    }
+
+    @Test
+    void preservesUnsignedCountsAndRemovesOnlyTheFinalSourceItem() {
+        for (final int sourceCount : new int[] {1, 64, 128, 255}) {
+            final var source = item(sourceCount);
+            final var inventory = BedrockItem.emptyArray(36);
+            inventory[0] = item(254);
+            final var plan = NativeContainerTransfer.plan(source, inventory, 255, NativeContainerTransferTest::matches, slot -> true);
+            assertNotNull(plan);
+            assertEquals(sourceCount - 1, plan.sourceAfter().amount());
+            assertEquals(sourceCount == 1, plan.sourceAfter().isEmpty());
+            assertEquals(255, plan.destinationAfter().amount());
+            assertFalse(plan.destinationAfter().isEmpty());
+            assertEquals(sourceCount + 254, plan.sourceAfter().amount() + plan.destinationAfter().amount());
+            assertEquals(sourceCount, source.amount());
+            assertEquals(254, inventory[0].amount());
+        }
+    }
+
+    @Test
+    void mergesUsingDestinationSidedNativeQueriesAndRetainsTheExistingIdentity() {
+        final var registry = new BlockRegistryNames(List.of("minecraft:stone", "minecraft:dirt"));
+        final var blocks = Map.of(1, new Object(), 2, new Object());
+        final var source = item(4);
+        source.setData((short) 5);
+        source.setBlockRuntimeId(1);
+        source.setCanPlace(new String[]{"stone", "dirt", "stone"});
+        final var sourceTag = new CompoundTag();
+        sourceTag.putFloat("value", -0F);
+        source.setTag(sourceTag);
+        final var inventory = BedrockItem.emptyArray(36);
+        for (int slot = 0; slot < 4; slot++) {
+            inventory[slot] = source.copy();
+            inventory[slot].setAmount(60);
+            inventory[slot].setData(Short.MAX_VALUE);
+            inventory[slot].setBlockRuntimeId(null);
+            inventory[slot].setCanPlace(new String[]{"minecraft:dirt", "minecraft:stone"});
+            final var tag = new CompoundTag();
+            tag.putFloat("value", 0F);
+            inventory[slot].setTag(tag);
+        }
+        inventory[0].setBlockingTicks(1);
+        inventory[1].setCanBreak(new String[]{"stone"});
+        inventory[2].setBlockRuntimeId(2);
+        final var plan = NativeContainerTransfer.plan(source, inventory, 64,
+                (query, candidate) -> NativeItemStackMatcher.matches(query, candidate, blocks::get, registry::restrictionBlocks),
+                slot -> true);
+        assertNotNull(plan);
+        assertEquals(3, plan.destinationSlot());
+        assertEquals(61, plan.destinationAfter().amount());
+        assertEquals(Short.MAX_VALUE, plan.destinationAfter().data());
+        assertFalse(plan.destinationAfter().hasBlockState());
+        assertEquals(0, Float.floatToRawIntBits(plan.destinationAfter().tag().getFloatTag("value").asFloat()));
+        assertEquals(0x80000000, Float.floatToRawIntBits(plan.sourceAfter().tag().getFloatTag("value").asFloat()));
+        assertEquals(3, plan.sourceAfter().amount());
+        assertEquals(4, source.amount());
+        assertEquals(60, inventory[3].amount());
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem item(final int count) {
+        final var item = new BedrockItem(1);
+        item.setAmount(count);
+        return item;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/container/NativeItemStackMatcherTest.java b/src/test/java/net/raphimc/viabedrock/api/model/container/NativeItemStackMatcherTest.java
