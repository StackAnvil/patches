+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class NativeItemNameTest {
+
+    @Test
+    void matchesOriginalNameParser() throws Exception {
+        for (final var value : reference().getAsJsonArray("parserRows")) {
+            final var row = value.getAsJsonObject();
+            final NativeItemName actual = NativeItemName.parse(row.get("inputName").getAsString(), row.get("inputAux").getAsInt());
+            final NativeItemName expected = row.get("success").getAsBoolean()
+                    ? new NativeItemName(row.get("namespace").getAsString() + ':' + row.get("name").getAsString(), row.get("aux").getAsInt()) : null;
+            assertEquals(expected, actual, row::toString);
+        }
+    }
+
+    @Test
+    void matchesOriginalRegistryNameRewrites() throws Exception {
+        final var registry = new ItemRegistry(new ItemEntry[0]);
+        final var reference = reference();
+        for (final var value : reference.getAsJsonArray("rewriteRows")) {
+            final var row = value.getAsJsonObject();
+            assertEquals(new NativeItemName(row.get("name").getAsString(), row.get("aux").getAsInt()),
+                    registry.rewriteLegacyName(new NativeItemName(row.get("inputName").getAsString(), row.get("inputAux").getAsInt())), row::toString);
+        }
+        // These metadata combinations index outside the original callback's vectors.
+        // They require caller admission rather than a fabricated native lookup result.
+        for (final var value : reference.getAsJsonArray("unsafeCallbackInputs")) {
+            final var row = value.getAsJsonObject();
+            assertThrows(IllegalArgumentException.class, () -> registry.rewriteLegacyName(
+                    new NativeItemName(row.get("name").getAsString(), row.get("aux").getAsInt())), row::toString);
+        }
+    }
+
+    private static JsonObject reference() throws Exception {
+        final String path = System.getenv("STACKANVIL_NATIVE_ITEM_NAME_RESOLUTION");
+        assumeTrue(path != null && !path.isBlank(), "Native ItemRegistry name resolution corpus is optional");
+        try (var reader = new InputStreamReader(new GZIPInputStream(Files.newInputStream(Path.of(path))), StandardCharsets.UTF_8)) {
+            return JsonParser.parseReader(reader).getAsJsonObject().getAsJsonObject("nativeNameResolution");
+        }
+    }
+
+}
