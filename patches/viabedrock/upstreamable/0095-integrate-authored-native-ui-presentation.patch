+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.NativeItemStacking;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ComponentItemStackingProperties;
+import org.junit.jupiter.api.Test;
+import java.util.Set;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerTransferTest {
+
+    @Test
+    void selectsEligibleMergesBeforeEmptySlotsInNativeProviderOrder() {
+        final var source = item(4);
+        final var inventory = BedrockItem.emptyArray(36);
+        inventory[2] = item(64);
+        inventory[9] = item(63);
+        inventory[35] = item(62);
+        final var merge = NativeContainerTransfer.plan(source, inventory, 64, (from, to) -> !from.isDifferent(to), slot -> true);
+        assertNotNull(merge);
+        assertEquals(9, merge.destinationSlot());
+        final var later = NativeContainerTransfer.plan(source, inventory, 64, (from, to) -> !from.isDifferent(to), slot -> slot != 9);
+        assertNotNull(later);
+        assertEquals(35, later.destinationSlot());
+        final var empty = NativeContainerTransfer.plan(source, inventory, 64, (from, to) -> !from.isDifferent(to), slot -> slot < 9);
+        assertNotNull(empty);
+        assertEquals(0, empty.destinationSlot());
+        assertEquals(4, source.amount());
+        assertEquals(63, inventory[9].amount());
+    }
+
+    @Test
+    void preservesUnsignedCountsAndRemovesOnlyTheFinalSourceItem() {
+        for (final int sourceCount : new int[] {1, 64, 128, 255}) {
+            final var source = item(sourceCount);
+            final var inventory = BedrockItem.emptyArray(36);
+            inventory[0] = item(254);
+            final var plan = NativeContainerTransfer.plan(source, inventory, 255, (from, to) -> !from.isDifferent(to), slot -> true);
+            assertNotNull(plan);
+            assertEquals(sourceCount - 1, plan.sourceAfter().amount());
+            assertEquals(sourceCount == 1, plan.sourceAfter().isEmpty());
+            assertEquals(255, plan.destinationAfter().amount());
+            assertFalse(plan.destinationAfter().isEmpty());
+            assertEquals(sourceCount + 254, plan.sourceAfter().amount() + plan.destinationAfter().amount());
+            assertEquals(sourceCount, source.amount());
+            assertEquals(254, inventory[0].amount());
+        }
+    }
+
+    @Test
+    void selectsDestinationsUsingNativeSubtypeAndDurabilityEligibility() {
+        final var source = item(4);
+        final var inventory = BedrockItem.emptyArray(36);
+        inventory[0] = item(60);
+        inventory[0].setData(1);
+        final var ordinary = new ComponentItemStackingProperties(64, null, false, false);
+        final var merge = NativeContainerTransfer.plan(source, inventory, 64,
+                (from, to) -> NativeItemStacking.canMerge(from, to, ordinary, BedrockItem::data, values -> Set.of()),
+                slot -> true);
+        assertNotNull(merge);
+        assertEquals(0, merge.destinationSlot());
+
+        final var tag = new CompoundTag();
+        tag.putInt("Damage", 1);
+        source.setTag(tag);
+        inventory[0].setData(source.data());
+        inventory[0].setTag(tag.copy());
+        final var damageable = new ComponentItemStackingProperties(64, null, false, true);
+        final var separate = NativeContainerTransfer.plan(source, inventory, 64,
+                (from, to) -> NativeItemStacking.canMerge(from, to, damageable, BedrockItem::data, values -> Set.of()),
+                slot -> true);
+        assertNotNull(separate);
+        assertEquals(1, separate.destinationSlot());
+        assertEquals(4, source.amount());
+        assertEquals(60, inventory[0].amount());
+    }
+
+    private static BedrockItem item(final int count) {
+        final var item = new BedrockItem(1);
+        item.setAmount(count);
+        return item;
+    }
+
+}
