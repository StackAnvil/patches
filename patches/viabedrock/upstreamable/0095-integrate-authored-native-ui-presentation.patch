+        final var fixture = new Fixture(ContainerUi.Kind.HOPPER);
+        assertFalse(NativeStorageContainers.matches(fixture.menu, ContainerUi.Kind.BREWING_STAND));
+        assertFalse(NativeStorageContainers.matches(new ChestContainer(fixture.user, (byte) 6, null, null, 5), ContainerUi.Kind.HOPPER));
+        assertFalse(NativeStorageContainers.supported(new HopperContainer(fixture.user, (byte) 6, ContainerType.DISPENSER, null, null)));
+        assertFalse(NativeStorageContainers.supported(new Container(fixture.user, (byte) 6, ContainerType.HOPPER, null, null, 5) { }));
+        assertTrue(NativeStorageContainers.matches(new HopperContainer(fixture.user, (byte) 6, ContainerType.MINECART_HOPPER, null, null), ContainerUi.Kind.HOPPER));
+        assertTrue(NativeStorageContainers.matches(new HopperContainer(fixture.user, (byte) 6, ContainerType.CONTAINER, null, null), ContainerUi.Kind.HOPPER));
+        final var dispenser = new Generic3x3Container(fixture.user, (byte) 6, ContainerType.DISPENSER, null, null);
+        assertTrue(NativeStorageContainers.matches(dispenser, ContainerUi.Kind.DISPENSER));
+        assertFalse(NativeStorageContainers.matches(dispenser, ContainerUi.Kind.DROPPER));
+    }
+
+    private static ContainerUi redstoneProgram(final ContainerUi.Kind kind, final int slot) {
+        final String host = switch (kind) {
+            case HOPPER -> "hopper_screen";
+            case DISPENSER -> "dispenser_screen";
+            case DROPPER -> "dropper_screen";
+            default -> throw new IllegalArgumentException();
+        };
+        final int columns = kind == ContainerUi.Kind.HOPPER ? 5 : 3;
+        return ContainerUi.fromProgram(JsonParser.parseString("""
+                {"definitions": {
+                  "redstone.%s": {"parent":"", "value":{"$screen_content":"redstone.panel"}},
+                  "redstone.panel": {"parent":"", "value":{"type":"grid", "collection_name":"container_items",
+                    "grid_dimensions":[%d,%d], "controls":[{"action":{"type":"button", "grid_position":[%d,%d],
+                      "bindings":[
+                        {"binding_type":"collection", "binding_collection_name":"container_items", "binding_name":"#hover_text", "binding_name_override":"#caption"},
+                        {"binding_type":"view", "source_property_name":"(not (#caption = ''))", "target_property_name":"#visible"}],
+                      "button_mappings":[{"from_button_id":"button.menu_select", "to_button_id":"button.container_auto_place_one", "mapping_type":"pressed"}]}}]}}
+                }}
+                """.formatted(host, columns, kind.containerSlots() / columns, slot % columns, slot / columns)).getAsJsonObject());
+    }
+
+    private static boolean matches(final BedrockItem query, final BedrockItem candidate) {
+        return NativeItemStackMatcher.matches(query, candidate, ignored -> null, ignored -> Set.of());
+    }
+
+    private static BedrockItem named(final int amount) {
+        final var display = new CompoundTag();
+        display.putString("Name", "Action");
+        final var tag = new CompoundTag();
+        tag.put("display", display);
+        final var item = new BedrockItem(1);
+        item.setAmount(amount);
+        item.setNetId(0);
+        item.setTag(tag);
+        return item;
+    }
+
+    private static ContainerUi program() {
+        return ContainerUi.fromProgram(JsonParser.parseString("""
+                {"definitions": {
+                  "chest.small_chest_screen": {"parent":"", "value":{"$screen_content":"chest.small_chest_panel"}},
+                  "chest.small_chest_panel": {"parent":"", "value":{"type":"grid", "collection_name":"container_items",
+                    "grid_dimensions":[27,1], "controls":[{"action":{"type":"button", "grid_position":[9,0],
+                      "bindings":[
+                        {"binding_type":"collection", "binding_collection_name":"container_items", "binding_name":"#hover_text", "binding_name_override":"#caption"},
+                        {"binding_type":"view", "source_property_name":"(not (#caption = ''))", "target_property_name":"#visible"}],
+                      "button_mappings":[{"from_button_id":"button.menu_select", "to_button_id":"button.container_auto_place_one", "mapping_type":"pressed"}]}}]}}
