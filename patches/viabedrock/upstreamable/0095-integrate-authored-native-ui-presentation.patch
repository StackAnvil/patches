+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ShortTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.TreeSet;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BuiltinItemNameTest {
+
+    private static final ItemNameContext NAMES = new ItemNameContext((block, metadata) -> fail("Non-block provider requested a block name"), java.util.function.Function.identity(), () -> BaseGameVersion.INVALID);
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_DESCRIPTOR_NAMES", matches = ".+")
+    void registeredDescriptorsMatchActualNativeReceiversAndParsedUserdata() throws Exception {
+        final var fixture = read(Path.of(System.getenv("STACKANVIL_NATIVE_DESCRIPTOR_NAMES")));
+        final var identifiers = new TreeSet<String>();
+        fixture.getAsJsonArray("nativeReceiverKeys").forEach(value -> identifiers.add(value.getAsJsonObject().get("name").getAsString()));
+        int id = 1;
+        final var entries = new ArrayList<ItemEntry>();
+        for (final String identifier : identifiers) {
+            entries.add(new ItemEntry(identifier, id++, false, ItemVersion.None, null));
+        }
+        final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+        for (final var value : fixture.getAsJsonArray("nativeReceiverKeys")) {
+            final var row = value.getAsJsonObject();
+            final CompoundTag data;
+            if (row.get("nbtHex").isJsonNull()) {
+                data = null;
+            } else {
+                final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(row.get("nbtHex").getAsString()));
+                try {
+                    data = (CompoundTag) BedrockTypes.TAG_LE.read(buffer);
+                    assertFalse(buffer.isReadable());
+                } finally {
+                    buffer.release();
+                }
+            }
+            assertKey(row.get("resultHex").getAsString(), registry.ordinaryNameKey(row.get("name").getAsString(), auxiliary(row), data, NAMES), row.toString());
+        }
+        assertEquals(41, identifiers.size());
+        assertEquals(10906, fixture.getAsJsonArray("nativeReceiverKeys").size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_DESCRIPTOR_KEY_REFERENCES", matches = ".+")
+    void descriptorMethodsMatchNativeTypedTagsAndDefinitionFields() throws Exception {
+        final var directory = Path.of(System.getenv("STACKANVIL_NATIVE_DESCRIPTOR_KEY_REFERENCES"));
+        final var covered = EnumSet.noneOf(BuiltinItemName.Kind.class);
+        for (final String file : List.of("item-variant-key-reference.json", "item-state-key-reference.json", "map-key-reference.json", "shield-key-reference.json", "dye-key-reference.json")) {
+            for (final var value : read(directory.resolve(file)).getAsJsonArray("rows")) {
+                final var row = value.getAsJsonObject();
+                if (row.has("forcedBlackHash") && row.get("forcedBlackHash").getAsBoolean()) {
+                    continue; // Runtime descriptors construct their identifier hash from the identifier bytes.
+                }
+                final String family = switch (file) {
+                    case "map-key-reference.json" -> "FILLED_MAP";
+                    case "shield-key-reference.json" -> "SHIELD";
+                    case "dye-key-reference.json" -> "DYE";
+                    default -> row.get("family").getAsString().toUpperCase(Locale.ROOT);
+                };
+                final BuiltinItemName.Kind kind;
+                try {
+                    kind = BuiltinItemName.Kind.valueOf(family);
+                } catch (final IllegalArgumentException ignored) {
+                    continue;
+                }
+                final String description = row.has("base") ? string(row.get("base").getAsString()) : "item.probe";
+                final int variant = row.has("color") ? row.get("color").getAsInt() : row.has("variant") ? row.get("variant").getAsInt() : 0;
+                final String identifier = row.has("identifier") ? string(row.get("identifier").getAsString()) : "";
+                final Short auxiliary = kind == BuiltinItemName.Kind.DYE
+                        ? row.get("descriptorPresent").getAsBoolean() ? (short) 255 : null : auxiliary(row);
+                final var method = new BuiltinItemName.Descriptor(kind, description, variant);
+                assertKey(row.get("result").getAsString(), method.key(identifier, auxiliary, data(row.get("root")), NAMES), row.toString());
+                covered.add(kind);
+            }
+        }
+        assertEquals(Set.of(BuiltinItemName.Kind.values()), covered);
+    }
+
+    private static JsonObject read(final Path path) throws Exception {
+        return JsonParser.parseString(Files.readString(path)).getAsJsonObject();
+    }
+
+    private static Short auxiliary(final JsonObject row) {
+        return row.has("aux") && !row.get("aux").isJsonNull() ? row.get("aux").getAsShort() : null;
+    }
+
+    private static CompoundTag data(final JsonElement element) {
+        if (element == null || element.isJsonNull()) {
+            return null;
+        }
+        final var tag = new CompoundTag();
+        for (final var entry : element.getAsJsonObject().entrySet()) {
+            final var value = entry.getValue().getAsJsonArray();
+            tag.put(entry.getKey(), switch (value.get(0).getAsInt()) {
+                case 1 -> new ByteTag(value.get(1).getAsByte());
+                case 2 -> new ShortTag(value.get(1).getAsShort());
+                case 3 -> new IntTag(value.get(1).getAsInt());
+                case 8 -> new StringTag(string(value.get(1).getAsString()));
+                default -> throw new IllegalArgumentException("Unsupported native tag fixture");
+            });
+        }
+        return tag;
+    }
+
+    private static String string(final String hex) {
+        final byte[] bytes = HexFormat.of().parseHex(hex);
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeByte(8).writeShortLE(0).writeShortLE(bytes.length).writeBytes(bytes);
+            return ((StringTag) BedrockTypes.TAG_LE.read(buffer)).getValue();
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static void assertKey(final String expected, final String actual, final String context) {
+        assertNotNull(actual);
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.TAG_LE.write(buffer, new StringTag(actual));
+            assertEquals(8, buffer.readUnsignedByte());
+            assertEquals(0, buffer.readUnsignedShortLE());
+            final byte[] bytes = new byte[buffer.readUnsignedShortLE()];
+            buffer.readBytes(bytes);
+            assertFalse(buffer.isReadable());
+            assertArrayEquals(HexFormat.of().parseHex(expected), bytes, context);
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
