+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class HudTitleUiTest {
+
+    @Test
+    void retainsInsertedTitleFactoriesWithoutExpandingUnrelatedCollections() {
+        final String title = UUID.randomUUID().toString();
+        final String texture = UUID.randomUUID().toString();
+        final var scene = new HudTitleUi(title, texture, 10, 70, 20).resolve(program());
+        assertNotNull(scene);
+        final var hosts = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertEquals(1, hosts.size());
+        final var controls = hosts.get(0).getAsJsonObject().getAsJsonArray("children")
+                .get(0).getAsJsonObject().getAsJsonArray("children");
+        assertEquals(2, controls.size());
+        assertEquals(30, controls.get(0).getAsJsonObject().getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(title, controls.get(1).getAsJsonObject().get("text").getAsString());
+        final var tracks = controls.get(1).getAsJsonObject().getAsJsonObject("animation_program").getAsJsonArray("tracks");
+        assertEquals(3, tracks.size());
+        assertEquals(.5, tracks.get(0).getAsJsonObject().get("duration").getAsDouble());
+        assertEquals(3.5, tracks.get(1).getAsJsonObject().get("duration").getAsDouble());
+        assertEquals(1, tracks.get(2).getAsJsonObject().get("duration").getAsDouble());
+        assertNull(new HudTitleUi(title, "", 10, 70, 20).resolve(new JsonUiProgram(List.of())));
+    }
+
+    @Test
+    void resolvesBundledTitleFactoriesWithoutServerOverrides() {
+        Assumptions.assumeTrue(HudTitleUi.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var resources = new ResourcePackStorage(List.of());
+        final var program = resources.getJsonUiProgram();
+        assertFalse(program.customizes("ui/hud_screen.json"));
+        final String title = UUID.randomUUID().toString();
+        final String subtitle = UUID.randomUUID().toString();
+        final var state = new NativeHudTitleState();
+        assertNull(state.update(SetTitlePacket_TitleType.Subtitle, subtitle, 0, 0, 0, resources));
+        final var message = state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources);
+        assertNotNull(message);
+        assertTrue(message.restart());
+        assertEquals(100, message.ticks());
+        final var root = JsonParser.parseString(message.scene()).getAsJsonObject().getAsJsonObject("root");
+        final var captions = new ArrayList<String>();
+        collectCaptions(root, captions);
+        assertResolvedAnimationNumbers(root);
+        assertEquals(List.of(title, subtitle), captions);
+    }
+
+    private static void assertResolvedAnimationNumbers(final JsonObject node) {
+        if (node.has("animation_program")) {
+            for (final var value : node.getAsJsonObject("animation_program").getAsJsonArray("tracks")) {
+                final var track = value.getAsJsonObject();
+                for (final String property : List.of("duration", "from", "to")) {
+                    if (track.has(property)) {
+                        assertTrue(track.get(property).isJsonPrimitive());
+                        assertTrue(Double.isFinite(track.get(property).getAsDouble()));
+                    }
+                }
+            }
+        }
+        for (final var child : node.getAsJsonArray("children")) {
+            assertResolvedAnimationNumbers(child.getAsJsonObject());
+        }
+    }
+
+    private static void collectCaptions(final JsonObject node, final List<String> captions) {
+        if (node.has("text")) {
+            captions.add(node.get("text").getAsString());
+        }
+        for (final var child : node.getAsJsonArray("children")) {
+            collectCaptions(child.getAsJsonObject(), captions);
+        }
+    }
+
+    @Test
+    void preservesSubtitleOrderingTimesAndClearVersusReset() {
+        final var resources = new ResourcePackStorage(List.of()) {
+            @Override
+            public JsonUiProgram getJsonUiProgram() {
+                return program();
+            }
+        };
+        final var state = new NativeHudTitleState();
+        final String title = UUID.randomUUID().toString();
+        final String subtitle = UUID.randomUUID().toString();
+        assertNull(state.update(SetTitlePacket_TitleType.Subtitle, subtitle, 0, 0, 0, resources));
+        assertNull(state.update(SetTitlePacket_TitleType.Times, "", 4, 8, 12, resources));
+        final var initial = state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources);
+        assertTrue(initial.restart());
+        assertEquals(24, initial.ticks());
+        final var revised = state.update(SetTitlePacket_TitleType.Subtitle, title, 0, 0, 0, resources);
+        assertFalse(revised.restart());
+        assertEquals(initial.ticks(), revised.ticks());
+        assertTrue(state.update(SetTitlePacket_TitleType.Clear, "", 0, 0, 0, resources).scene().isEmpty());
+        assertEquals(24, state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources).ticks());
+        assertTrue(state.update(SetTitlePacket_TitleType.Reset, "", 0, 0, 0, resources).scene().isEmpty());
+        assertEquals(100, state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources).ticks());
+        assertNull(state.update(SetTitlePacket_TitleType.Actionbar, title, 0, 0, 0, resources));
+    }
+
+    @Test
+    void keepsLiveTitleTimingWhenLaterPacketsConfigureTheNextTitle() {
+        final var resources = new ResourcePackStorage(List.of()) {
+            @Override
+            public JsonUiProgram getJsonUiProgram() {
+                return program();
+            }
+        };
+        final var state = new NativeHudTitleState();
+        final String title = UUID.randomUUID().toString();
+        final String subtitle = UUID.randomUUID().toString();
+        final var initial = state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources);
+        assertEquals(100, initial.ticks());
+
+        // Changing the next title's hold time cannot destroy or retime the already visible instance.
+        assertNull(state.update(SetTitlePacket_TitleType.Times, "", -1, 20, -1, resources));
+        final var changedSubtitle = state.update(SetTitlePacket_TitleType.Subtitle, subtitle, 0, 0, 0, resources);
+        assertFalse(changedSubtitle.restart());
+        assertEquals(initial.ticks(), changedSubtitle.ticks());
+        assertEquals(alphaSequence(initial), alphaSequence(changedSubtitle));
+
+        final var next = state.update(SetTitlePacket_TitleType.TitleTextObject, title, 0, 0, 0, resources);
+        assertTrue(next.restart());
+        assertEquals(50, next.ticks());
+        assertNotEquals(alphaSequence(initial), alphaSequence(next));
+        assertNull(state.update(SetTitlePacket_TitleType.Times, "", 0, -1, 0, resources));
+        assertEquals(20, state.update(SetTitlePacket_TitleType.Title, title, 0, 0, 0, resources).ticks());
+    }
+
+    private static JsonArray alphaSequence(final NativeHudMessage message) {
+        return JsonParser.parseString(message.scene()).getAsJsonObject()
+                .getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject()
+                .getAsJsonArray("children").get(0).getAsJsonObject()
+                .getAsJsonArray("children").get(1).getAsJsonObject().getAsJsonObject("animation_program").getAsJsonArray("tracks");
+    }
+
+    private static JsonUiProgram program() {
+        final byte[] lower = """
+                {"namespace":"hud","root_panel":{"type":"panel","size":["100%","100%"],"controls":[
+                  {"unrelated":{"type":"grid","grid_dimension_binding":"#absent","grid_item_template":"hud.absent"}}]},
+                 "banner":{"type":"panel","size":[120,40],"controls":[
+                  {"icon":{"type":"image","size":[30,30],"texture":"#hud_subtitle_text_string"}},
+                  {"label":{"type":"label","text":"#hud_title_text_string","alpha":"@fade"}}]},
+                 "fade":{"anim_type":"alpha","duration":"$title_fade_in_time","from":0,"to":1,"next":"@stay"},
+                 "stay":{"anim_type":"wait","duration":"$title_stay_time","next":"@out"},
+                 "out":{"anim_type":"alpha","duration":"$title_fade_out_time","from":1,"to":0}}
+                """.getBytes(StandardCharsets.UTF_8);
+        final byte[] upper = """
+                {"namespace":"hud","root_panel":{"modifications":[{"array_name":"controls","operation":"insert_back",
+                 "value":{"host":{"type":"panel","factory":{"name":"hud_title_text_factory",
+                 "control_ids":{"hud_title_text":"hud.banner"}}}}}]}}
+                """.getBytes(StandardCharsets.UTF_8);
+        return new JsonUiProgram(List.of(Map.of("ui/hud_screen.json", lower), Map.of("ui/hud_screen.json", upper)));
+    }
+
+}
