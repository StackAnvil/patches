+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.api.model.NativeItemHoverText;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+
+/** Resolve action scope from the current authoritative menu and authored program. */
+public final class NativeContainerActionSlots {
+
+    private NativeContainerActionSlots() { }
+
+    public static Set<Integer> resolve(
+            final UserConnection user,
+            final Container menu,
+            final int menuId,
+            final ContainerUi.Kind kind,
+            final String title,
+            final ContainerUi program) {
+        final var tracker = user.get(InventoryTracker.class);
+        final var slots = new ArrayList<ContainerUi.Slot>();
+        for (int index = 0; index < menu.size(); index++) {
+            slots.add(new ContainerUi.Slot(index, presentation(menu.getItem(index))));
+        }
+        final var inventory = tracker.getInventoryContainer();
+        for (int index = 0; index < 36; index++) {
+            final int bedrockSlot = index < 27 ? index + 9 : index - 27;
+            slots.add(
+                    new ContainerUi.Slot(
+                            menu.size() + index, presentation(inventory.getItem(bedrockSlot))));
+        }
+        final var scene =
+                program.resolve(
+                        new ContainerUi.MenuView(
+                                menuId,
+                                kind,
+                                title,
+                                slots,
+                                presentation(tracker.getHudContainer().getItem(0)), kind.initialData()));
+        if (scene == null || !scene.getAsJsonArray("missing_templates").isEmpty()) {
+            return Set.of();
+        }
+        final var scope = ContainerUi.actionScope(scene, menu.size());
+        for (final int slot : scope.referencedSlots()) {
+            final var item = menu.getItem(slot);
+            if (NativeItemHoverText.custom(item.isEmpty(), item.tag()) == null) {
+                return Set.of();
+            }
+        }
+        return scope.subset() ? scope.slots() : Set.of();
+    }
+
+    private static Map<String, JsonElement> presentation(final BedrockItem item) {
+        final Map<String, JsonElement> values = new HashMap<>();
+        values.put("#inventory_stack_count", new JsonPrimitive(item.isEmpty() ? 0 : item.amount()));
+        final String hover = NativeItemHoverText.custom(item.isEmpty(), item.tag());
+        if (hover != null) {
+            values.put("#hover_text", new JsonPrimitive(hover));
+        }
+        return values;
+    }
+
+}
