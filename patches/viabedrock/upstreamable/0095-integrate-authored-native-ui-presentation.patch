+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class HudActionbarUiTest {
+
+    @Test
+    void resolvesBundledFactoryWithIndependentAnimationAndFiniteBindings() {
+        Assumptions.assumeTrue(HudActionbarUi.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var resources = new ResourcePackStorage(List.of());
+        final String text = UUID.randomUUID().toString();
+        final var scene = new HudActionbarUi(text).resolve(resources.getJsonUiProgram());
+        assertNotNull(scene);
+        final var nodes = new ArrayList<JsonObject>();
+        collect(scene.getAsJsonObject("root"), nodes);
+        assertEquals(List.of(text), nodes.stream().filter(n -> n.has("text")).map(n -> n.get("text").getAsString()).toList());
+        final var animations = nodes.stream().filter(n -> n.has("animation_program"))
+                .flatMap(n -> n.getAsJsonObject("animation_program").getAsJsonArray("tracks").asList().stream()).map(n -> n.getAsJsonObject()).toList();
+        assertEquals(2, animations.size());
+        for (final var animation : animations) {
+            assertEquals(3, animation.get("duration").getAsDouble());
+            assertEquals("in_expo", animation.get("easing").getAsString());
+            assertEquals(0, animation.get("to").getAsDouble());
+            assertTrue(Double.isFinite(animation.get("from").getAsDouble()));
+        }
+        assertEquals(List.of(.6, 1D), animations.stream().map(n -> n.get("from").getAsDouble()).sorted().toList());
+    }
+
+    @Test
+    void actionbarUpdatesAndEmptyMessagesDoNotChangeTitleTimingOrClearState() {
+        Assumptions.assumeTrue(HudActionbarUi.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var resources = new ResourcePackStorage(List.of());
+        final var actionbar = new NativeHudActionbarState();
+        final var title = new NativeHudTitleState();
+        final String text = UUID.randomUUID().toString();
+        title.update(SetTitlePacket_TitleType.Times, "", 0, 200, 0, resources);
+        assertEquals(200, title.update(SetTitlePacket_TitleType.Title, text, 0, 0, 0, resources).ticks());
+        final var first = actionbar.update(SetTitlePacket_TitleType.Actionbar, text, resources);
+        assertTrue(first.restart());
+        assertEquals(NativeHudMessage.ANIMATION_LIFETIME, first.ticks());
+        for (final var type : List.of(SetTitlePacket_TitleType.Times, SetTitlePacket_TitleType.Clear, SetTitlePacket_TitleType.Reset)) {
+            assertNull(actionbar.update(type, "", resources));
+        }
+        assertEquals(200, title.update(SetTitlePacket_TitleType.Subtitle, text, 0, 0, 0, resources).ticks());
+        assertEquals(NativeHudMessage.ANIMATION_LIFETIME, actionbar.update(SetTitlePacket_TitleType.ActionbarTextObject, text, resources).ticks());
+        assertNull(actionbar.update(SetTitlePacket_TitleType.Actionbar, "", resources));
+        assertNull(actionbar.update(SetTitlePacket_TitleType.Actionbar, "", resources));
+    }
+
+    @Test
+    void retainsAuthoredFactoryAncestorsAndClearsAnUnsupportedReplacement() {
+        final String text = UUID.randomUUID().toString();
+        final byte[] json = """
+                {"namespace":"hud","root_panel":{"type":"panel","controls":[
+                  {"title":{"type":"panel","factory":{"name":"hud_title_text_factory","control_ids":{"hud_title_text":"hud.absent"}}}},
+                  {"actionbar_host":{"type":"panel","offset":[4,9],"factory":{"name":"hud_actionbar_text_factory",
+                    "control_ids":{"hud_actionbar_text":"hud.label"}}}}]},
+                 "label":{"type":"label","text":"$actionbar_text","localize":false}}
+                """.getBytes(StandardCharsets.UTF_8);
+        final var program = new JsonUiProgram(List.of(Map.of("ui/hud_screen.json", json)));
+        final var resources = new ResourcePackStorage(List.of()) {
+            boolean missing;
+            @Override
+            public JsonUiProgram getJsonUiProgram() {
+                return this.missing ? new JsonUiProgram(List.of()) : program;
+            }
+        };
+        final var state = new NativeHudActionbarState();
+        final var message = state.update(SetTitlePacket_TitleType.Actionbar, text, resources);
+        assertNotNull(message);
+        final var root = JsonParser.parseString(message.scene()).getAsJsonObject().getAsJsonObject("root");
+        assertEquals(1, root.getAsJsonArray("children").size());
+        final var host = root.getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(9, host.getAsJsonArray("offset").get(1).getAsInt());
+        assertEquals(text, host.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        resources.missing = true;
+        assertTrue(state.update(SetTitlePacket_TitleType.Actionbar, text, resources).scene().isEmpty());
+        assertNull(state.update(SetTitlePacket_TitleType.Actionbar, text, resources));
+    }
+
+    private static void collect(final JsonObject node, final List<JsonObject> nodes) {
+        nodes.add(node);
+        for (final var child : node.getAsJsonArray("children")) {
+            collect(child.getAsJsonObject(), nodes);
+        }
+    }
+
+}
