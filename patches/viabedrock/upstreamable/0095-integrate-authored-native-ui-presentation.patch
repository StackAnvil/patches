+import java.nio.file.Path;
+import java.util.ArrayList;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemRegistryOrdinaryNamesTest {
+
+    private static final ItemNameContext NAMES = new ItemNameContext((block, auxiliary) -> BuiltinBlockNames.get(block), java.util.function.Function.identity(), () -> BaseGameVersion.INVALID);
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_INVARIANT_NAMES", matches = ".+")
+    void ordinaryKeysMatchNativeFactoryReceivers() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_INVARIANT_NAMES")))).getAsJsonObject();
+        final var entries = new ArrayList<ItemEntry>();
+        for (final var value : fixture.getAsJsonArray("rows")) {
+            entries.add(new ItemEntry(value.getAsJsonObject().get("name").getAsString(),
+                    entries.size() + 1, false, ItemVersion.None, null));
+        }
+        final var registry = new ItemRegistry(entries.toArray(ItemEntry[]::new));
+        for (final var value : fixture.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            assertEquals(row.get("result").getAsString(), registry.ordinaryNameKey(row.get("name").getAsString(), (short) 0, null, NAMES), row::toString);
+        }
+        assertEquals(559, entries.size());
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"minecraft:coal", "minecraft:tropical_fish_bucket", "minecraft:white_dye", "minecraft:filled_map"})
+    void nativeKeysFollowConstructionAndRuntimeIdentityRatherThanNetworkFlags(final String identifier) {
+        final var inherited = new ItemEntry(identifier, 20, false, ItemVersion.None, null);
+        final var name = new CompoundTag();
+        name.putString("value", "replacement.key");
+        final var components = new CompoundTag();
+        components.put("minecraft:display_name", name);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var legacy = new ItemEntry(identifier, 20, true, ItemVersion.Legacy, data);
+        final var component = new ItemEntry(identifier, 20, false, ItemVersion.DataDriven, null);
+        final var initial = new ItemRegistry(new ItemEntry[]{inherited});
+        final var retained = new ItemRegistry(new ItemEntry[]{inherited, legacy, component});
+        final var recreated = new ItemRegistry(new ItemEntry[]{inherited, component, legacy});
+        assertEquals(initial.ordinaryNameKey(identifier, (short) 0, null, NAMES), retained.ordinaryNameKey(identifier, (short) 0, null, NAMES));
+        assertNotEquals(initial.ordinaryNameKey(identifier, (short) 0, null, NAMES), recreated.ordinaryNameKey(identifier, (short) 0, null, NAMES));
+        assertEquals(recreated.componentDescription(identifier), recreated.ordinaryNameKey(identifier, (short) 0, null, NAMES));
+
+        final var replaced = new ItemRegistry(new ItemEntry[]{inherited,
+            new ItemEntry("minecraft:charcoal", 20, false, ItemVersion.None, null)});
+        assertNull(replaced.ordinaryNameKey(identifier, (short) 0, null, NAMES));
+        assertNotNull(replaced.ordinaryNameKey("minecraft:charcoal", (short) 0, null, NAMES));
+        assertNotEquals(initial.ordinaryNameKey(identifier, (short) 0, null, NAMES), replaced.ordinaryNameKey("minecraft:charcoal", (short) 0, null, NAMES));
+        assertEquals(initial.ordinaryNameKey(identifier, (short) 0, null, NAMES), retained.ordinaryNameKey(identifier, (short) 0, null, NAMES));
+    }
+
+}
