+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.NativeItemNames;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.function.BiFunction;
+import java.util.stream.Collectors;
+
+/** A connection's constructed definitions, raw declarations and independent lookup owners. */
+public final class ItemRegistry {
+
+    private final NativeItemDefinitions<ItemDefinitionProperties> definitions;
+    private final List<ItemEntry> registrations;
+    private final Map<String, Integer> ids;
+
+    public ItemRegistry(final ItemEntry[] entries) {
+        this(entries, BuiltinItemRegistry::resolveBlock);
+    }
+
+    public ItemRegistry(final ItemEntry[] entries, final Function<String, String> resolveBlock) {
+        this.registrations = List.of(entries.clone());
+        this.definitions = BuiltinItemRegistry.create(this.registrations, resolveBlock);
+        this.ids = this.definitions.definitions().stream().collect(Collectors.toUnmodifiableMap(
+                NativeItemDefinitions.Definition::identifier, NativeItemDefinitions.Definition::id));
+    }
+
+    /** Named definitions can share an ID. Numeric lookup selects its own surviving owner. */
+    public Map<String, Integer> ids() {
+        return this.ids;
+    }
+
+    public List<? extends NativeItemDefinitions.Definition<?>> definitions() {
+        return this.definitions.definitions();
+    }
+
+    /** Raw packet declarations retain their complete data independently of factory selection. */
+    public List<ItemEntry> registrations() {
+        return this.registrations;
+    }
+
+    public NativeItemDefinitions.Definition<?> definition(final String identifier) {
+        return this.definitions.exact(identifier);
+    }
+
+    public NativeItemDefinitions.Definition<?> definition(final int id) {
+        return this.definitions.numeric(id);
+    }
+
+    /** Raw snapshots select the numeric owner; constructed stacks retain their selected receiver. */
+    public NativeItemDefinitions.Definition<?> definition(final BedrockItem item) {
+        if (item == null) {
+            return null;
+        }
+        return item.definition() != null ? item.definition() : this.definition(item.identifier());
+    }
+
+    public String identifier(final BedrockItem item) {
+        final var definition = this.definition(item);
+        return definition != null ? definition.identifier() : null;
+    }
+
+    /** Occupied-slot merging requires the same native Item object. */
+    public boolean sameDefinition(final BedrockItem first, final BedrockItem second) {
+        final var definition = this.definition(first);
+        return definition != null && definition == this.definition(second);
+    }
+
+    /** Full stack queries compare the native Item name and ID independently of pointer identity. */
+    public boolean sameItem(final BedrockItem first, final BedrockItem second) {
+        final var a = this.definition(first);
+        final var b = this.definition(second);
+        return a != null && b != null && a.id() == b.id() && a.identifier().equals(b.identifier());
+    }
+
+    public String identifier(final int id) {
+        final var definition = this.definitions.numeric(id);
+        return definition != null ? definition.identifier() : null;
+    }
+
+    /** Actual named lookup, before class-specific ItemStack construction and metadata normalization. */
+    public NativeItemDefinitions.Lookup<?> lookup(final String name, final int auxiliary) {
+        return this.definitions.lookup(name, auxiliary);
+    }
+
+    public NativeItemDefinitions.Lookup<?> lookup(final NativeItemName name) {
+        return this.definitions.lookup(name);
+    }
+
+    public ItemStackingProperties stackingProperties(final BedrockItem item) {
+        final var definition = this.definition(item);
+        return definition != null ? ((ItemDefinitionProperties) definition.receiver()).stacking() : null;
+    }
+
+    public ItemStorageProperties storageProperties(final BedrockItem item) {
+        final var definition = this.definition(item);
+        return definition != null ? ((ItemDefinitionProperties) definition.receiver()).storage() : ItemStorageProperties.NONE;
+    }
+
+    public int creativeCategory(final int id) {
+        final var definition = this.definitions.numeric(id);
+        return definition != null ? definition.receiver().category() : 0;
+    }
+
+    /** Creative membership writes to the numeric owner's shared definition. */
+    boolean assignCreativeCategory(final int id, final int category) {
+        final var definition = this.definitions.numeric(id);
+        if (definition == null) {
+            return false;
+        }
+        definition.receiver().category(category);
+        return true;
+    }
+
+    public boolean hasComplexAlias(final String name) {
+        return BuiltinItemAliases.hasComplexAlias(name);
+    }
+
+    public List<String> complexAliasMembers(final String name) {
+        return BuiltinItemAliases.members(name);
+    }
+
+    /** Native fallback rewriting follows the priority-name lookup. */
+    public NativeItemName rewriteLegacyName(final NativeItemName query) {
+        return BuiltinItemAliases.rewrite(query);
+    }
+
+    public String customName(final String identifier, final CompoundTag data) {
+        final var definition = this.definitions.exact(identifier);
+        return definition != null ? NativeItemNames.customName(data, definition.receiver().writtenBook()) : null;
+    }
+
+    public String componentDescription(final String identifier) {
+        final var definition = this.definitions.exact(identifier);
+        return definition != null ? definition.receiver().description() : null;
+    }
+
+    public String ordinaryNameKey(final String identifier, final Short auxiliaryData, final CompoundTag data,
+                                  final ItemNameContext context) {
+        final var definition = this.definitions.exact(identifier);
+        return definition != null ? definition.receiver().ordinaryName(auxiliaryData, data, context) : null;
+    }
+
+    /** Primary text belongs to the stack's selected definition, including retained and zero-count stacks. */
+    public String primaryName(final BedrockItem item, final ItemNameContext context,
+                              final BiFunction<String, List<String>, String> formatter) {
+        final var definition = this.definition(item);
+        if (definition == null) {
+            return "";
+        }
+        final var properties = (ItemDefinitionProperties) definition.receiver();
+        return NativeItemNames.primary(true, item.tag(), properties.writtenBook(),
+                () -> context.translate().apply(properties.ordinaryName(item.data(), item.tag(), context)), context.translate(), formatter);
+    }
+
+    /** Native null-stack tests include the selected air definition, independently of its numeric ID. */
+    public boolean isEmpty(final BedrockItem item) {
+        final var definition = this.definition(item);
+        return item == null || item.isEmpty() || definition == null || definition.identifier().equals("minecraft:air");
+    }
+
+    /** The retained native receiver selects the secondary producer independently of stack count. */
+    public String secondaryDescription(final BedrockItem item, final boolean creative, final ItemDescriptionContext context) {
+        final var definition = this.definition(item);
+        return definition == null ? "" : BuiltinItemDescriptions.describe(((ItemDefinitionProperties) definition.receiver()).secondaryDescription(),
+                definition.identifier(), item, creative, context, this::isEmpty);
+    }
+
+    public Set<String> componentItems() {
+        return this.definitions.definitions().stream().filter(definition -> definition.receiver().component())
+                .map(NativeItemDefinitions.Definition::identifier).collect(Collectors.toUnmodifiableSet());
+    }
+
+    public Map<String, ItemStackingProperties> stackingProperties() {
+        return this.definitions.definitions().stream().collect(Collectors.toUnmodifiableMap(
+                NativeItemDefinitions.Definition::identifier, definition -> definition.receiver().stacking()));
+    }
+
+}
