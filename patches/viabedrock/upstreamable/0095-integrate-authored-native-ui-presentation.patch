+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+/** Ordinary Item definitions update flat namespaced scalars independently. */
+public record LegacyItemStackingProperties(int compiledMaximum, boolean compiledStackedByData, short maximumDamage,
+                                          Integer fixedMaximum, boolean forcedSubtype) implements ItemStackingProperties {
+
+    static final LegacyItemStackingProperties DEFAULT = new LegacyItemStackingProperties(64, false, (short) 0);
+
+    public LegacyItemStackingProperties(final int maximum, final boolean stackedByData, final short maximumDamage) {
+        this(maximum, stackedByData, maximumDamage, null, false);
+    }
+
+    @Override
+    public int maximum() {
+        return this.fixedMaximum != null ? this.fixedMaximum : this.compiledMaximum;
+    }
+
+    @Override
+    public boolean stackedByData() {
+        return this.forcedSubtype || this.compiledStackedByData;
+    }
+
+    @Override
+    public LegacyItemStackingProperties withComponentData(final CompoundTag components) {
+        int maximum = this.compiledMaximum;
+        if (components.contains("minecraft:max_stack_size")) {
+            maximum = components.get("minecraft:max_stack_size") instanceof IntTag size ? size.asInt() & 0xFF : 0;
+        }
+        boolean stackedByData = this.compiledStackedByData;
+        if (components.contains("minecraft:stacked_by_data")) {
+            stackedByData = components.get("minecraft:stacked_by_data") instanceof ByteTag flag && flag.asByte() != 0;
+        }
+        short maximumDamage = this.maximumDamage;
+        if (components.contains("minecraft:max_damage")) {
+            maximumDamage = components.get("minecraft:max_damage") instanceof IntTag damage ? damage.asShort() : 0;
+        }
+        return new LegacyItemStackingProperties(maximum, stackedByData, maximumDamage, this.fixedMaximum, this.forcedSubtype);
+    }
+
+    @Override
+    public boolean damageable() {
+        return this.maximumDamage > 0;
+    }
+
+}
