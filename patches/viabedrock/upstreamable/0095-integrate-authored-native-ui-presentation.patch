+    static ContainerUi.Kind nativeContainerKind(final ContainerType type, final String blockTag, final int size) {
+        return switch (type) {
+            case CONTAINER -> {
+                if (size == 54) {
+                    yield ContainerUi.Kind.CHEST_6_ROWS;
+                }
+                if (size != 27) {
+                    yield null;
+                }
+                yield CustomBlockTags.BARREL.equals(blockTag) ? ContainerUi.Kind.BARREL
+                        : CustomBlockTags.SHULKER_BOX.equals(blockTag) ? ContainerUi.Kind.SHULKER_BOX
+                        : CustomBlockTags.ENDER_CHEST.equals(blockTag) ? ContainerUi.Kind.ENDER_CHEST
+                        : ContainerUi.Kind.CHEST_3_ROWS;
+            }
+            case MINECART_CHEST, CHEST_BOAT -> size == 27 ? ContainerUi.Kind.CHEST_3_ROWS : null;
+            case HOPPER, MINECART_HOPPER -> size == 5 ? ContainerUi.Kind.HOPPER : null;
+            case DISPENSER -> size == 9 ? ContainerUi.Kind.DISPENSER : null;
+            case DROPPER -> size == 9 ? ContainerUi.Kind.DROPPER : null;
+            default -> null;
+        };
+    }
