+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/** Definition-owned item labels from the target's enchantment, potion and stew registrations. */
+final class BuiltinItemDescriptions {
+
+    private static final BaseGameVersion NEW_POTIONS = BaseGameVersion.parse("1.21.0");
+    private static final Data DATA = load();
+
+    static String describe(final BuiltinItemFactories.SecondaryDescription producer, final String identifier,
+                           final BedrockItem item, final boolean creative, final ItemDescriptionContext context, final Predicate<BedrockItem> empty) {
+        return switch (producer) {
+            case COMMON -> enchantments(item.tag(), context.translate());
+            case POTION -> potion(context.auxiliary().applyAsInt(item), identifier.equals("minecraft:splash_potion") ? 1
+                    : identifier.equals("minecraft:lingering_potion") ? 2 : 0, 1F, false, context);
+            case ARROW -> potion((context.auxiliary().applyAsInt(item) & 0xFFFF) - 1, 0, 0.125F, true, context);
+            case SHULKER -> shulker(item.tag(), context, empty);
+            case STEW -> creative ? stew(context.auxiliary().applyAsInt(item), context)
+                    : enchantments(item.tag(), context.translate());
+            case OMINOUS -> ominous((short) context.auxiliary().applyAsInt(item), context.translate());
+        };
+    }
+
+    private static String enchantments(final CompoundTag data, final Function<String, String> translate) {
+        if (data == null || !(data.get("ench") instanceof ListTag<?> entries)) {
+            return "";
+        }
+        final var ordered = new ArrayList<Enchantment>();
+        for (final var entry : entries) {
+            if (!(entry instanceof CompoundTag fields)) {
+                throw new IllegalArgumentException("Enchantment entries must be compounds");
+            }
+            final int id = fields.get("id") instanceof ShortTag value ? value.asShort() & 0xFF : 0;
+            final int level = fields.get("lvl") instanceof ShortTag value ? value.asShort() : 0;
+            if (id < DATA.enchantments().size()) {
+                ordered.add(new Enchantment(id, level));
+            }
+        }
+        ordered.sort(Comparator.comparingInt(entry -> DATA.enchantments().get(entry.id()).category()));
+        final StringBuilder text = new StringBuilder();
+        for (final var entry : ordered) {
+            if (!text.isEmpty()) {
+                text.append('\n');
+            }
+            final var definition = DATA.enchantments().get(entry.id());
+            text.append("§r").append(entry.id() == 27 || entry.id() == 28 ? "§c" : "§9").append(translate.apply(definition.key()));
+            if (definition.maximumLevel() >= 2) {
+                text.append(' ').append(entry.level() >= 1 && entry.level() <= 10
+                        ? translate.apply("enchantment.level." + entry.level()) : Integer.toString(entry.level()));
+            }
+        }
+        return text.append("§r\n").toString();
+    }
+
+    private static String potion(final int auxiliary, final int mode, final float multiplier, final boolean arrow,
+                                 final ItemDescriptionContext context) {
+        final int selected = arrow ? auxiliary : auxiliary & 0xFFFF;
+        final var version = context.baseGameVersion().get();
+        if (selected < 0 || selected >= DATA.potions().size() || selected >= 43 && version.isLowerThan(NEW_POTIONS)) {
+            return "";
+        }
+        final var effects = DATA.potions().get(selected);
+        final StringBuilder text = new StringBuilder();
+        if (effects.isEmpty()) {
+            text.append(context.translate().apply("potion.empty"));
+        } else {
+            for (final var effect : effects) {
+                if (!text.isEmpty()) {
+                    text.append('\n');
+                }
+                text.append(effect(effect, mode, multiplier, version, context.translate()));
+            }
+        }
+        return arrow && text.isEmpty() ? "" : "§7" + text + "§r";
+    }
+
+    private static String stew(final int auxiliary, final ItemDescriptionContext context) {
+        final int selected = auxiliary & 0xFFFF;
+        return selected < DATA.stews().size() ? "§7" + effect(DATA.stews().get(selected), 0, 1F,
+                BaseGameVersion.INVALID, context.translate()) + "§r" : "";
+    }
+
+    private static String ominous(final short auxiliary, final Function<String, String> translate) {
+        final int amplifier = Math.clamp(auxiliary, 0, 4);
+        return "§7" + translate.apply("effect.badOmen") + (amplifier > 0 ? " " + translate.apply("potion.potency." + amplifier) : "")
+                + " " + duration(120000, 0, 1F, BaseGameVersion.INVALID);
+    }
+
+    private static String effect(final Effect effect, final int mode, final float multiplier, final BaseGameVersion version,
+                                 final Function<String, String> translate) {
+        final String key = effect.key().contains("potion.") ? effect.key() : "potion." + effect.key();
+        final StringBuilder text = new StringBuilder(translate.apply(key)).append(' ');
+        final boolean potency = effect.amplifier() > 0 || effect.displayAmplifier();
+        if (effect.ticks() != -1 && effect.ticks() < 20) {
+            if (potency) {
+                text.append(translate.apply("potion.potency." + effect.amplifier()));
+            }
+        } else {
+            if (effect.amplifier() != 0 || effect.displayAmplifier()) {
+                if (potency) {
+                    text.append(translate.apply("potion.potency." + effect.amplifier()));
+                }
+                text.append(' ');
+            }
+            text.append(duration(effect.ticks(), mode, multiplier, version));
+        }
+        return text.toString();
+    }
+
+    private static String duration(final int ticks, final int mode, final float multiplier, final BaseGameVersion version) {
+        final float factor = mode == 2 ? 0.25F : mode == 1 ? version.isLowerThan(NEW_POTIONS) ? 0.75F : 1F : multiplier;
+        final float scaled = ticks * factor;
+        // cvttss2si yields INT_MIN for NaN and overflow; the native selector clamps values below -1.
+        final int converted = !Float.isFinite(scaled) || scaled >= 0x1p31F || scaled < -0x1p31F ? Integer.MIN_VALUE : (int) scaled;
+        final int selected = ticks == -1 ? -1 : !(factor > 0) || converted < -1 ? 0 : converted;
+        if (selected == -1) {
+            return "(effect.duration.infinite)";
+        }
+        final int seconds = selected / 20 % 60;
+        return "(" + selected / 1200 + ":" + (seconds < 10 ? "0" : "") + seconds + ")";
+    }
+
+    private static String shulker(final CompoundTag data, final ItemDescriptionContext context, final Predicate<BedrockItem> empty) {
+        if (data == null || !(data.get("Items") instanceof ListTag<?> entries)) {
+            return "";
+        }
+        final StringBuilder text = new StringBuilder();
+        for (int index = 0; index < Math.min(5, entries.size()); index++) {
+            if (entries.get(index) instanceof CompoundTag saved) {
+                final var stack = context.savedItem().apply(saved);
+                if (!empty.test(stack)) {
+                    if (index != 0) {
+                        text.append('\n');
+                    }
+                    text.append("§7").append(context.primaryName().apply(stack)).append(" x").append(stack.amount());
+                }
+            }
+        }
+        if (entries.size() > 5) {
+            text.append('\n').append(context.formatInteger().apply("container.shulkerboxContains", entries.size() - 5));
+        }
+        return text.isEmpty() ? "" : text.append("§r").toString();
+    }
+
+    private static Data load() {
+        try (var stream = BuiltinItemDescriptions.class.getResourceAsStream("/assets/viabedrock/data/bedrock/item_descriptions.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native item descriptions");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native item descriptions do not match the target protocol");
+            }
+            final var enchantments = data.getAsJsonArray("enchantments").asList().stream().map(JsonElement::getAsJsonObject)
+                    .map(entry -> new EnchantmentDefinition(entry.get("key").getAsString(), entry.get("category").getAsInt(),
+                            entry.get("maximumLevel").getAsInt())).toList();
+            final var potions = data.getAsJsonArray("potions").asList().stream()
+                    .map(entry -> entry.getAsJsonArray().asList().stream().map(JsonElement::getAsJsonObject).map(BuiltinItemDescriptions::effect).toList()).toList();
+            final var stews = data.getAsJsonArray("stews").asList().stream().map(JsonElement::getAsJsonObject).map(BuiltinItemDescriptions::effect).toList();
+            return new Data(enchantments, potions, stews);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native item descriptions", error);
+        }
+    }
+
+    private static Effect effect(final JsonObject entry) {
+        return new Effect(entry.get("key").getAsString(), entry.get("ticks").getAsInt(), entry.get("amplifier").getAsInt(),
+                entry.get("displayAmplifier").getAsBoolean());
+    }
+
+    private BuiltinItemDescriptions() { }
+
+    private record EnchantmentDefinition(String key, int category, int maximumLevel) { }
+
+    private record Enchantment(int id, int level) { }
+
+    private record Effect(String key, int ticks, int amplifier, boolean displayAmplifier) { }
+
+    private record Data(List<EnchantmentDefinition> enchantments, List<List<Effect>> potions, List<Effect> stews) { }
+
+}
