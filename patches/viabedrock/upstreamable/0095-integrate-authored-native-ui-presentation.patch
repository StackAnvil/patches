+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeHudPacketTest {
+
+    @Test
+    void negotiatesActionbarSeparatelyAndFlattensTextObjectsBeforeNativeDispatch() throws Exception {
+        Assumptions.assumeTrue(NativeHudPacketTest.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var resources = new ResourcePackStorage(List.of());
+        resources.setLoadedOnJavaClient();
+        final var channels = new ChannelStorage();
+        final Map<Class<?>, Object> storage = new HashMap<>();
+        storage.put(ResourcePackStorage.class, resources);
+        storage.put(ChannelStorage.class, channels);
+        storage.put(NativeHudTitleState.class, new NativeHudTitleState());
+        storage.put(NativeHudActionbarState.class, new NativeHudActionbarState());
+        final var user = mock(UserConnection.class);
+        when(user.get(any())).thenAnswer(call -> storage.get(call.getArgument(0)));
+        final var sent = new ArrayList<byte[]>();
+        final var protocol = new TestProtocol();
+        final String caption = UUID.randomUUID().toString();
+        final var leaf = new JsonObject();
+        leaf.addProperty("text", caption);
+        final var rawtext = new JsonArray();
+        rawtext.add(leaf);
+        final var object = new JsonObject();
+        object.add("rawtext", rawtext);
+        final var platform = mock(ViaBedrockPlatform.class);
+        when(platform.getLogger()).thenReturn(Logger.getAnonymousLogger());
+        try (var via = mockStatic(ViaBedrock.class);
+             var wrappers = mockStatic(PacketWrapper.class)) {
+            via.when(ViaBedrock::getPlatform).thenReturn(platform);
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenAnswer(call -> {
+                final var payload = spy(new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, null, user));
+                doAnswer(send -> {
+                    final var buffer = Unpooled.buffer();
+                    try {
+                        payload.writeToBuffer(buffer);
+                        final byte[] bytes = new byte[buffer.readableBytes()];
+                        buffer.readBytes(bytes);
+                        sent.add(bytes);
+                    } finally {
+                        buffer.release();
+                    }
+                    return null;
+                }).when(payload).send(BedrockProtocol.class);
+                return payload;
+            });
+            for (final var capabilities : List.of(List.<String>of(), List.of(NativeHudMessage.CHANNEL), List.of("viabedrock:native_hud_actionbar"))) {
+                channels.addChannels(capabilities);
+                final var packet = translate(protocol, user, SetTitlePacket_TitleType.ActionbarTextObject, object.toString());
+                assertFalse(packet.isCancelled());
+                assertEquals(ClientboundPackets26_3.SET_ACTION_BAR_TEXT, packet.getPacketType());
+                assertTrue(sent.isEmpty());
+            }
+            channels.addChannels(List.of(NativeHudMessage.ACTIONBAR_CHANNEL));
+            assertTrue(translate(protocol, user, SetTitlePacket_TitleType.ActionbarTextObject, object.toString()).isCancelled());
+            assertEquals(1, sent.size());
+            final var buffer = Unpooled.wrappedBuffer(sent.getFirst());
+            try {
+                assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD.getId(), Types.VAR_INT.readPrimitive(buffer));
+                assertEquals(NativeHudMessage.ACTIONBAR_CHANNEL, Types.STRING.read(buffer));
+                final var message = NativeHudMessage.TYPE.read(buffer);
+                assertEquals(NativeHudMessage.ANIMATION_LIFETIME, message.ticks());
+                assertTrue(message.restart());
+                final var nodes = new ArrayList<JsonObject>();
+                collect(JsonParser.parseString(message.scene()).getAsJsonObject().getAsJsonObject("root"), nodes);
+                assertEquals(List.of(caption), nodes.stream().filter(n -> n.has("text")).map(n -> n.get("text").getAsString()).toList());
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+            translate(protocol, user, SetTitlePacket_TitleType.Clear, "");
+            assertEquals(1, sent.size());
+            assertTrue(translate(protocol, user, SetTitlePacket_TitleType.Actionbar, "").isCancelled());
+            assertEquals(1, sent.size());
+        }
+    }
+
+    private static PacketWrapper translate(final TestProtocol protocol, final UserConnection user,
+                                           final SetTitlePacket_TitleType type, final String text) throws Exception {
+        final var input = Unpooled.buffer();
+        try {
+            BedrockTypes.VAR_INT.write(input, type.getValue());
+            BedrockTypes.STRING.write(input, text);
+            for (int i = 0; i < 3; i++) {
+                BedrockTypes.VAR_INT.write(input, 0);
+            }
+            for (int i = 0; i < 3; i++) {
+                BedrockTypes.STRING.write(input, "");
+            }
+            final var packet = new PacketWrapperImpl(ClientboundBedrockPackets.SET_TITLE, input, user);
+            final var mapping = protocol.mapping(packet);
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+            assertFalse(input.isReadable());
+            return packet;
+        } finally {
+            input.release();
+        }
+    }
+
+    private static void collect(final JsonObject node, final List<JsonObject> nodes) {
+        nodes.add(node);
+        for (final var child : node.getAsJsonArray("children")) {
+            collect(child.getAsJsonObject(), nodes);
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            HudPackets.register(this);
+        }
+
+        private PacketMapping mapping(final PacketWrapper packet) {
+            return this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+        }
+
+    }
+
+}
