+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.ItemStorageProperties;
+import org.junit.jupiter.api.Test;
+
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeItemStorageDataTest {
+
+    @Test
+    void cachedAndDynamicWeightsMatchTheOriginalNativeStorageProducer() throws Exception {
+        try (var stream = getClass().getResourceAsStream("/inventory/native-item-storage.json")) {
+            assertNotNull(stream);
+            final var fixture = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var element : fixture.getAsJsonArray("rows")) {
+                final var row = element.getAsJsonObject();
+                final var source = new FixtureSource();
+                final var item = source.item(row.getAsJsonObject("input"));
+                for (final var entry : row.getAsJsonObject("containers").entrySet()) {
+                    source.containers.put(Integer.parseInt(entry.getKey()), entry.getValue().getAsJsonArray().asList().stream()
+                            .map(value -> source.item(value.getAsJsonObject())).toArray(BedrockItem[]::new));
+                }
+                final var expected = row.getAsJsonObject("expected");
+                final var actual = NativeItemStorageData.resolve(item, source);
+                if (!expected.get("valid").getAsBoolean()) {
+                    assertNull(actual, row.toString());
+                    continue;
+                }
+                final var nativeValue = new NativeItemStorageData(expected.get("base").getAsInt(),
+                        expected.get("weight").getAsInt(), expected.get("limit").getAsInt());
+                assertEquals(nativeValue, actual, row.toString());
+                assertEquals(nativeValue, NativeItemStorageData.fromTag(actual.toTag()));
+            }
+        }
+    }
+
+    @Test
+    void cyclicContentsRemainUnknownInsteadOfPublishingAnEmptyBundle() {
+        final var source = new FixtureSource();
+        final var specification = JsonParser.parseString("""
+                {"amount":1,"storage":true,"modifier":4,"capacity":64,"maximum":1,"supported":true,"tag":{"bundle_id":9}}
+                """).getAsJsonObject();
+        final var item = source.item(specification);
+        source.containers.put(9, new BedrockItem[]{item});
+        assertNull(NativeItemStorageData.resolve(item, source));
+    }
+
+    private static final class FixtureSource implements NativeItemStorageData.Source {
+        private final Map<BedrockItem, JsonObject> properties = new IdentityHashMap<>();
+        private final Map<Integer, BedrockItem[]> containers = new HashMap<>();
+
+        private BedrockItem item(final JsonObject input) {
+            final var tag = new CompoundTag();
+            if (!input.get("tag").isJsonNull()) {
+                input.getAsJsonObject("tag").entrySet().forEach(entry -> tag.putInt(entry.getKey(), entry.getValue().getAsInt()));
+            }
+            final var item = new BedrockItem(1, (short) 0, (byte) input.get("amount").getAsInt(), tag);
+            this.properties.put(item, input);
+            return item;
+        }
+
+        @Override
+        public ItemStorageProperties properties(final BedrockItem item) {
+            final var input = this.properties.get(item);
+            return new ItemStorageProperties(input.get("storage").getAsBoolean() && input.get("supported").getAsBoolean(),
+                    input.get("modifier").isJsonNull() ? null : input.get("modifier").getAsInt(),
+                    input.get("capacity").isJsonNull() ? null : input.get("capacity").getAsInt());
+        }
+
+        @Override
+        public BedrockItem[] contents(final int identity) {
+            return this.containers.get(identity);
+        }
+
+        @Override
+        public int maximum(final BedrockItem item) {
+            return this.properties.get(item).get("maximum").getAsInt();
+        }
+    }
+
+}
