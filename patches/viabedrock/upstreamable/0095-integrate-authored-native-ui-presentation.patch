+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.container;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.DoubleTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.Tag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Function;
+
+/** Native item queries compare network-loaded stacks in one stable connection registry. */
+public final class NativeItemStackMatcher {
+
+    public static boolean matches(final BedrockItem query, final BedrockItem candidate,
+                                  final Function<Integer, ?> blocks, final Function<String[], Set<String>> restrictions) {
+        if (query == null || candidate == null || query.isEmpty() || candidate.isEmpty()
+                || query.identifier() != candidate.identifier()
+                || query.data() != candidate.data() && query.data() != Short.MAX_VALUE && candidate.data() != Short.MAX_VALUE) {
+            return false;
+        }
+        if (query.hasBlockState()) {
+            final Object block = blocks.apply(query.blockRuntimeId());
+            if (!candidate.hasBlockState() || block == null || block != blocks.apply(candidate.blockRuntimeId())) {
+                return false;
+            }
+        }
+        // The full network userdata also determines chargedItem construction in the same registry.
+        // Do not use this comparison for native stacks whose child has been mutated independently.
+        return userDataEqual(query.tag(), candidate.tag())
+                && query.blockingTicks() == candidate.blockingTicks()
+                && restrictions.apply(query.canPlace()).equals(restrictions.apply(candidate.canPlace()))
+                && restrictions.apply(query.canBreak()).equals(restrictions.apply(candidate.canBreak()));
+    }
+
+    static boolean userDataEqual(final CompoundTag first, final CompoundTag second) {
+        if (first == null) {
+            return second == null || second.isEmpty();
+        }
+        return second == null ? first.isEmpty() : tagsEqual(first, second);
+    }
+
+    /** Native Tag equality uses numeric floating comparison and retains empty-list element types. */
+    static boolean tagsEqual(final Tag first, final Tag second) {
+        if (first == null || second == null || first.getClass() != second.getClass()) {
+            return false;
+        }
+        return switch (first) {
+            case FloatTag value -> value.asFloat() == ((FloatTag) second).asFloat();
+            case DoubleTag value -> value.asDouble() == ((DoubleTag) second).asDouble();
+            case ListTag<?> values -> {
+                final var other = (ListTag<?>) second;
+                boolean equal = Objects.equals(values.getElementType(), other.getElementType()) && values.size() == other.size();
+                for (int index = 0; equal && index < values.size(); index++) {
+                    equal = tagsEqual(values.get(index), other.get(index));
+                }
+                yield equal;
+            }
+            case CompoundTag values -> {
+                final var other = (CompoundTag) second;
+                boolean equal = values.keySet().equals(other.keySet());
+                for (final String key : values.keySet()) {
+                    if (!equal || !tagsEqual(values.get(key), other.get(key))) {
+                        equal = false;
+                        break;
+                    }
+                }
+                yield equal;
+            }
+            default -> first.equals(second);
+        };
+    }
+
+    private NativeItemStackMatcher() {
+    }
+
+}
