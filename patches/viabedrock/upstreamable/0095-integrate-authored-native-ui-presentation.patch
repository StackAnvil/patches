+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.LongTag;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemRegistryTest {
+
+    @Test
+    void stackSizeConstructionFinishesBeforeOrderedUpdatesIncludingInvalidIds() {
+        final String identifier = "test:component";
+        final var compiled = new CompoundTag();
+        compiled.putInt("max_stack_size", 16);
+        final var first = new CompoundTag();
+        first.put("item_properties", compiled);
+        final var named = new CompoundTag();
+        named.putByte("value", (byte) 32);
+        final var second = new CompoundTag();
+        second.put("minecraft:max_stack_size", named);
+        final var last = new CompoundTag();
+        last.put("item_properties", new CompoundTag());
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                componentEntry(identifier, 20, ItemVersion.None, first),
+                entry(identifier, 21, false, ItemVersion.DataDriven),
+                componentEntry(identifier, -1, ItemVersion.None, second),
+                componentEntry(identifier, 22, ItemVersion.DataDriven, last),
+                entry(identifier, 23, false, ItemVersion.None)});
+        final var sizes = registry.stackingProperties();
+        assertEquals(Map.of(identifier, new ComponentItemStackingProperties(0, 32, false, false)), sizes);
+        assertEquals(23, registry.ids().get(identifier));
+        assertThrows(UnsupportedOperationException.class, sizes::clear);
+    }
+
+    @Test
+    void runtimeFallbackDoesNotReceiveEarlierUpdatesAndConstructedFactoriesKeepTheSize() {
+        final var properties = new CompoundTag();
+        properties.putInt("max_stack_size", 1);
+        final var components = new CompoundTag();
+        components.put("item_properties", properties);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                componentEntry("test:fallback", 20, ItemVersion.None, components),
+                entry("test:fallback", 21, false, ItemVersion.None),
+                componentEntry("test:legacy", 22, ItemVersion.DataDriven, components),
+                entry("test:legacy", 23, true, ItemVersion.Legacy),
+                componentEntry("test:removed", 24, ItemVersion.DataDriven, components),
+                entry("test:owner", 24, false, ItemVersion.DataDriven),
+                entry("test:invalid", -1, true, ItemVersion.DataDriven)});
+        assertEquals(Map.of("test:fallback", ComponentItemStackingProperties.DEFAULT, "test:owner", ComponentItemStackingProperties.DEFAULT, "test:legacy", new ComponentItemStackingProperties(1, null, false, false)), registry.stackingProperties());
+    }
+
+    @Test
+    void firstComponentFactoryReceivesLaterLegacyUpdatesUsingItsOwnLayout() {
+        final var compiled = new CompoundTag();
+        compiled.putInt("max_stack_size", 1);
+        final var componentUpdate = new CompoundTag();
+        componentUpdate.put("item_properties", compiled);
+        componentUpdate.put("minecraft:durability", new CompoundTag());
+        final var legacyUpdate = new CompoundTag();
+        legacyUpdate.putInt("minecraft:max_stack_size", 16);
+        legacyUpdate.putByte("minecraft:stacked_by_data", (byte) 1);
+        legacyUpdate.putInt("minecraft:max_damage", 65537);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                componentEntry("test:item", 20, ItemVersion.DataDriven, componentUpdate),
+                componentEntry("test:item", -1, ItemVersion.None, legacyUpdate),
+                entry("test:item", 21, true, ItemVersion.Legacy),
+                entry("test:item", 22, false, ItemVersion.None)});
+        assertEquals(Map.of("test:item", new ComponentItemStackingProperties(1, null, false, true)), registry.stackingProperties());
+        assertEquals(Set.of("test:item"), registry.componentItems());
+        assertEquals(22, registry.ids().get("test:item"));
+    }
+
+    @Test
+    void firstLegacyFactorySurvivesLaterComponentRegistrationAndKeepsItsLayout() {
+        final var legacy = new CompoundTag();
+        legacy.putInt("minecraft:max_stack_size", 32);
+        legacy.putByte("minecraft:stacked_by_data", (byte) 1);
+        legacy.putInt("minecraft:max_damage", 20);
+        final var compiled = new CompoundTag();
+        compiled.putInt("max_stack_size", 16);
+        final var component = new CompoundTag();
+        component.put("item_properties", compiled);
+        component.put("minecraft:durability", new CompoundTag());
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                componentEntry("test:item", 20, ItemVersion.Legacy, legacy),
+                componentEntry("test:item", 21, ItemVersion.DataDriven, component)});
+        assertEquals(Map.of("test:item", new LegacyItemStackingProperties(32, true, (short) 20)),
+                registry.stackingProperties());
+        assertTrue(registry.componentItems().isEmpty());
+        assertEquals(21, registry.ids().get("test:item"));
+    }
+
+    @Test
+    void lateOrdinaryFallbackConstructionDoesNotConsumeEarlierLegacyUpdates() {
+        final var update = new CompoundTag();
+        update.putInt("minecraft:max_stack_size", 16);
+        update.putInt("minecraft:max_damage", 64);
+        final var data = new CompoundTag();
+        data.put("components", update);
+        final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("test:item", 20, false, ItemVersion.None, data)});
+        assertEquals(Map.of("test:item", LegacyItemStackingProperties.DEFAULT), registry.stackingProperties());
+    }
+
+    @Test
+    void networkConstructionReplacesBuiltinStackSizeState() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                entry("minecraft:apple", 20, true, ItemVersion.None),
+                entry("minecraft:stone", 21, true, ItemVersion.None),
+                entry("minecraft:diamond_sword", 22, false, ItemVersion.DataDriven)});
+        assertEquals(Map.of("minecraft:apple", LegacyItemStackingProperties.DEFAULT,
+                "minecraft:stone", LegacyItemStackingProperties.DEFAULT,
+                "minecraft:diamond_sword", ComponentItemStackingProperties.DEFAULT), registry.stackingProperties());
+    }
+
+    @Test
+    void legacyRegistrationKeepsBuiltinDurabilityAndSubtypeDefaults() {
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                entry("minecraft:netherite_sword", 20, false, ItemVersion.Legacy),
+                entry("minecraft:fishing_rod", 21, false, ItemVersion.Legacy),
+                entry("minecraft:arrow", 22, false, ItemVersion.Legacy)});
+        final var properties = registry.stackingProperties();
+        assertEquals(new LegacyItemStackingProperties(1, false, (short) 2031), properties.get("minecraft:netherite_sword"));
+        assertEquals(new ComponentItemStackingProperties(1, null, false, true), properties.get("minecraft:fishing_rod"));
+        assertEquals(new ComponentItemStackingProperties(64, null, true, false), properties.get("minecraft:arrow"));
+        assertEquals(Set.of("minecraft:fishing_rod", "minecraft:arrow"), registry.componentItems());
+    }
+
+    @Test
+    void builtinOverridesSurviveNoneUpdatesButExplicitComponentConstructionReplacesThem() {
+        final var update = new CompoundTag();
+        update.putInt("minecraft:max_stack_size", 32);
+        update.putByte("minecraft:stacked_by_data", (byte) 0);
+        final var registry = new ItemRegistry(new ItemEntry[]{
+                componentEntry("minecraft:birch_boat", 20, ItemVersion.None, update),
+                componentEntry("minecraft:bucket", 21, ItemVersion.Legacy, update),
+                componentEntry("minecraft:milk_bucket", 22, ItemVersion.None, update),
+                entry("minecraft:spruce_boat", 23, false, ItemVersion.DataDriven),
+                entry("minecraft:lava_bucket", 24, false, ItemVersion.DataDriven)});
+        final var properties = registry.stackingProperties();
+        assertEquals(32, properties.get("minecraft:birch_boat").maximum());
+        assertTrue(properties.get("minecraft:birch_boat").stackedByData());
+        assertEquals(16, properties.get("minecraft:bucket").maximum());
+        assertFalse(properties.get("minecraft:bucket").stackedByData());
+        assertEquals(1, properties.get("minecraft:milk_bucket").maximum());
+        assertFalse(properties.get("minecraft:milk_bucket").stackedByData());
+        assertEquals(ComponentItemStackingProperties.DEFAULT, properties.get("minecraft:spruce_boat"));
+        assertEquals(ComponentItemStackingProperties.DEFAULT, properties.get("minecraft:lava_bucket"));
+    }
+
+    private static ItemEntry componentEntry(final String identifier, final int id, final ItemVersion version, final CompoundTag components) {
+        final var data = new CompoundTag();
+        data.put("components", components);
+        return new ItemEntry(identifier, id, true, version, data);
+    }
+
+    @Test
+    void idReplacementRemovesThePreviousDefinitionsAndComponentMembership() {
+        final var first = entry("test:first", -7, true, ItemVersion.DataDriven);
+        final var moved = entry(first.identifier(), 20, false, ItemVersion.None);
+        final var replacement = entry("test:replacement", 20, false, ItemVersion.Legacy);
+        final var reused = entry("test:reused", -7, true, ItemVersion.None);
+        final var registry = new ItemRegistry(new ItemEntry[]{first, moved, replacement, reused});
+
+        assertNull(registry.definition(first.identifier()));
+        assertSame(replacement, registry.definition(20));
+        assertSame(reused, registry.definition(-7));
+        assertEquals(List.of(replacement, reused), registry.entries());
+        assertEquals(List.of(first, moved, replacement, reused), registry.registrations());
+        assertEquals(Map.of(replacement.identifier(), 20, reused.identifier(), -7), registry.ids());
+        assertEquals(Set.of(reused.identifier()), registry.componentItems());
+        assertThrows(UnsupportedOperationException.class, () -> registry.ids().inverse().remove(20));
+        assertThrows(UnsupportedOperationException.class, () -> registry.entries().clear());
+        assertThrows(UnsupportedOperationException.class, () -> registry.componentItems().clear());
+    }
+
+    @Test
+    void repeatedNamesKeepOnlyTheLastOwnerAndItsActualVersion() {
+        final var component = entry("test:item", 50, false, ItemVersion.DataDriven);
+        final var legacy = entry(component.identifier(), 51, true, ItemVersion.Legacy);
+        final ItemEntry[] input = {component, legacy};
+        final var registry = new ItemRegistry(input);
+        input[1] = component;
+
+        assertNull(registry.definition(50));
+        assertSame(legacy, registry.definition(51));
+        assertSame(legacy, registry.definition(legacy.identifier()));
+        assertEquals(List.of(legacy), registry.entries());
+        assertEquals(List.of(component, legacy), registry.registrations());
+        assertThrows(UnsupportedOperationException.class, () -> registry.registrations().clear());
+        assertEquals(Set.of("test:item"), registry.componentItems());
+    }
+
+    @Test
+    void runtimeIdFallbackConstructsUnknownReferences() {
+        final var builtin = entry("minecraft:hopper", 50, true, ItemVersion.None);
+        final var reference = entry("test:unknown", 51, true, ItemVersion.None);
+        final var legacy = entry("test:legacy", 52, true, ItemVersion.Legacy);
+        final var component = entry("test:component", 53, false, ItemVersion.DataDriven);
+        final var registry = new ItemRegistry(new ItemEntry[]{builtin, reference, legacy, component});
+
+        assertSame(builtin, registry.definition(50));
+        assertSame(reference, registry.definition(51));
+        assertSame(legacy, registry.definition(52));
+        assertSame(component, registry.definition(53));
+        assertNull(registry.definition(54));
+
+        final var laterReference = entry(legacy.identifier(), 54, false, ItemVersion.None);
+        final var replacedRegistry = new ItemRegistry(new ItemEntry[]{legacy, laterReference});
+        assertNull(replacedRegistry.definition(52));
+        assertSame(laterReference, replacedRegistry.definition(54));
+    }
+
+    @Test
+    void completeNetworkDefinitionsRemainStableAcrossInputAndConsumerMutation() {
+        final var flags = new CompoundTag();
+        flags.put("replaceBlockItem", new ByteTag((byte) 255));
+        final var opaqueValues = new ListTag<>(LongTag.class);
+        opaqueValues.add(new LongTag(Long.MIN_VALUE));
+        flags.put("opaque", opaqueValues);
+        final var components = new CompoundTag();
+        components.put("minecraft:block_placer", flags);
+        final var data = new CompoundTag();
+        data.put("components", components);
+        final var definition = new ItemEntry("test:item", 19, true, ItemVersion.DataDriven, data);
+        final var registry = new ItemRegistry(new ItemEntry[]{definition});
+        final var expected = data.copy();
+
+        flags.remove("replaceBlockItem");
+        opaqueValues.getValue().clear();
+        data.getValue().clear();
+        definition.componentData().getValue().clear();
+        registry.definition(19).componentData().getCompoundTag("components").getValue().clear();
+
+        assertEquals(expected, registry.definition(19).componentData());
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.ITEM_ENTRY.write(buffer, registry.definition(19));
+            final var decoded = BedrockTypes.ITEM_ENTRY.read(buffer);
+            assertEquals(definition, decoded);
+            assertEquals(0, buffer.readableBytes());
+            decoded.componentData().getValue().clear();
+            assertEquals(expected, decoded.componentData());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void missingDataAndUnknownIdsDoNotAcquireDefinitions() {
+        final var definition = entry("test:item", 32767, false, ItemVersion.None);
+        final var registry = new ItemRegistry(new ItemEntry[]{definition});
+        assertNull(registry.definition(32767).componentData());
+        assertNull(registry.definition(0));
+        assertNull(registry.definition("test:missing"));
+        assertTrue(new ItemRegistry(new ItemEntry[0]).entries().isEmpty());
+    }
+
+    @Test
+    void legacyReferencesPreserveExistingBuiltinFactoriesAndTheirComponentLayout() {
+        final String identifier = "minecraft:hopper";
+        final var flat = new CompoundTag();
+        flat.putInt("minecraft:max_stack_size", 32);
+        final var registry = new ItemRegistry(new ItemEntry[]{componentEntry(identifier, 20, ItemVersion.Legacy, flat)});
+        assertEquals(Set.of(identifier), registry.componentItems());
+        assertEquals(Map.of(identifier, ComponentItemStackingProperties.DEFAULT), registry.stackingProperties());
+    }
+
+    @Test
+    void advertisedItemsDoNotBecomeBuiltinFactoriesBeforeNetworkConstruction() {
+        for (final boolean flag : new boolean[]{false, true}) {
+            final var properties = new CompoundTag();
+            properties.putInt("max_stack_size", 1);
+            final var components = new CompoundTag();
+            components.put("item_properties", properties);
+            final var data = new CompoundTag();
+            data.put("components", components);
+            final var registry = new ItemRegistry(new ItemEntry[]{new ItemEntry("minecraft:bundle", 20, flag, ItemVersion.None, data)});
+            assertEquals(flag ? Set.of("minecraft:bundle") : Set.of(), registry.componentItems());
+            assertEquals(flag ? ComponentItemStackingProperties.DEFAULT : LegacyItemStackingProperties.DEFAULT,
+                    registry.stackingProperties().get("minecraft:bundle"));
+        }
+        final var apple = new ItemRegistry(new ItemEntry[]{entry("minecraft:apple", 20, true, ItemVersion.None)});
+        assertTrue(apple.componentItems().isEmpty());
+    }
+
+    private static ItemEntry entry(final String identifier, final int id, final boolean componentBased, final ItemVersion version) {
+        return new ItemEntry(identifier, id, componentBased, version, null);
+    }
+
+}
