--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/NativeItemDefinitions.java
@@ -0,0 +1,309 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemVersion;
+import net.raphimc.viabedrock.api.util.Fnv1;
+import net.raphimc.viabedrock.api.util.NativeStringMap;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.UnaryOperator;
+
+/** Constructor-owned definition identities and the independent native lookup tables. */
+public final class NativeItemDefinitions<T> {
+
+    private final NativeStringMap<Definition<T>> ordinary = new NativeStringMap<>(Fnv1::fnv1_64);
+    private final Map<String, Definition<T>> priority = new HashMap<>();
+    private final Map<String, Definition<T>> fallback = new HashMap<>();
+    private final Map<Integer, Definition<T>> numeric = new HashMap<>();
+    private final List<Definition<T>> owned = new ArrayList<>();
+    private final List<Definition<T>> spares = new ArrayList<>();
+    private final UnaryOperator<NativeItemName> rewrite;
+    private short counter;
+    private boolean constructing;
+
+    public NativeItemDefinitions(final Bootstrap<T> bootstrap, final List<ItemEntry> entries,
+                                 final Factory<T> factory, final UnaryOperator<NativeItemName> rewrite) {
+        Objects.requireNonNull(bootstrap);
+        Objects.requireNonNull(factory);
+        final List<ItemEntry> registrations = List.copyOf(entries);
+        this.rewrite = Objects.requireNonNull(rewrite);
+        this.counter = (short) bootstrap.counter();
+        this.constructing = true;
+        final Builder builder = new Builder();
+        for (final Seed<T> seed : bootstrap.initial()) {
+            builder.register(seed);
+        }
+        final Map<String, Definition<T>> staged = new LinkedHashMap<>();
+        for (final Seed<T> seed : bootstrap.staged()) {
+            if (staged.putIfAbsent(seed.key(), new Definition<>(seed)) != null) {
+                throw new IllegalArgumentException("Duplicate staged factory key: " + seed.key());
+            }
+        }
+        for (final ItemEntry entry : registrations) {
+            if (entry.version() == ItemVersion.DataDriven) {
+                final Definition<T> replaced = staged.remove(entry.identifier());
+                if (replaced != null) {
+                    this.spares.add(replaced);
+                }
+                this.counter++;
+                this.construct(factory.construct(ItemVersion.DataDriven, entry.identifier(), this.counter), entry.identifier());
+            } else if (entry.version() == ItemVersion.Legacy) {
+                final Definition<T> selected = staged.remove(entry.identifier());
+                if (selected != null) {
+                    this.register(selected);
+                } else {
+                    this.counter++;
+                    this.construct(factory.construct(ItemVersion.Legacy, entry.identifier(), this.counter), entry.identifier());
+                }
+            }
+        }
+        for (final Definition<T> definition : staged.values()) {
+            this.register(definition);
+        }
+        for (final ItemEntry entry : registrations) {
+            final Definition<T> definition = this.ordinary.get(entry.identifier());
+            final CompoundTag data = entry.componentData();
+            if (definition != null && data != null && data.get("components") instanceof CompoundTag components) {
+                factory.readComponents(definition, components);
+            }
+        }
+        factory.complete(builder);
+        this.numeric.clear();
+        for (final ItemEntry entry : registrations) {
+            final short identifier = (short) entry.id();
+            if (identifier == -1) {
+                continue;
+            }
+            final Definition<T> definition = this.direct(entry.identifier());
+            if (definition == null) {
+                this.construct(factory.construct(entry.componentBased() ? ItemVersion.DataDriven : ItemVersion.Legacy,
+                        entry.identifier(), identifier), entry.identifier());
+            } else {
+                final Definition<T> previous = this.numeric(definition.id);
+                this.numeric.put((int) definition.id, null);
+                definition.id = identifier;
+                this.numeric.put((int) identifier, previous);
+            }
+        }
+        for (final Definition<T> definition : this.ordinary.values()) {
+            if (definition.id == -1) {
+                this.remove(definition);
+            } else {
+                this.numeric.put((int) definition.id, definition);
+            }
+        }
+        this.constructing = false;
+    }
+
+    public Definition<T> exact(final String name) {
+        return this.ordinary.get(name);
+    }
+
+    public Definition<T> numeric(final int identifier) {
+        final short narrowed = (short) identifier;
+        return narrowed == 0 || narrowed == -1 ? null : this.numeric.get((int) narrowed);
+    }
+
+    public Definition<T> priority(final String identifier) {
+        return this.priority.get(identifier);
+    }
+
+    /** Parse a saved name without invoking the legacy metadata fallback. */
+    public Definition<T> direct(final String name) {
+        final NativeItemName parsed = NativeItemName.parse(name, 0);
+        if (parsed == null) {
+            return null;
+        }
+        final Definition<T> preferred = this.priority.get(parsed.identifier());
+        return preferred != null ? preferred : this.ordinaryOrFallback(parsed.identifier());
+    }
+
+    /** Resolve a definition and its auxiliary before class-specific ItemStack construction. */
+    public Lookup<T> lookup(final String name, final int auxiliary) {
+        final NativeItemName parsed = NativeItemName.parse(name, auxiliary);
+        if (parsed == null) {
+            return new Lookup<>(null, auxiliary);
+        }
+        return this.lookup(parsed);
+    }
+
+    /** Canonical construction already has an Item name and must not parse legacy spelling again. */
+    public Lookup<T> lookup(final NativeItemName parsed) {
+        Objects.requireNonNull(parsed);
+        final Definition<T> preferred = this.priority.get(parsed.identifier());
+        if (preferred != null) {
+            return new Lookup<>(preferred, parsed.auxiliary());
+        }
+        final NativeItemName rewritten = Objects.requireNonNull(this.rewrite.apply(parsed));
+        // An empty callback result means no rewrite, including no auxiliary update.
+        final NativeItemName selected = rewritten.identifier().isEmpty() ? parsed : rewritten;
+        return new Lookup<>(this.ordinaryOrFallback(selected.identifier()), selected.auxiliary());
+    }
+
+    public int constructorCounter() {
+        return Short.toUnsignedInt(this.counter);
+    }
+
+    public List<Definition<T>> definitions() {
+        return this.ordinary.values();
+    }
+
+    public List<Definition<T>> ownedDefinitions() {
+        return List.copyOf(this.owned);
+    }
+
+    public List<Definition<T>> spareDefinitions() {
+        return List.copyOf(this.spares);
+    }
+
+    private Definition<T> ordinaryOrFallback(final String name) {
+        final Definition<T> definition = this.ordinary.get(name);
+        return definition != null ? definition : this.fallback.get(name);
+    }
+
+    private Definition<T> construct(final Seed<T> seed, final String rawName) {
+        final Definition<T> definition = new Definition<>(seed);
+        if (this.lookup(rawName, 0).definition() != null) {
+            this.spares.add(definition);
+        } else {
+            this.register(definition);
+        }
+        return definition;
+    }
+
+    private void register(final Definition<T> definition) {
+        this.numeric.put((int) definition.id, definition);
+        this.ordinary.put(definition.identifier, definition);
+        final int separator = definition.identifier.indexOf(':');
+        if (separator < 0) {
+            throw new IllegalArgumentException("A constructed definition must have a namespace");
+        }
+        final String namespace = definition.identifier.substring(0, separator);
+        final String name = definition.identifier.substring(separator + 1);
+        if (namespace.startsWith("tile.")) {
+            this.priority.put(namespace.substring(5) + ':' + name, definition);
+        }
+        if (name.startsWith("tile.")) {
+            this.fallback.put(namespace + ':' + name.substring(5), definition);
+        }
+        this.owned.add(definition);
+    }
+
+    private void remove(final Definition<T> definition) {
+        this.ordinary.remove(definition.identifier);
+        this.priority.values().removeIf(value -> value == definition);
+        this.fallback.values().removeIf(value -> value == definition);
+        this.numeric.put((int) definition.id, null);
+        for (int index = 0; index < this.owned.size(); index++) {
+            if (this.owned.get(index) == definition) {
+                final Definition<T> last = this.owned.removeLast();
+                if (index < this.owned.size()) {
+                    this.owned.set(index, last);
+                }
+            }
+        }
+    }
+
+    public record Seed<T>(String key, String identifier, int id, T receiver) {
+        public Seed {
+            Objects.requireNonNull(key);
+            Objects.requireNonNull(identifier);
+            Objects.requireNonNull(receiver);
+        }
+    }
+
+    public record Bootstrap<T>(int counter, List<Seed<T>> initial, List<Seed<T>> staged) {
+        public Bootstrap {
+            initial = List.copyOf(initial);
+            staged = List.copyOf(staged);
+        }
+    }
+
+    public interface Factory<T> {
+        Seed<T> construct(ItemVersion version, String rawName, short identifier);
+
+        void readComponents(Definition<T> definition, CompoundTag components);
+
+        void complete(NativeItemDefinitions<T>.Builder builder);
+    }
+
+    public static final class Definition<T> {
+        private final String identifier;
+        private final T receiver;
+        private short id;
+
+        private Definition(final Seed<T> seed) {
+            this.identifier = seed.identifier();
+            this.receiver = seed.receiver();
+            this.id = (short) seed.id();
+        }
+
+        public String identifier() {
+            return this.identifier;
+        }
+
+        public int id() {
+            return this.id;
+        }
+
+        public T receiver() {
+            return this.receiver;
+        }
+    }
+
+    public record Lookup<T>(Definition<T> definition, int auxiliary) { }
+
+    /** Factory and block producers share the live tables during original registration phases. */
+    public final class Builder {
+        private Builder() { }
+
+        public Definition<T> register(final Seed<T> seed) {
+            this.requireConstructing();
+            final Definition<T> definition = new Definition<>(seed);
+            NativeItemDefinitions.this.register(definition);
+            return definition;
+        }
+
+        public Definition<T> construct(final Seed<T> seed, final String rawName) {
+            this.requireConstructing();
+            return NativeItemDefinitions.this.construct(seed, rawName);
+        }
+
+        public Definition<T> numeric(final int identifier) {
+            this.requireConstructing();
+            return NativeItemDefinitions.this.numeric(identifier);
+        }
+
+        public Definition<T> exact(final String name) {
+            this.requireConstructing();
+            return NativeItemDefinitions.this.exact(name);
+        }
+
+        public Lookup<T> lookup(final String name, final int auxiliary) {
+            this.requireConstructing();
+            return NativeItemDefinitions.this.lookup(name, auxiliary);
+        }
+
+        public void bindNumeric(final int identifier, final Definition<T> definition) {
+            this.requireConstructing();
+            NativeItemDefinitions.this.numeric.put((int) (short) identifier, definition);
+        }
+
+        private void requireConstructing() {
+            if (!NativeItemDefinitions.this.constructing) {
+                throw new IllegalStateException("Definition construction is complete");
+            }
+        }
+    }
+
+}
