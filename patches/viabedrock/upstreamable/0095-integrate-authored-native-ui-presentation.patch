diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/BuiltinItemAliases.java b/src/main/java/net/raphimc/viabedrock/protocol/model/BuiltinItemAliases.java
new file mode 100644
index 00000000..d45c8933
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/BuiltinItemAliases.java
@@ -0,0 +1,136 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Constructor-owned ItemRegistry names, separate from block registry aliases and restriction groups. */
+final class BuiltinItemAliases {
+
+    private static final Tables TABLES = load();
+
+    private BuiltinItemAliases() { }
+
+    static boolean hasComplexAlias(final String name) {
+        return TABLES.members.containsKey(redirect(name));
+    }
+
+    static List<String> members(final String name) {
+        // The original getter returns its shared empty vector for an unregistered name.
+        return TABLES.members.getOrDefault(redirect(name), List.of());
+    }
+
+    static NativeItemName rewrite(final NativeItemName query) {
+        String redirected = TABLES.redirects.get(query.identifier());
+        final boolean metadataRedirect = redirected == null;
+        if (metadataRedirect) {
+            redirected = TABLES.redirects.get(query.identifier() + ':' + (query.auxiliary() == Short.MAX_VALUE ? 0 : query.auxiliary()));
+        }
+        final NativeItemName target = redirected != null ? NativeItemName.parse(redirected, query.auxiliary()) : query;
+        final Callback callback = TABLES.callbacks.get(target.identifier());
+        if (callback != null) {
+            return new NativeItemName(callback.target(target.auxiliary()), 0);
+        }
+        return redirected != null && metadataRedirect ? new NativeItemName(target.identifier(), 0) : target;
+    }
+
+    /** Prove that canonical Item selection does not need an unavailable Block auxiliary. */
+    static boolean metadataIndependent(final String identifier) {
+        final String redirected = TABLES.redirects.get(identifier);
+        if (redirected == null && TABLES.redirects.keySet().stream().anyMatch(key -> key.startsWith(identifier + ':'))) {
+            return false;
+        }
+        final NativeItemName target = redirected != null ? NativeItemName.parse(redirected, 0) : new NativeItemName(identifier, 0);
+        return !TABLES.callbacks.containsKey(target.identifier());
+    }
+
+    private static String redirect(final String name) {
+        // These getters apply one exact redirect, without legacy-name parsing or qualification.
+        return TABLES.redirects.getOrDefault(name, name);
+    }
+
+    private static Tables load() {
+        final String path = "/assets/viabedrock/data/bedrock/item_aliases.json";
+        try (var stream = BuiltinItemAliases.class.getResourceAsStream(path)) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native item alias definitions");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 2 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Item alias definitions do not match the target protocol");
+            }
+            final Map<String, String> redirects = new HashMap<>();
+            data.getAsJsonObject("redirects").entrySet().forEach(entry -> redirects.put(entry.getKey(), entry.getValue().getAsString()));
+            final Map<String, List<String>> members = new HashMap<>();
+            data.getAsJsonObject("complexAliases").entrySet().forEach(entry -> members.put(entry.getKey(), entry.getValue().getAsJsonArray().asList()
+                    .stream().map(value -> value.getAsString()).toList()));
+            final Map<String, Callback> callbacks = new HashMap<>();
+            data.getAsJsonObject("callbacks").entrySet().forEach(entry -> {
+                final var value = entry.getValue().getAsJsonObject();
+                final Kind kind = Kind.valueOf(value.get("kind").getAsString().toUpperCase(Locale.ROOT));
+                final List<String> values = kind == Kind.MEMBERS ? members.get(entry.getKey())
+                        : value.getAsJsonArray("values").asList().stream().map(target -> target.getAsString()).toList();
+                if (values == null || kind == Kind.MEMBERS && values.isEmpty()) {
+                    throw new IllegalStateException("Missing native alias callback values");
+                }
+                final String fallback = kind == Kind.MEMBERS ? values.getFirst() : value.get("fallback").getAsString();
+                final int guardLimit = kind == Kind.GUARDED_WORD || kind == Kind.SIGNED_REMAINDER ? value.get("guardLimit").getAsInt() : 0;
+                if (guardLimit < 0 || guardLimit > 255) {
+                    throw new IllegalStateException("Native alias callback guard exceeds its byte field");
+                }
+                callbacks.put(entry.getKey(), new Callback(kind, values, fallback, guardLimit));
+            });
+            if (!callbacks.keySet().equals(members.keySet()) || redirects.values().stream().anyMatch(String::isEmpty)) {
+                throw new IllegalStateException("Incomplete native item alias callbacks");
+            }
+            return new Tables(Map.copyOf(redirects), Map.copyOf(members), Map.copyOf(callbacks));
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native item alias definitions", error);
+        }
+    }
+
+    private record Tables(Map<String, String> redirects, Map<String, List<String>> members, Map<String, Callback> callbacks) { }
+
+    private enum Kind {
+        MEMBERS,
+        WORD,
+        GUARDED_WORD,
+        SIGNED_REMAINDER
+    }
+
+    private record Callback(Kind kind, List<String> values, String fallback, int guardLimit) {
+        private String target(final int auxiliary) {
+            final short narrowed = (short) auxiliary;
+            final int lowByte = narrowed & 0xFF;
+            final int index = switch (this.kind) {
+                case MEMBERS, WORD -> narrowed;
+                case GUARDED_WORD -> {
+                    if ((narrowed & 0xFFFF) >= 256 && lowByte < this.guardLimit) {
+                        throw new IllegalArgumentException("Metadata indexes outside native alias storage");
+                    }
+                    yield narrowed;
+                }
+                case SIGNED_REMAINDER -> {
+                    if (narrowed < 0 && lowByte < this.guardLimit && narrowed % 4 < 0) {
+                        throw new IllegalArgumentException("Metadata indexes outside native alias storage");
+                    }
+                    yield lowByte;
+                }
+            };
+            return index >= 0 && index < this.values.size() ? this.values.get(index) : this.fallback;
+        }
+    }
+
+}
