From c9068ce88bd30e6bffcc9285e9f030b0ff0a58b1 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 20:04:00 +0200
Subject: [PATCH] fix(entities): preserve omitted movement coordinates

Bedrock move-entity-delta packets may omit unchanged axes. When a local-player correction carried only some coordinates, the translator replaced every missing axis with zero and sent the wrong Java position. Merge only the supplied axes for both local and remote entities while preserving the existing rule that ignores non-forced local updates.
---
 .../protocol/packet/EntityPackets.java        | 19 +++++-------
 .../packet/EntityMovementPacketsTest.java     | 30 +++++++++++++++++++
 2 files changed, 37 insertions(+), 12 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/EntityMovementPacketsTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
index a0d38d68..94480649 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
@@ -70,6 +70,11 @@ public final class EntityPackets {
     private static final float PAINTING_POS_OFFSET = -0.46875F;
     private static final SwingAnimation DEFAULT_SWING_ANIMATION = new SwingAnimation(EnumTypes.SWING_ANIMATION1_21_11.idFromName("whack"), 6);
 
+    static Position3f mergePosition(final Position3f current, final boolean hasX, final float x,
+                                    final boolean hasY, final float y, final boolean hasZ, final float z) {
+        return new Position3f(hasX ? x : current.x(), hasY ? y : current.y(), hasZ ? z : current.z());
+    }
+
     public static void register(final BedrockProtocol protocol) {
         protocol.registerClientbound(ClientboundBedrockPackets.ADD_ENTITY, ClientboundPackets26_3.ADD_ENTITY, wrapper -> {
             final EntityTracker entityTracker = wrapper.user().get(EntityTracker.class);
@@ -271,9 +276,7 @@ public final class EntityPackets {
                     wrapper.cancel();
                     return;
                 }
-
-                entity.setPosition(new Position3f(x, y, z));
-
+                entity.setPosition(mergePosition(entity.position(), hasX, x, hasY, y, hasZ, z));
                 if (teleported) {
                     wrapper.setPacketType(ClientboundPackets26_3.PLAYER_POSITION);
                     entityTracker.getClientPlayer().writePlayerPositionPacketToClient(wrapper, Relative.union(Relative.ROTATION, Relative.VELOCITY), true);
@@ -292,15 +295,7 @@ public final class EntityPackets {
                 return;
             }
 
-            if (hasX) {
-                entity.setPosition(new Position3f(x, entity.position().y(), entity.position().z()));
-            }
-            if (hasY) {
-                entity.setPosition(new Position3f(entity.position().x(), y, entity.position().z()));
-            }
-            if (hasZ) {
-                entity.setPosition(new Position3f(entity.position().x(), entity.position().y(), z));
-            }
+            entity.setPosition(mergePosition(entity.position(), hasX, x, hasY, y, hasZ, z));
             if (hasPitch) {
                 entity.setRotation(new Position3f(MathUtil.byte2Float(pitch), entity.rotation().y(), entity.rotation().z()));
             }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/EntityMovementPacketsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/EntityMovementPacketsTest.java
new file mode 100644
index 00000000..d275dee5
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/EntityMovementPacketsTest.java
@@ -0,0 +1,30 @@
