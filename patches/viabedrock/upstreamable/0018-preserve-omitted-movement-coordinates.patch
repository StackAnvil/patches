+    private static Entity writeEntityMotion(final PacketWrapper wrapper, final long runtimeId, final Position3f motion) {
+        final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByRid(runtimeId);
+        if (entity == null) {
+            wrapper.cancel();
+            return null;
+        }
+        wrapper.write(Types.VAR_INT, entity.javaId()); // entity id
+        wrapper.write(Types.LOW_PRECISION_VECTOR, new Vector3d(motion.x(), motion.y(), motion.z())); // velocity
+        return entity;
+    }
+
     private EntityPackets() {
     }
 
