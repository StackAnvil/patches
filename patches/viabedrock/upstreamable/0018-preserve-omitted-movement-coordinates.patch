+            final Position3f motion = wrapper.read(BedrockTypes.POSITION_3F); // motion
+            final boolean onGround = wrapper.read(Types.BOOLEAN); // on ground
+            final Entity entity = writeEntityMotion(wrapper, entityRuntimeId, motion);
