From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 28 Nov 2026 12:03:54 +0100
Subject: [PATCH] fix(entities): stop warning about variants that pack entities
 read

The metadata rewriter warned about every non-zero VARIANT on an entity type
without a Java variant mapping. Pack entities are not unsupported: their
render controllers and pre-animation read the value as query.variant. The
Hive's studio lights send pan and tilt through it on every update, which
logged thousands of warnings per minute during Block Party. Vanilla types
without a mapping still warn.

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
index c5ab20dee0ef0d8c769b099ec3f1aee381ad3158..202f1a4157bfd8914f9ded15a686c8f2a028d4d5 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
@@ -35,6 +35,7 @@ import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets
 import com.viaversion.viaversion.util.Key;
 import net.raphimc.viabedrock.ViaBedrock;
 import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
 import net.raphimc.viabedrock.api.model.entity.Entity;
 import net.raphimc.viabedrock.api.model.entity.LivingEntity;
 import net.raphimc.viabedrock.api.util.TextUtil;
@@ -387,7 +388,8 @@ public final class EntityMetadataRewriter {
                         // The block state travels in the spawn data; Java has no metadata for it.
                     }
                     default -> {
-                        if (variant != 0) { // For some reason bedrock seems to send variant 0 for many entities that don't have variants
+                        // Pack entities read the value as query.variant, which The Hive's studio lights update every tick.
+                        if (variant != 0 && !(entity instanceof CustomEntity)) { // For some reason bedrock seems to send variant 0 for many entities that don't have variants
                             ViaBedrock.getPlatform().getLogger().warning("Received non-zero VARIANT " + variant + " for unsupported entity " + entity.type());
                         }
                     }
