+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PositionMode;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.lang.reflect.Proxy;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class PlayerHeadRotationPacketTest {
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void headOnlyMovementEncodesTheJavaRotationCodecOrder(final boolean onGround) throws Exception {
+        final EntityTracker[] trackers = new EntityTracker[1];
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) ->
+                        method.getName().equals("get") && args[0] == EntityTracker.class ? trackers[0] : null);
+        final EntityTracker tracker = trackers[0] = new EntityTracker(user);
+        final Entity player = tracker.addEntity(new Entity(user, 21, 101, "minecraft:player", 301,
+                UUID.randomUUID(), EntityTypes26_3.PLAYER), false);
+        final Position3f position = new Position3f(1F, 65F, 3F);
+        player.setPosition(position);
+        player.setRotation(new Position3f(0F, 90F, -45F));
+        player.setOnGround(onGround);
+
+        final ByteBuf input = Unpooled.buffer();
+        final ByteBuf output = Unpooled.buffer();
+        try {
+            BedrockTypes.UNSIGNED_VAR_LONG.write(input, player.runtimeId());
+            BedrockTypes.POSITION_3F.write(input, new Position3f(20F, 80F, 40F));
+            BedrockTypes.POSITION_3F.write(input, new Position3f(-22.5F, 180F, 135F));
+            Types.BYTE.write(input, (byte) PositionMode.OnlyHeadRot.getValue());
+            Types.BOOLEAN.write(input, !onGround);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(input, 0L);
+            Types.BOOLEAN.write(input, false);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(input, 123L);
+            final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.MOVE_PLAYER, input, user);
+
+            new TestProtocol().translate(packet);
+            packet.writeToBuffer(output);
+
+            assertEquals(ClientboundPackets26_3.MOVE_ENTITY_ROT.getId(), Types.VAR_INT.read(output));
+            // Java 26.3 ClientboundMoveEntityPacket.Rot reads id, onGround, yaw, pitch.
+            assertEquals(player.javaId(), Types.VAR_INT.read(output));
+            assertEquals(onGround, Types.BOOLEAN.read(output));
+            assertEquals((byte) 64, Types.BYTE.read(output));
+            assertEquals((byte) -16, Types.BYTE.read(output));
+            assertEquals(0, output.readableBytes());
+            assertEquals(0, input.readableBytes());
+            assertEquals(position, player.position());
+            assertEquals(new Position3f(-22.5F, 90F, -45F), player.rotation());
+            assertEquals(onGround, player.isOnGround());
+        } finally {
+            input.release();
+            output.release();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            OtherPlayerPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+    }
+
+}
