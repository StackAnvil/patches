From 0b76bce4018f728fd60fcb00401ed93b8da65585 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 2 Oct 2026 15:16:26 +0200
Subject: [PATCH] fix(players): encode head rotation in Java 26.3 field order

Java 26.3 ClientboundMoveEntityPacket.Rot.STREAM_CODEC reads and writes
entity ID, on-ground boolean, yaw byte, then pitch byte. The Bedrock
OnlyHeadRot translation retained the older order with on-ground last,
so the client consumed the source pitch as yaw and the boolean as pitch.
Actual Hive seated-player observations confirmed the failure: a captured
25.15747-degree pitch became a 23.90625-degree Java yaw, while on-ground
true became a 1.40625-degree pitch. This changes only the Java wire order;
retained body/head rotation, position and ground-state semantics stay as
upstream currently implements them.
---
 .../protocol/packet/OtherPlayerPackets.java   |   2 +-
 .../packet/PlayerHeadRotationPacketTest.java  | 100 ++++++++++++++++++
 2 files changed, 101 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/PlayerHeadRotationPacketTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
index 48767edb5..ac0962482 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/OtherPlayerPackets.java
@@ -174,9 +174,9 @@ public final class OtherPlayerPackets {
                 entity.setRotation(new Position3f(rotation.x(), entity.rotation().y(), entity.rotation().z()));
                 wrapper.setPacketType(ClientboundPackets26_3.MOVE_ENTITY_ROT);
                 wrapper.write(Types.VAR_INT, entity.javaId()); // entity id
+                wrapper.write(Types.BOOLEAN, entity.isOnGround()); // on ground
                 wrapper.write(Types.BYTE, MathUtil.float2Byte(entity.rotation().y())); // yaw
                 wrapper.write(Types.BYTE, MathUtil.float2Byte(rotation.x())); // pitch
-                wrapper.write(Types.BOOLEAN, entity.isOnGround()); // on ground
                 return;
             }
 
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/PlayerHeadRotationPacketTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/PlayerHeadRotationPacketTest.java
new file mode 100644
index 000000000..5103f06c2
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/PlayerHeadRotationPacketTest.java
@@ -0,0 +1,100 @@
