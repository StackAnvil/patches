+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.http;
+
+import com.sun.net.httpserver.HttpServer;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.URI;
+import java.util.zip.GZIPOutputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockPackDownloaderTest {
+
+    @Test
+    void stopsReadingResponsesThatGrowPastTheExpectedLength() throws Exception {
+        final HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
+        server.createContext("/pack.zip", exchange -> {
+            // A chunked response has no length that the client could check before reading.
+            exchange.sendResponseHeaders(200, 0);
+            try (var body = exchange.getResponseBody()) {
+                body.write(new byte[]{1, 2, 3, 4, 5, 6, 7, 8});
+            }
+        });
+        server.start();
+        try {
+            final var downloader = new BedrockPackDownloader(URI.create("http://127.0.0.1:" + server.getAddress().getPort() + "/pack.zip").toURL());
+            assertThrows(IOException.class, () -> downloader.download(7));
+            assertArrayEquals(new byte[]{1, 2, 3, 4, 5, 6, 7, 8}, downloader.download(8));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void downloadsTheUnencodedArchiveFromServersThatCompressAcceptedResponses() throws Exception {
+        final byte[] archive = {'P', 'K', 3, 4, 5, 6, 7, 8};
+        final HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
+        server.createContext("/pack.zip", exchange -> {
+            // Like a CDN, compress only when the client accepts gzip.
+            final String accepted = exchange.getRequestHeaders().getFirst("Accept-Encoding");
+            byte[] body = archive;
+            if (accepted != null && accepted.contains("gzip")) {
+                final ByteArrayOutputStream compressed = new ByteArrayOutputStream();
+                try (var gzip = new GZIPOutputStream(compressed)) {
+                    gzip.write(archive);
+                }
+                body = compressed.toByteArray();
+                exchange.getResponseHeaders().set("Content-Encoding", "gzip");
+            }
+            exchange.sendResponseHeaders(200, body.length);
+            try (var output = exchange.getResponseBody()) {
+                output.write(body);
+            }
+        });
+        server.start();
+        try {
+            final var downloader = new BedrockPackDownloader(URI.create("http://127.0.0.1:" + server.getAddress().getPort() + "/pack.zip").toURL());
+            assertArrayEquals(archive, downloader.download(archive.length));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+}
