+class ResourcePackArchiveTest {
+
+    @Test
+    void storedDescriptorEntriesPreserveEmbeddedZipSignatures() throws Exception {
+        final UUID id = UUID.randomUUID();
+        final InMemoryContent inner = new InMemoryContent();
+        inner.putJson("manifest.json", manifest(id));
+        inner.put("textures/probe.bin", new byte[]{0x50, 0x4B, 7, 8, 0x50, 0x4B, 3, 4});
+        final byte[] payload = inner.toZip();
+        final byte[] archive = storedWithDescriptor("nested.zip", payload);
+        final ZipContent content = new ZipContent(archive);
+        assertArrayEquals(payload, content.get("nested.zip"));
+        assertEquals(id, new ResourcePack(content).id());
+        archive[30 + "nested.zip".length()] ^= 1;
+        assertThrows(ZipException.class, () -> new ZipContent(archive));
+    }
+
+    /** A non-seekable writer's STORED entry: only its descriptor and central directory know its size. */
+    private static byte[] storedWithDescriptor(final String path, final byte[] content) {
+        final byte[] name = path.getBytes(StandardCharsets.UTF_8);
+        final CRC32 checksum = new CRC32();
+        checksum.update(content);
+        final int crc = (int) checksum.getValue();
+        final ByteBuffer zip = ByteBuffer.allocate(30 + name.length + content.length + 16 + 46 + name.length + 22)
+                .order(ByteOrder.LITTLE_ENDIAN);
+        zip.putInt(0x04034B50).putShort((short) 20).putShort((short) 8).putShort((short) 0)
+                .putInt(0).putInt(0).putInt(0).putInt(0).putShort((short) name.length).putShort((short) 0)
+                .put(name).put(content);
+        zip.putInt(0x08074B50).putInt(crc).putInt(content.length).putInt(content.length);
+        final int directory = zip.position();
+        zip.putInt(0x02014B50).putShort((short) 20).putShort((short) 20).putShort((short) 8).putShort((short) 0)
+                .putInt(0).putInt(crc).putInt(content.length).putInt(content.length)
+                .putShort((short) name.length).putShort((short) 0).putShort((short) 0).putShort((short) 0)
+                .putShort((short) 0).putInt(0).putInt(0).put(name);
+        final int directorySize = zip.position() - directory;
+        zip.putInt(0x06054B50).putShort((short) 0).putShort((short) 0).putShort((short) 1).putShort((short) 1)
+                .putInt(directorySize).putInt(directory).putShort((short) 0);
+        return zip.array();
+    }
+
+    @Test
+    void entryThatInflatesPastItsDeclaredSizeIsRejectedWithoutExpandingIt() {
+        // The central directory declares one byte, but the deflated data expands past the largest Java array.
+        final long expanded = Integer.MAX_VALUE + 1024L;
+        assertThrows(ZipException.class, () -> new ZipContent(deflatedWithDeclaredSize("bomb.bin", zeroRun(expanded), 1)));
+    }
+
+    /** A fixed-Huffman DEFLATE stream of zeros: one literal, then repeated 258-byte copies at distance one. */
+    private static byte[] zeroRun(final long bytes) {
+        final long copies = (bytes - 1 + 257) / 258;
+        final BitWriter output = new BitWriter((int) (copies * 13 / 8 + 16));
+        output.write(0b011, 3); // final block with fixed Huffman codes
+        output.writeCode(0b00110000, 8); // literal 0
+        for (long copy = 0; copy < copies; copy++) {
+            output.writeCode(0b11000101, 8); // length 258
+            output.writeCode(0b00000, 5); // distance 1
+        }
+        output.writeCode(0b0000000, 7); // end of block
+        return output.finish();
+    }
+
+    private static byte[] deflatedWithDeclaredSize(final String path, final byte[] deflated, final int declaredSize) {
+        final byte[] name = path.getBytes(StandardCharsets.UTF_8);
+        final CRC32 checksum = new CRC32();
+        checksum.update(new byte[declaredSize]);
+        final int crc = (int) checksum.getValue();
+        final ByteBuffer zip = ByteBuffer.allocate(30 + name.length + deflated.length + 46 + name.length + 22)
+                .order(ByteOrder.LITTLE_ENDIAN);
+        zip.putInt(0x04034B50).putShort((short) 20).putShort((short) 0).putShort((short) 8)
+                .putInt(0).putInt(crc).putInt(deflated.length).putInt(declaredSize).putShort((short) name.length).putShort((short) 0)
+                .put(name).put(deflated);
+        final int directory = zip.position();
+        zip.putInt(0x02014B50).putShort((short) 20).putShort((short) 20).putShort((short) 0).putShort((short) 8)
+                .putInt(0).putInt(crc).putInt(deflated.length).putInt(declaredSize)
+                .putShort((short) name.length).putShort((short) 0).putShort((short) 0).putShort((short) 0)
+                .putShort((short) 0).putInt(0).putInt(0).put(name);
+        final int directorySize = zip.position() - directory;
+        zip.putInt(0x06054B50).putShort((short) 0).putShort((short) 0).putShort((short) 1).putShort((short) 1)
+                .putInt(directorySize).putInt(directory).putShort((short) 0);
+        return zip.array();
+    }
