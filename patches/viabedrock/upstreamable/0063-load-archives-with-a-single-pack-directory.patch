From 8d36a03a773f03c786248dee84e8a8abcb3c32cb Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 1 Oct 2026 14:53:41 +0200
Subject: [PATCH] fix(resource-packs): load archives with a single pack
 directory

Some server archives place their manifest and assets beneath one pack
folder. Select that root only when unambiguous, while preferring an
existing root manifest. Normalize repeated Windows path separators before
looking up manifests and assets; Geyser's advertised test pack uses those
separators for terrain definitions and model paths.

Minehut's hash-valid advertised ZIP exercises the nested-root case, and
the saved Geyser pack exercises Windows paths. Both recordings can now be
replayed locally without downloading them again. Archive tests preserve
root preference and reject ambiguous nested manifests.
---
 .../api/resourcepack/ResourcePack.java        | 15 ++++
 .../api/resourcepack/content/ZipContent.java  |  3 +-
 .../resourcepack/ResourcePackArchiveTest.java | 89 +++++++++++++++++++
 3 files changed, 106 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/resourcepack/ResourcePackArchiveTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ResourcePack.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ResourcePack.java
index ebab0034b..e4632f65f 100644
--- a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ResourcePack.java
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ResourcePack.java
@@ -22,6 +22,7 @@ import com.viaversion.viaversion.libs.gson.JsonElement;
 import com.viaversion.viaversion.libs.gson.JsonObject;
 import net.raphimc.viabedrock.ViaBedrock;
 import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
 import net.raphimc.viabedrock.api.resourcepack.content.SubpackContent;
 import net.raphimc.viabedrock.api.resourcepack.content.ZipContent;
 
@@ -60,6 +61,20 @@ public class ResourcePack {
                     content = new ZipContent(content.get(files.get(0)));
                 }
             }
+            if (!content.contains("manifest.json") && !content.contains("pack_manifest.json")) {
+                final List<String> manifests = content.getFilesDeep("", "").stream()
+                    .filter(path -> path.endsWith("/manifest.json") || path.endsWith("/pack_manifest.json"))
+                    .toList();
+                if (manifests.size() == 1) {
+                    final String manifest = manifests.get(0);
+                    final String prefix = manifest.substring(0, manifest.lastIndexOf('/') + 1);
+                    final Content root = new InMemoryContent();
+                    for (String file : content.getFilesDeep(prefix, "")) {
+                        root.put(file.substring(prefix.length()), content.get(file));
+                    }
+                    content = root;
+                }
+            }
             if (!content.contains("manifest.json") && !content.contains("pack_manifest.json")) {
                 throw new IllegalStateException("Missing manifest.json");
             }
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/ZipContent.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/ZipContent.java
index d16e08e63..a16028bbf 100644
--- a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/ZipContent.java
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/ZipContent.java
@@ -29,7 +29,8 @@ public class ZipContent extends InMemoryContent {
             ZipEntry zipEntry;
             while ((zipEntry = zipInputStream.getNextEntry()) != null) {
                 if (!zipEntry.isDirectory()) {
-                    this.content.put(zipEntry.getName(), zipInputStream.readAllBytes());
+                    final String path = zipEntry.getName().replace('\\', '/').replaceAll("/{2,}", "/");
+                    this.content.put(path, zipInputStream.readAllBytes());
                 }
             }
         }
