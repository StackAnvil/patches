@@ -29,14 +29,48 @@ import java.util.Map;
 
 public class ResourcePackDownloadTracker implements StorableObject {
 
+    // Far above the largest recorded server pack archive, about 65 MB.
+    private static final long MAX_DOWNLOADED_BYTES = 1L << 30;
+
     private final Map<String, Download> downloads = new HashMap<>();
+    private final long maxDownloadedBytes;
+    private long downloadedBytes;
+
+    public ResourcePackDownloadTracker() {
+        this(MAX_DOWNLOADED_BYTES);
+    }
 
+    ResourcePackDownloadTracker(final long maxDownloadedBytes) {
+        this.maxDownloadedBytes = maxDownloadedBytes;
+    }
+
+    /** Allocates a server-declared pack only while every pack of the connection stays within the download budget. */
     public Download add(final String key, final long size, final long chunkSize, final byte[] hash, final boolean premium, final PackType type) {
+        if (chunkSize <= 0) {
+            throw new IllegalStateException("Invalid resource pack chunk size");
+        }
+        final Download replaced = this.downloads.remove(key);
+        if (replaced != null) {
+            this.release(replaced.data.length);
+        }
+        this.reserve(size);
         final Download download = new Download(hash, premium, type, chunkSize, new boolean[Math.toIntExact((long) Math.ceil((double) size / chunkSize))], new byte[Math.toIntExact(size)]);
         this.downloads.put(key, download);
         return download;
     }
 
+    /** Counts pack bytes that this connection keeps, including packs downloaded over HTTP. */
+    public synchronized void reserve(final long bytes) {
+        if (bytes < 0 || bytes > this.maxDownloadedBytes - this.downloadedBytes) {
+            throw new IllegalStateException("Resource packs exceed the download limit of " + this.maxDownloadedBytes + " bytes");
+        }
+        this.downloadedBytes += bytes;
+    }
+
+    public synchronized void release(final long bytes) {
+        this.downloadedBytes -= bytes;
+    }
+
     public Download get(final String key) {
         return this.downloads.get(key);
     }
