+    private static JsonObject manifest(final UUID id) {
+        final JsonObject header = new JsonObject();
+        header.addProperty("uuid", id.toString());
+        header.addProperty("name", "archive fixture");
+        final JsonArray version = new JsonArray();
+        version.add(1);
+        version.add(0);
+        version.add(0);
+        header.add("version", version);
+        final JsonObject manifest = new JsonObject();
+        manifest.addProperty("format_version", 2);
+        manifest.add("header", header);
+        return manifest;
+    }
+
+    /** DEFLATE packs values from the least significant bit and Huffman codes from their most significant bit. */
+    private static final class BitWriter {
+        private final ByteArrayOutputStream output;
+        private int buffer;
+        private int count;
+
+        private BitWriter(final int capacity) {
+            this.output = new ByteArrayOutputStream(capacity);
+        }
+
+        private void write(final int value, final int bits) {
+            for (int bit = 0; bit < bits; bit++) {
+                this.buffer |= (value >>> bit & 1) << this.count;
+                if (++this.count == 8) {
+                    this.output.write(this.buffer);
+                    this.buffer = 0;
+                    this.count = 0;
+                }
+            }
+        }
+
+        private void writeCode(final int code, final int bits) {
+            this.write(Integer.reverse(code) >>> (32 - bits), bits);
+        }
+
+        private byte[] finish() {
+            if (this.count > 0) {
+                this.output.write(this.buffer);
+            }
+            return this.output.toByteArray();
+        }
+    }
+
+}
