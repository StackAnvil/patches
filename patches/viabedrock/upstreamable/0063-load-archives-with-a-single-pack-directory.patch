+package net.raphimc.viabedrock.api.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.content.ZipContent;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+import java.awt.image.BufferedImage;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ResourcePackArchiveTest {
+
+    @Test
+    void archiveWithOnePackDirectoryPreservesRelativeAssets() throws Exception {
+        final UUID id = UUID.randomUUID();
+        final InMemoryContent content = new InMemoryContent();
+        content.putJson("skull_resource_pack/manifest.json", manifest(id));
+        content.put("skull_resource_pack/textures/blocks/skull.png", new byte[]{1, 2, 3});
+        content.put("skull_resource_pack/subpacks/high/textures/skull.png", new byte[]{4, 5});
+        content.put("outside.txt", new byte[]{9});
+
+        final ResourcePack pack = new ResourcePack(new ZipContent(content.toZip()));
+        assertEquals(id, pack.id());
+        assertArrayEquals(new byte[]{1, 2, 3}, pack.content().get("textures/blocks/skull.png"));
+        assertArrayEquals(new byte[]{4, 5}, pack.content().get("subpacks/high/textures/skull.png"));
+        assertFalse(pack.content().contains("outside.txt"));
+        assertTrue(content.contains("skull_resource_pack/manifest.json"));
+    }
+
+    @Test
+    void archiveWithMultiplePacksRequiresAnExplicitRootManifest() throws Exception {
+        final InMemoryContent content = new InMemoryContent();
+        content.putJson("first/manifest.json", manifest(UUID.randomUUID()));
+        content.putJson("second/manifest.json", manifest(UUID.randomUUID()));
+        assertThrows(RuntimeException.class, () -> new ResourcePack(new ZipContent(content.toZip())));
+
+        final UUID root = UUID.randomUUID();
+        content.putJson("manifest.json", manifest(root));
+        assertEquals(root, new ResourcePack(new ZipContent(content.toZip())).id());
+    }
+
+    @Test
+    void windowsArchiveSeparatorsPreserveTextureLookup() throws Exception {
+        final InMemoryContent content = new InMemoryContent();
+        content.putJson("manifest.json", manifest(UUID.randomUUID()));
+        final BufferedImage texture = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        texture.setRGB(0, 0, 0x80123456);
+        content.putPngImage("textures\\\\blocks\\\\ruby.png", texture);
+
+        final ResourcePack pack = new ResourcePack(new ZipContent(content.toZip()));
+        assertEquals(0x80123456, pack.content().getShortnameImage("textures/blocks/ruby").getImage().getRGB(0, 0));
+    }
+
+    private static JsonObject manifest(final UUID id) {
+        final JsonObject header = new JsonObject();
+        header.addProperty("uuid", id.toString());
+        header.addProperty("name", "archive fixture");
+        final JsonArray version = new JsonArray();
+        version.add(1);
+        version.add(0);
+        version.add(0);
+        header.add("version", version);
+        final JsonObject manifest = new JsonObject();
+        manifest.addProperty("format_version", 2);
+        manifest.add("header", header);
+        return manifest;
+    }
+
+}
