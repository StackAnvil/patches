 public class ZipContent extends InMemoryContent {
 
+    private static final int MAX_ENTRY_BYTES = Integer.MAX_VALUE - 8;
+    // Far above the largest recorded server pack, whose converted archive is about 110 MB.
+    private static final long MAX_EXPANDED_BYTES = 1L << 30;
+
     private final byte[] sourceZip;
     private final Map<String, byte[]> sourceHashes = new HashMap<>();
 
     public ZipContent(final byte[] zipData) throws IOException {
+        this(zipData, MAX_EXPANDED_BYTES);
+    }
