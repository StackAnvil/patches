+    ZipContent(final byte[] zipData, final long maxExpandedBytes) throws IOException {
         this.sourceZip = zipData.clone();
-        try (ZipInputStream zipInputStream = new ZipInputStream(new ByteArrayInputStream(this.sourceZip))) {
-            ZipEntry zipEntry;
-            while ((zipEntry = zipInputStream.getNextEntry()) != null) {
-                if (!zipEntry.isDirectory()) {
-                    this.content.put(zipEntry.getName(), zipInputStream.readAllBytes());
+        try (var channel = new SeekableInMemoryByteChannel(this.sourceZip);
+             var archive = ZipFile.builder().setSeekableByteChannel(channel).get()) {
+            // Check every declared size before inflating, so many honest but huge entries cannot exhaust the heap either.
+            final List<ZipArchiveEntry> files = new ArrayList<>();
+            long expandedBytes = 0;
+            for (final ZipArchiveEntry zipEntry : Collections.list(archive.getEntriesInPhysicalOrder())) {
+                if (zipEntry.isDirectory()) {
+                    continue;
+                }
+                if (zipEntry.getSize() < 0 || zipEntry.getSize() > MAX_ENTRY_BYTES) {
+                    throw new ZipException("ZIP entry size is unknown or exceeds the array limit");
+                }
+                expandedBytes += zipEntry.getSize();
+                if (expandedBytes > maxExpandedBytes) {
+                    throw new ZipException("ZIP entries expand beyond the archive size limit");
+                }
+                files.add(zipEntry);
+            }
+            for (final ZipArchiveEntry zipEntry : files) {
+                final String path = zipEntry.getName().replace('\\', '/').replaceAll("/{2,}", "/");
+                try (var input = new CheckedInputStream(archive.getInputStream(zipEntry), new CRC32())) {
+                    // Inflate at most one byte past the declared size, so a forged size cannot exhaust the heap.
+                    final byte[] data = input.readNBytes((int) zipEntry.getSize() + 1);
+                    if (data.length != zipEntry.getSize() || input.getChecksum().getValue() != zipEntry.getCrc()) {
+                        throw new ZipException("ZIP entry size or checksum does not match its central directory");
+                    }
+                    this.content.put(path, data);
                 }
             }
         }
