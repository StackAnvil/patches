+class NpcActorDialoguePacketTest {
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void resolvesActorContentOnlyForAnUnnamedInteractionAndReadsCurrentMetadata(final boolean rawName) throws Exception {
+        try (Fixture fixture = new Fixture()) {
+            final var actor = fixture.actor;
+            actor.entityData().put(ActorDataIds.NAME, new EntityData(4, EntityDataTypesBedrock.STRING, "Actor name"));
+            // A wrong metadata type is not text. The valid name tag remains available.
+            actor.entityData().put(ActorDataIds.NAME_RAW_TEXT, new EntityData(112,
+                    rawName ? EntityDataTypesBedrock.STRING : EntityDataTypesBedrock.INT, rawName ? "Display name" : 42));
+            actor.entityData().put(ActorDataIds.INTERACT_TEXT,
+                    new EntityData(100, EntityDataTypesBedrock.STRING, "First\nSecond"));
+            actor.entityData().put(ActorDataIds.ACTIONS, new EntityData(41, EntityDataTypesBedrock.STRING,
+                    "[{\"mode\":2,\"type\":1},{\"mode\":0,\"type\":1,\"button_name\":\"Choose\"}]"));
+
+            final var conversation = fixture.open("", "", "", "");
+            assertEquals(rawName ? "Display name" : "Actor name", conversation.getTitle().asUnformattedString());
+            assertEquals(List.of("First", "Second"), conversation.getBody().stream()
+                    .map(body -> ((PlainMessageBody) body).getContents().asUnformattedString()).toList());
+            assertEquals(1, fixture.storage.current().buttons().getFirst().index());
+            assertEquals(1, ((MultiActionDialog) conversation).getActions().size());
+            final String oldIdentity = fixture.storage.current().responseIdentifier();
+
+            // A named empty scene must clear the UI, rather than exposing the actor's previous content.
+            final var empty = fixture.open("empty_scene", "", "", "[]");
+            assertEquals("", empty.getTitle().asUnformattedString());
+            assertInstanceOf(NoticeDialog.class, empty);
+            assertTrue(fixture.storage.current().buttons().isEmpty());
+            assertTrue(fixture.storage.respond(oldIdentity, 1).isEmpty());
+
+            // Explicit interaction data and an explicit empty action array also override stored metadata.
+            final var explicit = fixture.open("", "Packet name", "Packet text", "[]");
+            assertEquals("Packet name", explicit.getTitle().asUnformattedString());
+            assertEquals("Packet text", ((PlainMessageBody) explicit.getBody().getFirst()).getContents().asUnformattedString());
+            assertTrue(fixture.storage.current().buttons().isEmpty());
+
+            actor.entityData().put(ActorDataIds.INTERACT_TEXT, new EntityData(100, EntityDataTypesBedrock.STRING, "Updated"));
+            actor.entityData().put(ActorDataIds.ACTIONS, new EntityData(41, EntityDataTypesBedrock.INT, 0));
+            final var updated = fixture.open("", "", "", "");
+            assertEquals("Updated", ((PlainMessageBody) updated.getBody().getFirst()).getContents().asUnformattedString());
+            assertTrue(fixture.storage.current().buttons().isEmpty());
+        }
+    }
+
+    private static final class Fixture extends BedrockProtocol implements AutoCloseable {
+        private final Map<Class<?>, Object> storages = new HashMap<>();
+        private final EmbeddedChannel channel = new EmbeddedChannel();
+        private final NpcDialogueStorage storage = new NpcDialogueStorage();
+        private final UserConnection user;
+        private final Entity actor;
+
+        private Fixture() {
+            final ProtocolPipeline pipeline = stub(ProtocolPipeline.class, (proxy, method, args) -> List.of());
+            final ProtocolInfo info = stub(ProtocolInfo.class, (proxy, method, args) -> switch (method.getName()) {
+                case "getPipeline" -> pipeline;
+                case "getServerState" -> State.PLAY;
+                default -> throw new UnsupportedOperationException(method.getName());
+            });
+            this.user = stub(UserConnection.class, (proxy, method, args) -> switch (method.getName()) {
+                case "get" -> this.storages.get(args[0]);
+                case "getChannel" -> this.channel;
+                case "getProtocolInfo" -> info;
+                case "sendRawPacketToServer" -> {
+                    ((ByteBuf) args[0]).release();
+                    yield null;
+                }
+                default -> throw new UnsupportedOperationException(method.getName());
+            });
+            final var entities = new EntityTracker(this.user);
+            this.storages.put(EntityTracker.class, entities);
+            this.storages.put(NpcDialogueStorage.class, this.storage);
+            this.storages.put(InventoryTracker.class, new InventoryTracker(this.user));
+            this.storages.put(ResourcePackStorage.class, new ResourcePackStorage(List.of()));
+            this.actor = entities.addEntity(new Entity(this.user, -287762808818L, 1067, "minecraft:npc", 300,
+                    UUID.randomUUID(), EntityTypes26_3.MANNEQUIN), false);
+            NpcDialoguePackets.register(this);
+        }
+
+        private Dialog open(final String scene, final String name, final String text, final String actions) throws Exception {
+            final ByteBuf input = Unpooled.buffer();
+            try {
+                BedrockTypes.LONG_LE.write(input, this.actor.uniqueId());
+                BedrockTypes.VAR_INT.write(input, 0);
+                BedrockTypes.STRING.write(input, text);
+                BedrockTypes.STRING.write(input, scene);
+                BedrockTypes.STRING.write(input, name);
+                BedrockTypes.STRING.write(input, actions);
+                final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.NPC_DIALOGUE, input, this.user);
+                final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+                mapping.applyType(packet);
+                mapping.handler().handle(packet);
+                assertFalse(packet.isCancelled());
+                assertEquals(0, input.readableBytes());
+                return DialogSerializer.V1_21_6.getDirectCodec().deserialize(NbtConverter_v1_21_5.INSTANCE,
+                        packet.get(Types.TRUSTED_COMPOUND_TAG_HOLDER, 0).value()).get();
+            } finally {
+                input.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.channel.finishAndReleaseAll();
+        }
+
+        private static <T> T stub(final Class<T> type, final InvocationHandler handler) {
+            return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type}, handler));
+        }
+
+    }
