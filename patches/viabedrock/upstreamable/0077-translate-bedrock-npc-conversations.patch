+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.logging.Level;
+
+public final class NpcDialoguePackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.NPC_DIALOGUE, ClientboundPackets26_3.SHOW_DIALOG, wrapper -> {
+            final long uniqueId = wrapper.read(BedrockTypes.LONG_LE);
+            final NpcDialogueActionType action = NpcDialogueActionType.getByValue(wrapper.read(BedrockTypes.VAR_INT));
+            final String dialogue = wrapper.read(BedrockTypes.STRING);
+            final String scene = wrapper.read(BedrockTypes.STRING);
+            final String name = wrapper.read(BedrockTypes.STRING);
+            final String actions = wrapper.read(BedrockTypes.STRING);
+            final NpcDialogueStorage storage = wrapper.user().get(NpcDialogueStorage.class);
+            if (action == NpcDialogueActionType.Close) {
+                if (storage.close(uniqueId)) {
+                    wrapper.setPacketType(ClientboundPackets26_3.CLEAR_DIALOG);
+                } else {
+                    wrapper.cancel();
+                }
+                return;
+            }
+            if (action != NpcDialogueActionType.Open
+                    || (wrapper.user().get(InventoryTracker.class).isAnyScreenOpen() && storage.current() == null)) {
+                wrapper.cancel();
+                return;
+            }
+            final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByUid(uniqueId);
+            if (entity == null) {
+                wrapper.cancel();
+                return;
+            }
+            final NpcDialogueStorage.Session session;
+            try {
+                session = storage.open(uniqueId, entity.runtimeId(), scene, actions);
+            } catch (final RuntimeException e) {
+                ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Invalid NPC dialogue actions", e);
+                wrapper.cancel();
+                return;
+            }
+            final var texts = wrapper.user().get(ResourcePackStorage.class).getTexts();
+            final Identifier responseId = Identifier.of(session.responseIdentifier());
+            final CompoundTag exit = new CompoundTag();
+            exit.putBoolean("exit", true);
+            final var dialog = new MultiActionDialog(TextUtil.stringToTextComponent(texts.translate(name)),
+                    true, false, AfterAction.WAIT_FOR_RESPONSE, new ArrayList<>(), new ArrayList<>(), new ArrayList<>(),
+                    new ActionButton(TextUtil.stringToTextComponent(texts.get("gui.close")), 200,
+                            new CustomAllAction(responseId, exit)), 1);
+            for (String line : BedrockTextUtils.split(texts.translate(dialogue), "\n")) {
+                dialog.getBody().add(new PlainMessageBody(TextUtil.stringToTextComponent(line)));
+            }
+            for (NpcDialogueStorage.Button button : session.buttons()) {
+                final CompoundTag payload = new CompoundTag();
+                payload.putInt("button_id", button.index());
+                if (button.url() == null) {
+                    dialog.getActions().add(new ActionButton(TextUtil.stringToTextComponent(texts.translate(button.name())),
+                            200, new CustomAllAction(responseId, payload)));
+                } else {
+                    final URI uri = URI.create(button.url());
+                    if ("https".equalsIgnoreCase(uri.getScheme()) || "http".equalsIgnoreCase(uri.getScheme())) {
+                        dialog.getActions().add(new ActionButton(TextUtil.stringToTextComponent(texts.translate(button.name())),
+                                200, new StaticAction(ClickEvent.openUrl(uri))));
+                    }
+                }
+            }
+            wrapper.write(Types.TRUSTED_COMPOUND_TAG_HOLDER, Holder.of((CompoundTag) DialogSerializer.V1_21_6
+                    .getDirectCodec().serialize(NbtConverter_v1_21_5.INSTANCE, dialog).get()));
+            if (session.openingCommands()) {
+                sendRequest(wrapper.user(), new NpcDialogueStorage.Request(entity.runtimeId(),
+                        NpcRequestPacketPayload_RequestType.ExecuteOpeningCommands, 0, scene));
+            }
+        });
+    }
+
+    public static boolean handleResponse(final PacketWrapper wrapper, final String id, final CompoundTag payload) {
+        if (!id.startsWith("viabedrock:npc/")) {
+            return false;
+        }
+        wrapper.cancel();
+        final NpcDialogueStorage storage = wrapper.user().get(NpcDialogueStorage.class);
+        final var session = storage.current();
+        if (payload == null || session == null || !id.equals(session.responseIdentifier())) {
+            return true;
+        }
+        final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByUid(session.uniqueId());
+        if (entity == null || entity.runtimeId() != session.runtimeId()) {
+            storage.close(session.uniqueId());
+            PacketWrapper.create(ClientboundPackets26_3.CLEAR_DIALOG, wrapper.user()).send(BedrockProtocol.class);
+            return true;
+        }
+        final Integer buttonIndex;
+        if (payload.getBoolean("exit", false)) {
+            buttonIndex = null;
+        } else if (payload.get("button_id") instanceof NumberTag number) {
+            buttonIndex = number.asInt();
+        } else {
+            return true;
+        }
+        final var requests = storage.respond(id, buttonIndex);
+        if (!requests.isEmpty()) {
+            PacketWrapper.create(ClientboundPackets26_3.CLEAR_DIALOG, wrapper.user()).send(BedrockProtocol.class);
+            for (var request : requests) {
+                sendRequest(wrapper.user(), request);
+            }
+        }
+        return true;
+    }
+
+    public static void writeRequest(final PacketWrapper wrapper, final NpcDialogueStorage.Request request) {
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_LONG, request.runtimeId());
+        wrapper.write(Types.UNSIGNED_BYTE, (short) request.type().getValue());
+        wrapper.write(BedrockTypes.STRING, "");
+        wrapper.write(Types.UNSIGNED_BYTE, (short) request.actionIndex());
+        wrapper.write(BedrockTypes.STRING, request.scene());
+    }
+
+    private static void sendRequest(final UserConnection user, final NpcDialogueStorage.Request request) {
+        final PacketWrapper wrapper = PacketWrapper.create(ServerboundBedrockPackets.NPC_REQUEST, user);
+        writeRequest(wrapper, request);
+        wrapper.sendToServer(BedrockProtocol.class);
+    }
+
+    private NpcDialoguePackets() {
+    }
+
+}
