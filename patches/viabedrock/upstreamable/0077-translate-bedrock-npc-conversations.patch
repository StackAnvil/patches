+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcRequestPacketPayload_RequestType;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class NpcDialogueStorage implements StorableObject {
+
+    private Session current;
+    private long sequence;
+
+    public Session open(
+            final long uniqueId,
+            final long runtimeId,
+            final String scene,
+            final String actionJson) {
+        return this.open(uniqueId, runtimeId, scene, actionJson, false);
+    }
+
+    public Session open(
+            final long uniqueId,
+            final long runtimeId,
+            final String scene,
+            final String actionJson,
+            final boolean editor) {
+        final JsonArray actions =
+                JsonParser.parseString(actionJson.isBlank() ? "[]" : actionJson).getAsJsonArray();
+        if (actions.size() > 256) {
+            throw new IllegalArgumentException("NPC dialogue has more than 256 actions");
+        }
+        final List<Button> buttons = new ArrayList<>();
+        for (int index = 0; index < actions.size(); index++) {
+            final JsonObject action = actions.get(index).getAsJsonObject();
+            final int mode = action.get("mode").getAsInt();
+            final int type = action.get("type").getAsInt();
+            if (!editor && mode == 0 && (type == 0 || type == 1)) {
+                final String url = type == 0 ? action.get("text").getAsString().trim() : null;
+                if (url != null) {
+                    final URI uri = URI.create(url);
+                    if (uri.getHost() == null
+                            || !("https".equalsIgnoreCase(uri.getScheme())
+                                    || "http".equalsIgnoreCase(uri.getScheme()))) {
+                        throw new IllegalArgumentException("Invalid NPC link action");
+                    }
+                }
+                buttons.add(new Button(index, action.get("button_name").getAsString(), url));
+            }
+        }
+        return this.current =
+                new Session(
+                        uniqueId,
+                        runtimeId,
+                        scene,
+                        "viabedrock:npc/" + ++this.sequence,
+                        List.copyOf(buttons),
+                        editor);
+    }
+
+    public Session current() {
+        return this.current;
+    }
+
+    public boolean close(final long uniqueId) {
+        if (this.current == null || this.current.uniqueId() != uniqueId) {
+            return false;
+        }
+        this.current = null;
+        return true;
+    }
+
+    public List<Request> respond(final String identifier, final Integer buttonIndex) {
+        final Session session = this.current;
+        if (session == null || !session.responseIdentifier().equals(identifier)) {
+            return List.of();
+        }
+        if (session.editor()
+                || buttonIndex != null
+                        && session.buttons().stream()
+                                .noneMatch(
+                                        button ->
+                                                button.index() == buttonIndex
+                                                        && button.url() == null)) {
+            return List.of();
+        }
+        this.current = null;
+        final List<Request> requests = new ArrayList<>(2);
+        if (buttonIndex != null) {
+            requests.add(
+                    new Request(
+                            session.runtimeId(),
+                            NpcRequestPacketPayload_RequestType.ExecuteAction,
+                            buttonIndex,
+                            session.scene()));
+        }
+        // Closing a dialogue is a protocol interaction even when it has no exit commands.
+        requests.add(
+                new Request(
+                        session.runtimeId(),
+                        NpcRequestPacketPayload_RequestType.ExecuteClosingCommands,
+                        0,
+                        session.scene()));
+        return List.copyOf(requests);
+    }
+
+    /**
+     * Editor requests remain bound to the actor and authority established when its screen opened.
+     */
+    public Request edit(
+            final String identifier,
+            final NpcRequestPacketPayload_RequestType type,
+            final String data,
+            final int actionIndex) {
+        final Session session = this.current;
+        if (session == null
+                || !session.editor()
+                || !session.responseIdentifier().equals(identifier)) {
+            return null;
+        }
+        final int limit =
+            switch (type) {
+                case SetName -> 128;
+                case SetInteractText -> 1000;
+                case SetActions -> 1024 * 1024;
+                case SetSkin -> 0;
+                default -> -1;
+            };
+        if (limit < 0
+                || data.length() > limit
+                || actionIndex < 0
+                || actionIndex > 255
+                || type != NpcRequestPacketPayload_RequestType.SetSkin && actionIndex != 0) {
+            return null;
+        }
+        if (type == NpcRequestPacketPayload_RequestType.SetActions) {
+            final JsonArray actions;
+            try {
+                actions = JsonParser.parseString(data).getAsJsonArray();
+                if (actions.size() > 256) {
+                    return null;
+                }
+                for (final var entry : actions) {
+                    final JsonObject action = entry.getAsJsonObject();
+                    final int mode = action.get("mode").getAsBigDecimal().intValueExact();
+                    final int kind = action.get("type").getAsBigDecimal().intValueExact();
+                    final String text = action.get("text").getAsString();
+                    // Command serialization adds a terminal LF outside the editable text limit.
+                    final int textLimit = kind == 1 && text.endsWith("\n") ? 1025 : 1024;
+                    if (mode < 0
+                            || mode > 2
+                            || kind < 0
+                            || kind > 1
+                            || action.get("button_name").getAsString().length() > 128
+                            || text.length() > textLimit) {
+                        return null;
+                    }
+                }
+            } catch (final RuntimeException invalid) {
+                return null;
+            }
+        }
+        // Editing is actor-scoped even when a named scene caused the editor to open.
+        return new Request(session.runtimeId(), type, actionIndex, "", data);
+    }
+
+    public record Button(int index, String name, String url) {
+    }
+
+    public record Session(
+            long uniqueId,
+            long runtimeId,
+            String scene,
+            String responseIdentifier,
+            List<Button> buttons,
+            boolean editor) {
+    }
+
+    public record Request(
+            long runtimeId,
+            NpcRequestPacketPayload_RequestType type,
+            int actionIndex,
+            String scene,
+            String data) {
+        public Request(
+                final long runtimeId,
