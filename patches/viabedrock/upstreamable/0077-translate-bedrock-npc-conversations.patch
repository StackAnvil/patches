+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcRequestPacketPayload_RequestType;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.net.URI;
+
+public final class NpcDialogueStorage implements StorableObject {
+
+    private Session current;
+    private long sequence;
+
+    public Session open(final long uniqueId, final long runtimeId, final String scene, final String actionJson) {
+        final JsonArray actions = JsonParser.parseString(actionJson.isBlank() ? "[]" : actionJson).getAsJsonArray();
+        if (actions.size() > 256) {
+            throw new IllegalArgumentException("NPC dialogue has more than 256 actions");
+        }
+        final List<Button> buttons = new ArrayList<>();
+        boolean opening = false;
+        for (int index = 0; index < actions.size(); index++) {
+            final JsonObject action = actions.get(index).getAsJsonObject();
+            final int mode = action.get("mode").getAsInt();
+            final int type = action.get("type").getAsInt();
+            if (mode == 0 && (type == 0 || type == 1)) {
+                final String url = type == 0 ? action.get("text").getAsString().trim() : null;
+                if (url != null) {
+                    final URI uri = URI.create(url);
+                    if (uri.getHost() == null || !("https".equalsIgnoreCase(uri.getScheme())
+                            || "http".equalsIgnoreCase(uri.getScheme()))) {
+                        throw new IllegalArgumentException("Invalid NPC link action");
+                    }
+                }
+                buttons.add(new Button(index, action.get("button_name").getAsString(), url));
+            } else if (type == 1 && mode == 2) {
+                opening = true;
+            }
+        }
+        return this.current = new Session(uniqueId, runtimeId, scene, "viabedrock:npc/" + ++this.sequence,
+                List.copyOf(buttons), opening);
+    }
+
+    public Session current() {
+        return this.current;
+    }
+
+    public boolean close(final long uniqueId) {
+        if (this.current == null || this.current.uniqueId() != uniqueId) {
+            return false;
+        }
+        this.current = null;
+        return true;
+    }
+
+    public List<Request> respond(final String identifier, final Integer buttonIndex) {
+        final Session session = this.current;
+        if (session == null || !session.responseIdentifier().equals(identifier)) {
+            return List.of();
+        }
+        if (buttonIndex != null && session.buttons().stream().noneMatch(button ->
+                button.index() == buttonIndex && button.url() == null)) {
+            return List.of();
+        }
+        this.current = null;
+        final List<Request> requests = new ArrayList<>(2);
+        if (buttonIndex != null) {
+            requests.add(new Request(session.runtimeId(), NpcRequestPacketPayload_RequestType.ExecuteAction,
+                    buttonIndex, session.scene()));
+        }
+        // Closing a dialogue is a protocol interaction even when it has no exit commands.
+        requests.add(new Request(session.runtimeId(), NpcRequestPacketPayload_RequestType.ExecuteClosingCommands,
+                0, session.scene()));
+        return List.copyOf(requests);
+    }
+
+    public record Button(int index, String name, String url) {
+    }
+
+    public record Session(long uniqueId, long runtimeId, String scene, String responseIdentifier,
+                          List<Button> buttons, boolean openingCommands) {
+    }
+
+    public record Request(long runtimeId, NpcRequestPacketPayload_RequestType type, int actionIndex, String scene) {
+    }
+
+}
