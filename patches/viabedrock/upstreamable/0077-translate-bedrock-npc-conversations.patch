+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+class NpcDialogueStorageTest {
+
+    @Test
+    void preservesServerIndicesAndOrdersButtonThenClosingRequests() {
+        final NpcDialogueStorage storage = new NpcDialogueStorage();
+        final var session =
+                storage.open(
+                        -21474836474L,
+                        0x10000003DL,
+                        "probe_scene",
+                        """
+                        [{"button_name":"","type":1,"mode":2},
+                         {"button_name":"First","type":1,"mode":0},
+                         {"button_name":"","type":1,"mode":1},
+                         {"button_name":"Next","type":1,"mode":0}]
+                        """);
+        assertEquals(
+                List.of(1, 3),
+                session.buttons().stream().map(NpcDialogueStorage.Button::index).toList());
+        assertTrue(storage.respond(session.responseIdentifier(), 2).isEmpty());
+        assertSame(session, storage.current());
+
+        final var requests = storage.respond(session.responseIdentifier(), 3);
+        assertEquals(
+                List.of(
+                        NpcRequestPacketPayload_RequestType.ExecuteAction,
+                        NpcRequestPacketPayload_RequestType.ExecuteClosingCommands),
+                requests.stream().map(NpcDialogueStorage.Request::type).toList());
+        assertEquals(3, requests.get(0).actionIndex());
+        assertEquals(session.runtimeId(), requests.get(0).runtimeId());
+        assertEquals(session.scene(), requests.get(requests.size() - 1).scene());
+        assertNull(storage.current());
+        assertTrue(storage.respond(session.responseIdentifier(), 3).isEmpty());
+    }
+
+    @Test
+    void rejectsStaleResponsesAndKeepsUnrelatedServerCloseFromDismissingCurrentScene() {
+        final NpcDialogueStorage storage = new NpcDialogueStorage();
+        final var first = storage.open(1, 2, "first", "[]");
+        final var next = storage.open(1, 2, "next", "[]");
+        assertTrue(storage.respond(first.responseIdentifier(), null).isEmpty());
+        assertFalse(storage.close(99));
+        assertSame(next, storage.current());
+        final var close = storage.respond(next.responseIdentifier(), null);
+        assertEquals(1, close.size());
+        assertEquals(
+                NpcRequestPacketPayload_RequestType.ExecuteClosingCommands, close.get(0).type());
+        assertEquals(next.scene(), close.get(0).scene());
+        assertNull(storage.current());
+    }
+
+    @Test
+    void linkActionsCannotBeForgedIntoCommandRequests() {
+        final NpcDialogueStorage storage = new NpcDialogueStorage();
+        final var session =
+                storage.open(
+                        1,
+                        2,
+                        "",
+                        """
+                        [{"button_name":"Help","type":0,"mode":0,"text":"https://example.com/help"}]
+                        """);
+        assertTrue(storage.respond(session.responseIdentifier(), 0).isEmpty());
+        assertSame(session, storage.current());
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        storage.open(
+                                1,
+                                2,
+                                "",
+                                """
+                                [{"button_name":"Invalid","type":0,"mode":0,"text":"file:///tmp/example"}]
+                                """));
+        assertSame(session, storage.current());
+    }
+
+    @Test
+    void editorRequestsPreserveTypedDataWithoutExecutingConversationCommands() {
+        final var storage = new NpcDialogueStorage();
+        final var student = storage.open(1, 2, "named", "[]");
+        assertNull(
+                storage.edit(
+                        student.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.SetName,
+                        "new name",
+                        0));
+        final var editor = storage.open(1, 2, "named", "[]", true);
+        assertTrue(storage.respond(editor.responseIdentifier(), null).isEmpty());
+        assertSame(editor, storage.current());
+        final var text =
+                storage.edit(
+                        editor.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.SetInteractText,
+                        "first\nsecond",
+                        0);
+        assertEquals("first\nsecond", text.data());
+        assertEquals("", text.scene());
+        assertEquals(2, text.runtimeId());
+        assertEquals(
+                255,
+                storage.edit(
+                                editor.responseIdentifier(),
+                                NpcRequestPacketPayload_RequestType.SetSkin,
+                                "",
+                                255)
+                        .actionIndex());
+        assertNull(
+                storage.edit(
+                        editor.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.SetSkin,
+                        "",
+                        256));
+        assertNull(
+                storage.edit(
+                        editor.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.ExecuteAction,
+                        "",
+                        0));
+        assertNull(
+                storage.edit(
+                        editor.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.SetName,
+                        "x".repeat(129),
+                        0));
+        assertNull(
+                storage.edit(
+                        editor.responseIdentifier(),
+                        NpcRequestPacketPayload_RequestType.SetInteractText,
