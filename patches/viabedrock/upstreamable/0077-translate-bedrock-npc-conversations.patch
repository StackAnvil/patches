+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.NpcDialogueStorage;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NpcDialoguePacketTest {
+
+    @Test
+    void acknowledgesScenesWithoutOpeningCommandsAndTranslatesMatchingServerClose() throws Exception {
+        final Map<Class<?>, Object> storages = new HashMap<>();
+        final List<NpcDialogueStorage.Request> sent = new ArrayList<>();
+        final EmbeddedChannel channel = new EmbeddedChannel();
+        final ProtocolPipeline pipeline = (ProtocolPipeline) Proxy.newProxyInstance(ProtocolPipeline.class.getClassLoader(),
+                new Class<?>[]{ProtocolPipeline.class}, (proxy, method, args) -> {
+                    assertEquals("pipes", method.getName());
+                    assertSame(BedrockProtocol.class, args[0]);
+                    assertEquals(true, args[1]);
+                    assertSame(Direction.SERVERBOUND, args[2]);
+                    return List.of();
+                });
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+                new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) -> {
+                    assertEquals("getPipeline", method.getName());
+                    return pipeline;
+                });
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                    return switch (method.getName()) {
+                        case "get" -> storages.get(args[0]);
+                        case "getChannel" -> channel;
+                        case "getProtocolInfo" -> info;
+                        case "sendRawPacketToServer" -> {
+                            final ByteBuf wire = (ByteBuf) args[0];
+                            try {
+                                assertEquals(ServerboundBedrockPackets.NPC_REQUEST.getId(), Types.VAR_INT.read(wire));
+                                final long runtimeId = BedrockTypes.UNSIGNED_VAR_LONG.read(wire);
+                                final var type = NpcRequestPacketPayload_RequestType.getByValue(Types.UNSIGNED_BYTE.read(wire));
+                                assertEquals("", BedrockTypes.STRING.read(wire));
+                                final int index = Types.UNSIGNED_BYTE.read(wire);
+                                sent.add(new NpcDialogueStorage.Request(runtimeId, type, index, BedrockTypes.STRING.read(wire)));
+                                assertFalse(wire.isReadable());
+                            } finally {
+                                wire.release();
+                            }
+                            yield null;
+                        }
+                        default -> throw new UnsupportedOperationException(method.getName());
+                    };
+                });
+        final EntityTracker entities = new EntityTracker(user);
+        final NpcDialogueStorage storage = new NpcDialogueStorage();
+        storages.put(EntityTracker.class, entities);
+        storages.put(NpcDialogueStorage.class, storage);
+        storages.put(InventoryTracker.class, new InventoryTracker(user));
+        storages.put(ResourcePackStorage.class, new ResourcePackStorage(List.of()));
+        final Entity npc = entities.addEntity(new Entity(user, -21474836474L, 61, "minecraft:npc", 300,
+                UUID.randomUUID(), EntityTypes26_3.MANNEQUIN), false);
+        final TestProtocol protocol = new TestProtocol();
+        final ByteBuf input = dialogue(npc.uniqueId(), 0, "[{\"button_name\":\"Next\",\"mode\":0,\"type\":1}]");
+        try {
+            final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.NPC_DIALOGUE, input, user);
+            protocol.translate(packet);
+            assertEquals(ClientboundPackets26_3.SHOW_DIALOG, packet.getPacketType());
+            assertNotNull(packet.get(Types.TRUSTED_COMPOUND_TAG_HOLDER, 0));
+            assertEquals(npc.uniqueId(), storage.current().uniqueId());
+            assertEquals(npc.runtimeId(), storage.current().runtimeId());
+            assertEquals(List.of(new NpcDialogueStorage.Request(npc.runtimeId(),
+                    NpcRequestPacketPayload_RequestType.ExecuteOpeningCommands, 0, storage.current().scene())), sent);
+            assertEquals(0, input.readableBytes());
+            assertTrue(user.get(InventoryTracker.class).isAnyScreenOpen());
+        } finally {
+            input.release();
+        }
+        final ByteBuf unrelated = dialogue(99, 1, "[]");
+        final ByteBuf closing = dialogue(npc.uniqueId(), 1, "[]");
+        try {
+            final PacketWrapper old = new PacketWrapperImpl(ClientboundBedrockPackets.NPC_DIALOGUE, unrelated, user);
+            protocol.translate(old);
+            assertTrue(old.isCancelled());
+            assertNotNull(storage.current());
+            final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.NPC_DIALOGUE, closing, user);
+            protocol.translate(packet);
+            assertEquals(ClientboundPackets26_3.CLEAR_DIALOG, packet.getPacketType());
+            assertNull(storage.current());
+            assertFalse(user.get(InventoryTracker.class).isAnyScreenOpen());
+            assertEquals(0, closing.readableBytes());
+        } finally {
+            unrelated.release();
+            closing.release();
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void sendsRuntimeIdActionIndexAndSceneWithoutClientSuppliedCommands() throws Exception {
+        final var request = new NpcDialogueStorage.Request(0x10000003DL,
+                NpcRequestPacketPayload_RequestType.ExecuteAction, 200, "probe_scene");
+        final PacketWrapper packet = new PacketWrapperImpl(ServerboundBedrockPackets.NPC_REQUEST, null, null);
+        NpcDialoguePackets.writeRequest(packet, request);
+        final ByteBuf wire = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(wire);
+            assertEquals(ServerboundBedrockPackets.NPC_REQUEST.getId(), Types.VAR_INT.read(wire));
+            assertEquals(request.runtimeId(), BedrockTypes.UNSIGNED_VAR_LONG.read(wire));
+            assertEquals(request.type().getValue(), Types.UNSIGNED_BYTE.read(wire).intValue());
+            assertEquals("", BedrockTypes.STRING.read(wire));
+            assertEquals(request.actionIndex(), Types.UNSIGNED_BYTE.read(wire).intValue());
+            assertEquals(request.scene(), BedrockTypes.STRING.read(wire));
+            assertEquals(0, wire.readableBytes());
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void sendsEditorTextInTheNpcRequestDataField() throws Exception {
+        final var request = new NpcDialogueStorage.Request(1067,
+                NpcRequestPacketPayload_RequestType.SetInteractText, 0, "", "first\nsecond");
+        final PacketWrapper packet = new PacketWrapperImpl(ServerboundBedrockPackets.NPC_REQUEST, null, null);
+        NpcDialoguePackets.writeRequest(packet, request);
+        final ByteBuf wire = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(wire);
+            Types.VAR_INT.read(wire);
+            assertEquals(request.runtimeId(), BedrockTypes.UNSIGNED_VAR_LONG.read(wire));
+            assertEquals(request.type().getValue(), Types.UNSIGNED_BYTE.read(wire).intValue());
+            assertEquals(request.data(), BedrockTypes.STRING.read(wire));
+            assertEquals(0, Types.UNSIGNED_BYTE.read(wire).intValue());
+            assertEquals("", BedrockTypes.STRING.read(wire));
+            assertEquals(0, wire.readableBytes());
+        } finally {
+            wire.release();
+        }
+    }
+
+    private static ByteBuf dialogue(final long uniqueId, final int action, final String buttons) throws Exception {
+        final ByteBuf input = Unpooled.buffer();
+        BedrockTypes.LONG_LE.write(input, uniqueId);
+        BedrockTypes.VAR_INT.write(input, action);
+        BedrockTypes.STRING.write(input, "First line\nSecond line");
+        BedrockTypes.STRING.write(input, "probe_scene");
+        BedrockTypes.STRING.write(input, "Core NPC probe");
+        BedrockTypes.STRING.write(input, buttons);
+        return input;
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            NpcDialoguePackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+    }
+
+}
