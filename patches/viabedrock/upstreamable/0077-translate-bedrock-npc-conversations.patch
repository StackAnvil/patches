+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.viaversion.api.minecraft.Holder;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.mcstructs.converter.impl.v1_21_5.NbtConverter_v1_21_5;
+import com.viaversion.viaversion.libs.mcstructs.core.Identifier;
+import com.viaversion.viaversion.libs.mcstructs.dialog.ActionButton;
+import com.viaversion.viaversion.libs.mcstructs.dialog.AfterAction;
+import com.viaversion.viaversion.libs.mcstructs.dialog.action.CustomAllAction;
+import com.viaversion.viaversion.libs.mcstructs.dialog.action.StaticAction;
+import com.viaversion.viaversion.libs.mcstructs.dialog.body.PlainMessageBody;
+import com.viaversion.viaversion.libs.mcstructs.dialog.impl.MultiActionDialog;
+import com.viaversion.viaversion.libs.mcstructs.dialog.impl.NoticeDialog;
+import com.viaversion.viaversion.libs.mcstructs.dialog.serializer.DialogSerializer;
+import com.viaversion.viaversion.libs.mcstructs.text.events.click.ClickEvent;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.lenni0451.mcstructs_bedrock.text.utils.BedrockTextUtils;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.api.util.TextUtil;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcDialogueActionType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcRequestPacketPayload_RequestType;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.NpcDialogueStorage;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.logging.Level;
+
+public final class NpcDialoguePackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.NPC_DIALOGUE, ClientboundPackets26_3.SHOW_DIALOG, wrapper -> {
+            final long uniqueId = wrapper.read(BedrockTypes.LONG_LE);
+            final NpcDialogueActionType action = NpcDialogueActionType.getByValue(wrapper.read(BedrockTypes.VAR_INT));
+            final String packetDialogue = wrapper.read(BedrockTypes.STRING);
+            final String scene = wrapper.read(BedrockTypes.STRING);
+            final String packetName = wrapper.read(BedrockTypes.STRING);
+            final String packetActions = wrapper.read(BedrockTypes.STRING);
+            final NpcDialogueStorage storage = wrapper.user().get(NpcDialogueStorage.class);
+            if (action == NpcDialogueActionType.Close) {
+                if (storage.close(uniqueId)) {
+                    wrapper.setPacketType(ClientboundPackets26_3.CLEAR_DIALOG);
+                } else {
+                    wrapper.cancel();
+                }
+                return;
+            }
+            if (action != NpcDialogueActionType.Open
+                    || (wrapper.user().get(InventoryTracker.class).isAnyScreenOpen() && storage.current() == null)) {
+                wrapper.cancel();
+                return;
+            }
+            final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByUid(uniqueId);
+            if (entity == null) {
+                wrapper.cancel();
+                return;
+            }
+            final String name = content(entity, scene, packetName, ActorDataIds.NAME_RAW_TEXT, ActorDataIds.NAME);
+            final String dialogue = content(entity, scene, packetDialogue, ActorDataIds.INTERACT_TEXT);
+            final String actions = content(entity, scene, packetActions, ActorDataIds.ACTIONS);
+            final NpcDialogueStorage.Session session;
+            try {
+                session = storage.open(uniqueId, entity.runtimeId(), scene, actions);
+            } catch (final RuntimeException e) {
+                ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Invalid NPC dialogue actions", e);
+                wrapper.cancel();
+                return;
+            }
+            final var texts = wrapper.user().get(ResourcePackStorage.class).getTexts();
+            final Identifier responseId = Identifier.of(session.responseIdentifier());
+            final CompoundTag exit = new CompoundTag();
+            exit.putBoolean("exit", true);
+            final var dialog = new MultiActionDialog(TextUtil.stringToTextComponent(texts.translate(name)),
+                    true, false, AfterAction.WAIT_FOR_RESPONSE, new ArrayList<>(), new ArrayList<>(), new ArrayList<>(),
+                    new ActionButton(TextUtil.stringToTextComponent(texts.get("gui.close")), 200,
+                            new CustomAllAction(responseId, exit)), 1);
+            for (String line : BedrockTextUtils.split(texts.translate(dialogue), "\n")) {
+                dialog.getBody().add(new PlainMessageBody(TextUtil.stringToTextComponent(line)));
+            }
+            for (NpcDialogueStorage.Button button : session.buttons()) {
+                final CompoundTag payload = new CompoundTag();
+                payload.putInt("button_id", button.index());
+                if (button.url() == null) {
+                    dialog.getActions().add(new ActionButton(TextUtil.stringToTextComponent(texts.translate(button.name())),
+                            200, new CustomAllAction(responseId, payload)));
+                } else {
+                    final URI uri = URI.create(button.url());
+                    if ("https".equalsIgnoreCase(uri.getScheme()) || "http".equalsIgnoreCase(uri.getScheme())) {
+                        dialog.getActions().add(new ActionButton(TextUtil.stringToTextComponent(texts.translate(button.name())),
+                                200, new StaticAction(ClickEvent.openUrl(uri))));
+                    }
+                }
+            }
+            final var presentation = dialog.getActions().isEmpty()
+                    ? new NoticeDialog(dialog.getTitle(), true, false, AfterAction.WAIT_FOR_RESPONSE,
+                            dialog.getBody(), dialog.getInputs(), dialog.getExitAction()) : dialog;
+            wrapper.write(Types.TRUSTED_COMPOUND_TAG_HOLDER, Holder.of((CompoundTag) DialogSerializer.V1_21_6
+                    .getDirectCodec().serialize(NbtConverter_v1_21_5.INSTANCE, presentation).get()));
+            // Native clients acknowledge every scene, even without on-open commands.
+            sendRequest(wrapper, new NpcDialogueStorage.Request(entity.runtimeId(),
+                    NpcRequestPacketPayload_RequestType.ExecuteOpeningCommands, 0, scene));
+        });
+    }
+
+    private static String content(final Entity entity, final String scene, final String packetValue, final ActorDataIds... metadataIds) {
+        // An ordinary interaction references the actor's content. Named scenes own even empty values.
+        if (!scene.isEmpty() || !packetValue.isEmpty()) {
+            return packetValue;
+        }
+        for (final ActorDataIds id : metadataIds) {
+            final var data = entity.entityData().get(id);
+            if (data != null && data.value() instanceof String value) {
+                return value;
+            }
+        }
+        return packetValue;
+    }
+
+    public static boolean handleResponse(final PacketWrapper wrapper, final String id, final CompoundTag payload) {
+        if (!id.startsWith("viabedrock:npc/")) {
+            return false;
+        }
+        wrapper.cancel();
+        final NpcDialogueStorage storage = wrapper.user().get(NpcDialogueStorage.class);
+        final var session = storage.current();
+        if (payload == null || session == null || !id.equals(session.responseIdentifier())) {
+            return true;
+        }
+        final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByUid(session.uniqueId());
+        if (entity == null || entity.runtimeId() != session.runtimeId()) {
+            storage.close(session.uniqueId());
+            PacketWrapper.create(ClientboundPackets26_3.CLEAR_DIALOG, wrapper.user()).send(BedrockProtocol.class);
+            return true;
+        }
+        final Integer buttonIndex;
+        if (payload.getBoolean("exit", false)) {
+            buttonIndex = null;
+        } else if (payload.get("button_id") instanceof NumberTag number) {
+            buttonIndex = number.asInt();
+        } else {
+            return true;
+        }
+        final var requests = storage.respond(id, buttonIndex);
+        if (!requests.isEmpty()) {
+            PacketWrapper.create(ClientboundPackets26_3.CLEAR_DIALOG, wrapper.user()).send(BedrockProtocol.class);
+            for (var request : requests) {
+                sendRequest(wrapper, request);
+            }
+        }
+        return true;
+    }
+
+    public static void writeRequest(final PacketWrapper wrapper, final NpcDialogueStorage.Request request) {
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_LONG, request.runtimeId());
+        wrapper.write(Types.UNSIGNED_BYTE, (short) request.type().getValue());
+        wrapper.write(BedrockTypes.STRING, request.data());
+        wrapper.write(Types.UNSIGNED_BYTE, (short) request.actionIndex());
+        wrapper.write(BedrockTypes.STRING, request.scene());
+    }
+
+    private static void sendRequest(final PacketWrapper source, final NpcDialogueStorage.Request request) {
+        final PacketWrapper wrapper = source.create(ServerboundBedrockPackets.NPC_REQUEST);
+        writeRequest(wrapper, request);
+        wrapper.sendToServer(BedrockProtocol.class);
+    }
+
+    private NpcDialoguePackets() {
+    }
+
+}
