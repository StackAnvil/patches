 .../packet/DimensionDataPacketTest.java       | 96 +++++++++++++++++++
 2 files changed, 107 insertions(+), 3 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/DimensionDataPacketTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
index df656fb1..3e2c78d9 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
@@ -438,14 +438,13 @@ public final class JoinPackets {
                 final int count = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT); // entry count
                 for (int i = 0; i < count; i++) {
                     final String dimensionIdentifier = wrapper.read(BedrockTypes.STRING); // dimension identifier
-                    final int maximumHeight = wrapper.read(BedrockTypes.VAR_INT); // maximum height
-                    final int minimumHeight = wrapper.read(BedrockTypes.VAR_INT); // minimum height
+                    final IntIntImmutablePair dimensionHeight = readDimensionHeight(wrapper);
                     wrapper.read(BedrockTypes.VAR_INT); // generator type
                     wrapper.read(BedrockTypes.VAR_INT); // dimension type
                     wrapper.read(BedrockTypes.UUID); // pack id
                     wrapper.read(BedrockTypes.STRING); // default biome
                     if (dimensionIdentifier.equals(Dimension.OVERWORLD.getKey())) { // Bedrock client currently only supports overworld
-                        gameSession.putBedrockDimensionDefinition(dimensionIdentifier, new IntIntImmutablePair(minimumHeight, maximumHeight));
+                        gameSession.putBedrockDimensionDefinition(dimensionIdentifier, dimensionHeight);
                     }
                 }
             }, State.PLAY, (PacketHandler) PacketWrapper::cancel // Bedrock client ignores dimension data after start game
@@ -649,6 +648,15 @@ public final class JoinPackets {
         setTime.send(BedrockProtocol.class);
     }
 
+    static IntIntImmutablePair readDimensionHeight(final PacketWrapper wrapper) {
+        final int minimumY = wrapper.read(BedrockTypes.VAR_INT); // minimum y
+        final int heightRange = wrapper.read(BedrockTypes.VAR_INT); // height range
+        if (heightRange <= 0) {
+            throw new IllegalArgumentException("Dimension height range must be positive");
+        }
+        return new IntIntImmutablePair(minimumY, Math.addExact(minimumY, heightRange));
+    }
+
     static long initialDayTime(final int dayCycleStopTime, final long levelTime) {
         return dayCycleStopTime >= 0 ? dayCycleStopTime : levelTime;
     }
