+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class DimensionDataPacketTest {
+
+    @Test
+    void decodesMinimumHeightAndRangeWithoutConsumingFollowingFields() {
+        final int[][] ranges = {{0, 256}, {-64, 384}, {32, 64}};
+        for (final int[] range : ranges) {
+            final ByteBuf buffer = height(range[0], range[1]);
+            try {
+                BedrockTypes.VAR_INT.writePrimitive(buffer, 1); // generator
+                BedrockTypes.VAR_INT.writePrimitive(buffer, 3); // dimension type
+                final UUID pack = UUID.randomUUID();
+                BedrockTypes.UUID.write(buffer, pack);
+                BedrockTypes.STRING.write(buffer, "minecraft:plains");
+                final var wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.DIMENSION_DATA, buffer, null);
+                final var decoded = JoinPackets.readDimensionHeight(wrapper);
+                assertEquals(range[0], decoded.leftInt());
+                assertEquals(range[0] + range[1], decoded.rightInt());
+                assertEquals(range[1], decoded.rightInt() - decoded.leftInt());
+                assertEquals(range[1] / 16, (decoded.rightInt() - decoded.leftInt()) >> 4);
+                assertEquals(1, wrapper.read(BedrockTypes.VAR_INT));
+                assertEquals(3, wrapper.read(BedrockTypes.VAR_INT));
+                assertEquals(pack, wrapper.read(BedrockTypes.UUID));
+                assertEquals("minecraft:plains", wrapper.read(BedrockTypes.STRING));
+                assertEquals(0, buffer.readableBytes());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsEmptyAndNegativeHeightRanges() {
+        for (final int range : new int[]{0, -16, Integer.MIN_VALUE}) {
+            final ByteBuf buffer = height(-64, range);
+            try {
+                final var wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.DIMENSION_DATA, buffer, null);
+                assertThrows(IllegalArgumentException.class, () -> JoinPackets.readDimensionHeight(wrapper));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsUpperBoundOverflowInsteadOfWrappingTheDimension() {
+        final ByteBuf buffer = height(Integer.MAX_VALUE - 15, 16);
+        try {
+            final var wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.DIMENSION_DATA, buffer, null);
+            assertThrows(ArithmeticException.class, () -> JoinPackets.readDimensionHeight(wrapper));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void retainsRepresentableBoundsAtTheSignedIntegerLimits() {
+        for (final int minimum : new int[]{Integer.MIN_VALUE, Integer.MAX_VALUE - 16}) {
+            final ByteBuf buffer = height(minimum, 16);
+            try {
+                final var wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.DIMENSION_DATA, buffer, null);
+                final var decoded = JoinPackets.readDimensionHeight(wrapper);
+                assertEquals(minimum, decoded.leftInt());
+                assertEquals(minimum + 16, decoded.rightInt());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    private static ByteBuf height(final int minimum, final int range) {
+        final ByteBuf buffer = Unpooled.buffer();
+        BedrockTypes.VAR_INT.writePrimitive(buffer, minimum);
+        BedrockTypes.VAR_INT.writePrimitive(buffer, range);
+        return buffer;
+    }
+
+}
