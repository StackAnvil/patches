+package net.raphimc.viabedrock.protocol.model;
+
+public record DimensionDefinition(int minimumY, int height, int cloudHeight, boolean renderClouds) {
+
+    public DimensionDefinition {
+        if (height <= 0) {
+            throw new IllegalArgumentException("Dimension height range must be positive");
+        }
+        Math.addExact(minimumY, height);
+    }
+
+    public int maximumY() {
+        return this.minimumY + this.height;
+    }
+
