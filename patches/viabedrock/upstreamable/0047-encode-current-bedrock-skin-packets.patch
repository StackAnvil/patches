+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.function.Consumer;
+
+/** A versioned fragment of the target protocol's complete SkinData, including persona and animation fields. */
+public record NativeSkinFragment(UUID player, boolean localPlayer, UUID transfer, int totalLength, int offset, byte[] data) {
+
+    public static final String CHANNEL = "viabedrock:player_skin";
+    public static final int FRAGMENT_BYTES = 256 * 1024;
+    // Transport memory limits, not claims about the native client's supported skin dimensions.
+    public static final int MAX_SKIN_BYTES = 64 * 1024 * 1024;
+    public static final Type<NativeSkinFragment> TYPE = new Type<>(NativeSkinFragment.class) {
+        @Override
+        public NativeSkinFragment read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native skin format");
+            }
+            final UUID player = Types.UUID.read(buffer);
+            final boolean localPlayer = buffer.readBoolean();
+            final UUID transfer = Types.UUID.read(buffer);
+            final int totalLength = Types.VAR_INT.readPrimitive(buffer);
+            final int offset = Types.VAR_INT.readPrimitive(buffer);
+            final int length = buffer.readableBytes();
+            validate(totalLength, offset, length);
+            final byte[] data = new byte[length];
+            buffer.readBytes(data);
+            return new NativeSkinFragment(player, localPlayer, transfer, totalLength, offset, data);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeSkinFragment value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.UUID.write(buffer, value.player);
+            buffer.writeBoolean(value.localPlayer);
+            Types.UUID.write(buffer, value.transfer);
+            Types.VAR_INT.writePrimitive(buffer, value.totalLength);
+            Types.VAR_INT.writePrimitive(buffer, value.offset);
+            buffer.writeBytes(value.data);
+        }
+    };
+
+    public NativeSkinFragment {
+        Objects.requireNonNull(player);
+        Objects.requireNonNull(transfer);
+        validate(totalLength, offset, data.length);
+        data = data.clone();
+    }
+
+    @Override
+    public byte[] data() {
+        return this.data.clone();
+    }
+
+    public static byte[] encode(final SkinData skin) {
+        final ByteBuf buffer = Unpooled.buffer(256, MAX_SKIN_BYTES);
+        try {
+            BedrockTypes.SKIN.write(buffer, skin);
+            final byte[] encoded = new byte[buffer.readableBytes()];
+            buffer.readBytes(encoded);
+            return encoded;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    /** Send each transfer contiguously. Java's ordered connection preserves fragment order. */
+    public static void split(final UUID player, final boolean localPlayer, final byte[] skin, final Consumer<NativeSkinFragment> send) {
+        validate(skin.length, 0, Math.min(FRAGMENT_BYTES, skin.length));
+        final UUID transfer = UUID.randomUUID();
+        for (int offset = 0; offset < skin.length; offset += FRAGMENT_BYTES) {
+            send.accept(new NativeSkinFragment(player, localPlayer, transfer, skin.length, offset,
+                    Arrays.copyOfRange(skin, offset, Math.min(offset + FRAGMENT_BYTES, skin.length))));
+        }
+    }
+
+    private static void validate(final int totalLength, final int offset, final int length) {
+        if (totalLength <= 0 || totalLength > MAX_SKIN_BYTES || offset < 0 || offset >= totalLength
+                || length <= 0 || length > FRAGMENT_BYTES || length > totalLength - offset) {
+            throw new IllegalArgumentException("Invalid native skin fragment range");
+        }
+    }
+
+}
