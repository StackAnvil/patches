+            assertEquals(List.of(new NativeSkinChange.Result(first.getFirst().request(), false)), fixture.results);
+            fixture.storage.accept(first.get(1));
+            assertTrue(fixture.skins.isEmpty());
+            final var next = fragments(skin());
+            next.forEach(fixture.storage::accept);
+            fixture.advance(11);
+            fixture.storage.confirm(fixture.nativePlayer, skin());
+            assertEquals(new NativeSkinChange.Result(next.getFirst().request(), false), fixture.results.getLast());
+            assertFalse(fixture.results.stream().anyMatch(NativeSkinChange.Result::confirmed));
