+package net.raphimc.viabedrock.protocol.types.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.awt.image.BufferedImage;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+final class SkinTypeTest {
+
+    private final SkinType type = new SkinType();
+
+    @Test
+    void roundTripsPersonaImagesPiecesAndColors() {
+        final BufferedImage skinImage = image(2, 2, 0xFF874321);
+        final BufferedImage faceImage = image(1, 2, 0x80ABCDEF);
+        final SkinData skin = new SkinData("skin-id", "playfab-id", "{}", skinImage,
+            List.of(new SkinData.AnimationData(faceImage, 1, 2F, 1)), null, "{}", "0.0.0", "{}",
+            false, true, false, true, "", "full-id", "Slim", "#ff123456",
+            List.of(new SkinData.PersonaPieceData("piece", "Hair", "00000000-0000-0000-0000-000000000001", true, "product")),
+            List.of(new SkinData.PersonaPieceTintData("Hair", List.of("#0", "#ff112233", "#80445566", "#ffffffff"))),
+            false, "True", "profile-hash");
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            this.type.write(buffer, skin);
+            final SkinData decoded = this.type.read(buffer);
+
+            assertEquals(0, buffer.readableBytes());
+            assertEquals(skin.skinId(), decoded.skinId());
+            assertEquals(skin.playFabId(), decoded.playFabId());
+            assertEquals(skin.skinData().getRGB(0, 0), decoded.skinData().getRGB(0, 0));
+            assertEquals(skin.animations().get(0).image().getRGB(0, 0), decoded.animations().get(0).image().getRGB(0, 0));
+            assertEquals(skin.animations().get(0).type(), decoded.animations().get(0).type());
+            assertEquals(skin.animations().get(0).expression(), decoded.animations().get(0).expression());
+            assertEquals(skin.armSize(), decoded.armSize());
+            assertEquals(skin.skinColor(), decoded.skinColor());
+            assertEquals(skin.personaPieces(), decoded.personaPieces());
+            assertEquals(List.of("#00000000", "#ff112233", "#80445566", "#ffffffff"), decoded.tintColors().get(0).colors());
+            assertEquals(skin.trustedSkinFlag(), decoded.trustedSkinFlag());
+            assertEquals(skin.profileHash(), decoded.profileHash());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsIncompleteTint() {
+        final SkinData skin = new SkinData("id", "", "{}", image(1, 1, 0), List.of(), null, "{}", "", "",
+            false, true, false, false, "", "", "Wide", "#0", List.of(),
+            List.of(new SkinData.PersonaPieceTintData("Hair", List.of("#0"))), false, "False", "");
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            assertThrows(IllegalArgumentException.class, () -> this.type.write(buffer, skin));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static BufferedImage image(final int width, final int height, final int color) {
+        final BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, color);
+        return image;
+    }
+
+}
