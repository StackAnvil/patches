+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/NativeSkinStorageTest.java
@@ -0,0 +1,163 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import net.raphimc.viabedrock.api.model.NativeSkinFragment;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Consumer;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeSkinStorageTest {
+
+    @Test
+    void waitsForBothPlayJoinAndCapabilityThenSendsEveryUpdateInOrderOnce() {
+        final AtomicReference<State> state = new AtomicReference<>(State.CONFIGURATION);
+        final ChannelStorage channels = new ChannelStorage();
+        final NativeSkinStorage storage = new NativeSkinStorage(connection(state, channels));
+        final UUID player = UUID.randomUUID();
+        final UUID other = UUID.randomUUID();
+        final SkinData first = skin(0xFFFF0000);
+        final SkinData latest = skin(0xFF0000FF);
+        storage.update(player, true, first);
+        storage.update(other, false, first);
+        storage.update(player, true, latest);
+        final List<UUID> ids = new ArrayList<>();
+        final List<byte[]> delivered = new ArrayList<>();
+        final Consumer<NativeSkinStorage.Update> send = update -> {
+            ids.add(update.player());
+            delivered.add(update.data());
+            assertEquals(update.player().equals(player), update.localPlayer());
+        };
+        storage.flush(send);
+        assertTrue(ids.isEmpty());
+        storage.markJoined();
+        channels.addChannels(List.of(NativeSkinFragment.CHANNEL));
+        storage.flush(send);
+        assertTrue(ids.isEmpty());
+        state.set(State.PLAY);
+        storage.flush(send);
+        assertEquals(List.of(player, other, player), ids);
+        assertArrayEquals(NativeSkinFragment.encode(first), delivered.get(0));
+        assertArrayEquals(NativeSkinFragment.encode(first), delivered.get(1));
+        assertArrayEquals(NativeSkinFragment.encode(latest), delivered.get(2));
+        storage.flush(send);
+        assertEquals(3, ids.size());
+    }
+
+    @Test
+    void retainsPendingDataIfTheSenderFailsAndKeepsConnectionsIndependent() {
+        final AtomicReference<State> state = new AtomicReference<>(State.CONFIGURATION);
+        final ChannelStorage channels = new ChannelStorage();
+        final UserConnection user = connection(state, channels);
+        final NativeSkinStorage previous = new NativeSkinStorage(user);
+        final NativeSkinStorage current = new NativeSkinStorage(user);
+        final UUID player = UUID.randomUUID();
+        final SkinData old = skin(0xFFFF0000);
+        final SkinData replacement = skin(0xFF0000FF);
+        previous.update(player, true, old);
+        current.update(player, false, replacement);
+        previous.markJoined();
+        current.markJoined();
+        channels.addChannels(List.of(NativeSkinFragment.CHANNEL));
+        state.set(State.PLAY);
+        assertThrows(IllegalStateException.class, () -> current.flush(update -> {
+            throw new IllegalStateException();
+        }));
+        final List<byte[]> delivered = new ArrayList<>();
+        current.flush(update -> delivered.add(update.data()));
+        assertEquals(1, delivered.size());
+        assertArrayEquals(NativeSkinFragment.encode(replacement), delivered.get(0));
+        previous.flush(update -> assertArrayEquals(NativeSkinFragment.encode(old), update.data()));
+    }
+
+    @Test
+    void preservesEarlyPlayerListAndSkinPacketOrderWithoutRetainingTheirNetworkBuffers() {
+        final NativeSkinStorage storage = new NativeSkinStorage(connection(new AtomicReference<>(State.CONFIGURATION), new ChannelStorage()));
+        final byte[] first = {1, 2, 3};
+        final byte[] next = {4, 5};
+        final var input = Unpooled.wrappedBuffer(first);
+        final var continuation = Unpooled.wrappedBuffer(next);
+        try {
+            storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_LIST, input);
+            storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_SKIN, continuation);
+            assertEquals(0, input.readerIndex());
+            first[0] = 9;
+            final List<ClientboundBedrockPackets> types = new ArrayList<>();
+            final List<byte[]> payloads = new ArrayList<>();
+            storage.drainBeforeJoin((type, bytes) -> {
+                types.add(type);
+                payloads.add(bytes);
+            });
+            assertEquals(List.of(ClientboundBedrockPackets.PLAYER_LIST, ClientboundBedrockPackets.PLAYER_SKIN), types);
+            assertArrayEquals(new byte[]{1, 2, 3}, payloads.get(0));
+            assertArrayEquals(next, payloads.get(1));
+            storage.drainBeforeJoin((type, bytes) -> fail("Drained packet was replayed again"));
+            assertThrows(IllegalArgumentException.class, () -> storage.deferBeforeJoin(ClientboundBedrockPackets.TEXT, input));
+        } finally {
+            input.release();
+            continuation.release();
+        }
+    }
+
+    @Test
+    void boundsSmallEarlyPacketsAsWellAsTheirTotalBytes() {
+        final NativeSkinStorage storage = new NativeSkinStorage(connection(new AtomicReference<>(State.CONFIGURATION), new ChannelStorage()));
+        final var input = Unpooled.wrappedBuffer(new byte[]{0});
+        try {
+            assertThrows(IllegalArgumentException.class, () -> storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_LIST, Unpooled.EMPTY_BUFFER));
+            for (int i = 0; i < 10000; i++) {
+                storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_LIST, input);
+            }
+            assertThrows(IllegalArgumentException.class, () -> storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_LIST, input));
+            storage.drainBeforeJoin((type, bytes) -> assertArrayEquals(new byte[]{0}, bytes));
+            storage.deferBeforeJoin(ClientboundBedrockPackets.PLAYER_LIST, input);
+        } finally {
+            input.release();
+        }
+    }
+
+    private static UserConnection connection(final AtomicReference<State> state, final ChannelStorage channels) {
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(), new Class<?>[]{ProtocolInfo.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getServerState")) {
+                        return state.get();
+                    }
+                    throw new UnsupportedOperationException(method.getName());
+                });
+        return (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getProtocolInfo")) {
+                        return info;
+                    }
+                    if (method.getName().equals("get") && args[0] == ChannelStorage.class) {
+                        return channels;
+                    }
+                    throw new UnsupportedOperationException(method.getName());
+                });
+    }
+
+    private static SkinData skin(final int pixel) {
+        final BufferedImage image = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, pixel);
+        return new SkinData("id", "", "", image, List.of(), null, "", "", "", false, false, false, false,
+                "", "", "Wide", "#00000000", List.of(), List.of(), false, "", "");
+    }
+
+}
