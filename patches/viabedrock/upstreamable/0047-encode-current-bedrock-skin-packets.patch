 .../protocol/types/model/SkinType.java        | 53 ++++++++-----
 .../protocol/types/model/SkinTypeTest.java    | 74 +++++++++++++++++++
 3 files changed, 109 insertions(+), 20 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/types/model/SkinTypeTest.java

