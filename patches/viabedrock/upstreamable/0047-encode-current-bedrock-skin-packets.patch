+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.NativeSkinFragment;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.UUID;
+import java.util.function.BiConsumer;
+import java.util.function.Consumer;
+
+/** Keeps ordered wire snapshots until the Java play listener advertises native skin support. */
+public final class NativeSkinStorage extends StoredObject {
+
+    private static final int MAX_PENDING_RECORDS = 10000;
+    private static final long MAX_PENDING_BYTES = 128L * 1024 * 1024;
+    private final Deque<Update> pending = new ArrayDeque<>();
+    private long pendingBytes;
+    private final Deque<DeferredPacket> beforeJoin = new ArrayDeque<>();
+    private long beforeJoinBytes;
+    private boolean joined;
+
+    public NativeSkinStorage(final UserConnection user) {
+        super(user);
+    }
+
+    /** Player-list and skin packets can arrive before StartGame initializes their Java state. */
+    public void deferBeforeJoin(final ClientboundBedrockPackets type, final ByteBuf input) {
+        if (type != ClientboundBedrockPackets.PLAYER_LIST && type != ClientboundBedrockPackets.PLAYER_SKIN) {
+            throw new IllegalArgumentException("Not a skin or player-list packet");
+        }
+        if (this.joined || input.readableBytes() == 0 || this.beforeJoin.size() >= MAX_PENDING_RECORDS
+                || this.beforeJoinBytes + input.readableBytes() > MAX_PENDING_BYTES) {
+            throw new IllegalArgumentException("Invalid pre-join skin packet queue");
+        }
+        final byte[] payload = new byte[input.readableBytes()];
+        input.getBytes(input.readerIndex(), payload);
+        this.beforeJoin.addLast(new DeferredPacket(type, payload));
+        this.beforeJoinBytes += payload.length;
+    }
+
+    void drainBeforeJoin(final BiConsumer<ClientboundBedrockPackets, byte[]> dispatch) {
+        while (!this.beforeJoin.isEmpty()) {
+            final DeferredPacket packet = this.beforeJoin.getFirst();
+            dispatch.accept(packet.type(), packet.payload());
+            this.beforeJoinBytes -= packet.payload().length;
+            this.beforeJoin.removeFirst();
+        }
+    }
+
+    public void update(final UUID player, final boolean localPlayer, final SkinData skin) {
+        final byte[] encoded = NativeSkinFragment.encode(skin);
+        this.pending.addLast(new Update(player, localPlayer, encoded));
+        this.pendingBytes += encoded.length;
+        while (this.pendingBytes > MAX_PENDING_BYTES || this.pending.size() > MAX_PENDING_RECORDS) {
+            final Update oldest = this.pending.removeFirst();
+            this.pendingBytes -= oldest.data().length;
+            ViaBedrock.getPlatform().getLogger().warning("Native skin negotiation cache is full; discarded pending skin for " + oldest.player());
+        }
+        this.flush();
+    }
+
+    public void markJoined() {
+        this.joined = true;
+        this.drainBeforeJoin((type, payload) -> {
+            final ByteBuf buffer = Unpooled.wrappedBuffer(payload);
+            try {
+                PacketFactory.replayClientbound(PacketWrapper.create(type, buffer, this.user()));
+            } finally {
+                buffer.release();
+            }
+        });
+        this.flush();
+    }
+
+    public void flush() {
+        this.flush(update -> NativeSkinFragment.split(update.player(), update.localPlayer(), update.data(), fragment -> {
+            final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+            packet.write(Types.STRING, NativeSkinFragment.CHANNEL);
+            packet.write(NativeSkinFragment.TYPE, fragment);
+            packet.send(BedrockProtocol.class);
+        }));
+    }
+
+    void flush(final Consumer<Update> send) {
+        if (!this.joined || this.user().getProtocolInfo().getServerState() != State.PLAY
+                || !this.user().get(ChannelStorage.class).hasChannel(NativeSkinFragment.CHANNEL)) {
+            return;
+        }
+        while (!this.pending.isEmpty()) {
+            final Update update = this.pending.getFirst();
+            send.accept(update);
+            this.pendingBytes -= update.data().length;
+            this.pending.removeFirst();
+        }
+    }
+
+    private record DeferredPacket(ClientboundBedrockPackets type, byte[] payload) {
+    }
+
+    record Update(UUID player, boolean localPlayer, byte[] data) {
+    }
+
+}
