+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SkinProviderTest {
+
+    @Test
+    void identifiesTheLocalBedrockActorWhenTheJavaLoginUuidDiffers() {
+        final UUID bedrock = UUID.randomUUID();
