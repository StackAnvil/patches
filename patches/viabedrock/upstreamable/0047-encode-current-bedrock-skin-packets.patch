+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ImageTypeTest {
+
+    @Test
+    void rejectsOverflowedDimensionsAndTruncatedPixelDataBeforeImageAllocation() {
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            buffer.writeIntLE(0x40000001).writeIntLE(1);
+            BedrockTypes.BYTE_ARRAY.write(buffer, new byte[4]);
+            assertNull(BedrockTypes.IMAGE.read(buffer));
+            buffer.clear();
+            buffer.writeIntLE(64).writeIntLE(64);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> BedrockTypes.IMAGE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
