+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.NativeSkinAssembler;
+import net.raphimc.viabedrock.api.model.NativeSkinChange;
+import net.raphimc.viabedrock.api.model.NativeSkinFragment;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.io.IOException;
+import java.io.StringReader;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.UUID;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BiConsumer;
+import java.util.function.Consumer;
+
+/** One bounded upload and native confirmation per connection, confined to its channel event loop. */
+public final class SkinChangeStorage extends StoredObject {
+
+    private final NativeSkinAssembler assembler = new NativeSkinAssembler();
+    private final BiConsumer<UUID, SkinData> sendSkin;
+    private final Consumer<NativeSkinChange.Result> sendResult;
+    private UUID request;
+    private UUID player;
+    private byte[] appearanceHash;
+    private JsonElement geometry;
+    private ScheduledFuture<?> timeout;
+
+    public SkinChangeStorage(final UserConnection user) {
+        this(user, (player, skin) -> {
+            final var packet = PacketWrapper.create(ServerboundBedrockPackets.PLAYER_SKIN, user);
+            packet.write(BedrockTypes.UUID, player);
+            packet.write(BedrockTypes.SKIN, skin);
+            packet.write(BedrockTypes.STRING, ""); // localized new skin name
+            packet.write(BedrockTypes.STRING, ""); // localized old skin name
+            packet.sendToServer(BedrockProtocol.class);
+        }, result -> {
+            final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+            packet.write(Types.STRING, NativeSkinChange.Result.CHANNEL);
+            packet.write(NativeSkinChange.Result.TYPE, result);
+            packet.send(BedrockProtocol.class);
+        });
+    }
+
+    SkinChangeStorage(final UserConnection user, final BiConsumer<UUID, SkinData> sendSkin,
+                      final Consumer<NativeSkinChange.Result> sendResult) {
+        super(user);
+        this.sendSkin = sendSkin;
+        this.sendResult = sendResult;
+    }
+
+    public static void refreshCapability(final UserConnection user) {
+        run(user, () -> {
+            final boolean enabled = enabled(user);
+            if (enabled == user.has(SkinChangeStorage.class)) {
+                return;
+            }
+            if (enabled) {
+                user.put(new SkinChangeStorage(user));
+            } else {
+                user.remove(SkinChangeStorage.class);
+            }
+            if (user.getProtocolInfo().getClientState() == State.PLAY) {
+                final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+                packet.write(Types.STRING, enabled ? "minecraft:register" : "minecraft:unregister");
+                packet.write(Types.REMAINING_BYTES, NativeSkinChange.CHANNEL.getBytes(StandardCharsets.UTF_8));
+                packet.send(BedrockProtocol.class);
+            }
+        });
+    }
+
+    public static boolean enabled(final UserConnection user) {
+        final ChannelStorage channels = user.get(ChannelStorage.class);
+        return user.getProtocolInfo().getClientState() == State.PLAY
+                && channels.hasChannel(NativeSkinFragment.CHANNEL) && channels.hasChannel(NativeSkinChange.Result.CHANNEL);
+    }
+
+    public void accept(final NativeSkinChange fragment) {
+        run(this.user(), () -> this.acceptOnLoop(fragment));
+    }
+
+    private void acceptOnLoop(final NativeSkinChange fragment) {
+        if (!this.current()) {
+            return;
+        }
+        if (fragment.offset() == 0) {
+            this.finish(false);
+            this.request = fragment.request();
+            this.player = this.localPlayer();
+            if (this.player == null) {
+                this.finish(false);
+                return;
+            }
+        } else if (!fragment.request().equals(this.request)) {
+            // An unrelated continuation cannot cancel the current request.
+            this.sendResult.accept(new NativeSkinChange.Result(fragment.request(), false));
+            return;
+        }
+        if (this.appearanceHash != null) {
+            this.finish(false);
+            return;
+        }
+        try {
+            final SkinData skin = this.assembler.accept(new NativeSkinFragment(this.player, true, fragment.request(),
+                    fragment.totalLength(), fragment.offset(), fragment.data()));
+            if (skin == null) {
+                this.armTimeout(30);
+            } else {
+                if (!this.player.equals(this.localPlayer())) {
+                    this.finish(false);
+                    return;
+                }
+                this.geometry = geometry(skin.geometryData());
+                this.appearanceHash = appearanceHash(skin);
+                this.armTimeout(10);
+                this.sendSkin.accept(this.player, skin);
+            }
+        } catch (final RuntimeException malformedOrSendFailure) {
+            // Invalid native enums, counts, ranges and failed sends never produce a success result.
+            this.finish(false);
+        }
+    }
+
+    /** Called only for an incoming native skin, after publishing that authoritative appearance to Java. */
+    public void confirm(final UUID player, final SkinData skin) {
+        run(this.user(), () -> {
+            try {
+                if (this.current() && this.appearanceHash != null && player.equals(this.player)
+                        && MessageDigest.isEqual(this.appearanceHash, appearanceHash(skin))
+                        && this.geometry.equals(geometry(skin.geometryData()))) {
+                    this.finish(true);
+                }
+            } catch (final JsonParseException | IllegalArgumentException invalidGeometry) {
+                // An invalid server geometry cannot confirm the selected appearance.
+            }
+        });
+    }
+
+    private UUID localPlayer() {
+        final EntityTracker entities = this.user().get(EntityTracker.class);
+        final PlayerListStorage players = this.user().get(PlayerListStorage.class);
+        if (entities == null || entities.getClientPlayer() == null || !entities.getClientPlayer().isInitiallySpawned() || players == null) {
+            return null;
+        }
+        final var entry = players.getPlayer(entities.getClientPlayer().uniqueId());
+        return entry == null ? null : entry.key();
+    }
+
+    private static byte[] appearanceHash(final SkinData skin) {
+        // The server reformats geometry JSON and selects trust. Compare the geometry values separately.
+        final SkinData appearance = new SkinData(skin.skinId(), skin.skinResourcePatch(), skin.skinData(),
+                skin.animations(), skin.capeData(), "", skin.geometryDataEngineVersion(), skin.animationData(),
+                skin.premium(), skin.persona(), skin.capeOnClassic(), skin.primaryUser(), skin.capeId(), skin.fullSkinId(),
+                skin.armSize(), skin.skinColor(), skin.personaPieces(), skin.tintColors(), skin.overridingPlayerAppearance(), "", skin.profileHash());
+        try {
+            return MessageDigest.getInstance("SHA-256").digest(NativeSkinFragment.encode(appearance));
+        } catch (final NoSuchAlgorithmException impossible) {
+            throw new AssertionError(impossible);
+        }
+    }
+
+    private static JsonElement geometry(final String data) {
+        if (data.isEmpty()) {
+            return new JsonPrimitive("");
+        }
+        try (JsonReader reader = new JsonReader(new StringReader(data))) {
+            // A transport parsing bound, separate from native model dimensions and bone counts.
+            reader.setNestingLimit(128);
+            final JsonElement geometry = JsonParser.parseReader(reader);
+            if (reader.peek() != JsonToken.END_DOCUMENT) {
+                throw new IllegalArgumentException("Unexpected skin geometry fields");
+            }
+            return geometry;
+        } catch (final IOException malformed) {
+            throw new IllegalArgumentException("Invalid skin geometry", malformed);
+        }
+    }
+
+    private void armTimeout(final int seconds) {
+        if (this.timeout != null) {
+            this.timeout.cancel(false);
+        }
+        this.timeout = this.user().getChannel().eventLoop().schedule(() -> this.finish(false), seconds, TimeUnit.SECONDS);
+    }
+
+    private boolean current() {
+        return this.user().get(SkinChangeStorage.class) == this && enabled(this.user()) && this.user().getChannel().isActive();
+    }
+
+    private void finish(final boolean confirmed) {
+        final UUID completed = this.request;
+        this.request = null;
+        this.player = null;
+        this.appearanceHash = null;
+        this.geometry = null;
+        this.assembler.clear();
+        if (this.timeout != null) {
+            this.timeout.cancel(false);
+            this.timeout = null;
+        }
+        if (completed != null && this.user().getChannel().isActive()
+                && this.user().get(ChannelStorage.class).hasChannel(NativeSkinChange.Result.CHANNEL)) {
+            this.sendResult.accept(new NativeSkinChange.Result(completed, confirmed));
+        }
+    }
+
+    @Override
+    public void onRemove() {
+        run(this.user(), () -> this.finish(false));
+    }
+
+    private static void run(final UserConnection user, final Runnable action) {
+        if (user.getChannel().eventLoop().inEventLoop()) {
+            action.run();
+        } else {
+            user.getChannel().eventLoop().execute(action);
+        }
+    }
+
+}
