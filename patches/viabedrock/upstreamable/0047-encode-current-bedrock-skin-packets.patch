+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeSkinChangeTest {
+
+    @Test
+    void preservesEveryClassicAndPersonaFieldInServerboundSizedFragments() {
+        for (final boolean persona : List.of(false, true)) {
+            final byte[] encoded = NativeSkinFragment.encode(NativeSkinTransportTest.skin(persona, 1024));
+            final UUID request = UUID.randomUUID();
+            final UUID player = UUID.randomUUID();
+            final NativeSkinAssembler assembler = new NativeSkinAssembler();
+            final SkinData[] reconstructed = {null};
+            NativeSkinChange.split(request, encoded, fragment -> {
+                final var buffer = Unpooled.buffer();
+                try {
+                    NativeSkinChange.TYPE.write(buffer, fragment);
+                    assertTrue(buffer.readableBytes() < 32767);
+                    final NativeSkinChange received = NativeSkinChange.TYPE.read(buffer);
+                    assertEquals(request, received.request());
+                    assertFalse(buffer.isReadable());
+                    reconstructed[0] = assembler.accept(new NativeSkinFragment(player, true, received.request(),
+                            received.totalLength(), received.offset(), received.data()));
+                } finally {
+                    buffer.release();
+                }
+            });
+            assertArrayEquals(encoded, NativeSkinFragment.encode(reconstructed[0]));
+        }
+    }
+
+    @Test
+    void rejectsOversizedOrUnsupportedEnvelopesBeforeAllocatingAndSnapshotsData() {
+        final UUID id = UUID.randomUUID();
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinChange(id, Integer.MAX_VALUE, 0, new byte[1]));
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinChange(id, 1, 1, new byte[1]));
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinChange(id, 32767, 0, new byte[32767]));
+        final byte[] data = {1, 2};
+        final var fragment = new NativeSkinChange(id, 2, 0, data);
+        Arrays.fill(data, (byte) 0);
+        fragment.data()[0] = 0;
+        assertArrayEquals(new byte[]{1, 2}, fragment.data());
+        final var buffer = Unpooled.buffer();
+        try {
+            for (final int version : List.of(0, 2)) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, version);
+                assertThrows(IllegalArgumentException.class, () -> NativeSkinChange.TYPE.read(buffer));
+            }
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeSkinChange.TYPE.read(buffer));
+            buffer.clear();
+            NativeSkinChange.Result.TYPE.write(buffer, new NativeSkinChange.Result(id, true));
+            assertEquals(new NativeSkinChange.Result(id, true), NativeSkinChange.Result.TYPE.read(buffer));
+            buffer.clear();
+            NativeSkinChange.Result.TYPE.write(buffer, new NativeSkinChange.Result(id, false));
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeSkinChange.Result.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
