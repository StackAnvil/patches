+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.io.ByteArrayOutputStream;
+import java.util.UUID;
+
+/** One ordered transfer per client connection. Allocate only bytes that actually arrive. */
+public final class NativeSkinAssembler {
+
+    private UUID player;
+    private UUID transfer;
+    private boolean localPlayer;
+    private int totalLength;
+    private ByteArrayOutputStream bytes;
+
+    public SkinData accept(final NativeSkinFragment fragment) {
+        if (fragment.offset() == 0) {
+            this.clear();
+            this.player = fragment.player();
+            this.transfer = fragment.transfer();
+            this.localPlayer = fragment.localPlayer();
+            this.totalLength = fragment.totalLength();
+            this.bytes = new ByteArrayOutputStream(Math.min(this.totalLength, NativeSkinFragment.FRAGMENT_BYTES));
+        }
+        if (this.bytes == null || !fragment.player().equals(this.player) || !fragment.transfer().equals(this.transfer)
+                || fragment.localPlayer() != this.localPlayer || fragment.totalLength() != this.totalLength || fragment.offset() != this.bytes.size()) {
+            this.clear();
+            throw new IllegalArgumentException("Out-of-order native skin fragment");
+        }
+        this.bytes.writeBytes(fragment.data());
+        if (this.bytes.size() != this.totalLength) {
+            return null;
+        }
+        final ByteBuf buffer = Unpooled.wrappedBuffer(this.bytes.toByteArray());
+        this.clear();
+        try {
+            final SkinData skin = BedrockTypes.SKIN.read(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected native skin fields");
+            }
+            return skin;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    public void clear() {
+        this.player = null;
+        this.transfer = null;
+        this.totalLength = 0;
+        this.bytes = null;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeSkinChange.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeSkinChange.java
new file mode 100644
index 00000000..4ca1e0cd
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeSkinChange.java
@@ -0,0 +1,111 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.function.Consumer;
+
+/** A client request supplies appearance data; core selects the native player identity. */
+public record NativeSkinChange(UUID request, int totalLength, int offset, byte[] data) {
+
+    public static final String CHANNEL = "viabedrock:skin_change_v1";
+    // Java serverbound custom payloads are limited to 32767 bytes, including our envelope.
+    public static final int FRAGMENT_BYTES = 16 * 1024;
+    public static final Type<NativeSkinChange> TYPE = new Type<>(NativeSkinChange.class) {
+        @Override
+        public NativeSkinChange read(final ByteBuf buffer) {
+            readVersion(buffer);
+            final UUID request = Types.UUID.read(buffer);
+            final int totalLength = Types.VAR_INT.readPrimitive(buffer);
+            final int offset = Types.VAR_INT.readPrimitive(buffer);
+            validate(totalLength, offset, buffer.readableBytes());
+            final byte[] data = new byte[buffer.readableBytes()];
+            buffer.readBytes(data);
+            return new NativeSkinChange(request, totalLength, offset, data);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeSkinChange value) {
+            writeVersion(buffer);
+            Types.UUID.write(buffer, value.request);
+            Types.VAR_INT.writePrimitive(buffer, value.totalLength);
+            Types.VAR_INT.writePrimitive(buffer, value.offset);
+            buffer.writeBytes(value.data);
+        }
+    };
+
+    public NativeSkinChange {
+        Objects.requireNonNull(request);
+        validate(totalLength, offset, data.length);
+        data = data.clone();
+    }
+
+    @Override
+    public byte[] data() {
+        return this.data.clone();
+    }
+
+    public static void split(final UUID request, final byte[] skin, final Consumer<NativeSkinChange> send) {
+        validate(skin.length, 0, Math.min(FRAGMENT_BYTES, skin.length));
+        for (int offset = 0; offset < skin.length; offset += FRAGMENT_BYTES) {
+            send.accept(new NativeSkinChange(request, skin.length, offset,
+                    Arrays.copyOfRange(skin, offset, Math.min(offset + FRAGMENT_BYTES, skin.length))));
+        }
+    }
+
+    private static void validate(final int totalLength, final int offset, final int length) {
+        if (totalLength <= 0 || totalLength > NativeSkinFragment.MAX_SKIN_BYTES || offset < 0 || offset >= totalLength
+                || length <= 0 || length > FRAGMENT_BYTES || length > totalLength - offset) {
+            throw new IllegalArgumentException("Invalid skin change fragment range");
+        }
+    }
+
+    private static void readVersion(final ByteBuf buffer) {
+        if (Types.VAR_INT.readPrimitive(buffer) != 1
+                || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+            throw new IllegalArgumentException("Unsupported skin change format");
+        }
+    }
+
+    private static void writeVersion(final ByteBuf buffer) {
+        Types.VAR_INT.writePrimitive(buffer, 1);
+        Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+    }
+
+    public record Result(UUID request, boolean confirmed) {
+        public static final String CHANNEL = "viabedrock:skin_change_result_v1";
+        public static final Type<Result> TYPE = new Type<>(Result.class) {
+            @Override
+            public Result read(final ByteBuf buffer) {
+                readVersion(buffer);
+                final Result result = new Result(Types.UUID.read(buffer), buffer.readBoolean());
+                if (buffer.isReadable()) {
+                    throw new IllegalArgumentException("Unexpected skin change result fields");
+                }
+                return result;
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final Result value) {
+                writeVersion(buffer);
+                Types.UUID.write(buffer, value.request);
+                buffer.writeBoolean(value.confirmed);
+            }
+        };
+
+        public Result {
+            Objects.requireNonNull(request);
+        }
+    }
+
+}
