+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.io.ByteArrayOutputStream;
+import java.util.UUID;
+
+/** One ordered transfer per client connection. Allocate only bytes that actually arrive. */
+public final class NativeSkinAssembler {
+
+    private UUID player;
+    private UUID transfer;
+    private boolean localPlayer;
+    private int totalLength;
+    private ByteArrayOutputStream bytes;
+
+    public SkinData accept(final NativeSkinFragment fragment) {
+        if (fragment.offset() == 0) {
+            this.clear();
+            this.player = fragment.player();
+            this.transfer = fragment.transfer();
+            this.localPlayer = fragment.localPlayer();
+            this.totalLength = fragment.totalLength();
+            this.bytes = new ByteArrayOutputStream(Math.min(this.totalLength, NativeSkinFragment.FRAGMENT_BYTES));
+        }
+        if (this.bytes == null || !fragment.player().equals(this.player) || !fragment.transfer().equals(this.transfer)
+                || fragment.localPlayer() != this.localPlayer || fragment.totalLength() != this.totalLength || fragment.offset() != this.bytes.size()) {
+            this.clear();
+            throw new IllegalArgumentException("Out-of-order native skin fragment");
+        }
+        this.bytes.writeBytes(fragment.data());
+        if (this.bytes.size() != this.totalLength) {
+            return null;
+        }
+        final ByteBuf buffer = Unpooled.wrappedBuffer(this.bytes.toByteArray());
+        this.clear();
+        try {
+            final SkinData skin = BedrockTypes.SKIN.read(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected native skin fields");
+            }
+            return skin;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    public void clear() {
+        this.player = null;
+        this.transfer = null;
+        this.totalLength = 0;
+        this.bytes = null;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeSkinFragment.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeSkinFragment.java
