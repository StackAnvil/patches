+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeSkinTransportTest {
+
+    @Test
+    void roundTripsCompleteMultiMegabyteClassicAndPersonaRecordsThroughJavaPayloads() {
+        for (final boolean persona : List.of(false, true)) {
+            final SkinData skin = skin(persona, 1024);
+            final byte[] encoded = NativeSkinFragment.encode(skin);
+            final List<NativeSkinFragment> fragments = new ArrayList<>();
+            final UUID player = UUID.randomUUID();
+            NativeSkinFragment.split(player, persona, encoded, fragments::add);
+            assertTrue(fragments.size() > 16);
+            final NativeSkinAssembler assembler = new NativeSkinAssembler();
+            SkinData decoded = null;
+            for (int i = 0; i < fragments.size(); i++) {
+                final ByteBuf packet = Unpooled.buffer();
+                try {
+                    NativeSkinFragment.TYPE.write(packet, fragments.get(i));
+                    assertTrue(packet.readableBytes() < 1024 * 1024);
+                    final NativeSkinFragment fragment = NativeSkinFragment.TYPE.read(packet);
+                    assertEquals(0, packet.readableBytes());
+                    assertEquals(player, fragment.player());
+                    assertEquals(persona, fragment.localPlayer());
+                    decoded = assembler.accept(fragment);
+                    assertEquals(i == fragments.size() - 1, decoded != null);
+                } finally {
+                    packet.release();
+                }
+            }
+            // Re-encoding compares every RGBA pixel and every field, including cape, geometry, animations, and trust.
+            assertArrayEquals(encoded, NativeSkinFragment.encode(decoded));
+        }
+    }
+
+    @Test
+    void supersedesIncompleteUpdatesAndRejectsMismatchedOrSkippedFragments() {
+        final UUID player = UUID.randomUUID();
+        final List<NativeSkinFragment> first = fragments(player, skin(false, 512));
+        final List<NativeSkinFragment> next = fragments(player, skin(true, 512));
+        final NativeSkinAssembler assembler = new NativeSkinAssembler();
+        assertNull(assembler.accept(first.get(0)));
+        assertNull(assembler.accept(next.get(0)));
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(first.get(1)));
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(next.get(1)));
+        assertNull(assembler.accept(next.get(0)));
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(next.get(2)));
+        assertNull(assembler.accept(next.get(0)));
+        final NativeSkinFragment continuation = next.get(1);
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(new NativeSkinFragment(UUID.randomUUID(), false,
+                continuation.transfer(), continuation.totalLength(), continuation.offset(), continuation.data())));
+        for (int i = 0; i < next.size(); i++) {
+            assertEquals(i == next.size() - 1, assembler.accept(next.get(i)) != null);
+        }
+    }
+
+    @Test
+    void releasesPartialDataOnDisconnectAndDoesNotKeepCompletedTransfers() {
+        final List<NativeSkinFragment> fragments = fragments(UUID.randomUUID(), skin(false, 512));
+        final NativeSkinAssembler assembler = new NativeSkinAssembler();
+        assembler.accept(fragments.get(0));
+        assembler.clear();
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(fragments.get(1)));
+        for (final NativeSkinFragment fragment : fragments) {
+            assembler.accept(fragment);
+        }
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(fragments.get(fragments.size() - 1)));
+    }
+
+    @Test
+    void validatesResourceBoundsAndRejectsTrailingOrUnsupportedData() {
+        final UUID player = UUID.randomUUID();
+        final UUID transfer = UUID.randomUUID();
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinFragment(player, false, transfer, Integer.MAX_VALUE, 0, new byte[1]));
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinFragment(player, false, transfer, 1, 1, new byte[1]));
+        assertThrows(IllegalArgumentException.class, () -> new NativeSkinFragment(player, false, transfer, 1, 0, new byte[2]));
+        final byte[] encoded = NativeSkinFragment.encode(skin(false, 1));
+        final NativeSkinAssembler assembler = new NativeSkinAssembler();
+        assertThrows(IllegalArgumentException.class, () -> assembler.accept(new NativeSkinFragment(player, false, transfer,
+                encoded.length + 1, 0, Arrays.copyOf(encoded, encoded.length + 1))));
+        assertNotNull(assembler.accept(new NativeSkinFragment(player, false, transfer, encoded.length, 0, encoded)));
+        final ByteBuf packet = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(packet, 2);
+            Types.VAR_INT.writePrimitive(packet, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            assertThrows(IllegalArgumentException.class, () -> NativeSkinFragment.TYPE.read(packet));
+            packet.clear();
+            Types.VAR_INT.writePrimitive(packet, 1);
+            Types.VAR_INT.writePrimitive(packet, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeSkinFragment.TYPE.read(packet));
+        } finally {
+            packet.release();
+        }
+    }
+
+    @Test
+    void snapshotsFragmentArraysAndRejectsImpossibleNativeCollectionCounts() {
+        final byte[] encoded = NativeSkinFragment.encode(skin(false, 1));
+        final NativeSkinFragment fragment = new NativeSkinFragment(UUID.randomUUID(), false, UUID.randomUUID(), encoded.length, 0, encoded);
+        encoded[0]++;
+        fragment.data()[0]++;
+        assertNotNull(new NativeSkinAssembler().accept(fragment));
+        final ByteBuf malformed = Unpooled.buffer();
+        try {
+            for (int i = 0; i < 2; i++) {
+                malformed.writeByte(0);
+            } // Empty ID and resource patch
+            malformed.writeLong(0).writeByte(0); // Empty image
+            Types.VAR_INT.writePrimitive(malformed, Integer.MAX_VALUE); // Animation count with no entries
+            final byte[] data = new byte[malformed.readableBytes()];
+            malformed.readBytes(data);
+            assertThrows(IllegalArgumentException.class, () -> new NativeSkinAssembler().accept(
+                    new NativeSkinFragment(UUID.randomUUID(), false, UUID.randomUUID(), data.length, 0, data)));
+        } finally {
+            malformed.release();
+        }
+    }
+
+    private static List<NativeSkinFragment> fragments(final UUID player, final SkinData skin) {
+        final List<NativeSkinFragment> fragments = new ArrayList<>();
+        NativeSkinFragment.split(player, false, NativeSkinFragment.encode(skin), fragments::add);
+        return fragments;
+    }
+
+    static SkinData skin(final boolean persona, final int size) {
+        return new SkinData("id", "{\"geometry\":{\"default\":\"geometry.test\"}}", image(size, size),
+                List.of(new SkinData.AnimationData(image(Math.min(size, 512), Math.min(size, 512)), 1, 4.5F, 1)),
+                image(64, 32), "{\"geometry.test\":{}}", "1.21.0", "{\"animations\":{}}", true, persona, !persona, true,
+                "cape", "full", "Slim", "#80442211",
+                List.of(new SkinData.PersonaPieceData("piece", "Hair", UUID.randomUUID().toString(), true, "product")),
+                List.of(new SkinData.PersonaPieceTintData("Hair", List.of("#00000000", "#ffffff00", "#11223344", "#ffffffff"))),
+                true, "True", "profile");
+    }
+
+    private static BufferedImage image(final int width, final int height) {
+        final BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                image.setRGB(x, y, Integer.rotateLeft(x * 92371 + y * 8293, 5));
+            }
+        }
+        return image;
+    }
+
+}
