+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+
+public final class PlayerInputStorage extends StoredObject {
+
+    private PlayerInputPermissions permissions = PlayerInputPermissions.NONE;
+    private boolean joined;
+
+    public PlayerInputStorage(final UserConnection user) {
+        super(user);
+    }
+
+    public PlayerInputPermissions permissions() {
+        return this.permissions;
+    }
+
+    public void setPermissions(final PlayerInputPermissions permissions) {
+        this.permissions = permissions;
+    }
+
+    public void markJoined() {
+        this.joined = true;
+    }
+
+    public void sendSnapshot() {
+        if (!this.joined || !this.user().get(ChannelStorage.class).hasChannel(PlayerInputPermissions.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, PlayerInputPermissions.CHANNEL);
+        packet.write(PlayerInputPermissions.TYPE, this.permissions);
+        packet.send(BedrockProtocol.class);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/PlayerInputPermissionsTest.java b/src/test/java/net/raphimc/viabedrock/api/model/PlayerInputPermissionsTest.java
