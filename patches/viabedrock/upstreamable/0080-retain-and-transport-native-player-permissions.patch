+    }
+
+    public void setPermissions(final PlayerInputPermissions permissions) {
+        this.permissions = permissions;
+    }
+
+    public PlayerInput rawInput() {
+        return this.rawInput;
+    }
+
+    public void recordStandardInput(final PlayerInput input) {
+        if (!this.separateRawInput) {
+            this.updateRawInput(input);
+        }
+    }
+
+    public void recordRawInput(final PlayerInput input) {
+        this.separateRawInput = true;
+        this.updateRawInput(input);
+    }
+
+    private void updateRawInput(final PlayerInput input) {
+        this.pressed |= input.flags() & ~this.rawInput.flags();
+        this.released |= this.rawInput.flags() & ~input.flags();
+        this.rawInput = input;
+    }
+
+    public Set<PlayerAuthInputData> takeButtonEvents() {
+        final Set<PlayerAuthInputData> events = EnumSet.noneOf(PlayerAuthInputData.class);
+        if (this.rawInput.jumping()) {
+            events.add(PlayerAuthInputData.JumpCurrentRaw);
+        }
+        if (this.rawInput.sneaking()) {
+            events.add(PlayerAuthInputData.SneakCurrentRaw);
+        }
+        if ((this.pressed & 16) != 0) {
+            events.add(PlayerAuthInputData.JumpPressedRaw);
+        }
+        if ((this.released & 16) != 0) {
+            events.add(PlayerAuthInputData.JumpReleasedRaw);
+        }
+        if ((this.pressed & 32) != 0) {
+            events.add(PlayerAuthInputData.SneakPressedRaw);
+        }
+        if ((this.released & 32) != 0) {
+            events.add(PlayerAuthInputData.SneakReleasedRaw);
+        }
+        this.pressed = 0;
+        this.released = 0;
+        return events;
+    }
+
+    public void markJoined() {
+        this.joined = true;
+    }
+
+    public void sendSnapshot() {
+        if (!this.joined || !this.user().get(ChannelStorage.class).hasChannel(PlayerInputPermissions.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper register = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        register.write(Types.STRING, "minecraft:register");
+        register.write(Types.REMAINING_BYTES, PlayerInput.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        register.send(BedrockProtocol.class);
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, PlayerInputPermissions.CHANNEL);
+        packet.write(PlayerInputPermissions.TYPE, this.permissions);
+        packet.send(BedrockProtocol.class);
+    }
+
+}
