+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+
+/** A gameplay key sample before the server's permission mask is applied. */
+public record PlayerInput(int flags) {
+
+    public static final String CHANNEL = "viabedrock:raw_input";
+    public static final PlayerInput NONE = new PlayerInput(0);
+    public static final Type<PlayerInput> TYPE = new Type<>(PlayerInput.class) {
+        @Override
+        public PlayerInput read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported raw player input");
+            }
+            return new PlayerInput(buffer.readUnsignedByte());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerInput value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(value.flags());
+        }
+    };
+
+    public PlayerInput {
+        if ((flags & ~127) != 0) {
+            throw new IllegalArgumentException("Invalid player input bits");
+        }
+    }
+
+    public boolean jumping() {
+        return (this.flags & 16) != 0;
+    }
+
+    public boolean sneaking() {
+        return (this.flags & 32) != 0;
+    }
+
+    public Position2f movement() {
+        float x = ((this.flags & 4) != 0 ? 1F : 0F) - ((this.flags & 8) != 0 ? 1F : 0F);
+        float y = ((this.flags & 1) != 0 ? 1F : 0F) - ((this.flags & 2) != 0 ? 1F : 0F);
+        if (x != 0F && y != 0F) {
+            x *= (float) (1D / Math.sqrt(2));
+            y *= (float) (1D / Math.sqrt(2));
+        }
+        return new Position2f(x, y);
+    }
+
+}
