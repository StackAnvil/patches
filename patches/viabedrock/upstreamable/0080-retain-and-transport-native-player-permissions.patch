@@ -0,0 +1,105 @@
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.protocol.storage.PlayerInputStorage;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.data.enums.java.InputFlag;
+import java.util.HashMap;
+import java.util.EnumSet;
+import java.util.UUID;
+import java.lang.reflect.Proxy;
+
+import static net.raphimc.viabedrock.api.model.PlayerInputPermissions.Control.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerInputPermissionsTest {
+
+    @Test
+    void movementParentLocksEveryMovementCategoryButKeepsCamera() {
+        final var permissions = new PlayerInputPermissions(MOVEMENT.mask());
+        for (var control : PlayerInputPermissions.Control.values()) {
+            assertEquals(control == CAMERA, permissions.allows(control));
+        }
+        assertEquals(0, permissions.filterInput(127, false));
+    }
+
+    @Test
+    void lateralAndDirectionalLocksDoNotDisableVerticalOrVehicleControls() {
+        final var lateral = new PlayerInputPermissions(LATERAL_MOVEMENT.mask());
+        assertEquals(112, lateral.filterInput(127, false));
+        assertTrue(lateral.allows(MOUNT));
+        assertTrue(lateral.allows(DISMOUNT));
+        final var directional = new PlayerInputPermissions(FORWARD.mask() | RIGHT.mask());
+        assertEquals(118, directional.filterInput(127, false));
+        assertTrue(directional.allows(LATERAL_MOVEMENT));
+        assertTrue(directional.allows(BACKWARD));
+        assertTrue(directional.allows(LEFT));
+    }
+
+    @Test
+    void dismountRestrictionOnlySuppressesSneakWhileRiding() {
+        final var permissions = new PlayerInputPermissions(DISMOUNT.mask());
+        assertEquals(127, permissions.filterInput(127, false));
+        assertEquals(95, permissions.filterInput(127, true));
+        assertTrue(permissions.allows(SNEAK));
+        assertEquals(127, new PlayerInputPermissions(MOUNT.mask()).filterInput(127, true));
+    }
+
+    @Test
+    void transportPreservesUnsignedUnknownBitsAndRejectsIncompatibleOrTruncatedState() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var permissions = new PlayerInputPermissions(Integer.MIN_VALUE | 8 | CAMERA.mask());
+            PlayerInputPermissions.TYPE.write(buffer, permissions);
+            assertEquals(permissions, PlayerInputPermissions.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            assertEquals(127, permissions.filterInput(127, false));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, 0);
+            assertThrows(IllegalArgumentException.class, () -> PlayerInputPermissions.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerInputPermissions.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(128);
+            assertThrows(IndexOutOfBoundsException.class, () -> PlayerInputPermissions.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void replacingPermissionsFiltersHeldAuthInputWithoutMutatingItsPreviousSample() {
+        final var stored = new HashMap<Class<?>, Object>();
+        final var user = (UserConnection) Proxy.newProxyInstance(
+            getClass().getClassLoader(), new Class<?>[]{UserConnection.class},
+            (proxy, method, args) -> method.getName().equals("get") ? stored.get(args[0]) : null);
+        final var storage = new PlayerInputStorage(user);
+        stored.put(PlayerInputStorage.class, storage);
+        final var player = new ClientPlayerEntity(user, 1, UUID.randomUUID(),
+            new PlayerAbilities(1, (byte) 0, (byte) 0));
+        final var held = EnumSet.allOf(InputFlag.class);
+        player.setInputFlags(held);
+        final var previousSample = player.inputFlags();
+        storage.setPermissions(new PlayerInputPermissions(FORWARD.mask() | JUMP.mask()));
+        player.setInputFlags(player.inputFlags());
+        assertEquals(7, previousSample.size());
+        assertEquals(7, held.size());
+        assertFalse(player.inputFlags().contains(InputFlag.FORWARD));
+        assertFalse(player.inputFlags().contains(InputFlag.JUMP));
+        storage.setPermissions(PlayerInputPermissions.NONE);
+        player.setInputFlags(held);
+        assertEquals(held, player.inputFlags());
+    }
+
+}
