+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+import net.raphimc.viabedrock.protocol.storage.PlayerInputStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+import static net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerInputTest {
+
+    @Test
+    void rawSampleSurvivesPermissionFilteringAndCancelsOpposingControls() {
+        final var raw = new PlayerInput(1 | 4 | 16 | 32);
+        final var permissions = new PlayerInputPermissions(PlayerInputPermissions.Control.MOVEMENT.mask());
+        assertEquals(0, permissions.filterInput(raw.flags(), false));
+        assertEquals((float) (1D / Math.sqrt(2)), raw.movement().x());
+        assertEquals((float) (1D / Math.sqrt(2)), raw.movement().y());
+        assertEquals(new Position2f(0F, 0F), new PlayerInput(15).movement());
+        assertEquals(new Position2f(-1F, 0F), new PlayerInput(1 | 2 | 8).movement());
+    }
+
+    @Test
+    void preservesRawButtonEdgesAcrossHeldTicksAndFastPressRelease() {
+        final var storage = new PlayerInputStorage(null);
+        storage.recordStandardInput(new PlayerInput(16 | 32));
+        assertEquals(Set.of(JumpCurrentRaw, JumpPressedRaw, SneakCurrentRaw, SneakPressedRaw), storage.takeButtonEvents());
+        assertEquals(Set.of(JumpCurrentRaw, SneakCurrentRaw), storage.takeButtonEvents());
+        storage.recordStandardInput(PlayerInput.NONE);
+        storage.recordStandardInput(new PlayerInput(16));
+        storage.recordStandardInput(PlayerInput.NONE);
+        assertEquals(Set.of(JumpReleasedRaw, JumpPressedRaw, SneakReleasedRaw), storage.takeButtonEvents());
+        assertTrue(storage.takeButtonEvents().isEmpty());
+    }
+
+    @Test
+    void filteredStandardPacketsCannotOverwriteTheSeparateRawStream() {
+        final var storage = new PlayerInputStorage(null);
+        final var raw = new PlayerInput(1 | 16);
+        storage.recordRawInput(raw);
+        storage.setPermissions(new PlayerInputPermissions(PlayerInputPermissions.Control.MOVEMENT.mask()));
+        storage.recordStandardInput(PlayerInput.NONE);
+        assertEquals(raw, storage.rawInput());
+        assertEquals(Set.of(JumpCurrentRaw, JumpPressedRaw), storage.takeButtonEvents());
+        storage.recordRawInput(PlayerInput.NONE);
+        assertEquals(Set.of(JumpReleasedRaw), storage.takeButtonEvents());
+        assertEquals(PlayerInput.NONE, new PlayerInputStorage(null).rawInput());
+    }
+
+    @Test
+    void sampleTransportRejectsUndefinedJavaBits() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var sample = new PlayerInput(127);
+            PlayerInput.TYPE.write(buffer, sample);
+            assertEquals(sample, PlayerInput.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            assertThrows(IllegalArgumentException.class, () -> new PlayerInput(128));
+            assertThrows(IllegalArgumentException.class, () -> new PlayerInput(-1));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
