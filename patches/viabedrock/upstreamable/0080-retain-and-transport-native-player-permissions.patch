+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Server permission mask. Unknown bits survive transport without changing known controls. */
+public record PlayerInputPermissions(int locks) {
+
+    public static final String CHANNEL = "viabedrock:input_permissions";
+    public static final PlayerInputPermissions NONE = new PlayerInputPermissions(0);
+    public static final Type<PlayerInputPermissions> TYPE = new Type<>(PlayerInputPermissions.class) {
+        @Override
+        public PlayerInputPermissions read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported input permissions");
+            }
+            return new PlayerInputPermissions(Types.VAR_INT.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerInputPermissions value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.locks());
+        }
+    };
+
+    public enum Control {
+        CAMERA(2), MOVEMENT(4), LATERAL_MOVEMENT(16), SNEAK(32), JUMP(64), MOUNT(128), DISMOUNT(256),
+        FORWARD(512), BACKWARD(1024), LEFT(2048), RIGHT(4096);
+
+        private final int mask;
+
+        Control(final int mask) {
+            this.mask = mask;
+        }
+
+        public int mask() {
+            return this.mask;
+        }
+    }
+
+    public boolean allows(final Control control) {
+        if ((this.locks & control.mask()) != 0) {
+            return false;
+        }
+        if (control != Control.CAMERA && control != Control.MOVEMENT && (this.locks & Control.MOVEMENT.mask()) != 0) {
+            return false;
+        }
+        return switch (control) {
+            case FORWARD, BACKWARD, LEFT, RIGHT -> (this.locks & Control.LATERAL_MOVEMENT.mask()) == 0;
+            default -> true;
+        };
+    }
+
+    /** Filter Java's seven input bits before local prediction or Bedrock auth input. */
+    public int filterInput(final int input, final boolean passenger) {
+        int result = input;
+        final Control[] controls = {Control.FORWARD, Control.BACKWARD, Control.LEFT, Control.RIGHT, Control.JUMP, Control.SNEAK, Control.MOVEMENT};
+        for (int bit = 0; bit < controls.length; bit++) {
+            if (!this.allows(controls[bit])) {
+                result &= ~(1 << bit);
+            }
+        }
+        if (passenger && !this.allows(Control.DISMOUNT)) {
+            result &= ~(1 << 5);
+        }
+        return result;
+    }
+
+}
