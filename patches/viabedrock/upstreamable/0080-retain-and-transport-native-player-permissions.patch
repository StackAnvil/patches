+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.type.Types;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerInputStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public final class InputPermissionPackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.UPDATE_CLIENT_INPUT_LOCKS, null, wrapper -> {
+            wrapper.cancel();
+            final PlayerInputPermissions permissions = new PlayerInputPermissions(wrapper.read(BedrockTypes.UNSIGNED_VAR_INT));
+            if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                throw new IllegalArgumentException("Unexpected input permission fields");
+            }
+            final PlayerInputStorage storage = wrapper.user().get(PlayerInputStorage.class);
+            storage.setPermissions(permissions);
+            final var player = wrapper.user().get(EntityTracker.class).getClientPlayer();
+            player.setInputFlags(player.inputFlags());
+            storage.sendSnapshot();
+        });
+    }
+
+    private InputPermissionPackets() {
+    }
+
+}
