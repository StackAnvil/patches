+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FallingBlockSpawnTest {
+
+    @Test
+    void fallingBlocksSpawnWithTheJavaStateOfTheirBedrockVariant() {
+        final EntityData[] data = {
+            new EntityData(ActorDataIds.COLOR_INDEX.getValue(), EntityDataTypesBedrock.BYTE, (byte) 0),
+            new EntityData(ActorDataIds.VARIANT.getValue(), EntityDataTypesBedrock.INT, 17713)
+        };
+        assertEquals(42, EntityPackets.fallingBlockState(data, id -> id == 17713 ? 42 : -1));
+        assertEquals(0, EntityPackets.fallingBlockState(data, id -> -1));
+        assertEquals(0, EntityPackets.fallingBlockState(new EntityData[0], id -> 42));
+    }
+
+}
