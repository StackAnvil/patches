From 5bacec5df83d7b6405e62629c6aa4fa96d23dc54 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 8 Oct 2026 04:58:35 +0200
Subject: [PATCH] build(checkstyle): allocate heap for Java parsing

Checkstyle exhausts its worker heap while parsing ItemRewriter on GitHub runners. Give each Checkstyle worker a bounded 1 GiB heap so the complete source stack can be checked consistently across hosts.

Keep the existing checks, source selection, failure policy and Java launcher. This only raises the parser worker memory limit; it does not change runtime behavior.
---
 buildSrc/src/main/groovy/viabedrock.checkstyle.gradle | 1 +
 1 file changed, 1 insertion(+)

diff --git a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
index 084ebf4cc..1a1588f09 100644
--- a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
+++ b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
@@ -219,6 +219,7 @@ checkstyle {
 }
 
 tasks.withType(Checkstyle).configureEach {
+    maxHeapSize = "1g"
     javaLauncher = javaToolchains.launcherFor {
         languageVersion = JavaLanguageVersion.of(21)
     }
-- 
2.56.0
