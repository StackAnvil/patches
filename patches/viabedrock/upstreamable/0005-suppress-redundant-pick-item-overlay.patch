From e94ec8c5b1f8eea12f2e8081e05084e2f20f01ad Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:33 +0200
Subject: [PATCH] fix(input): suppress redundant pick-item overlay

Bedrock sends GuiDataPickItem after a pick request to hint which
hotbar slot its client should hover. Mapping that packet to Java overlay
chat displays untranslated item keys such as tile.grass.name above the
item name Java already shows.

Discard the Bedrock-only UI hint while keeping the pick request and
server-selected hotbar slot translation.
---
 .../viabedrock/protocol/packet/HudPackets.java       | 12 ------------
 .../viabedrock/protocol/packet/UnhandledPackets.java |  1 +
 2 files changed, 1 insertion(+), 12 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/HudPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/HudPackets.java
index 4b40f209..a8721512 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/HudPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/HudPackets.java
@@ -445,18 +445,6 @@ public final class HudPackets {
             gameSession.setDeathMessage(TextUtil.stringToTextComponent(BedrockTranslator.translate(message, translator, parameters)));
             PacketFactory.sendJavaDeathMessage(wrapper.user());
         });
-        protocol.registerClientbound(ClientboundBedrockPackets.GUI_DATA_PICK_ITEM, ClientboundPackets26_3.SYSTEM_CHAT, wrapper -> {
-            final String itemName = wrapper.read(BedrockTypes.STRING); // item name
-            final String itemEffects = wrapper.read(BedrockTypes.STRING); // item effects
-            wrapper.read(BedrockTypes.INT_LE); // hotbar slot (Unused by the vanilla client)
-
-            if (!itemEffects.isEmpty()) {
-                wrapper.write(Types.TAG, TextUtil.stringToNbt(itemName + "\n" + itemEffects)); // message
-            } else {
-                wrapper.write(Types.TAG, TextUtil.stringToNbt(itemName)); // message
-            }
-            wrapper.write(Types.BOOLEAN, true); // overlay
-        });
     }
 
     private HudPackets() {
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/UnhandledPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/UnhandledPackets.java
index 4159ddcb..5934cc82 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/UnhandledPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/UnhandledPackets.java
@@ -29,6 +29,7 @@ public final class UnhandledPackets {
         protocol.cancelClientbound(ClientboundBedrockPackets.SET_PASSENGER_OF_BLOCK); // Block seating has no Java counterpart yet
         protocol.cancelClientbound(ClientboundBedrockPackets.PLAY_AUDIO_CONTENT); // Signed audio content requires the Bedrock content service
         protocol.cancelClientbound(ClientboundBedrockPackets.SET_HEALTH); // Seems to do nothing meaningful
+        protocol.cancelClientbound(ClientboundBedrockPackets.GUI_DATA_PICK_ITEM); // Java shows the selected item name when the hotbar slot changes
         protocol.cancelClientbound(ClientboundBedrockPackets.CAMERA); // Not relevant (Education Edition)
         protocol.cancelClientbound(ClientboundBedrockPackets.PHOTO_TRANSFER); // Not relevant (Education Edition)
         protocol.cancelClientbound(ClientboundBedrockPackets.SHOW_PROFILE);
-- 
