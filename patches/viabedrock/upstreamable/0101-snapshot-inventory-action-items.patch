+package net.raphimc.viabedrock.protocol.model.inventory;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceFlags;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InventorySourceType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class InventoryActionDataTest {
+
+    @Test
+    void retainsIndependentBeforeAndAfterSnapshotsAcrossItemMutation() {
+        final var nested = new CompoundTag();
+        nested.putInt("value", 4);
+        final var tag = new CompoundTag();
+        tag.put("nested", nested);
+        final var item = new BedrockItem(257, (short) 2, (byte) 4, tag,
+                new String[] {"minecraft:stone"}, new String[] {"minecraft:dirt"}, 8, 9, 10);
+        final var expected = item.copy();
+        final var action = new InventoryActionData(new InventorySource(InventorySourceType.Container_Inventory,
+                (byte) 6, InventorySourceFlags.No_Flag), 9, item, item);
+
+        item.setAmount(7);
+        item.setData(3);
+        item.setNetId(11);
+        item.setBlockRuntimeId(12);
+        item.setBlockingTicks(13);
+        nested.putInt("value", 14);
+        item.canPlace()[0] = "minecraft:gravel";
+        item.canBreak()[0] = "minecraft:sand";
+
+        assertEquals(expected, action.fromItem());
+        assertEquals(expected, action.toItem());
+        assertNotSame(item, action.fromItem());
+        assertNotSame(action.fromItem(), action.toItem());
+
+        action.toItem().setAmount(1);
+        action.toItem().tag().getCompoundTag("nested").putInt("value", 15);
+        action.toItem().canPlace()[0] = "minecraft:sand";
+        assertEquals(expected, action.fromItem());
+    }
+
+}
