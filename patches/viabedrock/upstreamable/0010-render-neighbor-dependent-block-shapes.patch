+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.BlockState;
+
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+final class RedstoneWireConnections {
+
+    private RedstoneWireConnections() {
+    }
+
+    static boolean isWire(final BlockState state) {
+        return state != null && state.namespacedIdentifier().equals("minecraft:redstone_wire");
+    }
+
+    static BlockState shape(final BlockPosition position, final BlockState wire,
+                            final Function<BlockPosition, BlockState> blockAt,
+                            final Predicate<BlockState> conductor) {
+        if (!isWire(wire)) {
+            return wire;
+        }
+
+        final Connections connections = connections(position, blockAt, conductor);
+        return wire.withProperties(Map.of("north", connections.north().property(),
+                "east", connections.east().property(), "south", connections.south().property(),
+                "west", connections.west().property()));
+    }
+
+    static Connections connections(final BlockPosition position, final Function<BlockPosition, BlockState> blockAt,
+                                   final Predicate<BlockState> conductor) {
+        Connection north = connection(position, 0, -1, "north", blockAt, conductor);
+        Connection east = connection(position, 1, 0, "east", blockAt, conductor);
+        Connection south = connection(position, 0, 1, "south", blockAt, conductor);
+        Connection west = connection(position, -1, 0, "west", blockAt, conductor);
+
+        // Java extends a lone connection into a straight line and renders an isolated wire as a cross.
+        if (north == Connection.NONE && south == Connection.NONE) {
+            if (east == Connection.NONE && west == Connection.NONE) {
+                north = Connection.SIDE;
+                south = Connection.SIDE;
+            }
+            if (east == Connection.NONE) {
+                east = Connection.SIDE;
+            }
+            if (west == Connection.NONE) {
+                west = Connection.SIDE;
+            }
+        } else if (east == Connection.NONE && west == Connection.NONE) {
+            if (north == Connection.NONE) {
+                north = Connection.SIDE;
+            }
+            if (south == Connection.NONE) {
+                south = Connection.SIDE;
+            }
+        }
+
+        return new Connections(north, east, south, west);
+    }
+
+    private static Connection connection(final BlockPosition position, final int x, final int z, final String direction,
+                                     final Function<BlockPosition, BlockState> blockAt,
+                                     final Predicate<BlockState> conductor) {
+        final BlockPosition adjacentPosition = new BlockPosition(position.x() + x, position.y(), position.z() + z);
+        final BlockState adjacent = blockAt.apply(adjacentPosition);
+        if (!conductor.test(blockAt.apply(new BlockPosition(position.x(), position.y() + 1, position.z())))
+                && conductor.test(adjacent)
+                && isWire(blockAt.apply(new BlockPosition(adjacentPosition.x(), adjacentPosition.y() + 1, adjacentPosition.z())))) {
+            return Connection.UP;
+        }
+        if (connectsTo(adjacent, direction)) {
+            return Connection.SIDE;
+        }
+        if (!conductor.test(adjacent)
+                && isWire(blockAt.apply(new BlockPosition(adjacentPosition.x(), adjacentPosition.y() - 1, adjacentPosition.z())))) {
+            return Connection.SIDE;
+        }
+        return Connection.NONE;
+    }
+
+    private static boolean connectsTo(final BlockState state, final String direction) {
+        if (state == null) {
+            return false;
+        }
+        final String identifier = state.identifier();
+        if (identifier.equals("redstone_wire")) {
+            return true;
+        }
+        if (identifier.equals("repeater") || identifier.equals("comparator")) {
+            final String facing = state.properties().get("facing");
+            return direction.equals("north") || direction.equals("south")
+                    ? "north".equals(facing) || "south".equals(facing)
+                    : "east".equals(facing) || "west".equals(facing);
+        }
+        if (identifier.equals("observer")) {
+            return direction.equals(state.properties().get("facing"));
+        }
+        return switch (identifier) {
+            case "piston", "sticky_piston", "redstone_block", "redstone_torch", "redstone_wall_torch", "lever", "daylight_detector",
+                 "target", "tripwire_hook", "trapped_chest", "lectern", "sculk_sensor", "calibrated_sculk_sensor",
+                 "lightning_rod", "detector_rail", "pressure_plate", "button" -> true;
+            default -> identifier.endsWith("_button") || identifier.endsWith("_pressure_plate");
+        };
+    }
+
+    record Connections(Connection north, Connection east, Connection south, Connection west) {
+    }
+
+    enum Connection {
+        NONE("none"), SIDE("side"), UP("up");
+
+        private final String property;
+
+        Connection(final String property) {
+            this.property = property;
+        }
+
+        String property() {
+            return this.property;
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/BedrockFenceGeometryTest.java b/src/test/java/net/raphimc/viabedrock/api/model/BedrockFenceGeometryTest.java
new file mode 100644
index 000000000..6d5c118b4
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/BedrockFenceGeometryTest.java
@@ -0,0 +1,50 @@
+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockFenceGeometryTest {
+
+    @Test
+    void preservesConnectionsHeightAndSeparateCollisionArms() {
+        for (int mask = 0; mask < 16; mask++) {
+            final var geometry = new BedrockFenceGeometry((mask & 1) != 0, (mask & 2) != 0, (mask & 4) != 0, (mask & 8) != 0);
+            final var boxes = geometry.collisionBoxes(-11, 90, 12);
+            assertEquals((mask & 5) != 0 && (mask & 10) != 0 ? 2 : 1, boxes.size());
+            for (final var box : boxes) {
+                assertEquals(90, box.minY());
+                assertEquals(91.5F, box.maxY());
+            }
+            final var outline = geometry.outline(-11, 90, 12);
+            final var camera = geometry.cameraCollision(-11, 90, 12);
+            assertEquals((mask & 8) != 0 ? -11 : -10.625F, outline.minX());
+            assertEquals((mask & 2) != 0 ? -10 : -10.375F, outline.maxX());
+            assertEquals((mask & 1) != 0 ? 12 : 12.375F, outline.minZ());
+            assertEquals((mask & 4) != 0 ? 13 : 12.625F, outline.maxZ());
+            assertEquals(91, outline.maxY());
+            assertEquals(91.5F, camera.maxY());
+            assertEquals(outline.minX(), camera.minX());
+            assertEquals(outline.maxZ(), camera.maxZ());
+        }
+    }
+
+    @Test
+    void keepsCollisionGapInsideTheOutlineEnvelopeAndNativeAppendOrder() {
+        final var fence = new BedrockFenceGeometry(true, true, false, false);
+        final var boxes = fence.collisionBoxes(0, 0, 0);
+        assertEquals(new BedrockFenceGeometry.Box(0.375F, 0, 0, 0.625F, 1.5F, 0.625F), boxes.getFirst());
+        assertEquals(new BedrockFenceGeometry.Box(0.375F, 0, 0.375F, 1, 1.5F, 0.625F), boxes.getLast());
+        assertTrue(boxes.stream().noneMatch(box -> box.minX() < 0.8F && 0.8F < box.maxX() && box.minZ() < 0.1F && 0.1F < box.maxZ()));
+        assertEquals(new BedrockFenceGeometry.Box(0.375F, 0, 0, 1, 1, 0.625F), fence.outline(0, 0, 0));
+    }
+
+    @Test
+    void roundsWorldBoundsBeforeDroppingCollapsedCollisionBoxes() {
+        final var fence = new BedrockFenceGeometry(false, false, false, false);
+        assertTrue(fence.collisionBoxes(16_777_216, 0, 0).isEmpty());
+        assertEquals(16_777_216F, fence.outline(16_777_216, 0, 0).minX());
+        assertEquals(16_777_216F, fence.outline(16_777_216, 0, 0).maxX());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/ConnectedBlockShapeCandidatesTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/ConnectedBlockShapeCandidatesTest.java
new file mode 100644
index 000000000..f3c852edf
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/ConnectedBlockShapeCandidatesTest.java
@@ -0,0 +1,163 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.minecraft.chunks.ChunkSection;
+import com.viaversion.viaversion.api.minecraft.chunks.DataPalette;
+import com.viaversion.viaversion.api.minecraft.chunks.DataPaletteImpl;
+import net.raphimc.viabedrock.api.chunk.datapalette.BedrockDataPalette;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ConnectedBlockShapeCandidatesTest {
+
+    private static final List<BlockState> STATES = List.of(
+            BlockState.fromString("minecraft:air"),
+            BlockState.fromString("minecraft:stone"),
+            BlockState.fromString("minecraft:oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]"),
+            BlockState.fromString("minecraft:oak_fence[east=false,north=false,south=false,waterlogged=true,west=false]"),
+            BlockState.fromString("minecraft:oak_stairs[facing=north,half=bottom,shape=straight,waterlogged=false]"),
+            BlockState.fromString("minecraft:oak_stairs[facing=west,half=bottom,shape=straight,waterlogged=true]"),
+            BlockState.fromString("minecraft:redstone_wire[east=none,north=none,power=0,south=none,west=none]"));
+
+    @Test
+    void candidatePassMatchesExhaustivePositionsForBothPaletteOrdersAndEveryBorder() {
+        final Random random = new Random(90210);
+        for (int sample = 0; sample < 12; sample++) {
+            for (final DataPalette palette : List.of(new BedrockDataPalette(), new DataPaletteImpl(ChunkSection.SIZE))) {
+                palette.addId(0);
+                // Retain unused and repeated palette entries; neither should add candidates.
+                palette.addId(6);
+                palette.addId(0);
+                for (int y = 0; y < 16; y++) {
+                    for (int z = 0; z < 16; z++) {
+                        for (int x = 0; x < 16; x++) {
+                            palette.setIdAt(x, y, z, random.nextInt(16) == 0 ? random.nextInt(STATES.size()) : 1);
+                        }
+                    }
+                }
+                for (final int[] bounds : new int[][]{{0, 16, 0, 16}, {15, 16, 0, 16}, {0, 1, 0, 16}, {0, 16, 15, 16}, {0, 16, 0, 1}}) {
+                    final List<Integer> expected = new ArrayList<>();
+                    for (int y = 0; y < 16; y++) {
+                        for (int z = bounds[2]; z < bounds[3]; z++) {
+                            for (int x = bounds[0]; x < bounds[1]; x++) {
+                                if (ConnectedBlockShapes.isConnected(STATES.get(palette.idAt(x, y, z)))) {
+                                    expected.add((y << 8) | (z << 4) | x);
+                                }
+                            }
+                        }
+                    }
+                    final List<Integer> actual = new ArrayList<>();
+                    ConnectedBlockShapes.forEachCandidate(palette,
+                            id -> ConnectedBlockShapes.isConnected(STATES.get(id)),
+                            bounds[0], bounds[1], bounds[2], bounds[3], actual::add);
+                    assertEquals(expected, actual);
+                }
+            }
+        }
+    }
+
+    @Test
+    void remappedOutputsMatchExhaustiveShapesWhileUpdatesAppendPaletteEntries() {
+        final Random random = new Random(8317);
+        for (int sample = 0; sample < 12; sample++) {
+            final DataPalette palette = new DataPaletteImpl(ChunkSection.SIZE);
+            final int[] original = new int[ChunkSection.SIZE];
+            final List<BlockState> states = new ArrayList<>(STATES);
+            final Map<BlockState, Integer> ids = new HashMap<>();
+            for (int id = 0; id < states.size(); id++) {
+                ids.put(states.get(id), id);
+            }
+            palette.addId(0);
+            for (int local = 0; local < original.length; local++) {
+                original[local] = random.nextInt(STATES.size());
+                palette.setIdAt(local & 15, local >> 8, (local >> 4) & 15, original[local]);
+            }
+            final int[] expected = original.clone();
+            for (int local = 0; local < expected.length; local++) {
+                final BlockState state = states.get(original[local]);
+                if (!ConnectedBlockShapes.isConnected(state)) {
+                    continue;
+                }
+                final BlockPosition position = new BlockPosition(local & 15, local >> 8, (local >> 4) & 15);
+                final BlockState shaped = ConnectedBlockShapes.shape(position, state, adjacent -> {
+                    if (adjacent.x() < 0 || adjacent.x() >= 16 || adjacent.y() < 0 || adjacent.y() >= 16
+                            || adjacent.z() < 0 || adjacent.z() >= 16) {
+                        return STATES.get(0);
+                    }
+                    return STATES.get(original[(adjacent.y() << 8) | (adjacent.z() << 4) | adjacent.x()]);
+                }, adjacent -> "stone".equals(adjacent.identifier()));
+                expected[local] = ids.computeIfAbsent(shaped, key -> {
+                    states.add(key);
+                    return states.size() - 1;
+                });
+            }
+            final int originalPaletteSize = palette.size();
+            final AtomicInteger checks = new AtomicInteger();
+            ConnectedBlockShapes.forEachCandidate(palette, id -> {
+                checks.incrementAndGet();
+                return ConnectedBlockShapes.isConnected(states.get(id));
+            }, 0, 16, 0, 16, local -> palette.setIdAt(local & 15, local >> 8, (local >> 4) & 15, expected[local]));
+            final int[] actual = new int[original.length];
+            for (int local = 0; local < actual.length; local++) {
+                actual[local] = palette.idAt(local & 15, local >> 8, (local >> 4) & 15);
+            }
+            assertArrayEquals(expected, actual);
+            assertEquals(originalPaletteSize, checks.get());
+            assertTrue(palette.size() > originalPaletteSize);
+        }
+    }
+
+    @Test
+    void irrelevantUniformAndMixedSectionsNeverReadBlockCoordinates() {
+        final CountingPalette palette = new CountingPalette();
+        palette.addId(0);
+        final AtomicInteger checks = new AtomicInteger();
+        ConnectedBlockShapes.forEachCandidate(palette, id -> {
+            checks.incrementAndGet();
+            return ConnectedBlockShapes.isConnected(STATES.get(id));
+        }, 0, 16, 0, 16, _ -> {
+            throw new AssertionError("Ordinary blocks must not be updated");
+        });
+        assertEquals(1, checks.get());
+        assertEquals(0, palette.coordinateReads);
+        palette.setIdAt(3, 7, 11, 1);
+        checks.set(0);
+        ConnectedBlockShapes.forEachCandidate(palette, id -> {
+            checks.incrementAndGet();
+            return ConnectedBlockShapes.isConnected(STATES.get(id));
+        }, 15, 16, 0, 16, _ -> {
+            throw new AssertionError("Ordinary border blocks must not be updated");
+        });
+        assertEquals(2, checks.get());
+        assertEquals(0, palette.coordinateReads);
+    }
+
+    private static final class CountingPalette extends BedrockDataPalette {
+
+        private int coordinateReads;
+
+        @Override
+        public int paletteIndexAt(final int coordinate) {
+            this.coordinateReads++;
+            return super.paletteIndexAt(coordinate);
+        }
+
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/ConnectedBlockShapesTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/ConnectedBlockShapesTest.java
