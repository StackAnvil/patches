+package net.raphimc.viabedrock.api.model;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Physical fence geometry for Bedrock 1.26.51, independent of Java shape merging. */
+public record BedrockFenceGeometry(boolean north, boolean east, boolean south, boolean west) {
+
+    /** Preserve the native append order: north/south, then east/west. */
+    public List<Box> collisionBoxes(final int x, final int y, final int z) {
+        final List<Box> boxes = new ArrayList<>(2);
+        if (this.north || this.south) {
+            add(boxes, box(x, y, z, 0.375F, this.north ? 0 : 0.375F, 0.625F, this.south ? 1 : 0.625F, 1.5F));
+        }
+        if (this.east || this.west) {
+            add(boxes, box(x, y, z, this.west ? 0 : 0.375F, 0.375F, this.east ? 1 : 0.625F, 0.625F, 1.5F));
+        }
+        if (!this.north && !this.east && !this.south && !this.west) {
+            add(boxes, box(x, y, z, 0.375F, 0.375F, 0.625F, 0.625F, 1.5F));
+        }
+        return List.copyOf(boxes);
+    }
+
+    public Box outline(final int x, final int y, final int z) {
+        return this.envelope(x, y, z, 1);
+    }
+
+    public Box cameraCollision(final int x, final int y, final int z) {
+        return this.envelope(x, y, z, 1.5F);
+    }
+
+    private Box envelope(final int x, final int y, final int z, final float height) {
+        return box(x, y, z, this.west ? 0 : 0.375F, this.north ? 0 : 0.375F,
+                this.east ? 1 : 0.625F, this.south ? 1 : 0.625F, height);
+    }
+
+    private static Box box(final int x, final int y, final int z, final float minX, final float minZ,
+                           final float maxX, final float maxZ, final float height) {
+        // Native converts the integer position before adding local float bounds.
+        return new Box(x + minX, (float) y, z + minZ, x + maxX, y + height, z + maxZ);
+    }
+
+    private static void add(final List<Box> boxes, final Box box) {
+        if (box.minX < box.maxX && box.minY < box.maxY && box.minZ < box.maxZ) {
+            boxes.add(box);
+        }
+    }
+
+    public record Box(float minX, float minY, float minZ, float maxX, float maxY, float maxZ) {
+    }
+
+}
