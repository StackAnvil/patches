+class ConnectedBlockShapesTest {
+
+    private static final BlockPosition CENTER = new BlockPosition(0, 64, 0);
+    private static final BlockState AIR = BlockState.fromString("minecraft:air");
+    private final Map<BlockPosition, BlockState> blocks = new HashMap<>();
+
+    @Test
+    void routesRedstoneThroughTheSharedShapePath() {
+        final BlockState wire = BlockState.fromString("minecraft:redstone_wire[east=none,north=none,power=0,south=none,west=none]");
+        this.blocks.put(new BlockPosition(1, 64, 0), wire);
+        assertEquals("side", this.shape(wire).properties().get("east"));
+    }
+
+    @Test
+    void fencesRefreshWhenMatchingNeighborsAppearAndDisappear() {
+        final BlockState fence = BlockState.fromString("minecraft:oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]");
+        this.blocks.put(new BlockPosition(1, 64, 0), fence);
+        assertEquals("true", this.shape(fence).properties().get("east"));
+
+        this.blocks.remove(new BlockPosition(1, 64, 0));
+        assertEquals("false", this.shape(fence.withProperty("east", "true")).properties().get("east"));
+    }
+
+    @Test
+    void fencesConnectToGatesOnlyAcrossTheirOpening() {
+        final BlockState fence = BlockState.fromString("minecraft:oak_fence[east=false,north=false,south=false,waterlogged=false,west=false]");
+        this.blocks.put(new BlockPosition(1, 64, 0), BlockState.fromString("minecraft:oak_fence_gate[facing=north]"));
+        this.blocks.put(new BlockPosition(0, 64, -1), BlockState.fromString("minecraft:oak_fence_gate[facing=north]"));
+        assertEquals("true", this.shape(fence).properties().get("east"));
+        assertEquals("false", this.shape(fence).properties().get("north"));
+    }
+
+    @Test
+    void netherBrickFencesDoNotConnectToWoodenFences() {
+        final BlockState nether = BlockState.fromString("minecraft:nether_brick_fence[east=false,north=false,south=false,waterlogged=false,west=false]");
+        this.blocks.put(new BlockPosition(1, 64, 0), BlockState.fromString("minecraft:oak_fence"));
+        assertEquals("false", this.shape(nether).properties().get("east"));
+
+        this.blocks.put(new BlockPosition(1, 64, 0), nether);
+        assertEquals("true", this.shape(nether).properties().get("east"));
+    }
+
+    @Test
+    void stairCornersUseNeighborFacingAndHalf() {
+        final BlockState stair = BlockState.fromString("minecraft:oak_stairs[facing=north,half=bottom,shape=straight,waterlogged=false]");
+        this.blocks.put(new BlockPosition(0, 64, -1), BlockState.fromString("minecraft:oak_stairs[facing=west,half=bottom]"));
+        assertEquals("outer_left", this.shape(stair).properties().get("shape"));
+
+        this.blocks.clear();
+        this.blocks.put(new BlockPosition(0, 64, 1), BlockState.fromString("minecraft:oak_stairs[facing=east,half=bottom]"));
+        assertEquals("inner_right", this.shape(stair).properties().get("shape"));
+    }
+
+    private BlockState shape(final BlockState state) {
+        return ConnectedBlockShapes.shape(CENTER, state,
+                position -> this.blocks.getOrDefault(position, AIR),
+                block -> "stone".equals(block.identifier()));
+    }
+
+}
