+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.minecraft.chunks.DataPalette;
+import net.raphimc.viabedrock.api.model.BlockState;
+
+import java.util.BitSet;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.IntConsumer;
+import java.util.function.IntPredicate;
+import java.util.function.Predicate;
+
+final class ConnectedBlockShapes {
+
+    private ConnectedBlockShapes() {
+    }
+
+    static boolean isConnected(final BlockState state) {
+        return RedstoneWireConnections.isWire(state) || isFence(state) || isStairs(state);
+    }
+
+    /** Visits relevant positions as {@code y << 8 | z << 4 | x}, using the palette's own coordinate order. */
+    static void forEachCandidate(final DataPalette palette, final IntPredicate connected,
+                                 final int minX, final int maxX, final int minZ, final int maxZ,
+                                 final IntConsumer update) {
+        final BitSet entries = new BitSet(palette.size());
+        for (int entry = 0; entry < palette.size(); entry++) {
+            if (connected.test(palette.idByIndex(entry))) {
+                entries.set(entry);
+            }
+        }
+        if (entries.isEmpty()) {
+            return;
+        }
+        // Shape updates may append palette entries. Existing positions keep their original
+        // indices, so the predicate only needs to run for the entries present before this pass.
+        for (int y = 0; y < 16; y++) {
+            for (int z = minZ; z < maxZ; z++) {
+                for (int x = minX; x < maxX; x++) {
+                    if (entries.get(palette.paletteIndexAt(palette.index(x, y, z)))) {
+                        update.accept((y << 8) | (z << 4) | x);
+                    }
+                }
+            }
+        }
+    }
+
+    static BlockState shape(final BlockPosition position, final BlockState state,
+            final Function<BlockPosition, BlockState> blockAt, final Predicate<BlockState> fullBlock) {
+        if (RedstoneWireConnections.isWire(state)) {
+            return RedstoneWireConnections.shape(position, state, blockAt, fullBlock);
+        }
+        if (isFence(state)) {
+            return state.withProperties(Map.of(
+                    "north", Boolean.toString(connectsFence(state, stateAt(position, Direction.NORTH, blockAt), Direction.NORTH, fullBlock)),
+                    "east", Boolean.toString(connectsFence(state, stateAt(position, Direction.EAST, blockAt), Direction.EAST, fullBlock)),
+                    "south", Boolean.toString(connectsFence(state, stateAt(position, Direction.SOUTH, blockAt), Direction.SOUTH, fullBlock)),
+                    "west", Boolean.toString(connectsFence(state, stateAt(position, Direction.WEST, blockAt), Direction.WEST, fullBlock))));
+        }
+        if (!isStairs(state)) {
+            return state;
+        }
+        final String facingName = state.properties().get("facing");
+        final Direction facing = Direction.from(facingName);
+        if (facing == null) {
+            return state;
+        }
+        final String half = state.properties().get("half");
+        final BlockState front = stateAt(position, facing, blockAt);
+        final Direction frontFacing = stairFacing(front, half);
+        if (frontFacing != null && frontFacing.axis() != facing.axis()
+                && isDifferentStairs(stateAt(position, frontFacing.opposite(), blockAt), facing, half)) {
+            return state.withProperty("shape", frontFacing == facing.left() ? "outer_left" : "outer_right");
+        }
+        final BlockState back = stateAt(position, facing.opposite(), blockAt);
+        final Direction backFacing = stairFacing(back, half);
+        if (backFacing != null && backFacing.axis() != facing.axis()
+                && isDifferentStairs(stateAt(position, backFacing, blockAt), facing, half)) {
+            return state.withProperty("shape", backFacing == facing.left() ? "inner_left" : "inner_right");
+        }
+        return state.withProperty("shape", "straight");
+    }
+
+    static boolean isFence(final BlockState state) {
+        return state != null && state.identifier().endsWith("_fence");
+    }
+
+    static boolean isStairs(final BlockState state) {
+        return state != null && state.identifier().endsWith("_stairs");
+    }
+
+    private static boolean connectsFence(final BlockState fence, final BlockState adjacent,
+            final Direction direction, final Predicate<BlockState> fullBlock) {
+        if (adjacent == null || "air".equals(adjacent.identifier())) {
+            return false;
+        }
+        if (isFence(adjacent)) {
+            return fence.identifier().equals("nether_brick_fence") == adjacent.identifier().equals("nether_brick_fence");
+        }
+        if (adjacent.identifier().endsWith("_fence_gate")) {
+            final Direction gateFacing = Direction.from(adjacent.properties().get("facing"));
+            return gateFacing != null && gateFacing.axis() != direction.axis();
+        }
+        if (isStairs(adjacent)) {
+            return Direction.from(adjacent.properties().get("facing")) == direction.opposite();
+        }
+        if (adjacent.identifier().endsWith("_slab")) {
+            return "double".equals(adjacent.properties().get("type"));
+        }
+        if ("snow".equals(adjacent.identifier())) {
+            return "8".equals(adjacent.properties().get("layers"));
+        }
+        return fullBlock.test(adjacent);
+    }
+
+    private static Direction stairFacing(final BlockState state, final String half) {
+        return isStairs(state) && half != null && half.equals(state.properties().get("half"))
+                ? Direction.from(state.properties().get("facing")) : null;
+    }
+
+    private static boolean isDifferentStairs(final BlockState state, final Direction facing, final String half) {
+        return stairFacing(state, half) != facing;
+    }
+
+    private static BlockState stateAt(final BlockPosition position, final Direction direction,
+            final Function<BlockPosition, BlockState> blockAt) {
+        return blockAt.apply(new BlockPosition(position.x() + direction.dx, position.y(), position.z() + direction.dz));
+    }
+
+    private enum Direction {
+        NORTH(0, -1), EAST(1, 0), SOUTH(0, 1), WEST(-1, 0);
+
+        private final int dx;
+        private final int dz;
+
+        Direction(final int dx, final int dz) {
+            this.dx = dx;
+            this.dz = dz;
+        }
+
+        static Direction from(final String name) {
+            if (name == null) {
+                return null;
+            }
+            try {
+                return valueOf(name.toUpperCase(java.util.Locale.ROOT));
+            } catch (final IllegalArgumentException ignored) {
+                return null;
+            }
+        }
+
+        Direction opposite() {
+            return values()[(this.ordinal() + 2) & 3];
+        }
+
+        Direction left() {
+            return values()[(this.ordinal() + 3) & 3];
+        }
+
+        int axis() {
+            return this.dx == 0 ? 0 : 1;
+        }
+    }
+
+}
