+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static net.raphimc.viabedrock.protocol.storage.RedstoneWireConnections.Connection.*;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class RedstoneWireConnectionsTest {
+
+    private static final BlockPosition CENTER = new BlockPosition(0, 64, 0);
+    private static final BlockState AIR = BlockState.fromString("minecraft:air");
+    private static final BlockState WIRE = BlockState.fromString("minecraft:redstone_wire[power=7]");
+    private static final BlockState STONE = BlockState.fromString("minecraft:stone");
+
+    private final Map<BlockPosition, BlockState> blocks = new HashMap<>();
+
+    @Test
+    void connectsPistonsAlongEveryFacingInsteadOfDroppingTheCorner() {
+        this.blocks.put(new BlockPosition(0, 64, -1), WIRE);
+        for (final String piston : new String[]{"piston", "sticky_piston"}) {
+            for (final String facing : new String[]{"north", "east", "south", "west", "up", "down"}) {
+                this.blocks.put(new BlockPosition(1, 64, 0), BlockState.fromString("minecraft:" + piston + "[facing=" + facing + ",extended=false]"));
+                assertEquals(new RedstoneWireConnections.Connections(SIDE, SIDE, NONE, NONE), this.connections());
+            }
+        }
+    }
+
+    @Test
+    void isolatedWireRendersAsCrossAndKeepsItsPower() {
+        assertEquals(new RedstoneWireConnections.Connections(SIDE, SIDE, SIDE, SIDE), this.connections());
+        assertEquals(WIRE.withProperties(Map.of("north", "side", "east", "side", "south", "side", "west", "side")),
+                RedstoneWireConnections.shape(CENTER, WIRE, this::blockAt, this::conductor));
+    }
+
+    @Test
+    void horizontalWiresFormStraightLinesAndCorners() {
+        this.blocks.put(new BlockPosition(1, 64, 0), WIRE);
+        assertEquals(new RedstoneWireConnections.Connections(NONE, SIDE, NONE, SIDE), this.connections());
+
+        this.blocks.put(new BlockPosition(0, 64, -1), WIRE);
+        assertEquals(new RedstoneWireConnections.Connections(SIDE, SIDE, NONE, NONE), this.connections());
+    }
+
+    @Test
+    void wireClimbsConductorOnlyWhenSpaceAboveIsOpen() {
+        this.blocks.put(new BlockPosition(1, 64, 0), STONE);
+        this.blocks.put(new BlockPosition(1, 65, 0), WIRE);
+        assertEquals(new RedstoneWireConnections.Connections(NONE, UP, NONE, SIDE), this.connections());
+
+        this.blocks.put(new BlockPosition(0, 65, 0), STONE);
+        assertEquals(new RedstoneWireConnections.Connections(SIDE, SIDE, SIDE, SIDE), this.connections());
+    }
+
+    @Test
+    void wireConnectsDownNonConductorAndAlongRepeaterAxis() {
+        this.blocks.put(new BlockPosition(1, 63, 0), WIRE);
+        this.blocks.put(new BlockPosition(0, 64, -1), BlockState.fromString("minecraft:repeater[facing=south]"));
+        assertEquals(new RedstoneWireConnections.Connections(SIDE, SIDE, NONE, NONE), this.connections());
+    }
+
+    private RedstoneWireConnections.Connections connections() {
+        return RedstoneWireConnections.connections(CENTER, this::blockAt, this::conductor);
+    }
+
+    private BlockState blockAt(final BlockPosition position) {
+        return this.blocks.getOrDefault(position, AIR);
+    }
+
+    private boolean conductor(final BlockState state) {
+        return STONE.equals(state);
+    }
+
+}
