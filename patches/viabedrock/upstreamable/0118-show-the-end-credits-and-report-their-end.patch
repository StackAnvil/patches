+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketType;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ServerboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.java.GameEventType;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class EndCreditsPacketTest {
+
+    @Test
+    void endCreditsShowOnJavaAndTheirEndReplacesTheRespawnRequest() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var tracker = mock(EntityTracker.class);
+        final var player = mock(ClientPlayerEntity.class, CALLS_REAL_METHODS);
+        when(user.get(EntityTracker.class)).thenReturn(tracker);
+        when(tracker.getClientPlayer()).thenReturn(player);
+        final var protocol = new TestProtocol();
+        final List<PacketWrapper> events = new ArrayList<>();
+        try (var factory = mockStatic(PacketWrapper.class)) {
+            factory.when(() -> PacketWrapper.create(any(PacketType.class), eq(user))).thenAnswer(call -> {
+                final var packet = spy(new PacketWrapperImpl(call.getArgument(0), null, user));
+                doAnswer(_ -> events.add(packet)).when(packet).send(BedrockProtocol.class);
+                return packet;
+            });
+
+            assertTrue(protocol.clientbound(user, credits(player.runtimeId() + 1, 0)).isCancelled());
+            assertTrue(events.isEmpty());
+
+            assertTrue(protocol.clientbound(user, credits(player.runtimeId(), 0)).isCancelled());
+            assertEquals(1, events.size());
+            assertEquals(ClientboundPackets26_3.GAME_EVENT, events.getFirst().getPacketType());
+            assertEquals((short) GameEventType.WIN_GAME.ordinal(), events.getFirst().get(Types.UNSIGNED_BYTE, 0));
+            assertEquals(1F, events.getFirst().get(Types.FLOAT, 0));
+        }
+
+        final var end = protocol.serverbound(respawn(user));
+        assertFalse(end.isCancelled());
+        assertEquals(ServerboundBedrockPackets.SHOW_CREDITS, end.getPacketType());
+        assertEquals(player.runtimeId(), end.get(BedrockTypes.UNSIGNED_VAR_LONG, 0));
+        assertEquals(1, end.get(BedrockTypes.VAR_INT, 0));
+
+        assertEquals(ServerboundBedrockPackets.RESPAWN, protocol.serverbound(respawn(user)).getPacketType());
+    }
+
+    private static ByteBuf credits(final long runtimeId, final int status) {
+        final var buffer = Unpooled.buffer();
+        BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, runtimeId);
+        BedrockTypes.VAR_INT.write(buffer, status);
+        return buffer;
+    }
+
+    private static PacketWrapper respawn(final UserConnection user) {
+        final var buffer = Unpooled.buffer();
+        Types.VAR_INT.writePrimitive(buffer, 0); // PERFORM_RESPAWN
+        return new PacketWrapperImpl(ServerboundPackets26_3.CLIENT_COMMAND, buffer, user);
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            ClientPlayerPackets.register(this);
+        }
+
+        private PacketWrapper clientbound(final UserConnection user, final ByteBuf input) throws Exception {
+            try {
+                final var packet = new PacketWrapperImpl(ClientboundBedrockPackets.SHOW_CREDITS, input, user);
+                final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+                mapping.applyType(packet);
+                mapping.handler().handle(packet);
+                assertFalse(input.isReadable());
+                return packet;
+            } finally {
+                input.release();
+            }
+        }
+
+        private PacketWrapper serverbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+            return packet;
+        }
+    }
+
+}
