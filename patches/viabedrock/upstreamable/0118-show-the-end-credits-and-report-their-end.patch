From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:43:20 +0100
Subject: [PATCH] feat(dimension): show the End credits and report their end

Entering the End exit portal after the dragon fight left a Java player
frozen on BDS 1.26.60. The server sends ShowCredits with state 0 and
waits for the client to end the credits before it returns the player to
the Overworld. ViaBedrock dropped the packet, so Java never showed the
credits and never answered.

A native 1.26.60.5 capture of the same portal shows the credits screen
and, after Skip, sends ShowCredits for its own runtime id with state 1.
The server then sends Respawn and ChangeDimension as for any respawn.
Translate a start for the local player to Java's WIN_GAME credits event.
Java reports the closed credits with PERFORM_RESPAWN, so send the native
end report for that command instead of a respawn request.

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
index 5c78bb8f9230e7363de730eb9d69fc7b3f5be47c..817babce2d2f20efdab8da2033884f4560aff5bc 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
@@ -72,6 +72,7 @@ public class ClientPlayerEntity extends PlayerEntity {
     // Initial spawn and respawning
     private boolean initiallySpawned;
     private DimensionChangeInfo dimensionChangeInfo;
+    private boolean showingCredits;
     private boolean wasInsideUnloadedChunk;
 
     // Position syncing
@@ -459,6 +460,14 @@ public class ClientPlayerEntity extends PlayerEntity {
         this.initiallySpawned = true;
     }
 
+    public boolean showingCredits() {
+        return this.showingCredits;
+    }
+
+    public void setShowingCredits(final boolean showingCredits) {
+        this.showingCredits = showingCredits;
+    }
+
     public DimensionChangeInfo dimensionChangeInfo() {
         return this.dimensionChangeInfo;
     }
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
index dd24abc22724856490c9d3e3fbd900112fda228e..f076b23ee25bc86d9fb4f8a17d3640cf14343b98 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
@@ -77,6 +77,9 @@ import java.util.logging.Level;
 
 public final class ClientPlayerPackets {
 
+    private static final int CREDITS_START = 0;
+    private static final int CREDITS_END = 1;
+
     private static final PacketHandler CLIENT_PLAYER_GAME_MODE_INFO_UPDATE = wrapper -> {
         final ClientPlayerEntity clientPlayer = wrapper.user().get(EntityTracker.class).getClientPlayer();
 
@@ -251,6 +254,18 @@ public final class ClientPlayerPackets {
                 default -> throw new IllegalStateException("Unhandled PlayerRespawnState: " + state);
             }
         });
+        protocol.registerClientbound(ClientboundBedrockPackets.SHOW_CREDITS, null, wrapper -> {
+            wrapper.cancel();
+            final long runtimeId = wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG); // player runtime id
+            final int status = wrapper.read(BedrockTypes.VAR_INT); // credits state
+            final ClientPlayerEntity clientPlayer = wrapper.user().get(EntityTracker.class).getClientPlayer();
+            if (runtimeId != clientPlayer.runtimeId() || status != CREDITS_START || clientPlayer.showingCredits()) {
+                return;
+            }
+            // Java shows the End credits and reports their end with PERFORM_RESPAWN.
+            clientPlayer.setShowingCredits(true);
+            PacketFactory.sendJavaGameEvent(wrapper.user(), GameEventType.WIN_GAME, 1F);
+        });
         protocol.registerClientbound(ClientboundBedrockPackets.PLAYER_ACTION, null, wrapper -> {
             wrapper.cancel();
             wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG); // entity runtime id
@@ -465,6 +480,14 @@ public final class ClientPlayerPackets {
 
             switch (action) {
                 case PERFORM_RESPAWN -> {
+                    if (clientPlayer.showingCredits()) {
+                        // Native 1.26.60.5 ends the credits with ShowCredits; the server then changes dimension.
+                        clientPlayer.setShowingCredits(false);
+                        wrapper.setPacketType(ServerboundBedrockPackets.SHOW_CREDITS);
+                        wrapper.write(BedrockTypes.UNSIGNED_VAR_LONG, clientPlayer.runtimeId()); // player runtime id
+                        wrapper.write(BedrockTypes.VAR_INT, CREDITS_END); // credits state
+                        return;
+                    }
                     wrapper.write(BedrockTypes.POSITION_3F, Position3f.ZERO); // position
                     wrapper.write(Types.BYTE, (byte) PlayerRespawnState.ClientReadyToSpawn.getValue()); // state
                     wrapper.write(BedrockTypes.UNSIGNED_VAR_LONG, clientPlayer.runtimeId()); // entity runtime id
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/EndCreditsPacketTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/EndCreditsPacketTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..33c186077f1730e6e20a7fe757e25ee572abc869
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/EndCreditsPacketTest.java
@@ -0,0 +1,109 @@
+/*
