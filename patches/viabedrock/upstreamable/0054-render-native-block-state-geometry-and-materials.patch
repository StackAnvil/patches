+        axis.put("range", range);
+        axis.putInt("steps", 5);
+        offset.put("x", axis);
+        components.put("minecraft:random_offset", offset);
+        final var shifted = CustomBlockModel.compile(storage, "test:block", 1, components);
+        assertEquals(new net.raphimc.viabedrock.api.model.CustomBlockOffset.Axis(-0.1875F, 0.1875F, 5), shifted.randomOffset().x());
+        assertEquals(baseline.modelJson(), shifted.modelJson());
+        assertEquals(baseline.collisionBoxes(), shifted.collisionBoxes());
+        assertEquals(baseline.occluding(), shifted.occluding());
+        final var metadata = net.raphimc.viabedrock.api.model.CustomBlockProperties.decode(
+                net.raphimc.viabedrock.api.model.CustomBlockProperties.encode(List.of(shifted)));
+        assertEquals(shifted.randomOffset(), metadata.get(1).randomOffset());
