+package net.raphimc.viabedrock.api.model;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import static org.junit.jupiter.api.Assertions.*;
+import static net.raphimc.viabedrock.api.model.CustomBlockCulling.*;
+
+class CustomBlockCullingTest {
+
+    @Test
+    void acceptsOnlyTheAuthoredConditionsSupportedByTheTargetNativeParser() {
+        assertEquals(Condition.DEFAULT, Condition.fromAuthored(null));
+        assertEquals(Condition.SAME_BLOCK, Condition.fromAuthored("same_block"));
+        assertEquals(Condition.SAME_BLOCK_PERMUTATION, Condition.fromAuthored("same_block_permutation"));
+        assertEquals(Condition.SAME_CULLING_LAYER, Condition.fromAuthored("same_culling_layer"));
+        assertThrows(IllegalArgumentException.class, () -> Condition.fromAuthored("default"));
+    }
+
+    @Test
+    void comparesUnionCoverageAcrossUnequalGridsWithoutFillingHoles() {
+        final var full = new Rectangle(0, 0, 1, 1);
+        final var target = List.of(new Rectangle(0, 0, 0.75, 0.5), new Rectangle(0.25, 0.5, 1, 1));
+        assertTrue(covers(target, List.of(full)));
+        assertTrue(covers(List.of(full), List.of(new Rectangle(0, 0, 0.5, 1), new Rectangle(0.5, 0, 1, 0.75), new Rectangle(0.5, 0.75, 1, 1))));
+        assertFalse(covers(List.of(full), List.of(new Rectangle(0, 0, 0.5, 1), new Rectangle(0.5, 0, 1, 0.49), new Rectangle(0.5, 0.5, 1, 1))));
+        assertFalse(covers(List.of(new Rectangle(-0.25, 0, 1, 1)), List.of(full)));
+        assertFalse(covers(List.of(), List.of(full)));
+        assertFalse(covers(List.of(full), List.of()));
+    }
+
+    @Test
+    void roundTripsRouteIndependentSlicesAndRejectsInvalidBoundariesOrVersions() {
+        final var definition = new Definition("test:block", "test:block[lit=true]", "test:glass",
+            Map.of(Direction.NORTH, List.of(new Rectangle(0, 0, 1, 0.5))), Set.of(Direction.NORTH));
+        final JsonObject model = new JsonObject();
+        model.add(KEY, json(definition));
+        final var visual = new CustomBlockVisual("test:block", 42, "texture", model.toString(), "opaque", List.of(), List.of(), false, 0, 0, Map.of(), Map.of(), CustomBlockOffset.NONE);
+        final JsonObject metadata = encode(Map.of(42, visual));
+        assertEquals(Map.of(42, definition), decode(metadata));
+        assertThrows(UnsupportedOperationException.class, () -> decode(metadata).get(42).slice(Direction.NORTH).clear());
+        metadata.addProperty("java_protocol", -1);
+        assertThrows(IllegalArgumentException.class, () -> decode(metadata));
+        assertThrows(IllegalArgumentException.class, () -> new Rectangle(0, 0, Double.NaN, 1));
+        assertThrows(IllegalArgumentException.class, () -> new Rectangle(0, 1, 1, 0));
+    }
+
+}
