+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Assumptions;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockLightingTest {
+
+    @Test
+    void exponentIncludesDimmingAndKeepsUntintedWorldLightSeparate() {
+        assertEquals(0.16F, new CustomBlockLighting(2F, true).shade(0.5F, 0.8F), 1E-7F);
+        assertEquals(0.25F, new CustomBlockLighting(2F, false).shade(0.5F, 0.8F));
+        assertEquals(1F, new CustomBlockLighting(0F, true).shade(0.2F, 0.5F));
+        assertEquals(0.4F, new CustomBlockLighting(1F, true).shade(0.5F, 0.8F));
+        assertEquals(0F, new CustomBlockLighting(10F, true).shade(0F, 0.8F));
+    }
+
+    @Test
+    void cornerLightKeepsIndependentChannelMaximaAndDarkSamples() {
+        assertEquals(0x00F000F0, CustomBlockLighting.maximumLight(0x000000F0, 0x00F00000, 0x00300040, 0));
+        assertEquals(0x00900070, CustomBlockLighting.maximumLight(0, 0x00900000, 0, 0x00000070));
+        assertEquals(0, CustomBlockLighting.maximumLight(0, 0, 0, 0));
+        // Smooth channels can retain fractional levels after interpolation.
+        assertEquals(0x00BD00E7, CustomBlockLighting.maximumLight(0x002400E7, 0x00BD0008, 0, 0x008400C9));
+    }
+
+    @Test
+    void emissionPreservesSkylightAndFacePlaneUsesNativeTolerance() {
+        assertEquals(0x003000F0, CustomBlockFaceLighting.withBlockEmission(0x00300020, 15));
+        assertEquals(0x00F00080, CustomBlockFaceLighting.withBlockEmission(0x00F00080, 7));
+        for (final var direction : CustomBlockCulling.Direction.values()) {
+            final float boundary = direction.positive() ? 0.9995F : 0.0005F;
+            assertTrue(CustomBlockFaceLighting.outerPlane(direction, boundary));
+            assertFalse(CustomBlockFaceLighting.outerPlane(direction, direction.positive() ? Math.nextDown(boundary) : Math.nextUp(boundary)));
+            assertTrue(CustomBlockFaceLighting.outerPlane(direction, direction.positive() ? Math.nextUp(boundary) : Math.nextDown(boundary)));
+        }
+    }
+
+    @Test
+    void insetFaceUsesSourceLightAndOutsideAmbientSample() {
+        final var face = CustomBlockFaceLighting.sample(CustomBlockCulling.Direction.UP, false, true, 0x003000E0,
+                new CustomBlockLighting(1F, false), 0.5F, (x, y, z) -> new CustomBlockFaceLighting.Sample(
+                        y == 0 ? 0x00600040 : 0x00F000F0, y == 0 ? 1F : 0.2F, false));
+        for (boolean inner : new boolean[]{false, true}) {
+            for (boolean outer : new boolean[]{false, true}) {
+                assertEquals(0x006000E0, face.corner(inner, outer).light());
+                assertEquals(0.8F, face.corner(inner, outer).shade());
+            }
+        }
+    }
+
+    @Test
+    void interpolationKeepsNativeFloatGroupingAndCornerEndpoints() {
+        assertEquals(0.2F, CustomBlockLighting.interpolate(0.2F, 0.4F, 0.6F, 0.8F, 0F, 0F));
+        assertEquals(0.4F, CustomBlockLighting.interpolate(0.2F, 0.4F, 0.6F, 0.8F, 1F, 0F));
+        assertEquals(0.6F, CustomBlockLighting.interpolate(0.2F, 0.4F, 0.6F, 0.8F, 0F, 1F));
+        assertEquals(0.8F, CustomBlockLighting.interpolate(0.2F, 0.4F, 0.6F, 0.8F, 1F, 1F));
+        // A four-term weighted sum packs this native 0.6 corner blend one color level darker.
+        assertEquals(153, (int) (CustomBlockLighting.interpolate(0.6F, 0.8F, 0.4F, 0.6F, 0.875F, 0.875F) * 255F));
+        assertEquals(101, (int) (CustomBlockLighting.interpolate(0.4F, 0.3F, 0.5F, 0.4F, 0.125F, 0.125F) * 255F));
+        // Authored bounds can extend outside a unit block. Interpolation precedes color clamping.
+        assertEquals(1.5F, CustomBlockLighting.interpolate(0F, 1F, 0F, 1F, 1.5F, 0.5F));
+    }
+
+    @Test
+    void nativeFaceSubmissionsMatchInterpolation() throws Exception {
+        final String fixture = System.getProperty("stackanvil.test.nativeFaceColors");
+        Assumptions.assumeTrue(fixture != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("cases");
+        assertFalse(cases.isEmpty());
+        for (final var value : cases) {
+            final var sample = value.getAsJsonObject();
+            final var corners = sample.getAsJsonArray("corners");
+            final float actual = CustomBlockLighting.interpolate(corners.get(0).getAsFloat(), corners.get(1).getAsFloat(),
+                    corners.get(2).getAsFloat(), corners.get(3).getAsFloat(), sample.get("inner").getAsFloat(), sample.get("outer").getAsFloat());
+            assertEquals(sample.get("nativeColor").getAsInt() & 0xFF, Math.clamp((int) (actual * 255F), 0, 255));
+        }
+    }
+
+    @Test
+    void nativeCornerNeighborhoodsMatchMaximumLight() throws Exception {
+        final String fixture = System.getProperty("stackanvil.test.nativeCornerLight");
+        Assumptions.assumeTrue(fixture != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("cases");
+        assertFalse(cases.isEmpty());
+        for (var value : cases) {
+            for (var corner : value.getAsJsonObject().getAsJsonArray("corners")) {
+                final var sample = corner.getAsJsonObject();
+                final var inputs = sample.getAsJsonArray("inputs");
+                assertEquals(javaLight(sample.get("light").getAsInt()), CustomBlockLighting.maximumLight(
+                        javaLight(inputs.get(0).getAsInt()), javaLight(inputs.get(1).getAsInt()),
+                        javaLight(inputs.get(2).getAsInt()), javaLight(inputs.get(3).getAsInt())));
+            }
+        }
+    }
+
+    @Test
+    void nativeNeighborhoodSelectionMatchesAllFacesAndBlockers() throws Exception {
+        final String fixture = System.getProperty("stackanvil.test.nativeNeighborhood");
+        Assumptions.assumeTrue(fixture != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("cases");
+        assertFalse(cases.isEmpty());
+        for (final var value : cases) {
+            final var row = value.getAsJsonObject();
+            final var direction = CustomBlockCulling.Direction.values()[row.get("face").getAsInt()];
+            final var samples = new HashMap<List<Integer>, CustomBlockFaceLighting.Sample>();
+            for (final var element : row.getAsJsonArray("samples")) {
+                final var sample = element.getAsJsonObject();
+                final var offset = sample.getAsJsonArray("offset");
+                samples.put(List.of(offset.get(0).getAsInt(), offset.get(1).getAsInt(), offset.get(2).getAsInt()),
+                        new CustomBlockFaceLighting.Sample(javaLight(sample.get("light").getAsInt()), sample.get("ambient").getAsFloat(), sample.get("opaque").getAsBoolean()));
+            }
+            final var actual = CustomBlockFaceLighting.sample(direction, row.get("outer").getAsInt() != 0, row.get("ownSolid").getAsInt() != 0,
+                    javaLight(row.get("sourceLight").getAsInt()), new CustomBlockLighting(1F, true), 0.8F,
+                    (x, y, z) -> samples.get(List.of(x, y, z)));
+            // Physical native vertex order, independently recorded by the original face emitters.
+            final int[][] cornerOrder = {{0, 2, 3, 1}, {1, 3, 2, 0}, {2, 0, 1, 3}, {3, 1, 0, 2}, {3, 1, 0, 2}, {2, 0, 1, 3}};
+            for (int i = 0; i < 4; i++) {
+                final int index = cornerOrder[direction.ordinal()][i];
+                final var corner = actual.corner((index & 1) != 0, (index & 2) != 0);
+                final var expected = row.getAsJsonArray("corners").get(i).getAsJsonObject();
+                assertEquals(javaLight(expected.get("light").getAsInt()), corner.light());
+                assertEquals(expected.get("color").getAsFloat(), corner.shade(), 2E-7F);
+            }
+        }
+    }
+
+    private static int javaLight(final int nativeLight) {
+        return (((nativeLight >>> 8) & 0xFF) << 4) | ((nativeLight & 0xFF) << 20);
+    }
+
+    @Test
+    void nativeWorldReadsPreservePhysicalLightChannels() throws Exception {
+        final String fixture = System.getProperty("stackanvil.test.nativeWorldLight");
+        Assumptions.assumeTrue(fixture != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("cases");
+        assertFalse(cases.isEmpty());
+        for (final var value : cases) {
+            final var sample = value.getAsJsonObject();
+            assertEquals(sample.get("javaLight").getAsInt(), javaLight(sample.get("nativeLight").getAsInt()));
+        }
+    }
+
+    @Test
+    void nativeCornerSamplesMatchMaterialCalculation() throws Exception {
+        final String fixture = System.getProperty("stackanvil.test.nativeAo");
+        Assumptions.assumeTrue(fixture != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("cases");
+        for (var value : cases) {
+            final var sample = value.getAsJsonObject();
+            final var lighting = new CustomBlockLighting(sample.get("exponent").getAsFloat(), true);
+            final float actual = lighting.shade(sample.get("ao").getAsFloat(), sample.get("dimming").getAsFloat());
+            final var colors = sample.getAsJsonArray("colors");
+            for (int corner = 0; corner < 4; corner++) {
+                for (int channel = 0; channel < 3; channel++) {
+                    assertEquals(colors.get(corner * 4 + channel).getAsFloat(), actual, 2E-7F);
+                }
+                assertEquals(1F, colors.get(corner * 4 + 3).getAsFloat());
+            }
+            assertEquals(lighting, CustomBlockLighting.fromJson(lighting.json()));
+        }
+    }
+
+}
