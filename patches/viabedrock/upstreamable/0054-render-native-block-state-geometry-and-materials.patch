+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+/** Native BlockLegacy identity and the auxiliary value stored by its canonical palette entry. */
+public record BlockItemDescriptor(int legacyId, short auxiliary) {
+
+    public BlockItemDescriptor {
+        if (legacyId < 0 || legacyId > 0xFFFF) {
+            throw new IllegalArgumentException("Block legacy ID must fit an unsigned short");
+        }
+    }
+
+    public int numericItemId() {
+        return numericItemId(this.legacyId);
+    }
+
+    /** Numeric ownership does not depend on an archetype's auxiliary encoding. */
+    public static int numericItemId(final int legacyId) {
+        if (legacyId < 0 || legacyId > 0xFFFF) {
+            throw new IllegalArgumentException("Block legacy ID must fit an unsigned short");
+        }
+        return legacyId <= 255 ? legacyId : (255 - legacyId) & 0xFFFF;
+    }
+
+}
