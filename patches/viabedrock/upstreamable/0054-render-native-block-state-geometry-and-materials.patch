+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CustomBlockModel;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockBoneGeometryTest {
+
+    @Test
+    void inheritsSkullYawAndInflatesBothHatFacesWithoutChangingUvOrSource() {
+        final ResourcePackStorage storage = storage("""
+                {"name":"head","pivot":[0,24,0],"rotation":[0,22.5,0],
+                 "cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"uv":[0,0]}]},
+                {"name":"hat","parent":"head","pivot":[0,24,0],
+                 "cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"inflate":0.25,"uv":[32,0]}]}
+                """);
+        final JsonObject model = compile(storage);
+        final var elements = model.getAsJsonArray("elements");
+        assertEquals(2, elements.size());
+        final JsonObject head = elements.get(0).getAsJsonObject();
+        final JsonObject hat = elements.get(1).getAsJsonObject();
+        assertVector(head, "from", 4, 0, 4);
+        assertVector(head, "to", 12, 8, 12);
+        assertVector(hat, "from", 3.75, -0.25, 3.75);
+        assertVector(hat, "to", 12.25, 8.25, 12.25);
+        assertEquals(-22.5, head.getAsJsonObject("rotation").get("y").getAsDouble(), 1E-8);
+        assertEquals(head.getAsJsonObject("rotation"), hat.getAsJsonObject("rotation"));
+        assertEquals(model, compile(storage));
+        final var original = storage.getModels().blockModels().get("geometry.test").getParents().get(1).getCubes().get(0);
+        assertEquals(-4, original.getPosition().getX());
+        assertEquals(8, original.getSize().getX());
+        assertEquals(0.25, original.getInflate());
+
+        final ResourcePackStorage unrotated = storage("""
+                {"name":"hat","cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"inflate":0.25,"uv":[32,0]}]}
+                """);
+        assertEquals(compile(unrotated).getAsJsonArray("elements").get(0).getAsJsonObject().get("faces"), hat.get("faces"));
+    }
+
+    @Test
+    void composesCubeChildAndAncestorRotationsAroundTheirOwnPivots() {
+        final ResourcePackStorage storage = storage("""
+                {"name":"root","pivot":[1,0,0],"rotation":[0,90,0]},
+                {"name":"child","parent":"root","pivot":[0,1,0],"rotation":[90,0,0],
+                 "cubes":[{"origin":[0,0,0],"size":[2,4,6],"pivot":[1,2,3],"rotation":[0,0,90],"uv":[0,0]}]}
+                """);
+        final JsonObject element = compile(storage).getAsJsonArray("elements").get(0).getAsJsonObject();
+        assertVector(element, "from", 7, 2, 5);
+        assertVector(element, "to", 9, 6, 11);
+        assertVector(element.getAsJsonObject("rotation"), "origin", 8, 4, 8);
+        // R_y(-90) R_x(-90) R_z(90) sends each local (x,y,z) to (x,z,-y).
+        final JsonObject rotation = element.getAsJsonObject("rotation");
+        assertArrayEquals(new double[]{1, 0, 0}, rotated(rotation, 1, 0, 0), 1E-8);
+        assertArrayEquals(new double[]{0, 0, -1}, rotated(rotation, 0, 1, 0), 1E-8);
+        assertArrayEquals(new double[]{0, 1, 0}, rotated(rotation, 0, 0, 1), 1E-8);
+    }
+
+    @Test
+    void composesFloorBoneYawWithTheBlockStateQuarterTurn() {
+        final ResourcePackStorage storage = storage("""
+                {"name":"head","pivot":[0,24,0],"rotation":[0,22.5,0],
+                 "cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"uv":[0,0]}]}
+                """);
+        final CompoundTag transformation = new CompoundTag();
+        transformation.putInt("RY", 1);
+        final JsonObject rotation = compile(storage, transformation).getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("rotation");
+        final double yaw = Math.toRadians(-112.5);
+        assertArrayEquals(new double[]{Math.cos(yaw), 0, -Math.sin(yaw)}, rotated(rotation, 1, 0, 0), 1E-8);
+        assertArrayEquals(new double[]{Math.sin(yaw), 0, Math.cos(yaw)}, rotated(rotation, 0, 0, 1), 1E-8);
+    }
+
+    @Test
+    void appliesEachBoneToItsEmittedCubesAfterInvisibleCubesAreRemoved() {
+        final ResourcePackStorage storage = storage("""
+                {"name":"root","pivot":[0,0,0],"rotation":[0,90,0],
+                 "cubes":[{"origin":[0,0,0],"size":[2,2,2],"uv":{}}]},
+                {"name":"child","parent":"root","pivot":[0,0,0],"rotation":[90,0,0],
+                 "cubes":[{"origin":[0,0,0],"size":[2,4,6],"pivot":[1,2,3],"rotation":[0,0,90],
+                           "uv":{"north":{"uv":[0,0],"uv_size":[2,4]}}},
+                          {"origin":[0,0,0],"size":[1,1,1],"uv":{}}]},
+                {"name":"separate","pivot":[0,0,0],"rotation":[0,0,90],
+                 "cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"uv":[0,0]}]}
+                """);
+        final JsonObject model = compile(storage);
+        final var elements = model.getAsJsonArray("elements");
+        assertEquals(2, elements.size());
+        final JsonObject child = elements.get(0).getAsJsonObject();
+        assertVector(child, "from", 9, 1, 4);
+        assertVector(child, "to", 11, 5, 10);
+        assertVector(child.getAsJsonObject("rotation"), "origin", 10, 3, 7);
+        assertArrayEquals(new double[]{0, 0, -1}, rotated(child.getAsJsonObject("rotation"), 0, 1, 0), 1E-8);
+        assertEquals(1, child.getAsJsonObject("faces").size());
+        assertEquals(0.5, child.getAsJsonObject("faces").getAsJsonObject("north").getAsJsonArray("uv").get(2).getAsDouble());
+        final JsonObject separate = elements.get(1).getAsJsonObject();
+        assertVector(separate, "from", 0, -4, 4);
+        assertVector(separate, "to", 8, 4, 12);
+        assertEquals(90, separate.getAsJsonObject("rotation").get("z").getAsDouble(), 1E-8);
+        assertEquals(6, separate.getAsJsonObject("faces").size());
+        assertEquals(model, compile(storage));
+        final var source = storage.getModels().blockModels().get("geometry.test").getParents();
+        assertEquals(1, source.get(0).getCubes().size());
+        assertEquals(2, source.get(1).getCubes().size());
+        assertTrue(source.get(0).getCubes().get(0).getUvMap().getUvMap().isEmpty());
+        assertEquals(0, source.get(1).getCubes().get(0).getPosition().getX());
+    }
+
+    @Test
+    void rejectsInvalidBoneHierarchiesWithoutDroppingTransforms() {
+        for (String parents : List.of("\"parent\":\"root\"", "\"parent\":\"missing\"")) {
+            final ResourcePackStorage storage = storage("{\"name\":\"root\"," + parents
+                    + ",\"cubes\":[{\"origin\":[0,0,0],\"size\":[1,1,1],\"uv\":[0,0]}]}");
+            assertThrows(IllegalArgumentException.class, () -> compile(storage));
+        }
+    }
+
+    private static double[] rotated(final JsonObject rotation, final double x, final double y, final double z) {
+        final double rx = Math.toRadians(rotation.get("x").getAsDouble());
+        final double ry = Math.toRadians(rotation.get("y").getAsDouble());
+        final double rz = Math.toRadians(rotation.get("z").getAsDouble());
+        final double y1 = y * Math.cos(rx) - z * Math.sin(rx);
+        final double z1 = y * Math.sin(rx) + z * Math.cos(rx);
+        final double x2 = x * Math.cos(ry) + z1 * Math.sin(ry);
+        final double z2 = -x * Math.sin(ry) + z1 * Math.cos(ry);
+        return new double[]{x2 * Math.cos(rz) - y1 * Math.sin(rz), x2 * Math.sin(rz) + y1 * Math.cos(rz), z2};
+    }
+
+    private static void assertVector(final JsonObject object, final String key, final double... expected) {
+        final var values = object.getAsJsonArray(key);
+        for (int i = 0; i < expected.length; i++) {
+            assertEquals(expected[i], values.get(i).getAsDouble(), 1E-8);
+        }
+    }
+
+    private static JsonObject compile(final ResourcePackStorage storage) {
+        return compile(storage, new CompoundTag());
+    }
+
+    private static JsonObject compile(final ResourcePackStorage storage, final CompoundTag transformation) {
+        final CompoundTag components = new CompoundTag();
+        components.putString("minecraft:geometry", "geometry.test");
+        final CompoundTag materials = new CompoundTag();
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", "skin");
+        materials.put("*", material);
+        components.put("minecraft:material_instances", materials);
+        components.put("minecraft:transformation", transformation);
+        final var visual = CustomBlockModel.compile(storage, "test:skull", 1, components);
+        assertNotNull(visual);
+        return JsonParser.parseString(visual.modelJson()).getAsJsonObject();
+    }
+
+    private static ResourcePackStorage storage(final String bones) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"skin\":{\"textures\":\"textures/blocks/skin\"}}}");
+        content.putPngImage("textures/blocks/skin.png", new BufferedImage(64, 64, BufferedImage.TYPE_INT_RGB));
+        content.putString("models/blocks/test.json", "{\"format_version\":\"1.12.0\",\"minecraft:geometry\":[{\"description\":{\"identifier\":\"geometry.test\",\"texture_width\":64,\"texture_height\":64},\"bones\":[" + bones + "]}]}");
+        return new ResourcePackStorage(List.of(new ResourcePack(content)));
+    }
+
+}
