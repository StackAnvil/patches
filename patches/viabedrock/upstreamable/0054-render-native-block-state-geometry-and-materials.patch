+    @Test
+    void carriesServerPixelOffsetRangesWithoutApplyingThemToCullingOrModelVertices() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final CompoundTag components = components("geometry.test", "ruby", "opaque");
+        final var baseline = CustomBlockModel.compile(storage, "test:block", 1, components);
+        final CompoundTag offset = new CompoundTag();
+        final CompoundTag axis = new CompoundTag();
+        final CompoundTag range = new CompoundTag();
+        range.putFloat("min", -3);
