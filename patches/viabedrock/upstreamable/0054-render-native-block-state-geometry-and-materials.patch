+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import net.raphimc.viabedrock.api.util.MoLangEngine;
+import org.redlance.mocha.parser.ast.Expression;
+import org.redlance.mocha.runtime.Scope;
+import org.redlance.mocha.runtime.value.Function;
+import org.redlance.mocha.runtime.value.MutableObjectBinding;
+import org.redlance.mocha.runtime.value.Value;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** Resolves component overlays against one concrete state without modifying server definitions. */
+public final class CustomBlockDefinition {
+
+    private final CompoundTag base;
+    private final List<Permutation> permutations;
+
+    public CustomBlockDefinition(final CompoundTag definition) throws IOException {
+        this.base = definition.get("components") instanceof CompoundTag components ? components.copy() : new CompoundTag();
+        final List<Permutation> compiled = new ArrayList<>();
+        final ListTag<CompoundTag> source = definition.getListTag("permutations", CompoundTag.class);
+        if (source != null) {
+            for (CompoundTag permutation : source) {
+                if (permutation.get("condition") instanceof StringTag condition) {
+                    compiled.add(new Permutation(MoLangEngine.parse(condition.getValue()),
+                            permutation.get("components") instanceof CompoundTag overlay ? overlay.copy() : null));
+                }
+            }
+        }
+        this.permutations = List.copyOf(compiled);
+    }
+
+    public CompoundTag resolve(final CompoundTag states) {
+        final CompoundTag components = this.base.copy();
+        final Scope scope = Scope.create();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        final Function<Void> property = (context, arguments) -> {
+            final Value argument = arguments.next().eval();
+            final Tag value = argument == null ? null : states.get(argument.getAsString());
+            return value == null ? Value.nil() : Value.of(value.getValue());
+        };
+        queries.set("block_property", property);
+        queries.set("block_state", property);
+        queries.block();
+        scope.set("query", queries);
+        scope.set("q", queries);
+        scope.readOnly(true);
+        for (Permutation permutation : this.permutations) {
+            if (MoLangEngine.eval(scope, permutation.condition()).getAsNumber() != 0 && permutation.components() != null) {
+                for (Map.Entry<String, Tag> component : permutation.components()) {
+                    components.put(component.getKey(), component.getValue().copy());
+                }
+            }
+        }
+        return components;
+    }
+
+    private record Permutation(List<Expression> condition, CompoundTag components) {
+    }
+
+}
