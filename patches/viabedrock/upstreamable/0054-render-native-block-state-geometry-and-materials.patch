+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+
+import java.util.ArrayDeque;
+import java.util.Objects;
+import java.util.Queue;
+import java.util.function.BiConsumer;
+
+/** Buffers ordered world packets while Java loads resources or initializes its play listener. */
+public final class WorldPacketBuffer implements StorableObject {
+
+    private static final int MAX_BYTES = 64 * 1024 * 1024;
+    private static final int MAX_PACKETS = 10000;
+    private final Queue<Packet> packets = new ArrayDeque<>();
+    private int bytes;
+
+    public void awaitClient(final UserConnection user) {
+        user.put(this);
+        // Java handles this ping on the login packet thread, after Fabric registers its play channels.
+        user.get(PacketSyncStorage.class).syncWithClient(() -> {
+            if (!user.getChannel().isActive() || user.get(WorldPacketBuffer.class) != this) {
+                return;
+            }
+            user.remove(WorldPacketBuffer.class);
+            this.drain(user);
+        });
+    }
+
+    public void queue(final ClientboundBedrockPackets type, final byte[] payload) {
+        if (this.packets.size() == MAX_PACKETS || payload.length > MAX_BYTES - this.bytes) {
+            throw new IllegalStateException("World packets exceeded the Java initialization buffer");
+        }
+        this.packets.add(new Packet(Objects.requireNonNull(type), payload.clone()));
+        this.bytes += payload.length;
+    }
+
+    public void drain(final UserConnection user) {
+        this.drain((type, payload) -> {
+            final ByteBuf input = Unpooled.wrappedBuffer(payload);
+            try {
+                PacketFactory.replayClientbound(PacketWrapper.create(type, input, user));
+            } finally {
+                input.release();
+            }
+        });
+    }
+
+    public void drain(final BiConsumer<ClientboundBedrockPackets, byte[]> receiver) {
+        Packet packet;
+        while ((packet = this.packets.poll()) != null) {
+            this.bytes -= packet.payload.length;
+            receiver.accept(packet.type, packet.payload);
+        }
+    }
+
+    public int packetCount() {
+        return this.packets.size();
+    }
+
+    private record Packet(ClientboundBedrockPackets type, byte[] payload) {
+    }
+
+}
