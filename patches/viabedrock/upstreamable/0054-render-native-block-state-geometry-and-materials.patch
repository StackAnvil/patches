+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Direction;
+
+/** Native terrain neighborhood selection, independent of the client renderer and world storage. */
+public final class CustomBlockFaceLighting {
+
+    // Side order follows the native corner winding, including the face's orientation.
+    private static final Direction[][] SIDES = {
+            {Direction.NORTH, Direction.WEST, Direction.SOUTH, Direction.EAST},
+            {Direction.NORTH, Direction.EAST, Direction.SOUTH, Direction.WEST},
+            {Direction.UP, Direction.WEST, Direction.DOWN, Direction.EAST},
+            {Direction.UP, Direction.EAST, Direction.DOWN, Direction.WEST},
+            {Direction.UP, Direction.SOUTH, Direction.DOWN, Direction.NORTH},
+            {Direction.UP, Direction.NORTH, Direction.DOWN, Direction.SOUTH}
+    };
+
+    private CustomBlockFaceLighting() {
+    }
+
+    /** Native bounds use a half-thousandth tolerance, independently of source block solidity. */
+    public static boolean outerPlane(final Direction direction, final float bound) {
+        return direction.positive() ? bound >= 0.9995F : bound <= 0.0005F;
+    }
+
+    /** Apply authored emission only to block light. Emission does not create skylight. */
+    public static int withBlockEmission(final int light, final int emission) {
+        return (light & 0xFF0000) | Math.max(light & 0xFF, Math.clamp(emission, 0, 15) << 4);
+    }
+
+    public static Face sample(final Direction direction, final boolean outer, final boolean sourceOpaque,
+                              final int sourceLight, final CustomBlockLighting material, final float directional,
+                              final Neighborhood neighborhood) {
+        final int nx = step(direction, 0);
+        final int ny = step(direction, 1);
+        final int nz = step(direction, 2);
+        final Sample normal = neighborhood.sample(nx, ny, nz);
+        final int baseLight = outer && sourceOpaque ? normal.light() : sourceLight;
+        final int px = outer ? nx : 0;
+        final int py = outer ? ny : 0;
+        final int pz = outer ? nz : 0;
+        final Direction[] directions = SIDES[direction.ordinal()];
+        final Sample[] sides = new Sample[4];
+        for (int i = 0; i < 4; i++) {
+            sides[i] = neighborhood.sample(px + step(directions[i], 0), py + step(directions[i], 1), pz + step(directions[i], 2));
+        }
+        final Corner[] corners = new Corner[4];
+        for (int i = 0; i < 4; i++) {
+            final int next = (i + 1) & 3;
+            final int x = step(directions[i], 0) + step(directions[next], 0);
+            final int y = step(directions[i], 1) + step(directions[next], 1);
+            final int z = step(directions[i], 2) + step(directions[next], 2);
+            // Native diagonal blockers are the sampled sides, without an additional outward step.
+            final Sample diagonal = sides[i].opaque() && sides[next].opaque() ? sides[next] : neighborhood.sample(px + x, py + y, pz + z);
+            final float ambient = (normal.ambient() + sides[i].ambient() + sides[next].ambient() + diagonal.ambient()) * 0.25F;
+            final int inner = direction.axis() == 0 ? z : x;
+            final int outerAxis = direction.axis() == 1 ? z : y;
+            final int index = (inner > 0 ? 1 : 0) | (outerAxis > 0 ? 2 : 0);
+            corners[index] = new Corner(CustomBlockLighting.maximumLight(sides[i].light(), sides[next].light(), diagonal.light(), baseLight),
+                    material.shade(ambient, directional));
+        }
+        return new Face(corners[0], corners[1], corners[2], corners[3]);
+    }
+
+    private static int step(final Direction direction, final int axis) {
+        return direction.axis() == axis ? (direction.positive() ? 1 : -1) : 0;
+    }
+
+    @FunctionalInterface
+    public interface Neighborhood {
+        Sample sample(int x, int y, int z);
+    }
+
+    /** Opacity controls the diagonal fallback; ambient brightness is a separate native property. */
+    public record Sample(int light, float ambient, boolean opaque) {
+    }
+
+    public record Corner(int light, float shade) {
+    }
+
+    /** Inner axis is X for horizontal/North/South faces and Z for West/East faces. */
+    public record Face(Corner lowerLower, Corner upperLower, Corner lowerUpper, Corner upperUpper) {
+
+        public Corner corner(final boolean upperInner, final boolean upperOuter) {
+            return upperOuter ? (upperInner ? this.upperUpper : this.lowerUpper) : (upperInner ? this.upperLower : this.lowerLower);
+        }
+
+        public float shade(final float inner, final float outer) {
+            return CustomBlockLighting.interpolate(this.lowerLower.shade(), this.upperLower.shade(), this.lowerUpper.shade(), this.upperUpper.shade(), inner, outer);
+        }
+    }
+
+}
