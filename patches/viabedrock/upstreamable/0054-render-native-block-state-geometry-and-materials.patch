+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class RuntimeBlockPaletteTest {
+
+    @Test
+    void numericSlotsKeepDistinctObjectsWithEqualSerializedProperties() {
+        final var first = state(10);
+        final var second = state(10);
+        assertEquals(first, second);
+        final var input = new ArrayList<>(List.of(first, second));
+        final var palette = new RuntimeBlockPalette(input, false);
+        input.clear();
+        assertSame(first, palette.state(0));
+        assertSame(second, palette.state(1));
+        assertEquals(1, palette.identifier(first));
+        assertEquals(0, palette.registeredIdentifier(first));
+        assertEquals(1, palette.registeredIdentifier(second));
+        assertEquals(-1, palette.registeredIdentifier(state(10)));
+        assertEquals(-1, palette.registeredIdentifier(null));
+        assertNull(palette.state(2));
+        assertEquals(-1, palette.identifier(null));
+        assertEquals(List.of(0, 1), palette.registrations().stream().map(RuntimeBlockPalette.Registration::identifier).toList());
+        assertThrows(UnsupportedOperationException.class, () -> palette.registrations().clear());
+    }
+
+    @Test
+    void hashCollisionsRetainEverySlotAcrossWraparoundAndOccupiedSuccessors() {
+        final var states = List.of(state(Integer.MAX_VALUE), state(Integer.MIN_VALUE), state(Integer.MAX_VALUE), state(Integer.MAX_VALUE));
+        final var palette = new RuntimeBlockPalette(states, true);
+        final var expected = List.of(Integer.MAX_VALUE, Integer.MIN_VALUE, Integer.MIN_VALUE + 1, Integer.MIN_VALUE + 2);
+        assertEquals(expected, palette.registrations().stream().map(RuntimeBlockPalette.Registration::identifier).toList());
+        for (int index = 0; index < states.size(); index++) {
+            assertSame(states.get(index), palette.state(expected.get(index)));
+            assertEquals(expected.get(index), palette.registeredIdentifier(states.get(index)));
+        }
+        assertEquals(Integer.MIN_VALUE + 2, palette.identifier(states.getFirst()));
+    }
+
+    private static BedrockBlockState state(final int hash) {
+        final var tag = new CompoundTag();
+        tag.putString("name", "probe:block");
+        tag.put("states", new CompoundTag());
+        tag.putInt("network_id", hash);
+        return BedrockBlockState.fromNbt(tag);
+    }
+
+}
