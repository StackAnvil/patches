+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class TextureDefinitionsTest {
+
+    @Test
+    void keepsObjectAndArrayItemTexturePathsInNativeOrderAndHonorsOverrides() {
+        final ResourcePack lower = pack("{\"icon\":{\"textures\":\"old\"},\"unsupported\":{\"textures\":\"old\"}}");
+        final ResourcePack higher = pack("{\"icon\":{\"textures\":[{\"path\":\"custom/icon\"},\"custom/other\"]},\"single\":{\"textures\":{\"path\":\"custom/single\"}},\"unsupported\":{\"textures\":{}}}");
+        final var storage = mock(ResourcePackStorage.class);
+        when(storage.getPackStackBottomToTop()).thenReturn(List.of(lower, higher));
+        final var textures = new TextureDefinitions(storage).itemTextures();
+        assertEquals(List.of("custom/icon", "custom/other"), textures.get("icon").stream()
+                .map(TextureDefinitions.ItemTextureDefinition::texturePath).toList());
+        assertEquals("custom/single", textures.get("single").getFirst().texturePath());
+        assertTrue(textures.get("unsupported").isEmpty());
+    }
+
+    private static ResourcePack pack(final String textureData) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final JsonObject atlas = new JsonObject();
+        atlas.addProperty("texture_name", "atlas.items");
+        atlas.add("texture_data", JsonParser.parseString(textureData));
+        content.putJson("textures/item_texture.json", atlas);
+        return new ResourcePack(content);
+    }
+
+}
