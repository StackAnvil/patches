+package net.raphimc.viabedrock.protocol.storage;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class VoxelShapeRegistryTest {
+
+    @Test
+    void decodesNativeAsymmetricGridWithoutChangingItsCoordinateSystem() {
+        final VoxelShapeRegistry registry = new VoxelShapeRegistry();
+        final ByteBuf input = asymmetric();
+        try {
+            registry.read(input);
+            assertFalse(input.isReadable());
+            final var snapshot = registry.snapshot();
+            final var shape = snapshot.shape("test:asymmetric");
+            assertEquals(1, snapshot.customShapeCount());
+            assertNull(snapshot.shape("test:absent"));
+            final float[][][] boxes = {
+                {{0, 0, 0}, {0.25F, 0.5F, 0.75F}}, {{0.5F, 0.5F, 0.75F}, {1, 1, 1}},
+                {{0.25F, 0, 0.75F}, {0.5F, 0.25F, 1}}, {{0, 0.75F, 0.25F}, {0.25F, 1, 0.5F}}
+            };
+            for (int x = 0; x < shape.xSize(); x++) {
+                for (int y = 0; y < shape.ySize(); y++) {
+                    for (int z = 0; z < shape.zSize(); z++) {
+                        final float[] midpoint = {(shape.xCoordinates().get(x) + shape.xCoordinates().get(x + 1)) / 2,
+                            (shape.yCoordinates().get(y) + shape.yCoordinates().get(y + 1)) / 2,
+                            (shape.zCoordinates().get(z) + shape.zCoordinates().get(z + 1)) / 2};
+                        boolean occupied = false;
+                        for (float[][] box : boxes) {
+                            occupied |= midpoint[0] >= box[0][0] && midpoint[0] < box[1][0]
+                                && midpoint[1] >= box[0][1] && midpoint[1] < box[1][1]
+                                && midpoint[2] >= box[0][2] && midpoint[2] < box[1][2];
+                        }
+                        assertEquals(occupied, shape.occupied(x, y, z));
+                    }
+                }
+            }
+            final byte[] copy = shape.cells();
+            copy[0] = 0;
+            assertTrue(shape.occupied(0, 0, 0));
+            assertThrows(UnsupportedOperationException.class, () -> shape.xCoordinates().clear());
+        } finally {
+            input.release();
+        }
+    }
+
+    @Test
+    void rejectsEveryTruncatedPrefixWithoutReplacingThePreviousRegistry() {
+        final VoxelShapeRegistry registry = new VoxelShapeRegistry();
+        final ByteBuf valid = asymmetric();
+        try {
+            final byte[] bytes = new byte[valid.readableBytes()];
+            valid.getBytes(0, bytes);
+            registry.read(valid);
+            final var previous = registry.snapshot();
+            for (int size = 0; size < bytes.length; size++) {
+                final ByteBuf truncated = Unpooled.wrappedBuffer(bytes, 0, size);
+                try {
+                    assertThrows(RuntimeException.class, () -> registry.read(truncated));
+                    assertSame(previous, registry.snapshot());
+                } finally {
+                    truncated.release();
+                }
+            }
+            final ByteBuf replacement = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_INT.write(replacement, 0);
+                BedrockTypes.UNSIGNED_VAR_INT.write(replacement, 0);
+                replacement.writeShortLE(0);
+                registry.read(replacement);
+                assertTrue(registry.snapshot().names().isEmpty());
+                assertTrue(registry.snapshot().shapes().isEmpty());
+            } finally {
+                replacement.release();
+            }
+        } finally {
+            valid.release();
+        }
+    }
+
+    @Test
+    void rejectsOversizedArraysUnorderedCoordinatesAndUnknownHandles() {
+        final VoxelShapeRegistry registry = new VoxelShapeRegistry();
+        final ByteBuf oversized = Unpooled.buffer();
+        final ByteBuf unordered = asymmetric();
+        final ByteBuf unknown = asymmetric();
+        try {
+            BedrockTypes.UNSIGNED_VAR_INT.write(oversized, 8193);
+            assertThrows(IllegalArgumentException.class, () -> registry.read(oversized));
+            unordered.setFloatLE(12, Float.NaN);
+            assertThrows(IllegalArgumentException.class, () -> registry.read(unordered));
+            unknown.setShortLE(unknown.writerIndex() - 4, 1);
+            assertThrows(IllegalArgumentException.class, () -> registry.read(unknown));
+            assertTrue(registry.snapshot().shapes().isEmpty());
+        } finally {
+            oversized.release();
+            unordered.release();
+            unknown.release();
+        }
+    }
+
+    private static ByteBuf asymmetric() {
+        final ByteBuf input = Unpooled.buffer();
+        BedrockTypes.UNSIGNED_VAR_INT.write(input, 1);
+        input.writeByte(3).writeByte(4).writeByte(4);
+        BedrockTypes.UNSIGNED_VAR_INT.write(input, 6);
+        input.writeBytes(new byte[]{0x77, 0x20, 0x08, 0, 0, (byte) 0x88});
+        for (float[] axis : new float[][]{{0, 0.25F, 0.5F, 1}, {0, 0.25F, 0.5F, 0.75F, 1}, {0, 0.25F, 0.5F, 0.75F, 1}}) {
+            BedrockTypes.UNSIGNED_VAR_INT.write(input, axis.length);
+            for (float coordinate : axis) {
+                input.writeFloatLE(coordinate);
+            }
+        }
+        BedrockTypes.UNSIGNED_VAR_INT.write(input, 1);
+        BedrockTypes.STRING.write(input, "test:asymmetric");
+        input.writeShortLE(0).writeShortLE(1);
+        return input;
+    }
+
+}
