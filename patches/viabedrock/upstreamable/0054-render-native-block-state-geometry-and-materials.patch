@@ -0,0 +1,88 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class CustomBlockStates {
+
+    private CustomBlockStates() { }
+
+    public static List<CompoundTag> expand(final CompoundTag definition) {
+        return expandWithMetadata(definition).stream().map(State::properties).toList();
+    }
+
+    public static List<State> expandWithMetadata(final CompoundTag definition) {
+        final List<Map.Entry<String, List<Tag>>> domains = new ArrayList<>();
+        final ListTag<CompoundTag> traits = definition.getListTag("traits", CompoundTag.class);
+        if (traits != null) {
+            final Map<String, List<Tag>> traitDomains = new LinkedHashMap<>();
+            BlockTraitStates.appendAll(traits, traitDomains);
+            traitDomains.forEach((name, values) -> domains.add(Map.entry(name, List.copyOf(values))));
+        }
+
+        final ListTag<CompoundTag> propertyDefinitions = definition.getListTag("properties", CompoundTag.class);
+        if (propertyDefinitions != null) {
+            for (final CompoundTag property : propertyDefinitions) {
+                if (property.get("name") instanceof StringTag name && property.get("enum") instanceof ListTag<?> values) {
+                    final List<Tag> domain = new ArrayList<>();
+                    values.forEach(domain::add);
+                    // Each custom definition has its own state identity, even when
+                    // its name or enum values repeat. Traits occupy the low bits.
+                    domains.add(Map.entry(name.getValue(), domain));
+                }
+            }
+        }
+
+        final List<Domain> compiled = new ArrayList<>(domains.size());
+        int bits = 0;
+        for (final var domain : domains) {
+            final int count = Math.max(1, domain.getValue().size());
+            final int width = 32 - Integer.numberOfLeadingZeros(count - 1);
+            final int shift = bits;
+            bits += width;
+            // BlockLegacy stores its masks in a ushort, including registrations
+            // that exceed the 16-bit palette. Match its x86 shift boundaries.
+            final int mask = ((0xFFFF << (16 - width)) & 0xFFFF) >>> (16 - bits);
+            compiled.add(new Domain(domain.getKey(), domain.getValue(), count, shift, mask));
+        }
+
+        final List<State> states = new ArrayList<>();
+        final int capacity = 1 << Math.min(bits, 16);
+        for (int auxiliary = 0; auxiliary < capacity; auxiliary++) {
+            final CompoundTag properties = new CompoundTag();
+            boolean valid = true;
+            for (final Domain domain : compiled) {
+                final int index = (auxiliary & domain.mask()) >>> domain.shift();
+                // Native palette slot zero is constructed before domain checks.
+                if (auxiliary != 0 && index >= domain.count()) {
+                    valid = false;
+                    break;
+                }
+                if (!domain.values().isEmpty()) {
+                    properties.put(domain.name(), domain.values().get(index).copy());
+                }
+            }
+            if (valid) {
+                states.add(new State(properties, (short) auxiliary));
+            }
+        }
+        return List.copyOf(states);
+    }
+
+    public record State(CompoundTag properties, short metadata) { }
+
+    private record Domain(String name, List<Tag> values, int count, int shift, int mask) { }
+
+}
