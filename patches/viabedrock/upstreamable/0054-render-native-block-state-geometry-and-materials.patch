+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CustomBlockStatesTest {
+
+    @Test
+    void keepsRepeatedDefinitionsAndValuesInTheirOriginalStateSlots() {
+        final CompoundTag definition = definition(property("x", 0, 1), property("x", 4, 5, 6), property("y", 2, 2, 3));
+        final List<CompoundTag> states = CustomBlockStates.expand(definition);
+        assertEquals(18, states.size());
+        assertEquals(List.of(4, 4, 5, 5, 6, 6, 4, 4, 5, 5, 6, 6, 4, 4, 5, 5, 6, 6),
+                states.stream().map(state -> state.getIntTag("x").asInt()).toList());
+        assertEquals(12, states.stream().filter(state -> state.getIntTag("y").asInt() == 2).count());
+        assertEquals(states.getFirst(), states.get(1));
+        assertNotSame(states.getFirst(), states.get(1));
+        states.getFirst().putInt("x", 99);
+        assertEquals(4, states.get(1).getIntTag("x").asInt());
+    }
+
+    @Test
+    void retainsTraitSlotsBeforeCustomOverridesAndCopiesTypedValues() {
+        final CompoundTag definition = definition(property("minecraft:block_face", 2, 2, 3), property("x", 0, 1));
+        addTraits(definition);
+        final List<CompoundTag> states = CustomBlockStates.expand(definition);
+        assertEquals(4608, states.size());
+        assertEquals(new ByteTag((byte) 0), states.getFirst().get("minecraft:connection_north"));
+        assertEquals(new ByteTag((byte) 1), states.get(1).get("minecraft:connection_north"));
+        assertEquals(new ByteTag((byte) 1), states.get(2).get("minecraft:connection_east"));
+        assertEquals(new StringTag("top"), states.get(384).get("minecraft:vertical_half"));
+        assertEquals(new IntTag(3), states.get(1536).get("minecraft:block_face"));
+        assertEquals(new IntTag(1), states.get(2304).get("x"));
+        assertEquals(List.of(new CompoundTag()), CustomBlockStates.expand(new CompoundTag()));
+    }
+
+    @Test
+    void metadataRetainsSparseBitPositionsAndCapsThePaletteAtSixteenBits() {
+        final var states = CustomBlockStates.expandWithMetadata(definition(property("x", 4, 5, 6), property("y", 7, 8)));
+        assertEquals(List.of((short) 0, (short) 1, (short) 2, (short) 4, (short) 5, (short) 6),
+                states.stream().map(CustomBlockStates.State::metadata).toList());
+        assertEquals(7, states.get(2).properties().getIntTag("y").asInt());
+        assertEquals(8, states.get(3).properties().getIntTag("y").asInt());
+        states.getFirst().properties().putInt("x", 99);
+        assertEquals(5, states.get(1).properties().getIntTag("x").asInt());
+
+        final int[] domain = new int[256];
+        for (int i = 0; i < domain.length; i++) {
+            domain[i] = i;
+        }
+        final var capped = CustomBlockStates.expandWithMetadata(definition(
+                property("low", domain), property("high", domain), property("overflow", 9, 10)));
+        assertEquals(65536, capped.size());
+        assertEquals((short) -1, capped.getLast().metadata());
+        assertEquals(255, capped.getLast().properties().getIntTag("low").asInt());
+        assertEquals(255, capped.getLast().properties().getIntTag("high").asInt());
+        assertEquals(9, capped.getLast().properties().getIntTag("overflow").asInt());
+    }
+
+    @Test
+    void matchesNativeSparsePaletteMetadata() throws Exception {
+        final String reference = System.getenv("STACKANVIL_CUSTOM_BLOCK_PALETTE_REFERENCE");
+        assumeTrue(reference != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonObject().getAsJsonArray("rows");
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final var counts = row.getAsJsonArray("counts");
+            final CompoundTag[] properties = new CompoundTag[counts.size()];
+            for (int i = 0; i < counts.size(); i++) {
+                final int[] values = new int[counts.get(i).getAsInt()];
+                for (int j = 0; j < values.length; j++) {
+                    values[j] = j;
+                }
+                properties[i] = property("property" + i, values);
+            }
+            final var actual = CustomBlockStates.expandWithMetadata(definition(properties));
+            final var ordinals = row.getAsJsonArray("ordinals");
+            assertEquals(ordinals.size(), actual.size(), row::toString);
+            for (int i = 0; i < actual.size(); i++) {
+                assertEquals(ordinals.get(i).getAsInt(), Short.toUnsignedInt(actual.get(i).metadata()), row::toString);
+            }
+        }
+    }
+
+    private static CompoundTag definition(final CompoundTag... properties) {
+        final CompoundTag definition = new CompoundTag();
+        final ListTag<CompoundTag> tags = new ListTag<>(CompoundTag.class);
+        for (final CompoundTag property : properties) {
+            tags.add(property);
+        }
+        definition.put("properties", tags);
+        return definition;
+    }
+
+    private static CompoundTag property(final String name, final int... domain) {
+        final CompoundTag property = new CompoundTag();
+        property.putString("name", name);
+        final ListTag<IntTag> values = new ListTag<>(IntTag.class);
+        for (final int value : domain) {
+            values.add(new IntTag(value));
+        }
+        property.put("enum", values);
+        return property;
+    }
+
+    private static void addTraits(final CompoundTag definition) {
+        final CompoundTag connection = new CompoundTag();
+        connection.putString("name", "minecraft:connection");
+        connection.putInt("enabled_states", 3);
+        final CompoundTag position = new CompoundTag();
+        position.putString("name", "minecraft:placement_position");
+        final CompoundTag enabled = new CompoundTag();
+        enabled.putByte("block_face", (byte) 1);
+        enabled.putByte("vertical_half", (byte) 1);
+        position.put("enabled_states", enabled);
+        final ListTag<CompoundTag> traits = new ListTag<>(CompoundTag.class);
+        traits.add(connection);
+        traits.add(position);
+        definition.put("traits", traits);
+    }
+
+}
