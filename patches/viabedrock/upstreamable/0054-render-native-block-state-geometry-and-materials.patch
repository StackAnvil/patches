+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BlockRegistryNamesTest {
+
+    @Test
+    void restrictionsExpandGroupsBeforePrimaryNamesAndKeepPartialGroups() {
+        final var names = new BlockRegistryNames(List.of("minecraft:log", "minecraft:oak_log", "minecraft:spruce_log",
+                "minecraft:jungle_log", "pack:other"), Map.of("minecraft:alias", "pack:other"));
+        assertEquals(Set.of("minecraft:oak_log", "minecraft:spruce_log"), names.restrictionBlocks(new String[]{"log"}));
+        assertEquals(Set.of("minecraft:oak_log", "minecraft:spruce_log", "minecraft:jungle_log", "pack:other"),
+                names.restrictionBlocks(new String[]{"minecraft:log", "jungle_log", "alias", "pack:other", "alias"}));
+        assertTrue(names.restrictionBlocks(new String[]{"LOG", "other", "MINECRAFT:oak_log", "missing"}).isEmpty());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_RESTRICTION_GROUPS", matches = ".+")
+    void restrictionGroupsMatchNativeInstallationAndResolution() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_RESTRICTION_GROUPS")))).getAsJsonObject();
+        final Set<String> primary = new HashSet<>();
+        fixture.getAsJsonArray("installed").forEach(value -> value.getAsJsonObject().getAsJsonArray("members")
+                .forEach(member -> primary.add(member.getAsString())));
+        final var names = new BlockRegistryNames(primary);
+        assertFalse(fixture.getAsJsonArray("restrictions").isEmpty());
+        for (final var value : fixture.getAsJsonArray("restrictions")) {
+            final var row = value.getAsJsonObject();
+            final Set<String> expected = new HashSet<>();
+            row.getAsJsonArray("resolved").forEach(member -> expected.add(member.getAsString()));
+            assertEquals(expected, names.restrictionBlocks(new String[]{row.get("input").getAsString()}), row::toString);
+        }
+    }
+
+    @Test
+    void primaryNamesWinBeforeNormalizedAliasesAndNamespaceFallback() {
+        final var names = new BlockRegistryNames(List.of("minecraft:stone", "minecraft:legacy", "pack:stone", "pack:other", "Exact:Case"),
+                Map.of("minecraft:legacy", "pack:other", "minecraft:alias", "pack:other"));
+        assertEquals("Exact:Case", names.resolve("Exact:Case"));
+        assertNull(names.resolve("exact:case"));
+        assertEquals("minecraft:stone", names.resolve("STONE"));
+        assertEquals("minecraft:legacy", names.resolve("legacy"));
+        assertEquals("pack:other", names.resolve("alias"));
+        assertEquals("pack:other", names.resolve("other"));
+        assertNull(names.resolve("missing:other"));
+        assertNull(names.resolve("missing"));
+    }
+
+    @Test
+    void ownsInputCollectionsAndUsesUnsignedUtf8NamespaceOrder() {
+        final var primary = new ArrayList<>(List.of("𐀀:value", ":value", "pack:target"));
+        final var aliases = new HashMap<>(Map.of("minecraft:alias", "pack:target"));
+        final var names = new BlockRegistryNames(primary, aliases);
+        primary.clear();
+        aliases.clear();
+        assertEquals(":value", names.resolve("value"));
+        assertEquals("pack:target", names.resolve("alias"));
+        assertEquals("𐀀:value", names.resolve("𐀀:value"));
+    }
+
+    @Test
+    void builtinAliasesRequireTheirActualTargetRegistration() {
+        final var names = new BlockRegistryNames(List.of("minecraft:white_carpet", "minecraft:iron_chain"));
+        assertEquals("minecraft:white_carpet", names.resolve("CARPET"));
+        assertEquals("minecraft:iron_chain", names.resolve("CHAIN"));
+        assertNull(names.resolve("chemistry_table"));
+        assertNull(names.resolve("tile.chain"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_BLOCK_REGISTRY_NAMES", matches = ".+")
+    void matchesTargetRegistryAndAliasLookups() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_BLOCK_REGISTRY_NAMES")))).getAsJsonObject();
+        final var primary = new ArrayList<String>();
+        fixture.getAsJsonArray("primary").forEach(value -> primary.add(value.getAsString()));
+        final Map<String, String> aliases = new HashMap<>();
+        fixture.getAsJsonObject("aliases").entrySet().forEach(entry -> aliases.put(entry.getKey(), entry.getValue().getAsString()));
+        final var names = new BlockRegistryNames(primary, aliases);
+        for (final var value : fixture.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            assertEquals(row.get("expected").isJsonNull() ? null : row.get("expected").getAsString(), names.resolve(row.get("input").getAsString()));
+        }
+        assertFalse(fixture.getAsJsonArray("cases").isEmpty());
+    }
+
+}
