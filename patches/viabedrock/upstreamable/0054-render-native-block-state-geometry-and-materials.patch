+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class BlockTraitStatesTest {
+
+    @Test
+    void resolvesAsciiCaseVariantsWithoutMergingTheirDefinitions() {
+        for (final String kind : List.of("connection", "placement_direction", "placement_position", "multi_block")) {
+            final CompoundTag lower = configuredTrait(kind, true);
+            final CompoundTag upper = lower.copy();
+            upper.putString("name", lower.getStringTag("name").getValue().toUpperCase(Locale.ROOT));
+            assertEquals(new ArrayList<>(append(lower).entrySet()), new ArrayList<>(append(upper).entrySet()));
+
+            final CompoundTag disabled = configuredTrait(kind, false);
+            final Map<String, List<Tag>> actual = new LinkedHashMap<>();
+            BlockTraitStates.appendAll(List.of(disabled, upper), actual);
+            assertEquals(new ArrayList<>(append(lower).entrySet()), new ArrayList<>(actual.entrySet()));
+        }
+        final CompoundTag unicode = configuredTrait("connection", true);
+        unicode.putString("name", "MİNECRAFT:CONNECTION");
+        assertTrue(append(unicode).isEmpty());
+        final CompoundTag unqualified = configuredTrait("connection", true);
+        unqualified.putString("name", "connection");
+        assertTrue(append(unqualified).isEmpty());
+    }
+
+    @Test
+    void registersDirectionStatesInNativeOrderRegardlessOfPacketKeyOrder() {
+        final String[] controls = {"cardinal_direction", "corner_and_cardinal_direction", "facing_direction", "sixteen_way_rotation"};
+        for (int mask = 0; mask < 16; mask++) {
+            final CompoundTag forward = new CompoundTag();
+            final CompoundTag reverse = new CompoundTag();
+            for (int i = 0; i < controls.length; i++) {
+                forward.putByte(controls[i], (byte) ((mask >>> i) & 1));
+                reverse.putByte(controls[controls.length - 1 - i], (byte) ((mask >>> (controls.length - 1 - i)) & 1));
+            }
+            final Map<String, List<Tag>> first = states("placement_direction", forward);
+            final Map<String, List<Tag>> second = states("placement_direction", reverse);
+            assertEquals(new ArrayList<>(first.entrySet()), new ArrayList<>(second.entrySet()));
+            final List<Integer> counts = first.values().stream().map(List::size).toList();
+            final List<Integer> expected = new ArrayList<>();
+            if ((mask & 3) != 0) {
+                expected.add(4);
+            }
+            if ((mask & 2) != 0) {
+                expected.add(5);
+            }
+            if ((mask & 4) != 0) {
+                expected.add(6);
+            }
+            if ((mask & 8) != 0) {
+                expected.add(16);
+            }
+            assertEquals(expected, counts);
+        }
+    }
+
+    @Test
+    void usesByteConnectionDomainsAndIgnoresWrongTagTypes() {
+        for (int flags = 0; flags < 256; flags++) {
+            final CompoundTag trait = trait("connection");
+            trait.putInt("enabled_states", flags);
+            final Map<String, List<Tag>> states = new LinkedHashMap<>();
+            BlockTraitStates.append(trait, states);
+            assertEquals(((flags & 1) != 0 ? 4 : 0) + ((flags & 2) != 0 ? 2 : 0), states.size());
+            states.values().forEach(values -> assertEquals(List.of(new ByteTag((byte) 0), new ByteTag((byte) 1)), new ArrayList<>(values)));
+            trait.putByte("enabled_states", (byte) flags);
+            assertTrue(append(trait).isEmpty());
+        }
+        final CompoundTag enabled = new CompoundTag();
+        enabled.putInt("block_face", 1);
+        assertTrue(states("placement_position", enabled).isEmpty());
+        enabled.putByte("block_face", (byte) -1);
+        assertEquals(6, states("placement_position", enabled).values().iterator().next().size());
+    }
+
+    @Test
+    void retainsExistingStateDomainsAndIndependentTraitRegistrationOrder() {
+        final CompoundTag enabled = new CompoundTag();
+        enabled.putByte("block_face", (byte) 1);
+        enabled.putByte("vertical_half", (byte) 1);
+        final Map<String, List<Tag>> states = states("placement_position", enabled);
+        final List<Tag> original = List.of(new StringTag("custom"));
+        states.put("minecraft:cardinal_direction", original);
+        final List<String> order = List.copyOf(states.keySet());
+        final CompoundTag direction = trait("placement_direction");
+        final CompoundTag directionEnabled = new CompoundTag();
+        directionEnabled.putByte("cardinal_direction", (byte) 1);
+        direction.put("enabled_states", directionEnabled);
+        BlockTraitStates.append(direction, states);
+        assertSame(original, states.get("minecraft:cardinal_direction"));
+        assertEquals(order, List.copyOf(states.keySet()));
+        assertTrue(append(trait("placement_direction")).isEmpty());
+    }
+
+    @Test
+    void retainsTheFirstTraitDefinitionIncludingDisabledFlags() {
+        for (final String kind : List.of("connection", "placement_direction", "placement_position", "multi_block")) {
+            for (final boolean firstEnabled : new boolean[]{false, true}) {
+                final CompoundTag first = configuredTrait(kind, firstEnabled);
+                final CompoundTag second = configuredTrait(kind, !firstEnabled);
+                final Map<String, List<Tag>> actual = new LinkedHashMap<>();
+                BlockTraitStates.appendAll(List.of(first, second, second.copy()), actual);
+                assertEquals(new ArrayList<>(append(first).entrySet()), new ArrayList<>(actual.entrySet()));
+            }
+        }
+    }
+
+    @Test
+    void bucketCollisionsCanRegisterAnEnabledCaseVariantBeforeEarlierTraits() {
+        final CompoundTag disabled = configuredTrait("connection", false);
+        final CompoundTag position = configuredTrait("placement_position", true);
+        final CompoundTag upper = configuredTrait("connection", true);
+        upper.putString("name", "MINECRAFT:CONNECTION");
+        final Map<String, List<Tag>> actual = new LinkedHashMap<>();
+        BlockTraitStates.appendAll(List.of(disabled, position, upper, disabled.copy()), actual);
+        final Map<String, List<Tag>> expected = append(upper);
+        BlockTraitStates.append(position, expected);
+        assertEquals(new ArrayList<>(expected.entrySet()), new ArrayList<>(actual.entrySet()));
+    }
+
+    @Test
+    void matchesPrivateNativeTraitListOrderingAndDuplicateSelection() throws Exception {
+        final String reference = System.getenv("STACKANVIL_BLOCK_TRAIT_LIST_REFERENCE");
+        assumeTrue(reference != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonObject().getAsJsonArray("rows");
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final List<CompoundTag> traits = new ArrayList<>();
+            for (final var name : row.getAsJsonArray("names")) {
+                final CompoundTag trait = configuredTrait(name.getAsString(), traits.size() % 2 == 0);
+                trait.putString("name", name.getAsString());
+                traits.add(trait);
+            }
+            final Map<String, List<Tag>> expected = new LinkedHashMap<>();
+            for (final var name : row.getAsJsonArray("order")) {
+                for (final CompoundTag trait : traits) {
+                    if (trait.getStringTag("name").getValue().equals(name.getAsString())) {
+                        BlockTraitStates.append(trait, expected);
+                        break;
+                    }
+                }
+            }
+            final Map<String, List<Tag>> actual = new LinkedHashMap<>();
+            BlockTraitStates.appendAll(traits, actual);
+            assertEquals(new ArrayList<>(expected.entrySet()), new ArrayList<>(actual.entrySet()));
+        }
+    }
+
+    @Test
+    void preservesTypedMultiblockDomainsIncludingAliasedSerializerValues() {
+        final CompoundTag enabled = new CompoundTag();
+        enabled.putByte("multi_block", (byte) 1);
+        final CompoundTag trait = trait("multi_block");
+        trait.put("enabled_states", enabled);
+        for (int count = 0; count < 256; count++) {
+            trait.putByte("part_count", (byte) count);
+            final List<Tag> values = new ArrayList<>(append(trait).values().iterator().next());
+            assertEquals(Math.max(1, count), values.size());
+            for (int i = 0; i < values.size(); i++) {
+                assertEquals(new IntTag(i < 4 ? i : 0), values.get(i));
+            }
+        }
+        enabled.putByte("multi_block", (byte) 0);
+        assertTrue(append(trait).isEmpty());
+    }
+
+    @Test
+    void matchesPrivateNativeRegistrationAndSerializedValueReferences() throws Exception {
+        final String reference = System.getenv("STACKANVIL_BLOCK_TRAIT_REFERENCE");
+        final String valuesReference = System.getenv("STACKANVIL_BLOCK_STATE_VALUES");
+        assumeTrue(reference != null && valuesReference != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonObject().getAsJsonArray("rows");
+        final var definitions = JsonParser.parseString(Files.readString(Path.of(valuesReference))).getAsJsonObject().getAsJsonArray("definitions");
+        final Map<String, List<Tag>> nativeValues = new LinkedHashMap<>();
+        for (final var entry : definitions) {
+            final var definition = entry.getAsJsonObject();
+            final List<Tag> values = new ArrayList<>();
+            for (final var value : definition.getAsJsonArray("values")) {
+                values.add(switch (definition.get("tag_type").getAsString()) {
+                    case "byte" -> new ByteTag(value.getAsByte());
+                    case "int" -> new IntTag(value.getAsInt());
+                    case "string" -> new StringTag(value.getAsString());
+                    default -> throw new IllegalArgumentException();
+                });
+            }
+            nativeValues.put(definition.get("name").getAsString(), values);
+        }
+        for (final var entry : cases) {
+            final var row = entry.getAsJsonObject();
+            final String kind = row.get("kind").getAsString();
+            final byte[] flags = HexFormat.of().parseHex(row.get("flags").getAsString());
+            final CompoundTag trait = trait(kind);
+            if (kind.equals("connection")) {
+                trait.putInt("enabled_states", flags[8] & 0xFF);
+            } else if (kind.equals("multi_block")) {
+                final CompoundTag enabled = new CompoundTag();
+                enabled.putByte("multi_block", flags[0]);
+                trait.put("enabled_states", enabled);
+                trait.putByte("part_count", flags[2]);
+            } else {
+                final String[] keys = kind.equals("placement_direction")
+                        ? new String[]{"cardinal_direction", "facing_direction", "corner_and_cardinal_direction", "sixteen_way_rotation"}
+                        : new String[]{"block_face", "vertical_half"};
+                final CompoundTag enabled = new CompoundTag();
+                for (int i = 0; i < flags.length; i++) {
+                    enabled.putByte(keys[i], flags[i]);
+                }
+                trait.put("enabled_states", enabled);
+            }
+            final Map<String, List<Tag>> actual = append(trait);
+            final Map<String, List<Tag>> expected = new LinkedHashMap<>();
+            for (final var stateEntry : row.getAsJsonArray("states")) {
+                final var state = stateEntry.getAsJsonArray();
+                List<Tag> values = nativeValues.get(state.get(0).getAsString());
+                if (kind.equals("multi_block")) {
+                    // The native serializer maps every index above three back to zero.
+                    final int count = Math.max(1, state.get(1).getAsInt());
+                    final List<Tag> expanded = new ArrayList<>();
+                    for (int i = 0; i < count; i++) {
+                        expanded.add(values.get(i < 4 ? i : 0));
+                    }
+                    values = expanded;
+                } else {
+                    assertEquals(state.get(1).getAsInt(), values.size());
+                }
+                expected.put(state.get(0).getAsString(), values);
+            }
+            assertEquals(new ArrayList<>(expected.entrySet()), new ArrayList<>(actual.entrySet()));
+        }
+    }
+
+    private static Map<String, List<Tag>> states(final String name, final CompoundTag enabled) {
+        final CompoundTag trait = trait(name);
+        trait.put("enabled_states", enabled);
+        return append(trait);
+    }
+
+    private static Map<String, List<Tag>> append(final CompoundTag trait) {
+        final Map<String, List<Tag>> result = new LinkedHashMap<>();
+        BlockTraitStates.append(trait, result);
+        return result;
+    }
+
+    private static CompoundTag trait(final String name) {
+        final CompoundTag result = new CompoundTag();
+        result.putString("name", name.contains(":") ? name : "minecraft:" + name);
+        return result;
+    }
+
+    private static CompoundTag configuredTrait(final String name, final boolean active) {
+        final CompoundTag result = trait(name);
+        if (name.endsWith("connection")) {
+            result.putInt("enabled_states", active ? 3 : 0);
+        } else {
+            final CompoundTag enabled = new CompoundTag();
+            for (final String control : List.of("cardinal_direction", "corner_and_cardinal_direction", "facing_direction",
+                    "sixteen_way_rotation", "block_face", "vertical_half", "multi_block")) {
+                enabled.putByte(control, (byte) (active ? 1 : 0));
+            }
+            result.put("enabled_states", enabled);
+            result.putByte("part_count", (byte) 4);
+        }
+        return result;
+    }
+
+}
