+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.exception.CancelException;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.Channel;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicReference;
+import java.lang.reflect.Proxy;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+
+class WorldPacketBufferTest {
+
+    @Test
+    void preservesResourcePackPacketOrderUntilPlayCapabilitiesPrecedeAcknowledgment() {
+        final ClientAcknowledgments client = new ClientAcknowledgments();
+        final ChannelStorage channels = new ChannelStorage();
+        final List<Integer> received = new ArrayList<>();
+        final WorldPacketBuffer resources = new WorldPacketBuffer();
+        resources.queue(ClientboundBedrockPackets.ADD_ENTITY, new byte[]{1});
+        resources.queue(ClientboundBedrockPackets.SPAWN_PARTICLE_EFFECT, new byte[]{2});
+        final WorldPacketBuffer initialization = spy(new WorldPacketBuffer());
+        doAnswer(ignored -> {
+            assertNull(client.current.get());
+            assertTrue(channels.hasChannel("test:particles"));
+            initialization.drain((type, payload) -> received.add((int) payload[0]));
+            return null;
+        }).when(initialization).drain(client.user);
+
+        initialization.awaitClient(client.user);
+        resources.drain(initialization::queue);
+        initialization.queue(ClientboundBedrockPackets.SPAWN_PARTICLE_EFFECT, new byte[]{3});
+        assertTrue(received.isEmpty());
+        assertEquals(3, initialization.packetCount());
+        channels.addChannels(List.of("test:particles"));
+        client.callbacks.getFirst().run();
+        client.callbacks.getFirst().run();
+        assertEquals(List.of(1, 2, 3), received);
+        verify(initialization, times(1)).drain(client.user);
+    }
+
+    @Test
+    void ignoresAcknowledgmentsForReplacedOrDisconnectedWorlds() {
+        final ClientAcknowledgments client = new ClientAcknowledgments();
+        final WorldPacketBuffer previous = spy(new WorldPacketBuffer());
+        final WorldPacketBuffer current = spy(new WorldPacketBuffer());
+        previous.awaitClient(client.user);
+        current.awaitClient(client.user);
+        client.callbacks.getFirst().run();
+        assertSame(current, client.current.get());
+        verify(previous, never()).drain(client.user);
+
+        when(client.channel.isActive()).thenReturn(false);
+        client.callbacks.getLast().run();
+        assertSame(current, client.current.get());
+        verify(current, never()).drain(client.user);
+    }
+
+    @Test
+    void buffersImmutablePacketsInOrderAndLimitsAccumulation() {
+        final WorldPacketBuffer storage = new WorldPacketBuffer();
+        final byte[] bytes = new byte[]{7};
+        storage.queue(ClientboundBedrockPackets.PLAYER_LIST, bytes);
+        bytes[0] = 9;
+        storage.queue(ClientboundBedrockPackets.PLAYER_SKIN, bytes);
+        final List<Integer> received = new ArrayList<>();
+        final List<ClientboundBedrockPackets> types = new ArrayList<>();
+        storage.drain((type, payload) -> {
+            types.add(type);
+            received.add((int) payload[0]);
+        });
+        assertEquals(List.of(7, 9), received);
+        assertEquals(List.of(ClientboundBedrockPackets.PLAYER_LIST, ClientboundBedrockPackets.PLAYER_SKIN), types);
+        assertEquals(0, storage.packetCount());
+        for (int i = 0; i < 10000; i++) {
+            storage.queue(ClientboundBedrockPackets.SET_TIME, new byte[0]);
+        }
+        assertThrows(IllegalStateException.class, () -> storage.queue(ClientboundBedrockPackets.SET_TIME, new byte[0]));
+    }
+
+    @Test
+    void resumesTypedPacketsWithoutRepeatingBaseProtocolsAndKeepsCancellationSemantics() {
+        final List<ClientboundBedrockPackets> handled = new ArrayList<>();
+        final List<Integer> sent = new ArrayList<>();
+        final Protocol<?, ?, ?, ?> base = protocol(true, (state, wrapper) -> fail("Buffered packets already passed base protocols"));
+        final Protocol<?, ?, ?, ?> translator = protocol(false, (state, wrapper) -> {
+            assertEquals(State.PLAY, state);
+            final ClientboundBedrockPackets type = (ClientboundBedrockPackets) wrapper.getPacketType();
+            handled.add(type);
+            final int value = wrapper.read(Types.INT);
+            if (type == ClientboundBedrockPackets.PLAYER_LIST) {
+                wrapper.cancel();
+                throw new CancelException();
+            }
+            wrapper.setPacketType(ClientboundPackets26_3.PLAYER_INFO_UPDATE);
+            wrapper.write(Types.INT, value + 1);
+        });
+        final Protocol<?, ?, ?, ?> downstream = protocol(false, (state, wrapper) -> {
+            assertEquals(State.PLAY, state);
+            assertSame(ClientboundPackets26_3.PLAYER_INFO_UPDATE, wrapper.getPacketType());
+            wrapper.write(Types.INT, wrapper.read(Types.INT) + 100);
+        });
+        final ProtocolPipeline pipeline = (ProtocolPipeline) Proxy.newProxyInstance(ProtocolPipeline.class.getClassLoader(), new Class<?>[]{ProtocolPipeline.class}, (proxy, method, arguments) -> {
+            assertEquals("pipes", method.getName());
+            assertSame(BedrockProtocol.class, arguments[0]);
+            assertEquals(false, arguments[1]);
+            assertSame(Direction.CLIENTBOUND, arguments[2]);
+            return List.of(base, translator, downstream);
+        });
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(), new Class<?>[]{ProtocolInfo.class}, (proxy, method, arguments) -> {
+            return switch (method.getName()) {
+                case "getPipeline" -> pipeline;
+                case "getServerState", "getClientState" -> State.CONFIGURATION;
+                default -> throw new UnsupportedOperationException(method.getName());
+            };
+        });
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> {
+            if (method.getName().equals("getProtocolInfo")) {
+                return info;
+            }
+            if (method.getName().equals("sendRawPacket") && arguments.length == 1) {
+                final ByteBuf output = (ByteBuf) arguments[0];
+                try {
+                    assertEquals(ClientboundPackets26_3.PLAYER_INFO_UPDATE.getId(), Types.VAR_INT.readPrimitive(output));
+                    sent.add(output.readInt());
+                    assertFalse(output.isReadable());
+                } finally {
+                    output.release();
+                }
+                return null;
+            }
+            throw new UnsupportedOperationException(method.getName());
+        });
+        final WorldPacketBuffer gate = new WorldPacketBuffer();
+        for (ClientboundBedrockPackets type : List.of(ClientboundBedrockPackets.PLAYER_LIST, ClientboundBedrockPackets.PLAYER_SKIN, ClientboundBedrockPackets.PLAYER_SKIN)) {
+            final ByteBuf payload = Unpooled.buffer();
+            try {
+                payload.writeInt(handled.size() + gate.packetCount());
+                final byte[] bytes = new byte[payload.readableBytes()];
+                payload.readBytes(bytes);
+                gate.queue(type, bytes);
+            } finally {
+                payload.release();
+            }
+        }
+        gate.drain((type, bytes) -> {
+            final ByteBuf payload = Unpooled.wrappedBuffer(bytes);
+            try {
+                PacketFactory.replayClientbound(new PacketWrapperImpl(type, payload, user));
+            } finally {
+                payload.release();
+            }
+        });
+        assertEquals(List.of(ClientboundBedrockPackets.PLAYER_LIST, ClientboundBedrockPackets.PLAYER_SKIN, ClientboundBedrockPackets.PLAYER_SKIN), handled);
+        assertEquals(List.of(102, 103), sent);
+        assertEquals(0, gate.packetCount());
+    }
+
+    private static Protocol<?, ?, ?, ?> protocol(final boolean base, final Transform transform) {
+        return (Protocol<?, ?, ?, ?>) Proxy.newProxyInstance(Protocol.class.getClassLoader(), new Class<?>[]{Protocol.class}, (proxy, method, arguments) -> {
+            if (method.getName().equals("isBaseProtocol")) {
+                return base;
+            }
+            if (method.getName().equals("transform")) {
+                assertSame(Direction.CLIENTBOUND, arguments[0]);
+                transform.apply((State) arguments[1], (PacketWrapper) arguments[2]);
+                return null;
+            }
+            throw new UnsupportedOperationException(method.getName());
+        });
+    }
+
+    private static final class ClientAcknowledgments {
+
+        private final UserConnection user = mock(UserConnection.class);
+        private final Channel channel = mock(Channel.class);
+        private final AtomicReference<WorldPacketBuffer> current = new AtomicReference<>();
+        private final List<Runnable> callbacks = new ArrayList<>();
+
+        private ClientAcknowledgments() {
+            final PacketSyncStorage sync = mock(PacketSyncStorage.class);
+            when(this.user.get(PacketSyncStorage.class)).thenReturn(sync);
+            when(this.user.getChannel()).thenReturn(this.channel);
+            when(this.channel.isActive()).thenReturn(true);
+            when(this.user.get(WorldPacketBuffer.class)).thenAnswer(ignored -> this.current.get());
+            when(this.user.remove(WorldPacketBuffer.class)).thenAnswer(ignored -> this.current.getAndSet(null));
+            doAnswer(invocation -> {
+                this.current.set(invocation.getArgument(0));
+                return null;
+            }).when(this.user).put(any(WorldPacketBuffer.class));
+            doAnswer(invocation -> {
+                this.callbacks.add(invocation.getArgument(0));
+                return null;
+            }).when(sync).syncWithClient(any(Runnable.class));
+        }
+
+    }
+
+    @FunctionalInterface
+    private interface Transform {
+
+        void apply(State state, PacketWrapper wrapper) throws CancelException;
+
+    }
+
+}
