+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.nbt.io.NBTIO;
+import com.viaversion.nbt.limiter.TagLimiter;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.DataInputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BlockItemDescriptorsTest {
+
+    @Test
+    void blockItemNumbersPreserveUnsignedLegacyBoundaries() {
+        final int[] legacy = {0, 1, 255, 256, 32768, 65535};
+        final int[] item = {0, 1, 255, 65535, 33023, 256};
+        for (int index = 0; index < legacy.length; index++) {
+            assertEquals(item[index], new BlockItemDescriptor(legacy[index], (short) 0).numericItemId());
+            assertEquals(item[index], BlockItemDescriptor.numericItemId(legacy[index]));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new BlockItemDescriptor(-1, (short) 0));
+        assertThrows(IllegalArgumentException.class, () -> new BlockItemDescriptor(65536, (short) 0));
+        assertThrows(IllegalArgumentException.class, () -> BlockItemDescriptor.numericItemId(-1));
+        assertThrows(IllegalArgumentException.class, () -> BlockItemDescriptor.numericItemId(65536));
+    }
+
+    @Test
+    void reconstructsSparseMetadataFromThePinnedCanonicalPalette() throws Exception {
+        final var palette = palette();
+        final var descriptors = new BlockItemDescriptors(palette, Map.of());
+        assertEquals(new BlockItemDescriptor(395, (short) 8), descriptors.resolve(BlockState.fromString(
+                "minecraft:acacia_button[button_pressed_bit=1,facing_direction=0]")));
+        assertEquals(new BlockItemDescriptor(53, (short) 35), descriptors.resolve(BlockState.fromString(
+                "minecraft:oak_stairs[minecraft:corner=outer_right,upside_down_bit=0,weirdo_direction=3]")));
+        for (final var state : palette) {
+            assertEquals(state.blockStateTag().getIntTag("block_id").asInt(), descriptors.resolve(state).legacyId());
+        }
+        assertNull(descriptors.resolve(BlockState.fromString("probe:missing")));
+        assertNull(descriptors.resolve(null));
+    }
+
+    @Test
+    void keepsAliasedCustomMetadataByObjectIdentityAndOwnsItsInputMap() throws Exception {
+        final var palette = new ArrayList<>(palette());
+        final Map<BlockState, BlockItemDescriptor> custom = new IdentityHashMap<>();
+        for (final short auxiliary : new short[]{0, 1, 4}) {
+            final CompoundTag tag = new CompoundTag();
+            tag.putString("name", "probe:aliased");
+            tag.put("states", new CompoundTag());
+            final var state = BedrockBlockState.fromNbt(tag);
+            palette.add(state);
+            custom.put(state, new BlockItemDescriptor(60000, auxiliary));
+        }
+        final var descriptors = new BlockItemDescriptors(palette, custom);
+        for (final var entry : custom.entrySet()) {
+            assertEquals(entry.getValue(), descriptors.resolve(entry.getKey()));
+        }
+        custom.clear();
+        assertEquals(new BlockItemDescriptor(60000, (short) 4), descriptors.resolve(palette.getLast()));
+        assertNull(descriptors.resolve(BedrockBlockState.fromNbt(palette.getLast().blockStateTag().copy())));
+        assertThrows(IllegalArgumentException.class, () -> new BlockItemDescriptors(palette,
+                Map.of(palette.getFirst(), new BlockItemDescriptor(1, (short) 0))));
+        assertThrows(IllegalArgumentException.class, () -> new BlockItemDescriptors(palette,
+                Map.of(BlockState.fromString("probe:unregistered"), new BlockItemDescriptor(1, (short) 0))));
+    }
+
+    @Test
+    void rejectsReorderedOrIncompleteBuiltinDomains() throws Exception {
+        final var states = palette().stream().filter(state -> state.namespacedIdentifier().equals("minecraft:acacia_button")).toList();
+        final var reversed = new ArrayList<>(states.reversed());
+        assertThrows(IllegalStateException.class, () -> new BlockItemDescriptors(reversed, Map.of()));
+        final var nonPrefix = states.stream().filter(state -> !state.properties().get("facing_direction").equals("0")).toList();
+        assertThrows(IllegalStateException.class, () -> new BlockItemDescriptors(nonPrefix, Map.of()));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_CANONICAL_BLOCK_DESCRIPTORS", matches = ".+")
+    void matchesExecutedNativePaletteConstructionAndSerialization() throws Exception {
+        final var descriptors = new BlockItemDescriptors(palette(), Map.of());
+        final var reference = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_NATIVE_CANONICAL_BLOCK_DESCRIPTORS")))).getAsJsonObject();
+        for (final var entry : reference.getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            final CompoundTag tag = new CompoundTag();
+            tag.putString("name", row.get("name").getAsString());
+            final CompoundTag states = new CompoundTag();
+            row.getAsJsonObject("states").entrySet().forEach(property -> states.putString(property.getKey(), property.getValue().getAsString()));
+            tag.put("states", states);
+            final var expected = new BlockItemDescriptor(row.get("legacyId").getAsInt(), (short) row.get("auxiliary").getAsInt());
+            assertEquals(expected, descriptors.resolve(BedrockBlockState.fromNbt(tag)), row::toString);
+        }
+        assertFalse(reference.getAsJsonArray("rows").isEmpty());
+    }
+
+    private static List<BedrockBlockState> palette() throws Exception {
+        try (var input = BlockItemDescriptorsTest.class.getResourceAsStream("/assets/viabedrock/data/bedrock/block_palette.nbt")) {
+            final var root = NBTIO.readTag(new DataInputStream(new GZIPInputStream(input)), TagLimiter.noop(), true, CompoundTag.class);
+            return root.getListTag("blocks", CompoundTag.class).getValue().stream().map(BedrockBlockState::fromNbt).toList();
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/chunk/blockstate/BlockItemStatesTest.java b/src/test/java/net/raphimc/viabedrock/api/chunk/blockstate/BlockItemStatesTest.java
new file mode 100644
