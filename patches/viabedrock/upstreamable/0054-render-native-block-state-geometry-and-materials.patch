diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/BlockTraitStates.java b/src/main/java/net/raphimc/viabedrock/protocol/model/BlockTraitStates.java
new file mode 100644
index 000000000..6447cfb60
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/BlockTraitStates.java
@@ -0,0 +1,195 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.google.common.base.Ascii;
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Network trait state registration, in the native block's auxiliary-bit order. */
+public final class BlockTraitStates {
+
+    private BlockTraitStates() { }
+
+    public static void appendAll(final Iterable<CompoundTag> traits, final Map<String, List<Tag>> properties) {
+        final TraitTable table = new TraitTable();
+        for (final CompoundTag trait : traits) {
+            if (trait.get("name") instanceof StringTag name && known(Ascii.toLowerCase(name.getValue()))) {
+                table.register(name.getValue(), trait);
+            }
+        }
+        for (Entry entry = table.head.next; entry != table.head; entry = entry.next) {
+            append(entry.trait, properties);
+        }
+    }
+
+    private static boolean known(final String name) {
+        return switch (name) {
+            case "minecraft:connection", "minecraft:placement_direction", "minecraft:placement_position", "minecraft:multi_block" -> true;
+            default -> false;
+        };
+    }
+
+    public static void append(final CompoundTag trait, final Map<String, List<Tag>> properties) {
+        if (!(trait.get("name") instanceof StringTag name)) {
+            return;
+        }
+        // Reflected native trait lookup folds ASCII letters only. Keep the raw
+        // name in appendAll's table: differently cased names are distinct entries.
+        switch (Ascii.toLowerCase(name.getValue())) {
+            case "minecraft:connection" -> {
+                // Connection uses an Int tag bitmask, unlike the placement traits.
+                final int flags = trait.get("enabled_states") instanceof IntTag value ? value.asInt() & 0xFF : 0;
+                if ((flags & 1) != 0) {
+                    for (final String direction : new String[]{"north", "east", "south", "west"}) {
+                        register(properties, "connection_" + direction, new ByteTag((byte) 0), new ByteTag((byte) 1));
+                    }
+                }
+                if ((flags & 2) != 0) {
+                    register(properties, "connection_up", new ByteTag((byte) 0), new ByteTag((byte) 1));
+                    register(properties, "connection_down", new ByteTag((byte) 0), new ByteTag((byte) 1));
+                }
+            }
+            case "minecraft:placement_direction" -> {
+                final CompoundTag enabled = trait.getCompoundTag("enabled_states");
+                final boolean corner = enabled(enabled, "corner_and_cardinal_direction");
+                if (corner || enabled(enabled, "cardinal_direction")) {
+                    strings(properties, "cardinal_direction", "south", "west", "north", "east");
+                }
+                if (corner) {
+                    strings(properties, "corner", "none", "inner_left", "inner_right", "outer_left", "outer_right");
+                }
+                if (enabled(enabled, "facing_direction")) {
+                    strings(properties, "facing_direction", "down", "up", "north", "south", "west", "east");
+                }
+                if (enabled(enabled, "sixteen_way_rotation")) {
+                    integers(properties, "sixteen_way_rotation", 16);
+                }
+            }
+            case "minecraft:placement_position" -> {
+                final CompoundTag enabled = trait.getCompoundTag("enabled_states");
+                if (enabled(enabled, "block_face")) {
+                    strings(properties, "block_face", "down", "up", "north", "south", "west", "east");
+                }
+                if (enabled(enabled, "vertical_half")) {
+                    strings(properties, "vertical_half", "bottom", "top");
+                }
+            }
+            case "minecraft:multi_block" -> {
+                if (enabled(trait.getCompoundTag("enabled_states"), "multi_block")) {
+                    final int count = trait.get("part_count") instanceof ByteTag value ? value.asByte() & 0xFF : 0;
+                    // Raw part count reserves every ordinal; values above three
+                    // serialize as zero without removing their runtime slots.
+                    final Tag[] values = new Tag[Math.max(1, count)];
+                    for (int i = 0; i < values.length; i++) {
+                        values[i] = new IntTag(i < 4 ? i : 0);
+                    }
+                    register(properties, "multi_block_part", values);
+                }
+            }
+            default -> { }
+        }
+    }
+
+    private static boolean enabled(final CompoundTag states, final String name) {
+        return states != null && states.get(name) instanceof ByteTag value && value.asByte() != 0;
+    }
+
+    private static void strings(final Map<String, List<Tag>> properties, final String name, final String... values) {
+        final Tag[] tags = new Tag[values.length];
+        for (int i = 0; i < values.length; i++) {
+            tags[i] = new StringTag(values[i]);
+        }
+        register(properties, name, tags);
+    }
+
+    private static void integers(final Map<String, List<Tag>> properties, final String name, final int count) {
+        final Tag[] tags = new Tag[count];
+        for (int i = 0; i < count; i++) {
+            tags[i] = new IntTag(i);
+        }
+        register(properties, name, tags);
+    }
+
+    private static void register(final Map<String, List<Tag>> properties, final String name, final Tag... values) {
+        // BlockLegacy ignores repeated registrations, retaining the first domain and offset.
+        properties.putIfAbsent("minecraft:" + name, List.of(values));
+    }
+
+    /** The native string table prepends bucket collisions and retains first exact names. */
+    private static final class TraitTable {
+
+        private final Entry head = new Entry(null, 0);
+        private final Set<String> names = new HashSet<>();
+        private Entry[] buckets = new Entry[8];
+
+        private TraitTable() {
+            this.head.next = this.head;
+            this.head.previous = this.head;
+        }
+
+        private void register(final String name, final CompoundTag trait) {
+            if (!this.names.add(name)) {
+                return;
+            }
+            if (this.names.size() > this.buckets.length) {
+                this.buckets = new Entry[this.buckets.length * (this.buckets.length < 512 ? 8 : 2)];
+                Entry entry = this.head.next;
+                while (entry != this.head) {
+                    final Entry next = entry.next;
+                    final int bucket = (int) entry.hash & (this.buckets.length - 1);
+                    if (this.buckets[bucket] != null) {
+                        entry.previous.next = entry.next;
+                        entry.next.previous = entry.previous;
+                        insertBefore(entry, this.buckets[bucket]);
+                    }
+                    this.buckets[bucket] = entry;
+                    entry = next;
+                }
+            }
+            long hash = 0xCBF29CE484222325L;
+            for (final byte value : name.getBytes(StandardCharsets.UTF_8)) {
+                hash = (hash ^ (value & 0xFF)) * 1099511628211L;
+            }
+            final Entry entry = new Entry(trait, hash);
+            final int bucket = (int) hash & (this.buckets.length - 1);
+            insertBefore(entry, this.buckets[bucket] != null ? this.buckets[bucket] : this.head);
+            this.buckets[bucket] = entry;
+        }
+
+        private static void insertBefore(final Entry entry, final Entry next) {
+            entry.previous = next.previous;
+            entry.next = next;
+            next.previous.next = entry;
+            next.previous = entry;
+        }
+
+    }
+
+    private static final class Entry {
+
+        private final CompoundTag trait;
+        private final long hash;
+        private Entry previous;
+        private Entry next;
+
+        private Entry(final CompoundTag trait, final long hash) {
+            this.trait = trait;
+            this.hash = hash;
+        }
+
+    }
+
+}
