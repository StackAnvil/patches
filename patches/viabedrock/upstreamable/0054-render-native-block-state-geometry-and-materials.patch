+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.Gson;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Physical properties transported with the converted server pack, independently of its connection route. */
+public record CustomBlockProperties(String bedrockState, int javaState, List<CustomBlockVisual.Box> collisionBoxes,
+                                    List<CustomBlockVisual.Box> selectionBoxes, boolean occluding, int lightEmission, int lightDampening, CustomBlockOffset randomOffset) {
+
+    public static final String RESOURCE_PATH = "assets/viabedrock/custom_blocks.json";
+    public static final int MAX_BYTES = 8 * 1024 * 1024;
+    private static final int MAX_STATES = 4096;
+    private static final int MAX_BOXES = 512;
+    private static final Gson GSON = new Gson();
+
+    public CustomBlockProperties {
+        if (bedrockState == null || bedrockState.isBlank() || bedrockState.length() > 4096 || javaState < 0
+                || lightEmission < 0 || lightEmission > 15 || lightDampening < 0 || lightDampening > 15) {
+            throw new IllegalArgumentException("Invalid custom block properties");
+        }
+        java.util.Objects.requireNonNull(randomOffset, "randomOffset");
+        collisionBoxes = validatedBoxes(collisionBoxes);
+        selectionBoxes = validatedBoxes(selectionBoxes);
+    }
+
+    public static CustomBlockProperties of(final CustomBlockVisual visual) {
+        return new CustomBlockProperties(visual.bedrockState(), visual.javaState(), visual.collisionBoxes(), visual.selectionBoxes(),
+                visual.occluding(), visual.lightEmission(), visual.lightDampening(), visual.randomOffset());
+    }
+
+    /** World collision append uses integer offsets, unlike rendering and outline translation. */
+    public List<CustomBlockVisual.Box> collisionBoxesAt(final int x, final int y, final int z) {
+        return this.translated(this.collisionBoxes, x, y, z, true);
+    }
+
+    public List<CustomBlockVisual.Box> selectionBoxesAt(final int x, final int y, final int z) {
+        return this.translated(this.selectionBoxes, x, y, z, false);
+    }
+
+    /** Camera collision uses the continuous envelope of the component boxes. */
+    public List<CustomBlockVisual.Box> cameraBoxesAt(final int x, final int y, final int z) {
+        return this.translated(this.collisionBoxes, x, y, z, false);
+    }
+
+    private List<CustomBlockVisual.Box> translated(final List<CustomBlockVisual.Box> boxes, final int x, final int y, final int z,
+                                                  final boolean collision) {
+        final CustomBlockOffset.Offset offset = this.randomOffset.at(x, y, z);
+        final float dx = collision ? (float) (x + (int) Math.floor(offset.x())) : x + offset.x();
+        final float dy = collision ? (float) (y + (int) Math.floor(offset.y())) : y + offset.y();
+        final float dz = collision ? (float) (z + (int) Math.floor(offset.z())) : z + offset.z();
+        final List<CustomBlockVisual.Box> result = new ArrayList<>(boxes.size());
+        for (CustomBlockVisual.Box box : boxes) {
+            final float minX = (float) box.minX() + dx;
+            final float minY = (float) box.minY() + dy;
+            final float minZ = (float) box.minZ() + dz;
+            final float maxX = (float) box.maxX() + dx;
+            final float maxY = (float) box.maxY() + dy;
+            final float maxZ = (float) box.maxZ() + dz;
+            if (minX < maxX && minY < maxY && minZ < maxZ) {
+                result.add(new CustomBlockVisual.Box(minX, minY, minZ, maxX, maxY, maxZ));
+            }
+        }
+        return List.copyOf(result);
+    }
+
+    public static JsonObject encode(final Collection<CustomBlockVisual> visuals) {
+        if (visuals.size() > MAX_STATES) {
+            throw new IllegalArgumentException("Too many custom block states");
+        }
+        final JsonObject result = new JsonObject();
+        result.addProperty("format", 2);
+        result.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        result.addProperty("java_protocol", ProtocolConstants.JAVA_VERSION.getVersion());
+        result.add("states", GSON.toJsonTree(visuals.stream().sorted(Comparator.comparingInt(CustomBlockVisual::javaState))
+                .map(CustomBlockProperties::of).toList()));
+        return result;
+    }
+
+    public static Map<Integer, CustomBlockProperties> decode(final JsonElement metadata) {
+        final JsonObject root = metadata.getAsJsonObject();
+        if (integer(root.get("format")) != 2
+                || integer(root.get("bedrock_protocol")) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION
+                || integer(root.get("java_protocol")) != ProtocolConstants.JAVA_VERSION.getVersion()) {
+            throw new IllegalArgumentException("Unsupported custom block metadata version");
+        }
+        final var states = root.getAsJsonArray("states");
+        if (states.size() > MAX_STATES) {
+            throw new IllegalArgumentException("Too many custom block states");
+        }
+        final Map<Integer, CustomBlockProperties> result = new LinkedHashMap<>();
+        for (JsonElement state : states) {
+            final JsonObject object = state.getAsJsonObject();
+            integer(object.get("javaState"));
+            integer(object.get("lightEmission"));
+            integer(object.get("lightDampening"));
+            if (!object.get("occluding").isJsonPrimitive() || !object.get("occluding").getAsJsonPrimitive().isBoolean()) {
+                throw new IllegalArgumentException("Invalid custom block occlusion flag");
+            }
+            final JsonObject offset = object.getAsJsonObject("randomOffset");
+            for (String axis : List.of("x", "y", "z")) {
+                offset.getAsJsonObject(axis).get("steps").getAsBigDecimal().longValueExact();
+            }
+            final CustomBlockProperties properties = GSON.fromJson(state, CustomBlockProperties.class);
+            if (result.putIfAbsent(properties.javaState(), properties) != null) {
+                throw new IllegalArgumentException("Duplicate custom block state");
+            }
+        }
+        return Map.copyOf(result);
+    }
+
+    private static int integer(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("Expected an integer in custom block metadata");
+        }
+        return value.getAsBigDecimal().intValueExact();
+    }
+
+    private static List<CustomBlockVisual.Box> validatedBoxes(final List<CustomBlockVisual.Box> boxes) {
+        if (boxes == null || boxes.size() > MAX_BOXES) {
+            throw new IllegalArgumentException("Too many custom block boxes");
+        }
+        final List<CustomBlockVisual.Box> nonempty = new ArrayList<>();
+        for (CustomBlockVisual.Box box : boxes) {
+            if (box == null || !Double.isFinite(box.minX()) || !Double.isFinite(box.minY()) || !Double.isFinite(box.minZ())
+                    || !Double.isFinite(box.maxX()) || !Double.isFinite(box.maxY()) || !Double.isFinite(box.maxZ())
+                    || box.minX() > box.maxX() || box.minY() > box.maxY() || box.minZ() > box.maxZ()) {
+                throw new IllegalArgumentException("Invalid custom block box");
+            }
+            if (box.minX() < box.maxX() && box.minY() < box.maxY() && box.minZ() < box.maxZ()) {
+                nonempty.add(box);
+            }
+        }
+        return List.copyOf(nonempty);
+    }
+
+}
