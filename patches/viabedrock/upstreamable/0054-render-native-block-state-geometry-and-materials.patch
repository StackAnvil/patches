+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/** Resolves native primary registrations before aliases and namespace fallback. */
+public final class BlockRegistryNames {
+
+    private static final Map<String, String> BUILTIN_ALIASES = loadAliases();
+    private static final Map<String, List<String>> RESTRICTION_GROUPS = loadRestrictionGroups();
+
+    private final Set<String> primary;
+    private final Map<String, String> aliases;
+    private final Set<String> namespaces;
+
+    public BlockRegistryNames(final Collection<String> primary) {
+        this(primary, BUILTIN_ALIASES);
+    }
+
+    public BlockRegistryNames(final Collection<String> primary, final Map<String, String> aliases) {
+        this.primary = Set.copyOf(primary);
+        this.aliases = Map.copyOf(aliases);
+        final Set<String> namespaces = new TreeSet<>((first, second) -> Arrays.compareUnsigned(
+                first.getBytes(StandardCharsets.UTF_8), second.getBytes(StandardCharsets.UTF_8)));
+        for (final String identifier : this.primary) {
+            final int separator = identifier.indexOf(':');
+            if (separator >= 0) {
+                namespaces.add(identifier.substring(0, separator));
+            }
+        }
+        this.namespaces = java.util.Collections.unmodifiableSet(namespaces);
+    }
+
+    public String resolve(final String identifier) {
+        if (this.primary.contains(identifier)) {
+            return identifier;
+        }
+        final StringBuilder folded = new StringBuilder(identifier.length());
+        for (int index = 0; index < identifier.length(); index++) {
+            final char value = identifier.charAt(index);
+            folded.append(value >= 'A' && value <= 'Z' ? (char) (value + 'a' - 'A') : value);
+        }
+        final String normalized = folded.toString();
+        final boolean qualified = normalized.indexOf(':') >= 0;
+        final String name = qualified ? normalized : "minecraft:" + normalized;
+        if (this.primary.contains(name)) {
+            return name;
+        }
+        final String alias = this.aliases.get(name);
+        if (alias != null && this.primary.contains(alias)) {
+            return alias;
+        }
+        if (!qualified) {
+            for (final String namespace : this.namespaces) {
+                final String candidate = namespace + ':' + normalized;
+                if (this.primary.contains(candidate)) {
+                    return candidate;
+                }
+            }
+        }
+        return null;
+    }
+
+    /** Restriction strings use case-sensitive Minecraft qualification and expand groups before aliases. */
+    public Set<String> restrictionBlocks(final String[] identifiers) {
+        final Set<String> result = new HashSet<>();
+        for (final String identifier : identifiers) {
+            final String qualified = identifier.indexOf(':') >= 0 ? identifier : "minecraft:" + identifier;
+            final List<String> group = RESTRICTION_GROUPS.get(qualified);
+            if (group != null) {
+                for (final String member : group) {
+                    final String resolved = this.exact(member);
+                    if (resolved == null) {
+                        break;
+                    }
+                    result.add(resolved);
+                }
+            } else {
+                final String resolved = this.exact(qualified);
+                if (resolved != null) {
+                    result.add(resolved);
+                }
+            }
+        }
+        return Set.copyOf(result);
+    }
+
+    private String exact(final String identifier) {
+        if (this.primary.contains(identifier)) {
+            return identifier;
+        }
+        final String alias = this.aliases.get(identifier);
+        return alias != null && this.primary.contains(alias) ? alias : null;
+    }
+
+    private static Map<String, List<String>> loadRestrictionGroups() {
+        final String path = "/assets/viabedrock/data/bedrock/block_restriction_groups.json";
+        try (var input = BlockRegistryNames.class.getResourceAsStream(path)) {
+            if (input == null) {
+                throw new IllegalStateException("Missing native block restriction groups");
+            }
+            final var json = JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8)).getAsJsonObject();
+            final Map<String, List<String>> groups = new HashMap<>();
+            json.entrySet().forEach(entry -> groups.put(entry.getKey(), entry.getValue().getAsJsonArray().asList()
+                    .stream().map(value -> value.getAsString()).toList()));
+            return Map.copyOf(groups);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native block restriction groups", error);
+        }
+    }
+
+    private static Map<String, String> loadAliases() {
+        final String path = "/assets/viabedrock/data/bedrock/block_registry_aliases.json";
+        try (var input = BlockRegistryNames.class.getResourceAsStream(path)) {
+            if (input == null) {
+                throw new IllegalStateException("Missing native block registry aliases");
+            }
+            final var json = JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8)).getAsJsonObject();
+            final Map<String, String> aliases = new HashMap<>();
+            json.entrySet().forEach(entry -> aliases.put(entry.getKey(), entry.getValue().getAsString()));
+            return Map.copyOf(aliases);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native block registry aliases", error);
+        }
+    }
+
+}
