+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.storage.VoxelShapeRegistry;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockMaterialVisibilityTest {
+
+    @Test
+    void omitsInvisibleFacesWithoutRemovingPhysicalBoxesOrAuthoredVoxelParticipation() {
+        final ResourcePackStorage storage = storage(new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB));
+        for (String method : List.of("alpha_test", "alpha_test_single_sided", "blend")) {
+            final var visual = CustomBlockModel.compile(storage, "test:block", 42, components(method));
+            assertNotNull(visual);
+            assertTrue(JsonParser.parseString(visual.modelJson()).getAsJsonObject().getAsJsonArray("elements").isEmpty());
+            assertEquals(1, visual.collisionBoxes().size());
+            assertEquals(1, visual.selectionBoxes().size());
+            final var culling = CustomBlockCulling.decode(CustomBlockCulling.encode(Map.of(42, visual))).get(42);
+            assertEquals(Set.of(CustomBlockCulling.Direction.SOUTH), culling.directions());
+            assertEquals(List.of(new CustomBlockCulling.Rectangle(0, 0, 1, 1)), culling.slice(CustomBlockCulling.Direction.SOUTH));
+            assertEquals(16, CustomBlockResourceRewriter.terrainTexture(storage, "skin").getImage().getWidth());
+        }
+    }
+
+    @Test
+    void appliesVisibilityToTheActualSpriteAndPreservesOpaqueAndPartiallyVisibleMaterials() {
+        final ResourcePackStorage invisible = storage(new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB));
+        final CompoundTag components = components("alpha_test");
+        final CompoundTag opaque = components.getCompoundTag("minecraft:material_instances").getCompoundTag("*").copy();
+        opaque.putString("render_method", "opaque");
+        components.getCompoundTag("minecraft:material_instances").put("up", opaque);
+        final var mixed = CustomBlockModel.compile(invisible, "test:block", 42, components);
+        assertNotNull(mixed);
+        final var elements = JsonParser.parseString(mixed.modelJson()).getAsJsonObject().getAsJsonArray("elements");
+        assertEquals(1, elements.size());
+        assertEquals(Set.of("up"), elements.get(0).getAsJsonObject().getAsJsonObject("faces").keySet());
+
+        final BufferedImage pixels = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+        pixels.setRGB(4, 4, 0x7F123456);
+        final ResourcePackStorage faint = storage(pixels);
+        final var texture = CustomBlockResourceRewriter.terrainTexture(faint, "skin");
+        assertFalse(CustomBlockResourceRewriter.hasVisiblePixels(texture, "alpha_test"));
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(texture, "blend"));
+        final var blended = CustomBlockModel.compile(faint, "test:block", 42, components("blend"));
+        assertNotNull(blended);
+        assertEquals(6, JsonParser.parseString(blended.modelJson()).getAsJsonObject().getAsJsonArray("elements")
+                .get(0).getAsJsonObject().getAsJsonObject("faces").size());
+        pixels.setRGB(4, 4, 0x80123456);
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(CustomBlockResourceRewriter.terrainTexture(storage(pixels), "skin"), "alpha_test"));
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(null, "alpha_test"));
+    }
+
+    private static CompoundTag components(final String method) {
+        final CompoundTag result = new CompoundTag();
+        final CompoundTag geometry = new CompoundTag();
+        geometry.putString("identifier", "geometry.test");
+        geometry.putString("culling", "test:cull");
+        geometry.putString("culling_shape", "test:unit");
+        result.put("minecraft:geometry", geometry);
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", "skin");
+        material.putString("render_method", method);
+        final CompoundTag materials = new CompoundTag();
+        materials.put("*", material);
+        result.put("minecraft:material_instances", materials);
+        return result;
+    }
+
+    private static ResourcePackStorage storage(final BufferedImage pixels) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"skin\":{\"textures\":\"textures/blocks/skin\"}}}");
+        content.putPngImage("textures/blocks/skin.png", pixels);
+        content.putString("models/blocks/test.json", """
+            {"format_version":"1.12.0","minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":16,"texture_height":16},
+            "bones":[{"name":"body","cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"uv":[0,0]}]}]}]}
+            """);
+        content.putString("block_culling/test.json", """
+            {"format_version":"1.21.80","minecraft:block_culling_rules":{"description":{"identifier":"test:cull"},"rules":[
+            {"direction":"south","cull_against_full_and_opaque":false,"geometry_part":{"bone":"body"}}]}}
+            """);
+        final var storage = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final var shape = new VoxelShapeRegistry.Shape(1, 1, 1, new byte[]{1}, List.of(0F, 1F), List.of(0F, 1F), List.of(0F, 1F));
+        storage.setVoxelShapes(new VoxelShapeRegistry.Snapshot(List.of(shape), Map.of("test:unit", 0), 1));
+        return storage;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/CustomBlockStateDefinitionsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/CustomBlockStateDefinitionsTest.java
new file mode 100644
index 000000000..54c570e4c
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/CustomBlockStateDefinitionsTest.java
@@ -0,0 +1,218 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockStateDefinitionsTest {
+
+    @Test
+    void partitionsEveryWireStateWithoutChangingVanillaPiecesOrRotations() {
+        final Map<BlockState, Integer> states = wireStates();
+        final Map<Integer, String> assignments = new LinkedHashMap<>();
+        states.values().stream().filter(id -> id * 37 % 1296 < 441)
+                .forEach(id -> assignments.put(id, "viabedrock:block/custom/slot_" + id));
+        assertEquals(441, assignments.size());
+        final JsonObject definition = CustomBlockStateDefinitions.create(states, assignments).get("redstone_wire");
+        for (Map.Entry<BlockState, Integer> state : states.entrySet()) {
+            final String custom = assignments.get(state.getValue());
+            final List<AppliedModel> expected = custom == null ? vanillaModels(state.getKey()) : List.of(new AppliedModel(custom, 0));
+            assertEquals(sorted(expected), sorted(models(definition, state.getKey())), state.getKey().toBlockStateString());
+        }
+    }
+
+    @Test
+    void handlesNoAssignmentsAndFullyAssignedWireWithoutAddingVanillaLayers() {
+        final Map<BlockState, Integer> states = wireStates();
+        assertTrue(CustomBlockStateDefinitions.create(states, Map.of()).isEmpty());
+        final Map<Integer, String> assignments = new LinkedHashMap<>();
+        states.values().forEach(id -> assignments.put(id, "viabedrock:block/custom/slot_" + id));
+        final JsonObject definition = CustomBlockStateDefinitions.create(states, assignments).get("redstone_wire");
+        assertEquals(1296, definition.getAsJsonArray("multipart").size());
+        states.forEach((state, id) -> assertEquals(List.of(new AppliedModel(assignments.get(id), 0)), models(definition, state)));
+    }
+
+    @Test
+    void compactsAndDeterministicallySelectsAnExactStateSubset() {
+        final List<BlockState> states = new ArrayList<>(wireStates().keySet());
+        final JsonObject complete = CustomBlockStateDefinitions.condition(states);
+        assertEquals(5, propertyPredicates(complete));
+        assertFalse(matches(complete, states.get(0).withProperty("power", "16")));
+        assertFalse(matches(complete, states.get(0).withProperty("north", "invalid")));
+        final List<BlockState> selected = states.stream().filter(state -> Integer.parseInt(state.properties().get("power")) % 3 == 0
+                && !state.properties().get("east").equals("none")).toList();
+        final JsonObject condition = CustomBlockStateDefinitions.condition(selected);
+        for (BlockState state : states) {
+            assertTrue(matches(complete, state));
+            assertEquals(selected.contains(state), matches(condition, state));
+        }
+        final List<BlockState> reversed = new ArrayList<>(selected);
+        Collections.reverse(reversed);
+        assertSameStructureAndOrder(condition, CustomBlockStateDefinitions.condition(reversed));
+        assertEquals(5, propertyPredicates(condition));
+        assertNull(CustomBlockStateDefinitions.condition(List.of()));
+    }
+
+    @Test
+    void leavesOrdinaryNotesAndOtherBlocksUnassigned() {
+        final BlockState ordinary = new BlockState("note_block", Map.of("instrument", "harp", "note", "0", "powered", "false"));
+        final BlockState custom = ordinary.withProperty("note", "1");
+        final BlockState stone = new BlockState("stone", Map.of());
+        final JsonObject variants = CustomBlockStateDefinitions.create(Map.of(ordinary, 1, custom, 2, stone, 3), Map.of(2, "viabedrock:block/custom/slot_2"))
+                .get("note_block").getAsJsonObject("variants");
+        assertEquals(2, variants.size());
+        for (BlockState state : List.of(ordinary, custom)) {
+            final var selector = variants.entrySet().stream().filter(entry -> matchesVariant(entry.getKey(), state)).toList();
+            assertEquals(1, selector.size());
+            final String expected = state.equals(custom) ? "viabedrock:block/custom/slot_2" : "minecraft:block/note_block";
+            assertEquals(new AppliedModel(expected, 0), applied(selector.get(0).getValue().getAsJsonObject()));
+        }
+        assertTrue(CustomBlockStateDefinitions.carrier(ordinary));
+        assertTrue(CustomBlockStateDefinitions.carrier(wireStates().keySet().iterator().next()));
+        assertFalse(CustomBlockStateDefinitions.carrier(stone));
+    }
+
+    private static Map<BlockState, Integer> wireStates() {
+        final Map<BlockState, Integer> states = new LinkedHashMap<>();
+        for (String north : List.of("none", "side", "up")) {
+            for (String east : List.of("none", "side", "up")) {
+                for (String south : List.of("none", "side", "up")) {
+                    for (String west : List.of("none", "side", "up")) {
+                        for (int power = 0; power < 16; power++) {
+                            states.put(new BlockState("redstone_wire", Map.of("north", north, "east", east, "south", south, "west", west, "power", Integer.toString(power))), states.size());
+                        }
+                    }
+                }
+            }
+        }
+        return states;
+    }
+
+    private static List<AppliedModel> vanillaModels(final BlockState state) {
+        final var properties = state.properties();
+        final boolean north = !properties.get("north").equals("none");
+        final boolean east = !properties.get("east").equals("none");
+        final boolean south = !properties.get("south").equals("none");
+        final boolean west = !properties.get("west").equals("none");
+        final List<AppliedModel> result = new ArrayList<>();
+        if (!(north || east || south || west) || (north || south) && (east || west)) {
+            result.add(new AppliedModel("minecraft:block/redstone_dust_dot", 0));
+        }
+        if (north) {
+            result.add(new AppliedModel("minecraft:block/redstone_dust_side0", 0));
+        }
+        if (south) {
+            result.add(new AppliedModel("minecraft:block/redstone_dust_side_alt0", 0));
+        }
+        if (east) {
+            result.add(new AppliedModel("minecraft:block/redstone_dust_side_alt1", 270));
+        }
+        if (west) {
+            result.add(new AppliedModel("minecraft:block/redstone_dust_side1", 270));
+        }
+        final List<String> directions = List.of("north", "east", "south", "west");
+        for (int direction = 0; direction < directions.size(); direction++) {
+            if (properties.get(directions.get(direction)).equals("up")) {
+                result.add(new AppliedModel("minecraft:block/redstone_dust_up", direction * 90));
+            }
+        }
+        return result;
+    }
+
+    private static List<AppliedModel> models(final JsonObject definition, final BlockState state) {
+        final List<AppliedModel> result = new ArrayList<>();
+        for (JsonElement value : definition.getAsJsonArray("multipart")) {
+            final JsonObject part = value.getAsJsonObject();
+            if (matches(part.getAsJsonObject("when"), state)) {
+                result.add(applied(part.getAsJsonObject("apply")));
+            }
+        }
+        return result;
+    }
+
+    private static AppliedModel applied(final JsonObject model) {
+        return new AppliedModel(model.get("model").getAsString(), model.has("y") ? model.get("y").getAsInt() : 0);
+    }
+
+    private static List<AppliedModel> sorted(final List<AppliedModel> models) {
+        return models.stream().sorted(Comparator.comparing(AppliedModel::name).thenComparingInt(AppliedModel::rotation)).toList();
+    }
+
+    private static boolean matches(final JsonObject condition, final BlockState state) {
+        for (var entry : condition.entrySet()) {
+            if (entry.getKey().equals("AND") || entry.getKey().equals("OR")) {
+                boolean matched = entry.getKey().equals("AND");
+                for (JsonElement child : entry.getValue().getAsJsonArray()) {
+                    if (entry.getKey().equals("AND")) {
+                        matched &= matches(child.getAsJsonObject(), state);
+                    } else {
+                        matched |= matches(child.getAsJsonObject(), state);
+                    }
+                }
+                if (!matched) {
+                    return false;
+                }
+            } else if (!List.of(entry.getValue().getAsString().split("\\|", -1)).contains(state.properties().get(entry.getKey()))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean matchesVariant(final String selector, final BlockState state) {
+        for (String property : selector.split(",")) {
+            final String[] pair = property.split("=", 2);
+            if (!pair[1].equals(state.properties().get(pair[0]))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static int propertyPredicates(final JsonObject condition) {
+        int count = 0;
+        for (var entry : condition.entrySet()) {
+            if (entry.getValue().isJsonArray()) {
+                for (JsonElement child : entry.getValue().getAsJsonArray()) {
+                    count += propertyPredicates(child.getAsJsonObject());
+                }
+            } else {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    private static void assertSameStructureAndOrder(final JsonObject first, final JsonObject second) {
+        assertEquals(first, second);
+        assertEquals(new ArrayList<>(first.keySet()), new ArrayList<>(second.keySet()));
+        for (String key : first.keySet()) {
+            if (first.get(key).isJsonArray()) {
+                final var left = first.getAsJsonArray(key);
+                final var right = second.getAsJsonArray(key);
+                for (int i = 0; i < left.size(); i++) {
+                    assertSameStructureAndOrder(left.get(i).getAsJsonObject(), right.get(i).getAsJsonObject());
+                }
+            }
+        }
+    }
+
+    private record AppliedModel(String name, int rotation) {
+    }
+
+}
