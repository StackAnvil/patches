+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Canonical block-item metadata, independent of connection runtime IDs and saved-item auxiliary lookup. */
+public final class BlockItemDescriptors {
+
+    private static final Map<String, List<String>> PROPERTY_VALUES = loadPropertyValues();
+
+    private final Map<BlockState, BlockItemDescriptor> builtin;
+    private final Map<BlockState, BlockItemDescriptor> custom;
+
+    public BlockItemDescriptors(final List<BedrockBlockState> palette, final Map<BlockState, BlockItemDescriptor> custom) {
+        final Map<String, List<BedrockBlockState>> groups = new LinkedHashMap<>();
+        final Set<BlockState> registered = Collections.newSetFromMap(new IdentityHashMap<>());
+        registered.addAll(palette);
+        for (final BedrockBlockState state : palette) {
+            if (state.blockStateTag().get("block_id") instanceof IntTag) {
+                groups.computeIfAbsent(state.namespacedIdentifier(), ignored -> new ArrayList<>()).add(state);
+            }
+        }
+        final Map<BlockState, BlockItemDescriptor> builtin = new HashMap<>();
+        for (final List<BedrockBlockState> states : groups.values()) {
+            appendBuiltin(states, builtin);
+        }
+        final Map<BlockState, BlockItemDescriptor> ownedCustom = new IdentityHashMap<>();
+        for (final var entry : custom.entrySet()) {
+            if (!registered.contains(entry.getKey()) || groups.containsKey(entry.getKey().namespacedIdentifier())) {
+                throw new IllegalArgumentException("Custom descriptor must refer to a registered custom state");
+            }
+            ownedCustom.put(entry.getKey(), entry.getValue());
+        }
+        this.builtin = Map.copyOf(builtin);
+        this.custom = Collections.unmodifiableMap(ownedCustom);
+    }
+
+    public BlockItemDescriptor resolve(final BlockState state) {
+        if (state == null) {
+            return null;
+        }
+        final BlockItemDescriptor custom = this.custom.get(state);
+        return custom != null ? custom : this.builtin.get(state);
+    }
+
+    private static void appendBuiltin(final List<BedrockBlockState> states, final Map<BlockState, BlockItemDescriptor> result) {
+        final BedrockBlockState first = states.getFirst();
+        final int legacyId = first.blockStateTag().getIntTag("block_id").asInt();
+        final List<Domain> domains = new ArrayList<>();
+        for (final String property : first.properties().keySet()) {
+            final Set<String> observed = new LinkedHashSet<>();
+            int firstChange = states.size();
+            for (int index = 0; index < states.size(); index++) {
+                final String value = states.get(index).properties().get(property);
+                if (observed.add(value) && observed.size() == 2) {
+                    firstChange = index;
+                }
+            }
+            final List<String> values = PROPERTY_VALUES.get(property);
+            if (values == null || observed.size() > values.size()
+                    || !List.copyOf(observed).equals(values.subList(0, observed.size()))) {
+                throw new IllegalStateException("Unexpected canonical block property domain: " + property);
+            }
+            domains.add(new Domain(property, values.subList(0, observed.size()), firstChange));
+        }
+        // The bundled palette follows native auxiliary order. The first changing
+        // domain owns the low bits; non-power-of-two domains leave sparse slots.
+        domains.sort(Comparator.comparingInt(Domain::firstChange));
+        final Map<String, Integer> shifts = new HashMap<>();
+        int bits = 0;
+        for (final Domain domain : domains) {
+            shifts.put(domain.name, bits);
+            bits += 32 - Integer.numberOfLeadingZeros(domain.values.size() - 1);
+        }
+        if (bits > 16) {
+            throw new IllegalStateException("Canonical block metadata exceeds an unsigned short");
+        }
+        int previous = -1;
+        for (final BedrockBlockState state : states) {
+            if (state.blockStateTag().getIntTag("block_id").asInt() != legacyId
+                    || !state.properties().keySet().equals(first.properties().keySet())) {
+                throw new IllegalStateException("Inconsistent canonical block palette");
+            }
+            int auxiliary = 0;
+            for (final Domain domain : domains) {
+                auxiliary |= domain.values.indexOf(state.properties().get(domain.name)) << shifts.get(domain.name);
+            }
+            if (auxiliary <= previous) {
+                throw new IllegalStateException("Canonical block palette is outside auxiliary order");
+            }
+            result.put(state, new BlockItemDescriptor(legacyId, (short) auxiliary));
+            previous = auxiliary;
+        }
+    }
+
+    private static Map<String, List<String>> loadPropertyValues() {
+        try (var stream = BlockItemDescriptors.class.getResourceAsStream("/assets/viabedrock/data/bedrock/block_property_values.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing native block property values");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Native block property values do not match the target protocol");
+            }
+            final Map<String, List<String>> values = new HashMap<>();
+            for (final var entry : data.getAsJsonObject("properties").entrySet()) {
+                final List<String> domain = new ArrayList<>();
+                entry.getValue().getAsJsonArray().forEach(value -> domain.add(value.getAsString()));
+                values.put(entry.getKey(), List.copyOf(domain));
+            }
+            return Map.copyOf(values);
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load native block property values", error);
+        }
+    }
+
+    private record Domain(String name, List<String> values, int firstChange) { }
+
+}
