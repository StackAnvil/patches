@@ -0,0 +1,97 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+
+/** Native position-seeded block offsets. Ranges are stored in block units. */
+public record CustomBlockOffset(Axis x, Axis y, Axis z) {
+
+    public static final Axis ZERO = new Axis(0, 0, 0);
+    public static final CustomBlockOffset NONE = new CustomBlockOffset(ZERO, ZERO, ZERO);
+
+    public CustomBlockOffset {
+        if (x == null || y == null || z == null) {
+            throw new IllegalArgumentException("Missing custom block offset axis");
+        }
+    }
+
+    public static CustomBlockOffset fromComponent(final CompoundTag component) {
+        return component == null ? NONE : new CustomBlockOffset(axis(component, "x"), axis(component, "y"), axis(component, "z"));
+    }
+
+    private static Axis axis(final CompoundTag component, final String name) {
+        final CompoundTag axis = component.getCompoundTag(name);
+        if (axis == null) {
+            return ZERO;
+        }
+        final CompoundTag range = axis.getCompoundTag("range");
+        final float min = range != null && range.get("min") instanceof NumberTag value ? value.asFloat() * 0.0625F : 0;
+        final float max = range != null && range.get("max") instanceof NumberTag value ? value.asFloat() * 0.0625F : 0;
+        long steps = axis.get("steps") instanceof NumberTag value ? value.asLong() : 0;
+        if (steps < 0 && steps >= Integer.MIN_VALUE) {
+            steps = Integer.toUnsignedLong((int) steps);
+        }
+        return new Axis(min, max, steps);
+    }
+
+    /** The native seed uses signed X/Z coordinates; height does not enter it. */
+    public Offset at(final int blockX, final int blockY, final int blockZ) {
+        final long raw = (long) blockZ * 0x6EBFFF5L ^ (long) blockX * 0x2FC20FL;
+        final long seed = (long) (int) (raw * (raw * 0x285B825L + 11) >>> 16) ^ 0x6A09E667F3BCC909L;
+        long a = mix(seed);
+        long b = mix(seed + 0x9E3779B97F4A7C15L);
+        if ((a | b) == 0) {
+            a = 0x9E3779B97F4A7C15L;
+            b = 0x6A09E667F3BCC909L;
+        }
+        final float offsetX = this.x.sample(unit(a, b));
+        long difference = b ^ a;
+        a = Long.rotateLeft(a, 49) ^ difference ^ difference << 21;
+        b = Long.rotateLeft(difference, 28);
+        final float offsetY = this.y.sample(unit(a, b));
+        difference = b ^ a;
+        a = Long.rotateLeft(a, 49) ^ difference ^ difference << 21;
+        b = Long.rotateLeft(difference, 28);
+        return new Offset(offsetX, offsetY, this.z.sample(unit(a, b)));
+    }
+
+    private static long mix(long value) {
+        value = (value ^ value >>> 30) * 0xBF58476D1CE4E5B9L;
+        value = (value ^ value >>> 27) * 0x94D049BB133111EBL;
+        return value ^ value >>> 31;
+    }
+
+    private static float unit(final long a, final long b) {
+        return (Long.rotateLeft(a + b, 17) + a >>> 40) * 0x1.0P-24F;
+    }
+
+    public record Axis(float min, float max, long steps) {
+        public Axis {
+            if (!Float.isFinite(min) || !Float.isFinite(max) || steps < 0 || steps > 0xFFFFFFFFL) {
+                throw new IllegalArgumentException("Invalid custom block offset range");
+            }
+        }
+
+        private float sample(final float unit) {
+            if (this.min >= this.max) {
+                return this.min;
+            }
+            if (this.steps == 1) {
+                return (this.min + this.max) * 0.5F;
+            }
+            if (this.steps == 0) {
+                return this.min + (this.max - this.min) * unit;
+            }
+            return this.min + (float) Math.floor(unit * (float) this.steps) * ((this.max - this.min) / (float) (this.steps - 1));
+        }
+    }
+
+    public record Offset(float x, float y, float z) {
+    }
+
+}
