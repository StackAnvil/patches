+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.*;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class BlockPropertiesTest {
+
+    @Test
+    void networkRegistrationRequiresTheCompoundAndAnExactIntegerId() {
+        final CompoundTag properties = new CompoundTag();
+        final var block = new BlockProperties("probe:block", properties);
+        assertNull(block.legacyId());
+        properties.putInt("vanilla_block_data", 1);
+        assertNull(block.legacyId());
+        final CompoundTag vanilla = new CompoundTag();
+        properties.put("vanilla_block_data", vanilla);
+        assertEquals(0, block.legacyId());
+        final Tag[] wrongTypes = {
+            new ByteTag((byte) 1), new ShortTag((short) 511), new LongTag(65536), new StringTag("123"), new CompoundTag()
+        };
+        for (final Tag wrongType : wrongTypes) {
+            vanilla.put("block_id", wrongType);
+            assertEquals(0, block.legacyId());
+        }
+        for (final int value : new int[]{Integer.MIN_VALUE, -65537, -1, 0, 255, 256, 65535, 65536, Integer.MAX_VALUE}) {
+            vanilla.putInt("block_id", value);
+            assertEquals(value & 0xFFFF, block.legacyId());
+        }
+    }
+
+    @Test
+    void matchesThePinnedNativeNetworkReaderAndConstructorBoundaryCases() throws Exception {
+        final String reference = System.getenv("STACKANVIL_CUSTOM_BLOCK_ID_REFERENCE");
+        assumeTrue(reference != null);
+        try (var input = Files.newBufferedReader(Path.of(reference))) {
+            for (var entry : JsonParser.parseReader(input).getAsJsonObject().getAsJsonArray("rows")) {
+                final var row = entry.getAsJsonObject();
+                final CompoundTag vanilla = new CompoundTag();
+                final var kind = row.get("valueType");
+                if (!kind.isJsonNull()) {
+                    vanilla.put("block_id", tag(kind.getAsInt(), row.get("value").getAsInt()));
+                }
+                final CompoundTag properties = new CompoundTag();
+                final var parent = row.get("parentType");
+                if (!parent.isJsonNull()) {
+                    properties.put("vanilla_block_data", parent.getAsInt() == 10 ? vanilla : tag(parent.getAsInt(), 0));
+                }
+                final var actual = new BlockProperties("probe:block", properties).legacyId();
+                if (row.get("skipped").getAsBoolean()) {
+                    assertNull(actual, row::toString);
+                } else {
+                    assertEquals(row.get("legacyId").getAsInt(), actual, row::toString);
+                }
+            }
+        }
+    }
+
+    private static Tag tag(final int kind, final int value) {
+        return switch (kind) {
+            case 1 -> new ByteTag((byte) value);
+            case 2 -> new ShortTag((short) value);
+            case 3 -> new IntTag(value);
+            case 4 -> new LongTag(value);
+            case 5 -> new FloatTag(value);
+            case 6 -> new DoubleTag(value);
+            case 8 -> new StringTag(Integer.toString(value));
+            case 9 -> new ListTag<>(IntTag.class);
+            case 10 -> new CompoundTag();
+            default -> throw new IllegalArgumentException("Unexpected fixture NBT type");
+        };
+    }
+
+}
