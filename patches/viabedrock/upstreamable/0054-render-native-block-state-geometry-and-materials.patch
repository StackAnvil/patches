+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectMap;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Runtime slots retain their state objects even when several slots serialize equally. */
+public final class RuntimeBlockPalette {
+
+    private final Int2ObjectMap<BedrockBlockState> states;
+    private final Map<BlockState, Integer> identifiers;
+    private final Map<BedrockBlockState, Integer> registeredIdentifiers;
+    private final List<Registration> registrations;
+
+    public RuntimeBlockPalette(final List<BedrockBlockState> palette, final boolean hashedIdentifiers) {
+        this.states = new Int2ObjectOpenHashMap<>(palette.size());
+        final Map<BlockState, Integer> identifiers = new HashMap<>();
+        final Map<BedrockBlockState, Integer> registeredIdentifiers = new IdentityHashMap<>();
+        final List<Registration> registrations = new ArrayList<>(palette.size());
+        for (int index = 0; index < palette.size(); index++) {
+            final BedrockBlockState state = palette.get(index);
+            int identifier = hashedIdentifiers ? state.blockStateTag().getIntTag("network_id").asInt() : index;
+            while (hashedIdentifiers && this.states.containsKey(identifier)) {
+                identifier++;
+            }
+            this.states.put(identifier, state);
+            identifiers.put(state, identifier);
+            registeredIdentifiers.put(state, identifier);
+            registrations.add(new Registration(identifier, state));
+        }
+        this.identifiers = Map.copyOf(identifiers);
+        this.registeredIdentifiers = Collections.unmodifiableMap(registeredIdentifiers);
+        this.registrations = List.copyOf(registrations);
+    }
+
+    public BedrockBlockState state(final int identifier) {
+        return this.states.get(identifier);
+    }
+
+    public int identifier(final BlockState state) {
+        return state != null ? this.identifiers.getOrDefault(state, -1) : -1;
+    }
+
+    /** Resolve an owned native state object without collapsing equal serialized states. */
+    public int registeredIdentifier(final BedrockBlockState state) {
+        return this.registeredIdentifiers.getOrDefault(state, -1);
+    }
+
+    public List<Registration> registrations() {
+        return this.registrations;
+    }
+
+    public record Registration(int identifier, BedrockBlockState state) { }
+
+}
