+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockPropertiesTest {
+
+    @Test
+    void roundTripsIndependentPhysicalPropertiesWithoutRenderingGraphs() {
+        final CustomBlockVisual visual = new CustomBlockVisual("test:block", 42, "texture", "{}", "alpha_test",
+                List.of(new CustomBlockVisual.Box(-0.25, 0, 0, 0.75, 0.5, 1)),
+                List.of(new CustomBlockVisual.Box(0, 0, 0, 1, 1.5, 1)), false, 12, 3, Map.of(), Map.of(), new CustomBlockOffset(new CustomBlockOffset.Axis(-0.25F, 0.25F, 5), CustomBlockOffset.ZERO, CustomBlockOffset.ZERO));
+        final var metadata = CustomBlockProperties.encode(List.of(visual));
+        final var decoded = CustomBlockProperties.decode(JsonParser.parseString(metadata.toString()));
+        assertEquals(Map.of(42, CustomBlockProperties.of(visual)), decoded);
+        assertNotEquals(decoded.get(42).collisionBoxes(), decoded.get(42).selectionBoxes());
+        assertThrows(UnsupportedOperationException.class, () -> decoded.clear());
+        assertThrows(UnsupportedOperationException.class, () -> decoded.get(42).collisionBoxes().clear());
+    }
+
+    @Test
+    void canonicalizesEmptyPhysicalBoxesWithoutRejectingThePack() {
+        final var volume = new CustomBlockVisual.Box(0, 0, 0, 1, 1, 1);
+        final List<CustomBlockVisual.Box> boxes = List.of(volume,
+                new CustomBlockVisual.Box(0, 0, 0, 0, 1, 1),
+                new CustomBlockVisual.Box(0, 0, 0, 1, 0, 1),
+                new CustomBlockVisual.Box(0, 0, 0, 1, 1, 0));
+        final var visual = new CustomBlockVisual("test:block", 42, "texture", "{}", "opaque",
+                boxes, boxes.subList(1, 4), false, 0, 15, Map.of(), Map.of(), CustomBlockOffset.NONE);
+        final var properties = CustomBlockProperties.of(visual);
+        assertEquals(List.of(volume), properties.collisionBoxes());
+        assertTrue(properties.selectionBoxes().isEmpty());
+        assertEquals(properties, CustomBlockProperties.decode(CustomBlockProperties.encode(List.of(visual))).get(42));
+        assertEquals(4, visual.collisionBoxes().size());
+    }
+
+    @Test
+    void rejectsAmbiguousVersionsDuplicateStatesAndInvalidBounds() {
+        final CustomBlockVisual visual = new CustomBlockVisual("test:block", 42, "texture", "{}", "opaque",
+                List.of(), List.of(), true, 0, 15, Map.of(), Map.of(), CustomBlockOffset.NONE);
+        final var metadata = CustomBlockProperties.encode(List.of(visual));
+        final var wrongProtocol = metadata.deepCopy();
+        wrongProtocol.addProperty("java_protocol", -1);
+        assertThrows(IllegalArgumentException.class, () -> CustomBlockProperties.decode(wrongProtocol));
+        final var fractional = metadata.deepCopy();
+        fractional.getAsJsonArray("states").get(0).getAsJsonObject().addProperty("javaState", 42.5);
+        assertThrows(ArithmeticException.class, () -> CustomBlockProperties.decode(fractional));
+        final var fractionalSteps = metadata.deepCopy();
+        fractionalSteps.getAsJsonArray("states").get(0).getAsJsonObject().getAsJsonObject("randomOffset").getAsJsonObject("x").addProperty("steps", 0.5);
+        assertThrows(ArithmeticException.class, () -> CustomBlockProperties.decode(fractionalSteps));
+        metadata.getAsJsonArray("states").add(metadata.getAsJsonArray("states").get(0).deepCopy());
+        assertThrows(IllegalArgumentException.class, () -> CustomBlockProperties.decode(metadata));
+        assertThrows(IllegalArgumentException.class, () -> new CustomBlockProperties("test:block", 42,
+                List.of(new CustomBlockVisual.Box(0, 0, 0, Double.POSITIVE_INFINITY, 1, 1)), List.of(), true, 0, 15, CustomBlockOffset.NONE));
+        assertThrows(IllegalArgumentException.class, () -> new CustomBlockProperties("test:block", 42,
+                List.of(new CustomBlockVisual.Box(1, 0, 0, 0, 1, 1)), List.of(), true, 0, 15, CustomBlockOffset.NONE));
+    }
+
+}
