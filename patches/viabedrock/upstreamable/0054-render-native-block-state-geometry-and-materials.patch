+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.IntTag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockOffsetTest {
+
+    @Test
+    void matchesNativeFloatBitsAcrossSignedCoordinatesAndUnsignedStepCounts() {
+        // Target 1.26.51.1 build 51061372; native position-seeded sampler.
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(0x1.E6BE7A0000000P+2F, 0x1.E6BE7A0000000P+2F, 4L), new CustomBlockOffset.Axis(0x1.9F27700000000P+2F, 0x1.9F27700000000P+2F, 1L), new CustomBlockOffset.Axis(0x1.820E860000000P+2F, 0x1.820E860000000P+2F, 1L)), new int[]{1720645806, 17253356, 711327778}, new float[]{0x1.E6BE7A0000000P+2F, 0x1.9F27700000000P+2F, 0x1.820E860000000P+2F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(-0x1.4121800000000P+2F, 0x1.6BF8B80000000P+2F, 17L), new CustomBlockOffset.Axis(0x1.7272CE0000000P+2F, 0x1.53F4F20000000P+0F, 4294967295L), new CustomBlockOffset.Axis(-0x1.6C2E780000000P+2F, 0x1.E174A80000000P-1F, 0L)), new int[]{337674012, -1232401811, -1155698664}, new float[]{-0x1.164FDC0000000P+2F, 0x1.7272CE0000000P+2F, 0x1.EF36000000000P-6F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(0x1.06D0740000000P+0F, 0x1.01AF100000000P+1F, 65535L), new CustomBlockOffset.Axis(-0x1.E18BC80000000P+1F, -0x1.6CF2840000000P+2F, 4294967295L), new CustomBlockOffset.Axis(0x1.9BBEA60000000P+1F, -0x1.7C63E20000000P+2F, 4294967295L)), new int[]{363697201, 1817816250, -1931390587}, new float[]{0x1.EB5FC20000000P+0F, -0x1.E18BC80000000P+1F, 0x1.9BBEA60000000P+1F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(-0x1.2330620000000P-2F, 0x1.9E3A580000000P+0F, 0L), new CustomBlockOffset.Axis(-0x1.454D160000000P+2F, -0x1.B0DFB40000000P+1F, 3L), new CustomBlockOffset.Axis(0x1.2240360000000P+2F, -0x1.163E7E0000000P-1F, 4294967295L)), new int[]{585290726, 1031176958, 1176554839}, new float[]{-0x1.A1AD6C0000000P-3F, -0x1.B0DFB40000000P+1F, 0x1.2240360000000P+2F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(-0x1.C8BBDC0000000P+2F, -0x1.45E7440000000P+2F, 17L), new CustomBlockOffset.Axis(-0x1.514FA80000000P+2F, 0x1.71D4580000000P+2F, 17L), new CustomBlockOffset.Axis(0x1.66CF200000000P+1F, -0x1.45A7B00000000P+0F, 65535L)), new int[]{-471842934, -1009800494, 699382583}, new float[]{-0x1.97AC240000000P+2F, 0x1.45A2180000000P+2F, 0x1.66CF200000000P+1F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(0x1.D24E080000000P+2F, 0x1.D7872A0000000P+2F, 1L), new CustomBlockOffset.Axis(0x1.D3478C0000000P+0F, -0x1.B134BA0000000P+1F, 4L), new CustomBlockOffset.Axis(-0x1.FB4F1E0000000P+2F, 0x1.57CD160000000P+2F, 255L)), new int[]{2024645356, -846298614, -183376699}, new float[]{0x1.D4EA980000000P+2F, 0x1.D3478C0000000P+0F, 0x1.978F600000000P-2F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(-0x1.5001EA0000000P+0F, -0x1.301D480000000P+2F, 17L), new CustomBlockOffset.Axis(-0x1.3385BE0000000P+0F, 0x1.4B6C0E0000000P+2F, 17L), new CustomBlockOffset.Axis(-0x1.D1D27E0000000P-4F, 0x1.4AC44E0000000P+2F, 3L)), new int[]{756989849, -2082438609, -1987942187}, new float[]{-0x1.5001EA0000000P+0F, -0x1.9D7BFC0000000P-2F, 0x1.437D040000000P+1F});
+        check(new CustomBlockOffset(new CustomBlockOffset.Axis(0x1.95BEE00000000P+0F, 0x1.A354F80000000P+2F, 4L), new CustomBlockOffset.Axis(-0x1.0AE5560000000P+2F, 0x1.7E67C20000000P+2F, 0L), new CustomBlockOffset.Axis(-0x1.DE3DD40000000P+2F, 0x1.119C5E0000000P+1F, 17L)), new int[]{1274668428, 829203851, 120172440}, new float[]{0x1.395DE40000000P+2F, 0x1.8463480000000P+1F, -0x1.A251240000000P+1F});
+    }
+
+    @Test
+    void decodesPixelRangesAndUnsignedWireStepsBeforeSampling() {
+        final CompoundTag component = new CompoundTag();
+        final CompoundTag x = new CompoundTag();
+        final CompoundTag range = new CompoundTag();
+        range.put("min", new FloatTag(-3));
+        range.put("max", new FloatTag(3));
+        x.put("range", range);
+        x.put("steps", new IntTag(-1));
+        component.put("x", x);
+        final var decoded = CustomBlockOffset.fromComponent(component);
+        assertEquals(new CustomBlockOffset.Axis(-0.1875F, 0.1875F, 0xFFFFFFFFL), decoded.x());
+        assertEquals(CustomBlockOffset.ZERO, decoded.y());
+        assertEquals(CustomBlockOffset.ZERO, decoded.z());
+        assertEquals(CustomBlockOffset.NONE, CustomBlockOffset.fromComponent(null));
+        assertThrows(IllegalArgumentException.class, () -> new CustomBlockOffset.Axis(Float.NaN, 1, 0));
+        assertThrows(IllegalArgumentException.class, () -> new CustomBlockOffset.Axis(0, 1, 0x100000000L));
+    }
+
+    @Test
+    void keepsDrawOrderWhenEarlierAxesAreConstant() {
+        final var varying = new CustomBlockOffset.Axis(-0.25F, 0.25F, 0);
+        final var all = new CustomBlockOffset(varying, varying, varying).at(-17, 64, 93);
+        final var last = new CustomBlockOffset(CustomBlockOffset.ZERO, CustomBlockOffset.ZERO, varying).at(-17, 64, 93);
+        assertEquals(all.z(), last.z());
+        assertEquals(0, last.x());
+        assertEquals(0, last.y());
+    }
+
+    @Test
+    void separatesContinuousOutlinesFromFlooredCollisionAndPreservesWorldFloatOrder() {
+        final var offset = new CustomBlockOffset(new CustomBlockOffset.Axis(-0.125F, -0.125F, 0),
+                new CustomBlockOffset.Axis(0.125F, 0.125F, 0), new CustomBlockOffset.Axis(0.25F, 0.25F, 0));
+        final var box = new CustomBlockVisual.Box(0.25, 0, 0.25, 0.75, 0.5, 0.75);
+        final var properties = new CustomBlockProperties("test:block", 1, java.util.List.of(box), java.util.List.of(box), false, 0, 15, offset);
+        assertEquals(new CustomBlockVisual.Box(-0.75, 64, 0.25, -0.25, 64.5, 0.75), properties.collisionBoxesAt(0, 64, 0).getFirst());
+        assertEquals(new CustomBlockVisual.Box(0.125, 64.125, 0.5, 0.625, 64.625, 1), properties.selectionBoxesAt(0, 64, 0).getFirst());
+        assertEquals(properties.selectionBoxesAt(0, 64, 0), properties.cameraBoxesAt(0, 64, 0));
+        // At this coordinate native float addition collapses the half-block box.
+        assertTrue(properties.selectionBoxesAt(16777216, 64, 16777216).isEmpty());
+    }
+
+    private static void check(final CustomBlockOffset definition, final int[] position, final float[] expected) {
+        final var actual = definition.at(position[0], position[1], position[2]);
+        assertArrayEquals(new int[]{Float.floatToRawIntBits(expected[0]), Float.floatToRawIntBits(expected[1]), Float.floatToRawIntBits(expected[2])},
+                new int[]{Float.floatToRawIntBits(actual.x()), Float.floatToRawIntBits(actual.y()), Float.floatToRawIntBits(actual.z())});
+        assertEquals(actual, definition.at(position[0], Integer.MIN_VALUE, position[2]));
+        assertEquals(actual, definition.at(position[0], Integer.MAX_VALUE, position[2]));
+    }
+
+}
