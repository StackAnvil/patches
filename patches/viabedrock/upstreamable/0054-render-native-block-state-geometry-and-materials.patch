+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Resolves a block item's legacy auxiliary value before concrete descriptor conversion. */
+public final class BlockItemStates {
+
+    private static final Definitions DEFINITIONS = loadDefinitions();
+
+    private final BlockRegistryNames names;
+    private final Map<String, BedrockBlockState> defaults;
+    private final Map<String, Map<Short, BedrockBlockState>> auxiliary;
+    private final Map<String, Integer> legacyIds;
+    private final Map<Integer, BedrockBlockState> legacyStates;
+    private final Map<String, Map<Short, BedrockBlockState>> cache = new HashMap<>();
+
+    public BlockItemStates(final List<BedrockBlockState> palette, final BlockRegistryNames names,
+                           final BlockItemDescriptors descriptors, final Map<String, Integer> legacyIds,
+                           final Map<Integer, BedrockBlockState> legacyStates) {
+        this.names = names;
+        this.legacyIds = Map.copyOf(legacyIds);
+        final Map<BlockState, BedrockBlockState> registered = new HashMap<>();
+        final Map<String, BedrockBlockState> defaults = new HashMap<>();
+        for (final BedrockBlockState state : palette) {
+            // Unmodeled custom archetypes must not acquire a generic default.
+            if (descriptors.resolve(state) != null) {
+                registered.putIfAbsent(state, state);
+                defaults.putIfAbsent(state.namespacedIdentifier(), state);
+            }
+        }
+        DEFINITIONS.defaults.forEach((name, state) -> {
+            if (defaults.containsKey(name)) {
+                defaults.put(name, requireRegistered(registered, state));
+            }
+        });
+        final Map<Integer, BedrockBlockState> canonicalLegacy = new HashMap<>();
+        legacyStates.forEach((id, state) -> canonicalLegacy.put(id, requireRegistered(registered, state)));
+        this.legacyStates = Map.copyOf(canonicalLegacy);
+        this.defaults = Map.copyOf(defaults);
+        final Map<String, Map<Short, BedrockBlockState>> auxiliary = new HashMap<>();
+        DEFINITIONS.auxiliary.forEach((name, variants) -> {
+            if (!defaults.containsKey(name)) {
+                return;
+            }
+            final Map<Short, BedrockBlockState> resolved = new HashMap<>();
+            variants.forEach((metadata, state) -> resolved.put(metadata, requireRegistered(registered, state)));
+            auxiliary.put(name, Map.copyOf(resolved));
+        });
+        this.auxiliary = Map.copyOf(auxiliary);
+    }
+
+    public BedrockBlockState resolve(final String identifier, final short metadata) {
+        final String registered = this.names.resolve(identifier);
+        if (registered == null) {
+            return null;
+        }
+        final BedrockBlockState fallback = this.defaults.get(registered);
+        if (fallback == null || metadata < 0 || metadata > 63 || !registered.startsWith("minecraft:")) {
+            return fallback;
+        }
+        return this.cache.computeIfAbsent(registered, ignored -> new HashMap<>())
+                .computeIfAbsent(metadata, ignored -> this.resolveUncached(registered, metadata, fallback));
+    }
+
+    private BedrockBlockState resolveUncached(final String identifier, final short metadata, final BedrockBlockState fallback) {
+        final BedrockBlockState variant = this.auxiliary.getOrDefault(identifier, Map.of()).get(metadata);
+        if (variant != null) {
+            return variant;
+        }
+        // Serialization names select the legacy-data conversion, independently
+        // of primary-name and registry-alias lookup above.
+        final String legacyName = DEFINITIONS.legacyNames.getOrDefault(identifier, identifier);
+        final Integer legacyId = this.legacyIds.get(legacyName);
+        return legacyId != null ? this.legacyStates.getOrDefault(legacyId << 6 | metadata, fallback) : fallback;
+    }
+
+    private static BedrockBlockState requireRegistered(final Map<BlockState, BedrockBlockState> registered, final BlockState state) {
+        final BedrockBlockState resolved = registered.get(state);
+        if (resolved == null) {
+            throw new IllegalStateException("Unregistered block item state: " + state.toBlockStateString());
+        }
+        return resolved;
+    }
+
+    private static Definitions loadDefinitions() {
+        try (var stream = BlockItemStates.class.getResourceAsStream("/assets/viabedrock/data/bedrock/block_item_states.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("Missing block item state definitions");
+            }
+            final var data = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (data.get("format").getAsInt() != 1 || data.get("protocol").getAsInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalStateException("Block item state definitions do not match the target protocol");
+            }
+            final Map<String, BlockState> defaults = new HashMap<>();
+            data.getAsJsonObject("defaults").entrySet().forEach(entry -> defaults.put(entry.getKey(), BlockState.fromString(entry.getValue().getAsString())));
+            final Map<String, Map<Short, BlockState>> auxiliary = new HashMap<>();
+            data.getAsJsonObject("auxiliary").entrySet().forEach(entry -> {
+                final Map<Short, BlockState> variants = new HashMap<>();
+                entry.getValue().getAsJsonObject().entrySet().forEach(variant -> {
+                    final short metadata = Short.parseShort(variant.getKey());
+                    if (metadata < 0 || metadata > 63) {
+                        throw new IllegalStateException("Block item auxiliary value is outside the native cache range");
+                    }
+                    variants.put(metadata, BlockState.fromString(variant.getValue().getAsString()));
+                });
+                auxiliary.put(entry.getKey(), Map.copyOf(variants));
+            });
+            final Map<String, String> legacyNames = new HashMap<>();
+            data.getAsJsonObject("legacyNames").entrySet().forEach(entry -> legacyNames.put(entry.getKey(), entry.getValue().getAsString()));
+            return new Definitions(Map.copyOf(defaults), Map.copyOf(auxiliary), Map.copyOf(legacyNames));
+        } catch (final IOException error) {
+            throw new IllegalStateException("Failed to load block item state definitions", error);
+        }
+    }
+
+    private record Definitions(Map<String, BlockState> defaults, Map<String, Map<Short, BlockState>> auxiliary,
+                               Map<String, String> legacyNames) { }
+
+}
