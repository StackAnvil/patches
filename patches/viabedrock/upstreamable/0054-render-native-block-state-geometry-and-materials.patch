+    private static void omitInvisibleFaces(final JsonObject model, final Map<String, Boolean> visibleSprites) {
+        final JsonObject textures = model.getAsJsonObject("textures");
+        final JsonArray elements = new JsonArray();
+        for (JsonElement value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            final JsonObject faces = element.getAsJsonObject("faces");
+            for (String direction : List.copyOf(faces.keySet())) {
+                final String binding = faces.getAsJsonObject(direction).get("texture").getAsString();
+                final JsonElement material = binding.startsWith("#") ? textures.get(binding.substring(1)) : new JsonPrimitive(binding);
+                final String sprite = material instanceof JsonObject reference ? reference.get("sprite").getAsString() : material.getAsString();
+                if (!visibleSprites.getOrDefault(sprite, true)) {
+                    faces.remove(direction);
+                }
+            }
+            if (!faces.isEmpty()) {
+                elements.add(element);
+            }
+        }
+        // Culling participation was compiled from the authored geometry before this pass.
+        // Invisible materials still contribute their native voxel slices and physical boxes.
+        model.add("elements", elements);
+    }
+
+    private static void addPlaneBackFaces(final JsonObject element, final Map<Direction, String> methods, final Set<String> authoredFaces) {
+        final double[] from = point(element.getAsJsonArray("from"));
+        final double[] to = point(element.getAsJsonArray("to"));
+        final JsonObject faces = element.getAsJsonObject("faces");
+        for (String name : List.copyOf(faces.keySet())) {
+            final Direction direction = Direction.valueOf(name.toUpperCase(java.util.Locale.ROOT));
+            final int axis = switch (direction) {
+                case EAST, WEST -> 0;
+                case UP, DOWN -> 1;
+                case NORTH, SOUTH -> 2;
+            };
+            if (from[axis] != to[axis] || !methods.get(direction).equals("alpha_test")) {
+                continue;
+            }
+            final String opposite = switch (direction) {
+                case EAST -> "west";
+                case WEST -> "east";
+                case UP -> "down";
+                case DOWN -> "up";
+                case NORTH -> "south";
+                case SOUTH -> "north";
+            };
+            if (authoredFaces.contains(opposite)) {
+                continue;
+            }
+            final JsonObject back = faces.getAsJsonObject(name).deepCopy();
+            final JsonArray uv = back.getAsJsonArray("uv");
+            // Opposite Java faces traverse a plane in reverse. Keep the same
+            // texel at each point instead of mirroring the authored image.
+            final int coordinate = axis == 1 ? 1 : 0;
+            final JsonElement start = uv.get(coordinate);
+            uv.set(coordinate, uv.get(coordinate + 2));
+            uv.set(coordinate + 2, start);
+            if (back.has("rotation")) {
+                back.addProperty("rotation", (360 - back.get("rotation").getAsInt()) % 360);
+            }
+            faces.add(opposite, back);
+        }
+    }
+
+    private static void applyFaceMaterials(final JsonObject model, final Map<String, CustomBlockLighting> faceLighting, final Map<Direction, String> methods) {
+        final JsonArray elements = new JsonArray();
+        for (JsonElement value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            final var authoredFaces = Set.copyOf(element.getAsJsonObject("faces").keySet());
+            final JsonObject shadedFaces = new JsonObject();
+            final JsonObject unshadedFaces = new JsonObject();
+            for (Map.Entry<String, JsonElement> face : element.getAsJsonObject("faces").entrySet()) {
+                final CustomBlockLighting lighting = faceLighting.get(face.getKey());
+                face.getValue().getAsJsonObject().add(CustomBlockLighting.KEY, lighting.json());
+                (lighting.faceDimming() ? shadedFaces : unshadedFaces).add(face.getKey(), face.getValue());
+            }
+            if (!shadedFaces.isEmpty()) {
+                element.add("faces", shadedFaces);
+                addPlaneBackFaces(element, methods, authoredFaces);
+                elements.add(element);
+            }
+            if (!unshadedFaces.isEmpty()) {
+                final JsonObject unshaded = element.deepCopy();
+                unshaded.add("faces", unshadedFaces);
+                // Java 26.3 replaces the old shade flag with a direction override.
+                // Upward faces have no directional attenuation, without making them emissive.
+                unshaded.addProperty("shade_direction_override", "up");
+                addPlaneBackFaces(unshaded, methods, authoredFaces);
+                elements.add(unshaded);
+            }
+        }
+        model.add("elements", elements);
+    }
+
+    private static int byteLight(final CompoundTag components, final String component, final String key, final int fallback) {
+        if (!(components.get(component) instanceof CompoundTag value)) {
+            return fallback;
+        }
+        // The native readers initialize recognized components to zero and accept only byte fields.
+        return value.get(key) instanceof ByteTag number ? Math.clamp(number.asInt(), 0, 15) : 0;
+    }
+
+    private static int light(final CompoundTag components, final String component, final String key, final int fallback) {
+        final CompoundTag value = components.getCompoundTag(component);
+        return value != null && value.get(key) instanceof NumberTag number ? Math.max(0, Math.min(15, number.asInt())) : fallback;
+    }
+
+    private static JsonObject geometry(final BedrockGeometryModel original, final Map<Direction, String> textures) {
+        final BedrockGeometryModel geometry = new BedrockGeometryModel(original.getIdentifier(), original.getTextureSize());
+        final Map<String, Parent> bones = new LinkedHashMap<>();
+        for (Parent parent : original.getParents()) {
+            if (bones.putIfAbsent(parent.getName(), parent) != null) {
+                throw new IllegalArgumentException("Duplicate geometry bone");
+            }
+            final Parent clone = parent.clone();
+            // CubeConverter subtracts inflate from the origin but only adds it once to the size.
+            // Bedrock inflation expands both faces; compensate on this block-only copy.
+            clone.getCubes().values().forEach(cube -> cube.getSize().set(cube.getSize().add(cube.getInflate(), cube.getInflate(), cube.getInflate())));
+            geometry.getParents().add(clone);
+        }
+        final JavaItemModel converted = geometry.toJavaItemModel(textures, RotationType.POST_1_21_11);
+        final JsonObject model = converted.compile();
+        final JsonArray groups = model.getAsJsonArray("groups");
+        undoItemFit(model, converted.getScale());
+        final JsonArray elements = model.getAsJsonArray("elements");
+        int groupIndex = 0;
+        for (Parent parent : converted.getParents()) {
+            final JsonObject part = new JsonObject();
+            final JsonArray cubes = new JsonArray();
+            final JsonArray children = groups.get(groupIndex++).getAsJsonObject().getAsJsonArray("children");
+            int emitted = 0;
+            for (var entry : parent.getCubes().entrySet()) {
+                if (entry.getValue().getUvMap().getUvMap().values().stream().noneMatch(java.util.Objects::nonNull)) {
+                    continue;
+                }
+                final JsonObject element = elements.get(children.get(emitted++).getAsInt()).getAsJsonObject();
+                element.addProperty("viabedrock_bone", parent.getName());
+                element.addProperty("viabedrock_cube", entry.getKey());
+                cubes.add(element);
+            }
+            part.add("elements", cubes);
+            final var visited = new HashSet<String>();
+            Parent bone = bones.get(parent.getName());
+            // Child pivots are expressed in model coordinates. Apply the child first, then
+            // its ancestors, to obtain the same root-to-child matrix product for each cube.
+            while (bone != null) {
+                if (!visited.add(bone.getName())) {
+                    throw new IllegalArgumentException("Cyclic geometry bone hierarchy");
+                }
+                if (!bone.getRotation().isZero()) {
+                    transformModel(part, new Transform(bone));
+                }
+                if (bone.getParent() == null || bone.getParent().isEmpty()) {
+                    break;
+                }
+                bone = bones.get(bone.getParent());
+                if (bone == null) {
+                    throw new IllegalArgumentException("Missing geometry parent bone");
+                }
+            }
+        }
+        return model;
+    }
+
+    private static JsonObject fullCube(final Map<Direction, String> textureIds, final boolean legacyOrientation) {
+        final JsonObject model = new JsonObject();
+        final JsonObject textures = new JsonObject();
+        for (Map.Entry<Direction, String> entry : textureIds.entrySet()) {
+            textures.addProperty(entry.getKey().name().toLowerCase(java.util.Locale.ROOT), entry.getValue());
+        }
+        model.add("textures", textures);
+        final JsonObject element = new JsonObject();
+        element.add("from", vector(0, 0, 0));
+        element.add("to", vector(16, 16, 16));
+        final JsonObject faces = new JsonObject();
+        for (String direction : List.of("down", "up", "north", "south", "west", "east")) {
+            final JsonObject face = new JsonObject();
+            face.addProperty("texture", "#" + direction);
+            if (legacyOrientation && direction.equals("down")) {
+                face.addProperty("rotation", 180);
+            }
+            faces.add(direction, face);
+        }
+        element.add("faces", faces);
+        final JsonArray elements = new JsonArray();
+        elements.add(element);
+        model.add("elements", elements);
+        return model;
+    }
+
+    private static void undoItemFit(final JsonObject model, final double scale) {
+        for (JsonElement value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            element.remove("name");
+            for (String key : List.of("from", "to")) {
+                final double[] point = point(element.getAsJsonArray(key));
+                element.add(key, vector((point[0] - 8) * scale + 8, point[1] * scale, (point[2] - 8) * scale + 8));
+            }
+            if (element.get("rotation") instanceof JsonObject rotation) {
+                final double[] pivot = point(rotation.getAsJsonArray("origin"));
+                rotation.add("origin", vector((pivot[0] - 8) * scale + 8, pivot[1] * scale, (pivot[2] - 8) * scale + 8));
+            }
+        }
+        model.remove("groups");
+    }
+
+    static void transformModel(final JsonObject model, final Transform transform) {
+        for (JsonElement value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            final double[] from = point(element.getAsJsonArray("from"));
+            final double[] to = point(element.getAsJsonArray("to"));
+            final double[] center = new double[]{(from[0] + to[0]) / 2, (from[1] + to[1]) / 2, (from[2] + to[2]) / 2};
+            double[][] local = rotation(0, 0, 0);
+            if (element.get("rotation") instanceof JsonObject rotation) {
+                double x = 0;
+                double y = 0;
+                double z = 0;
+                if (rotation.has("axis")) {
+                    final double angle = rotation.get("angle").getAsDouble();
+                    switch (rotation.get("axis").getAsString()) {
+                        case "x" -> x = angle;
+                        case "y" -> y = angle;
+                        case "z" -> z = angle;
+                        default -> throw new IllegalArgumentException("Unknown model rotation axis");
+                    }
+                } else {
+                    x = number(rotation, "x", 0);
+                    y = number(rotation, "y", 0);
+                    z = number(rotation, "z", 0);
+                }
+                local = rotation(x, y, z);
+                final double[] pivot = point(rotation.getAsJsonArray("origin"));
+                final double[] relative = new double[]{center[0] - pivot[0], center[1] - pivot[1], center[2] - pivot[2]};
+                final double[] rotated = apply(local, relative);
+                for (int i = 0; i < 3; i++) {
+                    center[i] = pivot[i] + rotated[i];
+                }
+                if (!transform.uniformScale() && (x != 0 || y != 0 || z != 0)) {
+                    throw new IllegalArgumentException("Nonuniform scaling of a rotated cube requires mesh baking");
+                }
+            }
+            final double[] positioned = transform.point(center);
+            final double[] half = new double[]{(to[0] - from[0]) * transform.scale[0] / 2,
+                (to[1] - from[1]) * transform.scale[1] / 2, (to[2] - from[2]) * transform.scale[2] / 2};
+            element.add("from", vector(positioned[0] - half[0], positioned[1] - half[1], positioned[2] - half[2]));
+            element.add("to", vector(positioned[0] + half[0], positioned[1] + half[1], positioned[2] + half[2]));
+            final double[][] orientation = multiply(transform.rotation, local);
+            final JsonObject rotation = new JsonObject();
+            rotation.add("origin", vector(positioned));
+            final double y = Math.asin(Math.max(-1, Math.min(1, -orientation[2][0])));
+            final double x = Math.abs(Math.cos(y)) > 1E-8 ? Math.atan2(orientation[2][1], orientation[2][2]) : 0;
+            final double z = Math.abs(Math.cos(y)) > 1E-8 ? Math.atan2(orientation[1][0], orientation[0][0]) : Math.atan2(-orientation[0][1], orientation[1][1]);
+            rotation.addProperty("x", Math.toDegrees(x));
+            rotation.addProperty("y", Math.toDegrees(y));
+            rotation.addProperty("z", Math.toDegrees(z));
+            element.add("rotation", rotation);
+        }
+    }
+
+    private static List<CustomBlockVisual.Box> boxes(final CompoundTag component, final boolean selection, final Transform transform) {
+        if (component != null && component.get("enabled") instanceof NumberTag enabled && enabled.asInt() == 0) {
+            return List.of();
+        }
+        final List<double[]> bounds = new ArrayList<>();
+        final ListTag<CompoundTag> boxes = component == null ? null : component.getListTag("boxes", CompoundTag.class);
+        if (boxes != null) {
+            for (CompoundTag box : boxes) {
+                bounds.add(new double[]{number(box, "minX", 0), number(box, "minY", 0), number(box, "minZ", 0),
+                        number(box, "maxX", 16), number(box, "maxY", 16), number(box, "maxZ", 16)});
+            }
+        } else if (component != null && component.getListTag("origin") != null && component.getListTag("size") != null) {
+            final ListTag<?> origin = component.getListTag("origin");
+            final ListTag<?> size = component.getListTag("size");
+            final double x = ((NumberTag) origin.get(0)).asDouble() + 8;
+            final double y = ((NumberTag) origin.get(1)).asDouble();
+            final double z = ((NumberTag) origin.get(2)).asDouble() + 8;
+            bounds.add(new double[]{x, y, z, x + ((NumberTag) size.get(0)).asDouble(), y + ((NumberTag) size.get(1)).asDouble(), z + ((NumberTag) size.get(2)).asDouble()});
+        } else {
+            bounds.add(new double[]{0, 0, 0, 16, 16, 16});
+        }
+        final List<CustomBlockVisual.Box> result = new ArrayList<>();
+        for (double[] box : bounds) {
+            // An empty native shape stays empty even if rotation expands its enclosing bounds.
+            if (box[0] == box[3] || box[1] == box[4] || box[2] == box[5]) {
+                continue;
+            }
+            final double[] min = new double[]{Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY};
+            final double[] max = new double[]{Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY};
+            for (int corner = 0; corner < 8; corner++) {
+                final double[] point = transform.point(new double[]{box[(corner & 1) == 0 ? 0 : 3], box[(corner & 2) == 0 ? 1 : 4], box[(corner & 4) == 0 ? 2 : 5]});
+                for (int i = 0; i < 3; i++) {
+                    min[i] = Math.min(min[i], point[i]);
+                    max[i] = Math.max(max[i], point[i]);
+                }
+            }
+            if (min[0] == max[0] || min[1] == max[1] || min[2] == max[2]) {
+                continue;
+            }
+            result.add(new CustomBlockVisual.Box(min[0] / 16, min[1] / 16, min[2] / 16, max[0] / 16, max[1] / 16, max[2] / 16));
+        }
+        return List.copyOf(result);
+    }
+
+    private static double number(final CompoundTag tag, final String key, final double fallback) {
+        return tag != null && tag.get(key) instanceof NumberTag number ? number.asDouble() : fallback;
+    }
+
+    private static double number(final JsonObject tag, final String key, final double fallback) {
+        return tag.has(key) ? tag.get(key).getAsDouble() : fallback;
+    }
+
+    private static double[] point(final JsonArray array) {
+        return new double[]{array.get(0).getAsDouble(), array.get(1).getAsDouble(), array.get(2).getAsDouble()};
+    }
+
+    private static JsonArray vector(final double... values) {
+        final JsonArray result = new JsonArray();
+        for (double value : values) {
+            result.add(Math.abs(value) < 1E-10 ? 0 : value);
+        }
+        return result;
+    }
+
+    private static double[][] rotation(final double xDegrees, final double yDegrees, final double zDegrees) {
+        final double x = Math.toRadians(xDegrees);
+        final double y = Math.toRadians(yDegrees);
+        final double z = Math.toRadians(zDegrees);
+        final double cx = Math.cos(x);
+        final double sx = Math.sin(x);
+        final double cy = Math.cos(y);
+        final double sy = Math.sin(y);
+        final double cz = Math.cos(z);
+        final double sz = Math.sin(z);
+        return new double[][]{{cz * cy, cz * sy * sx - sz * cx, cz * sy * cx + sz * sx},
+            {sz * cy, sz * sy * sx + cz * cx, sz * sy * cx - cz * sx}, {-sy, cy * sx, cy * cx}};
+    }
+
+    private static double[][] multiply(final double[][] a, final double[][] b) {
+        final double[][] result = new double[3][3];
+        for (int row = 0; row < 3; row++) {
+            for (int column = 0; column < 3; column++) {
+                for (int i = 0; i < 3; i++) {
+                    result[row][column] += a[row][i] * b[i][column];
+                }
+            }
+        }
+        return result;
+    }
+
+    private static double[] apply(final double[][] matrix, final double[] point) {
+        final double[] result = new double[3];
+        for (int row = 0; row < 3; row++) {
+            for (int column = 0; column < 3; column++) {
+                result[row] += matrix[row][column] * point[column];
+            }
+        }
+        return result;
+    }
+
+    static final class Transform {
+        private final double[] scale;
+        private final double[] translation;
+        private final double[] rotationPivot;
+        private final double[] scalePivot;
+        private final double[][] rotation;
+
+        Transform(final CompoundTag tag) {
+            this.scale = new double[]{number(tag, "SX", 1), number(tag, "SY", 1), number(tag, "SZ", 1)};
+            this.translation = new double[]{number(tag, "TX", 0) * 16, number(tag, "TY", 0) * 16, number(tag, "TZ", 0) * 16};
+            this.rotationPivot = new double[]{8 + number(tag, "RXP", 0) * 16, 8 + number(tag, "RYP", 0) * 16, 8 + number(tag, "RZP", 0) * 16};
+            this.scalePivot = new double[]{8 + number(tag, "SXP", 0) * 16, 8 + number(tag, "SYP", 0) * 16, 8 + number(tag, "SZP", 0) * 16};
+            this.rotation = rotation(-number(tag, "RX", 0) * 90, -number(tag, "RY", 0) * 90, number(tag, "RZ", 0) * 90);
+        }
+
+        Transform(final Parent bone) {
+            this.scale = new double[]{1, 1, 1};
+            this.translation = new double[]{0, 0, 0};
+            this.rotationPivot = new double[]{8 - bone.getPivot().getX(), bone.getPivot().getY(), 8 + bone.getPivot().getZ()};
+            this.scalePivot = new double[]{0, 0, 0};
+            this.rotation = rotation(-bone.getRotation().getX(), -bone.getRotation().getY(), bone.getRotation().getZ());
+        }
+
+        double[] point(final double[] point) {
+            final double[] scaled = new double[3];
+            for (int i = 0; i < 3; i++) {
+                scaled[i] = (point[i] - this.scalePivot[i]) * this.scale[i] + this.scalePivot[i] - this.rotationPivot[i];
+            }
+            final double[] rotated = apply(this.rotation, scaled);
+            for (int i = 0; i < 3; i++) {
+                rotated[i] += this.rotationPivot[i] + this.translation[i];
+            }
+            return rotated;
+        }
+
+        CustomBlockCulling.Direction direction(final CustomBlockCulling.Direction direction) {
+            final double[] normal = new double[3];
+            normal[direction.axis()] = direction.positive() ? 1 : -1;
+            final double[] transformed = apply(this.rotation, normal);
+            for (var candidate : CustomBlockCulling.Direction.values()) {
+                if (Math.abs(transformed[candidate.axis()] - (candidate.positive() ? 1 : -1)) < 1E-8) {
+                    return candidate;
+                }
+            }
+            throw new IllegalArgumentException("Culling direction does not remain axis aligned");
+        }
+
+        boolean uniformScale() {
+            return this.scale[0] == this.scale[1] && this.scale[1] == this.scale[2];
+        }
+
+        boolean identity() {
+            return this.scale[0] == 1 && this.scale[1] == 1 && this.scale[2] == 1
+                    && this.translation[0] == 0 && this.translation[1] == 0 && this.translation[2] == 0
+                    && Math.abs(this.rotation[0][0] - 1) < 1E-8 && Math.abs(this.rotation[1][1] - 1) < 1E-8 && Math.abs(this.rotation[2][2] - 1) < 1E-8;
+        }
+    }
+
+}
