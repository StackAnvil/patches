--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/chunk/blockstate/BlockItemStatesTest.java
@@ -0,0 +1,135 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.chunk.blockstate;
+
+import com.viaversion.nbt.io.NBTIO;
+import com.viaversion.nbt.limiter.TagLimiter;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.BedrockBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.DataInputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.zip.GZIPInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BlockItemStatesTest {
+
+    @Test
+    void distinguishesLegacyMetadataFromCanonicalMetadataAndRegisteredDefaults() throws Exception {
+        final var states = resolver(palette(), Map.of(), Map.of(), Map.of());
+        assertEquals("x", states.resolve("BASALT", (short) 1).properties().get("pillar_axis"));
+        assertEquals("16", states.resolve("minecraft:glow_lichen", (short) 4).properties().get("multi_face_direction_bits"));
+        assertEquals("0", states.resolve("minecraft:glow_lichen", (short) 0).properties().get("multi_face_direction_bits"));
+        for (final short metadata : new short[]{-1, Short.MIN_VALUE, 64, 255, Short.MAX_VALUE}) {
+            assertEquals("63", states.resolve("minecraft:glow_lichen", metadata).properties().get("multi_face_direction_bits"));
+            assertEquals("14", states.resolve("minecraft:red_mushroom_block", metadata).properties().get("huge_mushroom_bits"));
+        }
+        assertNull(states.resolve("tile.basalt", (short) 0));
+        assertNull(states.resolve("probe:missing", (short) 0));
+    }
+
+    @Test
+    void legacySerializationNamesUseSixBitMetadataWithoutWrappingAndOwnTheirInputs() throws Exception {
+        final var palette = palette();
+        final BedrockBlockState red = palette.stream().filter(state -> state.namespacedIdentifier().equals("minecraft:red_wool")).findFirst().orElseThrow();
+        final var ids = new HashMap<>(Map.of("minecraft:wool", 35));
+        final var legacy = new HashMap<>(Map.of(35 << 6 | 14, BedrockBlockState.fromNbt(red.blockStateTag().copy())));
+        final var states = resolver(palette, Map.of(), ids, legacy);
+        ids.clear();
+        legacy.clear();
+        assertSame(red, states.resolve("wool", (short) 14));
+        assertSame(red, states.resolve("minecraft:white_wool", (short) 14));
+        assertEquals("minecraft:white_wool", states.resolve("wool", (short) 64).namespacedIdentifier());
+        assertEquals("minecraft:white_wool", states.resolve("wool", (short) -1).namespacedIdentifier());
+    }
+
+    @Test
+    void genericCustomMetadataAlwaysSelectsTheExactOriginalDefault() throws Exception {
+        final var palette = new ArrayList<>(palette());
+        final Map<BlockState, BlockItemDescriptor> custom = new IdentityHashMap<>();
+        for (final short metadata : new short[]{0, 1, 4}) {
+            final CompoundTag tag = new CompoundTag();
+            tag.putString("name", "probe:repeated");
+            tag.put("states", new CompoundTag());
+            final var state = BedrockBlockState.fromNbt(tag);
+            palette.add(state);
+            custom.put(state, new BlockItemDescriptor(60000, metadata));
+        }
+        final var states = resolver(palette, custom, Map.of(), Map.of());
+        final var expected = palette.get(palette.size() - 3);
+        final var runtime = new RuntimeBlockPalette(palette, false);
+        assertEquals(palette.size() - 1, runtime.identifier(expected));
+        assertEquals(palette.size() - 3, runtime.registeredIdentifier(expected));
+        for (final short metadata : new short[]{Short.MIN_VALUE, -1, 0, 1, 4, 63, 64, Short.MAX_VALUE}) {
+            assertSame(expected, states.resolve("probe:repeated", metadata));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_BDS_BLOCK_DEFAULTS", matches = ".+")
+    void matchesAllPinnedServerRegisteredDefaults() throws Exception {
+        final var states = resolver(palette(), Map.of(), Map.of(), Map.of());
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_BDS_BLOCK_DEFAULTS")))).getAsJsonObject();
+        for (final var entry : reference.getAsJsonObject("defaults").entrySet()) {
+            final var expected = state(entry.getKey(), entry.getValue().getAsJsonObject());
+            assertEquals(expected, states.resolve(entry.getKey(), (short) -1));
+            assertEquals(expected, states.resolve(entry.getKey(), (short) 64));
+        }
+        assertFalse(reference.getAsJsonObject("defaults").isEmpty());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_BDS_BLOCK_AUXILIARY", matches = ".+")
+    void matchesPinnedServerItemConstructionAcrossAvailableCommandTypes() throws Exception {
+        final var states = resolver(palette(), Map.of(), Map.of(), Map.of());
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_BDS_BLOCK_AUXILIARY")))).getAsJsonObject();
+        int compared = 0;
+        for (final var entry : reference.getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            if (!row.has("count") || row.get("count").getAsInt() != 1) {
+                continue;
+            }
+            assertEquals(state(row.get("block").getAsString(), row.getAsJsonObject("states")),
+                    states.resolve(row.get("name").getAsString(), row.get("metadata").getAsShort()), row::toString);
+            compared++;
+        }
+        assertTrue(compared > 0);
+    }
+
+    private static BlockState state(final String name, final JsonObject properties) {
+        final Map<String, String> values = new HashMap<>();
+        properties.entrySet().forEach(entry -> values.put(entry.getKey(), entry.getValue().getAsJsonPrimitive().isBoolean()
+                ? entry.getValue().getAsBoolean() ? "1" : "0" : entry.getValue().getAsString()));
+        final String[] identity = name.split(":", 2);
+        return new BlockState(identity[0], identity[1], values);
+    }
+
+    private static BlockItemStates resolver(final List<BedrockBlockState> palette, final Map<BlockState, BlockItemDescriptor> custom,
+                                            final Map<String, Integer> legacyIds, final Map<Integer, BedrockBlockState> legacyStates) {
+        return new BlockItemStates(palette, new BlockRegistryNames(palette.stream().map(BlockState::namespacedIdentifier).toList()),
+                new BlockItemDescriptors(palette, custom), legacyIds, legacyStates);
+    }
+
+    private static List<BedrockBlockState> palette() throws Exception {
+        try (var input = BlockItemStatesTest.class.getResourceAsStream("/assets/viabedrock/data/bedrock/block_palette.nbt")) {
+            final var root = NBTIO.readTag(new DataInputStream(new GZIPInputStream(input)), TagLimiter.noop(), true, CompoundTag.class);
+            return root.getListTag("blocks", CompoundTag.class).getValue().stream().map(BedrockBlockState::fromNbt).toList();
+        }
+    }
+
+}
