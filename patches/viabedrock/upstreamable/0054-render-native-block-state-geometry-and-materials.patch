+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+
+/** Material lighting retained on each authored face, independently of texture and culling identity. */
+public record CustomBlockLighting(float ambientOcclusion, boolean faceDimming) {
+
+    public static final String KEY = "viabedrock_lighting";
+
+    public CustomBlockLighting {
+        if (!Float.isFinite(ambientOcclusion) || ambientOcclusion < 0F || ambientOcclusion > 10F) {
+            throw new IllegalArgumentException("Invalid material ambient occlusion exponent");
+        }
+    }
+
+    public JsonObject json() {
+        final JsonObject json = new JsonObject();
+        json.addProperty("ambient_occlusion", this.ambientOcclusion);
+        json.addProperty("face_dimming", this.faceDimming);
+        return json;
+    }
+
+    public static CustomBlockLighting fromJson(final JsonObject json) {
+        if (!json.has("ambient_occlusion") || !json.has("face_dimming")
+                || !json.get("ambient_occlusion").isJsonPrimitive() || !json.getAsJsonPrimitive("ambient_occlusion").isNumber()
+                || !json.get("face_dimming").isJsonPrimitive() || !json.getAsJsonPrimitive("face_dimming").isBoolean()) {
+            throw new IllegalArgumentException("Invalid material lighting fields");
+        }
+        return new CustomBlockLighting(json.get("ambient_occlusion").getAsFloat(), json.get("face_dimming").getAsBoolean());
+    }
+
+    /** Combine native corner samples in Java's packed smooth-light representation without averaging or zero replacement. */
+    public static int maximumLight(final int first, final int second, final int third, final int fourth) {
+        final int block = Math.max(Math.max(first & 0xFF, second & 0xFF), Math.max(third & 0xFF, fourth & 0xFF));
+        final int sky = Math.max(Math.max((first >>> 16) & 0xFF, (second >>> 16) & 0xFF), Math.max((third >>> 16) & 0xFF, (fourth >>> 16) & 0xFF));
+        return block | (sky << 16);
+    }
+
+    /** Interpolate shaded corners along the inner axis first, preserving native float operation order. */
+    public static float interpolate(final float lowerLower, final float upperLower,
+                                    final float lowerUpper, final float upperUpper,
+                                    final float inner, final float outer) {
+        final float inverseInner = 1F - inner;
+        final float lower = lowerLower * inverseInner + upperLower * inner;
+        final float upper = lowerUpper * inverseInner + upperUpper * inner;
+        return lower * (1F - outer) + upper * outer;
+    }
+
+    /** Native terrain applies the exponent after corner averaging and directional attenuation, before tint and world light. */
+    public float shade(final float ambient, final float directional) {
+        return (float) Math.pow(ambient * (this.faceDimming ? directional : 1F), this.ambientOcclusion);
+    }
+
+}
