diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/MovingBlockBlockEntityRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/MovingBlockBlockEntityRewriter.java
