+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class MovingBlockBlockEntityRewriterTest {
+
+    @Test
+    void carriesTheNativeMovingBlockAndPistonProgressIntoJava() {
+        final CompoundTag moving = new CompoundTag();
+        moving.putByte("expanding", (byte) 1);
+        final CompoundTag piston = new CompoundTag();
+        piston.putFloat("Progress", 0.5f);
+        final BlockState base = BlockState.fromString("minecraft:sticky_piston[extended=false,facing=east]");
+        final BlockState carried = BlockState.fromString("minecraft:oak_stairs[facing=west,half=bottom,shape=straight,waterlogged=false]");
+
+        final CompoundTag javaData = MovingBlockBlockEntityRewriter.javaData(moving, carried, base, piston);
+        assertEquals("minecraft:oak_stairs", javaData.getCompoundTag("blockState").getString("Name"));
+        assertEquals("west", javaData.getCompoundTag("blockState").getCompoundTag("Properties").getString("facing"));
+        assertEquals(5, javaData.getInt("facing"));
+        assertEquals(0.5f, javaData.getFloat("progress"));
+        assertEquals((byte) 1, javaData.getByte("extending"));
+        assertEquals("sticky", MovingBlockBlockEntityRewriter.movingPistonState(base).properties().get("type"));
+        assertEquals("east", MovingBlockBlockEntityRewriter.movingPistonState(base).properties().get("facing"));
+    }
+
+    @Test
+    void reversesNativeProgressWhenStickyPistonRetracts() {
+        final CompoundTag moving = new CompoundTag();
+        moving.putByte("expanding", (byte) 0);
+        final CompoundTag piston = new CompoundTag();
+        final BlockState base = BlockState.fromString("minecraft:sticky_piston[extended=false,facing=east]");
+
+        piston.putFloat("Progress", 1f);
+        assertEquals(0f, MovingBlockBlockEntityRewriter.javaData(moving, BlockState.fromString("minecraft:stone"), base, piston).getFloat("progress"));
+
+        piston.putFloat("Progress", 0f);
+        assertEquals(1f, MovingBlockBlockEntityRewriter.javaData(moving, BlockState.fromString("minecraft:stone"), base, piston).getFloat("progress"));
+    }
+
+}
