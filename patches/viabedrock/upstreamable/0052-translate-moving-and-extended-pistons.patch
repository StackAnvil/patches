+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntityImpl;
+import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.chunk.BlockEntityWithBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.Direction;
+import net.raphimc.viabedrock.protocol.rewriter.BlockEntityRewriter;
+import net.raphimc.viabedrock.protocol.rewriter.BlockStateRewriter;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+import java.util.Locale;
+import java.util.Map;
+
+public class MovingBlockBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
+
+    @Override
+    public BlockEntity toJava(final UserConnection user, final BedrockBlockEntity bedrockBlockEntity) {
+        final CompoundTag bedrockTag = bedrockBlockEntity.tag();
+        final CompoundTag movingBlock = bedrockTag.getCompoundTag("movingBlock");
+        final BlockPosition pistonPosition = pistonPosition(bedrockTag);
+        if (movingBlock == null || pistonPosition == null) {
+            return null;
+        }
+
+        final ChunkTracker chunkTracker = user.get(ChunkTracker.class);
+        final int pistonId = chunkTracker.getJavaBlockState(pistonPosition);
+        final BlockState pistonState = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(pistonId);
+        if (pistonState == null || !pistonState.properties().containsKey("facing")) {
+            return null;
+        }
+
+        final BlockStateRewriter blockStateRewriter = user.get(BlockStateRewriter.class);
+        final int movedBedrockId = blockStateRewriter.bedrockId(movingBlock);
+        int movedJavaId = blockStateRewriter.javaId(movedBedrockId);
+        if (movedJavaId == -1) {
+            return null;
+        }
+        final CompoundTag extra = bedrockTag.getCompoundTag("movingBlockExtra");
+        if (extra != null && "minecraft:water".equals(extra.getString("name"))) {
+            final int waterloggedId = blockStateRewriter.waterlog(movedJavaId);
+            if (waterloggedId != -1) {
+                movedJavaId = waterloggedId;
+            }
+        }
+        final BlockState javaMovedState = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(movedJavaId);
+        if (javaMovedState == null) {
+            return null;
+        }
+
+        final BedrockBlockEntity pistonEntity = chunkTracker.getBlockEntity(pistonPosition);
+        final CompoundTag javaTag = javaData(bedrockTag, javaMovedState, pistonState, pistonEntity != null ? pistonEntity.tag() : null);
+        final BlockState javaMovingState = movingPistonState(pistonState);
+        final Integer movingId = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(javaMovingState);
+        if (movingId == null) {
+            return null;
+        }
+        final BlockEntity javaBlockEntity = new BlockEntityImpl(bedrockBlockEntity.packedXZ(), bedrockBlockEntity.y(), -1, javaTag);
+        return new BlockEntityWithBlockState(javaBlockEntity, movingId);
+    }
+
+    static BlockPosition pistonPosition(final CompoundTag tag) {
+        if (tag.get("pistonPosX") instanceof NumberTag x && tag.get("pistonPosY") instanceof NumberTag y
+                && tag.get("pistonPosZ") instanceof NumberTag z) {
+            return new BlockPosition(x.asInt(), y.asInt(), z.asInt());
+        }
+        return null;
+    }
+
+    static BlockState movingPistonState(final BlockState pistonState) {
+        final String type = "sticky_piston".equals(pistonState.identifier()) ? "sticky" : "normal";
+        return new BlockState("moving_piston", Map.of("facing", pistonState.properties().get("facing"), "type", type));
+    }
+
+    static CompoundTag javaData(final CompoundTag movingTag, final BlockState movedState, final BlockState pistonState,
+                                final CompoundTag pistonTag) {
+        final CompoundTag javaState = new CompoundTag();
+        javaState.putString("Name", movedState.namespacedIdentifier());
+        if (!movedState.properties().isEmpty()) {
+            final CompoundTag properties = new CompoundTag();
+            for (Map.Entry<String, String> property : movedState.properties().entrySet()) {
+                properties.putString(property.getKey(), property.getValue());
+            }
+            javaState.put("Properties", properties);
+        }
+
+        final CompoundTag javaTag = new CompoundTag();
+        javaTag.put("blockState", javaState);
+        javaTag.putInt("facing", Direction.valueOf(pistonState.properties().get("facing").toUpperCase(Locale.ROOT)).verticalId());
+        final boolean extending = movingTag.get("expanding") instanceof NumberTag expanding && expanding.asInt() != 0;
+        javaTag.putFloat("progress", javaProgress(extending, pistonTag));
+        javaTag.putByte("extending", (byte) (extending ? 1 : 0));
+        javaTag.putByte("source", (byte) 0);
+        return javaTag;
+    }
+
+    static float javaProgress(final boolean extending, final CompoundTag pistonTag) {
+        // MovingBlock can arrive before the new PistonArm tag. Do not reuse the
+        // completed progress of the previous motion in the opposite direction.
+        if (pistonTag == null || !(pistonTag.get("State") instanceof NumberTag state)
+                || extending != (state.asInt() == 1 || state.asInt() == 2)
+                || !(pistonTag.get("Progress") instanceof NumberTag progress)) {
+            return 0f;
+        }
+        final float value = extending ? progress.asFloat() : 1f - progress.asFloat();
+        return Float.isFinite(value) ? Math.max(0f, Math.min(1f, value)) : 0f;
+    }
+
+}
