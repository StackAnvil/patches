+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.BlockState;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class PistonBlockEntityRewriterTest {
+
+    private static final BlockState RETRACTED = BlockState.fromString("minecraft:sticky_piston[extended=false,facing=west]");
+
+    @Test
+    void usesNativePistonArmStatesWithoutChangingDirectionOrStickyType() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putByte("State", (byte) 2);
+        assertEquals(RETRACTED.withProperty("extended", "true"), PistonBlockEntityRewriter.javaBlockState(RETRACTED, tag));
+
+        tag.putByte("State", (byte) 1);
+        assertEquals(RETRACTED.withProperty("extended", "true"), PistonBlockEntityRewriter.javaBlockState(RETRACTED, tag));
+
+        tag.putByte("State", (byte) 3);
+        assertEquals(RETRACTED, PistonBlockEntityRewriter.javaBlockState(RETRACTED, tag));
+
+        tag.putByte("State", (byte) 0);
+        assertEquals(RETRACTED, PistonBlockEntityRewriter.javaBlockState(RETRACTED, tag));
+    }
+
+    @Test
+    void animatesTheHeadOnExtensionAndTheBaseOnRetraction() {
+        final BlockPosition position = new BlockPosition(16, 64, 0);
+        final CompoundTag tag = new CompoundTag();
+        tag.putByte("State", (byte) 1);
+        tag.putFloat("Progress", 0.5f);
+        final var extension = PistonBlockEntityRewriter.animation(position, RETRACTED, tag);
+        assertEquals(new BlockPosition(15, 64, 0), extension.position());
