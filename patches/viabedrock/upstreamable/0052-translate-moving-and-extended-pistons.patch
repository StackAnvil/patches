+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
+import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntityImpl;
+import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.chunk.BlockEntityWithBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.Direction;
+import net.raphimc.viabedrock.protocol.data.generated.bedrock.CustomBlockTags;
+import net.raphimc.viabedrock.protocol.rewriter.BlockEntityRewriter;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+import java.util.Locale;
+import java.util.Map;
+
+public class PistonBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
+
+    @Override
+    public BlockEntity toJava(final UserConnection user, final BedrockBlockEntity bedrockBlockEntity) {
+        final int currentId = user.get(ChunkTracker.class).getJavaBlockState(bedrockBlockEntity.position());
+        final BlockState currentState = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(currentId);
+        final BlockState pistonState = javaBlockState(currentState, bedrockBlockEntity.tag());
+        final int pistonId = BedrockProtocol.MAPPINGS.getJavaBlockStates().getOrDefault(pistonState, currentId);
+        return new BlockEntityWithBlockState(bedrockBlockEntity.packedXZ(), bedrockBlockEntity.y(), pistonId);
+    }
+
+    public static void sendAnimationUpdates(final UserConnection user, final BedrockBlockEntity piston) {
+        if (!"PistonArm".equals(piston.tag().getString("id"))
+                || !(piston.tag().get("State") instanceof NumberTag stateTag)) {
+            return;
+        }
+        final int state = stateTag.asInt();
+        if (state < 0 || state > 3) {
+            return;
+        }
+        final ChunkTracker tracker = user.get(ChunkTracker.class);
+        final int baseId = tracker.getJavaBlockState(piston.position());
+        final BlockState base = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(baseId);
+        if (base == null || !(base.identifier().equals("piston") || base.identifier().equals("sticky_piston"))) {
+            return;
+        }
+        final Animation animation = animation(piston.position(), base, piston.tag());
+        if (animation != null) {
+            final int movingId = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(MovingBlockBlockEntityRewriter.movingPistonState(base));
+            PacketFactory.sendJavaBlockUpdate(user, animation.position(), movingId);
+            PacketFactory.sendJavaBlockEntityData(user, animation.position(), new BlockEntityImpl(
+                    BlockEntity.pack(animation.position().x(), animation.position().z()), (short) animation.position().y(),
+                    BedrockProtocol.MAPPINGS.getJavaBlockEntities().get(CustomBlockTags.PISTON), animation.data()));
+        }
+        // Geyser sends carried blocks before the arm's new progress. Refresh
+        // only those belonging to this piston, including chunk-boundary pushes.
+        final MovingBlockBlockEntityRewriter rewriter = new MovingBlockBlockEntityRewriter();
+        for (int x = (piston.position().x() - 12) >> 4; x <= (piston.position().x() + 12) >> 4; x++) {
+            for (int z = (piston.position().z() - 12) >> 4; z <= (piston.position().z() + 12) >> 4; z++) {
+                final var chunk = tracker.getChunk(x, z);
+                if (chunk == null) {
+                    continue;
+                }
+                for (final BlockEntity entity : chunk.blockEntities()) {
+                    if (!(entity instanceof BedrockBlockEntity moving)
+                            || !piston.position().equals(MovingBlockBlockEntityRewriter.pistonPosition(moving.tag()))) {
+                        continue;
+                    }
+                    final BlockEntity translated = rewriter.toJava(user, moving);
+                    if (translated != null && translated.tag() != null) {
+                        PacketFactory.sendJavaBlockEntityData(user, moving.position(), translated.withTypeId(
+                                BedrockProtocol.MAPPINGS.getJavaBlockEntities().get(CustomBlockTags.PISTON)));
+                    }
+                }
+            }
+        }
+    }
+
+    static Animation animation(final BlockPosition basePosition, final BlockState base, final CompoundTag pistonTag) {
+        if (!(pistonTag.get("State") instanceof NumberTag stateTag)) {
+            return null;
+        }
+        final int state = stateTag.asInt();
+        if (state != 1 && state != 3) {
+            return null;
+        }
+        final boolean extending = state == 1;
+        final Direction direction = Direction.valueOf(base.properties().get("facing").toUpperCase(Locale.ROOT));
+        final BlockPosition position = extending ? basePosition.getRelative(direction.blockFace()) : basePosition;
+        final BlockState carried = extending
+                ? new BlockState("piston_head", Map.of("facing", base.properties().get("facing"),
+                        "type", base.identifier().equals("sticky_piston") ? "sticky" : "normal", "short", "false"))
+                : base.withProperty("extended", "false");
+        final CompoundTag moving = new CompoundTag();
+        moving.putByte("expanding", (byte) (extending ? 1 : 0));
+        final CompoundTag data = MovingBlockBlockEntityRewriter.javaData(moving, carried, base, pistonTag);
+        data.putByte("source", (byte) 1);
+        return new Animation(position, data);
+    }
+
+    static BlockState javaBlockState(final BlockState currentState, final CompoundTag bedrockTag) {
+        if (currentState != null && currentState.properties().containsKey("extended")
+                && bedrockTag.get("State") instanceof NumberTag stateTag) {
+            final int state = stateTag.asInt();
+            if (state >= 0 && state <= 3) {
+                return currentState.withProperty("extended", Boolean.toString(state == 1 || state == 2));
+            }
+        }
+        return currentState;
+    }
+
+    record Animation(BlockPosition position, CompoundTag data) { }
+
+}
