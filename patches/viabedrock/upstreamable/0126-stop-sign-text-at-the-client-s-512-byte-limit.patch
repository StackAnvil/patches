         assertEquals(Set.of("#003CFF"), colors(messages.get(1)));
     }
 
+    @Test
+    void signTextStopsAtTheClientsFiveHundredTwelveByteLimit() {
+        // Each "§a" code is three UTF-8 bytes, so 170 codes leave room for "ab". A cut two-byte character is dropped.
+        final ListTag<?> messages = frontMessages("§a".repeat(170) + "abc\nnext", BLACK);
+        assertEquals("ab", text(messages.get(0)));
+        assertEquals("", text(messages.get(1)));
+        assertEquals("a", text(frontMessages("§a".repeat(170) + "aé", BLACK).get(0)));
+    }
+
     private static ListTag<?> frontMessages(final String text, final int color) {
         final CompoundTag front = new CompoundTag();
         front.putString("Text", text);
@@ -47,6 +56,25 @@ class SignBlockEntityRewriterTest {
         return java.tag().getCompoundTag("front_text").getListTag("messages");
     }
 
+    private static String text(final Tag tag) {
+        final StringBuilder text = new StringBuilder();
+        collectText(tag, text);
+        return text.toString();
+    }
+
+    private static void collectText(final Tag tag, final StringBuilder text) {
+        if (tag instanceof CompoundTag compound) {
+            text.append(compound.getString("text", ""));
+            if (compound.get("extra") instanceof ListTag<?> extra) {
+                extra.forEach(child -> collectText(child, text));
+            }
+        } else if (tag instanceof ListTag<?> list) {
+            list.forEach(child -> collectText(child, text));
+        } else if (tag instanceof StringTag string) {
+            text.append(string.getValue());
+        }
+    }
+
     private static Set<String> colors(final Tag tag) {
         final Set<String> colors = new HashSet<>();
         collect(tag, colors);
