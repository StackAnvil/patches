From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:02:55 +0100
Subject: [PATCH] fix(signs): stop sign text at the client's 512-byte limit
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Bedrock client lays out at most the first 512 bytes of a sign
face's text. Text after that limit never appears on a Bedrock sign, but
ViaBedrock translated all of it. A sign whose text starts with many
formatting codes therefore showed words that Bedrock players never see.

Native 1.26.60.5 evidence: the sign text renderer at 0x146a7f670
copies texts longer than 0x200 bytes into a new 0x200-byte buffer
before it wraps them into rows. Formatting codes count toward the
limit, and each "§x" code is three UTF-8 bytes. ViaBedrock now keeps
the whole characters within the first 512 UTF-8 bytes. The native
client cuts the raw bytes, so a character split at the limit is
dropped here instead of becoming an invalid sequence.

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/SignBlockEntityRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/SignBlockEntityRewriter.java
index da6150db6eee07c36f2d4ebedadd2d7942dd094d..e3fc3a10e29029f91f2f20c027c702ea081daad6 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/SignBlockEntityRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/SignBlockEntityRewriter.java
@@ -34,6 +34,8 @@ import java.util.List;
 public class SignBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
 
     private static final String[] TEXT_CONTAINER_KEYS = {"FrontText", "BackText"};
+    // The Bedrock client lays out at most the first 512 UTF-8 bytes of a sign face's text.
+    private static final int MAX_TEXT_BYTES = 512;
 
     public static void upgradeData(final CompoundTag data) {
         if (data.get("Text1") instanceof StringTag) {
@@ -138,7 +140,7 @@ public class SignBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
     private CompoundTag translateText(final CompoundTag bedrockText) {
         final CompoundTag javaText = new CompoundTag();
 
-        final String text = bedrockText.getString("Text", "");
+        final String text = truncateUtf8(bedrockText.getString("Text", ""), MAX_TEXT_BYTES);
         final List<TextComponent> components = new ArrayList<>();
         if (bedrockText.get("PersistFormatting") instanceof ByteTag persistFormatting && persistFormatting.asByte() != 0) {
             for (String line : BedrockTextUtils.split(text, "\n")) {
@@ -182,4 +184,18 @@ public class SignBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
         return javaText;
     }
 
+    /** Keeps the whole characters within the byte limit. The native client cuts the raw bytes instead. */
+    private static String truncateUtf8(final String text, final int maxBytes) {
+        int bytes = 0;
+        for (int i = 0; i < text.length(); ) {
+            final int codePoint = text.codePointAt(i);
+            bytes += codePoint < 0x80 ? 1 : codePoint < 0x800 ? 2 : codePoint < 0x10000 ? 3 : 4;
+            if (bytes > maxBytes) {
+                return text.substring(0, i);
+            }
+            i += Character.charCount(codePoint);
+        }
+        return text;
+    }
+
 }
