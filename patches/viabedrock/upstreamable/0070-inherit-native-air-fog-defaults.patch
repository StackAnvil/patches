From 80bc8093972350112c4e90b6a1319b7b86086487 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:36 +0200
Subject: [PATCH] fix(biomes): inherit native air fog defaults

Use an explicit biome air color first, then the resource pack's resolved
data-default binding, then native #ABD2FF when both are absent. The
synthetic the_void biome uses the same default. Preserve black colors and
keep registry air fog independent from water fog.

The default binding comes from biomes_client.json, not the conventional
minecraft:fog_default asset name. Native Bedrock 1.26.60.5 controls use a
custom green default beneath a replacement water-only End binding. The
result is green air at the default's 24-block distance. Inherited biome
air takes priority; clearing the binding exposes modern biome resources.

Bedrock 1.26.51.1 vanilla archives supply #ABD2FF in default_fog_setting.
The fallback remains for absent data, without inventing a pack binding.
Focused tests cover explicit colors, inherited defaults, missing media,
and the last-resort color. Complete native sky shading remains separate.
---
 .../protocol/data/JavaRegistries.java         | 24 ++++++----
 .../protocol/data/JavaRegistriesFogTest.java  | 46 +++++++++++++++++++
 2 files changed, 61 insertions(+), 9 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/data/JavaRegistriesFogTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/data/JavaRegistries.java b/src/main/java/net/raphimc/viabedrock/protocol/data/JavaRegistries.java
index a27810af..a948f481 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/data/JavaRegistries.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/data/JavaRegistries.java
@@ -40,7 +40,7 @@ import java.util.logging.Level;
 public final class JavaRegistries {
 
     private static final int BEDROCK_DEFAULT_WATER_COLOR = 4501493;
-    private static final int JAVA_DEFAULT_FOG_COLOR = 12638463;
+    private static final int BEDROCK_DEFAULT_AIR_FOG_COLOR = 0xABD2FF;
 
     public static CompoundTag createJavaRegistries(final GameSessionStorage gameSession, final ResourcePackStorage resourcePackStorage) {
         final CompoundTag registries = BedrockProtocol.MAPPINGS.getJavaRegistries().copy();
@@ -85,7 +85,8 @@ public final class JavaRegistries {
 
     private static CompoundTag buildJavaBiomeRegistry(final CompoundTag biomeDefinitions, final ResourcePackStorage resourcePackStorage) {
         final CompoundTag javaBiomes = new CompoundTag();
-        javaBiomes.put("minecraft:the_void", getTheVoidBiome());
+        final FogDefinitions.FogDefinition defaultFogDefinition = resourcePackStorage.getFogs().resolve(resourcePackStorage.getBiomes().defaultFog());
+        javaBiomes.put("minecraft:the_void", getTheVoidBiome(getAirFogColor(null, defaultFogDefinition)));
 
         final Map<String, Object> foliageColor = BedrockProtocol.MAPPINGS.getBedrockToJavaBiomeExtraData().get("foliage_color");
         final Map<String, Object> grassColor = BedrockProtocol.MAPPINGS.getBedrockToJavaBiomeExtraData().get("grass_color");
@@ -140,11 +141,7 @@ public final class JavaRegistries {
             } else {
                 attributes.putInt("minecraft:visual/sky_color", getSkyColor(bedrockBiome.getDoubleTag("temperature").asFloat()));
             }
-            if (bedrockFogDefinition != null && bedrockFogDefinition.colors().containsKey("air")) {
-                attributes.putInt("minecraft:visual/fog_color", bedrockFogDefinition.colors().get("air"));
-            } else {
-                attributes.putInt("minecraft:visual/fog_color", JAVA_DEFAULT_FOG_COLOR);
-            }
+            attributes.putInt("minecraft:visual/fog_color", getAirFogColor(bedrockFogDefinition, defaultFogDefinition));
             if (bedrockFogDefinition != null && bedrockFogDefinition.colors().containsKey("water")) {
                 attributes.putInt("minecraft:visual/water_fog_color", bedrockFogDefinition.colors().get("water"));
             } else {
@@ -180,7 +177,16 @@ public final class JavaRegistries {
         return javaBiomes;
     }
 
-    private static CompoundTag getTheVoidBiome() {
+    static int getAirFogColor(final FogDefinitions.FogDefinition biomeFogDefinition, final FogDefinitions.FogDefinition defaultFogDefinition) {
+        final Integer biomeColor = biomeFogDefinition != null ? biomeFogDefinition.colors().get("air") : null;
+        if (biomeColor != null) {
+            return biomeColor;
+        }
+        final Integer defaultColor = defaultFogDefinition != null ? defaultFogDefinition.colors().get("air") : null;
+        return defaultColor != null ? defaultColor : BEDROCK_DEFAULT_AIR_FOG_COLOR;
+    }
+
+    private static CompoundTag getTheVoidBiome(final int airFogColor) {
         final CompoundTag biome = new CompoundTag();
         biome.putFloat("temperature", 0.5F);
         biome.putFloat("downfall", 0.5F);
@@ -192,7 +198,7 @@ public final class JavaRegistries {
         biome.put("attributes", attributes);
         attributes.putInt("minecraft:visual/sky_color", getSkyColor(0.5F));
         attributes.putInt("minecraft:visual/water_fog_color", BEDROCK_DEFAULT_WATER_COLOR);
-        attributes.putInt("minecraft:visual/fog_color", JAVA_DEFAULT_FOG_COLOR);
+        attributes.putInt("minecraft:visual/fog_color", airFogColor);
         effects.putInt("water_color", BEDROCK_DEFAULT_WATER_COLOR);
         return biome;
     }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/data/JavaRegistriesFogTest.java b/src/test/java/net/raphimc/viabedrock/protocol/data/JavaRegistriesFogTest.java
