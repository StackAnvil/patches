+package net.raphimc.viabedrock.protocol.data;
+
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.definition.FogDefinitions.FogDefinition;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class JavaRegistriesFogTest {
+
+    @Test
+    void explicitBiomeAirOverridesPackDefaultIncludingBlack() {
+        final var packDefault = new FogDefinition("minecraft:fog_default", Map.of("air", 0x112233));
+        assertEquals(0, JavaRegistries.getAirFogColor(new FogDefinition("biome", Map.of("air", 0)), packDefault));
+        assertEquals(0x987654, JavaRegistries.getAirFogColor(new FogDefinition("biome", Map.of("air", 0x987654)), packDefault));
+    }
+
+    @Test
+    void missingBiomeAirInheritsEffectivePackDefaultBeforeNativeFallback() {
+        final var waterOnly = new FogDefinition("biome", Map.of("water", 0x556677));
+        final var packDefault = new FogDefinition("minecraft:fog_default", Map.of("air", 0x123456));
+        assertEquals(0x123456, JavaRegistries.getAirFogColor(waterOnly, packDefault));
+        assertEquals(0x123456, JavaRegistries.getAirFogColor(null, packDefault));
+        assertEquals(0xABD2FF, JavaRegistries.getAirFogColor(waterOnly, null));
+        assertEquals(0xABD2FF, JavaRegistries.getAirFogColor(waterOnly, new FogDefinition("minecraft:fog_default", Map.of("water", 0x778899))));
+        assertEquals(0xABD2FF, JavaRegistries.getAirFogColor(null, null));
+    }
+
+}
