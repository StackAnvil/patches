From d89758c74f606de91dc92edc3eaa8793792ea8c7 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 2 Oct 2026 02:50:21 +0200
Subject: [PATCH] feat(resource-packs): advertise native rendering context

A Java client connecting through ViaProxy has no local Bedrock protocol
connection from which to select its native lightmap and camera effects.
Expose a versioned appearance marker in the converted server resource pack
so client integrations can opt into supported native rendering after the
user accepts the pack. Include the target network protocol and schema
version; this metadata does not carry identities or authentication state.

Invalidate older converted caches so accepted packs consistently include
the marker. The client must scope this appearance context to the accepted
server pack lifecycle and retain ordinary Java rendering otherwise.
---
 .../api/resourcepack/http/ConvertedResourcePackCache.java     | 2 +-
 .../viabedrock/protocol/rewriter/ResourcePackRewriter.java    | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/http/ConvertedResourcePackCache.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/http/ConvertedResourcePackCache.java
index 7fd5bffc4..3fae3c921 100644
--- a/src/main/java/net/raphimc/viabedrock/api/resourcepack/http/ConvertedResourcePackCache.java
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/http/ConvertedResourcePackCache.java
@@ -52,7 +52,7 @@ import java.util.logging.Level;
 
 public class ConvertedResourcePackCache {
 
-    private static final String CONVERSION_VERSION = "resolved-model-textures-and-appearance-6";
+    private static final String CONVERSION_VERSION = "native-appearance-rendering-metadata-7";
     // Advance when the set or format of emitted resources changes independently of converter profiles.
     private static final int RESOURCE_FORMAT_VERSION = 2;
 
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ResourcePackRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ResourcePackRewriter.java
index ffe1dc1b8..0305980b9 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ResourcePackRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ResourcePackRewriter.java
@@ -71,6 +71,10 @@ public final class ResourcePackRewriter {
             javaContent.putAll(task.getNow(null));
         }
         javaContent.putJson("pack.mcmeta", createPackManifest());
+        final JsonObject rendering = new JsonObject();
+        rendering.addProperty("format", 1);
+        rendering.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        javaContent.putJson("assets/viabedrock/client_rendering.json", rendering);
         return javaContent;
     }
 
