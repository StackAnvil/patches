+package net.raphimc.viabedrock.protocol.packet;
+
+import com.vdurmont.semver4j.Semver;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.minecraft.chunks.PaletteType;
+import com.viaversion.viaversion.api.protocol.remapper.PacketHandler;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.chunk.BedrockChunk;
+import net.raphimc.viabedrock.api.chunk.datapalette.BedrockDataPalette;
+import net.raphimc.viabedrock.api.chunk.section.BedrockChunkSection;
+import net.raphimc.viabedrock.api.chunk.section.BedrockChunkSectionImpl;
+import net.raphimc.viabedrock.platform.ViaBedrockPlatform;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import net.raphimc.viabedrock.protocol.storage.BlobCache;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.mockito.ArgumentCaptor;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.logging.Logger;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class LevelChunkBiomePacketTest {
+
+    @ParameterizedTest
+    @CsvSource({"0, false", "0, true", "1, false", "1, true", "9, false", "9, true"})
+    void readsDimensionBiomesBeforeBlockEntities(final int sectionCount, final boolean cached) throws Exception {
+        decodesBlockEntityAfterTail(sectionCount, cached, 0, 0);
+    }
+
+    // Protocol 2225 servers send counts of 1 and 16; 200 covers the unsigned byte range.
+    @ParameterizedTest
+    @CsvSource({"1, false, 1, 1", "9, true, 16, 16", "1, false, 200, 200", "0, true, 16, 3"})
+    void skipsCountedBorderColumnsBeforeBlockEntities(final int sectionCount, final boolean cached, final int borderCount,
+                                                      final int coordinateBytes) throws Exception {
+        decodesBlockEntityAfterTail(sectionCount, cached, borderCount, coordinateBytes);
+    }
+
+    /** A truncated border list ends the column like other short payloads, without a block entity or warning. */
+    private static void decodesBlockEntityAfterTail(final int sectionCount, final boolean cached, final int borderCount,
+                                                    final int coordinateBytes) throws Exception {
+        final boolean truncated = coordinateBytes < borderCount;
+        final var protocol = mock(BedrockProtocol.class);
+        WorldPackets.register(protocol);
+        final var handler = ArgumentCaptor.forClass(PacketHandler.class);
+        verify(protocol).registerClientbound(eq(ClientboundBedrockPackets.LEVEL_CHUNK), isNull(), handler.capture());
+        final var user = mock(UserConnection.class);
+        final var tracker = mock(ChunkTracker.class);
+        final var session = mock(GameSessionStorage.class);
+        final var cache = mock(BlobCache.class);
+        final var logger = mock(Logger.class);
+        final var platform = mock(ViaBedrockPlatform.class);
+        when(platform.getLogger()).thenReturn(logger);
+        when(user.get(ChunkTracker.class)).thenReturn(tracker);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        when(user.get(BlobCache.class)).thenReturn(cache);
+        when(session.getBedrockVanillaVersion()).thenReturn(new Semver("1.26.51"));
+        when(tracker.getDimension()).thenReturn(Dimension.OVERWORLD);
+        when(tracker.getMinY()).thenReturn(-64);
+        when(tracker.getMaxY()).thenReturn(320);
+        when(tracker.handleBlockPalette(any())).thenAnswer(call -> call.getArgument(0));
+        final var sections = new BedrockChunkSection[24];
+        for (int i = 0; i < sections.length; i++) {
+            sections[i] = new BedrockChunkSectionImpl(i >= sectionCount);
+        }
+        final var chunk = new BedrockChunk(0, 0, sections);
+        when(tracker.getChunk(0, 0)).thenReturn(null, chunk);
+        when(tracker.createChunk(0, 0, sectionCount == 0 ? 24 : sectionCount)).thenReturn(chunk);
+        final ByteBuf blob = Unpooled.buffer();
+        final ByteBuf tail = Unpooled.buffer();
+        final ByteBuf packet = Unpooled.buffer();
+        try (var via = mockStatic(ViaBedrock.class)) {
+            via.when(ViaBedrock::getPlatform).thenReturn(platform);
+            for (int i = 0; i < sectionCount; i++) {
+                blob.writeByte(9).writeByte(0).writeByte(i - 4);
+            }
+            for (int i = 0; i < sections.length; i++) {
+                // Singleton palettes alternate with native "previous palette" markers.
+                blob.writeByte(i % 2 == 0 ? 1 : 255);
+                if (i % 2 == 0) {
+                    BedrockTypes.VAR_INT.writePrimitive(blob, 40 + i);
+                }
+            }
+            tail.writeByte(borderCount); // border block columns
+            for (int i = 0; i < coordinateBytes; i++) {
+                tail.writeByte(i == 0 ? 10 : i * 17); // packed Z/X; 10 is also the compound tag ID
+            }
+            final var tag = new CompoundTag();
+            tag.putString("id", "Chest");
+            tag.putInt("x", 3);
+            tag.putInt("y", 70);
+            tag.putInt("z", 5);
+            if (!truncated) {
+                BedrockTypes.NETWORK_TAG.write(tail, tag);
+            }
+            BedrockTypes.VAR_INT.writePrimitive(packet, 0);
+            BedrockTypes.VAR_INT.writePrimitive(packet, 0);
+            BedrockTypes.VAR_INT.writePrimitive(packet, Dimension.OVERWORLD.ordinal());
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(packet, sectionCount);
+            Types.BOOLEAN.write(packet, sectionCount == 0);
+            if (sectionCount == 0) {
+                BedrockTypes.VAR_INT.writePrimitive(packet, -1);
+            }
+            Types.BOOLEAN.write(packet, cached);
+            final Long[] hashes = cached ? new Long[sectionCount + 1] : new Long[0];
+            for (int i = 0; i < hashes.length; i++) {
+                hashes[i] = (long) i;
+            }
+            BedrockTypes.LONG_ARRAY.write(packet, hashes);
+            final byte[] blobBytes = new byte[blob.readableBytes()];
+            blob.readBytes(blobBytes);
+            when(cache.getBlob(hashes)).thenReturn(CompletableFuture.completedFuture(blobBytes));
+            final ByteBuf data = Unpooled.buffer();
+            try {
+                if (!cached) {
+                    data.writeBytes(blobBytes);
+                }
+                data.writeBytes(tail);
+                final byte[] bytes = new byte[data.readableBytes()];
+                data.readBytes(bytes);
+                BedrockTypes.BYTE_ARRAY.write(packet, bytes);
+                Types.BOOLEAN.write(packet, false); // server biome data overrides client biome data
+            } finally {
+                data.release();
+            }
+            handler.getValue().handle(new PacketWrapperImpl(ClientboundBedrockPackets.LEVEL_CHUNK, packet, user));
+            assertFalse(packet.isReadable());
+            for (int i = 0; i < sections.length; i++) {
+                final var palette = sections[i].palette(PaletteType.BIOMES);
+                assertNotNull(palette, "Missing biome section " + i);
+                assertEquals(40 + i - i % 2, palette.idAt(0));
+                if (i % 2 != 0) {
+                    assertNotSame(sections[i - 1].palette(PaletteType.BIOMES), palette);
+                    ((BedrockDataPalette) palette).setIdByIndex(0, 99);
+                    assertEquals(40 + i - 1, sections[i - 1].palette(PaletteType.BIOMES).idAt(0));
+                }
+            }
+            if (truncated) {
+                assertTrue(chunk.blockEntities().isEmpty());
+            } else {
+                assertEquals(1, chunk.blockEntities().size());
+                assertEquals(tag, chunk.getBlockEntityAt(new BlockPosition(3, 70, 5)).tag());
+            }
+            verify(tracker).sendChunkInNextTick(0, 0);
+            verifyNoInteractions(logger);
+        } finally {
+            blob.release();
+            tail.release();
+            packet.release();
+        }
+    }
+
+}
