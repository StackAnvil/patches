+                            // Biomes cover the dimension height, independently of the block section count.
                             for (int i = 0; i < sections.length; i++) {
                                 BedrockDataPalette biomePalette = BedrockTypes.RUNTIME_DATA_PALETTE.read(dataBuf); // biome palette
                                 if (biomePalette == null) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/LevelChunkBiomePacketTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/LevelChunkBiomePacketTest.java
