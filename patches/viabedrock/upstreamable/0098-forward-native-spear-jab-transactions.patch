+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.fastutil.ints.Int2ObjectOpenHashMap;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.types.item.NetworkItemStackDescriptorType;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+class SpearJabTest {
+
+    @Test
+    void airAndEntityFacingJabsUseTheNativeAttackWireFields() throws Exception {
+        for (final float pitch : new float[]{0F, 12F}) {
+            final var itemType = new NetworkItemStackDescriptorType(0, new Int2ObjectOpenHashMap<>(), false);
+            final Position3f position = new Position3f(0.5F, 66.62001F, 0.5F);
+            final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundBedrockPackets.INVENTORY_TRANSACTION, null, null);
+            ClientPlayerPackets.writeSpearJabTransaction(wrapper, itemType, 7, new BedrockItem(858), position,
+                    new Position3f(pitch, 0F, 0F));
+            final ByteBuf buffer = Unpooled.buffer();
+            try {
+                wrapper.writeToBuffer(buffer);
+                assertEquals(30, Types.VAR_INT.read(buffer));
+                assertEquals(0, BedrockTypes.VAR_INT.read(buffer));
+                assertFalse(Types.BOOLEAN.read(buffer));
+                assertEquals(2, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+                assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+                assertEquals(3, BedrockTypes.VAR_INT.read(buffer));
+                assertEquals(0, buffer.readByte());
+                assertEquals(new BlockPosition(0, 0, 0), BedrockTypes.BLOCK_POSITION.read(buffer));
+                assertEquals(0, buffer.readByte());
+                assertEquals(7, BedrockTypes.VAR_INT.read(buffer));
+                assertEquals(0, buffer.readByte());
+                assertEquals(858, itemType.read(buffer).identifier());
+                assertEquals(position, BedrockTypes.POSITION_3F.read(buffer));
+                final Position3f direction = BedrockTypes.POSITION_3F.read(buffer).subtract(position);
+                assertEquals(0F, direction.x(), 1E-6F);
+                assertEquals(-(float) Math.sin(Math.toRadians(pitch)), direction.y(), 1E-5F);
+                assertEquals((float) Math.cos(Math.toRadians(pitch)), direction.z(), 1E-6F);
+                assertEquals(0, BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+                assertEquals(0, buffer.readByte());
+                assertEquals(0, buffer.readByte());
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void jabEndpointRotatesWithTheCamera() {
+        final var itemType = new NetworkItemStackDescriptorType(0, new Int2ObjectOpenHashMap<>(), false);
+        final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundBedrockPackets.INVENTORY_TRANSACTION, null, null);
+        final Position3f position = new Position3f(3F, 64F, 5F);
+        ClientPlayerPackets.writeSpearJabTransaction(wrapper, itemType, 0, new BedrockItem(858), position,
+                new Position3f(30F, 90F, 90F));
+        final Position3f endpoint = wrapper.get(BedrockTypes.POSITION_3F, 1);
+        assertEquals(position.x() - (float) Math.cos(Math.toRadians(30)), endpoint.x(), 1E-6F);
+        assertEquals(position.y() - 0.5F, endpoint.y(), 1E-6F);
+        assertEquals(position.z(), endpoint.z(), 1E-6F);
+    }
+
+}
