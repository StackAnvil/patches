From 4313426c87db49a5ea03dc40c17abc2906713381 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 9 Oct 2026 19:03:10 +0200
Subject: [PATCH] fix(interaction): forward native spear jab transactions

Java 26.3 sends PLAYER_ACTION STAB for spear attacks. Translate it to the target Bedrock 2193 ItemUse action Use_As_Attack (3), including the selected item and camera endpoint, and avoid a duplicate swing transaction.

A Bedrock 1.26.51.1 native capture confirms air and entity jabs use action 3. Lunge III produces a server SET_ACTOR_MOTION response within about 50 ms, so preserve server-authoritative impulse handling instead of inventing client physics. Numeric wire tests verify the captured field order and attack orientation.
---
 .../protocol/packet/ClientPlayerPackets.java  | 34 +++++++-
 .../protocol/packet/SpearJabTest.java         | 82 +++++++++++++++++++
 2 files changed, 115 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/SpearJabTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
index 867eae49f..a48b535fa 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
@@ -100,6 +100,28 @@ public final class ClientPlayerPackets {
         }
     }
 
+    static void writeSpearJabTransaction(final PacketWrapper wrapper, final Type<BedrockItem> itemType,
+                                        final int hotbarSlot, final BedrockItem held,
+                                        final Position3f position, final Position3f rotation) {
+        final Position3f direction = MathUtil.calculateCameraOrientation(rotation.y(), rotation.x());
+        wrapper.write(BedrockTypes.VAR_INT, 0); // legacy request id
+        wrapper.write(Types.BOOLEAN, false); // has legacy data
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, ComplexInventoryTransaction_Type.ItemUseTransaction.getValue());
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, 0); // actions count
+        wrapper.write(BedrockTypes.VAR_INT, ItemUseActionType.Use_As_Attack.getValue());
+        wrapper.write(Types.BYTE, (byte) ItemUseTriggerType.Unknown.getValue());
+        wrapper.write(BedrockTypes.BLOCK_POSITION, new BlockPosition(0, 0, 0));
+        wrapper.write(Types.BYTE, (byte) 0); // face
+        wrapper.write(BedrockTypes.VAR_INT, hotbarSlot);
+        wrapper.write(Types.BYTE, (byte) HandSlot.Mainhand.getValue());
+        wrapper.write(itemType, held);
+        wrapper.write(BedrockTypes.POSITION_3F, position);
+        wrapper.write(BedrockTypes.POSITION_3F, position.add(direction));
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, 0); // block runtime id
+        wrapper.write(Types.BYTE, (byte) ItemUsePredictedResult.Failure.getValue());
+        wrapper.write(Types.BYTE, (byte) ItemUseClientCooldownState.Off.getValue());
+    }
+
     static Entity predictedVehicle(final EntityTracker entityTracker, final ClientPlayerEntity clientPlayer) {
         final Entity vehicle = entityTracker.getEntityByRid(clientPlayer.mountEntityRuntimeId());
         if (vehicle == null || !(vehicle.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_BOAT)
@@ -419,7 +441,17 @@ public final class ClientPlayerPackets {
                     chunkTracker.handleBlockChange(position, 0, chunkTracker.bedrockAirId());
                     PacketFactory.sendJavaBlockUpdate(wrapper.user(), position, ProtocolConstants.JAVA_AIR_ID);
                 }
-                case SWAP_ITEM_WITH_OFFHAND, STAB -> {
+                case SWAP_ITEM_WITH_OFFHAND -> {
+                }
+                case STAB -> {
+                    final InventoryContainer inventory = wrapper.user().get(InventoryTracker.class).getInventoryContainer();
+                    final PacketWrapper jab = PacketWrapper.create(ServerboundBedrockPackets.INVENTORY_TRANSACTION, wrapper.user());
+                    writeSpearJabTransaction(jab, wrapper.user().get(ItemRewriter.class).newItemType(),
+                            Byte.toUnsignedInt(inventory.getSelectedHotbarSlot()),
+                            inventory.getSelectedHotbarItem(), clientPlayer.position(), clientPlayer.rotation());
+                    jab.sendToServer(BedrockProtocol.class);
+                    clientPlayer.sendSwingPacketToServer();
+                    clientPlayer.cancelNextSwingPacket();
                 }
                 default -> throw new IllegalStateException("Unhandled PlayerActionAction: " + action);
             }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/SpearJabTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/SpearJabTest.java
new file mode 100644
index 000000000..5cac6c5be
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/SpearJabTest.java
@@ -0,0 +1,82 @@
