+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public record HudVisibilityUpdate(List<Integer> elements, int visibility) {
+
+    public static final Type<HudVisibilityUpdate> TYPE = new Type<>(HudVisibilityUpdate.class) {
+        @Override
+        public HudVisibilityUpdate read(final ByteBuf buffer) {
+            final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > 4096) {
+                throw new IllegalArgumentException("Invalid HUD element count");
+            }
+            final List<Integer> elements = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                elements.add(BedrockTypes.VAR_INT.readPrimitive(buffer));
+            }
+            return new HudVisibilityUpdate(elements, BedrockTypes.VAR_INT.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final HudVisibilityUpdate value) {
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, value.elements.size());
+            for (final int element : value.elements) {
+                BedrockTypes.VAR_INT.writePrimitive(buffer, element);
+            }
+            BedrockTypes.VAR_INT.writePrimitive(buffer, value.visibility);
+        }
+    };
+
+    public HudVisibilityUpdate {
+        elements = List.copyOf(elements);
+        if (elements.size() > 4096) {
+            throw new IllegalArgumentException("Invalid HUD element count");
+        }
+    }
+
+}
