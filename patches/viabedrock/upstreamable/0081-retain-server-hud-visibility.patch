+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.type.Types;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudVisibility;
+import net.raphimc.viabedrock.protocol.model.HudVisibilityUpdate;
+import net.raphimc.viabedrock.protocol.storage.HudVisibilityStorage;
+
+public final class HudVisibilityPackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.SET_HUD, null, wrapper -> {
+            wrapper.cancel();
+            final HudVisibilityUpdate update = wrapper.read(HudVisibilityUpdate.TYPE);
+            final int rawVisibility = update.visibility();
+            final HudVisibility visibility = HudVisibility.getByValue(rawVisibility);
+            if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                throw new IllegalArgumentException("Unexpected HUD visibility fields");
+            }
+            if (visibility == null) {
+                ViaBedrock.getPlatform().getLogger().warning("Unknown HUD visibility: " + rawVisibility);
+                return;
+            }
+            final HudVisibilityStorage storage = wrapper.user().get(HudVisibilityStorage.class);
+            storage.update(update.elements().stream().mapToInt(Integer::intValue).toArray(), visibility);
+            storage.sendSnapshot();
+        });
+    }
+
+    private HudVisibilityPackets() {
+    }
+
+}
