+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.HudVisibilityState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudVisibility;
+
+public final class HudVisibilityStorage extends StoredObject {
+
+    private HudVisibilityState state = HudVisibilityState.DEFAULT;
+    private boolean joined;
+
+    public HudVisibilityStorage(final UserConnection user) {
+        super(user);
+    }
+
+    public HudVisibilityState state() {
+        return this.state;
+    }
+
+    public void update(final int[] elements, final HudVisibility visibility) {
+        this.state = this.state.update(elements, visibility);
+    }
+
+    public void markJoined() {
+        this.joined = true;
+    }
+
+    public void sendSnapshot() {
+        if (!this.joined || this.user().getProtocolInfo().getServerState() != State.PLAY || !this.user().get(ChannelStorage.class).hasChannel(HudVisibilityState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, HudVisibilityState.CHANNEL);
+        packet.write(HudVisibilityState.TYPE, this.state);
+        packet.send(BedrockProtocol.class);
+    }
+
+}
