+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudElement;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudVisibility;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/** Server restrictions supplement the player's HUD settings. Reset removes only those restrictions. */
+public record HudVisibilityState(Set<Integer> hiddenElements) {
+
+    public static final String CHANNEL = "viabedrock:hud_visibility";
+    public static final HudVisibilityState DEFAULT = new HudVisibilityState(Set.of());
+    public static final Type<HudVisibilityState> TYPE = new Type<>(HudVisibilityState.class) {
+        @Override
+        public HudVisibilityState read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported HUD visibility snapshot");
+            }
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > 4096) {
+                throw new IllegalArgumentException("Invalid HUD element count");
+            }
+            final Set<Integer> hidden = new HashSet<>();
+            for (int i = 0; i < count; i++) {
+                hidden.add(Types.VAR_INT.readPrimitive(buffer));
+            }
+            return new HudVisibilityState(hidden);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final HudVisibilityState value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.hiddenElements.size());
+            value.hiddenElements.stream().sorted().forEach(element -> Types.VAR_INT.writePrimitive(buffer, element));
+        }
+    };
+
+    public HudVisibilityState {
+        hiddenElements = Set.copyOf(hiddenElements);
+        if (hiddenElements.size() > 4096) {
+            throw new IllegalArgumentException("Invalid HUD element count");
+        }
+    }
+
+    public boolean hides(final HudElement element) {
+        return this.hiddenElements.contains(element.getValue());
+    }
+
+    public HudVisibilityState update(final int[] elements, final HudVisibility visibility) {
+        final Set<Integer> hidden = new HashSet<>(this.hiddenElements);
+        for (final int element : elements) {
+            switch (visibility) {
+                case Hide -> hidden.add(element);
+                case Reset -> hidden.remove(element);
+            }
+        }
+        return new HudVisibilityState(hidden);
+    }
+
+}
