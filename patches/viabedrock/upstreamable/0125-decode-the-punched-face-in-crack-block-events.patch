+package net.raphimc.viabedrock.protocol.packet;
+
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class CrackedBlockStateTest {
+
+    @Test
+    void punchedFaceInTheTopByteStillResolvesTheBlock() {
+        // InPVP sent 0x050033E2 and 0x010033E2 for the same block punched from faces 5 and 1.
+        final Map<Integer, Integer> states = Map.of(0x33E2, 42, 0x7A1B2C3D, 7);
+        assertEquals(42, WorldEffectPackets.crackedBlockState(id -> states.getOrDefault(id, -1), 0x050033E2));
+        assertEquals(42, WorldEffectPackets.crackedBlockState(id -> states.getOrDefault(id, -1), 0x33E2));
+        // A hashed block id uses all 32 bits and resolves before any face is stripped.
+        assertEquals(7, WorldEffectPackets.crackedBlockState(id -> states.getOrDefault(id, -1), 0x7A1B2C3D));
+        assertEquals(-1, WorldEffectPackets.crackedBlockState(id -> states.getOrDefault(id, -1), 0x01000001));
+    }
+
+}
