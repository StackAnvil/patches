From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Wed, 18 Nov 2026 15:06:40 +0100
Subject: [PATCH] fix(particles): decode the punched face in crack block events

Servers send the crack particle for a punched block as the block runtime id
with the punched face in the top byte, runtimeId | (face << 24), as
PocketMine's BlockPunchParticle does. The translation looked the whole value
up as a block state, so every crack particle from another player's mining
was dropped with "Missing block state" (InPVP sent 0x050033E2 and
0x010033E2 for one block punched from two faces).

Look the full value up first, because hashed block ids use all 32 bits, and
fall back to the low 24 bits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
index 428b902c08a646005b7362098be2e3a49319838b..3ee0e9ea0d048d37d751dfe6fe0231b43896029b 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
@@ -72,6 +72,7 @@ import net.raphimc.viabedrock.protocol.types.BedrockTypes;
 
 import java.util.Map;
 import java.util.concurrent.ThreadLocalRandom;
+import java.util.function.IntUnaryOperator;
 import java.util.logging.Level;
 
 public final class WorldEffectPackets {
@@ -459,7 +460,7 @@ public final class WorldEffectPackets {
                             case ParticlesCrit -> javaParticle.withCount(data);
                             case ParticlesCrackBlock, ParticlesCrackBlockDown, ParticlesCrackBlockUp, ParticlesCrackBlockNorth,
                                  ParticlesCrackBlockSouth, ParticlesCrackBlockWest, ParticlesCrackBlockEast -> {
-                                final int javaBlockState = wrapper.user().get(BlockStateRewriter.class).javaId(data);
+                                final int javaBlockState = crackedBlockState(wrapper.user().get(BlockStateRewriter.class)::javaId, data);
                                 if (javaBlockState != -1) {
                                     final Particle p = new Particle(javaParticle.particle().id());
                                     p.add(Types.VAR_INT, javaBlockState); // block state
@@ -835,4 +836,13 @@ public final class WorldEffectPackets {
     private WorldEffectPackets() {
     }
 
+    /**
+     * Servers send a punched block's runtime id with the punched face in the top byte, for example
+     * {@code runtimeId | (face << 24)}. Hashed block ids use all 32 bits, so the full value is tried first.
+     */
+    static int crackedBlockState(final IntUnaryOperator javaId, final int data) {
+        final int javaBlockState = javaId.applyAsInt(data);
+        return javaBlockState != -1 ? javaBlockState : javaId.applyAsInt(data & 0xFFFFFF);
+    }
+
 }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/CrackedBlockStateTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/CrackedBlockStateTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..19116b7512070595f0558c85cc7b0af2c1644c96
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/CrackedBlockStateTest.java
@@ -0,0 +1,25 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
