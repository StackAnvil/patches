+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.api.minecraft.item.data.UseCooldown;
+import com.viaversion.viaversion.util.Key;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HexFormat;
+
+public record ItemCooldown(String category, float seconds) {
+
+    public ItemCooldown {
+        category = Key.namespaced(category);
+        if (!Float.isFinite(seconds) || seconds < 0F) {
+            throw new IllegalArgumentException("Invalid item cooldown duration: " + seconds);
+        }
+    }
+
+    public static ItemCooldown fromNetworkComponents(final CompoundTag components) {
+        if (components.get("minecraft:cooldown") instanceof CompoundTag cooldown
+                && cooldown.get("category") instanceof StringTag category
+                && cooldown.get("duration") instanceof NumberTag duration) {
+            return new ItemCooldown(category.getValue(), duration.asFloat());
+        }
+        if (components.get("minecraft:food") instanceof CompoundTag food
+                && food.get("cooldown_type") instanceof StringTag category
+                && food.get("cooldown_time") instanceof NumberTag ticks && ticks.asInt() > 0) {
+            return new ItemCooldown(category.getValue(), ticks.asInt() / 20F);
+        }
+        return null;
+    }
+
+    public static String javaGroup(final String category) {
+        // Bedrock category names need not be legal Java resource identifiers.
+        return "viabedrock:cooldown/" + HexFormat.of().formatHex(Key.namespaced(category).getBytes(StandardCharsets.UTF_8));
+    }
+
+    public UseCooldown javaComponent() {
+        return new UseCooldown(this.seconds, javaGroup(this.category));
+    }
+
+}
