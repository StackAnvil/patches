+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.minecraft.item.data.UseCooldown;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemCooldownTest {
+
+    @Test
+    void preservesSharedCategoriesThroughPackRegistryAndJavaWireData() throws Exception {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"Cooldown probe\"}}");
+        content.putString("items/wand.json", "{\"minecraft:item\":{\"description\":{\"identifier\":\"probe:wand\"},"
+                + "\"components\":{\"minecraft:cooldown\":{\"category\":\"Probe shared: Ω\",\"duration\":2.75}}}}");
+        final var definitions = new ResourcePackStorage(List.of(new ResourcePack(content))).getItems();
+        final ItemCooldown resourceCooldown = definitions.get("probe:wand").cooldown();
+        final CompoundTag registryCooldown = new CompoundTag();
+        registryCooldown.putString("category", resourceCooldown.category());
+        registryCooldown.putFloat("duration", 1.25F);
+        final CompoundTag components = new CompoundTag();
+        components.put("minecraft:cooldown", registryCooldown);
+        final CompoundTag registry = new CompoundTag();
+        registry.put("components", components);
+        definitions.addFromNetworkTag("probe:wand", registry);
+        final var javaCooldown = definitions.get("probe:wand").cooldown().javaComponent();
+
+        assertEquals(2.75F, resourceCooldown.seconds());
+        assertEquals(1.25F, javaCooldown.seconds());
+        assertEquals(resourceCooldown.javaComponent().cooldownGroup(), javaCooldown.cooldownGroup());
+        assertTrue(javaCooldown.cooldownGroup().matches("[a-z0-9_.-]+:[a-z0-9/._-]+"));
+        final var wire = Unpooled.buffer();
+        try {
+            UseCooldown.TYPE.write(wire, javaCooldown);
+            assertEquals(javaCooldown, UseCooldown.TYPE.read(wire));
+            assertEquals(0, wire.readableBytes());
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void convertsLegacyFoodTickDurationAndHonorsExplicitCooldownOverride() {
+        final CompoundTag food = new CompoundTag();
+        food.putString("cooldown_type", "chorusfruit");
+        food.putInt("cooldown_time", 20);
+        final CompoundTag components = new CompoundTag();
+        components.put("minecraft:food", food);
+        final ItemCooldown legacy = ItemCooldown.fromNetworkComponents(components);
+        assertNotNull(legacy);
+        assertEquals(1F, legacy.seconds());
+        assertEquals(ItemCooldown.javaGroup("minecraft:chorusfruit"), legacy.javaComponent().cooldownGroup());
+
+        final CompoundTag explicit = new CompoundTag();
+        explicit.putString("category", "probe:shared");
+        explicit.putFloat("duration", 0.5F);
+        components.put("minecraft:cooldown", explicit);
+        assertEquals(new ItemCooldown("probe:shared", 0.5F), ItemCooldown.fromNetworkComponents(components));
+        assertNull(ItemCooldown.fromNetworkComponents(new CompoundTag()));
+    }
+
+    @Test
+    void normalizesDefaultNamespacesWithoutMergingDistinctCategories() {
+        assertEquals(ItemCooldown.javaGroup("ender_pearl"), ItemCooldown.javaGroup("minecraft:ender_pearl"));
+        assertNotEquals(ItemCooldown.javaGroup("probe:A"), ItemCooldown.javaGroup("probe:a"));
+        assertNotEquals(ItemCooldown.javaGroup("probe:a b"), ItemCooldown.javaGroup("probe:a_b"));
+        assertThrows(IllegalArgumentException.class, () -> new ItemCooldown("probe:a", Float.NaN));
+        assertThrows(IllegalArgumentException.class, () -> new ItemCooldown("probe:a", -1F));
+    }
+
+}
