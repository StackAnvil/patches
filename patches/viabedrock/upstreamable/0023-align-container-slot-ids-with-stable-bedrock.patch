+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+package net.raphimc.viabedrock.protocol.types.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.ByteBufUtil;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.model.FullContainerName;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class FullContainerNameTypeTest {
+
+    @Test
+    void stableContainerNamesUseProtocol2193SlotIds() {
+        final FullContainerNameType type = new FullContainerNameType();
+        final Map<ContainerEnumName, Integer> ids = Map.of(
+                ContainerEnumName.InventoryContainer, 29,
+                ContainerEnumName.CursorContainer, 59,
+                ContainerEnumName.CreatedOutputContainer, 60,
+                ContainerEnumName.RecipeFoodContainer, 64,
+                ContainerEnumName.RecipeBlocksContainer, 65,
+                ContainerEnumName.RecipeFurnaceItemsContainer, 66);
+
+        ids.forEach((name, id) -> {
+            final ByteBuf buffer = Unpooled.buffer();
+            try {
+                type.write(buffer, new FullContainerName(name, null));
+                assertArrayEquals(new byte[] {id.byteValue(), 0}, ByteBufUtil.getBytes(buffer));
+                assertSame(name, ContainerEnumName.getByValue(id));
+            } finally {
+                buffer.release();
+            }
+        });
+    }
+
+}
diff --git a/src/tool/java/net/raphimc/viabedrock/tool/generator/BedrockDataEnumGenerator.java b/src/tool/java/net/raphimc/viabedrock/tool/generator/BedrockDataEnumGenerator.java
index 8a0954a15..3295226fb 100644
--- a/src/tool/java/net/raphimc/viabedrock/tool/generator/BedrockDataEnumGenerator.java
+++ b/src/tool/java/net/raphimc/viabedrock/tool/generator/BedrockDataEnumGenerator.java
@@ -30,6 +30,7 @@ import net.raphimc.viabedrock.tool.ToolPaths;
 
 import java.nio.file.Files;
 import java.nio.file.Path;
+import java.util.ArrayList;
 import java.util.List;
 import java.util.stream.Stream;
 
@@ -122,8 +123,31 @@ public final class BedrockDataEnumGenerator {
             genEnum.members().addMethod("public", "int", "getValue", method -> method.code().add("return this.value;"));
 
             final JsonArray enumFields = jsonObject.getAsJsonArray("enum");
-            for (int i = 0; i < enumFields.size(); i++) {
-                final JsonElement enumFieldElement = enumFields.get(i);
+            final List<JsonElement> orderedFields = new ArrayList<>(enumFields.asList());
+            if (enumName.equals("ContainerEnumName") && jsonObject.has("x-protocol-version")
+                && jsonObject.get("x-protocol-version").getAsInt() == 2193) {
+                // The 2193 beta metadata inserted these names at 18-20, but the stable
+                // codec adds them at 64-66. Earlier container IDs must not shift.
+                final List<String> recipeCategories = List.of(
+                    "RecipeFoodContainer", "RecipeBlocksContainer", "RecipeFurnaceItemsContainer");
+                if (orderedFields.size() != 67) {
+                    throw new IllegalStateException("Unexpected 2193 ContainerEnumName metadata layout");
+                }
+                if (orderedFields.subList(18, 21).stream().map(JsonElement::getAsString).toList()
+                    .equals(recipeCategories)) {
+                    if (jsonObject.has("x-enum-binary-value")) {
+                        throw new IllegalStateException("Cannot reorder explicit container enum values");
+                    }
+                    final List<JsonElement> addedCategories = new ArrayList<>(orderedFields.subList(18, 21));
+                    orderedFields.subList(18, 21).clear();
+                    orderedFields.addAll(addedCategories);
+                } else if (!orderedFields.subList(64, 67).stream().map(JsonElement::getAsString)
+                    .toList().equals(recipeCategories)) {
+                    throw new IllegalStateException("Unexpected 2193 ContainerEnumName metadata layout");
+                }
+            }
+            for (int i = 0; i < orderedFields.size(); i++) {
+                final JsonElement enumFieldElement = orderedFields.get(i);
                 final String name = enumFieldElement.getAsString().replace(" ", "_");
                 String value = null;
                 if (jsonObject.has("x-enum-binary-value")) {
@@ -132,6 +156,9 @@ public final class BedrockDataEnumGenerator {
                         value = binaryValues.get(i).getAsString();
                     }
                 }
+                if (enumName.equals("ContainerEnumName") && value == null) {
+                    value = Integer.toString(i);
+                }
 
                 genEnum.enumFields().add(new Field(name, null, null, value, new Javadoc()));
             }
