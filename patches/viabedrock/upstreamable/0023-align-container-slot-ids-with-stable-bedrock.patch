From e1273dfc9638ec8347f83fa52a12cac335d4b399 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:28:27 +0200
Subject: [PATCH] fix(inventory): align container slot IDs with stable Bedrock
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The protocol 2193 beta metadata inserts three recipe categories ahead of the inventory and cursor containers, shifting every later ID. Stable codecs append those categories at IDs 64-66. Teach the enum generator to correct only that known metadata layout and regenerate the container IDs so stack requests address the server’s actual slots.
---
 .../bedrock/generated/ContainerEnumName.java  |  6 +--
 .../model/FullContainerNameTypeTest.java      | 49 +++++++++++++++++++
 .../generator/BedrockDataEnumGenerator.java   | 31 +++++++++++-
 3 files changed, 81 insertions(+), 5 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/types/model/FullContainerNameTypeTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/data/enums/bedrock/generated/ContainerEnumName.java b/src/main/java/net/raphimc/viabedrock/protocol/data/enums/bedrock/generated/ContainerEnumName.java
index 0ffc10f6c..bbfe0d987 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/data/enums/bedrock/generated/ContainerEnumName.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/data/enums/bedrock/generated/ContainerEnumName.java
@@ -24,9 +24,6 @@ public enum ContainerEnumName {
     RecipeConstructionContainer(15),
     RecipeNatureContainer(16),
     RecipeItemsContainer(17),
-    RecipeFoodContainer(64),
-    RecipeBlocksContainer(65),
-    RecipeFurnaceItemsContainer(66),
     RecipeSearchContainer(18),
     RecipeSearchBarContainer(19),
     RecipeEquipmentContainer(20),
@@ -73,6 +70,9 @@ public enum ContainerEnumName {
     SmithingTableTemplateContainer(61),
     CrafterLevelEntityContainer(62),
     DynamicContainer(63),
+    RecipeFoodContainer(64),
+    RecipeBlocksContainer(65),
+    RecipeFurnaceItemsContainer(66),
     ;
 
     private static final Int2ObjectMap<ContainerEnumName> BY_VALUE = new Int2ObjectOpenHashMap<>();
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/types/model/FullContainerNameTypeTest.java b/src/test/java/net/raphimc/viabedrock/protocol/types/model/FullContainerNameTypeTest.java
new file mode 100644
index 000000000..6f35155c5
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/types/model/FullContainerNameTypeTest.java
@@ -0,0 +1,49 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
