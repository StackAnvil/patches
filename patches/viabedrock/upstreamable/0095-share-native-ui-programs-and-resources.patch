+        private UiBindings.Scope scope(final String collection, final int index, final UiBindings.Scope parent, final UiBindings.Scope context) {
+            final String name = collection.isEmpty() ? this.bindings.defaultCollection() : collection;
+            final UiBindings.Collection entries = this.collection(name, this.bindings.ownsCollection(name) ? parent : context);
+            if (index < 0 || index >= entries.entries().size()) {
+                return null;
+            }
+            final UiBindings.Scope selected = new UiBindings.Scope(name, index, parent);
