+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/** Target cooking-controller transitions, independent of item and recipe authority. */
+public final class CookingNavigation {
+
+    private CookingNavigation() { }
+
+    public static String tabLabel(final int tab, final CookingUi.Family family, final boolean filtering) {
+        Objects.requireNonNull(family);
+        return switch (tab) {
+            case 1 -> "furnaceScreen.tab.food";
+            case 2 -> "furnaceScreen.tab.items";
+            case 3 -> "furnaceScreen.tab.blocks";
+            case 4 -> !filtering ? "craftingScreen.tab.allRecipes"
+                    : family == CookingUi.Family.SMOKER ? "furnaceScreen.tab.search.filterSmoker" : "furnaceScreen.tab.search.filterFurnace";
+            case 5 -> "craftingScreen.tab.survival";
+            default -> "";
+        };
+    }
+
+    public static List<Integer> tabs(final boolean forcedRecipeBook, final int food, final int items, final int blocks) {
+        final List<Integer> tabs = new ArrayList<>(5);
+        if (forcedRecipeBook) {
+            tabs.add(4);
+        }
+        if (food > 0) {
+            tabs.add(1);
+        }
+        if (items > 0) {
+            tabs.add(2);
+        }
+        if (blocks > 0) {
+            tabs.add(3);
+        }
+        tabs.add(forcedRecipeBook ? 5 : 4);
+        return List.copyOf(tabs);
+    }
+
+    public static int tab(final boolean forcedRecipeBook, final int food, final int items, final int blocks,
+                          final int current, final int delta) {
+        final var tabs = tabs(forcedRecipeBook, food, items, blocks);
+        final int index = tabs.indexOf(current);
+        return index < 0 ? tabs.getFirst() : tabs.get(Math.floorMod(index + (delta > 0 ? 1 : -1), tabs.size()));
+    }
+
+    public static TabTransition moveTab(final boolean forcedRecipeBook, final int layout,
+                                        final int food, final int items, final int blocks, final int current, final int delta) {
+        if (!forcedRecipeBook && layout == 1) {
+            return new TabTransition(current, false);
+        }
+        return new TabTransition(tab(forcedRecipeBook, food, items, blocks, current, delta), true);
+    }
+
+    public static LayoutTransition moveLayout(final boolean forcedRecipeBook, final int current, final int tab,
+                                              final int savedTab, final boolean rememberInventory, final Direction direction) {
+        Objects.requireNonNull(direction);
+        if (forcedRecipeBook) {
+            return new LayoutTransition(current, savedTab, false, false);
+        }
+        final boolean advance = direction == Direction.NEXT ? current >= 0 : current >= 2;
+        final int candidate = current + (direction == Direction.NEXT ? 1 : -1);
+        final int layout = advance ? Integer.compareUnsigned(candidate, 3) < 0 ? candidate : 1 : 2;
+        return new LayoutTransition(layout, current == 1 && rememberInventory ? tab : savedTab, true, true);
+    }
+
+    public enum Direction {
+        PREVIOUS, NEXT
+    }
+
+    public record TabTransition(int tab, boolean refresh) { }
+
+    public record LayoutTransition(int layout, int savedTab, boolean clearHover, boolean refresh) { }
+
+}
