+    /** Selects authored factory hosts before expansion, so unrelated HUD collections need no controller data. */
+    public Resolution resolveFactory(final String reference, final String factory, final UiBindings bindings) {
+        final Session session = new Session(bindings);
+        final JsonObject selected = this.factoryBranch(reference, new JsonObject(), session.initial,
+                factory, session.requiredDefinitions, new int[1], 0);
+        final JsonObject root = selected == null ? null
+                : session.expand(reference, selected, session.initial, null, null, 0);
+        return new Resolution(root, Set.copyOf(session.requiredDefinitions), Set.copyOf(session.missingTemplates));
+    }
+
+    private JsonObject factoryBranch(final String reference, final JsonObject overrides,
+                                    final Map<String, JsonElement> inherited, final String factory,
+                                    final Set<String> required, final int[] count, final int depth) {
+        if (++count[0] > MAX_NODES || depth > 64) {
+            throw new IllegalArgumentException("UI factory exceeds limits");
+        }
+        final String[] parts = substitute(reference, inherited).split("@", 2);
+        final String declared = parts.length == 2 ? parts[1] : parts[0];
+        final String base = parts.length == 2 && !declared.contains(".")
+                ? UiExpression.text(inherited.get("$__namespace")) + "." + declared : declared;
+        final JsonObject template = this.template(base, new HashSet<>(), required);
+        final JsonObject control = template == null ? new JsonObject() : template;
+        merge(control, overrides);
+        applyModifications(control);
+        final Map<String, JsonElement> values = new HashMap<>(inherited);
+        if (template != null && base.contains(".")) {
+            values.put("$__namespace", new JsonPrimitive(base.substring(0, base.indexOf('.'))));
+        }
+        declarations(control, values);
+        final JsonObject host = control.getAsJsonObject("factory");
+        if (host != null && factory.equals(string(host, "name"))) {
+            return control;
+        }
+        if (factory.equals(string(control, "name")) && "factory".equals(string(control, "type"))) {
+            return control;
+        }
+        final JsonElement raw = resolveValue(control.get("controls"), values, 0);
+        final JsonArray selected = new JsonArray();
+        if (raw.isJsonArray()) {
+            for (final JsonElement child : raw.getAsJsonArray()) {
+                for (final Map.Entry<String, JsonElement> entry : child.getAsJsonObject().entrySet()) {
+                    final JsonObject branch = this.factoryBranch(entry.getKey(), entry.getValue().getAsJsonObject(),
+                            values, factory, required, count, depth + 1);
+                    if (branch != null) {
+                        final JsonObject declaration = new JsonObject();
+                        declaration.add(entry.getKey(), branch);
+                        selected.add(declaration);
+                    }
+                }
+            }
+        }
+        if (selected.isEmpty()) {
+            return null;
+        }
+        control.add("controls", selected);
+        return control;
+    }
+
+    public Resolution resolveScreen(final String host, final String fallback, final UiBindings bindings) {
+        final Session session = new Session(bindings);
+        final JsonObject screen = this.template(host, new HashSet<>(), session.requiredDefinitions);
+        final Map<String, JsonElement> values = new HashMap<>(session.initial);
+        if (screen != null) {
+            declarations(screen, values);
+        }
+        final String selected = UiExpression.text(resolveValue(new JsonPrimitive("$screen_content"), values, 0));
+        final String content = selected.isEmpty() ? fallback : selected;
+        final String reference = content.contains("@") ? content : content + "@" + content;
+        final JsonObject root = session.expand(reference, new JsonObject(), values, null, null, 0);
+        return new Resolution(root, Set.copyOf(session.requiredDefinitions), Set.copyOf(session.missingTemplates));
+    }
