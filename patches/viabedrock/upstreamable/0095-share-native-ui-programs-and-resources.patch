+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import java.util.Objects;
+
+/** A completed selection can resume only while its exact inventory snapshot remains current. */
+public record NativeCookingActionResult(NativeCookingAction action, boolean accepted, boolean current) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking_action_result_v5";
+    public static final Type<NativeCookingActionResult> TYPE = new Type<>(NativeCookingActionResult.class) {
+        @Override
+        public NativeCookingActionResult read(final ByteBuf buffer) {
+            if (buffer.readableBytes() < 3 || buffer.readableBytes() > NativeCookingAction.MAX_ENCODED_BYTES + 2) {
+                throw new IllegalArgumentException("Invalid native cooking action result length");
+            }
+            final var action = NativeCookingAction.TYPE.read(buffer.readSlice(buffer.readableBytes() - 2));
+            final int accepted = buffer.readUnsignedByte();
+            final int current = buffer.readUnsignedByte();
+            if (accepted > 1 || current > 1) {
+                throw new IllegalArgumentException("Invalid native cooking action result flags");
+            }
+            return new NativeCookingActionResult(action, accepted == 1, current == 1);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCookingActionResult result) {
+            NativeCookingAction.TYPE.write(buffer, result.action);
+            buffer.writeBoolean(result.accepted);
+            buffer.writeBoolean(result.current);
+        }
+    };
+
+    public NativeCookingActionResult {
+        Objects.requireNonNull(action);
+    }
+
+}
