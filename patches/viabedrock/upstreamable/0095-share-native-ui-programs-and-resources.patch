+import io.netty.buffer.Unpooled;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+final class NativeHudMessageTest {
+
+    @Test
+    void preservesRestartAndLifetimeAndRejectsTrailingData() {
+        final var message = new NativeHudMessage(UUID.randomUUID().toString(), true, 100);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeHudMessage.TYPE.write(buffer, message);
+            assertEquals(message, NativeHudMessage.TYPE.read(buffer));
+            buffer.clear();
+            final var authored = new NativeHudMessage(message.scene(), true, NativeHudMessage.ANIMATION_LIFETIME);
+            NativeHudMessage.TYPE.write(buffer, authored);
+            assertEquals(authored, NativeHudMessage.TYPE.read(buffer));
+            buffer.clear();
+            NativeHudMessage.TYPE.write(buffer, message);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeHudMessage.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new NativeHudMessage("", false, NativeHudMessage.ANIMATION_LIFETIME - 1));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
