+    private final class Session {
+
+        private final UiBindings bindings;
+        private final Set<String> requiredDefinitions = new LinkedHashSet<>();
+        private final Set<String> missingTemplates = new LinkedHashSet<>();
+        private final Map<String, JsonElement> initial = new HashMap<>(JsonUiProgram.this.globals);
+        private final Map<String, Map<String, JsonElement>> controls = new HashMap<>();
+        private final Map<CollectionKey, UiBindings.Collection> collections = new HashMap<>();
+        private final Map<UiBindings.Scope, UiBindings.Collection> generatedCollections = new IdentityHashMap<>();
+        private int nodes;
+
+        private Session(final UiBindings bindings) {
+            this.bindings = bindings;
+            this.initial.putAll(bindings.globals());
+        }
+
+        private UiBindings.Collection collection(final String name, final UiBindings.Scope parent) {
+            for (UiBindings.Scope candidate = parent; candidate != null; candidate = candidate.parent()) {
+                if (name.equals(candidate.collection()) && this.generatedCollections.containsKey(candidate)) {
+                    return this.generatedCollections.get(candidate);
+                }
+            }
+            return this.controllerCollection(name, this.controllerScope(parent));
