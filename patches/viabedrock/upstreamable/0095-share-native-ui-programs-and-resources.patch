+
+class ContainerUiTest {
+
+    private static final String UI = """
+            {"namespace":"chest",
+             "small_chest_screen":{"$screen_content":"chest.panel","variables":[
+               {"requires":"($container_title = 'Alternative')","$screen_content":"chest.alternative"}]},
+             "large_chest_screen":{"$screen_content":"chest.panel"},
+             "alternative@chest.panel":{"size":[220,180]},
+             "small_chest_panel@chest.panel":{},"large_chest_panel@chest.panel":{},
+             "panel":{"type":"panel","controls":[
+               {"title":{"type":"label","text":"$container_title"}},
+               {"external":{"type":"grid","collection_name":"container_items","grid_item_template":"chest.cell"}},
+               {"storage":{"type":"grid","collection_name":"inventory_items","grid_item_template":"chest.cell"}},
+               {"hotbar":{"type":"grid","collection_name":"hotbar_items","grid_item_template":"chest.cell"}},
