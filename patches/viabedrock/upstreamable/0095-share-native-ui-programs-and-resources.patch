@@ -0,0 +1,218 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Sorting logic adapted from Microsoft STL, Copyright (c) Microsoft Corporation.
+ * Licensed under Apache-2.0 WITH LLVM-exception; see META-INF/licenses/Microsoft-STL.txt.
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import java.util.function.ToIntFunction;
+
+/** The pinned native cooking book sorts signed priorities and can reorder equal priorities. */
+public final class CookingRecipeOrder {
+
+    private CookingRecipeOrder() { }
+
+    /** Native registry keys use unsigned UTF-8 byte order, independently of packet arrival. */
+    public static <T> List<T> registryOrder(final List<T> entries, final Function<T, String> identity) {
+        final List<RegistryEntry<T>> result = new ArrayList<>(entries.size());
+        for (final T entry : entries) {
+            result.add(new RegistryEntry<>(entry, identity.apply(entry).getBytes(StandardCharsets.UTF_8)));
+        }
+        result.sort((first, second) -> Arrays.compareUnsigned(first.key, second.key));
+        for (int index = 1; index < result.size(); index++) {
+            if (Arrays.equals(result.get(index - 1).key, result.get(index).key)) {
+                throw new IllegalArgumentException("Ambiguous native cooking registry identity");
+            }
+        }
+        return result.stream().map(RegistryEntry::entry).toList();
+    }
+
+    /** Unlocks and output deduplication precede the native priority sort. */
+    public static <T> List<T> bookOrder(final List<T> entries, final Function<T, String> identity,
+                                       final Predicate<T> unlocked, final Function<T, String> outputName,
+                                       final ToIntFunction<T> priority) {
+        final Set<String> outputs = new HashSet<>();
+        return sorted(registryOrder(entries, identity).stream()
+                .filter(entry -> unlocked.test(entry) && outputs.add(outputName.apply(entry))).toList(), priority);
+    }
+
+    public static <T> List<T> sorted(final List<T> entries, final ToIntFunction<T> priority) {
+        final List<T> result = new ArrayList<>(entries);
+        sort(result, priority, 0, result.size(), result.size());
+        return List.copyOf(result);
+    }
+
+    /** Native ungrouped collections expose a stable prefix of evaluator buckets 0, 1 and 2. */
+    public static <T> List<T> visibleOrder(final List<T> entries, final ToIntFunction<T> evaluation,
+                                         final boolean filtering) {
+        final List<List<T>> buckets = List.of(new ArrayList<>(), new ArrayList<>(), new ArrayList<>());
+        for (final T entry : entries) {
+            final int state = evaluation.applyAsInt(entry);
+            if (state < 0 || state > 3) {
+                throw new IllegalArgumentException("Invalid native cooking evaluator state");
+            }
+            if (state != 3) {
+                // Without filtering, states 1 and 2 share one bucket. State 0
+                // remains first and state 3 stays outside the visible prefix.
+                buckets.get(filtering || state == 0 ? state : 1).add(entry);
+            }
+        }
+        return buckets.stream().flatMap(List::stream).toList();
+    }
+
+    private static <T> void sort(final List<T> entries, final ToIntFunction<T> priority,
+                                 int first, int last, int ideal) {
+        while (last - first > 32) {
+            if (ideal <= 0) {
+                heapSort(entries, priority, first, last);
+                return;
+            }
+            final int middle = first + (last - first) / 2;
+            final int end = last - 1;
+            if (end - first > 40) {
+                final int step = (last - first) / 8;
+                median(entries, priority, first, first + step, first + step * 2);
+                median(entries, priority, middle - step, middle, middle + step);
+                median(entries, priority, end - step * 2, end - step, end);
+                median(entries, priority, first + step, middle, end - step);
+            } else {
+                median(entries, priority, first, middle, end);
+            }
+            int pivotFirst = middle;
+            int pivotLast = middle + 1;
+            final int pivot = priority.applyAsInt(entries.get(middle));
+            while (pivotFirst > first && priority.applyAsInt(entries.get(pivotFirst - 1)) == pivot) {
+                pivotFirst--;
+            }
+            while (pivotLast < last && priority.applyAsInt(entries.get(pivotLast)) == pivot) {
+                pivotLast++;
+            }
+            int upper = pivotLast;
+            int lower = pivotFirst;
+            while (true) {
+                while (upper < last) {
+                    final int key = priority.applyAsInt(entries.get(upper));
+                    if (key < pivot) {
+                        break;
+                    }
+                    if (key == pivot) {
+                        Collections.swap(entries, pivotLast++, upper);
+                    }
+                    upper++;
+                }
+                while (lower > first) {
+                    final int key = priority.applyAsInt(entries.get(lower - 1));
+                    if (key > pivot) {
+                        break;
+                    }
+                    if (key == pivot) {
+                        Collections.swap(entries, --pivotFirst, lower - 1);
+                    }
+                    lower--;
+                }
+                if (lower == first && upper == last) {
+                    break;
+                }
+                if (lower == first) {
+                    if (pivotLast != upper) {
+                        Collections.swap(entries, pivotFirst, pivotLast);
+                    }
+                    pivotLast++;
+                    Collections.swap(entries, pivotFirst++, upper++);
+                } else if (upper == last) {
+                    Collections.swap(entries, --lower, --pivotFirst);
+                    Collections.swap(entries, pivotFirst, --pivotLast);
+                } else {
+                    Collections.swap(entries, upper++, --lower);
+                }
+            }
+            ideal = (ideal >> 1) + (ideal >> 2);
+            if (pivotFirst - first < last - pivotLast) {
+                sort(entries, priority, first, pivotFirst, ideal);
+                first = pivotLast;
+            } else {
+                sort(entries, priority, pivotLast, last, ideal);
+                last = pivotFirst;
+            }
+        }
+        for (int index = first + 1; index < last; index++) {
+            final T value = entries.get(index);
+            int hole = index;
+            while (hole > first && priority.applyAsInt(value) < priority.applyAsInt(entries.get(hole - 1))) {
+                entries.set(hole, entries.get(hole - 1));
+                hole--;
+            }
+            entries.set(hole, value);
+        }
+    }
+
+    private static <T> void median(final List<T> entries, final ToIntFunction<T> priority,
+                                   final int first, final int middle, final int last) {
+        if (priority.applyAsInt(entries.get(middle)) < priority.applyAsInt(entries.get(first))) {
+            Collections.swap(entries, first, middle);
+        }
+        if (priority.applyAsInt(entries.get(last)) < priority.applyAsInt(entries.get(middle))) {
+            Collections.swap(entries, middle, last);
+            if (priority.applyAsInt(entries.get(middle)) < priority.applyAsInt(entries.get(first))) {
+                Collections.swap(entries, first, middle);
+            }
+        }
+    }
+
+    private static <T> void heapSort(final List<T> entries, final ToIntFunction<T> priority,
+                                     final int first, final int last) {
+        final int size = last - first;
+        for (int hole = size / 2; hole > 0; ) {
+            hole--;
+            reheap(entries, priority, first, hole, size, entries.get(first + hole));
+        }
+        for (int remaining = size - 1; remaining > 0; remaining--) {
+            final T value = entries.get(first + remaining);
+            entries.set(first + remaining, entries.get(first));
+            reheap(entries, priority, first, 0, remaining, value);
+        }
+    }
+
+    private static <T> void reheap(final List<T> entries, final ToIntFunction<T> priority,
+                                   final int first, int hole, final int bottom, final T value) {
+        final int top = hole;
+        final int lastParent = (bottom - 1) / 2;
+        int child = hole;
+        while (child < lastParent) {
+            child = child * 2 + 2;
+            if (priority.applyAsInt(entries.get(first + child)) < priority.applyAsInt(entries.get(first + child - 1))) {
+                child--;
+            }
+            entries.set(first + hole, entries.get(first + child));
+            hole = child;
+        }
+        if (child == lastParent && bottom % 2 == 0) {
+            entries.set(first + hole, entries.get(first + bottom - 1));
+            hole = bottom - 1;
+        }
+        while (hole > top) {
+            final int parent = (hole - 1) / 2;
+            if (priority.applyAsInt(entries.get(first + parent)) >= priority.applyAsInt(value)) {
+                break;
+            }
+            entries.set(first + hole, entries.get(first + parent));
+            hole = parent;
+        }
+        entries.set(first + hole, value);
+    }
+
+    private record RegistryEntry<T>(T entry, byte[] key) { }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/CookingUi.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/CookingUi.java
