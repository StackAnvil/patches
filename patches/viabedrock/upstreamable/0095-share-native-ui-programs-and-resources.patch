@@ -0,0 +1,70 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.util.ArrayList;
+import java.util.List;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Immutable counter update scoped to one exported menu presentation. */
+public record NativeContainerData(int menuId, long sequence, ContainerUi.Kind kind, List<Integer> data) {
+
+    public static final String CHANNEL = "viabedrock:native_container_data";
+    public static final Type<NativeContainerData> TYPE = new Type<>(NativeContainerData.class) {
+        @Override
+        public NativeContainerData read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 128 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native container data");
+            }
+            final int menuId = Types.VAR_INT.readPrimitive(buffer);
+            final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+            final var kind = ContainerUi.Kind.fromWireId(buffer.readUnsignedByte());
+            final var data = readData(buffer, kind);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native container data");
+            }
+            return new NativeContainerData(menuId, sequence, kind, data);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeContainerData value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+            buffer.writeByte(value.kind.wireId());
+            writeData(buffer, value.data);
+        }
+    };
+
+    public NativeContainerData {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || kind == null || kind.initialData().isEmpty()) {
+            throw new IllegalArgumentException("Invalid native container data identity");
+        }
+        data = List.copyOf(data);
+        kind.validateData(data);
+    }
+
+    static List<Integer> readData(final ByteBuf buffer, final ContainerUi.Kind kind) {
+        final var data = new ArrayList<Integer>(kind.initialData().size());
+        for (int index = 0; index < kind.initialData().size(); index++) {
+            data.add(Types.VAR_INT.readPrimitive(buffer));
+        }
+        return List.copyOf(data);
+    }
+
+    static void writeData(final ByteBuf buffer, final List<Integer> data) {
+        for (final int value : data) {
+            Types.VAR_INT.writePrimitive(buffer, value);
+        }
+    }
+
+}
