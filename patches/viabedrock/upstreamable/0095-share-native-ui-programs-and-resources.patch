+
+class NativeCookingControlTest {
+
+    @Test
+    void controlsAndAcknowledgmentsRetainEveryIdentityAndRejectTruncatedOrTrailingData() {
+        for (final var mode : NativeCookingControl.Mode.values()) {
+            for (final var control : List.of(new NativeCookingControl(0, 1, 1, 0, 0, 0, mode),
+                    new NativeCookingControl(255, Long.MAX_VALUE, Long.MAX_VALUE,
+                            Long.MAX_VALUE, Long.MAX_VALUE, Long.MAX_VALUE, mode))) {
+                final var wire = Unpooled.buffer();
+                try {
+                    NativeCookingControl.TYPE.write(wire, control);
+                    for (int length = 0; length < wire.readableBytes(); length++) {
+                        final var partial = wire.copy(0, length);
+                        try {
+                            assertThrows(RuntimeException.class, () -> NativeCookingControl.TYPE.read(partial));
+                        } finally {
+                            partial.release();
+                        }
+                    }
+                    assertEquals(control, NativeCookingControl.TYPE.read(wire.duplicate()));
+                    wire.writeByte(0);
+                    assertThrows(IllegalArgumentException.class, () -> NativeCookingControl.TYPE.read(wire.duplicate()));
+                    for (final boolean accepted : new boolean[]{false, true}) {
+                        wire.clear();
+                        final var status = new NativeCookingStatus(control, accepted);
+                        NativeCookingStatus.TYPE.write(wire, status);
+                        for (int length = 0; length < wire.readableBytes(); length++) {
+                            final var partial = wire.copy(0, length);
+                            try {
+                                assertThrows(RuntimeException.class, () -> NativeCookingStatus.TYPE.read(partial));
+                            } finally {
+                                partial.release();
+                            }
+                        }
+                        assertEquals(status, NativeCookingStatus.TYPE.read(wire.duplicate()));
+                        wire.writeByte(0);
+                        assertThrows(IllegalArgumentException.class, () -> NativeCookingStatus.TYPE.read(wire.duplicate()));
+                    }
+                } finally {
+                    wire.release();
+                }
+            }
+        }
+    }
+
+    @Test
+    void malformedEnvelopeModeAndAcceptanceCannotBecomeActivation() {
+        final var control = new NativeCookingControl(1, 1, 1, 0, 0, 0, NativeCookingControl.Mode.ACTIVATE);
+        for (final int field : new int[]{0, 1, 2, 3}) {
+            final var wire = Unpooled.buffer();
+            try {
+                NativeCookingStatus.TYPE.write(wire, new NativeCookingStatus(control, true));
+                final int offset = switch (field) {
+                    case 0 -> 0;
+                    case 1 -> 1;
+                    case 2 -> wire.writerIndex() - 2;
+                    default -> wire.writerIndex() - 1;
+                };
+                wire.setByte(offset, field == 1 ? 0 : 2);
+                assertThrows(RuntimeException.class, () -> NativeCookingStatus.TYPE.read(wire));
+            } finally {
+                wire.release();
+            }
+        }
+        final var oversized = Unpooled.buffer().writeZero(65);
+        try {
+            assertThrows(IllegalArgumentException.class, () -> NativeCookingControl.TYPE.read(oversized.duplicate()));
+            assertThrows(IllegalArgumentException.class, () -> NativeCookingStatus.TYPE.read(oversized.duplicate()));
+        } finally {
+            oversized.release();
+        }
+    }
+
+    @Test
+    void invalidControlIdentitiesNeverReachTheWire() {
+        assertThrows(IllegalArgumentException.class, () -> new NativeCookingControl(-1, 1, 1, 0, 0, 0, NativeCookingControl.Mode.ACTIVATE));
+        assertThrows(IllegalArgumentException.class, () -> new NativeCookingControl(256, 1, 1, 0, 0, 0, NativeCookingControl.Mode.ACTIVATE));
+        for (int field = 0; field < 5; field++) {
+            final long[] identity = {1, 1, 0, 0, 0};
+            identity[field] = field < 2 ? 0 : -1;
+            assertThrows(IllegalArgumentException.class, () -> new NativeCookingControl(0,
+                    identity[0], identity[1], identity[2], identity[3], identity[4], NativeCookingControl.Mode.ACTIVATE));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new NativeCookingControl(0, 1, 1, 0, 0, 0, null));
+    }
