+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.imageio.ImageIO;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+
+/** Normalizes a pack layer using the same image format priority as Bedrock content lookups. */
+final class UiTextures {
+
+    static final int MAX_FILES = 16384;
+
+    private UiTextures() {
+    }
+
+    static void load(final Map<String, byte[]> files, final Map<String, byte[]> result) {
+        final Set<String> images = new LinkedHashSet<>();
+        for (final var entry : files.entrySet()) {
+            final String path = entry.getKey();
+            if (!path.startsWith("textures/") || !path.matches("[A-Za-z0-9_./-]{1,256}")
+                    || path.contains("..") || entry.getValue().length > 16 * 1024 * 1024) {
+                continue;
+            }
+            if (path.endsWith(".json")) {
+                if (result.size() < MAX_FILES || result.containsKey(path)) {
+                    result.put(path, entry.getValue());
+                }
+            } else if (path.endsWith(".png") || path.endsWith(".jpg") || path.endsWith(".tga")) {
+                images.add(path.substring(0, path.length() - 4));
+            }
+        }
+        for (final String path : images) {
+            if (result.size() >= MAX_FILES && !result.containsKey(path + ".png")) {
+                continue;
+            }
+            for (final String format : List.of("png", "jpg", "tga")) {
+                final byte[] bytes = files.get(path + "." + format);
+                if (bytes == null || bytes.length > 16 * 1024 * 1024) {
+                    continue;
+                }
+                try {
+                    validateDimensions(bytes, format);
+                    final byte[] png = new Content.LazyImage(bytes, format).getPngBytes();
+                    if (png.length <= 16 * 1024 * 1024) {
+                        result.put(path + ".png", png);
+                    }
+                } catch (final IOException | RuntimeException malformed) {
+                    // An unusable image cannot prevent unrelated controls or textures from loading.
+                }
+                break;
+            }
+        }
+    }
+
+    private static void validateDimensions(final byte[] bytes, final String format) throws IOException {
+        if (format.equals("tga")) {
+            if (bytes.length < 18) {
+                throw new IOException("Truncated UI texture");
+            }
+            validateDimensions(Byte.toUnsignedInt(bytes[12]) | Byte.toUnsignedInt(bytes[13]) << 8,
+                    Byte.toUnsignedInt(bytes[14]) | Byte.toUnsignedInt(bytes[15]) << 8);
+            return;
+        }
+        try (var input = ImageIO.createImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(input);
+            if (!readers.hasNext()) {
+                throw new IOException("Unsupported UI texture");
+            }
+            final var reader = readers.next();
+            try {
+                reader.setInput(input, true, true);
+                validateDimensions(reader.getWidth(0), reader.getHeight(0));
+            } finally {
+                reader.dispose();
+            }
+        }
+    }
+
+    private static void validateDimensions(final int width, final int height) throws IOException {
+        if (width <= 0 || height <= 0 || width > 4096 || height > 4096) {
+            throw new IOException("UI texture exceeds dimension limits");
+        }
+    }
+
+}
