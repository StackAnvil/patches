+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.util.GsonUtil;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Supplier;
+import java.util.stream.Collectors;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** A cooking presentation retains Bedrock state independently of Java menu properties. */
+public record NativeCookingMessage(int menuId, long sequence, long updateSequence, long menuRevision,
+                                   long inventoryRevision, long cursorRevision, String program, String snapshot, Map<Integer, Item> recipeItems) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking";
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    private static final int HEADER_RESERVE = 64;
+    public static final int MAX_RECIPE_ITEMS = 4096;
+    public static final Type<NativeCookingMessage> TYPE = codec(() -> VersionedTypes.V26_3.item);
+
+    static Type<NativeCookingMessage> codec(final Supplier<Type<Item>> itemType) {
+        return new Type<>(NativeCookingMessage.class) {
+
+            @Override
+            public NativeCookingMessage read(final ByteBuf buffer) {
+                if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                        || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                    throw new IllegalArgumentException("Unsupported native cooking message");
+                }
+                final int menuId = Types.VAR_INT.readPrimitive(buffer);
+                final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+                final long updateSequence = Types.VAR_LONG.readPrimitive(buffer);
+                final long menuRevision = Types.VAR_LONG.readPrimitive(buffer);
+                final long inventoryRevision = Types.VAR_LONG.readPrimitive(buffer);
+                final long cursorRevision = Types.VAR_LONG.readPrimitive(buffer);
+                final String program = readString(buffer);
+                final String snapshot = readString(buffer);
+                final int count = Types.VAR_INT.readPrimitive(buffer);
+                if (count < 0 || count > MAX_RECIPE_ITEMS) {
+                    throw new IllegalArgumentException("Invalid native cooking preview count");
+                }
+                final Map<Integer, Item> items = new HashMap<>();
+                for (int index = 0; index < count; index++) {
+                    final int id = Types.VAR_INT.readPrimitive(buffer);
+                    final int length = Types.VAR_INT.readPrimitive(buffer);
+                    if (id < 0 || items.containsKey(id) || length <= 0 || length > buffer.readableBytes()) {
+                        throw new IllegalArgumentException("Invalid native cooking preview identity or length");
+                    }
+                    final ByteBuf itemBytes = buffer.readSlice(length);
+                    final Item item = itemType.get().read(itemBytes);
+                    if (itemBytes.isReadable()) {
+                        throw new IllegalArgumentException("Trailing native cooking preview data");
+                    }
+                    items.put(id, item);
+                }
+                if (buffer.isReadable()) {
+                    throw new IllegalArgumentException("Trailing native cooking data");
+                }
+                return new NativeCookingMessage(menuId, sequence, updateSequence, menuRevision,
+                        inventoryRevision, cursorRevision, program, snapshot, items);
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final NativeCookingMessage value) {
+                // Encode atomically in a bounded buffer. Oversized component data must
+                // never partially append a message to the caller's packet.
+                final ByteBuf encoded = Unpooled.buffer(256, MAX_PAYLOAD_BYTES);
+                try {
+                    writeMessage(encoded, value, itemType);
+                    buffer.writeBytes(encoded);
+                } catch (final IndexOutOfBoundsException oversized) {
+                    throw new IllegalArgumentException("Native cooking state exceeds the payload limit", oversized);
+                } finally {
+                    encoded.release();
+                }
+            }
+        };
+    }
+
+    public NativeCookingMessage {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || updateSequence <= 0
+                || menuRevision < 0 || inventoryRevision < 0 || cursorRevision < 0 || program == null || snapshot == null || recipeItems == null) {
+            throw new IllegalArgumentException("Invalid native cooking identity");
+        }
+        if ((long) program.getBytes(StandardCharsets.UTF_8).length + snapshot.getBytes(StandardCharsets.UTF_8).length
+                > MAX_PAYLOAD_BYTES - HEADER_RESERVE) {
+            throw new IllegalArgumentException("Native cooking state exceeds the payload limit");
+        }
+        if (!StandardCharsets.UTF_8.newEncoder().canEncode(program) || !StandardCharsets.UTF_8.newEncoder().canEncode(snapshot)) {
+            throw new IllegalArgumentException("Invalid native cooking Unicode");
+        }
+        final var view = decodeView(snapshot);
+        final Set<Integer> recipeIds = view.book().catalog().stream().map(CookingUi.Recipe::id).collect(Collectors.toSet());
+        if (recipeItems.size() > MAX_RECIPE_ITEMS || !recipeItems.keySet().equals(recipeIds)) {
+            throw new IllegalArgumentException("Native cooking previews differ from the authoritative catalog");
+        }
+        final Map<Integer, Item> ownedItems = new HashMap<>();
+        for (final var entry : recipeItems.entrySet()) {
+            final Item item = entry.getValue();
+            if (item == null || item.identifier() < 0 || item.isEmpty() || item.amount() <= 0 || item.amount() > 255) {
+                throw new IllegalArgumentException("Invalid native cooking recipe preview");
+            }
+            ownedItems.put(entry.getKey(), item.copy());
+        }
+        recipeItems = Map.copyOf(ownedItems);
+        final var exported = JsonParser.parseString(program).getAsJsonObject();
+        CookingUi.fromProgram(exported);
+        final var globals = exported.getAsJsonObject("globals");
+        if (view.menuId() != menuId || !view.family().name().equals(exported.get("cooking_family").getAsString())
+                || !view.title().raw().equals(globals.get("$container_title").getAsString())
+                || view.title().localize() != globals.get("$localize_title").getAsBoolean()) {
+            throw new IllegalArgumentException("Native cooking state belongs to another presentation");
+        }
+    }
+
+    public static NativeCookingMessage create(final CookingUi ui, final CookingUi.MenuView view, final long sequence,
+                                              final long updateSequence, final long menuRevision,
+                                              final long inventoryRevision, final long cursorRevision, final Map<Integer, Item> recipeItems) {
+        return new NativeCookingMessage(view.menuId(), sequence, updateSequence, menuRevision, inventoryRevision, cursorRevision,
+                ui.exportProgram(view).toString(), GsonUtil.getGson().toJson(view), recipeItems);
+    }
+
+    @Override
+    public Map<Integer, Item> recipeItems() {
+        final Map<Integer, Item> copy = new HashMap<>();
+        this.recipeItems.forEach((id, item) -> copy.put(id, item.copy()));
+        return Map.copyOf(copy);
+    }
+
+    /** The preview has the same complete Java components as a genuine inventory item. */
+    public Item recipeItem(final int id) {
+        final Item item = this.recipeItems.get(id);
+        return item == null ? null : item.copy();
+    }
+
+    private static void writeMessage(final ByteBuf buffer, final NativeCookingMessage value, final Supplier<Type<Item>> itemType) {
+        Types.VAR_INT.writePrimitive(buffer, 1);
+        Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        Types.VAR_INT.writePrimitive(buffer, value.menuId);
+        Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+        Types.VAR_LONG.writePrimitive(buffer, value.updateSequence);
+        Types.VAR_LONG.writePrimitive(buffer, value.menuRevision);
+        Types.VAR_LONG.writePrimitive(buffer, value.inventoryRevision);
+        Types.VAR_LONG.writePrimitive(buffer, value.cursorRevision);
+        writeString(buffer, value.program);
+        writeString(buffer, value.snapshot);
+        Types.VAR_INT.writePrimitive(buffer, value.recipeItems.size());
+        for (final int id : value.recipeItems.keySet().stream().sorted().toList()) {
+            Types.VAR_INT.writePrimitive(buffer, id);
+            final ByteBuf itemBytes = Unpooled.buffer(64, MAX_PAYLOAD_BYTES);
+            try {
+                itemType.get().write(itemBytes, value.recipeItems.get(id));
+                Types.VAR_INT.writePrimitive(buffer, itemBytes.readableBytes());
+                buffer.writeBytes(itemBytes);
+            } finally {
+                itemBytes.release();
+            }
+        }
+    }
+
+    /** Decode a fresh view so consumers cannot mutate the retained wire snapshot. */
+    public CookingUi.MenuView view() {
+        return decodeView(this.snapshot);
+    }
+
+    private static CookingUi.MenuView decodeView(final String snapshot) {
+        final JsonObject value = object(JsonParser.parseString(snapshot));
+        integer(value, "menuId");
+        string(value, "family");
+        final var title = object(value.get("title"));
+        string(title, "raw");
+        bool(title, "localize");
+        final var slots = array(value, "slots");
+        for (final JsonElement entry : slots) {
+            final var slot = object(entry);
+            integer(slot, "javaSlot");
+            object(slot.get("presentation"));
+        }
+        object(value.get("cursor"));
+        final var progress = object(value.get("progress"));
+        for (final String field : new String[]{"cooking", "burning", "burnDuration", "storedExperience"}) {
+            integer(progress, field);
+        }
+        final var book = object(value.get("book"));
+        for (final String field : new String[]{"layout", "tab", "foodCount", "itemCount", "blockCount"}) {
+            integer(book, field);
+        }
+        bool(book, "forcedRecipeBookLayout");
+        bool(book, "filtering");
+        string(book, "tabLabel");
+        string(book, "searchText");
+        final var selection = object(book.get("selection"));
+        string(selection, "collection");
+        integer(selection, "index");
+        for (final JsonElement entry : array(book, "catalog")) {
+            final var recipe = object(entry);
+            integer(recipe, "id");
+            integer(recipe, "priority");
+            final int evaluation = integer(recipe, "evaluation");
+            if (evaluation < 0 || evaluation > 3) {
+                throw new IllegalArgumentException("Invalid native cooking recipe evaluation");
+            }
+            string(recipe, "uniqueId");
+            string(recipe, "outputName");
+            bool(recipe, "unlocked");
+            object(recipe.get("presentation"));
+        }
+        for (final JsonElement id : array(book, "visibleRecipes")) {
+            integer(id);
+        }
+        final var view = GsonUtil.getGson().fromJson(value, CookingUi.MenuView.class);
+        if (view == null) {
+            throw new IllegalArgumentException("Missing native cooking state");
+        }
+        return view;
+    }
+
+    private static JsonObject object(final JsonElement value) {
+        if (value == null || !value.isJsonObject()) {
+            throw new IllegalArgumentException("Missing native cooking state object");
+        }
+        return value.getAsJsonObject();
+    }
+
+    private static JsonArray array(final JsonObject value, final String field) {
+        final JsonElement elements = value.get(field);
+        if (elements == null || !elements.isJsonArray()) {
+            throw new IllegalArgumentException("Missing native cooking state collection: " + field);
+        }
+        return elements.getAsJsonArray();
+    }
+
+    private static int integer(final JsonObject value, final String field) {
+        return integer(value.get(field));
+    }
+
+    private static int integer(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("Invalid native cooking state integer");
+        }
+        try {
+            return value.getAsBigDecimal().intValueExact();
+        } catch (final ArithmeticException invalid) {
+            throw new IllegalArgumentException("Native cooking state integer is not exact", invalid);
+        }
+    }
+
+    private static void string(final JsonObject value, final String field) {
+        final JsonElement element = value.get(field);
+        if (element == null || !element.isJsonPrimitive() || !element.getAsJsonPrimitive().isString()
+                || !StandardCharsets.UTF_8.newEncoder().canEncode(element.getAsString())) {
+            throw new IllegalArgumentException("Invalid native cooking state text: " + field);
+        }
+    }
+
+    private static void bool(final JsonObject value, final String field) {
+        final JsonElement element = value.get(field);
+        if (element == null || !element.isJsonPrimitive() || !element.getAsJsonPrimitive().isBoolean()) {
+            throw new IllegalArgumentException("Invalid native cooking state flag: " + field);
+        }
+    }
+
+    private static String readString(final ByteBuf buffer) {
+        final int length = Types.VAR_INT.readPrimitive(buffer);
+        if (length < 0 || length > MAX_PAYLOAD_BYTES - HEADER_RESERVE || length > buffer.readableBytes()) {
+            throw new IllegalArgumentException("Invalid native cooking string length");
+        }
+        try {
+            final String value = StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT).onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(buffer.nioBuffer(buffer.readerIndex(), length)).toString();
+            buffer.skipBytes(length);
+            return value;
+        } catch (final CharacterCodingException error) {
+            throw new IllegalArgumentException("Invalid native cooking UTF-8", error);
+        }
+    }
+
+    private static void writeString(final ByteBuf buffer, final String value) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        Types.VAR_INT.writePrimitive(buffer, bytes.length);
+        buffer.writeBytes(bytes);
+    }
+
+}
