+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+
+/** Extracts the atlas fields consumed by the target native image metadata loader. */
+final class UiAsepriteMetadata {
+
+    private UiAsepriteMetadata() {
+    }
+
+    static JsonObject resolve(final JsonObject texture) {
+        final JsonObject empty = metadata(0, 0, new JsonArray());
+        try {
+            final JsonObject meta = object(texture.get("meta"));
+            final JsonElement image = meta.get("image");
+            if (image == null || !image.isJsonPrimitive() || !image.getAsJsonPrimitive().isString()) {
+                return empty;
+            }
+            final JsonObject size = object(meta.get("size"));
+            final float width = number(size.get("w"));
+            final float height = number(size.get("h"));
+            final JsonArray frames = new JsonArray();
+            final JsonElement sequence = texture.get("frames");
+            if (sequence != null && !sequence.isJsonNull()) {
+                if (!sequence.isJsonArray()) {
+                    return empty;
+                }
+                for (final JsonElement value : sequence.getAsJsonArray()) {
+                    final JsonObject frame = object(value);
+                    final JsonObject origin = object(frame.get("frame"));
+                    final int x = integer(origin.get("x"));
+                    final int y = integer(origin.get("y"));
+                    final int duration = integer(frame.get("duration"));
+                    if (x < 0 || y < 0 || duration <= 0) {
+                        return empty;
+                    }
+                    final JsonArray entry = new JsonArray();
+                    entry.add(x);
+                    entry.add(y);
+                    entry.add(duration);
+                    frames.add(entry);
+                }
+            }
+            return metadata(width, height, frames);
+        } catch (final IllegalArgumentException | IllegalStateException malformed) {
+            // Native loading discards the whole sequence when one required frame field is invalid.
+            return empty;
+        }
+    }
+
+    private static JsonObject metadata(final float width, final float height, final JsonArray frames) {
+        final JsonArray size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        final JsonObject result = new JsonObject();
+        result.add("size", size);
+        result.add("frames", frames);
+        return result;
+    }
+
+    private static JsonObject object(final JsonElement value) {
+        if (value == null || !value.isJsonObject()) {
+            throw new IllegalArgumentException("Invalid native atlas object");
+        }
+        return value.getAsJsonObject();
+    }
+
+    private static float number(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("Invalid native atlas number");
+        }
+        final float result = value.getAsFloat();
+        if (!Float.isFinite(result)) {
+            throw new IllegalArgumentException("Non-finite native atlas number");
+        }
+        return result;
+    }
+
+    private static int integer(final JsonElement value) {
+        number(value);
+        final double result = value.getAsDouble();
+        if (result < Integer.MIN_VALUE || result > Integer.MAX_VALUE) {
+            throw new IllegalArgumentException("Native atlas integer exceeds range");
+        }
+        return (int) result;
+    }
+
+}
