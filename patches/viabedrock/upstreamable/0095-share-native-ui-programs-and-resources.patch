+        private Map<String, JsonElement> engine(final UiBindings.Scope scope, final String collection, final boolean details) {
+            if (collection.isEmpty()) {
+                final Map<String, JsonElement> values = new HashMap<>(this.bindings.bindings(this.controllerScope(scope)));
+                if (scope != null && this.generatedCollections.containsKey(scope)) {
+                    values.put("#collection_index", new JsonPrimitive(scope.index()));
+                }
+                return values;
+            }
+            for (UiBindings.Scope candidate = scope; !details && candidate != null; candidate = candidate.parent()) {
+                if (candidate.collection().equals(collection)) {
+                    if (this.generatedCollections.containsKey(candidate)) {
