+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Sorting logic adapted from Microsoft STL, Copyright (c) Microsoft Corporation.
+ * Licensed under Apache-2.0 WITH LLVM-exception; see META-INF/licenses/Microsoft-STL.txt.
+ */
+package net.raphimc.viabedrock.api.util;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+/** The pinned native STL sort, including its ordering of comparator-equivalent entries. */
+public final class NativeSort {
+
+    private NativeSort() { }
+
+    public static <T> List<T> sorted(final List<T> entries, final Comparator<? super T> order) {
+        final List<T> result = new ArrayList<>(entries);
+        sort(result, order, 0, result.size(), result.size());
+        return List.copyOf(result);
+    }
+
+    private static <T> void sort(final List<T> entries, final Comparator<? super T> order,
+                                 int first, int last, int ideal) {
+        while (last - first > 32) {
+            if (ideal <= 0) {
+                heapSort(entries, order, first, last);
+                return;
+            }
+            final int middle = first + (last - first) / 2;
+            final int end = last - 1;
+            if (end - first > 40) {
+                final int step = (last - first) / 8;
+                median(entries, order, first, first + step, first + step * 2);
+                median(entries, order, middle - step, middle, middle + step);
+                median(entries, order, end - step * 2, end - step, end);
+                median(entries, order, first + step, middle, end - step);
+            } else {
+                median(entries, order, first, middle, end);
+            }
+            int pivotFirst = middle;
+            int pivotLast = middle + 1;
+            final T pivot = entries.get(middle);
+            while (pivotFirst > first && order.compare(entries.get(pivotFirst - 1), pivot) == 0) {
+                pivotFirst--;
+            }
+            while (pivotLast < last && order.compare(entries.get(pivotLast), pivot) == 0) {
+                pivotLast++;
+            }
+            int upper = pivotLast;
+            int lower = pivotFirst;
+            while (true) {
+                while (upper < last) {
+                    final int key = order.compare(entries.get(upper), pivot);
+                    if (key < 0) {
+                        break;
+                    }
+                    if (key == 0) {
+                        Collections.swap(entries, pivotLast++, upper);
+                    }
+                    upper++;
+                }
+                while (lower > first) {
+                    final int key = order.compare(entries.get(lower - 1), pivot);
+                    if (key > 0) {
+                        break;
+                    }
+                    if (key == 0) {
+                        Collections.swap(entries, --pivotFirst, lower - 1);
+                    }
+                    lower--;
+                }
+                if (lower == first && upper == last) {
+                    break;
+                }
+                if (lower == first) {
+                    if (pivotLast != upper) {
+                        Collections.swap(entries, pivotFirst, pivotLast);
+                    }
+                    pivotLast++;
+                    Collections.swap(entries, pivotFirst++, upper++);
+                } else if (upper == last) {
+                    Collections.swap(entries, --lower, --pivotFirst);
+                    Collections.swap(entries, pivotFirst, --pivotLast);
+                } else {
+                    Collections.swap(entries, upper++, --lower);
+                }
+            }
+            ideal = (ideal >> 1) + (ideal >> 2);
+            if (pivotFirst - first < last - pivotLast) {
+                sort(entries, order, first, pivotFirst, ideal);
+                first = pivotLast;
+            } else {
+                sort(entries, order, pivotLast, last, ideal);
+                last = pivotFirst;
+            }
+        }
+        for (int index = first + 1; index < last; index++) {
+            final T value = entries.get(index);
+            int hole = index;
+            while (hole > first && order.compare(value, entries.get(hole - 1)) < 0) {
+                entries.set(hole, entries.get(hole - 1));
+                hole--;
+            }
+            entries.set(hole, value);
+        }
+    }
+
+    private static <T> void median(final List<T> entries, final Comparator<? super T> order,
+                                   final int first, final int middle, final int last) {
+        if (order.compare(entries.get(middle), entries.get(first)) < 0) {
+            Collections.swap(entries, first, middle);
+        }
+        if (order.compare(entries.get(last), entries.get(middle)) < 0) {
+            Collections.swap(entries, middle, last);
+            if (order.compare(entries.get(middle), entries.get(first)) < 0) {
+                Collections.swap(entries, first, middle);
+            }
+        }
+    }
+
+    private static <T> void heapSort(final List<T> entries, final Comparator<? super T> order,
+                                     final int first, final int last) {
+        final int size = last - first;
+        for (int hole = size / 2; hole > 0; ) {
+            hole--;
+            reheap(entries, order, first, hole, size, entries.get(first + hole));
+        }
+        for (int remaining = size - 1; remaining > 0; remaining--) {
+            final T value = entries.get(first + remaining);
+            entries.set(first + remaining, entries.get(first));
+            reheap(entries, order, first, 0, remaining, value);
+        }
+    }
+
+    private static <T> void reheap(final List<T> entries, final Comparator<? super T> order,
+                                   final int first, int hole, final int bottom, final T value) {
+        final int top = hole;
+        final int lastParent = (bottom - 1) / 2;
+        int child = hole;
+        while (child < lastParent) {
+            child = child * 2 + 2;
+            if (order.compare(entries.get(first + child), entries.get(first + child - 1)) < 0) {
+                child--;
+            }
+            entries.set(first + hole, entries.get(first + child));
+            hole = child;
+        }
+        if (child == lastParent && bottom % 2 == 0) {
+            entries.set(first + hole, entries.get(first + bottom - 1));
+            hole = bottom - 1;
+        }
+        while (hole > top) {
+            final int parent = (hole - 1) / 2;
+            if (order.compare(entries.get(first + parent), value) >= 0) {
+                break;
+            }
+            entries.set(first + hole, entries.get(first + parent));
+            hole = parent;
+        }
+        entries.set(first + hole, value);
+    }
+
+}
