@@ -0,0 +1,93 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import io.netty.buffer.ByteBuf;
+
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/**
+ * Only a clicked source ordinal is client supplied. Items, providers and destinations remain server
+ * owned.
+ */
+public record NativeContainerAction(
+        int menuId, long sequence, int revision, Mode mode, int sourceSlot) {
+
+    public static final Type<NativeContainerAction> TYPE =
+            new Type<>(NativeContainerAction.class) {
+
+                @Override
+                public NativeContainerAction read(final ByteBuf buffer) {
+                    if (buffer.readableBytes() > 40
+                            || Types.VAR_INT.readPrimitive(buffer) != 1
+                            || Types.VAR_INT.readPrimitive(buffer)
+                                    != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                        throw new IllegalArgumentException("Unsupported native container action");
+                    }
+                    final int menuId = Types.VAR_INT.readPrimitive(buffer);
+                    final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+                    final int revision = Types.VAR_INT.readPrimitive(buffer);
+                    final Mode mode = switch (buffer.readUnsignedByte()) {
+                        case 0 -> Mode.ACTIVATE;
+                        case 1 -> Mode.DEACTIVATE;
+                        case 2 -> Mode.AUTO_PLACE_ONE;
+                        default -> throw new IllegalArgumentException("Unsupported native container action mode");
+                    };
+                    final var result =
+                            new NativeContainerAction(
+                                    menuId,
+                                    sequence,
+                                    revision,
+                                    mode,
+                                    mode == Mode.AUTO_PLACE_ONE
+                                            ? Types.VAR_INT.readPrimitive(buffer)
+                                            : -1);
+                    if (buffer.isReadable()) {
+                        throw new IllegalArgumentException(
+                                "Trailing native container action fields");
+                    }
+                    return result;
+                }
+
+                @Override
+                public void write(final ByteBuf buffer, final NativeContainerAction value) {
+                    Types.VAR_INT.writePrimitive(buffer, 1);
+                    Types.VAR_INT.writePrimitive(
+                            buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                    Types.VAR_INT.writePrimitive(buffer, value.menuId);
+                    Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+                    Types.VAR_INT.writePrimitive(buffer, value.revision);
+                    buffer.writeByte(value.mode.ordinal());
+                    if (value.mode == Mode.AUTO_PLACE_ONE) {
+                        Types.VAR_INT.writePrimitive(buffer, value.sourceSlot);
+                    }
+                }
+            };
+
+    public enum Mode {
+
+        ACTIVATE,
+        DEACTIVATE,
+        AUTO_PLACE_ONE
+    }
+
+    public NativeContainerAction {
+        if (menuId < 0
+                || menuId > 255
+                || sequence <= 0
+                || revision < 0
+                || mode == null
+                || (mode == Mode.AUTO_PLACE_ONE
+                        ? sourceSlot < 0 || sourceSlot >= 54
+                        : sourceSlot != -1)) {
+            throw new IllegalArgumentException("Invalid native container action identity");
+        }
+    }
+
+}
