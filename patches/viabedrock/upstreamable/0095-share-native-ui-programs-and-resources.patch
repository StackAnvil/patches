+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class HudRootUiTest {
+
+    @Test
+    void retainsOnlyAcceptedVisualChangesAndTheirAncestorLayout() {
+        final Map<String, byte[]> nativeFiles = Map.of("ui/hud_screen.json", bytes("""
+                {"namespace":"hud","root_panel":{"type":"panel","controls":[
+                  {"default":{"type":"label","size":[31,9]}},
+                  {"custom_host":{"type":"panel","size":[97,42],"controls":[{"unchanged":{"type":"image","size":[8,8]}}]}},
+                  {"renderer":{"type":"custom","renderer":"unsupported"}}
+                ]}}
+                """));
+        final Map<String, byte[]> accepted = Map.of("ui/hud_screen.json", bytes("""
+                {"namespace":"hud","root_panel":{"modifications":[
+                  {"array_name":"controls","operation":"insert_back","value":[{"addition":{"type":"image","size":[13,17]}}]}
+                ]}}
+                """));
+        final var program = new JsonUiProgram(nativeFiles, List.of(accepted));
+        final var root = new HudRootUi().resolve(program);
+        assertNotNull(root);
+        final var visuals = visuals(root.getAsJsonObject("root"));
+        assertEquals(1, visuals.size());
+        assertEquals(13, visuals.getFirst().getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(17, visuals.getFirst().getAsJsonArray("size").get(1).getAsInt());
+        assertNull(new HudRootUi().resolve(new JsonUiProgram(nativeFiles, List.of())));
+    }
+
+    @Test
+    void resolvesAcceptedHudNamespaceDefinitionsFromAnotherFile() {
+        final var nativeFiles = Map.of("ui/hud_screen.json", bytes("""
+                {"namespace":"hud","root_panel":{"type":"panel","controls":[
+                  {"default":{"type":"image","size":[8,8]}}
+                ]}}
+                """));
+        final var acceptedFiles = Map.of("ui/custom_hud.json", bytes("""
+                {"namespace":"hud","root_panel":{"modifications":[
+                  {"array_name":"controls","operation":"insert_back","value":[{"addition":{"type":"label","size":[23,7]}}]}
+                ]}}
+                """));
+        final var root = new HudRootUi().resolve(new JsonUiProgram(nativeFiles, List.of(acceptedFiles)));
+        assertNotNull(root);
+        final var visuals = visuals(root.getAsJsonObject("root"));
+        assertEquals(1, visuals.size());
+        assertEquals(23, visuals.getFirst().getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(7, visuals.getFirst().getAsJsonArray("size").get(1).getAsInt());
+    }
+
+    @Test
+    void excludesFactoriesAndUnknownControllersWithoutDroppingSupportedSiblings() {
+        final var program = new JsonUiProgram(List.of(Map.of("ui/hud_screen.json", bytes("""
+                {"namespace":"hud","root_panel":{"type":"panel","controls":[
+                  {"independent":{"type":"label","size":[11,5]}},
+                  {"dynamic":{"type":"label","bindings":[{"binding_name":"#unavailable_controller"}],"size":[29,8]}},
+                  {"factory":{"type":"panel","factory":{"name":"hud_title_text_factory","control_name":"hud.title"}}}
+                ]},"title":{"type":"label","size":[41,9]}}
+                """))));
+        final var root = new HudRootUi().resolve(program);
+        assertNotNull(root);
+        final var visuals = visuals(root.getAsJsonObject("root"));
+        assertEquals(1, visuals.size());
+        assertEquals(11, visuals.getFirst().getAsJsonArray("size").get(0).getAsInt());
+    }
+
+    private static byte[] bytes(final String json) {
+        return json.getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static List<JsonObject> visuals(final JsonObject root) {
+        final var result = new ArrayList<JsonObject>();
+        if (root.get("type").getAsString().equals("label") || root.get("type").getAsString().equals("image")) {
+            result.add(root);
+        }
+        if (root.has("children")) {
+            for (final var child : root.getAsJsonArray("children")) {
+                result.addAll(visuals(child.getAsJsonObject()));
+            }
+        }
+        return result;
+    }
+
+}
