+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.nio.charset.StandardCharsets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** An authored HUD scene and its native lifetime. An empty scene clears its channel. */
+public record NativeHudMessage(String scene, boolean restart, int ticks) {
+
+    public static final String CHANNEL = "viabedrock:native_hud_title";
+    public static final String ROOT_CHANNEL = "viabedrock:native_hud_root_v1";
+    public static final String ACTIONBAR_CHANNEL = "viabedrock:native_hud_actionbar_v2";
+    /** Keep a factory instance until an authored animation destroys its controls. */
+    public static final int ANIMATION_LIFETIME = -1;
+    public static final int MAX_BYTES = 1 << 20;
+    public static final Type<NativeHudMessage> TYPE = new Type<>(NativeHudMessage.class) {
+        @Override
+        public NativeHudMessage read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native HUD message");
+            }
+            final boolean restart = buffer.readBoolean();
+            final int ticks = Types.VAR_INT.readPrimitive(buffer);
+            final int length = Types.VAR_INT.readPrimitive(buffer);
+            if (length < 0 || length > MAX_BYTES || length != buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid native HUD length");
+            }
+            return new NativeHudMessage(buffer.readCharSequence(length, StandardCharsets.UTF_8).toString(), restart, ticks);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeHudMessage value) {
+            final byte[] bytes = value.scene.getBytes(StandardCharsets.UTF_8);
+            if (bytes.length > MAX_BYTES) {
+                throw new IllegalArgumentException("Native HUD exceeds payload limit");
+            }
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeBoolean(value.restart);
+            Types.VAR_INT.writePrimitive(buffer, value.ticks);
+            Types.VAR_INT.writePrimitive(buffer, bytes.length);
+            buffer.writeBytes(bytes);
+        }
+    };
+
+    public NativeHudMessage {
+        if (scene == null || scene.length() > MAX_BYTES || ticks < ANIMATION_LIFETIME || ticks > 216000) {
+            throw new IllegalArgumentException("Invalid native HUD scene");
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeItemHoverText.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeItemHoverText.java
new file mode 100644
index 000000000..8b78d4c0b
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeItemHoverText.java
@@ -0,0 +1,106 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+/** The executed native custom-name/lore branch, without guessed default item localization. */
+public final class NativeItemHoverText {
+
+    private static final int MAX_TEXT = 32768;
+
+    private NativeItemHoverText() { }
+
+    /** Null means the retained inputs require an unsupported native formatter branch. */
+    public static String custom(final boolean empty, final CompoundTag data) {
+        if (empty) {
+            return "";
+        }
+        if (data == null) {
+            return null;
+        }
+        for (final String key : data.keySet()) {
+            if (!key.equals("display") && !key.equals("minecraft:item_lock")) {
+                return null;
+            }
+        }
+        if (!(data.get("display") instanceof final CompoundTag display)
+                || !display.contains("Name")
+                || display.contains("FilteredName")) {
+            return null;
+        }
+        for (final String key : display.keySet()) {
+            if (!key.equals("Name") && !key.equals("Lore")) {
+                return null;
+            }
+        }
+        final String name =
+                display.get("Name") instanceof final StringTag value ? value.getValue() : "";
+        if (name.length() > MAX_TEXT) {
+            return null;
+        }
+        final StringBuilder text = new StringBuilder("§o§f").append(name).append("§r");
+        if (display.get("Lore") instanceof final ListTag<?> lore) {
+            if (lore.size() > 256) {
+                return null;
+            }
+            for (final var entry : lore.getValue()) {
+                final String line =
+                        entry instanceof final StringTag value
+                                ? literalRawText(value.getValue())
+                                : "";
+                if (line == null || text.length() + line.length() + 5 > MAX_TEXT) {
+                    return null;
+                }
+                text.append('\n').append("§5§o").append(line);
+            }
+        }
+        return text.toString();
+    }
+
+    private static String literalRawText(final String value) {
+        if (value.length() > MAX_TEXT) {
+            return null;
+        }
+        if (!value.stripLeading().startsWith("{")) {
+            return value;
+        }
+        try {
+            final var parsed = JsonParser.parseString(value);
+            if (!parsed.isJsonObject() || !parsed.getAsJsonObject().has("rawtext")) {
+                return value;
+            }
+            final var raw = parsed.getAsJsonObject().get("rawtext");
+            if (!raw.isJsonArray()) {
+                return null;
+            }
+            final StringBuilder result = new StringBuilder();
+            for (final var element : raw.getAsJsonArray()) {
+                if (!element.isJsonObject()) {
+                    return null;
+                }
+                final var component = element.getAsJsonObject();
+                if (component.size() != 1
+                        || !component.has("text")
+                        || !component.get("text").isJsonPrimitive()
+                        || !component.get("text").getAsJsonPrimitive().isString()) {
+                    return null;
+                }
+                result.append(component.get("text").getAsString());
+                if (result.length() > MAX_TEXT) {
+                    return null;
+                }
+            }
+            return result.toString();
+        } catch (final RuntimeException malformed) {
+            return value;
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeNpcDialogueMessage.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeNpcDialogueMessage.java
