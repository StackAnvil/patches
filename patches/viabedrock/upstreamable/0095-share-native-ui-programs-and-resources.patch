+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.UnaryOperator;
+
+final class NpcEditorBindings implements UiBindings {
+
+    private static final Set<String> COMMANDS =
+            Set.of(
+                    "button.dialog_button",
+                    "button.advanced_settings",
+                    "button.exit_student_edit",
+                    "button.exit_advanced",
+                    "button.exit_maximized",
+                    "button.exit_basic",
+                    "button.menu_continue",
+                    "button.menu_exit",
+                    "button.cycle_pack_left",
+                    "button.cycle_pack_right",
+                    "button.view_skin",
+                    "button.add_command",
+                    "button.add_url",
+                    "button.delete_action",
+                    "button.expand_action_edit",
+                    "button_mode_toggle",
+                    "on_enter_toggle",
+                    "on_exit_toggle");
+    private final NpcEditorState state;
+    private final Map<String, JsonElement> globals = new HashMap<>();
+    private final List<Map<String, JsonElement>> actions = new ArrayList<>();
+    private final List<Map<String, JsonElement>> skins = new ArrayList<>();
+
+    NpcEditorBindings(final NpcEditorState state, final UnaryOperator<String> translate) {
+        this.state = state;
+        final var view = state.view();
+        this.put(
+                "#title_text",
+                view == NpcEditorState.View.BASIC
+                        ? translate.apply("npcscreen.basictitle")
+                        : view == NpcEditorState.View.ADVANCED
+                                ? translate.apply("npcscreen.advancedtitle")
+                                : state.name());
+        this.put("#name_text", state.name());
+        this.put("#dialogtext", state.dialogue());
+        this.put("#placeholder_dialog_text", translate.apply("npcscreen.addtext"));
+        this.put("#skin_index", state.skin());
+        this.put("#basic_visible", view == NpcEditorState.View.BASIC);
+        this.put("#advanced_visible", view == NpcEditorState.View.ADVANCED);
+        this.put("#teacher_view_visible", view != NpcEditorState.View.DIALOGUE);
+        this.put("#student_view_visible", view == NpcEditorState.View.DIALOGUE);
+        this.put("#maximized_edit_visible", view == NpcEditorState.View.MAXIMIZED);
+        this.put(
+                "#maximized_action_text",
+                view == NpcEditorState.View.MAXIMIZED ? state.maximizedText() : "");
+        this.put(
+                "#maximized_placeholder_text",
+                translate.apply(
+                        view == NpcEditorState.View.MAXIMIZED
+                                ? state.placeholderKey(state.maximizedInput())
+                                : ""));
+        this.put("#commands_enabled", state.commandsEnabled());
+        this.put("#add_buttons_enabled", state.count() < 256);
+        this.put("#action_count", state.count());
+        this.put("#help_visible", state.count() == 0);
+        this.put(
+                "#cycle_pack_left_button_visible",
+                state.appearance().getAsJsonArray("skin_list").size() > 5);
+        this.put(
+                "#cycle_pack_right_button_visible",
+                state.appearance().getAsJsonArray("skin_list").size() > 5);
+        this.put("#student_model_update", true);
+        this.put("$is_worldbuilder", true);
+        this.put("$education_edition", state.education());
+        for (final String binding
+            :
+                List.of(
+                        "#im_reader_button_visible",
+                        "#tts_enabled",
+                        "#is_using_gamepad",
+                        "$is_console")) {
+            this.put(binding, false);
+        }
+        final JsonArray dimensions = new JsonArray();
+        dimensions.add(5);
+        dimensions.add(1);
+        this.globals.put("#skins_grid_dimensions", dimensions);
+        final JsonArray buttons = new JsonArray();
+        buttons.add(3);
+        buttons.add(0);
+        this.globals.put("#student_button_grid_dimensions", buttons);
+        for (int index = 0; index < state.count(); index++) {
+            final var action = state.action(index);
+            final Map<String, JsonElement> values = new HashMap<>();
+            final int type = action.get("type").getAsInt();
+            final int mode = action.get("mode").getAsInt();
+            values.put("#action_text", new JsonPrimitive(JsonUiProgram.string(action, "text")));
+            values.put(
+                    "#button_name_text",
+                    new JsonPrimitive(JsonUiProgram.string(action, "button_name")));
+            values.put("#button_name_edit_visible", new JsonPrimitive(type == 0 || mode == 0));
+            values.put("#is_url_action", new JsonPrimitive(type == 0));
+            values.put("#is_command_action", new JsonPrimitive(type == 1));
+            values.put("#button_mode_enabled", new JsonPrimitive(mode == 0));
+            values.put("#on_enter_enabled", new JsonPrimitive(mode == 2));
+            values.put("#on_exit_enabled", new JsonPrimitive(mode == 1));
+            values.put(
+                    "#action_error_status",
+                    new JsonPrimitive(
+                            type == 0 ? urlStatus(JsonUiProgram.string(action, "text")) : ""));
+            final String identity = "npc_action_" + state.actionInput(index, false);
+            for (final String field
+                :
+                    List.of(
+                            "#command_identifier",
+                            "#button_name_identifier",
+                            "#button_mode_identifier")) {
+                values.put(field, new JsonPrimitive(identity + field));
+            }
+            for (final String field
+                :
+                    List.of(
+                            "#add_command_focus_override_up",
+                            "#command_focus_override_down",
+                            "#button_name_focus_override_up",
+                            "#button_mode_focus_override_up")) {
+                values.put(field, new JsonPrimitive(""));
+            }
+            this.actions.add(Map.copyOf(values));
+        }
+        final int count = state.appearance().getAsJsonArray("skin_list").size();
+        for (int index = state.page() * 5; index < Math.min(count, state.page() * 5 + 5); index++) {
+            this.skins.add(
+                    Map.of(
+                            "#skin_index",
+                            new JsonPrimitive(index),
+                            "#skin_visible",
+                            new JsonPrimitive(index == state.skin())));
+        }
+    }
+
+    private void put(final String key, final String value) {
+        this.globals.put(key, new JsonPrimitive(value));
+    }
+
+    private void put(final String key, final boolean value) {
+        this.globals.put(key, new JsonPrimitive(value));
+    }
+
+    private void put(final String key, final int value) {
+        this.globals.put(key, new JsonPrimitive(value));
+    }
+
+    private static String urlStatus(final String value) {
+        if (value.isBlank()) {
+            return "EmptyUri";
+        }
+        try {
+            final var uri = URI.create(value.trim());
+            return uri.getHost() != null
+                            && Set.of("http", "https")
+                                    .contains(uri.getScheme().toLowerCase(java.util.Locale.ROOT))
+                    ? ""
+                    : "InvalidUri";
+        } catch (final RuntimeException invalid) {
+            return "InvalidUri";
+        }
+    }
+
+    @Override
+    public Map<String, JsonElement> globals() {
+        return Map.copyOf(this.globals);
+    }
+
+    @Override
+    public String defaultCollection() {
+        return "actions_collection";
+    }
+
+    @Override
+    public String factoryKey() {
+        return "";
+    }
+
+    @Override
+    public Collection collection(final String name, final Scope parent) {
+        final var entries =
+            switch (name) {
+                case "actions_collection" -> this.actions;
+                case "skins_collection" -> this.skins;
+                case "student_buttons_collection" -> List.<Map<String, JsonElement>>of();
+                default ->
+                            throw new IllegalArgumentException(
+                                    "Unsupported NPC editor collection " + name);
+            };
+        return new Collection(
+                entries, Map.of("#collection_length", new JsonPrimitive(entries.size())));
+    }
+
+    @Override
+    public Map<String, JsonElement> variables(final Scope scope) {
+        return scope == null
+                ? Map.of()
+                : this.collection(scope.collection(), scope.parent()).entries().get(scope.index());
+    }
+
+    @Override
+    public Map<String, JsonElement> bindings(final Scope scope) {
+        final Map<String, JsonElement> result = new HashMap<>(this.globals);
+        result.putAll(this.variables(scope));
+        return result;
+    }
+
+    private static int index(final Scope scope, final String name) {
+        for (var selected = scope; selected != null; selected = selected.parent()) {
+            if (selected.collection().equals(name)) {
+                return selected.index();
+            }
+        }
+        return -1;
+    }
+
+    @Override
+    public void decorate(
+            final JsonObject node,
+            final JsonObject control,
+            final Map<String, JsonElement> values,
+            final Scope scope) {
+        if ("actor_portrait_renderer".equals(JsonUiProgram.string(node, "renderer"))) {
+            final var portrait = new JsonObject();
+            portrait.add("unique_id", this.state.source().get("unique_id"));
+            portrait.add("actor_data", this.state.appearance());
+            portrait.addProperty(
+                    "offsets",
+                    index(scope, "skins_collection") >= 0 ? "picker_offsets" : "portrait_offsets");
+            final int skinIndex = values.get("#skin_index").getAsBigDecimal().intValueExact();
+            portrait.addProperty("skin_index", skinIndex);
+            portrait.add(
+                    "variant",
+                    this.state
+                            .appearance()
+                            .getAsJsonArray("skin_list")
+                            .get(skinIndex)
+                            .getAsJsonObject()
+                            .get("variant"));
+            node.add("actor_portrait", portrait);
+        }
+        final int action = index(scope, "actions_collection");
+        final String type = JsonUiProgram.string(node, "type");
+        if (type.equals("edit_box")) {
+            final String binding =
+                    UiExpression.text(values.get("$text_edit_box_content_binding_name"));
+            final int input =
+                switch (binding) {
+                    case "#name_text" -> 0;
+                    case "#dialogtext" -> 1;
+                    case "#action_text" ->
+                        action < 0 ? -1 : this.state.actionInput(action, false);
+                    case "#button_name_text" ->
+                        action < 0 ? -1 : this.state.actionInput(action, true);
+                    case "#maximized_action_text" ->
+                        this.state.view() == NpcEditorState.View.MAXIMIZED
+                                        ? this.state.maximizedInput()
+                                        : -1;
+                    default -> -1;
+                };
+            if (input >= 0) {
+                final var descriptor = new JsonObject();
+                descriptor.addProperty("index", input);
+                descriptor.addProperty("type", "input");
+                node.add("input", descriptor);
+            }
+        }
+        if (!Set.of("button", "toggle").contains(type)) {
+            return;
+        }
+        String target =
+                UiExpression.text(
+                        JsonUiProgram.resolveValue(
+                                new JsonPrimitive(
+                                        type.equals("toggle")
+                                                ? "$toggle_name"
+                                                : "$pressed_button_name"),
+                                values,
+                                0));
+        if (!COMMANDS.contains(target) && node.has("button_mappings")) {
+            for (final var entry : node.getAsJsonArray("button_mappings")) {
+                final String mapped =
+                        UiExpression.text(
+                                JsonUiProgram.resolveValue(
+                                        entry.getAsJsonObject().get("to_button_id"), values, 0));
+                if (COMMANDS.contains(mapped)) {
+                    target = mapped;
+                    break;
+                }
+            }
+        }
+        if (COMMANDS.contains(target)) {
+            node.addProperty("command", target);
+            if (target.equals("button.view_skin")) {
+                node.add(
+                        "selection",
+                        this.skins.get(index(scope, "skins_collection")).get("#skin_index"));
+            } else if (action >= 0) {
+                node.addProperty("selection", action);
+            }
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorState.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorState.java
