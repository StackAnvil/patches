+    public JsonObject export(final Set<String> used, final JsonElement controller) {
+        final Set<String> closure = new LinkedHashSet<>(used);
+        final List<String> pending = new ArrayList<>(used);
+        for (int index = 0; index < pending.size(); index++) {
+            final String name = pending.get(index);
+            final Definition definition = this.definitions.get(name);
+            if (definition == null) {
+                continue;
+            }
+            final Set<String> referenced = new LinkedHashSet<>();
+            referenced.add(definition.parent);
+            this.definitions.keySet().stream().filter(candidate -> candidate.startsWith(name + "/")).forEach(referenced::add);
+            this.references(definition.value, name.substring(0, name.indexOf('.')), referenced);
+            for (final String reference : referenced) {
+                if (this.definitions.containsKey(reference) && closure.add(reference)) {
+                    pending.add(reference);
+                }
+            }
+            if (closure.size() > MAX_NODES) {
+                throw new IllegalArgumentException("UI definition closure exceeds limits");
+            }
+        }
+        final JsonObject result = new JsonObject();
+        final JsonObject definitions = new JsonObject();
+        for (final var entry : this.definitions.entrySet()) {
+            if (closure.contains(entry.getKey())) {
+                final Definition definition = entry.getValue();
+                final JsonObject value = new JsonObject();
+                value.add("value", definition.value.deepCopy());
+                value.addProperty("parent", definition.parent);
+                definitions.add(entry.getKey(), value);
+            }
+        }
+        result.add("definitions", definitions);
+        final JsonObject translations = new JsonObject();
+        this.translations(definitions, translations);
+        this.translations(controller, translations);
+        translations.addProperty("gui.submit", this.translator.apply("gui.submit"));
+        translations.addProperty("gui.close", this.translator.apply("gui.close"));
+        translations.addProperty("options.sliderLabelFormat", this.translator.apply("options.sliderLabelFormat"));
+        result.add("translations", translations);
+        final JsonObject colors = new JsonObject();
+        this.formattingColors.forEach((key, value) -> colors.addProperty(key.toString(), value));
+        result.add("formatting_colors", colors);
+        final JsonObject globals = new JsonObject();
+        this.globals.forEach((key, value) -> globals.add(key, value.deepCopy()));
+        result.add("globals", globals);
+        final JsonObject metadata = new JsonObject();
+        this.textureFiles.forEach((key, value) -> {
+            if (key.endsWith(".json")) {
+                metadata.add(key, JsonParser.parseString(new String(value, StandardCharsets.UTF_8)));
+            }
+        });
+        result.add("texture_metadata", metadata);
+        final JsonObject fonts = new JsonObject();
+        this.fonts.ids().forEach(fonts::addProperty);
+        result.add("font_ids", fonts);
+        final JsonObject lineHeights = new JsonObject();
+        this.fonts.lineHeights().forEach(lineHeights::addProperty);
+        result.add("font_line_heights", lineHeights);
+        return result;
+    }
+
+    private void translations(final JsonElement value, final JsonObject translated) {
+        if (value.isJsonObject()) {
+            value.getAsJsonObject().entrySet().forEach(entry -> this.translations(entry.getValue(), translated));
+        } else if (value.isJsonArray()) {
+            value.getAsJsonArray().forEach(entry -> this.translations(entry, translated));
+        } else if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+            final String key = value.getAsString();
+            if (!key.isEmpty() && !"$#@(".contains(key.substring(0, 1))) {
+                final String text = this.translator.apply(key);
+                if (!text.equals(key)) {
+                    translated.addProperty(key, text);
+                }
+            }
+        }
+    }
+
+    private void references(final JsonElement value, final String namespace, final Set<String> result) {
+        if (value.isJsonObject()) {
+            value.getAsJsonObject().entrySet().forEach(entry -> {
+                final String[] key = entry.getKey().split("@", 2);
+                if (key.length == 2) {
+                    result.add(key[1].contains(".") ? key[1] : namespace + "." + key[1]);
+                }
+                this.references(entry.getValue(), namespace, result);
+            });
+        } else if (value.isJsonArray()) {
+            value.getAsJsonArray().forEach(entry -> this.references(entry, namespace, result));
+        } else if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+            final String reference = value.getAsString();
+            final String name = reference.substring(reference.lastIndexOf('@') + 1);
+            if (this.definitions.containsKey(name)) {
+                result.add(name);
+            }
+            if (!name.contains(".") && this.definitions.containsKey(namespace + "." + name)) {
+                result.add(namespace + "." + name);
+            }
+        }
+    }
+
+    private void loadFiles(final Map<String, byte[]> files, final boolean server) {
+        for (final Map.Entry<String, byte[]> file : files.entrySet()) {
+            if (!safePath(file.getKey()) || file.getValue().length > MAX_FILE_BYTES || !file.getKey().endsWith(".json")) {
+                continue;
+            }
+            try {
+                final JsonElement parsed = JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8));
+                if (!parsed.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject document = parsed.getAsJsonObject();
+                if (file.getKey().equals("ui/_global_variables.json")) {
+                    document.entrySet().forEach(entry -> this.globals.put(entry.getKey(), entry.getValue()));
+                    continue;
+                }
+                final String namespace = string(document, "namespace");
+                if (namespace.isEmpty() || namespace.length() > 128) {
+                    continue;
+                }
+                for (final Map.Entry<String, JsonElement> entry : document.entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        continue;
+                    }
+                    this.loadDefinition(namespace, entry.getKey(), entry.getValue().getAsJsonObject(), server);
+                }
+                if (server) {
+                    this.customizedFiles.add(file.getKey());
+                }
+            } catch (final RuntimeException malformed) {
+                // A malformed unrelated UI file cannot activate an unused control.
+            }
+        }
+    }
+
+    private void loadDefinition(final String namespace, final String reference, final JsonObject declaration,
+                                final boolean server) {
+        final String[] name = reference.split("@", 2);
+        final String identity = namespace + "." + name[0];
+        final String parent = name.length == 2 ? (name[1].contains(".") ? name[1] : namespace + "." + name[1]) : null;
+        overlayDefinition(this.definitions, identity, parent, declaration);
+        if (!server) {
+            overlayDefinition(this.nativeDefinitions, identity, parent, declaration);
+        }
+    }
+
+    private static void overlayDefinition(final Map<String, Definition> definitions, final String identity,
+                                          final String parent, final JsonObject declaration) {
+        final Definition lower = definitions.get(identity);
+        if (lower == null && definitions.size() >= MAX_NODES) {
+            throw new IllegalArgumentException("Too many UI definitions");
+        }
+        final JsonObject value = lower == null ? new JsonObject() : lower.value.deepCopy();
+        merge(value, declaration);
+        definitions.put(identity, new Definition(value, parent != null ? parent : lower == null ? "" : lower.parent));
+    }
+
+    private List<String> definitionPaths(final String name) {
+        final List<String> paths = new ArrayList<>();
+        final Set<String> visited = new HashSet<>();
+        String current = name;
+        // Native inheritance stops at visited declarations, including self references.
+        while (this.definitions.containsKey(current) && visited.add(current)) {
+            paths.add(current);
+            current = this.definitions.get(current).parent;
+        }
+        Collections.reverse(paths);
+        return paths;
+    }
+
+    private JsonObject template(final String name, final Set<String> required) {
+        if (this.templates == null) {
+            this.templates = inheritDefinitions(this.definitions);
+        }
+        if (required != null) {
+            required.addAll(this.definitionPaths(name));
+        }
+        return templateCopy(this.templates.get(name));
+    }
+
+    private static Map<String, JsonObject> inheritDefinitions(final Map<String, Definition> definitions) {
+        final Map<String, JsonObject> resolved = new LinkedHashMap<>();
+        for (final var entry : definitions.entrySet()) {
+            final JsonObject value = entry.getValue().value.deepCopy();
+            final Set<String> visited = new HashSet<>();
+            visited.add(entry.getKey());
+            String parent = entry.getValue().parent;
+            while (definitions.containsKey(parent) && visited.add(parent)) {
+                final Definition ancestor = definitions.get(parent);
+                final JsonObject inherited = resolved.getOrDefault(parent, ancestor.value);
+                for (final var member : inherited.entrySet()) {
+                    if (!member.getValue().isJsonNull() && !value.has(member.getKey())) {
+                        value.add(member.getKey(), member.getValue().deepCopy());
+                    }
+                }
+                // Native finalization reuses earlier completed declarations, including their nulls.
+                if (resolved.containsKey(parent)) {
+                    break;
+                }
+                parent = ancestor.parent;
+            }
+            resolved.put(entry.getKey(), value);
+        }
+        return Map.copyOf(resolved);
+    }
+
+    private static JsonObject templateCopy(final JsonObject definition) {
+        if (definition == null) {
+            return null;
+        }
+        final JsonObject result = definition.deepCopy();
+        applyModifications(result);
+        return result;
+    }
+
+    private static void merge(final JsonObject target, final JsonObject source) {
+        for (final Map.Entry<String, JsonElement> entry : source.entrySet()) {
+            // Native controls arrays replace their inherited array. They are not concatenated.
+            target.add(entry.getKey(), entry.getValue().deepCopy());
+        }
+    }
+
+    private static void applyModifications(final JsonObject control) {
+        final JsonArray modifications = control.getAsJsonArray("modifications");
+        if (modifications == null) {
+            return;
+        }
+        for (final JsonElement entry : modifications) {
+            final JsonObject modification = entry.getAsJsonObject();
+            final String name = string(modification, "array_name");
+            final String operation = string(modification, "operation");
+            if (!operation.equals("insert_back") && !operation.equals("insert_front")) {
+                throw new IllegalArgumentException("Unsupported UI array modification: " + operation);
+            }
+            final JsonArray inherited = control.has(name) ? control.getAsJsonArray(name) : new JsonArray();
+            final JsonElement value = modification.get("value");
+            final List<JsonElement> inserted = value.isJsonArray() ? value.getAsJsonArray().asList() : List.of(value);
+            if (inherited.size() + inserted.size() > MAX_NODES) {
+                throw new IllegalArgumentException("UI array modification exceeds limits");
+            }
+            final JsonArray result = new JsonArray();
+            if (operation.equals("insert_front")) {
+                inserted.forEach(item -> result.add(item.deepCopy()));
+            }
+            inherited.forEach(item -> result.add(item.deepCopy()));
+            if (operation.equals("insert_back")) {
+                inserted.forEach(item -> result.add(item.deepCopy()));
+            }
+            control.add(name, result);
+        }
+        control.remove("modifications");
+    }
+
+    private static void declarations(final JsonObject control, final Map<String, JsonElement> values) {
+        for (final Map.Entry<String, JsonElement> entry : control.entrySet()) {
+            if (entry.getKey().startsWith("$")) {
+                final String key = entry.getKey();
+                if (entry.getValue().isJsonPrimitive() && key.equals(entry.getValue().getAsString())) {
+                    continue; // A self-forwarding declaration retains its enclosing exact value or default.
+                }
+                // Keep defaults separate: an exact value in any enclosing scope takes precedence.
+                values.put(key, entry.getValue());
+            }
+        }
+        if (control.has("variables")) {
+            final JsonElement variableSets = control.get("variables");
+            final List<JsonElement> sets = variableSets.isJsonArray() ? variableSets.getAsJsonArray().asList() : List.of(variableSets);
+            for (final JsonElement set : sets) {
+                final JsonObject variables = set.getAsJsonObject();
+                if (!variables.has("requires") || UiExpression.truth(resolveValue(variables.get("requires"), values, 0))) {
+                    variables.entrySet().stream().filter(entry -> entry.getKey().startsWith("$"))
+                            .forEach(entry -> values.put(entry.getKey(), entry.getValue()));
+                }
