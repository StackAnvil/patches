+
+    private static ContainerUi ui() {
+        return new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", UI.getBytes(StandardCharsets.UTF_8)))));
+    }
+
+    private static ContainerUi.MenuView menu(final ContainerUi.Kind kind, final String title, final int amount) {
+        final int external = kind.containerSlots();
+        final List<ContainerUi.Slot> slots = new ArrayList<>();
+        for (int index = 0; index < external + 36; index++) {
+            slots.add(new ContainerUi.Slot(index, Map.of("#inventory_stack_count", new JsonPrimitive(index == 0 ? amount : index),
+                    "#item_durability_visible", new JsonPrimitive(index == 0), "#item_durability_total_amount", new JsonPrimitive(100),
+                    "#item_durability_current_amount", new JsonPrimitive(index == 0 ? 45 : 100))));
+        }
+        Collections.reverse(slots);
+        return new ContainerUi.MenuView(7, kind, title, slots, Map.of("#inventory_selected_item_stack_count", new JsonPrimitive(3)), kind.initialData());
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void bundledStorageFamiliesRetainActualSlotBindingsAcrossTransport() {
+        org.junit.jupiter.api.Assumptions.assumeTrue(
+                ContainerUi.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var ui = new ResourcePackStorage(List.of()).getContainerUi();
+        for (final var kind : ContainerUi.Kind.values()) {
+            final var view = menu(kind, "Container", 16);
+            final var exported = ui.exportProgram(kind, new ContainerUi.Title(view.title(), false));
+            assertNotNull(exported, kind.name());
+            final var scene = ui.resolveScene(view);
+            assertNotNull(scene, kind.name());
+            assertTrue(scene.getAsJsonArray("missing_templates").isEmpty(), kind.name());
+            final Set<Integer> slots = nodes(scene.getAsJsonObject("root")).stream()
+                    .filter(node -> node.has("inventory_slot"))
+                    .map(node -> node.get("inventory_slot").getAsInt())
+                    .collect(java.util.stream.Collectors.toSet());
+            assertEquals(java.util.stream.IntStream.range(0, kind.containerSlots() + 36)
+                    .boxed().collect(java.util.stream.Collectors.toSet()), slots, kind.name());
+            assertEquals(scene, ContainerUi.fromProgram(exported).resolveScene(view), kind.name());
+        }
+    }
+
+    @Test
+    void brewingBindsFixedAndIndexedSlotsAndRefreshesNativeImageIndicators() {
+        org.junit.jupiter.api.Assumptions.assumeTrue(
+                ContainerUi.class.getResource("/assets/viabedrock/builtin_ui.zip") != null);
+        final var ui = new ResourcePackStorage(List.of()).getContainerUi();
+        final var initial = menu(ContainerUi.Kind.BREWING_STAND, "Brewing", 0);
+        final var scene = ui.resolveScene(new ContainerUi.MenuView(initial.menuId(), initial.kind(), initial.title(),
+                initial.slots(), initial.cursor(), List.of(200, 19, 20)));
+        final var controls = nodes(scene.getAsJsonObject("root"));
+        final var indicators = controls.stream().filter(node -> node.has("clip_ratio"))
+                .collect(java.util.stream.Collectors.toMap(node -> node.get("name").getAsString(),
+                        node -> node.get("clip_ratio").getAsFloat()));
+        assertEquals(.5F, indicators.get("brewing_arrow_full_image"));
+        assertEquals(9F / 29F, indicators.get("bubbles_full_image"));
+        assertEquals(1F / 22F, indicators.get("brewing_fuel_bar_full_image"));
+        final var fixed = controls.stream().filter(node -> node.has("inventory_actions")
+                        && Set.of("brewing_input_item", "brewing_fuel_item").contains(node.get("collection").getAsString()))
+                .map(node -> node.get("inventory_slot").getAsInt()).collect(java.util.stream.Collectors.toSet());
+        assertEquals(Set.of(3, 4), fixed);
+        final var bottles = controls.stream().filter(node -> "item_cell_overlay_ref".equals(JsonUiProgram.string(node, "name"))
+                        && "brewing_result_items".equals(JsonUiProgram.string(node, "collection")))
+                .collect(java.util.stream.Collectors.toMap(node -> node.get("inventory_slot").getAsInt(),
+                        node -> node.get("visible").getAsBoolean()));
+        assertEquals(Map.of(0, true, 1, false, 2, false), bottles);
+        final var idle = nodes(ui.resolveScene(initial).getAsJsonObject("root"));
+        idle.stream().filter(node -> node.has("clip_ratio")).forEach(node -> assertEquals(1F, node.get("clip_ratio").getAsFloat()));
+    }
+
+    @Test
+    void sharedFormBindingsDoNotInventRowsOrHideInventoryActions() {
+        final String shared = UI.replace("\"cell\":{\"type\":\"button\",", """
+                "cell":{"type":"button","bindings":[
+                  {"binding_type":"collection_details","binding_collection_name":"form_buttons"},
+                  {"binding_type":"collection","binding_collection_name":"custom_form",
+                   "binding_name":"#custom_toggle_state","binding_name_override":"#unused_form_state"}],
+                """.strip());
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", shared.getBytes(StandardCharsets.UTF_8)))));
+        final var view = menu(ContainerUi.Kind.CHEST_3_ROWS, "Shared controls", 16);
+        final var scene = ui.resolveScene(view);
+        final var controls = nodes(scene.getAsJsonObject("root"));
+        final var slots = controls.stream().filter(node -> node.has("inventory_actions"))
