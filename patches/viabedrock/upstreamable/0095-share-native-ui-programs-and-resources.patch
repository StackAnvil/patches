+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.nio.charset.StandardCharsets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** A resolved resource-pack form uses the ordinary form response identifier and original indices. */
+public record NativeFormMessage(int formId, String scene) {
+
+    public static final String CHANNEL = "viabedrock:native_form";
+    public static final String CUSTOM_CHANNEL = "viabedrock:native_custom_form";
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    public static final Type<NativeFormMessage> TYPE = new Type<>(NativeFormMessage.class) {
+        @Override
+        public NativeFormMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES + 32
+                    || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native form message");
+            }
+            final int id = Types.VAR_INT.readPrimitive(buffer);
+            final int length = Types.VAR_INT.readPrimitive(buffer);
+            if (length < 0 || length > MAX_PAYLOAD_BYTES || length != buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid native form scene length");
+            }
+            return new NativeFormMessage(id, buffer.readCharSequence(length, StandardCharsets.UTF_8).toString());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeFormMessage value) {
+            final byte[] bytes = value.scene.getBytes(StandardCharsets.UTF_8);
+            if (bytes.length > MAX_PAYLOAD_BYTES) {
+                throw new IllegalArgumentException("Native form exceeds the payload limit");
+            }
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.formId);
+            Types.VAR_INT.writePrimitive(buffer, bytes.length);
+            buffer.writeBytes(bytes);
+        }
+    };
+
+    public NativeFormMessage {
+        if (scene == null || scene.length() > MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("Invalid native form scene");
+        }
+    }
+
+}
