+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeCookingActionTest {
+
+    @Test
+    void snapshotIdentitiesRoundTripWithoutNarrowingAndRejectIncompleteEnvelopes() {
+        for (final var mode : NativeCookingAction.Mode.values()) {
+            for (final int phase : new int[]{0, 1, 2}) {
+                for (final var action : List.of(new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, mode, 1, phase, 1),
+                        new NativeCookingAction(255, Long.MAX_VALUE, Long.MAX_VALUE, Long.MAX_VALUE,
+                                Long.MAX_VALUE, Long.MAX_VALUE, Integer.MAX_VALUE, mode, 1, phase, Long.MAX_VALUE))) {
+                    final var wire = Unpooled.buffer();
+                    try {
+                        NativeCookingAction.TYPE.write(wire, action);
+                        for (int length = 0; length < wire.readableBytes(); length++) {
+                            final var partial = wire.copy(0, length);
+                            try {
+                                assertThrows(RuntimeException.class, () -> NativeCookingAction.TYPE.read(partial));
+                            } finally {
+                                partial.release();
+                            }
+                        }
+                        final var valid = wire.copy();
+                        try {
+                            assertEquals(action, NativeCookingAction.TYPE.read(valid));
+                            assertFalse(valid.isReadable());
+                        } finally {
+                            valid.release();
+                        }
+                        wire.writeByte(0);
+                        assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+                        wire.readerIndex(0);
+                        wire.writerIndex(wire.writerIndex() - 1);
+                        for (final int previousVersion : new int[]{3, 4}) {
+                            wire.readerIndex(0);
+                            wire.setByte(0, previousVersion);
+                            assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+                        }
+                        wire.clear();
+                        Types.VAR_INT.writePrimitive(wire, 5);
+                        Types.VAR_INT.writePrimitive(wire, 0);
+                        assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+                        wire.clear();
+                        wire.writeZero(NativeCookingAction.MAX_ENCODED_BYTES + 1);
+                        assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+                    } finally {
+                        wire.release();
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void rejectsActionsWithoutNativeEventPhase() {
+        final var wire = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(wire, 3);
+            Types.VAR_INT.writePrimitive(wire, net.raphimc.viabedrock.protocol.data.ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(wire, 0);
+            for (final long field : new long[]{1, 1, 0, 0, 0}) {
+                Types.VAR_LONG.writePrimitive(wire, field);
+            }
+            Types.VAR_INT.writePrimitive(wire, 0);
+            wire.writeByte(0);
+            Types.VAR_LONG.writePrimitive(wire, 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+        } finally {
+            wire.release();
+        }
+    }
+
+    @Test
+    void invalidWireIdentitiesNeverBecomeSelections() {
+        for (final long[] identity : List.of(new long[]{-1, 1, 1, 0, 0, 0, 0, 1},
+                new long[]{256, 1, 1, 0, 0, 0, 0, 1}, new long[]{0, 0, 1, 0, 0, 0, 0, 1},
+                new long[]{0, 1, 0, 0, 0, 0, 0, 1}, new long[]{0, 1, 1, -1, 0, 0, 0, 1},
+                new long[]{0, 1, 1, 0, -1, 0, 0, 1}, new long[]{0, 1, 1, 0, 0, -1, 0, 1},
+                new long[]{0, 1, 1, 0, 0, 0, -1, 1},
+                new long[]{0, 1, 1, 0, 0, 0, 0, 0}, new long[]{0, 1, 1, 0, 0, 0, 0, -1})) {
+            final var wire = Unpooled.buffer();
+            try {
+                Types.VAR_INT.writePrimitive(wire, 5);
+                Types.VAR_INT.writePrimitive(wire, net.raphimc.viabedrock.protocol.data.ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                Types.VAR_INT.writePrimitive(wire, (int) identity[0]);
+                for (int field = 1; field < 6; field++) {
+                    Types.VAR_LONG.writePrimitive(wire, identity[field]);
+                }
+                Types.VAR_INT.writePrimitive(wire, (int) identity[6]);
+                wire.writeByte(0);
+                wire.writeByte(1);
+                wire.writeByte(0);
+                Types.VAR_LONG.writePrimitive(wire, identity[7]);
+                assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+            } finally {
+                wire.release();
+            }
+        }
+    }
+
+    @Test
+    void unknownEventPhasesCannotBecomeSelections() {
+        final var action = new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, NativeCookingAction.Mode.PRIMARY, 1, 0, 1);
+        for (final int phase : new int[]{3, 255}) {
+            final var wire = Unpooled.buffer();
+            try {
+                NativeCookingAction.TYPE.write(wire, action);
+                wire.setByte(wire.writerIndex() - 2, phase);
+                assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+            } finally {
+                wire.release();
+            }
+        }
+        for (final int phase : new int[]{-1, 3, 256}) {
+            assertThrows(IllegalArgumentException.class,
+                    () -> new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, NativeCookingAction.Mode.PRIMARY, 1, phase, 1));
+        }
+    }
+
+    @Test
+    void unknownCommandsCannotBecomePrimaryActions() {
+        final var action = new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, NativeCookingAction.Mode.PRIMARY, 1, 0, 1);
+        for (final int mode : new int[]{3, 255}) {
+            final var wire = Unpooled.buffer();
+            try {
+                NativeCookingAction.TYPE.write(wire, action);
+                wire.setByte(wire.writerIndex() - 4, mode);
+                assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+            } finally {
+                wire.release();
+            }
+        }
+        assertThrows(IllegalArgumentException.class, () -> new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, null, 1, 0, 1));
+    }
+
+    @Test
+    void controllerModesStayDistinctFromCommandsAndRejectUnknownValues() {
+        for (final int context : new int[]{0, 1, 2, 3}) {
+            final var action = new NativeCookingAction(0, 1, 1, 0, 0, 0, 0, NativeCookingAction.Mode.PRIMARY, context, 1, 1);
+            final var wire = Unpooled.buffer();
+            try {
+                NativeCookingAction.TYPE.write(wire, action);
+                assertEquals(action, NativeCookingAction.TYPE.read(wire));
+                for (final int invalid : new int[]{4, 255}) {
+                    wire.readerIndex(0);
+                    wire.setByte(wire.writerIndex() - 3, invalid);
+                    assertThrows(IllegalArgumentException.class, () -> NativeCookingAction.TYPE.read(wire));
+                }
+            } finally {
+                wire.release();
+            }
+        }
+        for (final int invalid : new int[]{-1, 4, 256}) {
+            assertThrows(IllegalArgumentException.class, () -> new NativeCookingAction(0, 1, 1, 0, 0, 0, 0,
+                    NativeCookingAction.Mode.PRIMARY, invalid, 1, 1));
+        }
+    }
+
+}
