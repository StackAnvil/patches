+    private static CookingUi.MenuView menu(final CookingUi.Family family) {
+        final var slots = IntStream.range(0, 39).mapToObj(slot -> new ContainerUi.Slot(slot,
+                Map.of("#inventory_stack_count", new JsonPrimitive(slot + 1)))).toList();
+        final var book = new CookingUi.Book(2, false, 1, false, 2, 1, 1, "furnaceScreen.tab.food", "", new CookingUi.Selection("recipe_book", 1),
+                List.of(new CookingUi.Recipe(7, "first", 10, true, "first_output", 1, Map.of()), new CookingUi.Recipe(19, "second", -10, true, "second_output", 1, Map.of())), Set.of(7, 19));
+        return new CookingUi.MenuView(7, family, new ContainerUi.Title("", true), slots, Map.of(),
+                new CookingUi.Progress(100, 100, 0, Integer.MAX_VALUE), book);
+    }
+
+    private static JsonObject content(final JsonObject scene) {
+        return nodes(scene.getAsJsonObject("root")).stream()
+                .filter(node -> node.has("name") && node.get("name").getAsString().equals("root_screen_panel"))
+                .findFirst().orElseThrow();
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        if (root.has("children")) {
+            root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        }
+        return result;
+    }
+
+}
