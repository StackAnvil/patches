+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.List;
+import java.util.Map;
+
+/** Target brewing callbacks, using full native counters rather than Java's short projection. */
+final class BrewingStandUi {
+
+    private static final int[] BUBBLES = {29, 24, 20, 16, 11, 6, 0};
+
+    private BrewingStandUi() { }
+
+    static Map<String, JsonElement> bindings(final List<Integer> data) {
+        ContainerUi.Kind.BREWING_STAND.validateData(data);
+        final int ticks = data.get(0);
+        final int fuel = data.get(1);
+        final int totalFuel = data.get(2);
+        if (ticks < 0 || fuel < 0 || totalFuel < 0) {
+            throw new IllegalArgumentException("Unsupported negative brewing counters");
+        }
+        final int bubbles = ticks == 0 ? 0 : BUBBLES[ticks / 2 % BUBBLES.length];
+        final float arrowValue = ((float) ticks / -400F + 1F) * 28F;
+        final int arrowTruncated = truncated(arrowValue);
+        final int arrow = ticks == 0 ? 0 : arrowTruncated - (arrowValue < arrowTruncated ? 1 : 0);
+        final float fuelValue = (float) fuel * 22F / totalFuel;
+        final int fuelTruncated = truncated(fuelValue);
+        final int fuelSteps = fuel == 0 ? 0 : fuelTruncated + (fuelTruncated < fuelValue ? 1 : 0);
+        return Map.of("#brewing_bubbles_ratio", new JsonPrimitive((float) (29 - bubbles) / 29F),
+                "#brewing_arrow_ratio", new JsonPrimitive((float) (28 - arrow) / 28F),
+                "#brewing_fuel_ratio", new JsonPrimitive((float) (22 - fuelSteps) / 22F));
+    }
+
+    private static int truncated(final float value) {
+        return !Float.isFinite(value) || value >= 0x1p31F || value < -0x1p31F ? Integer.MIN_VALUE : (int) value;
+    }
+
+}
