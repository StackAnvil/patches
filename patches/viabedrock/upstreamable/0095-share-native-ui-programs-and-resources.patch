+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.util.Objects;
+
+/** The furnace edit callback retains only the latest raw value until its controller is ready. */
+public final class CookingSearchText {
+
+    private String value = "";
+    private String pending;
+
+    /** Physical edit-box admission and connection ownership belong to the caller. */
+    public void edit(final String text) {
+        this.pending = Objects.requireNonNull(text);
+    }
+
+    public String value() {
+        return this.value;
+    }
+
+    /** Returns whether the caller must apply the latest text to its model. Repeated equal edits still apply. */
+    public boolean tick(final boolean ready) {
+        if (!ready || this.pending == null) {
+            return false;
+        }
+        this.value = this.pending;
+        this.pending = null;
+        return true;
+    }
+
+    /** A handled clear also requires the caller's native model-clear and settings effects. */
+    public boolean clear(final boolean guarded, final int inputMode) {
+        if (guarded && inputMode == 2) {
+            return false;
+        }
+        this.value = "";
+        this.pending = null;
+        return true;
+    }
+
+}
