diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerActionTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerActionTest.java
new file mode 100644
index 000000000..a97902e1f
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerActionTest.java
@@ -0,0 +1,88 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import io.netty.buffer.Unpooled;
+
+import org.junit.jupiter.api.Test;
+
+final class NativeContainerActionTest {
+
+    @Test
+    void bindsEachActionToItsMenuLifetimeAndRejectsPartialOrExtraFields() {
+        for (final var mode : NativeContainerAction.Mode.values()) {
+            final var action =
+                    new NativeContainerAction(
+                            6,
+                            30,
+                            7,
+                            mode,
+                            mode == NativeContainerAction.Mode.AUTO_PLACE_ONE ? 9 : -1);
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeContainerAction.TYPE.write(buffer, action);
+                final int length = buffer.readableBytes();
+                final var valid = buffer.copy();
+                try {
+                    assertEquals(action, NativeContainerAction.TYPE.read(valid));
+                } finally {
+                    valid.release();
+                }
+                for (int size = 0; size < length; size++) {
+                    final var partial = buffer.copy(0, size);
+                    try {
+                        assertThrows(
+                                RuntimeException.class,
+                                () -> NativeContainerAction.TYPE.read(partial));
+                    } finally {
+                        partial.release();
+                    }
+                }
+                buffer.writeByte(0);
+                assertThrows(
+                        IllegalArgumentException.class,
+                        () -> NativeContainerAction.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> new NativeContainerAction(6, 0, 0, NativeContainerAction.Mode.ACTIVATE, -1));
+        assertThrows(
+                IllegalArgumentException.class,
+                () ->
+                        new NativeContainerAction(
+                                6, 1, 0, NativeContainerAction.Mode.AUTO_PLACE_ONE, 54));
+    }
+
+    @Test
+    void acknowledgmentCannotCarryAnUnknownBooleanOrAnotherFormat() {
+        final var status = new NativeContainerStatus(6, 30, false);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeContainerStatus.TYPE.write(buffer, status);
+            final var valid = buffer.copy();
+            try {
+                assertEquals(status, NativeContainerStatus.TYPE.read(valid));
+            } finally {
+                valid.release();
+            }
+            buffer.setByte(buffer.writerIndex() - 1, 2);
+            assertThrows(
+                    IllegalArgumentException.class, () -> NativeContainerStatus.TYPE.read(buffer));
+            buffer.readerIndex(0);
+            buffer.setByte(0, 2);
+            assertThrows(
+                    IllegalArgumentException.class, () -> NativeContainerStatus.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerDataTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerDataTest.java
new file mode 100644
index 000000000..3fd00f9f1
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/NativeContainerDataTest.java
@@ -0,0 +1,45 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import java.util.List;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerDataTest {
+
+    @Test
+    void retainsFullCounterBitsAndRejectsTruncationAndUnrelatedDataShapes() {
+        final var value = new NativeContainerData(255, Long.MAX_VALUE, ContainerUi.Kind.BREWING_STAND,
+                List.of(Integer.MIN_VALUE, 65536, Integer.MAX_VALUE));
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeContainerData.TYPE.write(buffer, value);
+            for (int length = 0; length < buffer.readableBytes(); length++) {
+                final var truncated = buffer.copy(0, length);
+                try {
+                    assertThrows(RuntimeException.class, () -> NativeContainerData.TYPE.read(truncated));
+                } finally {
+                    truncated.release();
+                }
+            }
+            assertEquals(value, NativeContainerData.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            buffer.readerIndex(0);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerData.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new NativeContainerData(7, 1,
+                    ContainerUi.Kind.CHEST_3_ROWS, List.of()));
+            assertThrows(IllegalArgumentException.class, () -> new NativeContainerData(7, 1,
+                    ContainerUi.Kind.BREWING_STAND, List.of(0, 0)));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
