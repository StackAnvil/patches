--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/RecipeCollection.java
@@ -0,0 +1,266 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.ToIntFunction;
+
+/** Native recipe buckets, contiguous groups and retained header expansion. */
+public final class RecipeCollection<T, G> {
+
+    private final Source<T, G> source;
+    private List<Row<T, G>> groupedRows = List.of();
+    private Snapshot<T, G> snapshot = new Snapshot<>(List.of(), 0, List.of(), List.of());
+    private boolean grouping;
+
+    public RecipeCollection(final Source<T, G> source) {
+        this.source = Objects.requireNonNull(source);
+    }
+
+    private Partition<T> partition(final List<T> entries, final boolean grouping, final boolean filtering) {
+        final List<List<T>> buckets = List.of(new ArrayList<>(), new ArrayList<>(), new ArrayList<>(), new ArrayList<>());
+        final List<T> representatives = new ArrayList<>();
+        final List<T> run = new ArrayList<>();
+        G pending = null;
+        int runState = 3;
+        for (final T entry : entries) {
+            if (!this.source.valid(entry)) {
+                if (grouping) {
+                    buckets.get(3).add(entry);
+                }
+                continue;
+            }
+            final int state = grouping && !filtering ? 1 : checkedState(this.source.evaluate(entry));
+            final G group = grouping ? this.source.group(entry) : null;
+            if (group != null) {
+                if (group == pending) {
+                    if (state == 0 || state == 1 && runState != 0) {
+                        runState = state;
+                    }
+                } else {
+                    finishRun(buckets, representatives, run, runState);
+                    runState = state;
+                    pending = group;
+                }
+                run.add(entry);
+            } else {
+                finishRun(buckets, representatives, run, runState);
+                pending = null;
+                buckets.get(grouping || filtering || state == 0 || state == 3 ? state : 1).add(entry);
+            }
+        }
+        finishRun(buckets, representatives, run, runState);
+        final int eligible = buckets.get(0).size() + buckets.get(1).size() + buckets.get(2).size();
+        final List<T> ordered = buckets.stream().flatMap(List::stream).toList();
+        return new Partition<>(ordered, eligible, representatives);
+    }
+
+    public Snapshot<T, G> refresh(final List<T> entries, final boolean grouping, final boolean filtering,
+                                 final boolean resetExpansion) {
+        final Partition<T> partition = this.partition(entries, grouping, filtering);
+        this.grouping = grouping;
+        final List<Row<T, G>> rows;
+        if (grouping) {
+            final List<G> expanded = new ArrayList<>();
+            if (!resetExpansion) {
+                for (final var row : this.groupedRows) {
+                    if (row instanceof Header<T, G> header && header.expanded) {
+                        expanded.add(header.group);
+                    }
+                }
+            }
+            this.groupedRows = this.grouped(partition.ordered, expanded);
+            rows = project(this.groupedRows);
+        } else {
+            rows = partition.ordered.subList(0, partition.eligibleCount).stream().<Row<T, G>>map(Item::new).toList();
+        }
+        this.snapshot = new Snapshot<>(partition.ordered, partition.eligibleCount, rows, partition.representatives);
+        return this.snapshot;
+    }
+
+    private static int checkedState(final int state) {
+        if (state < 0 || state > 3) {
+            throw new IllegalArgumentException("Invalid native recipe evaluator state");
+        }
+        return state;
+    }
+
+    private static <T> void finishRun(final List<List<T>> buckets, final List<T> representatives,
+                                      final List<T> run, final int state) {
+        if (run.isEmpty()) {
+            return;
+        }
+        if (state < 2) {
+            representatives.add(run.getFirst());
+        }
+        buckets.get(state).addAll(run);
+        run.clear();
+    }
+
+    private List<Row<T, G>> grouped(final List<T> entries, final List<G> expanded) {
+        final List<Row<T, G>> rows = new ArrayList<>();
+        G previous = null;
+        for (final T entry : entries) {
+            if (!this.source.valid(entry)) {
+                continue;
+            }
+            final G group = this.source.group(entry);
+            if (group == null) {
+                rows.add(new Item<>(entry));
+                previous = null;
+            } else {
+                if (group != previous) {
+                    final boolean open = expanded.stream().anyMatch(old -> this.source.sameHeader(old, group));
+                    rows.add(new Header<>(group, open));
+                }
+                rows.add(new Member<>(entry, group));
+                previous = group;
+            }
+        }
+        return List.copyOf(rows);
+    }
+
+    private static <T, G> List<Row<T, G>> project(final List<Row<T, G>> rows) {
+        final List<Row<T, G>> visible = new ArrayList<>();
+        boolean collapsed = false;
+        for (final var row : rows) {
+            if (!(row instanceof Member<T, G>)) {
+                collapsed = row instanceof Header<T, G> header && !header.expanded;
+            }
+            if (!(row instanceof Member<T, G>) || !collapsed) {
+                visible.add(row);
+            }
+        }
+        return List.copyOf(visible);
+    }
+
+    /** Header matching includes the native icon and count, independently of group identity. */
+    public Toggle toggleHeader(final G selected) {
+        Objects.requireNonNull(selected);
+        if (!this.grouping) {
+            return null;
+        }
+        for (int index = 0; index < this.groupedRows.size(); index++) {
+            if (!(this.groupedRows.get(index) instanceof Header<T, G> header)
+                    || !this.source.sameHeader(header.group, selected)) {
+                continue;
+            }
+            final var replacement = new Header<T, G>(header.group, !header.expanded);
+            final List<Row<T, G>> updated = new ArrayList<>(this.groupedRows);
+            updated.set(index, replacement);
+            this.groupedRows = List.copyOf(updated);
+            final List<Row<T, G>> rows = project(this.groupedRows);
+            this.snapshot = new Snapshot<>(this.snapshot.ordered, this.snapshot.eligibleCount, rows, this.snapshot.representatives);
+            int members = 0;
+            for (int child = index + 1; child < updated.size() && updated.get(child) instanceof Member<T, G>; child++) {
+                members++;
+            }
+            return new Toggle(rows.indexOf(replacement), members, replacement.expanded);
+        }
+        return null;
+    }
+
+    /** Query current availability without replacing the retained collection snapshot. */
+    public boolean disabled(final int index, final Eligibility<T, G> eligibility) {
+        final Row<T, G> row = this.snapshot.rows.get(index);
+        final int state = checkedState(eligibility.evaluate(row));
+        if (!this.grouping) {
+            return state >= 2;
+        }
+        if (state != 2) {
+            return false;
+        }
+        if (row instanceof Header<T, G> header) {
+            for (final T representative : this.snapshot.representatives) {
+                if (eligibility.represents(representative, header.group)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    public Snapshot<T, G> snapshot() {
+        return this.snapshot;
+    }
+
+    public static <T> List<T> visibleOrder(final List<T> entries, final ToIntFunction<T> evaluation, final boolean filtering) {
+        final var collection = new RecipeCollection<T, Void>(new Source<>() {
+            @Override
+            public int evaluate(final T entry) {
+                return evaluation.applyAsInt(entry);
+            }
+
+            @Override
+            public Void group(final T entry) {
+                return null;
+            }
+
+            @Override
+            public boolean sameHeader(final Void first, final Void second) {
+                return false;
+            }
+        });
+        final var partition = collection.partition(entries, false, filtering);
+        return partition.ordered.subList(0, partition.eligibleCount);
+    }
+
+    /** Current evaluator results and native icon/count comparisons for an admitted view. */
+    public interface Eligibility<T, G> {
+        int evaluate(Row<T, G> row);
+
+        boolean represents(T representative, G group);
+    }
+
+    public interface Source<T, G> {
+        int evaluate(T entry);
+
+        default boolean valid(final T entry) {
+            return true;
+        }
+
+        /** Return a stable catalog object for an eligible native group, or null for an individual item. */
+        G group(T entry);
+
+        boolean sameHeader(G first, G second);
+    }
+
+    public record Snapshot<T, G>(List<T> ordered, int eligibleCount, List<Row<T, G>> rows, List<T> representatives) {
+        public Snapshot {
+            ordered = List.copyOf(ordered);
+            rows = List.copyOf(rows);
+            representatives = List.copyOf(representatives);
+            if (eligibleCount < 0 || eligibleCount > ordered.size()) {
+                throw new IllegalArgumentException("Invalid recipe prefix");
+            }
+        }
+
+        public List<T> eligibleItems() {
+            return this.ordered.subList(0, this.eligibleCount);
+        }
+    }
+
+    public sealed interface Row<T, G> permits Item, Header, Member {
+    }
+
+    public record Item<T, G>(T entry) implements Row<T, G> {
+    }
+
+    public record Header<T, G>(G group, boolean expanded) implements Row<T, G> {
+    }
+
+    public record Member<T, G>(T entry, G group) implements Row<T, G> {
+    }
+
+    public record Toggle(int headerIndex, int memberCount, boolean expanded) {
+    }
+
+    private record Partition<T>(List<T> ordered, int eligibleCount, List<T> representatives) {
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/ServerFormUi.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/ServerFormUi.java
