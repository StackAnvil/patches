+        private int animation(final String reference, final Map<String, JsonElement> values,
+                              final JsonArray tracks, final Map<String, Integer> indices) {
+            String next = animationName(reference, UiExpression.text(values.get("$__namespace")));
+            final int root = indices.getOrDefault(next, tracks.size());
+            JsonObject previous = null;
+            while (!next.isEmpty()) {
+                final Integer existing = indices.get(next);
+                if (existing != null) {
+                    if (previous != null) {
+                        previous.addProperty("next_index", existing);
+                    }
+                    break;
+                }
+                if (tracks.size() >= 256) {
+                    throw new IllegalArgumentException("UI animation graph exceeds track limit");
+                }
+                final JsonObject definition = JsonUiProgram.this.template(next, new HashSet<>(), this.requiredDefinitions);
+                if (definition == null) {
+                    throw new MissingControlException(next);
+                }
+                final Map<String, JsonElement> animated = new HashMap<>(values);
+                declarations(definition, animated);
+                final JsonObject track = new JsonObject();
+                for (final var entry : definition.entrySet()) {
+                    if (!entry.getKey().startsWith("$")) {
+                        track.add(entry.getKey(), resolveValue(entry.getValue(), animated, 0));
+                    }
+                }
+                final int index = tracks.size();
+                indices.put(next, index);
+                if (previous != null) {
+                    previous.addProperty("next_index", index);
+                }
+                tracks.add(track);
+                final String successor = string(track, "next");
+                next = successor.isEmpty() ? "" : animationName(successor, next.substring(0, next.indexOf('.')));
+                previous = track;
+            }
+            return root;
+        }
