+    private static boolean supportedHudBindings(final JsonObject control, final Map<String, JsonElement> values) {
+        final JsonArray bindings = control.getAsJsonArray("bindings");
+        if (bindings == null) {
+            return true;
+        }
+        for (final JsonElement entry : bindings) {
+            final JsonObject binding = entry.getAsJsonObject();
+            final String name = string(binding, "binding_name");
+            if (name.isEmpty() || !values.containsKey(name)) {
+                return false;
+            }
+        }
+        return true;
+    }
