+
+class NativeSearchNormalizationTest {
+
+    @Test
+    void composesCompatibilityAndFullCaseFoldWithoutDroppingDefaultIgnorables() {
+        assertEquals("strasse ffi café kક", text("Straße ﬃ CAFÉ Kક"));
+        assertEquals("ii̇ıi", text("Iİıi"));
+        assertEquals("οσοσ", text("ΟΣος"));
+        assertEquals("가각", text("가각"));
+        final String zeroWidth = Character.toString(0x200B);
+        final String softHyphen = Character.toString(0x00AD);
+        assertEquals("a" + zeroWidth + "b" + softHyphen, text("A" + zeroWidth + "B" + softHyphen));
+        // These letters acquired case-fold mappings after the target's Unicode 5.0 tables.
+        assertEquals("Აẞ", text("Აẞ"));
+    }
+
+    @Test
+    void validatesTheWholeInputBeforeNulTruncationAndReturnsIndependentBytes() {
+        assertArrayEquals(new byte[]{'a'}, NativeSearchNormalization.normalize(new byte[]{'A', 0, 'B'}));
+        for (final byte[] input : new byte[][]{
+                {(byte) 0xFF}, {(byte) 0xC0, (byte) 0xAF}, {'A', 0, (byte) 0xFF},
+                {(byte) 0xED, (byte) 0xA0, (byte) 0x80}, {(byte) 0xEF, (byte) 0xB7, (byte) 0x90},
+                {(byte) 0xF4, (byte) 0x90, (byte) 0x80, (byte) 0x80}, {(byte) 0xE2, (byte) 0x82}}) {
+            final byte[] result = NativeSearchNormalization.normalize(input);
+            assertArrayEquals(input, result);
+            assertNotSame(input, result);
+            result[0] ^= 1;
+            assertNotEquals(input[0], result[0]);
+        }
+    }
+
+    private static String text(final String value) {
+        return new String(NativeSearchNormalization.normalize(value.getBytes(StandardCharsets.UTF_8)), StandardCharsets.UTF_8);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcDialogueUiTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcDialogueUiTest.java
