+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class CookingProgressTest {
+
+    @Test
+    void matchesTargetFlameArithmeticAndNativeSignedDivisionTraps() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_FURNACE_PROGRESS");
+        assumeTrue(fixture != null && Files.isRegularFile(Path.of(fixture)));
+        final var reference = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject();
+        assertEquals(51061372, reference.get("build").getAsInt());
+        assertEquals(176, reference.getAsJsonArray("cases").size());
+        int compared = 0;
+        for (final var element : reference.getAsJsonArray("cases")) {
+            final var sample = element.getAsJsonObject();
+            for (final var family : CookingUi.Family.values()) {
+                final int duration = family == CookingUi.Family.FURNACE ? 200 : 100;
+                if (sample.get("fixedDuration").getAsInt() != duration) {
+                    continue;
+                }
+                final var progress = new CookingUi.Progress(0, sample.get("burn").getAsInt(),
+                        sample.get("suppliedDuration").getAsInt(), 0);
+                if (sample.get("nativeDivisionTrap").getAsBoolean()) {
+                    assertThrows(ArithmeticException.class, () -> progress.flameRatio(family));
+                } else {
+                    final float expected = (13 - sample.get("steps").getAsInt()) / 13F;
+                    assertEquals(Float.floatToRawIntBits(expected), Float.floatToRawIntBits(progress.flameRatio(family)));
+                }
+                compared++;
+            }
+        }
+        assertEquals(264, compared);
+    }
+
+}
