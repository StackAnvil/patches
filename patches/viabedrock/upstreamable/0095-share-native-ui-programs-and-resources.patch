+        assertEquals("small", caption.get("font_size").getAsString());
+        assertEquals(2, caption.getAsJsonArray("offset").get(0).getAsInt());
+        final var icon = children.get(1).getAsJsonObject();
+        assertEquals("image", icon.get("type").getAsString());
+        assertEquals(JsonUiProgram.textureId("textures/ui/upper"), icon.get("texture").getAsString());
+        assertEquals(16, icon.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(scene.root(), JsonUiProgram.fromProgram(ui.export(scene.requiredDefinitions(), new JsonObject()))
+                .resolve("example.root", new Bindings()).root());
+    }
+
+    @Test
+    void selfReferencingDefinitionsPreserveTheirControlsAcrossExport() {
+        final var ui = program("""
+                {"namespace":"example","root@example.root":{"type":"panel","size":[80,40],"controls":[
+                  {"caption":{"type":"label","text":"Ready"}}]}}
+                """);
+        final var scene = ui.resolve("example.root", new Bindings());
+        assertEquals(80, scene.root().getAsJsonArray("size").get(0).getAsInt());
+        assertEquals("Ready", scene.root().getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        assertEquals(Set.of("example.root"), scene.requiredDefinitions());
+        assertEquals(scene.root(), JsonUiProgram.fromProgram(ui.export(scene.requiredDefinitions(), new JsonObject()))
+                .resolve("example.root", new Bindings()).root());
+    }
+
+    @Test
+    void cyclicInheritanceRetainsEachDefinitionsNearestValues() {
+        final var ui = program("""
+                {"namespace":"example","first@second":{"type":"panel","alpha":0.25},
+                 "second@third":{"alpha":0.75},"third@first":{"size":[80,40]}}
+                """);
+        for (final var expected : Map.of("first", 0.25, "second", 0.75, "third", 0.25).entrySet()) {
+            final String name = "example." + expected.getKey();
