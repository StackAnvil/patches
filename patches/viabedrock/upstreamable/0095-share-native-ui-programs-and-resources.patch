diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeItemNamesTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeItemNamesTest.java
new file mode 100644
index 000000000..fa4932829
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/NativeItemNamesTest.java
@@ -0,0 +1,123 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeItemNamesTest {
+
+    @Test
+    void keepsCustomPresenceDistinctFromEmptyTextAndDefinitionAbsence() {
+        final var data = new CompoundTag();
+        final var display = new CompoundTag();
+        data.put("display", display);
+        assertNull(NativeItemNames.customName(data, false));
+        display.put("Name", new IntTag(7));
+        data.put("title", new StringTag("Title"));
+        assertEquals("", NativeItemNames.customName(data, false));
+        assertEquals("Title", NativeItemNames.customName(data, true));
+        assertEquals("Title", NativeItemNames.primary(true, data, true,
+                () -> fail("Custom names must skip ordinary production"), key -> fail(), (key, args) -> fail()));
+        assertEquals("", NativeItemNames.primary(false, data, true,
+                () -> fail("Missing definitions must skip ordinary production"), key -> fail(), (key, args) -> fail()));
+        final String custom = "Custom\0" + (char) 0xDCFF;
+        display.put("Name", new StringTag(custom));
+        display.put("FilteredName", new StringTag("Filtered"));
+        data.put("filteredTitle", new StringTag("Filtered title"));
+        assertEquals(custom, NativeItemNames.customName(data, true));
+    }
+
+    @Test
+    void appliesTypedAppendPrecedenceAndRetainsTheEmptyFirstFormatArgument() {
+        final var data = new CompoundTag();
+        data.put("AppendCustomName", new IntTag(1));
+        data.put("CustomName", new StringTag(" suffix"));
+        assertEquals("Base", NativeItemNames.primary(true, data, false, () -> "Base", key -> fail(), (key, args) -> fail()));
+        data.put("AppendCustomName", new ByteTag((byte) -1));
+        assertEquals("Base suffix", NativeItemNames.primary(true, data, false, () -> "Base", key -> fail(), (key, args) -> fail()));
+        data.put("GroupName", new StringTag("group"));
+        data.put("BodyID", new StringTag("body"));
+        final List<String> calls = new ArrayList<>();
+        assertEquals("Base group", NativeItemNames.primary(true, data, false, () -> "Base", key -> {
+            calls.add(key);
+            return " " + key;
+        }, (key, args) -> fail()));
+        assertEquals(List.of("group"), calls);
+        data.put("GroupName", new StringTag(""));
+        data.put("Color2ID", new StringTag("second"));
+        assertEquals("Base formatted", NativeItemNames.primary(true, data, false, () -> "Base", key -> key, (key, args) -> {
+            assertEquals("body", key);
+            assertEquals(List.of(""), args);
+            return " formatted";
+        }));
+        data.put("ColorID", new StringTag("first"));
+        assertEquals("Base formatted", NativeItemNames.primary(true, data, false, () -> "Base", key -> key, (key, args) -> {
+            assertEquals(List.of("first", "second"), args);
+            return " formatted";
+        }));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ITEM_NAMES", matches = ".+")
+    void matchesNativeUnfilteredSelectionAndAppendCases() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_ITEM_NAMES")))).getAsJsonObject();
+        final var translations = fixture.getAsJsonObject("translations");
+        int cases = 0;
+        for (final var element : fixture.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            final var data = row.get("data").isJsonNull() ? null : compound(row.getAsJsonObject("data"));
+            final boolean writtenBook = row.get("writtenBook").getAsBoolean();
+            final String expectedCustom = row.get("custom").isJsonNull() ? null : row.get("custom").getAsString();
+            assertEquals(expectedCustom, NativeItemNames.customName(data, writtenBook), "custom case " + cases);
+            assertEquals(row.get("primary").getAsString(), NativeItemNames.primary(row.get("registered").getAsBoolean(), data, writtenBook,
+                    () -> row.get("ordinary").getAsString(), key -> translate(translations, key), (key, args) -> {
+                        String text = translate(translations, key);
+                        for (int index = 0; index < args.size(); index++) {
+                            text = text.replace("%" + (index + 1), args.get(index));
+                        }
+                        return text;
+                    }), "primary case " + cases);
+            cases++;
+        }
+        assertEquals(fixture.get("cases").getAsInt(), cases);
+    }
+
+    private static String translate(final JsonObject translations, final String key) {
+        return translations.has(key) ? translations.get(key).getAsString() : key;
+    }
+
+    private static CompoundTag compound(final JsonObject object) {
+        final var result = new CompoundTag();
+        for (final var entry : object.entrySet()) {
+            final var value = entry.getValue().getAsJsonArray();
+            final Tag tag = switch (value.get(0).getAsInt()) {
+                case 1 -> new ByteTag(value.get(1).getAsByte());
+                case 3 -> new IntTag(value.get(1).getAsInt());
+                case 8 -> new StringTag(value.get(1).getAsString());
+                case 10 -> compound(value.get(1).getAsJsonObject());
+                default -> throw new IllegalArgumentException("Unsupported fixture tag");
+            };
+            result.put(entry.getKey(), tag);
+        }
+        return result;
+    }
+
+}
