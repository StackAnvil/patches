+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.protocol.storage.NpcDialogueStorage;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NpcDialogueUiTest {
+
+    private static NpcDialogueStorage.Session session() {
+        return new NpcDialogueStorage().open(-287762808818L, 22, "probe_scene", """
+                [{"type":1,"mode":2,"text":"/say entered"},
+                 {"type":1,"mode":0,"button_name":"First choice"},
+                 {"type":1,"mode":1,"text":"/say exited"},
+                 {"type":0,"mode":0,"button_name":"Open link","text":"https://example.com/path"},
+                 {"type":1,"mode":0,"button_name":"Next scene"}]
+                """);
+    }
+
+    @Test
+    void nativeDefaultKeepsMultilineDialogueSparseActionsAndPortraitMetadata() {
+        final var ui = new NpcDialogueUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        final var appearance = JsonParser.parseString("""
+                {"portrait_offsets":{"scale":[1.75,1.75,1.75],"translate":[-7,50,0]},
+                 "picker_offsets":{"scale":[1.7,1.7,1.7],"translate":[0,20,0]},
+                 "skin_list":[{"variant":0},{"variant":25},{"variant":20}]}
+                """).getAsJsonObject();
+        final var scene = ui.resolve(session(), "Core NPC probe", "First line\nSecond line", 25, appearance);
+        assertTrue(scene.getAsJsonArray("missing_templates").isEmpty(), scene.get("missing_templates").toString());
+        final var nodes = nodes(scene.getAsJsonObject("root"));
+        assertEquals(List.of(1, 4), nodes.stream().filter(node -> node.has("action") && node.get("action").getAsInt() >= 0)
+                .map(node -> node.get("action").getAsInt()).toList());
+        assertEquals(1, nodes.stream().filter(node -> node.has("url")).count());
+        assertTrue(nodes.stream().anyMatch(node -> node.has("text") && node.get("text").getAsString().equals("First line\nSecond line")));
+        final var portrait = nodes.stream().filter(node -> node.has("actor_portrait")).findFirst().orElseThrow().getAsJsonObject("actor_portrait");
+        assertEquals(session().uniqueId(), portrait.get("unique_id").getAsLong());
+        assertEquals(25, portrait.get("variant").getAsInt());
+        assertEquals(1, portrait.get("skin_index").getAsInt());
+        assertEquals(appearance, portrait.getAsJsonObject("actor_data"));
+        assertTrue(nodes.stream().anyMatch(node -> node.has("action") && node.get("action").getAsInt() == -1));
+        final var grid = nodes.stream().filter(node -> node.has("grid_dimensions")).findFirst().orElseThrow();
+        assertEquals(JsonParser.parseString("[3,1]"), grid.get("grid_dimensions"));
+        appearance.addProperty("mutated", true);
+        assertFalse(portrait.getAsJsonObject("actor_data").has("mutated"));
+    }
+
+    @Test
+    void packHostOverridesSelectTheirLayoutAndPreserveNestedCollectionActionIdentity() {
+        final String host = """
+                {"namespace":"npc_interact","npc_screen":{"$screen_content":"npc_interact.standard",
+                 "variables":[{"requires":"(#title_text = 'Special')","$screen_content":"example.custom"}]},
+                 "standard":{"type":"panel"}}
+                """;
+        final String custom = """
+                {"namespace":"example","custom":{"type":"panel","controls":[
+                  {"title":{"type":"label","text":"#title_text"}},
+                  {"buttons":{"type":"grid","collection_name":"student_buttons_collection","grid_dimensions":[3,1],
+                    "grid_item_template":"example.button"}}]},
+                 "button":{"type":"panel","controls":[
+                   {"skin":{"type":"grid","collection_name":"skins_collection","grid_item_template":"example.caption"}}]},
+                 "caption":{"type":"button","$pressed_button_name":"button.student_button","controls":[
+                   {"label":{"type":"label","text":"#student_button_text"}}]}}
+                """;
+        final var program = new JsonUiProgram(List.of(Map.of("ui/npc_interact_screen.json", host.getBytes(StandardCharsets.UTF_8),
+                "ui/example.json", custom.getBytes(StandardCharsets.UTF_8))));
+        final var ui = new NpcDialogueUi(program);
+        assertTrue(ui.resolve(session(), "Ordinary", "", 0, new JsonObject()).getAsJsonObject("root").getAsJsonArray("children").isEmpty());
+        final var appearance = JsonParser.parseString("{\"skin_list\":[{\"variant\":0}]}").getAsJsonObject();
+        final var scene = ui.resolve(session(), "Special", "", 0, appearance);
+        final var buttons = nodes(scene.getAsJsonObject("root")).stream().filter(node -> node.has("action") || node.has("url")).toList();
+        assertEquals(3, buttons.size());
+        assertEquals(1, buttons.getFirst().get("action").getAsInt());
+        assertFalse(buttons.get(1).has("action"));
+        assertEquals("https://example.com/path", buttons.get(1).get("url").getAsString());
+        assertEquals(4, buttons.getLast().get("action").getAsInt());
+    }
+
+    @Test
+    void unsupportedControllerCollectionsRemainErrors() {
+        final String host = """
+                {"namespace":"npc_interact","npc_screen_contents":{"type":"grid","collection_name":"unknown",
+                  "grid_item_template":"npc_interact.button"},"button":{"type":"button"}}
+                """;
+        final var ui = new NpcDialogueUi(new JsonUiProgram(List.of(Map.of("ui/npc_interact_screen.json", host.getBytes(StandardCharsets.UTF_8)))));
+        assertThrows(IllegalArgumentException.class, () -> ui.resolve(session(), "", "", 0, new JsonObject()));
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        if (root.has("children")) {
+            root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        }
+        return result;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorStateTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorStateTest.java
