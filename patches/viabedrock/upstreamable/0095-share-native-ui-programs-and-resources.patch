+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import net.raphimc.viabedrock.api.util.NativeSort;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.function.Predicate;
+import java.util.function.ToIntFunction;
+
+/** The pinned native cooking book sorts signed priorities and can reorder equal priorities. */
+public final class CookingRecipeOrder {
+
+    private CookingRecipeOrder() { }
+
+    /** Native registry keys use unsigned UTF-8 byte order, independently of packet arrival. */
+    public static <T> List<T> registryOrder(final List<T> entries, final Function<T, String> identity) {
+        final List<RegistryEntry<T>> result = new ArrayList<>(entries.size());
+        for (final T entry : entries) {
+            result.add(new RegistryEntry<>(entry, identity.apply(entry).getBytes(StandardCharsets.UTF_8)));
+        }
+        result.sort((first, second) -> Arrays.compareUnsigned(first.key, second.key));
+        for (int index = 1; index < result.size(); index++) {
+            if (Arrays.equals(result.get(index - 1).key, result.get(index).key)) {
+                throw new IllegalArgumentException("Ambiguous native cooking registry identity");
+            }
+        }
+        return result.stream().map(RegistryEntry::entry).toList();
+    }
+
+    /** Unlocks and output deduplication precede the native priority sort. */
+    public static <T> List<T> bookOrder(final List<T> entries, final Function<T, String> identity,
+                                       final Predicate<T> unlocked, final Function<T, String> outputName,
+                                       final ToIntFunction<T> priority) {
+        final Set<String> outputs = new HashSet<>();
+        return sorted(registryOrder(entries, identity).stream()
+                .filter(entry -> unlocked.test(entry) && outputs.add(outputName.apply(entry))).toList(), priority);
+    }
+
+    public static <T> List<T> sorted(final List<T> entries, final ToIntFunction<T> priority) {
+        return NativeSort.sorted(entries, Comparator.comparingInt(priority));
+    }
+
+    /** Native ungrouped collections expose a stable prefix of evaluator buckets 0, 1 and 2. */
+    public static <T> List<T> visibleOrder(final List<T> entries, final ToIntFunction<T> evaluation,
+                                         final boolean filtering) {
+        return RecipeCollection.visibleOrder(entries, evaluation, filtering);
+    }
+
+    private record RegistryEntry<T>(T entry, byte[] key) { }
+
+}
