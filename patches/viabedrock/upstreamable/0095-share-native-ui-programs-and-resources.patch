+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import io.netty.buffer.ByteBuf;
+
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/**
+ * Server acknowledgment of the exact live presentation's action backend and current scoped
+ * controls.
+ */
+public record NativeContainerStatus(int menuId, long sequence, boolean accepted) {
+
+    public static final String CHANNEL = "viabedrock:native_container_status";
+    public static final Type<NativeContainerStatus> TYPE =
+            new Type<>(NativeContainerStatus.class) {
+
+                @Override
+                public NativeContainerStatus read(final ByteBuf buffer) {
+                    if (buffer.readableBytes() > 32
+                            || Types.VAR_INT.readPrimitive(buffer) != 1
+                            || Types.VAR_INT.readPrimitive(buffer)
+                                    != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                        throw new IllegalArgumentException("Unsupported native container status");
+                    }
+                    final int menu = Types.VAR_INT.readPrimitive(buffer);
+                    final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+                    final int accepted = buffer.readUnsignedByte();
+                    if (accepted > 1 || buffer.isReadable()) {
+                        throw new IllegalArgumentException(
+                                "Invalid native container status fields");
+                    }
+                    return new NativeContainerStatus(menu, sequence, accepted == 1);
+                }
+
+                @Override
+                public void write(final ByteBuf buffer, final NativeContainerStatus value) {
+                    Types.VAR_INT.writePrimitive(buffer, 1);
+                    Types.VAR_INT.writePrimitive(
+                            buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                    Types.VAR_INT.writePrimitive(buffer, value.menuId);
+                    Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+                    buffer.writeBoolean(value.accepted);
+                }
+            };
+
+    public NativeContainerStatus {
+        if (menuId < 0 || menuId > 255 || sequence <= 0) {
+            throw new IllegalArgumentException("Invalid native container status identity");
+        }
+    }
+
+}
