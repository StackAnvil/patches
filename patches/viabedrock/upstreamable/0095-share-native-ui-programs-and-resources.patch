+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.nio.charset.StandardCharsets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** A null scene closes only the matching conversation, so delayed closes cannot replace a newer scene. */
+public record NativeNpcDialogueMessage(String responseIdentifier, String scene) {
+
+    public static final String CHANNEL = "viabedrock:native_npc_dialogue";
+    public static final String EDITOR_CHANNEL = "viabedrock:native_npc_editor";
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    public static final Type<NativeNpcDialogueMessage> TYPE = new Type<>(NativeNpcDialogueMessage.class) {
+        @Override
+        public NativeNpcDialogueMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES + 128
+                    || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native NPC message");
+            }
+            final String identifier = Types.STRING.read(buffer);
+            final int length = Types.VAR_INT.readPrimitive(buffer);
+            if (length < -1 || length > MAX_PAYLOAD_BYTES || (length == -1 ? 0 : length) != buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid native NPC scene length");
+            }
+            return new NativeNpcDialogueMessage(identifier, length == -1 ? null
+                    : buffer.readCharSequence(length, StandardCharsets.UTF_8).toString());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeNpcDialogueMessage message) {
+            final byte[] bytes = message.scene == null ? null : message.scene.getBytes(StandardCharsets.UTF_8);
+            if (bytes != null && bytes.length > MAX_PAYLOAD_BYTES) {
+                throw new IllegalArgumentException("Native NPC scene exceeds the payload limit");
+            }
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.STRING.write(buffer, message.responseIdentifier);
+            Types.VAR_INT.writePrimitive(buffer, bytes == null ? -1 : bytes.length);
+            if (bytes != null) {
+                buffer.writeBytes(bytes);
+            }
+        }
+    };
+
+    public NativeNpcDialogueMessage {
+        if (responseIdentifier == null || !responseIdentifier.startsWith("viabedrock:npc/") || responseIdentifier.length() > 64
+                || scene != null && scene.length() > MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("Invalid native NPC message");
+        }
+    }
+
+}
