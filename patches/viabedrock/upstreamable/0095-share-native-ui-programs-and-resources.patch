+    private JsonObject nativeTemplate(final String name, final Set<String> active) {
+        final Definition definition = this.nativeDefinitions.get(name);
+        if (definition == null) {
+            return null;
+        }
+        if (!active.add(name) || active.size() > 64) {
+            throw new IllegalArgumentException("Recursive native HUD inheritance");
+        }
+        try {
+            final JsonObject result = definition.parent.isEmpty() ? new JsonObject() : this.nativeTemplate(definition.parent, active);
+            if (result == null) {
+                return null;
+            }
+            merge(result, definition.value);
+            applyModifications(result);
+            return result;
+        } finally {
+            active.remove(name);
+        }
+    }
