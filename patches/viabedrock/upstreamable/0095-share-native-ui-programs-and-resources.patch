+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class CookingNavigationTest {
+
+    @Test
+    void captionsMatchTheNativeGetterAcrossFamiliesTabsAndFiltering() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_COOKING_LABELS");
+        assumeTrue(fixture != null && Files.isRegularFile(Path.of(fixture)));
+        final var reference = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject();
+        assertEquals(51061372, reference.get("build").getAsInt());
+        assertEquals(60, reference.getAsJsonArray("rows").size());
+        for (final var element : reference.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            final var family = CookingUi.Family.valueOf(row.get("family").getAsString());
+            final var ingredient = switch (family) {
+                case FURNACE -> ContainerEnumName.FurnaceIngredientContainer;
+                case BLAST_FURNACE -> ContainerEnumName.BlastFurnaceIngredientContainer;
+                case SMOKER -> ContainerEnumName.SmokerIngredientContainer;
+            };
+            assertEquals(ingredient.getValue(), row.get("nativeIngredientContainer").getAsInt());
+            assertEquals(row.get("label").getAsString(), CookingNavigation.tabLabel(row.get("tab").getAsInt(),
+                    family, row.get("filtering").getAsBoolean()));
+        }
+    }
+
+    @Test
+    void categoryAvailabilityAndForcedLayoutRetainNativeNavigationOrder() {
+        assertEquals(List.of(2, 4), CookingNavigation.tabs(false, 0, 2, 0));
+        assertEquals(List.of(4, 2, 5), CookingNavigation.tabs(true, 0, 2, 0));
+        assertEquals(4, CookingNavigation.tab(false, 0, 2, 0, 2, 0));
+        assertEquals(2, CookingNavigation.tab(false, 0, 2, 0, 5, -1));
+        assertEquals(new CookingNavigation.TabTransition(2, false), CookingNavigation.moveTab(false, 1, 0, 2, 0, 2, 1));
+        assertEquals(new CookingNavigation.LayoutTransition(2, 5, true, true),
+                CookingNavigation.moveLayout(false, 1, 5, 2, true, CookingNavigation.Direction.NEXT));
+        assertEquals(new CookingNavigation.LayoutTransition(2, 1, false, false),
+                CookingNavigation.moveLayout(true, 2, 5, 1, true, CookingNavigation.Direction.PREVIOUS));
+    }
+
+    @Test
+    void matchesTargetTabQueriesAndDispatcherTransitions() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_COOKING_NAVIGATION");
+        assumeTrue(fixture != null && Files.isRegularFile(Path.of(fixture)));
+        final var reference = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject();
+        assertEquals(51061372, reference.get("build").getAsInt());
+        assertEquals(2700, reference.getAsJsonArray("tabs").size());
+        assertEquals(140, reference.getAsJsonArray("callbacks").size());
+        assertEquals(64, reference.getAsJsonArray("layouts").size());
+        for (final var element : reference.getAsJsonArray("tabs")) {
+            final var row = element.getAsJsonObject();
+            assertEquals(row.get("result").getAsInt(), CookingNavigation.tab(row.get("forced").getAsBoolean(),
+                    row.get("food").getAsInt(), row.get("items").getAsInt(), row.get("blocks").getAsInt(),
+                    row.get("tab").getAsInt(), row.get("delta").getAsInt()));
+        }
+        for (final var element : reference.getAsJsonArray("callbacks")) {
+            final var row = element.getAsJsonObject();
+            final var actual = CookingNavigation.moveTab(row.get("forced").getAsBoolean(), row.get("layout").getAsInt(),
+                    1, 1, 1, row.get("tab").getAsInt(), row.get("delta").getAsInt());
+            assertEquals(row.get("refreshed").getAsInt() != 0, actual.refresh());
+            assertEquals(row.get("selected").isJsonNull() ? row.get("tab").getAsInt() : row.get("selected").getAsInt(), actual.tab());
+        }
+        for (final var element : reference.getAsJsonArray("layouts")) {
+            final var row = element.getAsJsonObject();
+            final var actual = CookingNavigation.moveLayout(row.get("forced").getAsBoolean(), row.get("layout").getAsInt(),
+                    5, 3, row.get("rememberInventory").getAsBoolean(), row.get("delta").getAsInt() > 0
+                            ? CookingNavigation.Direction.NEXT : CookingNavigation.Direction.PREVIOUS);
+            assertEquals(row.get("result").getAsInt(), actual.layout());
+            assertEquals(row.get("savedTab").getAsInt(), actual.savedTab());
+            assertEquals(row.get("hoverLength").getAsInt() == 0, actual.clearHover());
+            assertEquals(row.get("refreshed").getAsInt() != 0, actual.refresh());
+        }
+    }
+
+}
