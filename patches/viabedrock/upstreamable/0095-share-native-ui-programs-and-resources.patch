+            assertEquals(Set.of("example.first", "example.second", "example.third"), scene.requiredDefinitions());
+            assertEquals(scene.root(), JsonUiProgram.fromProgram(ui.export(scene.requiredDefinitions(), new JsonObject()))
+                    .resolve(name, new Bindings()).root());
+        }
+    }
+
+    @Test
+    void absentParentsAndAncestorNullsDoNotDiscardDeclaredControls() {
+        final var ui = program("""
+                {"namespace":"example","first@absent":{"type":"label","text":"Inherited"},
