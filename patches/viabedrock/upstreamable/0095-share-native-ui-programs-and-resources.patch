+    @Test
+    void boundedPreviewDecodingRejectsDuplicateIdentitiesLengthsAndTrailingItemFields() {
+        final var message = NativeCookingMessage.create(new CookingUi(new ResourcePackStorage(List.of()).getJsonUiProgram()),
+                view(CookingUi.Family.FURNACE), 1, 1, 0, 0, 0, items());
