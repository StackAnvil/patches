+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Repackages licensed utf8proc 1.1.5 Unicode data into a modified Java representation.
+ * Copyright (c) 2009 Public Software Group e. V.; Copyright (c) 1991-2007 Unicode, Inc.
+ * See META-INF/licenses/utf8proc.txt for the retained permission notices.
+ */
+package net.raphimc.viabedrock.tool.generator;
+
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.zip.GZIPOutputStream;
+import net.raphimc.viabedrock.tool.ToolArgs;
+import net.raphimc.viabedrock.tool.ToolPaths;
+
+/** Generates search data from public utf8proc sources, independently of any game installation. */
+public final class SearchUnicodeDataGenerator {
+
+    // https://www.public-software-group.org/pub/projects/utf8proc/v1.1.5/utf8proc-v1.1.5.tar.gz
+    private static final String SOURCE_DIGEST = "5e437f8ae4b0ecfd076c57e4a9e43e5a3f20fc10649e95b4c34ee6b2da7346a0";
+
+    private SearchUnicodeDataGenerator() { }
+
+    public static void main(final String[] args) throws Exception {
+        final ToolArgs toolArgs = ToolArgs.parse(args);
+        final byte[] source = Files.readAllBytes(Path.of(toolArgs.require("source", "Pass utf8proc 1.1.5 utf8proc_data.c.")));
+        if (!SOURCE_DIGEST.equals(HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(source)))) {
+            throw new IllegalArgumentException("Search normalization requires the pinned utf8proc 1.1.5 data");
+        }
+        final String text = new String(source, StandardCharsets.UTF_8);
+        final int[] sequences = integers(section(text, "utf8proc_sequences"));
+        final int[] stage1 = integers(section(text, "utf8proc_stage1table"));
+        final int[] stage2 = integers(section(text, "utf8proc_stage2table"));
+        final int[] combinations = integers(section(text, "utf8proc_combinations"));
+        final var properties = new ArrayList<Property>();
+        final var rows = Pattern.compile("\\{([^{}]+)}").matcher(section(text, "utf8proc_properties"));
+        while (rows.find()) {
+            final String[] fields = rows.group(1).split(",");
+            properties.add(new Property(Integer.parseInt(fields[1].trim()), Integer.parseInt(fields[9].trim()),
+                    Integer.parseInt(fields[10].trim()), Boolean.parseBoolean(fields[11].trim()),
+                    sequence(fields[4].trim(), sequences), fields.length > 15 ? sequence(fields[15].trim(), sequences) : new int[0]));
+        }
+        if (stage1.length != 4352 || stage2.length != 23296 || properties.size() != 5618 || combinations.length != 22500) {
+            throw new IllegalArgumentException("Unexpected pinned Unicode table dimensions");
+        }
+        final List<Integer> points = new ArrayList<>();
+        for (int codePoint = 0; codePoint < 0x110000; codePoint++) {
+            if (properties.get(stage2[stage1[codePoint >> 8] + (codePoint & 255)]).needed()) {
+                points.add(codePoint);
+            }
+        }
+        final Path output = toolArgs.path("output", ToolPaths.ASSETS.resolve("data/search_unicode_5_0.bin.gz"));
+        Files.createDirectories(output.toAbsolutePath().getParent());
+        try (var data = new DataOutputStream(new GZIPOutputStream(Files.newOutputStream(output)))) {
+            data.writeInt(points.size());
+            for (final int codePoint : points) {
+                final Property property = properties.get(stage2[stage1[codePoint >> 8] + (codePoint & 255)]);
+                data.writeInt(codePoint);
+                data.writeInt(property.combining);
+                data.writeInt(property.first);
+                data.writeInt(property.second);
+                data.writeInt(property.excluded ? 1 : 0);
+                writeSequence(data, property.decomposition);
+                writeSequence(data, property.fold);
+            }
+            writeSequence(data, combinations);
+        }
+    }
+
+    private static String section(final String source, final String name) {
+        final String prefix = name + "[] = {";
+        final int start = source.indexOf(prefix);
+        if (start < 0) {
+            throw new IllegalArgumentException("Missing Unicode table " + name);
+        }
+        return source.substring(start + prefix.length(), source.indexOf("};", start));
+    }
+
+    private static int[] integers(final String source) {
+        return Arrays.stream(source.split(",")).map(String::trim).filter(value -> !value.isEmpty()).mapToInt(Integer::parseInt).toArray();
+    }
+
+    private static int[] sequence(final String pointer, final int[] sequences) {
+        if ("NULL".equals(pointer)) {
+            return new int[0];
+        }
+        final String prefix = "utf8proc_sequences + ";
+        if (!pointer.startsWith(prefix)) {
+            throw new IllegalArgumentException("Unexpected Unicode sequence pointer");
+        }
+        final int first = Integer.parseInt(pointer.substring(prefix.length()));
+        int end = first;
+        while (sequences[end] != -1) {
+            end++;
+        }
+        return Arrays.copyOfRange(sequences, first, end);
+    }
+
+    private static void writeSequence(final DataOutputStream output, final int[] sequence) throws IOException {
+        output.writeInt(sequence.length);
+        for (final int part : sequence) {
+            output.writeInt(part);
+        }
+    }
+
+    private record Property(int combining, int first, int second, boolean excluded, int[] decomposition, int[] fold) {
+
+        private boolean needed() {
+            return this.combining != 0 || this.first >= 0 || this.second >= 0 || this.excluded
+                    || this.decomposition.length != 0 || this.fold.length != 0;
+        }
+
+    }
+
+}
