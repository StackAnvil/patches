+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class UiAsepriteMetadataTest {
+
+    @Test
+    void retainsNativeOriginsDurationsAndAtlasDimensionsThroughProgramTransport() {
+        final String path = "textures/tips/example";
+        final var metadata = metadata();
+        metadata.addProperty("base_size", 999);
+        metadata.addProperty("nineslice_size", 7);
+        final var program = new JsonUiProgram(List.of(Map.of(path + ".json", metadata.toString().getBytes(StandardCharsets.UTF_8),
+                "ui/server_form.json", """
+                        {"namespace":"server_form","frames":{"anim_type":"aseprite_flip_book"},
+                         "main_screen_content":{"type":"panel","controls":[
+                          {"image":{"type":"image","texture":"textures/tips/example","uv":"@server_form.frames","uv_size":[74,64]}},
+                          {"button":{"type":"button","collection_name":"form_buttons","collection_index":0,"$pressed_button_name":"button.form_button_click"}}]}}
+                        """.getBytes(StandardCharsets.UTF_8))));
+        final var form = JsonParser.parseString("{\"type\":\"form\",\"title\":\"\",\"elements\":[{\"type\":\"button\",\"text\":\"\"}]}").getAsJsonObject();
+        final var scene = new ServerFormUi(program).resolve(form);
+        assertNotNull(scene);
+        final var transported = ServerFormUi.fromProgram(program.export(java.util.Set.of("server_form.main_screen_content", "server_form.frames"), form)).resolve(form);
+        assertEquals(scene, transported);
+        final var root = scene.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(UiAsepriteMetadata.resolve(metadata), root.getAsJsonObject("aseprite"));
+        assertFalse(root.has("base_size"));
+        assertFalse(root.has("nineslice_size"));
+        final var parsed = root.getAsJsonObject("aseprite");
+        assertEquals(222, parsed.getAsJsonArray("size").get(0).getAsFloat());
+        assertEquals(2, parsed.getAsJsonArray("frames").size());
+        assertEquals(84, parsed.getAsJsonArray("frames").get(1).getAsJsonArray().get(0).getAsInt());
+        assertEquals(200, parsed.getAsJsonArray("frames").get(1).getAsJsonArray().get(2).getAsInt());
+    }
+
+    @Test
+    void rejectsAnEntireSequenceRatherThanKeepingPartialFrames() {
+        for (int field = 0; field < 3; field++) {
+            final var input = metadata();
+            final var frame = input.getAsJsonArray("frames").get(1).getAsJsonObject();
+            if (field == 0) {
+                frame.addProperty("duration", 0);
+            } else {
+                frame.getAsJsonObject("frame").addProperty(field == 1 ? "x" : "y", -1);
+            }
+            final var parsed = UiAsepriteMetadata.resolve(input);
+            assertEquals(0, parsed.getAsJsonArray("size").get(0).getAsFloat());
+            assertTrue(parsed.getAsJsonArray("frames").isEmpty());
+        }
+        for (final var malformed : List.of(JsonParser.parseString("{}"), JsonParser.parseString("1"), JsonParser.parseString("null"))) {
+            final var input = metadata();
+            input.add("meta", malformed);
+            assertTrue(UiAsepriteMetadata.resolve(input).getAsJsonArray("frames").isEmpty());
+        }
+        final var input = metadata();
+        input.getAsJsonObject("meta").remove("image");
+        assertTrue(UiAsepriteMetadata.resolve(input).getAsJsonArray("frames").isEmpty());
+    }
+
+    @Test
+    void emptySequencesRetainDimensionsAndFlagsDoNotChangeNativeOrigins() {
+        final var input = metadata();
+        final var frame = input.getAsJsonArray("frames").get(0).getAsJsonObject();
+        final var expected = UiAsepriteMetadata.resolve(input);
+        frame.addProperty("rotated", true);
+        frame.addProperty("trimmed", true);
+        frame.add("spriteSourceSize", JsonParser.parseString("{\"x\":123,\"y\":456}"));
+        frame.getAsJsonObject("frame").addProperty("w", 17);
+        frame.getAsJsonObject("frame").addProperty("h", 19);
+        assertEquals(expected, UiAsepriteMetadata.resolve(input));
+        input.remove("frames");
+        final var parsed = UiAsepriteMetadata.resolve(input);
+        assertEquals(222, parsed.getAsJsonArray("size").get(0).getAsFloat());
+        assertTrue(parsed.getAsJsonArray("frames").isEmpty());
+    }
+
+    private static JsonObject metadata() {
+        final var metadata = new JsonObject();
+        final var meta = new JsonObject();
+        meta.addProperty("image", "example.png");
+        final var size = new JsonObject();
+        size.addProperty("w", 222);
+        size.addProperty("h", 64);
+        meta.add("size", size);
+        metadata.add("meta", meta);
+        final var frames = new JsonArray();
+        for (int index = 0; index < 2; index++) {
+            final var frame = new JsonObject();
+            final var origin = new JsonObject();
+            origin.addProperty("x", 10 + 74 * index);
+            origin.addProperty("y", 0);
+            frame.add("frame", origin);
+            frame.addProperty("duration", index == 0 ? 500 : 200);
+            frames.add(frame);
+        }
+        metadata.add("frames", frames);
+        return metadata;
+    }
+
+}
