+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class CookingRecipeOrderTest {
+
+    @Test
+    void registryOrderUsesUtf8KeysAndRejectsAmbiguousRegistrySnapshots() {
+        final var entries = List.of(new KeyedEntry(2, new String(Character.toChars(0x10000))),
+                new KeyedEntry(1, new String(Character.toChars(0xE000))), new KeyedEntry(0, Character.toString(0x7A)));
+        final var ordered = CookingRecipeOrder.registryOrder(entries, KeyedEntry::key);
+        assertEquals(List.of(0, 1, 2), ordered.stream().map(KeyedEntry::identity).toList());
+        assertEquals(List.of(2, 1, 0), entries.stream().map(KeyedEntry::identity).toList());
+        assertThrows(UnsupportedOperationException.class, () -> ordered.add(entries.getFirst()));
+        assertThrows(IllegalArgumentException.class, () -> CookingRecipeOrder.registryOrder(
+                List.of(entries.getFirst(), new KeyedEntry(3, entries.getFirst().key)), KeyedEntry::key));
+    }
+
+    @Test
+    void matchesNativePriorityTiesAtInsertionPartitionBoundary() {
+        final List<Entry> entries = IntStream.range(0, 33).mapToObj(index -> new Entry(index, index % 3)).toList();
+        assertArrayEquals(new int[]{0, 21, 30, 3, 12, 27, 6, 15, 24, 9, 18, 1, 4, 7, 10, 13, 16, 19, 22, 25, 28, 31,
+            14, 23, 8, 17, 26, 5, 20, 29, 2, 11, 32},
+                CookingRecipeOrder.sorted(entries, Entry::priority).stream().mapToInt(Entry::identity).toArray());
+        assertEquals(entries.subList(0, 32).stream().sorted(java.util.Comparator.comparingInt(Entry::priority)).toList(),
+                CookingRecipeOrder.sorted(entries.subList(0, 32), Entry::priority));
+    }
+
+    @Test
+    void partitionsTheNativeVisiblePrefixWithoutLosingStableIdentityOrder() {
+        final List<Entry> entries = List.of(new Entry(0, 2), new Entry(1, 0), new Entry(2, 3),
+                new Entry(3, 1), new Entry(4, 2), new Entry(5, 0), new Entry(6, 1));
+        // Pinned native collection refresh, with identical evaluator results.
+        assertEquals(List.of(1, 5, 0, 3, 4, 6), CookingRecipeOrder.visibleOrder(entries, Entry::priority, false)
+                .stream().map(Entry::identity).toList());
+        assertEquals(List.of(1, 5, 3, 6, 0, 4), CookingRecipeOrder.visibleOrder(entries, Entry::priority, true)
+                .stream().map(Entry::identity).toList());
+        assertEquals(IntStream.range(0, entries.size()).boxed().toList(), entries.stream().map(Entry::identity).toList());
+        final List<Entry> hidden = List.of(new Entry(0, 3));
+        for (final boolean filtering : new boolean[]{false, true}) {
+            assertTrue(CookingRecipeOrder.visibleOrder(hidden, Entry::priority, filtering).isEmpty());
+            for (final int invalid : new int[]{Integer.MIN_VALUE, -1, 4, Integer.MAX_VALUE}) {
+                assertThrows(IllegalArgumentException.class, () -> CookingRecipeOrder.visibleOrder(
+                        List.of(new Entry(0, invalid)), Entry::priority, filtering));
+            }
+        }
+    }
+
+    @Test
+    void preservesIdentitiesAndSignedPriorityOrderingAcrossPivotBoundaries() {
+        final Random random = new Random(51061372);
+        for (final int size : new int[]{0, 1, 32, 33, 40, 41, 42, 43, 127, 1024}) {
+            final List<Entry> entries = new ArrayList<>();
+            for (int index = 0; index < size; index++) {
+                entries.add(new Entry(index, index % 5 == 0 ? Integer.MIN_VALUE : index % 5 == 1 ? Integer.MAX_VALUE : random.nextInt(7) - 3));
+            }
+            final var ordered = CookingRecipeOrder.sorted(entries, Entry::priority);
+            assertEquals(entries.stream().map(Entry::identity).collect(java.util.stream.Collectors.toSet()),
+                    ordered.stream().map(Entry::identity).collect(java.util.stream.Collectors.toSet()));
+            assertEquals(entries.size(), ordered.size());
+            for (int index = 1; index < size; index++) {
+                assertTrue(ordered.get(index - 1).priority <= ordered.get(index).priority);
+            }
+            assertEquals(IntStream.range(0, size).boxed().toList(), entries.stream().map(Entry::identity).toList());
+        }
+    }
+
+    private record Entry(int identity, int priority) { }
+
+    private record KeyedEntry(int identity, String key) { }
+
+}
