+
+class NativeCookingMessageTest {
+
+    @BeforeAll
+    static void initializeItemCodecs() throws ClassNotFoundException {
+        Class.forName(StructuredDataKey.class.getName());
+    }
+
+    @Test
+    void wireSnapshotsResolveTheSameAuthoredScenesWithoutNarrowingRawAuthorityOrProgress() {
+        final var ui = new CookingUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        for (final var family : CookingUi.Family.values()) {
+            final var view = view(family);
+            final var message = NativeCookingMessage.create(ui, view, Long.MAX_VALUE, Long.MAX_VALUE,
+                    1L << 40, 1L << 48, Long.MAX_VALUE, items());
+            final var wire = Unpooled.buffer();
+            try {
+                NativeCookingMessage.TYPE.write(wire, message);
+                final var decoded = NativeCookingMessage.TYPE.read(wire);
+                assertEquals(message.program(), decoded.program());
+                assertEquals(message.snapshot(), decoded.snapshot());
+                assertEquals(message.sequence(), decoded.sequence());
+                assertEquals(message.updateSequence(), decoded.updateSequence());
+                assertEquals(message.menuRevision(), decoded.menuRevision());
+                assertEquals(message.inventoryRevision(), decoded.inventoryRevision());
+                assertEquals(message.cursorRevision(), decoded.cursorRevision());
+                final var rewritten = Unpooled.buffer();
+                try {
+                    NativeCookingMessage.TYPE.write(rewritten, decoded);
+                    assertEquals(wire.toString(0, wire.writerIndex(), StandardCharsets.ISO_8859_1),
+                            rewritten.toString(StandardCharsets.ISO_8859_1));
+                } finally {
+                    rewritten.release();
+                }
+                assertFalse(wire.isReadable());
+                assertEquals(view, decoded.view());
+                final var replay = CookingUi.fromProgram(JsonParser.parseString(decoded.program()).getAsJsonObject());
+                assertEquals(ui.resolve(view), replay.resolve(decoded.view()));
+                assertEquals(CookingUi.actionScope(ui.resolve(view), view.book()),
+                        CookingUi.actionScope(replay.resolve(decoded.view()), decoded.view().book()));
+            } finally {
+                wire.release();
+            }
+        }
+    }
+
+    @Test
+    void snapshotsRetainHiddenAndLockedCatalogEntriesWithoutLeakingMutableJson() {
+        final var source = view(CookingUi.Family.FURNACE);
+        final var ui = new CookingUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        final var message = NativeCookingMessage.create(ui, source, 1, 1, 0, 0, 0, items());
+        final var expected = message.view();
+        final var decoded = message.view();
+        assertEquals(3, decoded.book().catalog().size());
+        assertEquals(Set.of(7), decoded.book().visibleRecipes());
+        assertEquals(2, decoded.book().recipes().size());
+        assertEquals(new CookingUi.Selection("recipe_book", 0), decoded.book().selection());
+        assertFalse(decoded.book().catalog().getFirst().unlocked());
+        decoded.slots().getFirst().presentation().get("#item_renderer_data").getAsJsonObject().addProperty("inventory_slot", 38);
+        decoded.cursor().get("#item_renderer_data").getAsJsonObject().addProperty("inventory_slot", 38);
+        decoded.book().catalog().getLast().presentation().get("#item_renderer_data").getAsJsonObject().addProperty("recipe_id", 100);
+        assertEquals(expected, message.view());
+        assertEquals(source, message.view());
