+    @Test
+    void dynamicControlArraysReceiveTheSameDescendantOverrides() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"panel","controls":"$rows"},
+                 "icon":{"type":"image","texture":"textures/ui/probe","size":[8,8]},
+                 "root/leaf":{"alpha":0.3}}
+                """);
+        final var bindings = new Bindings();
+        bindings.globals().put("$rows", JsonParser.parseString("[{\"leaf@example.icon\":{}}]"));
+        final var child = ui.resolve("example.root", bindings).root().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(0.3F, child.get("alpha").getAsFloat());
+        assertEquals(JsonParser.parseString("[8,8]"), child.get("size"));
+    }
+
+    private static final class Bindings implements UiBindings {
+
+        private final Map<String, Integer> collectionReads = new HashMap<>();
+        private final Map<String, JsonElement> globals = new HashMap<>(Map.of("#kinds", JsonParser.parseString("[\"caption\",\"caption\"]")));
+
+        @Override
+        public Map<String, JsonElement> globals() {
+            return this.globals;
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "first";
+        }
+
+        @Override
+        public boolean ownsCollection(final String name) {
+            return Set.of("first", "second", "options").contains(name);
+        }
+
+        @Override
+        public Collection collection(final String name, final Scope parent) {
+            this.collectionReads.merge(name, 1, Integer::sum);
+            final List<Map<String, JsonElement>> rows = switch (name) {
+                case "first" -> List.of(Map.of("#caption", new JsonPrimitive("first-0")), Map.of("#caption", new JsonPrimitive("first-1")));
+                case "second" -> List.of(Map.of("#caption", new JsonPrimitive("second-0")));
+                case "options" -> List.of(Map.of("#caption", new JsonPrimitive(parent.collection() + "-" + parent.index() + "-option")));
+                default -> throw new IllegalArgumentException("Unsupported collection");
+            };
+            return new Collection(rows, Map.of("#total", new JsonPrimitive(rows.size())));
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            if (scope == null) {
+                return Map.of();
+            }
+            final String caption = scope.collection().equals("options")
+                    ? scope.parent().collection() + "-" + scope.parent().index() + "-option" : scope.collection() + "-" + scope.index();
+            return Map.of("#caption", new JsonPrimitive(caption));
+        }
+
+        @Override
+        public Map<String, JsonElement> bindings(final Scope scope) {
+            final Map<String, JsonElement> result = new HashMap<>(this.globals());
+            result.putAll(this.variables(scope));
+            return result;
+        }
+
+        @Override
+        public String factoryKey() {
+            return "";
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            if (scope != null && scope.parent() != null) {
+                node.addProperty("parent_collection", scope.parent().collection());
+                node.addProperty("parent_index", scope.parent().index());
+            }
+        }
+    }
+
+}
