+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ServerCustomFormUiTest {
+
+    private static ServerFormUi ui() {
+        return ui(Map.of());
+    }
+
+    private static ServerFormUi ui(final Map<String, String> translations) {
+        final String definitions = """
+                {"namespace":"server_form",
+                 "main_screen_content":{"type":"factory","control_ids":{"custom_form":"@server_form.custom","long_form":"@server_form.action"}},
+                 "custom":{"type":"stack_panel","factory":{"control_ids":{"label":"@server_form.label","header":"@server_form.label","divider":"@server_form.label","toggle":"@server_form.toggle","input":"@server_form.input","slider":"@server_form.slider","step_slider":"@server_form.step","dropdown":"@server_form.dropdown"}},
+                   "bindings":[{"binding_name":"#custom_form_length","binding_name_override":"#collection_length"}],
+                   "controls":[{"submit":{"type":"button","$pressed_button_name":"button.submit_custom_form"}}]},
+                 "label":{"type":"label","text":"#custom_text"},
+                 "toggle":{"type":"toggle","$state_binding":"#custom_toggle_state","$enabled_type":"none","$bag":{"#enabled":true},"property_bag":"$bag",
+                   "bindings":[{"binding_name":"$state_binding","binding_name_override":"#toggle_state"},{"binding_name":"#missing","binding_name_override":"#enabled","binding_type":"$enabled_type"},
+                     {"binding_name":"#missing","binding_name_override":"#toggle_state","ignored":true}]},
+                 "input":{"type":"edit_box","bindings":[{"binding_name":"#custom_input_text","binding_name_override":"#text_edit_box_text"}]},
+                 "slider":{"type":"slider","bindings":[{"binding_name":"#custom_slider_value","binding_name_override":"#slider_value"}],"controls":[{"caption":{"type":"label","text":"#custom_slider_text"}}]},
+                 "step":{"type":"slider","$enabled_type|default":"none","$enabled_type":"$enabled_type",
+                   "bindings":[{"binding_name":"#custom_slider_step_value","binding_name_override":"#slider_value"},{"binding_name":"#missing","binding_name_override":"#enabled","binding_type":"$enabled_type"}],
+                   "controls":[{"caption":{"type":"label","text":"#custom_slider_step_text"}}]},
+                 "dropdown":{"type":"panel","controls":[{"expand":{"type":"toggle"}},{"options":{"type":"stack_panel","visible":"#custom_dropdown","collection_name":"custom_dropdown","factory":{"control_name":"@server_form.option"}}}]},
+                 "option":{"type":"toggle","bindings":[{"binding_name":"#custom_radio_toggled","binding_name_override":"#toggle_state"}],"controls":[{"label":{"type":"label","text":"#custom_radio_text","bindings":[{"binding_name":"#custom_radio_text","binding_name_override":"#text"}]}}]}}
+                """;
+        return new ServerFormUi(List.of(Map.of("ui/server_form.json", definitions.getBytes(StandardCharsets.UTF_8))), key -> translations.getOrDefault(key, key));
+    }
+
+    private static JsonObject form() {
+        return JsonParser.parseString("""
+                {"type":"custom_form","title":"Settings","content":[
+                  {"type":"header","text":"Heading"},{"type":"toggle","text":"Toggle","default":true},
+                  {"type":"label","text":"Prose"},{"type":"input","text":"Name","default":"Name"},
+                  {"type":"slider","text":"Range","min":3,"max":8},{"type":"step_slider","text":"Step","steps":["A","B","C"],"default":1},
+                  {"type":"divider"},{"type":"dropdown","text":"Choice","options":["A","B","C"],"default":2}]}
+                """).getAsJsonObject();
+    }
+
+    private static List<JsonObject> nodes(final JsonObject node) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(node);
+        if (node.has("children")) {
+            node.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        }
+        return result;
+    }
+
+    @Test
+    void stateRetainsOriginalNullSlotsAndTypedDefaults() {
+        final JsonArray state = ServerFormUi.responseValues(form(), null);
+        assertEquals(8, state.size());
+        assertTrue(state.get(0).isJsonNull());
+        assertTrue(state.get(2).isJsonNull());
+        assertTrue(state.get(6).isJsonNull());
+        assertTrue(state.get(1).getAsBoolean());
+        assertEquals(3, state.get(4).getAsInt());
+        assertEquals(1, state.get(5).getAsInt());
+        assertEquals(2, state.get(7).getAsInt());
+        final JsonArray changed = state.deepCopy();
+        changed.set(1, JsonParser.parseString("false"));
+        changed.set(3, JsonParser.parseString("\"Edited\""));
+        changed.set(7, JsonParser.parseString("0"));
+        assertEquals(changed, ServerFormUi.responseValues(form(), changed));
+        assertEquals(2, state.get(7).getAsInt());
+    }
+
+    @Test
+    void typedFactoryAndNestedOptionsReResolveThroughTheSameProgram() {
+        final JsonObject first = ui().resolve(form());
+        assertNotNull(first);
+        assertEquals(2, first.get("format").getAsInt());
+        assertEquals(8, first.getAsJsonArray("inputs").size());
+        final List<JsonObject> initialNodes = nodes(first.getAsJsonObject("root"));
+        assertTrue(initialNodes.stream().filter(node -> node.has("input")).allMatch(node -> node.get("enabled").getAsBoolean()));
+        assertTrue(initialNodes.stream().anyMatch(node -> node.has("command") && node.get("command").getAsString().equals("submit")));
+        assertEquals(Set.of(1, 3, 4, 5, 7), initialNodes.stream().filter(node -> node.has("input"))
+                .map(node -> node.getAsJsonObject("input").get("index").getAsInt()).collect(java.util.stream.Collectors.toSet()));
+        final JsonObject program = first.getAsJsonObject("program");
+        final ServerFormUi replay = ServerFormUi.fromProgram(program);
+        final JsonArray changed = first.getAsJsonArray("values").deepCopy();
+        changed.set(7, JsonParser.parseString("1"));
+        final JsonObject open = replay.resolve(program.getAsJsonObject("form"), changed, Set.of(7));
+        assertNotNull(open);
+        final List<JsonObject> options = nodes(open.getAsJsonObject("root")).stream()
+                .filter(node -> node.has("input") && node.getAsJsonObject("input").has("option")).toList();
+        assertEquals(3, options.size());
+        assertEquals(List.of(0, 1, 2), options.stream().map(node -> node.getAsJsonObject("input").get("option").getAsInt()).toList());
+        assertTrue(options.stream().allMatch(node -> node.getAsJsonObject("input").get("index").getAsInt() == 7));
+        assertEquals(List.of(false, true, false), options.stream().map(node -> node.get("toggle_state").getAsBoolean()).toList());
+        assertEquals(first.getAsJsonArray("values").get(7).getAsInt(), 2);
+    }
+
+    @Test
+    void localizedSliderCaptionsUseTheSameSerializedLanguageAfterStateChanges() {
+        final JsonObject form = form();
+        form.getAsJsonArray("content").get(4).getAsJsonObject().addProperty("step", 0.5F);
+        final JsonObject first = ui(Map.of("options.sliderLabelFormat", "%2 / %1")).resolve(form);
+        assertNotNull(first);
+        final List<String> captions = nodes(first.getAsJsonObject("root")).stream().filter(node -> node.has("text"))
+                .map(node -> node.get("text").getAsString()).toList();
+        assertTrue(captions.contains("3.000000 / Range"));
+        assertTrue(captions.contains("B / Step"));
+        final JsonArray changed = first.getAsJsonArray("values").deepCopy();
+        changed.set(4, JsonParser.parseString("3.5"));
+        changed.set(5, JsonParser.parseString("2"));
+        final JsonObject program = first.getAsJsonObject("program");
+        final JsonObject edited = ServerFormUi.fromProgram(program).resolve(program.getAsJsonObject("form"), changed, Set.of());
+        assertNotNull(edited);
+        final List<String> updated = nodes(edited.getAsJsonObject("root")).stream().filter(node -> node.has("text"))
+                .map(node -> node.get("text").getAsString()).toList();
+        assertTrue(updated.contains("3.500000 / Range"));
+        assertTrue(updated.contains("C / Step"));
+        assertEquals(first.getAsJsonArray("values").get(5).getAsInt(), 1);
+    }
+
+    @Test
+    void malformedStateAndUnsupportedElementsDoNotLoseResponsePositions() {
+        final JsonObject form = form();
+        final JsonArray state = ServerFormUi.responseValues(form, null);
+        state.set(0, JsonParser.parseString("1"));
+        assertThrows(IllegalArgumentException.class, () -> ServerFormUi.responseValues(form, state));
+        assertNull(ui().resolve(form, state, Set.of()));
+        assertThrows(IllegalArgumentException.class, () -> ServerFormUi.responseValues(form, new JsonArray()));
+        form.getAsJsonArray("content").get(7).getAsJsonObject().addProperty("type", "multiselect");
+        assertNull(ui().resolve(form));
+    }
+
+}
