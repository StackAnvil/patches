+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/**
+ * A native command and event phase refer to one exact server-owned presentation and inventory snapshot.
+ * The controller mode is its native active-device lookup result, separate from the command and phase.
+ * Neither field establishes a physical event mapping or transfer quantity.
+ */
+public record NativeCookingAction(int menuId, long sequence, long updateSequence, long menuRevision,
+                                  long inventoryRevision, long cursorRevision, int recipeId, Mode mode,
+                                  int controllerInputMode, int eventPhase, long requestSequence) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking_action_v5";
+    static final int MAX_ENCODED_BYTES = 83;
+    public static final Type<NativeCookingAction> TYPE = new Type<>(NativeCookingAction.class) {
+        @Override
+        public NativeCookingAction read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_ENCODED_BYTES || Types.VAR_INT.readPrimitive(buffer) != 5
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native cooking action");
+            }
+            final var action = new NativeCookingAction(Types.VAR_INT.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_INT.readPrimitive(buffer), Mode.read(buffer.readUnsignedByte()),
+                    buffer.readUnsignedByte(), buffer.readUnsignedByte(), Types.VAR_LONG.readPrimitive(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native cooking action fields");
+            }
+            return action;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCookingAction action) {
+            Types.VAR_INT.writePrimitive(buffer, 5);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, action.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, action.sequence);
+            Types.VAR_LONG.writePrimitive(buffer, action.updateSequence);
+            Types.VAR_LONG.writePrimitive(buffer, action.menuRevision);
+            Types.VAR_LONG.writePrimitive(buffer, action.inventoryRevision);
+            Types.VAR_LONG.writePrimitive(buffer, action.cursorRevision);
+            Types.VAR_INT.writePrimitive(buffer, action.recipeId);
+            buffer.writeByte(action.mode.wire);
+            buffer.writeByte(action.controllerInputMode);
+            buffer.writeByte(action.eventPhase);
+            Types.VAR_LONG.writePrimitive(buffer, action.requestSequence);
+        }
+    };
+
+    public NativeCookingAction {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || updateSequence <= 0
+                || menuRevision < 0 || inventoryRevision < 0 || cursorRevision < 0 || recipeId < 0 || mode == null
+                || controllerInputMode < 0 || controllerInputMode > 3 || eventPhase < 0 || eventPhase > 2 || requestSequence <= 0) {
+            throw new IllegalArgumentException("Invalid native cooking action identity");
+        }
+    }
+
+    /** Preserve the authored input command without assuming Java placement quantities. */
+    public enum Mode {
+        PRIMARY(0, "button.recipe_select"),
+        SECONDARY(1, "button.recipe_secondary"),
+        TERTIARY(2, "button.recipe_tertiary");
+
+        private final int wire;
+        private final String button;
+
+        Mode(final int wire, final String button) {
+            this.wire = wire;
+            this.button = button;
+        }
+
+        public String button() {
+            return this.button;
+        }
+
+        private static Mode read(final int wire) {
+            return switch (wire) {
+                case 0 -> PRIMARY;
+                case 1 -> SECONDARY;
+                case 2 -> TERTIARY;
+                default -> throw new IllegalArgumentException("Unknown native cooking input mode");
+            };
+        }
+    }
+
+}
