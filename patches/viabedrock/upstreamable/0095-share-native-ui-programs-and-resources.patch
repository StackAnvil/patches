+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.util.TextUtil;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Immutable loaded JSON UI declarations, resolved with a domain controller for each session. */
+public final class JsonUiProgram {
+
+    public static final int MAX_NODES = 8192;
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    private static final int MAX_FILE_BYTES = 1 << 20;
+    private static final Set<String> HOST_FILES = Set.of("ui/server_form.json", "ui/chest_screen.json", "ui/redstone_screen.json", "ui/inventory_screen.json", "ui/npc_interact_screen.json", "ui/hud_screen.json", "ui/ui_common.json", "ui/_global_variables.json");
+    private final Map<String, Definition> definitions = new LinkedHashMap<>();
+    private final Map<String, Definition> nativeDefinitions = new LinkedHashMap<>();
+    private final Map<String, JsonElement> globals = new HashMap<>();
+    private final Map<String, byte[]> textureFiles = new LinkedHashMap<>();
+    private final UiFonts fonts = new UiFonts();
+    private final Set<String> customizedFiles = new HashSet<>();
+    private final UnaryOperator<String> translator;
+    private final Map<Character, Integer> formattingColors;
+
+    public JsonUiProgram(final ResourcePackStorage storage) {
+        this.translator = storage.getTexts()::translate;
+        this.formattingColors = storage.getTextFormatting().colors();
+        final Map<String, byte[]> builtin = Builtins.FILES;
+        this.loadFiles(builtin, false);
+        UiTextures.load(builtin, this.textureFiles);
+        this.fonts.load(builtin);
+        for (final ResourcePack pack : storage.getPackStackBottomToTop()) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final String path : loadedPaths(pack)) {
+                final byte[] bytes = pack.content().get(path);
+                if (bytes != null && bytes.length <= MAX_FILE_BYTES) {
+                    files.put(path, bytes);
+                }
+            }
+            this.loadFiles(files, storage.isServerPack(pack));
+            final Map<String, byte[]> textures = new LinkedHashMap<>();
+            for (final String path : pack.content().getFilesDeep("textures/", "")) {
+                if (safePath(path)) {
+                    final byte[] bytes = pack.content().get(path);
+                    if (bytes.length <= 16 * MAX_FILE_BYTES && textures.size() < UiTextures.MAX_FILES) {
+                        textures.put(path, bytes);
+                    }
+                }
+            }
+            UiTextures.load(textures, this.textureFiles);
+            final Map<String, byte[]> fontFiles = new LinkedHashMap<>();
+            for (final String path : pack.content().getFilesDeep("font/", "")) {
+                final byte[] bytes = pack.content().get(path);
+                if (safePath(path) && bytes != null && bytes.length <= 16 * MAX_FILE_BYTES && fontFiles.size() < 256) {
+                    fontFiles.put(path, bytes);
+                }
+            }
+            this.fonts.load(fontFiles);
+        }
+    }
+
+    /** Test and tooling entry point. Files have the same load order as a resource-pack stack. */
+    public JsonUiProgram(final List<Map<String, byte[]>> layers) {
+        this(layers, UnaryOperator.identity(), Map.of());
+    }
+
+    /** Explicit native and accepted layers, preserving decoration provenance for tools and tests. */
+    public JsonUiProgram(final Map<String, byte[]> nativeFiles, final List<Map<String, byte[]>> acceptedLayers) {
+        this(List.of());
+        this.loadFiles(nativeFiles, false);
+        UiTextures.load(nativeFiles, this.textureFiles);
+        this.fonts.load(nativeFiles);
+        for (final var files : acceptedLayers) {
+            this.loadFiles(files, true);
+            UiTextures.load(files, this.textureFiles);
+            this.fonts.load(files);
+        }
+    }
+
+    /** Resolves the same resource-pack files with their language translations. */
+    public JsonUiProgram(final List<Map<String, byte[]>> layers, final UnaryOperator<String> translator) {
+        this(layers, translator, Map.of());
+    }
+
+    private JsonUiProgram(final List<Map<String, byte[]>> layers, final UnaryOperator<String> translator,
+                         final Map<Character, Integer> formattingColors) {
+        this.translator = translator;
+        this.formattingColors = formattingColors;
+        for (final Map<String, byte[]> files : layers) {
+            this.loadFiles(files, true);
+            UiTextures.load(files, this.textureFiles);
+            this.fonts.load(files);
+        }
+    }
+
+    public Map<String, byte[]> textures() {
+        return Collections.unmodifiableMap(this.textureFiles);
+    }
+
+    public Map<String, byte[]> fontResources() {
+        return this.fonts.resources();
+    }
+
+    public static JsonUiProgram fromProgram(final JsonObject program) {
+        if (program.toString().getBytes(StandardCharsets.UTF_8).length > MAX_PAYLOAD_BYTES
+                || !program.has("definitions") || !program.get("definitions").isJsonObject()) {
+            throw new IllegalArgumentException("Invalid UI program");
+        }
+        final JsonObject translations = program.has("translations") ? program.getAsJsonObject("translations") : new JsonObject();
+        final Map<Character, Integer> colors = new HashMap<>();
+        if (program.has("formatting_colors")) {
+            program.getAsJsonObject("formatting_colors").entrySet().forEach(entry -> {
+                if (entry.getKey().length() != 1) {
+                    throw new IllegalArgumentException("Invalid UI formatting color");
+                }
+                colors.put(entry.getKey().charAt(0), entry.getValue().getAsInt());
+            });
+        }
+        final JsonUiProgram ui = new JsonUiProgram(List.of(),
+                key -> translations.has(key) ? translations.get(key).getAsString() : key, Map.copyOf(colors));
+        final JsonObject definitions = program.getAsJsonObject("definitions");
+        if (definitions.size() > MAX_NODES) {
+            throw new IllegalArgumentException("Too many UI definitions");
+        }
+        for (final Map.Entry<String, JsonElement> entry : definitions.entrySet()) {
+            final JsonObject definition = entry.getValue().getAsJsonObject();
+            ui.definitions.put(entry.getKey(), new Definition(definition.getAsJsonObject("value").deepCopy(), string(definition, "parent")));
+        }
+        if (program.has("globals")) {
+            program.getAsJsonObject("globals").entrySet().forEach(entry -> ui.globals.put(entry.getKey(), entry.getValue().deepCopy()));
+        }
+        if (program.has("texture_metadata")) {
+            program.getAsJsonObject("texture_metadata").entrySet().forEach(entry -> {
+                if (!safePath(entry.getKey())) {
+                    throw new IllegalArgumentException("Invalid UI texture metadata");
+                }
+                ui.textureFiles.put(entry.getKey(), entry.getValue().toString().getBytes(StandardCharsets.UTF_8));
+            });
+        }
+
+        if (program.has("font_ids")) {
+            ui.fonts.importIds(program.getAsJsonObject("font_ids"));
+        }
+        if (program.has("font_line_heights")) {
+            ui.fonts.importLineHeights(program.getAsJsonObject("font_line_heights"));
+        }
+        return ui;
+    }
+
+    public boolean customizes(final String file) {
+        return this.customizedFiles.contains(file);
+    }
+
+    String translate(final String key) {
+        return this.translator.apply(key);
+    }
+
+    public Resolution resolve(final String reference, final UiBindings bindings) {
+        final Session session = new Session(bindings);
+        final JsonObject root = session.expand(reference, new JsonObject(), session.initial, null, null, 0);
+        return new Resolution(root, Set.copyOf(session.requiredDefinitions), Set.copyOf(session.missingTemplates));
+    }
+
+    /** Select accepted-pack visual additions without replaying the native default HUD or its factories. */
+    public Resolution resolveHudDecorations(final UiBindings bindings) {
+        final Session session = new Session(bindings);
+        final JsonObject selected = this.hudDecorationBranch("hud.root_panel", new JsonObject(), new JsonObject(),
+                session.initial, session.requiredDefinitions, new int[1], 0);
+        final JsonObject root = selected == null ? null : session.expand("hud.root_panel", selected, session.initial, null, null, 0);
+        return new Resolution(root, Set.copyOf(session.requiredDefinitions), Set.copyOf(session.missingTemplates));
+    }
+
+    private JsonObject hudDecorationBranch(final String reference, final JsonObject overrides, final JsonObject nativeOverrides,
+                                          final Map<String, JsonElement> inherited, final Set<String> required, final int[] count, final int depth) {
+        if (++count[0] > MAX_NODES || depth > 64) {
+            throw new IllegalArgumentException("HUD decoration exceeds limits");
+        }
+        final String[] parts = substitute(reference, inherited).split("@", 2);
+        final String declared = parts.length == 2 ? parts[1] : parts[0];
+        final String base = parts.length == 2 && !declared.contains(".")
+                ? UiExpression.text(inherited.get("$__namespace")) + "." + declared : declared;
+        final JsonObject template = this.template(base, new HashSet<>(), required);
+        if (template == null && parts.length == 2) {
+            return null;
+        }
+        final JsonObject control = template == null ? new JsonObject() : template;
+        merge(control, overrides);
+        applyModifications(control);
+        if (control.has("factory") || "factory".equals(string(control, "type"))
+                || control.has("collection_name") || control.has("collection_index")) {
+            return null;
+        }
+        final String type = control.has("type") ? string(control, "type") : "panel";
+        if (!Set.of("panel", "stack_panel", "image", "label").contains(type)) {
+            return null;
+        }
+        final Map<String, JsonElement> values = new HashMap<>(inherited);
+        if (template != null && base.contains(".")) {
+            values.put("$__namespace", new JsonPrimitive(base.substring(0, base.indexOf('.'))));
+        }
+        declarations(control, values);
+        if (!supportedHudBindings(control, values)) {
+            return null;
+        }
+        if (UiExpression.truth(resolveValue(control.get("ignored"), values, 0))) {
+            return null;
+        }
+        JsonObject original = nativeOverrides == null ? null : this.nativeTemplate(base, new HashSet<>());
+        if (nativeOverrides != null) {
+            if (original == null) {
+                original = new JsonObject();
+            }
+            merge(original, nativeOverrides);
+            applyModifications(original);
+        }
+        final Map<String, JsonObject> originalChildren = new HashMap<>();
+        if (original != null && original.has("controls") && original.get("controls").isJsonArray()) {
+            for (final JsonElement child : original.getAsJsonArray("controls")) {
+                child.getAsJsonObject().entrySet().forEach(entry -> originalChildren.put(entry.getKey(), entry.getValue().getAsJsonObject()));
+            }
+        }
+        final JsonElement rawChildren = resolveValue(control.get("controls"), values, 0);
+        final JsonArray selected = new JsonArray();
+        if (rawChildren.isJsonArray()) {
+            for (final JsonElement child : rawChildren.getAsJsonArray()) {
+                for (final var entry : child.getAsJsonObject().entrySet()) {
+                    try {
+                        final JsonObject branch = this.hudDecorationBranch(entry.getKey(), entry.getValue().getAsJsonObject(),
+                                originalChildren.get(entry.getKey()), values, required, count, depth + 1);
+                        if (branch != null) {
+                            final JsonObject declaration = new JsonObject();
+                            declaration.add(entry.getKey(), branch);
+                            selected.add(declaration);
+                        }
+                    } catch (final RuntimeException unsupported) {
+                        // An unsupported decoration cannot hide its independent supported siblings.
+                    }
+                }
+            }
+        }
+        if (selected.isEmpty()) {
+            if (!type.equals("label") && !type.equals("image") || control.equals(original)) {
+                return null;
+            }
+        }
+        control.add("controls", selected);
+        return control;
+    }
