+        final var rows = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertEquals(2, rows.size());
+        for (int row = 0; row < rows.size(); row++) {
+            final var buttons = rows.get(row).getAsJsonObject().getAsJsonArray("children");
+            assertEquals(3, buttons.size());
+            for (int index = 0; index < buttons.size(); index++) {
+                final var button = buttons.get(index).getAsJsonObject();
+                assertEquals(row, button.get("action").getAsInt());
+                assertEquals(index, button.getAsJsonArray("offset").get(0).getAsInt());
+            }
+        }
+    }
+
+    @Test
+    void countedControllerRowsBeyondItsDataHaveNoResponseIdentity() {
+        final var ui = new ServerFormUi(List.of(definitions("""
+                {"namespace":"server_form","third_party_server_screen":{"$screen_content":"server_form.main_screen_content"},
+                 "main_screen_content":{"type":"collection_panel","collection_name":"form_buttons",
+                   "property_bag":{"#collection_length":4},"factory":{"control_name":"server_form.button"}},
+                 "button":{"type":"button","$pressed_button_name":"button.form_button_click"}}
