+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.util.List;
+import java.util.Map;
+
+/** Controller data and semantic control annotations for one JSON UI resolution. */
+public interface UiBindings {
+
+    Map<String, JsonElement> globals();
+
+    String defaultCollection();
+
+    Collection collection(String name, Scope parent);
+
+    Map<String, JsonElement> variables(Scope scope);
+
+    Map<String, JsonElement> bindings(Scope scope);
+
+    String factoryKey();
+
+    void decorate(JsonObject node, JsonObject control, Map<String, JsonElement> resolved, Scope scope);
+
+    record Scope(String collection, int index, Scope parent) { }
+
+    record Collection(List<Map<String, JsonElement>> entries, Map<String, JsonElement> details) {
+
+        public Collection {
+            entries = entries.stream().map(Map::copyOf).toList();
+            details = Map.copyOf(details);
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpression.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpression.java
