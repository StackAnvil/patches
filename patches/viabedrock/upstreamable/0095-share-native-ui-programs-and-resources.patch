+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.StringTag;
+
+import java.util.List;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+import java.util.function.Supplier;
+
+/** Native unfiltered name selection. The definition owns ordinary names and localization. */
+public final class NativeItemNames {
+
+    private NativeItemNames() { }
+
+    /** Null selects the ordinary name; a present tag can select an empty custom name. */
+    public static String customName(final CompoundTag data, final boolean writtenBook) {
+        if (data == null) {
+            return null;
+        }
+        final CompoundTag display = data.get("display") instanceof CompoundTag value ? value : null;
+        if ((display == null || !display.contains("Name")) && (!writtenBook || !data.contains("title"))) {
+            return null;
+        }
+        final String name = string(display, "Name");
+        return writtenBook && name.isEmpty() ? string(data, "title") : name;
+    }
+
+    /** Registration, rather than stack count, controls whether the native item definition exists. */
+    public static String primary(final boolean registered, final CompoundTag data, final boolean writtenBook,
+                                 final Supplier<String> ordinaryName, final Function<String, String> translations,
+                                 final BiFunction<String, List<String>, String> formatter) {
+        if (!registered) {
+            return "";
+        }
+        final String custom = customName(data, writtenBook);
+        if (custom != null) {
+            return custom;
+        }
+        final String name = ordinaryName.get();
+        if (data == null || !(data.get("AppendCustomName") instanceof ByteTag append) || append.asByte() == 0) {
+            return name;
+        }
+        final String group = string(data, "GroupName");
+        if (!group.isEmpty()) {
+            return name + translations.apply(group);
+        }
+        final String body = string(data, "BodyID");
+        if (!body.isEmpty()) {
+            final String first = string(data, "ColorID");
+            final String second = string(data, "Color2ID");
+            final List<String> arguments = !first.isEmpty() && !second.isEmpty()
+                    ? List.of(translations.apply(first), translations.apply(second)) : List.of(translations.apply(first));
+            return name + formatter.apply(body, arguments);
+        }
+        return name + string(data, "CustomName");
+    }
+
+    private static String string(final CompoundTag data, final String key) {
+        return data != null && data.get(key) instanceof StringTag value ? value.getValue() : "";
+    }
+
+}
