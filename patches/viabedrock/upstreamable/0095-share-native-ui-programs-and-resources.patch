+               {"close":{"type":"button","button_mappings":[{"to_button_id":"button.menu_exit"}]}}]},
+             "cell":{"type":"button","$take":"button.container_take_half_place_one","button_mappings":[
+                {"from_button_id":"button.menu_select","to_button_id":"button.container_take_all_place_all"},
+                {"from_button_id":"button.menu_secondary_select","to_button_id":"$take"}],"controls":[
