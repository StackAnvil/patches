+ * Normalization adapted from utf8proc 1.1.5, Copyright (c) 2009
+ * Public Software Group e. V., Berlin, Germany, under the MIT license.
+ * The algorithm and Unicode data representation have been modified for Java.
+ * See META-INF/licenses/utf8proc.txt for both the software and Unicode notices.
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.fastutil.ints.IntArrayList;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.util.Objects;
+import java.util.zip.GZIPInputStream;
+
+/** The pinned native search uses Unicode 5.0 compatibility composition and case folding. */
+public final class NativeSearchNormalization {
+
+    private static final Property[] PROPERTIES = new Property[0x110000];
+    private static final int[] COMPOSITIONS;
+
+    static {
+        try (var input = new DataInputStream(new GZIPInputStream(Objects.requireNonNull(
+                NativeSearchNormalization.class.getResourceAsStream("/assets/viabedrock/data/search_unicode_5_0.bin.gz"))))) {
+            final int count = input.readInt();
+            for (int index = 0; index < count; index++) {
+                final int codePoint = input.readInt();
+                final int combining = input.readInt();
+                final int first = input.readInt();
+                final int second = input.readInt();
+                final boolean excluded = input.readInt() != 0;
+                PROPERTIES[codePoint] = new Property(combining, first, second, excluded, readSequence(input), readSequence(input));
+            }
+            COMPOSITIONS = readSequence(input);
+            if (input.read() != -1) {
+                throw new IOException("Unexpected search normalization data");
+            }
+        } catch (final IOException error) {
+            throw new ExceptionInInitializerError(error);
+        }
+    }
+
+    private NativeSearchNormalization() { }
+
+    /** Invalid UTF-8 preserves the complete input; successful normalization ends at the first NUL. */
+    public static byte[] normalize(final byte[] input) {
+        final var points = new IntArrayList(input.length);
+        for (int index = 0; index < input.length; ) {
+            final int lead = Byte.toUnsignedInt(input[index]);
+            final int length = lead < 0x80 ? 1 : lead >= 0xC0 && lead < 0xE0 ? 2
+                    : lead >= 0xE0 && lead < 0xF0 ? 3 : lead >= 0xF0 && lead < 0xF8 ? 4 : 0;
+            if (length == 0 || length > input.length - index) {
+                return input.clone();
+            }
+            int codePoint = lead & (length == 1 ? 0x7F : 0x7F >> length);
+            for (int part = 1; part < length; part++) {
+                final int next = Byte.toUnsignedInt(input[index + part]);
+                if ((next & 0xC0) != 0x80) {
+                    return input.clone();
+                }
+                codePoint = (codePoint << 6) | (next & 0x3F);
+            }
+            if (length > 1 && codePoint < (length == 2 ? 0x80 : length == 3 ? 0x800 : 0x10000)
+                    || codePoint >= 0x110000 || codePoint >= 0xD800 && codePoint < 0xE000
+                    || codePoint >= 0xFDD0 && codePoint < 0xFDF0 || (codePoint & 0xFFFF) >= 0xFFFE) {
+                return input.clone();
+            }
+            decompose(codePoint, points);
+            index += length;
+        }
+        for (int index = 1; index < points.size(); index++) {
+            final int combining = combining(points.getInt(index));
+            if (combining == 0) {
+                continue;
+            }
+            int position = index;
+            while (position > 0 && combining(points.getInt(position - 1)) > combining) {
+                final int previous = points.getInt(position - 1);
+                points.set(position - 1, points.getInt(position));
+                points.set(position, previous);
+                position--;
+            }
+        }
+        int count = 0;
+        int starter = -1;
+        int maximumCombining = -1;
+        for (int index = 0; index < points.size(); index++) {
+            final int codePoint = points.getInt(index);
+            final int combining = combining(codePoint);
+            if (starter >= 0 && combining > maximumCombining) {
+                final int composed = compose(points.getInt(starter), codePoint);
+                if (composed >= 0) {
+                    points.set(starter, composed);
+                    continue;
+                }
+            }
+            if (combining > 0) {
+                maximumCombining = Math.max(maximumCombining, combining);
+            } else {
+                starter = count;
+                maximumCombining = -1;
+            }
+            points.set(count++, codePoint);
+        }
+        final var output = new ByteArrayOutputStream();
+        for (int index = 0; index < count; index++) {
+            final int codePoint = points.getInt(index);
+            if (codePoint == 0) {
+                break;
+            }
+            if (codePoint < 0x80) {
+                output.write(codePoint);
+            } else if (codePoint < 0x800) {
+                output.write(0xC0 | codePoint >> 6);
+                output.write(0x80 | codePoint & 0x3F);
+            } else if (codePoint < 0x10000) {
+                output.write(0xE0 | codePoint >> 12);
+                output.write(0x80 | codePoint >> 6 & 0x3F);
+                output.write(0x80 | codePoint & 0x3F);
+            } else {
+                output.write(0xF0 | codePoint >> 18);
+                output.write(0x80 | codePoint >> 12 & 0x3F);
+                output.write(0x80 | codePoint >> 6 & 0x3F);
+                output.write(0x80 | codePoint & 0x3F);
+            }
+        }
+        return output.toByteArray();
+    }
+
+    private static void decompose(final int codePoint, final IntArrayList output) {
+        final int syllable = codePoint - 0xAC00;
+        if (syllable >= 0 && syllable < 11172) {
+            output.add(0x1100 + syllable / 588);
+            output.add(0x1161 + syllable % 588 / 28);
+            final int trailing = syllable % 28;
+            if (trailing != 0) {
+                output.add(0x11A7 + trailing);
+            }
+            return;
+        }
+        final Property property = PROPERTIES[codePoint];
+        if (property != null) {
+            final int[] sequence = property.fold.length != 0 ? property.fold : property.decomposition;
+            if (sequence.length != 0) {
+                for (final int part : sequence) {
+                    decompose(part, output);
+                }
+                return;
+            }
+        }
+        output.add(codePoint);
+    }
+
+    private static int combining(final int codePoint) {
+        final Property property = PROPERTIES[codePoint];
+        return property == null ? 0 : property.combining;
+    }
+
+    private static int compose(final int first, final int second) {
+        if (first >= 0x1100 && first < 0x1113 && second >= 0x1161 && second < 0x1176) {
+            return 0xAC00 + (first - 0x1100) * 588 + (second - 0x1161) * 28;
+        }
+        if (first >= 0xAC00 && first < 0xD7A4 && (first - 0xAC00) % 28 == 0 && second >= 0x11A7 && second < 0x11C3) {
+            return first + second - 0x11A7;
+        }
+        final Property start = PROPERTIES[first];
+        final Property end = PROPERTIES[second];
+        if (start == null || end == null || start.first < 0 || end.second < 0) {
+            return -1;
+        }
+        final int composed = COMPOSITIONS[start.first + end.second];
+        return composed >= 0 && (PROPERTIES[composed] == null || !PROPERTIES[composed].excluded) ? composed : -1;
+    }
+
+    private static int[] readSequence(final DataInputStream input) throws IOException {
+        final int[] sequence = new int[input.readInt()];
+        for (int index = 0; index < sequence.length; index++) {
+            sequence[index] = input.readInt();
+        }
+        return sequence;
+    }
+
+    private record Property(int combining, int first, int second, boolean excluded, int[] decomposition, int[] fold) { }
+
+}
