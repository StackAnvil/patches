+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/HudFactoryUi.java
@@ -0,0 +1,127 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.nio.charset.StandardCharsets;
+
+/** Resolves native HUD factories from the bundled and accepted HUD definitions. */
+public abstract class HudFactoryUi implements UiBindings {
+
+    private final Map<String, JsonElement> values;
+
+    private final String factoryName;
+    private final String controlKey;
+
+    protected HudFactoryUi(final String factoryName, final String controlKey, final Map<String, JsonElement> controllerValues) {
+        this.factoryName = factoryName;
+        this.controlKey = controlKey;
+        final JsonArray collection = new JsonArray();
+        collection.add(controlKey);
+        final var values = new HashMap<>(controllerValues);
+        values.put("#hud_visible", new JsonPrimitive(true));
+        values.put("#hud_alpha", new JsonPrimitive(1));
+        values.put("#hud_propagate_alpha", new JsonPrimitive(true));
+        values.put("#collection_length", collection);
+        this.values = Map.copyOf(values);
+    }
+
+    public JsonObject resolve(final JsonUiProgram program) {
+        try {
+            return this.resolveScene(program);
+        } catch (final RuntimeException unsupported) {
+            return null;
+        }
+    }
+
+    private JsonObject resolveScene(final JsonUiProgram program) {
+        final JsonUiProgram.Resolution resolution = program.resolveFactory("hud.root_panel", this.factoryName, this);
+        final JsonObject root = this.factoryBranches(resolution.root());
+        if (root == null || !resolution.missingTemplates().isEmpty()) {
+            return null;
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        if (scene.toString().getBytes(StandardCharsets.UTF_8).length > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            return null;
+        }
+        return scene;
+    }
+
+    private JsonObject factoryBranches(final JsonObject node) {
+        if (node == null || node.has("ignored") && node.get("ignored").getAsBoolean()
+                || node.has("visible") && !node.get("visible").getAsBoolean()) {
+            return null;
+        }
+        final JsonArray children = node.getAsJsonArray("children");
+        final boolean factory = this.factoryName.equals(node.has("factory_name") ? node.get("factory_name").getAsString() : "");
+        final JsonArray selected = new JsonArray();
+        if (children != null) {
+            for (final JsonElement child : children) {
+                final JsonObject branch = factory ? visibleBranch(child.getAsJsonObject()) : this.factoryBranches(child.getAsJsonObject());
+                if (branch != null) {
+                    selected.add(branch);
+                }
+            }
+        }
+        if (selected.isEmpty()) {
+            return null;
+        }
+        final JsonObject result = node.deepCopy();
