+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+
+import net.raphimc.viabedrock.protocol.storage.NpcDialogueStorage;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Server conversation bindings for the native NPC screen, independent of its authored layout. */
+public final class NpcDialogueUi {
+
+    private final JsonUiProgram program;
+
+    public NpcDialogueUi(final JsonUiProgram program) {
+        this.program = program;
+    }
+
+    public JsonObject resolve(
+            final NpcDialogueStorage.Session session,
+            final String name,
+            final String text,
+            final int variant,
+            final JsonObject actorData) {
+        final Controller controller = new Controller(session, name, text, variant, actorData);
+        final var resolution =
+                this.program.resolveScreen(
+                        "npc_interact.npc_screen", "npc_interact.npc_screen_contents", controller);
+        if (resolution.root() == null) {
+            throw new IllegalArgumentException("NPC screen has no content");
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.addProperty("response_id", session.responseIdentifier());
+        scene.add("root", resolution.root());
+        final JsonObject conversation = new JsonObject();
+        conversation.addProperty("title", name);
+        conversation.addProperty("content", text);
+        scene.add("conversation", conversation);
+        final JsonArray missing = new JsonArray();
+        resolution.missingTemplates().forEach(missing::add);
+        scene.add("missing_templates", missing);
+        if (scene.toString().getBytes(StandardCharsets.UTF_8).length
+                > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("NPC scene exceeds the payload limit");
+        }
+        return scene;
+    }
+
+    public static NpcDialogueUi fromProgram(final JsonObject program) {
+        return new NpcDialogueUi(JsonUiProgram.fromProgram(program));
+    }
+
+    public JsonObject resolve(final NpcEditorState state) {
+        return this.resolve(state, true);
+    }
+
+    public String placeholder(final NpcEditorState state, final int input) {
+        return this.program.translate(state.placeholderKey(input));
+    }
+
+    public JsonObject resolveLocal(final NpcEditorState state) {
+        return this.resolve(state, false);
+    }
+
+    private JsonObject resolve(final NpcEditorState state, final boolean exportProgram) {
+        final var resolution =
+                this.program.resolveScreen(
+                        "npc_interact.npc_screen",
+                        "npc_interact.npc_screen_contents",
+                        new NpcEditorBindings(state, this.program::translate));
+        if (resolution.root() == null) {
+            throw new IllegalArgumentException("NPC editor has no content");
+        }
+        final var document = new JsonObject();
+        document.addProperty("format", 2);
+        document.add("response_id", state.source().get("response_id"));
+        document.add("root", resolution.root());
+        final var conversation = new JsonObject();
+        conversation.addProperty("title", state.name());
+        document.add("conversation", conversation);
+        final var missing = new JsonArray();
+        resolution.missingTemplates().forEach(missing::add);
+        document.add("missing_templates", missing);
+        if (exportProgram) {
+            final var source = state.source();
+            final var keys = new JsonArray();
+            keys.add("npcscreen.basictitle");
+            keys.add("npcscreen.advancedtitle");
+            keys.add("npcscreen.addtext");
+            keys.add("npcscreen.action.command.placeholder");
+            source.add("translation_keys", keys);
+            final var exported = this.program.export(resolution.requiredDefinitions(), source);
+            exported.add("editor", source);
+            document.add("program", exported);
+        }
+        if (document.toString().getBytes(StandardCharsets.UTF_8).length
+                > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("NPC editor exceeds the payload limit");
+        }
+        return document;
+    }
+
+    private static final class Controller implements UiBindings {
+
+        private static final String BUTTONS = "student_buttons_collection";
+        private static final String SKINS = "skins_collection";
+        private final NpcDialogueStorage.Session session;
+        private final JsonObject portrait;
+        private final List<Map<String, JsonElement>> buttons;
+        private final List<Map<String, JsonElement>> skins;
+        private final Map<String, JsonElement> globals = new HashMap<>();
+
+        private Controller(
+                final NpcDialogueStorage.Session session,
+                final String name,
+                final String text,
+                final int variant,
+                final JsonObject actorData) {
+            this.session = session;
+            this.portrait = new JsonObject();
+            this.portrait.addProperty("unique_id", session.uniqueId());
+            this.portrait.addProperty("variant", variant);
+            this.portrait.add("actor_data", actorData.deepCopy());
+            final JsonArray skinList =
+                    actorData.has("skin_list")
+                            ? actorData.getAsJsonArray("skin_list")
+                            : new JsonArray();
+            if (skinList.size() > 256) {
+                throw new IllegalArgumentException("NPC appearance list exceeds its limit");
+            }
+            int selectedSkin = 0;
+            for (int index = 0; index < skinList.size(); index++) {
+                if (skinList.get(index)
+                                .getAsJsonObject()
+                                .get("variant")
+                                .getAsBigDecimal()
+                                .intValueExact()
+                        == variant) {
+                    selectedSkin = index;
+                    break;
+                }
+            }
+            this.skins =
+                    java.util.stream.IntStream.range(0, skinList.size())
+                            .mapToObj(
+                                    index ->
+                                            Map.<String, JsonElement>of(
+                                                    "#skin_index",
+                                                    new JsonPrimitive(index),
+                                                    "#skin_visible",
+                                                    new JsonPrimitive(true)))
+                            .toList();
+            this.buttons =
+                    session.buttons().stream()
+                            .map(
+                                    button ->
+                                            Map.<String, JsonElement>of(
+                                                    "#student_button_text",
+                                                            new JsonPrimitive(button.name()),
+                                                    "#student_button_visible",
+                                                            new JsonPrimitive(true),
+                                                    "#is_url_button",
+                                                            new JsonPrimitive(button.url() != null),
+                                                    "#is_command_button",
+                                                            new JsonPrimitive(
+                                                                    button.url() == null)))
+                            .toList();
+            this.globals.put("#title_text", new JsonPrimitive(name));
+            this.globals.put("#name_text", new JsonPrimitive(name));
+            this.globals.put("#dialogtext", new JsonPrimitive(text));
+            this.globals.put("#placeholder_dialog_text", new JsonPrimitive(""));
+            this.globals.put("#skin_index", new JsonPrimitive(selectedSkin));
+            this.globals.put(
+                    "#student_button_grid_dimensions", pair(3, (this.buttons.size() + 2) / 3));
+            this.globals.put("#skins_grid_dimensions", pair(4, (this.skins.size() + 3) / 4));
+            for (final String binding : List.of("#student_view_visible", "#student_model_update")) {
+                this.globals.put(binding, new JsonPrimitive(true));
+            }
+            for (final String binding
+                :
+                    List.of(
+                            "#teacher_view_visible",
+                            "#basic_visible",
+                            "#advanced_visible",
+                            "#maximized_edit_visible",
+                            "#im_reader_button_visible",
+                            "#tts_enabled",
+                            "#is_using_gamepad",
+                            "$is_worldbuilder",
+                            "$education_edition",
+                            "$is_console")) {
+                this.globals.put(binding, new JsonPrimitive(false));
+            }
+        }
+
+        private static JsonArray pair(final int first, final int second) {
+            final JsonArray result = new JsonArray();
+            result.add(first);
+            result.add(second);
+            return result;
+        }
+
+        @Override
+        public Map<String, JsonElement> globals() {
+            return Map.copyOf(this.globals);
+        }
+
+        @Override
+        public String defaultCollection() {
+            return BUTTONS;
+        }
+
+        @Override
+        public boolean ownsCollection(final String name) {
+            return BUTTONS.equals(name) || SKINS.equals(name);
+        }
+
+        @Override
+        public Collection collection(final String name, final Scope parent) {
+            final List<Map<String, JsonElement>> entries =
+                switch (name) {
+                    case BUTTONS -> this.buttons;
+                    case SKINS -> this.skins;
+                    default ->
+                                throw new IllegalArgumentException(
+                                        "Unsupported NPC conversation collection " + name);
+                };
+            return new Collection(
+                    entries, Map.of("#collection_length", new JsonPrimitive(entries.size())));
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            return scope == null
+                    ? Map.of()
+                    : this.collection(scope.collection(), scope.parent())
+                            .entries()
+                            .get(scope.index());
+        }
+
+        @Override
+        public Map<String, JsonElement> bindings(final Scope scope) {
+            final Map<String, JsonElement> result = new HashMap<>(this.globals);
+            result.putAll(this.variables(scope));
+            return result;
+        }
+
+        @Override
+        public String factoryKey() {
+            return "";
+        }
+
+        @Override
+        public void decorate(
+                final JsonObject node,
+                final JsonObject control,
+                final Map<String, JsonElement> resolved,
+                final Scope scope) {
+            if ("actor_portrait_renderer".equals(JsonUiProgram.string(node, "renderer"))) {
+                final JsonObject portrait = this.portrait.deepCopy();
+                portrait.add("skin_index", resolved.get("#skin_index"));
+                node.add("actor_portrait", portrait);
+            }
+            if (!"button".equals(JsonUiProgram.string(node, "type"))) {
+                return;
+            }
+            String target =
+                    UiExpression.text(
+                            JsonUiProgram.resolveValue(
+                                    new JsonPrimitive("$pressed_button_name"), resolved, 0));
+            if (node.has("button_mappings")) {
+                for (final JsonElement entry : node.getAsJsonArray("button_mappings")) {
+                    final String mapped =
+                            UiExpression.text(
+                                    JsonUiProgram.resolveValue(
+                                            entry.getAsJsonObject().get("to_button_id"),
+                                            resolved,
+                                            0));
+                    if (mapped.equals("button.student_button")
+                            || mapped.equals("button.exit_student")
+                            || mapped.equals("button.menu_exit")) {
+                        target = mapped;
+                        break;
+                    }
+                }
+            }
+            if (target.equals("button.exit_student") || target.equals("button.menu_exit")) {
+                node.addProperty("action", -1);
+            } else if (target.equals("button.student_button")) {
+                for (Scope selected = scope; selected != null; selected = selected.parent()) {
+                    if (selected.collection().equals(BUTTONS)) {
+                        final var button = this.session.buttons().get(selected.index());
+                        if (button.url() == null) {
+                            node.addProperty("action", button.index());
+                        } else {
+                            node.addProperty("url", button.url());
+                        }
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorBindings.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorBindings.java
