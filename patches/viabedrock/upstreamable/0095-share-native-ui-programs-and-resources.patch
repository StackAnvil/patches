+        final var root = ui.resolve(form("tile:One")).getAsJsonObject("root");
+        final var button = root.getAsJsonArray("children").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(96, button.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(0, button.get("action").getAsInt());
+    }
+
+    @Test
+    void cyclesMissingBasesAndOversizedCollectionsUseOrdinaryFormFallback() {
+        final var recursive = new ServerFormUi(List.of(definitions(UI.replace("server_form.cell", "server_form.main_screen_content"))));
+        assertNull(recursive.resolve(form("tile:One")));
+        final var missing = new ServerFormUi(List.of(definitions(UI.replace("action@server_form.base_button", "action@missing.base"))));
+        assertNull(missing.resolve(form("tile:One")));
+        final String[] many = new String[ServerFormUi.MAX_BUTTONS + 1];
