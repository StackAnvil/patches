+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Activation and retirement belong to the exact cooking snapshot shown by the client. */
+public record NativeCookingControl(int menuId, long sequence, long updateSequence, long menuRevision,
+                                   long inventoryRevision, long cursorRevision, Mode mode) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking_control";
+    public static final Type<NativeCookingControl> TYPE = new Type<>(NativeCookingControl.class) {
+        @Override
+        public NativeCookingControl read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 64 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native cooking control");
+            }
+            final int menu = Types.VAR_INT.readPrimitive(buffer);
+            final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+            final long update = Types.VAR_LONG.readPrimitive(buffer);
+            final long menuRevision = Types.VAR_LONG.readPrimitive(buffer);
+            final long inventoryRevision = Types.VAR_LONG.readPrimitive(buffer);
+            final long cursorRevision = Types.VAR_LONG.readPrimitive(buffer);
+            final Mode mode = switch (buffer.readUnsignedByte()) {
+                case 0 -> Mode.ACTIVATE;
+                case 1 -> Mode.DEACTIVATE;
+                default -> throw new IllegalArgumentException("Unknown native cooking control");
+            };
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native cooking control fields");
+            }
+            return new NativeCookingControl(menu, sequence, update, menuRevision, inventoryRevision, cursorRevision, mode);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCookingControl control) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, control.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, control.sequence);
+            Types.VAR_LONG.writePrimitive(buffer, control.updateSequence);
+            Types.VAR_LONG.writePrimitive(buffer, control.menuRevision);
+            Types.VAR_LONG.writePrimitive(buffer, control.inventoryRevision);
+            Types.VAR_LONG.writePrimitive(buffer, control.cursorRevision);
+            buffer.writeByte(control.mode == Mode.ACTIVATE ? 0 : 1);
+        }
+    };
+
+    public NativeCookingControl {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || updateSequence <= 0
+                || menuRevision < 0 || inventoryRevision < 0 || cursorRevision < 0 || mode == null) {
+            throw new IllegalArgumentException("Invalid native cooking control identity");
+        }
+    }
+
+    public static NativeCookingControl forMessage(final NativeCookingMessage message, final Mode mode) {
+        return new NativeCookingControl(message.menuId(), message.sequence(), message.updateSequence(),
+                message.menuRevision(), message.inventoryRevision(), message.cursorRevision(), mode);
+    }
+
+    public enum Mode {
+        ACTIVATE,
+        DEACTIVATE
+    }
+
+}
