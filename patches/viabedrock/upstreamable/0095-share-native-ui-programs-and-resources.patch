+    void responsesPreserveRequestIdentityAndRequireCompleteStrictFlags() {
+        for (final var mode : NativeCookingAction.Mode.values()) {
+            for (final int phase : new int[]{0, 1, 2}) {
+                final var action = new NativeCookingAction(255, Long.MAX_VALUE, Long.MAX_VALUE, Long.MAX_VALUE,
+                        Long.MAX_VALUE, Long.MAX_VALUE, Integer.MAX_VALUE, mode, 1, phase, Long.MAX_VALUE);
+                for (final boolean accepted : new boolean[]{false, true}) {
+                    for (final boolean current : new boolean[]{false, true}) {
+                        final var result = new NativeCookingActionResult(action, accepted, current);
+                        final var wire = Unpooled.buffer();
+                        try {
+                            NativeCookingActionResult.TYPE.write(wire, result);
+                            final var valid = wire.copy();
+                            try {
+                                assertEquals(result, NativeCookingActionResult.TYPE.read(valid));
+                                assertFalse(valid.isReadable());
+                            } finally {
+                                valid.release();
+                            }
+                            for (int length = 0; length < wire.readableBytes(); length++) {
+                                final var partial = wire.copy(0, length);
+                                try {
+                                    assertThrows(RuntimeException.class, () -> NativeCookingActionResult.TYPE.read(partial));
+                                } finally {
+                                    partial.release();
+                                }
+                            }
+                            for (int flag = wire.writerIndex() - 2; flag < wire.writerIndex(); flag++) {
+                                final var malformed = wire.copy();
