+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class JsonUiProgramTest {
+
+    private static final String UI = """
+            {"namespace":"example","root":{"type":"panel","controls":[
+              {"first":{"type":"grid","collection_name":"first","grid_item_template":"example.row","bindings":[
+                {"binding_type":"collection_details","binding_collection_name":"first","binding_name":"#total","binding_name_override":"#maximum_grid_items"}]}},
+              {"second":{"type":"grid","collection_name":"second","grid_item_template":"example.row"}},
+              {"missing@example.absent":{}},
+              {"sibling":{"type":"label","text":"Still here"}}]},
+             "row":{"type":"panel","controls":[
+              {"caption":{"type":"label","bindings":[{"binding_type":"collection","binding_name":"#caption","binding_name_override":"#text"}]}},
+              {"options":{"type":"grid","collection_name":"options","grid_item_template":"example.option"}},
+              {"cross":{"type":"label","collection_name":"second","collection_index":0,"text":"#caption"}}]},
+             "option":{"type":"label","collection_index":"#collection_index","bindings":[
+              {"binding_collection_name":"options","binding_name":"#caption","binding_name_override":"#text"},
+              {"binding_type":"collection_details","binding_collection_name":"first","binding_name":"#total","binding_name_override":"#maximum_grid_items"}]}}
+            """;
+
+    private static JsonUiProgram program(final String definition) {
+        return new JsonUiProgram(List.of(Map.of("ui/example.json", definition.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    @Test
+    void boundOpacityAndPropagationRemainLocalToEachControl() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"panel","alpha":0.9,"bindings":[
+                  {"binding_name":"#opacity","binding_name_override":"#alpha"},
+                  {"binding_name":"#propagate","binding_name_override":"#propagateAlpha"}],"controls":[
+                  {"icon":{"type":"image","texture":"textures/ui/icon"}},
+                  {"caption":{"type":"label","alpha":0.8,"bindings":[{"binding_type":"view",
+                    "source_property_name":"(#opacity / 2)","target_property_name":"#alpha"}]}}]}}
+                """);
+        final var bindings = new Bindings();
+        bindings.globals().put("#opacity", new JsonPrimitive(0.4F));
+        bindings.globals().put("#propagate", new JsonPrimitive(true));
+        final var resolved = ui.resolve("example.root", bindings).root();
+        assertEquals(0.4F, resolved.get("alpha").getAsFloat());
+        assertTrue(resolved.get("propagate_alpha").getAsBoolean());
+        final var children = resolved.getAsJsonArray("children");
+        assertEquals(1, children.get(0).getAsJsonObject().get("alpha").getAsDouble());
+        assertFalse(children.get(0).getAsJsonObject().get("propagate_alpha").getAsBoolean());
+        assertEquals(0.2F, children.get(1).getAsJsonObject().get("alpha").getAsFloat());
+
+        bindings.globals().put("#opacity", new JsonPrimitive(0));
+        bindings.globals().put("#propagate", new JsonPrimitive(false));
+        final var hidden = ui.resolve("example.root", bindings).root();
+        assertEquals(0, hidden.get("alpha").getAsDouble());
+        assertFalse(hidden.get("propagate_alpha").getAsBoolean());
+    }
+
+    @Test
+    void namedCollectionsKeepIndependentLengthsAndNestedParentBindings() {
+        final var resolved = program(UI).resolve("example.root", new Bindings());
+        final var children = resolved.root().getAsJsonArray("children");
+        assertEquals(3, children.size());
+        assertEquals(2, children.get(0).getAsJsonObject().getAsJsonArray("children").size());
+        assertEquals(1, children.get(1).getAsJsonObject().getAsJsonArray("children").size());
+        assertEquals(2, children.get(0).getAsJsonObject().get("maximum_grid_items").getAsInt());
+        final var first = children.get(0).getAsJsonObject().getAsJsonArray("children").get(1).getAsJsonObject();
+        assertEquals("first-1", first.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        final var option = first.getAsJsonArray("children").get(1).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals("first-1-option", option.get("text").getAsString());
+        assertEquals("first", option.get("parent_collection").getAsString());
+        assertEquals(1, option.get("parent_index").getAsInt());
+        assertEquals(2, option.get("maximum_grid_items").getAsInt());
+        final var cross = first.getAsJsonArray("children").get(2).getAsJsonObject();
+        assertEquals("second-0", cross.get("text").getAsString());
+        assertEquals("first", cross.get("parent_collection").getAsString());
+        assertEquals(1, cross.get("parent_index").getAsInt());
+        assertEquals(java.util.Set.of("example.absent"), resolved.missingTemplates());
+        assertEquals("Still here", children.get(2).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void typedFactoriesAndProgramsResolveWithoutFormResponseData() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"panel","collection_name":"first","factory":{"control_ids":{"caption":"example.cell"}},
+                  "bindings":[{"binding_name":"#kinds","binding_name_override":"#collection_length"}]},
+                 "cell":{"type":"label","text":"#caption"}}
+                """);
+        final var bindings = new Bindings();
+        final var first = ui.resolve("example.root", bindings);
+        assertEquals(1, bindings.collectionReads.get("first"));
+        final var program = ui.export(first.requiredDefinitions(), new JsonObject());
+        assertFalse(program.has("form"));
+        final var replay = JsonUiProgram.fromProgram(program).resolve("example.root", new Bindings());
+        assertEquals(first.root(), replay.root());
+        assertEquals(2, replay.root().getAsJsonArray("children").size());
+        assertEquals("first-1", replay.root().getAsJsonArray("children").get(1).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void exportedProgramsRetainRelativeTemplatesSelectedThroughVariables() {
+        final var ui = program("""
+                {"namespace":"example",
+                 "root":{"type":"panel","$template":"button@first","controls":[{"$template":{}}],
+                   "variables":[{"requires":"($container_title = 'Second')","$template":"button@example.second"}]},
+                 "first":{"type":"button","size":[10,20]},
+                 "second":{"type":"button","size":[30,40]}}
+                """);
+        final var exported = JsonUiProgram.fromProgram(ui.export(java.util.Set.of("example.root"), new JsonObject()));
+        for (final String title : List.of("First", "Second")) {
+            final var bindings = new Bindings();
+            bindings.globals().put("$container_title", new JsonPrimitive(title));
+            final var expected = ui.resolve("example.root", bindings);
+            final var actual = exported.resolve("example.root", bindings);
+            assertTrue(actual.missingTemplates().isEmpty());
+            assertEquals(expected.root(), actual.root());
+        }
+    }
+
+    @Test
+    void controllerGridDimensionsResolveBeforeLayoutAndRejectInvalidPairs() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"grid","collection_name":"first",
+                  "grid_dimension_binding":"#dimensions","grid_item_template":"example.cell"},
+                 "cell":{"type":"label","text":"#caption"}}
+                """);
+        final var bindings = new Bindings();
+        bindings.globals().put("#dimensions", JsonParser.parseString("[3,1]"));
+        assertEquals(JsonParser.parseString("[3,1]"), ui.resolve("example.root", bindings).root().get("grid_dimensions"));
+        for (final var dimensions : List.of("null", "3", "[]", "[3,1,2]", "[3,-1]", "[1.5,2]", "[2147483648,1]")) {
+            bindings.globals().put("#dimensions", JsonParser.parseString(dimensions));
+            assertThrows(IllegalArgumentException.class, () -> ui.resolve("example.root", bindings));
+        }
+    }
+
+    @Test
+    void unsupportedCollectionRetainsAnError() {
+        assertThrows(IllegalArgumentException.class, () -> program("""
+                {"namespace":"example","root":{"type":"grid","collection_name":"unavailable","grid_item_template":"example.cell"},
+                 "cell":{"type":"label"}}
+                """).resolve("example.root", new Bindings()));
+    }
+
+    @Test
+    void singletonFactoriesKeepTheirScopeWithoutRepeatingEveryCollectionEntry() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"factory","control_name":"example.cell"},
+                 "cell":{"type":"label","text":"Global caption"}}
+                """);
+        final var result = ui.resolve("example.root", new Bindings());
+        assertEquals(1, result.root().getAsJsonArray("children").size());
+        assertEquals("Global caption", result.root().getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void partialDefinitionsRetainLabelBindingsAndImageTypesAcrossLayers() {
+        final String lower = """
+                {"namespace":"example","root":{"type":"panel","collection_name":"first","collection_index":0,"controls":[
+                  {"caption@example.caption":{}},{"icon@example.icon":{}}]},
+                 "caption":{"type":"label","text":"#caption","offset":[0,1]},
+                 "icon":{"type":"image","texture":"textures/ui/lower","size":[16,16]}}
+                """;
+        final String upper = """
+                {"namespace":"example","caption":{"font_size":"small","offset":[2,3]},
+                 "icon":{"texture":"textures/ui/upper"}}
+                """;
+        final var ui = new JsonUiProgram(List.of(Map.of("ui/example.json", lower.getBytes(StandardCharsets.UTF_8)),
