+            }
+            final UiBindings.Scope parent = this.controllerScope(scope.parent());
+            if (this.generatedCollections.containsKey(scope)) {
+                return parent;
+            }
+            final UiBindings.Collection entries = this.controllerCollection(scope.collection(), parent);
+            return scope.index() >= 0 && scope.index() < entries.entries().size()
+                    ? new UiBindings.Scope(scope.collection(), scope.index(), parent) : null;
