+        final var rows = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertEquals(4, rows.size());
+        assertEquals(0, rows.get(0).getAsJsonObject().get("action").getAsInt());
+        assertEquals(1, rows.get(1).getAsJsonObject().get("action").getAsInt());
+        assertFalse(rows.get(2).getAsJsonObject().has("action"));
+        assertFalse(rows.get(3).getAsJsonObject().has("action"));
+    }
+
+    @Test
+    void packPriorityReplacesTheNamedControlWithoutChangingItsActions() {
+        final String upper = """
+                {"namespace":"server_form","base_button":{"type":"button","size":[96,32],
+                  "controls":[{"caption":{"type":"label","text":"$label"}}]}}
+                """;
