+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class UiFontsTest {
+
+    @Test
+    void normalizesEmAndBaselineAgainstNativeHeightAndRejectsInvalidTables() {
+        final byte[] face = face(1000, 990, -250);
+        final var metrics = UiFonts.metrics(face);
+        assertEquals(12D * 1000 / 1240, metrics.size(), 0.000001);
+        assertEquals(9.75, metrics.baseline());
+        assertEquals(11.8125, metrics.lineHeight());
+        assertEquals(11.625, UiFonts.metrics(face, 32).lineHeight());
+        assertEquals(11.90625, UiFonts.metrics(face, 128).lineHeight());
+        assertNull(UiFonts.metrics(face, 0));
+        assertNull(UiFonts.metrics(face, 256));
+        assertEquals(metrics.size(), UiFonts.metrics(face(2000, 1980, -500)).size());
+        assertEquals(metrics.baseline(), UiFonts.metrics(face(2000, 1980, -500)).baseline());
+        assertEquals(metrics.lineHeight(), UiFonts.metrics(face(2000, 1980, -500)).lineHeight());
+        final var nonIntegralDescent = UiFonts.metrics(face(2048, 1900, -500));
+        assertEquals(10.24, nonIntegralDescent.size(), 0.000001);
+        // Native truncates descent in cache pixels before the display transform.
+        assertEquals(9.5625, nonIntegralDescent.baseline());
+        final byte[] withGap = java.util.Arrays.copyOf(face, 74);
+        ByteBuffer.wrap(withGap).putInt(40, 10).putShort(72, (short) 100);
+        assertEquals(12.75, UiFonts.metrics(withGap).lineHeight());
+        assertNull(UiFonts.metrics(face(0, 990, -250)));
+        assertNull(UiFonts.metrics(face(1000, -250, 990)));
+        ByteBuffer.wrap(face).putInt(20, Integer.MAX_VALUE);
+        assertNull(UiFonts.metrics(face));
+        assertNull(UiFonts.metrics(new byte[12]));
+    }
+
+    @Test
+    void honorsPackPrecedenceCaseAndUnavailableFacesWithoutLosingGlyphFallbacks() {
+        final UiFonts fonts = new UiFonts();
+        final byte[] original = face(1000, 990, -250);
+        fonts.load(Map.of("font/font_metadata.json", metadata("Title", "ttf", "font/title"), "font/title.ttf", original));
+        final String id = fonts.id("Title");
+        assertNotNull(id);
+        assertNull(fonts.id("title"));
+        final Map<String, byte[]> resources = fonts.resources();
+        final String path = "assets/viabedrock/font/" + id.substring("viabedrock:".length());
+        assertArrayEquals(original, resources.get(path + ".ttf"));
+        final var providers = JsonParser.parseString(new String(resources.get(path + ".json"), StandardCharsets.UTF_8))
+                .getAsJsonObject().getAsJsonArray("providers");
+        assertEquals(12D * 1000 / 1240, providers.get(0).getAsJsonObject().get("size").getAsDouble(), 0.000001);
+        assertEquals(2.75, providers.get(0).getAsJsonObject().getAsJsonArray("shift").get(1).getAsDouble());
+        assertEquals("minecraft:default", providers.get(1).getAsJsonObject().get("id").getAsString());
+        fonts.load(Map.of("font/title.ttf", face(1000, 800, -200)));
+        assertEquals(id, fonts.id("Title"));
+        assertEquals(12, JsonParser.parseString(new String(fonts.resources().get(path + ".json"), StandardCharsets.UTF_8))
+                .getAsJsonObject().getAsJsonArray("providers").get(0).getAsJsonObject().get("size").getAsDouble());
+        fonts.load(Map.of("font/font_metadata.json", metadata("Title", "msdf", "font/title")));
+        assertNull(fonts.id("Title"));
+        assertTrue(fonts.resources().isEmpty());
+        fonts.load(Map.of("font/font_metadata.json", metadata("Missing", "ttf", "font/missing")));
+        assertNull(fonts.id("Missing"));
+        fonts.load(Map.of("font/font_metadata.json", metadata("Unsafe", "ttf", "font/../escape")));
+        assertNull(fonts.id("Unsafe"));
+    }
+
+    @Test
+    void keepsResolvedFamilyIdentifiersAcrossProgramTransport() {
+        final UiFonts server = new UiFonts();
+        server.load(Map.of("font/font_metadata.json", metadata("Title", "ttf", "font/title"), "font/title.ttf", face(1000, 990, -250)));
+        final JsonObject ids = new JsonObject();
+        server.ids().forEach(ids::addProperty);
+        final UiFonts client = new UiFonts();
+        client.importIds(ids);
+        final JsonObject heights = new JsonObject();
+        server.lineHeights().forEach(heights::addProperty);
+        client.importLineHeights(heights);
+        assertEquals(server.ids(), client.ids());
+        assertEquals(server.lineHeights(), client.lineHeights());
+        for (final double invalid : new double[] {0, -1, Double.NaN, Double.POSITIVE_INFINITY, 4097}) {
+            heights.addProperty("Title", invalid);
+            assertThrows(IllegalArgumentException.class, () -> client.importLineHeights(heights));
+        }
+        heights.remove("Title");
+        heights.addProperty("Unknown", 9);
+        assertThrows(IllegalArgumentException.class, () -> client.importLineHeights(heights));
+        assertTrue(client.resources().isEmpty());
+        final JsonObject lowResolution = JsonParser.parseString(new String(metadata("Title", "ttf", "font/title"), StandardCharsets.UTF_8)).getAsJsonObject();
+        lowResolution.getAsJsonArray("fonts").get(0).getAsJsonObject().addProperty("target_font_render_size", 32);
+        server.load(Map.of("font/font_metadata.json", lowResolution.toString().getBytes(StandardCharsets.UTF_8)));
+        assertEquals(11.625, server.lineHeight("Title"));
+        ids.addProperty("Unsafe", "other:font");
+        assertThrows(IllegalArgumentException.class, () -> client.importIds(ids));
+    }
+
+    @Test
+    void resolvesAuthoredFontTypesAfterControllerProgramRoundTrip() {
+        final JsonUiProgram server = new JsonUiProgram(java.util.List.of(Map.of(
+                "font/font_metadata.json", metadata("Title", "ttf", "font/title"),
+                "font/title.ttf", face(1000, 990, -250),
+                "ui/example.json", "{\"namespace\":\"example\",\"title\":{\"type\":\"label\",\"text\":\"Heading\",\"font_type\":\"Title\"}}"
+                        .getBytes(StandardCharsets.UTF_8))));
+        final UiBindings bindings = new UiBindings() {
+            @Override
+            public Map<String, JsonElement> globals() {
+                return Map.of();
+            }
+
+            @Override
+            public String defaultCollection() {
+                return "";
+            }
+
+            @Override
+            public boolean ownsCollection(final String name) {
+                return false;
+            }
+
+            @Override
+            public Collection collection(final String name, final Scope parent) {
+                return new Collection(java.util.List.of(), Map.of());
+            }
+
+            @Override
+            public Map<String, JsonElement> variables(final Scope scope) {
+                return Map.of();
+            }
+
+            @Override
+            public Map<String, JsonElement> bindings(final Scope scope) {
+                return Map.of();
+            }
+
+            @Override
+            public String factoryKey() {
+                return "";
+            }
+
+            @Override
+            public void decorate(final JsonObject node, final JsonObject control,
+                                 final Map<String, JsonElement> resolved, final Scope scope) {
+            }
+        };
+        final var before = server.resolve("example.title", bindings);
+        assertTrue(before.root().has("font"));
+        assertEquals(11.8125, before.root().get("font_line_height").getAsDouble());
+        final JsonUiProgram client = JsonUiProgram.fromProgram(server.export(before.requiredDefinitions(), new JsonObject()));
+        assertEquals(before.root(), client.resolve("example.title", bindings).root());
+        assertEquals(2, server.fontResources().size());
+        assertTrue(client.fontResources().isEmpty());
+    }
+
+    private static byte[] metadata(final String name, final String format, final String file) {
+        final JsonObject root = new JsonObject();
+        final JsonObject font = new JsonObject();
+        root.addProperty("version", 1);
+        font.addProperty("font_name", name);
+        font.addProperty("font_format", format);
+        font.addProperty("font_file", file);
+        final var fonts = new JsonArray();
+        fonts.add(font);
+        root.add("fonts", fonts);
+        return root.toString().getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static byte[] face(final int units, final int ascent, final int descent) {
+        final ByteBuffer bytes = ByteBuffer.allocate(72);
+        bytes.putInt(0, 0x00010000);
+        bytes.putShort(4, (short) 2);
+        bytes.putInt(12, 0x68656164);
+        bytes.putInt(20, 44);
+        bytes.putInt(24, 20);
+        bytes.putShort(62, (short) units);
+        bytes.putInt(28, 0x68686561);
+        bytes.putInt(36, 64);
+        bytes.putInt(40, 8);
+        bytes.putShort(68, (short) ascent);
+        bytes.putShort(70, (short) descent);
+        return bytes.array();
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiTexturesTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiTexturesTest.java
