index 000000000..a7430d107
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/NpcEditorStateTest.java
@@ -0,0 +1,209 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcRequestPacketPayload_RequestType;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.stream.IntStream;
+
+class NpcEditorStateTest {
+
+    static JsonObject source() {
+        final var source =
+                JsonParser.parseString(
+                                """
+                                {"response_id":"viabedrock:npc/42","unique_id":-23,"name":"Editor","dialogue":"first\nsecond",
+                                 "skin_index":1,"commands_enabled":true,"education":false,
+                                 "actor_data":{},"actions":[{"button_name":"Choice","type":1,"mode":0,"text":"say initial\n",
+                                  "data":[{"cmd_line":"say initial","cmd_ver":52}],"authored":{"keep":true}}]}
+                                """
+                                        .replace("first\nsecond", "first\\nsecond")
+                                        .replace("say initial\n", "say initial\\n"))
+                        .getAsJsonObject();
+        final var skins = new JsonArray();
+        IntStream.range(0, 12)
+                .forEach(
+                        index -> {
+                            final var skin = new JsonObject();
+                            skin.addProperty("variant", index * 3);
+                            skins.add(skin);
+                        });
+        source.getAsJsonObject("actor_data").add("skin_list", skins);
+        return source;
+    }
+
+    @Test
+    void incrementalUpdatesPreserveTextLimitsAndActorScopedRequestKinds() {
+        final var state = new NpcEditorState(source());
+        assertTrue(state.setText(0, "new name"));
+        assertFalse(state.setText(0, "new name"));
+        assertTrue(state.setText(1, "first\nsecond\nthird"));
+        state.activate("button.cycle_pack_right", -1);
+        state.activate("button.view_skin", 9);
+        final var updates = state.drainUpdates();
+        assertEquals(
+                List.of(
+                        NpcRequestPacketPayload_RequestType.SetName,
+                        NpcRequestPacketPayload_RequestType.SetInteractText,
+                        NpcRequestPacketPayload_RequestType.SetSkin),
+                updates.stream().map(NpcEditorState.Update::type).toList());
+        assertEquals("first\nsecond\nthird", updates.get(1).data());
+        assertEquals(9, updates.get(2).actionIndex());
+        assertTrue(state.drainUpdates().isEmpty());
+        assertThrows(IllegalArgumentException.class, () -> state.setText(0, "x".repeat(129)));
+        assertThrows(IllegalArgumentException.class, () -> state.setText(1, "x".repeat(1001)));
+        assertThrows(IllegalArgumentException.class, () -> state.activate("button.view_skin", 1));
+    }
+
+    @Test
+    void editsRetainActionIdentityAcrossDeletionAndFlushOnlyAtAdvancedExit() {
+        final var state = new NpcEditorState(source());
+        state.activate("button.advanced_settings", -1);
+        state.activate("button.add_command", -1);
+        final int retained = state.actionInput(1, false);
+        final int removed = state.actionInput(0, false);
+        state.activate("button.delete_action", 0);
+        assertEquals(retained, state.actionInput(0, false));
+        assertThrows(IllegalArgumentException.class, () -> state.setText(removed, "stale"));
+        state.setText(retained, "say first\n\nsay second");
+        assertEquals("say first\n\nsay second", state.text(retained));
+        assertTrue(state.drainUpdates().isEmpty());
+        state.activate("button.expand_action_edit", 0);
+        state.cancel();
+        assertEquals(NpcEditorState.View.ADVANCED, state.view());
+        assertTrue(state.drainUpdates().isEmpty());
+        state.cancel();
+        final var update = state.drainUpdates().getFirst();
+        assertEquals(NpcRequestPacketPayload_RequestType.SetActions, update.type());
+        final var action =
+                JsonParser.parseString(update.data()).getAsJsonArray().get(0).getAsJsonObject();
+        assertEquals(2, action.getAsJsonArray("data").size());
+        assertEquals(
+                52,
+                action.getAsJsonArray("data").get(1).getAsJsonObject().get("cmd_ver").getAsInt());
+        assertEquals("say first\n\nsay second\n", action.get("text").getAsString());
+        assertEquals(NpcEditorState.View.BASIC, state.view());
+        assertFalse(state.closed());
+        state.cancel();
+        assertTrue(state.closed());
+        assertEquals(1, state.drainUpdates().size());
+        state.cancel();
+        assertTrue(state.drainUpdates().isEmpty());
+    }
+
+    @Test
+    void exclusiveModesPreserveAuthoredFieldsAndRetailCannotAddUrls() {
+        final var state = new NpcEditorState(source());
+        state.activate("button.advanced_settings", -1);
+        state.activate("on_enter_toggle", 0);
+        assertEquals(2, state.action(0).get("mode").getAsInt());
+        state.activate("on_exit_toggle", 0);
+        assertEquals(1, state.action(0).get("mode").getAsInt());
+        state.activate("on_exit_toggle", 0);
+        assertEquals(1, state.action(0).get("mode").getAsInt());
+        state.activate("button_mode_toggle", 0);
+        assertEquals(0, state.action(0).get("mode").getAsInt());
+        state.activate("button_mode_toggle", 0);
+        assertEquals(1, state.action(0).get("mode").getAsInt());
+        assertTrue(state.action(0).getAsJsonObject("authored").get("keep").getAsBoolean());
+        state.activate("button.add_url", -1);
+        assertEquals(1, state.count());
+        for (int i = 1; i < 256; i++) {
+            state.activate("button.add_command", -1);
+        }
+        state.activate("button.add_command", -1);
+        assertEquals(256, state.count());
+    }
+
+    @Test
+    void everyAuthoredEditorViewResolvesLocallyWithTheSameInputIdentity() {
+        final var ui = new NpcDialogueUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        final var state = new NpcEditorState(source());
+        final var initial = ui.resolve(state);
+        assertTrue(initial.getAsJsonArray("missing_templates").isEmpty());
+        final var variants = nodes(initial.getAsJsonObject("root")).stream()
+                .filter(node -> node.has("actor_portrait"))
+                .map(node -> node.getAsJsonObject("actor_portrait").get("variant").getAsInt())
+                .collect(java.util.stream.Collectors.toSet());
+        assertEquals(java.util.Set.of(0, 3, 6, 9, 12), variants);
+        assertTrue(
+                nodes(initial.getAsJsonObject("root")).stream()
+                        .filter(node -> node.has("actor_portrait"))
+                        .allMatch(
+                                node ->
+                                        node.getAsJsonObject("actor_portrait")
+                                                .get("offsets")
+                                                .getAsString()
+                                                .equals("picker_offsets")));
+        final var local = NpcDialogueUi.fromProgram(initial.getAsJsonObject("program"));
+        state.activate("button.advanced_settings", -1);
+        final var advanced = local.resolve(state);
+        assertTrue(advanced.getAsJsonArray("missing_templates").isEmpty());
+        final int input = state.actionInput(0, false);
+        assertTrue(
+                nodes(advanced.getAsJsonObject("root")).stream()
+                        .anyMatch(
+                                node ->
+                                        node.has("input")
+                                                && node.getAsJsonObject("input")
+                                                                .get("index")
+                                                                .getAsInt()
+                                                        == input));
+        state.activate("button.expand_action_edit", 0);
+        final var maximized = local.resolve(state);
+        assertTrue(
+                nodes(maximized.getAsJsonObject("root")).stream()
+                        .anyMatch(
+                                node ->
+                                        node.has("input")
+                                                && node.getAsJsonObject("input")
+                                                                .get("index")
+                                                                .getAsInt()
+                                                        == input));
+        state.cancel();
+        state.cancel();
+        state.activate("button.dialog_button", -1);
+        final var dialogue = local.resolve(state);
+        final var portrait = nodes(dialogue.getAsJsonObject("root")).stream()
+                .filter(node -> node.has("actor_portrait"))
+                .findFirst()
+                .orElseThrow()
+                .getAsJsonObject("actor_portrait");
+        assertEquals("portrait_offsets", portrait.get("offsets").getAsString());
+        assertEquals(state.skin(), portrait.get("skin_index").getAsInt());
+        assertTrue(
+                nodes(dialogue.getAsJsonObject("root")).stream()
+                        .anyMatch(
+                                node ->
+                                        node.has("input")
+                                                && node.getAsJsonObject("input")
+                                                                .get("index")
+                                                                .getAsInt()
+                                                        == 1));
+    }
+
+    private static List<JsonObject> nodes(final JsonObject node) {
+        final var result = new ArrayList<JsonObject>();
+        result.add(node);
+        if (node.has("children")) {
+            node.getAsJsonArray("children")
+                    .forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        }
+        return result;
+    }
+
+}
