@@ -0,0 +1,41 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import java.util.Objects;
+
+/** Echo the full control identity so delayed acknowledgments cannot activate a refreshed screen. */
+public record NativeCookingStatus(NativeCookingControl control, boolean accepted) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking_status";
+    public static final Type<NativeCookingStatus> TYPE = new Type<>(NativeCookingStatus.class) {
+        @Override
+        public NativeCookingStatus read(final ByteBuf buffer) {
+            if (buffer.readableBytes() < 2 || buffer.readableBytes() > 64) {
+                throw new IllegalArgumentException("Invalid native cooking status length");
+            }
+            final var control = NativeCookingControl.TYPE.read(buffer.readSlice(buffer.readableBytes() - 1));
+            final int accepted = buffer.readUnsignedByte();
+            if (accepted > 1) {
+                throw new IllegalArgumentException("Invalid native cooking status acceptance");
+            }
+            return new NativeCookingStatus(control, accepted == 1);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCookingStatus status) {
+            NativeCookingControl.TYPE.write(buffer, status.control);
+            buffer.writeBoolean(status.accepted);
+        }
+    };
+
+    public NativeCookingStatus {
+        Objects.requireNonNull(control);
+    }
+
+}
