+        final String definition = """
+                {"namespace":"server_form","main_screen_content":{"type":"button","collection_index":0,
+                 "$pressed_button_name":"button.form_button_click","texture":"textures/ui/item.jpg"}}
+                """;
+        final var upper = new JsonUiProgram(List.of(lower.textures(), Map.of("textures/ui/item.jpg", jpeg,
+                "textures/ui/item.json", "{\"nineslice_size\":2}".getBytes(StandardCharsets.UTF_8),
+                "ui/server_form.json", definition.getBytes(StandardCharsets.UTF_8))));
+        final var form = JsonParser.parseString("{\"type\":\"form\",\"title\":\"\",\"elements\":[{\"type\":\"button\",\"text\":\"\"}]}").getAsJsonObject();
+        final var root = new ServerFormUi(upper).resolve(form).getAsJsonObject("root");
+        assertEquals(JsonUiProgram.textureId("textures/ui/item"), root.get("texture").getAsString());
+        assertEquals(2, root.get("nineslice_size").getAsInt());
+        final var decoded = ImageIO.read(new ByteArrayInputStream(jpeg));
+        final var normalized = ImageIO.read(new ByteArrayInputStream(upper.textures().get("textures/ui/item.png")));
+        assertEquals(decoded.getWidth(), normalized.getWidth());
+        assertEquals(decoded.getHeight(), normalized.getHeight());
+        assertArrayEquals(decoded.getRGB(0, 0, 3, 2, null, 0, 3), normalized.getRGB(0, 0, 3, 2, null, 0, 3));
+        assertEquals(2, upper.textures().size());
+    }
