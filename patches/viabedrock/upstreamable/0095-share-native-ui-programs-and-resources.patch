+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Base64;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeRecipeSearchTest {
+
+    @Test
+    void normalizesTheQueryAndKeepsNameProductionLazy() {
+        assertTrue(new NativeRecipeSearch("", NativeRecipeSearch.Mode.COOKING).matches(() -> fail("Unexpected primary lookup"), () -> fail("Unexpected label lookup")));
+        assertTrue(new NativeRecipeSearch("STRASSE", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("Straße"), () -> fail("Unexpected label lookup")));
+        assertTrue(new NativeRecipeSearch("CAFÉ", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("other"), () -> bytes("§aCafé")));
+        assertFalse(new NativeRecipeSearch("§acafé", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("other"), () -> bytes("§aCafé")));
+        assertFalse(new NativeRecipeSearch(" beef ", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("Beef"), () -> bytes("")));
+        assertFalse(new NativeRecipeSearch("beef raw", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("Raw Beef"), () -> bytes("")));
+        assertFalse(new NativeRecipeSearch("be" + Character.toString(0x200B) + "ef", NativeRecipeSearch.Mode.COOKING).matches(() -> bytes("Beef"), () -> bytes("")));
+        final byte[] query = bytes("BEEF");
+        final var search = new NativeRecipeSearch(query, NativeRecipeSearch.Mode.COOKING);
+        query[0] = 'x';
+        assertTrue(search.matches(() -> bytes("Beef"), () -> fail("Unexpected label lookup")));
+    }
+
+    @Test
+    void strippingUsesTheNativeByteAutomatonIncludingIncompleteAndUnknownCodes() {
+        assertArrayEquals(bytes("A§ZB§xC"), NativeRecipeSearch.stripFormatting(bytes("§aA§ZB§xC§w")));
+        assertArrayEquals(bytes("A"), NativeRecipeSearch.stripFormatting(bytes("A§")));
+        assertArrayEquals(bytes("A"), NativeRecipeSearch.stripFormatting(new byte[]{'A', (byte) 0xC2}));
+        assertArrayEquals(new byte[]{(byte) 0xC2, (byte) 0xC2, (byte) 0xA7, 'a'},
+                NativeRecipeSearch.stripFormatting(new byte[]{(byte) 0xC2, (byte) 0xC2, (byte) 0xA7, 'a'}));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_SEARCH", matches = ".+")
+    void matchesTheCapturedPredicateCompositionAndLazyNameBoundaries() throws Exception {
+        final var data = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_COOKING_SEARCH")))).getAsJsonObject();
+        int cases = 0;
+        for (final var element : data.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            final var primary = new AtomicInteger();
+            final var secondary = new AtomicInteger();
+            final var search = new NativeRecipeSearch(row.get("query").getAsString(), NativeRecipeSearch.Mode.COOKING);
+            final boolean admitted = row.get("filtering").getAsBoolean() || row.get("eligible").getAsBoolean();
+            final boolean match = admitted && search.matches(
+                    () -> {
+                        primary.incrementAndGet();
+                        return bytes(row.get("primary").getAsString());
+                    },
+                    () -> {
+                        secondary.incrementAndGet();
+                        return bytes(row.get("secondary").getAsString());
+                    });
+            assertEquals(row.get("result").getAsInt(), match ? row.get("availability").getAsInt() : 3);
+            assertEquals(row.get("primaryCalls").getAsInt(), primary.get());
+            assertEquals(row.get("secondaryCalls").getAsInt(), secondary.get());
+            cases++;
+        }
+        assertEquals(304, cases);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PLAYER_SEARCH", matches = ".+")
+    void matchesTheCompletePlayerSearchAndItsLazyNameProviders() throws Exception {
+        final var data = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_PLAYER_SEARCH")))).getAsJsonObject();
+        for (final var element : data.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            final var primary = new AtomicInteger();
+            final var secondary = new AtomicInteger();
+            final var mode = row.get("mode").getAsInt() == 0
+                    ? NativeRecipeSearch.Mode.PLAYER_SUBSTRING : NativeRecipeSearch.Mode.PLAYER_WORD_PREFIX;
+            final var search = new NativeRecipeSearch(Base64.getDecoder().decode(row.get("query").getAsString()), mode);
+            final boolean matched = search.matches(
+                    () -> {
+                        primary.incrementAndGet();
+                        return Base64.getDecoder().decode(row.get("primary").getAsString());
+                    },
+                    () -> {
+                        secondary.incrementAndGet();
+                        return Base64.getDecoder().decode(row.get("secondary").getAsString());
+                    });
+            assertEquals(row.get("result").getAsInt() != 3, matched, row.toString());
+            assertEquals(row.get("primaryCalls").getAsInt(), primary.get());
+            assertEquals(row.get("secondaryCalls").getAsInt(), secondary.get());
+        }
+        for (final var element : data.getAsJsonArray("wordRows")) {
+            final var row = element.getAsJsonObject();
+            final byte[] query = Base64.getDecoder().decode(row.get("query").getAsString());
+            final byte[] text = Base64.getDecoder().decode(row.get("text").getAsString());
+            final var search = new NativeRecipeSearch(query, NativeRecipeSearch.Mode.PLAYER_WORD_PREFIX);
+            assertEquals(query.length == 0 || row.get("result").getAsBoolean(),
+                    search.matches(() -> text, () -> new byte[0]), row.toString());
+        }
+    }
+
+    private static byte[] bytes(final String value) {
+        return value.getBytes(StandardCharsets.UTF_8);
+    }
+
+}
