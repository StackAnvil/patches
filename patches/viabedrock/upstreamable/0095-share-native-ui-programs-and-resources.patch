+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class FormCollectionActivationTest {
+
+    private static final String DEFINITIONS = """
+            {"namespace":"server_form","main_screen_content":{"type":"panel","controls":[
+              {"action":{"type":"stack_panel","collection_name":"form_buttons",
+                "factory":{"control_ids":{"button":"server_form.button"}},
+                "bindings":[{"binding_name":"#form_button_contents","binding_name_override":"#collection_length"}]}},
+              {"custom":{"type":"stack_panel","collection_name":"custom_form",
+                "factory":{"control_ids":{"toggle":"server_form.toggle","label":"server_form.label"}},
+                "bindings":[{"binding_name":"#custom_form_length","binding_name_override":"#collection_length"}]}},
+              {"inactive_binding":{"type":"panel","visible":false,"bindings":[
+                {"binding_type":"collection_details","binding_collection_name":"$opposite","binding_name":"#title_text"}]}}
+            ]},"button":{"type":"button","$pressed_button_name":"button.form_button_click","text":"#form_button_text"},
+            "toggle":{"type":"toggle","bindings":[{"binding_name":"#custom_toggle_state","binding_name_override":"#toggle_state"}]},
+            "label":{"type":"label","text":"#custom_text"}}
+            """;
+
+    private static ServerFormUi ui(final String opposite) {
+        final String source = DEFINITIONS.replace("$opposite", opposite);
+        return new ServerFormUi(List.of(Map.of("ui/server_form.json", source.getBytes(StandardCharsets.UTF_8))), key -> key);
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void actionFormLeavesCustomFactoryAndItsBindingsEmptyWithoutLosingButtonOrdinals() {
+        final JsonObject form = JsonParser.parseString("""
+                {"type":"form","title":"Wardrobe","content":"Choose","elements":[
+                 {"type":"label","text":"Heading"},{"type":"button","text":"First"},{"type":"button","text":"Second"}]}
+                """).getAsJsonObject();
+        final JsonObject scene = ui("custom_form").resolve(form);
+        assertNotNull(scene);
+        final List<JsonObject> nodes = nodes(scene.getAsJsonObject("root"));
+        assertEquals(List.of(0, 1), nodes.stream().filter(node -> node.has("action"))
+                .map(node -> node.get("action").getAsInt()).toList());
+        assertTrue(nodes.stream().filter(node -> node.get("name").getAsString().equals("custom"))
+                .allMatch(node -> node.getAsJsonArray("children").isEmpty() && node.get("collection_length").getAsInt() == 0));
+        assertFalse(nodes.stream().anyMatch(node -> node.has("input")));
+    }
+
+    @Test
+    void customFormLeavesActionFactoryEmptyAcrossStateChangesAndProgramRoundTrip() {
+        final JsonObject form = JsonParser.parseString("""
+                {"type":"custom_form","title":"Settings","content":[
+                  {"type":"label","text":"Heading"},{"type":"toggle","text":"Enabled","default":false}]}
+                """).getAsJsonObject();
+        final JsonObject first = ui("form_buttons").resolve(form);
+        assertNotNull(first);
+        final JsonArray changed = first.getAsJsonArray("values").deepCopy();
+        changed.set(1, JsonParser.parseString("true"));
+        final JsonObject program = first.getAsJsonObject("program");
+        final JsonObject second = ServerFormUi.fromProgram(program).resolve(program.getAsJsonObject("form"), changed, Set.of());
+        assertNotNull(second);
+        final List<JsonObject> nodes = nodes(second.getAsJsonObject("root"));
+        assertTrue(nodes.stream().filter(node -> node.get("name").getAsString().equals("action"))
+                .allMatch(node -> node.getAsJsonArray("children").isEmpty() && node.get("collection_length").getAsInt() == 0));
+        final List<JsonObject> inputs = nodes.stream().filter(node -> node.has("input")).toList();
+        assertEquals(1, inputs.size());
+        assertEquals(1, inputs.getFirst().getAsJsonObject("input").get("index").getAsInt());
+        assertTrue(inputs.getFirst().get("toggle_state").getAsBoolean());
+        assertTrue(second.getAsJsonArray("values").get(0).isJsonNull());
+        assertFalse(nodes.stream().anyMatch(node -> node.has("action")));
+    }
+
+    @Test
+    void unknownCollectionsAndActiveOptionsWithoutParentScopeStillFail() {
+        final JsonObject form = JsonParser.parseString("""
+                {"type":"custom_form","title":"Settings","content":[{"type":"toggle","text":"Enabled"}]}
+                """).getAsJsonObject();
+        assertNull(ui("unknown_controller").resolve(form));
+        assertNull(ui("custom_dropdown").resolve(form));
+    }
+
+}
