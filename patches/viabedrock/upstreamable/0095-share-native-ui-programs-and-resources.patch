+            assertEquals(7, scene.get("menu_id").getAsInt());
+            final List<JsonObject> nodes = nodes(scene.getAsJsonObject("root"));
+            final Set<Integer> addresses = nodes.stream().filter(node -> node.has("inventory_slot"))
+                    .map(node -> node.get("inventory_slot").getAsInt()).collect(java.util.stream.Collectors.toSet());
+            assertEquals(external + 36, addresses.size());
