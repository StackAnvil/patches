+            NativeCookingMessage.TYPE.write(source, message);
+            for (int field = 0; field < 8; field++) {
+                Types.VAR_LONG.readPrimitive(source);
+            }
+            for (int field = 0; field < 2; field++) {
+                source.skipBytes(Types.VAR_INT.readPrimitive(source));
+            }
+            final int previewCount = source.readerIndex();
+            assertEquals(3, Types.VAR_INT.readPrimitive(source));
+            final int firstId = source.readerIndex();
+            assertEquals(7, Types.VAR_INT.readPrimitive(source));
+            final int firstLength = source.readerIndex();
+            final int length = Types.VAR_INT.readPrimitive(source);
+            source.skipBytes(length);
+            final int secondId = source.readerIndex();
+            final int[] offsets = {previewCount, firstId, firstLength, firstLength, secondId};
+            final int[] corruptions = {0, 99, 0, length + 1, 7};
+            for (int index = 0; index < offsets.length; index++) {
+                final var malformed = source.copy(0, source.writerIndex());
+                try {
+                    malformed.setByte(offsets[index], corruptions[index]);
+                    assertThrows(RuntimeException.class, () -> NativeCookingMessage.TYPE.read(malformed));
+                } finally {
+                    malformed.release();
+                }
+            }
+        } finally {
+            source.release();
