+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+
+/** Native cooking scenes retain raw actor progress and separate recipe identities from item slots. */
+public final class CookingUi {
+
+    private final JsonUiProgram program;
+    private final Family family;
+    private final ContainerUi.Title title;
+
+    public CookingUi(final JsonUiProgram program) {
+        this(program, null, null);
+    }
+
+    private CookingUi(final JsonUiProgram program, final Family family, final ContainerUi.Title title) {
+        this.program = Objects.requireNonNull(program);
+        this.family = family;
+        this.title = title;
+    }
+
+    public JsonObject exportProgram(final MenuView menu) {
+        final Family family = menu.family;
+        final ContainerUi.Title title = menu.title;
+        final JsonObject controller = new JsonObject();
+        controller.addProperty("$container_title", title.raw());
+        controller.addProperty("#tab_label_text", menu.book.tabLabel);
+        final JsonObject exported = this.program.export(Set.of(family.host, "furnace.furnace_panel"), controller);
+        if (!exported.getAsJsonObject("definitions").has(family.host)) {
+            throw new IllegalArgumentException("Missing native cooking host");
+        }
+        exported.addProperty("cooking_family", family.name());
+        exported.getAsJsonObject("globals").addProperty("$container_title", title.raw());
+        exported.getAsJsonObject("globals").addProperty("$localize_title", title.localize());
+        requirePayloadLimit(exported);
+        return exported;
+    }
+
+    public static CookingUi fromProgram(final JsonObject program) {
+        final JsonElement family = program.get("cooking_family");
+        final JsonObject globals = program.getAsJsonObject("globals");
+        final JsonElement title = globals == null ? null : globals.get("$container_title");
+        final JsonElement localize = globals == null ? null : globals.get("$localize_title");
+        if (!isString(family) || !isString(title) || localize == null || !localize.isJsonPrimitive()
+                || !localize.getAsJsonPrimitive().isBoolean()) {
+            throw new IllegalArgumentException("Invalid native cooking program identity");
+        }
+        final Family selected = Family.valueOf(family.getAsString());
+        final JsonUiProgram ui = JsonUiProgram.fromProgram(program);
+        if (!program.getAsJsonObject("definitions").has(selected.host)) {
+            throw new IllegalArgumentException("Missing native cooking host");
+        }
+        return new CookingUi(ui, selected, new ContainerUi.Title(title.getAsString(), localize.getAsBoolean()));
+    }
+
+    private static boolean isString(final JsonElement value) {
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString();
+    }
+
+    public JsonObject resolve(final MenuView menu) {
+        if (this.family != null && menu.family != this.family) {
+            throw new IllegalArgumentException("Cooking program belongs to another family");
+        }
+        final var resolved = this.program.resolve(menu.family.host,
+                new Controller(menu, this.title == null ? menu.title : this.title));
+        if (resolved.root() == null || !"screen".equals(UiExpression.text(resolved.root().get("type")))
+                || !resolved.requiredDefinitions().contains(menu.family.host) || !resolved.missingTemplates().isEmpty()) {
+            throw new IllegalArgumentException("Incomplete native cooking program");
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.addProperty("menu_id", menu.menuId);
+        scene.add("root", resolved.root());
+        scene.add("missing_templates", new JsonArray());
+        requirePayloadLimit(scene);
+        return scene;
+    }
+
+    private static void requirePayloadLimit(final JsonObject value) {
+        if (value.toString().getBytes(StandardCharsets.UTF_8).length > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("Cooking UI exceeds the payload limit");
+        }
+    }
+
+    /** Authorize only recipe controls exposed by this resolved presentation and native book. */
+    public static RecipeActionScope actionScope(final JsonObject scene, final Book book) {
+        if (scene == null || !scene.has("root") || !scene.get("root").isJsonObject()
+                || !scene.has("missing_templates") || !scene.get("missing_templates").isJsonArray()
+                || !scene.getAsJsonArray("missing_templates").isEmpty()) {
+            throw new IllegalArgumentException("Incomplete native cooking scene");
+        }
+        final List<Integer> available = new ArrayList<>();
+        for (final Recipe recipe : book.recipes()) {
+            if (book.visibleRecipes.contains(recipe.id)) {
+                available.add(recipe.id);
+            }
+        }
+        final Map<Integer, Set<String>> actions = new HashMap<>();
+        final Set<JsonObject> owners = Collections.newSetFromMap(new IdentityHashMap<>());
+        recipePaths(scene.getAsJsonObject("root"), owners);
+        collectActions(scene.getAsJsonObject("root"), true, true, available, actions, owners);
+        return new RecipeActionScope(actions);
+    }
+
+    private static boolean recipePaths(final JsonObject node, final Set<JsonObject> owners) {
+        boolean relevant = node.has("recipe_actions");
+        if (node.has("children")) {
+            for (final var child : node.getAsJsonArray("children")) {
+                relevant |= recipePaths(child.getAsJsonObject(), owners);
+            }
+        }
+        if (relevant) {
+            owners.add(node);
+        }
+        return relevant;
+    }
+
+    private static void collectActions(final JsonObject node, final boolean parentVisible, final boolean parentEnabled,
+                                       final List<Integer> available, final Map<Integer, Set<String>> actions, final Set<JsonObject> owners) {
+        if (!owners.contains(node)) {
+            return;
+        }
+        final boolean visible = parentVisible && stateFlag(node, "visible", true);
+        if (!visible) {
+            return;
+        }
+        final boolean enabled = parentEnabled && stateFlag(node, "enabled", true);
+        if (!enabled) {
+            return;
+        }
+        if (node.has("recipe_actions")) {
+            if (!"recipe_book".equals(JsonUiProgram.string(node, "collection")) || !node.has("recipe_id")
+                    || node.has("inventory_slot") || node.has("inventory_actions") || !node.get("recipe_actions").isJsonArray()) {
+                throw new IllegalArgumentException("Unbound native cooking recipe control");
+            }
+            final int id = recipeInteger(node.get("recipe_id"));
+            final int index = recipeInteger(node.get("collection_index"));
+            if (index < 0 || index >= available.size() || available.get(index) != id) {
+                throw new IllegalArgumentException("Native cooking control does not match its collection cell");
+            }
+            for (final JsonElement value : node.getAsJsonArray("recipe_actions")) {
+                final JsonObject mapping = value.getAsJsonObject();
+                if (stateFlag(mapping, "ignored", false)) {
+                    continue;
+                }
+                final String target = JsonUiProgram.string(mapping, "to_button_id");
+                if (!Controller.RECIPE_ACTIONS.contains(target) || !"pressed".equals(JsonUiProgram.string(mapping, "mapping_type"))) {
+                    throw new IllegalArgumentException("Unsupported native cooking recipe action");
+                }
+                actions.computeIfAbsent(id, ignored -> new HashSet<>()).add(target);
+            }
+        }
+        if (node.has("children")) {
+            for (final JsonElement child : node.getAsJsonArray("children")) {
+                collectActions(child.getAsJsonObject(), visible, enabled, available, actions, owners);
+            }
+        }
+    }
+
+    private static int recipeInteger(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("Invalid native cooking control integer");
+        }
+        // JsonCpp distinguishes integer values from integral reals such as 7.0.
+        final String encoded = value.getAsString();
+        if (encoded.indexOf('.') >= 0 || encoded.indexOf('e') >= 0 || encoded.indexOf('E') >= 0) {
+            throw new IllegalArgumentException("Invalid native cooking control integer");
+        }
+        try {
+            return value.getAsBigDecimal().intValueExact();
+        } catch (final ArithmeticException invalid) {
+            throw new IllegalArgumentException("Native cooking control integer is out of range", invalid);
+        }
+    }
+
+    private static boolean stateFlag(final JsonObject node, final String key, final boolean fallback) {
+        if (!node.has(key)) {
+            return fallback;
+        }
+        final JsonElement value = node.get(key);
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isBoolean()) {
+            throw new IllegalArgumentException("Unknown native cooking control state");
+        }
+        return value.getAsBoolean();
+    }
+
+    public record RecipeActionScope(Map<Integer, Set<String>> actions) {
+
+        public RecipeActionScope {
+            final Map<Integer, Set<String>> copied = new HashMap<>();
+            actions.forEach((id, targets) -> copied.put(id, Set.copyOf(targets)));
+            actions = Map.copyOf(copied);
+        }
+    }
+
+    public enum Family {
+        FURNACE("furnace.furnace_screen", 200),
+        BLAST_FURNACE("blast_furnace.blast_furnace_screen", 100),
+        SMOKER("smoker.smoker_screen", 100);
+
+        private final String host;
+        private final int cookingDuration;
+
+        Family(final String host, final int cookingDuration) {
+            this.host = host;
+            this.cookingDuration = cookingDuration;
+        }
+    }
+
+    public record Progress(int cooking, int burning, int burnDuration, int storedExperience) {
+
+        public static Progress fromProperties(final Map<Integer, Integer> properties) {
+            return new Progress(properties.getOrDefault(0, 0), properties.getOrDefault(1, 0),
+                    properties.getOrDefault(2, 0), properties.getOrDefault(3, 0));
+        }
+
+        public float arrowRatio(final Family family) {
+            return (22 - this.cooking * 22 / family.cookingDuration) / 22F;
+        }
+
+        public float flameRatio(final Family family) {
+            final int duration = this.burnDuration == 0 ? family.cookingDuration : this.burnDuration;
+            final int numerator = this.burning * 13;
+            if (numerator == Integer.MIN_VALUE && duration == -1) {
+                throw new ArithmeticException("Native cooking progress division overflows");
+            }
+            return (13 - Math.min(13, numerator / duration)) / 13F;
+        }
+    }
+
+    /** Unlock and deduplicate registry entries before priority sorting and tab/search/filter selection. */
+    public record Book(int layout, boolean forcedRecipeBookLayout, int tab, boolean filtering, int foodCount, int itemCount, int blockCount,
+                       String tabLabel, String searchText, Selection selection, List<Recipe> catalog, Set<Integer> visibleRecipes) {
+
+        public Book {
+            if (foodCount < 0 || itemCount < 0 || blockCount < 0 || tabLabel == null || searchText == null || selection == null) {
+                throw new IllegalArgumentException("Invalid native cooking book state");
+            }
+            catalog = CookingRecipeOrder.registryOrder(catalog, Recipe::uniqueId);
+            visibleRecipes = Set.copyOf(visibleRecipes);
+            final Set<Integer> ids = new HashSet<>();
+            for (final Recipe recipe : catalog) {
+                if (!ids.add(recipe.id)) {
+                    throw new IllegalArgumentException("Duplicate native cooking recipe identity");
+                }
+            }
+            if (!ids.containsAll(visibleRecipes)) {
+                throw new IllegalArgumentException("Unknown visible native cooking recipe");
+            }
+        }
+
+        /** The native constructor retains negative values but defaults zero and values above Default. */
+        public int effectiveLayout() {
+            return this.forcedRecipeBookLayout || this.layout == 0 || this.layout >= 3 ? 2 : this.layout;
+        }
+
+        public List<Recipe> recipes() {
+            final var ordered = CookingRecipeOrder.bookOrder(this.catalog, Recipe::uniqueId,
+                    Recipe::unlocked, Recipe::outputName, Recipe::priority);
+            return CookingRecipeOrder.visibleOrder(ordered, Recipe::evaluation, this.filtering);
+        }
+    }
+
+    /** Native selection identifies a cell in its resolved collection, independently of recipe network IDs. */
+    public record Selection(String collection, int index) {
+
+        public Selection {
+            Objects.requireNonNull(collection);
+        }
+    }
+
+    /** outputName is the native item's unqualified name, independently of metadata or namespace. */
+    public record Recipe(int id, String uniqueId, int priority, boolean unlocked, String outputName,
+                         int evaluation, Map<String, JsonElement> presentation) {
+
+        public Recipe {
+            if (id < 0 || uniqueId == null || outputName == null || outputName.isEmpty() || evaluation < 0 || evaluation > 3) {
+                throw new IllegalArgumentException("Invalid native cooking recipe identity");
+            }
+            presentation = ContainerUi.copy(presentation);
+        }
+    }
+
+    public record MenuView(int menuId, Family family, ContainerUi.Title title, List<ContainerUi.Slot> slots,
+                           Map<String, JsonElement> cursor, Progress progress, Book book) {
+
+        public MenuView {
+            if (menuId < 0 || menuId > 255 || family == null || title == null || progress == null || book == null) {
+                throw new IllegalArgumentException("Invalid native cooking menu");
+            }
+            slots = List.copyOf(slots);
+            cursor = ContainerUi.copy(cursor);
+            final Set<Integer> ids = new HashSet<>();
+            for (final ContainerUi.Slot slot : slots) {
+                if (slot.javaSlot() >= 39 || !ids.add(slot.javaSlot())) {
+                    throw new IllegalArgumentException("Invalid native cooking slot identity");
+                }
+            }
+            if (ids.size() != 39) {
+                throw new IllegalArgumentException("Incomplete native cooking inventory");
+            }
+        }
+    }
+
+    private static final class Controller extends ContainerUi.Controller {
+
+        private static final Set<String> RECIPE_ACTIONS = Set.of("button.recipe_select", "button.recipe_secondary", "button.recipe_tertiary");
+        private final Selection selection;
+
+        private Controller(final MenuView menu, final ContainerUi.Title title) {
+            super(3, menu.slots, menu.cursor, title, true);
+            this.selection = menu.book.selection;
+            this.globals.put("$food_index", new JsonPrimitive(1));
+            this.globals.put("$items_index", new JsonPrimitive(2));
+            this.globals.put("$blocks_index", new JsonPrimitive(3));
+            this.globals.put("$search_index", new JsonPrimitive(4));
+            this.globals.put("$inventory_index", new JsonPrimitive(5));
+            this.globals.put("$survival_layout_index", new JsonPrimitive(1));
+            this.globals.put("$recipe_book_layout_index", new JsonPrimitive(2));
+            this.registerSingleton("furnace_ingredient_items", 0, "");
+            this.registerSingleton("furnace_fuel_items", 1, "");
+            this.registerSingleton("furnace_output_items", 2, "");
+            this.collections.remove("container_items");
+            final List<Map<String, JsonElement>> recipes = new ArrayList<>();
+            for (final Recipe recipe : menu.book.recipes()) {
+                if (!menu.book.visibleRecipes.contains(recipe.id)) {
+                    continue;
+                }
+                final Map<String, JsonElement> values = new HashMap<>(recipe.presentation);
+                final JsonObject reference = new JsonObject();
+                reference.addProperty("recipe_id", recipe.id);
+                values.put("#item_renderer_data", reference);
+                values.put("#collection_index", new JsonPrimitive(recipes.size()));
+                recipes.add(values);
+            }
+            this.collections.put("recipe_book", new Collection(recipes, Map.of("#collection_total_items", new JsonPrimitive(recipes.size()))));
+            this.globals.put("#recipe_book_total_items", new JsonPrimitive(recipes.size()));
+            this.globals.put("#tab_label_text", new JsonPrimitive(menu.book.tabLabel));
+            this.globals.put("#text_box_item_name", new JsonPrimitive(menu.book.searchText));
+            this.globals.put("#filtering_enabled", new JsonPrimitive(menu.book.filtering));
+            this.globals.put("#is_survival_layout", new JsonPrimitive(menu.book.effectiveLayout() == 1 && !menu.book.forcedRecipeBookLayout));
+            this.globals.put("#is_recipe_book_layout", new JsonPrimitive(menu.book.effectiveLayout() == 2 || menu.book.forcedRecipeBookLayout));
+            final List<String> tabs = List.of("food", "items", "blocks", "search", "inventory");
+            for (int index = 0; index < tabs.size(); index++) {
+                this.globals.put("#is_left_tab_" + tabs.get(index), new JsonPrimitive(menu.book.tab == index + 1));
+            }
+            final boolean categories = menu.family == Family.FURNACE;
+            final boolean food = menu.book.foodCount > 0;
+            final boolean items = menu.book.itemCount > 0;
+            final boolean blocks = menu.book.blockCount > 0;
+            this.globals.put("#food_tab_visible", new JsonPrimitive(categories && food));
+            this.globals.put("#items_tab_is_leftmost", new JsonPrimitive(categories && items && !food));
+            this.globals.put("#items_tab_visible_not_leftmost", new JsonPrimitive(categories && items && food));
+            this.globals.put("#blocks_tab_is_leftmost", new JsonPrimitive(categories && blocks && !food && !items));
+            this.globals.put("#blocks_tab_visible_not_leftmost", new JsonPrimitive(categories && blocks && (food || items)));
+            final boolean verticalTabs = menu.book.forcedRecipeBookLayout;
+            final int tabSpacing = verticalTabs ? 29 : 25;
+            this.globals.put("#food_tab_offset", offset(0, verticalTabs));
+            this.globals.put("#items_tab_offset", offset(food ? 0 : -tabSpacing, verticalTabs));
+            this.globals.put("#blocks_tab_offset", offset(((food ? -1 : -2) + (items ? 1 : 0)) * tabSpacing, verticalTabs));
+            this.globals.put("#furnace_arrow_ratio", new JsonPrimitive(menu.progress.arrowRatio(menu.family)));
+            this.globals.put("#furnace_flame_ratio", new JsonPrimitive(menu.progress.flameRatio(menu.family)));
+        }
+
+        private static JsonArray offset(final int distance, final boolean vertical) {
+            final JsonArray result = new JsonArray();
+            result.add(vertical ? 0 : distance);
+            result.add(vertical ? distance : 0);
+            return result;
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "inventory_items";
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            if (scope == null) {
+                return Map.of();
+            }
+            final Map<String, JsonElement> values = new HashMap<>(super.variables(scope));
+            if ("hotbar_items".equals(scope.collection()) || "inventory_items".equals(scope.collection())) {
+                // The desktop controller owns these backgrounds, independently of recipe availability.
+                values.put("#container_item_background", new JsonPrimitive(0));
+            }
+            values.put("#is_recipe_selected_slot", new JsonPrimitive(this.selection.collection.equals(scope.collection())
+                    && this.selection.index == scope.index()));
+            return values;
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            super.decorate(node, control, resolved, scope);
+            if (scope == null || !"recipe_book".equals(scope.collection())) {
+                return;
+            }
+            node.addProperty("recipe_id", this.variables(scope).get("#item_renderer_data").getAsJsonObject().get("recipe_id").getAsInt());
+            if (!node.has("button_mappings")) {
+                return;
+            }
+            final JsonArray actions = new JsonArray();
+            for (final JsonElement element : node.getAsJsonArray("button_mappings")) {
+                final JsonObject mapping = element.getAsJsonObject();
+                if (!UiExpression.truth(mapping.get("ignored")) && RECIPE_ACTIONS.contains(JsonUiProgram.string(mapping, "to_button_id"))) {
+                    actions.add(mapping.deepCopy());
+                }
+            }
+            if (!actions.isEmpty()) {
+                node.add("recipe_actions", actions);
+            }
+        }
+    }
+
+}
