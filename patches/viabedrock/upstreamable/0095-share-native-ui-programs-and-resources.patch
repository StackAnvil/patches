+    @Test
+    void componentPatchesRoundTripWithoutSharingNativeStackMetadataOrPartialOversizedWrites() {
+        // A private component registry exercises the real item codec without
+        // changing ViaVersion's process-wide registry used by other tests.
+        final var serializers = mock(FullMappings.class);
+        when(serializers.mappedSize()).thenReturn(1);
+        when(serializers.mappedId(anyString())).thenReturn(0);
+        final var mappings = mock(MappingData.class);
+        when(mappings.getDataComponentSerializerMappings()).thenReturn(serializers);
+        final var protocol = mock(Protocol.class);
+        when(protocol.getMappingData()).thenReturn(mappings);
+        final var components = new StructuredDataType();
+        components.filler(protocol).add(StructuredDataKey.CUSTOM_DATA);
+        final var codec = NativeCookingMessage.codec(() -> new ItemType1_20_5(components));
+        final var nested = new CompoundTag();
+        nested.putInt("value", 17);
+        final var tag = new CompoundTag();
+        tag.put("native", nested);
+        final var custom = StructuredDataKey.CUSTOM_DATA;
+        final var component = StructuredData.of(custom, tag, 0);
+        final var items = new HashMap<>(items());
+        items.put(7, new StructuredItem(320, 255, new StructuredDataContainer(
+                new StructuredData<?>[]{component})));
+        final var ui = new CookingUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        final var view = view(CookingUi.Family.FURNACE);
+        final var message = NativeCookingMessage.create(ui, view, 1, 1, 0, 0, 0, items);
+        nested.putInt("value", 29);
+        message.recipeItem(7).dataContainer().get(custom).getCompoundTag("native").putInt("value", 53);
+        assertEquals(17, message.recipeItem(7).dataContainer().get(custom).getCompoundTag("native").getInt("value"));
+        final var buffer = Unpooled.buffer();
+        try {
+            codec.write(buffer, message);
+            final var decoded = codec.read(buffer);
+            assertEquals(255, decoded.recipeItem(7).amount());
+            assertEquals(message.recipeItem(7).dataContainer().get(custom), decoded.recipeItem(7).dataContainer().get(custom));
+            assertFalse(buffer.isReadable());
+            final var hugeTag = new CompoundTag();
+            hugeTag.put("bytes", new ByteArrayTag(new byte[NativeCookingMessage.MAX_PAYLOAD_BYTES]));
+            final var hugeComponent = StructuredData.of(custom, hugeTag, 0);
+            items.put(7, new StructuredItem(320, 1, new StructuredDataContainer(
+                    new StructuredData<?>[]{hugeComponent})));
+            final var huge = NativeCookingMessage.create(ui, view, 1, 1, 0, 0, 0, items);
+            buffer.clear();
+            buffer.writeByte(27);
+            assertThrows(IllegalArgumentException.class, () -> codec.write(buffer, huge));
+            assertEquals(1, buffer.writerIndex());
+            assertEquals(27, buffer.getByte(0));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static NativeCookingMessage copy(final NativeCookingMessage source, final int menuId, final String program, final String snapshot) {
+        return new NativeCookingMessage(menuId, source.sequence(), source.updateSequence(), source.menuRevision(),
+                source.inventoryRevision(), source.cursorRevision(), program, snapshot, source.recipeItems());
+    }
+
+    private static Map<Integer, Item> items() {
+        return Map.of(7, new StructuredItem(320, 2, new StructuredDataContainer()),
+                19, new StructuredItem(321, 1, new StructuredDataContainer()),
+                23, new StructuredItem(322, 5, new StructuredDataContainer()));
+    }
