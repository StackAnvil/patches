+    @Test
+    void chestFamiliesKeepDistinctActualSlotAddressesAndMirroredControls() {
+        for (final ContainerUi.Kind kind : List.of(ContainerUi.Kind.CHEST_3_ROWS, ContainerUi.Kind.CHEST_6_ROWS)) {
+            final int external = kind.containerSlots();
+            final var scene = ui().resolve(menu(kind, "Actual title", 16));
