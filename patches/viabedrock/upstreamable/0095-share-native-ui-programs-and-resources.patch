+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.JsonUiResourceRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import javax.imageio.ImageIO;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class UiTexturesTest {
+
+    @Test
+    void caseSensitiveNativeNamesResolveToDistinctUsableConvertedResources() throws Exception {
+        final var upper = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        upper.setRGB(0, 0, 0xFF1256AB);
+        final var lower = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        lower.setRGB(0, 0, 0xFFAB5612);
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + java.util.UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        content.put("textures/ui/Banners.png", encode(upper, "png"));
+        content.put("textures/ui/banners.png", encode(lower, "png"));
+        final var pack = new ResourcePack(content);
+        final var converted = JsonUiResourceRewriter.convert(new ResourcePackStorage(List.of(pack)));
+        final String upperId = JsonUiProgram.textureId("textures/ui/Banners");
+        final String lowerId = JsonUiProgram.textureId("textures/ui/banners");
+        assertTrue(upperId.matches("[a-z0-9_.-]+:[a-z0-9/._-]+"));
+        assertNotEquals(upperId, lowerId);
+        for (final String extension : List.of("png", "jpg", "tga")) {
+            assertEquals(upperId, JsonUiProgram.textureId("textures/ui/Banners." + extension));
+        }
+        assertEquals(upper.getRGB(0, 0), converted.getImage("assets/viabedrock/" + upperId.substring(11)).getImage().getRGB(0, 0));
+        assertEquals(lower.getRGB(0, 0), converted.getImage("assets/viabedrock/" + lowerId.substring(11)).getImage().getRGB(0, 0));
+        assertThrows(IllegalArgumentException.class, () -> JsonUiProgram.textureId("textures/ui/../Banners"));
+    }
+
+    @Test
+    void boundTexturesOutsideTheUiDirectoryRetainLayerPixelsAndMetadata() throws Exception {
+        final String path = "textures/profile/backgrounds/default";
+        final var lowerImage = new BufferedImage(2, 1, BufferedImage.TYPE_INT_ARGB);
+        lowerImage.setRGB(0, 0, 0xFF1256AB);
+        final byte[] lower = encode(lowerImage, "png");
+        final var upperImage = new BufferedImage(2, 1, BufferedImage.TYPE_INT_RGB);
+        upperImage.setRGB(1, 0, 0xE59732);
+        final byte[] upper = encode(upperImage, "jpg");
+        final var ui = new JsonUiProgram(List.of(
+                Map.of(path + ".png", lower),
+                Map.of(path + ".jpg", upper,
+                        path + ".json", "{\"nineslice_size\":1}".getBytes(StandardCharsets.UTF_8),
+                        "ui/server_form.json", """
+                                {"namespace":"server_form","main_screen_content":{
+                                  "type":"button","collection_index":0,
+                                  "$pressed_button_name":"button.form_button_click",
+                                  "texture":"#title_text",
+                                  "bindings":[{"binding_name":"#title_text"}]}}
+                                """.getBytes(StandardCharsets.UTF_8))));
+        final var form = JsonParser.parseString("{\"type\":\"form\",\"title\":\"" + path
+                + "\",\"elements\":[{\"type\":\"button\",\"text\":\"\"}]}").getAsJsonObject();
+        final var root = new ServerFormUi(ui).resolve(form).getAsJsonObject("root");
+        assertEquals(JsonUiProgram.textureId(path), root.get("texture").getAsString());
+        assertEquals(1, root.get("nineslice_size").getAsInt());
+        final var expected = ImageIO.read(new ByteArrayInputStream(upper));
+        final var actual = ImageIO.read(new ByteArrayInputStream(ui.textures().get(path + ".png")));
+        assertArrayEquals(expected.getRGB(0, 0, 2, 1, null, 0, 2),
+                actual.getRGB(0, 0, 2, 1, null, 0, 2));
+        final var rejected = new HashMap<String, byte[]>();
+        UiTextures.load(Map.of("textures/profile/../outside.png", lower,
+                "foreign/default.png", lower), rejected);
+        assertTrue(rejected.isEmpty());
+    }
+
+    @Test
+    void jpegConversionPreservesDecodedPixelsAndLayerPriority() throws Exception {
+        final var image = new BufferedImage(3, 2, BufferedImage.TYPE_INT_RGB);
+        image.setRGB(1, 0, 0xBD3716);
+        final byte[] jpeg = encode(image, "jpg");
+        final byte[] png = encode(image, "png");
+        final var lower = new JsonUiProgram(List.of(Map.of("textures/ui/item.png", png,
+                "textures/ui/item.jpg", jpeg)));
+        assertArrayEquals(png, lower.textures().get("textures/ui/item.png"));
+        final String definition = """
+                {"namespace":"server_form","main_screen_content":{"type":"button","collection_index":0,
+                 "$pressed_button_name":"button.form_button_click","texture":"textures/ui/item.jpg"}}
+                """;
+        final var upper = new JsonUiProgram(List.of(lower.textures(), Map.of("textures/ui/item.jpg", jpeg,
+                "textures/ui/item.json", "{\"nineslice_size\":2}".getBytes(StandardCharsets.UTF_8),
+                "ui/server_form.json", definition.getBytes(StandardCharsets.UTF_8))));
+        final var form = JsonParser.parseString("{\"type\":\"form\",\"title\":\"\",\"elements\":[{\"type\":\"button\",\"text\":\"\"}]}").getAsJsonObject();
+        final var root = new ServerFormUi(upper).resolve(form).getAsJsonObject("root");
+        assertEquals(JsonUiProgram.textureId("textures/ui/item"), root.get("texture").getAsString());
+        assertEquals(2, root.get("nineslice_size").getAsInt());
+        final var decoded = ImageIO.read(new ByteArrayInputStream(jpeg));
+        final var normalized = ImageIO.read(new ByteArrayInputStream(upper.textures().get("textures/ui/item.png")));
+        assertEquals(decoded.getWidth(), normalized.getWidth());
+        assertEquals(decoded.getHeight(), normalized.getHeight());
+        assertArrayEquals(decoded.getRGB(0, 0, 3, 2, null, 0, 3), normalized.getRGB(0, 0, 3, 2, null, 0, 3));
+        assertEquals(2, upper.textures().size());
+    }
+
+    @Test
+    void tgaConversionRetainsOrientationAndAlpha() throws Exception {
+        final byte[] tga = new byte[26];
+        tga[2] = 2;
+        tga[12] = 2;
+        tga[14] = 1;
+        tga[16] = 32;
+        tga[17] = 0x30;
+        tga[18] = 0x11;
+        tga[19] = 0x22;
+        tga[20] = 0x33;
+        tga[21] = 0x44;
+        tga[22] = 0x55;
+        tga[23] = 0x66;
+        tga[24] = 0x77;
+        tga[25] = (byte) 0x88;
+        final var ui = new JsonUiProgram(List.of(Map.of("textures/ui/item.tga", tga)));
+        final var image = ImageIO.read(new ByteArrayInputStream(ui.textures().get("textures/ui/item.png")));
+        assertEquals(0x88776655, image.getRGB(0, 0));
+        assertEquals(0x44332211, image.getRGB(1, 0));
+    }
+
+    @Test
+    void malformedAndOversizedImagesLeaveUnrelatedTexturesUsable() throws Exception {
+        final byte[] png = encode(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB), "png");
+        final byte[] oversized = encode(new BufferedImage(4097, 1, BufferedImage.TYPE_INT_RGB), "jpg");
+        final var result = new HashMap<String, byte[]>();
+        UiTextures.load(Map.of("textures/ui/retained.png", png, "textures/ui/broken.jpg", new byte[]{1, 2},
+                "textures/ui/oversized.jpg", oversized, "textures/ui/../../foreign.jpg", oversized), result);
+        assertEquals(1, result.size());
+        assertArrayEquals(png, result.get("textures/ui/retained.png"));
+        UiTextures.load(Map.of("textures/ui/retained.jpg", new byte[]{1, 2}), result);
+        assertArrayEquals(png, result.get("textures/ui/retained.png"));
+        UiTextures.load(Map.of("textures/ui/retained.png", new byte[]{1, 2},
+                "textures/ui/oversized.png", encode(new BufferedImage(4097, 1, BufferedImage.TYPE_INT_RGB), "png")), result);
+        assertEquals(1, result.size());
+        assertArrayEquals(png, result.get("textures/ui/retained.png"));
+    }
+
+    @Test
+    void aFullLayerAllowsUpperReplacementsWithoutAddingNewEntries() throws Exception {
+        final byte[] png = encode(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB), "png");
+        final var result = new HashMap<String, byte[]>();
+        for (int index = 0; index < UiTextures.MAX_FILES; index++) {
+            result.put("textures/ui/" + index + ".png", png);
+        }
+        final var image = new BufferedImage(2, 1, BufferedImage.TYPE_INT_RGB);
+        image.setRGB(0, 0, 0xB26722);
+        final byte[] replacement = encode(image, "png");
+        UiTextures.load(Map.of("textures/ui/0.png", replacement, "textures/ui/new.png", png), result);
+        assertEquals(UiTextures.MAX_FILES, result.size());
+        assertArrayEquals(replacement, result.get("textures/ui/0.png"));
+        assertFalse(result.containsKey("textures/ui/new.png"));
+    }
+
+    private static byte[] encode(final BufferedImage image, final String format) throws Exception {
+        final var output = new ByteArrayOutputStream();
+        assertTrue(ImageIO.write(image, format, output));
+        return output.toByteArray();
+    }
+
+}
