@@ -0,0 +1,322 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.NpcRequestPacketPayload_RequestType;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Actor-scoped editing state shared by the server projection and the add-on controller. */
+public final class NpcEditorState {
+
+    private final JsonObject source;
+    private final List<Action> actions = new ArrayList<>();
+    private final List<Update> updates = new ArrayList<>();
+    private String name;
+    private String dialogue;
+    private int skin;
+    private int page;
+    private int nextIdentity;
+    private int maximized = -1;
+    private View view = View.BASIC;
+    private boolean closed;
+
+    public NpcEditorState(final JsonObject source) {
+        this.source = source.deepCopy();
+        this.name = source.get("name").getAsString();
+        this.dialogue = source.get("dialogue").getAsString();
+        this.skin = source.get("skin_index").getAsBigDecimal().intValueExact();
+        final var skins = this.appearance().getAsJsonArray("skin_list");
+        if (skins == null || skins.size() > 256 || this.skin < 0 || this.skin >= skins.size()) {
+            throw new IllegalArgumentException("Invalid NPC editor appearance");
+        }
+        this.page = this.skin / 5;
+        final var values = source.getAsJsonArray("actions");
+        if (values.size() > 256) {
+            throw new IllegalArgumentException("Too many NPC actions");
+        }
+        for (final var entry : values) {
+            final var action = entry.getAsJsonObject().deepCopy();
+            final int type = action.get("type").getAsBigDecimal().intValueExact();
+            final int mode = action.get("mode").getAsBigDecimal().intValueExact();
+            if (type < 0 || type > 1 || mode < 0 || mode > 2) {
+                throw new IllegalArgumentException("Unsupported NPC editor action");
+            }
+            this.actions.add(new Action(this.nextIdentity++, action));
+        }
+    }
+
+    public JsonObject source() {
+        return this.source.deepCopy();
+    }
+
+    public JsonObject appearance() {
+        return this.source.getAsJsonObject("actor_data").deepCopy();
+    }
+
+    public View view() {
+        return this.view;
+    }
+
+    public String name() {
+        return this.name;
+    }
+
+    public String dialogue() {
+        return this.dialogue;
+    }
+
+    public int skin() {
+        return this.skin;
+    }
+
+    public int page() {
+        return this.page;
+    }
+
+    public boolean closed() {
+        return this.closed;
+    }
+
+    public boolean commandsEnabled() {
+        return this.source.get("commands_enabled").getAsBoolean();
+    }
+
+    public boolean education() {
+        return this.source.get("education").getAsBoolean();
+    }
+
+    public int count() {
+        return this.actions.size();
+    }
+
+    public JsonObject action(final int index) {
+        return this.actions.get(index).value().deepCopy();
+    }
+
+    public int actionInput(final int index, final boolean buttonName) {
+        return 2 + this.actions.get(index).identity() * 2 + (buttonName ? 1 : 0);
+    }
+
+    public int maximizedInput() {
+        return this.actionInput(this.maximized, false);
+    }
+
+    public String maximizedText() {
+        return this.text(this.maximizedInput());
+    }
+
+    public String placeholderKey(final int input) {
+        if (input == 0 || (input > 1 && (input & 1) != 0)) {
+            return "";
+        }
+        if (input == 1) {
+            return "npcscreen.addtext";
+        }
+        return this.inputAction(input).value().get("type").getAsInt() == 0
+                ? "npcscreen.action.url.placeholder"
+                : "npcscreen.action.command.placeholder";
+    }
+
+    public int maxLength(final int input) {
+        return input == 0 ? 128 : input == 1 ? 1000 : (input & 1) == 0 ? 1024 : 128;
+    }
+
+    public String text(final int input) {
+        if (input == 0) {
+            return this.name;
+        }
+        if (input == 1) {
+            return this.dialogue;
+        }
+        final var action = this.inputAction(input).value();
+        return JsonUiProgram.string(action, (input & 1) == 0 ? "text" : "button_name");
+    }
+
+    public boolean setText(final int input, final String value) {
+        if (this.closed || value.length() > this.maxLength(input)) {
+            throw new IllegalArgumentException("Invalid NPC editor text");
+        }
+        if (this.text(input).equals(value)) {
+            return false;
+        }
+        if (input == 0) {
+            this.name = value;
+            this.updates.add(new Update(NpcRequestPacketPayload_RequestType.SetName, value, 0));
+        } else if (input == 1) {
+            this.dialogue = value;
+            this.updates.add(
+                    new Update(NpcRequestPacketPayload_RequestType.SetInteractText, value, 0));
+        } else {
+            final var action = this.inputAction(input).value();
+            if ((input & 1) != 0) {
+                action.addProperty("button_name", value);
+            } else {
+                final boolean command = action.get("type").getAsInt() == 1;
+                action.addProperty("text", value);
+                final JsonArray data = new JsonArray();
+                if (command) {
+                    for (final String line : value.split("\n", -1)) {
+                        if (line.isBlank()) {
+                            continue;
+                        }
+                        final JsonObject entry = new JsonObject();
+                        entry.addProperty("cmd_line", line);
+                        entry.addProperty("cmd_ver", 52);
+                        data.add(entry);
+                    }
+                }
+                action.add("data", data);
+            }
+        }
+        return true;
+    }
+
+    private Action inputAction(final int input) {
+        if (input < 2) {
+            throw new IllegalArgumentException("Invalid NPC action input");
+        }
+        final int identity = (input - 2) / 2;
+        return this.actions.stream()
+                .filter(action -> action.identity() == identity)
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("Retired NPC action input"));
+    }
+
+    public List<Update> drainUpdates() {
+        final var result = List.copyOf(this.updates);
+        this.updates.clear();
+        return result;
+    }
+
+    /** Local navigation never executes the edited commands. */
+    public void activate(final String command, final int selected) {
+        if (this.closed) {
+            return;
+        }
+        switch (command) {
+            case "button.dialog_button" -> this.view = View.DIALOGUE;
+            case "button.advanced_settings" -> this.view = View.ADVANCED;
+            case "button.exit_student_edit" -> this.view = View.BASIC;
+            case "button.exit_advanced" -> {
+                this.flushActions();
+                this.view = View.BASIC;
+            }
+            case "button.exit_maximized" -> {
+                this.maximized = -1;
+                this.view = View.ADVANCED;
+            }
+            case "button.exit_basic", "button.menu_continue", "button.menu_exit" -> this.cancel();
+            case "button.cycle_pack_left" -> this.page = Math.max(0, this.page - 1);
+            case "button.cycle_pack_right" ->
+                this.page =
+                            Math.min(
+                                    (this.appearance().getAsJsonArray("skin_list").size() - 1) / 5,
+                                    this.page + 1);
+            case "button.view_skin" -> {
+                if (selected < this.page * 5
+                        || selected
+                                >= Math.min(
+                                        this.page * 5 + 5,
+                                        this.appearance().getAsJsonArray("skin_list").size())) {
+                    throw new IllegalArgumentException("Invalid NPC picker selection");
+                }
+                this.skin = selected;
+                this.updates.add(
+                        new Update(NpcRequestPacketPayload_RequestType.SetSkin, "", selected));
+            }
+            case "button.add_command", "button.add_url" -> {
+                if (!this.commandsEnabled()
+                        || this.actions.size() >= 256
+                        || command.equals("button.add_url") && !this.education()) {
+                    return;
+                }
+                final JsonObject action = new JsonObject();
+                action.addProperty("type", command.equals("button.add_url") ? 0 : 1);
+                action.addProperty("mode", command.equals("button.add_url") ? 0 : 1);
+                action.addProperty("button_name", "");
+                action.addProperty("text", "");
+                action.add("data", new JsonArray());
+                this.actions.add(new Action(this.nextIdentity++, action));
+            }
+            case "button.delete_action" -> this.actions.remove(selected);
+            case "button.expand_action_edit" -> {
+                this.actions.get(selected);
+                this.maximized = selected;
+                this.view = View.MAXIMIZED;
+            }
+            case "button_mode_toggle", "on_enter_toggle", "on_exit_toggle" -> {
+                final var action = this.actions.get(selected).value();
+                if (action.get("type").getAsInt() != 1 || !this.commandsEnabled()) {
+                    return;
+                }
+                final int mode =
+                        command.equals("button_mode_toggle")
+                                ? 0
+                                : command.equals("on_enter_toggle") ? 2 : 1;
+                action.addProperty("mode", action.get("mode").getAsInt() == mode ? 1 : mode);
+            }
+            default ->
+                    throw new IllegalArgumentException("Unsupported NPC editor command " + command);
+        }
+    }
+
+    public void cancel() {
+        if (this.closed) {
+            return;
+        }
+        switch (this.view) {
+            case DIALOGUE -> this.view = View.BASIC;
+            case ADVANCED -> {
+                this.flushActions();
+                this.view = View.BASIC;
+            }
+            case MAXIMIZED -> {
+                this.maximized = -1;
+                this.view = View.ADVANCED;
+            }
+            case BASIC -> {
+                this.flushActions();
+                this.closed = true;
+            }
+        }
+    }
+
+    private void flushActions() {
+        final var values = new JsonArray();
+        this.actions.forEach(
+                action -> {
+                    final var value = action.value().deepCopy();
+                    final String text = JsonUiProgram.string(value, "text");
+                    if (value.get("type").getAsInt() == 1
+                            && !text.isEmpty()
+                            && !text.endsWith("\n")) {
+                        value.addProperty("text", text + "\n");
+                    }
+                    values.add(value);
+                });
+        this.updates.add(
+                new Update(NpcRequestPacketPayload_RequestType.SetActions, values.toString(), 0));
+    }
+
+    public enum View {
+        BASIC,
+        DIALOGUE,
+        ADVANCED,
+        MAXIMIZED
+    }
+
+    public record Update(NpcRequestPacketPayload_RequestType type, String data, int actionIndex) {
+    }
+
+    private record Action(int identity, JsonObject value) {
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/RecipeCollection.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/ui/RecipeCollection.java
