--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/RecipeCollectionTest.java
@@ -0,0 +1,227 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class RecipeCollectionTest {
+
+    @Test
+    void partitionsWholeContiguousRunsAndKeepsRepresentativeIdentity() {
+        final var source = new Source();
+        final var first = new Group(1000, 1);
+        final var second = new Group(1001, 1);
+        final var entries = List.of(entry(1, 2, first), entry(2, 0, first), entry(3, 1, second), entry(4, 3, second));
+        final var collection = new RecipeCollection<>(source);
+        final var result = collection.refresh(entries.reversed(), true, true, false);
+        assertEquals(List.of(2, 1, 4, 3), ids(result.ordered()));
+        assertEquals(List.of(4, 2), ids(result.representatives()));
+        assertEquals(4, result.eligibleCount());
+        assertEquals(List.of(new RecipeCollection.Header<Entry, Group>(first, false),
+                new RecipeCollection.Header<Entry, Group>(second, false)), result.rows());
+        assertEquals(List.of(4, 3, 2, 1), source.evaluations);
+    }
+
+    @Test
+    void preservesFirstStateForHiddenAndUnavailableRunsUntilAnEligibleMemberAppears() {
+        final var first = new Group(1000, 1);
+        final var second = new Group(1001, 1);
+        final var collection = new RecipeCollection<>(new Source());
+        final var result = collection.refresh(List.of(entry(1, 3, first), entry(2, 2, first),
+                entry(3, 2, second), entry(4, 3, second)), true, true, false);
+        assertEquals(List.of(3, 4, 1, 2), ids(result.ordered()));
+        assertEquals(2, result.eligibleCount());
+        assertTrue(result.representatives().isEmpty());
+        // Grouped projection includes valid rows beyond the flat eligible prefix.
+        assertEquals(2, result.rows().size());
+    }
+
+    @Test
+    void skipsEvaluationOnlyForUnfilteredGroupedRows() {
+        final var source = new Source();
+        final var collection = new RecipeCollection<>(source);
+        final var entries = List.of(entry(1, 3, null), entry(2, 2, null), entry(3, 0, null), entry(4, 1, null));
+        assertEquals(List.of(1, 2, 3, 4), ids(collection.refresh(entries, true, false, false).ordered()));
+        assertTrue(source.evaluations.isEmpty());
+        assertEquals(List.of(3, 2, 4), ids(collection.refresh(entries, false, false, false).eligibleItems()));
+        assertEquals(List.of(1, 2, 3, 4), source.evaluations);
+        source.evaluations.clear();
+        assertEquals(List.of(3, 4, 2), ids(collection.refresh(entries, false, true, false).eligibleItems()));
+        assertEquals(List.of(1, 2, 3, 4), source.evaluations);
+    }
+
+    @Test
+    void retainsExpansionAcrossOrderingFilteringAndFlatRefreshUntilReset() {
+        final var first = new Group(1000, 1);
+        final var second = new Group(1001, 1);
+        final var entries = List.of(entry(1, 2, first), entry(2, 0, first), entry(3, 1, second), entry(4, 3, second));
+        final var collection = new RecipeCollection<>(new Source());
+        collection.refresh(entries, true, false, false);
+        assertEquals(new RecipeCollection.Toggle(0, 2, true), collection.toggleHeader(first));
+        final var expanded = collection.snapshot();
+        assertEquals(4, expanded.rows().size());
+        assertEquals(4, collection.refresh(entries.reversed(), true, true, false).rows().size());
+        collection.refresh(entries, false, false, true);
+        assertNull(collection.toggleHeader(first));
+        assertEquals(4, collection.refresh(entries, true, false, false).rows().size());
+        assertEquals(2, collection.refresh(entries, true, false, true).rows().size());
+        assertEquals(4, expanded.rows().size());
+        assertThrows(UnsupportedOperationException.class, () -> expanded.rows().clear());
+        assertThrows(UnsupportedOperationException.class, () -> expanded.ordered().clear());
+    }
+
+    @Test
+    void separatesCatalogGroupIdentityFromHeaderIconAndCount() {
+        final var first = new Group(1000, 1);
+        final var alias = new Group(1000, 1);
+        final var changedCount = new Group(1000, 2);
+        final var collection = new RecipeCollection<>(new Source());
+        collection.refresh(List.of(entry(1, 0, first), entry(2, 0, alias)), true, true, false);
+        assertEquals(2, collection.snapshot().rows().size());
+        assertEquals(new RecipeCollection.Toggle(0, 1, true), collection.toggleHeader(alias));
+        assertEquals(List.of(new RecipeCollection.Header<Entry, Group>(first, true),
+                new RecipeCollection.Member<Entry, Group>(entry(1, 0, first), first),
+                new RecipeCollection.Header<Entry, Group>(alias, false)), collection.snapshot().rows());
+        assertEquals(4, collection.refresh(List.of(entry(2, 0, alias), entry(1, 0, first)), true, true, false).rows().size());
+        assertNull(collection.toggleHeader(changedCount));
+        assertEquals(List.of(new RecipeCollection.Header<Entry, Group>(changedCount, false)),
+                collection.refresh(List.of(entry(3, 0, changedCount)), true, true, false).rows());
+    }
+
+    @Test
+    void skipsInvalidEntriesWithoutBreakingPendingGroupsOrEvaluatingThem() {
+        final var source = new Source();
+        final var group = new Group(1000, 1);
+        final var entries = List.of(entry(1, 2, group), new Entry(2, -1, null, false), entry(3, 0, group));
+        final var collection = new RecipeCollection<>(source);
+        final var result = collection.refresh(entries, true, true, false);
+        assertEquals(List.of(1, 3, 2), ids(result.ordered()));
+        assertEquals(List.of(1), ids(result.representatives()));
+        assertEquals(List.of(1, 3), source.evaluations);
+        assertEquals(2, result.eligibleCount());
+        assertEquals(1, result.rows().size());
+        assertEquals(List.of(3, 1), ids(collection.refresh(entries, false, true, false).ordered()));
+        assertThrows(IllegalArgumentException.class, () -> collection.refresh(List.of(entry(1, 4, null)), false, false, false));
+        assertDoesNotThrow(() -> collection.refresh(List.of(entry(1, 4, null)), true, false, false));
+    }
+
+    @Test
+    void queriesCurrentFlatAvailabilityWithoutReorderingTheSnapshot() {
+        final var source = new Source();
+        final var collection = new RecipeCollection<>(source);
+        final var snapshot = collection.refresh(List.of(entry(1, 0, null), entry(2, 1, null)), false, true, false);
+        final int[] current = {0};
+        final int[] calls = {0};
+        final var eligibility = new RecipeCollection.Eligibility<Entry, Group>() {
+            @Override
+            public int evaluate(final RecipeCollection.Row<Entry, Group> row) {
+                calls[0]++;
+                return current[0];
+            }
+
+            @Override
+            public boolean represents(final Entry representative, final Group group) {
+                throw new AssertionError();
+            }
+        };
+        for (int state = 0; state < 4; state++) {
+            current[0] = state;
+            assertEquals(state >= 2, collection.disabled(0, eligibility));
+        }
+        assertEquals(4, calls[0]);
+        assertEquals(List.of(1, 2), source.evaluations);
+        assertSame(snapshot, collection.snapshot());
+        assertEquals(List.of(1, 2), ids(snapshot.ordered()));
+    }
+
+    @Test
+    void exemptsHeadersThatMatchTheirGroupRepresentativeByIconAndCount() {
+        for (final var group : List.of(new Group(1, 1), new Group(2, 1), new Group(1, 2))) {
+            final var collection = new RecipeCollection<>(new Source());
+            collection.refresh(List.of(entry(1, 2, group), entry(2, 0, group)), true, true, false);
+            final boolean exempt = group.icon == 1 && group.count == 1;
+            assertEquals(!exempt, collection.disabled(0, eligibility(2)));
+            collection.toggleHeader(group);
+            assertEquals(!exempt, collection.disabled(0, eligibility(2)));
+            assertTrue(collection.disabled(1, eligibility(2)));
+            assertTrue(collection.disabled(2, eligibility(2)));
+            for (final int state : new int[]{0, 1, 3}) {
+                assertFalse(collection.disabled(0, eligibility(state)));
+                assertFalse(collection.disabled(1, eligibility(state)));
+            }
+        }
+    }
+
+    @Test
+    void usesTheRefreshRepresentativesRatherThanRecomputingTheirAvailability() {
+        final var group = new Group(1, 1);
+        final var source = new Source();
+        final var collection = new RecipeCollection<>(source);
+        final var entries = List.of(entry(1, 3, group), entry(2, 3, group));
+        collection.refresh(entries, true, false, false);
+        assertFalse(collection.disabled(0, eligibility(2)));
+        assertTrue(source.evaluations.isEmpty());
+        collection.refresh(entries, true, true, false);
+        assertTrue(collection.disabled(0, eligibility(2)));
+        assertEquals(List.of(1, 2), source.evaluations);
+        assertFalse(collection.disabled(0, eligibility(3)));
+    }
+
+    private static RecipeCollection.Eligibility<Entry, Group> eligibility(final int state) {
+        return new RecipeCollection.Eligibility<>() {
+            @Override
+            public int evaluate(final RecipeCollection.Row<Entry, Group> row) {
+                return state;
+            }
+
+            @Override
+            public boolean represents(final Entry representative, final Group group) {
+                return representative.identity == group.icon && group.count == 1;
+            }
+        };
+    }
+
+    private static Entry entry(final int identity, final int state, final Group group) {
+        return new Entry(identity, state, group, true);
+    }
+
+    private static List<Integer> ids(final List<Entry> entries) {
+        return entries.stream().map(Entry::identity).toList();
+    }
+
+    private record Entry(int identity, int state, Group group, boolean valid) { }
+
+    private record Group(int icon, int count) { }
+
+    private static final class Source implements RecipeCollection.Source<Entry, Group> {
+        private final List<Integer> evaluations = new ArrayList<>();
+
+        @Override
+        public int evaluate(final Entry entry) {
+            this.evaluations.add(entry.identity);
+            return entry.state;
+        }
+
+        @Override
+        public boolean valid(final Entry entry) {
+            return entry.valid;
+        }
+
+        @Override
+        public Group group(final Entry entry) {
+            return entry.group;
+        }
+
+        @Override
+        public boolean sameHeader(final Group first, final Group second) {
+            return first.equals(second);
+        }
+    }
+
+}
