+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.function.Supplier;
+
+/** Searches native item names and display labels with the owning screen's matching policy. */
+public final class NativeRecipeSearch {
+
+    private final byte[] query;
+    private final Mode mode;
+
+    public NativeRecipeSearch(final String query, final Mode mode) {
+        this(query.getBytes(StandardCharsets.UTF_8), mode);
+    }
+
+    public NativeRecipeSearch(final byte[] query, final Mode mode) {
+        this.query = NativeSearchNormalization.normalize(Objects.requireNonNull(query));
+        this.mode = Objects.requireNonNull(mode);
+    }
+
+    public boolean isEmpty() {
+        return this.query.length == 0;
+    }
+
+    /** Name producers remain lazy. Empty queries need neither producer; a primary match skips the label. */
+    public boolean matches(final Supplier<byte[]> primaryName, final Supplier<byte[]> secondaryLabel) {
+        return this.isEmpty()
+                || this.matchesName(this.mode == Mode.COOKING ? primaryName.get() : stripFormatting(primaryName.get()))
+                || this.matchesName(stripFormatting(secondaryLabel.get()));
+    }
+
+    /** Native search drops incomplete section signs and recognizes only digits and lowercase a through w. */
+    public static byte[] stripFormatting(final byte[] input) {
+        final var output = new ByteArrayOutputStream(input.length);
+        int state = 0;
+        for (final byte value : input) {
+            final int next = Byte.toUnsignedInt(value);
+            if (state == 0) {
+                if (next == 0xC2) {
+                    state = 1;
+                } else {
+                    output.write(next);
+                }
+            } else if (state == 1) {
+                if (next == 0xA7) {
+                    state = 2;
+                } else {
+                    output.write(0xC2);
+                    output.write(next);
+                    state = 0;
+                }
+            } else {
+                if (!(next >= '0' && next <= '9' || next >= 'a' && next <= 'w')) {
+                    output.write(0xC2);
+                    output.write(0xA7);
+                    output.write(next);
+                }
+                state = 0;
+            }
+        }
+        return output.toByteArray();
+    }
+
+    private boolean matchesName(final byte[] name) {
+        final byte[] text = NativeSearchNormalization.normalize(name);
+        if (!this.contains(text)) {
+            return false;
+        }
+        if (this.mode != Mode.PLAYER_WORD_PREFIX) {
+            return true;
+        }
+        // The native stream loop accepts the first matching query token. Only ASCII space separates tokens.
+        // getline does not produce a final empty token after a trailing delimiter.
+        for (int queryStart = 0; queryStart < this.query.length; ) {
+            final int queryEnd = tokenEnd(this.query, queryStart);
+            final int length = queryEnd - queryStart;
+            for (int textStart = 0; textStart < text.length; ) {
+                final int textEnd = tokenEnd(text, textStart);
+                if (length <= textEnd - textStart
+                        && Arrays.equals(this.query, queryStart, queryEnd, text, textStart, textStart + length)) {
+                    return true;
+                }
+                textStart = textEnd + 1;
+            }
+            queryStart = queryEnd + 1;
+        }
+        return false;
+    }
+
+    private static int tokenEnd(final byte[] text, final int start) {
+        int end = start;
+        while (end < text.length && text[end] != ' ') {
+            end++;
+        }
+        return end;
+    }
+
+    private boolean contains(final byte[] text) {
+        for (int offset = 0; offset <= text.length - this.query.length; offset++) {
+            if (Arrays.equals(this.query, 0, this.query.length, text, offset, offset + this.query.length)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public enum Mode {
+        /** Cooking preserves primary-name formatting and uses a literal substring. */
+        COOKING,
+        /** Player search removes formatting from both name sources and uses a literal substring. */
+        PLAYER_SUBSTRING,
+        /** Player search also requires any space-delimited query token to prefix a name token. */
+        PLAYER_WORD_PREFIX
+    }
+
+}
