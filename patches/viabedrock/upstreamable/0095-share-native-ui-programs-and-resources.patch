+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+class CookingSearchTextTest {
+
+    @Test
+    void readinessCoalescesRawEditsWithoutApplyingOrDiscardingThemEarly() {
+        final var text = new CookingSearchText();
+        text.edit("old");
+        text.edit("a\0B煤炭 🔥");
+        assertFalse(text.tick(false));
+        assertEquals("", text.value());
+        assertTrue(text.tick(true));
+        assertEquals("a\0B煤炭 🔥", text.value());
+        assertFalse(text.tick(true));
+        text.edit(text.value());
+        assertTrue(text.tick(true));
+        text.edit("");
+        assertTrue(text.tick(true));
+        assertEquals("", text.value());
+        assertFalse(text.tick(true));
+    }
+
+    @Test
+    void guardedClearPreservesBothAppliedAndPendingTextOnlyForModeTwo() {
+        for (final int mode : List.of(0, 1, 2, 3)) {
+            final var text = new CookingSearchText();
+            text.edit("applied");
+            assertTrue(text.tick(true));
+            text.edit("pending");
+            assertEquals(mode != 2, text.clear(true, mode));
+            assertEquals(mode == 2 ? "applied" : "", text.value());
+            assertEquals(mode == 2, text.tick(true));
+            assertEquals(mode == 2 ? "pending" : "", text.value());
+            text.edit("discarded");
+            assertTrue(text.clear(false, mode));
+            assertEquals("", text.value());
+            assertFalse(text.tick(true));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_COOKING_SEARCH_EDITS", matches = ".+")
+    void matchesTheExecutedEditTickAndClearCallbacks() throws Exception {
+        final var data = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_COOKING_SEARCH_EDITS")))).getAsJsonObject();
+        int edits = 0;
+        for (final var element : data.getAsJsonArray("editCases")) {
+            final var row = element.getAsJsonObject();
+            final var text = new CookingSearchText();
+            for (final var value : row.getAsJsonArray("batch")) {
+                text.edit(value.getAsString());
+            }
+            final boolean ready = row.get("ready").getAsBoolean();
+            assertEquals(row.get("firstTickResult").getAsInt() != 0, text.tick(ready));
+            if (!ready) {
+                assertTrue(text.tick(true));
+            }
+            assertEquals(row.getAsJsonArray("applied").get(0).getAsString(), text.value());
+            assertFalse(text.tick(true));
+            edits++;
+        }
+        int clears = 0;
+        for (final var element : data.getAsJsonArray("clearCases")) {
+            final var row = element.getAsJsonObject();
+            final var text = new CookingSearchText();
+            if (row.get("pending").getAsBoolean()) {
+                text.edit("pending query over fifteen bytes");
+            }
+            assertEquals(row.get("handled").getAsInt() != 0, text.clear(row.get("guard").getAsBoolean(), row.get("inputMode").getAsInt()));
+            assertEquals("", text.value());
+            assertEquals(row.get("pendingAfter").getAsBoolean(), text.tick(true));
+            clears++;
+        }
+        assertEquals(22, edits);
+        assertEquals(16, clears);
+    }
+
+}
