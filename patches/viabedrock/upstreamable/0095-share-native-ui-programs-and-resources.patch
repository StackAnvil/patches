@@ -0,0 +1,190 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.zip.CRC32;
+import javax.imageio.ImageIO;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class UiBitmapFontsTest {
+
+    @Test
+    void mapsAllThreeExtendedPagesAndRemovesIncompleteAtlasRows() throws IOException {
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        final byte[] atlas = atlas(1, 0xFF12AB34);
+        fonts.load(Map.of("font/default8.json", metadata(true, null, null),
+                "font/default8.png", atlas, "font/default8_1.png", atlas, "font/default8_2.png", atlas));
+        final Map<String, byte[]> resources = fonts.resources();
+        final JsonArray providers = providers(resources);
+        assertEquals(3, providers.size());
+        for (int page = 0; page < 3; page++) {
+            final JsonObject provider = providers.get(page).getAsJsonObject();
+            assertEquals(12, provider.get("height").getAsInt());
+            assertEquals(10, provider.get("ascent").getAsInt());
+            final BufferedImage image = image(resources, provider);
+            assertEquals(128, image.getWidth());
+            assertEquals(120, image.getHeight());
+            assertEquals(0xFF12AB34, image.getRGB(127, 119));
+            assertEquals(10, provider.getAsJsonArray("chars").size());
+        }
+        // The existing space provider supplies its advance, not the one-unit empty bitmap cell.
+        assertEquals(0, codePoint(providers, 0, 32));
+        assertEquals(0x00C0, codePoint(providers, 0, 0));
+        assertEquals(0x00E1, codePoint(providers, 1, 0));
+        assertEquals(0x041B, codePoint(providers, 2, 0));
+        assertEquals(0x0391, codePoint(providers, 2, 66));
+        assertEquals(0x201E, codePoint(providers, 2, 128));
+        assertEquals(0, codePoint(providers, 2, 129));
+        // The extended Greek forms live on the third page, leaving their old cells unavailable.
+        assertEquals(0, codePoint(providers, 1, 64));
+    }
+
+    @Test
+    void keepsTextureOwnershipWhenUpperPacksOmitOrOnlySupplyMetadata() throws IOException {
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        fonts.load(Map.of("font/default8.json", metadata(true, null, null), "font/default8.png", atlas(1, 0xFF123456)));
+        fonts.load(Map.of("font/default8.png", atlas(1, 0xFFABCDEF)));
+        fonts.load(Map.of("font/default8.json", metadata(true, 14, -5)));
+        final Map<String, byte[]> resources = fonts.resources();
+        final JsonObject provider = providers(resources).get(0).getAsJsonObject();
+        assertEquals(8, provider.get("height").getAsInt());
+        assertEquals(7, provider.get("ascent").getAsInt());
+        assertEquals(16, provider.getAsJsonArray("chars").size());
+        assertEquals(0x03B1, codePoint(providers(resources), 0, 224));
+        assertEquals(0xFFABCDEF, image(resources, provider).getRGB(127, 127));
+        fonts.load(Map.of("font/default8.json", metadata(true, 10, -1), "font/default8.png", atlas(1, 0xFF876543)));
+        final JsonObject overridden = providers(fonts.resources()).get(0).getAsJsonObject();
+        assertEquals(10, overridden.get("height").getAsInt());
+        assertEquals(8, overridden.get("ascent").getAsInt());
+        assertEquals(12, overridden.getAsJsonArray("chars").size());
+        assertEquals(120, image(fonts.resources(), overridden).getHeight());
+    }
+
+    @Test
+    void appliesExplicitMetricsAtHigherTextureResolutionAndRetainsPixelScale() throws IOException {
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        fonts.load(Map.of("font/default8.json", metadata(true, 16, 2), "font/default8.png", atlas(2, 0xFF192837)));
+        final Map<String, byte[]> resources = fonts.resources();
+        final JsonObject provider = providers(resources).get(0).getAsJsonObject();
+        assertEquals(16, provider.get("height").getAsInt());
+        assertEquals(5, provider.get("ascent").getAsInt());
+        assertEquals(8, provider.getAsJsonArray("chars").size());
+        final BufferedImage image = image(resources, provider);
+        assertEquals(256, image.getWidth());
+        assertEquals(256, image.getHeight());
+        assertEquals(0xFF192837, image.getRGB(255, 255));
+    }
+
+    @Test
+    void preservesOffsetsAboveTheJavaProviderHeightLimitByPaddingEachCell() throws IOException {
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        fonts.load(Map.of("font/default8.json", metadata(true, 12, -8), "font/default8.png", atlas(1, 0xFF192837)));
+        final Map<String, byte[]> resources = fonts.resources();
+        final JsonObject provider = providers(resources).get(0).getAsJsonObject();
+        assertEquals(15, provider.get("height").getAsInt());
+        assertEquals(15, provider.get("ascent").getAsInt());
+        final BufferedImage image = image(resources, provider);
+        assertEquals(150, image.getHeight());
+        assertEquals(0xFF192837, image.getRGB(0, 11));
+        assertEquals(0, image.getRGB(0, 12));
+        assertEquals(0xFF192837, image.getRGB(0, 15));
+    }
+
+    @Test
+    void retainsUpperUnicodePagesAfterAsciiProvidersIncludingTheLastBmpPage() throws IOException {
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        fonts.load(Map.of("font/default8.png", atlas(1, 0xFFABCDEF), "font/glyph_FF.png", atlas(2, 0xFF123456), "font/glyph_00.png", atlas(1, 0)));
+        fonts.load(Map.of("font/glyph_FF.png", atlas(1, 0xFF654321)));
+        final Map<String, byte[]> resources = fonts.resources();
+        final JsonArray providers = providers(resources);
+        assertEquals(3, providers.size());
+        final int lastPage = java.util.stream.IntStream.range(1, providers.size())
+                .filter(page -> codePoint(providers, page, 0) == 0xFF00).findFirst().orElseThrow();
+        final int firstPage = lastPage == 1 ? 2 : 1;
+        assertEquals(0, codePoint(providers, firstPage, 32));
+        final JsonObject unicode = providers.get(lastPage).getAsJsonObject();
+        assertEquals(0xFFFF, codePoint(providers, lastPage, 255));
+        assertEquals(0xFF654321, image(resources, unicode).getRGB(0, 0));
+        assertEquals(9, unicode.get("height").getAsInt());
+        assertEquals(9, unicode.get("ascent").getAsInt());
+        assertEquals(144, image(resources, unicode).getHeight());
+        assertEquals(0, image(resources, unicode).getRGB(0, 8));
+        assertEquals(0xFF654321, image(resources, unicode).getRGB(0, 9));
+    }
+
+    @Test
+    void rejectsInvalidLayoutsAndSkipsUnusableImagesWithoutLosingOtherFonts() throws IOException {
+        for (final int height : new int[] {0, -1, 129, Integer.MAX_VALUE}) {
+            final UiBitmapFonts fonts = new UiBitmapFonts();
+            fonts.load(Map.of("font/default8.json", metadata(true, height, null), "font/default8.png", atlas(1, 0xFFFFFFFF)));
+            assertEquals(8, providers(fonts.resources()).get(0).getAsJsonObject().get("height").getAsInt());
+        }
+        final byte[] oversized = atlas(1, 0xFFFFFFFF);
+        java.nio.ByteBuffer.wrap(oversized).putInt(16, 50000);
+        final var checksum = new CRC32();
+        checksum.update(oversized, 12, 17);
+        java.nio.ByteBuffer.wrap(oversized).putInt(29, (int) checksum.getValue());
+        for (final byte[] unusable : new byte[][] {new byte[] {1, 2, 3}, oversized}) {
+            final UiBitmapFonts rejected = new UiBitmapFonts();
+            rejected.load(Map.of("font/default8.png", unusable));
+            assertTrue(rejected.resources().isEmpty());
+        }
+        final UiBitmapFonts fonts = new UiBitmapFonts();
+        fonts.load(Map.of("font/default8.json", metadata(false, 1, -128),
+                "font/default8.png", atlas(1, 0xFFFFFFFF), "font/ascii_sga.png", atlas(1, 0xFFFFFFFF)));
+        assertFalse(fonts.resources().containsKey("assets/minecraft/font/default.json"));
+        assertTrue(fonts.resources().containsKey("assets/minecraft/font/alt.json"));
+    }
+
+    private static byte[] metadata(final boolean extended, final Integer height, final Integer offset) {
+        final JsonObject json = new JsonObject();
+        json.addProperty("ascii_extended", extended);
+        if (height != null) {
+            json.addProperty("ascii_character_height", height);
+        }
+        if (offset != null) {
+            json.addProperty("ascii_character_y_offset", offset);
+        }
+        return json.toString().getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static byte[] atlas(final int scale, final int color) throws IOException {
+        final BufferedImage image = new BufferedImage(128 * scale, 128 * scale, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < image.getHeight(); y++) {
+            for (int x = 0; x < image.getWidth(); x++) {
+                image.setRGB(x, y, color);
+            }
+        }
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
+
+    private static JsonArray providers(final Map<String, byte[]> resources) {
+        return JsonParser.parseString(new String(resources.get("assets/minecraft/font/default.json"), StandardCharsets.UTF_8))
+                .getAsJsonObject().getAsJsonArray("providers");
+    }
+
+    private static int codePoint(final JsonArray providers, final int page, final int index) {
+        return providers.get(page).getAsJsonObject().getAsJsonArray("chars").get(index / 16).getAsString().charAt(index % 16);
+    }
+
+    private static BufferedImage image(final Map<String, byte[]> resources, final JsonObject provider) throws IOException {
+        return ImageIO.read(new ByteArrayInputStream(resources.get("assets/viabedrock/textures/"
+                + provider.get("file").getAsString().substring("viabedrock:".length()))));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpressionTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpressionTest.java
