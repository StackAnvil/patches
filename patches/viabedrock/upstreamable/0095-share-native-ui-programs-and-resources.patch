+final class NativeHudMessageTest {
+
+    @Test
+    void preservesRestartAndLifetimeAndRejectsTrailingData() {
+        final var message = new NativeHudMessage(UUID.randomUUID().toString(), true, 100);
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeHudMessage.TYPE.write(buffer, message);
