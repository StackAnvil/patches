+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeNpcDialogueMessageTest {
+
+    @Test
+    void openAndMatchingCloseRoundTripWithExactPayloadBoundaries() throws Exception {
+        final var open = new NativeNpcDialogueMessage("viabedrock:npc/2", "{\"text\":\"Ä\n選択\"}");
+        final var close = new NativeNpcDialogueMessage(open.responseIdentifier(), null);
+        for (final var message : List.of(open, close)) {
+            final var wire = Unpooled.buffer();
+            try {
+                NativeNpcDialogueMessage.TYPE.write(wire, message);
+                assertEquals(message, NativeNpcDialogueMessage.TYPE.read(wire));
+                assertFalse(wire.isReadable());
+                wire.clear();
+                NativeNpcDialogueMessage.TYPE.write(wire, message);
+                wire.writeByte(0);
+                assertThrows(IllegalArgumentException.class, () -> NativeNpcDialogueMessage.TYPE.read(wire));
+            } finally {
+                wire.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsWrongProtocolLengthAndMultibyteOverflow() throws Exception {
+        final var wire = Unpooled.buffer();
+        try {
+            Types.VAR_INT.write(wire, 1);
+            Types.VAR_INT.write(wire, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeNpcDialogueMessage.TYPE.read(wire));
+            wire.clear();
+            Types.VAR_INT.write(wire, 1);
+            Types.VAR_INT.write(wire, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.STRING.write(wire, "viabedrock:npc/1");
+            Types.VAR_INT.write(wire, -2);
+            assertThrows(IllegalArgumentException.class, () -> NativeNpcDialogueMessage.TYPE.read(wire));
+            wire.clear();
+            final var oversized = new NativeNpcDialogueMessage("viabedrock:npc/1", "選".repeat(NativeNpcDialogueMessage.MAX_PAYLOAD_BYTES / 2));
+            assertThrows(IllegalArgumentException.class, () -> NativeNpcDialogueMessage.TYPE.write(wire, oversized));
+            assertEquals(0, wire.writerIndex());
+        } finally {
+            wire.release();
+        }
+    }
+
+}
