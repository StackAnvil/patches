+
+/** Persistent accepted-pack HUD decorations independent of title and actionbar lifetimes. */
+public final class HudRootUi extends HudFactoryUi {
+
+    public HudRootUi() {
+        super("", "", Map.of());
+    }
+
+    @Override
+    public JsonObject resolve(final JsonUiProgram program) {
+        try {
+            final var resolution = program.resolveHudDecorations(this);
+            if (resolution.root() == null || !resolution.missingTemplates().isEmpty()) {
+                return null;
+            }
+            final var scene = new JsonObject();
+            scene.addProperty("format", 1);
+            scene.add("root", resolution.root());
+            return scene.toString().getBytes(StandardCharsets.UTF_8).length <= JsonUiProgram.MAX_PAYLOAD_BYTES ? scene : null;
+        } catch (final RuntimeException unsupported) {
+            return null;
+        }
+    }
+
+}
