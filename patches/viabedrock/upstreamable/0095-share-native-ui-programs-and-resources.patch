+import org.junit.jupiter.api.Test;
+
+final class NativeItemHoverTextTest {
+
+    @Test
+    void retainsNameExistenceAndNativeLoreParagraphStyles() {
+        final var display = new CompoundTag();
+        display.putString("Name", "Title");
+        final var lore = new ListTag<>(StringTag.class);
+        lore.add(new StringTag("Category\nDetails"));
+        lore.add(new StringTag(""));
+        display.put("Lore", lore);
+        final var tag = new CompoundTag();
+        tag.put("display", display);
+        assertEquals(
+                "§o§fTitle§r\n§5§oCategory\nDetails\n§5§o", NativeItemHoverText.custom(false, tag));
+        display.put("Name", new IntTag(1));
+        assertTrue(NativeItemHoverText.custom(false, tag).startsWith("§o§f§r\n"));
+        display.remove("Name");
+        assertNull(NativeItemHoverText.custom(false, tag));
+        assertEquals("", NativeItemHoverText.custom(true, null));
+    }
+
+    @Test
+    void onlyExecutesTheBoundLiteralRawTextBranch() {
+        final var tag = new CompoundTag();
+        final var display = new CompoundTag();
+        display.putString("Name", "Title");
+        final var lore = new ListTag<>(StringTag.class);
+        lore.add(new StringTag("{\"rawtext\":[{\"text\":\"First\"},{\"text\":\" Second\"}]}"));
+        display.put("Lore", lore);
+        tag.put("display", display);
+        assertEquals("§o§fTitle§r\n§5§oFirst Second", NativeItemHoverText.custom(false, tag));
+        lore.set(0, new StringTag("{\"rawtext\":[{\"translate\":\"item.name\"}]}"));
+        assertNull(NativeItemHoverText.custom(false, tag));
+        lore.set(0, new StringTag("{\"rawtext\":false}"));
+        assertNull(NativeItemHoverText.custom(false, tag));
+        display.putString("FilteredName", "Filtered");
+        assertNull(NativeItemHoverText.custom(false, tag));
+    }
+
+}
