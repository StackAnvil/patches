+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.nio.charset.StandardCharsets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** An authored HUD scene and its native lifetime. An empty scene clears its channel. */
+public record NativeHudMessage(String scene, boolean restart, int ticks) {
+
+    public static final String CHANNEL = "viabedrock:native_hud_title";
+    public static final String ROOT_CHANNEL = "viabedrock:native_hud_root_v1";
+    public static final String ACTIONBAR_CHANNEL = "viabedrock:native_hud_actionbar_v2";
+    /** Keep a factory instance until an authored animation destroys its controls. */
+    public static final int ANIMATION_LIFETIME = -1;
+    public static final int MAX_BYTES = 1 << 20;
+    public static final Type<NativeHudMessage> TYPE = new Type<>(NativeHudMessage.class) {
+        @Override
+        public NativeHudMessage read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native HUD message");
+            }
+            final boolean restart = buffer.readBoolean();
+            final int ticks = Types.VAR_INT.readPrimitive(buffer);
+            final int length = Types.VAR_INT.readPrimitive(buffer);
+            if (length < 0 || length > MAX_BYTES || length != buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid native HUD length");
+            }
+            return new NativeHudMessage(buffer.readCharSequence(length, StandardCharsets.UTF_8).toString(), restart, ticks);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeHudMessage value) {
+            final byte[] bytes = value.scene.getBytes(StandardCharsets.UTF_8);
+            if (bytes.length > MAX_BYTES) {
+                throw new IllegalArgumentException("Native HUD exceeds payload limit");
+            }
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeBoolean(value.restart);
+            Types.VAR_INT.writePrimitive(buffer, value.ticks);
+            Types.VAR_INT.writePrimitive(buffer, bytes.length);
+            buffer.writeBytes(bytes);
+        }
+    };
+
+    public NativeHudMessage {
+        if (scene == null || scene.length() > MAX_BYTES || ticks < ANIMATION_LIFETIME || ticks > 216000) {
+            throw new IllegalArgumentException("Invalid native HUD scene");
+        }
+    }
+
+}
