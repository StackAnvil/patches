+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Native container scenes bound to actual Java menu slots, without a second inventory authority. */
+public final class ContainerUi {
+
+    private final JsonUiProgram program;
+    private final Title title;
+    private final boolean nativeActions;
+
+    public ContainerUi(final JsonUiProgram program) {
+        this(program, null, false);
+    }
+
+    private ContainerUi(final JsonUiProgram program, final Title title, final boolean nativeActions) {
+        this.program = program;
+        this.title = title;
+        this.nativeActions = nativeActions;
+    }
+
+    public static ContainerUi fromProgram(final JsonObject program) {
+        final JsonObject globals = program.getAsJsonObject("globals");
+        Title title = null;
+        if (globals != null && globals.has("$container_title") && globals.has("$localize_title")) {
+            final JsonElement raw = globals.get("$container_title");
+            final JsonElement localize = globals.get("$localize_title");
+            if (!raw.isJsonPrimitive() || !raw.getAsJsonPrimitive().isString()
+                    || !localize.isJsonPrimitive() || !localize.getAsJsonPrimitive().isBoolean()) {
+                throw new IllegalArgumentException("Invalid container title variables");
+            }
+            title = new Title(raw.getAsString(), localize.getAsBoolean());
+        }
+        return new ContainerUi(JsonUiProgram.fromProgram(program), title,
+                program.has("native_actions") && program.get("native_actions").getAsBoolean());
+    }
+
+    public JsonObject exportProgram(final Kind kind, final Title title) {
+        return this.exportProgram(kind, title, false);
+    }
+
+    public JsonObject exportProgram(final Kind kind, final Title title, final boolean nativeActions) {
+        if (kind == null || title == null) {
+            return null;
+        }
+        try {
+            final String host = kind.host;
+            final String fallback = kind.panel;
+            final JsonObject exported = this.program.export(Set.of(host, fallback), new JsonPrimitive(title.raw));
+            final JsonObject definitions = exported.getAsJsonObject("definitions");
+            if (!definitions.has(host) || !definitions.has(fallback)) {
+                return null;
+            }
+            exported.addProperty("condition_title", title.raw);
+            if (nativeActions) {
+                exported.addProperty("native_actions", true);
+            }
+            exported.getAsJsonObject("globals").addProperty("$container_title", title.raw);
+            exported.getAsJsonObject("globals").addProperty("$localize_title", title.localize);
+            return exported;
+        } catch (final IllegalArgumentException | IllegalStateException unsupported) {
+            return null;
+        }
+    }
+
+    public JsonObject resolve(final MenuView menu) {
+        try {
+            return this.resolveScene(menu);
+        } catch (final IllegalArgumentException | IllegalStateException unsupported) {
+            return null;
+        }
+    }
+
+    JsonObject resolveScene(final MenuView menu) {
+        final Controller controller = new Controller(menu, this.title == null ? new Title(menu.title, false) : this.title, this.nativeActions);
+        final String host = menu.kind.host;
+        final String fallback = menu.kind.panel;
+        final var resolved = this.program.resolveScreen(host, fallback, controller);
+        if (resolved.root() == null) {
+            return null;
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.addProperty("menu_id", menu.menuId);
+        scene.add("root", resolved.root());
+        final JsonArray missing = new JsonArray();
+        resolved.missingTemplates().forEach(missing::add);
+        scene.add("missing_templates", missing);
+        if (scene.toString().getBytes(StandardCharsets.UTF_8).length > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("Container UI exceeds the payload limit");
+        }
+        return scene;
+    }
+
+    /** Explicit manual scopes can omit slots, but never inherit generic Java inventory shortcuts. */
+    public static ActionScope actionScope(final JsonObject scene, final int containerSize) {
+        if (scene == null || !scene.getAsJsonArray("missing_templates").isEmpty()) {
+            throw new IllegalArgumentException("Incomplete native inventory program");
+        }
+        final Set<Integer> slots = new HashSet<>();
+        final Set<Integer> referenced = new HashSet<>();
+        final boolean[] manual = new boolean[1];
+        collectActions(scene.getAsJsonObject("root"), true, true, false, containerSize, slots, referenced, manual);
+        return new ActionScope(manual[0] && !slots.isEmpty(), Set.copyOf(slots), Set.copyOf(referenced));
+    }
+
+    private static void collectActions(final JsonObject node, final boolean parentVisible, final boolean parentEnabled,
+                                       final boolean parentManual, final int containerSize,
+                                       final Set<Integer> slots, final Set<Integer> referenced, final boolean[] manualSeen) {
+        final boolean visible = parentVisible && stateFlag(node, "visible", true);
+        final boolean enabled = parentEnabled && stateFlag(node, "enabled", true);
+        final boolean manual = parentManual || stateFlag(node, "inventory_manual", false);
+        if (manual && "container_items".equals(JsonUiProgram.string(node, "collection")) && node.has("inventory_slot")) {
+            final int slot = node.get("inventory_slot").getAsBigDecimal().intValueExact();
+            if (slot < 0 || slot >= containerSize) {
+                throw new IllegalArgumentException("Invalid native manual item slot");
+            }
+            referenced.add(slot);
+        }
+        if (!visible) {
+            return;
+        }
+        manualSeen[0] |= manual;
+        if (node.has("inventory_actions") && enabled) {
+            for (final var value : node.getAsJsonArray("inventory_actions")) {
+                final var action = value.getAsJsonObject();
+                final String target = action.get("to_button_id").getAsString();
+                if (!"button.container_auto_place_one".equals(target)) {
+                    if (manual && !"button.container_slot_hovered".equals(target)) {
+                        throw new IllegalArgumentException("Unsupported native manual inventory action");
+                    }
+                    continue;
+                }
+                if (!manual || !"container_items".equals(JsonUiProgram.string(node, "collection"))
+                        || !node.has("inventory_slot") || !"pressed".equals(JsonUiProgram.string(action, "mapping_type"))) {
+                    throw new IllegalArgumentException("Unbound native count-one action scope");
+                }
+                final int slot = node.get("inventory_slot").getAsBigDecimal().intValueExact();
+                if (slot < 0 || slot >= containerSize) {
+                    throw new IllegalArgumentException("Invalid native action slot");
+                }
+                slots.add(slot);
+            }
+        }
+        if (node.has("children")) {
+            for (final var child : node.getAsJsonArray("children")) {
+                collectActions(child.getAsJsonObject(), visible, enabled, manual, containerSize, slots, referenced, manualSeen);
+            }
+        }
+    }
+
+    private static boolean stateFlag(final JsonObject node, final String key, final boolean fallback) {
+        if (!node.has(key)) {
+            return fallback;
+        }
+        final var value = node.get(key);
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isBoolean()) {
+            throw new IllegalArgumentException("Unknown native inventory state " + key);
+        }
+        return value.getAsBoolean();
+    }
+
+    static Map<String, JsonElement> copy(final Map<String, JsonElement> values) {
+        final Map<String, JsonElement> result = new HashMap<>();
+        values.forEach((key, value) -> result.put(key, value.deepCopy()));
+        return Map.copyOf(result);
+    }
+
+    public enum Kind {
+
+        CHEST_3_ROWS(0, 27, "chest.small_chest_screen", "chest.small_chest_panel"),
+        CHEST_6_ROWS(1, 54, "chest.large_chest_screen", "chest.large_chest_panel"),
+        ENDER_CHEST(2, 27, "chest.ender_chest_screen", "chest.ender_chest_panel"),
+        SHULKER_BOX(3, 27, "chest.shulker_box_screen", "chest.shulker_box_panel"),
+        BARREL(4, 27, "chest.barrel_screen", "chest.barrel_panel"),
+        HOPPER(5, 5, "redstone.hopper_screen", "redstone.panel"),
+        DISPENSER(6, 9, "redstone.dispenser_screen", "redstone.panel"),
+        DROPPER(7, 9, "redstone.dropper_screen", "redstone.panel"),
+        BREWING_STAND(8, 5, "brewing_stand.brewing_stand_screen", "brewing_stand.brewing_stand_panel");
+
+        private final int wireId;
+        private final int containerSlots;
+        private final String host;
+        private final String panel;
+
+        Kind(final int wireId, final int containerSlots, final String host, final String panel) {
+            this.wireId = wireId;
+            this.containerSlots = containerSlots;
+            this.host = host;
+            this.panel = panel;
+        }
+
+        public int wireId() {
+            return this.wireId;
+        }
+
+        public int containerSlots() {
+            return this.containerSlots;
+        }
+
+        public boolean legacy() {
+            return this == CHEST_3_ROWS || this == CHEST_6_ROWS;
+        }
+
+        public int minimumFormat() {
+            return this == BREWING_STAND ? 4 : this.legacy() ? 1 : 3;
+        }
+
+        public List<Integer> initialData() {
+            return this == BREWING_STAND ? List.of(0, 0, 0) : List.of();
+        }
+
+        public void validateData(final List<Integer> data) {
+            if (data == null || data.size() != this.initialData().size()) {
+                throw new IllegalArgumentException("Invalid native container data shape");
+            }
+        }
+
+        public static Kind fromWireId(final int wireId) {
+            for (final Kind kind : values()) {
+                if (kind.wireId == wireId) {
+                    return kind;
+                }
+            }
+            throw new IllegalArgumentException("Unsupported native container family");
+        }
+    }
+
+    /** Raw authored title conditions and independent native label localization. */
+    public record Title(String raw, boolean localize) {
+
+        public Title {
+            if (raw == null || raw.length() > 8192) {
+                throw new IllegalArgumentException("Invalid container title");
+            }
+        }
+    }
+
+    public record ActionScope(boolean subset, Set<Integer> slots, Set<Integer> referencedSlots) { }
+
+    public record Slot(int javaSlot, Map<String, JsonElement> presentation) {
+
+        public Slot {
+            if (javaSlot < 0 || javaSlot > Short.MAX_VALUE) {
+                throw new IllegalArgumentException("Invalid Java menu slot");
+            }
+            presentation = copy(presentation);
+        }
+    }
+
+    public record MenuView(int menuId, Kind kind, String title, List<Slot> slots, Map<String, JsonElement> cursor,
+                           List<Integer> data) {
+
+        public MenuView {
+            if (menuId < 0 || kind == null || title == null || title.length() > 8192) {
+                throw new IllegalArgumentException("Invalid Java menu identity");
+            }
+            slots = List.copyOf(slots);
+            cursor = copy(cursor);
+            data = List.copyOf(data);
+            kind.validateData(data);
+            final Set<Integer> ids = new HashSet<>();
+            for (final Slot slot : slots) {
+                if (!ids.add(slot.javaSlot)) {
+                    throw new IllegalArgumentException("Duplicate Java menu slot");
+                }
+            }
+            if (ids.size() != kind.containerSlots + 36) {
+                throw new IllegalArgumentException("Incomplete Java container menu");
+            }
+            for (int index = 0; index < ids.size(); index++) {
+                if (!ids.contains(index)) {
+                    throw new IllegalArgumentException("Missing Java container slot " + index);
+                }
+            }
+        }
+    }
+
+    static class Controller implements UiBindings {
+
+        private static final Set<String> ACTIONS = Set.of("button.container_take_all_place_all", "button.container_take_half_place_one",
+                "button.container_auto_place", "button.drop_one", "button.drop_all", "button.coalesce_stack", "button.shape_drawing",
+                "button.container_slot_hovered");
+        private final boolean nativeActions;
+        protected final Map<String, Collection> collections = new HashMap<>();
+        protected final Map<String, JsonElement> globals = new HashMap<>();
+
+        private final Set<String> singletonCollections = new HashSet<>();
+        private final Map<Integer, Slot> slots = new HashMap<>();
+
+        private Controller(final MenuView menu, final Title title, final boolean nativeActions) {
+            this(menu.kind.containerSlots, menu.slots, menu.cursor, title, nativeActions);
+            if (menu.kind == Kind.BREWING_STAND) {
+                this.collections.put("brewing_result_items", collection(this.slots, 0, 3));
+                this.registerSingleton("brewing_input_item", 3, "");
+                this.registerSingleton("brewing_fuel_item", 4, "#empty_fuel_image_visible");
+                this.globals.putAll(BrewingStandUi.bindings(menu.data));
+            }
+        }
+
+        Controller(final int containerSize, final List<Slot> menuSlots, final Map<String, JsonElement> cursor,
+                   final Title title, final boolean nativeActions) {
+            this.nativeActions = nativeActions;
+            menuSlots.forEach(slot -> this.slots.put(slot.javaSlot, slot));
+            this.collections.put("container_items", collection(this.slots, 0, containerSize));
+            this.collections.put("inventory_items", collection(this.slots, containerSize, 27));
+            this.collections.put("hotbar_items", collection(this.slots, containerSize + 27, 9));
+            this.globals.put("$container_title", new JsonPrimitive(title.raw));
+            this.globals.put("$localize_title", new JsonPrimitive(title.localize));
+            this.globals.put("$thistext", new JsonPrimitive(title.raw));
+            this.globals.put("$desktop_screen", new JsonPrimitive(true));
+            this.globals.put("$pocket_screen", new JsonPrimitive(false));
+            this.globals.put("#is_using_gamepad", new JsonPrimitive(false));
+            this.globals.put("#is_using_touch", new JsonPrimitive(false));
+            this.globals.putAll(cursor);
+            final JsonObject cursorReference = new JsonObject();
+            cursorReference.addProperty("cursor", true);
+            this.globals.put("#inventory_selected_item", cursorReference);
+        }
+
+        protected final void registerSingleton(final String name, final int slot, final String emptyBinding) {
+            this.collections.put(name, singleton(this.slots, slot, emptyBinding));
+            this.singletonCollections.add(name);
+        }
+
+        static Collection collection(final Map<Integer, Slot> slots, final int first, final int size) {
+            final List<Map<String, JsonElement>> entries = new ArrayList<>();
+            for (int index = 0; index < size; index++) {
+                final Slot slot = slots.get(first + index);
+                final Map<String, JsonElement> values = new HashMap<>(slot.presentation);
+                final JsonObject reference = new JsonObject();
+                reference.addProperty("java_slot", slot.javaSlot);
+                values.put("#item_renderer_data", reference);
+                values.put("#collection_index", new JsonPrimitive(index));
+                entries.add(values);
+            }
+            return new Collection(entries, Map.of("#collection_total_items", new JsonPrimitive(size)));
+        }
+
+        private static Collection singleton(final Map<Integer, Slot> slots, final int slot, final String emptyBinding) {
+            final var collection = collection(slots, slot, 1);
+            final var details = new HashMap<>(collection.details());
+            details.putAll(collection.entries().getFirst());
+            if (!emptyBinding.isEmpty()) {
+                final var count = details.get("#inventory_stack_count");
+                if (count == null || !count.isJsonPrimitive() || !count.getAsJsonPrimitive().isNumber()) {
+                    throw new IllegalArgumentException("Brewing slot count is unavailable");
+                }
+                details.put(emptyBinding, new JsonPrimitive(count.getAsInt() == 0));
+            }
+            return new Collection(collection.entries(), details);
+        }
+
+        @Override
+        public Map<String, JsonElement> globals() {
+            return this.globals;
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "container_items";
+        }
+
+        @Override
+        public boolean ownsCollection(final String name) {
+            return this.collections.containsKey(name) || Set.of("form_buttons", "custom_form").contains(name);
+        }
+
+        @Override
+        public Collection collection(final String name, final Scope parent) {
+            // Shared button templates retain form bindings in inventory screens.
+            // No form controller supplies rows in this session.
+            if (Set.of("form_buttons", "custom_form").contains(name)) {
+                return new Collection(List.of(), Map.of());
+            }
+            final Collection result = this.collections.get(name);
+            if (result == null) {
+                throw new IllegalArgumentException("Unsupported inventory collection " + name);
+            }
+            return result;
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            return scope == null ? Map.of() : this.collection(scope.collection(), scope.parent()).entries().get(scope.index());
+        }
+
+        @Override
+        public Map<String, JsonElement> bindings(final Scope scope) {
+            final Map<String, JsonElement> values = new HashMap<>(this.globals);
+            values.putAll(this.variables(scope));
+            if (scope != null && Set.of("brewing_result_items", "brewing_fuel_item").contains(scope.collection())) {
+                final JsonElement count = values.get("#inventory_stack_count");
+                if (count == null || !count.isJsonPrimitive() || !count.getAsJsonPrimitive().isNumber()) {
+                    throw new IllegalArgumentException("Brewing slot count is unavailable");
+                }
+                values.put(scope.collection().equals("brewing_result_items")
+                        ? "#empty_bottle_image_visible" : "#empty_fuel_image_visible", new JsonPrimitive(count.getAsInt() == 0));
+            }
+            return values;
+        }
+
+        @Override
+        public String factoryKey() {
+            return "";
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            if (this.nativeActions && "grid".equals(JsonUiProgram.string(node, "type"))
+                    && node.has("collection_name") && !node.has("grid_item_template")) {
+                node.addProperty("inventory_manual", true);
+            }
+            if (scope != null) {
+                node.addProperty("collection", scope.collection());
+                node.addProperty("collection_index", scope.index());
+                if (this.variables(scope).get("#item_renderer_data") instanceof JsonObject reference && reference.has("java_slot")) {
+                    node.addProperty("inventory_slot", reference.get("java_slot").getAsInt());
+                }
+            } else if (this.singletonCollections.contains(UiExpression.text(resolved.get("$item_collection_name")))) {
+                final String collection = UiExpression.text(resolved.get("$item_collection_name"));
+                final var reference = this.collections.get(collection).details().get("#item_renderer_data").getAsJsonObject();
+                node.addProperty("inventory_slot", reference.get("java_slot").getAsInt());
+                node.addProperty("collection", collection);
+                node.addProperty("collection_index", 0);
+            } else if ("inventory_item_renderer".equals(JsonUiProgram.string(node, "renderer"))
+                    && resolved.get("#item_id_aux") instanceof JsonObject reference && reference.has("cursor")) {
+                node.addProperty("inventory_cursor", true);
+            }
+            if ("label".equals(JsonUiProgram.string(node, "type"))) {
+                final String countSource = countSource(control, resolved);
+                if (node.has("inventory_slot") && "#inventory_stack_count".equals(countSource)) {
+                    node.addProperty("inventory_count", "slot");
+                } else if ("#inventory_selected_item_stack_count".equals(countSource)) {
+                    node.addProperty("inventory_count", "cursor");
+                }
+            }
+            if (!node.has("button_mappings") || !node.get("button_mappings").isJsonArray()) {
+                return;
+            }
+            final JsonArray actions = new JsonArray();
+            for (final JsonElement element : node.getAsJsonArray("button_mappings")) {
+                final JsonObject mapping = element.getAsJsonObject();
+                for (final String field : List.of("from_button_id", "to_button_id", "mapping_type")) {
+                    if (mapping.has(field)) {
+                        mapping.addProperty(field, UiExpression.text(JsonUiProgram.resolveValue(mapping.get(field), resolved, 0)));
+                    }
+                }
+                final boolean ignored = UiExpression.truth(JsonUiProgram.resolveValue(mapping.get("ignored"), resolved, 0));
+                if (mapping.has("ignored")) {
+                    mapping.addProperty("ignored", ignored);
+                }
+                if (ignored) {
+                    continue;
+                }
+                final String action = JsonUiProgram.string(mapping, "to_button_id");
+                if (node.has("inventory_slot") && (ACTIONS.contains(action)
+                        || this.nativeActions && "button.container_auto_place_one".equals(action))) {
+                    final JsonObject translated = mapping.deepCopy();
+                    translated.addProperty("to_button_id", action);
+                    actions.add(translated);
+                } else if (Set.of("button.menu_exit", "button.try_menu_exit").contains(action)) {
+                    node.addProperty("inventory_command", "close");
+                }
+            }
+            if (!actions.isEmpty()) {
+                node.add("inventory_actions", actions);
+            }
+        }
+
+        private static String countSource(final JsonObject control, final Map<String, JsonElement> values) {
+            String source = JsonUiProgram.bindingName(control, "text", values);
+            final JsonElement bindings = control.has("bindings") && control.get("bindings").isJsonArray()
+                    ? control.get("bindings") : JsonUiProgram.resolveValue(control.get("bindings"), values, 0);
+            if (!bindings.isJsonArray()) {
+                return source;
+            }
+            for (final JsonElement element : bindings.getAsJsonArray()) {
+                final JsonObject binding = element.getAsJsonObject();
+                if ("none".equals(JsonUiProgram.bindingName(binding, "binding_type", values))
+                        || UiExpression.truth(JsonUiProgram.resolveValue(binding.get("ignored"), values, 0))) {
+                    continue;
+                }
+                final String expression = JsonUiProgram.bindingName(binding,
+                        binding.has("source_property_name") ? "source_property_name" : "binding_name", values);
+                final String target = binding.has("target_property_name") ? JsonUiProgram.bindingName(binding, "target_property_name", values)
+                        : binding.has("binding_name_override") ? JsonUiProgram.bindingName(binding, "binding_name_override", values) : expression;
+                if ("#text".equals(target)) {
+                    source = JsonUiProgram.bindingName(binding, "source_control_name", values).isEmpty() ? expression : "";
+                }
+            }
+            return source;
+        }
+    }
+
+}
