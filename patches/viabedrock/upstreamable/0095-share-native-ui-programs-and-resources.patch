+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Progress changes do not retire item authority or restart the cooking activation handshake. */
+public record NativeCookingProgress(int menuId, long sequence, long updateSequence, long dataRevision, CookingUi.Progress progress) {
+
+    public static final String CHANNEL = "viabedrock:native_cooking_progress";
+    public static final Type<NativeCookingProgress> TYPE = new Type<>(NativeCookingProgress.class) {
+        @Override
+        public NativeCookingProgress read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > 80 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native cooking progress");
+            }
+            final var result = new NativeCookingProgress(Types.VAR_INT.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    new CookingUi.Progress(buffer.readInt(), buffer.readInt(), buffer.readInt(), buffer.readInt()));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native cooking progress fields");
+            }
+            return result;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCookingProgress value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.menuId);
+            Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+            Types.VAR_LONG.writePrimitive(buffer, value.updateSequence);
+            Types.VAR_LONG.writePrimitive(buffer, value.dataRevision);
+            buffer.writeInt(value.progress.cooking());
+            buffer.writeInt(value.progress.burning());
+            buffer.writeInt(value.progress.burnDuration());
+            buffer.writeInt(value.progress.storedExperience());
+        }
+    };
+
+    public NativeCookingProgress {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || updateSequence <= 0 || dataRevision < 0 || progress == null) {
+            throw new IllegalArgumentException("Invalid native cooking progress identity");
+        }
+    }
+
+}
