+
+    @Test
+    void resolvedMappingsPreserveCloseInputAndIgnoredUnknownActionsAcrossExports() {
+        final String definitions = UI.replace("\"close\":{\"type\":\"button\",\"button_mappings\":[{\"to_button_id\":\"button.menu_exit\"}]}", """
+                "close":{"type":"button","$pressed_button_name":"button.menu_exit",
+                  "$source":"button.menu_select","$mapping":"pressed","$ignored":true,
+                  "button_mappings":[{"from_button_id":"$source","to_button_id":"$pressed_button_name","mapping_type":"$mapping"},
+                    {"to_button_id":"button.unsupported","ignored":"$ignored"}]}
+                """.strip());
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", definitions.getBytes(StandardCharsets.UTF_8)))));
+        for (final var kind : List.of(ContainerUi.Kind.CHEST_3_ROWS, ContainerUi.Kind.CHEST_6_ROWS)) {
+            final var view = menu(kind, "Actual", 1);
+            final var scene = ui.resolve(view);
+            assertNotNull(scene);
+            final var close = nodes(scene.getAsJsonObject("root")).stream()
+                    .filter(node -> "close".equals(JsonUiProgram.string(node, "name"))).findFirst().orElseThrow();
+            assertEquals("close", close.get("inventory_command").getAsString());
+            final var mapping = close.getAsJsonArray("button_mappings").get(0).getAsJsonObject();
+            assertEquals("button.menu_select", mapping.get("from_button_id").getAsString());
