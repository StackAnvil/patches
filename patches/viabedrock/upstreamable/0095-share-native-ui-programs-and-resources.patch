+        private JsonObject expandChild(final String reference, final JsonObject overrides,
+                                       final Map<String, JsonElement> inherited, final UiBindings.Scope scope, final ManualGrid parentGrid, final int depth) {
+            try {
+                return this.expand(reference, overrides, inherited, scope, parentGrid, depth);
+            } catch (final MissingControlException missing) {
+                // The native factory logs a missing base and returns an empty child, retaining its siblings.
+                this.missingTemplates.add(missing.getMessage());
+                return null;
+            }
+        }
