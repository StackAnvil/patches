 class WorldPacketsTest {
 
+    @Test
+    void treatsNativeSubChunkLimitsAsCountsAndPreservesUnlimitedDimensions() {
+        // Target 1.26.51.1 columns at four heights advertise these counts and
+        // the native client requests exactly this many sections, not count + 1.
+        for (final int limit : new int[]{1, 2, 5, 9}) {
+            assertEquals(limit, WorldPackets.requestSectionCount(limit, 24));
+        }
+        assertEquals(0, WorldPackets.requestSectionCount(0, 24));
+        assertEquals(24, WorldPackets.requestSectionCount(-1, 24));
+        assertEquals(24, WorldPackets.requestSectionCount(64, 24));
+        assertEquals(16, WorldPackets.requestSectionCount(-1, 16));
+    }
