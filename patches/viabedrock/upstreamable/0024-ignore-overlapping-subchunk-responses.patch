+        }
+        if (!mergeSectionIfPending(section, this.handleBlockPalette(other), this.bedrockAirId())) {
+            return false;
+        }
         this.invalidateJavaBlockStates(chunkX, subChunkY, chunkZ);
         blockEntities.forEach(blockEntity -> chunk.removeBlockEntityAt(blockEntity.position()));
         chunk.blockEntities().addAll(blockEntities);
         return true;
     }
 
+    static boolean mergeSectionIfPending(final BedrockChunkSection section,
+                                         final BedrockChunkSection other, final int airId) {
+        if (!section.hasPendingBlockUpdates()) {
+            return false;
+        }
+        section.mergeWith(other);
+        section.applyPendingBlockUpdates(airId);
+        return true;
+    }
