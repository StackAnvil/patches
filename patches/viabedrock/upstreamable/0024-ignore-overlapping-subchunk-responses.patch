+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.chunks.PaletteType;
+import net.raphimc.viabedrock.api.chunk.datapalette.BedrockDataPalette;
+import net.raphimc.viabedrock.api.chunk.section.BedrockChunkSectionImpl;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ChunkTrackerTest {
+
+    @Test
+    void ignoresRepeatedSubChunkAfterApplyingPendingUpdates() {
+        final BedrockChunkSectionImpl section = new BedrockChunkSectionImpl();
+        section.addPendingBlockUpdate(0, 0, 0, 0, 3);
+
+        assertTrue(ChunkTracker.mergeSectionIfPending(section, sectionWithBlock(1), 0));
+        assertEquals(3, section.palette(PaletteType.BLOCKS).idAt(0));
+
+        assertFalse(ChunkTracker.mergeSectionIfPending(section, sectionWithBlock(2), 0));
+        assertEquals(3, section.palette(PaletteType.BLOCKS).idAt(0));
+    }
+
+    private static BedrockChunkSectionImpl sectionWithBlock(final int blockId) {
+        final BedrockChunkSectionImpl section = new BedrockChunkSectionImpl();
+        final BedrockDataPalette palette = new BedrockDataPalette();
+        palette.addId(blockId);
+        section.addPalette(PaletteType.BLOCKS, palette);
+        return section;
+    }
+
+}
