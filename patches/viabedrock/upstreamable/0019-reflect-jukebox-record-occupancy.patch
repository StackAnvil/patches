+    static int jukeboxSongId(final CompoundTag registry, final String song) {
+        if (registry == null) {
+            return -1;
+        }
+        final String key = Key.namespaced(song);
+        int id = 0;
+        for (String registeredSong : registry.keySet()) {
+            if (registeredSong.equals(key)) {
+                return id;
+            }
+            id++;
+        }
+        return -1;
+    }
+
+    static void writeJukeboxEvent(final PacketWrapper wrapper, final BlockPosition position, final int event, final int songId) {
+        wrapper.write(Types.INT, event);
+        wrapper.write(Types.BLOCK_POSITION1_14, position);
+        wrapper.write(Types.INT, songId);
+        wrapper.write(Types.BOOLEAN, false);
+    }
+
+    static void stopJukeboxSong(final UserConnection user, final BlockPosition position) {
+        final PacketWrapper wrapper = PacketWrapper.create(ClientboundPackets26_3.LEVEL_EVENT, user);
+        writeJukeboxEvent(wrapper, position, net.raphimc.viabedrock.protocol.data.enums.java.LevelEvent.SOUND_STOP_JUKEBOX_SONG.getValue(), 0);
+        wrapper.scheduleSend(BedrockProtocol.class);
+    }
+
