+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WorldEffectPacketsTest {
+
+    @Test
+    void resolvesJukeboxSongsInTheSentRegistryOrder() {
+        final CompoundTag registry = new CompoundTag();
+        registry.put("minecraft:cat", new CompoundTag());
+        registry.put("minecraft:far", new CompoundTag());
+
+        assertEquals(0, WorldEffectPackets.jukeboxSongId(registry, "cat"));
+        assertEquals(1, WorldEffectPackets.jukeboxSongId(registry, "far"));
+        assertEquals(-1, WorldEffectPackets.jukeboxSongId(registry, "missing"));
+    }
+
+    @Test
+    void writesPositionedJukeboxEventForJavaPlayback() throws Exception {
+        final var wrapper = new PacketWrapperImpl(ClientboundPackets26_3.LEVEL_EVENT, null, null);
+        final BlockPosition position = new BlockPosition(10, 64, -5);
+        WorldEffectPackets.writeJukeboxEvent(wrapper, position, 1010, 7);
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.LEVEL_EVENT.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(1010, Types.INT.read(buffer));
+            assertEquals(position, Types.BLOCK_POSITION1_14.read(buffer));
+            assertEquals(7, Types.INT.read(buffer));
+            assertEquals(false, Types.BOOLEAN.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
