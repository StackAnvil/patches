From 0c94a3fd7bb52e1e08aa65befc447fc0e655789e Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 20:13:41 +0200
Subject: [PATCH] fix(world): reflect jukebox record occupancy

Bedrock stores the inserted disc in its block entity, while the mapped Java jukebox state always reports has_record=false. Send the occupied Java state when a valid record item is present so the client sees the server jukebox state during chunk load and later block entity updates.
---
 .../blockentity/JukeboxBlockEntityRewriter.java      | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/JukeboxBlockEntityRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/JukeboxBlockEntityRewriter.java
index 841a266c..f0159ea4 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/JukeboxBlockEntityRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/blockentity/JukeboxBlockEntityRewriter.java
@@ -22,10 +22,18 @@ import com.viaversion.viaversion.api.connection.UserConnection;
 import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
 import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntityImpl;
 import net.raphimc.viabedrock.api.chunk.BedrockBlockEntity;
+import net.raphimc.viabedrock.api.chunk.BlockEntityWithBlockState;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
 import net.raphimc.viabedrock.protocol.rewriter.BlockEntityRewriter;
 
+import java.util.Map;
+
 public class JukeboxBlockEntityRewriter implements BlockEntityRewriter.Rewriter {
 
+    private static final int EMPTY_BLOCK_STATE = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(new BlockState("jukebox", Map.of("has_record", "false")));
+    private static final int OCCUPIED_BLOCK_STATE = BedrockProtocol.MAPPINGS.getJavaBlockStates().get(new BlockState("jukebox", Map.of("has_record", "true")));
+
     @Override
     public BlockEntity toJava(final UserConnection user, final BedrockBlockEntity bedrockBlockEntity) {
         final CompoundTag bedrockTag = bedrockBlockEntity.tag();
@@ -33,7 +41,9 @@ public class JukeboxBlockEntityRewriter implements BlockEntityRewriter.Rewriter
 
         this.copyItem(user, bedrockTag, javaTag, "RecordItem");
 
-        return new BlockEntityImpl(bedrockBlockEntity.packedXZ(), bedrockBlockEntity.y(), -1, javaTag);
+        final boolean hasRecord = javaTag.get("RecordItem") instanceof CompoundTag;
+        final BlockEntity javaBlockEntity = new BlockEntityImpl(bedrockBlockEntity.packedXZ(), bedrockBlockEntity.y(), -1, javaTag);
+        return new BlockEntityWithBlockState(javaBlockEntity, hasRecord ? OCCUPIED_BLOCK_STATE : EMPTY_BLOCK_STATE);
     }
 
 }
