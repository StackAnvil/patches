+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class WrittenBookUsePacketTest {
+
+    @ParameterizedTest
+    @ValueSource(ints = {0, 2, 8})
+    void signedBookUseOpensTheJavaReadingScreenWithoutInventoryMutation(final int slot) throws Exception {
+        final UserConnection user = mock(UserConnection.class);
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        when(user.get(any())).thenAnswer(call -> stores.get(call.getArgument(0)));
+        final InventoryTracker inventory = mock(InventoryTracker.class);
+        final InventoryContainer container = mock(InventoryContainer.class);
+        final BedrockItem held = new BedrockItem(522);
+        held.setAmount(1);
+        when(inventory.getInventoryContainer()).thenReturn(container);
+        when(container.getSelectedHotbarSlot()).thenReturn((byte) slot);
+        when(container.getSelectedHotbarItem()).thenReturn(held);
+        stores.put(InventoryTracker.class, inventory);
+        stores.put(EntityTracker.class, mock(EntityTracker.class));
+        stores.put(InventoryTransactionRewriter.class, mock(InventoryTransactionRewriter.class));
+        final ItemRewriter items = mock(ItemRewriter.class);
+        final var identifiers = HashBiMap.<String, Integer>create();
+        identifiers.put("minecraft:written_book", held.identifier());
+        when(items.getItems()).thenReturn(identifiers);
+        stores.put(ItemRewriter.class, items);
+        final var sent = new AtomicInteger();
+        try (var wrappers = mockStatic(PacketWrapper.class)) {
+            wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.OPEN_BOOK, user)).thenAnswer(call -> {
+                final var open = spy(new PacketWrapperImpl(ClientboundPackets26_3.OPEN_BOOK, null, user));
+                doAnswer(send -> {
+                    final var output = Unpooled.buffer();
+                    try {
+                        open.writeToBuffer(output);
+                        assertEquals(ClientboundPackets26_3.OPEN_BOOK.getId(), Types.VAR_INT.readPrimitive(output));
+                        assertEquals(0, Types.VAR_INT.readPrimitive(output));
+                        assertFalse(output.isReadable());
+                        sent.incrementAndGet();
+                    } finally {
+                        output.release();
+                    }
+                    return null;
+                }).when(open).send(BedrockProtocol.class);
+                return open;
+            });
+            final var input = Unpooled.buffer();
+            try {
+                Types.VAR_INT.writePrimitive(input, 0);
+                Types.VAR_INT.writePrimitive(input, 7);
+                input.writeFloat(45F);
+                input.writeFloat(-30F);
+                final var use = new PacketWrapperImpl(ServerboundPackets26_3.USE_ITEM, input, user);
+                final var protocol = new TestProtocol();
+                protocol.translate(use);
+                assertTrue(use.isCancelled());
+                assertFalse(input.isReadable());
+                assertEquals(1, sent.get());
+                assertEquals(1, held.amount());
+                verifyNoInteractions(stores.get(InventoryTransactionRewriter.class));
+            } finally {
+                input.release();
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            InteractionPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+    }
+
+}
