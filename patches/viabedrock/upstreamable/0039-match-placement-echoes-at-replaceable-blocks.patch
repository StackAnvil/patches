From a9b588bff43bb78b16bf6ce7e556083fc3b2d787 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:43:13 +0200
Subject: [PATCH] fix(sound): match placement echoes at replaceable blocks

Java BlockPlaceContext can replace the clicked block or place in the adjacent block. A placement sound may therefore refer to either position, while ViaBedrock only knows the clicked face at request time. Match both positions in one pending event and consume at most one echo, keeping unrelated placements audible.
---
 .../protocol/packet/InteractionPackets.java   |  2 +-
 .../storage/BlockInteractionSoundTracker.java | 23 +++++++++++--------
 .../BlockInteractionSoundTrackerTest.java     |  6 ++++-
 3 files changed, 20 insertions(+), 11 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
index c1fbdad3..6d67c299 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
@@ -319,7 +319,7 @@ public final class InteractionPackets {
                     ? inventoryTracker.getInventoryContainer().getSelectedHotbarItem()
                     : inventoryTracker.getOffhandContainer().getItem(0);
             if (usedItem.blockRuntimeId() != 0) {
-                wrapper.user().get(BlockInteractionSoundTracker.class).recordPlacement(placedPosition);
+                wrapper.user().get(BlockInteractionSoundTracker.class).recordPlacement(position, placedPosition);
             }
             chunkTracker.trackBlockPrediction(sequence, position, placedPosition);
             sendUseItemOnBlock(wrapper.user(), hand, position, faceInt, clickPosition, insideBlock);
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
index 9a8bbbd1..19ff745b 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
@@ -57,20 +57,20 @@ public final class BlockInteractionSoundTracker implements StorableObject {
         }
 
         final int lowerY = state.hasProperty("half", "upper") ? position.y() - 1 : position.y();
-        this.record(new BlockPosition(position.x(), lowerY, position.z()), event);
+        this.record(new BlockPosition(position.x(), lowerY, position.z()), null, event);
     }
 
-    public void recordPlacement(final BlockPosition position) {
-        this.record(position, "place");
+    public void recordPlacement(final BlockPosition clickedPosition, final BlockPosition placedPosition) {
+        this.record(placedPosition, clickedPosition.equals(placedPosition) ? null : clickedPosition, "place");
     }
 
-    private void record(final BlockPosition position, final String event) {
+    private void record(final BlockPosition position, final BlockPosition alternatePosition, final String event) {
         final long now = this.clock.getAsLong();
         this.removeExpired(now);
         if (this.pending.size() == MAX_PENDING) {
             this.pending.removeFirst();
         }
-        this.pending.addLast(new PendingSound(position.x(), position.y(), position.z(), event, now));
+        this.pending.addLast(new PendingSound(position, alternatePosition, event, now));
     }
 
     private static String toggledEvent(final String prefix, final BlockState state) {
@@ -87,9 +87,8 @@ public final class BlockInteractionSoundTracker implements StorableObject {
         this.removeExpired(this.clock.getAsLong());
         for (final Iterator<PendingSound> iterator = this.pending.iterator(); iterator.hasNext(); ) {
             final PendingSound sound = iterator.next();
-            if (sound.event().equals(event) && Math.abs(position.x() - (sound.x() + 0.5F)) <= 0.75F
-                    && Math.abs(position.y() - (sound.y() + 0.5F)) <= 1.25F
-                    && Math.abs(position.z() - (sound.z() + 0.5F)) <= 0.75F) {
+            if (sound.event().equals(event) && (matches(position, sound.position())
+                    || sound.alternatePosition() != null && matches(position, sound.alternatePosition()))) {
                 iterator.remove();
                 return true;
             }
@@ -97,13 +96,19 @@ public final class BlockInteractionSoundTracker implements StorableObject {
         return false;
     }
 
+    private static boolean matches(final Position3f soundPosition, final BlockPosition blockPosition) {
+        return Math.abs(soundPosition.x() - (blockPosition.x() + 0.5F)) <= 0.75F
+                && Math.abs(soundPosition.y() - (blockPosition.y() + 0.5F)) <= 1.25F
+                && Math.abs(soundPosition.z() - (blockPosition.z() + 0.5F)) <= 0.75F;
+    }
+
     private void removeExpired(final long now) {
         while (!this.pending.isEmpty() && now - this.pending.peekFirst().createdAt() > MAX_AGE_NANOS) {
             this.pending.removeFirst();
         }
     }
 
-    private record PendingSound(int x, int y, int z, String event, long createdAt) {
+    private record PendingSound(BlockPosition position, BlockPosition alternatePosition, String event, long createdAt) {
     }
 
 }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
index ca342e54..77d5df1b 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
@@ -72,12 +72,16 @@ class BlockInteractionSoundTrackerTest {
     void consumesOnlyTheLocalPlacementEchoAtThePlacedBlock() {
         final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
         final BlockPosition placed = new BlockPosition(10, 64, 20);
-        tracker.recordPlacement(placed);
+        tracker.recordPlacement(new BlockPosition(10, 64, 19), placed);
 
         assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(11.5F, 64.5F, 20.5F)));
         assertFalse(tracker.consumeLocallyPlayed("break", new Position3f(10.5F, 64.5F, 20.5F)));
         assertTrue(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
         assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+
+        tracker.recordPlacement(new BlockPosition(10, 64, 19), placed);
+        assertTrue(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 19.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
     }
 
 }
