+    private static final class Context {
+        private final UserConnection user = mock(UserConnection.class);
+        private final EntityTracker tracker = mock(EntityTracker.class);
+        private final TestProtocol protocol = new TestProtocol();
+
+        private Context() {
+            when(this.user.get(EntityTracker.class)).thenReturn(this.tracker);
+        }
+
+        private ClientPlayerEntity local(final Position3f position) {
+            final var player = mock(ClientPlayerEntity.class, CALLS_REAL_METHODS);
+            when(player.position()).thenReturn(position);
+            when(player.rotation()).thenReturn(Position3f.ZERO);
+            when(this.tracker.getClientPlayer()).thenReturn(player);
+            when(this.tracker.getEntityByRid(RUNTIME_ID)).thenReturn(player);
