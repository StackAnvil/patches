@@ -192,9 +225,21 @@ public class Entity {
     }
 
     public void setRotation(final Position3f rotation) {
+        if (this.lastReceivedRotation == null) {
+            this.lastReceivedRotation = new Position3f(receivedAngle(rotation.x()), receivedAngle(rotation.y()), receivedAngle(rotation.z()));
+        }
         this.rotation = rotation;
     }
 
+    private static float receivedAngle(final float angle) {
+        float wrapped = (angle + 180F) % 360F;
+        if (wrapped < 0F) {
+            wrapped += 360F;
+        }
+        // The native spawn cache packs normalized angles with division before multiplication.
+        return MathUtil.byte2Float((byte) ((wrapped - 180F) / 360F * 256F));
+    }
+
     public boolean isOnGround() {
         return this.onGround;
     }
