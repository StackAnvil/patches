+package net.raphimc.viabedrock.protocol.packet;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class EntityMovementPacketsTest {
+
+    @Test
+    void partialPositionUpdateKeepsOmittedCoordinates() {
+        final Position3f current = new Position3f(12F, 34F, 56F);
+
+        assertEquals(new Position3f(12F, 35F, 56F),
+                EntityPackets.mergePosition(current, false, 0F, true, 35F, false, 0F));
+        assertEquals(new Position3f(13F, 34F, 57F),
+                EntityPackets.mergePosition(current, true, 13F, false, 0F, true, 57F));
+        assertEquals(current, EntityPackets.mergePosition(current, false, 0F, false, 0F, false, 0F));
+    }
+
+}
