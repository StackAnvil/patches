+        private Translation absolute() throws Exception {
+            return this.absolute((short) 0);
+        }
+
+        private Translation absolute(final short flags) throws Exception {
+            return this.translate(ClientboundBedrockPackets.MOVE_ENTITY_ABSOLUTE, input -> {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(input, RUNTIME_ID);
+                Types.UNSIGNED_BYTE.write(input, flags);
+                BedrockTypes.POSITION_3F.write(input, NETWORK_POSITION);
+                for (int angle : new int[]{12, 200, 254}) {
+                    Types.BYTE.write(input, (byte) angle);
+                }
+            });
+        }
+
+        private Translation delta(final int mask, final boolean onGround) throws Exception {
+            return this.delta(mask, onGround, false, 0x100000005L);
+        }
+
+        private Translation delta(final int mask, final boolean onGround, final boolean forceCompletion, final long interpolationTicks) throws Exception {
+            return this.translate(ClientboundBedrockPackets.MOVE_ENTITY_DELTA, input -> {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(input, RUNTIME_ID);
+                final float[] positions = {-1.25F, -2.5F, -3.75F};
+                final int[] angles = {240, 30, 45};
+                for (int axis = 0; axis < 3; axis++) {
+                    final boolean supplied = (mask & 1 << axis) != 0;
+                    Types.BOOLEAN.write(input, supplied);
+                    if (supplied) {
+                        BedrockTypes.FLOAT_LE.write(input, positions[axis]);
+                    }
+                }
+                for (int axis = 0; axis < 3; axis++) {
+                    final boolean supplied = (mask & 1 << axis + 3) != 0;
+                    Types.BOOLEAN.write(input, supplied);
+                    if (supplied) {
+                        Types.BYTE.write(input, (byte) angles[axis]);
+                    }
+                }
+                Types.BOOLEAN.write(input, onGround);
+                Types.BOOLEAN.write(input, false);
+                Types.BOOLEAN.write(input, false);
+                Types.BOOLEAN.write(input, forceCompletion);
+                BedrockTypes.UNSIGNED_VAR_LONG.write(input, interpolationTicks);
+            });
+        }
+
+        private Translation translate(final ClientboundBedrockPackets type, final Consumer<ByteBuf> encode) throws Exception {
+            final ByteBuf input = Unpooled.buffer();
+            final ByteBuf output = Unpooled.buffer();
+            try {
+                encode.accept(input);
+                final var packet = new PacketWrapperImpl(type, input, this.user);
+                this.protocol.translate(packet);
+                assertEquals(0, input.readableBytes());
+                if (!packet.isCancelled()) {
+                    packet.writeToBuffer(output);
+                }
+                return new Translation(packet.isCancelled(), ByteBufUtil.getBytes(output));
+            } finally {
+                input.release();
+                output.release();
+            }
+        }
+    }
