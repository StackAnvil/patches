+    private static final Position3f NETWORK_ROTATION = rotation(12, 200, 254);
+
+    @Test
+    void ignoredLocalPacketsRetainTheirStreamBeforePredictionChangesLiveCoordinates() throws Exception {
+        final var context = new Context();
+        final var player = context.local(new Position3f(100, 200, 300));
+        assertTrue(context.absolute().cancelled());
+        assertEquals(NETWORK_POSITION, player.lastReceivedPosition());
+        assertEquals(NETWORK_ROTATION, player.lastReceivedRotation());
+        when(player.position()).thenReturn(new Position3f(400, 500, 600));
+        when(player.rotation()).thenReturn(new Position3f(90, 90, 90));
+        assertTrue(context.delta(2 | 32, true).cancelled());
+        assertEquals(new Position3f(10.25F, -2.5F, 30.75F), player.lastReceivedPosition());
+        assertEquals(new Position3f(NETWORK_ROTATION.x(), NETWORK_ROTATION.y(), MathUtil.byte2Float((byte) 45)), player.lastReceivedRotation());
+        assertEquals(new Position3f(400, 500, 600), player.position());
+        assertEquals(new Position3f(90, 90, 90), player.rotation());
+    }
+
+    @Test
+    void remoteSparsePacketsUseReceivedCoordinatesAndAnglesInsteadOfLiveActorWrites() throws Exception {
+        final var context = new Context();
+        final Entity actor = new Entity(context.user, 21, RUNTIME_ID, "minecraft:player", 301,
+                UUID.randomUUID(), EntityTypes26_3.PLAYER);
+        when(context.tracker.getEntityByRid(RUNTIME_ID)).thenReturn(actor);
+        actor.setPosition(new Position3f(1, 2, 3));
+        actor.setRotation(new Position3f(4, 5, 6));
+        try (var packets = mockStatic(PacketFactory.class)) {
+            assertFalse(context.absolute().cancelled());
+            actor.setPosition(new Position3f(100, 200, 300));
