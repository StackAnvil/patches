From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:58:43 +0200
Subject: [PATCH] build(java): adopt the Java 25 language baseline

Declare the language baseline before patches that use sequenced collections and unnamed parameters. Keep the shared float interpreter migration separate from language compatibility. Preserve named unused parameters in patches that still target the Java 17 upstream base.

diff --git a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
index f1597378099a13e3794da5f461a8e30478c5314e..1a1588f09471af68c78fd932d15608056421b000 100644
--- a/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
+++ b/buildSrc/src/main/groovy/viabedrock.checkstyle.gradle
@@ -6,6 +6,8 @@ checkstyle {
     toolVersion = "14.1.0"
     configProperties = [
         javaVersion              : java.toolchain.languageVersion.get().asInt(),
+        // Upstream PR patches still compile on Java 17 and use named unused parameters.
+        requireUnnamedParameters : false,
         typeParameterNameFormat  : "^[A-Z0-9_]+\$",
         allowedAbbreviationLength: 0,
     ]
@@ -188,15 +190,15 @@ checkstyle {
                 <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
                 <module name="UnnecessarySemicolonInEnumeration"/>
                 <module name="UnnecessarySemicolonInTryWithResources"/>
-                ${configProperties.javaVersion >= 22 ? '<module name="UnusedCatchParameterShouldBeUnnamed"/>' : ''}
+                ${configProperties.javaVersion >= 22 && configProperties.requireUnnamedParameters ? '<module name="UnusedCatchParameterShouldBeUnnamed"/>' : ''}
                 <module name="UnusedImports"/>
-                ${configProperties.javaVersion >= 22 ? '<module name="UnusedLambdaParameterShouldBeUnnamed"/>' : ''}
+                ${configProperties.javaVersion >= 22 && configProperties.requireUnnamedParameters ? '<module name="UnusedLambdaParameterShouldBeUnnamed"/>' : ''}
                 <module name="UnusedLocalVariable">
                     <property name="allowUnnamedVariables" value="false"/>
                     <property name="jdkVersion" value="\${javaVersion}"/>
                 </module>
                 <module name="UnusedPrivateField"/>
-                ${configProperties.javaVersion >= 22 ? '<module name="UnusedTryResourceShouldBeUnnamed"/>' : ''}
+                ${configProperties.javaVersion >= 22 && configProperties.requireUnnamedParameters ? '<module name="UnusedTryResourceShouldBeUnnamed"/>' : ''}
                 <module name="UpperEll"/>
                 ${configProperties.javaVersion >= 14 ? '<module name="UseEnhancedSwitch"/>' : ''}
                 <module name="VisibilityModifier">
diff --git a/gradle.properties b/gradle.properties
index f781d5a74bd0b5f94aef6f6afb470e5077aacc5f..e4ffc1569593ff91823580e30c15689f659de615 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -1,7 +1,7 @@
 org.gradle.daemon=true
 org.gradle.parallel=true
 org.gradle.configuration-cache=true
-java_version=17
+java_version=25
 maven_group=net.raphimc
 maven_name=ViaBedrock
 maven_version=0.0.32-StackAnvil
