From 60006b42385d91312d737e4b6a89bdbdd3ff4b41 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:58:08 +0200
Subject: [PATCH] fix(world): refresh bed colors on repeated block updates

A bed block entity can change color while its base Bedrock runtime ID stays the same. Recompute its Java block state on repeated updates so the client receives the new color.
---
 .../protocol/storage/ChunkTracker.java        | 33 ++++++++++---------
 1 file changed, 18 insertions(+), 15 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
index 93084f1d6..3166f42cd 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
@@ -525,7 +525,8 @@ public class ChunkTracker extends StoredObject {
             entityTracker.removeItemFrame(blockPosition);
         }
 
-        if (prevBlockState != blockState) {
+        final boolean stateChanged = prevBlockState != blockState;
+        if (stateChanged) {
             if (layer == 0 && this.nativeBlocksEnabled()) {
                 this.sendNativeBlocks(new NativeBlockIdentifiers.Update(this.dimension.ordinal(), blockPosition, blockState));
             }
@@ -541,22 +542,24 @@ public class ChunkTracker extends StoredObject {
 
             if (CustomBlockTags.ITEM_FRAME.equals(tag)) {
                 entityTracker.spawnItemFrame(blockPosition, blockStateRewriter.blockState(blockState));
-            } else if (BlockEntityRewriter.isBlockEntity(tag)) {
-                final BedrockBlockEntity bedrockBlockEntity = this.getBlockEntity(blockPosition);
-                BlockEntity javaBlockEntity = null;
-                if (bedrockBlockEntity != null) {
-                    javaBlockEntity = BlockEntityRewriter.toJava(this.user(), blockState, bedrockBlockEntity);
-                    if (javaBlockEntity instanceof BlockEntityWithBlockState blockEntityWithBlockState) {
-                        remappedBlockState = blockEntityWithBlockState.blockState();
-                    }
-                } else if (BedrockProtocol.MAPPINGS.getJavaBlockEntities().containsKey(tag)) {
-                    final int javaType = BedrockProtocol.MAPPINGS.getJavaBlockEntities().get(tag);
-                    javaBlockEntity = new BlockEntityImpl(BlockEntity.pack(sectionX, sectionZ), (short) blockPosition.y(), javaType, new CompoundTag());
-                }
+            }
+        }
 
-                if (javaBlockEntity != null && javaBlockEntity.tag() != null) {
-                    return new IntObjectImmutablePair<>(remappedBlockState, javaBlockEntity);
+        if (BlockEntityRewriter.isBlockEntity(tag)) {
+            final BedrockBlockEntity bedrockBlockEntity = this.getBlockEntity(blockPosition);
+            BlockEntity javaBlockEntity = null;
+            if (bedrockBlockEntity != null) {
+                javaBlockEntity = BlockEntityRewriter.toJava(this.user(), blockState, bedrockBlockEntity);
+                if (javaBlockEntity instanceof BlockEntityWithBlockState blockEntityWithBlockState) {
+                    remappedBlockState = blockEntityWithBlockState.blockState();
                 }
+            } else if (stateChanged && BedrockProtocol.MAPPINGS.getJavaBlockEntities().containsKey(tag)) {
+                final int javaType = BedrockProtocol.MAPPINGS.getJavaBlockEntities().get(tag);
+                javaBlockEntity = new BlockEntityImpl(BlockEntity.pack(sectionX, sectionZ), (short) blockPosition.y(), javaType, new CompoundTag());
+            }
+
+            if (stateChanged && javaBlockEntity != null && javaBlockEntity.tag() != null) {
+                return new IntObjectImmutablePair<>(remappedBlockState, javaBlockEntity);
             }
         }
 
