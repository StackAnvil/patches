Date: Mon, 16 Nov 2026 21:52:16 +0100
Subject: [PATCH] fix(entities): translate Bedrock sound variant names

Bedrock's minecraft:sound_variant actor property names the base variant
"default" and the angry wolf "mad". Java's chicken, cow, pig, wolf and
cat sound variant registries name them "classic" and "angry". The
translation looked up the Bedrock names directly, so every base chicken,
cow, pig and wolf logged "Failed to find sound variant minecraft:default"
and kept Java's default instead of its server-selected variant.

The Bedrock 1.26.60 synced property definitions list chicken
default/picky, cow default/moody, pig default/big/mini and wolf
default/big/cute/grumpy/mad/puglin/sad. Map default to classic and mad
to angry; the other names already match Java's registries.

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
index 6bbc4eeba6b8c98bfb1e32b556d54cca6ac4fd01..ea65636f1454d87cf2c676cf7c2bb033c21cc19c 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
@@ -833,7 +833,7 @@ public final class EntityMetadataRewriter {
                         }
                     }
                     case "minecraft:sound_variant" -> {
-                        final String namespacedVariant = Key.namespaced(value);
+                        final String namespacedVariant = Key.namespaced(javaSoundVariant(value));
 
                         final String registryName = switch (entity.javaType()) {
                             case CHICKEN -> RegistryKeys.CHICKEN_SOUND_VARIANT;
@@ -1148,6 +1148,18 @@ public final class EntityMetadataRewriter {
         return 1; // MEDIUM, including custom scales
     }
 
+    /**
+     * Bedrock names the base sound variant "default" and the angry wolf "mad". Java's sound variant registries name
+     * them "classic" and "angry"; the other names match.
+     */
+    static String javaSoundVariant(final String bedrockVariant) {
+        return switch (bedrockVariant) {
+            case "default" -> "classic";
+            case "mad" -> "angry";
+            default -> bedrockVariant;
+        };
+    }
+
     private static Number readNumber(final EntityData data) {
         if (data.dataType() == null || data.getValue() == null) {
             throw new IllegalArgumentException("EntityData " + data.id() + " has null data type or value");
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/SoundVariantNameTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/SoundVariantNameTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9d4ff30747d1be6d2ca8d800bb378f496f83ff67
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/SoundVariantNameTest.java
@@ -0,0 +1,23 @@
