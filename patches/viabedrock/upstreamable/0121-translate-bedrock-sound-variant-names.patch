+package net.raphimc.viabedrock.protocol.rewriter;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class SoundVariantNameTest {
+
+    @Test
+    void bedrockSoundVariantsUseJavaRegistryNames() {
+        // Bedrock 1.26.60 synced properties: chicken default/picky, pig default/big/mini, wolf default/.../mad/...
+        assertEquals("classic", EntityMetadataRewriter.javaSoundVariant("default"));
+        assertEquals("angry", EntityMetadataRewriter.javaSoundVariant("mad"));
+        assertEquals("picky", EntityMetadataRewriter.javaSoundVariant("picky"));
+        assertEquals("puglin", EntityMetadataRewriter.javaSoundVariant("puglin"));
+    }
+
+}
