+package net.raphimc.viabedrock.protocol.packet;
+
+import net.lenni0451.mcstructs_bedrock.forms.elements.LabelFormElement;
+import net.lenni0451.mcstructs_bedrock.forms.elements.SliderFormElement;
+import net.lenni0451.mcstructs_bedrock.forms.types.CustomForm;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class SliderFormResponseTest {
+
+    @Test
+    void wholeSliderValuesAreSentWithoutFraction() {
+        final SliderFormElement whole = new SliderFormElement("Render distance", 2, 12, 2, 6);
+        final SliderFormElement fraction = new SliderFormElement("Volume", 0, 1, 0.25F, 0.5F);
+        final CustomForm form = new CustomForm("Preferences", new LabelFormElement("Prose"), whole, fraction);
+        assertEquals("[null,6,0.5]", InventoryPackets.formResponse(form));
+    }
+
+}
