+    public void trackBlockPrediction(final int sequence, final BlockPosition clickedPosition, final BlockPosition placedPosition) {
+        final Set<BlockPosition> positions = clickedPosition.equals(placedPosition)
+                ? Set.of(clickedPosition) : Set.of(clickedPosition, placedPosition);
+        this.blockPredictions.add(sequence, positions, System.nanoTime());
+    }
+
+    public void observeBlockUpdates(final Collection<BlockPosition> positions) {
+        this.blockPredictions.observeUpdates(positions, System.nanoTime());
+    }
+
     public IntObjectPair<BlockEntity> handleBlockChange(final BlockPosition blockPosition, final int layer, final int blockState) {
         final BedrockChunkSection section = this.getChunkSection(blockPosition);
         if (section == null) {
@@ -1175,6 +1187,10 @@ public class ChunkTracker extends StoredObject {
     }
 
     public void tick() {
+        final int acknowledgedSequence = this.blockPredictions.pollAcknowledgement(System.nanoTime());
+        if (acknowledgedSequence > 0) {
+            PacketFactory.sendJavaBlockChangedAck(this.user(), acknowledgedSequence);
