+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+
+import java.util.Collection;
+import java.util.NavigableMap;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.concurrent.TimeUnit;
+
+final class BlockPredictionQueue {
+
+    private static final long UPDATE_SETTLE_NANOS = TimeUnit.MILLISECONDS.toNanos(50);
+    private static final long RESPONSE_TIMEOUT_NANOS = TimeUnit.SECONDS.toNanos(1);
+
+    private final NavigableMap<Integer, Prediction> predictions = new TreeMap<>();
+
+    void add(final int sequence, final Set<BlockPosition> positions, final long now) {
+        if (sequence > 0) {
+            this.predictions.put(sequence, new Prediction(positions, now + RESPONSE_TIMEOUT_NANOS));
+        }
+    }
+
+    void observeUpdates(final Collection<BlockPosition> positions, final long now) {
+        for (Prediction prediction : this.predictions.values()) {
+            if (prediction.readyAt != Long.MAX_VALUE) {
+                continue;
+            }
+            for (BlockPosition position : positions) {
+                if (prediction.positions.contains(position)) {
+                    prediction.readyAt = now + UPDATE_SETTLE_NANOS;
+                    break;
+                }
+            }
+        }
+    }
+
+    int pollAcknowledgement(final long now) {
+        int sequence = -1;
+        while (!this.predictions.isEmpty()) {
+            final Prediction first = this.predictions.firstEntry().getValue();
+            if (now < first.readyAt && now < first.deadline) {
+                break;
+            }
+            sequence = this.predictions.pollFirstEntry().getKey();
+        }
+        return sequence;
+    }
+
+    private static final class Prediction {
+
+        private final Set<BlockPosition> positions;
+        private final long deadline;
+        private long readyAt = Long.MAX_VALUE;
+
+        private Prediction(final Set<BlockPosition> positions, final long deadline) {
+            this.positions = Set.copyOf(positions);
+            this.deadline = deadline;
+        }
+
+    }
+
+}
