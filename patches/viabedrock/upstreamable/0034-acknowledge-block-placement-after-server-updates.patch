+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BlockPredictionQueueTest {
+
+    @Test
+    void waitsForServerUpdateAndAcknowledgesInSequenceOrder() {
+        final BlockPredictionQueue queue = new BlockPredictionQueue();
+        final BlockPosition first = new BlockPosition(1, 64, 1);
+        final BlockPosition second = new BlockPosition(2, 64, 1);
+        final long now = TimeUnit.SECONDS.toNanos(10);
+        queue.add(5, Set.of(first), now);
+        queue.add(6, Set.of(second), now);
+
+        queue.observeUpdates(List.of(second), now + 1);
+        assertEquals(-1, queue.pollAcknowledgement(now + TimeUnit.MILLISECONDS.toNanos(100)));
+        queue.observeUpdates(List.of(first), now + TimeUnit.MILLISECONDS.toNanos(120));
+        assertEquals(-1, queue.pollAcknowledgement(now + TimeUnit.MILLISECONDS.toNanos(140)));
+        assertEquals(6, queue.pollAcknowledgement(now + TimeUnit.MILLISECONDS.toNanos(180)));
+    }
+
+    @Test
+    void expiresInteractionsWithoutBlockUpdates() {
+        final BlockPredictionQueue queue = new BlockPredictionQueue();
+        final long now = TimeUnit.SECONDS.toNanos(10);
+        queue.add(7, Set.of(new BlockPosition(1, 64, 1)), now);
+
+        assertEquals(-1, queue.pollAcknowledgement(now + TimeUnit.MILLISECONDS.toNanos(999)));
+        assertEquals(7, queue.pollAcknowledgement(now + TimeUnit.SECONDS.toNanos(1)));
+    }
+
+}
