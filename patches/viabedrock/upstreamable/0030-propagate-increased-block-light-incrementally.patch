+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class LightEngineTest {
+
+    @Test
+    void fullHeightAirRegionsReuseUniformOutputsWithinThreeWorkingBuffers() {
+        final var threadBean = ManagementFactory.getThreadMXBean();
+        assumeTrue(threadBean instanceof ThreadMXBean);
+        final var allocations = (ThreadMXBean) threadBean;
+        assumeTrue(allocations.isThreadAllocatedMemorySupported());
+        allocations.setThreadAllocatedMemoryEnabled(true);
+        final int[][][] region = new int[9][24][];
+        for (final int[][] chunk : region) {
+            for (int section = 0; section < chunk.length; section++) {
+                chunk[section] = new int[]{0};
+            }
+        }
+        final byte[] emission = {0};
+        final byte[] opacity = {0};
+        final long thread = Thread.currentThread().threadId();
+        for (int run = 0; run < 8; run++) {
+            final long before = allocations.getThreadAllocatedBytes(thread);
+            final ChunkLight light = LightEngine.computeCenterLight(region, 24, true, emission, opacity);
+            final long allocated = allocations.getThreadAllocatedBytes(thread) - before;
+            assertTrue(allocated <= 3L * 48 * 48 * 384 + 256_000, () -> "Allocated " + allocated + " bytes");
+            for (int section = 0; section < light.skyLightLength(); section++) {
+                assertSame(ChunkLight.FULL, light.skyLight(section));
+                assertNull(light.blockLight(section));
+            }
+        }
+    }
+
+    @Test
+    void compactUniformSectionsPreserveFullAndIncrementalLightAcrossBorders() {
+        final byte[] emission = {0, 0, 14, 0};
+        final byte[] opacity = {0, 15, 0, 2};
+        final int[][][] expanded = new int[9][2][4096];
+        final int[][][] compact = new int[9][2][];
+        for (int chunk = 0; chunk < 9; chunk++) {
+            final int state = chunk == 0 ? 1 : chunk == 1 ? 3 : 0;
+            for (int section = 0; section < 2; section++) {
+                Arrays.fill(expanded[chunk][section], state);
+                compact[chunk][section] = new int[]{state};
+            }
+        }
+        for (final boolean skyLight : new boolean[]{false, true}) {
+            final ChunkLight[] expected = LightEngine.computeRegionLight(expanded, 2, skyLight, emission, opacity);
+            final ChunkLight[] actual = LightEngine.computeRegionLight(compact, 2, skyLight, emission, opacity);
+            assertLightEquals(expected, actual);
+            expanded[4][0][(8 << 8) | (8 << 4) | 15] = 2;
+            compact[4][0] = expanded[4][0].clone();
+            final ChunkLight[] brightened = LightEngine.brightenBlockLight(compact, 2, 15, 8, 8, 14, opacity, actual);
+            assertLightEquals(LightEngine.computeRegionLight(expanded, 2, skyLight, emission, opacity), brightened);
+            assertEquals(13, nibble(brightened[5].blockLight(1), 0, 8, 8));
+            expanded[4][0][(8 << 8) | (8 << 4) | 15] = 0;
+            compact[4][0] = new int[]{0};
+        }
+    }
+
+    private static void assertLightEquals(final ChunkLight[] expected, final ChunkLight[] actual) {
+        for (int chunk = 0; chunk < 9; chunk++) {
+            for (int section = 0; section < expected[chunk].skyLightLength(); section++) {
+                assertArrayEquals(expected[chunk].skyLight(section), actual[chunk].skyLight(section));
+                assertArrayEquals(expected[chunk].blockLight(section), actual[chunk].blockLight(section));
+            }
+        }
+    }
+
+    @Test
+    void centerOnlyOutputMatchesFullRegionAcrossChunkBorders() {
+        final int[][][] region = new int[9][][];
+        for (int i = 0; i < region.length; i++) {
+            region[i] = new int[][]{new int[4096], new int[4096]};
+        }
+        final int[] centerLower = region[4][0];
+        final int[] eastLower = region[5][0];
+        final int[] northUpper = region[1][1];
+        centerLower[(8 << 8) | (8 << 4) | 8] = 1; // opaque obstacle
+        eastLower[(8 << 8) | (8 << 4)] = 2; // emitted light crossing into center
+        Arrays.fill(northUpper, 3); // partially filtering sky above a neighboring chunk
+
+        final byte[] emission = {0, 0, 14, 0};
+        final byte[] opacity = {0, 15, 0, 2};
+        for (boolean skyLight : new boolean[]{false, true}) {
+            final ChunkLight expected = LightEngine.computeRegionLight(region, 2, skyLight, emission, opacity)[4];
+            final ChunkLight actual = LightEngine.computeCenterLight(region, 2, skyLight, emission, opacity);
+            for (int section = 0; section < expected.skyLightLength(); section++) {
+                assertArrayEquals(expected.skyLight(section), actual.skyLight(section));
+                assertArrayEquals(expected.blockLight(section), actual.blockLight(section));
+            }
+        }
+    }
+
+    @Test
+    void secondaryWaterCombinesWithPrimaryFilteringAndDoesNotMutateStates() {
+        final byte[] emission = {0, 0, 0, 0};
+        final byte[] opacity = {0, 15, 8, 15};
+        for (int primary = 0; primary < opacity.length; primary++) {
+            final int[][][] region = new int[9][2][4096];
+            for (final int[][] chunk : region) {
+                for (final int[] section : chunk) {
+                    Arrays.fill(section, 1);
+                }
+            }
+            for (int y = 1; y < 32; y++) {
+                region[4][y >> 4][((y & 15) << 8) | (8 << 4) | 8] = 0;
+                region[4][y >> 4][((y & 15) << 8) | (11 << 4) | 8] = 0;
+            }
+            final int wetIndex = (4 << 8) | (8 << 4) | 8;
+            final int dryIndex = (4 << 8) | (11 << 4) | 8;
+            region[4][1][wetIndex] = primary;
+            region[4][1][dryIndex] = primary;
+            final BitSet[][] water = new BitSet[9][];
+            water[4] = new BitSet[]{null, new BitSet(4096)};
+            water[4][1].set(wetIndex);
+            final ChunkLight wet = LightEngine.computeCenterLight(region, water, 2, true, emission, opacity);
+            final ChunkLight dry = LightEngine.computeCenterLight(region, 2, true, emission, opacity);
+            assertEquals(Math.max(0, 15 - Math.max(opacity[primary], 1)), nibble(wet.skyLight(2), 8, 4, 8));
+            assertEquals(Math.max(0, 15 - opacity[primary]), nibble(wet.skyLight(2), 8, 4, 11));
+            assertEquals(primary, region[4][1][wetIndex]);
+            assertEquals(1, water[4][1].cardinality());
+            final ChunkLight restored = LightEngine.computeCenterLight(region, new BitSet[9][], 2, true, emission, opacity);
+            for (int section = 0; section < dry.skyLightLength(); section++) {
+                assertArrayEquals(dry.skyLight(section), restored.skyLight(section));
+                assertArrayEquals(dry.blockLight(section), wet.blockLight(section));
+            }
+        }
+    }
+
+    private static int nibble(final byte[] data, final int x, final int y, final int z) {
+        return data == null ? 0 : (data[(y << 7) | (z << 3) | (x >> 1)] >>> ((x & 1) << 2)) & 15;
+    }
+
+    @Test
+    void incrementalEmissionIncreaseMatchesFullRecomputation() {
+        final byte[] emission = {0, 0, 5, 13, 0};
+        final byte[] opacity = {0, 15, 0, 0, 2};
+        final Random random = new Random(0x51A7E);
+        for (int scenario = 0; scenario < 24; scenario++) {
+            final int[][][] region = new int[9][][];
+            for (int chunk = 0; chunk < region.length; chunk++) {
+                region[chunk] = new int[][]{new int[4096], new int[4096]};
+                for (int section = 0; section < 2; section++) {
+                    final int[] states = region[chunk][section];
+                    for (int i = 0; i < 96; i++) {
+                        states[random.nextInt(states.length)] = random.nextBoolean() ? 1 : 4;
+                    }
+                    states[random.nextInt(states.length)] = 2;
+                }
+            }
+
+            final int sourceX = scenario % 2 == 0 ? 0 : 15;
+            final int sourceZ = scenario % 4 < 2 ? 0 : 15;
+            final int sourceY = scenario % 3 == 0 ? 0 : scenario % 3 == 1 ? 15 : 31;
+            final int sourceIndex = ((sourceY & 15) << 8) | (sourceZ << 4) | sourceX;
+            final int previousSourceState = scenario % 2 == 0 ? 0 : 2;
+            region[4][sourceY >> 4][sourceIndex] = previousSourceState;
+
+            for (boolean skyLight : new boolean[]{false, true}) {
+                final ChunkLight[] before = LightEngine.computeRegionLight(region, 2, skyLight, emission, opacity);
+                final byte[] original = before[4].blockLight((sourceY >> 4) + 1);
+                final byte[] originalCopy = original == null ? null : original.clone();
+                region[4][sourceY >> 4][sourceIndex] = 3;
+
+                final ChunkLight[] actual = LightEngine.brightenBlockLight(region, 2, sourceX, sourceY, sourceZ, 13, opacity, before);
+                final ChunkLight[] expected = LightEngine.computeRegionLight(region, 2, skyLight, emission, opacity);
+                for (int chunk = 0; chunk < 9; chunk++) {
+                    for (int section = 0; section < expected[chunk].skyLightLength(); section++) {
+                        assertArrayEquals(expected[chunk].skyLight(section), actual[chunk].skyLight(section));
+                        assertArrayEquals(expected[chunk].blockLight(section), actual[chunk].blockLight(section));
+                    }
+                }
+                assertArrayEquals(originalCopy, before[4].blockLight((sourceY >> 4) + 1));
+                region[4][sourceY >> 4][sourceIndex] = previousSourceState;
+            }
+        }
+    }
+
+}
