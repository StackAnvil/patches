+        if (blockPalettes.size() > 1) {
+            final DataPalette layer1 = blockPalettes.get(1);
+            final int airId = this.bedrockAirId();
+            if (layer1.size() != 1 || layer1.idByIndex(0) != airId) {
+                for (int y = 0; y < 16; y++) {
+                    for (int z = 0; z < 16; z++) {
+                        for (int x = 0; x < 16; x++) {
+                            if (layer0.idAt(x, y, z) == airId || layer1.idAt(x, y, z) == airId
+                                || !CustomBlockTags.WATER.equals(blockStateRewriter.tag(layer1.idAt(x, y, z)))) {
