+        assertEquals(1, slots.availablePermits());
+        final var replacement = ChunkTracker.LightUpdateTask.reserve(slots);
+        replacement.execute(workers, completion, () -> new ChunkLight(24, false), (_, _) -> applied.incrementAndGet());
+        workers.drain();
