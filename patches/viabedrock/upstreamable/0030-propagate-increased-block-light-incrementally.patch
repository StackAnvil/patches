+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BlockLightFilteringTest {
+
+    @Test
+    void matchesNativeSkyShaftAndBlockLightTunnelMeasurements() {
+        final var opacityData = JsonParser.parseReader(new InputStreamReader(BlockLightFilteringTest.class.getResourceAsStream(
+                "/assets/viabedrock/data/java/block_light_properties.json"), StandardCharsets.UTF_8)).getAsJsonObject().getAsJsonObject("opacity");
+        final List<Measurement> measurements = List.of(
+                new Measurement("minecraft:oak_slab[type=bottom]", 14, 14),
+                new Measurement("minecraft:oak_slab[type=top]", 14, 14),
+                new Measurement("minecraft:oak_slab[type=double]", 0, 0),
+                new Measurement("minecraft:smooth_stone_slab[type=bottom]", 14, 14),
+                new Measurement("minecraft:smooth_stone_slab[type=top]", 14, 14),
+                new Measurement("minecraft:smooth_stone_slab[type=double]", 0, 0),
+                new Measurement("minecraft:oak_stairs[half=bottom]", 15, 14),
+                new Measurement("minecraft:oak_stairs[half=top]", 15, 14),
+                new Measurement("minecraft:oak_stairs[half=bottom,waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_stairs[half=top,waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_fence[waterlogged=false]", 15, 14),
+                new Measurement("minecraft:oak_fence[waterlogged=true]", 14, 14),
+                new Measurement("minecraft:iron_chain[waterlogged=false]", 15, 14),
+                new Measurement("minecraft:iron_chain[waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_slab[type=bottom,waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_slab[type=top,waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_leaves[waterlogged=true]", 14, 14),
+                new Measurement("minecraft:oak_leaves", 14, 14),
+                new Measurement("minecraft:water", 14, 14),
+                new Measurement("minecraft:glass", 15, 14),
+                new Measurement("minecraft:stone", 0, 0));
+        for (final Measurement measurement : measurements) {
+            final BlockState state = BlockState.fromString(measurement.state());
+            final var configured = opacityData.get(state.namespacedIdentifier());
+            final byte filter = (byte) BedrockMappingData.getStateLightOpacity(state, configured == null ? 15 : configured.getAsInt());
+            final byte[] opacity = {0, 15, 15, filter};
+            final byte[] emission = {0, 0, 15, 0};
+            final int[][][] region = opaqueRegion();
+            for (int y = 1; y < 32; y++) {
+                region[4][y >> 4][index(8, y & 15, 8)] = 0;
+            }
+            region[4][1][index(8, 4, 8)] = 3;
+            final var sky = LightEngine.computeCenterLight(region, 2, true, emission, opacity);
+            assertEquals(measurement.sky(), light(sky.skyLight(2), 8, 4, 8), measurement.state());
+            for (int distance = 1; distance <= 4; distance++) {
+                final int below = 20 - distance;
+                final int expected = measurement.sky() == 15 ? 15 : Math.max(0, measurement.sky() - distance);
+                assertEquals(expected, light(sky.skyLight((below >> 4) + 1), 8, below & 15, 8), measurement.state());
+            }
+
+            region[4][0][index(6, 8, 4)] = 2;
+            region[4][0][index(7, 8, 4)] = 3;
+            region[4][0][index(8, 8, 4)] = 0;
+            final var block = LightEngine.computeCenterLight(region, 2, false, emission, opacity);
+            assertEquals(measurement.block(), light(block.blockLight(1), 7, 8, 4), measurement.state());
+            assertEquals(Math.max(0, measurement.block() - 1), light(block.blockLight(1), 8, 8, 4), measurement.state());
+        }
+    }
+
+    private static int[][][] opaqueRegion() {
+        final int[][][] region = new int[9][2][4096];
+        for (final int[][] chunk : region) {
+            for (final int[] section : chunk) {
+                Arrays.fill(section, 1);
+            }
+        }
+        return region;
+    }
+
+    private static int index(final int x, final int y, final int z) {
+        return (y << 8) | (z << 4) | x;
+    }
+
+    private static int light(final byte[] data, final int x, final int y, final int z) {
+        return data == null ? 0 : (data[(y << 7) | (z << 3) | (x >> 1)] >>> ((x & 1) << 2)) & 15;
+    }
+
+    private record Measurement(String state, int sky, int block) {
+    }
+
+}
