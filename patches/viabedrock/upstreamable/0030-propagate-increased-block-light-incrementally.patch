+    private static int blockOpacity(final int[][][] regionStates, final int x, final int y, final int z, final byte[] opacityTable) {
+        final int[][] chunk = regionStates[(z >> 4) * 3 + (x >> 4)];
+        if (chunk == null || chunk[y >> 4] == null) {
+            return 15;
+        }
+        final int[] section = chunk[y >> 4];
+        final int state = section[section.length == 1 ? 0 : ((y & 15) << 8) | ((z & 15) << 4) | (x & 15)];
+        return opacityTable[state] & 0xFF;
+    }
