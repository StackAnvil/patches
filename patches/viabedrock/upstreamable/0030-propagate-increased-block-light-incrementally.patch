+    /**
+     * Adds the light contributed by a newly brighter block in the center chunk. The cached light
+     * must represent the region before this one emission increase; opacity must be unchanged.
+     * Other edits, including removing a light source, require a full recomputation. Secondary
+     * water raises zero opacity to one, which is already the minimum loss for block light.
+     */
+    public static ChunkLight[] brightenBlockLight(final int[][][] regionStates, final int sectionCount,
+                                                   final int sourceX, final int sourceY, final int sourceZ,
+                                                   final int emission, final byte[] opacityTable,
+                                                   final ChunkLight[] previousLights) {
+        if (regionStates.length != 9 || previousLights.length != 9) {
+            throw new IllegalArgumentException("Region and light cache must contain exactly 9 chunks");
+        }
+        final int height = sectionCount << 4;
+        if (height > MAX_HEIGHT || sourceX < 0 || sourceX >= 16 || sourceY < 0 || sourceY >= height
+            || sourceZ < 0 || sourceZ >= 16 || emission < 1 || emission > 15) {
+            throw new IllegalArgumentException("Invalid light source");
+        }
+
+        // Every step loses at least one level, so only a 29-block-high window can be affected.
+        final int minY = Math.max(0, sourceY - emission + 1);
+        final int maxY = Math.min(height - 1, sourceY + emission - 1);
+        final byte[] addedLight = new byte[(maxY - minY + 1) * REGION_SIZE_SQUARED];
+        final int x = sourceX + 16;
+        final int z = sourceZ + 16;
+        addedLight[((sourceY - minY) * REGION_SIZE + z) * REGION_SIZE + x] = (byte) emission;
+        final IntQueue queue = new IntQueue();
+        queue.enqueue(pack(x, sourceY, z));
+        while (!queue.isEmpty()) {
+            final int packed = queue.dequeueInt();
+            final int currentX = packed & 0x3F;
+            final int currentZ = (packed >>> 6) & 0x3F;
+            final int currentY = packed >>> 12;
+            final int level = addedLight[((currentY - minY) * REGION_SIZE + currentZ) * REGION_SIZE + currentX] & 0xFF;
+            if (level <= 1) {
+                continue;
+            }
+            for (final int[] direction : DIRECTIONS) {
+                final int nextX = currentX + direction[0];
+                final int nextY = currentY + direction[1];
+                final int nextZ = currentZ + direction[2];
+                if (nextX < 0 || nextX >= REGION_SIZE || nextY < minY || nextY > maxY
+                    || nextZ < 0 || nextZ >= REGION_SIZE) {
+                    continue;
+                }
+                final int opacity = blockOpacity(regionStates, nextX, nextY, nextZ, opacityTable);
+                if (opacity >= 15) {
+                    continue;
+                }
+                final int nextLevel = level - Math.max(1, opacity);
+                final int nextIndex = ((nextY - minY) * REGION_SIZE + nextZ) * REGION_SIZE + nextX;
+                if (nextLevel > (addedLight[nextIndex] & 0xFF)) {
+                    addedLight[nextIndex] = (byte) nextLevel;
+                    if (nextLevel > 1) {
+                        queue.enqueue(pack(nextX, nextY, nextZ));
+                    }
+                }
+            }
+        }
+
+        final ChunkLight[] result = previousLights.clone();
+        final boolean[][] copiedSections = new boolean[9][];
+        for (int y = minY; y <= maxY; y++) {
+            for (int regionZ = 0; regionZ < REGION_SIZE; regionZ++) {
+                for (int regionX = 0; regionX < REGION_SIZE; regionX++) {
+                    final int level = addedLight[((y - minY) * REGION_SIZE + regionZ) * REGION_SIZE + regionX] & 0xFF;
+                    if (level == 0) {
+                        continue;
+                    }
+                    final int chunkIndex = (regionZ >> 4) * 3 + (regionX >> 4);
+                    final ChunkLight previous = previousLights[chunkIndex];
+                    if (previous == null) {
+                        continue;
+                    }
+                    final int lightSection = (y >> 4) + 1;
+                    final int localX = regionX & 15;
+                    final int localZ = regionZ & 15;
+                    final int byteIndex = ((y & 15) << 7) | (localZ << 3) | (localX >> 1);
+                    final int shift = (localX & 1) << 2;
+                    byte[] section = result[chunkIndex].blockLight(lightSection);
+                    if (section != null && ((section[byteIndex] >>> shift) & 15) >= level) {
+                        continue;
+                    }
+                    if (result[chunkIndex] == previous) {
+                        final ChunkLight copy = new ChunkLight(sectionCount, false);
+                        for (int i = 0; i < previous.skyLightLength(); i++) {
+                            copy.setSkyLight(i, previous.skyLight(i));
+                            copy.setBlockLight(i, previous.blockLight(i));
+                        }
+                        result[chunkIndex] = copy;
+                        copiedSections[chunkIndex] = new boolean[sectionCount + 2];
+                    }
+                    if (!copiedSections[chunkIndex][lightSection]) {
+                        section = section == null ? new byte[LIGHT_LENGTH] : section.clone();
+                        result[chunkIndex].setBlockLight(lightSection, section);
+                        copiedSections[chunkIndex][lightSection] = true;
+                    }
+                    section[byteIndex] = (byte) ((section[byteIndex] & ~(15 << shift)) | (level << shift));
+                }
+            }
+        }
+        return result;
+    }
