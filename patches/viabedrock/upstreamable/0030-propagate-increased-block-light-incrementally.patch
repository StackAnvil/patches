+    static int getStateLightOpacity(final BlockState blockState, final int defaultOpacity) {
+        // Bedrock single slabs diffuse skylight; doubles are opaque. Java uses the same block
+        // identifier for both, so identifier-only opacity cannot represent their filtering.
+        if (blockState.identifier().endsWith("_slab")) {
+            return blockState.hasProperty("type", "double") ? 15 : 1;
+        }
+        return defaultOpacity;
+    }
