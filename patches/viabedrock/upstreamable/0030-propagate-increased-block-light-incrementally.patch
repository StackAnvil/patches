+package net.raphimc.viabedrock.protocol.data;
+
+import net.raphimc.viabedrock.api.chunk.light.ChunkLight;
+import net.raphimc.viabedrock.api.chunk.light.LightEngine;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BlockLightEmissionTest {
+
+    @Test
+    void poweredDustDoesNotIlluminateItsNeighbors() {
+        for (int power = 0; power <= 15; power++) {
+            assertTunnel(BlockState.fromString("minecraft:redstone_wire[power=" + power + "]"), 0);
+        }
+    }
+
+    @Test
+    void matchesNativeStateDependentSourceMeasurements() {
+        final List<Measurement> measurements = List.of(
+                new Measurement("minecraft:soul_campfire[lit=true]", 10),
+                new Measurement("minecraft:soul_campfire[lit=false]", 0),
+                new Measurement("minecraft:campfire[lit=true]", 15),
+                new Measurement("minecraft:campfire[lit=false]", 0),
+                new Measurement("minecraft:redstone_ore[lit=true]", 9),
+                new Measurement("minecraft:redstone_ore[lit=false]", 0),
+                new Measurement("minecraft:deepslate_redstone_ore[lit=true]", 9),
+                new Measurement("minecraft:deepslate_redstone_ore[lit=false]", 0),
+                new Measurement("minecraft:furnace[lit=true]", 13),
+                new Measurement("minecraft:furnace[lit=false]", 0),
+                new Measurement("minecraft:blast_furnace[lit=true]", 13),
+                new Measurement("minecraft:blast_furnace[lit=false]", 0),
+                new Measurement("minecraft:smoker[lit=true]", 13),
+                new Measurement("minecraft:smoker[lit=false]", 0));
+        for (final Measurement measurement : measurements) {
+            assertTunnel(BlockState.fromString(measurement.state()), measurement.emission());
+        }
+    }
+
+    private static void assertTunnel(final BlockState source, final int measuredEmission) {
+        final int[][][] region = new int[9][1][4096];
+        for (final int[][] chunk : region) {
+            Arrays.fill(chunk[0], 1);
+        }
+        // The measured tunnel crosses a chunk boundary. Its stone enclosure excludes skylight.
+        for (int x = 8; x < 32; x++) {
+            region[4 + (x >> 4)][0][(8 << 8) | (8 << 4) | (x & 15)] = 0;
+        }
+        final byte[] opacity = {0, 15, (byte) (source.identifier().endsWith("ore")
+                || source.identifier().endsWith("furnace") || source.identifier().equals("smoker") ? 15 : 0)};
+        final byte[] emission = {0, 0, (byte) BedrockMappingData.getStateLightEmission(source)};
+        assertEquals(measuredEmission, emission[2], source.toString());
+        final ChunkLight[] previous = LightEngine.computeRegionLight(region, 1, false, emission, opacity);
+        region[4][0][(8 << 8) | (8 << 4) | 8] = 2;
+        final ChunkLight[] full = LightEngine.computeRegionLight(region, 1, false, emission, opacity);
+        final ChunkLight[] incremental = measuredEmission == 0 ? previous : LightEngine.brightenBlockLight(
+                region, 1, 8, 8, 8, emission[2], opacity, previous);
+        for (int distance = 1; distance <= 15; distance++) {
+            final int x = 8 + distance;
+            final int chunk = 4 + (x >> 4);
+            final int expected = Math.max(0, measuredEmission - distance);
+            assertEquals(expected, light(full[chunk], x & 15), source + " at " + distance);
+            assertEquals(expected, light(incremental[chunk], x & 15), source + " increment at " + distance);
+            assertEquals(0, light(previous[chunk], x & 15));
+        }
+        region[4][0][(8 << 8) | (8 << 4) | 8] = 0;
+        final ChunkLight[] removed = LightEngine.computeRegionLight(region, 1, false, emission, opacity);
+        for (int distance = 1; distance <= 15; distance++) {
+            final int x = 8 + distance;
+            assertEquals(0, light(removed[4 + (x >> 4)], x & 15));
+        }
+    }
+
+    private static int light(final ChunkLight light, final int x) {
+        final byte[] data = light.blockLight(1);
+        return data == null ? 0 : (data[(8 << 7) | (8 << 3) | (x >> 1)] >>> ((x & 1) << 2)) & 15;
+    }
+
+    private record Measurement(String state, int emission) {
+    }
+
+}
