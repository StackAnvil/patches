+    static boolean changesLight(final int previousState, final int currentState, final byte[] emission, final byte[] opacity) {
+        return emission[previousState] != emission[currentState] || opacity[previousState] != opacity[currentState];
+    }
+
+    private void updateLightAfterBlockChange(final BlockPosition position, final int previousState, final int currentState) {
+        final int chunkX = position.x() >> 4;
+        final int chunkZ = position.z() >> 4;
+        final byte[] emission = BedrockProtocol.MAPPINGS.getJavaBlockLightEmission();
+        final byte[] opacity = BedrockProtocol.MAPPINGS.getJavaBlockOpacity();
+        final int previousEmission = emission[previousState] & 0xFF;
+        final int currentEmission = emission[currentState] & 0xFF;
+        if (opacity[previousState] != opacity[currentState] || currentEmission <= previousEmission) {
+            this.invalidateLightRegion(chunkX, chunkZ);
+            return;
+        }
+
+        // A chunk awaiting its first send or a replacement section may already have changed the
+        // region without updating its neighbors' cached light. Refresh those caches first.
+        for (int dz = -1; dz <= 1; dz++) {
+            for (int dx = -1; dx <= 1; dx++) {
+                final long key = ChunkPosition.chunkKey(chunkX + dx, chunkZ + dz);
+                if (this.dirtyChunks.contains(key) || (this.chunks.containsKey(key) && !this.chunkLight.containsKey(key))) {
+                    this.invalidateLightRegion(chunkX, chunkZ);
+                    return;
+                }
+            }
+        }
+
+        final long[] keys = new long[9];
+        final ChunkLight[] cached = new ChunkLight[9];
+        boolean hasCleanChunk = false;
+        for (int dz = -1; dz <= 1; dz++) {
+            for (int dx = -1; dx <= 1; dx++) {
+                final int index = (dz + 1) * 3 + dx + 1;
+                final long key = keys[index] = ChunkPosition.chunkKey(chunkX + dx, chunkZ + dz);
+                final ChunkLight light = this.chunkLight.get(key);
+                if (light == null) {
+                    continue;
+                }
+                this.lightVersions.merge(key, 1L, Long::sum);
+                if (this.lightDirtyChunks.contains(key) || this.pendingLightComputations.contains(key)) {
+                    this.lightDirtyChunks.add(key);
+                } else {
+                    cached[index] = light;
+                    hasCleanChunk = true;
+                }
+            }
+        }
+        if (!hasCleanChunk) {
+            return;
+        }
+
+        final ChunkLight[] updated = LightEngine.brightenBlockLight(this.snapshotRegionStates(chunkX, chunkZ),
+            this.worldHeight >> 4, position.x() & 15, position.y() - this.minY, position.z() & 15,
+            currentEmission, opacity, cached);
+        for (int i = 0; i < updated.length; i++) {
+            if (cached[i] == null || cached[i] == updated[i]) {
+                continue;
+            }
+            final long key = keys[i];
+            this.chunkLight.put(key, updated[i]);
+            final LightPacketData data = buildDiffLightPacketData(updated[i], cached[i]);
+            final ChunkPosition chunk = new ChunkPosition(key);
+            final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.LIGHT_UPDATE, this.user());
+            packet.write(Types.VAR_INT, chunk.chunkX());
+            packet.write(Types.VAR_INT, chunk.chunkZ());
+            this.writeLightData(packet, data);
+            packet.send(BedrockProtocol.class);
+        }
+    }
+
+    private void invalidateLightRegion(final int chunkX, final int chunkZ) {
+        final long chunkKey = ChunkPosition.chunkKey(chunkX, chunkZ);
+        if (this.chunkLight.containsKey(chunkKey)) {
+            this.lightVersions.merge(chunkKey, 1L, Long::sum);
+            this.lightDirtyChunks.add(chunkKey);
+        }
+        this.invalidateNearbyLight(chunkX, chunkZ);
+    }
