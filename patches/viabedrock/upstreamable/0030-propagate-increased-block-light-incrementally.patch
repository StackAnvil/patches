+package net.raphimc.viabedrock.protocol.task;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayDeque;
+import java.util.Queue;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.Executor;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ChunkTrackerTickTaskTest {
+
+    @Test
+    void delayedEventLoopCoalescesBurstsAndResumesWithoutCatchUpTicks() {
+        final ConcurrentMap<String, Object> pending = new ConcurrentHashMap<>();
+        final ManualExecutor eventLoop = new ManualExecutor();
+        final AtomicInteger ticks = new AtomicInteger();
+        for (int burst = 0; burst < 32; burst++) {
+            assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+            for (int timerTick = 0; timerTick < 1000; timerTick++) {
+                assertFalse(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+            }
+            assertEquals(1, eventLoop.tasks.size());
+            assertEquals(Set.of("player"), pending.keySet());
+            eventLoop.drain();
+            assertEquals(burst + 1, ticks.get());
+            assertTrue(pending.isEmpty());
+        }
+    }
+
+    @Test
+    void separateConnectionsProgressAndRunningCallbackRemainsReserved() {
+        final ConcurrentMap<String, Object> pending = new ConcurrentHashMap<>();
+        final ManualExecutor eventLoop = new ManualExecutor();
+        final AtomicInteger ticks = new AtomicInteger();
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "first", eventLoop, () -> {
+            assertFalse(ChunkTrackerTickTask.submitTick(pending, "first", eventLoop, ticks::incrementAndGet));
+            ticks.incrementAndGet();
+        }));
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "second", eventLoop, ticks::incrementAndGet));
+        assertEquals(2, eventLoop.tasks.size());
+        eventLoop.drain();
+        assertEquals(2, ticks.get());
+        assertTrue(pending.isEmpty());
+    }
+
+    @Test
+    void discardedTrackerOrDisconnectedCallbackReleasesTheConnection() {
+        final ConcurrentMap<String, Object> pending = new ConcurrentHashMap<>();
+        final ManualExecutor eventLoop = new ManualExecutor();
+        final AtomicBoolean current = new AtomicBoolean(true);
+        final AtomicInteger ticks = new AtomicInteger();
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, () -> {
+            if (!current.get()) {
+                return;
+            }
+            ticks.incrementAndGet();
+        }));
+        current.set(false);
+        eventLoop.drain();
+        assertEquals(0, ticks.get());
+        assertTrue(pending.isEmpty());
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+        eventLoop.drain();
+        assertEquals(1, ticks.get());
+    }
+
+    @Test
+    void rejectedExecutorAndFailedCallbackDoNotPermanentlySuppressTicks() {
+        final ConcurrentMap<String, Object> pending = new ConcurrentHashMap<>();
+        final ManualExecutor eventLoop = new ManualExecutor();
+        final Executor rejected = _ -> {
+            throw new RejectedExecutionException();
+        };
+        assertFalse(ChunkTrackerTickTask.submitTick(pending, "player", rejected, () -> { }));
+        assertTrue(pending.isEmpty());
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, () -> {
+            throw new IllegalStateException();
+        }));
+        assertThrows(IllegalStateException.class, eventLoop::drain);
+        assertTrue(pending.isEmpty());
+        final Executor failedSubmission = _ -> {
+            throw new IllegalStateException();
+        };
+        assertThrows(IllegalStateException.class,
+                () -> ChunkTrackerTickTask.submitTick(pending, "player", failedSubmission, () -> { }));
+        assertTrue(pending.isEmpty());
+        final AtomicInteger ticks = new AtomicInteger();
+        assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+        eventLoop.drain();
+        assertEquals(1, ticks.get());
+    }
+
+    @Test
+    void failedInlineExecutionRetainsReplacementReservation() {
+        final ConcurrentMap<String, Object> pending = new ConcurrentHashMap<>();
+        final ManualExecutor eventLoop = new ManualExecutor();
+        final AtomicInteger ticks = new AtomicInteger();
+        final Executor inline = callback -> {
+            try {
+                callback.run();
+            } catch (final IllegalStateException failure) {
+                assertTrue(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+                throw failure;
+            }
+        };
+        assertThrows(IllegalStateException.class, () -> ChunkTrackerTickTask.submitTick(pending, "player", inline, () -> {
+            throw new IllegalStateException();
+        }));
+        assertFalse(ChunkTrackerTickTask.submitTick(pending, "player", eventLoop, ticks::incrementAndGet));
+        assertEquals(1, eventLoop.tasks.size());
+        eventLoop.drain();
+        assertEquals(1, ticks.get());
+        assertTrue(pending.isEmpty());
+    }
+
+    private static final class ManualExecutor implements Executor {
+
+        private final Queue<Runnable> tasks = new ArrayDeque<>();
+
+        @Override
+        public void execute(final Runnable task) {
+            this.tasks.add(task);
+        }
+
+        private void drain() {
+            while (!this.tasks.isEmpty()) {
+                this.tasks.remove().run();
+            }
+        }
+
+    }
+
+}
