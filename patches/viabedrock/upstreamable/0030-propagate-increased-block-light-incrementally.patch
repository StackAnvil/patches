+    private static void applySecondaryWater(final byte[] opacity, final BitSet[][] secondaryWater) {
+        for (int chunkIndex = 0; chunkIndex < 9; chunkIndex++) {
+            final BitSet[] sections = secondaryWater[chunkIndex];
+            if (sections == null) {
+                continue;
+            }
+            final int baseX = (chunkIndex % 3) << 4;
+            final int baseZ = (chunkIndex / 3) << 4;
+            for (int sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
+                final BitSet water = sections[sectionIndex];
+                if (water == null) {
+                    continue;
+                }
+                for (int block = water.nextSetBit(0); block >= 0; block = water.nextSetBit(block + 1)) {
+                    final int y = (sectionIndex << 4) + (block >> 8);
+                    final int z = baseZ + ((block >> 4) & 15);
+                    final int x = baseX + (block & 15);
+                    final int index = (y * REGION_SIZE + z) * REGION_SIZE + x;
+                    opacity[index] = (byte) Math.max(opacity[index] & 0xFF, 1);
+                }
+            }
+        }
+    }
