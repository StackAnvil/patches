+    static <T> boolean submitTick(final ConcurrentMap<T, Object> pending, final T connection, final Executor executor, final Runnable tick) {
+        final Object reservation = new Object();
+        if (pending.putIfAbsent(connection, reservation) != null) {
+            return false;
+        }
+        try {
+            executor.execute(() -> {
+                try {
+                    tick.run();
+                } finally {
+                    pending.remove(connection, reservation);
+                }
+            });
+            return true;
+        } catch (final RejectedExecutionException _) {
+            // A channel can shut down between the timer's connection snapshot and submission.
+            pending.remove(connection, reservation);
+            return false;
+        } catch (final RuntimeException | Error failure) {
+            pending.remove(connection, reservation);
+            throw failure;
+        }
+    }
