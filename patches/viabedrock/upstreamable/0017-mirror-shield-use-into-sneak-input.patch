+    public boolean isShieldBlocking() {
+        return this.shieldBlockingHand != null;
+    }
+
+    public InteractionHand shieldBlockingHand() {
+        return this.shieldBlockingHand;
+    }
+
+    public void setShieldBlockingHand(final InteractionHand hand) {
+        this.shieldBlockingHand = hand;
+    }
+
+    public boolean isBedrockSneaking() {
+        return this.bedrockSneaking;
+    }
+
+    public void updateBedrockSneakingInput() {
+        final boolean shouldSneak = this.sneaking || this.isShieldBlocking();
+        if (shouldSneak) {
+            this.addAuthInputData(PlayerAuthInputData.SneakDown, PlayerAuthInputData.Sneaking,
+                    PlayerAuthInputData.WantDown, PlayerAuthInputData.SneakCurrentRaw);
+        }
+        if (shouldSneak != this.bedrockSneaking) {
+            this.addAuthInputData(shouldSneak ? PlayerAuthInputData.SneakPressedRaw : PlayerAuthInputData.SneakReleasedRaw,
+                    shouldSneak ? PlayerAuthInputData.StartSneaking : PlayerAuthInputData.StopSneaking);
+            this.bedrockSneaking = shouldSneak;
+        }
+    }
+
     public boolean isSprinting() {
         return this.sprinting;
     }
