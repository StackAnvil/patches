+    @Test
+    void shieldUseKeepsBedrockSneakActiveAcrossPhysicalSneakChanges() {
+        final ClientPlayerEntity player = player();
+        player.setShieldBlockingHand(InteractionHand.OFF_HAND);
+        player.updateBedrockSneakingInput();
+        assertTrue(player.isBedrockSneaking());
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.StartSneaking));
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.Sneaking));
+
+        player.authInputData().clear();
+        player.setSneaking(true);
+        player.updateBedrockSneakingInput();
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.Sneaking));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.StartSneaking));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.StopSneaking));
+
+        player.authInputData().clear();
+        player.setShieldBlockingHand(null);
+        player.updateBedrockSneakingInput();
+        assertTrue(player.isBedrockSneaking());
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.StopSneaking));
+
+        player.authInputData().clear();
+        player.setSneaking(false);
+        player.updateBedrockSneakingInput();
+        assertFalse(player.isBedrockSneaking());
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.StopSneaking));
+    }
+
+    @Test
+    void releasingShieldUseStopsBedrockSneakWithoutPhysicalCrouch() {
+        final ClientPlayerEntity player = player();
+        player.setShieldBlockingHand(InteractionHand.MAIN_HAND);
+        player.updateBedrockSneakingInput();
+        player.authInputData().clear();
+
+        player.setShieldBlockingHand(null);
+        player.updateBedrockSneakingInput();
+
+        assertFalse(player.isBedrockSneaking());
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.StopSneaking));
+        assertFalse(player.isSneaking());
+    }
+
