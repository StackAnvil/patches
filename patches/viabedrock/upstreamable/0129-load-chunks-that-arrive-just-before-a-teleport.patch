index 0000000000000000000000000000000000000000..21c5422ce46f503f0b4bb185e2002afc4305495e
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunksAheadOfCenter.java
@@ -0,0 +1,57 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
