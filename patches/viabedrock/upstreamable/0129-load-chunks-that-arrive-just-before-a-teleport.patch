--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/ChunksAheadOfCenterTest.java
@@ -0,0 +1,47 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ChunksAheadOfCenterTest {
+
+    @Test
+    void theTeleportDestinationChunkLoadsOnceTheCenterReachesIt() {
+        // DonutSMP join: the chunk at the destination precedes the teleport and its publisher update.
+        final ChunksAheadOfCenter chunks = new ChunksAheadOfCenter();
+        chunks.keep(-3665, 13985, new byte[]{1});
+        chunks.keep(0, 0, new byte[]{2});
+
+        final List<byte[]> loadable = chunks.takeLoadable((x, z) -> Math.abs(x + 3665) <= 10 && Math.abs(z - 13985) <= 10);
+
+        assertEquals(1, loadable.size());
+        assertArrayEquals(new byte[]{1}, loadable.getFirst());
+        assertTrue(chunks.takeLoadable((x, z) -> true).isEmpty(), "Chunks still out of range are not kept for later centers");
+    }
+
+    @Test
+    void keepsOnlyTheNewestCopyAndBoundsTheChunkCount() {
+        final ChunksAheadOfCenter chunks = new ChunksAheadOfCenter();
+        chunks.keep(5, 5, new byte[]{1});
+        chunks.keep(5, 5, new byte[]{2});
+        for (int index = 0; index < ChunksAheadOfCenter.MAX_CHUNKS; index++) {
+            chunks.keep(100 + index, 0, new byte[]{3});
+        }
+        assertEquals(ChunksAheadOfCenter.MAX_CHUNKS, chunks.takeLoadable((x, z) -> x >= 100).size());
+
+        chunks.keep(5, 5, new byte[]{1});
+        chunks.keep(5, 5, new byte[]{2});
+        assertArrayEquals(new byte[]{2}, chunks.takeLoadable((x, z) -> true).getFirst());
+    }
+
+}
