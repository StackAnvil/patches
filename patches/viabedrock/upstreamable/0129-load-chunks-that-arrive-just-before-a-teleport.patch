+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.ChunkPosition;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Level chunks that arrived outside the load range before the next chunk center update.
+ * A server can send the chunk at a teleport destination just before the teleport and its publisher update.
+ * DonutSMP does this on join and never sends the chunk again, so dropping it leaves the player's own chunk empty.
+ */
+final class ChunksAheadOfCenter {
+
+    /** A publisher update covers at most a few teleport destinations, so a small bound keeps stale data out. */
+    static final int MAX_CHUNKS = 64;
+
+    private final Map<Long, byte[]> packets = new LinkedHashMap<>();
+
+    void keep(final int chunkX, final int chunkZ, final byte[] packet) {
+        final long key = ChunkPosition.chunkKey(chunkX, chunkZ);
+        this.packets.remove(key); // A newer copy of the same chunk replaces the older one and becomes the newest entry.
+        this.packets.put(key, packet);
+        final Iterator<Long> oldest = this.packets.keySet().iterator();
+        while (this.packets.size() > MAX_CHUNKS) {
+            oldest.next();
+            oldest.remove();
+        }
+    }
+
+    /** Returns the kept packets now inside the load range in arrival order and forgets every kept packet. */
+    List<byte[]> takeLoadable(final LoadRange range) {
+        final List<byte[]> loadable = new ArrayList<>();
+        for (final Map.Entry<Long, byte[]> entry : this.packets.entrySet()) {
+            final ChunkPosition position = new ChunkPosition(entry.getKey());
+            if (range.contains(position.chunkX(), position.chunkZ())) {
+                loadable.add(entry.getValue());
+            }
+        }
+        this.packets.clear();
+        return loadable;
+    }
+
+    @FunctionalInterface
+    interface LoadRange {
+        boolean contains(int chunkX, int chunkZ);
+    }
+
+}
