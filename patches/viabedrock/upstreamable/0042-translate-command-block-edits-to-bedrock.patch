+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+
+public final class CommandBlockSession implements StorableObject {
+
+    private final byte containerId;
+    private final BlockPosition position;
+    private boolean closing;
+
+    public CommandBlockSession(final byte containerId, final BlockPosition position) {
+        this.containerId = containerId;
+        this.position = position;
+    }
+
+    public byte containerId() {
+        return this.containerId;
+    }
+
+    public boolean matches(final byte containerId) {
+        return this.containerId == containerId;
+    }
+
+    public boolean canEdit(final BlockPosition position) {
+        return !this.closing && this.position.equals(position);
+    }
+
+    public void beginClose() {
+        this.closing = true;
+    }
+
+}
