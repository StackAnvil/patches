+class CommandBlockEditTest {
+
+    @Test
+    void commandScreenRoundTripsOpeningAndClosingTheSameWindow() {
+        for (final boolean open : new boolean[]{true, false}) {
+            final CommandBlockOpen message = new CommandBlockOpen(open, (byte) 7,
+                    open ? new BlockPosition(-14, 96, 28) : null);
+            final var buffer = Unpooled.buffer();
+            try {
+                CommandBlockOpen.TYPE.write(buffer, message);
+                assertEquals(message, CommandBlockOpen.TYPE.read(buffer));
+            } finally {
