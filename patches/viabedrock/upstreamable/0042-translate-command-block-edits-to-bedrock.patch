+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** One complete command block edit, including Bedrock settings absent from Java's packet. */
+public record CommandBlockEdit(BlockPosition position, String command, int mode, boolean trackOutput,
+                               boolean conditional, boolean automatic, int tickDelay, boolean executeOnFirstTick) {
+
+    public static final String CHANNEL = "viabedrock:command_block_edit_v1";
+    public static final int MAX_COMMAND_LENGTH = 32500;
+    public static final Type<CommandBlockEdit> TYPE = new Type<>(CommandBlockEdit.class) {
+        @Override
+        public CommandBlockEdit read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native command block edit");
+            }
+            final var edit = new CommandBlockEdit(Types.BLOCK_POSITION1_14.read(buffer), Types.STRING.read(buffer),
+                    Types.VAR_INT.readPrimitive(buffer), buffer.readBoolean(), buffer.readBoolean(), buffer.readBoolean(),
+                    Types.VAR_INT.readPrimitive(buffer), buffer.readBoolean());
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected command block edit fields");
+            }
+            return edit;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final CommandBlockEdit edit) {
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.BLOCK_POSITION1_14.write(buffer, edit.position);
+            Types.STRING.write(buffer, edit.command);
+            Types.VAR_INT.writePrimitive(buffer, edit.mode);
+            buffer.writeBoolean(edit.trackOutput);
+            buffer.writeBoolean(edit.conditional);
+            buffer.writeBoolean(edit.automatic);
+            Types.VAR_INT.writePrimitive(buffer, edit.tickDelay);
+            buffer.writeBoolean(edit.executeOnFirstTick);
+        }
+    };
+
+    public CommandBlockEdit {
+        if (position == null || command == null || command.length() > MAX_COMMAND_LENGTH
+                || mode < 0 || mode > 2 || tickDelay < 0) {
+            throw new IllegalArgumentException("Invalid native command block edit");
+        }
+    }
+
+}
