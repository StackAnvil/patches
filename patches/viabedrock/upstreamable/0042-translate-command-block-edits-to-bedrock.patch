From 8571d72d8173cfe68804cc97d54a7667bcaa7c24 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:35 +0200
Subject: [PATCH] fix(world): translate command block edits to Bedrock

Java 26.3 edits command blocks through a dedicated serverbound packet, which ViaBedrock did not handle. Translate its mode and flags to the Bedrock 2193 update packet so closing the editor applies the change. Preserve Bedrock-only block entity settings that the Java editor cannot display.
---
 .../protocol/packet/WorldPackets.java         | 46 +++++++++++++++++++
 .../protocol/packet/WorldPacketsTest.java     | 45 ++++++++++++++++++
 2 files changed, 91 insertions(+)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
index 6c4439c7..ce2a4152 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
@@ -17,7 +17,10 @@
  */
 package net.raphimc.viabedrock.protocol.packet;
 
+import com.viaversion.nbt.tag.ByteTag;
 import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.StringTag;
 import com.viaversion.nbt.tag.Tag;
 import com.viaversion.viaversion.api.minecraft.*;
 import com.viaversion.viaversion.api.minecraft.blockentity.BlockEntity;
@@ -48,6 +51,7 @@ import net.raphimc.viabedrock.protocol.BedrockProtocol;
 import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
 import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
 import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.CommandBlockMode;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ServerboundLoadingScreenPacketType;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.SpawnPositionType;
 import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.SubChunkPacketPayload_HeightMapDataType;
@@ -602,6 +606,48 @@ public final class WorldPackets {
             wrapper.write(BedrockTypes.BLOCK_POSITION, position); // position
             wrapper.write(BedrockTypes.NETWORK_TAG, signTag.copy()); // block entity tag
         });
+        protocol.registerServerbound(ServerboundPackets26_3.SET_COMMAND_BLOCK, ServerboundBedrockPackets.COMMAND_BLOCK_UPDATE, wrapper -> {
+            final BlockPosition position = wrapper.read(Types.BLOCK_POSITION1_14);
+            final String command = wrapper.read(Types.STRING);
+            final int javaMode = wrapper.read(Types.VAR_INT);
+            final byte flags = wrapper.read(Types.BYTE);
+            final CommandBlockMode mode = commandBlockMode(javaMode);
+            if (mode == null) {
+                wrapper.cancel();
+                return;
+            }
+
+            final BedrockBlockEntity blockEntity = wrapper.user().get(ChunkTracker.class).getBlockEntity(position);
+            final CompoundTag tag = blockEntity != null ? blockEntity.tag() : new CompoundTag();
+            writeCommandBlockUpdate(wrapper, position, command, mode, (flags & 1) != 0, (flags & 2) != 0, (flags & 4) != 0, tag);
+        });
+    }
+
+    static CommandBlockMode commandBlockMode(final int javaMode) {
+        // Java 26.3 sends CommandBlockEntity.Mode in SEQUENCE, AUTO, REDSTONE order.
+        return switch (javaMode) {
+            case 0 -> CommandBlockMode.Chain;
+            case 1 -> CommandBlockMode.Repeating;
+            case 2 -> CommandBlockMode.Normal;
+            default -> null;
+        };
+    }
+
+    static void writeCommandBlockUpdate(final PacketWrapper wrapper, final BlockPosition position, final String command,
+                                        final CommandBlockMode mode, final boolean trackOutput, final boolean conditional,
+                                        final boolean automatic, final CompoundTag tag) {
+        wrapper.write(Types.BOOLEAN, true); // block target
+        wrapper.write(BedrockTypes.BLOCK_POSITION, position);
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, mode.getValue());
+        wrapper.write(Types.BOOLEAN, !automatic); // redstone mode
+        wrapper.write(Types.BOOLEAN, conditional);
+        wrapper.write(BedrockTypes.STRING, command);
+        wrapper.write(BedrockTypes.STRING, tag.get("LastOutput") instanceof StringTag value ? value.getValue() : "");
+        wrapper.write(BedrockTypes.STRING, tag.get("CustomName") instanceof StringTag value ? value.getValue() : "@");
+        wrapper.write(BedrockTypes.STRING, ""); // filtered name
+        wrapper.write(Types.BOOLEAN, trackOutput);
+        wrapper.write(BedrockTypes.INT_LE, tag.get("TickDelay") instanceof IntTag value ? value.asInt() : 0);
+        wrapper.write(Types.BOOLEAN, tag.get("ExecuteOnFirstTick") instanceof ByteTag value && value.asByte() != 0);
     }
 
     static boolean isJukebox(final int javaBlockState) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/WorldPacketsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/WorldPacketsTest.java
index 5a4904d3..70ccd5e5 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/packet/WorldPacketsTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/WorldPacketsTest.java
@@ -17,14 +17,59 @@ import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
 import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
 import io.netty.buffer.ByteBuf;
 import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.CommandBlockMode;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
 import org.junit.jupiter.api.Test;
 
 import java.util.List;
 
 import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
 
 class WorldPacketsTest {
 
+    @Test
+    void writesCommandBlockModeAndPreservesBedrockOnlySettings() throws Exception {
+        final CompoundTag tag = new CompoundTag();
+        tag.putString("CustomName", "Runner");
+        tag.putString("LastOutput", "done");
+        tag.putInt("TickDelay", 8);
+        tag.putByte("ExecuteOnFirstTick", (byte) 1);
+        final BlockPosition position = new BlockPosition(4, 70, -6);
+        final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundBedrockPackets.COMMAND_BLOCK_UPDATE, null, null);
+        WorldPackets.writeCommandBlockUpdate(wrapper, position, "say test", WorldPackets.commandBlockMode(0),
+                true, true, false, tag);
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ServerboundBedrockPackets.COMMAND_BLOCK_UPDATE.getId(), Types.VAR_INT.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertEquals(position, BedrockTypes.BLOCK_POSITION.read(buffer));
+            assertEquals(CommandBlockMode.Chain.getValue(), BedrockTypes.UNSIGNED_VAR_INT.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertEquals("say test", BedrockTypes.STRING.read(buffer));
+            assertEquals("done", BedrockTypes.STRING.read(buffer));
+            assertEquals("Runner", BedrockTypes.STRING.read(buffer));
+            assertEquals("", BedrockTypes.STRING.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertEquals(8, BedrockTypes.INT_LE.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void mapsJavaCommandBlockModeOrderToBedrock() {
+        assertEquals(CommandBlockMode.Chain, WorldPackets.commandBlockMode(0));
+        assertEquals(CommandBlockMode.Repeating, WorldPackets.commandBlockMode(1));
+        assertEquals(CommandBlockMode.Normal, WorldPackets.commandBlockMode(2));
+    }
+
     @Test
     void packsNegativeSectionHeightWithItsFullSignedWidth() {
         final long packed = WorldPackets.packSectionPosition(new BlockPosition(-12, -4, 34));
