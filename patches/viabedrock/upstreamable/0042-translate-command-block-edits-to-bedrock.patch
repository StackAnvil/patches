+    static boolean openNativeCommandBlock(final UserConnection user, final byte containerId,
+                                          final BedrockBlockEntity block) {
+        if (block == null || !"CommandBlock".equals(block.tag().getString("id"))
+                || !user.get(EntityTracker.class).getClientPlayer().abilities().getBooleanValue(AbilitiesIndex.OperatorCommands)
+                || !user.get(ChannelStorage.class).hasChannel(CommandBlockOpen.CHANNEL)) {
+            return false;
+        }
+        final ChunkTracker chunks = user.get(ChunkTracker.class);
+        final var javaBlock = BlockEntityRewriter.toJava(user, chunks.getBlockState(block.position()), block);
+        if (javaBlock == null || javaBlock.tag() == null) {
+            return false;
+        }
+        PacketFactory.sendJavaBlockEntityData(user, block.position(), javaBlock);
+        user.put(new CommandBlockSession(containerId, block.position()));
+        sendNativeCommandScreen(user, new CommandBlockOpen(true, containerId, block.position()));
+        return true;
+    }
+
+    static void sendNativeCommandScreen(final UserConnection user, final CommandBlockOpen message) {
+        final var screen = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        screen.write(Types.STRING, CommandBlockOpen.CHANNEL);
+        screen.write(CommandBlockOpen.TYPE, message);
+        screen.send(BedrockProtocol.class);
+    }
+
+    static void handleNativeCommandBlockEdit(final UserConnection user,
+                                            final CommandBlockEdit edit) {
+        final BedrockBlockEntity block = user.get(ChunkTracker.class).getBlockEntity(edit.position());
+        if (block == null || !"CommandBlock".equals(block.tag().getString("id"))
+                || !user.get(EntityTracker.class).getClientPlayer().abilities().getBooleanValue(AbilitiesIndex.OperatorCommands)) {
+            return;
+        }
+        final CommandBlockSession session = user.get(CommandBlockSession.class);
+        if (session != null && !session.canEdit(edit.position())) {
+            return;
+        }
+        final CompoundTag tag = block.tag().copy();
+        tag.putInt("TickDelay", edit.tickDelay());
+        tag.putByte("ExecuteOnFirstTick", (byte) (edit.executeOnFirstTick() ? 1 : 0));
+        final var update = PacketWrapper.create(ServerboundBedrockPackets.COMMAND_BLOCK_UPDATE, user);
+        writeCommandBlockUpdate(update, edit.position(), edit.command(), commandBlockMode(edit.mode()),
+                edit.trackOutput(), edit.conditional(), edit.automatic(), tag);
+        update.sendToServer(BedrockProtocol.class);
+    }
+
+    static CommandBlockMode commandBlockMode(final int javaMode) {
+        // Java 26.3 sends CommandBlockEntity.Mode in SEQUENCE, AUTO, REDSTONE order.
+        return switch (javaMode) {
+            case 0 -> CommandBlockMode.Chain;
+            case 1 -> CommandBlockMode.Repeating;
+            case 2 -> CommandBlockMode.Normal;
+            default -> null;
+        };
+    }
+
+    static void writeCommandBlockUpdate(final PacketWrapper wrapper, final BlockPosition position, final String command,
+                                        final CommandBlockMode mode, final boolean trackOutput, final boolean conditional,
+                                        final boolean automatic, final CompoundTag tag) {
+        wrapper.write(Types.BOOLEAN, true); // block target
+        wrapper.write(BedrockTypes.BLOCK_POSITION, position);
+        wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, mode.getValue());
+        wrapper.write(Types.BOOLEAN, !automatic); // redstone mode
+        wrapper.write(Types.BOOLEAN, conditional);
+        wrapper.write(BedrockTypes.STRING, command);
+        wrapper.write(BedrockTypes.STRING, tag.get("LastOutput") instanceof StringTag value ? value.getValue() : "");
+        wrapper.write(BedrockTypes.STRING, tag.get("CustomName") instanceof StringTag value ? value.getValue() : "@");
+        wrapper.write(BedrockTypes.STRING, ""); // filtered name
+        wrapper.write(Types.BOOLEAN, trackOutput);
+        wrapper.write(BedrockTypes.INT_LE, tag.get("TickDelay") instanceof IntTag value ? value.asInt() : 0);
+        wrapper.write(Types.BOOLEAN, tag.get("ExecuteOnFirstTick") instanceof ByteTag value && value.asByte() != 0);
     }
 
