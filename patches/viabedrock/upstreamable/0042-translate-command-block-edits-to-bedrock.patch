+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+public record CommandBlockOpen(boolean open, byte containerId, BlockPosition position) {
+
+    public static final String CHANNEL = "viabedrock:command_block_open_v1";
+    public static final Type<CommandBlockOpen> TYPE = new Type<>(CommandBlockOpen.class) {
+        @Override
+        public CommandBlockOpen read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported command block screen");
+            }
+            final boolean open = buffer.readBoolean();
+            final byte id = buffer.readByte();
+            final BlockPosition position = open ? Types.BLOCK_POSITION1_14.read(buffer) : null;
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected command screen fields");
+            }
+            return new CommandBlockOpen(open, id, position);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final CommandBlockOpen message) {
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeBoolean(message.open);
+            buffer.writeByte(message.containerId);
+            if (message.open) {
+                Types.BLOCK_POSITION1_14.write(buffer, message.position);
+            }
+        }
+    };
+
+    public CommandBlockOpen {
+        if (open != (position != null)) {
+            throw new IllegalArgumentException("Invalid command block screen position");
+        }
+    }
+
+}
