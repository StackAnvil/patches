+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class ControlledVehicleSpatialTest {
+
+    private static final Position3f LIVE = new Position3f(100, 200, 300);
+    private static final Position3f RECEIVED = new Position3f(10.25F, 20.5F, 30.75F);
+
+    @Test
+    void bothPacketFormsRetainButIgnoreUnforcedLocalVehicleTransforms() throws Exception {
+        try (var packets = mockStatic(PacketFactory.class)) {
+            for (boolean horse : new boolean[]{false, true}) {
+                for (boolean delta : new boolean[]{false, true}) {
+                    for (int flags = 0; flags < 16; flags++) {
+                        final var context = new Context(horse);
+                        context.horseFlags(true, true);
+                        context.vehicle.addPassenger(context.local.uniqueId());
+                        final boolean ignored = context.translate(delta, flags);
+                        assertEquals((flags & 6) == 0, ignored);
+                        assertEquals(RECEIVED, context.vehicle.lastReceivedPosition());
+                        assertEquals((short) (delta ? flags | 0xF0 : flags), context.vehicle.lastReceivedMovementFlags());
+                        assertEquals(delta ? Long.MIN_VALUE : 0, context.vehicle.lastReceivedInterpolationTicks());
+                        assertEquals(ignored ? LIVE : RECEIVED, context.vehicle.position());
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void controlFollowsTheFirstPassengerAndRequiresBothNativeHorseFlags() {
+        for (boolean horse : new boolean[]{false, true}) {
+            for (boolean tamed : new boolean[]{false, true}) {
+                for (boolean saddled : new boolean[]{false, true}) {
+                    final var context = new Context(horse);
+                    context.horseFlags(tamed, saddled);
+                    assertFalse(context.tracker.isLocallyControlledVehicle(context.vehicle));
+                    context.vehicle.addPassenger(context.remote.uniqueId());
+                    context.vehicle.addPassenger(context.local.uniqueId());
+                    assertFalse(context.tracker.isLocallyControlledVehicle(context.vehicle));
+                    context.vehicle.addPrimaryPassenger(context.local.uniqueId());
+                    assertEquals(!horse || tamed && saddled, context.tracker.isLocallyControlledVehicle(context.vehicle));
+                    context.vehicle.removePassenger(context.local.uniqueId());
+                    assertFalse(context.tracker.isLocallyControlledVehicle(context.vehicle));
+                }
+            }
+        }
+    }
+
+    @Test
+    void aStaleControllerRuntimeIdentityCannotSuppressAnIncomingTransform() throws Exception {
+        final var context = new Context(false);
+        context.vehicle.addPassenger(context.local.uniqueId());
+        assertTrue(context.tracker.isLocallyControlledVehicle(context.vehicle));
+        final long controllerRuntimeId = context.local.runtimeId();
+        doReturn(null).when(context.tracker).getEntityByRid(controllerRuntimeId);
+        assertFalse(context.tracker.isLocallyControlledVehicle(context.vehicle));
+        try (var packets = mockStatic(PacketFactory.class)) {
+            assertFalse(context.translate(true, 0));
+            assertEquals(RECEIVED, context.vehicle.position());
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_VEHICLE_CONTROL", matches = ".+")
+    void matchesOriginalNativeVehicleControlForRepresentablePlayerMembership() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_VEHICLE_CONTROL")))).getAsJsonObject();
+        for (var value : reference.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            if (!row.get("player").getAsString().equals("present") || row.get("localPlayer").getAsString().equals("stale")) {
+                continue;
+            }
+            final var context = new Context(row.get("kind").getAsString().equals("horse"));
+            context.horseFlags(row.get("tamed").getAsBoolean(), row.get("saddled").getAsBoolean());
+            final boolean localFirst = row.get("localPlayer").getAsString().equals("present") && row.get("localSeat").getAsInt() == 0;
+            if (row.get("controllerCount").getAsInt() > 0) {
+                context.vehicle.addPassenger(localFirst ? context.local.uniqueId() : context.remote.uniqueId());
+            }
+            if (row.get("controllerCount").getAsInt() > 1) {
+                context.vehicle.addPassenger(localFirst ? context.remote.uniqueId() : context.local.uniqueId());
+            }
+            assertEquals(row.get("controlled").getAsBoolean(), context.tracker.isLocallyControlledVehicle(context.vehicle));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_SPATIAL_CONTROL", matches = ".+")
+    void registeredPacketsMatchTheOriginalNativeCacheAndControlAdmissionGate() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_SPATIAL_CONTROL")))).getAsJsonObject();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            for (var value : reference.getAsJsonArray("rows")) {
+                final var row = value.getAsJsonObject();
+                for (boolean delta : new boolean[]{false, true}) {
+                    final var context = new Context(false, Long.parseUnsignedLong(row.get("runtimeId").getAsString()));
+                    final String mode = row.get("controlMode").getAsString();
+                    if (!mode.equals("absent")) {
+                        context.vehicle.addPassenger(context.local.uniqueId());
+                    }
+                    if (mode.equals("stale")) {
+                        final long runtimeId = context.local.runtimeId();
+                        doReturn(null).when(context.tracker).getEntityByRid(runtimeId);
+                    } else if (mode.equals("missingPage") || mode.equals("emptyRange")) {
+                        final long uniqueId = context.local.uniqueId();
+                        doReturn(null).when(context.tracker).getEntityByUid(uniqueId);
+                    }
+                    final boolean ignored = context.translate(delta, row.get("flags").getAsInt());
+                    assertEquals(!row.get("acceptedTransform").getAsBoolean(), ignored);
+                    assertEquals(RECEIVED, context.vehicle.lastReceivedPosition());
+                    assertEquals(ignored ? LIVE : RECEIVED, context.vehicle.position());
+                }
+            }
+        }
+    }
+
+    private static final class Context {
+        private final UserConnection user = mock(UserConnection.class);
+        private final EntityTracker tracker = spy(new EntityTracker(this.user));
+        private final ClientPlayerEntity local = mock(ClientPlayerEntity.class);
+        private final PlayerEntity remote = mock(PlayerEntity.class);
+        private final Entity vehicle;
+        private final TestProtocol protocol = new TestProtocol();
+
+        private Context(final boolean horse) {
+            this(horse, 0x100000002L);
+        }
+
+        private Context(final boolean horse, final long runtimeId) {
+            when(this.local.uniqueId()).thenReturn(1L);
+            when(this.local.runtimeId()).thenReturn(101L);
+            when(this.local.javaId()).thenReturn(1);
+            when(this.remote.uniqueId()).thenReturn(2L);
+            when(this.remote.runtimeId()).thenReturn(102L);
+            when(this.remote.javaId()).thenReturn(2);
+            this.vehicle = horse
+                    ? new AbstractHorseEntity(this.user, 21, runtimeId, "minecraft:horse", 301, UUID.randomUUID(), EntityTypes26_3.HORSE)
+                    : new BoatEntity(this.user, 21, runtimeId, "minecraft:boat", 301, UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+            this.tracker.addEntity(this.local, false);
+            this.tracker.addEntity(this.remote, false);
+            this.tracker.addEntity(this.vehicle, false);
+            when(this.user.get(EntityTracker.class)).thenReturn(this.tracker);
+            this.vehicle.setPosition(LIVE);
+        }
+
+        private void horseFlags(final boolean tamed, final boolean saddled) {
+            this.vehicle.entityData().put(ActorDataIds.RESERVED_0, new EntityData(0, EntityDataTypesBedrock.LONG,
+                    (tamed ? 1L << 28 : 0) | (saddled ? 1L << 8 : 0)));
+        }
+
+        private boolean translate(final boolean delta, final int flags) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(input, this.vehicle.runtimeId());
+                if (delta) {
+                    for (float coordinate : new float[]{RECEIVED.x(), RECEIVED.y(), RECEIVED.z()}) {
+                        input.writeBoolean(true);
+                        BedrockTypes.FLOAT_LE.write(input, coordinate);
+                    }
+                    for (int angle : new int[]{12, 20, 30}) {
+                        input.writeBoolean(true);
+                        input.writeByte(angle);
+                    }
+                    for (int bit = 0; bit < 4; bit++) {
+                        input.writeBoolean((flags & 1 << bit) != 0);
+                    }
+                    BedrockTypes.UNSIGNED_VAR_LONG.write(input, Long.MIN_VALUE);
+                } else {
+                    input.writeByte(flags);
+                    BedrockTypes.POSITION_3F.write(input, RECEIVED);
+                    input.writeBytes(new byte[]{12, 20, 30});
+                }
+                final var wrapper = new PacketWrapperImpl(delta ? ClientboundBedrockPackets.MOVE_ENTITY_DELTA
+                        : ClientboundBedrockPackets.MOVE_ENTITY_ABSOLUTE, input, this.user);
+                this.protocol.translate(wrapper);
+                assertFalse(input.isReadable());
+                return wrapper.isCancelled();
+            } finally {
+                input.release();
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            EntityPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
