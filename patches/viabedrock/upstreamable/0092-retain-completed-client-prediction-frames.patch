@@ -0,0 +1,131 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class GeyserMovementTest {
+
+    private static final GeyserMovement.Cell AIR = new GeyserMovement.Cell(false, false, false, false, false);
+    private static final GeyserMovement.Cell SULFUR = new GeyserMovement.Cell(true, true, false, false, false);
+    private static final GeyserMovement.Cell WATER = new GeyserMovement.Cell(false, false, true, false, true);
+
+    @Test
+    void admitsActorOverlapWithinEachNativeProfileWithoutRequiringItsCenterInside() {
+        for (int depth = 1; depth <= 4; depth++) {
+            final var column = column(depth);
+            final GeyserMovement.BlockAccess blocks = (x, y, z) -> column.getOrDefault(y, AIR);
+            final float top = depth * 6F;
+            assertTrue(GeyserMovement.admits(new Position3f(-0.5F, Math.nextDown(top), -0.5F),
+                    new Position3f(0.1F, top + 1.8F, 0.1F), 0, 0, 0, blocks));
+            assertFalse(GeyserMovement.admits(new Position3f(0F, top, 0F),
+                    new Position3f(0.6F, top + 1.8F, 0.6F), 0, 0, 0, blocks));
+            for (final Position3f minimum : new Position3f[]{new Position3f(1F, 1F, 0F), new Position3f(0F, 1F, 1F)}) {
+                assertFalse(GeyserMovement.admits(minimum, new Position3f(minimum.x() + 0.6F, 2.8F, minimum.z() + 0.6F),
+                        0, 0, 0, blocks));
+            }
+            column.put(depth + 1, WATER);
+            if (depth == 4) {
+                assertFalse(GeyserMovement.admits(new Position3f(0F, 1F, 0F),
+                        new Position3f(0.6F, 2.8F, 0.6F), 0, 0, 0, blocks));
+            }
+            column.put(0, AIR);
+            assertFalse(GeyserMovement.admits(new Position3f(0F, 1F, 0F),
+                    new Position3f(0.6F, 2.8F, 0.6F), 0, 0, 0, blocks));
+        }
+    }
+
+    @Test
+    void selectsEveryProfileAndChecksTheCapBeforeAddingLift() {
+        final float[] caps = {0.4F, 0.5F, 0.6F, 0.7F};
+        for (int depth = 1; depth <= 4; depth++) {
+            final Map<Integer, GeyserMovement.Cell> column = column(depth);
+            final float cap = caps[depth - 1];
+            assertEquals(cap, calculate(depth + 1.25F, cap, column));
+            assertEquals(Float.floatToRawIntBits(Math.nextDown(cap) + 0.2F),
+                    Float.floatToRawIntBits(calculate(depth + 1.25F, Math.nextDown(cap), column)));
+            assertEquals(0.2F, calculate(depth * 6 + 0.99999F, 0F, column));
+            assertEquals(0F, calculate(depth * 6 + 1F, 0F, column));
+        }
+    }
+
+    @Test
+    void rejectsSourceLiquidAndCollisionAboveTheWaterButAcceptsFlowingLiquid() {
+        final Map<Integer, GeyserMovement.Cell> column = column(4);
+        for (final GeyserMovement.Cell top : new GeyserMovement.Cell[]{
+            WATER, new GeyserMovement.Cell(false, false, false, false, true),
+            new GeyserMovement.Cell(true, false, false, false, false)}) {
+            column.put(5, top);
+            assertEquals(0F, calculate(6F, 0F, column));
+        }
+        column.put(5, AIR);
+        assertEquals(0.2F, calculate(6F, 0F, column));
+        column.put(2, AIR);
+        column.put(3, WATER);
+        // Only the immediately contiguous water column participates.
+        assertEquals(0.2F, calculate(4F, 0F, column));
+    }
+
+    @Test
+    void extraLayerWaterRequiresAnEmptyMainCollisionBox() {
+        final Map<Integer, GeyserMovement.Cell> column = column(1);
+        column.put(1, new GeyserMovement.Cell(false, false, false, true, true));
+        assertEquals(0.2F, calculate(2F, 0F, column));
+        column.put(1, new GeyserMovement.Cell(true, false, false, true, true));
+        assertEquals(0F, calculate(2F, 0F, column));
+    }
+
+    @Test
+    void preservesAdmissionAndUsesFloatCenterAtNegativeCoordinates() {
+        final Position3f min = new Position3f(-0.75F, -31.75F, -0.75F);
+        final Position3f max = new Position3f(-0.15F, -29.95F, -0.15F);
+        final Map<Integer, GeyserMovement.Cell> column = column(1);
+        final GeyserMovement.BlockAccess blocks = (x, y, z) -> {
+            assertEquals(-1, x);
+            assertEquals(-1, z);
+            return column.getOrDefault(y + 33, AIR);
+        };
+        assertEquals(0.2F, GeyserMovement.calculate(min, max, 0F, true, false, blocks));
+        final GeyserMovement.BlockAccess unexpected = (x, y, z) -> {
+            throw new AssertionError();
+        };
+        assertEquals(-0F, GeyserMovement.calculate(min, max, -0F, false, false, unexpected));
+        assertEquals(0.3F, GeyserMovement.calculate(min, max, 0.3F, true, true, unexpected));
+    }
+
+    @Test
+    void retainsTheTerminalCandidateAndStopsAtTheFirstCollision() {
+        final Map<Integer, GeyserMovement.Cell> column = column(4);
+        assertEquals(0.2F, calculate(24F, 0F, column));
+        assertEquals(0F, calculate(25F, 0F, column));
+        column.put(8, new GeyserMovement.Cell(true, false, false, false, false));
+        assertEquals(0F, calculate(24F, 0F, column));
+        column.remove(8);
+        column.put(0, new GeyserMovement.Cell(true, false, false, false, false));
+        assertEquals(0F, calculate(24F, 0F, column));
+    }
+
+    private static float calculate(final float bottom, final float velocity, final Map<Integer, GeyserMovement.Cell> column) {
+        return GeyserMovement.calculate(new Position3f(0F, bottom, 0F), new Position3f(0.6F, bottom + 1.8F, 0.6F),
+                velocity, true, false, (x, y, z) -> column.getOrDefault(y, AIR));
+    }
+
+    private static Map<Integer, GeyserMovement.Cell> column(final int depth) {
+        final Map<Integer, GeyserMovement.Cell> result = new HashMap<>();
+        result.put(0, SULFUR);
+        for (int y = 1; y <= depth; y++) {
+            result.put(y, WATER);
+        }
+        return result;
+    }
+
+}
