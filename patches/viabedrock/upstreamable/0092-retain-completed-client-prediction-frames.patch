+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** The authoritative underwater attribute, which has no equivalent Java attribute. */
+public record UnderwaterMovementAttribute(int entityId, float speed) {
+
+    public static final String CHANNEL = "viabedrock:underwater_movement";
+    public static final Type<UnderwaterMovementAttribute> TYPE = new Type<>(UnderwaterMovementAttribute.class) {
+        @Override
+        public UnderwaterMovementAttribute read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported underwater movement attribute");
+            }
+            return new UnderwaterMovementAttribute(Types.VAR_INT.readPrimitive(buffer), Types.FLOAT.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final UnderwaterMovementAttribute attribute) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
