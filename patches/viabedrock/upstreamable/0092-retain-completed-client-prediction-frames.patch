+/** Optional mount physics; neither its watermark nor the player clock resets on correction. */
+public final class VehiclePredictionStorage extends StoredObject {
+
+    private Entity vehicle;
+    private VehiclePredictionContext context = new VehiclePredictionContext(0, null);
+    private VehiclePredictionContext published;
+    private VehiclePrediction pending;
+    private long lastFrame = -1;
+    private boolean exhausted;
+
+    public VehiclePredictionStorage(final UserConnection user) {
+        super(user);
+    }
+
+    public boolean enabled() {
+        final ChannelStorage channels = this.user().get(ChannelStorage.class);
+        final EntityTracker tracker = this.user().get(EntityTracker.class);
+        return this.user().getProtocolInfo().getClientState() == State.PLAY
+                && this.user().getProtocolInfo().getServerState() == State.PLAY
+                && tracker != null && tracker.nativeActorsJoined()
+                && channels != null && channels.hasChannel(VehiclePredictionContext.CHANNEL)
+                && channels.hasChannel(NativeActorMessage.CURRENT_CHANNEL) && channels.hasChannel(PlayerInputPermissions.CHANNEL);
+    }
+
+    public VehiclePredictionContext context() {
+        return this.context;
+    }
+
+    public void refresh() {
+        this.refresh(false);
+    }
+
+    /** Authority changes invalidate even a frame whose position remains within the matching tolerance. */
+    public void invalidate(final Entity entity) {
+        if (entity == this.vehicle || entity instanceof ClientPlayerEntity) {
+            this.refresh(true);
+        }
+    }
+
+    public void sendSnapshot() {
+        this.published = null;
+        this.refresh();
+    }
+
+    private void refresh(final boolean invalidate) {
+        final Entity current = this.eligibleVehicle();
+        if (current != this.vehicle || invalidate) {
+            this.pending = null;
+            if (this.context.epoch() == Long.MAX_VALUE) {
+                this.exhausted = true;
+            }
+            this.vehicle = this.exhausted ? null : current;
+            final long epoch = this.exhausted ? Long.MAX_VALUE : this.context.epoch() + 1;
+            final var snapshot = this.vehicle != null ? this.vehicle.nativeActorSnapshot() : null;
+            this.context = new VehiclePredictionContext(epoch, snapshot == null ? null : new VehiclePredictionContext.Identity(
+                    this.vehicle.javaId(), this.vehicle.javaUuid(), snapshot.lifetime(), this.vehicle.runtimeId(), this.vehicle.uniqueId()));
+        }
+        if (this.enabled() && !this.context.equals(this.published)) {
+            final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+            packet.write(Types.STRING, VehiclePredictionContext.CHANNEL);
+            packet.write(VehiclePredictionContext.TYPE, this.context);
+            packet.send(BedrockProtocol.class);
+            this.published = this.context;
+        }
+        if (!this.enabled()) {
+            this.published = null;
+        }
+    }
+
+    private Entity eligibleVehicle() {
+        final EntityTracker tracker = this.user().get(EntityTracker.class);
+        final ClientPlayerEntity player = tracker != null ? tracker.getClientPlayer() : null;
+        if (!this.enabled() || this.exhausted || player == null || player.position() == null || !player.isInitiallySpawned() || player.isDead()
+                || player.dimensionChangeInfo() != null || !player.canReportVehiclePrediction()
+                || player.javaGameMode() == GameMode.SPECTATOR
+                || this.user().get(ChunkTracker.class).isInUnloadedChunkSection(player.position())) {
+            return null;
+        }
+        final Entity candidate = tracker.getEntityByRid(player.mountEntityRuntimeId());
+        if (candidate == null || candidate.position() == null || tracker.getEntityByUid(candidate.uniqueId()) != candidate || candidate.mountEntityRuntimeId() != -1
+                || candidate.passengers().isEmpty() || candidate.passengers().getFirst() != player.uniqueId()
+                || !(candidate.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_BOAT)
+                || candidate.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_HORSE))) {
+            return null;
+        }
+        if (candidate instanceof LivingEntity living && living.isDead()
+                || candidate.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_HORSE)
+                && !(candidate.entityFlags().contains(ActorFlags.TAMED) && candidate.entityFlags().contains(ActorFlags.SADDLED))) {
+            return null;
+        }
+        return this.user().get(ChunkTracker.class).isInUnloadedChunkSection(candidate.position()) ? null : candidate;
+    }
+
+    public void record(final VehiclePrediction prediction) {
+        this.refresh();
+        if (this.vehicle == null || !prediction.context().equals(this.context) || prediction.frameId() <= this.lastFrame) {
+            return;
+        }
+        this.lastFrame = prediction.frameId();
+        this.pending = prediction;
+    }
+
+    public void discardPending() {
+        this.pending = null;
+    }
+
+    public VehiclePrediction take(final Entity vehicle, final PlayerPrediction playerFrame) {
+        this.refresh();
+        final VehiclePrediction frame = this.pending;
+        this.pending = null;
+        if (frame == null || playerFrame == null || frame.frameId() != playerFrame.frameId()
+                || vehicle != this.vehicle || !frame.context().equals(this.context) || !frame.matches(vehicle.javaPosition())) {
+            return null;
+        }
+        final ChunkTracker chunks = this.user().get(ChunkTracker.class);
+        if (chunks.isInUnloadedChunkSection(vehicle.position())
+                || chunks.isInUnloadedChunkSection(frame.position().add(0F, vehicle.eyeOffset(), 0F))) {
+            return null;
+        }
+        return frame;
+    }
+
+}
