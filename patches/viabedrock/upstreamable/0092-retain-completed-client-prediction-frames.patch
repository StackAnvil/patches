+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+/** Connection-scoped pairing for a correction payload followed by its standard Java position packet. */
+public final class PlayerCorrectionTracker {
+
+    private PlayerCorrection pending;
+
+    public void accept(final PlayerCorrection correction) {
+        this.pending = correction;
+    }
+
+    public PlayerCorrection consume(final int entityId, final int teleportId) {
+        final PlayerCorrection correction = this.pending;
+        this.clear();
+        return correction != null && correction.entityId() == entityId && correction.teleportId() == teleportId ? correction : null;
+    }
+
+    public void clear() {
+        this.pending = null;
+    }
+
+}
