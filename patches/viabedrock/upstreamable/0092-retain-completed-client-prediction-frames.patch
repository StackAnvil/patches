+        try (var factory = mockStatic(PacketWrapper.class)) {
+            factory.when(() -> PacketWrapper.create(any(PacketType.class), eq(user))).thenAnswer(call -> {
+                final var packet = spy(new PacketWrapperImpl(call.getArgument(0), null, user));
+                doAnswer(_ -> {
+                    final var bytes = Unpooled.buffer();
+                    try {
+                        packet.writeToBuffer(bytes);
+                        assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD.getId(), Types.VAR_INT.readPrimitive(bytes));
+                        final String channel = Types.STRING.read(bytes);
+                        selected.add(channel);
+                        messages.add((channel.equals(NativeActorMessage.CURRENT_CHANNEL)
+                                ? NativeActorMessage.CURRENT_TYPE : NativeActorMessage.TYPE).read(bytes));
+                        assertFalse(bytes.isReadable());
+                    } finally {
+                        bytes.release();
+                    }
+                    return null;
+                }).when(packet).send(eq(BedrockProtocol.class), eq(true));
+                return packet;
+            });
+            actor.sendNativeActorSnapshot();
+            assertTrue(messages.isEmpty());
+            capability(user, "minecraft:register", NativeActorMessage.CHANNEL);
+            actor.sendNativeActorSnapshot();
+            assertEquals(1, messages.size());
+            assertNull(((NativeActorMessage.Snapshot) messages.getFirst()).uniqueId());
+            capability(user, "minecraft:register", NativeActorMessage.CURRENT_CHANNEL);
+            actor.sendNativeActorSnapshot();
+            assertEquals(2, messages.size());
+            assertEquals(-170L, ((NativeActorMessage.Snapshot) messages.getLast()).uniqueId());
+            capability(user, "minecraft:unregister", NativeActorMessage.CURRENT_CHANNEL);
+            assertFalse(channels.hasChannel(NativeActorMessage.CURRENT_CHANNEL));
+            assertEquals(3, messages.size());
+            assertNull(((NativeActorMessage.Snapshot) messages.getLast()).uniqueId());
+            capability(user, "minecraft:register", NativeActorMessage.CURRENT_CHANNEL);
+            assertEquals(4, messages.size());
+            capability(user, "minecraft:unregister", NativeActorMessage.CURRENT_CHANNEL);
+            capability(user, "minecraft:unregister", NativeActorMessage.CHANNEL);
+            assertEquals(5, messages.size());
+            capability(user, "minecraft:register", NativeActorMessage.CURRENT_CHANNEL);
+            assertEquals(6, messages.size());
+            actor.remove();
+            assertInstanceOf(NativeActorMessage.Remove.class, messages.getLast());
+            assertEquals(List.of(NativeActorMessage.CHANNEL, NativeActorMessage.CURRENT_CHANNEL,
+                    NativeActorMessage.CHANNEL, NativeActorMessage.CURRENT_CHANNEL, NativeActorMessage.CHANNEL,
+                    NativeActorMessage.CURRENT_CHANNEL, NativeActorMessage.CURRENT_CHANNEL), selected);
+            assertEquals(messages.getFirst().lifetime(), messages.getLast().lifetime());
+        }
+    }
+
+    private static void capability(final UserConnection user, final String channel, final String capability) throws Exception {
+        final var bytes = Unpooled.buffer();
+        try {
+            Types.STRING.write(bytes, channel);
+            bytes.writeBytes(capability.getBytes(StandardCharsets.UTF_8));
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, bytes, user);
+            MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(bytes.isReadable());
+        } finally {
+            bytes.release();
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/entity/UnderwaterMovementTransportTest.java b/src/test/java/net/raphimc/viabedrock/api/model/entity/UnderwaterMovementTransportTest.java
new file mode 100644
index 000000000..ea6a17119
--- /dev/null
