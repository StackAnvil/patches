+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.MovementEffectType;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class MovementEffectPhysicsStateTest {
+
+    @Test
+    void keepsOwnedValuesAcrossLiveMutationAndRepeatedRestoration() {
+        final var timeline = new MovementEffectTimeline();
+        timeline.beginFrame();
+        timeline.predictGeyserBoost(1);
+        timeline.completeFrame();
+        final var saved = timeline.captureValues(1);
+        timeline.accept(new MovementEffect(1, MovementEffectType.GEYSER_BOOST.getValue(), 0, 5, 0, 5, 0, 5));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.restoreValues(1, saved);
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, MovementEffectType.GEYSER_BOOST.getValue(), 0, 6, 0, 6, 0, 5));
+        timeline.restoreValues(1, saved);
+        assertEquals(saved, timeline.captureValues(1));
+        assertTrue(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void appliesHistoricalCommandsBeforeTheirPhysicalInputAndKeepsTheLiveClock() {
+        final var timeline = new MovementEffectTimeline();
+        final var empty = timeline.captureValues(1);
+        for (int frame = 0; frame < 3; frame++) {
+            timeline.beginFrame();
+            timeline.completeFrame();
+        }
+        timeline.accept(new MovementEffect(1, MovementEffectType.GEYSER_BOOST.getValue(), 3, 100, 0, 102, 2, 100));
+        assertEquals(1, timeline.pendingPhysicalFrame(id -> id == 1));
+        timeline.restoreValues(1, empty);
+        timeline.applyPhysicalCommands(1, id -> id == 1);
+        assertTrue(timeline.hasGeyserBoost(1, 0));
+        assertTrue(timeline.hasGeyserBoost(1, 2));
+        assertFalse(timeline.hasGeyserBoost(1, 3));
+        assertEquals(3, timeline.frameId());
+        timeline.finishPhysicalReplay(id -> id == 1);
+        assertEquals(-1, timeline.pendingPhysicalFrame(id -> id == 1));
+    }
+
+    @Test
+    void reevaluatesLocalAdmissionAtTheHistoricalClockWithoutRewindingAnotherActor() {
+        final var timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 8; frame++) {
+            timeline.beginFrame();
+            timeline.completeFrame();
+        }
+        timeline.predictGeyserBoost(1, 2);
+        timeline.predictGeyserBoost(2, 8);
+        assertTrue(timeline.hasGeyserBoost(1, 100));
+        assertFalse(timeline.hasGeyserBoost(1, 101));
+        assertTrue(timeline.hasGeyserBoost(2, 101));
+        assertEquals(8, timeline.frameId());
+    }
+
+    @Test
+    void replacesPlayStateWithoutReusingCompletedConnectionFrames() {
+        final var timeline = new MovementEffectTimeline();
+        timeline.beginFrame();
+        timeline.predictGeyserBoost(1);
+        timeline.completeFrame();
+        timeline.beginFrame();
+        timeline.resetHistory();
+        assertEquals(1, timeline.frameId());
+        assertFalse(timeline.hasGeyserBoost(1));
+        assertEquals(-1, timeline.pendingPhysicalFrame(id -> true));
+        timeline.beginFrame();
+        assertEquals(1, timeline.completeFrame());
+        timeline.clear();
+        assertEquals(0, timeline.frameId());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/MovementEffectReplayTest.java b/src/test/java/net/raphimc/viabedrock/api/model/MovementEffectReplayTest.java
