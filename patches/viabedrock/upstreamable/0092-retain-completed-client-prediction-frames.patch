+    @Test
+    void transportsTickedLocalMotionOnlyWithNegotiatedInputHistory() throws Exception {
+        final var predictions = new PlayerPredictionStorage();
+        for (int frame = 20; frame <= 25; frame++) {
+            predictions.remember(frame + 80, new PlayerPrediction(frame, Position3f.ZERO, Position3f.ZERO,
+                    PlayerPosture.STANDING, false, false, false, false, 1F));
+        }
+        final var channels = new ChannelStorage();
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(
+                UserConnection.class.getClassLoader(), new Class<?>[]{ProtocolInfo.class},
+                (proxy, method, args) -> method.getName().equals("getServerState") ? State.CONFIGURATION : null);
+        final EntityTracker[] holder = new EntityTracker[1];
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("getProtocolInfo") ? info : method.getName().equals("get") ? args[0] == EntityTracker.class ? holder[0]
+                        : args[0] == PlayerPredictionStorage.class ? predictions : args[0] == ChannelStorage.class ? channels : null : null);
+        final var tracker = holder[0] = new EntityTracker(user);
+        final var player = new ClientPlayerEntity(user, 2, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+        player.setPosition(Position3f.ZERO);
