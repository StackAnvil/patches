+        }
+    }
+
+    public int level() {
+        return this.level;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/UnderwaterMovementAttribute.java b/src/main/java/net/raphimc/viabedrock/api/model/UnderwaterMovementAttribute.java
