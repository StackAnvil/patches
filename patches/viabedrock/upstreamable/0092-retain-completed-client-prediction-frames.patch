+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class VehiclePredictionTest {
+
+    private static final VehiclePredictionContext CONTEXT = new VehiclePredictionContext(4,
+            new VehiclePredictionContext.Identity(8, UUID.randomUUID(), UUID.randomUUID(), 0x100000002L, -17));
+
+    @Test
+    void bothContextStatesAndCompletedFrameRoundTripWithoutLosingNativeIdentity() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (var context : new VehiclePredictionContext[]{CONTEXT, new VehiclePredictionContext(Long.MAX_VALUE, null)}) {
+                VehiclePredictionContext.TYPE.write(buffer, context);
+                assertEquals(context, VehiclePredictionContext.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+                buffer.clear();
+            }
+            final var frame = new VehiclePrediction(Long.MAX_VALUE, CONTEXT, new Position3f(16384F, -64F, -16384F),
+                    new Position3f(-0.125F, 0.25F, 0.375F));
+            VehiclePrediction.TYPE.write(buffer, frame);
+            assertEquals(frame, VehiclePrediction.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void codecRejectsWrongVersionProtocolPresenceAndTruncatedIdentities() {
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePrediction.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePrediction.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_LONG.writePrimitive(buffer, 0);
+            buffer.writeByte(2);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePredictionContext.TYPE.read(buffer));
+            buffer.clear();
+            VehiclePrediction.TYPE.write(buffer, new VehiclePrediction(2, CONTEXT, Position3f.ZERO, Position3f.ZERO));
+            final int length = buffer.readableBytes();
+            for (int end : new int[]{1, 4, 9, length - 13, length - 1}) {
+                final var truncated = buffer.slice(0, end);
+                assertThrows(IndexOutOfBoundsException.class, () -> VehiclePrediction.TYPE.read(truncated));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void completeCodecsRejectTrailingFieldsWithoutChangingNestedContextLayout() {
+        final var buffer = Unpooled.buffer();
+        try {
+            VehiclePredictionContext.TYPE.write(buffer, CONTEXT);
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePredictionContext.TYPE.read(buffer));
+            buffer.clear();
+            VehiclePrediction.TYPE.write(buffer, new VehiclePrediction(2, CONTEXT, Position3f.ZERO, Position3f.ZERO));
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePrediction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void framesRequireLiveContextNonnegativeClocksAndFinitePositionAndMotion() {
+        assertThrows(IllegalArgumentException.class, () -> new VehiclePredictionContext(-1, CONTEXT.vehicle()));
+        assertThrows(IllegalArgumentException.class, () -> new VehiclePredictionContext.Identity(-1, UUID.randomUUID(), UUID.randomUUID(), 0, 0));
+        assertThrows(IllegalArgumentException.class, () -> new VehiclePrediction(-1, CONTEXT, Position3f.ZERO, Position3f.ZERO));
+        assertThrows(NullPointerException.class, () -> new VehiclePrediction(1, new VehiclePredictionContext(1, null), Position3f.ZERO, Position3f.ZERO));
+        for (float value : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            final var invalid = new Position3f(1, value, 2);
+            assertThrows(IllegalArgumentException.class, () -> new VehiclePrediction(1, CONTEXT, invalid, Position3f.ZERO));
+            assertThrows(IllegalArgumentException.class, () -> new VehiclePrediction(1, CONTEXT, Position3f.ZERO, invalid));
+        }
+    }
+
+    @Test
+    void floatMatchingRetainsSubthresholdMotionButRejectsUnrelatedCoordinates() {
+        final var frame = new VehiclePrediction(1, CONTEXT, new Position3f(0.0001F, 64F, -0.0001F), Position3f.ZERO);
+        assertTrue(frame.matches(new Position3f(0F, 64F, 0F)));
+        assertFalse(frame.matches(new Position3f(0.002F, 64F, 0F)));
+        assertFalse(frame.matches(new Position3f(0F, Float.NaN, 0F)));
+        final var far = new VehiclePrediction(2, CONTEXT, new Position3f(16777216F, 64F, -16777216F), Position3f.ZERO);
+        assertTrue(far.matches(new Position3f(16777218F, 64F, -16777218F)));
+        assertFalse(far.matches(new Position3f(16777224F, 64F, -16777224F)));
+    }
+
+}
