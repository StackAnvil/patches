+                    0x3F641893, 0x3F78DB97, 0x3E2137F0),
+            new Case(0F, 0F, 0F, -90F, -180F, -90F, 180F, true,
+                    0x00000000, 0x3F53FE5D, 0x339DFB7B),
+            new Case(2F, 0.1F, 0.5F, -90F, -180F, -90F, 180F, true,
+                    0x3F641893, 0x3F80D1BC, 0x3E937C9C),
+            new Case(0F, 0F, 0F, -89.999F, 0F, -89.999F, 0F, false,
+                    0x2CF7DAFB, 0x3F4B367B, 0x38A8FCBB),
+            new Case(2F, 0.1F, 0.5F, -89.999F, 0F, -89.999F, 0F, false,
+                    0x3F641894, 0x3F78DB97, 0x3E938729),
+            new Case(0F, 0F, 0F, -45F, 0F, -45F, 0F, false,
+                    0x335FD6C7, 0x3F10D4A9, 0x3F189CE6),
+            new Case(2F, 0.1F, 0.5F, -45F, 0F, -45F, 0F, false,
+                    0x3F641895, 0x3F34778D, 0x3F64D360),
+            new Case(0F, 0F, 0F, 0F, 0F, 0F, 0F, false,
+                    0x339E264E, 0xBC1081C3, 0x3F57A6F1),
+            new Case(2F, 0.1F, 0.5F, 0F, 0F, 0F, 0F, false,
+                    0x3F641895, 0x3D20902E, 0x3F954938),
+            new Case(2F, 0.1F, 0.5F, 0F, -180F, 0F, 180F, false,
+                    0x3F641893, 0x3D20902E, 0xBF388625)
