+package net.raphimc.viabedrock.api.util;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData;
+import org.junit.jupiter.api.Test;
+
+import java.util.EnumSet;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MathUtilMovementTest {
+
+    @Test
+    void cancelsOpposingDirectionsBeforeNormalizationAndScaling() {
+        final float diagonal = 0.70710677F;
+        final float[][] vectors = {
+                {0F, 0F}, {0F, 1F}, {0F, -1F}, {0F, 0F},
+                {-1F, 0F}, {-diagonal, diagonal}, {-diagonal, -diagonal}, {-1F, 0F},
+                {1F, 0F}, {diagonal, diagonal}, {diagonal, -diagonal}, {1F, 0F},
+                {0F, 0F}, {0F, 1F}, {0F, -1F}, {0F, 0F}
+        };
+        final PlayerAuthInputData[] directions = {
+            PlayerAuthInputData.Up, PlayerAuthInputData.Down, PlayerAuthInputData.Left, PlayerAuthInputData.Right
+        };
+        for (int mask = 0; mask < vectors.length; mask++) {
+            final var input = EnumSet.of(PlayerAuthInputData.SneakDown, PlayerAuthInputData.Sprinting);
+            for (int bit = 0; bit < directions.length; bit++) {
+                if ((mask & (1 << bit)) != 0) {
+                    input.add(directions[bit]);
+                }
+            }
+            for (float scale : new float[]{0F, 0.3F, 0.45000002F, 0.6F, 0.75F, 1F}) {
+                final var movement = MathUtil.calculateMovementDirections(input, scale);
+                assertEquals(vectors[mask][0] * scale, movement.x());
+                assertEquals(vectors[mask][1] * scale, movement.y());
+            }
+        }
+    }
+
+}
