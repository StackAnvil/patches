+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+import net.raphimc.viabedrock.api.util.MathUtil;
+import net.raphimc.viabedrock.api.util.MoLangMath;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native 1.26.51 water acceleration and damping, including confirmed dolphin boosts. */
+public final class WaterMovement {
+
+    public static float acceleration(final float underwaterSpeed, final float walkingSpeed, final int depthStrider,
+                                     final boolean onGround, final boolean boosted) {
+        float level = MathUtil.clamp(depthStrider, 0, 3);
+        if (boosted) {
+            // Boosted travel uses full enchantment efficiency even when airborne.
+            return underwaterSpeed * ((level / 3F) * 0.3F + 0.7F) * 2F;
+        }
+        if (level == 0F) {
+            return underwaterSpeed;
+        }
+        if (!onGround) {
+            level *= 0.5F;
+        }
+        // Native multiplies before dividing. Using a precomputed fraction changes rounding.
+        return underwaterSpeed + ((walkingSpeed - underwaterSpeed) * level) / 3F;
+    }
+
+    public static Position3f damp(final Position3f motion, final int depthStrider, final boolean onGround,
+                                  final boolean sprinting, final float waterSlowdown, final boolean boosted) {
+        float drag = sprinting ? 0.9F : waterSlowdown;
+        if (!boosted) {
+            float level = MathUtil.clamp(depthStrider, 0, 3);
+            if (!onGround) {
+                level *= 0.5F;
+            }
+            drag += (0.54600006F - drag) * (level / 3F);
+        }
+        return new Position3f(motion.x() * drag, motion.y() * 0.8F, motion.z() * drag);
+    }
+
+    /** Preserve the native wrapped pitch and float lookup used by SwimControl. */
+    public static float swimmingLookY(final float pitch, final float previousPitch) {
+        final float viewPitch = MoLangMath.minAngle(pitch - previousPitch) + previousPitch;
+        return BedrockTrigonometry.sine(viewPitch * -0.017453292F);
+    }
+
+    /** Native SwimControl runs after vertical flight input and excludes actors that are jumping. */
+    public static float swimmingVertical(final float velocity, final float lookY, final boolean swimming,
+                                         final boolean flying, final boolean breathingInAir,
+                                         final boolean breathingInLiquid, final boolean wantDownSlow) {
+        if (!swimming) {
+            return velocity;
+        }
+        if (lookY <= 0F || breathingInLiquid || flying && (!breathingInAir || wantDownSlow)) {
+            final float rate = flying ? 1.3F : lookY < -0.2F ? 0.085F : 0.06F;
+            return rate * (lookY - velocity) + velocity;
+        }
+        return 0F;
+    }
+
+    private WaterMovement() {
+    }
+
+}
