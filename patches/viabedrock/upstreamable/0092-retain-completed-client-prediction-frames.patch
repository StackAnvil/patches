+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Flight values that the standard Java abilities packet cannot represent. */
+public record FlightMovementContext(int entityId, int gameType, int levelGameType, float verticalSpeed, boolean legacyFriction,
+                                    float frictionModifier, float dragModifier) {
+
+    public static final String CHANNEL = "viabedrock:flight_movement";
+    public static final Type<FlightMovementContext> TYPE = new Type<>(FlightMovementContext.class) {
+        @Override
+        public FlightMovementContext read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported flight movement context");
+            }
+            return new FlightMovementContext(Types.VAR_INT.readPrimitive(buffer), Types.VAR_INT.readPrimitive(buffer),
+                    Types.VAR_INT.readPrimitive(buffer), Types.FLOAT.readPrimitive(buffer), Types.BOOLEAN.read(buffer),
+                    Types.FLOAT.readPrimitive(buffer), Types.FLOAT.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final FlightMovementContext context) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, context.entityId());
+            Types.VAR_INT.writePrimitive(buffer, context.gameType());
+            Types.VAR_INT.writePrimitive(buffer, context.levelGameType());
+            Types.FLOAT.writePrimitive(buffer, context.verticalSpeed());
+            Types.BOOLEAN.write(buffer, context.legacyFriction());
+            Types.FLOAT.writePrimitive(buffer, context.frictionModifier());
+            Types.FLOAT.writePrimitive(buffer, context.dragModifier());
+        }
+    };
+
+    public FlightMovementContext {
+        if (!Float.isFinite(verticalSpeed) || !Float.isFinite(frictionModifier) || !Float.isFinite(dragModifier)) {
+            throw new IllegalArgumentException("Invalid flight movement attributes");
+        }
+    }
+
+}
