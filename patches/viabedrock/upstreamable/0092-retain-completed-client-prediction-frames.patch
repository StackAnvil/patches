@@ -0,0 +1,64 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+import net.raphimc.viabedrock.api.util.MoLangMath;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native glide travel before collision resolution, with confirmed rocket boosts. */
+public final class GlideMovement {
+
+    private static final float RADIANS = (float) Math.PI / 180F;
+
+    private GlideMovement() {
+    }
+
+    public static Position3f calculate(final Position3f motion, final float pitch, final float yaw,
+                                      final float previousPitch, final float previousYaw, final boolean slowFalling, final boolean glideBoost) {
+        final float viewYaw = (MoLangMath.minAngle(yaw - previousYaw) + previousYaw) * -RADIANS - (float) Math.PI;
+        final float viewPitch = (MoLangMath.minAngle(pitch - previousPitch) + previousPitch) * -RADIANS;
+        final float pitchCosine = -BedrockTrigonometry.cosine(viewPitch);
+        final float lookX = BedrockTrigonometry.sine(viewYaw) * pitchCosine;
+        final float lookY = BedrockTrigonometry.sine(viewPitch);
+        final float lookZ = BedrockTrigonometry.cosine(viewYaw) * pitchCosine;
+        final float horizontalLookSquared = lookX * lookX + lookZ * lookZ;
+        final float horizontalLook = (float) Math.sqrt(horizontalLookSquared);
+        final float horizontalSpeed = (float) Math.sqrt(motion.x() * motion.x() + motion.z() * motion.z());
+        final float radians = pitch * RADIANS;
+        final float cosine = BedrockTrigonometry.cosine(radians);
+        final float lift = Math.min(1F, (float) Math.sqrt(lookY * lookY + lookX * lookX + lookZ * lookZ) / 0.4F) * cosine * cosine;
+        float x = motion.x();
+        float y = motion.y() - (0.75F * lift - 1F) * (slowFalling ? -0.01F : -0.08F);
+        float z = motion.z();
+        if (horizontalLookSquared > 0F && y < 0F) {
+            // Native multiplies the vertical speed before lift; reversing these
+            // float operations changes the result even with confirmed rocket boosts.
+            final float descent = lift * (-0.1F * y);
+            x += lookX * descent / horizontalLook;
+            y += descent;
+            z += lookZ * descent / horizontalLook;
+        }
+        if (radians < 0F) {
+            final float ascent = BedrockTrigonometry.sine(radians) * horizontalSpeed * -0.04F;
+            x -= ascent * lookX / horizontalLook;
+            y += 3.2F * ascent;
+            z -= ascent * lookZ / horizontalLook;
+        }
+        if (horizontalLookSquared > 0F) {
+            x += (lookX / horizontalLook * horizontalSpeed - x) * 0.1F;
+            z += (lookZ / horizontalLook * horizontalSpeed - z) * 0.1F;
+        }
+        if (glideBoost) {
+            // Native sums the complete impulse before adding the entering motion.
+            x += (1.5F * lookX - x) * 0.5F + lookX * 0.1F;
+            y += (lookY * 1.5F - y) * 0.5F + lookY * 0.1F;
+            z += (lookZ * 1.5F - z) * 0.5F + lookZ * 0.1F;
+        }
+        return new Position3f(x * 0.99F, y * 0.98F, z * 0.99F);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/MovementCollisionQuery.java b/src/main/java/net/raphimc/viabedrock/api/model/MovementCollisionQuery.java
new file mode 100644
index 000000000..2f0075e6a
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/MovementCollisionQuery.java
@@ -0,0 +1,181 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Native 1.26.51.1 collision-cache admission, swept query, and uncovered-region traversal. */
+public final class MovementCollisionQuery {
+
+    private MovementCollisionQuery() {
+    }
+
+    public static boolean reuses(final Position3f captured, final Position3f corrected) {
+        final float x = captured.x() - corrected.x();
+        final float y = captured.y() - corrected.y();
+        final float z = captured.z() - corrected.z();
+        return z * z + (y * y + x * x) < 4F;
+    }
+
+    public static Position3f cap(final Position3f motion) {
+        final float squared = (motion.x() * motion.x() + motion.y() * motion.y()) + motion.z() * motion.z();
+        if (!(squared > 256F)) {
+            return motion;
+        }
+        final float length = (float) Math.sqrt(squared);
+        return new Position3f((motion.x() / length) * 16F, (motion.y() / length) * 16F, (motion.z() / length) * 16F);
+    }
+
+    /** Includes upward stepping, the lower inset probe, and native vertical query padding. */
+    public static CollisionContact.Box bounds(final CollisionContact.Box body, final Position3f motion, final float stepHeight) {
+        final float[] box = normalized(values(body));
+        final float[] swept = grow(box, motion.x(), motion.y(), motion.z());
+        final float[] step = union(union(box, swept), union(grow(box, 0F, stepHeight, 0F),
+                grow(box, motion.x(), stepHeight + motion.y(), motion.z())));
+        final float[] inset = box.clone();
+        for (int axis : new int[]{0, 2}) {
+            float min = box[axis] + 0.025F;
+            float max = box[axis + 3] - 0.025F;
+            if (max < min) {
+                min = (box[axis] + box[axis + 3]) * 0.5F;
+                max = min;
+            }
+            inset[axis] = min;
+            inset[axis + 3] = max;
+        }
+        final float lower = stepHeight * 1.01F;
+        inset[1] -= lower;
+        inset[4] -= lower;
+        final float[] query = union(step, grow(inset, motion.x(), 0F, motion.z()));
+        query[1] = Math.min(query[1], (-0.2F - Math.abs(motion.y())) + box[1]);
+        query[4] = Math.max(query[4], box[4] + 0.08F);
+        return box(union(query, box));
+    }
+
+    public static boolean contains(final CollisionContact.Box outer, final CollisionContact.Box inner) {
+        return outer != null && outer.minX() <= inner.minX() && outer.minY() <= inner.minY() && outer.minZ() <= inner.minZ()
+                && outer.maxX() >= inner.maxX() && outer.maxY() >= inner.maxY() && outer.maxZ() >= inner.maxZ();
+    }
+
+    /** Preserve native plane order, float advances, deduplication, and volume-based merging. */
+    public static List<CollisionContact.Box> missing(final CollisionContact.Box query, final CollisionContact.Box cached) {
+        if (contains(cached, query)) {
+            return List.of();
+        }
+        if (cached == null || cached.maxX() <= cached.minX() || cached.maxY() <= cached.minY() || cached.maxZ() <= cached.minZ()
+                || cached.maxX() <= query.minX() || query.maxX() <= cached.minX()
+                || cached.maxY() <= query.minY() || query.maxY() <= cached.minY()
+                || cached.maxZ() <= query.minZ() || query.maxZ() <= cached.minZ()) {
+            return List.of(query);
+        }
+        final float[] requested = values(query);
+        final float[] previous = values(cached);
+        final float[] size = new float[3];
+        final float[][] planes = new float[3][2];
+        for (int axis = 0; axis < 3; axis++) {
+            size[axis] = requested[axis + 3] - requested[axis];
+            planes[axis][0] = previous[axis] - requested[axis];
+            planes[axis][1] = previous[axis + 3] - requested[axis];
+        }
+        final List<float[]> pending = new ArrayList<>();
+        final List<float[]> cells = new ArrayList<>();
+        pending.add(new float[3]);
+        for (int index = 0; index < pending.size(); index++) {
+            final float[] origin = pending.get(index);
+            final float[] ends = new float[3];
+            boolean interior = true;
+            for (int axis = 0; axis < 3; axis++) {
+                final int first = before(planes[axis], origin[axis]);
+                final int last = before(planes[axis], size[axis]);
+                if (first == last) {
+                    ends[axis] = size[axis];
+                    interior &= first == 1;
+                } else {
+                    ends[axis] = planes[axis][first];
+                    final float[] candidate = origin.clone();
+                    candidate[axis] = ends[axis] + 0.00001F;
+                    if (pending.stream().noneMatch(prior -> same(candidate, prior))) {
+                        pending.add(candidate);
+                    }
+                    interior &= first != 0;
+                }
+            }
+            final float[] cell = normalized(new float[]{origin[0], origin[1], origin[2], ends[0], ends[1], ends[2]});
+            if (!interior && cell[0] < cell[3] && cell[1] < cell[4] && cell[2] < cell[5]) {
+                cells.add(cell);
+            }
+        }
+        final List<float[]> emitted = new ArrayList<>();
+        for (float[] cell : cells) {
+            boolean merged = false;
+            for (float[] prior : emitted) {
+                // Native compares a local candidate with the already translated emitted boxes.
+                final float[] combined = union(cell, prior);
+                if (Math.abs(volume(combined) - (volume(prior) + volume(cell))) <= 0.001F) {
+                    System.arraycopy(combined, 0, prior, 0, 6);
+                    merged = true;
+                    break;
+                }
+            }
+            if (!merged) {
+                final float[] translated = new float[6];
+                for (int index = 0; index < 6; index++) {
+                    translated[index] = cell[index] + requested[index % 3];
+                }
+                emitted.add(translated);
+            }
+        }
+        return emitted.stream().map(MovementCollisionQuery::box).toList();
+    }
+
+    private static int before(final float[] planes, final float value) {
+        return (planes[0] < value ? 1 : 0) + (planes[1] < value ? 1 : 0);
+    }
+
+    private static boolean same(final float[] a, final float[] b) {
+        return Math.abs(a[0] - b[0]) <= 0x1.0p-23F && Math.abs(a[1] - b[1]) <= 0x1.0p-23F
+                && Math.abs(a[2] - b[2]) <= 0x1.0p-23F;
+    }
+
+    private static float volume(final float[] box) {
+        return ((box[3] - box[0]) * (box[4] - box[1])) * (box[5] - box[2]);
+    }
+
+    private static float[] normalized(final float[] box) {
+        return new float[]{Math.min(box[0], box[3]), Math.min(box[1], box[4]), Math.min(box[2], box[5]),
+                Math.max(box[0], box[3]), Math.max(box[1], box[4]), Math.max(box[2], box[5])};
+    }
+
+    private static float[] union(final float[] a, final float[] b) {
+        return new float[]{Math.min(a[0], b[0]), Math.min(a[1], b[1]), Math.min(a[2], b[2]),
+                Math.max(a[3], b[3]), Math.max(a[4], b[4]), Math.max(a[5], b[5])};
+    }
+
+    private static float[] grow(final float[] box, final float x, final float y, final float z) {
+        final float[] result = box.clone();
+        final float[] motion = {x, y, z};
+        for (int axis = 0; axis < 3; axis++) {
+            if (motion[axis] < 0F) {
+                result[axis] += motion[axis];
+            } else if (motion[axis] > 0F) {
+                result[axis + 3] += motion[axis];
+            }
+        }
+        return result;
+    }
+
+    private static float[] values(final CollisionContact.Box box) {
+        return new float[]{box.minX(), box.minY(), box.minZ(), box.maxX(), box.maxY(), box.maxZ()};
+    }
+
+    private static CollisionContact.Box box(final float[] values) {
+        return new CollisionContact.Box(values[0], values[1], values[2], values[3], values[4], values[5]);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/MovementCollisionWorld.java b/src/main/java/net/raphimc/viabedrock/api/model/MovementCollisionWorld.java
