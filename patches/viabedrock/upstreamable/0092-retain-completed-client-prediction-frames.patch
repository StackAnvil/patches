+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native 1.26.51 accumulation and motion update for observed liquid flows. */
+public final class FluidCurrent {
+
+    public static final float WATER_STRENGTH = 0.014F;
+    public static final float LAVA_STRENGTH = 0.0035F;
+
+    private float x;
+    private float y;
+    private float z;
+
+    public void reset() {
+        this.x = this.y = this.z = 0F;
+    }
+
+    public void accumulate(final float x, final float y, final float z) {
+        this.x += x;
+        this.y += y;
+        this.z += z;
+    }
+
+    public Position3f apply(final Position3f motion, final float strength) {
+        // Preserve the instruction order, including the inner Y/X sum.
+        final float squaredLength = this.z * this.z + (this.y * this.y + this.x * this.x);
+        if (squaredLength <= 0F) {
+            return motion;
+        }
+        final float length = (float) Math.sqrt(squaredLength);
+        final boolean normalize = length >= 0.0001F;
+        final float normalizedX = normalize ? this.x / length : 0F;
+        final float normalizedY = normalize ? this.y / length : 0F;
+        final float normalizedZ = normalize ? this.z / length : 0F;
+        return new Position3f(normalizedX * strength + motion.x(), normalizedY * strength + motion.y(), normalizedZ * strength + motion.z());
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/GeyserMovement.java b/src/main/java/net/raphimc/viabedrock/api/model/GeyserMovement.java
new file mode 100644
index 000000000..a0b8ce34e
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/GeyserMovement.java
@@ -0,0 +1,87 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native 1.26.51 geyser movement using the player's current block column. */
+public final class GeyserMovement {
+
+    private static final float[] SPEED_LIMITS = {0.4F, 0.5F, 0.6F, 0.7F};
+
+    /** Native sulfur ticker admission uses actor overlap, independently of the body-center lift query. */
+    public static boolean admits(final Position3f minimum, final Position3f maximum, final int x, final int y,
+                                 final int z, final BlockAccess blocks) {
+        if (!blocks.cell(x, y, z).erupting()) {
+            return false;
+        }
+        final int depth = waterDepth(x, y, z, blocks);
+        return depth != 0 && maximum.x() > (float) x && minimum.x() < (float) (x + 1)
+                && maximum.y() > (float) y && minimum.y() < (float) (y + depth * 6)
+                && maximum.z() > (float) z && minimum.z() < (float) (z + 1);
+    }
+
+    public static float calculate(final Position3f minimum, final Position3f maximum, final float verticalMotion,
+                                  final boolean boosted, final boolean flying, final BlockAccess blocks) {
+        if (!boosted || flying) {
+            return verticalMotion;
+        }
+        final int x = coordinate((maximum.x() - minimum.x()) * 0.5F + minimum.x());
+        int y = coordinate(minimum.y());
+        final int z = coordinate((maximum.z() - minimum.z()) * 0.5F + minimum.z());
+        // Native queries 24 cells, then considers the following cell even when none collided.
+        for (int distance = 0; distance < 24; distance++) {
+            if (blocks.cell(x, y, z).colliding()) {
+                break;
+            }
+            y--;
+        }
+        if (!blocks.cell(x, y, z).erupting()) {
+            return verticalMotion;
+        }
+        final int depth = waterDepth(x, y, z, blocks);
+        if (depth != 0 && minimum.y() < (float) (y + depth * 6 + 1) && verticalMotion < SPEED_LIMITS[depth - 1]) {
+            // The cap is checked before addition; native can overshoot it by this increment.
+            return verticalMotion + 0.2F;
+        }
+        return verticalMotion;
+    }
+
+    private static int waterDepth(final int x, final int y, final int z, final BlockAccess blocks) {
+        int depth = 0;
+        for (int offset = 1; offset <= 4; offset++) {
+            final Cell cell = blocks.cell(x, y + offset, z);
+            if (!cell.mainSourceWater() && !(cell.extraSourceWater() && !cell.colliding())) {
+                break;
+            }
+            depth = offset;
+        }
+        final Cell top = blocks.cell(x, y + depth + 1, z);
+        // Any source liquid rejects the cap, including lava. Flowing liquid does not.
+        if (depth == 0 || top.sourceLiquid() || top.colliding()) {
+            return 0;
+        }
+        return depth;
+    }
+
+    private static int coordinate(final float value) {
+        final float floor = (float) Math.floor(value);
+        // Match the x64 float-to-int conversion rather than Java's saturating conversion.
+        return !Float.isFinite(floor) || floor >= 0x1p31F || floor < -0x1p31F ? Integer.MIN_VALUE : (int) floor;
+    }
+
+    private GeyserMovement() {
+    }
+
+    @FunctionalInterface
+    public interface BlockAccess {
+        Cell cell(int x, int y, int z);
+    }
+
+    public record Cell(boolean colliding, boolean erupting, boolean mainSourceWater, boolean extraSourceWater, boolean sourceLiquid) {
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/GlideMovement.java b/src/main/java/net/raphimc/viabedrock/api/model/GlideMovement.java
new file mode 100644
index 000000000..e3df1f47a
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/GlideMovement.java
@@ -0,0 +1,64 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+import net.raphimc.viabedrock.api.util.MoLangMath;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native glide travel before collision resolution, with confirmed rocket boosts. */
+public final class GlideMovement {
+
+    private static final float RADIANS = (float) Math.PI / 180F;
+
+    private GlideMovement() {
+    }
+
+    public static Position3f calculate(final Position3f motion, final float pitch, final float yaw,
+                                      final float previousPitch, final float previousYaw, final boolean slowFalling, final boolean glideBoost) {
+        final float viewYaw = (MoLangMath.minAngle(yaw - previousYaw) + previousYaw) * -RADIANS - (float) Math.PI;
+        final float viewPitch = (MoLangMath.minAngle(pitch - previousPitch) + previousPitch) * -RADIANS;
+        final float pitchCosine = -BedrockTrigonometry.cosine(viewPitch);
+        final float lookX = BedrockTrigonometry.sine(viewYaw) * pitchCosine;
+        final float lookY = BedrockTrigonometry.sine(viewPitch);
+        final float lookZ = BedrockTrigonometry.cosine(viewYaw) * pitchCosine;
+        final float horizontalLookSquared = lookX * lookX + lookZ * lookZ;
+        final float horizontalLook = (float) Math.sqrt(horizontalLookSquared);
+        final float horizontalSpeed = (float) Math.sqrt(motion.x() * motion.x() + motion.z() * motion.z());
+        final float radians = pitch * RADIANS;
+        final float cosine = BedrockTrigonometry.cosine(radians);
+        final float lift = Math.min(1F, (float) Math.sqrt(lookY * lookY + lookX * lookX + lookZ * lookZ) / 0.4F) * cosine * cosine;
+        float x = motion.x();
+        float y = motion.y() - (0.75F * lift - 1F) * (slowFalling ? -0.01F : -0.08F);
+        float z = motion.z();
+        if (horizontalLookSquared > 0F && y < 0F) {
+            // Native multiplies the vertical speed before lift; reversing these
+            // float operations changes the result even with confirmed rocket boosts.
+            final float descent = lift * (-0.1F * y);
+            x += lookX * descent / horizontalLook;
+            y += descent;
+            z += lookZ * descent / horizontalLook;
+        }
+        if (radians < 0F) {
+            final float ascent = BedrockTrigonometry.sine(radians) * horizontalSpeed * -0.04F;
+            x -= ascent * lookX / horizontalLook;
+            y += 3.2F * ascent;
+            z -= ascent * lookZ / horizontalLook;
+        }
+        if (horizontalLookSquared > 0F) {
+            x += (lookX / horizontalLook * horizontalSpeed - x) * 0.1F;
+            z += (lookZ / horizontalLook * horizontalSpeed - z) * 0.1F;
+        }
+        if (glideBoost) {
+            // Native sums the complete impulse before adding the entering motion.
+            x += (1.5F * lookX - x) * 0.5F + lookX * 0.1F;
+            y += (lookY * 1.5F - y) * 0.5F + lookY * 0.1F;
+            z += (lookZ * 1.5F - z) * 0.5F + lookZ * 0.1F;
+        }
+        return new Position3f(x * 0.99F, y * 0.98F, z * 0.99F);
+    }
+
+}
