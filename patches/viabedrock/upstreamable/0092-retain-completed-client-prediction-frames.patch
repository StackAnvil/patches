+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class MovementControllerOrderTest {
+
+    @Test
+    void followsNativeVerticalJumpAndSwimOrderAcrossTransitions() {
+        // Native callbacks run in this order. No collision or post-travel damping is supplied here.
+        final float[][] steps = {
+            {0, 1, 128, 1, 1, -1.0F, 1, 0, 1.0F},
+            {1, 1, 128, 1, 1, -1.0F, 1, 0, 1.0F},
+            {1, 1, 0, 1, 1, -1.0F, 1, 0, 1.0F},
+            {1, 1, 1, 1, 1, 0.5F, 1, 0, 1.0F},
+            {1, 1, 129, 1, 1, -1.0F, 1, 0, 1.0F},
+            {1, 6, 128, 1, 1, 0.5F, 0, 0, 0.25F},
+            {1, 6, 0, 1, 1, 0.5F, 1, 1, 2.0F},
+            {0, 0, 128, 1, 1, -1.0F, 1, 1, 1.0F},
+            {0, 0, 0, 1, 1, -1.0F, 1, 1, 1.0F},
+            {1, 1, 128, 0, 1, -1.0F, 1, 1, 1.0F},
+            {1, 1, 128, 1, 0, -1.0F, 1, 1, 1.0F},
+            {1, 1, 0, 1, 1, -0.2F, 1, 1, 1.0F}
+        };
+        final int[] expectedVertical = {0x3D4CCCCD, 0x3E4CCCCD, 0xBF028F5C, 0xBFAEF9DB, 0x00000000, 0xBFA19999, 0x3F83AE13, 0x3EAEC8B6, 0x3EAEC8B6, 0x3EC13517, 0x3F0700F2, 0x3E4A816B};
+        final int[] expected = {0x3D4CCCCD, 0xBFAE147B, 0xBF92D0E5, 0x00000000, 0xBFA66666, 0x3F83AE13, 0x3EAEC8B6, 0x3EAEC8B6, 0x3E68D094, 0x3EC13517, 0x3F0700F2, 0xBEA37EEE};
+        float velocity = 0.05F;
+        for (int i = 0; i < steps.length; i++) {
+            final float[] step = steps[i];
+            final boolean flying = step[0] != 0;
+            final int flags = (int) step[2];
+            final FlightMovementContext context = new FlightMovementContext(1, (int) step[1], 0, step[8], false, 1F, 1F);
+            velocity = FlightMovement.verticalInput(velocity, 0F, 0F, flying,
+                    (flags & 0x20080) != 0, (flags & 0x40001) != 0, false, false, context);
+            assertEquals(expectedVertical[i], Float.floatToRawIntBits(velocity));
+            final boolean jumping = FlightMovement.isJumping((flags & 128) != 0, flying);
+            assertEquals(i == 0 || i == 7, jumping);
+            if (step[4] != 0 && !jumping) {
+                velocity = WaterMovement.swimmingVertical(velocity, step[5], step[3] != 0, flying,
+                        step[6] == 1, step[7] != 0, false);
+            }
+            assertEquals(expected[i], Float.floatToRawIntBits(velocity));
+        }
+    }
+
+}
