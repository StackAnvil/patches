+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class FluidCurrentTest {
+
+    @Test
+    void matchesNativeWaterAndLavaMotionBits() {
+        final FluidCurrent current = new FluidCurrent();
+        current.accumulate(0.3F, -0.8F, 0.52F);
+        final Position3f motion = new Position3f(0.03F, -0.5F, -0.09F);
+        assertBits(current.apply(motion, FluidCurrent.WATER_STRENGTH), 0x3D0C146B, 0xBF02DDDB, 0xBDA969DE);
+        assertBits(current.apply(motion, FluidCurrent.LAVA_STRENGTH), 0x3CFE5C21, 0xBF00B777, 0xBDB497E9);
+    }
+
+    @Test
+    void usesNativeNormalizationThresholdWithoutJavaSmallCurrentBoost() {
+        final FluidCurrent current = new FluidCurrent();
+        final Position3f motion = new Position3f(0.03F, -0.5F, -0.09F);
+        current.accumulate(0.0001F, 0F, 0F);
+        assertBits(current.apply(motion, FluidCurrent.WATER_STRENGTH), 0x3D343958, 0xBF000000, 0xBDB851EC);
+        current.reset();
+        current.accumulate(0.000099F, 0F, 0F);
+        assertBits(current.apply(motion, FluidCurrent.WATER_STRENGTH), 0x3CF5C28F, 0xBF000000, 0xBDB851EC);
+    }
+
+    @Test
+    void roundsEachAccumulationAndClearsThePreviousFrame() {
+        final FluidCurrent current = new FluidCurrent();
+        final Position3f motion = new Position3f(0F, -0F, 0F);
+        current.accumulate(1F, 0F, 0F);
+        current.accumulate(0.00000002F, 0F, 0F);
+        current.accumulate(-1F, 0F, 0F);
+        assertSame(motion, current.apply(motion, FluidCurrent.WATER_STRENGTH));
+        current.accumulate(1F, 0F, 0F);
+        assertBits(current.apply(motion, FluidCurrent.LAVA_STRENGTH), 0x3B656042, 0, 0);
+        current.reset();
+        assertSame(motion, current.apply(motion, FluidCurrent.WATER_STRENGTH));
+    }
+
+    private static void assertBits(final Position3f actual, final int x, final int y, final int z) {
+        assertEquals(x, Float.floatToRawIntBits(actual.x()));
+        assertEquals(y, Float.floatToRawIntBits(actual.y()));
+        assertEquals(z, Float.floatToRawIntBits(actual.z()));
+    }
+
+}
