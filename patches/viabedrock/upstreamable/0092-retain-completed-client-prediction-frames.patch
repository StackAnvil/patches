+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class MovementCorrectionTimingTest {
+
+    @Test
+    void queuesTheFollowingSnapshotAndRejectsExpiredUnsignedClocks() {
+        assertNull(new MovementCorrectionTiming(0, 105, 25, 100, -1).locate(20, 25));
+        assertNull(new MovementCorrectionTiming(99, 105, 25, 100, -1).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(21, true, false), new MovementCorrectionTiming(100, 105, 25, 100, -1).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(25, true, false), new MovementCorrectionTiming(104, 105, 25, 100, -1).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(26, true, true), new MovementCorrectionTiming(105, 105, 25, 100, -1).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(25, false, false), new MovementCorrectionTiming(-1, 105, 25, 100, -1).locate(20, 25));
+    }
+
+    @Test
+    void projectsTheClockAtReceiptAndIntersectsBothHistoryWindows() {
+        assertEquals(new MovementCorrectionTiming.Placement(26, true, false), new MovementCorrectionTiming(105, 105, 25, 100, -1).locate(20, 28));
+        assertEquals(new MovementCorrectionTiming.Placement(29, true, true), new MovementCorrectionTiming(108, 105, 25, 100, -1).locate(20, 28));
+        assertNull(new MovementCorrectionTiming(102, 105, 25, 100, -1).locate(24, 28));
+        assertNull(new MovementCorrectionTiming(100, 105, 25, 100, -1).locate(26, 25));
+        assertNull(new MovementCorrectionTiming(100, 105, 25, 100, -1).locate(20, 24));
+    }
+
+    @Test
+    void preservesNativeWrapOrderingAndCapsBeforeIncrementing() {
+        assertEquals(new MovementCorrectionTiming.Placement(24, false, false), new MovementCorrectionTiming(-1, 1, 25, -4, -1).locate(20, 25));
+        assertNull(new MovementCorrectionTiming(1, 1, 25, -4, -1).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(25, false, false), new MovementCorrectionTiming(-1, 5, 25, 0, 20).locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(23, true, false), new MovementCorrectionTiming(100, 105, 25, 100, 23).locate(20, 25));
+    }
+
+}
