+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.MovementEffectType;
+
+/** Confirmed effect and its original server tick, bound to a completed client frame when available. */
+public record MovementEffect(int entityId, int type, int duration, long serverTick, long clientFrame) {
+
+    public static final String CHANNEL = "viabedrock:movement_effect";
+    public static final Type<MovementEffect> TYPE = new Type<>(MovementEffect.class) {
+        @Override
+        public MovementEffect read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported movement effect");
+            }
+            return new MovementEffect(Types.VAR_INT.readPrimitive(buffer), Types.VAR_INT.readPrimitive(buffer),
+                    Types.VAR_INT.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final MovementEffect effect) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, effect.entityId());
+            Types.VAR_INT.writePrimitive(buffer, effect.type());
+            Types.VAR_INT.writePrimitive(buffer, effect.duration());
+            Types.VAR_LONG.writePrimitive(buffer, effect.serverTick());
+            Types.VAR_LONG.writePrimitive(buffer, effect.clientFrame());
+        }
+    };
+
+    public MovementEffect {
+        if (clientFrame < -1) {
+            throw new IllegalArgumentException("Invalid movement effect frame identity");
+        }
+    }
+
+    public boolean isGlideBoost() {
+        return this.type == MovementEffectType.GLIDE_BOOST.getValue();
+    }
+
+    /** An unknown frame never creates a new receipt-time deadline. */
+    public boolean activeAt(final long frame) {
+        if (this.clientFrame < 0 || frame < this.clientFrame || this.duration < -1) {
+            return false;
+        }
+        return this.duration == -1 || frame - this.clientFrame < this.duration;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/MovementEffectTimeline.java b/src/main/java/net/raphimc/viabedrock/api/model/MovementEffectTimeline.java
