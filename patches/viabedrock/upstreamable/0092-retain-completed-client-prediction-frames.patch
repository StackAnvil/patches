+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import com.viaversion.viaversion.api.type.Types;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FlightMovementTest {
+
+    @Test
+    void followsNativeControlDragAndFrictionAcrossStateChanges() {
+        final float[][] steps = {
+            {1, 0, 128, 0.0F, 1.0F, 0, 1.0F, 1.0F, 1.0F},
+            {1, 0, 0, 0.0F, 1.0F, 0, 1.0F, 1.0F, 1.0F},
+            {6, 0, 0, 0.0F, 1.0F, 0, 1.0F, 1.0F, 1.0F},
+            {5, 1, 1, 1.0F, 0.25F, 1, 0.5F, 1.0F, 0.6F},
+            {1, 0, 129, 0.0F, 2.0F, 0, 1.0F, 1.0F, 1.0F},
+            {6, 0, 8, 0.0F, 1.0F, 0, 0.3F, 0.5F, 1.0F},
+            {1, 0, 4, 0.0F, 1.0F, 1, 2.0F, 2.0F, 1.0F},
+            {5, 0, 0, 0.0F, 1.0F, 0, 1.0F, 1.0F, 1.0F}
+        };
+        final int[][] expected = {
+            {0x3E4CCCCD, 0x3E2EB852, 0x3DF5C290, 0xBDAEB852},
+            {0x3D3851EC, 0x3D6E7E28, 0x3CDD2F1C, 0xBCEE7E28},
+            {0x3CDD2F1C, 0x3D22C576, 0x3C84B5DE, 0xBCA2C576},
+            {0xBD1EECBF, 0x3C31BF0E, 0xBCBEB5B2, 0xBBB1BF0E},
+            {0x00000000, 0x3B729FAC, 0x00000000, 0xBAF29FAC},
+            {0x3D4CCCCD, 0x3B259737, 0x3D23D70B, 0xBAA59737},
+            {0xBDE147AE, 0x3A620802, 0xBCB4395B, 0xB9E20802},
+            {0xBCB4395B, 0x3A1A4430, 0xBC5844D4, 0xB99A4430}
+        };
+        Position3f motion = new Position3f(0.5F, 0.05F, -0.25F);
+        for (int i = 0; i < steps.length; i++) {
+            final float[] step = steps[i];
+            final int flags = (int) step[2];
+            final FlightMovementContext context = new FlightMovementContext(1, (int) step[0], (int) step[1], step[4], step[5] != 0F, step[6], step[7]);
+            final float vertical = FlightMovement.verticalInput(motion.y(), step[3], 0F, true,
+                    (flags & 0x20080) != 0, (flags & 0x40001) != 0, (flags & 8) != 0, (flags & 4) != 0, context);
+            assertEquals(expected[i][0], Float.floatToRawIntBits(vertical));
+            motion = FlightMovement.finish(new Position3f(motion.x(), vertical, motion.z()), step[8], step[3], 0F, context);
+            assertEquals(expected[i][1], Float.floatToRawIntBits(motion.x()));
+            assertEquals(expected[i][2], Float.floatToRawIntBits(motion.y()));
+            assertEquals(expected[i][3], Float.floatToRawIntBits(motion.z()));
+        }
+    }
+
+    @Test
+    void gatesCoastingOnNativeModeInputThresholdAndRequests() {
+        final FlightMovementContext creative = new FlightMovementContext(1, 1, 0, 1F, false, 1F, 1F);
+        final FlightMovementContext spectator = new FlightMovementContext(1, 6, 1, 1F, false, 1F, 1F);
+        assertEquals(0.1875F, FlightMovement.verticalInput(0.5F, 0.009999F, 0F, true, false, false, false, false, creative));
+        assertEquals(0.5F, FlightMovement.verticalInput(0.5F, 0.01F, 0F, true, false, false, false, false, creative));
+        assertEquals(0.5F, FlightMovement.verticalInput(0.5F, 0F, 0F, true, false, false, false, false, spectator));
+        assertEquals(0.5F, FlightMovement.verticalInput(0.5F, 0F, 0F, false, true, true, true, true, creative));
+        assertEquals(0, Float.floatToRawIntBits(FlightMovement.verticalInput(-0.5F, 1F, 0F, true, true, true, true, true, spectator)));
+    }
+
+    @Test
+    void preservesNativeFrictionCutoffSignsAndIndependentAttributes() {
+        final FlightMovementContext context = new FlightMovementContext(1, 6, 0, 2F, false, 2F, 0.5F);
+        final Position3f result = FlightMovement.finish(new Position3f(-1.1920929E-7F, -0F, Math.nextUp(1.1920929E-7F)), 1F, 0F, 0F, context);
+        assertEquals(0x80000000, Float.floatToRawIntBits(result.x()));
+        assertEquals(0x80000000, Float.floatToRawIntBits(result.y()));
+        assertEquals(0x33AEB853, Float.floatToRawIntBits(result.z()));
+    }
+
+    @Test
+    void preservesIndependentFlightValuesAndInheritedModeThroughCodec() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int mode : new int[]{-1, 0, 1, 2, 5, 6}) {
+                final FlightMovementContext context = new FlightMovementContext(1, mode, 1, -0.25F, true, 2F, 0.5F);
+                FlightMovementContext.TYPE.write(buffer, context);
+                assertEquals(context, FlightMovementContext.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnsupportedOrIncompleteFlightSnapshots() {
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            assertThrows(IllegalArgumentException.class, () -> FlightMovementContext.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION - 1);
+            assertThrows(IllegalArgumentException.class, () -> FlightMovementContext.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            assertThrows(IndexOutOfBoundsException.class, () -> FlightMovementContext.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new FlightMovementContext(1, 1, 0, Float.NaN, false, 1F, 1F));
+            assertThrows(IllegalArgumentException.class, () -> new FlightMovementContext(1, 1, 0, 1F, false, Float.POSITIVE_INFINITY, 1F));
+            assertThrows(IllegalArgumentException.class, () -> new FlightMovementContext(1, 1, 0, 1F, false, 1F, Float.NEGATIVE_INFINITY));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
