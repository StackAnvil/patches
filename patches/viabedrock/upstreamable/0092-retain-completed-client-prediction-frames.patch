+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class GeyserMovementReferenceTest {
+
+    @Test
+    void matchesOriginalWorldQueriesAndMotionAcrossPrivateNativeFixtures() throws Exception {
+        final String reference = System.getenv("STACKANVIL_GEYSER_REFERENCE");
+        assumeTrue(reference != null);
+        final JsonArray cases = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonArray();
+        for (final JsonElement element : cases) {
+            final var scenario = element.getAsJsonObject();
+            final Map<Position3f, GeyserMovement.Cell> blocks = new HashMap<>();
+            for (final JsonElement entry : scenario.getAsJsonArray("world")) {
+                final JsonArray cell = entry.getAsJsonArray();
+                final int main = cell.get(3).getAsInt();
+                final int extra = cell.get(4).getAsInt();
+                blocks.put(new Position3f(cell.get(0).getAsFloat(), cell.get(1).getAsFloat(), cell.get(2).getAsFloat()),
+                        new GeyserMovement.Cell(main == 1 || main == 6 || main >= 7, main == 10 || main == 11,
+                                main == 2, extra == 2, main == 2 || main == 4 || extra == 2 || extra == 4));
+            }
+            final JsonArray box = scenario.getAsJsonArray("box");
+            final float result = GeyserMovement.calculate(
+                    new Position3f(box.get(0).getAsFloat(), box.get(1).getAsFloat(), box.get(2).getAsFloat()),
+                    new Position3f(box.get(3).getAsFloat(), box.get(4).getAsFloat(), box.get(5).getAsFloat()),
+                    scenario.get("velocity").getAsFloat(), scenario.get("active").getAsBoolean(), scenario.get("excluded").getAsBoolean(),
+                    (x, y, z) -> blocks.getOrDefault(new Position3f(x, y, z), new GeyserMovement.Cell(false, false, false, false, false)));
+            assertEquals((int) scenario.get("expected").getAsLong(), Float.floatToRawIntBits(result));
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/GeyserMovementTest.java b/src/test/java/net/raphimc/viabedrock/api/model/GeyserMovementTest.java
