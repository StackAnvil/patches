+
+    @Test
+    void matchesNativeRocketImpulseBeforeDamping() {
+        final Case[] cases = {
+            new Case(0F, 0F, 0F, -180F, 0F, -180F, 0F, false,
+                    0xB39E264E, 0xBC108210, 0xBF57A6F1),
