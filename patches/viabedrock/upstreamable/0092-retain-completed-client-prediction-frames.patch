+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Connection-scoped pairing for a correction payload followed by its standard Java position packet. */
+public final class PlayerCorrectionTracker {
+
+    private PlayerCorrection pending;
+
+    public void accept(final PlayerCorrection correction) {
+        this.pending = correction;
+    }
+
+    public PlayerCorrection consumePlayer(final int teleportId) {
+        final PlayerCorrection correction = this.pending;
+        this.clear();
+        return correction != null && !correction.vehicle() && correction.teleportId() == teleportId ? correction : null;
+    }
+
+    public PlayerCorrection consumeVehicle(final Position3f position, final float yaw, final float pitch) {
+        final PlayerCorrection correction = this.pending;
+        this.clear();
+        return correction != null && correction.vehicle() && correction.javaPosition().equals(position)
+                && correction.javaYaw() == yaw && correction.rotation().x() == pitch ? correction : null;
+    }
+
+    public void clear() {
+        this.pending = null;
+    }
+
+}
