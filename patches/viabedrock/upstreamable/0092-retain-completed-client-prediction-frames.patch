+    @Test
+    void distinguishesAnAbsentComponentFromAnAbsentMovementModifier() {
+        final CompoundTag components = new CompoundTag();
+        assertEquals(ItemUseModifiers.DEFAULT, ItemUseModifiers.fromNetworkComponents(components));
+        final CompoundTag modifiers = new CompoundTag();
+        components.put("minecraft:use_modifiers", modifiers);
+        assertEquals(ItemUseModifiers.NONE, ItemUseModifiers.fromNetworkComponents(components));
