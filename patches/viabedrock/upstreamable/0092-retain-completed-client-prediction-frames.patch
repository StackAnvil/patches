+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MovementCollisionWorldTest {
+
+    @Test
+    void visitsPaddedColumnsInNativeOrderAndSkipsUnavailableColumns() {
+        final var query = new CollisionContact.Box(-0.2F, -0.2F, -0.2F, 0.2F, 0.2F, 0.2F);
+        final List<List<Integer>> columns = new ArrayList<>();
+        final List<List<Integer>> blocks = new ArrayList<>();
+        MovementCollisionWorld.blocks(query, -1, 1, (x, z) -> {
+            columns.add(List.of(x, z));
+            return x == 0 && z == 0 || x == 1 && z == -1;
+        }, (x, y, z) -> blocks.add(List.of(x, y, z)));
+        assertEquals(List.of(-2, -2), columns.getFirst());
+        assertEquals(List.of(1, 1), columns.getLast());
+        assertEquals(16, columns.size());
+        assertEquals(List.of(List.of(0, -1, 0), List.of(0, 0, 0), List.of(0, 1, 0),
+                List.of(1, -1, -1), List.of(1, 0, -1), List.of(1, 1, -1)), blocks);
+        MovementCollisionWorld.blocks(query, 1, 1, (x, z) -> {
+            fail();
+            return true;
+        }, (x, y, z) -> fail());
+    }
+
+    @Test
+    void scansPaddedChunksBeforeCreatingUnavailableAndBelowWorldBarriers() {
+        final var query = new CollisionContact.Box(-0.2F, -60F, -0.2F, 0.2F, -58F, 0.2F);
+        final List<List<Integer>> chunks = new ArrayList<>();
+        final List<CollisionContact.Box> barriers = new ArrayList<>();
+        MovementCollisionWorld.unloaded(query, (x, z) -> {
+            chunks.add(List.of(x, z));
+            return x == -1 && z == -1;
+        }, barriers::add);
+        assertEquals(List.of(List.of(-1, -1), List.of(0, -1), List.of(-1, 0), List.of(0, 0)), chunks);
+        assertEquals(List.of(new CollisionContact.Box(0F, -100000F, -16F, 16F, 100000F, 0F),
+                new CollisionContact.Box(-16F, -100000F, 0F, 0F, 100000F, 16F),
+                new CollisionContact.Box(0F, -100000F, 0F, 16F, 100000F, 16F)), barriers);
+        assertEquals(new CollisionContact.Box(-0.2F, -Float.MAX_VALUE, -0.2F, 0.2F, -56F, 0.2F),
+                MovementCollisionWorld.belowWorld(query, -16));
+        assertNull(MovementCollisionWorld.belowWorld(query, -64));
+    }
+
+}
