+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MovementEffectTimelineTest {
+
+    @Test
+    void boundsLateBoostsToConfirmedFramesAndRejectsOlderConfirmations() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 10; frame++) {
+            assertEquals(frame, timeline.completeFrame());
+        }
+        timeline.accept(new MovementEffect(1, 0, 20, 100, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        assertFalse(timeline.hasGlideBoost(2));
+        timeline.accept(new MovementEffect(1, 0, 1, 99, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        for (int frame = 10; frame < 20; frame++) {
+            assertTrue(timeline.hasGlideBoost(1));
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, 5, 101, 0));
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, -1, 102, -1));
+        assertFalse(timeline.hasGlideBoost(1));
+    }
+
+    @Test
+    void keepsActorsAndEffectKindsIndependentAndClearsConnectionState() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        timeline.accept(new MovementEffect(1, 0, -1, Long.MIN_VALUE, 0));
+        timeline.accept(new MovementEffect(1, 0, 0, Long.MAX_VALUE, 0));
+        timeline.accept(new MovementEffect(1, 1, 0, Long.MIN_VALUE, 0));
+        timeline.accept(new MovementEffect(2, 2, -1, 0, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        assertFalse(timeline.hasGlideBoost(2));
+        timeline.retainEntities(id -> id != 1);
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(2, 0, 1, 0, 0));
+        assertTrue(timeline.hasGlideBoost(2));
+        assertEquals(0, timeline.completeFrame());
+        assertFalse(timeline.hasGlideBoost(2));
+        timeline.clear();
+        assertFalse(timeline.hasGlideBoost(2));
+        assertEquals(0, timeline.completeFrame());
+    }
+
+}
