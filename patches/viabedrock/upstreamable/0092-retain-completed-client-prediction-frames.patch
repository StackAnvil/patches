+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class GlideMovementTest {
+
+    @Test
+    void matchesNativeFloatVelocityAcrossTurnsAndSlowFalling() {
+        // Numeric results from the pinned 1.26.51.1 glide kernel, without a boost.
+        // These include angle seams, ascent, descent, and multiplication-order regressions.
+        final Case[] cases = {
+            new Case(0.125F, -0.5F, -1.25F, -180F, 0F, -180F, 0F, false,
+                    0x3DE41891, 0xBEEAD2DD, 0xBFA468D5),
+            new Case(2F, 0.1F, 0.5F, -180F, 0F, -180F, 0F, false,
+                    0x3FE41893, 0x3DA09031, 0x3E773335),
+            new Case(0.125F, -0.5F, -1.25F, -180F, 0F, -180F, 0F, true,
+                    0x3DE41891, 0xBEE2EBC4, 0xBFA435BD),
+            new Case(2F, 0.1F, 0.5F, -180F, 0F, -180F, 0F, true,
+                    0x3FE41893, 0x3DC3AFBC, 0x3E773335),
+            new Case(0.125F, -0.5F, -1.25F, -90F, 0F, -90F, 0F, false,
+                    0x3DE41892, 0xBED256BB, 0xBF98BF88),
+            new Case(0.125F, -0.5F, -1.25F, -89.999F, 0F, -89.999F, 0F, false,
+                    0x3DE41894, 0xBED256BB, 0xBF845F31),
+            new Case(0.125F, -0.5F, -1.25F, -45F, 0F, -45F, 0F, false,
+                    0x3DE41895, 0xBECD1E6D, 0xBF7F1D2E),
+            new Case(0.125F, -0.5F, -1.25F, -45F, 0F, -45F, 0F, true,
+                    0x3DE41895, 0xBEB843B2, 0xBF7F9CEA),
+            new Case(0.125F, -0.5F, -1.25F, 0F, 0F, 0F, 0F, false,
+                    0x3DE41895, 0xBEEAD2DD, 0xBF716BC6),
+            new Case(0.125F, -0.5F, -1.25F, 45F, 0F, 45F, 0F, false,
+                    0x3DE41895, 0xBF0315B6, 0xBF770265),
+            new Case(0.125F, -0.5F, -1.25F, 45F, 0F, 45F, 0F, true,
+                    0x3DE41895, 0xBEF150B2, 0xBF778221),
+            new Case(0.125F, -0.5F, -1.25F, 89.999F, 0F, 89.999F, 0F, false,
+                    0x3DFD70A4, 0xBF1182A9, 0xBF9E6666),
+            new Case(0.125F, -0.5F, -1.25F, 90F, 0F, 90F, 0F, false,
+                    0x3DFD70A4, 0xBF1182A9, 0xBF9E6666),
+            new Case(0.125F, -0.5F, -1.25F, 180F, 0F, 180F, 0F, false,
+                    0x3DE41891, 0xBEEAD2DD, 0xBFA468D5),
+            new Case(2F, 0.1F, 0.5F, 180F, 720F, 180F, 0F, true,
+                    0x3FE41893, 0x3DC3AFB9, 0x3E773335),
+            new Case(1.6333389F, -3.0968435F, -0.2979446F, 14.151753F, 2026.8854F, -48.434772F, -5738.8184F, false,
+                    0x3FE210F8, 0xC0314FC9, 0xBF0E7392),
+            new Case(0.82603735F, -2.439322F, 1.9346125F, 31.666914F, 7057.995F, 54.236145F, 5645.232F, true,
+                    0x3F761708, 0xC00E2D13, 0x3FB7B771)
+        };
+        for (final Case value : cases) {
+            final Position3f motion = GlideMovement.calculate(new Position3f(value.x(), value.y(), value.z()),
+                    value.pitch(), value.yaw(), value.previousPitch(), value.previousYaw(), value.slowFalling(), false);
+            assertEquals(value.expectedX(), Float.floatToRawIntBits(motion.x()));
+            assertEquals(value.expectedY(), Float.floatToRawIntBits(motion.y()));
+            assertEquals(value.expectedZ(), Float.floatToRawIntBits(motion.z()));
+        }
+    }
+
+    @Test
+    void matchesNativeRocketImpulseBeforeDamping() {
+        final Case[] cases = {
+            new Case(0F, 0F, 0F, -180F, 0F, -180F, 0F, false,
+                    0xB39E264E, 0xBC108210, 0xBF57A6F1),
+            new Case(2F, 0.1F, 0.5F, -180F, 0F, -180F, 0F, false,
+                    0x3F641892, 0x3D20901D, 0xBF388625),
+            new Case(0F, 0F, 0F, -180F, 0F, -180F, 0F, true,
+                    0xB39E00D5, 0xBA908434, 0xBF5773D9),
+            new Case(2F, 0.1F, 0.5F, -180F, 0F, -180F, 0F, true,
+                    0x3F641892, 0x3D43AFA8, 0xBF388625),
+            new Case(0.125F, -0.5F, -1.25F, -180F, 180F, -180F, -180F, false,
+                    0x3D641893, 0xBE6AD2E2, 0x3EBD6D53),
+            new Case(0.125F, -0.5F, -1.25F, -180F, 180F, -180F, -180F, true,
+                    0x3D641893, 0xBE62EBC9, 0x3EBD0723),
+            new Case(0F, 0F, 0F, -90F, 0F, -90F, 0F, false,
+                    0xA7E7B6E5, 0x3F4B367B, 0xB39DFB7B),
+            new Case(2F, 0.1F, 0.5F, -90F, 0F, -90F, 0F, false,
+                    0x3F641893, 0x3F78DB97, 0x3E2137F0),
+            new Case(0F, 0F, 0F, -90F, -180F, -90F, 180F, true,
+                    0x00000000, 0x3F53FE5D, 0x339DFB7B),
+            new Case(2F, 0.1F, 0.5F, -90F, -180F, -90F, 180F, true,
+                    0x3F641893, 0x3F80D1BC, 0x3E937C9C),
+            new Case(0F, 0F, 0F, -89.999F, 0F, -89.999F, 0F, false,
+                    0x2CF7DAFB, 0x3F4B367B, 0x38A8FCBB),
+            new Case(2F, 0.1F, 0.5F, -89.999F, 0F, -89.999F, 0F, false,
+                    0x3F641894, 0x3F78DB97, 0x3E938729),
+            new Case(0F, 0F, 0F, -45F, 0F, -45F, 0F, false,
+                    0x335FD6C7, 0x3F10D4A9, 0x3F189CE6),
+            new Case(2F, 0.1F, 0.5F, -45F, 0F, -45F, 0F, false,
+                    0x3F641895, 0x3F34778D, 0x3F64D360),
+            new Case(0F, 0F, 0F, 0F, 0F, 0F, 0F, false,
+                    0x339E264E, 0xBC1081C3, 0x3F57A6F1),
+            new Case(2F, 0.1F, 0.5F, 0F, 0F, 0F, 0F, false,
+                    0x3F641895, 0x3D20902E, 0x3F954938),
+            new Case(2F, 0.1F, 0.5F, 0F, -180F, 0F, 180F, false,
+                    0x3F641893, 0x3D20902E, 0xBF388625)
+        };
+        for (final Case value : cases) {
+            final Position3f motion = GlideMovement.calculate(new Position3f(value.x(), value.y(), value.z()),
+                    value.pitch(), value.yaw(), value.previousPitch(), value.previousYaw(), value.slowFalling(), true);
+            assertEquals(value.expectedX(), Float.floatToRawIntBits(motion.x()));
+            assertEquals(value.expectedY(), Float.floatToRawIntBits(motion.y()));
+            assertEquals(value.expectedZ(), Float.floatToRawIntBits(motion.z()));
+        }
+    }
+
+    private record Case(float x, float y, float z, float pitch, float yaw, float previousPitch, float previousYaw,
+                        boolean slowFalling, int expectedX, int expectedY, int expectedZ) {
+    }
+
+}
