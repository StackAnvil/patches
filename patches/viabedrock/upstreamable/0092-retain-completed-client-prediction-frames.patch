+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.ShortTag;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.Enchant_Type;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockItemEnchantmentTest {
+
+    @Test
+    void readsOnlyTheFirstMatchingTypedEnchantmentWithoutChangingItemData() {
+        final var tag = new CompoundTag();
+        final var enchantments = new ListTag<>(CompoundTag.class);
+        enchantments.add(enchantment(Enchant_Type.Protection, 4));
+        enchantments.add(enchantment(Enchant_Type.SwiftSneak, 2));
+        enchantments.add(enchantment(Enchant_Type.SwiftSneak, 3));
+        tag.put("ench", enchantments);
+        final var item = new BedrockItem(1, (short) 0, (byte) 1, tag);
+        assertEquals(2, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        assertEquals(4, item.enchantmentLevel(Enchant_Type.Protection));
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.DepthStrider));
+        assertEquals(3, enchantments.size());
+        assertSame(tag, item.tag());
+        item.setAmount(0);
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+    }
+
+    @Test
+    void missingAndIncorrectTagTypesDoNotInventEquippedEnchantments() {
+        final var tag = new CompoundTag();
+        final var item = new BedrockItem(1, (short) 0, (byte) 1, tag);
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        tag.put("ench", new IntTag(37));
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        final var enchantments = new ListTag<>(CompoundTag.class);
+        final var badId = enchantment(Enchant_Type.SwiftSneak, 3);
+        badId.put("id", new IntTag(Enchant_Type.SwiftSneak.getValue()));
+        final var badLevel = enchantment(Enchant_Type.SwiftSneak, 3);
+        badLevel.put("lvl", new IntTag(3));
+        enchantments.add(badId);
+        enchantments.add(badLevel);
+        tag.put("ench", enchantments);
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        enchantments.add(enchantment(Enchant_Type.SwiftSneak, 1));
+        assertEquals(0, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        assertEquals(3, item.enchantmentLevel(Enchant_Type.Protection));
+        enchantments.getValue().remove(badLevel);
+        assertEquals(1, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        final var wrappedId = enchantment(Enchant_Type.SwiftSneak, 2);
+        wrappedId.put("id", new ShortTag((short) (256 + Enchant_Type.SwiftSneak.getValue())));
+        enchantments.getValue().clear();
+        enchantments.add(wrappedId);
+        assertEquals(2, item.enchantmentLevel(Enchant_Type.SwiftSneak));
+        assertEquals(0, BedrockItem.empty().enchantmentLevel(Enchant_Type.SwiftSneak));
+    }
+
+    private static CompoundTag enchantment(final Enchant_Type type, final int level) {
+        final var tag = new CompoundTag();
+        tag.put("id", new ShortTag((short) type.getValue()));
+        tag.put("lvl", new ShortTag((short) level));
+        return tag;
+    }
+
+}
