+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+/** Native unsigned input clocks bound to the connection's monotonically increasing physics frames. */
+public record MovementCorrectionTiming(long serverTick, long inputTick, long inputFrame, long historyStartTick, long followingFrame) {
+
+    public MovementCorrectionTiming {
+        if (inputFrame < 0 || followingFrame < -1) {
+            throw new IllegalArgumentException("Invalid correction frame binding");
+        }
+    }
+
+    /** The receiver queues into the following snapshot, capped at the newest retained snapshot. */
+    public Placement locate(final long oldestFrame, final long completedFrame) {
+        return this.locate(oldestFrame, completedFrame, false);
+    }
+
+    /** Explicit velocity commands clamp old clocks to the oldest retained native input. */
+    public Placement locateMotion(final long oldestFrame, final long completedFrame) {
+        return this.locate(oldestFrame, completedFrame, true);
+    }
+
+    private Placement locate(final long oldestFrame, final long completedFrame, final boolean clampExpired) {
+        if (this.serverTick == 0 || oldestFrame < 0 || completedFrame < oldestFrame || this.inputFrame > completedFrame) {
+            return null;
+        }
+        final long age = this.inputTick - this.historyStartTick;
+        final long oldest = Long.compareUnsigned(age, this.inputFrame) <= 0
+                ? Math.max(oldestFrame, this.inputFrame - age) : oldestFrame;
+        if (oldest > completedFrame) {
+            return null;
+        }
+        final long clock = this.inputTick + completedFrame - this.inputFrame;
+        final long firstTick = this.inputTick + oldest - this.inputFrame;
+        final long serverTick = clampExpired && Long.compareUnsigned(this.serverTick, firstTick) < 0 ? firstTick : this.serverTick;
+        if (Long.compareUnsigned(serverTick, firstTick) < 0) {
+            return null;
+        }
+        if (serverTick == clock) {
+            return completedFrame == Long.MAX_VALUE ? null : new Placement(completedFrame + 1, true, true);
+        }
+        final long offset = serverTick - firstTick;
+        final long last = completedFrame - oldest;
+        // Cap before adding one: unsigned MAX_VALUE must not wrap back to the oldest frame.
+        final long target = Long.compareUnsigned(offset, last) < 0 && this.followingFrame >= oldest && this.followingFrame <= completedFrame
+                ? this.followingFrame : Long.compareUnsigned(offset, last) >= 0 ? completedFrame : oldest + offset + 1;
+        return new Placement(target, Long.compareUnsigned(serverTick, clock) < 0, false);
+    }
+
+    public record Placement(long frame, boolean dirty, boolean pending) { }
+
+}
