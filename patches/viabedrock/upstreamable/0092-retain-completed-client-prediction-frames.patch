+        when(user.get(EntityTracker.class)).thenReturn(tracker);
+        when(user.get(PlayerPredictionStorage.class)).thenReturn(predictions);
+        when(user.get(VehiclePredictionStorage.class)).thenReturn(vehicles);
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        when(tracker.getClientPlayer()).thenReturn(player);
+        final var boat = new BoatEntity(user, 3, 4, "minecraft:boat", 32, UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+        when(tracker.getEntityByRid(boat.runtimeId())).thenReturn(boat);
+        when(tracker.isLocallyControlledVehicle(boat)).thenReturn(true);
+        final UUID lifetime = boat.nativeActorSnapshot().lifetime();
+        for (int changed = 0; changed < 6; changed++) {
