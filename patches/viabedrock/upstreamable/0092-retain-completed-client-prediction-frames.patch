+package net.raphimc.viabedrock.api.model;
+
+/** Native SwiftSneakEnchantComponent retains its initial level until unequipped or replaced by an unenchanted item. */
+public final class SwiftSneakState {
+
+    private int level;
+
+    public void update(final int equippedLevel) {
+        if (equippedLevel <= 0) {
+            this.level = 0;
+        } else if (this.level == 0) {
+            this.level = equippedLevel;
+        }
+    }
+
+    public void restore(final int level) {
+        if (level < 0) {
+            throw new IllegalArgumentException("Negative Swift Sneak level");
+        }
+        this.level = level;
+    }
+
+    public int level() {
+        return this.level;
+    }
+
+}
