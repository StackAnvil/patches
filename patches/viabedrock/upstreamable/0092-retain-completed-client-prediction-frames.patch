+        final var channels = new ChannelStorage();
+        when(user.get(any())).thenAnswer(call -> mock((Class<?>) call.getArgument(0)));
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        when(user.get(EntityTracker.class)).thenReturn(tracker);
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        when(user.has(EntityTracker.class)).thenReturn(true);
+        when(tracker.nativeActorsJoined()).thenReturn(true);
+        final var actor = new Entity(user, -170, 91, "minecraft:player", 1, UUID.randomUUID(), EntityTypes26_3.PLAYER);
+        when(tracker.getEntityByUid(actor.uniqueId())).thenReturn(actor);
