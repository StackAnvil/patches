@@ -0,0 +1,74 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.function.Consumer;
+
+/** Native 1.26.51.1 collision-world traversal and unavailable-region geometry. */
+public final class MovementCollisionWorld {
+
+    private MovementCollisionWorld() {
+    }
+
+    /** The native chunk scan advances X first and includes eight blocks of horizontal padding. */
+    public static void unloaded(final CollisionContact.Box query, final ColumnPredicate loaded, final Consumer<CollisionContact.Box> shapes) {
+        final int minX = (floor(query.minX()) - 8) >> 4;
+        final int minZ = (floor(query.minZ()) - 8) >> 4;
+        final int maxX = (floor(query.maxX()) + 8) >> 4;
+        final int maxZ = (floor(query.maxZ()) + 8) >> 4;
+        for (int z = minZ; z <= maxZ; z++) {
+            for (int x = minX; x <= maxX; x++) {
+                if (!loaded.test(x, z)) {
+                    shapes.accept(new CollisionContact.Box(x * 16, -100000F, z * 16, x * 16 + 16, 100000F, z * 16 + 16));
+                }
+            }
+        }
+    }
+
+    public static CollisionContact.Box belowWorld(final CollisionContact.Box query, final int minimumY) {
+        return query.maxY() < minimumY ? new CollisionContact.Box(query.minX(), -Float.MAX_VALUE, query.minZ(),
+                query.maxX(), (short) (minimumY - 40), query.maxZ()) : null;
+    }
+
+    /** Loaded columns advance X/Z, then visit Y from bottom to top, including the upper endpoint. */
+    public static void blocks(final CollisionContact.Box query, final int minimumY, final int maximumY,
+                              final ColumnPredicate loaded, final BlockVisitor visitor) {
+        final int minY = Math.max(floor(query.minY() - 1F), minimumY);
+        final int maxY = Math.min(floor(query.maxY() + 1F), maximumY);
+        if (minY >= maxY) {
+            return;
+        }
+        final int minX = floor(query.minX() - 1F);
+        final int minZ = floor(query.minZ() - 1F);
+        final int maxX = floor(query.maxX() + 1F);
+        final int maxZ = floor(query.maxZ() + 1F);
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                if (loaded.test(x, z)) {
+                    for (int y = minY; y <= maxY; y++) {
+                        visitor.accept(x, y, z);
+                    }
+                }
+            }
+        }
+    }
+
+    private static int floor(final float value) {
+        final int integer = (int) value;
+        return value < integer ? integer - 1 : integer;
+    }
+
+    @FunctionalInterface
+    public interface ColumnPredicate {
+        boolean test(int x, int z);
+    }
+
+    @FunctionalInterface
+    public interface BlockVisitor {
+        void accept(int x, int y, int z);
+    }
+
+}
