+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ServerboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+import net.raphimc.viabedrock.api.model.PlayerPosture;
+import net.raphimc.viabedrock.api.model.PlayerPrediction;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.PlayerPredictionStorage;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerPredictionPacketTest {
+
+    @Test
+    void replayedPayloadCannotRebindConsumedPhysicsToAnotherInputTick() throws Exception {
+        final PlayerPredictionStorage predictions = new PlayerPredictionStorage();
+        final ChannelStorage channels = new ChannelStorage();
+        channels.addChannels(List.of(PlayerInputPermissions.CHANNEL));
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+                new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) ->
+                        method.getName().equals("getClientState") ? State.PLAY : null);
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> switch (method.getName()) {
+                    case "getProtocolInfo" -> info;
+                    case "get" -> args[0] == ChannelStorage.class ? channels
+                            : args[0] == PlayerPredictionStorage.class ? predictions : null;
+                    default -> null;
+                });
+        final PlayerPrediction previous = new PlayerPrediction(42, Position3f.ZERO, new Position3f(0F, -0.022315647F, 0F),
+                new PlayerPosture(true, false, false), false, false, false, true, 1F);
+        accept(user, previous);
+        final PlayerPrediction consumed = predictions.take(Position3f.ZERO);
+        assertEquals(previous, consumed);
+        predictions.remember(91, consumed);
+        assertEquals(42, predictions.clientFrame(91));
+
+        accept(user, previous);
+        final PlayerPrediction replay = predictions.take(Position3f.ZERO);
+        assertNull(replay);
+        predictions.remember(92, replay);
+        assertEquals(-1, predictions.clientFrame(92));
+        assertEquals(92, predictions.inputTick());
+        assertEquals(-1, predictions.inputFrame());
+        assertEquals(42, predictions.clientFrame(91));
+
+        final PlayerPrediction current = new PlayerPrediction(43, Position3f.ZERO, Position3f.ZERO,
+                PlayerPosture.STANDING, true, true, true, false, 1F);
+        accept(user, current);
+        accept(user, previous);
+        final PlayerPrediction next = predictions.take(Position3f.ZERO);
+        assertEquals(current, next);
+        predictions.remember(93, next);
+        assertEquals(43, predictions.clientFrame(93));
+        assertEquals(43, predictions.inputFrame());
+    }
+
+    private static void accept(final UserConnection user, final PlayerPrediction prediction) throws Exception {
+        final var input = Unpooled.buffer();
+        try {
+            Types.STRING.write(input, PlayerPrediction.CHANNEL);
+            PlayerPrediction.TYPE.write(input, prediction);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, input, user);
+            MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(input.isReadable());
+        } finally {
+            input.release();
+        }
+    }
+
+}
