@@ -0,0 +1,72 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.util.Objects;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Full-precision live velocity plus its placement in the actor's retained input history. */
+public record ActorMotionCommand(int entityId, UUID uuid, UUID lifetime, long vehicleEpoch,
+                                 MovementCorrectionTiming timing, Position3f motion) {
+
+    public static final String CHANNEL = "viabedrock:actor_motion_v1";
+    public static final int MAX_PAYLOAD_BYTES = 160;
+    public static final Type<ActorMotionCommand> TYPE = new Type<>(ActorMotionCommand.class) {
+        @Override
+        public ActorMotionCommand read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported actor motion command");
+            }
+            final var value = new ActorMotionCommand(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer), Types.UUID.read(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), new MovementCorrectionTiming(Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer)), new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat()));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing actor motion command data");
+            }
+            return value;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final ActorMotionCommand value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.entityId);
+            Types.UUID.write(buffer, value.uuid);
+            Types.UUID.write(buffer, value.lifetime);
+            Types.VAR_LONG.writePrimitive(buffer, value.vehicleEpoch);
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.serverTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.inputTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.inputFrame());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.historyStartTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.followingFrame());
+            buffer.writeFloat(value.motion.x());
+            buffer.writeFloat(value.motion.y());
+            buffer.writeFloat(value.motion.z());
+        }
+    };
+
+    public ActorMotionCommand {
+        Objects.requireNonNull(uuid);
+        Objects.requireNonNull(lifetime);
+        Objects.requireNonNull(timing);
+        Objects.requireNonNull(motion);
+        if (timing.serverTick() == 0 || !Float.isFinite(motion.x()) || !Float.isFinite(motion.y()) || !Float.isFinite(motion.z())) {
+            throw new IllegalArgumentException("Invalid actor motion command");
+        }
+    }
+
+    public boolean vehicle() {
+        return this.vehicleEpoch != -1;
+    }
+
+}
