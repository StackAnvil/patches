+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerCorrectionTest {
+
+    @Test
+    void retainsCorrectionIdentityAndRejectsIncompatibleWireFormats() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (boolean ground : new boolean[]{false, true}) {
+                for (long tick : new long[]{0, 1, Long.MAX_VALUE}) {
+                    final PlayerCorrection correction = new PlayerCorrection(42, Integer.MIN_VALUE, tick, ground);
+                    PlayerCorrection.TYPE.write(buffer, correction);
+                    assertEquals(correction, PlayerCorrection.TYPE.read(buffer));
+                    assertFalse(buffer.isReadable());
+                    buffer.clear();
+                }
+            }
+            for (int version : new int[]{0, 2}) {
+                Types.VAR_INT.writePrimitive(buffer, version);
+                assertThrows(IllegalArgumentException.class, () -> PlayerCorrection.TYPE.read(buffer));
+                buffer.clear();
+            }
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerCorrection.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new PlayerCorrection(42, 0, 0, true));
+            assertThrows(IllegalArgumentException.class, () -> new PlayerCorrection(42, -1, -1, true));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void appliesOnlyToTheMatchingPlayerAndPositionPacketOnce() {
+        final PlayerCorrectionTracker tracker = new PlayerCorrectionTracker();
+        final PlayerCorrection correction = new PlayerCorrection(42, -3, 10, false);
+        tracker.accept(correction);
+        assertSame(correction, tracker.consume(42, -3));
+        assertNull(tracker.consume(42, -3));
+        tracker.accept(correction);
+        assertNull(tracker.consume(43, -3));
+        assertNull(tracker.consume(42, -3));
+        tracker.accept(correction);
+        assertNull(tracker.consume(42, -4));
+        assertNull(tracker.consume(42, -3));
+        tracker.accept(correction);
+        tracker.clear();
+        assertNull(tracker.consume(42, -3));
+        tracker.accept(correction);
+        final PlayerCorrection replacement = new PlayerCorrection(42, -4, 11, true);
+        tracker.accept(replacement);
+        assertSame(replacement, tracker.consume(42, -4));
+    }
+
+}
