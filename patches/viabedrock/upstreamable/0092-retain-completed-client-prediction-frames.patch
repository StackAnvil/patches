+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerPredictionStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MovementEffectPacketsTest {
+
+    @Test
+    void retainsCoreStateAndTransportsTickBindingsOnlyToRegisteredClients() throws Exception {
+        for (boolean supported : new boolean[]{false, true}) {
+            final EntityTracker[] trackers = new EntityTracker[1];
+            final ChannelStorage channels = new ChannelStorage();
+            final PlayerPredictionStorage predictions = new PlayerPredictionStorage();
+            predictions.remember(91, new PlayerPrediction(42, Position3f.ZERO, Position3f.ZERO,
+                    PlayerPosture.STANDING, false, false, false, false, 1F));
+            if (supported) {
+                channels.addChannels(List.of(MovementEffect.CHANNEL));
+            }
+            final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+                    new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) ->
+                            method.getName().equals("getServerState") ? State.PLAY : null);
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                    new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                        if (method.getName().equals("getProtocolInfo")) {
+                            return info;
+                        }
+                        if (method.getName().equals("get")) {
+                            if (args[0] == EntityTracker.class) {
+                                return trackers[0];
+                            }
+                            if (args[0] == ChannelStorage.class) {
+                                return channels;
+                            }
+                            if (args[0] == PlayerPredictionStorage.class) {
+                                return predictions;
+                            }
+                        }
+                        return null;
+                    });
+            final EntityTracker tracker = trackers[0] = new EntityTracker(user);
+            final ClientPlayerEntity player = tracker.addEntity(new ClientPlayerEntity(user, 1, UUID.randomUUID(),
+                    new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+            for (int type : new int[]{0, 1, 2}) {
+                for (long tick : new long[]{91, 92, 0}) {
+                    final var input = Unpooled.buffer();
+                    final var output = Unpooled.buffer();
+                    try {
+                        BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, player.runtimeId());
+                        BedrockTypes.VAR_INT.writePrimitive(input, type);
+                        BedrockTypes.VAR_INT.writePrimitive(input, -1);
+                        BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, tick);
+                        final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.MOVEMENT_EFFECT, input, user);
+                        new TestProtocol().translate(packet);
+                        final MovementEffect effect = new MovementEffect(player.javaId(), type, -1, tick, tick == 91 ? 42 : -1, 91, 42, predictions.oldestInputTick());
+                        assertEquals(effect, player.movementEffect(MovementEffectType.getByValue(type)));
+                        assertEquals(!supported, packet.isCancelled());
+                        if (supported) {
+                            packet.writeToBuffer(output);
+                            assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD.getId(), Types.VAR_INT.readPrimitive(output));
+                            assertEquals(MovementEffect.CHANNEL, Types.STRING.read(output));
+                            assertEquals(effect, MovementEffect.TYPE.read(output));
+                            assertFalse(output.isReadable());
+                        }
+                    } finally {
+                        input.release();
+                        output.release();
+                    }
+                }
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        TestProtocol() {
+            MovementEffectPackets.register(this);
+        }
+
+        void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
