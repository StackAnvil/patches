+class FlightMovementSnapshotTest {
+
+    @Test
+    void gatesAndRefreshesActualSnapshotsAcrossJoinModeAbilitiesMetadataAndAttributeChanges() {
+        try (Fixture fixture = new Fixture()) {
+            final TestPlayer player = fixture.player;
+            fixture.setLevelGameType(GameType.Survival);
+            player.setGameType(GameType.Default);
+            player.sendFlightMovementSnapshot();
+            assertTrue(fixture.snapshots.isEmpty());
+            fixture.channels.addChannels(List.of(FlightMovementContext.CHANNEL));
+            player.sendFlightMovementSnapshot();
+            assertTrue(fixture.snapshots.isEmpty());
+            fixture.state = State.CONFIGURATION;
+            fixture.tracker.markNativeActorsJoined();
+            assertTrue(fixture.snapshots.isEmpty());
+            fixture.state = State.PLAY;
+            fixture.tracker.sendFlightMovementSnapshot();
+            assertEquals(new FlightMovementContext(1, 5, 0, 1F, false, 1F, 1F), fixture.last());
+
+            fixture.setLevelGameType(GameType.Creative);
+            player.updateJavaGameMode();
+            assertEquals(1, fixture.last().levelGameType());
+            assertEquals(5, fixture.last().gameType());
+            player.setGameType(GameType.Spectator);
+            assertEquals(6, fixture.last().gameType());
+
+            final PlayerAbilities abilities = new PlayerAbilities(7, (byte) 0, (byte) 0);
+            abilities.abilityLayers().put(SerializedAbilitiesData_SerializedAbilitiesLayer.Base,
+                    new PlayerAbilities.AbilitiesLayer(EnumSet.of(AbilitiesIndex.VerticalFlySpeed, AbilitiesIndex.FlySpeed),
+                            EnumSet.noneOf(AbilitiesIndex.class), 0.1F, 0.0125F, 2F));
+            player.setAbilities(abilities, PacketWrapper.create(ClientboundPackets26_3.PLAYER_ABILITIES, fixture.user));
+            assertEquals(2F, fixture.last().verticalSpeed());
+            assertEquals(6, fixture.last().gameType());
+
+            player.entityData().put(ActorDataIds.RESERVED_092,
+                    new EntityData(ActorDataIds.RESERVED_092.getValue(), EntityDataTypesBedrock.LONG, Long.MIN_VALUE));
+            player.finishUpdate();
+            assertTrue(fixture.last().legacyFriction());
+            final int before = fixture.snapshots.size();
+            player.updateAttributes(new EntityAttribute[]{new EntityAttribute("minecraft:friction_modifier", 2F, -10F, 10F),
+                new EntityAttribute("minecraft:air_drag_modifier", 0.5F, -10F, 10F)},
+                    PacketWrapper.create(ClientboundPackets26_3.UPDATE_ATTRIBUTES, fixture.user));
+            assertEquals(before + 1, fixture.snapshots.size());
+            assertEquals(2F, fixture.last().frictionModifier());
+            assertEquals(0.5F, fixture.last().dragModifier());
+            player.entityData().remove(ActorDataIds.RESERVED_092);
+            player.finishUpdate();
+            assertFalse(fixture.last().legacyFriction());
+        }
+        try (Fixture fresh = new Fixture()) {
+            fresh.setLevelGameType(GameType.Survival);
+            fresh.player.setGameType(GameType.Survival);
+            fresh.channels.addChannels(List.of(FlightMovementContext.CHANNEL));
+            fresh.tracker.markNativeActorsJoined();
+            assertEquals(new FlightMovementContext(1, 0, 0, 1F, false, 1F, 1F), fresh.last());
+        }
+    }
+
+    @Test
+    void permitsChannelRegistrationBeforeTheLocalPlayerExists() {
+        try (Fixture fixture = new Fixture()) {
+            fixture.channels.addChannels(List.of(FlightMovementContext.CHANNEL));
+            final EntityTracker empty = new EntityTracker(fixture.user);
+            empty.sendFlightMovementSnapshot();
+            empty.markNativeActorsJoined();
+            assertTrue(empty.nativeActorsJoined());
+            assertTrue(fixture.snapshots.isEmpty());
+        }
+    }
+
+    private static final class TestPlayer extends ClientPlayerEntity {
+        private TestPlayer(final UserConnection user) {
+            super(user, 8, UUID.randomUUID(), new PlayerAbilities(7, (byte) 0, (byte) 0));
+        }
+
+        private void finishUpdate() {
+            this.finishEntityDataUpdate(new ArrayList<>());
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private State state = State.PLAY;
+        private final List<FlightMovementContext> snapshots = new ArrayList<>();
+        private final ChannelStorage channels = new ChannelStorage();
+        private final ProtocolInfo info = mock(ProtocolInfo.class);
+        private final UserConnection user = mock(UserConnection.class);
+        private final GameSessionStorage session = mock(GameSessionStorage.class);
+        private final EntityTracker tracker = new EntityTracker(this.user);
+        private final MockedStatic<PacketWrapper> wrappers = mockStatic(PacketWrapper.class);
+        private final MockedStatic<PacketFactory> packets = mockStatic(PacketFactory.class);
+        private final TestPlayer player;
+
+        private Fixture() {
+            when(this.user.getProtocolInfo()).thenReturn(this.info);
+            when(this.info.getServerState()).thenAnswer(call -> this.state);
+            when(this.user.get(GameSessionStorage.class)).thenReturn(this.session);
+            when(this.user.get(EntityTracker.class)).thenReturn(this.tracker);
+            when(this.user.get(ChannelStorage.class)).thenReturn(this.channels);
+            this.setLevelGameType(GameType.Survival);
+            this.wrappers.when(() -> PacketWrapper.create(any(PacketType.class), eq(this.user)))
+                    .thenAnswer(call -> this.packet(call.getArgument(0)));
+            this.player = this.tracker.addEntity(new TestPlayer(this.user), false);
+        }
+
+        private void setLevelGameType(final GameType gameType) {
+            when(this.session.getLevelGameType()).thenReturn(gameType);
+        }
+
+        private PacketWrapper packet(final PacketType type) {
+            final PacketWrapperImpl wrapper = spy(new PacketWrapperImpl(type, null, this.user));
+            doAnswer(call -> {
+                final ByteBuf packet = Unpooled.buffer();
+                try {
+                    wrapper.writeToBuffer(packet);
+                    assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD.getId(), Types.VAR_INT.readPrimitive(packet));
+                    assertEquals(FlightMovementContext.CHANNEL, Types.STRING.read(packet));
+                    this.snapshots.add(FlightMovementContext.TYPE.read(packet));
+                    assertFalse(packet.isReadable());
+                } finally {
+                    packet.release();
+                }
+                return null;
+            }).when(wrapper).send(eq(BedrockProtocol.class), eq(true));
+            return wrapper;
+        }
+
+        private FlightMovementContext last() {
+            return this.snapshots.getLast();
+        }
+
+        @Override
+        public void close() {
+            this.packets.close();
+            this.wrappers.close();
+        }
+    }
+
+}
