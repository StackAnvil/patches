+            actor.entityData().put(ActorDataIds.RESERVED_053, new EntityData(53, EntityDataTypesBedrock.FLOAT, .6F));
+            actor.entityData().put(ActorDataIds.RESERVED_054, new EntityData(54, EntityDataTypesBedrock.FLOAT, 2.1F));
+            actor.sendNativeActorSnapshot();
+            assertEquals(7, messages.size());
+            assertEquals(2, bounds.size());
+            assertEquals(.6F, bounds.getLast().width());
+            assertEquals(2.1F, bounds.getLast().height());
+            actor.entityData().put(ActorDataIds.RESERVED_054, new EntityData(54, EntityDataTypesBedrock.FLOAT, 3F));
+            actor.sendNativeActorSnapshot();
+            actor.sendNativeActorSnapshot();
+            assertEquals(3, bounds.size());
+            assertEquals(.6F, bounds.getLast().width());
+            assertEquals(3F, bounds.getLast().height());
+            capability(user, "minecraft:unregister", NativeActorBoundsMessage.CHANNEL);
+            actor.entityData().put(ActorDataIds.RESERVED_054, new EntityData(54, EntityDataTypesBedrock.FLOAT, 4F));
+            actor.sendNativeActorSnapshot();
+            assertEquals(3, bounds.size());
+            capability(user, "minecraft:register", NativeActorBoundsMessage.CHANNEL);
+            assertEquals(4, bounds.size());
+            assertEquals(4F, bounds.getLast().height());
+            assertEquals(actor.nativeActorSnapshot().lifetime(), bounds.getLast().lifetime());
+            actor.remove();
+            assertInstanceOf(NativeActorMessage.Remove.class, messages.getLast());
+            assertEquals(List.of(NativeActorMessage.CHANNEL, NativeActorMessage.CURRENT_CHANNEL,
+                    NativeActorMessage.CHANNEL, NativeActorMessage.CURRENT_CHANNEL, NativeActorMessage.CHANNEL,
+                    NativeActorMessage.CURRENT_CHANNEL, NativeActorMessage.CURRENT_CHANNEL, NativeActorMessage.CURRENT_CHANNEL,
+                    NativeActorMessage.CURRENT_CHANNEL), selected);
+            assertEquals(messages.getFirst().lifetime(), messages.getLast().lifetime());
+        }
+    }
+
+    private static void capability(final UserConnection user, final String channel, final String capability) throws Exception {
+        final var bytes = Unpooled.buffer();
+        try {
+            Types.STRING.write(bytes, channel);
+            bytes.writeBytes(capability.getBytes(StandardCharsets.UTF_8));
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, bytes, user);
+            MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(packet);
+            assertTrue(packet.isCancelled());
+            assertFalse(bytes.isReadable());
+        } finally {
+            bytes.release();
+        }
+    }
+
+}
