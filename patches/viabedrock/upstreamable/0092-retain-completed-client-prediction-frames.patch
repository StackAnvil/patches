+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MovementCollisionQueryTest {
+
+    @Test
+    void reusesOnlyStrictlyInsideTheNativeSquaredPositionLimit() {
+        assertTrue(MovementCollisionQuery.reuses(Position3f.ZERO, Position3f.ZERO));
+        assertTrue(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(Math.nextDown(2F), 0F, 0F)));
+        assertFalse(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(2F, 0F, 0F)));
+        assertFalse(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(-2F, 0F, 0F)));
+        assertTrue(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(1F, 1F, 1F)));
+        assertFalse(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(1.5F, 1.5F, 0F)));
+        assertFalse(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(Float.NaN, 0F, 0F)));
+        assertFalse(MovementCollisionQuery.reuses(Position3f.ZERO, new Position3f(Float.POSITIVE_INFINITY, 0F, 0F)));
+    }
+
+    @Test
+    void capsTheWholeMotionVectorBeforeBuildingStepAndLowerInsetBounds() {
+        final Position3f motion = new Position3f(12F, 0F, 16F);
+        assertEquals(new Position3f(9.6F, 0F, 12.8F), MovementCollisionQuery.cap(motion));
+        final Position3f boundary = new Position3f(16F, 0F, 0F);
+        assertSame(boundary, MovementCollisionQuery.cap(boundary));
+        final var body = new CollisionContact.Box(0F, 0F, 0F, 0.6F, 1.8F, 0.6F);
+        final var query = MovementCollisionQuery.bounds(body, new Position3f(1F, -0.08F, 0F), 0.6F);
+        assertEquals(new CollisionContact.Box(0F, -0.606F, 0F, 1.6F, 2.4F, 0.6F), query);
+        assertTrue(MovementCollisionQuery.contains(query, body));
+    }
+
+    @Test
+    void leavesContainedQueriesAloneAndFetchesDisjointRegionsOnce() {
+        final var query = new CollisionContact.Box(-1F, -1F, -1F, 1F, 1F, 1F);
+        assertTrue(MovementCollisionQuery.missing(query, query).isEmpty());
+        assertEquals(java.util.List.of(query), MovementCollisionQuery.missing(query, null));
+        assertEquals(java.util.List.of(query), MovementCollisionQuery.missing(query,
+                new CollisionContact.Box(1F, -1F, -1F, 3F, 1F, 1F)));
+        final var half = new CollisionContact.Box(0F, 0F, 0F, 0.5F, 1F, 1F);
+        final var whole = new CollisionContact.Box(0F, 0F, 0F, 1F, 1F, 1F);
+        final var missing = MovementCollisionQuery.missing(whole, half);
+        assertEquals(1, missing.size());
+        assertEquals(new CollisionContact.Box(0.50001F, 0.00001F, 0.00001F, 1F, 1F, 1F), missing.getFirst());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/MovementCollisionWorldTest.java b/src/test/java/net/raphimc/viabedrock/api/model/MovementCollisionWorldTest.java
