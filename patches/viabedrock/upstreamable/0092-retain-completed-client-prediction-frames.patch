+                    BedrockTypes.VAR_INT.read(bytes);
+                }
+                for (int i = 0; i < 3; i++) {
+                    BedrockTypes.VAR_INT.read(bytes);
+                }
+                BedrockTypes.FLOAT_LE.read(bytes);
+                BedrockTypes.FLOAT_LE.read(bytes);
+                final long tick = BedrockTypes.UNSIGNED_VAR_LONG.read(bytes);
+                final Position3f velocity = BedrockTypes.POSITION_3F.read(bytes);
+                for (int i = 0; i < 3; i++) {
+                    assertFalse(Types.BOOLEAN.read(bytes));
+                }
+                if (Types.BOOLEAN.read(bytes)) {
+                    BedrockTypes.POSITION_2F.read(bytes);
+                }
