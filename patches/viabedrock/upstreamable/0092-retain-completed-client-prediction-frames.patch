+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.viaversion.api.minecraft.item.data.UseEffects;
+
+/** Native ItemUseSlowdownSystem produces a modifier; its apply system squares it. */
+public record ItemUseModifiers(float movementModifier, boolean emitVibrations) {
+
+    public static final ItemUseModifiers DEFAULT = new ItemUseModifiers(0.35F, true);
+    public static final ItemUseModifiers NONE = new ItemUseModifiers(1F, true);
+
+    public ItemUseModifiers {
+        if (!Float.isFinite(movementModifier) || !Float.isFinite(movementModifier * movementModifier)) {
+            throw new IllegalArgumentException("Non-finite item-use movement modifier");
+        }
+    }
+
+    public static ItemUseModifiers fromNetworkComponents(final CompoundTag components) {
+        if (!(components.get("minecraft:use_modifiers") instanceof CompoundTag modifiers)) {
+            return DEFAULT;
+        }
+        final float movement = modifiers.get("movement_modifier") instanceof NumberTag value ? value.asFloat() : 1F;
+        final boolean vibrations = !(modifiers.get("emit_vibrations") instanceof NumberTag value) || value.asByte() != 0;
+        return new ItemUseModifiers(movement, vibrations);
+    }
+
+    public boolean allowsSprinting() {
+        // Native omits the slowdown component at this float epsilon boundary.
+        return Math.abs(this.movementModifier - 1F) <= Math.ulp(1F);
+    }
+
+    public float movementScale() {
+        return this.allowsSprinting() ? 1F : this.movementModifier * this.movementModifier;
+    }
+
+    public UseEffects javaComponent() {
+        return new UseEffects(this.allowsSprinting(), this.emitVibrations, this.movementScale());
+    }
+
+    public static Position2f apply(final Position2f input, final float scale) {
+        return new Position2f(input.x() * scale, input.y() * scale);
+    }
+
+}
