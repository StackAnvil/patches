+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.Objects;
+
+/** Completed motion of the controlling local vehicle, paired with a player frame. */
+public record VehiclePrediction(long frameId, VehiclePredictionContext context, Position3f position, Position3f motion) {
+
+    public static final String CHANNEL = "viabedrock:vehicle_prediction_v1";
+    public static final Type<VehiclePrediction> TYPE = new Type<>(VehiclePrediction.class) {
+        @Override
+        public VehiclePrediction read(final ByteBuf buffer) {
+            VehiclePredictionContext.readHeader(buffer);
+            final long frameId = Types.VAR_LONG.readPrimitive(buffer);
+            final VehiclePrediction frame = new VehiclePrediction(frameId, VehiclePredictionContext.readContext(buffer), readVector(buffer), readVector(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected vehicle prediction fields");
+            }
+            return frame;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final VehiclePrediction value) {
+            VehiclePredictionContext.writeHeader(buffer);
+            Types.VAR_LONG.writePrimitive(buffer, value.frameId());
+            VehiclePredictionContext.writeContext(buffer, value.context());
+            writeVector(buffer, value.position());
+            writeVector(buffer, value.motion());
+        }
+    };
+
+    public VehiclePrediction {
+        Objects.requireNonNull(context, "context");
+        Objects.requireNonNull(context.vehicle(), "vehicle");
+        if (frameId < 0) {
+            throw new IllegalArgumentException("Invalid vehicle prediction frame identity");
+        }
+        requireFinite(position);
+        requireFinite(motion);
+    }
+
+    public boolean matches(final Position3f position) {
+        return close(this.position.x(), position.x()) && close(this.position.y(), position.y()) && close(this.position.z(), position.z());
+    }
+
+    private static boolean close(final float expected, final float actual) {
+        return Math.abs(expected - actual) <= Math.max(0.001F, Math.ulp(actual) * 2F);
+    }
+
+    private static void requireFinite(final Position3f vector) {
+        if (vector == null || !Float.isFinite(vector.x()) || !Float.isFinite(vector.y()) || !Float.isFinite(vector.z())) {
+            throw new IllegalArgumentException("Non-finite vehicle prediction");
+        }
+    }
+
+    private static Position3f readVector(final ByteBuf buffer) {
+        return new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat());
+    }
+
+    private static void writeVector(final ByteBuf buffer, final Position3f vector) {
+        buffer.writeFloat(vector.x());
+        buffer.writeFloat(vector.y());
+        buffer.writeFloat(vector.z());
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/VehiclePredictionContext.java b/src/main/java/net/raphimc/viabedrock/api/model/VehiclePredictionContext.java
