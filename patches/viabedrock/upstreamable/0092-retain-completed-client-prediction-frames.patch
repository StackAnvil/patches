+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.api.util.MathUtil;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData;
+
+import java.util.EnumSet;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerPostureTest {
+
+    private static final PlayerPosture.Space OPEN = new PlayerPosture.Space(true, true, true);
+    private static final PlayerPosture.Space CROUCH = new PlayerPosture.Space(false, true, true);
+    private static final PlayerPosture.Space CRAWL = new PlayerPosture.Space(false, false, true);
+    private static final PlayerPosture.Space BLOCKED = new PlayerPosture.Space(false, false, false);
+
+    @Test
+    void scalesDiagonalSneakInputWithNativeFloatArithmeticAndEnchantmentCap() {
+        final float[] expected = {0.3F, 0.45000002F, 0.6F, 0.75F, 0.90000004F, 1F};
+        final var sneaking = new PlayerPosture(false, false, true);
+        final var forward = EnumSet.of(PlayerAuthInputData.Up);
+        final var diagonal = EnumSet.of(PlayerAuthInputData.Up, PlayerAuthInputData.Left);
+        for (int level = 0; level < expected.length; level++) {
+            final float scale = sneaking.sneakingInputScale(level);
+            assertEquals(expected[level], scale);
+            final var cardinal = MathUtil.calculateMovementDirections(forward, scale);
+            assertEquals(0F, cardinal.x());
+            assertEquals(scale, cardinal.y());
+            final var scaledDiagonal = MathUtil.calculateMovementDirections(diagonal, scale);
+            assertEquals(-(float) (1D / Math.sqrt(2)) * scale, scaledDiagonal.x());
+            assertEquals(-scaledDiagonal.x(), scaledDiagonal.y());
+        }
+        assertEquals(0.3F, sneaking.sneakingInputScale(-1));
+        assertEquals(1F, sneaking.sneakingInputScale(Short.MAX_VALUE));
+        assertEquals(0.3F, PlayerPosture.STANDING.sneakingInputScale(3));
+        assertEquals(0.75F, new PlayerPosture(false, true, false).sneakingInputScale(3));
+        assertEquals(1F, MathUtil.calculateMovementDirections(forward, 1F).y());
+    }
+
+    @Test
+    void swapsSwimmingAndCrawlingBeforeServerMetadataArrives() {
+        var posture = new PlayerPosture(true, false, false);
+        posture = posture.next(CRAWL, input(false, false, 1F));
+        assertEquals(new PlayerPosture(false, true, false), posture);
+        assertEquals(posture, posture.next(CRAWL, input(false, false, 1F)));
+        posture = posture.next(CRAWL, input(false, true, 1F));
+        assertEquals(new PlayerPosture(true, false, false), posture);
+        assertEquals(posture, posture.next(CRAWL, input(false, true, 1F)));
+    }
+
+    @Test
+    void clearsCrawlingInStandingSpaceWithoutChangingTheSwimmingTrigger() {
+        for (boolean swimming : new boolean[]{false, true}) {
+            final var posture = new PlayerPosture(swimming, true, true);
+            assertEquals(new PlayerPosture(swimming, false, false), posture.next(OPEN, input(false, false, 0F)));
+            assertEquals(new PlayerPosture(swimming, false, true), posture.next(OPEN, input(true, false, 0F)));
+        }
+    }
+
+    @Test
+    void forcesCrouchingWhenOnlyCrouchingSpaceIsClear() {
+        assertEquals(new PlayerPosture(false, false, true), PlayerPosture.STANDING.next(CROUCH, input(false, false, 0F)));
+        assertEquals(new PlayerPosture(true, false, true),
+                new PlayerPosture(true, true, false).next(CROUCH, input(false, true, 1F)));
+        // A sneak lock suppresses physical sneak, but cannot create standing space.
+        assertEquals(new PlayerPosture(false, false, true), PlayerPosture.STANDING.next(CROUCH,
+                new PlayerPosture.Input(true, true, false, false, 0F, true)));
+    }
+
+    @Test
+    void usesTheNativeFloatBoundaryToLeaveSwimmingInCrouchingSpace() {
+        final var posture = new PlayerPosture(true, false, false);
+        final float boundary = Math.nextDown(0.5F);
+        assertEquals(new PlayerPosture(false, false, true), posture.next(CROUCH, input(false, true, Math.nextDown(boundary))));
+        assertSame(posture, posture.next(CROUCH, input(false, true, boundary)));
+        assertSame(posture, posture.next(CROUCH, input(false, true, Math.nextUp(boundary))));
+    }
+
+    @Test
+    void retainsPostureWhenEvenTheCrawlingBodyCannotFit() {
+        final var posture = new PlayerPosture(true, true, true);
+        assertEquals(new PlayerPosture(true, true, false), posture.next(BLOCKED, input(false, false, 1F)));
+        assertEquals(posture, posture.next(BLOCKED, input(true, false, 1F)));
+        assertEquals(new PlayerPosture(true, true, false), posture.next(CRAWL,
+                new PlayerPosture.Input(false, false, false, false, 1F, false)));
+    }
+
+    @Test
+    void forceStandingAndSneakLocksDoNotClearSwimming() {
+        final var posture = new PlayerPosture(true, true, true);
+        assertEquals(new PlayerPosture(true, false, false), posture.next(BLOCKED,
+                new PlayerPosture.Input(true, true, true, true, 1F, true)));
+        assertEquals(new PlayerPosture(true, false, true), posture.next(BLOCKED,
+                new PlayerPosture.Input(true, false, true, true, 1F, true)));
+    }
+
+    @Test
+    void preservesSneakingAcrossCrawlSwimTransitionsUntilTheNativeBranchChangesIt() {
+        final var sneaking = new PlayerPosture(false, false, true);
+        final var crawl = sneaking.next(CRAWL, input(false, false, 0F));
+        assertEquals(new PlayerPosture(false, true, true), crawl);
+        final var swim = crawl.next(CRAWL, input(false, true, 0F));
+        assertEquals(new PlayerPosture(true, false, true), swim);
+        assertEquals(new PlayerPosture(true, false, false), swim.next(CRAWL, input(false, true, 0F)));
+    }
+
+    @Test
+    void rejectsMovementThatCannotDescribeAnInputVector() {
+        for (float movement : new float[]{-1F, Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> input(false, false, movement));
+        }
+    }
+
+    @Test
+    void waterSwimmingAndFlightBypassPostureInputScaling() {
+        for (boolean crawling : new boolean[]{false, true}) {
+            for (boolean sneaking : new boolean[]{false, true}) {
+                for (boolean held : new boolean[]{false, true}) {
+                    assertFalse(new PlayerPosture(true, crawling, sneaking).slowsMovementInput(held, false, false));
+                    assertFalse(new PlayerPosture(false, crawling, sneaking).slowsMovementInput(held, true, false));
+                    assertFalse(new PlayerPosture(false, crawling, sneaking).slowsMovementInput(held, false, true));
+                }
+            }
+        }
+        assertFalse(PlayerPosture.STANDING.slowsMovementInput(false, false, false));
+        assertTrue(PlayerPosture.STANDING.slowsMovementInput(true, false, false));
+        assertTrue(new PlayerPosture(false, true, false).slowsMovementInput(false, false, false));
+        assertTrue(new PlayerPosture(false, false, true).slowsMovementInput(false, false, false));
+    }
+
+    @Test
+    void inputScalingChangesAfterSwimCrawlTransitions() {
+        final var swimming = new PlayerPosture(true, false, false);
+        assertFalse(swimming.slowsMovementInput(false, false, false));
+        final var crawling = swimming.next(CRAWL, input(false, false, 1F));
+        assertTrue(crawling.slowsMovementInput(false, false, false));
+        assertFalse(crawling.slowsMovementInput(false, false, true));
+        final var reentered = crawling.next(CRAWL, input(false, true, 1F));
+        assertFalse(reentered.slowsMovementInput(false, false, false));
+    }
+
+    private static PlayerPosture.Input input(final boolean sneak, final boolean water, final float movement) {
+        return new PlayerPosture.Input(sneak, false, false, water, movement, true);
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/PlayerPredictionTest.java b/src/test/java/net/raphimc/viabedrock/api/model/PlayerPredictionTest.java
