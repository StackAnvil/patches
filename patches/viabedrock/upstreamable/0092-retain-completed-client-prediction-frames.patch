+            new Case(0.125F, -0.5F, -1.25F, 89.999F, 0F, 89.999F, 0F, false,
+                    0x3DFD70A4, 0xBF1182A9, 0xBF9E6666),
+            new Case(0.125F, -0.5F, -1.25F, 90F, 0F, 90F, 0F, false,
+                    0x3DFD70A4, 0xBF1182A9, 0xBF9E6666),
+            new Case(0.125F, -0.5F, -1.25F, 180F, 0F, 180F, 0F, false,
+                    0x3DE41891, 0xBEEAD2DD, 0xBFA468D5),
+            new Case(2F, 0.1F, 0.5F, 180F, 720F, 180F, 0F, true,
+                    0x3FE41893, 0x3DC3AFB9, 0x3E773335),
+            new Case(1.6333389F, -3.0968435F, -0.2979446F, 14.151753F, 2026.8854F, -48.434772F, -5738.8184F, false,
