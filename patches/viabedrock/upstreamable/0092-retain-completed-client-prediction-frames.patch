+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class CollisionContactTest {
+
+    @Test
+    void clipsEveryFaceAndPreservesTangentialMotion() {
+        final CollisionContact.Box body = new CollisionContact.Box(0F, 0F, 0F, 1F, 1F, 1F);
+        final CollisionContact.Box[] obstacles = {
+            new CollisionContact.Box(1.25F, 0F, 0F, 2F, 1F, 1F),
+            new CollisionContact.Box(-1F, 0F, 0F, -0.25F, 1F, 1F),
+            new CollisionContact.Box(0F, 1.25F, 0F, 1F, 2F, 1F),
+            new CollisionContact.Box(0F, -1F, 0F, 1F, -0.25F, 1F),
+            new CollisionContact.Box(0F, 0F, 1.25F, 1F, 1F, 2F),
+            new CollisionContact.Box(0F, 0F, -1F, 1F, 1F, -0.25F)
+        };
+        for (int face = 0; face < obstacles.length; face++) {
+            final float speed = face % 2 == 0 ? 0.75F : -0.75F;
+            final int axis = face / 2;
+            final Position3f requested = new Position3f(axis == 0 ? speed : 0.1F, axis == 1 ? speed : 0.2F, axis == 2 ? speed : 0.3F);
+            final Position3f expected = new Position3f(axis == 0 ? speed / 3F : requested.x(), axis == 1 ? speed / 3F : requested.y(), axis == 2 ? speed / 3F : requested.z());
+            assertEquals(expected, CollisionContact.clip(obstacles[face], body, requested));
+            final Position3f away = new Position3f(-requested.x(), -requested.y(), -requested.z());
+            assertSame(away, CollisionContact.clip(obstacles[face], body, away));
+        }
+    }
+
+    @Test
+    void snapsBothSidesOfTheNativeContactThreshold() {
+        final CollisionContact.Box wall = new CollisionContact.Box(0F, 0F, 0F, 1F, 1F, 1F);
+        final Position3f toward = new Position3f(0.014F, 0F, 0F);
+        for (final float depth : new float[]{-0.000001F, -Math.nextDown(0.000001F), 0F, Math.nextDown(0.000001F), 0.000001F}) {
+            final CollisionContact.Box body = new CollisionContact.Box(-1F, 0.1F, 0.1F, depth, 0.9F, 0.9F);
+            assertEquals(0x80000000, Float.floatToRawIntBits(CollisionContact.clip(wall, body, toward).x()));
+        }
+        final float outside = Math.nextUp(0.000001F);
+        assertEquals(outside, CollisionContact.clip(wall, new CollisionContact.Box(-1F, 0.1F, 0.1F, -outside, 0.9F, 0.9F), toward).x());
+        assertSame(toward, CollisionContact.clip(wall, new CollisionContact.Box(-1F, 0.1F, 0.1F, outside, 0.9F, 0.9F), toward));
+    }
+
+    @Test
+    void leavesCornersDegenerateObstaclesAndDeepOverlapToTheActorSolver() {
+        final CollisionContact.Box body = new CollisionContact.Box(0F, 0F, 0F, 1F, 1F, 1F);
+        final Position3f requested = new Position3f(0.5F, -0F, 0.5F);
+        assertSame(requested, CollisionContact.clip(new CollisionContact.Box(1F, 0F, 1F, 2F, 1F, 2F), body, requested));
+        assertSame(requested, CollisionContact.clip(new CollisionContact.Box(1F, 0F, 0F, 1F, 1F, 1F), body, requested));
+        assertSame(requested, CollisionContact.clip(new CollisionContact.Box(0.5F, 0.5F, 0.5F, 2F, 2F, 2F), body, requested));
+    }
+
+}
