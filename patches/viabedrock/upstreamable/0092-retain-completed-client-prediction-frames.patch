+
+public final class MovementEffectPackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.MOVEMENT_EFFECT, null, wrapper -> {
+            final long runtimeId = wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG);
+            final int type = wrapper.read(BedrockTypes.VAR_INT);
+            final int duration = wrapper.read(BedrockTypes.VAR_INT);
+            final long tick = wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG);
+            if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                throw new IllegalArgumentException("Unexpected movement effect fields");
+            }
+            final Entity entity = wrapper.user().get(EntityTracker.class).getEntityByRid(runtimeId);
+            if (entity == null) {
+                wrapper.cancel();
+                return;
+            }
+            final PlayerPredictionStorage predictions = wrapper.user().get(PlayerPredictionStorage.class);
+            final long frame = predictions.clientFrame(tick);
+            final boolean localPlayer = entity == wrapper.user().get(EntityTracker.class).getClientPlayer();
+            final MovementEffect effect = new MovementEffect(entity.javaId(), type, duration, tick, frame,
+                    localPlayer ? predictions.inputTick() : 0, localPlayer ? predictions.inputFrame() : -1, predictions.oldestInputTick());
+            entity.setMovementEffect(effect);
+            if (wrapper.user().get(ChannelStorage.class).hasChannel(MovementEffect.CHANNEL)) {
+                wrapper.setPacketType(ClientboundPackets26_3.CUSTOM_PAYLOAD);
+                wrapper.write(Types.STRING, MovementEffect.CHANNEL);
+                wrapper.write(MovementEffect.TYPE, effect);
+            } else {
+                wrapper.cancel();
+            }
+        });
+    }
+
+    private MovementEffectPackets() {
+    }
+
+}
