--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/MovementEffectTimeline.java
@@ -0,0 +1,432 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.MovementEffectType;
+
+import java.util.EnumMap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.SequencedMap;
+import java.util.Set;
+import java.util.function.IntPredicate;
+
+/** Client frame clock, local effect prediction and server confirmations. */
+public final class MovementEffectTimeline {
+
+    private long completedFrame = -1;
+    private final Map<Integer, Map<MovementEffectType, EffectState>> effects = new HashMap<>();
+    private final SequencedMap<Long, Frame> history = new LinkedHashMap<>();
+    private final List<Command> pending = new ArrayList<>();
+    private final Set<Integer> movementMasks = new HashSet<>();
+    private Frame capturing;
+
+    /** Open the input record before local world and player simulation. Repeated calls do not replace it. */
+    public void beginFrame() {
+        if (this.capturing != null) {
+            return;
+        }
+        this.capturing = new Frame(this.completedFrame + 1);
+        this.history.put(this.capturing.id, this.capturing);
+        this.effects.forEach((entityId, states) -> {
+            final Map<MovementEffectType, EffectSnapshot> snapshot = new EnumMap<>(MovementEffectType.class);
+            states.forEach((type, state) -> snapshot.put(type, new EffectSnapshot(state.effect, state.predictedFrame,
+                    state.remainingAt(this.completedFrame), state.presentAt(this.completedFrame))));
+            this.capturing.effects.put(entityId, snapshot);
+        });
+        for (Command command : this.pending) {
+            this.enqueue(this.capturing, command, true);
+        }
+        this.pending.clear();
+        if (this.history.size() > 1000) {
+            this.history.pollFirstEntry();
+        }
+    }
+
+    public long frameId() {
+        return this.completedFrame + 1;
+    }
+
+    /** Immutable values for one actor; command and frame ownership remain in this timeline. */
+    public EffectValues captureValues(final int entityId) {
+        return new EffectValues(this.effects.getOrDefault(entityId, Map.of()));
+    }
+
+    public void restoreValues(final int entityId, final EffectValues snapshot) {
+        final Map<MovementEffectType, EffectState> restored = new EnumMap<>(MovementEffectType.class);
+        restored.putAll(snapshot.values);
+        this.effects.put(entityId, restored);
+    }
+
+    public long pendingPhysicalFrame(final IntPredicate predictedActor) {
+        return this.history.values().stream()
+                .filter(frame -> frame.dirtyActors.stream().anyMatch(id -> predictedActor.test(id) && this.movementMasks.contains(id)))
+                .mapToLong(frame -> frame.id).findFirst().orElse(-1);
+    }
+
+    /** Called after restored snapshots and between-frame writes, before the recorded physical input. */
+    public void applyPhysicalCommands(final long frameId, final IntPredicate predictedActor) {
+        final Frame frame = this.history.get(frameId);
+        if (frame == null) {
+            return;
+        }
+        for (int entityId : Set.copyOf(this.effects.keySet())) {
+            if (!predictedActor.test(entityId)) {
+                continue;
+            }
+            final Map<MovementEffectType, EffectSnapshot> snapshot = new EnumMap<>(MovementEffectType.class);
+            this.effects.get(entityId).forEach((type, value) -> snapshot.put(type,
+                    new EffectSnapshot(value.effect, value.predictedFrame, value.remainingAt(frameId - 1), value.presentAt(frameId - 1))));
+            frame.effects.put(entityId, snapshot);
+        }
+        frame.inputs.removeIf(input -> predictedActor.test(input.entityId()));
+        for (Command command : frame.commands) {
+            final MovementEffect effect = command.effect;
+            if (!predictedActor.test(effect.entityId())) {
+                continue;
+            }
+            this.effects.computeIfAbsent(effect.entityId(), ignored -> new EnumMap<>(MovementEffectType.class))
+                    .put(MovementEffectType.getByValue(effect.type()),
+                            new ReplayValue(effect, -1, effect.duration() < -1 ? 0 : effect.duration(), true).snapshot(frameId - 1));
+        }
+    }
+
+    public void finishPhysicalReplay(final IntPredicate predictedActor) {
+        this.movementMasks.removeIf(predictedActor::test);
+        this.history.values().forEach(frame -> frame.dirtyActors.removeIf(predictedActor::test));
+    }
+
+    public long completeFrame() {
+        this.capturing = null;
+        return ++this.completedFrame;
+    }
+
+    public void accept(final MovementEffect effect) {
+        final MovementEffectType type = MovementEffectType.getByValue(effect.type());
+        if (type == null) {
+            return;
+        }
+        if (effect.inputFrame() >= 0) {
+            final long age = effect.inputTick() - effect.historyStartTick();
+            if (Long.compareUnsigned(age, effect.inputFrame()) <= 0) {
+                final long oldestFrame = effect.inputFrame() - age;
+                while (!this.history.isEmpty() && this.history.firstEntry().getKey() < oldestFrame) {
+                    this.history.pollFirstEntry();
+                }
+            }
+        }
+        final Map<MovementEffectType, EffectState> actorEffects = this.effects.computeIfAbsent(effect.entityId(), ignored -> new EnumMap<>(MovementEffectType.class));
+        final EffectState previous = actorEffects.get(type);
+        final EffectState incoming = this.state(effect, -1);
+        final boolean knownIncomingState = effect.hasTiming();
+        final boolean forced = previous != null && knownIncomingState
+                && previous.activeAt(this.completedFrame) != incoming.activeAt(this.completedFrame);
+        // Native commands clear their ordering timestamp after application. Only local prediction
+        // can retain a newer timestamp; an active/inactive transition forces application regardless.
+        if (previous == null || previous.predictedFrame() < 0 || !previous.activeAt(this.completedFrame)
+                || effect.clientFrame() >= previous.predictedFrame()
+                || effect.inputFrame() >= previous.predictedFrame()
+                    && Long.compareUnsigned(effect.serverTick(), effect.inputTick()) >= 0
+                || forced) {
+            actorEffects.put(type, incoming);
+        }
+        // Native command masks compare marker presence, including the zero-duration marker,
+        // with incoming activity. The command remains queued even when its immediate write is ignored.
+        this.schedule(new Command(effect, (previous != null && previous.presentAt(this.completedFrame))
+                != incoming.activeAt(this.completedFrame)));
+    }
+
+    public boolean hasGlideBoost(final int entityId) {
+        return this.hasEffect(entityId, MovementEffectType.GLIDE_BOOST);
+    }
+
+    public boolean hasGlideBoost(final int entityId, final long completedFrame) {
+        final EffectState state = this.effects.getOrDefault(entityId, Map.of()).get(MovementEffectType.GLIDE_BOOST);
+        return state != null && state.activeAt(completedFrame);
+    }
+
+    public boolean hasDolphinBoost(final int entityId) {
+        return this.hasEffect(entityId, MovementEffectType.DOLPHIN_BOOST);
+    }
+
+    public boolean hasDolphinBoost(final int entityId, final long completedFrame) {
+        final EffectState state = this.effects.getOrDefault(entityId, Map.of()).get(MovementEffectType.DOLPHIN_BOOST);
+        return state != null && state.activeAt(completedFrame);
+    }
+
+    public boolean hasGeyserBoost(final int entityId) {
+        return this.hasEffect(entityId, MovementEffectType.GEYSER_BOOST);
+    }
+
+    public boolean hasGeyserBoost(final int entityId, final long completedFrame) {
+        final EffectState state = this.effects.getOrDefault(entityId, Map.of()).get(MovementEffectType.GEYSER_BOOST);
+        return state != null && state.activeAt(completedFrame);
+    }
+
+    /** The native sulfur ticker refreshes a 100-tick effect without shortening a longer active effect. */
+    public void predictGeyserBoost(final int entityId) {
+        this.predictGeyserBoost(entityId, this.completedFrame + 1);
+    }
+
+    public void predictGeyserBoost(final int entityId, final long frame) {
+        final long completedFrame = frame - 1;
+        final MovementEffectType type = MovementEffectType.GEYSER_BOOST;
+        final Map<MovementEffectType, EffectState> actorEffects = this.effects.computeIfAbsent(entityId, ignored -> new EnumMap<>(MovementEffectType.class));
+        final EffectState state = actorEffects.get(type);
+        final MovementEffect previous = state == null ? null : state.effect();
+        if (state != null && state.activeAt(completedFrame)
+                && (state.remainingAt(completedFrame) == -1 || state.remainingAt(completedFrame) > 100)) {
+            return;
+        }
+        // Keep the wire tick as evidence, separately from the native local ordering timestamp.
+        final MovementEffect admission = new MovementEffect(entityId, type.getValue(), 100,
+                previous == null ? 0 : previous.serverTick(), frame, 0, -1, 0);
+        actorEffects.put(type, this.state(admission, frame, completedFrame));
+        final Frame input = this.history.get(frame);
+        if (input != null) {
+            input.inputs.add(admission);
+        }
+    }
+
+    private EffectState state(final MovementEffect effect, final long predictedFrame) {
+        return this.state(effect, predictedFrame, this.completedFrame);
+    }
+
+    private EffectState state(final MovementEffect effect, final long predictedFrame, final long completedFrame) {
+        final long frame = predictedFrame < 0 ? Math.max(0, completedFrame) : completedFrame + 1;
+        final int remaining = effect.remainingAt(frame);
+        final long markerThrough = remaining == -1 ? Long.MAX_VALUE
+                : frame + remaining - (predictedFrame < 0 ? 0 : 1);
+        return new EffectState(effect, predictedFrame, markerThrough, -1, 0);
+    }
+
+    private void schedule(final Command command) {
+        final MovementEffect effect = command.effect;
+        if (effect.inputFrame() < 0 || this.history.isEmpty()) {
+            return;
+        }
+        final long oldest = this.history.firstEntry().getKey();
+        final long clock = effect.inputTick() + this.completedFrame - effect.inputFrame();
+        final long tick = Long.compareUnsigned(effect.serverTick(), effect.historyStartTick()) < 0
+                ? effect.historyStartTick() : effect.serverTick();
+        final boolean future = Long.compareUnsigned(tick, clock) > 0;
+        final long target;
+        if (future) {
+            target = this.completedFrame;
+        } else {
+            final long age = clock - tick;
+            final long correctedFrame;
+            if (tick == effect.serverTick() && effect.clientFrame() >= 0) {
+                correctedFrame = Math.max(oldest, effect.clientFrame());
+            } else if (Long.compareUnsigned(age, this.completedFrame - oldest) >= 0) {
+                correctedFrame = oldest;
+            } else {
+                correctedFrame = this.completedFrame - age;
+            }
+            target = correctedFrame + 1;
+        }
+        final Frame frame = this.history.get(target);
+        if (frame != null) {
+            this.enqueue(frame, command, !future);
+        } else if (target == this.completedFrame + 1) {
+            this.pending.add(command);
+        }
+    }
+
+    private void enqueue(final Frame frame, final Command command, final boolean dirty) {
+        frame.commands.add(command);
+        if (dirty) {
+            frame.dirtyActors.add(command.effect.entityId());
+        }
+        if (command.forcesMovement) {
+            this.movementMasks.add(command.effect.entityId());
+        }
+    }
+
+    /** Replay mutable effect values in native command/input/countdown order, before current physics. */
+    public void replayCorrections() {
+        if (this.history.isEmpty()) {
+            return;
+        }
+        for (int entityId : Set.copyOf(this.movementMasks)) {
+            final Long dirty = this.history.values().stream().filter(frame -> frame.dirtyActors.contains(entityId))
+                    .map(frame -> frame.id).findFirst().orElse(null);
+            if (dirty == null) {
+                continue;
+            }
+            final Map<MovementEffectType, EffectState> states = this.effects.computeIfAbsent(entityId, ignored -> new EnumMap<>(MovementEffectType.class));
+            final Map<MovementEffectType, ReplayValue> values = new EnumMap<>(MovementEffectType.class);
+            final Map<MovementEffectType, EffectSnapshot> restored = this.history.get(dirty).effects.get(entityId);
+            if (restored != null) {
+                restored.forEach((type, snapshot) -> values.put(type, snapshot.restore()));
+            }
+            for (Frame frame : this.history.values()) {
+                if (frame.id < dirty) {
+                    continue;
+                }
+                // Native replay refreshes subsequent snapshots before their commands and inputs.
+                if (frame.id != dirty) {
+                    final Map<MovementEffectType, EffectSnapshot> snapshot = new EnumMap<>(MovementEffectType.class);
+                    values.forEach((type, value) -> snapshot.put(type, value.capture()));
+                    frame.effects.put(entityId, snapshot);
+                }
+                for (Command command : frame.commands) {
+                    if (command.effect.entityId() == entityId) {
+                        final MovementEffect effect = command.effect;
+                        values.put(MovementEffectType.getByValue(effect.type()), new ReplayValue(effect, -1,
+                                effect.duration() < -1 ? 0 : effect.duration(), true));
+                    }
+                }
+                for (MovementEffect input : frame.inputs) {
+                    if (input.entityId() == entityId) {
+                        values.put(MovementEffectType.getByValue(input.type()), new ReplayValue(input, frame.id, input.duration(), true));
+                    }
+                }
+                // An open frame still has to run physical movement, which consumes the duration
+                // before countdown. Completed frames replay their original countdown now.
+                if (frame.id <= this.completedFrame) {
+                    values.values().forEach(ReplayValue::countdown);
+                }
+                frame.dirtyActors.remove(entityId);
+            }
+            states.clear();
+            values.forEach((type, value) -> states.put(type, value.snapshot(this.completedFrame)));
+            this.movementMasks.remove(entityId);
+        }
+    }
+
+    private boolean hasEffect(final int entityId, final MovementEffectType type) {
+        final Map<MovementEffectType, EffectState> actorEffects = this.effects.get(entityId);
+        final EffectState state = actorEffects == null ? null : actorEffects.get(type);
+        return state != null && state.activeAt(this.completedFrame);
+    }
+
+    public void retainEntities(final IntPredicate present) {
+        this.effects.keySet().removeIf(id -> !present.test(id));
+        this.movementMasks.removeIf(id -> !present.test(id));
+        this.pending.removeIf(command -> !present.test(command.effect.entityId()));
+        for (Frame frame : this.history.values()) {
+            frame.effects.keySet().removeIf(id -> !present.test(id));
+            frame.commands.removeIf(command -> !present.test(command.effect.entityId()));
+            frame.inputs.removeIf(input -> !present.test(input.entityId()));
+            frame.dirtyActors.removeIf(id -> !present.test(id));
+        }
+    }
+
+    public void clear() {
+        this.resetHistory();
+        this.completedFrame = -1;
+    }
+
+    /** A replacement play listener discards actor state without reusing the connection's completed frame IDs. */
+    public void resetHistory() {
+        this.effects.clear();
+        this.history.clear();
+        this.pending.clear();
+        this.movementMasks.clear();
+        this.capturing = null;
+    }
+
+    public static final class EffectValues {
+
+        private final Map<MovementEffectType, EffectState> values;
+
+        private EffectValues(final Map<MovementEffectType, EffectState> values) {
+            this.values = Map.copyOf(values);
+        }
+
+        @Override
+        public boolean equals(final Object other) {
+            return other instanceof EffectValues snapshot && this.values.equals(snapshot.values);
+        }
+
+        @Override
+        public int hashCode() {
+            return this.values.hashCode();
+        }
+
+    }
+
+    private record EffectState(MovementEffect effect, long predictedFrame, long markerThroughFrame, long snapshotFrame, int remaining) {
+
+        private int remainingAt(final long completedFrame) {
+            if (this.snapshotFrame >= 0) {
+                return this.remaining == -1 ? -1 : (int) Math.max(0, this.remaining - (completedFrame - this.snapshotFrame));
+            }
+            // Server snapshots describe the completed frame. Native movement consumes their
+            // remaining duration before countdown. Local admission occurs in the next physics step.
+            final long frame = this.predictedFrame < 0 ? Math.max(0, completedFrame) : completedFrame + 1;
+            return this.effect.remainingAt(frame);
+        }
+
+        private boolean activeAt(final long completedFrame) {
+            final int remaining = this.remainingAt(completedFrame);
+            return remaining == -1 || remaining > 0;
+        }
+
+        private boolean presentAt(final long completedFrame) {
+            return completedFrame <= this.markerThroughFrame;
+        }
+    }
+
+    private record EffectSnapshot(MovementEffect effect, long predictedFrame, int remaining, boolean present) {
+
+        private ReplayValue restore() {
+            return new ReplayValue(this.effect, this.predictedFrame, this.remaining, this.present);
+        }
+    }
+
+    private record Command(MovementEffect effect, boolean forcesMovement) {
+    }
+
+    private static final class Frame {
+        private final long id;
+        private final Map<Integer, Map<MovementEffectType, EffectSnapshot>> effects = new HashMap<>();
+        private final List<Command> commands = new ArrayList<>();
+        private final List<MovementEffect> inputs = new ArrayList<>();
+        private final Set<Integer> dirtyActors = new HashSet<>();
+
+        private Frame(final long id) {
+            this.id = id;
+        }
+    }
+
+    private static final class ReplayValue {
+        private final MovementEffect effect;
+        private final long predictedFrame;
+        private int remaining;
+        private boolean present;
+
+        private ReplayValue(final MovementEffect effect, final long predictedFrame, final int remaining, final boolean present) {
+            this.effect = effect;
+            this.predictedFrame = predictedFrame;
+            this.remaining = remaining;
+            this.present = present;
+        }
+
+        private EffectSnapshot capture() {
+            return new EffectSnapshot(this.effect, this.predictedFrame, this.remaining, this.present);
+        }
+
+        private void countdown() {
+            if (this.remaining > 0) {
+                this.remaining--;
+            } else if (this.remaining == 0) {
+                this.present = false;
+            }
+        }
+
+        private EffectState snapshot(final long frame) {
+            final long markerThrough = !this.present ? frame - 1 : this.remaining == -1 ? Long.MAX_VALUE : frame + this.remaining;
+            return new EffectState(this.effect, this.predictedFrame, markerThrough, frame, this.remaining);
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/PlayerCorrection.java b/src/main/java/net/raphimc/viabedrock/api/model/PlayerCorrection.java
new file mode 100644
index 000000000..28d53d634
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/PlayerCorrection.java
@@ -0,0 +1,138 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** Exact native correction, paired with a Java player or controlled-vehicle position packet. */
+public record PlayerCorrection(int entityId, UUID uuid, UUID lifetime, int teleportId, long vehicleEpoch,
+                               MovementCorrectionTiming timing, Position3f position, Position3f motion,
+                               Position2f rotation, Float angularVelocity, float originOffset, float yawOffset, boolean onGround) {
+
+    public static final String CHANNEL = "viabedrock:player_correction_v2";
+    public static final Type<PlayerCorrection> TYPE = new Type<>(PlayerCorrection.class) {
+        @Override
+        public PlayerCorrection read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 2
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported player correction");
+            }
+            final PlayerCorrection correction = new PlayerCorrection(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer),
+                    Types.UUID.read(buffer), Types.VAR_INT.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    new MovementCorrectionTiming(Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                            Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer)),
+                    readVector(buffer), readVector(buffer), new Position2f(buffer.readFloat(), buffer.readFloat()),
+                    buffer.readBoolean() ? buffer.readFloat() : null, buffer.readFloat(), buffer.readFloat(), buffer.readBoolean());
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected player correction fields");
+            }
+            return correction;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerCorrection value) {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.entityId);
+            Types.UUID.write(buffer, value.uuid);
+            Types.UUID.write(buffer, value.lifetime);
+            Types.VAR_INT.writePrimitive(buffer, value.teleportId);
+            Types.VAR_LONG.writePrimitive(buffer, value.vehicleEpoch);
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.serverTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.inputTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.inputFrame());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.historyStartTick());
+            Types.VAR_LONG.writePrimitive(buffer, value.timing.followingFrame());
+            writeVector(buffer, value.position);
+            writeVector(buffer, value.motion);
+            buffer.writeFloat(value.rotation.x());
+            buffer.writeFloat(value.rotation.y());
+            buffer.writeBoolean(value.angularVelocity != null);
+            if (value.angularVelocity != null) {
+                buffer.writeFloat(value.angularVelocity);
+            }
+            buffer.writeFloat(value.originOffset);
+            buffer.writeFloat(value.yawOffset);
+            buffer.writeBoolean(value.onGround);
+        }
+    };
+
+    public PlayerCorrection {
+        Objects.requireNonNull(uuid, "uuid");
+        Objects.requireNonNull(lifetime, "lifetime");
+        Objects.requireNonNull(timing, "timing");
+        if (entityId < 0 || (teleportId == 0 ? vehicleEpoch < 0 : vehicleEpoch != -1)) {
+            throw new IllegalArgumentException("Invalid player correction identity");
+        }
+        requireFinite(position);
+        requireFinite(motion);
+        if (rotation == null || !Float.isFinite(rotation.x()) || !Float.isFinite(rotation.y())
+                || angularVelocity != null && !Float.isFinite(angularVelocity)
+                || !Float.isFinite(originOffset) || !Float.isFinite(yawOffset)) {
+            throw new IllegalArgumentException("Non-finite player correction");
+        }
+    }
+
+    public boolean vehicle() {
+        return this.teleportId == 0;
+    }
+
+    public Position3f javaPosition() {
+        return this.position.subtract(0F, this.originOffset, 0F);
+    }
+
+    public float javaYaw() {
+        return this.rotation.y() - this.yawOffset;
+    }
+
+    /** Match native float subtraction, multiplication and addition order, without wrapped-angle heuristics. */
+    public boolean differs(final Position3f javaPosition, final Position3f velocity, final boolean ground,
+                           final Position2f javaRotation, final Float angular) {
+        final Position3f nativePosition = javaPosition.add(0F, this.originOffset, 0F);
+        return this.onGround != ground || squaredDifference(this.position, nativePosition) > 0.00001F
+                || squaredDifference(this.motion, velocity) > 0.00001F
+                || this.vehicle() && (squaredDifference(this.rotation, new Position2f(javaRotation.x(), javaRotation.y() + this.yawOffset)) > 0.00001F
+                || this.angularVelocity != null && angular != null && Math.abs(angular - this.angularVelocity) > 0.0001F);
+    }
+
+    private static float squaredDifference(final Position3f a, final Position3f b) {
+        final float x = a.x() - b.x();
+        final float y = a.y() - b.y();
+        final float z = a.z() - b.z();
+        return (y * y + x * x) + z * z;
+    }
+
+    private static float squaredDifference(final Position2f a, final Position2f b) {
+        final float x = a.x() - b.x();
+        final float y = a.y() - b.y();
+        return y * y + x * x;
+    }
+
+    private static void requireFinite(final Position3f value) {
+        if (value == null || !Float.isFinite(value.x()) || !Float.isFinite(value.y()) || !Float.isFinite(value.z())) {
+            throw new IllegalArgumentException("Non-finite player correction");
+        }
+    }
+
+    private static Position3f readVector(final ByteBuf buffer) {
+        return new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat());
+    }
+
+    private static void writeVector(final ByteBuf buffer, final Position3f value) {
+        buffer.writeFloat(value.x());
+        buffer.writeFloat(value.y());
+        buffer.writeFloat(value.z());
+    }
+
+}
