+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class MovementEffectTimelineTest {
+
+    @Test
+    void matchesNativeRegisteredMovementBeforeEffectCountdown() throws Exception {
+        final String reference = System.getenv("STACKANVIL_MOVEMENT_PHASE_REFERENCE");
+        assumeTrue(reference != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonArray();
+        for (final var entry : cases) {
+            final var scenario = entry.getAsJsonObject();
+            final int remaining = scenario.getAsJsonArray("initial").get(1).getAsInt();
+            // Zero-duration marker removal needs the full packet/world phase boundary.
+            if (remaining == 0) {
+                continue;
+            }
+            final MovementEffectTimeline timeline = new MovementEffectTimeline();
+            for (int frame = 0; frame <= 10; frame++) {
+                timeline.completeFrame();
+            }
+            final MovementEffect effect = new MovementEffect(1, 2, scenario.get("duration").getAsInt(),
+                    scenario.get("tick").getAsLong(), -1, scenario.get("clock").getAsLong(), 10, 0);
+            timeline.accept(effect);
+            for (final var step : scenario.getAsJsonArray("steps")) {
+                assertEquals(step.getAsJsonObject().get("velocity").getAsFloat() != 0F, timeline.hasGeyserBoost(1));
+                timeline.completeFrame();
+            }
+        }
+    }
+
+    @Test
+    void consumesConfirmedDurationBeforeCountdownWithoutExtendingLocalPrediction() {
+        for (final int duration : new int[]{1, 2, 3, 20, 100}) {
+            final MovementEffectTimeline confirmed = new MovementEffectTimeline();
+            final MovementEffectTimeline predicted = new MovementEffectTimeline();
+            for (int frame = 0; frame <= 10; frame++) {
+                confirmed.completeFrame();
+                predicted.completeFrame();
+            }
+            final MovementEffect effect = new MovementEffect(1, 2, duration, 105, 10, 105, 10, 0);
+            confirmed.accept(effect);
+            predicted.predictGeyserBoost(1);
+            for (int step = 0; step <= 100; step++) {
+                confirmed.accept(effect);
+                assertEquals(step < duration, confirmed.hasGeyserBoost(1));
+                assertEquals(step < 100, predicted.hasGeyserBoost(1));
+                confirmed.completeFrame();
+                predicted.completeFrame();
+            }
+        }
+    }
+
+    @Test
+    void appliesFutureCommandsImmediatelyWithoutRenewingRetainedSnapshots() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 5; frame++) {
+            timeline.completeFrame();
+        }
+        timeline.predictGeyserBoost(1);
+        timeline.completeFrame();
+        final MovementEffect future = new MovementEffect(1, 2, 20, 150, -1, 105, 5, 0);
+        timeline.accept(future);
+        for (int frame = 5; frame < 15; frame++) {
+            assertTrue(timeline.hasGeyserBoost(1));
+            timeline.completeFrame();
+        }
+        timeline.accept(future);
+        for (int frame = 15; frame < 25; frame++) {
+            assertTrue(timeline.hasGeyserBoost(1));
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(future);
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 0, -1, -1, -1, Long.MIN_VALUE, 25, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, 0, -1, -1, Long.MIN_VALUE, 25, 0));
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.clear();
+        assertFalse(timeline.hasGlideBoost(1));
+    }
+
+    @Test
+    void appliesAndExpiresUnboundConfirmationsWithoutRenewingThemOnReceipt() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 10; frame++) {
+            timeline.completeFrame();
+        }
+        final MovementEffect startup = new MovementEffect(1, 2, 100, 0, -1, 53, 8, 0);
+        timeline.accept(startup);
+        assertTrue(timeline.hasGeyserBoost(1));
+        for (int frame = 10; frame <= 55; frame++) {
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(startup);
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.predictGeyserBoost(1);
+        timeline.accept(new MovementEffect(1, 2, 100, 0, -1, 200, 55, 0));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, 400, 0, -1, 200, 55, 0));
+        timeline.predictGeyserBoost(1);
+        for (int frame = 55; frame < 200; frame++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.clear();
+        assertFalse(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void followsNativeCommandOrderingAcrossRemovalActivationAndInfiniteEffects() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 10; frame++) {
+            timeline.completeFrame();
+        }
+        timeline.accept(new MovementEffect(1, 2, 20, 10, 10, 0, -1, 0));
+        timeline.completeFrame();
+        timeline.completeFrame();
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, 0, 9, 9, 0, -1, 0));
+        timeline.completeFrame();
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, 100, 8, 8, 0, -1, 0));
+        for (int frame = 0; frame < 25; frame++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, -1, 0, 0, 0, -1, 0));
+        for (int frame = 0; frame < 100; frame++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void refreshesLocallyAdmittedGeysersAndExpiresAfterTheLastAdmission() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        timeline.accept(new MovementEffect(1, 2, 100, 0, -1, 0, -1, 0));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.predictGeyserBoost(1);
+        for (int frame = 0; frame < 17; frame++) {
+            assertTrue(timeline.hasGeyserBoost(1));
+            timeline.completeFrame();
+        }
+        timeline.predictGeyserBoost(1);
+        for (int frame = 0; frame < 100; frame++) {
+            assertTrue(timeline.hasGeyserBoost(1));
+            assertFalse(timeline.hasGeyserBoost(2));
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, 100, 0, -1, 0, -1, 0));
+        assertFalse(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void localAdmissionPreservesLongerEffectsAndAllowsForcedTransitions() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        timeline.accept(new MovementEffect(1, 2, 150, 81, 0, 0, -1, 0));
+        timeline.predictGeyserBoost(1);
+        for (int i = 0; i < 100; i++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.predictGeyserBoost(1);
+        timeline.accept(new MovementEffect(1, 2, 5, 180, 99, 0, -1, 0));
+        for (int i = 0; i < 10; i++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, 0, 180, 99, 0, -1, 0));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 2, -1, 181, 100, 0, -1, 0));
+        timeline.predictGeyserBoost(1);
+        for (int i = 0; i < 101; i++) {
+            timeline.completeFrame();
+        }
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.clear();
+        assertFalse(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void boundsLateBoostsToConfirmedFramesAndAppliesOlderRemovals() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 10; frame++) {
+            assertEquals(frame, timeline.completeFrame());
+        }
+        timeline.accept(new MovementEffect(1, 0, 20, 100, 0, 0, -1, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        assertFalse(timeline.hasGlideBoost(2));
+        timeline.accept(new MovementEffect(1, 0, 1, 99, 0, 0, -1, 0));
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, 20, 98, 0, 0, -1, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        for (int frame = 10; frame <= 20; frame++) {
+            assertTrue(timeline.hasGlideBoost(1));
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, 5, 101, 0, 0, -1, 0));
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, -1, 102, -1, 0, -1, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+    }
+
+    @Test
+    void keepsActorsAndEffectKindsIndependentAndClearsConnectionState() {
+        final MovementEffectTimeline timeline = new MovementEffectTimeline();
+        assertEquals(0, timeline.completeFrame());
+        timeline.accept(new MovementEffect(1, 0, -1, Long.MIN_VALUE, 0, 0, -1, 0));
+        timeline.accept(new MovementEffect(1, 0, 0, Long.MAX_VALUE, 0, 0, -1, 0));
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(1, 0, -1, 0, 0, 0, -1, 0));
+        timeline.accept(new MovementEffect(1, 1, 1, Long.MIN_VALUE, 0, 0, -1, 0));
+        timeline.accept(new MovementEffect(2, 2, -1, 0, 0, 0, -1, 0));
+        assertTrue(timeline.hasGlideBoost(1));
+        assertTrue(timeline.hasDolphinBoost(1));
+        assertFalse(timeline.hasGlideBoost(2));
+        assertFalse(timeline.hasDolphinBoost(2));
+        assertTrue(timeline.hasGeyserBoost(2));
+        assertFalse(timeline.hasGeyserBoost(1));
+        assertEquals(1, timeline.completeFrame());
+        assertTrue(timeline.hasGlideBoost(1));
+        assertFalse(timeline.hasDolphinBoost(1));
+        timeline.retainEntities(id -> id != 1);
+        assertFalse(timeline.hasGlideBoost(1));
+        timeline.accept(new MovementEffect(2, 0, 1, 0, 1, 0, -1, 0));
+        assertTrue(timeline.hasGlideBoost(2));
+        assertEquals(2, timeline.completeFrame());
+        assertFalse(timeline.hasGlideBoost(2));
+        timeline.clear();
+        assertFalse(timeline.hasGeyserBoost(2));
+        assertFalse(timeline.hasGlideBoost(2));
+        assertEquals(0, timeline.completeFrame());
+    }
+
+}
