+
+import static net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerPredictionTest {
+
+    @Test
+    void preservesMotionAndPoseAcrossTheVersionedWireFormat() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var frame = new PlayerPrediction(42, new Position3f(-6.5F, 101.86157F, 1.5F),
+                    new Position3f(0.125F, -0.022315647F, -0.25F), new PlayerPosture(true, true, true), true, false, true, true, 0.35F * 0.35F);
+            PlayerPrediction.TYPE.write(buffer, frame);
+            assertEquals(frame, PlayerPrediction.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            for (final int revision : new int[]{1, 2, 3, 4, 5, 6, 8}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, revision);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+            }
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 7);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsNonFiniteMotionAndUnknownPoseFlags() {
+        assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(-1, Position3f.ZERO,
+                Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, 1F));
+        for (float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42, Position3f.ZERO,
+                    new Position3f(0F, invalid, 0F), PlayerPosture.STANDING, false, false, false, false, 1F));
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42,
+                    new Position3f(invalid, 0F, 0F), Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, 1F));
+        }
+        for (float invalid : new float[]{-1F, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42, Position3f.ZERO,
+                    Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, invalid));
+        }
+        final var buffer = Unpooled.buffer();
+        try {
+            PlayerPrediction.TYPE.write(buffer, frame(Position3f.ZERO, false));
+            buffer.setByte(buffer.writerIndex() - 5, 128);
+            assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void preservesIndependentPoseCollisionAndJumpEventsInStationaryFrames() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int flags = 0; flags < 128; flags++) {
+                for (float scale : new float[]{0F, 0.35F * 0.35F, 0.25F, 1F}) {
+                    final var frame = new PlayerPrediction(42, Position3f.ZERO, Position3f.ZERO,
+                            new PlayerPosture((flags & 1) != 0, (flags & 16) != 0, (flags & 32) != 0), (flags & 2) != 0, (flags & 4) != 0, (flags & 8) != 0, (flags & 64) != 0, scale);
+                    PlayerPrediction.TYPE.write(buffer, frame);
+                    assertEquals(frame, PlayerPrediction.TYPE.read(buffer));
+                    buffer.clear();
+                }
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void consumesOnlyOneMatchingFrameAndDiscardsTeleportStaleness() {
+        final var storage = new PlayerPredictionStorage();
+        final var frame = new PlayerPrediction(42, new Position3f(0.5F, 101F, 0.5F), Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, true, false, 1F);
+        storage.record(frame);
+        assertEquals(frame, storage.take(frame.position().add(0F, 0.00001F, 0F)));
+        assertNull(storage.take(frame.position()));
+        storage.record(frame);
+        assertNull(storage.take(frame.position().add(0F, 5F, 0F)));
+        assertNull(storage.take(frame.position()));
+        final var replacement = frame(frame.position(), false);
+        storage.record(frame);
+        storage.record(replacement);
+        assertEquals(replacement, storage.take(frame.position()));
+    }
+
+    @Test
+    void bindsInputTicksToExactClientFramesAndEvictsExpiredBindings() {
+        final var storage = new PlayerPredictionStorage();
+        assertEquals(-1, storage.clientFrame(0));
+        for (int tick = 1; tick <= 513; tick++) {
+            final var prediction = new PlayerPrediction(1000L + tick, Position3f.ZERO, Position3f.ZERO,
+                    PlayerPosture.STANDING, false, false, false, false, 1F);
+            storage.remember(tick, prediction);
+            assertEquals(1000L + tick, storage.clientFrame(tick));
+        }
+        assertEquals(-1, storage.clientFrame(1));
+        assertEquals(1002, storage.clientFrame(2));
+        assertEquals(-1, storage.clientFrame(514));
+        assertEquals(-1, new PlayerPredictionStorage().clientFrame(513));
+    }
+
+    @Test
+    void emitsIndependentSwimmingAndCrawlingEdgesOncePerConnection() {
+        final var storage = new PlayerPredictionStorage();
+        assertTrue(storage.postureTransitions(PlayerPosture.STANDING).isEmpty());
+        final var swimming = new PlayerPosture(true, false, false);
+        final var crawling = new PlayerPosture(false, true, false);
+        assertEquals(java.util.Set.of(StartSwimming), storage.postureTransitions(swimming));
+        assertTrue(storage.postureTransitions(swimming).isEmpty());
+        assertEquals(java.util.Set.of(StopSwimming, StartCrawling), storage.postureTransitions(crawling));
+        assertTrue(storage.postureTransitions(crawling).isEmpty());
+        assertEquals(crawling, storage.posture());
+        assertEquals(java.util.Set.of(StartSwimming, StopCrawling), storage.postureTransitions(swimming));
+        assertEquals(java.util.Set.of(StopSwimming), storage.postureTransitions(PlayerPosture.STANDING));
+        assertTrue(new PlayerPredictionStorage().postureTransitions(PlayerPosture.STANDING).isEmpty());
+    }
+
+    private static PlayerPrediction frame(final Position3f position, final boolean swimming) {
+        return new PlayerPrediction(42, position, new Position3f(0F, -0.022315647F, 0F), new PlayerPosture(swimming, false, false), false, false, false, false, 1F);
+    }
+
+}
