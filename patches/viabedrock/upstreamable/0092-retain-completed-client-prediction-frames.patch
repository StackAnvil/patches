+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ActorMotionCommandTest {
+
+    @Test
+    void preservesUnsignedClocksAndRawVelocityWhileRejectingMalformedPayloads() {
+        final var value = new ActorMotionCommand(41, UUID.randomUUID(), UUID.randomUUID(), -1,
+                new MovementCorrectionTiming(-1, 105, 25, 100, -1), new Position3f(-0F, Float.MIN_VALUE, 1.2345679F));
+        final var buffer = Unpooled.buffer();
+        try {
+            ActorMotionCommand.TYPE.write(buffer, value);
+            assertTrue(buffer.readableBytes() <= ActorMotionCommand.MAX_PAYLOAD_BYTES);
+            final int size = buffer.readableBytes();
+            assertEquals(value, ActorMotionCommand.TYPE.read(buffer));
+            for (int length = 0; length < size; length++) {
+                final var truncated = buffer.slice(0, length);
+                assertThrows(RuntimeException.class, () -> ActorMotionCommand.TYPE.read(truncated));
+            }
+            buffer.readerIndex(0).writeByte(1);
+            assertThrows(IllegalArgumentException.class, () -> ActorMotionCommand.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new ActorMotionCommand(41, value.uuid(), value.lifetime(), -1,
+                    value.timing(), new Position3f(Float.NaN, 0, 0)));
+            assertThrows(IllegalArgumentException.class, () -> new ActorMotionCommand(41, value.uuid(), value.lifetime(), -1,
+                    new MovementCorrectionTiming(0, 105, 25, 100, -1), value.motion()));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void clampsExpiredMotionWithoutChangingCorrectionAdmissionOrUnsignedFuturePlacement() {
+        final var expired = new MovementCorrectionTiming(99, 105, 25, 100, -1);
+        assertNull(expired.locate(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(21, true, false), expired.locateMotion(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(25, true, false), expired.locateMotion(24, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(26, true, true), new MovementCorrectionTiming(105, 105, 25, 100, -1).locateMotion(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(25, false, false), new MovementCorrectionTiming(-1, 105, 25, 100, -1).locateMotion(20, 25));
+        assertEquals(new MovementCorrectionTiming.Placement(23, true, false), new MovementCorrectionTiming(99, 105, 25, 100, 23).locateMotion(20, 25));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_TICKED_MOTION", matches = ".+")
+    void matchesOriginalReceiverQueueAndDirtyPlacement() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_TICKED_MOTION")))).getAsJsonObject();
+        int compared = 0;
+        for (var entry : reference.getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            final long tick = Long.parseUnsignedLong(row.get("tick").getAsString());
+            final var placement = new MovementCorrectionTiming(tick, 105, 5, 100, -1).locateMotion(0, 5);
+            assertNotNull(placement);
+            assertEquals(row.get("pendingQueue").getAsInt() != 0, placement.pending());
+            if (!placement.pending()) {
+                assertEquals(row.getAsJsonArray("queued").get(0).getAsLong(), placement.frame());
+            }
+            assertEquals(!row.getAsJsonArray("dirty").isEmpty(), row.get("accept").getAsBoolean() && placement.dirty() && !placement.pending());
+            compared++;
+        }
+        assertEquals(reference.get("cases").getAsInt(), compared);
+    }
+
+}
