+        for (final Case value : cases) {
+            final Position3f motion = GlideMovement.calculate(new Position3f(value.x(), value.y(), value.z()),
+                    value.pitch(), value.yaw(), value.previousPitch(), value.previousYaw(), value.slowFalling(), true);
+            assertEquals(value.expectedX(), Float.floatToRawIntBits(motion.x()));
+            assertEquals(value.expectedY(), Float.floatToRawIntBits(motion.y()));
