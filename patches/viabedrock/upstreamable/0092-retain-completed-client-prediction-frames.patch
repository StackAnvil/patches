+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SneakingInputStateTest {
+
+    @Test
+    void consumesTheScalarBeforeProducingItFromThePreviousPosture() {
+        final var state = new SneakingInputState();
+        final var sneaking = new PlayerPosture(false, false, true);
+        assertEquals(0.3F, state.advance(PlayerPosture.STANDING, 3));
+        assertEquals(0.3F, state.advance(sneaking, 3));
+        assertEquals(0.75F, state.advance(sneaking, 3));
+        assertEquals(0.75F, state.advance(PlayerPosture.STANDING, 3));
+        assertEquals(0.3F, state.advance(PlayerPosture.STANDING, 3));
+        assertEquals(0.3F, state.advance(sneaking, 1));
+        assertEquals(0.75F, state.advance(sneaking, 1));
+        assertEquals(0.75F, state.advance(sneaking, 0));
+        assertEquals(0.3F, state.advance(sneaking, 2));
+        assertEquals(0.6F, state.advance(sneaking, 2));
+        assertEquals(0.6F, state.advance(new PlayerPosture(false, true, false), 2));
+        assertEquals(0.6F, state.advance(PlayerPosture.STANDING, 2));
+    }
+
+}
