+        final var remote = tracker.addEntity(new Entity(user, 3, 4, "minecraft:pig", 32, UUID.randomUUID(), EntityTypes26_3.PIG), false);
+        final var motion = new Position3f(1.2345679F, -.12345679F, Float.MIN_VALUE);
+        for (boolean negotiated : new boolean[]{false, true}) {
+            if (negotiated) {
+                channels.addChannels(List.of(ActorMotionCommand.CHANNEL));
+            }
+            for (Entity actor : List.of(player, remote)) {
+                for (long tick : new long[]{0, 99, 102, 105, -1}) {
+                    final var input = Unpooled.buffer();
+                    try {
+                        BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, actor.runtimeId());
+                        BedrockTypes.POSITION_3F.write(input, motion);
+                        BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, tick);
+                        final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.SET_ENTITY_MOTION, input, user);
+                        new TestProtocol().translate(packet);
+                        if (negotiated && actor == player && tick != 0) {
+                            assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD, packet.getPacketType());
+                            assertEquals(ActorMotionCommand.CHANNEL, packet.get(Types.STRING, 0));
+                            final var command = packet.get(ActorMotionCommand.TYPE, 0);
+                            assertEquals(tick, command.timing().serverTick());
+                            assertEquals(25, command.timing().inputFrame());
+                            assertEquals(tick == 99 ? 21 : tick == 102 ? 23 : -1, command.timing().followingFrame());
+                            assertEquals(motion, command.motion());
+                            assertEquals(player.nativeActorSnapshot().lifetime(), command.lifetime());
+                            assertFalse(command.vehicle());
+                        } else {
