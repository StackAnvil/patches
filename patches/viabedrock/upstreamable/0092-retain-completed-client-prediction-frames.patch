@@ -0,0 +1,181 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class MovementEffectReplayTest {
+
+    @Test
+    void restoresUnrelatedEffectDurationsBeforeReplayingTheirCountdowns() {
+        final var timeline = new MovementEffectTimeline();
+        timeline.accept(new MovementEffect(1, 0, 10, 100, 0, 0, -1, 0));
+        for (int frame = 0; frame < 6; frame++) {
+            timeline.beginFrame();
+            timeline.completeFrame();
+        }
+        timeline.accept(new MovementEffect(1, 2, 100, 102, 2, 105, 5, 100));
+        timeline.replayCorrections();
+        expiresGlideAfter(timeline, 5);
+    }
+
+    @Test
+    void refreshesLaterSnapshotsAfterAnEarlierCorrection() {
+        final var timeline = new MovementEffectTimeline();
+        timeline.accept(new MovementEffect(1, 0, 20, 100, 0, 0, -1, 0));
+        for (int frame = 0; frame < 6; frame++) {
+            timeline.beginFrame();
+            timeline.completeFrame();
+        }
+        timeline.accept(new MovementEffect(1, 0, 100, 101, 1, 105, 5, 100));
+        timeline.accept(new MovementEffect(1, 2, 100, 101, 1, 105, 5, 100));
+        timeline.replayCorrections();
+        timeline.accept(new MovementEffect(1, 1, 100, 103, 3, 105, 5, 100));
+        timeline.replayCorrections();
+        expiresGlideAfter(timeline, 96);
+    }
+
+    private static void expiresGlideAfter(final MovementEffectTimeline timeline, final int frames) {
+        for (int frame = 0; frame < frames; frame++) {
+            assertTrue(timeline.hasGlideBoost(1));
+            timeline.beginFrame();
+            timeline.replayCorrections();
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGlideBoost(1));
+    }
+
+    @Test
+    void replaysCapturedAdmissionAfterRemovalWithoutReadingTheCurrentSource() {
+        final var timeline = history(true);
+        timeline.accept(new MovementEffect(1, 2, 0, 102, 2, 105, 5, 100));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.replayCorrections();
+        expiresAfter(timeline, 99);
+    }
+
+    @Test
+    void replaysTheOriginalDurationAtTheOldestClockInsteadOfItsExpiredImmediateValue() {
+        final var timeline = history(false);
+        timeline.accept(new MovementEffect(1, 2, 20, 0, -1, 105, 5, 100));
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.replayCorrections();
+        expiresAfter(timeline, 15);
+    }
+
+    @Test
+    void preservesMaskZeroCommandsUntilAnotherKindRequestsMovementReplay() {
+        final var timeline = history(false);
+        timeline.accept(new MovementEffect(1, 2, 20, 102, 2, 105, 5, 100));
+        timeline.replayCorrections();
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.accept(new MovementEffect(1, 0, -1, 104, 4, 105, 5, 100));
+        timeline.replayCorrections();
+        expiresAfter(timeline, 17);
+        assertTrue(timeline.hasGlideBoost(1));
+    }
+
+    @Test
+    void transfersCurrentCommandsBeforePhysicsAndCountsDownEachFrameOnce() {
+        final var timeline = history(false);
+        timeline.accept(new MovementEffect(1, 2, 2, 105, 5, 105, 5, 100));
+        timeline.beginFrame();
+        timeline.beginFrame();
+        timeline.replayCorrections();
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.completeFrame();
+        assertTrue(timeline.hasGeyserBoost(1));
+        timeline.beginFrame();
+        timeline.replayCorrections();
+        timeline.completeFrame();
+        assertFalse(timeline.hasGeyserBoost(1));
+    }
+
+    @Test
+    void boundsClampedReplayByTheTransportedOldestClock() {
+        final var timeline = history(false);
+        timeline.accept(new MovementEffect(1, 2, 2, 0, -1, 105, 5, 104));
+        timeline.replayCorrections();
+        expiresAfter(timeline, 1);
+    }
+
+    @Test
+    void removedActorsCannotRecoverOldInputsOrQueuedCommands() {
+        final var timeline = history(true);
+        timeline.accept(new MovementEffect(1, 2, 0, 102, 2, 105, 5, 100));
+        timeline.retainEntities(id -> id != 1);
+        timeline.accept(new MovementEffect(1, 2, 0, 102, 2, 105, 5, 100));
+        timeline.replayCorrections();
+        assertFalse(timeline.hasGeyserBoost(1));
+        timeline.clear();
+        assertEquals(0, timeline.completeFrame());
+    }
+
+    @Test
+    void matchesNativeInputOrderingWithTheRecordedSnapshotBoundary() throws Exception {
+        // These older input controls supply snapshot storage. They do not establish packed snapshot semantics.
+        final String reference = System.getenv("STACKANVIL_MOVEMENT_INPUT_REPLAY_REFERENCE");
+        assumeTrue(reference != null);
+        for (final var entry : JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonArray()) {
+            final var row = entry.getAsJsonObject();
+            final var timeline = new MovementEffectTimeline();
+            final boolean captured = row.get("inputMode").getAsString().equals("captured");
+            for (int frame = 0; frame < 6; frame++) {
+                if (captured) {
+                    timeline.beginFrame();
+                }
+                if (row.get("previousActive").getAsBoolean()) {
+                    timeline.predictGeyserBoost(1);
+                }
+                if (!captured) {
+                    timeline.beginFrame();
+                }
+                timeline.completeFrame();
+            }
+            final long tick = row.get("tick").getAsLong();
+            timeline.accept(new MovementEffect(1, 2, row.get("duration").getAsInt(), tick,
+                    tick >= 100 && tick <= 105 ? tick - 100 : -1, 105, 5, 100));
+            final int live = row.getAsJsonArray("live").get(1).getAsInt();
+            assertEquals(live == -1 || live > 0, timeline.hasGeyserBoost(1));
+            timeline.replayCorrections();
+            final int replayed = row.getAsJsonObject("first").getAsJsonArray("state").get(1).getAsInt();
+            assertEquals(replayed == -1 || replayed > 0, timeline.hasGeyserBoost(1));
+        }
+    }
+
+    private static MovementEffectTimeline history(final boolean captureInputs) {
+        final var timeline = new MovementEffectTimeline();
+        for (int frame = 0; frame < 6; frame++) {
+            if (captureInputs) {
+                timeline.beginFrame();
+            }
+            timeline.predictGeyserBoost(1);
+            if (!captureInputs) {
+                timeline.beginFrame();
+            }
+            timeline.completeFrame();
+        }
+        return timeline;
+    }
+
+    private static void expiresAfter(final MovementEffectTimeline timeline, final int frames) {
+        for (int step = 0; step < frames; step++) {
+            assertTrue(timeline.hasGeyserBoost(1));
+            timeline.beginFrame();
+            timeline.replayCorrections();
+            timeline.completeFrame();
+        }
+        assertFalse(timeline.hasGeyserBoost(1));
+    }
+
+}
