+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.MovementEffectType;
+
+/** Confirmed effect, exact history binding and the latest paired input clock. */
+public record MovementEffect(int entityId, int type, int duration, long serverTick, long clientFrame, long inputTick, long inputFrame) {
+
+    public static final String CHANNEL = "viabedrock:movement_effect_v2";
+    public static final Type<MovementEffect> TYPE = new Type<>(MovementEffect.class) {
+        @Override
+        public MovementEffect read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 2
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported movement effect");
+            }
+            return new MovementEffect(Types.VAR_INT.readPrimitive(buffer), Types.VAR_INT.readPrimitive(buffer),
+                    Types.VAR_INT.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer),
+                    Types.VAR_LONG.readPrimitive(buffer), Types.VAR_LONG.readPrimitive(buffer));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final MovementEffect effect) {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, effect.entityId());
+            Types.VAR_INT.writePrimitive(buffer, effect.type());
+            Types.VAR_INT.writePrimitive(buffer, effect.duration());
+            Types.VAR_LONG.writePrimitive(buffer, effect.serverTick());
+            Types.VAR_LONG.writePrimitive(buffer, effect.clientFrame());
+            Types.VAR_LONG.writePrimitive(buffer, effect.inputTick());
+            Types.VAR_LONG.writePrimitive(buffer, effect.inputFrame());
+        }
+    };
+
+    public MovementEffect {
+        if (clientFrame < -1 || inputFrame < -1) {
+            throw new IllegalArgumentException("Invalid movement effect frame identity");
+        }
+    }
+
+    public boolean isGlideBoost() {
+        return this.type == MovementEffectType.GLIDE_BOOST.getValue();
+    }
+
+    /** Native command construction uses unsigned clock order and signed 32-bit duration arithmetic. */
+    public int adjustedDuration(final long tick) {
+        final int normalized = this.duration < -1 ? 0 : this.duration;
+        if (normalized != -1 && Long.compareUnsigned(this.serverTick, tick) < 0) {
+            return Math.max(0, (int) this.serverTick - (int) tick + normalized);
+        }
+        return normalized;
+    }
+
+    public boolean hasTiming() {
+        return this.clientFrame >= 0 || this.duration <= 0 || this.hasInputClock();
+    }
+
+    private boolean hasInputClock() {
+        return this.inputFrame >= 0;
+    }
+
+    /** Age a confirmed snapshot from its paired frame without inventing an evicted frame identity. */
+    public int remainingAt(final long frame) {
+        if (frame < 0) {
+            return 0;
+        }
+        final long start;
+        final int remaining;
+        if (this.hasInputClock()) {
+            start = this.inputFrame;
+            remaining = this.adjustedDuration(this.inputTick);
+        } else {
+            start = this.clientFrame;
+            remaining = this.duration < -1 ? 0 : this.duration;
+            if (remaining == -1 && start < 0) {
+                return -1;
+            }
+        }
+        if (start < 0 || frame < start) {
+            return 0;
+        }
+        return remaining == -1 ? -1 : (int) Math.max(0L, remaining - (frame - start));
+    }
+
+    public boolean activeAt(final long frame) {
+        final int remaining = this.remainingAt(frame);
+        return remaining == -1 || remaining > 0;
+    }
+
+}
