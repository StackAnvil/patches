+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import net.raphimc.viabedrock.api.model.PlayerPrediction;
+import net.raphimc.viabedrock.api.model.PlayerPosture;
+import net.raphimc.viabedrock.api.model.SneakingInputState;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.EnumSet;
+import java.util.Set;
+
+public final class PlayerPredictionStorage implements StorableObject {
+
+    private static final int DEFAULT_HISTORY_SIZE = 512;
+    private long[] inputTicks = new long[DEFAULT_HISTORY_SIZE];
+    private long[] clientFrames = new long[DEFAULT_HISTORY_SIZE];
+    private int historyIndex;
+    private int historyCount;
+    private PlayerPrediction pending;
+    private long lastFrame = -1;
+    private long inputTick;
+    private long inputFrame = -1;
+    private PlayerPosture posture = PlayerPosture.STANDING;
+    private final SneakingInputState sneakingInput = new SneakingInputState();
+
+    public SneakingInputState sneakingInput() {
+        return this.sneakingInput;
+    }
+
+    public void record(final PlayerPrediction prediction) {
+        // Frame identities advance for the connection lifetime, including stationary ticks.
+        // Keep the watermark after consumption or a position mismatch so a replay cannot
+        // bind old physics to a later auth-input tick.
+        if (prediction.frameId() <= this.lastFrame) {
+            return;
+        }
+        this.lastFrame = prediction.frameId();
+        this.pending = prediction;
+    }
+
+    /** Discard unconsumed physics after an authoritative position change without reusing its frame identity. */
+    public void discardPending() {
+        this.pending = null;
+    }
+
+    public PlayerPrediction take(final Position3f position) {
+        final PlayerPrediction prediction = this.pending;
+        this.pending = null;
+        return prediction != null && prediction.matches(position) ? prediction : null;
+    }
+
+    /** START_GAME supplies the native history limit; the client bounds it to 1..1000 frames. */
+    public void configureHistory(final int capacity) {
+        final int size = Math.clamp(capacity, 1, 1000);
+        this.inputTicks = new long[size];
+        this.clientFrames = new long[size];
+        this.historyIndex = 0;
+        this.historyCount = 0;
+        this.inputTick = 0;
+        this.inputFrame = -1;
+        this.discardPending();
+    }
+
+    /** Record an emitted input tick and invalidate its clock binding when no matching frame exists. */
+    public void remember(final long inputTick, final PlayerPrediction prediction) {
+        // Native capture starts a new history on a clock discontinuity. Unsigned wrap is contiguous.
+        if (this.historyCount != 0 && inputTick != this.inputTick + 1) {
+            this.historyIndex = 0;
+            this.historyCount = 0;
+        }
+        this.inputTick = inputTick;
+        this.inputFrame = prediction == null ? -1 : prediction.frameId();
+        this.inputTicks[this.historyIndex] = inputTick;
+        this.clientFrames[this.historyIndex] = this.inputFrame;
+        this.historyIndex = (this.historyIndex + 1) % this.inputTicks.length;
+        this.historyCount = Math.min(this.historyCount + 1, this.inputTicks.length);
+    }
+
+    /** Native lookup requires a retained input and rejects zero and older unsigned clocks. */
+    public boolean acceptsCorrectionTick(final long tick) {
+        if (tick == 0 || this.historyCount == 0) {
+            return false;
+        }
+        final int oldest = (this.historyIndex - this.historyCount + this.inputTicks.length) % this.inputTicks.length;
+        return Long.compareUnsigned(tick, this.inputTicks[oldest]) >= 0;
+    }
+
+    public long inputTick() {
+        return this.inputTick;
+    }
+
+    public long oldestInputTick() {
+        return this.historyCount == 0 ? 0 : this.inputTicks[(this.historyIndex - this.historyCount + this.inputTicks.length) % this.inputTicks.length];
+    }
+
+    public long inputFrame() {
+        return this.inputFrame;
+    }
+
+    public long clientFrame(final long inputTick) {
+        for (int offset = 1; offset <= this.historyCount; offset++) {
+            final int index = (this.historyIndex - offset + this.inputTicks.length) % this.inputTicks.length;
+            if (this.inputTicks[index] == inputTick) {
+                return this.clientFrames[index];
+            }
+        }
+        return -1;
+    }
+
+    public PlayerPosture posture() {
+        return this.posture;
+    }
+
+    public Set<PlayerAuthInputData> postureTransitions(final PlayerPosture posture) {
+        final Set<PlayerAuthInputData> transitions = EnumSet.noneOf(PlayerAuthInputData.class);
+        if (this.posture.swimming() != posture.swimming()) {
+            transitions.add(posture.swimming() ? PlayerAuthInputData.StartSwimming : PlayerAuthInputData.StopSwimming);
+        }
+        if (this.posture.crawling() != posture.crawling()) {
+            transitions.add(posture.crawling() ? PlayerAuthInputData.StartCrawling : PlayerAuthInputData.StopCrawling);
+        }
+        this.posture = posture;
+        return transitions;
+    }
+
+}
