+        assertFalse(parsed.javaComponent().canSprint());
+        assertFalse(parsed.javaComponent().interactVibrations());
+        assertEquals(parsed.movementScale(), parsed.javaComponent().speedMultiplier());
+    }
+
+    @Test
+    void appliesTheNativeSquaredModifierAfterPostureScaling() {
+        final var slowed = ItemUseModifiers.apply(new Position2f(-0.21213204F, 0.21213204F),
+                ItemUseModifiers.DEFAULT.movementScale());
+        assertEquals(-0.025986174F, slowed.x());
+        assertEquals(0.025986174F, slowed.y());
+        assertEquals(0.122499995F, ItemUseModifiers.DEFAULT.movementScale());
+        assertEquals(0F, new ItemUseModifiers(0F, true).movementScale());
+        assertEquals(0.25F, new ItemUseModifiers(-0.5F, true).movementScale());
+    }
+
+    @Test
+    void omitsSlowdownAtTheNativeEpsilonBoundary() {
+        for (float modifier : new float[]{Math.nextDown(1F), 1F, Math.nextUp(1F)}) {
+            final var value = new ItemUseModifiers(modifier, true);
+            assertTrue(value.allowsSprinting());
+            assertEquals(1F, value.movementScale());
+        }
+        assertFalse(new ItemUseModifiers(Math.nextDown(Math.nextDown(Math.nextDown(1F))), true).allowsSprinting());
+        for (float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY, Float.MAX_VALUE}) {
+            assertThrows(IllegalArgumentException.class, () -> new ItemUseModifiers(invalid, true));
+        }
+    }
+
+}
