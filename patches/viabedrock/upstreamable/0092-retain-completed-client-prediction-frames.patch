+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.Protocol;
+import com.viaversion.viaversion.api.protocol.ProtocolManager;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.UnderwaterMovementAttribute;
+import net.raphimc.viabedrock.protocol.model.EntityAttribute;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class UnderwaterMovementTransportTest {
+
+    @Test
+    void retainsBeforeSpawnAndSendsClampedUpdatesOnlyAfterChannelRegistration() throws Exception {
+        final var manager = Via.class.getDeclaredField("manager");
+        manager.setAccessible(true);
+        final Object previousManager = manager.get(null);
+        final List<PacketWrapper> sent = new ArrayList<>();
+        try {
+            final ProtocolManager protocols = proxy(ProtocolManager.class, (ignored, method, arguments) -> {
+                if (method.getName().equals("createPacketWrapper")) {
+                    return new PacketWrapperImpl(ClientboundPackets26_3.CUSTOM_PAYLOAD, null, null) {
+                        @Override
+                        public void send(final Class<? extends Protocol> protocol, final boolean skipCurrentPipeline) {
+                            sent.add(this);
+                        }
+                    };
+                }
+                throw new AssertionError(method.getName());
+            });
+            manager.set(null, proxy(ViaManager.class, (ignored, method, arguments) -> {
+                if (method.getName().equals("getProtocolManager")) {
+                    return protocols;
+                }
+                throw new AssertionError(method.getName());
+            }));
+            for (final boolean registerBeforeJoin : new boolean[]{false, true}) {
+                sent.clear();
+                final AtomicReference<State> state = new AtomicReference<>(State.CONFIGURATION);
+                final ChannelStorage channels = new ChannelStorage();
+                final EntityTracker[] trackers = new EntityTracker[1];
+                final ProtocolInfo info = proxy(ProtocolInfo.class, (ignored, method, arguments) -> state.get());
+                final UserConnection user = proxy(UserConnection.class, (ignored, method, arguments) -> {
+                    if (method.getName().equals("getProtocolInfo")) {
+                        return info;
+                    }
+                    if (method.getName().equals("get")) {
+                        if (arguments[0] == EntityTracker.class) {
+                            return trackers[0];
+                        }
+                        if (arguments[0] == ChannelStorage.class) {
+                            return channels;
+                        }
+                    }
+                    return null;
+                });
+                final EntityTracker tracker = trackers[0] = new EntityTracker(user);
+                final ClientPlayerEntity player = tracker.addEntity(new ClientPlayerEntity(user, 1, UUID.randomUUID(),
+                        new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+                if (registerBeforeJoin) {
+                    channels.addChannels(List.of(UnderwaterMovementAttribute.CHANNEL));
+                }
+                tracker.sendUnderwaterMovementSnapshots();
+                assertTrue(sent.isEmpty()); // An absent attribute must not become an invented default.
+                final EntityAttribute attribute = new EntityAttribute("minecraft:underwater_movement", 0.5F, 0F, 0.25F);
+                update(player, attribute);
+                assertSame(attribute, player.attributes().get(attribute.name()));
+                player.sendUnderwaterMovementSnapshot();
+                assertTrue(sent.isEmpty());
+                state.set(State.PLAY);
+                tracker.sendUnderwaterMovementSnapshots();
+                assertTrue(sent.isEmpty()); // PLAY alone is insufficient before the player spawns.
+                tracker.markNativeActorsJoined();
+                assertEquals(registerBeforeJoin ? 1 : 0, sent.size());
+                if (!registerBeforeJoin) {
+                    channels.addChannels(List.of(UnderwaterMovementAttribute.CHANNEL));
+                    tracker.sendUnderwaterMovementSnapshots();
+                }
+                assertSnapshot(sent.removeFirst(), player.javaId(), 0.25F);
+                update(player, attribute.withValue(0F));
+                assertSnapshot(sent.removeFirst(), player.javaId(), 0F);
+                update(player, attribute.withValue(-1F));
+                assertSnapshot(sent.removeFirst(), player.javaId(), 0F);
+                assertTrue(sent.isEmpty());
+            }
+        } finally {
+            manager.set(null, previousManager);
+        }
+    }
+
+    private static void update(final LivingEntity entity, final EntityAttribute attribute) {
+        entity.updateAttributes(new EntityAttribute[]{attribute}, new PacketWrapperImpl(ClientboundPackets26_3.UPDATE_ATTRIBUTES, null, null));
+    }
+
+    private static void assertSnapshot(final PacketWrapper packet, final int entityId, final float speed) throws Exception {
+        assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD, packet.getPacketType());
+        assertEquals(UnderwaterMovementAttribute.CHANNEL, packet.get(Types.STRING, 0));
+        assertEquals(new UnderwaterMovementAttribute(entityId, speed), packet.get(UnderwaterMovementAttribute.TYPE, 0));
+    }
+
+    private static <T> T proxy(final Class<T> type, final InvocationHandler handler) {
+        return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type}, handler));
+    }
+
+}
