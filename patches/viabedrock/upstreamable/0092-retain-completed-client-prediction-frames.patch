+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native 1.26.51 accumulation and motion update for observed liquid flows. */
+public final class FluidCurrent {
+
+    public static final float WATER_STRENGTH = 0.014F;
+    public static final float LAVA_STRENGTH = 0.0035F;
+
+    private float x;
+    private float y;
+    private float z;
+
+    public State snapshot() {
+        return new State(this.x, this.y, this.z);
+    }
+
+    public void restore(final State state) {
+        this.x = state.x();
+        this.y = state.y();
+        this.z = state.z();
+    }
+
+    public void reset() {
+        this.x = this.y = this.z = 0F;
+    }
+
+    public void accumulate(final float x, final float y, final float z) {
+        this.x += x;
+        this.y += y;
+        this.z += z;
+    }
+
+    public Position3f apply(final Position3f motion, final float strength) {
+        // Preserve the instruction order, including the inner Y/X sum.
+        final float squaredLength = this.z * this.z + (this.y * this.y + this.x * this.x);
+        if (squaredLength <= 0F) {
+            return motion;
+        }
+        final float length = (float) Math.sqrt(squaredLength);
+        final boolean normalize = length >= 0.0001F;
+        final float normalizedX = normalize ? this.x / length : 0F;
+        final float normalizedY = normalize ? this.y / length : 0F;
+        final float normalizedZ = normalize ? this.z / length : 0F;
+        return new Position3f(normalizedX * strength + motion.x(), normalizedY * strength + motion.y(), normalizedZ * strength + motion.z());
+    }
+
+    public record State(float x, float y, float z) {
+    }
+
+}
