--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/FlightMovement.java
@@ -0,0 +1,83 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native player flight input and drag, with separate float operations. */
+public final class FlightMovement {
+
+    private FlightMovement() {
+    }
+
+    /** Flying removes the native physical jump tag without clearing vertical input requests. */
+    public static boolean isJumping(final boolean jumpRequested, final boolean flying) {
+        return jumpRequested && !flying;
+    }
+
+    public static boolean creative(final int gameType, final int levelGameType) {
+        return gameType == 1 || gameType == 5 && levelGameType == 1;
+    }
+
+    public static boolean idle(final float inputX, final float inputZ) {
+        return Math.max(Math.abs(inputX), Math.abs(inputZ)) < 0.01F;
+    }
+
+    /** The two slow requests belong to MoveInputState, separately from WantUp and WantDown. */
+    public static float verticalInput(float velocity, final float inputX, final float inputZ,
+                                     final boolean flying, final boolean wantUp, final boolean wantDown,
+                                     final boolean wantUpSlow, final boolean wantDownSlow,
+                                     final FlightMovementContext context) {
+        if (!flying) {
+            return velocity;
+        }
+        if (idle(inputX, inputZ) && creative(context.gameType(), context.levelGameType())
+                && !wantUp && !wantDown && !wantUpSlow && !wantDownSlow) {
+            velocity *= 0.375F;
+        }
+        if (wantUp && wantDown) {
+            return 0F;
+        }
+        float change = wantUp ? 0.15F : 0F;
+        if (wantUpSlow) {
+            change += 0.05F;
+        }
+        if (wantDown) {
+            change += -0.22F;
+        }
+        if (wantDownSlow) {
+            change += -0.15F;
+        }
+        return change * context.verticalSpeed() + velocity;
+    }
+
+    /** Evaluated after collision resolution; the native drag attribute can change the retained fraction. */
+    public static float verticalDrag(final float velocity, final float dragModifier) {
+        return Math.max(0F, 1F - Math.max(0F, 0.39999998F * dragModifier)) * velocity;
+    }
+
+    /** Native friction consumes the override only on idle input, after the vertical drag stage. */
+    public static Position3f finish(final Position3f motion, final float friction, final float inputX, final float inputZ,
+                                   final FlightMovementContext context) {
+        final float horizontal;
+        if (idle(inputX, inputZ)) {
+            horizontal = (friction * (creative(context.gameType(), context.levelGameType()) ? 0.375F : 0.75F)) * 0.91F;
+        } else {
+            horizontal = context.legacyFriction() ? (friction * context.frictionModifier()) * 0.91F
+                    : retainedFriction(friction, context.dragModifier()) * retainedFriction(0.91F, context.dragModifier());
+        }
+        return new Position3f(cutoff(motion.x(), horizontal), verticalDrag(motion.y(), context.dragModifier()), cutoff(motion.z(), horizontal));
+    }
+
+    private static float retainedFriction(final float base, final float modifier) {
+        return Math.max(0F, 1F - Math.max(0F, (1F - base) * modifier));
+    }
+
+    private static float cutoff(final float velocity, final float friction) {
+        return (Math.abs(velocity) <= 1.1920929E-7F ? 0F : friction) * velocity;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/FlightMovementContext.java b/src/main/java/net/raphimc/viabedrock/api/model/FlightMovementContext.java
