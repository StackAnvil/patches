@@ -0,0 +1,63 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+/** Independent native posture flags, evaluated after the swimming trigger and before travel. */
+public record PlayerPosture(boolean swimming, boolean crawling, boolean sneaking) {
+
+    public static final PlayerPosture STANDING = new PlayerPosture(false, false, false);
+    private static final float SWIMMING_MOVEMENT_THRESHOLD = 0.49999997F;
+
+    /** SneakingComponent uses separate float multiply/add operations and caps the equipped enchantment bonus at one. */
+    public float sneakingInputScale(final int swiftSneakLevel) {
+        return this.sneaking || this.crawling ? Math.min(1F, 0.3F + Math.max(0, swiftSneakLevel) * 0.15F) : 0.3F;
+    }
+
+    /** Input scaling precedes the posture trigger and bypasses slowdown during flight, swimming or water contact. */
+    public boolean slowsMovementInput(final boolean sneakHeld, final boolean flying, final boolean inWater) {
+        return !flying && !inWater && !this.swimming && (sneakHeld || this.sneaking || this.crawling);
+    }
+
+    public PlayerPosture next(final Space space, final Input input) {
+        final boolean requestedSneak = input.sneakHeld() && !input.sneakDisabled();
+        if (input.forceStanding() || space.standing()) {
+            return new PlayerPosture(this.swimming, false, requestedSneak);
+        }
+        if (!space.crouching()) {
+            if (!input.crawlingAllowed() || !space.crawling()) {
+                return new PlayerPosture(this.swimming, this.crawling, requestedSneak);
+            }
+            if (!this.swimming) {
+                return new PlayerPosture(input.inWater(), !input.inWater(), this.sneaking);
+            }
+            if (!input.inWater()) {
+                return new PlayerPosture(false, true, this.sneaking);
+            }
+            return new PlayerPosture(true, this.crawling, requestedSneak);
+        }
+        if (this.crawling) {
+            return new PlayerPosture(this.swimming, false, true);
+        }
+        if (this.swimming) {
+            return input.movementSquared() < SWIMMING_MOVEMENT_THRESHOLD
+                    ? new PlayerPosture(false, false, true) : this;
+        }
+        return new PlayerPosture(false, false, true);
+    }
+
+    public record Space(boolean standing, boolean crouching, boolean crawling) {
+    }
+
+    public record Input(boolean sneakHeld, boolean sneakDisabled, boolean forceStanding,
+                        boolean inWater, float movementSquared, boolean crawlingAllowed) {
+        public Input {
+            if (!Float.isFinite(movementSquared) || movementSquared < 0F) {
+                throw new IllegalArgumentException("Invalid posture movement");
+            }
+        }
+    }
+
+}
