@@ -0,0 +1,80 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native 1.26.51 separated-axis contact clipping. Actor overlap recovery is a separate operation. */
+public final class CollisionContact {
+
+    private static final float CONTACT_EPSILON = 0.000001F;
+
+    private CollisionContact() {
+    }
+
+    public static Position3f clip(final Box obstacle, final Box moving, final Position3f requested) {
+        int separatedAxis = -1;
+        float gap = 0F;
+        float direction = 0F;
+        for (int axis = 0; axis < 3; axis++) {
+            if (obstacle.max(axis) <= obstacle.min(axis)) {
+                return requested;
+            }
+            final float lower = contactDistance(moving.max(axis) - obstacle.min(axis));
+            final float upper = contactDistance(obstacle.max(axis) - moving.min(axis));
+            if (lower <= 0F || upper <= 0F) {
+                if (separatedAxis != -1) {
+                    return requested;
+                }
+                separatedAxis = axis;
+                gap = lower <= 0F ? lower : upper;
+                direction = lower <= 0F ? -1F : 1F;
+            }
+        }
+        if (separatedAxis == -1) {
+            return requested;
+        }
+        final float speed = switch (separatedAxis) {
+            case 0 -> requested.x();
+            case 1 -> requested.y();
+            default -> requested.z();
+        };
+        if (gap - speed * direction <= 0F) {
+            return requested;
+        }
+        final float clipped = gap * direction;
+        return switch (separatedAxis) {
+            case 0 -> new Position3f(clipped, requested.y(), requested.z());
+            case 1 -> new Position3f(requested.x(), clipped, requested.z());
+            default -> new Position3f(requested.x(), requested.y(), clipped);
+        };
+    }
+
+    private static float contactDistance(final float distance) {
+        return Math.abs(distance) > CONTACT_EPSILON ? distance : 0F;
+    }
+
+    public record Box(float minX, float minY, float minZ, float maxX, float maxY, float maxZ) {
+
+        private float min(final int axis) {
+            return switch (axis) {
+                case 0 -> this.minX;
+                case 1 -> this.minY;
+                default -> this.minZ;
+            };
+        }
+
+        private float max(final int axis) {
+            return switch (axis) {
+                case 0 -> this.maxX;
+                case 1 -> this.maxY;
+                default -> this.maxZ;
+            };
+        }
+
+    }
+
+}
