+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.MovementEffectType;
+
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.IntPredicate;
+
+/** Client frame clock and confirmed per-actor effects; no receipt-time duration estimates. */
+public final class MovementEffectTimeline {
+
+    private long completedFrame = -1;
+    private final Map<Integer, Map<MovementEffectType, MovementEffect>> effects = new HashMap<>();
+
+    public long completeFrame() {
+        return ++this.completedFrame;
+    }
+
+    public void accept(final MovementEffect effect) {
+        final MovementEffectType type = MovementEffectType.getByValue(effect.type());
+        if (type == null) {
+            return;
+        }
+        final Map<MovementEffectType, MovementEffect> actorEffects = this.effects.computeIfAbsent(effect.entityId(), ignored -> new EnumMap<>(MovementEffectType.class));
+        final MovementEffect previous = actorEffects.get(type);
+        if (previous == null || Long.compareUnsigned(effect.serverTick(), previous.serverTick()) >= 0) {
+            actorEffects.put(type, effect);
+        }
+    }
+
+    public boolean hasGlideBoost(final int entityId) {
+        final Map<MovementEffectType, MovementEffect> actorEffects = this.effects.get(entityId);
+        final MovementEffect effect = actorEffects == null ? null : actorEffects.get(MovementEffectType.GLIDE_BOOST);
+        return effect != null && effect.activeAt(this.completedFrame + 1);
+    }
+
+    public void retainEntities(final IntPredicate present) {
+        this.effects.keySet().removeIf(id -> !present.test(id));
+    }
+
+    public void clear() {
+        this.effects.clear();
+        this.completedFrame = -1;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/PlayerPosture.java b/src/main/java/net/raphimc/viabedrock/api/model/PlayerPosture.java
