+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+import java.util.UUID;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerCorrectionTest {
+
+    private static final UUID ACTOR = UUID.randomUUID();
+    private static final UUID LIFETIME = UUID.randomUUID();
+
+    private static PlayerCorrection correction(final int teleport, final long tick, final Float angular) {
+        return new PlayerCorrection(42, ACTOR, LIFETIME, teleport, teleport == 0 ? 7 : -1,
+                new MovementCorrectionTiming(tick, 105, 5, 100, -1),
+                new Position3f(2F, 65.62F, -3F), new Position3f(0.25F, -0.5F, 1F),
+                new Position2f(5F, 90F), angular, 1.62F, 90F, true);
+    }
+
+    @Test
+    void retainsUnsignedClocksExactMotionAndOptionalAngularState() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int teleport : new int[]{0, Integer.MIN_VALUE}) {
+                for (long tick : new long[]{0, 1, Long.MAX_VALUE, Long.MIN_VALUE, -1}) {
+                    for (Float angular : new Float[]{null, 0F, 0.75F}) {
+                        final var correction = correction(teleport, tick, angular);
+                        PlayerCorrection.TYPE.write(buffer, correction);
+                        assertEquals(correction, PlayerCorrection.TYPE.read(buffer));
+                        assertFalse(buffer.isReadable());
+                        buffer.clear();
+                    }
+                }
+            }
+            for (int version : new int[]{0, 1, 3}) {
+                Types.VAR_INT.writePrimitive(buffer, version);
+                assertThrows(IllegalArgumentException.class, () -> PlayerCorrection.TYPE.read(buffer));
+                buffer.clear();
+            }
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerCorrection.TYPE.read(buffer));
+            buffer.clear();
+            PlayerCorrection.TYPE.write(buffer, correction(-3, 100, null));
+            buffer.writeByte(1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerCorrection.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> correction(-3, 100, Float.NaN));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void consumesOnlyThePairedPacketAndDoesNotRequireTodaysActorToStillExist() {
+        final var tracker = new PlayerCorrectionTracker();
+        final var player = correction(-3, 100, null);
+        tracker.accept(player);
+        assertSame(player, tracker.consumePlayer(-3));
+        assertNull(tracker.consumePlayer(-3));
+        tracker.accept(player);
+        assertNull(tracker.consumePlayer(-4));
+        assertNull(tracker.consumePlayer(-3));
+        final var vehicle = correction(0, 100, 0.75F);
+        tracker.accept(vehicle);
+        assertSame(vehicle, tracker.consumeVehicle(vehicle.javaPosition(), vehicle.javaYaw(), vehicle.rotation().x()));
+        tracker.accept(vehicle);
+        assertNull(tracker.consumeVehicle(Position3f.ZERO, vehicle.javaYaw(), vehicle.rotation().x()));
+        assertNull(tracker.consumeVehicle(vehicle.javaPosition(), vehicle.javaYaw(), vehicle.rotation().x()));
+        tracker.accept(player);
+        tracker.clear();
+        assertNull(tracker.consumePlayer(-3));
+    }
+
+    @Test
+    void comparesNativeFloatSquaredToleranceAndOnlyPresentVehicleFields() {
+        final var correction = correction(0, 100, 0.75F);
+        final var position = correction.javaPosition();
+        final var motion = correction.motion();
+        final var rotation = new Position2f(5F, 0F);
+        assertFalse(correction.differs(position, motion, true, rotation, 0.75F));
+        assertFalse(correction.differs(position.add(0.003F, 0F, 0F), motion, true, rotation, 0.75F));
+        assertTrue(correction.differs(position.add(0.004F, 0F, 0F), motion, true, rotation, 0.75F));
+        assertTrue(correction.differs(position, motion.add(0F, 0.004F, 0F), true, rotation, 0.75F));
+        assertTrue(correction.differs(position, motion, false, rotation, 0.75F));
+        assertTrue(correction.differs(position, motion, true, new Position2f(5.004F, 0F), 0.75F));
+        assertFalse(correction.differs(position, motion, true, rotation, null));
+        assertFalse(correction.differs(position, motion, true, rotation, 0.75009F));
+        assertTrue(correction.differs(position, motion, true, rotation, 0.7502F));
+        assertFalse(correction(-3, 100, null).differs(position, motion, true, new Position2f(90F, 180F), 2F));
+    }
+
+}
