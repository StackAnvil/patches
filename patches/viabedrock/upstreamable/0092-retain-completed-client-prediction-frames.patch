+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.PlayerPredictionStorage;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerPredictionTest {
+
+    @Test
+    void preservesMotionAndPoseAcrossTheVersionedWireFormat() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var frame = new PlayerPrediction(42, new Position3f(-6.5F, 101.86157F, 1.5F),
+                    new Position3f(0.125F, -0.022315647F, -0.25F), new PlayerPosture(true, true, true), true, false, true, true, 0.35F * 0.35F);
+            PlayerPrediction.TYPE.write(buffer, frame);
+            assertEquals(frame, PlayerPrediction.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            for (final int revision : new int[]{1, 2, 3, 4, 5, 6, 8}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, revision);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+            }
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 7);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsNonFiniteMotionAndUnknownPoseFlags() {
+        assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(-1, Position3f.ZERO,
+                Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, 1F));
+        for (float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42, Position3f.ZERO,
+                    new Position3f(0F, invalid, 0F), PlayerPosture.STANDING, false, false, false, false, 1F));
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42,
+                    new Position3f(invalid, 0F, 0F), Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, 1F));
+        }
+        for (float invalid : new float[]{-1F, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new PlayerPrediction(42, Position3f.ZERO,
+                    Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, invalid));
+        }
+        final var buffer = Unpooled.buffer();
+        try {
+            PlayerPrediction.TYPE.write(buffer, frame(Position3f.ZERO, false));
+            buffer.setByte(buffer.writerIndex() - 5, 128);
+            assertThrows(IllegalArgumentException.class, () -> PlayerPrediction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void preservesIndependentPoseCollisionAndJumpEventsInStationaryFrames() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int flags = 0; flags < 128; flags++) {
+                for (float scale : new float[]{0F, 0.35F * 0.35F, 0.25F, 1F}) {
+                    final var frame = new PlayerPrediction(42, Position3f.ZERO, Position3f.ZERO,
+                            new PlayerPosture((flags & 1) != 0, (flags & 16) != 0, (flags & 32) != 0), (flags & 2) != 0, (flags & 4) != 0, (flags & 8) != 0, (flags & 64) != 0, scale);
+                    PlayerPrediction.TYPE.write(buffer, frame);
+                    assertEquals(frame, PlayerPrediction.TYPE.read(buffer));
+                    buffer.clear();
+                }
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void consumesOnlyOneMatchingFrameAndDiscardsTeleportStaleness() {
+        final var storage = new PlayerPredictionStorage();
+        final var frame = new PlayerPrediction(42, new Position3f(0.5F, 101F, 0.5F), Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, true, false, 1F);
+        storage.record(frame);
+        assertEquals(frame, storage.take(frame.position().add(0F, 0.00001F, 0F)));
+        assertNull(storage.take(frame.position()));
+        final var misplaced = new PlayerPrediction(43, frame.position(), frame.motion(), frame.posture(), false, false, true, false, 1F);
+        storage.record(misplaced);
+        assertNull(storage.take(misplaced.position().add(0F, 5F, 0F)));
+        assertNull(storage.take(frame.position()));
+        final var next = new PlayerPrediction(44, frame.position(), frame.motion(), frame.posture(), false, false, false, false, 1F);
+        final var replacement = new PlayerPrediction(45, frame.position(), Position3f.ZERO, frame.posture(), false, false, false, false, 1F);
+        storage.record(next);
+        storage.record(replacement);
+        assertEquals(replacement, storage.take(frame.position()));
+    }
+
+    @Test
+    void rejectsOldFramesWithoutReplacingNewerPendingPhysics() {
+        final var storage = new PlayerPredictionStorage();
+        final var older = frame(Position3f.ZERO, false);
+        final var newer = new PlayerPrediction(43, Position3f.ZERO, Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, false, false, 1F);
+        storage.record(older);
+        storage.record(newer);
+        storage.record(older);
+        assertEquals(newer, storage.take(Position3f.ZERO));
+        storage.record(newer);
+        assertNull(storage.take(Position3f.ZERO));
+    }
+
+    @Test
+    void retainsFrameIdentityAfterPositionRejectionAndResetsOnNewConnection() {
+        final var storage = new PlayerPredictionStorage();
+        final var frame = new PlayerPrediction(Long.MAX_VALUE, Position3f.ZERO, Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, false, false, 1F);
+        storage.record(frame);
+        assertNull(storage.take(new Position3f(1F, 0F, 0F)));
+        storage.record(frame);
+        storage.record(new PlayerPrediction(0, Position3f.ZERO, Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, false, false, 1F));
+        assertNull(storage.take(Position3f.ZERO));
+        final var reconnected = new PlayerPredictionStorage();
+        final var first = new PlayerPrediction(0, Position3f.ZERO, Position3f.ZERO,
+                PlayerPosture.STANDING, false, false, false, false, 1F);
+        reconnected.record(first);
+        assertEquals(first, reconnected.take(Position3f.ZERO));
+    }
+
+    @Test
+    void bindsInputTicksToExactClientFramesAndEvictsExpiredBindings() {
+        final var storage = new PlayerPredictionStorage();
+        assertEquals(-1, storage.clientFrame(0));
+        for (int tick = 1; tick <= 513; tick++) {
+            final var prediction = new PlayerPrediction(1000L + tick, Position3f.ZERO, Position3f.ZERO,
+                    PlayerPosture.STANDING, false, false, false, false, 1F);
+            storage.remember(tick, prediction);
+            assertEquals(1000L + tick, storage.clientFrame(tick));
+        }
+        assertEquals(513, storage.inputTick());
+        assertEquals(1513, storage.inputFrame());
+        storage.remember(514, null);
+        assertEquals(514, storage.inputTick());
+        assertEquals(-1, storage.inputFrame());
+        assertEquals(1513, storage.clientFrame(513));
+        assertEquals(-1, storage.clientFrame(1));
+        assertEquals(-1, storage.clientFrame(2));
+        assertEquals(1003, storage.clientFrame(3));
+        assertEquals(-1, storage.clientFrame(514));
+        assertEquals(-1, new PlayerPredictionStorage().clientFrame(513));
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {0, 1, 2, 3, 512, 1000, 1001, 65535})
+    void boundsHistoryByTheServerLimitAndRetainsMissingPredictionClocks(final int capacity) {
+        final var storage = new PlayerPredictionStorage();
+        storage.configureHistory(capacity);
+        final int size = Math.clamp(capacity, 1, 1000);
+        final var prediction = frame(Position3f.ZERO, false);
+        for (long tick = 100; tick <= 100 + size; tick++) {
+            storage.remember(tick, prediction);
+        }
+        assertFalse(storage.acceptsCorrectionTick(100));
+        assertTrue(storage.acceptsCorrectionTick(101));
+        assertTrue(storage.acceptsCorrectionTick(101 + size));
+        assertTrue(storage.acceptsCorrectionTick(-1));
+        assertEquals(-1, storage.clientFrame(100));
+        assertEquals(prediction.frameId(), storage.clientFrame(101));
+        storage.remember(101 + size, null);
+        assertFalse(storage.acceptsCorrectionTick(101));
+        assertTrue(storage.acceptsCorrectionTick(102));
+        assertEquals(-1, storage.clientFrame(101));
+        assertEquals(-1, storage.inputFrame());
+    }
+
+    @Test
+    void startsNewHistoryOnClockGapsDuplicatesAndRewindsWithoutResettingFrameIdentity() {
+        final var storage = new PlayerPredictionStorage();
+        storage.configureHistory(3);
+        final var prediction = frame(Position3f.ZERO, false);
+        storage.record(prediction);
+        storage.remember(100, prediction);
+        storage.remember(101, null);
+        assertEquals(prediction.frameId(), storage.clientFrame(100));
+        storage.remember(105, prediction);
+        assertEquals(-1, storage.clientFrame(100));
+        assertFalse(storage.acceptsCorrectionTick(104));
+        storage.remember(106, null);
+        assertEquals(prediction.frameId(), storage.clientFrame(105));
+        storage.remember(106, null);
+        assertEquals(-1, storage.clientFrame(105));
+        assertFalse(storage.acceptsCorrectionTick(105));
+        storage.remember(104, null);
+        assertFalse(storage.acceptsCorrectionTick(103));
+        assertTrue(storage.acceptsCorrectionTick(104));
+        storage.configureHistory(2);
+        assertEquals(-1, storage.inputFrame());
+        assertFalse(storage.acceptsCorrectionTick(1));
+        storage.remember(1, null);
+        assertTrue(storage.acceptsCorrectionTick(1));
+        storage.record(prediction);
+        assertNull(storage.take(Position3f.ZERO));
+    }
+
+    @Test
+    void preservesUnsignedClockBoundariesAndReservesZeroEvenWhenCaptured() {
+        final var storage = new PlayerPredictionStorage();
+        storage.configureHistory(3);
+        final var prediction = frame(Position3f.ZERO, false);
+        storage.remember(Long.MAX_VALUE, prediction);
+        storage.remember(Long.MIN_VALUE, null);
+        assertEquals(prediction.frameId(), storage.clientFrame(Long.MAX_VALUE));
+        assertFalse(storage.acceptsCorrectionTick(Long.MAX_VALUE - 1));
+        assertTrue(storage.acceptsCorrectionTick(Long.MIN_VALUE));
+        storage.remember(-1, prediction);
+        assertEquals(-1, storage.clientFrame(Long.MAX_VALUE));
+        storage.remember(0, null);
+        storage.remember(1, null);
+        assertEquals(prediction.frameId(), storage.clientFrame(-1));
+        assertFalse(storage.acceptsCorrectionTick(0));
+        assertFalse(storage.acceptsCorrectionTick(1));
+        storage.remember(2, null);
+        assertTrue(storage.acceptsCorrectionTick(1));
+        assertFalse(storage.acceptsCorrectionTick(0));
+    }
+
+    @Test
+    void emitsIndependentSwimmingAndCrawlingEdgesOncePerConnection() {
+        final var storage = new PlayerPredictionStorage();
+        assertTrue(storage.postureTransitions(PlayerPosture.STANDING).isEmpty());
+        final var swimming = new PlayerPosture(true, false, false);
+        final var crawling = new PlayerPosture(false, true, false);
+        assertEquals(java.util.Set.of(StartSwimming), storage.postureTransitions(swimming));
+        assertTrue(storage.postureTransitions(swimming).isEmpty());
+        assertEquals(java.util.Set.of(StopSwimming, StartCrawling), storage.postureTransitions(crawling));
+        assertTrue(storage.postureTransitions(crawling).isEmpty());
+        assertEquals(crawling, storage.posture());
+        assertEquals(java.util.Set.of(StartSwimming, StopCrawling), storage.postureTransitions(swimming));
+        assertEquals(java.util.Set.of(StopSwimming), storage.postureTransitions(PlayerPosture.STANDING));
+        assertTrue(new PlayerPredictionStorage().postureTransitions(PlayerPosture.STANDING).isEmpty());
+    }
+
+    private static PlayerPrediction frame(final Position3f position, final boolean swimming) {
+        return new PlayerPrediction(42, position, new Position3f(0F, -0.022315647F, 0F), new PlayerPosture(swimming, false, false), false, false, false, false, 1F);
+    }
+
+}
