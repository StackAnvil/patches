+package net.raphimc.viabedrock.api.model;
+
+/** Retains the native SneakingComponent between input calculation and posture application. */
+public final class SneakingInputState {
+
+    private final SwiftSneakState swiftSneak = new SwiftSneakState();
+    private float scale = 0.3F;
+
+    public float advance(final PlayerPosture posture, final int equippedLevel) {
+        this.swiftSneak.update(equippedLevel);
+        final float inputScale = this.scale;
+        this.scale = posture.sneakingInputScale(this.swiftSneak.level());
+        return inputScale;
+    }
+
+    public State snapshot() {
+        return new State(this.swiftSneak.level(), this.scale);
+    }
+
+    public void restore(final State state) {
+        this.swiftSneak.restore(state.swiftSneakLevel());
+        this.scale = state.scale();
+    }
+
+    public record State(int swiftSneakLevel, float scale) {
+    }
+
+}
