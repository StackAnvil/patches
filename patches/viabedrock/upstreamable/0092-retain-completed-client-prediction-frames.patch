+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WaterMovementTest {
+
+    @Test
+    void matchesNativePitchLookupAtIndexAndPreviousAngleBoundaries() {
+        final float boundary = Float.intBitsToFloat(1048018945);
+        assertEquals(3146191471L, Integer.toUnsignedLong(Float.floatToRawIntBits(WaterMovement.swimmingLookY(boundary, -90F))));
+        assertEquals(0xBE54D99D, Float.floatToRawIntBits(WaterMovement.swimmingLookY(12F, 0F)));
+        assertEquals(0x3E54D9B2, Float.floatToRawIntBits(WaterMovement.swimmingLookY(-12F, 0F)));
+        final float previousBoundary = Float.intBitsToFloat((int) 3263193103L);
+        assertEquals(1063679265, Float.floatToRawIntBits(WaterMovement.swimmingLookY(previousBoundary, -90F)));
+        assertEquals(1063678565, Float.floatToRawIntBits(WaterMovement.swimmingLookY(previousBoundary, 0F)));
+        assertEquals(1063679265, Float.floatToRawIntBits(WaterMovement.swimmingLookY(previousBoundary, 90F)));
+    }
+
+    @Test
+    void carriesNativePitchIntoFlightAndOrdinarySwimmingControl() {
+        final float look = WaterMovement.swimmingLookY(Float.intBitsToFloat(1048018945), -90F);
+        assertEquals(998480696, Float.floatToRawIntBits(WaterMovement.swimmingVertical(-0.03125F, look, true, true, false, true, false)));
+        assertEquals(0F, WaterMovement.swimmingVertical(-0.03125F, WaterMovement.swimmingLookY(-12F, 0F), true, true, true, false, false));
+        assertEquals(-0.03125F, WaterMovement.swimmingVertical(-0.03125F, look, false, true, false, true, false));
+        final float downward = WaterMovement.swimmingLookY(12F, 0F);
+        assertEquals(3196423538L, Integer.toUnsignedLong(Float.floatToRawIntBits(WaterMovement.swimmingVertical(-0.03125F, downward, true, true, false, true, false))));
+        assertEquals(0xBD3D7D30, Float.floatToRawIntBits(WaterMovement.swimmingVertical(-0.03125F, downward, true, false, false, true, false)));
+    }
+
+    @Test
+    void matchesNativeOrdinarySpeedOrderAndGroundedEfficiency() {
+        final int[] levels = {0, 1, 3, 100, 0, 1, 3, 100};
+        final int[] expected = {0x3CA3D70A, 0x3D1D036A, 0x3D999999, 0x3D999999,
+            0x3CA3D70A, 0x3D681B4E, 0x3E051EB8, 0x3E051EB8};
+        for (int i = 0; i < levels.length; i++) {
+            assertEquals(expected[i], Float.floatToRawIntBits(WaterMovement.acceleration(0.02F, 0.13F, levels[i], i >= 4, false)));
+        }
+    }
+
+    @Test
+    void matchesNativeOrdinaryDragAcrossGroundSprintAndEnchantmentChanges() {
+        final Position3f motion = new Position3f(0.125F, -0.5F, -1.25F);
+        final int[] levels = {1, 1, 3, 3, 1, 1, 3, 3};
+        final int[] expectedX = {0x3DC1F672, 0x3DD74BC6, 0x3DAC49BB, 0x3DB91688,
+            0x3DB72016, 0x3DC83127, 0x3D8BC6A9, 0x3D8BC6A9};
+        final int[] expectedZ = {0xBF72740E, 0xBF868F5C, 0xBF575C2A, 0xBF675C2A,
+            0xBF64E81C, 0xBF7A3D71, 0xBF2EB853, 0xBF2EB853};
+        for (int i = 0; i < levels.length; i++) {
+            final Position3f result = WaterMovement.damp(motion, levels[i], i >= 4, (i & 1) != 0, 0.8F, false);
+            assertEquals(expectedX[i], Float.floatToRawIntBits(result.x()));
+            assertEquals(0xBECCCCCD, Float.floatToRawIntBits(result.y()));
+            assertEquals(expectedZ[i], Float.floatToRawIntBits(result.z()));
+        }
+    }
+
+    @Test
+    void matchesNativeBoostedSpeedAcrossEnchantmentLimitsAndAttributes() {
+        final float[] speeds = {0.04F, 0.04F, 0.04F, 0.04F, 0.04F, 0.04F, 1.950672F, 20F};
+        final int[] levels = {-100, 0, 1, 2, 3, 100, 0, 1};
+        final int[] expected = {0x3D656041, 0x3D656041, 0x3D83126F, 0x3D9374BC, 0x3DA3D70A, 0x3DA3D70A, 0x402EC7BC, 0x42000000};
+        for (int i = 0; i < speeds.length; i++) {
+            assertEquals(expected[i], Float.floatToRawIntBits(WaterMovement.acceleration(speeds[i], 0F, levels[i], false, true)));
+        }
+    }
+
+    @Test
+    void matchesNativeDampingAndPreservesSignedZero() {
+        final Position3f motion = new Position3f(0.125F, -0.5F, -1.25F);
+        final Position3f standing = WaterMovement.damp(motion, 0, false, false, 0.8F, true);
+        assertEquals(0x3DCCCCCD, Float.floatToRawIntBits(standing.x()));
+        assertEquals(0xBECCCCCD, Float.floatToRawIntBits(standing.y()));
+        assertEquals(0xBF800000, Float.floatToRawIntBits(standing.z()));
+        final Position3f sprinting = WaterMovement.damp(motion, 0, false, true, 0F, true);
+        assertEquals(0x3DE66666, Float.floatToRawIntBits(sprinting.x()));
+        assertEquals(0xBECCCCCD, Float.floatToRawIntBits(sprinting.y()));
+        assertEquals(0xBF900000, Float.floatToRawIntBits(sprinting.z()));
+        assertEquals(0x80000000, Float.floatToRawIntBits(WaterMovement.damp(motion, 0, false, false, 0F, true).z()));
+    }
+
+}
