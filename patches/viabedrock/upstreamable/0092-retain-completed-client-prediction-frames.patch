+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import com.viaversion.viaversion.api.type.Types;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import com.google.gson.JsonParser;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class MovementEffectTest {
+
+    @Test
+    void transportsUnsignedHistoryClocksAndRejectsContextsWithoutThem() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (long oldest : new long[]{0, 100, Long.MIN_VALUE, -1}) {
+                final var effect = new MovementEffect(1, 2, 100, 105, 5, 105, 5, oldest);
+                MovementEffect.TYPE.write(buffer, effect);
+                assertEquals(effect, MovementEffect.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+                buffer.clear();
+            }
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer,
+                    ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            assertThrows(IllegalArgumentException.class, () -> MovementEffect.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void expiresAgainstTheOriginalFrameInsteadOfReceiptTime() {
+        final MovementEffect effect = new MovementEffect(10, 0, 20, 81, 7, 0, -1, 0);
+        assertFalse(effect.activeAt(6));
+        assertTrue(effect.activeAt(7));
+        assertTrue(effect.activeAt(26));
+        assertFalse(effect.activeAt(27));
+        assertFalse(effect.activeAt(100));
+        assertFalse(new MovementEffect(10, 0, 20, 81, -1, 0, -1, 0).activeAt(7));
+        assertTrue(new MovementEffect(10, 0, -1, 81, 7, 0, -1, 0).activeAt(Long.MAX_VALUE));
+        assertTrue(new MovementEffect(10, 0, -1, 81, -1, 0, -1, 0).activeAt(Long.MAX_VALUE));
+        assertFalse(new MovementEffect(10, 0, 0, 81, 7, 0, -1, 0).activeAt(7));
+        assertFalse(new MovementEffect(10, 0, -2, 81, 7, 0, -1, 0).activeAt(7));
+    }
+
+    @Test
+    void agesMissingHistoryAgainstThePairedInputClock() {
+        final MovementEffect startup = new MovementEffect(1, 2, 100, 0, -1, 53, 8, 0);
+        assertEquals(-1, startup.clientFrame());
+        assertEquals(47, startup.remainingAt(8));
+        assertEquals(46, startup.remainingAt(9));
+        assertEquals(1, startup.remainingAt(54));
+        assertFalse(startup.activeAt(55));
+        final MovementEffect evicted = new MovementEffect(1, 0, 1000, 1, -1, 513, 100, 0);
+        assertEquals(488, evicted.remainingAt(100));
+        assertFalse(evicted.activeAt(588));
+        // Actual input ticks can advance more than completed frames during a prediction gap.
+        final MovementEffect gap = new MovementEffect(1, 1, 100, 100, 5, 180, 8, 0);
+        assertEquals(20, gap.remainingAt(8));
+        assertFalse(gap.activeAt(28));
+        final MovementEffect future = new MovementEffect(1, 0, 100, 514, -1, 513, 100, 0);
+        assertEquals(100, future.remainingAt(100));
+        assertTrue(future.activeAt(199));
+        assertFalse(future.activeAt(200));
+        assertFalse(new MovementEffect(1, 0, 100, 1, -1, 513, -1, 0).activeAt(100));
+    }
+
+    @Test
+    void usesNativeUnsignedClockComparisonAndSignedDurationWrap() {
+        assertEquals(97, new MovementEffect(1, 0, 100, 0x7FFF_FFFEL, -1, 0, -1, 0).adjustedDuration(0x8000_0001L));
+        assertEquals(97, new MovementEffect(1, 0, 100, 0xFFFF_FFFEL, -1, 0, -1, 0).adjustedDuration(0x1_0000_0001L));
+        assertEquals(100, new MovementEffect(1, 0, 100, Long.MIN_VALUE, -1, 0, -1, 0).adjustedDuration(Long.MAX_VALUE));
+        assertEquals(0, new MovementEffect(1, 0, Integer.MAX_VALUE, 0, -1, 0, -1, 0).adjustedDuration(0xFFFF_FFFFL));
+        assertEquals(-1, new MovementEffect(1, 0, -1, 0, -1, 0, -1, 0).adjustedDuration(-1));
+        assertEquals(0, new MovementEffect(1, 0, Integer.MIN_VALUE, 0, -1, 0, -1, 0).adjustedDuration(0));
+    }
+
+    @Test
+    void matchesTheOriginalNativeCommandConstructor() throws Exception {
+        final String reference = System.getenv("STACKANVIL_MOVEMENT_EFFECT_REFERENCE");
+        assumeTrue(reference != null);
+        final var cases = JsonParser.parseString(Files.readString(Path.of(reference))).getAsJsonArray();
+        for (final var entry : cases) {
+            final var scenario = entry.getAsJsonObject();
+            final long tick = Long.parseUnsignedLong(scenario.get("tick").getAsString());
+            final long clock = Long.parseUnsignedLong(scenario.get("clock").getAsString());
+            final MovementEffect effect = new MovementEffect(1, scenario.get("kind").getAsInt(),
+                    scenario.get("duration").getAsInt(), tick, -1, clock, 10, 0);
+            assertEquals(scenario.get("adjusted").getAsInt(), effect.adjustedDuration(clock));
+            assertEquals(scenario.get("adjusted").getAsInt(), effect.remainingAt(10));
+        }
+    }
+
+    @Test
+    void preservesSignedDurationsUnsignedTickBitsAndMissingFrameBindings() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int type : new int[]{0, 1, 2, 900}) {
+                for (int duration : new int[]{-1, 0, 1, Integer.MAX_VALUE}) {
+                    for (long tick : new long[]{0, 127, 128, Long.MIN_VALUE, -1}) {
+                        for (long frame : new long[]{-1, 0, Long.MAX_VALUE}) {
+                            final MovementEffect effect = new MovementEffect(99, type, duration, tick, frame, tick ^ Long.MIN_VALUE, frame, 0);
+                            MovementEffect.TYPE.write(buffer, effect);
+                            assertEquals(effect, MovementEffect.TYPE.read(buffer));
+                            assertFalse(buffer.isReadable());
+                            buffer.clear();
+                        }
+                    }
+                }
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
