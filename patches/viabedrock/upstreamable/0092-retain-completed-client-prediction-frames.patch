+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** Connection-owned mount identity for optional completed vehicle physics. */
+public record VehiclePredictionContext(long epoch, Identity vehicle) {
+
+    public static final String CHANNEL = "viabedrock:vehicle_prediction_context";
+    public static final Type<VehiclePredictionContext> TYPE = new Type<>(VehiclePredictionContext.class) {
+        @Override
+        public VehiclePredictionContext read(final ByteBuf buffer) {
+            readHeader(buffer);
+            final VehiclePredictionContext context = readContext(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected vehicle context fields");
+            }
+            return context;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final VehiclePredictionContext value) {
+            writeHeader(buffer);
+            writeContext(buffer, value);
+        }
+    };
+
+    public VehiclePredictionContext {
+        if (epoch < 0) {
+            throw new IllegalArgumentException("Invalid vehicle prediction epoch");
+        }
+    }
+
+    static void readHeader(final ByteBuf buffer) {
+        if (Types.VAR_INT.readPrimitive(buffer) != 1
+                || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+            throw new IllegalArgumentException("Unsupported vehicle prediction");
+        }
+    }
+
+    static void writeHeader(final ByteBuf buffer) {
+        Types.VAR_INT.writePrimitive(buffer, 1);
+        Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+    }
+
+    static VehiclePredictionContext readContext(final ByteBuf buffer) {
+        final long epoch = Types.VAR_LONG.readPrimitive(buffer);
+        final int present = buffer.readUnsignedByte();
+        if (present > 1) {
+            throw new IllegalArgumentException("Invalid vehicle context presence");
+        }
+        return new VehiclePredictionContext(epoch, present == 0 ? null : new Identity(
+                Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer), Types.UUID.read(buffer),
+                buffer.readLong(), buffer.readLong()));
+    }
+
+    static void writeContext(final ByteBuf buffer, final VehiclePredictionContext context) {
+        Types.VAR_LONG.writePrimitive(buffer, context.epoch());
+        buffer.writeByte(context.vehicle() != null ? 1 : 0);
+        if (context.vehicle() != null) {
+            final Identity identity = context.vehicle();
+            Types.VAR_INT.writePrimitive(buffer, identity.javaId());
+            Types.UUID.write(buffer, identity.javaUuid());
+            Types.UUID.write(buffer, identity.lifetime());
+            buffer.writeLong(identity.runtimeId());
+            buffer.writeLong(identity.uniqueId());
+        }
+    }
+
+    public record Identity(int javaId, UUID javaUuid, UUID lifetime, long runtimeId, long uniqueId) {
+        public Identity {
+            Objects.requireNonNull(javaUuid, "javaUuid");
+            Objects.requireNonNull(lifetime, "lifetime");
+            if (javaId < 0) {
+                throw new IllegalArgumentException("Invalid vehicle Java identity");
+            }
+        }
+    }
+
+}
