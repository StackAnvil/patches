+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.protocol.Protocol;
+import com.viaversion.viaversion.api.protocol.ProtocolManager;
+import com.viaversion.viaversion.api.protocol.packet.PacketType;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+import net.raphimc.viabedrock.api.model.PlayerPrediction;
+import net.raphimc.viabedrock.api.model.PlayerPosture;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.RewindType;
+import net.raphimc.viabedrock.protocol.data.enums.java.Relative;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.PlayerPredictionStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.lang.reflect.Proxy;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerCorrectionPacketTest {
+
+    private final List<PacketWrapper> sent = new ArrayList<>();
+    private Field managerField;
+    private Object previousManager;
+
+    @BeforeEach
+    void captureSentPackets() throws Exception {
+        this.managerField = Via.class.getDeclaredField("manager");
+        this.managerField.setAccessible(true);
+        this.previousManager = this.managerField.get(null);
+        final ProtocolManager protocols = (ProtocolManager) Proxy.newProxyInstance(ProtocolManager.class.getClassLoader(),
+                new Class<?>[]{ProtocolManager.class}, (proxy, method, args) -> {
+                    if (!method.getName().equals("createPacketWrapper")) {
+                        throw new AssertionError(method.getName());
+                    }
+                    return new PacketWrapperImpl((PacketType) args[0], null, (UserConnection) args[2]) {
+                        @Override
+                        public void send(final Class<? extends Protocol> protocol, final boolean skipCurrentPipeline) {
+                            PlayerCorrectionPacketTest.this.sent.add(this);
+                        }
+                    };
+                });
+        this.managerField.set(null, Proxy.newProxyInstance(ViaManager.class.getClassLoader(), new Class<?>[]{ViaManager.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getProtocolManager")) {
+                        return protocols;
+                    }
+                    throw new AssertionError(method.getName());
+                }));
+    }
+
+    @AfterEach
+    void restoreManager() throws Exception {
+        this.managerField.set(null, this.previousManager);
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {0, 1})
+    void ignoresCorrectionsWithoutRetainedInputsBeforeReadingActorState(final int rewindType) throws Exception {
+        for (boolean reconfigured : new boolean[]{false, true}) {
+            final PlayerPredictionStorage predictions = new PlayerPredictionStorage();
+            if (reconfigured) {
+                predictions.remember(1, null);
+                predictions.configureHistory(3);
+            }
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                    new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                        if (method.getName().equals("get") && args[0] == PlayerPredictionStorage.class) {
+                            return predictions;
+                        }
+                        throw new AssertionError(method.getName());
+                    });
+            for (long tick : new long[]{0, 1, -1}) {
+                final var input = Unpooled.buffer();
+                try {
+                    input.writeByte(rewindType);
+                    BedrockTypes.POSITION_3F.write(input, new Position3f(1F, 70F, 2F));
+                    BedrockTypes.POSITION_3F.write(input, new Position3f(-0.25F, 0.5F, 1.25F));
+                    BedrockTypes.POSITION_2F.write(input, new Position2f(20F, 30F));
+                    input.writeBoolean(true);
+                    BedrockTypes.FLOAT_LE.writePrimitive(input, 0.75F);
+                    input.writeBoolean(true);
+                    BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, tick);
+                    final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.CORRECT_PLAYER_MOVE_PREDICTION, input, user);
+                    new TestProtocol().translate(packet);
+                    assertTrue(packet.isCancelled());
+                    assertFalse(input.isReadable());
+                    assertTrue(this.sent.isEmpty());
+                } finally {
+                    input.release();
+                }
+            }
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(longs = {0, 1, 7, 8, 9, 10, 11, Long.MAX_VALUE, Long.MIN_VALUE, -1})
+    void appliesAuthoritativeVelocityForEveryPoseAndCorrectionAge(final long tick) throws Exception {
+        for (boolean negotiated : new boolean[]{false, true}) {
+            for (boolean onGround : new boolean[]{false, true}) {
+                for (boolean gliding : new boolean[]{false, true}) {
+                    for (Position3f velocity : new Position3f[]{Position3f.ZERO, new Position3f(-0.25F, 0.5F, 1.25F)}) {
+                        this.sent.clear();
+                        final ChannelStorage channels = new ChannelStorage();
+                        if (negotiated) {
+                            channels.addChannels(List.of(PlayerCorrection.CHANNEL));
+                        }
+                        final EntityTracker[] trackers = new EntityTracker[1];
+                        final PlayerPredictionStorage predictions = new PlayerPredictionStorage();
+                        predictions.configureHistory(3);
+                        for (long retainedTick = 8; retainedTick <= 10; retainedTick++) {
+                            predictions.remember(retainedTick, negotiated ? new PlayerPrediction(retainedTick - 8, Position3f.ZERO,
+                                    Position3f.ZERO, PlayerPosture.STANDING, false, false, false, false, 1F) : null);
+                        }
+                        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+                                new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) -> method.getName().equals("getServerState") ? State.PLAY : null);
+                        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                                    if (method.getName().equals("getProtocolInfo")) {
+                                        return info;
+                                    }
+                                    if (method.getName().equals("get")) {
+                                        if (args[0] == EntityTracker.class) {
+                                            return trackers[0];
+                                        } else if (args[0] == ChannelStorage.class) {
+                                            return channels;
+                                        } else if (args[0] == PlayerPredictionStorage.class) {
+                                            return predictions;
+                                        }
+                                    }
+                                    return null;
+                                });
+                        final EntityTracker tracker = trackers[0] = new EntityTracker(user);
+                        final ClientPlayerEntity player = tracker.addEntity(new ClientPlayerEntity(user, 1,
+                                UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0)), false);
+                        player.setGliding(gliding);
+                        player.setOnGround(!onGround);
+                        for (int i = 0; i < 10; i++) {
+                            player.tick();
+                        }
+                        final Position3f position = new Position3f(2.5F, 65.62F, -3.5F);
+                        final Position3f previousPosition = player.position();
+                        final var input = Unpooled.buffer();
+                        final var output = Unpooled.buffer();
+                        try {
+                            input.writeByte(RewindType.Player.getValue());
+                            BedrockTypes.POSITION_3F.write(input, position);
+                            BedrockTypes.POSITION_3F.write(input, velocity);
+                            BedrockTypes.POSITION_2F.write(input, new Position2f(0F, 0F));
+                            input.writeBoolean(true);
+                            BedrockTypes.FLOAT_LE.writePrimitive(input, 0.75F);
+                            input.writeBoolean(onGround);
+                            BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, tick);
+                            final PacketWrapper packet = new PacketWrapperImpl(ClientboundBedrockPackets.CORRECT_PLAYER_MOVE_PREDICTION, input, user);
+                            new TestProtocol().translate(packet);
+                            if (Long.compareUnsigned(tick, 8) < 0) {
+                                assertTrue(packet.isCancelled());
+                                assertEquals(previousPosition, player.position());
+                                assertEquals(!onGround, player.isOnGround());
+                                assertTrue(this.sent.isEmpty());
+                                assertFalse(input.isReadable());
+                                continue;
+                            }
+                            assertFalse(packet.isCancelled());
+                            packet.writeToBuffer(output);
+                            assertEquals(ClientboundPackets26_3.PLAYER_POSITION.getId(), Types.VAR_INT.readPrimitive(output));
+                            final int teleportId = Types.VAR_INT.readPrimitive(output);
+                            assertTrue(teleportId < 0);
+                            assertEquals(negotiated ? 1 : 0, this.sent.size());
+                            if (negotiated) {
+                                final PacketWrapper state = this.sent.getFirst();
+                                assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD, state.getPacketType());
+                                assertEquals(PlayerCorrection.CHANNEL, state.get(Types.STRING, 0));
+                                final var correction = state.get(PlayerCorrection.TYPE, 0);
+                                assertEquals(player.javaId(), correction.entityId());
+                                assertEquals(player.javaUuid(), correction.uuid());
+                                assertEquals(player.nativeActorSnapshot().lifetime(), correction.lifetime());
+                                assertEquals(teleportId, correction.teleportId());
+                                assertEquals(tick, correction.timing().serverTick());
+                                assertEquals(10, correction.timing().inputTick());
+                                assertEquals(2, correction.timing().inputFrame());
+                                assertEquals(8, correction.timing().historyStartTick());
+                                assertEquals(position, correction.position());
+                                assertEquals(velocity, correction.motion());
+                                assertEquals(onGround, correction.onGround());
+                            }
+                            assertEquals(position.x(), output.readDouble());
+                            assertEquals(position.y() - player.eyeOffset(), output.readDouble());
+                            assertEquals(position.z(), output.readDouble());
+                            assertEquals(velocity.x(), output.readDouble());
+                            assertEquals(velocity.y(), output.readDouble());
+                            assertEquals(velocity.z(), output.readDouble());
+                            output.readFloat();
+                            output.readFloat();
+                            final int flags = output.readInt();
+                            assertEquals(0, flags & ((1 << Relative.DELTA_X.ordinal()) | (1 << Relative.DELTA_Y.ordinal()) | (1 << Relative.DELTA_Z.ordinal())));
+                            assertEquals(negotiated ? previousPosition : position, player.position());
+                            assertEquals(negotiated ? !onGround : onGround, player.isOnGround());
+                            assertFalse(input.isReadable());
+                            assertFalse(output.isReadable());
+                        } finally {
+                            input.release();
+                            output.release();
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            ClientPlayerPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+    }
+
+}
