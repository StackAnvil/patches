+        }
+
+        private void acceptVehicle(final VehiclePrediction prediction, final boolean trailing) throws Exception {
+            final var bytes = Unpooled.buffer();
+            try {
+                Types.STRING.write(bytes, VehiclePrediction.CHANNEL);
+                VehiclePrediction.TYPE.write(bytes, prediction);
+                if (trailing) {
+                    bytes.writeByte(0);
+                }
+                final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundPackets26_3.CUSTOM_PAYLOAD, bytes, this.user);
+                MultiStatePackets.CUSTOM_PAYLOAD_HANDLER.handle(wrapper);
+                assertTrue(wrapper.isCancelled());
+                assertEquals(this.vehicles.enabled(), !bytes.isReadable());
+            } finally {
+                bytes.release();
+            }
+        }
+
+        private void vehicleMove(final Position3f position) throws Exception {
+            final var bytes = Unpooled.buffer();
+            try {
+                Types.DOUBLE.write(bytes, (double) position.x());
+                Types.DOUBLE.write(bytes, (double) position.y());
+                Types.DOUBLE.write(bytes, (double) position.z());
+                Types.FLOAT.write(bytes, 0F);
+                Types.FLOAT.write(bytes, 0F);
+                Types.BOOLEAN.write(bytes, false);
+                final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundPackets26_3.MOVE_VEHICLE, bytes, this.user);
+                this.protocol.translate(wrapper);
+                assertTrue(wrapper.isCancelled());
+                assertFalse(bytes.isReadable());
+            } finally {
+                bytes.release();
+            }
+        }
+
+        private void correctVehicle(final Position3f position) throws Exception {
+            this.correct(position, 1);
+        }
+
+        private void move(final Position3f feet) throws Exception {
+            final var bytes = Unpooled.buffer();
+            try {
+                Types.DOUBLE.write(bytes, (double) feet.x());
+                Types.DOUBLE.write(bytes, (double) feet.y());
+                Types.DOUBLE.write(bytes, (double) feet.z());
+                Types.UNSIGNED_BYTE.write(bytes, (short) 0);
+                final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundPackets26_3.MOVE_PLAYER_POS, bytes, this.user);
+                this.protocol.translate(wrapper);
+                assertTrue(wrapper.isCancelled());
+                assertFalse(bytes.isReadable());
+            } finally {
+                bytes.release();
+            }
+        }
+
+        private void correct(final Position3f position) throws Exception {
+            this.correct(position, 0);
+        }
+
+        private void correct(final Position3f position, final int rewindType) throws Exception {
+            this.correct(position, rewindType, Position3f.ZERO);
+        }
+
+        private PacketWrapper correct(final Position3f position, final int rewindType, final Position3f velocity) throws Exception {
+            return this.correct(position, rewindType, velocity, new Position2f(0F, 0F), null);
+        }
+
+        private PacketWrapper correct(final Position3f position, final int rewindType, final Position3f velocity,
+                                      final Position2f rotation, final Float angular) throws Exception {
+            final var bytes = Unpooled.buffer();
+            try {
+                Types.BYTE.write(bytes, (byte) rewindType);
+                BedrockTypes.POSITION_3F.write(bytes, position);
+                BedrockTypes.POSITION_3F.write(bytes, velocity);
+                BedrockTypes.POSITION_2F.write(bytes, rotation);
+                Types.BOOLEAN.write(bytes, angular != null);
+                if (angular != null) {
+                    BedrockTypes.FLOAT_LE.write(bytes, angular);
+                }
+                Types.BOOLEAN.write(bytes, false);
+                BedrockTypes.UNSIGNED_VAR_LONG.write(bytes, 1L);
+                final PacketWrapper wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.CORRECT_PLAYER_MOVE_PREDICTION, bytes, this.user);
+                this.protocol.correct(wrapper);
+                assertFalse(bytes.isReadable());
+                return wrapper;
+            } finally {
+                bytes.release();
+            }
+        }
+
+        private Input tick() throws Exception {
+            final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundPackets26_3.CLIENT_TICK_END, null, this.user);
+            this.protocol.translate(wrapper);
+            if (wrapper.isCancelled()) {
+                return null;
+            }
+            final var bytes = Unpooled.buffer();
+            try {
+                wrapper.writeToBuffer(bytes);
+                assertEquals(ServerboundBedrockPackets.PLAYER_AUTH_INPUT.getId(), Types.VAR_INT.readPrimitive(bytes));
+                BedrockTypes.FLOAT_LE.read(bytes);
+                BedrockTypes.FLOAT_LE.read(bytes);
+                final Position3f position = BedrockTypes.POSITION_3F.read(bytes);
+                BedrockTypes.POSITION_2F.read(bytes);
+                BedrockTypes.FLOAT_LE.read(bytes);
+                final int count = BedrockTypes.UNSIGNED_VAR_INT.read(bytes);
+                for (int i = 0; i < count; i++) {
+                    BedrockTypes.VAR_INT.read(bytes);
+                }
+                for (int i = 0; i < 3; i++) {
+                    BedrockTypes.VAR_INT.read(bytes);
+                }
+                BedrockTypes.FLOAT_LE.read(bytes);
+                BedrockTypes.FLOAT_LE.read(bytes);
+                final long tick = BedrockTypes.UNSIGNED_VAR_LONG.read(bytes);
+                final Position3f velocity = BedrockTypes.POSITION_3F.read(bytes);
+                for (int i = 0; i < 3; i++) {
+                    assertFalse(Types.BOOLEAN.read(bytes));
+                }
+                if (Types.BOOLEAN.read(bytes)) {
+                    BedrockTypes.POSITION_2F.read(bytes);
+                }
+                final Long vehicleId = Types.BOOLEAN.read(bytes) ? BedrockTypes.VAR_LONG.read(bytes) : null;
+                BedrockTypes.POSITION_2F.read(bytes);
+                BedrockTypes.POSITION_3F.read(bytes);
+                BedrockTypes.POSITION_2F.read(bytes);
+                assertFalse(bytes.isReadable());
+                return new Input(position, velocity, tick, vehicleId);
+            } finally {
+                bytes.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.wrappers.close();
+            this.via.close();
+        }
+
+    }
+
+}
