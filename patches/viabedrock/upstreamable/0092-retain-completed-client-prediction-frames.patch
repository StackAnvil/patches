+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Completed local physics for one Java movement frame, never an authoritative position update. */
+public record PlayerPrediction(Position3f position, Position3f motion, boolean swimming, boolean horizontalCollision, boolean verticalCollision, boolean groundJump) {
+
+    public static final String CHANNEL = "viabedrock:player_prediction_v3";
+    public static final Type<PlayerPrediction> TYPE = new Type<>(PlayerPrediction.class) {
+        @Override
+        public PlayerPrediction read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 3
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported player prediction");
+            }
+            final Position3f position = readVector(buffer);
+            final Position3f motion = readVector(buffer);
+            final int flags = buffer.readUnsignedByte();
+            if ((flags & ~15) != 0) {
+                throw new IllegalArgumentException("Invalid player prediction flags");
+            }
+            return new PlayerPrediction(position, motion, (flags & 1) != 0, (flags & 2) != 0, (flags & 4) != 0, (flags & 8) != 0);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerPrediction value) {
+            Types.VAR_INT.writePrimitive(buffer, 3);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            writeVector(buffer, value.position());
+            writeVector(buffer, value.motion());
+            buffer.writeByte((value.swimming() ? 1 : 0) | (value.horizontalCollision() ? 2 : 0) | (value.verticalCollision() ? 4 : 0) | (value.groundJump() ? 8 : 0));
+        }
+    };
+
+    public PlayerPrediction {
+        requireFinite(position);
+        requireFinite(motion);
+    }
+
+    public boolean matches(final Position3f position) {
+        return close(this.position.x(), position.x()) && close(this.position.y(), position.y())
+                && close(this.position.z(), position.z());
+    }
+
+    private static boolean close(final float expected, final float actual) {
+        // Java omits moves below 0.0002 blocks; eye-offset conversion also rounds float coordinates.
+        return Math.abs(expected - actual) <= Math.max(0.001F, Math.ulp(actual) * 2F);
+    }
+
+    private static void requireFinite(final Position3f vector) {
+        if (vector == null || !Float.isFinite(vector.x()) || !Float.isFinite(vector.y()) || !Float.isFinite(vector.z())) {
+            throw new IllegalArgumentException("Non-finite player prediction");
+        }
+    }
+
+    private static Position3f readVector(final ByteBuf buffer) {
+        return new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat());
+    }
+
+    private static void writeVector(final ByteBuf buffer, final Position3f vector) {
+        buffer.writeFloat(vector.x());
+        buffer.writeFloat(vector.y());
+        buffer.writeFloat(vector.z());
+    }
+
+}
