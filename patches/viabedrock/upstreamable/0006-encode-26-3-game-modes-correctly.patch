From 2c0e138f97a09bf7ae2c991f53ff39f8c49503cf Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 14:25:11 +0200
Subject: [PATCH] fix(respawn): encode 26.3 game modes correctly

Java 26.3 uses a VarInt and optional VarInt for respawn game modes. The old byte pair makes the client reject death respawns and dimension transfers.
---
 .../viabedrock/protocol/packet/ClientPlayerPackets.java       | 4 ++--
 .../net/raphimc/viabedrock/protocol/packet/WorldPackets.java  | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
index 3b7781aa..f3a0d693 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
@@ -120,8 +120,8 @@ public final class ClientPlayerPackets {
                         wrapper.write(Types.VAR_INT, chunkTracker.getDimension().ordinal()); // dimension id
                         wrapper.write(Types.STRING, chunkTracker.getDimension().getKey()); // dimension name
                         wrapper.write(Types.LONG, 0L); // hashed seed
-                        wrapper.write(Types.BYTE, (byte) clientPlayer.javaGameMode().ordinal()); // game mode
-                        wrapper.write(Types.BYTE, (byte) -1); // previous game mode
+                        wrapper.write(Types.VAR_INT, clientPlayer.javaGameMode().ordinal()); // game mode
+                        wrapper.write(Types.OPTIONAL_VAR_INT, null); // previous game mode
                         wrapper.write(Types.BOOLEAN, false); // is debug
                         wrapper.write(Types.BOOLEAN, gameSession.isFlatGenerator()); // is flat
                         wrapper.write(Types.OPTIONAL_GLOBAL_POSITION, null); // last death position
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
index 9a9fc45e..42330365 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
@@ -165,8 +165,8 @@ public final class WorldPackets {
             wrapper.write(Types.VAR_INT, dimension.ordinal()); // dimension id
             wrapper.write(Types.STRING, dimension.getKey()); // dimension name
             wrapper.write(Types.LONG, 0L); // hashed seed
-            wrapper.write(Types.BYTE, (byte) clientPlayer.javaGameMode().ordinal()); // game mode
-            wrapper.write(Types.BYTE, (byte) -1); // previous game mode
+            wrapper.write(Types.VAR_INT, clientPlayer.javaGameMode().ordinal()); // game mode
+            wrapper.write(Types.OPTIONAL_VAR_INT, null); // previous game mode
             wrapper.write(Types.BOOLEAN, false); // is debug
             wrapper.write(Types.BOOLEAN, gameSession.isFlatGenerator()); // is flat
             wrapper.write(Types.OPTIONAL_GLOBAL_POSITION, null); // last death position
-- 
2.55.0
