From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 28 Nov 2026 12:46:25 +0100
Subject: [PATCH] fix(entities): show arctic foxes with the Java snow type

The metadata rewriter had no VARIANT mapping for foxes, so it logged the
value and every arctic fox rendered as a red fox. DonutSMP's snowy spawn
showed this on join.

The vanilla 1.26.10 render controller controller.render.fox.v2 selects
[red, arctic] textures with query.variant, so variant 1 is the arctic fox.
Java's fox TYPE uses red 0 and snow 1. Other values keep the red fox, which
matches the texture array's first entry.

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
index 202f1a4157bfd8914f9ded15a686c8f2a028d4d5..cd5f14640e4d664ad6e2fe3a9124ce16daf06e63 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriter.java
@@ -380,6 +380,10 @@ public final class EntityMetadataRewriter {
                         final int javaVariant = variant;
                         javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.TYPE), VersionedTypes.V26_3.entityDataTypes().varIntType, javaVariant));
                     }
+                    case FOX -> {
+                        // controller.render.fox.v2 indexes [red, arctic] by query.variant; Java's fox types are red 0 and snow 1.
+                        javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.TYPE), VersionedTypes.V26_3.entityDataTypes().varIntType, variant == 1 ? 1 : 0));
+                    }
                     case PARROT -> { // TODO: Test when I can
                         final int javaVariant = variant;
                         javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(EntityDataFields.VARIANT), VersionedTypes.V26_3.entityDataTypes().varIntType, javaVariant));
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java
index a513981665feff5aa7ccd7ec84124c0157dd0b30..acf2bc909f0641131d085b0aa58a82f1ae1b3540 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/EntityMetadataRewriterTest.java
@@ -357,4 +357,28 @@ class EntityMetadataRewriterTest {
         }
     }
 
+    @Test
+    void arcticFoxesUseTheJavaSnowType() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+        final var field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("javaEntityDataFields");
+        field.setAccessible(true);
+        final Object previous = field.get(BedrockProtocol.MAPPINGS);
+        try {
+            field.set(BedrockProtocol.MAPPINGS, Map.of(EntityTypes26_3.FOX, List.of(EntityDataFields.TYPE)));
+            final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                    new Class<?>[]{UserConnection.class}, (proxy, method, args) -> null);
+            final Entity fox = new Entity(user, 1, 1, "minecraft:fox", 1, null, EntityTypes26_3.FOX);
+            for (final int[] variant : new int[][]{{0, 0}, {1, 1}}) {
+                final List<EntityData> translated = new ArrayList<>();
+                EntityMetadataRewriter.rewrite(user, fox, ActorDataIds.VARIANT,
+                        new EntityData(ActorDataIds.VARIANT.getValue(), EntityDataTypesBedrock.INT, variant[0]), translated);
+                assertEquals(1, translated.size());
+                assertEquals(variant[1], (int) translated.getFirst().value());
+                assertEquals(VersionedTypes.V26_3.entityDataTypes().varIntType, translated.getFirst().dataType());
+            }
+        } finally {
+            field.set(BedrockProtocol.MAPPINGS, previous);
+        }
+    }
+
 }
