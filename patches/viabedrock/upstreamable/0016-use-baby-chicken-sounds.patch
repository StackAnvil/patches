From dbe7674f9dd8c69d180f93556a4316a134366b4e Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 19:48:58 +0200
Subject: [PATCH] fix(audio): use dedicated baby chicken sounds

Recent Java versions have separate baby chicken sounds. Translate Bedrock chicken events marked as baby to those sounds, including explicit *.baby level events that have no chicken entry in the Bedrock mapping. Preserve configured volume and pitch ranges instead of pitching the adult sample.
---
 .../protocol/packet/WorldEffectPackets.java   | 28 +++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
index 8046c8c0..8a153baf 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
@@ -717,9 +717,17 @@ public final class WorldEffectPackets {
         }
         SoundDefinitions.ConfiguredSound configuredSound = null;
         if (!entityIdentifier.isEmpty()) { // entity specific sound
-            configuredSound = soundEvents.get(Key.namespaced(entityIdentifier));
+            final String entityId = Key.namespaced(entityIdentifier);
+            configuredSound = soundEvents.get(entityId);
+            if (configuredSound == null && "minecraft:chicken".equals(entityId) && soundEvent.endsWith(".baby")) {
+                final String adultEvent = soundEvent.substring(0, soundEvent.length() - ".baby".length());
+                final Map<String, SoundDefinitions.ConfiguredSound> adultSounds = BedrockProtocol.MAPPINGS.getBedrockLevelSoundEvents().get(adultEvent);
+                if (adultSounds != null && (configuredSound = adultSounds.get(entityId)) != null) {
+                    return babyMobSound(adultEvent, entityId, configuredSound);
+                }
+            }
             if (isBabyMob && configuredSound != null) {
-                configuredSound = new SoundDefinitions.ConfiguredSound(configuredSound.sound(), configuredSound.minVolume(), configuredSound.maxVolume(), configuredSound.minPitch() + 0.5F, configuredSound.maxPitch() + 0.5F);
+                configuredSound = babyMobSound(soundEvent, entityId, configuredSound);
             }
         }
         if (configuredSound == null && data != -1) { // block specific sound
@@ -747,6 +755,22 @@ public final class WorldEffectPackets {
         return configuredSound;
     }
 
+    private static SoundDefinitions.ConfiguredSound babyMobSound(final String soundEvent, final String entityIdentifier, final SoundDefinitions.ConfiguredSound sound) {
+        if ("minecraft:chicken".equals(entityIdentifier)) {
+            final String babyChickenSound = switch (soundEvent) {
+                case "ambient" -> "mob.baby_chicken.ambient";
+                case "death" -> "mob.baby_chicken.death";
+                case "hurt" -> "mob.baby_chicken.hurt";
+                case "step" -> "mob.baby_chicken.step";
+                default -> null;
+            };
+            if (babyChickenSound != null) {
+                return new SoundDefinitions.ConfiguredSound(babyChickenSound, sound.minVolume(), sound.maxVolume(), sound.minPitch(), sound.maxPitch());
+            }
+        }
+        return new SoundDefinitions.ConfiguredSound(sound.sound(), sound.minVolume(), sound.maxVolume(), sound.minPitch() + 0.5F, sound.maxPitch() + 0.5F);
+    }
+
     private WorldEffectPackets() {
     }
 
