 package net.raphimc.viabedrock.netty;
 
 import io.netty.channel.ChannelHandlerContext;
-import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelDuplexHandler;
 import io.netty.channel.ChannelPromise;
+import io.netty.util.ReferenceCountUtil;
+import org.cloudburstmc.netty.channel.raknet.RakDisconnectReason;
 
-public class DisconnectHandler extends ChannelOutboundHandlerAdapter {
+public class DisconnectHandler extends ChannelDuplexHandler {
 
     public static final String NAME = "viabedrock-disconnect-handler";
 
     private boolean calledDisconnect = false;
+    private boolean closed = false;
+
+    /** Whether the session behind this pipeline was closed locally or by its transport. */
+    public static boolean isClosed(final ChannelHandlerContext ctx) {
+        final DisconnectHandler handler = ctx.pipeline().get(DisconnectHandler.class);
+        return !ctx.channel().isOpen() || handler != null && handler.closed;
+    }
+
+    @Override
+    public void channelRead(final ChannelHandlerContext ctx, final Object msg) throws Exception {
+        // RakNet keeps delivering ordered datagrams while it finishes a disconnect. The application has
+        // already left the Bedrock session, and Via stops translating once the channel closes.
+        if (this.closed || !ctx.channel().isOpen()) {
+            ReferenceCountUtil.release(msg);
+            return;
+        }
+        super.channelRead(ctx, msg);
+    }
+
+    @Override
+    public void userEventTriggered(final ChannelHandlerContext ctx, final Object event) throws Exception {
+        if (event instanceof RakDisconnectReason) {
+            this.calledDisconnect = true;
+            this.closed = true;
+        }
+        super.userEventTriggered(ctx, event);
+    }
 
     @Override
     public void close(final ChannelHandlerContext ctx, final ChannelPromise promise) throws Exception {
+        this.closed = true;
         if (ctx.channel().isActive() && !this.calledDisconnect) {
             this.calledDisconnect = true;
             ctx.disconnect(promise); // Send disconnect notification to the server and close the channel
diff --git a/src/test/java/net/raphimc/viabedrock/netty/DisconnectHandlerTest.java b/src/test/java/net/raphimc/viabedrock/netty/DisconnectHandlerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2416f1fceb3667f01b69823e1b4b68f0b82925a4
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/netty/DisconnectHandlerTest.java
@@ -0,0 +1,161 @@
+package net.raphimc.viabedrock.netty;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelPromise;
+import io.netty.channel.embedded.EmbeddedChannel;
+import org.cloudburstmc.netty.channel.raknet.RakDisconnectReason;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class DisconnectHandlerTest {
+
+    @Test
+    void transportDisconnectEventsCloseWithoutStartingAnotherDisconnect() {
+        for (final RakDisconnectReason reason : RakDisconnectReason.values()) {
+            final var transport = new Transport();
+            final var channel = new EmbeddedChannel(true, true, transport, new DisconnectHandler());
+            try {
+                channel.pipeline().fireUserEventTriggered(reason);
+                final var close = channel.close();
+                assertTrue(close.isSuccess());
+                assertFalse(channel.isActive());
+                assertEquals(0, transport.disconnects);
+                assertEquals(1, transport.closes);
+            } finally {
+                channel.finishAndReleaseAll();
+            }
+        }
+    }
+
+    @Test
+    void localCloseStillSendsOneDisconnectAndPropagatesItsCompletion() {
+        final var transport = new Transport();
+        final var channel = new EmbeddedChannel(true, true, transport, new DisconnectHandler());
+        try {
+            channel.pipeline().fireUserEventTriggered(new Object());
+            final var close = channel.close();
+            channel.runPendingTasks();
+            assertTrue(close.isSuccess());
+            assertFalse(channel.isActive());
+            assertEquals(1, transport.disconnects);
+            assertEquals(1, transport.closes);
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void packetsKeepFlowUntilTheApplicationClosesTheSession() {
+        final var application = new Application();
+        final var channel = new EmbeddedChannel(true, true, new PendingDisconnectTransport(), new DisconnectHandler(), application);
+        final ByteBuf queued = Unpooled.wrappedBuffer(new byte[]{63, 0, 0});
+        try {
+            channel.pipeline().fireChannelRead(Unpooled.wrappedBuffer(new byte[]{5}));
+            assertEquals(1, application.received.size());
+
+            channel.close();
+            assertTrue(channel.isOpen(), "RakNet is still finishing the disconnect handshake");
+            channel.pipeline().fireChannelRead(queued);
+
+            assertEquals(1, application.received.size());
+            assertEquals(0, queued.refCnt());
+        } finally {
+            application.received.forEach(ByteBuf::release);
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void packetsAfterTransportDisconnectAreReleased() {
+        final var application = new Application();
+        final var channel = new EmbeddedChannel(true, true, new Transport(), new DisconnectHandler(), application);
+        final ByteBuf queued = Unpooled.wrappedBuffer(new byte[]{63, 0, 0});
+        try {
+            channel.pipeline().fireUserEventTriggered(RakDisconnectReason.TIMED_OUT);
+            channel.pipeline().fireChannelRead(queued);
+
+            assertTrue(application.received.isEmpty());
+            assertEquals(0, queued.refCnt());
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void packetsAfterDisconnectInTheSameBatchAreDiscarded() {
+        final Application application = new Application() {
+            @Override
+            public void channelRead(final ChannelHandlerContext ctx, final Object msg) {
+                super.channelRead(ctx, msg);
+                if (((ByteBuf) msg).getByte(0) == 5) {
+                    ctx.channel().close(); // The Java client leaves the session when it handles Disconnect.
+                }
+            }
+        };
+        final var channel = new EmbeddedChannel(true, true, new PendingDisconnectTransport(), new DisconnectHandler(),
+                new BatchLengthCodec(), application);
+        final ByteBuf batch = Unpooled.wrappedBuffer(new byte[]{1, 9, 1, 5, 3, 63, 0, 0, 1, 14});
+        try {
+            channel.pipeline().fireChannelRead(batch);
+            assertEquals(List.of(9, 5), application.received.stream().map(packet -> (int) packet.getByte(0)).toList());
+            application.received.forEach(ByteBuf::release);
+            assertEquals(0, batch.refCnt(), "The discarded remainder is released");
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    private static class Application extends ChannelInboundHandlerAdapter {
+
+        private final List<ByteBuf> received = new ArrayList<>();
+
+        @Override
+        public void channelRead(final ChannelHandlerContext ctx, final Object msg) {
+            this.received.add((ByteBuf) msg);
+        }
+
+    }
+
+    private static final class PendingDisconnectTransport extends ChannelOutboundHandlerAdapter {
+
+        @Override
+        public void disconnect(final ChannelHandlerContext ctx, final ChannelPromise promise) {
+            // RakNet completes the promise after the peer acknowledges or the session times out.
+        }
+
+    }
+
+    private static final class Transport extends ChannelOutboundHandlerAdapter {
+
+        private int disconnects;
+        private int closes;
+
+        @Override
+        public void disconnect(final ChannelHandlerContext ctx, final ChannelPromise promise) {
+            this.disconnects++;
+            ctx.pipeline().close().addListener(future -> {
+                if (future.isSuccess()) {
+                    promise.trySuccess();
+                } else {
+                    promise.tryFailure(future.cause());
+                }
+            });
+        }
+
+        @Override
+        public void close(final ChannelHandlerContext ctx, final ChannelPromise promise) {
+            this.closes++;
+            ctx.close(promise);
+        }
+
+    }
+
+}
