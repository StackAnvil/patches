+++ b/src/test/java/net/raphimc/viabedrock/netty/DisconnectHandlerTest.java
@@ -0,0 +1,74 @@
+package net.raphimc.viabedrock.netty;
+
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelPromise;
+import io.netty.channel.embedded.EmbeddedChannel;
+import org.cloudburstmc.netty.channel.raknet.RakDisconnectReason;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class DisconnectHandlerTest {
+
+    @Test
+    void transportDisconnectEventsCloseWithoutStartingAnotherDisconnect() {
+        for (final RakDisconnectReason reason : RakDisconnectReason.values()) {
+            final var transport = new Transport();
+            final var channel = new EmbeddedChannel(true, true, transport, new DisconnectHandler());
+            try {
+                channel.pipeline().fireUserEventTriggered(reason);
+                final var close = channel.close();
+                assertTrue(close.isSuccess());
+                assertFalse(channel.isActive());
+                assertEquals(0, transport.disconnects);
+                assertEquals(1, transport.closes);
+            } finally {
+                channel.finishAndReleaseAll();
+            }
+        }
+    }
+
+    @Test
+    void localCloseStillSendsOneDisconnectAndPropagatesItsCompletion() {
+        final var transport = new Transport();
+        final var channel = new EmbeddedChannel(true, true, transport, new DisconnectHandler());
+        try {
+            channel.pipeline().fireUserEventTriggered(new Object());
+            final var close = channel.close();
+            channel.runPendingTasks();
+            assertTrue(close.isSuccess());
+            assertFalse(channel.isActive());
+            assertEquals(1, transport.disconnects);
+            assertEquals(1, transport.closes);
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    private static final class Transport extends ChannelOutboundHandlerAdapter {
+
+        private int disconnects;
+        private int closes;
+
+        @Override
+        public void disconnect(final ChannelHandlerContext ctx, final ChannelPromise promise) {
+            this.disconnects++;
+            ctx.pipeline().close().addListener(future -> {
+                if (future.isSuccess()) {
+                    promise.trySuccess();
+                } else {
+                    promise.tryFailure(future.cause());
+                }
+            });
+        }
+
+        @Override
+        public void close(final ChannelHandlerContext ctx, final ChannelPromise promise) {
+            this.closes++;
+            ctx.close(promise);
+        }
+
+    }
+
+}
