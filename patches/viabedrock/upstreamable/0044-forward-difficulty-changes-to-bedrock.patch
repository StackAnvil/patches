+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ServerboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.Difficulty;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class DifficultyPacketsTest {
+
+    @Test
+    void onlyServerConfirmationChangesTheRetainedDifficulty() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var session = mock(GameSessionStorage.class, CALLS_REAL_METHODS);
+        session.setDifficulty(Difficulty.Normal);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        final var protocol = new TestProtocol();
+        final var request = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(request, 0);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CHANGE_DIFFICULTY, request, user);
+            protocol.serverbound(packet);
+            assertFalse(packet.isCancelled());
+            assertEquals(0, packet.get(BedrockTypes.UNSIGNED_VAR_INT, 0));
+            assertEquals(Difficulty.Normal, session.getDifficulty());
+        } finally {
+            request.release();
+        }
+        for (final Difficulty difficulty : new Difficulty[] {Difficulty.Peaceful, Difficulty.Normal}) {
+            final var update = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(update, difficulty.getValue());
+                final var packet = new PacketWrapperImpl(ClientboundBedrockPackets.SET_DIFFICULTY, update, user);
+                protocol.clientbound(packet);
+                assertEquals(difficulty.getValue(), packet.get(Types.VAR_INT, 0));
+                assertFalse(packet.get(Types.BOOLEAN, 0));
+                assertEquals(difficulty, session.getDifficulty());
+                assertFalse(update.isReadable());
+            } finally {
+                update.release();
+            }
+        }
+        final var invalid = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(invalid, 4);
+            final var packet = new PacketWrapperImpl(ServerboundPackets26_3.CHANGE_DIFFICULTY, invalid, user);
+            protocol.serverbound(packet);
+            assertTrue(packet.isCancelled());
+            assertEquals(Difficulty.Normal, session.getDifficulty());
+        } finally {
+            invalid.release();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            PlayPackets.register(this);
+        }
+
+        private void clientbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+
+        private void serverbound(final PacketWrapper packet) throws Exception {
+            final var mapping = this.serverboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
