From 1b75216b15b86a2a1baf8136a4c27e1d2a230544 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:06:08 +0200
Subject: [PATCH] fix(world): forward difficulty changes to Bedrock

Java 26.3 sends menu difficulty changes as a VarInt. Translate valid difficulty IDs to Bedrock protocol 2193 SetDifficulty so the world options control reaches the server.
---
 .../raphimc/viabedrock/protocol/packet/PlayPackets.java  | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/PlayPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/PlayPackets.java
index ad56b55e1..df5536fed 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/PlayPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/PlayPackets.java
@@ -85,6 +85,15 @@ public final class PlayPackets {
             wrapper.user().get(GameRulesStorage.class).updateGameRules(wrapper.read(BedrockTypes.GAME_RULE_ARRAY)); // game rules
         });
 
+        protocol.registerServerbound(ServerboundPackets26_3.CHANGE_DIFFICULTY, ServerboundBedrockPackets.SET_DIFFICULTY, wrapper -> {
+            final int difficulty = wrapper.read(Types.VAR_INT);
+            if (difficulty < 0 || difficulty > 3) {
+                wrapper.cancel();
+                return;
+            }
+            wrapper.write(BedrockTypes.UNSIGNED_VAR_INT, difficulty);
+        });
+
         protocol.registerServerbound(ServerboundPackets26_3.SET_GAME_RULE, null, wrapper -> {
             wrapper.cancel();
             final GameRulesStorage gameRules = wrapper.user().get(GameRulesStorage.class);
-- 
