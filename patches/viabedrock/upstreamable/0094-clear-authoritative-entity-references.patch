+    private Object value(final List<EntityData> data, final int index) {
+        assertEquals(1, data.size());
+        assertEquals(index, data.get(0).id());
+        final var buffer = Unpooled.buffer();
+        try {
+            VersionedTypes.V26_3.entityDataList.write(buffer, data);
+            final List<EntityData> decoded = VersionedTypes.V26_3.entityDataList.read(buffer);
+            assertEquals(0, buffer.readableBytes());
