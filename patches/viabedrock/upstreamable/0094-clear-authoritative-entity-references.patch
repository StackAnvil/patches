+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeProjectileOwnersTest {
+
+    @Test
+    void resolvesBothArrivalOrdersAndClearsUnloadedTargetsWithoutLosingIdentity() {
+        final Map<Integer, Actor> actors = new HashMap<>();
+        final NativeProjectileOwners<Actor> owners = registry(actors);
+        final Actor projectile = new Actor(10);
+        final Actor target = new Actor(20);
+        final var message = new NativeProjectileOwnerMessage.SetOwner(projectile.uuid, projectile.id, target.reference());
+        owners.apply(roundTrip(message));
+        actors.put(target.id, target);
+        owners.actorSpawned(target.id, target.uuid);
+        actors.put(projectile.id, projectile);
+        owners.actorSpawned(projectile.id, projectile.uuid);
+        assertSame(target, projectile.owner);
+        assertEquals(1, projectile.assignments);
+        owners.actorSpawned(target.id, target.uuid);
+        assertEquals(1, projectile.assignments);
+        actors.remove(target.id);
+        owners.actorRemoved(target.id, target.uuid, target);
+        assertNull(projectile.owner);
+        actors.put(target.id, target);
+        owners.actorSpawned(target.id, target.uuid);
+        assertSame(target, projectile.owner);
+
+        owners.clear();
+        actors.remove(target.id);
+        owners.apply(message);
+        assertNull(projectile.owner);
+        actors.put(target.id, target);
+        owners.actorSpawned(target.id, target.uuid);
+        assertSame(target, projectile.owner);
+    }
+
+    @Test
+    void rejectsReusedJavaIdsAndRetainsExplicitClearingBeforeSourceArrival() {
+        final Map<Integer, Actor> actors = new HashMap<>();
+        final NativeProjectileOwners<Actor> owners = registry(actors);
+        final Actor source = new Actor(10);
+        final Actor target = new Actor(20);
+        final Actor reused = new Actor(20);
+        actors.put(source.id, source);
+        actors.put(reused.id, reused);
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, target.reference()));
+        assertNull(source.owner);
+        owners.actorSpawned(reused.id, reused.uuid);
+        assertNull(source.owner);
+        actors.put(target.id, target);
+        owners.actorSpawned(target.id, target.uuid);
+        assertSame(target, source.owner);
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, null));
+        assertNull(source.owner);
+        owners.actorSpawned(target.id, target.uuid);
+        assertNull(source.owner);
+
+        actors.remove(source.id);
+        source.owner = target;
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, null));
+        actors.put(source.id, source);
+        owners.actorSpawned(source.id, source.uuid);
+        assertNull(source.owner);
+    }
+
+    @Test
+    void discardsReplacedBindingsRemovedSourcesAndPriorConnectionState() {
+        final Map<Integer, Actor> actors = new HashMap<>();
+        final NativeProjectileOwners<Actor> owners = registry(actors);
+        final Actor source = new Actor(10);
+        final Actor old = new Actor(20);
+        final Actor current = new Actor(21);
+        actors.put(source.id, source);
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, old.reference()));
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, current.reference()));
+        actors.put(old.id, old);
+        owners.actorSpawned(old.id, old.uuid);
+        assertNull(source.owner);
+        actors.put(current.id, current);
+        owners.actorSpawned(current.id, current.uuid);
+        assertSame(current, source.owner);
+        owners.actorRemoved(old.id, old.uuid, old);
+        assertSame(current, source.owner);
+        owners.actorRemoved(source.id, source.uuid, source);
+        final Actor replacement = new Actor(source.id);
+        actors.put(replacement.id, replacement);
+        owners.actorSpawned(replacement.id, replacement.uuid);
+        owners.actorSpawned(current.id, current.uuid);
+        assertNull(replacement.owner);
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(replacement.uuid, replacement.id, old.reference()));
+        owners.apply(roundTrip(new NativeProjectileOwnerMessage.Remove(replacement.uuid)));
+        replacement.owner = null;
+        owners.actorSpawned(old.id, old.uuid);
+        assertNull(replacement.owner);
+        owners.apply(new NativeProjectileOwnerMessage.SetOwner(source.uuid, source.id, current.reference()));
+        owners.clear();
+        actors.put(source.id, source);
+        source.owner = null;
+        owners.actorSpawned(source.id, source.uuid);
+        assertNull(source.owner);
+    }
+
+    @Test
+    void roundTripsLocalOwnerIdentityAndRejectsMalformedPayloads() {
+        final UUID uuid = UUID.randomUUID();
+        final var owner = new NativeProjectileOwnerMessage.Target(UUID.randomUUID(), Integer.MAX_VALUE, true);
+        final var set = new NativeProjectileOwnerMessage.SetOwner(uuid, Integer.MAX_VALUE, owner);
+        assertEquals(set, roundTrip(set));
+        assertEquals(new NativeProjectileOwnerMessage.SetOwner(uuid, 1, null), roundTrip(new NativeProjectileOwnerMessage.SetOwner(uuid, 1, null)));
+        assertThrows(IllegalArgumentException.class, () -> new NativeProjectileOwnerMessage.SetOwner(uuid, 0, owner));
+        assertThrows(IllegalArgumentException.class, () -> new NativeProjectileOwnerMessage.Target(uuid, -1, false));
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeProjectileOwnerMessage.TYPE.write(buffer, set);
+            final byte[] valid = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, valid);
+            buffer.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeProjectileOwnerMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeProjectileOwnerMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).writerIndex(valid.length - 1);
+            assertThrows(IndexOutOfBoundsException.class, () -> NativeProjectileOwnerMessage.TYPE.read(buffer));
+            buffer.clear().writeZero(NativeProjectileOwnerMessage.MAX_PAYLOAD_BYTES + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeProjectileOwnerMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static NativeProjectileOwners<Actor> registry(final Map<Integer, Actor> actors) {
+        return new NativeProjectileOwners<>(reference -> {
+            final Actor actor = actors.get(reference.entityId());
+            return actor != null && actor.uuid.equals(reference.uuid()) ? actor : null;
+        }, (source, owner) -> {
+            source.owner = owner;
+            source.assignments++;
+        });
+    }
+
+    private static NativeProjectileOwnerMessage roundTrip(final NativeProjectileOwnerMessage message) {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeProjectileOwnerMessage.TYPE.write(buffer, message);
+            final var result = NativeProjectileOwnerMessage.TYPE.read(buffer);
+            assertEquals(0, buffer.readableBytes());
+            return result;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static final class Actor {
+        private final int id;
+        private final UUID uuid = UUID.randomUUID();
+        private Actor owner;
+        private int assignments;
+
+        private Actor(final int id) {
+            this.id = id;
+        }
+
+        private NativeProjectileOwnerMessage.Target reference() {
+            return new NativeProjectileOwnerMessage.Target(this.uuid, this.id, false);
+        }
+    }
+
+}
