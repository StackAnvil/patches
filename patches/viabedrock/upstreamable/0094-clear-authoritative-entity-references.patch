+    private void spawnActor(final long uniqueId, final EntityTypes26_3 type, final EntityData[] data) throws Exception {
+        this.replaceMapping("bedrockToJavaEntities", Map.of(type.identifier(), type));
+        final Field typeId = EntityTypes26_3.class.getDeclaredField("id");
+        typeId.setAccessible(true);
+        final int previousId = typeId.getInt(type);
+        typeId.setInt(type, type.ordinal());
+        final var input = Unpooled.buffer();
+        try {
+            BedrockTypes.VAR_LONG.write(input, uniqueId);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(input, 20L + type.ordinal());
+            BedrockTypes.STRING.write(input, type.identifier());
+            BedrockTypes.POSITION_3F.write(input, new Position3f(0F, 64F, 0F));
+            BedrockTypes.POSITION_3F.write(input, new Position3f(0F, 0F, 0F));
+            BedrockTypes.POSITION_3F.write(input, new Position3f(0F, 0F, 0F));
+            BedrockTypes.FLOAT_LE.write(input, 0F);
+            BedrockTypes.UNSIGNED_VAR_INT.write(input, 0);
+            BedrockTypes.ENTITY_DATA_ARRAY.write(input, data);
+            BedrockTypes.ENTITY_PROPERTIES.write(input, new EntityProperties(new Int2IntOpenHashMap(), new Int2ObjectOpenHashMap<>()));
+            BedrockTypes.ENTITY_LINK_ARRAY.write(input, new EntityLink[0]);
+            final TestProtocol protocol = new TestProtocol();
+            try {
+                protocol.transform(Direction.CLIENTBOUND, State.PLAY, PacketWrapper.create(ClientboundBedrockPackets.ADD_ENTITY, input, this.user));
+            } catch (final CancelException expected) {
+                // The handler sends the translated spawn itself.
+            } catch (final Exception error) {
+                throw new AssertionError(error.getCause() == null ? error : error.getCause());
+            }
+        } finally {
+            input.release();
+            typeId.setInt(type, previousId);
+        }
+    }
+
+    private Object singleUpdate(final Entity source, final int index) {
+        assertEquals(1, this.sent.size());
+        final MetadataUpdate update = this.sent.remove(0);
+        assertEquals(source.javaId(), update.entityId());
+        return this.value(update.data(), index);
+    }
+
+    private Entity actor(final EntityTypes26_3 type) {
+        return new Entity(this.user, 10, 10, type.identifier(), 5, UUID.randomUUID(), type);
+    }
+
+    private Entity target(final long id, final int javaId) {
+        return this.tracker.addEntity(new Entity(this.user, id, javaId, EntityTypes26_3.PLAYER.identifier(), javaId,
+                UUID.randomUUID(), EntityTypes26_3.PLAYER), false);
+    }
+
+    private List<EntityData> update(final Entity actor, final ActorDataIds field, final long value) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(new EntityData[]{new EntityData(field.getValue(), EntityDataTypesBedrock.LONG, value)}, result);
+        return result;
+    }
+
+    private Object value(final List<EntityData> data, final int index) {
+        assertEquals(1, data.size());
+        assertEquals(index, data.get(0).id());
+        final var buffer = Unpooled.buffer();
+        try {
+            VersionedTypes.V26_3.entityDataList.write(buffer, data);
+            final List<EntityData> decoded = VersionedTypes.V26_3.entityDataList.read(buffer);
+            assertEquals(0, buffer.readableBytes());
+            assertEquals(data, decoded);
+            return decoded.get(0).value();
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private void replaceMapping(final String name, final Object value) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.previousMappings.putIfAbsent(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, value);
+    }
+
