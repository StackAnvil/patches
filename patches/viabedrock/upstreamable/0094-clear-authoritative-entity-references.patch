+    private List<EntityData> update(final Entity actor, final ActorDataIds field, final long value) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(new EntityData[]{new EntityData(field.getValue(), EntityDataTypesBedrock.LONG, value)}, result);
