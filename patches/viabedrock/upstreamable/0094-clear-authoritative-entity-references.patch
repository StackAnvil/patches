+    private static void rewriteTarget(final Entity entity, final String field, final long targetId, final long emptyId,
+                                      final EntityTracker tracker, final List<EntityData> javaEntityData) {
+        int javaTarget = 0;
+        if (targetId != emptyId) {
+            final Entity target = tracker.getEntityByUid(targetId);
+            if (target == null) {
+                ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to find " + field + " entity with id " + targetId + " for entity " + entity.type());
+                return;
+            }
+            javaTarget = target.javaId();
+        }
+        javaEntityData.add(new EntityData(entity.getJavaEntityDataIndex(field), VersionedTypes.V26_3.entityDataTypes().varIntType, javaTarget));
+    }
+
     private static Number readNumber(final EntityData data) {
         if (data.dataType() == null || data.getValue() == null) {
             throw new IllegalArgumentException("EntityData " + data.id() + " has null data type or value");
