+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityReferenceMetadataTest {
+
+    private final Map<Field, Object> previousMappings = new HashMap<>();
+    private UserConnection user;
+    private EntityTracker tracker;
+
+    @BeforeAll
+    static void initializeTypes() throws Exception {
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+    }
+
+    @BeforeEach
+    void setUp() throws Exception {
+        this.replaceMapping("bedrockEntityDataTypes", Map.of());
+        this.replaceMapping("javaEntityDataFields", Map.of(
+                EntityTypes26_3.GUARDIAN, List.of(EntityDataFields.ATTACK_TARGET),
+                EntityTypes26_3.ELDER_GUARDIAN, List.of(EntityDataFields.ATTACK_TARGET),
+                EntityTypes26_3.WITHER, List.of(EntityDataFields.TARGET_A, EntityDataFields.TARGET_B, EntityDataFields.TARGET_C),
+                EntityTypes26_3.WOLF, List.of(EntityDataFields.OWNERUUID)));
+        final AtomicReference<EntityTracker> storage = new AtomicReference<>();
+        this.user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (proxy, method, args) -> method.getName().equals("get") && args[0] == EntityTracker.class ? storage.get() : null);
+        this.tracker = new EntityTracker(this.user);
+        storage.set(this.tracker);
+    }
+
+    @AfterEach
+    void restoreMappings() throws Exception {
+        for (final var entry : this.previousMappings.entrySet()) {
+            entry.getKey().set(BedrockProtocol.MAPPINGS, entry.getValue());
+        }
+    }
+
+    @Test
+    void clearsAndRestoresGuardianTargetsIncludingEldersWithoutTruncatingNativeIds() {
+        final Entity target = this.target(-231928233983L, 41);
+        for (final EntityTypes26_3 type : new EntityTypes26_3[]{EntityTypes26_3.GUARDIAN, EntityTypes26_3.ELDER_GUARDIAN}) {
+            final Entity guardian = this.actor(type);
+            assertEquals(target.javaId(), this.value(this.update(guardian, ActorDataIds.TARGET, target.uniqueId()), 0));
+            assertEquals(0, this.value(this.update(guardian, ActorDataIds.TARGET, 0), 0));
+            assertEquals(0L, (long) guardian.entityData().get(ActorDataIds.TARGET).value());
+            assertEquals(target.javaId(), this.value(this.update(guardian, ActorDataIds.TARGET, target.uniqueId()), 0));
+        }
+    }
+
+    @Test
+    void clearsEveryWitherHeadIndependentlyAndRestoresItsTarget() {
+        final Entity target = this.target(-231928233974L, 73);
+        final Entity wither = this.actor(EntityTypes26_3.WITHER);
+        final ActorDataIds[] heads = {ActorDataIds.TARGET_A, ActorDataIds.TARGET_B, ActorDataIds.TARGET_C};
+        for (int index = 0; index < heads.length; index++) {
+            assertEquals(target.javaId(), this.value(this.update(wither, heads[index], target.uniqueId()), index));
+        }
+        for (int index = 0; index < heads.length; index++) {
+            assertEquals(0, this.value(this.update(wither, heads[index], -1), index));
+            assertEquals(-1L, (long) wither.entityData().get(heads[index]).value());
+            assertEquals(target.javaId(), this.value(this.update(wither, heads[index], target.uniqueId()), index));
+        }
+    }
+
+    @Test
+    void clearsAndRestoresTameableOwnerUuidWhileRetainingNativeIdentity() {
+        final Entity first = this.target(-9L, 11);
+        final Entity second = this.target(-12L, 12);
+        final Entity wolf = this.actor(EntityTypes26_3.WOLF);
+        assertEquals(first.javaUuid(), this.value(this.update(wolf, ActorDataIds.OWNER, first.uniqueId()), 0));
+        assertNull(this.value(this.update(wolf, ActorDataIds.OWNER, -1), 0));
+        assertEquals(-1L, (long) wolf.entityData().get(ActorDataIds.OWNER).value());
+        assertEquals(second.javaUuid(), this.value(this.update(wolf, ActorDataIds.OWNER, second.uniqueId()), 0));
+    }
+
+    private Entity actor(final EntityTypes26_3 type) {
+        return new Entity(this.user, 10, 10, type.identifier(), 5, UUID.randomUUID(), type);
+    }
+
+    private Entity target(final long id, final int javaId) {
+        return this.tracker.addEntity(new Entity(null, id, javaId, EntityTypes26_3.PLAYER.identifier(), javaId,
+                UUID.randomUUID(), EntityTypes26_3.PLAYER), false);
+    }
+
+    private List<EntityData> update(final Entity actor, final ActorDataIds field, final long value) {
+        final List<EntityData> result = new ArrayList<>();
+        actor.updateEntityData(new EntityData[]{new EntityData(field.getValue(), EntityDataTypesBedrock.LONG, value)}, result);
+        return result;
+    }
+
+    private Object value(final List<EntityData> data, final int index) {
+        assertEquals(1, data.size());
+        assertEquals(index, data.get(0).id());
+        final var buffer = Unpooled.buffer();
+        try {
+            VersionedTypes.V26_3.entityDataList.write(buffer, data);
+            final List<EntityData> decoded = VersionedTypes.V26_3.entityDataList.read(buffer);
+            assertEquals(0, buffer.readableBytes());
+            assertEquals(data, decoded);
+            return decoded.get(0).value();
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private void replaceMapping(final String name, final Object value) throws Exception {
+        final Field field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        this.previousMappings.put(field, field.get(BedrockProtocol.MAPPINGS));
+        field.set(BedrockProtocol.MAPPINGS, value);
+    }
+
+}
