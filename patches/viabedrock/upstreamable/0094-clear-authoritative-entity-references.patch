+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** Projectile Java UUIDs identify individual spawn lifetimes, including reused native actor IDs. */
+public sealed interface NativeProjectileOwnerMessage permits NativeProjectileOwnerMessage.SetOwner, NativeProjectileOwnerMessage.Remove {
+
+    String CHANNEL = "viabedrock:projectile_owner_v1";
+    int MAX_PAYLOAD_BYTES = 64;
+    Type<NativeProjectileOwnerMessage> TYPE = new Type<>(NativeProjectileOwnerMessage.class) {
+        @Override
+        public NativeProjectileOwnerMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported projectile ownership message");
+            }
+            final int kind = buffer.readUnsignedByte();
+            final UUID uuid = Types.UUID.read(buffer);
+            final NativeProjectileOwnerMessage message;
+            if (kind == 0) {
+                final int entityId = Types.VAR_INT.readPrimitive(buffer);
+                final Target owner = buffer.readBoolean()
+                        ? new Target(Types.UUID.read(buffer), Types.VAR_INT.readPrimitive(buffer), buffer.readBoolean()) : null;
+                message = new SetOwner(uuid, entityId, owner);
+            } else if (kind == 1) {
+                message = new Remove(uuid);
+            } else {
+                throw new IllegalArgumentException("Unknown projectile ownership message");
+            }
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing projectile ownership data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeProjectileOwnerMessage message) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(message instanceof SetOwner ? 0 : 1);
+            Types.UUID.write(buffer, message.uuid());
+            if (message instanceof SetOwner set) {
+                Types.VAR_INT.writePrimitive(buffer, set.entityId);
+                buffer.writeBoolean(set.owner != null);
+                if (set.owner != null) {
+                    Types.UUID.write(buffer, set.owner.uuid);
+                    Types.VAR_INT.writePrimitive(buffer, set.owner.entityId);
+                    buffer.writeBoolean(set.owner.localPlayer);
+                }
+            }
+        }
+    };
+
+    UUID uuid();
+
+    record Target(UUID uuid, int entityId, boolean localPlayer) {
+        public Target {
+            Objects.requireNonNull(uuid);
+            if (entityId <= 0) {
+                throw new IllegalArgumentException("Invalid projectile owner entity ID");
+            }
+        }
+    }
+
+    record SetOwner(UUID uuid, int entityId, Target owner) implements NativeProjectileOwnerMessage {
+        public SetOwner {
+            Objects.requireNonNull(uuid);
+            if (entityId <= 0) {
+                throw new IllegalArgumentException("Invalid projectile entity ID");
+            }
+        }
+    }
+
+    record Remove(UUID uuid) implements NativeProjectileOwnerMessage {
+        public Remove {
+            Objects.requireNonNull(uuid);
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeProjectileOwners.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeProjectileOwners.java
