+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.api.model.NativeProjectileOwnerMessage;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.generated.java.EntityDataFields;
+
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.LongFunction;
+
+/** Keeps native references while their targets are outside the Java client's entity set. */
+public final class EntityReferenceTracker {
+
+    private final LongFunction<Entity> lookup;
+    private final Map<Entity, EnumMap<Kind, Binding>> sources = new HashMap<>();
+    private final Map<Long, Set<Binding>> targets = new HashMap<>();
+
+    public EntityReferenceTracker(final LongFunction<Entity> lookup) {
+        this.lookup = lookup;
+    }
+
+    public EntityData update(final Entity source, final Kind kind, final long targetId) {
+        return metadata(source, kind, this.bind(source, kind, targetId));
+    }
+
+    public void updateProjectileOwner(final UserConnection user, final Entity source, final long targetId) {
+        sendProjectileMessage(user, projectileOwner(source, this.bind(source, Kind.PROJECTILE_OWNER, targetId)));
+    }
+
+    public static boolean isProjectile(final EntityTypes26_3 type) {
+        // ViaVersion groups fireballs separately from its projectile metadata family.
+        return type.isOrHasParent(EntityTypes26_3.PROJECTILE) || type.isOrHasParent(EntityTypes26_3.ABSTRACT_FIREBALL);
+    }
+
+    public int projectileSpawnData(final Entity source, final EntityData[] data) {
+        if (!isProjectile(source.javaType())) {
+            return 0;
+        }
+        long ownerId = -1L;
+        for (final EntityData field : data) {
+            if (field.id() == ActorDataIds.OWNER.getValue() && field.dataType() == EntityDataTypesBedrock.LONG
+                    && field.value() instanceof Long value) {
+                ownerId = value;
+            }
+        }
+        final Entity target = ownerId == -1L ? null : this.lookup.apply(ownerId);
+        return target == null ? 0 : target.javaId();
+    }
+
+    public void sendProjectileSnapshots(final UserConnection user) {
+        for (final EnumMap<Kind, Binding> kinds : this.sources.values()) {
+            final Binding binding = kinds.get(Kind.PROJECTILE_OWNER);
+            if (binding != null) {
+                sendProjectileMessage(user, projectileOwner(binding.source, binding.resolved));
+            }
+        }
+    }
+
+    private Entity bind(final Entity source, final Kind kind, final long targetId) {
+        final EnumMap<Kind, Binding> bindings = this.sources.computeIfAbsent(source, ignored -> new EnumMap<>(Kind.class));
+        final Binding previous = bindings.remove(kind);
+        if (previous != null) {
+            this.detach(previous);
+        }
+        Entity target = null;
+        if (targetId != kind.emptyId) {
+            target = this.lookup.apply(targetId);
+            final Binding binding = new Binding(source, kind, targetId, target);
+            bindings.put(kind, binding);
+            this.targets.computeIfAbsent(targetId, ignored -> new LinkedHashSet<>()).add(binding);
+        }
+        if (bindings.isEmpty()) {
+            this.sources.remove(source);
+        }
+        return target;
+    }
+
+    /** Call only after the target's Java spawn packet has been sent. */
+    public Updates actorSpawned(final Entity target) {
+        final Updates updates = new Updates(new LinkedHashMap<>(), new ArrayList<>());
+        if (this.lookup.apply(target.uniqueId()) != target) {
+            return updates;
+        }
+        for (final Binding binding : this.targets.getOrDefault(target.uniqueId(), Set.of())) {
+            if (binding.resolved != target) {
+                binding.resolved = target;
+                addUpdate(updates, binding, target);
+            }
+        }
+        return updates;
+    }
+
+    public Updates actorRemoved(final Entity actor) {
+        final EnumMap<Kind, Binding> owned = this.sources.remove(actor);
+        final Updates updates = new Updates(new LinkedHashMap<>(), new ArrayList<>());
+        if (owned != null) {
+            owned.values().forEach(this::detach);
+            if (owned.containsKey(Kind.PROJECTILE_OWNER)) {
+                updates.owners.add(new NativeProjectileOwnerMessage.Remove(actor.javaUuid()));
+            }
+        }
+        for (final Binding binding : this.targets.getOrDefault(actor.uniqueId(), Set.of())) {
+            if (binding.resolved == actor) {
+                binding.resolved = null;
+                addUpdate(updates, binding, null);
+            }
+        }
+        return updates;
+    }
+
+    public static void sendUpdates(final UserConnection user, final Updates updates) {
+        updates.metadata.forEach((entity, data) -> {
+            final PacketWrapper metadata = PacketWrapper.create(ClientboundPackets26_3.SET_ENTITY_DATA, user);
+            metadata.write(Types.VAR_INT, entity.javaId());
+            metadata.write(VersionedTypes.V26_3.entityDataList, data);
+            metadata.send(BedrockProtocol.class);
+        });
+        updates.owners.forEach(message -> sendProjectileMessage(user, message));
+    }
+
+    private static void addUpdate(final Updates updates, final Binding binding, final Entity target) {
+        if (binding.kind == Kind.PROJECTILE_OWNER) {
+            updates.owners.add(projectileOwner(binding.source, target));
+        } else {
+            updates.metadata.computeIfAbsent(binding.source, ignored -> new ArrayList<>())
+                    .add(metadata(binding.source, binding.kind, target));
+        }
+    }
+
+    private static NativeProjectileOwnerMessage.SetOwner projectileOwner(final Entity source, final Entity target) {
+        return new NativeProjectileOwnerMessage.SetOwner(source.javaUuid(), source.javaId(), target == null ? null
+                : new NativeProjectileOwnerMessage.Target(target.javaUuid(), target.javaId(), target instanceof ClientPlayerEntity));
+    }
+
+    private static void sendProjectileMessage(final UserConnection user, final NativeProjectileOwnerMessage message) {
+        final ChannelStorage channels = user.get(ChannelStorage.class);
+        if (channels != null && channels.hasChannel(NativeProjectileOwnerMessage.CHANNEL)
+                && user.getProtocolInfo().getServerState() == State.PLAY) {
+            final PacketWrapper payload = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+            payload.write(Types.STRING, NativeProjectileOwnerMessage.CHANNEL);
+            payload.write(NativeProjectileOwnerMessage.TYPE, message);
+            payload.send(BedrockProtocol.class);
+        }
+    }
+
+    private void detach(final Binding binding) {
+        final Set<Binding> dependents = this.targets.get(binding.targetId);
+        dependents.remove(binding);
+        if (dependents.isEmpty()) {
+            this.targets.remove(binding.targetId);
+        }
+    }
+
+    private static EntityData metadata(final Entity source, final Kind kind, final Entity target) {
+        return kind.uuid
+                ? new EntityData(source.getJavaEntityDataIndex(kind.field), VersionedTypes.V26_3.entityDataTypes().optionalUUIDType,
+                target == null ? null : target.javaUuid())
+                : new EntityData(source.getJavaEntityDataIndex(kind.field), VersionedTypes.V26_3.entityDataTypes().varIntType,
+                target == null ? 0 : target.javaId() + (kind == Kind.FISHING_TARGET ? 1 : 0));
+    }
+
+    public record Updates(Map<Entity, List<EntityData>> metadata, List<NativeProjectileOwnerMessage> owners) {
+    }
+
+    public enum Kind {
+        OWNER(EntityDataFields.OWNERUUID, -1L, true),
+        GUARDIAN_TARGET(EntityDataFields.ATTACK_TARGET, 0L, false),
+        FISHING_TARGET(EntityDataFields.HOOKED_ENTITY, 0L, false),
+        WITHER_TARGET_A(EntityDataFields.TARGET_A, -1L, false),
+        WITHER_TARGET_B(EntityDataFields.TARGET_B, -1L, false),
+        WITHER_TARGET_C(EntityDataFields.TARGET_C, -1L, false),
+        PROJECTILE_OWNER(null, -1L, false);
+
+        private final String field;
+        private final long emptyId;
+        private final boolean uuid;
+
+        Kind(final String field, final long emptyId, final boolean uuid) {
+            this.field = field;
+            this.emptyId = emptyId;
+            this.uuid = uuid;
+        }
+    }
+
+    private static final class Binding {
+        private final Entity source;
+        private final Kind kind;
+        private final long targetId;
+        private Entity resolved;
+
+        private Binding(final Entity source, final Kind kind, final long targetId, final Entity resolved) {
+            this.source = source;
+            this.kind = kind;
+            this.targetId = targetId;
+            this.resolved = resolved;
+        }
+    }
+
+}
