+package net.raphimc.viabedrock.api.model;
+
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.BiConsumer;
+import java.util.function.Function;
+
+/** Applies authoritative owners when the source and target exist in the frontend's entity set. */
+public final class NativeProjectileOwners<E> {
+
+    private final Function<NativeProjectileOwnerMessage.Target, E> lookup;
+    private final BiConsumer<E, E> assign;
+    private final Map<UUID, Binding<E>> sources = new HashMap<>();
+    private final Map<Integer, Set<Binding<E>>> targets = new HashMap<>();
+
+    public NativeProjectileOwners(final Function<NativeProjectileOwnerMessage.Target, E> lookup, final BiConsumer<E, E> assign) {
+        this.lookup = lookup;
+        this.assign = assign;
+    }
+
+    public void apply(final NativeProjectileOwnerMessage message) {
+        final Binding<E> previous = this.sources.remove(message.uuid());
+        if (previous != null) {
+            this.detach(previous);
+        }
+        if (message instanceof NativeProjectileOwnerMessage.SetOwner owner) {
+            final Binding<E> binding = new Binding<>(owner);
+            this.sources.put(owner.uuid(), binding);
+            if (owner.owner() != null) {
+                this.targets.computeIfAbsent(owner.owner().entityId(), ignored -> new LinkedHashSet<>()).add(binding);
+            }
+            this.resolve(binding);
+        }
+    }
+
+    public void actorSpawned(final int entityId, final UUID uuid) {
+        final Binding<E> source = this.sources.get(uuid);
+        if (source != null && source.message.entityId() == entityId) {
+            this.resolve(source);
+        }
+        for (final Binding<E> binding : this.targets.getOrDefault(entityId, Set.of())) {
+            this.resolve(binding);
+        }
+    }
+
+    /** Pass the actual removed actor so cleanup also works after lookup removal or ID reuse. */
+    public void actorRemoved(final int entityId, final UUID uuid, final E actor) {
+        final Binding<E> source = this.sources.get(uuid);
+        if (source != null && source.message.entityId() == entityId) {
+            this.sources.remove(uuid);
+            this.detach(source);
+        }
+        for (final Binding<E> binding : this.targets.getOrDefault(entityId, Set.of())) {
+            if (binding.resolvedTarget != null && binding.resolvedTarget == actor) {
+                binding.resolvedTarget = null;
+                final E projectile = this.lookup.apply(source(binding.message));
+                if (projectile != null) {
+                    this.assign.accept(projectile, null);
+                }
+            }
+        }
+    }
+
+    public void clear() {
+        this.sources.clear();
+        this.targets.clear();
+    }
+
+    private void resolve(final Binding<E> binding) {
+        final E projectile = this.lookup.apply(source(binding.message));
+        if (projectile == null) {
+            return;
+        }
+        final E owner = binding.message.owner() == null ? null : this.lookup.apply(binding.message.owner());
+        if (binding.resolvedSource != projectile || binding.resolvedTarget != owner) {
+            this.assign.accept(projectile, owner);
+            binding.resolvedSource = projectile;
+            binding.resolvedTarget = owner;
+        }
+    }
+
+    private void detach(final Binding<E> binding) {
+        if (binding.message.owner() == null) {
+            return;
+        }
+        final Set<Binding<E>> dependents = this.targets.get(binding.message.owner().entityId());
+        dependents.remove(binding);
+        if (dependents.isEmpty()) {
+            this.targets.remove(binding.message.owner().entityId());
+        }
+    }
+
+    private static NativeProjectileOwnerMessage.Target source(final NativeProjectileOwnerMessage.SetOwner message) {
+        return new NativeProjectileOwnerMessage.Target(message.uuid(), message.entityId(), false);
+    }
+
+    private static final class Binding<E> {
+        private final NativeProjectileOwnerMessage.SetOwner message;
+        private E resolvedSource;
+        private E resolvedTarget;
+
+        private Binding(final NativeProjectileOwnerMessage.SetOwner message) {
+            this.message = message;
+        }
+    }
+
+}
