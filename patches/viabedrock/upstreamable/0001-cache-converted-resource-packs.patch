+
+    @Test
+    void evictsLeastRecentlyUsedCompletedPacksWithoutChangingExistingArchives() {
+        final AtomicInteger conversions = new AtomicInteger();
+        final ConvertedResourcePackCache cache = new ConvertedResourcePackCache(this.directory, ViaBedrockConfig.PackCacheMode.MEMORY, storage -> {
+            conversions.incrementAndGet();
+            storage.getConverterData().put("ce_actor_scale", 1.5F);
+            return new InMemoryContent();
+        }, 2, 1024 * 1024);
+        final ResourcePack first = pack(UUID.randomUUID(), new byte[]{1});
+        final ResourcePack second = pack(UUID.randomUUID(), new byte[]{2});
+        final ResourcePack third = pack(UUID.randomUUID(), new byte[]{3});
+        try {
+            final var original = cache.prepare(new ResourcePackStorage(List.of(first))).join();
+            cache.prepare(new ResourcePackStorage(List.of(second))).join();
+            final ResourcePackStorage touched = new ResourcePackStorage(List.of(first));
+            assertSame(original, cache.prepare(touched).join());
+            assertEquals(1.5F, touched.getConverterData().get("ce_actor_scale"));
+            cache.prepare(new ResourcePackStorage(List.of(third))).join();
+            assertEquals(3, conversions.get());
+            cache.prepare(new ResourcePackStorage(List.of(second))).join();
