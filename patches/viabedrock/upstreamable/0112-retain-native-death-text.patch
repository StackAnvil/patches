+    @Test
+    void retainsRawFormattingBeforeTheMatchingJavaProjectionAndVisibilityChanges() throws Exception {
+        try (var fixture = new Fixture()) {
+            fixture.nativeChannel(true);
+            final String source = "§c  Native §lreason§r  ";
+            fixture.info(source);
+            assertTrue(fixture.nativeTexts.isEmpty());
+            fixture.death();
+            assertEquals(new NativeDeathText(fixture.lifetime, source, "  Native reason  "), fixture.nativeTexts.getFirst());
+            fixture.showReason(false);
+            assertEquals(new NativeDeathText(fixture.lifetime, "", ""), fixture.nativeTexts.getLast());
+            assertEquals(source, fixture.session.getDeathMessageSource());
+            fixture.showReason(true);
+            assertEquals(new NativeDeathText(fixture.lifetime, source, "  Native reason  "), fixture.nativeTexts.getLast());
+            assertEquals(List.of("native", "java", "native", "java", "native", "java"), fixture.emitted);
+            assertEquals(List.of("  Native reason  ", "", "  Native reason  "), fixture.messages);
+            fixture.channels.removeChannels(List.of(NativeDeathText.CHANNEL));
+            fixture.showReason(false);
+            assertEquals(3, fixture.nativeTexts.size());
+            assertEquals("", fixture.messages.getLast());
+        }
+    }
+
+    @Test
+    void retainsJavaDeathMessagesWithoutNativeActorNegotiationOrForOversizedSource() throws Exception {
+        for (final boolean oversized : List.of(false, true)) {
+            try (var fixture = new Fixture()) {
+                fixture.nativeChannel(oversized);
+                fixture.info(oversized ? "§l".repeat(20000) + "a" : "a");
+                fixture.death();
+                assertEquals(List.of("a"), fixture.messages);
+                assertTrue(fixture.nativeTexts.isEmpty());
+            }
+        }
+    }
