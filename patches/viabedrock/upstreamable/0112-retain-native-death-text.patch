+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.StringType;
+import io.netty.buffer.ByteBuf;
+import java.util.Objects;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Translated native source before Java formatting conversion, paired with its ordinary projection. */
+public record NativeDeathText(UUID lifetime, String source, String projected) {
+
+    public static final String CHANNEL = "viabedrock:native_death_text_v1";
+    public static final int MAX_TEXT_LENGTH = 32768;
+    private static final StringType TEXT = new StringType(MAX_TEXT_LENGTH);
+    public static final Type<NativeDeathText> TYPE = new Type<>(NativeDeathText.class) {
+        @Override
+        public NativeDeathText read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_TEXT_LENGTH * 8 + 32 || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native death text");
+            }
+            final var text = new NativeDeathText(Types.UUID.read(buffer), TEXT.read(buffer), TEXT.read(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native death text data");
+            }
+            return text;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeDeathText text) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.UUID.write(buffer, text.lifetime);
+            TEXT.write(buffer, text.source);
+            TEXT.write(buffer, text.projected);
+        }
+    };
+
+    public NativeDeathText {
+        Objects.requireNonNull(lifetime);
+        if (!canEncode(source, projected)) {
+            throw new IllegalArgumentException("Native death text exceeds limits");
+        }
+    }
+
+    public static boolean canEncode(final String source, final String projected) {
+        return source != null && projected != null && source.length() <= MAX_TEXT_LENGTH && projected.length() <= MAX_TEXT_LENGTH;
+    }
+
+}
