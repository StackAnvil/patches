     public ResourcePackStorage(final List<ResourcePack> resourcePacksTopToBottom) {
+        this(resourcePacksTopToBottom, List.of());
+    }
+
+    public ResourcePackStorage(final List<ResourcePack> resourcePacksTopToBottom, final List<ResourcePack> builtinImagesBottomToTop) {
+        for (ResourcePack builtinImages : builtinImagesBottomToTop) {
+            for (String path : builtinImages.content().getFilesDeep("", "")) {
+                if (!path.equals("manifest.json") && !(path.startsWith("textures/")
+                        && (path.endsWith(".png") || path.endsWith(".jpg") || path.endsWith(".tga")))) {
+                    throw new IllegalArgumentException("Built-in image pack contains a non-image resource: " + path);
+                }
+            }
+            this.packStackBottomToTop.add(builtinImages);
+        }
         final List<ResourcePack> orderedPacks = ResourcePackStack.orderTopToBottom(resourcePacksTopToBottom);
         this.serverPacks.addAll(orderedPacks);
         if (BedrockProtocol.MAPPINGS.getBedrockVanillaResourcePacks() != null) { // null if ran from ResourcePackConverterTest
@@ -68,6 +81,10 @@ public class ResourcePackStorage implements StorableObject {
             }
         }
 
+        for (int i = builtinImagesBottomToTop.size() - 1; i >= 0; i--) {
+            this.packStackTopToBottom.add(builtinImagesBottomToTop.get(i));
+        }
+
         this.texts = new TextDefinitions(this);
         this.blocks = new BlockDefinitions(this);
         this.items = new ItemDefinitions(this);
