+package net.raphimc.viabedrock.api.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.StringJoiner;
+
+/** The cumulative vanilla resource cutoff advertised by a world, independent of server packs. */
+public record BaseGameVersion(int major, int minor, int patch) implements Comparable<BaseGameVersion> {
+
+    public static final BaseGameVersion CURRENT = parse(ProtocolConstants.BEDROCK_VERSION_NAME);
+    private static final BaseGameVersion ORIGINAL = new BaseGameVersion(1, 13, 0);
+
+    public BaseGameVersion {
+        if (major < 0 || minor < 0 || patch < 0) {
+            throw new IllegalArgumentException("Negative base game version");
+        }
+    }
+
+    public static BaseGameVersion parse(final String value) {
+        if ("*".equals(value)) {
+            return CURRENT;
+        }
+        if (value == null || value.length() > 64) {
+            throw new IllegalArgumentException("Invalid base game version");
+        }
+        final String[] parts = value.split("\\.", -1);
+        if (parts.length < 2 || parts.length > 4) {
+            throw new IllegalArgumentException("Invalid base game version: " + value);
+        }
+        final int[] numbers = new int[4];
+        for (int i = 0; i < parts.length; i++) {
+            if (!parts[i].matches("[0-9]+")) {
+                throw new IllegalArgumentException("Invalid base game version: " + value);
+            }
+            numbers[i] = Integer.parseInt(parts[i]);
+        }
+        return new BaseGameVersion(numbers[0], numbers[1], numbers[2]);
+    }
+
+    public static BaseGameVersion vanillaLayer(final String name) {
+        if (name.equals("vanilla") || name.equals("vanilla_base")) {
+            return ORIGINAL;
+        }
+        if (!name.startsWith("vanilla_")) {
+            throw new IllegalArgumentException("Invalid vanilla resource layer: " + name);
+        }
+        return parse(name.substring("vanilla_".length()));
+    }
+
+    public boolean includes(final ResourcePack pack) {
+        final String manifest = pack.content().contains("manifest.json") ? "manifest.json" : "pack_manifest.json";
+        final var header = pack.content().getJson(manifest).getAsJsonObject("header");
+        final JsonElement minimum = header.get("min_engine_version");
+        if (minimum == null) {
+            return true;
+        }
+        final String version;
+        if (minimum.isJsonArray()) {
+            final var parts = minimum.getAsJsonArray();
+            if (parts.size() < 2 || parts.size() > 4) {
+                throw new IllegalArgumentException("Invalid vanilla resource version");
+            }
+            final StringJoiner components = new StringJoiner(".");
+            for (final JsonElement part : parts) {
+                components.add(part.getAsString());
+            }
+            version = components.toString();
+        } else {
+            version = minimum.getAsString();
+        }
+        return parse(version).compareTo(this) <= 0;
+    }
+
+    @Override
+    public int compareTo(final BaseGameVersion other) {
+        int order = Integer.compare(this.major, other.major);
+        if (order == 0) {
+            order = Integer.compare(this.minor, other.minor);
+        }
+        return order != 0 ? order : Integer.compare(this.patch, other.patch);
+    }
+
+    @Override
+    public String toString() {
+        return this.major + "." + this.minor + "." + this.patch;
+    }
+
+}
