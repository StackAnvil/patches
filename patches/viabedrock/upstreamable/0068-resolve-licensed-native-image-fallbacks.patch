+            files.put("library/" + layer + "/textures/items/test.png", image(0xFF112200 | files.size()));
+        }
+        final var packs = BundledImagePacks.read(new ByteArrayInputStream(bundle(files,
+                List.of("vanilla", "vanilla_base", "vanilla_1.21.20", "vanilla_1.21.100"), _ -> { })), "1.26.51");
+        assertEquals(4, packs.size());
+        for (int index = 0; index < packs.size(); index++) {
+            assertEquals(0xFF112200 | index, packs.get(index).content().getShortnameImage("textures/items/test").getImage().getRGB(0, 0));
+        }
