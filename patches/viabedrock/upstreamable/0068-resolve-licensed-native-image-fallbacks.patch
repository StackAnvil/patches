+/** Supplies licensed native images missing from the bundled metadata packs. */
+public class BuiltinResourcePackProvider implements Provider {
+
+    /**
+     * Called on the resource pack executor, where acquisition may block.
+     * Return image-only packs (plus manifests) in bottom-to-top order, or an empty list.
+     * The packs supply lower-priority images and is never advertised to the server.
+     */
+    public List<ResourcePack> load(final UserConnection user) throws Exception {
+        return List.of();
+    }
+
