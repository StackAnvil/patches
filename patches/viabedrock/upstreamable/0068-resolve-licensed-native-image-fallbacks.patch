+    private static byte[] image(final int color) {
+        final var content = new InMemoryContent();
+        final var image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, color);
+        content.putPngImage("image.png", image);
+        return content.get("image.png");
+    }
+
+    private static byte[] bundle(final Map<String, byte[]> files, final List<String> layers,
+                                 final Consumer<JsonObject> mutation) throws Exception {
+        final JsonObject manifest = new JsonObject();
+        manifest.addProperty("format", 1);
+        manifest.addProperty("version", "1.26.51.1");
+        final JsonArray packs = new JsonArray();
+        final JsonArray records = new JsonArray();
+        layers.forEach(packs::add);
+        for (final var file : files.entrySet()) {
+            final JsonObject record = new JsonObject();
+            record.addProperty("path", file.getKey());
+            record.addProperty("sha256", HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(file.getValue())));
+            records.add(record);
+        }
+        manifest.add("packs", packs);
+        manifest.add("files", records);
+        mutation.accept(manifest);
+        final var bytes = new ByteArrayOutputStream();
+        try (var zip = new ZipOutputStream(bytes)) {
+            for (final var file : files.entrySet()) {
+                zip.putNextEntry(new ZipEntry(file.getKey()));
+                zip.write(file.getValue());
+                zip.closeEntry();
+            }
+            zip.putNextEntry(new ZipEntry("manifest.json"));
+            zip.write(manifest.toString().getBytes(StandardCharsets.UTF_8));
+            zip.closeEntry();
+        }
+        return bytes.toByteArray();
+    }
+
