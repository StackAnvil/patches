diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/definition/BiomeDefinitionsTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/definition/BiomeDefinitionsTest.java
new file mode 100644
index 000000000..a059e6fa4
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/definition/BiomeDefinitionsTest.java
@@ -0,0 +1,157 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.BaseGameVersion;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BiomeDefinitionsTest {
+
+    @Test
+    void qualifiedLayersReplaceLegacyMetadataAndResolveThroughEitherSpelling() {
+        final var lower = pack("the_end", "test:old", 0x112233, 0x445566);
+        final var higher = pack("minecraft:the_end", "test:current", 0xAABBCC, 0xDDEEFF);
+        final var definitions = definitions(lower, higher);
+        final var selected = definitions.get("the_end");
+        assertSame(selected, definitions.get("minecraft:the_end"));
+        assertEquals(0xAABBCC, selected.skyColor());
+        assertEquals(0xDDEEFF, selected.waterSurfaceColor());
+        assertEquals("test:current", selected.fog());
+    }
+
+    @Test
+    void legacyServerOverridesRetainPriorityWithoutCollapsingOtherNamespaces() {
+        final var lower = pack("minecraft:the_end", "test:current", 0x112233, 0x445566);
+        final var higher = pack("the_end", "test:server", 0xAABBCC, 0xDDEEFF);
+        final var custom = pack("test:the_end", "test:custom", 0x000000, 0xFFFFFF);
+        final var definitions = definitions(lower, higher, custom);
+        assertSame(definitions.get("the_end"), definitions.get("minecraft:the_end"));
+        assertEquals("test:server", definitions.get("minecraft:the_end").fog());
+        assertEquals("test:custom", definitions.get("test:the_end").fog());
+        assertNotSame(definitions.get("the_end"), definitions.get("test:the_end"));
+    }
+
+    @Test
+    void legacyInheritanceMergesMediaWhileReplacementFallsThroughToDataDefault() {
+        final var lower = legacyPack("""
+                {"default":{"fog_identifier":"test:green","remove_all_prior_fog":true},
+                 "the_end":{"fog_identifier":"test:blue"},
+                 "minecraft:plains":{"fog_identifier":"test:blue"}}
+                """);
+        final var higher = legacyPack("""
+                {"minecraft:the_end":{"fog_identifier":"test:water","inherit_from_prior_fog":true},
+                 "plains":{"fog_identifier":"test:water"}}
+                """);
+        lower.content().putString("fogs/blue.json", fog("test:blue", "air", "#0000FF"));
+        lower.content().putString("fogs/green.json", fog("test:green", "air", "#00FF00"));
+        higher.content().putString("fogs/water.json", fog("test:water", "water", "#00FF00"));
+        final var storage = storage(lower, higher);
+        final var definitions = new BiomeDefinitions(storage);
+        final var fogs = new FogDefinitions(storage);
+        assertEquals(0x0000FF, fogs.resolve(definitions.fogBindings().get("minecraft:the_end")).colors().get("air"));
+        assertEquals(0x00FF00, fogs.resolve(definitions.fogBindings().get("minecraft:the_end")).colors().get("water"));
+        assertFalse(fogs.resolve(definitions.fogBindings().get("minecraft:plains")).colors().containsKey("air"));
+        assertEquals(0x00FF00, fogs.resolve(definitions.defaultFog()).colors().get("air"));
+    }
+
+    @Test
+    void clearingLegacyFogExposesModernBindingWithoutDiscardingModernMetadata() {
+        final var lower = legacyPack("""
+                {"default":{"fog_identifier":"test:default"},"the_end":{"fog_identifier":"test:legacy"}}
+                """);
+        final var modern = pack("minecraft:the_end", "test:modern", 0x112233, 0x445566);
+        assertEquals(List.of("test:legacy"), definitions(lower, modern).fogBindings().get("minecraft:the_end"));
+        final var clear = legacyPack("""
+                {"minecraft:default":{"fog_identifier":"test:biome"},
+                 "default":{"remove_all_prior_fog":true,"fog_identifier":"test:new_default"}}
+                """);
+        final var cleared = definitions(lower, modern, clear);
+        assertEquals(List.of("test:modern"), cleared.fogBindings().get("minecraft:the_end"));
+        assertEquals(0x112233, cleared.get("the_end").skyColor());
+        assertEquals(List.of("test:new_default"), cleared.defaultFog());
+        assertEquals(List.of("test:biome"), cleared.fogBindings().get("minecraft:default"));
+        assertThrows(UnsupportedOperationException.class, () -> cleared.fogBindings().clear());
+        assertThrows(UnsupportedOperationException.class, () -> cleared.defaultFog().add("test:other"));
+    }
+
+    @Test
+    void vanillaLegacyFogStopsAtClientBiomeCutoffWhileServerLegacyFogStillLoads() {
+        final var builtin = legacyPack("{\"the_end\":{\"fog_identifier\":\"test:builtin\"}}");
+        final var storage = storage(builtin);
+        when(storage.isServerPack(builtin)).thenReturn(false);
+        when(storage.getBaseGameVersion()).thenReturn(BaseGameVersion.parse("1.21.39"));
+        assertEquals(List.of("test:builtin"), new BiomeDefinitions(storage).fogBindings().get("minecraft:the_end"));
+        when(storage.getBaseGameVersion()).thenReturn(BaseGameVersion.parse("1.21.40"));
+        assertTrue(new BiomeDefinitions(storage).fogBindings().isEmpty());
+        when(storage.isServerPack(builtin)).thenReturn(true);
+        assertEquals(List.of("test:builtin"), new BiomeDefinitions(storage).fogBindings().get("minecraft:the_end"));
+    }
+
+    private static String fog(final String identifier, final String medium, final String color) {
+        return """
+                {"minecraft:fog_settings":{"description":{"identifier":"%s"},"distance":{"%s":{"fog_color":"%s"}}}}
+                """.formatted(identifier, medium, color);
+    }
+
+    private static ResourcePack legacyPack(final String biomes) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        content.putString("biomes_client.json", "{\"biomes\":" + biomes + "}");
+        return new ResourcePack(content);
+    }
+
+    private static BiomeDefinitions definitions(final ResourcePack... layers) {
+        return new BiomeDefinitions(storage(layers));
+    }
+
+    private static ResourcePackStorage storage(final ResourcePack... layers) {
+        final var storage = mock(ResourcePackStorage.class);
+        when(storage.getPackStackBottomToTop()).thenReturn(List.of(layers));
+        when(storage.getBaseGameVersion()).thenReturn(BaseGameVersion.CURRENT);
+        for (ResourcePack layer : layers) {
+            when(storage.isServerPack(layer)).thenReturn(true);
+        }
+        return storage;
+    }
+
+    private static ResourcePack pack(final String identifier, final String fog, final int sky, final int water) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final JsonObject document = new JsonObject();
+        document.addProperty("format_version", "1.21.120");
+        final JsonObject biome = new JsonObject();
+        final JsonObject description = new JsonObject();
+        final JsonObject components = new JsonObject();
+        description.addProperty("identifier", identifier);
+        biome.add("description", description);
+        final JsonObject fogAppearance = new JsonObject();
+        final JsonObject skyColor = new JsonObject();
+        final JsonObject waterAppearance = new JsonObject();
+        fogAppearance.addProperty("fog_identifier", fog);
+        skyColor.addProperty("sky_color", "#%06X".formatted(sky));
+        waterAppearance.addProperty("surface_color", "#%06X".formatted(water));
+        components.add("minecraft:fog_appearance", fogAppearance);
+        components.add("minecraft:sky_color", skyColor);
+        components.add("minecraft:water_appearance", waterAppearance);
+        biome.add("components", components);
+        document.add("minecraft:client_biome", biome);
+        content.putJson("biomes/the_end.client_biome.json", document);
+        return new ResourcePack(content);
+    }
+
+}
