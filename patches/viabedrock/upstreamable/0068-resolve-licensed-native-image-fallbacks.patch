+package net.raphimc.viabedrock.protocol.provider;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.platform.providers.Provider;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+
+import java.util.List;
+
+/** Supplies licensed native images and actor resources missing from the bundled metadata packs. */
+public class BuiltinResourcePackProvider implements Provider {
+
+    /**
+     * Called on the resource pack executor, where acquisition may block.
+     * Return image and actor resource packs (plus manifests) in bottom-to-top order, or an empty list.
+     * The packs supply lower-priority resources and are never advertised to the server.
+     */
+    public List<ResourcePack> load(final UserConnection user) throws Exception {
+        return BundledImagePacks.load();
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/provider/BundledImagePacks.java b/src/main/java/net/raphimc/viabedrock/protocol/provider/BundledImagePacks.java
new file mode 100644
index 000000000..bd18f82ce
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/provider/BundledImagePacks.java
@@ -0,0 +1,169 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.provider;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.zip.ZipInputStream;
+
+/** Optional versioned images retain native paths and lower-priority overlay order. */
+final class BundledImagePacks {
+
+    private static List<ResourcePack> bundled;
+
+    private BundledImagePacks() {
+    }
+
+    static synchronized List<ResourcePack> load() throws IOException {
+        if (bundled == null) {
+            try (InputStream input = BundledImagePacks.class.getResourceAsStream("/assets/viabedrock/builtin_images.zip")) {
+                bundled = input == null ? List.of() : read(input, ProtocolConstants.BEDROCK_VERSION_NAME);
+            }
+        }
+        return bundled;
+    }
+
+    static List<ResourcePack> read(final InputStream input, final String protocolVersion) throws IOException {
+        try {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            long total = 0;
+            try (var zip = new ZipInputStream(input)) {
+                for (var entry = zip.getNextEntry(); entry != null; entry = zip.getNextEntry()) {
+                    final String path = entry.getName();
+                    if (entry.isDirectory() || files.size() >= 32769 || !safePath(path)) {
+                        throw new IOException("Invalid bundled image entry");
+                    }
+                    final byte[] bytes = zip.readNBytes(32 * 1024 * 1024 + 1);
+                    total += bytes.length;
+                    if (bytes.length == 0 || bytes.length > 32 * 1024 * 1024 || total > 256L * 1024 * 1024
+                            || files.putIfAbsent(path, bytes) != null) {
+                        throw new IOException("Invalid bundled image size or duplicate entry");
+                    }
+                }
+            }
+            final byte[] metadata = files.remove("manifest.json");
+            if (metadata == null) {
+                throw new IOException("Missing bundled image manifest");
+            }
+            final JsonObject manifest = JsonParser.parseString(new String(metadata, StandardCharsets.UTF_8)).getAsJsonObject();
+            final String version = manifest.get("version").getAsString();
+            if (manifest.get("format").getAsInt() != 1 || !version.matches("[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+")
+                    || !version.startsWith(protocolVersion + '.')) {
+                throw new IOException("Bundled images do not match the target version");
+            }
+            final Map<String, InMemoryContent> packs = new LinkedHashMap<>();
+            String previous = null;
+            for (final var value : manifest.getAsJsonArray("packs")) {
+                final String name = value.getAsString();
+                if (!name.matches("vanilla(?:_base|_[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)?")
+                        || previous != null && compare(previous, name) >= 0 || compare(name, "vanilla_" + protocolVersion) > 0
+                        || packs.putIfAbsent(name, new InMemoryContent()) != null) {
+                    throw new IOException("Invalid bundled image overlay order");
+                }
+                previous = name;
+            }
+            if (packs.isEmpty() || packs.size() > 256) {
+                throw new IOException("Invalid bundled image layers");
+            }
+            for (final var value : manifest.getAsJsonArray("files")) {
+                final var record = value.getAsJsonObject();
+                final String path = record.get("path").getAsString();
+                final byte[] bytes = files.remove(path);
+                if (bytes == null || !hash(bytes).equals(record.get("sha256").getAsString()) || !path.startsWith("library/")) {
+                    throw new IOException("Bundled image identity mismatch");
+                }
+                final int separator = path.indexOf('/', "library/".length());
+                if (separator < 0) {
+                    throw new IOException("Invalid bundled image layer path");
+                }
+                final var pack = packs.get(path.substring("library/".length(), separator));
+                final String resource = path.substring(separator + 1);
+                if (pack == null || !resource.startsWith("textures/") || !(resource.endsWith(".png") || resource.endsWith(".jpg")
+                        || resource.endsWith(".tga") || resource.equals("textures/item_texture.json") || resource.equals("textures/terrain_texture.json"))) {
+                    throw new IOException("Unsupported bundled image resource");
+                }
+                pack.put(resource, bytes);
+            }
+            if (!files.isEmpty()) {
+                throw new IOException("Unindexed bundled images");
+            }
+            final List<ResourcePack> result = new ArrayList<>();
+            for (final var entry : packs.entrySet()) {
+                if (entry.getValue().size() == 0) {
+                    throw new IOException("Empty bundled image layer");
+                }
+                final JsonObject pack = new JsonObject();
+                final JsonObject header = new JsonObject();
+                pack.addProperty("format_version", 2);
+                header.addProperty("name", "Licensed native images: " + entry.getKey());
+                header.addProperty("uuid", UUID.nameUUIDFromBytes(("viabedrock/builtin-images/" + version + '/' + entry.getKey())
+                        .getBytes(StandardCharsets.UTF_8)).toString());
+                final JsonArray revision = new JsonArray();
+                revision.add(1);
+                revision.add(0);
+                revision.add(0);
+                header.add("version", revision);
+                pack.add("header", header);
+                entry.getValue().putJson("manifest.json", pack);
+                result.add(new ResourcePack(entry.getValue()));
+            }
+            return List.copyOf(result);
+        } catch (final RuntimeException invalid) {
+            throw new IOException("Invalid bundled image manifest", invalid);
+        }
+    }
+
+    private static int compare(final String left, final String right) {
+        final int leftRank = left.equals("vanilla") ? 0 : left.equals("vanilla_base") ? 1 : 2;
+        final int rightRank = right.equals("vanilla") ? 0 : right.equals("vanilla_base") ? 1 : 2;
+        if (leftRank != rightRank) {
+            return Integer.compare(leftRank, rightRank);
+        }
+        if (leftRank < 2) {
+            return 0;
+        }
+        final String[] a = left.substring(8).split("\\.");
+        final String[] b = right.substring(8).split("\\.");
+        for (int index = 0; index < 3; index++) {
+            final int difference = Integer.compare(index < a.length ? Integer.parseInt(a[index]) : 0,
+                    index < b.length ? Integer.parseInt(b[index]) : 0);
+            if (difference != 0) {
+                return difference;
+            }
+        }
+        return 0;
+    }
+
+    private static boolean safePath(final String path) {
+        return !path.isEmpty() && !path.startsWith("/") && !path.contains("\\") && !path.contains(":") && !path.contains("\0")
+                && java.util.Arrays.stream(path.split("/", -1)).noneMatch(part -> part.isEmpty() || part.equals(".") || part.equals(".."));
+    }
+
+    private static String hash(final byte[] bytes) {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+        } catch (final NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+}
