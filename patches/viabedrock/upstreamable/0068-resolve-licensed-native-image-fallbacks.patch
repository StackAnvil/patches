+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BuiltinActorResourcesTest {
+
+    @Test
+    void resolvesBundledEquipmentBelowServerOverrides() {
+        final ResourcePack builtin = pack(1, "geometry.builtin");
+        builtin.content().putString("materials/native.material", "{\"materials\":{}}");
+        final ResourcePack server = pack(2, "geometry.server");
+        final ResourcePackStorage baseline = new ResourcePackStorage(List.of(), List.of(builtin));
+        assertEquals("geometry.builtin", baseline.getAttachables().attachables().get("minecraft:shield")
+                .attachableData().getGeometries().get("default"));
+        final ResourcePackStorage overridden = new ResourcePackStorage(List.of(server), List.of(builtin));
+        assertEquals("geometry.server", overridden.getAttachables().attachables().get("minecraft:shield")
+                .attachableData().getGeometries().get("default"));
+        assertFalse(overridden.isServerPack(builtin));
+        assertTrue(overridden.isServerPack(server));
+    }
+
+    @Test
+    void rejectsUnrelatedDefinitionsFromBuiltinProviders() {
+        final ResourcePack builtin = pack(1, "geometry.builtin");
+        builtin.content().putString("blocks.json", "{}");
+        assertThrows(IllegalArgumentException.class, () -> new ResourcePackStorage(List.of(), List.of(builtin)));
+    }
+
+    private static ResourcePack pack(final int identity, final String geometry) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\","
+                + "\"uuid\":\"00000000-0000-0000-0000-" + String.format("%012d", identity) + "\",\"version\":[1,0,0]}}");
+        content.putString("attachables/shield.json", "{\"format_version\":\"1.10.0\",\"minecraft:attachable\":{\"description\":{"
+                + "\"identifier\":\"minecraft:shield\",\"materials\":{\"default\":\"entity_alphatest\"},"
+                + "\"textures\":{\"default\":\"textures/shield\"},\"geometry\":{\"default\":\"" + geometry + "\"},"
+                + "\"render_controllers\":[\"controller.render.shield\"]}}}");
+        return new ResourcePack(content);
+    }
+
+}
