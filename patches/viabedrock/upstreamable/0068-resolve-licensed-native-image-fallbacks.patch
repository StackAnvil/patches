+    @Test
+    void rejectsCorruptUnindexedWrongVersionAndReorderedBundles() throws Exception {
+        final var files = Map.of("library/vanilla/textures/items/test.png", image(0xFF123456));
+        for (final Consumer<JsonObject> mutation : List.<Consumer<JsonObject>>of(
+                m -> m.addProperty("version", "1.26.60.1"),
+                m -> m.getAsJsonArray("files").get(0).getAsJsonObject().addProperty("sha256", "wrong"),
+                m -> m.add("files", new JsonArray()),
+                m -> {
+                    final JsonArray packs = new JsonArray();
+                    packs.add("vanilla_1.16.100");
+                    packs.add("vanilla_1.16");
+                    m.add("packs", packs);
+                })) {
+            assertThrows(IOException.class, () -> BundledImagePacks.read(new ByteArrayInputStream(bundle(files, List.of("vanilla"), mutation)), "1.26.51"));
+        }
+        assertThrows(IOException.class, () -> BundledImagePacks.read(new ByteArrayInputStream(bundle(
+                Map.of("library/vanilla/models/actor.json", new byte[]{1}), List.of("vanilla"), _ -> { })), "1.26.51"));
