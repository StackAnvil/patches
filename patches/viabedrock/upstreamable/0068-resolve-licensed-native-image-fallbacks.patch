+    private void loadLegacyFog(final ResourcePack pack, final Map<String, List<String>> bindings) {
+        try {
+            final JsonObject biomes = pack.content().getJson("biomes_client.json").getAsJsonObject("biomes");
+            final JsonObject defaults = biomes.getAsJsonObject("default");
+            if (defaults != null && defaults.has("remove_all_prior_fog") && defaults.get("remove_all_prior_fog").getAsBoolean()) {
+                bindings.clear();
+            }
+            for (Map.Entry<String, JsonElement> entry : biomes.entrySet()) {
+                final JsonObject biome = entry.getValue().getAsJsonObject();
+                if (!biome.has("fog_identifier")) {
+                    continue;
+                }
+                final String name = entry.getKey().equals("default") ? "default" : Key.namespaced(entry.getKey());
+                final List<String> fog = new ArrayList<>();
+                if (biome.has("inherit_from_prior_fog") && biome.get("inherit_from_prior_fog").getAsBoolean()) {
+                    fog.addAll(bindings.getOrDefault(name, List.of()));
+                }
+                fog.add(Key.namespaced(biome.get("fog_identifier").getAsString()));
+                bindings.put(name, List.copyOf(fog));
+            }
+        } catch (final Throwable e) {
+            ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to parse legacy biome fog in pack " + pack.key(), e);
+        }
+    }
