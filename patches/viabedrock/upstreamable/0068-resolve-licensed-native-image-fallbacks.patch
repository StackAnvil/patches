+    @Test
+    void resolvesCaseSensitiveVanillaItemAliasesFromBuiltInImages() {
+        final ResourcePack server = itemAtlas("textures/items/nativeBottle");
+        final ResourcePack builtin = imagePack("textures/items/nativeBottle.png", 0xFF123456);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(server), List.of(builtin));
+        final Content result = convert(storage, new CustomItemTextureResourceRewriter());
+        final JsonObject model = result.getJson("assets/viabedrock/models/item_textures/example/icon/0.json");
+        final String texture = model.getAsJsonObject("textures").get("layer0").getAsString();
+        final BufferedImage image = result.getImage("assets/viabedrock/textures/" + texture.substring("viabedrock:".length()) + ".png").getImage();
+        assertEquals(0xFF123456, image.getRGB(0, 0));
+        assertTrue(storage.isServerPack(server));
+        assertFalse(storage.isServerPack(builtin));
+        assertEquals(List.of(server, builtin), List.copyOf(storage.getPackStackTopToBottom()));
+    }
+
+    @Test
+    void serverImagesOverrideLicensedBaselineWithoutReplacingAtlasAliases() {
+        final ResourcePack server = itemAtlas("textures/items/nativeBottle");
+        server.content().put("textures/items/nativeBottle.png", imagePack("textures/items/nativeBottle.png", 0xFFABCDEF).content().get("textures/items/nativeBottle.png"));
+        final ResourcePack builtin = imagePack("textures/items/nativeBottle.png", 0xFF123456);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(server), List.of(builtin));
+        final Content result = convert(storage, new CustomItemTextureResourceRewriter());
+        final JsonObject model = result.getJson("assets/viabedrock/models/item_textures/example/icon/0.json");
+        final String texture = model.getAsJsonObject("textures").get("layer0").getAsString();
+        assertEquals(0xFFABCDEF, result.getImage("assets/viabedrock/textures/" + texture.substring("viabedrock:".length()) + ".png").getImage().getRGB(0, 0));
+    }
+
+    @Test
+    void higherNativeOverlayUsesItsTgaBeforeLowerPngImages() {
+        final ResourcePack server = itemAtlas("textures/items/nativeBottle");
+        final ResourcePack lower = imagePack("textures/items/nativeBottle.png", 0xFF123456);
+        final InMemoryContent overlayContent = new InMemoryContent();
+        overlayContent.put("manifest.json", imagePack("textures/unused.png", 0).content().get("manifest.json"));
+        final byte[] tga = new byte[22];
+        tga[2] = 2;
+        tga[12] = 1;
+        tga[14] = 1;
+        tga[16] = 32;
+        tga[17] = 0x28;
+        tga[18] = (byte) 0xEF;
+        tga[19] = (byte) 0xCD;
+        tga[20] = (byte) 0xAB;
+        tga[21] = (byte) 0xFF;
+        overlayContent.put("textures/items/nativeBottle.tga", tga);
+        final ResourcePack higher = new ResourcePack(overlayContent);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(server), List.of(lower, higher));
+        final Content result = convert(storage, new CustomItemTextureResourceRewriter());
+        final JsonObject model = result.getJson("assets/viabedrock/models/item_textures/example/icon/0.json");
+        final String texture = model.getAsJsonObject("textures").get("layer0").getAsString();
+        assertEquals(0xFFABCDEF, result.getImage("assets/viabedrock/textures/" + texture.substring("viabedrock:".length()) + ".png").getImage().getRGB(0, 0));
+        assertEquals(List.of(server, higher, lower), List.copyOf(storage.getPackStackTopToBottom()));
+    }
+
+    @Test
+    void rejectsMetadataInTheImageBaseline() {
+        final ResourcePack builtin = itemAtlas("textures/items/nativeBottle");
+        assertThrows(IllegalArgumentException.class, () -> new ResourcePackStorage(List.of(), List.of(builtin)));
+    }
+
+    private static ResourcePack itemAtlas(final String path) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/item_texture.json", "{\"texture_data\":{\"example:icon\":{\"textures\":\"" + path + "\"}}}");
+        return new ResourcePack(content);
+    }
+
+    private static ResourcePack imagePack(final String path, final int pixel) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        final BufferedImage image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, pixel);
+        content.putPngImage(path, image);
+        return new ResourcePack(content);
+    }
+
     private static Content convert(final ResourcePackStorage storage, final ResourcePackRewriter.Rewriter rewriter) {
         final Content result = new InMemoryContent();
         rewriter.submitTasks(storage, task -> result.putAll(task.get()));
