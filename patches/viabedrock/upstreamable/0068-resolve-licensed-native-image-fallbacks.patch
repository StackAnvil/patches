+import static org.junit.jupiter.api.Assertions.*;
+
+class BaseGameVersionTest {
+
+    @Test
+    void normalizesWildcardAndNativeVersionFormsWithoutLexicalOrdering() {
+        assertEquals(BaseGameVersion.CURRENT, BaseGameVersion.parse("*"));
+        assertEquals(new BaseGameVersion(1, 20, 0), BaseGameVersion.parse("1.20"));
+        assertEquals(new BaseGameVersion(1, 26, 60), BaseGameVersion.parse("1.26.60.6"));
+        assertTrue(BaseGameVersion.parse("1.20.100").compareTo(BaseGameVersion.parse("1.20.90")) > 0);
+        assertEquals(BaseGameVersion.parse("1.13"), BaseGameVersion.vanillaLayer("vanilla_base"));
+    }
+
+    @Test
+    void rejectsMalformedOrOverflowingCutoffs() {
+        for (final String invalid : List.of("", "*.*", "1", "1..20", "1.-20.0", "1.+20.0", "1.20.0.0.1", "1.2147483648.0")) {
+            assertThrows(IllegalArgumentException.class, () -> BaseGameVersion.parse(invalid));
+        }
+    }
+
+    @Test
+    void switchesWorldCutoffsWithoutMutatingRawLayersOrFilteringServerPacks() {
+        final var original = pack(new BaseGameVersion(1, 13, 0));
+        final var earlier = pack(new BaseGameVersion(1, 20, 0));
+        final var later = pack(new BaseGameVersion(1, 26, 60));
+        final var server = pack(new BaseGameVersion(1, 26, 60));
+        final var raw = List.of(original, earlier, later);
+        final var latest = new ResourcePackStorage(List.of(server), raw, BaseGameVersion.CURRENT);
+        final var older = new ResourcePackStorage(List.of(server), raw, BaseGameVersion.parse("1.20.0"));
+        assertTrue(latest.getPackStackBottomToTop().containsAll(raw));
+        assertTrue(older.getPackStackBottomToTop().containsAll(List.of(original, earlier, server)));
+        assertFalse(older.getPackStackBottomToTop().contains(later));
+        assertSame(server, older.getPackStackBottomToTop().stream().toList().getLast());
+        assertTrue(older.isServerPack(server));
+        assertFalse(older.isServerPack(earlier));
+        assertTrue(new ResourcePackStorage(List.of(server), raw, BaseGameVersion.CURRENT).getPackStackBottomToTop().contains(later));
+        assertEquals(3, raw.size());
+    }
+
+    @Test
+    void carriesTheWorldCutoffThroughTheProxyArchiveAndNativeStorage() throws Exception {
+        final var version = BaseGameVersion.parse("1.20.0");
+        final var source = List.of(pack(version));
+        final var archive = NativeActorLibrary.decode(new ByteArrayInputStream(NativeActorLibrary.encode(version, source, _ -> true)));
+        assertEquals(version, archive.version());
+        final var storage = ResourcePackStorage.nativeActors(archive.layers(), archive.version());
+        assertEquals(version, storage.getBaseGameVersion());
+        assertTrue(storage.isServerPack(storage.getPackStackTopToBottom().iterator().next()));
+    }
+
+    private static ResourcePack pack(final BaseGameVersion minimum) {
+        final var content = new InMemoryContent();
+        final var manifest = new JsonObject();
+        final var header = new JsonObject();
+        header.addProperty("name", "World resource fixture");
+        header.addProperty("uuid", UUID.randomUUID().toString());
+        final var revision = new JsonArray();
+        revision.add(1);
+        revision.add(0);
+        revision.add(0);
+        header.add("version", revision);
+        final var engine = new JsonArray();
+        engine.add(minimum.major());
+        engine.add(minimum.minor());
+        engine.add(minimum.patch());
+        header.add("min_engine_version", engine);
+        manifest.addProperty("format_version", 2);
+        manifest.add("header", header);
+        content.putJson("manifest.json", manifest);
+        return new ResourcePack(content);
+    }
+
+}
