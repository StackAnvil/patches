+            assertThrows(IOException.class, () -> BundledImagePacks.read(new ByteArrayInputStream(bundle(files, List.of("vanilla"), mutation)), "1.26.51"));
+        }
+        assertThrows(IOException.class, () -> BundledImagePacks.read(new ByteArrayInputStream(bundle(
