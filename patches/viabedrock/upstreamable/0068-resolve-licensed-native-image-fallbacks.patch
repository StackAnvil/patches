+    @Test
+    void licensedBaselinePixelsParticipateInTheConvertedCacheIdentity() {
+        final UUID id = UUID.randomUUID();
+        final ResourcePack original = imagePack(id, 0xFF123456);
+        final ResourcePack changed = imagePack(id, 0xFFABCDEF);
+        final ResourcePack same = imagePack(id, 0xFF123456);
+        final ResourcePackStorage first = new ResourcePackStorage(List.of(), List.of(original));
+        assertEquals(ConvertedResourcePackCache.fingerprint(first), ConvertedResourcePackCache.fingerprint(new ResourcePackStorage(List.of(), List.of(same))));
+        assertNotEquals(ConvertedResourcePackCache.fingerprint(first), ConvertedResourcePackCache.fingerprint(new ResourcePackStorage(List.of(), List.of(changed))));
+        assertNotEquals(ConvertedResourcePackCache.fingerprint(first), ConvertedResourcePackCache.fingerprint(new ResourcePackStorage(List.of())));
+    }
+
+    private static ResourcePack imagePack(final UUID id, final int pixel) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + id + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        final var image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, pixel);
+        content.putPngImage("textures/items/native.png", image);
+        return new ResourcePack(content);
+    }
