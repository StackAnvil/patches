+    @Test
+    void suppliesRealBundledItemImagesThroughTheDefaultProvider() throws Exception {
+        assumeTrue(BundledImagePacks.class.getResource("/assets/viabedrock/builtin_images.zip") != null);
+        final var layers = new BuiltinResourcePackProvider().load(null);
+        final var server = new InMemoryContent();
+        server.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"fixture\"}}");
+        server.put("textures/probe.png", image(0xFFFF0000));
+        server.putString("models/entity/probe.json", "{\"format_version\":\"1.12.0\",\"minecraft:geometry\":[{\"description\":{\"identifier\":\"geometry.probe\",\"texture_width\":16,\"texture_height\":16},\"bones\":[{\"name\":\"root\",\"pivot\":[4,20,12],\"cubes\":[{\"origin\":[4,20,12],\"size\":[3,3,3],\"uv\":[0,0]}]}]}]}");
+        for (final String icon : List.of("stick", "blaze_rod", "bone", "feather", "paper")) {
+            server.putString("attachables/" + icon + ".json", "{\"format_version\":\"1.10.0\",\"minecraft:attachable\":{\"description\":{\"identifier\":\"minecraft:" + icon
+                    + "\",\"geometry\":{\"default\":\"geometry.probe\"},\"textures\":{\"default\":\"textures/probe\"}}}}");
+        }
+        final var storage = new ResourcePackStorage(List.of(new ResourcePack(server)), layers);
+        final var output = new InMemoryContent();
+        new CustomAttachableResourceRewriter()
+                .submitTasks(storage, task -> output.putAll(task.get()));
+        new CustomItemTextureResourceRewriter()
+                .submitTasks(storage, task -> output.putAll(task.get()));
+        for (final String icon : List.of("stick", "blaze_rod", "bone", "feather", "paper")) {
+            final String path = storage.getTextures().itemTextures().get(icon).getFirst().texturePath();
+            assertTrue(storage.getPackStackTopToBottom().stream().anyMatch(pack -> pack.content().getShortnameImage(path) != null));
+            final var selection = output.getJson("assets/viabedrock/items/attachables/minecraft/" + icon + ".json").getAsJsonObject("model");
+            assertEquals("minecraft:display_context", selection.get("property").getAsString());
+            assertFalse(selection.getAsJsonObject("fallback").getAsJsonArray("cases").isEmpty());
+            final String model = selection.getAsJsonArray("cases").get(0).getAsJsonObject().getAsJsonObject("model").get("model").getAsString();
+            final var converted = output.getJson("assets/viabedrock/models/" + model.substring("viabedrock:".length()) + ".json");
+            final String texture = converted.getAsJsonObject("textures").get("layer0").getAsString();
+            assertNotNull(output.getImage("assets/viabedrock/textures/" + texture.substring("viabedrock:".length()) + ".png"));
+        }
+    }
