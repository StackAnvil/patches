+    @Test
+    void retainsNativeLayerOrderWhileServerImagesAndAtlasAliasesKeepPriority() throws Exception {
+        final var files = new LinkedHashMap<String, byte[]>();
+        files.put("library/vanilla/textures/items/Test.png", image(0xFFFF0000));
+        files.put("library/vanilla/textures/item_texture.json", "{\"texture_data\":{\"probe\":{\"textures\":\"textures/items/Test\"}}}".getBytes(StandardCharsets.UTF_8));
+        files.put("library/vanilla_1.16/textures/items/Test.png", image(0xFF00FF00));
+        files.put("library/vanilla_1.16.100/textures/items/Test.png", image(0xFF0000FF));
+        final var layers = BundledImagePacks.read(new ByteArrayInputStream(bundle(files, List.of("vanilla", "vanilla_1.16", "vanilla_1.16.100"), _ -> { })), "1.26.51");
+        final var nativeOnly = new ResourcePackStorage(List.of(), layers);
+        assertEquals(0xFF0000FF, nativeOnly.getPackStackTopToBottom().stream().map(pack -> pack.content().getShortnameImage("textures/items/Test")).filter(java.util.Objects::nonNull).findFirst().orElseThrow().getImage().getRGB(0, 0));
+        final var server = new InMemoryContent();
+        server.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        server.put("textures/items/Server.png", image(0xFFFFFF00));
+        server.putString("textures/item_texture.json", "{\"texture_data\":{\"probe\":{\"textures\":\"textures/items/Server\"}}}");
+        final var pack = new ResourcePack(server);
+        final var accepted = new ResourcePackStorage(List.of(pack), layers);
+        assertEquals("textures/items/Server", accepted.getTextures().itemTextures().get("probe").getFirst().texturePath());
+        assertSame(pack, accepted.getPackStackTopToBottom().iterator().next());
+        assertTrue(accepted.isServerPack(pack));
+        layers.forEach(layer -> assertFalse(accepted.isServerPack(layer)));
+        assertThrows(UnsupportedOperationException.class, () -> layers.clear());
+    }
