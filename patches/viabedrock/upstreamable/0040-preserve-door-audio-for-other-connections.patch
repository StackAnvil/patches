From f45c78eaff1fff5cd95a50d2e229e28f29a99280 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:59:19 +0200
Subject: [PATCH] test(sound): preserve door audio for other connections

A local door interaction must suppress only the echo on that player's
connection. Keep a second connection's identical door event audible so
future sound filtering cannot accidentally become global.
---
 .../BlockInteractionSoundTrackerTest.java        | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
index 77d5df1b..51f851b0 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
@@ -25,6 +25,22 @@ class BlockInteractionSoundTrackerTest {
         assertFalse(tracker.consumeLocallyPlayed("door.open", new Position3f(10.5F, 64.5F, 20.5F)));
     }
 
+    @Test
+    void anotherConnectionStillReceivesTheDoorSound() {
+        final BlockInteractionSoundTracker opener = new BlockInteractionSoundTracker();
+        final BlockInteractionSoundTracker otherPlayer = new BlockInteractionSoundTracker();
+        final BlockPosition door = new BlockPosition(10, 64, 20);
+        final Position3f soundPosition = new Position3f(10.5F, 64.5F, 20.5F);
+        opener.recordInteraction(door, new BlockState("oak_door", Map.of("open", "false", "half", "lower")));
+
+        assertFalse(otherPlayer.consumeLocallyPlayed("door.open", soundPosition));
+        assertTrue(opener.consumeLocallyPlayed("door.open", soundPosition));
+
+        opener.recordInteraction(door, new BlockState("oak_door", Map.of("open", "true", "half", "lower")));
+        assertFalse(otherPlayer.consumeLocallyPlayed("door.close", soundPosition));
+        assertTrue(opener.consumeLocallyPlayed("door.close", soundPosition));
+    }
+
     @Test
     void matchesUpperHalfInteractionToLowerDoorSound() {
         final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
-- 
