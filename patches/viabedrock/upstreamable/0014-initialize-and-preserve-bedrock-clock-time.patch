+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WorldPacketsTest {
+
+    @Test
+    void writesCompleteLegacyTimeWithTheDaylightRuleRate() throws Exception {
+        final WorldClockTracker tracker = new WorldClockTracker();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> {
+                    if (method.getName().equals("get") && args[0] == WorldClockTracker.class) {
+                        return tracker;
+                    }
+                    throw new UnsupportedOperationException(method.getName());
+                });
+        final PacketWrapper wrapper = new PacketWrapperImpl(ClientboundPackets26_3.SET_TIME, null, user);
+        WorldPackets.writeLegacyTime(wrapper, WorldPackets.javaGameTime(100L, 20), 48_001L, true);
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.SET_TIME.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(120L, Types.LONG.read(buffer));
+            assertEquals(1, Types.VAR_INT.read(buffer));
+            assertEquals(0, Types.VAR_INT.read(buffer));
+            assertEquals(48_001L, Types.VAR_LONG.read(buffer));
+            assertEquals(0F, Types.FLOAT.read(buffer));
+            assertEquals(1F, Types.FLOAT.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void writesMultipleClockUpdatesWithTheirOwnRates() throws Exception {
+        final PacketWrapper wrapper = new PacketWrapperImpl(ClientboundPackets26_3.SET_TIME, null, null);
+        WorldPackets.writeJavaTime(wrapper, 120L, List.of(
+                new WorldPackets.JavaClockUpdate(0, 18_000L, false),
+                new WorldPackets.JavaClockUpdate(1, 6_000L, true)));
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.SET_TIME.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(120L, Types.LONG.read(buffer));
+            assertEquals(2, Types.VAR_INT.read(buffer));
+            assertEquals(0, Types.VAR_INT.read(buffer));
+            assertEquals(18_000L, Types.VAR_LONG.read(buffer));
+            assertEquals(0F, Types.FLOAT.read(buffer));
+            assertEquals(0F, Types.FLOAT.read(buffer));
+            assertEquals(1, Types.VAR_INT.read(buffer));
+            assertEquals(6_000L, Types.VAR_LONG.read(buffer));
+            assertEquals(0F, Types.FLOAT.read(buffer));
+            assertEquals(1F, Types.FLOAT.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void resolvesWorldClockIdsFromTheSentRegistryOrder() {
+        final CompoundTag registry = new CompoundTag();
+        registry.put("minecraft:overworld", new CompoundTag());
+        registry.put("minecraft:the_end", new CompoundTag());
+
+        assertEquals(0, WorldPackets.javaWorldClockId(registry, "overworld"));
+        assertEquals(1, WorldPackets.javaWorldClockId(registry, "minecraft:the_end"));
+        assertEquals(-1, WorldPackets.javaWorldClockId(registry, "custom:clock"));
+    }
+
+    @Test
+    void usesLevelTimeWhenDayCycleIsRunningAtJoin() {
+        assertEquals(37_250L, JoinPackets.initialDayTime(-1, 37_250L));
+        assertEquals(6_000L, JoinPackets.initialDayTime(6_000, 37_250L));
+    }
+
+}
