+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class WorldClockTrackerTest {
+
+    @Test
+    void tracksClockIdsAcrossInitializationAndStateUpdates() throws Exception {
+        final WorldClockTracker tracker = new WorldClockTracker();
+        final ByteBuf initialization = Unpooled.buffer();
+        try {
+            BedrockTypes.UNSIGNED_VAR_INT.write(initialization, 1); // initialize registry
+            BedrockTypes.UNSIGNED_VAR_INT.write(initialization, 2); // clocks
+            BedrockTypes.UNSIGNED_VAR_LONG.write(initialization, 42L);
+            BedrockTypes.STRING.write(initialization, "minecraft:overworld");
+            BedrockTypes.VAR_INT.write(initialization, 18_000);
+            Types.BOOLEAN.write(initialization, false);
+            BedrockTypes.UNSIGNED_VAR_INT.write(initialization, 2); // time markers
+            BedrockTypes.UNSIGNED_VAR_LONG.write(initialization, 7L);
+            BedrockTypes.STRING.write(initialization, "midnight");
+            BedrockTypes.VAR_INT.write(initialization, 18_000);
+            Types.BOOLEAN.write(initialization, true);
+            BedrockTypes.INT_LE.write(initialization, 24_000);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(initialization, 8L);
+            BedrockTypes.STRING.write(initialization, "one-shot");
+            BedrockTypes.VAR_INT.write(initialization, 19_000);
+            Types.BOOLEAN.write(initialization, false);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(initialization, 43L);
+            BedrockTypes.STRING.write(initialization, "minecraft:the_end");
+            BedrockTypes.VAR_INT.write(initialization, 6_000);
+            Types.BOOLEAN.write(initialization, true);
+            BedrockTypes.UNSIGNED_VAR_INT.write(initialization, 0); // time markers
+
+            assertEquals(List.of(
+                    new WorldClockTracker.ClockUpdate("minecraft:overworld", 18_000, false),
+                    new WorldClockTracker.ClockUpdate("minecraft:the_end", 6_000, true)),
+                    tracker.readUpdates(new PacketWrapperImpl(ClientboundBedrockPackets.SYNC_WORLD_CLOCKS, initialization, null)));
+            assertEquals(0, initialization.readableBytes());
+        } finally {
+            initialization.release();
+        }
+
+        final ByteBuf sync = Unpooled.buffer();
+        try {
+            BedrockTypes.UNSIGNED_VAR_INT.write(sync, 0); // sync state
+            BedrockTypes.UNSIGNED_VAR_INT.write(sync, 2); // clocks
+            BedrockTypes.UNSIGNED_VAR_LONG.write(sync, 43L);
+            BedrockTypes.VAR_INT.write(sync, 6_100);
+            Types.BOOLEAN.write(sync, true);
+            BedrockTypes.UNSIGNED_VAR_LONG.write(sync, 42L);
+            BedrockTypes.VAR_INT.write(sync, 1_000);
+            Types.BOOLEAN.write(sync, false);
+
+            assertEquals(List.of(
+                    new WorldClockTracker.ClockUpdate("minecraft:the_end", 6_100, true),
+                    new WorldClockTracker.ClockUpdate("minecraft:overworld", 1_000, false)),
+                    tracker.readUpdates(new PacketWrapperImpl(ClientboundBedrockPackets.SYNC_WORLD_CLOCKS, sync, null)));
+            assertEquals(0, sync.readableBytes());
+        } finally {
+            sync.release();
+        }
+    }
+
+}
