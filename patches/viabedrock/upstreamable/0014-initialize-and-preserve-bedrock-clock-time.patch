+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.exception.InformativeException;
+import com.viaversion.viaversion.util.Key;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+public class WorldClockTracker implements StorableObject {
+
+    private static final int SYNC_STATE = 0;
+    private static final int INITIALIZE_REGISTRY = 1;
+    private static final int MAX_CLOCKS = 256;
+
+    private final Map<Long, String> clockNames = new HashMap<>();
+    private LegacyClock legacyOverworld;
+
+    public void setLegacyTime(final long gameTime, final long time, final boolean running) {
+        this.legacyOverworld = new LegacyClock(gameTime, time, running);
+    }
+
+    public Optional<ClockUpdate> updateLegacyDayCycle(final long gameTime, final boolean running) {
+        if (this.legacyOverworld == null || this.legacyOverworld.running() == running) {
+            return Optional.empty();
+        }
+        final long time = this.legacyOverworld.time() + (this.legacyOverworld.running()
+            ? Math.max(0L, gameTime - this.legacyOverworld.gameTime()) : 0L);
+        this.setLegacyTime(gameTime, time, running);
+        return Optional.of(new ClockUpdate("minecraft:overworld", time, !running));
+    }
+
+    public List<ClockUpdate> readUpdates(final PacketWrapper wrapper) throws InformativeException {
+        final int type = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
+        final List<ClockUpdate> updates = new ArrayList<>();
+        if (type == INITIALIZE_REGISTRY) {
+            this.clockNames.clear();
+            final int count = readCount(wrapper);
+            for (int i = 0; i < count; i++) {
+                final long id = wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG);
+                final String name = wrapper.read(BedrockTypes.STRING);
+                final int time = wrapper.read(BedrockTypes.VAR_INT);
+                final boolean paused = wrapper.read(Types.BOOLEAN);
+                this.clockNames.put(id, name);
+                updates.add(new ClockUpdate(name, time, paused));
+
+                final int markerCount = readCount(wrapper);
+                for (int j = 0; j < markerCount; j++) {
+                    wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG); // marker id
+                    wrapper.read(BedrockTypes.STRING); // marker name
+                    wrapper.read(BedrockTypes.VAR_INT); // marker time
+                    if (wrapper.read(Types.BOOLEAN)) { // marker has period
+                        wrapper.read(BedrockTypes.INT_LE); // marker period
+                    }
+                }
+            }
+        } else if (type == SYNC_STATE) {
+            final int count = readCount(wrapper);
+            for (int i = 0; i < count; i++) {
+                final long id = wrapper.read(BedrockTypes.UNSIGNED_VAR_LONG);
+                final int time = wrapper.read(BedrockTypes.VAR_INT);
+                final boolean paused = wrapper.read(Types.BOOLEAN);
+                final String name = this.clockNames.get(id);
+                if (name != null) {
+                    updates.add(new ClockUpdate(name, time, paused));
+                }
+            }
+        }
+        if (updates.stream().anyMatch(update -> Key.namespaced(update.name()).equals("minecraft:overworld"))) {
+            this.legacyOverworld = null;
+        }
+        return updates;
+    }
+
+    private static int readCount(final PacketWrapper wrapper) throws InformativeException {
+        final int count = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
+        if (count > MAX_CLOCKS) {
+            throw new IllegalArgumentException("Too many world clocks or time markers: " + count);
+        }
+        return count;
+    }
+
+    public record ClockUpdate(String name, long time, boolean paused) {
+    }
+
+    private record LegacyClock(long gameTime, long time, boolean running) {
+    }
+
+}
