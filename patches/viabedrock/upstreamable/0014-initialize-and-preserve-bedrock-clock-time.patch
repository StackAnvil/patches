+    static void writeLegacyTime(final PacketWrapper wrapper, final long gameTime, final long bedrockTime, final boolean running) {
+        wrapper.user().get(WorldClockTracker.class).setLegacyTime(gameTime, bedrockTime, running);
+        writeJavaTime(wrapper, gameTime, List.of(new JavaClockUpdate(0, bedrockTime, running)));
+    }
+
+    public static void updateLegacyDayCycle(final UserConnection user, final boolean running) {
+        final long gameTime = currentJavaGameTime(user);
+        user.get(WorldClockTracker.class).updateLegacyDayCycle(gameTime, running).ifPresent(update -> {
+            final PacketWrapper setTime = PacketWrapper.create(ClientboundPackets26_3.SET_TIME, user);
+            writeJavaTime(setTime, gameTime, List.of(new JavaClockUpdate(0, update.time(), !update.paused())));
+            setTime.send(BedrockProtocol.class);
+        });
+    }
+
+    static long currentJavaGameTime(final UserConnection user) {
+        final long levelTime = user.get(GameSessionStorage.class).getLevelTime();
+        final ClientPlayerEntity player = user.get(EntityTracker.class).getClientPlayer();
+        return javaGameTime(levelTime, player != null ? player.age() : 0);
+    }
+
+    static long javaGameTime(final long levelTime, final int clientTicks) {
+        return levelTime + clientTicks;
+    }
+
+    static void writeJavaTime(final PacketWrapper wrapper, final long gameTime, final List<JavaClockUpdate> updates) {
+        wrapper.write(Types.LONG, gameTime); // game time
+        wrapper.write(Types.VAR_INT, updates.size()); // clock update count
+        for (JavaClockUpdate update : updates) {
+            wrapper.write(Types.VAR_INT, update.registryId());
+            wrapper.write(Types.VAR_LONG, update.time());
+            wrapper.write(Types.FLOAT, 0F); // partial tick
+            wrapper.write(Types.FLOAT, update.running() ? 1F : 0F); // rate
+        }
+    }
+
+    static int javaWorldClockId(final CompoundTag registry, final String bedrockName) {
+        final String name = Key.namespaced(bedrockName);
+        int id = 0;
+        for (String entry : registry.keySet()) {
+            if (entry.equals(name)) {
+                return id;
+            }
+            id++;
+        }
+        return -1;
+    }
+
     static long packSectionPosition(final BlockPosition section) {
