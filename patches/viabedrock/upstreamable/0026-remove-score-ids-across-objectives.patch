+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.scoreboard.ScoreboardEntry;
+import net.raphimc.viabedrock.api.model.scoreboard.ScoreboardObjective;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.IdentityDefinition_Type;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ObjectiveSortOrder;
+import net.raphimc.viabedrock.protocol.storage.ScoreboardTracker;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class HudPacketsTest {
+
+    @Test
+    void objectiveLessRemovalClearsOnlyTheScoreIdAcrossObjectives() {
+        final ScoreboardTracker tracker = new ScoreboardTracker();
+        final TrackingObjective first = new TrackingObjective("first");
+        final TrackingObjective second = new TrackingObjective("second");
+        first.put(7, "player");
+        first.put(8, "other");
+        second.put(7, "player");
+        tracker.addObjective("first", first);
+        tracker.addObjective("second", second);
+
+        HudPackets.removeScoreEntries(tracker, null, 7, null);
+
+        assertNull(first.getEntry(7));
+        assertNull(second.getEntry(7));
+        assertNotNull(first.getEntry(8));
+    }
+
+    @Test
+    void namedRemovalLeavesOtherObjectivesIntact() {
+        final ScoreboardTracker tracker = new ScoreboardTracker();
+        final TrackingObjective first = new TrackingObjective("first");
+        final TrackingObjective second = new TrackingObjective("second");
+        first.put(7, "player");
+        second.put(7, "player");
+        tracker.addObjective("first", first);
+        tracker.addObjective("second", second);
+
+        HudPackets.removeScoreEntries(tracker, null, 7, "first");
+
+        assertNull(first.getEntry(7));
+        assertNotNull(second.getEntry(7));
+    }
+
+    private static final class TrackingObjective extends ScoreboardObjective {
+
+        private final Map<Long, ScoreboardEntry> entries = new HashMap<>();
+
+        private TrackingObjective(final String name) {
+            super(name, ObjectiveSortOrder.Descending);
+        }
+
+        private void put(final long id, final String name) {
+            this.entries.put(id, new ScoreboardEntry(1, IdentityDefinition_Type.FakePlayer, null, name));
+        }
+
+        @Override
+        public ScoreboardEntry getEntry(final long scoreboardId) {
+            return this.entries.get(scoreboardId);
+        }
+
+        @Override
+        public void removeEntry(final UserConnection user, final long scoreboardId) {
+            this.entries.remove(scoreboardId);
+        }
+
+    }
+
+}
