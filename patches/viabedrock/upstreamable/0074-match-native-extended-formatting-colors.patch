From d6f17941675917c62bb5003d7b35f8523a069e2a Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 2 Oct 2026 12:27:17 +0200
Subject: [PATCH] fix(text): match native extended formatting colors

Match the protocol 2193 Bedrock 1.26.51.1 formatting table for Minecoin gold and emerald. Native RGBA entries establish #DED605 and #11A036; the dependency table differs in their red channel. Verify the resulting component RGB at the deserialization boundary without changing ordinary color codes.

Support party-blue formatting code w, which the dependency does not recognize. Target Bedrock 1.26.51.1/protocol2193 vanilla UI globals declare party_blue_color as [.549,.702,1], and writer1403f9760 installs it at1517f8420 for lookup140718460. CubeCraft sends w in its Discord NAME and the native reference renders it blue. Convert that verified default to Java #8CB3FF while retaining ordinary styles and connection overrides. Leave resin unchanged until its initializer equivalence is established.
---
 .../raphimc/viabedrock/api/util/TextUtil.java | 37 +++++++++-----
 .../api/util/TextUtilFormattingTest.java      | 51 +++++++++++++++++++
 2 files changed, 74 insertions(+), 14 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/util/TextUtilFormattingTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/util/TextUtil.java b/src/main/java/net/raphimc/viabedrock/api/util/TextUtil.java
index 8698f81c..0843debf 100644
--- a/src/main/java/net/raphimc/viabedrock/api/util/TextUtil.java
+++ b/src/main/java/net/raphimc/viabedrock/api/util/TextUtil.java
@@ -42,21 +42,30 @@ import java.util.function.Function;
 
 public final class TextUtil {
 
-    private static final Function<Character, TextFormatting> BEDROCK_FORMATTING_RESOLVER = c -> Optional.ofNullable(BedrockTextFormatting.getByCode(c)).map(f -> {
-        if (f.isColor()) {
-            return new TextFormatting(f.getRgbValue());
-        } else if (f.equals(BedrockTextFormatting.OBFUSCATED)) {
-            return TextFormatting.OBFUSCATED;
-        } else if (f.equals(BedrockTextFormatting.BOLD)) {
-            return TextFormatting.BOLD;
-        } else if (f.equals(BedrockTextFormatting.ITALIC)) {
-            return TextFormatting.ITALIC;
-        } else if (f.equals(BedrockTextFormatting.RESET)) {
-            return TextFormatting.RESET;
-        } else {
-            throw new IllegalArgumentException("Unhandled BedrockTextFormatting: " + f);
+    private static final Function<Character, TextFormatting> BEDROCK_FORMATTING_RESOLVER = c -> {
+        if (Character.toLowerCase(c) == 'w') {
+            return new TextFormatting(0x8CB3FF);
         }
-    }).orElse(null);
+        return Optional.ofNullable(BedrockTextFormatting.getByCode(c)).map(f -> {
+            if (f.isColor()) {
+                return new TextFormatting(switch (f) {
+                        case MINECOIN_GOLD -> 0xDED605;
+                        case MATERIAL_EMERALD -> 0x11A036;
+                        default -> f.getRgbValue();
+                    });
+            } else if (f.equals(BedrockTextFormatting.OBFUSCATED)) {
+                return TextFormatting.OBFUSCATED;
+            } else if (f.equals(BedrockTextFormatting.BOLD)) {
+                return TextFormatting.BOLD;
+            } else if (f.equals(BedrockTextFormatting.ITALIC)) {
+                return TextFormatting.ITALIC;
+            } else if (f.equals(BedrockTextFormatting.RESET)) {
+                return TextFormatting.RESET;
+            } else {
+                throw new IllegalArgumentException("Unhandled BedrockTextFormatting: " + f);
+            }
+        }).orElse(null);
+    };
 
     public static String stringToJson(final String text) {
         return textComponentToJson(stringToTextComponent(text));
diff --git a/src/test/java/net/raphimc/viabedrock/api/util/TextUtilFormattingTest.java b/src/test/java/net/raphimc/viabedrock/api/util/TextUtilFormattingTest.java
new file mode 100644
index 00000000..4a2c1ab0
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/util/TextUtilFormattingTest.java
@@ -0,0 +1,51 @@
