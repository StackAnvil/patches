+package net.raphimc.viabedrock.api.util;
+
+import com.viaversion.viaversion.libs.mcstructs.text.TextComponent;
+import com.viaversion.viaversion.libs.mcstructs.text.utils.TextUtils;
+import net.lenni0451.mcstructs_bedrock.text.BedrockTextFormatting;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class TextUtilFormattingTest {
+
+    @Test
+    void resolvesTargetPartyBlueDefaultAndRetainsActiveStyles() {
+        final TextComponent component = TextUtil.stringToTextComponent("§l§oA§WB§rC");
+        final List<TextComponent> parts = new ArrayList<>();
+        TextUtils.iterateAll(component, part -> {
+            if (!part.asSingleString().isEmpty()) {
+                parts.add(part);
+            }
+        });
+        assertEquals(3, parts.size());
+        assertEquals(0x8CB3FF, parts.get(1).getStyle().getColor().getRgbValue());
+        assertTrue(parts.get(1).getStyle().isBold());
+        assertTrue(parts.get(1).getStyle().isItalic());
+        assertFalse(parts.get(parts.size() - 1).getStyle().isBold());
+        assertFalse(parts.get(parts.size() - 1).getStyle().isItalic());
+    }
+
+    @Test
+    void resolvesTargetNativeColorsAtTheComponentBoundary() {
+        final BedrockTextFormatting[] formats = {BedrockTextFormatting.MINECOIN_GOLD, BedrockTextFormatting.MATERIAL_EMERALD,
+            BedrockTextFormatting.MATERIAL_GOLD, BedrockTextFormatting.BLUE};
+        final int[] expected = {0xDED605, 0x11A036, 0xDEB12D, 0x5555FF};
+        for (int i = 0; i < formats.length; i++) {
+            final String input = new String(new char[]{BedrockTextFormatting.COLOR_CHAR, formats[i].getCode(), 'A'});
+            final var component = TextUtil.stringToTextComponent(input);
+            assertEquals(expected[i], component.getStyle().getColor().getRgbValue());
+        }
+    }
+
+}
