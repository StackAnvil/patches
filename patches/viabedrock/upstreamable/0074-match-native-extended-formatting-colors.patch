+package net.raphimc.viabedrock.api.util;
+
+import net.lenni0451.mcstructs_bedrock.text.BedrockTextFormatting;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class TextUtilFormattingTest {
+
+    @Test
+    void resolvesTargetNativeColorsAtTheComponentBoundary() {
+        final BedrockTextFormatting[] formats = {BedrockTextFormatting.MINECOIN_GOLD, BedrockTextFormatting.MATERIAL_EMERALD,
+            BedrockTextFormatting.MATERIAL_GOLD, BedrockTextFormatting.BLUE};
+        final int[] expected = {0xDED605, 0x11A036, 0xDEB12D, 0x5555FF};
+        for (int i = 0; i < formats.length; i++) {
+            final String input = new String(new char[]{BedrockTextFormatting.COLOR_CHAR, formats[i].getCode(), 'A'});
+            final var component = TextUtil.stringToTextComponent(input);
+            assertEquals(expected[i], component.getStyle().getColor().getRgbValue());
+        }
+    }
+
+}
