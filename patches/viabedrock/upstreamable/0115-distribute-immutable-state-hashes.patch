From f611901667623e4d31c346810869bc5626385e01 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:40:19 +0100
Subject: [PATCH] perf(blocks): distribute immutable state hashes

Block palettes repeatedly look up logical states in immutable maps. The raw
Map hash sums key/value XORs, so exchanging small property values produces
many collisions. The pinned 23,960-state palette has only 15,338 distinct
hashes, with up to 70 states sharing one hash. Map construction and lookup
then spend substantial time comparing unrelated property maps.

Mix each property pair before its order-independent sum and retain the hash
on the state. Own a copy of the input properties in their iteration order,
so caller mutation cannot invalidate a registered key or its hash. Keep
equality independent of property order and preserve unsorted state strings.
Network palette IDs still use the separate native NBT hasher.

The regression mutates the caller's map, looks up an equal reordered state,
and checks immutable derivation and the retained state string. This hash
change is independently reviewable from pack conversion and custom blocks.
---
 .../viabedrock/api/model/BlockState.java      | 15 ++++--
 .../viabedrock/api/model/BlockStateTest.java  | 53 +++++++++++++++++++
 2 files changed, 65 insertions(+), 3 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/model/BlockStateTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/BlockState.java b/src/main/java/net/raphimc/viabedrock/api/model/BlockState.java
index 49e22a7178d47959c8eb9cf4708c2c26bcb3ba40..d35f53f5331dc5591f30f8e9430fe0cc3b8b903c 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/BlockState.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/BlockState.java
@@ -24,6 +24,7 @@ public class BlockState {
     private final String namespace;
     private final String identifier;
     private final Map<String, String> properties;
+    private final int hash;
 
     public BlockState(final String identifier, final Map<String, String> properties) {
         this("minecraft", identifier, properties);
@@ -36,7 +37,15 @@ public class BlockState {
 
         this.namespace = namespace;
         this.identifier = identifier.toLowerCase(Locale.ROOT);
-        this.properties = Collections.unmodifiableMap(properties);
+        this.properties = Collections.unmodifiableMap(new LinkedHashMap<>(properties));
+        int propertyHash = 0;
+        for (final Map.Entry<String, String> entry : this.properties.entrySet()) {
+            // Mix each key/value pair before the order-independent sum. Raw map hashes collide
+            // heavily when several block properties exchange small numeric or boolean values.
+            final int mixed = (Objects.hashCode(entry.getKey()) ^ Integer.rotateLeft(Objects.hashCode(entry.getValue()), 16)) * 0x9E3779B9;
+            propertyHash += mixed ^ mixed >>> 16;
+        }
+        this.hash = 31 * (31 * (31 + this.namespace.hashCode()) + this.identifier.hashCode()) + propertyHash;
     }
 
     public static BlockState fromString(final String string) {
@@ -183,12 +192,12 @@ public class BlockState {
         if (!(o instanceof BlockState that)) {
             return false;
         }
-        return Objects.equals(this.namespace, that.namespace) && Objects.equals(this.identifier, that.identifier) && Objects.equals(this.properties, that.properties);
+        return this.hash == that.hash && Objects.equals(this.namespace, that.namespace) && Objects.equals(this.identifier, that.identifier) && Objects.equals(this.properties, that.properties);
     }
 
     @Override
     public int hashCode() {
-        return Objects.hash(this.namespace, this.identifier, this.properties);
+        return this.hash;
     }
 
     @Override
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/BlockStateTest.java b/src/test/java/net/raphimc/viabedrock/api/model/BlockStateTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..6963596871d69df16e046445dd91dfff7f171cfe
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/BlockStateTest.java
