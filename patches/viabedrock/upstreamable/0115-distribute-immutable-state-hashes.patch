+package net.raphimc.viabedrock.api.model;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BlockStateTest {
+
+    @Test
+    void stateKeysOwnTheirPropertiesAndRetainOrderAfterCallerMutation() {
+        final Map<String, String> properties = new LinkedHashMap<>();
+        properties.put("facing", "north");
+        properties.put("powered", "false");
+        final var state = new BlockState("probe", "BLOCK", properties);
+        final var registered = Map.of(state, 42);
+        final int hash = state.hashCode();
+        properties.put("facing", "south");
+        properties.clear();
+        assertEquals("probe:block[facing=north,powered=false]", state.toBlockStateString());
+        assertEquals(hash, state.hashCode());
+        final Map<String, String> reordered = new LinkedHashMap<>();
+        reordered.put("powered", "false");
+        reordered.put("facing", "north");
+        final var equal = new BlockState("probe", "block", reordered);
+        assertEquals(state, equal);
+        assertEquals(hash, equal.hashCode());
+        assertEquals(42, registered.get(equal));
+        assertNotEquals(state, state.withProperty("powered", "true"));
+        assertEquals("false", state.properties().get("powered"));
+        assertThrows(UnsupportedOperationException.class, () -> state.properties().put("powered", "true"));
+    }
+
+}
