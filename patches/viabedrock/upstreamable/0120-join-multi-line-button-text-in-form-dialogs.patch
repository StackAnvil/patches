From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:05:39 +0100
Subject: [PATCH] fix(forms): match Bedrock line breaks in form dialogs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Bedrock form buttons show every line of their text, and servers use
that for subtitles. NetherGames' server selector sends buttons such as
"BonfireMC\n§21 playing". Java dialog buttons draw a single line, so the
raw line break rendered as a stray glyph between the two parts.

Form dialog buttons, including the header and label rows that dialogs
show as inert buttons, now join their lines with one space. Repeated or
CRLF breaks and the spaces around them collapse to that space, so the
label reads "BonfireMC 1 playing".

Dialog body text used to become one Java plain message per line. Java
pads body messages like paragraphs, so Minehut's age prompt, which
breaks a sentence once ("Terms of Service and\nPrivacy Policy"), showed
a paragraph gap at every line break. Body text now stays in one plain
message. Java's text wrapper breaks lines at each newline, so a single
break reads as the next line and a blank line still separates
paragraphs, as on Bedrock.

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
index 050f438c282ac22077189d62fa2622e7970d82d3..bec019a1af41773f613760fb3e1db7d3309a2d0a 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InventoryPackets.java
@@ -766,6 +766,14 @@ public final class InventoryPackets {
         presentation.send(BedrockProtocol.class);
     }
 
+    /**
+     * Java dialog buttons draw one line, and a raw line break renders as a glyph. Bedrock form buttons show each line,
+     * so servers often put a subtitle such as a player count on a second line. Join the lines with a space instead.
+     */
+    private static TextComponent buttonLabel(final String text) {
+        return TextUtil.stringToTextComponent(text.replaceAll("[ \\t]*(?:\\R[ \\t]*)+", " "));
+    }
+
     private static Dialog createFormDialog(final UserConnection user, final int id, final Form form,
             final ServerFormUi.Presentation presentation) {
         final ResourcePackStorage resourcePackStorage = user.get(ResourcePackStorage.class);
@@ -799,8 +807,7 @@ public final class InventoryPackets {
                     .getActions()
                     .add(
                             new ActionButton(
-                                    TextUtil.stringToTextComponent(
-                                            modalForm.getButton1()),
+                                    buttonLabel(modalForm.getButton1()),
                                     DIALOG_BUTTON_WIDTH,
                                     new CustomAllAction(
                                             responseIdentifier, button1Additions)));
@@ -810,8 +817,7 @@ public final class InventoryPackets {
                     .getActions()
                     .add(
                             new ActionButton(
-                                    TextUtil.stringToTextComponent(
-                                            modalForm.getButton2()),
+                                    buttonLabel(modalForm.getButton2()),
                                     DIALOG_BUTTON_WIDTH,
                                     new CustomAllAction(
                                             responseIdentifier, button2Additions)));
@@ -858,8 +864,7 @@ public final class InventoryPackets {
                                 .getActions()
                                 .add(
                                         new ActionButton(
-                                                TextUtil.stringToTextComponent(
-                                                        presentation == null || presentation.buttons().get(sourceIndex).isBlank()
+                                                buttonLabel(presentation == null || presentation.buttons().get(sourceIndex).isBlank()
                                                                 ? button.getText() : presentation.buttons().get(sourceIndex)),
                                                 DIALOG_BUTTON_WIDTH,
                                                 new CustomAllAction(
@@ -870,8 +875,7 @@ public final class InventoryPackets {
                                 .getActions()
                                 .add(
                                         new ActionButton(
-                                                TextUtil.stringToTextComponent(
-                                                        header.getText()),
+                                                buttonLabel(header.getText()),
                                                 new StringComponent(
                                                         DIALOG_FAKE_BUTTON_TEXT),
                                                 DIALOG_FAKE_BUTTON_WIDTH,
@@ -881,8 +885,7 @@ public final class InventoryPackets {
                                 .getActions()
                                 .add(
                                         new ActionButton(
-                                                TextUtil.stringToTextComponent(
-                                                        label.getText()),
+                                                buttonLabel(label.getText()),
                                                 new StringComponent(
                                                         DIALOG_FAKE_BUTTON_TEXT),
                                                 DIALOG_FAKE_BUTTON_WIDTH,
@@ -1058,9 +1061,9 @@ public final class InventoryPackets {
 
     private static void addTextToDialog(final UserConnection userConnection, final Dialog dialog, final String text) {
         if (dialog.getInputs().isEmpty()) {
-            for (String line : BedrockTextUtils.split(text, "\n")) {
-                dialog.getBody().add(new PlainMessageBody(TextUtil.stringToTextComponent(line)));
-            }
+            // Java pads each body message like a paragraph, but Bedrock spaces a line break like wrapped text.
+            // One message keeps that spacing, and Java breaks its lines at each newline.
+            dialog.getBody().add(new PlainMessageBody(TextUtil.stringToTextComponent(text)));
         } else {
             if (userConnection.getProtocolInfo().protocolVersion().newerThanOrEqualTo(ProtocolVersion.v1_21_6)) {
                 for (String line : BedrockTextUtils.split(text, "\n")) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/FormDialogTextTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/FormDialogTextTest.java
