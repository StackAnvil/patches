+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.mcstructs.converter.impl.v1_21_5.NbtConverter_v1_21_5;
+import com.viaversion.viaversion.libs.mcstructs.dialog.ActionButton;
+import com.viaversion.viaversion.libs.mcstructs.dialog.Dialog;
+import com.viaversion.viaversion.libs.mcstructs.dialog.body.PlainMessageBody;
+import com.viaversion.viaversion.libs.mcstructs.dialog.impl.MultiActionDialog;
+import com.viaversion.viaversion.libs.mcstructs.dialog.serializer.DialogSerializer;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.*;
+
+class FormDialogTextTest {
+
+    @Test
+    void multiLineFormButtonsBecomeOneLineDialogLabels() throws Exception {
+        // NetherGames' server selector puts each server's player count on a second line.
+        final var dialog = (MultiActionDialog) dialog("""
+                {"type":"form","title":"Server Selector","content":"Select a server to connect:",
+                 "buttons":[{"text":"BonfireMC\\n\\u00a721 playing"},{"text":"Mystrick Games\\r\\n\\n\\u00a7245 playing"}]}
+                """);
+        final List<String> labels = dialog.getActions().stream()
+                .map(ActionButton::getLabel).map(label -> label.asUnformattedString()).toList();
+        assertEquals(List.of("BonfireMC 1 playing", "Mystrick Games 45 playing"), labels);
+    }
+
+    @Test
+    void formLabelLineBreaksStayInOneDialogMessage() throws Exception {
+        // Minehut's age prompt breaks its label once inside a sentence and once between paragraphs.
+        final var dialog = dialog("""
+                {"type":"custom_form","title":"","content":[
+                 {"type":"label","text":"you agree to our Terms of Service and\\nPrivacy Policy.\\n\\nminehut.com/terms-of-service"},
+                 {"type":"dropdown","text":"Select your Age","options":["13-17","18+"],"default":0}]}
+                """);
+        final List<String> body = dialog.getBody().stream()
+                .map(message -> ((PlainMessageBody) message).getContents().asUnformattedString()).toList();
+        assertEquals(List.of("you agree to our Terms of Service and\nPrivacy Policy.\n\nminehut.com/terms-of-service"), body);
+    }
+
+    private static Dialog dialog(final String form) throws Exception {
+        final var user = mock(UserConnection.class);
+        final var inventory = new InventoryTracker(user);
+        when(user.get(InventoryTracker.class)).thenReturn(inventory);
+        when(user.get(ChannelStorage.class)).thenReturn(new ChannelStorage());
+        when(user.get(ResourcePackStorage.class)).thenReturn(new ResourcePackStorage(List.of()));
+        final var input = Unpooled.buffer();
+        try (var packets = mockStatic(PacketFactory.class)) {
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(input, 3);
+            BedrockTypes.STRING.write(input, form);
+            final var request = new PacketWrapperImpl(100, input, user);
+            InventoryPackets.handleModalFormRequest(request);
+            return DialogSerializer.V1_21_6.getDirectCodec().deserialize(
+                    NbtConverter_v1_21_5.INSTANCE, request.get(Types.TRUSTED_COMPOUND_TAG_HOLDER, 0).value()).get();
+        } finally {
+            input.release();
+        }
+    }
+
+}
