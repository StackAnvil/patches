+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class JigsawPacketsTest {
+
+    @Test
+    void preservesAuthoritativeDataWhileEncodingSignedPrioritiesAndPosition() throws Exception {
+        final CompoundTag original = new CompoundTag();
+        original.putString("id", "JigsawBlock");
+        original.putInt("BlockEntityVersion", 3);
+        original.putInt("selection_priority", -7);
+        original.putInt("placement_priority", 13);
+        final CompoundTag extension = new CompoundTag();
+        extension.putLong("revision", Long.MAX_VALUE);
+        original.put("extension", extension);
+        final CompoundTag snapshot = original.copy();
+        final BlockPosition position = new BlockPosition(-87, 120, 34);
+        final PacketWrapper wrapper = new PacketWrapperImpl(ServerboundBedrockPackets.BLOCK_ENTITY_DATA, null, null);
+        JigsawPackets.writeUpdate(wrapper, position, original, "minecraft:empty", "minecraft:empty",
+                "minecraft:empty", "minecraft:air", "rollable", Integer.MIN_VALUE, Integer.MAX_VALUE);
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ServerboundBedrockPackets.BLOCK_ENTITY_DATA.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(position, BedrockTypes.BLOCK_POSITION.read(buffer));
+            final CompoundTag decoded = (CompoundTag) BedrockTypes.NETWORK_TAG.read(buffer);
+            assertEquals(position.x(), decoded.getInt("x"));
+            assertEquals(position.y(), decoded.getInt("y"));
+            assertEquals(position.z(), decoded.getInt("z"));
+            assertEquals(Integer.MIN_VALUE, decoded.getInt("selection_priority"));
+            assertEquals(Integer.MAX_VALUE, decoded.getInt("placement_priority"));
+            assertEquals(original.get("id"), decoded.get("id"));
+            assertEquals(original.get("BlockEntityVersion"), decoded.get("BlockEntityVersion"));
+            assertEquals(extension, decoded.get("extension"));
+            assertEquals(snapshot, original);
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
