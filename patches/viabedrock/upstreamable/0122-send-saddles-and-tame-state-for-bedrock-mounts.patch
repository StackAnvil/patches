     }
 
+    /** Java's AbstractHorse flags: tame 0x02, eating 0x10 and standing 0x20. */
+    static byte horseFlags(final Set<ActorFlags> bedrockFlags) {
+        byte flags = 0;
+        if (bedrockFlags.contains(ActorFlags.TAMED)) {
+            flags |= 0x02;
+        }
+        if (bedrockFlags.contains(ActorFlags.EATING)) {
+            flags |= 0x10;
+        }
+        if (bedrockFlags.contains(ActorFlags.STANDING)) {
+            flags |= 0x20;
+        }
+        return flags;
+    }
+
+    /** Java mounts that keep their saddle in the SADDLE equipment slot. Llamas wear carpets instead. */
+    static boolean isSaddleable(final EntityTypes26_3 type) {
+        return type.isOrHasParent(EntityTypes26_3.ABSTRACT_HORSE) && !type.isOrHasParent(EntityTypes26_3.LLAMA)
+                || type.is(EntityTypes26_3.PIG) || type.is(EntityTypes26_3.STRIDER)
+                || type.is(EntityTypes26_3.NAUTILUS) || type.is(EntityTypes26_3.ZOMBIE_NAUTILUS);
+    }
+
+    /**
+     * Bedrock reports a saddle with the SADDLED actor flag. Java reads it from the SADDLE equipment slot, which gates
+     * mounted control, the jump bar and the saddle model.
+     */
+    private static void updateSaddle(final UserConnection user, final Entity entity, final boolean saddled) {
+        if (entity.javaSaddled() != null && entity.javaSaddled() == saddled) {
+            return;
+        }
+        entity.setJavaSaddled(saddled);
+        final PacketWrapper equipment = PacketWrapper.create(ClientboundPackets26_3.SET_EQUIPMENT, user);
+        equipment.write(Types.VAR_INT, entity.javaId()); // entity id
+        equipment.write(Types.BYTE, (byte) EquipmentSlot.SADDLE.ordinal()); // slot
+        equipment.write(VersionedTypes.V26_3.item, saddled
+                ? new StructuredItem(BedrockProtocol.MAPPINGS.getJavaItems().get("minecraft:saddle"), 1) : StructuredItem.empty()); // item
+        equipment.scheduleSend(BedrockProtocol.class);
+    }
+
     private static Number readNumber(final EntityData data) {
         if (data.dataType() == null || data.getValue() == null) {
             throw new IllegalArgumentException("EntityData " + data.id() + " has null data type or value");
