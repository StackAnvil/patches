+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import org.junit.jupiter.api.Test;
+
+import java.util.EnumSet;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class HorseMountStateTest {
+
+    @Test
+    void tamedRearingHorsesUseJavaHorseFlags() {
+        assertEquals(0x02, EntityMetadataRewriter.horseFlags(EnumSet.of(ActorFlags.TAMED, ActorFlags.SADDLED)));
+        assertEquals(0x32, EntityMetadataRewriter.horseFlags(EnumSet.of(ActorFlags.TAMED, ActorFlags.EATING, ActorFlags.STANDING)));
+        assertEquals(0, EntityMetadataRewriter.horseFlags(EnumSet.noneOf(ActorFlags.class)));
+    }
+
+    @Test
+    void saddlesGoToMountsThatJavaSaddlesButNotToLlamas() {
+        assertTrue(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.HORSE));
+        assertTrue(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.CAMEL));
+        assertTrue(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.PIG));
+        assertTrue(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.STRIDER));
+        assertFalse(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.LLAMA));
+        assertFalse(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.TRADER_LLAMA));
+        assertFalse(EntityMetadataRewriter.isSaddleable(EntityTypes26_3.COW));
+    }
+
+}
