+    static Entity predictedVehicle(final EntityTracker entityTracker, final ClientPlayerEntity clientPlayer) {
+        final Entity vehicle = entityTracker.getEntityByRid(clientPlayer.mountEntityRuntimeId());
+        if (vehicle == null || !(vehicle.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_BOAT)
+                || vehicle.javaType().isOrHasParent(EntityTypes26_3.ABSTRACT_HORSE))) {
+            return null;
+        }
+        return vehicle;
+    }
