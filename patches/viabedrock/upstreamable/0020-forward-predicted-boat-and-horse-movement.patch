+    public Position3f vehiclePositionDelta(final Entity vehicle) {
+        final Position3f delta = this.predictedVehicleRuntimeId == vehicle.runtimeId() && this.previousVehiclePosition != null
+                ? vehicle.position().subtract(this.previousVehiclePosition)
+                : Position3f.ZERO;
+        this.predictedVehicleRuntimeId = vehicle.runtimeId();
+        this.previousVehiclePosition = vehicle.position();
+        return delta;
+    }
+
+    public void resetPredictedVehicle() {
+        this.predictedVehicleRuntimeId = -1;
+        this.previousVehiclePosition = null;
+        this.paddlingLeft = false;
+        this.paddlingRight = false;
+    }
+
+    @Override
+    public void setMountEntityRuntimeId(final long runtimeId) {
+        if (this.mountRuntimeId != runtimeId) {
+            this.resetPredictedVehicle();
+        }
+        super.setMountEntityRuntimeId(runtimeId);
+    }
+
+    public void setPaddling(final boolean left, final boolean right) {
+        this.paddlingLeft = left;
+        this.paddlingRight = right;
+    }
+
+    public void addPaddlingInput() {
+        if (this.paddlingLeft) {
+            this.addAuthInputData(PlayerAuthInputData.PaddlingLeft);
+        }
+        if (this.paddlingRight) {
+            this.addAuthInputData(PlayerAuthInputData.PaddlingRight);
+        }
+        this.paddlingLeft = false;
+        this.paddlingRight = false;
+    }
+
     public boolean isSprinting() {
         return this.sprinting;
     }
