+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.api.util.MathUtil;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.UUID;
+
+public final class BoatEntity extends Entity {
+
+    public BoatEntity(final UserConnection user, final long uniqueId, final long runtimeId, final String type,
+                      final int javaId, final UUID javaUuid, final EntityTypes26_3 javaType) {
+        super(user, uniqueId, runtimeId, type, javaId, javaUuid, javaType);
+    }
+
+    @Override
+    public float eyeOffset() {
+        // Bedrock boats use the center of the hull rather than Java's base position.
+        return 0.375F;
+    }
+
+    @Override
+    public Position3f javaRotation() {
+        return new Position3f(this.rotation.x(), MathUtil.wrapDegrees(this.rotation.y() - 90F),
+                MathUtil.wrapDegrees(this.rotation.z() - 90F));
+    }
+
+    @Override
+    public void setJavaRotation(final Position3f rotation) {
+        this.setRotation(new Position3f(rotation.x(), MathUtil.wrapDegrees(rotation.y() + 90F),
+                MathUtil.wrapDegrees(rotation.z() + 90F)));
+    }
+
+}
