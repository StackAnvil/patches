+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BoatEntityTest {
+
+    @Test
+    void boatAndChestBoatRoundTripHullPositionAndHeading() {
+        for (final EntityTypes26_3 type : new EntityTypes26_3[]{EntityTypes26_3.OAK_BOAT, EntityTypes26_3.OAK_CHEST_BOAT}) {
+            final BoatEntity boat = new BoatEntity(null, 1, 2, "minecraft:boat", 3, UUID.randomUUID(), type);
+            boat.setPosition(new Position3f(12F, 65.375F, -8F));
+            boat.setRotation(new Position3f(0F, 90F, 90F));
+
+            assertEquals(new Position3f(12F, 65F, -8F), boat.javaPosition());
+            assertEquals(Position3f.ZERO, boat.javaRotation());
+
+            boat.setJavaPosition(new Position3f(13F, 65F, -6F));
+            boat.setJavaRotation(new Position3f(0F, 170F, 170F));
+            assertEquals(new Position3f(13F, 65.375F, -6F), boat.position());
+            assertEquals(new Position3f(0F, -100F, -100F), boat.rotation());
+            assertEquals(new Position3f(0F, 170F, 170F), boat.javaRotation());
+        }
+    }
+
+    @Test
+    void unrelatedEntitiesKeepTheirPositionAndHeading() {
+        final Entity horse = new Entity(null, 1, 2, "minecraft:horse", 3, UUID.randomUUID(), EntityTypes26_3.HORSE);
+        final Position3f position = new Position3f(12F, 65F, -8F);
+        final Position3f rotation = new Position3f(12F, 170F, 170F);
+        horse.setJavaPosition(position);
+        horse.setJavaRotation(rotation);
+        assertEquals(position, horse.position());
+        assertEquals(position, horse.javaPosition());
+        assertEquals(rotation, horse.rotation());
+        assertEquals(rotation, horse.javaRotation());
+    }
+
+}
