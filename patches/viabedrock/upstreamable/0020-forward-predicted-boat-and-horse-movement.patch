+
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class PredictedVehicleTest {
+
+    private static final long VEHICLE_RUNTIME_ID = 13;
+    private static final long PLAYER_UNIQUE_ID = 1;
+    private static final long DRIVER_UNIQUE_ID = 2;
+    private static final Set<EntityTypes26_3> HORSE_FLAG_TYPES = Set.of(EntityTypes26_3.HORSE, EntityTypes26_3.DONKEY,
+            EntityTypes26_3.MULE, EntityTypes26_3.SKELETON_HORSE, EntityTypes26_3.ZOMBIE_HORSE);
+    private static final List<EntityTypes26_3> JAVA_HORSE_TYPES = List.of(EntityTypes26_3.HORSE, EntityTypes26_3.DONKEY,
+            EntityTypes26_3.MULE, EntityTypes26_3.SKELETON_HORSE, EntityTypes26_3.ZOMBIE_HORSE, EntityTypes26_3.CAMEL,
+            EntityTypes26_3.CAMEL_HUSK, EntityTypes26_3.LLAMA, EntityTypes26_3.TRADER_LLAMA);
+
+    @Test
+    void onlyTamedSaddledHorseFlagMountsAreClientPredicted() {
+        for (final EntityTypes26_3 type : JAVA_HORSE_TYPES) {
+            for (final boolean tamed : new boolean[]{false, true}) {
+                for (final boolean saddled : new boolean[]{false, true}) {
+                    final Entity mount = new AbstractHorseEntity(null, 12, VEHICLE_RUNTIME_ID, "minecraft:test", 14, UUID.randomUUID(), type);
+                    mount.entityData().put(ActorDataIds.RESERVED_0, new EntityData(0, EntityDataTypesBedrock.LONG,
+                            (tamed ? 1L << 28 : 0L) | (saddled ? 1L << 8 : 0L)));
+                    mount.addPassenger(PLAYER_UNIQUE_ID);
+                    final boolean predicted = HORSE_FLAG_TYPES.contains(type) && tamed && saddled;
+                    assertEquals(predicted ? mount : null, predictedVehicle(mount), type + " tamed=" + tamed + " saddled=" + saddled);
+                }
+            }
+        }
+    }
+
+    @Test
+    void boatsAreClientPredictedWithoutMountFlags() {
+        final Entity boat = new BoatEntity(null, 12, VEHICLE_RUNTIME_ID, "minecraft:boat", 14, UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+        boat.addPassenger(PLAYER_UNIQUE_ID);
+        assertEquals(boat, predictedVehicle(boat));
+    }
+
+    @Test
+    void onlyTheControllingSeatPredictsTheBoat() {
+        final Entity boat = new BoatEntity(null, 12, VEHICLE_RUNTIME_ID, "minecraft:boat", 14, UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+        boat.addPassenger(DRIVER_UNIQUE_ID);
+        boat.addPassenger(PLAYER_UNIQUE_ID);
+        assertNull(predictedVehicle(boat));
+        boat.addPrimaryPassenger(PLAYER_UNIQUE_ID);
+        assertEquals(boat, predictedVehicle(boat));
+    }
+
+    private static Entity predictedVehicle(final Entity mount) {
+        final EntityTracker tracker = mock(EntityTracker.class);
+        final ClientPlayerEntity player = mock(ClientPlayerEntity.class);
+        when(player.mountEntityRuntimeId()).thenReturn(VEHICLE_RUNTIME_ID);
+        when(player.uniqueId()).thenReturn(PLAYER_UNIQUE_ID);
+        when(tracker.getEntityByRid(VEHICLE_RUNTIME_ID)).thenReturn(mount);
+        return ClientPlayerPackets.predictedVehicle(tracker, player);
+    }
+
+}
