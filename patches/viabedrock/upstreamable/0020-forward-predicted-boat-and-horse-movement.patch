+    @Test
+    void vehicleMovementUsesVehicleDeltaAndResetsOnDismount() {
+        final ClientPlayerEntity player = player();
+        final Entity boat = new Entity(null, 12, 13, "minecraft:boat", 14, UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+        boat.setPosition(new Position3f(3F, 64F, 5F));
+        player.setMountEntityRuntimeId(boat.runtimeId());
+
+        assertEquals(Position3f.ZERO, player.vehiclePositionDelta(boat));
+        boat.setPosition(new Position3f(3.5F, 64F, 6F));
+        assertEquals(new Position3f(0.5F, 0F, 1F), player.vehiclePositionDelta(boat));
+
+        player.setMountEntityRuntimeId(-1);
+        player.setMountEntityRuntimeId(boat.runtimeId());
+        assertEquals(Position3f.ZERO, player.vehiclePositionDelta(boat));
+    }
+
+    @Test
+    void paddleInputOnlyLastsForOneAuthInputTick() {
+        final ClientPlayerEntity player = player();
+        player.setPaddling(true, false);
+
+        player.addPaddlingInput();
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.PaddlingLeft));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.PaddlingRight));
+
+        player.authInputData().clear();
+        player.addPaddlingInput();
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.PaddlingLeft));
+    }
+
