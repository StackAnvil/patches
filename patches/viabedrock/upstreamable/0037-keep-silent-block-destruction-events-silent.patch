From c47f2b1aa375b21651a67b1d648dc451bb9d9fe9 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:38:23 +0200
Subject: [PATCH] fix(sound): keep silent block destruction events silent

Bedrock ParticlesDestroyBlockNoSound was translated to Java brush completion, which can play an unrelated sound on brushable blocks. Java 26.3 event 2014 emits destruction particles without the break sound, matching the Bedrock event semantics.
---
 .../raphimc/viabedrock/protocol/data/enums/java/LevelEvent.java | 1 +
 .../assets/viabedrock/data/custom/level_event_mappings.json     | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/data/enums/java/LevelEvent.java b/src/main/java/net/raphimc/viabedrock/protocol/data/enums/java/LevelEvent.java
index c07ba7ce..dfd5e439 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/data/enums/java/LevelEvent.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/data/enums/java/LevelEvent.java
@@ -83,6 +83,7 @@ public enum LevelEvent {
     PARTICLES_BEE_GROWTH(2011),
     PARTICLES_TURTLE_EGG_PLACEMENT(2012),
     PARTICLES_SMASH_ATTACK(2013),
+    PARTICLES_DESTROY_BLOCK_NO_SOUND(2014),
     ANIMATION_END_GATEWAY_SPAWN(3000),
     ANIMATION_DRAGON_SUMMON_ROAR(3001),
     PARTICLES_ELECTRIC_SPARK(3002),
diff --git a/src/main/resources/assets/viabedrock/data/custom/level_event_mappings.json b/src/main/resources/assets/viabedrock/data/custom/level_event_mappings.json
index be58e0d3..ba8d6b5e 100644
--- a/src/main/resources/assets/viabedrock/data/custom/level_event_mappings.json
+++ b/src/main/resources/assets/viabedrock/data/custom/level_event_mappings.json
@@ -148,7 +148,7 @@
   "ParticlesBreakingEgg": "PARTICLES_EGG_CRACK",
   "ParticleDestroyEgg": "PARTICLES_WATER_EVAPORATING",
   "ParticlesEvaporateWater": "PARTICLES_WATER_EVAPORATING",
-  "ParticlesDestroyBlockNoSound": "PARTICLES_AND_SOUND_BRUSH_BLOCK_COMPLETE",
+  "ParticlesDestroyBlockNoSound": "PARTICLES_DESTROY_BLOCK_NO_SOUND",
   "ParticlesKnockbackRoar": {
     "particle": "minecraft:poof",
     "speed": 0.25,
-- 
2.55.0


