 class BlockInteractionSoundTrackerTest {
 
+    @Test
+    void keepsOneBreakSoundRegardlessOfPacketOrder() {
+        final AtomicLong clock = new AtomicLong();
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker(clock::get);
+        final Position3f block = new Position3f(10.5F, 64.5F, 20.5F);
+
+        assertFalse(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_EVENT));
+        assertTrue(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_SOUND_EVENT));
+        assertFalse(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_SOUND_EVENT));
+        assertTrue(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_EVENT));
+    }
+
+    @Test
+    void leavesOtherBlocksAndDelayedBreaksAudible() {
+        final AtomicLong clock = new AtomicLong();
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker(clock::get);
+        final Position3f block = new Position3f(10.5F, 64.5F, 20.5F);
+
+        assertFalse(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_EVENT));
+        assertFalse(tracker.isDuplicateBreakSound(new Position3f(11.5F, 64.5F, 20.5F), 12,
+                BreakSoundSource.LEVEL_SOUND_EVENT));
+        assertFalse(tracker.isDuplicateBreakSound(block, 13, BreakSoundSource.LEVEL_SOUND_EVENT));
+        clock.set(500_000_001L);
+        assertFalse(tracker.isDuplicateBreakSound(block, 12, BreakSoundSource.LEVEL_SOUND_EVENT));
+    }
+
