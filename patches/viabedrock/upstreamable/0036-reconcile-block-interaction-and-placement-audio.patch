+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BlockInteractionSoundTrackerTest {
+
+    @Test
+    void filtersOnlyMiningSoundsFromTheLocalBlockAndActor() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        final BlockPosition block = new BlockPosition(10, 64, 20);
+        tracker.startMining(block);
+
+        assertTrue(tracker.isLocallyPlayedMiningSound("hit", new Position3f(10.5F, 64.5F, 20.5F), 0, 42));
+        assertFalse(tracker.isLocallyPlayedMiningSound("hit", new Position3f(11.5F, 64.5F, 20.5F), 0, 42));
+        assertFalse(tracker.isLocallyPlayedMiningSound("hit", new Position3f(10.5F, 64.5F, 20.5F), 43, 42));
+        assertTrue(tracker.isLocallyPlayedMiningSound("attack.nodamage", new Position3f(10.5F, 65F, 20.5F), 42, 42));
+        assertFalse(tracker.isLocallyPlayedMiningSound("attack.nodamage", new Position3f(10.5F, 65F, 20.5F), 43, 42));
+
+        tracker.stopMining(block);
+        assertFalse(tracker.isLocallyPlayedMiningSound("hit", new Position3f(10.5F, 64.5F, 20.5F), 0, 42));
+    }
+
+    @Test
+    void consumesOnlyThePredictedSoundAtTheClickedDoor() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        final BlockPosition clicked = new BlockPosition(10, 64, 20);
+        tracker.recordInteraction(clicked, new BlockState("oak_door", Map.of("open", "false", "half", "lower")));
+
+        assertFalse(tracker.consumeLocallyPlayed("door.close", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("door.open", new Position3f(11.5F, 64.5F, 20.5F)));
+        assertTrue(tracker.consumeLocallyPlayed("door.open", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("door.open", new Position3f(10.5F, 64.5F, 20.5F)));
+    }
+
+    @Test
+    void anotherConnectionStillReceivesTheDoorSound() {
+        final BlockInteractionSoundTracker opener = new BlockInteractionSoundTracker();
+        final BlockInteractionSoundTracker otherPlayer = new BlockInteractionSoundTracker();
+        final BlockPosition door = new BlockPosition(10, 64, 20);
+        final Position3f soundPosition = new Position3f(10.5F, 64.5F, 20.5F);
+        opener.recordInteraction(door, new BlockState("oak_door", Map.of("open", "false", "half", "lower")));
+
+        assertFalse(otherPlayer.consumeLocallyPlayed("door.open", soundPosition));
+        assertTrue(opener.consumeLocallyPlayed("door.open", soundPosition));
+
+        opener.recordInteraction(door, new BlockState("oak_door", Map.of("open", "true", "half", "lower")));
+        assertFalse(otherPlayer.consumeLocallyPlayed("door.close", soundPosition));
+        assertTrue(opener.consumeLocallyPlayed("door.close", soundPosition));
+    }
+
+    @Test
+    void matchesUpperHalfInteractionToLowerDoorSound() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        tracker.recordInteraction(new BlockPosition(10, 65, 20),
+                new BlockState("oak_door", Map.of("open", "true", "half", "upper")));
+
+        assertTrue(tracker.consumeLocallyPlayed("door.close", new Position3f(10.5F, 64.5F, 20.5F)));
+    }
+
+    @Test
+    void leavesUnpredictedAndExpiredSoundsAlone() {
+        final AtomicLong clock = new AtomicLong();
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker(clock::get);
+        final BlockPosition position = new BlockPosition(10, 64, 20);
+        tracker.recordInteraction(position, new BlockState("iron_door", Map.of("open", "false")));
+        assertFalse(tracker.consumeLocallyPlayed("door.open", new Position3f(10.5F, 64.5F, 20.5F)));
+
+        tracker.recordInteraction(position, new BlockState("oak_trapdoor", Map.of("open", "false")));
+        assertFalse(tracker.consumeLocallyPlayed("door.open", new Position3f(10.5F, 64.5F, 20.5F)));
+        clock.set(2_000_000_001L);
+        assertFalse(tracker.consumeLocallyPlayed("trapdoor.open", new Position3f(10.5F, 64.5F, 20.5F)));
+    }
+
+    @Test
+    void filtersOnlyFenceGateAndButtonSoundsPlayedByJavaPrediction() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        final Position3f soundPosition = new Position3f(10.5F, 64.5F, 20.5F);
+        final BlockPosition position = new BlockPosition(10, 64, 20);
+
+        tracker.recordInteraction(position, new BlockState("spruce_fence_gate", Map.of("open", "false")));
+        assertTrue(tracker.consumeLocallyPlayed("fence_gate.open", soundPosition));
+
+        tracker.recordInteraction(position, new BlockState("stone_button", Map.of("powered", "false")));
+        assertTrue(tracker.consumeLocallyPlayed("button.click_on", soundPosition));
+        tracker.recordInteraction(position, new BlockState("stone_button", Map.of("powered", "true")));
+        assertFalse(tracker.consumeLocallyPlayed("button.click_off", soundPosition));
+
+        tracker.recordInteraction(position, new BlockState("lever", Map.of("powered", "false")));
+        tracker.recordInteraction(position, new BlockState("chest", Map.of()));
+        assertFalse(tracker.consumeLocallyPlayed("button.click_on", soundPosition));
+        assertFalse(tracker.consumeLocallyPlayed("chest.open", soundPosition));
+    }
+
+    @Test
+    void consumesOnlyTheLocalPlacementEchoAtThePlacedBlock() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        final BlockPosition placed = new BlockPosition(10, 64, 20);
+        tracker.recordPlacement(new BlockPosition(10, 64, 19), placed);
+
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(11.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("break", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertTrue(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+
+        tracker.recordPlacement(new BlockPosition(10, 64, 19), placed);
+        assertTrue(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 19.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+    }
+
+}
