+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayDeque;
+import java.util.Iterator;
+import java.util.function.LongSupplier;
+
+/** Tracks block interaction sounds already played by the Java client's prediction. */
+public final class BlockInteractionSoundTracker implements StorableObject {
+
+    private static final long MAX_AGE_NANOS = 2_000_000_000L;
+    private static final long BREAK_EVENT_AGE_NANOS = 500_000_000L;
+    private static final int MAX_PENDING = 8;
+
+    private final ArrayDeque<PendingSound> pending = new ArrayDeque<>();
+    private final ArrayDeque<PendingBreakSound> pendingBreakSounds = new ArrayDeque<>();
+    private final LongSupplier clock;
+    private BlockPosition miningPosition;
+
+    public BlockInteractionSoundTracker() {
+        this(System::nanoTime);
+    }
+
+    BlockInteractionSoundTracker(final LongSupplier clock) {
+        this.clock = clock;
+    }
+
+    public void recordInteraction(final BlockPosition position, final BlockState state) {
+        if (state == null) {
+            return;
+        }
+        final String identifier = state.identifier();
+        final String event;
+        if (identifier.endsWith("_trapdoor") && !identifier.endsWith(":iron_trapdoor") && !identifier.equals("iron_trapdoor")) {
+            event = toggledEvent("trapdoor.", state);
+        } else if (identifier.endsWith("_door") && !identifier.endsWith(":iron_door") && !identifier.equals("iron_door")) {
+            event = toggledEvent("door.", state);
+        } else if (identifier.endsWith("_fence_gate")) {
+            event = toggledEvent("fence_gate.", state);
+        } else if (identifier.endsWith("_button") && state.hasProperty("powered", "false")) {
+            event = "button.click_on";
+        } else {
+            return;
+        }
+        if (event == null) {
+            return;
+        }
+
+        final int lowerY = state.hasProperty("half", "upper") ? position.y() - 1 : position.y();
+        this.record(new BlockPosition(position.x(), lowerY, position.z()), null, event);
+    }
+
+    public void recordPlacement(final BlockPosition clickedPosition, final BlockPosition placedPosition) {
+        this.record(placedPosition, clickedPosition.equals(placedPosition) ? null : clickedPosition, "place");
+    }
+
+    public void startMining(final BlockPosition position) {
+        this.miningPosition = position;
+    }
+
+    public void stopMining(final BlockPosition position) {
+        if (position.equals(this.miningPosition)) {
+            this.miningPosition = null;
+        }
+    }
+
+    public boolean isLocallyPlayedMiningSound(final String event, final Position3f position,
+                                              final long actorUniqueId, final long localPlayerUniqueId) {
+        if (this.miningPosition == null || actorUniqueId != 0 && actorUniqueId != -1 && actorUniqueId != localPlayerUniqueId) {
+            return false;
+        }
+        if ("attack.nodamage".equals(event)) {
+            return actorUniqueId == localPlayerUniqueId;
+        }
+        return "hit".equals(event) && position != null && matches(position, this.miningPosition);
+    }
+
+    public boolean isDuplicateBreakSound(final Position3f position, final int blockState,
+                                         final BreakSoundSource source) {
+        if (blockState < 0 || position == null || !Float.isFinite(position.x())
+                || !Float.isFinite(position.y()) || !Float.isFinite(position.z())) {
+            return false;
+        }
+        final long now = this.clock.getAsLong();
+        while (!this.pendingBreakSounds.isEmpty()
+                && now - this.pendingBreakSounds.peekFirst().createdAt() > BREAK_EVENT_AGE_NANOS) {
+            this.pendingBreakSounds.removeFirst();
+        }
+        for (final Iterator<PendingBreakSound> iterator = this.pendingBreakSounds.iterator(); iterator.hasNext(); ) {
+            final PendingBreakSound previous = iterator.next();
+            if (previous.blockState() == blockState && previous.source() != source
+                    && matches(position, previous.position())) {
+                iterator.remove();
+                return true;
+            }
+        }
+        if (this.pendingBreakSounds.size() == MAX_PENDING) {
+            this.pendingBreakSounds.removeFirst();
+        }
+        this.pendingBreakSounds.addLast(new PendingBreakSound(
+                new BlockPosition((int) Math.floor(position.x()), (int) Math.floor(position.y()), (int) Math.floor(position.z())),
+                blockState, source, now));
+        return false;
+    }
+
+    private void record(final BlockPosition position, final BlockPosition alternatePosition, final String event) {
+        final long now = this.clock.getAsLong();
+        this.removeExpired(now);
+        if (this.pending.size() == MAX_PENDING) {
+            this.pending.removeFirst();
+        }
+        this.pending.addLast(new PendingSound(position, alternatePosition, event, now));
+    }
+
+    private static String toggledEvent(final String prefix, final BlockState state) {
+        if (!state.properties().containsKey("open")) {
+            return null;
+        }
+        return prefix + (state.hasProperty("open", "true") ? "close" : "open");
+    }
+
+    public boolean consumeLocallyPlayed(final String event, final Position3f position) {
+        if (position == null || !Float.isFinite(position.x()) || !Float.isFinite(position.y()) || !Float.isFinite(position.z())) {
+            return false;
+        }
+        this.removeExpired(this.clock.getAsLong());
+        for (final Iterator<PendingSound> iterator = this.pending.iterator(); iterator.hasNext(); ) {
+            final PendingSound sound = iterator.next();
+            if (sound.event().equals(event) && (matches(position, sound.position())
+                    || sound.alternatePosition() != null && matches(position, sound.alternatePosition()))) {
+                iterator.remove();
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean matches(final Position3f soundPosition, final BlockPosition blockPosition) {
+        return Math.abs(soundPosition.x() - (blockPosition.x() + 0.5F)) <= 0.75F
+                && Math.abs(soundPosition.y() - (blockPosition.y() + 0.5F)) <= 1.25F
+                && Math.abs(soundPosition.z() - (blockPosition.z() + 0.5F)) <= 0.75F;
+    }
+
+    private void removeExpired(final long now) {
+        while (!this.pending.isEmpty() && now - this.pending.peekFirst().createdAt() > MAX_AGE_NANOS) {
+            this.pending.removeFirst();
+        }
+    }
+
+    private record PendingSound(BlockPosition position, BlockPosition alternatePosition, String event, long createdAt) {
+    }
+
+    private record PendingBreakSound(BlockPosition position, int blockState, BreakSoundSource source, long createdAt) {
+    }
+
+    public enum BreakSoundSource {
+        LEVEL_EVENT,
+        LEVEL_SOUND_EVENT
+    }
+
+}
