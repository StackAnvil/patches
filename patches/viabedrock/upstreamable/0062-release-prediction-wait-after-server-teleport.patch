From b689efcee38bca070191d33d171d7dee91714f68 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 1 Oct 2026 12:08:02 +0200
Subject: [PATCH] fix(movement): release prediction wait after server teleport

A chunk boundary correction waits for its fake Java teleport acknowledgement. If a real server teleport supersedes that correction, the old acknowledgement no longer matches the pending ID. Previously the real acknowledgement admitted only one position packet and left the correction wait set forever, freezing subsequent server movement.

Clear the prediction wait when the current authoritative teleport is acknowledged. Preserve stale-ID protection and the HandledTeleport signal. The regression test covers a pending local correction replaced by a server teleport, stale acknowledgements, and the final matching acknowledgement.

Track the exact signed Java teleport ID. Ignore stale, duplicate, zero,
and opposite-sign acknowledgements before changing prediction wait or
reporting HandledTeleport. Only the current authoritative acknowledgement
can grant the post-teleport movement exception. The tests cover replacement
by a server teleport and wrong-sign acknowledgements for local corrections.

Keep the latest server teleport identity separate from the pending local
position sync. A later local correction must not retire the server
acknowledgement, and that acknowledgement must not unlock the newer
local correction or grant its position exception.
---
 .../api/model/entity/ClientPlayerEntity.java  |  26 +++-
 .../entity/ClientPlayerTeleportTest.java      | 142 ++++++++++++++++++
 2 files changed, 160 insertions(+), 8 deletions(-)
 create mode 100644 src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
index 6347d81bf..9b18d56e2 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
@@ -62,6 +62,7 @@ public class ClientPlayerEntity extends PlayerEntity {
 
     // Position syncing
     private int pendingTeleportId;
+    private int authoritativeTeleportId;
     private boolean waitingForPositionSync;
     private boolean serverSideTeleportConfirmed;
 
@@ -124,9 +125,13 @@ public class ClientPlayerEntity extends PlayerEntity {
     }
 
     public void writePlayerPositionPacketToClient(final PacketWrapper wrapper, final Set<Relative> relatives, final boolean fakeTeleport) {
-        this.pendingTeleportId = this.teleportId.getAndIncrement();
+        this.serverSideTeleportConfirmed = false;
+        this.pendingTeleportId = this.teleportId.getAndIncrement() * (fakeTeleport ? -1 : 1);
+        if (!fakeTeleport) {
+            this.authoritativeTeleportId = this.pendingTeleportId;
+        }
 
-        wrapper.write(Types.VAR_INT, this.pendingTeleportId * (fakeTeleport ? -1 : 1)); // teleport id
+        wrapper.write(Types.VAR_INT, this.pendingTeleportId); // teleport id
         wrapper.write(Types.DOUBLE, relatives.contains(Relative.X) ? 0D : (double) this.position.x()); // x
         wrapper.write(Types.DOUBLE, relatives.contains(Relative.Y) ? 0D : (double) (this.position.y() - this.eyeOffset())); // y
         wrapper.write(Types.DOUBLE, relatives.contains(Relative.Z) ? 0D : (double) this.position.z()); // z
@@ -218,13 +223,18 @@ public class ClientPlayerEntity extends PlayerEntity {
     }
 
     public void confirmTeleport(final int teleportId) {
-        if (teleportId < 0) { // Fake teleport
-            if (this.pendingTeleportId == -teleportId) {
-                this.pendingTeleportId = 0;
-                this.waitingForPositionSync = false;
+        if (teleportId == 0) {
+            return;
+        }
+        if (this.pendingTeleportId == teleportId) {
+            this.pendingTeleportId = 0;
+            this.waitingForPositionSync = false;
+            if (teleportId > 0) {
+                this.serverSideTeleportConfirmed = true;
             }
-        } else {
-            this.serverSideTeleportConfirmed = true;
+        }
+        if (teleportId > 0 && this.authoritativeTeleportId == teleportId) {
+            this.authoritativeTeleportId = 0;
             if (!this.initiallySpawned) {
                 ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Received teleport confirm for teleport id " + teleportId + " but player is not spawned yet");
             }
diff --git a/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java b/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java
new file mode 100644
index 000000000..1f7414c32
--- /dev/null
+++ b/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java
@@ -0,0 +1,142 @@
