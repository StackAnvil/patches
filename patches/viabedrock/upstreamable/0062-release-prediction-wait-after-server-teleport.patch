+package com.enderdash.agent.viabedrock.entity;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerAuthInputData;
+import net.raphimc.viabedrock.protocol.data.enums.java.Relative;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ClientPlayerTeleportTest {
+
+    @Test
+    void authoritativeTeleportAcknowledgementReleasesSupersededPredictionWait() throws ReflectiveOperationException {
+        final ClientPlayerEntity player = player();
+        player.setInitiallySpawned();
+        player.setPosition(new Position3f(3F, 64F, 5F));
+        final var waiting = ClientPlayerEntity.class.getDeclaredField("waitingForPositionSync");
+        waiting.setAccessible(true);
+        // The chunk boundary guard has requested a local correction.
+        waiting.setBoolean(player, true);
+        final PacketWrapper prediction = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(prediction, Relative.ROTATION, true);
+        final int oldCorrection = prediction.get(Types.VAR_INT, 0);
+
+        // An authoritative teleport replaces that correction before its acknowledgement arrives.
+        final PacketWrapper teleport = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(teleport, Relative.NONE, false);
+        final int currentTeleport = teleport.get(Types.VAR_INT, 0);
+        player.confirmTeleport(oldCorrection);
+        assertTrue(waiting.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.confirmTeleport(currentTeleport + 1);
+        assertTrue(waiting.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.confirmTeleport(currentTeleport);
+
+        assertFalse(waiting.getBoolean(player));
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.authInputData().clear();
+        player.confirmTeleport(currentTeleport);
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+    }
+
+    @Test
+    void localCorrectionRequiresTheExactSignedAcknowledgement() throws ReflectiveOperationException {
+        final ClientPlayerEntity player = player();
+        player.setInitiallySpawned();
+        player.setPosition(new Position3f(3F, 64F, 5F));
+        final var waiting = ClientPlayerEntity.class.getDeclaredField("waitingForPositionSync");
+        waiting.setAccessible(true);
+        waiting.setBoolean(player, true);
+        final PacketWrapper correction = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(correction, Relative.ROTATION, true);
+        final int id = correction.get(Types.VAR_INT, 0);
+        assertTrue(id < 0);
+        player.confirmTeleport(-id);
+        player.confirmTeleport(0);
+        player.confirmTeleport(Integer.MIN_VALUE);
+        assertTrue(waiting.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.confirmTeleport(id);
+        assertFalse(waiting.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.confirmTeleport(-id);
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+    }
+
+    @Test
+    void localCorrectionDoesNotRetireTheLatestServerTeleportAcknowledgement() throws ReflectiveOperationException {
+        final ClientPlayerEntity player = player();
+        player.setInitiallySpawned();
+        player.setPosition(new Position3f(3F, 64F, 5F));
+        final var waiting = ClientPlayerEntity.class.getDeclaredField("waitingForPositionSync");
+        final var admitted = ClientPlayerEntity.class.getDeclaredField("serverSideTeleportConfirmed");
+        waiting.setAccessible(true);
+        admitted.setAccessible(true);
+        final PacketWrapper teleport = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(teleport, Relative.NONE, false);
+        final int serverId = teleport.get(Types.VAR_INT, 0);
+        waiting.setBoolean(player, true);
+        final PacketWrapper correction = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(correction, Relative.ROTATION, true);
+        final int correctionId = correction.get(Types.VAR_INT, 0);
+        player.confirmTeleport(serverId);
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        assertTrue(waiting.getBoolean(player));
+        assertFalse(admitted.getBoolean(player));
+        player.authInputData().clear();
+        player.confirmTeleport(serverId);
+        assertTrue(waiting.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+        player.confirmTeleport(correctionId);
+        assertFalse(waiting.getBoolean(player));
+        assertFalse(admitted.getBoolean(player));
+        assertFalse(player.authInputData().contains(PlayerAuthInputData.HandledTeleport));
+    }
+
+    @Test
+    void aNewCorrectionRetiresThePreviousTeleportPositionException() throws ReflectiveOperationException {
+        final ClientPlayerEntity player = player();
+        player.setInitiallySpawned();
+        player.setPosition(new Position3f(3F, 64F, 5F));
+        final var admitted = ClientPlayerEntity.class.getDeclaredField("serverSideTeleportConfirmed");
+        admitted.setAccessible(true);
+        final PacketWrapper teleport = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(teleport, Relative.NONE, false);
+        player.confirmTeleport(teleport.get(Types.VAR_INT, 0));
+        assertTrue(admitted.getBoolean(player));
+        final PacketWrapper correction = new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_POSITION, null, null);
+        player.writePlayerPositionPacketToClient(correction, Relative.ROTATION, true);
+        assertFalse(admitted.getBoolean(player));
+        player.confirmTeleport(correction.get(Types.VAR_INT, 0));
+        assertFalse(admitted.getBoolean(player));
+    }
+
+    private static ClientPlayerEntity player() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> null);
+        return new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+    }
+
+}
