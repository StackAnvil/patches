From c06551df1016fa318985700d502a24f8d818c64d Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 1 Oct 2026 12:08:02 +0200
Subject: [PATCH] fix(movement): release prediction wait after server teleport

A chunk boundary correction waits for its fake Java teleport acknowledgement. If a real server teleport supersedes that correction, the old acknowledgement no longer matches the pending ID. Previously the real acknowledgement admitted only one position packet and left the correction wait set forever, freezing subsequent server movement.

Clear the prediction wait when the current authoritative teleport is acknowledged. Preserve stale-ID protection and the HandledTeleport signal. The regression test covers a pending local correction replaced by a server teleport, stale acknowledgements, and the final matching acknowledgement.
---
 .../api/model/entity/ClientPlayerEntity.java  |  4 ++
 .../entity/ClientPlayerTeleportTest.java      | 65 +++++++++++++++++++
 2 files changed, 69 insertions(+)
 create mode 100644 src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
index 6347d81b..e634276b 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
@@ -224,6 +224,10 @@ public class ClientPlayerEntity extends PlayerEntity {
                 this.waitingForPositionSync = false;
             }
         } else {
+            if (this.pendingTeleportId == teleportId) {
+                this.pendingTeleportId = 0;
+                this.waitingForPositionSync = false;
+            }
             this.serverSideTeleportConfirmed = true;
             if (!this.initiallySpawned) {
                 ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Received teleport confirm for teleport id " + teleportId + " but player is not spawned yet");
diff --git a/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java b/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java
new file mode 100644
index 00000000..3ec25a29
--- /dev/null
+++ b/src/test/java/com/enderdash/agent/viabedrock/entity/ClientPlayerTeleportTest.java
@@ -0,0 +1,65 @@
