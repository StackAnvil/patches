+++ b/src/test/java/net/raphimc/viabedrock/protocol/ActorSwingPacketFactoryTest.java
@@ -0,0 +1,61 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol;
+
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.Unpooled;
+import java.util.Locale;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ActorSwingSource;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HandSlot;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ActorSwingPacketFactoryTest {
+
+    @Test
+    void matchesTheNativeProtocol2225AttackPayloadIncludingItsHand() throws Exception {
+        final var packet = new PacketWrapperImpl(0, null, null);
+        ActorSwingPacketFactory.writeSwing(packet, 77, ActorSwingSource.Attack, HandSlot.Mainhand);
+        final var bytes = Unpooled.buffer();
+        try {
+            packet.writeToBuffer(bytes);
+            assertEquals(0, Types.VAR_INT.readPrimitive(bytes));
+            final byte[] payload = new byte[bytes.readableBytes()];
+            bytes.readBytes(payload);
+            assertArrayEquals(new byte[]{1, 77, 0, 0, 0, 0, 1, 6, 97, 116, 116, 97, 99, 107, 0}, payload);
+        } finally {
+            bytes.release();
+        }
+    }
+
+    @Test
+    void keepsEachSwingSourceAndHandInsideItsPacketBoundary() throws Exception {
+        for (final ActorSwingSource source : ActorSwingSource.values()) {
+            for (final HandSlot hand : HandSlot.values()) {
+                final var packet = new PacketWrapperImpl(0, null, null);
+                ActorSwingPacketFactory.writeSwing(packet, 0x12345, source, hand);
+                final var bytes = Unpooled.buffer();
+                try {
+                    packet.writeToBuffer(bytes);
+                    bytes.writeInt(0x13579BDF);
+                    assertEquals(0, Types.VAR_INT.readPrimitive(bytes));
+                    assertEquals(1, bytes.readUnsignedByte());
+                    assertEquals(0x12345, BedrockTypes.UNSIGNED_VAR_LONG.read(bytes));
+                    assertEquals(0F, BedrockTypes.FLOAT_LE.read(bytes));
+                    assertEquals(source.name().toLowerCase(Locale.ROOT), BedrockTypes.OPTIONAL_STRING.read(bytes));
+                    assertEquals(hand.getValue(), bytes.readUnsignedByte());
+                    assertEquals(0x13579BDF, bytes.readInt());
+                    assertFalse(bytes.isReadable());
+                } finally {
+                    bytes.release();
+                }
+            }
+        }
+    }
+
+}
