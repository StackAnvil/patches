+package net.raphimc.viabedrock.protocol;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import java.util.Locale;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ActorSwingSource;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.AnimatePacketPayload_Action;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HandSlot;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** One wire layout for ordinary, attack, and predicted-use swings. */
+public final class ActorSwingPacketFactory {
+
+    private ActorSwingPacketFactory() {
+    }
+
+    public static void writeSwing(final PacketWrapper packet, final long runtimeId,
+                                  final ActorSwingSource source, final HandSlot hand) {
+        packet.write(Types.UNSIGNED_BYTE, (short) AnimatePacketPayload_Action.Swing.getValue());
+        packet.write(BedrockTypes.UNSIGNED_VAR_LONG, runtimeId);
+        packet.write(BedrockTypes.FLOAT_LE, 0F);
+        packet.write(BedrockTypes.OPTIONAL_STRING, source.name().toLowerCase(Locale.ROOT));
+        packet.write(Types.UNSIGNED_BYTE, (short) hand.getValue());
+    }
+
+    public static void sendSwing(final UserConnection user, final long runtimeId,
+                                 final ActorSwingSource source, final HandSlot hand) {
+        final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.ANIMATE, user);
+        writeSwing(packet, runtimeId, source, hand);
+        packet.sendToServer(BedrockProtocol.class);
+    }
+
+}
