+import static org.junit.jupiter.api.Assertions.*;
+
+class StartGameServerConfigurationTest {
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void optionalPresenceLeavesTheFollowingTelemetryFieldsAligned(final boolean presence) {
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            buffer.writeBoolean(true); // server configuration
+            buffer.writeBoolean(false); // gathering
+            buffer.writeBoolean(false); // store entry point
+            buffer.writeBoolean(presence);
+            if (presence) {
+                BedrockTypes.STRING.write(buffer, "override");
+            }
+            final String[] telemetry = {"server", "scenario", "world", "owner"};
+            for (final String field : telemetry) {
+                BedrockTypes.STRING.write(buffer, field);
+            }
+
+            final var wrapper = new PacketWrapperImpl(ClientboundBedrockPackets.START_GAME, buffer, null);
+            JoinPackets.readServerConfiguration(wrapper);
+            for (final String field : telemetry) {
+                assertEquals(field, wrapper.read(BedrockTypes.STRING));
+            }
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
