+package net.raphimc.viabedrock.api.model.container.player;
+
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class HudContainerTest {
+
+    @Test
+    void acceptsTheCompleteProtocol2225InventoryAndRetainsEverySlot() {
+        final var container = new HudContainer(null);
+        final BedrockItem[] items = BedrockItem.emptyArray(57);
+        for (final int slot : new int[]{0, 28, 29, 30, 31, 50, 54, 55, 56}) {
+            items[slot] = new BedrockItem(slot + 1, (short) 0, (byte) 3);
+        }
+        assertTrue(container.setItems(items));
+        for (int slot = 0; slot < items.length; slot++) {
+            assertSame(items[slot], container.getItem(slot));
+        }
+        for (int slot = 28; slot <= 31; slot++) {
+            assertEquals(slot - 27, container.javaSlot(slot));
+        }
+        final var replacement = new BedrockItem(42);
+        container.setItem(56, replacement);
+        assertSame(replacement, container.getItem(56));
+    }
+
+}
