+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import java.awt.image.BufferedImage;
+
+/**
+ * Decodes TGA textures with the rules of the stb_image loader in the native client: true-color, grayscale and
+ * color-mapped images, each optionally run-length encoded.
+ */
+final class TgaImage {
+
+    private static final int HEADER_SIZE = 18;
+
+    private TgaImage() {
+    }
+
+    static BufferedImage read(final byte[] data) {
+        if (data.length < HEADER_SIZE) {
+            throw new IllegalArgumentException("Truncated TGA header");
+        }
+        final int colorMapType = unsigned(data[1]);
+        final int imageType = unsigned(data[2]);
+        final boolean runLengthEncoded = imageType >= 8;
+        final int baseType = imageType & 7;
+        if ((imageType & ~11) != 0 || baseType == 0 || colorMapType != (baseType == 1 ? 1 : 0)) {
+            throw new IllegalArgumentException("Unsupported TGA image type or color map");
+        }
+        final boolean indexed = baseType == 1;
+        final boolean grey = baseType == 3;
+        final int width = word(data, 12);
+        final int height = word(data, 14);
+        final int bitsPerPixel = unsigned(data[16]);
+        if (width == 0 || height == 0
+            || !(indexed ? bitsPerPixel == 8 || bitsPerPixel == 16 : supportedDepth(bitsPerPixel, grey))) {
+            throw new IllegalArgumentException("Unsupported TGA dimensions or pixel depth");
+        }
+        // A few run-length packets can declare the largest 65535 x 65535 image.
+        ImageDecodingLimit.require(width, height);
+        final int descriptor = unsigned(data[17]);
+        if ((descriptor & 0xC0) != 0) {
+            throw new IllegalArgumentException("Unsupported TGA interleaving");
+        }
+        final Cursor cursor = new Cursor(data, HEADER_SIZE + unsigned(data[0]));
+        int[] palette = null;
+        if (indexed) {
+            final int paletteBits = unsigned(data[7]);
+            final int paletteLength = word(data, 5);
+            if (paletteLength == 0 || !supportedDepth(paletteBits, false)) {
+                throw new IllegalArgumentException("Unsupported TGA palette");
+            }
+            // stb_image skips the first-entry field as bytes and indexes the stored entries from zero.
+            cursor.skip(word(data, 3));
+            palette = new int[paletteLength];
+            for (int i = 0; i < paletteLength; i++) {
+                palette[i] = color(cursor, paletteBits, false);
+            }
+        }
+        final boolean rightOrigin = (descriptor & 0x10) != 0;
+        final boolean topOrigin = (descriptor & 0x20) != 0;
+        final int pixelCount = width * height;
+        final BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        int index = 0;
+        while (index < pixelCount) {
+            final int packet = runLengthEncoded ? cursor.read() : 0;
+            final int count = runLengthEncoded ? (packet & 0x7F) + 1 : 1;
+            if (count > pixelCount - index) {
+                throw new IllegalArgumentException("TGA packet exceeds image bounds");
+            }
+            final boolean repeated = runLengthEncoded && (packet & 0x80) != 0;
+            final int repeatedColor = repeated ? pixel(cursor, bitsPerPixel, grey, palette) : 0;
+            for (int i = 0; i < count; i++, index++) {
+                final int color = repeated ? repeatedColor : pixel(cursor, bitsPerPixel, grey, palette);
+                final int x = rightOrigin ? width - 1 - index % width : index % width;
+                final int y = topOrigin ? index / width : height - 1 - index / width;
+                image.setRGB(x, y, color);
+            }
+        }
+        return image;
+    }
+
+    private static boolean supportedDepth(final int bits, final boolean grey) {
+        return grey ? bits == 8 || bits == 16 : bits == 8 || bits == 15 || bits == 16 || bits == 24 || bits == 32;
+    }
+
+    private static int pixel(final Cursor cursor, final int bits, final boolean grey, final int[] palette) {
+        if (palette == null) {
+            return color(cursor, bits, grey);
+        }
+        final int entry = bits == 8 ? cursor.read() : cursor.read() | cursor.read() << 8;
+        // stb_image substitutes the first entry for an index outside the palette.
+        return palette[entry < palette.length ? entry : 0];
+    }
+
+    private static int color(final Cursor cursor, final int bits, final boolean grey) {
+        if (bits == 8) {
+            return 0xFF000000 | cursor.read() * 0x010101;
+        }
+        if (bits == 16 && grey) {
+            final int value = cursor.read();
+            return cursor.read() << 24 | value * 0x010101;
+        }
+        if (bits == 15 || bits == 16) {
+            // 5-5-5 color; stb_image ignores the top bit and keeps the pixel opaque.
+            final int value = cursor.read() | cursor.read() << 8;
+            return 0xFF000000 | scale5(value >> 10) << 16 | scale5(value >> 5) << 8 | scale5(value);
+        }
+        final int blue = cursor.read();
+        final int green = cursor.read();
+        final int red = cursor.read();
+        final int alpha = bits == 32 ? cursor.read() : 255;
+        return alpha << 24 | red << 16 | green << 8 | blue;
+    }
+
+    private static int scale5(final int value) {
+        return (value & 31) * 255 / 31;
+    }
+
+    private static int word(final byte[] data, final int index) {
+        return unsigned(data[index]) | unsigned(data[index + 1]) << 8;
+    }
+
+    private static int unsigned(final byte value) {
+        return Byte.toUnsignedInt(value);
+    }
+
+    private static final class Cursor {
+        private final byte[] data;
+        private int offset;
+
+        private Cursor(final byte[] data, final int offset) {
+            this.data = data;
+            this.offset = offset;
+        }
+
+        private int read() {
+            if (this.offset >= this.data.length) {
+                throw new IllegalArgumentException("Truncated TGA pixel data");
+            }
+            return unsigned(this.data[this.offset++]);
+        }
+
+        private void skip(final int count) {
+            if (count > this.data.length - this.offset) {
+                throw new IllegalArgumentException("Truncated TGA color map");
+            }
+            this.offset += count;
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/TgaContentTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/TgaContentTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..8341d8a2377654d4886dd2c2f7fecc0100cf4b38
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/TgaContentTest.java
@@ -0,0 +1,117 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import org.junit.jupiter.api.Test;
+
+import javax.imageio.ImageIO;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class TgaContentTest {
+
+    @Test
+    void decodesTopOriginTrueColorWithAlphaAndConvertsToPng() throws Exception {
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/example.tga", tga(2, 2, 32, 0x28, 2,
+            0, 0, 255, 128, 0, 255, 0, 255,
+            255, 0, 0, 64, 255, 255, 255, 0));
+
+        final Content.LazyImage texture = content.getShortnameImage("textures/entity/example");
+        assertNotNull(texture);
+        final BufferedImage image = texture.getImage();
+        assertEquals(0x80FF0000, image.getRGB(0, 0));
+        assertEquals(0xFF00FF00, image.getRGB(1, 0));
+        assertEquals(0x400000FF, image.getRGB(0, 1));
+        assertEquals(0x00FFFFFF, image.getRGB(1, 1));
+        assertEquals(0x80FF0000, ImageIO.read(new ByteArrayInputStream(texture.getPngBytes())).getRGB(0, 0));
+    }
+
+    @Test
+    void decodesBottomOriginRunLengthPackets() {
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/example.tga", tga(2, 2, 24, 0, 10,
+            0x81, 255, 0, 0,           // two blue pixels on the bottom row
+            0x01, 0, 255, 0, 0, 0, 255)); // green and red on the top row
+
+        final BufferedImage image = content.getShortnameImage("textures/entity/example").getImage();
+        assertEquals(0xFF00FF00, image.getRGB(0, 0));
+        assertEquals(0xFFFF0000, image.getRGB(1, 0));
+        assertEquals(0xFF0000FF, image.getRGB(0, 1));
+        assertEquals(0xFF0000FF, image.getRGB(1, 1));
+    }
+
+    @Test
+    void decodesRunLengthColorMappedPixelsThroughTheirPalette() {
+        // Lifeboat's vehicle textures: image type 9, 8-bit indices into a 24-bit palette.
+        final byte[] header = tga(2, 2, 8, 0x20, 9,
+            0, 0, 255, 0, 255, 0, // palette: red, green (BGR)
+            0x81, 1,             // two green pixels on the top row
+            0x01, 0, 7);         // red, then an out-of-range index that falls back to entry zero
+        header[1] = 1;
+        header[5] = 2;
+        header[7] = 24;
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/example.tga", header);
+
+        final BufferedImage image = content.getShortnameImage("textures/entity/example").getImage();
+        assertEquals(0xFF00FF00, image.getRGB(0, 0));
+        assertEquals(0xFF00FF00, image.getRGB(1, 0));
+        assertEquals(0xFFFF0000, image.getRGB(0, 1));
+        assertEquals(0xFFFF0000, image.getRGB(1, 1));
+    }
+
+    @Test
+    void decodesGreyscaleWithAndWithoutAlpha() {
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/grey.tga", tga(2, 1, 8, 0x20, 3, 0x40, 0xFF));
+        content.put("textures/entity/grey_alpha.tga", tga(1, 1, 16, 0x20, 3, 0x80, 0x10));
+
+        final BufferedImage grey = content.getShortnameImage("textures/entity/grey").getImage();
+        assertEquals(0xFF404040, grey.getRGB(0, 0));
+        assertEquals(0xFFFFFFFF, grey.getRGB(1, 0));
+        assertEquals(0x10808080, content.getShortnameImage("textures/entity/grey_alpha").getImage().getRGB(0, 0));
+    }
+
+    @Test
+    void rejectsTruncatedPixelData() {
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/example.tga", tga(2, 2, 32, 0x28, 2, 0, 0, 255, 255));
+
+        final Content.LazyImage texture = content.getShortnameImage("textures/entity/example");
+        assertNotNull(texture);
+        assertThrows(IllegalArgumentException.class, texture::getImage);
+    }
+
+    @Test
+    void rejectsTheLargestTgaDimensionsBeforeAllocatingPixels() {
+        final InMemoryContent content = new InMemoryContent();
+        content.put("textures/entity/example.tga", tga(65535, 65535, 32, 0x28, 10, 0xFF, 0, 0, 255, 255));
+
+        final IllegalArgumentException rejected = assertThrows(IllegalArgumentException.class,
+                content.getShortnameImage("textures/entity/example")::getImage);
+        assertEquals("Image dimensions 65535x65535 exceed the decoding limit", rejected.getMessage());
+    }
+
+    private static byte[] tga(final int width, final int height, final int bitsPerPixel,
+                              final int imageDescriptor, final int imageType, final int... pixels) {
+        final byte[] bytes = new byte[18 + pixels.length];
+        bytes[2] = (byte) imageType;
+        bytes[12] = (byte) width;
+        bytes[13] = (byte) (width >>> 8);
+        bytes[14] = (byte) height;
+        bytes[15] = (byte) (height >>> 8);
+        bytes[16] = (byte) bitsPerPixel;
+        bytes[17] = (byte) imageDescriptor;
+        for (int i = 0; i < pixels.length; i++) {
+            bytes[18 + i] = (byte) pixels[i];
+        }
+        return bytes;
+    }
+
+}
