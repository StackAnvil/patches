--- a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java
@@ -119,7 +119,7 @@ public abstract class Content {
     }
 
     public LazyImage getShortnameImage(final String path) {
-        final String fullPath = this.getFullPath(path, "png", "jpg");
+        final String fullPath = this.getFullPath(path, "png", "jpg", "tga");
         return fullPath == null ? null : this.getImage(fullPath);
     }
 
@@ -131,11 +131,12 @@ public abstract class Content {
 
         final boolean isPng = bytes.length > 8 && bytes[0] == (byte) 0x89 && bytes[1] == (byte) 0x50 && bytes[2] == (byte) 0x4E && bytes[3] == (byte) 0x47 && bytes[4] == (byte) 0x0D && bytes[5] == (byte) 0x0A && bytes[6] == (byte) 0x1A && bytes[7] == (byte) 0x0A;
         final boolean isJpg = bytes.length > 2 && bytes[0] == (byte) 0xFF && bytes[1] == (byte) 0xD8 && bytes[2] == (byte) 0xFF;
-        if (!isPng && !isJpg) {
+        final boolean isTga = path.endsWith(".tga");
+        if (!isPng && !isJpg && !isTga) {
             return null;
         }
 
-        return new LazyImage(bytes, isPng ? "png" : "jpg");
+        return new LazyImage(bytes, isPng ? "png" : isJpg ? "jpg" : "tga");
     }
 
     public boolean putPngImage(final String path, final LazyImage image) {
@@ -186,6 +187,10 @@ public abstract class Content {
 
         public BufferedImage getImage() {
             if (this.image == null) {
+                if (this.format.equals("tga")) {
+                    this.image = TgaImage.read(this.bytes);
+                    return this.image;
+                }
                 try {
                     this.image = ImageIO.read(new ByteArrayInputStream(this.bytes));
                 } catch (final IOException e) {
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/TgaImage.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/TgaImage.java
new file mode 100644
index 000000000..66f6d8436
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/TgaImage.java
@@ -0,0 +1,97 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
