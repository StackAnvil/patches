From f10cda1eb2b4a085a0f912ff82cec54e930f1c3d Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:03:50 +0200
Subject: [PATCH] fix(blocks): preserve hanging mangrove propagule growth

Bedrock propagule_stage and Java hanging age both run from zero to four. Keep the stage when translating hanging propagules so Java selects the matching growth model instead of always showing the youngest one.
---
 .../viabedrock/data/custom/blockstate_mappings.json       | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/main/resources/assets/viabedrock/data/custom/blockstate_mappings.json b/src/main/resources/assets/viabedrock/data/custom/blockstate_mappings.json
index 2ce2d4a0..6e35aa1c 100644
--- a/src/main/resources/assets/viabedrock/data/custom/blockstate_mappings.json
+++ b/src/main/resources/assets/viabedrock/data/custom/blockstate_mappings.json
@@ -11065,10 +11065,10 @@
   "minecraft:mangrove_propagule[hanging=0,propagule_stage=3]": "minecraft:mangrove_propagule[age=0,hanging=false,stage=1,waterlogged=false]",
   "minecraft:mangrove_propagule[hanging=0,propagule_stage=4]": "minecraft:mangrove_propagule[age=0,hanging=false,stage=1,waterlogged=false]",
   "minecraft:mangrove_propagule[hanging=1,propagule_stage=0]": "minecraft:mangrove_propagule[age=0,hanging=true,stage=0,waterlogged=false]",
-  "minecraft:mangrove_propagule[hanging=1,propagule_stage=1]": "minecraft:mangrove_propagule[age=0,hanging=true,stage=1,waterlogged=false]",
-  "minecraft:mangrove_propagule[hanging=1,propagule_stage=2]": "minecraft:mangrove_propagule[age=0,hanging=true,stage=1,waterlogged=false]",
-  "minecraft:mangrove_propagule[hanging=1,propagule_stage=3]": "minecraft:mangrove_propagule[age=0,hanging=true,stage=1,waterlogged=false]",
-  "minecraft:mangrove_propagule[hanging=1,propagule_stage=4]": "minecraft:mangrove_propagule[age=0,hanging=true,stage=1,waterlogged=false]",
+  "minecraft:mangrove_propagule[hanging=1,propagule_stage=1]": "minecraft:mangrove_propagule[age=1,hanging=true,stage=1,waterlogged=false]",
+  "minecraft:mangrove_propagule[hanging=1,propagule_stage=2]": "minecraft:mangrove_propagule[age=2,hanging=true,stage=1,waterlogged=false]",
+  "minecraft:mangrove_propagule[hanging=1,propagule_stage=3]": "minecraft:mangrove_propagule[age=3,hanging=true,stage=1,waterlogged=false]",
+  "minecraft:mangrove_propagule[hanging=1,propagule_stage=4]": "minecraft:mangrove_propagule[age=4,hanging=true,stage=1,waterlogged=false]",
   "minecraft:mangrove_roots": "minecraft:mangrove_roots[waterlogged=false]",
   "minecraft:mangrove_shelf[minecraft:cardinal_direction=east,powered_bit=0,powered_shelf_type=0]": "minecraft:mangrove_shelf[facing=east,powered=false,side_chain=unconnected,waterlogged=false]",
   "minecraft:mangrove_shelf[minecraft:cardinal_direction=east,powered_bit=0,powered_shelf_type=1]": "minecraft:mangrove_shelf[facing=east,powered=false,side_chain=right,waterlogged=false]",
-- 
