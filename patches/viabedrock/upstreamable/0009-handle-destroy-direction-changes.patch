+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.protocol.data.enums.Direction;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.PlayerActionType;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ClientPlayerPacketsTest {
+
+    @Test
+    void changingDestroyFaceUpdatesActiveMiningAndForwardsServerAuthoritativeInput() {
+        final ClientPlayerEntity player = player();
+        final BlockPosition position = new BlockPosition(3, 64, 5);
+        player.setBlockBreakingInfo(new ClientPlayerEntity.BlockBreakingInfo(position, Direction.NORTH));
+
+        ClientPlayerPackets.updateDestroyDirection(player, position, Direction.EAST, true);
+
+        assertEquals(Direction.EAST, player.blockBreakingInfo().direction());
+        assertEquals(1, player.authInputBlockActions().size());
+        final ClientPlayerEntity.AuthInputBlockAction action = player.authInputBlockActions().get(0);
+        assertEquals(PlayerActionType.ContinueDestroyBlock, action.action());
+        assertEquals(position, action.position());
+        assertEquals(Direction.EAST.ordinal(), action.direction());
+    }
+
+    @Test
+    void changingDestroyFaceKeepsClientAuthoritativeMiningForNextSwing() {
+        final ClientPlayerEntity player = player();
+        final BlockPosition position = new BlockPosition(3, 64, 5);
+        player.setBlockBreakingInfo(new ClientPlayerEntity.BlockBreakingInfo(position, Direction.NORTH));
+
+        ClientPlayerPackets.updateDestroyDirection(player, position, Direction.EAST, false);
+
+        assertEquals(Direction.EAST, player.blockBreakingInfo().direction());
+        assertTrue(player.authInputBlockActions().isEmpty());
+    }
+
+    @Test
+    void staleDestroyFaceDoesNotStartAnotherBlock() {
+        final ClientPlayerEntity player = player();
+        final BlockPosition position = new BlockPosition(3, 64, 5);
+        player.setBlockBreakingInfo(new ClientPlayerEntity.BlockBreakingInfo(position, Direction.NORTH));
+
+        ClientPlayerPackets.updateDestroyDirection(player, new BlockPosition(4, 64, 5), Direction.EAST, true);
+
+        assertEquals(Direction.NORTH, player.blockBreakingInfo().direction());
+        assertTrue(player.authInputBlockActions().isEmpty());
+    }
+
+    private static ClientPlayerEntity player() {
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> null);
+        return new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+    }
+
+}
