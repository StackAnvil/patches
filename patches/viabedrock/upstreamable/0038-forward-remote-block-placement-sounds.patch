From 273abf2b676569c7a910e1c02683fcd8f793d538 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 11:41:44 +0200
Subject: [PATCH] fix(sound): forward remote block placement sounds

Java predicts its own block item placement sound, but the previous unconditional Bedrock place cancellation also removed sounds from other players. Record a short-lived local placement position for block items and consume only a matching echo. Other place events now use the existing block sound mapping. Remove obsolete sound fallback comments while updating this path.
---
 .../protocol/packet/InteractionPackets.java       |  7 +++++++
 .../protocol/packet/WorldEffectPackets.java       | 15 ---------------
 .../storage/BlockInteractionSoundTracker.java     | 12 ++++++++++--
 .../storage/BlockInteractionSoundTrackerTest.java | 12 ++++++++++++
 4 files changed, 29 insertions(+), 17 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
index 54f8220a..c1fbdad3 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
@@ -314,6 +314,13 @@ public final class InteractionPackets {
                         BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(chunkTracker.getJavaBlockState(position)));
             }
             final BlockPosition placedPosition = insideBlock ? position : position.getRelative(direction.blockFace());
+            final InventoryTracker inventoryTracker = wrapper.user().get(InventoryTracker.class);
+            final BedrockItem usedItem = hand == InteractionHand.MAIN_HAND
+                    ? inventoryTracker.getInventoryContainer().getSelectedHotbarItem()
+                    : inventoryTracker.getOffhandContainer().getItem(0);
+            if (usedItem.blockRuntimeId() != 0) {
+                wrapper.user().get(BlockInteractionSoundTracker.class).recordPlacement(placedPosition);
+            }
             chunkTracker.trackBlockPrediction(sequence, position, placedPosition);
             sendUseItemOnBlock(wrapper.user(), hand, position, faceInt, clickPosition, insideBlock);
         });
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
