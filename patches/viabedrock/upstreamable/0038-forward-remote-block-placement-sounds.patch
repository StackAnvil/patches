+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
@@ -229,23 +229,8 @@ public final class WorldEffectPackets {
                     final float pitch = (float) Math.pow(2D, (double) (key - 12) / 12);
                     configuredSound = new SoundDefinitions.ConfiguredSound(noteBlockSound, 1F, 1F, pitch, pitch);
                 }
-                case "place" -> {
-                    // TODO: Mixin in VFP and a setting, Block place sounds are sent by the server
-                    wrapper.cancel();
-                    return;
-                }
-                // TODO: I suspect block break sounds are sent by the server as well
                 default -> {
                     configuredSound = tryFindSound(wrapper.user(), soundEvent, data, entityIdentifier, isBabyMob);
-                    if (configuredSound == null) { // Fallback for some special handled sounds
-                        /*switch (soundEvent) {
-                         *     case AmbientBaby, MobWarningBaby, HurtBaby, DeathBaby, StepBaby -> {
-                         *         final SharedTypes_Legacy_LevelSoundEvent soundEventAdult = EnumUtil.getEnumConstantOrNull(SharedTypes_Legacy_LevelSoundEvent.class, soundEvent.name().replace("Baby", ""));
-                         *         configuredSound = tryFindSound(wrapper.user(), soundEventAdult, data, entityIdentifier, true);
-                         *     }
-                         *     case AmbientInWater, AmbientInAir -> configuredSound = tryFindSound(wrapper.user(), SharedTypes_Legacy_LevelSoundEvent.Ambient, data, entityIdentifier, isBabyMob);
-                         * }*/
-                    }
                     if (configuredSound == null) {
                         if (LEVEL_SOUND_DEBUG_LOG) {
                             ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Missing level sound event mapping for " + soundEvent + " with entity identifier '" + entityIdentifier + "' and data " + data);
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
index d96c519b..9a8bbbd1 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTracker.java
@@ -56,13 +56,21 @@ public final class BlockInteractionSoundTracker implements StorableObject {
             return;
         }
 
+        final int lowerY = state.hasProperty("half", "upper") ? position.y() - 1 : position.y();
+        this.record(new BlockPosition(position.x(), lowerY, position.z()), event);
+    }
+
+    public void recordPlacement(final BlockPosition position) {
+        this.record(position, "place");
+    }
+
+    private void record(final BlockPosition position, final String event) {
         final long now = this.clock.getAsLong();
         this.removeExpired(now);
         if (this.pending.size() == MAX_PENDING) {
             this.pending.removeFirst();
         }
-        final int lowerY = state.hasProperty("half", "upper") ? position.y() - 1 : position.y();
-        this.pending.addLast(new PendingSound(position.x(), lowerY, position.z(), event, now));
+        this.pending.addLast(new PendingSound(position.x(), position.y(), position.z(), event, now));
     }
 
     private static String toggledEvent(final String prefix, final BlockState state) {
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
index 4a83e00e..ca342e54 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/BlockInteractionSoundTrackerTest.java
@@ -68,4 +68,16 @@ class BlockInteractionSoundTrackerTest {
         assertFalse(tracker.consumeLocallyPlayed("chest.open", soundPosition));
     }
 
+    @Test
+    void consumesOnlyTheLocalPlacementEchoAtThePlacedBlock() {
+        final BlockInteractionSoundTracker tracker = new BlockInteractionSoundTracker();
+        final BlockPosition placed = new BlockPosition(10, 64, 20);
+        tracker.recordPlacement(placed);
+
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(11.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("break", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertTrue(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+        assertFalse(tracker.consumeLocallyPlayed("place", new Position3f(10.5F, 64.5F, 20.5F)));
+    }
+
 }
