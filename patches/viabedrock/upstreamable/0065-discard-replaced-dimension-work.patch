From 19a8c6bcdd18e5a9773c76f17470e370ee9f6ad3 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 1 Oct 2026 16:22:35 +0200
Subject: [PATCH] fix(chunks): discard work from replaced dimension trackers

Minehut can replace an End chunk tracker with an Overworld tracker while a
previous tracker tick or light result is already queued on the event loop.
Reject callbacks whose tracker no longer owns the connection, preventing
16-section data from reaching the new 24-section dimension. The failure
is reproducible from the saved scene without another public connection.
---
 .../net/raphimc/viabedrock/protocol/storage/ChunkTracker.java  | 2 +-
 .../raphimc/viabedrock/protocol/task/ChunkTrackerTickTask.java | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
index 08c16ca56..6d49991f0 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
@@ -981,7 +981,7 @@ public class ChunkTracker extends StoredObject {
             final Throwable error = failure;
             this.user().getChannel().eventLoop().execute(() -> {
                 this.pendingLightComputations.remove(chunkKey);
-                if (!this.user().getChannel().isActive()) {
+                if (!this.user().getChannel().isActive() || this.user().get(ChunkTracker.class) != this) {
                     return;
                 }
                 if (error != null) {
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/task/ChunkTrackerTickTask.java b/src/main/java/net/raphimc/viabedrock/protocol/task/ChunkTrackerTickTask.java
index fe5c0a709..e35cc7104 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/task/ChunkTrackerTickTask.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/task/ChunkTrackerTickTask.java
@@ -30,7 +30,8 @@ public class ChunkTrackerTickTask implements Runnable {
             final ChunkTracker chunkTracker = info.get(ChunkTracker.class);
             if (chunkTracker != null) {
                 info.getChannel().eventLoop().submit(() -> {
-                    if (!info.getChannel().isActive()) {
+                    // A dimension change can replace this tracker while its tick is queued.
+                    if (!info.getChannel().isActive() || info.get(ChunkTracker.class) != chunkTracker) {
                         return;
                     }
 
