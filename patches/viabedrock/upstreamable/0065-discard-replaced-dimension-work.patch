+package net.raphimc.viabedrock.protocol.task;
+
+import com.viaversion.viaversion.api.Via;
+import com.viaversion.viaversion.api.ViaManager;
+import com.viaversion.viaversion.api.connection.ConnectionManager;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import io.netty.channel.Channel;
+import io.netty.channel.EventLoop;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayDeque;
+import java.util.Queue;
+import java.util.Set;
+import java.util.concurrent.RejectedExecutionException;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ChunkTrackerTickTaskTest {
+
+    @Test
+    void coalescesStalledTicksAndReleasesReplacedTrackers() {
+        final UserConnection user = mock(UserConnection.class);
+        final Channel channel = mock(Channel.class);
+        final EventLoop loop = mock(EventLoop.class);
+        final ViaManager manager = mock(ViaManager.class);
+        final ConnectionManager connections = mock(ConnectionManager.class);
+        final ChunkTracker first = mock(ChunkTracker.class);
+        final ChunkTracker replacement = mock(ChunkTracker.class);
+        final Queue<Runnable> pending = new ArrayDeque<>();
+        when(user.getChannel()).thenReturn(channel);
+        when(channel.eventLoop()).thenReturn(loop);
+        when(channel.isActive()).thenReturn(true);
+        when(user.get(ChunkTracker.class)).thenReturn(first);
+        when(manager.getConnectionManager()).thenReturn(connections);
+        when(connections.getConnections()).thenReturn(Set.of(user));
+        doAnswer(call -> {
+            pending.add(call.getArgument(0));
+            return null;
+        }).when(loop).execute(any(Runnable.class));
+        try (var via = mockStatic(Via.class)) {
+            via.when(Via::getManager).thenReturn(manager);
+            final ChunkTrackerTickTask task = new ChunkTrackerTickTask();
+            for (int tick = 0; tick < 1000; tick++) {
+                task.run();
+            }
+            assertEquals(1, pending.size());
+            pending.remove().run();
+            verify(first).tick();
+            task.run();
+            when(user.get(ChunkTracker.class)).thenReturn(replacement);
+            task.run();
+            assertEquals(2, pending.size());
+            pending.remove().run();
+            verify(first, times(1)).tick();
+            pending.remove().run();
+            verify(replacement).tick();
+            task.run();
+            assertEquals(1, pending.size());
+            when(channel.isActive()).thenReturn(false);
+            pending.remove().run();
+            verify(replacement, times(1)).tick();
+        }
+    }
+
+    @Test
+    void rejectedSubmissionDoesNotSuppressLaterTicks() {
+        final UserConnection user = mock(UserConnection.class);
+        final Channel channel = mock(Channel.class);
+        final EventLoop loop = mock(EventLoop.class);
+        final ViaManager manager = mock(ViaManager.class);
+        final ConnectionManager connections = mock(ConnectionManager.class);
+        when(user.getChannel()).thenReturn(channel);
+        when(channel.eventLoop()).thenReturn(loop);
+        when(user.get(ChunkTracker.class)).thenReturn(mock(ChunkTracker.class));
+        when(manager.getConnectionManager()).thenReturn(connections);
+        when(connections.getConnections()).thenReturn(Set.of(user));
+        doThrow(new RejectedExecutionException()).doNothing().when(loop).execute(any(Runnable.class));
+        try (var via = mockStatic(Via.class)) {
+            via.when(Via::getManager).thenReturn(manager);
+            final ChunkTrackerTickTask task = new ChunkTrackerTickTask();
+            assertDoesNotThrow(task::run);
+            assertDoesNotThrow(task::run);
+            verify(loop, times(2)).execute(any(Runnable.class));
+        }
+    }
+
+}
