+public final class NativeEffectsResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> archive(NativeActorLibrary.PATH, () -> NativeActorLibrary.encode(storage.getPackStackBottomToTop(), storage::isServerPack)));
+    }
+
+    private static Content archive(final String path, final Encoder encoder) {
+        final Content result = new InMemoryContent();
+        try {
+            result.putStored(path, encoder.encode());
+        } catch (final IOException invalid) {
+            throw new UncheckedIOException(invalid);
+        }
+        return result;
+    }
+
+    @FunctionalInterface
+    private interface Encoder {
+        byte[] encode() throws IOException;
+    }
+
+}
