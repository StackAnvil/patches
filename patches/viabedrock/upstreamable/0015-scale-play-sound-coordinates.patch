@@ -0,0 +1,76 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.PlaySound;
+import net.raphimc.viabedrock.protocol.model.SoundUpdate;
+
+/** Ordered server audio commands for a client with native playback support. */
+public sealed interface SoundPlaybackMessage permits SoundPlaybackMessage.Play, SoundPlaybackMessage.Update, SoundPlaybackMessage.Stop {
+
+    String CHANNEL = "viabedrock:sound_playback";
+    Type<SoundPlaybackMessage> TYPE = new Type<>(SoundPlaybackMessage.class) {
+        @Override
+        public SoundPlaybackMessage read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported sound playback message");
+            }
+            return switch (buffer.readUnsignedByte()) {
+                case 0 -> new Play(PlaySound.TYPE.read(buffer), Types.STRING.read(buffer), Types.VAR_INT.readPrimitive(buffer));
+                case 1 -> new Update(buffer.readLongLE(), SoundUpdate.readEvent(buffer));
+                case 2 -> new Stop(Types.STRING.read(buffer), buffer.readBoolean(), buffer.readBoolean());
+                default -> throw new IllegalArgumentException("Unknown sound playback message");
+            };
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final SoundPlaybackMessage value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(value.kind());
+            if (value instanceof Play play) {
+                PlaySound.TYPE.write(buffer, play.sound);
+                Types.STRING.write(buffer, play.fallback);
+                Types.VAR_INT.writePrimitive(buffer, play.category);
+            } else if (value instanceof Update update) {
+                buffer.writeLongLE(update.handle);
+                SoundUpdate.writeEvent(buffer, update.event);
+            } else if (value instanceof Stop stop) {
+                Types.STRING.write(buffer, stop.name);
+                buffer.writeBoolean(stop.all).writeBoolean(stop.music);
+            }
+        }
+    };
+
+    int kind();
+
+    record Play(PlaySound sound, String fallback, int category) implements SoundPlaybackMessage {
+        @Override
+        public int kind() {
+            return 0;
+        }
+    }
+
+    record Update(long handle, SoundUpdate.Event event) implements SoundPlaybackMessage {
+        @Override
+        public int kind() {
+            return 1;
+        }
+    }
+
+    record Stop(String name, boolean all, boolean music) implements SoundPlaybackMessage {
+        @Override
+        public int kind() {
+            return 2;
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java
new file mode 100644
index 000000000..7448e5169
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java
@@ -0,0 +1,136 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import org.apache.commons.io.output.UnsynchronizedByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Predicate;
+
+/** Native actor resources in resolved pack order, including their server or built-in provenance. */
+public final class NativeActorLibrary {
+
+    public static final String PATH = "assets/viabedrock/actor_library.bin";
+    private static final int MAX_PACKS = 4096;
+    private static final List<String> ROOT_PATHS = List.of("manifest.json", "pack_manifest.json", "sounds.json");
+    private static final List<String> EXTENSIONS = List.of(".json", ".material", ".png", ".tga", ".jpg", ".ogg", ".fsb", ".wav", ".lang");
+
+    public static byte[] encode(final Collection<ResourcePack> bottomToTop, final Predicate<ResourcePack> server) throws IOException {
+        final List<ResourcePack> packs = List.copyOf(bottomToTop);
+        if (packs.size() > MAX_PACKS) {
+            throw new IOException("Too many native actor packs");
+        }
+        final var bytes = UnsynchronizedByteArrayOutputStream.builder().get();
+        try (DataOutputStream fields = new DataOutputStream(bytes)) {
+            fields.writeInt(1);
+            fields.writeInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            fields.writeInt(packs.size());
+            for (final ResourcePack pack : packs) {
+                fields.writeByte(server.test(pack) ? 1 : 0);
+            }
+            NativeResourceArchive.write(packs.stream().map(ResourcePack::content).toList(),
+                    NativeActorLibrary::resource, ROOT_PATHS, EXTENSIONS, fields);
+        }
+        return bytes.toByteArray();
+    }
+
+    /** Selects the same bounded resources as encoding, without compressing them for local consumers. */
+    public static List<Layer> resources(final Collection<ResourcePack> bottomToTop, final Predicate<ResourcePack> server) throws IOException {
+        final List<ResourcePack> packs = List.copyOf(bottomToTop);
+        final List<Map<String, byte[]>> selected = NativeResourceArchive.select(packs.stream().map(ResourcePack::content).toList(),
+                NativeActorLibrary::resource, ROOT_PATHS, EXTENSIONS);
+        final List<Layer> layers = new ArrayList<>(packs.size());
+        for (int index = 0; index < packs.size(); index++) {
+            layers.add(new Layer(server.test(packs.get(index)), selected.get(index)));
+        }
+        return List.copyOf(layers);
+    }
+
+    /** Shares effect dependencies while preserving empty layers and excluding actor-only definitions. */
+    public static List<Map<String, byte[]>> effects(final List<Layer> layers) throws IOException {
+        final List<Content> packs = new ArrayList<>(layers.size());
+        for (final Layer layer : layers) {
+            final InMemoryContent content = new InMemoryContent();
+            layer.resources().forEach(content::put);
+            packs.add(content);
+        }
+        return NativeResourceArchive.select(packs, NativeActorLibrary::effectResource, List.of("sounds.json"),
+                List.of(".json", ".png", ".tga", ".ogg", ".fsb", ".wav", ".lang"));
+    }
+
+    private static boolean effectResource(final String path) {
+        return path.equals("sounds.json")
+                || path.startsWith("sounds/") && (path.endsWith(".json") || path.endsWith(".ogg") || path.endsWith(".fsb") || path.endsWith(".wav"))
+                || path.startsWith("texts/") && path.endsWith(".lang")
+                || path.endsWith(".json") && (path.startsWith("particles/") || path.startsWith("render_controllers/"))
+                || path.endsWith(".png") || path.endsWith(".tga");
+    }
+
+    public static List<Layer> decode(final InputStream input) throws IOException {
+        final DataInputStream fields = new DataInputStream(input);
+        if (fields.readInt() != 1 || fields.readInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+            throw new IOException("Unsupported native actor library");
+        }
+        final int count = fields.readInt();
+        if (count < 0 || count > MAX_PACKS) {
+            throw new IOException("Invalid native actor pack count");
+        }
+        final List<Boolean> servers = new ArrayList<>(count);
+        for (int index = 0; index < count; index++) {
+            final int role = fields.readUnsignedByte();
+            if (role > 1) {
+                throw new IOException("Invalid native actor pack provenance");
+            }
+            servers.add(role == 1);
+        }
+        final List<Map<String, byte[]>> packs = NativeResourceArchive.decode(fields, NativeActorLibrary::resource);
+        if (packs.size() != count) {
+            throw new IOException("Mismatched native actor pack indexes");
+        }
+        final List<Layer> layers = new ArrayList<>(count);
+        for (int index = 0; index < count; index++) {
+            layers.add(new Layer(servers.get(index), packs.get(index)));
+        }
+        return List.copyOf(layers);
+    }
+
+    private static boolean resource(final String path) {
+        if (path.equals("manifest.json") || path.equals("pack_manifest.json") || path.equals("sounds.json")) {
+            return true;
+        }
+        if (path.endsWith(".png") || path.endsWith(".tga") || path.endsWith(".jpg")) {
+            return true;
+        }
+        if (path.startsWith("sounds/") && (path.endsWith(".ogg") || path.endsWith(".fsb") || path.endsWith(".wav"))) {
+            return true;
+        }
+        if (path.startsWith("texts/") && path.endsWith(".lang") || path.startsWith("materials/") && path.endsWith(".material")) {
+            return true;
+        }
+        return path.endsWith(".json") && List.of("entity/", "attachables/", "models/", "animations/", "animation_controllers/",
+                "render_controllers/", "particles/", "sounds/", "textures/", "items/").stream().anyMatch(path::startsWith);
+    }
+
+    private NativeActorLibrary() {
+    }
+
+    public record Layer(boolean server, Map<String, byte[]> resources) {
+        public Layer {
+            resources = Map.copyOf(resources);
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeResourceArchive.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeResourceArchive.java
new file mode 100644
index 000000000..8b528490d
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeResourceArchive.java
@@ -0,0 +1,153 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.ResourcePackZipWriter;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import org.apache.commons.io.output.UnsynchronizedByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeSet;
+import java.util.function.Predicate;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/** Bounded deterministic archives retain every source pack index, including empty packs. */
+final class NativeResourceArchive {
+
+    private static final int MAX_PACKS = 4096;
+    private static final int MAX_FILES = 32768;
+    private static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_TOTAL_BYTES = 256 * 1024 * 1024;
+
+    static byte[] encode(final List<Content> packs, final Predicate<String> permitted,
+                         final List<String> paths, final List<String> extensions) throws IOException {
+        final var bytes = UnsynchronizedByteArrayOutputStream.builder().get();
+        write(packs, permitted, paths, extensions, bytes);
+        return bytes.toByteArray();
+    }
+
+    static void write(final List<Content> packs, final Predicate<String> permitted,
+                      final List<String> paths, final List<String> extensions, final OutputStream output) throws IOException {
+        final List<Map<String, byte[]>> selected = select(packs, permitted, paths, extensions);
+        final List<ResourcePackZipWriter.Entry> entries = new ArrayList<>();
+        entries.add(new ResourcePackZipWriter.Entry("header", ByteBuffer.allocate(12).putInt(1).putInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION).putInt(selected.size()).array()));
+        for (int index = 0; index < selected.size(); index++) {
+            for (final var file : selected.get(index).entrySet()) {
+                entries.add(new ResourcePackZipWriter.Entry(index + "/" + file.getKey(), file.getValue()));
+            }
+        }
+        ResourcePackZipWriter.write(entries, output);
+    }
+
+    static List<Map<String, byte[]>> select(final List<Content> packs, final Predicate<String> permitted,
+                                          final List<String> paths, final List<String> extensions) throws IOException {
+        if (packs.size() > MAX_PACKS) {
+            throw new IOException("Too many native resource packs");
+        }
+        final List<Map<String, byte[]>> selected = new ArrayList<>();
+        long total = 0;
+        int count = 0;
+        for (final Content pack : packs) {
+            final TreeSet<String> ordered = new TreeSet<>();
+            for (final String path : paths) {
+                if (pack.contains(path)) {
+                    ordered.add(path);
+                }
+            }
+            for (final String extension : extensions) {
+                for (final String path : pack.getFilesDeep("", extension)) {
+                    if (permitted.test(path)) {
+                        ordered.add(path);
+                    }
+                }
+            }
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final String path : ordered) {
+                validatePath(path, permitted);
+                final byte[] bytes = pack.get(path);
+                total += bytes.length;
+                if (++count > MAX_FILES || bytes.length > MAX_FILE_BYTES || total > MAX_TOTAL_BYTES) {
+                    throw new IOException("Native resources exceed limits");
+                }
+                files.put(path, bytes);
+            }
+            selected.add(Collections.unmodifiableMap(files));
+        }
+        return List.copyOf(selected);
+    }
+
+    static List<Map<String, byte[]>> decode(final InputStream input, final Predicate<String> permitted) throws IOException {
+        final List<Map<String, byte[]>> packs = new ArrayList<>();
+        long total = 0;
+        int count = 0;
+        try (ZipInputStream zip = new ZipInputStream(input)) {
+            final ZipEntry header = zip.getNextEntry();
+            if (header == null || !header.getName().equals("header")) {
+                throw new IOException("Missing native resource library header");
+            }
+            final DataInputStream fields = new DataInputStream(zip);
+            if (fields.readInt() != 1 || fields.readInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IOException("Unsupported native resource library");
+            }
+            final int packCount = fields.readInt();
+            if (packCount < 0 || packCount > MAX_PACKS || zip.read() != -1) {
+                throw new IOException("Invalid native resource library header");
+            }
+            for (int index = 0; index < packCount; index++) {
+                packs.add(new LinkedHashMap<>());
+            }
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                final String name = entry.getName();
+                final int separator = name.indexOf('/');
+                final int index;
+                try {
+                    index = Integer.parseInt(name.substring(0, separator));
+                } catch (final RuntimeException invalid) {
+                    throw new IOException("Invalid native resource pack index", invalid);
+                }
+                final String path = name.substring(separator + 1);
+                validatePath(path, permitted);
+                if (entry.isDirectory() || index < 0 || index >= packCount || ++count > MAX_FILES) {
+                    throw new IOException("Invalid native resource entry");
+                }
+                final int limit = (int) Math.min(MAX_FILE_BYTES, MAX_TOTAL_BYTES - total);
+                final byte[] file = zip.readNBytes(limit + 1);
+                total += file.length;
+                if (file.length > limit || packs.get(index).putIfAbsent(path, file) != null) {
+                    throw new IOException("Duplicate or oversized native resource entry");
+                }
+            }
+        }
+        return packs.stream().map(Map::copyOf).toList();
+    }
+
+    private static void validatePath(final String path, final Predicate<String> permitted) throws IOException {
+        if (!permitted.test(path) || path.length() > 512 || path.indexOf('\\') >= 0 || path.indexOf('\0') >= 0) {
+            throw new IOException("Invalid native resource path");
+        }
+        for (final String part : path.split("/", -1)) {
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) {
+                throw new IOException("Invalid native resource path");
+            }
+        }
+    }
+
+    private NativeResourceArchive() {
+    }
+
+}
