+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.NativeSoundLibrary;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+public final class NativeSoundResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> {
+            final Content result = new InMemoryContent();
+            try {
+                result.put(NativeSoundLibrary.PATH, NativeSoundLibrary.encode(storage.getPackStackBottomToTop().stream().map(ResourcePack::content).toList()));
+            } catch (final IOException invalid) {
+                throw new UncheckedIOException(invalid);
+            }
+            return result;
+        });
+    }
+
+}
