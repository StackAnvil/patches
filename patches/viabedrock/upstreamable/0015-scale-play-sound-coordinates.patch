+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Pack-ordered caption translations with English fallback and case-independent locale codes. */
+public final class SoundTranslations {
+
+    private final Map<String, Map<String, String>> languages = new HashMap<>();
+
+    public SoundTranslations(final List<Map<String, byte[]>> packs) {
+        for (final Map<String, byte[]> pack : packs) {
+            for (final Map.Entry<String, byte[]> entry : pack.entrySet()) {
+                final String path = entry.getKey();
+                if (!path.startsWith("texts/") || !path.endsWith(".lang") || path.indexOf('/', 6) >= 0) {
+                    continue;
+                }
+                final Map<String, String> translations = this.languages.computeIfAbsent(
+                        path.substring(6, path.length() - 5).toLowerCase(Locale.ROOT), ignored -> new HashMap<>());
+                for (final String rawLine : new String(entry.getValue(), StandardCharsets.UTF_8).split("\\n")) {
+                    String line = rawLine;
+                    final int comment = line.indexOf("##");
+                    if (comment >= 0) {
+                        line = line.substring(0, comment);
+                    }
+                    line = line.trim();
+                    final int separator = line.indexOf('=');
+                    if (separator > 0) {
+                        translations.put(line.substring(0, separator), line.substring(separator + 1));
+                    }
+                }
+            }
+        }
+    }
+
+    public String translate(final String key, final String locale) {
+        final Map<String, String> selected = this.languages.get(locale.toLowerCase(Locale.ROOT));
+        if (selected != null && selected.containsKey(key)) {
+            return selected.get(key);
+        }
+        return this.languages.getOrDefault("en_us", Map.of()).getOrDefault(key, key);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/WaveSound.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/WaveSound.java
new file mode 100644
index 000000000..415730f3d
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/WaveSound.java
@@ -0,0 +1,228 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Bounded RIFF/WAVE decoding to interleaved signed little-endian 16-bit PCM. */
+public final class WaveSound {
+
+    private static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_PCM_BYTES = 64 * 1024 * 1024;
+    private static final int[] IMA_STEPS = {
+        7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31,
+        34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97, 107, 118, 130, 143,
+        157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544,
+        598, 658, 724, 796, 876, 963, 1060, 1166, 1282, 1411, 1552, 1707,
+        1878, 2066, 2272, 2499, 2749, 3024, 3327, 3660, 4026, 4428, 4871,
+        5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635,
+        13899, 15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794, 32767
+    };
+
+    public static Audio read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length < 12 || bytes.length > MAX_FILE_BYTES) {
+            throw new IOException("Missing or oversized WAVE file");
+        }
+        final ByteBuffer data = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        final long end = 8 + Integer.toUnsignedLong(data.getInt(4));
+        if (data.getInt(0) != 0x46464952 || data.getInt(8) != 0x45564157 || end < 12 || end > bytes.length) {
+            throw new IOException("Invalid RIFF/WAVE header");
+        }
+        Format format = null;
+        int start = -1;
+        int size = 0;
+        long fact = -1;
+        for (int cursor = 12; cursor < end; ) {
+            if (cursor + 8L > end) {
+                throw new IOException("Truncated WAVE chunk header");
+            }
+            final int kind = data.getInt(cursor);
+            final long length = Integer.toUnsignedLong(data.getInt(cursor + 4));
+            final long next = cursor + 8L + length + (length & 1);
+            if (next > end) {
+                throw new IOException("Truncated WAVE chunk");
+            }
+            final int content = cursor + 8;
+            switch (kind) {
+                case 0x20746D66 -> {
+                    if (format != null) {
+                        throw new IOException("Duplicate WAVE format");
+                    }
+                    format = format(data, content, (int) length);
+                }
+                case 0x61746164 -> {
+                    if (start != -1) {
+                        throw new IOException("Duplicate WAVE sample data");
+                    }
+                    start = content;
+                    size = (int) length;
+                }
+                case 0x74636166 -> {
+                    if (fact != -1 || length < 4) {
+                        throw new IOException("Invalid WAVE sample count");
+                    }
+                    fact = Integer.toUnsignedLong(data.getInt(content));
+                }
+                default -> { /* Skip bounded metadata and its even-byte padding. */ }
+            }
+            cursor = (int) next;
+        }
+        if (format == null || start == -1 || size == 0) {
+            throw new IOException("Missing WAVE format or samples");
+        }
+        final int frames;
+        if (format.codec == 17) {
+            final int tail = size % format.block;
+            if (tail != 0 && (tail < 4 * format.channels || (tail - 4 * format.channels) % (4 * format.channels) != 0)) {
+                throw new IOException("Truncated WAVE IMA block");
+            }
+            final long capacity = (long) (size / format.block) * format.blockFrames
+                    + (tail == 0 ? 0 : 1 + (tail - 4 * format.channels) * 2 / format.channels);
+            if (fact == 0 || fact > capacity || fact != -1 && fact <= capacity - (tail == 0 ? format.blockFrames : 1 + (tail - 4 * format.channels) * 2 / format.channels)) {
+                throw new IOException("Invalid WAVE IMA frame count");
+            }
+            frames = boundedFrames(fact == -1 ? capacity : fact, format.channels);
+        } else {
+            if (size % format.block != 0) {
+                throw new IOException("Incomplete WAVE PCM frame");
+            }
+            frames = boundedFrames(size / format.block, format.channels);
+        }
+        final ByteBuffer pcm = ByteBuffer.allocate(frames * format.channels * 2).order(ByteOrder.LITTLE_ENDIAN);
+        if (format.codec == 17) {
+            ima(data, start, size, format, frames, pcm);
+        } else {
+            final int width = format.bits / 8;
+            for (int cursor = start; cursor < start + size; cursor += width) {
+                final int sample;
+                if (format.codec == 3) {
+                    final double value = width == 4 ? data.getFloat(cursor) : data.getDouble(cursor);
+                    if (!Double.isFinite(value)) {
+                        throw new IOException("Non-finite WAVE sample");
+                    }
+                    sample = (int) Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, Math.round(value * 32768)));
+                } else if (width == 1) {
+                    sample = ((Byte.toUnsignedInt(data.get(cursor)) - 128) >> (8 - format.validBits)) << (16 - format.validBits);
+                } else {
+                    int value = 0;
+                    for (int index = 0; index < width; index++) {
+                        value |= Byte.toUnsignedInt(data.get(cursor + index)) << (index * 8);
+                    }
+                    // Extensible PCM puts valid bits at the left of the container.
+                    // Removing unused low bits also handles signed 24-bit containers.
+                    value = (value << (32 - format.bits)) >> (32 - format.validBits);
+                    sample = format.validBits >= 16 ? value >> (format.validBits - 16) : value << (16 - format.validBits);
+                }
+                pcm.putShort((short) sample);
+            }
+        }
+        return new Audio(pcm.array(), format.rate, format.channels, frames);
+    }
+
+    private static Format format(final ByteBuffer data, final int start, final int size) throws IOException {
+        if (size < 16 || size == 17 || size >= 18 && unsignedShort(data, start + 16) > size - 18) {
+            throw new IOException("Invalid WAVE format length");
+        }
+        int codec = unsignedShort(data, start);
+        final int channels = unsignedShort(data, start + 2);
+        final int rate = data.getInt(start + 4);
+        final int block = unsignedShort(data, start + 12);
+        final int bits = unsignedShort(data, start + 14);
+        int validBits = bits;
+        if (codec == 0xFFFE) {
+            if (size < 40 || unsignedShort(data, start + 16) < 22
+                    || data.getInt(start + 28) != 0x00100000 || data.getLong(start + 32) != 0x719B3800AA000080L) {
+                throw new IOException("Invalid extensible WAVE format");
+            }
+            validBits = unsignedShort(data, start + 18);
+            if (validBits == 0) {
+                validBits = bits;
+            }
+            codec = data.getInt(start + 24);
+        }
+        if (channels < 1 || channels > 2 || rate < 1000 || rate > 192000 || block == 0) {
+            throw new IOException("Unsupported WAVE dimensions");
+        }
+        int blockFrames = 0;
+        if (codec == 17) {
+            if (bits != 4 || size < 20 || unsignedShort(data, start + 16) < 2
+                    || block < 4 * channels || (block - 4 * channels) % (4 * channels) != 0) {
+                throw new IOException("Invalid WAVE IMA format");
+            }
+            blockFrames = 1 + (block - 4 * channels) * 2 / channels;
+            if (unsignedShort(data, start + 18) != blockFrames) {
+                throw new IOException("Inconsistent WAVE IMA block size");
+            }
+        } else if ((codec != 1 || bits != 8 && bits != 16 && bits != 24 && bits != 32)
+                && (codec != 3 || bits != 32 && bits != 64)
+                || block != channels * (bits / 8) || validBits < 1 || validBits > bits || codec == 3 && validBits != bits) {
+            throw new IOException("Unsupported WAVE encoding");
+        }
+        return new Format(codec, channels, rate, block, bits, validBits, blockFrames);
+    }
+
+    private static void ima(final ByteBuffer data, final int start, final int size, final Format format,
+                            final int frames, final ByteBuffer pcm) throws IOException {
+        int frame = 0;
+        final int[] predictor = new int[format.channels];
+        final int[] stepIndex = new int[format.channels];
+        for (int block = start; block < start + size; block += format.block) {
+            final int end = Math.min(start + size, block + format.block);
+            for (int channel = 0; channel < format.channels; channel++) {
+                predictor[channel] = data.getShort(block + channel * 4);
+                stepIndex[channel] = Byte.toUnsignedInt(data.get(block + channel * 4 + 2));
+                if (stepIndex[channel] > 88 || data.get(block + channel * 4 + 3) != 0) {
+                    throw new IOException("Invalid WAVE IMA predictor");
+                }
+                if (frame < frames) {
+                    pcm.putShort((frame * format.channels + channel) * 2, (short) predictor[channel]);
+                }
+            }
+            frame++;
+            for (int group = block + 4 * format.channels; group < end; group += 4 * format.channels) {
+                for (int channel = 0; channel < format.channels; channel++) {
+                    for (int nibble = 0; nibble < 8; nibble++) {
+                        final int value = (Byte.toUnsignedInt(data.get(group + channel * 4 + nibble / 2)) >> ((nibble & 1) * 4)) & 15;
+                        final int magnitude = value & 7;
+                        final int step = IMA_STEPS[stepIndex[channel]];
+                        // IMA truncates each contribution before adding, not their sum.
+                        final int delta = (step >> 3) + ((magnitude & 4) == 0 ? 0 : step)
+                                + ((magnitude & 2) == 0 ? 0 : step >> 1) + ((magnitude & 1) == 0 ? 0 : step >> 2);
+                        predictor[channel] = Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, predictor[channel] + ((value & 8) == 0 ? delta : -delta)));
+                        stepIndex[channel] = Math.max(0, Math.min(88, stepIndex[channel] + (magnitude < 4 ? -1 : (magnitude - 3) * 2)));
+                        if (frame + nibble < frames) {
+                            pcm.putShort(((frame + nibble) * format.channels + channel) * 2, (short) predictor[channel]);
+                        }
+                    }
+                }
+                frame += 8;
+            }
+        }
+    }
+
+    private static int boundedFrames(final long frames, final int channels) throws IOException {
+        if (frames <= 0 || frames > MAX_PCM_BYTES / (channels * 2)) {
+            throw new IOException("Oversized WAVE sample data");
+        }
+        return (int) frames;
+    }
+
+    private static int unsignedShort(final ByteBuffer data, final int offset) {
+        return Short.toUnsignedInt(data.getShort(offset));
+    }
+
+    private WaveSound() {
+    }
+
+    public record Audio(byte[] pcm, int sampleRate, int channels, int frames) {
+    }
+
+    private record Format(int codec, int channels, int rate, int block, int bits, int validBits, int blockFrames) {
+    }
+
+}
