+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.packet;
+
+import net.raphimc.viabedrock.api.resourcepack.NativeSoundLibrary;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class NativeSoundLibraryTest {
+
+    @Test
+    void preservesPackOrderAndSampleOverridesWithoutUnrelatedFiles() throws Exception {
+        final var lower = new InMemoryContent();
+        final var upper = new InMemoryContent();
+        lower.put("sounds/test.ogg", new byte[]{1});
+        upper.put("sounds/test.wav", new byte[]{2});
+        upper.put("textures/test.png", new byte[]{3});
+        final byte[] archive = NativeSoundLibrary.encode(List.of(lower, upper));
+        final var packs = NativeSoundLibrary.decode(new ByteArrayInputStream(archive));
+        assertEquals(2, packs.size());
+        assertEquals(1, packs.get(0).size());
+        assertEquals(1, packs.get(1).size());
+        assertArrayEquals(new byte[]{1}, packs.get(0).get("sounds/test.ogg"));
+        assertArrayEquals(new byte[]{2}, packs.get(1).get("sounds/test.wav"));
+        assertArrayEquals(archive, NativeSoundLibrary.encode(List.of(lower, upper)));
+    }
+
+    @Test
+    void rejectsEscapingAndInvalidPackPaths() throws Exception {
+        for (final String path : List.of("0/sounds/../test.ogg", "1/sounds/test.ogg", "0/sounds//test.ogg")) {
+            final var bytes = new ByteArrayOutputStream();
+            try (var zip = new ZipOutputStream(bytes)) {
+                zip.putNextEntry(new ZipEntry("header"));
+                zip.write(ByteBuffer.allocate(12).putInt(1).putInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION).putInt(1).array());
+                zip.closeEntry();
+                zip.putNextEntry(new ZipEntry(path));
+                zip.write(1);
+                zip.closeEntry();
+            }
+            assertThrows(IOException.class, () -> NativeSoundLibrary.decode(new ByteArrayInputStream(bytes.toByteArray())));
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/PlaySoundPacketsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/PlaySoundPacketsTest.java
