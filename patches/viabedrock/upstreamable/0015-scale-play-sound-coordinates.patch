+    static void writePlaySound(final PacketWrapper wrapper, final PlaySound sound, final int soundId, final int category, final long seed) {
+        wrapper.write(Types.SOUND_EVENT, Holder.of(soundId));
+        wrapper.write(Types.VAR_INT, category);
+        // Both protocols encode these fields in eighths of a block. Preserve the integers exactly.
+        wrapper.write(Types.INT, sound.positionEighths().x());
+        wrapper.write(Types.INT, sound.positionEighths().y());
+        wrapper.write(Types.INT, sound.positionEighths().z());
+        wrapper.write(Types.FLOAT, sound.volume());
+        wrapper.write(Types.FLOAT, sound.pitch());
+        wrapper.write(Types.LONG, seed);
+    }
+
     private WorldEffectPackets() {
