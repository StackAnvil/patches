+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.util.List;
+import java.util.Random;
+import java.util.zip.ZipInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeResourceArchiveTest {
+
+    @Test
+    void largeArchivesPreserveHeadersEmptyLayersAndOverrideOrder() throws Exception {
+        final byte[] data = new byte[3 * 1024 * 1024];
+        new Random(2193).nextBytes(data);
+        final Content lower = new InMemoryContent();
+        final Content upper = new InMemoryContent();
+        lower.put("textures/a.png", data);
+        lower.put("textures/b.png", new byte[data.length]);
+        upper.put("textures/a.png", data.clone());
+        upper.put("textures/empty.png", new byte[0]);
+        final List<Content> packs = List.of(lower, new InMemoryContent(), upper);
+        final byte[] archive = NativeResourceArchive.encode(packs, path -> path.startsWith("textures/"), List.of(), List.of(".png"));
+        final var decoded = NativeResourceArchive.decode(new ByteArrayInputStream(archive), path -> path.startsWith("textures/"));
+        assertEquals(3, decoded.size());
+        assertTrue(decoded.get(1).isEmpty());
+        for (int index = 0; index < packs.size(); index++) {
+            assertEquals(packs.get(index).getFilesDeep("", "").size(), decoded.get(index).size());
+            for (final String path : packs.get(index).getFilesDeep("", "")) {
+                assertArrayEquals(packs.get(index).get(path), decoded.get(index).get(path));
+            }
+        }
+        try (var zip = new ZipInputStream(new ByteArrayInputStream(archive))) {
+            for (final String name : List.of("header", "0/textures/a.png", "0/textures/b.png", "2/textures/a.png", "2/textures/empty.png")) {
+                assertEquals(name, zip.getNextEntry().getName());
+            }
+            assertNull(zip.getNextEntry());
+        }
+        assertArrayEquals(archive, NativeResourceArchive.encode(packs, path -> path.startsWith("textures/"), List.of(), List.of(".png")));
+    }
+
+}
