+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native float listener admission shared by server requests and local sound emitters. */
+public final class SoundListenerRange {
+
+    private SoundListenerRange() {
+    }
+
+    public static boolean passes(final Position3f source, final Position3f listener, final float volume) {
+        final float x = source.x() - listener.x();
+        final float y = source.y() - listener.y();
+        final float z = source.z() - listener.z();
+        final float radius = 16F * (volume > 1F ? volume : 1F);
+        return radius * radius > z * z + (y * y + x * x);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/SoundPlaybackMessage.java b/src/main/java/net/raphimc/viabedrock/api/model/SoundPlaybackMessage.java
