From 4e7729755c025882e86411e2c0ec484109e39233 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 19:48:51 +0200
Subject: [PATCH] fix(audio): encode PlaySound coordinates in Java units

Bedrock sends PlaySound positions in blocks, while the Java sound packet expects positions in eighths of a block. Scale all three coordinates so sounds play at their actual world location.
---
 .../viabedrock/protocol/packet/WorldEffectPackets.java      | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
index 2539fa12..8046c8c0 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
@@ -135,9 +135,9 @@ public final class WorldEffectPackets {
 
             wrapper.write(Types.SOUND_EVENT, Holder.of(javaSound.id())); // sound id
             wrapper.write(Types.VAR_INT, javaSound.category().ordinal()); // category
-            wrapper.write(Types.INT, position.x()); // x
-            wrapper.write(Types.INT, position.y()); // y
-            wrapper.write(Types.INT, position.z()); // z
+            wrapper.write(Types.INT, position.x() * 8); // x
+            wrapper.write(Types.INT, position.y() * 8); // y
+            wrapper.write(Types.INT, position.z() * 8); // z
             wrapper.write(Types.FLOAT, volume); // volume
             wrapper.write(Types.FLOAT, pitch); // pitch
             wrapper.write(Types.LONG, ThreadLocalRandom.current().nextLong()); // seed
-- 
