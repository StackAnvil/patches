@@ -0,0 +1,86 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** A client mirror of primary block identities, with no reverse Java mapping. */
+public final class NativeBlockView {
+
+    private final Map<Long, NativeBlockSection[]> chunks = new HashMap<>();
+    private NativeBlockIdentifiers.Reset world;
+    private final Map<Integer, String> names = new HashMap<>();
+
+    public void clear() {
+        this.chunks.clear();
+        this.names.clear();
+        this.world = null;
+    }
+
+    public boolean ready() {
+        return this.world != null;
+    }
+
+    public void accept(final NativeBlockIdentifiers message) {
+        if (message instanceof NativeBlockIdentifiers.Reset reset) {
+            this.clear();
+            this.world = reset;
+        } else if (this.world != null && message.dimension() == this.world.dimension()) {
+            if (message instanceof NativeBlockIdentifiers.Section section) {
+                final long index = (long) section.sectionY() - (this.world.minY() >> 4);
+                if (index < 0 || index >= this.world.height() >> 4) {
+                    throw new IllegalArgumentException("Native section lies outside the world");
+                }
+                final long key = key(section.chunkX(), section.chunkZ());
+                if (!this.chunks.containsKey(key) && this.chunks.size() >= 8192) {
+                    throw new IllegalArgumentException("Native block view exceeds its chunk limit");
+                }
+                this.chunks.computeIfAbsent(key, ignored -> new NativeBlockSection[this.world.height() >> 4])[(int) index] = section.blocks();
+            } else if (message instanceof NativeBlockIdentifiers.Update update) {
+                final var position = update.position();
+                final var sections = this.chunks.get(key(position.x() >> 4, position.z() >> 4));
+                final int index = this.sectionIndex(position.y());
+                if (sections != null && index >= 0 && index < sections.length && sections[index] != null) {
+                    sections[index] = sections[index].with(NativeBlockSection.index(position.x(), position.y(), position.z()), update.state());
+                }
+            } else if (message instanceof NativeBlockIdentifiers.Dictionary dictionary) {
+                for (final var name : dictionary.names()) {
+                    if (!this.names.containsKey(name.state()) && this.names.size() >= 1_000_000) {
+                        throw new IllegalArgumentException("Native block dictionary exceeds its state limit");
+                    }
+                    this.names.put(name.state(), name.identifier());
+                }
+            } else if (message instanceof NativeBlockIdentifiers.Forget forget) {
+                this.chunks.remove(key(forget.chunkX(), forget.chunkZ()));
+            }
+        }
+    }
+
+    public String block(final int x, final int y, final int z) {
+        if (this.world == null) {
+            return null;
+        }
+        final var sections = this.chunks.get(key(x >> 4, z >> 4));
+        final int index = this.sectionIndex(y);
+        // ChunkTracker uses native air outside loaded sections and the dimension's vertical bounds.
+        if (sections == null || index < 0 || index >= sections.length || sections[index] == null) {
+            return "minecraft:air";
+        }
+        final String name = this.names.get(sections[index].state(NativeBlockSection.index(x, y, z)));
+        return name == null || name.isEmpty() ? null : name;
+    }
+
+    private int sectionIndex(final int y) {
+        final long offset = (long) y - this.world.minY();
+        return offset < 0 || offset >= this.world.height() ? -1 : (int) (offset >> 4);
+    }
+
+    private static long key(final int x, final int z) {
+        return (long) x << 32 | z & 0xFFFFFFFFL;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/SoundCaptions.java b/src/main/java/net/raphimc/viabedrock/api/model/SoundCaptions.java
