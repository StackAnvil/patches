+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.packet;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.SoundPlaybackMessage;
+import net.raphimc.viabedrock.protocol.model.SoundUpdate;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class SoundUpdateTest {
+
+    private static final SoundUpdate.Event[] EVENTS = {new SoundUpdate.Stop(), new SoundUpdate.Volume(0.3F),
+        new SoundUpdate.Pitch(1.3F), new SoundUpdate.Fade(2, 0.2F), new SoundUpdate.Seek(0.01F),
+        new SoundUpdate.Pause(), new SoundUpdate.Resume()};
+
+    @Test
+    void readsCapturedVariantLayoutsAndPreservesNextValue() throws Exception {
+        for (int tag = 0; tag < EVENTS.length; tag++) {
+            final var buffer = Unpooled.buffer();
+            try {
+                buffer.writeLongLE(Long.MIN_VALUE);
+                for (int repeat = 0; repeat < 7; repeat++) {
+                    buffer.writeByte(tag);
+                    switch (tag) {
+                        case 1 -> buffer.writeFloatLE(0.3F);
+                        case 2 -> buffer.writeFloatLE(1.3F);
+                        case 3 -> buffer.writeFloatLE(2).writeFloatLE(0.2F);
+                        case 4 -> buffer.writeFloatLE(0.01F);
+                    }
+                }
+                buffer.writeInt(42);
+                assertEquals(new SoundUpdate(Long.MIN_VALUE, EVENTS[tag]), SoundUpdate.TYPE.read(buffer));
+                assertEquals(42, buffer.readInt());
+                assertEquals(0, buffer.readableBytes());
+                final var message = new SoundPlaybackMessage.Update(Long.MIN_VALUE, EVENTS[tag]);
+                SoundPlaybackMessage.TYPE.write(buffer, message);
+                assertEquals(message, SoundPlaybackMessage.TYPE.read(buffer));
+                assertEquals(0, buffer.readableBytes());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void consumesAllSevenVariantsAndUsesLastValue() {
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeLongLE(1);
+            for (final var event : EVENTS) {
+                SoundUpdate.writeEvent(buffer, event);
+            }
+            assertEquals(new SoundUpdate(1, EVENTS[6]), SoundUpdate.TYPE.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnknownAndTruncatedVariants() {
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeLongLE(1).writeByte(7);
+            assertThrows(IllegalArgumentException.class, () -> SoundUpdate.TYPE.read(buffer));
+            buffer.clear().writeLongLE(1).writeByte(3).writeFloatLE(2);
+            assertThrows(IndexOutOfBoundsException.class, () -> SoundUpdate.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
