+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import static net.raphimc.viabedrock.api.model.SoundCaptions.Direction.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class SoundCaptionsTest {
+
+    @Test
+    void preservesNativeDirectionThresholdAndMarkedSoundSuppression() {
+        final Position3f forward = new Position3f(0, 0, 1);
+        final Position3f up = new Position3f(0, 1, 0);
+        final Position3f player = new Position3f(17, 64, -31);
+        assertEquals(NONE, SoundCaptions.direction(player.add(0, 0, 1), player, forward, up, false));
+        assertEquals(LEFT, SoundCaptions.direction(player.add(1, 0, 0), player, forward, up, false));
+        assertEquals(RIGHT, SoundCaptions.direction(player.add(-1, 0, 0), player, forward, up, false));
+        assertEquals(LEFT, SoundCaptions.direction(player, player, forward, up, false));
+        assertEquals(LEFT, SoundCaptions.direction(player.add(0, 1, 0), player, forward, up, false));
+        assertEquals(NONE, SoundCaptions.direction(player.add(1, 0, 0), player, forward, up, true));
+        assertEquals(LEFT, SoundCaptions.direction(new Position3f((float) Math.sqrt(3), 0, 1), Position3f.ZERO, forward, up, false));
+    }
+
+    @Test
+    void filtersCaptionMetadataAndAmbientPrefixesBeforeLocalization() {
+        final String entity = "subtitles.entity.pig.ambient";
+        assertTrue(SoundCaptions.admits("pig.ambient", entity, 1, true, true));
+        for (final String prefix : new String[]{"subtitles.ambient.cave", "subtitles.weather.rain"}) {
+            assertFalse(SoundCaptions.admits("event", prefix, 1, true, true));
+            assertTrue(SoundCaptions.admits("event", prefix, 1, true, false));
+        }
+        for (final float volume : new float[]{0, -1, Float.NaN}) {
+            assertFalse(SoundCaptions.admits("event", entity, volume, true, false));
+        }
+        assertFalse(SoundCaptions.admits("event", entity, 1, false, false));
+        assertFalse(SoundCaptions.admits("", entity, 1, true, false));
+        assertFalse(SoundCaptions.admits("event", null, 1, true, false));
+        assertFalse(SoundCaptions.admits("event", "", 1, true, false));
+    }
+
+    @Test
+    void refreshesLocalizedDuplicatesWithoutReorderingAndExpiresByElapsedTime() {
+        final var state = new SoundCaptions();
+        state.advance(1_000_000_000L);
+        state.refresh("first", LEFT, true, 1500);
+        state.refresh("second", NONE, false, 4000);
+        state.advance(1_500_000_000L);
+        state.refresh("first", RIGHT, false, 2000);
+        final var first = state.visible(false).get(0);
+        assertEquals(RIGHT, first.direction());
+        assertFalse(first.ownSound());
+        assertEquals(2, first.seconds());
+        assertEquals(2, state.visible(true).size());
+        state.advance(3_500_000_000L);
+        assertEquals(1, state.visible(false).size());
+        assertEquals(1.5F, state.visible(false).get(0).seconds());
+        state.refresh("first", LEFT, true, 1500);
+        assertEquals("second", state.visible(false).get(0).text());
+        assertEquals(1, state.visible(true).size());
+        state.clear();
+        state.advance(9_000_000_000L);
+        state.refresh("first", NONE, false, 1500);
+        assertEquals(1.5F, state.visible(false).get(0).seconds());
+    }
+
+    @Test
+    void usesOneSecondQuarticFadeWithinTheTotalDuration() {
+        assertEquals(1, new SoundCaptions.Caption("", NONE, false, 1.5F).opacity());
+        assertEquals(1, new SoundCaptions.Caption("", NONE, false, 1).opacity());
+        assertEquals(.9375F, new SoundCaptions.Caption("", NONE, false, .5F).opacity());
+        assertEquals(0, new SoundCaptions.Caption("", NONE, false, 0).opacity());
+    }
+
+}
