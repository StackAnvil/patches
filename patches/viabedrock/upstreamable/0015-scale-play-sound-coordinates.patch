--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/SoundUpdate.java
@@ -0,0 +1,114 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public record SoundUpdate(long handle, Event event) {
+
+    public static final Type<SoundUpdate> TYPE = new Type<>(SoundUpdate.class) {
+        @Override
+        public SoundUpdate read(final ByteBuf buffer) {
+            final long handle = buffer.readLongLE();
+            Event event = null;
+            // Protocol 2193 serializes the same variant member seven times. The last read wins.
+            for (int i = 0; i < 7; i++) {
+                event = readEvent(buffer);
+            }
+            return new SoundUpdate(handle, event);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final SoundUpdate value) {
+            buffer.writeLongLE(value.handle);
+            for (int i = 0; i < 7; i++) {
+                writeEvent(buffer, value.event);
+            }
+        }
+    };
+
+    public static Event readEvent(final ByteBuf buffer) {
+        return switch (BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer)) {
+            case 0 -> new Stop();
+            case 1 -> new Volume(buffer.readFloatLE());
+            case 2 -> new Pitch(buffer.readFloatLE());
+            case 3 -> new Fade(buffer.readFloatLE(), buffer.readFloatLE());
+            case 4 -> new Seek(buffer.readFloatLE());
+            case 5 -> new Pause();
+            case 6 -> new Resume();
+            default -> throw new IllegalArgumentException("Unknown sound update variant");
+        };
+    }
+
+    public static void writeEvent(final ByteBuf buffer, final Event event) {
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, event.id());
+        if (event instanceof Volume volume) {
+            buffer.writeFloatLE(volume.volume);
+        } else if (event instanceof Pitch pitch) {
+            buffer.writeFloatLE(pitch.pitch);
+        } else if (event instanceof Fade fade) {
+            buffer.writeFloatLE(fade.duration).writeFloatLE(fade.targetVolume);
+        } else if (event instanceof Seek seek) {
+            buffer.writeFloatLE(seek.seconds);
+        }
+    }
+
+    public sealed interface Event permits Stop, Volume, Pitch, Fade, Seek, Pause, Resume {
+        int id();
+    }
+
+    public record Stop() implements Event {
+        @Override
+        public int id() {
+            return 0;
+        }
+    }
+
+    public record Volume(float volume) implements Event {
+        @Override
+        public int id() {
+            return 1;
+        }
+    }
+
+    public record Pitch(float pitch) implements Event {
+        @Override
+        public int id() {
+            return 2;
+        }
+    }
+
+    public record Fade(float duration, float targetVolume) implements Event {
+        @Override
+        public int id() {
+            return 3;
+        }
+    }
+
+    public record Seek(float seconds) implements Event {
+        @Override
+        public int id() {
+            return 4;
+        }
+    }
+
+    public record Pause() implements Event {
+        @Override
+        public int id() {
+            return 5;
+        }
+    }
+
+    public record Resume() implements Event {
+        @Override
+        public int id() {
+            return 6;
+        }
+    }
+
+}
