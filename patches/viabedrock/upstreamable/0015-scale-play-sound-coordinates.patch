+import net.raphimc.viabedrock.api.model.NativeBlockSection;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class NativeBlockSectionTest {
+
+    @Test
+    void samplesEveryNativeCoordinateFromThePrimaryLayer() {
+        final var section = new BedrockChunkSectionImpl();
+        final var primary = new BedrockDataPalette();
+        primary.addId(0);
+        final var secondary = new BedrockDataPalette();
+        secondary.addId(17);
+        section.addPalette(PaletteType.BLOCKS, primary);
+        section.addPalette(PaletteType.BLOCKS, secondary);
+        for (int y = 0; y < 16; y++) {
+            for (int z = 0; z < 16; z++) {
+                for (int x = 0; x < 16; x++) {
+                    primary.setIdAt(x, y, z, x * 10000 + y * 100 + z);
+                }
+            }
+        }
+        final var blocks = ChunkTracker.nativeBlockSection(section, 23);
+        for (int y = 0; y < 16; y++) {
+            for (int z = 0; z < 16; z++) {
+                for (int x = 0; x < 16; x++) {
+                    assertEquals(primary.idAt(x, y, z), blocks.state(NativeBlockSection.index(x, y, z)));
+                }
+            }
+        }
+    }
+
+    @Test
+    void retainsNativeAirForMissingSectionsAndPalettes() {
+        for (final var section : new BedrockChunkSectionImpl[]{null, new BedrockChunkSectionImpl()}) {
+            final var blocks = ChunkTracker.nativeBlockSection(section, 23);
+            assertEquals(23, blocks.state(0));
+            assertEquals(23, blocks.state(4095));
+            assertEquals(0, blocks.data().length);
+        }
+    }
+
