+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeSoundLibrary.java
@@ -0,0 +1,160 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeSet;
+import java.util.zip.Deflater;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import java.util.zip.ZipOutputStream;
+
+/** Native sound resources in bottom-to-top pack order, carried by the Java resource pack. */
+public final class NativeSoundLibrary {
+
+    public static final String PATH = "assets/viabedrock/sound_library.zip";
+    public static final String TRANSLATIONS_PATH = "assets/viabedrock/sound_translations.zip";
+    private static final int MAX_PACKS = 4096;
+    private static final int MAX_FILES = 32768;
+    private static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_TOTAL_BYTES = 256 * 1024 * 1024;
+
+    public static byte[] encode(final List<Content> packs) throws IOException {
+        return encode(packs, false);
+    }
+
+    public static byte[] encodeTranslations(final List<Content> packs) throws IOException {
+        return encode(packs, true);
+    }
+
+    private static byte[] encode(final List<Content> packs, final boolean translations) throws IOException {
+        if (packs.size() > MAX_PACKS) {
+            throw new IOException("Too many native sound packs");
+        }
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        long total = 0;
+        int count = 0;
+        try (ZipOutputStream zip = new ZipOutputStream(bytes)) {
+            zip.setLevel(Deflater.BEST_SPEED);
+            put(zip, "header", ByteBuffer.allocate(12).putInt(1).putInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION).putInt(packs.size()).array());
+            for (int index = 0; index < packs.size(); index++) {
+                final Content pack = packs.get(index);
+                final TreeSet<String> paths = new TreeSet<>();
+                if (translations) {
+                    paths.addAll(pack.getFilesDeep("texts/", ".lang"));
+                } else if (pack.contains("sounds.json")) {
+                    paths.add("sounds.json");
+                }
+                if (!translations) {
+                    for (final String extension : List.of(".json", ".ogg", ".fsb", ".wav")) {
+                        paths.addAll(pack.getFilesDeep("sounds/", extension));
+                    }
+                }
+                for (final String path : paths) {
+                    validatePath(path, translations);
+                    final byte[] file = pack.get(path);
+                    total += file.length;
+                    if (++count > MAX_FILES || file.length > MAX_FILE_BYTES || total > MAX_TOTAL_BYTES) {
+                        throw new IOException("Native sound resources exceed limits");
+                    }
+                    put(zip, index + "/" + path, file);
+                }
+            }
+        }
+        return bytes.toByteArray();
+    }
+
+    public static List<Map<String, byte[]>> decode(final InputStream input) throws IOException {
+        return decode(input, false);
+    }
+
+    public static List<Map<String, byte[]>> decodeTranslations(final InputStream input) throws IOException {
+        return decode(input, true);
+    }
+
+    private static List<Map<String, byte[]>> decode(final InputStream input, final boolean translations) throws IOException {
+        final List<Map<String, byte[]>> packs = new ArrayList<>();
+        long total = 0;
+        int count = 0;
+        try (ZipInputStream zip = new ZipInputStream(input)) {
+            final ZipEntry header = zip.getNextEntry();
+            if (header == null || !header.getName().equals("header")) {
+                throw new IOException("Missing native sound library header");
+            }
+            final DataInputStream fields = new DataInputStream(zip);
+            if (fields.readInt() != 1 || fields.readInt() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IOException("Unsupported native sound library");
+            }
+            final int packCount = fields.readInt();
+            if (packCount < 0 || packCount > MAX_PACKS || zip.read() != -1) {
+                throw new IOException("Invalid native sound library header");
+            }
+            for (int index = 0; index < packCount; index++) {
+                packs.add(new LinkedHashMap<>());
+            }
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                final String name = entry.getName();
+                final int separator = name.indexOf('/');
+                final int index;
+                try {
+                    index = Integer.parseInt(name.substring(0, separator));
+                } catch (final RuntimeException invalid) {
+                    throw new IOException("Invalid native sound pack index", invalid);
+                }
+                final String path = name.substring(separator + 1);
+                validatePath(path, translations);
+                if (entry.isDirectory() || index < 0 || index >= packCount || ++count > MAX_FILES) {
+                    throw new IOException("Invalid native sound entry");
+                }
+                final int limit = (int) Math.min(MAX_FILE_BYTES, MAX_TOTAL_BYTES - total);
+                final byte[] file = zip.readNBytes(limit + 1);
+                total += file.length;
+                if (file.length > limit || packs.get(index).putIfAbsent(path, file) != null) {
+                    throw new IOException("Duplicate or oversized native sound entry");
+                }
+            }
+        }
+        return packs.stream().map(Map::copyOf).toList();
+    }
+
+    private static void validatePath(final String path, final boolean translations) throws IOException {
+        final boolean permitted = translations ? path.startsWith("texts/") && path.endsWith(".lang")
+                : path.equals("sounds.json") || path.startsWith("sounds/");
+        if (!permitted
+                || path.length() > 512 || path.indexOf('\\') >= 0 || path.indexOf('\0') >= 0) {
+            throw new IOException("Invalid native sound path");
+        }
+        for (final String part : path.split("/", -1)) {
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) {
+                throw new IOException("Invalid native sound path");
+            }
+        }
+    }
+
+    private static void put(final ZipOutputStream zip, final String path, final byte[] bytes) throws IOException {
+        final ZipEntry entry = new ZipEntry(path);
+        entry.setTime(0);
+        zip.putNextEntry(entry);
+        zip.write(bytes);
+        zip.closeEntry();
+    }
+
+    private NativeSoundLibrary() {
+    }
+
+}
