@@ -0,0 +1,58 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.SoundListenerRange;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** PlaySound positions are signed fixed-point coordinates in eighths of a block. */
+public record PlaySound(String name, BlockPosition positionEighths, float volume, float pitch,
+                        int loopCount, boolean bypassListenerRange, Long serverHandle, Float playbackPosition) {
+
+    public static final Type<PlaySound> TYPE = new Type<>(PlaySound.class) {
+        @Override
+        public PlaySound read(final ByteBuf buffer) {
+            final String name = BedrockTypes.STRING.read(buffer);
+            final BlockPosition position = BedrockTypes.BLOCK_POSITION.read(buffer);
+            final float volume = buffer.readFloatLE();
+            final float pitch = buffer.readFloatLE();
+            final int loops = BedrockTypes.VAR_INT.readPrimitive(buffer);
+            final boolean bypassRange = buffer.readBoolean();
+            final Long handle = buffer.readBoolean() ? buffer.readLongLE() : null;
+            final Float playbackPosition = buffer.readBoolean() ? buffer.readFloatLE() : null;
+            return new PlaySound(name, position, volume, pitch, loops, bypassRange, handle, playbackPosition);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlaySound value) {
+            BedrockTypes.STRING.write(buffer, value.name);
+            BedrockTypes.BLOCK_POSITION.write(buffer, value.positionEighths);
+            buffer.writeFloatLE(value.volume);
+            buffer.writeFloatLE(value.pitch);
+            BedrockTypes.VAR_INT.writePrimitive(buffer, value.loopCount);
+            buffer.writeBoolean(value.bypassListenerRange);
+            buffer.writeBoolean(value.serverHandle != null);
+            if (value.serverHandle != null) {
+                buffer.writeLongLE(value.serverHandle);
+            }
+            buffer.writeBoolean(value.playbackPosition != null);
+            if (value.playbackPosition != null) {
+                buffer.writeFloatLE(value.playbackPosition);
+            }
+        }
+    };
+
+    /** Bedrock 1.26.51.1 admits a request strictly inside its supplied-volume listener radius. */
+    public boolean passesListenerRange(final float listenerX, final float listenerY, final float listenerZ) {
+        return this.bypassListenerRange || SoundListenerRange.passes(
+                new Position3f(this.positionEighths.x() / 8F, this.positionEighths.y() / 8F, this.positionEighths.z() / 8F),
+                new Position3f(listenerX, listenerY, listenerZ), this.volume);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/SoundUpdate.java b/src/main/java/net/raphimc/viabedrock/protocol/model/SoundUpdate.java
new file mode 100644
index 000000000..3285c7609
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/SoundUpdate.java
@@ -0,0 +1,114 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public record SoundUpdate(long handle, Event event) {
+
+    public static final Type<SoundUpdate> TYPE = new Type<>(SoundUpdate.class) {
+        @Override
+        public SoundUpdate read(final ByteBuf buffer) {
+            final long handle = buffer.readLongLE();
+            Event event = null;
+            // Protocol 2193 serializes the same variant member seven times. The last read wins.
+            for (int i = 0; i < 7; i++) {
+                event = readEvent(buffer);
+            }
+            return new SoundUpdate(handle, event);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final SoundUpdate value) {
+            buffer.writeLongLE(value.handle);
+            for (int i = 0; i < 7; i++) {
+                writeEvent(buffer, value.event);
+            }
+        }
+    };
+
+    public static Event readEvent(final ByteBuf buffer) {
+        return switch (BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer)) {
+            case 0 -> new Stop();
+            case 1 -> new Volume(buffer.readFloatLE());
+            case 2 -> new Pitch(buffer.readFloatLE());
+            case 3 -> new Fade(buffer.readFloatLE(), buffer.readFloatLE());
+            case 4 -> new Seek(buffer.readFloatLE());
+            case 5 -> new Pause();
+            case 6 -> new Resume();
+            default -> throw new IllegalArgumentException("Unknown sound update variant");
+        };
+    }
+
+    public static void writeEvent(final ByteBuf buffer, final Event event) {
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, event.id());
+        if (event instanceof Volume volume) {
+            buffer.writeFloatLE(volume.volume);
+        } else if (event instanceof Pitch pitch) {
+            buffer.writeFloatLE(pitch.pitch);
+        } else if (event instanceof Fade fade) {
+            buffer.writeFloatLE(fade.duration).writeFloatLE(fade.targetVolume);
+        } else if (event instanceof Seek seek) {
+            buffer.writeFloatLE(seek.seconds);
+        }
+    }
+
+    public sealed interface Event permits Stop, Volume, Pitch, Fade, Seek, Pause, Resume {
+        int id();
+    }
+
+    public record Stop() implements Event {
+        @Override
+        public int id() {
+            return 0;
+        }
+    }
+
+    public record Volume(float volume) implements Event {
+        @Override
+        public int id() {
+            return 1;
+        }
+    }
+
+    public record Pitch(float pitch) implements Event {
+        @Override
+        public int id() {
+            return 2;
+        }
+    }
+
+    public record Fade(float duration, float targetVolume) implements Event {
+        @Override
+        public int id() {
+            return 3;
+        }
+    }
+
+    public record Seek(float seconds) implements Event {
+        @Override
+        public int id() {
+            return 4;
+        }
+    }
+
+    public record Pause() implements Event {
+        @Override
+        public int id() {
+            return 5;
+        }
+    }
+
+    public record Resume() implements Event {
+        @Override
+        public int id() {
+            return 6;
+        }
+    }
+
+}
