+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PlaySoundTest {
+
+    @Test
+    void rejectsTheRadiusBoundaryAndExpandsOnlyAboveUnitVolume() {
+        for (final float volume : new float[]{-2, 0, 0.5F, 1, Float.NaN}) {
+            assertTrue(sound(127, 0, 0, volume, false).passesListenerRange(0, 0, 0));
+            assertFalse(sound(128, 0, 0, volume, false).passesListenerRange(0, 0, 0));
+        }
+        for (final float volume : new float[]{1.5F, 2, 4}) {
+            final int boundary = (int) (volume * 128);
+            assertTrue(sound(boundary - 1, 0, 0, volume, false).passesListenerRange(0, 0, 0));
+            assertFalse(sound(boundary, 0, 0, volume, false).passesListenerRange(0, 0, 0));
+        }
+    }
+
+    @Test
+    void measuresAllAxesFromTheListener() {
+        assertTrue(sound(-200, 560, -400, 1, false).passesListenerRange(-25, 70, -50));
+        assertTrue(sound(-104, 624, -368, 1, false).passesListenerRange(-25, 70, -50));
+        assertFalse(sound(-96, 624, -352, 1, false).passesListenerRange(-25, 70, -50));
+        for (final BlockPosition position : new BlockPosition[]{
+            new BlockPosition(-72, 560, -400),
+            new BlockPosition(-200, 688, -400),
+            new BlockPosition(-200, 560, -272)
+        }) {
+            assertFalse(new PlaySound("", position, 1, 1, 0, false, null, null).passesListenerRange(-25, 70, -50));
+        }
+    }
+
+    @Test
+    void roundsSourceCoordinatesBeforeSubtractingTheListener() {
+        final int origin = 268435456;
+        final float listener = 33554432;
+        assertTrue(sound(origin + 96, 0, 0, 1, false).passesListenerRange(listener, 0, 0));
+        assertFalse(sound(origin + 120, 0, 0, 1, false).passesListenerRange(listener, 0, 0));
+    }
+
+    @Test
+    void rejectsUnorderedDistancesAndPreservesTheBypass() {
+        for (final float listener : new float[]{Float.NaN, Float.NEGATIVE_INFINITY, Float.POSITIVE_INFINITY}) {
+            assertFalse(sound(0, 0, 0, 1, false).passesListenerRange(listener, 0, 0));
+            assertTrue(sound(0, 0, 0, 1, true).passesListenerRange(listener, 0, 0));
+        }
+        assertFalse(sound(Integer.MAX_VALUE, 0, 0, 1, false).passesListenerRange(0, 0, 0));
+        assertTrue(sound(Integer.MAX_VALUE, 0, 0, 1, true).passesListenerRange(0, 0, 0));
+        assertTrue(sound(Integer.MAX_VALUE, 0, 0, Float.POSITIVE_INFINITY, false).passesListenerRange(0, 0, 0));
+    }
+
+    private static PlaySound sound(final int x, final int y, final int z, final float volume, final boolean bypass) {
+        return new PlaySound("", new BlockPosition(x, y, z), volume, 1, 0, bypass, null, null);
+    }
+
+}
