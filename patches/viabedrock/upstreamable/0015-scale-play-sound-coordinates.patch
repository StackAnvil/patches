+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class WaveSoundTest {
+
+    @Test
+    void convertsIntegerWidthsAndInterleavedChannels() throws Exception {
+        for (final int bits : new int[]{8, 16, 24, 32}) {
+            final ByteBuffer samples = buffer(6 * bits / 8);
+            for (final int value : new int[]{Short.MIN_VALUE, -256, 0, 256, 32512, Short.MIN_VALUE}) {
+                final int encoded = bits == 8 ? (value >> 8) + 128 : value << (bits - 16);
+                for (int index = 0; index < bits / 8; index++) {
+                    samples.put((byte) (encoded >> (index * 8)));
+                }
+            }
+            final var audio = WaveSound.read(wave(format(1, 2, bits), samples.array()));
+            assertEquals(48000, audio.sampleRate());
+            assertEquals(2, audio.channels());
+            assertEquals(3, audio.frames());
+            assertArrayEquals(new short[]{Short.MIN_VALUE, -256, 0, 256, 32512, Short.MIN_VALUE}, shorts(audio.pcm()));
+        }
+    }
+
+    @Test
+    void clampsFloatingSamplesAndRejectsNonFiniteValues() throws Exception {
+        for (final int bits : new int[]{32, 64}) {
+            final ByteBuffer samples = buffer(6 * bits / 8);
+            for (final double value : new double[]{-2, -1, -0.5, 0, 0.5, 2}) {
+                if (bits == 32) {
+                    samples.putFloat((float) value);
+                } else {
+                    samples.putDouble(value);
+                }
+            }
+            assertArrayEquals(new short[]{-32768, -32768, -16384, 0, 16384, 32767},
+                    shorts(WaveSound.read(wave(format(3, 1, bits), samples.array())).pcm()));
+            for (final double value : new double[]{Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY}) {
+                if (bits == 32) {
+                    samples.putFloat(0, (float) value);
+                } else {
+                    samples.putDouble(0, value);
+                }
+                assertThrows(IOException.class, () -> WaveSound.read(wave(format(3, 1, bits), samples.array())));
+            }
+        }
+    }
+
+    @Test
+    void respectsExtensiblePrecisionAndSubtype() throws Exception {
+        final ByteBuffer format = buffer(40);
+        format.put(format(0xFFFE, 1, 24)).putShort((short) 22).putShort((short) 20).putInt(4)
+                .putInt(1).putInt(0x00100000).putLong(0x719B3800AA000080L);
+        final byte[] samples = {15, 0, (byte) 128, 15, 0, 0, (byte) 255, (byte) 255, 127};
+        assertArrayEquals(new short[]{-32768, 0, 32767}, shorts(WaveSound.read(wave(format.array(), samples)).pcm()));
+        format.putLong(32, 0);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), samples)));
+    }
+
+    @Test
+    void readsReorderedChunksAndOddMetadataWithPadding() throws Exception {
+        final byte[] data = {1, 0, 2, 0};
+        final byte[] file = chunks(chunk(0x4B4E554A, new byte[]{1}), chunk(0x61746164, data),
+                chunk(0x20746D66, format(1, 1, 16)));
+        assertArrayEquals(new short[]{1, 2}, shorts(WaveSound.read(file).pcm()));
+        for (final int size : new int[]{0, 4, 11, file.length - 1}) {
+            assertThrows(IOException.class, () -> WaveSound.read(Arrays.copyOf(file, size)));
+        }
+        buffer(file).putInt(16, Integer.MAX_VALUE);
+        assertThrows(IOException.class, () -> WaveSound.read(file));
+    }
+
+    @Test
+    void decodesStereoImaGroupsAndTrimsFinalPadding() throws Exception {
+        final ByteBuffer format = buffer(20);
+        format.put(format(17, 2, 4)).putShort((short) 2).putShort((short) 9).putShort(12, (short) 16);
+        final ByteBuffer samples = buffer(32);
+        for (int block = 0; block < 2; block++) {
+            samples.putShort((short) (1000 + block)).putShort((short) 0)
+                    .putShort((short) (-1000 - block)).putShort((short) 0)
+                    .putInt(0x11111111).putInt(0x99999999);
+        }
+        final var audio = WaveSound.read(chunks(chunk(0x20746D66, format.array()),
+                chunk(0x74636166, buffer(4).putInt(14).array()), chunk(0x61746164, samples.array())));
+        assertEquals(14, audio.frames());
+        final short[] expected = new short[28];
+        for (int frame = 0; frame < 14; frame++) {
+            final int base = frame < 9 ? 1000 : 1001;
+            final int value = base + frame % 9;
+            expected[frame * 2] = (short) value;
+            expected[frame * 2 + 1] = (short) -value;
+        }
+        assertArrayEquals(expected, shorts(audio.pcm()));
+        samples.put(2, (byte) 89);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), samples.array())));
+    }
+
+    @Test
+    void rejectsTruncatedImaGroupsAndInvalidFrameCounts() {
+        final ByteBuffer format = buffer(20);
+        format.put(format(17, 1, 4)).putShort((short) 2).putShort((short) 9).putShort(12, (short) 8);
+        for (final int size : new int[]{0, 3, 5, 7, 9}) {
+            assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), new byte[size])));
+        }
+        for (final int count : new int[]{0, 10, Integer.MAX_VALUE}) {
+            assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format.array()),
+                    chunk(0x74636166, buffer(4).putInt(count).array()), chunk(0x61746164, new byte[8]))));
+        }
+        final byte[] invalid = new byte[8];
+        invalid[3] = 1;
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), invalid)));
+    }
+
+    @Test
+    void rejectsAmbiguousLayoutsAndIncompleteFrames() {
+        final byte[] format = format(1, 2, 16);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format, new byte[3])));
+        assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format),
+                chunk(0x20746D66, format), chunk(0x61746164, new byte[4]))));
+        assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format),
+                chunk(0x61746164, new byte[4]), chunk(0x61746164, new byte[4]))));
+        final byte[] invalidRate = format.clone();
+        buffer(invalidRate).putInt(4, -1);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(invalidRate, new byte[4])));
+        for (final int offset : new int[]{0, 2, 12, 14}) {
+            final byte[] invalid = format.clone();
+            buffer(invalid).putShort(offset, (short) 65535);
+            assertThrows(IOException.class, () -> WaveSound.read(wave(invalid, new byte[4])));
+        }
+    }
+
+    private static byte[] format(final int codec, final int channels, final int bits) {
+        return buffer(16).putShort((short) codec).putShort((short) channels).putInt(48000)
+                .putInt(48000 * channels * bits / 8).putShort((short) (channels * bits / 8)).putShort((short) bits).array();
+    }
+
+    private static byte[] wave(final byte[] format, final byte[] samples) {
+        return chunks(chunk(0x20746D66, format), chunk(0x61746164, samples));
+    }
+
+    private static byte[] chunk(final int kind, final byte[] bytes) {
+        return buffer(8 + bytes.length + (bytes.length & 1)).putInt(kind).putInt(bytes.length).put(bytes).array();
+    }
+
+    private static byte[] chunks(final byte[]... chunks) {
+        final int size = Arrays.stream(chunks).mapToInt(chunk -> chunk.length).sum();
+        final ByteBuffer data = buffer(12 + size).putInt(0x46464952).putInt(4 + size).putInt(0x45564157);
+        for (final byte[] chunk : chunks) {
+            data.put(chunk);
+        }
+        return data.array();
+    }
+
+    private static short[] shorts(final byte[] bytes) {
+        final short[] samples = new short[bytes.length / 2];
+        buffer(bytes).asShortBuffer().get(samples);
+        return samples;
+    }
+
+    private static ByteBuffer buffer(final int size) {
+        return ByteBuffer.allocate(size).order(ByteOrder.LITTLE_ENDIAN);
+    }
+
+    private static ByteBuffer buffer(final byte[] bytes) {
+        return ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+    }
+
+}
