--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/SoundCaptions.java
@@ -0,0 +1,94 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Native caption admission, direction, localized duplicate refresh, and elapsed-time state. */
+public final class SoundCaptions {
+
+    private final List<Caption> captions = new ArrayList<>();
+    private Long updatedAt;
+
+    public static boolean admits(final String event, final String subtitle, final float suppliedVolume,
+                                 final boolean enabled, final boolean hideAmbient) {
+        return enabled && suppliedVolume > 0 && !event.isEmpty() && subtitle != null && !subtitle.isEmpty()
+                && !(hideAmbient && (subtitle.startsWith("subtitles.ambient.") || subtitle.startsWith("subtitles.weather.")));
+    }
+
+    public static Direction direction(final Position3f source, final Position3f player,
+                                      final Position3f forward, final Position3f up, final boolean ownSound) {
+        if (ownSound) {
+            return Direction.NONE;
+        }
+        final float rightZ = forward.x() * up.y() - forward.y() * up.x();
+        final float rightY = up.x() * forward.z() - forward.x() * up.z();
+        final float rightX = up.z() * forward.y() - up.y() * forward.z();
+        final float rightLength = (float) Math.sqrt(rightZ * rightZ + rightY * rightY + rightX * rightX);
+        final float x = source.x() - player.x();
+        final float y = source.y() - player.y();
+        final float z = source.z() - player.z();
+        final float length = (float) Math.sqrt(z * z + y * y + x * x);
+        final float normalizedZ = length >= 0.0001F ? z / length : 0;
+        final float normalizedY = length >= 0.0001F ? y / length : 0;
+        final float normalizedX = length < 0.0001F ? 0 : x / length;
+        final float front = forward.z() * normalizedZ + forward.y() * normalizedY + forward.x() * normalizedX;
+        if (!(front <= 0.5F)) {
+            return Direction.NONE;
+        }
+        final float horizontalZ = rightLength >= 0.0001F ? rightZ / rightLength : 0;
+        final float horizontalY = rightLength >= 0.0001F ? rightY / rightLength : 0;
+        final float horizontalX = rightLength < 0.0001F ? 0 : rightX / rightLength;
+        return horizontalZ * normalizedZ + horizontalY * normalizedY + horizontalX * normalizedX > 0
+                ? Direction.RIGHT : Direction.LEFT;
+    }
+
+    public void advance(final long nowNanos) {
+        if (this.updatedAt != null) {
+            final float elapsed = (float) (nowNanos - this.updatedAt) / 1_000_000_000F;
+            this.captions.replaceAll(caption -> new Caption(caption.text, caption.direction, caption.ownSound, caption.seconds - elapsed));
+        }
+        this.updatedAt = nowNanos;
+    }
+
+    public void refresh(final String text, final Direction direction, final boolean ownSound, final int durationMillis) {
+        this.captions.removeIf(caption -> caption.seconds <= 0);
+        final Caption replacement = new Caption(text, direction, ownSound, (float) durationMillis / 1000F);
+        for (int index = 0; index < this.captions.size(); index++) {
+            if (this.captions.get(index).text.equals(text)) {
+                this.captions.set(index, replacement);
+                return;
+            }
+        }
+        this.captions.add(replacement);
+    }
+
+    public List<Caption> visible(final boolean hideOwn) {
+        return this.captions.stream().filter(caption -> caption.seconds > 0 && !(hideOwn && caption.ownSound)).toList();
+    }
+
+    public void clear() {
+        this.captions.clear();
+        this.updatedAt = null;
+    }
+
+    public enum Direction {
+        NONE, LEFT, RIGHT
+    }
+
+    public record Caption(String text, Direction direction, boolean ownSound, float seconds) {
+
+        public float opacity() {
+            final float fade = Math.max(0, Math.min(1, 1 - this.seconds));
+            return 1 - fade * fade * fade * fade;
+        }
+
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/SoundListenerRange.java b/src/main/java/net/raphimc/viabedrock/api/model/SoundListenerRange.java
