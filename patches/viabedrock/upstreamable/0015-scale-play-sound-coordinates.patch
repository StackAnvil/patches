+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class SoundListenerRangeTest {
+
+    @Test
+    void retainsFloatCoordinatesAtTheLocalEmitterBoundary() {
+        final Position3f listener = new Position3f(0.0005F, 2, -3);
+        final float boundary = listener.x() + 16;
+        assertTrue(SoundListenerRange.passes(new Position3f(Math.nextDown(boundary), 2, -3), listener, 1));
+        assertFalse(SoundListenerRange.passes(new Position3f(boundary, 2, -3), listener, 1));
+        assertFalse(SoundListenerRange.passes(new Position3f(Math.nextUp(boundary), 2, -3), listener, 1));
+        assertTrue(SoundListenerRange.passes(new Position3f(boundary, 2, -3), listener, 2));
+        assertFalse(SoundListenerRange.passes(new Position3f(Float.NaN, 2, -3), listener, Float.POSITIVE_INFINITY));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibraryTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibraryTest.java
new file mode 100644
index 000000000..1d517698b
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibraryTest.java
@@ -0,0 +1,186 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+import java.util.UUID;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorLibraryTest {
+
+    @Test
+    void preservesResolvedOrderProvenanceTexturesAndCompleteActorDependencies() throws Exception {
+        final InMemoryContent builtin = content(1);
+        final InMemoryContent definition = content(2);
+        final InMemoryContent overlay = content(3);
+        for (final String directory : List.of("entity", "attachables", "models/entity", "animations", "animation_controllers", "render_controllers", "particles", "sounds", "items")) {
+            definition.put(directory + "/actor.json", new byte[]{1, 2, 3});
+        }
+        definition.put("materials/actor.material", new byte[]{4});
+        definition.put("sounds/actor.fsb", new byte[]{5});
+        definition.put("texts/en_US.lang", new byte[]{6});
+        definition.put("textures/actor.png", new byte[]{7});
+        overlay.put("textures/actor.png", new byte[]{8});
+        overlay.put("textures/builtin.jpg", new byte[]{9});
+        definition.put("scripts/private.js", new byte[]{10});
+        final ResourcePack lower = new ResourcePack(builtin);
+        final ResourcePack actor = new ResourcePack(definition);
+        final ResourcePack upper = new ResourcePack(overlay);
+        final byte[] encoded = NativeActorLibrary.encode(List.of(lower, actor, upper), pack -> pack != lower);
+        final var layers = NativeActorLibrary.decode(new ByteArrayInputStream(encoded));
+        assertEquals(List.of(false, true, true), layers.stream().map(NativeActorLibrary.Layer::server).toList());
+        assertEquals(1, layers.get(0).resources().size());
+        assertEquals(14, layers.get(1).resources().size());
+        assertArrayEquals(new byte[]{7}, layers.get(1).resources().get("textures/actor.png"));
+        assertArrayEquals(new byte[]{8}, layers.get(2).resources().get("textures/actor.png"));
+        assertArrayEquals(new byte[]{9}, layers.get(2).resources().get("textures/builtin.jpg"));
+        assertFalse(layers.get(1).resources().containsKey("scripts/private.js"));
+        assertArrayEquals(encoded, NativeActorLibrary.encode(List.of(lower, actor, upper), pack -> pack != lower));
+        assertThrows(UnsupportedOperationException.class, () -> layers.get(1).resources().clear());
+    }
+
+    @Test
+    void sharesEveryEffectKindWithoutShiftingEmptyAndTextureOnlyLayers() throws Exception {
+        final InMemoryContent empty = content(1);
+        final InMemoryContent definitions = content(2);
+        final InMemoryContent textures = content(3);
+        final List<String> paths = List.of("sounds.json", "sounds/sound_definitions.json", "sounds/a.ogg", "sounds/b.fsb", "sounds/c.wav",
+                "texts/en_US.lang", "particles/a.json", "render_controllers/a.json", "textures/a.png", "textures/b.tga", "other/c.png");
+        for (int index = 0; index < paths.size(); index++) {
+            definitions.put(paths.get(index), new byte[]{(byte) index, (byte) (index + 1)});
+        }
+        definitions.put("models/entity/a.json", new byte[]{42});
+        definitions.put("textures/actor.jpg", new byte[]{43});
+        definitions.put("animations/a.json", new byte[]{44});
+        textures.put("textures/a.png", new byte[]{45});
+        final List<ResourcePack> packs = List.of(new ResourcePack(empty), new ResourcePack(definitions), new ResourcePack(textures));
+        final var local = NativeActorLibrary.effects(NativeActorLibrary.resources(packs, pack -> pack != packs.get(0)));
+        final var decoded = NativeActorLibrary.effects(NativeActorLibrary.decode(new ByteArrayInputStream(
+                NativeActorLibrary.encode(packs, pack -> pack != packs.get(0)))));
+        assertEquals(3, decoded.size());
+        assertTrue(decoded.get(0).isEmpty());
+        assertEquals(paths.size(), decoded.get(1).size());
+        for (final String path : paths) {
+            assertArrayEquals(definitions.get(path), decoded.get(1).get(path));
+            assertArrayEquals(local.get(1).get(path), decoded.get(1).get(path));
+        }
+        assertEquals(1, decoded.get(2).size());
+        assertArrayEquals(new byte[]{45}, decoded.get(2).get("textures/a.png"));
+        assertThrows(UnsupportedOperationException.class, () -> decoded.get(1).clear());
+    }
+
+    @Test
+    void largeFramedArchivesPreserveProvenanceAndBytesAcrossBufferGrowth() throws Exception {
+        final InMemoryContent lower = content(1);
+        final InMemoryContent empty = content(2);
+        final InMemoryContent upper = content(3);
+        final byte[] data = new byte[3 * 1024 * 1024];
+        new Random(2193).nextBytes(data);
+        lower.put("textures/a.png", data);
+        lower.put("textures/b.png", new byte[data.length]);
+        upper.put("textures/a.png", data.clone());
+        final List<ResourcePack> packs = List.of(new ResourcePack(lower), new ResourcePack(empty), new ResourcePack(upper));
+        final byte[] archive = NativeActorLibrary.encode(packs, pack -> pack == packs.get(2));
+        assertTrue(archive.length > 4 * 1024 * 1024);
+        final var layers = NativeActorLibrary.decode(new ByteArrayInputStream(archive));
+        assertEquals(List.of(false, false, true), layers.stream().map(NativeActorLibrary.Layer::server).toList());
+        for (int index = 0; index < packs.size(); index++) {
+            final var expected = packs.get(index).content();
+            assertEquals(expected.getFilesDeep("", "").size(), layers.get(index).resources().size());
+            for (final String path : expected.getFilesDeep("", "")) {
+                assertArrayEquals(expected.get(path), layers.get(index).resources().get(path));
+            }
+        }
+        assertArrayEquals(archive, NativeActorLibrary.encode(packs, pack -> pack == packs.get(2)));
+    }
+
+    @Test
+    void reconstructsIndependentPackStateWithoutReorderingOrLosingServerOwnership() throws Exception {
+        final InMemoryContent builtin = content(1);
+        final InMemoryContent overlay = content(2);
+        builtin.putString("entity/player.json", "{\"format_version\":\"1.10.0\",\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"textures\":{\"default\":\"textures/base\"}}}}");
+        overlay.putString("entity/player.json", "{\"format_version\":\"1.10.0\",\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"textures\":{\"default\":\"textures/upper\"}}}}");
+        final ResourcePack lower = new ResourcePack(builtin);
+        final ResourcePack upper = new ResourcePack(overlay);
+        final var layers = NativeActorLibrary.decode(new ByteArrayInputStream(NativeActorLibrary.encode(List.of(lower, upper), pack -> pack == upper)));
+        final var storage = ResourcePackStorage.nativeActors(layers);
+        final var packs = List.copyOf(storage.getPackStackTopToBottom());
+        assertEquals(List.of(upper.key(), lower.key()), packs.stream().map(ResourcePack::key).toList());
+        assertTrue(storage.isServerPack(packs.get(0)));
+        assertFalse(storage.isServerPack(packs.get(packs.size() - 1)));
+        assertTrue(storage.isLoadedOnJavaClient());
+        assertEquals(2, storage.getPackStackBottomToTop().size());
+        assertEquals(upper.content().getString("entity/player.json"), packs.get(0).content().getString("entity/player.json"));
+        assertEquals("textures/upper", storage.getEntities().get("minecraft:player").entityData().getTextures().get("default"));
+        final byte first = packs.get(0).content().get("entity/player.json")[0];
+        layers.get(layers.size() - 1).resources().get("entity/player.json")[0] = 0;
+        assertEquals(first, packs.get(0).content().get("entity/player.json")[0]);
+        assertThrows(IOException.class, () -> ResourcePackStorage.nativeActors(List.of(new NativeActorLibrary.Layer(true, Map.of()))));
+    }
+
+    @Test
+    void rejectsMalformedHeadersRolesArchiveIndexesAndResourcePaths() throws Exception {
+        final ResourcePack pack = new ResourcePack(content(1));
+        final byte[] valid = NativeActorLibrary.encode(List.of(pack), ignored -> true);
+        for (final int offset : List.of(0, 4, 8, 12)) {
+            final byte[] invalid = valid.clone();
+            invalid[offset] = 127;
+            assertThrows(IOException.class, () -> NativeActorLibrary.decode(new ByteArrayInputStream(invalid)));
+        }
+        for (int size = 0; size < 13; size++) {
+            final byte[] truncated = Arrays.copyOf(valid, size);
+            assertThrows(IOException.class, () -> NativeActorLibrary.decode(new ByteArrayInputStream(truncated)));
+        }
+        for (final String path : List.of("1/entity/actor.json", "0/textures/../actor.png", "0/textures//actor.png", "0/scripts/private.js")) {
+            assertThrows(IOException.class, () -> decode(1, path));
+        }
+        assertThrows(IOException.class, () -> decode(0, "0/entity/actor.json"));
+        final InMemoryContent escaping = content(2);
+        escaping.put("textures/../actor.png", new byte[]{1});
+        assertThrows(IOException.class, () -> NativeActorLibrary.encode(List.of(new ResourcePack(escaping)), ignored -> true));
+    }
+
+    private static InMemoryContent content(final long id) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"Actor test\",\"uuid\":\"" + new UUID(0, id) + "\",\"version\":[1,0,0]}}");
+        return content;
+    }
+
+    private static void decode(final int innerCount, final String path) throws IOException {
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        final DataOutputStream fields = new DataOutputStream(bytes);
+        fields.writeInt(1);
+        fields.writeInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        fields.writeInt(1);
+        fields.writeByte(1);
+        try (ZipOutputStream zip = new ZipOutputStream(bytes)) {
+            zip.putNextEntry(new ZipEntry("header"));
+            zip.write(ByteBuffer.allocate(12).putInt(1).putInt(ProtocolConstants.BEDROCK_PROTOCOL_VERSION).putInt(innerCount).array());
+            zip.closeEntry();
+            zip.putNextEntry(new ZipEntry(path));
+            zip.write(1);
+            zip.closeEntry();
+        }
+        NativeActorLibrary.decode(new ByteArrayInputStream(bytes.toByteArray()));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/NativeResourceArchiveTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/NativeResourceArchiveTest.java
