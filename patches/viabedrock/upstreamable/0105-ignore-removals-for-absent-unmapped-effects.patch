+package net.raphimc.viabedrock.protocol.packet;
+
+import com.google.common.collect.HashBiMap;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.remapper.PacketHandler;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.LivingEntity;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+import java.lang.reflect.Field;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class MobEffectPacketTest {
+
+    @Test
+    void unmappedRemovalPreservesTheActiveEffectUntilItsOwnRemoval() throws Exception {
+        try (var fixture = new Fixture()) {
+            final var added = fixture.receive(1, 1);
+            assertFalse(added.isCancelled());
+            final var speed = fixture.entity.effects().get("minecraft:speed");
+            assertNotNull(speed);
+            assertTrue(fixture.receive(3, 38).isCancelled());
+            assertSame(speed, fixture.entity.effects().get("minecraft:speed"));
+            final var removed = fixture.receive(3, 1);
+            assertEquals(ClientboundPackets26_3.REMOVE_MOB_EFFECT, removed.getPacketType());
+            assertEquals(3, removed.get(Types.VAR_INT, 0));
+            assertEquals(1, removed.get(Types.VAR_INT, 1));
+            assertTrue(fixture.entity.effects().isEmpty());
+        }
+    }
+
+    @Test
+    void unmappedAdditionsAndUpdatesStillRejectUnsupportedEffects() throws Exception {
+        try (var fixture = new Fixture()) {
+            for (final int event : new int[]{1, 2}) {
+                assertThrows(IllegalStateException.class, () -> fixture.receive(event, 38));
+                assertTrue(fixture.entity.effects().isEmpty());
+            }
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final Map<Field, Object> original = new LinkedHashMap<>();
+        private final UserConnection user = mock(UserConnection.class);
+        private final LivingEntity entity = new LivingEntity(this.user, 1, 2, "minecraft:player", 3, null, EntityTypes26_3.PLAYER);
+        private final PacketHandler handler;
+
+        private Fixture() throws Exception {
+            this.mapping("bedrockEffects", HashBiMap.create(Map.of("minecraft:speed", 1)));
+            this.mapping("javaEffects", HashBiMap.create(Map.of("minecraft:speed", 1)));
+            this.mapping("bedrockToJavaEffects", Map.of("minecraft:speed", "minecraft:speed"));
+            final var tracker = mock(EntityTracker.class);
+            when(this.user.get(EntityTracker.class)).thenReturn(tracker);
+            when(tracker.getEntityByRid(2)).thenReturn(this.entity);
+            final var protocol = mock(BedrockProtocol.class);
+            EntityPackets.register(protocol);
+            final var handler = ArgumentCaptor.forClass(PacketHandler.class);
+            verify(protocol).registerClientbound(eq(ClientboundBedrockPackets.MOB_EFFECT),
+                    eq(ClientboundPackets26_3.UPDATE_MOB_EFFECT), handler.capture());
+            this.handler = handler.getValue();
+        }
+
+        private void mapping(final String name, final Object value) throws ReflectiveOperationException {
+            final var field = BedrockProtocol.MAPPINGS.getClass().getDeclaredField(name);
+            field.setAccessible(true);
+            this.original.put(field, field.get(BedrockProtocol.MAPPINGS));
+            field.set(BedrockProtocol.MAPPINGS, value);
+        }
+
+        private PacketWrapper receive(final int event, final int effect) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, 2);
+                input.writeByte(event);
+                BedrockTypes.VAR_INT.writePrimitive(input, effect);
+                BedrockTypes.VAR_INT.writePrimitive(input, 1);
+                input.writeBoolean(false);
+                BedrockTypes.VAR_INT.writePrimitive(input, 1200);
+                BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(input, 0);
+                input.writeBoolean(false);
+                final var packet = new PacketWrapperImpl(ClientboundBedrockPackets.MOB_EFFECT, input, this.user);
+                this.handler.handle(packet);
+                assertFalse(input.isReadable());
+                return packet;
+            } finally {
+                input.release();
+            }
+        }
+
+        @Override
+        public void close() throws IllegalAccessException {
+            for (final var entry : this.original.entrySet()) {
+                entry.getKey().set(BedrockProtocol.MAPPINGS, entry.getValue());
+            }
+        }
+    }
+
+}
