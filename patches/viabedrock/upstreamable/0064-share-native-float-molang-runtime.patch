+package net.raphimc.viabedrock.api.util;
+
+/** The native float lookup shared by actor expressions and view bobbing. */
+public final class BedrockTrigonometry {
+
+    private static final float[] SINE = BedrockSineTable.create();
+
+    private BedrockTrigonometry() {
+    }
+
+    public static float sine(final float radians) {
+        return SINE[index(radians * 10430.378F)];
+    }
+
+    public static float cosine(final float radians) {
+        return SINE[index(radians * 10430.378F + 16384F)];
+    }
+
+    private static int index(final float value) {
+        // Native cvttss2si yields INT_MIN for invalid conversions, whose low 16 bits are zero.
+        return value >= -0x1p31F && value < 0x1p31F ? (int) value & 65535 : 0;
+    }
+
+}
