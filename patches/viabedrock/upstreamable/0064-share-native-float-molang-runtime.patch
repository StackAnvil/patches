+    @Test
+    void reducesHalfTurnsAndLargeFiniteAnglesWithoutIteration() {
+        assertTimeoutPreemptively(Duration.ofSeconds(2), () -> {
+            assertEquals(-180F, MoLangMath.minAngle(180F));
+            assertEquals(-180F, MoLangMath.minAngle(-180F));
+            assertEquals(-180F, MoLangMath.minAngle(540F));
+            assertEquals(0F, MoLangMath.minAngle(-720F));
+            assertEquals(-60F, MoLangMath.minAngle(1E30F));
+            assertEquals(60F, MoLangMath.minAngle(-1E30F));
+            assertTrue(Float.isFinite(MoLangMath.minAngle(Float.MAX_VALUE)));
+            assertTrue(Float.isFinite(MoLangMath.minAngle(-Float.MAX_VALUE)));
+        });
+    }
+
+    @Test
+    void preservesDirectedEndpointsWrapsTiesAndAllowsExtrapolation() throws Exception {
+        final float[][] cases = {
+            {90F, 0F, 0F, 90F}, {90F, 0F, .25F, 67.5F}, {90F, 0F, 1F, 0F},
+            {350F, 10F, .5F, 360F}, {10F, 350F, .5F, 0F}, {0F, 180F, .5F, -90F},
+            {180F, 0F, .5F, 90F}, {90F, 0F, 2F, -90F}, {720F, -90F, 1F, 630F}
+        };
+        for (float[] row : cases) {
+            assertEquals(row[3], MoLangMath.lerpRotate(row[0], row[1], row[2]));
+        }
+        final Scope scope = MolangInterpreter.standard().scope();
+        final MutableObjectBinding variables = new MutableObjectBinding();
+        scope.set("v", variables);
+        assertEquals(1.25F, MoLangEngine.eval(scope,
+                "v.n=0; return math.lerprotate(v.n=v.n+1,v.n=v.n+1,(v.n=v.n+1)/12);").getAsNumber());
+        assertEquals(3F, variables.get("n").getAsNumber());
+        assertEquals(-180F, MoLangEngine.eval(scope, "math.min_angle(180)").getAsNumber());
+        assertEquals(.25F, MoLangEngine.eval(scope, "math.ease_in_quad(0,1,0.5)").getAsNumber());
+        assertEquals(2F, MoLangEngine.eval(scope, "math.inverse_lerp(5,7,9)").getAsNumber());
+        assertEquals(3F, MoLangEngine.eval(scope, "math.abs(-3)").getAsNumber());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_MOLANG_ANGLES", matches = ".+")
+    void matchesNativeConstantAndRuntimeAngleCases() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_MOLANG_ANGLES")))).getAsJsonObject();
+        final Scope scope = MolangInterpreter.standard().scope();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        scope.set("q", queries);
+        final var angleProgram = MoLangEngine.parse("math.min_angle(q.a)");
+        final var rotationProgram = MoLangEngine.parse("math.lerprotate(q.a,q.b,q.t)");
+        for (var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var args = row.getAsJsonArray("arguments");
+            final float a = args.get(0).getAsFloat();
+            final boolean rotation = args.size() == 3;
+            final float b = rotation ? args.get(1).getAsFloat() : 0F;
+            final float t = rotation ? args.get(2).getAsFloat() : 0F;
+            final float expected = Float.intBitsToFloat((int) row.get("resultBits").getAsLong());
+            final float result = rotation ? MoLangMath.lerpRotate(a, b, t) : MoLangMath.minAngle(a);
+            assertEquals(Float.floatToIntBits(expected), Float.floatToIntBits(result), row.toString());
+            queries.set("a", Value.of(a));
+            queries.set("b", Value.of(b));
+            queries.set("t", Value.of(t));
+            assertEquals(Float.isFinite(expected) ? (expected == 0F ? 0F : expected) : 0F,
