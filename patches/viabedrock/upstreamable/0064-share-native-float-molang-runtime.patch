+package net.raphimc.viabedrock.api.util;
+
+/** Builds the bounded lookup with the target Windows runtime's float rounding. */
+final class BedrockSineTable {
+
+    private BedrockSineTable() {
+    }
+
+    static float[] create() {
+        final float[] values = new float[65536];
+        for (int index = 0; index < values.length; index++) {
+            values[index] = entry(index / 10430.378F);
+        }
+        return values;
+    }
+
+    // This producer only receives nonnegative float arguments below 2*pi.
+    // Keep the double operation order: a double sine rounded to float differs at 85 entries.
+    private static float entry(final float angle) {
+        final double x = angle;
+        int quadrant = 0;
+        double reduced = x;
+        if (angle > (float) (Math.PI / 4D)) {
+            quadrant = (int) (x * 0x1.45F306DC9C883p-1 + 0.5D);
+            final double head = x - quadrant * 0x1.921FB54400000p0;
+            final double tail = quadrant * 0x1.0B4611A626331p-34;
+            reduced = head - tail;
+            if (Math.getExponent(x) - Math.getExponent(reduced) > 15) {
+                final double correction = quadrant * 0x1.0B4611A600000p-34;
+                final double refined = head - correction;
+                final double remainder = quadrant * 0x1.3198A2E037073p-69 - ((head - refined) - correction);
+                reduced = refined - remainder;
+            }
+        }
+
+        final double squared = reduced * reduced;
+        final double fourth = squared * squared;
+        final double value;
+        if ((quadrant & 1) == 0) {
+            final double low = -0x1.5555555555555p-3 + squared * 0x1.1111111111111p-7;
+            final double high = -0x1.A01A01A01A01Ap-13 + squared * 0x1.71DE3A556C734p-19;
+            value = reduced + (squared * reduced) * (high * fourth + low);
+        } else {
+            final double low = 0x1.5555555555555p-5 + squared * -0x1.6C16C16C16C16p-10;
+            final double high = 0x1.A01A01A01A019p-16 + squared * -0x1.27E4FB7789F5Cp-22;
+            value = (1D - 0.5D * squared) + fourth * (high * fourth + low);
+        }
+        return (float) ((quadrant & 2) == 0 ? value : -value);
+    }
+
+}
