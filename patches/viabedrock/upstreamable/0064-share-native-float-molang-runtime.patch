+        assertEquals(0F, MoLangEngine.eval(scope, "v.a=7;v.a+1;").getAsNumber());
+        assertEquals(7F, MoLangEngine.eval(scope, "v.a").getAsNumber());
+        assertEquals(0F, MoLangEngine.eval(scope, "1?2:3;").getAsNumber());
+        assertEquals(2F, MoLangEngine.eval(scope, "1?2:3").getAsNumber());
+        assertEquals(0F, MoLangEngine.eval(scope, "return 2").getAsNumber());
+        assertEquals(2F, MoLangEngine.eval(scope, "1?{return 2;};").getAsNumber());
+        assertEquals(0F, MoLangEngine.eval(scope, "0?{return 2;};").getAsNumber());
+        assertThrows(ParseException.class, () -> MoLangEngine.parse("return 2;3;"));
+        assertThrows(ParseException.class, () -> MoLangEngine.parse("1?return 2:3;"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_MOLANG_EVALUATION_REFERENCE", matches = ".+")
+    void matchesNativeConstantStatementResults() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_MOLANG_EVALUATION_REFERENCE")))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final String expression = row.getAsJsonObject("input").getAsJsonObject("direction").getAsJsonArray("custom_direction").get(1).getAsString();
+            if (row.getAsJsonArray("rejected").get(0).getAsInt() != 0) {
+                assertThrows(ParseException.class, () -> MoLangEngine.parse(expression), expression);
+            } else {
+                for (final var sample : row.getAsJsonArray("samples")) {
+                    final float expected = sample.getAsJsonObject().getAsJsonArray("direction").get(1).getAsFloat();
+                    assertEquals(expected, MoLangEngine.eval(scope(), expression).getAsNumber(), expression);
+                }
+            }
+        }
+        assertFalse(fixture.getAsJsonArray("cases").isEmpty());
+    }
+
+    @Test
+    void unwindsNestedReturnsBeforeLaterMutations() throws Exception {
+        final Scope scope = scope();
+        assertEquals(2F, MoLangEngine.eval(scope, "v.a=0;1?{1?{return 2;};v.a=1;};v.a=2;return 3;").getAsNumber());
+        assertEquals(0F, MoLangEngine.eval(scope, "v.a").getAsNumber());
+        assertEquals(4F, MoLangEngine.eval(scope, "loop(3,{1?{return 4;};v.a=1;});v.a=2;return 3;").getAsNumber());
+        assertEquals(0F, MoLangEngine.eval(scope, "v.a").getAsNumber());
+    }
+
+    @Test
+    void countsFloatLoopRemaindersAndTargetsTheNearestLoop() throws Exception {
+        final Scope scope = scope();
+        assertEquals(1F, MoLangEngine.eval(scope, "v.n=0;loop(.5,{v.n=v.n+1;});return v.n;").getAsNumber());
+        assertEquals(2F, MoLangEngine.eval(scope, "v.n=0;loop(1.5,{v.n=v.n+1;});return v.n;").getAsNumber());
+        assertEquals(1025F, MoLangEngine.eval(scope, "v.n=0;loop(1025,{v.n=v.n+1;});return v.n;").getAsNumber());
+        assertEquals(3F, MoLangEngine.eval(scope, "v.n=0;loop(3,{loop(3,{v.n=v.n+1;break;});});return v.n;").getAsNumber());
+        assertEquals(3F, MoLangEngine.eval(scope, "v.n=0;loop(3,{v.n=v.n+1;1?{continue;};v.n=v.n+100;});return v.n;").getAsNumber());
+    }
+
+    @Test
+    void sharesTheHostBudgetAcrossLoopsAndPreservesCompletedMutations() throws Exception {
+        final Scope scope = scope();
+        assertTimeoutPreemptively(java.time.Duration.ofSeconds(2), () -> {
+            assertEquals(0F, MoLangEngine.eval(scope, "v.n=0;loop(10000,{v.n=v.n+1;});loop(10000,{v.n=v.n+1;});return v.n;").getAsNumber());
+            assertEquals(16384F, MoLangEngine.eval(scope, "v.n").getAsNumber());
+            assertEquals(0F, MoLangEngine.eval(scope, "loop(1000000,{continue;});return 3;").getAsNumber());
+        });
+    }
+
+    @Test
+    void iteratesArraysWithNestedReturnsAndJumps() throws Exception {
+        final Scope scope = scope();
+        final MutableObjectBinding arrays = new MutableObjectBinding();
+        arrays.set("values", Value.of(new double[]{1, 2, 3}));
+        scope.set("array", arrays);
+        assertEquals(6F, MoLangEngine.eval(scope, "v.sum=0;for_each(v.item,array.values,{v.sum=v.sum+v.item;});return v.sum;").getAsNumber());
+        assertEquals(2F, MoLangEngine.eval(scope, "for_each(v.item,array.values,{v.item==2?{return v.item;};});return 4;").getAsNumber());
+        assertEquals(4F, MoLangEngine.eval(scope, "v.sum=0;for_each(v.item,array.values,{v.item==2?{continue;};v.sum=v.sum+v.item;v.item==3?{break;};});return v.sum;").getAsNumber());
+    }
+
+    @Test
+    void reusedProgramsKeepVariablesInTheirCallerAndResetTemporaryState() throws Exception {
+        final var expressions = new MoLangEngine.CompiledExpressions();
+        final Scope first = scope();
+        final Scope second = scope();
+        final String source = "v.n=(v.n??0)+1;t.n=(t.n??0)+1;return v.n+t.n;";
+        assertEquals(2F, expressions.eval(first, source).getAsNumber());
+        assertEquals(3F, expressions.eval(first, source).getAsNumber());
+        assertEquals(2F, expressions.eval(second, source).getAsNumber());
+        assertEquals(4F, expressions.eval(first, source).getAsNumber());
+        assertEquals(0F, expressions.eval(first, "t.n??0").getAsNumber());
+    }
+
+    private static Scope scope() {
+        final Scope scope = Scope.create();
+        final MutableObjectBinding variables = new MutableObjectBinding();
+        scope.set("variable", variables);
+        scope.set("v", variables);
+        return scope;
+    }
+
+}
