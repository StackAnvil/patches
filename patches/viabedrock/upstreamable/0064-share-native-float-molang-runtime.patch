+            if (!programs.containsKey(name)) {
+                programs.put(name, MoLangEngine.parse(name + "(q.a,q.b,q.t)"));
+            }
+            final var args = row.getAsJsonArray("arguments");
+            queries.set("a", Value.of(args.get(0).getAsFloat()));
