+package net.raphimc.viabedrock.api.util;
+
+import org.redlance.mocha.runtime.value.Function;
+import org.redlance.mocha.runtime.value.NumberValue;
+import org.redlance.mocha.runtime.value.ObjectProperty;
+import org.redlance.mocha.runtime.value.ObjectValue;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import static net.raphimc.viabedrock.api.util.BedrockTrigonometry.cosine;
+import static net.raphimc.viabedrock.api.util.BedrockTrigonometry.sine;
+
+/** Shared Molang functions using the target Bedrock float arithmetic. */
+public final class MoLangMath {
+
+    private static final float PI = (float) Math.PI;
+    private static final float TAU = 2F * PI;
+    private static final Map<String, ObjectProperty> FUNCTIONS = functions();
+
+    private MoLangMath() {
+    }
+
+    public static ObjectValue extend(final ObjectValue standard) {
+        return name -> {
+            final ObjectProperty property = FUNCTIONS.get(name.toLowerCase(Locale.ROOT));
+            return property == null ? standard.getProperty(name) : property;
+        };
+    }
+
+    private static Map<String, ObjectProperty> functions() {
+        final Map<String, ObjectProperty> functions = new HashMap<>();
+        functions.put("min_angle", ObjectProperty.property((Function<Object>) (_, arguments) ->
+                NumberValue.of(minAngle(arguments.next().eval().getAsNumber())), true));
+        functions.put("lerprotate", ObjectProperty.property((Function<Object>) (_, arguments) -> {
+            final float start = arguments.next().eval().getAsNumber();
+            final float end = arguments.next().eval().getAsNumber();
+            final float progress = arguments.next().eval().getAsNumber();
+            return NumberValue.of(lerpRotate(start, end, progress));
+        }, true));
+        for (final Operation operation : Operation.values()) {
+            final Function<Object> function =
+                    (_, arguments) -> {
+                        final float start = arguments.next().eval().getAsNumber();
+                        final float end = arguments.next().eval().getAsNumber();
+                        final float progress = arguments.next().eval().getAsNumber();
+                        return NumberValue.of(operation.evaluate(start, end, progress));
+                    };
+            functions.put(
+                    operation.name().toLowerCase(Locale.ROOT),
+                    ObjectProperty.property(function, true));
+        }
+        return Map.copyOf(functions);
+    }
+
+    /** Native reduction adds the half-turn before the remainder, including float rounding. */
+    public static float minAngle(final float angle) {
+        float reduced = (angle + 180F) % 360F;
+        if (reduced < 0F) {
+            reduced += 360F;
+        }
+        return reduced - 180F;
+    }
+
+    /** Preserve the authored start angle and interpolate its shortest directed delta. */
+    public static float lerpRotate(final float start, final float end, final float progress) {
+        return minAngle(end - start) * progress + start;
+    }
+
+    private enum Operation {
+        INVERSE_LERP,
+        EASE_IN_QUAD,
+        EASE_OUT_QUAD,
+        EASE_IN_OUT_QUAD,
+        EASE_IN_CUBIC,
+        EASE_OUT_CUBIC,
+        EASE_IN_OUT_CUBIC,
+        EASE_IN_QUART,
+        EASE_OUT_QUART,
+        EASE_IN_OUT_QUART,
+        EASE_IN_QUINT,
+        EASE_OUT_QUINT,
+        EASE_IN_OUT_QUINT,
+        EASE_IN_SINE,
+        EASE_OUT_SINE,
+        EASE_IN_OUT_SINE,
+        EASE_IN_EXPO,
+        EASE_OUT_EXPO,
+        EASE_IN_OUT_EXPO,
+        EASE_IN_CIRC,
+        EASE_OUT_CIRC,
+        EASE_IN_OUT_CIRC,
+        EASE_IN_BOUNCE,
+        EASE_OUT_BOUNCE,
+        EASE_IN_OUT_BOUNCE,
+        EASE_IN_BACK,
+        EASE_OUT_BACK,
+        EASE_IN_OUT_BACK,
+        EASE_IN_ELASTIC,
+        EASE_OUT_ELASTIC,
+        EASE_IN_OUT_ELASTIC;
+
+        float evaluate(final float start, final float end, final float t) {
+            final float distance = end - start;
+            final float doubled = t + t;
+            final float previous = t - 1F;
+            final float after = doubled - 2F;
+            return switch (this) {
+                case INVERSE_LERP -> (t - start) / distance;
+                case EASE_IN_QUAD -> distance * t * t + start;
+                case EASE_OUT_QUAD -> -distance * t * (t - 2F) + start;
+                case EASE_IN_OUT_QUAD ->
+                    doubled >= 1F
+                            ? distance * -.5F * ((doubled - 3F) * (doubled - 1F) - 1F) + start
+                            : distance * .5F * doubled * doubled + start;
+                case EASE_IN_CUBIC -> distance * t * t * t + start;
+                case EASE_OUT_CUBIC -> (previous * previous * previous + 1F) * distance + start;
+                case EASE_IN_OUT_CUBIC ->
+                    doubled >= 1F
+                            ? distance * .5F * (after * after * after + 2F) + start
+                            : distance * .5F * doubled * doubled * doubled + start;
+                case EASE_IN_QUART -> distance * t * t * t * t + start;
+                case EASE_OUT_QUART ->
+                    start - (previous * previous * previous * previous - 1F) * distance;
+                case EASE_IN_OUT_QUART ->
+                    doubled >= 1F
+                            ? distance * -.5F * (after * after * after * after - 2F) + start
+                            : distance * .5F * doubled * doubled * doubled * doubled + start;
+                case EASE_IN_QUINT -> distance * t * t * t * t * t + start;
+                case EASE_OUT_QUINT ->
+                    (previous * previous * previous * previous * previous + 1F) * distance
+                                + start;
+                case EASE_IN_OUT_QUINT ->
+                    doubled >= 1F
+                            ? distance * .5F * (after * after * after * after * after + 2F)
+                                        + start
+                            : distance * .5F * doubled * doubled * doubled * doubled * doubled
+                                        + start;
+                case EASE_IN_SINE -> distance - cosine(t * (PI / 2F)) * distance + start;
+                case EASE_OUT_SINE -> distance * sine(t * (PI / 2F)) + start;
+                case EASE_IN_OUT_SINE -> (cosine(t * PI) - 1F) * (distance * -.5F) + start;
+                // The target's exponential curves do not special-case their endpoints.
+                case EASE_IN_EXPO -> exp2(previous * 10F) * distance + start;
+                case EASE_OUT_EXPO -> (1F - exp2(t * -10F)) * distance + start;
+                case EASE_IN_OUT_EXPO ->
+                    doubled >= 1F
+                            ? start + (2F - exp2((doubled - 1F) * -10F)) * distance * .5F
+                            : start + exp2((doubled - 1F) * 10F) * distance * .5F;
+                case EASE_IN_CIRC -> start - distance * (sqrt(1F - t * t) - 1F);
+                case EASE_OUT_CIRC -> start + distance * sqrt(1F - previous * previous);
+                case EASE_IN_OUT_CIRC ->
+                    doubled >= 1F
+                            ? start + distance * .5F * (1F + sqrt(1F - after * after))
+                            : start + distance * -.5F * (-1F + sqrt(1F - doubled * doubled));
+                case EASE_IN_BOUNCE -> distance - bounce(1F - t) * distance + start;
+                case EASE_OUT_BOUNCE -> bounce(t) * distance + start;
+                case EASE_IN_OUT_BOUNCE ->
+                    t < .5F
+                            ? (distance - bounce(1F - doubled) * distance) * .5F + start
+                            : bounce(doubled - 1F) * distance * .5F + distance * .5F + start;
+                case EASE_IN_BACK -> (t * 2.70158F - 1.70158F) * distance * t * t + start;
+                case EASE_OUT_BACK ->
+                    ((previous * 2.70158F + 1.70158F) * previous * previous + 1F) * distance
+                                + start;
+                case EASE_IN_OUT_BACK ->
+                    start
+                                + (doubled >= 1F
+                                            ? (after * 3.5949094F + 2.5949094F) * after * after
+                                                        + 2F
+                                            : (doubled * 3.5949094F - 2.5949094F)
+                                                        * doubled
+                                                        * doubled)
+                                        * (distance * .5F);
+                case EASE_IN_ELASTIC ->
+                    t == 0F
+                            ? start
+                            : t == 1F
+                                    ? start + distance
+                                    : start
+                                                - distance
+                                                        * exp2(10F * previous)
+                                                        * elasticSine(previous);
+                case EASE_OUT_ELASTIC ->
+                    t == 0F
+                            ? start
+                            : t == 1F
+                                    ? start + distance
+                                    : start
+                                                + exp2(-10F * t) * distance * elasticSine(t)
+                                                + distance;
+                case EASE_IN_OUT_ELASTIC ->
+                    t == 0F
+                            ? start
+                            : doubled == 2F
+                                    ? start + distance
+                                    : doubled >= 1F
+                                            ? start
+                                                        + (exp2((doubled - 1F) * -10F)
+                                                                        * distance
+                                                                        * elasticSine(doubled - 1F)
+                                                                        * .5F
+                                                                + distance)
+                                            : start
+                                                        + distance
+                                                                * exp2((doubled - 1F) * 10F)
+                                                                * elasticSine(doubled - 1F)
+                                                                * -.5F;
+            };
+        }
+    }
+
+    private static float bounce(float t) {
+        if (t < .36363637F) {
+            return 7.5625F * t * t;
+        }
+        final float offset;
+        if (t < .72727275F) {
+            t -= .54545456F;
+            offset = .75F;
+        } else if (t < .90909094F) {
+            t -= .8181818F;
+            offset = .9375F;
+        } else {
+            t -= .95454544F;
+            offset = .984375F;
+        }
+        return 7.5625F * t * t + offset;
+    }
+
+    private static float sqrt(final float value) {
+        return (float) Math.sqrt(value);
+    }
+
+    private static float exp2(final float value) {
+        return (float) Math.pow(2D, value);
+    }
+
+    private static float elasticSine(final float phase) {
+        return sine((phase - .075F) * TAU / .3F);
+    }
+
+}
