+        final Scope scope = MolangInterpreter.standard().scope();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        scope.set("q", queries);
+        final var programs = new HashMap<String, List<Expression>>();
+        for (var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
