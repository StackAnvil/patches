+package net.raphimc.viabedrock.api.util;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockTrigonometryTest {
+
+    @Test
+    void preservesWindowsFloatRoundingAcrossTheBoundedPolynomials() {
+        final float[] values = BedrockSineTable.create();
+        // Independent Windows SSE/FMA execution; these values distinguish rounded double sine and Wine.
+        for (final int[] entry : new int[][]{
+                {7079, 0x3F20B5D3}, {8289, 0x3F36B1E6}, {16436, 0x3F7FFF30},
+                {25023, 0x3F2D1909}, {27232, 0x3F019573}, {40431, 0xBF2B9C17},
+                {40924, 0xBF3464BC}, {57751, 0xBF2DD1DF}, {60079, 0xBEFFD0D2}}) {
+            assertEquals(entry[1], Float.floatToRawIntBits(values[entry[0]]));
+        }
+    }
+
+    @Test
+    void usesNativeInvalidConversionInsteadOfJavaSaturation() {
+        for (final float angle : new float[]{Float.MAX_VALUE, -Float.MAX_VALUE, Float.POSITIVE_INFINITY,
+            Float.NEGATIVE_INFINITY, Float.NaN}) {
+            assertEquals(0, Float.floatToRawIntBits(BedrockTrigonometry.sine(angle)));
+            assertEquals(0, Float.floatToRawIntBits(BedrockTrigonometry.cosine(angle)));
+        }
+        for (final float angle : new float[]{0F, -0F, Float.MIN_VALUE, -Float.MIN_VALUE}) {
+            assertEquals(0, Float.floatToRawIntBits(BedrockTrigonometry.sine(angle)));
+            assertEquals(1F, BedrockTrigonometry.cosine(angle));
+        }
+    }
+
+    @Test
+    void convertsTheCosineShiftBeforeCheckingItsOwnBoundary() {
+        final float boundary = 0x1p31F / 10430.378F;
+        assertEquals(0F, BedrockTrigonometry.sine(boundary));
+        assertEquals(0F, BedrockTrigonometry.cosine(boundary));
+        assertEquals(0F, BedrockTrigonometry.sine(Math.nextUp(boundary)));
+        final float below = Math.nextDown(boundary);
+        assertNotEquals(0F, BedrockTrigonometry.sine(below));
+        assertEquals(0F, BedrockTrigonometry.cosine(below));
+        assertEquals(0F, BedrockTrigonometry.sine(-boundary));
+        assertEquals(1F, BedrockTrigonometry.cosine(-boundary));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_TRIGONOMETRY_REFERENCE", matches = ".+")
+    void matchesEveryEntryOfTheExecutedWindowsInitializer() throws Exception {
+        final var table = ByteBuffer.wrap(Files.readAllBytes(Path.of(System.getenv("STACKANVIL_TRIGONOMETRY_REFERENCE"),
+                "native-windows-sine-table.bin"))).order(ByteOrder.LITTLE_ENDIAN);
+        final float[] values = BedrockSineTable.create();
+        assertEquals(values.length * Float.BYTES, table.remaining());
+        for (final float value : values) {
+            assertEquals(table.getInt(), Float.floatToRawIntBits(value));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_TRIGONOMETRY_REFERENCE", matches = ".+")
+    void matchesExecutedNativeLookupIncludingEveryFloatExponent() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_TRIGONOMETRY_REFERENCE"),
+                "native-trigonometry.json"))).getAsJsonObject();
+        final var table = ByteBuffer.wrap(Files.readAllBytes(Path.of(System.getenv("STACKANVIL_TRIGONOMETRY_REFERENCE"),
+                "native-windows-sine-table.bin"))).order(ByteOrder.LITTLE_ENDIAN);
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final float angle = Float.intBitsToFloat((int) row.get("inputBits").getAsLong());
+            final float sine = BedrockTrigonometry.sine(angle);
+            final float cosine = BedrockTrigonometry.cosine(angle);
+            assertEquals(table.getInt(row.get("sineIndex").getAsInt() * Float.BYTES), Float.floatToRawIntBits(sine));
+            assertEquals(table.getInt(row.get("cosineIndex").getAsInt() * Float.BYTES), Float.floatToRawIntBits(cosine));
+            // The Linux native-client capture uses Wine's sinf, which differs at one table entry.
+            final float nativeSine = Float.intBitsToFloat((int) row.get("sineBits").getAsLong());
+            final float nativeCosine = Float.intBitsToFloat((int) row.get("cosineBits").getAsLong());
+            assertEquals(nativeSine, sine, Math.ulp(nativeSine));
+            assertEquals(nativeCosine, cosine, Math.ulp(nativeCosine));
+        }
+    }
+
+}
