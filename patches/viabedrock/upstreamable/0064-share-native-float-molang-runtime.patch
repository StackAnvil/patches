+package net.raphimc.viabedrock.api.util;
+
+import org.redlance.mocha.lexer.MolangLexer;
+import org.redlance.mocha.lexer.TokenKind;
+import org.redlance.mocha.parser.ParseException;
+import org.redlance.mocha.parser.ast.AccessExpression;
+import org.redlance.mocha.parser.ast.ArrayAccessExpression;
+import org.redlance.mocha.parser.ast.BinaryExpression;
+import org.redlance.mocha.parser.ast.CallExpression;
+import org.redlance.mocha.parser.ast.FloatExpression;
+import org.redlance.mocha.parser.ast.ExecutionScopeExpression;
+import org.redlance.mocha.parser.ast.Expression;
+import org.redlance.mocha.parser.ast.IdentifierExpression;
+import org.redlance.mocha.parser.ast.StatementExpression;
+import org.redlance.mocha.parser.ast.StringExpression;
+import org.redlance.mocha.parser.ast.TernaryConditionalExpression;
+import org.redlance.mocha.parser.ast.UnaryExpression;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+
+/** Builds Mocha expressions with assignment precedence and modern nested Molang conditionals. */
+public final class MoLangParser {
+
+    private static final int ASSIGNMENT = 1;
+    private static final int CONDITIONAL = 2;
+    private static final int COALESCE = 3;
+    private static final int UNARY = 1100;
+    private static final Pattern FLOAT_SUFFIX =
+            Pattern.compile("(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?[fF](?![\\w.])");
+    private final MolangLexer lexer;
+    private int depth;
+    private boolean complex;
+    private TokenKind previous;
+
+    private MoLangParser(final MolangLexer lexer) {
+        this.lexer = lexer;
+    }
+
+    public static List<Expression> parse(final String source) throws IOException {
+        try (MolangLexer lexer = MolangLexer.lexer(numericSuffixes(source))) {
+            lexer.next();
+            final MoLangParser parser = new MoLangParser(lexer);
+            if (parser.kind() == TokenKind.SEMICOLON) {
+                throw parser.error("An expression cannot begin with a semicolon");
+            }
+            final List<Expression> expressions = parser.statements(TokenKind.EOF);
+            if (parser.complex && parser.previous != TokenKind.SEMICOLON) {
+                throw parser.error("An expression with assignments or statements must end with a semicolon");
+            }
+            if (!parser.complex && !expressions.isEmpty()
+                    && expressions.getFirst() instanceof UnaryExpression unary && unary.op() == UnaryExpression.Op.RETURN) {
+                return List.of(FloatExpression.ZERO);
+            }
+            if (parser.complex) {
+                final List<Expression> body = new ArrayList<>(expressions);
+                body.add(FloatExpression.ZERO);
+                return List.copyOf(body);
+            }
+            return expressions;
+        }
+    }
+
+    private void next() throws IOException {
+        this.previous = this.kind();
+        this.complex |= this.previous == TokenKind.EQ || this.previous == TokenKind.SEMICOLON;
+        this.lexer.next();
+    }
+
+    private TokenKind kind() {
+        return this.lexer.current().kind();
+    }
+
+    private void expect(final TokenKind kind) throws IOException {
+        if (this.kind() != kind) {
+            throw this.error("Expected " + kind);
+        }
+        this.next();
+    }
+
+    private ParseException error(final String message) {
+        return new ParseException(message + ", found " + this.kind(), this.lexer.cursor());
+    }
+
+    private List<Expression> statements(final TokenKind end) throws IOException {
+        final List<Expression> expressions = new ArrayList<>();
+        while (this.kind() != end) {
+            if (this.kind() == TokenKind.SEMICOLON) {
+                this.next();
+                continue;
+            }
+            final boolean returning = this.kind() == TokenKind.RETURN;
+            if (returning) {
+                this.next();
+            }
+            final Expression parsed = this.expression(0);
+            final Expression expression = parsed instanceof ExecutionScopeExpression
+                    ? new BinaryExpression(BinaryExpression.Op.CONDITIONAL, FloatExpression.ONE, parsed) : parsed;
+            expressions.add(returning ? new UnaryExpression(UnaryExpression.Op.RETURN, expression) : expression);
+            if (this.kind() != end) {
+                this.expect(TokenKind.SEMICOLON);
+            }
+            if (returning) {
+                while (this.kind() == TokenKind.SEMICOLON) {
+                    this.next();
+                }
+                if (this.kind() != end) {
+                    throw this.error("A return must be the final statement in its scope");
+                }
+            }
+        }
+        return List.copyOf(expressions);
+    }
+
+    private Expression expression(final int minimum) throws IOException {
+        if (++this.depth > 64) {
+            throw new IOException("The Molang expression is too deeply nested");
+        }
+        try {
+            Expression left = this.prefix();
+            while (true) {
+                if (this.kind() == TokenKind.DOT) {
+                    this.next();
+                    final String property = this.lexer.current().value();
+                    this.expect(TokenKind.IDENTIFIER);
+                    left = new AccessExpression(left, property);
+                } else if (this.kind() == TokenKind.LPAREN) {
+                    this.next();
+                    final List<Expression> arguments = new ArrayList<>();
+                    if (this.kind() != TokenKind.RPAREN) {
+                        do {
+                            arguments.add(this.expression(0));
+                            if (this.kind() != TokenKind.COMMA) {
+                                break;
+                            }
+                            this.next();
+                        } while (true);
+                    }
+                    this.expect(TokenKind.RPAREN);
+                    left = this.call(left, List.copyOf(arguments));
+                } else if (this.kind() == TokenKind.LBRACKET) {
+                    this.next();
+                    final Expression index = this.expression(0);
+                    this.expect(TokenKind.RBRACKET);
+                    left = new ArrayAccessExpression(left, index);
+                } else if (this.kind() == TokenKind.QUES) {
+                    if (minimum >= CONDITIONAL) {
+                        return left;
+                    }
+                    this.next();
+                    final Expression selected = this.expression(0);
+                    if (this.kind() == TokenKind.COLON) {
+                        this.next();
+                        left =
+                                new TernaryConditionalExpression(
+                                        left, selected, this.expression(0));
+                    } else {
+                        left =
+                                new BinaryExpression(
+                                        BinaryExpression.Op.CONDITIONAL, left, selected);
+                    }
+                } else {
+                    final BinaryExpression.Op operation = operation(this.kind());
+                    if (operation == null) {
+                        return left;
+                    }
+                    final int precedence =
+                        switch (operation) {
+                            case ASSIGN -> ASSIGNMENT;
+                            case CONDITIONAL -> CONDITIONAL;
+                            case NULL_COALESCE -> COALESCE;
+                            default -> operation.precedence();
+                        };
+                    if (minimum >= precedence) {
+                        return left;
+                    }
+                    if (operation == BinaryExpression.Op.ASSIGN && !(left instanceof AccessExpression)) {
+                        throw this.error("An assignment requires a variable member on its left side");
+                    }
+                    this.next();
+                    left = new BinaryExpression(operation, left, this.expression(precedence));
+                }
+            }
+        } finally {
+            this.depth--;
+        }
+    }
+
+    private Expression prefix() throws IOException {
+        final var token = this.lexer.current();
+        this.next();
+        return switch (token.kind()) {
+            case FLOAT -> FloatExpression.of(Float.parseFloat(token.value()));
+            case DOT -> {
+                if (this.kind() != TokenKind.FLOAT
+                        || !this.lexer.current().value().chars().allMatch(value -> value >= '0' && value <= '9')) {
+                    throw this.error("Expected decimal digits after the decimal point");
+                }
+                final Expression value = FloatExpression.of(Float.parseFloat("." + this.lexer.current().value()));
+                this.next();
+                yield value;
+            }
+            case STRING -> new StringExpression(token.value());
+            case TRUE -> FloatExpression.ONE;
+            case FALSE -> FloatExpression.ZERO;
+            case IDENTIFIER -> new IdentifierExpression(token.value());
+            case LPAREN -> {
+                final Expression value = this.expression(0);
+                this.expect(TokenKind.RPAREN);
+                yield value;
+            }
+            case LBRACE -> {
+                if (this.kind() == TokenKind.SEMICOLON || this.kind() == TokenKind.RBRACE) {
+                    throw this.error("A scope must begin with an expression");
+                }
+                final List<Expression> body = this.statements(TokenKind.RBRACE);
+                this.expect(TokenKind.RBRACE);
+                yield new ExecutionScopeExpression(body);
+            }
+            case SUB ->
+                new UnaryExpression(
+                        UnaryExpression.Op.ARITHMETICAL_NEGATION, this.expression(UNARY));
+            case BANG ->
+                new UnaryExpression(
+                        UnaryExpression.Op.LOGICAL_NEGATION, this.expression(UNARY));
+            case BREAK -> new StatementExpression(StatementExpression.Op.BREAK);
+            case CONTINUE -> new StatementExpression(StatementExpression.Op.CONTINUE);
+            default ->
+                throw new ParseException(
+                        "Expected an expression, found " + token.kind(), this.lexer.cursor());
+        };
+    }
+
+    private Expression call(final Expression function, final List<Expression> arguments) throws IOException {
+        if (function instanceof IdentifierExpression identifier) {
+            if (identifier.name().equalsIgnoreCase("loop")) {
+                if (arguments.size() != 2 || !(arguments.get(1) instanceof ExecutionScopeExpression)) {
+                    throw this.error("A loop requires a count and a scope");
+                }
+            } else if (identifier.name().equalsIgnoreCase("for_each")) {
+                if (arguments.size() != 3 || !(arguments.getFirst() instanceof AccessExpression)
+                        || !(arguments.get(2) instanceof ExecutionScopeExpression)) {
+                    throw this.error("A for_each requires a variable, an array and a scope");
+                }
+            }
+        }
+        return new CallExpression(function, arguments);
+    }
+
+    private static BinaryExpression.Op operation(final TokenKind kind) {
+        return switch (kind) {
+            case AMPAMP -> BinaryExpression.Op.AND;
+            case BARBAR -> BinaryExpression.Op.OR;
+            case LT -> BinaryExpression.Op.LT;
+            case LTE -> BinaryExpression.Op.LTE;
+            case GT -> BinaryExpression.Op.GT;
+            case GTE -> BinaryExpression.Op.GTE;
+            case PLUS -> BinaryExpression.Op.ADD;
+            case SUB -> BinaryExpression.Op.SUB;
+            case STAR -> BinaryExpression.Op.MUL;
+            case SLASH -> BinaryExpression.Op.DIV;
+            case QUESQUES -> BinaryExpression.Op.NULL_COALESCE;
+            case EQ -> BinaryExpression.Op.ASSIGN;
+            case EQEQ -> BinaryExpression.Op.EQ;
+            case BANGEQ -> BinaryExpression.Op.NEQ;
+            case ARROW -> BinaryExpression.Op.ARROW;
+            default -> null;
+        };
+    }
+
+    // Vanilla player controllers retain C-style float suffixes. Preserve quoted values.
+    private static String numericSuffixes(final String expression) {
+        final StringBuilder result = new StringBuilder();
+        char quote = 0;
+        int index = 0;
+        while (index < expression.length()) {
+            final char current = expression.charAt(index++);
+            if (quote != 0) {
+                result.append(current);
+                if (current == '\\' && index < expression.length()) {
+                    result.append(expression.charAt(index++));
+                } else if (current == quote) {
+                    quote = 0;
+                }
+                continue;
+            }
+            if (current == '\'' || current == '"') {
+                quote = current;
+            }
+            if ((Character.isDigit(current) || current == '.')
+                    && (index == 1
+                            || !Character.isJavaIdentifierPart(expression.charAt(index - 2))
+                                    && expression.charAt(index - 2) != '.')) {
+                final var match =
+                        FLOAT_SUFFIX.matcher(expression).region(index - 1, expression.length());
+                if (match.lookingAt()) {
+                    result.append(expression, index - 1, match.end() - 1);
+                    index = match.end();
+                    continue;
+                }
+            }
+            result.append(current);
+        }
+        return result.toString();
+    }
+
+}
