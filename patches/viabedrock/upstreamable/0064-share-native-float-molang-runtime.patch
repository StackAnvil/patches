+import java.util.Map;
+import java.util.List;
+import java.io.IOException;
+import java.io.StringReader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MoLangEngineTest {
+
+    @Test
+    void abortsUnsetTemporaryReadsWithoutUndoingEarlierWrites() throws Exception {
+        final var group = MoLangEngine.createEvaluation(scope());
+        assertEquals(0, group.eval("t.a=2;t.b=t.missing+1;t.a=9;return t.a;").getAsNumber());
+        assertEquals(2, group.eval("t.a").getAsNumber());
+        assertEquals(7, group.eval("t.b??7").getAsNumber());
+        assertEquals(0, group.eval("return t.missing+(t.a=3);").getAsNumber());
+        assertEquals(2, group.eval("t.a").getAsNumber());
+        assertEquals(0, group.eval("return (t.a=3)+t.missing;").getAsNumber());
+        assertEquals(3, group.eval("t.a").getAsNumber());
+        assertEquals(0, group.eval("t.a=t.missing;return t.a;").getAsNumber());
+        assertEquals(3, group.eval("t.a").getAsNumber());
+        assertEquals(0, group.eval("t.missing?{t.a=9;};return t.a;").getAsNumber());
+        assertEquals(3, group.eval("t.a").getAsNumber());
+    }
+
+    @Test
+    void coalescesUndefinedValuesWhileRetainingZeroAndEmptyStrings() throws Exception {
+        final var group = MoLangEngine.createEvaluation(scope());
+        assertEquals(3, group.eval("(t.missing+1)??3").getAsNumber());
+        assertEquals(0, group.eval("t.a=0;return t.a??3;").getAsNumber());
+        assertEquals("", group.eval("t.label='';return t.label??'fallback';").getAsString());
+        assertEquals(0, group.eval("return t.a??(t.a=9);").getAsNumber());
+        assertEquals(0, group.eval("t.a").getAsNumber());
+        assertEquals(4, group.eval("t.missing??t.other??4").getAsNumber());
+        assertEquals(1, group.eval("t.b=(t.b??0)+1;return t.b;").getAsNumber());
+        assertEquals(1, group.eval("t.b").getAsNumber());
+        assertEquals(2, group.eval("1?{return 2;}??3;return 4;").getAsNumber());
+    }
+
+    @Test
+    void skipsUndefinedReadsInInactiveLogicalBranches() throws Exception {
+        final var group = MoLangEngine.createEvaluation(scope());
+        assertEquals(0, group.eval("0&&t.missing").getAsNumber());
+        assertEquals(1, group.eval("1||t.missing").getAsNumber());
+        assertEquals(0, group.eval("t.missing||1").getAsNumber());
+        assertEquals(0, group.eval("!t.missing").getAsNumber());
+        assertEquals(0, group.eval("t.missing!=0").getAsNumber());
+        assertEquals(0, group.eval("loop(t.missing,{t.a=3;});return 2;").getAsNumber());
+        assertEquals(7, group.eval("t.a??7").getAsNumber());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_MOLANG_TEMPORARY_REFERENCE", matches = ".+")
+    void matchesNativeTemporaryProgramResultsAndRetainedWrites() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_MOLANG_TEMPORARY_REFERENCE")))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var expressions = row.getAsJsonObject("input").getAsJsonObject("direction").getAsJsonArray("custom_direction");
+            for (final var sample : row.getAsJsonArray("samples")) {
+                final Scope nativeScope = org.redlance.mocha.runtime.MolangInterpreter.standard().scope();
+                final var variables = new MutableObjectBinding();
+                nativeScope.set("variable", variables);
+                nativeScope.set("v", variables);
+                final var group = MoLangEngine.createEvaluation(nativeScope);
+                final var expected = sample.getAsJsonObject().getAsJsonArray("direction");
+                for (int axis = 0; axis < 3; axis++) {
+                    assertEquals(expected.get(axis).getAsFloat(), group.eval(expressions.get(axis).getAsString()).getAsNumber(), expressions.toString());
+                }
+            }
+        }
+        assertFalse(fixture.getAsJsonArray("cases").isEmpty());
+    }
+
+    @Test
+    void compilesValidatedSyntaxWithTheSameFaultAndJumpSemantics() throws Exception {
+        final var group = MoLangEngine.createEvaluation(scope());
+        final var syntax = MoLangParser.parse("t.a=2;1?{return (t.missing+1)??t.a;};t.a=9;return t.a;");
+        assertEquals(2, group.eval(MoLangEngine.compile(syntax)).getAsNumber());
+        assertEquals(2, group.eval("t.a").getAsNumber());
+    }
+
+    @Test
+    void rejectsUnparenthesizedAssignmentChainsBeforeMutatingVariables() throws Exception {
+        final Scope scope = scope();
+        MoLangEngine.eval(scope, "v.a=7;v.b=9;");
+        for (final String expression : List.of("v.a=v.b=3;return v.a;", "v.a=0;v.b=0;return (v.a=v.b=3)+1;", "v.a=v.b=0?2:3;return v.a+v.b-3;")) {
+            assertThrows(ParseException.class, () -> MoLangEngine.eval(scope, expression));
+        }
+        assertEquals(7, MoLangEngine.eval(scope, "v.a").getAsNumber());
+        assertEquals(9, MoLangEngine.eval(scope, "v.b").getAsNumber());
+        assertDoesNotThrow(() -> MoLangEngine.parse("return v.a=(v.b=2);"));
+    }
+
+    @Test
+    void sharesTemporaryValuesAcrossAnExplicitEvaluationGroup() throws Exception {
+        final Scope scope = scope();
+        final var evaluation = MoLangEngine.createEvaluation(scope);
+        assertEquals(2, evaluation.eval("t.a=2;return t.a;").getAsNumber());
+        assertEquals(3, evaluation.eval("temp.a=temp.a+1;return t.a;").getAsNumber());
+        assertEquals("Top", evaluation.eval("t.label='Top';return t.label;").getAsString());
+        assertTrue(evaluation.eval("temp.label=='Top'").getAsBoolean());
+        assertEquals(3, evaluation.eval("1?{return t.a;};temp.a=99;return temp.a;").getAsNumber());
+        assertEquals(3, evaluation.eval("t.a").getAsNumber());
+        assertEquals(6, evaluation.eval(MoLangEngine.parse("this+t.a"), 3).getAsNumber());
+        assertEquals(7, evaluation.eval(MoLangEngine.parse("this+t.a"), 4).getAsNumber());
+        assertEquals(0, MoLangEngine.eval(scope, "t.a??0").getAsNumber());
+        assertEquals(0, MoLangEngine.createEvaluation(scope).eval("temp.a??0").getAsNumber());
+        assertNull(scope.getProperty("temp"));
+        assertNull(scope.getProperty("this"));
+    }
+
+    @Test
+    void keepsPersistentBindingsWhileIsolatingEvaluationGroups() throws Exception {
+        final Scope scope = scope();
+        final var first = MoLangEngine.createEvaluation(scope);
+        final var second = MoLangEngine.createEvaluation(scope);
+        first.eval("v.count=4;t.count=2;");
+        assertEquals(4, second.eval("v.count").getAsNumber());
+        assertEquals(0, second.eval("t.count??0").getAsNumber());
+        second.eval("v.count=5;t.count=9;");
+        assertEquals(5, first.eval("v.count").getAsNumber());
+        assertEquals(2, first.eval("t.count").getAsNumber());
+        assertEquals(9, second.eval("t.count").getAsNumber());
+    }
+
+    @Test
+    void comparesEnumPropertiesWithoutNumericCoercion() throws Exception {
+        final Scope scope = scope();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        MoLangEngine.bindPropertyQueries(queries, Map.of("example:part", "middle", "example:enabled", true));
+        scope.set("query", queries);
+        scope.set("q", queries);
+        assertFalse(MoLangEngine.eval(scope, "q.property('example:part') == 'left'").getAsBoolean());
+        assertTrue(MoLangEngine.eval(scope, "q.property('example:part') == 'middle' && q.property('example:enabled')").getAsBoolean());
+        assertTrue(MoLangEngine.eval(scope, "q.property('example:part') != 'left'").getAsBoolean());
+        assertFalse(MoLangEngine.eval(scope, "'Middle' == 'middle'").getAsBoolean());
+        assertFalse(MoLangEngine.eval(scope, "'0' == 0").getAsBoolean());
+        assertTrue(MoLangEngine.eval(scope, "1 == 1 && 1 != 2").getAsBoolean());
+    }
+
+    @Test
+    void assignsConditionalResultsAfterLogicalExpressions() throws Exception {
+        final Scope scope = scope();
+        assertEquals(2D, MoLangEngine.eval(scope, "v.frames = 1 && 1 ? 2 : 1; return v.frames;").getAsNumber());
+        assertEquals(1D, MoLangEngine.eval(scope, "v.frames = 1 && 0 ? 2 : 1; return v.frames;").getAsNumber());
+        assertEquals(2D, MoLangEngine.eval(scope, "v.animated = 1 && 1; v.frames = v.animated ? 2 : 1; return v.frames;").getAsNumber());
+        assertEquals(3D, MoLangEngine.eval(scope, "v.b = 0 ? 2 : 3; v.a = v.b; return v.a + v.b - 3;").getAsNumber());
+        assertEquals(4D, MoLangEngine.eval(scope, "v.a = 0 ? 2 : 0 ? 3 : 4; return v.a;").getAsNumber());
+    }
+
+    @Test
+    void preservesExplicitAssignmentConditionsAndNestedBoundaries() throws Exception {
+        final Scope scope = scope();
+        scope.set("first", (Function<Object>) (context, arguments) -> arguments.next().eval());
+        assertEquals(2D, MoLangEngine.eval(scope, "return (v.a = 1) ? 2 : 3;").getAsNumber());
+        assertEquals(1D, MoLangEngine.eval(scope, "v.a").getAsNumber());
+        assertEquals(3D, MoLangEngine.eval(scope, "v.a = first((v.b = 0 ? 2 : 3), 1); return v.a;").getAsNumber());
+        assertEquals(2D, MoLangEngine.eval(scope, "1 ? v.a = 2 : v.a = 3; return v.a;").getAsNumber());
+        assertEquals("a=b?:c", MoLangEngine.eval(scope, "v.text = 'a=b?:c'; return v.text;").getAsString());
+    }
+
+    @Test
+    void appliesUnaryOperatorsToQueryResultsAndArrayElements() throws Exception {
+        final Scope scope = scope();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        MoLangEngine.bindPropertyQueries(queries, Map.of("example:enabled", false, "example:amount", 3));
+        scope.set("query", queries);
+        scope.set("q", queries);
+        final MutableObjectBinding arrays = new MutableObjectBinding();
+        arrays.set("values", Value.of(new double[]{2, 0}));
+        scope.set("array", arrays);
+        assertTrue(MoLangEngine.eval(scope, "!q.property('example:enabled')").getAsBoolean());
+        assertFalse(MoLangEngine.eval(scope, "!q.has_property('example:enabled')").getAsBoolean());
+        assertEquals(-3D, MoLangEngine.eval(scope, "-q.property('example:amount')").getAsNumber());
+        assertFalse(MoLangEngine.eval(scope, "!-q.property('example:amount')").getAsBoolean());
+        assertTrue(MoLangEngine.eval(scope, "!array.values[1]").getAsBoolean());
+    }
+
+    @Test
+    void roundsEachArithmeticOperationAndAssignedValueToFloat() throws Exception {
+        final Scope scope = scope();
+        assertEquals(0F, MoLangEngine.eval(scope, "16777216 + 1 - 16777216").getAsNumber());
+        assertTrue(MoLangEngine.eval(scope, "(0.1 + 0.2) == 0.3").getAsBoolean());
+        assertTrue(MoLangEngine.eval(scope, "16777217 == 16777216").getAsBoolean());
+        assertEquals(0F, MoLangEngine.eval(scope, "v.number = 16777216; v.number = v.number + 1; return v.number - 16777216;").getAsNumber());
