From deafeab4ad7f7d3701a3d8266d0d553d0ad93389 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:30:32 +0200
Subject: [PATCH] fix(login): complete login before resource pack negotiation

Bedrock can send resource pack information before the Java login acknowledgment arrives. ViaVersion leaves modern connections in LOGIN until that acknowledgment, so ViaBedrock previously treated the early pack packet as a skipped login and emitted a second login success. ViaProxy then delivered that packet to a client already decoding configuration disconnects.

Advance only the server protocol state after the first success. Leave the Java client state pending its acknowledgment, preserve omitted-login synthesis, and retain PLAY transitions for older clients. A strict BDS 1.26.51/protocol 2193 capture records one Bedrock success and two translated successes; targeted sequence controls reproduce the stale state and cover early packs, duplicate status, omitted login, and legacy clients.
---
 .../protocol/packet/JoinPackets.java          |   5 +
 .../protocol/packet/LoginTransitionTest.java  | 236 ++++++++++++++++++
 2 files changed, 241 insertions(+)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/packet/LoginTransitionTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
index cb9fbdafc..b593a23d8 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/JoinPackets.java
@@ -136,6 +136,11 @@ public final class JoinPackets {
                     wrapper.write(Types.UUID, UUID.randomUUID()); // session id
 
                     ClientboundBaseProtocol1_7.onLoginSuccess(wrapper.user());
+                    if (protocolInfo.protocolVersion().newerThanOrEqualTo(ProtocolVersion.v1_20_2)) {
+                        // Bedrock may send packs before Java acknowledges login. Advance only
+                        // the server side so the preflight cannot synthesize another success.
+                        protocolInfo.setServerState(State.CONFIGURATION);
+                    }
                     sendClientCacheStatus(wrapper.user());
                 } else {
                     wrapper.setPacketType(ClientboundLoginPackets.LOGIN_DISCONNECT);
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/packet/LoginTransitionTest.java b/src/test/java/net/raphimc/viabedrock/protocol/packet/LoginTransitionTest.java
new file mode 100644
index 000000000..d6cf66182
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/packet/LoginTransitionTest.java
@@ -0,0 +1,236 @@
