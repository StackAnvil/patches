From 42381e4d246badad7ceafd33d9bb20a9a19e4ca3 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:34 +0200
Subject: [PATCH] fix(interaction): forward bed wake command to Bedrock

Java sends STOP_SLEEPING when leaving a bed. Translate that command into Bedrock StopSleeping so the server can clear the sleeping state instead of disconnecting the session on an unhandled action.
---
 .../raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java  | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
index ea042ac77..43e92967e 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
@@ -326,6 +326,7 @@ public final class ClientPlayerPackets {
             wrapper.read(Types.VAR_INT); // data
 
             switch (action) {
+                case STOP_SLEEPING -> clientPlayer.sendPlayerActionPacketToServer(PlayerActionType.StopSleeping);
                 case START_SPRINTING -> {
                     clientPlayer.setSprinting(true);
                     clientPlayer.addAuthInputData(PlayerAuthInputData.StartSprinting);
-- 
