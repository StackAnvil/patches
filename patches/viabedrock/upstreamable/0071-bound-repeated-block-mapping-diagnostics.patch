+package net.raphimc.viabedrock.protocol.storage;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Handler;
+import java.util.logging.LogRecord;
+import java.util.logging.Logger;
+import java.util.stream.IntStream;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ChunkMappingDiagnosticsTest {
+
+    @Test
+    void boundsConcurrentDuplicatesAndDistinctFailuresPerTracker() {
+        final AtomicInteger records = new AtomicInteger();
+        final Logger logger = Logger.getAnonymousLogger();
+        logger.setUseParentHandlers(false);
+        logger.addHandler(new Handler() {
+            @Override
+            public void publish(final LogRecord record) {
+                records.incrementAndGet();
+            }
+
+            @Override
+            public void flush() {
+            }
+
+            @Override
+            public void close() {
+            }
+        });
+        final ChunkMappingDiagnostics diagnostics = new ChunkMappingDiagnostics(logger);
+        IntStream.range(0, 100_000).parallel().forEach(ignored -> diagnostics.invalidSecondaryLayer(17, 18));
+        assertEquals(1, records.get());
+        diagnostics.missingBlock(17);
+        diagnostics.missingWaterloggedBlock(17);
+        assertEquals(3, records.get());
+        IntStream.range(0, 100_000).parallel().forEach(diagnostics::missingBlock);
+        // Sixty-four distinct failures and one notice exhaust this tracker's bounded budget.
+        assertEquals(65, records.get());
+        diagnostics.invalidSecondaryLayer(19, 20);
+        assertEquals(65, records.get());
+        new ChunkMappingDiagnostics(logger).invalidSecondaryLayer(17, 18);
+        assertEquals(66, records.get());
+    }
+
+}
