+package net.raphimc.viabedrock.protocol.storage;
+
+import java.util.HashSet;
+import java.util.Set;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+/** Keeps repeated invalid palette entries from blocking chunk processing with log output. */
+final class ChunkMappingDiagnostics {
+
+    private static final int LIMIT = 64;
+    private final Set<Warning> reported = new HashSet<>();
+    private final Logger logger;
+
+    ChunkMappingDiagnostics(final Logger logger) {
+        this.logger = logger;
+    }
+
+    void missingBlock(final int state) {
+        this.report(new Warning(Kind.MISSING_BLOCK, state, 0));
+    }
+
+    void missingWaterloggedBlock(final int state) {
+        this.report(new Warning(Kind.MISSING_WATERLOGGED_BLOCK, state, 0));
+    }
+
+    void invalidSecondaryLayer(final int first, final int second) {
+        this.report(new Warning(Kind.INVALID_SECONDARY_LAYER, first, second));
+    }
+
+    private void report(final Warning warning) {
+        final boolean reachedLimit;
+        synchronized (this.reported) {
+            if (this.reported.size() >= LIMIT || !this.reported.add(warning)) {
+                return;
+            }
+            reachedLimit = this.reported.size() == LIMIT;
+        }
+        this.logger.log(Level.WARNING, switch (warning.kind()) {
+            case MISSING_BLOCK -> "Missing block state: " + warning.first();
+            case MISSING_WATERLOGGED_BLOCK -> "Missing waterlogged block state: " + warning.first();
+            case INVALID_SECONDARY_LAYER -> "Invalid layer 2 block state. L1: " + warning.first() + ", L2: " + warning.second();
+        });
+        if (reachedLimit) {
+            this.logger.log(Level.WARNING, "Further chunk block mapping warnings are suppressed for this dimension tracker");
+        }
+    }
+
+    private enum Kind {
+        MISSING_BLOCK, MISSING_WATERLOGGED_BLOCK, INVALID_SECONDARY_LAYER
+    }
+
+    private record Warning(Kind kind, int first, int second) {
+    }
+
+}
