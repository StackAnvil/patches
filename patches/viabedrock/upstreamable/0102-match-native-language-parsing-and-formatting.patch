+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class LanguageTranslationsTest {
+
+    @Test
+    void indexedArgumentsFollowConsumedSequentialArgumentsAndMissingTextSkipsThem() {
+        final var table = Map.of("format", "%s/%1/%2", "arg", "Arg");
+        final var calls = new ArrayList<String>();
+        final Function<byte[], byte[]> lookup = raw -> {
+            final String key = NbtUtf8.decode(raw);
+            calls.add(key);
+            final String value = table.get(key);
+            return value == null ? null : NbtUtf8.encode(value);
+        };
+        final var arguments = List.of(NbtUtf8.encode("%arg"), NbtUtf8.encode("B"), NbtUtf8.encode("C"));
+        assertEquals("Arg/B/C", NbtUtf8.decode(LanguageTranslations.translate(NbtUtf8.encode("format"), arguments, lookup)));
+        calls.clear();
+        assertEquals("missing", NbtUtf8.decode(LanguageTranslations.translate(NbtUtf8.encode("missing"), arguments, lookup)));
+        assertEquals(List.of("missing"), calls);
+    }
+
+    @Test
+    void wholeOperationRetriesAgreeWithNativeLanguageManager() throws Exception {
+        final String path = System.getenv("STACKANVIL_LANGUAGE_FALLBACK_REFERENCE");
+        Assumptions.assumeTrue(path != null);
+        final var hex = HexFormat.of();
+        final var cases = JsonParser.parseString(Files.readString(Path.of(path))).getAsJsonObject().getAsJsonArray("cases");
+        for (final var element : cases) {
+            final var row = element.getAsJsonObject();
+            final var tables = new ArrayList<Function<byte[], byte[]>>();
+            final var attempts = new JsonArray();
+            for (final var table : row.getAsJsonArray("tables")) {
+                final int index = tables.size();
+                final var translations = new HashMap<String, byte[]>();
+                for (final var entry : table.getAsJsonArray()) {
+                    final var pair = entry.getAsJsonArray();
+                    translations.put(NbtUtf8.decode(hex.parseHex(pair.get(0).getAsString())), hex.parseHex(pair.get(1).getAsString()));
+                }
+                final var lookup = new LanguageLookup(key -> translations.get(NbtUtf8.decode(key)));
+                tables.add(key -> {
+                    if (attempts.isEmpty() || attempts.get(attempts.size() - 1).getAsInt() != index) {
+                        attempts.add(index);
+                    }
+                    return lookup.apply(key);
+                });
+            }
+            final var order = new ArrayList<Integer>();
+            if (!row.get("explicit").isJsonNull()) {
+                order.add(row.get("explicit").getAsInt());
+            }
+            if (!row.get("selected").isJsonNull()) {
+                order.add(row.get("selected").getAsInt());
+                for (final var available : row.getAsJsonArray("order")) {
+                    final int index = available.getAsInt();
+                    if (NbtUtf8.decode(hex.parseHex(row.getAsJsonArray("names").get(index).getAsString())).equals("neutral")) {
+                        order.add(index);
+                    }
+                }
+            }
+            final List<Function<byte[], byte[]>> languages = order.stream().map(tables::get).toList();
+            final var arguments = new ArrayList<byte[]>();
+            row.getAsJsonArray("arguments").forEach(argument -> arguments.add(hex.parseHex(argument.getAsString())));
+            final byte[] key = hex.parseHex(row.get("key").getAsString());
+            assertArrayEquals(hex.parseHex(row.get("result").getAsString()), LanguageTranslations.translate(key, arguments, languages), row::toString);
+            if (key.length != 0) {
+                assertEquals(row.getAsJsonArray("attempts"), attempts, row::toString);
+            }
+        }
+    }
+
+    @Test
+    void rawTokenExpansionAndArgumentEvaluationAgreeWithNativeFormatter() throws Exception {
+        final String path = System.getenv("STACKANVIL_LANGUAGE_FORMAT_REFERENCE");
+        Assumptions.assumeTrue(path != null);
+        final var hex = HexFormat.of();
+        final var document = JsonParser.parseString(Files.readString(Path.of(path))).getAsJsonObject();
+        for (final var element : document.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var translations = new HashMap<String, byte[]>();
+            for (final var translation : row.getAsJsonArray("translations")) {
+                final var entry = translation.getAsJsonArray();
+                translations.put(entry.get(0).getAsString(), hex.parseHex(entry.get(1).getAsString()));
+            }
+            final var arguments = new ArrayList<byte[]>();
+            for (final var argument : row.getAsJsonArray("arguments")) {
+                arguments.add(hex.parseHex(argument.getAsString()));
+            }
+            final var calls = new JsonArray();
+            final byte[] result = LanguageTranslations.translate(hex.parseHex(row.get("key").getAsString()), arguments, key -> {
+                final String encoded = hex.formatHex(key);
+                calls.add(encoded);
+                return translations.get(encoded);
+            });
+            // Empty native lookup returns absent without consulting the dictionary.
+            final var expectedCalls = new JsonArray();
+            for (final var call : row.getAsJsonArray("lookups")) {
+                if (!call.getAsString().isEmpty()) {
+                    expectedCalls.add(call);
+                }
+            }
+            assertArrayEquals(hex.parseHex(row.get("result").getAsString()), result, row::toString);
+            assertEquals(expectedCalls, calls, row::toString);
+        }
+    }
+
+}
