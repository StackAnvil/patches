+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class TextDefinitionsTest {
+
+    @Test
+    void acceptedLayersAndSourceReplacementKeepIndependentLookupSnapshots() throws Exception {
+        final var lower = pack(NbtUtf8.encode("Key=Lower\nretained=Trailing  \n"));
+        final var upper = pack(NbtUtf8.encode("KEY=Upper\n"));
+        final var before = new ResourcePackStorage(List.of(upper, lower)).getTexts();
+        assertEquals("Upper", before.get("KEY"));
+        assertEquals("Trailing  ", before.get("retained"));
+        final var parsed = upper.content().getLang("texts/en_US.lang");
+        assertThrows(UnsupportedOperationException.class, () -> parsed.put("key", "Changed"));
+        upper.content().put("texts/en_US.lang", NbtUtf8.encode("key=After\n"));
+        final var after = new TextDefinitions(List.of(lower, upper));
+        assertEquals("Upper", before.get("KEY"));
+        assertEquals("After", after.get("KEY"));
+        assertEquals(Map.of("key", "After"), upper.content().getLang("texts/en_US.lang"));
+        upper.content().putStored("texts/en_US.lang", NbtUtf8.encode("key=\n"));
+        assertEquals("Lower", new TextDefinitions(List.of(lower, upper)).get("KEY"));
+        assertEquals("After", after.get("KEY"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_LANGUAGE_COMPOSITION_REFERENCE", matches = ".+")
+    void acceptedPackParsingLookupAndArgumentFormattingMatchNativeComposition() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_LANGUAGE_COMPOSITION_REFERENCE")))).getAsJsonObject();
+        final var hex = HexFormat.of();
+        int cases = 0;
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var texts = new ResourcePackStorage(List.of(pack(hex.parseHex(row.get("raw").getAsString())))).getTexts();
+            final byte[] key = hex.parseHex(row.get("key").getAsString());
+            final List<byte[]> arguments = new ArrayList<>();
+            row.getAsJsonArray("arguments").forEach(argument -> arguments.add(hex.parseHex(argument.getAsString())));
+            final byte[] expected = hex.parseHex(row.get("result").getAsString());
+            assertArrayEquals(expected, texts.translate(key, arguments), "native byte case " + cases);
+            assertArrayEquals(expected, NbtUtf8.encode(texts.translate(NbtUtf8.decode(key), arguments.stream().map(NbtUtf8::decode).toArray())),
+                    "native string case " + cases);
+            cases++;
+        }
+        assertEquals(780, cases);
+    }
+
+    private static ResourcePack pack(final byte[] raw) throws Exception {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"Language producer control\"}}");
+        content.put("texts/en_US.lang", raw);
+        return new ResourcePack(content);
+    }
+
+}
