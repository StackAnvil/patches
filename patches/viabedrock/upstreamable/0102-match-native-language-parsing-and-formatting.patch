+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Function;
+
+/** Native exact-key lookup followed by cached or ASCII-folded language lookup. */
+public final class LanguageLookup implements Function<byte[], byte[]> {
+
+    private final Function<byte[], byte[]> primary;
+    private final Map<String, byte[]> folded = new ConcurrentHashMap<>();
+
+    /** Replacing the language table requires a new lookup, discarding its folded-key cache. */
+    public LanguageLookup(final Function<byte[], byte[]> primary) {
+        this.primary = primary;
+    }
+
+    /** Null denotes an absent translation. Empty values still resolve and enter the folded cache. */
+    @Override
+    public byte[] apply(final byte[] key) {
+        if (key.length == 0) {
+            return null;
+        }
+        final byte[] exact = this.primary.apply(key);
+        if (exact != null) {
+            return exact.clone();
+        }
+        final String cacheKey = NbtUtf8.decode(key);
+        final byte[] cached = this.folded.get(cacheKey);
+        if (cached != null) {
+            return cached.clone();
+        }
+        final byte[] lowercase = key.clone();
+        for (int index = 0; index < lowercase.length; index++) {
+            if (lowercase[index] >= 'A' && lowercase[index] <= 'Z') {
+                lowercase[index] += 'a' - 'A';
+            }
+        }
+        final byte[] result = this.primary.apply(lowercase);
+        if (result == null) {
+            return null;
+        }
+        this.folded.putIfAbsent(cacheKey, result.clone());
+        return result.clone();
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/definition/LanguageTranslations.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/definition/LanguageTranslations.java
