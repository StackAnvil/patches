+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class LanguageFileTest {
+
+    @Test
+    void parsingPreservesValueBytesAndAnEmptyDuplicateDoesNotEraseItsPredecessor() {
+        final byte[] input = NbtUtf8.encode("KEY=One\\nTwo\tComment\nkey=\nmissing");
+        final byte[] bom = {(byte) 0xEF, (byte) 0xBB, (byte) 0xBF};
+        final byte[] document = new byte[bom.length + input.length];
+        System.arraycopy(bom, 0, document, 0, bom.length);
+        System.arraycopy(input, 0, document, bom.length, input.length);
+        final var result = LanguageFile.parse(document);
+        assertEquals(Map.of("key", "One\nTwo"), result.translations());
+        assertEquals(List.of(new LanguageFile.MissingSeparator(3, false)), result.missingSeparators());
+    }
+
+    @Test
+    void byteParsingFiltersPrefixesAndDiagnosticsAgreeWithNativeFiles() throws Exception {
+        final var hex = HexFormat.of();
+        for (final var element : reference().getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var result = LanguageFile.parse(hex.parseHex(row.get("raw").getAsString()), keys(row.getAsJsonArray("exclude")),
+                    keys(row.getAsJsonArray("include")), hex.parseHex(row.get("prefix").getAsString()));
+            final var expected = new HashMap<String, String>();
+            for (final var entry : row.getAsJsonArray("translations")) {
+                final var pair = entry.getAsJsonArray();
+                expected.put(NbtUtf8.decode(hex.parseHex(pair.get(0).getAsString())), NbtUtf8.decode(hex.parseHex(pair.get(1).getAsString())));
+            }
+            assertEquals(expected, result.translations(), row::toString);
+            assertEquals(row.get("special").getAsBoolean(), result.special(), row::toString);
+            final var diagnostics = new ArrayList<LanguageFile.MissingSeparator>();
+            for (final var entry : row.getAsJsonArray("diagnostics")) {
+                final var diagnostic = entry.getAsJsonObject();
+                diagnostics.add(new LanguageFile.MissingSeparator(diagnostic.get("line").getAsInt(), diagnostic.get("ending").getAsString().equals("newline")));
+            }
+            assertEquals(diagnostics, result.missingSeparators(), row::toString);
+        }
+    }
+
+    @Test
+    void actualPackNamesAndReloadsUseNativeFileContentsAndLookup() throws Exception {
+        final var document = reference();
+        final var hex = HexFormat.of();
+        int compared = 0;
+        for (final var element : document.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            if (!row.getAsJsonArray("exclude").isEmpty() || !row.getAsJsonArray("include").isEmpty() || !row.get("prefix").getAsString().isEmpty()) {
+                continue;
+            }
+            final var content = content(hex.parseHex(row.get("raw").getAsString()));
+            final var packs = List.of(new ResourcePack(content));
+            final var texts = new ResourcePackStorage(packs).getTexts();
+            final var bootstrapTexts = new TextDefinitions(packs);
+            for (final var query : row.getAsJsonArray("queries")) {
+                final var nativeQuery = query.getAsJsonObject();
+                final byte[] key = hex.parseHex(nativeQuery.get("key").getAsString());
+                final byte[] expected = nativeQuery.get("present").getAsBoolean() ? hex.parseHex(nativeQuery.get("result").getAsString()) : key;
+                assertArrayEquals(expected, NbtUtf8.encode(texts.get(NbtUtf8.decode(key))), row::toString);
+                assertArrayEquals(expected, NbtUtf8.encode(texts.lookup().apply(NbtUtf8.decode(key))), row::toString);
+                assertArrayEquals(expected, NbtUtf8.encode(bootstrapTexts.get(NbtUtf8.decode(key))), row::toString);
+                assertArrayEquals(hex.parseHex(nativeQuery.get("formatted").getAsString()), texts.translate(key, List.of()), row::toString);
+                assertArrayEquals(hex.parseHex(nativeQuery.get("formatted").getAsString()), bootstrapTexts.translate(key, List.of()), row::toString);
+                compared++;
+            }
+        }
+        assertTrue(compared > 1000);
+        final var lifecycle = document.getAsJsonObject("cacheLifecycle");
+        final var content = content(hex.parseHex(lifecycle.get("beforeRaw").getAsString()));
+        final var before = new ResourcePackStorage(List.of(new ResourcePack(content))).getTexts();
+        final var first = lifecycle.getAsJsonObject("before");
+        final byte[] key = hex.parseHex(first.get("key").getAsString());
+        assertArrayEquals(hex.parseHex(first.get("result").getAsString()), NbtUtf8.encode(before.get(NbtUtf8.decode(key))));
+        content.put("texts/en_US.lang", hex.parseHex(lifecycle.get("afterRaw").getAsString()));
+        final var after = new ResourcePackStorage(List.of(new ResourcePack(content))).getTexts();
+        assertArrayEquals(hex.parseHex(lifecycle.getAsJsonObject("after").get("result").getAsString()), NbtUtf8.encode(after.get(NbtUtf8.decode(key))));
+    }
+
+    private static JsonObject reference() throws Exception {
+        final String path = System.getenv("STACKANVIL_LANGUAGE_FILE_REFERENCE");
+        Assumptions.assumeTrue(path != null);
+        return JsonParser.parseString(Files.readString(Path.of(path))).getAsJsonObject();
+    }
+
+    private static Set<String> keys(final JsonArray values) {
+        final var result = new HashSet<String>();
+        values.forEach(value -> result.add(NbtUtf8.decode(HexFormat.of().parseHex(value.getAsString()))));
+        return result;
+    }
+
+    private static InMemoryContent content(final byte[] raw) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"Language file probe\"}}");
+        content.put("texts/en_US.lang", raw);
+        content.putString("texts/languages.json", "[\"en_US\"]");
+        return content;
+    }
+
+}
