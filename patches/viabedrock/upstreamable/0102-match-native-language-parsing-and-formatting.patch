+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/** The native shulker label passes one typed integer to a length-aware printf formatter. */
+public final class LanguageIntegerFormat {
+
+    private static final Pattern CONVERSION = Pattern.compile("%(?:(1)\\$)?([-+ #0]*)([0-9]*)(?:\\.([0-9]*))?(hh|ll|[hljzt])?([diuoxXc%])");
+
+    private LanguageIntegerFormat() { }
+
+    public static String format(final String format, final int value) {
+        final StringBuilder output = new StringBuilder();
+        final var matcher = CONVERSION.matcher(format);
+        int cursor = 0;
+        boolean consumed = false;
+        while (cursor < format.length()) {
+            final int start = format.indexOf('%', cursor);
+            if (start < 0) {
+                output.append(format, cursor, format.length());
+                break;
+            }
+            output.append(format, cursor, start);
+            matcher.region(start, format.length());
+            if (!matcher.lookingAt()) {
+                throw new IllegalArgumentException("Invalid integer label format");
+            }
+            final char conversion = matcher.group(6).charAt(0);
+            if (conversion == '%') {
+                output.append('%');
+            } else {
+                if (matcher.group(1) == null) {
+                    if (consumed) {
+                        throw new IllegalArgumentException("Integer label format requires another argument");
+                    }
+                    consumed = true;
+                }
+                final String flags = matcher.group(2);
+                final int width = matcher.group(3).isEmpty() ? 0 : Integer.parseInt(matcher.group(3));
+                final int precision = matcher.group(4) == null ? -1 : matcher.group(4).isEmpty() ? 0 : Integer.parseInt(matcher.group(4));
+                output.append(integer(value, conversion, flags, width, precision, matcher.group(5)));
+            }
+            cursor = matcher.end();
+        }
+        return output.toString();
+    }
+
+    private static String integer(final int value, final char conversion, final String flags, final int width,
+                                  final int precision, final String length) {
+        if (conversion == 'c') {
+            return pad(NbtUtf8.decode(new byte[]{(byte) value}), width, flags.indexOf('-') >= 0);
+        }
+        final boolean signed = conversion == 'd' || conversion == 'i';
+        final int narrowed = "hh".equals(length) ? (byte) value : "h".equals(length) ? (short) value : value;
+        final long number = signed ? narrowed : "hh".equals(length) ? Byte.toUnsignedInt((byte) value)
+                : "h".equals(length) ? Short.toUnsignedInt((short) value) : Integer.toUnsignedLong(value);
+        final int radix = conversion == 'o' ? 8 : conversion == 'x' || conversion == 'X' ? 16 : 10;
+        // Typed native printf retains zero at precision zero and honors unsigned sign flags.
+        String digits = Long.toString(Math.abs(number), radix);
+        if (conversion == 'X') {
+            digits = digits.toUpperCase(Locale.ROOT);
+        }
+        digits = "0".repeat(Math.max(0, precision - digits.length())) + digits;
+        final String sign = number < 0 ? "-" : flags.indexOf('+') >= 0 ? "+" : flags.indexOf(' ') >= 0 ? " " : "";
+        final String prefix = flags.indexOf('#') < 0 ? "" : conversion == 'o' ? digits.startsWith("0") ? "" : "0"
+                : number != 0 && conversion == 'x' ? "0x" : number != 0 && conversion == 'X' ? "0X" : "";
+        final boolean left = flags.indexOf('-') >= 0;
+        if (!left && flags.indexOf('0') >= 0 && precision < 0) {
+            return sign + prefix + "0".repeat(Math.max(0, width - sign.length() - prefix.length() - digits.length())) + digits;
+        }
+        return pad(sign + prefix + digits, width, left);
+    }
+
+    private static String pad(final String text, final int width, final boolean left) {
+        final String padding = " ".repeat(Math.max(0, width - NbtUtf8.encode(text).length));
+        return left ? text + padding : padding + text;
+    }
+
+}
