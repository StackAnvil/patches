+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import java.io.ByteArrayOutputStream;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.Function;
+
+/** Native language token expansion and argument substitution over UTF-8 bytes. */
+public final class LanguageTranslations {
+
+    private LanguageTranslations() { }
+
+    /** The lookup returns null for an absent key, preserving explicitly empty translations. */
+    public static byte[] translate(final byte[] text, final List<byte[]> arguments, final Function<byte[], byte[]> lookup) {
+        return translate(text, arguments, List.of(lookup));
+    }
+
+    /** Try each language for the entire operation, including argument translation. */
+    public static byte[] translate(final byte[] text, final List<byte[]> arguments, final List<Function<byte[], byte[]>> languages) {
+        for (final Function<byte[], byte[]> language : languages) {
+            final byte[] translated = tryTranslate(text, arguments, language);
+            if (translated != null) {
+                return translated;
+            }
+        }
+        return text.clone();
+    }
+
+    static byte[] tryTranslate(final byte[] text, final List<byte[]> arguments, final Function<byte[], byte[]> lookup) {
+        final byte[] resolved;
+        if (indexOf(text, (byte) '%', 0) >= 0) {
+            final var output = new ByteArrayOutputStream(text.length);
+            int tokenStart = -1;
+            for (int index = 0; index <= text.length; index++) {
+                final int character = index == text.length ? 0 : Byte.toUnsignedInt(text[index]);
+                if (tokenStart >= 0) {
+                    if (isKeyCharacter(character)) {
+                        continue;
+                    }
+                    final byte[] key = Arrays.copyOfRange(text, tokenStart, index);
+                    final byte[] value = resolve(key, lookup);
+                    output.writeBytes(value == null ? key : value);
+                    tokenStart = -1;
+                    if (character != 0) {
+                        output.write(character);
+                    }
+                } else if (character == '%') {
+                    tokenStart = index + 1;
+                } else if (character != 0) {
+                    output.write(character);
+                }
+            }
+            resolved = output.toByteArray();
+        } else {
+            final byte[] value = resolve(text, lookup);
+            if (value == null) {
+                // Retry the next language before evaluating any arguments.
+                return null;
+            }
+            resolved = value.clone();
+        }
+        if (arguments.isEmpty()) {
+            return resolved;
+        }
+        final var translatedArguments = new ArrayList<byte[]>(arguments.size());
+        for (final byte[] argument : arguments) {
+            final byte[] value = argument.length != 0 && argument[0] == '%'
+                    ? resolve(Arrays.copyOfRange(argument, 1, argument.length), lookup) : null;
+            translatedArguments.add(value == null ? argument : value);
+        }
+        return substitute(resolved, translatedArguments);
+    }
+
+    private static byte[] resolve(final byte[] key, final Function<byte[], byte[]> lookup) {
+        return key.length == 0 ? null : lookup.apply(key);
+    }
+
+    private static boolean isKeyCharacter(final int character) {
+        return character >= '0' && character <= '9' || character >= 'A' && character <= 'Z'
+                || character >= 'a' && character <= 'z' || character == '-' || character == '.' || character == '_';
+    }
+
+    private static byte[] substitute(byte[] text, final List<byte[]> arguments) {
+        int position;
+        while ((position = firstMarker(text, (byte) '$')) >= 0) {
+            text = replace(text, position, 2, new byte[0]);
+        }
+        int sequential = 0;
+        while ((position = firstMarker(text, (byte) '%')) >= 0) {
+            final byte[] argument = sequential < arguments.size() ? arguments.get(sequential) : new byte[0];
+            text = replace(text, position, 2, argument);
+            sequential++;
+        }
+        int cursor = 0;
+        while ((position = indexOf(text, (byte) '%', cursor)) >= 0 && position + 1 < text.length) {
+            final int digit = Byte.toUnsignedInt(text[position + 1]);
+            final long argumentIndex = (long) sequential + digit - '1';
+            cursor = position + 1;
+            if (digit >= '0' && digit <= '9' && argumentIndex >= 0 && argumentIndex < arguments.size()) {
+                final byte[] argument = arguments.get((int) argumentIndex);
+                text = replace(text, position, 2, argument);
+                cursor = position + argument.length;
+            }
+        }
+        return text;
+    }
+
+    private static int firstMarker(final byte[] text, final byte prefix) {
+        for (int index = 0; index + 1 < text.length; index++) {
+            if (text[index] == prefix && (text[index + 1] == 's' || text[index + 1] == 'd')) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static int indexOf(final byte[] text, final byte value, final int start) {
+        for (int index = start; index < text.length; index++) {
+            if (text[index] == value) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static byte[] replace(final byte[] text, final int position, final int count, final byte[] replacement) {
+        final byte[] result = new byte[Math.addExact(text.length - count, replacement.length)];
+        System.arraycopy(text, 0, result, 0, position);
+        System.arraycopy(replacement, 0, result, position, replacement.length);
+        System.arraycopy(text, position + count, result, position + replacement.length, text.length - position - count);
+        return result;
+    }
+
+}
