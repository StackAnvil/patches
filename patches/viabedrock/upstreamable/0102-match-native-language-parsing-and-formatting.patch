+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.HexFormat;
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class LanguageLookupTest {
+
+    @Test
+    void foldingCachesValuesWithoutSharingMutableResults() {
+        final var table = new HashMap<String, byte[]>();
+        table.put("name", new byte[]{1, 2});
+        final var lookup = new LanguageLookup(key -> table.get(NbtUtf8.decode(key)));
+        final byte[] key = NbtUtf8.encode("NAME");
+        final byte[] first = lookup.apply(key);
+        first[0] = 9;
+        table.put("name", new byte[]{3, 4});
+        assertArrayEquals(new byte[]{1, 2}, lookup.apply(key));
+        final var replacement = new LanguageLookup(raw -> table.get(NbtUtf8.decode(raw)));
+        assertArrayEquals(new byte[]{3, 4}, replacement.apply(key));
+        assertNull(lookup.apply(new byte[0]));
+    }
+
+    @Test
+    void exactLookupAsciiFoldingAndCacheLifecycleAgreeWithNativeLanguageTables() throws Exception {
+        final String path = System.getenv("STACKANVIL_LANGUAGE_LOOKUP_REFERENCE");
+        Assumptions.assumeTrue(path != null);
+        final var hex = HexFormat.of();
+        final var document = JsonParser.parseString(Files.readString(Path.of(path))).getAsJsonObject();
+        for (final String group : new String[]{"cases", "lifecycle"}) {
+            final var translations = new HashMap<String, byte[]>();
+            final var calls = new JsonArray();
+            LanguageLookup lookup = null;
+            int epoch = -1;
+            for (final var element : document.getAsJsonArray(group)) {
+                final var row = element.getAsJsonObject();
+                translations.clear();
+                for (final var translation : row.getAsJsonArray("translations")) {
+                    final var entry = translation.getAsJsonArray();
+                    translations.put(entry.get(0).getAsString(), hex.parseHex(entry.get(1).getAsString()));
+                }
+                if (epoch != row.get("epoch").getAsInt()) {
+                    epoch = row.get("epoch").getAsInt();
+                    lookup = new LanguageLookup(key -> {
+                        final String encoded = hex.formatHex(key);
+                        calls.add(encoded);
+                        return translations.get(encoded);
+                    });
+                }
+                calls.asList().clear();
+                final byte[] result = lookup.apply(hex.parseHex(row.get("key").getAsString()));
+                if (row.get("present").getAsBoolean()) {
+                    assertArrayEquals(hex.parseHex(row.get("result").getAsString()), result, row::toString);
+                } else {
+                    assertNull(result, row::toString);
+                }
+                final var expected = new JsonArray();
+                for (final var call : row.getAsJsonArray("calls")) {
+                    final var entry = call.getAsJsonArray();
+                    if (entry.get(0).getAsString().equals("primary")) {
+                        expected.add(entry.get(1));
+                    }
+                }
+                assertEquals(expected, calls, row::toString);
+            }
+        }
+    }
+
+}
