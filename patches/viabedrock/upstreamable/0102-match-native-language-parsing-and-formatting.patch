+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import net.raphimc.viabedrock.api.io.NbtUtf8;
+import java.io.ByteArrayOutputStream;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Byte-oriented Bedrock language-file parsing, before text display conversion. */
+public final class LanguageFile {
+
+    private LanguageFile() { }
+
+    public static Result parse(final byte[] input) {
+        return parse(input, Set.of(), Set.of(), new byte[0]);
+    }
+
+    public static Result parse(final byte[] input, final Set<String> excluded, final Set<String> included, final byte[] prefix) {
+        final var translations = new HashMap<String, String>();
+        final var missingSeparators = new ArrayList<MissingSeparator>();
+        final var key = new ByteArrayOutputStream();
+        final var value = new ByteArrayOutputStream();
+        State state = State.KEY_START;
+        int line = 1;
+        boolean special = false;
+        final int start = input.length >= 3 && input[0] == (byte) 0xEF && input[1] == (byte) 0xBB && input[2] == (byte) 0xBF ? 3 : 0;
+        int index = start;
+        while (index <= input.length) {
+            final int character = index == input.length ? 0 : Byte.toUnsignedInt(input[index]);
+            index++;
+            if (character == '\r') {
+                continue;
+            }
+            if (character == '\n' || character == 0) {
+                if (state == State.KEY) {
+                    missingSeparators.add(new MissingSeparator(line, character == '\n'));
+                }
+                if (key.size() != 0 && value.size() != 0) {
+                    final byte[] keyBytes = key.toByteArray();
+                    final String keyName = NbtUtf8.decode(keyBytes);
+                    if (!excluded.contains(keyName) && (included.isEmpty() || included.contains(keyName))) {
+                        final byte[] prefixed = new byte[Math.addExact(prefix.length, keyBytes.length)];
+                        System.arraycopy(prefix, 0, prefixed, 0, prefix.length);
+                        System.arraycopy(keyBytes, 0, prefixed, prefix.length, keyBytes.length);
+                        translations.put(NbtUtf8.decode(prefixed), NbtUtf8.decode(value.toByteArray()));
+                    }
+                }
+                key.reset();
+                value.reset();
+                state = State.KEY_START;
+                if (character == '\n') {
+                    line++;
+                }
+                continue;
+            }
+            switch (state) {
+                case KEY_START -> {
+                    if (character == '\t' || character == ' ') {
+                        continue;
+                    }
+                    if (character == '#' && index < input.length && input[index] == '#') {
+                        state = State.COMMENT;
+                        index++;
+                    } else {
+                        key.write(lowercase(character));
+                        state = State.KEY;
+                    }
+                }
+                case KEY -> {
+                    if (character == '=') {
+                        state = State.VALUE;
+                    } else {
+                        key.write(lowercase(character));
+                    }
+                }
+                case VALUE -> {
+                    if (character == '\t' || character == '#' && index < input.length && input[index] == '#') {
+                        state = State.COMMENT;
+                    } else if (character == '\\' && index < input.length) {
+                        final int next = Byte.toUnsignedInt(input[index]);
+                        if (next == 'n' || next == '\\') {
+                            value.write(next == 'n' ? '\n' : '\\');
+                            index++;
+                        } else {
+                            value.write(character);
+                        }
+                    } else {
+                        special |= character == '~';
+                        value.write(character);
+                    }
+                }
+                case COMMENT -> { }
+            }
+        }
+        return new Result(Map.copyOf(translations), special, List.copyOf(missingSeparators));
+    }
+
+    private static int lowercase(final int character) {
+        return character >= 'A' && character <= 'Z' ? character + 'a' - 'A' : character;
+    }
+
+    private enum State {
+        KEY_START, KEY, VALUE, COMMENT
+    }
+
+    public record MissingSeparator(int line, boolean newline) { }
+
+    public record Result(Map<String, String> translations, boolean special, List<MissingSeparator> missingSeparators) { }
+
+}
