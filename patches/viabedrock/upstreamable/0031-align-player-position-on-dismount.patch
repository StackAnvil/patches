From 7dd757f68ccc1820e3f8777dc187a6ff91f40897 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:21:54 +0200
Subject: [PATCH] fix(vehicles): align player position when dismounting

The Bedrock player input retains the boarding position while a predicted vehicle moves. On unlink or vehicle removal, seed the player position from the vehicle before clearing the mount so the next auth input does not snap the server player back to the boarding point.

Java's passenger unlink does not move the local player to the server's dismount position. Schedule a player position correction after the unlink or entity removal packet so the Java client does not keep the riding offset, which can put a chest boat rider below the surface.
---
 .../api/model/entity/ClientPlayerEntity.java    | 17 +++++++++++++++++
 .../protocol/packet/EntityPackets.java          |  5 +++++
 .../protocol/packet/InteractionPackets.java     |  4 ++--
 .../protocol/storage/EntityTracker.java         |  3 +--
 .../protocol/storage/EntityTrackerTest.java     |  4 ++++
 5 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
index 870cbfaf..91095cc2 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/ClientPlayerEntity.java
@@ -416,6 +416,23 @@ public class ClientPlayerEntity extends PlayerEntity {
         this.paddlingRight = false;
     }
 
+    public void dismountVehicle(final Entity vehicle) {
+        if (this.mountRuntimeId != vehicle.runtimeId()) {
+            return;
+        }
+
+        final Position3f vehiclePosition = vehicle.position();
+        this.setPosition(vehiclePosition.add(0F, this.eyeOffset(), 0F));
+        this.setMountEntityRuntimeId(-1);
+        this.requestedDismount = false;
+    }
+
+    public void scheduleDismountPositionCorrection() {
+        final PacketWrapper playerPosition = PacketWrapper.create(ClientboundPackets26_3.PLAYER_POSITION, this.user);
+        this.writePlayerPositionPacketToClient(playerPosition, Relative.union(Relative.ROTATION, Relative.VELOCITY), true);
+        playerPosition.scheduleSend(BedrockProtocol.class);
+    }
+
     @Override
     public void setMountEntityRuntimeId(final long runtimeId) {
         if (this.mountRuntimeId != runtimeId) {
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
index 94480649..218e04c1 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/EntityPackets.java
@@ -344,9 +344,14 @@ public final class EntityPackets {
                 wrapper.cancel();
                 return;
             }
+            final ClientPlayerEntity clientPlayer = entityTracker.getClientPlayer();
+            final boolean dismountingPlayer = clientPlayer != null && clientPlayer.mountEntityRuntimeId() == entity.runtimeId();
             entityTracker.removeEntity(entity);
 
             wrapper.write(Types.VAR_INT_ARRAY_PRIMITIVE, new int[]{entity.javaId()}); // entity ids
+            if (dismountingPlayer) {
+                clientPlayer.scheduleDismountPositionCorrection();
+            }
         });
         protocol.registerClientbound(ClientboundBedrockPackets.ADD_PAINTING, ClientboundPackets26_3.ADD_ENTITY, wrapper -> {
             final EntityTracker entityTracker = wrapper.user().get(EntityTracker.class);
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
index 4a69f711..eda7af6e 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/InteractionPackets.java
@@ -376,8 +376,8 @@ public final class InteractionPackets {
 
                     if (linkType.toEntityUniqueId() == entityTracker.getClientPlayer().uniqueId()) { // TODO: This could be applied to all passengers not just players
                         // The player is no longer riding an entity, update the state
-                        entityTracker.getClientPlayer().setMountEntityRuntimeId(-1);
-                        entityTracker.getClientPlayer().setRequestedDismount(false);
+                        entityTracker.getClientPlayer().dismountVehicle(vehicle);
+                        entityTracker.getClientPlayer().scheduleDismountPositionCorrection();
                     }
                 }
             }
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/EntityTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/EntityTracker.java
index 221b3c7d..13ae3128 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/EntityTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/EntityTracker.java
@@ -124,8 +124,7 @@ public class EntityTracker extends StoredObject {
             trackedEntity.removePassenger(entity.uniqueId());
         }
         if (this.clientPlayerEntity != null && this.clientPlayerEntity.mountEntityRuntimeId() == entity.runtimeId()) {
-            this.clientPlayerEntity.setMountEntityRuntimeId(-1);
-            this.clientPlayerEntity.setRequestedDismount(false);
+            this.clientPlayerEntity.dismountVehicle(entity);
         }
         entity.remove();
     }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/storage/EntityTrackerTest.java b/src/test/java/net/raphimc/viabedrock/protocol/storage/EntityTrackerTest.java
index 23575461..c76e603f 100644
--- a/src/test/java/net/raphimc/viabedrock/protocol/storage/EntityTrackerTest.java
+++ b/src/test/java/net/raphimc/viabedrock/protocol/storage/EntityTrackerTest.java
@@ -14,6 +14,7 @@ import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
 import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
 import net.raphimc.viabedrock.api.model.entity.Entity;
 import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import net.raphimc.viabedrock.protocol.model.Position3f;
 import org.junit.jupiter.api.Test;
 
 import java.lang.reflect.Proxy;
@@ -60,12 +61,15 @@ class EntityTrackerTest {
         final ClientPlayerEntity player = new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
         tracker.addEntity(player, false);
         final Entity vehicle = tracker.addEntity(10, 100, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        vehicle.setPosition(new Position3f(12F, 64F, 8F));
+        player.setPosition(new Position3f(0F, 65.62F, 0F));
         player.setMountEntityRuntimeId(vehicle.runtimeId());
         vehicle.addPassenger(player.uniqueId());
 
         tracker.removeEntity(vehicle);
 
         assertEquals(-1, player.mountEntityRuntimeId());
+        assertEquals(new Position3f(12F, 65.62F, 8F), player.position());
         assertSame(player, tracker.getEntityByUid(player.uniqueId()));
     }
 
