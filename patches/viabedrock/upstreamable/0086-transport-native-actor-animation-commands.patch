+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import io.netty.buffer.Unpooled;
+import java.util.ArrayList;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class AnimateEntityTest {
+
+    @Test
+    void matchesNativeFieldOrderAndRetainsUnsignedRuntimeIds() {
+        final var buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.STRING.write(buffer, "animation.fixture.raise");
+            BedrockTypes.STRING.write(buffer, "default");
+            BedrockTypes.STRING.write(buffer, "q.state_time > 2");
+            buffer.writeIntLE(1);
+            BedrockTypes.STRING.write(buffer, "fixture.slot");
+            buffer.writeFloatLE(1.25F);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, 3);
+            for (long id : new long[]{9, Long.MIN_VALUE, -1}) {
+                BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(buffer, id);
+            }
+            final byte[] expected = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, expected);
+            final var decoded = AnimateEntity.TYPE.read(buffer);
+            assertEquals(List.of(9L, Long.MIN_VALUE, -1L), decoded.runtimeIds());
+            assertEquals(1, decoded.command().stopExpressionVersion());
+            assertEquals(1.25F, decoded.command().blendOutTime());
+            assertFalse(buffer.isReadable());
+            buffer.clear();
+            AnimateEntity.TYPE.write(buffer, decoded);
+            final byte[] actual = new byte[buffer.readableBytes()];
+            buffer.readBytes(actual);
+            assertArrayEquals(expected, actual);
+            for (int length = 0; length < expected.length; length++) {
+                buffer.clear().writeBytes(expected, 0, length);
+                assertThrows(RuntimeException.class, () -> AnimateEntity.TYPE.read(buffer));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsImpossibleTargetCountsAndCopiesTheCallerList() {
+        final var command = new ActorAnimationCommand("", "", "", -1, "", -0F);
+        final List<Long> ids = new ArrayList<>(List.of(1L));
+        final var value = new AnimateEntity(command, ids);
+        ids.clear();
+        assertEquals(List.of(1L), value.runtimeIds());
+        final var buffer = Unpooled.buffer();
+        try {
+            ActorAnimationCommand.TYPE.write(buffer, command);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> AnimateEntity.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
