+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Runtime controller instructions, including the authored stop-expression version. */
+public record ActorAnimationCommand(String animation, String nextState, String stopExpression,
+                                    int stopExpressionVersion, String controller, float blendOutTime) {
+
+    public static final Type<ActorAnimationCommand> TYPE = new Type<>(ActorAnimationCommand.class) {
+        @Override
+        public ActorAnimationCommand read(final ByteBuf buffer) {
+            return new ActorAnimationCommand(BedrockTypes.STRING.read(buffer), BedrockTypes.STRING.read(buffer),
+                    BedrockTypes.STRING.read(buffer), buffer.readIntLE(), BedrockTypes.STRING.read(buffer), buffer.readFloatLE());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final ActorAnimationCommand value) {
+            BedrockTypes.STRING.write(buffer, value.animation);
+            BedrockTypes.STRING.write(buffer, value.nextState);
+            BedrockTypes.STRING.write(buffer, value.stopExpression);
+            buffer.writeIntLE(value.stopExpressionVersion);
+            BedrockTypes.STRING.write(buffer, value.controller);
+            buffer.writeFloatLE(value.blendOutTime);
+        }
+    };
+
+}
