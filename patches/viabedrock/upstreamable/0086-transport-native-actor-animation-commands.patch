+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import java.util.ArrayList;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Protocol 2193 packet 158 uses unsigned runtime IDs, not unique actor IDs. */
+public record AnimateEntity(ActorAnimationCommand command, List<Long> runtimeIds) {
+
+    public static final Type<AnimateEntity> TYPE = new Type<>(AnimateEntity.class) {
+        @Override
+        public AnimateEntity read(final ByteBuf buffer) {
+            final ActorAnimationCommand command = ActorAnimationCommand.TYPE.read(buffer);
+            final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid animation target count");
+            }
+            final List<Long> targets = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                targets.add(BedrockTypes.UNSIGNED_VAR_LONG.readPrimitive(buffer));
+            }
+            return new AnimateEntity(command, targets);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final AnimateEntity value) {
+            ActorAnimationCommand.TYPE.write(buffer, value.command);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, value.runtimeIds.size());
+            for (final long id : value.runtimeIds) {
+                BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(buffer, id);
+            }
+        }
+    };
+
+    public AnimateEntity {
+        runtimeIds = List.copyOf(runtimeIds);
+    }
+
+}
