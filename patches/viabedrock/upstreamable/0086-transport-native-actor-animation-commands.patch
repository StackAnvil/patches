+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeAnimationControllersTest {
+
+    @Test
+    void uniqueIdentityCollisionRetiresAnimationsWithoutErasingReplacement() {
+        final var actors = new NativeActorStates();
+        final var first = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 17,
+                "minecraft:player", "", 1F, Set.of(), 0, 0, null, Map.of(), 101L);
+        final var next = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 18,
+                "minecraft:player", "", 1F, Set.of(), 0, 0, null, Map.of(), 101L);
+        final var command = new ActorAnimationCommand("raise", "default", "0", 1, "slot", 0);
+        actors.apply(first, null);
+        actors.apply(new NativeAnimationMessage(command,
+                List.of(new NativeAnimationMessage.Target(first.uuid(), first.lifetime(), false))), null);
+        assertNotNull(actors.animations(first.uuid()));
+        actors.apply(next, null);
+        assertNull(actors.animations(first.uuid()));
+        actors.apply(new NativeAnimationMessage(command,
+                List.of(new NativeAnimationMessage.Target(next.uuid(), next.lifetime(), false))), null);
+        final var state = actors.animations(next.uuid());
+        actors.apply(new NativeActorMessage.Remove(first.uuid(), first.lifetime(), false), null);
+        assertSame(state, actors.animations(next.uuid()));
+        assertEquals(next.uuid(), actors.uuidByUniqueId(101));
+    }
+
+    @Test
+    void retainsStatesAndTransitionOrderWhileDeduplicatingAcrossExpressionVersions() {
+        final var model = new NativeAnimationControllers();
+        final var first = new ActorAnimationCommand("raise", "lower", "q.state_time>2", 1, "slot", 2);
+        model.apply(first);
+        final var before = model.snapshot();
+        model.apply(new ActorAnimationCommand(first.animation(), first.nextState(), first.stopExpression(), 9, first.controller(), 0));
+        model.apply(new ActorAnimationCommand(first.animation(), "idle", "q.any_animation_finished", 1, first.controller(), 3));
+        final var after = model.snapshot();
+        final var old = before.controllers().get(first.controller()).get(first.animation());
+        final var current = after.controllers().get(first.controller()).get(first.animation());
+        assertEquals(1, old.selection());
+        assertEquals(3, current.selection());
+        assertEquals(1, current.firstCommand());
+        assertEquals(2, old.blendOutTime());
+        assertEquals(3, current.blendOutTime());
+        assertEquals(1, old.transitions().size());
+        assertEquals(2, current.transitions().size());
+        assertEquals(1, current.transitions().getFirst().expressionVersion());
+        assertEquals(first.nextState(), current.transitions().getFirst().target());
+        assertEquals(3, after.controllers().get(first.controller()).size());
+        assertEquals(0, after.controllers().get(first.controller()).get(first.nextState()).selection());
+        assertThrows(UnsupportedOperationException.class, () -> after.controllers().clear());
+        assertThrows(UnsupportedOperationException.class, () -> current.transitions().clear());
+        assertSame(after, model.snapshot());
+    }
+
+    @Test
+    void createsEmptyNextStatesWithoutConditionsAndKeepsSlotsIndependent() {
+        final var model = new NativeAnimationControllers();
+        final var first = new ActorAnimationCommand("raise", "idle", "", 1, "one", 0);
+        model.apply(first);
+        model.apply(new ActorAnimationCommand(first.animation(), "", "1", 1, "two", 2));
+        final var slots = model.snapshot().controllers();
+        assertEquals(2, slots.get(first.controller()).size());
+        assertTrue(slots.get(first.controller()).get(first.animation()).transitions().isEmpty());
+        assertEquals(List.of(first.nextState()), slots.get(first.controller()).get(first.animation()).nextStates());
+        assertEquals(1, slots.get("two").size());
+        assertTrue(slots.get("two").get(first.animation()).transitions().isEmpty());
+        assertNotEquals(slots.get(first.controller()).get(first.animation()).selection(), slots.get("two").get(first.animation()).selection());
+    }
+
+    @Test
+    void bindsCommandsToLocalIdentityAndClearsThemOnlyWhenTheLifetimeEnds() {
+        final var actors = new NativeActorStates();
+        final UUID local = UUID.randomUUID();
+        final var actor = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), true, 17,
+                "minecraft:player", "", 1F, Set.of(), 0, 0, null, Map.of());
+        actors.apply(actor, local);
+        final var command = new ActorAnimationCommand("raise", "default", "0", 1, "slot", 0);
+        final var target = new NativeAnimationMessage.Target(actor.uuid(), actor.lifetime(), true);
+        actors.apply(new NativeAnimationMessage(command, List.of(target)), local);
+        final var state = actors.animations(local);
+        assertNotNull(state);
+        assertNull(actors.animations(actor.uuid()));
+        actors.apply(actor, local);
+        actors.apply(new NativeActorMessage.Remove(actor.uuid(), UUID.randomUUID(), true), local);
+        assertSame(state, actors.animations(local));
+        actors.apply(new NativeAnimationMessage(command, List.of(new NativeAnimationMessage.Target(actor.uuid(), UUID.randomUUID(), true))), local);
+        assertEquals(1, state.snapshot().revision());
+        final var replacement = new NativeActorMessage.Snapshot(actor.uuid(), UUID.randomUUID(), true, actor.runtimeId(),
+                actor.identifier(), actor.name(), actor.scale(), actor.flags(), 0, 0, null, Map.of());
+        actors.apply(replacement, local);
+        assertNull(actors.animations(local));
+        actors.apply(new NativeAnimationMessage(command, List.of(target)), local);
+        assertNull(actors.animations(local));
+        actors.apply(new NativeAnimationMessage(command, List.of(new NativeAnimationMessage.Target(actor.uuid(), replacement.lifetime(), true))), local);
+        assertNotNull(actors.animations(local));
+        actors.clear();
+        assertNull(actors.animations(local));
+    }
+
+}
