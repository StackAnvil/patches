+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeAnimationMessageTest {
+
+    @Test
+    void retainsCommandsAndActorLifetimesWithImmutableTargets() {
+        final List<NativeAnimationMessage.Target> targets = new ArrayList<>(List.of(
+                new NativeAnimationMessage.Target(UUID.randomUUID(), UUID.randomUUID(), true),
+                new NativeAnimationMessage.Target(UUID.randomUUID(), UUID.randomUUID(), false)));
+        final var command = new ActorAnimationCommand("fixture", "next", "q.state_time > 2", 1, "slot", .75F);
+        final var message = new NativeAnimationMessage(command, targets);
+        targets.clear();
+        assertEquals(2, message.targets().size());
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeAnimationMessage.TYPE.write(buffer, message);
+            final byte[] valid = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, valid);
+            assertEquals(message, NativeAnimationMessage.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            for (int length = 0; length < valid.length; length++) {
+                buffer.clear().writeBytes(valid, 0, length);
+                assertThrows(RuntimeException.class, () -> NativeAnimationMessage.TYPE.read(buffer));
+            }
+            buffer.clear().writeBytes(valid).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeAnimationMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeAnimationMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeAnimationMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+        assertThrows(UnsupportedOperationException.class, () -> message.targets().clear());
+        assertThrows(IllegalArgumentException.class, () -> new NativeAnimationMessage(command,
+                java.util.Collections.nCopies(NativeAnimationMessage.MAX_TARGETS + 1, message.targets().getFirst())));
+    }
+
+}
