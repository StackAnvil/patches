+                }
+                entity.sendNativeActorSnapshot();
+                final var snapshot = entity.nativeActorSnapshot();
+                targets.add(new NativeAnimationMessage.Target(snapshot.uuid(), snapshot.lifetime(), snapshot.localPlayer()));
