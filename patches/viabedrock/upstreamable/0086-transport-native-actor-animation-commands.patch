     public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.ANIMATE_ENTITY, null, wrapper -> {
+            wrapper.cancel();
+            final AnimateEntity animation = wrapper.read(AnimateEntity.TYPE);
+            final ChannelStorage channels = wrapper.user().get(ChannelStorage.class);
+            final EntityTracker entities = wrapper.user().get(EntityTracker.class);
+            if (!channels.hasChannel(NativeAnimationMessage.CHANNEL) || !(channels.hasChannel(NativeActorMessage.CHANNEL) || channels.hasChannel(NativeActorMessage.CURRENT_CHANNEL))
+                    || !entities.nativeActorsJoined()) {
+                return;
+            }
+            final List<NativeAnimationMessage.Target> targets = new ArrayList<>();
+            for (final long id : animation.runtimeIds()) {
+                final Entity entity = entities.getEntityByRid(id);
+                if (entity == null) {
