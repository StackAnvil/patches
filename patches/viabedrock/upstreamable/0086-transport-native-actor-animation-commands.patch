+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+
+/** Retained command definitions; each rendering context resolves its own animation resources. */
+public final class NativeAnimationControllers {
+
+    private final Map<String, Map<String, MutableState>> controllers = new LinkedHashMap<>();
+    private long revision;
+    private Snapshot snapshot;
+
+    public void apply(final ActorAnimationCommand command) {
+        final var states = this.controllers.computeIfAbsent(command.controller(), _ -> new LinkedHashMap<>());
+        final var state = states.computeIfAbsent(command.animation(), _ -> new MutableState());
+        state.selection = ++this.revision;
+        if (state.firstCommand == 0) {
+            state.firstCommand = this.revision;
+        }
+        state.blendOutTime = command.blendOutTime();
+        if (!command.nextState().isEmpty()) {
+            states.computeIfAbsent(command.nextState(), _ -> new MutableState());
+            state.nextStates.add(command.nextState());
+            if (!command.stopExpression().isEmpty()) {
+                final boolean duplicate = state.transitions.stream().anyMatch(transition ->
+                        transition.target().equals(command.nextState()) && transition.expression().equals(command.stopExpression()));
+                if (!duplicate) {
+                    state.transitions.add(new Transition(command.nextState(), command.stopExpression(), command.stopExpressionVersion()));
+                }
+            }
+        }
+        this.snapshot = null;
+    }
+
+    public Snapshot snapshot() {
+        if (this.snapshot == null) {
+            final Map<String, Map<String, State>> result = new LinkedHashMap<>();
+            for (final var controller : this.controllers.entrySet()) {
+                final Map<String, State> states = new LinkedHashMap<>();
+                controller.getValue().forEach((name, state) -> states.put(name, new State(state.blendOutTime,
+                        state.firstCommand, state.selection, List.copyOf(state.nextStates), List.copyOf(state.transitions))));
+                result.put(controller.getKey(), Collections.unmodifiableMap(states));
+            }
+            this.snapshot = new Snapshot(this.revision, Collections.unmodifiableMap(result));
+        }
+        return this.snapshot;
+    }
+
+    public record Snapshot(long revision, Map<String, Map<String, State>> controllers) {
+        public Snapshot {
+            final Map<String, Map<String, State>> copy = new LinkedHashMap<>();
+            controllers.forEach((name, states) -> copy.put(name, Collections.unmodifiableMap(new LinkedHashMap<>(states))));
+            controllers = Collections.unmodifiableMap(copy);
+        }
+    }
+
+    public record State(float blendOutTime, long firstCommand, long selection, List<String> nextStates, List<Transition> transitions) {
+        public State {
+            nextStates = List.copyOf(nextStates);
+            transitions = List.copyOf(transitions);
+        }
+    }
+
+    public record Transition(String target, String expression, int expressionVersion) {
+    }
+
+    private static final class MutableState {
+        private float blendOutTime;
+        private long firstCommand;
+        private long selection;
+        private final Set<String> nextStates = new LinkedHashSet<>();
+        private final List<Transition> transitions = new ArrayList<>();
+    }
+
+}
