+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+
+/** Animation commands bind to the actor lifetime that received the server packet. */
+public record NativeAnimationMessage(ActorAnimationCommand command, List<Target> targets) {
+
+    public static final String CHANNEL = "viabedrock:actor_animation";
+    public static final int MAX_TARGETS = 16384;
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    public static final Type<NativeAnimationMessage> TYPE = new Type<>(NativeAnimationMessage.class) {
+        @Override
+        public NativeAnimationMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES
+                    || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native animation message");
+            }
+            final ActorAnimationCommand command = ActorAnimationCommand.TYPE.read(buffer);
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > MAX_TARGETS || count > buffer.readableBytes() / 33) {
+                throw new IllegalArgumentException("Invalid native animation target count");
+            }
+            final List<Target> targets = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                targets.add(new Target(Types.UUID.read(buffer), Types.UUID.read(buffer), buffer.readBoolean()));
+            }
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native animation data");
+            }
+            return new NativeAnimationMessage(command, targets);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeAnimationMessage value) {
+            final int start = buffer.writerIndex();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            ActorAnimationCommand.TYPE.write(buffer, value.command);
+            Types.VAR_INT.writePrimitive(buffer, value.targets.size());
+            for (final Target target : value.targets) {
+                Types.UUID.write(buffer, target.uuid);
+                Types.UUID.write(buffer, target.lifetime);
+                buffer.writeBoolean(target.localPlayer);
+            }
+            if (buffer.writerIndex() - start > MAX_PAYLOAD_BYTES) {
+                throw new IllegalArgumentException("Native animation exceeds the payload limit");
+            }
+        }
+    };
+
+    public NativeAnimationMessage {
+        targets = List.copyOf(targets);
+        if (targets.size() > MAX_TARGETS) {
+            throw new IllegalArgumentException("Too many native animation targets");
+        }
+    }
+
+    public record Target(UUID uuid, UUID lifetime, boolean localPlayer) {
+    }
+
+}
