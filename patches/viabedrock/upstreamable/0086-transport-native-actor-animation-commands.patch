+    private static void sendAnimation(final UserConnection user,
+                                      final AnimateEntity animation, final List<NativeAnimationMessage.Target> targets) {
+        final PacketWrapper payload = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        payload.write(Types.STRING, NativeAnimationMessage.CHANNEL);
+        payload.write(NativeAnimationMessage.TYPE, new NativeAnimationMessage(animation.command(), targets));
+        payload.send(BedrockProtocol.class);
+    }
+
     public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.ANIMATE_ENTITY, null, wrapper -> {
+            wrapper.cancel();
+            final AnimateEntity animation = wrapper.read(AnimateEntity.TYPE);
+            final ChannelStorage channels = wrapper.user().get(ChannelStorage.class);
+            final EntityTracker entities = wrapper.user().get(EntityTracker.class);
+            if (!channels.hasChannel(NativeAnimationMessage.CHANNEL) || !channels.hasChannel(NativeActorMessage.CHANNEL)
+                    || !entities.nativeActorsJoined()) {
+                return;
+            }
+            final List<NativeAnimationMessage.Target> targets = new ArrayList<>();
+            for (final long id : animation.runtimeIds()) {
+                final Entity entity = entities.getEntityByRid(id);
+                if (entity == null) {
+                    continue;
+                }
+                entity.sendNativeActorSnapshot();
+                final var snapshot = entity.nativeActorSnapshot();
+                targets.add(new NativeAnimationMessage.Target(snapshot.uuid(), snapshot.lifetime(), snapshot.localPlayer()));
+                if (targets.size() == NativeAnimationMessage.MAX_TARGETS) {
+                    sendAnimation(wrapper.user(), animation, targets);
+                    targets.clear();
+                }
+            }
+            if (!targets.isEmpty()) {
+                sendAnimation(wrapper.user(), animation, targets);
+            }
+        });
