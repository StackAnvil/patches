From cf7590ec8457035698c2e52c9f595f20767734e6 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 09:37:50 +0200
Subject: [PATCH] fix(items): translate dyed leather armor colors

Bedrock stores leather armor tint as an ARGB customColor tag. Carry its RGB value into the Java dyed_color component so dyed equipment keeps its color in inventories and on players. Limit the conversion to vanilla leather armor, which has a matching Java item.
---
 .../protocol/rewriter/ItemDataRewriter.java          | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
index 0e35ec6f8..8077ef490 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
@@ -26,6 +26,7 @@ import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
 import com.viaversion.viaversion.api.minecraft.item.Item;
 import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
 import com.viaversion.viaversion.api.minecraft.item.data.BlockStateProperties;
+import com.viaversion.viaversion.api.minecraft.item.data.DyedColor;
 import com.viaversion.viaversion.api.minecraft.item.data.Enchantments;
 import com.viaversion.viaversion.api.minecraft.item.data.EnumTypes;
 import com.viaversion.viaversion.api.minecraft.item.data.FilterableComponent;
@@ -48,11 +49,16 @@ import java.util.ArrayList;
 import java.util.HashMap;
 import java.util.List;
 import java.util.Map;
+import java.util.Set;
 import java.util.function.Function;
 import java.util.logging.Level;
 
 public final class ItemDataRewriter {
 
+    private static final Set<String> DYED_LEATHER_ARMOR_ITEMS = Set.of(
+            "minecraft:leather_helmet", "minecraft:leather_chestplate",
+            "minecraft:leather_leggings", "minecraft:leather_boots");
+
     static void applyJavaOverride(final CompoundTag override, final StructuredDataContainer data, final CompoundTag registries) {
         final PotionContents potionContents = potionContents(override);
         if (potionContents != null) {
@@ -199,6 +205,12 @@ public final class ItemDataRewriter {
 
         if (bedrockTag != null) {
 
+            if (DYED_LEATHER_ARMOR_ITEMS.contains(identifier)
+                    && bedrockTag.get("customColor") instanceof IntTag color) {
+                javaItem.dataContainer().set(StructuredDataKey.DYED_COLOR1_21_5,
+                        new DyedColor(color.asInt() & 0xFFFFFF));
+            }
+
             if (identifier.equals("minecraft:writable_book")) {
                 final WritableBook content = writableBook(bedrockTag);
                 if (content != null) {
