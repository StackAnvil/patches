+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.SpawnParticleEffect;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeParticlePlaybackMessageTest {
+
+    @Test
+    void retainsActorSourceVariablesAndFallbackWithoutAliasing() {
+        for (final long id : new long[]{SpawnParticleEffect.WORLD, Long.MIN_VALUE, Long.MAX_VALUE}) {
+            final byte[] fallback = {1, 2, 3};
+            final var origin = new Position3f(-3.25F, 7.5F, 13.125F);
+            final var effect = new SpawnParticleEffect(2, id, origin, "test:effect", "[]");
+            final var actor = id == SpawnParticleEffect.WORLD ? null : new NativeParticlePlaybackMessage.Actor(-7, UUID.randomUUID());
+            final var message = new NativeParticlePlaybackMessage(effect, origin, actor, fallback);
+            fallback[0] = 9;
+            message.fallback()[0] = 8;
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeParticlePlaybackMessage.TYPE.write(buffer, message);
+                buffer.writeInt(0x12345678);
+                final var decoded = NativeParticlePlaybackMessage.TYPE.read(buffer);
+                assertEquals(effect, decoded.effect());
+                assertEquals(origin, decoded.origin());
+                assertEquals(actor, decoded.actor());
+                assertArrayEquals(new byte[]{1, 2, 3}, decoded.fallback());
+                assertEquals(0x12345678, buffer.readInt());
+                assertEquals(0, buffer.readableBytes());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsWrongProtocolActorBindingAndOversizedBodies() {
+        final var effect = new SpawnParticleEffect(0, SpawnParticleEffect.WORLD, new Position3f(0, 0, 0), "", null);
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeParticlePlaybackMessage.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new NativeParticlePlaybackMessage(effect, effect.position(), null, new byte[65537]));
+            assertThrows(IllegalArgumentException.class, () -> new NativeParticlePlaybackMessage(effect, effect.position(), new NativeParticlePlaybackMessage.Actor(0, UUID.randomUUID()), new byte[0]));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
