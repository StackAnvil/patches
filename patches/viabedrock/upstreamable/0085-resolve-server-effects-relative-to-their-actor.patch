+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Packet 118 uses an actor offset unless its unique ID is the world-space sentinel. */
+public record SpawnParticleEffect(int dimension, long actorUniqueId, Position3f position, String identifier, String molangVariables) {
+
+    public static final long WORLD = -1;
+    public static final Type<SpawnParticleEffect> TYPE = new Type<>(SpawnParticleEffect.class) {
+        @Override
+        public SpawnParticleEffect read(final ByteBuf buffer) {
+            final int dimension = buffer.readUnsignedByte();
+            final long actor = BedrockTypes.VAR_LONG.readPrimitive(buffer);
+            final Position3f position = BedrockTypes.POSITION_3F.read(buffer);
+            final String identifier = BedrockTypes.STRING.read(buffer);
+            final String variables = buffer.readBoolean() ? BedrockTypes.STRING.read(buffer) : null;
+            return new SpawnParticleEffect(dimension, actor, position, identifier, variables);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final SpawnParticleEffect value) {
+            buffer.writeByte(value.dimension);
+            BedrockTypes.VAR_LONG.writePrimitive(buffer, value.actorUniqueId);
+            BedrockTypes.POSITION_3F.write(buffer, value.position);
+            BedrockTypes.STRING.write(buffer, value.identifier);
+            buffer.writeBoolean(value.molangVariables != null);
+            if (value.molangVariables != null) {
+                BedrockTypes.STRING.write(buffer, value.molangVariables);
+            }
+        }
+    };
+
+    public SpawnParticleEffect {
+        if (dimension < 0 || dimension > 255) {
+            throw new IllegalArgumentException("Particle dimension must fit an unsigned byte");
+        }
+    }
+
+    /** A missing attached actor is a no-op; world-space effects do not require one. */
+    public Position3f resolvePosition(final Position3f actorOrigin) {
+        if (this.actorUniqueId == WORLD) {
+            return this.position;
+        }
+        return actorOrigin == null ? null : actorOrigin.add(this.position);
+    }
+
+}
