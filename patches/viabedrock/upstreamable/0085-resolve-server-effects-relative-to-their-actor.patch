+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonParser;
+import com.google.gson.Strictness;
+import com.google.gson.stream.JsonReader;
+import com.google.gson.stream.JsonToken;
+
+import java.io.IOException;
+import java.io.StringReader;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Typed packet variables retain native names, member order and float conversions. */
+public record MolangVariables(List<Member> entries) {
+
+    public static final MolangVariables EMPTY = new MolangVariables(List.of());
+
+    public MolangVariables {
+        entries = List.copyOf(entries);
+    }
+
+    /** Native FNV-1 retains JsonCpp surrogate bytes and stops at a C-string boundary. */
+    public static long hash(final String name) {
+        if (name.isEmpty() || name.charAt(0) == 0) {
+            return 0;
+        }
+        long hash = 0xCBF29CE484222325L;
+        int index = 0;
+        while (index < name.length()) {
+            final int point = name.codePointAt(index);
+            if (point == 0) {
+                break;
+            }
+            index += Character.charCount(point);
+            if (point <= 0x7F) {
+                hash = hashByte(hash, point);
+            } else if (point <= 0x7FF) {
+                hash = hashByte(hash, 0xC0 | point >>> 6);
+                hash = hashByte(hash, 0x80 | point & 0x3F);
+            } else if (point <= 0xFFFF) {
+                hash = hashByte(hash, 0xE0 | point >>> 12);
+                hash = hashByte(hash, 0x80 | point >>> 6 & 0x3F);
+                hash = hashByte(hash, 0x80 | point & 0x3F);
+            } else {
+                hash = hashByte(hash, 0xF0 | point >>> 18);
+                hash = hashByte(hash, 0x80 | point >>> 12 & 0x3F);
+                hash = hashByte(hash, 0x80 | point >>> 6 & 0x3F);
+                hash = hashByte(hash, 0x80 | point & 0x3F);
+            }
+        }
+        return hash;
+    }
+
+    private static long hashByte(final long hash, final int value) {
+        return hash * 0x100000001B3L ^ value;
+    }
+
+    public static MolangVariables parse(final String json) throws IOException {
+        if (json == null) {
+            return EMPTY;
+        }
+        try (JsonReader reader = new JsonReader(new StringReader(document(json)))) {
+            reader.setStrictness(Strictness.STRICT);
+            final JsonElement root = JsonParser.parseReader(reader);
+            if (reader.peek() != JsonToken.END_DOCUMENT || !root.isJsonArray()) {
+                throw new IOException("Particle variables must contain one JSON array");
+            }
+            final List<Member> entries = members(root);
+            // Root assignment sanitizes bad scalars; nested values retain their original bits.
+            for (int index = 0; index < entries.size(); index++) {
+                final Member entry = entries.get(index);
+                if (entry.value instanceof Scalar scalar && !Float.isFinite(scalar.value)) {
+                    entries.set(index, new Member(entry.name, new Scalar(0F)));
+                }
+            }
+            return new MolangVariables(entries);
+        } catch (final RuntimeException invalid) {
+            throw new IOException("Invalid typed particle variables", invalid);
+        }
+    }
+
+    private static List<Member> members(final JsonElement array) {
+        final List<Member> result = new ArrayList<>();
+        for (final JsonElement element : array.getAsJsonArray()) {
+            if (!element.isJsonObject()) {
+                continue;
+            }
+            final var object = element.getAsJsonObject();
+            final var name = object.get("name");
+            final var value = object.get("value");
+            if (name == null || !name.isJsonPrimitive() || !name.getAsJsonPrimitive().isString()
+                    || value == null || value.isJsonNull()) {
+                continue;
+            }
+            final Value parsed = value(value);
+            if (parsed != null) {
+                result.add(new Member(name.getAsString(), parsed));
+            }
+        }
+        return result;
+    }
+
+    private static Value value(final JsonElement element) {
+        if (!element.isJsonObject()) {
+            return null;
+        }
+        final var object = element.getAsJsonObject();
+        final var type = object.get("type");
+        final var value = object.get("value");
+        if (type == null || !type.isJsonPrimitive() || !type.getAsJsonPrimitive().isString()
+                || value == null || value.isJsonNull()) {
+            return null;
+        }
+        return switch (type.getAsString()) {
+            case "float" -> new Scalar(scalar(value));
+            case "member_array" -> value.isJsonArray() ? new Members(members(value)) : null;
+            default -> null;
+        };
+    }
+
+    private static float scalar(final JsonElement value) {
+        if (!value.isJsonPrimitive()) {
+            return 0F;
+        }
+        final var primitive = value.getAsJsonPrimitive();
+        if (primitive.isBoolean()) {
+            return primitive.getAsBoolean() ? 1F : 0F;
+        }
+        if (!primitive.isNumber()) {
+            return 0F;
+        }
+        final String number = primitive.getAsString();
+        if (number.indexOf('.') < 0 && number.indexOf('e') < 0 && number.indexOf('E') < 0) {
+            final BigInteger integer = new BigInteger(number);
+            if (integer.bitLength() <= 63) {
+                return (float) integer.longValue();
+            }
+            if (integer.signum() >= 0 && integer.bitLength() <= 64) {
+                return integer.floatValue();
+            }
+        }
+        return (float) primitive.getAsDouble();
+    }
+
+    /** Match the native reader's comments and first-document behavior before strict JSON decoding. */
+    private static String document(final String json) throws IOException {
+        if (json.length() > 262144) {
+            throw new IOException("Particle variables exceed the size limit");
+        }
+        final StringBuilder result = new StringBuilder(json.length());
+        int depth = 0;
+        int nodes = 0;
+        boolean quoted = false;
+        boolean escaped = false;
+        int index = 0;
+        while (index < json.length()) {
+            final char value = json.charAt(index);
+            if (quoted) {
+                if (escaped) {
+                    result.append(value);
+                    if (value == 'u' && index + 4 < json.length()) {
+                        final int unit = hexUnit(json, index + 1);
+                        if (unit >= 0xD800 && unit <= 0xDBFF) {
+                            if (index + 10 >= json.length() || json.charAt(index + 5) != '\\' || json.charAt(index + 6) != 'u') {
+                                throw new IOException("Missing particle variable Unicode continuation");
+                            }
+                            final int continuation = hexUnit(json, index + 7);
+                            result.append(json, index + 1, index + 5).append("\\u")
+                                    .append(Integer.toHexString(0xDC00 | continuation & 0x3FF));
+                            index += 10;
+                        }
+                    }
+                    escaped = false;
+                } else if (value == '\\') {
+                    result.append(value);
+                    escaped = true;
+                } else if (value < 0x20) {
+                    result.append("\\u00").append(Character.forDigit(value >>> 4, 16)).append(Character.forDigit(value & 15, 16));
+                } else {
+                    result.append(value);
+                    if (value == '"') {
+                        quoted = false;
+                    }
+                }
+            } else if (value == '/' && index + 1 < json.length() && json.charAt(index + 1) == '/') {
+                index += 2;
+                while (index < json.length() && json.charAt(index) != '\r' && json.charAt(index) != '\n') {
+                    index++;
+                }
+                result.append(' ');
+            } else if (value == '/' && index + 1 < json.length() && json.charAt(index + 1) == '*') {
+                final int end = json.indexOf("*/", index + 2);
+                if (end < 0) {
+                    throw new IOException("Unterminated particle variable comment");
+                }
+                index = end + 1;
+                result.append(' ');
+            } else if (value == '"') {
+                result.append(value);
+                quoted = true;
+            } else if (value == '[' || value == '{') {
+                if (++depth > 32 || ++nodes > 16384) {
+                    throw new IOException("Particle variables exceed the nesting limit");
+                }
+                result.append(value);
+            } else if (value == ']' || value == '}') {
+                result.append(value);
+                if (--depth == 0) {
+                    return result.toString();
+                }
+            } else if (value == '-' || value >= '0' && value <= '9') {
+                final int start = index;
+                if (value == '-') {
+                    index++;
+                }
+                while (index < json.length() && json.charAt(index) >= '0' && json.charAt(index) <= '9') {
+                    index++;
+                }
+                final int end = index;
+                while (index < json.length() && (json.charAt(index) >= '0' && json.charAt(index) <= '9'
+                        || json.charAt(index) == '.' || json.charAt(index) == 'e' || json.charAt(index) == 'E'
+                        || json.charAt(index) == '-' || json.charAt(index) == '+')) {
+                    index++;
+                }
+                int digits = start + (value == '-' ? 1 : 0);
+                if (value == '-') {
+                    result.append('-');
+                }
+                while (digits + 1 < end && json.charAt(digits) == '0') {
+                    digits++;
+                }
+                result.append(json, digits, index);
+                index--;
+            } else {
+                result.append(value);
+            }
+            index++;
+        }
+        return result.toString();
+    }
+
+    private static int hexUnit(final String json, final int start) throws IOException {
+        int result = 0;
+        for (int index = start; index < start + 4; index++) {
+            final char value = json.charAt(index);
+            final int digit = value >= '0' && value <= '9' ? value - '0'
+                    : value >= 'a' && value <= 'f' ? value - 'a' + 10
+                    : value >= 'A' && value <= 'F' ? value - 'A' + 10 : -1;
+            if (digit < 0) {
+                throw new IOException("Invalid particle variable Unicode escape");
+            }
+            result = result << 4 | digit;
+        }
+        return result;
+    }
+
+    public sealed interface Value permits Scalar, Members {
+    }
+
+    public record Scalar(float value) implements Value {
+    }
+
+    public record Member(String name, Value value) {
+    }
+
+    public record Members(List<Member> entries) implements Value {
+        public Members {
+            entries = List.copyOf(entries);
+        }
+    }
+
+}
