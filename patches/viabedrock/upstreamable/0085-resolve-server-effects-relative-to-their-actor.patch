+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.SpawnParticleEffect;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import com.viaversion.viaversion.api.connection.UserConnection;
+
+import java.io.IOException;
+import java.util.UUID;
+
+/** Native effects retain their source actor and a complete standard Java fallback. */
+public record NativeParticlePlaybackMessage(SpawnParticleEffect effect, Position3f origin, Actor actor, byte[] fallback) {
+
+    public static final String CHANNEL = "viabedrock:particle_playback";
+    public static final Type<NativeParticlePlaybackMessage> TYPE = new Type<>(NativeParticlePlaybackMessage.class) {
+        @Override
+        public NativeParticlePlaybackMessage read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native particle message");
+            }
+            final SpawnParticleEffect effect = SpawnParticleEffect.TYPE.read(buffer);
+            final Position3f origin = BedrockTypes.POSITION_3F.read(buffer);
+            final Actor actor = buffer.readBoolean() ? new Actor(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer)) : null;
+            final int size = Types.VAR_INT.readPrimitive(buffer);
+            if (size < 0 || size > 65536 || size > buffer.readableBytes()) {
+                throw new IllegalArgumentException("Invalid Java particle fallback size");
+            }
+            final byte[] fallback = new byte[size];
+            buffer.readBytes(fallback);
+            return new NativeParticlePlaybackMessage(effect, origin, actor, fallback);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeParticlePlaybackMessage value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            SpawnParticleEffect.TYPE.write(buffer, value.effect);
+            BedrockTypes.POSITION_3F.write(buffer, value.origin);
+            buffer.writeBoolean(value.actor != null);
+            if (value.actor != null) {
+                Types.VAR_INT.writePrimitive(buffer, value.actor.javaId);
+                Types.UUID.write(buffer, value.actor.javaUuid);
+            }
+            Types.VAR_INT.writePrimitive(buffer, value.fallback.length);
+            buffer.writeBytes(value.fallback);
+        }
+    };
+
+    public NativeParticlePlaybackMessage {
+        if ((effect.actorUniqueId() == SpawnParticleEffect.WORLD) != (actor == null)) {
+            throw new IllegalArgumentException("Particle actor identity does not match its source");
+        }
+        if (fallback.length > 65536) {
+            throw new IllegalArgumentException("Java particle fallback exceeds its size limit");
+        }
+        fallback = fallback.clone();
+    }
+
+    @Override
+    public byte[] fallback() {
+        return this.fallback.clone();
+    }
+
+    public MolangVariables variables() throws IOException {
+        return MolangVariables.parse(this.effect.molangVariables());
+    }
+
+    public static boolean supports(final UserConnection user) {
+        return user.get(ChannelStorage.class).hasChannel(CHANNEL);
+    }
+
+    public record Actor(int javaId, UUID javaUuid) {
+    }
+
+}
