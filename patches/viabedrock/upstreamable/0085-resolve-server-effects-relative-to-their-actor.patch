+package net.raphimc.viabedrock.protocol.model;
+
+import com.google.gson.JsonParser;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.ByteBufUtil;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class SpawnParticleEffectTest {
+
+    @Test
+    void readsNativeFieldOrderAndPreservesTypedNestedVariables() {
+        // Native serializer, with supplied primitive-stream and authored JSON boundaries.
+        final byte[] wire = HexFormat.of().parseHex(
+                "");
+        final ByteBuf input = Unpooled.wrappedBuffer(wire);
+        final ByteBuf output = Unpooled.buffer();
+        try {
+            final var effect = SpawnParticleEffect.TYPE.read(input);
+            assertEquals(255, effect.dimension());
+            assertEquals(Long.MIN_VALUE, effect.actorUniqueId());
+            assertEquals(new Position3f(-123.125F, 65.5F, 42.25F), effect.position());
+            final var value = JsonParser.parseString(effect.molangVariables()).getAsJsonArray().get(0)
+                    .getAsJsonObject().getAsJsonObject("value").getAsJsonArray("value").get(0)
+                    .getAsJsonObject().getAsJsonObject("value");
+            assertEquals(-3.25F, value.get("value").getAsFloat());
+            assertEquals(0, input.readableBytes());
+            SpawnParticleEffect.TYPE.write(output, effect);
+            assertEquals(HexFormat.of().formatHex(wire), ByteBufUtil.hexDump(output));
+        } finally {
+            input.release();
+            output.release();
+        }
+    }
+
+    @Test
+    void keepsAbsentAndPresentEmptyVariablesSeparate() {
+        for (final String variables : new String[]{null, "", "[]"}) {
+            for (final long actor : new long[]{-1, 0, 7, Long.MIN_VALUE, Long.MAX_VALUE}) {
+                final var expected = new SpawnParticleEffect(2, actor, new Position3f(0.125F, -2.25F, 3.5F), "", variables);
+                final ByteBuf buffer = Unpooled.buffer();
+                try {
+                    SpawnParticleEffect.TYPE.write(buffer, expected);
+                    buffer.writeIntLE(0x78563412);
+                    assertEquals(expected, SpawnParticleEffect.TYPE.read(buffer));
+                    assertEquals(0x78563412, buffer.readIntLE());
+                    assertEquals(0, buffer.readableBytes());
+                } finally {
+                    buffer.release();
+                }
+            }
+        }
+    }
+
+    @Test
+    void resolvesAttachedOffsetsWithoutMovingWorldEffects() {
+        final Position3f offset = new Position3f(-3.25F, 7.5F, 13.125F);
+        final var world = new SpawnParticleEffect(0, -1, offset, "", null);
+        final var attached = new SpawnParticleEffect(0, 7, offset, "", null);
+        assertEquals(offset, world.resolvePosition(null));
+        assertEquals(offset, world.resolvePosition(new Position3f(100, 65, -200)));
+        assertNull(attached.resolvePosition(null));
+        assertEquals(new Position3f(96.75F, 72.5F, -186.875F), attached.resolvePosition(new Position3f(100, 65, -200)));
+        assertEquals(new Position3f(33554428F, 7.5F, 13.125F),
+                attached.resolvePosition(new Position3f(33554432F, 0, 0)));
+    }
+
+}
