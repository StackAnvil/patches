+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MolangVariablesTest {
+
+    private static JsonObject named(final String name, final String type, final JsonElement value) {
+        final JsonObject typed = new JsonObject();
+        typed.addProperty("type", type);
+        typed.add("value", value);
+        final JsonObject result = new JsonObject();
+        result.addProperty("name", name);
+        result.add("value", typed);
+        return result;
+    }
+
+    @Test
+    void preservesStructuredNamesOrderDuplicatesAndUnsupportedEntries() throws IOException {
+        final JsonArray values = new JsonArray();
+        values.add(named("R", "float", new JsonPrimitive(9F)));
+        values.add(named("r", "float", new JsonPrimitive(.25F)));
+        values.add(named("r", "float", new JsonPrimitive(.75F)));
+        values.add(named("ignored", "unknown", new JsonPrimitive(1)));
+        final JsonArray roots = new JsonArray();
+        roots.add(named("variable.color", "member_array", values));
+        roots.add(named("variable.scale", "float", new JsonPrimitive(1)));
+        roots.add(named("variable.scale", "float", new JsonPrimitive(2)));
+        roots.add(named("variable.scale", "member_array", new JsonPrimitive(3)));
+        final MolangVariables parsed = MolangVariables.parse(roots.toString());
+        final var members = (MolangVariables.Members) parsed.entries().get(0).value();
+        assertEquals(3, parsed.entries().size());
+        assertEquals(3, members.entries().size());
+        assertNotEquals(MolangVariables.hash(members.entries().get(0).name()), MolangVariables.hash(members.entries().get(1).name()));
+        assertEquals(members.entries().get(1).name(), members.entries().get(2).name());
+        assertEquals(new MolangVariables.Scalar(.25F), members.entries().get(1).value());
+        assertThrows(UnsupportedOperationException.class, () -> parsed.entries().clear());
+        assertThrows(UnsupportedOperationException.class, () -> members.entries().clear());
+        assertEquals(MolangVariables.hash("r"), MolangVariables.hash("r\0ignored"));
+    }
+
+    @Test
+    void matchesNativeJsonFloatConversionsAndRootSanitization() throws IOException {
+        final List<JsonPrimitive> inputs = List.of(new JsonPrimitive(true), new JsonPrimitive(false), new JsonPrimitive("2.5"),
+                new JsonPrimitive(9007199254740993L), new JsonPrimitive(new BigInteger("18446744073709551615")),
+                new JsonPrimitive(1E100), new JsonPrimitive(new BigDecimal("1.0000000596046447753906250001")));
+        final float[] expected = {1, 0, 0, (float) 9007199254740993L, 0x1P64F, 0, 1};
+        for (int index = 0; index < inputs.size(); index++) {
+            final JsonArray roots = new JsonArray();
+            roots.add(named("variable.test", "float", inputs.get(index)));
+            final var value = (MolangVariables.Scalar) MolangVariables.parse(roots.toString()).entries().get(0).value();
+            assertEquals(expected[index], value.value());
+        }
+        final JsonArray nested = new JsonArray();
+        nested.add(named("x", "float", new JsonPrimitive(1E100)));
+        final JsonArray roots = new JsonArray();
+        roots.add(named("variable.vector", "member_array", nested));
+        final var value = (MolangVariables.Members) MolangVariables.parse(roots.toString()).entries().get(0).value();
+        assertEquals(Float.POSITIVE_INFINITY, ((MolangVariables.Scalar) value.entries().get(0).value()).value());
+    }
+
+    @Test
+    void matchesNativeHashOrderEmptyNamesUtf8AndSurrogateBytes() {
+        assertEquals(0, MolangVariables.hash(""));
+        assertEquals(0, MolangVariables.hash("\0ignored"));
+        assertEquals(0xAF63BD4C8601B7ADL, MolangVariables.hash("r"));
+        assertEquals(0xAF63BD4C8601B78DL, MolangVariables.hash("R"));
+        assertEquals(0x260314731B2C75D2L, MolangVariables.hash("variable.color"));
+        assertEquals(0xAF63BD4C8601B7ADL, MolangVariables.hash("r\0ignored"));
+        assertEquals(0xD70074186A1A8172L, MolangVariables.hash(String.valueOf((char) 0xDC00)));
+        assertEquals(0x56B7057C3CAE5C83L, MolangVariables.hash(new String(Character.toChars(0x10061))));
+        assertEquals(0x56B7067C3CAE5D55L, MolangVariables.hash(new String(Character.toChars(0x10000))));
+    }
+
+    @Test
+    void matchesNativeCommentsTrailingDataLeadingZerosAndRawStringControls() throws IOException {
+        final JsonArray roots = new JsonArray();
+        roots.add(named("variable.test", "float", new JsonPrimitive(1)));
+        final MolangVariables expected = MolangVariables.parse(roots.toString());
+        assertEquals(expected, MolangVariables.parse("/* {[[ */" + roots + " [] trailing"));
+        assertEquals(expected, MolangVariables.parse("// comment\r\n" + roots + " /* unterminated"));
+        assertEquals(expected, MolangVariables.parse(roots.toString().replace("[", "[/* comment */").replace(":1", ":0001")));
+        for (int control = 0; control < 32; control++) {
+            roots.add(named("variable." + (char) control + "name", "float", new JsonPrimitive(control)));
+        }
+        assertEquals(MolangVariables.parse(roots.toString()), MolangVariables.parse(roots.toString().replace("\\n", "\n")));
+        final String escapedName = "variable." + "\\uD800\\u0061";
+        final JsonArray unicode = new JsonArray();
+        unicode.add(named("variable." + new String(Character.toChars(0x10061)), "float", new JsonPrimitive(3)));
+        assertEquals(MolangVariables.parse(unicode.toString()), MolangVariables.parse(unicode.toString()
+                .replace("variable." + new String(Character.toChars(0x10061)), escapedName)));
+        assertThrows(IOException.class, () -> MolangVariables.parse("[\"" + "\\uD800" + "\"]"));
+        assertEquals(MolangVariables.EMPTY, MolangVariables.parse("[] []"));
+        assertEquals(MolangVariables.EMPTY, MolangVariables.parse("[01]"));
+        for (final String invalid : List.of("[1,]", "[+1]", "[.1]", "[0x1]", "['a']", "[{a:1}]", "[/* unfinished")) {
+            assertThrows(IOException.class, () -> MolangVariables.parse(invalid));
+        }
+    }
+
+    @Test
+    void boundsTreesAndRejectsInvalidDocumentsWithoutChangingAbsentValues() throws IOException {
+        assertEquals(MolangVariables.EMPTY, MolangVariables.parse(null));
+        for (final String invalid : List.of("", "null", "{}", "[", "[NaN]", "[".repeat(33) + "]".repeat(33), " ".repeat(262145))) {
+            assertThrows(IOException.class, () -> MolangVariables.parse(invalid));
+        }
+    }
+
+}
