+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.api.resourcepack.definition.FogDefinitions;
+import net.raphimc.viabedrock.api.resourcepack.definition.BiomeDefinitions;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FogStorageTest {
+
+    @Test
+    void reResolvesResourceOwnershipAndReplacesRatherThanAppendsStacks() {
+        final var storage = new FogStorage(mock(UserConnection.class));
+        final var definitions = mock(FogDefinitions.class);
+        final var resources = resources(definitions, Map.of());
+        final var current = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        final var older = new FogState.Distance(0, 32, 0, false);
+        final String identifier = "test:world";
+        storage.update(new String[]{identifier});
+        when(definitions.get(identifier)).thenReturn(new FogDefinitions.FogDefinition(identifier, Map.of(), Map.of("air", current)));
+        final var first = storage.snapshot(resources);
+        when(definitions.get(identifier)).thenReturn(new FogDefinitions.FogDefinition(identifier, Map.of(), Map.of("air", older)));
+        assertSame(older, storage.snapshot(resources).resolve("air", null));
+        assertSame(current, first.resolve("air", null));
+        storage.update(new String[]{"test:missing"});
+        assertNull(storage.snapshot(resources).resolve("air", null));
+        storage.update(new String[0]);
+        assertEquals(FogState.EMPTY, storage.snapshot(resources));
+    }
+
+    @Test
+    void publishesOnlyAfterJoinPlayAndChannelRegistrationIncludingEmptyReset() {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var resources = mock(ResourcePackStorage.class);
+        when(user.get(ResourcePackStorage.class)).thenReturn(resources);
+        when(resources.getFogs()).thenReturn(mock(FogDefinitions.class));
+        when(resources.getBiomes()).thenReturn(mock(BiomeDefinitions.class));
+        final var storage = new FogStorage(user);
+        final var output = mock(PacketWrapper.class);
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(output);
+            storage.sendSnapshot();
+            storage.markJoined();
+            storage.sendSnapshot();
+            channels.addChannels(List.of(FogState.CHANNEL));
+            when(info.getServerState()).thenReturn(State.CONFIGURATION);
+            storage.sendSnapshot();
+            verifyNoInteractions(output);
+            when(info.getServerState()).thenReturn(State.PLAY);
+            storage.sendSnapshot();
+            verify(output).write(FogState.TYPE, FogState.EMPTY);
+        }
+    }
+
+    @Test
+    void worldReplacementAndEmptyCommandsResolveCurrentBiomeResources() {
+        final var storage = new FogStorage(mock(UserConnection.class));
+        final var definitions = mock(FogDefinitions.class);
+        final var biomes = mock(BiomeDefinitions.class);
+        final var biome = mock(BiomeDefinitions.BiomeDefinition.class);
+        when(biome.name()).thenReturn("minecraft:the_end");
+        when(biome.fog()).thenReturn("test:end");
+        when(biomes.biomes()).thenReturn(Map.of("minecraft:the_end", biome));
+        final var resources = mock(ResourcePackStorage.class);
+        when(resources.getFogs()).thenReturn(definitions);
+        when(resources.getBiomes()).thenReturn(biomes);
+        final var current = new FogState.Distance(0, 32, 0xFF0000, false);
+        final var older = new FogState.Distance(0, 64, 0x0000FF, false);
+        final var command = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        when(definitions.get("test:end")).thenReturn(new FogDefinitions.FogDefinition("test:end", Map.of(), Map.of("air", current)));
+        when(definitions.get("test:command")).thenReturn(new FogDefinitions.FogDefinition("test:command", Map.of(), Map.of("air", command)));
+        final var fallback = new FogState.Distance(0.25F, 0.75F, 0x123456, true);
+        when(definitions.get("minecraft:fog_default")).thenReturn(new FogDefinitions.FogDefinition("minecraft:fog_default", Map.of(), Map.of("air", fallback)));
+        final var first = storage.snapshot(resources);
+        assertSame(fallback, first.resolve("air", "test:unknown"));
+        storage.update(new String[]{"test:command"});
+        assertSame(command, storage.snapshot(resources).resolve("air", "the_end"));
+        when(definitions.get("test:end")).thenReturn(new FogDefinitions.FogDefinition("test:end", Map.of(), Map.of("air", older)));
+        storage.update(new String[0]);
+        assertSame(older, storage.snapshot(resources).resolve("air", "the_end"));
+        assertSame(current, first.resolve("air", "the_end"));
+        when(biomes.biomes()).thenReturn(Map.of());
+        assertSame(fallback, storage.snapshot(resources).resolve("air", "the_end"));
+        when(definitions.get("minecraft:fog_default")).thenReturn(null);
+        assertEquals(FogState.EMPTY, storage.snapshot(resources));
+    }
+
+    private static ResourcePackStorage resources(final FogDefinitions definitions, final Map<String, BiomeDefinitions.BiomeDefinition> bindings) {
+        final var resources = mock(ResourcePackStorage.class);
+        final var biomes = mock(BiomeDefinitions.class);
+        when(resources.getFogs()).thenReturn(definitions);
+        when(resources.getBiomes()).thenReturn(biomes);
+        when(biomes.biomes()).thenReturn(bindings);
+        return resources;
+    }
+
+}
