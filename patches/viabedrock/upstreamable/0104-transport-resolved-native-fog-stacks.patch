+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FogStateTest {
+
+    @Test
+    void resolvesTheLastDefinedMediumWithoutDiscardingLowerAir() {
+        final var air = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        final var water = new FogState.Distance(0, 4, 0x00FF00, false);
+        final var red = new FogState.Distance(0, 32, 0xFF0000, false);
+        final var layers = new ArrayList<FogState.Layer>();
+        layers.add(new FogState.Layer("test:air", Map.of("air", air)));
+        layers.add(new FogState.Layer("test:water", Map.of("water", water)));
+        final var state = new FogState(layers, Map.of(), Map.of());
+        layers.add(new FogState.Layer("test:red", Map.of("air", red)));
+        assertSame(air, state.resolve("air", null));
+        assertSame(water, state.resolve("water", null));
+        assertSame(red, new FogState(layers, Map.of(), Map.of()).resolve("air", null));
+        assertNull(state.resolve("lava", null));
+        assertNull(FogState.EMPTY.resolve("air", null));
+    }
+
+    @Test
+    void retainsAtomicImmutableLayersAndIndependentDistanceUnits() {
+        final var settings = new HashMap<String, FogState.Distance>();
+        final var relative = new FogState.Distance(-0.25F, 0.75F, 0, true);
+        settings.put("air", relative);
+        final var layer = new FogState.Layer("test:relative", settings);
+        settings.clear();
+        assertEquals(-48, layer.distances().get("air").start(192));
+        assertEquals(144, layer.distances().get("air").end(192));
+        assertEquals(72, relative.end(96));
+        assertEquals(16, new FogState.Distance(0, 16, 0, false).end(192));
+        assertThrows(UnsupportedOperationException.class, () -> layer.distances().clear());
+    }
+
+    @Test
+    void roundTripsAllFieldsAndRejectsTrailingAndInvalidCounts() {
+        final var state = new FogState(List.of(new FogState.Layer("test:both", Map.of(
+                "air", new FogState.Distance(-0.125F, 0.9375F, 0xABCDEF, true),
+                "water", new FogState.Distance(2, 14.5F, 0x123456, false)))), Map.of(), Map.of());
+        final var buffer = Unpooled.buffer();
+        try {
+            FogState.TYPE.write(buffer, state);
+            assertEquals(state, FogState.TYPE.read(buffer.duplicate()));
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer.duplicate()));
+            for (final int count : new int[]{-1, 17}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 2);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer.duplicate()));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void commandsOverrideBiomesAndDefaultsIndependentlyForEachMedium() {
+        final var base = new FogState.Distance(0.25F, 0.75F, 0x123456, true);
+        final var biome = new FogState.Distance(0, 32, 0xFF0000, false);
+        final var water = new FogState.Distance(0, 4, 0x00FF00, false);
+        final var command = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        final var bindings = Map.of("the_end", new FogState.Layer("test:biome", Map.of("air", biome)));
+        final var defaults = Map.of("air", base);
+        final var state = new FogState(List.of(new FogState.Layer("test:water", Map.of("water", water))), bindings, defaults);
+        assertSame(biome, state.resolve("air", "minecraft:the_end"));
+        assertSame(biome, state.resolve("air", "the_end"));
+        assertSame(base, state.resolve("air", "test:unknown"));
+        assertSame(base, state.resolve("air", null));
+        assertSame(water, state.resolve("water", "the_end"));
+        final var overridden = new FogState(List.of(new FogState.Layer("test:command", Map.of("air", command))), bindings, defaults);
+        assertSame(command, overridden.resolve("air", "the_end"));
+        final var reset = new FogState(List.of(), bindings, defaults);
+        assertSame(biome, reset.resolve("air", "the_end"));
+        assertNull(reset.resolve("water", "the_end"));
+        assertSame(base, reset.resolve("air", "test:the_end"));
+    }
+
+    @Test
+    void roundTripsImmutableWorldSettingsAndRejectsAmbiguousBiomeAliases() {
+        final var distance = new FogState.Distance(0, 32, 0xFF0000, false);
+        final var biomes = new HashMap<String, FogState.Layer>();
+        final var defaults = new HashMap<String, FogState.Distance>();
+        biomes.put("the_end", new FogState.Layer("test:red", Map.of("air", distance)));
+        defaults.put("water", new FogState.Distance(0, 8, 0, false));
+        final var state = new FogState(List.of(), biomes, defaults);
+        biomes.clear();
+        defaults.clear();
+        final var buffer = Unpooled.buffer();
+        try {
+            FogState.TYPE.write(buffer, state);
+            final var decoded = FogState.TYPE.read(buffer);
+            assertEquals(state, decoded);
+            assertEquals(distance, decoded.resolve("air", "the_end"));
+            assertEquals(8, decoded.resolve("water", "the_end").end(192));
+            biomes.put("the_end", state.biomes().get("minecraft:the_end"));
+            biomes.put("minecraft:the_end", state.biomes().get("minecraft:the_end"));
+            assertThrows(IllegalArgumentException.class, () -> new FogState(List.of(), biomes, Map.of()));
+            for (final int count : new int[]{-1, FogState.MAX_BIOMES + 1}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 2);
+                Types.VAR_INT.writePrimitive(buffer, 0);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer.duplicate()));
+            }
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsNonFiniteReversedAndOutOfRangeSettings() {
+        for (final float value : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(value, 16, 0, false));
+            assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, value, 0, false));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(17, 16, 0, false));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(-1, 16, 0, false));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(-2, 1, 0, true));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, 2, 0, true));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, 1, 0xFF000000, true));
+    }
+
+}
