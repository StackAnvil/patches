+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.type.Types;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.storage.FogStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public final class FogPackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.PLAYER_FOG, null, wrapper -> {
+            wrapper.cancel();
+            final String[] identifiers = wrapper.read(BedrockTypes.STRING_ARRAY);
+            if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                throw new IllegalArgumentException("Unexpected native fog fields");
+            }
+            final FogStorage storage = wrapper.user().get(FogStorage.class);
+            storage.update(identifiers);
+            storage.sendSnapshot();
+        });
+    }
+
+    private FogPackets() {
+    }
+
+}
