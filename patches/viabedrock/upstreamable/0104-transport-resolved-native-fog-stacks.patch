+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** An atomic command stack resolved against this connection's selected resource packs. */
+public record FogState(List<Layer> layers) {
+
+    public static final String CHANNEL = "viabedrock:fog";
+    public static final int MAX_LAYERS = 16;
+    public static final FogState EMPTY = new FogState(List.of());
+    public static final Type<FogState> TYPE = new Type<>(FogState.class) {
+        @Override
+        public FogState read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1) {
+                throw new IllegalArgumentException("Unsupported fog payload version");
+            }
+            final int count = boundedCount(buffer, MAX_LAYERS);
+            final List<Layer> layers = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                final String identifier = Types.STRING.read(buffer);
+                final int settingCount = boundedCount(buffer, 16);
+                final Map<String, Distance> distances = new LinkedHashMap<>();
+                for (int j = 0; j < settingCount; j++) {
+                    final String medium = Types.STRING.read(buffer);
+                    final Distance distance = new Distance(buffer.readFloat(), buffer.readFloat(), buffer.readInt(), buffer.readBoolean());
+                    if (distances.put(medium, distance) != null) {
+                        throw new IllegalArgumentException("Duplicate fog medium");
+                    }
+                }
+                layers.add(new Layer(identifier, distances));
+            }
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected fog payload fields");
+            }
+            return new FogState(layers);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final FogState state) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, state.layers.size());
+            for (final Layer layer : state.layers) {
+                Types.STRING.write(buffer, layer.identifier);
+                Types.VAR_INT.writePrimitive(buffer, layer.distances.size());
+                for (final Map.Entry<String, Distance> entry : layer.distances.entrySet()) {
+                    Types.STRING.write(buffer, entry.getKey());
+                    final Distance distance = entry.getValue();
+                    buffer.writeFloat(distance.start).writeFloat(distance.end).writeInt(distance.color).writeBoolean(distance.renderRelative);
+                }
+            }
+        }
+
+        private static int boundedCount(final ByteBuf buffer, final int maximum) {
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > maximum) {
+                throw new IllegalArgumentException("Invalid fog payload count");
+            }
+            return count;
+        }
+    };
+
+    public FogState {
+        layers = List.copyOf(layers);
+        if (layers.size() > MAX_LAYERS) {
+            throw new IllegalArgumentException("Too many fog layers");
+        }
+    }
+
+    /** Native stack precedence applies independently to each medium, not to individual fields. */
+    public Distance resolve(final String medium) {
+        for (int i = this.layers.size() - 1; i >= 0; i--) {
+            final Distance distance = this.layers.get(i).distances.get(medium);
+            if (distance != null) {
+                return distance;
+            }
+        }
+        return null;
+    }
+
+    public record Layer(String identifier, Map<String, Distance> distances) {
+        public Layer {
+            if (identifier == null || identifier.isEmpty() || identifier.length() > 256 || distances.size() > 16) {
+                throw new IllegalArgumentException("Invalid fog layer");
+            }
+            distances = Map.copyOf(distances);
+            for (final String medium : distances.keySet()) {
+                if (medium.isEmpty() || medium.length() > 64) {
+                    throw new IllegalArgumentException("Invalid fog medium");
+                }
+            }
+        }
+    }
+
+    public record Distance(float start, float end, int color, boolean renderRelative) {
+        public Distance {
+            if (!Float.isFinite(start) || !Float.isFinite(end) || end < 0 || start > end || (color & 0xFF000000) != 0
+                    || (renderRelative ? start < -1 || end > 1 : start < 0)) {
+                throw new IllegalArgumentException("Invalid fog distance");
+            }
+        }
+
+        public float start(final float renderDistance) {
+            return this.renderRelative ? this.start * renderDistance : this.start;
+        }
+
+        public float end(final float renderDistance) {
+            return this.renderRelative ? this.end * renderDistance : this.end;
+        }
+    }
+
+}
