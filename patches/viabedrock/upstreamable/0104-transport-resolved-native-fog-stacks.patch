+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.api.resourcepack.definition.FogDefinitions;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+
+public final class FogStorage extends StoredObject {
+
+    private List<String> identifiers = List.of();
+    private boolean joined;
+
+    public FogStorage(final UserConnection user) {
+        super(user);
+    }
+
+    public void update(final String[] identifiers) {
+        if (identifiers.length > FogState.MAX_LAYERS) {
+            throw new IllegalArgumentException("Too many native fog layers");
+        }
+        this.identifiers = List.copyOf(Arrays.asList(identifiers));
+    }
+
+    public FogState snapshot(final FogDefinitions definitions) {
+        return new FogState(this.identifiers.stream().map(identifier -> {
+            final FogDefinitions.FogDefinition definition = definitions.get(identifier);
+            return new FogState.Layer(identifier, definition == null ? Map.of() : definition.distances());
+        }).toList());
+    }
+
+    public void markJoined() {
+        this.joined = true;
+    }
+
+    public void sendSnapshot() {
+        if (!this.joined || this.user().getProtocolInfo().getServerState() != State.PLAY || !this.user().get(ChannelStorage.class).hasChannel(FogState.CHANNEL)) {
+            return;
+        }
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user());
+        packet.write(Types.STRING, FogState.CHANNEL);
+        packet.write(FogState.TYPE, this.snapshot(this.user().get(ResourcePackStorage.class).getFogs()));
+        packet.send(BedrockProtocol.class);
+    }
+
+}
