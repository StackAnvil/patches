+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.util.Key;
+import io.netty.buffer.ByteBuf;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Atomic command and biome settings resolved against this connection's selected resource packs. */
+public record FogState(List<Layer> layers, Map<String, Layer> biomes, Map<String, Distance> defaults) {
+
+    public static final String CHANNEL = "viabedrock:fog";
+    public static final int MAX_LAYERS = 16;
+    public static final int MAX_BIOMES = 1024;
+    private static final int MAX_SETTINGS = 16;
+    public static final FogState EMPTY = new FogState(List.of(), Map.of(), Map.of());
+    public static final Type<FogState> TYPE = new Type<>(FogState.class) {
+        @Override
+        public FogState read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 2) {
+                throw new IllegalArgumentException("Unsupported fog payload version");
+            }
+            final int count = boundedCount(buffer, MAX_LAYERS);
+            final List<Layer> layers = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                layers.add(readLayer(buffer));
+            }
+            final int biomeCount = boundedCount(buffer, MAX_BIOMES);
+            final Map<String, Layer> biomes = new LinkedHashMap<>();
+            for (int i = 0; i < biomeCount; i++) {
+                final String biome = Types.STRING.read(buffer);
+                if (biomes.put(biome, readLayer(buffer)) != null) {
+                    throw new IllegalArgumentException("Duplicate fog biome");
+                }
+            }
+            final Map<String, Distance> defaults = readDistances(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected fog payload fields");
+            }
+            return new FogState(layers, biomes, defaults);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final FogState state) {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, state.layers.size());
+            for (final Layer layer : state.layers) {
+                writeLayer(buffer, layer);
+            }
+            Types.VAR_INT.writePrimitive(buffer, state.biomes.size());
+            for (final Map.Entry<String, Layer> entry : state.biomes.entrySet()) {
+                Types.STRING.write(buffer, entry.getKey());
+                writeLayer(buffer, entry.getValue());
+            }
+            writeDistances(buffer, state.defaults);
+        }
+
+        private static Layer readLayer(final ByteBuf buffer) {
+            return new Layer(Types.STRING.read(buffer), readDistances(buffer));
+        }
+
+        private static void writeLayer(final ByteBuf buffer, final Layer layer) {
+            Types.STRING.write(buffer, layer.identifier);
+            writeDistances(buffer, layer.distances);
+        }
+
+        private static Map<String, Distance> readDistances(final ByteBuf buffer) {
+            final int count = boundedCount(buffer, MAX_SETTINGS);
+            final Map<String, Distance> distances = new LinkedHashMap<>();
+            for (int i = 0; i < count; i++) {
+                final String medium = Types.STRING.read(buffer);
+                final Distance distance = new Distance(buffer.readFloat(), buffer.readFloat(), buffer.readInt(), buffer.readBoolean());
+                if (distances.put(medium, distance) != null) {
+                    throw new IllegalArgumentException("Duplicate fog medium");
+                }
+            }
+            return distances;
+        }
+
+        private static void writeDistances(final ByteBuf buffer, final Map<String, Distance> distances) {
+            Types.VAR_INT.writePrimitive(buffer, distances.size());
+            for (final Map.Entry<String, Distance> entry : distances.entrySet()) {
+                Types.STRING.write(buffer, entry.getKey());
+                final Distance distance = entry.getValue();
+                buffer.writeFloat(distance.start).writeFloat(distance.end).writeInt(distance.color).writeBoolean(distance.renderRelative);
+            }
+        }
+
+        private static int boundedCount(final ByteBuf buffer, final int maximum) {
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > maximum) {
+                throw new IllegalArgumentException("Invalid fog payload count");
+            }
+            return count;
+        }
+    };
+
+    public FogState {
+        layers = List.copyOf(layers);
+        if (layers.size() > MAX_LAYERS || biomes.size() > MAX_BIOMES) {
+            throw new IllegalArgumentException("Too many fog layers or biomes");
+        }
+        final Map<String, Layer> canonical = new LinkedHashMap<>();
+        for (final Map.Entry<String, Layer> entry : biomes.entrySet()) {
+            if (entry.getKey().isEmpty() || entry.getKey().length() > 256) {
+                throw new IllegalArgumentException("Invalid fog biome");
+            }
+            if (canonical.put(Key.namespaced(entry.getKey()), entry.getValue()) != null) {
+                throw new IllegalArgumentException("Duplicate fog biome");
+            }
+        }
+        biomes = Map.copyOf(canonical);
+        defaults = immutableDistances(defaults);
+    }
+
+    /** Native stack precedence applies independently to each medium, not to individual fields. */
+    public Distance resolve(final String medium, final String biome) {
+        for (int i = this.layers.size() - 1; i >= 0; i--) {
+            final Distance distance = this.layers.get(i).distances.get(medium);
+            if (distance != null) {
+                return distance;
+            }
+        }
+        final Layer layer = biome == null ? null : this.biomes.get(Key.namespaced(biome));
+        final Distance distance = layer == null ? null : layer.distances.get(medium);
+        return distance == null ? this.defaults.get(medium) : distance;
+    }
+
+    private static Map<String, Distance> immutableDistances(final Map<String, Distance> distances) {
+        if (distances.size() > MAX_SETTINGS) {
+            throw new IllegalArgumentException("Too many fog settings");
+        }
+        for (final String medium : distances.keySet()) {
+            if (medium.isEmpty() || medium.length() > 64) {
+                throw new IllegalArgumentException("Invalid fog medium");
+            }
+        }
+        return Map.copyOf(distances);
+    }
+
+    public record Layer(String identifier, Map<String, Distance> distances) {
+        public Layer {
+            if (identifier == null || identifier.isEmpty() || identifier.length() > 256) {
+                throw new IllegalArgumentException("Invalid fog layer");
+            }
+            distances = immutableDistances(distances);
+        }
+    }
+
+    public record Distance(float start, float end, int color, boolean renderRelative) {
+        public Distance {
+            if (!Float.isFinite(start) || !Float.isFinite(end) || end < 0 || start > end || (color & 0xFF000000) != 0
+                    || (renderRelative ? start < -1 || end > 1 : start < 0)) {
+                throw new IllegalArgumentException("Invalid fog distance");
+            }
+        }
+
+        public float start(final float renderDistance) {
+            return this.renderRelative ? this.start * renderDistance : this.start;
+        }
+
+        public float end(final float renderDistance) {
+            return this.renderRelative ? this.end * renderDistance : this.end;
+        }
+    }
+
+}
