+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.api.resourcepack.definition.FogDefinitions;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FogStorageTest {
+
+    @Test
+    void reResolvesResourceOwnershipAndReplacesRatherThanAppendsStacks() {
+        final var storage = new FogStorage(mock(UserConnection.class));
+        final var definitions = mock(FogDefinitions.class);
+        final var current = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        final var older = new FogState.Distance(0, 32, 0, false);
+        final String identifier = "test:world";
+        storage.update(new String[]{identifier});
+        when(definitions.get(identifier)).thenReturn(new FogDefinitions.FogDefinition(identifier, Map.of(), Map.of("air", current)));
+        final var first = storage.snapshot(definitions);
+        when(definitions.get(identifier)).thenReturn(new FogDefinitions.FogDefinition(identifier, Map.of(), Map.of("air", older)));
+        assertSame(older, storage.snapshot(definitions).resolve("air"));
+        assertSame(current, first.resolve("air"));
+        storage.update(new String[]{"test:missing"});
+        assertNull(storage.snapshot(definitions).resolve("air"));
+        storage.update(new String[0]);
+        assertEquals(FogState.EMPTY, storage.snapshot(definitions));
+    }
+
+    @Test
+    void publishesOnlyAfterJoinPlayAndChannelRegistrationIncludingEmptyReset() {
+        final var user = mock(UserConnection.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.PLAY);
+        final var channels = new ChannelStorage();
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        final var resources = mock(ResourcePackStorage.class);
+        when(user.get(ResourcePackStorage.class)).thenReturn(resources);
+        when(resources.getFogs()).thenReturn(mock(FogDefinitions.class));
+        final var storage = new FogStorage(user);
+        final var output = mock(PacketWrapper.class);
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(output);
+            storage.sendSnapshot();
+            storage.markJoined();
+            storage.sendSnapshot();
+            channels.addChannels(List.of(FogState.CHANNEL));
+            when(info.getServerState()).thenReturn(State.CONFIGURATION);
+            storage.sendSnapshot();
+            verifyNoInteractions(output);
+            when(info.getServerState()).thenReturn(State.PLAY);
+            storage.sendSnapshot();
+            verify(output).write(FogState.TYPE, FogState.EMPTY);
+        }
+    }
+
+}
