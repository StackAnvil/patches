+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FogDefinitionsTest {
+
+    @Test
+    void preservesFixedAndRenderUnitsAlongsideExistingColors() {
+        final JsonObject fog = fog();
+        final JsonObject settings = new JsonObject();
+        settings.add("air", distance(-0.25F, 1, 0x112233, "render"));
+        settings.add("water", distance(0, 15, 0, "fixed"));
+        fog.add("distance", settings);
+        final var parsed = FogDefinitions.parse(fog);
+        assertEquals(0x112233, parsed.colors().get("air"));
+        assertEquals(0, parsed.colors().get("water"));
+        assertEquals(-48, parsed.distances().get("air").start(192));
+        assertEquals(192, parsed.distances().get("air").end(192));
+        assertEquals(15, parsed.distances().get("water").end(192));
+        assertThrows(UnsupportedOperationException.class, () -> parsed.distances().clear());
+    }
+
+    @Test
+    void retainsColorOnlyDefinitionsWithoutInventingDistanceFields() {
+        final JsonObject fog = fog();
+        final JsonObject medium = new JsonObject();
+        medium.addProperty("fog_color", "#000000");
+        final JsonObject settings = new JsonObject();
+        settings.add("air", medium);
+        fog.add("distance", settings);
+        assertEquals(0, FogDefinitions.parse(fog).colors().get("air"));
+        assertTrue(FogDefinitions.parse(fog).distances().isEmpty());
+        fog.remove("distance");
+        assertTrue(FogDefinitions.parse(fog).colors().isEmpty());
+    }
+
+    @Test
+    void rejectsInvalidCompleteSettingsInsteadOfChangingTheirUnits() {
+        final JsonObject fog = fog();
+        final JsonObject settings = new JsonObject();
+        fog.add("distance", settings);
+        settings.add("air", distance(0, 16, 0, "render"));
+        assertThrows(IllegalArgumentException.class, () -> FogDefinitions.parse(fog));
+        settings.add("air", distance(0, 16, 0, "unknown"));
+        assertThrows(IllegalArgumentException.class, () -> FogDefinitions.parse(fog));
+    }
+
+    private static JsonObject fog() {
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", "test:fog");
+        final JsonObject fog = new JsonObject();
+        fog.add("description", description);
+        return fog;
+    }
+
+    private static JsonObject distance(final float start, final float end, final int color, final String type) {
+        final JsonObject settings = new JsonObject();
+        settings.addProperty("fog_start", start);
+        settings.addProperty("fog_end", end);
+        settings.addProperty("fog_color", "#%06X".formatted(color));
+        settings.addProperty("render_distance_type", type);
+        return settings;
+    }
+
+}
