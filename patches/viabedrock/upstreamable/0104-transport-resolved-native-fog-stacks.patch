-    public record FogDefinition(String identifier, Map<String, Integer> colors) {
+    static FogDefinition parse(final JsonObject fog) {
+        final String identifier = Key.namespaced(fog.getAsJsonObject("description").get("identifier").getAsString());
+        final Map<String, Integer> colors = new HashMap<>();
+        final Map<String, FogState.Distance> distances = new HashMap<>();
+        final JsonObject distance = fog.getAsJsonObject("distance");
+        if (distance != null) {
+            for (final Map.Entry<String, JsonElement> entry : distance.entrySet()) {
+                final JsonObject value = entry.getValue().getAsJsonObject();
+                if (value.has("fog_color")) {
+                    final int color = Integer.parseInt(value.get("fog_color").getAsString().substring(1), 16);
+                    colors.put(entry.getKey(), color);
+                    if (value.has("fog_start") && value.has("fog_end") && value.has("render_distance_type")) {
+                        final String type = value.get("render_distance_type").getAsString();
+                        if (!type.equals("fixed") && !type.equals("render")) {
+                            throw new IllegalArgumentException("Unknown fog distance type: " + type);
+                        }
+                        distances.put(entry.getKey(), new FogState.Distance(value.get("fog_start").getAsFloat(),
+                                value.get("fog_end").getAsFloat(), color, type.equals("render")));
+                    }
+                }
+            }
+        }
+        return new FogDefinition(identifier, colors, distances);
+    }
+
+    public record FogDefinition(String identifier, Map<String, Integer> colors, Map<String, FogState.Distance> distances) {
+        public FogDefinition {
+            colors = Map.copyOf(colors);
+            distances = Map.copyOf(distances);
+        }
     }
 
