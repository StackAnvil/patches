+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FogStateTest {
+
+    @Test
+    void resolvesTheLastDefinedMediumWithoutDiscardingLowerAir() {
+        final var air = new FogState.Distance(0, 16, 0xFFFFFF, false);
+        final var water = new FogState.Distance(0, 4, 0x00FF00, false);
+        final var red = new FogState.Distance(0, 32, 0xFF0000, false);
+        final var layers = new ArrayList<FogState.Layer>();
+        layers.add(new FogState.Layer("test:air", Map.of("air", air)));
+        layers.add(new FogState.Layer("test:water", Map.of("water", water)));
+        final var state = new FogState(layers);
+        layers.add(new FogState.Layer("test:red", Map.of("air", red)));
+        assertSame(air, state.resolve("air"));
+        assertSame(water, state.resolve("water"));
+        assertSame(red, new FogState(layers).resolve("air"));
+        assertNull(state.resolve("lava"));
+        assertNull(FogState.EMPTY.resolve("air"));
+    }
+
+    @Test
+    void retainsAtomicImmutableLayersAndIndependentDistanceUnits() {
+        final var settings = new HashMap<String, FogState.Distance>();
+        final var relative = new FogState.Distance(-0.25F, 0.75F, 0, true);
+        settings.put("air", relative);
+        final var layer = new FogState.Layer("test:relative", settings);
+        settings.clear();
+        assertEquals(-48, layer.distances().get("air").start(192));
+        assertEquals(144, layer.distances().get("air").end(192));
+        assertEquals(72, relative.end(96));
+        assertEquals(16, new FogState.Distance(0, 16, 0, false).end(192));
+        assertThrows(UnsupportedOperationException.class, () -> layer.distances().clear());
+    }
+
+    @Test
+    void roundTripsAllFieldsAndRejectsTrailingAndInvalidCounts() {
+        final var state = new FogState(List.of(new FogState.Layer("test:both", Map.of(
+                "air", new FogState.Distance(-0.125F, 0.9375F, 0xABCDEF, true),
+                "water", new FogState.Distance(2, 14.5F, 0x123456, false)))));
+        final var buffer = Unpooled.buffer();
+        try {
+            FogState.TYPE.write(buffer, state);
+            assertEquals(state, FogState.TYPE.read(buffer.duplicate()));
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer.duplicate()));
+            for (final int count : new int[]{-1, 17}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> FogState.TYPE.read(buffer.duplicate()));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsNonFiniteReversedAndOutOfRangeSettings() {
+        for (final float value : new float[]{Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(value, 16, 0, false));
+            assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, value, 0, false));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(17, 16, 0, false));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(-1, 16, 0, false));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(-2, 1, 0, true));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, 2, 0, true));
+        assertThrows(IllegalArgumentException.class, () -> new FogState.Distance(0, 1, 0xFF000000, true));
+    }
+
+}
