+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EmoteActionTest {
+
+    @Test
+    void roundTripsAllControlsAndOwnsTheAvailableList() {
+        final UUID emote = UUID.randomUUID();
+        final var ids = new ArrayList<>(List.of(emote));
+        final var available = new EmoteAction.Available(ids);
+        ids.clear();
+        assertEquals(List.of(emote), available.emotes());
+        assertThrows(UnsupportedOperationException.class, () -> available.emotes().clear());
+        for (final var action : List.of(new EmoteAction.Play(emote, 12000), available, new EmoteAction.Stop())) {
+            final var buffer = Unpooled.buffer();
+            try {
+                EmoteAction.TYPE.write(buffer, action);
+                assertEquals(action, EmoteAction.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsMalformedControlsBeforeAllocationOrPlayback() {
+        final UUID emote = UUID.randomUUID();
+        assertThrows(IllegalArgumentException.class, () -> new EmoteAction.Play(emote, -1));
+        assertThrows(IllegalArgumentException.class, () -> new EmoteAction.Play(emote, 12001));
+        assertThrows(IllegalArgumentException.class, () -> new EmoteAction.Available(Collections.nCopies(257, emote)));
+        for (final int count : new int[]{-1, 257, Integer.MAX_VALUE}) {
+            final var buffer = Unpooled.buffer();
+            try {
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> EmoteAction.TYPE.read(buffer));
+            } finally {
+                buffer.release();
+            }
+        }
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeByte(2).writeByte(2);
+            assertThrows(IllegalArgumentException.class, () -> EmoteAction.TYPE.read(buffer));
+            buffer.clear().writeByte(1).writeByte(3);
+            assertThrows(IllegalArgumentException.class, () -> EmoteAction.TYPE.read(buffer));
+            buffer.clear();
+            EmoteAction.TYPE.write(buffer, new EmoteAction.Stop());
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> EmoteAction.TYPE.read(buffer));
+            buffer.clear().writeByte(1).writeByte(0);
+            assertThrows(IndexOutOfBoundsException.class, () -> EmoteAction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void policyKeepsWorldMutingAndRejectsTrailingFields() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (final boolean muted : new boolean[]{false, true}) {
+                buffer.clear();
+                final var policy = new EmoteAction.Policy(muted, UUID.randomUUID(), "Native player");
+                EmoteAction.Policy.TYPE.write(buffer, policy);
+                assertEquals(policy, EmoteAction.Policy.TYPE.read(buffer));
+            }
+            buffer.clear();
+            EmoteAction.Policy.TYPE.write(buffer, new EmoteAction.Policy(true, UUID.randomUUID(), "Native player"));
+            buffer.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> EmoteAction.Policy.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
