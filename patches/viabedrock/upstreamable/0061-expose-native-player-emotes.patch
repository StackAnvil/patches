+import static org.junit.jupiter.api.Assertions.*;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import org.junit.jupiter.api.Test;
+
+import static org.mockito.Mockito.*;
+
+class EmoteProviderTest {
+
+    @Test
+    void forwardsWorldMuteWithoutLosingPacketFlagsAndRequiresNegotiation() {
+        final var user = mock(UserConnection.class);
+        final var channels = mock(ChannelStorage.class);
+        final var session = mock(GameSessionStorage.class);
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        final UUID player = UUID.randomUUID();
+        final UUID emote = UUID.randomUUID();
+        final var provider = new EmoteProvider();
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            provider.play(user, player, emote, 20, 0);
+            packets.verifyNoInteractions();
+            when(channels.hasChannel(EmoteProvider.CHANNEL)).thenReturn(true);
+            for (final boolean muted : new boolean[]{false, true}) {
+                when(session.isEmoteChatMuted()).thenReturn(muted);
+                for (final int flags : new int[]{0, 1, 128, 255}) {
+                    final var packet = mock(PacketWrapper.class);
+                    packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user)).thenReturn(packet);
+                    provider.play(user, player, emote, 20, flags);
+                    verify(packet).write(Types.UUID, player);
+                    verify(packet).write(Types.UUID, emote);
+                    verify(packet).write(Types.VAR_LONG, 20L);
+                    verify(packet).write(Types.UNSIGNED_BYTE, (short) (muted ? flags | 2 : flags));
+                    verify(packet).send(BedrockProtocol.class);
+                }
+            }
+        }
+    }
+
+    @Test
+    void negotiatedControlsUseOnlyTheConnectedActorAndAccount() {
+        final var user = mock(UserConnection.class);
+        final var channels = new ChannelStorage();
+        when(user.get(GameSessionStorage.class)).thenReturn(mock(GameSessionStorage.class));
+        final var state = new EmoteStorage();
+        final var entities = mock(EntityTracker.class);
+        final var player = mock(ClientPlayerEntity.class);
+        final var auth = mock(AuthData.class);
+        when(user.get(ChannelStorage.class)).thenReturn(channels);
+        when(user.get(EmoteStorage.class)).thenReturn(state);
+        when(user.has(EmoteStorage.class)).thenReturn(true);
+        when(user.get(EntityTracker.class)).thenReturn(entities);
+        when(user.get(AuthData.class)).thenReturn(auth);
+        final var info = mock(com.viaversion.viaversion.api.connection.ProtocolInfo.class);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getClientState()).thenReturn(State.PLAY);
+        final UUID self = UUID.randomUUID();
+        when(info.getUuid()).thenReturn(self);
+        when(entities.getClientPlayer()).thenReturn(player);
+        when(player.runtimeId()).thenReturn(123L);
+        when(player.javaUuid()).thenReturn(self);
+        when(player.isInitiallySpawned()).thenReturn(true);
+        when(auth.getXuid()).thenReturn("connected-account");
+        final UUID emote = UUID.randomUUID();
+        final var provider = new EmoteProvider();
+        try (var packets = mockStatic(PacketWrapper.class)) {
+            EmoteProvider.handleAction(user, new EmoteAction.Available(List.of(emote)));
+            packets.verifyNoInteractions();
+            assertFalse(state.contains(emote));
+            channels.addChannels(List.of(EmoteProvider.CHANNEL, EmoteAction.Policy.CHANNEL));
+            EmoteProvider.handleAction(user, new EmoteAction.Play(emote, 120));
+            packets.verifyNoInteractions();
+            final var list = mock(PacketWrapper.class);
+            packets.when(() -> PacketWrapper.create(ServerboundBedrockPackets.EMOTE_LIST, user)).thenReturn(list);
+            EmoteProvider.handleAction(user, new EmoteAction.Available(List.of(emote)));
+            verify(list).write(BedrockTypes.UNSIGNED_VAR_LONG, 123L);
+            verify(list).write(BedrockTypes.UUID_ARRAY, new UUID[]{emote});
+            verify(list).sendToServer(BedrockProtocol.class);
+            final var play = mock(PacketWrapper.class);
