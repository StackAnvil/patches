+package net.raphimc.viabedrock.protocol.types.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.EmoteData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public final class EmoteType extends Type<EmoteData> {
+
+    public EmoteType() {
+        super("Emote", EmoteData.class);
+    }
+
+    @Override
+    public EmoteData read(final ByteBuf buffer) {
+        final long actor = BedrockTypes.UNSIGNED_VAR_LONG.readPrimitive(buffer);
+        final UUID emote = UUID.fromString(BedrockTypes.STRING.read(buffer));
+        final long ticks = Integer.toUnsignedLong(BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer));
+        final String xuid = BedrockTypes.STRING.read(buffer);
+        final String platform = BedrockTypes.STRING.read(buffer);
+        return new EmoteData(actor, emote, ticks, xuid, platform, buffer.readUnsignedByte());
+    }
+
+    @Override
+    public void write(final ByteBuf buffer, final EmoteData emote) {
+        BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(buffer, emote.runtimeId());
+        BedrockTypes.STRING.write(buffer, emote.emoteId().toString());
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, (int) emote.lengthTicks());
+        BedrockTypes.STRING.write(buffer, emote.xuid());
+        BedrockTypes.STRING.write(buffer, emote.platformId());
+        buffer.writeByte(emote.flags());
+    }
+
+}
