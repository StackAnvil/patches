+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+
+/** Client-owned emote controls. Actor and account identities always come from the connected session. */
+public sealed interface EmoteAction permits EmoteAction.Play, EmoteAction.Available, EmoteAction.Stop {
+
+    String CHANNEL = "viabedrock:emote_action_v1";
+    int MAX_EMOTES = 256;
+    long MAX_TICKS = 12000;
+    Type<EmoteAction> TYPE = new Type<>(EmoteAction.class) {
+        @Override
+        public EmoteAction read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1) {
+                throw new IllegalArgumentException("Unsupported emote action version");
+            }
+            final EmoteAction action = switch (Types.VAR_INT.readPrimitive(buffer)) {
+                case 0 -> new Play(Types.UUID.read(buffer), Types.VAR_LONG.readPrimitive(buffer));
+                case 1 -> {
+                    final int count = Types.VAR_INT.readPrimitive(buffer);
+                    if (count < 0 || count > MAX_EMOTES) {
+                        throw new IllegalArgumentException("Invalid emote list size");
+                    }
+                    final var emotes = new ArrayList<UUID>(count);
+                    for (int index = 0; index < count; index++) {
+                        emotes.add(Types.UUID.read(buffer));
+                    }
+                    yield new Available(emotes);
+                }
+                case 2 -> new Stop();
+                default -> throw new IllegalArgumentException("Unknown emote action");
+            };
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Unexpected emote action fields");
+            }
+            return action;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final EmoteAction action) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, action.kind());
+            switch (action) {
+                case Play play -> {
+                    Types.UUID.write(buffer, play.emote());
+                    Types.VAR_LONG.writePrimitive(buffer, play.ticks());
+                }
+                case Available available -> {
+                    Types.VAR_INT.writePrimitive(buffer, available.emotes().size());
+                    for (final UUID emote : available.emotes()) {
+                        Types.UUID.write(buffer, emote);
+                    }
+                }
+                case Stop _ -> { }
+            }
+        }
+    };
+
+    int kind();
+
+    record Play(UUID emote, long ticks) implements EmoteAction {
+        @Override
+        public int kind() {
+            return 0;
+        }
+
+        public Play {
+            Objects.requireNonNull(emote);
+            if (Long.compareUnsigned(ticks, MAX_TICKS) > 0) {
+                throw new IllegalArgumentException("Invalid emote duration");
+            }
+        }
+    }
+
+    record Available(List<UUID> emotes) implements EmoteAction {
+        @Override
+        public int kind() {
+            return 1;
+        }
+
+        public Available {
+            emotes = List.copyOf(emotes);
+            if (emotes.size() > MAX_EMOTES) {
+                throw new IllegalArgumentException("Invalid emote list size");
+            }
+        }
+    }
+
+    record Stop() implements EmoteAction {
+        @Override
+        public int kind() {
+            return 2;
+        }
+    }
+
+    /** World policy needed before the client makes its optimistic local announcement. */
+    record Policy(boolean muteChat, UUID player, String name) {
+        public static final String CHANNEL = "viabedrock:emote_policy_v1";
+        public static final Type<Policy> TYPE = new Type<>(Policy.class) {
+            @Override
+            public Policy read(final ByteBuf buffer) {
+                if (Types.VAR_INT.readPrimitive(buffer) != 1) {
+                    throw new IllegalArgumentException("Unsupported emote policy version");
+                }
+                final var policy = new Policy(buffer.readBoolean(), Types.UUID.read(buffer), Types.STRING.read(buffer));
+                if (buffer.isReadable()) {
+                    throw new IllegalArgumentException("Unexpected emote policy fields");
+                }
+                return policy;
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final Policy policy) {
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                buffer.writeBoolean(policy.muteChat());
+                Types.UUID.write(buffer, policy.player());
+                Types.STRING.write(buffer, policy.name());
+            }
+        };
+
+        public Policy {
+            Objects.requireNonNull(player);
+            Objects.requireNonNull(name);
+        }
+    }
+
+}
