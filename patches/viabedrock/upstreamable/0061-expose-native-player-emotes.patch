+import com.viaversion.viaversion.api.platform.providers.Provider;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.storage.ChannelStorage;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import java.util.UUID;
+import java.nio.charset.StandardCharsets;
+import com.viaversion.viaversion.api.protocol.packet.State;
+import net.raphimc.viabedrock.api.model.EmoteAction;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.model.EmoteData;
+import net.raphimc.viabedrock.protocol.storage.AuthData;
+import net.raphimc.viabedrock.protocol.storage.EmoteStorage;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerListStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Client integrations may consume native emotes directly or through the versioned payload. */
+public class EmoteProvider implements Provider {
+
+    public static final String CHANNEL = "viabedrock:emote";
+    public static final int VERSION = 1;
+
+    private PacketWrapper payload(final UserConnection user, final UUID player, final int kind) {
+        if (!user.get(ChannelStorage.class).hasChannel(CHANNEL)) {
+            return null;
+        }
+        sendPolicy(user, player);
+        final PacketWrapper packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        packet.write(Types.STRING, CHANNEL);
+        packet.write(Types.VAR_INT, VERSION);
+        packet.write(Types.VAR_INT, kind);
+        packet.write(Types.UUID, player);
+        return packet;
+    }
+
+    public boolean isEmoting(final UserConnection user) {
+        final var state = user.get(EmoteStorage.class);
+        return state != null && state.isEmoting();
+    }
+
+    public static void refreshActionCapability(final UserConnection user) {
+        if (user.getProtocolInfo().getClientState() != State.PLAY) {
+            return;
+        }
+        final boolean enabled = user.get(ChannelStorage.class).hasChannel(CHANNEL)
+                && user.get(ChannelStorage.class).hasChannel(EmoteAction.Policy.CHANNEL);
+        if (enabled) {
+            if (!user.has(EmoteStorage.class)) {
+                user.put(new EmoteStorage());
+            }
+            sendPolicy(user, user.getProtocolInfo().getUuid());
+        } else {
+            user.remove(EmoteStorage.class);
+        }
+        final var packet = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        packet.write(Types.STRING, enabled ? "minecraft:register" : "minecraft:unregister");
+        packet.write(Types.REMAINING_BYTES, EmoteAction.CHANNEL.getBytes(StandardCharsets.UTF_8));
+        packet.send(BedrockProtocol.class);
+    }
+
+    private static void sendPolicy(final UserConnection user, final UUID player) {
+        if (!user.get(ChannelStorage.class).hasChannel(EmoteAction.Policy.CHANNEL)) {
+            return;
+        }
+        final var players = user.get(PlayerListStorage.class);
+        final var entities = user.get(EntityTracker.class);
+        final var local = entities == null ? null : entities.getClientPlayer();
+        final String name;
+        if (local != null && player.equals(local.javaUuid())) {
+            final var listed = players == null ? null : players.getPlayer(local.uniqueId());
+            final var auth = user.get(AuthData.class);
+            name = listed != null ? listed.value() : auth != null ? auth.getDisplayName() : "";
+        } else {
+            final var listed = players == null ? null : players.getPlayer(player);
+            name = listed == null ? "" : listed.value();
+        }
+        final var policy = PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, user);
+        policy.write(Types.STRING, EmoteAction.Policy.CHANNEL);
+        policy.write(EmoteAction.Policy.TYPE, new EmoteAction.Policy(user.get(GameSessionStorage.class).isEmoteChatMuted(), player, name));
+        policy.send(BedrockProtocol.class);
+    }
+
+    public static boolean actionsEnabled(final UserConnection user) {
+        return user.getProtocolInfo().getClientState() == State.PLAY
+                && user.get(ChannelStorage.class).hasChannel(CHANNEL)
+                && user.get(ChannelStorage.class).hasChannel(EmoteAction.Policy.CHANNEL) && user.has(EmoteStorage.class);
+    }
+
+    public static void handleAction(final UserConnection user, final EmoteAction action) {
+        if (!actionsEnabled(user)) {
+            return;
+        }
+        final var state = user.get(EmoteStorage.class);
+        switch (action) {
+            case EmoteAction.Stop _ -> state.stop();
+            case EmoteAction.Available available -> {
+                state.available(available.emotes());
+                final var entities = user.get(EntityTracker.class);
+                if (entities == null || entities.getClientPlayer() == null) {
+                    return;
+                }
+                final var packet = PacketWrapper.create(ServerboundBedrockPackets.EMOTE_LIST, user);
+                packet.write(BedrockTypes.UNSIGNED_VAR_LONG, entities.getClientPlayer().runtimeId());
+                packet.write(BedrockTypes.UUID_ARRAY, available.emotes().toArray(UUID[]::new));
+                packet.sendToServer(BedrockProtocol.class);
+            }
+            case EmoteAction.Play play -> {
+                final var entities = user.get(EntityTracker.class);
+                final var auth = user.get(AuthData.class);
+                if (!state.contains(play.emote()) || entities == null || entities.getClientPlayer() == null
+                        || !entities.getClientPlayer().isInitiallySpawned() || auth == null) {
+                    return;
+                }
+                final var packet = PacketWrapper.create(ServerboundBedrockPackets.EMOTE, user);
+                packet.write(BedrockTypes.EMOTE, new EmoteData(entities.getClientPlayer().runtimeId(),
+                        play.emote(), play.ticks(), auth.getXuid(), "", 0));
+                packet.sendToServer(BedrockProtocol.class);
+                state.play(play.ticks());
+            }
+        }
+    }
+
+    public void play(final UserConnection user, final UUID player, final UUID emote, final long lengthTicks, final int flags) {
+        final PacketWrapper packet = this.payload(user, player, 0);
+        if (packet == null) {
+            return;
+        }
+        packet.write(Types.UUID, emote);
+        packet.write(Types.VAR_LONG, lengthTicks);
+        final var session = user.get(GameSessionStorage.class);
+        final int forwardedFlags = session != null && session.isEmoteChatMuted() ? flags | 2 : flags;
+        packet.write(Types.UNSIGNED_BYTE, (short) forwardedFlags);
+        packet.send(BedrockProtocol.class);
+    }
+
+    public void setAvailable(final UserConnection user, final UUID player, final UUID[] emotes) {
+        final PacketWrapper packet = this.payload(user, player, 1);
+        if (packet == null) {
+            return;
+        }
+        packet.write(Types.UUID_ARRAY, emotes);
+        packet.send(BedrockProtocol.class);
+    }
+
+}
