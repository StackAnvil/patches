+package net.raphimc.viabedrock.protocol.model;
+
+import java.util.UUID;
+
+/** Bedrock 1.26.51 EmotePacketPayload (protocol 2193). */
+public record EmoteData(long runtimeId, UUID emoteId, long lengthTicks, String xuid, String platformId, int flags) {
+
+    public EmoteData {
+        if (emoteId == null || xuid == null || platformId == null || lengthTicks < 0 || lengthTicks > 0xFFFFFFFFL || flags < 0 || flags > 255) {
+            throw new IllegalArgumentException("Invalid emote packet fields");
+        }
+    }
+
+}
