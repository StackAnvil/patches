+package net.raphimc.viabedrock.protocol.storage;
+
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicLong;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EmoteStorageTest {
+
+    @Test
+    void playbackExpiresStopsAndKeepsWheelOwnershipSeparate() {
+        final var clock = new AtomicLong(Long.MAX_VALUE - 100_000_000L);
+        final var state = new EmoteStorage(clock::get);
+        final UUID emote = UUID.randomUUID();
+        assertFalse(state.isEmoting());
+        assertFalse(state.contains(emote));
+        state.available(List.of(emote));
+        assertTrue(state.contains(emote));
+        state.play(4);
+        assertTrue(state.isEmoting());
+        clock.addAndGet(199_999_999L);
+        assertTrue(state.isEmoting());
+        clock.incrementAndGet();
+        assertFalse(state.isEmoting());
+        state.play(20);
+        state.available(List.of());
+        assertFalse(state.contains(emote));
+        assertTrue(state.isEmoting());
+        state.stop();
+        assertFalse(state.isEmoting());
+        state.play(0);
+        clock.addAndGet(1_000_000_000_000L);
+        assertTrue(state.isEmoting());
+        state.stop();
+        assertFalse(state.isEmoting());
+    }
+
+}
