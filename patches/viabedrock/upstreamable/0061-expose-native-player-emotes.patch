+package net.raphimc.viabedrock.protocol.types.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import io.netty.buffer.Unpooled;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.EmoteData;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+final class EmoteTypeTest {
+
+    @Test
+    void readsThe2193FieldOrderAndPreservesUnsignedDuration() {
+        final var buffer = Unpooled.buffer();
+        final UUID id = UUID.randomUUID();
+        try {
+            BedrockTypes.UNSIGNED_VAR_LONG.writePrimitive(buffer, 300);
+            BedrockTypes.STRING.write(buffer, id.toString());
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, -1);
+            BedrockTypes.STRING.write(buffer, "12345");
+            BedrockTypes.STRING.write(buffer, "platform");
+            buffer.writeByte(3);
+            assertEquals(new EmoteData(300, id, 0xFFFFFFFFL, "12345", "platform", 3), BedrockTypes.EMOTE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void writesAnActorIdAndStringIdentityBeforeTheDuration() {
+        final var buffer = Unpooled.buffer();
+        final UUID id = UUID.randomUUID();
+        try {
+            BedrockTypes.EMOTE.write(buffer, new EmoteData(129, id, 130, "", "", 0));
+            assertEquals(129, BedrockTypes.UNSIGNED_VAR_LONG.readPrimitive(buffer));
+            assertEquals(id, UUID.fromString(BedrockTypes.STRING.read(buffer)));
+            assertEquals(130, BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer));
+            assertTrue(BedrockTypes.STRING.read(buffer).isEmpty());
+            assertTrue(BedrockTypes.STRING.read(buffer).isEmpty());
+            assertEquals(0, buffer.readUnsignedByte());
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
