+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.LongSupplier;
+
+/** The connected client's advertised wheel and local playback state. */
+public final class EmoteStorage implements StorableObject {
+
+    private final LongSupplier clock;
+    private Set<UUID> available = Set.of();
+    private boolean active;
+    private long started;
+    private long duration;
+
+    public EmoteStorage() {
+        this(System::nanoTime);
+    }
+
+    EmoteStorage(final LongSupplier clock) {
+        this.clock = clock;
+    }
+
+    public void available(final List<UUID> emotes) {
+        this.available = Set.copyOf(emotes);
+    }
+
+    public boolean contains(final UUID emote) {
+        return this.available.contains(emote);
+    }
+
+    public void play(final long ticks) {
+        this.active = true;
+        this.started = this.clock.getAsLong();
+        this.duration = ticks * 50_000_000L;
+    }
+
+    public void stop() {
+        this.active = false;
+    }
+
+    public boolean isEmoting() {
+        return this.active && (this.duration == 0 || this.clock.getAsLong() - this.started < this.duration);
+    }
+
+}
