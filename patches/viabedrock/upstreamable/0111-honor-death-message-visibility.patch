 public final class PacketFactory {
 
+    public static void sendJavaDeathMessage(final UserConnection user) {
+        final var player = user.get(EntityTracker.class).getClientPlayer();
+        final var message = user.get(GameSessionStorage.class).getDeathMessage();
+        if (!player.isDead() || message == null) {
+            return;
+        }
+        final boolean showReason = Boolean.TRUE.equals(user.get(GameRulesStorage.class).getGameRule("showDeathMessages"));
+        final PacketWrapper death = PacketWrapper.create(ClientboundPackets26_3.PLAYER_COMBAT_KILL, user);
+        death.write(Types.VAR_INT, player.javaId()); // entity id
+        death.write(Types.TAG, showReason ? TextUtil.textComponentToNbt(message) : TextUtil.stringToNbt("")); // message
+        death.send(BedrockProtocol.class);
+    }
