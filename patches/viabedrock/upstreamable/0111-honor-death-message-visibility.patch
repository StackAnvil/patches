+final class DeathMessagePacketsTest {
+
+    @Test
+    void hidesTheReasonWithoutSuppressingTheDeathScreenInEitherPacketOrder() throws Exception {
+        for (final boolean infoFirst : List.of(false, true)) {
+            try (var fixture = new Fixture()) {
+                fixture.showReason(false);
+                if (infoFirst) {
+                    fixture.info();
+                }
+                fixture.death();
+                if (!infoFirst) {
+                    fixture.info();
+                }
+                assertEquals(List.of(""), fixture.messages);
+                assertEquals("Controlled death reason", fixture.session.getDeathMessage().asUnformattedString());
+            }
+        }
+    }
+
+    @Test
+    void usesTheCurrentRuleWhenCachedOrLateDeathInformationIsPresented() throws Exception {
+        try (var fixture = new Fixture()) {
+            fixture.info();
+            assertTrue(fixture.messages.isEmpty(), "An alive player must not receive a death screen");
+            fixture.showReason(false);
+            fixture.death();
+            assertEquals(List.of(""), fixture.messages);
+            fixture.showReason(true);
+            assertEquals(List.of("", "Controlled death reason"), fixture.messages);
+            fixture.showReason(false);
+            assertEquals(List.of("", "Controlled death reason", ""), fixture.messages);
+            fixture.showReason(false);
+            assertEquals(3, fixture.messages.size(), "An unchanged rule must not replace the screen");
+        }
+    }
+
+    private static GameRulesStorage rules(final UserConnection user) throws Exception {
+        final Field defaults = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("bedrockGameRules");
+        defaults.setAccessible(true);
+        final Object previous = defaults.get(BedrockProtocol.MAPPINGS);
+        try {
+            defaults.set(BedrockProtocol.MAPPINGS, Map.of("showdeathmessages", true));
+            return new GameRulesStorage(user, new GameRule[0]);
+        } finally {
+            defaults.set(BedrockProtocol.MAPPINGS, previous);
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final UserConnection user = mock(UserConnection.class);
+        private final ClientPlayerEntity player = mock(ClientPlayerEntity.class);
+        private final GameSessionStorage session = mock(GameSessionStorage.class, CALLS_REAL_METHODS);
+        private final AtomicBoolean dead = new AtomicBoolean();
+        private GameRulesStorage rules;
+        private final List<String> messages = new ArrayList<>();
+        private final MockedStatic<PacketWrapper> packets = mockStatic(PacketWrapper.class);
+        private final TestProtocol protocol = new TestProtocol();
+
+        private Fixture() throws Exception {
+            final var entities = mock(EntityTracker.class);
+            final var info = mock(ProtocolInfo.class);
+            when(this.user.getProtocolInfo()).thenReturn(info);
+            when(info.getServerState()).thenReturn(State.PLAY);
+            this.rules = rules(this.user);
+            final var resources = mock(ResourcePackStorage.class);
+            final var texts = mock(TextDefinitions.class);
+            final Map<Class<?>, Object> storage = Map.of(EntityTracker.class, entities,
+                    GameSessionStorage.class, this.session, GameRulesStorage.class, this.rules,
+                    ResourcePackStorage.class, resources, ChannelStorage.class, new ChannelStorage());
+            when(this.user.get(any())).thenAnswer(call -> storage.get(call.getArgument(0)));
+            when(entities.getClientPlayer()).thenReturn(this.player);
+            when(entities.getEntityByRid(42L)).thenReturn(this.player);
+            when(this.player.javaId()).thenReturn(7);
+            when(this.player.isDead()).thenAnswer(call -> this.dead.get());
+            doAnswer(call -> {
+                this.dead.set((float) call.getArgument(0) <= 0);
+                return null;
+            })
+                    .when(this.player).setHealth(anyFloat());
+            when(resources.getTexts()).thenReturn(texts);
+            when(texts.lookup()).thenReturn(Function.identity());
+            this.packets.when(() -> PacketWrapper.create(ClientboundPackets26_3.PLAYER_COMBAT_KILL, this.user))
+                    .thenAnswer(call -> {
+                        final var output = spy(new PacketWrapperImpl(ClientboundPackets26_3.PLAYER_COMBAT_KILL, null, this.user));
+                        doAnswer(send -> {
+                            final var buffer = Unpooled.buffer();
+                            try {
+                                output.writeToBuffer(buffer);
+                                assertEquals(ClientboundPackets26_3.PLAYER_COMBAT_KILL.getId(), Types.VAR_INT.readPrimitive(buffer));
+                                assertEquals(7, Types.VAR_INT.readPrimitive(buffer));
+                                final Tag reason = Types.TAG.read(buffer);
+                                this.messages.add(ProtocolConstants.JAVA_TEXT_COMPONENT_SERIALIZER
+                                        .deserializeNbtTree(reason).asUnformattedString());
+                                assertFalse(buffer.isReadable());
+                            } finally {
+                                buffer.release();
+                            }
+                            return null;
+                        }).when(output).send(BedrockProtocol.class);
+                        return output;
+                    });
+        }
+
+        private void showReason(final boolean show) {
+            this.rules.updateGameRules(new GameRule[]{new GameRule("showDeathMessages", false, show)});
+        }
+
+        private void info() throws Exception {
+            this.receive(ClientboundBedrockPackets.DEATH_INFO, buffer -> {
+                BedrockTypes.STRING.write(buffer, "Controlled death reason");
+                BedrockTypes.STRING_ARRAY.write(buffer, new String[0]);
+            });
+        }
+
+        private void death() throws Exception {
+            this.receive(ClientboundBedrockPackets.ENTITY_EVENT, buffer -> {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, 42L);
+                Types.UNSIGNED_BYTE.write(buffer, (short) ActorEvent.DEATH.getValue());
+                BedrockTypes.VAR_INT.write(buffer, 0);
+                BedrockTypes.OPTIONAL_POSITION_3F.write(buffer, null);
+            });
+        }
+
+        private void receive(final ClientboundBedrockPackets type, final Consumer<ByteBuf> encode) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                encode.accept(input);
+                final var packet = new PacketWrapperImpl(type, input, this.user);
+                final var mapping = this.protocol.mapping(packet);
+                mapping.applyType(packet);
+                mapping.handler().handle(packet);
+                assertTrue(packet.isCancelled());
+                assertFalse(input.isReadable());
+            } finally {
+                input.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.packets.close();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+        private TestProtocol() {
+            HudPackets.register(this);
+            EntityPackets.register(this);
+        }
+
+        private PacketMapping mapping(final PacketWrapper packet) {
+            return this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+        }
+    }
+
+}
