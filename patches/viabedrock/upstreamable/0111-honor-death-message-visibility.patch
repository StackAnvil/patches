+        private void showReason(final boolean show) {
+            this.rules.updateGameRules(new GameRule[]{new GameRule("showDeathMessages", false, show)});
+        }
+
+        private void info() throws Exception {
+            this.info("Controlled death reason");
+        }
+
+        private void info(final String reason) throws Exception {
+            this.receive(ClientboundBedrockPackets.DEATH_INFO, buffer -> {
+                BedrockTypes.STRING.write(buffer, reason);
+                BedrockTypes.STRING_ARRAY.write(buffer, new String[0]);
+            });
+        }
+
+        private void death() throws Exception {
+            this.receive(ClientboundBedrockPackets.ENTITY_EVENT, buffer -> {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, 42L);
+                Types.UNSIGNED_BYTE.write(buffer, (short) ActorEvent.DEATH.getValue());
+                BedrockTypes.VAR_INT.write(buffer, 0);
+                BedrockTypes.OPTIONAL_POSITION_3F.write(buffer, null);
+            });
+        }
+
+        private void health(final float health) throws Exception {
+            this.receive(ClientboundBedrockPackets.UPDATE_ATTRIBUTES, false, buffer -> {
+                BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, 42L);
+                BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 1);
+                for (final float value : new float[]{0F, 20F, health, 0F, 20F, 20F}) {
+                    BedrockTypes.FLOAT_LE.write(buffer, value);
+                }
+                BedrockTypes.STRING.write(buffer, "minecraft:health");
+                BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 0);
+                BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, 0L);
+            });
+        }
+
+        private void respawn() throws Exception {
+            this.receive(ClientboundBedrockPackets.RESPAWN, buffer -> {
+                BedrockTypes.POSITION_3F.write(buffer, new Position3f(0F, 64F, 0F));
+                Types.BYTE.write(buffer, (byte) PlayerRespawnState.ReadyToSpawn.getValue());
+                BedrockTypes.UNSIGNED_VAR_LONG.write(buffer, 42L);
+            });
+        }
+
+        private void receive(final ClientboundBedrockPackets type, final Consumer<ByteBuf> encode) throws Exception {
+            this.receive(type, true, encode);
+        }
+
+        private void receive(final ClientboundBedrockPackets type, final boolean cancelled, final Consumer<ByteBuf> encode) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                encode.accept(input);
+                final var packet = spy(new PacketWrapperImpl(type, input, this.user));
+                doNothing().when(packet).send(BedrockProtocol.class);
+                final var mapping = this.protocol.mapping(packet);
+                mapping.applyType(packet);
+                mapping.handler().handle(packet);
+                assertEquals(cancelled, packet.isCancelled());
+                assertFalse(input.isReadable());
+            } finally {
+                input.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.packets.close();
+        }
+    }
