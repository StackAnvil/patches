+package net.raphimc.viabedrock.protocol.types.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.model.LocatorBarUpdate;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.IconSize;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.WorldPosition;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public final class LocatorBarType extends Type<LocatorBarUpdate[]> {
+
+    public LocatorBarType() {
+        super(LocatorBarUpdate[].class);
+    }
+
+    @Override
+    public LocatorBarUpdate[] read(final ByteBuf buffer) {
+        final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(buffer);
+        // UUID, flags, seven optional-presence bytes and action are mandatory for each entry.
+        if (count < 0 || count > buffer.readableBytes() / 28) {
+            throw new IllegalArgumentException("Locator entries exceed the packet boundary");
+        }
+        final LocatorBarUpdate[] updates = new LocatorBarUpdate[count];
+        for (int i = 0; i < count; i++) {
+            final var group = BedrockTypes.UUID.read(buffer);
+            final int flags = buffer.readIntLE();
+            final Boolean visible = buffer.readBoolean() ? buffer.readBoolean() : null;
+            final WorldPosition position = buffer.readBoolean()
+                ? new WorldPosition(BedrockTypes.POSITION_3F.read(buffer), BedrockTypes.VAR_INT.readPrimitive(buffer)) : null;
+            final String texture = buffer.readBoolean() ? BedrockTypes.STRING.read(buffer) : null;
+            final IconSize size = buffer.readBoolean() ? new IconSize(buffer.readFloatLE(), buffer.readFloatLE()) : null;
+            final Integer color = buffer.readBoolean() ? buffer.readIntLE() : null;
+            final Boolean authority = buffer.readBoolean() ? buffer.readBoolean() : null;
+            final Long actorId = buffer.readBoolean() ? BedrockTypes.VAR_LONG.readPrimitive(buffer) : null;
+            updates[i] = new LocatorBarUpdate(group, flags, visible, position, texture, size, color, authority, actorId, buffer.readUnsignedByte());
+        }
+        return updates;
+    }
+
+    @Override
+    public void write(final ByteBuf buffer, final LocatorBarUpdate[] updates) {
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, updates.length);
+        for (LocatorBarUpdate update : updates) {
+            BedrockTypes.UUID.write(buffer, update.group());
+            buffer.writeIntLE(update.flags());
+            buffer.writeBoolean(update.visible() != null);
+            if (update.visible() != null) {
+                buffer.writeBoolean(update.visible());
+            }
+            buffer.writeBoolean(update.position() != null);
+            if (update.position() != null) {
+                BedrockTypes.POSITION_3F.write(buffer, update.position().position());
+                BedrockTypes.VAR_INT.writePrimitive(buffer, update.position().dimension());
+            }
+            buffer.writeBoolean(update.texture() != null);
+            if (update.texture() != null) {
+                BedrockTypes.STRING.write(buffer, update.texture());
+            }
+            buffer.writeBoolean(update.size() != null);
+            if (update.size() != null) {
+                buffer.writeFloatLE(update.size().width());
+                buffer.writeFloatLE(update.size().height());
+            }
+            buffer.writeBoolean(update.color() != null);
+            if (update.color() != null) {
+                buffer.writeIntLE(update.color());
+            }
+            buffer.writeBoolean(update.clientPositionAuthority() != null);
+            if (update.clientPositionAuthority() != null) {
+                buffer.writeBoolean(update.clientPositionAuthority());
+            }
+            buffer.writeBoolean(update.actorUniqueId() != null);
+            if (update.actorUniqueId() != null) {
+                BedrockTypes.VAR_LONG.writePrimitive(buffer, update.actorUniqueId());
+            }
+            buffer.writeByte(update.action());
+        }
+    }
+
+}
