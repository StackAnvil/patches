+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+public final class LocatorBarState {
+
+    private final Map<UUID, LocatorBarWaypoint> waypoints = new LinkedHashMap<>();
+
+    public Map<UUID, LocatorBarWaypoint> waypoints() {
+        return Collections.unmodifiableMap(this.waypoints);
+    }
+
+    public boolean apply(final LocatorBarUpdate update) {
+        final LocatorBarWaypoint previous = this.waypoints.get(update.group());
+        switch (update.action()) {
+            case LocatorBarUpdate.ADD -> {
+                if (previous != null) {
+                    return false;
+                }
+                this.waypoints.put(update.group(), merge(LocatorBarWaypoint.EMPTY, update, update.actorUniqueId()));
+                return true;
+            }
+            case LocatorBarUpdate.REMOVE -> {
+                return this.waypoints.remove(update.group()) != null;
+            }
+            case LocatorBarUpdate.UPDATE -> {
+                if (previous == null) {
+                    return false;
+                }
+                final LocatorBarWaypoint next = merge(previous, update, previous.actorUniqueId());
+                if (next.equals(previous)) {
+                    return false;
+                }
+                this.waypoints.put(update.group(), next);
+                return true;
+            }
+            default -> {
+                return false;
+            }
+        }
+    }
+
+    public void clear() {
+        this.waypoints.clear();
+    }
+
+    private static LocatorBarWaypoint merge(final LocatorBarWaypoint previous, final LocatorBarUpdate update, final Long actorId) {
+        final int flags = update.flags();
+        // Native position, size and boolean updates require values; absent dirty texture/color reset.
+        return new LocatorBarWaypoint(
+            (flags & LocatorBarUpdate.VISIBILITY) != 0 && update.visible() != null ? update.visible() : previous.visible(),
+            (flags & LocatorBarUpdate.POSITION) != 0 && update.position() != null ? update.position() : previous.position(),
+            (flags & LocatorBarUpdate.TEXTURE) != 0 ? update.texture() == null ? "" : update.texture() : previous.texture(),
+            (flags & LocatorBarUpdate.ICON_SIZE) != 0 && update.size() != null ? update.size() : previous.size(),
+            (flags & LocatorBarUpdate.COLOR) != 0 ? update.color() == null ? -1 : update.color() : previous.color(),
+            (flags & LocatorBarUpdate.CLIENT_POSITION_AUTHORITY) != 0 && update.clientPositionAuthority() != null ? update.clientPositionAuthority() : previous.clientPositionAuthority(),
+            actorId
+        );
+    }
+
+}
