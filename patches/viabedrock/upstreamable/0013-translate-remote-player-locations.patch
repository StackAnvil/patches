+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PlayerWaypointTrackerTest {
+
+    @Test
+    void encodesPlayerPositionAndHideAsJavaWaypoints() throws Exception {
+        final UUID uuid = UUID.randomUUID();
+        final BlockPosition position = new BlockPosition(-8, 64, 200);
+
+        assertWaypoint(uuid, position, 0, 1);
+        assertWaypoint(uuid, position, 2, 1);
+        assertWaypoint(uuid, null, 1, 0);
+    }
+
+    private static void assertWaypoint(final UUID uuid, final BlockPosition position, final int operation, final int type) throws Exception {
+        final PacketWrapper wrapper = new PacketWrapperImpl(ClientboundPackets26_3.TRACKED_WAYPOINT, null, null);
+        PlayerWaypointTracker.writeWaypoint(wrapper, operation, uuid, position);
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.TRACKED_WAYPOINT.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(operation, Types.VAR_INT.read(buffer));
+            assertTrue(Types.BOOLEAN.read(buffer));
+            assertEquals(uuid, Types.UUID.read(buffer));
+            Types.STRING.read(buffer);
+            assertFalse(Types.BOOLEAN.read(buffer));
+            assertEquals(type, Types.VAR_INT.read(buffer));
+            if (position != null) {
+                assertEquals(position.x(), Types.VAR_INT.read(buffer));
+                assertEquals(position.y(), Types.VAR_INT.read(buffer));
+                assertEquals(position.z(), Types.VAR_INT.read(buffer));
+            }
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
