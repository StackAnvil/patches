+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.IconSize;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.WorldPosition;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarSnapshotTest {
+
+    @Test
+    void transportsOrderedGroupStateWithoutSharingMutableStorage() throws Exception {
+        final UUID first = UUID.randomUUID();
+        final UUID second = UUID.randomUUID();
+        final Map<UUID, LocatorBarWaypoint> groups = new LinkedHashMap<>();
+        groups.put(first, new LocatorBarWaypoint(true, new WorldPosition(new Position3f(-90F, 121.62F, 74F), 2),
+            "textures/ui/locator_bar_dot_0", new IconSize(2F, 0.5F), 0xFF00FF00, true, Long.MIN_VALUE));
+        groups.put(second, LocatorBarWaypoint.EMPTY);
+        final LocatorBarSnapshot snapshot = new LocatorBarSnapshot(groups);
+        groups.clear();
+        assertEquals(2, snapshot.waypoints().size());
+        assertThrows(UnsupportedOperationException.class, () -> snapshot.waypoints().clear());
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            LocatorBarSnapshot.TYPE.write(buffer, snapshot);
+            final LocatorBarSnapshot decoded = LocatorBarSnapshot.TYPE.read(buffer);
+            assertEquals(snapshot, decoded);
+            assertEquals(java.util.List.of(first, second), java.util.List.copyOf(decoded.waypoints().keySet()));
+            assertEquals(0, buffer.readableBytes());
+            LocatorBarSnapshot.TYPE.write(buffer, new LocatorBarSnapshot(Map.of()));
+            assertTrue(LocatorBarSnapshot.TYPE.read(buffer).waypoints().isEmpty());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
