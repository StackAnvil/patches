     public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.PLAYER_LOCATION, null, wrapper -> {
+            wrapper.cancel();
+            final PlayerLocation location = readPlayerLocation(wrapper);
+            if (location == null) {
+                return;
+            }
+            final var player = wrapper.user().get(PlayerListStorage.class).getPlayer(location.uniqueId());
+            if (player == null) {
+                return;
+            }
+
+            final PlayerWaypointTracker waypoints = wrapper.user().get(PlayerWaypointTracker.class);
+            if (location.position() != null) {
+                waypoints.update(player.key(), location.position());
+            } else {
+                waypoints.remove(player.key());
+            }
+        });
         protocol.registerClientbound(ClientboundBedrockPackets.ADD_PLAYER, ClientboundPackets26_3.ADD_ENTITY, wrapper -> {
             final GameSessionStorage gameSession = wrapper.user().get(GameSessionStorage.class);
             final ItemRewriter itemRewriter = wrapper.user().get(ItemRewriter.class);
@@ -200,7 +221,21 @@ public final class OtherPlayerPackets {
         });
     }
 
+    static PlayerLocation readPlayerLocation(final PacketWrapper wrapper) {
+        final long uniqueId = wrapper.read(BedrockTypes.VAR_LONG); // target actor unique id
+        final int variant = wrapper.read(BedrockTypes.UNSIGNED_VAR_INT);
+        final PlayerLocationPacketType type = PlayerLocationPacketType.getByValue(wrapper.read(BedrockTypes.VAR_INT));
+        if (type == null || variant != type.getValue()) {
+            return null;
+        }
+        return new PlayerLocation(uniqueId, type == PlayerLocationPacketType.PLAYER_LOCATION_COORDINATES
+            ? wrapper.read(BedrockTypes.POSITION_3F) : null);
+    }
+
     private OtherPlayerPackets() {
     }
 
+    record PlayerLocation(long uniqueId, Position3f position) {
+    }
+
 }
