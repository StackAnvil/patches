+package net.raphimc.viabedrock.protocol.types.model;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.LocatorBarUpdate;
+import net.raphimc.viabedrock.protocol.model.LocatorBarState;
+import org.junit.jupiter.api.Test;
+
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarTypeTest {
+
+    // Controlled native 1.26.51.1/protocol 2193 fixture, including a signed actor unique ID.
+    private static final byte[] ADD = HexFormat.of().parseHex("01000000000000001001000000000000003f0000000101010000b4c2713df3420000944200011d74657874757265732f75692f6c6f6361746f725f6261725f646f745f30010000803f0000803f010000ffff010101e3ffffffdf1001");
+    private static final byte[] UPDATE = HexFormat.of().parseHex("010000000000000010010000000000000010000000000000000100ff00ff000003");
+
+    @Test
+    void decodesWireEntriesAndPreservesEveryOptionalOnRoundTrip() {
+        final LocatorBarType type = new LocatorBarType();
+        final ByteBuf input = Unpooled.wrappedBuffer(ADD);
+        final ByteBuf output = Unpooled.buffer();
+        try {
+            final LocatorBarUpdate[] updates = type.read(input);
+            assertEquals(0, input.readableBytes());
+            assertEquals(1, updates.length);
+            final var update = updates[0];
+            assertEquals(63, update.flags());
+            assertEquals(1, update.action());
+            assertEquals(-90F, update.position().position().x());
+            assertEquals(0, update.position().dimension());
+            assertEquals(0xFFFF0000, update.color());
+            assertEquals(-287762808818L, update.actorUniqueId());
+            assertTrue(update.visible());
+            assertTrue(update.clientPositionAuthority());
+            type.write(output, updates);
+            final byte[] encoded = new byte[output.readableBytes()];
+            output.readBytes(encoded);
+            assertArrayEquals(ADD, encoded);
+        } finally {
+            input.release();
+            output.release();
+        }
+    }
+
+    @Test
+    void partialWireUpdateChangesOnlyTheFlaggedField() {
+        final LocatorBarType type = new LocatorBarType();
+        final ByteBuf add = Unpooled.wrappedBuffer(ADD);
+        final ByteBuf update = Unpooled.wrappedBuffer(UPDATE);
+        try {
+            final LocatorBarState state = new LocatorBarState();
+            final var first = type.read(add)[0];
+            state.apply(first);
+            final var previous = state.waypoints().get(first.group());
+            final var second = type.read(update)[0];
+            state.apply(second);
+            final var current = state.waypoints().get(first.group());
+            assertEquals(0xFF00FF00, current.color());
+            assertEquals(previous.position(), current.position());
+            assertEquals(previous.size(), current.size());
+            assertEquals(previous.actorUniqueId(), current.actorUniqueId());
+            assertEquals(0, update.readableBytes());
+        } finally {
+            add.release();
+            update.release();
+        }
+    }
+
+    @Test
+    void rejectsEntryCountsOutsideThePayloadAndTruncatedOptionals() {
+        final LocatorBarType type = new LocatorBarType();
+        final ByteBuf count = Unpooled.wrappedBuffer(new byte[]{2});
+        final ByteBuf truncated = Unpooled.wrappedBuffer(java.util.Arrays.copyOf(ADD, ADD.length - 3));
+        try {
+            assertThrows(IllegalArgumentException.class, () -> type.read(count));
+            assertThrows(IndexOutOfBoundsException.class, () -> type.read(truncated));
+        } finally {
+            count.release();
+            truncated.release();
+        }
+    }
+
+}
