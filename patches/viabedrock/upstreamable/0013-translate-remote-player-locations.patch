+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.VAR_LONG.write(buffer, 42L);
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 0);
+            BedrockTypes.VAR_INT.write(buffer, 0);
+            BedrockTypes.POSITION_3F.write(buffer, new Position3f(-8.5F, 64F, 200.25F));
+
+            final var location = OtherPlayerPackets.readPlayerLocation(
+                new PacketWrapperImpl(ClientboundBedrockPackets.PLAYER_LOCATION, buffer, null));
+            assertNotNull(location);
+            assertEquals(42L, location.uniqueId());
+            assertEquals(-8.5F, location.position().x());
+            assertEquals(64F, location.position().y());
+            assertEquals(200.25F, location.position().z());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void hidesWithoutReadingCoordinates() throws Exception {
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            BedrockTypes.VAR_LONG.write(buffer, 42L);
+            BedrockTypes.UNSIGNED_VAR_INT.write(buffer, 1);
+            BedrockTypes.VAR_INT.write(buffer, 1);
+
+            final var location = OtherPlayerPackets.readPlayerLocation(
+                new PacketWrapperImpl(ClientboundBedrockPackets.PLAYER_LOCATION, buffer, null));
+            assertNotNull(location);
+            assertNull(location.position());
+            assertEquals(0, buffer.readableBytes());
+        } finally {
