+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.IconSize;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.WorldPosition;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarStateTest {
+
+    private static final UUID GROUP = UUID.randomUUID();
+    private static final WorldPosition POSITION = new WorldPosition(new Position3f(-90F, 121.62F, 74F), 0);
+    private static final IconSize SIZE = new IconSize(1F, 1F);
+
+    @Test
+    void followsNativeMaskAndOmittedFieldRules() {
+        final LocatorBarState state = new LocatorBarState();
+        state.apply(full(LocatorBarUpdate.ADD));
+        assertTrue(state.apply(update(16, null, null, null, null, 0xFF00FF00, null, null)));
+        assertEquals(0xFF00FF00, state.waypoints().get(GROUP).color());
+        assertEquals(POSITION, state.waypoints().get(GROUP).position());
+        assertFalse(state.apply(update(0, null, null, null, null, 0xFF0000FF, null, null)));
+        assertFalse(state.apply(update(9, null, null, null, null, null, null, null)));
+        assertTrue(state.apply(update(32, null, null, null, null, null, true, null)));
+        assertEquals(SIZE, state.waypoints().get(GROUP).size());
+        assertTrue(state.apply(update(54, null, null, null, null, null, null, null)));
+        final var reset = state.waypoints().get(GROUP);
+        assertTrue(reset.visible());
+        assertTrue(reset.texture().isEmpty());
+        assertEquals(-1, reset.color());
+        assertTrue(reset.clientPositionAuthority());
+        assertEquals(POSITION, reset.position());
+        assertEquals(SIZE, reset.size());
+    }
+
+    @Test
+    void handlesDuplicateAddUnknownUpdateAndRemoveWithoutRebindingActors() {
+        final LocatorBarState state = new LocatorBarState();
+        assertFalse(state.apply(full(LocatorBarUpdate.UPDATE)));
+        assertTrue(state.apply(full(LocatorBarUpdate.ADD)));
+        final var initial = state.waypoints().get(GROUP);
+        assertFalse(state.apply(full(LocatorBarUpdate.ADD)));
+        assertFalse(state.apply(update(0, null, null, null, null, null, null, 42L)));
+        assertEquals(initial, state.waypoints().get(GROUP));
+        assertEquals(-287762808818L, initial.actorUniqueId());
+        assertFalse(state.apply(full(LocatorBarUpdate.NONE)));
+        assertTrue(state.apply(full(LocatorBarUpdate.REMOVE)));
+        assertFalse(state.apply(full(LocatorBarUpdate.REMOVE)));
+        assertFalse(state.apply(full(LocatorBarUpdate.UPDATE)));
+        assertTrue(state.waypoints().isEmpty());
+    }
+
+    @Test
+    void addUsesFlagsAndInitialZeroSize() {
+        final LocatorBarState state = new LocatorBarState();
+        state.apply(new LocatorBarUpdate(GROUP, 0, true, POSITION, "ignored", SIZE, 0xFF00FF00, true, 42L, LocatorBarUpdate.ADD));
+        final var value = state.waypoints().get(GROUP);
+        assertFalse(value.visible());
+        assertNull(value.position());
+        assertTrue(value.texture().isEmpty());
+        assertEquals(IconSize.ZERO, value.size());
+        assertEquals(-1, value.color());
+        assertFalse(value.clientPositionAuthority());
+        assertEquals(42L, value.actorUniqueId());
+        state.clear();
+        assertTrue(state.waypoints().isEmpty());
+    }
+
+    private static LocatorBarUpdate full(final int action) {
+        return new LocatorBarUpdate(GROUP, 63, true, POSITION, "textures/ui/locator_bar_dot_0", SIZE, 0xFFFF0000, false, -287762808818L, action);
+    }
+
+    private static LocatorBarUpdate update(final int flags, final Boolean visible, final WorldPosition position, final String texture,
+                                           final IconSize size, final Integer color, final Boolean authority, final Long actorId) {
+        return new LocatorBarUpdate(GROUP, flags, visible, position, texture, size, color, authority, actorId, LocatorBarUpdate.UPDATE);
+    }
+
+}
