+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+public final class PlayerWaypointTracker extends StoredObject {
+
+    private static final int TRACK = 0;
+    private static final int UNTRACK = 1;
+    private static final int UPDATE = 2;
+    private static final int EMPTY = 0;
+    private static final int VEC3I = 1;
+
+    private final Map<UUID, BlockPosition> positions = new HashMap<>();
+
+    public PlayerWaypointTracker(final UserConnection user) {
+        super(user);
+    }
+
+    public void update(final UUID uuid, final Position3f position) {
+        final BlockPosition blockPosition = new BlockPosition(
+            (int) Math.floor(position.x()),
+            (int) Math.floor(position.y()),
+            (int) Math.floor(position.z())
+        );
+        final BlockPosition previous = this.positions.put(uuid, blockPosition);
+        if (blockPosition.equals(previous)) {
+            return;
+        }
+
+        final PacketWrapper waypoint = PacketWrapper.create(ClientboundPackets26_3.TRACKED_WAYPOINT, this.user());
+        writeWaypoint(waypoint, previous == null ? TRACK : UPDATE, uuid, blockPosition);
+        waypoint.send(BedrockProtocol.class);
+    }
+
+    public void remove(final UUID uuid) {
+        if (this.positions.remove(uuid) == null) {
+            return;
+        }
+
+        final PacketWrapper waypoint = PacketWrapper.create(ClientboundPackets26_3.TRACKED_WAYPOINT, this.user());
+        writeWaypoint(waypoint, UNTRACK, uuid, null);
+        waypoint.send(BedrockProtocol.class);
+    }
+
+    public void clear() {
+        for (UUID uuid : this.positions.keySet().toArray(new UUID[0])) {
+            this.remove(uuid);
+        }
+    }
+
+    static void writeWaypoint(final PacketWrapper wrapper, final int operation, final UUID uuid, final BlockPosition position) {
+        wrapper.write(Types.VAR_INT, operation);
+        wrapper.write(Types.BOOLEAN, true); // UUID identifier, not a string
+        wrapper.write(Types.UUID, uuid);
+        wrapper.write(Types.STRING, "minecraft:default"); // icon style
+        wrapper.write(Types.BOOLEAN, false); // no icon color
+        wrapper.write(Types.VAR_INT, position == null ? EMPTY : VEC3I);
+        if (position != null) {
+            wrapper.write(Types.VAR_INT, position.x());
+            wrapper.write(Types.VAR_INT, position.y());
+            wrapper.write(Types.VAR_INT, position.z());
+        }
+    }
+
+}
