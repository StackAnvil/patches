+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.IconSize;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint.WorldPosition;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+public record LocatorBarSnapshot(Map<UUID, LocatorBarWaypoint> waypoints) {
+
+    public static final String CHANNEL = "viabedrock:locator_bar_v1";
+    public static final Type<LocatorBarSnapshot> TYPE = new Type<>(LocatorBarSnapshot.class) {
+        @Override
+        public LocatorBarSnapshot read(final ByteBuf buffer) {
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > buffer.readableBytes() / 33) {
+                throw new IllegalArgumentException("Locator snapshot exceeds the payload boundary");
+            }
+            final Map<UUID, LocatorBarWaypoint> waypoints = new LinkedHashMap<>();
+            for (int i = 0; i < count; i++) {
+                final UUID group = Types.UUID.read(buffer);
+                final boolean visible = buffer.readBoolean();
+                final WorldPosition position = buffer.readBoolean() ? new WorldPosition(new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat()), Types.VAR_INT.readPrimitive(buffer)) : null;
+                final String texture = Types.STRING.read(buffer);
+                final IconSize size = new IconSize(buffer.readFloat(), buffer.readFloat());
+                final int color = buffer.readInt();
+                final boolean authority = buffer.readBoolean();
+                final Long actor = buffer.readBoolean() ? buffer.readLong() : null;
+                waypoints.put(group, new LocatorBarWaypoint(visible, position, texture, size, color, authority, actor));
+            }
+            return new LocatorBarSnapshot(waypoints);
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final LocatorBarSnapshot snapshot) {
+            Types.VAR_INT.writePrimitive(buffer, snapshot.waypoints.size());
+            for (var entry : snapshot.waypoints.entrySet()) {
+                Types.UUID.write(buffer, entry.getKey());
+                final LocatorBarWaypoint waypoint = entry.getValue();
+                buffer.writeBoolean(waypoint.visible());
+                buffer.writeBoolean(waypoint.position() != null);
+                if (waypoint.position() != null) {
+                    final Position3f position = waypoint.position().position();
+                    buffer.writeFloat(position.x()).writeFloat(position.y()).writeFloat(position.z());
+                    Types.VAR_INT.writePrimitive(buffer, waypoint.position().dimension());
+                }
+                Types.STRING.write(buffer, waypoint.texture());
+                buffer.writeFloat(waypoint.size().width()).writeFloat(waypoint.size().height());
+                buffer.writeInt(waypoint.color());
+                buffer.writeBoolean(waypoint.clientPositionAuthority());
+                buffer.writeBoolean(waypoint.actorUniqueId() != null);
+                if (waypoint.actorUniqueId() != null) {
+                    buffer.writeLong(waypoint.actorUniqueId());
+                }
+            }
+        }
+    };
+
+    public LocatorBarSnapshot {
+        waypoints = Collections.unmodifiableMap(new LinkedHashMap<>(waypoints));
+    }
+
+}
