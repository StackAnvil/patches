index 0000000000000000000000000000000000000000..9aa106642ade895c1f7b81b75ff28553abc2ae8d
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/BedrockResourcePackPayloads.java
@@ -0,0 +1,205 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.content.ZipContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.function.Predicate;
+import java.util.regex.Pattern;
+
+/** Complete Bedrock ZIPs inside ordinary Java RPs, indexed only by pack.mcmeta. */
+public final class BedrockResourcePackPayloads {
+
+    public static final String METADATA_SECTION = "viabedrock_sources";
+    public static final String RESOURCE_DIRECTORY = "bedrock/";
+    public static final String PAYLOAD_DIRECTORY = "assets/viabedrock/" + RESOURCE_DIRECTORY;
+    public static final int MAX_METADATA_BYTES = 16 << 20;
+    private static final Pattern SHA256 = Pattern.compile("[0-9a-f]{64}");
+
+    public static Content export(final String baseGameVersion, final Collection<ResourcePack> bottomToTop,
+                                 final Predicate<ResourcePack> server) throws IOException {
+        final List<ResourcePack> packs = List.copyOf(bottomToTop);
+        NativeResourceArchive.select(packs.stream().map(pack -> NativeActorLibrary.source(pack.content())).toList(),
+                ignored -> true, List.of(), List.of(""));
+        final Content result = new InMemoryContent();
+        final JsonObject index = new JsonObject();
+        index.addProperty("format", 1);
+        index.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        index.addProperty("base_game_version", baseGameVersion);
+        final JsonArray layers = new JsonArray();
+        final MessageDigest digest = digest();
+        long encoded = 0;
+        for (final ResourcePack pack : packs) {
+            final Content source = NativeActorLibrary.source(pack.content());
+            byte[] zip = source instanceof ZipContent received ? received.sourceZip() : source.toZip();
+            try {
+                NativeResourceArchive.validateSourceDirectory(zip);
+            } catch (final IOException nonstandard) {
+                zip = source.toZip();
+                NativeResourceArchive.validateSourceDirectory(zip);
+            }
+            encoded += zip.length;
+            if (encoded > NativeResourceArchive.MAX_TOTAL_BYTES) {
+                throw new IOException("Bedrock payloads exceed limits");
+            }
+            final String sha = HexFormat.of().formatHex(digest.digest(zip));
+            result.putStored(PAYLOAD_DIRECTORY + sha + ".mcpack", zip);
+            final JsonObject layer = new JsonObject();
+            layer.addProperty("sha256", sha);
+            layer.addProperty("bytes", zip.length);
+            layer.addProperty("server", server.test(pack));
+            layer.addProperty("subpack", NativeActorLibrary.selection(pack.content()));
+            layers.add(layer);
+        }
+        index.add("packs", layers);
+        final JsonObject metadata = new JsonObject();
+        metadata.add(METADATA_SECTION, index);
+        if (metadata.toString().getBytes(StandardCharsets.UTF_8).length > MAX_METADATA_BYTES) {
+            throw new IOException("Bedrock payload metadata exceeds limits");
+        }
+        result.putJson("pack.mcmeta", metadata);
+        return result;
+    }
+
+    /** Resolves and checks every referenced ZIP before a decoded-cache lookup can succeed. */
+    public static Sources prepare(final JsonObject index, final PayloadOpener opener) throws IOException {
+        try {
+            if (integer(index, "format") != 1 || integer(index, "bedrock_protocol") != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IOException("Unsupported Bedrock payload index");
+            }
+            final String version = string(index, "base_game_version");
+            if (version.isBlank() || version.length() > 64) {
+                throw new IOException("Invalid Bedrock payload base version");
+            }
+            final JsonArray packs = index.getAsJsonArray("packs");
+            if (packs == null || packs.size() > NativeResourceArchive.MAX_PACKS) {
+                throw new IOException("Invalid Bedrock payload count");
+            }
+            final List<NativeActorLibrary.PackedLayer> layers = new ArrayList<>(packs.size());
+            final MessageDigest digest = digest();
+            long total = 0;
+            for (final JsonElement element : packs) {
+                final JsonObject pack = element.getAsJsonObject();
+                final String sha = string(pack, "sha256");
+                final String selection = string(pack, "subpack");
+                if (!SHA256.matcher(sha).matches()) {
+                    throw new IOException("Invalid Bedrock payload digest");
+                }
+                if (!selection.isEmpty()) {
+                    NativeResourceArchive.validatePath(selection, ignored -> true);
+                }
+                final int length = integer(pack, "bytes");
+                total += length;
+                if (length < 22 || total > NativeResourceArchive.MAX_TOTAL_BYTES) {
+                    throw new IOException("Bedrock payloads exceed limits");
+                }
+                final JsonElement role = pack.get("server");
+                if (role == null || !role.isJsonPrimitive() || !role.getAsJsonPrimitive().isBoolean()) {
+                    throw new IOException("Invalid Bedrock payload provenance");
+                }
+                final byte[] bytes;
+                try (InputStream input = opener.open(sha)) {
+                    if (input == null) {
+                        throw new IOException("Missing Bedrock payload");
+                    }
+                    bytes = input.readNBytes(length + 1);
+                }
+                if (bytes.length != length || !sha.equals(HexFormat.of().formatHex(digest.digest(bytes)))) {
+                    throw new IOException("Bedrock payload digest or size mismatch");
+                }
+                layers.add(new NativeActorLibrary.PackedLayer(role.getAsBoolean(), selection, bytes));
+            }
+            final String key = sourcesKey(index);
+            return new Sources(version, List.copyOf(layers), key, total);
+        } catch (final RuntimeException invalid) {
+            throw new IOException("Invalid Bedrock payload index", invalid);
+        }
+    }
+
+    /** Identifies one accepted source index exactly as the frontend parses it from pack.mcmeta. */
+    public static String sourcesKey(final JsonObject index) {
+        return HexFormat.of().formatHex(digest().digest(index.toString().getBytes(StandardCharsets.UTF_8)));
+    }
+
+    public static List<NativeActorLibrary.Layer> decode(final Sources sources) throws IOException {
+        return NativeActorLibrary.decodePacks(sources.layers);
+    }
+
+    private static String string(final JsonObject object, final String key) throws IOException {
+        final JsonElement value = object.get(key);
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+            throw new IOException("Invalid Bedrock payload field: " + key);
+        }
+        return value.getAsString();
+    }
+
+    private static int integer(final JsonObject object, final String key) throws IOException {
+        final JsonElement value = object.get(key);
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IOException("Invalid Bedrock payload field: " + key);
+        }
+        return value.getAsBigDecimal().intValueExact();
+    }
+
+    private static MessageDigest digest() {
+        try {
+            return MessageDigest.getInstance("SHA-256");
+        } catch (final NoSuchAlgorithmException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+    private BedrockResourcePackPayloads() {
+    }
+
+    @FunctionalInterface
+    public interface PayloadOpener {
+        InputStream open(String sha256) throws IOException;
+    }
+
+    /** Verified input owns its bytes and cannot be constructed with an unchecked cache key. */
+    public static final class Sources {
+        private final String baseGameVersion;
+        private final List<NativeActorLibrary.PackedLayer> layers;
+        private final String cacheKey;
+        private final long encodedBytes;
+
+        private Sources(final String baseGameVersion, final List<NativeActorLibrary.PackedLayer> layers, final String cacheKey, final long encodedBytes) {
+            this.baseGameVersion = baseGameVersion;
+            this.layers = layers;
+            this.cacheKey = cacheKey;
+            this.encodedBytes = encodedBytes;
+        }
+
+        public String baseGameVersion() {
+            return this.baseGameVersion;
+        }
+
+        public String cacheKey() {
+            return this.cacheKey;
+        }
+
+        public long encodedBytes() {
+            return this.encodedBytes;
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java
new file mode 100644
index 0000000000000000000000000000000000000000..ef29b34d91f90f097b666ef651ef215d95d2028d
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/NativeActorLibrary.java
@@ -0,0 +1,208 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.content.SubpackContent;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Predicate;
+import java.util.zip.CRC32;
+import java.util.zip.CheckedInputStream;
+import org.apache.commons.compress.archivers.zip.ZipFile;
+import org.apache.commons.compress.utils.SeekableInMemoryByteChannel;
+
+/** Native actor resources in resolved pack order, including their server or built-in provenance. */
+public final class NativeActorLibrary {
+
+    private static final int MAX_PACKS = 4096;
+    private static final int MAX_BYTES = 256 << 20;
+    private static final int MAX_FILE_BYTES = 32 << 20;
+    private static final int MAX_FILES = 32768;
+
+    /** Complete source context and the existing actor view, without compression for local consumers. */
+    public static List<Layer> resources(final Collection<ResourcePack> bottomToTop, final Predicate<ResourcePack> server) throws IOException {
+        final List<ResourcePack> packs = List.copyOf(bottomToTop);
+        final List<Map<String, byte[]>> sources = NativeResourceArchive.select(packs.stream().map(pack -> source(pack.content())).toList(),
+                ignored -> true, List.of(), List.of(""));
+        final List<Layer> layers = new ArrayList<>(packs.size());
+        for (int index = 0; index < packs.size(); index++) {
+            final ResourcePack pack = packs.get(index);
+            layers.add(layer(server.test(pack), sources.get(index), selection(pack.content())));
+        }
+        return List.copyOf(layers);
+    }
+
+    static Content source(final Content content) {
+        return content instanceof SubpackContent selected ? selected.source() : content;
+    }
+
+    static String selection(final Content content) throws IOException {
+        final String selection = content instanceof SubpackContent selected ? selected.selectedSubpack() : "";
+        validateSelection(selection);
+        return selection;
+    }
+
+    private static void validateSelection(final String selection) throws IOException {
+        if (!selection.isEmpty()) {
+            NativeResourceArchive.validatePath(selection, ignored -> true);
+        }
+    }
+
+    static Layer layer(final boolean server, final Map<String, byte[]> source, final String selection) throws IOException {
+        validateSelection(selection);
+        if (selection.isEmpty() && source.keySet().stream().allMatch(path -> !path.startsWith("subpacks/") && resource(path))) {
+            return new Layer(server, source, source, selection);
+        }
+        final Map<String, byte[]> effective = new LinkedHashMap<>();
+        source.forEach((path, bytes) -> {
+            if (!path.startsWith("subpacks/") && resource(path)) {
+                effective.put(path, bytes);
+            }
+        });
+        if (!selection.isEmpty()) {
+            final String prefix = "subpacks/" + selection + '/';
+            source.forEach((path, bytes) -> {
+                if (path.startsWith(prefix) && resource(path.substring(prefix.length()))) {
+                    effective.put(path.substring(prefix.length()), bytes);
+                }
+            });
+        }
+        return new Layer(server, effective, source, selection);
+    }
+
+    /** Shares effect dependencies while preserving empty layers and excluding actor-only definitions. */
+    public static List<Map<String, byte[]>> effects(final List<Layer> layers) throws IOException {
+        final List<Content> packs = new ArrayList<>(layers.size());
+        for (final Layer layer : layers) {
+            final InMemoryContent content = new InMemoryContent();
+            layer.resources().forEach(content::put);
+            packs.add(content);
+        }
+        return NativeResourceArchive.select(packs, NativeActorLibrary::effectResource, List.of("sounds.json"),
+                List.of(".json", ".png", ".tga", ".ogg", ".fsb", ".wav", ".lang"));
+    }
+
+    private static boolean effectResource(final String path) {
+        return path.equals("sounds.json")
+                || path.startsWith("sounds/") && (path.endsWith(".json") || path.endsWith(".ogg") || path.endsWith(".fsb") || path.endsWith(".wav"))
+                || path.startsWith("texts/") && path.endsWith(".lang")
+                || path.endsWith(".json") && (path.startsWith("particles/") || path.startsWith("render_controllers/"))
+                || path.endsWith(".png") || path.endsWith(".tga");
+    }
+
+    static List<Layer> decodePacks(final List<PackedLayer> packs) throws IOException {
+        if (packs.size() > MAX_PACKS) {
+            throw new IOException("Too many native source packs");
+        }
+        final List<Layer> layers = new ArrayList<>(packs.size());
+        long encoded = 0;
+        long total = 0;
+        int files = 0;
+        for (final PackedLayer pack : packs) {
+            final byte[] archive = pack.archive();
+            encoded += archive.length;
+            if (encoded > MAX_BYTES) {
+                throw new IOException("Native source archives exceed limits");
+            }
+            NativeResourceArchive.validateSourceDirectory(archive);
+            final Map<String, byte[]> source = new LinkedHashMap<>();
+            try (var channel = new SeekableInMemoryByteChannel(archive);
+                 var zip = ZipFile.builder().setSeekableByteChannel(channel).get()) {
+                final var entries = zip.getEntriesInPhysicalOrder();
+                while (entries.hasMoreElements()) {
+                    final var entry = entries.nextElement();
+                    if (entry.isDirectory()) {
+                        continue;
+                    }
+                    final String path = entry.getName().replace('\\', '/').replaceAll("/{2,}", "/");
+                    NativeResourceArchive.validatePath(path, ignored -> true);
+                    if (++files > MAX_FILES) {
+                        throw new IOException("Too many native source files");
+                    }
+                    final int limit = (int) Math.min(MAX_FILE_BYTES, MAX_BYTES - total);
+                    try (var input = new CheckedInputStream(zip.getInputStream(entry), new CRC32())) {
+                        final byte[] bytes = input.readNBytes(limit + 1);
+                        total += bytes.length;
+                        if (bytes.length > limit || bytes.length != entry.getSize() || input.getChecksum().getValue() != entry.getCrc()) {
+                            throw new IOException("Oversized or corrupt native source file");
+                        }
+                        // ZipContent accepts the final occurrence of a normalized path too.
+                        source.put(path, bytes);
+                    }
+                }
+            }
+            if (!source.containsKey("manifest.json") && !source.containsKey("pack_manifest.json")) {
+                throw new IOException("Missing native source manifest");
+            }
+            layers.add(layer(pack.server(), source, pack.selectedSubpack()));
+        }
+        return List.copyOf(layers);
+    }
+
+    private static boolean resource(final String path) {
+        if (path.equals("manifest.json") || path.equals("pack_manifest.json") || path.equals("sounds.json")) {
+            return true;
+        }
+        if (path.endsWith(".png") || path.endsWith(".tga") || path.endsWith(".jpg")) {
+            return true;
+        }
+        if (path.startsWith("sounds/") && (path.endsWith(".ogg") || path.endsWith(".fsb") || path.endsWith(".wav"))) {
+            return true;
+        }
+        if (path.startsWith("texts/") && path.endsWith(".lang") || path.startsWith("materials/") && path.endsWith(".material")) {
+            return true;
+        }
+        return path.endsWith(".json") && List.of("entity/", "attachables/", "models/", "animations/", "animation_controllers/",
+                "render_controllers/", "particles/", "sounds/", "textures/", "items/").stream().anyMatch(path::startsWith);
+    }
+
+    private NativeActorLibrary() {
+    }
+
+    public record Layer(boolean server, Map<String, byte[]> resources, Map<String, byte[]> sourceResources, String selectedSubpack) {
+        public Layer(final boolean server, final Map<String, byte[]> resources) {
+            this(server, resources, resources, "");
+        }
+
+        public Layer {
+            final boolean sameView = resources == sourceResources;
+            resources = Map.copyOf(resources);
+            sourceResources = sameView ? resources : Map.copyOf(sourceResources);
+        }
+
+        /**
+         * The selected-subpack view of the complete source, limited to accepted paths. It shares the source arrays,
+         * so consumers that need other files read them here instead of widening the actor view.
+         */
+        public Map<String, byte[]> selectedFiles(final Predicate<String> include) {
+            final Map<String, byte[]> result = new LinkedHashMap<>();
+            this.sourceResources.forEach((path, bytes) -> {
+                if (!path.startsWith("subpacks/") && include.test(path)) {
+                    result.put(path, bytes);
+                }
+            });
+            if (!this.selectedSubpack.isEmpty()) {
+                final String prefix = "subpacks/" + this.selectedSubpack + '/';
+                this.sourceResources.forEach((path, bytes) -> {
+                    if (path.startsWith(prefix) && include.test(path.substring(prefix.length()))) {
+                        result.put(path.substring(prefix.length()), bytes);
+                    }
+                });
+            }
+            return result;
+        }
+    }
+
+    record PackedLayer(boolean server, String selectedSubpack, byte[] archive) { }
+
+}
