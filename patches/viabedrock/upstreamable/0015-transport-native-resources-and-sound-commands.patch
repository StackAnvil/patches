+package net.raphimc.viabedrock.api.resourcepack;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Bounded RIFF/WAVE decoding to interleaved signed little-endian 16-bit PCM. */
+public final class WaveSound {
+
+    private static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_PCM_BYTES = 64 * 1024 * 1024;
+    private static final int[] IMA_STEPS = {
+        7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31,
+        34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97, 107, 118, 130, 143,
+        157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544,
+        598, 658, 724, 796, 876, 963, 1060, 1166, 1282, 1411, 1552, 1707,
+        1878, 2066, 2272, 2499, 2749, 3024, 3327, 3660, 4026, 4428, 4871,
+        5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635,
+        13899, 15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794, 32767
+    };
+
+    public static Audio read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length < 12 || bytes.length > MAX_FILE_BYTES) {
+            throw new IOException("Missing or oversized WAVE file");
+        }
+        final ByteBuffer data = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        final long end = 8 + Integer.toUnsignedLong(data.getInt(4));
+        if (data.getInt(0) != 0x46464952 || data.getInt(8) != 0x45564157 || end < 12 || end > bytes.length) {
+            throw new IOException("Invalid RIFF/WAVE header");
+        }
+        Format format = null;
+        int start = -1;
+        int size = 0;
+        long fact = -1;
+        for (int cursor = 12; cursor < end; ) {
+            if (cursor + 8L > end) {
+                throw new IOException("Truncated WAVE chunk header");
+            }
+            final int kind = data.getInt(cursor);
+            final long length = Integer.toUnsignedLong(data.getInt(cursor + 4));
+            final long next = cursor + 8L + length + (length & 1);
+            if (next > end) {
+                throw new IOException("Truncated WAVE chunk");
+            }
+            final int content = cursor + 8;
+            switch (kind) {
+                case 0x20746D66 -> {
+                    if (format != null) {
+                        throw new IOException("Duplicate WAVE format");
+                    }
+                    format = format(data, content, (int) length);
+                }
+                case 0x61746164 -> {
+                    if (start != -1) {
+                        throw new IOException("Duplicate WAVE sample data");
+                    }
+                    start = content;
+                    size = (int) length;
+                }
+                case 0x74636166 -> {
+                    if (fact != -1 || length < 4) {
+                        throw new IOException("Invalid WAVE sample count");
+                    }
