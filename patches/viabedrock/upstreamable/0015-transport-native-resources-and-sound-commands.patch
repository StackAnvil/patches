@@ -0,0 +1,181 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.content.SubpackContent;
+import net.raphimc.viabedrock.api.resourcepack.content.ZipContent;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.security.MessageDigest;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockResourcePackPayloadsTest {
+
+    @Test
+    void embedsOriginalBedrockZipsAndExposesCompleteSourcesWithoutExpandingTheActorView() throws Exception {
+        final InMemoryContent source = content(1);
+        source.putString("manifest.json", source.getString("manifest.json").replace("\"header\":", "\"subpacks\":[{\"folder_name\":\"high/nested\"}],\"header\":"));
+        source.put("future/data.custom", new byte[]{1});
+        source.put("subpacks/high/nested/future/data.custom", new byte[]{2});
+        source.put("subpacks/low/future/data.custom", new byte[]{3});
+        source.put("subpacks/high/nested/textures/selected.png", new byte[]{8});
+        source.putString("blocks.json", "{\"example:block\":{\"textures\":\"source_only\"}}");
+        final byte[] original = source.toZip();
+        final ZipContent received = new ZipContent(original);
+        final SubpackContent selected = new SubpackContent(received, "high/nested");
+        final ResourcePack pack = new ResourcePack(selected);
+        final Content exported = export(List.of(pack), pack);
+        assertFalse(exported.contains("assets/viabedrock/actor_library.bin"));
+        assertEquals(2, exported.getFilesDeep("", "").size());
+        final JsonObject index = index(exported);
+        final JsonObject entry = index.getAsJsonArray("packs").get(0).getAsJsonObject();
+        final String path = BedrockResourcePackPayloads.PAYLOAD_DIRECTORY + entry.get("sha256").getAsString() + ".mcpack";
+        assertArrayEquals(original, exported.get(path));
+        try (var zip = new ZipInputStream(new ByteArrayInputStream(exported.toZip()))) {
+            ZipEntry file;
+            boolean found = false;
+            while ((file = zip.getNextEntry()) != null) {
+                if (file.getName().equals(path)) {
+                    assertEquals(ZipEntry.STORED, file.getMethod());
+                    assertArrayEquals(original, zip.readAllBytes());
+                    found = true;
+                }
+            }
+            assertTrue(found);
+        }
+        final var layer = decode(exported).getFirst();
+        assertEquals("high/nested", layer.selectedSubpack());
+        assertArrayEquals(new byte[]{2}, layer.sourceResources().get("subpacks/high/nested/future/data.custom"));
+        assertArrayEquals(new byte[]{3}, layer.sourceResources().get("subpacks/low/future/data.custom"));
+        assertArrayEquals(new byte[]{8}, layer.resources().get("textures/selected.png"));
+        assertFalse(layer.resources().containsKey("future/data.custom"));
+        assertFalse(layer.resources().containsKey("blocks.json"));
+        final byte[] receivedBytes = original.clone();
+        original[0] ^= 1;
+        assertArrayEquals(receivedBytes, received.sourceZip());
+        received.get("future/data.custom")[0] = 4;
+        selected.put("future/data.custom", new byte[]{5});
+        final var changed = decode(export(List.of(pack), pack)).getFirst();
+        assertArrayEquals(new byte[]{4}, changed.sourceResources().get("future/data.custom"));
+        assertArrayEquals(new byte[]{5}, changed.sourceResources().get("subpacks/high/nested/future/data.custom"));
+        assertArrayEquals(new byte[]{3}, changed.sourceResources().get("subpacks/low/future/data.custom"));
+    }
+
+    @Test
+    void retainsPackOrderProvenanceAndTextureOnlyLayers() throws Exception {
+        final InMemoryContent lower = content(1);
+        final InMemoryContent upper = content(2);
+        lower.put("textures/shared.png", new byte[]{1});
+        upper.put("textures/shared.png", new byte[]{2});
+        final ResourcePack builtin = new ResourcePack(lower);
+        final ResourcePack server = new ResourcePack(upper);
+        final Content exported = export(List.of(builtin, server), server);
+        final var layers = decode(exported);
+        assertEquals(List.of(false, true), layers.stream().map(NativeActorLibrary.Layer::server).toList());
+        assertArrayEquals(new byte[]{1}, layers.get(0).resources().get("textures/shared.png"));
+        assertArrayEquals(new byte[]{2}, layers.get(1).resources().get("textures/shared.png"));
+        assertThrows(UnsupportedOperationException.class, () -> layers.get(1).sourceResources().clear());
+    }
+
+    @Test
+    void verifiesReferencedBytesBeforeCacheReuse() throws Exception {
+        final Content exported = export(List.of(new ResourcePack(content(1))), null);
+        final JsonObject index = index(exported);
+        final String path = path(index);
+        final byte[] corrupt = exported.get(path).clone();
+        corrupt[0] ^= 1;
+        assertThrows(IOException.class, () -> BedrockResourcePackPayloads.prepare(index, ignored -> new ByteArrayInputStream(corrupt)));
+        assertThrows(IOException.class, () -> BedrockResourcePackPayloads.prepare(index, ignored -> null));
+        final AtomicInteger opens = new AtomicInteger();
+        final JsonObject traversal = index.deepCopy();
+        traversal.getAsJsonArray("packs").get(0).getAsJsonObject().addProperty("sha256", "../elsewhere");
+        assertThrows(IOException.class, () -> BedrockResourcePackPayloads.prepare(traversal, ignored -> {
+            opens.incrementAndGet();
+            return new ByteArrayInputStream(exported.get(path));
+        }));
+        assertEquals(0, opens.get());
+    }
+
+    @Test
+    void rejectsMalformedMetadataAndCorruptDirectoriesEvenWhenTheirDigestMatches() throws Exception {
+        final Content exported = export(List.of(new ResourcePack(content(1))), null);
+        final JsonObject valid = index(exported);
+        for (final String field : List.of("format", "bedrock_protocol", "base_game_version")) {
+            final JsonObject invalid = valid.deepCopy();
+            invalid.addProperty(field, false);
+            assertThrows(IOException.class, () -> prepare(exported, invalid));
+        }
+        for (final String field : List.of("bytes", "server", "subpack")) {
+            final JsonObject invalid = valid.deepCopy();
+            invalid.getAsJsonArray("packs").get(0).getAsJsonObject().addProperty(field, 1.5);
+            assertThrows(IOException.class, () -> prepare(exported, invalid));
+        }
+        final byte[] original = exported.get(path(valid));
+        final byte[] count = original.clone();
+        ByteBuffer.wrap(count).order(ByteOrder.LITTLE_ENDIAN).putShort(count.length - 12, (short) 65535);
+        assertCorruptZip(valid, count);
+        final byte[] zip64 = original.clone();
+        ByteBuffer.wrap(zip64).order(ByteOrder.LITTLE_ENDIAN).putInt(zip64.length - 42, 0x07064B50);
+        assertCorruptZip(valid, zip64);
+        final byte[] ambiguous = Arrays.copyOf(original, original.length + 40);
+        final ByteBuffer fields = ByteBuffer.wrap(ambiguous).order(ByteOrder.LITTLE_ENDIAN);
+        fields.putShort(original.length - 2, (short) 40);
+        fields.putInt(original.length + 1, 0x06054B50);
+        assertCorruptZip(valid, ambiguous);
+    }
+
+    private static void assertCorruptZip(final JsonObject metadata, final byte[] bytes) throws Exception {
+        final JsonObject index = metadata.deepCopy();
+        final JsonObject pack = index.getAsJsonArray("packs").get(0).getAsJsonObject();
+        pack.addProperty("sha256", HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+        pack.addProperty("bytes", bytes.length);
+        final var prepared = BedrockResourcePackPayloads.prepare(index, ignored -> new ByteArrayInputStream(bytes));
+        assertThrows(IOException.class, () -> BedrockResourcePackPayloads.decode(prepared));
+    }
+
+    private static BedrockResourcePackPayloads.Sources prepare(final Content exported, final JsonObject index) throws Exception {
+        return BedrockResourcePackPayloads.prepare(index, sha -> new ByteArrayInputStream(exported.get(BedrockResourcePackPayloads.PAYLOAD_DIRECTORY + sha + ".mcpack")));
+    }
+
+    private static List<NativeActorLibrary.Layer> decode(final Content exported) throws Exception {
+        return BedrockResourcePackPayloads.decode(prepare(exported, index(exported)));
+    }
+
+    private static String path(final JsonObject index) {
+        return BedrockResourcePackPayloads.PAYLOAD_DIRECTORY + index.getAsJsonArray("packs").get(0).getAsJsonObject().get("sha256").getAsString() + ".mcpack";
+    }
+
+    private static JsonObject index(final Content exported) {
+        return exported.getJson("pack.mcmeta").getAsJsonObject(BedrockResourcePackPayloads.METADATA_SECTION);
+    }
+
+    private static Content export(final List<ResourcePack> packs, final ResourcePack server) throws Exception {
+        return BedrockResourcePackPayloads.export(ProtocolConstants.BEDROCK_VERSION_NAME, packs, pack -> pack == server);
+    }
+
+    private static InMemoryContent content(final long id) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"Source test\",\"uuid\":\"" + new UUID(0, id) + "\",\"version\":[1,0,0]}}");
+        return content;
+    }
+
+}
