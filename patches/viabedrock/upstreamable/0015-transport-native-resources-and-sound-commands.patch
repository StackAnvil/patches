--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeBlockView.java
@@ -0,0 +1,146 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** A client mirror of both native block layers and state properties, with no reverse Java mapping. */
+public final class NativeBlockView {
+
+    private volatile Snapshot snapshot;
+
+    public synchronized void clear() {
+        this.snapshot = null;
+    }
+
+    public boolean ready() {
+        return this.snapshot != null;
+    }
+
+    public synchronized void accept(final NativeBlockIdentifiers message) {
+        if (message instanceof NativeBlockIdentifiers.Reset reset) {
+            this.snapshot = new Snapshot(reset);
+            return;
+        }
+        final Snapshot current = this.snapshot;
+        if (current != null && message.dimension() == current.world.dimension()) {
+            if (message instanceof NativeBlockIdentifiers.Section section) {
+                final long index = (long) section.sectionY() - (current.world.minY() >> 4);
+                if (index < 0 || index >= current.world.height() >> 4) {
+                    throw new IllegalArgumentException("Native section lies outside the world");
+                }
+                final long key = key(section.chunkX(), section.chunkZ());
+                if (!current.chunks.containsKey(key) && current.chunks.size() >= 8192) {
+                    throw new IllegalArgumentException("Native block view exceeds its chunk limit");
+                }
+                final NativeBlockSection[][] previous = current.chunks.get(key);
+                final NativeBlockSection[][] layers = previous == null
+                        ? new NativeBlockSection[2][current.world.height() >> 4] : copyLayers(previous, section.layer());
+                layers[section.layer()][(int) index] = section.blocks();
+                current.chunks.put(key, layers);
+            } else if (message instanceof NativeBlockIdentifiers.Update update) {
+                final var position = update.position();
+                final var layers = current.chunks.get(key(position.x() >> 4, position.z() >> 4));
+                final int index = sectionIndex(current.world, position.y());
+                if (layers != null && index >= 0 && index < layers[update.layer()].length) {
+                    final var replacement = copyLayers(layers, update.layer());
+                    final var sections = replacement[update.layer()];
+                    final var previous = sections[index] != null ? sections[index]
+                            : new NativeBlockSection(new int[]{current.world.air()}, new long[0]);
+                    sections[index] = previous.with(NativeBlockSection.index(position.x(), position.y(), position.z()), update.state());
+                    current.chunks.put(key(position.x() >> 4, position.z() >> 4), replacement);
+                }
+            } else if (message instanceof NativeBlockIdentifiers.Dictionary dictionary) {
+                final Map<Integer, NativeBlockIdentifiers.Name> updates = new HashMap<>();
+                for (final var name : dictionary.names()) {
+                    updates.put(name.state(), name);
+                }
+                int bytes = current.dictionaryBytes;
+                int states = current.names.size();
+                for (final var name : updates.values()) {
+                    final var previous = current.names.get(name.state());
+                    bytes += name.encodedSize() - (previous == null ? 0 : previous.encodedSize());
+                    states += previous == null ? 1 : 0;
+                }
+                if (states > 1_000_000 || bytes > 64 * 1024 * 1024) {
+                    throw new IllegalArgumentException("Native block dictionary exceeds its retained limits");
+                }
+                current.names.putAll(updates);
+                current.dictionaryBytes = bytes;
+            } else if (message instanceof NativeBlockIdentifiers.Forget forget) {
+                current.chunks.remove(key(forget.chunkX(), forget.chunkZ()));
+            }
+        }
+    }
+
+    public String block(final int x, final int y, final int z) {
+        final var state = this.state(x, y, z, 0);
+        return state == null || state.identifier().isEmpty() ? null : state.identifier();
+    }
+
+    /** Returns the authoritative state, native air outside loaded data, or null before reset/for unknown IDs. */
+    public NativeBlockIdentifiers.Name state(final int x, final int y, final int z, final int layer) {
+        NativeBlockIdentifiers.layer(layer);
+        return state(this.snapshot, x, y, z, layer);
+    }
+
+    /** Java liquid state selected from native layers, -1 for no fluid, or null for unknown data. */
+    public Integer fluidJavaId(final int x, final int y, final int z) {
+        final Snapshot current = this.snapshot;
+        final var secondary = state(current, x, y, z, 1);
+        if (secondary == null || secondary.identifier().isEmpty()) {
+            return null;
+        }
+        final var selected = secondary.identifier().equals("minecraft:air") ? state(current, x, y, z, 0) : secondary;
+        return selected == null || selected.identifier().isEmpty() ? null : selected.fluidJavaId();
+    }
+
+    private static NativeBlockIdentifiers.Name state(final Snapshot current, final int x, final int y, final int z, final int layer) {
+        if (current == null) {
+            return null;
+        }
+        final var layers = current.chunks.get(key(x >> 4, z >> 4));
+        final int index = sectionIndex(current.world, y);
+        // ChunkTracker uses native air outside loaded sections and the dimension's vertical bounds.
+        if (layers == null || index < 0 || index >= layers[layer].length || layers[layer][index] == null) {
+            return current.air;
+        }
+        final int state = layers[layer][index].state(NativeBlockSection.index(x, y, z));
+        return state == current.world.air() ? current.air : current.names.get(state);
+    }
+
+    private static int sectionIndex(final NativeBlockIdentifiers.Reset world, final int y) {
+        final long offset = (long) y - world.minY();
+        return offset < 0 || offset >= world.height() ? -1 : (int) (offset >> 4);
+    }
+
+    private static NativeBlockSection[][] copyLayers(final NativeBlockSection[][] previous, final int layer) {
+        final var copy = previous.clone();
+        copy[layer] = previous[layer].clone();
+        return copy;
+    }
+
+    private static long key(final int x, final int z) {
+        return (long) x << 32 | z & 0xFFFFFFFFL;
+    }
+
+    /** Published section arrays and sections are immutable; writers replace only the changed layer. */
+    private static final class Snapshot {
+        private final NativeBlockIdentifiers.Reset world;
+        private final NativeBlockIdentifiers.Name air;
+        private final Map<Long, NativeBlockSection[][]> chunks = new ConcurrentHashMap<>();
+        private final Map<Integer, NativeBlockIdentifiers.Name> names = new ConcurrentHashMap<>();
+        private int dictionaryBytes;
+
+        private Snapshot(final NativeBlockIdentifiers.Reset world) {
+            this.world = world;
+            this.air = new NativeBlockIdentifiers.Name(world.air(), "minecraft:air", Map.of(), -1);
+        }
+    }
+
+}
