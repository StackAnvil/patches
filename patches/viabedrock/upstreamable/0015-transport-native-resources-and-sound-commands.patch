+        assertEquals(extra, view.state(-31, -63, -47, 1));
+        assertEquals(primary.identifier(), view.block(-31, -63, -47));
+        view.accept(new NativeBlockIdentifiers.Update(1, position, 1, 43));
+        assertEquals(extra, view.state(-31, -63, -47, 1));
+        view.accept(new NativeBlockIdentifiers.Forget(0, -2, -3));
+        for (int layer = 0; layer < 2; layer++) {
+            assertEquals(Integer.MIN_VALUE, view.state(-31, -63, -47, layer).state());
+        }
+        view.accept(new NativeBlockIdentifiers.Reset(1, -64, 384, 19));
+        view.accept(new NativeBlockIdentifiers.Section(1, -2, -4, -3, 1, NativeBlockSection.create(index -> 41)));
+        assertNull(view.state(-31, -63, -47, 1));
+        assertEquals(19, view.state(-31, -63, -47, 0).state());
+    }
+
+    @Test
+    void selectsTheNativeFluidLayerWithoutInferringFromTheJavaCarrier() {
+        final var view = new NativeBlockView();
+        final var position = new BlockPosition(-17, -1, -33);
+        final var definitions = List.of(
