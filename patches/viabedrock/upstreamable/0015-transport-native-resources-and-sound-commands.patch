index 0000000000000000000000000000000000000000..7cc87f22102c3c69da4a68f2215cc532969786b8
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeBlockIdentifiers.java
@@ -0,0 +1,236 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
