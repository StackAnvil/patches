+    private static void ima(final ByteBuffer data, final int start, final int size, final Format format,
+                            final int frames, final ByteBuffer pcm) throws IOException {
+        int frame = 0;
+        final int[] predictor = new int[format.channels];
+        final int[] stepIndex = new int[format.channels];
+        for (int block = start; block < start + size; block += format.block) {
+            final int end = Math.min(start + size, block + format.block);
+            for (int channel = 0; channel < format.channels; channel++) {
+                predictor[channel] = data.getShort(block + channel * 4);
+                stepIndex[channel] = Byte.toUnsignedInt(data.get(block + channel * 4 + 2));
+                if (stepIndex[channel] > 88 || data.get(block + channel * 4 + 3) != 0) {
+                    throw new IOException("Invalid WAVE IMA predictor");
+                }
+                if (frame < frames) {
+                    pcm.putShort((frame * format.channels + channel) * 2, (short) predictor[channel]);
+                }
+            }
+            frame++;
+            for (int group = block + 4 * format.channels; group < end; group += 4 * format.channels) {
+                for (int channel = 0; channel < format.channels; channel++) {
+                    for (int nibble = 0; nibble < 8; nibble++) {
+                        final int value = (Byte.toUnsignedInt(data.get(group + channel * 4 + nibble / 2)) >> ((nibble & 1) * 4)) & 15;
