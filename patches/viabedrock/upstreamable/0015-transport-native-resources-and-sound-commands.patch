+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorLibraryTest {
+
+    @Test
+    void preservesResolvedOrderProvenanceTexturesAndCompleteActorDependencies() throws Exception {
+        final InMemoryContent builtin = content(1);
+        final InMemoryContent definition = content(2);
+        final InMemoryContent overlay = content(3);
+        for (final String directory : List.of("entity", "attachables", "models/entity", "animations", "animation_controllers", "render_controllers", "particles", "sounds", "items")) {
+            definition.put(directory + "/actor.json", new byte[]{1, 2, 3});
+        }
+        definition.put("materials/actor.material", new byte[]{4});
+        definition.put("sounds/actor.fsb", new byte[]{5});
+        definition.put("texts/en_US.lang", new byte[]{6});
+        definition.put("textures/actor.png", new byte[]{7});
+        overlay.put("textures/actor.png", new byte[]{8});
+        overlay.put("textures/builtin.jpg", new byte[]{9});
+        definition.put("scripts/private.js", new byte[]{10});
+        final ResourcePack lower = new ResourcePack(builtin);
+        final ResourcePack actor = new ResourcePack(definition);
+        final ResourcePack upper = new ResourcePack(overlay);
+        final var layers = NativeActorLibrary.resources(List.of(lower, actor, upper), pack -> pack != lower);
+        assertEquals(List.of(false, true, true), layers.stream().map(NativeActorLibrary.Layer::server).toList());
+        assertEquals(1, layers.get(0).resources().size());
+        assertEquals(14, layers.get(1).resources().size());
+        assertArrayEquals(new byte[]{7}, layers.get(1).resources().get("textures/actor.png"));
+        assertArrayEquals(new byte[]{8}, layers.get(2).resources().get("textures/actor.png"));
+        assertArrayEquals(new byte[]{9}, layers.get(2).resources().get("textures/builtin.jpg"));
+        assertFalse(layers.get(1).resources().containsKey("scripts/private.js"));
+        assertThrows(UnsupportedOperationException.class, () -> layers.get(1).resources().clear());
+    }
+
+    @Test
+    void sharesEveryEffectKindWithoutShiftingEmptyAndTextureOnlyLayers() throws Exception {
+        final InMemoryContent empty = content(1);
+        final InMemoryContent definitions = content(2);
+        final InMemoryContent textures = content(3);
+        final List<String> paths = List.of("sounds.json", "sounds/sound_definitions.json", "sounds/a.ogg", "sounds/b.fsb", "sounds/c.wav",
+                "texts/en_US.lang", "particles/a.json", "render_controllers/a.json", "textures/a.png", "textures/b.tga", "other/c.png");
+        for (int index = 0; index < paths.size(); index++) {
+            definitions.put(paths.get(index), new byte[]{(byte) index, (byte) (index + 1)});
+        }
+        definitions.put("models/entity/a.json", new byte[]{42});
+        definitions.put("textures/actor.jpg", new byte[]{43});
+        definitions.put("animations/a.json", new byte[]{44});
+        textures.put("textures/a.png", new byte[]{45});
+        final List<ResourcePack> packs = List.of(new ResourcePack(empty), new ResourcePack(definitions), new ResourcePack(textures));
+        final var decoded = NativeActorLibrary.effects(NativeActorLibrary.resources(packs, pack -> pack != packs.get(0)));
+        assertEquals(3, decoded.size());
+        assertTrue(decoded.get(0).isEmpty());
+        assertEquals(paths.size(), decoded.get(1).size());
+        for (final String path : paths) {
+            assertArrayEquals(definitions.get(path), decoded.get(1).get(path));
+        }
+        assertEquals(1, decoded.get(2).size());
+        assertArrayEquals(new byte[]{45}, decoded.get(2).get("textures/a.png"));
+        assertThrows(UnsupportedOperationException.class, () -> decoded.get(1).clear());
+    }
+
+    @Test
+    void reconstructsIndependentPackStateWithoutReorderingOrLosingServerOwnership() throws Exception {
+        final InMemoryContent builtin = content(1);
+        final InMemoryContent overlay = content(2);
+        builtin.putString("entity/player.json", "{\"format_version\":\"1.10.0\",\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"textures\":{\"default\":\"textures/base\"}}}}");
+        overlay.putString("entity/player.json", "{\"format_version\":\"1.10.0\",\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"textures\":{\"default\":\"textures/upper\"}}}}");
+        final ResourcePack lower = new ResourcePack(builtin);
+        final ResourcePack upper = new ResourcePack(overlay);
+        final var layers = NativeActorLibrary.resources(List.of(lower, upper), pack -> pack == upper);
+        final var storage = ResourcePackStorage.nativeActors(layers);
+        final var packs = List.copyOf(storage.getPackStackTopToBottom());
+        assertEquals(List.of(upper.key(), lower.key()), packs.stream().map(ResourcePack::key).toList());
+        assertTrue(storage.isServerPack(packs.get(0)));
+        assertFalse(storage.isServerPack(packs.get(packs.size() - 1)));
+        assertTrue(storage.isLoadedOnJavaClient());
+        assertEquals(2, storage.getPackStackBottomToTop().size());
+        assertEquals(upper.content().getString("entity/player.json"), packs.get(0).content().getString("entity/player.json"));
+        assertEquals("textures/upper", storage.getEntities().get("minecraft:player").entityData().getTextures().get("default"));
+        final byte first = packs.get(0).content().get("entity/player.json")[0];
+        layers.get(layers.size() - 1).resources().get("entity/player.json")[0] = 0;
+        assertEquals(first, packs.get(0).content().get("entity/player.json")[0]);
+        assertThrows(IOException.class, () -> ResourcePackStorage.nativeActors(List.of(new NativeActorLibrary.Layer(true, Map.of()))));
+    }
+
+    private static InMemoryContent content(final long id) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"Actor test\",\"uuid\":\"" + new UUID(0, id) + "\",\"version\":[1,0,0]}}");
+        return content;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/SoundTranslationsTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/SoundTranslationsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..15c864914f03c3e1f57a13d17861fbe3726621ef
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/SoundTranslationsTest.java
@@ -0,0 +1,103 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.UUID;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.Callable;
+import java.util.concurrent.Executors;
+import java.util.stream.IntStream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SoundTranslationsTest {
+
+    @Test
+    void deferredLocalesKeepTheirSnapshotWhenTheInputChanges() {
+        final byte[] german = "key=original".getBytes(StandardCharsets.UTF_8);
+        final Map<String, byte[]> pack = new HashMap<>(Map.of("texts/de_DE.lang", german));
+        final var translations = new SoundTranslations(List.of(pack));
+        java.util.Arrays.fill(german, (byte) 'x');
+        pack.clear();
+        assertEquals("original", translations.translate("key", "de_DE"));
+    }
+
+    @Test
+    void concurrentLocaleChangesKeepOverridesAndEnglishFallbacksIsolated() throws Exception {
+        final var lower = new SoundTranslations(List.of(Map.of(
+                "texts/en_US.lang", "fallback=english\nkey=base".getBytes(StandardCharsets.UTF_8),
+                "texts/de_DE.lang", "key=deutsch".getBytes(StandardCharsets.UTF_8))));
+        final var upper = lower.withOverrides(List.of(Map.of(
+                "texts/fr_FR.lang", "key=français\nempty=".getBytes(StandardCharsets.UTF_8),
+                "texts/en_US.lang", "key=override".getBytes(StandardCharsets.UTF_8))));
+        try (var executor = Executors.newFixedThreadPool(4)) {
+            final var calls = IntStream.range(0, 60).mapToObj(index -> (Callable<String>) () -> switch (index % 3) {
+                case 0 -> upper.translate("key", "de_DE");
+                case 1 -> upper.translate("key", "FR_fr");
+                default -> upper.translate("key", "unknown");
+            }).toList();
+            final var results = executor.invokeAll(calls);
+            for (int index = 0; index < results.size(); index++) {
+                assertEquals(List.of("deutsch", "français", "override").get(index % 3), results.get(index).get());
+            }
+        }
+        assertEquals("english", upper.translate("fallback", "fr_FR"));
+        assertEquals("", upper.translate("empty", "fr_FR"));
+        assertEquals("base", lower.translate("key", "unknown"));
+    }
+
+    @Test
+    void resolvesLocaleOverridesAndFallbacksFromTheSharedArchive() throws Exception {
+        final var lower = new InMemoryContent();
+        final var upper = new InMemoryContent();
+        lower.putString("texts/en_US.lang", "first=base\nsecond=fallback\nempty=base\n");
+        lower.putString("texts/de_DE.lang", "first=lower\n");
+        lower.put("sounds/test.ogg", new byte[]{1});
+        upper.putString("texts/en_US.lang", "second=upper\nmissing=english\n");
+        upper.putString("texts/de_DE.lang", "## comment\nfirst=old\r\nfirst=selected=a ## note\nempty=\r\n");
+        upper.put("textures/test.png", new byte[]{2});
+        final List<ResourcePack> sources = List.of(lower, upper).stream().map(content -> {
+            content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                    + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+            return new ResourcePack(content);
+        }).toList();
+        final var exported = BedrockResourcePackPayloads.export("1.26.60", sources, ignored -> true);
+        final var accepted = BedrockResourcePackPayloads.prepare(exported.getJson("pack.mcmeta").getAsJsonObject(BedrockResourcePackPayloads.METADATA_SECTION),
+                sha -> new ByteArrayInputStream(exported.get(BedrockResourcePackPayloads.PAYLOAD_DIRECTORY + sha + ".mcpack")));
+        final var packs = NativeActorLibrary.effects(BedrockResourcePackPayloads.decode(accepted));
+        final var translations = new SoundTranslations(packs);
+        assertEquals("selected=a", translations.translate("first", "de_de"));
+        assertEquals("upper", translations.translate("second", "de_DE"));
+        assertEquals("english", translations.translate("missing", "de_de"));
+        assertEquals("", translations.translate("empty", "de_de"));
+        assertEquals("base", translations.translate("first", "unknown"));
+        assertEquals("absent", translations.translate("absent", "de_de"));
+    }
+
+    @Test
+    void overlaysReuseInheritedLocalesBeforeFallingBackToHigherEnglish() {
+        final var builtin = new SoundTranslations(List.of(Map.of(
+                "texts/de_DE.lang", "local=localized\nempty=localized\n".getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                "texts/en_US.lang", "local=english\nfallback=lower\n".getBytes(java.nio.charset.StandardCharsets.UTF_8))));
+        assertSame(builtin, builtin.withOverrides(List.of(Map.of("textures/test.png", new byte[]{1}))));
+        final var overlay = builtin.withOverrides(List.of(Map.of(
+                "texts/en_US.lang", "local=upper\nfallback=upper\n".getBytes(java.nio.charset.StandardCharsets.UTF_8),
+                "texts/de_DE.lang", "empty=\n".getBytes(java.nio.charset.StandardCharsets.UTF_8))));
+        assertEquals("localized", overlay.translate("local", "de_DE"));
+        assertEquals("upper", overlay.translate("local", "unknown"));
+        assertEquals("upper", overlay.translate("fallback", "de_de"));
+        assertEquals("", overlay.translate("empty", "de_de"));
+        assertEquals("lower", builtin.translate("fallback", "unknown"));
+        assertEquals("missing", overlay.translate("missing", "de_de"));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/WaveSoundTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/WaveSoundTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c05fd528ddd4698f786eb81cd2bc4aeae610eee9
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/WaveSoundTest.java
@@ -0,0 +1,182 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class WaveSoundTest {
+
+    @Test
+    void convertsIntegerWidthsAndInterleavedChannels() throws Exception {
+        for (final int bits : new int[]{8, 16, 24, 32}) {
+            final ByteBuffer samples = buffer(6 * bits / 8);
+            for (final int value : new int[]{Short.MIN_VALUE, -256, 0, 256, 32512, Short.MIN_VALUE}) {
+                final int encoded = bits == 8 ? (value >> 8) + 128 : value << (bits - 16);
+                for (int index = 0; index < bits / 8; index++) {
+                    samples.put((byte) (encoded >> (index * 8)));
+                }
+            }
+            final var audio = WaveSound.read(wave(format(1, 2, bits), samples.array()));
+            assertEquals(48000, audio.sampleRate());
+            assertEquals(2, audio.channels());
+            assertEquals(3, audio.frames());
+            assertArrayEquals(new short[]{Short.MIN_VALUE, -256, 0, 256, 32512, Short.MIN_VALUE}, shorts(audio.pcm()));
+        }
+    }
+
+    @Test
+    void clampsFloatingSamplesAndRejectsNonFiniteValues() throws Exception {
+        for (final int bits : new int[]{32, 64}) {
+            final ByteBuffer samples = buffer(6 * bits / 8);
+            for (final double value : new double[]{-2, -1, -0.5, 0, 0.5, 2}) {
+                if (bits == 32) {
+                    samples.putFloat((float) value);
+                } else {
+                    samples.putDouble(value);
+                }
+            }
+            assertArrayEquals(new short[]{-32768, -32768, -16384, 0, 16384, 32767},
+                    shorts(WaveSound.read(wave(format(3, 1, bits), samples.array())).pcm()));
+            for (final double value : new double[]{Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY}) {
+                if (bits == 32) {
+                    samples.putFloat(0, (float) value);
+                } else {
+                    samples.putDouble(0, value);
+                }
+                assertThrows(IOException.class, () -> WaveSound.read(wave(format(3, 1, bits), samples.array())));
+            }
+        }
+    }
+
+    @Test
+    void respectsExtensiblePrecisionAndSubtype() throws Exception {
+        final ByteBuffer format = buffer(40);
+        format.put(format(0xFFFE, 1, 24)).putShort((short) 22).putShort((short) 20).putInt(4)
+                .putInt(1).putInt(0x00100000).putLong(0x719B3800AA000080L);
+        final byte[] samples = {15, 0, (byte) 128, 15, 0, 0, (byte) 255, (byte) 255, 127};
+        assertArrayEquals(new short[]{-32768, 0, 32767}, shorts(WaveSound.read(wave(format.array(), samples)).pcm()));
+        format.putLong(32, 0);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), samples)));
+    }
+
+    @Test
+    void readsReorderedChunksAndOddMetadataWithPadding() throws Exception {
+        final byte[] data = {1, 0, 2, 0};
+        final byte[] file = chunks(chunk(0x4B4E554A, new byte[]{1}), chunk(0x61746164, data),
+                chunk(0x20746D66, format(1, 1, 16)));
+        assertArrayEquals(new short[]{1, 2}, shorts(WaveSound.read(file).pcm()));
+        for (final int size : new int[]{0, 4, 11, file.length - 1}) {
+            assertThrows(IOException.class, () -> WaveSound.read(Arrays.copyOf(file, size)));
+        }
+        buffer(file).putInt(16, Integer.MAX_VALUE);
+        assertThrows(IOException.class, () -> WaveSound.read(file));
+    }
+
+    @Test
+    void decodesStereoImaGroupsAndTrimsFinalPadding() throws Exception {
+        final ByteBuffer format = buffer(20);
+        format.put(format(17, 2, 4)).putShort((short) 2).putShort((short) 9).putShort(12, (short) 16);
+        final ByteBuffer samples = buffer(32);
+        for (int block = 0; block < 2; block++) {
+            samples.putShort((short) (1000 + block)).putShort((short) 0)
+                    .putShort((short) (-1000 - block)).putShort((short) 0)
+                    .putInt(0x11111111).putInt(0x99999999);
+        }
+        final var audio = WaveSound.read(chunks(chunk(0x20746D66, format.array()),
+                chunk(0x74636166, buffer(4).putInt(14).array()), chunk(0x61746164, samples.array())));
+        assertEquals(14, audio.frames());
+        final short[] expected = new short[28];
+        for (int frame = 0; frame < 14; frame++) {
+            final int base = frame < 9 ? 1000 : 1001;
+            final int value = base + frame % 9;
+            expected[frame * 2] = (short) value;
+            expected[frame * 2 + 1] = (short) -value;
+        }
+        assertArrayEquals(expected, shorts(audio.pcm()));
+        samples.put(2, (byte) 89);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), samples.array())));
+    }
+
+    @Test
+    void rejectsTruncatedImaGroupsAndInvalidFrameCounts() {
+        final ByteBuffer format = buffer(20);
+        format.put(format(17, 1, 4)).putShort((short) 2).putShort((short) 9).putShort(12, (short) 8);
+        for (final int size : new int[]{0, 3, 5, 7, 9}) {
+            assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), new byte[size])));
+        }
+        for (final int count : new int[]{0, 10, Integer.MAX_VALUE}) {
+            assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format.array()),
+                    chunk(0x74636166, buffer(4).putInt(count).array()), chunk(0x61746164, new byte[8]))));
+        }
+        final byte[] invalid = new byte[8];
+        invalid[3] = 1;
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format.array(), invalid)));
+    }
+
+    @Test
+    void rejectsAmbiguousLayoutsAndIncompleteFrames() {
+        final byte[] format = format(1, 2, 16);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(format, new byte[3])));
+        assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format),
+                chunk(0x20746D66, format), chunk(0x61746164, new byte[4]))));
+        assertThrows(IOException.class, () -> WaveSound.read(chunks(chunk(0x20746D66, format),
+                chunk(0x61746164, new byte[4]), chunk(0x61746164, new byte[4]))));
+        final byte[] invalidRate = format.clone();
+        buffer(invalidRate).putInt(4, -1);
+        assertThrows(IOException.class, () -> WaveSound.read(wave(invalidRate, new byte[4])));
+        for (final int offset : new int[]{0, 2, 12, 14}) {
+            final byte[] invalid = format.clone();
+            buffer(invalid).putShort(offset, (short) 65535);
+            assertThrows(IOException.class, () -> WaveSound.read(wave(invalid, new byte[4])));
+        }
+    }
+
+    private static byte[] format(final int codec, final int channels, final int bits) {
+        return buffer(16).putShort((short) codec).putShort((short) channels).putInt(48000)
+                .putInt(48000 * channels * bits / 8).putShort((short) (channels * bits / 8)).putShort((short) bits).array();
+    }
+
+    private static byte[] wave(final byte[] format, final byte[] samples) {
+        return chunks(chunk(0x20746D66, format), chunk(0x61746164, samples));
+    }
+
+    private static byte[] chunk(final int kind, final byte[] bytes) {
+        return buffer(8 + bytes.length + (bytes.length & 1)).putInt(kind).putInt(bytes.length).put(bytes).array();
+    }
+
+    private static byte[] chunks(final byte[]... chunks) {
+        final int size = Arrays.stream(chunks).mapToInt(chunk -> chunk.length).sum();
+        final ByteBuffer data = buffer(12 + size).putInt(0x46464952).putInt(4 + size).putInt(0x45564157);
+        for (final byte[] chunk : chunks) {
+            data.put(chunk);
+        }
+        return data.array();
+    }
+
+    private static short[] shorts(final byte[] bytes) {
+        final short[] samples = new short[bytes.length / 2];
+        buffer(bytes).asShortBuffer().get(samples);
+        return samples;
+    }
+
+    private static ByteBuffer buffer(final int size) {
+        return ByteBuffer.allocate(size).order(ByteOrder.LITTLE_ENDIAN);
+    }
+
+    private static ByteBuffer buffer(final byte[] bytes) {
+        return ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+    }
+
+}
