+                new NativeBlockIdentifiers.Name(6, "minecraft:air", Map.of(), -1));
+        assertNull(view.fluidJavaId(position.x(), position.y(), position.z()));
+        view.accept(new NativeBlockIdentifiers.Reset(0, -64, 384, 0));
+        view.accept(new NativeBlockIdentifiers.Dictionary(0, definitions));
+        view.accept(new NativeBlockIdentifiers.Section(0, -2, -1, -3, 0, NativeBlockSection.create(index -> 0)));
+        for (final var primary : definitions) {
+            for (final var secondary : definitions) {
+                view.accept(new NativeBlockIdentifiers.Update(0, position, 0, primary.state()));
+                view.accept(new NativeBlockIdentifiers.Update(0, position, 1, secondary.state()));
+                final var selected = secondary.identifier().equals("minecraft:air") ? primary : secondary;
+                assertEquals(selected.fluidJavaId(), view.fluidJavaId(position.x(), position.y(), position.z()));
+                assertEquals(-1, view.fluidJavaId(position.x(), -65, position.z()));
+                assertEquals(-1, view.fluidJavaId(position.x(), 320, position.z()));
+                assertEquals(-1, view.fluidJavaId(0, position.y(), 0));
+            }
+        }
+        view.accept(new NativeBlockIdentifiers.Update(0, position, 1, Integer.MIN_VALUE));
+        assertNull(view.fluidJavaId(position.x(), position.y(), position.z()));
+        view.accept(new NativeBlockIdentifiers.Dictionary(0, List.of(
+                new NativeBlockIdentifiers.Name(Integer.MIN_VALUE, "", Map.of(), -1))));
+        assertNull(view.fluidJavaId(position.x(), position.y(), position.z()));
+        view.accept(new NativeBlockIdentifiers.Forget(0, -2, -3));
+        assertEquals(-1, view.fluidJavaId(position.x(), position.y(), position.z()));
+        view.clear();
+        assertNull(view.fluidJavaId(position.x(), position.y(), position.z()));
+    }
+
+    @Test
+    void boundsDictionaryBytesAndCopiesStateProperties() {
+        final Map<String, String> properties = new HashMap<>();
+        for (int index = 0; index < 64; index++) {
+            properties.put("€".repeat(250) + index, "€".repeat(256));
+        }
+        final var name = new NativeBlockIdentifiers.Name(17, "test:block", properties, -1);
+        properties.clear();
+        assertEquals(64, name.properties().size());
+        final var buffer = Unpooled.buffer();
+        try {
+            final var accepted = new NativeBlockIdentifiers.Dictionary(0, List.of(name, name));
+            NativeBlockIdentifiers.TYPE.write(buffer, accepted);
+            assertEquals(accepted, NativeBlockIdentifiers.TYPE.read(buffer));
+            assertTrue(name.encodedSize() * 3 > NativeBlockIdentifiers.MAX_DICTIONARY_BYTES);
+            assertThrows(IllegalArgumentException.class, () -> new NativeBlockIdentifiers.Dictionary(0, List.of(name, name, name)));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 3);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(4);
+            Types.VAR_INT.writePrimitive(buffer, 0);
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            buffer.writeInt(17);
+            Types.STRING.write(buffer, "test:block");
+            buffer.writeInt(-1);
+            Types.VAR_INT.writePrimitive(buffer, 65);
+            assertThrows(IllegalArgumentException.class, () -> NativeBlockIdentifiers.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsInvalidPackedIndexesDimensionsAndUnboundedWireCounts() {
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockSection(new int[0], new long[0]));
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockSection(new int[]{1, 2}, new long[0]));
+        final long[] invalid = new long[128];
+        invalid[0] = 3;
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockSection(new int[]{1, 2, 3}, invalid));
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockIdentifiers.Reset(0, -63, 384, 0));
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockIdentifiers.Reset(0, -64, 4097, 0));
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockIdentifiers.Section(0, 0, 0, 0, 2,
+                NativeBlockSection.create(index -> 0)));
+        assertThrows(IllegalArgumentException.class, () -> new NativeBlockIdentifiers.Update(0, new BlockPosition(0, 0, 0), -1, 0));
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 3);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeBlockIdentifiers.TYPE.read(buffer));
+            buffer.clear();
+            Types.VAR_INT.writePrimitive(buffer, 3);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(1);
+            Types.VAR_INT.writePrimitive(buffer, 0);
+            buffer.writeInt(0).writeInt(0).writeInt(0).writeByte(0);
+            Types.VAR_INT.writePrimitive(buffer, 4097);
+            assertThrows(IllegalArgumentException.class, () -> NativeBlockIdentifiers.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
