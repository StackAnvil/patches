+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeSet;
+import java.util.function.Predicate;
+
+/** Bounds complete source packs and the resource views used by existing consumers. */
+final class NativeResourceArchive {
+
+    static final int MAX_PACKS = 4096;
+    static final int MAX_FILES = 32768;
+    static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    static final int MAX_TOTAL_BYTES = 256 * 1024 * 1024;
+
+    /** Bound directory metadata before ZipFile allocates its entry index. */
+    static void validateSourceDirectory(final byte[] bytes) throws IOException {
+        final ByteBuffer fields = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        int end = -1;
+        for (int offset = bytes.length - 22; offset >= Math.max(0, bytes.length - 22 - 65535); offset--) {
+            if (fields.getInt(offset) == 0x06054B50) {
+                end = offset;
+                break;
+            }
+        }
+        if (end < 0 || end + 22 + Short.toUnsignedInt(fields.getShort(end + 20)) != bytes.length) {
+            throw new IOException("Missing or ambiguous native source ZIP directory");
+        }
+        if (end >= 20 && fields.getInt(end - 20) == 0x07064B50) {
+            throw new IOException("ZIP64 native sources require an accepted snapshot");
+        }
+        final int count = Short.toUnsignedInt(fields.getShort(end + 10));
+        final long length = Integer.toUnsignedLong(fields.getInt(end + 12));
+        final long offset = Integer.toUnsignedLong(fields.getInt(end + 16));
+        if (fields.getShort(end + 4) != 0 || fields.getShort(end + 6) != 0 || Short.toUnsignedInt(fields.getShort(end + 8)) != count
+                || count > MAX_FILES || offset + length != end) {
+            throw new IOException("Unsupported or oversized native source ZIP directory");
+        }
+        int position = (int) offset;
+        int entries = 0;
+        while (position < end) {
+            if (position + 46 > end || fields.getInt(position) != 0x02014B50 || ++entries > count) {
+                throw new IOException("Invalid native source ZIP directory entry");
+            }
+            position += 46 + Short.toUnsignedInt(fields.getShort(position + 28))
+                    + Short.toUnsignedInt(fields.getShort(position + 30)) + Short.toUnsignedInt(fields.getShort(position + 32));
+        }
+        if (position != end || entries != count) {
+            throw new IOException("Mismatched native source ZIP directory");
+        }
+    }
+
+    static List<Map<String, byte[]>> select(final List<Content> packs, final Predicate<String> permitted,
+                                          final List<String> paths, final List<String> extensions) throws IOException {
+        if (packs.size() > MAX_PACKS) {
+            throw new IOException("Too many native resource packs");
+        }
+        final List<Map<String, byte[]>> selected = new ArrayList<>();
+        long total = 0;
+        int count = 0;
+        for (final Content pack : packs) {
+            final TreeSet<String> ordered = new TreeSet<>();
+            for (final String path : paths) {
+                if (pack.contains(path)) {
+                    ordered.add(path);
+                }
+            }
+            for (final String extension : extensions) {
+                for (final String path : pack.getFilesDeep("", extension)) {
+                    if (permitted.test(path)) {
+                        ordered.add(path);
+                    }
+                }
+            }
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final String path : ordered) {
+                validatePath(path, permitted);
+                final byte[] bytes = pack.get(path);
+                total += bytes.length;
+                if (++count > MAX_FILES || bytes.length > MAX_FILE_BYTES || total > MAX_TOTAL_BYTES) {
+                    throw new IOException("Native resources exceed limits");
+                }
+                files.put(path, bytes);
+            }
+            selected.add(Collections.unmodifiableMap(files));
+        }
+        return List.copyOf(selected);
+    }
+
+    static void validatePath(final String path, final Predicate<String> permitted) throws IOException {
+        if (!permitted.test(path) || path.length() > 512 || path.indexOf('\\') >= 0 || path.indexOf('\0') >= 0) {
+            throw new IOException("Invalid native resource path");
+        }
+        for (final String part : path.split("/", -1)) {
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) {
+                throw new IOException("Invalid native resource path");
+            }
+        }
+    }
+
+    private NativeResourceArchive() {
+    }
+
+}
