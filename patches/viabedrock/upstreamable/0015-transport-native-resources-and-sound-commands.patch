+
+class NativeBlockViewTest {
+
+    @Test
+    void preservesEveryCellAcrossBitWidthsAndPaletteExpansion() {
+        final Random random = new Random(2193);
+        for (final int cardinality : new int[]{1, 2, 3, 17, 257, 4096}) {
+            final int[] expected = new int[4096];
+            for (int index = 0; index < expected.length; index++) {
+                expected[index] = index % cardinality + Integer.MIN_VALUE;
+            }
+            NativeBlockSection section = NativeBlockSection.create(index -> expected[index]);
+            for (int step = 0; step < 24; step++) {
+                final int cell = random.nextInt(4096);
+                final int state = random.nextInt();
+                expected[cell] = state;
+                final NativeBlockSection old = section;
+                section = section.with(cell, state);
+                assertNotEquals(old.state(cell), section.state(cell));
+                for (int index = 0; index < expected.length; index++) {
+                    assertEquals(expected[index], section.state(index));
+                }
+            }
+            final int[] palette = section.palette();
+            final long[] data = section.data();
+            palette[0] = 0;
+            if (data.length > 0) {
+                data[0] = 0;
+            }
+            assertEquals(expected[0], section.state(0));
+        }
+    }
+
+    @Test
+    void mirrorsNegativeCoordinatesChangesUnknownStatesAndDimensionLifecycles() {
+        final NativeBlockView view = new NativeBlockView();
+        assertNull(view.block(-31, -63, -47));
+        view.accept(new NativeBlockIdentifiers.Reset(0, -64, 384, 0));
+        view.accept(new NativeBlockIdentifiers.Dictionary(0, List.of(
+                new NativeBlockIdentifiers.Name(1, "test:native_carrier_a", Map.of("variant", "a"), -1),
+                new NativeBlockIdentifiers.Name(2, "test:native_carrier_b", Map.of("variant", "b"), -1))));
+        view.accept(new NativeBlockIdentifiers.Section(0, -2, -4, -3, 0, NativeBlockSection.create(index -> 1)));
+        final BlockPosition position = new BlockPosition(-31, -63, -47);
+        view.accept(new NativeBlockIdentifiers.Update(1, position, 0, 2));
+        assertEquals("test:native_carrier_a", view.block(-31, -63, -47));
+        view.accept(new NativeBlockIdentifiers.Update(0, position, 0, 2));
+        assertEquals("test:native_carrier_b", view.block(-31, -63, -47));
+        assertEquals("test:native_carrier_a", view.block(-32, -64, -48));
+        view.accept(new NativeBlockIdentifiers.Update(0, position, 0, 3));
+        assertNull(view.block(-31, -63, -47));
+        assertEquals("minecraft:air", view.block(-31, Integer.MAX_VALUE, -47));
+        assertEquals("minecraft:air", view.block(-31, Integer.MIN_VALUE, -47));
+        view.accept(new NativeBlockIdentifiers.Forget(0, -2, -3));
+        assertEquals("minecraft:air", view.block(-31, -63, -47));
+        view.accept(new NativeBlockIdentifiers.Reset(1, 0, 256, 0));
+        view.accept(new NativeBlockIdentifiers.Section(0, -2, 0, -3, 0, NativeBlockSection.create(index -> 1)));
+        assertEquals("minecraft:air", view.block(-31, 1, -47));
+        view.accept(new NativeBlockIdentifiers.Section(1, -2, 0, -3, 0, NativeBlockSection.create(index -> 1)));
+        assertNull(view.block(-31, 1, -47));
+        view.clear();
+        assertFalse(view.ready());
+    }
+
+    @Test
+    void roundtripsAllMessagesWithoutConsumingFollowingFields() {
+        final var section = NativeBlockSection.create(index -> index * 17 - 4096);
+        final List<NativeBlockIdentifiers> messages = List.of(
+                new NativeBlockIdentifiers.Reset(0, -64, 384, 0),
+                new NativeBlockIdentifiers.Dictionary(0, List.of(new NativeBlockIdentifiers.Name(Integer.MIN_VALUE, "test:custom", Map.of("test:mode", "mixed_α"), 1234))),
+                new NativeBlockIdentifiers.Section(0, -5, -4, 7, 1, section),
+                new NativeBlockIdentifiers.Update(0, new BlockPosition(-79, -62, 115), 1, Integer.MAX_VALUE),
+                new NativeBlockIdentifiers.Forget(0, -5, 7));
+        for (final var expected : messages) {
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeBlockIdentifiers.TYPE.write(buffer, expected);
+                buffer.writeInt(0x78563412);
+                final var actual = NativeBlockIdentifiers.TYPE.read(buffer);
+                if (expected instanceof NativeBlockIdentifiers.Section left) {
+                    final var right = (NativeBlockIdentifiers.Section) actual;
+                    assertEquals(left.chunkX(), right.chunkX());
+                    assertEquals(left.sectionY(), right.sectionY());
+                    assertEquals(left.chunkZ(), right.chunkZ());
+                    assertEquals(left.layer(), right.layer());
+                    assertArrayEquals(left.blocks().palette(), right.blocks().palette());
+                    assertArrayEquals(left.blocks().data(), right.blocks().data());
+                } else {
+                    assertEquals(expected, actual);
+                }
+                assertEquals(0x78563412, buffer.readInt());
+                assertEquals(0, buffer.readableBytes());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
