+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.chunks.PaletteType;
+import net.raphimc.viabedrock.api.chunk.datapalette.BedrockDataPalette;
+import net.raphimc.viabedrock.api.chunk.section.BedrockChunkSectionImpl;
+import net.raphimc.viabedrock.api.model.NativeBlockSection;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class NativeBlockSectionTest {
+
+    @Test
+    void samplesEveryNativeCoordinateFromBothLayers() {
+        final var section = new BedrockChunkSectionImpl();
+        final var primary = new BedrockDataPalette();
+        primary.addId(0);
+        final var secondary = new BedrockDataPalette();
+        secondary.addId(17);
+        section.addPalette(PaletteType.BLOCKS, primary);
+        section.addPalette(PaletteType.BLOCKS, secondary);
+        for (int y = 0; y < 16; y++) {
+            for (int z = 0; z < 16; z++) {
+                for (int x = 0; x < 16; x++) {
+                    primary.setIdAt(x, y, z, x * 10000 + y * 100 + z);
+                    secondary.setIdAt(x, y, z, -(z * 10000 + x * 100 + y));
+                }
+            }
+        }
+        for (int layer = 0; layer < 2; layer++) {
+            final var blocks = ChunkTracker.nativeBlockSection(section, 23, layer);
+            final var expected = layer == 0 ? primary : secondary;
+            for (int y = 0; y < 16; y++) {
+                for (int z = 0; z < 16; z++) {
+                    for (int x = 0; x < 16; x++) {
+                        assertEquals(expected.idAt(x, y, z), blocks.state(NativeBlockSection.index(x, y, z)));
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void retainsNativeAirForMissingSectionsAndPalettes() {
+        for (final var section : new BedrockChunkSectionImpl[]{null, new BedrockChunkSectionImpl()}) {
+            for (int layer = 0; layer < 2; layer++) {
+                final var blocks = ChunkTracker.nativeBlockSection(section, 23, layer);
+                assertEquals(23, blocks.state(0));
+                assertEquals(23, blocks.state(4095));
+                assertEquals(0, blocks.data().length);
+            }
+        }
+    }
+
+}
