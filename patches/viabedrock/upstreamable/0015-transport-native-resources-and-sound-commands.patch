+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Ordered authoritative block identity snapshots and changes for native client effects. */
+public sealed interface NativeBlockIdentifiers permits NativeBlockIdentifiers.Reset, NativeBlockIdentifiers.Section,
+        NativeBlockIdentifiers.Update, NativeBlockIdentifiers.Dictionary, NativeBlockIdentifiers.Forget {
+
+    String CHANNEL = "viabedrock:block_identifiers_v3";
+    int MAX_DICTIONARY_BYTES = 256 * 1024;
+    Type<NativeBlockIdentifiers> TYPE = new Type<>(NativeBlockIdentifiers.class) {
+        @Override
+        public NativeBlockIdentifiers read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 3
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native block identity message");
+            }
+            final int kind = buffer.readUnsignedByte();
+            final int dimension = Types.VAR_INT.readPrimitive(buffer);
+            return switch (kind) {
+                case 0 -> new Reset(dimension, buffer.readInt(), buffer.readInt(), buffer.readInt());
+                case 1 -> {
+                    final int x = buffer.readInt();
+                    final int y = buffer.readInt();
+                    final int z = buffer.readInt();
+                    final int layer = layer(buffer.readUnsignedByte());
+                    final int count = Types.VAR_INT.readPrimitive(buffer);
+                    if (count <= 0 || count > NativeBlockSection.CELLS) {
+                        throw new IllegalArgumentException("Invalid native block palette count");
+                    }
+                    final int[] palette = new int[count];
+                    for (int index = 0; index < count; index++) {
+                        palette[index] = buffer.readInt();
+                    }
+                    final int length = Types.VAR_INT.readPrimitive(buffer);
+                    if (length < 0 || length > 768) {
+                        throw new IllegalArgumentException("Invalid native block data size");
+                    }
+                    final long[] data = new long[length];
+                    for (int index = 0; index < length; index++) {
+                        data[index] = buffer.readLong();
+                    }
+                    yield new Section(dimension, x, y, z, layer, new NativeBlockSection(palette, data));
+                }
+                case 2 -> new Update(dimension, new BlockPosition(buffer.readInt(), buffer.readInt(), buffer.readInt()),
+                        layer(buffer.readUnsignedByte()), buffer.readInt());
+                case 3 -> new Forget(dimension, buffer.readInt(), buffer.readInt());
+                case 4 -> {
+                    final int count = Types.VAR_INT.readPrimitive(buffer);
+                    if (count < 0 || count > 256) {
+                        throw new IllegalArgumentException("Invalid native block dictionary size");
+                    }
+                    final List<Name> names = new ArrayList<>();
+                    final int start = buffer.readerIndex();
+                    for (int index = 0; index < count; index++) {
+                        final int state = buffer.readInt();
+                        final String identifier = text(buffer);
+                        final int fluidJavaId = buffer.readInt();
+                        final int propertyCount = Types.VAR_INT.readPrimitive(buffer);
+                        if (propertyCount < 0 || propertyCount > 64) {
+                            throw new IllegalArgumentException("Invalid native block property count");
+                        }
+                        final Map<String, String> properties = new HashMap<>();
+                        for (int property = 0; property < propertyCount; property++) {
+                            final String key = text(buffer);
+                            if (properties.put(key, text(buffer)) != null) {
+                                throw new IllegalArgumentException("Duplicate native block property");
+                            }
+                        }
+                        names.add(new Name(state, identifier, properties, fluidJavaId));
+                        if (buffer.readerIndex() - start > MAX_DICTIONARY_BYTES) {
+                            throw new IllegalArgumentException("Native block dictionary exceeds its byte limit");
+                        }
+                    }
+                    yield new Dictionary(dimension, names);
+                }
+                default -> throw new IllegalArgumentException("Unknown native block identity message");
+            };
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeBlockIdentifiers value) {
+            Types.VAR_INT.writePrimitive(buffer, 3);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(value instanceof Reset ? 0 : value instanceof Section ? 1 : value instanceof Update ? 2 : value instanceof Forget ? 3 : 4);
+            Types.VAR_INT.writePrimitive(buffer, value.dimension());
+            if (value instanceof Reset reset) {
+                buffer.writeInt(reset.minY()).writeInt(reset.height()).writeInt(reset.air());
+            } else if (value instanceof Section section) {
+                buffer.writeInt(section.chunkX()).writeInt(section.sectionY()).writeInt(section.chunkZ());
+                buffer.writeByte(section.layer());
+                final int[] palette = section.blocks().palette();
+                Types.VAR_INT.writePrimitive(buffer, palette.length);
+                for (final int state : palette) {
+                    buffer.writeInt(state);
+                }
+                final long[] data = section.blocks().data();
+                Types.VAR_INT.writePrimitive(buffer, data.length);
+                for (final long word : data) {
+                    buffer.writeLong(word);
+                }
+            } else if (value instanceof Update update) {
+                buffer.writeInt(update.position().x()).writeInt(update.position().y()).writeInt(update.position().z());
+                buffer.writeByte(update.layer());
+                buffer.writeInt(update.state());
+            } else if (value instanceof Forget forget) {
+                buffer.writeInt(forget.chunkX()).writeInt(forget.chunkZ());
+            } else if (value instanceof Dictionary dictionary) {
+                Types.VAR_INT.writePrimitive(buffer, dictionary.names().size());
+                for (final Name name : dictionary.names()) {
+                    buffer.writeInt(name.state());
+                    Types.STRING.write(buffer, name.identifier());
+                    buffer.writeInt(name.fluidJavaId());
+                    Types.VAR_INT.writePrimitive(buffer, name.properties().size());
+                    for (final var property : name.properties().entrySet()) {
+                        Types.STRING.write(buffer, property.getKey());
+                        Types.STRING.write(buffer, property.getValue());
+                    }
+                }
+            }
+        }
+    };
+
+    int dimension();
+
+    static int layer(final int layer) {
+        if (layer < 0 || layer > 1) {
+            throw new IllegalArgumentException("Invalid native block layer");
+        }
+        return layer;
+    }
+
+    private static String text(final ByteBuf buffer) {
+        final int bytes = Types.VAR_INT.readPrimitive(buffer);
+        if (bytes < 0 || bytes > 1024 || bytes > buffer.readableBytes()) {
+            throw new IllegalArgumentException("Invalid native block text size");
+        }
+        final String value = buffer.readCharSequence(bytes, StandardCharsets.UTF_8).toString();
+        checkText(value);
+        return value;
+    }
+
+    private static void checkText(final String value) {
+        if (value.length() > 256) {
+            throw new IllegalArgumentException("Native block text exceeds limits");
+        }
+    }
+
+    private static int textSize(final String value) {
+        final int bytes = value.getBytes(StandardCharsets.UTF_8).length;
+        return varIntSize(bytes) + bytes;
+    }
+
+    private static int varIntSize(final int value) {
+        return value < 128 ? 1 : 2;
+    }
+
+    record Reset(int dimension, int minY, int height, int air) implements NativeBlockIdentifiers {
+        public Reset {
+            if ((minY & 15) != 0 || height <= 0 || height > 4096 || (height & 15) != 0
+                    || (long) minY + height > Integer.MAX_VALUE) {
+                throw new IllegalArgumentException("Invalid native block world height");
+            }
+        }
+    }
+
+    record Section(int dimension, int chunkX, int sectionY, int chunkZ, int layer, NativeBlockSection blocks) implements NativeBlockIdentifiers {
+        public Section {
+            NativeBlockIdentifiers.layer(layer);
+            java.util.Objects.requireNonNull(blocks);
+        }
+    }
+
+    record Update(int dimension, BlockPosition position, int layer, int state) implements NativeBlockIdentifiers {
+        public Update {
+            NativeBlockIdentifiers.layer(layer);
+            java.util.Objects.requireNonNull(position);
+        }
+    }
+
+    record Name(int state, String identifier, Map<String, String> properties, int fluidJavaId) {
+        public Name {
+            checkText(identifier);
+            if (fluidJavaId < -1) {
+                throw new IllegalArgumentException("Invalid native fluid Java state");
+            }
+            properties = Map.copyOf(properties);
+            if (properties.size() > 64) {
+                throw new IllegalArgumentException("Native block properties exceed limits");
+            }
+            properties.forEach((key, value) -> {
+                checkText(key);
+                checkText(value);
+            });
+        }
+
+        public int encodedSize() {
+            int size = 8 + textSize(this.identifier) + varIntSize(this.properties.size());
+            for (final var property : this.properties.entrySet()) {
+                size += textSize(property.getKey()) + textSize(property.getValue());
+            }
+            return size;
+        }
+    }
+
+    record Dictionary(int dimension, List<Name> names) implements NativeBlockIdentifiers {
+        public Dictionary {
+            names = List.copyOf(names);
+            if (names.size() > 256) {
+                throw new IllegalArgumentException("Native block dictionary exceeds limits");
+            }
+            if (names.stream().mapToInt(Name::encodedSize).sum() > MAX_DICTIONARY_BYTES) {
+                throw new IllegalArgumentException("Native block dictionary exceeds its byte limit");
+            }
+        }
+    }
+
+    record Forget(int dimension, int chunkX, int chunkZ) implements NativeBlockIdentifiers {
+    }
+
+}
