@@ -0,0 +1,85 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Pack-ordered caption translations with English fallback and case-independent locale codes. */
+public final class SoundTranslations {
+
+    private final Map<String, List<byte[]>> sources;
+    private final Map<String, Map<String, String>> languages = new ConcurrentHashMap<>();
+    private final SoundTranslations inherited;
+
+    public SoundTranslations(final List<Map<String, byte[]>> packs) {
+        this(null, packs);
+    }
+
+    private SoundTranslations(final SoundTranslations inherited, final List<Map<String, byte[]>> packs) {
+        this.inherited = inherited;
+        final Map<String, List<byte[]>> sources = new HashMap<>();
+        for (final Map<String, byte[]> pack : packs) {
+            for (final Map.Entry<String, byte[]> entry : pack.entrySet()) {
+                final String path = entry.getKey();
+                if (!path.startsWith("texts/") || !path.endsWith(".lang") || path.indexOf('/', 6) >= 0) {
+                    continue;
+                }
+                sources.computeIfAbsent(path.substring(6, path.length() - 5).toLowerCase(Locale.ROOT),
+                        ignored -> new ArrayList<>()).add(entry.getValue().clone());
+            }
+        }
+        sources.replaceAll((locale, files) -> List.copyOf(files));
+        this.sources = Map.copyOf(sources);
+    }
+
+    public SoundTranslations withOverrides(final List<Map<String, byte[]>> packs) {
+        final boolean hasLanguages = packs.stream().flatMap(pack -> pack.keySet().stream())
+                .anyMatch(path -> path.startsWith("texts/") && path.endsWith(".lang") && path.indexOf('/', 6) < 0);
+        return hasLanguages ? new SoundTranslations(this, packs) : this;
+    }
+
+    public String translate(final String key, final String locale) {
+        final String selected = this.lookup(key, locale.toLowerCase(Locale.ROOT));
+        if (selected != null) {
+            return selected;
+        }
+        final String english = this.lookup(key, "en_us");
+        return english == null ? key : english;
+    }
+
+    private String lookup(final String key, final String locale) {
+        // Cache only locales present in this snapshot, never arbitrary client locale strings.
+        final String translated = this.sources.containsKey(locale)
+                ? this.languages.computeIfAbsent(locale, this::readLanguage).get(key) : null;
+        return translated != null || this.inherited == null ? translated : this.inherited.lookup(key, locale);
+    }
+
+    private Map<String, String> readLanguage(final String locale) {
+        final Map<String, String> translations = new HashMap<>();
+        for (final byte[] bytes : this.sources.get(locale)) {
+            for (final String rawLine : new String(bytes, StandardCharsets.UTF_8).split("\n")) {
+                String line = rawLine;
+                final int comment = line.indexOf("##");
+                if (comment >= 0) {
+                    line = line.substring(0, comment);
+                }
+                line = line.trim();
+                final int separator = line.indexOf('=');
+                if (separator > 0) {
+                    translations.put(line.substring(0, separator), line.substring(separator + 1));
+                }
+            }
+        }
+        return Map.copyOf(translations);
+    }
+
+}
