+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.fastutil.ints.Int2IntOpenHashMap;
+
+import java.util.Arrays;
+import java.util.function.IntUnaryOperator;
+
+/** Native layer identities retain distinctions lost by the Java block mapping. */
+public final class NativeBlockSection {
+
+    public static final int CELLS = 4096;
+    private final int[] palette;
+    private final long[] data;
+    private final int bits;
+
+    public NativeBlockSection(final int[] palette, final long[] data) {
+        if (palette.length == 0 || palette.length > CELLS) {
+            throw new IllegalArgumentException("Invalid native block palette size");
+        }
+        this.palette = palette.clone();
+        this.bits = bits(palette.length);
+        if (data.length != CELLS * this.bits / 64) {
+            throw new IllegalArgumentException("Invalid native block data length");
+        }
+        this.data = data.clone();
+        for (int index = 0; this.bits != 0 && index < CELLS; index++) {
+            if (this.paletteIndex(index) >= palette.length) {
+                throw new IllegalArgumentException("Native block palette index out of bounds");
+            }
+        }
+    }
+
+    public static NativeBlockSection create(final IntUnaryOperator identifiers) {
+        final int[] palette = new int[CELLS];
+        final Int2IntOpenHashMap indexes = new Int2IntOpenHashMap();
+        indexes.defaultReturnValue(-1);
+        final int[] cells = new int[CELLS];
+        for (int index = 0; index < CELLS; index++) {
+            final int value = identifiers.applyAsInt(index);
+            int paletteIndex = indexes.get(value);
+            if (paletteIndex == -1) {
+                paletteIndex = indexes.size();
+                indexes.put(value, paletteIndex);
+                palette[paletteIndex] = value;
+            }
+            cells[index] = paletteIndex;
+        }
+        return packed(Arrays.copyOf(palette, indexes.size()), index -> cells[index]);
+    }
+
+    public NativeBlockSection with(final int index, final int state) {
+        checkIndex(index);
+        if (this.state(index) == state) {
+            return this;
+        }
+        for (int existing = 0; existing < this.palette.length; existing++) {
+            if (this.palette[existing] == state) {
+                final long[] changed = this.data.clone();
+                put(changed, this.bits, index, existing);
+                return new NativeBlockSection(this.palette, changed);
+            }
+        }
+        // Discard unused states if all 4096 palette slots have already been used.
+        if (this.palette.length == CELLS) {
+            return create(cell -> cell == index ? state : this.state(cell));
+        }
+        final int[] expanded = Arrays.copyOf(this.palette, this.palette.length + 1);
+        final int added = expanded.length - 1;
+        expanded[added] = state;
+        return packed(expanded, cell -> cell == index ? added : this.paletteIndex(cell));
+    }
+
+    public int state(final int index) {
+        checkIndex(index);
+        return this.palette[this.paletteIndex(index)];
+    }
+
+    public int[] palette() {
+        return this.palette.clone();
+    }
+
+    public long[] data() {
+        return this.data.clone();
+    }
+
+    public static int index(final int x, final int y, final int z) {
+        return (y & 15) << 8 | (z & 15) << 4 | x & 15;
+    }
+
+    private static NativeBlockSection packed(final int[] palette, final IntUnaryOperator indexes) {
+        final int bits = bits(palette.length);
+        final long[] data = new long[CELLS * bits / 64];
+        for (int index = 0; index < CELLS; index++) {
+            put(data, bits, index, indexes.applyAsInt(index));
+        }
+        return new NativeBlockSection(palette, data);
+    }
+
+    private int paletteIndex(final int index) {
+        if (this.bits == 0) {
+            return 0;
+        }
+        final int offset = index * this.bits;
+        final int word = offset >>> 6;
+        final int shift = offset & 63;
+        long value = this.data[word] >>> shift;
+        if (shift + this.bits > 64) {
+            value |= this.data[word + 1] << (64 - shift);
+        }
+        return (int) (value & (1L << this.bits) - 1);
+    }
+
+    private static void put(final long[] data, final int bits, final int index, final int value) {
+        if (bits == 0) {
+            return;
+        }
+        final int offset = index * bits;
+        final int word = offset >>> 6;
+        final int shift = offset & 63;
+        final long mask = (1L << bits) - 1;
+        data[word] = data[word] & ~(mask << shift) | (long) value << shift;
+        if (shift + bits > 64) {
+            final int remainder = shift + bits - 64;
+            data[word + 1] = data[word + 1] & ~((1L << remainder) - 1) | (long) value >>> (64 - shift);
+        }
+    }
+
+    private static int bits(final int count) {
+        return count == 1 ? 0 : 32 - Integer.numberOfLeadingZeros(count - 1);
+    }
+
+    private static void checkIndex(final int index) {
+        if (index < 0 || index >= CELLS) {
+            throw new IndexOutOfBoundsException(index);
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/NativeBlockView.java b/src/main/java/net/raphimc/viabedrock/api/model/NativeBlockView.java
