+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.api.parallel.Isolated;
+
+import javax.imageio.ImageIO;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFileAttributeView;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Base64;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+@Isolated("Changes ImageIO's disk-cache policy to exercise an unavailable cache")
+class ContentImageCacheTest {
+
+    @TempDir
+    Path directory;
+
+    @Test
+    void readsAndWritesResourcePixelsWhenTheImageIoDiskCacheIsUnwritable() throws Exception {
+        assumeTrue(Files.getFileStore(this.directory).supportsFileAttributeView(PosixFileAttributeView.class));
+        final Path cache = Files.createDirectory(this.directory.resolve("image-cache"));
+        final boolean previousPolicy = ImageIO.getUseCache();
+        final var previousDirectory = ImageIO.getCacheDirectory();
+        final byte[] png = Base64.getDecoder().decode("iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAEUlEQVR4nGMUWm3yP2XlvwYAEYkEfZ7zExIAAAAASUVORK5CYII=");
+        try {
+            ImageIO.setCacheDirectory(cache.toFile());
+            ImageIO.setUseCache(true);
+            Files.setPosixFilePermissions(cache, PosixFilePermissions.fromString("r-x------"));
+            final var content = new InMemoryContent();
+            content.put("texture.png", png);
+            final var image = content.getImage("texture.png").getImage();
+            assertNotNull(image);
+            assertEquals(0xFF12AB34, image.getRGB(0, 0));
+            assertEquals(0x7F765432, image.getRGB(1, 0));
+            content.putPngImage("copy.png", image);
+            final var copy = new Content.LazyImage(content.getImage("copy.png").getPngBytes(true), "png").getImage();
+            assertEquals(0xFF12AB34, copy.getRGB(0, 0));
+            assertEquals(0x7F765432, copy.getRGB(1, 0));
+            assertTrue(ImageIO.getUseCache());
+            assertEquals(cache.toFile(), ImageIO.getCacheDirectory());
+        } finally {
+            ImageIO.setCacheDirectory(previousDirectory);
+            ImageIO.setUseCache(previousPolicy);
+            Files.setPosixFilePermissions(cache, PosixFilePermissions.fromString("rwx------"));
+        }
+    }
+
+}
