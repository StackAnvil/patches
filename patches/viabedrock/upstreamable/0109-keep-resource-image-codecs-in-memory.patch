From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:20:17 +0100
Subject: [PATCH] fix(resources): keep resource image codecs in memory

Resource image bytes already reside in memory, but the ImageIO stream convenience methods can spool them to temporary files. An unavailable cache can prevent the bundled default skin from decoding and abort login, or stop PNG export.

Use memory-backed input and output streams for Content images without changing global ImageIO cache settings. Respect ImageIO input ownership and retain the original PNG passthrough. Test pixel decoding and both PNG export paths with an unwritable disk cache.

diff --git a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java
index 622e99d2e97a8c62883d5333a26fd368ae333bfe..e63777a30940cf189dee7dd2743ebe6c31018356 100644
--- a/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/Content.java
@@ -22,6 +22,8 @@ import com.viaversion.viaversion.util.GsonUtil;
 import net.raphimc.viabedrock.api.util.JsonUtil;
 
 import javax.imageio.ImageIO;
+import javax.imageio.stream.MemoryCacheImageInputStream;
+import javax.imageio.stream.MemoryCacheImageOutputStream;
 import java.awt.image.BufferedImage;
 import java.io.ByteArrayInputStream;
 import java.io.ByteArrayOutputStream;
@@ -142,8 +144,8 @@ public abstract class Content {
 
     public boolean putPngImage(final String path, final BufferedImage image) {
         final ByteArrayOutputStream baos = new ByteArrayOutputStream();
-        try {
-            ImageIO.write(image, "png", baos);
+        try (var output = new MemoryCacheImageOutputStream(baos)) {
+            ImageIO.write(image, "png", output);
         } catch (final IOException e) {
             throw new UncheckedIOException(e);
         }
@@ -189,7 +191,12 @@ public abstract class Content {
         public BufferedImage getImage() {
             if (this.image == null) {
                 try {
-                    this.image = ImageIO.read(new ByteArrayInputStream(this.bytes));
+                    final var input = new MemoryCacheImageInputStream(new ByteArrayInputStream(this.bytes));
+                    this.image = ImageIO.read(input);
+                    // ImageIO closes the stream when it selects a reader, but leaves unmatched input open.
+                    if (this.image == null) {
+                        input.close();
+                    }
                 } catch (final IOException e) {
                     throw new RuntimeException(e);
                 }
@@ -207,8 +214,8 @@ public abstract class Content {
             } else {
                 final BufferedImage image = this.getImage();
                 final ByteArrayOutputStream baos = new ByteArrayOutputStream();
-                try {
-                    ImageIO.write(image, "png", baos);
+                try (var output = new MemoryCacheImageOutputStream(baos)) {
+                    ImageIO.write(image, "png", output);
                 } catch (final IOException e) {
                     throw new RuntimeException(e);
                 }
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/ContentImageCacheTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/ContentImageCacheTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..5b14f400b931b6cae62323fd93f9aed0b01c5cfd
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/ContentImageCacheTest.java
@@ -0,0 +1,58 @@
