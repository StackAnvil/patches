+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.api.parallel.Isolated;
+
+import javax.imageio.ImageIO;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFileAttributeView;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Base64;
+import java.util.zip.CRC32;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+@Isolated("Changes ImageIO's disk-cache policy to exercise an unavailable cache")
+class ContentImageCacheTest {
+
+    @TempDir
+    Path directory;
+
+    @Test
+    void readsAndWritesResourcePixelsWhenTheImageIoDiskCacheIsUnwritable() throws Exception {
+        assumeTrue(Files.getFileStore(this.directory).supportsFileAttributeView(PosixFileAttributeView.class));
+        final Path cache = Files.createDirectory(this.directory.resolve("image-cache"));
+        final boolean previousPolicy = ImageIO.getUseCache();
+        final var previousDirectory = ImageIO.getCacheDirectory();
+        final byte[] png = Base64.getDecoder().decode("iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAEUlEQVR4nGMUWm3yP2XlvwYAEYkEfZ7zExIAAAAASUVORK5CYII=");
+        try {
+            ImageIO.setCacheDirectory(cache.toFile());
+            ImageIO.setUseCache(true);
+            Files.setPosixFilePermissions(cache, PosixFilePermissions.fromString("r-x------"));
+            final var content = new InMemoryContent();
+            content.put("texture.png", png);
+            final var image = content.getImage("texture.png").getImage();
+            assertNotNull(image);
+            assertEquals(0xFF12AB34, image.getRGB(0, 0));
+            assertEquals(0x7F765432, image.getRGB(1, 0));
+            content.putPngImage("copy.png", image);
+            final var copy = new Content.LazyImage(content.getImage("copy.png").getPngBytes(true), "png").getImage();
+            assertEquals(0xFF12AB34, copy.getRGB(0, 0));
+            assertEquals(0x7F765432, copy.getRGB(1, 0));
+            assertTrue(ImageIO.getUseCache());
+            assertEquals(cache.toFile(), ImageIO.getCacheDirectory());
+        } finally {
+            ImageIO.setCacheDirectory(previousDirectory);
+            ImageIO.setUseCache(previousPolicy);
+            Files.setPosixFilePermissions(cache, PosixFilePermissions.fromString("rwx------"));
+        }
+    }
+
+    @Test
+    void rejectsImageHeadersDeclaringMorePixelsThanJavaArraysHoldBeforeAllocating() {
+        final var content = new InMemoryContent();
+        content.put("oversized.png", pngHeader(23171, 23171));
+        content.put("bounded.png", pngHeader(1024, 1024));
+        assertThrows(IllegalArgumentException.class, () -> content.getImage("oversized.png").getImage());
+        // The bounded header passes the limit and fails only on its missing pixel data, which leaves no image.
+        assertNull(content.getImage("bounded.png").getImage());
+    }
+
+    @Test
+    void decodingLimitScalesWithTheHeapAndAccepts8192PixelTexturesOnA2GibHeap() {
+        final long heap = 2L << 30;
+        assertDoesNotThrow(() -> ImageDecodingLimit.require(8192, 8192, heap));
+        assertThrows(IllegalArgumentException.class, () -> ImageDecodingLimit.require(8192, 8193, heap));
+        assertDoesNotThrow(() -> ImageDecodingLimit.require(16384, 16384, 8L << 30));
+        assertThrows(IllegalArgumentException.class, () -> ImageDecodingLimit.require(23171, 23171, Long.MAX_VALUE));
+    }
+
+    private static byte[] pngHeader(final int width, final int height) {
+        final ByteBuffer png = ByteBuffer.allocate(8 + 25 + 12);
+        png.put(new byte[]{(byte) 0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'});
+        chunk(png, "IHDR", ByteBuffer.allocate(13).putInt(width).putInt(height).put(new byte[]{8, 6, 0, 0, 0}).array());
+        chunk(png, "IEND", new byte[0]);
+        return png.array();
+    }
+
+    private static void chunk(final ByteBuffer png, final String type, final byte[] data) {
+        final CRC32 crc = new CRC32();
+        crc.update(type.getBytes(StandardCharsets.US_ASCII));
+        crc.update(data);
+        png.putInt(data.length).put(type.getBytes(StandardCharsets.US_ASCII)).put(data).putInt((int) crc.getValue());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/PngZlibChecksumTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/PngZlibChecksumTest.java
