+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.util.Arrays;
+import java.util.zip.Adler32;
+import java.util.zip.CRC32;
+import java.util.zip.DataFormatException;
+import java.util.zip.Inflater;
+
+/**
+ * Recomputes the zlib Adler-32 trailer of PNG image data. libpng reports a checksum error after the last row only as a
+ * benign warning, and stb_image does not check it, so Bedrock and Java clients load such textures while ImageIO rejects
+ * them.
+ */
+final class PngZlibChecksum {
+
+    private static final byte[] SIGNATURE = {(byte) 0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+    private static final int IHDR = 0x49484452;
+    private static final int IDAT = 0x49444154;
+    private static final int IEND = 0x49454E44;
+
+    private PngZlibChecksum() {
+    }
+
+    /**
+     * Returns the PNG with one IDAT chunk whose zlib trailer matches the inflated data, or null when the image data has
+     * a defect other than a wrong checksum.
+     */
+    static byte[] repair(final byte[] png) {
+        if (png.length < SIGNATURE.length || !Arrays.equals(png, 0, SIGNATURE.length, SIGNATURE, 0, SIGNATURE.length)) {
+            return null;
+        }
+        final ByteBuffer buffer = ByteBuffer.wrap(png);
+        buffer.position(SIGNATURE.length);
+        final ByteArrayOutputStream zlib = new ByteArrayOutputStream();
+        long maxRawBytes = -1;
+        int firstIdat = -1;
+        int afterIdat = -1;
+        while (buffer.remaining() >= 12) {
+            final int start = buffer.position();
+            final int length = buffer.getInt();
+            final int type = buffer.getInt();
+            if (length < 0 || length > buffer.remaining() - 4) {
+                return null;
+            }
+            if (type == IHDR && length >= 13) {
+                final long width = Integer.toUnsignedLong(buffer.getInt(start + 8));
+                final long height = Integer.toUnsignedLong(buffer.getInt(start + 12));
+                ImageDecodingLimit.require(width, height);
+                // Up to eight bytes per pixel, one filter byte per row, and at most twice the rows when interlaced.
+                maxRawBytes = height * (width * 8 + 2) + 8;
+            } else if (type == IDAT) {
+                if (maxRawBytes < 0 || (firstIdat >= 0 && afterIdat != start)) {
+                    return null;
+                }
+                if (firstIdat < 0) {
+                    firstIdat = start;
+                }
+                zlib.write(png, start + 8, length);
+                afterIdat = start + 12 + length;
+            }
+            buffer.position(start + 12 + length);
+            if (type == IEND) {
+                break;
+            }
+        }
+        if (firstIdat < 0) {
+            return null;
+        }
+
+        final byte[] stream = zlib.toByteArray();
+        if (stream.length < 6 || (stream[0] & 0x0F) != 8 || (stream[1] & 0x20) != 0 || (((stream[0] & 0xFF) << 8) | (stream[1] & 0xFF)) % 31 != 0) {
+            return null;
+        }
+        final Adler32 adler = new Adler32();
+        final long end;
+        final Inflater inflater = new Inflater(true);
+        try {
+            inflater.setInput(stream, 2, stream.length - 2);
+            final byte[] chunk = new byte[64 * 1024];
+            long total = 0;
+            while (!inflater.finished()) {
+                final int read = inflater.inflate(chunk);
+                if (read == 0 && !inflater.finished()) {
+                    return null;
+                }
+                total += read;
+                if (total > maxRawBytes) {
+                    return null;
+                }
+                adler.update(chunk, 0, read);
+            }
+            end = 2 + inflater.getBytesRead();
+        } catch (final DataFormatException e) {
+            return null;
+        } finally {
+            inflater.end();
+        }
+        if (end + 4 > stream.length) {
+            return null;
+        }
+        final int checksum = (int) adler.getValue();
+        if (ByteBuffer.wrap(stream, (int) end, 4).getInt() == checksum) {
+            return null;
+        }
+
+        final ByteBuffer data = ByteBuffer.allocate((int) end + 4).put(stream, 0, (int) end).putInt(checksum);
+        final CRC32 crc = new CRC32();
+        crc.update(ByteBuffer.allocate(4).putInt(IDAT).array());
+        crc.update(data.array());
+        final ByteBuffer repaired = ByteBuffer.allocate(firstIdat + 12 + data.capacity() + png.length - afterIdat);
+        repaired.put(png, 0, firstIdat);
+        repaired.putInt(data.capacity()).putInt(IDAT).put(data.array()).putInt((int) crc.getValue());
+        repaired.put(png, afterIdat, png.length - afterIdat);
+        return repaired.array();
+    }
+
+}
