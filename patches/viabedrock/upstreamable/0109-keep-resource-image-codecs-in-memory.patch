+package net.raphimc.viabedrock.api.resourcepack.content;
+
+/**
+ * Bounds decoded resource images by the heap instead of a fixed size. The native client accepts each PNG side up to
+ * libpng's 1,000,000-pixel default, so a fixed low bound would reject textures that native loads.
+ */
+final class ImageDecodingLimit {
+
+    // The largest pixel count whose four-byte samples still fit in one Java array.
+    private static final long MAX_ARRAY_PIXELS = (Integer.MAX_VALUE - 8) / 4;
+
+    private ImageDecodingLimit() {
+    }
+
+    static void require(final long width, final long height) {
+        require(width, height, Runtime.getRuntime().maxMemory());
+    }
+
+    /**
+     * Rejects dimensions whose decoded four-byte pixels would need more than an eighth of the heap or exceed a Java
+     * array. Conversion holds a decoded image and usually one ARGB copy, and two converter threads can decode at once,
+     * so the accepted images stay within half of the heap. A 2 GiB heap accepts 8192 x 8192 textures.
+     */
+    static void require(final long width, final long height, final long maxMemory) {
+        final long pixels = width * height;
+        if (width <= 0 || height <= 0 || pixels > MAX_ARRAY_PIXELS || pixels * 4 > maxMemory / 8) {
+            throw new IllegalArgumentException("Image dimensions " + width + "x" + height + " exceed the decoding limit");
+        }
+    }
+
+}
