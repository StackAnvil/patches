index 0000000000000000000000000000000000000000..0813669e3c6e8042cbdc115b27f5d9fb85c78575
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/resourcepack/content/ImageDecodingLimit.java
@@ -0,0 +1,36 @@
+/*
