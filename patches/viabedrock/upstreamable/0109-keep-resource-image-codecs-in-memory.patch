+++ b/src/test/java/net/raphimc/viabedrock/api/resourcepack/content/PngZlibChecksumTest.java
@@ -0,0 +1,126 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import org.junit.jupiter.api.Test;
+
+import javax.imageio.IIOException;
+import javax.imageio.ImageIO;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.function.Consumer;
+import java.util.zip.CRC32;
+import java.util.zip.Deflater;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class PngZlibChecksumTest {
+
+    @Test
+    void decodesPackPngWhoseImageDataHasWrongZlibChecksum() throws Exception {
+        final byte[] png = withIdat(texture(), data -> data[data.length - 1] ^= 0x5A);
+        assertThrows(IIOException.class, () -> ImageIO.read(new ByteArrayInputStream(png)));
+
+        final var content = new InMemoryContent();
+        content.put("entity.png", png);
+        final BufferedImage image = content.getImage("entity.png").getImage();
+
+        assertEquals(0xFF12AB34, image.getRGB(0, 0));
+        assertEquals(0x7F765432, image.getRGB(1, 0));
+        assertEquals(0xFF000000, image.getRGB(0, 1));
+        assertEquals(0x00FFFFFF, image.getRGB(1, 1));
+    }
+
+    @Test
+    void treatsPackPngWithCorruptCompressedPixelsAsMissing() throws Exception {
+        // Block type 3 is reserved, so the pixels cannot be inflated.
+        final byte[] png = withIdat(texture(), data -> data[2] |= 0x06);
+        final var content = new InMemoryContent();
+        content.put("entity.png", png);
+
+        assertNull(content.getImage("entity.png").getImage());
+    }
+
+    @Test
+    void treatsPackPngWhoseImageDataEndsBeforeTheLastRowAsMissing() throws Exception {
+        // A complete zlib stream that holds only the first of two RGBA rows, with a trailer that does not match it.
+        final byte[] firstRow = {0, 0x12, (byte) 0xAB, 0x34, (byte) 0xFF, 0x76, 0x54, 0x32, 0x7F};
+        final Deflater deflater = new Deflater();
+        deflater.setInput(firstRow);
+        deflater.finish();
+        final byte[] compressed = new byte[64];
+        final int length = deflater.deflate(compressed);
+        deflater.end();
+        final byte[] stream = Arrays.copyOf(compressed, length);
+        stream[length - 1] ^= 0x5A;
+        final var content = new InMemoryContent();
+        content.put("entity.png", replaceIdat(texture(), stream));
+
+        assertNull(content.getImage("entity.png").getImage());
+    }
+
+    private static byte[] texture() throws Exception {
+        final BufferedImage image = new BufferedImage(2, 2, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, 0xFF12AB34);
+        image.setRGB(1, 0, 0x7F765432);
+        image.setRGB(0, 1, 0xFF000000);
+        image.setRGB(1, 1, 0x00FFFFFF);
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
+
+    /** Replaces the single IDAT payload with data of any length and a valid chunk CRC. */
+    private static byte[] replaceIdat(final byte[] png, final byte[] data) {
+        final ByteBuffer buffer = ByteBuffer.wrap(png);
+        buffer.position(8);
+        while (buffer.remaining() >= 12) {
+            final int start = buffer.position();
+            final int length = buffer.getInt();
+            if (buffer.getInt() == 0x49444154) {
+                final CRC32 crc = new CRC32();
+                crc.update("IDAT".getBytes(StandardCharsets.US_ASCII));
+                crc.update(data);
+                final int after = start + 12 + length;
+                return ByteBuffer.allocate(png.length - length + data.length)
+                        .put(png, 0, start).putInt(data.length).put("IDAT".getBytes(StandardCharsets.US_ASCII)).put(data)
+                        .putInt((int) crc.getValue()).put(png, after, png.length - after).array();
+            }
+            buffer.position(start + 12 + length);
+        }
+        throw new IllegalArgumentException("PNG has no IDAT chunk");
+    }
+
+    /** Edits the single IDAT payload in place and keeps its chunk CRC valid. */
+    private static byte[] withIdat(final byte[] png, final Consumer<byte[]> edit) {
+        final ByteBuffer buffer = ByteBuffer.wrap(png);
+        buffer.position(8);
+        while (buffer.remaining() >= 12) {
+            final int start = buffer.position();
+            final int length = buffer.getInt();
+            final byte[] type = new byte[4];
+            buffer.get(type);
+            if (new String(type, StandardCharsets.US_ASCII).equals("IDAT")) {
+                final byte[] data = new byte[length];
+                buffer.get(data);
+                edit.accept(data);
+                final CRC32 crc = new CRC32();
+                crc.update(type);
+                crc.update(data);
+                buffer.position(start + 8);
+                buffer.put(data).putInt((int) crc.getValue());
+                return png;
+            }
+            buffer.position(start + 12 + length);
+        }
+        throw new IllegalArgumentException("PNG has no IDAT chunk");
+    }
+
+}
