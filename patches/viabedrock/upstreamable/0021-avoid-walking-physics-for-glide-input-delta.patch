From 3975f59d03203b6bcb6a94dfbda0ad5d7abe9c39 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:00:07 +0200
Subject: [PATCH] fix(movement): avoid walking physics for glide input delta

Bedrock's PlayerAuthInput position delta describes predicted motion. The walking friction and gravity approximation does not describe elytra flight, so forward the observed Java movement delta while gliding. This also preserves the velocity change from a firework boost in the next input frame.
---
 .../raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
index 65ac653c..9b0e7a32 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/ClientPlayerPackets.java
@@ -624,7 +624,7 @@ public final class ClientPlayerPackets {
                 positionDelta = inputPosition.subtract(prevPosition);
             }
             final Position3f velocity;
-            if (vehicle != null || !clientPlayer.isInitiallySpawned() || clientPlayer.dimensionChangeInfo() != null || clientPlayer.abilities().getBooleanValue(AbilitiesIndex.Flying)) {
+            if (vehicle != null || clientPlayer.isGliding() || !clientPlayer.isInitiallySpawned() || clientPlayer.dimensionChangeInfo() != null || clientPlayer.abilities().getBooleanValue(AbilitiesIndex.Flying)) {
                 velocity = positionDelta;
             } else {
                 float dx = positionDelta.x() * 0.98F;
-- 
2.55.0

