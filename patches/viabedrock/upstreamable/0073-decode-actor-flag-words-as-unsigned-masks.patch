From 606ab36ba25e3c9d97e8ca73c1e54b57e77fadd6 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 2 Oct 2026 12:27:00 +0200
Subject: [PATCH] fix(entities): retain all three unsigned actor flag words

Mask each retained Bedrock flag word to 64 bits before composing the actor
flags. Signed bit 63 must not invent flags in the following word. Retain
sparse updates independently, including the third word at metadata ID 139.

The 1.26.51.1 native client registers the same flag handler for IDs 0, 92
and 139 in function 0x142a3f010. Its value reader 0x142a397a0 and merge
kernel 0x142dea7a0 map them to consecutive 64-bit words. The third word
contains uniform air drag, nameplate depth and inside-pickability flags.
Keeping these flags is separate from implementing their client behavior.

Exercise unsigned boundaries, third-word replacement and sparse clearing
without protocol mappings or server fixtures.
---
 .../viabedrock/api/model/entity/Entity.java   |  9 ++-
 .../api/model/entity/EntityFlagsTest.java     | 65 +++++++++++++++++++
 2 files changed, 72 insertions(+), 2 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/model/entity/EntityFlagsTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
index 2e8f0805c..4eb6ff790 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/Entity.java
@@ -47,6 +47,8 @@ import java.util.logging.Level;
 
 public class Entity {
 
+    private static final BigInteger UNSIGNED_LONG_MASK = BigInteger.ONE.shiftLeft(Long.SIZE).subtract(BigInteger.ONE);
+
     protected final UserConnection user;
     protected final long uniqueId;
     protected final long runtimeId;
@@ -253,10 +255,13 @@ public class Entity {
     public Set<ActorFlags> entityFlags() {
         BigInteger combinedFlags = BigInteger.ZERO;
         if (this.entityData.containsKey(ActorDataIds.RESERVED_0)) {
-            combinedFlags = combinedFlags.add(BigInteger.valueOf(this.entityData.get(ActorDataIds.RESERVED_0).<Long>value().longValue()));
+            combinedFlags = combinedFlags.or(BigInteger.valueOf(this.entityData.get(ActorDataIds.RESERVED_0).<Long>value()).and(UNSIGNED_LONG_MASK));
         }
         if (this.entityData.containsKey(ActorDataIds.RESERVED_092)) {
-            combinedFlags = combinedFlags.add(BigInteger.valueOf(this.entityData.get(ActorDataIds.RESERVED_092).<Long>value().longValue()).shiftLeft(64));
+            combinedFlags = combinedFlags.or(BigInteger.valueOf(this.entityData.get(ActorDataIds.RESERVED_092).<Long>value()).and(UNSIGNED_LONG_MASK).shiftLeft(Long.SIZE));
+        }
+        if (this.entityData.containsKey(ActorDataIds.RESERVED_139)) {
+            combinedFlags = combinedFlags.or(BigInteger.valueOf(this.entityData.get(ActorDataIds.RESERVED_139).<Long>value()).and(UNSIGNED_LONG_MASK).shiftLeft(Long.SIZE * 2));
         }
         return EnumUtil.getEnumSetFromBitmask(ActorFlags.class, combinedFlags, ActorFlags::getValue);
     }
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/entity/EntityFlagsTest.java b/src/test/java/net/raphimc/viabedrock/api/model/entity/EntityFlagsTest.java
new file mode 100644
index 000000000..982e09e4c
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/entity/EntityFlagsTest.java
@@ -0,0 +1,65 @@
