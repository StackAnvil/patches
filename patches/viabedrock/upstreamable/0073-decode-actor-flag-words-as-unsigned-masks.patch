+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityFlagsTest {
+
+    @Test
+    void combinesUnsignedFlagWordsWithoutInventingHigherFlags() {
+        final Entity actor = new Entity(null, 1, 1, "minecraft:test", 1, UUID.randomUUID(), EntityTypes26_3.INTERACTION);
+        put(actor, ActorDataIds.RESERVED_0, Long.MIN_VALUE);
+        assertEquals(Set.of(ActorFlags.EATING), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_092, Long.MIN_VALUE);
+        assertEquals(Set.of(ActorFlags.EATING, ActorFlags.USES_LEGACY_FRICTION), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_0, 0L);
+        assertEquals(Set.of(ActorFlags.USES_LEGACY_FRICTION), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_092, 1L);
+        assertEquals(Set.of(ActorFlags.LAYING_DOWN), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_092, 0L);
+        assertTrue(actor.entityFlags().isEmpty());
+    }
+
+    @Test
+    void retainsTheThirdWordIndependentlyAcrossSparseUpdates() {
+        final Entity actor = new Entity(null, 1, 1, "minecraft:test", 1, UUID.randomUUID(), EntityTypes26_3.INTERACTION);
+        put(actor, ActorDataIds.RESERVED_139, 7L);
+        assertEquals(Set.of(ActorFlags.USES_UNIFORM_AIR_DRAG, ActorFlags.NAMEPLATE_DEPTH_TESTED,
+                ActorFlags.NOT_PICKABLE_FROM_INSIDE), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_0, Long.MIN_VALUE);
+        put(actor, ActorDataIds.RESERVED_092, Long.MIN_VALUE);
+        assertEquals(Set.of(ActorFlags.EATING, ActorFlags.USES_LEGACY_FRICTION,
+                ActorFlags.USES_UNIFORM_AIR_DRAG, ActorFlags.NAMEPLATE_DEPTH_TESTED,
+                ActorFlags.NOT_PICKABLE_FROM_INSIDE), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_139, 1L);
+        assertEquals(Set.of(ActorFlags.EATING, ActorFlags.USES_LEGACY_FRICTION,
+                ActorFlags.USES_UNIFORM_AIR_DRAG), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_139, Long.MIN_VALUE | 4L);
+        assertEquals(Set.of(ActorFlags.EATING, ActorFlags.USES_LEGACY_FRICTION,
+                ActorFlags.NOT_PICKABLE_FROM_INSIDE), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_0, 0L);
+        put(actor, ActorDataIds.RESERVED_092, 0L);
+        assertEquals(Set.of(ActorFlags.NOT_PICKABLE_FROM_INSIDE), actor.entityFlags());
+        put(actor, ActorDataIds.RESERVED_139, 0L);
+        assertTrue(actor.entityFlags().isEmpty());
+    }
+
+    private static void put(final Entity actor, final ActorDataIds id, final long flags) {
+        actor.entityData().put(id, new EntityData(id.getValue(), EntityDataTypesBedrock.LONG, flags));
+    }
+
+}
