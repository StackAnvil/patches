+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.model.BlockState;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+import java.awt.image.BufferedImage;
+
+/** Exports resolved Bedrock block visuals on unused Java carrier states. */
+public class CustomBlockResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    public static Map<String, Integer> assignedStates(final ResourcePackStorage storage) {
+        if (storage.getTextures().serverTerrainTextures().isEmpty()) {
+            return Map.of();
+        }
+
+        final List<Integer> available = availableStates();
+
+        final List<String> textures = new ArrayList<>(storage.getTextures().serverTerrainTextures());
+        textures.sort(Comparator.naturalOrder());
+        final Map<String, Integer> result = new LinkedHashMap<>();
+        int next = 0;
+        for (String texture : textures) {
+            if (next == available.size()) {
+                break;
+            }
+            if (terrainTexture(storage, texture) != null) {
+                result.put(texture, available.get(next++));
+            }
+        }
+        return result;
+    }
+
+    public static List<Integer> availableStates() {
+        final Set<BlockState> occupied = new HashSet<>(BedrockProtocol.MAPPINGS.getBedrockToJavaBlockStates().values());
+        return BedrockProtocol.MAPPINGS.getJavaBlockStates().entrySet().stream()
+                .filter(entry -> CustomBlockStateDefinitions.carrier(entry.getKey()))
+                .filter(entry -> !occupied.contains(entry.getKey()))
+                .sorted(Comparator.<Map.Entry<BlockState, Integer>, Boolean>comparing(entry -> !entry.getKey().namespacedIdentifier().equals("minecraft:note_block"))
+                        .thenComparingInt(Map.Entry::getValue))
+                .map(Map.Entry::getValue).toList();
+    }
+
+    public static boolean hasOpaquePixels(final Content.LazyImage texture) {
+        if (texture == null) {
+            return false;
+        }
+        final BufferedImage image;
+        try {
+            image = texture.getImage();
+        } catch (final RuntimeException e) {
+            return false;
+        }
+        if (image == null) {
+            return false;
+        }
+        if (!image.getColorModel().hasAlpha()) {
+            return true;
+        }
+        for (int y = 0; y < image.getHeight(); y++) {
+            for (int x = 0; x < image.getWidth(); x++) {
+                if (image.getRGB(x, y) >>> 24 != 255) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    public static Content.LazyImage terrainTexture(final ResourcePackStorage storage, final String texture) {
+        final String path = storage.getTextures().terrainTextures().get(texture);
+        return path == null ? null : findImage(storage, path);
+    }
+
+    /** Vanilla terrain assets are available in the Java client even when omitted from the server pack. */
+    public static String vanillaTexture(final String texture) {
+        final String renamed = switch (texture) {
+            case "mushroom_block_skin_red" -> "red_mushroom_block";
+            case "mushroom_block_skin_brown" -> "brown_mushroom_block";
+            case "mushroom_block_inside" -> "mushroom_block_inside";
+            case "mushroom_block_skin_stem" -> "mushroom_stem";
+            case "obsidian", "crying_obsidian" -> texture;
+            default -> null;
+        };
+        return renamed == null ? null : "minecraft:block/" + renamed;
+    }
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        if (!storage.getCustomBlockVisuals().isEmpty()) {
+            submitter.accept(() -> convertVisuals(storage));
+            return;
+        }
+        final Map<String, Integer> assignments = assignedStates(storage);
+        if (!assignments.isEmpty()) {
+            submitter.accept(() -> convert(storage, assignments));
+        }
+    }
+
+    private static Content convertVisuals(final ResourcePackStorage storage) {
+        final Content result = new InMemoryContent();
+        for (CustomBlockVisual visual : storage.getCustomBlockVisuals().values()) {
+            result.putString("assets/viabedrock/models/block/custom/slot_" + visual.javaState() + ".json", visual.modelJson());
+            for (Map.Entry<String, String> texture : visual.textures().entrySet()) {
+                final Content.LazyImage image = terrainTexture(storage, texture.getValue());
+                if (image == null) {
+                    continue; // This model references a vanilla Java sprite.
+                }
+                result.putPngImage("assets/viabedrock/textures/block/custom/slot_" + visual.javaState() + '/' + texture.getKey() + ".png",
+                        materialTexture(image, visual.textureRenderMethods().get(texture.getKey())));
+            }
+        }
+        final Map<Integer, String> models = new LinkedHashMap<>();
+        storage.getCustomBlockVisuals().keySet().forEach(state -> models.put(state, "viabedrock:block/custom/slot_" + state));
+        writeStateDefinitions(result, models);
+        return result;
+    }
+
+    public static BufferedImage materialTexture(final Content.LazyImage texture, final String method) {
+        final BufferedImage source = texture.getImage();
+        final BufferedImage result = new BufferedImage(source.getWidth(), source.getHeight(), BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < source.getHeight(); y++) {
+            for (int x = 0; x < source.getWidth(); x++) {
+                final int pixel = source.getRGB(x, y);
+                final int alpha = method.equals("opaque") ? 255 : method.startsWith("alpha_test") ? (pixel >>> 24 >= 128 ? 255 : 0) : pixel >>> 24;
+                result.setRGB(x, y, (pixel & 0xFFFFFF) | alpha << 24);
+            }
+        }
+        return result;
+    }
+
+    private static Content convert(final ResourcePackStorage storage, final Map<String, Integer> assignments) {
+        final Content result = new InMemoryContent();
+        for (Map.Entry<String, Integer> assignment : assignments.entrySet()) {
+            final int state = assignment.getValue();
+            final Content.LazyImage image = terrainTexture(storage, assignment.getKey());
+            if (image == null) {
+                continue;
+            }
+            result.putPngImage("assets/viabedrock/textures/block/custom/slot_" + state + ".png", image);
+            final JsonObject textures = new JsonObject();
+            textures.addProperty("all", "viabedrock:block/custom/slot_" + state);
+            final JsonObject model = new JsonObject();
+            model.addProperty("parent", "minecraft:block/cube_all");
+            model.add("textures", textures);
+            result.putJson("assets/viabedrock/models/block/custom/slot_" + state + ".json", model);
+        }
+
+        final Map<Integer, String> models = new LinkedHashMap<>();
+        assignments.values().forEach(state -> models.put(state, "viabedrock:block/custom/slot_" + state));
+        writeStateDefinitions(result, models);
+        return result;
+    }
+
+    private static void writeStateDefinitions(final Content result, final Map<Integer, String> models) {
+        CustomBlockStateDefinitions.create(BedrockProtocol.MAPPINGS.getJavaBlockStates(), models).forEach((block, definition) ->
+                result.putJson("assets/minecraft/blockstates/" + block + ".json", definition));
+    }
+
+    private static Content.LazyImage findImage(final ResourcePackStorage storage, final String path) {
+        for (ResourcePack pack : storage.getPackStackTopToBottom()) {
+            final Content.LazyImage image = pack.content().getShortnameImage(path);
+            if (image != null) {
+                return image;
+            }
+        }
+        return null;
+    }
+
+}
