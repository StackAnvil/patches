+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Session-scoped culling grids sent before StartGame. These do not define collision or selection. */
+public final class VoxelShapeRegistry implements StorableObject {
+
+    private static final int MAX_SHAPES = 8192;
+    private static final int MAX_CUSTOM_SHAPES = 4500;
+    private static final int MAX_BYTES = 64 * 1024 * 1024;
+    private volatile Snapshot snapshot = new Snapshot(List.of(), Map.of(), 0);
+
+    public Snapshot snapshot() {
+        return this.snapshot;
+    }
+
+    public void read(final ByteBuf input) {
+        if (input.readableBytes() > MAX_BYTES) {
+            throw new IllegalArgumentException("Voxel shape registry exceeds the byte limit");
+        }
+        final int shapeCount = count(input, MAX_SHAPES);
+        final List<Shape> shapes = new ArrayList<>(shapeCount);
+        for (int i = 0; i < shapeCount; i++) {
+            final int xSize = input.readUnsignedByte();
+            final int ySize = input.readUnsignedByte();
+            final int zSize = input.readUnsignedByte();
+            final int expectedBytes = (xSize * ySize * zSize + 7) / 8;
+            if (count(input, expectedBytes) != expectedBytes || input.readableBytes() < expectedBytes) {
+                throw new IllegalArgumentException("Invalid voxel cell storage length");
+            }
+            final byte[] cells = new byte[expectedBytes];
+            input.readBytes(cells);
+            shapes.add(new Shape(xSize, ySize, zSize, cells, coordinates(input, xSize), coordinates(input, ySize), coordinates(input, zSize)));
+        }
+        final int nameCount = count(input, MAX_SHAPES);
+        final Map<String, Integer> names = new LinkedHashMap<>();
+        for (int i = 0; i < nameCount; i++) {
+            final String name = BedrockTypes.STRING.read(input);
+            final int handle = input.readUnsignedShortLE();
+            if (name.isBlank() || name.length() > 4096 || handle >= shapes.size() || names.putIfAbsent(name, handle) != null) {
+                throw new IllegalArgumentException("Invalid voxel shape name mapping");
+            }
+        }
+        final int customCount = input.readUnsignedShortLE();
+        if (customCount > MAX_CUSTOM_SHAPES || customCount > names.size() || input.isReadable()) {
+            throw new IllegalArgumentException("Invalid voxel shape registry trailer");
+        }
+        this.snapshot = new Snapshot(shapes, names, customCount);
+    }
+
+    private static int count(final ByteBuf input, final int maximum) {
+        final int count = BedrockTypes.UNSIGNED_VAR_INT.read(input);
+        if (count < 0 || count > maximum) {
+            throw new IllegalArgumentException("Voxel shape array exceeds its limit");
+        }
+        return count;
+    }
+
+    private static List<Float> coordinates(final ByteBuf input, final int cells) {
+        if (count(input, cells + 1) != cells + 1 || input.readableBytes() < (cells + 1) * Float.BYTES) {
+            throw new IllegalArgumentException("Invalid voxel coordinate count");
+        }
+        final List<Float> coordinates = new ArrayList<>(cells + 1);
+        float previous = Float.NEGATIVE_INFINITY;
+        for (int i = 0; i <= cells; i++) {
+            final float coordinate = input.readFloatLE();
+            if (!Float.isFinite(coordinate) || coordinate <= previous) {
+                throw new IllegalArgumentException("Invalid voxel coordinate boundary");
+            }
+            coordinates.add(coordinate);
+            previous = coordinate;
+        }
+        return List.copyOf(coordinates);
+    }
+
+    public record Snapshot(List<Shape> shapes, Map<String, Integer> names, int customShapeCount) {
+
+        public Snapshot {
+            shapes = List.copyOf(shapes);
+            names = Map.copyOf(names);
+        }
+
+        public Shape shape(final String name) {
+            final Integer handle = this.names.get(name);
+            return handle != null ? this.shapes.get(handle) : null;
+        }
+    }
+
+    public record Shape(int xSize, int ySize, int zSize, byte[] cells,
+                        List<Float> xCoordinates, List<Float> yCoordinates, List<Float> zCoordinates) {
+
+        public Shape {
+            cells = cells.clone();
+            xCoordinates = List.copyOf(xCoordinates);
+            yCoordinates = List.copyOf(yCoordinates);
+            zCoordinates = List.copyOf(zCoordinates);
+        }
+
+        @Override
+        public byte[] cells() {
+            return this.cells.clone();
+        }
+
+        public boolean occupied(final int x, final int y, final int z) {
+            if (x < 0 || x >= this.xSize || y < 0 || y >= this.ySize || z < 0 || z >= this.zSize) {
+                throw new IndexOutOfBoundsException("Voxel cell outside the grid");
+            }
+            final int index = (x * this.ySize + y) * this.zSize + z;
+            return (this.cells[index / 8] & 1 << (index % 8)) != 0;
+        }
+    }
+
+}
