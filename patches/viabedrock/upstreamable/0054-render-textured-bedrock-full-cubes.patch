+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CustomBlockModel;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CustomBlockResourceRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockModelSelectionTest {
+
+    @Test
+    void emptyBoxesRemainEmptyBeforeAndAfterTransformation() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        for (int axis = 0; axis < 3; axis++) {
+            for (boolean rotated : new boolean[]{false, true}) {
+                final CompoundTag components = components("minecraft:geometry.full_block", "ruby", "opaque");
+                final CompoundTag shape = new CompoundTag();
+                shape.put("origin", new ListTag<>(List.of(new FloatTag(-8), new FloatTag(0), new FloatTag(-8))));
+                shape.put("size", new ListTag<>(List.of(new FloatTag(axis == 0 ? 0 : 16), new FloatTag(axis == 1 ? 0 : 16), new FloatTag(axis == 2 ? 0 : 16))));
+                components.put("minecraft:collision_box", shape);
+                components.put("minecraft:selection_box", shape.copy());
+                if (rotated) {
+                    final CompoundTag transform = new CompoundTag();
+                    transform.put("rotation", new ListTag<>(List.of(new FloatTag(45), new FloatTag(45), new FloatTag(0))));
+                    components.put("minecraft:transformation", transform);
+                }
+                final var visual = CustomBlockModel.compile(storage, "test:block", 42, components);
+                assertTrue(visual.collisionBoxes().isEmpty());
+                assertTrue(visual.selectionBoxes().isEmpty());
+                assertFalse(JsonParser.parseString(visual.modelJson()).getAsJsonObject().getAsJsonArray("elements").isEmpty());
+            }
+        }
+    }
+
+    @Test
+    void preservesLegacyFullCubeBottomOrientationAndPhysicalProperties() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final CustomBlockVisual modern = CustomBlockModel.compile(storage, "test:block", 1,
+                components("minecraft:geometry.full_block", "ruby", "opaque"));
+        for (String identifier : List.of("minecraft:geometry.full_block_v1", "geometry.full_block_v1")) {
+            final CompoundTag components = components(identifier, "ruby", "opaque");
+            for (boolean simple : new boolean[]{false, true}) {
+                if (simple) {
+                    components.putString("minecraft:geometry", identifier);
+                }
+                final CustomBlockVisual legacy = CustomBlockModel.compile(storage, "test:block", 1, components);
+                assertNotNull(legacy);
+                assertEquals(modern.collisionBoxes(), legacy.collisionBoxes());
+                assertEquals(modern.selectionBoxes(), legacy.selectionBoxes());
+                assertEquals(modern.occluding(), legacy.occluding());
+                final JsonObject legacyModel = JsonParser.parseString(legacy.modelJson()).getAsJsonObject();
+                final JsonObject modernModel = JsonParser.parseString(modern.modelJson()).getAsJsonObject();
+                final JsonObject legacyFaces = legacyModel.getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces");
+                assertEquals(180, legacyFaces.getAsJsonObject("down").remove("rotation").getAsInt());
+                assertEquals(modernModel, legacyModel);
+            }
+        }
+    }
+
+    @Test
+    void preservesNetworkLightFilteringAndEmission() throws Exception {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        for (final String component : new String[]{"minecraft:block_light_filter", "minecraft:light_dampening"}) {
+            for (final int filter : new int[]{0, 2, 15}) {
+                for (final int emission : new int[]{0, 12, 15}) {
+                    final CompoundTag components = components("minecraft:geometry.full_block", "ruby", "opaque");
+                    final CompoundTag filtering = new CompoundTag();
+                    filtering.putByte("lightLevel", (byte) filter);
+                    components.put(component, filtering);
+                    final CompoundTag emitting = new CompoundTag();
+                    emitting.putByte("emission", (byte) emission);
+                    components.put("minecraft:light_emission", emitting);
+                    final var buffer = Unpooled.buffer();
+                    try {
+                        BedrockTypes.NETWORK_TAG.write(buffer, components);
+                        final CompoundTag decoded = (CompoundTag) BedrockTypes.NETWORK_TAG.read(buffer);
+                        final CustomBlockVisual visual = CustomBlockModel.compile(storage, "test:block", 1, decoded);
+                        assertNotNull(visual);
+                        assertEquals(filter, visual.lightDampening());
+                        assertEquals(emission, visual.lightEmission());
+                    } finally {
+                        buffer.release();
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void resolvesLightPermutationsAndDefaultsWithoutMutatingBaseComponents() throws Exception {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final CompoundTag base = components("minecraft:geometry.full_block", "ruby", "opaque");
+        final CustomBlockVisual defaultVisual = CustomBlockModel.compile(storage, "test:block", 1, base);
+        assertEquals(15, defaultVisual.lightDampening());
+        assertEquals(0, defaultVisual.lightEmission());
+        final CompoundTag overlay = new CompoundTag();
+        final CompoundTag filtering = new CompoundTag();
+        filtering.putByte("lightLevel", (byte) 0);
+        overlay.put("minecraft:block_light_filter", filtering);
+        final CompoundTag emitting = new CompoundTag();
+        emitting.putByte("emission", (byte) 12);
+        overlay.put("minecraft:light_emission", emitting);
+        final CompoundTag definition = new CompoundTag();
+        definition.put("components", base);
+        final ListTag<CompoundTag> permutations = new ListTag<>(CompoundTag.class);
+        permutations.add(permutation("q.block_state('lit') == true", overlay));
+        definition.put("permutations", permutations);
+        final CompoundTag states = new CompoundTag();
+        states.putByte("lit", (byte) 1);
+        final CustomBlockVisual lit = CustomBlockModel.compile(storage, "test:block[lit=true]", 2, CustomBlockDefinition.resolve(definition, states));
+        assertEquals(0, lit.lightDampening());
+        assertEquals(12, lit.lightEmission());
+        states.putByte("lit", (byte) 0);
+        final CustomBlockVisual unlit = CustomBlockModel.compile(storage, "test:block[lit=false]", 3, CustomBlockDefinition.resolve(definition, states));
+        assertEquals(defaultVisual.lightDampening(), unlit.lightDampening());
+        assertEquals(defaultVisual.lightEmission(), unlit.lightEmission());
+    }
+
+    @Test
+    void classifiesActualPixelsAndRespectsPackPrecedence() {
+        final BufferedImage pixels = new BufferedImage(2, 2, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 2; y++) {
+            for (int x = 0; x < 2; x++) {
+                pixels.setRGB(x, y, 0xFF123456);
+            }
+        }
+        final ResourcePack opaque = pack(pixels);
+        pixels.setRGB(1, 1, 0xFE123456);
+        final ResourcePack partial = pack(pixels);
+        final ResourcePackStorage overridden = new ResourcePackStorage(List.of(partial, opaque));
+        assertFalse(CustomBlockResourceRewriter.hasOpaquePixels(CustomBlockResourceRewriter.terrainTexture(overridden, "ruby")));
+        final ResourcePackStorage reverse = new ResourcePackStorage(List.of(opaque, partial));
+        assertTrue(CustomBlockResourceRewriter.hasOpaquePixels(CustomBlockResourceRewriter.terrainTexture(reverse, "ruby")));
+        assertFalse(CustomBlockResourceRewriter.hasOpaquePixels(null));
+        assertFalse(CustomBlockResourceRewriter.hasOpaquePixels(new net.raphimc.viabedrock.api.resourcepack.content.Content.LazyImage(new byte[]{1}, "png")));
+    }
+
+    @Test
+    void resolvesEveryMatchingPermutationWithoutMutatingBaseComponents() throws Exception {
+        final CompoundTag definition = new CompoundTag();
+        definition.put("components", components("geometry.test", "ruby", "alpha_test"));
+        final CompoundTag states = new CompoundTag();
+        states.putString("part", "middle");
+        states.putString("facing", "east");
+        states.putByte("enabled", (byte) 1);
+        final ListTag<CompoundTag> permutations = new ListTag<>(CompoundTag.class);
+        final CompoundTag geometry = new CompoundTag();
+        geometry.put("minecraft:geometry", geometry("geometry.middle"));
+        permutations.add(permutation("q.block_state('part') == 'middle'", geometry));
+        final CompoundTag transformation = new CompoundTag();
+        final CompoundTag rotation = new CompoundTag();
+        rotation.putInt("RY", 1);
+        transformation.put("minecraft:transformation", rotation);
+        permutations.add(permutation("query.block_property('facing') == 'east' && query.block_property('enabled') == true", transformation));
+        final CompoundTag wrong = new CompoundTag();
+        wrong.put("minecraft:geometry", geometry("geometry.wrong"));
+        permutations.add(permutation("query.block_property('part') == 'left'", wrong));
+        definition.put("permutations", permutations);
+
+        final CompoundTag resolved = CustomBlockDefinition.resolve(definition, states);
+        assertEquals("geometry.middle", resolved.getCompoundTag("minecraft:geometry").getStringTag("identifier").getValue());
+        assertEquals(1, resolved.getCompoundTag("minecraft:transformation").getIntTag("RY").asInt());
+        assertEquals("geometry.test", definition.getCompoundTag("components").getCompoundTag("minecraft:geometry").getStringTag("identifier").getValue());
+        assertNull(definition.getCompoundTag("components").get("minecraft:transformation"));
+    }
+
+    @Test
+    void convertsBlockGeometryAndTransformsPhysicalBoundsInBlockUnits() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final CompoundTag components = components("geometry.test", "ruby", "alpha_test");
+        final CompoundTag collision = new CompoundTag();
+        final CompoundTag box = new CompoundTag();
+        box.putFloat("minX", 0);
+        box.putFloat("minY", 0);
+        box.putFloat("minZ", 0);
+        box.putFloat("maxX", 8);
+        box.putFloat("maxY", 8);
+        box.putFloat("maxZ", 16);
+        final ListTag<CompoundTag> boxes = new ListTag<>(CompoundTag.class);
+        boxes.add(box);
+        collision.put("boxes", boxes);
+        components.put("minecraft:collision_box", collision);
+        final CompoundTag transform = new CompoundTag();
+        transform.putInt("RY", 1);
+        components.put("minecraft:transformation", transform);
+        final CustomBlockVisual visual = CustomBlockModel.compile(storage, "test:bench[facing=east]", 123, components);
+        assertNotNull(visual);
+        final var model = JsonParser.parseString(visual.modelJson()).getAsJsonObject();
+        assertEquals(1, model.getAsJsonArray("elements").size());
+        assertEquals(123, visual.javaState());
+        assertEquals("ruby", visual.terrainTexture());
+        final var bounds = visual.collisionBoxes().get(0);
+        assertEquals(0, bounds.minX(), 1E-8);
+        assertEquals(1, bounds.maxX(), 1E-8);
+        assertEquals(0, bounds.minZ(), 1E-8);
+        assertEquals(0.5, bounds.maxZ(), 1E-8);
+        assertEquals(0.5, bounds.maxY(), 1E-8);
+        assertFalse(visual.occluding());
+        assertParticleTexture(model);
+        assertThrows(UnsupportedOperationException.class, () -> visual.collisionBoxes().clear());
+    }
+
+    @Test
+    void exportsBlendMaterialAndKeepsOpaqueFullCubeOcclusion() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final var opaque = CustomBlockModel.compile(storage, "test:block", 1, components("minecraft:geometry.full_block", "ruby", "alpha_test"));
+        assertTrue(opaque.occluding());
+        final var blend = CustomBlockModel.compile(storage, "test:block", 2, components("minecraft:geometry.full_block", "ruby", "blend"));
+        assertFalse(blend.occluding());
+        for (final var visual : List.of(opaque, blend)) {
+            assertParticleTexture(JsonParser.parseString(visual.modelJson()).getAsJsonObject());
+        }
+        final var binding = JsonParser.parseString(blend.modelJson()).getAsJsonObject().getAsJsonObject("textures").getAsJsonObject("down");
+        assertTrue(binding.get("force_translucent").getAsBoolean());
+        assertEquals("viabedrock:block/custom/slot_2/all", binding.get("sprite").getAsString());
+    }
+
+    @Test
+    void preservesPerFaceMaterialsAndLegacyBlockTextures() {
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final CompoundTag components = components("minecraft:geometry.full_block", "ruby", "opaque");
+        final CompoundTag west = new CompoundTag();
+        west.putString("texture", "gold");
+        components.getCompoundTag("minecraft:material_instances").put("west", west);
+        final var visual = CustomBlockModel.compile(storage, "test:block", 12, components);
+        assertEquals("gold", visual.textures().get("west"));
