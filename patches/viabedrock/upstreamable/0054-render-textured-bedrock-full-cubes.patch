     public TextureDefinitions(final ResourcePackStorage resourcePackStorage) {
         for (ResourcePack pack : resourcePackStorage.getPackStackBottomToTop()) {
+            if (pack.content().contains("textures/terrain_texture.json")) {
+                try {
+                    final JsonObject terrainTexture = pack.content().getJson("textures/terrain_texture.json");
+                    final JsonObject textureData = terrainTexture.getAsJsonObject("texture_data");
+                    if (textureData != null) {
+                        for (Map.Entry<String, JsonElement> entry : textureData.entrySet()) {
+                            if (!entry.getValue().isJsonObject()) {
+                                continue;
+                            }
+                            final String path = firstTexturePath(entry.getValue().getAsJsonObject().get("textures"));
+                            if (path != null) {
+                                this.terrainTextures.put(entry.getKey(), path);
+                                if (resourcePackStorage.isServerPack(pack)) {
+                                    this.serverTerrainTextures.add(entry.getKey());
+                                }
+                            }
+                        }
+                    }
+                } catch (final Throwable e) {
+                    ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to parse terrain_texture.json in pack " + pack.key(), e);
+                }
+            }
             if (pack.content().contains("textures/item_texture.json")) {
                 try {
                     final JsonObject itemTexture = pack.content().getJson("textures/item_texture.json");
@@ -63,6 +87,36 @@ public class TextureDefinitions {
         return Collections.unmodifiableMap(this.itemTextures);
     }
 
+    public Map<String, String> terrainTextures() {
+        return Collections.unmodifiableMap(this.terrainTextures);
+    }
+
+    public Set<String> serverTerrainTextures() {
+        return Collections.unmodifiableSet(this.serverTerrainTextures);
+    }
+
+    private static String firstTexturePath(final JsonElement textures) {
+        if (textures == null || textures.isJsonNull()) {
+            return null;
+        }
+        if (textures.isJsonPrimitive()) {
+            return textures.getAsString();
+        }
+        if (textures.isJsonArray() && !textures.getAsJsonArray().isEmpty()) {
+            return firstTexturePath(textures.getAsJsonArray().get(0));
+        }
+        if (textures.isJsonObject()) {
+            final JsonObject texture = textures.getAsJsonObject();
+            if (texture.has("path")) {
+                return texture.get("path").getAsString();
+            }
+            if (texture.has("variations")) {
+                return firstTexturePath(texture.get("variations"));
+            }
+        }
+        return null;
+    }
+
     public record ItemTextureDefinition(String name, String texturePath) {
     }
 
