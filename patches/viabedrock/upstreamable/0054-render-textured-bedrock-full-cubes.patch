+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.protocol.packet.Direction;
+import com.viaversion.viaversion.exception.CancelException;
+import io.netty.buffer.Unpooled;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+
+import java.util.ArrayDeque;
+import java.util.Queue;
+import java.util.UUID;
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.BiConsumer;
+
+/** Holds ordered world packets while the configuration client loads state-specific block models. */
+public final class CustomBlockPackStorage implements StorableObject {
+
+    private static final int MAX_BYTES = 64 * 1024 * 1024;
+    private static final int MAX_PACKETS = 10000;
+    private final Queue<Packet> packets = new ArrayDeque<>();
+    private final Consumer<Boolean> completion;
+    private UUID packId;
+    private int bytes;
+    private boolean completed;
+
+    public CustomBlockPackStorage(final Consumer<Boolean> completion) {
+        this.completion = completion;
+    }
+
+    public void expect(final UUID id) {
+        this.packId = id;
+    }
+
+    public void queue(final ClientboundBedrockPackets type, final byte[] payload) {
+        if (this.packets.size() == MAX_PACKETS || payload.length > MAX_BYTES - this.bytes) {
+            throw new IllegalStateException("World packets exceeded the custom block pack loading buffer");
+        }
+        this.packets.add(new Packet(Objects.requireNonNull(type), payload.clone()));
+        this.bytes += payload.length;
+    }
+
+    public boolean complete(final UUID id, final boolean loaded) {
+        if (this.completed || this.packId == null || !this.packId.equals(id)) {
+            return false;
+        }
+        this.completed = true;
+        this.completion.accept(loaded);
+        return true;
+    }
+
+    public void drain(final UserConnection user) {
+        this.drain((type, payload) -> {
+            final ByteBuf input = Unpooled.wrappedBuffer(payload);
+            try {
+                dispatch(PacketWrapper.create(type, input, user));
+            } finally {
+                input.release();
+            }
+        });
+    }
+
+    public void drain(final BiConsumer<ClientboundBedrockPackets, byte[]> receiver) {
+        Packet packet;
+        while ((packet = this.packets.poll()) != null) {
+            this.bytes -= packet.payload.length;
+            receiver.accept(packet.type, packet.payload);
+        }
+    }
+
+    static void dispatch(final PacketWrapper wrapper) {
+        // Base protocols already processed this packet before it reached the block-pack gate.
+        // PacketWrapper.send would prepend them again and reinterpret the Bedrock packet id.
+        final var protocols = wrapper.user().getProtocolInfo().getPipeline()
+                .pipes(BedrockProtocol.class, false, Direction.CLIENTBOUND).stream()
+                .filter(protocol -> !protocol.isBaseProtocol()).toList();
+        try {
+            wrapper.apply(Direction.CLIENTBOUND, wrapper.getPacketType().state(), protocols);
+            if (!wrapper.isCancelled()) {
+                wrapper.sendRaw();
+            }
+        } catch (final CancelException ignored) {
+            // A Bedrock handler can consume the packet and emit its own Java packets.
+        }
+    }
+
+    public int packetCount() {
+        return this.packets.size();
+    }
+
+    private record Packet(ClientboundBedrockPackets type, byte[] payload) {
+    }
+
+}
