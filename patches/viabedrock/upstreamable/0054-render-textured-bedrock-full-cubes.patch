+class CustomBlockModelSelectionTest {
+
+    @Test
+    void selectsOpaqueFullCubeTexture() {
+        assertEquals("ruby", BlockStateRewriter.fullCubeTexture(block("minecraft:geometry.full_block", "ruby")));
+
+        final CompoundTag currentProtocol = block("minecraft:geometry.full_block", "ruby");
+        final CompoundTag components = currentProtocol.getCompoundTag("components");
+        final CompoundTag materials = components.getCompoundTag("minecraft:material_instances");
+        final CompoundTag instances = new CompoundTag();
+        instances.put("materials", materials);
+        instances.put("mappings", new CompoundTag());
+        components.put("minecraft:material_instances", instances);
+        assertEquals("ruby", BlockStateRewriter.fullCubeTexture(currentProtocol));
+    }
+
+    @Test
+    void avoidsAssigningOneModelToPermutedOrNonCubeBlocks() {
+        final CompoundTag permuted = block("minecraft:geometry.full_block", "ruby");
+        final ListTag<CompoundTag> permutations = new ListTag<>(CompoundTag.class);
+        permutations.add(new CompoundTag());
+        permuted.put("permutations", permutations);
+        assertNull(BlockStateRewriter.fullCubeTexture(permuted));
+
+        final CompoundTag shaped = block("geometry.ruby_column", "ruby");
+        assertNull(BlockStateRewriter.fullCubeTexture(shaped));
+
+        final CompoundTag blended = block("minecraft:geometry.full_block", "ruby");
+        ((CompoundTag) ((CompoundTag) blended.get("components")).get("minecraft:material_instances"))
+                .getCompoundTag("*").putString("render_method", "blend");
+        assertNull(BlockStateRewriter.fullCubeTexture(blended));
+
+        final CompoundTag multipleFaces = block("minecraft:geometry.full_block", "ruby");
+        final CompoundTag top = new CompoundTag();
+        top.putString("texture", "gold");
+        ((CompoundTag) ((CompoundTag) multipleFaces.get("components")).get("minecraft:material_instances"))
+                .put("up", top);
+        assertNull(BlockStateRewriter.fullCubeTexture(multipleFaces));
+
+        final CompoundTag mappedFaces = block("minecraft:geometry.full_block", "ruby");
+        final CompoundTag components = mappedFaces.getCompoundTag("components");
+        final CompoundTag instances = new CompoundTag();
+        instances.put("materials", components.getCompoundTag("minecraft:material_instances"));
+        final CompoundTag mappings = new CompoundTag();
+        mappings.putString("up", "gold");
+        instances.put("mappings", mappings);
+        components.put("minecraft:material_instances", instances);
+        assertNull(BlockStateRewriter.fullCubeTexture(mappedFaces));
+    }
+
+    private static CompoundTag block(final String geometryName, final String textureName) {
