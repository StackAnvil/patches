+        components.getCompoundTag("minecraft:material_instances").getCompoundTag("*").putByte("face_dimming", (byte) 0);
+        final var allUnshaded = CustomBlockModel.compile(storage, "test:block", 12, components);
+        final var allElements = JsonParser.parseString(allUnshaded.modelJson()).getAsJsonObject().getAsJsonArray("elements");
