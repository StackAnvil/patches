+class CustomBlockPackStorageTest {
+
+    @Test
+    void ignoresOtherPackAcknowledgmentsAndCompletesOnce() {
+        final List<Boolean> completed = new ArrayList<>();
+        final CustomBlockPackStorage storage = new CustomBlockPackStorage(completed::add);
+        final UUID id = UUID.randomUUID();
+        assertFalse(storage.complete(id, true));
