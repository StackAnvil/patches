+    static String fullCubeTexture(final CompoundTag properties) {
+        final ListTag<CompoundTag> permutations = properties.getListTag("permutations", CompoundTag.class);
+        if (permutations != null && !permutations.isEmpty()) {
+            return null;
+        }
+        if (!(properties.get("components") instanceof CompoundTag components)) {
+            return null;
+        }
+        final Tag geometry = components.get("minecraft:geometry");
+        final String geometryName;
+        if (geometry instanceof StringTag name) {
+            geometryName = name.getValue();
+        } else if (geometry instanceof CompoundTag details && details.get("identifier") instanceof StringTag name) {
+            geometryName = name.getValue();
+        } else {
+            return null;
+        }
+        if (!geometryName.equals("minecraft:geometry.full_block") && !geometryName.equals("geometry.full_block")) {
+            return null;
+        }
+        if (!(components.get("minecraft:material_instances") instanceof CompoundTag instances)) {
+            return null;
+        }
+        CompoundTag materials = instances;
+        if (instances.get("materials") instanceof CompoundTag definedMaterials) {
+            if (instances.get("mappings") instanceof CompoundTag mappings && mappings.size() != 0) {
+                return null;
+            }
+            materials = definedMaterials;
+        }
+        if (materials.size() != 1
+                || !(materials.get("*") instanceof CompoundTag material)
+                || !(material.get("texture") instanceof StringTag texture)) {
+            return null;
+        }
+        if (material.get("render_method") instanceof StringTag method
+                && !method.getValue().equals("opaque")) {
+            return null;
+        }
+        return texture.getValue();
+    }
