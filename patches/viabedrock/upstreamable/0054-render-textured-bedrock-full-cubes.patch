+        final JsonObject model;
+        if (fullCube) {
+            model = fullCube(textureIds);
+        } else {
+            final BedrockGeometryModel bedrockModel = storage.getModels().blockModels().get(geometry);
+            if (bedrockModel == null) {
+                return null;
+            }
+            model = geometry(bedrockModel, textureIds);
+        }
+        final JsonObject modelTextures = model.getAsJsonObject("textures");
+        for (String key : List.copyOf(modelTextures.keySet())) {
+            final String sprite = modelTextures.get(key).getAsString();
+            final Direction direction = Direction.valueOf(key.toUpperCase(java.util.Locale.ROOT));
+            if (directionMethods.get(direction).equals("blend")) {
+                final JsonObject reference = new JsonObject();
+                reference.addProperty("sprite", sprite);
+                reference.addProperty("force_translucent", true);
+                modelTextures.add(key, reference);
+            }
+        }
+        modelTextures.addProperty("particle", textureIds.get(Direction.NORTH));
+        model.addProperty("ambientocclusion", ao);
+        final Transform transformation = new Transform(components.getCompoundTag("minecraft:transformation"));
+        transformModel(model, transformation);
+        final boolean occluding = fullCube && opaque && transformation.identity();
