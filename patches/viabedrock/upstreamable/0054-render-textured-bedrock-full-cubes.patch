+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(new BufferedImage(1, 1, BufferedImage.TYPE_INT_RGB))));
+        final var visual = CustomBlockModel.compile(storage, "test:vanilla", 14,
+                components("minecraft:geometry.full_block", "mushroom_block_skin_red", "opaque"));
+        assertNotNull(visual);
+        final var model = JsonParser.parseString(visual.modelJson()).getAsJsonObject();
+        assertEquals("minecraft:block/red_mushroom_block", model.getAsJsonObject("textures").get("west").getAsString());
