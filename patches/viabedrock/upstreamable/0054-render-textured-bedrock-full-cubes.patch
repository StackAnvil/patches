+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.model.BlockState;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/** Keeps vanilla selectors intact while assigning unused, water-free carrier states. */
+final class CustomBlockStateDefinitions {
+
+    private CustomBlockStateDefinitions() {
+    }
+
+    static boolean carrier(final BlockState state) {
+        return state.namespacedIdentifier().equals("minecraft:note_block") || state.namespacedIdentifier().equals("minecraft:redstone_wire");
+    }
+
+    static Map<String, JsonObject> create(final Map<BlockState, Integer> states, final Map<Integer, String> assignments) {
+        final Map<String, JsonObject> result = new LinkedHashMap<>();
+        final JsonObject variants = new JsonObject();
+        final List<BlockState> vanillaWire = new ArrayList<>();
+        final Map<BlockState, String> customWire = new LinkedHashMap<>();
+        for (Map.Entry<BlockState, Integer> state : states.entrySet()) {
+            if (state.getKey().namespacedIdentifier().equals("minecraft:note_block")) {
+                final String serialized = state.getKey().toBlockStateString();
+                final String variant = serialized.substring(serialized.indexOf('[') + 1, serialized.length() - 1);
+                variants.add(variant, model(assignments.getOrDefault(state.getValue(), "minecraft:block/note_block"), 0));
+            } else if (state.getKey().namespacedIdentifier().equals("minecraft:redstone_wire")) {
+                final String custom = assignments.get(state.getValue());
+                if (custom == null) {
+                    vanillaWire.add(state.getKey());
+                } else {
+                    customWire.put(state.getKey(), custom);
+                }
+            }
+        }
+        if (!variants.isEmpty()) {
+            final JsonObject note = new JsonObject();
+            note.add("variants", variants);
+            result.put("note_block", note);
+        }
+        if (!customWire.isEmpty()) {
+            final JsonArray parts = new JsonArray();
+            final JsonObject vanilla = condition(vanillaWire);
+            if (vanilla != null) {
+                final JsonArray dot = new JsonArray();
+                dot.add(properties(Map.of("east", "none", "north", "none", "south", "none", "west", "none")));
+                for (List<String> pair : List.of(List.of("east", "north"), List.of("east", "south"), List.of("south", "west"), List.of("north", "west"))) {
+                    dot.add(properties(Map.of(pair.get(0), "side|up", pair.get(1), "side|up")));
+                }
+                final JsonObject dotCondition = new JsonObject();
+                dotCondition.add("OR", dot);
+                parts.add(part(and(vanilla, dotCondition), "minecraft:block/redstone_dust_dot", 0));
+                parts.add(part(and(vanilla, properties(Map.of("north", "side|up"))), "minecraft:block/redstone_dust_side0", 0));
+                parts.add(part(and(vanilla, properties(Map.of("south", "side|up"))), "minecraft:block/redstone_dust_side_alt0", 0));
+                parts.add(part(and(vanilla, properties(Map.of("east", "side|up"))), "minecraft:block/redstone_dust_side_alt1", 270));
+                parts.add(part(and(vanilla, properties(Map.of("west", "side|up"))), "minecraft:block/redstone_dust_side1", 270));
+                final List<String> directions = List.of("north", "east", "south", "west");
+                for (int index = 0; index < directions.size(); index++) {
+                    parts.add(part(and(vanilla, properties(Map.of(directions.get(index), "up"))), "minecraft:block/redstone_dust_up", index * 90));
+                }
+            }
+            customWire.forEach((state, custom) -> parts.add(part(properties(state.properties()), custom, 0)));
+            final JsonObject wire = new JsonObject();
+            wire.add("multipart", parts);
+            result.put("redstone_wire", wire);
+        }
+        return result;
+    }
+
+    /** Groups equivalent suffixes to avoid a large disjunction of complete vanilla states. */
+    static JsonObject condition(final List<BlockState> states) {
+        if (states.isEmpty()) {
+            return null;
+        }
+        return condition(states, states.get(0).properties().keySet().stream().sorted().toList(), 0);
+    }
+
+    private static JsonObject condition(final List<BlockState> states, final List<String> keys, final int depth) {
+        if (depth == keys.size()) {
+            return new JsonObject();
+        }
+        final String key = keys.get(depth);
+        final Map<String, List<BlockState>> branches = new TreeMap<>();
+        for (BlockState state : states) {
+            branches.computeIfAbsent(state.properties().get(key), ignored -> new ArrayList<>()).add(state);
+        }
+        final Map<String, JsonObject> suffixes = new LinkedHashMap<>();
+        final Map<String, List<String>> equivalent = new LinkedHashMap<>();
+        branches.forEach((value, branch) -> {
+            final JsonObject suffix = condition(branch, keys, depth + 1);
+            final String serialized = suffix.toString();
+            suffixes.putIfAbsent(serialized, suffix);
+            equivalent.computeIfAbsent(serialized, ignored -> new ArrayList<>()).add(value);
+        });
+        final JsonArray alternatives = new JsonArray();
+        equivalent.forEach((suffix, values) -> alternatives.add(and(properties(Map.of(key, String.join("|", values))), suffixes.get(suffix))));
+        if (alternatives.size() == 1) {
+            return alternatives.get(0).getAsJsonObject();
+        }
+        final JsonObject result = new JsonObject();
+        result.add("OR", alternatives);
+        return result;
+    }
+
+    private static JsonObject and(final JsonObject first, final JsonObject second) {
+        if (first.isEmpty()) {
+            return second;
+        }
+        if (second.isEmpty()) {
+            return first;
+        }
+        final JsonArray conditions = new JsonArray();
+        conditions.add(first);
+        conditions.add(second);
+        final JsonObject result = new JsonObject();
+        result.add("AND", conditions);
+        return result;
+    }
+
+    private static JsonObject properties(final Map<String, String> properties) {
+        final JsonObject result = new JsonObject();
+        new TreeMap<>(properties).forEach(result::addProperty);
+        return result;
+    }
+
+    private static JsonObject part(final JsonObject condition, final String name, final int rotation) {
+        final JsonObject part = new JsonObject();
+        part.add("when", condition);
+        part.add("apply", model(name, rotation));
+        return part;
+    }
+
+    private static JsonObject model(final String name, final int rotation) {
+        final JsonObject model = new JsonObject();
+        model.addProperty("model", name);
+        if (rotation != 0) {
+            model.addProperty("y", rotation);
+        }
+        return model;
+    }
+
+}
