+        if (instances != null) {
+            final CompoundTag defined = instances.get("materials") instanceof CompoundTag nested ? nested : instances;
+            for (Map.Entry<String, Tag> entry : defined) {
+                if (entry.getValue() instanceof CompoundTag material) {
+                    materials.put(entry.getKey(), material);
+                }
+            }
+            mappings = instances.getCompoundTag("mappings");
+        } else {
+            final String identifier = state.contains("[") ? state.substring(0, state.indexOf('[')) : state;
+            final var legacy = storage.getBlocks().get(identifier);
+            if (legacy != null) {
+                for (Map.Entry<String, String> entry : legacy.textures().entrySet()) {
+                    final CompoundTag material = new CompoundTag();
+                    material.putString("texture", entry.getValue());
+                    materials.put(entry.getKey(), material);
+                }
+                if (!materials.isEmpty() && geometry.isEmpty()) {
+                    geometry = "minecraft:geometry.full_block";
+                }
+            }
+        }
+        final Map<Direction, String> textureIds = new LinkedHashMap<>();
+        final Map<String, String> textureBindings = new LinkedHashMap<>();
+        final Map<String, String> textureMethods = new LinkedHashMap<>();
+        final Map<Direction, String> directionMethods = new LinkedHashMap<>();
+        final Map<String, Boolean> faceDimming = new LinkedHashMap<>();
+        final Map<String, Boolean> visibleSprites = new LinkedHashMap<>();
+        boolean opaque = true;
+        boolean ao = true;
+        String renderMethod = "opaque";
+        for (Direction direction : Direction.values()) {
+            final String face = direction.name().toLowerCase(java.util.Locale.ROOT);
+            String key = materials.containsKey(face) ? face : materials.containsKey("side") && direction != Direction.UP && direction != Direction.DOWN ? "side" : "*";
+            if (mappings != null && mappings.get(face) instanceof StringTag mapped) {
+                key = mapped.getValue();
+            }
+            final CompoundTag material = materials.get(key);
+            if (material == null || !(material.get("texture") instanceof StringTag texture)) {
+                return null;
+            }
+            final String method = material.get("render_method") instanceof StringTag value ? value.getValue() : "opaque";
+            if (!List.of("opaque", "alpha_test", "alpha_test_single_sided", "blend").contains(method)) {
+                return null;
+            }
+            final var image = CustomBlockResourceRewriter.terrainTexture(storage, texture.getValue());
+            final String vanillaTexture = image == null ? CustomBlockResourceRewriter.vanillaTexture(texture.getValue()) : null;
+            if (image == null && vanillaTexture == null) {
+                return null;
+            }
+            final String binding = key.equals("*") ? "all" : key;
+            textureBindings.put(binding, texture.getValue());
+            textureMethods.put(binding, method);
+            textureIds.put(direction, image == null ? vanillaTexture : "viabedrock:block/custom/slot_" + javaState + '/' + binding);
+            visibleSprites.put(textureIds.get(direction), CustomBlockResourceRewriter.hasVisiblePixels(image, method));
+            directionMethods.put(direction, method);
+            faceDimming.put(face, !(material.get("face_dimming") instanceof NumberTag value) || value.asInt() != 0);
+            opaque &= method.equals("opaque") || !method.equals("blend") && CustomBlockResourceRewriter.hasOpaquePixels(image);
+            ao &= !(material.get("ambient_occlusion") instanceof NumberTag value) || value.asDouble() != 0;
+            if (method.equals("blend") || renderMethod.equals("opaque")) {
+                renderMethod = method;
+            }
+        }
+        final boolean legacyFullCube = geometry.equals("minecraft:geometry.full_block_v1") || geometry.equals("geometry.full_block_v1");
+        final boolean fullCube = legacyFullCube || geometry.equals("minecraft:geometry.full_block") || geometry.equals("geometry.full_block");
+        final JsonObject model;
+        if (fullCube) {
+            model = fullCube(textureIds, legacyFullCube);
