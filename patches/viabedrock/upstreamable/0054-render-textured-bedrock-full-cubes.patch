+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.storage.VoxelShapeRegistry;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockMaterialVisibilityTest {
+
+    @Test
+    void omitsInvisibleFacesWithoutRemovingPhysicalBoxesOrAuthoredVoxelParticipation() {
+        final ResourcePackStorage storage = storage(new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB));
+        for (String method : List.of("alpha_test", "alpha_test_single_sided", "blend")) {
+            final var visual = CustomBlockModel.compile(storage, "test:block", 42, components(method));
+            assertNotNull(visual);
+            assertTrue(JsonParser.parseString(visual.modelJson()).getAsJsonObject().getAsJsonArray("elements").isEmpty());
+            assertEquals(1, visual.collisionBoxes().size());
+            assertEquals(1, visual.selectionBoxes().size());
+            final var culling = CustomBlockCulling.decode(CustomBlockCulling.encode(Map.of(42, visual))).get(42);
+            assertEquals(Set.of(CustomBlockCulling.Direction.SOUTH), culling.directions());
+            assertEquals(List.of(new CustomBlockCulling.Rectangle(0, 0, 1, 1)), culling.slice(CustomBlockCulling.Direction.SOUTH));
+            assertEquals(16, CustomBlockResourceRewriter.terrainTexture(storage, "skin").getImage().getWidth());
+        }
+    }
+
+    @Test
+    void appliesVisibilityToTheActualSpriteAndPreservesOpaqueAndPartiallyVisibleMaterials() {
+        final ResourcePackStorage invisible = storage(new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB));
+        final CompoundTag components = components("alpha_test");
+        final CompoundTag opaque = components.getCompoundTag("minecraft:material_instances").getCompoundTag("*").copy();
+        opaque.putString("render_method", "opaque");
+        components.getCompoundTag("minecraft:material_instances").put("up", opaque);
+        final var mixed = CustomBlockModel.compile(invisible, "test:block", 42, components);
+        assertNotNull(mixed);
+        final var elements = JsonParser.parseString(mixed.modelJson()).getAsJsonObject().getAsJsonArray("elements");
+        assertEquals(1, elements.size());
+        assertEquals(Set.of("up"), elements.get(0).getAsJsonObject().getAsJsonObject("faces").keySet());
+
+        final BufferedImage pixels = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+        pixels.setRGB(4, 4, 0x7F123456);
+        final ResourcePackStorage faint = storage(pixels);
+        final var texture = CustomBlockResourceRewriter.terrainTexture(faint, "skin");
+        assertFalse(CustomBlockResourceRewriter.hasVisiblePixels(texture, "alpha_test"));
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(texture, "blend"));
+        final var blended = CustomBlockModel.compile(faint, "test:block", 42, components("blend"));
+        assertNotNull(blended);
+        assertEquals(6, JsonParser.parseString(blended.modelJson()).getAsJsonObject().getAsJsonArray("elements")
+                .get(0).getAsJsonObject().getAsJsonObject("faces").size());
+        pixels.setRGB(4, 4, 0x80123456);
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(CustomBlockResourceRewriter.terrainTexture(storage(pixels), "skin"), "alpha_test"));
+        assertTrue(CustomBlockResourceRewriter.hasVisiblePixels(null, "alpha_test"));
+    }
+
+    private static CompoundTag components(final String method) {
+        final CompoundTag result = new CompoundTag();
+        final CompoundTag geometry = new CompoundTag();
+        geometry.putString("identifier", "geometry.test");
+        geometry.putString("culling", "test:cull");
+        geometry.putString("culling_shape", "test:unit");
+        result.put("minecraft:geometry", geometry);
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", "skin");
+        material.putString("render_method", method);
+        final CompoundTag materials = new CompoundTag();
+        materials.put("*", material);
+        result.put("minecraft:material_instances", materials);
+        return result;
+    }
+
+    private static ResourcePackStorage storage(final BufferedImage pixels) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"skin\":{\"textures\":\"textures/blocks/skin\"}}}");
+        content.putPngImage("textures/blocks/skin.png", pixels);
+        content.putString("models/blocks/test.json", """
+            {"format_version":"1.12.0","minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":16,"texture_height":16},
+            "bones":[{"name":"body","cubes":[{"origin":[-4,0,-4],"size":[8,8,8],"uv":[0,0]}]}]}]}
+            """);
+        content.putString("block_culling/test.json", """
+            {"format_version":"1.21.80","minecraft:block_culling_rules":{"description":{"identifier":"test:cull"},"rules":[
+            {"direction":"south","cull_against_full_and_opaque":false,"geometry_part":{"bone":"body"}}]}}
+            """);
+        final var storage = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final var shape = new VoxelShapeRegistry.Shape(1, 1, 1, new byte[]{1}, List.of(0F, 1F), List.of(0F, 1F), List.of(0F, 1F));
+        storage.setVoxelShapes(new VoxelShapeRegistry.Snapshot(List.of(shape), Map.of("test:unit", 0), 1));
+        return storage;
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/CustomBlockStateDefinitionsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/CustomBlockStateDefinitionsTest.java
