+import static org.junit.jupiter.api.Assertions.*;
+import static net.raphimc.viabedrock.api.model.CustomBlockCulling.*;
+
+class CustomBlockCullingCompilerTest {
+
+    @Test
+    void keepsAuthoredCubeIndicesAcrossInvisibleCubesAndRotatesRulesAndVoxelSlicesTogether() {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"skin\":{\"textures\":\"textures/blocks/skin\"}}}");
+        content.putPngImage("textures/blocks/skin.png", new BufferedImage(64, 64, BufferedImage.TYPE_INT_RGB));
+        content.putString("models/blocks/test.json", """
+            {"format_version":"1.12.0","minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+            "bones":[{"name":"body","cubes":[{"origin":[-8,0,-8],"size":[16,16,16],"uv":{}},
+            {"origin":[-8,0,-8],"size":[16,16,16],"uv":[0,0]}]}]}]}
+            """);
+        content.putString("block_culling/test.json", """
+            {"format_version":"1.21.80","minecraft:block_culling_rules":{"description":{"identifier":"test:cull"},"rules":[
+            {"direction":"west","condition":"same_block_permutation","cull_against_full_and_opaque":false,
+            "geometry_part":{"bone":"body","cube":1,"face":"west"}}]}}
+            """);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final var shape = new VoxelShapeRegistry.Shape(1, 1, 1, new byte[]{1}, List.of(0F, 0.5F), List.of(0F, 1F), List.of(0F, 1F));
+        storage.setVoxelShapes(new VoxelShapeRegistry.Snapshot(List.of(shape), Map.of("test:half", 0), 1));
+        final CompoundTag components = components("geometry.test");
+        final CompoundTag geometry = components.getCompoundTag("minecraft:geometry");
+        geometry.putString("culling", "test:cull");
+        geometry.putString("culling_shape", "test:half");
+        final CompoundTag transform = new CompoundTag();
+        transform.putFloat("RY", 1);
+        components.put("minecraft:transformation", transform);
+        final var visual = CustomBlockModel.compile(storage, "test:block[side=true]", 42, components);
+        assertNotNull(visual);
+        final var model = JsonParser.parseString(visual.modelJson()).getAsJsonObject();
+        final var elements = model.getAsJsonArray("elements");
+        assertEquals(1, elements.size());
+        final var faces = elements.get(0).getAsJsonObject().getAsJsonObject("faces");
+        assertEquals(List.of(new Rule(Direction.NORTH, Condition.SAME_BLOCK_PERMUTATION, false)), rules(faces.getAsJsonObject("west").get(KEY)));
+        assertFalse(faces.getAsJsonObject("east").has(KEY));
+        final var compiled = CustomBlockCulling.decode(CustomBlockCulling.encode(Map.of(42, visual))).get(42);
+        assertEquals("test:block[side=true]", compiled.permutation());
+        assertTrue(compiled.directions().isEmpty());
+        assertEquals(List.of(new Rectangle(0, 0, 1, 1)), compiled.slice(Direction.NORTH));
+        assertTrue(compiled.slice(Direction.SOUTH).isEmpty());
+        assertEquals(List.of(new Rectangle(0, 0, 1, 0.5)), compiled.slice(Direction.DOWN));
+        assertEquals(-8, storage.getModels().blockModels().get("geometry.test").getParents().get(0).getCubes().get(1).getPosition().getX());
+        content.putString("block_culling/test.json", content.getString("block_culling/test.json")
+                .replace("\"condition\":\"same_block_permutation\",", ""));
+        final var defaultStorage = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        defaultStorage.setVoxelShapes(storage.getVoxelShapes());
+        final var defaultVisual = CustomBlockModel.compile(defaultStorage, "test:block[side=true]", 42, components);
+        assertNotNull(defaultVisual);
+        assertEquals(java.util.Set.of(Direction.NORTH), decode(encode(Map.of(42, defaultVisual))).get(42).directions());
+    }
+
+    @Test
+    void suppliesUnitCubeDefaultsWithoutPreventingEquivalentStateSharing() {
+        final var storage = new ResourcePackStorage(List.of());
+        final var visual = CustomBlockModel.compile(storage, "test:block", 42, components("minecraft:geometry.full_block"));
+        assertNotNull(visual);
+        final var compiled = decode(encode(Map.of(42, visual))).get(42);
+        assertTrue(compiled.identifier().isEmpty());
+        assertTrue(compiled.permutation().isEmpty());
+        assertTrue(compiled.directions().isEmpty());
+        for (Direction direction : Direction.values()) {
+            assertEquals(List.of(new Rectangle(0, 0, 1, 1)), compiled.slice(direction));
+        }
+    }
+
+    @Test
+    void doesNotInventAuthoredBoneBindingsForBuiltinCubes() {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("block_culling/test.json", """
+            {"format_version":"1.21.80","minecraft:block_culling_rules":{"description":{"identifier":"test:cull"},"rules":[
+            {"direction":"south","cull_against_full_and_opaque":false,"geometry_part":{"bone":"block"}},
+            {"direction":"north","condition":"same_block","geometry_part":{"bone":"block"}}]}}
+            """);
+        final var storage = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final var components = components("minecraft:geometry.full_block");
+        components.getCompoundTag("minecraft:geometry").putString("culling", "test:cull");
+        final var visual = CustomBlockModel.compile(storage, "test:block", 42, components);
+        assertNotNull(visual);
+        final var compiled = decode(encode(Map.of(42, visual))).get(42);
+        assertTrue(compiled.directions().isEmpty());
+        assertEquals(List.of(new Rectangle(0, 0, 1, 1)), compiled.slice(Direction.SOUTH));
+    }
+
+    @Test
+    void compactsDenseNativeGridSlicesWithoutFillingHoles() {
+        final List<Box> cells = new ArrayList<>();
+        for (int x = 0; x < 32; x++) {
+            for (int y = 0; y < 32; y++) {
+                cells.add(new Box(x / 32D, y / 32D, 0, (x + 1) / 32D, (y + 1) / 32D, 1));
+            }
+        }
+        final List<Rectangle> whole = List.of(new Rectangle(0, 0, 1, 1));
+        assertEquals(whole, CustomBlockCullingCompiler.slice(cells, Direction.NORTH));
+        cells.remove(16 * 32 + 16);
+        final List<Rectangle> compact = CustomBlockCullingCompiler.slice(cells, Direction.NORTH);
+        assertTrue(compact.size() < 10);
+        assertFalse(covers(whole, compact));
+        assertTrue(covers(List.of(new Rectangle(0, 0, 0.5, 0.5)), compact));
+        assertFalse(covers(List.of(new Rectangle(0.5, 0.5, 17 / 32D, 17 / 32D)), compact));
+    }
+
+    private static CompoundTag components(final String identifier) {
+        final CompoundTag result = new CompoundTag();
+        final CompoundTag geometry = new CompoundTag();
+        geometry.putString("identifier", identifier);
+        result.put("minecraft:geometry", geometry);
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", identifier.startsWith("geometry.") ? "skin" : "obsidian");
+        final CompoundTag materials = new CompoundTag();
+        materials.put("*", material);
+        result.put("minecraft:material_instances", materials);
+        return result;
+    }
+
+}
