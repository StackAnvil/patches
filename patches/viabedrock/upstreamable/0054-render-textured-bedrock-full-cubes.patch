+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.Gson;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.LinkedHashMap;
+import java.util.Set;
+import java.util.TreeSet;
+
+/** Native culling rules and face slices, independent of collision, Java carriers and connection route. */
+public final class CustomBlockCulling {
+
+    public static final String KEY = "viabedrock_culling";
+    public static final String RESOURCE_PATH = "assets/viabedrock/block_culling.json";
+    private static final Gson GSON = new Gson();
+
+    private CustomBlockCulling() {
+    }
+
+    public static JsonElement json(final Object value) {
+        return GSON.toJsonTree(value);
+    }
+
+    public static List<Rule> rules(final JsonElement json) {
+        if (json.getAsJsonArray().size() > 512) {
+            throw new IllegalArgumentException("Too many face culling rules");
+        }
+        final List<Rule> rules = new ArrayList<>();
+        for (JsonElement value : json.getAsJsonArray()) {
+            rules.add(GSON.fromJson(value, Rule.class));
+        }
+        return List.copyOf(rules);
+    }
+
+    public static JsonObject encode(final Map<Integer, CustomBlockVisual> visuals) {
+        final JsonObject root = new JsonObject();
+        root.addProperty("format", 1);
+        root.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        root.addProperty("java_protocol", ProtocolConstants.JAVA_VERSION.getVersion());
+        final JsonObject states = new JsonObject();
+        visuals.entrySet().stream().sorted(Map.Entry.comparingByKey()).forEach(entry -> {
+            final JsonObject model = JsonParser.parseString(entry.getValue().modelJson()).getAsJsonObject();
+            if (model.has(KEY)) {
+                states.add(String.valueOf(entry.getKey()), model.get(KEY));
+            }
+        });
+        root.add("states", states);
+        return root;
+    }
+
+    public static Map<Integer, Definition> decode(final JsonElement json) {
+        final JsonObject root = json.getAsJsonObject();
+        if (root.get("format").getAsBigDecimal().intValueExact() != 1
+                || root.get("bedrock_protocol").getAsBigDecimal().intValueExact() != ProtocolConstants.BEDROCK_PROTOCOL_VERSION
+                || root.get("java_protocol").getAsBigDecimal().intValueExact() != ProtocolConstants.JAVA_VERSION.getVersion()) {
+            throw new IllegalArgumentException("Unsupported block culling metadata version");
+        }
+        final JsonObject states = root.getAsJsonObject("states");
+        if (states.size() > 4096) {
+            throw new IllegalArgumentException("Too many custom culling states");
+        }
+        final Map<Integer, Definition> definitions = new LinkedHashMap<>();
+        for (Map.Entry<String, JsonElement> entry : states.entrySet()) {
+            final int state = Integer.parseInt(entry.getKey());
+            if (state < 0 || definitions.putIfAbsent(state, GSON.fromJson(entry.getValue(), Definition.class)) != null) {
+                throw new IllegalArgumentException("Invalid custom culling state");
+            }
+        }
+        return Map.copyOf(definitions);
+    }
+
+    /** Tests union coverage, including holes, unequal coordinate grids and slices outside the unit face. */
+    public static boolean covers(final List<Rectangle> target, final List<Rectangle> covering) {
+        if (target.isEmpty() || covering.isEmpty()) {
+            return false;
+        }
+        for (Rectangle rectangle : target) {
+            final TreeSet<Double> boundaries = new TreeSet<>(List.of(rectangle.minU(), rectangle.maxU()));
+            for (Rectangle cover : covering) {
+                if (cover.minU() > rectangle.minU() && cover.minU() < rectangle.maxU()) {
+                    boundaries.add(cover.minU());
+                }
+                if (cover.maxU() > rectangle.minU() && cover.maxU() < rectangle.maxU()) {
+                    boundaries.add(cover.maxU());
+                }
+            }
+            final List<Double> columns = new ArrayList<>(boundaries);
+            for (int column = 1; column < columns.size(); column++) {
+                final double min = columns.get(column - 1);
+                final double max = columns.get(column);
+                final List<Rectangle> intervals = covering.stream().filter(cover -> cover.minU() <= min && cover.maxU() >= max)
+                        .sorted(Comparator.comparingDouble(Rectangle::minV)).toList();
+                double reached = rectangle.minV();
+                for (Rectangle interval : intervals) {
+                    if (interval.minV() > reached) {
+                        break;
+                    }
+                    reached = Math.max(reached, interval.maxV());
+                    if (reached >= rectangle.maxV()) {
+                        break;
+                    }
+                }
+                if (reached < rectangle.maxV()) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    public enum Direction {
+        DOWN(1, false), UP(1, true), NORTH(2, false), SOUTH(2, true), WEST(0, false), EAST(0, true);
+
+        private final int axis;
+        private final boolean positive;
+
+        Direction(final int axis, final boolean positive) {
+            this.axis = axis;
+            this.positive = positive;
+        }
+
+        public int axis() {
+            return this.axis;
+        }
+
+        public boolean positive() {
+            return this.positive;
+        }
+
+        public Direction opposite() {
+            return values()[this.ordinal() ^ 1];
+        }
+    }
+
+    public enum Condition {
+        DEFAULT, SAME_BLOCK, SAME_BLOCK_PERMUTATION, SAME_CULLING_LAYER;
+
+        public static Condition fromAuthored(final String condition) {
+            if (condition == null) {
+                return DEFAULT;
+            }
+            return switch (condition) {
+                case "same_block" -> SAME_BLOCK;
+                case "same_block_permutation" -> SAME_BLOCK_PERMUTATION;
+                case "same_culling_layer" -> SAME_CULLING_LAYER;
+                default -> throw new IllegalArgumentException("Unsupported authored culling condition: " + condition);
+            };
+        }
+    }
+
+    public record Rule(Direction direction, Condition condition, boolean cullAgainstFullAndOpaque) {
+
+        public Rule {
+            if (direction == null || condition == null) {
+                throw new IllegalArgumentException("Missing culling rule direction or condition");
+            }
+        }
+    }
+
+    public record Rectangle(double minU, double minV, double maxU, double maxV) {
+
+        public Rectangle {
+            if (!Double.isFinite(minU) || !Double.isFinite(minV) || !Double.isFinite(maxU) || !Double.isFinite(maxV)
+                    || minU >= maxU || minV >= maxV) {
+                throw new IllegalArgumentException("Invalid culling face rectangle");
+            }
+        }
+    }
+
+    public record Definition(String identifier, String permutation, String layer,
+                             Map<Direction, List<Rectangle>> slices, Set<Direction> directions) {
+
+        public Definition {
+            if (identifier == null || permutation == null || layer == null || slices == null || directions == null
+                    || identifier.length() > 4096 || permutation.length() > 4096 || layer.length() > 4096 || slices.size() > 6) {
+                throw new IllegalArgumentException("Invalid custom culling definition");
+            }
+            final Map<Direction, List<Rectangle>> copy = new LinkedHashMap<>();
+            slices.forEach((direction, rectangles) -> {
+                if (direction == null || rectangles.size() > 16384) {
+                    throw new IllegalArgumentException("Invalid culling face slice");
+                }
+                copy.put(direction, List.copyOf(rectangles));
+            });
+            slices = Map.copyOf(copy);
+            directions = Set.copyOf(directions);
+        }
+
+        public List<Rectangle> slice(final Direction direction) {
+            return this.slices.getOrDefault(direction, List.of());
+        }
+    }
+
+}
