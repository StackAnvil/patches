+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.util.Key;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Condition;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Direction;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Rule;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.logging.Level;
+
+/** Ordered resource-pack rules retain the authored bone, cube and face selection. */
+public final class BlockCullingDefinitions {
+
+    private final Map<String, List<Part>> definitions = new HashMap<>();
+    private final boolean needsIdentifier;
+    private final boolean needsPermutation;
+
+    public BlockCullingDefinitions(final ResourcePackStorage storage) {
+        for (ResourcePack pack : storage.getPackStackBottomToTop()) {
+            for (String path : pack.content().getFilesDeep("block_culling/", ".json")) {
+                try {
+                    final JsonObject definition = pack.content().getJson(path).getAsJsonObject("minecraft:block_culling_rules");
+                    final String identifier = Key.namespaced(definition.getAsJsonObject("description").get("identifier").getAsString());
+                    final List<Part> parts = new ArrayList<>();
+                    if (definition.getAsJsonArray("rules").size() > 512) {
+                        throw new IllegalArgumentException("Too many block culling rules");
+                    }
+                    for (JsonElement element : definition.getAsJsonArray("rules")) {
+                        final JsonObject rule = element.getAsJsonObject();
+                        final JsonObject part = rule.getAsJsonObject("geometry_part");
+                        final Direction direction = Direction.valueOf(rule.get("direction").getAsString().toUpperCase(Locale.ROOT));
+                        final Condition condition = Condition.fromAuthored(rule.has("condition") ? rule.get("condition").getAsString() : null);
+                        final int cube = part.has("cube") ? part.get("cube").getAsBigDecimal().intValueExact() : -1;
+                        if (cube < -1) {
+                            throw new IllegalArgumentException("Invalid culling cube index");
+                        }
+                        final Direction face = part.has("face") ? Direction.valueOf(part.get("face").getAsString().toUpperCase(Locale.ROOT)) : null;
+                        parts.add(new Part(part.get("bone").getAsString(), cube, face,
+                                new Rule(direction, condition, !rule.has("cull_against_full_and_opaque") || rule.get("cull_against_full_and_opaque").getAsBoolean())));
+                    }
+                    this.definitions.put(identifier, List.copyOf(parts));
+                } catch (final RuntimeException error) {
+                    ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to parse block culling definition " + path + " in pack " + pack.key(), error);
+                }
+            }
+        }
+        final var rules = this.definitions.values().stream().flatMap(List::stream).map(Part::rule).toList();
+        this.needsPermutation = rules.stream().anyMatch(rule -> rule.condition() == Condition.SAME_BLOCK_PERMUTATION);
+        this.needsIdentifier = this.needsPermutation || rules.stream().anyMatch(rule -> rule.condition() == Condition.SAME_BLOCK);
+    }
+
+    public List<Part> get(final String identifier) {
+        return this.definitions.getOrDefault(Key.namespaced(identifier), List.of());
+    }
+
+    public boolean needsIdentifier() {
+        return this.needsIdentifier;
+    }
+
+    public boolean needsPermutation() {
+        return this.needsPermutation;
+    }
+
+    public record Part(String bone, int cube, Direction face, CustomBlockCulling.Rule rule) {
+
+        public boolean matches(final String boneName, final int cubeIndex, final Direction cubeFace) {
+            return this.bone.equals(boneName) && (this.cube == -1 || this.cube == cubeIndex) && (this.face == null || this.face == cubeFace);
+        }
+    }
+
+}
