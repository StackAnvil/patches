+    static String fingerprint(final ResourcePackStorage storage) {
+        final StringBuilder identity = new StringBuilder(fingerprint(storage.getPackStackTopToBottom()));
+        storage.getCustomBlockVisuals().entrySet().stream().sorted(java.util.Map.Entry.comparingByKey()).forEach(entry -> {
+            final var visual = entry.getValue();
+            identity.append('\n').append(entry.getKey()).append(':').append(visual.bedrockState()).append(':').append(visual.modelJson());
+        });
+        return HexFormat.of().formatHex(digest("SHA-256").digest(identity.toString().getBytes(StandardCharsets.UTF_8)));
+    }
+
     private static void writeString(final DataOutputStream output, final String value) throws IOException {
