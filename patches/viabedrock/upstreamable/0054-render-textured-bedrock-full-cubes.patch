+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import net.raphimc.viabedrock.api.util.MoLangEngine;
+import team.unnamed.mocha.runtime.Scope;
+import team.unnamed.mocha.runtime.value.Function;
+import team.unnamed.mocha.runtime.value.MutableObjectBinding;
+import team.unnamed.mocha.runtime.value.Value;
+
+import java.io.IOException;
+import java.util.Map;
+
+/** Resolves component overlays against one concrete state without modifying server definitions. */
+public final class CustomBlockDefinition {
+
+    private CustomBlockDefinition() {
+    }
+
+    public static CompoundTag resolve(final CompoundTag definition, final CompoundTag states) throws IOException {
+        final CompoundTag components = definition.get("components") instanceof CompoundTag base ? base.copy() : new CompoundTag();
+        final Scope scope = Scope.create();
+        final MutableObjectBinding queries = new MutableObjectBinding();
+        final Function<Void> property = (context, arguments) -> {
+            final Value argument = arguments.next().eval();
+            final Tag value = argument == null ? null : states.get(argument.getAsString());
+            return value == null ? Value.nil() : Value.of(value.getValue());
+        };
+        queries.set("block_property", property);
+        queries.set("block_state", property);
+        queries.block();
+        scope.set("query", queries);
+        scope.set("q", queries);
+        scope.readOnly(true);
+        final ListTag<CompoundTag> permutations = definition.getListTag("permutations", CompoundTag.class);
+        if (permutations != null) {
+            for (CompoundTag permutation : permutations) {
+                if (permutation.get("condition") instanceof StringTag condition
+                        && MoLangEngine.eval(scope, condition.getValue()).getAsNumber() != 0
+                        && permutation.get("components") instanceof CompoundTag overlay) {
+                    for (Map.Entry<String, Tag> component : overlay) {
+                        components.put(component.getKey(), component.getValue().copy());
+                    }
+                }
+            }
+        }
+        return components;
+    }
+
+}
