+
+    @Test
+    void resolvesEveryBooleanFaceCombination() throws Exception {
+        final List<String> faces = List.of("up", "west", "east", "south", "down", "north");
+        final CompoundTag definition = new CompoundTag();
+        final ListTag<CompoundTag> permutations = new ListTag<>(CompoundTag.class);
+        for (int mask = 0; mask < 64; mask++) {
+            final StringBuilder condition = new StringBuilder();
+            final CompoundTag overlay = new CompoundTag();
+            overlay.putInt("face_mask", mask);
+            for (int bit = 0; bit < faces.size(); bit++) {
+                if (bit > 0) {
+                    condition.append("&&");
+                }
+                if ((mask & (1 << bit)) == 0) {
+                    condition.append('!');
+                }
+                condition.append("q.block_state('").append(faces.get(bit)).append("')");
+            }
+            permutations.add(permutation(condition.toString(), overlay));
+        }
+        definition.put("permutations", permutations);
+        for (int mask = 0; mask < 64; mask++) {
+            final CompoundTag states = new CompoundTag();
+            for (int bit = 0; bit < faces.size(); bit++) {
+                states.putByte(faces.get(bit), (byte) ((mask >>> bit) & 1));
+            }
+            assertEquals(mask, CustomBlockDefinition.resolve(definition, states).getIntTag("face_mask").asInt());
+        }
+    }
+
+    @Test
+    void convertsTextureAlphaAccordingToTheMaterialWithoutMutatingSource() {
+        final BufferedImage pixels = new BufferedImage(2, 1, BufferedImage.TYPE_INT_ARGB);
+        pixels.setRGB(0, 0, 0x7F123456);
+        pixels.setRGB(1, 0, 0x80123456);
+        final ResourcePackStorage storage = new ResourcePackStorage(List.of(pack(pixels)));
+        final var texture = CustomBlockResourceRewriter.terrainTexture(storage, "ruby");
+        final var cutout = CustomBlockResourceRewriter.materialTexture(texture, "alpha_test");
+        assertEquals(0, cutout.getRGB(0, 0) >>> 24);
+        assertEquals(255, cutout.getRGB(1, 0) >>> 24);
+        assertEquals(255, CustomBlockResourceRewriter.materialTexture(texture, "opaque").getRGB(0, 0) >>> 24);
+        assertEquals(127, CustomBlockResourceRewriter.materialTexture(texture, "blend").getRGB(0, 0) >>> 24);
+        assertEquals(127, texture.getImage().getRGB(0, 0) >>> 24);
+    }
+
+    private static void assertParticleTexture(final JsonObject model) {
+        final var textures = model.getAsJsonObject("textures");
+        final var particle = textures.get("particle");
+        assertNotNull(particle);
+        assertTrue(textures.entrySet().stream().filter(entry -> !entry.getKey().equals("particle"))
+                .map(entry -> entry.getValue().isJsonObject() ? entry.getValue().getAsJsonObject().get("sprite") : entry.getValue())
+                .anyMatch(particle::equals));
+    }
+
+    private static CompoundTag permutation(final String condition, final CompoundTag components) {
+        final CompoundTag result = new CompoundTag();
+        result.putString("condition", condition);
+        result.put("components", components);
+        return result;
+    }
+
+    private static CompoundTag geometry(final String identifier) {
+        final CompoundTag result = new CompoundTag();
+        result.putString("identifier", identifier);
+        return result;
+    }
+
+    private static CompoundTag components(final String geometry, final String texture, final String method) {
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", texture);
+        material.putString("render_method", method);
+        final CompoundTag materials = new CompoundTag();
+        materials.put("*", material);
+        final CompoundTag result = new CompoundTag();
+        result.put("minecraft:material_instances", materials);
+        result.put("minecraft:geometry", geometry(geometry));
+        return result;
+    }
+
+    private static ResourcePack pack(final BufferedImage pixels) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"ruby\":{\"textures\":\"textures/blocks/ruby\"},\"gold\":{\"textures\":\"textures/blocks/gold\"}}}");
+        content.putPngImage("textures/blocks/ruby.png", pixels);
+        content.putPngImage("textures/blocks/gold.png", pixels);
+        content.putString("blocks.json", "{\"format_version\":\"1.1.0\",\"test:legacy\":{\"textures\":{\"side\":\"ruby\",\"up\":\"gold\",\"down\":\"ruby\"}}}");
+        content.putString("models/blocks/test.json", "{\"format_version\":\"1.12.0\",\"minecraft:geometry\":[{\"description\":{\"identifier\":\"geometry.test\",\"texture_width\":64,\"texture_height\":64},\"bones\":[{\"name\":\"root\",\"pivot\":[0,0,0],\"cubes\":[{\"origin\":[-8,0,-8],\"size\":[16,8,16],\"uv\":[0,0]}]}]}]}");
+        return new ResourcePack(content);
+    }
+
+}
