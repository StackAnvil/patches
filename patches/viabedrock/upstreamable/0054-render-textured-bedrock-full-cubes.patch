+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CustomBlockModel;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.util.element.Direction;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.Locale;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomBlockPlaneGeometryTest {
+
+    @Test
+    void preservesTexelsAtEachPlaneCornerForBothWindingsAndEveryUvRotation() {
+        for (final Direction direction : Direction.values()) {
+            final int axis = axis(direction);
+            final String name = direction.name().toLowerCase(Locale.ROOT);
+            final String size = switch (axis) {
+                case 0 -> "[0,10,12]";
+                case 1 -> "[10,0,12]";
+                default -> "[10,12,0]";
+            };
+            final ResourcePackStorage storage = storage(size, "\"" + name + "\":{\"uv\":[12,2],\"uv_size\":[-8,10]}");
+            final var cube = storage.getModels().blockModels().get("geometry.test").getParents().get(0).getCubes().get(0);
+            for (int rotation = 0; rotation < 360; rotation += 90) {
+                cube.getUvMap().getUvRotation().put(direction, (float) rotation);
+                final CompoundTag components = components("alpha_test");
+                components.getCompoundTag("minecraft:material_instances").getCompoundTag("*").putByte("face_dimming", (byte) 0);
+                final JsonObject model = compile(storage, components);
+                final var elements = model.getAsJsonArray("elements");
+                assertEquals(1, elements.size());
+                final JsonObject element = elements.get(0).getAsJsonObject();
+                final JsonObject faces = element.getAsJsonObject("faces");
+                assertEquals(2, faces.size());
+                final JsonObject front = faces.getAsJsonObject(name);
+                final JsonObject back = faces.getAsJsonObject(opposite(direction));
+                assertEquals(front.get("texture"), back.get("texture"));
+                assertEquals("up", element.get("shade_direction_override").getAsString());
+                assertEquals(element.getAsJsonArray("from").get(axis), element.getAsJsonArray("to").get(axis));
+                assertNotNull(element.get("rotation"));
+                // Java 26.3 FaceInfo reverses U on vertical faces and V on
+                // horizontal faces. Compare texels at the same physical corner.
+                for (int corner = 0; corner < 4; corner++) {
+                    final int corresponding = Math.floorMod((axis == 1 ? 1 : 3) - corner, 4);
+                    assertArrayEquals(uv(front, corner), uv(back, corresponding), 1E-8);
+                }
+                assertEquals(model, compile(storage, components));
+                assertEquals(0, axis == 0 ? cube.getSize().getX() : axis == 1 ? cube.getSize().getY() : cube.getSize().getZ());
+                assertEquals(12, cube.getUvMap().getUvMap().get(direction)[0]);
+                assertEquals(4, cube.getUvMap().getUvMap().get(direction)[2]);
+            }
+        }
+    }
+
+    @Test
+    void leavesSingleSidedOpaqueBlendedAndSolidGeometryUnchanged() {
+        final ResourcePackStorage plane = storage("[0,10,12]", "\"west\":{\"uv\":[12,2],\"uv_size\":[-8,10]}");
+        for (final String method : List.of("alpha_test_single_sided", "opaque", "blend")) {
+            assertEquals(1, compile(plane, components(method)).getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces").size());
+        }
+        final ResourcePackStorage solid = storage("[2,10,12]", "\"west\":{\"uv\":[12,2],\"uv_size\":[-8,10]}");
+        assertEquals(1, compile(solid, components("alpha_test")).getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces").size());
+        final var cube = plane.getModels().blockModels().get("geometry.test").getParents().get(0).getCubes().get(0);
+        cube.setInflate(0.25F);
+        assertEquals(1, compile(plane, components("alpha_test")).getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces").size());
+    }
+
+    @Test
+    void retainsDistinctAuthoredOppositeFacesAcrossDimmingPartitions() {
+        final ResourcePackStorage storage = storage("[0,10,12]", """
+                "west":{"uv":[12,2],"uv_size":[-8,10]},
+                "east":{"uv":[1,3],"uv_size":[6,9]}
+                """);
+        final CompoundTag components = components("alpha_test");
+        final CompoundTag materials = components.getCompoundTag("minecraft:material_instances");
+        final CompoundTag west = materials.getCompoundTag("*").copy();
+        west.putByte("face_dimming", (byte) 0);
+        materials.put("west", west);
+        final JsonObject model = compile(storage, components);
+        assertEquals(2, model.getAsJsonArray("elements").size());
+        int westFaces = 0;
+        int eastFaces = 0;
+        for (final var value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            final JsonObject faces = element.getAsJsonObject("faces");
+            assertEquals(1, faces.size());
+            if (faces.has("west")) {
+                westFaces++;
+                assertEquals("up", element.get("shade_direction_override").getAsString());
+                assertEquals("#WEST", faces.getAsJsonObject("west").get("texture").getAsString());
+            } else {
+                eastFaces++;
+                assertFalse(element.has("shade_direction_override"));
+                assertEquals("#EAST", faces.getAsJsonObject("east").get("texture").getAsString());
+            }
+        }
+        assertEquals(1, westFaces);
+        assertEquals(1, eastFaces);
+    }
+
+    private static double[] uv(final JsonObject face, final int corner) {
+        final int rotated = (corner + (face.has("rotation") ? face.get("rotation").getAsInt() / 90 : 0)) % 4;
+        final var uv = face.getAsJsonArray("uv");
+        return new double[]{uv.get(rotated < 2 ? 0 : 2).getAsDouble(), uv.get(rotated == 0 || rotated == 3 ? 1 : 3).getAsDouble()};
+    }
+
+    private static int axis(final Direction direction) {
+        return switch (direction) {
+            case EAST, WEST -> 0;
+            case UP, DOWN -> 1;
+            case NORTH, SOUTH -> 2;
+        };
+    }
+
+    private static String opposite(final Direction direction) {
+        return switch (direction) {
+            case EAST -> "west";
+            case WEST -> "east";
+            case UP -> "down";
+            case DOWN -> "up";
+            case NORTH -> "south";
+            case SOUTH -> "north";
+        };
+    }
+
+    private static JsonObject compile(final ResourcePackStorage storage, final CompoundTag components) {
+        final var visual = CustomBlockModel.compile(storage, "test:plant", 1, components);
+        assertNotNull(visual);
+        return JsonParser.parseString(visual.modelJson()).getAsJsonObject();
+    }
+
+    private static CompoundTag components(final String method) {
+        final CompoundTag components = new CompoundTag();
+        components.putString("minecraft:geometry", "geometry.test");
+        final CompoundTag materials = new CompoundTag();
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", "skin");
+        material.putString("render_method", method);
+        materials.put("*", material);
+        components.put("minecraft:material_instances", materials);
+        return components;
+    }
+
+    private static ResourcePackStorage storage(final String size, final String faces) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"}}");
+        content.putString("textures/terrain_texture.json", "{\"texture_data\":{\"skin\":{\"textures\":\"textures/blocks/skin\"}}}");
+        content.putPngImage("textures/blocks/skin.png", new BufferedImage(16, 16, BufferedImage.TYPE_INT_RGB));
+        content.putString("models/blocks/test.json", """
+                {"format_version":"1.12.0","minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":16,"texture_height":16},
+                 "bones":[{"name":"root","cubes":[{"origin":[0,0,0],"size":%s,"pivot":[2,3,4],"rotation":[12,25,8],"uv":{%s}}]}]}]}
+                """.formatted(size, faces));
+        return new ResourcePackStorage(List.of(new ResourcePack(content)));
+    }
+
+}
