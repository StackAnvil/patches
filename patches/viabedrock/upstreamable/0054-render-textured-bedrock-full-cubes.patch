+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Condition;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Direction;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Rectangle;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Rule;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual.Box;
+import net.raphimc.viabedrock.api.resourcepack.definition.BlockCullingDefinitions.Part;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.Locale;
+
+/** Compiles authored face rules and transformed native grids into route-independent model metadata. */
+final class CustomBlockCullingCompiler {
+
+    private CustomBlockCullingCompiler() {
+    }
+
+    static void apply(final ResourcePackStorage storage, final String state, final Tag geometry, final boolean fullCube,
+                      final JsonObject model, final CustomBlockModel.Transform transform) {
+        final String identifier = string(geometry, "culling", "");
+        final List<Part> parts = identifier.isEmpty() ? List.of() : storage.getBlockCulling().get(identifier);
+        final Set<Direction> directions = new LinkedHashSet<>();
+        for (JsonElement value : model.getAsJsonArray("elements")) {
+            final JsonObject element = value.getAsJsonObject();
+            final String bone = fullCube ? null : element.remove("viabedrock_bone").getAsString();
+            final int cube = fullCube ? -1 : element.remove("viabedrock_cube").getAsInt();
+            for (Map.Entry<String, JsonElement> face : element.getAsJsonObject("faces").entrySet()) {
+                final Direction direction = Direction.valueOf(face.getKey().toUpperCase(Locale.ROOT));
+                final List<Rule> rules = new ArrayList<>();
+                if (fullCube) {
+                    rules.add(new Rule(transform.direction(direction), Condition.DEFAULT, true));
+                }
+                for (Part part : parts) {
+                    if (part.matches(bone, cube, direction)) {
+                        final Rule rule = new Rule(transform.direction(part.rule().direction()), part.rule().condition(), part.rule().cullAgainstFullAndOpaque());
+                        rules.add(rule);
+                        if (rule.condition() == Condition.DEFAULT) {
+                            directions.add(rule.direction());
+                        }
+                    }
+                }
+                if (!rules.isEmpty()) {
+                    face.getValue().getAsJsonObject().add(CustomBlockCulling.KEY, CustomBlockCulling.json(rules));
+                }
+            }
+        }
+        final String shape = fullCube ? "minecraft:unit_cube" : string(geometry, "culling_shape", "minecraft:empty");
+        final List<Box> boxes = boxes(storage, shape, transform);
+        final Map<Direction, List<Rectangle>> slices = new LinkedHashMap<>();
+        for (Direction direction : Direction.values()) {
+            slices.put(direction, slice(boxes, direction));
+        }
+        final var definitions = storage.getBlockCulling();
+        final String block = state.contains("[") ? state.substring(0, state.indexOf('[')) : state;
+        model.add(CustomBlockCulling.KEY, CustomBlockCulling.json(new CustomBlockCulling.Definition(
+                definitions.needsIdentifier() ? block : "", definitions.needsPermutation() ? state : "",
+                string(geometry, "culling_layer", "minecraft:culling_layer.undefined"), slices, directions)));
+    }
+
+    private static String string(final Tag tag, final String key, final String fallback) {
+        return tag instanceof CompoundTag compound && compound.get(key) instanceof StringTag string ? string.getValue() : fallback;
+    }
+
+    private static List<Box> boxes(final ResourcePackStorage storage, final String name, final CustomBlockModel.Transform transform) {
+        final List<Box> boxes = new ArrayList<>();
+        if (name.equals("minecraft:unit_cube")) {
+            boxes.add(transformed(new double[]{0, 0, 0}, new double[]{1, 1, 1}, transform));
+            return boxes;
+        }
+        final var shape = storage.getVoxelShapes().shape(name);
+        if (shape == null) {
+            return List.of();
+        }
+        for (int x = 0; x < shape.xSize(); x++) {
+            for (int y = 0; y < shape.ySize(); y++) {
+                for (int z = 0; z < shape.zSize(); z++) {
+                    if (shape.occupied(x, y, z)) {
+                        boxes.add(transformed(new double[]{shape.xCoordinates().get(x), shape.yCoordinates().get(y), shape.zCoordinates().get(z)},
+                                new double[]{shape.xCoordinates().get(x + 1), shape.yCoordinates().get(y + 1), shape.zCoordinates().get(z + 1)}, transform));
+                    }
+                }
+            }
+        }
+        return boxes;
+    }
+
+    private static Box transformed(final double[] from, final double[] to, final CustomBlockModel.Transform transform) {
+        final double[] min = {Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY};
+        final double[] max = {Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY};
+        for (int corner = 0; corner < 8; corner++) {
+            final double[] point = transform.point(new double[]{((corner & 1) == 0 ? from[0] : to[0]) * 16,
+                ((corner & 2) == 0 ? from[1] : to[1]) * 16, ((corner & 4) == 0 ? from[2] : to[2]) * 16});
+            for (int axis = 0; axis < 3; axis++) {
+                final double coordinate = Math.abs(point[axis]) < 1E-8 ? 0 : Math.abs(point[axis] - 16) < 1E-8 ? 1 : point[axis] / 16;
+                min[axis] = Math.min(min[axis], coordinate);
+                max[axis] = Math.max(max[axis], coordinate);
+            }
+        }
+        return new Box(min[0], min[1], min[2], max[0], max[1], max[2]);
+    }
+
+    static List<Rectangle> slice(final List<Box> boxes, final Direction direction) {
+        final List<Rectangle> slice = new ArrayList<>();
+        final int axis = direction.axis();
+        final int u = axis == 0 ? 2 : 0;
+        final int v = axis == 1 ? 2 : 1;
+        for (Box box : boxes) {
+            final double[] min = {box.minX(), box.minY(), box.minZ()};
+            final double[] max = {box.maxX(), box.maxY(), box.maxZ()};
+            final boolean intersects = direction.positive() ? min[axis] < 1 && max[axis] >= 1 : min[axis] <= 0 && max[axis] > 0;
+            if (intersects) {
+                slice.add(new Rectangle(min[u], min[v], max[u], max[v]));
+            }
+        }
+        // Grid cells do not overlap. Merge adjacent cells before transporting or comparing their face slices.
+        final List<Rectangle> rows = merge(slice, false);
+        return List.copyOf(merge(rows, true));
+    }
+
+    private static List<Rectangle> merge(final List<Rectangle> source, final boolean vertical) {
+        final Comparator<Rectangle> comparator = vertical
+                ? Comparator.comparingDouble(Rectangle::minU).thenComparingDouble(Rectangle::maxU).thenComparingDouble(Rectangle::minV)
+                : Comparator.comparingDouble(Rectangle::minV).thenComparingDouble(Rectangle::maxV).thenComparingDouble(Rectangle::minU);
+        final List<Rectangle> sorted = new ArrayList<>(source);
+        sorted.sort(comparator);
+        final List<Rectangle> result = new ArrayList<>();
+        for (Rectangle next : sorted) {
+            if (!result.isEmpty()) {
+                final Rectangle previous = result.get(result.size() - 1);
+                final boolean adjacent = vertical
+                        ? previous.minU() == next.minU() && previous.maxU() == next.maxU() && previous.maxV() == next.minV()
+                        : previous.minV() == next.minV() && previous.maxV() == next.maxV() && previous.maxU() == next.minU();
+                if (adjacent) {
+                    result.set(result.size() - 1, new Rectangle(previous.minU(), previous.minV(), next.maxU(), next.maxV()));
+                    continue;
+                }
+            }
+            result.add(next);
+        }
+        return result;
+    }
+
+}
