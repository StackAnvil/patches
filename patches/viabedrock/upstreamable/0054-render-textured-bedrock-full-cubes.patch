+        assertEquals(shaded.get("from"), unshaded.get("from"));
+        assertEquals(shaded.get("to"), unshaded.get("to"));
+        assertEquals(shaded.get("rotation"), unshaded.get("rotation"));
+        assertTrue(visual.occluding());
+        assertEquals(0, visual.lightEmission());
