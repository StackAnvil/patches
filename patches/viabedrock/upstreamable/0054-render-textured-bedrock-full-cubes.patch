+    public Map<String, String> terrainTextures() {
+        return Collections.unmodifiableMap(this.terrainTextures);
+    }
+
+    public Set<String> serverTerrainTextures() {
+        return Collections.unmodifiableSet(this.serverTerrainTextures);
+    }
+
+    private static String firstTexturePath(final JsonElement textures) {
+        if (textures == null || textures.isJsonNull()) {
+            return null;
+        }
+        if (textures.isJsonPrimitive()) {
+            return textures.getAsString();
+        }
+        if (textures.isJsonArray() && !textures.getAsJsonArray().isEmpty()) {
+            return firstTexturePath(textures.getAsJsonArray().get(0));
+        }
+        if (textures.isJsonObject()) {
+            final JsonObject texture = textures.getAsJsonObject();
+            if (texture.has("path")) {
+                return texture.get("path").getAsString();
+            }
+            if (texture.has("variations")) {
+                return firstTexturePath(texture.get("variations"));
+            }
+        }
+        return null;
+    }
+
     public record ItemTextureDefinition(String name, String texturePath) {
