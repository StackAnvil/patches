+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.definition.TextureDefinitions;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.List;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/** Retains target-native visuals where the mapped Java block has changed its appearance. */
+public final class VanillaBlockVisualResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    private static final List<Visual> VISUALS = List.of(
+            new Visual("redstone_torch", "redstone_torch_on", "template_torch", true),
+            new Visual("redstone_torch_off", "redstone_torch_off", "template_torch", false),
+            new Visual("redstone_wall_torch", "redstone_torch_on", "template_torch_wall", false),
+            new Visual("redstone_wall_torch_off", "redstone_torch_off", "template_torch_wall", false));
+
+    // Target 1.26.51.1 item_texture.json indexes beds by the legacy dye auxiliary value.
+    private static final List<String> BED_COLORS = List.of("white", "orange", "magenta", "light_blue",
+            "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black");
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> convert(storage));
+    }
+
+    static Content convert(final ResourcePackStorage storage) {
+        final Content output = new InMemoryContent();
+        for (final Visual visual : VISUALS) {
+            for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+                final var source = pack.content().getShortnameImage("textures/blocks/" + visual.nativeTexture);
+                if (source == null) {
+                    continue;
+                }
+                final var image = source.getImage();
+                // Preserve layer precedence even when the overriding image cannot be exported.
+                if (image.getWidth() <= 1024 && image.getHeight() <= 1024) {
+                    final String texture = "viabedrock:block/native/" + visual.nativeTexture;
+                    output.putPngImage("assets/viabedrock/textures/block/native/" + visual.nativeTexture + ".png", image);
+                    final JsonObject textures = new JsonObject();
+                    textures.addProperty("torch", texture);
+                    final JsonObject model = new JsonObject();
+                    model.addProperty("parent", "minecraft:block/" + visual.javaTemplate);
+                    model.add("textures", textures);
+                    output.putJson("assets/minecraft/models/block/" + visual.javaModel + ".json", model);
+                    if (visual.item) {
+                        final JsonObject item = new JsonObject();
+                        item.addProperty("parent", "minecraft:item/generated");
+                        final JsonObject layers = new JsonObject();
+                        layers.addProperty("layer0", texture);
+                        item.add("textures", layers);
+                        output.putJson("assets/minecraft/models/item/" + visual.javaModel + ".json", item);
+                    }
+                }
+                break;
+            }
+        }
+        convertBeds(storage, output);
+        convertGlassPanes(storage, output);
+        return output;
+    }
+
+    private static void convertBeds(final ResourcePackStorage storage, final Content output) {
+        final var definition = storage.getItems().get("minecraft:bed");
+        final String icon = definition != null && definition.iconComponent() != null ? definition.iconComponent() : "bed";
+        final List<TextureDefinitions.ItemTextureDefinition> textures = storage.getTextures().itemTextures().get(icon);
+        if (textures == null || textures.isEmpty()) {
+            return;
+        }
+        for (int index = 0; index < BED_COLORS.size(); index++) {
+            final int textureIndex = textures.size() == 1 ? 0 : index;
+            if (textureIndex >= textures.size()) {
+                continue;
+            }
+            final String name = BED_COLORS.get(index) + "_bed";
+            convertItemSprite(storage, output, name, textures.get(textureIndex).texturePath(), false);
+        }
+    }
+
+    private static void convertGlassPanes(final ResourcePackStorage storage, final Content output) {
+        convertGlassPane(storage, output, "glass_pane", "minecraft:glass_pane", "glass", 0);
+        for (int index = 0; index < BED_COLORS.size(); index++) {
+            convertGlassPane(storage, output, BED_COLORS.get(index) + "_stained_glass_pane",
+                    "minecraft:stained_glass_pane", "stained_glass", index);
+        }
+    }
+
+    private static void convertGlassPane(final ResourcePackStorage storage, final Content output, final String name,
+                                         final String identifier, final String terrainTexture, final int index) {
+        var definition = storage.getItems().get("minecraft:" + name);
+        if (definition == null) {
+            definition = storage.getItems().get(identifier);
+        }
+        if (definition != null && definition.iconComponent() != null) {
+            final var icons = storage.getTextures().itemTextures().get(definition.iconComponent());
+            if (icons != null && !icons.isEmpty()) {
+                convertItemSprite(storage, output, name, icons.getFirst().texturePath(), false);
+            }
+        } else {
+            convertItemSprite(storage, output, name, storage.getTextures().terrainTexture(terrainTexture, index), true);
+        }
+    }
+
+    private static void convertItemSprite(final ResourcePackStorage storage, final Content output, final String name,
+                                          final String texturePath, final boolean pane) {
+        if (texturePath == null) {
+            return;
+        }
+        for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+            final var source = pack.content().getShortnameImage(texturePath);
+            if (source == null) {
+                continue;
+            }
+            final var image = source.getImage();
+            if (image.getWidth() <= 1024 && image.getHeight() <= 1024) {
+                final String texture = "viabedrock:item/native/" + name;
+                output.putPngImage("assets/viabedrock/textures/item/native/" + name + ".png", image);
+                final JsonObject model = new JsonObject();
+                model.addProperty("parent", "minecraft:item/generated");
+                final JsonObject layers = new JsonObject();
+                layers.addProperty("layer0", texture);
+                model.add("textures", layers);
+                if (pane) {
+                    // The target-native inventory plate is tilted; held panes remain generated flat sprites.
+                    final JsonObject gui = new JsonObject();
+                    gui.add("rotation", vector(30, 225, 0));
+                    gui.add("scale", vector(0.75F, 0.75F, 0.75F));
+                    final JsonObject display = new JsonObject();
+                    display.add("gui", gui);
+                    model.add("display", display);
+                }
+                output.putJson("assets/viabedrock/models/item/native/" + name + ".json", model);
+                final JsonObject rendering = new JsonObject();
+                rendering.addProperty("type", "minecraft:model");
+                rendering.addProperty("model", "viabedrock:item/native/" + name);
+                final JsonObject item = new JsonObject();
+                item.add("model", rendering);
+                // Java beds use a special renderer, so changing only its model cannot select the native sprite.
+                output.putJson("assets/minecraft/items/" + name + ".json", item);
+            }
+            break;
+        }
+    }
+
+    private static JsonArray vector(final float... values) {
+        final JsonArray vector = new JsonArray();
+        for (final float value : values) {
+            vector.add(value);
+        }
+        return vector;
+    }
+
+    private record Visual(String javaModel, String nativeTexture, String javaTemplate, boolean item) { }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/VanillaBlockVisualResourceRewriterTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/resourcepack/VanillaBlockVisualResourceRewriterTest.java
