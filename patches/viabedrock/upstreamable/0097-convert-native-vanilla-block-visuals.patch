+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class VanillaBlockVisualResourceRewriterTest {
+
+    @Test
+    void resolvesAcceptedPixelsAboveBuiltinAndLeavesJavaFallbackWhenMissing() {
+        final var storage = new ResourcePackStorage(List.of(pack(0xFF445566)), List.of(pack(0xFF112233)));
+        final var output = VanillaBlockVisualResourceRewriter.convert(storage);
+        final var image = output.getImage("assets/viabedrock/textures/block/native/redstone_torch_on.png").getImage();
+        assertEquals(0xFF445566, image.getRGB(7, 6));
+        assertEquals(1, output.getFilesDeep("", ".png").size());
+        assertEquals(3, output.getFilesDeep("", ".json").size());
+        assertTrue(VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of())).getFilesDeep("", "").isEmpty());
+    }
+
+    @Test
+    void convertsEveryBedAuxiliaryVariantWithoutChangingBlockModels() {
+        final var nativePack = beds(16);
+        final var override = imagePack("textures/items/bed_14", 0xFF446688);
+        final var storage = new ResourcePackStorage(List.of(override), List.of(nativePack));
+        final var output = VanillaBlockVisualResourceRewriter.convert(storage);
+        final var colors = List.of("white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray",
+                "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black");
+        assertEquals(16, output.getFilesDeep("assets/minecraft/items/", ".json").size());
+        assertTrue(output.getFilesDeep("assets/minecraft/models/block/", ".json").isEmpty());
+        for (int index = 0; index < colors.size(); index++) {
+            final var item = output.getJson("assets/minecraft/items/" + colors.get(index) + "_bed.json").getAsJsonObject("model");
+            final var model = output.getJson("assets/viabedrock/models/" + item.get("model").getAsString().substring("viabedrock:".length()) + ".json");
+            final var sprite = output.getImage("assets/viabedrock/textures/"
+                    + model.getAsJsonObject("textures").get("layer0").getAsString().substring("viabedrock:".length()) + ".png");
+            assertEquals(index == 14 ? 0xFF446688 : 0xFF110000 | index, sprite.getImage().getRGB(7, 6));
+        }
+    }
+
+    @Test
+    void honorsAcceptedAtlasPathsBeforeBundledBedDefinitions() {
+        final var nativePack = beds(16);
+        final var override = imagePack("textures/items/server_bed", 0xFF774411);
+        final var atlas = nativePack.content().getJson("textures/item_texture.json");
+        final var textures = atlas.getAsJsonObject("texture_data").getAsJsonObject("bed").getAsJsonArray("textures");
+        for (int index = 0; index < textures.size(); index++) {
+            textures.set(index, new JsonPrimitive("textures/items/server_bed"));
+        }
+        override.content().putJson("textures/item_texture.json", atlas);
+        final var output = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(override), List.of(nativePack)));
+        assertEquals(16, output.getFilesDeep("assets/viabedrock/textures/item/native/", ".png").size());
+        for (final String path : output.getFilesDeep("assets/viabedrock/textures/item/native/", ".png")) {
+            assertEquals(0xFF774411, output.getImage(path).getImage().getRGB(7, 6));
+        }
+    }
+
+    @Test
+    void appliesSingleBedAtlasOverridesToEveryColorAndIndexesCustomIconVariants() {
+        final var builtin = beds(16);
+        final var scalar = imagePack("textures/items/shared_bed", 0xFF336688);
+        scalar.content().putString("textures/item_texture.json",
+                "{\"texture_data\":{\"bed\":{\"textures\":\"textures/items/shared_bed\"}}}");
+        final var shared = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(scalar), List.of(builtin)));
+        assertEquals(16, shared.getFilesDeep("assets/minecraft/items/", ".json").size());
+        for (final String path : shared.getFilesDeep("assets/viabedrock/textures/item/native/", ".png")) {
+            assertEquals(0xFF336688, shared.getImage(path).getImage().getRGB(7, 6));
+        }
+        final var custom = beds(16);
+        final var atlas = custom.content().getJson("textures/item_texture.json");
+        final var data = atlas.getAsJsonObject("texture_data");
+        data.add("server_beds", data.remove("bed"));
+        custom.content().putJson("textures/item_texture.json", atlas);
+        custom.content().putString("items/bed.json",
+                "{\"minecraft:item\":{\"description\":{\"identifier\":\"minecraft:bed\"},"
+                        + "\"components\":{\"minecraft:icon\":\"server_beds\"}}}");
+        final var indexed = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(custom), List.of(builtin)));
+        assertEquals(16, indexed.getFilesDeep("assets/minecraft/items/", ".json").size());
+        assertEquals(0xFF110000, indexed.getImage("assets/viabedrock/textures/item/native/white_bed.png").getImage().getRGB(7, 6));
+        assertEquals(0xFF11000E, indexed.getImage("assets/viabedrock/textures/item/native/red_bed.png").getImage().getRGB(7, 6));
+        assertEquals(0xFF11000F, indexed.getImage("assets/viabedrock/textures/item/native/black_bed.png").getImage().getRGB(7, 6));
+    }
+
+    @Test
+    void leavesMissingBedVariantsUnchangedAndRespectsFailedOverridePrecedence() {
+        final var nativePack = beds(2);
+        final var override = imagePack("textures/items/bed_0", 0xFF446688);
+        override.content().putPngImage("textures/items/bed_0.png", new BufferedImage(1025, 16, BufferedImage.TYPE_INT_ARGB));
+        final var output = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(override, nativePack)));
+        assertEquals(1, output.getFilesDeep("assets/minecraft/items/", ".json").size());
+        assertTrue(output.contains("assets/minecraft/items/orange_bed.json"));
+    }
+
+    @Test
+    void preservesIndexedGlassColorsAndOnlyChangesTheirInventoryPose() {
+        final var builtin = glassPanes();
+        final var output = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(), List.of(builtin)));
+        assertEquals(17, output.getFilesDeep("assets/minecraft/items/", ".json").size());
+        assertTrue(output.getFilesDeep("assets/minecraft/models/block/", ".json").isEmpty());
+        for (final String path : output.getFilesDeep("assets/viabedrock/models/item/native/", ".json")) {
+            final var model = output.getJson(path);
+            assertEquals(1, model.getAsJsonObject("display").size());
+            final var gui = model.getAsJsonObject("display").getAsJsonObject("gui");
+            assertEquals(30, gui.getAsJsonArray("rotation").get(0).getAsInt());
+            assertEquals(225, gui.getAsJsonArray("rotation").get(1).getAsInt());
+            assertEquals(0.75F, gui.getAsJsonArray("scale").get(0).getAsFloat());
+        }
+        final var colors = List.of("white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray",
+                "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black");
+        for (int index = 0; index < colors.size(); index++) {
+            assertEquals(0xFF220000 | index, output.getImage("assets/viabedrock/textures/item/native/"
+                    + colors.get(index) + "_stained_glass_pane.png").getImage().getRGB(7, 6));
+        }
+        final var override = imagePack("textures/items/shared_glass", 0xFF446688);
+        override.content().putString("textures/terrain_texture.json",
+                "{\"texture_data\":{\"stained_glass\":{\"textures\":\"textures/items/shared_glass\"}}}");
+        final var overridden = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(override), List.of(builtin)));
+        for (final String color : colors) {
+            assertEquals(0xFF446688, overridden.getImage("assets/viabedrock/textures/item/native/"
+                    + color + "_stained_glass_pane.png").getImage().getRGB(7, 6));
+        }
+    }
+
+    @Test
+    void preservesServerPaneIconComponentsAboveNativeTerrainSprites() {
+        final var override = imagePack("textures/items/server_pane", 0xFF557799);
+        override.content().putString("textures/item_texture.json",
+                "{\"texture_data\":{\"server_icon\":{\"textures\":\"textures/items/server_pane\"}}}");
+        for (final String identifier : List.of("glass_pane", "stained_glass_pane")) {
+            override.content().putString("items/" + identifier + ".json",
+                    "{\"minecraft:item\":{\"description\":{\"identifier\":\"minecraft:" + identifier
+                            + "\"},\"components\":{\"minecraft:icon\":\"server_icon\"}}}");
+        }
+        final var output = VanillaBlockVisualResourceRewriter.convert(new ResourcePackStorage(List.of(override), List.of(glassPanes())));
+        assertEquals(17, output.getFilesDeep("assets/minecraft/items/", ".json").size());
+        for (final String path : output.getFilesDeep("assets/viabedrock/textures/item/native/", ".png")) {
+            assertEquals(0xFF557799, output.getImage(path).getImage().getRGB(7, 6));
+        }
+        for (final String path : output.getFilesDeep("assets/viabedrock/models/item/native/", ".json")) {
+            assertFalse(output.getJson(path).has("display"));
+        }
+    }
+
+    private static ResourcePack glassPanes() {
+        final var base = beds(16);
+        final var content = new InMemoryContent();
+        content.put("manifest.json", base.content().get("manifest.json"));
+        final var variants = new JsonArray();
+        for (int index = 0; index < 16; index++) {
+            final String path = "textures/blocks/glass_" + index;
+            variants.add(path);
+            final var image = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+            image.setRGB(7, 6, 0xFF220000 | index);
+            content.putPngImage(path + ".png", image);
+        }
+        content.put("textures/blocks/glass.png", content.get("textures/blocks/glass_0.png"));
+        final var glass = new JsonObject();
+        glass.addProperty("textures", "textures/blocks/glass");
+        final var stained = new JsonObject();
+        stained.add("textures", variants);
+        final var data = new JsonObject();
+        data.add("glass", glass);
+        data.add("stained_glass", stained);
+        final var atlas = new JsonObject();
+        atlas.add("texture_data", data);
+        content.putJson("textures/terrain_texture.json", atlas);
+        return new ResourcePack(content);
+    }
+
+    private static ResourcePack beds(final int count) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + java.util.UUID.randomUUID()
+                + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final var atlas = new JsonObject();
+        final var textures = new JsonArray();
+        for (int index = 0; index < count; index++) {
+            final String path = "textures/items/bed_" + index;
+            textures.add(path);
+            final var image = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+            image.setRGB(7, 6, 0xFF110000 | index);
+            content.putPngImage(path + ".png", image);
+        }
+        final var bed = new JsonObject();
+        bed.add("textures", textures);
+        final var data = new JsonObject();
+        data.add("bed", bed);
+        atlas.add("texture_data", data);
+        content.putJson("textures/item_texture.json", atlas);
+        return new ResourcePack(content);
+    }
+
+    private static ResourcePack imagePack(final String path, final int color) {
+        final var pack = pack(color);
+        final var content = new InMemoryContent();
+        content.put("manifest.json", pack.content().get("manifest.json"));
+        content.put(path + ".png", pack.content().get("textures/blocks/redstone_torch_on.png"));
+        return new ResourcePack(content);
+    }
+
+    private static ResourcePack pack(final int color) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + java.util.UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final var image = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(7, 6, color);
+        content.putPngImage("textures/blocks/redstone_torch_on.png", image);
+        return new ResourcePack(content);
+    }
+
+}
