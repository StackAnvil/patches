+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.util.List;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/** Retains target-native visuals where the mapped Java block has changed its appearance. */
+public final class VanillaBlockVisualResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    private static final List<Visual> VISUALS = List.of(
+            new Visual("redstone_torch", "redstone_torch_on", "template_torch", true),
+            new Visual("redstone_torch_off", "redstone_torch_off", "template_torch", false),
+            new Visual("redstone_wall_torch", "redstone_torch_on", "template_torch_wall", false),
+            new Visual("redstone_wall_torch_off", "redstone_torch_off", "template_torch_wall", false));
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> convert(storage));
+    }
+
+    static Content convert(final ResourcePackStorage storage) {
+        final Content output = new InMemoryContent();
+        for (final Visual visual : VISUALS) {
+            for (final ResourcePack pack : storage.getPackStackTopToBottom()) {
+                final var source = pack.content().getShortnameImage("textures/blocks/" + visual.nativeTexture);
+                if (source == null) {
+                    continue;
+                }
+                final var image = source.getImage();
+                // Preserve layer precedence even when the overriding image cannot be exported.
+                if (image.getWidth() <= 1024 && image.getHeight() <= 1024) {
+                    final String texture = "viabedrock:block/native/" + visual.nativeTexture;
+                    output.putPngImage("assets/viabedrock/textures/block/native/" + visual.nativeTexture + ".png", image);
+                    final JsonObject textures = new JsonObject();
+                    textures.addProperty("torch", texture);
+                    final JsonObject model = new JsonObject();
+                    model.addProperty("parent", "minecraft:block/" + visual.javaTemplate);
+                    model.add("textures", textures);
+                    output.putJson("assets/minecraft/models/block/" + visual.javaModel + ".json", model);
+                    if (visual.item) {
+                        final JsonObject item = new JsonObject();
+                        item.addProperty("parent", "minecraft:item/generated");
+                        final JsonObject layers = new JsonObject();
+                        layers.addProperty("layer0", texture);
+                        item.add("textures", layers);
+                        output.putJson("assets/minecraft/models/item/" + visual.javaModel + ".json", item);
+                    }
+                }
+                break;
+            }
+        }
+        return output;
+    }
+
+    private record Visual(String javaModel, String nativeTexture, String javaTemplate, boolean item) { }
+
+}
