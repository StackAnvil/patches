From 82a19e72a3d0d13c5446574a1f998256b5a2046e Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 3 Oct 2026 21:37:29 +0200
Subject: [PATCH] fix(effects): preserve status icons independently of
 particles

Bedrock 1.26.51.1 displays active status icons even when the effect packet disables particles. Java requires its independent SHOW_ICON flag, which was absent from every translated effect.

Set the icon flag in core effect updates and replayed snapshots while preserving ambient and particle bits. Native target captures establish visible icons with hidden particles, and packet tests cover every ambient/particle combination and retained infinite duration.
---
 .../api/model/entity/LivingEntity.java        |  2 +-
 .../model/entity/LivingEntityEffectTest.java  | 51 +++++++++++++++++++
 2 files changed, 52 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/model/entity/LivingEntityEffectTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/LivingEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/LivingEntity.java
index 8f927e669..c9cdd40aa 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/LivingEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/LivingEntity.java
@@ -120,7 +120,7 @@ public class LivingEntity extends Entity {
         javaEffect.write(Types.VAR_INT, BedrockProtocol.MAPPINGS.getJavaEffects().get(BedrockProtocol.MAPPINGS.getBedrockToJavaEffects().get(effect.identifier()))); // effect id
         javaEffect.write(Types.VAR_INT, effect.amplifier()); // amplifier
         javaEffect.write(Types.VAR_INT, effect.duration().get() != -1 ? Math.max(effect.duration().get(), 0) : -1); // duration
-        byte flags = 0;
+        byte flags = UpdateMobEffectFlag.SHOW_ICON.getBit();
         if (effect.ambient()) {
             flags |= UpdateMobEffectFlag.AMBIENT.getBit();
         }
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/entity/LivingEntityEffectTest.java b/src/test/java/net/raphimc/viabedrock/api/model/entity/LivingEntityEffectTest.java
new file mode 100644
index 000000000..3a1b069bc
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/entity/LivingEntityEffectTest.java
@@ -0,0 +1,51 @@
