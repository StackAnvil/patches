+package net.raphimc.viabedrock.api.model.entity;
+
+import com.google.common.collect.HashBiMap;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.EntityEffect;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class LivingEntityEffectTest {
+
+    @Test
+    void effectIconsRemainVisibleIndependentlyOfParticlesAndAmbientState() throws ReflectiveOperationException {
+        final var effects = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("javaEffects");
+        final var translation = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("bedrockToJavaEffects");
+        effects.setAccessible(true);
+        translation.setAccessible(true);
+        final Object oldEffects = effects.get(BedrockProtocol.MAPPINGS);
+        final Object oldTranslation = translation.get(BedrockProtocol.MAPPINGS);
+        try {
+            effects.set(BedrockProtocol.MAPPINGS, HashBiMap.create(Map.of("minecraft:speed", 1)));
+            translation.set(BedrockProtocol.MAPPINGS, Map.of("minecraft:speed", "minecraft:speed"));
+            final var entity = new LivingEntity(null, 1, 2, "minecraft:player", 3, null, EntityTypes26_3.PLAYER);
+            for (final boolean particles : new boolean[]{false, true}) {
+                for (final boolean ambient : new boolean[]{false, true}) {
+                    final var effect = new EntityEffect("minecraft:speed", 2, -1, particles, ambient);
+                    final var packet = new PacketWrapperImpl(ClientboundPackets26_3.UPDATE_MOB_EFFECT, null, null);
+                    entity.updateEffect(effect, packet);
+                    assertEquals((byte) (4 | (particles ? 2 : 0) | (ambient ? 1 : 0)), packet.get(Types.BYTE, 0));
+                    assertEquals(-1, packet.get(Types.VAR_INT, 3));
+                    assertSame(effect, entity.effects().get(effect.identifier()));
+                }
+            }
+        } finally {
+            effects.set(BedrockProtocol.MAPPINGS, oldEffects);
+            translation.set(BedrockProtocol.MAPPINGS, oldTranslation);
+        }
+    }
+
+}
