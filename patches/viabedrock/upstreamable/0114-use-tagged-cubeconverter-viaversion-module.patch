From f333c594b370e941278f6db5941f45cf9e9dd1cc Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:06:07 +0100
Subject: [PATCH] build(deps): use CubeConverter 1.3.1 ViaVersion module

Replace the vv-json branch commit dependency with the named ViaVersion
Gson module from CubeConverter 1.3.1. Both Gson variants now build from
master, so ViaBedrock no longer relies on a separate converter branch.

Include the merged optional null-parent fix. Player geometry that encodes
an unparented root as parent:null now retains its model and child hierarchy
instead of failing in JsonNull.getAsString().

Keep transitive dependencies disabled to retain the host ViaVersion
dependency choices. The named vv-json module preserves the
com.viaversion.viaversion.libs.gson API and avoids the repository aggregate
that can include both conflicting CubeConverter variants.
https://github.com/oryxel1/CubeConverter/tree/1.3.1
---
 build.gradle | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 1a2b5d8dec5153694467efce24af5f4ba0440021..f91f49d9bd006fbe42fbda221c85e23d592743c8 100644
--- a/build.gradle
+++ b/build.gradle
@@ -108,7 +108,7 @@ dependencies {
     api "com.vdurmont:semver4j:3.1.0"
     api "com.mojang:brigadier:1.3.10"
     api "at.yawk.lz4:lz4-java:1.13.0"
-    api("com.github.oryxel1:CubeConverter:8a7b73a8ed") {
+    api("com.github.oryxel1.CubeConverter:vv-json:1.3.1") {
         transitive = false
     }
     api("team.unnamed:mocha:3.0.1") {
