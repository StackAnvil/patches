index 00000000..c0ae2088
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/NativeNbtStringsTest.java
@@ -0,0 +1,152 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.types.primitive;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HexFormat;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeNbtStringsTest {
+
+    @Test
+    void distinctMalformedNamesRemainUnequalAfterDecodingAndCopying() throws Exception {
+        for (final var type : List.of(BedrockTypes.TAG_LE, BedrockTypes.NETWORK_TAG)) {
+            final var first = compound(type, new byte[]{'n'}, new byte[]{(byte) 0xFF});
+            final var second = compound(type, new byte[]{'n'}, new byte[]{(byte) 0x80});
+            try {
+                final var a = (CompoundTag) type.read(first);
+                final var b = (CompoundTag) type.read(second);
+                assertNotEquals(a, b);
+                assertNotEquals(a.copy(), b.copy());
+                assertNotEquals(a.getString("n"), b.getString("n"));
+            } finally {
+                first.release();
+                second.release();
+            }
+        }
+    }
+
+    @Test
+    void nestedKeysAndStringListsRoundTripWithoutCollapsingOrReplacingBytes() throws Exception {
+        for (final var type : List.of(BedrockTypes.TAG_LE, BedrockTypes.NETWORK_TAG)) {
+            final var input = Unpooled.buffer();
+            final var encoded = Unpooled.buffer();
+            final var envelope = Unpooled.buffer();
+            try {
+                input.writeByte(CompoundTag.ID);
+                text(input, type, new byte[0]);
+                for (final byte[] key : new byte[][]{{(byte) 0xC0, (byte) 0xAF}, {(byte) 0xC1, (byte) 0xAF}}) {
+                    input.writeByte(ListTag.ID);
+                    text(input, type, key);
+                    input.writeByte(StringTag.ID);
+                    if (type == BedrockTypes.TAG_LE) {
+                        input.writeIntLE(2);
+                    } else {
+                        BedrockTypes.VAR_INT.writePrimitive(input, 2);
+                    }
+                    text(input, type, new byte[]{'a', 0, (byte) 0xFF, 'b'});
+                    text(input, type, new byte[]{(byte) 0xF0, (byte) 0x90, (byte) 0x82, (byte) 0x80});
+                }
+                input.writeByte(0);
+                final byte[] original = bytes(input);
+                final var value = (CompoundTag) type.read(input);
+                assertFalse(input.isReadable());
+                assertEquals(2, value.size());
+                final var copy = value.copy();
+                assertNotSame(value, copy);
+                assertEquals(value, copy);
+                Types.NAMED_COMPOUND_TAG.write(envelope, copy);
+                final var restored = Types.NAMED_COMPOUND_TAG.read(envelope);
+                assertEquals(copy, restored);
+                assertFalse(envelope.isReadable());
+                type.write(encoded, restored);
+                assertArrayEquals(original, bytes(encoded));
+            } finally {
+                input.release();
+                encoded.release();
+                envelope.release();
+            }
+        }
+    }
+
+    @Test
+    void ordinaryPacketTextStillUsesItsExistingUnicodeDecoder() throws Exception {
+        final var input = Unpooled.buffer();
+        try {
+            BedrockTypes.BYTE_ARRAY.write(input, new byte[]{(byte) 0xFF});
+            assertEquals(0xFFFD, BedrockTypes.STRING.read(input).codePointAt(0));
+            assertFalse(input.isReadable());
+        } finally {
+            input.release();
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NBT_UTF8_REFERENCE", matches = ".+")
+    void preservesTheNativeLoadedBinaryTagTrees() throws Exception {
+        final var data = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NBT_UTF8_REFERENCE")))).getAsJsonObject();
+        final var hex = HexFormat.of();
+        int count = 0;
+        for (final var element : data.getAsJsonArray("rows")) {
+            final byte[] packet = hex.parseHex(element.getAsJsonObject().get("packet").getAsString());
+            final var input = Unpooled.wrappedBuffer(packet, 3, packet.length - 11);
+            final var encoded = Unpooled.buffer();
+            try {
+                final var value = (CompoundTag) BedrockTypes.TAG_LE.read(input);
+                assertFalse(input.isReadable());
+                BedrockTypes.TAG_LE.write(encoded, value.copy());
+                assertArrayEquals(java.util.Arrays.copyOfRange(packet, 3, packet.length - 8), bytes(encoded));
+                assertEquals(4, value.size());
+                count++;
+            } finally {
+                input.release();
+                encoded.release();
+            }
+        }
+        assertEquals(340, count);
+    }
+
+    private static ByteBuf compound(final Type<Tag> type, final byte[] key, final byte[] value) throws Exception {
+        final var buffer = Unpooled.buffer();
+        buffer.writeByte(CompoundTag.ID);
+        text(buffer, type, new byte[0]);
+        buffer.writeByte(StringTag.ID);
+        text(buffer, type, key);
+        text(buffer, type, value);
+        buffer.writeByte(0);
+        return buffer;
+    }
+
+    private static void text(final ByteBuf buffer, final Type<Tag> type, final byte[] value) throws Exception {
+        if (type == BedrockTypes.TAG_LE) {
+            buffer.writeShortLE(value.length);
+        } else {
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, value.length);
+        }
+        buffer.writeBytes(value);
+    }
+
+    private static byte[] bytes(final ByteBuf buffer) {
+        final byte[] bytes = new byte[buffer.readableBytes()];
+        buffer.getBytes(buffer.readerIndex(), bytes);
+        return bytes;
+    }
+
+}
