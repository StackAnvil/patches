From 7cc20ef55adc3e60890aba8b36704a5ba9b35bfd Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Thu, 22 Oct 2026 17:53:48 +0200
Subject: [PATCH] fix(nbt): normalize native binary floating values

Bedrock binary NBT loads float NaNs and non-finite doubles as positive
zero, while preserving float infinities, signed zero and finite bits.
Apply the same scalar rules when reading and writing little-endian NBT
so item userdata and outgoing inventory snapshots use native values.
Keep generic little-endian and network-NBT IO unchanged, and normalize
at the stream boundary without mutating the authoritative tag tree.

Evidence: Bedrock 1.26.51.1, protocol 2193, executable SHA-256
537c0aee2e79afbdc94b44b28e00f466ae62bc50e2733d953b430db9dbaa9ee7.
The complete binary userdata loader at 0x1424d06e0 and actual writer
normalization instructions at 0x14254b9f0 and 0x14254b2e0 agree on all
28 tested scalar bit patterns. The writer probe stops before abstract
output dispatch; it does not establish full native packet serialization.

Tests cover each native value directly and inside a compound/list, retain
source tag bits, and protect the generic little-endian IO behavior.
---
 .../protocol/types/primitive/TagLeType.java   |  44 +++++-
 .../types/primitive/TagLeTypeTest.java        | 141 ++++++++++++++++++
 2 files changed, 183 insertions(+), 2 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeTypeTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeType.java b/src/main/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeType.java
index a3762f984..1c15a8214 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeType.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeType.java
@@ -44,7 +44,7 @@ public class TagLeType extends Type<Tag> {
 
         try {
             BedrockTypes.UTF8_STRING.read(buffer);
-            return TagRegistry.read(id, new LittleEndianByteBufInputStream(buffer), TagLimiter.noop(), 0);
+            return TagRegistry.read(id, new TagInput(buffer), TagLimiter.noop(), 0);
         } catch (final IOException e) {
             throw new UncheckedIOException(e);
         }
@@ -60,10 +60,50 @@ public class TagLeType extends Type<Tag> {
         buffer.writeByte(value.getTagId());
         BedrockTypes.UTF8_STRING.write(buffer, "");
         try {
-            value.write(new LittleEndianByteBufOutputStream(buffer));
+            value.write(new TagOutput(buffer));
         } catch (final IOException e) {
             throw new UncheckedIOException(e);
         }
     }
 
+    // Binary NBT preserves float infinities, but replaces float NaNs and all
+    // non-finite doubles with positive zero. Keep this out of generic LE IO.
+    private static final class TagInput extends LittleEndianByteBufInputStream {
+
+        private TagInput(final ByteBuf buffer) {
+            super(buffer);
+        }
+
+        @Override
+        public float readFloat() {
+            final float value = super.readFloat();
+            return Float.isNaN(value) ? 0F : value;
+        }
+
+        @Override
+        public double readDouble() {
+            final double value = super.readDouble();
+            return Double.isFinite(value) ? value : 0D;
+        }
+
+    }
+
+    private static final class TagOutput extends LittleEndianByteBufOutputStream {
+
+        private TagOutput(final ByteBuf buffer) {
+            super(buffer);
+        }
+
+        @Override
+        public void writeFloat(final float value) {
+            super.writeFloat(Float.isNaN(value) ? 0F : value);
+        }
+
+        @Override
+        public void writeDouble(final double value) {
+            super.writeDouble(Double.isFinite(value) ? value : 0D);
+        }
+
+    }
+
 }
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeTypeTest.java b/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeTypeTest.java
new file mode 100644
index 000000000..238db0566
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/TagLeTypeTest.java
@@ -0,0 +1,141 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
