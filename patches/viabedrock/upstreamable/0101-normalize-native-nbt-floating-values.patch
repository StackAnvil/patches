+package net.raphimc.viabedrock.api.io;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.CharBuffer;
+import java.nio.charset.StandardCharsets;
+
+/** NBT byte strings in Java. Malformed UTF-8 bytes use isolated low surrogates. */
+public final class NbtUtf8 {
+
+    private NbtUtf8() { }
+
+    public static String decode(final byte[] bytes) {
+        final var input = ByteBuffer.wrap(bytes);
+        final var output = CharBuffer.allocate(bytes.length);
+        final var decoder = StandardCharsets.UTF_8.newDecoder();
+        while (true) {
+            final var result = decoder.decode(input, output, true);
+            if (result.isUnderflow()) {
+                decoder.flush(output);
+                output.flip();
+                return output.toString();
+            }
+            if (!result.isMalformed()) {
+                throw new IllegalStateException("Unexpected UTF-8 decoder result: " + result);
+            }
+            for (int index = 0; index < result.length(); index++) {
+                output.put((char) (0xDC00 | (input.get() & 0xFF)));
+            }
+        }
+    }
+
+    public static byte[] encode(final String value) {
+        ByteArrayOutputStream output = null;
+        int start = 0;
+        int index = 0;
+        while (index < value.length()) {
+            final char character = value.charAt(index);
+            if (Character.isHighSurrogate(character) && index + 1 < value.length() && Character.isLowSurrogate(value.charAt(index + 1))) {
+                index += 2;
+            } else if (character >= 0xDC80 && character <= 0xDCFF) {
+                if (output == null) {
+                    output = new ByteArrayOutputStream(value.length());
+                }
+                output.writeBytes(value.substring(start, index).getBytes(StandardCharsets.UTF_8));
+                output.write(character & 0xFF);
+                start = index + 1;
+                index++;
+            } else {
+                index++;
+            }
+        }
+        if (output == null) {
+            return value.getBytes(StandardCharsets.UTF_8);
+        }
+        output.writeBytes(value.substring(start).getBytes(StandardCharsets.UTF_8));
+        return output.toByteArray();
+    }
+
+}
