+package net.raphimc.viabedrock.api.io;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Random;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NbtUtf8Test {
+
+    @Test
+    void retainsEveryBytePairAndMixedMalformedSequences() {
+        for (int value = 0; value <= 0xFFFF; value++) {
+            final byte[] bytes = {(byte) (value >> 8), (byte) value};
+            assertArrayEquals(bytes, NbtUtf8.encode(NbtUtf8.decode(bytes)), Integer.toHexString(value));
+        }
+        final var random = new Random(2193);
+        for (int index = 0; index < 1024; index++) {
+            final byte[] bytes = new byte[random.nextInt(512)];
+            random.nextBytes(bytes);
+            assertArrayEquals(bytes, NbtUtf8.encode(NbtUtf8.decode(bytes)));
+        }
+    }
+
+    @Test
+    void preservesAllUnicodeScalarsIncludingSurrogateEscapeRangeInPairs() {
+        for (int point = 0; point <= Character.MAX_CODE_POINT; point++) {
+            if (point >= Character.MIN_SURROGATE && point <= Character.MAX_SURROGATE) {
+                continue;
+            }
+            final String text = new String(Character.toChars(point));
+            final byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+            assertEquals(text, NbtUtf8.decode(bytes));
+            assertArrayEquals(bytes, NbtUtf8.encode(text));
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/NativeNbtStringsTest.java b/src/test/java/net/raphimc/viabedrock/protocol/types/primitive/NativeNbtStringsTest.java
