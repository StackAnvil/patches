+package net.raphimc.viabedrock.protocol.types.primitive;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.DoubleTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.Tag;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.io.LittleEndianByteBufInputStream;
+import net.raphimc.viabedrock.api.io.LittleEndianByteBufOutputStream;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+import java.util.List;
+import java.util.stream.Stream;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class TagLeTypeTest {
+
+    @ParameterizedTest
+    @MethodSource("nativeNumbers")
+    void matchesNativeBinaryNbtWithoutMutatingSourceTags(final int kind, final long input, final long expected) {
+        for (final boolean nested : new boolean[]{false, true}) {
+            final ByteBuf buffer = Unpooled.buffer();
+            final ByteBuf encoded = Unpooled.buffer();
+            try {
+                writeHeader(buffer, kind, nested);
+                if (kind == 5) {
+                    buffer.writeIntLE((int) input);
+                } else {
+                    buffer.writeLongLE(input);
+                }
+                if (nested) {
+                    buffer.writeByte(0);
+                }
+                final Tag decoded = BedrockTypes.TAG_LE.read(buffer);
+                assertEquals(expected, bits(scalar(decoded, nested)));
+                assertFalse(buffer.isReadable());
+
+                final Tag original = kind == 5 ? new FloatTag(Float.intBitsToFloat((int) input)) : new DoubleTag(Double.longBitsToDouble(input));
+                final Tag source;
+                if (nested) {
+                    final CompoundTag compound = new CompoundTag();
+                    compound.put("n", new ListTag<>(List.of(original)));
+                    source = compound;
+                } else {
+                    source = original;
+                }
+                BedrockTypes.TAG_LE.write(encoded, source);
+                buffer.clear();
+                writeHeader(buffer, kind, nested);
+                assertEquals(buffer, encoded.readSlice(buffer.readableBytes()));
+                assertEquals(expected, kind == 5 ? encoded.readUnsignedIntLE() : encoded.readLongLE());
+                if (nested) {
+                    assertEquals(0, encoded.readByte());
+                }
+                assertFalse(encoded.isReadable());
+                assertEquals(input, bits(original));
+            } finally {
+                buffer.release();
+                encoded.release();
+            }
+        }
+    }
+
+    @Test
+    void keepsGenericLittleEndianIoUnchanged() {
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            final var output = new LittleEndianByteBufOutputStream(buffer);
+            output.writeFloat(Float.intBitsToFloat(0xFFC00001));
+            output.writeDouble(Double.NEGATIVE_INFINITY);
+            final var input = new LittleEndianByteBufInputStream(buffer);
+            assertEquals(0xFFC00001, Float.floatToRawIntBits(input.readFloat()));
+            assertEquals(Double.NEGATIVE_INFINITY, input.readDouble());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static void writeHeader(final ByteBuf buffer, final int kind, final boolean nested) {
+        buffer.writeByte(nested ? 10 : kind).writeShortLE(0);
+        if (nested) {
+            buffer.writeByte(9).writeShortLE(1).writeByte('n').writeByte(kind).writeIntLE(1);
+        }
+    }
+
+    private static Tag scalar(final Tag root, final boolean nested) {
+        return nested ? ((CompoundTag) root).getListTag("n").getValue().getFirst() : root;
+    }
+
+    private static long bits(final Tag tag) {
+        return tag instanceof FloatTag value ? Integer.toUnsignedLong(Float.floatToRawIntBits(value.asFloat())) : Double.doubleToRawLongBits(((DoubleTag) tag).asDouble());
+    }
+
+    // Bedrock 1.26.51.1, protocol 2193: complete binary userdata loader
+    // 0x1424D06E0 and scalar writer normalization at 0x14254B9F0/0x14254B2E0.
+    private static Stream<Arguments> nativeNumbers() {
+        return Stream.of(
+                Arguments.of(5, 0x0L, 0x0L),
+                Arguments.of(5, 0x80000000L, 0x80000000L),
+                Arguments.of(5, 0x1L, 0x1L),
+                Arguments.of(5, 0x80000001L, 0x80000001L),
+                Arguments.of(5, 0x7FFFFFL, 0x7FFFFFL),
+                Arguments.of(5, 0x800000L, 0x800000L),
+                Arguments.of(5, 0x3F800000L, 0x3F800000L),
+                Arguments.of(5, 0x7F7FFFFFL, 0x7F7FFFFFL),
+                Arguments.of(5, 0x7F800000L, 0x7F800000L),
+                Arguments.of(5, 0xFF800000L, 0xFF800000L),
+                Arguments.of(5, 0x7FC00000L, 0x0L),
+                Arguments.of(5, 0xFFC00000L, 0x0L),
+                Arguments.of(5, 0x7F800001L, 0x0L),
+                Arguments.of(5, 0xFF800001L, 0x0L),
+                Arguments.of(6, 0x0L, 0x0L),
+                Arguments.of(6, 0x8000000000000000L, 0x8000000000000000L),
+                Arguments.of(6, 0x1L, 0x1L),
+                Arguments.of(6, 0x8000000000000001L, 0x8000000000000001L),
+                Arguments.of(6, 0xFFFFFFFFFFFFFL, 0xFFFFFFFFFFFFFL),
+                Arguments.of(6, 0x10000000000000L, 0x10000000000000L),
+                Arguments.of(6, 0x3FF0000000000000L, 0x3FF0000000000000L),
+                Arguments.of(6, 0x7FEFFFFFFFFFFFFFL, 0x7FEFFFFFFFFFFFFFL),
+                Arguments.of(6, 0x7FF0000000000000L, 0x0L),
+                Arguments.of(6, 0xFFF0000000000000L, 0x0L),
+                Arguments.of(6, 0x7FF8000000000000L, 0x0L),
+                Arguments.of(6, 0xFFF8000000000000L, 0x0L),
+                Arguments.of(6, 0x7FF0000000000001L, 0x0L),
+                Arguments.of(6, 0xFFF0000000000001L, 0x0L)
+        );
+    }
+
+}
