From 50ab0469cef9705b9a35f335bca559aea9264923 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:52:52 +0200
Subject: [PATCH] fix(input): match Bedrock directional input

Preserve the movement correction from ViaBedrock PR #429 as an individually
reviewable feature patch. Local left is negative X and right is positive X.

The matching native 1.26.51.1 input calculator at 0x1404495e0 adds cardinal
directions before normalization. Opposing keys therefore cancel on each
axis. Replace directional priority with that cancellation while retaining
independent physical flags, diagonal normalization, and input scaling.

Strict BDS accepts the old contradictory vectors without correcting the
client. Verify the actual packet field, rather than using the absence of
movement corrections as proof of directional parity.
---
 src/main/java/net/raphimc/viabedrock/api/util/MathUtil.java | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/main/java/net/raphimc/viabedrock/api/util/MathUtil.java b/src/main/java/net/raphimc/viabedrock/api/util/MathUtil.java
index badfaee46..a760d4c52 100644
--- a/src/main/java/net/raphimc/viabedrock/api/util/MathUtil.java
+++ b/src/main/java/net/raphimc/viabedrock/api/util/MathUtil.java
@@ -97,8 +97,8 @@ public final class MathUtil {
 
     public static Position2f calculateMovementDirections(final Set<PlayerAuthInputData> authInputData, final boolean sneaking) {
         final float[] directions = new float[2];
-        directions[0] = authInputData.contains(PlayerAuthInputData.Left) ? 1F : authInputData.contains(PlayerAuthInputData.Right) ? -1F : 0F;
-        directions[1] = authInputData.contains(PlayerAuthInputData.Up) ? 1F : authInputData.contains(PlayerAuthInputData.Down) ? -1F : 0F;
+        directions[0] = (authInputData.contains(PlayerAuthInputData.Right) ? 1F : 0F) - (authInputData.contains(PlayerAuthInputData.Left) ? 1F : 0F);
+        directions[1] = (authInputData.contains(PlayerAuthInputData.Up) ? 1F : 0F) - (authInputData.contains(PlayerAuthInputData.Down) ? 1F : 0F);
         final boolean both = directions[0] != 0F && directions[1] != 0F;
         for (int i = 0; i < directions.length; i++) {
             if (both) {
-- 
