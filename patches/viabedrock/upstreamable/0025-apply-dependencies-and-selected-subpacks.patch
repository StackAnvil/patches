+package net.raphimc.viabedrock.api.resourcepack;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.PriorityQueue;
+
+public final class ResourcePackStack {
+
+    private ResourcePackStack() {
+    }
+
+    /** Keep server precedence unless a manifest requires another resource pack below its dependent. */
+    public static List<ResourcePack> orderTopToBottom(final List<ResourcePack> serverOrder) {
+        final Map<ResourcePack.Key, Integer> indexes = new HashMap<>();
+        for (int i = 0; i < serverOrder.size(); i++) {
+            indexes.putIfAbsent(serverOrder.get(i).key(), i);
+        }
+
+        final List<List<Integer>> edges = new ArrayList<>(serverOrder.size());
+        final int[] indegrees = new int[serverOrder.size()];
+        for (int i = 0; i < serverOrder.size(); i++) {
+            edges.add(new ArrayList<>());
+        }
+        for (int i = 0; i < serverOrder.size(); i++) {
+            for (ResourcePack.Key dependency : serverOrder.get(i).dependencies()) {
+                final Integer dependencyIndex = indexes.get(dependency);
+                if (dependencyIndex != null && dependencyIndex != i && !edges.get(i).contains(dependencyIndex)) {
+                    edges.get(i).add(dependencyIndex);
+                    indegrees[dependencyIndex]++;
+                }
+            }
+        }
+
+        final PriorityQueue<Integer> ready = new PriorityQueue<>();
+        for (int i = 0; i < serverOrder.size(); i++) {
+            if (indegrees[i] == 0) {
+                ready.add(i);
+            }
+        }
+        final List<ResourcePack> ordered = new ArrayList<>(serverOrder.size());
+        while (!ready.isEmpty()) {
+            final int index = ready.remove();
+            ordered.add(serverOrder.get(index));
+            for (int dependencyIndex : edges.get(index)) {
+                if (--indegrees[dependencyIndex] == 0) {
+                    ready.add(dependencyIndex);
+                }
+            }
+        }
+        if (ordered.size() != serverOrder.size()) {
+            throw new IllegalStateException("Cyclic resource pack dependencies in server stack");
+        }
+        return ordered;
+    }
+
+}
