+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ResourcePackStackTest {
+
+    @Test
+    void dependenciesLoadBelowDependentsWithoutReorderingIndependentPacks() {
+        final ResourcePack base = pack(UUID.randomUUID(), null);
+        final ResourcePack dependent = pack(UUID.randomUUID(), base.key());
+        final ResourcePack independent = pack(UUID.randomUUID(), null);
+
+        assertEquals(List.of(dependent, base, independent), ResourcePackStack.orderTopToBottom(List.of(base, dependent, independent)));
+        assertEquals(List.of(independent, dependent, base), ResourcePackStack.orderTopToBottom(List.of(independent, dependent, base)));
+    }
+
+    @Test
+    void dependenciesOutsideTheResourceStackDoNotChangeItsOrder() {
+        final ResourcePack dependent = pack(UUID.randomUUID(), new ResourcePack.Key(UUID.randomUUID(), "1.0.0"));
+        final ResourcePack independent = pack(UUID.randomUUID(), null);
+
+        assertEquals(List.of(dependent, independent), ResourcePackStack.orderTopToBottom(List.of(dependent, independent)));
+    }
+
+    @Test
+    void formatThreeDependencyVersionObjectMatchesPackVersion() {
+        final ResourcePack base = pack(UUID.randomUUID(), null);
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"},\"dependencies\":[{\"module_name\":\"@minecraft/server\",\"version\":\"1.0.0\"},{\"uuid\":\"" + base.id() + "\",\"version\":{\"major\":1,\"minor\":0,\"patch\":0}}]}");
+        final ResourcePack dependent = new ResourcePack(content);
+
+        assertEquals(List.of(dependent, base), ResourcePackStack.orderTopToBottom(List.of(base, dependent)));
+    }
+
+    @Test
+    void cyclicResourcePackDependenciesAreRejected() {
+        final UUID firstId = UUID.randomUUID();
+        final UUID secondId = UUID.randomUUID();
+        final ResourcePack first = pack(firstId, new ResourcePack.Key(secondId, "1.0.0"));
+        final ResourcePack second = pack(secondId, new ResourcePack.Key(firstId, "1.0.0"));
+
+        assertThrows(IllegalStateException.class, () -> ResourcePackStack.orderTopToBottom(List.of(first, second)));
+    }
+
+    @Test
+    void selectedSubpackOverridesRootWithoutChangingSourcePack() {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":3,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":\"1.0.0\",\"name\":\"test\"},\"subpacks\":[{\"folder_name\":\"small\",\"name\":\"Small\"},{\"folder_name\":\"large\",\"name\":\"Large\"}]}");
+        content.putString("textures/root.png", "root");
+        content.putString("textures/unchanged.png", "unchanged");
+        content.putString("subpacks/small/textures/root.png", "small");
+        content.putString("subpacks/large/textures/root.png", "large");
+        content.putString("subpacks/large/textures/extra.png", "extra");
+        final ResourcePack source = new ResourcePack(content);
+
+        final ResourcePack selected = source.selectSubpack("large");
+        assertArrayEquals("large".getBytes(StandardCharsets.UTF_8), selected.content().get("textures/root.png"));
+        assertArrayEquals("unchanged".getBytes(StandardCharsets.UTF_8), selected.content().get("textures/unchanged.png"));
+        assertTrue(selected.content().getFilesDeep("textures/", ".png").contains("textures/extra.png"));
+        assertFalse(selected.content().getFilesDeep("", "").stream().anyMatch(path -> path.startsWith("subpacks/")));
+        assertArrayEquals("root".getBytes(StandardCharsets.UTF_8), source.content().get("textures/root.png"));
+        final ResourcePack noSubpack = source.selectSubpack("");
+        assertArrayEquals("root".getBytes(StandardCharsets.UTF_8), noSubpack.content().get("textures/root.png"));
+        assertFalse(noSubpack.content().getFilesDeep("", "").stream().anyMatch(path -> path.startsWith("subpacks/")));
+        assertThrows(IllegalArgumentException.class, () -> source.selectSubpack("unknown"));
+    }
+
+    @Test
+    void missingTextureInSubpackFallsThroughToLowerPack() {
+        final SubpackContent upper = new SubpackContent(new InMemoryContent(), "selected");
+        final InMemoryContent lower = new InMemoryContent();
+        lower.putPngImage("textures/shared.png", new BufferedImage(2, 3, BufferedImage.TYPE_INT_ARGB));
+
+        assertNull(upper.getShortnameImage("textures/shared"));
+        assertNull(upper.getShortnameImage("textures/missing.png"));
+        assertEquals(2, lower.getShortnameImage("textures/shared").getImage().getWidth());
+        assertEquals(3, lower.getShortnameImage("textures/shared").getImage().getHeight());
+    }
+
+    private static ResourcePack pack(final UUID id, final ResourcePack.Key dependency) {
+        final InMemoryContent content = new InMemoryContent();
+        final String dependencyJson = dependency == null ? "" : ",\"dependencies\":[{\"uuid\":\"" + dependency.id() + "\",\"version\":[1,0,0]}]";
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + id + "\",\"version\":[1,0,0],\"name\":\"test\"}" + dependencyJson + "}");
+        return new ResourcePack(content);
+    }
+
+}
