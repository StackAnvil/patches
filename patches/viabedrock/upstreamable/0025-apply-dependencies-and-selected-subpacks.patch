+package net.raphimc.viabedrock.api.resourcepack.content;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** A read-through view of the root pack with one selected subpack overlaid on top. */
+public final class SubpackContent extends Content {
+
+    private static final String SUBPACKS_PATH = "subpacks/";
+
+    private final Content source;
+    private final String selectedPrefix;
+    private final Map<String, byte[]> changes = new ConcurrentHashMap<>();
+
+    public SubpackContent(final Content source, final String selectedSubpack) {
+        this.source = source;
+        this.selectedPrefix = selectedSubpack.isEmpty() ? null : SUBPACKS_PATH + selectedSubpack + '/';
+    }
+
+    @Override
+    public List<String> getFilesShallow(final String path, final String extension) {
+        return this.getFilesDeep(path, extension).stream()
+            .filter(file -> !file.substring(path.length()).contains("/"))
+            .toList();
+    }
+
+    @Override
+    public List<String> getFilesDeep(final String path, final String extension) {
+        final LinkedHashSet<String> files = new LinkedHashSet<>();
+        for (String file : this.source.getFilesDeep(path, extension)) {
+            if (!file.startsWith(SUBPACKS_PATH)) {
+                files.add(file);
+            }
+        }
+        if (this.selectedPrefix != null) {
+            for (String file : this.source.getFilesDeep(this.selectedPrefix + path, extension)) {
+                files.add(file.substring(this.selectedPrefix.length()));
+            }
+        }
+        for (String file : this.changes.keySet()) {
+            if (file.startsWith(path) && file.endsWith(extension)) {
+                files.add(file);
+            }
+        }
+        return new ArrayList<>(files);
+    }
+
+    @Override
+    public boolean contains(final String path) {
+        if (path.startsWith(SUBPACKS_PATH)) {
+            return false;
+        }
+        return this.changes.containsKey(path) || this.selectedPrefix != null && this.source.contains(this.selectedPrefix + path) || this.source.contains(path);
+    }
+
+    @Override
+    public byte[] get(final String path) {
+        if (path.startsWith(SUBPACKS_PATH)) {
+            return null;
+        }
+        final byte[] changed = this.changes.get(path);
+        if (changed != null) {
+            return changed;
+        }
+        if (this.selectedPrefix != null) {
+            final byte[] selected = this.source.get(this.selectedPrefix + path);
+            if (selected != null) {
+                return selected;
+            }
+        }
+        return this.source.get(path);
+    }
+
+    @Override
+    public boolean put(final String path, final byte[] data) {
+        if (path.startsWith(SUBPACKS_PATH)) {
+            throw new IllegalArgumentException("Cannot write to a subpack path through the selected pack view: " + path);
+        }
+        final boolean existed = this.contains(path);
+        this.changes.put(path, data);
+        return existed;
+    }
+
+}
