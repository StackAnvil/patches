+    @Test
+    void unknownServerSubpackSelectsRootPackInsteadOfFailing() {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[0,0,1],\"name\":\"test\"},\"subpacks\":[{\"folder_name\":\"low\",\"name\":\"Low\"}]}");
+        content.putString("textures/root.png", "root");
+        content.putString("subpacks/low/textures/root.png", "low");
+        final ResourcePack source = new ResourcePack(content);
+
+        assertFalse(source.hasSubpack("HiveDR"));
+        final ResourcePack selected = source.selectSubpack("HiveDR");
+        assertArrayEquals("root".getBytes(StandardCharsets.UTF_8), selected.content().get("textures/root.png"));
+        assertFalse(selected.content().getFilesDeep("", "").stream().anyMatch(path -> path.startsWith("subpacks/")));
+    }
