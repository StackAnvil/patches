+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.Objects;
+import java.util.UUID;
+
+/** Native inputs paired with their next translated Java position or rotation packet. */
+public record RemotePlayerMovement(int entityId, UUID uuid, UUID lifetime, int mode, boolean riding,
+                                   Position3f position, Position3f rotation, float originOffset,
+                                   short flags, long duration, boolean onGround, JavaTarget javaTarget) {
+
+    public static final int ACTOR = -1;
+    public static final String CHANNEL = "viabedrock:remote_player_movement";
+    public static final int MAX_PAYLOAD_BYTES = 128;
+    public static final Type<RemotePlayerMovement> TYPE = new Type<>(RemotePlayerMovement.class) {
+        @Override
+        public RemotePlayerMovement read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported remote player movement");
+            }
+            final var value = new RemotePlayerMovement(Types.VAR_INT.readPrimitive(buffer), Types.UUID.read(buffer),
+                    Types.UUID.read(buffer), buffer.readByte(), buffer.readBoolean(),
+                    new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat()),
+                    new Position3f(buffer.readFloat(), buffer.readFloat(), buffer.readFloat()), buffer.readFloat(),
+                    buffer.readUnsignedByte(), buffer.readLong(), buffer.readBoolean(),
+                    new JavaTarget(buffer.readBoolean(), buffer.readDouble(), buffer.readDouble(), buffer.readDouble(),
+                            buffer.readFloat(), buffer.readFloat(), buffer.readBoolean()));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing remote player movement data");
+            }
+            return value;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final RemotePlayerMovement value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.entityId);
+            Types.UUID.write(buffer, value.uuid);
+            Types.UUID.write(buffer, value.lifetime);
+            buffer.writeByte(value.mode).writeBoolean(value.riding);
+            buffer.writeFloat(value.position.x()).writeFloat(value.position.y()).writeFloat(value.position.z());
+            buffer.writeFloat(value.rotation.x()).writeFloat(value.rotation.y()).writeFloat(value.rotation.z());
+            buffer.writeFloat(value.originOffset).writeByte(value.flags).writeLong(value.duration).writeBoolean(value.onGround);
+            final var target = value.javaTarget;
+            buffer.writeBoolean(target.position).writeDouble(target.x).writeDouble(target.y).writeDouble(target.z);
+            buffer.writeFloat(target.yaw).writeFloat(target.pitch).writeBoolean(target.onGround);
+        }
+    };
+
+    public RemotePlayerMovement {
+        Objects.requireNonNull(uuid);
+        Objects.requireNonNull(lifetime);
+        Objects.requireNonNull(javaTarget);
+        if (entityId < 0 || mode < ACTOR || mode > 3 || flags < 0 || flags > 255
+                || !finite(position) || !finite(rotation) || !Float.isFinite(originOffset)
+                || javaTarget.position != (mode != 3)) {
+            throw new IllegalArgumentException("Invalid remote player movement");
+        }
+    }
+
+    public static boolean finite(final Position3f value) {
+        return value != null && Float.isFinite(value.x()) && Float.isFinite(value.y()) && Float.isFinite(value.z());
+    }
+
+    public record JavaTarget(boolean position, double x, double y, double z, float yaw, float pitch, boolean onGround) {
+
+        public JavaTarget {
+            if (!Double.isFinite(x) || !Double.isFinite(y) || !Double.isFinite(z) || !Float.isFinite(yaw) || !Float.isFinite(pitch)
+                    || !position && (x != 0 || y != 0 || z != 0)) {
+                throw new IllegalArgumentException("Invalid translated remote player target");
+            }
+        }
+
+    }
+
+}
