+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class RemotePlayerMovementTest {
+
+    private static final UUID PLAYER = new UUID(1, 2);
+    private static final UUID LIFETIME = new UUID(3, 4);
+
+    @Test
+    void wireRoundTripPreservesResetModesAndUnsignedActorDuration() {
+        final var bytes = Unpooled.buffer();
+        try {
+            for (int mode = RemotePlayerMovement.ACTOR; mode <= 3; mode++) {
+                final var source = movement(mode, PLAYER, LIFETIME);
+                RemotePlayerMovement.TYPE.write(bytes, source);
+                assertTrue(bytes.readableBytes() <= RemotePlayerMovement.MAX_PAYLOAD_BYTES);
+                assertEquals(source, RemotePlayerMovement.TYPE.read(bytes));
+                assertFalse(bytes.isReadable());
+                bytes.clear();
+            }
+            RemotePlayerMovement.TYPE.write(bytes, movement(0, PLAYER, LIFETIME));
+            bytes.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> RemotePlayerMovement.TYPE.read(bytes));
+            bytes.clear();
+            RemotePlayerMovement.TYPE.write(bytes, movement(0, PLAYER, LIFETIME));
+            bytes.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> RemotePlayerMovement.TYPE.read(bytes));
+        } finally {
+            bytes.release();
+        }
+    }
+
+    @Test
+    void pairingPreservesOrderAndConsumesEachModeOnce() {
+        final var tracker = new RemotePlayerMovementTracker();
+        for (int mode = 0; mode <= 3; mode++) {
+            tracker.accept(movement(mode, PLAYER, LIFETIME));
+        }
+        for (int mode = 0; mode <= 3; mode++) {
+            final var expected = movement(mode, PLAYER, LIFETIME);
+            assertEquals(expected, tracker.consume(17, expected.javaTarget(), PLAYER, LIFETIME));
+        }
+        assertNull(tracker.consume(17, movement(0, PLAYER, LIFETIME).javaTarget(), PLAYER, LIFETIME));
+    }
+
+    @Test
+    void unmatchedPacketOrReusedIdentityCannotApplyAnOlderMode() {
+        for (int mismatch = 0; mismatch < 3; mismatch++) {
+            final var tracker = new RemotePlayerMovementTracker();
+            final var source = movement(0, PLAYER, LIFETIME);
+            tracker.accept(source);
+            tracker.accept(movement(2, PLAYER, LIFETIME));
+            final var target = source.javaTarget();
+            assertNull(tracker.consume(mismatch == 0 ? 99 : 17, target,
+                    mismatch == 1 ? new UUID(5, 6) : PLAYER, mismatch == 2 ? new UUID(7, 8) : LIFETIME));
+            assertNull(tracker.consume(17, target, PLAYER, LIFETIME));
+            tracker.accept(source);
+            assertEquals(source, tracker.consume(17, target, PLAYER, LIFETIME));
+        }
+    }
+
+    @Test
+    void overflowUsesLegacyMovementUntilTheConnectionIsCleared() {
+        final var tracker = new RemotePlayerMovementTracker();
+        final var source = movement(0, PLAYER, LIFETIME);
+        for (int i = 0; i < 257; i++) {
+            tracker.accept(source);
+        }
+        assertNull(tracker.consume(17, source.javaTarget(), PLAYER, LIFETIME));
+        tracker.accept(source);
+        assertNull(tracker.consume(17, source.javaTarget(), PLAYER, LIFETIME));
+        tracker.clear();
+        tracker.accept(source);
+        assertEquals(source, tracker.consume(17, source.javaTarget(), PLAYER, LIFETIME));
+        tracker.accept(source);
+        tracker.clear();
+        assertNull(tracker.consume(17, source.javaTarget(), PLAYER, LIFETIME));
+    }
+
+    private static RemotePlayerMovement movement(final int mode, final UUID uuid, final UUID lifetime) {
+        return new RemotePlayerMovement(17, uuid, lifetime, mode, true,
+                new Position3f(1.5F, 73.24002F, 4.5F), new Position3f(22.5F, 90, 45),
+                1.62001F, (short) 255, -1L, true,
+                new RemotePlayerMovement.JavaTarget(mode != 3, mode == 3 ? 0 : 1.5D, mode == 3 ? 0 : 71.62001073360443D,
+                        mode == 3 ? 0 : 4.5D, 90, 22.5F, true));
+    }
+
+}
