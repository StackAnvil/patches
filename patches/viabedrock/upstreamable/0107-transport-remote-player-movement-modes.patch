+            assertEquals(7, Types.VAR_INT.readPrimitive(bytes));
+            if (type == ClientboundPackets26_3.MOVE_ENTITY_ROT.getId()) {
+                final boolean ground = bytes.readBoolean();
+                final var target = new RemotePlayerMovement.JavaTarget(false, 0, 0, 0,
+                        MathUtil.byte2Float(bytes.readByte()), MathUtil.byte2Float(bytes.readByte()), ground);
+                assertFalse(bytes.isReadable());
+                return target;
+            }
+            assertEquals(ClientboundPackets26_3.ENTITY_POSITION_SYNC.getId(), type);
+            assertEquals(1, Types.VAR_INT.readPrimitive(bytes));
+            assertEquals(1, Types.VAR_INT.readPrimitive(bytes));
+            final double x = bytes.readDouble();
+            final double y = bytes.readDouble();
+            final double z = bytes.readDouble();
+            assertEquals(3, Types.VAR_INT.readPrimitive(bytes));
+            final var target = new RemotePlayerMovement.JavaTarget(true, x, y, z, bytes.readFloat(), bytes.readFloat(), bytes.readBoolean());
+            assertFalse(bytes.isReadable());
+            return target;
+        } finally {
+            bytes.release();
+        }
+    }
