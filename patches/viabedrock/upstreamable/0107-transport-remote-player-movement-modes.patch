+/*
+ * This file is part of ViaBedrock - https://github.com/ViaVersionAddons/ViaBedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import java.util.ArrayDeque;
+import java.util.UUID;
+
+/** Connection-scoped FIFO pairing; an unmatched packet cannot reuse an old mode. */
+public final class RemotePlayerMovementTracker {
+
+    private static final int MAX_PENDING = 256;
+    private final ArrayDeque<RemotePlayerMovement> pending = new ArrayDeque<>();
+    private boolean disabled;
+
+    public void accept(final RemotePlayerMovement movement) {
+        if (this.disabled) {
+            return;
+        }
+        if (this.pending.size() == MAX_PENDING) {
+            this.pending.clear();
+            this.disabled = true;
+            return;
+        }
+        this.pending.addLast(movement);
+    }
+
+    public RemotePlayerMovement consume(final int entityId, final RemotePlayerMovement.JavaTarget target, final UUID uuid, final UUID lifetime) {
+        final var next = this.pending.pollFirst();
+        if (next == null) {
+            return null;
+        }
+        if (next.entityId() != entityId || !next.javaTarget().equals(target) || !next.uuid().equals(uuid) || !next.lifetime().equals(lifetime)) {
+            this.pending.clear();
+            return null;
+        }
+        return next;
+    }
+
+    public void clear() {
+        this.pending.clear();
+        this.disabled = false;
+    }
+
+}
