+class RemotePlayerMovementPacketTest {
+
+    @Test
+    void registeredMovementHandlersDeliverModesAndExactJavaTargets() throws Exception {
+        final var fixture = new Fixture();
+        try (var packets = mockStatic(PacketWrapper.class);
+             var helpers = mockStatic(PacketFactory.class)) {
+            fixture.capture(packets);
+            for (int mode = 0; mode <= 3; mode++) {
+                fixture.receipts.clear();
+                final var input = Unpooled.buffer();
+                try {
+                    fixture.playerMove(input, mode, mode == 1 ? 102 : 0);
+                    final var packet = fixture.translate(ClientboundBedrockPackets.MOVE_PLAYER, input);
+                    assertFalse(input.isReadable());
+                    final var receipt = fixture.receipts.getFirst();
+                    assertEquals(1, fixture.receipts.size());
+                    assertEquals(mode, receipt.mode());
+                    assertEquals(mode == 1, receipt.riding());
+                    assertEquals(fixture.player.nativeActorSnapshot().lifetime(), receipt.lifetime());
+                    assertEquals(fixture.player.javaUuid(), receipt.uuid());
+                    assertEquals(receipt.javaTarget(), target(packet));
+                    assertEquals(Position3f.ZERO, fixture.player.lastReceivedPosition());
+                    if (mode == 3) {
+                        assertEquals(new Position3f(22.75F, 135, -135), receipt.rotation());
+                        assertEquals(90F, receipt.javaTarget().yaw());
+                        assertEquals(22.5F, receipt.javaTarget().pitch());
+                        assertEquals(new Position3f(37, 123, 19), receipt.position());
+                        assertEquals(new Position3f(1.5F, 73.24002F, 4.5F), fixture.player.position());
+                    }
+                } finally {
+                    input.release();
+                }
+            }
+            for (boolean delta : new boolean[]{false, true}) {
+                fixture.receipts.clear();
+                final var input = Unpooled.buffer();
