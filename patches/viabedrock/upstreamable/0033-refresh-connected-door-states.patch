From 7ffbb59c9bd0e078b52df84b1f0a852296f68f0a Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:58:08 +0200
Subject: [PATCH] fix(world): refresh connected door states

Bedrock can update a door lower half without updating its upper half. Derive the upper open state from the lower block, send an upper-half update when the lower half changes, and apply the same connection while converting chunk palettes.
---
 .../protocol/packet/WorldPackets.java         |  2 +
 .../protocol/storage/ChunkTracker.java        | 44 ++++++++++++++++++-
 .../protocol/storage/ChunkTrackerTest.java    | 10 +++++
 3 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
index b5eb1b4f..8c38d978 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldPackets.java
@@ -98,6 +98,7 @@ public final class WorldPackets {
             WorldEffectPackets.stopJukeboxSong(wrapper.user(), position);
         }
         chunkTracker.sendNearbyConnectedUpdates(List.of(position));
+        chunkTracker.sendUpperDoorUpdates(List.of(position));
 
         if (remappedBlock.value() != null) {
             wrapper.send(BedrockProtocol.class);
@@ -486,6 +487,7 @@ public final class WorldPackets {
                 PacketFactory.sendJavaBlockEntityData(wrapper.user(), entry.getKey(), entry.getValue());
             }
             chunkTracker.sendNearbyConnectedUpdates(changedPositions);
+            chunkTracker.sendUpperDoorUpdates(changedPositions);
         });
         protocol.registerClientbound(ClientboundBedrockPackets.BLOCK_ENTITY_DATA, ClientboundPackets26_3.BLOCK_ENTITY_DATA, new PacketHandlers() {
             @Override
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
index 37e00a1f..ab212edc 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/storage/ChunkTracker.java
@@ -240,6 +240,12 @@ public class ChunkTracker extends StoredObject {
     public int getJavaBlockState(final BlockPosition blockPosition) {
         final int javaId = this.getUnconnectedJavaBlockState(blockPosition);
         final BlockState state = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(javaId);
+        if (isUpperDoor(state)) {
+            final BlockPosition lowerPosition = new BlockPosition(blockPosition.x(), blockPosition.y() - 1, blockPosition.z());
+            final BlockState lowerState = this.getUnconnectedJavaBlockStateModel(lowerPosition);
+            final BlockState connected = connectUpperDoor(state, lowerState);
+            return BedrockProtocol.MAPPINGS.getJavaBlockStates().getOrDefault(connected, javaId);
+        }
         if (ConnectedBlockShapes.isConnected(state)) {
             final BlockState connected = ConnectedBlockShapes.shape(blockPosition, state,
                     this::getUnconnectedJavaBlockStateModel, this::isRedstoneConductor);
@@ -248,6 +254,20 @@ public class ChunkTracker extends StoredObject {
         return javaId;
     }
 
+    private static boolean isUpperDoor(final BlockState state) {
+        return state != null && state.identifier().endsWith("_door") && state.hasProperty("half", "upper");
+    }
+
+    static BlockState connectUpperDoor(final BlockState upper, final BlockState lower) {
+        if (!isUpperDoor(upper) || lower == null || !lower.hasProperty("half", "lower")
+                || !lower.properties().containsKey("open")
+                || !upper.namespacedIdentifier().equals(lower.namespacedIdentifier())) {
+            return upper;
+        }
+        // Bedrock's upper half can retain a closed open_bit while the lower half opens.
+        return upper.withProperty("open", lower.properties().get("open"));
+    }
+
     public boolean isConnectedBlock(final BlockPosition position) {
         final BlockState state = this.getUnconnectedJavaBlockStateModel(position);
         return ConnectedBlockShapes.isConnected(state);
@@ -663,6 +683,28 @@ public class ChunkTracker extends StoredObject {
         candidates.forEach(this::sendConnectedUpdate);
     }
 
+    public void sendUpperDoorUpdates(final Collection<BlockPosition> changedPositions) {
+        final Set<BlockPosition> changed = new HashSet<>(changedPositions);
+        for (BlockPosition position : changedPositions) {
+            final BlockState lower = this.getUnconnectedJavaBlockStateModel(position);
+            if (lower == null || !lower.identifier().endsWith("_door") || !lower.hasProperty("half", "lower")) {
+                continue;
+            }
+            final BlockPosition upperPosition = new BlockPosition(position.x(), position.y() + 1, position.z());
+            if (changed.contains(upperPosition)) {
+                continue;
+            }
+            final BlockState upper = this.getUnconnectedJavaBlockStateModel(upperPosition);
+            if (!isUpperDoor(upper) || !upper.namespacedIdentifier().equals(lower.namespacedIdentifier())) {
+                continue;
+            }
+            final PacketWrapper update = PacketWrapper.create(ClientboundPackets26_3.BLOCK_UPDATE, this.user());
+            update.write(Types.BLOCK_POSITION1_14, upperPosition);
+            update.write(Types.VAR_INT, this.getJavaBlockState(upperPosition));
+            update.send(BedrockProtocol.class);
+        }
+    }
+
     private void refreshNeighboringConnectedBorders(final int chunkX, final int chunkZ) {
         final boolean westLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX - 1, chunkZ));
         final boolean eastLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX + 1, chunkZ));
@@ -1236,7 +1278,7 @@ public class ChunkTracker extends StoredObject {
                         for (int x = 0; x < 16; x++) {
                             final int javaId = remappedBlockPalette.idAt(x, y, z);
                             final BlockState state = BedrockProtocol.MAPPINGS.getJavaBlockStates().inverse().get(javaId);
-                            if (ConnectedBlockShapes.isConnected(state)) {
+                            if (ConnectedBlockShapes.isConnected(state) || isUpperDoor(state)) {
                                 final BlockPosition position = new BlockPosition((chunk.getX() << 4) + x,
                                         this.minY + (idx << 4) + y, (chunk.getZ() << 4) + z);
                                 remappedBlockPalette.setIdAt(x, y, z, this.getJavaBlockState(position));
