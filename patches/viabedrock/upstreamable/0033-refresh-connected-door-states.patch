         assertTrue(ChunkTracker.changesLight(1, 3, emission, opacity));
     }
 
+    @Test
+    void upperDoorCopiesOpenStateFromLowerHalf() {
+        final BlockState upper = BlockState.fromString("minecraft:oak_door[facing=north,half=upper,hinge=right,open=false,powered=false]");
+        final BlockState lower = BlockState.fromString("minecraft:oak_door[facing=north,half=lower,hinge=left,open=true,powered=false]");
+
+        assertEquals(upper.withProperty("open", "true"), ChunkTracker.connectUpperDoor(upper, lower));
+        assertEquals(upper, ChunkTracker.connectUpperDoor(upper, BlockState.fromString("minecraft:iron_door[half=lower,open=true]")));
+    }
+
     private static BedrockChunkSectionImpl sectionWithBlock(final int blockId) {
         final BedrockChunkSectionImpl section = new BedrockChunkSectionImpl();
         final BedrockDataPalette palette = new BedrockDataPalette();
