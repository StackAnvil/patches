+package net.raphimc.viabedrock.protocol.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec2;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec3;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraPresetTest {
+
+    @Test
+    void optionalFieldsAndUnknownNumericEnumsSurviveWireRoundtrip() {
+        final var full = full("example:full", "minecraft:free");
+        final var empty = empty("minecraft:free", "");
+        final var buffer = Unpooled.buffer();
+        try {
+            final var expected = List.of(full, empty);
+            CameraPreset.LIST_TYPE.write(buffer, expected);
+            assertEquals(expected, CameraPreset.LIST_TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void inheritanceResolvesForwardParentsAndPreservesWireIndexes() {
+        final var child = empty("example:child", "example:parent");
+        final var parent = full("example:parent", "minecraft:free");
+        final var registry = new CameraPresetRegistry(List.of(child, parent, empty("minecraft:free", "")));
+        final var inherited = registry.get(0).preset();
+        assertEquals(CameraPresetRegistry.Base.FREE, registry.get(0).base());
+        assertEquals(child.name(), inherited.name());
+        assertEquals(child.parent(), inherited.parent());
+        assertEquals(parent.posX(), inherited.posX());
