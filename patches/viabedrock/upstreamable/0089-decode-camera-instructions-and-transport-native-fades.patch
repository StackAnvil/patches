+package net.raphimc.viabedrock.api.model;
+
+/** Camera interpolation functions used by the native client. Factors may overshoot. */
+public enum CameraEase {
+
+    LINEAR, SPRING,
+    IN_QUAD, OUT_QUAD, IN_OUT_QUAD,
+    IN_CUBIC, OUT_CUBIC, IN_OUT_CUBIC,
+    IN_QUART, OUT_QUART, IN_OUT_QUART,
+    IN_QUINT, OUT_QUINT, IN_OUT_QUINT,
+    IN_SINE, OUT_SINE, IN_OUT_SINE,
+    IN_EXPO, OUT_EXPO, IN_OUT_EXPO,
+    IN_CIRC, OUT_CIRC, IN_OUT_CIRC,
+    IN_BOUNCE, OUT_BOUNCE, IN_OUT_BOUNCE,
+    IN_BACK, OUT_BACK, IN_OUT_BACK,
+    IN_ELASTIC, OUT_ELASTIC, IN_OUT_ELASTIC;
+
+    private static final float PI = (float) Math.PI;
+    private static final float HALF_PI = PI / 2;
+    private static final float SINE_INDEX = 10430.3779296875F;
+    private static final float[] SINE = new float[65536];
+
+    static {
+        for (int i = 0; i < SINE.length; i++) {
+            SINE[i] = (float) Math.sin(i / SINE_INDEX);
+        }
+    }
+
+    public static CameraEase fromName(final String name) {
+        for (final CameraEase ease : values()) {
+            if (ease.name().equalsIgnoreCase(name)) {
+                return ease;
+            }
+        }
+        // The native FOV selector uses linear for unknown names and inverse_lerp.
+        return LINEAR;
+    }
+
+    public float factor(final float progress) {
+        final float t = progress;
+        final float doubled = t + t;
+        final float minusOne = t - 1;
+        final float minusTwo = doubled - 2;
+        return switch (this) {
+            case LINEAR -> t;
+            case SPRING -> {
+                final float clamped = Math.clamp(t, 0, 1);
+                final float remaining = 1 - clamped;
+                final float wave = sine((2.5F * clamped * clamped * clamped + .2F) * PI * clamped);
+                yield (power(remaining, 2.2F) * wave + clamped) * (remaining * 1.2F + 1);
+            }
+            case IN_QUAD -> t * t;
+            case OUT_QUAD -> -t * (t - 2);
+            case IN_OUT_QUAD -> doubled < 1 ? doubled * doubled * .5F : -((doubled - 1) * (doubled - 3) - 1) * .5F;
+            case IN_CUBIC -> t * t * t;
+            case OUT_CUBIC -> minusOne * minusOne * minusOne + 1;
+            case IN_OUT_CUBIC -> (doubled < 1 ? doubled * doubled * doubled : minusTwo * minusTwo * minusTwo + 2) * .5F;
+            case IN_QUART -> t * t * t * t;
+            case OUT_QUART -> -(minusOne * minusOne * minusOne * minusOne - 1);
+            case IN_OUT_QUART -> doubled < 1 ? doubled * doubled * doubled * doubled * .5F : -(minusTwo * minusTwo * minusTwo * minusTwo - 2) * .5F;
+            case IN_QUINT -> t * t * t * t * t;
+            case OUT_QUINT -> minusOne * minusOne * minusOne * minusOne * minusOne + 1;
+            case IN_OUT_QUINT -> (doubled < 1 ? doubled * doubled * doubled * doubled * doubled : minusTwo * minusTwo * minusTwo * minusTwo * minusTwo + 2) * .5F;
+            case IN_SINE -> 1 - cosine(t * HALF_PI);
+            case OUT_SINE -> sine(t * HALF_PI);
+            case IN_OUT_SINE -> (cosine(t * PI) - 1) * -.5F;
+            case IN_EXPO -> exp2(minusOne * 10);
+            case OUT_EXPO -> 1 - exp2(t * -10);
+            case IN_OUT_EXPO -> doubled < 1 ? exp2((doubled - 1) * 10) * .5F : (2 - exp2((doubled - 1) * -10)) * .5F;
+            case IN_CIRC -> -(squareRoot(1 - t * t) - 1);
+            case OUT_CIRC -> squareRoot(1 - minusOne * minusOne);
+            case IN_OUT_CIRC -> doubled < 1 ? -(squareRoot(1 - doubled * doubled) - 1) * .5F : (squareRoot(1 - minusTwo * minusTwo) + 1) * .5F;
+            case IN_BOUNCE -> 1 - bounce(1 - t);
+            case OUT_BOUNCE -> bounce(t);
+            case IN_OUT_BOUNCE -> t < .5F ? (1 - bounce(1 - doubled)) * .5F : .5F + bounce(doubled - 1) * .5F;
+            case IN_BACK -> (t * 2.701580047607422F - 1.7015800476074219F) * t * t;
+            case OUT_BACK -> (minusOne * 2.701580047607422F + 1.7015800476074219F) * minusOne * minusOne + 1;
+            case IN_OUT_BACK -> (doubled < 1 ? (doubled * 3.594909429550171F - 2.594909429550171F) * doubled * doubled
+                    : (minusTwo * 3.594909429550171F + 2.594909429550171F) * minusTwo * minusTwo + 2) * .5F;
+            case IN_ELASTIC -> t == 0 || t == 1 ? t : -exp2(minusOne * 10) * elasticSine(minusOne);
+            case OUT_ELASTIC -> t == 0 || t == 1 ? t : exp2(t * -10) * elasticSine(t) + 1;
+            case IN_OUT_ELASTIC -> {
+                if (t == 0 || t == 1) {
+                    yield t;
+                }
+                final float shifted = doubled - 1;
+                yield doubled < 1 ? exp2(shifted * 10) * elasticSine(shifted) * -.5F
+                        : exp2(shifted * -10) * elasticSine(shifted) * .5F + 1;
+            }
+        };
+    }
+
+    private static float sine(final float radians) {
+        return SINE[(int) (radians * SINE_INDEX) & 65535];
+    }
+
+    private static float cosine(final float radians) {
+        return SINE[(int) (radians * SINE_INDEX + 16384F) & 65535];
+    }
+
+    private static float elasticSine(final float progress) {
+        return sine(((progress - .075F) * (PI + PI)) / .3F);
+    }
+
+    private static float power(final float base, final float exponent) {
+        return (float) Math.pow(base, exponent);
+    }
+
+    private static float exp2(final float exponent) {
+        return power(2, exponent);
+    }
+
+    private static float squareRoot(final float value) {
+        return (float) Math.sqrt(value);
+    }
+
+    private static float bounce(final float progress) {
+        float t = progress;
+        final float offset;
+        if (t >= .9090909361839294F) {
+            t -= .9545454382896423F;
+            offset = .984375F;
+        } else if (t >= .7272727489471436F) {
+            t -= .8181818127632141F;
+            offset = .9375F;
+        } else if (t >= .3636363744735718F) {
+            t -= .5454545617103577F;
+            offset = .75F;
+        } else {
+            offset = 0;
+        }
+        return 7.5625F * t * t + offset;
+    }
+
+}
