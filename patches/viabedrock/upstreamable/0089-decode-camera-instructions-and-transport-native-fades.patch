+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.type.Types;
+
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.api.model.CameraShakeState;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ClientboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.CameraShakeAction;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.CameraShakeType;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import net.raphimc.viabedrock.protocol.model.CameraPreset;
+import net.raphimc.viabedrock.protocol.model.CameraPresetRegistry;
+import net.raphimc.viabedrock.protocol.storage.CameraEffectsStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+public final class CameraPackets {
+
+    public static void register(final BedrockProtocol protocol) {
+        protocol.registerClientbound(ClientboundBedrockPackets.CAMERA_PRESETS, null, wrapper -> {
+            wrapper.cancel();
+            final var presets = wrapper.read(CameraPreset.LIST_TYPE);
+            if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                throw new IllegalArgumentException("Unexpected camera preset fields");
+            }
+            try {
+                final CameraPresetRegistry registry = new CameraPresetRegistry(presets);
+                wrapper.user().get(CameraEffectsStorage.class).setPresets(registry);
+                if (!registry.unresolved().isEmpty()) {
+                    ViaBedrock.getPlatform().getLogger().warning("Unresolved camera presets: " + registry.unresolved());
+                }
+            } catch (final IllegalArgumentException exception) {
+                ViaBedrock.getPlatform().getLogger().warning("Ignoring invalid camera presets: " + exception.getMessage());
+            }
+        });
+        protocol.registerClientbound(
+                ClientboundBedrockPackets.CAMERA_SHAKE,
+                null,
+                wrapper -> {
+                    wrapper.cancel();
+                    final float intensity = wrapper.read(BedrockTypes.FLOAT_LE);
+                    final float duration = wrapper.read(BedrockTypes.FLOAT_LE);
+                    final int type = wrapper.read(Types.UNSIGNED_BYTE);
+                    final int action = wrapper.read(Types.UNSIGNED_BYTE);
+                    if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                        throw new IllegalArgumentException("Unexpected camera shake fields");
+                    }
+                    if (action == CameraShakeAction.Stop.getValue()) {
+                        wrapper.user()
+                                .get(CameraEffectsStorage.class)
+                                .applyShake(new CameraShakeState.Command(true, 0, 0, 0));
+                    } else if (action == CameraShakeAction.Add.getValue()
+                            && CameraShakeType.getByValue(type) != null
+                            && Float.isFinite(intensity)
+                            && intensity > 0
+                            && Float.isFinite(duration)
+                            && duration > 0) {
+                        try {
+                            wrapper.user()
+                                    .get(CameraEffectsStorage.class)
+                                    .applyShake(
+                                            new CameraShakeState.Command(
+                                                    false, type, intensity, duration));
+                        } catch (final IllegalArgumentException exception) {
+                            ViaBedrock.getPlatform()
+                                    .getLogger()
+                                    .warning(
+                                            "Ignoring invalid camera shake: "
+                                                    + exception.getMessage());
+                        }
+                    }
+                });
+        protocol.registerClientbound(
+                ClientboundBedrockPackets.CAMERA_INSTRUCTION,
+                null,
+                wrapper -> {
+                    wrapper.cancel();
+                    final CameraInstruction instruction = wrapper.read(CameraInstruction.TYPE);
+                    if (wrapper.read(Types.REMAINING_BYTES).length != 0) {
+                        throw new IllegalArgumentException("Unexpected camera instruction fields");
+                    }
+                    try {
+                        wrapper.user().get(CameraEffectsStorage.class).apply(instruction);
+                    } catch (final IllegalArgumentException exception) {
+                        ViaBedrock.getPlatform()
+                                .getLogger()
+                                .warning(
+                                        "Ignoring invalid camera effect: "
+                                                + exception.getMessage());
+                    }
+                });
+    }
+
+    private CameraPackets() { }
+
+}
