@@ -0,0 +1,102 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+
+/** Native incremental camera blend. The caller supplies current target and parent poses. */
+public final class CameraPoseTimeline {
+
+    private static final float EPSILON = Math.ulp(1F);
+    private CameraPose start;
+    private CameraPose current;
+    private Vector currentAngles;
+    private Vector previousParent;
+    private CameraEase ease;
+    private float duration;
+    private float progress;
+    private float previousFactor;
+    private boolean started;
+
+    public CameraPose current() {
+        return this.current;
+    }
+
+    public boolean blending() {
+        return this.duration > EPSILON;
+    }
+
+    public float progress() {
+        return this.progress;
+    }
+
+    public void begin(final CameraPose rendered, final float duration, final CameraEase ease) {
+        if (rendered == null || !Float.isFinite(duration) || ease == null) {
+            throw new IllegalArgumentException("Invalid camera blend");
+        }
+        this.start = this.current = rendered;
+        this.currentAngles = rendered.orientation().angles();
+        this.ease = ease;
+        this.duration = duration;
+        this.progress = this.previousFactor = 0;
+        this.previousParent = null;
+        this.started = false;
+    }
+
+    public CameraPose advance(final float delta, final CameraPose target, final Vector parent) {
+        if (!Float.isFinite(delta) || delta < 0 || target == null || this.current == null) {
+            throw new IllegalArgumentException("Invalid camera blend frame");
+        }
+        if (this.duration > EPSILON) {
+            this.progress += delta / this.duration;
+            if (this.progress < 1) {
+                final float factor = this.ease.factor(this.progress);
+                float step = factor;
+                CameraPose.Vector position = this.start.position();
+                CameraPose.Vector angles = this.start.orientation().angles();
+                float fov = this.start.fov();
+                if (this.started) {
+                    final float remaining = 1 - this.previousFactor;
+                    step =
+                            (factor - this.previousFactor)
+                                    / (Math.abs(remaining) < EPSILON ? EPSILON : remaining);
+                    position = this.current.position();
+                    if (parent != null && this.previousParent != null) {
+                        position = position.add(parent.subtract(this.previousParent));
+                    }
+                    angles = this.currentAngles;
+                    fov = this.current.fov();
+                }
+                final Vector targetAngles = target.orientation().angles();
+                float yaw = ((targetAngles.y() - angles.y()) + CameraPose.PI) % (2 * CameraPose.PI);
+                if (yaw < 0) {
+                    yaw += 2 * CameraPose.PI;
+                }
+                this.currentAngles =
+                        new Vector(
+                                CameraPose.mix(angles.x(), targetAngles.x(), step),
+                                (yaw - CameraPose.PI) * step + angles.y(),
+                                CameraPose.mix(angles.z(), targetAngles.z(), step));
+                this.current =
+                        new CameraPose(
+                                position.interpolate(target.position(), step),
+                                CameraPose.Quaternion.fromAngles(this.currentAngles),
+                                CameraPose.mix(fov, target.fov(), step),
+                                this.current.renderingMode());
+                this.started = true;
+                this.previousFactor = factor;
+                this.previousParent = parent;
+                return this.current;
+            }
+            this.duration = 0;
+        }
+        this.started = false;
+        this.current = target;
+        this.currentAngles = target.orientation().angles();
+        return target;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/api/model/CameraPositionState.java b/src/main/java/net/raphimc/viabedrock/api/model/CameraPositionState.java
new file mode 100644
