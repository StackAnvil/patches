+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+import io.netty.buffer.Unpooled;
+
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+class CameraPositionControllerTest {
+
+    @Test
+    void overridesPersistPerPresetAndDefaultClearsThem() {
+        final var root = preset("minecraft:free", "", 0);
+        final var child = preset("example:child", root.name(), 10);
+        final var registry = new CameraPresetRegistry(List.of(root, child));
+        final var controller = new CameraPositionController();
+        controller.apply(
+                set(
+                        1,
+                        new CameraInstruction.Vec3(20, 21, 22),
+                        new CameraInstruction.Vec2(15, 170),
+                        null),
+                registry);
+        controller.apply(set(0, null, null, null), registry);
+        assertEquals(0, controller.state().position().x());
+        controller.apply(set(1, null, null, false), registry);
+        assertEquals(20, controller.state().position().x());
+        assertEquals(15, controller.state().pitch());
+        controller.apply(set(1, null, null, true), registry);
+        assertEquals(10, controller.state().position().x());
+        assertEquals(0, controller.state().pitch());
+        final long before = controller.state().sequence();
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> controller.apply(set(100, null, null, null), registry));
+        assertEquals(before, controller.state().sequence());
+        controller.apply(
+                new CameraInstruction(null, true, null, null, null, null, null, null, null),
+                registry);
+        assertEquals(CameraPositionState.Mode.LOCAL, controller.state().mode());
+    }
+
+    @Test
+    void nativeRecordedCommandsResolveInheritedChildAndCorrectEasing() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_COMMANDS");
+        assumeTrue(source != null);
+        final var directory = Path.of(source);
+        final var presets =
+                Unpooled.wrappedBuffer(Files.readAllBytes(directory.resolve("custom-198-1.bin")));
+        final CameraPresetRegistry registry;
+        try {
+            registry = new CameraPresetRegistry(CameraPreset.LIST_TYPE.read(presets));
+        } finally {
+            presets.release();
+        }
+        final var controller = new CameraPositionController();
+        for (int i = 1; i <= 9; i++) {
+            final var b =
+                    Unpooled.wrappedBuffer(
+                            Files.readAllBytes(directory.resolve("custom-300-" + i + ".bin")));
+            try {
+                assertTrue(controller.apply(CameraInstruction.TYPE.read(b), registry));
+            } finally {
+                b.release();
+            }
+            final var state = controller.state();
+            assertEquals(i, state.sequence());
+            if (i == 2) {
+                assertEquals(-75.5F, state.position().x());
+                assertEquals(134, state.position().y());
+                assertEquals(32.5F, state.position().z());
+                assertEquals(15, state.pitch());
+                assertEquals(-170, state.yaw());
+                assertTrue(state.playerAudio());
+                assertFalse(state.playerEffects());
+            }
+            if (i == 4) {
+                assertEquals(CameraEase.LINEAR, state.ease());
+                assertEquals(2, state.duration());
+            }
+            if (i == 5) {
+                assertEquals(CameraEase.OUT_BACK, state.ease());
+                assertEquals(4, state.duration());
+            }
+        }
+        assertEquals(CameraPositionState.Mode.LOCAL, controller.state().mode());
+    }
+
+    @Test
+    void nativeFacingThresholdsAndVerticalTargetsPreserveFallbackAngles() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FACING");
+        assumeTrue(source != null);
+        final var rows = com.google.gson.JsonParser.parseString(Files.readString(Path.of(source)))
+                .getAsJsonObject().getAsJsonArray("cases");
+        final var registry = new CameraPresetRegistry(List.of(preset("minecraft:free", "", 0)));
+        int checked = 0;
+        for (final var row : rows) {
+            final var sample = row.getAsJsonObject();
+            final var target = sample.getAsJsonArray("target");
+            final var previous = sample.getAsJsonArray("previous");
+            final var expected = sample.getAsJsonArray("rotation");
+            final var controller = new CameraPositionController();
+            controller.apply(new CameraInstruction(new CameraInstruction.SetCamera(0, null,
+                    new CameraInstruction.Vec3(0, 0, 0),
+                    new CameraInstruction.Vec2(previous.get(0).getAsFloat(), previous.get(1).getAsFloat()),
+                    new CameraInstruction.Vec3(target.get(0).getAsFloat(), target.get(1).getAsFloat(), target.get(2).getAsFloat()),
+                    null, null, null, false), null, null, null, null, null, null, null, null), registry);
+            assertEquals(expected.get(0).getAsFloat(), controller.state().pitch(), .00001F);
+            assertEquals(expected.get(1).getAsFloat(), controller.state().yaw(), .00001F);
+            checked++;
+        }
+        assertEquals(12, checked);
+    }
+
+    private static CameraInstruction set(
+            final long preset,
+            final CameraInstruction.Vec3 position,
+            final CameraInstruction.Vec2 rotation,
+            final Boolean defaults) {
+        return new CameraInstruction(
+                new CameraInstruction.SetCamera(
+                        preset, null, position, rotation, null, null, null, defaults, false),
+                null,
+                null,
+                null,
+                null,
+                null,
+                null,
+                null,
+                null);
+    }
+
+    private static CameraPreset preset(final String name, final String parent, final float x) {
+        return new CameraPreset(
+                name, parent, x, 0F, 0F, 0F, 0F, null, null, null, null, null, null, null, null,
+                null, null, null, null, null, null, null, false, null);
+    }
+
+}
