@@ -0,0 +1,124 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import io.netty.buffer.ByteBuf;
+
+/** Core-resolved command. Only the rendering client can supply the interrupted frame's pose. */
+public record CameraPositionState(
+        long sequence,
+        float elapsed,
+        boolean live,
+        Mode mode,
+        CameraPose.Vector position,
+        float pitch,
+        float yaw,
+        float duration,
+        CameraEase ease,
+        boolean playerEffects,
+        boolean playerAudio) {
+
+    public static final String CHANNEL = "viabedrock:camera_position";
+    public static final CameraPositionState EMPTY =
+            new CameraPositionState(
+                    0,
+                    0,
+                    false,
+                    Mode.LOCAL,
+                    CameraPose.Vector.ZERO,
+                    0,
+                    0,
+                    0,
+                    CameraEase.LINEAR,
+                    true,
+                    true);
+    public static final Type<CameraPositionState> TYPE =
+            new Type<>(CameraPositionState.class) {
+
+                @Override
+                public CameraPositionState read(final ByteBuf b) {
+                    if (Types.VAR_INT.readPrimitive(b) != 1) {
+                        throw new IllegalArgumentException("Unsupported camera position version");
+                    }
+                    final long sequence = b.readLong();
+                    final float elapsed = b.readFloat();
+                    final boolean live = b.readBoolean();
+                    final int mode = b.readUnsignedByte();
+                    if (mode >= Mode.values().length) {
+                        throw new IllegalArgumentException("Invalid camera mode");
+                    }
+                    final CameraPose.Vector position =
+                            new CameraPose.Vector(b.readFloat(), b.readFloat(), b.readFloat());
+                    final float pitch = b.readFloat();
+                    final float yaw = b.readFloat();
+                    final float duration = b.readFloat();
+                    final int ease = b.readUnsignedByte();
+                    if (ease >= CameraEase.values().length) {
+                        throw new IllegalArgumentException("Invalid camera ease");
+                    }
+                    final CameraPositionState state =
+                            new CameraPositionState(
+                                    sequence,
+                                    elapsed,
+                                    live,
+                                    Mode.values()[mode],
+                                    position,
+                                    pitch,
+                                    yaw,
+                                    duration,
+                                    CameraEase.values()[ease],
+                                    b.readBoolean(),
+                                    b.readBoolean());
+                    if (b.isReadable()) {
+                        throw new IllegalArgumentException("Unexpected camera position fields");
+                    }
+                    return state;
+                }
+
+                @Override
+                public void write(final ByteBuf b, final CameraPositionState s) {
+                    Types.VAR_INT.writePrimitive(b, 1);
+                    b.writeLong(s.sequence)
+                            .writeFloat(s.elapsed)
+                            .writeBoolean(s.live)
+                            .writeByte(s.mode.ordinal());
+                    b.writeFloat(s.position.x())
+                            .writeFloat(s.position.y())
+                            .writeFloat(s.position.z());
+                    b.writeFloat(s.pitch)
+                            .writeFloat(s.yaw)
+                            .writeFloat(s.duration)
+                            .writeByte(s.ease.ordinal());
+                    b.writeBoolean(s.playerEffects).writeBoolean(s.playerAudio);
+                }
+            };
+
+    public CameraPositionState {
+        if (sequence < 0
+                || !Float.isFinite(elapsed)
+                || elapsed < 0
+                || mode == null
+                || position == null
+                || !Float.isFinite(pitch)
+                || !Float.isFinite(yaw)
+                || !Float.isFinite(duration)
+                || ease == null) {
+            throw new IllegalArgumentException("Invalid camera position state");
+        }
+    }
+
+    public enum Mode {
+        LOCAL,
+        FIRST_PERSON,
+        THIRD_PERSON,
+        THIRD_PERSON_FRONT,
+        FREE
+    }
+
+}
