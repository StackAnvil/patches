+package net.raphimc.viabedrock.protocol.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HexFormat;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraInstructionTest {
+
+    @Test
+    void completeInstructionsPreserveAbsentAndFalseOptionsAndSignedActorIds() {
+        final var vec = new CameraInstruction.Vec3(-3.25F, 80, 7.5F);
+        final var set = new CameraInstruction.SetCamera(0xFFFFFFFFL, new CameraInstruction.Ease(31, 2), vec,
+                new CameraInstruction.Vec2(25, -30), vec, new CameraInstruction.Vec2(1, 2), vec, false, true);
+        final var spline = new CameraInstruction.Spline(5, 1, List.of(vec), List.of(new CameraInstruction.Progress(.25F, 2, "in_quad")),
+                List.of(new CameraInstruction.Rotation(vec, 3, "linear")), "example:route", false);
+        for (final long id : new long[]{Long.MIN_VALUE, -1, Long.MAX_VALUE}) {
+            final var instruction = new CameraInstruction(set, false, new CameraInstruction.Fade(null, vec), new CameraInstruction.Target(vec, id),
+                    true, new CameraInstruction.FieldOfView(30, .5F, "in_out_cubic", true), spline, id, false);
+            final var buffer = Unpooled.buffer();
+            try {
+                CameraInstruction.TYPE.write(buffer, instruction);
+                assertEquals(instruction, CameraInstruction.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsUnboundedSplineCountsBeforeAllocation() {
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeZero(6).writeBoolean(true).writeFloatLE(1).writeBoolean(false);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, Integer.MAX_VALUE);
+            assertThrows(IllegalArgumentException.class, () -> CameraInstruction.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void matchingServerInstructionsConsumeEveryWireField() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_WIRE");
+        assumeTrue(source != null);
+        int count = 0;
+        for (final String line : Files.readAllLines(Path.of(source))) {
+            if (!line.contains(" bytes=")) {
+                continue;
+            }
+            final String hex = line.split(" bytes=", 2)[1].split(" ", 2)[0];
+            final var buffer = Unpooled.wrappedBuffer(HexFormat.of().parseHex(hex));
+            final var output = Unpooled.buffer();
+            try {
+                final var instruction = CameraInstruction.TYPE.read(buffer);
+                assertFalse(buffer.isReadable());
+                CameraInstruction.TYPE.write(output, instruction);
+                assertEquals(hex, HexFormat.of().formatHex(com.viaversion.viaversion.api.type.Types.REMAINING_BYTES.read(output)));
+                count++;
+            } finally {
+                buffer.release();
+                output.release();
+            }
+        }
+        assertEquals(7, count);
+    }
+
+}
