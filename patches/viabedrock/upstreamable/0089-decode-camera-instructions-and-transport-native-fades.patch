+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonParser;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.CameraFovState.Command;
+import net.raphimc.viabedrock.api.model.CameraFovState.Transition;
+import net.raphimc.viabedrock.api.model.CameraFovState.Value;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraFovTimelineTest {
+
+    @Test
+    void immediateSetRetainsEaseAndSetRetainsPendingClear() {
+        final var timeline = new CameraFovTimeline();
+        final Value normal = degrees(85);
+        timeline.apply(new Command(30, 2, CameraEase.LINEAR, false), normal, normal);
+        final Value halfway = timeline.advance(1);
+        assertEquals(57.5F, toDegrees(halfway), .00001F);
+        timeline.apply(new Command(110, 0, CameraEase.SPRING, false), halfway, normal);
+        assertEquals(.5F, timeline.state().progress());
+        assertEquals(CameraEase.LINEAR, timeline.state().ease());
+        assertEquals(103.75F, toDegrees(timeline.advance(.5F)), .00002F);
+        timeline.apply(new Command(0, 1, CameraEase.LINEAR, true), timeline.state().current(), normal);
+        timeline.advance(.25F);
+        timeline.apply(new Command(45, .5F, CameraEase.LINEAR, false), timeline.state().current(), normal);
+        assertTrue(timeline.state().clear());
+        assertEquals(45, toDegrees(timeline.advance(.5F)), .00002F);
+        assertTrue(timeline.state().active());
+        assertEquals(45, toDegrees(timeline.advance(0)), .00002F);
+        assertFalse(timeline.state().active());
+        assertNull(timeline.advance(.1F));
+    }
+
+    @Test
+    void transportPreservesUnresolvedProjectionAndElapsedTransition() {
+        final var timeline = new CameraFovTimeline();
+        timeline.apply(new Command(30, 2, CameraEase.OUT_BACK, false), Value.LOCAL, Value.LOCAL);
+        timeline.advance(.5F);
+        final var snapshot = new CameraFovState(4, .75F, timeline.state(), null);
+        final var buffer = Unpooled.buffer();
+        try {
+            CameraFovState.TYPE.write(buffer, snapshot);
+            final var decoded = CameraFovState.TYPE.read(buffer);
+            assertEquals(snapshot, decoded);
+            final var client = new CameraFovTimeline();
+            client.restore(decoded.transition().resolveLocal(degrees(95).radians()));
+            client.advance(decoded.elapsed());
+            final var continuous = new CameraFovTimeline();
+            continuous.apply(new Command(30, 2, CameraEase.OUT_BACK, false), degrees(95), degrees(95));
+            continuous.advance(.5F);
+            assertEquals(toDegrees(continuous.advance(.75F)), toDegrees(client.state().current()), .00002F);
+            assertEquals(.625F, client.state().progress());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void nativeEasingFactorsMatchTargetExecutable() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_EASING");
+        assumeTrue(source != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        int checked = 0;
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            if (row.get("start").getAsFloat() != 0 || row.get("end").getAsFloat() != 1) {
+                continue;
+            }
+            assertEquals(row.get("value").getAsFloat(), CameraEase.values()[row.get("type").getAsInt()]
+                    .factor(row.get("progress").getAsFloat()), .000002F, row.toString());
+            checked++;
+        }
+        assertEquals(640, checked);
+    }
+
+    @Test
+    void nativeFrameUpdaterMatchesTargetExecutable() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FOV");
+        assumeTrue(source != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject().getAsJsonArray("cases");
+        int checked = 0;
+        for (final var entry : rows) {
+            final var row = entry.getAsJsonObject();
+            final var timeline = new CameraFovTimeline();
+            final Value start = Value.constant(row.get("start").getAsFloat());
+            final Value target = Value.constant(row.get("target").getAsFloat());
+            // Component probes use raw units and exercise the updater independently of command clamping.
+            timeline.restore(new Transition(true, true, row.get("clear").getAsBoolean(), start, target, start,
+                    0, row.get("duration").getAsFloat(), CameraEase.LINEAR));
+            final var steps = row.getAsJsonArray("steps");
+            final var observed = row.getAsJsonArray("observed");
+            for (int i = 0; i < steps.size(); i++) {
+                final var expected = observed.get(i).getAsJsonObject();
+                final Value value = timeline.advance(steps.get(i).getAsFloat());
+                if (value == null) {
+                    // The probe's empty host storage does not remove its supplied component.
+                    assertTrue(row.get("clear").getAsBoolean());
+                    continue;
+                }
+                assertEquals(expected.get("value").getAsFloat(), value.radians(), .00002F, row.toString());
+                if (timeline.state().active()) {
+                    assertEquals(expected.get("progress").getAsFloat(), timeline.state().progress());
+                    assertEquals(expected.get("duration").getAsFloat(), timeline.state().duration());
+                } else {
+                    assertFalse(expected.getAsJsonArray("clearStorageRequests").isEmpty());
+                }
+            }
+            checked++;
+        }
+        assertEquals(288, checked);
+    }
+
+    private static Value degrees(final float value) {
+        return Value.constant(value * CameraFovState.DEGREES_TO_RADIANS);
+    }
+
+    private static float toDegrees(final Value value) {
+        return value.radians() / CameraFovState.DEGREES_TO_RADIANS;
+    }
+
+}
