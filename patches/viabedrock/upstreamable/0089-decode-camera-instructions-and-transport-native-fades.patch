+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** A core-resolved fade timeline. Elapsed time is relative to its first point. */
+public record CameraFadeState(float red, float green, float blue, float elapsed, List<Point> points) {
+
+    public static final String CHANNEL = "viabedrock:camera_fade";
+    public static final CameraFadeState EMPTY = new CameraFadeState(0, 0, 0, 0, List.of());
+    public static final Type<CameraFadeState> TYPE = new Type<>(CameraFadeState.class) {
+        @Override
+        public CameraFadeState read(final ByteBuf b) {
+            if (Types.VAR_INT.readPrimitive(b) != 1) {
+                throw new IllegalArgumentException("Unsupported camera fade payload version");
+            }
+            final float red = b.readFloat();
+            final float green = b.readFloat();
+            final float blue = b.readFloat();
+            final float elapsed = b.readFloat();
+            final int count = Types.VAR_INT.readPrimitive(b);
+            if (count < 0 || count > 64) {
+                throw new IllegalArgumentException("Invalid camera fade point count");
+            }
+            final List<Point> points = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                points.add(new Point(b.readFloat(), b.readFloat()));
+            }
+            final CameraFadeState state = new CameraFadeState(red, green, blue, elapsed, points);
+            if (b.isReadable()) {
+                throw new IllegalArgumentException("Unexpected camera fade payload fields");
+            }
+            return state;
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraFadeState state) {
+            Types.VAR_INT.writePrimitive(b, 1);
+            b.writeFloat(state.red).writeFloat(state.green).writeFloat(state.blue).writeFloat(state.elapsed);
+            Types.VAR_INT.writePrimitive(b, state.points.size());
+            for (final Point point : state.points) {
+                b.writeFloat(point.time).writeFloat(point.alpha);
+            }
+        }
+    };
+
+    public CameraFadeState {
+        points = List.copyOf(points);
+        if (!Float.isFinite(red) || !Float.isFinite(green) || !Float.isFinite(blue)
+                || !Float.isFinite(elapsed) || elapsed < 0 || points.size() > 64) {
+            throw new IllegalArgumentException("Invalid camera fade state");
+        }
+        float previous = -1;
+        for (final Point point : points) {
+            if (!Float.isFinite(point.time) || point.time < 0 || point.time < previous
+                    || !Float.isFinite(point.alpha) || point.alpha < 0 || point.alpha > 1) {
+                throw new IllegalArgumentException("Invalid camera fade point");
+            }
+            previous = point.time;
+        }
+    }
+
+    public float alpha(final float time) {
+        if (this.points.isEmpty() || time < 0 || time >= this.points.getLast().time) {
+            return 0;
+        }
+        float previousTime = 0;
+        float previousAlpha = 0;
+        for (final Point point : this.points) {
+            if (point.time - .0001F <= time) {
+                if (time <= point.time + .0001F) {
+                    return point.alpha;
+                }
+                previousTime = point.time;
+                previousAlpha = point.alpha;
+            } else {
+                final float progress = (time - previousTime) / (point.time - previousTime);
+                return progress >= 0 && progress <= 1 ? previousAlpha + (point.alpha - previousAlpha) * progress : point.alpha;
+            }
+        }
+        return 0;
+    }
+
+    public record Point(float time, float alpha) { }
+
+}
