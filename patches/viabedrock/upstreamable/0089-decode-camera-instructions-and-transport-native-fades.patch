@@ -0,0 +1,119 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraShakeState.Command;
+import net.raphimc.viabedrock.api.model.CameraShakeState.Event;
+import net.raphimc.viabedrock.api.model.CameraShakeState.Snapshot;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Native queue updates shared by proxies and rendering clients. */
+public final class CameraShakeTimeline {
+
+    private static final float FREQUENCY = 10;
+    private static final float AMPLITUDE = 5F * ((float) Math.PI / 180F);
+    private static final float NOISE_MULTIPLIER = 4;
+    private final List<Event> events = new ArrayList<>();
+    private long seed;
+    private float phase;
+    private float positional;
+    private float rotational;
+    private CameraShakeNoise noise;
+
+    public void apply(final Command command, final long seed) {
+        if (command.stop()) {
+            this.clear();
+            return;
+        }
+        if (this.events.size() >= CameraShakeState.MAX_EVENTS) {
+            throw new IllegalArgumentException("Too many camera shake events");
+        }
+        if (this.events.isEmpty()) {
+            this.seed = seed;
+            this.noise = new CameraShakeNoise(seed);
+        }
+        this.events.add(new Event(command.type(), command.intensity(), command.duration()));
+    }
+
+    public void clear() {
+        this.events.clear();
+        this.phase = this.positional = this.rotational = 0;
+        this.noise = null;
+    }
+
+    public Snapshot snapshot() {
+        return new Snapshot(this.seed, this.phase, this.positional, this.rotational, this.events);
+    }
+
+    public void restore(final Snapshot state) {
+        this.events.clear();
+        this.events.addAll(state.events());
+        this.seed = state.seed();
+        this.phase = state.phase();
+        this.positional = state.positional();
+        this.rotational = state.rotational();
+        this.noise = this.events.isEmpty() ? null : new CameraShakeNoise(this.seed);
+    }
+
+    public void advance(final double seconds) {
+        if (!Double.isFinite(seconds) || seconds < 0) {
+            throw new IllegalArgumentException("Invalid camera shake elapsed time");
+        }
+        if (this.events.isEmpty()) {
+            return;
+        }
+        float positionSum = 0;
+        float rotationSum = 0;
+        for (final Event event : this.events) {
+            if (event.type() == 0) {
+                positionSum += event.intensity();
+            } else {
+                rotationSum += event.intensity();
+            }
+        }
+        this.positional =
+                Math.max(Math.max(0, this.positional - (float) seconds), Math.min(4, positionSum));
+        this.rotational =
+                Math.max(Math.max(0, this.rotational - (float) seconds), Math.min(4, rotationSum));
+        if (this.positional > 0 || this.rotational > 0) {
+            this.phase = (float) (this.phase + seconds);
+        }
+        for (int i = this.events.size() - 1; i >= 0; i--) {
+            final Event e = this.events.get(i);
+            final float remaining = (float) (e.remaining() - seconds);
+            if (remaining <= 0) {
+                this.events.remove(i);
+            } else {
+                this.events.set(i, new Event(e.type(), e.intensity(), remaining));
+            }
+        }
+        if (this.events.isEmpty()) {
+            this.clear();
+        }
+    }
+
+    public Offset offset(final int type) {
+        if (type < 0 || type > 1) {
+            throw new IllegalArgumentException("Invalid camera shake type");
+        }
+        if (this.noise == null) {
+            return Offset.ZERO;
+        }
+        final float intensity = type == 0 ? this.positional : this.rotational;
+        final float scale = AMPLITUDE * NOISE_MULTIPLIER * intensity;
+        return new Offset(
+                this.noise.sample(0, this.phase * NOISE_MULTIPLIER, FREQUENCY) * scale,
+                this.noise.sample(1, this.phase * NOISE_MULTIPLIER, FREQUENCY) * scale,
+                this.noise.sample(2, this.phase * NOISE_MULTIPLIER, FREQUENCY) * scale);
+    }
+
+    public record Offset(float x, float y, float z) {
+        public static final Offset ZERO = new Offset(0, 0, 0);
+    }
+
+}
