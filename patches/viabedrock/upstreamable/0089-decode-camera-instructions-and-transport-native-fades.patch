+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Matches the target client's fade point insertion and overlapping fade rules. */
+public final class CameraFadeTimeline {
+
+    private final List<CameraFadeState.Point> points = new ArrayList<>();
+    private float red;
+    private float green;
+    private float blue;
+
+    public void apply(final CameraInstruction.Fade fade, final float elapsed) {
+        final CameraInstruction.Times times = fade.times() == null ? new CameraInstruction.Times(1, .5F, 1) : fade.times();
+        final CameraInstruction.Vec3 color = fade.color() == null ? new CameraInstruction.Vec3(0, 0, 0) : fade.color();
+        if (!valid(times.fadeIn()) || !valid(times.hold()) || !valid(times.fadeOut())
+                || !Float.isFinite(times.fadeIn() + times.hold() + times.fadeOut())
+                || !Float.isFinite(color.x()) || !Float.isFinite(color.y()) || !Float.isFinite(color.z()) || !valid(elapsed)) {
+            throw new IllegalArgumentException("Invalid camera fade instruction");
+        }
+        final float alpha = this.snapshot(elapsed).alpha(elapsed);
+        if (!this.points.isEmpty() && elapsed >= this.points.getLast().time()) {
+            this.points.clear();
+        }
+        if (this.points.isEmpty()) {
+            this.red = color.x();
+            this.green = color.y();
+            this.blue = color.z();
+        } else {
+            this.points.replaceAll(point -> new CameraFadeState.Point(point.time() - elapsed, point.alpha()));
+            this.points.removeIf(point -> point.time() < 0);
+            if (!this.points.isEmpty()) {
+                this.points.addFirst(new CameraFadeState.Point(0, alpha));
+            }
+        }
+        final float hold = Math.max(.5F - (times.fadeIn() + times.fadeOut()), times.hold());
+        this.insert(times.fadeIn(), 1);
+        this.insert(times.fadeIn() + hold, 1);
+        this.insert(times.fadeIn() + hold + times.fadeOut(), 0);
+    }
+
+    public CameraFadeState snapshot(final float elapsed) {
+        if (this.points.isEmpty() || elapsed >= this.points.getLast().time()) {
+            return CameraFadeState.EMPTY;
+        }
+        return new CameraFadeState(this.red, this.green, this.blue, elapsed, this.points);
+    }
+
+    private void insert(final float time, final float alpha) {
+        final CameraFadeState state = new CameraFadeState(this.red, this.green, this.blue, 0, this.points);
+        if (!this.points.isEmpty() && !(state.alpha(time) + .0001F < alpha)
+                && !(this.points.getLast().time() + .0001F < time)) {
+            return;
+        }
+        int index = 0;
+        while (index < this.points.size() && time >= this.points.get(index).time()) {
+            if (time <= this.points.get(index).time() + .0001F) {
+                this.points.set(index, new CameraFadeState.Point(this.points.get(index).time(), alpha));
+                this.prune();
+                return;
+            }
+            index++;
+        }
+        this.points.add(index, new CameraFadeState.Point(time, alpha));
+        this.prune();
+    }
+
+    private void prune() {
+        for (int i = 1; i < this.points.size() - 1; ) {
+            final float alpha = this.points.get(i).alpha();
+            if (this.points.get(i - 1).alpha() >= alpha && this.points.get(i + 1).alpha() >= alpha) {
+                this.points.remove(i);
+            } else {
+                i++;
+            }
+        }
+    }
+
+    private static boolean valid(final float value) {
+        return Float.isFinite(value) && value >= 0;
+    }
+
+}
