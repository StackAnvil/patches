index 000000000..26a5c62ba
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/CameraFadeTimelineTest.java
@@ -0,0 +1,117 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
