index 000000000..f528abdf6
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/CameraShakeState.java
@@ -0,0 +1,138 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import io.netty.buffer.ByteBuf;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/** A sequenced command and a resumable snapshot of the native shake queues. */
+public record CameraShakeState(long sequence, float elapsed, Snapshot snapshot, Command command) {
+
+    public static final String CHANNEL = "viabedrock:camera_shake";
+    public static final int MAX_EVENTS = 8192;
+    public static final Type<CameraShakeState> TYPE =
+            new Type<>(CameraShakeState.class) {
+                @Override
+                public CameraShakeState read(final ByteBuf b) {
+                    if (Types.VAR_INT.readPrimitive(b) != 1) {
+                        throw new IllegalArgumentException(
+                                "Unsupported camera shake payload version");
+                    }
+                    final long sequence = b.readLong();
+                    final float elapsed = b.readFloat();
+                    final long seed = b.readLong();
+                    final float phase = b.readFloat();
+                    final float positional = b.readFloat();
+                    final float rotational = b.readFloat();
+                    final int count = Types.VAR_INT.readPrimitive(b);
+                    if (count < 0 || count > MAX_EVENTS) {
+                        throw new IllegalArgumentException("Invalid camera shake event count");
+                    }
+                    final List<Event> events = new ArrayList<>(count);
+                    for (int i = 0; i < count; i++) {
+                        events.add(new Event(b.readUnsignedByte(), b.readFloat(), b.readFloat()));
+                    }
+                    final Command command =
+                            b.readBoolean()
+                                    ? new Command(
+                                            b.readBoolean(),
+                                            b.readUnsignedByte(),
+                                            b.readFloat(),
+                                            b.readFloat())
+                                    : null;
+                    if (b.isReadable()) {
+                        throw new IllegalArgumentException(
+                                "Unexpected camera shake payload fields");
+                    }
+                    return new CameraShakeState(
+                            sequence,
+                            elapsed,
+                            new Snapshot(seed, phase, positional, rotational, events),
+                            command);
+                }
+
+                @Override
+                public void write(final ByteBuf b, final CameraShakeState s) {
+                    Types.VAR_INT.writePrimitive(b, 1);
+                    b.writeLong(s.sequence)
+                            .writeFloat(s.elapsed)
+                            .writeLong(s.snapshot.seed)
+                            .writeFloat(s.snapshot.phase)
+                            .writeFloat(s.snapshot.positional)
+                            .writeFloat(s.snapshot.rotational);
+                    Types.VAR_INT.writePrimitive(b, s.snapshot.events.size());
+                    for (final Event e : s.snapshot.events) {
+                        b.writeByte(e.type).writeFloat(e.intensity).writeFloat(e.remaining);
+                    }
+                    b.writeBoolean(s.command != null);
+                    if (s.command != null) {
+                        b.writeBoolean(s.command.stop)
+                                .writeByte(s.command.type)
+                                .writeFloat(s.command.intensity)
+                                .writeFloat(s.command.duration);
+                    }
+                }
+            };
+
+    public CameraShakeState {
+        if (sequence < 0 || !Float.isFinite(elapsed) || elapsed < 0) {
+            throw new IllegalArgumentException("Invalid camera shake timing");
+        }
+        Objects.requireNonNull(snapshot);
+    }
+
+    private static void validate(final int type, final float intensity, final float duration) {
+        if (type < 0
+                || type > 1
+                || !Float.isFinite(intensity)
+                || intensity <= 0
+                || !Float.isFinite(duration)
+                || duration <= 0) {
+            throw new IllegalArgumentException("Invalid camera shake event");
+        }
+    }
+
+    public record Snapshot(
+            long seed, float phase, float positional, float rotational, List<Event> events) {
+        public static final Snapshot EMPTY = new Snapshot(0, 0, 0, 0, List.of());
+
+        public Snapshot {
+            events = List.copyOf(events);
+            if (!Float.isFinite(phase)
+                    || phase < 0
+                    || !Float.isFinite(positional)
+                    || positional < 0
+                    || positional > 4
+                    || !Float.isFinite(rotational)
+                    || rotational < 0
+                    || rotational > 4
+                    || events.size() > MAX_EVENTS) {
+                throw new IllegalArgumentException("Invalid camera shake snapshot");
+            }
+        }
+    }
+
+    public record Event(int type, float intensity, float remaining) {
+        public Event {
+            validate(type, intensity, remaining);
+        }
+    }
+
+    public record Command(boolean stop, int type, float intensity, float duration) {
+        public Command {
+            if (!stop) {
+                validate(type, intensity, duration);
+            }
+        }
+    }
+
+}
