--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/CameraPose.java
@@ -0,0 +1,109 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+/** World position and native quaternion, with rendering fields retained during a blend. */
+public record CameraPose(Vector position, Quaternion orientation, float fov, int renderingMode) {
+
+    public static final float PI = (float) Math.PI;
+    public static final float DEGREES = .017453292F;
+
+    public CameraPose {
+        if (position == null || orientation == null || !Float.isFinite(fov)) {
+            throw new IllegalArgumentException("Invalid camera pose");
+        }
+    }
+
+    public static CameraPose fromDegrees(
+            final Vector position,
+            final float pitch,
+            final float yaw,
+            final float fov,
+            final int renderingMode) {
+        return new CameraPose(
+                position,
+                Quaternion.fromAngles(new Vector(-pitch * DEGREES, PI - yaw * DEGREES, 0)),
+                fov,
+                renderingMode);
+    }
+
+    static float mix(final float start, final float target, final float factor) {
+        return (target - start) * factor + start;
+    }
+
+    public record Vector(float x, float y, float z) {
+
+        public static final Vector ZERO = new Vector(0, 0, 0);
+
+        public Vector {
+            if (!Float.isFinite(x) || !Float.isFinite(y) || !Float.isFinite(z)) {
+                throw new IllegalArgumentException("Invalid camera vector");
+            }
+        }
+
+        public Vector add(final Vector other) {
+            return new Vector(this.x + other.x, this.y + other.y, this.z + other.z);
+        }
+
+        public Vector subtract(final Vector other) {
+            return new Vector(this.x - other.x, this.y - other.y, this.z - other.z);
+        }
+
+        public Vector interpolate(final Vector target, final float factor) {
+            return new Vector(
+                    mix(this.x, target.x, factor),
+                    mix(this.y, target.y, factor),
+                    mix(this.z, target.z, factor));
+        }
+    }
+
+    public record Quaternion(float x, float y, float z, float w) {
+
+        public Quaternion {
+            if (!Float.isFinite(x)
+                    || !Float.isFinite(y)
+                    || !Float.isFinite(z)
+                    || !Float.isFinite(w)) {
+                throw new IllegalArgumentException("Invalid camera orientation");
+            }
+        }
+
+        public static Quaternion fromAngles(final Vector angles) {
+            final float sp = (float) Math.sin(angles.x * .5F);
+            final float cp = (float) Math.cos(angles.x * .5F);
+            final float sy = (float) Math.sin(angles.y * .5F);
+            final float cy = (float) Math.cos(angles.y * .5F);
+            final float sr = (float) Math.sin(angles.z * .5F);
+            final float cr = (float) Math.cos(angles.z * .5F);
+            return new Quaternion(
+                    sr * cp * sy + cr * sp * cy,
+                    cp * sy * cr - sp * cy * sr,
+                    sr * cp * cy - cr * sp * sy,
+                    sp * sy * sr + cp * cy * cr);
+        }
+
+        public Vector angles() {
+            final float v = Math.clamp(2 * (this.y * this.z - this.x * this.w), -1, 1);
+            if (Math.abs(Math.abs(v) - 1) < 1.1920928955078125E-6F) {
+                return new Vector(
+                        v < 0 ? PI / 2 : -PI / 2, 2 * (float) Math.atan2(this.y, this.w), 0);
+            }
+            return new Vector(
+                    -(float) Math.asin(v),
+                    (float)
+                            Math.atan2(
+                                    2 * (this.y * this.w + this.x * this.z),
+                                    ((this.z * this.z - this.x * this.x) - this.y * this.y)
+                                            + this.w * this.w),
+                    (float)
+                            Math.atan2(
+                                    2 * (this.z * this.w + this.x * this.y),
+                                    ((-this.z * this.z - this.x * this.x) + this.y * this.y)
+                                            + this.w * this.w));
+        }
+    }
+
+}
