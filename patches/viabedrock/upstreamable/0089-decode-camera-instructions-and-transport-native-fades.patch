+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.google.gson.JsonParser;
+import com.google.gson.JsonArray;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction;
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class CameraFadeTimelineTest {
+
+    private static final CameraInstruction.Vec3 RED = new CameraInstruction.Vec3(1, 0, 0);
+    private static final CameraInstruction.Vec3 BLUE = new CameraInstruction.Vec3(0, 0, 1);
+
+    @Test
+    void mergesWithoutRestartingOpacityOrChangingColor() {
+        final var fade = new CameraFadeTimeline();
+        fade.apply(new CameraInstruction.Fade(new CameraInstruction.Times(1, .5F, 1), RED), 0);
+        fade.apply(new CameraInstruction.Fade(new CameraInstruction.Times(.1F, .1F, .1F), BLUE), .5F);
+        final var state = fade.snapshot(0);
+        assertEquals(RED.x(), state.red());
+        assertEquals(RED.z(), state.blue());
+        assertEquals(List.of(new CameraFadeState.Point(0, .5F), new CameraFadeState.Point(.1F, 1),
+                new CameraFadeState.Point(1, 1), new CameraFadeState.Point(2, 0)), state.points());
+        assertEquals(.75F, state.alpha(.05F), .000001F);
+        assertEquals(1, state.alpha(.5F));
+        assertEquals(.5F, state.alpha(1.5F));
+        assertEquals(CameraFadeState.EMPTY, fade.snapshot(2));
+        fade.apply(new CameraInstruction.Fade(new CameraInstruction.Times(0, 1, 0), BLUE), 2);
+        assertEquals(1, fade.snapshot(0).blue());
+    }
+
+    @Test
+    void defaultsMinimumDurationAndExpiredSnapshotsSurviveTransport() {
+        final var fade = new CameraFadeTimeline();
+        fade.apply(new CameraInstruction.Fade(null, null), 0);
+        assertEquals(.5F, fade.snapshot(0).alpha(.5F));
+        assertEquals(1, fade.snapshot(0).alpha(1.25F));
+        assertEquals(.5F, fade.snapshot(0).alpha(2));
+        final var state = fade.snapshot(.75F);
+        final var buffer = Unpooled.buffer();
+        try {
+            CameraFadeState.TYPE.write(buffer, state);
+            assertEquals(state, CameraFadeState.TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+        fade.apply(new CameraInstruction.Fade(new CameraInstruction.Times(0, 0, 0), BLUE), 3);
+        assertEquals(1, fade.snapshot(0).alpha(.49F));
+        assertEquals(CameraFadeState.EMPTY, fade.snapshot(.5F));
+    }
+
+    @Test
+    void invalidInstructionsDoNotMutateTheActiveFade() {
+        final var fade = new CameraFadeTimeline();
+        fade.apply(new CameraInstruction.Fade(null, RED), 0);
+        final var before = fade.snapshot(0);
+        for (final float invalid : new float[]{-1, Float.NaN, Float.POSITIVE_INFINITY}) {
+            assertThrows(IllegalArgumentException.class, () -> fade.apply(new CameraInstruction.Fade(new CameraInstruction.Times(invalid, 1, 1), BLUE), .5F));
+            assertEquals(before, fade.snapshot(0));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new CameraFadeState(0, 0, 0, 0,
+                List.of(new CameraFadeState.Point(2, 1), new CameraFadeState.Point(1, 0))));
+    }
+
+    @Test
+    void targetExecutableFadeSchedulesAndSamples() throws Exception {
+        final String source = System.getenv("STACKANVIL_NATIVE_CAMERA_FADES");
+        assumeTrue(source != null);
+        final var data = JsonParser.parseString(Files.readString(Path.of(source))).getAsJsonObject();
+        for (final var value : data.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            final var fade = new CameraFadeTimeline();
+            fade.apply(new CameraInstruction.Fade(times(row.getAsJsonArray("times")), RED), 0);
+            final var state = fade.snapshot(0);
+            checkKnots(row.getAsJsonArray("knots"), state);
+            assertEquals(row.get("alpha").getAsFloat(), state.alpha(row.get("elapsed").getAsFloat()), .000001F);
+        }
+        for (final var value : data.getAsJsonArray("sequences")) {
+            final var row = value.getAsJsonObject();
+            final var fade = new CameraFadeTimeline();
+            fade.apply(new CameraInstruction.Fade(times(row.getAsJsonArray("first")), RED), 0);
+            fade.apply(new CameraInstruction.Fade(times(row.getAsJsonArray("second")), BLUE), row.get("at").getAsFloat());
+            final var state = fade.snapshot(0);
+            checkKnots(row.getAsJsonArray("knots"), state);
+            for (final var sampleValue : row.getAsJsonArray("samples")) {
+                final var sample = sampleValue.getAsJsonObject();
+                assertEquals(sample.get("alpha").getAsFloat(), state.alpha(sample.get("elapsed").getAsFloat()), .000001F);
+            }
+        }
+    }
+
+    private static CameraInstruction.Times times(final JsonArray array) {
+        return new CameraInstruction.Times(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+
+    private static void checkKnots(final JsonArray array, final CameraFadeState state) {
+        assertEquals(array.size(), state.points().size());
+        for (int i = 0; i < array.size(); i++) {
+            assertEquals(array.get(i).getAsJsonArray().get(0).getAsFloat(), state.points().get(i).time(), .000001F);
+            assertEquals(array.get(i).getAsJsonArray().get(1).getAsFloat(), state.points().get(i).alpha(), .000001F);
+        }
+    }
+
+}
