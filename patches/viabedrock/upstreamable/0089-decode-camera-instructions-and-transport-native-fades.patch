diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/CameraInstruction.java b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraInstruction.java
new file mode 100644
index 000000000..418e62231
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraInstruction.java
@@ -0,0 +1,191 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.BiConsumer;
+import java.util.function.Function;
+
+/** Protocol 2193 camera fields. Null means absent, including optional booleans. */
+public record CameraInstruction(SetCamera set, Boolean clear, Fade fade, Target target, Boolean removeTarget,
+                                FieldOfView fieldOfView, Spline spline, Long attachToEntity, Boolean detachFromEntity) {
+
+    public static final Type<CameraInstruction> TYPE = new Type<>(CameraInstruction.class) {
+        @Override
+        public CameraInstruction read(final ByteBuf buffer) {
+            return new CameraInstruction(optional(buffer, CameraInstruction::readSet), optional(buffer, ByteBuf::readBoolean),
+                    optional(buffer, CameraInstruction::readFade), optional(buffer, b -> new Target(optional(b, CameraInstruction::readVec3), b.readLongLE())),
+                    optional(buffer, ByteBuf::readBoolean), optional(buffer, b -> new FieldOfView(b.readFloatLE(), b.readFloatLE(), string(b), b.readBoolean())),
+                    optional(buffer, CameraInstruction::readSpline), optional(buffer, ByteBuf::readLongLE), optional(buffer, ByteBuf::readBoolean));
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final CameraInstruction value) {
+            optional(buffer, value.set, CameraInstruction::writeSet);
+            optional(buffer, value.clear, ByteBuf::writeBoolean);
+            optional(buffer, value.fade, CameraInstruction::writeFade);
+            optional(buffer, value.target, (b, target) -> {
+                optional(b, target.centerOffset, CameraInstruction::writeVec3);
+                b.writeLongLE(target.actorUniqueId);
+            });
+            optional(buffer, value.removeTarget, ByteBuf::writeBoolean);
+            optional(buffer, value.fieldOfView, (b, fov) -> {
+                b.writeFloatLE(fov.value).writeFloatLE(fov.easeTime);
+                BedrockTypes.STRING.write(b, fov.easeType);
+                b.writeBoolean(fov.clear);
+            });
+            optional(buffer, value.spline, CameraInstruction::writeSpline);
+            optional(buffer, value.attachToEntity, ByteBuf::writeLongLE);
+            optional(buffer, value.detachFromEntity, ByteBuf::writeBoolean);
+        }
+    };
+
+    private static SetCamera readSet(final ByteBuf b) {
+        return new SetCamera(b.readUnsignedIntLE(), optional(b, v -> new Ease(v.readUnsignedByte(), v.readFloatLE())),
+                optional(b, CameraInstruction::readVec3), optional(b, CameraInstruction::readVec2), optional(b, CameraInstruction::readVec3),
+                optional(b, CameraInstruction::readVec2), optional(b, CameraInstruction::readVec3), optional(b, ByteBuf::readBoolean), b.readBoolean());
+    }
+
+    private static void writeSet(final ByteBuf b, final SetCamera value) {
+        b.writeIntLE((int) value.preset);
+        optional(b, value.ease, (v, ease) -> v.writeByte(ease.type).writeFloatLE(ease.duration));
+        optional(b, value.position, CameraInstruction::writeVec3);
+        optional(b, value.rotation, CameraInstruction::writeVec2);
+        optional(b, value.facing, CameraInstruction::writeVec3);
+        optional(b, value.viewOffset, CameraInstruction::writeVec2);
+        optional(b, value.entityOffset, CameraInstruction::writeVec3);
+        optional(b, value.defaults, ByteBuf::writeBoolean);
+        b.writeBoolean(value.ignoreStartingValues);
+    }
+
+    private static Fade readFade(final ByteBuf b) {
+        return new Fade(optional(b, v -> new Times(v.readFloatLE(), v.readFloatLE(), v.readFloatLE())), optional(b, CameraInstruction::readVec3));
+    }
+
+    private static void writeFade(final ByteBuf b, final Fade value) {
+        optional(b, value.times, (v, time) -> v.writeFloatLE(time.fadeIn).writeFloatLE(time.hold).writeFloatLE(time.fadeOut));
+        optional(b, value.color, CameraInstruction::writeVec3);
+    }
+
+    private static Spline readSpline(final ByteBuf b) {
+        final float time = b.readFloatLE();
+        final Integer type = optional(b, v -> (int) v.readUnsignedByte());
+        final List<Vec3> curve = list(b, CameraInstruction::readVec3);
+        final List<Progress> progress = list(b, v -> new Progress(v.readFloatLE(), v.readFloatLE(), string(v)));
+        final List<Rotation> rotation = list(b, v -> new Rotation(readVec3(v), v.readFloatLE(), string(v)));
+        return new Spline(time, type, curve, progress, rotation, optional(b, CameraInstruction::string), optional(b, ByteBuf::readBoolean));
+    }
+
+    private static void writeSpline(final ByteBuf b, final Spline value) {
+        b.writeFloatLE(value.totalTime);
+        optional(b, value.type, ByteBuf::writeByte);
+        list(b, value.curve, CameraInstruction::writeVec3);
+        list(b, value.progress, (v, frame) -> {
+            v.writeFloatLE(frame.value).writeFloatLE(frame.time);
+            BedrockTypes.STRING.write(v, frame.easeType);
+        });
+        list(b, value.rotations, (v, frame) -> {
+            writeVec3(v, frame.value);
+            v.writeFloatLE(frame.time);
+            BedrockTypes.STRING.write(v, frame.easeType);
+        });
+        optional(b, value.identifier, (v, identifier) -> BedrockTypes.STRING.write(v, identifier));
+        optional(b, value.loadFromJson, ByteBuf::writeBoolean);
+    }
+
+    private static String string(final ByteBuf b) {
+        final String value = BedrockTypes.STRING.read(b);
+        if (value.length() > 1024) {
+            throw new IllegalArgumentException("Camera string exceeds 1024 characters");
+        }
+        return value;
+    }
+
+    private static Vec2 readVec2(final ByteBuf b) {
+        return new Vec2(b.readFloatLE(), b.readFloatLE());
+    }
+
+    private static Vec3 readVec3(final ByteBuf b) {
+        return new Vec3(b.readFloatLE(), b.readFloatLE(), b.readFloatLE());
+    }
+
+    private static void writeVec2(final ByteBuf b, final Vec2 v) {
+        b.writeFloatLE(v.x).writeFloatLE(v.y);
+    }
+
+    private static void writeVec3(final ByteBuf b, final Vec3 v) {
+        b.writeFloatLE(v.x).writeFloatLE(v.y).writeFloatLE(v.z);
+    }
+
+    private static <T> T optional(final ByteBuf b, final Function<ByteBuf, T> reader) {
+        return b.readBoolean() ? reader.apply(b) : null;
+    }
+
+    private static <T> void optional(final ByteBuf b, final T value, final BiConsumer<ByteBuf, T> writer) {
+        b.writeBoolean(value != null);
+        if (value != null) {
+            writer.accept(b, value);
+        }
+    }
+
+    private static <T> List<T> list(final ByteBuf b, final Function<ByteBuf, T> reader) {
+        final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(b);
+        if (count < 0 || count > 4096) {
+            throw new IllegalArgumentException("Too many camera spline entries");
+        }
+        final List<T> values = new ArrayList<>(count);
+        for (int i = 0; i < count; i++) {
+            values.add(reader.apply(b));
+        }
+        return values;
+    }
+
+    private static <T> void list(final ByteBuf b, final List<T> values, final BiConsumer<ByteBuf, T> writer) {
+        BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(b, values.size());
+        for (final T value : values) {
+            writer.accept(b, value);
+        }
+    }
+
+    public record Vec2(float x, float y) { }
+
+    public record Vec3(float x, float y, float z) { }
+
+    public record Ease(int type, float duration) { }
+
+    public record SetCamera(long preset, Ease ease, Vec3 position, Vec2 rotation, Vec3 facing,
+                            Vec2 viewOffset, Vec3 entityOffset, Boolean defaults, boolean ignoreStartingValues) { }
+
+    public record Fade(Times times, Vec3 color) { }
+
+    public record Times(float fadeIn, float hold, float fadeOut) { }
+
+    public record Target(Vec3 centerOffset, long actorUniqueId) { }
+
+    public record FieldOfView(float value, float easeTime, String easeType, boolean clear) { }
+
+    public record Progress(float value, float time, String easeType) { }
+
+    public record Rotation(Vec3 value, float time, String easeType) { }
+
+    public record Spline(float totalTime, Integer type, List<Vec3> curve, List<Progress> progress,
+                         List<Rotation> rotations, String identifier, Boolean loadFromJson) {
+        public Spline {
+            curve = List.copyOf(curve);
+            progress = List.copyOf(progress);
+            rotations = List.copyOf(rotations);
+            if (curve.size() > 4096 || progress.size() > 4096 || rotations.size() > 4096) {
+                throw new IllegalArgumentException("Too many camera spline entries");
+            }
+        }
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPositionController.java b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPositionController.java
new file mode 100644
index 000000000..6bcc3c4a7
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPositionController.java
@@ -0,0 +1,144 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraPositionState.Mode;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Preset instances retain instruction overrides independently of the active camera. */
+public final class CameraPositionController {
+
+    private final Map<Long, Overrides> overrides = new HashMap<>();
+    private CameraPositionState state = CameraPositionState.EMPTY;
+
+    public CameraPositionState state() {
+        return this.state;
+    }
+
+    public void resetPresets() {
+        this.overrides.clear();
+    }
+
+    public boolean apply(final CameraInstruction instruction, final CameraPresetRegistry registry) {
+        if (instruction.set() != null) {
+            final CameraInstruction.SetCamera set = instruction.set();
+            final CameraPresetRegistry.Resolved resolved = registry.get(set.preset());
+            if (resolved == null) {
+                throw new IllegalArgumentException(
+                        "Unresolved camera preset index " + set.preset());
+            }
+            final Mode mode =
+                switch (resolved.base()) {
+                    case FIRST_PERSON -> Mode.FIRST_PERSON;
+                    case THIRD_PERSON -> Mode.THIRD_PERSON;
+                    case THIRD_PERSON_FRONT -> Mode.THIRD_PERSON_FRONT;
+                    case FREE -> Mode.FREE;
+                    default ->
+                            throw new IllegalArgumentException(
+                                    "Unsupported camera base " + resolved.base());
+                };
+            final CameraPreset preset = resolved.preset();
+            Overrides values = this.overrides.getOrDefault(set.preset(), Overrides.EMPTY);
+            if (set.position() != null) {
+                values = new Overrides(vector(set.position()), values.rotation);
+            }
+            if (set.rotation() != null) {
+                values = new Overrides(values.position, set.rotation());
+            }
+            final CameraPose.Vector defaultPosition =
+                    new CameraPose.Vector(
+                            value(preset.posX()), value(preset.posY()), value(preset.posZ()));
+            final CameraInstruction.Vec2 defaultRotation =
+                    new CameraInstruction.Vec2(value(preset.rotX()), value(preset.rotY()));
+            if (set.facing() != null) {
+                final CameraPose.Vector from =
+                        values.position != null ? values.position : defaultPosition;
+                final CameraInstruction.Vec2 previous =
+                        values.rotation != null ? values.rotation : defaultRotation;
+                final CameraPose.Vector delta = vector(set.facing()).subtract(from);
+                final float horizontalSquared = delta.x() * delta.x() + delta.z() * delta.z();
+                final float horizontal = (float) Math.sqrt(horizontalSquared);
+                final float yaw =
+                        horizontal >= .01F
+                                ? -(float) Math.atan2(delta.x(), delta.z()) * 57.295776F
+                                : previous.y();
+                final float pitch =
+                        horizontalSquared + delta.y() * delta.y() >= .0001F
+                                ? -(float) Math.atan2(delta.y(), horizontal) * 57.295776F
+                                : previous.x();
+                values = new Overrides(values.position, new CameraInstruction.Vec2(pitch, yaw));
+            }
+            if (Boolean.TRUE.equals(set.defaults())) {
+                values = Overrides.EMPTY;
+            }
+            final CameraPose.Vector position =
+                    values.position != null ? values.position : defaultPosition;
+            final CameraInstruction.Vec2 rotation =
+                    values.rotation != null ? values.rotation : defaultRotation;
+            final float duration = set.ease() != null ? set.ease().duration() : 0;
+            final int easing = set.ease() != null ? set.ease().type() : 0;
+            if (easing < 0 || easing >= CameraEase.values().length) {
+                throw new IllegalArgumentException("Unsupported camera ease " + easing);
+            }
+            final CameraPositionState next =
+                    new CameraPositionState(
+                            this.state.sequence() + 1,
+                            0,
+                            true,
+                            mode,
+                            position,
+                            rotation.x(),
+                            rotation.y(),
+                            duration,
+                            CameraEase.values()[easing],
+                            preset.playerEffects() != null
+                                    ? preset.playerEffects()
+                                    : mode != Mode.FREE,
+                            preset.audioListener() != null
+                                    ? preset.audioListener() == 1
+                                    : mode != Mode.FREE);
+            this.overrides.put(set.preset(), values);
+            this.state = next;
+            return true;
+        }
+        if (Boolean.TRUE.equals(instruction.clear())) {
+            this.state =
+                    new CameraPositionState(
+                            this.state.sequence() + 1,
+                            0,
+                            true,
+                            Mode.LOCAL,
+                            CameraPose.Vector.ZERO,
+                            0,
+                            0,
+                            0,
+                            CameraEase.LINEAR,
+                            true,
+                            true);
+            return true;
+        }
+        return false;
+    }
+
+    private static float value(final Float value) {
+        return value == null ? 0 : value;
+    }
+
+    private static CameraPose.Vector vector(final CameraInstruction.Vec3 v) {
+        return new CameraPose.Vector(v.x(), v.y(), v.z());
+    }
+
+    private record Overrides(CameraPose.Vector position, CameraInstruction.Vec2 rotation) {
+
+        private static final Overrides EMPTY = new Overrides(null, null);
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPreset.java b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPreset.java
new file mode 100644
index 000000000..669ae9e5a
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPreset.java
@@ -0,0 +1,163 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec2;
+import net.raphimc.viabedrock.protocol.model.CameraInstruction.Vec3;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.BiConsumer;
+import java.util.function.Function;
+
+/** Protocol 2193 presets. Optional false and zero values remain distinct from absence. */
+public record CameraPreset(String name, String parent, Float posX, Float posY, Float posZ,
+                           Float rotX, Float rotY, Float rotationSpeed, Boolean snapToTarget,
+                           Vec2 horizontalRotationLimit, Vec2 verticalRotationLimit, Boolean continueTargeting,
+                           Float trackingRadius, Vec2 viewOffset, Vec3 entityOffset, Float radius,
+                           Float minYawLimit, Float maxYawLimit, Integer audioListener, Boolean playerEffects,
+                           AimAssist aimAssist, Integer controlScheme, boolean applyInheritedStartingRotation,
+                           Vec2 startingRotation) {
+
+    public static final int MAX_PRESETS = 4096;
+    public static final Type<CameraPreset> TYPE = new Type<>(CameraPreset.class) {
+        @Override
+        public CameraPreset read(final ByteBuf b) {
+            return new CameraPreset(string(b), string(b), optional(b, ByteBuf::readFloatLE),
+                    optional(b, ByteBuf::readFloatLE), optional(b, ByteBuf::readFloatLE),
+                    optional(b, ByteBuf::readFloatLE), optional(b, ByteBuf::readFloatLE),
+                    optional(b, ByteBuf::readFloatLE), optional(b, ByteBuf::readBoolean),
+                    optional(b, CameraPreset::vec2), optional(b, CameraPreset::vec2),
+                    optional(b, ByteBuf::readBoolean), optional(b, ByteBuf::readFloatLE),
+                    optional(b, CameraPreset::vec2), optional(b, CameraPreset::vec3),
+                    optional(b, ByteBuf::readFloatLE), optional(b, ByteBuf::readFloatLE),
+                    optional(b, ByteBuf::readFloatLE), optional(b, v -> (int) v.readUnsignedByte()),
+                    optional(b, ByteBuf::readBoolean), optional(b, v -> new AimAssist(
+                            optional(v, CameraPreset::string), optional(v, ByteBuf::readIntLE),
+                            optional(v, CameraPreset::vec2), optional(v, ByteBuf::readFloatLE))),
+                    optional(b, v -> (int) v.readUnsignedByte()), b.readBoolean(), optional(b, CameraPreset::vec2));
+        }
+
+        @Override
+        public void write(final ByteBuf b, final CameraPreset p) {
+            BedrockTypes.STRING.write(b, p.name);
+            BedrockTypes.STRING.write(b, p.parent);
+            optional(b, p.posX, ByteBuf::writeFloatLE);
+            optional(b, p.posY, ByteBuf::writeFloatLE);
+            optional(b, p.posZ, ByteBuf::writeFloatLE);
+            optional(b, p.rotX, ByteBuf::writeFloatLE);
+            optional(b, p.rotY, ByteBuf::writeFloatLE);
+            optional(b, p.rotationSpeed, ByteBuf::writeFloatLE);
+            optional(b, p.snapToTarget, ByteBuf::writeBoolean);
+            optional(b, p.horizontalRotationLimit, CameraPreset::vec2);
+            optional(b, p.verticalRotationLimit, CameraPreset::vec2);
+            optional(b, p.continueTargeting, ByteBuf::writeBoolean);
+            optional(b, p.trackingRadius, ByteBuf::writeFloatLE);
+            optional(b, p.viewOffset, CameraPreset::vec2);
+            optional(b, p.entityOffset, CameraPreset::vec3);
+            optional(b, p.radius, ByteBuf::writeFloatLE);
+            optional(b, p.minYawLimit, ByteBuf::writeFloatLE);
+            optional(b, p.maxYawLimit, ByteBuf::writeFloatLE);
+            optional(b, p.audioListener, ByteBuf::writeByte);
+            optional(b, p.playerEffects, ByteBuf::writeBoolean);
+            optional(b, p.aimAssist, (v, a) -> {
+                optional(v, a.preset, (out, value) -> BedrockTypes.STRING.write(out, value));
+                optional(v, a.targetMode, ByteBuf::writeIntLE);
+                optional(v, a.angle, CameraPreset::vec2);
+                optional(v, a.distance, ByteBuf::writeFloatLE);
+            });
+            optional(b, p.controlScheme, ByteBuf::writeByte);
+            b.writeBoolean(p.applyInheritedStartingRotation);
+            optional(b, p.startingRotation, CameraPreset::vec2);
+        }
+    };
+
+    public static final Type<List<CameraPreset>> LIST_TYPE = new Type<>(List.class) {
+        @Override
+        public List<CameraPreset> read(final ByteBuf b) {
+            final int count = BedrockTypes.UNSIGNED_VAR_INT.readPrimitive(b);
+            if (count < 0 || count > MAX_PRESETS) {
+                throw new IllegalArgumentException("Too many camera presets");
+            }
+            final List<CameraPreset> result = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                result.add(TYPE.read(b));
+            }
+            return List.copyOf(result);
+        }
+
+        @Override
+        public void write(final ByteBuf b, final List<CameraPreset> presets) {
+            if (presets.size() > MAX_PRESETS) {
+                throw new IllegalArgumentException("Too many camera presets");
+            }
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(b, presets.size());
+            for (final CameraPreset preset : presets) {
+                TYPE.write(b, preset);
+            }
+        }
+    };
+
+    /** Starting-rotation flags belong to the child, outside ordinary optional-field inheritance. */
+    public CameraPreset inherit(final CameraPreset p) {
+        return new CameraPreset(this.name, this.parent, first(this.posX, p.posX), first(this.posY, p.posY),
+                first(this.posZ, p.posZ), first(this.rotX, p.rotX), first(this.rotY, p.rotY),
+                first(this.rotationSpeed, p.rotationSpeed), first(this.snapToTarget, p.snapToTarget),
+                first(this.horizontalRotationLimit, p.horizontalRotationLimit),
+                first(this.verticalRotationLimit, p.verticalRotationLimit), first(this.continueTargeting, p.continueTargeting),
+                first(this.trackingRadius, p.trackingRadius), first(this.viewOffset, p.viewOffset),
+                first(this.entityOffset, p.entityOffset), first(this.radius, p.radius),
+                first(this.minYawLimit, p.minYawLimit), first(this.maxYawLimit, p.maxYawLimit),
+                first(this.audioListener, p.audioListener), first(this.playerEffects, p.playerEffects),
+                first(this.aimAssist, p.aimAssist), first(this.controlScheme, p.controlScheme),
+                this.applyInheritedStartingRotation, this.startingRotation);
+    }
+
+    private static <T> T first(final T child, final T parent) {
+        return child != null ? child : parent;
+    }
+
+    private static String string(final ByteBuf b) {
+        final String value = BedrockTypes.STRING.read(b);
+        if (value.length() > 1024) {
+            throw new IllegalArgumentException("Camera preset string exceeds 1024 characters");
+        }
+        return value;
+    }
+
+    private static Vec2 vec2(final ByteBuf b) {
+        return new Vec2(b.readFloatLE(), b.readFloatLE());
+    }
+
+    private static Vec3 vec3(final ByteBuf b) {
+        return new Vec3(b.readFloatLE(), b.readFloatLE(), b.readFloatLE());
+    }
+
+    private static void vec2(final ByteBuf b, final Vec2 v) {
+        b.writeFloatLE(v.x()).writeFloatLE(v.y());
+    }
+
+    private static void vec3(final ByteBuf b, final Vec3 v) {
+        b.writeFloatLE(v.x()).writeFloatLE(v.y()).writeFloatLE(v.z());
+    }
+
+    private static <T> T optional(final ByteBuf b, final Function<ByteBuf, T> read) {
+        return b.readBoolean() ? read.apply(b) : null;
+    }
+
+    private static <T> void optional(final ByteBuf b, final T value, final BiConsumer<ByteBuf, T> write) {
+        b.writeBoolean(value != null);
+        if (value != null) {
+            write.accept(b, value);
+        }
+    }
+
+    public record AimAssist(String preset, Integer targetMode, Vec2 angle, Float distance) { }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPresetRegistry.java b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPresetRegistry.java
new file mode 100644
index 000000000..3b777b88b
--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/protocol/model/CameraPresetRegistry.java
@@ -0,0 +1,108 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.protocol.model;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Resolves received names without changing their instruction indexes or inventing missing parents. */
+public final class CameraPresetRegistry {
+
+    public static final CameraPresetRegistry EMPTY = new CameraPresetRegistry(List.of());
+    private final List<CameraPreset> presets;
+    private final Resolved[] resolved;
+    private final List<String> unresolved;
+
+    public CameraPresetRegistry(final List<CameraPreset> presets) {
+        if (presets.size() > CameraPreset.MAX_PRESETS) {
+            throw new IllegalArgumentException("Too many camera presets");
+        }
+        this.presets = List.copyOf(presets);
+        this.resolved = new Resolved[presets.size()];
+        final Map<String, Integer> indexes = new HashMap<>();
+        final List<List<Integer>> children = new ArrayList<>(presets.size());
+        for (int i = 0; i < presets.size(); i++) {
+            if (indexes.putIfAbsent(presets.get(i).name(), i) != null) {
+                throw new IllegalArgumentException("Duplicate camera preset: " + presets.get(i).name());
+            }
+            children.add(new ArrayList<>());
+        }
+        final ArrayDeque<Integer> ready = new ArrayDeque<>();
+        for (int i = 0; i < presets.size(); i++) {
+            final CameraPreset preset = presets.get(i);
+            if (preset.parent().isEmpty()) {
+                final Base base = Base.fromName(preset.name());
+                if (base != null) {
+                    this.resolved[i] = new Resolved(base, preset);
+                    ready.addLast(i);
+                }
+            } else {
+                final Integer parent = indexes.get(preset.parent());
+                if (parent != null) {
+                    children.get(parent).add(i);
+                }
+            }
+        }
+        while (!ready.isEmpty()) {
+            final int parent = ready.removeFirst();
+            for (final int child : children.get(parent)) {
+                this.resolved[child] = new Resolved(this.resolved[parent].base,
+                        presets.get(child).inherit(this.resolved[parent].preset));
+                ready.addLast(child);
+            }
+        }
+        final List<String> unresolved = new ArrayList<>();
+        for (int i = 0; i < presets.size(); i++) {
+            if (this.resolved[i] == null) {
+                unresolved.add(presets.get(i).name());
+            }
+        }
+        this.unresolved = List.copyOf(unresolved);
+    }
+
+    public List<CameraPreset> presets() {
+        return this.presets;
+    }
+
+    public List<String> unresolved() {
+        return this.unresolved;
+    }
+
+    public Resolved get(final long instructionIndex) {
+        return instructionIndex >= 0 && instructionIndex < this.resolved.length
+                ? this.resolved[(int) instructionIndex] : null;
+    }
+
+    public record Resolved(Base base, CameraPreset preset) { }
+
+    public enum Base {
+        FIRST_PERSON("minecraft:first_person"),
+        THIRD_PERSON("minecraft:third_person"),
+        THIRD_PERSON_FRONT("minecraft:third_person_front"),
+        FREE("minecraft:free"),
+        FOLLOW_ORBIT("minecraft:follow_orbit"),
+        FIXED_BOOM("minecraft:fixed_boom");
+
+        private final String name;
+
+        Base(final String name) {
+            this.name = name;
+        }
+
+        private static Base fromName(final String name) {
+            for (final Base base : values()) {
+                if (base.name.equals(name)) {
+                    return base;
+                }
+            }
+            return null;
+        }
+    }
+
+}
