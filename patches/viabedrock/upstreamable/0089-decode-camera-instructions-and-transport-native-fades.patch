@@ -0,0 +1,67 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.api.model.CameraFovState.Command;
+import net.raphimc.viabedrock.api.model.CameraFovState.Transition;
+import net.raphimc.viabedrock.api.model.CameraFovState.Value;
+
+/** Shared native command and frame update rules. Projection inputs belong to the client. */
+public final class CameraFovTimeline {
+
+    private Transition state = Transition.EMPTY;
+
+    public Transition state() {
+        return this.state;
+    }
+
+    public void restore(final Transition state) {
+        this.state = state;
+    }
+
+    public void apply(final Command command, final Value rendered, final Value normal) {
+        if (command.clear() && command.duration() <= 0) {
+            this.state = Transition.EMPTY;
+            return;
+        }
+        final Value target = command.clear() ? normal : Value.constant(command.value() * CameraFovState.DEGREES_TO_RADIANS);
+        if (command.duration() > 0) {
+            // Set does not reset an existing clear flag in the native transition component.
+            this.state = new Transition(true, true, command.clear() || this.state.clear(), rendered, target,
+                    rendered, 0, command.duration(), command.ease());
+        } else {
+            // An immediate set replaces the target while retaining an existing transition.
+            this.state = new Transition(true, this.state.easing(), this.state.clear(), this.state.start(), target,
+                    this.state.current(), this.state.progress(), this.state.duration(), this.state.ease());
+        }
+    }
+
+    /** Returns the projection for this frame, including the final removal frame of an eased clear. */
+    public Value advance(final float deltaSeconds) {
+        if (!Float.isFinite(deltaSeconds) || deltaSeconds < 0) {
+            throw new IllegalArgumentException("Invalid camera FOV frame delta");
+        }
+        if (!this.state.active()) {
+            return null;
+        }
+        final Transition old = this.state;
+        if (old.easing() && old.duration() > Math.ulp(1F)) {
+            final float progress = Math.min(1, old.progress() + deltaSeconds / old.duration());
+            final Value current = old.start().interpolate(old.target(), old.ease().factor(progress));
+            this.state = new Transition(true, true, old.clear(), old.start(), old.target(), current,
+                    progress, progress == 1 ? 0 : old.duration(), old.ease());
+            return current;
+        }
+        if (old.clear()) {
+            this.state = Transition.EMPTY;
+        } else {
+            this.state = new Transition(true, old.easing(), false, old.start(), old.target(), old.target(),
+                    old.progress(), old.duration(), old.ease());
+        }
+        return old.target();
+    }
+
+}
