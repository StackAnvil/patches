+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.protocol.model.GameRule;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class GameRuleMappingsTest {
+
+    @Test
+    void mapsOnlyEditableRulesWithCompatibleJavaTypes() {
+        final List<GameRule> rules = List.of(
+                new GameRule("doDayLightCycle", true, false),
+                new GameRule("randomTickSpeed", true, 4),
+                new GameRule("keepInventory", false, true),
+                new GameRule("customRule", true, true));
+
+        assertEquals(Map.of("minecraft:advance_time", "false", "minecraft:random_tick_speed", "4"),
+                GameRuleMappings.toJavaValues(rules));
+    }
+
+    @Test
+    void acceptsOnlyKnownEditableRuleChangesWithValidValues() {
+        final GameRule rule = new GameRule("doDayLightCycle", true, true);
+        final Map<String, GameRule> rules = Map.of("dodaylightcycle", rule);
+
+        assertEquals("/gamerule doDayLightCycle false",
+                GameRuleMappings.command(rules, "minecraft:advance_time", "false"));
+        assertNull(GameRuleMappings.command(rules, "minecraft:advance_time", "false; stop"));
+        assertNull(GameRuleMappings.command(rules, "minecraft:keep_inventory", "false"));
+        assertNull(GameRuleMappings.command(Map.of("dodaylightcycle", new GameRule("doDayLightCycle", false, true)),
+                "minecraft:advance_time", "false"));
+    }
+
+}
