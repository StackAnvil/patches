+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class PlayPacketsTest {
+
+    @Test
+    void writesTheWorldOptionsResponseExpectedByJava263() throws Exception {
+        final PacketWrapper wrapper = new PacketWrapperImpl(ClientboundPackets26_3.GAME_RULE_VALUES, null, null);
+        PlayPackets.writeJavaGameRuleValues(wrapper, Map.of("minecraft:advance_time", "false"));
+
+        final ByteBuf buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.GAME_RULE_VALUES.getId(), Types.VAR_INT.read(buffer));
+            assertEquals(1, Types.VAR_INT.read(buffer));
+            assertEquals("minecraft:advance_time", Types.STRING.read(buffer));
+            assertEquals("false", Types.STRING.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
