+package net.raphimc.viabedrock.protocol.storage;
+
+import net.raphimc.viabedrock.protocol.model.GameRule;
+
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+final class GameRuleMappings {
+
+    private static final Map<String, String> BEDROCK_TO_JAVA = Map.ofEntries(
+            Map.entry("commandblockoutput", "command_block_output"),
+            Map.entry("commandblocksenabled", "command_blocks_work"),
+            Map.entry("dodaylightcycle", "advance_time"),
+            Map.entry("doweathercycle", "advance_weather"),
+            Map.entry("dotiledrops", "block_drops"),
+            Map.entry("doentitydrops", "entity_drops"),
+            Map.entry("domobloot", "mob_drops"),
+            Map.entry("domobspawning", "spawn_mobs"),
+            Map.entry("drowningdamage", "drowning_damage"),
+            Map.entry("falldamage", "fall_damage"),
+            Map.entry("firedamage", "fire_damage"),
+            Map.entry("freezedamage", "freeze_damage"),
+            Map.entry("doimmediaterespawn", "immediate_respawn"),
+            Map.entry("keepinventory", "keep_inventory"),
+            Map.entry("dolimitedcrafting", "limited_crafting"),
+            Map.entry("locatorbar", "locator_bar"),
+            Map.entry("mobgriefing", "mob_griefing"),
+            Map.entry("naturalregeneration", "natural_health_regeneration"),
+            Map.entry("playerssleepingpercentage", "players_sleeping_percentage"),
+            Map.entry("projectilescanbreakblocks", "projectiles_can_break_blocks"),
+            Map.entry("pvp", "pvp"),
+            Map.entry("randomtickspeed", "random_tick_speed"),
+            Map.entry("sendcommandfeedback", "send_command_feedback"),
+            Map.entry("showdeathmessages", "show_death_messages"),
+            Map.entry("spawnradius", "respawn_radius"),
+            Map.entry("tntexplodes", "tnt_explodes"),
+            Map.entry("tntexplosiondropdecay", "tnt_explosion_drop_decay")
+    );
+
+    private static final Map<String, String> JAVA_TO_BEDROCK = BEDROCK_TO_JAVA.entrySet().stream()
+            .collect(java.util.stream.Collectors.toUnmodifiableMap(entry -> "minecraft:" + entry.getValue(), Map.Entry::getKey));
+
+    static Map<String, String> toJavaValues(final Collection<GameRule> gameRules) {
+        final Map<String, String> values = new HashMap<>();
+        for (GameRule rule : gameRules) {
+            final String javaName = BEDROCK_TO_JAVA.get(rule.name().toLowerCase(Locale.ROOT));
+            if (javaName != null && rule.editable() && (rule.value() instanceof Boolean || rule.value() instanceof Integer)) {
+                values.put("minecraft:" + javaName, rule.value().toString());
+            }
+        }
+        return values;
+    }
+
+    static String command(final Map<String, GameRule> gameRules, final String javaName, final String value) {
+        final String bedrockName = JAVA_TO_BEDROCK.get(javaName);
+        final GameRule rule = gameRules.get(bedrockName);
+        if (rule == null || !rule.editable() || !validValue(rule.value(), value)) {
+            return null;
+        }
+        return "/gamerule " + rule.name() + " " + value;
+    }
+
+    private static boolean validValue(final Object currentValue, final String value) {
+        if (currentValue instanceof Boolean) {
+            return "true".equals(value) || "false".equals(value);
+        }
+        if (currentValue instanceof Integer) {
+            try {
+                Integer.parseInt(value);
+                return true;
+            } catch (final NumberFormatException ignored) {
+                return false;
+            }
+        }
+        return false;
+    }
+
+    private GameRuleMappings() {
+    }
+
+}
