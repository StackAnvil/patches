@@ -78,4 +80,12 @@ public class GameRulesStorage extends StoredObject {
         return (T) this.gameRules.get(name.toLowerCase(Locale.ROOT));
     }
 
+    public Map<String, String> getJavaGameRuleValues() {
+        return GameRuleMappings.toJavaValues(this.receivedGameRules.values());
+    }
+
+    public String toBedrockGameRuleCommand(final String javaName, final String value) {
+        return GameRuleMappings.command(this.receivedGameRules, javaName, value);
+    }
+
 }
