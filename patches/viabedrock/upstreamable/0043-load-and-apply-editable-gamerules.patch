@@ -88,6 +116,21 @@ public final class PlayPackets {
         });
     }
 
+    static void sendJavaGameRuleValues(final UserConnection user) {
+        final Map<String, String> values = user.get(GameRulesStorage.class).getJavaGameRuleValues();
+        final PacketWrapper response = PacketWrapper.create(ClientboundPackets26_3.GAME_RULE_VALUES, user);
+        writeJavaGameRuleValues(response, values);
+        response.send(BedrockProtocol.class);
+    }
+
+    static void writeJavaGameRuleValues(final PacketWrapper response, final Map<String, String> values) {
+        response.write(Types.VAR_INT, values.size());
+        for (Map.Entry<String, String> entry : values.entrySet()) {
+            response.write(Types.STRING, entry.getKey());
+            response.write(Types.STRING, entry.getValue());
+        }
+    }
+
     private PlayPackets() {
     }
 
