             wrapper.user().get(GameRulesStorage.class).updateGameRules(wrapper.read(BedrockTypes.GAME_RULE_ARRAY)); // game rules
         });
 
+        protocol.registerServerbound(ServerboundPackets26_3.SET_GAME_RULE, null, wrapper -> {
+            wrapper.cancel();
+            final GameRulesStorage gameRules = wrapper.user().get(GameRulesStorage.class);
+            final int count = wrapper.read(Types.VAR_INT);
+            for (int i = 0; i < count; i++) {
+                final String javaName = wrapper.read(Types.STRING);
+                final String value = wrapper.read(Types.STRING);
+                final String command = gameRules.toBedrockGameRuleCommand(javaName, value);
+                if (command == null) {
+                    continue;
+                }
+
+                final PacketWrapper request = PacketWrapper.create(ServerboundBedrockPackets.COMMAND_REQUEST, wrapper.user());
+                request.write(BedrockTypes.STRING, command);
+                request.write(BedrockTypes.COMMAND_ORIGIN_DATA, new CommandOriginData(CommandOriginType.Player, UUID.randomUUID(), ""));
+                request.write(Types.BOOLEAN, false);
+                request.write(BedrockTypes.STRING, ProtocolConstants.BEDROCK_COMMAND_VERSION);
+                request.sendToServer(BedrockProtocol.class);
+            }
+        });
+
         protocol.registerServerbound(ServerboundPackets26_3.CLIENT_INFORMATION, ServerboundBedrockPackets.REQUEST_CHUNK_RADIUS, MultiStatePackets.CLIENT_SETTINGS_HANDLER);
