From 78d577fba9c4a0a8259c5a99e23bd0d6fe0d7bf1 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Tue, 3 Nov 2026 13:39:28 +0100
Subject: [PATCH] build(deps): update CubeConverter to ordered material API

Update CubeConverter from 7cf736c4a5 to 8a7b73a8ed, including the merged ordered material assignments API. Retain the optional geometry, actor rendering controls and face UV rotation fixes from the earlier commits. Keep the dependency non-transitive.

The material-map accessor and map constructors were removed upstream. Current ViaBedrock source does not call those APIs; compile the standalone upstream project against the new artifact to verify its existing consumers.
---
 build.gradle | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 88cd2e04..6f57cc23 100644
--- a/build.gradle
+++ b/build.gradle
@@ -107,7 +107,7 @@ dependencies {
     api "com.vdurmont:semver4j:3.1.0"
     api "com.mojang:brigadier:1.3.10"
     api "at.yawk.lz4:lz4-java:1.12.1"
-    api("com.github.oryxel1:CubeConverter:7cf736c4a5") {
+    api("com.github.oryxel1:CubeConverter:8a7b73a8ed") {
         transitive = false
     }
     api("team.unnamed:mocha:3.0.1") {
