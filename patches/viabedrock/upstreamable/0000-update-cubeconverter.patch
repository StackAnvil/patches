Subject: [PATCH] build(deps): update CubeConverter

Update CubeConverter from 7cf736c4a5 to ee11a32b2e. The upstream commits preserve optional geometry declarations, actor rendering controls and authored face UV rotations. Keep the dependency non-transitive.
---
 build.gradle | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 88cd2e04..abeb3684 100644
--- a/build.gradle
+++ b/build.gradle
@@ -107,7 +107,7 @@ dependencies {
     api "com.vdurmont:semver4j:3.1.0"
     api "com.mojang:brigadier:1.3.10"
     api "at.yawk.lz4:lz4-java:1.12.1"
-    api("com.github.oryxel1:CubeConverter:7cf736c4a5") {
+    api("com.github.oryxel1:CubeConverter:ee11a32b2e") {
         transitive = false
     }
     api("team.unnamed:mocha:3.0.1") {
