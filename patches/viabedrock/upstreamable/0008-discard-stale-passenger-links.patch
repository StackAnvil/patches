+    public void applyEntityLink(final EntityLink link) {
+        final LinkKey key = new LinkKey(link.fromEntityUniqueId(), link.toEntityUniqueId());
+        this.pendingEntityLinks.remove(key);
+        if (link.type() == ActorLinkType.None) {
+            final Entity vehicle = this.getEntityByUid(link.fromEntityUniqueId());
+            if (vehicle != null && vehicle.passengers().contains(link.toEntityUniqueId())) {
+                vehicle.removePassenger(link.toEntityUniqueId());
+                this.passengerUpdates.add(vehicle.uniqueId());
+            }
+            if (vehicle != null && this.clientPlayerEntity != null
+                    && link.toEntityUniqueId() == this.clientPlayerEntity.uniqueId()) {
+                this.clientPlayerEntity.dismountVehicle(vehicle);
+                this.clientPlayerEntity.scheduleDismountPositionCorrection();
+            }
+            return;
+        }
+
+        final Entity vehicle = this.getEntityByUid(link.fromEntityUniqueId());
+        final Entity passenger = this.getEntityByUid(link.toEntityUniqueId());
+        if (vehicle == null || passenger == null) {
+            this.pendingEntityLinks.put(key, link);
+            return;
+        }
+        this.applyResolvedEntityLink(vehicle, passenger, link.type());
+    }
+
+    public List<Entity> drainPassengerUpdates() {
+        final List<Entity> vehicles = new ArrayList<>();
+        for (long uniqueId : this.passengerUpdates) {
+            final Entity vehicle = this.getEntityByUid(uniqueId);
+            if (vehicle != null) {
+                vehicles.add(vehicle);
+            }
+        }
+        this.passengerUpdates.clear();
+        return vehicles;
+    }
+
+    private void resolvePendingEntityLinks() {
+        final Iterator<EntityLink> links = this.pendingEntityLinks.values().iterator();
+        while (links.hasNext()) {
+            final EntityLink link = links.next();
+            final Entity vehicle = this.getEntityByUid(link.fromEntityUniqueId());
+            final Entity passenger = this.getEntityByUid(link.toEntityUniqueId());
+            if (vehicle != null && passenger != null) {
+                links.remove();
+                this.applyResolvedEntityLink(vehicle, passenger, link.type());
+            }
+        }
+    }
+
+    private void applyResolvedEntityLink(final Entity vehicle, final Entity passenger,
+                                         final ActorLinkType type) {
+        final List<Long> previousPassengers = List.copyOf(vehicle.passengers());
+        if (type == ActorLinkType.Riding) {
+            vehicle.addPrimaryPassenger(passenger.uniqueId());
+        } else {
+            vehicle.addPassenger(passenger.uniqueId());
+        }
+        if (!vehicle.passengers().equals(previousPassengers)) {
+            this.passengerUpdates.add(vehicle.uniqueId());
+        }
+        if (passenger == this.clientPlayerEntity) {
+            this.clientPlayerEntity.setMountEntityRuntimeId(vehicle.runtimeId());
+        }
+    }
+
+    public List<Entity> getTrackedPassengers(final Entity vehicle) {
+        final List<Entity> passengers = new ArrayList<>();
+        for (long passengerUid : List.copyOf(vehicle.passengers())) {
+            final Entity passenger = this.getEntityByUid(passengerUid);
+            if (passenger == null) {
+                vehicle.removePassenger(passengerUid);
+            } else {
+                passengers.add(passenger);
+            }
+        }
+        return passengers;
+    }
+
