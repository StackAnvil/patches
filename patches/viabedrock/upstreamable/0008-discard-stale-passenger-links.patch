+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import net.raphimc.viabedrock.api.model.entity.ClientPlayerEntity;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.model.PlayerAbilities;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class EntityTrackerTest {
+
+    @Test
+    void removesDespawnedPassengersFromVehicles() {
+        final UserConnection user = user();
+        final EntityTracker tracker = new EntityTracker(user);
+        final Entity vehicle = tracker.addEntity(10, 100, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        final Entity removed = tracker.addEntity(11, 101, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        final Entity remaining = tracker.addEntity(12, 102, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        vehicle.addPassenger(removed.uniqueId());
+        vehicle.addPassenger(remaining.uniqueId());
+
+        tracker.removeEntity(removed);
+
+        assertEquals(List.of(remaining.uniqueId()), vehicle.passengers());
+        assertEquals(List.of(remaining), tracker.getTrackedPassengers(vehicle));
+    }
+
+    @Test
+    void prunesUnknownPassengersBeforeEncodingPassengers() {
+        final EntityTracker tracker = new EntityTracker(user());
+        final Entity vehicle = tracker.addEntity(10, 100, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        final Entity passenger = tracker.addEntity(11, 101, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        vehicle.addPassenger(99);
+        vehicle.addPassenger(passenger.uniqueId());
+
+        assertEquals(List.of(passenger), tracker.getTrackedPassengers(vehicle));
+        assertEquals(List.of(passenger.uniqueId()), vehicle.passengers());
+    }
+
+    @Test
+    void removingVehicleClearsLocalMountState() {
+        final UserConnection user = user();
+        final EntityTracker tracker = new EntityTracker(user);
+        final ClientPlayerEntity player = new ClientPlayerEntity(user, 1, UUID.randomUUID(), new PlayerAbilities(1, (byte) 0, (byte) 0));
+        tracker.addEntity(player, false);
+        final Entity vehicle = tracker.addEntity(10, 100, EntityTypes26_3.PIG.identifier(), EntityTypes26_3.PIG);
+        player.setMountEntityRuntimeId(vehicle.runtimeId());
+        vehicle.addPassenger(player.uniqueId());
+
+        tracker.removeEntity(vehicle);
+
+        assertEquals(-1, player.mountEntityRuntimeId());
+        assertSame(player, tracker.getEntityByUid(player.uniqueId()));
+    }
+
+    private static UserConnection user() {
+        return (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (proxy, method, args) -> null);
+    }
+
+}
