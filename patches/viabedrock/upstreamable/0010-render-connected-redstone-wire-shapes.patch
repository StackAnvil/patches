+    public void sendNearbyRedstoneUpdates(final Collection<BlockPosition> changedPositions) {
+        final Set<BlockPosition> candidates = new HashSet<>();
+        for (BlockPosition changed : changedPositions) {
+            for (int y = -1; y <= 1; y++) {
+                for (int z = -1; z <= 1; z++) {
+                    for (int x = -1; x <= 1; x++) {
+                        if (Math.abs(x) + Math.abs(z) > 1) {
+                            continue;
+                        }
+                        candidates.add(new BlockPosition(changed.x() + x, changed.y() + y, changed.z() + z));
+                    }
+                }
+            }
+        }
+        candidates.removeAll(changedPositions);
+        candidates.forEach(this::sendRedstoneUpdate);
+    }
+
+    private void refreshNeighboringRedstoneBorders(final int chunkX, final int chunkZ) {
+        final boolean westLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX - 1, chunkZ));
+        final boolean eastLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX + 1, chunkZ));
+        final boolean northLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX, chunkZ - 1));
+        final boolean southLoaded = this.chunkLight.containsKey(ChunkPosition.chunkKey(chunkX, chunkZ + 1));
+        if (!westLoaded && !eastLoaded && !northLoaded && !southLoaded) {
+            return;
+        }
+        for (int offset = 0; offset < 16; offset++) {
+            for (int y = this.minY; y < this.minY + this.worldHeight; y++) {
+                if (westLoaded) {
+                    this.sendRedstoneUpdate(new BlockPosition((chunkX << 4) - 1, y, (chunkZ << 4) + offset));
+                }
+                if (eastLoaded) {
+                    this.sendRedstoneUpdate(new BlockPosition((chunkX << 4) + 16, y, (chunkZ << 4) + offset));
+                }
+                if (northLoaded) {
+                    this.sendRedstoneUpdate(new BlockPosition((chunkX << 4) + offset, y, (chunkZ << 4) - 1));
+                }
+                if (southLoaded) {
+                    this.sendRedstoneUpdate(new BlockPosition((chunkX << 4) + offset, y, (chunkZ << 4) + 16));
+                }
+            }
+        }
+    }
+
+    private void sendRedstoneUpdate(final BlockPosition position) {
+        if (!this.chunkLight.containsKey(ChunkPosition.chunkKey(position.x() >> 4, position.z() >> 4))
+                || !RedstoneWireConnections.isWire(this.getUnconnectedJavaBlockStateModel(position))) {
+            return;
+        }
+        final PacketWrapper update = PacketWrapper.create(ClientboundPackets26_3.BLOCK_UPDATE, this.user());
+        update.write(Types.BLOCK_POSITION1_14, position);
+        update.write(Types.VAR_INT, this.getJavaBlockState(position));
+        update.send(BedrockProtocol.class);
     }
 
