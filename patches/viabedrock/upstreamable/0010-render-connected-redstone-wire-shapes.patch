+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.BlockState;
+
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+final class RedstoneWireConnections {
+
+    private RedstoneWireConnections() {
+    }
+
+    static boolean isWire(final BlockState state) {
+        return state != null && state.namespacedIdentifier().equals("minecraft:redstone_wire");
+    }
+
+    static BlockState shape(final BlockPosition position, final BlockState wire,
+                            final Function<BlockPosition, BlockState> blockAt,
+                            final Predicate<BlockState> conductor) {
+        if (!isWire(wire)) {
+            return wire;
+        }
+
+        final Connections connections = connections(position, blockAt, conductor);
+        return wire.withProperties(Map.of("north", connections.north().property(),
+                "east", connections.east().property(), "south", connections.south().property(),
+                "west", connections.west().property()));
+    }
+
+    static Connections connections(final BlockPosition position, final Function<BlockPosition, BlockState> blockAt,
+                                   final Predicate<BlockState> conductor) {
+        Connection north = connection(position, 0, -1, "north", blockAt, conductor);
+        Connection east = connection(position, 1, 0, "east", blockAt, conductor);
+        Connection south = connection(position, 0, 1, "south", blockAt, conductor);
+        Connection west = connection(position, -1, 0, "west", blockAt, conductor);
+
+        // Java extends a lone connection into a straight line and renders an isolated wire as a cross.
+        if (north == Connection.NONE && south == Connection.NONE) {
+            if (east == Connection.NONE && west == Connection.NONE) {
+                north = Connection.SIDE;
+                south = Connection.SIDE;
+            }
+            if (east == Connection.NONE) {
+                east = Connection.SIDE;
+            }
+            if (west == Connection.NONE) {
+                west = Connection.SIDE;
+            }
+        } else if (east == Connection.NONE && west == Connection.NONE) {
+            if (north == Connection.NONE) {
+                north = Connection.SIDE;
+            }
+            if (south == Connection.NONE) {
+                south = Connection.SIDE;
+            }
+        }
+
+        return new Connections(north, east, south, west);
+    }
+
+    private static Connection connection(final BlockPosition position, final int x, final int z, final String direction,
+                                     final Function<BlockPosition, BlockState> blockAt,
+                                     final Predicate<BlockState> conductor) {
+        final BlockPosition adjacentPosition = new BlockPosition(position.x() + x, position.y(), position.z() + z);
+        final BlockState adjacent = blockAt.apply(adjacentPosition);
+        if (!conductor.test(blockAt.apply(new BlockPosition(position.x(), position.y() + 1, position.z())))
+                && conductor.test(adjacent)
+                && isWire(blockAt.apply(new BlockPosition(adjacentPosition.x(), adjacentPosition.y() + 1, adjacentPosition.z())))) {
+            return Connection.UP;
+        }
+        if (connectsTo(adjacent, direction)) {
+            return Connection.SIDE;
+        }
+        if (!conductor.test(adjacent)
+                && isWire(blockAt.apply(new BlockPosition(adjacentPosition.x(), adjacentPosition.y() - 1, adjacentPosition.z())))) {
+            return Connection.SIDE;
+        }
+        return Connection.NONE;
+    }
+
+    private static boolean connectsTo(final BlockState state, final String direction) {
+        if (state == null) {
+            return false;
+        }
+        final String identifier = state.identifier();
+        if (identifier.equals("redstone_wire")) {
+            return true;
+        }
+        if (identifier.equals("repeater") || identifier.equals("comparator")) {
+            final String facing = state.properties().get("facing");
+            return direction.equals("north") || direction.equals("south")
+                    ? "north".equals(facing) || "south".equals(facing)
+                    : "east".equals(facing) || "west".equals(facing);
+        }
+        if (identifier.equals("observer")) {
+            return direction.equals(state.properties().get("facing"));
+        }
+        return switch (identifier) {
+            case "redstone_block", "redstone_torch", "redstone_wall_torch", "lever", "daylight_detector",
+                 "target", "tripwire_hook", "trapped_chest", "lectern", "sculk_sensor", "calibrated_sculk_sensor",
+                 "lightning_rod", "detector_rail", "pressure_plate", "button" -> true;
+            default -> identifier.endsWith("_button") || identifier.endsWith("_pressure_plate");
+        };
+    }
+
+    record Connections(Connection north, Connection east, Connection south, Connection west) {
+    }
+
+    enum Connection {
+        NONE("none"), SIDE("side"), UP("up");
+
+        private final String property;
+
+        Connection(final String property) {
+            this.property = property;
+        }
+
+        String property() {
+            return this.property;
+        }
+    }
+
+}
