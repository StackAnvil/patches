--- /dev/null
+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeItemStackData.java
@@ -0,0 +1,92 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.LongTag;
+import com.viaversion.nbt.tag.ShortTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+
+import java.util.Arrays;
+import java.util.List;
+
+/** Immutable decoded Bedrock stack data before Java conversion. Count stays in the Java stack. */
+public record NativeItemStackData(int itemId, short auxiliaryValue, int blockRuntimeId, long blockingTicks,
+                                  List<String> canPlace, List<String> canBreak, CompoundTag userData) {
+
+    public NativeItemStackData {
+        canPlace = List.copyOf(canPlace);
+        canBreak = List.copyOf(canBreak);
+        userData = userData == null ? null : userData.copy();
+    }
+
+    @Override
+    public CompoundTag userData() {
+        return this.userData == null ? null : this.userData.copy();
+    }
+
+    public static NativeItemStackData fromItem(final BedrockItem item) {
+        return new NativeItemStackData(item.identifier(), item.data(), item.blockRuntimeId(), item.blockingTicks(),
+                Arrays.asList(item.canPlace()), Arrays.asList(item.canBreak()), item.tag());
+    }
+
+    public CompoundTag toTag() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("version", 1);
+        tag.putInt("item_id", this.itemId);
+        tag.putShort("auxiliary_value", this.auxiliaryValue);
+        tag.putInt("block_runtime_id", this.blockRuntimeId);
+        tag.putLong("blocking_ticks", this.blockingTicks);
+        tag.put("can_place", strings(this.canPlace));
+        tag.put("can_break", strings(this.canBreak));
+        if (this.userData != null) {
+            tag.put("user_data", this.userData.copy());
+        }
+        return tag;
+    }
+
+    /** Unknown versions and malformed snapshots have no native comparison context. */
+    public static NativeItemStackData fromTag(final CompoundTag tag) {
+        if (tag == null || !(tag.get("version") instanceof IntTag version) || version.asInt() != 1
+                || !(tag.get("item_id") instanceof IntTag itemId)
+                || !(tag.get("auxiliary_value") instanceof ShortTag auxiliary)
+                || !(tag.get("block_runtime_id") instanceof IntTag blockRuntime)
+                || !(tag.get("blocking_ticks") instanceof LongTag blockingTicks)
+                || tag.contains("user_data") && !(tag.get("user_data") instanceof CompoundTag)) {
+            return null;
+        }
+        final var canPlace = readStrings(tag.get("can_place"));
+        final var canBreak = readStrings(tag.get("can_break"));
+        if (canPlace == null || canBreak == null) {
+            return null;
+        }
+        return new NativeItemStackData(itemId.asInt(), auxiliary.asShort(), blockRuntime.asInt(), blockingTicks.asLong(),
+                canPlace, canBreak, tag.getCompoundTag("user_data"));
+    }
+
+    private static ListTag<StringTag> strings(final List<String> values) {
+        final var tag = new ListTag<>(StringTag.class);
+        for (final String value : values) {
+            tag.add(new StringTag(value));
+        }
+        return tag;
+    }
+
+    private static List<String> readStrings(final Tag tag) {
+        if (!(tag instanceof ListTag<?> list)) {
+            return null;
+        }
+        if (!list.isEmpty() && list.getElementType() != StringTag.class) {
+            return null;
+        }
+        return list.getValue().stream().map(value -> ((StringTag) value).getValue()).toList();
+    }
+
+}
