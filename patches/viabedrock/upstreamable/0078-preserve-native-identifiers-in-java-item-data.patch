+++ b/src/main/java/net/raphimc/viabedrock/api/model/NativeItemListTypes.java
@@ -0,0 +1,131 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.io.TagRegistry;
+import com.viaversion.nbt.tag.ByteTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.LongArrayTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.Tag;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+
+/** Retains empty-list element types which ordinary Java NBT serialization discards. */
+final class NativeItemListTypes {
+
+    static ListTag<CompoundTag> capture(final CompoundTag data) {
+        final ListTag<CompoundTag> result = new ListTag<>(CompoundTag.class);
+        capture(data, new ArrayList<>(), result);
+        return result;
+    }
+
+    private static void capture(final Tag data, final List<String> path, final ListTag<CompoundTag> result) {
+        if (data instanceof CompoundTag compound) {
+            for (final String key : compound.keySet().stream().sorted().toList()) {
+                path.add(key);
+                capture(compound.get(key), path, result);
+                path.remove(path.size() - 1);
+            }
+        } else if (data instanceof ListTag<?> list) {
+            if (list.isEmpty() && list.getElementType() != null) {
+                final int type = TagRegistry.getIdFor(list.getElementType());
+                if (type <= 0 || type > LongArrayTag.ID) {
+                    throw new IllegalArgumentException("Unregistered item list element type");
+                }
+                final CompoundTag entry = new CompoundTag();
+                entry.put("path", new ListTag<>(path.stream().map(StringTag::new).toList()));
+                entry.putByte("type", (byte) type);
+                result.add(entry);
+            }
+            for (int index = 0; index < list.size(); index++) {
+                path.add(Integer.toString(index));
+                capture(list.get(index), path, result);
+                path.remove(path.size() - 1);
+            }
+        }
+    }
+
+    static CompoundTag restore(final CompoundTag data, final Tag types) {
+        if (types == null) {
+            return data;
+        }
+        if (data == null || !(types instanceof ListTag<?> entries)
+                || !entries.isEmpty() && entries.getElementType() != CompoundTag.class) {
+            throw new IllegalArgumentException("Invalid item list type metadata");
+        }
+        final CompoundTag result = data.copy();
+        final var seen = new HashSet<List<String>>();
+        for (final Tag value : entries) {
+            if (!(value instanceof CompoundTag entry) || !(entry.get("type") instanceof ByteTag type)
+                    || !(entry.get("path") instanceof ListTag<?> segments) || segments.isEmpty()
+                    || segments.getElementType() != StringTag.class) {
+                throw new IllegalArgumentException("Invalid item list type metadata");
+            }
+            if (type.asByte() <= 0 || type.asByte() > LongArrayTag.ID) {
+                throw new IllegalArgumentException("Unknown item list element type");
+            }
+            final Class<? extends Tag> elementType = TagRegistry.getClassFor(type.asByte());
+            final List<String> path = new ArrayList<>();
+            for (final Tag segment : segments) {
+                if (!(segment instanceof StringTag name)) {
+                    throw new IllegalArgumentException("Invalid item list path");
+                }
+                path.add(name.getValue());
+            }
+            if (!seen.add(path)) {
+                throw new IllegalArgumentException("Duplicate item list path");
+            }
+            Tag parent = result;
+            for (int index = 0; index < path.size() - 1; index++) {
+                parent = child(parent, path.get(index));
+            }
+            final String last = path.get(path.size() - 1);
+            final Tag target = child(parent, last);
+            if (!(target instanceof ListTag<?> list) || !list.isEmpty()
+                    || list.getElementType() != null && list.getElementType() != elementType) {
+                throw new IllegalArgumentException("Item list type targets incompatible data");
+            }
+            final ListTag<?> restored = new ListTag<>(elementType);
+            if (parent instanceof CompoundTag compound) {
+                compound.put(last, restored);
+            } else {
+                replace((ListTag<?>) parent, index(last), restored);
+            }
+        }
+        return result;
+    }
+
+    private static Tag child(final Tag parent, final String segment) {
+        if (parent instanceof CompoundTag compound) {
+            return compound.get(segment);
+        } else if (parent instanceof ListTag<?> list) {
+            return list.get(index(segment));
+        }
+        throw new IllegalArgumentException("Invalid item list path");
+    }
+
+    private static int index(final String segment) {
+        final int index = Integer.parseInt(segment);
+        if (index < 0 || !segment.equals(Integer.toString(index))) {
+            throw new IllegalArgumentException("Invalid item list index");
+        }
+        return index;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void replace(final ListTag<?> parent, final int index, final ListTag<?> value) {
+        // The validated target is already a ListTag, preserving the parent's element class.
+        ((ListTag<Tag>) parent).set(index, value);
+    }
+
+    private NativeItemListTypes() {
+    }
+
+}
