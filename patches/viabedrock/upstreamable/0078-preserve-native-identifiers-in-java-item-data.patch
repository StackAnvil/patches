 public final class ItemDataRewriter {
 
+    public static final String BEDROCK_IDENTIFIER_TAG = "viabedrock:item_identifier";
+    public static final String BEDROCK_ANIMATION_TAG = "viabedrock:item_animation";
+    public static final String BEDROCK_USE_DURATION_TAG = "viabedrock:item_use_duration";
+
     private static final Set<String> DYED_LEATHER_ARMOR_ITEMS = Set.of(
             "minecraft:leather_helmet", "minecraft:leather_chestplate",
             "minecraft:leather_leggings", "minecraft:leather_boots");
@@ -255,6 +260,24 @@ public final class ItemDataRewriter {
         }
     }
 
+    /** Retain native identity and animation context across Java mappings and proxy connections. */
+    static CompoundTag withBedrockItemData(final CompoundTag javaData, final String identifier, final ItemAnimationData animation) {
+        final CompoundTag data = javaData == null ? new CompoundTag() : javaData.copy();
+        data.putString(BEDROCK_IDENTIFIER_TAG, identifier);
+        if (animation.useDurationTicks() != null) {
+            data.putInt(BEDROCK_USE_DURATION_TAG, animation.useDurationTicks());
+        } else {
+            data.remove(BEDROCK_USE_DURATION_TAG);
+        }
+        final CompoundTag renderData = animation.renderTag();
+        if (!renderData.isEmpty()) {
+            data.put(BEDROCK_ANIMATION_TAG, renderData);
+        } else {
+            data.remove(BEDROCK_ANIMATION_TAG);
+        }
+        return data;
+    }
+
     private ItemDataRewriter() {
     }
 
