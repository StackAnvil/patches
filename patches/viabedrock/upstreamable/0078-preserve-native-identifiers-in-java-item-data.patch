+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.nbt.tag.ShortTag;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemAnimationDataTest {
+
+    @Test
+    void freezesTagsAndConvertsSwingSecondsWithoutChangingKineticTicks() {
+        final CompoundTag components = new CompoundTag();
+        final ListTag<StringTag> tags = new ListTag<>(StringTag.class);
+        tags.add(new StringTag("probe:first"));
+        tags.add(new StringTag("probe:first"));
+        tags.add(new StringTag("probe:second"));
+        components.put("item_tags", tags);
+        final CompoundTag swing = new CompoundTag();
+        swing.putFloat("value", 0.65F);
+        components.put("minecraft:swing_duration", swing);
+        final CompoundTag weapon = new CompoundTag();
+        weapon.putInt("delay", 15);
+        final CompoundTag damage = new CompoundTag();
+        damage.putInt("max_duration", -1);
+        weapon.put("damage_conditions", damage);
+        final CompoundTag wrapper = new CompoundTag();
+        wrapper.put("minecraft:kinetic_weapon", weapon);
+        components.put("minecraft:kinetic_weapon", wrapper);
+        final var data = ItemAnimationData.fromNetworkComponents(components);
+        assertEquals(2, data.tags().size());
+        assertEquals(13, data.swingDurationTicks());
+        assertEquals(new ItemAnimationData.KineticWeapon(15, -1, 0, 0), data.kineticWeapon());
+        tags.getValue().clear();
+        weapon.putInt("delay", 10);
+        assertEquals(2, data.tags().size());
+        assertEquals(15, data.kineticWeapon().delay());
+        final var wire = data.renderTag();
+        assertEquals(2, wire.getListTag("tags", StringTag.class).size());
+        assertEquals(-1, wire.getCompoundTag("kinetic_weapon").getInt("damage_duration"));
+        wire.getCompoundTag("kinetic_weapon").putInt("delay", 0);
+        assertEquals(15, data.kineticWeapon().delay());
+        final List<String> mutable = new ArrayList<>(data.tags());
+        final var copy = new ItemAnimationData(null, mutable, null, null);
+        mutable.clear();
+        assertEquals(data.tags(), copy.tags());
+        assertThrows(UnsupportedOperationException.class, () -> copy.tags().clear());
+    }
+
+    @Test
+    void keepsAbsentConditionsAtZeroAndRejectsUnsupportedWidths() {
+        final CompoundTag components = new CompoundTag();
+        assertEquals(ItemAnimationData.EMPTY, ItemAnimationData.fromNetworkComponents(components));
+        final CompoundTag weapon = new CompoundTag();
+        final CompoundTag wrapper = new CompoundTag();
+        wrapper.put("minecraft:kinetic_weapon", weapon);
+        components.put("minecraft:kinetic_weapon", wrapper);
+        weapon.putInt("delay", 65535);
+        final CompoundTag duration = new CompoundTag();
+        duration.putInt("max_duration", Short.MAX_VALUE);
+        weapon.put("knockback_conditions", duration);
+        assertEquals(new ItemAnimationData.KineticWeapon(65535, 0, Short.MAX_VALUE, 0),
+                ItemAnimationData.fromNetworkComponents(components).kineticWeapon());
+        weapon.put("delay", new ShortTag((short) 65535));
+        duration.put("max_duration", new ShortTag((short) -1));
+        assertEquals(new ItemAnimationData.KineticWeapon(65535, 0, -1, 0),
+                ItemAnimationData.fromNetworkComponents(components).kineticWeapon());
+        weapon.putInt("delay", -1);
+        duration.putInt("max_duration", 65535);
+        assertEquals(new ItemAnimationData.KineticWeapon(0, 0, 0, 0),
+                ItemAnimationData.fromNetworkComponents(components).kineticWeapon());
+        final CompoundTag swing = new CompoundTag();
+        components.put("minecraft:swing_duration", swing);
+        for (final float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, -1F, Float.MAX_VALUE}) {
+            swing.putFloat("value", invalid);
+            assertNull(ItemAnimationData.fromNetworkComponents(components).swingDurationTicks());
+        }
+    }
+
+}
