+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.NumberTag;
+import com.viaversion.nbt.tag.ShortTag;
+import com.viaversion.nbt.tag.StringTag;
+
+import java.util.LinkedHashSet;
+import java.util.List;
+
+/** Immutable native item context needed by client animation queries. */
+public record ItemAnimationData(Integer useDurationTicks, List<String> tags, Integer swingDurationTicks,
+                                KineticWeapon kineticWeapon) {
+
+    public static final ItemAnimationData EMPTY = new ItemAnimationData(null, List.of(), null, null);
+
+    public ItemAnimationData {
+        tags = List.copyOf(new LinkedHashSet<>(tags));
+    }
+
+    public static ItemAnimationData fromNetworkComponents(final CompoundTag components) {
+        final ListTag<StringTag> compiledTags = components.getListTag("item_tags", StringTag.class);
+        final List<String> tags = compiledTags == null ? List.of()
+                : compiledTags.getValue().stream().map(StringTag::getValue).toList();
+        Integer swingTicks = null;
+        if (components.get("minecraft:swing_duration") instanceof CompoundTag swing
+                && swing.get("value") instanceof NumberTag seconds) {
+            final float ticks = seconds.asFloat() * 20F;
+            if (Float.isFinite(ticks) && ticks >= 0F && ticks < 2147483648F) {
+                swingTicks = (int) ticks;
+            }
+        }
+        KineticWeapon kinetic = null;
+        if (components.get("minecraft:kinetic_weapon") instanceof CompoundTag wrapper
+                && wrapper.get("minecraft:kinetic_weapon") instanceof CompoundTag weapon) {
+            kinetic = new KineticWeapon(integer(weapon, "delay", 0, 65535),
+                    duration(weapon, "damage_conditions"), duration(weapon, "knockback_conditions"),
+                    duration(weapon, "dismount_conditions"));
+        }
+        return new ItemAnimationData(ItemUseDuration.fromNetworkComponents(components), tags, swingTicks, kinetic);
+    }
+
+    private static int duration(final CompoundTag weapon, final String condition) {
+        return weapon.get(condition) instanceof CompoundTag data
+                ? integer(data, "max_duration", Short.MIN_VALUE, Short.MAX_VALUE) : 0;
+    }
+
+    private static int integer(final CompoundTag data, final String name, final int min, final int max) {
+        final var tag = data.get(name);
+        if (tag instanceof ShortTag value) {
+            return min == 0 && max == 65535 ? value.asInt() & 0xFFFF : value.asInt();
+        }
+        if (tag instanceof IntTag value && value.asInt() >= min && value.asInt() <= max) {
+            return value.asInt();
+        }
+        return 0;
+    }
+
+    public CompoundTag renderTag() {
+        final CompoundTag data = new CompoundTag();
+        if (!this.tags.isEmpty()) {
+            data.put("tags", new ListTag<>(this.tags.stream().map(StringTag::new).toList()));
+        }
+        if (this.swingDurationTicks != null) {
+            data.putInt("swing_duration_ticks", this.swingDurationTicks);
+        }
+        if (this.kineticWeapon != null) {
+            final CompoundTag kinetic = new CompoundTag();
+            kinetic.putInt("delay", this.kineticWeapon.delay());
+            kinetic.putInt("damage_duration", this.kineticWeapon.damageDuration());
+            kinetic.putInt("knockback_duration", this.kineticWeapon.knockbackDuration());
+            kinetic.putInt("dismount_duration", this.kineticWeapon.dismountDuration());
+            data.put("kinetic_weapon", kinetic);
+        }
+        return data;
+    }
+
+    public record KineticWeapon(int delay, int damageDuration, int knockbackDuration, int dismountDuration) {
+    }
+
+}
