diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeItemStackDataTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeItemStackDataTest.java
new file mode 100644
index 000000000..43f639cf4
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/NativeItemStackDataTest.java
@@ -0,0 +1,106 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.nbt.tag.ByteArrayTag;
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.ListTag;
+import com.viaversion.nbt.tag.StringTag;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeItemStackDataTest {
+
+    @Test
+    void preservesTypedNestedDataAndSignedBitsThroughJavaNbt() {
+        final CompoundTag nested = new CompoundTag();
+        nested.putByte("FireworkType", (byte) -1);
+        nested.put("FireworkColor", new ByteArrayTag(new byte[]{1, -1, 17}));
+        final CompoundTag tag = new CompoundTag();
+        tag.put("FireworksItem", nested);
+        tag.putLong("map_uuid", Long.MIN_VALUE);
+        tag.putInt("Damage", 71);
+        final var source = new BedrockItem(321, Short.MAX_VALUE, (byte) 255, tag,
+                new String[]{"minecraft:stone", "minecraft:dirt", "minecraft:stone"}, new String[]{"minecraft:glass"},
+                Long.MIN_VALUE, Integer.MIN_VALUE, 73);
+        final var snapshot = NativeItemStackData.fromItem(source);
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.TAG.write(buffer, snapshot.toTag());
+            final var decoded = NativeItemStackData.fromTag((CompoundTag) Types.TAG.read(buffer));
+            assertEquals(snapshot, decoded);
+            assertFalse(buffer.isReadable());
+            assertEquals(List.of("minecraft:stone", "minecraft:dirt", "minecraft:stone"), decoded.canPlace());
+            assertEquals(tag, decoded.userData());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void ownsSnapshotDataIndependentlyFromTheSourceAndEncodedTags() {
+        final CompoundTag tag = new CompoundTag();
+        tag.putInt("Damage", 17);
+        final String[] restrictions = {"minecraft:stone"};
+        final var source = new BedrockItem(17, (short) 3, (byte) 1, tag, restrictions, new String[0], 9, 0, null);
+        final var snapshot = NativeItemStackData.fromItem(source);
+        final var encoded = snapshot.toTag();
+        final var decoded = NativeItemStackData.fromTag(encoded);
+        tag.putInt("Damage", 99);
+        restrictions[0] = "minecraft:dirt";
+        source.setData(7);
+        encoded.getCompoundTag("user_data").putInt("Damage", 81);
+        snapshot.userData().putInt("Damage", 83);
+        decoded.userData().putInt("Damage", 85);
+        assertEquals(snapshot, decoded);
+        assertEquals(17, snapshot.userData().getInt("Damage"));
+        assertEquals(3, snapshot.auxiliaryValue());
+        assertEquals(List.of("minecraft:stone"), snapshot.canPlace());
+        assertThrows(UnsupportedOperationException.class, () -> snapshot.canPlace().add("minecraft:dirt"));
+    }
+
+    @Test
+    void keepsAbsentUserDataDistinctFromAnEmptyCompound() {
+        final var absent = NativeItemStackData.fromItem(new BedrockItem(1));
+        final var present = NativeItemStackData.fromItem(new BedrockItem(1, (short) 0, (byte) 1, new CompoundTag()));
+        assertNull(NativeItemStackData.fromTag(absent.toTag()).userData());
+        assertTrue(NativeItemStackData.fromTag(present.toTag()).userData().isEmpty());
+        assertNotEquals(absent, present);
+        final var source = new BedrockItem(1);
+        source.setAmount(2);
+        source.setNetId(17);
+        assertEquals(absent, NativeItemStackData.fromItem(source));
+    }
+
+    @Test
+    void rejectsUnknownVersionsWrongWidthsAndMalformedRestrictions() {
+        final var source = NativeItemStackData.fromItem(new BedrockItem(1));
+        assertNull(NativeItemStackData.fromTag(null));
+        final var unknown = source.toTag();
+        unknown.putInt("version", 2);
+        assertNull(NativeItemStackData.fromTag(unknown));
+        final var wrongWidth = source.toTag();
+        wrongWidth.putInt("auxiliary_value", 0);
+        assertNull(NativeItemStackData.fromTag(wrongWidth));
+        final var wrongUserData = source.toTag();
+        wrongUserData.put("user_data", new StringTag("invalid"));
+        assertNull(NativeItemStackData.fromTag(wrongUserData));
+        final var wrongRestrictions = source.toTag();
+        wrongRestrictions.put("can_place", new ListTag<>(List.of(new IntTag(17))));
+        assertNull(NativeItemStackData.fromTag(wrongRestrictions));
+        final var missing = source.toTag();
+        missing.remove("blocking_ticks");
+        assertNull(NativeItemStackData.fromTag(missing));
+    }
+
+}
