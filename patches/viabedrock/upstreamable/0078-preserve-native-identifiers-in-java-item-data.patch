From 8c1b98221f4c529ebe33c847b6f61150f11efce5 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 3 Oct 2026 01:05:30 +0200
Subject: [PATCH] feat(items): preserve native identifiers in Java item data

Retain the original Bedrock identifier after Java item translation so client integrations can evaluate native item-name queries through ViaProxy. Java mappings can rename legacy items and collapse custom items to a shared Java type. Keep unrelated custom data and copy mapping-owned tags before attaching identity.

Bedrock 1.26.51.1 query callback FUN_14221b950 resolves the equipped item's raw-name hash from either the legacy item or its component document. Native execution confirms those source branches. This contract preserves identifiers for rendering; it does not trust client-supplied identifiers for inventory requests or replace native use-duration research.
---
 .../protocol/rewriter/ItemDataRewriter.java   |  9 ++++
 .../protocol/rewriter/ItemRewriter.java       |  2 +
 .../protocol/rewriter/ItemIdentityTest.java   | 44 +++++++++++++++++++
 3 files changed, 55 insertions(+)
 create mode 100644 src/test/java/net/raphimc/viabedrock/protocol/rewriter/ItemIdentityTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
index 2635bd6f..0269a9a8 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
@@ -53,6 +53,8 @@ import java.util.logging.Level;
 
 public final class ItemDataRewriter {
 
+    public static final String BEDROCK_IDENTIFIER_TAG = "viabedrock:item_identifier";
+
     private static final Set<String> DYED_LEATHER_ARMOR_ITEMS = Set.of(
             "minecraft:leather_helmet", "minecraft:leather_chestplate",
             "minecraft:leather_leggings", "minecraft:leather_boots");
@@ -255,6 +257,13 @@ public final class ItemDataRewriter {
         }
     }
 
+    /** Retain native identity across Java item mappings and proxy connections. */
+    static CompoundTag withBedrockIdentifier(final CompoundTag javaData, final String identifier) {
+        final CompoundTag data = javaData == null ? new CompoundTag() : javaData.copy();
+        data.putString(BEDROCK_IDENTIFIER_TAG, identifier);
+        return data;
+    }
+
     private ItemDataRewriter() {
     }
 
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemRewriter.java
index 6c115dce..cdc36844 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemRewriter.java
@@ -255,6 +255,8 @@ public class ItemRewriter extends StoredObject {
             ITEM_NBT_REWRITERS.get(tag).toJava(this.user(), bedrockItem, javaItem);
         }
 
+        javaItem.dataContainer().set(StructuredDataKey.CUSTOM_DATA,
+                ItemDataRewriter.withBedrockIdentifier(javaItem.dataContainer().get(StructuredDataKey.CUSTOM_DATA), identifier));
         return javaItem;
     }
 
diff --git a/src/test/java/net/raphimc/viabedrock/protocol/rewriter/ItemIdentityTest.java b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/ItemIdentityTest.java
new file mode 100644
index 00000000..beb20267
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/protocol/rewriter/ItemIdentityTest.java
@@ -0,0 +1,44 @@
