+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+public final class ItemUseDuration {
+
+    private ItemUseDuration() {
+    }
+
+    /** Network item properties carry ticks, unlike the authored use-modifiers component's seconds. */
+    public static Integer fromNetworkComponents(final CompoundTag components) {
+        if (components.get("item_properties") instanceof CompoundTag properties
+                && properties.get("use_duration") instanceof IntTag ticks && ticks.asInt() >= 0) {
+            return ticks.asInt();
+        }
+        return null;
+    }
+
+}
diff --git a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
index 2635bd6f..96439ec1 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/rewriter/ItemDataRewriter.java
@@ -53,6 +53,9 @@ import java.util.logging.Level;
 
 public final class ItemDataRewriter {
 
+    public static final String BEDROCK_IDENTIFIER_TAG = "viabedrock:item_identifier";
+    public static final String BEDROCK_USE_DURATION_TAG = "viabedrock:item_use_duration";
+
     private static final Set<String> DYED_LEATHER_ARMOR_ITEMS = Set.of(
             "minecraft:leather_helmet", "minecraft:leather_chestplate",
             "minecraft:leather_leggings", "minecraft:leather_boots");
@@ -255,6 +258,18 @@ public final class ItemDataRewriter {
         }
     }
 
+    /** Retain native identity across Java item mappings and proxy connections. */
+    static CompoundTag withBedrockItemData(final CompoundTag javaData, final String identifier, final Integer useDuration) {
+        final CompoundTag data = javaData == null ? new CompoundTag() : javaData.copy();
+        data.putString(BEDROCK_IDENTIFIER_TAG, identifier);
+        if (useDuration != null) {
+            data.putInt(BEDROCK_USE_DURATION_TAG, useDuration);
+        } else {
+            data.remove(BEDROCK_USE_DURATION_TAG);
+        }
+        return data;
+    }
+
     private ItemDataRewriter() {
     }
 
