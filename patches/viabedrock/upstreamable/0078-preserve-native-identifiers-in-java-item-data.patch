+package net.raphimc.viabedrock.protocol.rewriter;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemIdentityTest {
+
+    @Test
+    void preservesUnrelatedCustomDataAndDoesNotMutateSharedMappings() {
+        final CompoundTag original = new CompoundTag();
+        final CompoundTag nested = new CompoundTag();
+        nested.putInt("value", 17);
+        original.put("nested", nested);
+        original.putInt("viabedrock:creative_entry", 23);
+        original.putString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "old");
+        final String identifier = "probe:custom_item";
+        final CompoundTag result = ItemDataRewriter.withBedrockItemData(original, identifier, 1440000);
+        assertEquals(identifier, result.getString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG));
+        assertEquals(1440000, result.getInt(ItemDataRewriter.BEDROCK_USE_DURATION_TAG));
+        assertFalse(original.contains(ItemDataRewriter.BEDROCK_USE_DURATION_TAG));
+        assertFalse(ItemDataRewriter.withBedrockItemData(result, identifier, null)
+                .contains(ItemDataRewriter.BEDROCK_USE_DURATION_TAG));
+        assertEquals(original.getInt("viabedrock:creative_entry"), result.getInt("viabedrock:creative_entry"));
+        assertEquals(nested, result.getCompoundTag("nested"));
+        result.getCompoundTag("nested").putInt("value", 99);
+        assertEquals(17, nested.getInt("value"));
+        assertNotEquals(identifier, original.getString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG));
+    }
+
+    @Test
+    void keepsDifferentNativeAliasesDistinctDespiteTheirSharedJavaMapping() {
+        final String first = "minecraft:apple";
+        final String second = "probe:apple";
+        final CompoundTag a = ItemDataRewriter.withBedrockItemData(null, first, null);
+        final CompoundTag b = ItemDataRewriter.withBedrockItemData(null, second, null);
+        assertNotEquals(a, b);
+        assertEquals(a, ItemDataRewriter.withBedrockItemData(a, first, null));
+        assertEquals(b, ItemDataRewriter.withBedrockItemData(a, second, null));
+    }
+
+}
