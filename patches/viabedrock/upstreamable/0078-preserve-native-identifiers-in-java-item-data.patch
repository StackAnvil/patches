+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.FloatTag;
+import com.viaversion.nbt.tag.IntTag;
+import com.viaversion.nbt.tag.LongTag;
+import com.viaversion.nbt.tag.Tag;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ItemUseDurationTest {
+
+    @Test
+    void usesCompiledTicksWithoutMultiplyingThemByTheAuthoredSeconds() {
+        for (final int ticks : new int[]{0, 32, 1440000, Integer.MAX_VALUE}) {
+            final CompoundTag components = new CompoundTag();
+            final CompoundTag properties = new CompoundTag();
+            properties.putInt("use_duration", ticks);
+            components.put("item_properties", properties);
+            final CompoundTag modifiers = new CompoundTag();
+            modifiers.putFloat("use_duration", ticks / 20F);
+            components.put("minecraft:use_modifiers", modifiers);
+            assertEquals(ticks, ItemUseDuration.fromNetworkComponents(components));
+        }
+    }
+
+    @Test
+    void leavesMissingMalformedAndUnsupportedDurationsUnknown() {
+        final CompoundTag components = new CompoundTag();
+        assertNull(ItemUseDuration.fromNetworkComponents(components));
+        final CompoundTag properties = new CompoundTag();
+        components.put("item_properties", properties);
+        assertNull(ItemUseDuration.fromNetworkComponents(components));
+        for (final var duration : new Tag[]{new IntTag(-1), new FloatTag(1.6F), new LongTag(1L << 32)}) {
+            properties.put("use_duration", duration);
+            assertNull(ItemUseDuration.fromNetworkComponents(components));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_REGISTRY", matches = ".+")
+    void agreesWithIndependentSecondsInTheTargetServerRegistry() throws Exception {
+        int compared = 0;
+        try (var reader = Files.newBufferedReader(Path.of(System.getenv("STACKANVIL_ITEM_REGISTRY")))) {
+            for (final var entry : JsonParser.parseReader(reader).getAsJsonArray()) {
+                final var data = entry.getAsJsonObject().getAsJsonObject("Data");
+                if (!data.has("components")) {
+                    continue;
+                }
+                final var nativeComponents = data.getAsJsonObject("components");
+                final var nativeProperties = nativeComponents.getAsJsonObject("item_properties");
+                if (nativeProperties == null || !nativeProperties.has("use_duration")) {
+                    continue;
+                }
+                final int ticks = nativeProperties.get("use_duration").getAsInt();
+                final CompoundTag components = new CompoundTag();
+                final CompoundTag properties = new CompoundTag();
+                properties.putInt("use_duration", ticks);
+                components.put("item_properties", properties);
+                assertEquals(ticks, ItemUseDuration.fromNetworkComponents(components));
+                final var modifiers = nativeComponents.getAsJsonObject("minecraft:use_modifiers");
+                if (modifiers != null && modifiers.has("use_duration")) {
+                    assertEquals(modifiers.get("use_duration").getAsFloat() * 20F, ticks);
+                    compared++;
+                }
+            }
+        }
+        assertTrue(compared > 0);
+    }
+
+}
