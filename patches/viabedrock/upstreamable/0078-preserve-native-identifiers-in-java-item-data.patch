+package net.raphimc.viabedrock.protocol.model;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.nbt.tag.IntTag;
+
+public final class ItemUseDuration {
+
+    private ItemUseDuration() {
+    }
+
+    /** Network item properties carry ticks, unlike the authored use-modifiers component's seconds. */
+    public static Integer fromNetworkComponents(final CompoundTag components) {
+        if (components.get("item_properties") instanceof CompoundTag properties
+                && properties.get("use_duration") instanceof IntTag ticks && ticks.asInt() >= 0) {
+            return ticks.asInt();
+        }
+        return null;
+    }
+
+}
