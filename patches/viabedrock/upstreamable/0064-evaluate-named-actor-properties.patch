+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorStatesTest {
+
+    @Test
+    void samplesBlockingOnSimulationTicksAndDiscardsReplacedPlayerTimers() {
+        final var registry = new NativeActorStates();
+        final UUID player = UUID.randomUUID();
+        final UUID remote = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        final var flags = Set.of(ActorFlags.BLOCKING, ActorFlags.TRANSITION_BLOCKING);
+        registry.apply(blockingSnapshot(player, lifetime, true, 1, flags), player);
+        registry.apply(blockingSnapshot(remote, UUID.randomUUID(), false, 2, flags), player);
+        assertEquals(0F, registry.shieldBlockingBob(player, 0.5F));
+        registry.tick();
+        assertEquals(3F, registry.shieldBlockingBob(player, 0.5F));
+        assertEquals(0F, registry.shieldBlockingBob(remote, 0.5F));
+        registry.apply(blockingSnapshot(player, lifetime, true, 1, Set.of(ActorFlags.BLOCKING, ActorFlags.BLOCKED_USING_DAMAGED_SHIELD)), player);
+        registry.tick();
+        assertEquals(1F, registry.shieldBlockingBob(player, 0.5F));
+        registry.tick();
+        assertEquals(3F, registry.shieldBlockingBob(player, 0.5F));
+        final UUID replacement = UUID.randomUUID();
+        registry.apply(blockingSnapshot(player, replacement, true, 1, Set.of(ActorFlags.BLOCKING)), player);
+        registry.apply(new NativeActorMessage.Remove(player, lifetime, true), player);
+        registry.tick();
+        assertEquals(0F, registry.shieldBlockingBob(player, 0.5F));
+        registry.apply(blockingSnapshot(player, replacement, true, 1, flags), player);
+        registry.tick();
+        assertEquals(4F, registry.shieldBlockingBob(player, 0.5F));
+        registry.apply(new NativeActorMessage.Remove(player, replacement, true), player);
+        assertEquals(0F, registry.shieldBlockingBob(player, 0.5F));
+        registry.clear();
+        assertEquals(0F, registry.shieldBlockingBob(remote, 0.5F));
+    }
+
+    private static NativeActorMessage.Snapshot blockingSnapshot(final UUID uuid, final UUID lifetime, final boolean local,
+                                                               final long runtimeId, final Set<ActorFlags> flags) {
+        return new NativeActorMessage.Snapshot(uuid, lifetime, local, runtimeId, "minecraft:player", "", 1F, flags, 0, 0, null, Map.of());
+    }
+
+    @Test
+    void resolvesTheLocalJavaIdentityAndRetainsItsNativeRuntimeIdentity() {
+        final var registry = new NativeActorStates();
+        final UUID javaPlayer = UUID.randomUUID();
+        final var nativePlayer = snapshot(UUID.randomUUID(), UUID.randomUUID(), true, 17);
+        registry.apply(nativePlayer, javaPlayer);
+        assertNull(registry.get(nativePlayer.uuid()));
+        assertSame(nativePlayer, registry.get(javaPlayer));
+        assertSame(nativePlayer, registry.getByRuntimeId(17));
+        registry.apply(new NativeActorMessage.Remove(nativePlayer.uuid(), nativePlayer.lifetime(), true), javaPlayer);
+        assertNull(registry.get(javaPlayer));
+        assertNull(registry.getByRuntimeId(17));
+    }
+
+    @Test
+    void removalCannotEraseReplacementWithTheSameJavaIdentity() {
+        final var registry = new NativeActorStates();
+        final UUID uuid = UUID.randomUUID();
+        final var old = snapshot(uuid, UUID.randomUUID(), false, 2);
+        final var replacement = snapshot(uuid, UUID.randomUUID(), false, 3);
+        registry.apply(old, null);
+        registry.apply(replacement, null);
+        registry.apply(new NativeActorMessage.Remove(uuid, old.lifetime(), false), null);
+        assertSame(replacement, registry.get(uuid));
+        assertNull(registry.getByRuntimeId(2));
+        assertSame(replacement, registry.getByRuntimeId(3));
+        registry.apply(new NativeActorMessage.Remove(uuid, replacement.lifetime(), false), null);
+        assertNull(registry.get(uuid));
+        assertNull(registry.getByRuntimeId(3));
+    }
+
+    @Test
+    void runtimeIdReuseAndCleanupDoNotRetainPreviousActorsOrConnections() {
+        final var registry = new NativeActorStates();
+        final var otherConnection = new NativeActorStates();
+        final var old = snapshot(UUID.randomUUID(), UUID.randomUUID(), false, Long.MIN_VALUE);
+        final var replacement = snapshot(UUID.randomUUID(), UUID.randomUUID(), false, old.runtimeId());
+        registry.apply(old, null);
+        otherConnection.apply(old, null);
+        registry.apply(replacement, null);
+        registry.apply(new NativeActorMessage.Remove(old.uuid(), old.lifetime(), false), null);
+        assertNull(registry.get(old.uuid()));
+        assertSame(replacement, registry.getByRuntimeId(old.runtimeId()));
+        assertSame(old, otherConnection.getByRuntimeId(old.runtimeId()));
+        registry.clear();
+        assertNull(registry.get(replacement.uuid()));
+        assertNull(registry.getByRuntimeId(old.runtimeId()));
+    }
+
+    private static NativeActorMessage.Snapshot snapshot(final UUID uuid, final UUID lifetime, final boolean local, final long runtimeId) {
+        return new NativeActorMessage.Snapshot(uuid, lifetime, local, runtimeId, "minecraft:player", "", 1F,
+                Set.of(ActorFlags.CHARGING), 1, 2, 0x89ABCDEF, Map.of("fixture:enabled", true));
+    }
+
+}
