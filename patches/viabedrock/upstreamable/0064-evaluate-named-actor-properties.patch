     public static List<Expression> parse(final Reader reader) throws IOException {
-        return MolangParser.parser(reader).parseAll();
+        final StringBuilder source = new StringBuilder();
+        final char[] buffer = new char[1024];
+        int length;
+        while ((length = reader.read(buffer)) != -1) {
+            source.append(buffer, 0, length);
+        }
+        return MolangParser.parser(new StringReader(normalizeAssignments(source.toString()))).parseAll().stream().map(expression -> normalizeOperators(expression, true)).toList();
+    }
+
+    /** Preserve Bedrock's lowest-precedence, right-associative assignments when parsing with Mocha. */
+    public static String normalizeAssignments(final String expression) {
+        final List<Integer> assignments = new ArrayList<>();
+        char quote = 0;
+        int position = 0;
+        while (position < expression.length()) {
+            final char current = expression.charAt(position);
+            if (quote != 0) {
+                if (current == '\\') {
+                    position++;
+                } else if (current == quote) {
+                    quote = 0;
+                }
+            } else if (current == '\'' || current == '"') {
+                quote = current;
+            } else if (current == '=' && (position == 0 || "=!<>".indexOf(expression.charAt(position - 1)) < 0)
+                && (position + 1 == expression.length() || expression.charAt(position + 1) != '=')) {
+                assignments.add(position);
+            }
+            position++;
+        }
+        final StringBuilder result = new StringBuilder(expression);
+        for (int index = assignments.size() - 1; index >= 0; index--) {
+            final int assignment = assignments.get(index);
+            final int start = assignmentStart(result, assignment);
+            final int end = assignmentEnd(result, assignment + 1);
+            result.insert(end, "))");
+            result.insert(assignment + 1, '(');
+            result.insert(start, '(');
+        }
+        return result.toString();
+    }
+
+    private static int assignmentStart(final CharSequence source, final int assignment) {
+        int position = assignment - 1;
+        int brackets = 0;
+        int parentheses = 0;
+        while (position >= 0) {
+            final char current = source.charAt(position);
+            if (current == ']') {
+                brackets++;
+            } else if (current == ')') {
+                parentheses++;
+            } else if (current == '[') {
+                brackets--;
+            } else if (current == '(') {
+                if (parentheses == 0) {
+                    break;
+                }
+                parentheses--;
+            } else if (brackets == 0 && parentheses == 0 && ";,{}?:=+-*/!|&<>".indexOf(current) >= 0) {
+                break;
+            }
+            position--;
+        }
+        return position + 1;
+    }
+
+    private static int assignmentEnd(final CharSequence source, final int start) {
+        int end = start;
+        int parentheses = 0;
+        int brackets = 0;
+        int braces = 0;
+        int ternaries = 0;
+        char quote = 0;
+        while (end < source.length()) {
+            final char current = source.charAt(end);
+            if (quote != 0) {
+                if (current == '\\') {
+                    end++;
+                } else if (current == quote) {
+                    quote = 0;
+                }
+            } else if (current == '\'' || current == '"') {
+                quote = current;
+            } else if (current == '(') {
+                parentheses++;
+            } else if (current == '[') {
+                brackets++;
+            } else if (current == '{') {
+                braces++;
+            } else if (current == ')') {
+                if (parentheses == 0) {
+                    break;
+                }
+                parentheses--;
+            } else if (current == ']') {
+                if (brackets == 0) {
+                    break;
+                }
+                brackets--;
+            } else if (current == '}') {
+                if (braces == 0) {
+                    break;
+                }
+                braces--;
+            } else if (parentheses == 0 && brackets == 0 && braces == 0) {
+                if (current == ';' || current == ',') {
+                    break;
+                } else if (current == '?') {
+                    if (end + 1 < source.length() && source.charAt(end + 1) == '?') {
+                        end++;
+                    } else {
+                        ternaries++;
+                    }
+                } else if (current == ':') {
+                    if (ternaries == 0) {
+                        break;
+                    }
+                    ternaries--;
+                }
+            }
+            end++;
+        }
+        return end;
+    }
+
+    /** Correct Mocha's unary/postfix binding before an evaluator adds its own query handling. */
+    public static Expression normalizeOperators(final Expression expression) {
+        return normalizeOperators(expression, false);
+    }
+
+    private static Expression normalizeOperators(final Expression expression, final boolean compareStrings) {
+        if (expression instanceof BinaryExpression binary) {
+            final Expression left = normalizeOperators(binary.left(), compareStrings);
+            final Expression right = normalizeOperators(binary.right(), compareStrings);
+            if (compareStrings && (binary.op() == BinaryExpression.Op.EQ || binary.op() == BinaryExpression.Op.NEQ)) {
+                final Expression equality = new CallExpression(new IdentifierExpression("viabedrock_equal"), List.of(left, right));
+                return binary.op() == BinaryExpression.Op.EQ ? equality : new UnaryExpression(UnaryExpression.Op.LOGICAL_NEGATION, equality);
+            }
+            return new BinaryExpression(binary.op(), left, right);
+        } else if (expression instanceof UnaryExpression unary) {
+            return new UnaryExpression(unary.op(), normalizeOperators(unary.expression(), compareStrings));
+        } else if (expression instanceof TernaryConditionalExpression ternary) {
+            return new TernaryConditionalExpression(normalizeOperators(ternary.condition(), compareStrings), normalizeOperators(ternary.trueExpression(), compareStrings), normalizeOperators(ternary.falseExpression(), compareStrings));
+        } else if (expression instanceof ExecutionScopeExpression scope) {
+            return new ExecutionScopeExpression(scope.expressions().stream().map(child -> normalizeOperators(child, compareStrings)).toList());
+        } else if (expression instanceof CallExpression call) {
+            if (call.function() instanceof UnaryExpression unary) {
+                return new UnaryExpression(unary.op(), normalizeOperators(new CallExpression(unary.expression(), call.arguments()), compareStrings));
+            }
+            return new CallExpression(normalizeOperators(call.function(), compareStrings), call.arguments().stream().map(child -> normalizeOperators(child, compareStrings)).toList());
+        } else if (expression instanceof AccessExpression access) {
+            return new AccessExpression(normalizeOperators(access.object(), compareStrings), access.property());
+        } else if (expression instanceof ArrayAccessExpression array) {
+            if (array.array() instanceof UnaryExpression unary) {
+                return new UnaryExpression(unary.op(), normalizeOperators(new ArrayAccessExpression(unary.expression(), array.index()), compareStrings));
+            }
+            return new ArrayAccessExpression(normalizeOperators(array.array(), compareStrings), normalizeOperators(array.index(), compareStrings));
+        }
+        return expression;
     }
 
     private MoLangEngine() {
