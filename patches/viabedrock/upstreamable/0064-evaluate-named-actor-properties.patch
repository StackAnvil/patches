+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+/** Native equip height and retained-item update for one simulation tick. */
+public record NativeHandItemState(float previousHeight, float height, boolean replaceItem) {
+
+    public static NativeHandItemState advance(final float height, final Replacement replacement) {
+        final float delta = (replacement == Replacement.ANIMATE ? 0F : 1F) - height;
+        // Native MAXSS selects the lower bound for an unordered delta.
+        final float step = delta > 0.4F ? 0.4F : delta > -0.4F ? delta : -0.4F;
+        final float nextHeight = height + step;
+        return new NativeHandItemState(height, nextHeight, replaces(nextHeight, replacement));
+    }
+
+    public static boolean replaces(final float height, final Replacement replacement) {
+        return replacement == Replacement.UPDATE || height <= 0.1F;
+    }
+
+    public enum Replacement {
+        RETAIN,
+        UPDATE,
+        ANIMATE
+    }
+
+}
