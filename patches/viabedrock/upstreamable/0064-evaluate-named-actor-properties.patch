+package net.raphimc.viabedrock.api.model.entity;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.cube.converter.parser.bedrock.controller.BedrockControllerParser;
+import org.junit.jupiter.api.Test;
+import org.redlance.mocha.runtime.Scope;
+import org.redlance.mocha.runtime.value.MutableObjectBinding;
+import org.redlance.mocha.runtime.value.Value;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomEntityMaterialSelectionTest {
+
+    @Test
+    void resolvesNamedMaterialsAndArraySelectionsWithoutLosingBoneOverrideOrder() throws Exception {
+        final var scope = Scope.create();
+        final var material = new MutableObjectBinding();
+        material.set("base", Value.of("entity_alphatest"));
+        material.set("glow", Value.of("entity_emissive_alpha"));
+        scope.set("material", material);
+        final var query = new MutableObjectBinding();
+        query.set("variant", Value.of(1));
+        scope.set("query", query);
+        final var controller = BedrockControllerParser.parse("""
+            {"render_controllers":{"controller.render.actor":{
+                "materials":[{"*":"Material.base"},{"Light*":"Array.materials[query.variant]"}],
+                "arrays":{"materials":{"Array.materials":["Material.base","Material.glow"]}}
+            }}}
+            """).get(0);
+        final var expressions = new net.raphimc.viabedrock.api.util.MoLangEngine.CompiledExpressions();
+        final var selected = CustomEntity.evaluateMaterials(expressions, scope, controller);
+        assertEquals(List.of("*", "Light*"), List.copyOf(selected.keySet()));
+        assertEquals("entity_alphatest", selected.get("*"));
+        assertEquals("entity_emissive_alpha", selected.get("Light*"));
+        query.set("variant", Value.of(0));
+        final var updated = CustomEntity.evaluateMaterials(expressions, scope, controller);
+        assertEquals(selected.get("*"), updated.get("Light*"));
+        assertNotEquals(selected.get("Light*"), updated.get("Light*"));
+        assertThrows(UnsupportedOperationException.class, () -> selected.put("other", "entity"));
+        final var model = new CustomEntity.EvaluatedModel("actor", "geometry", "texture", selected, true, 0.7F, controller.uvAnimation());
+        assertTrue(model.ignoreLighting());
+        assertEquals(0.7F, model.lightColorMultiplier());
+        assertNotEquals(model, new CustomEntity.EvaluatedModel("actor", "geometry", "texture", selected, false, 0.7F, controller.uvAnimation()));
+    }
+
+    @Test
+    void uvExpressionsRemainImmutableAndParticipateInModelChanges() throws Exception {
+        final var controller = BedrockControllerParser.parse("""
+            {"render_controllers":{"controller.render.actor":{
+                "uv_anim":{"offset":["query.life_time * 0.125",-0.2],"scale":[2,1]}
+            }}}
+            """).get(0);
+        final var initial = new CustomEntity.EvaluatedModel("actor", "geometry", "texture", java.util.Map.of(),
+            false, 1F, controller.uvAnimation());
+        final var identity = new CustomEntity.EvaluatedModel("actor", "geometry", "texture", java.util.Map.of(),
+            false, 1F, org.cube.converter.data.bedrock.controller.BedrockRenderController.UvAnimation.IDENTITY);
+        final var scope = Scope.create();
+        final var query = new MutableObjectBinding();
+        query.set("life_time", Value.of(8));
+        scope.set("query", query);
+        assertEquals(1D, net.raphimc.viabedrock.api.util.MoLangEngine.eval(scope, initial.uvAnimation().offsetU()).getAsNumber());
+        assertEquals(-0.2F, net.raphimc.viabedrock.api.util.MoLangEngine.eval(scope, initial.uvAnimation().offsetV()).getAsNumber());
+        final var current = new ArrayList<>(List.of(initial));
+        assertTrue(CustomEntity.replaceModels(current, List.of(identity)));
+        assertFalse(CustomEntity.replaceModels(current, List.of(identity)));
+        assertEquals(2D, net.raphimc.viabedrock.api.util.MoLangEngine.eval(scope, initial.uvAnimation().scaleU()).getAsNumber());
+    }
+
+}
