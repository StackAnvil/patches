 public final class MoLangEngine {
 
+    public static void bindPropertyQueries(final MutableObjectBinding queries, final Map<String, Object> properties) {
+        queries.set("has_property", (Function<Object>) (context, arguments) -> Value.of(arguments.length() > 0 && properties.containsKey(arguments.next().eval().getAsString())));
+        queries.set("property", (Function<Object>) (context, arguments) -> arguments.length() == 0 ? NumberValue.zero() : Value.of(properties.getOrDefault(arguments.next().eval().getAsString(), 0)));
+    }
