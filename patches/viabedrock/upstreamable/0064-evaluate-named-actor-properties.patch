+package net.raphimc.viabedrock.api.util;
+
+import org.redlance.mocha.parser.ast.AccessExpression;
+import org.redlance.mocha.parser.ast.ArrayAccessExpression;
+import org.redlance.mocha.parser.ast.BinaryExpression;
+import org.redlance.mocha.parser.ast.CallExpression;
+import org.redlance.mocha.parser.ast.ExecutionScopeExpression;
+import org.redlance.mocha.parser.ast.Expression;
+import org.redlance.mocha.parser.ast.IdentifierExpression;
+import org.redlance.mocha.parser.ast.StatementExpression;
+import org.redlance.mocha.parser.ast.StringExpression;
+import org.redlance.mocha.parser.ast.TernaryConditionalExpression;
+import org.redlance.mocha.parser.ast.UnaryExpression;
+import org.redlance.mocha.runtime.ExecutionContext;
+import org.redlance.mocha.runtime.ExpressionInterpreter;
+import org.redlance.mocha.runtime.Scope;
+import org.redlance.mocha.runtime.value.ArrayValue;
+import org.redlance.mocha.runtime.value.Function;
+import org.redlance.mocha.runtime.value.MutableObjectBinding;
+import org.redlance.mocha.runtime.value.NumberValue;
+import org.redlance.mocha.runtime.value.ObjectValue;
+import org.redlance.mocha.runtime.value.Value;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/** Compiles Molang jumps into host functions that unwind every nested expression frame. */
+final class MoLangControlFlow {
+
+    private static final String READ = "\0viabedrock_read";
+    private static final String COALESCE = "\0viabedrock_coalesce";
+    static final String EQUAL = "\0viabedrock_equal";
+    static final String LOOP = "\0viabedrock_loop";
+    static final String FOR_EACH = "\0viabedrock_for_each";
+    static final String CONTINUE = "\0viabedrock_continue";
+    private static final String RETURN = "\0viabedrock_return";
+    private static final String BREAK = "\0viabedrock_break";
+    private int remaining = 16384;
+
+    static List<Expression> lower(final List<Expression> expressions) throws IOException {
+        return lower(expressions, 0);
+    }
+
+    private static List<Expression> lower(final List<Expression> expressions, final int depth) throws IOException {
+        final List<Expression> result = new ArrayList<>(expressions.size());
+        for (final Expression expression : expressions) {
+            result.add(lower(expression, depth));
+        }
+        return List.copyOf(result);
+    }
+
+    private static Expression lower(final Expression expression, final int depth) throws IOException {
+        if (depth > 64) {
+            throw new IOException("The Molang expression is too deeply nested");
+        }
+        if (expression instanceof UnaryExpression unary) {
+            final Expression value = lower(unary.expression(), depth + 1);
+            return unary.op() == UnaryExpression.Op.RETURN ? call(RETURN, List.of(value)) : new UnaryExpression(unary.op(), value);
+        } else if (expression instanceof StatementExpression statement) {
+            return call(statement.op() == StatementExpression.Op.BREAK ? BREAK : CONTINUE, List.of());
+        } else if (expression instanceof CallExpression function) {
+            final List<Expression> arguments = new ArrayList<>();
+            for (int index = 0; index < function.arguments().size(); index++) {
+                final Expression argument = function.arguments().get(index);
+                final boolean assignmentTarget = index == 0 && function.function() instanceof IdentifierExpression identifier
+                    && identifier.name().equalsIgnoreCase("for_each");
+                arguments.add(assignmentTarget ? target(argument, depth + 1) : lower(argument, depth + 1));
+            }
+            if (function.function() instanceof IdentifierExpression identifier) {
+                if (identifier.name().equalsIgnoreCase("loop")) {
+                    return call(LOOP, arguments);
+                } else if (identifier.name().equalsIgnoreCase("for_each")) {
+                    return call(FOR_EACH, arguments);
+                }
+            }
+            return new CallExpression(lower(function.function(), depth + 1), List.copyOf(arguments));
+        } else if (expression instanceof BinaryExpression binary) {
+            final Expression left = binary.op() == BinaryExpression.Op.ASSIGN
+                ? target(binary.left(), depth + 1) : lower(binary.left(), depth + 1);
+            final Expression right = lower(binary.right(), depth + 1);
+            if (binary.op() == BinaryExpression.Op.NULL_COALESCE) {
+                return call(COALESCE, List.of(left, right));
+            }
+            if (binary.op() == BinaryExpression.Op.EQ || binary.op() == BinaryExpression.Op.NEQ) {
+                final Expression equality = call(EQUAL, List.of(left, right));
+                return binary.op() == BinaryExpression.Op.EQ ? equality : new UnaryExpression(UnaryExpression.Op.LOGICAL_NEGATION, equality);
+            }
+            return new BinaryExpression(binary.op(), left, right);
+        } else if (expression instanceof TernaryConditionalExpression ternary) {
+            return new TernaryConditionalExpression(lower(ternary.condition(), depth + 1), lower(ternary.trueExpression(), depth + 1), lower(ternary.falseExpression(), depth + 1));
+        } else if (expression instanceof ExecutionScopeExpression scope) {
+            return new ExecutionScopeExpression(lower(scope.expressions(), depth + 1));
+        } else if (expression instanceof AccessExpression access) {
+            final Expression object = lower(access.object(), depth + 1);
+            return variable(access.object()) ? call(READ, List.of(object, new StringExpression(access.property())))
+                : new AccessExpression(object, access.property());
+        } else if (expression instanceof ArrayAccessExpression array) {
+            return new ArrayAccessExpression(lower(array.array(), depth + 1), lower(array.index(), depth + 1));
+        }
+        return expression;
+    }
+
+    private static Expression target(final Expression expression, final int depth) throws IOException {
+        return expression instanceof AccessExpression access
+            ? new AccessExpression(lower(access.object(), depth + 1), access.property()) : lower(expression, depth);
+    }
+
+    private static boolean variable(final Expression expression) {
+        if (expression instanceof IdentifierExpression identifier) {
+            return switch (identifier.name().toLowerCase(Locale.ROOT)) {
+                case "variable", "v", "temp", "t", "context", "c" -> true;
+                default -> false;
+            };
+        } else if (expression instanceof AccessExpression access) {
+            return variable(access.object());
+        } else if (expression instanceof ArrayAccessExpression array) {
+            return variable(array.array());
+        }
+        return false;
+    }
+
+    private static CallExpression call(final String name, final List<Expression> arguments) {
+        return new CallExpression(new IdentifierExpression(name), arguments);
+    }
+
+    static Value evaluate(final Scope scope, final List<Expression> expressions) {
+        final MoLangControlFlow runtime = new MoLangControlFlow();
+        scope.set(READ, (Function<Object>) (_, arguments) -> {
+            final Value object = arguments.next().eval();
+            final String name = arguments.next().eval().getAsString();
+            if (!(object instanceof ObjectValue binding)) {
+                throw FlowSignal.UNDEFINED;
+            }
+            return requireProperty(binding, name);
+        });
+        scope.set(COALESCE, (Function<Object>) (_, arguments) -> {
+            final Function.Argument left = arguments.next();
+            final Function.Argument right = arguments.next();
+            try {
+                return left.eval();
+            } catch (final FlowSignal signal) {
+                if (signal.kind != FlowKind.UNDEFINED) {
+                    throw signal;
+                }
+                return right.eval();
+            }
+        });
+        scope.set(RETURN, (Function<Object>) (_, arguments) -> {
+            throw new FlowSignal(FlowKind.RETURN, arguments.next().eval());
+        });
+        scope.set(BREAK, (Function<Object>) (_, _) -> {
+            throw FlowSignal.BREAK;
+        });
+        scope.set(CONTINUE, (Function<Object>) (_, _) -> {
+            throw FlowSignal.CONTINUE;
+        });
+        scope.set(LOOP, (Function<Object>) (context, arguments) -> {
+            float remaining = arguments.next().eval().getAsNumber();
+            final Value body = arguments.next().eval();
+            while (remaining > 0F) {
+                if (!runtime.iteration(context, body)) {
+                    break;
+                }
+                // The native VM compares the float remainder with zero and subtracts one.
+                remaining -= 1F;
+            }
+            return NumberValue.zero();
+        });
+        scope.set(FOR_EACH, (Function<Object>) (context, arguments) -> {
+            final AccessExpression target = (AccessExpression) arguments.next().expression();
+            final Value source = arguments.next().eval();
+            final Value body = arguments.next().eval();
+            if (source instanceof ArrayValue array) {
+                for (final Value value : array.values()) {
+                    if (context.eval(target.object()) instanceof MutableObjectBinding binding) {
+                        binding.set(target.property(), value);
+                    }
+                    if (!runtime.iteration(context, body)) {
+                        break;
+                    }
+                }
+            }
+            return NumberValue.zero();
+        });
+        scope.readOnly(true);
+        final ExpressionInterpreter<Void> evaluator = new ExpressionInterpreter<>(null, scope);
+        evaluator.warnOnReflectiveFunctionUsage(false);
+        Value result = NumberValue.zero();
+        try {
+            for (final Expression expression : expressions) {
+                result = expression.visit(evaluator);
+            }
+            return result;
+        } catch (final FlowSignal signal) {
+            return signal.value;
+        }
+    }
+
+    private static Value requireProperty(final ObjectValue object, final String name) {
+        final var property = object.getProperty(name);
+        if (property == null) {
+            throw FlowSignal.UNDEFINED;
+        }
+        return property.value();
+    }
+
+    @SuppressWarnings("unchecked")
+    private boolean iteration(final ExecutionContext<Object> context, final Value body) {
+        // Preserve the host budget across all nested loops and entity contexts.
+        if (this.remaining-- <= 0) {
+            throw FlowSignal.LIMIT;
+        }
+        try {
+            ((Function<Object>) body).evaluate(context);
+            return true;
+        } catch (final FlowSignal signal) {
+            return switch (signal.kind) {
+                case BREAK -> false;
+                case CONTINUE -> true;
+                default -> throw signal;
+            };
+        }
+    }
+
+    private MoLangControlFlow() {
+    }
+
+    private enum FlowKind {
+        RETURN, BREAK, CONTINUE, LIMIT, UNDEFINED
+    }
+
+    private static final class FlowSignal extends RuntimeException {
+
+        private static final FlowSignal BREAK = new FlowSignal(FlowKind.BREAK, NumberValue.zero());
+        private static final FlowSignal CONTINUE = new FlowSignal(FlowKind.CONTINUE, NumberValue.zero());
+        private static final FlowSignal UNDEFINED = new FlowSignal(FlowKind.UNDEFINED, NumberValue.zero());
+        private static final FlowSignal LIMIT = new FlowSignal(FlowKind.LIMIT, NumberValue.zero());
+        private final FlowKind kind;
+        private final Value value;
+
+        private FlowSignal(final FlowKind kind, final Value value) {
+            super(null, null, false, false);
+            this.kind = kind;
+            this.value = value;
+        }
+
+    }
+
+}
