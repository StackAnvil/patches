@@ -0,0 +1,142 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.StringType;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.UUID;
+
+/** Core-evaluated render controllers for the actual Java actor identity. */
+public sealed interface NativeCustomEntityMessage permits NativeCustomEntityMessage.Snapshot, NativeCustomEntityMessage.Remove {
+
+    String CHANNEL = "viabedrock:custom_entity";
+    int MAX_PAYLOAD_BYTES = 1 << 20;
+    int MAX_MODELS = 128;
+    int MAX_MATERIALS = 128;
+    StringType STRING = new StringType(4096);
+    Type<NativeCustomEntityMessage> TYPE = new Type<>(NativeCustomEntityMessage.class) {
+        @Override
+        public NativeCustomEntityMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES
+                    || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native actor message");
+            }
+            final int kind = buffer.readUnsignedByte();
+            final UUID uuid = Types.UUID.read(buffer);
+            final NativeCustomEntityMessage message;
+            if (kind == 0) {
+                final String identifier = STRING.read(buffer);
+                final float scale = buffer.readFloat();
+                final int count = count(buffer, MAX_MODELS);
+                final List<CustomEntity.EvaluatedModel> models = new ArrayList<>(count);
+                for (int i = 0; i < count; i++) {
+                    final String key = STRING.read(buffer);
+                    final String geometry = STRING.read(buffer);
+                    final String texture = STRING.read(buffer);
+                    final int materialCount = count(buffer, MAX_MATERIALS);
+                    final LinkedHashMap<String, String> materials = new LinkedHashMap<>();
+                    for (int j = 0; j < materialCount; j++) {
+                        if (materials.putIfAbsent(STRING.read(buffer), STRING.read(buffer)) != null) {
+                            throw new IllegalArgumentException("Duplicate actor material binding");
+                        }
+                    }
+                    final boolean ignoreLighting = buffer.readBoolean();
+                    final float lightMultiplier = buffer.readFloat();
+                    final BedrockRenderController.UvAnimation uv = buffer.readBoolean()
+                            ? new BedrockRenderController.UvAnimation(STRING.read(buffer), STRING.read(buffer), STRING.read(buffer), STRING.read(buffer)) : null;
+                    models.add(new CustomEntity.EvaluatedModel(key, geometry, texture, materials, ignoreLighting, lightMultiplier, uv));
+                }
+                message = new Snapshot(uuid, identifier, scale, models);
+            } else if (kind == 1) {
+                message = new Remove(uuid);
+            } else {
+                throw new IllegalArgumentException("Unknown native actor message");
+            }
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native actor data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeCustomEntityMessage message) {
+            final int start = buffer.writerIndex();
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(message instanceof Snapshot ? 0 : 1);
+            Types.UUID.write(buffer, message.uuid());
+            if (message instanceof Snapshot snapshot) {
+                if (snapshot.models.size() > MAX_MODELS) {
+                    throw new IllegalArgumentException("Too many native actor models");
+                }
+                STRING.write(buffer, snapshot.identifier);
+                buffer.writeFloat(snapshot.scale);
+                Types.VAR_INT.writePrimitive(buffer, snapshot.models.size());
+                for (CustomEntity.EvaluatedModel model : snapshot.models) {
+                    if (model.materials().size() > MAX_MATERIALS) {
+                        throw new IllegalArgumentException("Too many native actor materials");
+                    }
+                    STRING.write(buffer, model.key());
+                    STRING.write(buffer, model.geometryValue());
+                    STRING.write(buffer, model.textureValue());
+                    Types.VAR_INT.writePrimitive(buffer, model.materials().size());
+                    for (var entry : model.materials().entrySet()) {
+                        STRING.write(buffer, entry.getKey());
+                        STRING.write(buffer, entry.getValue());
+                        checkSize(buffer, start);
+                    }
+                    buffer.writeBoolean(model.ignoreLighting()).writeFloat(model.lightColorMultiplier());
+                    final var uv = model.uvAnimation();
+                    buffer.writeBoolean(uv != null);
+                    if (uv != null) {
+                        STRING.write(buffer, uv.offsetU());
+                        STRING.write(buffer, uv.offsetV());
+                        STRING.write(buffer, uv.scaleU());
+                        STRING.write(buffer, uv.scaleV());
+                    }
+                    checkSize(buffer, start);
+                }
+            }
+            checkSize(buffer, start);
+        }
+
+        private static int count(final ByteBuf buffer, final int maximum) {
+            final int count = Types.VAR_INT.readPrimitive(buffer);
+            if (count < 0 || count > maximum) {
+                throw new IllegalArgumentException("Invalid native actor entry count");
+            }
+            return count;
+        }
+
+        private static void checkSize(final ByteBuf buffer, final int start) {
+            if (buffer.writerIndex() - start > MAX_PAYLOAD_BYTES) {
+                throw new IllegalArgumentException("Native actor message exceeds the payload limit");
+            }
+        }
+    };
+
+    UUID uuid();
+
+    record Snapshot(UUID uuid, String identifier, float scale, List<CustomEntity.EvaluatedModel> models) implements NativeCustomEntityMessage {
+        public Snapshot {
+            models = List.copyOf(models);
+        }
+    }
+
+    record Remove(UUID uuid) implements NativeCustomEntityMessage {
+    }
+
+}
