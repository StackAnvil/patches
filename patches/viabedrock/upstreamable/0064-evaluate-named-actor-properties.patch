+                            case Integer integer -> buffer.writeByte(2).writeInt(integer);
+                            case Long integer -> buffer.writeByte(3).writeLong(integer);
+                            case Float number -> buffer.writeByte(4).writeFloat(number);
+                            case Double number -> buffer.writeByte(5).writeDouble(number);
