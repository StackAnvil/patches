+package net.raphimc.viabedrock.api.util;
+
+/** The native float lookup shared by actor expressions and view bobbing. */
+public final class BedrockTrigonometry {
+
+    private static final float[] SINE = sineTable();
+
+    private BedrockTrigonometry() {
+    }
+
+    public static float sine(final float radians) {
+        return SINE[(int) (radians * 10430.378F) & 65535];
+    }
+
+    public static float cosine(final float radians) {
+        return SINE[(int) (radians * 10430.378F + 16384F) & 65535];
+    }
+
+    private static float[] sineTable() {
+        final float[] values = new float[65536];
+        final float step = (2F * (float) Math.PI) / values.length;
+        for (int index = 0; index < values.length; index++) {
+            values[index] = (float) Math.sin(index * step);
+        }
+        return values;
+    }
+
+}
