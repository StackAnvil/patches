+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.EnumSet;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeShieldBlockingStateTest {
+
+    @Test
+    void retainsRisingEdgesOutsideTheTimerGuardAndSeparatesTheDamageClock() {
+        var state = NativeShieldBlockingState.EMPTY.advance(Set.of(ActorFlags.TRANSITION_BLOCKING), 1, true);
+        state = state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.TRANSITION_BLOCKING), 2, true);
+        assertEquals(0, state.startedTick());
+        state = state.advance(Set.of(ActorFlags.BLOCKING), 3, true);
+        state = state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.TRANSITION_BLOCKING), 4, true);
+        assertEquals(4, state.startedTick());
+        assertEquals(4F, state.bob(true, 4, 0));
+        state = state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.BLOCKED_USING_DAMAGED_SHIELD), 5, true);
+        assertEquals(5, state.damagedTick());
+        assertEquals(1F, state.bob(true, 5, 0.5F));
+        assertSame(state, state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.BLOCKED_USING_DAMAGED_SHIELD), 6, true));
+        assertEquals(3F, state.bob(true, 6, 0.5F));
+        state = state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.TRANSITION_BLOCKING, ActorFlags.BLOCKED_USING_DAMAGED_SHIELD), 7, true);
+        assertEquals(0, state.damagedTick());
+        state = state.advance(Set.of(ActorFlags.BLOCKING, ActorFlags.BLOCKED_USING_DAMAGED_SHIELD), 8, true);
+        assertEquals(0, state.damagedTick());
+        state = state.advance(Set.of(), 9, true);
+        assertEquals(NativeShieldBlockingState.EMPTY, state);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SHIELD_BOB_REFERENCE", matches = ".+")
+    void matchesNativeTimestampBranchesAndShieldBobInstructions() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_SHIELD_BOB_REFERENCE"), "native-shield-bob.json"))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("start_cases")) {
+            final var row = element.getAsJsonObject();
+            final var flags = EnumSet.noneOf(ActorFlags.class);
+            if (row.get("blocking").getAsBoolean()) {
+                flags.add(ActorFlags.BLOCKING);
+            }
+            if (row.get("transition").getAsBoolean()) {
+                flags.add(ActorFlags.TRANSITION_BLOCKING);
+            }
+            final var initial = new NativeShieldBlockingState(Long.parseUnsignedLong(row.get("started").getAsString()), 0, 0,
+                    row.get("previous_transition").getAsBoolean(), false, false);
+            final var actual = initial.advance(flags, Long.parseUnsignedLong(row.get("tick").getAsString()), true);
+            assertEquals(Long.parseUnsignedLong(row.get("result").getAsString()), actual.startedTick());
+            assertEquals(row.get("next_transition").getAsBoolean(), actual.transitioningLastTick());
+        }
+        for (final var element : fixture.getAsJsonArray("damage_cases")) {
+            final var row = element.getAsJsonObject();
+            final var flags = EnumSet.noneOf(ActorFlags.class);
+            for (final var flag : row.getAsJsonArray("flags")) {
+                flags.add(ActorFlags.getByValue(flag.getAsInt()));
+            }
+            final var initial = new NativeShieldBlockingState(0, Long.parseUnsignedLong(row.get("blocked").getAsString()),
+                    Long.parseUnsignedLong(row.get("damaged").getAsString()), false,
+                    row.get("previous_blocked").getAsBoolean(), row.get("previous_damaged").getAsBoolean());
+            final var actual = initial.advance(flags, Long.parseUnsignedLong(row.get("tick").getAsString()), true);
+            assertEquals(Long.parseUnsignedLong(row.get("blocked_result").getAsString()), actual.blockedTick());
+            assertEquals(Long.parseUnsignedLong(row.get("damaged_result").getAsString()), actual.damagedTick());
+            assertEquals(flags.contains(ActorFlags.BLOCKED_USING_SHIELD), actual.blockedLastTick());
+            assertEquals(flags.contains(ActorFlags.BLOCKED_USING_DAMAGED_SHIELD), actual.damagedLastTick());
+        }
+        for (final var element : fixture.getAsJsonArray("bob_cases")) {
+            final var row = element.getAsJsonObject();
+            final long damagedTick = Long.parseUnsignedLong(row.get("damaged").getAsString());
+            final var state = new NativeShieldBlockingState(Long.parseUnsignedLong(row.get("started").getAsString()), 0, damagedTick, false, false, false);
+            final float actual = state.bob(row.get("blocking").getAsBoolean(),
+                    damagedTick + Long.parseUnsignedLong(row.get("elapsed").getAsString()), Float.intBitsToFloat(row.get("alpha_bits").getAsInt()));
+            assertEquals(row.get("result_bits").getAsInt(), Float.floatToRawIntBits(actual));
+        }
+        assertEquals(120, fixture.getAsJsonArray("start_cases").size());
+        assertEquals(1728, fixture.getAsJsonArray("damage_cases").size());
+        assertEquals(2700, fixture.getAsJsonArray("bob_cases").size());
+    }
+
+}
