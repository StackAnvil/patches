+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorEntityTest {
+
+    @Test
+    void snapshotsSparseRetainedInputsAndKeepsTheActorLifetimeStable() {
+        final UUID uuid = UUID.randomUUID();
+        final Entity actor = new Entity(null, 1, 2, "minecraft:pig", 3, uuid, EntityTypes26_3.PIG);
+        actor.retainEntityProperties(Map.of("fixture:mode", "a", "fixture:enabled", true));
+        actor.entityData().put(ActorDataIds.RESERVED_0, new EntityData(ActorDataIds.RESERVED_0.getValue(), EntityDataTypesBedrock.LONG,
+                Long.MIN_VALUE | (1L << ActorFlags.CHARGING.getValue())));
+        actor.entityData().put(ActorDataIds.VARIANT, new EntityData(ActorDataIds.VARIANT.getValue(), EntityDataTypesBedrock.INT, 17));
+        actor.entityData().put(ActorDataIds.DATA_SPELL_CASTING_COLOR,
+                new EntityData(ActorDataIds.DATA_SPELL_CASTING_COLOR.getValue(), EntityDataTypesBedrock.INT, 0x89123456));
+        actor.entityData().put(ActorDataIds.NAME,
+                new EntityData(ActorDataIds.NAME.getValue(), EntityDataTypesBedrock.STRING, "§aDinnerbone"));
+        final var before = actor.nativeActorSnapshot();
+        actor.retainEntityProperties(Map.of("fixture:mode", "b"));
+        final var after = actor.nativeActorSnapshot();
+        assertEquals(before.lifetime(), after.lifetime());
+        assertEquals("a", before.properties().get("fixture:mode"));
+        assertEquals("b", after.properties().get("fixture:mode"));
+        assertEquals(true, after.properties().get("fixture:enabled"));
+        assertEquals(17, after.variant());
+        assertEquals(0x89123456, after.spellColor());
+        assertTrue(after.flags().contains(ActorFlags.CHARGING));
+        final Entity replacement = new Entity(null, 1, 2, "minecraft:pig", 3, uuid, EntityTypes26_3.PIG);
+        assertNotEquals(before.lifetime(), replacement.nativeActorSnapshot().lifetime());
+        actor.entityData().put(ActorDataIds.DATA_SPELL_CASTING_COLOR,
+                new EntityData(ActorDataIds.DATA_SPELL_CASTING_COLOR.getValue(), EntityDataTypesBedrock.FLOAT, 42F));
+        assertNull(actor.nativeActorSnapshot().spellColor());
+        assertEquals(1F, after.scale());
+        assertEquals("§aDinnerbone", after.name());
+        actor.entityData().put(ActorDataIds.NAME,
+                new EntityData(ActorDataIds.NAME.getValue(), EntityDataTypesBedrock.STRING, ""));
+        assertEquals("", actor.nativeActorSnapshot().name());
+        actor.entityData().put(ActorDataIds.NAME,
+                new EntityData(ActorDataIds.NAME.getValue(), EntityDataTypesBedrock.INT, 17));
+        assertEquals("", actor.nativeActorSnapshot().name());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/NativeActorMessageTest.java b/src/test/java/net/raphimc/viabedrock/api/model/NativeActorMessageTest.java
new file mode 100644
index 000000000..6f5f63a51
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/NativeActorMessageTest.java
@@ -0,0 +1,126 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorMessageTest {
+
+    @Test
+    void retainsAllInputTypesIdentityAndOptionalColorWithoutCoercion() {
+        final Map<String, Object> properties = new HashMap<>(Map.of(
+                "enum", "MixedCase", "bool", true, "int", Integer.MIN_VALUE, "long", Long.MIN_VALUE,
+                "float", -0F, "double", .125D));
+        final var snapshot = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), true,
+                Long.MIN_VALUE, "fixture:player", "§aDinnerbone", -2F, Set.of(ActorFlags.CHARGING, ActorFlags.USINGITEM),
+                -17, 43, 0x89ABCDEF, properties);
+        properties.clear();
+        final var decoded = (NativeActorMessage.Snapshot) roundTrip(snapshot);
+        assertEquals(snapshot, decoded);
+        assertInstanceOf(Float.class, decoded.properties().get("float"));
+        assertEquals(Float.floatToRawIntBits(-0F), Float.floatToRawIntBits((Float) decoded.properties().get("float")));
+        assertThrows(UnsupportedOperationException.class, () -> decoded.properties().clear());
+        assertThrows(UnsupportedOperationException.class, () -> decoded.flags().clear());
+        final var absent = new NativeActorMessage.Snapshot(snapshot.uuid(), snapshot.lifetime(), false, 2,
+                "fixture:actor", "", 0F, Set.of(), 0, 0, null, Map.of());
+        assertEquals(absent, roundTrip(absent));
+        assertEquals(new NativeActorMessage.Remove(snapshot.uuid(), snapshot.lifetime(), true),
+                roundTrip(new NativeActorMessage.Remove(snapshot.uuid(), snapshot.lifetime(), true)));
+    }
+
+    @Test
+    void rejectsUnknownKindsVersionsTruncationAndTrailingData() {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeActorMessage.TYPE.write(buffer, new NativeActorMessage.Remove(UUID.randomUUID(), UUID.randomUUID(), false));
+            final byte[] valid = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, valid);
+            buffer.setByte(0, 3);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).setByte(3, 99);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(valid).writerIndex(valid.length - 1);
+            assertThrows(IndexOutOfBoundsException.class, () -> NativeActorMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsDuplicatePropertiesAndUnknownPropertyTypes() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var snapshot = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 1,
+                    "fixture:actor", "", 1F, Set.of(), 0, 0, null, Map.of());
+            for (int tag : new int[]{2, 99}) {
+                buffer.clear();
+                NativeActorMessage.TYPE.write(buffer, snapshot);
+                buffer.writerIndex(buffer.writerIndex() - 1);
+                Types.VAR_INT.writePrimitive(buffer, 2);
+                for (int i = 0; i < 2; i++) {
+                    Types.STRING.write(buffer, "property");
+                    buffer.writeByte(tag).writeInt(i);
+                }
+                assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void boundsPropertyCountsBytesAndMutableValues() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final Map<String, Object> properties = new HashMap<>();
+            for (int i = 0; i <= NativeActorMessage.MAX_PROPERTIES; i++) {
+                properties.put("key" + i, 1);
+            }
+            final var tooMany = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 1,
+                    "fixture:actor", "", 1F, Set.of(), 0, 0, null, properties);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.write(buffer, tooMany));
+            properties.clear();
+            for (int i = 0; i < 300; i++) {
+                properties.put("key" + i, "x".repeat(4096));
+            }
+            final var tooLarge = new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 1,
+                    "fixture:actor", "", 1F, Set.of(), 0, 0, null, properties);
+            buffer.clear();
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.write(buffer, tooLarge));
+            buffer.clear().writeZero(NativeActorMessage.MAX_PAYLOAD_BYTES + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorMessage.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 1,
+                    "fixture:actor", "", 1F, Set.of(), 0, 0, null, Map.of("mutable", new int[]{1})));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static NativeActorMessage roundTrip(final NativeActorMessage message) {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeActorMessage.TYPE.write(buffer, message);
+            return NativeActorMessage.TYPE.read(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
