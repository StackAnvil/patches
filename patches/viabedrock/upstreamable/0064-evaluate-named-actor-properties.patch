+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeActorBoundsMessageTest {
+
+    @Test
+    void retainsIndependentDimensionsAndRejectsInvalidFraming() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (Float width : new Float[]{null, 0F, .6F, Float.NaN}) {
+                final var message = new NativeActorBoundsMessage(UUID.randomUUID(), UUID.randomUUID(), true, width, 2.1F);
+                buffer.clear();
+                NativeActorBoundsMessage.TYPE.write(buffer, message);
+                assertEquals(message, NativeActorBoundsMessage.TYPE.read(buffer));
+                buffer.readerIndex(0).writeByte(0);
+                assertThrows(IllegalArgumentException.class, () -> NativeActorBoundsMessage.TYPE.read(buffer));
+                buffer.clear();
+                NativeActorBoundsMessage.TYPE.write(buffer, message);
+                buffer.writerIndex(buffer.writerIndex() - 1);
+                assertThrows(IndexOutOfBoundsException.class, () -> NativeActorBoundsMessage.TYPE.read(buffer));
+            }
+            buffer.clear().writeZero(NativeActorBoundsMessage.MAX_PAYLOAD_BYTES + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorBoundsMessage.TYPE.read(buffer));
+            buffer.clear();
+            NativeActorBoundsMessage.TYPE.write(buffer, new NativeActorBoundsMessage(UUID.randomUUID(), UUID.randomUUID(), false, null, null));
+            buffer.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeActorBoundsMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+        assertEquals(1.2F, NativeActorBoundsMessage.scaledDimension(.6F, 2));
+        assertEquals(.005F, NativeActorBoundsMessage.scaledDimension(0F, 0));
+        for (Float value : new Float[]{null, -1F, Float.NaN, Float.POSITIVE_INFINITY, Float.MAX_VALUE}) {
+            assertThrows(IllegalArgumentException.class, () -> NativeActorBoundsMessage.scaledDimension(value, 2));
+        }
+    }
+
+    @Test
+    void scopesBoundsToActorLifetimeAndLocalIdentity() {
+        final var actors = new NativeActorStates();
+        final UUID nativeId = UUID.randomUUID();
+        final UUID localId = UUID.randomUUID();
+        final UUID first = UUID.randomUUID();
+        final UUID second = UUID.randomUUID();
+        final var bounds = new NativeActorBoundsMessage(nativeId, first, true, .6F, 2.1F);
+        actors.apply(bounds, localId);
+        assertNull(actors.bounds(localId));
+        actors.apply(actor(nativeId, first), localId);
+        actors.apply(bounds, localId);
+        assertSame(bounds, actors.bounds(localId));
+        actors.apply(actor(nativeId, second), localId);
+        assertNull(actors.bounds(localId));
+        actors.apply(bounds, localId);
+        assertNull(actors.bounds(localId));
+        final var replacement = new NativeActorBoundsMessage(nativeId, second, true, 1F, null);
+        actors.apply(replacement, localId);
+        actors.apply(new NativeActorMessage.Remove(nativeId, first, true), localId);
+        assertSame(replacement, actors.bounds(localId));
+        actors.apply(new NativeActorMessage.Remove(nativeId, second, true), localId);
+        assertNull(actors.bounds(localId));
+        actors.apply(actor(nativeId, second), localId);
+        actors.apply(replacement, localId);
+        actors.clear();
+        assertNull(actors.bounds(localId));
+    }
+
+    private static NativeActorMessage.Snapshot actor(final UUID uuid, final UUID lifetime) {
+        return new NativeActorMessage.Snapshot(uuid, lifetime, true, 10, "minecraft:npc", "", 1, Set.of(), 0, 0, null, Map.of(), -10L);
+    }
+
