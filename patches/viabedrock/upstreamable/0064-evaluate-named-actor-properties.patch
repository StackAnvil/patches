+                        || value instanceof Long || value instanceof Float || value instanceof Double)) {
+                    throw new IllegalArgumentException("Unsupported native actor property type");
+                }
+            }
+        }
+    }
+
+    record Remove(UUID uuid, UUID lifetime, boolean localPlayer) implements NativeActorMessage {
+    }
+
+}
