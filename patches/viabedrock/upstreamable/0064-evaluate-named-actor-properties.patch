+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static net.raphimc.viabedrock.api.model.NativeHandItemState.Replacement.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeHandItemStateTest {
+
+    @Test
+    void lowersThenCopiesTheReplacementAndRetainsThePreviousHeight() {
+        final var first = NativeHandItemState.advance(1F, ANIMATE);
+        assertEquals(1F, first.previousHeight());
+        assertEquals(0.6F, first.height());
+        assertFalse(first.replaceItem());
+        final var second = NativeHandItemState.advance(first.height(), ANIMATE);
+        assertFalse(second.replaceItem());
+        final var third = NativeHandItemState.advance(second.height(), ANIMATE);
+        assertTrue(third.replaceItem());
+        final var raised = NativeHandItemState.advance(third.height(), RETAIN);
+        assertEquals(third.height(), raised.previousHeight());
+        assertEquals(0.4F, raised.height());
+        assertFalse(raised.replaceItem());
+    }
+
+    @Test
+    void usesTheInclusiveCopyBoundaryAndImmediateUpdateRegardlessOfHeight() {
+        assertTrue(NativeHandItemState.replaces(0.1F, RETAIN));
+        assertTrue(NativeHandItemState.replaces(Math.nextDown(0.1F), ANIMATE));
+        assertFalse(NativeHandItemState.replaces(Math.nextUp(0.1F), ANIMATE));
+        assertFalse(NativeHandItemState.replaces(Float.NaN, ANIMATE));
+        assertTrue(NativeHandItemState.replaces(Float.NaN, UPDATE));
+        assertTrue(NativeHandItemState.advance(1F, UPDATE).replaceItem());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_HAND_RETENTION_REFERENCE", matches = ".+")
+    void matchesNativeHeightAndCopyInstructions() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_HAND_RETENTION_REFERENCE"), "native-hand-retention.json"))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            for (final String hand : new String[]{"main", "off"}) {
+                final float initial = Float.intBitsToFloat(row.get(hand + "_bits").getAsInt());
+                final var result = NativeHandItemState.advance(initial, NativeHandItemState.Replacement.values()[row.get(hand + "_change").getAsInt()]);
+                assertEquals(row.get(hand + "_bits").getAsInt(), Float.floatToRawIntBits(result.previousHeight()));
+                assertEquals(row.get(hand + "_result").getAsInt(), Float.floatToRawIntBits(result.height()));
+                assertEquals(row.get("copy_" + hand).getAsBoolean(), result.replaceItem());
+            }
+        }
+        for (final var element : fixture.getAsJsonArray("threshold_cases")) {
+            final var row = element.getAsJsonObject();
+            final boolean result = NativeHandItemState.replaces(Float.intBitsToFloat(row.get("height_bits").getAsInt()),
+                    NativeHandItemState.Replacement.values()[row.get("change").getAsInt()]);
+            assertEquals(row.get("copy_main").getAsBoolean(), result);
+            assertEquals(row.get("copy_off").getAsBoolean(), result);
+        }
+        assertEquals(2304, fixture.getAsJsonArray("cases").size());
+        assertEquals(24, fixture.getAsJsonArray("threshold_cases").size());
+    }
+
+}
