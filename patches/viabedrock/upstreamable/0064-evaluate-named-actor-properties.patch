+            private static int count(final ByteBuf buffer, final int maximum) {
+                final int count = Types.VAR_INT.readPrimitive(buffer);
+                if (count < 0 || count > maximum) {
+                    throw new IllegalArgumentException("Invalid native actor state count");
+                }
+                return count;
+            }
+
+            private static void checkSize(final ByteBuf buffer, final int start) {
+                if (buffer.writerIndex() - start > MAX_PAYLOAD_BYTES) {
+                    throw new IllegalArgumentException("Native actor state exceeds the payload limit");
+                }
+            }
+        };
+    }
