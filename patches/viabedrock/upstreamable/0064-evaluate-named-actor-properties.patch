+    }
+
+    @Test
+    void rejectsInvalidCountsBeforeAllocatingModels() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int count : new int[]{-1, NativeCustomEntityMessage.MAX_MODELS + 1}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                buffer.writeByte(0);
+                Types.UUID.write(buffer, UUID.randomUUID());
+                Types.STRING.write(buffer, "fixture:actor");
+                buffer.writeFloat(1F);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void boundsEncodedModelsAndTotalPayloadBytes() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var model = new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", Collections.emptyMap(), false, 1F, null);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.write(buffer,
+                    new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F,
+                            Collections.nCopies(NativeCustomEntityMessage.MAX_MODELS + 1, model))));
+            buffer.clear();
+            final var materials = new LinkedHashMap<String, String>();
+            for (int i = 0; i < NativeCustomEntityMessage.MAX_MATERIALS; i++) {
+                materials.put("bone" + i, "x".repeat(4096));
+            }
+            final var largeModel = new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", materials, false, 1F, null);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.write(buffer,
+                    new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F, List.of(largeModel, largeModel))));
+            buffer.clear().writeZero(NativeCustomEntityMessage.MAX_PAYLOAD_BYTES + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsDuplicateMaterialBindingsAndTruncatedModels() {
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(0);
+            Types.UUID.write(buffer, UUID.randomUUID());
+            Types.STRING.write(buffer, "fixture:actor");
+            buffer.writeFloat(1F);
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.STRING.write(buffer, "body");
+            Types.STRING.write(buffer, "geometry.body");
+            Types.STRING.write(buffer, "textures/body");
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            for (int i = 0; i < 2; i++) {
+                Types.STRING.write(buffer, "*");
+                Types.STRING.write(buffer, "material" + i);
+            }
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            buffer.clear();
+            NativeCustomEntityMessage.TYPE.write(buffer, new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F,
+                    List.of(new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", Collections.emptyMap(), false, 1F, null))));
+            buffer.writerIndex(buffer.writerIndex() - 1);
+            assertThrows(IndexOutOfBoundsException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static NativeCustomEntityMessage roundTrip(final NativeCustomEntityMessage message) {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeCustomEntityMessage.TYPE.write(buffer, message);
+            return NativeCustomEntityMessage.TYPE.read(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
