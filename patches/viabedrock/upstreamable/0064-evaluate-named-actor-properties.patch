+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+/** Client-thread registry with native lifetime checks and local Java identity resolution. */
+public final class NativeActorStates {
+
+    private final Map<UUID, NativeActorMessage.Snapshot> actors = new HashMap<>();
+    private final Map<Long, UUID> runtimeIds = new HashMap<>();
+    private final Map<UUID, NativeShieldBlockingState> blocking = new HashMap<>();
+    private long tick;
+
+    public void apply(final NativeActorMessage message, final UUID localPlayer) {
+        final UUID uuid = message.localPlayer() ? java.util.Objects.requireNonNull(localPlayer) : message.uuid();
+        if (message instanceof NativeActorMessage.Snapshot snapshot) {
+            final var previous = this.actors.put(uuid, snapshot);
+            if (previous != null) {
+                this.runtimeIds.remove(previous.runtimeId(), uuid);
+                if (!previous.lifetime().equals(snapshot.lifetime()) || previous.localPlayer() != snapshot.localPlayer()) {
+                    this.blocking.remove(uuid);
+                }
+            }
+            if ("minecraft:player".equals(snapshot.identifier())) {
+                this.blocking.putIfAbsent(uuid, NativeShieldBlockingState.EMPTY);
+            } else {
+                this.blocking.remove(uuid);
+            }
+            final UUID previousUuid = this.runtimeIds.put(snapshot.runtimeId(), uuid);
+            if (previousUuid != null && !previousUuid.equals(uuid)) {
+                this.actors.remove(previousUuid);
+                this.blocking.remove(previousUuid);
+            }
+        } else if (message instanceof NativeActorMessage.Remove remove) {
+            final var current = this.actors.get(uuid);
+            if (current != null && current.lifetime().equals(remove.lifetime())) {
+                this.actors.remove(uuid);
+                this.blocking.remove(uuid);
+                this.runtimeIds.remove(current.runtimeId(), uuid);
+            }
+        }
+    }
+
+    public NativeActorMessage.Snapshot get(final UUID uuid) {
+        return this.actors.get(uuid);
+    }
+
+    public NativeActorMessage.Snapshot getByRuntimeId(final long runtimeId) {
+        return this.actors.get(this.runtimeIds.get(runtimeId));
+    }
+
+    public void tick() {
+        this.tick++;
+        for (var entry : this.blocking.entrySet()) {
+            final var actor = this.actors.get(entry.getKey());
+            entry.setValue(entry.getValue().advance(actor.flags(), this.tick, actor.localPlayer()));
+        }
+    }
+
+    public float shieldBlockingBob(final UUID uuid, final float frameAlpha) {
+        final var state = this.blocking.get(uuid);
+        final var actor = this.actors.get(uuid);
+        return state == null || actor == null ? 0F : state.bob(actor.flags().contains(ActorFlags.BLOCKING), this.tick, frameAlpha);
+    }
+
+    public void clear() {
+        this.actors.clear();
+        this.runtimeIds.clear();
+        this.blocking.clear();
+        this.tick = 0;
+    }
+
+}
