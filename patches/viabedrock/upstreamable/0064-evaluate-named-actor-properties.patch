+package net.raphimc.viabedrock.api.model.entity;
+
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.DataItemType;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityScaleTest {
+
+    private Field dataTypes;
+    private Field flagQueries;
+    private Object previousDataTypes;
+    private Object previousFlagQueries;
+
+    @BeforeEach
+    void installMetadataTypes() throws Exception {
+        this.dataTypes = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("bedrockEntityDataTypes");
+        this.dataTypes.setAccessible(true);
+        this.previousDataTypes = this.dataTypes.get(BedrockProtocol.MAPPINGS);
+        this.dataTypes.set(BedrockProtocol.MAPPINGS, Map.of(ActorDataIds.RESERVED_038, DataItemType.Float, ActorDataIds.VARIANT, DataItemType.Int));
+        this.flagQueries = BedrockProtocol.MAPPINGS.getClass().getDeclaredField("bedrockEntityFlagMoLangQueries");
+        this.flagQueries.setAccessible(true);
+        this.previousFlagQueries = this.flagQueries.get(BedrockProtocol.MAPPINGS);
+        this.flagQueries.set(BedrockProtocol.MAPPINGS, Map.of());
+    }
+
+    @AfterEach
+    void restoreMappings() throws Exception {
+        this.dataTypes.set(BedrockProtocol.MAPPINGS, this.previousDataTypes);
+        this.flagQueries.set(BedrockProtocol.MAPPINGS, this.previousFlagQueries);
+    }
+
+    @Test
+    void decodesNativeFloatScaleAndRetainsItAcrossSparseUpdates() throws Exception {
+        final Actor actor = actor(false);
+        assertEquals(1F, actor.scale());
+        for (float scale : new float[]{1.7F, 5F, 0F, -2F}) {
+            final var wire = Unpooled.buffer();
+            try {
+                BedrockTypes.ENTITY_DATA_ARRAY.write(wire, new EntityData[]{new EntityData(38, EntityDataTypesBedrock.FLOAT, scale)});
+                actor.updateEntityData(BedrockTypes.ENTITY_DATA_ARRAY.read(wire), new ArrayList<>());
+            } finally {
+                wire.release();
+            }
+            assertEquals(scale, actor.scale());
+            actor.updateEntityData(new EntityData[]{new EntityData(2, EntityDataTypesBedrock.INT, 1)}, new ArrayList<>());
+            assertEquals(scale, actor.scale());
+        }
+    }
+
+    @Test
+    void refreshesScaleEvenWhenTheSelectedModelDoesNotChange() throws Exception {
+        final Actor actor = actor(false);
+        actor.updateEntityData(new EntityData[0], new ArrayList<>());
+        assertTrue(actor.changed);
+        actor.updateEntityData(new EntityData[]{new EntityData(38, EntityDataTypesBedrock.FLOAT, 5F)}, new ArrayList<>());
+        assertTrue(actor.changed);
+        actor.updateEntityData(new EntityData[]{new EntityData(2, EntityDataTypesBedrock.INT, 1)}, new ArrayList<>());
+        assertFalse(actor.changed);
+        actor.updateEntityData(new EntityData[]{new EntityData(38, EntityDataTypesBedrock.FLOAT, 1.7F)}, new ArrayList<>());
+        assertTrue(actor.changed);
+    }
+
+    @Test
+    void exposesNativeModelScaleToControllerConditions() throws Exception {
+        final Actor actor = actor(true);
+        actor.updateEntityData(new EntityData[0], new ArrayList<>());
+        assertEquals(0, actor.modelCount());
+        actor.updateEntityData(new EntityData[]{new EntityData(38, EntityDataTypesBedrock.FLOAT, 5F)}, new ArrayList<>());
+        assertEquals(1, actor.modelCount());
+        actor.updateEntityData(new EntityData[]{new EntityData(38, EntityDataTypesBedrock.FLOAT, 1.7F)}, new ArrayList<>());
+        assertEquals(0, actor.modelCount());
+    }
+
+    private static Actor actor(final boolean conditional) {
+        final InMemoryContent content = new InMemoryContent();
+        content.putString("manifest.json", """
+            {"format_version":2,"header":{"uuid":"f73995bf-7f9f-420b-8554-92a3e059ea66","version":[1,0,0],"name":"Scale fixture"}}
+            """);
+        content.putString("entity/actor.json", """
+            {"format_version":"1.10.0","minecraft:client_entity":{"description":{
+              "identifier":"example:actor","materials":{"default":"entity_alphatest"},
+              "geometry":{"default":"geometry.actor"},"textures":{"default":"textures/actor"},
+              "render_controllers":[%s]}}}
+            """.formatted(conditional ? "{\"controller.render.actor\":\"query.model_scale > 2\"}" : "\"controller.render.actor\""));
+        content.putString("render_controllers/actor.json", """
+            {"format_version":"1.10.0","render_controllers":{"controller.render.actor":{
+              "geometry":"Geometry.default","textures":["Texture.default"],"materials":[{"*":"Material.default"}]}}}
+            """);
+        final ResourcePackStorage packs = new ResourcePackStorage(List.of(new ResourcePack(content)));
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+            new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> {
+                if (method.getName().equals("get") && arguments[0] == ResourcePackStorage.class) {
+                    return packs;
+                }
+                throw new AssertionError("Unexpected connection operation: " + method.getName());
+            });
+        return new Actor(user, packs);
+    }
+
+    private static final class Actor extends CustomEntity {
+
+        private boolean changed;
+
+        private Actor(final UserConnection user, final ResourcePackStorage packs) {
+            super(user, 1, 2, "example:actor", 3, packs.getEntities().get("example:actor"));
+        }
+
+        @Override
+        protected boolean translateEntityData(final ActorDataIds id, final EntityData data, final List<EntityData> javaData) {
+            return true;
+        }
+
+        @Override
+        protected void onEntityDataChanged() {
+            try {
+                final Method evaluate = CustomEntity.class.getDeclaredMethod("evaluateRenderControllerChange");
+                evaluate.setAccessible(true);
+                this.changed = (boolean) evaluate.invoke(this);
+            } catch (final ReflectiveOperationException e) {
+                throw new AssertionError(e);
+            }
+        }
+
+        private int modelCount() throws Exception {
+            final Field models = CustomEntity.class.getDeclaredField("models");
+            models.setAccessible(true);
+            return ((List<?>) models.get(this)).size();
+        }
+
+    }
+
+}
