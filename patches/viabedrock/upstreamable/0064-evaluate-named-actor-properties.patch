+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.StringType;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.TreeMap;
+
+/** Immutable native inputs, independent of frontend translation objects. */
+public sealed interface NativeActorMessage permits NativeActorMessage.Snapshot, NativeActorMessage.Remove {
+
+    String CHANNEL = "viabedrock:actor_state_v2";
+    String CURRENT_CHANNEL = "viabedrock:actor_state_v3";
+    int MAX_PAYLOAD_BYTES = 1 << 20;
+    int MAX_PROPERTIES = 4096;
+    StringType STRING = new StringType(4096);
+    Type<NativeActorMessage> TYPE = codec(2);
+    Type<NativeActorMessage> CURRENT_TYPE = codec(3);
+
+    private static Type<NativeActorMessage> codec(final int revision) {
+        return new Type<>(NativeActorMessage.class) {
+            @Override
+            public NativeActorMessage read(final ByteBuf buffer) {
+                if (buffer.readableBytes() > MAX_PAYLOAD_BYTES
+                        || Types.VAR_INT.readPrimitive(buffer) != revision
+                        || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                    throw new IllegalArgumentException("Unsupported native actor state");
+                }
+                final int kind = buffer.readUnsignedByte();
+                final UUID uuid = Types.UUID.read(buffer);
+                final UUID lifetime = Types.UUID.read(buffer);
+                final boolean local = buffer.readBoolean();
+                final NativeActorMessage message;
+                if (kind == 0) {
+                    final long runtimeId = buffer.readLong();
+                    final Long uniqueId = revision == 3 ? buffer.readLong() : null;
+                    final String identifier = STRING.read(buffer);
+                    final String actorName = STRING.read(buffer);
+                    final float scale = buffer.readFloat();
+                    final int variant = buffer.readInt();
+                    final int markVariant = buffer.readInt();
+                    final Integer spellColor = buffer.readBoolean() ? buffer.readInt() : null;
+                    final Set<ActorFlags> flags = new HashSet<>();
+                    final int flagCount = count(buffer, ActorFlags.values().length);
+                    for (int i = 0; i < flagCount; i++) {
+                        final ActorFlags flag = ActorFlags.getByValue(Types.VAR_INT.readPrimitive(buffer));
+                        if (flag == null || !flags.add(flag)) {
+                            throw new IllegalArgumentException("Invalid native actor flag");
+                        }
+                    }
+                    final Map<String, Object> properties = new HashMap<>();
+                    final int propertyCount = count(buffer, MAX_PROPERTIES);
+                    for (int i = 0; i < propertyCount; i++) {
+                        final String name = STRING.read(buffer);
+                        final Object value = switch (buffer.readUnsignedByte()) {
+                            case 0 -> STRING.read(buffer);
+                            case 1 -> buffer.readBoolean();
+                            case 2 -> buffer.readInt();
+                            case 3 -> buffer.readLong();
+                            case 4 -> buffer.readFloat();
+                            case 5 -> buffer.readDouble();
+                            default -> throw new IllegalArgumentException("Unknown native actor property type");
+                        };
+                        if (properties.putIfAbsent(name, value) != null) {
+                            throw new IllegalArgumentException("Duplicate native actor property");
+                        }
+                    }
+                    message = new Snapshot(uuid, lifetime, local, runtimeId, identifier, actorName, scale, flags, variant, markVariant, spellColor, properties, uniqueId);
+                } else if (kind == 1) {
+                    message = new Remove(uuid, lifetime, local);
+                } else {
+                    throw new IllegalArgumentException("Unknown native actor state message");
+                }
+                if (buffer.isReadable()) {
+                    throw new IllegalArgumentException("Trailing native actor state data");
+                }
+                return message;
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final NativeActorMessage message) {
+                if (revision == 3 && message instanceof Snapshot snapshot && snapshot.uniqueId == null) {
+                    throw new IllegalArgumentException("Missing native actor unique ID");
+                }
+                final int start = buffer.writerIndex();
+                Types.VAR_INT.writePrimitive(buffer, revision);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                buffer.writeByte(message instanceof Snapshot ? 0 : 1);
+                Types.UUID.write(buffer, message.uuid());
+                Types.UUID.write(buffer, message.lifetime());
+                buffer.writeBoolean(message.localPlayer());
+                if (message instanceof Snapshot snapshot) {
+                    buffer.writeLong(snapshot.runtimeId);
+                    if (revision == 3) {
+                        buffer.writeLong(snapshot.uniqueId);
+                    }
+                    STRING.write(buffer, snapshot.identifier);
+                    STRING.write(buffer, snapshot.name);
+                    buffer.writeFloat(snapshot.scale).writeInt(snapshot.variant).writeInt(snapshot.markVariant);
+                    buffer.writeBoolean(snapshot.spellColor != null);
+                    if (snapshot.spellColor != null) {
+                        buffer.writeInt(snapshot.spellColor);
+                    }
+                    Types.VAR_INT.writePrimitive(buffer, snapshot.flags.size());
+                    for (ActorFlags flag : snapshot.flags.stream().sorted(java.util.Comparator.comparingInt(ActorFlags::getValue)).toList()) {
+                        Types.VAR_INT.writePrimitive(buffer, flag.getValue());
+                    }
+                    if (snapshot.properties.size() > MAX_PROPERTIES) {
