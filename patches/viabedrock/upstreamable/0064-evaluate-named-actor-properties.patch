+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+import java.util.Set;
+
+/** Player blocking timestamps sampled once per simulation tick. */
+public record NativeShieldBlockingState(long startedTick, long blockedTick, long damagedTick,
+                                       boolean transitioningLastTick, boolean blockedLastTick, boolean damagedLastTick) {
+
+    public static final NativeShieldBlockingState EMPTY = new NativeShieldBlockingState(0, 0, 0, false, false, false);
+
+    public NativeShieldBlockingState advance(final Set<ActorFlags> flags, final long tick, final boolean localPlayer) {
+        final boolean blocking = flags.contains(ActorFlags.BLOCKING);
+        final boolean transitioning = flags.contains(ActorFlags.TRANSITION_BLOCKING);
+        final boolean blocked = flags.contains(ActorFlags.BLOCKED_USING_SHIELD);
+        final boolean damaged = flags.contains(ActorFlags.BLOCKED_USING_DAMAGED_SHIELD);
+        final long startedTick = !localPlayer || !blocking ? 0
+                : transitioning && !this.transitioningLastTick ? tick : this.startedTick;
+        final long blockedTick = !blocking || transitioning ? 0
+                : blocked && !this.blockedLastTick ? tick : this.blockedTick;
+        final long damagedTick = !blocking || transitioning ? 0
+                : damaged && !this.damagedLastTick ? tick : this.damagedTick;
+        if (startedTick == this.startedTick && blockedTick == this.blockedTick && damagedTick == this.damagedTick
+                && transitioning == this.transitioningLastTick && blocked == this.blockedLastTick && damaged == this.damagedLastTick) {
+            return this;
+        }
+        return new NativeShieldBlockingState(startedTick, blockedTick, damagedTick, transitioning, blocked, damaged);
+    }
+
+    public float bob(final boolean blocking, final long tick, final float frameAlpha) {
+        if (!blocking || this.startedTick <= 0) {
+            return 0F;
+        }
+        final long elapsed = tick - this.damagedTick;
+        final float unsignedElapsed = elapsed >= 0 ? (float) elapsed : (float) ((elapsed >>> 1) | (elapsed & 1)) * 2F;
+        return Math.max(0F, Math.min(1F, (frameAlpha + unsignedElapsed) * 0.5F)) * 4F;
+    }
+
+}
