+package net.raphimc.viabedrock.api.model.entity;
+
+import java.util.List;
+import org.cube.converter.parser.bedrock.controller.BedrockControllerParser;
+import org.junit.jupiter.api.Test;
+import team.unnamed.mocha.runtime.Scope;
+import team.unnamed.mocha.runtime.value.MutableObjectBinding;
+import team.unnamed.mocha.runtime.value.Value;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class CustomEntityMaterialSelectionTest {
+
+    @Test
+    void resolvesNamedMaterialsAndArraySelectionsWithoutLosingBoneOverrideOrder() throws Exception {
+        final var scope = Scope.create();
+        final var material = new MutableObjectBinding();
+        material.set("base", Value.of("entity_alphatest"));
+        material.set("glow", Value.of("entity_emissive_alpha"));
+        scope.set("material", material);
+        final var query = new MutableObjectBinding();
+        query.set("variant", Value.of(1));
+        scope.set("query", query);
+        final var controller = BedrockControllerParser.parse("""
+            {"render_controllers":{"controller.render.actor":{
+                "materials":[{"*":"Material.base"},{"Light*":"Array.materials[query.variant]"}],
+                "arrays":{"materials":{"Array.materials":["Material.base","Material.glow"]}}
+            }}}
+            """).get(0);
+        final var selected = CustomEntity.evaluateMaterials(scope, controller);
+        assertEquals(List.of("*", "Light*"), List.copyOf(selected.keySet()));
+        assertEquals("entity_alphatest", selected.get("*"));
+        assertEquals("entity_emissive_alpha", selected.get("Light*"));
+        assertThrows(UnsupportedOperationException.class, () -> selected.put("other", "entity"));
+        final var model = new CustomEntity.EvaluatedModel("actor", "geometry", "texture", selected, true, 0.7F);
+        assertTrue(model.ignoreLighting());
+        assertEquals(0.7F, model.lightColorMultiplier());
+        assertNotEquals(model, new CustomEntity.EvaluatedModel("actor", "geometry", "texture", selected, false, 0.7F));
+    }
+
+}
