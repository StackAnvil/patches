+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeCustomEntityMessageTest {
+
+    @Test
+    void preservesModelOrderMaterialOrderUvExpressionsAndSignedScale() {
+        final var materials = new LinkedHashMap<String, String>();
+        materials.put("*", "entity_alphatest");
+        materials.put("wing*", "entity_emissive_alpha");
+        final var models = new ArrayList<CustomEntity.EvaluatedModel>();
+        models.add(new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", materials,
+                true, .625F, new BedrockRenderController.UvAnimation("q.life_time", "-0.25", "2", "v.scale")));
+        models.add(new CustomEntity.EvaluatedModel("overlay", "geometry.overlay", "textures/overlay", materials,
+                false, 1F, null));
+        final var snapshot = new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", -2F, models);
+        models.clear();
+        materials.clear();
+        final var decoded = (NativeCustomEntityMessage.Snapshot) roundTrip(snapshot);
+        assertEquals(snapshot, decoded);
+        assertEquals(List.of("*", "wing*"), List.copyOf(decoded.models().getFirst().materials().keySet()));
+        assertThrows(UnsupportedOperationException.class, () -> decoded.models().clear());
+        assertThrows(UnsupportedOperationException.class, () -> decoded.models().getFirst().materials().clear());
+    }
+
+    @Test
+    void distinguishesHiddenModelsFromRemovalAndPreservesNegativeZero() {
+        final UUID uuid = UUID.randomUUID();
+        final var hidden = new NativeCustomEntityMessage.Snapshot(uuid, "fixture:actor", -0F, List.of());
+        assertEquals(hidden, roundTrip(hidden));
+        assertEquals(Float.floatToRawIntBits(-0F), Float.floatToRawIntBits(((NativeCustomEntityMessage.Snapshot) roundTrip(hidden)).scale()));
+        assertEquals(new NativeCustomEntityMessage.Remove(uuid), roundTrip(new NativeCustomEntityMessage.Remove(uuid)));
+    }
+
+    @Test
+    void rejectsMismatchedVersionsAndTrailingData() {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeCustomEntityMessage.TYPE.write(buffer, new NativeCustomEntityMessage.Remove(UUID.randomUUID()));
+            final byte[] original = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, original);
+            buffer.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(original);
+            buffer.setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(original).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(original);
+            buffer.setByte(3, 99);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsInvalidCountsBeforeAllocatingModels() {
+        final var buffer = Unpooled.buffer();
+        try {
+            for (int count : new int[]{-1, NativeCustomEntityMessage.MAX_MODELS + 1}) {
+                buffer.clear();
+                Types.VAR_INT.writePrimitive(buffer, 1);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                buffer.writeByte(0);
+                Types.UUID.write(buffer, UUID.randomUUID());
+                Types.STRING.write(buffer, "fixture:actor");
+                buffer.writeFloat(1F);
+                Types.VAR_INT.writePrimitive(buffer, count);
+                assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            }
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void boundsEncodedModelsAndTotalPayloadBytes() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var model = new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", Collections.emptyMap(), false, 1F, null);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.write(buffer,
+                    new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F,
+                            Collections.nCopies(NativeCustomEntityMessage.MAX_MODELS + 1, model))));
+            buffer.clear();
+            final var materials = new LinkedHashMap<String, String>();
+            for (int i = 0; i < NativeCustomEntityMessage.MAX_MATERIALS; i++) {
+                materials.put("bone" + i, "x".repeat(4096));
+            }
+            final var largeModel = new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", materials, false, 1F, null);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.write(buffer,
+                    new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F, List.of(largeModel, largeModel))));
+            buffer.clear().writeZero(NativeCustomEntityMessage.MAX_PAYLOAD_BYTES + 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsDuplicateMaterialBindingsAndTruncatedModels() {
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeByte(0);
+            Types.UUID.write(buffer, UUID.randomUUID());
+            Types.STRING.write(buffer, "fixture:actor");
+            buffer.writeFloat(1F);
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.STRING.write(buffer, "body");
+            Types.STRING.write(buffer, "geometry.body");
+            Types.STRING.write(buffer, "textures/body");
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            for (int i = 0; i < 2; i++) {
+                Types.STRING.write(buffer, "*");
+                Types.STRING.write(buffer, "material" + i);
+            }
+            assertThrows(IllegalArgumentException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+            buffer.clear();
+            NativeCustomEntityMessage.TYPE.write(buffer, new NativeCustomEntityMessage.Snapshot(UUID.randomUUID(), "fixture:actor", 1F,
+                    List.of(new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", Collections.emptyMap(), false, 1F, null))));
+            buffer.writerIndex(buffer.writerIndex() - 1);
+            assertThrows(IndexOutOfBoundsException.class, () -> NativeCustomEntityMessage.TYPE.read(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static NativeCustomEntityMessage roundTrip(final NativeCustomEntityMessage message) {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeCustomEntityMessage.TYPE.write(buffer, message);
+            return NativeCustomEntityMessage.TYPE.read(buffer);
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
