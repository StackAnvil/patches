+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import java.util.Objects;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Physical actor dimensions, independent of interactive picking boxes and Java entity dimensions. */
+public record NativeActorBoundsMessage(UUID uuid, UUID lifetime, boolean localPlayer, Float width, Float height) {
+
+    public static final String CHANNEL = "viabedrock:actor_bounds";
+    public static final int MAX_PAYLOAD_BYTES = 64;
+    public static final Type<NativeActorBoundsMessage> TYPE = new Type<>(NativeActorBoundsMessage.class) {
+        @Override
+        public NativeActorBoundsMessage read(final ByteBuf buffer) {
+            if (buffer.readableBytes() > MAX_PAYLOAD_BYTES || Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported native actor bounds");
+            }
+            final var message = new NativeActorBoundsMessage(Types.UUID.read(buffer), Types.UUID.read(buffer), buffer.readBoolean(),
+                    readDimension(buffer), readDimension(buffer));
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing native actor bounds data");
+            }
+            return message;
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final NativeActorBoundsMessage message) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.UUID.write(buffer, message.uuid);
+            Types.UUID.write(buffer, message.lifetime);
+            buffer.writeBoolean(message.localPlayer);
+            writeDimension(buffer, message.width);
+            writeDimension(buffer, message.height);
+        }
+
+        private static Float readDimension(final ByteBuf buffer) {
+            return buffer.readBoolean() ? buffer.readFloat() : null;
+        }
+
+        private static void writeDimension(final ByteBuf buffer, final Float value) {
+            buffer.writeBoolean(value != null);
+            if (value != null) {
+                buffer.writeFloat(value);
+            }
+        }
+    };
+
+    public NativeActorBoundsMessage {
+        Objects.requireNonNull(uuid);
+        Objects.requireNonNull(lifetime);
+    }
+
+    /** Retain raw metadata in transport; only physical bounds apply scale and the native collapsed-box clamp. */
+    public static float scaledDimension(final Float base, final float scale) {
+        if (base == null || !Float.isFinite(base) || base < 0 || !Float.isFinite(scale) || scale < 0) {
+            throw new IllegalArgumentException("Native actor dimension is unavailable");
+        }
+        final float value = base * scale;
+        if (!Float.isFinite(value) || value >= 1E9F) {
+            throw new IllegalArgumentException("Invalid native actor dimension");
+        }
+        return Math.max(.005F, value);
+    }
+
+}
