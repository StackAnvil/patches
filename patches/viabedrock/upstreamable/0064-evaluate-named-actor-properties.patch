+                    Map<String, Object> properties, Long uniqueId) implements NativeActorMessage {
+        /** Legacy snapshots have no native unique ID association. */
+        public Snapshot(final UUID uuid, final UUID lifetime, final boolean localPlayer, final long runtimeId,
+                        final String identifier, final String name, final float scale, final Set<ActorFlags> flags,
+                        final int variant, final int markVariant, final Integer spellColor, final Map<String, Object> properties) {
+            this(uuid, lifetime, localPlayer, runtimeId, identifier, name, scale, flags, variant, markVariant, spellColor, properties, null);
+        }
+
+        public Snapshot {
+            flags = Set.copyOf(flags);
+            properties = Map.copyOf(properties);
+            for (Object value : properties.values()) {
