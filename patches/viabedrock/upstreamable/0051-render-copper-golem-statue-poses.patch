+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.raphimc.viabedrock.api.model.BlockState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class CopperGolemStatueBlockEntityRewriterTest {
+
+    private static final BlockState STANDING = BlockState.fromString("minecraft:waxed_weathered_copper_golem_statue[facing=north,copper_golem_pose=standing,waterlogged=false]");
+
+    @Test
+    void remapsEveryBedrockPoseWithoutLosingOtherProperties() {
+        final String[] poses = {"standing", "sitting", "running", "star"};
+        for (int pose = 0; pose < poses.length; pose++) {
+            final CompoundTag tag = new CompoundTag();
+            tag.putInt("Pose", pose);
+            assertEquals(STANDING.withProperty("copper_golem_pose", poses[pose]),
+                CopperGolemStatueBlockEntityRewriter.javaBlockState(STANDING, tag));
+        }
+    }
+
+    @Test
+    void preservesMappedStateWhenPoseIsAbsentOrInvalid() {
+        final CompoundTag tag = new CompoundTag();
+        assertEquals(STANDING, CopperGolemStatueBlockEntityRewriter.javaBlockState(STANDING, tag));
+        tag.putInt("Pose", 4);
+        assertEquals(STANDING, CopperGolemStatueBlockEntityRewriter.javaBlockState(STANDING, tag));
+        tag.putString("Pose", "sitting");
+        assertEquals(STANDING, CopperGolemStatueBlockEntityRewriter.javaBlockState(STANDING, tag));
+    }
+
+}
