+package net.raphimc.viabedrock.api.resourcepack.definition;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class EntityDefinitionsTest {
+
+    @Test
+    void partialOverlayRetainsUnchangedAliasesAndScriptRoots() {
+        final JsonObject lower = description();
+        final JsonObject aliases = new JsonObject();
+        aliases.addProperty("right", "animation.test.right");
+        aliases.addProperty("left", "animation.test.left");
+        lower.add("animations", aliases);
+        final JsonObject scripts = new JsonObject();
+        final JsonArray roots = new JsonArray();
+        roots.add("right");
+        roots.add("left");
+        scripts.add("animate", roots);
+        scripts.addProperty("scale", .9375);
+        lower.add("scripts", scripts);
+        final JsonObject higher = description();
+        final JsonObject override = new JsonObject();
+        override.addProperty("right", "animation.test.overlay_right");
+        higher.add("animations", override);
+        final JsonObject higherScripts = new JsonObject();
+        higherScripts.addProperty("scale", .875);
+        higher.add("scripts", higherScripts);
+        final var entities = new ResourcePackStorage(List.of(pack(higher), pack(lower))).getEntities();
+        final var effective = entities.getDescription("test:actor");
+        assertEquals("animation.test.overlay_right", entities.get("test:actor").entityData().getAnimations().get("right"));
+        assertEquals("animation.test.left", entities.get("test:actor").entityData().getAnimations().get("left"));
+        assertEquals(roots, effective.getAsJsonObject("scripts").get("animate"));
+        assertEquals(.875, effective.getAsJsonObject("scripts").get("scale").getAsDouble());
+        effective.getAsJsonObject("scripts").remove("animate");
+        assertEquals(roots, entities.getDescription("test:actor").getAsJsonObject("scripts").get("animate"));
+        assertEquals(.9375, lower.getAsJsonObject("scripts").get("scale").getAsDouble());
+        assertNull(entities.getDescription("test:missing"));
+    }
+
+    @Test
+    void explicitEmptyArrayReplacesInheritedRootsAndPreservesOtherScriptFields() {
+        final JsonObject lower = description();
+        final JsonObject lowerScripts = new JsonObject();
+        final JsonArray roots = new JsonArray();
+        roots.add("pose");
+        lowerScripts.add("animate", roots);
+        lowerScripts.addProperty("scale", .5);
+        lower.add("scripts", lowerScripts);
+        final JsonObject higher = description();
+        final JsonObject higherScripts = new JsonObject();
+        higherScripts.add("animate", new JsonArray());
+        higher.add("scripts", higherScripts);
+        final var entities = new ResourcePackStorage(List.of(pack(higher), pack(lower))).getEntities();
+        final var scripts = entities.getDescription("test:actor").getAsJsonObject("scripts");
+        assertTrue(scripts.getAsJsonArray("animate").isEmpty());
+        assertEquals(.5, scripts.get("scale").getAsDouble());
+    }
+
+    @Test
+    void sharedMergerReturnsIndependentNestedObjectsAndLists() {
+        final JsonObject lower = description();
+        final JsonObject inherited = new JsonObject();
+        final JsonArray roots = new JsonArray();
+        roots.add("pose");
+        inherited.add("animate", roots);
+        lower.add("scripts", inherited);
+        final JsonObject higher = description();
+        final JsonObject override = new JsonObject();
+        override.addProperty("scale", .875);
+        higher.add("scripts", override);
+        final JsonObject merged = EntityDefinitions.mergeDescriptions(lower, higher);
+        merged.getAsJsonObject("scripts").getAsJsonArray("animate").add("another");
+        merged.getAsJsonObject("scripts").addProperty("scale", 0);
+        assertEquals(1, roots.size());
+        assertEquals(.875, override.get("scale").getAsDouble());
+        assertFalse(inherited.has("scale"));
+        assertFalse(override.has("animate"));
+    }
+
+    private static JsonObject description() {
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", "test:actor");
+        return description;
+    }
+
+    private static ResourcePack pack(final JsonObject description) {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0],\"name\":\"test\"}}");
+        final JsonObject entity = new JsonObject();
+        entity.add("description", description);
+        final JsonObject document = new JsonObject();
+        document.addProperty("format_version", "1.10.0");
+        document.add("minecraft:client_entity", entity);
+        content.putJson("entity/actor.json", document);
+        return new ResourcePack(content);
+    }
+
+}
