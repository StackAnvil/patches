 package net.raphimc.viabedrock.api.resourcepack.definition;
 
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
 import com.viaversion.viaversion.util.Key;
 import net.raphimc.viabedrock.ViaBedrock;
 import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
@@ -33,14 +35,24 @@ import java.util.logging.Level;
 public class EntityDefinitions {
 
     private final Map<String, EntityDefinition> entities = new HashMap<>();
+    private final Map<String, JsonObject> descriptions = new HashMap<>();
 
     public EntityDefinitions(final ResourcePackStorage resourcePackStorage) {
         for (ResourcePack pack : resourcePackStorage.getPackStackBottomToTop()) {
             for (String entityPath : pack.content().getFilesDeep("entity/", ".json")) {
                 try {
-                    final BedrockEntityData entityData = BedrockEntityParser.parse(pack.content().getString(entityPath));
-                    final String identifier = Key.namespaced(entityData.getIdentifier());
+                    final JsonObject document = JsonParser.parseString(pack.content().getString(entityPath)).getAsJsonObject();
+                    final JsonObject entity = document.getAsJsonObject("minecraft:client_entity");
+                    if (entity == null) {
+                        continue;
+                    }
+                    final JsonObject description = entity.getAsJsonObject("description");
+                    final String identifier = Key.namespaced(description.get("identifier").getAsString());
+                    final JsonObject merged = mergeDescriptions(this.descriptions.get(identifier), description);
+                    entity.add("description", merged);
+                    final BedrockEntityData entityData = BedrockEntityParser.parse(document.toString());
                     this.entities.put(identifier, new EntityDefinition(identifier, entityData));
+                    this.descriptions.put(identifier, merged);
                 } catch (final Throwable e) {
                     ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to parse entity definition " + entityPath + " in pack " + pack.key(), e);
                 }
@@ -52,6 +64,25 @@ public class EntityDefinitions {
         return this.entities.get(identifier);
     }
 
+    /** Returns an independent snapshot of the effective description, including fields absent from the converter data model. */
+    public JsonObject getDescription(final String identifier) {
+        final JsonObject description = this.descriptions.get(identifier);
+        return description == null ? null : description.deepCopy();
+    }
+
+    /** Combines descriptions without modifying either input; a null lower value starts a new stack. */
+    public static JsonObject mergeDescriptions(final JsonObject lower, final JsonObject higher) {
+        final JsonObject merged = lower == null ? new JsonObject() : lower.deepCopy();
+        for (final var entry : higher.entrySet()) {
+            final var inherited = merged.get(entry.getKey());
+            final var replacement = entry.getValue();
+            // Aliases and script fields inherit by key. Authored lists and scalar values replace the lower value.
+            merged.add(entry.getKey(), inherited != null && inherited.isJsonObject() && replacement.isJsonObject()
+                    ? mergeDescriptions(inherited.getAsJsonObject(), replacement.getAsJsonObject()) : replacement.deepCopy());
+        }
+        return merged;
+    }
+
     public Map<String, EntityDefinition> entities() {
         return Collections.unmodifiableMap(this.entities);
     }
