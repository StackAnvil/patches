+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.Objects;
+
+/** Local result matched to the concluding Java prediction sequence. */
+public record BlockUsePrediction(int sequence, Result result, Position3f cursor, boolean airAllowed) {
+
+    public static final String CHANNEL = "viabedrock:block_use_prediction";
+    public static final String AIR_CHANNEL = "viabedrock:block_use_prediction_v3";
+    public static final Type<BlockUsePrediction> TYPE = codec(false);
+    public static final Type<BlockUsePrediction> AIR_TYPE = codec(true);
+
+    private static Type<BlockUsePrediction> codec(final boolean withAirAdmission) {
+        return new Type<>(BlockUsePrediction.class) {
+            @Override
+            public BlockUsePrediction read(final ByteBuf buffer) {
+                if (Types.VAR_INT.readPrimitive(buffer) != (withAirAdmission ? 3 : 2)
+                        || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                    throw new IllegalArgumentException("Unsupported player block use");
+                }
+                final int sequence = Types.VAR_INT.readPrimitive(buffer);
+                final Result result = Result.read(buffer.readUnsignedByte());
+                final Position3f cursor = BedrockTypes.POSITION_3F.read(buffer);
+                return new BlockUsePrediction(sequence, result, cursor, !withAirAdmission || buffer.readBoolean());
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final BlockUsePrediction value) {
+                Types.VAR_INT.writePrimitive(buffer, withAirAdmission ? 3 : 2);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                Types.VAR_INT.writePrimitive(buffer, value.sequence());
+                buffer.writeByte(value.result().id);
+                BedrockTypes.POSITION_3F.write(buffer, value.cursor());
+                if (withAirAdmission) {
+                    buffer.writeBoolean(value.airAllowed());
+                }
+            }
+        };
+    }
+
+    public BlockUsePrediction(final int sequence, final Result result, final Position3f cursor) {
+        this(sequence, result, cursor, true);
+    }
+
+    public BlockUsePrediction {
+        Objects.requireNonNull(result);
+        Objects.requireNonNull(cursor);
+        if (!Float.isFinite(cursor.x()) || !Float.isFinite(cursor.y()) || !Float.isFinite(cursor.z())) {
+            throw new IllegalArgumentException("Non-finite block-use cursor");
+        }
+        if (sequence < 0) {
+            throw new IllegalArgumentException("Negative block-use prediction sequence");
+        }
+    }
+
+    public enum Result {
+        FAILED(0),
+        INTERACTED(1),
+        PLACED(2);
+
+        private final int id;
+
+        Result(final int id) {
+            this.id = id;
+        }
+
+        static Result read(final int id) {
+            return switch (id) {
+                case 0 -> FAILED;
+                case 1 -> INTERACTED;
+                case 2 -> PLACED;
+                default -> throw new IllegalArgumentException("Unknown block-use prediction result");
+            };
+        }
+
+    }
+
+}
