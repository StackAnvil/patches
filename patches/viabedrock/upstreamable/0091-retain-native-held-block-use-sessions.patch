+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Local result matched to the concluding Java prediction sequence. */
+public record BlockUsePrediction(int sequence, boolean successful) {
+
+    public static final String CHANNEL = "viabedrock:block_use_prediction";
+    public static final Type<BlockUsePrediction> TYPE = new Type<>(BlockUsePrediction.class) {
+        @Override
+        public BlockUsePrediction read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported player block use");
+            }
+            return new BlockUsePrediction(Types.VAR_INT.readPrimitive(buffer), buffer.readBoolean());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final BlockUsePrediction value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.sequence());
+            buffer.writeBoolean(value.successful());
+        }
+    };
+
+    public BlockUsePrediction {
+        if (sequence < 0) {
+            throw new IllegalArgumentException("Negative block-use prediction sequence");
+        }
+    }
+
+}
