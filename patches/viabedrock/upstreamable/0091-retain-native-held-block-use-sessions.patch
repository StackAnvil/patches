+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+
+/** A held control can span targets, selected items, and authoritative corrections. */
+public final class BlockUseStorage implements StorableObject {
+
+    private boolean held;
+    private boolean used;
+    private boolean active;
+    private BlockPosition resultPosition;
+    private BlockUsePrediction prediction;
+
+    public boolean held() {
+        return this.held;
+    }
+
+    public void hold() {
+        this.held = true;
+    }
+
+    public void predict(final BlockUsePrediction prediction) {
+        this.prediction = prediction;
+    }
+
+    public Use begin(final int sequence, final BlockPosition resultPosition) {
+        final boolean success = this.prediction == null || this.prediction.sequence() != sequence || this.prediction.successful();
+        this.prediction = null;
+        final ItemUseTriggerType trigger = this.used ? ItemUseTriggerType.Simulation_Tick : ItemUseTriggerType.Player_Input;
+        this.used = true;
+        final boolean start = !this.active && success;
+        this.active |= success;
+        if (this.active) {
+            this.resultPosition = resultPosition;
+        }
+        return new Use(trigger, start, success);
+    }
+
+    public BlockPosition complete() {
+        return this.held ? null : this.release();
+    }
+
+    public BlockPosition release() {
+        final BlockPosition result = this.resultPosition;
+        this.resultPosition = null;
+        this.prediction = null;
+        this.held = false;
+        this.used = false;
+        this.active = false;
+        return result;
+    }
+
+    public record Use(ItemUseTriggerType trigger, boolean start, boolean successful) {
+    }
+
+}
