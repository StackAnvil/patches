+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Local stack consumption paired with the concluding ordinary Java item-use packet. */
+public record ItemUsePrediction(int sequence, boolean consumed) {
+
+    public static final String CHANNEL = "viabedrock:item_use_prediction";
+    public static final Type<ItemUsePrediction> TYPE = new Type<>(ItemUsePrediction.class) {
+        @Override
+        public ItemUsePrediction read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported item-use prediction");
+            }
+            return new ItemUsePrediction(Types.VAR_INT.readPrimitive(buffer), buffer.readBoolean());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final ItemUsePrediction value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, value.sequence());
+            buffer.writeBoolean(value.consumed());
+        }
+    };
+
+    public ItemUsePrediction {
+        if (sequence < 0) {
+            throw new IllegalArgumentException("Negative item-use prediction sequence");
+        }
+    }
+
+}
