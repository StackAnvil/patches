+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BlockUseStorageTest {
+
+    @Test
+    void retainsOneUseAcrossRepeatedTargetsAndStopsAtTheLastResult() {
+        final var use = new BlockUseStorage();
+        final var first = new BlockPosition(2, 65, 4);
+        final var next = new BlockPosition(2, 64, 4);
+        use.hold();
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, first).trigger());
+        assertNull(use.complete());
+        use.hold();
+        assertEquals(ItemUseTriggerType.Simulation_Tick, use.begin(0, next).trigger());
+        assertNull(use.complete());
+        assertEquals(next, use.release());
+        assertNull(use.release());
+        use.hold();
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, first).trigger());
+    }
+
+    @Test
+    void ordinaryClientsKeepIndependentBlockUses() {
+        final var use = new BlockUseStorage();
+        final var result = new BlockPosition(4, 8, -2);
+        for (int click = 0; click < 3; click++) {
+            assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, result).trigger());
+            assertEquals(result, use.complete());
+            assertNull(use.release());
+        }
+    }
+
+    @Test
+    void releasingBeforeAnyBlockUseDoesNotProduceStop() {
+        final var use = new BlockUseStorage();
+        use.hold();
+        assertNull(use.release());
+        final var result = new BlockPosition(-2, -3, -4);
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, result).trigger());
+        assertEquals(result, use.complete());
+    }
+
+    @Test
+    void failedPredictionsStaySeparateFromSessionStartAndOtherSequences() {
+        final var use = new BlockUseStorage();
+        final var position = new BlockPosition(0, 320, 0);
+        use.hold();
+        use.predict(new BlockUsePrediction(1, false));
+        final var failure = use.begin(1, position);
+        assertFalse(failure.start());
+        assertFalse(failure.successful());
+        assertNull(use.complete());
+        use.predict(new BlockUsePrediction(2, true));
+        final var valid = use.begin(2, new BlockPosition(0, 64, 0));
+        assertTrue(valid.start());
+        assertEquals(ItemUseTriggerType.Simulation_Tick, valid.trigger());
+        assertEquals(new BlockPosition(0, 64, 0), use.release());
+        use.predict(new BlockUsePrediction(3, false));
+        assertTrue(use.begin(4, position).successful());
+        assertEquals(position, use.complete());
+        use.hold();
+        use.predict(new BlockUsePrediction(5, false));
+        use.begin(5, position);
+        assertNull(use.release());
+    }
+
+}
