@@ -0,0 +1,101 @@
+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ActorSwingSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BlockUseStorageTest {
+
+    @Test
+    void retainsOneUseAcrossRepeatedTargetsAndStopsAtTheLastResult() {
+        final var use = new BlockUseStorage();
+        final var first = new BlockPosition(2, 65, 4);
+        final var next = new BlockPosition(2, 64, 4);
+        use.hold();
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, first, new Position3f(0.5F, 0.625F, 1F)).trigger());
+        assertNull(use.complete());
+        use.hold();
+        assertEquals(ItemUseTriggerType.Simulation_Tick, use.begin(0, next, new Position3f(0.5F, 0.625F, 1F)).trigger());
+        assertNull(use.complete());
+        assertEquals(next, use.release());
+        assertNull(use.release());
+        use.hold();
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, first, new Position3f(0.5F, 0.625F, 1F)).trigger());
+    }
+
+    @Test
+    void ordinaryClientsKeepIndependentBlockUses() {
+        final var use = new BlockUseStorage();
+        final var result = new BlockPosition(4, 8, -2);
+        for (int click = 0; click < 3; click++) {
+            assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, result, new Position3f(0.5F, 0.625F, 1F)).trigger());
+            assertEquals(result, use.complete());
+            assertNull(use.release());
+        }
+    }
+
+    @Test
+    void releasingBeforeAnyBlockUseDoesNotProduceStop() {
+        final var use = new BlockUseStorage();
+        use.hold();
+        assertNull(use.release());
+        final var result = new BlockPosition(-2, -3, -4);
+        assertEquals(ItemUseTriggerType.Player_Input, use.begin(0, result, new Position3f(0.5F, 0.625F, 1F)).trigger());
+        assertEquals(result, use.complete());
+    }
+
+    @Test
+    void failedPredictionsStaySeparateFromSessionStartAndOtherSequences() {
+        final var use = new BlockUseStorage();
+        final var position = new BlockPosition(0, 320, 0);
+        use.hold();
+        use.predict(new BlockUsePrediction(1, BlockUsePrediction.Result.FAILED, new Position3f(0.5F, 0.625F, 1F)));
+        final var failure = use.begin(1, position, new Position3f(0.5F, 0.625F, 1F));
+        assertFalse(failure.start());
+        assertFalse(failure.successful());
+        assertNull(use.complete());
+        use.predict(new BlockUsePrediction(2, BlockUsePrediction.Result.PLACED, new Position3f(0.5F, 0.625F, 1F)));
+        final var valid = use.begin(2, new BlockPosition(0, 64, 0), new Position3f(0.5F, 0.625F, 1F));
+        assertTrue(valid.start());
+        assertEquals(ItemUseTriggerType.Simulation_Tick, valid.trigger());
+        assertEquals(new BlockPosition(0, 64, 0), use.release());
+        use.predict(new BlockUsePrediction(3, BlockUsePrediction.Result.FAILED, new Position3f(0.5F, 0.625F, 1F)));
+        assertTrue(use.begin(4, position, new Position3f(0.5F, 0.625F, 1F)).successful());
+        assertEquals(position, use.complete());
+        use.hold();
+        use.predict(new BlockUsePrediction(5, BlockUsePrediction.Result.FAILED, new Position3f(0.5F, 0.625F, 1F)));
+        use.begin(5, position, new Position3f(0.5F, 0.625F, 1F));
+        assertNull(use.release());
+    }
+
+    @Test
+    void usesThePredictedActionForNativeSwingsWithoutClassifyingFailuresAsBuilds() {
+        final var use = new BlockUseStorage();
+        final var position = new BlockPosition(2, 65, 4);
+        use.hold();
+        use.predict(new BlockUsePrediction(1, BlockUsePrediction.Result.PLACED, new Position3f(0.5F, 0.625F, 1F)));
+        assertEquals(ActorSwingSource.Build, use.begin(1, position, new Position3f(0.5F, 0.625F, 1F)).swingSource());
+        use.predict(new BlockUsePrediction(2, BlockUsePrediction.Result.INTERACTED, new Position3f(0.5F, 0.625F, 1F)));
+        assertEquals(ActorSwingSource.Interact, use.begin(2, position, new Position3f(0.5F, 0.625F, 1F)).swingSource());
+        use.predict(new BlockUsePrediction(3, BlockUsePrediction.Result.FAILED, new Position3f(0.5F, 0.625F, 1F)));
+        assertEquals(ActorSwingSource.None, use.begin(3, position, new Position3f(0.5F, 0.625F, 1F)).swingSource());
+    }
+
+    @Test
+    void keepsNativeCursorCoordinatesOutsideTheTargetCubeAndRejectsStaleCursorOwnership() {
+        final var use = new BlockUseStorage();
+        final var position = new BlockPosition(-500, 65, -113);
+        final var actual = new Position3f(0.3F, 0.8125F, 0.5F);
+        final var locked = new Position3f(2.5F, 0.625F, 1F);
+        use.predict(new BlockUsePrediction(1, BlockUsePrediction.Result.PLACED, locked));
+        assertEquals(locked, use.begin(1, position, actual).cursor());
+        use.predict(new BlockUsePrediction(2, BlockUsePrediction.Result.PLACED, locked));
+        assertEquals(actual, use.begin(3, position, actual).cursor());
+    }
+
+}
