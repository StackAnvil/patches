+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BlockUsePredictionTest {
+
+    @Test
+    void preservesEveryActionAndSequenceBoundaryAcrossTheWire() {
+        for (final var result : BlockUsePrediction.Result.values()) {
+            for (final int sequence : new int[] {0, Integer.MAX_VALUE}) {
+                final var buffer = Unpooled.buffer();
+                try {
+                    final var value = new BlockUsePrediction(sequence, result, new Position3f(0.5F, 0.625F, 1F));
+                    BlockUsePrediction.TYPE.write(buffer, value);
+                    assertEquals(value, BlockUsePrediction.TYPE.read(buffer));
+                    assertFalse(buffer.isReadable());
+                    final var outside = new BlockUsePrediction(sequence, result, new Position3f(2.5F, -0.5F, 1F));
+                    BlockUsePrediction.TYPE.write(buffer, outside);
+                    assertEquals(outside, BlockUsePrediction.TYPE.read(buffer));
+                } finally {
+                    buffer.release();
+                }
+            }
+        }
+    }
+
+    @Test
+    void admissionChannelPreservesSuppressedAirAndLegacyPayloadsKeepTheirPriorDefault() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var value = new BlockUsePrediction(7, BlockUsePrediction.Result.PLACED, new Position3f(0.5F, 0.625F, 1F), false);
+            BlockUsePrediction.AIR_TYPE.write(buffer, value);
+            assertEquals(value, BlockUsePrediction.AIR_TYPE.read(buffer));
+            assertFalse(buffer.isReadable());
+            buffer.clear();
+            buffer.writeBytes(new byte[] {2, (byte) 0xB1, 17, 7, 2, 0, 0, 0, 63, 0, 0, 32, 63, 0, 0, (byte) 128, 63});
+            final var legacy = BlockUsePrediction.TYPE.read(buffer);
+            assertEquals(7, legacy.sequence());
+            assertEquals(BlockUsePrediction.Result.PLACED, legacy.result());
+            assertTrue(legacy.airAllowed());
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnknownActionsAndNegativeSequences() {
+        final var buffer = Unpooled.buffer();
+        try {
+            Types.VAR_INT.writePrimitive(buffer, 2);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            Types.VAR_INT.writePrimitive(buffer, 0);
+            buffer.writeByte(3);
+            assertThrows(IllegalArgumentException.class, () -> BlockUsePrediction.TYPE.read(buffer));
+            assertThrows(IllegalArgumentException.class, () -> new BlockUsePrediction(-1, BlockUsePrediction.Result.PLACED, new Position3f(0.5F, 0.625F, 1F)));
+            assertThrows(IllegalArgumentException.class,
+                    () -> new BlockUsePrediction(1, BlockUsePrediction.Result.PLACED, new Position3f(Float.NaN, 0F, 0F)));
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
