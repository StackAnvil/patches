+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.ByteBuf;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Physical use-control lifetime, independent of repeated Java block-use packets. */
+public record PlayerBlockUse(boolean held) {
+
+    public static final String CHANNEL = "viabedrock:block_use";
+    public static final Type<PlayerBlockUse> TYPE = new Type<>(PlayerBlockUse.class) {
+        @Override
+        public PlayerBlockUse read(final ByteBuf buffer) {
+            if (Types.VAR_INT.readPrimitive(buffer) != 1
+                    || Types.VAR_INT.readPrimitive(buffer) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                throw new IllegalArgumentException("Unsupported player block use");
+            }
+            return new PlayerBlockUse(buffer.readBoolean());
+        }
+
+        @Override
+        public void write(final ByteBuf buffer, final PlayerBlockUse value) {
+            Types.VAR_INT.writePrimitive(buffer, 1);
+            Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+            buffer.writeBoolean(value.held());
+        }
+    };
+
+}
