+        if (blockUse != null) {
+            sendBlockUseStop(user, blockUse.release());
+        }
+    }
+
+    private static void sendBlockUseStop(final UserConnection user, final BlockPosition result) {
+        if (result != null) {
+            PlayerActionPacketFactory.sendBedrockPlayerAction(
+                    user, user.get(EntityTracker.class).getClientPlayer().runtimeId(), PlayerActionType.StopItemUseOn,
+                    result, new BlockPosition(0, 0, 0), 0);
+        }
     }
 
