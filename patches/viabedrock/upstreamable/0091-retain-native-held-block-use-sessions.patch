+    static BlockPlacementPrediction blockPlacementPrediction(final InventoryTracker inventory, final GameMode mode,
+            final BlockUsePrediction.Result result, final int slot, final BedrockItem item) {
+        if (result != BlockUsePrediction.Result.PLACED || mode == GameMode.CREATIVE || !item.hasBlockState() || item.isEmpty()) {
