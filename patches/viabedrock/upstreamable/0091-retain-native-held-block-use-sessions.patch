+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ActorSwingSource;
+
+/** A held control can span targets, selected items, and authoritative corrections. */
+public final class BlockUseStorage implements StorableObject {
+
+    private boolean held;
+    private boolean used;
+    private boolean active;
+    private BlockPosition resultPosition;
+    private BlockUsePrediction prediction;
+
+    public boolean held() {
+        return this.held;
+    }
+
+    public void hold() {
+        this.held = true;
+    }
+
+    public void predict(final BlockUsePrediction prediction) {
+        this.prediction = prediction;
+    }
+
+    public Use begin(final int sequence, final BlockPosition resultPosition, final Position3f cursor) {
+        final boolean matched = this.prediction != null && this.prediction.sequence() == sequence;
+        final BlockUsePrediction.Result result = matched ? this.prediction.result() : BlockUsePrediction.Result.INTERACTED;
+        final Position3f nativeCursor = matched ? this.prediction.cursor() : cursor;
+        final boolean success = result != BlockUsePrediction.Result.FAILED;
+        this.prediction = null;
+        final ItemUseTriggerType trigger = this.used ? ItemUseTriggerType.Simulation_Tick : ItemUseTriggerType.Player_Input;
+        this.used = true;
+        final boolean start = !this.active && success;
+        this.active |= success;
+        if (this.active) {
+            this.resultPosition = resultPosition;
+        }
+        return new Use(trigger, start, result, nativeCursor);
+    }
+
+    public BlockPosition complete() {
+        return this.held ? null : this.release();
+    }
+
+    public BlockPosition release() {
+        final BlockPosition result = this.resultPosition;
+        this.resultPosition = null;
+        this.prediction = null;
+        this.held = false;
+        this.used = false;
+        this.active = false;
+        return result;
+    }
+
+    public record Use(ItemUseTriggerType trigger, boolean start, BlockUsePrediction.Result result, Position3f cursor) {
+
+        public boolean successful() {
+            return this.result != BlockUsePrediction.Result.FAILED;
+        }
+
+        public ActorSwingSource swingSource() {
+            return switch (this.result) {
+                case FAILED -> ActorSwingSource.None;
+                case INTERACTED -> ActorSwingSource.Interact;
+                case PLACED -> ActorSwingSource.Build;
+            };
+        }
+
+    }
+
+}
