+    static BlockPlacementPrediction blockPlacementPrediction(final InventoryTracker inventory, final GameMode mode,
+            final BlockUsePrediction.Result result, final int slot, final BedrockItem item) {
+        if (result != BlockUsePrediction.Result.PLACED || mode == GameMode.CREATIVE || !item.hasBlockState() || item.isEmpty()) {
+            return new BlockPlacementPrediction(0, List.of(), List.of(), item.copy());
+        }
+        final BedrockItem remainder = item.copy();
+        remainder.setAmount(remainder.amount() - 1);
+        final BedrockItem remaining = remainder.amount() > 0 ? remainder : BedrockItem.empty();
+        final int requestId = remaining.isEmpty() ? 0 : inventory.nextLegacyRequestId();
+        return new BlockPlacementPrediction(requestId,
+                requestId == 0 ? List.of() : List.of(new LegacySetItemSlotData(ContainerEnumName.InventoryContainer, new byte[]{(byte) slot})),
+                List.of(new InventoryActionData(new InventorySource(InventorySourceType.Container_Inventory,
+                        ContainerID.CONTAINER_ID_INVENTORY.getValue(), InventorySourceFlags.No_Flag), slot, item, remaining)), remaining);
+    }
+
+    static BedrockInventoryTransaction blockItemUseTransaction(final int slot, final BedrockItem item, final Position3f position) {
+        return new BedrockInventoryTransaction(0, null, List.of(), ComplexInventoryTransaction_Type.ItemUseTransaction,
+                new InventoryTransactionData.UseItemTransactionData(
+                        ItemUseActionType.Use, ItemUseTriggerType.Unknown, new BlockPosition(0, 0, 0), -1,
+                        slot, HandSlot.Mainhand, item, position, new Position3f(0, 0, 0), 0,
+                        ItemUsePredictedResult.Failure, ItemUseClientCooldownState.Off));
+    }
