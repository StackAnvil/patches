+package net.raphimc.viabedrock.protocol.packet;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+import net.raphimc.viabedrock.protocol.storage.InventoryTracker;
+import net.raphimc.viabedrock.protocol.data.enums.java.generated.GameMode;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ContainerEnumName;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseActionType;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUsePredictedResult;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.ItemUseTriggerType;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.inventory.InventoryTransactionData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+final class BlockItemUseTransactionTest {
+
+    @Test
+    void followsUseOnWithTheNativeNonPlacementPhaseAndPredictedItemSnapshot() {
+        final var item = new BedrockItem(96);
+        item.setAmount(64);
+        final var position = new Position3f(1, 65.62F, 3);
+        final var transaction = InteractionPackets.blockItemUseTransaction(2, item, position);
+        assertTrue(transaction.actions().isEmpty());
+        final var use = (InventoryTransactionData.UseItemTransactionData) transaction.transactionData();
+        assertEquals(ItemUseActionType.Use, use.actionType());
+        assertEquals(ItemUseTriggerType.Unknown, use.triggerType());
+        assertEquals(ItemUsePredictedResult.Failure, use.predictedResult());
+        assertEquals(-1, use.face());
+        assertEquals(2, use.hotbarSlot());
+        assertSame(item, use.itemInHand());
+        assertEquals(64, use.itemInHand().amount());
+        assertEquals(position, use.playerPosition());
+        assertEquals(new Position3f(0, 0, 0), use.clickPosition());
+    }
+
+    @Test
+    void survivalPlacementPredictsOneItemAndUsesItsRemainderInTheFollowingUsePhase() {
+        final var inventory = new InventoryTracker(mock(UserConnection.class));
+        final var item = new BedrockItem(96);
+        item.setAmount(64);
+        item.setBlockRuntimeId(123);
+        final var prediction = InteractionPackets.blockPlacementPrediction(inventory, GameMode.SURVIVAL,
+                BlockUsePrediction.Result.PLACED, 2, item);
+        assertTrue(prediction.requestId() < -1);
+        assertEquals(0, prediction.requestId() & 1);
+        assertEquals(ContainerEnumName.InventoryContainer, prediction.slots().getFirst().container());
+        assertArrayEquals(new byte[]{2}, prediction.slots().getFirst().slots());
+        assertEquals(1, prediction.actions().size());
+        assertEquals(2, prediction.actions().getFirst().slot());
+        assertEquals(64, prediction.actions().getFirst().fromItem().amount());
+        assertEquals(63, prediction.actions().getFirst().toItem().amount());
+        final var transaction = InteractionPackets.blockItemUseTransaction(2, prediction.remainder(), Position3f.ZERO);
+        assertEquals(63, ((InventoryTransactionData.UseItemTransactionData) transaction.transactionData()).itemInHand().amount());
+        assertTrue(transaction.actions().isEmpty());
+        assertEquals(64, item.amount());
+        final var next = InteractionPackets.blockPlacementPrediction(inventory, GameMode.SURVIVAL,
+                BlockUsePrediction.Result.PLACED, 2, prediction.remainder());
+        assertTrue(next.requestId() < prediction.requestId());
+        assertEquals(62, next.remainder().amount());
+        item.setAmount(1);
+        final var last = InteractionPackets.blockPlacementPrediction(inventory, GameMode.SURVIVAL,
+                BlockUsePrediction.Result.PLACED, 2, item);
+        assertEquals(0, last.requestId());
+        assertTrue(last.slots().isEmpty());
+        assertTrue(last.remainder().isEmpty());
+        assertTrue(last.actions().getFirst().toItem().isEmpty());
+    }
+
+    @Test
+    void creativeInteractionsFailuresAndNonBlockItemsDoNotPredictPlacementConsumption() {
+        final var inventory = new InventoryTracker(mock(UserConnection.class));
+        final var item = new BedrockItem(96);
+        item.setAmount(64);
+        item.setBlockRuntimeId(123);
+        for (final var mode : new GameMode[]{GameMode.CREATIVE, GameMode.SURVIVAL}) {
+            for (final var result : BlockUsePrediction.Result.values()) {
+                if (mode == GameMode.SURVIVAL && result == BlockUsePrediction.Result.PLACED) {
+                    continue;
+                }
+                final var prediction = InteractionPackets.blockPlacementPrediction(inventory, mode, result, 0, item);
+                assertEquals(0, prediction.requestId());
+                assertTrue(prediction.actions().isEmpty());
+                assertTrue(prediction.slots().isEmpty());
+                assertEquals(64, prediction.remainder().amount());
+            }
+        }
+        item.setBlockRuntimeId(null);
+        assertTrue(InteractionPackets.blockPlacementPrediction(inventory, GameMode.SURVIVAL,
+                BlockUsePrediction.Result.PLACED, 0, item).actions().isEmpty());
+    }
+
+}
