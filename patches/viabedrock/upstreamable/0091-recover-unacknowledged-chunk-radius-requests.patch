+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import java.lang.reflect.Proxy;
+import io.netty.channel.embedded.EmbeddedChannel;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ChunkRadiusNegotiationTest {
+
+    @Test
+    void retriesSmallRadiusThenRecoversWithoutInventingAnAcknowledgement() {
+        try (var fixture = new Fixture()) {
+            fixture.negotiation.start(4);
+            fixture.advance(5);
+            fixture.advance(5);
+            assertEquals(List.of(4, 4, 8), fixture.negotiation.requests);
+            assertEquals(0, fixture.negotiation.failures);
+            fixture.negotiation.acknowledge();
+            fixture.advance(60);
+            assertEquals(0, fixture.negotiation.failures);
+            assertEquals(List.of(4, 4, 8), fixture.negotiation.requests);
+        }
+    }
+
+    @Test
+    void boundsRetriesAndReportsTheMissingAcknowledgement() {
+        try (var fixture = new Fixture()) {
+            fixture.negotiation.start(12);
+            fixture.advance(5);
+            fixture.advance(5);
+            fixture.advance(20);
+            fixture.advance(60);
+            assertEquals(List.of(12, 12), fixture.negotiation.requests);
+            assertEquals(1, fixture.negotiation.failures);
+        }
+    }
+
+    @Test
+    void settingsReplacePendingRequestsAndSpawnStopsRecovery() {
+        try (var fixture = new Fixture()) {
+            fixture.negotiation.updateRequest(4); // Configuration settings do not start a join timeout.
+            fixture.advance(60);
+            assertTrue(fixture.negotiation.requests.isEmpty());
+            fixture.negotiation.start(4);
+            fixture.advance(3);
+            assertEquals(16, fixture.negotiation.updateRequest(16));
+            fixture.advance(2);
+            assertEquals(List.of(4), fixture.negotiation.requests);
+            fixture.advance(3);
+            assertEquals(List.of(4, 16), fixture.negotiation.requests);
+            fixture.negotiation.markSpawned();
+            fixture.negotiation.updateRequest(4);
+            fixture.advance(60);
+            assertEquals(List.of(4, 16), fixture.negotiation.requests);
+            assertEquals(0, fixture.negotiation.failures);
+        }
+    }
+
+    @Test
+    void removalAndDisconnectCancelPendingRecovery() {
+        try (var fixture = new Fixture()) {
+            fixture.negotiation.start(4);
+            fixture.negotiation.onRemove();
+            fixture.advance(60);
+            assertEquals(List.of(4), fixture.negotiation.requests);
+            assertEquals(0, fixture.negotiation.failures);
+        }
+        try (var fixture = new Fixture()) {
+            fixture.negotiation.start(4);
+            fixture.channel.close();
+            fixture.advance(60);
+            assertEquals(List.of(4), fixture.negotiation.requests);
+            assertEquals(0, fixture.negotiation.failures);
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final EmbeddedChannel channel = new EmbeddedChannel();
+        private final RecordingNegotiation negotiation = new RecordingNegotiation(this.channel);
+
+        private void advance(final int seconds) {
+            this.channel.advanceTimeBy(seconds, TimeUnit.SECONDS);
+            this.channel.runScheduledPendingTasks();
+        }
+
+        @Override
+        public void close() {
+            this.negotiation.onRemove();
+            this.channel.finishAndReleaseAll();
+        }
+    }
+
+    private static final class RecordingNegotiation extends ChunkRadiusNegotiation {
+        private final List<Integer> requests = new ArrayList<>();
+        private int failures;
+
+        private RecordingNegotiation(final EmbeddedChannel channel) {
+            super((UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                    new Class<?>[]{UserConnection.class}, (proxy, method, arguments) -> switch (method.getName()) {
+                        case "getChannel" -> channel;
+                        case "isPendingDisconnect" -> false;
+                        default -> throw new UnsupportedOperationException(method.getName());
+                    }));
+        }
+
+        @Override
+        protected boolean sendRequest(final int radius) {
+            this.requests.add(radius);
+            return true;
+        }
+
+        @Override
+        protected void fail() {
+            this.failures++;
+        }
+    }
+
+}
