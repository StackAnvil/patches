+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StoredObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.util.concurrent.ScheduledFuture;
+import net.raphimc.viabedrock.ViaBedrock;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+import java.util.concurrent.TimeUnit;
+
+public class ChunkRadiusNegotiation extends StoredObject {
+
+    private static final int RECOVERY_RADIUS = 8;
+    private ScheduledFuture<?> retry;
+    private int requestedRadius;
+    private int attempts;
+    private boolean joined;
+    private boolean spawned;
+    private volatile boolean removed;
+
+    public ChunkRadiusNegotiation(final UserConnection user) {
+        super(user);
+    }
+
+    public void start(final int radius) {
+        this.joined = true;
+        this.updateRequest(radius);
+        this.sendRequest(this.requestedRadius);
+    }
+
+    public int updateRequest(final int radius) {
+        this.cancelRetry();
+        this.requestedRadius = Math.clamp(radius, 2, ProtocolConstants.BEDROCK_REQUEST_CHUNK_RADIUS_MAX_RADIUS);
+        this.attempts = 0;
+        if (this.joined && !this.spawned && !this.removed) {
+            this.scheduleRetry(5);
+        }
+        return this.requestedRadius;
+    }
+
+    public void acknowledge() {
+        this.cancelRetry();
+    }
+
+    public void markSpawned() {
+        this.spawned = true;
+        this.cancelRetry();
+    }
+
+    @Override
+    public void onRemove() {
+        this.removed = true;
+        this.cancelRetry();
+    }
+
+    private void scheduleRetry(final int seconds) {
+        this.retry = this.user().getChannel().eventLoop().schedule(this::retry, seconds, TimeUnit.SECONDS);
+    }
+
+    private void retry() {
+        this.retry = null;
+        if (this.removed || !this.user().getChannel().isActive() || this.user().isPendingDisconnect()) {
+            return;
+        }
+        switch (++this.attempts) {
+            case 1 -> {
+                if (this.sendRequest(this.requestedRadius)) {
+                    this.scheduleRetry(5);
+                }
+            }
+            case 2 -> {
+                // Some servers ignore small radii until a larger request starts chunk delivery.
+                if (this.requestedRadius < RECOVERY_RADIUS && !this.sendRequest(RECOVERY_RADIUS)) {
+                    return;
+                }
+                this.scheduleRetry(20);
+            }
+            default -> this.fail();
+        }
+    }
+
+    private void cancelRetry() {
+        if (this.retry != null) {
+            this.retry.cancel(false);
+            this.retry = null;
+        }
+    }
+
+    protected boolean sendRequest(final int radius) {
+        try {
+            final PacketWrapper request = PacketWrapper.create(ServerboundBedrockPackets.REQUEST_CHUNK_RADIUS, this.user());
+            request.write(BedrockTypes.VAR_INT, radius); // radius
+            request.write(Types.BYTE, ProtocolConstants.BEDROCK_REQUEST_CHUNK_RADIUS_MAX_RADIUS); // max radius
+            request.sendToServer(BedrockProtocol.class);
+            if (radius != this.requestedRadius) {
+                ViaBedrock.getPlatform().getLogger().warning("Server did not acknowledge chunk radius "
+                        + this.requestedRadius + "; retrying with radius " + radius);
+            }
+            return true;
+        } catch (final Exception e) {
+            this.cancelRetry();
+            BedrockProtocol.kickForIllegalState(this.user(), "Failed to request Bedrock chunks.", e);
+            return false;
+        }
+    }
+
+    protected void fail() {
+        BedrockProtocol.kickForIllegalState(this.user(), "Server did not acknowledge the chunk radius. Please reconnect.");
+    }
+
+}
