+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class JsonUiProgramTest {
+
+    private static final String UI = """
+            {"namespace":"example","root":{"type":"panel","controls":[
+              {"first":{"type":"grid","collection_name":"first","grid_item_template":"example.row","bindings":[
+                {"binding_type":"collection_details","binding_collection_name":"first","binding_name":"#total","binding_name_override":"#maximum_grid_items"}]}},
+              {"second":{"type":"grid","collection_name":"second","grid_item_template":"example.row"}},
+              {"missing@example.absent":{}},
+              {"sibling":{"type":"label","text":"Still here"}}]},
+             "row":{"type":"panel","controls":[
+              {"caption":{"type":"label","bindings":[{"binding_type":"collection","binding_name":"#caption","binding_name_override":"#text"}]}},
+              {"options":{"type":"grid","collection_name":"options","grid_item_template":"example.option"}},
+              {"cross":{"type":"label","collection_name":"second","collection_index":0,"text":"#caption"}}]},
+             "option":{"type":"label","collection_index":"#collection_index","bindings":[
+              {"binding_collection_name":"options","binding_name":"#caption","binding_name_override":"#text"},
+              {"binding_type":"collection_details","binding_collection_name":"first","binding_name":"#total","binding_name_override":"#maximum_grid_items"}]}}
+            """;
+
+    private static JsonUiProgram program(final String definition) {
+        return new JsonUiProgram(List.of(Map.of("ui/example.json", definition.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    @Test
+    void namedCollectionsKeepIndependentLengthsAndNestedParentBindings() {
+        final var resolved = program(UI).resolve("example.root", new Bindings());
+        final var children = resolved.root().getAsJsonArray("children");
+        assertEquals(3, children.size());
+        assertEquals(2, children.get(0).getAsJsonObject().getAsJsonArray("children").size());
+        assertEquals(1, children.get(1).getAsJsonObject().getAsJsonArray("children").size());
+        assertEquals(2, children.get(0).getAsJsonObject().get("maximum_grid_items").getAsInt());
+        final var first = children.get(0).getAsJsonObject().getAsJsonArray("children").get(1).getAsJsonObject();
+        assertEquals("first-1", first.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        final var option = first.getAsJsonArray("children").get(1).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals("first-1-option", option.get("text").getAsString());
+        assertEquals("first", option.get("parent_collection").getAsString());
+        assertEquals(1, option.get("parent_index").getAsInt());
+        assertEquals(2, option.get("maximum_grid_items").getAsInt());
+        final var cross = first.getAsJsonArray("children").get(2).getAsJsonObject();
+        assertEquals("second-0", cross.get("text").getAsString());
+        assertEquals("first", cross.get("parent_collection").getAsString());
+        assertEquals(1, cross.get("parent_index").getAsInt());
+        assertEquals(java.util.Set.of("example.absent"), resolved.missingTemplates());
+        assertEquals("Still here", children.get(2).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void typedFactoriesAndProgramsResolveWithoutFormResponseData() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"panel","collection_name":"first","factory":{"control_ids":{"caption":"example.cell"}},
+                  "bindings":[{"binding_name":"#kinds","binding_name_override":"#collection_length"}]},
+                 "cell":{"type":"label","text":"#caption"}}
+                """);
+        final var bindings = new Bindings();
+        final var first = ui.resolve("example.root", bindings);
+        assertEquals(1, bindings.collectionReads.get("first"));
+        final var program = ui.export(first.requiredDefinitions(), new JsonObject());
+        assertFalse(program.has("form"));
+        final var replay = JsonUiProgram.fromProgram(program).resolve("example.root", new Bindings());
+        assertEquals(first.root(), replay.root());
+        assertEquals(2, replay.root().getAsJsonArray("children").size());
+        assertEquals("first-1", replay.root().getAsJsonArray("children").get(1).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void unsupportedCollectionRetainsAnError() {
+        assertThrows(IllegalArgumentException.class, () -> program("""
+                {"namespace":"example","root":{"type":"grid","collection_name":"unavailable","grid_item_template":"example.cell"},
+                 "cell":{"type":"label"}}
+                """).resolve("example.root", new Bindings()));
+    }
+
+    @Test
+    void singletonFactoriesKeepTheirScopeWithoutRepeatingEveryCollectionEntry() {
+        final var ui = program("""
+                {"namespace":"example","root":{"type":"factory","control_name":"example.cell"},
+                 "cell":{"type":"label","text":"Global caption"}}
+                """);
+        final var result = ui.resolve("example.root", new Bindings());
+        assertEquals(1, result.root().getAsJsonArray("children").size());
+        assertEquals("Global caption", result.root().getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+    }
+
+    @Test
+    void partialDefinitionsRetainLabelBindingsAndImageTypesAcrossLayers() {
+        final String lower = """
+                {"namespace":"example","root":{"type":"panel","collection_name":"first","collection_index":0,"controls":[
+                  {"caption@example.caption":{}},{"icon@example.icon":{}}]},
+                 "caption":{"type":"label","text":"#caption","offset":[0,1]},
+                 "icon":{"type":"image","texture":"textures/ui/lower","size":[16,16]}}
+                """;
+        final String upper = """
+                {"namespace":"example","caption":{"font_size":"small","offset":[2,3]},
+                 "icon":{"texture":"textures/ui/upper"}}
+                """;
+        final var ui = new JsonUiProgram(List.of(Map.of("ui/example.json", lower.getBytes(StandardCharsets.UTF_8)),
+                Map.of("ui/example.json", upper.getBytes(StandardCharsets.UTF_8))));
+        final var scene = ui.resolve("example.root", new Bindings());
+        final var children = scene.root().getAsJsonArray("children");
+        final var caption = children.get(0).getAsJsonObject();
+        assertEquals("label", caption.get("type").getAsString());
+        assertEquals("first-0", caption.get("text").getAsString());
+        assertEquals("small", caption.get("font_size").getAsString());
+        assertEquals(2, caption.getAsJsonArray("offset").get(0).getAsInt());
+        final var icon = children.get(1).getAsJsonObject();
+        assertEquals("image", icon.get("type").getAsString());
+        assertTrue(icon.get("texture").getAsString().contains("upper"));
+        assertEquals(16, icon.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(scene.root(), JsonUiProgram.fromProgram(ui.export(scene.requiredDefinitions(), new JsonObject()))
+                .resolve("example.root", new Bindings()).root());
+    }
+
+    @Test
+    void partialDefinitionsPreserveTheirParentUntilAnExplicitParentChangesIt() {
+        final String lower = """
+                {"namespace":"example","first":{"type":"label","text":"First","size":[10,10]},
+                 "second":{"type":"image","texture":"textures/ui/second","size":[20,20]},
+                 "root@first":{"offset":[1,2]}}
+                """;
+        final Map<String, byte[]> base = Map.of("ui/example.json", lower.getBytes(StandardCharsets.UTF_8));
+        final Map<String, byte[]> partial = Map.of("ui/example.json", """
+                {"namespace":"example","root":{"offset":[3,4]}}
+                """.getBytes(StandardCharsets.UTF_8));
+        final var inherited = new JsonUiProgram(List.of(base, partial)).resolve("example.root", new Bindings()).root();
+        assertEquals("label", inherited.get("type").getAsString());
+        assertEquals("First", inherited.get("text").getAsString());
+        assertEquals(3, inherited.getAsJsonArray("offset").get(0).getAsInt());
+        final Map<String, byte[]> replacementParent = Map.of("ui/example.json", """
+                {"namespace":"example","root@second":{"alpha":0.5}}
+                """.getBytes(StandardCharsets.UTF_8));
+        final var replaced = new JsonUiProgram(List.of(base, partial, replacementParent))
+                .resolve("example.root", new Bindings()).root();
+        assertEquals("image", replaced.get("type").getAsString());
+        assertFalse(replaced.has("text"));
+        assertEquals(20, replaced.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(3, replaced.getAsJsonArray("offset").get(0).getAsInt());
+        assertEquals(0.5, replaced.get("alpha").getAsDouble());
+    }
+
+    @Test
+    void upperControlsArraysReplaceLowerArraysWithoutMergingTheirChildren() {
+        final var ui = new JsonUiProgram(List.of(Map.of("ui/example.json", """
+                {"namespace":"example","root":{"type":"panel","size":[90,40],"controls":[
+                  {"old":{"type":"label","text":"Old"}}]}}
+                """.getBytes(StandardCharsets.UTF_8)), Map.of("ui/example.json", """
+                {"namespace":"example","root":{"type":"panel","controls":[
+                  {"new":{"type":"label","text":"New"}}]}}
+                """.getBytes(StandardCharsets.UTF_8))));
+        final var root = ui.resolve("example.root", new Bindings()).root();
+        assertEquals(90, root.getAsJsonArray("size").get(0).getAsInt());
+        final var children = root.getAsJsonArray("children");
+        assertEquals(1, children.size());
+        assertEquals("New", children.get(0).getAsJsonObject().get("text").getAsString());
+    }
+
+    private static final class Bindings implements UiBindings {
+
+        private final Map<String, Integer> collectionReads = new HashMap<>();
+
+        @Override
+        public Map<String, JsonElement> globals() {
+            return Map.of("#kinds", JsonParser.parseString("[\"caption\",\"caption\"]"));
+        }
+
+        @Override
+        public String defaultCollection() {
+            return "first";
+        }
+
+        @Override
+        public Collection collection(final String name, final Scope parent) {
+            this.collectionReads.merge(name, 1, Integer::sum);
+            final List<Map<String, JsonElement>> rows = switch (name) {
+                case "first" -> List.of(Map.of("#caption", new JsonPrimitive("first-0")), Map.of("#caption", new JsonPrimitive("first-1")));
+                case "second" -> List.of(Map.of("#caption", new JsonPrimitive("second-0")));
+                case "options" -> List.of(Map.of("#caption", new JsonPrimitive(parent.collection() + "-" + parent.index() + "-option")));
+                default -> throw new IllegalArgumentException("Unsupported collection");
+            };
+            return new Collection(rows, Map.of("#total", new JsonPrimitive(rows.size())));
+        }
+
+        @Override
+        public Map<String, JsonElement> variables(final Scope scope) {
+            if (scope == null) {
+                return Map.of();
+            }
+            final String caption = scope.collection().equals("options")
+                    ? scope.parent().collection() + "-" + scope.parent().index() + "-option" : scope.collection() + "-" + scope.index();
+            return Map.of("#caption", new JsonPrimitive(caption));
+        }
+
+        @Override
+        public Map<String, JsonElement> bindings(final Scope scope) {
+            final Map<String, JsonElement> result = new HashMap<>(this.globals());
+            result.putAll(this.variables(scope));
+            return result;
+        }
+
+        @Override
+        public String factoryKey() {
+            return "";
+        }
+
+        @Override
+        public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> resolved, final Scope scope) {
+            if (scope != null && scope.parent() != null) {
+                node.addProperty("parent_collection", scope.parent().collection());
+                node.addProperty("parent_index", scope.parent().index());
+            }
+        }
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/ServerCustomFormUiTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/ServerCustomFormUiTest.java
