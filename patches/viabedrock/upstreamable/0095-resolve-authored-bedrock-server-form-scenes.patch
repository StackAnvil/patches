+            final JsonElement childControls = resolveValue(control.get("controls"), values, 0);
+            if (childControls.isJsonArray()) {
+                this.children(childControls.getAsJsonArray(), children, values, selectedScope, depth, stateControls(node), manualGrid(node));
+            } else if (!childControls.isJsonNull()) {
+                throw new IllegalArgumentException("Invalid UI controls collection");
+            }
+            if (control.has("factory") && control.get("factory").isJsonObject()) {
+                this.factory(control.getAsJsonObject("factory"), node, children, values, selectedScope, depth);
+            }
+            if ("factory".equals(string(control, "type")) && (control.has("control_ids") || control.has("control_name"))) {
+                this.factory(control, node, children, values, selectedScope, depth);
+            }
+            if ("grid".equals(string(control, "type")) && control.has("grid_item_template")) {
+                this.collection(UiExpression.text(resolveValue(control.get("grid_item_template"), values, 0)), children, values, selectedScope, string(node, "collection_name"), depth);
+            }
+            node.add("children", children);
+            return node;
+        }
+
+        private JsonObject expandChild(final String reference, final JsonObject overrides,
+                                       final Map<String, JsonElement> inherited, final UiBindings.Scope scope, final ManualGrid parentGrid, final int depth) {
+            try {
+                return this.expand(reference, overrides, inherited, scope, parentGrid, depth);
+            } catch (final MissingControlException missing) {
+                // The native factory logs a missing base and returns an empty child, retaining its siblings.
+                this.missingTemplates.add(missing.getMessage());
+                return null;
+            }
+        }
+
+        private void children(final JsonArray input, final JsonArray output, final Map<String, JsonElement> values,
+                              final UiBindings.Scope scope, final int depth, final Set<String> stateControls, final ManualGrid grid) {
+            for (final JsonElement element : input) {
+                if (!element.isJsonObject()) {
+                    throw new IllegalArgumentException("Invalid UI child");
+                }
+                for (final Map.Entry<String, JsonElement> entry : element.getAsJsonObject().entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        throw new IllegalArgumentException("Invalid UI control");
+                    }
+                    final String name = substitute(entry.getKey(), values).split("@", 2)[0];
+                    final Map<String, JsonElement> context;
+                    if (stateControls.contains(name)) {
+                        context = new HashMap<>(values);
+                        context.put("$__state_branch", new JsonPrimitive(true));
+                    } else {
+                        context = values;
+                    }
+                    final JsonObject child = this.expandChild(entry.getKey(), entry.getValue().getAsJsonObject(), context, scope, grid, depth + 1);
+                    if (child != null) {
+                        output.add(child);
+                    }
+                }
+            }
+        }
+
+        private static ManualGrid manualGrid(final JsonObject node) {
+            if (!"grid".equals(string(node, "type")) || !string(node, "grid_item_template").isEmpty()
+                    || string(node, "collection_name").isEmpty()) {
+                return null;
+            }
+            return new ManualGrid(string(node, "collection_name"), integerPair(node.get("grid_dimensions"), "grid dimensions")[0]);
+        }
+
+        private static int[] integerPair(final JsonElement value, final String property) {
+            if (value == null || value.isJsonNull()) {
+                return new int[] {0, 0};
+            }
+            if (!value.isJsonArray() || value.getAsJsonArray().size() != 2) {
+                throw new IllegalArgumentException("Invalid UI " + property);
+            }
+            final int[] pair = new int[2];
+            for (int axis = 0; axis < 2; axis++) {
+                final JsonElement number = value.getAsJsonArray().get(axis);
+                if (!number.isJsonPrimitive() || !number.getAsJsonPrimitive().isNumber()) {
+                    throw new IllegalArgumentException("Invalid UI " + property);
+                }
+                try {
+                    pair[axis] = number.getAsBigDecimal().intValueExact();
+                } catch (final ArithmeticException malformed) {
+                    throw new IllegalArgumentException("Invalid UI " + property, malformed);
+                }
+                if (pair[axis] < 0) {
+                    throw new IllegalArgumentException("Invalid UI " + property);
+                }
+            }
+            return pair;
+        }
+
+        private static Set<String> stateControls(final JsonObject node) {
+            final List<String> properties = switch (string(node, "type")) {
+                case "slider" -> List.of("default_control", "hover_control");
+                case "slider_box" -> List.of("default_control", "hover_control", "locked_control", "indent_control");
+                default -> List.of();
+            };
+            final Set<String> names = new HashSet<>();
+            for (final String property : properties) {
+                final String name = string(node, property);
+                if (!name.isEmpty()) {
+                    names.add(name);
+                }
+            }
+            return names;
+        }
+
+        private void factory(final JsonObject factory, final JsonObject node, final JsonArray children,
+                             final Map<String, JsonElement> values, final UiBindings.Scope scope, final int depth) {
+            if (factory.has("control_name")) {
+                final String reference = UiExpression.text(resolveValue(factory.get("control_name"), values, 0));
+                if ("factory".equals(string(node, "type"))) {
+                    final JsonObject child = this.expandChild(reference, new JsonObject(), values, scope, null, depth + 1);
+                    if (child != null) {
+                        children.add(child);
+                    }
+                } else {
+                    this.collection(reference, children, values, scope, string(node, "collection_name"), depth);
+                }
+            } else if (factory.has("control_ids") && factory.get("control_ids").isJsonObject()) {
+                final JsonObject ids = factory.getAsJsonObject("control_ids");
+                if ("factory".equals(string(node, "type"))) {
+                    final JsonElement selected = ids.get(this.bindings.factoryKey());
+                    if (selected != null) {
+                        final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, scope, null, depth + 1);
+                        if (child != null) {
+                            children.add(child);
+                        }
+                    }
+                } else {
+                    final JsonElement collection = values.get("#collection_length");
+                    final JsonElement entries = collection != null && collection.isJsonArray() ? collection
+                            : values.get(UiExpression.text(collection));
+                    if (entries != null && entries.isJsonArray()) {
+                        int index = 0;
+                        for (final JsonElement entry : entries.getAsJsonArray()) {
+                            final int elementIndex = index++;
+                            final JsonElement selected = ids.get(UiExpression.text(entry));
+                            if (selected != null) {
+                                final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, this.scope(string(node, "collection_name"), elementIndex, scope), null, depth + 1);
+                                if (child != null) {
+                                    children.add(child);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        private void collection(final String template, final JsonArray children, final Map<String, JsonElement> values,
+                                final UiBindings.Scope scope, final String collection, final int depth) {
+            if (template.isEmpty()) {
+                throw new IllegalArgumentException("Empty UI collection template");
+            }
+            final String name = collection.isEmpty() ? this.bindings.defaultCollection() : collection;
+            final UiBindings.Collection entries = this.collection(name, scope);
+            if (entries.entries().size() > MAX_NODES) {
+                throw new IllegalArgumentException("UI collection exceeds limits");
+            }
+            for (int index = 0; index < entries.entries().size(); index++) {
+                final Map<String, JsonElement> context = new HashMap<>(values);
+                context.put("#collection_index", new JsonPrimitive(index));
+                final UiBindings.Scope childScope = new UiBindings.Scope(name, index, scope);
+                final JsonObject child = this.expandChild(template, new JsonObject(), context, childScope, null, depth + 1);
+                if (child != null) {
+                    children.add(child);
+                }
+            }
+        }
+
+        private void bind(final JsonObject control, final Map<String, JsonElement> values, final UiBindings.Scope scope) {
+            final JsonElement propertyBag = resolveValue(control.get("property_bag"), values, 0);
+            if (propertyBag.isJsonObject()) {
+                for (final Map.Entry<String, JsonElement> entry : propertyBag.getAsJsonObject().entrySet()) {
+                    values.put(entry.getKey(), resolveValue(entry.getValue(), values, 0));
+                }
+            }
+            final JsonElement bindings = control.has("bindings") && control.get("bindings").isJsonArray()
+                    ? control.get("bindings") : resolveValue(control.get("bindings"), values, 0);
+            if (!bindings.isJsonArray()) {
+                return;
+            }
+            for (final JsonElement element : bindings.getAsJsonArray()) {
+                final JsonObject binding = element.getAsJsonObject();
+                final String bindingType = bindingName(binding, "binding_type", values);
+                if (bindingType.equals("none") || UiExpression.truth(resolveValue(binding.get("ignored"), values, 0))) {
+                    continue;
+                }
+                final String sourceControl = bindingName(binding, "source_control_name", values);
+                final Map<String, JsonElement> source = sourceControl.isEmpty() ? values : this.controls.getOrDefault(sourceControl, values);
+                final String expression = binding.has("source_property_name") ? bindingName(binding, "source_property_name", values) : bindingName(binding, "binding_name", values);
+                if (expression.isEmpty()) {
+                    continue;
+                }
+                final String collection = bindingName(binding, "binding_collection_name", values);
+                final Map<String, JsonElement> engine = this.engine(scope, collection, "collection_details".equals(bindingType));
+                final JsonElement value = !"view".equals(bindingType) && sourceControl.isEmpty() && engine.containsKey(expression)
+                        ? engine.get(expression) : resolveValue(new JsonPrimitive(expression), source, 0);
+                final String target = binding.has("target_property_name") ? bindingName(binding, "target_property_name", values)
+                        : binding.has("binding_name_override") ? bindingName(binding, "binding_name_override", values) : expression;
+                if (target.startsWith("#") && value != null) {
+                    values.put(target, value);
+                }
+            }
+        }
+    }
+
+    private static final class Builtins {
+
+        private static final Map<String, byte[]> FILES = Collections.unmodifiableMap(builtinFiles());
+        private static final String IDENTITY = identity();
+
+        private static String identity() {
+            try {
+                final var digest = MessageDigest.getInstance("SHA-256");
+                FILES.entrySet().stream().sorted(Map.Entry.comparingByKey()).forEach(entry -> {
+                    digest.update(entry.getKey().getBytes(StandardCharsets.UTF_8));
+                    digest.update((byte) 0);
+                    digest.update(ByteBuffer.allocate(4).putInt(entry.getValue().length).array());
+                    digest.update(entry.getValue());
+                });
+                return HexFormat.of().formatHex(digest.digest());
+            } catch (final NoSuchAlgorithmException impossible) {
+                throw new IllegalStateException(impossible);
+            }
+        }
+    }
+
+    private static final class MissingControlException extends IllegalArgumentException {
+
+        private MissingControlException(final String control) {
+            super(control);
+        }
+
+    }
+
+    private record CollectionKey(String name, UiBindings.Scope parent) { }
+
+    public record Resolution(JsonObject root, Set<String> requiredDefinitions, Set<String> missingTemplates) { }
+
+    private record Definition(JsonObject value, String parent) { }
+
+    private record ManualGrid(String collection, int columns) { }
+
+}
