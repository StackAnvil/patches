+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeFormMessageTest {
+
+    @Test
+    void retainsUnsignedFormIdentityAndUnicodeSceneWithoutTrailingBytes() {
+        final var buffer = Unpooled.buffer();
+        try {
+            final var message = new NativeFormMessage(-1, "{\"caption\":\"é 😀 §a\"}");
+            NativeFormMessage.TYPE.write(buffer, message);
+            assertEquals(message, NativeFormMessage.TYPE.read(buffer));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void rejectsUnsupportedProtocolTruncationAndOversizedUnicodePayloads() {
+        final var buffer = Unpooled.buffer();
+        try {
+            NativeFormMessage.TYPE.write(buffer, new NativeFormMessage(7, "{}"));
+            final byte[] bytes = new byte[buffer.readableBytes()];
+            buffer.getBytes(0, bytes);
+            buffer.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeFormMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(bytes).setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeFormMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(bytes).writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeFormMessage.TYPE.read(buffer));
+            buffer.clear().writeBytes(bytes).writerIndex(bytes.length - 1);
+            assertThrows(IllegalArgumentException.class, () -> NativeFormMessage.TYPE.read(buffer));
+            buffer.clear();
+            assertThrows(IllegalArgumentException.class, () -> NativeFormMessage.TYPE.write(buffer,
+                    new NativeFormMessage(1, "é".repeat(NativeFormMessage.MAX_PAYLOAD_BYTES / 2 + 1))));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
