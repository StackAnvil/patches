+        private final Map<Class<?>, Object> storage = new HashMap<>();
+        private final InventoryTracker inventory = new InventoryTracker(this.user);
+        private final EntityTracker entities = mock(EntityTracker.class);
+        private final TestProtocol protocol = new TestProtocol();
+        private final List<byte[]> sent = new ArrayList<>();
+        private final MockedStatic<ViaBedrock> via = mockStatic(ViaBedrock.class);
+        private final MockedStatic<PacketWrapper> wrappers = mockStatic(PacketWrapper.class);
+
+        private OpeningFixture() {
+            when(this.user.get(any())).thenAnswer(call -> this.storage.get(call.getArgument(0)));
+            final var channels = new ChannelStorage();
+            channels.addChannels(List.of(NativeContainerMessage.CHANNEL));
+            this.storage.put(ChannelStorage.class, channels);
+            this.storage.put(NativeContainerUiState.class, new NativeContainerUiState());
+            this.storage.put(ResourcePackStorage.class, packs());
+            this.storage.put(InventoryTracker.class, this.inventory);
+            this.storage.put(EntityTracker.class, this.entities);
+            final var player = new ClientPlayerEntity(this.user, 1, new UUID(0, 1), new PlayerAbilities(1, (byte) 0, (byte) 0));
+            player.setPosition(new Position3f(0.5F, 64.5F, 0.5F));
+            when(this.entities.getClientPlayer()).thenReturn(player);
+            final var chunks = mock(ChunkTracker.class);
+            when(chunks.getChunkSection(POSITION)).thenReturn(new BedrockChunkSectionImpl(true));
+            final var tag = new CompoundTag();
+            tag.putString("CustomName", "actor.key");
+            when(chunks.getBlockEntity(POSITION)).thenReturn(new BedrockBlockEntity(POSITION, tag));
+            this.storage.put(ChunkTracker.class, chunks);
+            this.storage.put(BlockStateRewriter.class, mock(BlockStateRewriter.class));
+            this.storage.put(ItemRewriter.class, mock(ItemRewriter.class));
+            final var platform = mock(ViaBedrockPlatform.class);
+            when(platform.getLogger()).thenReturn(Logger.getAnonymousLogger());
+            this.via.when(ViaBedrock::getPlatform).thenReturn(platform);
+            this.wrappers.when(() -> PacketWrapper.create(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user))
+                    .thenAnswer(call -> outbound(ClientboundPackets26_3.CUSTOM_PAYLOAD, this.user, this.sent));
+        }
+
+        private Entity actor(final Object name, final EntityDataTypesBedrock type) {
+            final var actor = new Entity(this.user, 123, 45, "minecraft:npc", 47, new UUID(0, 2), null);
+            actor.entityData().put(ActorDataIds.NAME, new EntityData(4, type, name));
+            when(this.entities.getEntityByUid(123)).thenReturn(actor);
+            return actor;
+        }
+
+        private void open(final long actorId) throws Exception {
+            final var input = Unpooled.buffer();
+            try {
+                input.writeByte(8);
+                input.writeByte(ContainerType.CONTAINER.getValue());
+                BedrockTypes.BLOCK_POSITION.write(input, POSITION);
+                BedrockTypes.VAR_LONG.write(input, actorId);
+                final PacketWrapper packet = spy(new PacketWrapperImpl(ClientboundBedrockPackets.CONTAINER_OPEN, input, this.user));
+                doAnswer(call -> {
+                    final var output = Unpooled.buffer();
+                    try {
+                        packet.writeToBuffer(output);
+                        final byte[] bytes = new byte[output.readableBytes()];
+                        output.readBytes(bytes);
+                        this.sent.add(bytes);
+                    } finally {
+                        output.release();
+                    }
+                    return null;
+                }).when(packet).send(BedrockProtocol.class);
+                this.protocol.translate(packet);
+                assertTrue(packet.isCancelled());
+                assertEquals(0, input.readableBytes());
+                assertEquals(2, this.sent.size());
+                final var open = Unpooled.wrappedBuffer(this.sent.getFirst());
+                try {
+                    assertEquals(ClientboundPackets26_3.OPEN_SCREEN.getId(), Types.VAR_INT.readPrimitive(open));
+                    assertEquals(8, Types.VAR_INT.readPrimitive(open));
+                    assertEquals(BedrockProtocol.MAPPINGS.getJavaMenuId("minecraft:generic_9x3"), Types.VAR_INT.readPrimitive(open));
+                    assertEquals(TextUtil.textComponentToNbt(this.inventory.getCurrentContainer().title()), Types.TAG.read(open));
+                    assertFalse(open.isReadable());
+                } finally {
+                    open.release();
+                }
+            } finally {
+                input.release();
+            }
+        }
+
+        private NativeContainerMessage message() {
+            final var payload = Unpooled.wrappedBuffer(this.sent.get(1));
+            try {
+                assertEquals(ClientboundPackets26_3.CUSTOM_PAYLOAD.getId(), Types.VAR_INT.readPrimitive(payload));
+                assertEquals(NativeContainerMessage.CHANNEL, Types.STRING.read(payload));
+                final var message = NativeContainerMessage.TYPE.read(payload);
+                assertFalse(payload.isReadable());
+                return message;
+            } finally {
+                payload.release();
+            }
+        }
+
+        @Override
+        public void close() {
+            this.wrappers.close();
+            this.via.close();
+        }
+    }
+
+    private static final class TestProtocol extends BedrockProtocol {
+
+        private TestProtocol() {
+            InventoryPackets.register(this);
+        }
+
+        private void translate(final PacketWrapper packet) throws Exception {
+            final var mapping = this.clientboundMappings.mappedPacket(State.PLAY, packet.getId());
+            mapping.applyType(packet);
+            mapping.handler().handle(packet);
+        }
+    }
+
+}
