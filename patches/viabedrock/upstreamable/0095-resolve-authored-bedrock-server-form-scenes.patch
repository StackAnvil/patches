@@ -0,0 +1,304 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonNull;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.regex.Pattern;
+
+/** Bounded JSON UI binding expressions. No host code or external resources are evaluated. */
+public final class UiExpression {
+
+    private static final int MAX_STRING_BYTES = 1 << 20;
+    private static final Pattern INTEGER_PREFIX = Pattern.compile("^[\\t\\n\\r ]*[+-]?[0-9]+");
+    private static final Pattern FLOAT_VALUE = Pattern.compile("[+-]?(?:[0-9]+\\.[0-9]*|[0-9]*\\.[0-9]+)(?:[eE][+-]?[0-9]+)?");
+    private static final Pattern STRING_PREFIX = Pattern.compile("%\\.[0-9]{1,5}s");
+
+    private final String input;
+    private final Function<String, JsonElement> values;
+    private int offset;
+    private int depth;
+
+    private UiExpression(final String input, final Function<String, JsonElement> values) {
+        if (input.length() > 8192) {
+            throw new IllegalArgumentException("UI expression is too long");
+        }
+        this.input = input;
+        this.values = values;
+    }
+
+    public static JsonElement evaluate(final String input, final Map<String, JsonElement> values) {
+        return evaluate(input, key -> values.getOrDefault(key, JsonNull.INSTANCE));
+    }
+
+    public static JsonElement evaluate(final String input, final Function<String, JsonElement> values) {
+        final UiExpression parser = new UiExpression(input, values);
+        final JsonElement result = parser.expression(0);
+        parser.space();
+        if (parser.offset != input.length()) {
+            throw new IllegalArgumentException("Unexpected UI expression token");
+        }
+        return result;
+    }
+
+    public static boolean truth(final JsonElement value) {
+        if (value == null || value.isJsonNull()) {
+            return false;
+        }
+        if (!value.isJsonPrimitive()) {
+            return value.isJsonArray() && !value.getAsJsonArray().isEmpty();
+        }
+        final JsonPrimitive primitive = value.getAsJsonPrimitive();
+        if (primitive.isBoolean()) {
+            return primitive.getAsBoolean();
+        }
+        if (primitive.isNumber()) {
+            return primitive.getAsDouble() != 0;
+        }
+        return !primitive.getAsString().isEmpty();
+    }
+
+    public static String text(final JsonElement value) {
+        return value == null || value.isJsonNull() ? "" : value.isJsonPrimitive() ? value.getAsString() : value.toString();
+    }
+
+    private JsonElement expression(final int minimum) {
+        if (++this.depth > 64) {
+            throw new IllegalArgumentException("UI expression is too deep");
+        }
+        try {
+            JsonElement left = this.atom();
+            while (true) {
+                this.space();
+                final int start = this.offset;
+                final String operator = this.operator();
+                final int precedence = precedence(operator);
+                if (precedence < minimum) {
+                    this.offset = start;
+                    return left;
+                }
+                left = apply(operator, left, this.expression(precedence + 1));
+            }
+        } finally {
+            this.depth--;
+        }
+    }
+
+    private JsonElement atom() {
+        this.space();
+        if (this.word("not")) {
+            return new JsonPrimitive(!truth(this.expression(6)));
+        }
+        if (this.take('(')) {
+            final JsonElement value = this.expression(0);
+            this.space();
+            if (!this.take(')')) {
+                throw new IllegalArgumentException("Unclosed UI expression");
+            }
+            return value;
+        }
+        if (this.take('-')) {
+            return number(-numeric(this.atom()));
+        }
+        if (this.take('\'')) {
+            final StringBuilder value = new StringBuilder();
+            while (this.offset < this.input.length()) {
+                final char character = this.input.charAt(this.offset++);
+                if (character == '\'') {
+                    return new JsonPrimitive(value.toString());
+                }
+                if (character == '\\' && this.offset < this.input.length()) {
+                    value.append(this.input.charAt(this.offset++));
+                } else {
+                    value.append(character);
+                }
+            }
+            throw new IllegalArgumentException("Unclosed UI string");
+        }
+        final int start = this.offset;
+        while (this.offset < this.input.length()) {
+            final char character = this.input.charAt(this.offset);
+            if (!Character.isLetterOrDigit(character) && "_$#.:".indexOf(character) < 0) {
+                break;
+            }
+            this.offset++;
+        }
+        if (start == this.offset) {
+            throw new IllegalArgumentException("Missing UI expression value");
+        }
+        final String token = this.input.substring(start, this.offset);
+        if ("true".equals(token) || "false".equals(token)) {
+            return new JsonPrimitive(Boolean.parseBoolean(token));
+        }
+        if (token.charAt(0) == '#' || token.charAt(0) == '$') {
+            final JsonElement value = this.values.apply(token);
+            return value == null ? JsonNull.INSTANCE : value;
+        }
+        try {
+            Double.parseDouble(token);
+            return generated(token);
+        } catch (final NumberFormatException invalid) {
+            throw new IllegalArgumentException("Unsupported UI expression value", invalid);
+        }
+    }
+
+    private String operator() {
+        if (this.word("or")) {
+            return "or";
+        }
+        if (this.word("and")) {
+            return "and";
+        }
+        if (this.offset < this.input.length() && "=<>+-*/".indexOf(this.input.charAt(this.offset)) >= 0) {
+            final char operator = this.input.charAt(this.offset++);
+            if ((operator == '<' || operator == '>') && this.take('=')) {
+                return operator + "=";
+            }
+            return Character.toString(operator);
+        }
+        return "";
+    }
+
+    private static int precedence(final String operator) {
+        return switch (operator) {
+            case "or" -> 0;
+            case "and" -> 1;
+            case "=", "<", ">", "<=", ">=" -> 2;
+            case "+", "-" -> 3;
+            case "*", "/" -> 4;
+            default -> -1;
+        };
+    }
+
+    private static JsonElement apply(final String operator, final JsonElement left, final JsonElement right) {
+        final boolean strings = isString(left) || isString(right);
+        return switch (operator) {
+            case "or" -> new JsonPrimitive(truth(left) || truth(right));
+            case "and" -> new JsonPrimitive(truth(left) && truth(right));
+            case "=" -> new JsonPrimitive(left == null || left.isJsonNull() || right == null || right.isJsonNull()
+                    ? strings ? text(left).equals(text(right)) : numeric(left) == numeric(right)
+                    : strings ? isString(left) && isString(right) ? text(left).equals(text(right))
+                    : (isString(left) ? text(left).isEmpty() && numeric(right) == 0 : text(right).isEmpty() && numeric(left) == 0)
+                    : numeric(left) == numeric(right));
+            case "+" -> strings ? generated(text(left) + text(right)) : arithmetic(numeric(left) + numeric(right), left, right);
+            case "-" -> strings ? generated(isString(left) && isString(right) ? text(left).replace(text(right), "") : text(left)) : arithmetic(numeric(left) - numeric(right), left, right);
+            case "*" -> isString(left) && STRING_PREFIX.matcher(text(left)).matches()
+                    ? truncate(text(right), Integer.parseInt(text(left).substring(2, text(left).length() - 1)))
+                    : isString(left) ? new JsonPrimitive("") : isString(right) ? left : arithmetic(numeric(left) * numeric(right), left, right);
+            case "/" -> {
+                if (isString(left) || isString(right)) {
+                    throw new IllegalArgumentException("Unsupported UI string division");
+                }
+                yield arithmetic(numeric(left) / numeric(right), left, right);
+            }
+            case "<" -> new JsonPrimitive(numeric(left) < numeric(right));
+            case ">" -> new JsonPrimitive(numeric(left) > numeric(right));
+            case "<=" -> new JsonPrimitive(numeric(left) <= numeric(right));
+            case ">=" -> new JsonPrimitive(numeric(left) >= numeric(right));
+            default -> throw new IllegalArgumentException("Unsupported UI operator");
+        };
+    }
+
+    private static JsonElement truncate(final String value, final int count) {
+        final byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        return generated(new String(Arrays.copyOf(bytes, Math.min(count, bytes.length)), StandardCharsets.UTF_8));
+    }
+
+    /** Native string operators feed their output back into the unquoted-value parser. */
+    private static JsonElement generated(final String value) {
+        if (value.length() > MAX_STRING_BYTES || value.getBytes(StandardCharsets.UTF_8).length > MAX_STRING_BYTES) {
+            throw new IllegalArgumentException("UI expression string exceeds limits");
+        }
+        final var integer = INTEGER_PREFIX.matcher(value);
+        if (integer.find()) {
+            try {
+                return new JsonPrimitive(Integer.parseInt(integer.group().trim()));
+            } catch (final NumberFormatException invalid) {
+                throw new IllegalArgumentException("UI integer exceeds native bounds", invalid);
+            }
+        }
+        if (FLOAT_VALUE.matcher(value).matches()) {
+            final float parsed = Float.parseFloat(value);
+            if (Float.isFinite(parsed)) {
+                return new JsonPrimitive(parsed);
+            }
+        }
+        if (value.equals("true") || value.equals("false")) {
+            return new JsonPrimitive(Boolean.parseBoolean(value));
+        }
+        return new JsonPrimitive(value);
+    }
+
+    private static boolean isString(final JsonElement value) {
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString();
+    }
+
+    private static double numeric(final JsonElement value) {
+        if (value == null || value.isJsonNull()) {
+            return 0;
+        }
+        if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean()) {
+            return value.getAsBoolean() ? 1 : 0;
+        }
+        try {
+            return Double.parseDouble(text(value));
+        } catch (final NumberFormatException invalid) {
+            return 0;
+        }
+    }
+
+    private static JsonElement arithmetic(final double value, final JsonElement left, final JsonElement right) {
+        if (!Double.isFinite(value)) {
+            throw new IllegalArgumentException("Non-finite UI expression result");
+        }
+        final boolean integral = left.isJsonPrimitive() && right.isJsonPrimitive()
+                && left.toString().matches("-?[0-9]+") && right.toString().matches("-?[0-9]+");
+        if (integral) {
+            if (value < Integer.MIN_VALUE || value > Integer.MAX_VALUE) {
+                throw new IllegalArgumentException("UI integer exceeds native bounds");
+            }
+            return new JsonPrimitive((int) value);
+        }
+        return new JsonPrimitive((float) value);
+    }
+
+    private static JsonElement number(final double value) {
+        if (!Double.isFinite(value)) {
+            throw new IllegalArgumentException("Non-finite UI expression result");
+        }
+        return new JsonPrimitive(value);
+    }
+
+    private void space() {
+        while (this.offset < this.input.length() && Character.isWhitespace(this.input.charAt(this.offset))) {
+            this.offset++;
+        }
+    }
+
+    private boolean take(final char character) {
+        if (this.offset < this.input.length() && this.input.charAt(this.offset) == character) {
+            this.offset++;
+            return true;
+        }
+        return false;
+    }
+
+    private boolean word(final String word) {
+        if (this.input.startsWith(word, this.offset) && (this.offset + word.length() == this.input.length()
+                || !Character.isLetterOrDigit(this.input.charAt(this.offset + word.length()))
+                && this.input.charAt(this.offset + word.length()) != '_')) {
+            this.offset += word.length();
+            return true;
+        }
+        return false;
+    }
+
+}
