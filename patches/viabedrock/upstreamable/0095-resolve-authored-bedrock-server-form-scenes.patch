+            }
+            final String textProperty = "label".equals(string(node, "type")) ? "text"
+                    : "custom".equals(string(node, "type")) && "hover_text_renderer".equals(string(node, "renderer")) ? "hover_text" : "";
+            if (!textProperty.isEmpty() && node.has(textProperty) && !node.get(textProperty).isJsonNull()) {
+                String text = UiExpression.text(node.get(textProperty));
