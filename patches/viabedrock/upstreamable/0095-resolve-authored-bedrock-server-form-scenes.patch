+        assertNotNull(scene);
+        assertEquals(Map.of(2, "Last", 0, "First"), ServerFormUi.presentation(scene).buttons());
+        final var rows = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertFalse(rows.get(1).getAsJsonObject().get("visible").getAsBoolean());
+        assertEquals(2, rows.get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject().get("action").getAsInt());
+    }
