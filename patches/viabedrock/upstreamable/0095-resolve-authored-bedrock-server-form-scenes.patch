+                }
+            }
+            node.addProperty("visible", visible);
+            if (!node.has("type")) {
+                node.addProperty("type", "panel");
+            }
+            if (node.has("texture")) {
+                final String texture = UiExpression.text(node.get("texture"));
+                if (!texture.isEmpty() && safePath(texture)) {
