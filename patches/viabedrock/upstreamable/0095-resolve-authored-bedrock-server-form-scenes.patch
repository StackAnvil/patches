+package net.raphimc.viabedrock.api.model;
+
+import io.netty.buffer.Unpooled;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeContainerMessageTest {
+
+    @Test
+    void roundTripsBothMenuFamiliesAndUnicodeWithoutInventorySnapshots() {
+        for (final var kind : ContainerUi.Kind.values()) {
+            final var message = new NativeContainerMessage(7, Long.MAX_VALUE, kind, "§aTitle 😀", "{\"definitions\":{}}");
+            final var buffer = Unpooled.buffer();
+            try {
+                NativeContainerMessage.TYPE.write(buffer, message);
+                assertEquals(message, NativeContainerMessage.TYPE.read(buffer));
+                assertFalse(buffer.isReadable());
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsEveryTruncationTrailingBytesAndWrongProtocol() {
+        final var source = Unpooled.buffer();
+        try {
+            NativeContainerMessage.TYPE.write(source, new NativeContainerMessage(7, 1, ContainerUi.Kind.CHEST_3_ROWS, "Title", "{}"));
+            for (int length = 0; length < source.readableBytes(); length++) {
+                final var truncated = source.copy(0, length);
+                try {
+                    assertThrows(RuntimeException.class, () -> NativeContainerMessage.TYPE.read(truncated));
+                } finally {
+                    truncated.release();
+                }
+            }
+            source.writeByte(0);
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerMessage.TYPE.read(source));
+            source.readerIndex(0);
+            source.setByte(0, 2);
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerMessage.TYPE.read(source));
+            source.readerIndex(0);
+            source.setByte(0, 1);
+            source.setByte(1, 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerMessage.TYPE.read(source));
+        } finally {
+            source.release();
+        }
+    }
+
+    @Test
+    void invalidIdentitiesAndCombinedUtfBudgetFailBeforeWriting() {
+        final var buffer = Unpooled.buffer();
+        try {
+            assertThrows(IllegalArgumentException.class, () -> new NativeContainerMessage(-1, 1, ContainerUi.Kind.CHEST_3_ROWS, "", "{}"));
+            assertThrows(IllegalArgumentException.class, () -> new NativeContainerMessage(7, 0, ContainerUi.Kind.CHEST_3_ROWS, "", "{}"));
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerMessage.TYPE.write(buffer,
+                    new NativeContainerMessage(7, 1, ContainerUi.Kind.CHEST_3_ROWS, "é".repeat(4097), "{}")));
+            assertThrows(IllegalArgumentException.class, () -> NativeContainerMessage.TYPE.write(buffer,
+                    new NativeContainerMessage(7, 1, ContainerUi.Kind.CHEST_3_ROWS, "Title", "é".repeat(NativeContainerMessage.MAX_PAYLOAD_BYTES / 2))));
+            assertEquals(0, buffer.readableBytes());
+        } finally {
+            buffer.release();
+        }
+    }
+
+}
