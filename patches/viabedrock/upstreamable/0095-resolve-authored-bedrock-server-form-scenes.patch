+                    final byte[] metadata = ServerFormUi.this.textureFiles.get(texture.replaceAll("\\.png$", "") + ".json");
+                    if (metadata != null) {
+                        final JsonElement parsed = JsonParser.parseString(new String(metadata, StandardCharsets.UTF_8));
+                        if (parsed.isJsonObject()) {
+                            for (final String property : List.of("nineslice_size", "base_size")) {
+                                if (parsed.getAsJsonObject().has(property)) {
+                                    node.add(property, parsed.getAsJsonObject().get(property));
+                                }
+                            }
+                        }
+                    }
+                } else if (!texture.isEmpty()) {
+                    throw new IllegalArgumentException("Unsupported UI texture path");
+                }
+            }
+            if (node.has("anims") && node.get("anims").isJsonArray()) {
+                final JsonArray tracks = new JsonArray();
+                for (final JsonElement animationReference : node.getAsJsonArray("anims")) {
+                    if (!animationReference.isJsonPrimitive() || !animationReference.getAsJsonPrimitive().isString() || tracks.size() >= 16) {
+                        throw new IllegalArgumentException("Unsupported UI animation reference");
+                    }
+                    final String animationName = animationReference.getAsString().replaceFirst("^@", "");
+                    final JsonObject animation;
+                    try {
+                        animation = ServerFormUi.this.template(animationName, new HashSet<>());
+                    } catch (final MissingControlException missing) {
+                        this.missingTemplates.add(missing.getMessage());
+                        continue;
+                    }
+                    if (animation == null) {
+                        this.missingTemplates.add(animationName);
+                        continue;
+                    }
+                    final Map<String, JsonElement> animated = new HashMap<>(values);
+                    declarations(animation, animated);
+                    final JsonObject track = new JsonObject();
+                    for (final Map.Entry<String, JsonElement> entry : animation.entrySet()) {
+                        if (!entry.getKey().startsWith("$")) {
+                            track.add(entry.getKey(), resolveValue(entry.getValue(), animated, 0));
+                        }
+                    }
+                    tracks.add(track);
+                }
+                node.add("animation_tracks", tracks);
+            }
+            if ("label".equals(string(node, "type")) && node.has("text") && !node.get("text").isJsonNull()) {
+                String text = UiExpression.text(node.get("text"));
+                if (!node.has("localize") || UiExpression.truth(node.get("localize"))) {
+                    text = ServerFormUi.this.translator.apply(text);
+                }
+                node.addProperty("text", text);
+                node.addProperty("localize", false);
+                node.add("text_component", TextUtil.textComponentToGson(TextUtil.stringToTextComponent(text, ServerFormUi.this.formattingColors)));
+            }
+            if (Set.of("button", "toggle").contains(string(node, "type"))) {
+                String action = UiExpression.text(resolveValue(new JsonPrimitive("$pressed_button_name"), values, 0));
+                if (action.isEmpty() && node.has("button_mappings") && node.get("button_mappings").isJsonArray()) {
+                    for (final JsonElement mapping : node.getAsJsonArray("button_mappings")) {
+                        if (mapping.isJsonObject()) {
+                            final String target = string(mapping.getAsJsonObject(), "to_button_id");
+                            if (target.equals("button.form_button_click") || target.equals("button.menu_exit")) {
+                                action = target;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if (action.equals("button.menu_exit")) {
+                    node.addProperty("action", -1);
+                } else if (action.equals("button.form_button_click") && selectedButton >= 0) {
+                    node.addProperty("action", selectedButton);
+                    if (visible) {
+                        this.actions.add(selectedButton);
+                    }
+                }
+            }
+            final JsonArray children = new JsonArray();
+            if (!visible) {
+                // Preserve this control's layout box without activating its invisible descendants.
+                node.add("children", children);
+                return node;
+            }
+            final JsonElement childControls = resolveValue(control.get("controls"), values, 0);
+            if (childControls.isJsonArray()) {
+                this.children(childControls.getAsJsonArray(), children, values, selectedButton, depth);
+            } else if (!childControls.isJsonNull()) {
+                throw new IllegalArgumentException("Invalid UI controls collection");
+            }
+            if (control.has("factory") && control.get("factory").isJsonObject()) {
+                this.factory(control.getAsJsonObject("factory"), node, children, values, selectedButton, depth);
+            }
+            if ("factory".equals(string(control, "type")) && control.has("control_ids")) {
+                this.factory(control, node, children, values, selectedButton, depth);
+            }
+            if ("grid".equals(string(control, "type")) && control.has("grid_item_template")) {
+                this.collection(UiExpression.text(resolveValue(control.get("grid_item_template"), values, 0)), children, values, depth);
+            }
+            node.add("children", children);
+            return node;
+        }
+
+        private JsonObject expandChild(final String reference, final JsonObject overrides,
+                                       final Map<String, JsonElement> inherited, final int button, final int depth) {
+            try {
+                return this.expand(reference, overrides, inherited, button, depth);
+            } catch (final MissingControlException missing) {
+                // The native factory logs a missing base and returns an empty child, retaining its siblings.
+                this.missingTemplates.add(missing.getMessage());
+                return null;
+            }
+        }
+
+        private void children(final JsonArray input, final JsonArray output, final Map<String, JsonElement> values,
+                              final int button, final int depth) {
+            for (final JsonElement element : input) {
+                if (!element.isJsonObject()) {
+                    throw new IllegalArgumentException("Invalid UI child");
+                }
+                for (final Map.Entry<String, JsonElement> entry : element.getAsJsonObject().entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        throw new IllegalArgumentException("Invalid UI control");
+                    }
+                    final JsonObject child = this.expandChild(entry.getKey(), entry.getValue().getAsJsonObject(), values, button, depth + 1);
+                    if (child != null) {
+                        output.add(child);
+                    }
+                }
+            }
+        }
+
+        private void factory(final JsonObject factory, final JsonObject node, final JsonArray children,
+                             final Map<String, JsonElement> values, final int button, final int depth) {
+            if (factory.has("control_name")) {
+                this.collection(UiExpression.text(resolveValue(factory.get("control_name"), values, 0)), children, values, depth);
+            } else if (factory.has("control_ids") && factory.get("control_ids").isJsonObject()) {
+                final JsonObject ids = factory.getAsJsonObject("control_ids");
+                if ("factory".equals(string(node, "type"))) {
+                    final JsonElement selected = ids.get("long_form");
+                    if (selected != null) {
+                        final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, button, depth + 1);
+                        if (child != null) {
+                            children.add(child);
+                        }
+                    }
+                } else {
+                    final String collection = UiExpression.text(values.get("#collection_length"));
+                    final JsonElement entries = values.get(collection);
+                    if (entries != null && entries.isJsonArray()) {
+                        for (final JsonElement entry : entries.getAsJsonArray()) {
+                            final JsonElement selected = ids.get(UiExpression.text(entry));
+                            if (selected != null) {
+                                final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, button, depth + 1);
+                                if (child != null) {
+                                    children.add(child);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        private void collection(final String template, final JsonArray children, final Map<String, JsonElement> values,
+                                final int depth) {
+            if (template.isEmpty()) {
+                throw new IllegalArgumentException("Empty UI collection template");
+            }
+            for (int index = 0; index < this.form.getAsJsonArray("buttons").size(); index++) {
+                final JsonObject child = this.expandChild(template, new JsonObject(), values, index, depth + 1);
+                if (child != null) {
+                    children.add(child);
+                }
+            }
+        }
+
+        private Map<String, JsonElement> engine(final int button) {
+            return this.engineBindings.computeIfAbsent(button, index -> {
+                final Map<String, JsonElement> result = new HashMap<>(this.initial);
+                result.put("#form_button_text", new JsonPrimitive(""));
+                result.put("#form_button_index", new JsonPrimitive(-1));
+                result.put("#form_button_texture", new JsonPrimitive(""));
+                result.put("#form_button_texture_file_system", new JsonPrimitive("path"));
+                if (index >= 0) {
+                    final JsonObject element = this.form.getAsJsonArray("buttons").get(index).getAsJsonObject();
+                    result.put("#form_button_text", element.get("text"));
+                    result.put("#form_button_index", new JsonPrimitive(index));
+                    final JsonObject image = element.has("image") && element.get("image").isJsonObject()
+                            ? element.getAsJsonObject("image") : new JsonObject();
+                    result.put("#form_button_texture", image.has("data") ? image.get("data") : new JsonPrimitive(""));
+                    result.put("#form_button_texture_file_system", image.has("type") ? image.get("type") : new JsonPrimitive("path"));
+                }
+                return result;
+            });
+        }
+
+        private void bind(final JsonObject control, final Map<String, JsonElement> values, final int button) {
+            if (control.has("property_bag") && control.get("property_bag").isJsonObject()) {
+                for (final Map.Entry<String, JsonElement> entry : control.getAsJsonObject("property_bag").entrySet()) {
+                    values.put(entry.getKey(), resolveValue(entry.getValue(), values, 0));
+                }
+            }
+            final JsonElement bindings = resolveValue(control.get("bindings"), values, 0);
+            if (!bindings.isJsonArray()) {
+                return;
+            }
+            for (final JsonElement element : bindings.getAsJsonArray()) {
+                final JsonObject binding = element.getAsJsonObject();
+                final String sourceControl = string(binding, "source_control_name");
+                final Map<String, JsonElement> source = sourceControl.isEmpty() ? values : this.controls.getOrDefault(sourceControl, values);
+                final String expression = binding.has("source_property_name") ? string(binding, "source_property_name") : string(binding, "binding_name");
+                if (expression.isEmpty()) {
+                    continue;
+                }
+                final Map<String, JsonElement> engine = this.engine(button);
+                final JsonElement value = !"view".equals(string(binding, "binding_type")) && sourceControl.isEmpty() && engine.containsKey(expression)
+                        ? engine.get(expression) : resolveValue(new JsonPrimitive(expression), source, 0);
+                final String target = binding.has("target_property_name") ? string(binding, "target_property_name")
+                        : binding.has("binding_name_override") ? string(binding, "binding_name_override") : expression;
+                if (target.startsWith("#") && value != null) {
+                    values.put(target, value);
+                }
+            }
+        }
+    }
+
+    private static final class Builtins {
+        private static final Map<String, byte[]> FILES = Collections.unmodifiableMap(builtinFiles());
+        private static final String IDENTITY = identity();
+
+        private static String identity() {
+            try {
+                final var digest = MessageDigest.getInstance("SHA-256");
+                FILES.entrySet().stream().sorted(Map.Entry.comparingByKey()).forEach(entry -> {
+                    digest.update(entry.getKey().getBytes(StandardCharsets.UTF_8));
+                    digest.update((byte) 0);
+                    digest.update(ByteBuffer.allocate(4).putInt(entry.getValue().length).array());
+                    digest.update(entry.getValue());
+                });
+                return HexFormat.of().formatHex(digest.digest());
+            } catch (final NoSuchAlgorithmException impossible) {
+                throw new IllegalStateException(impossible);
+            }
+        }
+    }
+
+    private static final class MissingControlException extends IllegalArgumentException {
+
+        private MissingControlException(final String control) {
+            super(control);
+        }
+
+    }
+
+    private record Definition(JsonObject value, String parent) {
+    }
+
