+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import java.util.function.Function;
+import net.raphimc.viabedrock.api.model.NativeContainerAction;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+
+/** Connection-local presentation ownership; the selected inventory backend retains item authority. */
+public final class NativeContainerUiState implements StorableObject {
+
+    private long sequence;
+    private Actions actions;
+    private int menuId = -1;
+    private boolean active;
+
+    public NativeContainerMessage prepare(final int menuId, final ContainerUi.Kind kind,
+                                         final ContainerUi.Title title, final ContainerUi ui) {
+        return this.prepare(menuId, kind, title, ui, null);
+    }
+
+    public NativeContainerMessage prepareActions(final int menuId, final ContainerUi.Kind kind,
+                                                final ContainerUi.Title title, final ContainerUi ui,
+                                                final Function<NativeContainerMessage, Actions> backend) {
+        if (backend == null) {
+            throw new IllegalArgumentException("Native container action backend is required");
+        }
+        return this.prepare(menuId, kind, title, ui, backend);
+    }
+
+    private NativeContainerMessage prepare(final int menuId, final ContainerUi.Kind kind,
+                                          final ContainerUi.Title title, final ContainerUi ui,
+                                          final Function<NativeContainerMessage, Actions> backend) {
+        this.clearActions();
+        if (kind == null || ui == null || this.sequence == Long.MAX_VALUE) {
+            return null;
+        }
+        final var exported = ui.exportProgram(kind, title, backend != null);
+        if (exported == null) {
+            return null;
+        }
+        if (backend != null) {
+            exported.addProperty("awaiting_contents", true);
+        }
+        try {
+            final var message = new NativeContainerMessage(menuId, this.sequence + 1, kind, title.raw(), exported.toString());
+            final Actions actions = backend == null ? null : backend.apply(message);
+            if (backend != null && (actions == null || !actions.current())) {
+                return null;
+            }
+            this.actions = actions;
+            this.menuId = menuId;
+            this.sequence = message.sequence();
+            return message;
+        } catch (final IllegalArgumentException unsupported) {
+            return null;
+        }
+    }
+
+    public boolean handleAction(final NativeContainerAction action) {
+        if (this.actions == null || this.menuId != action.menuId() || this.sequence != action.sequence()) {
+            return false;
+        }
+        if (!this.actions.current()) {
+            this.active = false;
+            return false;
+        }
+        try {
+            return switch (action.mode()) {
+                case ACTIVATE -> {
+                    this.active = false;
+                    this.active = this.actions.hasActions();
+                    yield this.active;
+                }
+                case DEACTIVATE -> {
+                    this.active = false;
+                    yield true;
+                }
+                case AUTO_PLACE_ONE -> this.active && this.actions.autoPlaceOne(action.revision(), action.sourceSlot());
+            };
+        } catch (final IllegalArgumentException unsupported) {
+            return false;
+        }
+    }
+
+    public boolean blocksVanillaClicks() {
+        return this.active && this.actions != null && this.actions.current();
+    }
+
+    public void clearActions() {
+        this.actions = null;
+        this.menuId = -1;
+        this.active = false;
+    }
+
+    /** The genuine current-menu backend, not a client-supplied item or destination plan. */
+    public interface Actions {
+
+        boolean current();
+
+        boolean hasActions();
+
+        boolean autoPlaceOne(int revision, int sourceSlot);
+
+    }
+
+}
