+
+class ServerFormUiTest {
+
+    private static final String UI = """
+            {"namespace":"server_form",
+             "third_party_server_screen":{"$screen_content":"server_form.main_screen_content"},
+             "main_screen_content":{"type":"grid","grid_dimensions":[2,2],
+               "factory":{"control_name":"server_form.cell"}},
+             "cell":{"type":"panel","$pressed_button_name":"button.form_button_click",
+               "bindings":[{"binding_name":"(not ((#form_button_text - 'tile:') = #form_button_text))","binding_name_override":"#visible"}],
+               "controls":[{"action@server_form.base_button":{"$label":"(#form_button_text - 'tile:')"}}]},
+             "base_button":{"type":"button","size":[80,40],"$label|default":"unbound",
+               "controls":[{"caption":{"type":"label","text":"$label","size":["100%",20]}}]}}
+            """;
+
+    private static Map<String, byte[]> definitions(final String content) {
+        return Map.of("ui/server_form.json", content.getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static JsonObject form(final String... text) {
+        final JsonObject form = new JsonObject();
+        form.addProperty("type", "form");
+        form.addProperty("title", "Example");
+        form.addProperty("content", "");
+        final JsonArray buttons = new JsonArray();
+        for (final String value : text) {
+            final JsonObject button = new JsonObject();
+            button.addProperty("text", value);
+            buttons.add(button);
+        }
+        form.add("buttons", buttons);
+        return form;
+    }
+
+    @Test
+    void factoriesPreserveOriginalIndicesAcrossHiddenRowsAndApplyInheritedVariables() {
+        final var scene = new ServerFormUi(List.of(definitions(UI))).resolve(form("tile:One", "unused", "tile:Three"));
+        assertNotNull(scene);
+        final var cells = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertEquals(3, cells.size());
+        assertFalse(cells.get(1).getAsJsonObject().get("visible").getAsBoolean());
+        final var first = cells.get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        final var third = cells.get(2).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(0, first.get("action").getAsInt());
+        assertEquals(2, third.get("action").getAsInt());
+        assertEquals("One", first.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsString());
+        assertEquals(80, first.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(3, scene.getAsJsonObject("fallback").getAsJsonArray("buttons").size());
+    }
+
+    @Test
+    void packPriorityReplacesTheNamedControlWithoutChangingItsActions() {
+        final String upper = """
+                {"namespace":"server_form","base_button":{"type":"button","size":[96,32],
+                  "controls":[{"caption":{"type":"label","text":"$label"}}]}}
+                """;
+        final var ui = new ServerFormUi(List.of(definitions(UI), definitions(upper)));
+        final var root = ui.resolve(form("tile:One")).getAsJsonObject("root");
+        final var button = root.getAsJsonArray("children").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(96, button.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(0, button.get("action").getAsInt());
+    }
+
+    @Test
+    void cyclesMissingBasesAndOversizedCollectionsUseOrdinaryFormFallback() {
+        final var recursive = new ServerFormUi(List.of(definitions(UI.replace("server_form.cell", "server_form.main_screen_content"))));
+        assertNull(recursive.resolve(form("tile:One")));
+        final var missing = new ServerFormUi(List.of(definitions(UI.replace("action@server_form.base_button", "action@missing.base"))));
+        assertNull(missing.resolve(form("tile:One")));
+        final String[] many = new String[ServerFormUi.MAX_BUTTONS + 1];
+        java.util.Arrays.fill(many, "tile:One");
+        assertNull(new ServerFormUi(List.of(definitions(UI))).resolve(form(many)));
+        assertNull(new ServerFormUi(List.of(definitions(UI))).resolve(form("unused")));
+    }
+
+    @Test
+    void javaPresentationUsesResolvedCaptionsAndRetainsSparseResponseIndices() {
+        final var scene = new ServerFormUi(List.of(definitions(UI))).resolve(form("tile:One", "unused", "tile:Three"));
+        final var presentation = ServerFormUi.presentation(scene);
+        assertEquals(Map.of(0, "One", 2, "Three"), presentation.buttons());
+        assertThrows(UnsupportedOperationException.class, () -> presentation.buttons().put(1, "hidden"));
+        final String ignored = UI.replace("\"bindings\":[", "\"ignored\":true,\"bindings\":[");
+        assertNull(new ServerFormUi(List.of(definitions(ignored))).resolve(form("tile:One")));
+    }
+
+    @Test
+    void exactEnclosingValuesBeatLocalDefaultsIncludingZeroAndFalse() {
+        final String defaults = UI.replace("\"$label\":\"(#form_button_text - 'tile:')\"", "\"$label\":0")
+                .replace("\"$label|default\":\"unbound\"", "\"$label|default\":17");
+        final var scene = new ServerFormUi(List.of(definitions(defaults))).resolve(form("tile:One"));
+        assertEquals("0", ServerFormUi.presentation(scene).buttons().get(0));
+        final var boolScene = new ServerFormUi(List.of(definitions(defaults.replace("\"$label\":0", "\"$label\":false")))).resolve(form("tile:One"));
+        assertEquals("false", ServerFormUi.presentation(boolScene).buttons().get(0));
+        final var fallback = new ServerFormUi(List.of(definitions(UI.replace("\"$pressed_button_name\":", "\"$pressed_button_name|default\":")))).resolve(form("tile:One"));
+        assertEquals(0, fallback.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject()
+                .getAsJsonArray("children").get(0).getAsJsonObject().get("action").getAsInt());
+    }
+
+    @Test
+    void missingNativeTemplatesOmitOnlyTheirChildAndKeepMappedToggleResponses() {
+        final String mapped = UI.replace("\"type\":\"button\"", "\"type\":\"toggle\",\"button_mappings\":[{\"to_button_id\":\"button.form_button_click\"}]")
+                .replace("\"$pressed_button_name\":\"button.form_button_click\",", "")
+                .replace("\"controls\":[{\"caption\"", "\"controls\":[{\"unused@missing.base\":{}},{\"caption\"");
+        final var scene = new ServerFormUi(List.of(definitions(mapped))).resolve(form("tile:One"));
+        assertNotNull(scene);
+        assertEquals(Map.of(0, "One"), ServerFormUi.presentation(scene).buttons());
+        assertEquals("missing.base", scene.getAsJsonArray("missing_templates").get(0).getAsString());
+    }
+
+    @Test
+    void bindingsOverrideAuthoredVisibilityRatherThanPermanentlyHidingTheControl() {
+        final String initiallyHidden = UI.replace("\"cell\":{\"type\":\"panel\"", "\"cell\":{\"type\":\"panel\",\"visible\":false");
+        final var scene = new ServerFormUi(List.of(definitions(initiallyHidden))).resolve(form("tile:One"));
+        assertEquals(Map.of(0, "One"), ServerFormUi.presentation(scene).buttons());
+    }
+
+    @Test
+    void collectionBindingsReadEngineDataAfterPropertyBagDefaultsAndResolveAnimationVariables() {
+        final String bound = UI.replace("\"bindings\":[", "\"property_bag\":{\"#form_button_text\":\"\"},\"bindings\":[{\"binding_type\":\"collection\",\"binding_name\":\"#form_button_text\"},")
+                .replace("\"base_button\":{", "\"fade\":{\"anim_type\":\"alpha\",\"from\":0,\"to\":1,\"duration\":\"$duration\"},\"base_button\":{\"$duration|default\":0.16,\"anims\":[\"@server_form.fade\"],");
+        final var scene = new ServerFormUi(List.of(definitions(bound))).resolve(form("tile:One"));
+        assertNotNull(scene);
+        assertEquals(Map.of(0, "One"), ServerFormUi.presentation(scene).buttons());
+        final var button = scene.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        final var track = button.getAsJsonArray("animation_tracks").get(0).getAsJsonObject();
+        assertEquals(0.16F, track.get("duration").getAsFloat());
+        assertEquals(1, track.get("to").getAsInt());
+    }
+
+    @Test
+    void variableControlCollectionsSelectTheirOwnEngineIndicesAndIgnoreAbsentEntries() {
+        final String indexed = """
+                {"namespace":"server_form","main_screen_content":{"type":"panel",
+                   "$rows":[{"last@server_form.row":{"$index":2}},
+                            {"missing@server_form.row":{"$index":7}},
+                            {"first@server_form.row":{"$index":0}}],"controls":"$rows"},
+                 "row":{"type":"panel","collection_index":"$index","visible":false,
+                   "bindings":[{"binding_type":"view","source_property_name":"(not (#form_button_text = ''))","target_property_name":"#visible"}],
+                   "controls":[{"button":{"type":"button","$pressed_button_name":"button.form_button_click",
+                     "controls":[{"label":{"type":"label","text":"#form_button_text"}}]}}]}}
