+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.UnaryOperator;
+import net.lenni0451.mcstructs_bedrock.text.utils.BedrockTranslator;
+
+/** Original form response ordinals and custom input values supplied to a shared UI session. */
+final class FormBindings implements UiBindings {
+
+    private final JsonArray elements;
+    final JsonArray state;
+    private final boolean custom;
+    private final Set<Integer> expanded;
+    private final int[] buttonIndices;
+    private final UnaryOperator<String> translator;
+    private final Map<String, JsonElement> initial = new HashMap<>();
+    final Set<Integer> actions = new HashSet<>();
+
+    FormBindings(final JsonObject form, final JsonArray state, final Set<Integer> expanded, final UnaryOperator<String> translator) {
+        this.translator = translator;
+        this.custom = "custom_form".equals(string(form, "type"));
+        this.elements = form.getAsJsonArray(this.custom ? "content" : "elements");
+        this.state = state;
+        this.expanded = Set.copyOf(expanded);
+        final JsonArray elements = this.elements;
+        this.buttonIndices = new int[elements.size()];
+        final JsonArray types = new JsonArray();
+        int buttonIndex = 0;
+        for (int index = 0; index < elements.size(); index++) {
+            final String type = string(elements.get(index).getAsJsonObject(), "type");
+            types.add(type);
+            this.buttonIndices[index] = type.equals("button") ? buttonIndex++ : -1;
+        }
+        this.initial.put("#form_button_contents", this.custom ? new JsonArray() : types);
+        this.initial.put("#title_text", form.has("title") ? form.get("title") : new JsonPrimitive(""));
+        this.initial.put("#form_text", form.has("content") ? form.get("content") : new JsonPrimitive(""));
+        this.initial.put("#form_content_text", this.initial.get("#form_text"));
+        this.initial.put("#form_button_length", new JsonPrimitive(this.custom ? 0 : elements.size()));
+        this.initial.put("#custom_form_length", this.custom ? types : new JsonArray());
+        if (this.custom) {
+            this.initial.put("#submit_text", new JsonPrimitive(this.translator.apply("gui.submit")));
+            this.initial.put("#submit_button_visible", new JsonPrimitive(true));
+        }
+        this.initial.put("#is_using_gamepad", new JsonPrimitive(false));
+        this.initial.put("$is_console", new JsonPrimitive(false));
+        this.initial.put("#is_using_touch", new JsonPrimitive(false));
+    }
+
+    JsonArray inputs() {
+        final JsonArray inputs = new JsonArray();
+        for (int index = 0; index < this.elements.size(); index++) {
+            final JsonObject element = this.elements.get(index).getAsJsonObject();
+            final JsonObject input = element.deepCopy();
+            input.addProperty("index", index);
+            input.add("value", this.state.get(index).deepCopy());
+            if ("input".equals(string(element, "type"))) {
+                input.addProperty("max_length", 100);
+            }
+            if (Set.of("step_slider", "dropdown").contains(string(element, "type"))) {
+                input.add("options", options(element).deepCopy());
+            }
+            if ("slider".equals(string(element, "type"))) {
+                input.addProperty("step", element.has("step") ? element.get("step").getAsFloat() : 1F);
+                input.addProperty("max", Math.max(element.get("min").getAsFloat(), element.get("max").getAsFloat()));
+            }
+            inputs.add(input);
+        }
+        return inputs;
+    }
+
+    @Override
+    public Map<String, JsonElement> globals() {
+        return this.initial;
+    }
+
+    @Override
+    public String defaultCollection() {
+        return this.custom ? "custom_form" : "form_buttons";
+    }
+
+    @Override
+    public Collection collection(final String name, final Scope parent) {
+        // Both native form controllers are declared in the shared screen definition.
+        // Only the current controller supplies rows; its counterpart remains empty.
+        if (name.equals(this.custom ? "form_buttons" : "custom_form")) {
+            return new Collection(List.of(), Map.of());
+        }
+        if (Set.of("custom_dropdown", "custom_multiselect").contains(name)) {
+            final int index = this.elementIndex(parent);
+            if (!this.custom || index < 0) {
+                throw new IllegalArgumentException("No parent form input for " + name);
+            }
+            final List<Map<String, JsonElement>> rows = new ArrayList<>();
+            for (final JsonElement option : options(this.elements.get(index).getAsJsonObject())) {
+                rows.add(Map.of("#custom_radio_text", option));
+            }
+            return new Collection(rows, Map.of());
+        }
+        if (!name.equals(this.defaultCollection())) {
+            throw new IllegalArgumentException("Unsupported form collection " + name);
+        }
+        return new Collection(java.util.stream.IntStream.range(0, this.elements.size())
+            .mapToObj(index -> this.engine(new Scope(name, index, parent))).toList(), Map.of());
+    }
+
+    private int elementIndex(final Scope scope) {
+        for (Scope candidate = scope; candidate != null; candidate = candidate.parent()) {
+            if (candidate.collection().equals(this.defaultCollection())) {
+                return candidate.index() >= 0 && candidate.index() < this.elements.size() ? candidate.index() : -1;
+            }
+        }
+        return -1;
+    }
+
+    @Override
+    public Map<String, JsonElement> variables(final Scope scope) {
+        final Map<String, JsonElement> values = new HashMap<>();
+        this.engine(scope).forEach((key, value) -> {
+            if (Set.of("#form_button_text", "#form_button_index", "#form_button_texture", "#form_button_texture_file_system").contains(key)
+                || this.custom && (key.startsWith("#custom_") || key.equals("#dropdown_option_text"))) {
+                values.put(key, value);
+            }
+        });
+        if (scope != null && Set.of("custom_dropdown", "custom_multiselect").contains(scope.collection())) {
+            values.put("$__option_index", new JsonPrimitive(scope.index()));
+        }
+        return values;
+    }
+
+    @Override
+    public Map<String, JsonElement> bindings(final Scope scope) {
+        return this.engine(scope);
+    }
+
+    @Override
+    public String factoryKey() {
+        return this.custom ? "custom_form" : "long_form";
+    }
+
+    @Override
+    public void decorate(final JsonObject node, final JsonObject control, final Map<String, JsonElement> values, final Scope scope) {
+        final int selectedElement = this.elementIndex(scope);
+        if (Set.of("button", "toggle").contains(JsonUiProgram.string(node, "type"))) {
+            String action = UiExpression.text(JsonUiProgram.resolveValue(new JsonPrimitive("$pressed_button_name"), values, 0));
+            if (action.isEmpty() && node.has("button_mappings") && node.get("button_mappings").isJsonArray()) {
+                for (final JsonElement mapping : node.getAsJsonArray("button_mappings")) {
+                    if (mapping.isJsonObject()) {
+                        final String target = JsonUiProgram.string(mapping.getAsJsonObject(), "to_button_id");
+                        if (target.equals("button.form_button_click") || target.equals("button.menu_exit")) {
+                            action = target;
+                            break;
+                        }
+                    }
+                }
+            }
+            if (action.equals("button.menu_exit")) {
+                node.addProperty("action", -1);
+            } else if (action.equals("button.form_button_click") && selectedElement >= 0
+                && this.buttonIndices[selectedElement] >= 0) {
+                final int responseIndex = this.buttonIndices[selectedElement];
+                node.addProperty("action", responseIndex);
+                if (node.get("visible").getAsBoolean()) {
+                    this.actions.add(responseIndex);
+                }
+            }
+        }
+        if (this.custom && selectedElement >= 0) {
+            final String widget = JsonUiProgram.string(node, "type");
+            final String elementType = JsonUiProgram.string(this.elements.get(selectedElement).getAsJsonObject(), "type");
+            if (Set.of("toggle", "slider", "slider_box", "edit_box").contains(widget)) {
+                final JsonObject input = new JsonObject();
+                input.addProperty("index", selectedElement);
+                input.addProperty("type", elementType);
+                if (values.containsKey("$__option_index")) {
+                    input.add("option", values.get("$__option_index"));
+                }
+                node.add("input", input);
+            }
+            if ("dropdown".equals(elementType) && "toggle".equals(widget) && !values.containsKey("$__option_index")) {
+                node.addProperty("command", "expand");
+            }
+        }
+        if (this.custom && ("button".equals(JsonUiProgram.string(node, "type")) || "toggle".equals(JsonUiProgram.string(node, "type")))) {
+            final String pressed = UiExpression.text(JsonUiProgram.resolveValue(new JsonPrimitive("$pressed_button_name"), values, 0));
+            if (pressed.equals("button.submit_custom_form")) {
+                node.addProperty("command", "submit");
+            } else if (pressed.equals("button.menu_exit") || (node.has("action") && node.get("action").getAsInt() == -1)) {
+                node.addProperty("command", "cancel");
+            }
+        }
+    }
+
+    private Map<String, JsonElement> engine(final Scope scope) {
+        final int index = this.elementIndex(scope);
+        final Map<String, JsonElement> result = new HashMap<>(this.initial);
+        result.put("#form_button_text", new JsonPrimitive(""));
+        result.put("#form_button_index", new JsonPrimitive(-1));
+        result.put("#form_button_texture", new JsonPrimitive(""));
+        result.put("#form_button_texture_file_system", new JsonPrimitive("path"));
+        if (index >= 0) {
+            final JsonObject element = this.elements.get(index).getAsJsonObject();
+            if (this.custom) {
+                final JsonElement value = this.state.get(index);
+                result.put("#custom_text", element.has("text") ? element.get("text") : new JsonPrimitive(""));
+                result.put("#custom_tooltip_text", element.has("tooltip") ? element.get("tooltip") : new JsonPrimitive(""));
+                result.put("#custom_toggle_state", value);
+                result.put("#custom_toggle_enabled", new JsonPrimitive(true));
+                result.put("#custom_input_text", value);
+                result.put("#custom_placeholder_text", element.has("placeholder") ? element.get("placeholder") : new JsonPrimitive(""));
+                result.put("#custom_input_enabled", new JsonPrimitive(true));
+                result.put("#custom_slider_enabled", new JsonPrimitive(true));
+                result.put("#custom_slider_timeout", new JsonPrimitive(0));
+                if ("slider".equals(string(element, "type"))) {
+                    final float minimum = element.get("min").getAsFloat();
+                    final float maximum = Math.max(minimum, element.get("max").getAsFloat());
+                    if (!Float.isFinite(minimum) || !Float.isFinite(maximum) || maximum == minimum) {
+                        throw new IllegalArgumentException("Custom slider has no finite range");
+                    }
+                    result.put("#custom_slider_value", new JsonPrimitive((value.getAsFloat() - minimum) / (maximum - minimum)));
+                } else {
+                    result.put("#custom_slider_value", value);
+                }
+                if ("slider".equals(string(element, "type"))) {
+                    final float step = element.has("step") ? element.get("step").getAsFloat() : 1F;
+                    final String number = step == Math.floor(step)
+                        ? Integer.toString((int) Math.floor(value.getAsFloat())) : String.format(Locale.ROOT, "%f", value.getAsFloat());
+                    result.put("#custom_slider_text", new JsonPrimitive(this.sliderCaption(element, number)));
+                }
+                result.put("#custom_slider_text_value", value);
+                result.put("#custom_slider_step_value", value);
+                result.put("#custom_slider_steps", new JsonPrimitive(options(element).size()));
+                final JsonElement caption = value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()
+                    && value.getAsInt() >= 0 && value.getAsInt() < options(element).size() ? options(element).get(value.getAsInt()) : new JsonPrimitive("");
+                result.put("#custom_slider_step_text", new JsonPrimitive(this.sliderCaption(element, UiExpression.text(caption))));
+                result.put("#custom_slider_step_text_value", caption);
+                result.put("#dropdown_option_text", caption);
+                result.put("#custom_dropdown_length", new JsonPrimitive(options(element).size()));
+                result.put("#custom_dropdown", new JsonPrimitive(this.expanded.contains(index)));
+            }
+            result.put("#form_button_text", element.has("text") ? element.get("text") : new JsonPrimitive(""));
+            result.put("#form_button_index", new JsonPrimitive(this.buttonIndices[index]));
+            result.put("#collection_index", new JsonPrimitive(index));
+            final JsonObject image = element.has("image") && element.get("image").isJsonObject()
+                ? element.getAsJsonObject("image") : new JsonObject();
+            result.put("#form_button_texture", image.has("data") ? image.get("data") : new JsonPrimitive(""));
+            result.put("#form_button_texture_file_system", image.has("type") ? image.get("type") : new JsonPrimitive("path"));
+        }
+        if (this.custom && index >= 0 && scope != null && scope.parent() != null
+            && Set.of("custom_dropdown", "custom_multiselect").contains(scope.collection())) {
+            result.put("#custom_radio_text", options(this.elements.get(index).getAsJsonObject()).get(scope.index()));
+            result.put("#custom_radio_toggled", new JsonPrimitive(this.state.get(index).getAsInt() == scope.index()));
+        }
+        return result;
+    }
+
+    private String sliderCaption(final JsonObject element, final String value) {
+        final String text = element.has("text") ? UiExpression.text(element.get("text")) : "";
+        return BedrockTranslator.translate("options.sliderLabelFormat", this.translator::apply, new Object[]{text, value});
+    }
+
+    private static JsonArray options(final JsonObject element) {
+        final String name = "step_slider".equals(string(element, "type")) ? "steps" : "options";
+        return element.has(name) && element.get(name).isJsonArray() ? element.getAsJsonArray(name) : new JsonArray();
+    }
+
+    private static String string(final JsonObject object, final String key) {
+        return JsonUiProgram.string(object, key);
+    }
+
+}
