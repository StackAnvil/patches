+/** Resolves loaded JSON UI controls against an individual server form, without server-specific templates. */
+public final class ServerFormUi {
+
+    public static final int MAX_NODES = 8192;
+    public static final int MAX_BUTTONS = 1024;
+    private static final int MAX_FILE_BYTES = 1 << 20;
+    private static final Set<String> HOST_FILES = Set.of("ui/server_form.json", "ui/ui_common.json", "ui/_global_variables.json");
+    private static final Set<String> CUSTOM_TYPES = Set.of("label", "header", "divider", "toggle", "input", "slider", "step_slider", "dropdown");
+    private final Map<String, Definition> definitions = new LinkedHashMap<>();
+    private final Map<String, JsonElement> globals = new HashMap<>();
+    private final Map<String, byte[]> textureFiles = new LinkedHashMap<>();
+    private boolean customized;
+    private final UnaryOperator<String> translator;
+    private final Map<Character, Integer> formattingColors;
+
+    public ServerFormUi(final ResourcePackStorage storage) {
+        this.translator = storage.getTexts()::translate;
+        this.formattingColors = storage.getTextFormatting().colors();
+        final Map<String, byte[]> builtin = Builtins.FILES;
+        this.loadFiles(builtin, false);
+        UiTextures.load(builtin, this.textureFiles);
+        for (final ResourcePack pack : storage.getPackStackBottomToTop()) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final String path : loadedPaths(pack)) {
+                final byte[] bytes = pack.content().get(path);
+                if (bytes != null && bytes.length <= MAX_FILE_BYTES) {
+                    files.put(path, bytes);
+                }
+            }
+            this.loadFiles(files, storage.isServerPack(pack));
+            final Map<String, byte[]> textures = new LinkedHashMap<>();
+            for (final String path : pack.content().getFilesDeep("textures/ui/", "")) {
+                if (safePath(path)) {
+                    final byte[] bytes = pack.content().get(path);
+                    if (bytes.length <= 16 * MAX_FILE_BYTES && textures.size() < 8192) {
+                        textures.put(path, bytes);
+                    }
+                }
+            }
+            UiTextures.load(textures, this.textureFiles);
+        }
+    }
+
+    /** Test and tooling entry point. Files have the same load order as a resource-pack stack. */
+    public ServerFormUi(final List<Map<String, byte[]>> layers) {
+        this(layers, UnaryOperator.identity(), Map.of());
+    }
+
+    /** Resolves the same resource-pack files with their language translations. */
+    public ServerFormUi(final List<Map<String, byte[]>> layers, final UnaryOperator<String> translator) {
+        this(layers, translator, Map.of());
+    }
+
+    private ServerFormUi(final List<Map<String, byte[]>> layers, final UnaryOperator<String> translator,
+                         final Map<Character, Integer> formattingColors) {
+        this.translator = translator;
+        this.formattingColors = formattingColors;
+        for (final Map<String, byte[]> files : layers) {
+            this.loadFiles(files, true);
+            UiTextures.load(files, this.textureFiles);
+        }
+    }
+
+    public Map<String, byte[]> textures() {
+        return Collections.unmodifiableMap(this.textureFiles);
+    }
+
+    public static ServerFormUi fromProgram(final JsonObject program) {
+        if (program.toString().getBytes(StandardCharsets.UTF_8).length > NativeFormMessage.MAX_PAYLOAD_BYTES
+                || !program.has("definitions") || !program.get("definitions").isJsonObject()) {
+            throw new IllegalArgumentException("Invalid custom form program");
+        }
+        final JsonObject translations = program.has("translations") ? program.getAsJsonObject("translations") : new JsonObject();
+        final Map<Character, Integer> colors = new HashMap<>();
+        if (program.has("formatting_colors")) {
+            program.getAsJsonObject("formatting_colors").entrySet().forEach(entry -> {
+                if (entry.getKey().length() != 1) {
+                    throw new IllegalArgumentException("Invalid custom form formatting color");
+                }
+                colors.put(entry.getKey().charAt(0), entry.getValue().getAsInt());
+            });
+        }
+        final ServerFormUi ui = new ServerFormUi(List.of(),
+                key -> translations.has(key) ? translations.get(key).getAsString() : key, Map.copyOf(colors));
+        final JsonObject definitions = program.getAsJsonObject("definitions");
+        if (definitions.size() > MAX_NODES) {
+            throw new IllegalArgumentException("Too many custom form definitions");
+        }
+        for (final Map.Entry<String, JsonElement> entry : definitions.entrySet()) {
+            final JsonObject definition = entry.getValue().getAsJsonObject();
+            ui.definitions.put(entry.getKey(), new Definition(definition.getAsJsonObject("value").deepCopy(), string(definition, "parent")));
+        }
+        if (program.has("globals")) {
+            program.getAsJsonObject("globals").entrySet().forEach(entry -> ui.globals.put(entry.getKey(), entry.getValue().deepCopy()));
+        }
+        if (program.has("texture_metadata")) {
+            program.getAsJsonObject("texture_metadata").entrySet().forEach(entry -> {
+                if (!safePath(entry.getKey())) {
+                    throw new IllegalArgumentException("Invalid custom form texture metadata");
+                }
+                ui.textureFiles.put(entry.getKey(), entry.getValue().toString().getBytes(StandardCharsets.UTF_8));
+            });
+        }
+        ui.customized = true;
+        return ui;
+    }
+
+    public JsonObject resolve(final JsonObject form, final JsonArray values, final Set<Integer> expanded) {
+        try {
+            return this.resolveScene(form, values, expanded);
+        } catch (final IllegalArgumentException | IllegalStateException | JsonParseException unsupported) {
+            return null;
+        }
+    }
+
+    public JsonObject resolve(final JsonObject form) {
+        try {
+            return this.resolveScene(form);
+        } catch (final IllegalArgumentException | IllegalStateException | JsonParseException unsupported) {
+            return null;
+        }
+    }
+
+    JsonObject resolveScene(final JsonObject form) {
+        return this.resolveScene(form, null, Set.of());
+    }
+
+    private JsonObject resolveScene(final JsonObject form, final JsonArray values, final Set<Integer> expanded) {
+        final boolean custom = "custom_form".equals(string(form, "type"));
+        final String collection = custom ? "content" : "elements";
+        if (!this.customized || (!custom && !"form".equals(string(form, "type"))) || !form.has(collection)
+                || !form.get(collection).isJsonArray() || form.getAsJsonArray(collection).size() > MAX_BUTTONS) {
+            return null;
+        }
+        for (final JsonElement element : form.getAsJsonArray(collection)) {
+            if (!element.isJsonObject() || !(custom ? CUSTOM_TYPES : Set.of("button", "header", "label", "divider"))
+                    .contains(string(element.getAsJsonObject(), "type"))) {
+                return null;
+            }
+        }
+        if (custom && expanded.stream().anyMatch(index -> index < 0 || index >= form.getAsJsonArray(collection).size()
+                || !"dropdown".equals(string(form.getAsJsonArray(collection).get(index).getAsJsonObject(), "type")))) {
+            throw new IllegalArgumentException("Invalid expanded custom form input");
+        }
+        final Session session = new Session(form, custom ? responseValues(form, values) : null, expanded);
+        final JsonObject host = this.template("server_form.third_party_server_screen", new HashSet<>());
+        final String rootName = host == null ? "server_form.main_screen_content"
+                : string(host, "$screen_content");
+        final JsonObject root = session.expand(rootName.isEmpty() ? "server_form.main_screen_content" : rootName,
+                new JsonObject(), session.initial, -1, 0);
+        if (root == null || (!custom && session.actions.isEmpty())) {
+            return null;
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", custom ? 2 : 1);
+        scene.add("root", root);
+        if (custom) {
+            scene.add("inputs", session.inputs());
+            scene.add("values", session.state.deepCopy());
+            final JsonArray opened = new JsonArray();
+            expanded.stream().sorted().forEach(opened::add);
+            scene.add("expanded", opened);
+            scene.add("program", this.program(form, session.requiredDefinitions));
+        }
+        final JsonObject fallback = new JsonObject();
+        fallback.add("title", form.get("title"));
+        final List<String> content = new ArrayList<>();
+        content.add(string(form, "content"));
+        final JsonArray fallbackButtons = new JsonArray();
+        for (final JsonElement entry : form.getAsJsonArray(collection)) {
+            final JsonObject element = entry.getAsJsonObject();
+            if ("button".equals(string(element, "type"))) {
+                fallbackButtons.add(element.deepCopy());
+            } else if (!string(element, "text").isBlank()) {
+                content.add(string(element, "text"));
+            }
+        }
+        fallback.addProperty("content", String.join("\n", content));
+        fallback.add("buttons", fallbackButtons);
+        scene.add("fallback", fallback);
+        final JsonArray missing = new JsonArray();
+        session.missingTemplates.forEach(missing::add);
+        scene.add("missing_templates", missing);
+        if (scene.toString().getBytes(StandardCharsets.UTF_8).length > NativeFormMessage.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("UI scene exceeds the payload limit");
+        }
+        return scene;
+    }
+
+    public static JsonArray responseValues(final JsonObject form, final JsonArray values) {
+        if (!"custom_form".equals(string(form, "type")) || !form.has("content") || !form.get("content").isJsonArray()
+                || form.getAsJsonArray("content").size() > MAX_BUTTONS) {
+            throw new IllegalArgumentException("Invalid custom form content");
+        }
+        final JsonArray content = form.getAsJsonArray("content");
+        if (values != null && values.size() != content.size()) {
+            throw new IllegalArgumentException("Custom form response length differs from its content");
+        }
+        final JsonArray result = new JsonArray();
+        for (int index = 0; index < content.size(); index++) {
+            final JsonObject element = content.get(index).getAsJsonObject();
+            final String type = string(element, "type");
+            if (!CUSTOM_TYPES.contains(type)) {
+                throw new IllegalArgumentException("Unsupported custom form element");
+            }
+            final JsonElement value = values == null ? initialValue(element) : values.get(index);
+            final boolean valid = switch (type) {
+                case "label", "header", "divider" -> value.isJsonNull();
+                case "toggle" -> value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean();
+                case "input" -> value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() && value.getAsString().length() <= 100;
+                case "slider" -> value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber() && Float.isFinite(value.getAsFloat());
+                case "dropdown", "step_slider" -> value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()
+                        && value.getAsDouble() == value.getAsInt() && value.getAsInt() >= 0
+                        && value.getAsInt() < Math.max(1, options(element).size());
+                default -> false;
+            };
+            if (!valid) {
+                throw new IllegalArgumentException("Invalid custom form response value at " + index);
+            }
+            result.add(value.deepCopy());
+        }
+        return result;
+    }
+
+    private static JsonElement initialValue(final JsonObject element) {
+        if (Set.of("label", "header", "divider").contains(string(element, "type"))) {
+            return JsonNull.INSTANCE;
+        }
+        if (element.has("default")) {
+            return element.get("default");
+        }
+        return switch (string(element, "type")) {
+            case "toggle" -> new JsonPrimitive(false);
+            case "input" -> new JsonPrimitive("");
+            case "slider" -> element.get("min");
+            default -> new JsonPrimitive(0);
+        };
+    }
+
+    private static JsonArray options(final JsonObject element) {
+        final String name = "step_slider".equals(string(element, "type")) ? "steps" : "options";
+        return element.has(name) && element.get(name).isJsonArray() ? element.getAsJsonArray(name) : new JsonArray();
+    }
+
+    private JsonObject program(final JsonObject form, final Set<String> used) {
+        final Set<String> closure = new LinkedHashSet<>(used);
+        final List<String> pending = new ArrayList<>(used);
+        for (int index = 0; index < pending.size(); index++) {
+            final String name = pending.get(index);
+            final Definition definition = this.definitions.get(name);
+            if (definition == null) {
+                continue;
+            }
+            final Set<String> referenced = new LinkedHashSet<>();
+            referenced.add(definition.parent);
+            this.references(definition.value, name.substring(0, name.indexOf('.')), referenced);
+            for (final String reference : referenced) {
+                if (this.definitions.containsKey(reference) && closure.add(reference)) {
+                    pending.add(reference);
+                }
+            }
+            if (closure.size() > MAX_NODES) {
+                throw new IllegalArgumentException("Custom form definition closure exceeds limits");
+            }
+        }
+        final JsonObject result = new JsonObject();
+        result.add("form", form.deepCopy());
+        final JsonObject definitions = new JsonObject();
+        for (final String name : closure) {
+            final Definition definition = this.definitions.get(name);
