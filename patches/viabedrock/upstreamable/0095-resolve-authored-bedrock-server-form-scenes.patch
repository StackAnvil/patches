+        final Map<String, byte[]> base = new HashMap<>(definitions(textured));
+        base.put("textures/ui/card.png", new byte[]{1, 2, 3});
+        base.put("textures/ui/card.json", "{\"nineslice_size\":2,\"base_size\":[32,32]}".getBytes(StandardCharsets.UTF_8));
+        final Map<String, byte[]> override = Map.of("textures/ui/card.json", "{\"nineslice_size\":4}".getBytes(StandardCharsets.UTF_8));
+        final var ui = new ServerFormUi(List.of(base, override));
+        final var button = ui.resolve(form("tile:One")).getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(4, button.get("nineslice_size").getAsInt());
+        assertEquals(ServerFormUi.textureId("textures/ui/card"), button.get("texture").getAsString());
+        assertArrayEquals(new byte[]{1, 2, 3}, ui.textures().get("textures/ui/card.png"));
+        assertNull(new ServerFormUi(List.of(base, Map.of("textures/ui/card.json", "{".getBytes(StandardCharsets.UTF_8)))).resolve(form("tile:One")));
+    }
+
+}
