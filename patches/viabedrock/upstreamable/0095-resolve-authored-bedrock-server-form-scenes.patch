+package net.raphimc.viabedrock.protocol.rewriter.resourcepack;
+
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.ui.ServerFormUi;
+import net.raphimc.viabedrock.protocol.rewriter.ResourcePackRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Native UI images retain their pixels; UI controls receive isolated Java resource identifiers. */
+public final class ServerFormUiResourceRewriter implements ResourcePackRewriter.Rewriter {
+
+    @Override
+    public void submitTasks(final ResourcePackStorage storage, final Consumer<Supplier<Content>> submitter) {
+        submitter.accept(() -> convert(storage));
+    }
+
+    public static Content convert(final ResourcePackStorage storage) {
+        final Content result = new InMemoryContent();
+        for (final var entry : storage.getServerFormUi().textures().entrySet()) {
+            if (entry.getKey().endsWith(".png")) {
+                final String identifier = ServerFormUi.textureId(entry.getKey());
+                result.put("assets/viabedrock/" + identifier.substring("viabedrock:".length()), entry.getValue());
+            }
+        }
+        return result;
+    }
+
+}
