+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Collections;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Acquired native TTF families keep their case-sensitive metadata names and metric units. */
+final class UiFonts {
+
+    private static final int MAX_FONTS = 256;
+    private static final int MAX_FONT_BYTES = 16 << 20;
+    private final Map<String, byte[]> files = new LinkedHashMap<>();
+    private final Map<String, String> families = new LinkedHashMap<>();
+    private final Map<String, String> importedIds = new LinkedHashMap<>();
+
+    void load(final Map<String, byte[]> layer) {
+        layer.forEach((path, bytes) -> {
+            if (path.startsWith("font/") && JsonUiProgram.safePath(path)
+                    && path.endsWith(".ttf") && bytes.length <= MAX_FONT_BYTES && (this.files.containsKey(path) || this.files.size() < MAX_FONTS)) {
+                this.files.put(path, bytes);
+            }
+        });
+        final byte[] metadata = layer.get("font/font_metadata.json");
+        if (metadata == null || metadata.length > JsonUiProgram.MAX_PAYLOAD_BYTES) {
+            return;
+        }
+        try {
+            final JsonObject root = JsonParser.parseString(new String(metadata, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (!root.has("version") || root.get("version").getAsInt() != 1 || !root.has("fonts")) {
+                return;
+            }
+            for (final JsonElement entry : root.getAsJsonArray("fonts")) {
+                if (!entry.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject font = entry.getAsJsonObject();
+                if (!font.has("font_name") || !font.has("font_format") || !font.has("font_file")) {
+                    continue;
+                }
+                final String name = font.get("font_name").getAsString();
+                if (name.isEmpty() || name.length() > 256 || !this.families.containsKey(name) && this.families.size() >= MAX_FONTS) {
+                    continue;
+                }
+                // A newer declaration also overrides a previously supported family with an unsupported format.
+                this.families.remove(name);
+                if (!"ttf".equals(font.get("font_format").getAsString())) {
+                    continue;
+                }
+                final String source = font.get("font_file").getAsString();
+                final String path = source.endsWith(".ttf") ? source : source + ".ttf";
+                if (path.startsWith("font/") && JsonUiProgram.safePath(path)) {
+                    this.families.put(name, path);
+                }
+            }
+        } catch (final RuntimeException ignored) {
+            // An unusable optional font does not disable the server's entire UI program.
+        }
+    }
+
+    String id(final String name) {
+        final String path = this.families.get(name);
+        return path != null && metrics(this.files.get(path)) != null ? identifier(name) : this.importedIds.get(name);
+    }
+
+    Map<String, String> ids() {
+        final Map<String, String> result = new LinkedHashMap<>(this.importedIds);
+        this.families.forEach((name, path) -> {
+            final byte[] bytes = this.files.get(path);
+            if (metrics(bytes) != null) {
+                result.put(name, identifier(name));
+            }
+        });
+        return Collections.unmodifiableMap(result);
+    }
+
+    void importIds(final JsonObject ids) {
+        if (ids.size() > MAX_FONTS) {
+            throw new IllegalArgumentException("Too many UI fonts");
+        }
+        ids.entrySet().forEach(entry -> {
+            final String id = entry.getValue().getAsString();
+            if (entry.getKey().length() > 256 || !id.matches("viabedrock:server_ui/[a-f0-9]{32}")) {
+                throw new IllegalArgumentException("Invalid UI font identifier");
+            }
+            this.importedIds.put(entry.getKey(), id);
+        });
+    }
+
+    Map<String, byte[]> resources() {
+        final Map<String, byte[]> result = new LinkedHashMap<>();
+        this.families.forEach((name, path) -> {
+            final byte[] bytes = this.files.get(path);
+            final Metrics metrics = metrics(bytes);
+            if (metrics == null) {
+                return;
+            }
+            final String id = identifier(name);
+            final String resource = id.substring("viabedrock:".length());
+            final JsonObject face = new JsonObject();
+            face.addProperty("type", "ttf");
+            face.addProperty("file", id + ".ttf");
+            face.addProperty("size", metrics.size());
+            face.addProperty("oversample", 8);
+            final JsonArray shift = new JsonArray();
+            shift.add(0);
+            // Java 26.3 GlyphBitmap uses a seven-unit baseline; native TTF normalizes hhea descent.
+            shift.add(metrics.baseline() - 7);
+            face.add("shift", shift);
+            final JsonObject fallback = new JsonObject();
+            fallback.addProperty("type", "reference");
+            fallback.addProperty("id", "minecraft:default");
+            final JsonArray providers = new JsonArray();
+            providers.add(face);
+            providers.add(fallback);
+            final JsonObject definition = new JsonObject();
+            definition.add("providers", providers);
+            result.put("assets/viabedrock/font/" + resource + ".json", definition.toString().getBytes(StandardCharsets.UTF_8));
+            result.put("assets/viabedrock/font/" + resource + ".ttf", bytes);
+        });
+        return Collections.unmodifiableMap(result);
+    }
+
+    /** Bedrock's 64-pixel hhea height is normalized to eight UI units, independently of EM size. */
+    static Metrics metrics(final byte[] bytes) {
+        if (bytes == null || bytes.length < 12) {
+            return null;
+        }
+        try {
+            final ByteBuffer buffer = ByteBuffer.wrap(bytes).order(ByteOrder.BIG_ENDIAN);
+            if (buffer.getInt(0) != 0x00010000) {
+                return null;
+            }
+            final int count = Short.toUnsignedInt(buffer.getShort(4));
+            if (count > 256 || 12L + count * 16L > bytes.length) {
+                return null;
+            }
+            int units = 0;
+            int ascent = 0;
+            int descent = 0;
+            for (int index = 0; index < count; index++) {
+                final int record = 12 + index * 16;
+                final int tag = buffer.getInt(record);
+                final long offset = Integer.toUnsignedLong(buffer.getInt(record + 8));
+                final long length = Integer.toUnsignedLong(buffer.getInt(record + 12));
+                if (offset + length > bytes.length) {
+                    return null;
+                }
+                if (tag == 0x68656164 && length >= 20) {
+                    units = Short.toUnsignedInt(buffer.getShort((int) offset + 18));
+                } else if (tag == 0x68686561 && length >= 8) {
+                    ascent = buffer.getShort((int) offset + 4);
+                    descent = buffer.getShort((int) offset + 6);
+                }
+            }
+            if (units < 16 || ascent <= descent || ascent - descent > 65535) {
+                return null;
+            }
+            final double scale = 64D / (ascent - descent);
+            return new Metrics(8D * units / (ascent - descent), 8D + (int) (descent * scale) / 8D);
+        } catch (final IndexOutOfBoundsException ignored) {
+            return null;
+        }
+    }
+
+    private static String identifier(final String name) {
+        try {
+            return "viabedrock:server_ui/" + HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+                    .digest(name.getBytes(StandardCharsets.UTF_8)), 0, 16);
+        } catch (final NoSuchAlgorithmException exception) {
+            throw new IllegalStateException(exception);
+        }
+    }
+
+    record Metrics(double size, double baseline) { }
+
+}
