@@ -0,0 +1,98 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model;
+
+import com.viaversion.viaversion.api.type.Type;
+import com.viaversion.viaversion.api.type.Types;
+
+import io.netty.buffer.ByteBuf;
+
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.nio.charset.StandardCharsets;
+
+/** Presentation for an existing Java menu; ordinary inventory packets retain item authority. */
+public record NativeContainerMessage(int menuId, long sequence, ContainerUi.Kind kind, String conditionTitle, String program) {
+
+    public static final String CHANNEL = "viabedrock:native_container";
+    public static final String CURRENT_CHANNEL = "viabedrock:native_container_v2";
+    public static final int MAX_PAYLOAD_BYTES = 1 << 20;
+    private static final int MAX_TITLE_BYTES = 8192;
+    private static final int HEADER_RESERVE = 64;
+    public static final Type<NativeContainerMessage> TYPE = codec(1);
+    public static final Type<NativeContainerMessage> CURRENT_TYPE = codec(2);
+
+    private static Type<NativeContainerMessage> codec(final int format) {
+        return new Type<>(NativeContainerMessage.class) {
+
+            @Override
+            public NativeContainerMessage read(final ByteBuf buffer) {
+                if (buffer.readableBytes() > MAX_PAYLOAD_BYTES
+                        || Types.VAR_INT.readPrimitive(buffer) != format
+                        || Types.VAR_INT.readPrimitive(buffer)
+                                != ProtocolConstants.BEDROCK_PROTOCOL_VERSION) {
+                    throw new IllegalArgumentException("Unsupported native container message");
+                }
+                final int menuId = Types.VAR_INT.readPrimitive(buffer);
+                final long sequence = Types.VAR_LONG.readPrimitive(buffer);
+                final ContainerUi.Kind kind =
+                        switch (buffer.readUnsignedByte()) {
+                            case 0 -> ContainerUi.Kind.CHEST_3_ROWS;
+                            case 1 -> ContainerUi.Kind.CHEST_6_ROWS;
+                            default ->
+                                    throw new IllegalArgumentException(
+                                            "Unsupported native container family");
+                        };
+                final String title = readString(buffer, MAX_TITLE_BYTES);
+                final String program = readString(buffer, MAX_PAYLOAD_BYTES - HEADER_RESERVE);
+                if (buffer.isReadable()) {
+                    throw new IllegalArgumentException("Trailing native container data");
+                }
+                return new NativeContainerMessage(menuId, sequence, kind, title, program);
+            }
+
+            @Override
+            public void write(final ByteBuf buffer, final NativeContainerMessage value) {
+                final byte[] title = value.conditionTitle.getBytes(StandardCharsets.UTF_8);
+                final byte[] program = value.program.getBytes(StandardCharsets.UTF_8);
+                Types.VAR_INT.writePrimitive(buffer, format);
+                Types.VAR_INT.writePrimitive(buffer, ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+                Types.VAR_INT.writePrimitive(buffer, value.menuId);
+                Types.VAR_LONG.writePrimitive(buffer, value.sequence);
+                buffer.writeByte(value.kind == ContainerUi.Kind.CHEST_3_ROWS ? 0 : 1);
+                writeString(buffer, title);
+                writeString(buffer, program);
+            }
+        };
+    }
+
+    public NativeContainerMessage {
+        if (menuId < 0 || menuId > 255 || sequence <= 0 || kind == null || conditionTitle == null || program == null) {
+            throw new IllegalArgumentException("Invalid native container identity");
+        }
+        final int titleBytes = conditionTitle.getBytes(StandardCharsets.UTF_8).length;
+        final int programBytes = program.getBytes(StandardCharsets.UTF_8).length;
+        if (titleBytes > MAX_TITLE_BYTES || programBytes > MAX_PAYLOAD_BYTES - HEADER_RESERVE - titleBytes) {
+            throw new IllegalArgumentException(
+                    "Native container program exceeds the payload limit");
+        }
+    }
+
+    private static String readString(final ByteBuf buffer, final int limit) {
+        final int length = Types.VAR_INT.readPrimitive(buffer);
+        if (length < 0 || length > limit || length > buffer.readableBytes()) {
+            throw new IllegalArgumentException("Invalid native container string length");
+        }
+        return buffer.readCharSequence(length, StandardCharsets.UTF_8).toString();
+    }
+
+    private static void writeString(final ByteBuf buffer, final byte[] bytes) {
+        Types.VAR_INT.writePrimitive(buffer, bytes.length);
+        buffer.writeBytes(bytes);
+    }
+
+}
