+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ContainerUiTest {
+
+    private static final String UI = """
+            {"namespace":"chest",
+             "small_chest_screen":{"$screen_content":"chest.panel","variables":[
+               {"requires":"($container_title = 'Alternative')","$screen_content":"chest.alternative"}]},
+             "large_chest_screen":{"$screen_content":"chest.panel"},
+             "alternative@chest.panel":{"size":[220,180]},
+             "small_chest_panel@chest.panel":{},"large_chest_panel@chest.panel":{},
+             "panel":{"type":"panel","controls":[
+               {"title":{"type":"label","text":"$container_title"}},
+               {"external":{"type":"grid","collection_name":"container_items","grid_item_template":"chest.cell"}},
+               {"storage":{"type":"grid","collection_name":"inventory_items","grid_item_template":"chest.cell"}},
+               {"hotbar":{"type":"grid","collection_name":"hotbar_items","grid_item_template":"chest.cell"}},
+               {"mirror@chest.cell":{"collection_name":"hotbar_items","collection_index":2}},
+               {"cursor":{"type":"custom","renderer":"inventory_item_renderer","bindings":[
+                 {"binding_name":"#inventory_selected_item","binding_name_override":"#item_id_aux"}]}},
+               {"close":{"type":"button","button_mappings":[{"to_button_id":"button.menu_exit"}]}}]},
+             "cell":{"type":"button","$take":"button.container_take_half_place_one","button_mappings":[
+                {"from_button_id":"button.menu_select","to_button_id":"button.container_take_all_place_all"},
+                {"from_button_id":"button.menu_secondary_select","to_button_id":"$take"}],"controls":[
+               {"icon":{"type":"custom","renderer":"inventory_item_renderer","bindings":[
+                 {"binding_name":"#item_renderer_data","binding_name_override":"#item_id_aux"}]}},
+               {"count":{"type":"label","bindings":[{"binding_name":"#inventory_stack_count","binding_name_override":"#text"}]}},
+               {"durability":{"type":"custom","renderer":"progress_bar_renderer","property_bag":{"is_durability":true,"round_value":true,"drop_shadow":true},"bindings":[
+                 {"binding_name":"#item_durability_visible","binding_name_override":"#touch_progress_bar_visible"},
+                 {"binding_name":"#item_durability_total_amount","binding_name_override":"#progress_bar_total_amount"},
+                 {"binding_name":"#item_durability_current_amount","binding_name_override":"#progress_bar_current_amount"}]}}]}}
+            """;
+
+    private static ContainerUi ui() {
+        return new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", UI.getBytes(StandardCharsets.UTF_8)))));
+    }
+
+    private static ContainerUi.MenuView menu(final ContainerUi.Kind kind, final String title, final int amount) {
+        final int external = kind == ContainerUi.Kind.CHEST_3_ROWS ? 27 : 54;
+        final List<ContainerUi.Slot> slots = new ArrayList<>();
+        for (int index = 0; index < external + 36; index++) {
+            slots.add(new ContainerUi.Slot(index, Map.of("#inventory_stack_count", new JsonPrimitive(index == 0 ? amount : index),
+                    "#item_durability_visible", new JsonPrimitive(index == 0), "#item_durability_total_amount", new JsonPrimitive(100),
+                    "#item_durability_current_amount", new JsonPrimitive(index == 0 ? 45 : 100))));
+        }
+        Collections.reverse(slots);
+        return new ContainerUi.MenuView(7, kind, title, slots, Map.of("#inventory_selected_item_stack_count", new JsonPrimitive(3)));
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void chestFamiliesKeepDistinctActualSlotAddressesAndMirroredControls() {
+        for (final ContainerUi.Kind kind : ContainerUi.Kind.values()) {
+            final int external = kind == ContainerUi.Kind.CHEST_3_ROWS ? 27 : 54;
+            final var scene = ui().resolve(menu(kind, "Actual title", 16));
+            assertNotNull(scene);
+            assertEquals(7, scene.get("menu_id").getAsInt());
+            final List<JsonObject> nodes = nodes(scene.getAsJsonObject("root"));
+            final Set<Integer> addresses = nodes.stream().filter(node -> node.has("inventory_slot"))
+                    .map(node -> node.get("inventory_slot").getAsInt()).collect(java.util.stream.Collectors.toSet());
+            assertEquals(external + 36, addresses.size());
+            assertTrue(addresses.containsAll(java.util.stream.IntStream.range(0, external + 36).boxed().toList()));
+            final var mirrors = nodes.stream().filter(node -> "mirror".equals(JsonUiProgram.string(node, "name"))).toList();
+            assertEquals(1, mirrors.size());
+            assertEquals(external + 29, mirrors.getFirst().get("inventory_slot").getAsInt());
+            assertEquals("hotbar_items", mirrors.getFirst().get("collection").getAsString());
+            assertEquals(2, mirrors.getFirst().getAsJsonArray("inventory_actions").size());
+            assertTrue(nodes.stream().anyMatch(node -> node.has("inventory_cursor") && node.get("inventory_cursor").getAsBoolean()));
+            assertTrue(nodes.stream().anyMatch(node -> "close".equals(JsonUiProgram.string(node, "inventory_command"))));
+            assertFalse(nodes.stream().anyMatch(node -> node.has("action") || node.has("input")));
+            assertFalse(scene.has("form") || scene.has("values"));
+        }
+    }
+
+    @Test
+    void resolvedMappingsPreserveCloseInputAndIgnoredUnknownActionsAcrossExports() {
+        final String definitions = UI.replace("\"close\":{\"type\":\"button\",\"button_mappings\":[{\"to_button_id\":\"button.menu_exit\"}]}", """
+                "close":{"type":"button","$pressed_button_name":"button.menu_exit",
+                  "$source":"button.menu_select","$mapping":"pressed","$ignored":true,
+                  "button_mappings":[{"from_button_id":"$source","to_button_id":"$pressed_button_name","mapping_type":"$mapping"},
+                    {"to_button_id":"button.unsupported","ignored":"$ignored"}]}
+                """.strip());
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", definitions.getBytes(StandardCharsets.UTF_8)))));
+        for (final var kind : ContainerUi.Kind.values()) {
+            final var view = menu(kind, "Actual", 1);
+            final var scene = ui.resolve(view);
+            assertNotNull(scene);
+            final var close = nodes(scene.getAsJsonObject("root")).stream()
+                    .filter(node -> "close".equals(JsonUiProgram.string(node, "name"))).findFirst().orElseThrow();
+            assertEquals("close", close.get("inventory_command").getAsString());
+            final var mapping = close.getAsJsonArray("button_mappings").get(0).getAsJsonObject();
+            assertEquals("button.menu_select", mapping.get("from_button_id").getAsString());
+            assertEquals("button.menu_exit", mapping.get("to_button_id").getAsString());
+            assertEquals("pressed", mapping.get("mapping_type").getAsString());
+            final var ignored = close.getAsJsonArray("button_mappings").get(1).getAsJsonObject();
+            assertTrue(ignored.get("ignored").getAsJsonPrimitive().isBoolean());
+            assertTrue(ignored.get("ignored").getAsBoolean());
+            assertEquals("button.unsupported", ignored.get("to_button_id").getAsString());
+            assertEquals(scene, ContainerUi.fromProgram(ui.exportProgram(kind, new ContainerUi.Title(view.title(), false))).resolve(view));
+            assertEquals(scene, ui.resolve(view));
+        }
+    }
+
+    @Test
+    void livePresentationChangesResolveWithoutChangingSlotIdentityOrResponseDomain() {
+        final var first = ui().resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Initial", 16));
+        final var second = ui().resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Alternative", 8));
+        assertNotNull(second);
+        assertEquals(220, second.getAsJsonObject("root").getAsJsonArray("size").get(0).getAsInt());
+        for (final var scene : List.of(first, second)) {
+            final var nodes = nodes(scene.getAsJsonObject("root"));
+            final var count = nodes.stream().filter(node -> node.has("inventory_slot") && node.get("inventory_slot").getAsInt() == 0
+                    && "count".equals(JsonUiProgram.string(node, "name"))).findFirst().orElseThrow();
+            assertEquals(scene == first ? "16" : "8", count.get("text").getAsString());
+            final var bar = nodes.stream().filter(node -> node.has("inventory_slot") && node.get("inventory_slot").getAsInt() == 0
+                    && "durability".equals(JsonUiProgram.string(node, "name"))).findFirst().orElseThrow();
+            assertTrue(bar.get("touch_progress_bar_visible").getAsBoolean());
+            assertEquals(100, bar.get("progress_bar_total_amount").getAsInt());
+            assertEquals(45, bar.get("progress_bar_current_amount").getAsInt());
+            assertTrue(bar.getAsJsonObject("property_bag").get("is_durability").getAsBoolean());
+            assertTrue(bar.getAsJsonObject("property_bag").get("round_value").getAsBoolean());
+        }
+    }
+
+    @Test
+    void exportedProgramsKeepAuthoredConditionsAndLiveMenuResolution() {
+        for (final var kind : ContainerUi.Kind.values()) {
+            final var exported = ui().exportProgram(kind, new ContainerUi.Title("Alternative", false));
+            assertNotNull(exported);
+            final var replay = ContainerUi.fromProgram(exported);
+            assertEquals(ui().resolve(menu(kind, "Alternative", 8)), replay.resolve(menu(kind, "Alternative", 8)));
+            assertFalse(exported.has("form"));
+        }
+        assertNull(new ContainerUi(new JsonUiProgram(List.of())).exportProgram(ContainerUi.Kind.CHEST_3_ROWS, new ContainerUi.Title("Actual", false)));
+    }
+
+    @Test
+    void exportedRawTitleDrivesConditionsWhileLocalizationOnlyChangesCaption() {
+        final String declarations = UI.replace("($container_title = 'Alternative')",
+                "(($container_title = 'Alternative') and ($thistext = 'Alternative'))")
+                .replace("\"text\":\"$container_title\"", "\"text\":\"$container_title\",\"localize\":\"$localize_title\"");
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", declarations.getBytes(StandardCharsets.UTF_8))),
+                key -> key.equals("Alternative") ? "Translated caption" : key));
+        for (final boolean localize : List.of(false, true)) {
+            final var exported = ui.exportProgram(ContainerUi.Kind.CHEST_3_ROWS, new ContainerUi.Title("Alternative", localize));
+            assertNotNull(exported);
+            final var scene = ContainerUi.fromProgram(exported).resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Unrelated Java caption", 8));
+            assertNotNull(scene);
+            assertEquals(220, scene.getAsJsonObject("root").getAsJsonArray("size").get(0).getAsInt());
+            final var caption = nodes(scene.getAsJsonObject("root")).stream()
+                    .filter(node -> "title".equals(JsonUiProgram.string(node, "name"))).findFirst().orElseThrow();
+            assertEquals(localize ? "Translated caption" : "Alternative", caption.get("text").getAsString());
+            assertFalse(caption.get("localize").getAsBoolean());
+        }
+    }
+
+    @Test
+    void titleBoundsMatchTheMenu() {
+        assertEquals(8192, new ContainerUi.Title("x".repeat(8192), true).raw().length());
+        assertThrows(IllegalArgumentException.class, () -> new ContainerUi.Title("x".repeat(8193), true));
+        assertThrows(IllegalArgumentException.class, () -> new ContainerUi.Title(null, true));
+    }
+
+    @Test
+    void countProvenanceRetainsActualSourcesWithoutSuppressingOtherNumericLabels() {
+        final String definitions = UI.replace("\"text\":\"$container_title\"", "\"text\":\"#inventory_selected_item_stack_count\"")
+                .replace("{\"count\":{", "{\"direct\":{\"type\":\"label\",\"$source\":\"#inventory_stack_count\",\"text\":\"$source\"}},"
+                        + "{\"number\":{\"type\":\"label\",\"text\":\"16\"}},"
+                        + "{\"override\":{\"type\":\"label\",\"text\":\"#inventory_stack_count\",\"bindings\":["
+                        + "{\"binding_name\":\"#item_durability_current_amount\",\"binding_name_override\":\"#text\"}]}},{\"count\":{");
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", definitions.getBytes(StandardCharsets.UTF_8)))));
+        final var scene = ui.resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16));
+        assertNotNull(scene);
+        for (final var node : nodes(scene.getAsJsonObject("root"))) {
+            switch (JsonUiProgram.string(node, "name")) {
+                case "count", "direct" -> assertEquals("slot", node.get("inventory_count").getAsString());
+                case "title" -> assertEquals("cursor", node.get("inventory_count").getAsString());
+                case "number", "override" -> assertFalse(node.has("inventory_count"));
+                default -> { }
+            }
+        }
+    }
+
+    @Test
+    void partialPackLabelsRetainCountSourcesAndTitlesForBothChestFamilies() {
+        final String lower = """
+                {"namespace":"chest","small_chest_screen":{"$screen_content":"chest.panel"},
+                 "large_chest_screen":{"$screen_content":"chest.panel"},
+                 "small_chest_panel@chest.panel":{},"large_chest_panel@chest.panel":{},
+                 "panel":{"type":"panel","controls":[{"title@chest.title":{}},
+                   {"external":{"type":"grid","collection_name":"container_items","grid_item_template":"chest.cell"}},
+                   {"storage":{"type":"grid","collection_name":"inventory_items","grid_item_template":"chest.cell"}},
+                   {"hotbar":{"type":"grid","collection_name":"hotbar_items","grid_item_template":"chest.cell"}}]},
+                 "title":{"type":"label","text":"$container_title","color":[1,1,1]},
+                 "cell":{"type":"panel","controls":[{"count@chest.count_label":{}}]},
+                 "count_label":{"type":"label","$source|default":"#inventory_stack_count","text":"$source",
+                   "bindings":[{"binding_name":"$source","binding_type":"collection","binding_collection_name":"$item_collection_name"}]}}
+                """;
+        final String upper = """
+                {"namespace":"chest","title":{"text":"$container_title"},
+                 "count_label":{"$font|default":"small","font_size":"$font","offset":[2,3]}}
+                """;
+        final var ui = new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", lower.getBytes(StandardCharsets.UTF_8)),
+                Map.of("ui/chest_screen.json", upper.getBytes(StandardCharsets.UTF_8)))));
+        for (final ContainerUi.Kind kind : ContainerUi.Kind.values()) {
+            final var view = menu(kind, "Actual title", 16);
+            final var scene = ui.resolve(view);
+            assertNotNull(scene);
+            final var labels = nodes(scene.getAsJsonObject("root")).stream()
+                    .filter(node -> "label".equals(JsonUiProgram.string(node, "type"))).toList();
+            final var counts = labels.stream().filter(node -> node.has("inventory_count")).toList();
+            assertEquals(view.slots().size(), counts.size());
+            assertEquals(16, counts.getFirst().get("text").getAsInt());
+            assertTrue(counts.stream().allMatch(node -> "slot".equals(node.get("inventory_count").getAsString())));
+            assertTrue(counts.stream().allMatch(node -> "small".equals(node.get("font_size").getAsString())));
+            assertEquals(2, counts.getFirst().getAsJsonArray("offset").get(0).getAsInt());
+            final var titles = labels.stream().filter(node -> "title".equals(JsonUiProgram.string(node, "name"))).toList();
+            assertEquals(1, titles.size());
+            assertEquals("Actual title", titles.getFirst().get("text").getAsString());
+            assertEquals(scene, ContainerUi.fromProgram(ui.exportProgram(kind, new ContainerUi.Title(view.title(), false))).resolve(view));
+        }
+    }
+
+    private static ContainerUi manualGrid(final String controls) {
+        final String definitions = """
+                {"namespace":"chest","small_chest_screen":{"$screen_content":"chest.panel"},
+                 "panel":{"type":"grid","collection_name":"container_items","grid_dimensions":[1000000,1],
+                   "maximum_grid_items":1,"controls":%s},"small_chest_panel@chest.panel":{},
+                 "cell":{"type":"button","button_mappings":[{"to_button_id":"button.container_take_all_place_all"}],
+                   "controls":[{"count":{"type":"label","bindings":[
+                     {"binding_name":"#inventory_stack_count","binding_name_override":"#text"}]}}]}}
+                """.formatted(controls);
+        return new ContainerUi(new JsonUiProgram(List.of(Map.of("ui/chest_screen.json", definitions.getBytes(StandardCharsets.UTF_8)))));
+    }
+
+    @Test
+    void manualGridPositionsSelectRealCollectionsBeforeDescendantBindings() {
+        final var ui = manualGrid("""
+                [{"back@chest.cell":{"grid_position":[18,0],"collection_index":2}},
+                 {"identity@chest.cell":{"grid_position":[2,0]}},
+                 {"hidden@chest.cell":{"grid_position":[7,0],"visible":false}},
+                 {"ignored@chest.cell":{"grid_position":[2147483648,0],"ignored":true}}]
+                """);
+        final var view = menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16);
+        final var scene = ui.resolve(view);
+        assertNotNull(scene);
+        final var cells = scene.getAsJsonObject("root").getAsJsonArray("children");
+        assertEquals(3, cells.size());
+        for (int index = 0; index < 3; index++) {
+            final var cell = cells.get(index).getAsJsonObject();
+            final int slot = new int[] {18, 2, 7}[index];
+            assertEquals(slot, cell.get("inventory_slot").getAsInt());
+            assertEquals(slot, cell.get("collection_index").getAsInt());
+            assertEquals(index < 2, cell.get("visible").getAsBoolean());
+            if (index < 2) {
+                final var count = cell.getAsJsonArray("children").get(0).getAsJsonObject();
+                assertEquals(slot, count.get("text").getAsInt());
+                assertEquals(slot, count.get("inventory_slot").getAsInt());
+            } else {
+                assertTrue(cell.getAsJsonArray("children").isEmpty());
+            }
+        }
+        assertEquals(scene, ContainerUi.fromProgram(ui.exportProgram(view.kind(), new ContainerUi.Title(view.title(), false))).resolve(view));
+    }
+
+    @Test
+    void manualGridRowsAndNestedCollectionsKeepIndependentAddresses() {
+        final var ui = manualGrid("""
+                [{"nested":{"type":"grid","grid_position":[2,0],"collection_name":"hotbar_items",
+                   "grid_dimensions":[4,2],"controls":[
+                     {"selection@chest.cell":{"grid_position":[2,1]}},
+                     {"mirror@chest.cell":{"grid_position":[0,0]}}]}}]
+                """);
+        final var scene = ui.resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16));
+        assertNotNull(scene);
+        final var nested = scene.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals(2, nested.get("inventory_slot").getAsInt());
+        final var children = nested.getAsJsonArray("children");
+        final var selected = children.get(0).getAsJsonObject();
+        assertEquals(60, selected.get("inventory_slot").getAsInt());
+        assertEquals(6, selected.get("collection_index").getAsInt());
+        assertEquals(60, selected.getAsJsonArray("children").get(0).getAsJsonObject().get("text").getAsInt());
+        assertEquals(54, children.get(1).getAsJsonObject().get("inventory_slot").getAsInt());
+    }
+
+    @Test
+    void manualGridRejectsMalformedOverflowAndUnavailableAddresses() {
+        for (final String position : List.of("[1.5,0]", "[1]", "[\"2\",0]", "[-1,0]", "[0,1]", "[2147483648,0]")) {
+            assertNull(manualGrid("[{\"cell@chest.cell\":{\"grid_position\":" + position + "}}]")
+                    .resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16)), position);
+        }
+        final var overflow = manualGrid("[{\"cell@chest.cell\":{\"grid_position\":[0,2147483647]}}]");
+        assertNull(overflow.resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16)));
+        final var unknown = manualGrid("[{\"cell@chest.cell\":{\"type\":\"grid\",\"collection_name\":\"unknown\",\"controls\":[{\"inner@chest.cell\":{}}]}}]");
+        assertNull(unknown.resolve(menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 16)));
+    }
+
+    @Test
+    void invalidAndIncompleteMenusCannotInventSlotAssociations() {
+        final var complete = menu(ContainerUi.Kind.CHEST_3_ROWS, "Actual", 1);
+        final var slots = new ArrayList<>(complete.slots());
+        slots.removeFirst();
+        assertThrows(IllegalArgumentException.class, () -> new ContainerUi.MenuView(7, complete.kind(), complete.title(), slots, Map.of()));
+        slots.add(slots.getFirst());
+        assertThrows(IllegalArgumentException.class, () -> new ContainerUi.MenuView(7, complete.kind(), complete.title(), slots, Map.of()));
+        slots.set(0, new ContainerUi.Slot(80, Map.of()));
+        assertThrows(IllegalArgumentException.class, () -> new ContainerUi.MenuView(7, complete.kind(), complete.title(), slots, Map.of()));
+    }
+
+}
