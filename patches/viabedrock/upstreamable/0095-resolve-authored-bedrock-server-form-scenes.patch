+    @Test
+    void serverFormReplacesContainerAndRetainsFormThroughCloseAcknowledgement() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var storage = new HashMap<Class<?>, Object>();
+        when(user.get(any())).thenAnswer(call -> storage.get(call.getArgument(0)));
+        final var inventory = new InventoryTracker(user);
+        storage.put(InventoryTracker.class, inventory);
+        final var chest = new ChestContainer(user, (byte) 6, null, null, 27);
+        inventory.setCurrentContainer(chest);
+        final var channels = new ChannelStorage();
+        channels.addChannels(List.of(NativeFormMessage.CHANNEL));
+        storage.put(ChannelStorage.class, channels);
+        final var packs = spy(new ResourcePackStorage(List.of()));
+        final var forms = mock(ServerFormUi.class);
+        doReturn(true).when(packs).isLoadedOnJavaClient();
+        doReturn(forms).when(packs).getServerFormUi();
+        when(forms.resolve(any())).thenReturn(new JsonObject());
+        storage.put(ResourcePackStorage.class, packs);
+
+        try (var packets = mockStatic(PacketFactory.class)) {
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(input, 17);
+                BedrockTypes.STRING.write(input, "{\"type\":\"form\",\"title\":\"\",\"content\":\"\",\"buttons\":[]}");
+                final var request = new PacketWrapperImpl(100, input, user);
+                InventoryPackets.handleModalFormRequest(request);
+                assertFalse(request.isCancelled());
+                assertNull(inventory.getCurrentContainer());
+                assertSame(chest, inventory.getPendingCloseContainer());
+                assertEquals(17, inventory.getCurrentForm().leftInt());
+                assertEquals(17, request.get(NativeFormMessage.TYPE, 0).formId());
+                packets.verify(() -> PacketFactory.sendJavaContainerClose(user, 6));
+                packets.verify(() -> PacketFactory.sendBedrockContainerClose(user, (byte) 6, ContainerType.NONE));
+                final var form = inventory.getCurrentForm();
+                final var acknowledgement = new PacketWrapperImpl(47, Unpooled.buffer(), user);
+                acknowledgement.write(Types.BYTE, (byte) ContainerType.NONE.getValue());
+                acknowledgement.write(Types.BOOLEAN, false);
+                acknowledgement.resetReader();
+                InventoryPackets.handleContainerClose(acknowledgement);
+                assertTrue(acknowledgement.isCancelled());
+                assertFalse(inventory.isContainerOpen());
+                assertSame(form, inventory.getCurrentForm());
+            } finally {
+                input.release();
+            }
+        }
+    }
