+
+/** Resolves loaded JSON UI controls against an individual server form, without server-specific templates. */
+public final class ServerFormUi {
+
+    public static final int MAX_NODES = 8192;
+    public static final int MAX_BUTTONS = 1024;
+    private static final int MAX_FILE_BYTES = 1 << 20;
+    private static final Set<String> HOST_FILES = Set.of("ui/server_form.json", "ui/ui_common.json", "ui/_global_variables.json");
+    private final Map<String, Definition> definitions = new LinkedHashMap<>();
+    private final Map<String, JsonElement> globals = new HashMap<>();
+    private final Map<String, byte[]> textureFiles = new LinkedHashMap<>();
+    private boolean customized;
+    private final UnaryOperator<String> translator;
+    private final Map<Character, Integer> formattingColors;
+
+    public ServerFormUi(final ResourcePackStorage storage) {
+        this.translator = storage.getTexts()::translate;
+        this.formattingColors = storage.getTextFormatting().colors();
+        final Map<String, byte[]> builtin = Builtins.FILES;
+        this.loadFiles(builtin, false);
+        builtin.forEach((path, bytes) -> {
+            if (path.startsWith("textures/ui/")) {
+                this.textureFiles.put(path, bytes);
+            }
+        });
+        for (final ResourcePack pack : storage.getPackStackBottomToTop()) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final String path : loadedPaths(pack)) {
+                final byte[] bytes = pack.content().get(path);
+                if (bytes != null && bytes.length <= MAX_FILE_BYTES) {
+                    files.put(path, bytes);
+                }
+            }
+            this.loadFiles(files, storage.isServerPack(pack));
+            for (final String path : pack.content().getFilesDeep("textures/ui/", "")) {
+                if (safePath(path) && (path.endsWith(".png") || path.endsWith(".json"))) {
+                    final byte[] bytes = pack.content().get(path);
+                    if (bytes.length <= 16 * MAX_FILE_BYTES && this.textureFiles.size() < 8192) {
+                        this.textureFiles.put(path, bytes);
+                    }
+                }
+            }
+        }
+    }
+
+    /** Test and tooling entry point. Files have the same load order as a resource-pack stack. */
+    public ServerFormUi(final List<Map<String, byte[]>> layers) {
+        this.translator = UnaryOperator.identity();
+        this.formattingColors = Map.of();
+        for (final Map<String, byte[]> files : layers) {
+            this.loadFiles(files, true);
+            files.forEach((path, bytes) -> {
+                if (safePath(path) && path.startsWith("textures/ui/")
+                        && (path.endsWith(".png") || path.endsWith(".json")) && bytes.length <= 16 * MAX_FILE_BYTES) {
+                    this.textureFiles.put(path, bytes);
+                }
+            });
+        }
+    }
+
+    public Map<String, byte[]> textures() {
+        return Collections.unmodifiableMap(this.textureFiles);
+    }
+
+    public JsonObject resolve(final JsonObject form) {
+        try {
+            return this.resolveScene(form);
+        } catch (final IllegalArgumentException | IllegalStateException | JsonParseException unsupported) {
+            return null;
+        }
+    }
+
+    JsonObject resolveScene(final JsonObject form) {
+        if (!this.customized || !"form".equals(string(form, "type")) || !form.has("buttons")
+                || !form.get("buttons").isJsonArray() || form.getAsJsonArray("buttons").size() > MAX_BUTTONS) {
+            return null;
+        }
+        final Session session = new Session(form);
+        final JsonObject host = this.template("server_form.third_party_server_screen", new HashSet<>());
+        final String rootName = host == null ? "server_form.main_screen_content"
+                : string(host, "$screen_content");
+        final JsonObject root = session.expand(rootName.isEmpty() ? "server_form.main_screen_content" : rootName,
+                new JsonObject(), session.initial, -1, 0);
+        if (root == null || session.actions.isEmpty()) {
+            return null;
+        }
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        final JsonObject fallback = new JsonObject();
+        fallback.add("title", form.get("title"));
+        fallback.add("content", form.get("content"));
+        fallback.add("buttons", form.get("buttons").deepCopy());
+        scene.add("fallback", fallback);
+        final JsonArray missing = new JsonArray();
+        session.missingTemplates.forEach(missing::add);
+        scene.add("missing_templates", missing);
+        if (scene.toString().getBytes(StandardCharsets.UTF_8).length > NativeFormMessage.MAX_PAYLOAD_BYTES) {
+            throw new IllegalArgumentException("UI scene exceeds the payload limit");
+        }
+        return scene;
+    }
+
+    /** A Java dialog can reproduce resolved labels and source indices without the rendering channel. */
+    public static Presentation presentation(final JsonObject scene) {
+        final Map<Integer, String> labels = new LinkedHashMap<>();
+        final List<String> prose = new ArrayList<>();
+        project(scene.getAsJsonObject("root"), labels, prose);
+        final String title = prose.isEmpty() ? string(scene.getAsJsonObject("fallback"), "title") : prose.removeFirst();
+        return new Presentation(title, String.join("\n\n", prose), Collections.unmodifiableMap(labels));
+    }
+
+    private static void project(final JsonObject node, final Map<Integer, String> labels, final List<String> prose) {
+        if (node.has("visible") && !UiExpression.truth(node.get("visible"))) {
+            return;
+        }
+        if (node.has("action")) {
+            final int index = node.get("action").getAsInt();
+            if (index >= 0) {
+                final List<String> text = new ArrayList<>();
+                captions(node, text);
+                final String caption = text.isEmpty() ? string(node, "tts_name") : String.join("\n", text);
+                labels.merge(index, caption, (earlier, later) -> earlier.isBlank() ? later : earlier);
+            }
+            return;
+        }
+        if ("label".equals(string(node, "type")) && !string(node, "text").isBlank()) {
+            prose.add(string(node, "text"));
+        }
+        if (node.has("children")) {
+            for (final JsonElement child : node.getAsJsonArray("children")) {
+                project(child.getAsJsonObject(), labels, prose);
+            }
+        }
+    }
+
+    private static void captions(final JsonObject node, final List<String> text) {
+        if (node.has("visible") && !UiExpression.truth(node.get("visible"))) {
+            return;
+        }
+        if ("label".equals(string(node, "type")) && !string(node, "text").isBlank()) {
+            final String caption = string(node, "text");
+            if (!text.contains(caption)) {
+                text.add(caption);
+            }
+        }
+        if (node.has("children")) {
+            for (final JsonElement child : node.getAsJsonArray("children")) {
+                captions(child.getAsJsonObject(), text);
+            }
+        }
+    }
+
+    private void loadFiles(final Map<String, byte[]> files, final boolean server) {
+        for (final Map.Entry<String, byte[]> file : files.entrySet()) {
+            if (!safePath(file.getKey()) || file.getValue().length > MAX_FILE_BYTES || !file.getKey().endsWith(".json")) {
+                continue;
+            }
+            try {
+                final JsonElement parsed = JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8));
+                if (!parsed.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject document = parsed.getAsJsonObject();
+                if (file.getKey().equals("ui/_global_variables.json")) {
+                    document.entrySet().forEach(entry -> this.globals.put(entry.getKey(), entry.getValue()));
+                    continue;
+                }
+                final String namespace = string(document, "namespace");
+                if (namespace.isEmpty() || namespace.length() > 128) {
+                    continue;
+                }
+                for (final Map.Entry<String, JsonElement> entry : document.entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        continue;
+                    }
+                    final String[] name = entry.getKey().split("@", 2);
+                    if (this.definitions.size() >= 8192) {
+                        throw new IllegalArgumentException("Too many UI definitions");
+                    }
+                    this.definitions.put(namespace + "." + name[0],
+                            new Definition(entry.getValue().getAsJsonObject(), name.length == 2 ? (name[1].contains(".") ? name[1] : namespace + "." + name[1]) : ""));
+                }
+                this.customized |= server && file.getKey().equals("ui/server_form.json");
+            } catch (final RuntimeException malformed) {
+                // A malformed unrelated UI file cannot activate an unused control.
+            }
+        }
+    }
+
+    private JsonObject template(final String name, final Set<String> active) {
+        final Definition definition = this.definitions.get(name);
+        if (definition == null) {
+            return null;
+        }
+        if (!active.add(name) || active.size() > 64) {
+            throw new IllegalArgumentException("Recursive UI inheritance");
+        }
+        try {
+            final JsonObject result;
+            if (definition.parent.isEmpty()) {
+                result = new JsonObject();
+            } else {
+                final JsonObject parent = this.template(definition.parent, active);
+                if (parent == null) {
+                    throw new MissingControlException(definition.parent);
+                }
+                result = parent.deepCopy();
+            }
+            merge(result, definition.value);
+            return result;
+        } finally {
+            active.remove(name);
+        }
+    }
+
+    private static void merge(final JsonObject target, final JsonObject source) {
+        for (final Map.Entry<String, JsonElement> entry : source.entrySet()) {
+            // Native controls arrays replace their inherited array. They are not concatenated.
+            target.add(entry.getKey(), entry.getValue().deepCopy());
+        }
+    }
+
+    private static void declarations(final JsonObject control, final Map<String, JsonElement> values) {
+        for (final Map.Entry<String, JsonElement> entry : control.entrySet()) {
+            if (entry.getKey().startsWith("$")) {
+                final String key = entry.getKey();
+                if (entry.getValue().isJsonPrimitive() && key.equals(entry.getValue().getAsString())
+                        && values.containsKey(key)) {
+                    continue; // A declaration that forwards itself retains its enclosing scope value.
+                }
+                // Keep defaults separate: an exact value in any enclosing scope takes precedence.
+                values.put(key, entry.getValue());
+            }
+        }
+        if (control.has("variables")) {
+            final JsonElement variableSets = control.get("variables");
+            final List<JsonElement> sets = variableSets.isJsonArray() ? variableSets.getAsJsonArray().asList() : List.of(variableSets);
+            for (final JsonElement set : sets) {
+                final JsonObject variables = set.getAsJsonObject();
+                if (!variables.has("requires") || UiExpression.truth(resolveValue(variables.get("requires"), values, 0))) {
+                    variables.entrySet().stream().filter(entry -> entry.getKey().startsWith("$"))
+                            .forEach(entry -> values.put(entry.getKey(), entry.getValue()));
+                }
+            }
+        }
+    }
+
+    private static JsonElement resolveValue(final JsonElement value, final Map<String, JsonElement> values, final int depth) {
+        if (depth > 32) {
+            throw new IllegalArgumentException("Recursive UI variable");
+        }
+        if (value == null || value.isJsonNull()) {
+            return JsonNull.INSTANCE;
+        }
+        if (value.isJsonArray()) {
+            final JsonArray result = new JsonArray();
+            for (final JsonElement entry : value.getAsJsonArray()) {
+                result.add(resolveValue(entry, values, depth + 1));
+            }
+            return result;
+        }
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+            return value.deepCopy();
+        }
+        final String text = value.getAsString();
+        if (text.startsWith("$") || text.startsWith("#")) {
+            final JsonElement source = values.containsKey(text) ? values.get(text) : values.get(text + "|default");
+            if (source == null) {
+                return JsonNull.INSTANCE;
+            }
+            if (text.startsWith("#")) {
+                return source; // Binding data is literal, even when a player label starts with an operator.
+            }
+            if (source == value) {
+                throw new IllegalArgumentException("Recursive UI variable");
+            }
+            return resolveValue(source, values, depth + 1);
+        }
+        if (text.startsWith("(")) {
+            return UiExpression.evaluate(text, key -> resolveValue(new JsonPrimitive(key), values, depth + 1));
+        }
+        return value;
+    }
+
+    private static String substitute(final String reference, final Map<String, JsonElement> values) {
+        String result = reference;
+        int search = 0;
+        for (int count = 0; count < 32; count++) {
+            final int start = result.indexOf('$', search);
+            if (start < 0) {
+                break;
+            }
+            int end = start + 1;
+            while (end < result.length() && (Character.isLetterOrDigit(result.charAt(end)) || result.charAt(end) == '_')) {
+                end++;
+            }
+            final String replacement = UiExpression.text(resolveValue(new JsonPrimitive(result.substring(start, end)), values, 0));
+            if (replacement.isEmpty()) {
+                // Instance names are opaque identities. An unresolved instance name does not change its explicit template.
+                if (result.indexOf('@') >= end) {
+                    search = end;
+                    continue;
+                }
+                throw new IllegalArgumentException("Missing UI control variable " + result.substring(start, end));
+            }
+            result = result.substring(0, start) + replacement + result.substring(end);
+            search = start;
+        }
+        return result.startsWith("@") ? result.substring(1) : result;
+    }
+
+    public static String builtinIdentity() {
+        return Builtins.IDENTITY;
+    }
+
+    public static String textureId(final String path) {
+        if (!safePath(path)) {
+            throw new IllegalArgumentException("Invalid UI texture");
+        }
+        return "viabedrock:textures/server_ui/" + path.replaceAll("\\.png$", "") + ".png";
+    }
+
+    private static List<String> loadedPaths(final ResourcePack pack) {
+        final Set<String> result = new LinkedHashSet<>(HOST_FILES);
+        if (pack.content().contains("ui/_ui_defs.json") && pack.content().get("ui/_ui_defs.json").length <= MAX_FILE_BYTES) {
+            try {
+                final JsonArray paths = pack.content().getJson("ui/_ui_defs.json").getAsJsonArray("ui_defs");
+                if (paths != null && paths.size() <= 512) {
+                    for (final JsonElement path : paths) {
+                        if (path.isJsonPrimitive() && safePath(path.getAsString()) && path.getAsString().startsWith("ui/")) {
+                            result.add(path.getAsString());
+                        }
+                    }
+                }
+            } catch (final RuntimeException malformed) {
+                // Invalid definitions never activate files through a directory scan.
+            }
+        }
+        return List.copyOf(result);
+    }
+
+    private static Map<String, byte[]> builtinFiles() {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        try (InputStream source = ServerFormUi.class.getResourceAsStream("/assets/viabedrock/builtin_ui.zip")) {
+            if (source == null) {
+                return files;
+            }
+            try (ZipInputStream zip = new ZipInputStream(source)) {
+                int total = 0;
+                for (var entry = zip.getNextEntry(); entry != null; entry = zip.getNextEntry()) {
+                    if (entry.isDirectory() || !safePath(entry.getName()) || files.size() >= 4096) {
+                        continue;
+                    }
+                    final byte[] bytes = zip.readNBytes(16 * MAX_FILE_BYTES + 1);
+                    total += bytes.length;
+                    if (bytes.length > 16 * MAX_FILE_BYTES || total > 64 * MAX_FILE_BYTES) {
+                        throw new IOException("Bundled UI exceeds limits");
+                    }
+                    files.put(entry.getName(), bytes);
+                }
+            }
+        } catch (final IOException malformed) {
+            files.clear();
+        }
+        return files;
+    }
+
+    private static boolean safePath(final String path) {
+        return path.matches("[A-Za-z0-9_./-]{1,256}") && !path.contains("..") && !path.startsWith("/");
+    }
+
+    private static String string(final JsonObject object, final String key) {
+        final JsonElement value = object.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
+
+    public record Presentation(String title, String content, Map<Integer, String> buttons) {
+    }
+
+    private final class Session {
+        private final JsonObject form;
+        private final Map<String, JsonElement> initial = new HashMap<>(ServerFormUi.this.globals);
+        private final Map<String, Map<String, JsonElement>> controls = new HashMap<>();
+        private final Set<Integer> actions = new HashSet<>();
+        private final Map<Integer, Map<String, JsonElement>> engineBindings = new HashMap<>();
+        private final Set<String> missingTemplates = new LinkedHashSet<>();
+        private int nodes;
+
+        private Session(final JsonObject form) {
+            this.form = form;
+            this.initial.put("#title_text", form.has("title") ? form.get("title") : new JsonPrimitive(""));
+            this.initial.put("#form_text", form.has("content") ? form.get("content") : new JsonPrimitive(""));
+            this.initial.put("#form_content_text", this.initial.get("#form_text"));
+            this.initial.put("#form_button_length", new JsonPrimitive(form.getAsJsonArray("buttons").size()));
+            this.initial.put("#is_using_gamepad", new JsonPrimitive(false));
+            this.initial.put("$is_console", new JsonPrimitive(false));
+            this.initial.put("#is_using_touch", new JsonPrimitive(false));
+        }
+
+        private JsonObject expand(final String reference, final JsonObject overrides,
+                                  final Map<String, JsonElement> inherited, final int button, final int depth) {
+            if (++this.nodes > MAX_NODES || depth > 64) {
+                throw new IllegalArgumentException("UI scene exceeds limits");
+            }
+            final String resolvedName = substitute(reference, inherited);
+            final String[] parts = resolvedName.split("@", 2);
+            final String name = parts[0];
+            final String declaredBase = parts.length == 2 ? parts[1] : name;
+            final String baseName = parts.length == 2 && !declaredBase.contains(".")
