+
+    @Test
+    void hoverTextBindingsPreserveFormattingAndAuthoredWidth() {
+        final String hover = """
+                {"namespace":"server_form","base_button":{"type":"button",
+                 "controls":[{"tooltip":{"type":"custom","renderer":"hover_text_renderer",
+                  "hover_text_max_width":160,"localize":false,
+                  "bindings":[{"binding_name":"(#form_button_text - 'tile:')","binding_name_override":"#hover_text"}]}}]}}
+                """;
+        final var scene = new ServerFormUi(List.of(definitions(UI), definitions(hover))).resolve(form("tile:§eDetails"));
+        assertNotNull(scene);
+        final JsonObject tooltip = scene.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject()
+                .getAsJsonArray("children").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals("§eDetails", tooltip.get("hover_text").getAsString());
+        assertNotNull(tooltip.get("hover_text_component"));
+        assertEquals(160, tooltip.get("hover_text_max_width").getAsInt());
+        assertFalse(tooltip.has("action"));
+        assertEquals(java.util.Set.of(0), ServerFormUi.presentation(scene).buttons().keySet());
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpressionTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiExpressionTest.java
