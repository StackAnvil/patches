+        }
+
+        private JsonObject expandChild(final String reference, final JsonObject overrides,
+                                       final Map<String, JsonElement> inherited, final int button, final int depth) {
+            try {
+                return this.expand(reference, overrides, inherited, button, depth);
+            } catch (final MissingControlException missing) {
+                // The native factory logs a missing base and returns an empty child, retaining its siblings.
+                this.missingTemplates.add(missing.getMessage());
+                return null;
+            }
+        }
+
+        private void children(final JsonArray input, final JsonArray output, final Map<String, JsonElement> values,
+                              final int button, final int depth, final Set<String> stateControls) {
+            for (final JsonElement element : input) {
+                if (!element.isJsonObject()) {
+                    throw new IllegalArgumentException("Invalid UI child");
+                }
+                for (final Map.Entry<String, JsonElement> entry : element.getAsJsonObject().entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        throw new IllegalArgumentException("Invalid UI control");
+                    }
+                    final String name = substitute(entry.getKey(), values).split("@", 2)[0];
+                    final Map<String, JsonElement> context;
+                    if (stateControls.contains(name)) {
+                        context = new HashMap<>(values);
+                        context.put("$__state_branch", new JsonPrimitive(true));
+                    } else {
+                        context = values;
+                    }
+                    final JsonObject child = this.expandChild(entry.getKey(), entry.getValue().getAsJsonObject(), context, button, depth + 1);
+                    if (child != null) {
+                        output.add(child);
+                    }
+                }
+            }
+        }
+
+        private static Set<String> stateControls(final JsonObject node) {
+            final List<String> properties = switch (string(node, "type")) {
+                case "slider" -> List.of("default_control", "hover_control");
+                case "slider_box" -> List.of("default_control", "hover_control", "locked_control", "indent_control");
+                default -> List.of();
+            };
+            final Set<String> names = new HashSet<>();
+            for (final String property : properties) {
+                final String name = string(node, property);
+                if (!name.isEmpty()) {
+                    names.add(name);
+                }
+            }
+            return names;
+        }
+
+        private void factory(final JsonObject factory, final JsonObject node, final JsonArray children,
+                             final Map<String, JsonElement> values, final int button, final int depth) {
+            if (factory.has("control_name")) {
+                this.collection(UiExpression.text(resolveValue(factory.get("control_name"), values, 0)), children, values, button, string(node, "collection_name"), depth);
+            } else if (factory.has("control_ids") && factory.get("control_ids").isJsonObject()) {
+                final JsonObject ids = factory.getAsJsonObject("control_ids");
+                if ("factory".equals(string(node, "type"))) {
+                    final JsonElement selected = ids.get(this.custom ? "custom_form" : "long_form");
+                    if (selected != null) {
+                        final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, button, depth + 1);
+                        if (child != null) {
+                            children.add(child);
+                        }
+                    }
+                } else {
+                    final JsonElement collection = values.get("#collection_length");
+                    final JsonElement entries = collection != null && collection.isJsonArray() ? collection
+                            : values.get(UiExpression.text(collection));
+                    if (entries != null && entries.isJsonArray()) {
+                        int index = 0;
+                        for (final JsonElement entry : entries.getAsJsonArray()) {
+                            final int elementIndex = index++;
+                            final JsonElement selected = ids.get(UiExpression.text(entry));
+                            if (selected != null) {
+                                final JsonObject child = this.expandChild(UiExpression.text(resolveValue(selected, values, 0)), new JsonObject(), values, elementIndex, depth + 1);
+                                if (child != null) {
+                                    children.add(child);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        private void collection(final String template, final JsonArray children, final Map<String, JsonElement> values,
+                                final int selectedElement, final String collection, final int depth) {
+            if (template.isEmpty()) {
+                throw new IllegalArgumentException("Empty UI collection template");
+            }
+            final boolean nested = this.custom && selectedElement >= 0 && Set.of("custom_dropdown", "custom_multiselect").contains(collection);
+            final int count = nested ? options(this.elements.get(selectedElement).getAsJsonObject()).size() : this.elements.size();
+            for (int index = 0; index < count; index++) {
+                final Map<String, JsonElement> context = new HashMap<>(values);
+                if (nested) {
+                    context.put("$__option_index", new JsonPrimitive(index));
+                    context.put("#collection_index", new JsonPrimitive(index));
+                }
+                final JsonObject child = this.expandChild(template, new JsonObject(), context, nested ? selectedElement : index, depth + 1);
+                if (child != null) {
+                    children.add(child);
+                }
+            }
+        }
+
+        private Map<String, JsonElement> engine(final int button) {
+            return this.engineBindings.computeIfAbsent(button, index -> {
+                final Map<String, JsonElement> result = new HashMap<>(this.initial);
+                result.put("#form_button_text", new JsonPrimitive(""));
+                result.put("#form_button_index", new JsonPrimitive(-1));
+                result.put("#form_button_texture", new JsonPrimitive(""));
+                result.put("#form_button_texture_file_system", new JsonPrimitive("path"));
+                if (index >= 0) {
+                    final JsonObject element = this.elements.get(index).getAsJsonObject();
+                    if (this.custom) {
+                        final JsonElement value = this.state.get(index);
+                        result.put("#custom_text", element.has("text") ? element.get("text") : new JsonPrimitive(""));
+                        result.put("#custom_tooltip_text", element.has("tooltip") ? element.get("tooltip") : new JsonPrimitive(""));
+                        result.put("#custom_toggle_state", value);
+                        result.put("#custom_toggle_enabled", new JsonPrimitive(true));
+                        result.put("#custom_input_text", value);
+                        result.put("#custom_placeholder_text", element.has("placeholder") ? element.get("placeholder") : new JsonPrimitive(""));
+                        result.put("#custom_input_enabled", new JsonPrimitive(true));
+                        result.put("#custom_slider_enabled", new JsonPrimitive(true));
+                        result.put("#custom_slider_timeout", new JsonPrimitive(0));
+                        if ("slider".equals(string(element, "type"))) {
+                            final float minimum = element.get("min").getAsFloat();
+                            final float maximum = Math.max(minimum, element.get("max").getAsFloat());
+                            if (!Float.isFinite(minimum) || !Float.isFinite(maximum) || maximum == minimum) {
+                                throw new IllegalArgumentException("Custom slider has no finite range");
+                            }
+                            result.put("#custom_slider_value", new JsonPrimitive((value.getAsFloat() - minimum) / (maximum - minimum)));
+                        } else {
+                            result.put("#custom_slider_value", value);
+                        }
+                        if ("slider".equals(string(element, "type"))) {
+                            final float step = element.has("step") ? element.get("step").getAsFloat() : 1F;
+                            final String number = step == Math.floor(step)
+                                    ? Integer.toString((int) Math.floor(value.getAsFloat())) : String.format(Locale.ROOT, "%f", value.getAsFloat());
+                            result.put("#custom_slider_text", new JsonPrimitive(this.sliderCaption(element, number)));
+                        }
+                        result.put("#custom_slider_text_value", value);
+                        result.put("#custom_slider_step_value", value);
+                        result.put("#custom_slider_steps", new JsonPrimitive(options(element).size()));
+                        final JsonElement caption = value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()
+                                && value.getAsInt() >= 0 && value.getAsInt() < options(element).size() ? options(element).get(value.getAsInt()) : new JsonPrimitive("");
+                        result.put("#custom_slider_step_text", new JsonPrimitive(this.sliderCaption(element, UiExpression.text(caption))));
+                        result.put("#custom_slider_step_text_value", caption);
+                        result.put("#dropdown_option_text", caption);
+                        result.put("#custom_dropdown_length", new JsonPrimitive(options(element).size()));
+                        result.put("#custom_dropdown", new JsonPrimitive(this.expanded.contains(index)));
+                    }
+                    result.put("#form_button_text", element.has("text") ? element.get("text") : new JsonPrimitive(""));
+                    result.put("#form_button_index", new JsonPrimitive(this.buttonIndices[index]));
+                    result.put("#collection_index", new JsonPrimitive(index));
