+                node.addProperty("localize", false);
+                node.add(textProperty + "_component", TextUtil.textComponentToGson(TextUtil.stringToTextComponent(text, ServerFormUi.this.formattingColors)));
+            }
+            if (Set.of("button", "toggle").contains(string(node, "type"))) {
+                String action = UiExpression.text(resolveValue(new JsonPrimitive("$pressed_button_name"), values, 0));
+                if (action.isEmpty() && node.has("button_mappings") && node.get("button_mappings").isJsonArray()) {
+                    for (final JsonElement mapping : node.getAsJsonArray("button_mappings")) {
+                        if (mapping.isJsonObject()) {
+                            final String target = string(mapping.getAsJsonObject(), "to_button_id");
+                            if (target.equals("button.form_button_click") || target.equals("button.menu_exit")) {
+                                action = target;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if (action.equals("button.menu_exit")) {
+                    node.addProperty("action", -1);
+                } else if (action.equals("button.form_button_click") && selectedElement >= 0
+                        && this.buttonIndices[selectedElement] >= 0) {
+                    final int responseIndex = this.buttonIndices[selectedElement];
