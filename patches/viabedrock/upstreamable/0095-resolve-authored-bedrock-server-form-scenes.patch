+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void activeFormOrNpcDialogueReturnsUserBusyWithoutClosingInventory(final boolean npcDialogue) throws Exception {
+        final var user = mock(UserConnection.class);
+        final var inventory = new InventoryTracker(user);
+        when(user.get(InventoryTracker.class)).thenReturn(inventory);
+        if (npcDialogue) {
+            final var npc = new NpcDialogueStorage();
+            npc.open(1, 2, "", "[]");
+            when(user.get(NpcDialogueStorage.class)).thenReturn(npc);
+        } else {
+            inventory.setCurrentForm(IntObjectPair.of(4,
+                    FormSerializer.deserialize("{\"type\":\"form\",\"title\":\"\",\"content\":\"\",\"buttons\":[]}")));
+        }
+        final var response = mock(PacketWrapper.class);
+        try (var wrappers = mockStatic(PacketWrapper.class);
+             var packets = mockStatic(PacketFactory.class)) {
+            wrappers.when(() -> PacketWrapper.create(ServerboundBedrockPackets.MODAL_FORM_RESPONSE, user)).thenReturn(response);
+            final var input = Unpooled.buffer();
+            try {
+                BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(input, 17);
+                BedrockTypes.STRING.write(input, "{}");
+                final var request = new PacketWrapperImpl(100, input, user);
+                InventoryPackets.handleModalFormRequest(request);
+                assertTrue(request.isCancelled());
+                verify(response).write(Types.BYTE, (byte) ModalFormCancelReason.UserBusy.getValue());
+                verify(response).sendToServer(BedrockProtocol.class);
+                packets.verifyNoInteractions();
+            } finally {
+                input.release();
+            }
+        }
+    }
