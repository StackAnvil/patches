+package net.raphimc.viabedrock.protocol.storage;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.NativeContainerAction;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeContainerUiStateTest {
+
+    @Test
+    void staleActionsCannotRetireTheCurrentPresentationOrAuthorizeAnEmptyScope() {
+        final var program = ContainerUi.fromProgram(JsonParser.parseString("""
+                {"definitions":{
+                  "chest.small_chest_screen":{"parent":"","value":{"$screen_content":"chest.small_chest_panel"}},
+                  "chest.small_chest_panel":{"parent":"","value":{"type":"panel"}}
+                }}
+                """).getAsJsonObject());
+        final var actions = mock(NativeContainerUiState.Actions.class);
+        when(actions.current()).thenReturn(true);
+        final var state = new NativeContainerUiState();
+        final var title = new ContainerUi.Title("Actual", false);
+        final var first = state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS, title, program, message -> actions);
+        assertNotNull(first);
+        assertFalse(state.handleAction(action(first.sequence(), NativeContainerAction.Mode.ACTIVATE)));
+        assertFalse(state.blocksVanillaClicks());
+        when(actions.hasActions()).thenReturn(true);
+        assertTrue(state.handleAction(action(first.sequence(), NativeContainerAction.Mode.ACTIVATE)));
+        assertTrue(state.blocksVanillaClicks());
+        assertFalse(state.handleAction(action(first.sequence() + 1, NativeContainerAction.Mode.DEACTIVATE)));
+        assertTrue(state.blocksVanillaClicks());
+        when(actions.current()).thenReturn(false);
+        assertFalse(state.handleAction(action(first.sequence(), NativeContainerAction.Mode.AUTO_PLACE_ONE)));
+        assertFalse(state.blocksVanillaClicks());
+        verify(actions, never()).autoPlaceOne(anyInt(), anyInt());
+        when(actions.current()).thenReturn(true);
+        final var next = state.prepareActions(6, ContainerUi.Kind.CHEST_3_ROWS, title, program, message -> actions);
+        assertNotNull(next);
+        assertFalse(state.handleAction(action(first.sequence(), NativeContainerAction.Mode.ACTIVATE)));
+        assertFalse(state.blocksVanillaClicks());
+        assertTrue(state.handleAction(action(next.sequence(), NativeContainerAction.Mode.ACTIVATE)));
+        state.clearActions();
+        assertFalse(state.blocksVanillaClicks());
+        assertFalse(state.handleAction(action(next.sequence(), NativeContainerAction.Mode.ACTIVATE)));
+    }
+
+    private static NativeContainerAction action(final long sequence, final NativeContainerAction.Mode mode) {
+        return new NativeContainerAction(6, sequence, 0, mode, mode == NativeContainerAction.Mode.AUTO_PLACE_ONE ? 9 : -1);
+    }
+
+}
