+            }
+            if (this.custom && selectedElement >= 0) {
+                final String widget = string(node, "type");
+                final String elementType = string(this.elements.get(selectedElement).getAsJsonObject(), "type");
+                if (Set.of("toggle", "slider", "slider_box", "edit_box").contains(widget)) {
