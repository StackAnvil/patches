@@ -0,0 +1,56 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class UiExpressionTest {
+
+    @Test
+    void nestedCollectionConditionsAndDataSlicingPreservePayloadBoundaries() {
+        final Map<String, JsonElement> values = Map.of("#payload", new JsonPrimitive("``````````Amber`Blue`Green"),
+                "$flag", new JsonPrimitive("Amber"), "#using_gamepad", new JsonPrimitive(false));
+        assertTrue(UiExpression.evaluate("(not ((#payload - $flag) = #payload) and not #using_gamepad)", values).getAsBoolean());
+        assertEquals("Amber", UiExpression.evaluate("(('%.15s' * #payload) - ('%.10s' * #payload))", values).getAsString());
+        assertEquals("BlueGreen", UiExpression.evaluate("(#payload - ('%.16s' * #payload) - '`')", values).getAsString());
+        assertEquals(7, UiExpression.evaluate("(1 + 2 * 3)", values).getAsInt());
+        assertFalse(UiExpression.evaluate("(false and true or false)", values).getAsBoolean());
+    }
+
+    @Test
+    void originalNativeStringOperatorsReparseOutputsAndRetainTypedVariableNumbers() {
+        final var values = Map.<String, JsonElement>of("$floating", new JsonPrimitive(1.5F));
+        assertFalse(UiExpression.evaluate("('123' = 123)", values).getAsBoolean());
+        assertTrue(UiExpression.evaluate("(true = 1)", values).getAsBoolean());
+        assertTrue(UiExpression.evaluate("($missing = '')", values).getAsBoolean());
+        assertEquals(123, UiExpression.evaluate("('00123' - '`')", values).getAsInt());
+        assertEquals(123, UiExpression.evaluate("(1 * ('`123`' - '`'))", values).getAsInt());
+        assertEquals(1, UiExpression.evaluate("(1 * '123')", values).getAsInt());
+        assertEquals(1231, UiExpression.evaluate("('123' + 1)", values).getAsInt());
+        assertEquals(123, UiExpression.evaluate("('123x' - 'x')", values).getAsInt());
+        assertEquals(123, UiExpression.evaluate("('%.3s' * '123abc')", values).getAsInt());
+        assertFalse(UiExpression.evaluate("('false' - '')", values).getAsBoolean());
+        assertEquals(1, UiExpression.evaluate("(1.5 + 0.5)", values).getAsInt());
+        assertEquals(0.75F, UiExpression.evaluate("($floating / 2)", values).getAsFloat());
+        assertEquals("é", UiExpression.evaluate("('%.2s' * 'éé')", values).getAsString());
+    }
+
+    @Test
+    void boundsAndSyntaxCannotEscapeTheBindingEvaluator() {
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("(".repeat(65) + "1" + ")".repeat(65), Map.of()));
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("(1 / 0)", Map.of()));
+        final var large = Map.<String, JsonElement>of("$text", new JsonPrimitive("x".repeat(600_000)));
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("($text + $text)", large));
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("(1) external", Map.of()));
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("'unterminated", Map.of()));
+        assertThrows(IllegalArgumentException.class, () -> UiExpression.evaluate("'" + "x".repeat(8192) + "'", Map.of()));
+    }
+
+}
diff --git a/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiTexturesTest.java b/src/test/java/net/raphimc/viabedrock/api/resourcepack/ui/UiTexturesTest.java
