+package net.raphimc.viabedrock.api.resourcepack.ui;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ServerFormUiSliderStateTest {
+
+    private static final String DEFINITIONS = """
+            {"namespace":"server_form",
+             "main_screen_content":{"type":"panel","factory":{"control_ids":{"label":"@server_form.prose","slider":"@server_form.slider","step_slider":"@server_form.slider"}},
+               "bindings":[{"binding_name":"#custom_form_length","binding_name_override":"#collection_length"}]},
+             "prose":{"type":"panel","controls":[{"text":{"type":"label","text":"#custom_text"}}]},
+             "slider":{"type":"slider","$hover_name":"over","default_control":"idle","hover_control":"$hover_name",
+               "bindings":[{"binding_name":"#custom_slider_value","binding_name_override":"#slider_value"}],
+               "controls":[{"idle@server_form.bar":{}},{"$hover_name@server_form.bar":{"visible":false}},
+                 {"thumb":{"type":"slider_box","default_control":"normal","hover_control":"hover","locked_control":"locked","indent_control":"indent",
+                   "controls":[{"normal@server_form.bar":{}},{"hover@server_form.bar":{"visible":false}},
+                     {"locked@server_form.bar":{"visible":false}},{"indent@server_form.bar":{"visible":false}}]}},
+                 {"unrelated":{"type":"panel","visible":false,"controls":[{"unused@missing.template":{}}]}},
+                 {"unrelated_toggle":{"type":"toggle","hover_control":"hidden",
+                   "controls":[{"hidden":{"type":"panel","visible":false,"controls":[{"unused@missing.template":{}}]}}]}}]},
+             "bar":{"type":"panel","size":[80,10],"controls":[{"caption":{"type":"label","text":"#custom_text"}},
+               {"conditional":{"type":"panel","visible":false,"bindings":[{"binding_name":"(#custom_slider_value > 0.5)","binding_name_override":"#visible"}],
+                 "controls":[{"caption":{"type":"label","text":"#custom_text"}}]}},
+               {"ignored":{"type":"panel","ignored":true,"controls":[{"unused@missing.template":{}}]}}]}}
+            """;
+
+    private static ServerFormUi ui(final String definitions) {
+        return new ServerFormUi(List.of(Map.of("ui/server_form.json", definitions.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    private static JsonObject form() {
+        return JsonParser.parseString("""
+                {"type":"custom_form","title":"Example","content":[
+                  {"type":"label","text":"Heading"},{"type":"slider","text":"Scalar","min":3,"max":8},
+                  {"type":"step_slider","text":"Steps","steps":["A","B","C"],"default":1}]}
+                """).getAsJsonObject();
+    }
+
+    private static JsonObject child(final JsonObject node, final String name) {
+        return node.getAsJsonArray("children").asList().stream().map(element -> element.getAsJsonObject())
+                .filter(element -> element.get("name").getAsString().equals(name)).findFirst().orElseThrow();
+    }
+
+    private static List<JsonObject> descendants(final JsonObject node) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(node);
+        node.getAsJsonArray("children").forEach(element -> result.addAll(descendants(element.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void namedStateBranchesRetainBoundDescendantsWithoutActivatingHiddenGeometry() {
+        final JsonObject scene = ui(DEFINITIONS).resolve(form());
+        assertNotNull(scene);
+        final JsonObject slider = scene.getAsJsonObject("root").getAsJsonArray("children").get(1).getAsJsonObject();
+        final JsonObject over = child(slider, "over");
+        assertFalse(over.get("visible").getAsBoolean());
+        assertEquals(80, over.getAsJsonArray("size").get(0).getAsInt());
+        assertEquals(2, over.getAsJsonArray("children").size());
+        assertTrue(descendants(over).stream().allMatch(node -> !node.get("visible").getAsBoolean()));
+        assertTrue(child(over, "caption").get("visible_when_active").getAsBoolean());
+        assertFalse(child(over, "conditional").get("visible_when_active").getAsBoolean());
+        for (final String state : List.of("hover", "locked", "indent")) {
+            final JsonObject branch = child(child(slider, "thumb"), state);
+            assertFalse(branch.get("visible").getAsBoolean());
+            assertEquals(2, branch.getAsJsonArray("children").size());
+        }
+        assertTrue(child(slider, "unrelated").getAsJsonArray("children").isEmpty());
+        assertFalse(child(slider, "unrelated").has("visible_when_active"));
+        assertTrue(child(child(slider, "unrelated_toggle"), "hidden").getAsJsonArray("children").isEmpty());
+        assertTrue(scene.getAsJsonArray("missing_templates").isEmpty());
+    }
+
+    @Test
+    void serializedStateBranchesRebindWithoutChangingOriginalInputIndices() {
+        final JsonObject first = ui(DEFINITIONS).resolve(form());
+        assertNotNull(first);
+        final JsonObject program = first.getAsJsonObject("program");
+        final ServerFormUi replay = ServerFormUi.fromProgram(program);
+        assertEquals(first.get("root"), replay.resolve(form(), first.getAsJsonArray("values"), Set.of()).get("root"));
+        final JsonArray values = first.getAsJsonArray("values").deepCopy();
+        values.set(1, JsonParser.parseString("7"));
+        values.set(2, JsonParser.parseString("2"));
+        final JsonObject updated = replay.resolve(form(), values, Set.of());
+        assertNotNull(updated);
+        assertEquals(values, updated.getAsJsonArray("values"));
+        assertTrue(values.get(0).isJsonNull());
+        for (int index = 1; index <= 2; index++) {
+            final JsonObject slider = updated.getAsJsonObject("root").getAsJsonArray("children").get(index).getAsJsonObject();
+            assertEquals(index, slider.getAsJsonObject("input").get("index").getAsInt());
+            assertEquals(index, child(slider, "thumb").getAsJsonObject("input").get("index").getAsInt());
+            final JsonObject over = child(slider, "over");
+            assertFalse(over.get("visible").getAsBoolean());
+            assertTrue(child(over, "conditional").get("visible_when_active").getAsBoolean());
+            assertTrue(descendants(over).stream().allMatch(node -> !node.get("visible").getAsBoolean()));
+        }
+        assertEquals(3, first.getAsJsonArray("values").get(1).getAsInt());
+        assertEquals(1, first.getAsJsonArray("values").get(2).getAsInt());
+    }
+
+    @Test
+    void anInvisibleSliderOwnerDoesNotExpandItsStateControls() {
+        final JsonObject scene = ui(DEFINITIONS.replace("\"type\":\"slider\",\"$hover_name\"", "\"type\":\"slider\",\"visible\":false,\"$hover_name\"")).resolve(form());
+        assertNotNull(scene);
+        final JsonArray children = scene.getAsJsonObject("root").getAsJsonArray("children");
+        for (int index = 1; index <= 2; index++) {
+            assertFalse(children.get(index).getAsJsonObject().get("visible").getAsBoolean());
+            assertTrue(children.get(index).getAsJsonObject().getAsJsonArray("children").isEmpty());
+        }
+    }
+
+}
