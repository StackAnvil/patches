+    private void translations(final JsonElement value, final JsonObject translated) {
+        if (value.isJsonObject()) {
+            value.getAsJsonObject().entrySet().forEach(entry -> this.translations(entry.getValue(), translated));
+        } else if (value.isJsonArray()) {
+            value.getAsJsonArray().forEach(entry -> this.translations(entry, translated));
+        } else if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+            final String key = value.getAsString();
+            if (!key.isEmpty() && !"$#@(".contains(key.substring(0, 1))) {
+                final String text = this.translator.apply(key);
+                if (!text.equals(key)) {
+                    translated.addProperty(key, text);
+                }
+            }
+        }
+    }
+
+    private void references(final JsonElement value, final String namespace, final Set<String> result) {
+        if (value.isJsonObject()) {
+            value.getAsJsonObject().entrySet().forEach(entry -> {
+                final String[] key = entry.getKey().split("@", 2);
+                if (key.length == 2) {
+                    result.add(key[1].contains(".") ? key[1] : namespace + "." + key[1]);
+                }
+                this.references(entry.getValue(), namespace, result);
+            });
+        } else if (value.isJsonArray()) {
+            value.getAsJsonArray().forEach(entry -> this.references(entry, namespace, result));
+        } else if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+            final String name = value.getAsString().replaceFirst("^@", "");
+            if (this.definitions.containsKey(name)) {
+                result.add(name);
+            }
+        }
+    }
+
+    private void loadFiles(final Map<String, byte[]> files, final boolean server) {
+        for (final Map.Entry<String, byte[]> file : files.entrySet()) {
+            if (!safePath(file.getKey()) || file.getValue().length > MAX_FILE_BYTES || !file.getKey().endsWith(".json")) {
+                continue;
+            }
+            try {
+                final JsonElement parsed = JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8));
+                if (!parsed.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject document = parsed.getAsJsonObject();
+                if (file.getKey().equals("ui/_global_variables.json")) {
+                    document.entrySet().forEach(entry -> this.globals.put(entry.getKey(), entry.getValue()));
+                    continue;
+                }
+                final String namespace = string(document, "namespace");
+                if (namespace.isEmpty() || namespace.length() > 128) {
+                    continue;
+                }
+                for (final Map.Entry<String, JsonElement> entry : document.entrySet()) {
+                    if (!entry.getValue().isJsonObject()) {
+                        continue;
+                    }
+                    final String[] name = entry.getKey().split("@", 2);
+                    final String identity = namespace + "." + name[0];
+                    final Definition lower = this.definitions.get(identity);
+                    if (lower == null && this.definitions.size() >= MAX_NODES) {
+                        throw new IllegalArgumentException("Too many UI definitions");
+                    }
+                    final JsonObject value = lower == null ? new JsonObject() : lower.value.deepCopy();
+                    merge(value, entry.getValue().getAsJsonObject());
+                    final String parent = name.length == 2 ? (name[1].contains(".") ? name[1] : namespace + "." + name[1])
+                            : lower == null ? "" : lower.parent;
+                    this.definitions.put(identity, new Definition(value, parent));
+                }
+                if (server) {
+                    this.customizedFiles.add(file.getKey());
+                }
+            } catch (final RuntimeException malformed) {
+                // A malformed unrelated UI file cannot activate an unused control.
+            }
+        }
+    }
+
+    private JsonObject template(final String name, final Set<String> active, final Set<String> required) {
+        final Definition definition = this.definitions.get(name);
+        if (definition == null) {
+            return null;
+        }
+        if (required != null) {
+            required.add(name);
+        }
+        if (!active.add(name) || active.size() > 64) {
+            throw new IllegalArgumentException("Recursive UI inheritance");
+        }
+        try {
+            final JsonObject result;
+            if (definition.parent.isEmpty()) {
+                result = new JsonObject();
+            } else {
+                final JsonObject parent = this.template(definition.parent, active, required);
+                if (parent == null) {
+                    throw new MissingControlException(definition.parent);
+                }
+                result = parent.deepCopy();
+            }
+            merge(result, definition.value);
+            return result;
+        } finally {
+            active.remove(name);
+        }
+    }
+
+    private static void merge(final JsonObject target, final JsonObject source) {
+        for (final Map.Entry<String, JsonElement> entry : source.entrySet()) {
+            // Native controls arrays replace their inherited array. They are not concatenated.
+            target.add(entry.getKey(), entry.getValue().deepCopy());
+        }
+    }
+
+    private static void declarations(final JsonObject control, final Map<String, JsonElement> values) {
+        for (final Map.Entry<String, JsonElement> entry : control.entrySet()) {
+            if (entry.getKey().startsWith("$")) {
+                final String key = entry.getKey();
+                if (entry.getValue().isJsonPrimitive() && key.equals(entry.getValue().getAsString())) {
+                    continue; // A self-forwarding declaration retains its enclosing exact value or default.
+                }
+                // Keep defaults separate: an exact value in any enclosing scope takes precedence.
+                values.put(key, entry.getValue());
+            }
+        }
+        if (control.has("variables")) {
+            final JsonElement variableSets = control.get("variables");
+            final List<JsonElement> sets = variableSets.isJsonArray() ? variableSets.getAsJsonArray().asList() : List.of(variableSets);
+            for (final JsonElement set : sets) {
+                final JsonObject variables = set.getAsJsonObject();
+                if (!variables.has("requires") || UiExpression.truth(resolveValue(variables.get("requires"), values, 0))) {
+                    variables.entrySet().stream().filter(entry -> entry.getKey().startsWith("$"))
+                            .forEach(entry -> values.put(entry.getKey(), entry.getValue()));
+                }
+            }
+        }
+    }
+
+    static JsonElement resolveValue(final JsonElement value, final Map<String, JsonElement> values, final int depth) {
+        if (depth > 32) {
+            throw new IllegalArgumentException("Recursive UI variable");
+        }
+        if (value == null || value.isJsonNull()) {
+            return JsonNull.INSTANCE;
+        }
+        if (value.isJsonArray()) {
+            final JsonArray result = new JsonArray();
+            for (final JsonElement entry : value.getAsJsonArray()) {
+                result.add(resolveValue(entry, values, depth + 1));
+            }
+            return result;
+        }
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+            return value.deepCopy();
+        }
+        final String text = value.getAsString();
+        if (text.startsWith("$") || text.startsWith("#")) {
+            final JsonElement source = values.containsKey(text) ? values.get(text) : values.get(text + "|default");
+            if (source == null) {
+                return JsonNull.INSTANCE;
+            }
+            if (text.startsWith("#")) {
+                return source; // Binding data is literal, even when a player label starts with an operator.
+            }
+            if (source == value) {
+                throw new IllegalArgumentException("Recursive UI variable " + text);
+            }
+            return resolveValue(source, values, depth + 1);
+        }
+        if (text.startsWith("(")) {
+            return UiExpression.evaluate(text, key -> resolveValue(new JsonPrimitive(key), values, depth + 1));
+        }
+        return value;
+    }
+
+    static String bindingName(final JsonObject binding, final String key, final Map<String, JsonElement> values) {
+        String name = string(binding, key);
+        for (int depth = 0; name.startsWith("$"); depth++) {
+            if (depth >= 32) {
+                throw new IllegalArgumentException("Recursive UI binding name");
+            }
+            final JsonElement value = values.containsKey(name) ? values.get(name) : values.get(name + "|default");
+            name = UiExpression.text(value);
+        }
+        return name;
+    }
+
+    private static String substitute(final String reference, final Map<String, JsonElement> values) {
+        String result = reference;
+        int search = 0;
+        for (int count = 0; count < 32; count++) {
+            final int start = result.indexOf('$', search);
+            if (start < 0) {
+                break;
+            }
+            int end = start + 1;
+            while (end < result.length() && (Character.isLetterOrDigit(result.charAt(end)) || result.charAt(end) == '_')) {
+                end++;
+            }
+            final String replacement = UiExpression.text(resolveValue(new JsonPrimitive(result.substring(start, end)), values, 0));
+            if (replacement.isEmpty()) {
+                // Instance names are opaque identities. An unresolved instance name does not change its explicit template.
+                if (result.indexOf('@') >= end) {
+                    search = end;
+                    continue;
+                }
+                throw new IllegalArgumentException("Missing UI control variable " + result.substring(start, end));
+            }
+            result = result.substring(0, start) + replacement + result.substring(end);
+            search = start;
+        }
+        return result.startsWith("@") ? result.substring(1) : result;
+    }
+
+    public static String builtinIdentity() {
+        // Include the UI image conversion revision so cached PNG-only conversions are not reused.
+        return "2:" + Builtins.IDENTITY;
+    }
+
+    public static String textureId(final String path) {
+        if (!safePath(path)) {
+            throw new IllegalArgumentException("Invalid UI texture");
+        }
+        return "viabedrock:textures/server_ui/" + textureBasename(path) + ".png";
+    }
+
+    private static String textureBasename(final String path) {
+        return path.replaceAll("\\.(png|jpg|tga)$", "");
+    }
+
+    private static List<String> loadedPaths(final ResourcePack pack) {
+        final Set<String> result = new LinkedHashSet<>(HOST_FILES);
+        if (pack.content().contains("ui/_ui_defs.json") && pack.content().get("ui/_ui_defs.json").length <= MAX_FILE_BYTES) {
+            try {
+                final JsonArray paths = pack.content().getJson("ui/_ui_defs.json").getAsJsonArray("ui_defs");
+                if (paths != null && paths.size() <= 512) {
+                    for (final JsonElement path : paths) {
+                        if (path.isJsonPrimitive() && safePath(path.getAsString()) && path.getAsString().startsWith("ui/")) {
+                            result.add(path.getAsString());
+                        }
+                    }
+                }
+            } catch (final RuntimeException malformed) {
+                // Invalid definitions never activate files through a directory scan.
+            }
+        }
+        return List.copyOf(result);
+    }
+
+    private static Map<String, byte[]> builtinFiles() {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        try (InputStream source = JsonUiProgram.class.getResourceAsStream("/assets/viabedrock/builtin_ui.zip")) {
+
+            if (source == null) {
+                return files;
+            }
+            try (ZipInputStream zip = new ZipInputStream(source)) {
+                int total = 0;
+                for (var entry = zip.getNextEntry(); entry != null; entry = zip.getNextEntry()) {
+                    if (entry.isDirectory() || !safePath(entry.getName()) || files.size() >= 4096) {
+                        continue;
+                    }
+                    final byte[] bytes = zip.readNBytes(16 * MAX_FILE_BYTES + 1);
+                    total += bytes.length;
+                    if (bytes.length > 16 * MAX_FILE_BYTES || total > 64 * MAX_FILE_BYTES) {
+                        throw new IOException("Bundled UI exceeds limits");
+                    }
+                    files.put(entry.getName(), bytes);
+                }
+            }
+        } catch (final IOException malformed) {
+            files.clear();
+        }
+        return files;
+    }
+
+    static boolean safePath(final String path) {
+        return path.matches("[A-Za-z0-9_./-]{1,256}") && !path.contains("..") && !path.startsWith("/");
+    }
+
+    static String string(final JsonObject object, final String key) {
+        final JsonElement value = object.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
