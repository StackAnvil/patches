+                        || collectionIndex.getAsDouble() != collectionIndex.getAsInt()) {
+                    throw new IllegalArgumentException("Invalid UI collection index");
+                }
+                final int index = collectionIndex.getAsInt();
+                selectedButton = index >= 0 && index < this.form.getAsJsonArray("buttons").size() ? index : -1;
+            } else {
+                selectedButton = button;
+            }
+            final Map<String, JsonElement> engine = this.engine(selectedButton);
+            for (final String property : List.of("#form_button_text", "#form_button_index", "#form_button_texture", "#form_button_texture_file_system")) {
+                values.put(property, engine.get(property));
+            }
+            values.put("#visible", control.has("visible") ? resolveValue(control.get("visible"), values, 0) : new JsonPrimitive(true));
+            values.put("#enabled", control.has("enabled") ? resolveValue(control.get("enabled"), values, 0) : new JsonPrimitive(true));
+            this.bind(control, values, selectedButton);
+            this.controls.put(name, new HashMap<>(values));
+            if (UiExpression.truth(resolveValue(control.get("ignored"), values, 0))) {
+                return null;
+            }
+            final boolean visible = parentVisible && UiExpression.truth(values.get("#visible"));
+            values.put("$__effective_visible", new JsonPrimitive(visible));
+            final JsonObject node = new JsonObject();
+            node.addProperty("name", name);
+            for (final Map.Entry<String, JsonElement> entry : control.entrySet()) {
+                if (entry.getKey().startsWith("$") || Set.of("bindings", "variables", "controls", "factory", "property_bag", "modifications").contains(entry.getKey())) {
+                    continue;
+                }
+                node.add(entry.getKey(), resolveValue(entry.getValue(), values, 0));
+            }
+            for (final String property : List.of("text", "texture", "visible", "enabled", "collection_length", "maximum_grid_items")) {
+                if (values.containsKey("#" + property)) {
