From 7ace6848fe9ffbf515567ad69643190e530cba21 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:45:04 +0200
Subject: [PATCH] fix(entities): clear stale custom render models

When a render controller no longer selects any geometry, clear the previous model set and signal a render refresh. Otherwise entities can keep rendering a model that their current metadata no longer selects.
---
 .../api/model/entity/CustomEntity.java        | 16 ++++++----
 .../CustomEntityModelSelectionTest.java       | 32 +++++++++++++++++++
 2 files changed, 41 insertions(+), 7 deletions(-)
 create mode 100644 src/test/java/net/raphimc/viabedrock/api/model/entity/CustomEntityModelSelectionTest.java

diff --git a/src/main/java/net/raphimc/viabedrock/api/model/entity/CustomEntity.java b/src/main/java/net/raphimc/viabedrock/api/model/entity/CustomEntity.java
index 275bcbf1b..6aea129ad 100644
--- a/src/main/java/net/raphimc/viabedrock/api/model/entity/CustomEntity.java
+++ b/src/main/java/net/raphimc/viabedrock/api/model/entity/CustomEntity.java
@@ -276,18 +276,20 @@ public class CustomEntity extends Entity {
                 }
             } catch (final Throwable e) {
                 ViaBedrock.getPlatform().getLogger().log(Level.WARNING, "Failed to evaluate render controller", e);
-                this.models.clear();
-                return true;
+                return replaceModels(this.models, List.of());
             }
         }
 
-        if (!newModels.isEmpty() && !this.models.equals(newModels)) {
-            this.models.clear();
-            this.models.addAll(newModels);
-            return true;
-        } else {
+        return replaceModels(this.models, newModels);
+    }
+
+    static boolean replaceModels(final List<EvaluatedModel> current, final List<EvaluatedModel> next) {
+        if (current.equals(next)) {
             return false;
         }
+        current.clear();
+        current.addAll(next);
+        return true;
     }
 
     private MutableObjectBinding getArrayBinding(final Scope executionScope, final List<BedrockRenderController.Array> arrays) throws IOException {
diff --git a/src/test/java/net/raphimc/viabedrock/api/model/entity/CustomEntityModelSelectionTest.java b/src/test/java/net/raphimc/viabedrock/api/model/entity/CustomEntityModelSelectionTest.java
new file mode 100644
index 000000000..2ae7687e2
--- /dev/null
+++ b/src/test/java/net/raphimc/viabedrock/api/model/entity/CustomEntityModelSelectionTest.java
@@ -0,0 +1,32 @@
+/*
+ * This file is part of ViaBedrock - https://github.com/RaphiMC/ViaBedrock
+ * Copyright (C) 2023-2026 RK_01/RaphiMC and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package net.raphimc.viabedrock.api.model.entity;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class CustomEntityModelSelectionTest {
+
+    @Test
+    void removesPreviouslySelectedModelWhenNoControllerMatches() {
+        final CustomEntity.EvaluatedModel model = new CustomEntity.EvaluatedModel("default", "body", "skin");
+        final List<CustomEntity.EvaluatedModel> current = new ArrayList<>(List.of(model));
+
+        assertTrue(CustomEntity.replaceModels(current, List.of()));
+        assertTrue(current.isEmpty());
+        assertFalse(CustomEntity.replaceModels(current, List.of()));
+
+        assertTrue(CustomEntity.replaceModels(current, List.of(model)));
+        assertEquals(List.of(model), current);
+        assertFalse(CustomEntity.replaceModels(current, List.of(model)));
+    }
+
+}
