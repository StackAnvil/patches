+    @Test
+    void flightInputUpdatesBaseAndKeepsQuickStopBeforeServerAcknowledgment() throws Exception {
+        final var user = mock(UserConnection.class);
+        final var tracker = mock(EntityTracker.class);
+        when(user.get(EntityTracker.class)).thenReturn(tracker);
+        final var abilities = new PlayerAbilities(7, (byte) 1, (byte) 0);
+        final var base = abilities.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.Base);
+        base.setAbility(AbilitiesIndex.MayFly, true);
+        final var player = new ClientPlayerEntity(user, 8, UUID.randomUUID(), abilities);
+        when(tracker.getClientPlayer()).thenReturn(player);
+        final var protocol = mock(BedrockProtocol.class);
+        ClientPlayerPackets.register(protocol);
+        final var handler = ArgumentCaptor.forClass(PacketHandler.class);
+        verify(protocol).registerServerbound(eq(ServerboundPackets26_3.PLAYER_ABILITIES), isNull(), handler.capture());
+        final var start = new PacketWrapperImpl(ServerboundPackets26_3.PLAYER_ABILITIES, null, user);
+        start.write(Types.BYTE, (byte) 2);
+        start.resetReader();
+        handler.getValue().handle(start);
+        final boolean startedFlying = abilities.getBooleanValue(AbilitiesIndex.Flying);
+        final boolean baseStartedFlying = base.abilityValues().contains(AbilitiesIndex.Flying);
+        final boolean startRequested = player.authInputData().contains(PlayerAuthInputData.StartFlying);
+        player.authInputData().clear();
+        final var stop = new PacketWrapperImpl(ServerboundPackets26_3.PLAYER_ABILITIES, null, user);
+        stop.write(Types.BYTE, (byte) 0);
+        stop.resetReader();
+        handler.getValue().handle(stop);
+        assertTrue(player.authInputData().contains(PlayerAuthInputData.StopFlying));
+        assertTrue(startedFlying);
+        assertTrue(baseStartedFlying);
+        assertTrue(startRequested);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertFalse(base.abilityValues().contains(AbilitiesIndex.Flying));
+    }
