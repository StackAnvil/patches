+    @Test
+    void highestDeclaringLayerOwnsEachBooleanIncludingExplicitFalse() {
+        final var abilities = decode(List.of(
+                new Layer(0, bit(AbilitiesIndex.Instabuild), bit(AbilitiesIndex.Instabuild), 0, 0, 0),
+                new Layer(1, bit(AbilitiesIndex.Instabuild) | bit(AbilitiesIndex.MayFly), bit(AbilitiesIndex.Instabuild) | bit(AbilitiesIndex.MayFly), 0, 0, 0),
+                new Layer(5, bit(AbilitiesIndex.MayFly), 0, 0, 0, 0),
+                new Layer(3, bit(AbilitiesIndex.Instabuild), 0, 0, 0, 0)));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.MayFly));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        abilities.abilityLayers().remove(SerializedAbilitiesData_SerializedAbilitiesLayer.Commands);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        abilities.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.Base).setAbility(AbilitiesIndex.Instabuild, false);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        abilities.abilityLayers().remove(SerializedAbilitiesData_SerializedAbilitiesLayer.Base);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+    }
+
+    @Test
+    void eachFloatUsesItsOwnHighestOwnerWithoutFallingThroughZero() {
+        final int allSpeeds = bit(AbilitiesIndex.FlySpeed) | bit(AbilitiesIndex.WalkSpeed) | bit(AbilitiesIndex.VerticalFlySpeed);
+        final var abilities = decode(List.of(
+                new Layer(4, bit(AbilitiesIndex.FlySpeed) | bit(AbilitiesIndex.WalkSpeed), 0, 0, 0, 0x7FC00001),
+                new Layer(1, allSpeeds, 0, 0x3DCCCCCD, 0x3F800000, 0x3D4CCCCD),
+                new Layer(5, bit(AbilitiesIndex.VerticalFlySpeed), 0, 0, 0x80000000, 0)));
+        assertEquals(0, Float.floatToRawIntBits(abilities.getFloatValue(AbilitiesIndex.FlySpeed)));
+        assertEquals(0x7FC00001, Float.floatToRawIntBits(abilities.getFloatValue(AbilitiesIndex.WalkSpeed)));
+        assertEquals(0x80000000, Float.floatToRawIntBits(abilities.getFloatValue(AbilitiesIndex.VerticalFlySpeed)));
+        abilities.abilityLayers().remove(SerializedAbilitiesData_SerializedAbilitiesLayer.Editor);
+        assertEquals(0x3DCCCCCD, Float.floatToRawIntBits(abilities.getFloatValue(AbilitiesIndex.FlySpeed)));
+    }
