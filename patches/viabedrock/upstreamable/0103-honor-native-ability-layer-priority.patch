+    private static PlayerAbilities decode(final List<Layer> layers) {
+        final var buffer = Unpooled.buffer();
+        try {
+            buffer.writeLongLE(7);
+            buffer.writeByte(1);
+            buffer.writeByte(0);
+            BedrockTypes.UNSIGNED_VAR_INT.writePrimitive(buffer, layers.size());
+            for (final var layer : layers) {
+                buffer.writeShortLE(layer.index);
+                buffer.writeIntLE(layer.set);
+                buffer.writeIntLE(layer.values);
+                buffer.writeIntLE(layer.fly);
+                buffer.writeIntLE(layer.vertical);
+                buffer.writeIntLE(layer.walk);
+            }
+            final var decoded = new PlayerAbilitiesType().read(buffer);
+            assertFalse(buffer.isReadable());
+            return decoded;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private record Layer(int index, int set, int values, int fly, int vertical, int walk) { }
