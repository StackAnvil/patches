+                assertEquals(expected.get("walkType").getAsInt() != 1, actual != null && actual.abilitiesSet().contains(AbilitiesIndex.WalkSpeed), row::toString);
+                if (expected.get("type").getAsInt() != 1) {
+                    assertEquals(expected.get("value").getAsInt() != 0, actual.abilityValues().contains(AbilitiesIndex.Instabuild), row::toString);
+                }
+                if (expected.get("walkType").getAsInt() != 1) {
+                    assertEquals((int) expected.get("walk").getAsLong(), Float.floatToRawIntBits(actual.walkSpeed()), row::toString);
