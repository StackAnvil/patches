+    @Test
+    void decodedLayersMatchOriginalPredicatesAndPacketApplications() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_ABILITY_LAYERS");
+        assumeTrue(fixture != null);
+        final Path directory = Path.of(fixture);
+        final var booleans = JsonParser.parseString(Files.readString(directory.resolve("native-instabuild.json"))).getAsJsonObject();
+        for (final var value : booleans.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            final var states = row.getAsJsonArray("layers");
+            final var layers = new ArrayList<Layer>();
+            for (int index = 0; index < states.size(); index++) {
+                final int state = states.get(index).getAsInt();
+                if (state >= 0) {
+                    layers.add(new Layer(index, bit(AbilitiesIndex.Instabuild), state << AbilitiesIndex.Instabuild.getValue(), 0, 0, 0));
+                }
+            }
+            assertEquals(row.get("result").getAsBoolean(), decode(layers).getBooleanValue(AbilitiesIndex.Instabuild), row::toString);
+        }
+        final var floats = JsonParser.parseString(Files.readString(directory.resolve("native-walk-speed.json"))).getAsJsonObject();
+        for (final var value : floats.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            final var states = row.getAsJsonArray("layers");
+            final var layers = new ArrayList<Layer>();
+            for (int index = 0; index < states.size(); index++) {
+                if (!states.get(index).isJsonNull()) {
+                    layers.add(new Layer(index, bit(AbilitiesIndex.WalkSpeed), 0, 0, 0, (int) states.get(index).getAsLong()));
+                }
+            }
+            assertEquals((int) row.get("result").getAsLong(), Float.floatToRawIntBits(decode(layers).getFloatValue(AbilitiesIndex.WalkSpeed)), row::toString);
+        }
+        final var packets = JsonParser.parseString(Files.readString(directory.resolve("native-layer-packets.json"))).getAsJsonObject();
+        for (final var value : packets.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            final var layers = new ArrayList<Layer>();
+            for (final var input : row.getAsJsonArray("entries")) {
+                final var entry = input.getAsJsonObject();
+                layers.add(new Layer(entry.get("layer").getAsInt(), entry.get("set").getAsInt(),
+                        entry.has("values") ? entry.get("values").getAsInt() : 0,
+                        entry.has("fly") ? (int) entry.get("fly").getAsLong() : 0,
+                        entry.has("vertical") ? (int) entry.get("vertical").getAsLong() : 0,
+                        entry.has("walk") ? (int) entry.get("walk").getAsLong() : 0));
+            }
+            final var decoded = decode(layers);
+            assertEquals(row.get("result").getAsBoolean(), decoded.getBooleanValue(AbilitiesIndex.Instabuild), row::toString);
+            for (int index = 0; index < 6; index++) {
+                final var expected = row.getAsJsonArray("layers").get(index).getAsJsonObject();
+                final var actual = decoded.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.getByValue(index));
+                assertEquals(expected.get("type").getAsInt() != 1, actual != null && actual.abilitiesSet().contains(AbilitiesIndex.Instabuild), row::toString);
+                assertEquals(expected.get("walkType").getAsInt() != 1, actual != null && actual.abilitiesSet().contains(AbilitiesIndex.WalkSpeed), row::toString);
+                if (expected.get("type").getAsInt() != 1) {
+                    assertEquals(expected.get("value").getAsInt() != 0, actual.abilityValues().contains(AbilitiesIndex.Instabuild), row::toString);
+                }
+                if (expected.get("walkType").getAsInt() != 1) {
+                    assertEquals((int) expected.get("walk").getAsLong(), Float.floatToRawIntBits(actual.walkSpeed()), row::toString);
+                }
+            }
+        }
+    }
