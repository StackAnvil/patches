+final class GameTypeAbilitiesTest {
+
+    @Test
+    void modeChangesUseBaseAndSpectatorWithoutOverwritingPolicyLayers() {
+        final var abilities = new PlayerAbilities(1, (byte) 0, (byte) 0);
+        final var commands = abilities.getOrCreateLayer(SerializedAbilitiesData_SerializedAbilitiesLayer.Commands);
+        commands.setAbility(AbilitiesIndex.Build, true);
+        commands.setAbility(AbilitiesIndex.MayFly, false);
+        final var cache = abilities.getOrCreateLayer(SerializedAbilitiesData_SerializedAbilitiesLayer.CustomCache);
+        cache.setAbility(AbilitiesIndex.Flying, true);
+
+        abilities.applyGameType(GameType.Spectator, GameType.Survival);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Build));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.OpenContainers));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.MayFly));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.NoClip));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Invulnerable));
+
+        abilities.applyGameType(GameType.Creative, GameType.Survival);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.MayFly));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.OpenContainers));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.NoClip));
+        assertSame(commands, abilities.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.Commands));
+        assertSame(cache, abilities.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.CustomCache));
+
+        abilities.applyGameType(GameType.Adventure, GameType.Survival);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Invulnerable));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+    }
+
+    @Test
+    void creativePreservesBaseFlightAndUndefinedDoesNotInheritTheWorldMode() {
+        final var abilities = new PlayerAbilities(1, (byte) 0, (byte) 0);
+        final var base = abilities.getOrCreateLayer(SerializedAbilitiesData_SerializedAbilitiesLayer.Base);
+        base.setAbility(AbilitiesIndex.Flying, true);
+        abilities.applyGameType(GameType.Creative, GameType.Survival);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        abilities.applyGameType(GameType.Spectator, GameType.Survival);
+        abilities.applyGameType(GameType.Undefined, GameType.Survival);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.NoClip));
+        abilities.applyGameType(GameType.Default, GameType.Survival);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        abilities.applyGameType(GameType.Default, GameType.Creative);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        abilities.applyGameType(GameType.Default, GameType.Default);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        abilities.applyGameType(GameType.WorldDefault, GameType.Creative);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+    }
+
+    @Test
+    void actualLocalModeProducerUpdatesTheNativeLayers() {
+        final var user = mock(UserConnection.class);
+        final var session = mock(GameSessionStorage.class);
+        final var info = mock(ProtocolInfo.class);
+        when(user.get(GameSessionStorage.class)).thenReturn(session);
+        when(user.getProtocolInfo()).thenReturn(info);
+        when(info.getServerState()).thenReturn(State.CONFIGURATION);
+        when(session.getLevelGameType()).thenReturn(GameType.Survival);
+        final var abilities = new PlayerAbilities(1, (byte) 0, (byte) 0);
+        final var player = new ClientPlayerEntity(user, 2, UUID.randomUUID(), abilities);
+        player.setGameType(GameType.Spectator);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.OpenContainers));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.NoClip));
+        player.setGameType(GameType.Creative);
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Instabuild));
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.Flying));
+        assertFalse(abilities.abilityLayers().containsKey(SerializedAbilitiesData_SerializedAbilitiesLayer.CustomCache));
+        when(session.getLevelGameType()).thenReturn(GameType.Spectator);
+        player.setGameType(GameType.Default);
+        assertFalse(abilities.getBooleanValue(AbilitiesIndex.MayFly));
+        assertTrue(abilities.getBooleanValue(AbilitiesIndex.Flying));
+    }
+
+    @Test
+    void transitionsMatchThePinnedNativeLayerWrites() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_GAME_MODE_ABILITIES");
+        assumeTrue(fixture != null);
+        final var reference = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject();
+        for (final var element : reference.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var abilities = fromLayers(row.getAsJsonArray("initial"));
+            for (final var step : row.getAsJsonArray("steps")) {
+                final var value = step.getAsJsonObject();
+                abilities.applyGameType(GameType.getByValue(value.get("mode").getAsInt()),
+                        GameType.getByValue(value.get("world").getAsInt()));
+                assertLayers(value.getAsJsonArray("layers"), abilities, row);
+            }
+        }
+    }
+
+    private static PlayerAbilities fromLayers(final JsonArray initial) {
+        final var layers = new EnumMap<SerializedAbilitiesData_SerializedAbilitiesLayer, PlayerAbilities.AbilitiesLayer>(SerializedAbilitiesData_SerializedAbilitiesLayer.class);
+        for (final var element : initial) {
+            final var layer = element.getAsJsonObject();
+            final var speeds = layer.getAsJsonArray("speeds");
+            layers.put(SerializedAbilitiesData_SerializedAbilitiesLayer.getByValue(layer.get("id").getAsInt()),
+                    new PlayerAbilities.AbilitiesLayer(EnumUtil.getEnumSetFromBitmask(AbilitiesIndex.class, layer.get("supported").getAsInt(), AbilitiesIndex::getValue),
+                            EnumUtil.getEnumSetFromBitmask(AbilitiesIndex.class, layer.get("on").getAsInt(), AbilitiesIndex::getValue),
+                            Float.intBitsToFloat(speeds.get(0).getAsInt()), Float.intBitsToFloat(speeds.get(1).getAsInt()), Float.intBitsToFloat(speeds.get(2).getAsInt())));
+        }
+        return new PlayerAbilities(1, (byte) 0, (byte) 0, layers);
+    }
+
+    private static void assertLayers(final JsonArray expected, final PlayerAbilities abilities, final JsonObject context) {
+        for (final var element : expected) {
+            final var value = element.getAsJsonObject();
+            final var layer = abilities.abilityLayers().get(SerializedAbilitiesData_SerializedAbilitiesLayer.getByValue(value.get("id").getAsInt()));
+            final int supported = layer == null ? 0 : EnumUtil.getIntBitmaskFromEnumSet(layer.abilitiesSet(), AbilitiesIndex::getValue);
+            final int on = layer == null ? 0 : EnumUtil.getIntBitmaskFromEnumSet(layer.abilityValues(), AbilitiesIndex::getValue) & supported;
+            assertEquals(value.get("supported").getAsInt(), supported, context::toString);
+            assertEquals(value.get("on").getAsInt(), on, context::toString);
+            final var speeds = value.getAsJsonArray("speeds");
+            final var fields = new AbilitiesIndex[]{AbilitiesIndex.WalkSpeed, AbilitiesIndex.FlySpeed, AbilitiesIndex.VerticalFlySpeed};
+            final float[] actual = layer == null ? new float[3] : new float[]{layer.walkSpeed(), layer.flySpeed(), layer.verticalFlySpeed()};
+            for (int i = 0; i < fields.length; i++) {
+                assertEquals(speeds.get(i).getAsInt(), (supported & 1 << fields[i].getValue()) == 0 ? 0 : Float.floatToRawIntBits(actual[i]), context::toString);
+            }
+        }
+    }
+
+}
