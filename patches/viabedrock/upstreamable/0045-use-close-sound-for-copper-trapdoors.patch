From cd2d2f1e35b6df97596a7cb75b456073db6fbb42 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:20:13 +0200
Subject: [PATCH] fix(sound): use the close sound for copper trapdoors

Bedrock 2193 names both copper trapdoor events open_trapdoor.copper. Keep the event-specific Java close sound when translating trapdoor.close so other players hear the correct action. The source sound asset mapping remains faithful to Bedrock.
---
 .../viabedrock/protocol/packet/WorldEffectPackets.java     | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
index 458d290b..dd576c97 100644
--- a/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
+++ b/src/main/java/net/raphimc/viabedrock/protocol/packet/WorldEffectPackets.java
@@ -247,7 +247,12 @@ public final class WorldEffectPackets {
                 return;
             }
 
-            wrapper.write(Types.SOUND_EVENT, Holder.of(javaSound.id())); // sound id
+            // Bedrock names both copper trapdoor actions "open_trapdoor.copper".
+            // Use the Java close sound for its separate close event.
+            final int javaSoundId = "trapdoor.close".equals(soundEvent) && "open_trapdoor.copper".equals(configuredSound.sound())
+                    ? BedrockProtocol.MAPPINGS.getJavaSounds().get("minecraft:block.copper_trapdoor.close")
+                    : javaSound.id();
+            wrapper.write(Types.SOUND_EVENT, Holder.of(javaSoundId)); // sound id
             wrapper.write(Types.VAR_INT, javaSound.category().ordinal()); // category
             wrapper.write(Types.INT, (int) (position.x() * 8F)); // x
             wrapper.write(Types.INT, (int) (position.y() * 8F)); // y
-- 
