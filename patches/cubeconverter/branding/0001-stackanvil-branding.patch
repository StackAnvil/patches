From 8192784385a3d8a9ca9352b0720f8f12bda21049 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:51:34 +0200
Subject: [PATCH] chore(branding): identify StackAnvil builds

Mark distributed artifacts with a StackAnvil version suffix and manifest vendor so testers can distinguish them from upstream builds.
---
 build.gradle | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/build.gradle b/build.gradle
index 53205b0..9845f80 100644
--- a/build.gradle
+++ b/build.gradle
@@ -18,9 +18,13 @@ dependencies {
 }
 
 group = 'org.oryxel.cube'
-version = '1.3'
+version = '1.3-StackAnvil'
 description = 'cubeconverter'
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes 'Implementation-Vendor': 'StackAnvil'
+}
+
 tasks.withType(JavaCompile).configureEach {
     options.encoding = 'UTF-8'
 }
@@ -46,4 +50,4 @@ publishing {
             }
         }
     }
-}
\ No newline at end of file
+}
-- 
2.55.0
