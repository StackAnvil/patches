+package org.cube.converter.converter;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.cube.converter.converter.enums.RotationType;
+import org.cube.converter.model.impl.java.JavaItemModel;
+import org.cube.converter.parser.bedrock.geometry.BedrockGeometryParser;
+import org.cube.converter.util.GsonUtil;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FormatConverterTest {
+
+    @Test
+    void exportsGeometryWithoutBonesAtUnitScaleForEveryRotationMode() {
+        final var geometry = BedrockGeometryParser.parse(geometryJson("[]")).get(0);
+        for (final RotationType rotation : RotationType.values()) {
+            final var model = geometry.toJavaItemModel("example:item/actor", rotation);
+            final JsonObject json = finiteExport(model);
+            assertEquals(1, model.getScale());
+            assertTrue(json.getAsJsonArray("elements").isEmpty());
+            assertTrue(json.getAsJsonArray("groups").isEmpty());
+        }
+        assertTrue(geometry.getParents().isEmpty());
+    }
+
+    @Test
+    void preservesLocatorOnlyBonesAndSourceGeometryAtUnitScale() {
+        final JsonObject source = geometryJson("""
+            [{"name":"root","pivot":[2,3,4],"rotation":[5,10,15],
+              "locators":{"attachment":[1,2,3]}},
+             {"name":"attachment","parent":"root","pivot":[-2,8,1],"rotation":[0,20,0],
+              "cubes":[],"locators":{"trail":{"offset":[0,1,0],"rotation":[0,45,0]}}}]
+            """);
+        final JsonObject original = source.deepCopy();
+        final var geometry = BedrockGeometryParser.parse(source).get(0);
+        final var model = geometry.toJavaItemModel("example:item/actor", RotationType.POST_1_21_11);
+        final JsonObject json = finiteExport(model);
+        assertEquals(1, model.getScale());
+        assertTrue(json.getAsJsonArray("elements").isEmpty());
+        assertEquals(2, json.getAsJsonArray("groups").size());
+        assertEquals(2, model.getParents().size());
+        for (int index = 0; index < geometry.getParents().size(); index++) {
+            final var before = geometry.getParents().get(index);
+            final var after = model.getParents().get(index);
+            assertNotSame(before, after);
+            assertEquals(before.getName(), after.getName());
+            assertEquals(before.getParent(), after.getParent());
+            assertArrayEquals(before.getPivot().toArray(), after.getPivot().toArray());
+            assertArrayEquals(before.getRotation().toArray(), after.getRotation().toArray());
+            assertTrue(before.getCubes().isEmpty());
+            assertTrue(after.getCubes().isEmpty());
+            assertTrue(json.getAsJsonArray("groups").get(index).getAsJsonObject().getAsJsonArray("children").isEmpty());
+        }
+        assertArrayEquals(new float[]{2, 3, 4}, geometry.getParents().get(0).getPivot().toArray());
+        assertArrayEquals(new float[]{5, 10, 15}, geometry.getParents().get(0).getRotation().toArray());
+        assertEquals("root", geometry.getParents().get(1).getParent());
+        assertEquals(original, source);
+        assertEquals(json, model.compile());
+    }
+
+    @Test
+    void preservesPopulatedGeometryFittingAndSourceCoordinates() {
+        final var geometry = BedrockGeometryParser.parse(geometryJson("""
+            [{"name":"root","pivot":[0,0,0],"cubes":[
+                {"origin":[-64,0,0],"size":[64,64,64],"uv":[0,0]}]}]
+            """)).get(0);
+        final var source = geometry.getParents().get(0).getCubes().get(0);
+        final var model = geometry.toJavaItemModel("example:item/actor", RotationType.POST_1_21_11);
+        final JsonObject json = finiteExport(model);
+        assertEquals(4, model.getScale());
+        assertEquals(1, json.getAsJsonArray("elements").size());
+        final var converted = model.getParents().get(0).getCubes().get(0);
+        assertNotSame(source, converted);
+        assertArrayEquals(new float[]{16, 16, 16}, converted.getSize().toArray());
+        assertArrayEquals(new float[]{-16, 0, 0}, converted.getPosition().toArray());
+        assertArrayEquals(new float[]{64, 64, 64}, source.getSize().toArray());
+        assertArrayEquals(new float[]{-64, 0, 0}, source.getPosition().toArray());
+        assertEquals(6, json.getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces").size());
+    }
+
+    private static JsonObject finiteExport(final JavaItemModel model) {
+        assertTrue(Float.isFinite(model.getScale()));
+        assertTrue(model.getScale() > 0);
+        final JsonObject export = new JsonObject();
+        export.addProperty("scale", model.getScale());
+        export.add("model", model.compile());
+        final var gson = GsonUtil.getGson();
+        final JsonObject decoded = gson.fromJson(gson.toJson(export), JsonObject.class);
+        assertEquals(export, decoded);
+        assertEquals(model.getScale(), decoded.get("scale").getAsFloat());
+        return decoded.getAsJsonObject("model");
+    }
+
+    private static JsonObject geometryJson(final String bones) {
+        return GsonUtil.getGson().fromJson("""
+            {"format_version":"1.12.0","minecraft:geometry":[{
+                "description":{"identifier":"geometry.example","texture_width":64,"texture_height":64},
+                "bones":%s
+            }]}
+            """.formatted(bones), JsonObject.class);
+    }
+}
diff --git a/src/test/java/org/cube/converter/model/impl/java/JavaItemModelTest.java b/src/test/java/org/cube/converter/model/impl/java/JavaItemModelTest.java
new file mode 100644
index 0000000..3d41051
--- /dev/null
+++ b/src/test/java/org/cube/converter/model/impl/java/JavaItemModelTest.java
@@ -0,0 +1,112 @@
+package org.cube.converter.model.impl.java;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.cube.converter.converter.enums.RotationType;
+import org.cube.converter.parser.bedrock.geometry.BedrockGeometryParser;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class JavaItemModelTest {
+
+    @Test
+    void omitsUntexturedJavaElementsAndPreservesSourceCubes() {
+        final var geometry = geometry("""
+            {"origin":[0,0,0],"size":[2,2,2],"uv":{}},
+            {"origin":[2,0,0],"size":[2,2,2],"uv":{"north":{"uv":[0,0],"uv_size":[2,2]}}}
+            """);
+        final var javaModel = geometry.toJavaItemModel("example:item/actor", RotationType.POST_1_21_11);
+        final JsonObject model = javaModel.compile();
+        final var elements = model.getAsJsonArray("elements");
+        assertEquals(1, elements.size());
+        int renderedFaces = 0;
+        for (var element : elements) {
+            final JsonObject faces = element.getAsJsonObject().getAsJsonObject("faces");
+            assertFalse(faces.isEmpty());
+            for (var face : faces.entrySet()) {
+                renderedFaces++;
+                final String texture = face.getValue().getAsJsonObject().get("texture").getAsString();
+                assertTrue(texture.startsWith("#"));
+                assertTrue(model.getAsJsonObject("textures").has(texture.substring(1)));
+            }
+        }
+        assertEquals(1, renderedFaces);
+        assertEquals(0, model.getAsJsonArray("groups").get(0).getAsJsonObject().getAsJsonArray("children").get(0).getAsInt());
+        assertEquals(2, geometry.getParents().get(0).getCubes().size());
+        assertEquals(2, javaModel.getParents().get(0).getCubes().size());
+        assertTrue(geometry.getParents().get(0).getCubes().get(0).getUvMap().getUvMap().isEmpty());
+        assertEquals(model, javaModel.compile());
+    }
+
+    @Test
+    void retainsModelsThatOmitCubeUvData() {
+        final var geometry = geometry("""
+            {"origin":[-3,2,-3],"size":[6,8,6]},
+            {"origin":[0,0,0],"size":[2,2,2],"uv":[0,0]}
+            """);
+        assertEquals(2, geometry.getParents().get(0).getCubes().size());
+        assertTrue(geometry.getParents().get(0).getCubes().get(0).getUvMap().getUvMap().isEmpty());
+        assertEquals(1, geometry.toJavaItemModel("example:item/actor", RotationType.POST_1_21_11)
+                .compile().getAsJsonArray("elements").size());
+    }
+
+    @Test
+    void usesFaceDimensionsForOmittedUvSizesAndPreservesAuthoredSizes() {
+        final var geometry = geometry("""
+            {"origin":[0,0,0],"size":[2,3,5],"uv":{
+                "north":{"uv":[7,11]},"south":{"uv":[7,11]},
+                "east":{"uv":[7,11]},"west":{"uv":[7,11]},
+                "up":{"uv":[7,11]},"down":{"uv":[7,11]}}},
+            {"origin":[0,0,0],"size":[2,3,5],"uv":{"north":{"uv":[7,11],"uv_size":[-4,6]}}}
+            """);
+        final var cubes = geometry.getParents().get(0).getCubes();
+        final var faces = cubes.get(0).getUvMap().getUvMap();
+        for (final var face : org.cube.converter.util.element.Direction.values()) {
+            final float width = face == org.cube.converter.util.element.Direction.EAST || face == org.cube.converter.util.element.Direction.WEST ? 5 : 2;
+            final float height = face == org.cube.converter.util.element.Direction.UP || face == org.cube.converter.util.element.Direction.DOWN ? 5 : 3;
+            assertArrayEquals(new Float[] {7F, 11F, 7 + width, 11 + height}, faces.get(face));
+        }
+        assertArrayEquals(new Float[] {7F, 11F, 3F, 17F}, cubes.get(1).getUvMap().getUvMap()
+                .get(org.cube.converter.util.element.Direction.NORTH));
+    }
+
+    @Test
+    void exportsWhollyInvisibleGeometryWithNoJavaElements() {
+        final var geometry = geometry("""
+            {"origin":[0,0,0],"size":[2,2,2],"uv":{}}
+            """);
+        final JsonObject model = geometry.toJavaItemModel("example:item/actor", RotationType.POST_1_21_11).compile();
+        assertTrue(model.getAsJsonArray("elements").isEmpty());
+        assertTrue(model.getAsJsonArray("groups").get(0).getAsJsonObject().getAsJsonArray("children").isEmpty());
+        assertEquals(1, geometry.getParents().get(0).getCubes().size());
+    }
+
+    @Test
+    void preservesVisibleBoxFacesAndTheirTextureBindings() {
+        final JsonObject model = convert("""
+            {"origin":[0,0,0],"size":[2,2,2],"uv":[0,0]}
+            """);
+        final JsonObject faces = model.getAsJsonArray("elements").get(0).getAsJsonObject().getAsJsonObject("faces");
+        assertEquals(6, faces.size());
+        for (var face : faces.entrySet()) {
+            final String key = face.getValue().getAsJsonObject().get("texture").getAsString().substring(1);
+            assertEquals("example:item/actor", model.getAsJsonObject("textures").get(key).getAsString());
+        }
+    }
+
+    private static JsonObject convert(final String cubes) {
+        return geometry(cubes).toJavaItemModel("example:item/actor", RotationType.POST_1_21_11).compile();
+    }
+
+    private static BedrockGeometryModel geometry(final String cubes) {
+        final String json = """
+            {"format_version":"1.12.0","minecraft:geometry":[{
+                "description":{"identifier":"geometry.example","texture_width":32,"texture_height":32},
+                "bones":[{"name":"root","pivot":[0,0,0],"cubes":[%s]}]
+            }]}
+            """.formatted(cubes);
+        return BedrockGeometryParser.parse(json).get(0);
+    }
+
+}
