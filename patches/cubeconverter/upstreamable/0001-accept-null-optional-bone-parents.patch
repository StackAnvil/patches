From 3ec14547012232f160389b0c75bbdda793ba8af3 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Tue, 10 Nov 2026 13:55:51 +0100
Subject: [PATCH] fix(geometry): accept null optional bone parents

Player geometries received from Lifeboat on protocol 2225 can encode an unparented root as parent:null. Treat that optional value like an absent parent instead of discarding the whole geometry with JsonNull.getAsString(). Preserve named child relationships and all other geometry data. A small parser fixture verifies both root encodings without retaining player assets.
---
 .../geometry/BedrockGeometryParser.java       |  2 +-
 .../geometry/BedrockGeometryParentTest.java   | 23 +++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)
 create mode 100644 src/test/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParentTest.java

diff --git a/src/main/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParser.java b/src/main/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParser.java
index 46ca26f..5b020c5 100644
--- a/src/main/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParser.java
+++ b/src/main/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParser.java
@@ -89,7 +89,7 @@ public class BedrockGeometryParser {
 
             Parent bone = new Parent(name, parentPivot, boneRotation);
 
-            if (boneObject.has("parent")) {
+            if (boneObject.has("parent") && !boneObject.get("parent").isJsonNull()) {
                 bone.setParent(boneObject.get("parent").getAsString());
             }
 
diff --git a/src/test/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParentTest.java b/src/test/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParentTest.java
new file mode 100644
index 0000000..0d5c2c2
--- /dev/null
+++ b/src/test/java/org/cube/converter/parser/bedrock/geometry/BedrockGeometryParentTest.java
@@ -0,0 +1,23 @@
+package org.cube.converter.parser.bedrock.geometry;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BedrockGeometryParentTest {
+    @Test
+    void nullRootParentsDoNotDiscardTheGeometryOrItsChildHierarchy() {
+        for (final String parent : new String[]{"", " ,\"parent\":null"}) {
+            final var models = BedrockGeometryParser.parse("""
+                    {"format_version":"1.12.0","minecraft:geometry":[{
+                      "description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+                      "bones":[{"name":"root"%s},{"name":"child","parent":"root"}]}]}
+                    """.formatted(parent));
+            assertEquals(1, models.size());
+            final var bones = models.get(0).getParents();
+            assertEquals(2, bones.size());
+            assertEquals("", bones.get(0).getParent());
+            assertEquals("root", bones.get(1).getParent());
+        }
+    }
+}
