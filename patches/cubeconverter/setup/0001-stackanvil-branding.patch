From 2496957a08af8b5cec87f49a3633406b6d16425e Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:19:42 +0100
Subject: [PATCH] chore(branding): identify StackAnvil CubeConverter builds

Configure the StackAnvil version and manifest vendor through a settings script so the shared-source feature applies to master without setup. Keep the existing CubeConverter distribution filename for the selected ViaVersion module. Exclude these build identity changes from upstream PRs.
---
 gradle/stackanvil.settings.gradle | 13 +++++++++++++
 settings.gradle                   |  2 ++
 2 files changed, 15 insertions(+)
 create mode 100644 gradle/stackanvil.settings.gradle

diff --git a/gradle/stackanvil.settings.gradle b/gradle/stackanvil.settings.gradle
new file mode 100644
index 0000000..663e9ff
--- /dev/null
+++ b/gradle/stackanvil.settings.gradle
@@ -0,0 +1,13 @@
+import org.gradle.api.tasks.bundling.Jar
+
+gradle.beforeProject { project ->
+    project.afterEvaluate {
+        project.version = '1.3-StackAnvil'
+        project.tasks.withType(Jar).configureEach {
+            manifest.attributes 'Implementation-Vendor': 'StackAnvil'
+        }
+        if (project.path == ':vv-json') {
+            project.base.archivesName = 'cubeconverter'
+        }
+    }
+}
diff --git a/settings.gradle b/settings.gradle
index 991bc5b..6d4e1bc 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -1,3 +1,5 @@
+apply from: file('gradle/stackanvil.settings.gradle')
+
 /*
  * This file was generated by the Gradle 'init' task.
  */
