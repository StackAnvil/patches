@@ -92,6 +101,18 @@ public class Client2ProxyHandler extends SimpleChannelInboundHandler<Packet> {
     protected void channelRead0(ChannelHandlerContext ctx, Packet packet) throws Exception {
         if (this.proxyConnection.isClosed()) return;
 
+        if (this.pendingIdentityLogin != null) {
+            if (!(packet instanceof C2SLoginHelloPacket hello)) {
+                this.clearPendingIdentityLogin();
+                throw new IllegalStateException("Expected LoginHello before offline NetherNet connection");
+            }
+            final Consumer<C2SLoginHelloPacket> connect = this.pendingIdentityLogin;
+            this.clearPendingIdentityLogin();
+            ChannelUtil.disableAutoRead(ctx.channel());
+            connect.accept(hello);
+            return;
+        }
+
         if (this.proxyConnection.getC2pConnectionState() == ConnectionState.HANDSHAKING) {
             if (packet instanceof C2SHandshakingClientIntentionPacket) this.handleHandshake((C2SHandshakingClientIntentionPacket) packet);
             else throw new IllegalStateException("Unexpected packet in HANDSHAKING state");
@@ -239,10 +260,39 @@ public class Client2ProxyHandler extends SimpleChannelInboundHandler<Packet> {
     }
 
     private void connect(final SocketAddress serverAddress, final ProtocolVersion serverVersion, final ProtocolVersion clientVersion, final IntendedState intendedState, final HostAndPort clientHandshakeAddress, final UserOptions userOptions, final String[] handshakeParts) {
+        if (requiresHttpIdentityLogin(serverAddress, serverVersion, intendedState, userOptions.account() instanceof BedrockAccount)) {
+            // The Java handshake has no player name. Keep exactly one Hello until its identity can sign the offer.
+            this.pendingIdentityLogin = hello -> this.connectWithIdentity(serverAddress, serverVersion, clientVersion, intendedState, clientHandshakeAddress, userOptions, handshakeParts, AuthData.createSelfSigned(hello.name), hello);
+            this.identityLoginTimeout = this.proxyConnection.getC2P().eventLoop().schedule(() -> {
+                this.clearPendingIdentityLogin();
+                this.proxyConnection.kickClient("§cTimed out waiting for login before the offline Bedrock connection.");
+            }, ViaProxy.getConfig().getConnectTimeout(), TimeUnit.MILLISECONDS);
+            ChannelUtil.restoreAutoRead(this.proxyConnection.getC2P());
+            return;
+        }
+        this.connectWithIdentity(serverAddress, serverVersion, clientVersion, intendedState, clientHandshakeAddress, userOptions, handshakeParts, null, null);
+    }
+
+    static boolean requiresHttpIdentityLogin(final SocketAddress serverAddress, final ProtocolVersion serverVersion, final IntendedState intendedState, final boolean hasBedrockAccount) {
+        return intendedState.getConnectionState() == ConnectionState.LOGIN && serverVersion.equals(BedrockProtocolVersion.BEDROCK_LATEST)
+                && serverAddress instanceof NetherNetHttpAddress && !hasBedrockAccount;
+    }
+
+    private void clearPendingIdentityLogin() {
+        this.pendingIdentityLogin = null;
+        if (this.identityLoginTimeout != null) {
+            this.identityLoginTimeout.cancel(false);
+            this.identityLoginTimeout = null;
+        }
+    }
+
+    private void connectWithIdentity(final SocketAddress serverAddress, final ProtocolVersion serverVersion, final ProtocolVersion clientVersion, final IntendedState intendedState, final HostAndPort clientHandshakeAddress, final UserOptions userOptions, final String[] handshakeParts, final AuthData selfSignedIdentity, final C2SLoginHelloPacket savedHello) {
         final Supplier<ChannelHandler> handlerSupplier = () -> ViaProxy.EVENT_MANAGER.call(new Proxy2ServerHandlerCreationEvent(new Proxy2ServerHandler(), false)).getHandler();
         final ProxyConnection proxyConnection;
         if (serverVersion.equals(BedrockProtocolVersion.BEDROCK_LATEST)) {
-            proxyConnection = new BedrockProxyConnection(new Proxy2ServerChannelInitializer(handlerSupplier), this.proxyConnection.getC2P());
+            final BedrockProxyConnection bedrock = new BedrockProxyConnection(new Proxy2ServerChannelInitializer(handlerSupplier), this.proxyConnection.getC2P());
+            bedrock.setSelfSignedIdentity(selfSignedIdentity);
+            proxyConnection = bedrock;
         } else {
             proxyConnection = new ProxyConnection(new Proxy2ServerChannelInitializer(handlerSupplier), this.proxyConnection.getC2P());
         }
@@ -318,7 +368,20 @@ public class Client2ProxyHandler extends SimpleChannelInboundHandler<Packet> {
                                 userConnection.get(CookieStorage.class).cookies().putAll(TransferDataHolder.removeCookieStorage(this.proxyConnection.getC2P()).cookies());
                             }
                             this.proxyConnection.setP2sConnectionState(intendedState.getConnectionState());
-                            ChannelUtil.restoreAutoRead(this.proxyConnection.getC2P());
+                            if (savedHello == null) {
+                                ChannelUtil.restoreAutoRead(this.proxyConnection.getC2P());
+                            } else {
+                                this.proxyConnection.getC2P().eventLoop().execute(() -> {
+                                    final ChannelHandlerContext context = this.proxyConnection.getC2P().pipeline().context(this);
+                                    if (context == null || !context.channel().isActive()) return;
+                                    try {
+                                        this.channelRead0(context, savedHello);
+                                        ChannelUtil.restoreAutoRead(context.channel());
+                                    } catch (Exception exception) {
+                                        this.exceptionCaught(context, exception);
+                                    }
+                                });
+                            }
                         }
