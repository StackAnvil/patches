+package net.raphimc.viaproxy.proxy.client2proxy;
+
+import com.google.common.net.HostAndPort;
+import com.viaversion.viaversion.api.protocol.version.ProtocolVersion;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.embedded.EmbeddedChannel;
+import net.raphimc.netminecraft.constants.ConnectionState;
+import net.raphimc.netminecraft.constants.IntendedState;
+import net.raphimc.netminecraft.packet.impl.login.C2SLoginHelloPacket;
+import net.raphimc.netminecraft.packet.impl.status.C2SStatusRequestPacket;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import net.raphimc.viaproxy.ViaProxy;
+import net.raphimc.viaproxy.protocoltranslator.viaproxy.ViaProxyConfig;
+import net.raphimc.viaproxy.proxy.session.DummyProxyConnection;
+import net.raphimc.viaproxy.proxy.session.UserOptions;
+import net.raphimc.viaproxy.proxy.util.ChannelUtil;
+import net.raphimc.viaproxy.util.address.NetherNetHttpAddress;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.net.SocketAddress;
+import java.net.InetSocketAddress;
+import java.util.List;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.function.Consumer;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class OfflineHttpIdentityLoginTest {
+    private Object oldConfig;
+
+    @BeforeEach
+    void installDefaultConfig() throws Exception {
+        final Field field = ViaProxy.class.getDeclaredField("CONFIG");
+        field.setAccessible(true);
+        this.oldConfig = field.get(null);
+        field.set(null, new ViaProxyConfig());
+    }
+
+    @AfterEach
+    void restoreConfig() throws Exception {
+        final Field field = ViaProxy.class.getDeclaredField("CONFIG");
+        field.setAccessible(true);
+        field.set(null, this.oldConfig);
+    }
+
+    @Test
+    void onlyOfflineBedrockHttpLoginAndTransferRequireAnEarlyIdentity() {
+        final SocketAddress http = new NetherNetHttpAddress("127.0.0.1", 19132);
+        final SocketAddress rakNet = new InetSocketAddress("127.0.0.1", 19132);
+        for (final IntendedState state : List.of(IntendedState.LOGIN, IntendedState.TRANSFER)) {
+            assertTrue(Client2ProxyHandler.requiresHttpIdentityLogin(http, BedrockProtocolVersion.BEDROCK_LATEST, state, false));
+            assertFalse(Client2ProxyHandler.requiresHttpIdentityLogin(http, BedrockProtocolVersion.BEDROCK_LATEST, state, true));
+            assertFalse(Client2ProxyHandler.requiresHttpIdentityLogin(rakNet, BedrockProtocolVersion.BEDROCK_LATEST, state, false));
+            assertFalse(Client2ProxyHandler.requiresHttpIdentityLogin(http, ProtocolVersion.v26_3, state, false));
+        }
+        assertFalse(Client2ProxyHandler.requiresHttpIdentityLogin(http, BedrockProtocolVersion.BEDROCK_LATEST, IntendedState.STATUS, false));
+    }
+
+    @Test
+    void consumesOneHelloAndCancelsItsDeadlineBeforeTheBackendCallback() throws Exception {
+        final Handler handler = new Handler();
+        final EmbeddedChannel channel = new EmbeddedChannel(handler);
+        try {
+            this.defer(handler, channel);
+            assertTrue(channel.config().isAutoRead());
+            final ScheduledFuture<?> deadline = (ScheduledFuture<?>) field("identityLoginTimeout").get(handler);
+            final AtomicReference<C2SLoginHelloPacket> seen = new AtomicReference<>();
+            field("pendingIdentityLogin").set(handler, (Consumer<C2SLoginHelloPacket>) seen::set);
+            final C2SLoginHelloPacket hello = new C2SLoginHelloPacket();
+            channel.writeInbound(hello);
+            assertSame(hello, seen.get());
+            assertNull(field("pendingIdentityLogin").get(handler));
+            assertNull(field("identityLoginTimeout").get(handler));
+            assertTrue(deadline.isCancelled());
+            assertFalse(channel.config().isAutoRead());
+            assertNull(handler.failure);
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void disconnectDropsTheDeferredCallbackAndDeadline() throws Exception {
+        final Handler handler = new Handler();
+        final EmbeddedChannel channel = new EmbeddedChannel(handler);
+        try {
+            this.defer(handler, channel);
+            final ScheduledFuture<?> deadline = (ScheduledFuture<?>) field("identityLoginTimeout").get(handler);
+            final AtomicInteger calls = new AtomicInteger();
+            field("pendingIdentityLogin").set(handler, (Consumer<C2SLoginHelloPacket>) hello -> calls.incrementAndGet());
+            channel.close();
+            assertNull(field("pendingIdentityLogin").get(handler));
+            assertNull(field("identityLoginTimeout").get(handler));
+            assertTrue(deadline.isCancelled());
+            assertEquals(0, calls.get());
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void anUnexpectedPacketCannotRemainQueuedOrOpenABackend() throws Exception {
+        final Handler handler = new Handler();
+        final EmbeddedChannel channel = new EmbeddedChannel(handler);
+        try {
+            this.defer(handler, channel);
+            final ScheduledFuture<?> deadline = (ScheduledFuture<?>) field("identityLoginTimeout").get(handler);
+            final AtomicInteger calls = new AtomicInteger();
+            field("pendingIdentityLogin").set(handler, (Consumer<C2SLoginHelloPacket>) hello -> calls.incrementAndGet());
+            channel.writeInbound(new C2SStatusRequestPacket());
+            assertInstanceOf(IllegalStateException.class, handler.failure);
+            assertNull(field("pendingIdentityLogin").get(handler));
+            assertTrue(deadline.isCancelled());
+            assertEquals(0, calls.get());
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    private void defer(final Handler handler, final EmbeddedChannel channel) throws Exception {
+        ChannelUtil.disableAutoRead(channel);
+        final var method = Client2ProxyHandler.class.getDeclaredMethod("connect", SocketAddress.class, ProtocolVersion.class, ProtocolVersion.class,
+                IntendedState.class, HostAndPort.class, UserOptions.class, String[].class);
+        method.setAccessible(true);
+        method.invoke(handler, new NetherNetHttpAddress("127.0.0.1", 19132), BedrockProtocolVersion.BEDROCK_LATEST,
+                ProtocolVersion.v26_3, IntendedState.LOGIN, HostAndPort.fromParts("127.0.0.1", 25565), new UserOptions(null, null), new String[]{"127.0.0.1"});
+        assertNotNull(field("pendingIdentityLogin").get(handler));
+    }
+
+    private static Field field(final String name) throws Exception {
+        final Field field = Client2ProxyHandler.class.getDeclaredField(name);
+        field.setAccessible(true);
+        return field;
+    }
+
+    private static final class Handler extends Client2ProxyHandler {
+        private Throwable failure;
+
+        @Override
+        public void channelActive(final ChannelHandlerContext context) throws Exception {
+            final DummyProxyConnection connection = new DummyProxyConnection(context.channel());
+            connection.setClientVersion(ProtocolVersion.v26_3);
+            connection.setC2pConnectionState(ConnectionState.LOGIN);
+            field("proxyConnection").set(this, connection);
+        }
+
+        @Override
+        public void exceptionCaught(final ChannelHandlerContext context, final Throwable cause) {
+            this.failure = cause;
+            context.close();
+        }
+    }
+}
