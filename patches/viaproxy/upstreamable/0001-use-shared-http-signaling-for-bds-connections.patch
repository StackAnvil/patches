From dc081ad64aed17816ac35b2476a7c0cc82d5d63f Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Tue, 6 Oct 2026 01:02:37 +0200
Subject: [PATCH] fix(bedrock): use shared HTTP signaling for BDS connections

BDS 1.26.51.1 returns successful capability responses without JSON metadata.
The bundled transport rejects that response before posting the client offer.
Use ViaBedrock's HTTP signaling implementation so the proxy follows the same
native-compatible connection flow as direct clients.
---
 .../raphimc/viaproxy/proxy/session/BedrockProxyConnection.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/main/java/net/raphimc/viaproxy/proxy/session/BedrockProxyConnection.java b/src/main/java/net/raphimc/viaproxy/proxy/session/BedrockProxyConnection.java
index 3901b23..6be38d4 100644
--- a/src/main/java/net/raphimc/viaproxy/proxy/session/BedrockProxyConnection.java
+++ b/src/main/java/net/raphimc/viaproxy/proxy/session/BedrockProxyConnection.java
@@ -25,6 +25,7 @@ import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
 import net.raphimc.minecraftauth.bedrock.model.MinecraftMultiplayerToken;
 import net.raphimc.netminecraft.util.EventLoops;
 import net.raphimc.netminecraft.util.TransportType;
+import net.raphimc.viabedrock.netty.nethernet.BedrockHttpSignaling;
 import net.raphimc.viabedrock.netty.raknet.MessageCodec;
 import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
 import net.raphimc.viaproxy.ViaProxy;
@@ -101,7 +102,7 @@ public class BedrockProxyConnection extends ProxyConnection {
     protected void initializeNetherNet(final TransportType transportType, final Bootstrap bootstrap) {
         final NetherNetClientSignaling netherNetSignaling;
         if (this.serverAddress instanceof NetherNetHttpAddress) {
-            netherNetSignaling = new NetherNetHTTPClientSignaling();
+            netherNetSignaling = new BedrockHttpSignaling();
         } else if (this.serverAddress instanceof NetherNetLanAddress) {
             netherNetSignaling = new NetherNetDiscoverySignaling();
         } else if (this.serverAddress instanceof NetherNetXboxAddress || this.serverAddress instanceof NetherNetXboxJsonRpcAddress) {
