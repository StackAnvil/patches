From ede6572a25c16fb26ea6e6e209f09397587a2f2c Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 23:42:21 +0200
Subject: [PATCH] chore(branding): identify StackAnvil ViaProxy builds and
 route ViaBedrock

Use the ViaBedrock artifact built in the same stack run when Gradle receives the local Maven repository. Keep the upstream dependency for direct Gradle builds so the setup change stays out of future upstream PRs.

Compile and run StackAnvil ViaProxy on Java 25, matching ViaBedrock and
the client add-on. Resolve the shared MochaFloats runtime from its
restricted Maven repository. Remove the obsolete Java 8 downgraded
artifact and its build-only compatibility dependencies.
---
 build.gradle                                  | 41 ++++++-------
 gradle.properties                             |  4 +-
 .../injection/TransformerDowngrader.java      | 57 -------------------
 .../viaproxy/plugins/PluginManager.java       | 16 ------
 .../viaproxy/tasks/UpdateCheckTask.java       |  7 +--
 5 files changed, 21 insertions(+), 104 deletions(-)
 delete mode 100644 src/main/java/net/raphimc/viaproxy/injection/TransformerDowngrader.java

diff --git a/build.gradle b/build.gradle
index 190cf7c..3072424 100644
--- a/build.gradle
+++ b/build.gradle
@@ -5,14 +5,25 @@ plugins {
     id "base.fill-build-constants"
     id "viaproxy.publishing-conventions"
     id "net.raphimc.class-token-replacer" version "1.1.7"
-    id "xyz.wagyourtail.jvmdowngrader" version "2.0.1"
 }
 
-configurations {
-    includeInJarJ8
-}
+def stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+def viaBedrockDependency = stackAnvilMavenRepo.present
+    ? "net.raphimc:ViaBedrock:0.0.31-StackAnvil"
+    : "net.raphimc:ViaBedrock:0.0.31-20261003.172326-5"
 
 repositories {
+    maven {
+        name = "MochaFloats"
+        url = "https://repo.redlance.org/public"
+        content { includeGroup "org.redlance.mochafloats" }
+    }
+    if (stackAnvilMavenRepo.present) {
+        maven {
+            name = "StackAnvilLocal"
+            url = uri(stackAnvilMavenRepo.get())
+        }
+    }
     maven {
         name = "ViaVersion"
         url = "https://repo.viaversion.com"
@@ -64,7 +75,7 @@ dependencies {
     includeInJar "com.viaversion:viarewind-common:4.2.0"
     includeInJar "net.raphimc:ViaLegacy:3.1.0"
     includeInJar "com.viaversion:viaaprilfools-common:4.2.3"
-    includeInJar "net.raphimc:ViaBedrock:0.0.31-20261003.172326-5"
+    includeInJar viaBedrockDependency
 
     includeInJar "com.google.guava:guava:33.7.1-jre"
     includeInJar "com.google.code.gson:gson:2.14.0"
@@ -117,8 +128,6 @@ dependencies {
     includeInJar "gs.mclo:api:6.2.1"
     includeInJar "net.lenni0451:optconfig:1.1.1"
 
-    includeInJarJ8(compileOnly("xyz.wagyourtail.jvmdowngrader:jvmdowngrader:2.0.1"))
-    includeInJarJ8 "xyz.wagyourtail.jvmdowngrader:jvmdowngrader-java-api:2.0.1:downgraded-8"
 }
 
 application {
@@ -133,22 +142,8 @@ jar {
     }
 }
 
-downgradeJar {
-    dependsOn(configurations.includeInJarJ8)
-    from {
-        duplicatesStrategy = DuplicatesStrategy.EXCLUDE
-        configurations.includeInJarJ8.collect {
-            zipTree(it)
-        }
-    } {
-        exclude "META-INF/*.RSA", "META-INF/*.SF", "META-INF/*.DSA"
-    }
-
-    downgradeTo = JavaVersion.VERSION_1_8
-    ignoreWarningsIn.add("net/lenni0451/commons/httpclient/executor/HttpClientExecutor")
-    archiveClassifier = null
-    archiveVersion = project.version + "+java8"
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
 }
-build.finalizedBy("downgradeJar")
 
 tasks.javadoc.enabled = false
diff --git a/gradle.properties b/gradle.properties
index 93060d1..2e9d0fe 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -3,7 +3,7 @@ org.gradle.parallel=true
 org.gradle.configuration-cache=true
 org.gradle.jvmargs=-Xmx2G
 
-java_version=17
+java_version=25
 maven_group=net.raphimc
 maven_name=ViaProxy
-maven_version=3.4.15-SNAPSHOT
+maven_version=3.4.15-StackAnvil
