From 85bfbd0755bb6cb0bcf5cb7230eb44521cdb9338 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 26 Sep 2026 23:42:21 +0200
Subject: [PATCH] chore(branding): identify StackAnvil ViaProxy builds and
 route ViaBedrock

Use the ViaBedrock artifact built in the same stack run when Gradle receives the local Maven repository. Keep the upstream dependency for direct Gradle builds so the setup change stays out of future upstream PRs.
---
 build.gradle      | 17 ++++++++++++++++-
 gradle.properties |  2 +-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/build.gradle b/build.gradle
index 6fbd7f6..e594c7a 100644
--- a/build.gradle
+++ b/build.gradle
@@ -12,7 +12,18 @@ configurations {
     includeInJarJ8
 }
 
+def stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+def viaBedrockDependency = stackAnvilMavenRepo.present
+    ? "net.raphimc:ViaBedrock:0.0.31-StackAnvil"
+    : "net.raphimc:ViaBedrock:0.0.31-20260920.192303-2"
+
 repositories {
+    if (stackAnvilMavenRepo.present) {
+        maven {
+            name = "StackAnvilLocal"
+            url = uri(stackAnvilMavenRepo.get())
+        }
+    }
     maven {
         name = "ViaVersion"
         url = "https://repo.viaversion.com"
@@ -64,7 +75,7 @@ dependencies {
     includeInJar "com.viaversion:viarewind-common:4.2.0"
     includeInJar "net.raphimc:ViaLegacy:3.1.0"
     includeInJar "com.viaversion:viaaprilfools-common:4.2.3"
-    includeInJar "net.raphimc:ViaBedrock:0.0.31-20260920.192303-2"
+    includeInJar viaBedrockDependency
 
     includeInJar "com.google.guava:guava:33.7.1-jre"
     includeInJar "com.google.code.gson:gson:2.14.0"
@@ -133,6 +144,10 @@ jar {
     }
 }
 
+tasks.withType(Jar).configureEach {
+    manifest.attributes("Implementation-Vendor": "StackAnvil")
+}
+
 downgradeJar {
     dependsOn(configurations.includeInJarJ8)
     from {
diff --git a/gradle.properties b/gradle.properties
index 80bee3b..fbc3804 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -6,4 +6,4 @@ org.gradle.jvmargs=-Xmx2G
 java_version=17
 maven_group=net.raphimc
 maven_name=ViaProxy
-maven_version=3.4.14-SNAPSHOT
+maven_version=3.4.14-StackAnvil
-- 
2.55.0

