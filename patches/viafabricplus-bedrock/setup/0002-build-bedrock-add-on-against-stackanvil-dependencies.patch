From d4300e0ecac22a30dc31eeea5bed993e6352c3e1 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 18:02:05 +0200
Subject: [PATCH] fix(compat): build Bedrock add-on against StackAnvil
 dependencies

Remove the GUI-side fancy-lighting toggle because StackAnvil ViaBedrock no longer exposes its config switch. Match the chunk-tracker shadow to the PriorityQueue retained by the StackAnvil lighting and request-scheduling patches; upstream now uses a Set after reverting that foundation.
---
 .../injection/mixin/core/access/MixinChunkTracker.java      | 2 +-
 .../viafabricplus/bedrock/settings/BedrockSettings.java     | 6 ------
 2 files changed, 1 insertion(+), 7 deletions(-)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinChunkTracker.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinChunkTracker.java
index 3904ef1..5c3752c 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinChunkTracker.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinChunkTracker.java
@@ -36,7 +36,7 @@ public abstract class MixinChunkTracker implements IChunkTracker {
 
     @Shadow
     @Final
-    private Set<?> subChunkRequests;
+    private PriorityQueue<?> subChunkRequests;
 
     @Shadow
     @Final
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/settings/BedrockSettings.java b/src/main/java/com/viaversion/viafabricplus/bedrock/settings/BedrockSettings.java
index 715f20f..22d8860 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/settings/BedrockSettings.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/settings/BedrockSettings.java
@@ -34,13 +34,11 @@ import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
 public final class BedrockSettings {
 
     private final BooleanSetting replaceDefaultPort;
-    private final BooleanSetting experimentalFeatures;
 
     public BedrockSettings() {
         final SettingGroup group = ViaFabricPlus.api().settings().register("bedrock");
         group.register("account", new ActionSetting(Component.translatable("bedrock_settings.viafabricplus.account"), BedrockSettings::accountName, () -> ViaFabricPlusBedrock.impl().account().login()));
         this.replaceDefaultPort = group.registerBoolean("replace_default_port", true);
-        this.experimentalFeatures = group.registerBoolean("experimental_features", true);
     }
 
     private static Component accountName() {
@@ -64,8 +62,4 @@ public final class BedrockSettings {
         return this.replaceDefaultPort;
     }
 
-    public BooleanSetting experimentalFeatures() {
-        return this.experimentalFeatures;
-    }
-
 }
-- 
