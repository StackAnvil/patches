From e103b2714bb449567b3d8618955e8c3355cf1f42 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:51:34 +0200
Subject: [PATCH] chore(branding): identify StackAnvil builds and route
 dependencies

Use the ViaBedrock and ViaFabricPlus artifacts built in the same stack run when Gradle receives the local Maven repository. Keep upstream coordinates for direct Gradle builds and upstream PRs.
---
 build.gradle.kts  | 25 +++++++++++++++++++++++--
 gradle.properties |  2 +-
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index 442b2fa..cfc7928 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -13,7 +13,24 @@ setupProject()
 setupFabric()
 setupViaPublishing()
 
+val stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+val viaFabricPlusDependency = if (stackAnvilMavenRepo.isPresent) {
+    "com.viaversion:viafabricplus:5.1.1-StackAnvil"
+} else {
+    "com.viaversion:viafabricplus:5.1.0"
+}
+val viaBedrockDependency = if (stackAnvilMavenRepo.isPresent) {
+    "net.raphimc:ViaBedrock:0.0.31-StackAnvil"
+} else {
+    "net.raphimc:ViaBedrock:0.0.31-SNAPSHOT"
+}
+
 repositories {
+    if (stackAnvilMavenRepo.isPresent) {
+        maven(stackAnvilMavenRepo.get()) {
+            name = "StackAnvilLocal"
+        }
+    }
     maven("https://repo.viaversion.com")
     maven("https://maven.lenni0451.net/everything")
     maven("https://repo.opencollab.dev/maven-snapshots") {
@@ -32,9 +49,9 @@ repositories {
 val shade = configureJarInJar()
 
 dependencies {
-    implementation("com.viaversion:viafabricplus:5.1.0")
+    implementation(viaFabricPlusDependency)
 
-    shade("net.raphimc:ViaBedrock:0.0.31-SNAPSHOT") {
+    shade(viaBedrockDependency) {
         exclude(group = "com.mojang", module = "brigadier")
         exclude(group = "at.yawk.lz4", module = "lz4-java")
         exclude(group = "io.netty")
@@ -54,3 +71,7 @@ dependencies {
 }
 
 includeTransitiveJijDependencies()
+
+tasks.withType<Jar>().configureEach {
+    manifest.attributes["Implementation-Vendor"] = "StackAnvil"
+}
diff --git a/gradle.properties b/gradle.properties
index b958484..ec2855e 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -7,7 +7,7 @@ jvm_version=25
 
 project_group=com.viaversion
 project_name=viafabricplus-bedrock
-project_version=1.1.1-SNAPSHOT
+project_version=1.1.1-StackAnvil
 project_description=Minecraft: Bedrock Edition support for the ViaFabricPlus mod.
 
 publish_owner_id=florianreuth
-- 
2.55.0
