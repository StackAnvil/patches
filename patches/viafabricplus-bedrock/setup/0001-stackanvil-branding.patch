From fbab068879ed7bf612d5c3ea0c1dfbf884a10bd9 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:55:34 +0200
Subject: [PATCH] chore(build): configure StackAnvil identity and compatibility

Keep StackAnvil artifact identity and verified local dependency routing in
the setup layer. Follow the current upstream package structure and omit
the removed debug HUD integration. Exclude setup from upstream PRs.
---
 build.gradle.kts                              | 33 +++++++++++++++++++++--
 gradle.properties                             |  2 +-
 settings.gradle.kts                           | 13 +++++++++
 .../settings/impl/BedrockSettings.java        |  6 ----
 4 files changed, 45 insertions(+), 9 deletions(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index 200aa63..832bcee 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -5,11 +5,40 @@ plugins {
     id("via.maven_publish")
 }
 
+val stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+val viaFabricPlusDependency = if (stackAnvilMavenRepo.isPresent) {
+    "com.viaversion:viafabricplus:${providers.gradleProperty("stackanvilViaFabricPlusVersion").get()}"
+} else {
+    libs.viafabricplus.get().toString()
+}
+val viaBedrockDependency = if (stackAnvilMavenRepo.isPresent) {
+    "net.raphimc:ViaBedrock:0.0.32-StackAnvil"
+} else {
+    libs.viabedrock.get().toString()
+}
+
+tasks.withType<Jar>().configureEach {
+    manifest.attributes["Implementation-Vendor"] = "StackAnvil"
+}
+
+val bedrockOreUiShaper = providers.gradleProperty("bedrockOreUiShaper")
+if (bedrockOreUiShaper.isPresent) {
+    sourceSets.main { resources.srcDir(bedrockOreUiShaper) }
+    sourceSets.test { resources.srcDir(bedrockOreUiShaper) }
+    tasks.withType<Test>().configureEach {
+        jvmArgs("--enable-native-access=ALL-UNNAMED")
+    }
+}
+
 dependencies {
-    implementation(libs.viafabricplus)
+    implementation(viaFabricPlusDependency)
 
-    jarInJar(libs.viabedrock) {
+    jarInJar(viaBedrockDependency) {
         exclude(group = "com.mojang", module = "brigadier")
         exclude(group = "at.yawk.lz4", module = "lz4-java")
         exclude(group = "io.netty")
     }
+
+    if (stackAnvilMavenRepo.isPresent) {
+        jarInJar("org.oryxel.cube:vv-json:1.3-StackAnvil")
+    }
diff --git a/gradle.properties b/gradle.properties
index 786121b..13f251a 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -7,7 +7,7 @@ jvm_version=25
 
 project_group=com.viaversion
 project_name=viafabricplus-bedrock
-project_version=1.2.1-SNAPSHOT
+project_version=1.2.1-StackAnvil
 project_description=Minecraft: Bedrock Edition support for the ViaFabricPlus mod.
 
 publish_owner_id=florianreuth
diff --git a/settings.gradle.kts b/settings.gradle.kts
index 9b57f98..c4d1e0e 100644
--- a/settings.gradle.kts
+++ b/settings.gradle.kts
@@ -14,6 +14,19 @@ plugins {
 
 dependencyResolutionManagement {
     repositories {
+        val stackAnvilMavenRepo = providers.gradleProperty("stackanvilMavenRepo")
+        if (stackAnvilMavenRepo.isPresent) {
+            exclusiveContent {
+                forRepository {
+                    maven(stackAnvilMavenRepo.get()) { name = "StackAnvilPinnedViaFabricPlus" }
+                }
+                filter {
+                    includeModule("com.viaversion", "viafabricplus")
+                    includeModule("com.viaversion", "viafabricplus-api")
+                }
+            }
+            maven(stackAnvilMavenRepo.get()) { name = "StackAnvilLocal" }
+        }
         maven("https://repo.viaversion.com")
         maven("https://maven.lenni0451.net/everything")
         maven("https://repo.opencollab.dev/maven-snapshots") {
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/settings/impl/BedrockSettings.java b/src/main/java/com/viaversion/viafabricplus/bedrock/settings/impl/BedrockSettings.java
index 346801e..1001738 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/settings/impl/BedrockSettings.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/settings/impl/BedrockSettings.java
@@ -35,13 +35,11 @@ import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
 public final class BedrockSettings {
 
     private final BooleanSetting replaceDefaultPort;
-    private final BooleanSetting experimentalFeatures;
 
     public BedrockSettings() {
         final SettingGroup group = ViaFabricPlus.api().settings().register("bedrock");
         group.register("account", new ActionSetting(Component.translatable("bedrock_settings.viafabricplus.account"), BedrockSettings::accountName, () -> ViaFabricPlusBedrock.impl().account().login()));
         this.replaceDefaultPort = group.registerBoolean("replace_default_port", true);
-        this.experimentalFeatures = group.registerBoolean("experimental_features", true);
     }
 
     private static Component accountName() {
@@ -65,8 +63,4 @@ public final class BedrockSettings {
         return this.replaceDefaultPort;
     }
 
-    public BooleanSetting experimentalFeatures() {
-        return this.experimentalFeatures;
-    }
-
 }
-- 
2.56.0
