+/*
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import net.minecraft.client.multiplayer.resolver.ServerAddress;
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.CompletableFuture;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ServerBlacklistBypassTest {
+    @Test
+    void approvalAppliesOnlyToTheConfirmedAttemptDuringSynchronousConnectionSetup() {
+        final var selected = new ServerAddress("geo.hivebedrock.network", 19132);
+        final var reconnect = new ServerAddress("geo.hivebedrock.network", 19132);
+        assertFalse(ServerBlacklistBypass.isConfirmed(selected));
+        ServerBlacklistBypass.connectOnce(selected, () -> {
+            assertTrue(ServerBlacklistBypass.isConfirmed(selected));
+            assertFalse(ServerBlacklistBypass.isConfirmed(reconnect));
+            assertFalse(CompletableFuture.supplyAsync(() -> ServerBlacklistBypass.isConfirmed(selected)).join());
+        });
+        assertFalse(ServerBlacklistBypass.isConfirmed(selected));
+        assertFalse(ServerBlacklistBypass.isConfirmed(reconnect));
+    }
+
+    @Test
+    void failedConnectionSetupCannotLeaveApprovalForALaterAttempt() {
+        final var selected = new ServerAddress("geo.hivebedrock.network", 19132);
+        assertThrows(IllegalStateException.class, () -> ServerBlacklistBypass.connectOnce(selected, () -> {
+            throw new IllegalStateException("Connection setup failed");
+        }));
+        assertFalse(ServerBlacklistBypass.isConfirmed(selected));
+    }
+
+    @Test
+    void nestedConnectionSetupRestoresTheOuterAttemptWithoutApprovingAnotherAddress() {
+        final var first = new ServerAddress("geo.hivebedrock.network", 19132);
+        final var second = new ServerAddress("donutsmp.net", 19132);
+        ServerBlacklistBypass.connectOnce(first, () -> {
+            ServerBlacklistBypass.connectOnce(second, () -> {
+                assertTrue(ServerBlacklistBypass.isConfirmed(second));
+                assertFalse(ServerBlacklistBypass.isConfirmed(first));
+            });
+            assertTrue(ServerBlacklistBypass.isConfirmed(first));
+            assertFalse(ServerBlacklistBypass.isConfirmed(second));
+        });
+        assertFalse(ServerBlacklistBypass.isConfirmed(first));
+        assertFalse(ServerBlacklistBypass.isConfirmed(second));
+    }
+}
