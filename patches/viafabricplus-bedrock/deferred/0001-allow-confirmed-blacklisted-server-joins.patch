+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(value = LoginPackets.class, remap = false)
+public abstract class MixinLoginPackets {
+    @WrapOperation(method = "*", at = @At(value = "INVOKE",
+            target = "Lnet/raphimc/viabedrock/api/util/ServerBlacklist;isBlacklisted(Ljava/lang/String;)Z"))
+    private static boolean requireConsentForBlacklistedServer(final String hostname, final Operation<Boolean> original,
+            @Local(argsOnly = true) final PacketWrapper wrapper) {
+        return original.call(hostname) && !wrapper.user().has(ServerBlacklistBypass.class);
+    }
+}
