+/*
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import net.minecraft.client.multiplayer.resolver.ServerAddress;
+
+/** Carries explicit warning consent into one newly created connection. */
+public final class ServerBlacklistBypass implements StorableObject {
+    private static final ThreadLocal<ServerAddress> CONFIRMED_ADDRESS = new ThreadLocal<>();
+
+    public static boolean isConfirmed(final ServerAddress address) {
+        return address != null && CONFIRMED_ADDRESS.get() == address;
+    }
+
+    /** ConnectScreen creates its worker synchronously; the worker retains its own consent flag. */
+    public static void connectOnce(final ServerAddress address, final Runnable connect) {
+        final ServerAddress previous = CONFIRMED_ADDRESS.get();
+        CONFIRMED_ADDRESS.set(address);
+        try {
+            connect.run();
+        } finally {
+            if (previous == null) CONFIRMED_ADDRESS.remove();
+            else CONFIRMED_ADDRESS.set(previous);
+        }
+    }
+}
