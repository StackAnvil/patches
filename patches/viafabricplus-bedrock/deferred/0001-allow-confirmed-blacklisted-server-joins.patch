+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.injection.access.IConnectScreen;
+import com.viaversion.viafabricplus.bedrock.injection.access.IServerAddress;
+import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.NetherNetHttpAddress;
+import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.ServerBlacklistBypass;
+import com.viaversion.viafabricplus.injection.access.core.IServerData;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.ConfirmScreen;
+import net.minecraft.client.gui.screens.ConnectScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ServerData;
+import net.minecraft.client.multiplayer.TransferState;
+import net.minecraft.client.multiplayer.resolver.ServerAddress;
+import net.minecraft.network.chat.CommonComponents;
+import net.minecraft.network.chat.Component;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import net.raphimc.viabedrock.api.util.ServerBlacklist;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(ConnectScreen.class)
+public abstract class MixinConnectScreen implements IConnectScreen {
+    @Unique
+    private boolean viaFabricPlusBedrock$blacklistConsent;
+
+    @Inject(method = "startConnecting", at = @At("HEAD"), cancellable = true)
+    private static void warnBeforeBlacklistedConnection(final Screen parent, final Minecraft minecraft,
+            final ServerAddress address, final ServerData server, final boolean quickPlay,
+            final TransferState transfer, final CallbackInfo ci) {
+        final var forced = server == null ? null : ((IServerData) server).viaFabricPlus$forcedVersion();
+        final var version = forced != null ? forced : ViaFabricPlus.api().targetVersion();
+        if (!BedrockProtocolVersion.BEDROCK_LATEST.equals(version) || ServerBlacklistBypass.isConfirmed(address)) return;
+
+        final var transport = ((IServerAddress) (Object) address).viaFabricPlusBedrock$getNetherNetAddress();
+        final String hostname = transport instanceof NetherNetHttpAddress http ? http.host() : address.getHost();
+        if (!ServerBlacklist.isBlacklisted(hostname)) return;
+
+        minecraft.gui.setScreen(new ConfirmScreen(confirmed -> {
+            minecraft.gui.setScreen(parent);
+            if (confirmed) ServerBlacklistBypass.connectOnce(address,
+                    () -> ConnectScreen.startConnecting(parent, minecraft, address, server, quickPlay, transfer));
+        }, Component.translatable("bedrock_server_warning.viafabricplus.title"),
+                Component.translatable("bedrock_server_warning.viafabricplus.message", hostname),
+                Component.translatable("bedrock_server_warning.viafabricplus.join_anyway"), CommonComponents.GUI_CANCEL));
+        ci.cancel();
+    }
+
+    @Inject(method = "connect", at = @At("HEAD"))
+    private void retainWarningConsent(final Minecraft minecraft, final ServerAddress address, final ServerData server,
+            final TransferState transfer, final CallbackInfo ci) {
+        this.viaFabricPlusBedrock$blacklistConsent = ServerBlacklistBypass.isConfirmed(address);
+    }
+
+    @Override
+    public boolean viaFabricPlusBedrock$hasBlacklistConsent() {
+        return this.viaFabricPlusBedrock$blacklistConsent;
+    }
+}
