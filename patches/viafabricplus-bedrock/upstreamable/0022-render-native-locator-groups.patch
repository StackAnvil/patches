+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.hud;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import net.minecraft.world.phys.Vec3;
+
+/** Visual interpolation never changes the authoritative waypoint target. */
+final class LocatorBarMotion {
+    private final Map<UUID, Vec3> positions = new HashMap<>();
+
+    Vec3 advance(final UUID id, final Vec3 target, final Vec3 observer, final float elapsedSeconds) {
+        if (target == null || !Double.isFinite(target.x) || !Double.isFinite(target.y) || !Double.isFinite(target.z)) {
+            this.positions.remove(id);
+            return null;
+        }
+        final Vec3 previous = this.positions.get(id);
+        final Vec3 position;
+        if (previous == null) {
+            position = target;
+        } else {
+            final double distance = Math.clamp((target.distanceToSqr(observer) - 256) / 3840, 0, 1);
+            final double rate = 20 - 18 * distance;
+            final double fraction = 1 - Math.exp(-rate * Math.max(0, elapsedSeconds));
+            position = previous.lerp(target, fraction);
+        }
+        this.positions.put(id, position);
+        return position;
+    }
+
+    void retain(final Set<UUID> ids) {
+        this.positions.keySet().retainAll(ids);
+    }
+
+    void clear() {
+        this.positions.clear();
+    }
+}
