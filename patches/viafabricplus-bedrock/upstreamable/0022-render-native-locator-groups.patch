--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/hud/LocatorBarProjection.java
@@ -0,0 +1,52 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.hud;
+
+/** Native horizontal bearing and vertical camera angle, independent of GUI scale. */
+final class LocatorBarProjection {
+    private LocatorBarProjection() {}
+
+    static float iconExtent(final float size) {
+        // Native 1.26.60.5 sizes the quad independently of the source texture.
+        return size * 5 + 2;
+    }
+
+    static Placement project(final double dx, final double dy, final double dz,
+                             final float cameraX, final float cameraZ, final float pitch, final float width,
+                             final float barHeight, final float iconWidth, final float verticalFov) {
+        if (!Double.isFinite(dx) || !Double.isFinite(dy) || !Double.isFinite(dz)
+                || !Float.isFinite(cameraX) || !Float.isFinite(cameraZ) || !Float.isFinite(pitch) || !Float.isFinite(width)
+                || !Float.isFinite(barHeight) || !Float.isFinite(iconWidth)
+                || !Float.isFinite(verticalFov) || verticalFov <= 0 || verticalFov >= 180) return null;
+        final float limit = (float) Math.toRadians(60);
+        // The native draw normalizes the complete direction before taking atan2(z, x).
+        // A vertical or near-coincident target therefore retains the native zero-vector bearing.
+        float x = (float) dx;
+        final float y = (float) dy;
+        float z = (float) dz;
+        final float length = (float) Math.sqrt(y * y + x * x + z * z);
+        if (length < 0.0001F) {
+            x = 0;
+            z = 0;
+        } else {
+            x /= length;
+            z /= length;
+        }
+        final float bearing = (float) Math.atan2(z, x) - (float) Math.atan2(cameraZ, cameraX);
+        final float pi = (float) Math.PI;
+        final float turn = pi * 2;
+        float angle = bearing % turn;
+        if (angle <= -pi) angle += turn;
+        else if (angle > pi) angle -= turn;
+        if (Math.abs(angle) >= limit) return null;
+        final double elevation = Math.atan2(dy, Math.hypot(dx, dz)) + Math.toRadians(pitch);
+        final double threshold = Math.toRadians(verticalFov) * 0.5 * 0.85;
+        final int arrow = elevation >= threshold ? 1 : elevation <= -threshold ? -1 : 0;
+        return new Placement(angle / limit * 0.5F * (width - (barHeight + iconWidth + 2)), arrow);
+    }
+
+    record Placement(float offset, int arrow) {}
+}
