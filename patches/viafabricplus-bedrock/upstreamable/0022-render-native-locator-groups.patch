+package com.viaversion.viafabricplus.bedrock.hud;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.LocatorBarSnapshot;
+
+public record LocatorBarPayload(LocatorBarSnapshot snapshot) implements CustomPacketPayload {
+    public static final Type<LocatorBarPayload> TYPE = new Type<>(Identifier.parse(LocatorBarSnapshot.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, LocatorBarPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> LocatorBarSnapshot.TYPE.write(buffer, payload.snapshot),
+            buffer -> new LocatorBarPayload(LocatorBarSnapshot.TYPE.read(buffer)));
+
+    @Override
+    public Type<LocatorBarPayload> type() {
+        return TYPE;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/hud/LocatorBarProjection.java b/src/main/java/com/viaversion/viafabricplus/bedrock/hud/LocatorBarProjection.java
new file mode 100644
