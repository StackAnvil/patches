@@ -0,0 +1,53 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.util.Optional;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiTextureSources;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Serves native UI images from the accepted Bedrock packs nested in the server's Java pack.
+ * The backend names each image with a UI texture identifier but does not copy it into the Java pack. This lookup
+ * converts the image from the same bundled UI layer and accepted layers that built the backend's UI program, and
+ * attributes it to the server pack that indexes those layers. A pack that supplies the identifier directly still wins.
+ * One instance belongs to one resource manager generation and is discarded with it on reload.
+ */
+public final class BedrockServerUiTextures {
+    private static final Logger LOGGER = LogManager.getLogger("Bedrock UI textures");
+    private boolean loaded;
+    private PackResources pack;
+    private UiTextureSources textures;
+
+    /** Returns the found resource unchanged; only an absent server UI image can resolve from accepted sources. */
+    public synchronized Optional<Resource> lookup(final Identifier id, final Optional<Resource> found, final ResourceManager resources) {
+        if (found.isPresent() || !id.getNamespace().equals("viabedrock") || !id.getPath().startsWith("textures/server_ui/")) return found;
+        if (!this.loaded) {
+            this.loaded = true;
+            try {
+                final var source = BedrockAcceptedResources.source(resources);
+                final var archive = source == null ? Optional.<NativeActorLibrary.Archive>empty() : BedrockAcceptedResources.archive(source);
+                if (archive.isPresent()) {
+                    this.pack = source.pack();
+                    this.textures = UiTextureSources.of(archive.get().layers().stream().map(NativeActorLibrary.Layer::resources).toList());
+                }
+            } catch (final IOException | RuntimeException invalid) {
+                LOGGER.debug("Ignoring unreadable accepted UI sources", invalid);
+            }
+        }
+        if (this.textures == null) return found;
+        final byte[] bytes = this.textures.resolve(id.getPath());
+        return bytes == null ? found : Optional.of(new Resource(this.pack, () -> new ByteArrayInputStream(bytes)));
+    }
+}
