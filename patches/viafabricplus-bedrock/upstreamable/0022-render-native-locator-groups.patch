+package com.viaversion.viafabricplus.bedrock.hud;
+
+import net.raphimc.viabedrock.api.model.LocatorBarSnapshot;
+
+/** A queued snapshot belongs to one connection generation, including same-object reconnects. */
+final class LocatorBarSession {
+    private volatile long generation;
+    private LocatorBarSnapshot snapshot;
+
+    long generation() {
+        return this.generation;
+    }
+
+    boolean accept(final long receivedGeneration, final LocatorBarSnapshot snapshot) {
+        if (receivedGeneration != this.generation) return false;
+        this.snapshot = snapshot;
+        return true;
+    }
+
+    LocatorBarSnapshot snapshot() {
+        return this.snapshot;
+    }
+
+    void clear() {
+        this.generation++;
+        this.snapshot = null;
+    }
+}
