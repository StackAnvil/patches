+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import javax.imageio.ImageIO;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.IoSupplier;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.BedrockResourcePackPayloads;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.api.resourcepack.ui.JsonUiProgram;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockServerUiTexturesTest {
+    private static final Identifier ICON = Identifier.parse(JsonUiProgram.textureId("textures/ui/icon.png"));
+
+    @AfterEach
+    void clear() {
+        BedrockAcceptedResources.clear();
+    }
+
+    @Test
+    void uiImagesResolveFromTheAcceptedPacksOfTheServerPackThatIndexesThem() throws Exception {
+        final byte[] lower = image(0xFF1256AB);
+        final byte[] upper = image(0xFFAB5612);
+        final PackResources server = pack(PackSource.SERVER, payloads(lower, upper));
+        final PackResources local = pack(PackSource.DEFAULT, payloads(upper, lower));
+        final Resource resolved = new BedrockServerUiTextures().lookup(ICON, Optional.empty(), resources(server, local)).orElseThrow();
+        // The higher accepted layer wins, and the image belongs to the server pack rather than a local pack.
+        assertSame(server, resolved.source());
+        try (InputStream input = resolved.open()) {
+            assertArrayEquals(upper, input.readAllBytes());
+        }
+    }
+
+    @Test
+    void directIdentifiersUnknownImagesAndLocalPacksLeaveTheResultUnchanged() throws Exception {
+        final PackResources server = pack(PackSource.SERVER, payloads(image(0xFF000000), image(0xFFFFFFFF)));
+        final Optional<Resource> direct = Optional.of(new Resource(server, () -> new ByteArrayInputStream(new byte[]{1})));
+        assertSame(direct, new BedrockServerUiTextures().lookup(ICON, direct, resources(server)));
+        final Identifier unknown = Identifier.parse(JsonUiProgram.textureId("textures/ui/absent.png"));
+        assertTrue(new BedrockServerUiTextures().lookup(unknown, Optional.empty(), resources(server)).isEmpty());
+        final PackResources local = pack(PackSource.DEFAULT, payloads(image(0xFF000000), image(0xFFFFFFFF)));
+        assertTrue(new BedrockServerUiTextures().lookup(ICON, Optional.empty(), resources(local)).isEmpty());
+    }
+
+    private static byte[] image(final int argb) throws Exception {
+        final var pixels = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+        pixels.setRGB(0, 0, argb);
+        final var output = new ByteArrayOutputStream();
+        ImageIO.write(pixels, "png", output);
+        return output.toByteArray();
+    }
+
+    private static Content payloads(final byte[] lower, final byte[] upper) throws Exception {
+        final InMemoryContent bottom = new InMemoryContent();
+        final InMemoryContent top = new InMemoryContent();
+        for (final var content : List.of(bottom, top)) {
+            content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                    + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        }
+        bottom.put("textures/ui/icon.png", lower);
+        top.put("textures/ui/icon.png", upper);
+        return BedrockResourcePackPayloads.export(ProtocolConstants.BEDROCK_VERSION_NAME,
+                List.of(new ResourcePack(bottom), new ResourcePack(top)), ignored -> true);
+    }
+
+    private static PackResources pack(final PackSource source, final Content content) {
+        final var location = new PackLocationInfo("test", Component.empty(), source, Optional.empty());
+        return (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class[]{PackResources.class}, (proxy, method, arguments) -> {
+            if (method.getName().equals("location")) return location;
