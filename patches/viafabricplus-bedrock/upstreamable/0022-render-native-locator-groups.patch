+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.Function;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.PackType;
+import net.minecraft.server.packs.resources.IoSupplier;
+import net.minecraft.server.packs.resources.Resource;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiTextureAliases;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockServerUiTexturesTest {
+    private static final Identifier SHARED = Identifier.fromNamespaceAndPath("viabedrock", "textures/server_ui/shared.png");
+    private static final Identifier PIG = Identifier.fromNamespaceAndPath("viabedrock", "textures/item/entities/pig.png");
+    private static final Identifier TABLE = Identifier.fromNamespaceAndPath("viabedrock", UiTextureAliases.RESOURCE);
+    private static final String PIG_ALIAS = "{\"format\":1,\"aliases\":{\"textures/server_ui/shared.png\":\"textures/item/entities/pig.png\"}}";
+
+    @Test
+    void sharedUiImagesKeepTheServerPacksPixelsUnderTheirRequestedIdentifier() throws Exception {
+        final BedrockServerUiTextures textures = new BedrockServerUiTextures();
+        final PackResources server = pack(Map.of(TABLE, PIG_ALIAS, PIG, "server pig"));
+        final PackResources override = pack(Map.of(PIG, "override pig", SHARED, "override ui"));
+
+        // Another pack overrides only the shared target; the UI image still reads the server pack's bytes.
+        final Resource shared = textures.lookup(SHARED, Optional.empty(),
+            resources(Map.of(TABLE, resource(server, TABLE), PIG, resource(override, PIG)))).orElseThrow();
+        assertSame(server, shared.source());
+        assertEquals("server pig", read(shared));
+
+        // An explicit pack override of the requested UI identifier still wins.
+        final Optional<Resource> direct = Optional.of(resource(override, SHARED));
+        assertSame(direct, textures.lookup(SHARED, direct, resources(Map.of(TABLE, resource(server, TABLE)))));
+    }
+
+    @Test
+    void lookupsWithoutAUsableAliasLeaveTheResultUnchanged() {
+        final BedrockServerUiTextures textures = new BedrockServerUiTextures();
+        final Identifier unique = Identifier.fromNamespaceAndPath("viabedrock", "textures/server_ui/unique.png");
+        final PackResources server = pack(Map.of(TABLE, PIG_ALIAS, PIG, "server pig"));
+        assertTrue(textures.lookup(unique, Optional.empty(), resources(Map.of(TABLE, resource(server, TABLE)))).isEmpty());
+        assertTrue(textures.lookup(SHARED, Optional.empty(), id -> Optional.empty()).isEmpty());
+        final PackResources invalid = pack(Map.of(TABLE, "not json", PIG, "server pig"));
+        assertTrue(textures.lookup(SHARED, Optional.empty(), resources(Map.of(TABLE, resource(invalid, TABLE)))).isEmpty());
+        // A replacement server pack replaces the cached table.
+        final PackResources replacement = pack(Map.of(TABLE, PIG_ALIAS, PIG, "replacement pig"));
+        assertSame(replacement, textures.lookup(SHARED, Optional.empty(), resources(Map.of(TABLE, resource(replacement, TABLE)))).orElseThrow().source());
+    }
+
+    private static Function<Identifier, Optional<Resource>> resources(final Map<Identifier, Resource> available) {
