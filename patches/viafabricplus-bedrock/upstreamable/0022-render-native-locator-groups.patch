--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockServerUiTextures.java
@@ -0,0 +1,57 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.Function;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.PackType;
+import net.minecraft.server.packs.resources.IoSupplier;
+import net.minecraft.server.packs.resources.Resource;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiTextureAliases;
+
+/**
+ * Serves converted UI images that the server pack shares with an identical image.
+ * The converter removes the duplicate UI file and records its identifier in an alias table. This lookup returns the
+ * shared bytes under the requested UI identifier, read from the same pack that wrote the table, so textures load
+ * through their normal identifier and another pack's override of the shared target cannot change UI pixels.
+ * One instance belongs to one resource manager generation and is discarded with it on reload.
+ */
+public final class BedrockServerUiTextures {
+    private static final Identifier ALIASES = Identifier.fromNamespaceAndPath("viabedrock", UiTextureAliases.RESOURCE);
+    private static final int MAX_BYTES = 8 * 1024 * 1024;
+    private PackResources source;
+    private Map<String, String> aliases = Map.of();
+
+    /** Returns the found resource unchanged; only an absent server UI image can resolve through the alias table. */
+    public synchronized Optional<Resource> lookup(final Identifier id, final Optional<Resource> found,
+                                                  final Function<Identifier, Optional<Resource>> resources) {
+        if (found.isPresent() || !id.getNamespace().equals("viabedrock") || !id.getPath().startsWith("textures/server_ui/")) return found;
+        final Resource table = resources.apply(ALIASES).orElse(null);
+        if (table == null) return found;
+        final PackResources pack = table.source();
+        if (pack != this.source) {
+            Map<String, String> loaded;
+            try (final InputStream input = table.open()) {
+                final byte[] bytes = input.readNBytes(MAX_BYTES + 1);
+                loaded = bytes.length > MAX_BYTES ? Map.of() : UiTextureAliases.read(bytes);
+            } catch (final IOException | RuntimeException invalid) {
+                loaded = Map.of();
+            }
+            this.source = pack;
+            this.aliases = loaded;
+        }
+        final String target = this.aliases.get(id.getPath());
+        final Identifier shared = target == null ? null : Identifier.tryBuild("viabedrock", target);
+        if (shared == null) return found;
+        final IoSupplier<InputStream> bytes = pack.getResource(PackType.CLIENT_RESOURCES, shared);
+        return bytes == null ? found : Optional.of(new Resource(pack, bytes));
+    }
+}
