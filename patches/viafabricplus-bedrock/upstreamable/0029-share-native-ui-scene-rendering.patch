+            this.tables = new Tables(this.data.asReadOnlyBuffer());
+            this.scale = (float) height / (this.tables.ascent - this.tables.descent);
+            final var pointer = stack.mallocPointer(1);
+            if (FreeType.FT_Init_FreeType(pointer) != 0) throw new IOException("Cannot initialize native font reader");
