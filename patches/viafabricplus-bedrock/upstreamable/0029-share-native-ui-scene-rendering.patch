+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiMixedLinesTest {
+    @Test
+    void preservesNativeFragmentRangesBaselinesWrappingAndZeroWidthLineHeight() throws Exception {
+        assertNativeLines("/oreui/native-mixed-lines-2225.json");
+        assertNativeLines("/oreui/native-trailing-reserve-2225.json");
+    }
+
+    private static void assertNativeLines(final String resource) throws Exception {
+        try (var stream = OreUiMixedLinesTest.class.getResourceAsStream(resource)) {
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var sample = entry.getAsJsonObject();
+                final var definitions = sample.getAsJsonArray("fontMetrics");
+                final List<OreUiLines.Font> fonts = new ArrayList<>();
+                for (int index = 0; index < definitions.size(); index++) {
+                    final var metrics = definitions.get(index).getAsJsonArray();
+                    fonts.add(new OreUiLines.Font(sample.getAsJsonArray("fontIdentities").get(index).getAsInt(),
+                            new OreUiFont.LineMetrics(metrics.get(0).getAsFloat(), metrics.get(1).getAsFloat())));
+                }
+                final var map = sample.getAsJsonArray("fontMap");
+                final int[] fontMap = new int[map.size()];
+                for (int index = 0; index < map.size(); index++) fontMap[index] = map.get(index).getAsInt();
+                final var result = OreUiLines.layout(sample.get("text").getAsString().codePoints().toArray(),
+                        floats(sample.getAsJsonArray("advances")), fontMap, fonts, sample.get("width").getAsFloat(),
+                        sample.get("indent").getAsFloat(), sample.get("letterSpacing").getAsFloat(),
+                        OreUiLines.WhiteSpace.values()[sample.get("whitespace").getAsInt()],
+                        OreUiLines.OverflowWrap.values()[sample.get("wordbreak").getAsInt()],
+                        OreUiLines.Alignment.values()[sample.get("alignment").getAsInt()], sample.get("fill").getAsBoolean(),
+                        sample.has("trailingAdvance") ? sample.get("trailingAdvance").getAsFloat() : 0F);
+                final var lines = sample.getAsJsonArray("lines");
+                assertEquals(lines.size(), result.lines().size(), sample.toString());
+                for (int index = 0; index < lines.size(); index++) {
+                    final var line = lines.get(index).getAsJsonObject();
+                    final List<OreUiLines.Fragment> fragments = new ArrayList<>();
+                    for (final var fragment : line.getAsJsonArray("fragments")) {
+                        final var box = fragment.getAsJsonObject();
+                        fragments.add(new OreUiLines.Fragment(box.get("start").getAsInt(), box.get("end").getAsInt(),
+                                box.get("font").getAsInt(), box.get("x").getAsFloat(), box.get("baseline").getAsFloat(),
+                                box.get("width").getAsFloat(), box.get("height").getAsFloat()));
+                    }
+                    final var actual = result.lines().get(index);
+                    assertEquals(fragments, actual.fragments(), sample.toString());
+                    assertEquals(line.get("width").getAsFloat(), actual.width(), sample.toString());
+                    assertEquals(line.get("height").getAsFloat(), actual.height(), sample.toString());
+                    assertEquals(line.get("hardBreak").getAsBoolean(), actual.hardBreak(), sample.toString());
+                }
+                assertEquals(sample.getAsJsonArray("extent").get(0).getAsFloat(), result.width(), sample.toString());
+                assertEquals(sample.getAsJsonArray("extent").get(1).getAsFloat(), result.height(), sample.toString());
+            }
+        }
+    }
+
+    private static float[] floats(final JsonArray values) {
+        final float[] result = new float[values.size()];
+        for (int index = 0; index < result.length; index++) result[index] = values.get(index).getAsFloat();
+        return result;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiShaderGpuTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiShaderGpuTest.java
new file mode 100644
