+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+
+/** Resolves authored anchors and content dimensions independently of the rendering backend. */
+public final class NativeUiLayout {
+    private static final float LIMIT = 16384;
+    private static final Size EMPTY = new Size(0, 0);
+    private final Metrics metrics;
+    private final NativeUiAnimations animations;
+    private final Map<NativeUiScene.Node, Map<Measurement, Size>> measured = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, Boolean> visibleNodes = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, NativeUiCollectionWindow> windows = new IdentityHashMap<>();
+    private Function<NativeUiScene.Node, NativeUiCursorPlacement> placements;
+    private final Map<NativeUiScene.Node, CursorOffset> cursorOffsets = new IdentityHashMap<>();
+    private float verticalLimit;
+    private int work;
+
+    public NativeUiLayout(final Metrics metrics) {
+        this(metrics, null);
+    }
+
+    public NativeUiLayout(final Metrics metrics, final NativeUiAnimations animations) {
+        this.metrics = metrics;
+        this.animations = animations;
+    }
+
+    private NativeUiDimension dimensionValue(final NativeUiScene.Node node, final String key, final int axis) {
+        final NativeUiDimension animated = this.animations == null ? null : this.animations.dimension(node, key, axis);
+        if (animated != null) return animated;
+        final JsonElement pair = node.properties().get(key);
+        if (pair == null || !pair.isJsonArray() || pair.getAsJsonArray().size() != 2) return null;
+        return NativeUiDimension.parse(pair.getAsJsonArray().get(axis));
+    }
+
+    public Box layout(final NativeUiScene.Node node, final int width, final int height,
+                      final Map<NativeUiScene.Node, Float> scroll) {
+        return this.layout(node, width, height, scroll, _ -> null);
+    }
+
+    public Box layout(final NativeUiScene.Node node, final int width, final int height,
+                      final Map<NativeUiScene.Node, Float> scroll,
+                      final Function<NativeUiScene.Node, NativeUiCursorPlacement> placements) {
+        this.placements = placements;
+        this.work = 0;
+        final Rect viewport = new Rect(0, 0, width, height);
+        Set<NativeUiScene.Node> hidden = Collections.newSetFromMap(new IdentityHashMap<>());
+        final List<Set<NativeUiScene.Node>> states = new ArrayList<>();
+        while (true) {
+            this.measured.clear();
+            this.visibleNodes.clear();
+            this.windows.clear();
+            this.cursorOffsets.clear();
+            this.verticalLimit = LIMIT;
+            this.visibility(node, true, hidden);
+            final Size size = this.measure(node, width, height);
+            final Box result = this.place(node, viewport, size, 0, viewport, scroll, null);
+            // Native scrollbar callbacks change computed visibility and schedule layout again.
+            // Keep the declared dimensions intact so resize and content refresh can restore them.
+            final Set<NativeUiScene.Node> next = Collections.newSetFromMap(new IdentityHashMap<>());
+            this.scrollVisibility(result, next);
+            if (sameNodes(hidden, next)) return this.cursorOffsets.isEmpty() ? result
+                : this.positionCursors(result, viewport, viewport, new IdentityHashMap<>());
+            if (states.stream().anyMatch(state -> sameNodes(state, next))) {
+                throw new IllegalArgumentException("Native UI scrollbar layout does not settle");
+            }
+            states.add(hidden);
+            hidden = next;
+        }
+    }
+
+    private static boolean sameNodes(final Set<NativeUiScene.Node> first, final Set<NativeUiScene.Node> second) {
+        return first.size() == second.size() && first.stream().allMatch(second::contains);
+    }
+
+    private void scrollVisibility(final Box box, final Set<NativeUiScene.Node> hidden) {
+        if (!this.visibleNodes.getOrDefault(box.node, true)) return;
+        if (box.node.scroll() && !box.node.flag("scrollbar_always_visible", false) && NativeUiScroll.maximum(box) == 0) {
+            final Box panel = NativeUiScroll.descendant(box, box.node.string("scroll_box_and_track_panel", ""));
+            if (panel != null && List.of("scroll_content", "scroll_view_port", "scrollbar_track", "scrollbar_box").stream()
+                    .allMatch(property -> NativeUiScroll.descendant(box, box.node.string(property, "")) != null)) {
+                hidden.add(panel.node);
+            }
+        }
+        for (final var child : box.children) this.scrollVisibility(child, hidden);
+    }
+
+    private void visibility(final NativeUiScene.Node node, final boolean inherited, final Set<NativeUiScene.Node> hidden) {
+        final boolean visible = inherited && node.flag("visible", true) && !node.flag("ignored", false) && !hidden.contains(node);
+        this.visibleNodes.put(node, visible);
+        final var window = NativeUiCollectionWindow.from(node);
+        if (window != null) {
+            this.windows.put(node, window);
+            this.verticalLimit += window.size() * window.cellHeight();
+        }
+        for (final var child : node.children()) this.visibility(child, visible, hidden);
+    }
+
+    private Size measure(final NativeUiScene.Node node, final float parentWidth, final float parentHeight) {
+        return this.measure(node, new Measurement(parentWidth, parentHeight, 0, 0, parentWidth, parentHeight));
+    }
+
+    private Size measure(final NativeUiScene.Node node, final Measurement environment) {
+        // The native visibility setter resets computed size metrics without changing authored dimensions.
+        if (!this.visibleNodes.getOrDefault(node, true)) return EMPTY;
+        final Map<Measurement, Size> cache = this.measured.computeIfAbsent(node, _ -> new HashMap<>());
+        final Size previous = cache.get(environment);
+        if (previous != null) return previous;
+        if (++this.work > 65536) throw new IllegalArgumentException("Native UI layout exceeds work limits");
+        final boolean container = switch (node.type()) {
+            case "screen", "panel", "input_panel", "factory", "collection_panel", "scroll_view", "scroll_track", "scrollbar_box", "button", "toggle" -> true;
+            default -> false;
+        };
+        final boolean inventoryButton = node.type().equals("button") && node.properties().has("inventory_actions");
+        final boolean image = node.type().equals("image");
+        final boolean ratioSize = image && node.flag("default_size_scales_to_ratio", false);
+        final Size intrinsic = container || inventoryButton || image && !ratioSize
+            ? new Size(environment.defaultWidth, environment.defaultHeight) : this.metrics.intrinsic(node);
+        final boolean defaultWidthAxis = defaultSize(node, 0);
+        final boolean defaultHeightAxis = defaultSize(node, 1);
+        float width = intrinsic.width, height = intrinsic.height;
+        for (int pass = 0; pass < 3; pass++) {
+            final float previousWidth = width, previousHeight = height;
+            // Resolve dimensions independent of children before descending. Measuring at the
+            // inherited extent first multiplies speculative passes through nested content panels.
+            if (!defaultWidthAxis && !childDimension(node, 0)) {
+                width = dimension(node, "size", 0, environment, width, height, 0, 0, intrinsic.width);
+                width = constrain(node, 0, width, environment, width, height, 0, 0);
+            }
+            if (!defaultHeightAxis && !childDimension(node, 1)) {
+                height = dimension(node, "size", 1, environment, width, height, 0, 0, intrinsic.height);
+                height = constrain(node, 1, height, environment, width, height, 0, 0);
+            }
+            final List<Size> children = this.children(node, width, height);
+            final Size content = this.content(node, children, width, height);
+            final float maximumWidth = children.stream().map(Size::width).max(Float::compare).orElse(0F);
+            final float maximumHeight = children.stream().map(Size::height).max(Float::compare).orElse(0F);
+            final boolean stack = node.type().equals("stack_panel");
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final float defaultWidth = ratioSize && defaultWidthAxis && !defaultHeightAxis && intrinsic.height > 0
+                ? height * intrinsic.width / intrinsic.height
+                : stack ? vertical ? environment.width : content.width : intrinsic.width;
+            width = dimension(node, "size", 0, environment, width, height, content.width, maximumWidth, defaultWidth);
+            width = constrain(node, 0, width, environment, width, height, content.width, maximumWidth);
+            final float intrinsicHeight = container || inventoryButton || stack || image ? intrinsic.height : this.metrics.constrained(node, width).height;
+            final float defaultHeight = ratioSize && defaultHeightAxis && !defaultWidthAxis && intrinsic.width > 0
+                ? width * intrinsic.height / intrinsic.width
+                : stack ? vertical ? content.height : environment.height
+                : node.type().equals("grid") && !node.string("grid_item_template", "").isEmpty() ? content.height : intrinsicHeight;
+            height = dimension(node, "size", 1, environment, width, height, content.height, maximumHeight, defaultHeight);
+            height = constrain(node, 1, height, environment, width, height, content.height, maximumHeight);
+            if (width == previousWidth && height == previousHeight) break;
+        }
+        final Size result = new Size(width, height);
+        cache.put(environment, result);
+        return result;
+    }
+
+    private boolean childDimension(final NativeUiScene.Node node, final int axis) {
+        for (final String key : List.of("size", "min_size", "max_size")) {
+            final var value = this.dimensionValue(node, key, axis);
+            if (value != null && (value.uses(NativeUiDimension.Unit.CHILDREN) || value.uses(NativeUiDimension.Unit.MAX_CHILD))) return true;
+        }
+        return false;
+    }
+
+    private boolean defaultSize(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size == null || size.uses(NativeUiDimension.Unit.DEFAULT);
+    }
+
+    private List<Size> children(final NativeUiScene.Node node, final float width, final float height) {
+        // Collection percentages use the complete grid, while default dimensions
+        // inherit a single cell. Nested controls then inherit that measured cell.
+        final float availableWidth = width;
+        final float availableHeight = height;
+        final List<Size> result = new ArrayList<>();
+        final Grid collection = node.type().equals("grid") && !node.string("grid_item_template", "").isEmpty()
+            ? this.grid(node, width, height) : null;
+        final float defaultWidth = collection == null ? width : width / collection.columns;
+        final float defaultHeight = collection == null ? height : height / collection.rows;
+        for (final var child : node.children())
+            result.add(this.measure(child, new Measurement(availableWidth, availableHeight, 0, 0, defaultWidth, defaultHeight)));
+        for (int i = 0; i < result.size(); i++) {
+            final var child = node.children().get(i);
+            if (!siblingDimension(child)) continue;
+            float siblingWidth = 0, siblingHeight = 0;
+            for (int other = 0; other < result.size(); other++) if (other != i) {
+                siblingWidth = Math.max(siblingWidth, result.get(other).width);
+                siblingHeight = Math.max(siblingHeight, result.get(other).height);
+            }
+            result.set(i, this.measure(child, new Measurement(availableWidth, availableHeight, siblingWidth, siblingHeight, defaultWidth, defaultHeight)));
+        }
+        if (node.type().equals("stack_panel")) {
+            final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+            final int axis = vertical ? 1 : 0;
+            float used = 0;
+            int fills = 0;
+            for (int i = 0; i < result.size(); i++) {
+                if (!this.visibleNodes.getOrDefault(node.children().get(i), true)) continue;
+                if (fill(node.children().get(i), axis)) fills++;
+                else used += vertical ? result.get(i).height : result.get(i).width;
+            }
+            if (fills > 0) {
+                final float remainder = Math.max(0, (vertical ? height : width) - used) / fills;
+                for (int i = 0; i < result.size(); i++) {
+                    final var child = node.children().get(i);
+                    if (!this.visibleNodes.getOrDefault(child, true) || !fill(child, axis)) continue;
+                    float siblingWidth = 0, siblingHeight = 0;
+                    if (siblingDimension(child)) for (int other = 0; other < result.size(); other++) if (other != i) {
+                        siblingWidth = Math.max(siblingWidth, result.get(other).width);
+                        siblingHeight = Math.max(siblingHeight, result.get(other).height);
+                    }
+                    final float fillWidth = vertical ? availableWidth : remainder;
+                    final float fillHeight = vertical ? remainder : availableHeight;
+                    result.set(i, this.measure(child, new Measurement(fillWidth, fillHeight,
+                        siblingWidth, siblingHeight, fillWidth, fillHeight)));
+                }
+            }
+        }
+        return result;
+    }
+
+    private boolean fill(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size != null && size.uses(NativeUiDimension.Unit.FILL);
+    }
+
+    private boolean siblingDimension(final NativeUiScene.Node node) {
+        for (final String key : List.of("size", "min_size", "max_size")) for (int axis = 0; axis < 2; axis++) {
+            final var value = this.dimensionValue(node, key, axis);
+            if (value != null && value.uses(NativeUiDimension.Unit.SIBLING)) return true;
+        }
+        return false;
+    }
+
+    private Size content(final NativeUiScene.Node node, final List<Size> children, final float parentWidth, final float parentHeight) {
+        float width = 0, height = 0;
+        final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+        if (node.type().equals("grid")) {
+            final Grid grid = this.grid(node, parentWidth, parentHeight);
+            final var window = this.windows.get(node);
+            if (window != null) {
+                for (final var child : children)
+                    if (child.width != window.cellWidth() || child.height != window.cellHeight())
+                        throw new IllegalArgumentException("Native collection cell geometry changed");
+                return new Size(grid.columns * window.cellWidth(), grid.rows * window.cellHeight());
+            }
+            final Map<Integer, Float> widths = new HashMap<>();
+            final Map<Integer, Float> heights = new HashMap<>();
+            for (int i = 0; i < children.size(); i++) {
+                final int[] position = grid.position(node.children().get(i), i);
+                final int column = position[0], row = position[1];
+                widths.merge(column, children.get(i).width, Math::max);
+                heights.merge(row, children.get(i).height, Math::max);
+            }
+            for (final float value : widths.values()) width += value;
+            for (final float value : heights.values()) height += value;
+        } else for (final Size child : children) {
+            if (node.type().equals("stack_panel") && !vertical) width += child.width;
+            else width = Math.max(width, child.width);
+            if (node.type().equals("stack_panel") && vertical) height += child.height;
+            else height = Math.max(height, child.height);
+        }
+        return new Size(width, height);
+    }
+
+    private Box place(final NativeUiScene.Node node, final Rect parent, final Size size, final float parentLayer,
+                      final Rect parentClip, final Map<NativeUiScene.Node, Float> scroll, final NativeUiScene.Node container) {
+        if (!this.visibleNodes.getOrDefault(node, true)) {
+            final Rect bounds = new Rect(parent.x, parent.y, 0, 0);
+            return new Box(node, bounds, parentClip, EMPTY, bounds, parentLayer,
+                node.children().stream().map(child -> this.place(child, bounds, EMPTY, parentLayer, parentClip, scroll, node)).toList());
+        }
+        final String defaultAnchor = container != null && container.type().equals("grid")
+                && container.string("grid_item_template", "").isEmpty() ? "top_left" : "center";
+        final float[] from = anchor(node.string("anchor_from", defaultAnchor));
+        final float[] to = anchor(node.string("anchor_to", defaultAnchor));
+        // Stack panels own child positions and only apply anchors when explicitly enabled.
+        final boolean stacked = container != null && container.type().equals("stack_panel");
+        final boolean anchored = !stacked || container.flag("use_child_anchors", false);
+        final float offsetX = stacked ? 0 : offset(node, 0, parent.width, size);
+        final float offsetY = stacked ? 0 : offset(node, 1, parent.height, size);
+        final float x = parent.x + (anchored ? parent.width * from[0] - size.width * to[0] : 0) + offsetX;
+        final float y = parent.y + (anchored ? parent.height * from[1] - size.height * to[1] : 0) + offsetY;
+        final NativeUiCursorPlacement placement = this.placements.apply(node);
+        if (placement != null) this.cursorOffsets.put(node, new CursorOffset(placement, offsetX, offsetY));
+        final Rect bounds = new Rect(x, y, size.width, size.height);
+        final Rect clip = node.scroll() || node.flag("clips_children", false) ? parentClip.intersect(bounds) : parentClip;
+        final List<Size> sizes = this.children(node, size.width, size.height);
+        Size content = this.content(node, sizes, size.width, size.height);
+        final String contentName = node.string("scroll_content", "");
+        final boolean horizontalScroll = node.string("scroll_direction", "vertical").equals("horizontal");
+        final float scrollAmount = node.scroll() && contentName.isEmpty()
+            ? Math.clamp(scroll.getOrDefault(node, 0F), 0, Math.max(0,
+                horizontalScroll ? content.width - size.width : content.height - size.height)) : 0;
+        final float scrollX = horizontalScroll ? scrollAmount : 0, scrollY = horizontalScroll ? 0 : scrollAmount;
+        final float layer = parentLayer + node.number("layer", 0);
+        final List<Box> children = new ArrayList<>();
+        final boolean vertical = !node.string("orientation", "vertical").equals("horizontal");
+        final Grid grid = this.grid(node, size.width, size.height);
+        final float cellWidth = size.width / grid.columns;
+        final float cellHeight = contentDimension(node, 1) ? content.height / grid.rows : size.height / grid.rows;
+        float cursor = 0;
+        for (int i = 0; i < node.children().size(); i++) {
+            final NativeUiScene.Node child = node.children().get(i);
+            final Size childSize = sizes.get(i);
+            final Rect childParent;
+            if (node.type().equals("stack_panel")) {
+                childParent = vertical ? new Rect(x - scrollX, y + cursor - scrollY, size.width, childSize.height)
+                    : new Rect(x + cursor - scrollX, y - scrollY, childSize.width, size.height);
+                if (this.visibleNodes.getOrDefault(child, true)) cursor += vertical ? childSize.height : childSize.width;
+            } else if (node.type().equals("grid")) {
+                final int[] position = grid.position(child, i);
+                childParent = new Rect(x + position[0] * cellWidth - scrollX, y + position[1] * cellHeight - scrollY,
+                    grid.manual ? size.width : cellWidth, grid.manual ? size.height : cellHeight);
+            } else childParent = new Rect(x - scrollX, y - scrollY, size.width, size.height);
+            children.add(this.place(child, childParent, childSize, layer, clip, scroll, node));
+        }
+        Rect viewport = bounds;
+        if (node.scroll() && !contentName.isEmpty()) {
+            final Box contentBox = descendant(children, contentName);
+            final Box viewportBox = descendant(children, node.string("scroll_view_port", ""));
+            if (contentBox != null) {
+                viewport = viewportBox == null ? bounds : viewportBox.bounds;
+                content = new Size(Math.max(contentBox.bounds.width, contentBox.content.width),
+                    Math.max(contentBox.bounds.height, contentBox.content.height));
+                final Box thumb = descendant(children, node.string("scrollbar_box", ""));
+                final boolean horizontal = thumb != null && thumb.node.string("draggable", "vertical").equals("horizontal");
+                final float amount = Math.clamp(scroll.getOrDefault(node, 0F), 0, Math.max(0,
+                    horizontal ? content.width - viewport.width : content.height - viewport.height));
+                final Rect contentClip = clip.intersect(viewport);
+                for (int i = 0; i < children.size(); i++)
+                    children.set(i, scrollContent(children.get(i), contentBox.node, horizontal ? -amount : 0, horizontal ? 0 : -amount, contentClip));
+            }
+        }
+        Box result = new Box(node, bounds, clip, content, viewport, layer, List.copyOf(children));
+        if (node.scroll()) {
+            final var model = NativeUiScroll.model(result, scroll.getOrDefault(node, 0F));
+            if (model != null) result = replace(result, model.originalThumb().node,
+                this.resize(model.originalThumb(), model.thumb(), scroll));
+        }
+        return result;
+    }
+
+    private Box positionCursors(Box box, final Rect parent, Rect inheritedClip,
+                                final Map<NativeUiScene.Node, Rect> contentClips) {
+        final Rect contentClip = contentClips.get(box.node);
+        if (contentClip != null) inheritedClip = inheritedClip.intersect(contentClip);
+        final CursorOffset cursor = this.cursorOffsets.get(box.node);
+        if (cursor != null) {
+            final Size offset = cursor.placement.offset(box.node, box.bounds, parent, cursor.x, cursor.y);
+            if (offset != null) box = translated(box, offset.width - cursor.x, offset.height - cursor.y, inheritedClip);
+        }
+        final Rect bounds = box.bounds;
+        final Rect clip = box.node.scroll() || box.node.flag("clips_children", false) ? inheritedClip.intersect(bounds) : inheritedClip;
+        if (box.node.scroll()) {
+            final Box content = descendant(box.children, box.node.string("scroll_content", ""));
+            if (content != null) contentClips.put(content.node, clip.intersect(box.scrollViewport));
+        }
+        // Native requests use the actual parent control after layout, not a grid's
+        // virtual cell or the unscrolled child origin.
+        final List<Box> children = new ArrayList<>();
+        for (final Box child : box.children) children.add(this.positionCursors(child, bounds, clip, contentClips));
+        return new Box(box.node, bounds, clip, box.content, box.scrollViewport, box.layer, List.copyOf(children));
+    }
+
+    private record CursorOffset(NativeUiCursorPlacement placement, float x, float y) {}
+
+    private Box resize(final Box box, final Rect bounds, final Map<NativeUiScene.Node, Float> scroll) {
+        final List<Size> sizes = this.children(box.node, bounds.width, bounds.height);
+        final List<Box> children = new ArrayList<>();
+        for (int i = 0; i < sizes.size(); i++)
+            children.add(this.place(box.node.children().get(i), bounds, sizes.get(i), box.layer, box.clip, scroll, box.node));
+        return new Box(box.node, bounds, box.clip, this.content(box.node, sizes, bounds.width, bounds.height),
+            bounds, box.layer, List.copyOf(children));
+    }
+
+    private static Box replace(final Box box, final NativeUiScene.Node target, final Box replacement) {
+        if (box.node == target) return replacement;
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> replace(child, target, replacement)).toList());
+    }
+
+    private static Box descendant(final List<Box> children, final String name) {
+        if (name.isEmpty()) return null;
+        for (final Box child : children) {
+            if (child.node.name().equals(name)) return child;
+            final Box nested = descendant(child.children, name);
+            if (nested != null) return nested;
+        }
+        return null;
+    }
+
+    private static Box scrollContent(final Box box, final NativeUiScene.Node content, final float x, final float y, final Rect clip) {
+        if (box.node == content) return translated(box, x, y, clip);
+        return new Box(box.node, box.bounds, box.clip, box.content, box.scrollViewport, box.layer,
+            box.children.stream().map(child -> scrollContent(child, content, x, y, clip)).toList());
+    }
+
+    private static Box translated(final Box box, final float x, final float y, final Rect parentClip) {
+        final Rect bounds = new Rect(box.bounds.x + x, box.bounds.y + y, box.bounds.width, box.bounds.height);
+        final Rect clip = box.node.scroll() || box.node.flag("clips_children", false) ? parentClip.intersect(bounds) : parentClip;
+        final Rect viewport = new Rect(box.scrollViewport.x + x, box.scrollViewport.y + y, box.scrollViewport.width, box.scrollViewport.height);
+        return new Box(box.node, bounds, clip, box.content, viewport, box.layer,
+            box.children.stream().map(child -> translated(child, x, y, clip)).toList());
+    }
+
+    private float constrain(final NativeUiScene.Node node, final int axis, final float size,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum) {
+        final float minimum = dimension(node, "min_size", axis, environment, width, height, content, maximum, 0);
+        final float limit = axis == 1 ? this.verticalLimit : LIMIT;
+        final float declaredUpper = dimension(node, "max_size", axis, environment, width, height, content, maximum, limit);
+        final float upper = declaredUpper == 0 ? limit : declaredUpper;
+        return Math.clamp(size, Math.min(minimum, upper), upper);
+    }
+
+    private float dimension(final NativeUiScene.Node node, final String key, final int axis,
+                                   final Measurement environment, final float width, final float height,
+                                   final float content, final float maximum, final float fallback) {
+        final NativeUiDimension dimension = this.dimensionValue(node, key, axis);
+        final float limit = axis == 1 ? this.verticalLimit : LIMIT;
+        if (dimension == null) {
+            if (!Float.isFinite(fallback) || Math.abs(fallback) > limit)
+                throw new IllegalArgumentException("Native UI dimension exceeds layout limits");
+            return Math.max(0, fallback);
+        }
+        final float parent = axis == 0 ? environment.width : environment.height;
+        final float sibling = axis == 0 ? environment.siblingWidth : environment.siblingHeight;
+        try {
+            final float value = dimension.resolve(parent, content, maximum, width, height, sibling, fallback);
+            // A loose maximum does not request geometry beyond our supported layout range.
+            final float bounded = key.equals("max_size") ? Math.min(value, limit) : value;
+            if (!Float.isFinite(bounded) || Math.abs(bounded) > limit)
+                throw new IllegalArgumentException("Native UI dimension exceeds layout limits");
+            return Math.max(0, bounded);
+        } catch (final IllegalArgumentException error) {
+            throw new IllegalArgumentException("Invalid native UI dimension: " + node.name() + "." + key + "[" + axis + "]", error);
+        }
+    }
+
+    public static float dimension(final JsonElement value, final float parent, final float content, final float maximum) {
+        return dimension(value, parent, content, maximum, parent, parent, maximum, 0);
+    }
+
+    private static float dimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                   final float width, final float height, final float sibling, final float fallback) {
+        return bounded(evaluatedDimension(value, parent, content, maximum, width, height, sibling, fallback));
+    }
+
+    private static float evaluatedDimension(final JsonElement value, final float parent, final float content, final float maximum,
+                                         final float width, final float height, final float sibling, final float fallback) {
+        return NativeUiDimension.parse(value).resolve(parent, content, maximum, width, height, sibling, fallback);
+    }
+
+    private float offset(final NativeUiScene.Node node, final int axis, final float parent, final Size size) {
+        final var dimension = this.dimensionValue(node, "offset", axis);
+        return dimension == null ? 0 : signed(dimension.resolve(parent, 0, 0, size.width, size.height, 0, 0));
+    }
+
+    private boolean contentDimension(final NativeUiScene.Node node, final int axis) {
+        final var size = this.dimensionValue(node, "size", axis);
+        return size != null && (size.uses(NativeUiDimension.Unit.CHILDREN) || size.uses(NativeUiDimension.Unit.MAX_CHILD));
+    }
+
+    public static float vector(final NativeUiScene.Node node, final String key, final int axis, final float fallback) {
+        final JsonElement value = node.properties().get(key);
+        if (value == null || !value.isJsonArray() || value.getAsJsonArray().size() <= axis) return fallback;
+        final float result = value.getAsJsonArray().get(axis).getAsFloat();
+        if (!Float.isFinite(result) || Math.abs(result) > LIMIT) throw new IllegalArgumentException("Invalid native UI vector");
+        return result;
+    }
+
+    private static float bounded(final float value) {
+        return Math.max(0, signed(value));
+    }
+
+    private static float signed(final float value) {
+        if (!Float.isFinite(value) || Math.abs(value) > LIMIT) throw new IllegalArgumentException("Native UI dimension exceeds layout limits");
+        return value;
+    }
+
+    private Grid grid(final NativeUiScene.Node node, final float width, final float height) {
+        if (!node.type().equals("grid")) return new Grid(1, 1, true, false, false, false);
+        final boolean horizontal = !node.string("grid_fill_direction", "horizontal").equals("vertical");
+        final var window = this.windows.get(node);
+        final int count = window == null ? node.children().size() : window.size();
+        if (count > 8192) throw new IllegalArgumentException("Native grid exceeds child limits");
+        final boolean explicit = node.properties().has("grid_dimensions");
+        final String rescaling = node.string("grid_rescaling_type", "none");
+        final boolean manual = node.string("grid_item_template", "").isEmpty();
+        int columns = gridCapacity(node, 0, manual);
+        int rows = gridCapacity(node, 1, manual);
+        if (manual && (columns == 0 || rows == 0))
+            throw new IllegalArgumentException("Unsupported zero-capacity manual native grid");
+        final boolean rescaled = !explicit && !manual && (rescaling.equals("horizontal") || rescaling.equals("vertical"));
+        if (manual) {
+            for (final var child : node.children()) {
+                final int[] position = gridPosition(child);
+                try {
+                    Math.addExact(Math.multiplyExact(columns, position[1]), position[0]);
+                } catch (final ArithmeticException error) {
+                    throw new IllegalArgumentException("Native grid index exceeds its range", error);
+                }
+            }
+        }
+        if (rescaled) {
+            float cellWidth = 0, cellHeight = 0;
+            for (final var child : node.children()) {
+                final Size size = this.measure(child, width, height);
+                cellWidth = Math.max(cellWidth, size.width);
+                cellHeight = Math.max(cellHeight, size.height);
+            }
+            // Percentage sizing can round an exact capacity down by one float ULP.
+            if (rescaling.equals("horizontal")) {
+                columns = cellWidth > 0 ? Math.clamp((int) Math.floor(Math.nextUp(width / cellWidth)), 1, 128) : 1;
+                rows = Math.max(1, (int) Math.ceilDiv((long) count, columns));
+            } else {
+                rows = cellHeight > 0 ? Math.clamp((int) Math.floor(Math.nextUp(height / cellHeight)), 1, 4096) : 1;
+                columns = Math.max(1, (int) Math.ceilDiv((long) count, rows));
+            }
+        }
+        if (!manual) {
+            if (horizontal) rows = Math.max(rows, (int) Math.ceilDiv((long) count, columns));
+            else columns = Math.max(columns, (int) Math.ceilDiv((long) count, rows));
+        }
+        return new Grid(columns, rows, horizontal, rescaled, manual, window != null);
+    }
+
+    private static int gridCapacity(final NativeUiScene.Node node, final int axis, final boolean manual) {
+        final JsonElement value = node.properties().get("grid_dimensions");
+        if (value == null) return manual ? 0 : 1;
+        if (!value.isJsonArray() || value.getAsJsonArray().size() != 2)
+            throw new IllegalArgumentException("Invalid native grid capacity");
+        final JsonElement count = value.getAsJsonArray().get(axis);
+        if (!count.isJsonPrimitive() || !count.getAsJsonPrimitive().isNumber())
+            throw new IllegalArgumentException("Invalid native grid capacity");
+        try {
+            final int capacity = count.getAsBigDecimal().intValueExact();
+            if (capacity < 0) throw new IllegalArgumentException("Invalid native grid capacity");
+            return manual ? capacity : Math.max(1, capacity);
+        } catch (final ArithmeticException error) {
+            throw new IllegalArgumentException("Invalid native grid capacity", error);
+        }
+    }
+
+    private static int[] gridPosition(final NativeUiScene.Node node) {
+        final JsonElement value = node.properties().get("grid_position");
+        if (value == null) return new int[]{0, 0};
+        if (!value.isJsonArray() || value.getAsJsonArray().size() != 2)
+            throw new IllegalArgumentException("Invalid native grid position");
+        final int[] position = new int[2];
+        for (int axis = 0; axis < position.length; axis++) {
+            final JsonElement coordinate = value.getAsJsonArray().get(axis);
+            if (!coordinate.isJsonPrimitive() || !coordinate.getAsJsonPrimitive().isNumber())
+                throw new IllegalArgumentException("Invalid native grid position");
+            try {
+                position[axis] = coordinate.getAsBigDecimal().intValueExact();
+            } catch (final ArithmeticException error) {
+                throw new IllegalArgumentException("Invalid native grid position", error);
+            }
+            if (position[axis] < 0) throw new IllegalArgumentException("Invalid native grid position");
+        }
+        return position;
+    }
+
+    private record Grid(int columns, int rows, boolean horizontal, boolean rescaled, boolean manual, boolean windowed) {
+        int[] position(final NativeUiScene.Node node, final int index) {
+            if (this.manual) return gridPosition(node);
+            final int original = this.windowed ? node.properties().get("collection_index").getAsInt() : index;
+            return this.horizontal ? new int[]{original % this.columns, original / this.columns}
+                : new int[]{original / this.rows, original % this.rows};
+        }
+    }
+
+    private static float[] anchor(final String name) {
+        return switch (name) {
+            case "top_left" -> new float[]{0, 0};
+            case "top_middle" -> new float[]{.5F, 0};
+            case "top_right" -> new float[]{1, 0};
+            case "left_middle" -> new float[]{0, .5F};
+            case "center" -> new float[]{.5F, .5F};
+            case "right_middle" -> new float[]{1, .5F};
+            case "bottom_left" -> new float[]{0, 1};
+            case "bottom_middle" -> new float[]{.5F, 1};
+            case "bottom_right" -> new float[]{1, 1};
+            default -> throw new IllegalArgumentException("Unsupported native UI anchor");
+        };
+    }
+
+    public interface Metrics {
+        Size intrinsic(NativeUiScene.Node node);
+
+        default Size constrained(final NativeUiScene.Node node, final float width) {
+            return this.intrinsic(node);
+        }
+    }
+
+    private record Measurement(float width, float height, float siblingWidth, float siblingHeight, float defaultWidth, float defaultHeight) {}
+
+    public record Size(float width, float height) {}
+    public record Box(NativeUiScene.Node node, Rect bounds, Rect clip, Size content, Rect scrollViewport, float layer, List<Box> children) {
+        public Rect visibleBounds() {
+            return this.bounds.intersect(this.clip);
+        }
+    }
+
+    public record Rect(float x, float y, float width, float height) {
+        public Rect intersect(final Rect other) {
+            final float left = Math.max(this.x, other.x), top = Math.max(this.y, other.y);
+            return new Rect(left, top, Math.max(0, Math.min(this.x + this.width, other.x + other.width) - left),
+                Math.max(0, Math.min(this.y + this.height, other.y + other.height) - top));
+        }
+
+        public boolean contains(final double x, final double y) {
+            return x >= this.x && y >= this.y && x < this.x + this.width && y < this.y + this.height;
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiMultilineInput.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiMultilineInput.java
