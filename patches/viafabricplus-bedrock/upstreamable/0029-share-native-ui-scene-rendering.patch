+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import java.util.Objects;
+import java.util.UUID;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeUiHurtEvent;
+import net.raphimc.viabedrock.api.model.NativeUiHurtState;
+
+/** The native pending check belongs to the current player, including while no screen can close. */
+public final class BedrockNativeUiHurt {
+    private static final NativeUiHurtState STATE = new NativeUiHurtState();
+    private static Connection owner;
+    private static UUID lifetime;
+
+    private BedrockNativeUiHurt() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativeUiHurtPayload.TYPE, NativeUiHurtPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(NativeUiHurtPayload.TYPE, (payload, context) ->
+                client.execute(() -> apply(listener.getConnection(), payload.event(), client))));
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> {
+            if (listener.getConnection() == owner) {
+                STATE.clear();
+                owner = null;
+                lifetime = null;
+            }
+        });
+        ClientTickEvents.START_CLIENT_TICK.register(BedrockNativeUiHurt::tick);
+    }
+
+    private static void synchronize(final Minecraft client) {
+        final var listener = client.getConnection();
+        final Connection current = listener == null || client.level == null || client.player == null
+            || !listener.getConnection().isConnected() ? null : listener.getConnection();
+        final UUID currentLifetime = current == null ? null : BedrockActorState.lifetime(client.player.getUUID());
+        if (current != owner || !Objects.equals(currentLifetime, lifetime)) {
+            STATE.clear();
+            owner = current;
+            lifetime = currentLifetime;
+        }
+    }
+
+    static void apply(final Connection expected, final NativeUiHurtEvent event, final Minecraft client) {
+        synchronize(client);
+        if (expected == owner && event.lifetime().equals(lifetime)) STATE.accept(event);
+    }
+
+    static void tick(final Minecraft client) {
+        synchronize(client);
+        if (owner == null || lifetime == null) return;
+        final var screen = client.gui.screen();
+        final boolean policy = screen instanceof NativeUiScreen nativeScreen && nativeScreen.closeOnPlayerHurt();
+        if (STATE.tick(policy) && client.gui.screen() == screen) screen.onClose();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeHudOverlayState.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeHudOverlayState.java
