+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/** Routes captured releases before the current control order and retires skipped mapping phases. */
+public final class NativeUiInputRouter<K> {
+    private final Map<Integer, List<K>> captures = new HashMap<>();
+
+    public Result<K> dispatch(final int source, final int phase, final List<Control<K>> controls) {
+        final Map<K, Control<K>> indexed = new LinkedHashMap<>();
+        for (final var control : controls) indexed.put(control.key, control);
+        final List<Event<K>> events = new ArrayList<>();
+        boolean consumed = false;
+        final var captured = phase != 0 ? this.captures.get(source) : this.captures.remove(source);
+        if (phase == 0 && captured != null) {
+            for (final K key : captured) {
+                final var control = indexed.get(key);
+                if (control == null) continue;
+                final var result = control.state.dispatch(source, 0, control.context.get(), control.handler);
+                for (final var event : result.events()) {
+                    events.add(new Event<>(key, event));
+                }
+                consumed = result.result() == 1;
+                if (consumed) break;
+            }
+        }
+        final List<K> requested = new ArrayList<>(phase != 0 && captured != null ? captured : List.of());
+        for (final var control : controls) {
+            if (!control.registered) continue;
+            if (consumed) {
+                control.state.suppress(source, phase, control.context.get());
+                continue;
+            }
+            final var result = control.state.dispatch(source, phase, control.context.get(), control.handler);
+            for (final var event : result.events()) {
+                events.add(new Event<>(control.key, event));
+            }
+            for (final int capture : result.captureRequests()) {
+                if (capture != source) throw new IllegalStateException("Native capture changed its source input");
+                requested.add(control.key);
+            }
+            consumed = result.result() == 1;
+        }
+        if (!requested.isEmpty()) this.captures.put(source, List.copyOf(requested));
+        return new Result<>(consumed, List.copyOf(events));
+    }
+
+    public void retain(final Set<K> controls) {
+        this.captures.replaceAll((source, captured) -> captured.stream().filter(controls::contains).toList());
+        this.captures.values().removeIf(List::isEmpty);
+    }
+
+    public boolean captures(final int source) { return this.captures.containsKey(source); }
+
+    /** Captured controls remain addressable after they leave the normal input order. */
+    public record Control<K>(K key, NativeUiInput.State state, Supplier<NativeUiInput.Context> context,
+                             Consumer<NativeUiInput.ButtonEvent> handler, boolean registered) {}
+    public record Event<K>(K key, NativeUiInput.ButtonEvent button) {}
+    public record Result<K>(boolean consumed, List<Event<K>> events) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiJpegTexture.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiJpegTexture.java
