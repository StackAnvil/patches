+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import com.mojang.blaze3d.systems.RenderSystem;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.List;
+import javax.imageio.ImageIO;
+import javax.imageio.ImageReader;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import org.junit.jupiter.api.Test;
+
+final class NativeUiJpegTextureTest {
+    @Test
+    void jpegPixelsMatchThePreviousPngTransportWithoutAnotherLossyEncoding() throws Exception {
+        final byte[] jpeg = jpeg(0xBD3716);
+        final var previous = ImageIO.read(new ByteArrayInputStream(new Content.LazyImage(jpeg, "jpg").getPngBytes()));
+        final var decoded = NativeUiJpegTexture.decode(new ByteArrayInputStream(jpeg));
+        try (final var pixels = NativeUiJpegTexture.pixels(decoded)) {
+            assertEquals(previous.getWidth(), pixels.getWidth());
+            assertEquals(previous.getHeight(), pixels.getHeight());
+            assertArrayEquals(previous.getRGB(0, 0, 3, 2, null, 0, 3), pixels.getPixels());
+        }
+    }
+
+    @Test
+    void resourceReloadReadsTheCurrentImageInsteadOfRetainingPreparedPixels() throws Exception {
+        final var id = Identifier.parse("viabedrock:textures/server_ui/reload.jpg");
+        final var resources = mock(ResourceManager.class);
+        final var resource = mock(Resource.class);
+        when(resources.getResourceOrThrow(id)).thenReturn(resource);
+        when(resource.open()).thenAnswer(_ -> new ByteArrayInputStream(jpeg(0x16AB37)));
+        final var prepared = NativeUiJpegTexture.decode(new ByteArrayInputStream(jpeg(0xBD3716)));
+        try (final var render = mockStatic(RenderSystem.class, RETURNS_DEEP_STUBS);
+             final var texture = new NativeUiJpegTexture(id, prepared)) {
+            try (final var initial = texture.loadContents(resources)) {
+                assertArrayEquals(prepared.getRGB(0, 0, 3, 2, null, 0, 3), initial.image().getPixels());
+            }
+            verifyNoInteractions(resources);
+            final var replacement = ImageIO.read(new ByteArrayInputStream(jpeg(0x16AB37)));
+            try (final var reloaded = texture.loadContents(resources)) {
+                assertArrayEquals(replacement.getRGB(0, 0, 3, 2, null, 0, 3), reloaded.image().getPixels());
+                assertFalse(reloaded.blur());
+                assertFalse(reloaded.clamp());
+            }
+            verify(resource).open();
+        }
+    }
+
+    @Test
+    void oversizedHeadersAreRejectedBeforeAllocatingDecodedPixels() throws Exception {
+        final var reader = mock(ImageReader.class);
+        when(reader.getWidth(0)).thenReturn(4097);
+        when(reader.getHeight(0)).thenReturn(4097);
+        try (final var images = mockStatic(ImageIO.class)) {
+            images.when(() -> ImageIO.getImageReaders(any())).thenAnswer(_ -> List.of(reader).iterator());
+            assertThrows(IOException.class, () -> NativeUiJpegTexture.decode(new ByteArrayInputStream(new byte[1])));
+            verify(reader, never()).read(0);
+            verify(reader).dispose();
+        }
+    }
+
+    private static byte[] jpeg(final int color) throws IOException {
+        final var image = new BufferedImage(3, 2, BufferedImage.TYPE_INT_RGB);
+        image.setRGB(0, 0, color);
+        image.setRGB(1, 1, 0xE59732);
+        final var bytes = new ByteArrayOutputStream();
+        assertTrue(ImageIO.write(image, "jpg", bytes));
+        return bytes.toByteArray();
+    }
+}
