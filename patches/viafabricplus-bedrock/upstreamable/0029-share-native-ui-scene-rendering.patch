+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiScrollbarLayoutTest {
+    @Test
+    void fittingScrollbarsReleaseTheirLayoutSpaceAtTheNativeBoundary() throws IOException {
+        try (final var stream = getClass().getResourceAsStream("/native-scrollbar-visibility.json")) {
+            assertNotNull(stream);
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var row = entry.getAsJsonObject();
+                final boolean horizontal = row.get("orientation").getAsInt() == 1;
+                final var scene = scene(scroll(horizontal, row.get("alwaysVisible").getAsBoolean(), row.get("contentExtent").getAsFloat()));
+                final int extent = row.get("viewportExtent").getAsInt();
+                final var box = solver().layout(scene.root(), extent, extent, Map.of());
+                final var panel = NativeUiScroll.descendant(box, "bar");
+                final var viewport = NativeUiScroll.descendant(box, "viewport");
+                final var expected = row.getAsJsonArray("panelSize");
+                assertEquals(expected.get(0).getAsFloat(), panel.bounds().width(), row.toString());
+                assertEquals(expected.get(1).getAsFloat(), panel.bounds().height(), row.toString());
+                final float reserved = row.get("panelVisible").getAsBoolean() ? 8 : 0;
+                assertEquals(extent - reserved, horizontal ? viewport.bounds().height() : viewport.bounds().width(), row.toString());
+            }
+        }
+    }
+
+    @Test
+    void resizeRestoresAuthoredScrollbarDimensionsWithoutChangingTheScene() {
+        final var scene = scene(scroll(false, false, 210));
+        final var solver = solver();
+        final var panelNode = scene.root().children().getFirst().children().get(1);
+        final var original = panelNode.properties().deepCopy();
+        for (final int height : new int[]{200, 210, 220, 200}) {
+            final var box = solver.layout(scene.root(), 210, height, Map.of());
+            final var panel = NativeUiScroll.descendant(box, "bar");
+            assertEquals(height < 210 ? 8 : 0, panel.bounds().width());
+            assertEquals(height < 210 ? 202 : 210, NativeUiScroll.descendant(box, "viewport").bounds().width());
+        }
+        assertEquals(original, panelNode.properties());
+    }
+
+    @Test
+    void identicalPanelNamesInOtherScrollViewsKeepTheirOwnVisibility() {
+        final var root = node("root", "panel", "fill", "fill", scroll(false, false, 100), scroll(false, false, 600));
+        final var box = solver().layout(scene(root).root(), 210, 210, Map.of());
+        assertEquals(0, NativeUiScroll.descendant(box.children().getFirst(), "bar").bounds().width());
+        assertEquals(8, NativeUiScroll.descendant(box.children().get(1), "bar").bounds().width());
+    }
+
+    private static NativeUiLayout solver() {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0));
+    }
+
+    private static NativeUiScene scene(final JsonObject root) {
+        final var scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        return NativeUiScene.parse(scene.toString(), Set.of());
+    }
+
+    private static JsonObject scroll(final boolean horizontal, final boolean always, final float extent) {
+        final var content = node("content", "panel", horizontal ? extent : "fill", horizontal ? "fill" : extent);
+        final var viewport = node("viewport", "panel", horizontal ? "fill" : "fill", horizontal ? "fill" : "fill", content);
+        final var thumb = node("thumb", "scrollbar_box", horizontal ? 16 : 8, horizontal ? 8 : 16);
+        thumb.addProperty("draggable", horizontal ? "horizontal" : "vertical");
+        final var track = node("track", "scroll_track", horizontal ? "fill" : 8, horizontal ? 8 : "fill", thumb);
+        final var panel = node("bar", "panel", horizontal ? "fill" : 8, horizontal ? 8 : "fill", track);
+        final var stack = node("stack", "stack_panel", "fill", "fill", viewport, panel);
+        stack.addProperty("orientation", horizontal ? "vertical" : "horizontal");
+        final var scroll = node("view", "scroll_view", "fill", "fill", stack);
+        scroll.addProperty("scroll_content", "content");
+        scroll.addProperty("scroll_view_port", "viewport");
+        scroll.addProperty("scrollbar_track", "track");
+        scroll.addProperty("scrollbar_box", "thumb");
+        scroll.addProperty("scroll_box_and_track_panel", "bar");
+        scroll.addProperty("scrollbar_always_visible", always);
+        return scroll;
+    }
+
+    private static JsonObject node(final String name, final String type, final Object width, final Object height, final JsonObject... children) {
+        final var node = new JsonObject();
+        node.addProperty("name", name);
+        node.addProperty("type", type);
+        node.addProperty("anchor_from", "top_left");
+        node.addProperty("anchor_to", "top_left");
+        final var size = new JsonArray();
+        for (final Object value : new Object[]{width, height}) {
+            if (value instanceof Number number) size.add(number);
+            else size.add(value.toString());
+        }
+        node.add("size", size);
+        final var nodes = new JsonArray();
+        for (final var child : children) nodes.add(child);
+        node.add("children", nodes);
+        return node;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiSliderTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiSliderTest.java
