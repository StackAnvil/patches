+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiPresentationTest {
+    @Test
+    void preservesAuthoredOrderForEqualCumulativeLayersAcrossNestedSubtrees() {
+        final var background = node("background", "image", true);
+        background.properties().addProperty("layer", 2);
+        final var icon = node("icon", "image", true);
+        icon.properties().addProperty("layer", -1);
+        final var content = node("content", "panel", true, icon);
+        content.properties().addProperty("layer", 3);
+        final var sizer = node("sizer", "panel", true, content);
+        for (final boolean reversed : new boolean[]{false, true}) {
+            final var root = node("root", "panel", true, reversed ? sizer : background, reversed ? background : sizer);
+            root.properties().addProperty("layer", 2);
+            final var box = layout(root);
+            assertSame(root.children().getFirst(), box.children().getFirst().node());
+            final var images = NativeUiPresentation.draws(box, _ -> false).stream()
+                    .filter(draw -> draw.box().node().type().equals("image")).toList();
+            assertEquals(4, images.getFirst().box().layer());
+            assertEquals(4, images.getLast().box().layer());
+            assertEquals(reversed ? List.of(icon, background) : List.of(background, icon),
+                    images.stream().map(draw -> draw.box().node()).toList());
+        }
+        icon.properties().addProperty("layer", -2);
+        final var root = node("root", "panel", true, background, sizer);
+        assertEquals(List.of(icon, background), NativeUiPresentation.draws(layout(root), _ -> false).stream()
+                .map(draw -> draw.box().node()).filter(child -> child.type().equals("image")).toList());
+    }
+
+    @Test
+    void nativeToggleGroupsSelectCheckedHoverAndLockedStatesWithoutFormAnnotations() {
+        final var states = List.of("checked", "unchecked", "checked_hover", "unchecked_hover",
+                "checked_locked", "unchecked_locked", "checked_locked_hover", "unchecked_locked_hover");
+        final var children = states.stream().map(name -> node(name, "panel", true)).toList();
+        final var toggle = node("group", "toggle", true, children.toArray(NativeUiScene.Node[]::new));
+        children.forEach(child -> toggle.properties().addProperty(child.name() + "_control", child.name()));
+        for (final boolean checked : new boolean[]{false, true}) {
+            toggle.properties().addProperty("toggle_state", checked);
+            for (final boolean enabled : new boolean[]{false, true}) {
+                toggle.properties().addProperty("enabled", enabled);
+                for (final boolean pointed : new boolean[]{false, true}) {
+                    final String name = (checked ? "checked" : "unchecked") + (enabled ? "" : "_locked") + (pointed ? "_hover" : "");
+                    final var selected = children.stream().filter(child -> child.name().equals(name)).findFirst().orElseThrow();
+                    assertEquals(List.of(toggle, selected), NativeUiPresentation.draws(layout(toggle), _ -> pointed)
+                            .stream().map(draw -> draw.box().node()).toList());
+                }
+            }
+        }
+    }
+
+    @Test
+    void recipeCommandsSelectHoverAndLockedBranchesWithoutAnUnrelatedCloseAnnotation() {
+        final var normal = node("normal", "panel", true);
+        final var hover = node("hover", "panel", true);
+        final var locked = node("locked", "panel", true);
+        final var recipe = node("recipe", "button", true, normal, hover, locked);
+        recipe.properties().add("recipe_actions", new JsonArray());
+        recipe.properties().addProperty("default_control", normal.name());
+        recipe.properties().addProperty("hover_control", hover.name());
+        recipe.properties().addProperty("locked_control", locked.name());
+        for (final boolean enabled : new boolean[]{true, false}) {
+            recipe.properties().addProperty("enabled", enabled);
+            for (final boolean pointed : new boolean[]{false, true}) {
+                final var draws = NativeUiPresentation.draws(layout(recipe), _ -> pointed);
+                final var selected = !enabled ? locked : pointed ? hover : normal;
+                assertEquals(List.of(recipe, selected), draws.stream().map(draw -> draw.box().node()).toList());
+            }
+        }
+    }
+
+    @Test
+    void showsScrollControlsOnlyForOverflowOrAnExplicitAlwaysVisibleOwner() {
+        for (final boolean grouped : new boolean[] {false, true}) {
+            final var content = node("content", "panel", true);
+            final var track = node("track", "scroll_track", true);
+            final var thumb = node("thumb", "scrollbar_box", true);
+            final var controls = node("controls", "panel", true, track, thumb);
+            final var scroll = grouped ? node("scroll", "scroll_view", true, content, controls)
+                : node("scroll", "scroll_view", true, content, track, thumb);
+            scroll.properties().addProperty("scroll_content", "content");
+            scroll.properties().addProperty("scrollbar_track", "track");
+            scroll.properties().addProperty("scrollbar_box", "thumb");
+            if (grouped) scroll.properties().addProperty("scroll_box_and_track_panel", "controls");
+            final var otherOwner = node("controls", "image", true);
+            final var root = node("root", "panel", true, scroll, otherOwner);
+            for (final boolean alwaysVisible : new boolean[] {false, true, false}) {
+                scroll.properties().addProperty("scrollbar_always_visible", alwaysVisible);
+                for (final int height : new int[] {11, 12, 13, 12}) {
+                    content.properties().getAsJsonArray("size").set(1, new com.google.gson.JsonPrimitive(height));
+                    final var draws = NativeUiPresentation.draws(layout(root), _ -> false);
+                    final boolean shown = alwaysVisible || height > 12;
+                    assertEquals(shown, draws.stream().anyMatch(draw -> draw.box().node() == track));
+                    assertEquals(shown, draws.stream().anyMatch(draw -> draw.box().node() == thumb));
+                    assertTrue(draws.stream().anyMatch(draw -> draw.box().node() == otherOwner));
+                    assertTrue(track.flag("visible", false));
+                    assertTrue(thumb.flag("visible", false));
+                    assertTrue(content.flag("visible", false));
+                }
+            }
+        }
+    }
+
+    @Test
+    void keepsLocalImageOpacitySeparateFromExplicitAncestorPropagation() {
+        final var child = node("content", "button", true);
