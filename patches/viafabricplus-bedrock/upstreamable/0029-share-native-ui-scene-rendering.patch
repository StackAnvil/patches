+                            || name.contains("..") || !name.matches("(?:oreui\\.json|NOTICE\\.txt|hbui/gameplay-[0-9a-f]+\\.css|hbui/fonts/[^/]+\\.(?:otf|ttf)|hbui/assets/animation-[0-9a-f]+\\.gif|texts/[a-z]{2}_[A-Z]{2}\\.lang)"))
