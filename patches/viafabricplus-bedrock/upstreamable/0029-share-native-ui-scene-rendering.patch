+        }
+    }
+
+    private void register(final String method, final String suffix, final FunctionDescriptor descriptor) throws ReflectiveOperationException {
+        final var handle = MethodHandles.lookup().findVirtual(OreUiFont.class, method, descriptor.toMethodType()).bindTo(this);
+        final var stub = Linker.nativeLinker().upcallStub(handle, descriptor, this.callbacks);
+        this.engine.run("hb_font_funcs_set_" + suffix + "_func", new MemoryLayout[]{P,P,P,P}, this.functions, stub, NULL, NULL);
+    }
+
+    private int nominal(final MemorySegment font, final MemorySegment data, final int codepoint, final MemorySegment output, final MemorySegment user) {
+        try {
+            final int glyph = FreeType.FT_Get_Char_Index(this.face, codepoint);
+            output.reinterpret(4).set(JAVA_INT, 0, glyph);
+            return glyph == 0 ? 0 : 1;
+        } catch (final Throwable failure) { this.failure = failure; return 0; }
+    }
+
+    private int advance(final MemorySegment font, final MemorySegment data, final int glyph, final MemorySegment user) {
+        try (var stack = MemoryStack.stackPush()) {
+            final var value = stack.mallocCLong(1);
+            if (FreeType.FT_Get_Advance(this.face, glyph, 2, value) != 0) throw new IllegalStateException("Invalid OreUI glyph advance");
+            return (int) ((value.get(0) + 0x200) >> 10);
+        } catch (final Throwable failure) { this.failure = failure; return 0; }
+    }
+
+    private int extents(final MemorySegment font, final MemorySegment data, final int glyph, final MemorySegment output, final MemorySegment user) {
+        try {
+            if (FreeType.FT_Load_Glyph(this.face, glyph, 2) != 0) throw new IllegalStateException("Invalid OreUI glyph extents");
+            final var metrics = this.face.glyph().metrics();
+            final var value = output.reinterpret(16);
+            value.set(JAVA_INT, 0, (int) metrics.horiBearingX()); value.set(JAVA_INT, 4, (int) metrics.horiBearingY());
+            value.set(JAVA_INT, 8, (int) metrics.width()); value.set(JAVA_INT, 12, (int) -metrics.height());
+            return 1;
+        } catch (final Throwable failure) { this.failure = failure; return 0; }
+    }
+
+    private int contour(final MemorySegment font, final MemorySegment data, final int glyph, final int index,
+                        final MemorySegment x, final MemorySegment y, final MemorySegment user) {
+        try {
+            if (FreeType.FT_Load_Glyph(this.face, glyph, 2) != 0) throw new IllegalStateException("Invalid OreUI glyph contour");
+            final var slot = this.face.glyph();
+            if (slot.format() != FreeType.FT_GLYPH_FORMAT_OUTLINE || index < 0 || index >= slot.outline().n_points()) return 0;
+            final var point = slot.outline().points().get(index);
+            x.reinterpret(4).set(JAVA_INT, 0, (int) point.x()); y.reinterpret(4).set(JAVA_INT, 0, (int) point.y());
+            return 1;
+        } catch (final Throwable failure) { this.failure = failure; return 0; }
+    }
+
+    /** Clusters index Unicode codepoints in the supplied text, not UTF-16 code units. */
+    public Run shape(final String text, final String language) throws IOException {
+        return this.shape(text, language, false);
+    }
+
+    /** Nominal coverage remains separate from shaping substitutions and ordinary measurement. */
+    public int[] glyphs(final int[] scalars) throws IOException {
+        synchronized (this.engine) {
+            this.requireOpen();
+            if (scalars.length > MAX_GLYPHS) throw new IOException("OreUI text exceeds shaping limits");
+            final int[] glyphs = new int[scalars.length];
+            for (int index = 0; index < scalars.length; index++) {
+                final int scalar = scalars[index];
+                if (!Character.isValidCodePoint(scalar) || scalar >= 0xd800 && scalar <= 0xdfff)
+                    throw new IOException("Invalid OreUI Unicode scalar");
+                glyphs[index] = FreeType.FT_Get_Char_Index(this.face, scalar);
+            }
+            return glyphs;
+        }
+    }
+
+    /** Per-Unicode-scalar advances for the ordinary Cohtml measurement path, separate from a shaped draw run. */
+    public float[] ordinaryAdvances(final String text, final String language) throws IOException {
+        synchronized (this.engine) {
+            this.requireOpen();
+            final int[] codepoints = codepoints(text, language);
+            final float[] advances = new float[codepoints.length];
+            if (this.gpos && codepoints.length >= 2) {
+                final var run = this.shape(text, language, true);
+                int previous = -1;
+                for (final var glyph : run.glyphs()) {
+                    final int cluster = glyph.cluster();
+                    if (cluster < 0 || cluster >= advances.length) throw new IOException("Invalid OreUI measurement cluster");
+                    final float advance = glyph.advanceX() / 64F;
+                    advances[cluster] = cluster == previous ? advance + advances[cluster] : advance;
+                    previous = cluster;
+                }
+            } else {
+                final int[] glyphs = this.glyphs(codepoints);
+                for (int index = 0; index < codepoints.length; index++) {
+                    if (FreeType.FT_Load_Glyph(this.face, glyphs[index], 10) != 0)
+                        throw new IOException("Invalid OreUI measurement glyph");
+                    advances[index] = this.face.glyph().advance().x() / 64F;
+                }
+                if (this.kern && !this.gpos && glyphs.length >= 2) {
+                    final int space = FreeType.FT_Get_Char_Index(this.face, ' ');
+                    try (var stack = MemoryStack.stackPush()) {
+                        final var vector = FT_Vector.calloc(stack);
+                        for (int index = 0; index < glyphs.length - 1; index++) {
+                            if (glyphs[index] == space || glyphs[index + 1] == space) continue;
+                            if (FreeType.FT_Get_Kerning(this.face, glyphs[index], glyphs[index + 1], 0, vector) != 0)
+                                throw new IOException("Invalid OreUI measurement kerning");
+                            advances[index] += vector.x() / 64F;
+                        }
+                    }
+                }
+            }
+            return advances;
+        }
+    }
+
+    private static int[] codepoints(final String text, final String language) throws IOException {
+        if (text.length() > MAX_GLYPHS * 2 || language.length() > 128) throw new IOException("OreUI text exceeds shaping limits");
+        final int[] codepoints = text.codePoints().toArray();
+        if (codepoints.length > MAX_GLYPHS) throw new IOException("OreUI text exceeds shaping limits");
+        return codepoints;
+    }
+
+    private Run shape(final String text, final String language, final boolean ordinary) throws IOException {
+        synchronized (this.engine) {
+            this.requireOpen();
+            final int[] codepoints = codepoints(text, language);
+            final var buffer = this.engine.pointer("hb_buffer_create", new MemoryLayout[0]);
+            try (var arena = Arena.ofConfined()) {
+                this.engine.run("hb_buffer_add_utf32", new MemoryLayout[]{P,P,I,I,I}, buffer,
+                        arena.allocateFrom(JAVA_INT, codepoints), codepoints.length, 0, -1);
+                final var locale = this.engine.pointer("hb_language_from_string", new MemoryLayout[]{P,I}, arena.allocateFrom(language), -1);
+                this.engine.run("hb_buffer_set_language", new MemoryLayout[]{P,P}, buffer, locale);
+                this.engine.run("hb_buffer_guess_segment_properties", new MemoryLayout[]{P}, buffer);
+                final int featureCount = ordinary ? ADVANCE_FEATURES.length : 1;
+                final var features = arena.allocate(16L * featureCount, 4);
+                for (int index = 0; index < featureCount; index++) {
+                    int tag = 0;
+                    for (int character = 0; character < 4; character++) tag = (tag << 8) | ADVANCE_FEATURES[index].charAt(character);
+                    final long offset = index * 16L;
+                    features.set(JAVA_INT, offset, tag);
+                    features.set(JAVA_INT, offset + 4, index == 0 && this.kern ? 1 : 0);
+                    features.set(JAVA_INT, offset + 8, 0); features.set(JAVA_INT, offset + 12, -1);
+                }
+                this.engine.run("hb_shape", new MemoryLayout[]{P,P,P,I}, this.font, buffer, features, featureCount);
+                this.check();
+                final var count = arena.allocate(JAVA_INT);
+                final var infos = this.engine.pointer("hb_buffer_get_glyph_infos", new MemoryLayout[]{P,P}, buffer, count);
+                final int length = count.get(JAVA_INT, 0);
+                final var positions = this.engine.pointer("hb_buffer_get_glyph_positions", new MemoryLayout[]{P,P}, buffer, count);
+                if (length < 0 || length > MAX_GLYPHS || length != count.get(JAVA_INT, 0)) throw new IOException("Invalid OreUI shaping output");
+                final var glyphInfo = infos.reinterpret(length * 20L);
+                final var glyphPositions = positions.reinterpret(length * 20L);
+                final List<Glyph> glyphs = new ArrayList<>(length);
+                long advanceX = 0, advanceY = 0;
+                for (int index = 0; index < length; index++) {
+                    final long offset = index * 20L;
+                    final var glyph = new Glyph(glyphInfo.get(JAVA_INT, offset), glyphInfo.get(JAVA_INT, offset + 8),
+                            glyphPositions.get(JAVA_INT, offset), glyphPositions.get(JAVA_INT, offset + 4),
+                            glyphPositions.get(JAVA_INT, offset + 8), glyphPositions.get(JAVA_INT, offset + 12));
+                    glyphs.add(glyph); advanceX += glyph.advanceX; advanceY += glyph.advanceY;
+                }
+                return new Run(this.engine.integer("hb_buffer_get_direction", new MemoryLayout[]{P}, buffer),
+                        this.engine.integer("hb_buffer_get_script", new MemoryLayout[]{P}, buffer), List.copyOf(glyphs), advanceX, advanceY);
+            } finally { this.engine.run("hb_buffer_destroy", new MemoryLayout[]{P}, buffer); }
+        }
+    }
+
+    public Raster raster(final int glyph) throws IOException {
+        synchronized (this.engine) {
+            this.requireOpen();
+            if (glyph < 0 || glyph >= this.face.num_glyphs() || FreeType.FT_Load_Glyph(this.face, glyph, 10) != 0)
+                throw new IOException("Invalid OreUI raster glyph");
+            final var slot = this.face.glyph();
+            final int advance = (int) slot.advance().x();
+            if (FreeType.FT_Render_Glyph(slot, FreeType.FT_RENDER_MODE_NORMAL) != 0) throw new IOException("Cannot render OreUI glyph");
+            final var bitmap = slot.bitmap();
+            final int width = bitmap.width(), height = bitmap.rows(), pitch = bitmap.pitch();
+            if (width == 0 || height == 0) return new Raster(0, 0, 0, slot.bitmap_left(), slot.bitmap_top(), advance, new byte[0]);
+            if (width < 0 || height < 0 || width > 2048 || height > 2048 || pitch < width || pitch > 8192
+                    || bitmap.pixel_mode() != FreeType.FT_PIXEL_MODE_GRAY) throw new IOException("Unsupported OreUI glyph bitmap");
+            final byte[] pixels = new byte[width * height];
+            final var source = bitmap.buffer(pitch * height);
+            for (int y = 0; y < height; y++) source.get(y * pitch, pixels, y * width, width);
+            return new Raster(width, height, width, slot.bitmap_left(), slot.bitmap_top(), advance, pixels);
+        }
+    }
+
+    private void requireOpen() {
+        this.engine.requireOpen();
+        if (this.closed) throw new IllegalStateException("OreUI font is closed");
+    }
+
+    private void check() throws IOException {
+        if (this.failure != null) throw new IOException("OreUI font callback failed", this.failure);
+    }
+
+    @Override
+    public void close() {
+        synchronized (this.engine) {
+            if (this.closed) return;
+            this.closed = true;
+            try {
+                if (this.font.address() != 0) this.engine.run("hb_font_destroy", new MemoryLayout[]{P}, this.font);
+            } finally {
+                try { if (this.functions.address() != 0) this.engine.run("hb_font_funcs_destroy", new MemoryLayout[]{P}, this.functions); }
+                finally {
+                    this.callbacks.close();
+                    if (this.face != null) FreeType.FT_Done_Face(this.face);
+                    if (this.library != 0) FreeType.FT_Done_FreeType(this.library);
+                    this.data.close();
+                    this.engine.retired(this);
+                }
+            }
+        }
+    }
+
+    public VerticalMetrics verticalMetrics() { return this.verticalMetrics; }
+
+    /** Normalized native face metrics, independent of the glyph cache generation height. */
+    public record VerticalMetrics(float ascenderY, float descenderY, float lineGap) {
+        /** The caller resolves CSS units and font fitting. A null height retains normal font spacing. */
+        public LineMetrics line(final float pixels, final Float lineHeight) throws IOException {
+            if (!Float.isFinite(pixels) || pixels <= 0 || lineHeight != null && (!Float.isFinite(lineHeight) || lineHeight < 0))
+                throw new IOException("Invalid OreUI line size");
+            final float ascent = this.ascenderY * pixels, descent = this.descenderY * pixels, gap = this.lineGap * pixels;
+            final float span = (float) Math.ceil((descent - ascent) + gap);
+            final float leading = lineHeight == null ? 0F : (float) Math.ceil(lineHeight) - span;
+            final float baseline = round((leading + gap) * .5F - ascent);
+            final float advance = round(leading + span);
+            if (!Float.isFinite(baseline) || !Float.isFinite(advance)) throw new IOException("Invalid OreUI line metrics");
+            return new LineMetrics(baseline, advance);
+        }
+
+        private static float round(final float value) {
+            return (float) Math.copySign(Math.floor(Math.abs((double) value) + .5), value);
+        }
+    }
+    public record LineMetrics(float baselineOffset, float advance) { }
+    public record Glyph(int index, int cluster, int advanceX, int advanceY, int offsetX, int offsetY) { }
+    public record Run(int direction, int script, List<Glyph> glyphs, long advanceX, long advanceY) { }
+    public record Raster(int width, int height, int stride, int left, int top, int advance, byte[] pixels) { }
+}
