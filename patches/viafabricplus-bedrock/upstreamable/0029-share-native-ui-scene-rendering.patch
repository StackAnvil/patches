+
+final class NativeUiImagesTest {
+    @Test
+    void evictsOldMetadataWithoutFailingLaterIconsAndRefreshesChangedPackSources() throws Exception {
+        final var game = mock(Minecraft.class);
+        final var resources = mock(ResourceManager.class);
+        final var resource = mock(Resource.class);
+        final var originalSource = mock(PackResources.class);
+        when(game.getResourceManager()).thenReturn(resources);
+        when(resources.getResource(any())).thenReturn(Optional.of(resource));
+        when(resource.source()).thenReturn(originalSource);
+        when(resource.open()).thenAnswer(_ -> new ByteArrayInputStream(new byte[0]));
+        final var pixels = mock(NativeImage.class);
+        when(pixels.getWidth()).thenReturn(16);
+        when(pixels.getHeight()).thenReturn(12);
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var decoder = mockStatic(NativeImage.class);
+             final var images = new NativeUiImages()) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            final var first = images.image(texture(0));
+            for (int i = 1; i < 256; i++) assertNotNull(images.image(texture(i)));
+            assertSame(first, images.image(texture(0)));
+            assertNotNull(images.image(texture(256)));
+            assertSame(first, images.image(texture(0)));
+            verify(resource, times(257)).open();
+            assertNotNull(images.image(texture(1)));
+            verify(resource, times(258)).open();
+            assertFalse(images.failed());
+
+            final var replacementSource = mock(PackResources.class);
+            when(resource.source()).thenReturn(replacementSource);
+            final var replacement = images.image(texture(0));
+            assertNotSame(first, replacement);
+            assertSame(replacementSource, replacement.source());
+            assertEquals(16, replacement.width());
+            assertEquals(12, replacement.height());
+            verify(resource, times(259)).open();
+        }
+    }
+
+    @Test
+    void rejectsUnavailablePackImagesAndRecoversWhenTheirSourceChanges() throws Exception {
+        final var game = mock(Minecraft.class);
+        final var resources = mock(ResourceManager.class);
+        when(game.getResourceManager()).thenReturn(resources);
+        when(resources.getResource(any())).thenReturn(Optional.empty());
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var decoder = mockStatic(NativeImage.class);
+             final var images = new NativeUiImages()) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            assertTrue(images.failed());
+
+            final var resource = mock(Resource.class);
+            when(resources.getResource(any())).thenReturn(Optional.of(resource));
+            when(resource.source()).thenReturn(mock(PackResources.class));
+            when(resource.open()).thenThrow(new IOException());
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            verify(resource).open();
+
+            final var pixels = mock(NativeImage.class);
+            when(pixels.getWidth()).thenReturn(16);
+            when(pixels.getHeight()).thenReturn(12);
+            when(resource.source()).thenReturn(mock(PackResources.class));
+            doAnswer(_ -> new ByteArrayInputStream(new byte[0])).when(resource).open();
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            final var restored = images.image(texture(0));
+            assertNotNull(restored);
+            assertEquals(16, restored.width());
+            assertEquals(12, restored.height());
+        }
+    }
+
+    private static String texture(final int index) {
+        return "viabedrock:textures/server_ui/icon_" + index + ".png";
+    }
+}
