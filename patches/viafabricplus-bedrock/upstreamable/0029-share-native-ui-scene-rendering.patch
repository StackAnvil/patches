+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import java.io.IOException;
+import java.net.http.HttpClient;
+import java.time.Duration;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+/** Draws accepted pack textures and bounded public HTTPS images. */
+public final class NativeUiImages implements AutoCloseable {
+    private static final int MAX_PACK_IMAGES = 256;
+    private static final ExecutorService DOWNLOADS = new ThreadPoolExecutor(4, 4, 0, TimeUnit.MILLISECONDS,
+        new ArrayBlockingQueue<>(256), Thread.ofPlatform().daemon().name("Bedrock UI images-", 0).factory(),
+        new ThreadPoolExecutor.AbortPolicy());
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10))
+        .followRedirects(HttpClient.Redirect.NEVER).build();
+    private static NativeUiImageCache remoteCache;
+    private final Map<String, Remote> remote = new HashMap<>();
+    private final LinkedHashMap<Identifier, Image> images = new LinkedHashMap<>(MAX_PACK_IMAGES, .75F, true);
+    private final LinkedHashMap<Identifier, Object> failedImages = new LinkedHashMap<>(MAX_PACK_IMAGES, .75F, true);
+    private volatile boolean closed;
+    private final AtomicLong remotePixels = new AtomicLong();
+    private boolean failed;
+    private long revision;
+
+    private static synchronized NativeUiImageCache remoteCache() {
+        if (remoteCache == null) remoteCache = new NativeUiImageCache(
+            Minecraft.getInstance().gameDirectory.toPath().resolve(".cache/viabedrock/form-images"),
+            ProtocolConstants.BEDROCK_VERSION_NAME, HTTP, DOWNLOADS);
+        return remoteCache;
+    }
+
+    public Image image(final NativeUiScene.Node node) {
+        return node.string("texture_file_system", "path").equals("url")
+            ? this.remote(node.string("texture", "")) : this.image(node.string("texture", ""));
+    }
+
+    private Image remote(final String url) {
+        final Remote existing = this.remote.get(url);
+        if (existing != null) return existing.image;
+        if (this.closed || this.remote.size() >= 128) { this.failed = true; return null; }
+        final Remote entry = new Remote();
+        this.remote.put(url, entry);
+        final var future = remoteCache().load(url).thenApplyAsync(data -> {
+            if (this.closed) return null;
+            final long count = (long) data.width() * data.height();
+            long previous;
+            do {
+                previous = this.remotePixels.get();
+                if (previous + count > 16L * 1024 * 1024)
+                    throw new CompletionException(new IOException("Menu images exceed pixel limits"));
+            } while (!this.remotePixels.compareAndSet(previous, previous + count));
+            try { return NativeImage.read(data.bytes()); }
+            catch (final IOException | RuntimeException error) {
+                this.remotePixels.addAndGet(-count);
+                throw new CompletionException(error);
+            }
+        }, DOWNLOADS);
+        future.whenComplete((pixels, error) -> Minecraft.getInstance().execute(() -> {
+            if (this.closed) {
+                if (pixels != null) { this.remotePixels.addAndGet(-(long) pixels.getWidth() * pixels.getHeight()); pixels.close(); }
+                return;
+            }
+            if (error != null) { entry.failed = true; this.failed = true; this.revision++; return; }
+            final Identifier id = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "form/" + UUID.randomUUID());
+            try {
+                Minecraft.getInstance().getTextureManager().register(id, new DynamicTexture(id::toString, pixels));
+                entry.image = new Image(id, pixels.getWidth(), pixels.getHeight(), null);
+            } catch (final RuntimeException failure) {
+                this.remotePixels.addAndGet(-(long) pixels.getWidth() * pixels.getHeight());
+                pixels.close();
+                entry.failed = true;
+                this.failed = true;
+            }
+            this.revision++;
+        }));
+        return null;
+    }
+
+    public long revision() { return this.revision; }
+    public boolean failed() { return this.failed; }
+
+    @Override
+    public void close() {
+        this.closed = true;
+        for (final Remote entry : this.remote.values()) if (entry.image != null) {
+            Minecraft.getInstance().getTextureManager().release(entry.image.id);
+            this.remotePixels.addAndGet(-(long) entry.image.width * entry.image.height);
+        }
+        this.remote.clear();
+        this.images.clear();
+        this.failedImages.clear();
+    }
+
+    private static final class Remote {
+        Image image;
+        boolean failed;
+    }
+
+    public Image image(final String texture) {
+        final Identifier id = Identifier.tryParse(texture);
+        if (id == null || !id.getNamespace().equals("viabedrock") || !id.getPath().startsWith("textures/"))
+            throw new IllegalArgumentException("Invalid native UI texture");
+        final var resource = Minecraft.getInstance().getResourceManager().getResource(id).orElse(null);
+        if (resource == null) {
+            this.failed = true;
+            throw new IllegalArgumentException("Missing native UI texture: " + id);
+        }
+        if (this.failedImages.get(id) == resource.source())
+            throw new IllegalArgumentException("Invalid native UI texture: " + id);
+        final Image cached = this.images.get(id);
+        if (cached != null && cached.source == resource.source()) return cached;
+        try (final var input = resource.open(); final NativeImage pixels = NativeImage.read(input)) {
+            if (pixels.getWidth() > 4096 || pixels.getHeight() > 4096)
+                throw new IOException("Native UI texture exceeds size limits");
+            final Image image = new Image(id, pixels.getWidth(), pixels.getHeight(), resource.source());
+            this.images.put(id, image);
+            if (this.images.size() > MAX_PACK_IMAGES) this.images.pollFirstEntry();
+            this.failedImages.remove(id);
+            return image;
+        } catch (final IOException | RuntimeException error) {
+            this.failedImages.put(id, resource.source());
+            if (this.failedImages.size() > MAX_PACK_IMAGES) this.failedImages.pollFirstEntry();
+            this.failed = true;
+            throw new IllegalArgumentException("Invalid native UI texture: " + id, error);
+        }
+    }
+
+    public void draw(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final int color, final NativeUiAnimations animations) {
+        final NativeUiScene.Node node = box.node();
+        final Image image = this.image(node);
+        if (image == null) {
+            final Remote entry = this.remote.get(node.string("texture", ""));
+            if (entry != null && !entry.failed && !this.closed) graphics.fill(Math.round(box.bounds().x()), Math.round(box.bounds().y()),
+                Math.round(box.bounds().x() + box.bounds().width()), Math.round(box.bounds().y() + box.bounds().height()),
+                color & 0xFF000000 | 0x303030);
+            return;
+        }
+        for (final var region : NativeUiImageRegions.regions(node, box.bounds(), animations.source(node, image.width, image.height))) {
+            final int x0 = Math.round(Math.min(region.x0(), region.x1())), x1 = Math.round(Math.max(region.x0(), region.x1()));
+            final int y0 = Math.round(Math.min(region.y0(), region.y1())), y1 = Math.round(Math.max(region.y0(), region.y1()));
+            if (x0 == x1 || y0 == y1 || region.u0() == region.u1() || region.v0() == region.v1()) continue;
+            final boolean reverseX = region.x0() > region.x1(), reverseY = region.y0() > region.y1();
+            graphics.innerBlit(RenderPipelines.GUI_TEXTURED, image.id, x0, x1, y0, y1,
+                (reverseX ? region.u1() : region.u0()) / image.width, (reverseX ? region.u0() : region.u1()) / image.width,
+                (reverseY ? region.v1() : region.v0()) / image.height, (reverseY ? region.v0() : region.v1()) / image.height, color);
+        }
+    }
+
+    public record Image(Identifier id, int width, int height, Object source) {}
+}
