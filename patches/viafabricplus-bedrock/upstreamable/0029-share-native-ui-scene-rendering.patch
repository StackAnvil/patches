+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiToggleTest.java
@@ -0,0 +1,86 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiToggleTest {
+    @Test
+    void radioInitializationUsesItsIndexInsteadOfTheOrdinaryDefaultState() {
+        final var properties = properties(true, 4);
+        properties.addProperty("toggle_default_state", true);
+        properties.addProperty("toggle_group_default_selected", 2);
+        assertFalse(NativeUiToggle.parse(properties).initialChecked(2));
+        properties.addProperty("toggle_group_forced_index", -1);
+        assertTrue(NativeUiToggle.parse(properties).initialChecked(2));
+        properties.addProperty("radio_toggle_group", false);
+        assertTrue(NativeUiToggle.parse(properties).initialChecked(0));
+    }
+
+    @Test
+    void radioSelectionClearsOtherIndicesIncludingOrdinaryTogglesButPreservesDuplicates() {
+        final var selected = new NativeUiToggle.State(NativeUiToggle.parse(properties(true, 1)), 0);
+        final var duplicate = new NativeUiToggle.State(NativeUiToggle.parse(properties(false, 1)), 0);
+        final var sibling = new NativeUiToggle.State(NativeUiToggle.parse(properties(false, 2)), 0);
+        duplicate.bindChecked(true);
+        sibling.bindChecked(true);
+        final var change = selected.button(button("button.menu_select"), true);
+        assertNotNull(change);
+        duplicate.sibling(change);
+        sibling.sibling(change);
+        assertTrue(selected.checked());
+        assertTrue(duplicate.checked());
+        assertFalse(sibling.checked());
+        assertNotNull(selected.button(button("button.menu_select"), true));
+    }
+
+    @Test
+    void directionalButtonsRespectTheComponentGateAndCheckedState() {
+        final var properties = properties(false, -1);
+        final var disabled = new NativeUiToggle.State(NativeUiToggle.parse(properties), 0);
+        assertNull(disabled.button(button("toggle.on"), true));
+        properties.addProperty("enable_directional_toggling", true);
+        final var input = new NativeUiToggle.State(NativeUiToggle.parse(properties), 0);
+        assertNotNull(input.button(button("toggle.on"), true));
+        assertNull(input.button(button("toggle.on"), true));
+        assertTrue(input.checked());
+        assertNull(input.button(button("toggle.off"), false));
+        assertNotNull(input.button(button("toggle.off"), true));
+        assertFalse(input.checked());
+    }
+
+    @Test
+    void hoverTogglingPublishesChangesWithoutButtonNotificationAndIgnoresRepeatedEntry() {
+        final var properties = properties(false, -1);
+        properties.addProperty("toggle_on_hover", true);
+        final var input = new NativeUiToggle.State(NativeUiToggle.parse(properties), 0);
+        final var entered = input.hover(true);
+        assertNotNull(entered);
+        assertTrue(entered.checked());
+        assertFalse(entered.notifyController());
+        assertNull(input.hover(true));
+        assertNull(input.hover(false));
+        assertFalse(input.hover(true).checked());
+    }
+
+    private static JsonObject properties(final boolean radio, final int index) {
+        final var properties = new JsonObject();
+        properties.addProperty("toggle_name", "navigation_tab");
+        properties.addProperty("radio_toggle_group", radio);
+        properties.addProperty("toggle_group_forced_index", index);
+        properties.addProperty("toggle_on_button", "toggle.on");
+        properties.addProperty("toggle_off_button", "toggle.off");
+        return properties;
+    }
+
+    private static NativeUiInput.ButtonEvent button(final String target) {
+        return new NativeUiInput.ButtonEvent(0, NativeUiInput.symbol(target), 0, 1, true, 1,
+            NativeUiInput.Scope.DEFAULT, true, true);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiViewportTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiViewportTest.java
new file mode 100644
index 0000000..ceca6b2
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiViewportTest.java
@@ -0,0 +1,84 @@
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.blaze3d.platform.Window;
+import com.viaversion.viafabricplus.api.settings.base.EnumSetting;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.settings.impl.BedrockSettings;
+import com.viaversion.viafabricplus.bedrock.settings.base.NativeUiScale;
+import net.minecraft.client.Minecraft;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeUiViewportTest {
+    @Test
+    void appliesTheSelectedPreferenceToTheCurrentViewportWithoutChangingJavaScale() {
+        final var game = mock(Minecraft.class);
+        final var window = mock(Window.class);
+        final var addon = mock(ViaFabricPlusBedrock.class);
+        final var settings = mock(BedrockSettings.class);
+        @SuppressWarnings("unchecked")
+        final EnumSetting<NativeUiScale> preference =
+                mock(EnumSetting.class);
+        when(game.getWindow()).thenReturn(window);
+        when(addon.settings()).thenReturn(settings);
+        when(settings.nativeUiScale()).thenReturn(preference);
+        try (final var client = mockStatic(Minecraft.class);
+             final var entrypoint = mockStatic(ViaFabricPlusBedrock.class)) {
+            client.when(Minecraft::getInstance).thenReturn(game);
+            entrypoint.when(ViaFabricPlusBedrock::impl).thenReturn(addon);
+            for (final var dimensions : new int[][] {{854, 480}, {1920, 1013}, {3840, 2134}}) {
+                when(window.getWidth()).thenReturn(dimensions[0]);
+                when(window.getHeight()).thenReturn(dimensions[1]);
+                for (final int javaScale : new int[] {1, 2, 3, 4, 8}) {
+                    when(window.getGuiScale()).thenReturn(javaScale);
+                    when(window.getGuiScaledWidth()).thenReturn(Math.ceilDiv(dimensions[0], javaScale));
+                    when(window.getGuiScaledHeight()).thenReturn(Math.ceilDiv(dimensions[1], javaScale));
+                    for (final var value : NativeUiScale.values()) {
+                        when(preference.value()).thenReturn(value);
+                        final var current = NativeUiViewport.current();
+                        assertEquals(NativeUiViewport.desktop(dimensions[0], dimensions[1], value.offset(), javaScale), current);
+                        assertEquals(javaScale, window.getGuiScale());
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void matchesExecutedTargetDesktopScaleAndOffsetBounds() {
+        // Original 1.26.51.1 GuiData 141566fd0, AppPlatform desktop type 0.
+        final int[][] nativeCases = {
+            {319, 209, 1, 1}, {640, 360, 1, 1}, {1280, 694, 2, 1},
+            {1920, 1080, 4, 2}, {2560, 1440, 5, 3}, {3840, 2076, 8, 4},
+            {6144, 3318, 8, 4}
+        };
+        for (final int[] fixture : nativeCases) {
+            for (final int javaScale : new int[] {1, 2, 4, 8}) {
+                final var preferred = NativeUiViewport.desktop(fixture[0], fixture[1], 0, javaScale);
+                assertEquals(fixture[2], preferred.scale());
+                assertEquals(fixture[3], NativeUiViewport.desktop(fixture[0], fixture[1], -99, javaScale).scale());
+                assertEquals(preferred, NativeUiViewport.desktop(fixture[0], fixture[1], 99, javaScale));
+                assertEquals((float) fixture[2] / javaScale, preferred.renderScale());
+            }
+        }
+    }
+
+    @Test
+    void boundsScaleByBothViewportAxesAndPreservesEveryDiscreteOffset() {
+        for (int maximum = 1; maximum <= 8; maximum++) {
+            final int width = 376 * maximum, height = 250 * maximum;
+            final int minimum = (maximum + 1) / 2;
+            for (int requested = -10; requested <= 10; requested++) {
+                final var viewport = NativeUiViewport.desktop(width, height, requested, 3);
+                assertEquals(Math.clamp(maximum + requested, minimum, maximum), viewport.scale());
+            }
+            if (maximum > 1) {
+                assertEquals(maximum - 1, NativeUiViewport.desktop(width - 1, height, 0, 3).scale());
+                assertEquals(maximum - 1, NativeUiViewport.desktop(width, height - 1, 0, 3).scale());
+            }
+        }
+    }
+
+}
