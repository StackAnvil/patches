+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonNull;
+import java.util.List;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiAnimationLifecycleTest {
+    @Test
+    void destroysTheNearestNamedAncestorWithoutRemovingSiblingFactoryInstances() {
+        final String name = UUID.randomUUID().toString();
+        final var text = node(UUID.randomUUID().toString(), List.of());
+        final var sequence = new JsonArray();
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("duration", .25);
+        track.add("delay", JsonNull.INSTANCE);
+        track.addProperty("destroy_at_end", name);
+        sequence.add(track);
+        AnimationPrograms.attach(text.properties(), sequence, false);
+        final var first = node(name, List.of(text));
+        final var second = node(name, List.of());
+        final var factory = node(UUID.randomUUID().toString(), List.of(first, second));
+        factory.properties().addProperty("factory_name", UUID.randomUUID().toString());
+        final var lifecycle = new NativeUiAnimationLifecycle(factory);
+        lifecycle.advance(249_000_000);
+        assertFalse(first.flag("ignored", false));
+        lifecycle.advance(250_000_000);
+        assertTrue(first.flag("ignored", false));
+        assertFalse(second.flag("ignored", false));
+        assertTrue(lifecycle.active());
+        second.properties().addProperty("ignored", true);
+        assertFalse(lifecycle.active());
+    }
+
+    @Test
+    void completedAnimationDoesNotDestroyASuffixedAncestorOrAMatchingSibling() {
+        // Original Bedrock 1.26.60.5 141c64b70/141c5e040 compare exact runtime names, then follow parents only.
+        for (final String parent : List.of("hud.selected_item_details", "panel")) {
+            final var label = animatedSlot(0);
+            label.properties().remove("inventory_slot");
+            label.properties().getAsJsonObject("animation_program").getAsJsonArray("tracks").get(0)
+                .getAsJsonObject().addProperty("destroy_at_end", "selected_item_details");
+            final var sibling = node("selected_item_details", List.of());
+            sibling.properties().addProperty("factory_instance_id", 2);
+            final var panel = node(parent, List.of(label, sibling));
+            panel.properties().addProperty("factory_instance_id", 1);
+            final var lifecycle = new NativeUiAnimationLifecycle(node("root", List.of(panel)));
+            lifecycle.advance(1_000_000_000);
+            assertFalse(panel.flag("ignored", false));
+            assertFalse(sibling.flag("ignored", false));
+            assertTrue(lifecycle.drainRetiredFactories().isEmpty());
+        }
+    }
+
+    @Test
+    void schedulesDestructionFromActualPlayTimeAndResetRatherThanScreenAge() {
+        final String name = UUID.randomUUID().toString(), play = UUID.randomUUID().toString(), reset = UUID.randomUUID().toString();
+        final var root = node(name, List.of());
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "wait");
+        track.addProperty("duration", 1);
+        track.addProperty("play_event", play);
+        track.addProperty("reset_event", reset);
+        track.addProperty("destroy_at_end", name);
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        AnimationPrograms.attach(root.properties(), tracks, false);
+        final var lifecycle = new NativeUiAnimationLifecycle(root);
+        lifecycle.advance(2_000_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.animations().event(root, play, 2_000_000_000L);
+        lifecycle.advance(2_500_000_000L);
+        lifecycle.animations().event(root, reset, 2_500_000_000L);
+        lifecycle.advance(4_000_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.animations().event(root, play, 4_000_000_000L);
+        lifecycle.advance(4_999_000_000L);
+        assertTrue(lifecycle.active());
+        lifecycle.advance(5_000_000_000L);
+        assertFalse(lifecycle.active());
+    }
+
+    @Test
+    void bindingRefreshRetainsClocksByControlIdentityAndStartsInsertedControlsAtRefreshTime() {
+        final var first = animatedSlot(1);
+        final var lifecycle = new NativeUiAnimationLifecycle(node("inventory", List.of(first)));
+        lifecycle.advance(250_000_000);
+        assertEquals(.25F, lifecycle.animations().opacityAt(first, 250_000_000).current());
+        final var inserted = animatedSlot(2);
+        final var rebound = animatedSlot(1);
+        rebound.properties().addProperty("hover_text", UUID.randomUUID().toString());
+        lifecycle.replaceRoot(node("inventory", List.of(inserted, rebound)), 250_000_000);
+        assertEquals(.25F, lifecycle.animations().opacityAt(rebound, 250_000_000).current());
+        assertEquals(0, lifecycle.animations().opacityAt(inserted, 250_000_000).current());
+        lifecycle.advance(500_000_000);
+        assertEquals(.5F, lifecycle.animations().opacityAt(rebound, 500_000_000).current());
+        assertEquals(.25F, lifecycle.animations().opacityAt(inserted, 500_000_000).current());
+        lifecycle.replaceRoot(node("inventory", List.of(inserted)), 500_000_000);
+        final var recreated = animatedSlot(1);
+        lifecycle.replaceRoot(node("inventory", List.of(recreated, animatedSlot(2))), 750_000_000);
+        assertEquals(0, lifecycle.animations().opacityAt(recreated, 750_000_000).current());
+    }
+
+    @Test
+    void definitionChangesRestartLocallyAndDestroyedControlsStayRetiredOnBindingRefresh() {
+        final var first = animatedSlot(1);
+        first.properties().getAsJsonObject("animation_program").getAsJsonArray("tracks").get(0)
+            .getAsJsonObject().addProperty("destroy_at_end", first.name());
+        final var lifecycle = new NativeUiAnimationLifecycle(node("inventory", List.of(first)));
+        lifecycle.advance(1_000_000_000);
+        assertTrue(first.flag("ignored", false));
+        final var rebound = new NativeUiScene.Node(first.name(), first.type(), first.properties().deepCopy(), List.of(), first.action());
+        rebound.properties().remove("ignored");
+        lifecycle.replaceRoot(node("inventory", List.of(rebound)), 1_500_000_000);
+        assertTrue(rebound.flag("ignored", false));
+        final var changed = animatedSlot(1);
+        lifecycle.replaceRoot(node("inventory", List.of(changed)), 2_000_000_000);
+        assertFalse(changed.flag("ignored", false));
+        assertEquals(0, lifecycle.animations().opacityAt(changed, 2_000_000_000).current());
+        lifecycle.advance(2_500_000_000L);
+        assertEquals(.5F, lifecycle.animations().opacityAt(changed, 2_500_000_000L).current());
+    }
+
+    @Test
+    void overlappingCollectionWindowsRetainOnlyTheSameSourceRowsAnimationClock() {
+        final var first = animatedCollection(40);
+        final var retained = animatedCollection(41);
+        final var lifecycle = new NativeUiAnimationLifecycle(node("grid", List.of(first, retained)));
+        lifecycle.advance(250_000_000);
+        final var rebound = animatedCollection(41);
+        final var inserted = animatedCollection(42);
+        lifecycle.replaceRoot(node("grid", List.of(rebound, inserted)), 250_000_000);
+        assertEquals(.25F, lifecycle.animations().opacityAt(rebound, 250_000_000).current());
+        assertEquals(0, lifecycle.animations().opacityAt(inserted, 250_000_000).current());
+        lifecycle.advance(500_000_000);
+        assertEquals(.5F, lifecycle.animations().opacityAt(rebound, 500_000_000).current());
+        assertEquals(.25F, lifecycle.animations().opacityAt(inserted, 500_000_000).current());
+    }
+
+    @Test
+    void replacingTheSameNamedFactoryPopupRestartsItsChildrenAndReportsOnlyCompletedCreations() {
+        final var firstText = animatedSlot(0);
+        firstText.properties().remove("inventory_slot");
+        firstText.properties().getAsJsonObject("animation_program").getAsJsonArray("tracks").get(0)
+            .getAsJsonObject().addProperty("destroy_at_end", "popup_tip_text");
+        final var first = node("popup_tip_text", List.of(firstText));
+        first.properties().addProperty("factory_instance_id", 1);
+        final var lifecycle = new NativeUiAnimationLifecycle(node("factory", List.of(first)));
+        lifecycle.advance(500_000_000);
+        final var secondText = new NativeUiScene.Node(firstText.name(), firstText.type(), firstText.properties().deepCopy(), List.of(), firstText.action());
+        final var second = node("popup_tip_text", List.of(secondText));
+        second.properties().addProperty("factory_instance_id", 2);
+        lifecycle.replaceRoot(node("factory", List.of(second)), 500_000_000);
+        assertEquals(0, lifecycle.animations().opacityAt(secondText, 500_000_000).current());
+        lifecycle.advance(1_000_000_000);
+        assertFalse(second.flag("ignored", false));
+        assertTrue(lifecycle.drainRetiredFactories().isEmpty());
+        assertEquals(.5F, lifecycle.animations().opacityAt(secondText, 1_000_000_000).current());
+        lifecycle.advance(1_500_000_000);
+        assertEquals(List.of(second), lifecycle.drainRetiredFactories());
+        assertTrue(lifecycle.drainRetiredFactories().isEmpty());
+        final var replacement = node("popup_tip_text", List.of(animatedSlot(0)));
+        replacement.properties().addProperty("factory_instance_id", 3);
+        lifecycle.replaceRoot(node("factory", List.of(replacement)), 1_750_000_000);
+        assertFalse(replacement.flag("ignored", false));
+        assertEquals(0, lifecycle.animations().opacityAt(replacement.children().getFirst(), 1_750_000_000).current());
+    }
+
+    @Test
+    void popExitWaitsForAllAuthoredCompletionsAcrossRepeatedRequestsAndRefresh() {
+        final var root = node("container", List.of());
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 1);
+        track.addProperty("to", 0);
+        track.addProperty("duration", .4);
+        track.addProperty("play_event", "screen.exit_pop");
+        track.addProperty("end_event", "screen.exit_end");
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        final var size = track.deepCopy();
+        size.addProperty("anim_type", "wait");
+        size.addProperty("duration", .25);
+        tracks.add(size);
+        AnimationPrograms.attach(root.properties(), tracks, false);
+        final var lifecycle = new NativeUiAnimationLifecycle(root);
+        lifecycle.advance(2_000_000_000L);
+        assertFalse(lifecycle.exitComplete());
+        assertTrue(lifecycle.requestExit(2_000_000_000L));
+        assertTrue(lifecycle.exiting());
+        lifecycle.advance(2_200_000_000L);
+        assertEquals(.5F, lifecycle.animations().opacityAt(root, 2_200_000_000L).current(), .00001F);
+        assertTrue(lifecycle.requestExit(2_200_000_000L));
+        lifecycle.advance(2_260_000_000L);
+        assertFalse(lifecycle.exitComplete());
+        final var rebound = new NativeUiScene.Node(root.name(), root.type(), root.properties().deepCopy(), root.children(), root.action());
+        lifecycle.replaceRoot(rebound, 2_260_000_000L);
+        lifecycle.advance(2_399_000_000L);
+        assertFalse(lifecycle.exitComplete());
+        lifecycle.advance(2_401_000_000L);
+        assertTrue(lifecycle.exitComplete());
+        assertFalse(lifecycle.requestExit(3_000_000_000L));
+    }
+
+    @Test
+    void popExitFollowsSuccessorsButDoesNotWaitForAnUnrelatedPlayEvent() {
+        final var root = node("container", List.of());
+        final var first = new JsonObject();
+        first.addProperty("anim_type", "wait");
+        first.addProperty("duration", .1);
+        first.addProperty("play_event", "screen.exit_pop");
+        final var last = new JsonObject();
+        last.addProperty("anim_type", "wait");
+        last.addProperty("duration", .2);
+        last.addProperty("end_event", "screen.exit_end");
+        final var tracks = new JsonArray();
+        tracks.add(first);
+        tracks.add(last);
+        AnimationPrograms.attach(root.properties(), tracks, true);
+        final var lifecycle = new NativeUiAnimationLifecycle(root);
+        assertTrue(lifecycle.requestExit(0));
+        lifecycle.advance(299_000_000L);
+        assertFalse(lifecycle.exitComplete());
+        lifecycle.advance(301_000_000L);
+        assertTrue(lifecycle.exitComplete());
+
+        last.addProperty("play_event", "other.event");
+        final var blocked = new NativeUiAnimationLifecycle(root);
+        assertFalse(blocked.requestExit(0));
+        assertTrue(blocked.exitComplete());
+        final var absent = new NativeUiAnimationLifecycle(node("plain", List.of()));
+        assertFalse(absent.requestExit(0));
+        assertTrue(absent.exitComplete());
+    }
+
+    private static NativeUiScene.Node animatedCollection(final int index) {
+        final var node = animatedSlot(index);
+        node.properties().remove("inventory_slot");
+        node.properties().addProperty("collection", "recipe_book");
+        node.properties().addProperty("collection_index", index);
+        return node;
+    }
+
+    private static NativeUiScene.Node animatedSlot(final int slot) {
+        final var node = node("slot", List.of());
+        node.properties().addProperty("inventory_slot", slot);
+        final var track = new JsonObject();
+        track.addProperty("anim_type", "alpha");
+        track.addProperty("from", 0);
+        track.addProperty("to", 1);
+        track.addProperty("duration", 1);
+        final var tracks = new JsonArray();
+        tracks.add(track);
+        AnimationPrograms.attach(node.properties(), tracks, false);
+        return node;
+    }
+
+    private static NativeUiScene.Node node(final String name, final List<NativeUiScene.Node> children) {
+        return new NativeUiScene.Node(name, "panel", new JsonObject(), children, Integer.MIN_VALUE);
+    }
+}
