+    @Test
+    void sharesOneTextureAcrossGlyphsAndRetiresItWithTheProvider() throws Exception {
+        final var resources = mock(ResourceManager.class);
+        final var pixels = mock(NativeImage.class);
+        final var game = mock(Minecraft.class);
+        final var manager = mock(TextureManager.class);
+        when(resources.open(any())).thenAnswer(_ -> new ByteArrayInputStream(new byte[0]));
+        when(pixels.getWidth()).thenReturn(32);
+        when(pixels.getHeight()).thenReturn(32);
+        when(game.getTextureManager()).thenReturn(manager);
+        try (final var decoder = mockStatic(NativeImage.class);
+             final var singleton = mockStatic(Minecraft.class);
+             final var renderSystem = mockStatic(RenderSystem.class);
+             final var renderTypes = mockStatic(GlyphRenderTypes.class);
+             final var textures = mockConstruction(DynamicTexture.class)) {
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            renderSystem.when(RenderSystem::isOnRenderThread).thenReturn(true);
+            renderTypes.when(() -> GlyphRenderTypes.createForColorTexture(any())).thenReturn(mock(GlyphRenderTypes.class));
+            final var font = BedrockBitmapFont.loadUnicode(resources,
+                    Identifier.fromNamespaceAndPath("viabedrock", "font/glyph_00.png"), new int[][] {{65, 66}, {0, 67}}, 8, 7);
