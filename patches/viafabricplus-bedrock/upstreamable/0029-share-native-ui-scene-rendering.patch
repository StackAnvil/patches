+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiBoxTest {
+    @Test
+    void appliesBordersAndPaddingBeforeSnappingThePaintedContent() {
+        final var bounds = new OreUiBox(.4F, .4F, 10.4F, 20.4F);
+        final var insets = new OreUiBox.Insets(.4F, .4F, .4F, .4F);
+        assertEquals(new OreUiBox(1F, 1F, 9F, 19F), bounds.content(insets, insets, true));
+        final var raw = bounds.content(insets, insets, false);
+        assertEquals(1.2F, raw.x()); assertEquals(1.2F, raw.y());
+        assertEquals(8.799999F, raw.width()); assertEquals(18.8F, raw.height());
+    }
+
+    @Test
+    void retainsTheSignedFractionWhenRoundingDimensions() {
+        // Original 1.26.60.5 content-box controls. Rounding absolute edges gives a different width.
+        assertEquals(new OreUiBox(-2F, -1F, 2F, 2F), new OreUiBox(-1.5F, -.5F, 1F, 1F).snapped());
+    }
+
+    @Test
+    void snapsTheContentOriginBeforeAddingTheCachedTextBaseline() throws Exception {
+        final var bounds = new OreUiBox(480F, 498.4F, 320F, 48F);
+        final var border = new OreUiBox.Insets(2F, 2F, 2F, 2F);
+        final var padding = new OreUiBox.Insets(20F, 20F, 8F, 8F);
+        final var content = bounds.content(border, padding, true);
+        final var metrics = new OreUiFont.VerticalMetrics(-.99F, .25F, 0F).line(20F, 24F);
+        assertEquals(new OreUiBox(502F, 508F, 276F, 28F), content);
+        assertEquals(527F, content.y() + metrics.baselineOffset());
+        assertEquals(527.4F, bounds.content(border, padding, false).y() + metrics.baselineOffset());
+    }
+}
