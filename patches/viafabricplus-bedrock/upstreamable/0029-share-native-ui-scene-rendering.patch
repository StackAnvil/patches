+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.serialization.JsonOps;
+import java.util.IdentityHashMap;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import java.util.Map;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.minecraft.network.chat.FontDescription;
+import net.minecraft.resources.Identifier;
+import net.minecraft.util.FormattedCharSequence;
+
+/** Shared accepted-pack text, image and intrinsic metrics, independent of screen authority. */
+public final class NativeUiRenderer implements NativeUiLayout.Metrics {
+    private final NativeUiActorPortraits portraits = new NativeUiActorPortraits();
+    private final Font font;
+    private final NativeUiImages images;
+    private final Map<NativeUiScene.Node, Component> texts = new IdentityHashMap<>();
+    private final Map<NativeUiScene.Node, WrappedText> wrapped = new IdentityHashMap<>();
+
+    public NativeUiRenderer(final Font font, final NativeUiImages images) {
+        this.font = font;
+        this.images = images;
+    }
+
+    public void reset() { this.texts.clear(); this.wrapped.clear(); }
+    public void retain(final List<NativeUiScene.Node> roots) {
+        final Set<NativeUiScene.Node> live = Collections.newSetFromMap(new IdentityHashMap<>());
+        for (final var root : roots) collect(root, live);
+        this.texts.keySet().retainAll(live);
+        this.wrapped.keySet().retainAll(live);
+    }
+
+    private static void collect(final NativeUiScene.Node node, final Set<NativeUiScene.Node> live) {
+        live.add(node);
+        for (final var child : node.children()) collect(child, live);
+    }
+    public void close() { this.reset(); this.portraits.clear(); }
+    public void prepare(final NativeUiScene.Node root) { this.portraits.prepare(root); }
+
+    public void portrait(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box,
+                         final float mouseX, final float mouseY, final float partialTick, final float alpha) {
+        this.portraits.draw(graphics, box, mouseX, mouseY, partialTick, alpha);
+    }
+
+    @Override
+    public NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width) {
+        if (!node.type().equals("label")) return this.intrinsic(node);
+        final int lines = this.lines(node, this.text(node), NativeUiFont.wrapWidth(node, width)).lines.size();
+        return NativeUiFont.constrained(node, width, lines);
+    }
+
+    public void draw(final GuiGraphicsExtractor graphics, final NativeUiPresentation.Draw draw, final NativeUiAnimations animations) {
+        final var node = draw.box().node();
+        if (node.type().equals("image") && !node.string("texture", "").isEmpty())
+            this.images.draw(graphics, draw.box(), imageColor(node, draw.alpha(), animations), animations);
+        else if (node.type().equals("label")) this.label(graphics, draw.box(), draw.alpha());
+    }
+
+    public NativeUiLayout.Size intrinsic(final NativeUiScene.Node node) {
+        return switch (node.type()) {
+            case "label" -> {
+                final var paragraphs = NativeUiText.labelParagraphs(this.text(node));
+                final int width = paragraphs.stream().mapToInt(this.font::width).max().orElse(0);
+                yield NativeUiFont.intrinsic(node, width, paragraphs.size());
+            }
+            case "image" -> {
+                if (node.string("texture", "").isEmpty()) yield new NativeUiLayout.Size(0, 0);
+                final var image = this.images.image(node);
+                yield image == null ? new NativeUiLayout.Size(16, 16) : new NativeUiLayout.Size(image.width(), image.height());
+            }
+            case "button", "toggle" -> new NativeUiLayout.Size(200, 20);
+            default -> new NativeUiLayout.Size(0, 0);
+        };
+    }
+
+    public void label(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        this.label(graphics, box, alpha, this.text(box.node()));
+    }
+
+    public void label(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha, final Component text) {
+        final var node = box.node();
+        final float scale = NativeUiFont.scale(node);
+        if (scale == 0) return;
+        final int width = NativeUiFont.wrapWidth(node, box.bounds().width());
+        final var lines = this.lines(node, text, width).visible(this.font, NativeUiFont.visibleLines(node, box.bounds().height()));
+        final String alignment = node.string("text_alignment", "left");
+        final int uiScale = NativeUiViewport.current().scale();
+        float y = box.bounds().y();
+        for (final var line : lines) {
+            final int lineWidth = this.font.width(line);
+            final int x = alignment.equals("center") ? (width - lineWidth) / 2 : alignment.equals("right") ? width - lineWidth : 0;
+            final var origin = NativeUiFont.origin(node, box.bounds().x() + x * scale, y, scale, uiScale);
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(origin.x(), origin.y());
+                graphics.pose().scale(scale, scale);
+                graphics.text(this.font, line, 0, 0, color(node, alpha), node.flag("shadow", false));
+            } finally {
+                graphics.pose().popMatrix();
+            }
+            y += NativeUiFont.lineHeight(node) * scale;
+        }
+    }
+
+    private WrappedText lines(final NativeUiScene.Node node, final Component text, final int width) {
+        final var previous = this.wrapped.get(node);
+        if (previous != null && previous.text == text && previous.width == width) return previous;
+        final var value = new WrappedText(text, width, NativeUiText.labelLines(this.font, text, width));
+        this.wrapped.put(node, value);
+        return value;
+    }
+
+    private static final class WrappedText {
+        final Component text;
+        final int width;
+        final List<NativeUiText.Line> lines;
+        private int visible = -1;
+        private List<FormattedCharSequence> display = List.of();
+
+        WrappedText(final Component text, final int width, final List<NativeUiText.Line> lines) {
+            this.text = text;
+            this.width = width;
+            this.lines = lines;
+        }
+
+        List<FormattedCharSequence> visible(final Font font, final int limit) {
+            final int count = Math.min(limit, this.lines.size());
+            if (this.visible == count) return this.display;
+            final List<FormattedCharSequence> result = new ArrayList<>(count);
+            for (int i = 0; i < count; i++) {
+                final var line = this.lines.get(i);
+                result.add(i + 1 == count && count < this.lines.size() ? line.ellipsis(font, this.width) : line.text());
+            }
+            this.visible = count;
+            return this.display = List.copyOf(result);
+        }
+    }
+
+    public Component text(final NativeUiScene.Node node) {
+        return this.texts.computeIfAbsent(node, value -> {
+            final Component text = value.properties().has("text_component")
+                ? ComponentSerialization.CODEC.parse(JsonOps.INSTANCE,
+                    value.properties().get("text_component")).getOrThrow()
+                : value.flag("localize", false) ? Component.translatable(value.string("text", ""))
+                    : NativeUiText.component(value.string("text", ""));
+            return this.styled(value, text);
+        });
+    }
+
+    public Component styled(final NativeUiScene.Node node, final Component text) {
+        final String font = node.string("font", "");
+        return font.isEmpty() ? text : text.copy().withStyle(style -> style.withFont(new FontDescription.Resource(Identifier.parse(font))));
+    }
+
+    static int imageColor(final NativeUiScene.Node node, final float alpha, final NativeUiAnimations animations) {
+        final NativeUiColor animated = animations.color(node);
+        return (animated == null ? NativeUiColor.parse(node.properties().get("color")) : animated).argb(alpha);
+    }
+
+    public static int color(final NativeUiScene.Node node, final float alpha) {
+        final int red = textChannel(NativeUiLayout.vector(node, "color", 0, 1));
+        final int green = textChannel(NativeUiLayout.vector(node, "color", 1, 1));
+        final int blue = textChannel(NativeUiLayout.vector(node, "color", 2, 1));
+        return textChannel(alpha) << 24 | red << 16 | green << 8 | blue;
+    }
+
+    private static int textChannel(final float value) {
+        return Math.clamp((int) (value * 255), 0, 255);
+    }
+
+}
