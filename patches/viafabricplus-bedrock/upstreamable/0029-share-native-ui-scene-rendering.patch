+            if (slot.format() != FreeType.FT_GLYPH_FORMAT_COMPOSITE) throw new IOException("Unsupported native glyph format");
+            final var components = new ArrayList<Component>();
+            try (var stack = MemoryStack.stackPush()) {
+                final var index = stack.mallocInt(1);
+                final var options = stack.mallocInt(1);
+                final var x = stack.mallocInt(1);
+                final var y = stack.mallocInt(1);
+                final var matrix = FT_Matrix.malloc(stack);
+                for (int child = 0; ; child++) {
