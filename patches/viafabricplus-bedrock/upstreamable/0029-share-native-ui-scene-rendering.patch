+    @Test
+    void loadsBitmapPixelsFromTheDescriptorsPackAndRetainsSourceAdvances() throws Exception {
+        final var file = Identifier.fromNamespaceAndPath("viabedrock", "font/bedrock_bitmap/default8_0.png");
+        final var nativeFile = Identifier.fromNamespaceAndPath("viabedrock", "textures/font/bedrock_bitmap/default8_0_native.png");
+        final var resources = mock(ResourceManager.class);
+        final var resource = mock(Resource.class);
+        final var pack = mock(PackResources.class);
+        final var source = mock(GlyphProvider.class);
+        final var original = mock(UnbakedGlyph.class);
+        final var pixels = mock(NativeImage.class);
+        when(resources.getResourceOrThrow(file.withPrefix("textures/"))).thenReturn(resource);
+        when(resource.source()).thenReturn(pack);
+        when(pack.getResource(PackType.CLIENT_RESOURCES, file.withPrefix("textures/").withSuffix(".mcmeta")))
+                .thenAnswer(_ -> (IoSupplier<InputStream>) () -> new ByteArrayInputStream(
+                        ("{\"viabedrock:font_atlas\":{\"texture\":\"viabedrock:font/bedrock_bitmap/default8_0_native.png\",\"height\":12,\"y_offset\":-8}}")
+                                .getBytes(StandardCharsets.UTF_8)));
+        when(pack.getResource(PackType.CLIENT_RESOURCES, nativeFile))
+                .thenAnswer(_ -> (IoSupplier<InputStream>) () -> new ByteArrayInputStream(new byte[0]));
+        when(pixels.getWidth()).thenReturn(128);
+        when(pixels.getHeight()).thenReturn(128);
+        when(source.getGlyph(65)).thenReturn(original);
+        when(original.info()).thenReturn(GlyphInfo.simple(5.5F));
+        final int[][] grid = new int[10][16];
+        grid[3][1] = 65;
+        try (final var decoder = mockStatic(NativeImage.class)) {
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            final var font = BedrockBitmapFont.loadBitmap(source, resources, file, grid);
+            assertEquals(5.5F, font.getGlyph(65).info().getAdvance());
+            verify(source).close();
+            verify(pack).getResource(PackType.CLIENT_RESOURCES, nativeFile);
+            verify(resources, never()).open(any());
+            font.close();
+            font.close();
+            verify(pixels).close();
+            when(pack.getResource(PackType.CLIENT_RESOURCES, nativeFile)).thenReturn(null);
+            assertThrows(IOException.class, () -> BedrockBitmapFont.loadBitmap(source, resources, file, grid));
+            verify(source, times(2)).close();
+            verify(resources, never()).getResourceOrThrow(nativeFile);
+        }
+        final var cell = BedrockBitmapFont.Cell.bitmap(1, 3, 8, 12, 128, 128, -8);
+        assertEquals(8F / 128, cell.u0());
+        assertEquals(.12499219179153442F, cell.u1());
+        assertEquals(36F / 128, cell.v0());
+        assertEquals((48 - .001F) / 128, cell.v1());
+        assertEquals(4, cell.bottom());
+        final var higherResolution = BedrockBitmapFont.Cell.bitmap(1, 3, 16, 24, 256, 256, -8);
+        assertEquals(cell.u0(), higherResolution.u0());
+        assertEquals(cell.u1(), higherResolution.u1());
+        assertEquals(cell.v0(), higherResolution.v0());
+        assertEquals(cell.v1(), higherResolution.v1());
+        assertEquals(cell.bottom(), higherResolution.bottom());
+    }
