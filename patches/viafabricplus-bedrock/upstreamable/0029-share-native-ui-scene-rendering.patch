--- /dev/null
+++ b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_bitmap_font.fsh
@@ -0,0 +1,26 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+#include <minecraft:dynamictransforms.glsl>
+
+uniform sampler2D Sampler0;
+layout(location = 0) in vec4 vertexColor;
+layout(location = 1) in vec2 glyphUv;
+layout(location = 2) flat in vec4 glyphBounds;
+layout(location = 3) noperspective in float glyphGuiY;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    // Preserve the unshifted sample position while selecting native top-edge coverage.
+    vec2 sourceUv = glyphUv - dFdy(glyphUv) * sign(dFdy(glyphGuiY)) / 256.0;
+    vec2 uv = clamp(sourceUv, glyphBounds.xy, glyphBounds.zw);
+#ifdef BITMAP_SMOOTH
+    vec4 color = texture(Sampler0, uv);
+    color = clamp((color - 0.3) * 5.000000476837158, 0.0, 1.0);
+    color = color * color * (3.0 - 2.0 * color);
+#else
+    // Preserve native point addresses when float interpolation lands just below a texel boundary.
+    vec2 texels = roundEven(uv * vec2(textureSize(Sampler0, 0)) * 256.0) / 256.0;
+    vec4 color = texelFetch(Sampler0, ivec2(floor(texels)), 0);
+#endif
+    fragColor = color * vertexColor * ColorModulator;
+}
diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_bitmap_font.vsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_bitmap_font.vsh
