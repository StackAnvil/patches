+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import java.util.HashMap;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.ui.JsonUiProgram;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiBindings;
+
+/** A bounded set of cell views retains the complete source's indices and scroll extent. */
+public record NativeUiCollectionWindow(String key, int size, UiBindings.Window range, float cellWidth, float cellHeight) {
+    public static NativeUiCollectionWindow from(final NativeUiScene.Node node) {
+        if (!node.properties().has("collection_window_key")) return null;
+        final String key = node.string("collection_window_key", "");
+        final int size = integer(node.properties().get("collection_size"));
+        final int start = integer(node.properties().get("collection_start"));
+        final int count = integer(node.properties().get("collection_count"));
+        final int retainedStart = node.properties().has("collection_retained_start") ? integer(node.properties().get("collection_retained_start")) : 0;
+        final int retainedCount = node.properties().has("collection_retained_count") ? integer(node.properties().get("collection_retained_count")) : 0;
+        final float width = NativeUiLayout.vector(node, "collection_cell_size", 0, 0);
+        final float height = NativeUiLayout.vector(node, "collection_cell_size", 1, 0);
+        if (!node.type().equals("grid") || !node.string("grid_rescaling_type", "").equals("horizontal")
+                || node.string("grid_fill_direction", "horizontal").equals("vertical") || node.properties().has("grid_dimensions")
+                || key.isEmpty() || key.length() > 16384 || size < 1 || size > JsonUiProgram.MAX_NODES
+                || start < 0 || start >= size || count < 1 || count > size - start || width <= 0 || height <= 0
+                || retainedStart < 0 || retainedStart >= size || retainedCount < 0 || retainedCount > size - retainedStart)
+            throw new IllegalArgumentException("Invalid native collection window");
+        final var range = new UiBindings.Window(start, count, retainedStart, retainedCount);
+        final var indices = range.indices(size);
+        if (indices.size() != node.children().size()) throw new IllegalArgumentException("Native collection window lost its cell views");
+        for (int index = 0; index < node.children().size(); index++)
+            if (integer(node.children().get(index).properties().get("collection_index")) != indices.get(index))
+                throw new IllegalArgumentException("Native collection window lost its source index");
+        return new NativeUiCollectionWindow(key, size, range, width, height);
+    }
+
+    public static Map<String, UiBindings.Window> visible(final NativeUiLayout.Box root) {
+        return visible(root, null);
+    }
+
+    public static Map<String, UiBindings.Window> visible(final NativeUiLayout.Box root, final NativeUiScene.Node focused) {
+        final Map<String, UiBindings.Window> result = new HashMap<>();
+        collect(root, focused, result);
+        return Map.copyOf(result);
+    }
+
+    private static void collect(final NativeUiLayout.Box box, final NativeUiScene.Node focused, final Map<String, UiBindings.Window> result) {
+        final var window = from(box.node());
+        if (window != null) {
+            final var clip = box.visibleBounds();
+            final int columns = Math.clamp((int) Math.floor(box.bounds().width() / window.cellWidth), 1, 128);
+            final int rows = Math.ceilDiv(window.size, columns);
+            final int firstRow = (int) Math.clamp(Math.floor(((double) clip.y() - box.bounds().y()) / window.cellHeight) - 1, 0, rows - 1);
+            final int endRow = (int) Math.clamp(Math.ceil(((double) clip.y() + clip.height() - box.bounds().y()) / window.cellHeight) + 1, firstRow + 1, rows);
+            final int start = clip.width() <= 0 || clip.height() <= 0 ? 0 : Math.min(window.size - 1, firstRow * columns);
+            final int end = clip.width() <= 0 || clip.height() <= 0 ? 1 : Math.min(window.size, endRow * columns);
+            int retainedStart = 0, retainedCount = 0;
+            if (focused != null && focused.properties().has("collection_index") && contains(box.node(), focused)) {
+                final int selected = integer(focused.properties().get("collection_index"));
+                if (selected >= 0 && selected < window.size) {
+                    final int focusRow = selected / columns;
+                    final int first = Math.max(0, focusRow - 1) * columns;
+                    final int last = Math.min(window.size, (focusRow + 2) * columns);
+                    if (first < start || last > end) {
+                        retainedStart = first;
+                        retainedCount = last - first;
+                    }
+                }
+            }
+            if (result.put(window.key, new UiBindings.Window(start, Math.max(1, end - start), retainedStart, retainedCount)) != null)
+                throw new IllegalArgumentException("Duplicate native collection window identity");
+        }
+        for (final var child : box.children()) collect(child, focused, result);
+    }
+
+    private static boolean contains(final NativeUiScene.Node node, final NativeUiScene.Node selected) {
+        if (node == selected) return true;
+        for (final var child : node.children()) if (contains(child, selected)) return true;
+        return false;
+    }
+
+    private static int integer(final JsonElement value) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber())
+            throw new IllegalArgumentException("Invalid native collection window integer");
+        try { return value.getAsBigDecimal().intValueExact(); }
+        catch (final ArithmeticException invalid) { throw new IllegalArgumentException("Invalid native collection window integer", invalid); }
+    }
+}
