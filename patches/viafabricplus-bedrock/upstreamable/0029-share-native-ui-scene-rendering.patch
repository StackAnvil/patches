+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** Pointer geometry for authored scrollbars. Native layout math remains a separate parity boundary. */
+public final class NativeUiScroll {
+    private NativeUiScroll() {}
+
+    public static boolean horizontal(final NativeUiLayout.Box view) {
+        final var thumb = descendant(view, view.node().string("scrollbar_box", ""));
+        return thumb != null ? thumb.node().string("draggable", "vertical").equals("horizontal")
+            : view.node().string("scroll_direction", "vertical").equals("horizontal");
+    }
+
+    public static float maximum(final NativeUiLayout.Box view) {
+        return Math.max(0, horizontal(view) ? view.content().width() - view.scrollViewport().width()
+            : view.content().height() - view.scrollViewport().height());
+    }
+
+    public static Model model(final NativeUiLayout.Box view, final float offset) {
+        final var track = descendant(view, view.node().string("scrollbar_track", ""));
+        final var thumb = descendant(view, view.node().string("scrollbar_box", ""));
+        if (track == null || thumb == null) return null;
+        final boolean horizontal = horizontal(view);
+        final float maximum = maximum(view);
+        final float content = horizontal ? view.content().width() : view.content().height();
+        final float viewport = horizontal ? view.scrollViewport().width() : view.scrollViewport().height();
+        final float length = horizontal ? track.bounds().width() : track.bounds().height();
+        final int axis = horizontal ? 0 : 1;
+        final var minimum = thumb.node().properties().getAsJsonArray("min_size");
+        final float minimumLength = minimum != null && minimum.size() == 2
+            ? NativeUiLayout.dimension(minimum.get(axis), length, 0, 0) : 0;
+        final float extent = Math.clamp(content > 0 ? length * Math.min(1, viewport / content) : length,
+            Math.clamp(minimumLength, 0, length), length);
+        final float position = maximum > 0 ? (length - extent) * Math.clamp(offset, 0, maximum) / maximum : 0;
+        final var bounds = horizontal
+            ? new NativeUiLayout.Rect(track.bounds().x() + position, thumb.bounds().y(), extent, thumb.bounds().height())
+            : new NativeUiLayout.Rect(thumb.bounds().x(), track.bounds().y() + position, thumb.bounds().width(), extent);
+        return new Model(thumb, track.bounds(), bounds, track.clip().intersect(thumb.clip()), maximum,
+            Math.clamp(offset, 0, maximum), horizontal);
+    }
+
+    public static NativeUiLayout.Box descendant(final NativeUiLayout.Box box, final String name) {
+        if (name.isEmpty()) return null;
+        for (final var child : box.children()) {
+            if (child.node().name().equals(name)) return child;
+            final var found = descendant(child, name);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    public record Model(NativeUiLayout.Box originalThumb, NativeUiLayout.Rect track, NativeUiLayout.Rect thumb,
+                 NativeUiLayout.Rect clip, float maximum, float offset, boolean horizontal) {
+        public boolean containsTrack(final double x, final double y) { return this.track.intersect(this.clip).contains(x, y); }
+        public boolean containsThumb(final double x, final double y) { return this.thumb.intersect(this.clip).contains(x, y); }
+        public float pointer(final double x, final double y) { return (float) (this.horizontal ? x : y); }
+        public float start() { return this.horizontal ? this.thumb.x() : this.thumb.y(); }
+        public float extent() { return this.horizontal ? this.thumb.width() : this.thumb.height(); }
+        public float offsetAt(final float pointer, final float grab) {
+            final float travel = this.horizontal ? this.track.width() - this.thumb.width() : this.track.height() - this.thumb.height();
+            final float start = this.horizontal ? this.track.x() : this.track.y();
+            return travel > 0 ? Math.clamp((pointer - start - grab) / travel, 0, 1) * this.maximum : 0;
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiSlider.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiSlider.java
new file mode 100644
index 0000000..9726a32
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiSlider.java
@@ -0,0 +1,123 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** Applies the native slider component's completed-layout thumb and image updates. */
+public final class NativeUiSlider {
+    private NativeUiSlider() {}
+
+    public static NativeUiLayout.Box apply(final NativeUiLayout.Box box) {
+        final var children = box.children().stream().map(NativeUiSlider::apply).toList();
+        final var result = withChildren(box, children);
+        if (!box.node().type().equals("slider")) return result;
+        final float value = fraction(box.node());
+        return withChildren(result, result.children().stream()
+                .map(child -> update(child, result, result, value)).toList());
+    }
+
+    /** Continuous values are normalized; stepped values are native option ordinals. */
+    public static float fraction(final NativeUiScene.Node node) {
+        final int count = steps(node);
+        final float value = node.number("slider_value", 0);
+        return count >= 2 ? value / (count - 1) : value;
+    }
+
+    public static float pointerFraction(final NativeUiLayout.Box owner, final double x, final double y) {
+        if (!Double.isFinite(x) || !Double.isFinite(y)) throw new IllegalArgumentException("Non-finite slider pointer");
+        final boolean vertical = vertical(owner.node());
+        final var bounds = owner.bounds();
+        final float start = vertical ? bounds.y() : bounds.x();
+        final float extent = vertical ? bounds.height() : bounds.width();
+        final float coordinate = (float) (vertical ? y : x);
+        float value = extent > 0 ? (Math.clamp(coordinate, start, start + extent) - start) / extent : 0;
+        if (owner.node().flag("slider_inverted", false)) value = 1 - value;
+        final int count = steps(owner.node());
+        return count >= 2 ? (float) stepIndex(value, count) / (count - 1) : value;
+    }
+
+    public static int stepIndex(final float fraction, final int count) {
+        if (!Float.isFinite(fraction) || count < 1) throw new IllegalArgumentException("Invalid stepped slider input");
+        if (count == 1) return 0;
+        // The native multiply and half-step addition both round as float before floor.
+        return (int) Math.floor(Math.clamp(fraction, 0, 1) * (count - 1) + .5F);
+    }
+
+    private static int steps(final NativeUiScene.Node node) {
+        return (int) node.number("slider_steps", 0);
+    }
+
+    private static boolean vertical(final NativeUiScene.Node node) {
+        return node.string("slider_direction", "horizontal").equals("vertical");
+    }
+
+    private static NativeUiLayout.Box update(final NativeUiLayout.Box box, final NativeUiLayout.Box parent,
+                                                final NativeUiLayout.Box owner, final float fraction) {
+        if (box.node().type().equals("slider")) return box;
+        var result = box;
+        if (named(box, owner, "slider_box_control")) {
+            final float[] from = anchor(box.node().string("anchor_from", "center"));
+            final float[] to = anchor(box.node().string("anchor_to", "center"));
+            final boolean vertical = vertical(owner.node());
+            final float value = owner.node().flag("slider_inverted", false) ? 1 - fraction : fraction;
+            final var bounds = box.bounds();
+            final var container = parent.bounds();
+            // Native replaces both offset axes; the selected axis retains a parent-relative term.
+            final float x = container.x() + container.width() * from[0] - bounds.width() * to[0]
+                    + (vertical ? 0 : value * container.width() - owner.bounds().width() * .5F);
+            final float y = container.y() + container.height() * from[1] - bounds.height() * to[1]
+                    + (vertical ? value * container.height() - owner.bounds().height() * .5F : 0);
+            result = translate(box, x - bounds.x(), y - bounds.y(), parent.clip());
+        }
+        if (box.node().type().equals("image")
+                && (named(box, owner, "progress_control") || named(box, owner, "progress_hover_control"))) {
+            // Runtime image state belongs to the same node used by animation and input caches.
+            result.node().properties().addProperty("clip_ratio", 1 - fraction);
+        }
+        final var updated = result;
+        return withChildren(updated, updated.children().stream()
+                .map(child -> update(child, updated, owner, fraction)).toList());
+    }
+
+    private static boolean named(final NativeUiLayout.Box box, final NativeUiLayout.Box owner,
+                                 final String property) {
+        final String name = owner.node().string(property, "");
+        return !name.isEmpty() && box.node().name().equals(name);
+    }
+
+    private static NativeUiLayout.Box translate(final NativeUiLayout.Box box, final float x, final float y,
+                                                   final NativeUiLayout.Rect parentClip) {
+        final var bounds = shifted(box.bounds(), x, y);
+        final var clip = box.node().scroll() || box.node().flag("clips_children", false)
+                ? parentClip.intersect(bounds) : parentClip;
+        return new NativeUiLayout.Box(box.node(), bounds, clip, box.content(), shifted(box.scrollViewport(), x, y),
+                box.layer(), box.children().stream().map(child -> translate(child, x, y, clip)).toList());
+    }
+
+    private static NativeUiLayout.Rect shifted(final NativeUiLayout.Rect bounds, final float x, final float y) {
+        return new NativeUiLayout.Rect(bounds.x() + x, bounds.y() + y, bounds.width(), bounds.height());
+    }
+
+    private static NativeUiLayout.Box withChildren(final NativeUiLayout.Box box,
+                                                     final java.util.List<NativeUiLayout.Box> children) {
+        return new NativeUiLayout.Box(box.node(), box.bounds(), box.clip(), box.content(), box.scrollViewport(),
+                box.layer(), children);
+    }
+
+    private static float[] anchor(final String name) {
+        return switch (name) {
+            case "top_left" -> new float[] {0, 0};
+            case "top_middle" -> new float[] {.5F, 0};
+            case "top_right" -> new float[] {1, 0};
+            case "left_middle" -> new float[] {0, .5F};
+            case "center" -> new float[] {.5F, .5F};
+            case "right_middle" -> new float[] {1, .5F};
+            case "bottom_left" -> new float[] {0, 1};
+            case "bottom_middle" -> new float[] {.5F, 1};
+            case "bottom_right" -> new float[] {1, 1};
+            default -> throw new IllegalArgumentException("Unsupported native UI anchor");
+        };
+    }
+}
