+            final byte[] bytes = input.readNBytes(limit + 1);
+            if (bytes.length == 0 || bytes.length > limit) throw new IOException("Invalid bundled OreUI asset size");
+            return bytes;
+        }
+    }
+    public record Face(String family, String file, int weight, String style, boolean sdfOff) { }
+}
