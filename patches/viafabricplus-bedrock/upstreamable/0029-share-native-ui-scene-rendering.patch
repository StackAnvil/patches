+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiInputTest {
+    private static final int SOURCE = NativeUiInput.symbol("button.menu_ok");
+
+    @Test
+    void senderCommitsItsPhaseAfterAReentrantComponentInvalidation() {
+        final var input = state("global", true);
+        final var first = input.dispatch(SOURCE, 1, context(1, 0, 0, 0, true), event -> {
+            assertEquals(0, input.phase(0));
+            input.invalidateMappings();
+        });
+        assertEquals(0, first.events().getFirst().previous());
+        assertEquals(1, input.phase(0));
+        final var repeated = input.dispatch(SOURCE, 1, context(1, 0, 0, 1, true), _ -> input.invalidateMappings());
+        assertEquals(1, repeated.events().getFirst().previous());
+        assertFalse(repeated.events().getFirst().transition());
+        assertEquals(1, input.phase(0));
+    }
+
+    @Test
+    void wildcardComponentsCanInvalidateTheFollowingMappingBeforeItSamplesItsPhase() {
+        final var properties = properties("global", false);
+        final var wildcard = new JsonObject();
+        wildcard.addProperty("from_button_id", "any");
+        properties.getAsJsonArray("button_mappings").add(wildcard);
+        final var input = new NativeUiInput.State(NativeUiInput.parse(properties));
+        final var result = input.dispatch(SOURCE, 1, context(1, 0, 0, 0, true), _ -> input.invalidateMappings());
+        assertEquals(2, result.events().size());
+        assertEquals(2, result.events().get(1).previous());
+        assertEquals(1, input.phase(0));
+    }
+
+    @Test
+    void invalidatingMappingsPreservesDoublePressHistoryAndRetiresEverySource() {
+        final var properties = properties("double_pressed", true);
+        final var other = properties("global", false).getAsJsonArray("button_mappings").get(0).deepCopy().getAsJsonObject();
+        final int otherSource = NativeUiInput.symbol("button.menu_cancel");
+        other.addProperty("from_button_id", "button.menu_cancel");
+        properties.getAsJsonArray("button_mappings").add(other);
+        final var input = new NativeUiInput.State(NativeUiInput.parse(properties));
+        input.dispatch(SOURCE, 1, context(1, 0, 0, 1_000_000_000L, true));
+        input.dispatch(otherSource, 1, context(1, 0, 0, 1_050_000_000L, true));
+        input.invalidateMappings();
+        assertEquals(2, input.phase(0));
+        assertEquals(2, input.phase(1));
+        final var doubled = input.dispatch(SOURCE, 1, context(1, 0, 0, 1_100_000_000L, true));
+        assertTrue(doubled.events().getFirst().transition());
+        assertEquals(2, doubled.events().getFirst().previous());
+        assertEquals(2, input.dispatch(otherSource, 0, context(1, 0, 0, 1_150_000_000L, true)).events().getFirst().previous());
+    }
+
+    @Test
+    void unavailablePhaseIsRetainedWithoutActivationOrCapture() {
+        final var input = state("global", true);
+        input.dispatch(SOURCE, 1, context(1, 0, 0, 0, true));
+        final var unavailable = input.dispatch(SOURCE, 2, context(1, 0, 0, 1, true));
+        assertEquals(2, input.phase(0));
+        assertEquals(1, unavailable.events().getFirst().previous());
+        assertEquals(2, unavailable.events().getFirst().phase());
+        assertFalse(unavailable.events().getFirst().pressed());
+        assertFalse(unavailable.events().getFirst().transition());
+        assertTrue(unavailable.captureRequests().isEmpty());
+        assertEquals(2, input.dispatch(SOURCE, 0, context(1, 0, 0, 2, true)).events().getFirst().previous());
+        assertTrue(input.dispatch(SOURCE, 1, context(1, 0, 0, 3, true)).events().getFirst().transition());
+    }
+
+    @Test
+    void unavailablePhaseKeepsACompletedDoublePressUntilAnActualRelease() {
+        final var input = state("double_pressed", false);
+        assertTrue(input.dispatch(SOURCE, 1, context(1, 0, 0, 0, true)).events().isEmpty());
+        assertTrue(input.dispatch(SOURCE, 2, context(1, 0, 0, 1, true)).events().isEmpty());
+        assertTrue(input.dispatch(SOURCE, 1, context(1, 0, 0, 2, true)).events().getFirst().transition());
+        assertEquals(2, input.dispatch(SOURCE, 2, context(1, 0, 0, 3, true)).events().getFirst().phase());
+        assertEquals(2, input.dispatch(SOURCE, 2, context(1, 0, 0, 4, true)).events().getFirst().phase());
+        assertEquals(0, input.dispatch(SOURCE, 0, context(1, 0, 0, 5, true)).events().getFirst().phase());
+        assertTrue(input.dispatch(SOURCE, 2, context(1, 0, 0, 6, true)).events().isEmpty());
+    }
+
+    @Test
+    void factoryPhaseDistinguishesInitialTouchReleaseFromActivation() {
+        final var input = state("pressed", false);
+        assertFalse(input.dispatch(SOURCE, 0, context(2, 0, 0, 0, true)).events().getFirst().transition());
+        assertFalse(input.dispatch(SOURCE, 1, context(2, 0, 0, 1, true)).events().getFirst().transition());
+        assertTrue(input.dispatch(SOURCE, 0, context(2, 0, 0, 2, true)).events().getFirst().transition());
+        assertFalse(input.dispatch(SOURCE, 0, context(2, 0, 0, 3, true)).events().getFirst().transition());
+    }
+
+    @Test
+    void capturedReleaseSurvivesPointerExitOnceAndRequestsCaptureOnRepeatedPresses() {
+        final var input = state("pressed", true);
+        assertEquals(List.of(SOURCE), input.dispatch(SOURCE, 1, context(1, 20, 30, 0, true)).captureRequests());
+        assertEquals(List.of(SOURCE), input.dispatch(SOURCE, 1, context(1, 20, 30, 1, true)).captureRequests());
+        final var release = input.dispatch(SOURCE, 0, context(1, 100, 30, 2, false));
+        assertEquals(1, release.result());
+        assertEquals(1, release.events().getFirst().previous());
+        assertEquals(0, input.phase(0));
+        assertTrue(input.dispatch(SOURCE, 0, context(1, 100, 30, 3, false)).events().isEmpty());
+        assertEquals(2, input.phase(0));
+    }
+
+    @Test
+    void doublePressUsesPerSourceTimeAndFloatDistanceBoundaries() {
+        for (final float distance : new float[]{Math.nextDown(10F), 10F}) {
+            for (final long elapsed : new long[]{499_999_999L, 500_000_000L}) {
+                final var input = state("double_pressed", false);
+                assertTrue(input.dispatch(SOURCE, 1, context(1, 0, 0, 1_000_000_000L, true)).events().isEmpty());
+                input.dispatch(SOURCE, 0, context(1, 0, 0, 1_000_000_001L, true));
+                final boolean expected = distance < 10F && elapsed < 500_000_000L;
+                assertEquals(expected, !input.dispatch(SOURCE, 1,
+                    context(1, distance, 0, 1_000_000_000L + elapsed, true)).events().isEmpty());
+                assertEquals(expected, !input.dispatch(SOURCE, 0,
+                    context(1, distance, 0, 1_000_000_001L + elapsed, true)).events().isEmpty());
+            }
+        }
+    }
+
+    @Test
+    void wildcardEventSurvivesARejectedMappingWithoutConsumingTheScreenEvent() {
+        final var properties = properties("focused", false);
+        final var wildcard = new JsonObject();
+        wildcard.addProperty("from_button_id", "any");
+        properties.getAsJsonArray("button_mappings").add(wildcard);
+        final var input = new NativeUiInput.State(NativeUiInput.parse(properties));
+        final var result = input.dispatch(SOURCE, 1, context(1, 100, 30, 0, false));
+        assertEquals(0, result.result());
+        assertEquals(1, result.events().size());
+        assertEquals(SOURCE, result.events().getFirst().target());
+        assertEquals(2, result.events().getFirst().previous());
+        assertTrue(result.events().getFirst().transition());
+        assertEquals(2, input.phase(0));
+    }
+
+    @Test
+    void nearestClipAndAlternateScopeKeepNativeInclusiveGeometry() {
+        final var bounds = new NativeUiInput.Bounds(10, 20, 30, 40);
+        final var inner = new NativeUiInput.Ancestor(new NativeUiInput.Bounds(0, 0, 100, 100), true, false, null);
+        final var outer = new NativeUiInput.Ancestor(new NativeUiInput.Bounds(0, 0, 15, 25), true, false, null);
+        final var geometry = new NativeUiInput.Geometry(bounds, List.of(inner, outer));
+        assertTrue(geometry.insideClip(40, 60));
+        assertTrue(bounds.contains(40, 60));
+        assertFalse(geometry.insideAlternate(0x7c, 40, 60));
+        assertTrue(geometry.insideAlternate(0x7c, Math.nextUp(40F), 60));
+        final var scroll = new NativeUiInput.Geometry(bounds,
+            List.of(new NativeUiInput.Ancestor(inner.bounds(), true, true, outer.bounds())));
+        assertFalse(scroll.insideAlternate(0x7c, 50, 60));
+    }
+
+    @Test
+    void hoverNotificationsCarryNoButtonActivationAndPointerEntryHonorsItsOwnGate() {
+        final var properties = properties("focused", false);
+        final var hover = new JsonObject();
+        hover.addProperty("to_button_id", "button.filter_toggle_hovered");
+        hover.addProperty("mapping_type", "pressed");
+        properties.getAsJsonArray("button_mappings").add(hover);
+        properties.addProperty("hover_enabled", false);
+        final var input = new NativeUiInput.State(NativeUiInput.parse(properties));
+        final var direct = input.hover(false, true, false, 1);
+        assertTrue(direct.changed());
+        assertFalse(direct.events().getFirst().transition());
+        assertEquals(0, direct.events().getFirst().source());
+        assertEquals(0, direct.result());
+        assertFalse(input.pointer(false, true, false, 0).pointerEvent());
+        assertTrue(input.pointer(false, true, false, 0).hover().events().isEmpty());
+    }
+
+    private static NativeUiInput.State state(final String kind, final boolean capture) {
+        return new NativeUiInput.State(NativeUiInput.parse(properties(kind, capture)));
+    }
+
+    private static JsonObject properties(final String kind, final boolean capture) {
+        final var properties = new JsonObject();
+        final var mapping = new JsonObject();
+        mapping.addProperty("from_button_id", "button.menu_ok");
+        mapping.addProperty("to_button_id", "button.menu_select");
+        mapping.addProperty("mapping_type", kind);
+        mapping.addProperty("button_up_right_of_first_refusal", capture);
+        final var mappings = new JsonArray();
+        mappings.add(mapping);
+        properties.add("button_mappings", mappings);
+        return properties;
+    }
+
+    private static NativeUiInput.Context context(final int mode, final float x, final float y, final long nanos,
+                                                 final boolean hovered) {
+        return new NativeUiInput.Context(0x7c | (hovered ? 2 : 0), mode, x, y, hovered, true, false, false, nanos, 0);
+    }
+}
