+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** A resolved native type-3 anchor, including a renderer's inside-parent override. */
+public record NativeUiCursorPlacement(float x, float y, boolean insideParent) {
+    public NativeUiCursorPlacement {
+        if (!Float.isFinite(x) || !Float.isFinite(y)) throw new IllegalArgumentException("Non-finite native UI anchor");
+    }
+
+    NativeUiLayout.Size offset(final NativeUiScene.Node node, final NativeUiLayout.Rect bounds,
+                               final NativeUiLayout.Rect parent, final float offsetX, final float offsetY) {
+        // Bedrock 1.26.60.5 RenderComponent type 3: these are local offsets,
+        // not global positions. Centering takes precedence over parent fitting.
+        if (node.flag("follows_cursor", false)) {
+            return new NativeUiLayout.Size((this.x - bounds.width() * .5F) - (bounds.x() - offsetX),
+                (this.y - bounds.height() * .5F) - (bounds.y() - offsetY));
+        }
+        if (!this.insideParent && !node.flag("follows_cursor_inside_parent", false)) return null;
+        if (bounds.width() == 0 || bounds.height() == 0) return new NativeUiLayout.Size(30000, 30000);
+        final float right = parent.width() < 0 ? parent.x() : parent.x() + parent.width();
+        final float bottom = parent.height() < 0 ? parent.y() : parent.y() + parent.height();
+        final float x = this.x + bounds.width() + 10 <= right ? this.x + 10 : (this.x - bounds.width()) - 10;
+        final float y = this.y + bounds.height() + 10 <= bottom ? this.y + 10 : (this.y - bounds.height()) - 10;
+        return new NativeUiLayout.Size((offsetX - bounds.x()) + x, (offsetY - bounds.y()) + y);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiDimension.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiDimension.java
