+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiInputRouterTest {
+    private static final int SOURCE = NativeUiInput.symbol("button.menu_ok");
+
+    @Test
+    void aRetainedControlOutsideInputOrderReceivesOnlyItsCapturedRelease() {
+        final var input = state("global", true);
+        final var router = new NativeUiInputRouter<Integer>();
+        final var registered = control(0, input, true);
+        router.dispatch(SOURCE, 1, List.of(registered));
+        input.invalidateMappings();
+        final var removed = new NativeUiInputRouter.Control<>(0, input, registered.context(), registered.handler(), false);
+        assertTrue(router.dispatch(SOURCE, 1, List.of(removed)).events().isEmpty());
+        assertTrue(router.captures(SOURCE));
+        final var release = router.dispatch(SOURCE, 0, List.of(removed));
+        assertEquals(1, release.events().size());
+        assertEquals(2, release.events().getFirst().button().previous());
+        assertEquals(0, input.phase(0));
+        assertFalse(router.captures(SOURCE));
+        assertTrue(router.dispatch(SOURCE, 0, List.of(removed)).events().isEmpty());
+    }
+
+    @Test
+    void unavailablePhaseDoesNotRetireTheCapturedRelease() {
+        final var router = new NativeUiInputRouter<Integer>();
+        final var controls = List.of(control(0, state("global", true), true));
+        router.dispatch(SOURCE, 1, controls);
+        assertTrue(router.captures(SOURCE));
+        assertEquals(2, router.dispatch(SOURCE, 2, controls).events().getFirst().button().phase());
+        assertTrue(router.captures(SOURCE));
+        router.dispatch(SOURCE, 0, controls);
+        assertFalse(router.captures(SOURCE));
+    }
+
+    @Test
+    void capturePrecedesTheCurrentPointerTargetAndSuppressesTheNormalPass() {
+        final var first = state("pressed", true);
+        final var second = state("pressed", true);
+        final var router = new NativeUiInputRouter<Integer>();
+        router.dispatch(SOURCE, 1, controls(first, second, 0));
+        final var release = router.dispatch(SOURCE, 0, controls(first, second, 1));
+        assertEquals(List.of(0), release.events().stream().map(NativeUiInputRouter.Event::key).toList());
+        assertTrue(release.consumed());
+        assertEquals(1, release.events().getFirst().button().previous());
+        assertEquals(2, first.phase(0));
+        assertEquals(2, second.phase(0));
+        assertFalse(router.captures(SOURCE));
+    }
+
+    @Test
+    void repeatedCaptureRequestsRemainDistinctAndDoNotReplaceEarlierRequests() {
+        final var input = state("global", false);
+        final var router = new NativeUiInputRouter<Integer>();
+        final var controls = List.of(control(0, input, true));
+        router.dispatch(SOURCE, 1, controls);
+        router.dispatch(SOURCE, 1, controls);
+        final var release = router.dispatch(SOURCE, 0, controls);
+        assertEquals(List.of(1, 0, 0), release.events().stream().map(event -> event.button().previous()).toList());
+        assertFalse(router.captures(SOURCE));
+    }
+
+    @Test
+    void deletedControlsRetireCapturesBeforeAnIdentityCanBeReused() {
+        final var router = new NativeUiInputRouter<Integer>();
+        router.dispatch(SOURCE, 1, List.of(control(0, state("global", false), true)));
+        router.retain(Set.of());
+        assertFalse(router.captures(SOURCE));
+        final var replacement = state("global", false);
+        assertEquals(1, router.dispatch(SOURCE, 0, List.of(control(0, replacement, true))).events().size());
+    }
+
+    @Test
+    void componentEffectsPrecedeTheNextControlsContext() {
+        final var flags = new java.util.concurrent.atomic.AtomicInteger(0x7e);
+        final var second = state("focused", false);
+        final var first = new NativeUiInputRouter.Control<>(0, state("global", false),
+            () -> new NativeUiInput.Context(0x7e, 1, 0, 0, true, true, false, false, 0, 0),
+            _ -> flags.set(0x7c), true);
+        final var following = new NativeUiInputRouter.Control<>(1, second,
+            () -> new NativeUiInput.Context(flags.get(), 1, 0, 0, true, true, false, false, 0, 0), _ -> { }, true);
+        final var result = new NativeUiInputRouter<Integer>().dispatch(SOURCE, 1, List.of(first, following));
+        assertEquals(List.of(0), result.events().stream().map(NativeUiInputRouter.Event::key).toList());
+        assertEquals(2, second.phase(0));
+        assertFalse(result.consumed());
+    }
+
+    private static NativeUiInput.State state(final String kind, final boolean consume) {
+        final var properties = new JsonObject();
+        final var mapping = new JsonObject();
+        mapping.addProperty("from_button_id", "button.menu_ok");
+        mapping.addProperty("to_button_id", "button.menu_select");
+        mapping.addProperty("mapping_type", kind);
+        mapping.addProperty("consume_event", consume);
+        mapping.addProperty("button_up_right_of_first_refusal", true);
+        final var mappings = new JsonArray();
+        mappings.add(mapping);
+        properties.add("button_mappings", mappings);
+        return new NativeUiInput.State(NativeUiInput.parse(properties));
+    }
+
+    private static List<NativeUiInputRouter.Control<Integer>> controls(final NativeUiInput.State first,
+                                                                      final NativeUiInput.State second, final int selected) {
+        return List.of(control(0, first, selected == 0), control(1, second, selected == 1));
+    }
+
+    private static NativeUiInputRouter.Control<Integer> control(final int key, final NativeUiInput.State state,
+                                                               final boolean hovered) {
+        return new NativeUiInputRouter.Control<>(key, state,
+            () -> new NativeUiInput.Context(0x7c | (hovered ? 2 : 0), 1, 0, 0, hovered, true, false, false, 0, 0), _ -> { }, true);
+    }
+}
