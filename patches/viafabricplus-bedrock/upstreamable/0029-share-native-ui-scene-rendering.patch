+                if (alpha[i] > 0.5F) distance = -distance;
+                int value = distance <= -4F ? 255 : distance > 4F ? 0
+                        : (int) (((4F - distance) * 128F) / 4F);
+                pixels[y * stride + x] = (byte) value;
+            }
+        }
+        return new Field(outWidth, outHeight, stride, pixels);
+    }
+
+    private static void left(int i, float[] squared, float[] dx, float[] dy) {
+        int s = i - 1;
+        update(i, s, (squared[s] - (dx[s] + dx[s])) + 1F, -1F, 0F, squared, dx, dy);
+    }
+
+    private static void right(int i, float[] squared, float[] dx, float[] dy) {
+        int s = i + 1;
+        update(i, s, dx[s] + dx[s] + squared[s] + 1F, 1F, 0F, squared, dx, dy);
+    }
+
+    private static void update(int i, int s, float candidate, float x, float y,
+                               float[] squared, float[] dx, float[] dy) {
+        if (candidate < squared[i]) {
+            squared[i] = candidate;
+            dx[i] = dx[s] + x;
+            dy[i] = dy[s] + y;
+        }
+    }
+
+    private static float edgeDistance(float gx, float gy, float alpha) {
+        if (Math.abs(gx) <= EPSILON || Math.abs(gy) <= EPSILON) return 0.5F - alpha;
+        float max = Math.max(Math.abs(gx), Math.abs(gy)), min = Math.min(Math.abs(gx), Math.abs(gy));
+        if (min * 0.5F <= max * alpha) {
+            if (max - min * 0.5F <= max * alpha) {
+                return sqrt((max + max) * min * (1F - alpha)) - (min + max) * 0.5F;
+            }
+            return (0.5F - alpha) * max;
+        }
+        return (max + min) * 0.5F - sqrt((max + max) * min * alpha);
+    }
+
+    private static float sqrt(float value) {
+        return (float) Math.sqrt(value);
+    }
+
+}
