+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class NativeUiAnimationsTest {
+    @Test
+    void treatsUnsetAnimationBindingsAsOmittedProperties() {
+        final var explicit = track("alpha", 2, 1, 1);
+        final var unset = explicit.deepCopy();
+        for (final String key : List.of("duration", "from", "to", "delay", "start_delay")) {
+            unset.add(key, com.google.gson.JsonNull.INSTANCE);
+            explicit.remove(key);
+        }
+        final var animations = new NativeUiAnimations();
+        final var nodes = new java.util.ArrayList<NativeUiScene.Node>();
+        for (final var track : List.of(explicit, unset)) {
+            final var properties = new JsonObject();
+            final var tracks = new JsonArray();
+            tracks.add(track);
+            AnimationPrograms.attach(properties, tracks, false);
+            nodes.add(new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE));
+        }
+        for (final long elapsed : new long[] {0, 1_000_000_000L, 3_000_000_000L})
+            assertEquals(animations.opacityAt(nodes.getFirst(), elapsed), animations.opacityAt(nodes.getLast(), elapsed));
+    }
+
+    @Test
+    void followsFadeHoldFadeOutUsingTheTitleClockAcrossSceneUpdates() {
+        final var properties = new JsonObject();
+        final var sequence = new JsonArray();
+        sequence.add(track("alpha", .5F, 0, .5F));
+        sequence.add(track("wait", 3.5F, 0, 0));
+        sequence.add(track("alpha", 1, .5F, 0));
+        AnimationPrograms.attach(properties, sequence, true);
+        final var original = new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE);
+        final var replacement = new NativeUiScene.Node("", "image", properties.deepCopy(), List.of(), Integer.MIN_VALUE);
+        final var animations = new NativeUiAnimations();
+        final double[] seconds = {0, .25, .5, 2, 4, 4.5, 5, 6};
+        final float[] expected = {0, .25F, .5F, .5F, .5F, .25F, 0, 0};
+        for (int i = 0; i < seconds.length; i++) {
+            final long elapsed = (long) (seconds[i] * 1_000_000_000L);
+            assertEquals(expected[i], animations.opacityAt(original, elapsed).current(), .0001F);
+            assertEquals(expected[i], animations.opacityAt(replacement, elapsed).current(), .0001F);
+        }
+    }
+
+    @Test
+    void followsNativeExponentialActionbarFadeAtClampedProgress() {
+        final var animation = new NativeUiAnimations.Track(1, 0, 3, 0, "in_expo");
+        assertEquals(.9990234375F, animation.value(-1));
+        assertEquals(.9990234375F, animation.value(0));
+        assertEquals(.96875F, animation.value(1.5));
+        assertEquals(.5F, animation.value(2.7), .00001F);
+        assertEquals(0, animation.value(3));
+        assertEquals(0, animation.value(4));
+        float previous = 1;
+        for (int i = 0; i <= 60; i++) {
+            final float current = animation.value(i / 20D);
+            org.junit.jupiter.api.Assertions.assertTrue(current <= previous);
+            previous = current;
+        }
+    }
+
+    @Test
+    void samplesNativeCurvesThroughTheHudTimeline() {
+        final String[] easing = {
+            "linear", "spring", "in_quad", "out_quad", "in_out_quad", "in_cubic", "out_cubic", "in_out_cubic",
+            "in_quart", "out_quart", "in_out_quart", "in_quint", "out_quint", "in_out_quint", "in_sine", "out_sine",
+            "in_out_sine", "in_expo", "out_expo", "in_out_expo", "in_circ", "out_circ", "in_out_circ",
+            "in_bounce", "out_bounce", "in_out_bounce", "in_back", "out_back", "in_out_back",
+            "in_elastic", "out_elastic", "in_out_elastic"
+        };
+        // Samples from the pinned native alpha updater, including the native sine lookup table.
+        final float[] quarter = {
+            .25F, .663298726F, .0625F, .4375F, .125F, .015625F, .578125F, .0625F,
+            .00390625F, .68359375F, .03125F, .0009765625F, .7626953125F, .015625F,
+            .0761204958F, .382683456F, .146446615F, .00552427163F, .823223293F, .015625F,
+            .0317541361F, .661437809F, .0669873059F, .02734375F, .47265625F, .1171875F,
+            -.0641365647F, .817409694F, -.0996818393F, -.00552427163F, .911616504F, -.0078133652F
+        };
+        final var animations = new NativeUiAnimations();
+        for (int i = 0; i < easing.length; i++) {
+            final var properties = new JsonObject();
+            final var tracks = new JsonArray();
+            final var alpha = track("alpha", 1, 0, 1);
+            alpha.addProperty("easing", easing[i]);
+            tracks.add(alpha);
+            AnimationPrograms.attach(properties, tracks, false);
+            final var node = new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE);
+            assertEquals(Math.clamp(quarter[i], 0, 1), animations.opacityAt(node, 250_000_000).current(), .000001F);
+            assertEquals(quarter[i], new NativeUiAnimations.Track(0, 1, 1, 0, easing[i]).value(.25), .000001F);
+        }
+    }
+
+    @Test
+    void preservesNativeOvershootAndUsesLinearForUnknownSelectors() {
+        final var overshoot = new NativeUiAnimations.Track(0, 1, 1, 0, "out_back");
+        org.junit.jupiter.api.Assertions.assertTrue(overshoot.value(.75) > 1);
+        final var ordinary = new NativeUiAnimations.Track(.1F, .8F, 2, 1, "linear");
+        final var unknown = new NativeUiAnimations.Track(.1F, .8F, 2, 1, "unknown_easing");
+        for (final double elapsed : new double[] {0, 1, 1.5, 2, 3, 4})
+            assertEquals(ordinary.value(elapsed), unknown.value(elapsed));
+    }
+
+    @Test
+    void carriesNativeFrameRemaindersAcrossSelfLoopsAndExactBoundaries() {
+        final var alpha = track("alpha", 1, 1, 0);
+        alpha.addProperty("next_index", 0);
+        final var node = animated(alpha);
+        final var animations = new NativeUiAnimations();
+        // Native manager callback 14457e7d0: exact completion restarts at from in the same frame.
+        final long[] times = {250_000_000, 500_000_000, 1_000_000_000, 1_250_000_000, 1_750_000_000, 4_250_000_000L};
+        final float[] expected = {.75F, .5F, 1, .75F, .25F, .75F};
+        for (int i = 0; i < times.length; i++) assertEquals(expected[i], animations.opacityAt(node, times[i]).current());
+    }
+
+    @Test
+    void playsWithoutRewindingAndResetsToWaitingUsingNativeEvents() {
+        final var alpha = track("alpha", 1, 1, 0);
+        alpha.addProperty("next_index", 0);
+        final String play = java.util.UUID.randomUUID().toString(), reset = java.util.UUID.randomUUID().toString();
+        alpha.addProperty("play_event", play);
+        alpha.addProperty("reset_event", reset);
+        final var node = animated(alpha);
+        final var animations = new NativeUiAnimations();
+        assertEquals(1, animations.opacityAt(node, 500_000_000).current());
+        animations.event(node, play, 500_000_000);
+        assertEquals(.75F, animations.opacityAt(node, 750_000_000).current());
+        animations.event(node, play, 750_000_000);
+        assertEquals(.5F, animations.opacityAt(node, 1_000_000_000).current());
+        animations.event(node, reset, 1_000_000_000);
+        assertEquals(1, animations.opacityAt(node, 1_500_000_000).current());
+        animations.event(node, play, 1_500_000_000);
+        assertEquals(.75F, animations.opacityAt(node, 2_750_000_000L).current());
+        assertEquals(.5F, animations.opacityAt(node, 3_000_000_000L).current());
+    }
+
+    @Test
+    void waitsForFirstRenderingAndRetainsElapsedTimeAfterward() {
+        final var alpha = track("alpha", 1, 0, 1);
+        alpha.addProperty("wait_until_rendered_to_play", true);
+        final var node = animated(alpha);
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 2_000_000_000L);
+        assertEquals(0, animations.opacityAt(node, 2_000_000_000L).current());
+        assertEquals(.5F, animations.opacityAt(node, 2_500_000_000L).current());
+        assertEquals(1, animations.opacityAt(node, 3_000_000_000L).current());
+    }
+
+    @Test
+    void leavesTerminalTracksFinishedAndDoesNotReplayThemOnPlayEvents() {
+        final var alpha = track("alpha", 1, 1, 0);
+        final String event = java.util.UUID.randomUUID().toString();
+        alpha.addProperty("play_event", event);
+        final var node = animated(alpha);
+        final var animations = new NativeUiAnimations();
+        animations.opacityAt(node, 0);
+        animations.event(node, event, 0);
+        assertEquals(0, animations.opacityAt(node, 1_000_000_000).current());
+        animations.event(node, event, 1_000_000_000);
+        assertEquals(0, animations.opacityAt(node, 2_000_000_000L).current());
+    }
+
+    @Test
+    void retainsTheAnimationClockWhenJavaPartialTicksRetreatDuringPause() {
+        final var node = animated(track("alpha", 1, 1, 0));
+        final var animations = new NativeUiAnimations();
+        assertEquals(.5F, animations.opacityAt(node, 500_000_000).current());
+        assertEquals(.5F, animations.opacityAt(node, 450_000_000).current());
+        assertEquals(.25F, animations.opacityAt(node, 750_000_000).current());
+    }
+
+    @Test
+    void interpolatesMixedUnitsBeforeLayoutAndKeepsAnchorsClipsAndHitBoundsCurrent() {
+        final var size = vector("size", 20, 30, "100%", 50);
+        final var offset = vector("offset", -5, "100%y", 15, "-25%y");
+        final var node = animated(size, offset);
+        node.properties().addProperty("anchor_from", "top_left");
+        node.properties().addProperty("anchor_to", "top_left");
+        final var authored = node.properties().deepCopy();
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 500_000_000);
+        final var solver = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0), animations);
+        final var small = solver.layout(node, 200, 100, java.util.Map.of());
+        assertEquals(new NativeUiLayout.Rect(5, 15, 110, 40), small.bounds());
+        org.junit.jupiter.api.Assertions.assertTrue(small.visibleBounds().contains(114, 54));
+        org.junit.jupiter.api.Assertions.assertFalse(small.visibleBounds().contains(116, 54));
+        final var large = solver.layout(node, 400, 100, java.util.Map.of());
+        assertEquals(new NativeUiLayout.Rect(5, 15, 210, 40), large.bounds());
+        assertEquals(authored, node.properties());
+        animations.advance(node, 1_000_000_000);
+        assertEquals(new NativeUiLayout.Rect(15, -12.5F, 400, 50), solver.layout(node, 400, 100, java.util.Map.of()).bounds());
+    }
+
+    @Test
+    void resetsEventGatedVectorTracksWithoutRewindingRepeatedPlayEvents() {
+        final var offset = vector("offset", -10, 20, 30, -20);
+        offset.addProperty("play_event", "play");
+        offset.addProperty("reset_event", "reset");
+        final var node = animated(offset);
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 0);
+        assertEquals(-10, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "play", 0);
+        animations.advance(node, 250_000_000);
+        assertEquals(0, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "play", 250_000_000);
+        animations.advance(node, 500_000_000);
+        assertEquals(10, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+        animations.event(node, "reset", 500_000_000);
+        animations.advance(node, 750_000_000);
+        assertEquals(-10, animations.dimension(node, "offset", 0).resolve(100, 0, 0, 0, 0, 0, 0));
+    }
+
+    @Test
+    void updatesChildAndSiblingMeasurementDependenciesDuringSizeAnimation() {
+        final var size = vector("size", "100%c", "100%cm", "100%sm", "100%y");
+        final var node = animated(size);
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 500_000_000);
+        assertEquals(80, animations.dimension(node, "size", 0).resolve(200, 40, 25, 100, 90, 120, 0));
+        assertEquals(57.5F, animations.dimension(node, "size", 1).resolve(200, 40, 25, 100, 90, 120, 0));
+    }
+
+    private static JsonObject vector(final String type, final Object x0, final Object y0, final Object x1, final Object y1) {
+        final var value = track(type, 1, 0, 0);
+        for (final var endpoint : List.of(java.util.Map.entry("from", List.of(x0, y0)), java.util.Map.entry("to", List.of(x1, y1)))) {
+            final var pair = new JsonArray();
+            for (final var coordinate : endpoint.getValue()) {
+                if (coordinate instanceof Number number) pair.add(number);
+                else pair.add(coordinate.toString());
+            }
+            value.add(endpoint.getKey(), pair);
+        }
+        return value;
+    }
+
+    private static NativeUiScene.Node animated(final JsonObject... values) {
+        final var properties = new JsonObject();
+        final var tracks = new JsonArray();
+        for (final var value : values) tracks.add(value);
+        AnimationPrograms.attach(properties, tracks, false);
+        return new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE);
+    }
+
+    private static JsonObject track(final String type, final float duration, final float from, final float to) {
+        final var track = new JsonObject();
+        track.addProperty("anim_type", type);
+        track.addProperty("duration", duration);
+        track.addProperty("from", from);
+        track.addProperty("to", to);
+        return track;
+    }
+}
