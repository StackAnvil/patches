+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import java.util.Map;
+import java.util.EnumMap;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.DeltaTracker;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeHudPayload.Kind;
+
+/** Independent native HUD factories share layout, image and font rendering with server forms. */
+public final class BedrockHudOverlays {
+    private static final Map<Kind, NativeHudOverlayState> states = new EnumMap<>(Kind.class);
+    static { for (final var kind : Kind.values()) states.put(kind, new NativeHudOverlayState()); }
+    private static NativeUiImages images;
+    private static NativeUiRenderer renderer;
+    private static Object resourceManager;
+    private static long generation;
+    private BedrockHudOverlays() {}
+
+    public static void register() {
+        for (final var kind : Kind.values()) {
+            PayloadTypeRegistry.clientboundPlay().register(kind.type(), kind.codec());
+            ClientPlayConnectionEvents.INIT.register((listener, client) ->
+                ClientPlayNetworking.registerReceiver(kind.type(),
+                    (payload, context) -> accept(listener.getConnection(), payload)));
+        }
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> {
+            generation++;
+            clear();
+        });
+    }
+
+    private static void accept(final Connection owner, final NativeHudPayload payload) {
+        final long received = generation;
+        final var client = Minecraft.getInstance();
+        client.execute(() -> {
+            if (received != generation || client.getConnection() == null
+                    || client.getConnection().getConnection() != owner || !owner.isConnected()) return;
+            final var state = states.get(payload.kind());
+            try {
+                if (!state.accept(payload.message())) return;
+                retainTextCaches();
+                switch (payload.kind()) {
+                    case ROOT -> {}
+                    case TITLE -> client.gui.hud.clearTitles();
+                    case ACTIONBAR -> client.gui.hud.setOverlayMessage(Component.empty(), false);
+                }
+            } catch (RuntimeException invalid) {
+                state.clear();
+                retainTextCaches();
+                ViaFabricPlusBedrock.impl().logger().warn("Could not display native HUD " + payload.kind(), invalid);
+            }
+        });
+    }
+
+    public static void tick() {
+        boolean retired = false;
+        for (final var state : states.values()) {
+            final boolean active = state.active();
+            state.tick();
+            retired |= active && !state.active();
+        }
+        if (retired) retainTextCaches();
+    }
+
+    private static void retainTextCaches() {
+        if (renderer != null) renderer.retain(states.values().stream().filter(NativeHudOverlayState::active)
+                .map(state -> state.scene().root()).toList());
+    }
+
+    public static boolean draw(final Kind kind, final GuiGraphicsExtractor graphics, final DeltaTracker delta) {
+        final var state = states.get(kind);
+        if (!state.active()) return false;
+        final var client = Minecraft.getInstance();
+        try {
+            if (renderer == null || resourceManager != client.getResourceManager()) {
+                closeResources();
+                resourceManager = client.getResourceManager();
+                images = new NativeUiImages();
+                renderer = new NativeUiRenderer(client.font, images);
+            }
+            final var viewport = NativeUiViewport.current();
+            final long now = state.time(delta.getGameTimeDeltaPartialTick(false));
+            state.animations().advance(state.scene().root(), now);
+            final var layout = state.layout(renderer, viewport.width(), viewport.height(), images.revision());
+            final var draws = NativeUiPresentation.draws(layout, _ -> false, node -> state.animations().opacityAt(node, now));
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().scale(viewport.renderScale(), viewport.renderScale());
+                for (final var draw : draws) {
+                    if (draw.alpha() <= 0 || draw.box().visibleBounds().width() <= 0 || draw.box().visibleBounds().height() <= 0) continue;
+                    final var clip = draw.box().clip();
+                    graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                            Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                    try { renderer.draw(graphics, draw, state.animations()); }
+                    finally { graphics.disableScissor(); }
+                }
+            } finally { graphics.pose().popMatrix(); }
+            return true;
+        } catch (RuntimeException invalid) {
+            state.clear();
+            retainTextCaches();
+            ViaFabricPlusBedrock.impl().logger().warn("Could not render native HUD " + kind, invalid);
+            return false;
+        }
+    }
+
+    private static void closeResources() {
+        if (renderer != null) renderer.close();
+        if (images != null) images.close();
+        renderer = null; images = null; resourceManager = null;
+    }
+    public static void resourcesReloaded() { closeResources(); }
+    public static void clear() {
+        for (final var state : states.values()) state.clear();
+        closeResources();
+    }
+}
