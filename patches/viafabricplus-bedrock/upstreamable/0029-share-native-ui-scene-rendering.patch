+            : this.getFocused() instanceof NativeInput input ? input.node() : null;
+        final var targets = this.focusTargets();
+        final var target = NativeUiFocus.next(targets, selected, direction, this.width, this.height, this.focusHistory);
+        if (target == null) return null;
+        final var node = target.box().node();
+        final GuiEventListener widget = this.actions.containsKey(node) ? this.actions.get(node) : this.inputs.get(node).widget();
+        return ComponentPath.path(this, ComponentPath.leaf(widget));
+    }
