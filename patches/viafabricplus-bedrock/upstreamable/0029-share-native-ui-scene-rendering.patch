+    /** Native packs each 256-codepoint page in codepoint order, including one missing-glyph cell. */
+    private Sampling sampling(final int codepoint) throws IOException {
+        final int page = codepoint >>> 8;
+        final Sampling[] cached = this.pages.get(page);
+        if (cached != null) return cached[codepoint & 255];
+        final int[][] sizes = new int[256][2];
+        boolean missing = false;
+        final float rasterScale = this.scale * 2;
+        for (int index = 0; index < 256; index++) {
+            final int glyph = this.glyphs.get((page << 8) + index);
+            if (glyph == 0 && missing) continue;
+            missing |= glyph == 0;
+            final Box box = this.tables.box(glyph);
+            sizes[index][0] = (int) Math.ceil(box.right * rasterScale) - (int) Math.floor(box.left * rasterScale) + 2;
+            sizes[index][1] = (int) Math.ceil(-box.bottom * rasterScale) - (int) Math.floor(-box.top * rasterScale) + 2;
+        }
+        // These are the target client's candidates, including its non-power-of-two final page.
+        for (final int side : new int[]{256, 512, 1024, 2048, 4086}) {
+            final Sampling[] cells = new Sampling[256];
+            int x = 0, y = 0, bottom = 0;
+            boolean complete = true;
+            for (int index = 0; index < 256; index++) {
+                final int width = sizes[index][0], height = sizes[index][1];
+                if (width > side || height > side) { complete = false; break; }
+                if (x + width >= side) { x = 0; y = bottom; }
+                if (y + height >= side) { complete = false; break; }
+                cells[index] = new Sampling(side, x + 1, y + 1, width - 1, height - 1);
+                x += width;
+                bottom = Math.max(bottom, y + height);
+            }
+            if (complete) {
+                this.pages.put(page, cells);
+                return cells[codepoint & 255];
+            }
+        }
+        throw new IOException("Native font page exceeds atlas bounds");
+    }
