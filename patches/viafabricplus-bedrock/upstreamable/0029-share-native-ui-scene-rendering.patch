+    @Test
+    void advancingOneSubtreeDoesNotAdvanceAnotherRegisteredControl() {
+        final var first = animated(track("alpha", 1, 0, 1));
+        final var second = animated(track("alpha", 1, 0, 1));
+        final var animations = new NativeUiAnimations();
+        animations.opacityAt(second, 0);
