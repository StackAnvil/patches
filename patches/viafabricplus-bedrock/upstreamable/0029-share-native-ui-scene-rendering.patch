+            throw failure;
+        }
+    }
+
+    public IntSet supported() { return IntSets.unmodifiable(this.glyphs.keySet()); }
+
+    public synchronized float advance(final int codepoint) {
+        this.requireOpen();
+        return this.tables.advance(this.glyphs.get(codepoint)) * this.scale * (8F / this.height) * 1.5F;
+    }
+
+    public synchronized Glyph raster(final int codepoint) throws IOException {
+        this.requireOpen();
+        final int glyph = this.glyphs.get(codepoint);
+        if (glyph == 0) throw new IOException("Native font does not contain this character");
+        final Box box = this.tables.box(glyph);
+        final float rasterScale = this.scale * 2;
+        final int x0 = (int) Math.floor(box.left * rasterScale);
+        final int y0 = (int) Math.floor(-box.top * rasterScale);
+        final int x1 = (int) Math.ceil(box.right * rasterScale);
+        final int y1 = (int) Math.ceil(-box.bottom * rasterScale);
+        final int width = x1 - x0 + 1;
+        final int rows = y1 - y0 + 1;
