@@ -0,0 +1,299 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import java.lang.ref.WeakReference;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.Predicate;
+
+/** Native directional selection, scroll contexts and focus-container policies for admitted controls. */
+public final class NativeUiFocus {
+    private NativeUiFocus() {}
+
+    public static List<Target> targets(final NativeUiLayout.Box root, final Predicate<NativeUiScene.Node> admitted) {
+        final List<Target> result = new ArrayList<>();
+        collect(root, null, List.of(), true, true, admitted, result);
+        return List.copyOf(result);
+    }
+
+    private static void collect(final NativeUiLayout.Box box, final Clip inheritedClip, final List<NativeUiLayout.Box> ancestors, final boolean parentVisible,
+                                final boolean parentEnabled, final Predicate<NativeUiScene.Node> admitted, final List<Target> targets) {
+        final var node = box.node();
+        final boolean visible = parentVisible && node.flag("visible", true) && !node.flag("ignored", false);
+        final boolean enabled = parentEnabled && node.flag("enabled", true);
+        if (!visible) return;
+        if (enabled && node.flag("focus_enabled", false) && admitted.test(node)) targets.add(new Target(box, inheritedClip, ancestors));
+        final Clip clip = node.scroll() || node.flag("clips_children", false)
+            ? new Clip(node, node.scroll() ? box.scrollViewport() : box.bounds()) : inheritedClip;
+        final List<NativeUiLayout.Box> nested = new ArrayList<>(ancestors);
+        nested.add(box);
+        for (final var child : box.children()) collect(child, clip, List.copyOf(nested), visible, enabled, admitted, targets);
+    }
+
+    public static Target next(final List<Target> targets, final NativeUiScene.Node selected,
+                              final Direction direction, final float viewportWidth, final float viewportHeight,
+                              final History history) {
+        if (targets.isEmpty()) return null;
+        final Target current = targets.stream().filter(target -> target.box.node() == selected).findFirst().orElse(null);
+        if (current == null) return targets.getFirst();
+        final String override = string(current.box.node(), direction.property);
+        if (override.equals("FOCUS_OVERRIDE_STOP")) return current;
+        Target target = null;
+        if (!override.isEmpty()) {
+            for (final Target candidate : targets) if (string(candidate.box.node(), "focus_identifier").equals(override)) return candidate;
+        }
+        boolean wrapping = current.box.node().flag("focus_wrap_enabled", true);
+        if (target == null) {
+            final Map<NativeUiScene.Node, Target> indexed = new IdentityHashMap<>();
+            for (final var candidate : targets) indexed.put(candidate.box.node(), candidate);
+            for (int index = current.ancestors.size() - 1; index >= 0; index--) {
+                final var ancestor = current.ancestors.get(index);
+                if (!ancestor.node().scroll()) continue;
+                final var viewport = NativeUiScroll.descendant(ancestor, string(ancestor.node(), "scroll_view_port"));
+                if (viewport == null) continue;
+                wrapping = false;
+                final List<Target> candidates = new ArrayList<>();
+                subtree(viewport, indexed, candidates);
+                target = geometry(candidates, current, direction, viewportWidth, viewportHeight, false, false, false);
+                if (target != null) break;
+            }
+        }
+        if (target == null) target = geometry(targets, current, direction, viewportWidth, viewportHeight, wrapping, true, false);
+        if (target == null) return current;
+        final var sourceGroup = group(current);
+        final var targetGroup = group(target);
+        if (sourceGroup == targetGroup && sourceGroup != null && !sourceGroup.flag("focus_wrap_enabled", true)
+            && backwards(current, target, direction)) return current;
+        if (sourceGroup == targetGroup || sourceGroup == null) return target;
+        final String mode = string(sourceGroup, "focus_navigation_mode_" + direction.name().toLowerCase(Locale.ROOT));
+        if (mode.equals("stop")) return current;
+        if (mode.equals("custom")) {
+            final var entries = sourceGroup.properties().get("focus_container_custom_" + direction.name().toLowerCase(Locale.ROOT));
+            if (entries == null || !entries.isJsonArray() || entries.getAsJsonArray().asList().stream().noneMatch(JsonElement::isJsonObject)) return target;
+            final Target custom = custom(targets, current, sourceGroup, direction, history);
+            if (custom != null) return custom;
+        }
+        if (targetGroup == null) return target;
+        if (mode.equals("contained") && !within(target, sourceGroup)) return current;
+        if (targetGroup.flag("use_last_focus", false) && !within(current, targetGroup)) {
+            final Target remembered = history.remembered(targets, targetGroup);
+            if (remembered != null) return remembered;
+        }
+        return target;
+    }
+
+    private static void subtree(final NativeUiLayout.Box box, final Map<NativeUiScene.Node, Target> targets, final List<Target> result) {
+        final var target = targets.get(box.node());
+        if (target != null) result.add(target);
+        for (final var child : box.children()) subtree(child, targets, result);
+    }
+
+    private static boolean backwards(final Target current, final Target target, final Direction direction) {
+        final var source = current.box.bounds();
+        final var result = target.box.bounds();
+        return switch (direction) {
+            case UP -> source.y() < result.y();
+            case DOWN -> result.y() < source.y();
+            case LEFT -> source.x() < result.x();
+            case RIGHT -> result.x() < source.x();
+        };
+    }
+
+    private static NativeUiScene.Node group(final Target target) {
+        if (target.box.node().flag("focus_container", false)) return target.box.node();
+        for (int i = target.ancestors.size() - 1; i >= 0; i--) {
+            final var node = target.ancestors.get(i).node();
+            if (node.flag("focus_container", false)) return node;
+        }
+        return null;
+    }
+
+    private static boolean within(final Target target, final NativeUiScene.Node ancestor) {
+        return target.ancestors.stream().anyMatch(parent -> parent.node() == ancestor);
+    }
+
+    private static Target custom(final List<Target> targets, final Target current, final NativeUiScene.Node sourceGroup,
+                                 final Direction direction, final History history) {
+        final var value = sourceGroup.properties().get("focus_container_custom_" + direction.name().toLowerCase(Locale.ROOT));
+        if (value == null || !value.isJsonArray()) return null;
+        for (final var entry : value.getAsJsonArray()) {
+            if (!entry.isJsonObject()) continue;
+            final String other = string(entry.getAsJsonObject(), "other_focus_container_name");
+            final String name = string(entry.getAsJsonObject(), "focus_id_inside");
+            final List<Target> candidates = targets.stream().filter(candidate -> other.isEmpty()
+                || group(candidate) != null && group(candidate).name().equals(other)).toList();
+            if (!name.isEmpty()) {
+                for (final var candidate : candidates) if (candidate.box.node().name().equals(name)) return candidate;
+            } else if (!other.isEmpty() && !candidates.isEmpty()) {
+                final var container = group(candidates.getFirst());
+                if (container.flag("use_last_focus", false) && !within(current, container)) {
+                    final var remembered = history.remembered(targets, container);
+                    if (remembered != null) return remembered;
+                }
+                Target closest = null;
+                float distance = Float.MAX_VALUE;
+                final var origin = edges(current.box.bounds());
+                for (final var candidate : candidates) {
+                    final var center = edges(candidate.box.bounds());
+                    final float dx = center.centerX - origin.centerX, dy = center.centerY - origin.centerY;
+                    final float squared = dx * dx + dy * dy;
+                    if (squared < distance) { closest = candidate; distance = squared; }
+                }
+                if (closest != null) return closest;
+            }
+        }
+        return null;
+    }
+
+    public static final class History {
+        private final Map<NativeUiScene.Node, ArrayDeque<WeakReference<NativeUiScene.Node>>> recent = new IdentityHashMap<>();
+        private final Map<NativeUiScene.Node, WeakReference<NativeUiScene.Node>> remembered = new IdentityHashMap<>();
+        private Target selected;
+
+        public void select(final Target target) {
+            if (this.selected != null && (target == null || this.selected.box.node() != target.box.node())) {
+                final List<NativeUiScene.Node> groups = new ArrayList<>();
+                if (this.selected.box.node().flag("focus_container", false)) groups.add(this.selected.box.node());
+                for (final var box : this.selected.ancestors) if (box.node().flag("focus_container", false)) groups.add(box.node());
+                for (final var group : groups) {
+                    final var entries = this.recent.computeIfAbsent(group, _ -> new ArrayDeque<>());
+                    entries.addFirst(new WeakReference<>(this.selected.box.node()));
+                    if (entries.size() > 50) entries.removeLast();
+                    if (target == null || group(this.selected) != group(target)) this.remembered.put(group, new WeakReference<>(this.selected.box.node()));
+                }
+            }
+            this.selected = target;
+        }
+
+        public void remap(final Map<NativeUiScene.Node, NativeUiScene.Node> replacements, final List<Target> targets) {
+            final Map<NativeUiScene.Node, ArrayDeque<WeakReference<NativeUiScene.Node>>> updated = new IdentityHashMap<>();
+            for (final var entry : this.recent.entrySet()) {
+                final var group = replacements.get(entry.getKey());
+                if (group == null || !group.flag("focus_container", false)) continue;
+                final ArrayDeque<WeakReference<NativeUiScene.Node>> values = new ArrayDeque<>();
+                for (final var node : entry.getValue()) values.addLast(new WeakReference<>(replacements.get(node.get())));
+                updated.put(group, values);
+            }
+            this.recent.clear();
+            this.recent.putAll(updated);
+            final Map<NativeUiScene.Node, WeakReference<NativeUiScene.Node>> remembered = new IdentityHashMap<>();
+            for (final var entry : this.remembered.entrySet()) {
+                final var group = replacements.get(entry.getKey());
+                if (group != null && group.flag("focus_container", false)) remembered.put(group, new WeakReference<>(replacements.get(entry.getValue().get())));
+            }
+            this.remembered.clear();
+            this.remembered.putAll(remembered);
+            final var selected = this.selected == null ? null : replacements.get(this.selected.box.node());
+            this.selected = targets.stream().filter(target -> target.box.node() == selected).findFirst().orElse(null);
+        }
+
+        private Target remembered(final List<Target> targets, final NativeUiScene.Node group) {
+            final var reference = this.remembered.get(group);
+            final var preferred = reference == null ? null : reference.get();
+            for (final var target : targets) if (target.box.node() == preferred) return target;
+            final var entries = this.recent.get(group);
+            if (entries != null) for (final var entry : entries) {
+                final var node = entry.get();
+                for (final var target : targets) if (target.box.node() == node) return target;
+            }
+            return null;
+        }
+    }
+
+    private static Target geometry(final List<Target> targets, final Target current, final Direction direction,
+                                   final float width, final float height, final boolean wrapping, final boolean clipCheck, final boolean wrapped) {
+        final Edges own = edges(current.box.bounds());
+        final boolean vertical = direction == Direction.UP || direction == Direction.DOWN;
+        final boolean negative = direction == Direction.UP || direction == Direction.LEFT;
+        final float originX = !wrapped || vertical ? own.centerX : negative ? width : 0;
+        final float originY = !wrapped || !vertical ? own.centerY : negative ? height : 0;
+        final float probeX = wrapped || vertical ? originX
+            : negative ? originX - (own.halfWidth - 2) : originX + (own.halfWidth - 2);
+        final float probeY = wrapped || !vertical ? originY
+            : negative ? originY - (own.halfHeight - 2) : originY + (own.halfHeight - 2);
+        final float boundaryX = (negative ? own.left : own.right) - originX;
+        final float boundaryY = (negative ? own.top : own.bottom) - originY;
+        final float boundaryLength = length(boundaryX, boundaryY);
+        final float axis = vertical ? boundaryY : boundaryX;
+        final float threshold = Math.min(.02F, (negative ? -1 : 1)
+            * (boundaryLength > .0001F ? axis / boundaryLength : axis));
+        Target closest = null, aligned = null;
+        float nearestDistance = 1_000_000, nearestAngle = 1_000_000;
+        for (final Target candidate : targets) {
+            if (candidate.box.node() == current.box.node() || wrapped && current.clip != null && candidate.clip != null
+                && current.clip.owner == candidate.clip.owner) continue;
+            final Edges bounds = edges(candidate.box.bounds());
+            if (clipCheck && candidate.clip != null && !visibleCorner(candidate.clip.bounds, bounds)) continue;
+            final float x = vertical ? Math.clamp(probeX, bounds.left, bounds.right)
+                : negative ? bounds.right : bounds.left;
+            final float y = !vertical ? Math.clamp(probeY, bounds.top, bounds.bottom)
+                : negative ? bounds.bottom : bounds.top;
+            final float dx = x - probeX, dy = y - probeY;
+            final float distance = length(dx, dy);
+            final float cosine = distance > Math.ulp(1F) ? (negative ? -1 : 1) * ((vertical ? dy : dx) / distance) : 1;
+            if (!(threshold <= cosine)) continue;
+            final float angle = 1 - cosine;
+            if (angle < nearestAngle) {
+                aligned = candidate;
+                nearestAngle = angle;
+            }
+            if (distance < nearestDistance) {
+                closest = candidate;
+                nearestDistance = distance;
+            }
+        }
+        if (closest != null) return closest;
+        if (aligned != null) return aligned;
+        return !wrapped && wrapping
+            ? geometry(targets, current, direction, width, height, wrapping, clipCheck, true) : null;
+    }
+
+    private static String string(final NativeUiScene.Node node, final String key) {
+        return string(node.properties(), key);
+    }
+
+    private static String string(final JsonObject properties, final String key) {
+        final var value = properties.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
+
+    private static float length(final float x, final float y) {
+        return (float) Math.sqrt(x * x + y * y);
+    }
+
+    private static Edges edges(final NativeUiLayout.Rect rect) {
+        final float halfWidth = rect.width() * .5F, halfHeight = rect.height() * .5F;
+        final float x = rect.x() + halfWidth, y = rect.y() + halfHeight;
+        return new Edges(x, y, halfWidth, halfHeight, x - halfWidth, x + halfWidth, y - halfHeight, y + halfHeight);
+    }
+
+    private static boolean visibleCorner(final NativeUiLayout.Rect clip, final Edges bounds) {
+        return contains(clip, bounds.left, bounds.top) || contains(clip, bounds.right, bounds.top)
+            || contains(clip, bounds.left, bounds.bottom) || contains(clip, bounds.right, bounds.bottom);
+    }
+
+    private static boolean contains(final NativeUiLayout.Rect rect, final float x, final float y) {
+        return rect.x() <= x && x <= rect.x() + rect.width() && rect.y() <= y && y <= rect.y() + rect.height();
+    }
+
+    public record Clip(NativeUiScene.Node owner, NativeUiLayout.Rect bounds) {}
+    public record Target(NativeUiLayout.Box box, Clip clip, List<NativeUiLayout.Box> ancestors) {}
+    private record Edges(float centerX, float centerY, float halfWidth, float halfHeight,
+                         float left, float right, float top, float bottom) {}
+
+    public enum Direction {
+        UP("focus_change_up"), DOWN("focus_change_down"), LEFT("focus_change_left"), RIGHT("focus_change_right");
+        private final String property;
+        Direction(final String property) { this.property = property; }
+    }
+}
