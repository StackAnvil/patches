+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.io.IOException;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiLineMetricsTest {
+    @Test
+    void usesTheRoundedNativeFontSpanForDeathScreenLineBoxes() throws Exception {
+        // Original 1.26.60.5 Renoir metrics scaling and Cohtml line-builder controls.
+        final var ten = new OreUiFont.VerticalMetrics(-.99F, .25F, 0F);
+        final var seven = new OreUiFont.VerticalMetrics(-.8F, .1F, 0F);
+        assertEquals(new OreUiFont.LineMetrics(32F, 40F), ten.line(32F, 40F));
+        assertEquals(new OreUiFont.LineMetrics(15F, 20F), seven.line(16F, 20F));
+        assertEquals(new OreUiFont.LineMetrics(19F, 24F), ten.line(20F, 24F));
+        assertEquals(new OreUiFont.LineMetrics(13F, 15F), seven.line(16F, null));
+        assertEquals(new OreUiFont.LineMetrics(5F, 0F), seven.line(16F, 0F));
+    }
+
+    @Test
+    void preservesLineGapAndRoundsNegativeHalfBaselinesAwayFromZero() throws Exception {
+        final var gap = new OreUiFont.VerticalMetrics(-.75F, .25F, .2F);
+        assertEquals(new OreUiFont.LineMetrics(13F, 20F), gap.line(10F, 20F));
+        final var descending = new OreUiFont.VerticalMetrics(0F, 1F, 0F);
+        assertEquals(new OreUiFont.LineMetrics(-1F, 0F), descending.line(1F, 0F));
+    }
+
+    @Test
+    void rejectsInvalidLineSizesBeforeSubmittingGlyphs() {
+        final var metrics = new OreUiFont.VerticalMetrics(-.8F, .1F, 0F);
+        assertThrows(IOException.class, () -> metrics.line(0F, 20F));
+        assertThrows(IOException.class, () -> metrics.line(Float.NaN, 20F));
+        assertThrows(IOException.class, () -> metrics.line(16F, -1F));
+        assertThrows(IOException.class, () -> metrics.line(16F, Float.POSITIVE_INFINITY));
+    }
+}
