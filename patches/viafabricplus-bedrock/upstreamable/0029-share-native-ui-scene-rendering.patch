+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiFontsTest {
+    @Test
+    void preservesNativeFallbackOwnershipMeasurementContextAndWhitespaceAdvances() throws Exception {
+        try (var stream = OreUiFontsTest.class.getResourceAsStream("/oreui/native-font-assignment-2225.json")) {
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var sample = entry.getAsJsonObject();
+                final List<OreUiFonts.Font> fonts = new ArrayList<>();
+                final var definitions = sample.getAsJsonArray("definitions");
+                for (int index = 0; index < definitions.size(); index++) fonts.add(definitions.get(index).isJsonNull() ? null
+                        : new FixtureFont(index, definitions.get(index).getAsJsonObject(), sample.get("contextual").getAsBoolean()));
+                final var text = OreUiCharacters.prepare(sample.get("text").getAsString(), OreUiCharacters.LineEndings.NORMALIZE,
+                        OreUiLines.WhiteSpace.PRE, 20F, 0F);
+                final var result = OreUiFonts.assign(text, fonts);
+                assertEquals(sample.getAsJsonArray("scalars").size(), result.glyphs().size(), sample.toString());
+                for (int index = 0; index < result.glyphs().size(); index++) {
+                    assertEquals(new OreUiFonts.Glyph(sample.getAsJsonArray("scalars").get(index).getAsInt(),
+                            sample.getAsJsonArray("glyphs").get(index).getAsInt(), sample.getAsJsonArray("fonts").get(index).getAsInt(),
+                            sample.getAsJsonArray("advances").get(index).getAsFloat()), result.glyphs().get(index), sample.toString());
+                }
+            }
+        }
+    }
+
+    private record FixtureFont(int index, JsonObject coverage, boolean contextual) implements OreUiFonts.Font {
+        @Override public int[] glyphs(final int[] scalars) {
+            final int[] result = new int[scalars.length];
+            for (int i = 0; i < scalars.length; i++) {
+                final String character = new String(Character.toChars(scalars[i]));
+                result[i] = this.coverage.has(character) ? this.coverage.get(character).getAsInt() : 0;
+            }
+            return result;
+        }
+        @Override public float[] advances(final int[] scalars) {
+            final int[] glyphs = this.glyphs(scalars);
+            final float[] result = new float[scalars.length];
+            for (int i = 0; i < glyphs.length; i++) {
+                result[i] = (this.index + 1) * 10 + glyphs[i] / 8F;
+                if (this.contextual && i + 1 < glyphs.length) result[i] += (glyphs[i + 1] + 3) / 16F;
+            }
+            return result;
+        }
+    }
+}
