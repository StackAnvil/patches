+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.ChatFormatting;
+import net.minecraft.client.StringSplitter;
+import net.minecraft.client.gui.Font;
+import net.minecraft.locale.Language;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.FormattedText;
+import net.minecraft.network.chat.Style;
+import net.minecraft.util.FormattedCharSequence;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+final class NativeUiTextTest {
+    @Test
+    void tooltipParagraphsPreserveStyledRunsAndNormalizeCrossRunCrLf() {
+        final var text = Component.literal("\r\nCat\r").withStyle(ChatFormatting.RED)
+            .append(Component.literal("\nBackswag\n").withStyle(ChatFormatting.GREEN, ChatFormatting.BOLD))
+            .append(Component.literal("Press to purchase\n\n").withStyle(ChatFormatting.BLUE));
+        final var font = font();
+        final var unwrapped = NativeUiText.tooltipLines(font, text, Integer.MAX_VALUE);
+        assertEquals(List.of("", "Cat", "Backswag", "Press to purchase", "", ""), unwrapped.stream().map(NativeUiTextTest::plain).toList());
+        final List<Style> styles = new ArrayList<>();
+        unwrapped.get(2).accept((index, style, codePoint) -> { styles.add(style); return true; });
+        assertTrue(styles.stream().allMatch(style -> style.isBold() && style.getColor().equals(Style.EMPTY.withColor(ChatFormatting.GREEN).getColor())));
+        final var wrapped = NativeUiText.tooltipLines(font, text, 5);
+        assertTrue(wrapped.size() > unwrapped.size());
+        assertTrue(wrapped.stream().allMatch(line -> plain(line).length() <= 5));
+        assertEquals("CatBackswagPresstopurchase", wrapped.stream().map(NativeUiTextTest::plain).reduce("", String::concat).replace(" ", ""));
+        assertEquals(1, NativeUiText.paragraphs(Component.literal("literal\\ntext")).size());
+    }
+
+    private static Font font() {
+        final var font = mock(Font.class);
+        final var splitter = new StringSplitter((codePoint, style) -> 1);
+        when(font.split(any(FormattedText.class), anyInt())).thenAnswer(call -> splitter
+            .splitLines((FormattedText) call.getArgument(0), (int) call.getArgument(1), Style.EMPTY).stream()
+            .map(Language.getInstance()::getVisualOrder).toList());
+        return font;
+    }
+
+    private static String plain(final FormattedCharSequence text) {
+        final var result = new StringBuilder();
+        text.accept((index, style, codePoint) -> { result.appendCodePoint(codePoint); return true; });
+        return result.toString();
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiTextureAnimationTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiTextureAnimationTest.java
new file mode 100644
index 0000000..b8567f0
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiTextureAnimationTest.java
@@ -0,0 +1,108 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiTextureAnimationTest {
+    @Test
+    void interpolatesTexturePixelsAndPreservesClippingAndAuthoredCrop() {
+        final var uv = JsonParser.parseString("{\"anim_type\":\"uv\",\"from\":[2,4],\"to\":[18,-12],\"duration\":1,\"reset_event\":\"reset\"}").getAsJsonObject();
+        final var node = node(uv);
+        node.properties().add("uv_size", JsonParser.parseString("[16,8]"));
+        node.properties().addProperty("clip_direction", "left");
+        node.properties().addProperty("clip_ratio", .5F);
+        final var authored = node.properties().deepCopy();
+        final var animations = new NativeUiAnimations();
+        animations.advance(node, 500_000_000);
+        final var source = animations.source(node, 256, 128);
+        assertEquals(new NativeUiImageRegions.Source(10, -4, 16, 8), source);
+        final var regions = NativeUiImageRegions.regions(node, new NativeUiLayout.Rect(0, 0, 64, 32), source);
+        assertEquals(List.of(new NativeUiImageRegions.Region(0, 0, 32, 32, 10, -4, 18, 4)), regions);
+        assertEquals(authored, node.properties());
+        animations.event(node, "reset", 500_000_000);
+        assertEquals(new NativeUiImageRegions.Source(2, 4, 16, 8), animations.source(node, 256, 128));
+    }
+
+    @Test
+    void advancesOneFlipbookFramePerUpdateAndRetainsItsClockAcrossRefreshes() {
+        final var node = node(flipbook());
+        node.properties().add("uv_size", JsonParser.parseString("[32,24]"));
+        final var lifecycle = new NativeUiAnimationLifecycle(node);
+        final var animations = lifecycle.animations();
+        lifecycle.advance(750_000_000);
+        final var first = animations.source(node, 256, 128);
+        assertEquals(new NativeUiImageRegions.Source(64.00390625F, 0, 63.9921875F, 24), first);
+        // Layout and extraction share a timestamp, so the same frame must not consume the backlog twice.
+        animations.opacityAt(node, 750_000_000);
+        assertEquals(first, animations.source(node, 256, 128));
+        final var replacement = new NativeUiScene.Node(node.name(), node.type(), node.properties().deepCopy(), List.of(), node.action());
+        lifecycle.replaceRoot(replacement, 750_000_000);
+        assertEquals(first, animations.source(replacement, 256, 128));
+        lifecycle.advance(751_000_000);
+        assertEquals(new NativeUiImageRegions.Source(128.00390625F, 0, 63.9921875F, 24), animations.source(replacement, 256, 128));
+        assertEquals(new NativeUiImageRegions.Source(64.00390625F, 0, 31.9921875F, 24), animations.source(replacement, 128, 64));
+    }
+
+    @Test
+    void reversesAtLoopBoundariesAndRetainsDirectionWhenReset() {
+        final var flipbook = flipbook();
+        flipbook.addProperty("orientation", "vertical");
+        flipbook.addProperty("reversible", true);
+        flipbook.addProperty("reset_event", "reset");
+        final var node = node(flipbook);
+        node.properties().add("uv_size", JsonParser.parseString("[32,24]"));
+        final var animations = new NativeUiAnimations();
+        for (int i = 1; i <= 4; i++) animations.advance(node, i * 250_000_000L);
+        assertEquals(new NativeUiImageRegions.Source(0, 96.00390625F, 32, 31.9921875F), animations.source(node, 256, 128));
+        animations.event(node, "reset", 1_000_000_000);
+        assertEquals(new NativeUiImageRegions.Source(0, 0, 32, 31.9921875F), animations.source(node, 256, 128));
+        animations.advance(node, 1_250_000_000);
+        assertEquals(new NativeUiImageRegions.Source(0, 64.00390625F, 32, 31.9921875F), animations.source(node, 256, 128));
+    }
+
+    @Test
+    void holdsResettableTerminalFramesAndStartsSuccessorsOnlyAfterCompletion() {
+        for (final boolean resettable : new boolean[] {true, false}) {
+            final var flipbook = flipbook();
+            flipbook.addProperty("looping", false);
+            flipbook.addProperty("resettable", resettable);
+            flipbook.addProperty("reset_event", "reset");
+            flipbook.addProperty("next_index", 1);
+            final var alpha = JsonParser.parseString("{\"anim_type\":\"alpha\",\"from\":1,\"to\":0,\"duration\":1}").getAsJsonObject();
+            final var node = node(flipbook, alpha);
+            final var roots = new JsonArray(); roots.add(0);
+            node.properties().getAsJsonObject("animation_program").add("roots", roots);
+            final var animations = new NativeUiAnimations();
+            for (int i = 1; i <= 5; i++) animations.advance(node, i * 250_000_000L);
+            assertEquals(resettable ? 1 : .75F, animations.opacityAt(node, 1_250_000_000).current());
+            assertEquals(192.00390625F, animations.source(node, 256, 128).u());
+            if (resettable) {
+                animations.event(node, "reset", 1_250_000_000);
+                animations.advance(node, 1_500_000_000);
+                assertEquals(64.00390625F, animations.source(node, 256, 128).u());
+            }
+        }
+    }
+
+    private static JsonObject flipbook() {
+        return JsonParser.parseString("{\"anim_type\":\"flip_book\",\"fps\":4,\"frame_count\":4}").getAsJsonObject();
+    }
+
+    private static NativeUiScene.Node node(final JsonObject... definitions) {
+        final var properties = new JsonObject();
+        final var tracks = new JsonArray();
+        for (final var definition : definitions) tracks.add(definition.deepCopy());
+        AnimationPrograms.attach(properties, tracks, false);
+        return new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE);
+    }
+}
