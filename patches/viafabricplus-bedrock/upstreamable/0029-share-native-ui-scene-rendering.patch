+            final String stylesheet = descriptor.get("stylesheet").getAsString();
+            if (descriptor.get("format").getAsInt() != 1 || !descriptor.get("version").getAsString().equals("1.26.60.5")
+                    || !stylesheet.matches("hbui/gameplay-[0-9a-f]+\\.css")) throw new IOException("Invalid OreUI descriptor");
