+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+final class NativeUiImagesTest {
+    @Test
+    void drawsNineSliceInteriorsThatSampleOneTexturePointButSkipsEmptyDestinations() {
+        // The native 1.26.60.5 Black texture is 2x2 with one-pixel borders and a 2x2 base.
+        final JsonObject properties = new JsonObject();
+        properties.addProperty("texture", texture(0));
+        properties.addProperty("nineslice_size", 1);
+        final var node = new NativeUiScene.Node("background", "image", properties, List.of(), Integer.MIN_VALUE);
+        final var id = Identifier.parse(texture(0));
+        final var graphics = mock(GuiGraphicsExtractor.class);
+        final var animations = new NativeUiAnimations();
+        try (final var images = spy(new NativeUiImages())) {
+            doReturn(new NativeUiImages.Image(id, 2, 2, null)).when(images).image(node);
+            final var bounds = new NativeUiLayout.Rect(0, 0, 640, 360);
+            final var box = new NativeUiLayout.Box(node, bounds, bounds, new NativeUiLayout.Size(2, 2), bounds, 0, List.of());
+            images.draw(graphics, box, 0xFFFFFFFF, animations);
+            verify(graphics).innerBlit(RenderPipelines.GUI_TEXTURED, id, 1, 639, 1, 359,
+                .5F, .5F, .5F, .5F, 0xFFFFFFFF);
+
+            clearInvocations(graphics);
+            final var empty = new NativeUiLayout.Rect(0, 0, 0, 360);
+            images.draw(graphics, new NativeUiLayout.Box(node, empty, bounds, new NativeUiLayout.Size(2, 2), empty, 0, List.of()),
+                0xFFFFFFFF, animations);
+            verifyNoInteractions(graphics);
+        }
+    }
+
+    @ParameterizedTest
+    @CsvSource({"16,12", "963,5916"})
+    void retainsFrameStripsAcrossMetadataEvictionAndSourceReload(final int width, final int height) throws Exception {
+        final var game = mock(Minecraft.class);
+        final var resources = mock(ResourceManager.class);
+        final var resource = mock(Resource.class);
+        final var originalSource = mock(PackResources.class);
+        when(game.getResourceManager()).thenReturn(resources);
+        when(resources.getResource(any())).thenReturn(Optional.of(resource));
+        when(resource.source()).thenReturn(originalSource);
+        when(resource.open()).thenAnswer(_ -> new ByteArrayInputStream(new byte[0]));
+        final var pixels = mock(NativeImage.class);
+        when(pixels.getWidth()).thenReturn(width);
+        when(pixels.getHeight()).thenReturn(height);
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var decoder = mockStatic(NativeImage.class);
+             final var images = new NativeUiImages()) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            final var first = images.image(texture(0));
+            for (int i = 1; i < 256; i++) assertNotNull(images.image(texture(i)));
+            assertSame(first, images.image(texture(0)));
+            assertNotNull(images.image(texture(256)));
+            assertSame(first, images.image(texture(0)));
+            verify(resource, times(257)).open();
+            assertNotNull(images.image(texture(1)));
+            verify(resource, times(258)).open();
+            assertFalse(images.failed());
+
+            final var replacementSource = mock(PackResources.class);
+            when(resource.source()).thenReturn(replacementSource);
+            final var replacement = images.image(texture(0));
+            assertNotSame(first, replacement);
+            assertSame(replacementSource, replacement.source());
+            assertEquals(width, replacement.width());
+            assertEquals(height, replacement.height());
+            verify(resource, times(259)).open();
+        }
+    }
+
+    @Test
+    void hidesAuthoredMissingDecorationsAndRecoversRequiredImagesWhenTheirSourceChanges() throws Exception {
+        final var game = mock(Minecraft.class);
+        final var resources = mock(ResourceManager.class);
+        when(game.getResourceManager()).thenReturn(resources);
+        when(resources.getResource(any())).thenReturn(Optional.empty());
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var decoder = mockStatic(NativeImage.class);
+             final var images = new NativeUiImages()) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final JsonObject properties = new JsonObject();
+            properties.addProperty("texture", texture(0));
+            properties.addProperty("allow_debug_missing_texture", false);
+            final var decoration = new NativeUiScene.Node("decoration", "image", properties, List.of(), Integer.MIN_VALUE);
+            assertNull(images.image(decoration));
+            assertFalse(images.failed());
+            properties.remove("allow_debug_missing_texture");
+            assertThrows(IllegalArgumentException.class, () -> images.image(decoration));
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            assertTrue(images.failed());
+
+            final var resource = mock(Resource.class);
+            when(resources.getResource(any())).thenReturn(Optional.of(resource));
+            when(resource.source()).thenReturn(mock(PackResources.class));
+            when(resource.open()).thenThrow(new IOException());
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            verify(resource).open();
+
+            final var pixels = mock(NativeImage.class);
+            when(pixels.getWidth()).thenReturn(16);
+            when(pixels.getHeight()).thenReturn(12);
+            when(resource.source()).thenReturn(mock(PackResources.class));
+            doAnswer(_ -> new ByteArrayInputStream(new byte[0])).when(resource).open();
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            final var restored = images.image(texture(0));
+            assertNotNull(restored);
+            assertEquals(16, restored.width());
+            assertEquals(12, restored.height());
+        }
+    }
+
+    @ParameterizedTest
+    @CsvSource({"8192,8192", "16385,1"})
+    void decodedImagesKeepThePixelBudgetAndDimensionBound(final int width, final int height) throws Exception {
+        final var game = mock(Minecraft.class);
+        final var resources = mock(ResourceManager.class);
+        final var resource = mock(Resource.class);
+        when(game.getResourceManager()).thenReturn(resources);
+        when(resources.getResource(any())).thenReturn(Optional.of(resource));
+        when(resource.source()).thenReturn(mock(PackResources.class));
+        when(resource.open()).thenAnswer(_ -> new ByteArrayInputStream(new byte[0]));
+        final var pixels = mock(NativeImage.class);
+        when(pixels.getWidth()).thenReturn(width);
+        when(pixels.getHeight()).thenReturn(height);
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var decoder = mockStatic(NativeImage.class);
+             final var images = new NativeUiImages()) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            decoder.when(() -> NativeImage.read(any(InputStream.class))).thenReturn(pixels);
+            assertThrows(IllegalArgumentException.class, () -> images.image(texture(0)));
+            assertTrue(images.failed());
+            verify(pixels).close();
+        }
+    }
+
+    private static String texture(final int index) {
+        return "viabedrock:textures/server_ui/icon_" + index + ".png";
+    }
+}
