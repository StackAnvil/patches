+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.renderpearl.api.GpuFormat;
+import com.mojang.renderpearl.api.pipeline.BlendFunction;
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import java.util.Optional;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+
+/** Dedicated GUI vertex payload: float tint and coverage, pixel atlas coordinates, and native text programs. */
+public final class OreUiPipeline {
+    private static final RenderPipeline[][] PIPELINES = {{create(false, false), create(false, true)},
+            {create(true, false), create(true, true)}};
+    private OreUiPipeline() { }
+
+    public static RenderPipeline get(final boolean sdf, final boolean linearTint) {
+        return PIPELINES[sdf ? 1 : 0][linearTint ? 1 : 0];
+    }
+
+    private static RenderPipeline create(final boolean sdf, final boolean linearTint) {
+        final var original = RenderPipelines.GUI_TEXTURED;
+        final var format = VertexFormat.builder(0)
+                .addAttribute(DefaultVertexFormat.POSITION_SEMANTIC_NAME, GpuFormat.RGB32_FLOAT)
+                .addAttribute(DefaultVertexFormat.UV0_SEMANTIC_NAME, GpuFormat.RG32_FLOAT)
+                .addAttribute(DefaultVertexFormat.UV1_SEMANTIC_NAME, GpuFormat.RG16_SINT)
+                .addAttribute(DefaultVertexFormat.UV3_SEMANTIC_NAME, GpuFormat.RG32_FLOAT)
+                .addAttribute(DefaultVertexFormat.LINE_WIDTH_SEMANTIC_NAME, GpuFormat.R32_FLOAT).build();
+        final var colors = original.getColorTargetStates().stream().map(color -> new ColorTargetState(
+                Optional.of(BlendFunction.TRANSLUCENT_PREMULTIPLIED_ALPHA), color.format(), color.writeMask())).toArray(ColorTargetState[]::new);
+        final var snippet = new RenderPipeline.Snippet(original.getShaders(), Optional.of(original.getShaderDefines()),
+                Optional.of(original.getBindGroupLayouts()), colors, colors.length, Optional.ofNullable(original.getDepthStencilState()),
+                Optional.of(original.getPolygonMode()), Optional.of(original.isCull()),
+                original.getVertexFormatBindings().toArray(VertexFormat[]::new), Optional.of(original.getPrimitiveTopology()), original.pushConstantSize());
+        final var builder = RenderPipeline.builder(snippet)
+                .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/oreui_font/"
+                        + (sdf ? "sdf" : "bitmap") + (linearTint ? "/linear" : "/encoded")))
+                .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_oreui_font"))
+                .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_oreui_font"))
+                .withVertexBinding(0, format);
+        if (sdf) builder.withShaderDefine("OREUI_SDF");
+        if (linearTint) builder.withShaderDefine("OREUI_LINEAR_TINT");
+        return builder.build();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiShaper.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiShaper.java
