+    @Override
+    public ComponentPath nextFocusPath(final FocusNavigationEvent event) {
+        if (!(event instanceof FocusNavigationEvent.ArrowNavigation arrow)) return super.nextFocusPath(event);
+        final NativeUiFocus.Direction direction = switch (arrow.direction()) {
+            case UP -> NativeUiFocus.Direction.UP;
+            case DOWN -> NativeUiFocus.Direction.DOWN;
+            case LEFT -> NativeUiFocus.Direction.LEFT;
+            case RIGHT -> NativeUiFocus.Direction.RIGHT;
+        };
