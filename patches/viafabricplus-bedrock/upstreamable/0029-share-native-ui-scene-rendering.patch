@@ -0,0 +1,47 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** Native image flipbooks consume at most one frame interval per update. */
+final class NativeUiFlipbook {
+    private final float interval;
+    private final int count;
+    private final boolean looping, reversible, vertical;
+    private float elapsed, frame;
+    private boolean reversed;
+
+    NativeUiFlipbook(final float fps, final int count, final boolean looping, final boolean reversible, final boolean vertical) {
+        this.interval = 1 / Math.max(.1F, fps);
+        this.count = count;
+        this.looping = looping;
+        this.reversible = reversible;
+        this.vertical = vertical;
+    }
+
+    boolean advance(final float delta) {
+        final float next = this.frame + 1;
+        if (next >= this.count && !this.looping) return false;
+        this.elapsed += delta;
+        if (this.elapsed >= this.interval) {
+            this.elapsed -= this.interval;
+            this.frame = next;
+            if (next >= this.count) {
+                this.frame = 0;
+                if (this.reversible) this.reversed = !this.reversed;
+            }
+        }
+        return true;
+    }
+
+    void reset() {
+        // The target reset clears the frame clock, but retains the current direction.
+        this.elapsed = this.frame = 0;
+    }
+
+    float position() { return this.reversed ? this.count - this.frame - 1 : this.frame; }
+    int frames() { return this.count; }
+    boolean vertical() { return this.vertical; }
+}
