+package com.viaversion.viafabricplus.bedrock.render.font;
+
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.renderpearl.api.GpuFormat;
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderPipelines;
+import java.util.Optional;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+
+/** Native point-sampled bitmap and smoothed Unicode GUI programs. */
+public final class BedrockBitmapPipeline {
+    static final RenderPipeline GUI = create(false);
+    static final RenderPipeline GUI_SMOOTH = create(true);
+
+    private BedrockBitmapPipeline() { }
+
+    public static boolean isSmoothed(final RenderPipeline pipeline) { return pipeline == GUI_SMOOTH; }
+
+    private static RenderPipeline create(final boolean smooth) {
+        final RenderPipeline original = RenderPipelines.GUI_TEXT;
+        final var format = VertexFormat.builder(0);
+        for (final var element : original.getVertexFormatBindings().getFirst().getElements()) {
+            format.addAttribute(element.name(), element.format());
+        }
+        format.addAttribute(DefaultVertexFormat.UV1_SEMANTIC_NAME, GpuFormat.RG16_SINT);
+        format.addAttribute(DefaultVertexFormat.UV3_SEMANTIC_NAME, GpuFormat.RG32_FLOAT);
+        final ColorTargetState[] colors = original.getColorTargetStates().toArray(ColorTargetState[]::new);
+        final var snippet = new RenderPipeline.Snippet(original.getShaders(), Optional.of(original.getShaderDefines()),
+                Optional.of(original.getBindGroupLayouts()), colors, colors.length, Optional.ofNullable(original.getDepthStencilState()),
+                Optional.of(original.getPolygonMode()), Optional.of(original.isCull()),
+                original.getVertexFormatBindings().toArray(VertexFormat[]::new), Optional.of(original.getPrimitiveTopology()),
+                original.pushConstantSize());
+        final var builder = RenderPipeline.builder(snippet)
+                .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/bitmap_font" + (smooth ? "/smooth" : "/bitmap")))
+                .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_bitmap_font"))
+                .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_bitmap_font"))
+                .withVertexBinding(0, format.build());
+        if (smooth) builder.withShaderDefine("BITMAP_SMOOTH");
+        return BedrockShaderPipelines.register(builder.build(), original);
+    }
+}
