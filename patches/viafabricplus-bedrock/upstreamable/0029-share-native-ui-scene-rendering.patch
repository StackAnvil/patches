+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiButton.java
@@ -0,0 +1,167 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.BiConsumer;
+
+/** Button appearance is independent of edit-box selection and mapping activation. */
+public record NativeUiButton(boolean consumeEvent, List<String> controls) {
+    public NativeUiButton {
+        controls = List.copyOf(controls);
+        if (controls.size() != 4) throw new IllegalArgumentException("Expected four native Button states");
+    }
+
+    public static NativeUiButton parse(final JsonObject properties) {
+        final List<String> controls = new ArrayList<>();
+        for (final String name : List.of("default_control", "hover_control", "pressed_control", "locked_control")) {
+            final var value = properties.get(name);
+            controls.add(value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "");
+        }
+        return new NativeUiButton(NativeUiScene.flag(properties, "consume_event", true), controls);
+    }
+
+    public int handlerMask(final boolean enabled) { return enabled && !this.consumeEvent ? 1 : 0; }
+
+    public static final class State {
+        private final NativeUiButton definition;
+        private final BiConsumer<NativeUiScene.Node, Boolean> visibility;
+        private final Reference[] controls = new Reference[4];
+        private NativeUiScene.Node owner;
+        private boolean pressed;
+        private boolean visualPressed;
+        private boolean visualHovered;
+        private boolean visualEnabled;
+        private long revision;
+
+        public State(final NativeUiButton definition, final NativeUiScene.Node owner, final boolean enabled, final boolean hovered) {
+            this(definition, State::writeVisibility);
+            this.attach(owner, enabled, hovered);
+        }
+
+        /** Native components exist before deferred references bind their named controls. */
+        public State(final NativeUiButton definition, final BiConsumer<NativeUiScene.Node, Boolean> visibility) {
+            this.definition = Objects.requireNonNull(definition);
+            this.visibility = Objects.requireNonNull(visibility);
+        }
+
+        public boolean pressed() { return this.pressed; }
+        public long revision() { return this.revision; }
+
+        /** Replacing a Java scene node does not produce another native input or property event. */
+        public void attach(final NativeUiScene.Node owner, final boolean enabled, final boolean hovered) {
+            if (this.owner == owner) return;
+            final boolean initial = this.owner == null;
+            this.owner = owner;
+            if (this.resolve(owner) || initial) this.update(enabled, hovered);
+            else this.apply(State::writeVisibility);
+        }
+
+        public void button(final NativeUiInput.ButtonEvent event, final boolean enabled, final boolean hovered) {
+            if (!enabled || event.phase() != 0 && event.phase() != 1) return;
+            final boolean pressed = event.phase() == 1;
+            if (this.pressed == pressed) return;
+            this.pressed = pressed;
+            if (pressed ? event.handleSelect() : event.handleDeselect()) this.update(enabled, hovered);
+        }
+
+        public void hover(final boolean hovered, final boolean enabled) {
+            if (!enabled) return;
+            if (!hovered) this.pressed = false;
+            this.update(enabled, hovered);
+        }
+
+        public void reset(final boolean enabled, final boolean hovered) {
+            if (!enabled) return;
+            this.pressed = false;
+            this.update(enabled, hovered);
+        }
+
+        public void visibility(final boolean visible, final boolean enabled, final boolean hovered) {
+            if (visible) return;
+            this.pressed = false;
+            this.update(enabled, hovered);
+        }
+
+        public void enabled(final boolean enabled) {
+            if (!enabled) this.pressed = false;
+        }
+
+        public void general(final int kind, final boolean enabled, final boolean hovered) {
+            if (kind == 17) this.update(enabled, hovered);
+        }
+
+        private void update(final boolean enabled, final boolean hovered) {
+            this.visualEnabled = enabled;
+            this.visualHovered = hovered;
+            this.visualPressed = this.pressed;
+            this.apply();
+        }
+
+        private void apply() {
+            this.apply(this.visibility);
+        }
+
+        private void apply(final BiConsumer<NativeUiScene.Node, Boolean> visibility) {
+            // Setter order matters when authored state names resolve to the same control.
+            if (this.visualEnabled) {
+                this.visible(3, false, visibility);
+                this.visible(2, this.visualPressed, visibility);
+                this.visible(1, !this.visualPressed && this.visualHovered, visibility);
+                this.visible(0, !this.visualPressed && !this.visualHovered, visibility);
+            } else {
+                this.visible(3, true, visibility);
+                this.visible(0, this.controls[3] == null, visibility);
+                this.visible(2, false, visibility);
+                this.visible(1, false, visibility);
+            }
+        }
+
+        private static void writeVisibility(final NativeUiScene.Node node, final boolean visible) {
+            node.properties().addProperty("visible", visible);
+        }
+
+        private void visible(final int index, final boolean visible, final BiConsumer<NativeUiScene.Node, Boolean> visibility) {
+            final var control = this.controls[index];
+            if (control != null && control.node.flag("visible", true) != visible) {
+                visibility.accept(control.node, visible);
+                this.revision++;
+            }
+        }
+
+        private boolean resolve(final NativeUiScene.Node owner) {
+            final Reference[] resolved = new Reference[4];
+            final ArrayDeque<Reference> pending = new ArrayDeque<>();
+            pending.add(new Reference(owner, List.of()));
+            while (!pending.isEmpty()) {
+                final var candidate = pending.removeFirst();
+                for (int state = 0; state < resolved.length; state++) {
+                    final String name = this.definition.controls.get(state);
+                    if (resolved[state] == null && !name.isEmpty() && name.equals(candidate.node.name())) resolved[state] = candidate;
+                }
+                for (int index = 0; index < candidate.node.children().size(); index++) {
+                    final List<Integer> path = new ArrayList<>(candidate.path);
+                    path.add(index);
+                    pending.addLast(new Reference(candidate.node.children().get(index), List.copyOf(path)));
+                }
+            }
+            boolean changed = false;
+            for (int state = 0; state < resolved.length; state++) {
+                final var old = this.controls[state];
+                final var next = resolved[state];
+                changed |= !Objects.equals(old == null ? null : old.path, next == null ? null : next.path);
+                this.controls[state] = next;
+            }
+            return changed;
+        }
+
+        private record Reference(NativeUiScene.Node node, List<Integer> path) {}
+    }
+}
