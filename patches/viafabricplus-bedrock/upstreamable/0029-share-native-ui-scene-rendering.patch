+
+class BedrockTrueTypeFontTest {
+    // Original Bedrock 1.26.60.5 raster controls for this authored, six-glyph test font.
+    private static final String RECTANGLE = "193333333333230a59b2b2b2b2b27c237fffffffffffb2337fffffffffffb233"
+            + "7fffffffffffb2337fffffffffffb2337fffffffffffb2333f7f7f7f7f7f5919";
+    private static final String TRANSLATED = "19597f7f7f7f7f3f33b2ffffffffff7f33b2ffffffffff7f33b2ffffffffff7f"
+            + "33b2ffffffffff7f33b2ffffffffff7f237cb2b2b2b2b2590a23333333333319";
+
+    private static byte[] fixture() throws IOException {
+        try (var stream = BedrockTrueTypeFontTest.class.getResourceAsStream("/font/native-outline-fixture.ttf")) {
+            assertNotNull(stream);
+            return stream.readAllBytes();
+        }
+    }
+
+    private static GpuTextureView texture() {
+        final var texture = mock(GpuTextureView.class);
+        when(texture.getWidth(0)).thenReturn(256);
+        when(texture.getHeight(0)).thenReturn(256);
+        return texture;
+    }
+
+    @Test
+    void matchesNativeRasterForRectanglesCurvesAndUnshiftedCompositeCoordinates() throws Exception {
+        try (var raster = new BedrockTrueTypeRaster(fixture(), 32)) {
+            final var plain = raster.raster(65);
+            final var translated = raster.raster(67);
+            assertArrayEquals(HexFormat.of().parseHex(RECTANGLE), plain.pixels());
+            assertArrayEquals(HexFormat.of().parseHex(TRANSLATED), translated.pixels());
+            assertEquals(8, plain.width());
+            assertEquals(8, translated.height());
+            assertEquals(3, plain.advance());
+            assertEquals(-.09375F, plain.left());
+            assertEquals(.09375F, translated.left());
+            final var scaled = raster.raster(68);
+            assertArrayEquals(HexFormat.of().parseHex("0000000000253b16000064a13c00007fcc4c00007fcc4c00003f66260000"), scaled.pixels());
+            assertEquals(5, scaled.width());
+            assertEquals(6, scaled.height());
+        }
+        try (var raster = new BedrockTrueTypeRaster(fixture(), 8)) {
+            final var curve = raster.raster(66);
+            assertArrayEquals(HexFormat.of().parseHex("0000000000000000000004222608002e8c9b3f022a6a753702"), curve.pixels());
+            assertEquals(5, curve.width());
+            assertEquals(5, curve.height());
+        }
+    }
+
+    @Test
+    void clearsReservedGlyphGuttersAndKeepsUploadsInsideTheAtlas() throws Exception {
+        try (var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(fixture(), 32), "");
+             var system = mockStatic(RenderSystem.class)) {
+            final var texture = mock(GpuTexture.class);
+            when(texture.getWidth(0)).thenReturn(20);
+            when(texture.getHeight(0)).thenReturn(20);
+            final var device = mock(GpuDevice.class);
+            final var encoder = mock(CommandEncoder.class);
+            system.when(RenderSystem::getDevice).thenReturn(device);
+            when(device.createCommandEncoder()).thenReturn(encoder);
+            final var uploads = new ArrayList<byte[]>();
+            final var dimensions = new ArrayList<List<Integer>>();
+            doAnswer(call -> {
+                final NativeImage image = call.getArgument(1);
+                final byte[] pixels = new byte[image.getWidth() * image.getHeight()];
+                image.getPixelBytes().get(pixels);
+                uploads.add(pixels);
+                dimensions.add(List.of(image.getWidth(), image.getHeight()));
+                return null;
+            }).when(encoder).writeToTexture(same(texture), any(NativeImage.class), eq(0), eq(0), anyInt(), anyInt());
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            when(stitcher.stitch(any(), any())).thenAnswer(call -> {
+                final GlyphBitmap bitmap = call.getArgument(1);
+                bitmap.upload(5, 7, texture);
+                bitmap.upload(12, 12, texture);
+                return mock(BakedGlyph.class);
+            });
+            font.getGlyph(65).bake(stitcher);
+            assertEquals(List.of(List.of(9, 9), List.of(8, 8)), dimensions);
+            assertArrayEquals(HexFormat.of().parseHex("193333333333230a00"
+                    + "59b2b2b2b2b27c2300" + "7fffffffffffb23300" + "7fffffffffffb23300"
+                    + "7fffffffffffb23300" + "7fffffffffffb23300" + "7fffffffffffb23300"
+                    + "3f7f7f7f7f7f591900" + "000000000000000000"), uploads.getFirst());
+            assertArrayEquals(HexFormat.of().parseHex(RECTANGLE), uploads.getLast());
+        }
+    }
+
+    @Test
+    void preservesNativeAtlasSamplingWhenJavaRelocatesGlyphs() throws Exception {
+        try (var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(fixture(), 32), "")) {
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            final var texture = texture();
+            when(stitcher.stitch(any(), any())).thenAnswer(call -> {
+                final GlyphInfo info = call.getArgument(0);
+                final GlyphBitmap bitmap = call.getArgument(1);
+                return new BakedSheetGlyph(info, null, texture, 1 / 256F, 9 / 256F, 17 / 256F, 25 / 256F,
+                        bitmap.getLeft(), bitmap.getRight(), bitmap.getTop(), bitmap.getBottom());
+            });
+            final var glyph = font.getGlyph(65).bake(stitcher).createGlyph(0, 0, -1, 0, Style.EMPTY, 0, 0);
+            final var gui = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(new Matrix4f(), gui, 0, true);
+            final var u = ArgumentCaptor.forClass(Float.class);
+            final var v = ArgumentCaptor.forClass(Float.class);
+            verify(gui, times(4)).setUv(u.capture(), v.capture());
+            // Original 1.26.60.5 shelf places A at [5,1..13,9] on a 256 page.
+            // Retain its captured fixed-point sample phase at Java's [1,17..9,25].
+            assertEquals(List.of(.003906548F, .003906548F, .035157025F, .035157025F), u.getAllValues());
+            assertEquals(List.of(.06640631F, .09765679F, .09765679F, .06640631F), v.getAllValues());
+            final var world = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(new Matrix4f(), world, 0, false);
+            final var worldU = ArgumentCaptor.forClass(Float.class);
+            verify(world, times(4)).setUv(worldU.capture(), anyFloat());
+            assertEquals(List.of(1 / 256F, 1 / 256F, 9 / 256F, 9 / 256F), worldU.getAllValues());
+        }
+    }
+
+    @Test
+    void submitsCachePrecisionBeforeTheDisplayTransformAndPreservesWorldVertices() throws Exception {
+        try (var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(fixture(), 32), "")) {
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            when(stitcher.stitch(any(), any())).thenAnswer(call -> {
+                final GlyphInfo info = call.getArgument(0);
+                final GlyphBitmap bitmap = call.getArgument(1);
+                return new BakedSheetGlyph(info, null, texture(), 0, 1, 0, 1,
+                        bitmap.getLeft(), bitmap.getRight(), bitmap.getTop(), bitmap.getBottom());
+            });
+            final var glyph = font.getGlyph(65).bake(stitcher).createGlyph(28.325806F, 0, -1, 0, Style.EMPTY, 0, 0);
+            final var pose = new Matrix4f().scaling(2);
+            final var nativeVertices = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(pose, nativeVertices, 0, true);
+            final var nativeX = ArgumentCaptor.forClass(Float.class);
+            verify(nativeVertices, times(4)).addVertex(same(pose), nativeX.capture(), anyFloat(), anyFloat());
+            assertEquals(List.of(28.2421875F, 28.2421875F, 29.7421875F, 29.7421875F), nativeX.getAllValues());
+            final var worldVertices = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(pose, worldVertices, 0, false);
+            final var worldX = ArgumentCaptor.forClass(Float.class);
+            verify(worldVertices, times(4)).addVertex(same(pose), worldX.capture(), anyFloat(), anyFloat());
+            assertEquals(28.232056F, worldX.getAllValues().getFirst());
+            assertNotEquals(nativeX.getAllValues(), worldX.getAllValues());
+        }
+    }
+
+    @Test
+    void usesFixedNativeItalicEdgesInGuiAndPreservesWorldGeometry() throws Exception {
+        try (var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(fixture(), 32), "")) {
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            final BakedSheetGlyph[] sheet = new BakedSheetGlyph[1];
+            when(stitcher.stitch(any(), any())).thenAnswer(call -> {
+                final GlyphInfo info = call.getArgument(0);
+                final GlyphBitmap bitmap = call.getArgument(1);
+                sheet[0] = new BakedSheetGlyph(info, null, texture(), 0, 1, 0, 1,
+                        bitmap.getLeft(), bitmap.getRight(), bitmap.getTop(), bitmap.getBottom());
+                return sheet[0];
+            });
+            final var style = Style.EMPTY.withItalic(true);
+            final var glyph = font.getGlyph(65).bake(stitcher).createGlyph(0, 0, -1, 0, style, 0, 0);
+            final var pose = new Matrix4f();
+            final var gui = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(pose, gui, 0, true);
+            final var guiX = ArgumentCaptor.forClass(Float.class);
+            verify(gui, times(4)).addVertex(same(pose), guiX.capture(), anyFloat(), anyFloat());
+            // Native 1.26.60.5 quad expansion: top +1, bottom -1 before the 1.5 display transform.
+            assertEquals(List.of(1.40625F, -1.59375F, -.09375F, 2.90625F), guiX.getAllValues());
+            assertTrue(glyph.left() <= -1.59375F);
+            assertTrue(glyph.right() >= 2.90625F);
+            assertEquals(style, glyph.style());
+            final var fractional = font.getGlyph(65).bake(stitcher).createGlyph(.114990324F, 0, -1, 0, style, 0, 0);
+            final var fractionalVertices = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            fractional.render(pose, fractionalVertices, 0, true);
+            final var fractionalX = ArgumentCaptor.forClass(Float.class);
+            verify(fractionalVertices, times(4)).addVertex(same(pose), fractionalX.capture(), anyFloat(), anyFloat());
+            // Applying display-space shear before normalization rounds onto the other half-float.
+            assertEquals(1.5205078125F, fractionalX.getAllValues().getFirst());
+
+            final var world = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            final var originalWorld = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            glyph.render(pose, world, 0, false);
+            sheet[0].createGlyph(0, 0, -1, 0, style, 0, 0).render(pose, originalWorld, 0, false);
+            final var worldX = ArgumentCaptor.forClass(Float.class);
+            final var originalX = ArgumentCaptor.forClass(Float.class);
+            verify(world, times(4)).addVertex(same(pose), worldX.capture(), anyFloat(), anyFloat());
+            verify(originalWorld, times(4)).addVertex(same(pose), originalX.capture(), anyFloat(), anyFloat());
+            assertEquals(originalX.getAllValues(), worldX.getAllValues());
+            assertNotEquals(guiX.getAllValues(), worldX.getAllValues());
+        }
+    }
+
+    @Test
+    void ownsItsFontBytesAndRejectsUseAfterCloseAcrossReloads() throws Exception {
+        final byte[] bytes = fixture();
+        final var raster = new BedrockTrueTypeRaster(bytes, 32);
+        Arrays.fill(bytes, (byte) 0);
+        assertArrayEquals(HexFormat.of().parseHex(RECTANGLE), raster.raster(65).pixels());
+        raster.close();
+        raster.close();
+        assertThrows(IllegalStateException.class, () -> raster.raster(65));
+        try (var replacement = new BedrockTrueTypeRaster(fixture(), 32)) {
+            assertArrayEquals(HexFormat.of().parseHex(RECTANGLE), replacement.raster(65).pixels());
+        }
+    }
+
+    @Test
+    void rejectsUnsignedTableSpansAndBoundsGlyphWorkBeforeRasterization() throws Exception {
+        final byte[] truncated = fixture();
+        ByteBuffer.wrap(truncated).order(ByteOrder.BIG_ENDIAN).putInt(20, -1);
+        assertThrows(IOException.class, () -> new BedrockTrueTypeRaster(truncated, 32));
+        final byte[] oversized = fixture();
+        final var data = ByteBuffer.wrap(oversized).order(ByteOrder.BIG_ENDIAN);
+        final int glyphs = table(data, 0x676C7966);
+        data.putShort(glyphs + 6, Short.MAX_VALUE);
+        try (var raster = new BedrockTrueTypeRaster(oversized, 255)) {
+            assertThrows(IOException.class, () -> raster.raster(65));
+        }
+        final byte[] inconsistent = fixture();
+        final var bounds = ByteBuffer.wrap(inconsistent).order(ByteOrder.BIG_ENDIAN);
+        bounds.putShort(table(bounds, 0x676C7966) + 6, (short) 2);
+        try (var raster = new BedrockTrueTypeRaster(inconsistent, 32)) {
+            assertThrows(IOException.class, () -> raster.raster(65));
+        }
+    }
+
+    @Test
+    void rejectsCyclicComponentsAndUsesTheStitchersMissingGlyphForMalformedOutlines() throws Exception {
+        final byte[] bytes = fixture();
+        final var data = ByteBuffer.wrap(bytes).order(ByteOrder.BIG_ENDIAN);
+        final int composite = table(data, 0x676C7966) + data.getInt(table(data, 0x6C6F6361) + 4 * 4);
+        data.putShort(composite + 12, (short) 4);
+        try (var raster = new BedrockTrueTypeRaster(bytes, 32)) {
+            assertThrows(IOException.class, () -> raster.raster(67));
+        }
+        try (var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(bytes, 32), "")) {
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            final var missing = mock(BakedGlyph.class);
+            when(stitcher.getMissing()).thenReturn(missing);
+            assertSame(missing, font.getGlyph(67).bake(stitcher));
+            verify(stitcher).getMissing();
+            verifyNoMoreInteractions(stitcher);
+        }
+    }
+
+    @Test
+    void bakesNativeMetricsAndRetiresPreviouslyReturnedGlyphs() throws Exception {
+        final var font = new BedrockTrueTypeFont(new BedrockTrueTypeRaster(fixture(), 32), "B");
+        try {
+            assertNull(font.getGlyph(66));
+            final var glyph = font.getGlyph(65);
+            assertNotNull(glyph);
+            assertEquals(3, glyph.info().getAdvance());
+            final var stitcher = mock(UnbakedGlyph.Stitcher.class);
+            when(stitcher.stitch(any(), any())).thenReturn(mock(BakedGlyph.class));
+            assertNotNull(glyph.bake(stitcher));
+            final var bitmap = ArgumentCaptor.forClass(GlyphBitmap.class);
+            verify(stitcher).stitch(any(GlyphInfo.class), bitmap.capture());
+            assertEquals(8, bitmap.getValue().getPixelWidth());
+            assertEquals(32F / 6, bitmap.getValue().getOversample());
+            assertEquals(-.09375F, bitmap.getValue().getBearingLeft());
+            font.close();
+            assertNull(font.getGlyph(65));
+            assertThrows(IllegalStateException.class, () -> glyph.bake(stitcher));
+        } finally { font.close(); }
+    }
+
+    @Test
+    void usesTheSelectedFontsOwnDescriptorAndKeepsOlderExportsOnVanillaLoading() throws Exception {
+        final var id = Identifier.parse("viabedrock:server_ui/0123456789abcdef0123456789abcdef.ttf");
+        final var file = id.withPrefix("font/");
+        final var pack = mock(PackResources.class);
+        final var resources = mock(ResourceManager.class);
+        final byte[] bytes = fixture();
+        when(resources.getResourceOrThrow(file)).thenReturn(new Resource(pack, () -> new ByteArrayInputStream(bytes)));
+        assertNull(BedrockTrueTypeFont.load(resources, id, ""));
+        when(pack.getResource(PackType.CLIENT_RESOURCES, file.withSuffix(".mcmeta"))).thenReturn(() ->
+                new ByteArrayInputStream("{\"viabedrock:truetype\":{\"render_height\":32}}".getBytes(StandardCharsets.UTF_8)));
+        try (var font = BedrockTrueTypeFont.load(resources, id, "A")) {
+            assertInstanceOf(BedrockTrueTypeFont.class, font);
+            assertNull(font.getGlyph(65));
+            assertNotNull(font.getGlyph(66));
+        }
+        verify(resources, times(2)).getResourceOrThrow(file);
+        verifyNoMoreInteractions(resources);
+    }
+
+    private static int table(final ByteBuffer data, final int tag) {
+        for (int record = 12; record < 12 + data.getShort(4) * 16; record += 16) {
+            if (data.getInt(record) == tag) return data.getInt(record + 8);
+        }
+        throw new AssertionError("Missing test-font table");
+    }
+}
