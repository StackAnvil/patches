+            this.register("nominal", "nominal_glyph", FunctionDescriptor.of(JAVA_INT, ADDRESS, ADDRESS, JAVA_INT, ADDRESS, ADDRESS));
+            this.register("advance", "glyph_h_advance", FunctionDescriptor.of(JAVA_INT, ADDRESS, ADDRESS, JAVA_INT, ADDRESS));
+            this.register("extents", "glyph_extents", FunctionDescriptor.of(JAVA_INT, ADDRESS, ADDRESS, JAVA_INT, ADDRESS, ADDRESS));
+            this.register("contour", "glyph_contour_point", FunctionDescriptor.of(JAVA_INT, ADDRESS, ADDRESS, JAVA_INT, JAVA_INT, ADDRESS, ADDRESS, ADDRESS));
+            this.engine.run("hb_font_funcs_make_immutable", new MemoryLayout[]{P}, this.functions);
+            this.engine.run("hb_font_set_funcs", new MemoryLayout[]{P,P,P,P}, this.font, this.functions, NULL, NULL);
+        } catch (final IOException | RuntimeException | Error failure) {
+            try { this.close(); } catch (final RuntimeException | Error cleanup) { failure.addSuppressed(cleanup); }
