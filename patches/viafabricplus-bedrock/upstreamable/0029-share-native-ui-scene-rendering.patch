+                        vertices.add(new Vertex(vertex.type(),
+                                (short) (m * (component.a * vertex.x() + component.c * vertex.y() + component.x)),
+                                (short) (n * (component.b * vertex.x() + component.d * vertex.y() + component.y)),
+                                (short) (m * (component.a * vertex.cx() + component.c * vertex.cy() + component.x)),
+                                (short) (n * (component.b * vertex.cx() + component.d * vertex.cy() + component.y))));
+                    }
+                }
+            }
+            final var result = STBTTVertex.calloc(Math.max(1, vertices.size()));
+            for (final var vertex : vertices) vertex(result, vertex.type, vertex.x, vertex.y, vertex.cx, vertex.cy);
