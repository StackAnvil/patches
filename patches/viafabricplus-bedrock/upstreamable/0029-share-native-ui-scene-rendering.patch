@@ -0,0 +1,80 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** Applies the native label size multiplier to the selected font's metrics and drawing. */
+public final class NativeUiFont {
+    private NativeUiFont() {}
+
+    public static float scale(final NativeUiScene.Node node) {
+        final float multiplier = switch (node.string("font_size", "normal")) {
+            case "small" -> .5F;
+            case "large" -> 2F;
+            case "extra_large" -> 4F;
+            default -> 1F;
+        };
+        final float scale = multiplier * node.number("font_scale_factor", 1);
+        if (!Float.isFinite(scale) || scale < 0) throw new IllegalArgumentException("Unsupported native UI font scale");
+        return scale;
+    }
+
+    /** Snap the label origin in physical pixels before applying its font-size transform. */
+    public static Origin origin(final float x, final float y, final float fontScale, final int uiScale) {
+        return new Origin(snap(x, fontScale, uiScale), snap(y + 1, fontScale, uiScale));
+    }
+
+    public static Origin origin(final NativeUiScene.Node node, final float x, final float y,
+                                final float fontScale, final int uiScale) {
+        final float displayScale = node.number("font_origin_scale", 1);
+        if (!Float.isFinite(displayScale) || displayScale <= 0) {
+            throw new IllegalArgumentException("Unsupported native font origin scale");
+        }
+        final float grid = fontScale * displayScale;
+        if (!Float.isFinite(grid) || grid <= 0) {
+            throw new IllegalArgumentException("Unsupported native font origin grid");
+        }
+        return origin(x, y, grid, uiScale);
+    }
+
+    private static float snap(final float coordinate, final float fontScale, final int uiScale) {
+        // Native converts scaled float coordinates to integers before multiplying by the inverse scale.
+        return (int) (coordinate * (uiScale / fontScale)) * (fontScale / uiScale);
+    }
+
+    public record Origin(float x, float y) { }
+
+    public static int wrapWidth(final NativeUiScene.Node node, final float width) {
+        final float scale = scale(node);
+        return scale == 0 ? Integer.MAX_VALUE : Math.max(1, (int) (width / scale));
+    }
+
+    public static float lineHeight(final NativeUiScene.Node node) {
+        final float height = node.number("font_line_height", 10);
+        if (!Float.isFinite(height) || height <= 0 || height > 4096) {
+            throw new IllegalArgumentException("Unsupported native UI font line height");
+        }
+        return height;
+    }
+
+    /** Native labels admit rounded rows with a two-unit allowance on the final row. */
+    public static int visibleLines(final NativeUiScene.Node node, final float height) {
+        final float scale = scale(node);
+        if (scale == 0 || height < 0) return 0;
+        // Retain precision at the preceding float: float addition can round it onto the boundary.
+        return Math.max(0, (int) Math.floor(((double) height / scale + 2) / Math.ceil(lineHeight(node))));
+    }
+
+    public static NativeUiLayout.Size intrinsic(final NativeUiScene.Node node, final float width,
+                                             final int lines) {
+        final float scale = scale(node);
+        return new NativeUiLayout.Size(width * scale, lines * lineHeight(node) * scale);
+    }
+
+    public static NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width,
+                                               final int lines) {
+        return new NativeUiLayout.Size(width, lines * lineHeight(node) * scale(node));
+    }
+}
