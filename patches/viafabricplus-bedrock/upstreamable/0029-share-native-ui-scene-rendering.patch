@@ -0,0 +1,82 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiScissor;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+
+/** Retains native clip precision independently of Java's integer GUI coordinate grid. */
+public final class NativeUiScissor {
+    private final NativeUiLayout.Rect bounds;
+    private final ScreenRectangle pixels;
+
+    public NativeUiScissor(final NativeUiLayout.Rect bounds) {
+        this.bounds = bounds;
+        // Native intersects floating rectangles before truncating the origin and extent.
+        this.pixels = new ScreenRectangle((int) bounds.x(), (int) bounds.y(),
+            Math.max(0, (int) bounds.width()), Math.max(0, (int) bounds.height()));
+    }
+
+    public static NativeUiScissor scaled(final NativeUiLayout.Rect bounds, final int scale) {
+        return new NativeUiScissor(new NativeUiLayout.Rect(bounds.x() * scale, bounds.y() * scale,
+            bounds.width() * scale, bounds.height() * scale));
+    }
+
+    public NativeUiScissor intersect(final NativeUiScissor other) {
+        return new NativeUiScissor(this.bounds.intersect(other.bounds));
+    }
+
+    public ScreenRectangle pixels() { return this.pixels; }
+
+    public ScreenRectangle windowPixels(final int width, final int height) {
+        final int left = Math.clamp(this.pixels.left(), 0, width);
+        final int top = Math.clamp(this.pixels.top(), 0, height);
+        final int right = Math.clamp(this.pixels.right(), left, width);
+        final int bottom = Math.clamp(this.pixels.bottom(), top, height);
+        return new ScreenRectangle(left, top, right - left, bottom - top);
+    }
+
+    /** Conservative bounds for Java's overlap search; the render pass uses the exact pixels. */
+    public ScreenRectangle guiBounds(final int javaScale) {
+        final int left = Math.floorDiv(this.pixels.left(), javaScale);
+        final int top = Math.floorDiv(this.pixels.top(), javaScale);
+        if (this.pixels.width() == 0 || this.pixels.height() == 0) return new ScreenRectangle(left, top, 0, 0);
+        return new ScreenRectangle(left, top, Math.ceilDiv(this.pixels.right(), javaScale) - left,
+            Math.ceilDiv(this.pixels.bottom(), javaScale) - top);
+    }
+
+    public static boolean samePixels(final NativeUiScissor first, final NativeUiScissor second) {
+        return first == second || first != null && second != null && first.pixels.equals(second.pixels);
+    }
+
+    public static NativeUiScissor from(final ScreenRectangle rectangle) {
+        return rectangle == null ? null : ((IBedrockGuiScissor) (Object) rectangle).stackanvil$scissor();
+    }
+
+    /** The supplied rectangle is in absolute native layout units, before the Java pose scale. */
+    public static void enable(final GuiGraphicsExtractor graphics, final NativeUiLayout.Rect bounds) {
+        final var window = Minecraft.getInstance().getWindow();
+        final int javaScale = window.getGuiScale();
+        final var viewport = graphics instanceof NativeUiGraphics nativeGraphics
+            ? nativeGraphics.viewport() : NativeUiViewport.current();
+        NativeUiScissor clip = scaled(bounds, viewport.scale());
+        final var stack = graphics.scissorStack;
+        final var parent = stack.peek();
+        if (parent != null) {
+            final var nativeParent = from(parent);
+            clip = clip.intersect(nativeParent != null ? nativeParent : scaled(new NativeUiLayout.Rect(
+                parent.left(), parent.top(), parent.width(), parent.height()), javaScale));
+        }
+        clip = clip.intersect(new NativeUiScissor(new NativeUiLayout.Rect(0, 0, window.getWidth(), window.getHeight())));
+        final var rectangle = clip.guiBounds(javaScale);
+        ((IBedrockGuiScissor) (Object) rectangle).stackanvil$scissor(clip);
+        // push() intersects integer GUI bounds. That can discard pixels before the native clip
+        // reaches the render pass, and its shared empty rectangle cannot carry per-draw state.
+        stack.stack.addLast(rectangle);
+    }
+}
