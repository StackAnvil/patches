+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.Map;
+import java.util.Set;
+import java.util.List;
+import java.util.stream.Stream;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiBindings;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeUiCollectionWindowTest {
+    @Test
+    void distantCellsKeepTheirFullScrollExtentAndOriginalPositions() {
+        final var root = scene(5000, 716, 20, true);
+        final var box = layout(root, 72, 3240);
+        assertEquals(22500, box.content().height());
+        final var grid = box.children().getFirst();
+        assertEquals(-18, grid.children().getFirst().bounds().y());
+        assertEquals(0, grid.children().get(4).bounds().y());
+        assertEquals(new UiBindings.Window(716, 20), NativeUiCollectionWindow.visible(box).get("/view/grid"));
+        final var resized = layout(root, 108, 3240);
+        assertEquals(15012, resized.content().height());
+        assertEquals(new UiBindings.Window(1074, 30), NativeUiCollectionWindow.visible(resized).get("/view/grid"));
+        final var end = layout(scene(5000, 4984, 16, true), 72, 1_000_000);
+        assertEquals(new UiBindings.Window(4984, 16), NativeUiCollectionWindow.visible(end).get("/view/grid"));
+        assertEquals(36, end.children().getFirst().children().getLast().bounds().y());
+    }
+
+    @Test
+    void visibleWindowGeometryMatchesTheSameCellsInTheFullGrid() {
+        final var full = layout(scene(1000, 0, 1000, false), 72, 3240);
+        final var windowed = layout(scene(1000, 716, 20, true), 72, 3240);
+        assertEquals(full.content(), windowed.content());
+        assertEquals(full.children().getFirst().bounds(), windowed.children().getFirst().bounds());
+        for (int index = 0; index < 20; index++) {
+            final var expected = full.children().getFirst().children().get(716 + index);
+            final var actual = windowed.children().getFirst().children().get(index);
+            assertEquals(expected.bounds(), actual.bounds());
+            assertEquals(expected.visibleBounds(), actual.visibleBounds());
+        }
+    }
+
+    @Test
+    void aWindowCannotRedirectAnInstantiatedCellToAnotherSourceIndex() {
+        final var root = scene(1000, 716, 20, true);
+        root.children().getFirst().children().getFirst().properties().addProperty("collection_index", 4);
+        assertThrows(IllegalArgumentException.class, () -> layout(root, 72, 3240));
+    }
+
+    @Test
+    void aDistantViewportRetainsLogicalFocusAndTheSameNextRowAsTheFullGrid() {
+        final var original = scene(1000, 716, 20, true);
+        final var grid = original.children().getFirst();
+        final var properties = grid.properties().deepCopy();
+        properties.addProperty("collection_retained_start", 0);
+        properties.addProperty("collection_retained_count", 8);
+        final var retained = scene(1000, 0, 8, false).children().getFirst().children();
+        final var cells = Stream.concat(retained.stream(), grid.children().stream()).toList();
+        final var windowGrid = new NativeUiScene.Node(grid.name(), grid.type(), properties, cells, grid.action());
+        final var windowed = layout(scrollViewport(original, windowGrid), 72, 3240);
+        final var selected = retained.getFirst();
+        assertEquals(new UiBindings.Window(716, 20, 0, 8), NativeUiCollectionWindow.visible(windowed, selected).get("/view/grid"));
+        final var full = scene(1000, 0, 1000, false);
+        final var fullGrid = full.children().getFirst();
+        final var complete = layout(scrollViewport(full, fullGrid), 72, 3240);
+        final var reference = NativeUiFocus.next(NativeUiFocus.targets(complete, _ -> true), fullGrid.children().getFirst(),
+                NativeUiFocus.Direction.DOWN, 72, 54, new NativeUiFocus.History());
+        final var actual = NativeUiFocus.next(NativeUiFocus.targets(windowed, _ -> true), selected,
+                NativeUiFocus.Direction.DOWN, 72, 54, new NativeUiFocus.History());
+        assertEquals(4, reference.box().node().properties().get("collection_index").getAsInt());
+        assertEquals(4, actual.box().node().properties().get("collection_index").getAsInt());
+    }
+
+    private static NativeUiScene.Node scrollViewport(final NativeUiScene.Node root, final NativeUiScene.Node grid) {
+        final var properties = root.properties().deepCopy();
+        properties.addProperty("scroll_content", "grid");
+        properties.addProperty("scroll_view_port", "viewport");
+        final var viewport = node("viewport", "panel", "100%", "100%");
+        final var child = new NativeUiScene.Node("viewport", "panel", viewport, List.of(grid), Integer.MIN_VALUE);
+        return new NativeUiScene.Node(root.name(), root.type(), properties, List.of(child), root.action());
+    }
+
+    private static NativeUiLayout.Box layout(final NativeUiScene.Node root, final int width, final float scroll) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(root, width, 54, Map.of(root, scroll));
+    }
+
+    private static NativeUiScene.Node scene(final int total, final int start, final int count, final boolean windowed) {
+        final var root = node("view", "scroll_view", "100%", 54);
+        final var grid = node("grid", "grid", "100%", "default");
+        grid.addProperty("grid_item_template", "example.cell");
+        grid.addProperty("grid_rescaling_type", "horizontal");
+        grid.addProperty("anchor_from", "top_left");
+        grid.addProperty("anchor_to", "top_left");
+        if (windowed) {
+            grid.addProperty("collection_window_key", "/view/grid");
+            grid.addProperty("collection_size", total);
+            grid.addProperty("collection_start", start);
+            grid.addProperty("collection_count", count);
+            grid.add("collection_cell_size", pair(18, 18));
+        }
+        final var cells = new JsonArray();
+        for (int index = start; index < start + count; index++) {
+            final var cell = node("cell", "panel", 18, 18);
+            cell.addProperty("collection", "recipe_book");
+            cell.addProperty("collection_index", index);
+            cell.addProperty("focus_enabled", true);
+            cells.add(cell);
+        }
+        grid.add("children", cells);
+        final var children = new JsonArray();
+        children.add(grid);
+        root.add("children", children);
+        final var scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        return NativeUiScene.parse(scene.toString(), Set.of()).root();
+    }
+
+    private static JsonObject node(final String name, final String type, final Object width, final Object height) {
+        final var result = new JsonObject();
+        result.addProperty("name", name);
+        result.addProperty("type", type);
+        final var size = new JsonArray();
+        if (width instanceof Number value) size.add(value); else size.add(width.toString());
+        if (height instanceof Number value) size.add(value); else size.add(height.toString());
+        result.add("size", size);
+        return result;
+    }
+
+    private static JsonArray pair(final int width, final int height) {
+        final var result = new JsonArray();
+        result.add(width);
+        result.add(height);
+        return result;
+    }
+}
