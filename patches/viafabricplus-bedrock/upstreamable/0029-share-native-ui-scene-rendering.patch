+            if (FreeType.FT_New_Memory_Face(this.library, this.data, 0, pointer) != 0) throw new IOException("Invalid native TrueType font");
+            this.face = FT_Face.create(pointer.get(0));
+            if (this.face.num_glyphs() != this.tables.offsets.length - 1) throw new IOException("Inconsistent native font glyph count");
