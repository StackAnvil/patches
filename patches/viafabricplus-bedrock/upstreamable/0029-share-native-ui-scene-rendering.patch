+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.blaze3d.platform.cursor.CursorType;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.entity.state.EntityRenderState;
+import net.minecraft.client.renderer.state.gui.GuiRenderState;
+import org.joml.Quaternionfc;
+import org.joml.Vector3fc;
+
+/** Extracts native units into the shared Java GUI render state, including deferred tooltips. */
+public final class NativeUiGraphics extends GuiGraphicsExtractor {
+    private final NativeUiViewport viewport;
+    private final GuiGraphicsExtractor parent;
+
+    public NativeUiGraphics(final Minecraft client, final GuiRenderState state, final GuiGraphicsExtractor parent,
+                            final NativeUiViewport viewport, final int mouseX, final int mouseY) {
+        super(client, state, mouseX, mouseY);
+        this.viewport = viewport;
+        this.parent = parent;
+        this.pose().scale(viewport.renderScale(), viewport.renderScale());
+    }
+
+    // Super's constructor creates the initial scissor in the render state's Java coordinates.
+    @Override public int guiWidth() { return this.viewport == null ? super.guiWidth() : this.viewport.width(); }
+    @Override public int guiHeight() { return this.viewport == null ? super.guiHeight() : this.viewport.height(); }
+    @Override public void requestCursor(final CursorType cursor) { this.parent.requestCursor(cursor); }
+
+    @Override
+    public boolean containsPointInScissor(final int x, final int y) {
+        return super.containsPointInScissor(this.viewport.pixel(x), this.viewport.pixel(y));
+    }
+
+    @Override
+    public void entity(final EntityRenderState state, final float scale, final Vector3fc translation,
+                       final Quaternionfc rotation, final Quaternionfc cameraRotation,
+                       final int left, final int top, final int right, final int bottom) {
+        // Picture-in-picture extraction does not apply the 2D pose, unlike images, items and text.
+        super.entity(state, scale * this.viewport.renderScale(), translation, rotation, cameraRotation,
+            this.viewport.pixel(left), this.viewport.pixel(top), this.viewport.pixel(right), this.viewport.pixel(bottom));
+    }
+}
