+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScissor;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+import net.minecraft.client.gui.render.GuiRenderer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+@Mixin(GuiRenderer.class)
+public abstract class MixinNativeUiScissorRenderer {
+    @Inject(method = "executeDraw", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/render/GuiRenderer;enableScissor(Lnet/minecraft/client/gui/navigation/ScreenRectangle;Lcom/mojang/renderpearl/api/commands/RenderPass;)V"), cancellable = true)
+    private void skipEmptyNativeDraw(final CallbackInfo callback, @Local final ScreenRectangle rectangle) {
+        final var clip = NativeUiScissor.from(rectangle);
+        if (clip == null) return;
+        final var window = Minecraft.getInstance().gameRenderer.gameRenderState().windowRenderState;
+        final var pixels = clip.windowPixels(window.width, window.height);
+        // A clipped-out control must produce no fragments. Disabling its scissor would leak the draw.
+        if (pixels.width() == 0 || pixels.height() == 0) callback.cancel();
+    }
+
+    @Inject(method = "scissorChanged", at = @At("HEAD"), cancellable = true)
+    private void nativeBatch(final ScreenRectangle first, final ScreenRectangle second,
+                             final CallbackInfoReturnable<Boolean> callback) {
+        final var a = NativeUiScissor.from(first);
+        final var b = NativeUiScissor.from(second);
+        if (a != null || b != null) callback.setReturnValue(!NativeUiScissor.samePixels(a, b));
+    }
+
+    @Inject(method = "enableScissor", at = @At("HEAD"), cancellable = true)
+    private void nativePixels(final ScreenRectangle rectangle, final RenderPass pass, final CallbackInfo callback) {
+        final var clip = NativeUiScissor.from(rectangle);
+        if (clip == null) return;
+        final var window = Minecraft.getInstance().gameRenderer.gameRenderState().windowRenderState;
+        final var pixels = clip.windowPixels(window.width, window.height);
+        pass.enableScissor(pixels.left(), window.height - pixels.bottom(), pixels.width(), pixels.height());
+        callback.cancel();
+    }
+}
