+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/** Native newline and whitespace preprocessing retains offsets into the original UTF-16 source. */
+public record OreUiCharacters(List<Scalar> characters, int sourceLength, float trailingAdvance) {
+    public OreUiCharacters { characters = List.copyOf(characters); }
+
+    /** The native caller supplies this policy separately from the CSS white-space property. */
+    public enum LineEndings { NORMALIZE, REMOVE, IGNORE_CR }
+    public record Scalar(int value, int sourceOffset) { }
+
+    public static OreUiCharacters prepare(final String source, final LineEndings endings,
+                                         final OreUiLines.WhiteSpace whitespace, final float fontPixels, final float letterSpacing) {
+        Objects.requireNonNull(source); Objects.requireNonNull(endings); Objects.requireNonNull(whitespace);
+        if (source.length() > 32768 || !Float.isFinite(fontPixels) || fontPixels <= 0 || fontPixels > 1024
+                || !Float.isFinite(letterSpacing)) throw new IllegalArgumentException("Invalid OreUI text bounds");
+        final List<Scalar> decoded = new ArrayList<>();
+        boolean carriageReturn = false;
+        int count = 0;
+        for (int offset = 0; offset < source.length();) {
+            final char first = source.charAt(offset);
+            if (Character.isSurrogate(first) && (!Character.isHighSurrogate(first) || offset + 1 == source.length()
+                    || !Character.isLowSurrogate(source.charAt(offset + 1))))
+                throw new IllegalArgumentException("Invalid OreUI Unicode text");
+            if (++count > 16384) throw new IllegalArgumentException("OreUI text exceeds character limits");
+            final int value = source.codePointAt(offset), start = offset;
+            offset += Character.charCount(value);
+            if (value == '\r') {
+                if (endings == LineEndings.NORMALIZE) decoded.add(new Scalar('\n', start));
+                carriageReturn = true;
+            } else {
+                if (value != '\n' || endings != LineEndings.REMOVE
+                        && (endings != LineEndings.NORMALIZE || !carriageReturn)) decoded.add(new Scalar(value, start));
+                carriageReturn = false;
+            }
+        }
+        if (whitespace == OreUiLines.WhiteSpace.PRE || whitespace == OreUiLines.WhiteSpace.PRE_WRAP)
+            return new OreUiCharacters(decoded, source.length(), 0F);
+        float trailingAdvance = 0F;
+        if (!decoded.isEmpty() && horizontalSpace(decoded.getLast().value)) trailingAdvance = fontPixels * .25F + letterSpacing;
+        if (!Float.isFinite(trailingAdvance)) throw new IllegalArgumentException("Invalid OreUI trailing advance");
+        final List<Scalar> collapsed = new ArrayList<>();
+        for (final var scalar : decoded) {
+            if (horizontalSpace(scalar.value) || scalar.value == '\r' || scalar.value == '\n') {
+                if (!collapsed.isEmpty() && collapsed.getLast().value != ' ') collapsed.add(new Scalar(' ', scalar.sourceOffset));
+            } else collapsed.add(scalar);
+        }
+        if (!collapsed.isEmpty() && collapsed.getLast().value == ' ') collapsed.removeLast();
+        return new OreUiCharacters(collapsed, source.length(), trailingAdvance);
+    }
+
+    public int[] scalars() { return this.characters.stream().mapToInt(Scalar::value).toArray(); }
+    public String text() { return new String(this.scalars(), 0, this.characters.size()); }
+
+    /** The end of a processed range can still include removed characters at the end of its source. */
+    public int sourceOffset(final int scalarIndex) {
+        return scalarIndex == this.characters.size() ? this.sourceLength : this.characters.get(scalarIndex).sourceOffset;
+    }
+
+    private static boolean horizontalSpace(final int scalar) {
+        return scalar == 0 || scalar == '\t' || scalar == 0xb || scalar == 0xc || scalar == ' ';
+    }
+}
