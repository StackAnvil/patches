+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.client.Minecraft;
+
+/** Desktop GuiData units, independent of Java's HUD scale. */
+public record NativeUiViewport(int width, int height, int scale, float renderScale,
+                               double inputScaleX, double inputScaleY) {
+    /** Explicit drawing-only viewports have uniform input units without host-window rounding. */
+    public NativeUiViewport(final int width, final int height, final int scale, final float renderScale) {
+        this(width, height, scale, renderScale, 1D / renderScale, 1D / renderScale);
+    }
+
+    public static NativeUiViewport desktop(final int width, final int height, final int offset, final int javaScale) {
+        if (width < 1 || height < 1 || javaScale < 1)
+            throw new IllegalArgumentException("Invalid native UI viewport");
+        return desktop(width, height, offset, javaScale, Math.ceilDiv(width, javaScale), Math.ceilDiv(height, javaScale));
+    }
+
+    private static NativeUiViewport desktop(final int width, final int height, final int offset, final int javaScale,
+                                            final int inputWidth, final int inputHeight) {
+        if (width < 1 || height < 1 || javaScale < 1 || inputWidth < 1 || inputHeight < 1)
+            throw new IllegalArgumentException("Invalid native UI viewport");
+        // Target AppPlatform desktop type 0: minimum viewport 376 x 250, scale table 1..8.
+        final int maximum = Math.clamp(Math.min(width / 376, height / 250), 1, 8);
+        final int minimum = (maximum + 1) / 2;
+        final int scale = maximum + Math.clamp(offset, minimum - maximum, 0);
+        return new NativeUiViewport(Math.ceilDiv(width, scale), Math.ceilDiv(height, scale), scale,
+            (float) scale / javaScale, (double) width / inputWidth / scale, (double) height / inputHeight / scale);
+    }
+
+    public static NativeUiViewport current() {
+        final var window = Minecraft.getInstance().getWindow();
+        return desktop(window.getWidth(), window.getHeight(),
+            ViaFabricPlusBedrock.impl().settings().nativeUiScale().value().offset(), window.getGuiScale(),
+            window.getGuiScaledWidth(), window.getGuiScaledHeight());
+    }
+
+    public double pointerX(final double javaCoordinate) { return javaCoordinate * this.inputScaleX; }
+    public double pointerY(final double javaCoordinate) { return javaCoordinate * this.inputScaleY; }
+    public int pixel(final float nativeCoordinate) { return Math.round(nativeCoordinate * this.renderScale); }
+}
