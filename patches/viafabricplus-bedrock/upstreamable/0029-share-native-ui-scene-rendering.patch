+    private void synchronize(final List<NativeUiPresentation.Draw> draws) {
+        this.eligibleInputs.clear();
+        for (final Action action : this.actions.values()) action.visible = false;
+        for (final NativeInput input : this.inputs.values()) input.widget().visible = false;
+        for (final NativeUiPresentation.Draw draw : draws) {
+            final Action action = this.actions.get(draw.box().node());
+            if (action != null) {
+                action.visible = true;
+                action.eligible = draw.enabled() && draw.box().bounds().width() > 0 && draw.box().bounds().height() > 0;
+                action.active = action.eligible && draw.alpha() > 0;
+                action.setAlpha(draw.alpha());
+            }
+            final NativeInput input = this.inputs.get(draw.box().node());
+            if (input != null) {
+                if (draw.enabled() && draw.box().bounds().width() > 0 && draw.box().bounds().height() > 0)
+                    this.eligibleInputs.add(draw.box().node());
+                input.widget().visible = draw.box().visibleBounds().width() > 0 && draw.box().visibleBounds().height() > 0;
+                input.widget().active = draw.enabled() && draw.alpha() > 0;
+                input.setEditable(input.widget().active);
+                input.widget().setAlpha(draw.alpha());
+            }
+        }
+    }
