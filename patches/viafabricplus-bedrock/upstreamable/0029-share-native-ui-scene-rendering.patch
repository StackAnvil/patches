+        } catch (final RuntimeException failure) { throw new IOException("Invalid OreUI bundle", failure); }
+    }
+
+    public List<Face> faces() { return this.faces; }
+
+    /** Target gameplay's regular face order. The caller supplies its primary family and native-case locale. */
+    public List<Face> regularFaces(final String primaryFamily, final String locale) {
+        final List<String> families = new ArrayList<>();
+        families.add(primaryFamily);
+        if (locale.startsWith("ja"))
+            families.addAll(List.of("Noto Sans JP", "Noto Sans TC", "Noto Sans SC", "Noto Sans KR", "Noto Sans"));
+        else if (locale.equals("zh_TW"))
+            families.addAll(List.of("Noto Sans TC", "Noto Sans SC", "Noto Sans JP", "Noto Sans KR", "Noto Sans"));
+        else if (locale.equals("zh_CN"))
+            families.addAll(List.of("Noto Sans SC", "Noto Sans TC", "Noto Sans JP", "Noto Sans KR", "Noto Sans"));
+        else if (locale.startsWith("ko"))
+            families.addAll(List.of("Noto Sans KR", "Noto Sans TC", "Noto Sans SC", "Noto Sans JP", "Noto Sans"));
+        else if (locale.startsWith("ar_"))
+            families.addAll(List.of("Noto Sans AR", "Noto Sans", "Noto Sans KR", "Noto Sans TC", "Noto Sans SC", "Noto Sans JP"));
+        else
+            families.addAll(List.of("Noto Sans", "Noto Sans SC", "Noto Sans TC", "Noto Sans JP", "Noto Sans KR", "Noto Sans AR"));
+        families.addAll(List.of("Noto Sans Mongolian", "Noto Sans Syriac", "Noto Sans TamilSupplement"));
