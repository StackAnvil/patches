+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+/** ScreenView's frame countdown is independent of the inventory quantity-selection clock. */
+public final class NativeUiHold {
+    private long frame;
+    private float remaining;
+    private float repeat;
+    private float startX, startY;
+    private boolean active;
+
+    public NativeUiHold(final long now) { this.frame = now; }
+
+    public void result(final int mask, final float x, final float y) {
+        if ((mask & 8) != 0) return;
+        if ((mask & 2) != 0) {
+            this.active = true;
+            this.startX = x;
+            this.startY = y;
+            this.remaining = .3F;
+            this.repeat = 0;
+        }
+        if ((mask & 4) != 0) this.active = false;
+    }
+
+    public Event frame(final long now, final float x, final float y) {
+        final float delta = (float) (now - this.frame) / 1_000_000_000F;
+        this.frame = now;
+        if (!this.active) return null;
+        this.remaining -= delta;
+        if (!(this.remaining < 0)) return null;
+        final float dx = this.startX - x, dy = this.startY - y;
+        this.remaining = this.repeat;
+        return new Event(this.startX, this.startY, dx, dy, Math.abs(dx) > 5F || Math.abs(dy) > 5F);
+    }
+
+    public record Event(float startX, float startY, float dx, float dy, boolean moved) { }
+}
