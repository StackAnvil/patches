+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+/** Physical OreUI bounds before transforms. Snapping applies to a resolved box, before cached text offsets. */
+public record OreUiBox(float x, float y, float width, float height) {
+    public OreUiBox {
+        if (!Float.isFinite(x) || !Float.isFinite(y) || !Float.isFinite(width) || !Float.isFinite(height))
+            throw new IllegalArgumentException("Invalid OreUI box");
+    }
+
+    /** The caller resolves the node's native rendering option. Insets stay fractional until the content box is complete. */
+    public OreUiBox content(final Insets border, final Insets padding, final boolean snap) {
+        final var content = new OreUiBox((border.left + this.x) + padding.left,
+                (border.top + this.y) + padding.top,
+                this.width - (((border.left + border.right) + padding.left) + padding.right),
+                this.height - (((border.top + border.bottom) + padding.top) + padding.bottom));
+        return snap ? content.snapped() : content;
+    }
+
+    public OreUiBox snapped() {
+        final float fractionX = this.x - truncate(this.x), fractionY = this.y - truncate(this.y);
+        return new OreUiBox(round(this.x), round(this.y),
+                round(fractionX + this.width) - round(fractionX),
+                round(fractionY + this.height) - round(fractionY));
+    }
+
+    // Native rectangle snapping adds a signed half in float precision before cvttss2si.
+    // This differs from CRT roundf and from rounding each absolute edge independently.
+    private static float round(final float value) { return truncate(value + Math.copySign(.5F, value)); }
+
+    private static int truncate(final float value) {
+        return value >= 0x1p31F || value < -0x1p31F ? Integer.MIN_VALUE : (int) value;
+    }
+
+    public record Insets(float left, float right, float top, float bottom) {
+        public static final Insets NONE = new Insets(0, 0, 0, 0);
+    }
+}
