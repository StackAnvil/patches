@@ -0,0 +1,114 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonParser;
+import com.mojang.serialization.JsonOps;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.MutableComponent;
+import net.minecraft.network.chat.Style;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.raphimc.viabedrock.api.util.TextUtil;
+
+public final class NativeUiText {
+    private NativeUiText() {}
+
+    public static List<FormattedCharSequence> tooltipLines(final Font font, final Component text, final int width) {
+        final List<FormattedCharSequence> result = new ArrayList<>();
+        for (final var paragraph : paragraphs(text)) {
+            final var wrapped = font.split(paragraph, width);
+            if (wrapped.isEmpty()) result.add(FormattedCharSequence.EMPTY);
+            else result.addAll(wrapped);
+        }
+        return List.copyOf(result);
+    }
+
+    static List<Line> labelLines(final Font font, final Component text, final int width) {
+        final List<Line> result = new ArrayList<>();
+        for (final var paragraph : labelParagraphs(text)) {
+            final var wrapped = font.split(paragraph, width);
+            // paragraphs() retains an empty styled run after a trailing formatting change.
+            final Style ending = paragraph.getSiblings().isEmpty() ? paragraph.getStyle()
+                : paragraph.getSiblings().getLast().getStyle();
+            if (wrapped.isEmpty()) result.add(new Line(FormattedCharSequence.EMPTY, ending));
+            for (int i = 0; i < wrapped.size(); i++) {
+                final var line = wrapped.get(i);
+                final Style[] style = {ending};
+                if (i + 1 < wrapped.size()) line.accept((index, current, codePoint) -> { style[0] = current; return true; });
+                result.add(new Line(line, style[0]));
+            }
+        }
+        return List.copyOf(result);
+    }
+
+    record Line(FormattedCharSequence text, Style ending) {
+        FormattedCharSequence ellipsis(final Font font, final int width) {
+            final var marker = FormattedCharSequence.forward("...", this.ending);
+            final float markerWidth = font.getSplitter().stringWidth(marker);
+            if (markerWidth > width) return FormattedCharSequence.EMPTY;
+            final List<FormattedCharSequence> parts = new ArrayList<>();
+            final float[] remaining = {width - markerWidth};
+            this.text.accept((index, style, codePoint) -> {
+                final var glyph = FormattedCharSequence.codepoint(codePoint, style);
+                final float advance = font.getSplitter().stringWidth(glyph);
+                if (advance > remaining[0]) return false;
+                remaining[0] -= advance;
+                parts.add(glyph);
+                return true;
+            });
+            parts.add(marker);
+            return FormattedCharSequence.composite(parts);
+        }
+    }
+
+    static List<Component> labelParagraphs(final Component text) {
+        return paragraphs(text, false);
+    }
+
+    static List<Component> paragraphs(final Component text) {
+        return paragraphs(text, true);
+    }
+
+    private static List<Component> paragraphs(final Component text, final boolean normalizeCarriageReturns) {
+        final List<Component> lines = new ArrayList<>();
+        final MutableComponent[] current = {Component.empty()};
+        final boolean[] carriageReturn = {false};
+        text.visit((style, value) -> {
+            final StringBuilder run = new StringBuilder();
+            for (int i = 0; i < value.length(); i++) {
+                final char character = value.charAt(i);
+                if (!normalizeCarriageReturns && character == 0) {
+                    current[0].append(Component.literal(run.toString()).withStyle(style));
+                    return Optional.of(Boolean.TRUE);
+                }
+                if (normalizeCarriageReturns && carriageReturn[0] && character == '\n') {
+                    carriageReturn[0] = false;
+                    continue;
+                }
+                carriageReturn[0] = normalizeCarriageReturns && character == '\r';
+                if (character == '\n' || normalizeCarriageReturns && character == '\r') {
+                    current[0].append(Component.literal(run.toString()).withStyle(style));
+                    run.setLength(0);
+                    lines.add(current[0]);
+                    current[0] = Component.empty();
+                } else run.append(character);
+            }
+            current[0].append(Component.literal(run.toString()).withStyle(style));
+            return Optional.empty();
+        }, Style.EMPTY);
+        lines.add(current[0]);
+        return List.copyOf(lines);
+    }
+
+    public static Component component(final String text) {
+        return ComponentSerialization.CODEC.parse(JsonOps.INSTANCE, JsonParser.parseString(TextUtil.stringToJson(text))).getOrThrow();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiToggle.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiToggle.java
