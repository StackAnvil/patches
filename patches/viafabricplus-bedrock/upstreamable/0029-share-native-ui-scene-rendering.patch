+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiPredicate;
+import net.raphimc.viabedrock.api.model.CameraEase;
+
+/** Per-control animation managers with native next-track and play/reset event semantics. */
+public final class NativeUiAnimations {
+    private final Map<NativeUiScene.Node, Entry> entries = new IdentityHashMap<>();
+    private final BiPredicate<NativeUiScene.Node, String> destroy;
+    private long layoutRevision;
+
+    public long layoutRevision() { return this.layoutRevision; }
+
+    void reconcile(final Map<NativeUiScene.Node, NativeUiScene.Node> replacements, final long now) {
+        final Map<NativeUiScene.Node, Entry> retained = new IdentityHashMap<>();
+        for (final var replacement : replacements.entrySet()) {
+            final var node = replacement.getValue();
+            final Entry previous = this.entries.get(replacement.getKey());
+            final Entry entry;
+            if (previous != null && java.util.Objects.equals(previous.node.properties().get("animation_program"), node.properties().get("animation_program"))) {
+                previous.advance(now);
+                previous.node = node;
+                previous.bindAseprite();
+                if (previous.definitions.stream().noneMatch(definition -> definition.alpha))
+                    previous.current = previous.potential = Math.clamp(node.number("alpha", 1), 0, 1);
+                entry = previous;
+            } else entry = new Entry(node, now);
+            retained.put(node, entry);
+        }
+        this.entries.clear();
+        this.entries.putAll(retained);
+        this.layoutRevision++;
+    }
+
+    NativeUiDimension dimension(final NativeUiScene.Node node, final String property, final int axis) {
+        final Entry entry = this.entries.get(node);
+        if (entry == null) return null;
+        final Vector vector = switch (property) {
+            case "size" -> entry.size;
+            case "offset" -> entry.offset;
+            default -> null;
+        };
+        return vector == null ? null : axis == 0 ? vector.x : vector.y;
+    }
+
+    NativeUiColor color(final NativeUiScene.Node node) {
+        final Entry entry = this.entries.get(node);
+        return entry == null ? null : entry.color;
+    }
+
+    NativeUiImageRegions.Source source(final NativeUiScene.Node node, final int width, final int height) {
+        final Entry entry = this.entries.get(node);
+        final float cropWidth = NativeUiLayout.vector(node, "uv_size", 0, width);
+        final float cropHeight = NativeUiLayout.vector(node, "uv_size", 1, height);
+        final var atlas = entry == null ? null : entry.aseprite;
+        return new NativeUiImageRegions.Source(
+            entry != null && entry.u != null ? entry.u.resolve(width) : NativeUiLayout.vector(node, "uv", 0, 0),
+            entry != null && entry.v != null ? entry.v.resolve(height) : NativeUiLayout.vector(node, "uv", 1, 0),
+            entry != null && entry.width != null ? entry.width.resolve(width) : atlas == null || atlas.width() == 0 ? cropWidth : width / atlas.width() * cropWidth,
+            entry != null && entry.height != null ? entry.height.resolve(height) : atlas == null || atlas.height() == 0 ? cropHeight : height / atlas.height() * cropHeight);
+    }
+
+    public NativeUiAnimations() { this((node, name) -> false); }
+
+    NativeUiAnimations(final BiPredicate<NativeUiScene.Node, String> destroy) { this.destroy = destroy; }
+
+    public NativeUiPresentation.Opacity opacity(final NativeUiScene.Node node, final long now) {
+        final Entry entry = this.entries.computeIfAbsent(node, value -> new Entry(value, now));
+        entry.rendered();
+        entry.advance(now);
+        return entry.opacity();
+    }
+
+    /** HUD replacements retain their elapsed title clock rather than using the scene's creation time. */
+    public NativeUiPresentation.Opacity opacityAt(final NativeUiScene.Node node, final long elapsed) {
+        final Entry entry = this.entries.computeIfAbsent(node, value -> new Entry(value, 0));
+        entry.rendered();
+        entry.advance(elapsed);
+        return entry.opacity();
+    }
+
+    void advance(final NativeUiScene.Node node, final long elapsed) {
+        this.entries.computeIfAbsent(node, value -> new Entry(value, 0)).advance(elapsed);
+        for (final var child : node.children()) advance(child, elapsed);
+    }
+
+    /** Events affect the receiving control and its descendants, not unrelated scrolling panels. */
+    public void event(final NativeUiScene.Node node, final String event, final long now) {
+        final Entry entry = this.entries.computeIfAbsent(node, value -> new Entry(value, now));
+        entry.advance(now);
+        entry.event(event);
+        for (final var child : node.children()) event(child, event, now);
+    }
+
+    private final class Entry {
+        NativeUiScene.Node node;
+        final List<Definition> definitions = new ArrayList<>();
+        final List<Integer> active = new ArrayList<>();
+        final float[] times;
+        final State[] states;
+        final NativeUiFlipbook[] flipbooks;
+        final NativeUiAseprite[] aseprites;
+        NativeUiAseprite.Metadata aseprite;
+        Vector size, offset;
+        NativeUiColor color;
+        TextureCoordinate u, v, width, height;
+        float current;
+        float potential;
+        boolean rendered, advanced;
+        long last;
+
+        Entry(final NativeUiScene.Node node, final long now) {
+            this.node = node;
+            this.last = now;
+            this.current = this.potential = Math.clamp(node.number("alpha", 1), 0, 1);
+            final JsonObject program = node.properties().getAsJsonObject("animation_program");
+            if (program != null) {
+                for (final var value : program.getAsJsonArray("tracks")) {
+                    final Definition definition = new Definition(value.getAsJsonObject());
+                    this.definitions.add(definition);
+                    if (definition.alpha) this.potential = Math.max(this.potential, Math.max(definition.track.from, definition.track.to));
+                }
+                for (final var root : program.getAsJsonArray("roots")) this.active.add(root.getAsInt());
+            }
+            this.times = new float[this.definitions.size()];
+            this.states = new State[this.definitions.size()];
+            this.flipbooks = new NativeUiFlipbook[this.definitions.size()];
+            this.aseprites = new NativeUiAseprite[this.definitions.size()];
+            bindAseprite();
+            for (int i = 0; i < this.definitions.size(); i++) {
+                final var definition = this.definitions.get(i);
+                if (definition.next < -1 || definition.next >= this.definitions.size()) throw new IllegalArgumentException("Invalid UI animation successor");
+                if (definition.flipbook) this.flipbooks[i] = new NativeUiFlipbook(definition.fps, definition.frames,
+                    definition.looping, definition.reversible, definition.vertical);
+                if (definition.aseprite) this.aseprites[i] = new NativeUiAseprite();
+                this.states[i] = initial(definition);
+            }
+            for (final int root : this.active) {
+                if (root < 0 || root >= this.definitions.size()) throw new IllegalArgumentException("Invalid UI animation root");
+                final var definition = this.definitions.get(root);
+                sample(root, definition, 0, true);
+            }
+        }
+
+        void bindAseprite() {
+            this.aseprite = this.node.type().equals("image") && this.definitions.stream().anyMatch(definition -> definition.aseprite)
+                ? NativeUiAseprite.Metadata.parse(this.node.properties().get("aseprite")) : null;
+        }
+
+        State initial(final Definition definition) {
+            return !definition.play.isEmpty() ? State.EVENT : definition.waitForRender && !this.rendered ? State.RENDER : State.PLAYING;
+        }
+
+        void rendered() {
+            this.rendered = true;
+            for (int i = 0; i < this.states.length; i++) if (this.states[i] == State.RENDER) this.states[i] = State.PLAYING;
+        }
+
+        void event(final String event) {
+            for (final int index : List.copyOf(this.active)) {
+                final var definition = this.definitions.get(index);
+                if (!definition.play.isEmpty() && definition.play.equals(event)) {
+                    this.states[index] = definition.waitForRender && !this.rendered ? State.RENDER : State.PLAYING;
+                } else if (!definition.reset.isEmpty() && definition.reset.equals(event)) {
+                    this.times[index] = 0;
+                    this.states[index] = initial(definition);
+                    sample(index, definition, 0, true);
+                }
+            }
+        }
+
+        void advance(final long now) {
+            // Java partial ticks can retreat during a pause; native frame deltas never rewind.
+            if (now < this.last || this.advanced && now == this.last) return;
+            this.advanced = true;
+            final float delta = (float) ((now - this.last) / 1_000_000_000D);
+            this.last = now;
+            if (this.active.isEmpty()) return;
+            final var next = new ArrayDeque<Step>();
+            final var events = new ArrayList<String>();
+            // Native managers update all current tracks before processing their queued successors.
+            for (final int index : List.copyOf(this.active)) update(index, delta, next, events);
+            int transitions = 0;
+            while (!next.isEmpty()) {
+                if (++transitions > 65536) throw new IllegalArgumentException("UI animation chain does not settle in this frame");
+                final var step = next.removeFirst();
+                this.active.add(step.index);
+                update(step.index, step.delta, next, events);
+            }
+            for (final var event : events) event(event);
+        }
+
+        void update(final int index, final float delta, final ArrayDeque<Step> next, final List<String> events) {
+            if (this.states[index] != State.PLAYING) return;
+            final var definition = this.definitions.get(index);
+            // Image tracks finish without consuming time when the control has no image component.
+            final boolean applicable = !definition.image || this.node.type().equals("image");
+            if (applicable && definition.aseprite) {
+                final var frame = this.aseprites[index].advance(this.aseprite, delta);
+                if (frame != null) {
+                    this.u = new TextureCoordinate(0, 1, frame.x());
+                    this.v = new TextureCoordinate(0, 1, frame.y());
+                }
+                return;
+            } else if (applicable && definition.flipbook) {
+                final var flipbook = this.flipbooks[index];
+                if (flipbook.advance(delta)) {
+                    final float positionFrame = flipbook.frames() > 0 ? flipbook.position() : 0;
+                    final float cropFrame = flipbook.frames() > 0 ? 1 : 0;
+                    final int frames = Math.max(1, flipbook.frames());
+                    final var position = new TextureCoordinate(positionFrame, frames, 1F / 256);
+                    final var crop = new TextureCoordinate(cropFrame, frames, -1F / 128);
+                    this.u = flipbook.vertical() ? new TextureCoordinate(0, 1, 0) : position;
+                    this.v = flipbook.vertical() ? position : new TextureCoordinate(0, 1, 0);
+                    if (flipbook.vertical()) this.height = crop;
+                    else this.width = crop;
+                    return;
+                }
+                if (definition.resettable) { this.states[index] = State.EVENT; return; }
+            } else if (applicable) {
+                this.times[index] += delta;
+                sample(index, definition, this.times[index], false);
+                if (this.times[index] < definition.track.delay + Math.max(.01F, definition.track.duration)) return;
+            }
+            final float elapsed = this.times[index];
+            this.active.remove(Integer.valueOf(index));
+            if (!definition.destroy.isEmpty() && NativeUiAnimations.this.destroy.test(this.node, definition.destroy)) {
+                NativeUiAnimations.this.layoutRevision++;
+                if (!definition.end.isEmpty()) events.add(definition.end);
+                return;
+            }
+            if (definition.next >= 0) {
+                this.times[definition.next] = 0;
+                next.addLast(new Step(definition.next, Math.max(0, elapsed - definition.track.delay - definition.track.duration)));
+            } else if (!definition.end.isEmpty()) events.add(definition.end);
+        }
+
+        void sample(final int index, final Definition definition, final float elapsed, final boolean reset) {
+            if (definition.image && !this.node.type().equals("image")) return;
+            if (definition.aseprite && reset) this.u = this.v = new TextureCoordinate(0, 1, 0);
+            if (definition.flipbook && reset) {
+                this.flipbooks[index].reset();
+                this.u = this.v = new TextureCoordinate(0, 1, 0);
+            }
+            if (definition.uvFrom != null) {
+                final float factor = reset ? 0 : definition.track.factor(elapsed);
+                this.u = new TextureCoordinate(0, 1, definition.uvFrom.x + (definition.uvTo.x - definition.uvFrom.x) * factor);
+                this.v = new TextureCoordinate(0, 1, definition.uvFrom.y + (definition.uvTo.y - definition.uvFrom.y) * factor);
+            }
+            if (definition.alpha) this.current = reset ? definition.track.from : definition.track.value(elapsed);
+            if (definition.colorFrom != null && this.node.type().equals("image"))
+                this.color = reset ? definition.colorFrom : definition.colorFrom.interpolate(definition.colorTo, definition.track.factor(elapsed));
+            if (definition.from == null) return;
+            final Vector value = reset ? definition.from : definition.from.interpolate(definition.to, definition.track.factor(elapsed));
+            final Vector previous = definition.type.equals("size") ? this.size : this.offset;
+            if (!value.equals(previous)) {
+                if (definition.type.equals("size")) this.size = value;
+                else this.offset = value;
+                NativeUiAnimations.this.layoutRevision++;
+            }
+        }
+
+        NativeUiPresentation.Opacity opacity() {
+            return new NativeUiPresentation.Opacity(Math.clamp(this.current, 0, 1), Math.clamp(this.potential, 0, 1));
+        }
+    }
+
+    private enum State { PLAYING, EVENT, RENDER }
+    private record Step(int index, float delta) {}
+
+    private static final class Definition {
+        final Track track;
+        final String type;
+        final Vector from, to;
+        final NativeUiColor colorFrom, colorTo;
+        final boolean alpha, image, flipbook, aseprite, looping, reversible, vertical, resettable;
+        final float fps;
+        final int frames;
+        final Uv uvFrom, uvTo;
+        final boolean waitForRender;
+        final int next;
+        final String play, reset, end, destroy;
+
+        Definition(final JsonObject value) {
+            this.type = NativeUiScene.string(value, "anim_type", "");
+            this.alpha = this.type.equals("alpha");
+            this.flipbook = this.type.equals("flip_book");
+            this.aseprite = this.type.equals("aseprite_flip_book");
+            this.image = this.aseprite || this.flipbook || this.type.equals("uv") || this.type.equals("color");
+            this.uvFrom = this.type.equals("uv") ? Uv.parse(value.get("from")) : null;
+            this.uvTo = this.type.equals("uv") ? Uv.parse(value.get("to")) : null;
+            this.fps = this.flipbook ? number(value, "fps", 0) : 0;
+            this.frames = this.flipbook ? integer(value, "frame_count", 1) : 0;
+            this.looping = flag(value, "looping", true);
+            this.resettable = flag(value, "resettable", true);
+            this.reversible = flag(value, "reversible", false);
+            this.vertical = List.of("vertical", "none").contains(NativeUiScene.string(value, "orientation", "horizontal"));
+            this.colorFrom = this.type.equals("color") ? NativeUiColor.parse(value.get("from")) : null;
+            this.colorTo = this.type.equals("color") ? NativeUiColor.parse(value.get("to")) : null;
+            final boolean vector = this.type.equals("size") || this.type.equals("offset");
+            this.from = vector ? Vector.parse(value.get("from")) : null;
+            this.to = vector ? Vector.parse(value.get("to")) : null;
+            this.track = new Track(this.alpha ? number(value, "from", 1) : 1, this.alpha ? number(value, "to", 1) : 1, number(value, "duration", 0),
+                number(value, "delay", number(value, "start_delay", 0)), NativeUiScene.string(value, "easing", "linear"));
+            this.next = value.has("next_index") ? value.get("next_index").getAsInt() : -1;
+            this.play = NativeUiScene.string(value, "play_event", "");
+            this.reset = NativeUiScene.string(value, "reset_event", "");
+            this.end = NativeUiScene.string(value, "end_event", "");
+            this.destroy = NativeUiScene.string(value, "destroy_at_end", "");
+            this.waitForRender = value.has("wait_until_rendered_to_play") && !value.get("wait_until_rendered_to_play").isJsonNull() && value.get("wait_until_rendered_to_play").getAsBoolean();
+        }
+    }
+
+    private static boolean flag(final JsonObject value, final String key, final boolean fallback) {
+        return !value.has(key) || value.get(key).isJsonNull() ? fallback : value.get(key).getAsBoolean();
+    }
+
+    private static int integer(final JsonObject value, final String key, final int fallback) {
+        final float number = number(value, key, fallback);
+        if (number < Integer.MIN_VALUE || number > Integer.MAX_VALUE || number != Math.rint(number))
+            throw new IllegalArgumentException("Invalid native UI animation integer");
+        return (int) number;
+    }
+
+    private record TextureCoordinate(float frame, int frames, float offset) {
+        float resolve(final int extent) { return (float) extent / this.frames * this.frame + this.offset; }
+    }
+
+    private record Uv(float x, float y) {
+        static Uv parse(final JsonElement value) {
+            if (value == null || value.isJsonNull()) return new Uv(0, 0);
+            if (!value.isJsonArray() || value.getAsJsonArray().size() != 2)
+                throw new IllegalArgumentException("Invalid UI texture animation endpoint");
+            final float x = value.getAsJsonArray().get(0).getAsFloat(), y = value.getAsJsonArray().get(1).getAsFloat();
+            if (!Float.isFinite(x) || !Float.isFinite(y)) throw new IllegalArgumentException("Non-finite UI texture coordinate");
+            return new Uv(x, y);
+        }
+    }
+
+    private static float number(final JsonObject value, final String key, final float fallback) {
+        if (!value.has(key) || value.get(key).isJsonNull()) return fallback;
+        final float number = value.get(key).getAsFloat();
+        if (!Float.isFinite(number)) throw new IllegalArgumentException("Non-finite native UI animation");
+        return number;
+    }
+
+    public record Track(float from, float to, float duration, float delay, String easing) {
+        public float value(final double elapsed) {
+            // The target updater divides by max(duration, 0.01), including zero-duration tracks.
+            return this.from + (this.to - this.from) * factor(elapsed);
+        }
+
+        float factor(final double elapsed) {
+            final float progress = (float) Math.clamp((elapsed - delay) / Math.max(.01F, duration), 0, 1);
+            return CameraEase.fromName(this.easing).factor(progress);
+        }
+    }
+
+    private record Vector(NativeUiDimension x, NativeUiDimension y) {
+        static Vector parse(final JsonElement value) {
+            if (value == null || value.isJsonNull()) return new Vector(new NativeUiDimension(List.of()), new NativeUiDimension(List.of()));
+            if (!value.isJsonArray() || value.getAsJsonArray().size() != 2) throw new IllegalArgumentException("Invalid UI vector animation endpoint");
+            return new Vector(NativeUiDimension.parse(value.getAsJsonArray().get(0)), NativeUiDimension.parse(value.getAsJsonArray().get(1)));
+        }
+
+        Vector interpolate(final Vector to, final float factor) {
+            return new Vector(this.x.interpolate(to.x, factor), this.y.interpolate(to.y, factor));
+        }
+    }
+}
