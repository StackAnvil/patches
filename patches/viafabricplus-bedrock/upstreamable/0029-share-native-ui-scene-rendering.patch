+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+
+/** Actor portrait transform, distinct from the native live player renderer. */
+public record NativeUiActorCamera(float scale, Vector3f translation, Matrix4f modelTransform) {
+    public static NativeUiActorCamera resolve(final NativeUiLayout.Rect control, final NativeUiLayout.Rect viewport,
+            final float layer, final float width, final float height, final float depth, final int guiScale,
+            final JsonObject properties, final JsonObject offsets, final float automaticRotation) {
+        if (guiScale < 1 || !(width > 0) || !(height > 0) || !(depth > 0)
+                || !Float.isFinite(width + height + depth + layer + automaticRotation))
+            throw new IllegalArgumentException("Invalid native portrait dimensions");
+        // Pinned 1.26.51.1 actor_portrait_renderer: FUN_145543ce0, verified with live arguments.
+        final float fit = Math.min(1, 2F / Math.max(width, Math.max(height, depth)));
+        final float base = Math.min(control.width() / 20F, control.height() / 39F) * 10F;
+        final float scale = base * fit;
+        if (!(scale > 0) || !Float.isFinite(scale)) throw new IllegalArgumentException("Invalid native portrait control size");
+        final Vector3f scaling = vector(properties, offsets, "scale", new Vector3f(1));
+        final Vector3f rotation = vector(properties, offsets, "rotate", new Vector3f(0, 30, 0));
+        final Vector3f offset = vector(properties, offsets, "translate", new Vector3f());
+        final Vector3f translation = new Vector3f(
+            (control.x() + control.width() / 2F + offset.x - viewport.x() - viewport.width() / 2F) / scale,
+            (viewport.y() + viewport.height() / 2F - control.y() - control.height() * .8F + base / (10F * guiScale) - offset.y) / scale,
+            500F - layer - offset.z);
+        // Java's converted geometry has a downward Y axis and a 24-pixel root.
+        // PIP supplies (scale, -scale, 1). Reverse native camera depth for Java's
+        // orthographic projection as well as converting the downward model Y axis.
+        final Matrix4f model = new Matrix4f().scaling(scaling.x, -scaling.y, scale * scaling.z)
+            .rotateZ((float) Math.toRadians(rotation.z + 180F))
+            .rotateY((float) Math.toRadians(rotation.y - 180F + automaticRotation))
+            .rotateX((float) Math.toRadians(rotation.x))
+            .scale(1, -1, 1).translate(0, -1.5F, 0);
+        return new NativeUiActorCamera(scale, translation, model);
+    }
+
+    private static Vector3f vector(final JsonObject properties, final JsonObject offsets, final String name,
+                                   final Vector3f fallback) {
+        final Vector3f result = new Vector3f(fallback);
+        if (offsets != null && offsets.has(name)) {
+            final var values = offsets.getAsJsonArray(name);
+            if (values.size() != 3) throw new IllegalArgumentException("Invalid native portrait transform");
+            result.set(values.get(0).getAsFloat(), values.get(1).getAsFloat(), values.get(2).getAsFloat());
+        }
+        final String[] axes = {"x", "y", "z"};
+        for (int axis = 0; axis < axes.length; axis++) {
+            final String key = name + "_" + axes[axis];
+            if (properties.has(key)) result.setComponent(axis, properties.get(key).getAsFloat());
+        }
+        if (!Float.isFinite(result.x + result.y + result.z))
+            throw new IllegalArgumentException("Invalid native portrait transform");
+        return result;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiActorPortraits.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiActorPortraits.java
