@@ -0,0 +1,144 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Prepares shaped glyph IDs and cache images together, before the screen submits their geometry. */
+public final class OreUiText implements AutoCloseable {
+    private static final int MAX_IMAGE_BYTES = 16 * 1024 * 1024;
+    private final OreUiAssets assets;
+    private final OreUiShaper engine;
+    private final LinkedHashMap<FontKey, OreUiFont> fonts = new LinkedHashMap<>(32, .75F, true);
+    private final LinkedHashMap<ImageKey, Image> images = new LinkedHashMap<>(512, .75F, true);
+    private int imageBytes;
+    private boolean closed;
+
+    OreUiText(final OreUiAssets assets, final OreUiShaper engine) { this.assets = assets; this.engine = engine; }
+
+    public static OreUiText bundled() throws IOException {
+        final var assets = OreUiAssets.bundled();
+        return new OreUiText(assets, OreUiShaper.bundled());
+    }
+
+    public OreUiAssets assets() { return this.assets; }
+
+    /** Shaping keeps its own integer rounding, independently of the retained cache generation height. */
+    /** Uses the target Windows host's ordinary outline-font defaults, without per-run render overrides. */
+    public Prepared prepareDefault(final OreUiAssets.Face face, final int displayPixels,
+                                   final String text, final String language) throws IOException {
+        final boolean sdf = face != null && !face.sdfOff() && displayPixels >= 10;
+        return this.prepare(face, sdf ? 52 : displayPixels, displayPixels, sdf, text, language);
+    }
+
+    /** The ordinary layout path measures per-scalar advances before line construction and letter spacing. */
+    public synchronized float[] ordinaryAdvances(final OreUiAssets.Face face, final int pixels,
+                                                final String text, final String language) throws IOException {
+        if (this.closed || pixels < 1 || pixels > 1024 || !this.assets.faces().contains(face))
+            throw new IOException("Invalid OreUI measurement font");
+        return this.font(face, pixels).ordinaryAdvances(text, language);
+    }
+
+    /** Resolve each face's display line metrics without preparing draw glyphs or cache images. */
+    public synchronized OreUiFont.LineMetrics lineMetrics(final OreUiAssets.Face face, final int pixels,
+                                                         final Float lineHeight) throws IOException {
+        if (this.closed || pixels < 1 || pixels > 1024 || !this.assets.faces().contains(face))
+            throw new IOException("Invalid OreUI metrics font");
+        return this.font(face, pixels).verticalMetrics().line(pixels, lineHeight);
+    }
+
+    /** The caller resolves the native face list and chooses the ordinary, non-bidi layout path. */
+    public synchronized OreUiFonts ordinaryFonts(final List<OreUiAssets.Face> faces, final int pixels,
+                                                 final OreUiCharacters text, final String language) throws IOException {
+        if (this.closed || pixels < 1 || pixels > 1024 || faces.size() > 32 || language.length() > 128)
+            throw new IOException("Invalid OreUI font assignment");
+        final List<OreUiFonts.Font> fonts = new ArrayList<>(faces.size());
+        for (final var face : faces) {
+            if (face == null) { fonts.add(null); continue; }
+            this.assets.font(face);
+            fonts.add(new OreUiFonts.Font() {
+                @Override public int[] glyphs(final int[] scalars) throws IOException {
+                    return OreUiText.this.font(face, pixels).glyphs(scalars);
+                }
+                @Override public float[] advances(final int[] scalars) throws IOException {
+                    return OreUiText.this.font(face, pixels).ordinaryAdvances(new String(scalars, 0, scalars.length), language);
+                }
+            });
+        }
+        return OreUiFonts.assign(text, fonts);
+    }
+
+    public synchronized Prepared prepare(final OreUiAssets.Face face, final int pixels, final int shapingPixels, final boolean sdf,
+                                         final String text, final String language) throws IOException {
+        if (this.closed) throw new IllegalStateException("OreUI text resources are closed");
+        if (pixels < 1 || pixels > 2048 || shapingPixels < 1 || shapingPixels > 2048
+                || sdf && (face.sdfOff() || pixels != 52)) throw new IOException("Invalid OreUI cache mode");
+        // An alias must belong to the selected immutable source bundle even on a cache hit.
+        this.assets.font(face);
+        final OreUiFont.Run run = this.font(face, shapingPixels).shape(text, language);
+        final var key = new FontKey(face.file(), pixels);
+        final var font = this.font(face, pixels);
+        final Map<Integer, Image> selected = new LinkedHashMap<>();
+        long selectedBytes = 0;
+        for (final var glyph : run.glyphs()) {
+            if (selected.containsKey(glyph.index())) continue;
+            final var imageKey = new ImageKey(key, glyph.index(), sdf);
+            var image = this.images.get(imageKey);
+            if (image == null) {
+                final var raster = font.raster(glyph.index());
+                final var distance = sdf && raster.width() > 0 && raster.height() > 0
+                        ? OreUiDistanceField.generate(raster.pixels(), raster.width(), raster.height(), raster.stride()) : null;
+                image = new Image(raster, distance);
+                final int bytes = image.bytes();
+                if (bytes > MAX_IMAGE_BYTES) throw new IOException("OreUI glyph exceeds the image budget");
+                while (!this.images.isEmpty() && (this.images.size() >= 512 || this.imageBytes + bytes > MAX_IMAGE_BYTES)) {
+                    this.imageBytes -= this.images.remove(this.images.firstEntry().getKey()).bytes();
+                }
+                this.images.put(imageKey, image); this.imageBytes += bytes;
+            }
+            selectedBytes += image.bytes();
+            if (selectedBytes > MAX_IMAGE_BYTES) throw new IOException("OreUI text exceeds the image budget");
+            selected.put(glyph.index(), image);
+        }
+        return new Prepared(this.assets, face, pixels, shapingPixels, sdf, run, Map.copyOf(selected), font.verticalMetrics());
+    }
+
+    private OreUiFont font(final OreUiAssets.Face face, final int pixels) throws IOException {
+        final var key = new FontKey(face.file(), pixels);
+        var font = this.fonts.get(key);
+        if (font == null) {
+            final byte[] bytes = this.assets.font(face);
+            if (this.fonts.size() == OreUiShaper.MAX_FONTS) this.fonts.remove(this.fonts.firstEntry().getKey()).close();
+            font = this.engine.font(bytes, pixels);
+            this.fonts.put(key, font);
+        }
+        return font;
+    }
+
+    @Override
+    public synchronized void close() throws IOException {
+        if (this.closed) return;
+        this.closed = true;
+        try { this.engine.close(); }
+        finally { this.fonts.clear(); this.images.clear(); this.imageBytes = 0; }
+    }
+
+    private record FontKey(String file, int pixels) { }
+    private record ImageKey(FontKey font, int glyph, boolean sdf) { }
+    public record Prepared(OreUiAssets source, OreUiAssets.Face face, int pixels, int shapingPixels, boolean sdf,
+                           OreUiFont.Run run, Map<Integer, Image> images, OreUiFont.VerticalMetrics verticalMetrics) {
+        public OreUiFont.LineMetrics lineMetrics(final float pixels, final Float lineHeight) throws IOException {
+            return this.verticalMetrics.line(pixels, lineHeight);
+        }
+    }
+    public record Image(OreUiFont.Raster raster, OreUiDistanceField.Field distance) {
+        int bytes() { return this.raster.pixels().length + (this.distance == null ? 0 : this.distance.pixels().length); }
+    }
+}
