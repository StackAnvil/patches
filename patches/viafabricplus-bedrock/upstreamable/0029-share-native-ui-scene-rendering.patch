+final class BedrockBitmapGlyphTest {
+    @Test
+    void packsGuiLocalVerticesBeforeThePoseAndPreservesWorldTextAndLight() {
+        final var cell = new BedrockBitmapFont.Cell(16, 64, 16, 16, 256, 256, .5F, 0, 0, .01F);
+        final var source = new BakedSheetGlyph(GlyphInfo.simple(4), mock(GlyphRenderTypes.class), mock(GpuTextureView.class),
+                cell.u0(), cell.u1(), cell.v0(), cell.v1(), cell.left(), cell.right(), cell.top(), cell.bottom());
+        final var bitmap = new BedrockBitmapGlyph(source, cell, false);
+        final var unicode = new BedrockBitmapGlyph(source, cell, true);
+        final TextRenderable.Styled glyph;
+        try (final var viewport = mockStatic(NativeUiViewport.class)) {
+            viewport.when(NativeUiViewport::current).thenReturn(new NativeUiViewport(1280, 720, 1, 1));
+            glyph = unicode.createGlyph(109.01F, 0, -1, 0, Style.EMPTY, 0, 0);
+            assertTrue(BedrockBitmapPipeline.isSmoothed(glyph.guiPipeline()));
+            assertFalse(BedrockBitmapPipeline.isSmoothed(bitmap.createGlyph(0, 0, -1, 0, Style.EMPTY, 0, 0).guiPipeline()));
