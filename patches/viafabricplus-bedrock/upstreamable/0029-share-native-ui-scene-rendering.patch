+/** Bounded original GIF frames retain their palette, transparency, disposal and delivery durations. */
+public final class OreUiAnimation {
+    private static final long MAX_DECODED_BYTES = 16 * 1024 * 1024;
+    private final int width, height;
+    private final List<Frame> frames;
+    private final long duration;
+
+    private OreUiAnimation(final int width, final int height, final List<Frame> frames, final long duration) {
+        this.width = width; this.height = height; this.frames = List.copyOf(frames); this.duration = duration;
+    }
