+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+final class AnimationPrograms {
+    static void attach(final JsonObject node, final JsonArray tracks, final boolean sequential) {
+        final var roots = new JsonArray();
+        for (int i = 0; i < tracks.size(); i++) {
+            if (!sequential || i == 0) roots.add(i);
+            if (sequential && i + 1 < tracks.size()) tracks.get(i).getAsJsonObject().addProperty("next_index", i + 1);
+        }
+        final var program = new JsonObject();
+        program.add("roots", roots);
+        program.add("tracks", tracks);
+        node.add("animation_program", program);
+    }
+}
