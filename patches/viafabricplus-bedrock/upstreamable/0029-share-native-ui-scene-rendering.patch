+                final var document = com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                    new String(entry.getValue(), StandardCharsets.UTF_8)).getAsJsonObject();
+                documents.add(packName(pack.name) ? com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions.nativeDefinitions(document) : document);
+            }
+        }
+        this.materials = com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions.read(documents);
+        return this.materials;
+    }
