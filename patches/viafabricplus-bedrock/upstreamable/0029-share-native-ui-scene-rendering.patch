+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+
+/** Local player framing and independent actor, body and head rotations from the native draw. */
+public record NativeUiPlayerCamera(float scale, Vector3f translation, Matrix4f modelTransform,
+                                   float pitch, float yaw, float bodyYaw, float headYaw) {
+    public static NativeUiPlayerCamera resolve(final NativeUiLayout.Rect control, final NativeUiLayout.Rect viewport,
+            final float layer, final JsonObject properties, final Cursor cursor, final Rotation rotation,
+            final boolean gliding, final boolean swimming, final boolean crawling) {
+        if (!(control.width() > 0) || !(control.height() > 0)
+                || !Float.isFinite(control.x() + control.y() + control.width() + control.height() + layer))
+            throw new IllegalArgumentException("Invalid native player preview geometry");
+        final float centerX = control.x() + control.width() * .5F;
+        final float centerY = control.y() + control.height() * .5F;
+        float scale = Math.min(control.width(), control.height());
+        final float x = looksAtCursor(properties) && cursor != null ? centerX - cursor.x : 0;
+        final float y = looksAtCursor(properties) && cursor != null ? centerY - cursor.y : 0;
+        final float xAngle = (float) Math.atan(x / 40F);
+        final float yAngle = (float) Math.atan(y / 40F);
+        final float pitch = gliding ? rotation.pitch : yAngle * -20F;
+        final float yaw = gliding ? rotation.yaw : xAngle * 40F;
+        final float bodyYaw = gliding ? 0 : xAngle * 20F;
+        final float headYaw = gliding
+                ? ((rotation.headYaw + rotation.previousHeadYaw) - rotation.previousHeadYaw)
+                    - ((rotation.bodyYaw + rotation.previousBodyYaw) - rotation.previousBodyYaw)
+                : yaw;
+        final Matrix4f model;
+        final float yOffset;
+        if (gliding) {
+            scale *= .6F;
+            yOffset = 15;
+            model = new Matrix4f().rotationX(.17453292F).scale(-scale, scale, 1).rotateZ((float) Math.PI);
+        } else {
+            yOffset = swimming || crawling ? -20 : 0;
+            model = new Matrix4f().scaling(-scale, scale, 1).rotateZ((float) Math.PI)
+                    .rotateX(pitch * .017453292F);
+        }
+        // PIP supplies (scale, -scale, 1). Keep the native transform order after its translation.
+        final Matrix4f correction = new Matrix4f().scaling(1F / scale, -1F / scale, 1).mul(model);
+        final Vector3f translation = new Vector3f((centerX - viewport.x() - viewport.width() * .5F) / scale,
+                (viewport.y() + viewport.height() * .5F - centerY - yOffset) / scale,
+                (layer + 1F) * 10F - 1000F);
+        return new NativeUiPlayerCamera(scale, translation, correction, pitch, yaw, bodyYaw, headYaw);
+    }
+
+    public Vector3f translation(final float playerScale) {
+        if (playerScale < 0 || !Float.isFinite(playerScale))
+            throw new IllegalArgumentException("Invalid native player preview scale");
+        return this.modelTransform.transformDirection(new Vector3f(0, -1.501F * .9375F * playerScale, 0))
+                .add(this.translation);
+    }
+
+    static boolean looksAtCursor(final JsonObject properties) {
+        final var bag = properties.getAsJsonObject("property_bag");
+        final var value = bag == null ? null : bag.get("#look_at_cursor");
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean() && value.getAsBoolean();
+    }
+
+    /** Logical cursor position, after the current input source supplied its admission and coordinates. */
+    public record Cursor(float x, float y) {}
+
+    public record Rotation(float pitch, float yaw, float bodyYaw, float previousBodyYaw,
+                           float headYaw, float previousHeadYaw) {}
+}
