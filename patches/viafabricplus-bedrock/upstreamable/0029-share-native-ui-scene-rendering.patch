+            assertNotNull(font.getGlyph(67).bake(stitcher));
+            verifyNoInteractions(stitcher);
+            assertEquals(1, textures.constructed().size());
+            verify(manager).register(any(), same(textures.constructed().getFirst()));
+            renderSystem.when(RenderSystem::isOnRenderThread).thenReturn(false);
+            font.close();
+            font.close();
+            final var disposal = ArgumentCaptor.forClass(Runnable.class);
+            verify(game).execute(disposal.capture());
+            verify(manager, never()).release(any());
+            disposal.getValue().run();
+            verify(manager).release(any());
+            verify(pixels, never()).close();
+            assertThrows(IllegalStateException.class, () -> font.getGlyph(65).bake(stitcher));
+        }
+    }
