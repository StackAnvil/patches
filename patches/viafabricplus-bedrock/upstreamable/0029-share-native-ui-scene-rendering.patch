+                uniform vec2 SampleUv;
+                layout(location = 0) out vec4 vertexColor;
+                layout(location = 1) out vec2 glyphUv;
+                layout(location = 2) flat out vec4 glyphBounds;
+                layout(location = 3) noperspective out float glyphGuiY;
+                void main() {
+                    vec2 corner = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+                    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);
+                    vertexColor = vec4(1.0);
+                    glyphUv = SampleUv;
+                    glyphBounds = vec4(0.0, 0.0, 1.0, 1.0);
+                    glyphGuiY = 0.0;
+                }
+                """;
+            final int program = program(false, false, vertex), vao = glGenVertexArrays(), atlas = glGenTextures();
+            final var texels = MemoryUtil.memCalloc(384 * 384 * 4);
+            try (var stack = MemoryStack.stackPush()) {
+                glBindTexture(GL_TEXTURE_2D, atlas);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                glBindVertexArray(vao);
+                glUseProgram(program);
+                glUniform1i(glGetUniformLocation(program, "Sampler0"), 0);
+                glUniform4f(glGetUniformLocation(program, "ColorModulator"), 1, 1, 1, 1);
+                glViewport(0, 0, 1, 1);
+                glDisable(GL_BLEND);
+                glDisable(GL_DEPTH_TEST);
+                glDisable(GL_CULL_FACE);
+                record Sample(float v, int channel) { }
+                final var pixel = stack.malloc(4);
+                for (final int size : new int[] {128, 384}) {
+                    texels.clear();
+                    texels.limit(size * size * 4);
+                    texels.putInt((3 * size + 2) * 4, -1);
+                    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, size, size, 0, GL_RGBA, GL_UNSIGNED_BYTE, texels);
+                    // Captured Java coordinate at the missing À pixel, its boundary, and a distinct texel.
+                    final var samples = List.of(new Sample(0.0234374962747097F * 128F / size, 255),
+                        new Sample(3F / size, 255), new Sample((3F - 1F / 256F) / size, 0));
+                    for (final Sample sample : samples) {
+                        glUniform2f(glGetUniformLocation(program, "SampleUv"), 2F / size, sample.v());
+                        glDrawArrays(GL_TRIANGLES, 0, 3);
+                        glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+                        for (int channel = 0; channel < 4; channel++) {
+                            assertEquals(sample.channel(), Byte.toUnsignedInt(pixel.get(channel)),
+                                "Atlas size " + size + ", texture V=" + sample.v());
+                        }
+                    }
+                    texels.putInt((3 * size + 2) * 4, 0);
+                }
+            } finally {
+                MemoryUtil.memFree(texels);
+                glUseProgram(0);
+                glDeleteTextures(atlas);
+                glDeleteVertexArrays(vao);
