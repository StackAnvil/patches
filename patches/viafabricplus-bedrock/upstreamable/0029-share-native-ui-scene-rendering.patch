+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiLayoutTest {
+    @Test
+    void measuresNestedContentAtItsAuthoredWidthWithoutSpeculativeDescendantPasses() {
+        JsonObject root = node("label", "100%", 16);
+        for (int depth = 0; depth < 20; depth++) {
+            final JsonObject parent = node("panel", "100% - 2px", "100%c + 1px");
+            children(parent, root);
+            root = parent;
+        }
+        final int[] calls = {0};
+        final var solver = new NativeUiLayout(_ -> {
+            calls[0]++;
+            return new NativeUiLayout.Size(0, 16);
+        });
+        final var box = solver.layout(scene(root).root(), 360, 240, Map.of());
+        assertEquals(36, box.bounds().height(), .0001F);
+        var leaf = box;
+        while (!leaf.children().isEmpty()) leaf = leaf.children().getFirst();
+        assertEquals(320, leaf.bounds().width());
+        assertTrue(calls[0] < 100, "Each ancestor should pass its resolved width to descendants");
+    }
+
+    @Test
+    void looseMaximumConstraintsRetainBoundedGeometryAndRejectNonFiniteValues() {
+        final JsonObject root = node("panel", 200, 100);
+        final JsonObject child = node("panel", "100% + 3px", "100% + 6px");
+        children(root, child);
+        final var expected = layout(scene(root), 640, 360).children().getFirst().bounds();
+        for (final Object maximum : new Object[]{100000, "100000px", "100000% + 1px"}) {
