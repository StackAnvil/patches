+
+class OreUiGlyphsTest {
+    private static final OreUiGlyphs.Quad QUAD = new OreUiGlyphs.Quad(.25F, .5F, 2.25F, 2.5F, .5F,
+            new OreUiGlyphs.Tint(.15F, .3F, .45F, .6F));
+
+    @Test
+    void placesShapedMarksWithIndependentCacheBearingsAndRunScale() throws Exception {
+        try (var fixture = new Fixture(); var atlas = new OreUiGlyphs()) {
+            // Original 1.26.60.5 shaping of the authored font at 13 pixels.
+            final var run = new OreUiFont.Run(4, 0, List.of(new OreUiFont.Glyph(1, 0, 499, 0, 0, 0),
+                    new OreUiFont.Glyph(2, 0, 0, 0, -500, -1)), 499, 0);
+            final var base = new OreUiText.Image(new OreUiFont.Raster(26, 37, 26, 0, 37, 1997, new byte[26 * 37]),
+                    new OreUiDistanceField.Field(34, 45, 36, new byte[36 * 45]));
+            final var mark = new OreUiText.Image(new OreUiFont.Raster(6, 5, 6, 0, 41, 0, new byte[6 * 5]),
+                    new OreUiDistanceField.Field(14, 13, 16, new byte[16 * 13]));
+            final var text = new OreUiText.Prepared(mock(OreUiAssets.class),
+                    new OreUiAssets.Face("Fixture", "fixture.ttf", 400, "normal", false), 52, 13, true, run, Map.of(1, base, 2, mark), new OreUiFont.VerticalMetrics(-.8F, .2F, 0F));
+            atlas.drawRun(fixture.graphics, text, 100.25F, 200.5F, 13, QUAD.tint(), fixture.sampler, false);
+            final var draws = ArgumentCaptor.forClass(GuiElementRenderState.class);
+            verify(fixture.state, times(2)).addGlyphToCurrentLayer(draws.capture());
+            final float[][] expectedX = {{99.25F, 99.25F, 107.75F, 107.75F},
+                    {99.234375F, 99.234375F, 102.734375F, 102.734375F}};
+            final float[][] expectedY = {{190.25F, 201.5F, 201.5F, 190.25F},
+                    {189.265625F, 192.515625F, 192.515625F, 189.265625F}};
+            for (int index = 0; index < 2; index++) {
+                final var draw = draws.getAllValues().get(index);
+                final var format = draw.pipeline().getVertexFormatBindings().getFirst();
+                try (var buffer = new ByteBufferBuilder(256)) {
+                    final var vertices = new BufferBuilder(buffer, draw.pipeline().getPrimitiveTopology(), format);
+                    draw.buildVertices(vertices);
+                    try (var mesh = vertices.buildOrThrow()) {
+                        assertEquals(4, mesh.drawState().vertexCount());
+                        final var bytes = mesh.vertexBuffer().order(ByteOrder.nativeOrder());
+                        for (int corner = 0; corner < 4; corner++) {
+                            final int offset = corner * format.getVertexSize();
+                            final int position = offset + format.getElement(DefaultVertexFormat.POSITION_SEMANTIC_NAME).offset();
+                            assertEquals(expectedX[index][corner], bytes.getFloat(position));
+                            assertEquals(expectedY[index][corner], bytes.getFloat(position + 4));
+                            final int tintRG = offset + format.getElement(DefaultVertexFormat.UV3_SEMANTIC_NAME).offset();
+                            final int tintBA = offset + format.getElement(DefaultVertexFormat.UV0_SEMANTIC_NAME).offset();
+                            assertEquals(.15F, bytes.getFloat(tintRG)); assertEquals(.3F, bytes.getFloat(tintRG + 4));
+                            assertEquals(.45F, bytes.getFloat(tintBA)); assertEquals(.6F, bytes.getFloat(tintBA + 4));
+                            assertEquals(.25F, bytes.getFloat(offset + format.getElement(DefaultVertexFormat.LINE_WIDTH_SEMANTIC_NAME).offset()));
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void resolvesTheLineBaselineBeforeAddingGlyphBearingsWithoutRoundingTheOrigin() throws Exception {
+        try (var fixture = new Fixture(); var atlas = new OreUiGlyphs()) {
+            final var prepared = new OreUiText.Prepared(mock(OreUiAssets.class),
+                    new OreUiAssets.Face("Fixture", "fixture.ttf", 400, "normal", false), 16, 16, false,
+                    new OreUiFont.Run(4, 0, List.of(new OreUiFont.Glyph(1, 0, 64, 0, 0, 0)), 64, 0),
+                    Map.of(1, new OreUiText.Image(new OreUiFont.Raster(2, 3, 2, 1, 8, 64, new byte[6]), null)),
+                    new OreUiFont.VerticalMetrics(-.8F, .1F, 0F));
+            assertEquals(new OreUiFont.LineMetrics(15F, 20F), atlas.drawLine(fixture.graphics, prepared,
+                    10.25F, 20.4F, 16F, 20F, QUAD.tint(), fixture.sampler, false));
+            final var draws = ArgumentCaptor.forClass(GuiElementRenderState.class);
+            verify(fixture.state).addGlyphToCurrentLayer(draws.capture());
+            final var vertices = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            draws.getValue().buildVertices(vertices);
+            // Original Cohtml fragment submission followed by the native glyph-bearing arithmetic.
+            verify(vertices).addVertexWith2DPose(any(Matrix3x2fc.class), eq(11.25F), eq(27.400002F));
+            verify(vertices).addVertexWith2DPose(any(Matrix3x2fc.class), eq(13.25F), eq(30.400002F));
+        }
+    }
+
+    @Test
+    void queuesStableGlyphSlotsWithoutUploadingClippedTextOrAliasingSourceBundles() throws Exception {
+        try (var fixture = new Fixture(); var atlas = new OreUiGlyphs()) {
+            final var first = prepared(mock(OreUiAssets.class));
+            when(fixture.scissor.peek()).thenReturn(new ScreenRectangle(100, 100, 2, 2));
+            atlas.draw(fixture.graphics, first, 1, QUAD, fixture.sampler, false);
+            assertTrue(fixture.textures.constructed().isEmpty());
+            verifyNoInteractions(fixture.state);
+
+            when(fixture.scissor.peek()).thenReturn(null);
+            fixture.pose.translate(10, 20);
+            atlas.draw(fixture.graphics, first, 1, QUAD, fixture.sampler, false);
+            atlas.draw(fixture.graphics, first, 1, QUAD, fixture.sampler, false);
+            atlas.draw(fixture.graphics, prepared(mock(OreUiAssets.class)), 1, QUAD, fixture.sampler, false);
+            assertEquals(1, fixture.textures.constructed().size());
+            assertEquals(List.of(List.of(1, 1), List.of(5, 1)), fixture.destinations);
+            final byte[] expected = {64, 0, 0, -1, -128, 0, 0, -1, -64, 0, 0, -1, -1, 0, 0, -1};
+            for (final var upload : fixture.uploads) assertArrayEquals(expected, upload);
+            final var retained = fixture.textures.constructed().getFirst().getPixels().getPixelBytes();
+            assertEquals(64, Byte.toUnsignedInt(retained.get((512 + 1) * 4)));
+            assertEquals(64, Byte.toUnsignedInt(retained.get((512 + 5) * 4)));
+
+            final var draws = ArgumentCaptor.forClass(GuiElementRenderState.class);
+            verify(fixture.state, times(3)).addGlyphToCurrentLayer(draws.capture());
+            fixture.pose.translate(100, 100);
+            assertEquals(new ScreenRectangle(10, 20, 3, 3), draws.getAllValues().getFirst().bounds());
+            final var vertices = mock(VertexConsumer.class, Answers.RETURNS_SELF);
+            draws.getAllValues().getFirst().buildVertices(vertices);
+            final var u = ArgumentCaptor.forClass(Integer.class);
+            final var v = ArgumentCaptor.forClass(Integer.class);
+            verify(vertices, times(4)).setUv1(u.capture(), v.capture());
+            assertEquals(List.of(1, 1, 3, 3), u.getAllValues());
+            assertEquals(List.of(1, 3, 3, 1), v.getAllValues());
+            verify(vertices, times(4)).setUv(.45F, .6F);
+            verify(vertices, times(4)).setUv3(.15F, .3F);
+            verify(vertices, times(4)).setLineWidth(.5F);
+
+            fixture.system.when(RenderSystem::isOnRenderThread).thenReturn(false);
+            atlas.close(); atlas.close();
+            verify(fixture.manager, never()).release(any());
+            final var disposal = ArgumentCaptor.forClass(Runnable.class);
+            verify(fixture.game).execute(disposal.capture());
+            assertThrows(IllegalStateException.class, () -> atlas.draw(fixture.graphics, first, 1, QUAD, fixture.sampler, false));
+            disposal.getValue().run();
+            verify(fixture.manager).release(any());
+        }
+    }
+
+    @Test
+    void releasesRemainingPagesAfterOneTextureRetirementFails() throws Exception {
+        try (var fixture = new Fixture(); var atlas = new OreUiGlyphs()) {
+            final var image = new OreUiText.Image(new OreUiFont.Raster(510, 510, 510, 0, 0, 1, new byte[510 * 510]), null);
+            final var text = prepared(mock(OreUiAssets.class));
+            final var large = new OreUiText.Prepared(text.source(), text.face(), 52, 52, false, text.run(), Map.of(1, image, 2, image), text.verticalMetrics());
+            atlas.draw(fixture.graphics, large, 1, QUAD, fixture.sampler, false);
+            atlas.draw(fixture.graphics, large, 2, QUAD, fixture.sampler, false);
+            assertEquals(2, fixture.textures.constructed().size());
+            doThrow(new IllegalStateException("Retirement failed")).doNothing().when(fixture.manager).release(any());
+            final var failure = assertThrows(IllegalStateException.class, atlas::close);
+            assertEquals("Retirement failed", failure.getMessage());
+            verify(fixture.manager, times(2)).release(any());
+            atlas.close();
+        }
+    }
+
+    private static OreUiText.Prepared prepared(final OreUiAssets source) {
+        return new OreUiText.Prepared(source, new OreUiAssets.Face("Fixture", "fixture.ttf", 400, "normal", false), 52, 52, false,
+                new OreUiFont.Run(4, 0, List.of(new OreUiFont.Glyph(1, 0, 64, 0, 0, 0)), 64, 0),
+                Map.of(1, new OreUiText.Image(new OreUiFont.Raster(2, 2, 2, 0, 0, 64, new byte[]{64, -128, -64, -1}), null)), new OreUiFont.VerticalMetrics(-.8F, .2F, 0F));
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final Minecraft game = mock(Minecraft.class);
+        private final TextureManager manager = mock(TextureManager.class);
+        private final GuiRenderState state = mock(GuiRenderState.class);
+        private final GpuSampler sampler = mock(GpuSampler.class);
+        private final GuiGraphicsExtractor graphics = mock(GuiGraphicsExtractor.class, withSettings().extraInterfaces(GuiGraphicsExtractorAccess.class));
+        private final GuiGraphicsExtractor.ScissorStack scissor = mock(GuiGraphicsExtractor.ScissorStack.class);
+        private final Matrix3x2fStack pose = new Matrix3x2fStack(16);
+        private final List<byte[]> uploads = new ArrayList<>();
+        private final List<List<Integer>> destinations = new ArrayList<>();
+        private final List<NativeImage> retained = new ArrayList<>();
+        private final MockedStatic<RenderSystem> system = mockStatic(RenderSystem.class);
+        private final MockedStatic<Minecraft> singleton = mockStatic(Minecraft.class);
+        private final MockedConstruction<DynamicTexture> textures;
+
+        private Fixture() throws ReflectiveOperationException {
+            this.singleton.when(Minecraft::getInstance).thenReturn(this.game);
+            when(this.game.getTextureManager()).thenReturn(this.manager);
+            this.system.when(RenderSystem::isOnRenderThread).thenReturn(true);
+            final var device = mock(GpuDevice.class);
+            final var encoder = mock(CommandEncoder.class);
+            this.system.when(RenderSystem::getDevice).thenReturn(device);
+            when(device.createCommandEncoder()).thenReturn(encoder);
+            doAnswer(call -> {
+                final NativeImage image = call.getArgument(1);
+                final var bytes = new byte[image.getWidth() * image.getHeight() * 4];
+                image.getPixelBytes().get(0, bytes);
+                this.uploads.add(bytes);
+                this.destinations.add(List.of(call.getArgument(4), call.getArgument(5)));
+                return null;
+            }).when(encoder).writeToTexture(any(GpuTexture.class), any(NativeImage.class), eq(0), eq(0), anyInt(), anyInt());
+            this.textures = mockConstruction(DynamicTexture.class, (texture, context) -> {
+                final NativeImage pixels = (NativeImage) context.arguments().get(1);
+                this.retained.add(pixels);
+                when(texture.getPixels()).thenReturn(pixels);
+                when(texture.getTexture()).thenReturn(mock(GpuTexture.class));
+                when(texture.getTextureView()).thenReturn(mock(GpuTextureView.class));
+            });
+            when(this.graphics.pose()).thenReturn(this.pose);
+            when(((GuiGraphicsExtractorAccess) this.graphics).bedrockGuiState()).thenReturn(this.state);
+            final var field = GuiGraphicsExtractor.class.getField("scissorStack");
+            field.setAccessible(true); field.set(this.graphics, this.scissor);
+        }
+
+        @Override public void close() {
+            this.textures.close(); this.singleton.close(); this.system.close();
+            for (final var image : this.retained) image.close();
+        }
+    }
+}
