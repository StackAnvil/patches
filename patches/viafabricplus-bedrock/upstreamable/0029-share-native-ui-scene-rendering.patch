+    java.awt.image.BufferedImage image(final String path) throws IOException {
+        BedrockBuiltinAssets.validPath(path);
+        for (int index = this.packs.size() - 1; index >= 0; index--) {
+            final var content = new net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent();
+            final var files = this.packs.get(index).files;
+            if (files.containsKey(path)) content.put(path, files.get(path));
+            for (final String extension : List.of(".png", ".jpg", ".tga")) {
+                final byte[] bytes = files.get(path + extension);
+                if (bytes != null) content.put(path + extension, bytes);
+            }
+            if (content.size() == 0) continue;
+            final var resource = content.getShortnameImage(path);
+            if (resource == null) throw new IOException("Invalid native actor texture " + path);
+            final var image = resource.getImage();
+            if (image == null || image.getWidth() < 1 || image.getHeight() < 1
+                    || image.getWidth() > 4096 || image.getHeight() > 4096)
+                throw new IOException("Invalid native actor texture dimensions " + path);
+            return image;
+        }
+        throw new IOException("Missing native actor texture " + path);
+    }
