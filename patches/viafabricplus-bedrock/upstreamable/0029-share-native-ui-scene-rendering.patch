+    com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions materials() throws IOException {
+        if (this.materials != null) return this.materials;
+        final List<com.viaversion.viaversion.libs.gson.JsonObject> documents = new ArrayList<>();
+        for (final Pack pack : this.packs) {
