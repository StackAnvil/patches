+    @Test
+    void retainsFractionalAdvanceAndAlignsNarrowGlyphsWithoutChangingTheirPixels() {
+        assertEquals(new BedrockBitmapFont.Metrics(4, 0), glyph(0x41, 16, 8, 1, 7));
+        assertEquals(new BedrockBitmapFont.Metrics(4.5F, 0), glyph(0x436, 16, 8, 1, 8));
+        assertEquals(new BedrockBitmapFont.Metrics(4.5F, .5F), glyph(0x5DD, 16, 8, 0, 7));
+        assertEquals(new BedrockBitmapFont.Metrics(4, -.5F), glyph(0x41, 16, 8, 2, 8));
+        assertEquals(new BedrockBitmapFont.Metrics(4, -.25F), glyph(0x41, 32, 8, 2, 14));
+        assertEquals(new BedrockBitmapFont.Metrics(4.5F, -.25F), glyph(0x436, 32, 8, 2, 16));
+    }
+
+    @Test
+    void keepsNativeWideRangesAndHangulAdvanceIndependentOfPaintedWidth() {
+        final int[][] ranges = {{0x1100, 0x11FF}, {0x3000, 0x30FF}, {0x3130, 0x318F}, {0x3200, 0x9FFF},
+                {0xA960, 0xA97F}, {0xD7B0, 0xD7FF}, {0xF900, 0xFAFF}, {0xFF01, 0xFF5E}};
+        for (final int[] range : ranges) {
+            for (int codepoint = range[0]; codepoint <= range[1]; codepoint++) {
+                assertEquals(new BedrockBitmapFont.Metrics(9, 0), glyph(codepoint, 16, 8, 2, 6));
+            }
+        }
+        for (int codepoint = 0xAC00; codepoint < 0xD7B0; codepoint++) {
+            assertEquals(new BedrockBitmapFont.Metrics(8, 0), glyph(codepoint, 16, 8, 1, 7));
+        }
+        for (final int codepoint : new int[] {0x10FF, 0x1200, 0x2FFF, 0x3100, 0x312F, 0x3190,
+                0x31FF, 0xA000, 0xA95F, 0xA980, 0xD800, 0xF8FF, 0xFB00, 0xFF00, 0xFF5F}) {
+            assertEquals(new BedrockBitmapFont.Metrics(3, -.5F), glyph(codepoint, 16, 8, 2, 6));
+        }
+    }
+
+    @Test
+    void retainsEmptyGlyphAndPrivateUseMetrics() {
+        final IntBinaryOperator empty = (x, y) -> 0;
+        assertEquals(new BedrockBitmapFont.Metrics(4, 0), BedrockBitmapFont.measure(0x4E00, 16, 16, 8, empty));
+        assertEquals(new BedrockBitmapFont.Metrics(9, 0), BedrockBitmapFont.measure(0x3000, 16, 16, 8, empty));
+        assertEquals(new BedrockBitmapFont.Metrics(15, -8), glyph(0xE000, 32, 32, 9, 23));
+        assertEquals(new BedrockBitmapFont.Metrics(10, 1), glyph(0xE100, 16, 16, 0, 9));
+    }
+
+    @Test
