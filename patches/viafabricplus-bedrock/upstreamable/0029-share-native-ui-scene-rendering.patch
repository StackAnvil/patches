index 0000000..1564b4b
--- /dev/null
+++ b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_bitmap_font.vsh
@@ -0,0 +1,29 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+#include <minecraft:dynamictransforms.glsl>
+#include <minecraft:projection.glsl>
+
+uniform sampler2D Sampler0;
+layout(location = 0) in vec3 Position;
+layout(location = 1) in vec4 Color;
+layout(location = 2) in vec2 UV0;
+layout(location = 3) in ivec2 UV1;
+layout(location = 4) in vec2 UV3;
+layout(location = 0) out vec4 vertexColor;
+layout(location = 1) out vec2 glyphUv;
+layout(location = 2) flat out vec4 glyphBounds;
+layout(location = 3) noperspective out float glyphGuiY;
+
+void main() {
+    gl_Position = ProjMat * ModelViewMat * vec4(Position, 1.0);
+    vec2 page = vec2(textureSize(Sampler0, 0));
+    vec2 sourceOrigin = vec2(UV1) / page;
+    // Native packs 16.16 origins into an unsigned-normalized 16-bit attribute.
+    vec2 origin = clamp(floor(sourceOrigin * 65536.0), 0.0, 65535.0) / 65535.0;
+    vec2 extent = UV3 / page;
+    vec2 corner = vec2(greaterThan(UV0, sourceOrigin + extent * 0.5));
+    glyphUv = origin + corner * extent;
+    glyphBounds = vec4(origin + 0.5 / page, origin + extent - 0.5 / page);
+    vertexColor = Color;
+    glyphGuiY = Position.y;
+}
diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_oreui_font.fsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_oreui_font.fsh
