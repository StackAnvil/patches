+            }
+            return vertices.flip();
+        } catch (final IOException | RuntimeException | Error failure) {
+            vertices.free();
+            throw failure;
+        }
+    }
+
+    private static void vertex(final STBTTVertex.Buffer vertices, final int type, final int x, final int y, final int cx, final int cy) {
+        final long at = vertices.get().address();
+        MemoryUtil.memPutShort(at + STBTTVertex.X, (short) x);
+        MemoryUtil.memPutShort(at + STBTTVertex.Y, (short) y);
+        MemoryUtil.memPutShort(at + STBTTVertex.CX, (short) cx);
+        MemoryUtil.memPutShort(at + STBTTVertex.CY, (short) cy);
+        MemoryUtil.memPutByte(at + STBTTVertex.TYPE, (byte) type);
+    }
+
+    private void requireOpen() {
+        if (this.closed) throw new IllegalStateException("Native TrueType font is closed");
+    }
+
+    @Override
+    public synchronized void close() {
+        if (this.closed) return;
+        this.closed = true;
+        if (this.face != null) FreeType.FT_Done_Face(this.face);
+        if (this.library != 0) FreeType.FT_Done_FreeType(this.library);
+        if (this.data != null) MemoryUtil.memFree(this.data);
+        this.pages.clear();
+    }
+
+    public record Glyph(int width, int height, float left, float top, float advance, float oversample, byte[] pixels, Sampling sampling) { }
+    public record Sampling(int side, int x, int y, int width, int height) {
+        /** Retain native UNORM16 rounding in texel space when Java relocates the bitmap. */
+        float correction(final boolean horizontal, final boolean end) {
+            final int texel = horizontal ? this.x + (end ? this.width : 0) : this.y + (end ? this.height : 0);
+            final float uv = texel * (1F / this.side);
+            final int packed = Math.min(65535, (int) (uv * 65536F));
+            return (packed / 65535F) * this.side - texel;
+        }
+    }
+    private record Box(int left, int bottom, int right, int top) {
+        boolean contains(final int x, final int y) { return x >= this.left && x <= this.right && y >= this.bottom && y <= this.top; }
+    }
+
+    private static final class Tables {
+        final int ascent, descent, horizontalMetrics;
+        final int[] offsets;
+        final ByteBuffer glyf, hmtx;
+
+        Tables(final ByteBuffer bytes) throws IOException {
+            try {
+                final var data = bytes.order(ByteOrder.BIG_ENDIAN);
+                final int count = Short.toUnsignedInt(data.getShort(4));
+                if (data.getInt(0) != 0x10000 || count < 1 || count > 256 || 12L + count * 16L > bytes.capacity()) throw new IOException("Invalid native TrueType directory");
+                final Map<Integer, ByteBuffer> tables = new HashMap<>();
+                for (int index = 0; index < count; index++) {
+                    final int at = 12 + index * 16;
+                    final long start = Integer.toUnsignedLong(data.getInt(at + 8));
+                    final long length = Integer.toUnsignedLong(data.getInt(at + 12));
+                    if (start + length > bytes.capacity() || tables.put(data.getInt(at), data.slice((int) start, (int) length).order(ByteOrder.BIG_ENDIAN)) != null) throw new IOException("Invalid native font table span");
+                }
+                final var head = table(tables, 0x68656164, 54);
+                final var hhea = table(tables, 0x68686561, 36);
+                final var maxp = table(tables, 0x6D617870, 6);
+                final int glyphs = Short.toUnsignedInt(maxp.getShort(4));
+                this.ascent = hhea.getShort(4);
+                this.descent = hhea.getShort(6);
+                this.horizontalMetrics = Short.toUnsignedInt(hhea.getShort(34));
+                if (glyphs == 0 || this.ascent <= this.descent || this.horizontalMetrics < 1 || this.horizontalMetrics > glyphs) throw new IOException("Invalid native font metrics");
+                this.hmtx = table(tables, 0x686D7478, this.horizontalMetrics * 4 + (glyphs - this.horizontalMetrics) * 2);
+                this.glyf = table(tables, 0x676C7966, 0);
+                final int format = head.getShort(50);
+                if (format != 0 && format != 1) throw new IOException("Invalid native glyph offset format");
+                final var loca = table(tables, 0x6C6F6361, (glyphs + 1) * (format == 0 ? 2 : 4));
+                this.offsets = new int[glyphs + 1];
+                long previous = 0;
+                for (int glyph = 0; glyph <= glyphs; glyph++) {
+                    final long value = format == 0 ? Short.toUnsignedInt(loca.getShort(glyph * 2)) * 2L : Integer.toUnsignedLong(loca.getInt(glyph * 4));
+                    if (value < previous || value > this.glyf.capacity()) throw new IOException("Invalid native glyph span");
+                    this.offsets[glyph] = (int) value;
+                    previous = value;
+                }
+            } catch (final IndexOutOfBoundsException malformed) { throw new IOException("Truncated native font tables", malformed); }
+        }
+
+        private static ByteBuffer table(final Map<Integer, ByteBuffer> tables, final int tag, final int minimum) throws IOException {
+            final var table = tables.get(tag);
+            if (table == null || table.capacity() < minimum) throw new IOException("Missing or truncated native font table");
+            return table;
+        }
+
+        int advance(final int glyph) { return Short.toUnsignedInt(this.hmtx.getShort(Math.min(glyph, this.horizontalMetrics - 1) * 4)); }
+
+        Box box(final int glyph) throws IOException {
+            final int at = this.offsets[glyph];
+            if (at == this.offsets[glyph + 1]) return new Box(0, 0, 0, 0);
+            if (this.offsets[glyph + 1] - at < 10) throw new IOException("Truncated native glyph header");
+            final var box = new Box(this.glyf.getShort(at + 2), this.glyf.getShort(at + 4), this.glyf.getShort(at + 6), this.glyf.getShort(at + 8));
+            if (box.left > box.right || box.bottom > box.top) throw new IOException("Invalid native glyph bounds");
+            return box;
+        }
+    }
