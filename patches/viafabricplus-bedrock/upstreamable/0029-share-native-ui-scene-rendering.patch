+        } finally { parents.remove(glyph); }
+    }
+
+    private record Component(int glyph, int x, int y, float a, float b, float c, float d) { }
+    private record Vertex(int type, int x, int y, int cx, int cy) { }
+
+    // Match native STB's integer midpoints and contour closure after FreeType reads the points.
+    private static STBTTVertex.Buffer outlineVertices(final FT_Outline outline) throws IOException {
+        final int count = outline.n_points();
+        final int contours = outline.n_contours();
+        if (count < 0 || count > 8192 || contours < 0 || contours > 2048 || FreeType.FT_Outline_Check(outline) != 0) throw new IOException("Invalid or oversized native font outline");
+        final var vertices = STBTTVertex.calloc(Math.max(1, count + contours * 2));
+        try {
+            for (int point = 0; point < count; point++) {
+                final var value = outline.points().get(point);
+                if (value.x() < Short.MIN_VALUE || value.x() > Short.MAX_VALUE || value.y() < Short.MIN_VALUE || value.y() > Short.MAX_VALUE
+                        || (outline.tags().get(point) & 3) > 1) throw new IOException("Native font outline exceeds declared bounds");
+            }
+            int begin = 0;
+            for (int contour = 0; contour < contours; contour++) {
+                final int end = Short.toUnsignedInt(outline.contours().get(contour));
+                int point = begin;
+                int sx = (int) outline.points().get(point).x();
+                int sy = (int) outline.points().get(point).y();
+                final boolean startOff = (outline.tags().get(point) & 1) == 0;
+                final int scx = sx, scy = sy;
+                if (startOff) {
+                    if (point == end) throw new IOException("Native font contour has no curve endpoint");
+                    final var next = outline.points().get(point + 1);
+                    if ((outline.tags().get(point + 1) & 1) == 0) {
+                        sx = (sx + (int) next.x()) >> 1;
+                        sy = (sy + (int) next.y()) >> 1;
+                    } else { sx = (int) next.x(); sy = (int) next.y(); point++; }
+                }
+                vertex(vertices, 1, sx, sy, 0, 0);
+                boolean off = false;
+                int cx = 0, cy = 0;
+                for (point++; point <= end; point++) {
+                    final int x = (int) outline.points().get(point).x();
+                    final int y = (int) outline.points().get(point).y();
+                    if ((outline.tags().get(point) & 1) == 0) {
+                        if (off) vertex(vertices, 3, (cx + x) >> 1, (cy + y) >> 1, cx, cy);
+                        cx = x; cy = y; off = true;
+                    } else {
+                        vertex(vertices, off ? 3 : 2, x, y, off ? cx : 0, off ? cy : 0);
+                        off = false;
+                    }
+                }
+                if (startOff) {
+                    if (off) vertex(vertices, 3, (cx + scx) >> 1, (cy + scy) >> 1, cx, cy);
+                    vertex(vertices, 3, sx, sy, scx, scy);
+                } else vertex(vertices, off ? 3 : 2, sx, sy, off ? cx : 0, off ? cy : 0);
