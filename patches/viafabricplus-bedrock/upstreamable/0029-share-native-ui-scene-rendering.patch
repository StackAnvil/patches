+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Aseprite tracks retain phase across resets and select frames by elapsed milliseconds. */
+final class NativeUiAseprite {
+    private float elapsed;
+
+    Frame advance(final Metadata metadata, final float delta) {
+        if (metadata == null) return null;
+        this.elapsed += delta;
+        if (metadata.duration == 0) return new Frame(0, 0, 0);
+        final float milliseconds = this.elapsed * 1000;
+        // CVTTSS2SI returns the minimum integer for a float outside the signed range.
+        final int time = milliseconds >= 2147483648F || milliseconds < -2147483648F ? Integer.MIN_VALUE : (int) milliseconds;
+        int position = time % metadata.duration;
+        for (final Frame frame : metadata.frames) {
+            position -= frame.duration;
+            if (position < 0) return frame;
+        }
+        return new Frame(0, 0, 0);
+    }
+
+    record Frame(int x, int y, int duration) {}
+
+    record Metadata(float width, float height, List<Frame> frames, int duration) {
+        static Metadata parse(final JsonElement value) {
+            if (value == null || value.isJsonNull()) return null;
+            final var object = value.getAsJsonObject();
+            final var size = object.getAsJsonArray("size");
+            if (size.size() != 2) throw new IllegalArgumentException("Invalid native atlas size");
+            final float width = size.get(0).getAsFloat(), height = size.get(1).getAsFloat();
+            if (!Float.isFinite(width) || !Float.isFinite(height)) throw new IllegalArgumentException("Non-finite native atlas size");
+            final var frames = new ArrayList<Frame>();
+            int duration = 0;
+            for (final var item : object.getAsJsonArray("frames")) {
+                final var fields = item.getAsJsonArray();
+                if (fields.size() != 3) throw new IllegalArgumentException("Invalid native atlas frame");
+                final var frame = new Frame(fields.get(0).getAsInt(), fields.get(1).getAsInt(), fields.get(2).getAsInt());
+                if (frame.x < 0 || frame.y < 0 || frame.duration <= 0) throw new IllegalArgumentException("Invalid native atlas frame");
+                frames.add(frame);
+                duration += frame.duration;
+            }
+            return new Metadata(width, height, List.copyOf(frames), duration);
+        }
+    }
+}
