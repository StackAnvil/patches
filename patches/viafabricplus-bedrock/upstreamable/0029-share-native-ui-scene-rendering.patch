+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import javax.imageio.ImageIO;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.Content;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.GlyphSheetResourceRewriter;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockBitmapFontResourcesTest {
+    @Test
+    void carriesLicensedAtlasLayoutIntoConversionAndKeepsLegacyServerTextureOwnership() throws Exception {
+        final var source = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        source.setRGB(0, 0, 0xFF123456);
+        final var encoded = new ByteArrayOutputStream();
+        ImageIO.write(source, "png", encoded);
+        final byte[] atlas = encoded.toByteArray();
+        final byte[] metadata = "{\"ascii_extended\":true}".getBytes(StandardCharsets.UTF_8);
+        final var library = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/font/default8.png", atlas,
+                "library/vanilla/font/default8.json", metadata));
+        final var nativePacks = library.resourcePacks();
+        assertSame(atlas, nativePacks.getFirst().content().get("font/default8.png"));
+        assertSame(metadata, nativePacks.getFirst().content().get("font/default8.json"));
+        final var extended = convert(new ResourcePackStorage(List.of(), nativePacks));
+        assertEquals(12, firstProvider(extended).get("height").getAsInt());
+        assertEquals(120, extended.getImage("assets/viabedrock/textures/font/bedrock_bitmap/default8_0.png").getImage().getHeight());
+
+        final var legacyContent = new InMemoryContent();
+        legacyContent.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"legacy atlas\",\"uuid\":\""
+                + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        source.setRGB(0, 0, 0xFF654321);
+        legacyContent.putPngImage("font/default8.png", source);
+        final var legacy = convert(new ResourcePackStorage(List.of(new ResourcePack(legacyContent)), nativePacks));
+        assertEquals(8, firstProvider(legacy).get("height").getAsInt());
+        final var image = legacy.getImage("assets/viabedrock/textures/font/bedrock_bitmap/default8_0.png").getImage();
+        assertEquals(128, image.getHeight());
+        assertEquals(0xFF654321, image.getRGB(0, 0));
+        // Converting the upper pack must not mutate the cached licensed view.
+        assertEquals(12, firstProvider(convert(new ResourcePackStorage(List.of(), nativePacks))).get("height").getAsInt());
+    }
+
+    private static Content convert(final ResourcePackStorage storage) {
+        final List<Content> result = new ArrayList<>();
+        new GlyphSheetResourceRewriter().submitTasks(storage, supplier -> result.add(supplier.get()));
+        assertEquals(1, result.size());
+        return result.getFirst();
+    }
+
+    private static com.viaversion.viaversion.libs.gson.JsonObject firstProvider(final Content content) {
+        return content.getJson("assets/minecraft/font/default.json").getAsJsonArray("providers").get(0).getAsJsonObject();
+    }
+}
