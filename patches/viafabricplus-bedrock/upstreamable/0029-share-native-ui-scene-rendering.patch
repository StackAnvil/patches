+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Produces the native image component's ordered, signed destination and source regions. */
+public final class NativeUiImageRegions {
+    private static final int[][] ORDER = {{0, 0}, {2, 0}, {0, 2}, {2, 2}, {0, 1}, {1, 0}, {2, 1}, {1, 2}, {1, 1}};
+
+    private NativeUiImageRegions() {}
+
+    public static List<Region> regions(final NativeUiScene.Node node, final NativeUiLayout.Rect bounds,
+                                final int textureWidth, final int textureHeight) {
+        return regions(node, bounds, new Source(NativeUiLayout.vector(node, "uv", 0, 0), NativeUiLayout.vector(node, "uv", 1, 0),
+            NativeUiLayout.vector(node, "uv_size", 0, textureWidth), NativeUiLayout.vector(node, "uv_size", 1, textureHeight)));
+    }
+
+    static List<Region> regions(final NativeUiScene.Node node, final NativeUiLayout.Rect bounds, final Source source) {
+        final float u = source.u, v = source.v, sourceWidth = source.width, sourceHeight = source.height;
+        if (sourceWidth <= 0 || sourceHeight <= 0) return List.of();
+        final int direction = switch (node.string("clip_direction", "none")) {
+            case "left" -> 1;
+            case "right" -> 2;
+            case "up" -> 3;
+            case "down" -> 4;
+            case "center" -> 5;
+            default -> 0;
+        };
+        final float ratio = node.number("clip_ratio", 0);
+        if (direction != 0 && ratio == 1) return List.of();
+        final boolean pixelPerfect = node.flag("clip_pixelperfect", true);
+        final JsonElement slice = node.properties().get(node.properties().has("nine_slice") ? "nine_slice" : "nineslice_size");
+        float width = bounds.width(), height = bounds.height();
+        if (slice == null && !(direction != 0 && ratio > 0) && node.flag("keep_ratio", true)) {
+            final float scale = Math.min(width / sourceWidth, height / sourceHeight);
+            width = sourceWidth * scale;
+            height = sourceHeight * scale;
+        }
+        final float x = bounds.x() + (bounds.width() - width) / 2;
+        final float y = bounds.y() + (bounds.height() - height) / 2;
+        if (slice == null) {
+            final Region region = new Region(x, y, x + width, y + height, u, v, u + sourceWidth, v + sourceHeight);
+            final Region clipped = direction != 0 && ratio > 0 ? clip(region, direction, ratio, pixelPerfect) : region;
+            return clipped.finite() ? List.of(clipped) : List.of();
+        }
+        final float[] sides = new float[4];
+        if (slice.isJsonArray() && slice.getAsJsonArray().size() == 4) {
+            for (int i = 0; i < 4; i++) sides[i] = slice.getAsJsonArray().get(i).getAsFloat();
+        } else if (slice.isJsonPrimitive() && slice.getAsJsonPrimitive().isNumber()) java.util.Arrays.fill(sides, slice.getAsFloat());
+        for (final float side : sides) if (!Float.isFinite(side) || side < 0 || side > 16384)
+            throw new IllegalArgumentException("Invalid native UI nine-slice");
+        if (width == 0) { sides[0] = 0; sides[2] = 0; }
+        if (height == 0) { sides[1] = 0; sides[3] = 0; }
+        float baseWidth = NativeUiLayout.vector(node, "base_size", 0, 0);
+        float baseHeight = NativeUiLayout.vector(node, "base_size", 1, 0);
+        if (baseWidth == 0 || baseHeight == 0) { baseWidth = sourceWidth; baseHeight = sourceHeight; }
+        final float[] dx = {x, x + sides[0], x + width - sides[2], x + width};
+        final float[] dy = {y, y + sides[1], y + height - sides[3], y + height};
+        final float[] sx = {u, u + sides[0] * sourceWidth / baseWidth, u + sourceWidth - sides[2] * sourceWidth / baseWidth, u + sourceWidth};
+        final float[] sy = {v, v + sides[1] * sourceHeight / baseHeight, v + sourceHeight - sides[3] * sourceHeight / baseHeight, v + sourceHeight};
+        final List<Region> result = new ArrayList<>(9);
+        // Native nine-slice clipping keeps the facing border and trims individual edges and the center.
+        for (final int[] cell : ORDER) {
+            final Region region = new Region(dx[cell[0]], dy[cell[1]], dx[cell[0] + 1], dy[cell[1] + 1],
+                sx[cell[0]], sy[cell[1]], sx[cell[0] + 1], sy[cell[1] + 1]);
+            if (direction == 0 || ratio == 0) result.add(region);
+            else if (cell[0] != 1 && cell[1] != 1) {
+                if (ratio > 0 && retainedBorder(cell, direction)) result.add(region);
+            } else if (ratio > 0 && retainedBorder(cell, direction)) result.add(region);
+            else if (cell[0] == 1 && cell[1] == 1 || ratio > 0 && !discardedBorder(cell, direction))
+                result.add(clip(region, direction, ratio, pixelPerfect));
+        }
+        // Native pixel clipping divides by each source extent, including zero-width slice interiors.
+        // Keep its finite geometry but never submit the resulting NaN coordinates to the Java renderer.
+        result.removeIf(region -> !region.finite());
+        return List.copyOf(result);
+    }
+
+    private static boolean retainedBorder(final int[] cell, final int direction) {
+        return switch (direction) {
+            case 1 -> cell[0] == 0;
+            case 2 -> cell[0] == 2;
+            case 3 -> cell[1] == 0;
+            case 4 -> cell[1] == 2;
+            default -> false;
+        };
+    }
+
+    private static boolean discardedBorder(final int[] cell, final int direction) {
+        return switch (direction) {
+            case 1 -> cell[0] == 2;
+            case 2 -> cell[0] == 0;
+            case 3 -> cell[1] == 2;
+            case 4 -> cell[1] == 0;
+            default -> false;
+        };
+    }
+
+    private static Region clip(final Region region, final int direction, final float ratio, final boolean pixelPerfect) {
+        final float sourceWidth = region.u1 - region.u0, sourceHeight = region.v1 - region.v0;
+        final float horizontal = direction == 1 || direction == 2 || direction == 5
+            ? clipFraction(ratio, sourceWidth, pixelPerfect) : 0;
+        final float vertical = direction == 3 || direction == 4 || direction == 5
+            ? clipFraction(ratio, sourceHeight, pixelPerfect) : 0;
+        final float shiftX = direction == 2 ? horizontal : direction == 5 ? horizontal / 2 : 0;
+        final float shiftY = direction == 4 ? vertical : direction == 5 ? vertical / 2 : 0;
+        final float width = region.x1 - region.x0, height = region.y1 - region.y0;
+        final float x = region.x0 + width * shiftX, y = region.y0 + height * shiftY;
+        final float u = region.u0 + sourceWidth * shiftX, v = region.v0 + sourceHeight * shiftY;
+        return new Region(x, y, x + (width - width * horizontal), y + (height - height * vertical),
+            u, v, u + (sourceWidth - sourceWidth * horizontal), v + (sourceHeight - sourceHeight * vertical));
+    }
+
+    private static float clipFraction(final float ratio, final float sourceExtent, final boolean pixelPerfect) {
+        return pixelPerfect ? (float) Math.floor(ratio * sourceExtent) / sourceExtent : ratio;
+    }
+
+    record Source(float u, float v, float width, float height) {}
+
+    public record Region(float x0, float y0, float x1, float y1, float u0, float v0, float u1, float v1) {
+        boolean finite() {
+            return Float.isFinite(x0) && Float.isFinite(y0) && Float.isFinite(x1) && Float.isFinite(y1)
+                && Float.isFinite(u0) && Float.isFinite(v0) && Float.isFinite(u1) && Float.isFinite(v1);
+        }
+    }
+}
