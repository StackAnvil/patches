+
+class OreUiAssetsTest {
+    private static final String IMAGE = "hbui/assets/animation-ab.gif";
+    private static Map<String, byte[]> files() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        files.put("oreui.json", ("{\"format\":1,\"version\":\"1.26.60.5\",\"stylesheet\":\"hbui/gameplay-ab.css\","
+                + "\"fonts\":[{\"family\":\"Fixture\",\"file\":\"hbui/fonts/minimal.ttf\",\"weight\":400,\"style\":\"normal\",\"sdf\":\"default\"}],"
+                + "\"images\":[\"" + IMAGE + "\"]}").getBytes(StandardCharsets.UTF_8));
+        files.put("NOTICE.txt", new byte[]{1}); files.put("hbui/gameplay-ab.css", new byte[]{1});
+        files.put("hbui/fonts/minimal.ttf", new byte[]{1}); files.put(IMAGE, OreUiAnimationTest.animation());
+        return files;
+    }
+    private static OreUiAssets read(final Map<String, byte[]> files) throws Exception {
+        final var output = new ByteArrayOutputStream();
+        try (var zip = new ZipOutputStream(output)) {
+            for (final var file : files.entrySet()) { zip.putNextEntry(new ZipEntry(file.getKey())); zip.write(file.getValue()); zip.closeEntry(); }
+        }
+        final byte[] bytes = output.toByteArray();
+        final var manifest = new JsonObject(); manifest.addProperty("format", 1); manifest.addProperty("version", "1.26.60.5");
+        manifest.addProperty("size", bytes.length); manifest.addProperty("sha256", HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+        return OreUiAssets.read(bytes, manifest);
+    }
+    @Test void exposesOnlyRegisteredImagesWithoutAllowingCallersToMutateTheBundle() throws Exception {
+        final var files = files(); final var assets = read(files);
+        final byte[] copy = assets.image(IMAGE); copy[0] = 0;
+        assertArrayEquals(files.get(IMAGE), assets.image(IMAGE));
+        assertThrows(IOException.class, () -> assets.image("hbui/fonts/minimal.ttf"));
+        assertThrows(UnsupportedOperationException.class, () -> assets.images().clear());
+    }
+    @Test void refusesUnregisteredMissingAndMalformedImagesDespiteAValidOuterChecksum() throws Exception {
+        final var files = files(); final byte[] image = files.remove(IMAGE);
+        assertThrows(IOException.class, () -> read(files));
+        files.put(IMAGE, image);
+        final var descriptor = JsonParser.parseString(new String(files.get("oreui.json"), StandardCharsets.UTF_8)).getAsJsonObject();
+        descriptor.remove("images"); files.put("oreui.json", descriptor.toString().getBytes(StandardCharsets.UTF_8));
+        assertThrows(IOException.class, () -> read(files));
+        files.put("oreui.json", files().get("oreui.json")); files.put(IMAGE, new byte[]{1, 2, 3});
+        assertThrows(IOException.class, () -> read(files));
+    }
+}
