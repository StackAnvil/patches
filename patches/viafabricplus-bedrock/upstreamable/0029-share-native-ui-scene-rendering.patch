+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.util.List;
+import java.util.UUID;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.FormattedText;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.util.FormattedCharSequence;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeUiRendererTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void measuresStyledParagraphsAndEmptyLinesInsteadOfLiteralEscapeSequences() {
+        final var font = mock(Font.class);
+        when(font.width(any(FormattedText.class))).thenAnswer(call -> ((FormattedText) call.getArgument(0)).getString().length() * 6);
+        final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+        final String first = UUID.randomUUID().toString(), second = UUID.randomUUID().toString().substring(0, 10);
+        final var node = label(first + "\n\n" + second);
+        final var size = renderer.intrinsic(node);
+        assertEquals(first.length() * 6, size.width());
+        assertEquals(font.lineHeight * 3, size.height());
+        final var escaped = label(first + "\\n" + second);
+        assertEquals((first.length() + second.length() + 2) * 6, renderer.intrinsic(escaped).width());
+        assertEquals(font.lineHeight, renderer.intrinsic(escaped).height());
+    }
+
+    @Test
+    void retainsWrappingForLiveScenesAndReleasesRetiredNodes() {
+        final var font = mock(Font.class);
+        when(font.split(any(FormattedText.class), anyInt())).thenReturn(List.of(FormattedCharSequence.EMPTY));
+        final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+        final var root = label(UUID.randomUUID().toString());
+        final var title = label(UUID.randomUUID().toString());
+        renderer.constrained(root, 100);
+        renderer.constrained(title, 100);
+        renderer.retain(List.of(root));
+        renderer.constrained(root, 100);
+        verify(font, times(2)).split(any(FormattedText.class), eq(100));
+        renderer.constrained(title, 100);
+        verify(font, times(3)).split(any(FormattedText.class), eq(100));
+        renderer.constrained(root, 50);
+        verify(font).split(any(FormattedText.class), eq(50));
+        renderer.reset();
+        renderer.constrained(root, 50);
+        verify(font, times(2)).split(any(FormattedText.class), eq(50));
+    }
+
+    private static NativeUiScene.Node label(final String value) {
+        final var properties = new JsonObject();
+        properties.addProperty("text", value);
+        return new NativeUiScene.Node(UUID.randomUUID().toString(), "label", properties, List.of(), Integer.MIN_VALUE);
+    }
+}
