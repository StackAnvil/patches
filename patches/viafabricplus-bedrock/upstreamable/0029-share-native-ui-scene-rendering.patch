+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.textures.GpuSampler;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen.GuiGraphicsExtractorAccess;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+import net.minecraft.client.gui.render.TextureSetup;
+import net.minecraft.client.renderer.state.gui.GuiElementRenderState;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+import org.joml.Matrix3x2f;
+import org.joml.Matrix3x2fc;
+
+/** Append-only atlas slots remain valid while GUI extraction queues later glyphs in the same frame. */
+public final class OreUiGlyphs implements AutoCloseable {
+    private static final int MAX_BYTES = 16 * 1024 * 1024;
+    private final Map<Key, Entry> entries = new HashMap<>();
+    private final List<Page> pages = new ArrayList<>();
+    private int allocatedBytes;
+    private boolean closed;
+
+    /** Resolves the native baseline within a line box before applying glyph bearings and cache scale. */
+    public OreUiFont.LineMetrics drawLine(final GuiGraphicsExtractor graphics, final OreUiText.Prepared text,
+                                         final float x, final float top, final float displayPixels, final Float lineHeight,
+                                         final Tint tint, final GpuSampler sampler, final boolean linearTint) throws IOException {
+        if (!Float.isFinite(top)) throw new IOException("Invalid OreUI line origin");
+        final var metrics = text.lineMetrics(displayPixels, lineHeight);
+        this.drawRun(graphics, text, x, top + metrics.baselineOffset(), displayPixels, tint, sampler, linearTint);
+        return metrics;
+    }
+
+    /** Draws one shaped line at an already resolved baseline; wrapping and fallback belong to layout. */
+    public void drawRun(final GuiGraphicsExtractor graphics, final OreUiText.Prepared text,
+                        final float x, final float baseline, final float displayPixels, final Tint tint,
+                        final GpuSampler sampler, final boolean linearTint) throws IOException {
+        if (this.closed) throw new IllegalStateException("OreUI glyph atlas is closed");
+        if (!Float.isFinite(displayPixels) || displayPixels <= 0 || text.pixels() <= 0 || text.shapingPixels() <= 0)
+            throw new IOException("Invalid OreUI text scale");
+        final float imageScale = displayPixels / text.pixels();
+        final float shapeScale = displayPixels / text.shapingPixels();
+        long penX = 0, penY = 0;
+        for (final var glyph : text.run().glyphs()) {
+            final var image = text.images().get(glyph.index());
+            if (image == null) throw new IOException("Prepared OreUI run has no image for this glyph");
+            final var raster = image.raster();
+            if (raster.width() != 0 && raster.height() != 0) {
+                final var field = image.distance();
+                final int width = field == null ? raster.width() : field.width();
+                final int height = field == null ? raster.height() : field.height();
+                final int paddingX = (width - raster.width()) / 2, paddingY = (height - raster.height()) / 2;
+                // Keep the native operation order: add the shaped origin, then the scaled cache bearing.
+                final float left = (penX + glyph.offsetX()) / 64F * shapeScale + x + (raster.left() - paddingX) * imageScale;
+                final float top = (baseline - (penY + glyph.offsetY()) / 64F * shapeScale) - (raster.top() + paddingY) * imageScale;
+                this.draw(graphics, text, glyph.index(), new Quad(left, top, left + width * imageScale,
+                        top + height * imageScale, imageScale, tint), sampler, linearTint);
+            }
+            penX += glyph.advanceX(); penY += glyph.advanceY();
+        }
+    }
+
+    /** Placement, coverage and sampling come from the caller's resolved native text run. */
+    public void draw(final GuiGraphicsExtractor graphics, final OreUiText.Prepared text, final int glyph,
+                     final Quad quad, final GpuSampler sampler, final boolean linearTint) throws IOException {
+        if (this.closed) throw new IllegalStateException("OreUI glyph atlas is closed");
+        RenderSystem.assertOnRenderThread();
+        quad.validate();
+        final var image = text.images().get(glyph);
+        if (image == null) throw new IOException("Prepared OreUI run has no image for this glyph");
+        if (image.raster().width() == 0 || image.raster().height() == 0) return;
+        final var pose = new Matrix3x2f(graphics.pose());
+        final var scissor = graphics.scissorStack.peek();
+        final int left = (int) Math.floor(quad.left), top = (int) Math.floor(quad.top);
+        var bounds = new ScreenRectangle(left, top, (int) Math.ceil(quad.right) - left, (int) Math.ceil(quad.bottom) - top).transformMaxBounds(pose);
+        if (scissor != null) bounds = bounds.intersection(scissor);
+        if (bounds == null || bounds.width() == 0 || bounds.height() == 0) return;
+        final var key = new Key(text.source(), text.face().file(), text.pixels(), text.sdf(), glyph);
+        var entry = this.entries.get(key);
+        if (entry == null) {
+            entry = this.upload(image);
+            this.entries.put(key, entry);
+        }
+        final var setup = TextureSetup.singleTexture(entry.page.texture.getTextureView(), sampler);
+        ((GuiGraphicsExtractorAccess) (Object) graphics).bedrockGuiState().addGlyphToCurrentLayer(new Draw(
+                OreUiPipeline.get(text.sdf(), linearTint), setup, pose, scissor, bounds, entry, quad));
+    }
+
+    private Entry upload(final OreUiText.Image image) throws IOException {
+        final var raster = image.raster();
+        final var field = image.distance();
+        final int width = field == null ? raster.width() : field.width();
+        final int height = field == null ? raster.height() : field.height();
+        final int stride = field == null ? raster.stride() : field.stride();
+        final byte[] source = field == null ? raster.pixels() : field.pixels();
+        Page page = null;
+        for (final var candidate : this.pages) if (candidate.admit(width, height)) { page = candidate; break; }
+        if (page == null) {
+            int side = 512;
+            while (side < width + 2 || side < height + 2) side *= 2;
+            if (side > 2048 || this.allocatedBytes + side * side * 4 > MAX_BYTES) throw new IOException("OreUI glyph atlas exceeds the texture budget");
+            page = new Page(side);
+            this.pages.add(page); this.allocatedBytes += side * side * 4;
+            if (!page.admit(width, height)) throw new IOException("OreUI glyph does not fit its atlas page");
+        }
+        final int x = page.x, y = page.y;
+        try (var upload = new NativeImage(width, height, true)) {
+            final var pixels = upload.getPixelBytes();
+            final var retained = page.texture.getPixels().getPixelBytes();
+            for (int row = 0; row < height; row++) {
+                for (int column = 0; column < width; column++) {
+                    final int value = Byte.toUnsignedInt(source[row * stride + column]);
+                    final int offset = (row * width + column) * 4;
+                    pixels.put(offset, (byte) value); pixels.put(offset + 1, (byte) 0); pixels.put(offset + 2, (byte) 0); pixels.put(offset + 3, (byte) 255);
+                    final int target = ((y + row) * page.side + x + column) * 4;
+                    retained.put(target, (byte) value); retained.put(target + 1, (byte) 0); retained.put(target + 2, (byte) 0); retained.put(target + 3, (byte) 255);
+                }
+            }
+            RenderSystem.getDevice().createCommandEncoder().writeToTexture(page.texture.getTexture(), upload, 0, 0, x, y);
+        }
+        page.x += width + 2; page.rowHeight = Math.max(page.rowHeight, height + 2);
+        return new Entry(page, x, y, width, height);
+    }
+
+    @Override
+    public void close() {
+        if (this.closed) return;
+        this.closed = true;
+        final var retiring = List.copyOf(this.pages);
+        this.entries.clear(); this.pages.clear(); this.allocatedBytes = 0;
+        final Runnable dispose = () -> {
+            RuntimeException failure = null;
+            for (final var page : retiring) {
+                try { Minecraft.getInstance().getTextureManager().release(page.id); }
+                catch (final RuntimeException cleanup) {
+                    if (failure == null) failure = cleanup;
+                    else failure.addSuppressed(cleanup);
+                }
+            }
+            if (failure != null) throw failure;
+        };
+        if (RenderSystem.isOnRenderThread()) dispose.run();
+        else Minecraft.getInstance().execute(dispose);
+    }
+
+    private static final class Page {
+        private final Identifier id = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "oreui/atlas/" + UUID.randomUUID());
+        private final int side;
+        private final DynamicTexture texture;
+        private int x = 1, y = 1, rowHeight;
+        private Page(final int side) {
+            this.side = side;
+            this.texture = new DynamicTexture(this.id::toString, new NativeImage(side, side, true));
+            try { Minecraft.getInstance().getTextureManager().register(this.id, this.texture); }
+            catch (final RuntimeException | Error failure) { this.texture.close(); throw failure; }
+        }
+        private boolean admit(final int width, final int height) {
+            if (width + 2 > this.side || height + 2 > this.side) return false;
+            if (this.x + width + 1 <= this.side) return this.y + height + 1 <= this.side;
+            if (this.y + this.rowHeight + height + 1 > this.side) return false;
+            this.x = 1; this.y += this.rowHeight; this.rowHeight = 0;
+            return true;
+        }
+    }
+
+    private record Key(OreUiAssets source, String file, int pixels, boolean sdf, int glyph) { }
+    private record Entry(Page page, int x, int y, int width, int height) { }
+    public record Tint(float red, float green, float blue, float alpha) { }
+    public record Quad(float left, float top, float right, float bottom, float coverage, Tint tint) {
+        private void validate() throws IOException {
+            if (!Float.isFinite(this.left) || !Float.isFinite(this.top) || !Float.isFinite(this.right) || !Float.isFinite(this.bottom)
+                    || this.right <= this.left || this.bottom <= this.top || !Float.isFinite(this.coverage) || this.coverage <= 0 || this.tint == null)
+                throw new IOException("Invalid OreUI glyph geometry");
+            for (final float channel : new float[]{this.tint.red, this.tint.green, this.tint.blue, this.tint.alpha})
+                if (!Float.isFinite(channel) || channel < 0 || channel > 1) throw new IOException("Invalid OreUI glyph tint");
+        }
+    }
+    private record Draw(RenderPipeline pipeline, TextureSetup textureSetup, Matrix3x2fc pose, ScreenRectangle scissorArea,
+                        ScreenRectangle bounds, Entry entry, Quad quad) implements GuiElementRenderState {
+        @Override public void buildVertices(final VertexConsumer vertices) {
+            this.vertex(vertices, this.quad.left, this.quad.top, this.entry.x, this.entry.y);
+            this.vertex(vertices, this.quad.left, this.quad.bottom, this.entry.x, this.entry.y + this.entry.height);
+            this.vertex(vertices, this.quad.right, this.quad.bottom, this.entry.x + this.entry.width, this.entry.y + this.entry.height);
+            this.vertex(vertices, this.quad.right, this.quad.top, this.entry.x + this.entry.width, this.entry.y);
+        }
+        private void vertex(final VertexConsumer target, final float x, final float y, final int u, final int v) {
+            target.addVertexWith2DPose(this.pose, x, y).setUv(this.quad.tint.blue, this.quad.tint.alpha)
+                    .setUv1(u, v).setUv3(this.quad.tint.red, this.quad.tint.green).setLineWidth(this.quad.coverage);
+        }
+    }
+}
