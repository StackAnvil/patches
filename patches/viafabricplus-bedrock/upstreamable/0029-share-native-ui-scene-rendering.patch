+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.awt.image.BufferedImage;
+import java.awt.image.IndexColorModel;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.Arrays;
+import javax.imageio.IIOImage;
+import javax.imageio.ImageIO;
+import javax.imageio.metadata.IIOMetadataNode;
+import javax.imageio.stream.MemoryCacheImageOutputStream;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiAnimationTest {
+    static byte[] animation() throws IOException {
+        final var bytes = new ByteArrayOutputStream();
+        final var writer = ImageIO.getImageWritersByFormatName("gif").next();
+        try (var output = new MemoryCacheImageOutputStream(bytes)) {
+            writer.setOutput(output); writer.prepareWriteSequence(null);
+            final var colors = new IndexColorModel(2, 4, new byte[]{0, -1, 0, 0}, new byte[]{0, 0, 0, -1}, new byte[]{0, 0, -1, 0}, 0);
+            final String[] disposal = {"doNotDispose", "restoreToPrevious", "restoreToBackgroundColor", "doNotDispose"};
+            final int[][] pixels = {{1, 0}, {0, 2}, {3, 0}, {0, 2}};
+            for (int i = 0; i < pixels.length; i++) {
+                final var image = new BufferedImage(2, 1, BufferedImage.TYPE_BYTE_INDEXED, colors);
+                image.getRaster().setSamples(0, 0, 2, 1, 0, pixels[i]);
+                final var metadata = writer.getDefaultImageMetadata(javax.imageio.ImageTypeSpecifier.createFromRenderedImage(image), null);
+                final var tree = (IIOMetadataNode) metadata.getAsTree("javax_imageio_gif_image_1.0");
+                final var control = (IIOMetadataNode) tree.getElementsByTagName("GraphicControlExtension").item(0);
+                control.setAttribute("disposalMethod", disposal[i]); control.setAttribute("delayTime", Integer.toString((i + 1) * 10));
+                control.setAttribute("transparentColorFlag", "TRUE"); control.setAttribute("transparentColorIndex", "0");
+                metadata.setFromTree("javax_imageio_gif_image_1.0", tree);
+                writer.writeToSequence(new IIOImage(image, null, metadata), null);
+            }
+            writer.endWriteSequence(); output.flush();
+        } finally { writer.dispose(); }
+        return bytes.toByteArray();
+    }
+
+    @Test void restoresTransparentBackgroundAndPreviousFramesAtOriginalDeliveryBoundaries() throws Exception {
+        final var animation = OreUiAnimation.decode(animation());
+        assertArrayEquals(new int[]{0xffff0000, 0}, animation.frame(0).argb());
+        assertSame(animation.frame(0), animation.frame(99));
+        assertArrayEquals(new int[]{0xffff0000, 0xff0000ff}, animation.frame(100).argb());
+        assertArrayEquals(new int[]{0xff00ff00, 0}, animation.frame(300).argb());
+        assertArrayEquals(new int[]{0, 0xff0000ff}, animation.frame(600).argb());
+        assertSame(animation.frame(0), animation.frame(1000));
+        final int[] external = animation.frame(0).argb(); external[0] = 0;
+        assertEquals(0xffff0000, animation.frame(0).argb()[0]);
+    }
+
+    @Test void rejectsAnOversizedCanvasBeforeAllocatingDecodedFrames() throws Exception {
+        final byte[] bytes = animation();
+        bytes[6] = 0; bytes[7] = 8; bytes[8] = 0; bytes[9] = 8;
+        assertThrows(IOException.class, () -> OreUiAnimation.decode(bytes));
+        assertThrows(IOException.class, () -> OreUiAnimation.decode(Arrays.copyOf(bytes, 13)));
+    }
+
+    @Test void decodesTheAcquiredNativeSpinnerWithoutReplacingItsFramesOrDurations() throws Exception {
+        final var assets = OreUiAssets.bundled();
+        final String path = "hbui/assets/animation-074ed0ba8c16bb30e36c.gif";
+        org.junit.jupiter.api.Assumptions.assumeTrue(assets.images().contains(path), "Regenerated native OreUI images are required");
+        final var animation = OreUiAnimation.decode(assets.image(path));
+        assertEquals(28, animation.width()); assertEquals(28, animation.height());
+        assertEquals(10, animation.frames().size()); assertEquals(1000, animation.durationMillis());
+        for (final var frame : animation.frames()) assertEquals(100, frame.durationMillis());
+        assertFalse(Arrays.equals(animation.frame(0).argb(), animation.frame(100).argb()));
+    }
+}
