+
+@Mixin(Gui.class)
+public abstract class MixinNativeUiExtraction {
+    @Shadow @Final private Minecraft minecraft;
+    @Shadow @Final private GuiRenderState guiRenderState;
+
+    @WrapOperation(method = "extractRenderState", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;extractRenderStateWithTooltipAndSubtitles(Lnet/minecraft/client/gui/GuiGraphicsExtractor;IIF)V"))
+    private void nativeExtraction(final Screen screen, final GuiGraphicsExtractor graphics, final int x, final int y,
+                                  final float delta, final Operation<Void> original) {
+        if (!(screen instanceof NativeUiScreen nativeScreen)) {
+            original.call(screen, graphics, x, y, delta);
+            return;
+        }
+        final var viewport = nativeScreen.nativeViewport();
+        final int nativeX = (int) viewport.pointer(x), nativeY = (int) viewport.pointer(y);
+        original.call(screen, new NativeUiGraphics(this.minecraft, this.guiRenderState, graphics, viewport, nativeX, nativeY),
+            nativeX, nativeY, delta);
+    }
+}
