+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiAsepriteTest {
+    @Test
+    void skipsElapsedFramesLoopsAndResetsUvWithoutRewindingPhase() {
+        final var node = node();
+        final var lifecycle = new NativeUiAnimationLifecycle(node);
+        final var animations = lifecycle.animations();
+        lifecycle.advance(499_000_000);
+        assertEquals(new NativeUiImageRegions.Source(10, 2, 148, 128), animations.source(node, 444, 128));
+        lifecycle.advance(500_000_000);
+        assertEquals(84, animations.source(node, 444, 128).u());
+        lifecycle.advance(700_000_000);
+        assertEquals(158, animations.source(node, 444, 128).u());
+        animations.event(node, "reset", 700_000_000);
+        assertEquals(new NativeUiImageRegions.Source(0, 0, 148, 128), animations.source(node, 444, 128));
+        lifecycle.advance(701_000_000);
+        assertEquals(158, animations.source(node, 444, 128).u());
+        lifecycle.advance(2_801_000_000L);
+        assertEquals(10, animations.source(node, 444, 128).u());
+        assertEquals(new NativeUiImageRegions.Source(10, 2, 74, 64), animations.source(node, 222, 64));
+    }
+
+    @Test
+    void rebindsTextureMetadataWhileRetainingTheAnimationClock() {
+        final var node = node();
+        final var lifecycle = new NativeUiAnimationLifecycle(node);
+        lifecycle.advance(700_000_000);
+        final var replacement = node();
+        replacement.properties().add("aseprite", metadata(444, 128, 40, 1000));
+        lifecycle.replaceRoot(replacement, 700_000_000);
+        lifecycle.advance(701_000_000);
+        assertEquals(new NativeUiImageRegions.Source(40, 2, 74, 64), lifecycle.animations().source(replacement, 444, 128));
+        lifecycle.advance(1_001_000_000);
+        assertEquals(114, lifecycle.animations().source(replacement, 444, 128).u());
+        final var reopened = new NativeUiAnimationLifecycle(replacement);
+        reopened.advance(1_000_000);
+        assertEquals(40, reopened.animations().source(replacement, 444, 128).u());
+    }
+
+    @Test
+    void waitsForMetadataAndRenderGatesWithoutCompletingOrConsumingPhase() {
+        final var node = node();
+        node.properties().remove("aseprite");
+        final var lifecycle = new NativeUiAnimationLifecycle(node);
+        lifecycle.advance(2_000_000_000L);
+        final var replacement = node();
+        lifecycle.replaceRoot(replacement, 2_000_000_000L);
+        lifecycle.advance(2_100_000_000L);
+        assertEquals(10, lifecycle.animations().source(replacement, 222, 64).u());
+        lifecycle.advance(2_500_000_000L);
+        assertEquals(84, lifecycle.animations().source(replacement, 222, 64).u());
+        final var gated = node();
+        gated.properties().getAsJsonObject("animation_program").getAsJsonArray("tracks").get(0).getAsJsonObject()
+            .addProperty("wait_until_rendered_to_play", true);
+        final var animations = new NativeUiAnimations();
+        animations.advance(gated, 1_000_000_000L);
+        assertEquals(0, animations.source(gated, 222, 64).u());
+        animations.opacityAt(gated, 1_000_000_000L);
+        animations.advance(gated, 1_100_000_000L);
+        assertEquals(10, animations.source(gated, 222, 64).u());
+    }
+
+    @Test
+    void emptyMetadataResetsUvAndNativeIntegerOverflowSelectsTheFirstFrame() {
+        final var player = new NativeUiAseprite();
+        final var metadata = NativeUiAseprite.Metadata.parse(metadata(222, 64, 10, 500));
+        assertEquals(metadata.frames().getFirst(), player.advance(metadata, 2147484));
+        final var empty = new NativeUiAseprite.Metadata(222, 64, List.of(), 0);
+        assertEquals(new NativeUiAseprite.Frame(0, 0, 0), player.advance(empty, .1F));
+        assertNull(player.advance(null, 1));
+    }
+
+    private static NativeUiScene.Node node() {
+        final var properties = new JsonObject();
+        final var definition = new JsonObject();
+        definition.addProperty("anim_type", "aseprite_flip_book");
+        definition.addProperty("reset_event", "reset");
+        final var tracks = new JsonArray(); tracks.add(definition);
+        AnimationPrograms.attach(properties, tracks, false);
+        final var crop = new JsonArray(); crop.add(74); crop.add(64); properties.add("uv_size", crop);
+        properties.add("aseprite", metadata(222, 64, 10, 500));
+        return new NativeUiScene.Node("image", "image", properties, List.of(), Integer.MIN_VALUE);
+    }
+
+    private static JsonObject metadata(final int width, final int height, final int firstX, final int firstDuration) {
+        final var metadata = new JsonObject();
+        final var size = new JsonArray(); size.add(width); size.add(height); metadata.add("size", size);
+        final var frames = new JsonArray();
+        for (int index = 0; index < 3; index++) {
+            final var frame = new JsonArray(); frame.add(firstX + 74 * index); frame.add(2 + index);
+            frame.add(index == 0 ? firstDuration : 200); frames.add(frame);
+        }
+        metadata.add("frames", frames);
+        return metadata;
+    }
+}
