+/** The versioned OreUI stylesheet and font faces remain separate from classic JSON UI assets. */
+public final class OreUiAssets {
+    private static final int MAX_BYTES = 64 * 1024 * 1024;
+    private static final String ROOT = "/assets/viafabricplus-bedrock/builtin_oreui.zip";
+    private static OreUiAssets bundled;
+    private final Map<String, byte[]> files;
+    private final List<Face> faces;
+    private final String stylesheet;
+    private final List<String> images;
