+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.io.IOException;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class OreUiFontTest {
+    private static byte[] resource(final String name) throws IOException {
+        try (var input = OreUiFontTest.class.getResourceAsStream("/oreui/" + name)) {
+            assertNotNull(input);
+            return input.readAllBytes();
+        }
+    }
+
+    private static OreUiShaper engine() throws IOException {
+        assumeTrue(OreUiShaper.class.getResource("/assets/viafabricplus-bedrock/oreui-shaper/" + OreUiShaper.platform() + "/manifest.json") != null,
+                "Bundled native OreUI engine is required");
+        return OreUiShaper.bundled();
+    }
+
+    private static OreUiAssets assets() throws Exception { return assets("minimal.ttf"); }
+
+    private static OreUiAssets assets(final String fixture) throws Exception { return assets(fixture, null); }
+
+    private static OreUiAssets assets(final String fixture, final String fallback) throws Exception {
+        final var files = new LinkedHashMap<String, byte[]>();
+        files.put("oreui.json", ("{\"format\":1,\"version\":\"1.26.60.5\",\"stylesheet\":\"hbui/gameplay-0000.css\",\"fonts\":["
+                + "{\"family\":\"Fixture\",\"file\":\"hbui/fonts/minimal.ttf\",\"weight\":400,\"style\":\"normal\",\"sdf\":\"default\"},"
+                + "{\"family\":\"Fixture\",\"file\":\"hbui/fonts/minimal.ttf\",\"weight\":700,\"style\":\"normal\",\"sdf\":\"off\"}"
+                + (fallback == null ? "" : ",{\"family\":\"Fallback\",\"file\":\"hbui/fonts/fallback.ttf\",\"weight\":400,\"style\":\"normal\",\"sdf\":\"default\"}") + "]}"
+                ).getBytes(StandardCharsets.UTF_8));
+        files.put("hbui/gameplay-0000.css", "fixture".getBytes(StandardCharsets.UTF_8));
+        files.put("NOTICE.txt", "Authored test font".getBytes(StandardCharsets.UTF_8));
+        files.put("hbui/fonts/minimal.ttf", resource(fixture));
+        if (fallback != null) files.put("hbui/fonts/fallback.ttf", resource(fallback));
+        final var output = new ByteArrayOutputStream();
+        try (var zip = new ZipOutputStream(output)) {
+            for (final var entry : files.entrySet()) {
+                zip.putNextEntry(new ZipEntry(entry.getKey())); zip.write(entry.getValue()); zip.closeEntry();
+            }
+        }
+        final byte[] bytes = output.toByteArray();
+        final String hash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+        return OreUiAssets.read(bytes, JsonParser.parseString("{\"format\":1,\"version\":\"1.26.60.5\",\"size\":" + bytes.length
+                + ",\"sha256\":\"" + hash + "\"}").getAsJsonObject());
+    }
+
+    @Test
+    void measuresDisjointFontCoverageWithoutReplacingThePrimaryCharacters() throws Exception {
+        final var assets = assets("minimal.ttf", "fallback-coverage.ttf");
+        final var characters = OreUiCharacters.prepare("aBa", OreUiCharacters.LineEndings.NORMALIZE,
+                OreUiLines.WhiteSpace.NORMAL, 13F, 0F);
+        try (var text = new OreUiText(assets, engine())) {
+            final var result = text.ordinaryFonts(List.of(assets.faces().getFirst(), assets.faces().get(2)), 13, characters, "en");
+            assertEquals(List.of(new OreUiFonts.Glyph('a', 1, 0, 499F / 64F),
+                    new OreUiFonts.Glyph('B', 1, 1, 749F / 64F), new OreUiFonts.Glyph('a', 1, 0, 499F / 64F)), result.glyphs());
+            final float[] advances = new float[result.glyphs().size()];
+            final int[] fontMap = new int[advances.length];
+            for (int index = 0; index < advances.length; index++) {
+                advances[index] = result.glyphs().get(index).advance();
+                fontMap[index] = result.glyphs().get(index).font();
+            }
+            final var layout = OreUiLines.layout(characters.scalars(), advances, fontMap,
+                    List.of(new OreUiLines.Font(1, text.lineMetrics(assets.faces().getFirst(), 13, null)),
+                            new OreUiLines.Font(2, text.lineMetrics(assets.faces().get(2), 13, null))),
+                    18F, 0F, 0F, OreUiLines.WhiteSpace.NORMAL, OreUiLines.OverflowWrap.NORMAL, OreUiLines.Alignment.LEFT, false);
+            assertEquals(List.of(1, 2, 1), layout.lines().stream().map(line -> line.fragments().getFirst().font()).toList());
+            assertEquals(749F / 64F, layout.width());
+            assertEquals(42F, layout.height());
+        }
+    }
+
+    @Test
+    void keepsPrimaryGlyphsWhileSelectingNativeLocaleFallbackFaces() throws Exception {
+        assumeTrue(OreUiAssets.class.getResource("/assets/viafabricplus-bedrock/builtin_oreui.zip") != null,
+                "Acquired native OreUI assets are required");
+        final var assets = OreUiAssets.bundled();
+        try (var stream = OreUiFontTest.class.getResourceAsStream("/oreui/native-locale-fonts-2225.json");
+             var text = new OreUiText(assets, engine())) {
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var sample = entry.getAsJsonObject();
+                final var faces = assets.regularFaces(sample.get("primaryFamily").getAsString(), sample.get("locale").getAsString());
+                final var families = sample.getAsJsonArray("families");
+                assertEquals(families.size(), faces.size(), sample.toString());
+                for (int index = 0; index < faces.size(); index++) {
+                    final String family = families.get(index).getAsString();
+                    if (family.equals("Unavailable")) assertNull(faces.get(index), sample.toString());
+                    else assertEquals(family, faces.get(index).family(), sample.toString());
+                }
+                final var characters = OreUiCharacters.prepare(sample.get("text").getAsString(),
+                        OreUiCharacters.LineEndings.NORMALIZE, OreUiLines.WhiteSpace.NORMAL, 16F, 0F);
+                final var assigned = text.ordinaryFonts(faces, 16, characters, "en");
+                assertArrayEquals(sample.getAsJsonArray("glyphs").asList().stream().mapToInt(value -> value.getAsInt()).toArray(),
+                        assigned.glyphs().stream().mapToInt(OreUiFonts.Glyph::index).toArray(), sample.toString());
+                assertArrayEquals(sample.getAsJsonArray("fonts").asList().stream().mapToInt(value -> value.getAsInt()).toArray(),
+                        assigned.glyphs().stream().mapToInt(OreUiFonts.Glyph::font).toArray(), sample.toString());
+            }
+        }
+    }
+
+    @Test
+    void measuresOrdinaryCharactersWithoutChangingLigaturesInDrawRuns() throws Exception {
+        final var assets = assets("ordinary-advances.ttf");
+        try (var text = new OreUiText(assets, engine())) {
+            final var face = assets.faces().getFirst();
+            assertEquals(1, text.prepareDefault(face, 13, "aa", "en").run().glyphs().size());
+            assertArrayEquals(new float[]{499F / 64F, 499F / 64F}, text.ordinaryAdvances(face, 13, "aa", "en"));
+            assertArrayEquals(new float[]{499F / 64F, 0F, 499F / 64F}, text.ordinaryAdvances(face, 13, "a\u0301a", "en"));
+            assertArrayEquals(new float[0], text.ordinaryAdvances(face, 13, "", "en"));
+            assertEquals(1, text.prepareDefault(face, 13, "aa", "en").run().glyphs().size());
+        }
+    }
+
+    @Test
+    void measuresNominalGlyphsAndExcludesSpacesFromLegacyKerning() throws Exception {
+        for (final String fixture : List.of("nominal-advances.ttf", "kerning-advances.ttf")) {
+            final var assets = assets(fixture);
+            try (var text = new OreUiText(assets, engine())) {
+                final var face = assets.faces().getFirst();
+                final float a = 499F / 64F;
+                assertArrayEquals(new float[]{fixture.startsWith("kerning") ? a - 1F : a, a},
+                        text.ordinaryAdvances(face, 13, "aa", "en"));
+                assertArrayEquals(new float[]{a, 250F / 64F, a}, text.ordinaryAdvances(face, 13, "a a", "en"));
+                assertArrayEquals(new float[]{a, a, a}, text.ordinaryAdvances(face, 13, "a\uD83D\uDE00a", "en"));
+                assertArrayEquals(new float[]{a}, text.ordinaryAdvances(face, 13, "a", "en"));
+            }
+        }
+    }
+
+    @Test
+    void selectsDefaultImagesAtTheNativeSizeBoundaryAndHonorsFaceOptOut() throws Exception {
+        final var assets = assets();
+        try (var text = new OreUiText(assets, engine())) {
+            final var face = assets.faces().getFirst();
+            final var small = text.prepareDefault(face, 9, "a", "en");
+            assertFalse(small.sdf()); assertEquals(9, small.pixels());
+            assertNull(small.images().get(1).distance());
+            final var boundary = text.prepareDefault(face, 10, "a", "en");
+            assertTrue(boundary.sdf()); assertEquals(52, boundary.pixels());
+            assertEquals(10, boundary.shapingPixels());
+            assertNotNull(boundary.images().get(1).distance());
+            final var larger = text.prepareDefault(face, 32, "a", "en");
+            assertSame(boundary.images().get(1), larger.images().get(1));
+            final var optedOut = text.prepareDefault(assets.faces().get(1), 32, "a", "en");
+            assertFalse(optedOut.sdf()); assertEquals(32, optedOut.pixels());
+            assertNull(optedOut.images().get(1).distance());
+        }
+    }
+
+    @Test
+    void preparesDescriptorSelectedGlyphIdsAndNativeCacheImages() throws Exception {
+        // Original 1.26.60.5 parser, shaper and rasterizer execute on this authored font.
+        final var assets = assets();
+        try (var text = new OreUiText(assets, engine())) {
+            final var prepared = text.prepare(assets.faces().getFirst(), 52, 52, true, "a\u0301", "en-US");
+            assertEquals(new OreUiFont.LineMetrics(48F, 65F), prepared.lineMetrics(52F, 65F));
+            final var run = prepared.run();
+            assertEquals(List.of(new OreUiFont.Glyph(1, 0, 1997, 0, 0, 0),
+                    new OreUiFont.Glyph(2, 0, 0, 0, -2001, -4)), run.glyphs());
+            assertEquals(1997, run.advanceX());
+            final var image = prepared.images().get(run.glyphs().getFirst().index());
+            final var raster = image.raster();
+            assertEquals(26, raster.width()); assertEquals(37, raster.height());
+            assertEquals(1997, raster.advance());
+            final byte[] expected = new byte[26 * 37];
+            Arrays.fill(expected, 0, 26, (byte) 103);
+            Arrays.fill(expected, 26, expected.length, (byte) 255);
+            assertArrayEquals(expected, raster.pixels());
+            final var field = image.distance();
+            assertEquals(34, field.width()); assertEquals(45, field.height()); assertEquals(36, field.stride());
+            assertArrayEquals(resource("minimal-a.sdf"), field.pixels());
+            final var small = text.prepare(assets.faces().getFirst(), 52, 13, true, "a\u0301", "en-US");
+            assertEquals(new OreUiFont.LineMetrics(12F, 17F), small.lineMetrics(13F, 16.25F));
+            assertEquals(List.of(new OreUiFont.Glyph(1, 0, 499, 0, 0, 0),
+                    new OreUiFont.Glyph(2, 0, 0, 0, -500, -1)), small.run().glyphs());
+            assertSame(image, small.images().get(1), "Changing shaping size must reuse the independent glyph image");
+            final var plain = text.prepare(assets.faces().getLast(), 52, 52, false, "a", "en-US");
+            assertNull(plain.images().get(1).distance());
+            assertArrayEquals(expected, plain.images().get(1).raster().pixels());
+            assertThrows(IOException.class, () -> text.prepare(assets.faces().getLast(), 52, 52, true, "a", "en-US"));
+        }
+    }
+
+    @Test
+    void retiringAnEngineClosesItsFontsAndPreservesAnotherEngine() throws Exception {
+        final byte[] bytes = resource("minimal.ttf");
+        try (var first = engine(); var second = engine(); var independent = second.font(bytes, 52)) {
+            final var retained = first.font(bytes, 52);
+            first.close();
+            assertThrows(IllegalStateException.class, () -> retained.shape("a", "en-US"));
+            assertThrows(IllegalStateException.class, () -> retained.raster(1));
+            assertThrows(IllegalStateException.class, () -> first.font(bytes, 52));
+            assertEquals(1997, independent.shape("a", "en-US").advanceX());
+            retained.close();
+        }
+    }
+
+    @Test
+    void failedFontConstructionRetainsNeitherSlotsNorInvalidatesAnExistingFace() throws Exception {
+        try (var engine = engine(); var live = engine.font(resource("minimal.ttf"), 52)) {
+            final byte[] invalid = new byte[12]; invalid[1] = 1;
+            for (int index = 0; index < 40; index++) assertThrows(IOException.class, () -> engine.font(invalid, 52));
+            try (var next = engine.font(resource("minimal.ttf"), 52)) {
+                assertEquals(1997, live.shape("a", "en-US").advanceX());
+                assertEquals(live.shape("a\u0301", "en-US"), next.shape("a\u0301", "en-US"));
+            }
+        }
+    }
+}
