diff --git a/src/test/resources/oreui/make-fixture.py b/src/test/resources/oreui/make-fixture.py
new file mode 100644
index 0000000..29d6fff
--- /dev/null
+++ b/src/test/resources/oreui/make-fixture.py
@@ -0,0 +1,87 @@
+"""Build an authored four-glyph TrueType fixture with mark-to-base positioning."""
+from pathlib import Path
+import struct
+
+
+def u16(*values):
+    return struct.pack('>' + 'H' * len(values), *(x & 65535 for x in values))
+
+
+def u32(*values):
+    return struct.pack('>' + 'I' * len(values), *values)
+
+
+def rectangle(width, height):
+    return u16(1, 0, 0, width, height, 3, 0) + bytes([1] * 4) + u16(0, width, 0, -width, 0, 0, height, 0)
+
+
+head = u32(0x10000, 0x10000, 0, 0x5f0f3cf5) + u16(0, 1000) + bytes(16) + u16(0, 0, 500, 700, 0, 8, 2, 0, 0)
+hhea = u32(0x10000) + u16(800, -200, 0, 600, 0, 0, 500, 1, 0, 0, 0, 0, 0, 0, 0, 4)
+maxp = u32(0x10000) + u16(4, 4, 1, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0, 0)
+a, mark = rectangle(500, 700), rectangle(100, 100)
+glyf = a + mark
+loca = u16(0, 0, len(a) // 2, len(glyf) // 2, len(glyf) // 2)
+hmtx = u16(600, 0, 600, 0, 0, 0, 300, 0)
+characters = [32, 97, 0x301, 65535]
+cmapping = u16(4, 48, 0, 8, 8, 2, 0, *characters, 0, *characters,
+              3-32, 1-97, 2-0x301, 1, 0, 0, 0, 0)
+cmap = u16(0, 1, 3, 1) + u32(12) + cmapping
+scripts = u16(1) + b'DFLT' + u16(8, 4, 0, 0, 65535, 1, 0)
+features = u16(1) + b'mark' + u16(8, 0, 1, 0)
+subtable = u16(1, 12, 18, 1, 24, 36, 1, 1, 2, 1, 1, 1,
+               1, 0, 6, 1, 2, 2, 1, 4, 1, 1, 1)
+lookups = u16(1, 4, 4, 0, 1, 8) + subtable
+gpos = u32(0x10000) + u16(10, 10+len(scripts), 10+len(scripts)+len(features)) + scripts + features + lookups
+post = u32(0x30000) + bytes(28)
+tables = {'GPOS': gpos, 'cmap': cmap, 'glyf': glyf, 'head': head, 'hhea': hhea,
+          'hmtx': hmtx, 'loca': loca, 'maxp': maxp, 'post': post}
+
+
+def checksum(data):
+    data += bytes((-len(data)) & 3)
+    return sum(struct.unpack('>' + 'I' * (len(data) // 4), data)) & 0xffffffff
+
+
+def write_font(tables, filename):
+    count = len(tables)
+    power = 1 << (count.bit_length() - 1)
+    font = bytearray(u32(0x10000) + u16(count, power * 16, power.bit_length()-1, count*16-power*16) + bytes(count*16))
+    head_at = None
+    for index, (tag, contents) in enumerate(sorted(tables.items())):
+        font += bytes((-len(font)) & 3)
+        offset = len(font)
+        struct.pack_into('>4sIII', font, 12 + index * 16, tag.encode(), checksum(contents), offset, len(contents))
+        font += contents
+        if tag == 'head':
+            head_at = offset
+    struct.pack_into('>I', font, head_at + 8, (0xb1b0afba - checksum(font)) & 0xffffffff)
+    assert checksum(font) == 0xb1b0afba
+    Path(__file__).with_name(filename).write_bytes(font)
+
+
+write_font(tables, 'minimal.ttf')
+# Reuse the a outline for an authored aa ligature. Retain the mark GPOS table.
+# Ordinary measurement must keep both advances while full drawing can substitute one glyph.
+ligature_features = u16(1) + b'liga' + u16(8, 0, 1, 0)
+ligature_subtable = u16(1, 8, 1, 14, 1, 1, 1, 1, 4, 1, 2, 1)
+ligature_lookups = u16(1, 4, 4, 0, 1, 8) + ligature_subtable
+ligature_tables = dict(tables)
+ligature_tables['GSUB'] = (u32(0x10000) + u16(10, 10+len(scripts), 10+len(scripts)+len(ligature_features))
+                           + scripts + ligature_features + ligature_lookups)
+write_font(ligature_tables, 'ordinary-advances.ttf')
+nominal_tables = {tag: contents for tag, contents in ligature_tables.items() if tag != 'GPOS'}
+write_font(nominal_tables, 'nominal-advances.ttf')
+# Include space pairs to catch the native ordinary path's explicit space exclusion.
+kerning_tables = dict(nominal_tables)
+pairs = u16(1, 1, -100, 1, 3, -100, 3, 1, -100)
+kerning_tables['kern'] = u16(0, 1, 0, 14 + len(pairs), 1, 3, 12, 1, 6) + pairs
+write_font(kerning_tables, 'kerning-advances.ttf')
+
+# A disjoint Latin fallback face gives B a distinct advance while leaving a missing.
+fallback_tables = {tag: contents for tag, contents in tables.items() if tag != 'GPOS'}
+fallback_characters = [32, 66, 0x301, 65535]
+fallback_mapping = u16(4, 48, 0, 8, 8, 2, 0, *fallback_characters, 0, *fallback_characters,
+                       3-32, 1-66, 2-0x301, 1, 0, 0, 0, 0)
+fallback_tables['cmap'] = u16(0, 1, 3, 1) + u32(12) + fallback_mapping
+fallback_tables['hmtx'] = u16(600, 0, 900, 0, 0, 0, 300, 0)
+write_font(fallback_tables, 'fallback-coverage.ttf')
