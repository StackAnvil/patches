+#version 330
+#extension GL_ARB_separate_shader_objects : require
+#include <minecraft:dynamictransforms.glsl>
+#include <minecraft:projection.glsl>
+
+uniform sampler2D Sampler0;
+layout(location = 0) in vec3 Position;
+layout(location = 1) in vec2 UV0;
+layout(location = 2) in ivec2 UV1;
+layout(location = 3) in vec2 UV3;
+layout(location = 4) in float LineWidth;
+layout(location = 0) out vec4 nativeTint;
+layout(location = 1) out vec2 glyphUv;
+layout(location = 2) out float coverageRatio;
+
+void main() {
+    gl_Position = ProjMat * ModelViewMat * vec4(Position, 1.0);
+    // Float payloads retain premultiplied native tint without an eight-bit color conversion.
+    nativeTint = vec4(UV3, UV0);
+    glyphUv = vec2(UV1) / vec2(textureSize(Sampler0, 0));
+    coverageRatio = LineWidth;
+}
