+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiSceneTest {
+    @Test
+    void preservesNativeIntegerTypesAndPropertyDefaults() {
+        for (final String encoded : List.of("true", "-1", "1", "9223372036854775807", "9223372036854775808", "18446744073709551615")) {
+            assertTrue(node(encoded).flag("enabled", false));
+        }
+        for (final String encoded : List.of("false", "0", "-0")) {
+            assertFalse(node(encoded).flag("enabled", true));
+        }
+        for (final String encoded : List.of("null", "\"true\"", "[]", "{}", "1.0", "0.0", "1e0", "-9223372036854775809", "18446744073709551616")) {
+            for (final boolean fallback : new boolean[]{false, true}) assertEquals(fallback, node(encoded).flag("enabled", fallback));
+        }
+    }
+
+    @Test
+    void usesTheSameFlagsForVisibilityAdmissionAndResolvedProperties() {
+        for (final String property : List.of("visible", "ignored")) {
+            final JsonObject scene = JsonParser.parseString("{\"format\":1,\"root\":{\"type\":\"unavailable\"}}").getAsJsonObject();
+            scene.getAsJsonObject("root").addProperty(property, property.equals("visible") ? 0 : 1);
+            final var node = NativeUiScene.parse(scene.toString(), Set.of()).root();
+            assertEquals(property.equals("ignored"), node.flag(property, property.equals("visible")));
+            scene.getAsJsonObject("root").addProperty(property, property.equals("visible") ? 1 : 0);
+            assertThrows(IllegalArgumentException.class, () -> NativeUiScene.parse(scene.toString(), Set.of()));
+        }
+    }
+
+    private static NativeUiScene.Node node(final String encoded) {
+        return new NativeUiScene.Node("", "button", JsonParser.parseString("{\"enabled\":" + encoded + "}").getAsJsonObject(), List.of(), Integer.MIN_VALUE);
+    }
+}
