+        assertEquals(.5F, animations.opacityAt(first, 500_000_000).current());
+        assertEquals(.25F, animations.opacityAt(second, 250_000_000).current());
+        animations.advance(second, 750_000_000);
+        animations.advance(first, 750_000_000);
+        assertEquals(.75F, animations.opacityAt(first, 750_000_000).current());
+        assertEquals(.75F, animations.opacityAt(second, 750_000_000).current());
+    }
+
+    @Test
+    void entranceFadeRetainsTheAuthoredBackdropOpacityAcrossSceneRefreshes() {
+        final var fade = track("alpha", 1, 0, 1);
+        fade.addProperty("scale_from_starting_alpha", true);
+        final var node = animated(fade);
+        node.properties().addProperty("alpha", .4F);
+        final var animations = new NativeUiAnimations();
+        assertEquals(0, animations.opacityAt(node, 0).current());
+        assertEquals(.4F, animations.opacityAt(node, 0).potential());
+        assertEquals(.2F, animations.opacityAt(node, 500_000_000).current(), .000001F);
+        final var replacement = new NativeUiScene.Node(node.name(), node.type(), node.properties().deepCopy(),
+                node.children(), node.action());
+        animations.reconcile(Map.of(node, replacement), 500_000_000);
+        assertEquals(.4F, animations.opacityAt(replacement, 1_000_000_000).current(), .000001F);
+
+        fade.addProperty("scale_from_starting_alpha", false);
+        final var absolute = animated(fade);
+        absolute.properties().addProperty("alpha", .4F);
+        assertEquals(.5F, new NativeUiAnimations().opacityAt(absolute, 500_000_000).current(), .000001F);
+    }
+
+    @Test
+    void treatsUnsetAnimationBindingsAsOmittedProperties() {
+        final var explicit = track("alpha", 2, 1, 1);
+        final var unset = explicit.deepCopy();
+        for (final String key : List.of("duration", "from", "to", "delay", "start_delay")) {
+            unset.add(key, com.google.gson.JsonNull.INSTANCE);
+            explicit.remove(key);
+        }
+        final var animations = new NativeUiAnimations();
+        final var nodes = new java.util.ArrayList<NativeUiScene.Node>();
+        for (final var track : List.of(explicit, unset)) {
+            final var properties = new JsonObject();
+            final var tracks = new JsonArray();
+            tracks.add(track);
+            AnimationPrograms.attach(properties, tracks, false);
+            nodes.add(new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE));
+        }
+        for (final long elapsed : new long[] {0, 1_000_000_000L, 3_000_000_000L})
+            assertEquals(animations.opacityAt(nodes.getFirst(), elapsed), animations.opacityAt(nodes.getLast(), elapsed));
+    }
+
+    @Test
+    void followsFadeHoldFadeOutUsingTheTitleClockAcrossSceneUpdates() {
+        final var properties = new JsonObject();
+        final var sequence = new JsonArray();
+        sequence.add(track("alpha", .5F, 0, .5F));
+        sequence.add(track("wait", 3.5F, 0, 0));
+        sequence.add(track("alpha", 1, .5F, 0));
+        AnimationPrograms.attach(properties, sequence, true);
+        final var original = new NativeUiScene.Node("", "image", properties, List.of(), Integer.MIN_VALUE);
+        final var replacement = new NativeUiScene.Node("", "image", properties.deepCopy(), List.of(), Integer.MIN_VALUE);
+        final var animations = new NativeUiAnimations();
+        final double[] seconds = {0, .25, .5, 2, 4, 4.5, 5, 6};
