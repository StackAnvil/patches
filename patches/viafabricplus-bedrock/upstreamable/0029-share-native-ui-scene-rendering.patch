+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiCursorPlacementTest {
+    @Test
+    void matchesOriginalLocalOffsetWritesForFittingCenteringAndDegenerateControls() throws Exception {
+        try (final var reader = new InputStreamReader(getClass().getResourceAsStream("/native-ui/cursor-placement-2225.json"), StandardCharsets.UTF_8)) {
+            final var fixture = JsonParser.parseReader(reader).getAsJsonObject();
+            for (final var value : fixture.getAsJsonArray("controls")) {
+                final JsonObject control = value.getAsJsonObject();
+                final String name = control.get("name").getAsString();
+                final int flags = control.get("flags").getAsInt();
+                final JsonObject properties = new JsonObject();
+                properties.addProperty("follows_cursor", (flags & 4) != 0);
+                properties.addProperty("follows_cursor_inside_parent", false);
+                final var node = new NativeUiScene.Node(name, "custom", properties, List.of(), Integer.MIN_VALUE);
+                final var placement = new NativeUiCursorPlacement(at(control, "anchor", 0), at(control, "anchor", 1), (flags & 8) != 0);
+                final var bounds = new NativeUiLayout.Rect(at(control, "origin", 0), at(control, "origin", 1), at(control, "size", 0), at(control, "size", 1));
+                final var parent = new NativeUiLayout.Rect(at(control, "parent", 0), at(control, "parent", 1), at(control, "parent", 2), at(control, "parent", 3));
+                final var offset = placement.offset(node, bounds, parent, at(control, "offset", 0), at(control, "offset", 1));
+                if (control.get("expected").isJsonNull()) assertNull(offset, name);
+                else {
+                    assertNotNull(offset, name);
+                    assertEquals(Float.floatToRawIntBits(at(control, "expected", 0)), Float.floatToRawIntBits(offset.width()), name + " x");
+                    assertEquals(Float.floatToRawIntBits(at(control, "expected", 1)), Float.floatToRawIntBits(offset.height()), name + " y");
+                }
+            }
+        }
+    }
+
+    @Test
+    void movesChildrenAndClippingWithTheResolvedAnchorWithoutChangingAuthoredOffsets() {
+        final JsonObject tooltip = control("tooltip", 40, 30);
+        tooltip.add("offset", pair(5, 7));
+        tooltip.addProperty("follows_cursor_inside_parent", true);
+        tooltip.addProperty("clips_children", true);
+        final JsonObject child = control("child", 80, 60);
+        children(tooltip, child);
+        final JsonObject parent = control("parent", 200, 120);
+        parent.add("offset", pair(20, 30));
+        children(parent, tooltip);
+        final JsonObject root = control("root", 320, 200);
+        children(root, parent);
+        final JsonObject document = new JsonObject();
+        document.addProperty("format", 1);
+        document.add("root", root);
+        final var scene = NativeUiScene.parse(document.toString(), Set.of()).root();
+        final var target = scene.children().getFirst().children().getFirst();
+        final var solver = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0));
+        final var placed = solver.layout(scene, 320, 200, Map.of(), node -> node == target ? new NativeUiCursorPlacement(190, 60, false) : null)
+            .children().getFirst().children().getFirst();
+        assertEquals(new NativeUiLayout.Rect(140, 70, 40, 30), placed.bounds());
+        assertEquals(new NativeUiLayout.Rect(140, 70, 40, 30), placed.children().getFirst().visibleBounds());
+        final var moved = solver.layout(scene, 320, 200, Map.of(), node -> node == target ? new NativeUiCursorPlacement(100, 110.25F, false) : null)
+            .children().getFirst().children().getFirst();
+        assertEquals(new NativeUiLayout.Rect(110, 70.25F, 40, 30), moved.bounds());
+        assertEquals(pair(5, 7), target.properties().get("offset"));
+        assertEquals(new NativeUiLayout.Rect(25, 37, 40, 30), solver.layout(scene, 320, 200, Map.of())
+            .children().getFirst().children().getFirst().bounds());
+    }
+
+    @Test
+    void fitsAgainstTheGridControlInsteadOfItsVirtualCell() {
+        final JsonObject grid = control("grid", 200, 100);
+        grid.addProperty("type", "grid");
+        grid.addProperty("grid_item_template", "shared.cell");
+        grid.add("grid_dimensions", pair(2, 2));
+        children(grid, control("tooltip", 40, 30));
+        final var scene = scene(grid);
+        final var target = scene.children().getFirst();
+        final var box = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0))
+            .layout(scene, 200, 100, Map.of(), node -> node == target ? new NativeUiCursorPlacement(70, 10, true) : null);
+        assertEquals(new NativeUiLayout.Rect(80, 20, 40, 30), box.children().getFirst().bounds());
+    }
+
+    @Test
+    void appliesPointerPlacementAfterScrollingAndKeepsTheViewportClip() {
+        final JsonObject scroll = control("scroll", 200, 100);
+        scroll.addProperty("type", "scroll_view");
+        scroll.addProperty("scroll_content", "content");
+        scroll.addProperty("scroll_view_port", "viewport");
+        final JsonObject viewport = control("viewport", 100, 80);
+        viewport.add("offset", pair(10, 10));
+        final JsonObject content = control("content", 100, 200);
+        children(content, control("tooltip", 40, 30));
+        children(viewport, content);
+        children(scroll, viewport);
+        final var scene = scene(scroll);
+        final var target = scene.children().getFirst().children().getFirst().children().getFirst();
+        final var box = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0))
+            .layout(scene, 200, 100, Map.of(scene, 30F), node -> node == target ? new NativeUiCursorPlacement(50, 50, true) : null);
+        final var tooltip = box.children().getFirst().children().getFirst().children().getFirst();
+        assertEquals(new NativeUiLayout.Rect(60, 60, 40, 30), tooltip.bounds());
+        assertEquals(new NativeUiLayout.Rect(10, 10, 100, 80), tooltip.clip());
+    }
+
+    private static NativeUiScene.Node scene(final JsonObject root) {
+        final JsonObject document = new JsonObject();
+        document.addProperty("format", 1);
+        document.add("root", root);
+        return NativeUiScene.parse(document.toString(), Set.of()).root();
+    }
+
+    private static float at(final JsonObject object, final String key, final int index) {
+        return object.getAsJsonArray(key).get(index).getAsFloat();
+    }
+
+    private static JsonArray pair(final int first, final int second) {
+        final JsonArray result = new JsonArray();
+        result.add(first);
+        result.add(second);
+        return result;
+    }
+
+    private static JsonObject control(final String name, final int width, final int height) {
+        final JsonObject result = new JsonObject();
+        result.addProperty("name", name);
+        result.addProperty("type", "panel");
+        result.addProperty("anchor_from", "top_left");
+        result.addProperty("anchor_to", "top_left");
+        result.add("size", pair(width, height));
+        return result;
+    }
+
+    private static void children(final JsonObject parent, final JsonObject child) {
+        final JsonArray controls = new JsonArray();
+        controls.add(child);
+        parent.add("children", controls);
+    }
+}
