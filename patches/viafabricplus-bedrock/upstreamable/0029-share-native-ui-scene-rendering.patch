+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.TreeSet;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiScissorTest {
+    @Test
+    void cullsSubpixelEmptyClipsAndClipsOutsideTheRenderWindow() {
+        final var empty = new NativeUiScissor(new NativeUiLayout.Rect(0.5F, 200.5F, 835, 0));
+        assertEquals(0, empty.guiBounds(2).height());
+        assertEquals(0, empty.windowPixels(854, 480).height());
+        final var offscreen = new NativeUiScissor(new NativeUiLayout.Rect(900, 10, 100, 30));
+        assertEquals(0, offscreen.windowPixels(854, 480).width());
+        final var partial = new NativeUiScissor(new NativeUiLayout.Rect(850, 470, 100, 30)).windowPixels(854, 480);
+        assertEquals(4, partial.width());
+        assertEquals(10, partial.height());
+    }
+
+    @Test
+    void retainsNativeGlyphMasksAcrossEveryClipEdgeAndNestedParents() throws Exception {
+        try (final var input = getClass().getResourceAsStream("/native-ui/scissor-2225.json")) {
+            assertNotNull(input);
+            final var fixture = JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var control : fixture.getAsJsonArray("controls")) {
+                final var sample = control.getAsJsonObject();
+                NativeUiScissor clip = NativeUiScissor.scaled(new NativeUiLayout.Rect(0, 0, 640, 360), 2);
+                for (final var rectangle : sample.getAsJsonArray("clips"))
+                    clip = clip.intersect(NativeUiScissor.scaled(rect(rectangle.getAsJsonArray()), 2));
+                final var origin = sample.getAsJsonArray("origin");
+                final var snapped = NativeUiFont.origin(origin.get(0).getAsFloat(), origin.get(1).getAsFloat(), 1, 2);
+                final var pixels = new TreeSet<Long>();
+                for (int index = 0; index < fixture.get("glyphCount").getAsInt(); index++) {
+                    for (int y = 0; y < fixture.getAsJsonArray("glyphRows").size(); y++) {
+                        final String row = fixture.getAsJsonArray("glyphRows").get(y).getAsString();
+                        for (int x = 0; x < row.length(); x++) {
+                            if (row.charAt(x) != '1') continue;
+                            for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
+                                final int px = (int) (snapped.x() * 2) + (index * fixture.get("glyphAdvance").getAsInt() + x) * 2 + dx;
+                                final int py = (int) (snapped.y() * 2) + y * 2 + dy;
+                                if (clip.pixels().containsPoint(px, py)) pixels.add((long) py << 32 | px & 0xFFFFFFFFL);
+                            }
+                        }
+                    }
+                }
+                final var mask = new StringBuilder();
+                for (final long pixel : pixels) mask.append((int) pixel).append(',').append(pixel >>> 32).append('\n');
+                assertEquals(sample.get("pixels").getAsInt(), pixels.size(), sample.get("name").getAsString());
+                assertEquals(sample.get("maskSha256").getAsString(), HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256")
+                    .digest(mask.toString().getBytes(StandardCharsets.UTF_8))), sample.get("name").getAsString());
+            }
+        }
+    }
+
+    @Test
+    void keepsDifferentPhysicalClipsOutOfTheSameBatchEvenWhenTheirGuiBoundsMatch() {
+        final var first = NativeUiScissor.scaled(new NativeUiLayout.Rect(340.5F, 50, 20, 10), 2);
+        final var second = NativeUiScissor.scaled(new NativeUiLayout.Rect(341, 50, 20, 10), 2);
+        assertEquals(first.guiBounds(3), second.guiBounds(3));
+        assertFalse(NativeUiScissor.samePixels(first, second));
+        assertFalse(NativeUiScissor.samePixels(first, null));
+        assertTrue(NativeUiScissor.samePixels(first, NativeUiScissor.scaled(new NativeUiLayout.Rect(340.5F, 50, 20, 10), 2)));
+        for (final int scale : new int[] {1, 2, 3, 4, 8}) {
+            final var coarse = first.guiBounds(scale);
+            assertTrue(coarse.left() * scale <= first.pixels().left());
+            assertTrue(coarse.right() * scale >= first.pixels().right());
+        }
+    }
+
+    private static NativeUiLayout.Rect rect(final JsonArray values) {
+        return new NativeUiLayout.Rect(values.get(0).getAsFloat(), values.get(1).getAsFloat(),
+            values.get(2).getAsFloat(), values.get(3).getAsFloat());
+    }
+}
