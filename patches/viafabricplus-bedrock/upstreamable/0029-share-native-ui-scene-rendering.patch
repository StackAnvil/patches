@@ -0,0 +1,94 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.math.BigInteger;
+
+/** Native toggle initialization and component events; the screen owns collection indices and radio traversal. */
+public record NativeUiToggle(boolean radio, boolean defaultChecked, boolean directional, boolean toggleOnHover,
+                             int group, int onButton, int offButton, int forcedIndex, int defaultSelected) {
+    public static NativeUiToggle parse(final JsonObject properties) {
+        return new NativeUiToggle(NativeUiScene.flag(properties, "radio_toggle_group", false),
+            NativeUiScene.flag(properties, "toggle_default_state", false),
+            NativeUiScene.flag(properties, "enable_directional_toggling", false),
+            NativeUiScene.flag(properties, "toggle_on_hover", false),
+            NativeUiInput.symbol(string(properties, "toggle_name")), NativeUiInput.symbol(string(properties, "toggle_on_button")),
+            NativeUiInput.symbol(string(properties, "toggle_off_button")), integer(properties, "toggle_group_forced_index", -1),
+            integer(properties, "toggle_group_default_selected", 0));
+    }
+
+    private static String string(final JsonObject properties, final String key) {
+        final var value = properties.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
+
+    private static int integer(final JsonObject properties, final String key, final int fallback) {
+        final var value = properties.get(key);
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) return fallback;
+        final String encoded = value.getAsString();
+        if (encoded.indexOf('.') >= 0 || encoded.indexOf('e') >= 0 || encoded.indexOf('E') >= 0) return fallback;
+        try {
+            final var integer = new BigInteger(encoded);
+            if (integer.bitLength() > 63) return fallback;
+            return integer.intValue();
+        } catch (final NumberFormatException invalid) {
+            return fallback;
+        }
+    }
+
+    public int index(final int collectionIndex) { return this.forcedIndex >= 0 ? this.forcedIndex : collectionIndex; }
+
+    public boolean initialChecked(final int collectionIndex) {
+        return this.radio ? this.index(collectionIndex) == this.defaultSelected : this.defaultChecked;
+    }
+
+    public static final class State {
+        private final NativeUiToggle definition;
+        private final int index;
+        private boolean checked;
+        private boolean hovered;
+
+        public State(final NativeUiToggle definition, final int collectionIndex) {
+            this.definition = definition;
+            this.index = definition.index(collectionIndex);
+            this.checked = definition.initialChecked(collectionIndex);
+        }
+
+        public boolean checked() { return this.checked; }
+        public void bindChecked(final boolean checked) { this.checked = checked; }
+
+        public Change button(final NativeUiInput.ButtonEvent event, final boolean enabled) {
+            if (!enabled || !event.transition()) return null;
+            if (event.target() == this.definition.onButton) {
+                if (!this.definition.directional || this.checked) return null;
+                this.checked = true;
+            } else if (event.target() == this.definition.offButton) {
+                if (!this.definition.directional || !this.checked) return null;
+                this.checked = this.definition.radio;
+            } else this.checked = this.definition.radio || !this.checked;
+            return this.change(true);
+        }
+
+        public Change hover(final boolean hovered) {
+            if (this.hovered == hovered) return null;
+            this.hovered = hovered;
+            if (!hovered || !this.definition.toggleOnHover) return null;
+            this.checked = this.definition.radio || !this.checked;
+            return this.change(false);
+        }
+
+        private Change change(final boolean notify) {
+            return new Change(this.definition.group, this.index, this.checked, notify, this.definition.radio);
+        }
+
+        public void sibling(final Change change) {
+            if (change.radio && change.group == this.definition.group && change.index != this.index) this.checked = false;
+        }
+    }
+
+    public record Change(int group, int index, boolean checked, boolean notifyController, boolean radio) {}
+}
