+        final var pose = new Matrix4f().translate(20, 30, 0).scale(2);
+        final var client = mock(Minecraft.class);
+        final var window = mock(Window.class);
+        when(client.getWindow()).thenReturn(window);
+        when(window.getGuiScale()).thenReturn(2);
+        try (final var minecraft = mockStatic(Minecraft.class)) {
+            minecraft.when(Minecraft::getInstance).thenReturn(client);
+            glyph.render(pose, vertices, 0x00A00050, true);
+        }
+        verify(vertices).addVertex(238F, 30F - 1F / 512, 0F);
+        verify(vertices).addVertex(238F, 46F - 1F / 512, 0F);
+        verify(vertices, times(2)).addVertex(eq(254F), anyFloat(), eq(0F));
+        verify(vertices, times(4)).setUv1(16, 64);
+        verify(vertices, times(4)).setUv3(16, 16);
+        verify(vertices).setUv(cell.u0(), cell.v0());
+        verify(vertices).setUv(cell.u1(), cell.v1());
+        verify(vertices, times(4)).setUv2(80, 160);
+        assertEquals(109.01F, glyph.activeLeft());
+        assertEquals(113.01F, glyph.activeRight());
+        assertTrue(BedrockBitmapPipeline.isSmoothed(glyph.guiPipeline()));
+
+        final var world = mock(VertexConsumer.class, RETURNS_SELF);
+        glyph.render(pose, world, 0x00A00050, false);
+        verify(world, times(2)).addVertex(same(pose), eq(109.01F), anyFloat(), anyFloat());
+        verify(world, never()).setUv1(anyInt(), anyInt());
+        verify(world).setUv(cell.u0(), cell.v0());
+        verify(world, times(4)).setLight(0x00A00050);
+    }
+    @Test
+    void usesFixedItalicEdgesForTallBitmapCellsAndPreservesWorldVertices() {
+        final var cell = BedrockBitmapFont.Cell.bitmap(1, 4, 8, 12, 128, 128, -3);
+        final var sheet = new BakedSheetGlyph(GlyphInfo.simple(4), mock(GlyphRenderTypes.class), mock(GpuTextureView.class),
+                cell.u0(), cell.u1(), cell.v0(), cell.v1(), cell.left(), cell.right(), cell.top(), cell.bottom());
+        final var style = Style.EMPTY.withItalic(true);
+        final var glyph = new BedrockBitmapGlyph(sheet, cell, false).createGlyph(0, 0, -1, 0, style, 0, 0);
+        final var pose = new Matrix4f();
+        final var client = mock(Minecraft.class);
+        final var window = mock(Window.class);
+        when(client.getWindow()).thenReturn(window);
+        when(window.getGuiScale()).thenReturn(1);
+        final var gui = mock(VertexConsumer.class, RETURNS_SELF);
+        try (final var minecraft = mockStatic(Minecraft.class)) {
+            minecraft.when(Minecraft::getInstance).thenReturn(client);
+            glyph.render(pose, gui, 0, true);
+        }
+        final var guiX = ArgumentCaptor.forClass(Float.class);
+        verify(gui, times(4)).addVertex(guiX.capture(), anyFloat(), anyFloat());
+        // Original 1.26.60.5 bitmap writer and quad expansion for height 12 and offset -3.
+        assertEquals(List.of(1F, -1F, 7F, 9F), guiX.getAllValues());
+        assertTrue(glyph.left() <= -1);
+        assertTrue(glyph.right() >= 9);
+        assertTrue(glyph.activeLeft() <= -1);
+        assertTrue(glyph.activeRight() >= 5);
+
+        final var world = mock(VertexConsumer.class, RETURNS_SELF);
+        glyph.render(pose, world, 0, false);
+        final var worldX = ArgumentCaptor.forClass(Float.class);
+        verify(world, times(4)).addVertex(same(pose), worldX.capture(), anyFloat(), anyFloat());
+        assertEquals(List.of(1.75F, -1.25F, 6.75F, 9.75F), worldX.getAllValues());
+        assertNotEquals(guiX.getAllValues(), worldX.getAllValues());
+    }
+
+}
