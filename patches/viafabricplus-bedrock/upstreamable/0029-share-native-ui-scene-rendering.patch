+package com.viaversion.viafabricplus.bedrock.render.font;
+
+import com.mojang.blaze3d.font.GlyphInfo;
+import com.mojang.blaze3d.font.GlyphProvider;
+import com.mojang.blaze3d.font.UnbakedGlyph;
+import com.mojang.blaze3d.platform.NativeImage;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.serialization.Codec;
+import com.mojang.serialization.codecs.RecordCodecBuilder;
+import it.unimi.dsi.fastutil.ints.Int2ObjectMap;
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.ints.IntSet;
+import it.unimi.dsi.fastutil.ints.IntSets;
+import java.io.IOException;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.IntBinaryOperator;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.font.GlyphRenderTypes;
+import net.minecraft.client.gui.font.glyphs.BakedGlyph;
+import net.minecraft.client.gui.font.glyphs.BakedSheetGlyph;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.client.renderer.texture.TextureManager;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackType;
+import net.minecraft.server.packs.metadata.MetadataSectionType;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.minecraft.server.packs.resources.ResourceMetadata;
+
+/** Retains native bitmap metrics and sampling on a provider-owned atlas. */
+public final class BedrockBitmapFont implements GlyphProvider {
+    private static final AtomicLong NEXT_TEXTURE = new AtomicLong();
+    private final NativeImage image;
+    private final boolean smooth;
+    private final Identifier textureId;
+    private final Int2ObjectMap<UnbakedGlyph> glyphs = new Int2ObjectOpenHashMap<>();
+    private final IntSet supportedGlyphs = IntSets.unmodifiable(this.glyphs.keySet());
+    private DynamicTexture texture;
+    private TextureManager textureManager;
+    private GlyphRenderTypes renderTypes;
+    private boolean closed;
+
+    private BedrockBitmapFont(final NativeImage image, final boolean smooth) {
+        this.smooth = smooth;
+        this.image = image;
+        this.textureId = Identifier.fromNamespaceAndPath("viabedrock", "font/native_bitmap/" + NEXT_TEXTURE.getAndIncrement());
+    }
+
+    public static boolean ownsUnicode(final Identifier file) {
+        return file.getNamespace().equals("viabedrock") && file.getPath().matches("font/glyph_[0-9a-f]{2}\\.png");
+    }
+
+    public static GlyphProvider loadUnicode(final ResourceManager resources, final Identifier file, final int[][] grid,
+                                     final int height, final int ascent) throws IOException {
+        final NativeImage image;
+        try (var input = resources.open(file.withPrefix("textures/"))) {
+            image = NativeImage.read(input);
+        }
+        try {
+            if (grid.length == 0 || grid[0].length == 0 || image.getWidth() % grid[0].length != 0
+                    || image.getHeight() % grid.length != 0) throw new IOException("Invalid native Unicode atlas grid");
+            final int cellWidth = image.getWidth() / grid[0].length;
+            final int cellHeight = image.getHeight() / grid.length;
+            if (cellWidth == 0 || cellHeight == 0) throw new IOException("Empty native Unicode atlas cells");
+            final BedrockBitmapFont font = new BedrockBitmapFont(image, true);
+            for (int row = 0; row < grid.length; row++) {
+                if (grid[row].length != grid[0].length) throw new IOException("Unequal native Unicode atlas rows");
+                for (int column = 0; column < grid[row].length; column++) {
+                    final int codepoint = grid[row][column];
+                    if (codepoint == 0) continue;
+                    final int x = column * cellWidth;
+                    final int y = row * cellHeight;
+                    final Metrics metrics = measure(codepoint, cellWidth, cellHeight, height,
+                            (px, py) -> image.getLuminanceOrAlpha(x + px, y + py) & 255);
+                    final Cell cell = new Cell(x, y, cellWidth, cellHeight, image.getWidth(), image.getHeight(),
+                            (float) height / cellHeight, metrics.bearing(), 7 - ascent, .01F);
+                    font.glyphs.put(codepoint, new Glyph(GlyphInfo.simple(metrics.advance()), cell, font));
+                }
+            }
+            return font;
+        } catch (final IOException | RuntimeException error) {
+            image.close();
+            throw error;
+        }
+    }
+
+    public static boolean ownsBitmap(final Identifier file) {
+        return file.getNamespace().equals("viabedrock")
+                && file.getPath().matches("font/bedrock_bitmap/(default8|ascii_sga)_[0-9]+\\.png");
+    }
+
+    /** Resolve the descriptor and retained page from the converted texture's own pack. */
+    public static GlyphProvider loadBitmap(final GlyphProvider source, final ResourceManager resources,
+                                           final Identifier file, final int[][] grid) throws IOException {
+        NativeImage image = null;
+        try {
+            final var resource = resources.getResourceOrThrow(file.withPrefix("textures/"));
+            final var pack = resource.source();
+            final var metadata = pack.getResource(PackType.CLIENT_RESOURCES, file.withPrefix("textures/").withSuffix(".mcmeta"));
+            if (metadata == null) return source;
+            final NativeLayout layout;
+            try (var input = metadata.get()) {
+                final var section = ResourceMetadata.fromJsonStream(input).getSection(NativeLayout.TYPE);
+                if (section.isEmpty()) return source;
+                layout = section.get();
+            }
+            final var pixels = pack.getResource(PackType.CLIENT_RESOURCES, layout.texture().withPrefix("textures/"));
+            if (pixels == null) throw new IOException("Native font atlas is absent from its descriptor's pack");
+            try (var input = pixels.get()) {
+                image = NativeImage.read(input);
+            }
+            if (image.getWidth() < 128 || image.getWidth() > 4096 || image.getWidth() % 128 != 0
+                    || image.getHeight() > 4096 || grid.length == 0) throw new IOException("Invalid native bitmap atlas");
+            final int cellWidth = image.getWidth() / 16;
+            final int cellHeight = layout.height() * (image.getWidth() / 128);
+            if ((long) cellHeight * grid.length > image.getHeight()) throw new IOException("Native bitmap cells exceed their atlas");
+            final BedrockBitmapFont font = new BedrockBitmapFont(image, false);
+            for (int row = 0; row < grid.length; row++) {
+                if (grid[row].length != 16) throw new IOException("Invalid native bitmap atlas row");
+                for (int column = 0; column < 16; column++) {
+                    final int codepoint = grid[row][column];
+                    if (codepoint == 0) continue;
+                    final UnbakedGlyph original = source.getGlyph(codepoint);
+                    if (original == null) continue;
+                    final Cell cell = Cell.bitmap(column, row, cellWidth, cellHeight,
+                            image.getWidth(), image.getHeight(), layout.yOffset());
+                    font.glyphs.put(codepoint, new Glyph(original.info(), cell, font));
+                }
+            }
+            source.close();
+            return font;
+        } catch (final IOException | RuntimeException error) {
+            if (image != null) image.close();
+            source.close();
+            throw error;
+        }
+    }
+
+    static Metrics measure(final int codepoint, final int width, final int height, final int renderHeight,
+                           final IntBinaryOperator alpha) {
+        int left = width;
+        int right = 0;
+        for (int x = 0; x < width; x++) {
+            for (int y = 0; y < height; y++) {
+                if (alpha.applyAsInt(x, y) != 0) {
+                    left = Math.min(left, x);
+                    right = x + 1;
+                    break;
+                }
+            }
+        }
+        if (left == width && codepoint != 0x3000) return new Metrics(4, 0);
+        if (codepoint >= 0xAC00 && codepoint < 0xD7B0) return new Metrics(8, 0);
+        if (fullWidth(codepoint)) return new Metrics(9, 0);
+        final float scale = (float) renderHeight / height;
+        return new Metrics((right - left) * scale + 1, (1 - left) * scale);
+    }
+
+    private static boolean fullWidth(final int codepoint) {
+        return codepoint >= 0x1100 && codepoint <= 0x11FF
+                || codepoint >= 0x3000 && codepoint <= 0x30FF
+                || codepoint >= 0x3130 && codepoint <= 0x318F
+                || codepoint >= 0x3200 && codepoint <= 0x9FFF
+                || codepoint >= 0xA960 && codepoint <= 0xA97F
+                || codepoint >= 0xD7B0 && codepoint <= 0xD7FF
+                || codepoint >= 0xF900 && codepoint <= 0xFAFF
+                || codepoint >= 0xFF01 && codepoint <= 0xFF5E;
+    }
+
+    @Override
+    public UnbakedGlyph getGlyph(final int codepoint) { return this.glyphs.get(codepoint); }
+
+    @Override
+    public IntSet getSupportedGlyphs() { return this.supportedGlyphs; }
+
+    private synchronized BakedGlyph bake(final GlyphInfo info, final Cell cell) {
+        if (this.closed) throw new IllegalStateException("Native bitmap font is closed");
+        RenderSystem.assertOnRenderThread();
+        if (this.texture == null) {
+            final TextureManager manager = Minecraft.getInstance().getTextureManager();
+            final DynamicTexture texture = new DynamicTexture(this.textureId::toString, this.image);
+            boolean registered = false;
+            try {
+                manager.register(this.textureId, texture);
+                registered = true;
+                this.renderTypes = GlyphRenderTypes.createForColorTexture(this.textureId);
+            } catch (final RuntimeException error) {
+                if (registered) manager.release(this.textureId);
+                else texture.close();
+                this.closed = true;
+                throw error;
+            }
+            this.textureManager = manager;
+            this.texture = texture;
+        }
+        return new BedrockBitmapGlyph(new BakedSheetGlyph(info, this.renderTypes, this.texture.getTextureView(),
+                cell.u0(), cell.u1(), cell.v0(), cell.v1(), cell.left(), cell.right(), cell.top(), cell.bottom()), cell, this.smooth);
+    }
+
+    @Override
+    public synchronized void close() {
+        if (this.closed) return;
+        this.closed = true;
+        if (this.texture == null) {
+            this.image.close();
+        } else if (RenderSystem.isOnRenderThread()) {
+            this.textureManager.release(this.textureId);
+        } else {
+            Minecraft.getInstance().execute(() -> this.textureManager.release(this.textureId));
+        }
+    }
+
+    record Metrics(float advance, float bearing) { }
+
+    /** Source coordinates stay in their original page, including empty space around the glyph. */
+    record Cell(int x, int y, int width, int height, int atlasWidth, int atlasHeight,
+                float scale, float left, float top, float inset) {
+        static Cell bitmap(final int column, final int row, final int width, final int height,
+                           final int atlasWidth, final int atlasHeight, final float top) {
+            // The native glyph writer expresses its edge inset on the 128-unit bitmap atlas.
+            return new Cell(column * width, row * height, width, height, atlasWidth, atlasHeight,
+                    8F / width, 0, top, .001F * width / 8);
+        }
+
+        // Native normalizes each extent before adding it to the origin. Preserve that float rounding.
+        float u0() { return (float) this.x / this.atlasWidth; }
+        float u1() { return u0() + (this.width - this.inset) / this.atlasWidth; }
+        float v0() { return (float) this.y / this.atlasHeight; }
+        float v1() { return v0() + (this.height - this.inset) / this.atlasHeight; }
+        float right() { return this.left + this.width * this.scale; }
+        float bottom() { return this.top + this.height * this.scale; }
+    }
+
+    private record NativeLayout(Identifier texture, int height, int yOffset) {
+        private static final Codec<NativeLayout> CODEC = RecordCodecBuilder.create(instance -> instance.group(
+                Identifier.CODEC.fieldOf("texture").forGetter(NativeLayout::texture),
+                Codec.intRange(1, 128).fieldOf("height").forGetter(NativeLayout::height),
+                Codec.intRange(-128, 128).fieldOf("y_offset").forGetter(NativeLayout::yOffset)
+        ).apply(instance, NativeLayout::new));
+        private static final MetadataSectionType<NativeLayout> TYPE = new MetadataSectionType<>("viabedrock:font_atlas", CODEC);
+    }
+
+    private record Glyph(GlyphInfo info, Cell cell, BedrockBitmapFont font) implements UnbakedGlyph {
+        @Override
+        public BakedGlyph bake(final Stitcher stitcher) { return this.font.bake(this.info, this.cell); }
+    }
+}
