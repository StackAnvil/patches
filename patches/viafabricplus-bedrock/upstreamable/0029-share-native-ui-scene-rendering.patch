+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiButtonTest {
+    @Test
+    void deferredReferencesUseThePressStateAfterEarlierVisibilityCallbacks() {
+        final var root = button(true);
+        final var changed = new java.util.ArrayList<NativeUiScene.Node>();
+        final var state = new NativeUiButton.State(NativeUiButton.parse(root.properties()), (node, visible) -> {
+            node.properties().addProperty("visible", visible);
+            changed.add(node);
+        });
+        state.button(event(1, true), true, false);
+        assertTrue(state.pressed());
+        state.visibility(false, true, false);
+        assertFalse(state.pressed());
+        assertTrue(changed.isEmpty());
+        state.attach(root, true, false);
+        assertEquals(List.of(root.children().get(3), root.children().get(2), root.children().get(1)), changed);
+        assertTrue(root.children().getFirst().flag("visible", false));
+        assertFalse(root.children().get(2).flag("visible", true));
+    }
+
+    @Test
+    void suppressedTransitionsRetainTheirVisualStateAcrossMatchingSceneCopies() {
+        final var root = button(true);
+        final var state = new NativeUiButton.State(NativeUiButton.parse(root.properties()), root, true, false);
+        state.button(event(1, false), true, false);
+        assertTrue(state.pressed());
+        assertTrue(root.children().getFirst().flag("visible", false));
+        final var replacement = button(true);
+        state.attach(replacement, true, false);
+        assertTrue(replacement.children().getFirst().flag("visible", false));
+        assertFalse(replacement.children().get(2).flag("visible", true));
+        state.general(17, true, false);
+        assertTrue(replacement.children().get(2).flag("visible", false));
+        state.button(event(2, true), true, false);
+        assertTrue(state.pressed());
+        state.hover(false, true);
+        assertFalse(state.pressed());
+        assertTrue(replacement.children().getFirst().flag("visible", false));
+    }
+
+    @Test
+    void ancestorDisablePreservesThePressButTheOwnEnabledCallbackClearsIt() {
+        final var root = button(true);
+        final var state = new NativeUiButton.State(NativeUiButton.parse(root.properties()), root, true, false);
+        state.button(event(1, true), true, false);
+        state.general(17, false, false);
+        assertTrue(state.pressed());
+        assertTrue(root.children().getLast().flag("visible", false));
+        state.general(17, true, false);
+        assertTrue(root.children().get(2).flag("visible", false));
+        state.enabled(false);
+        assertFalse(state.pressed());
+        assertTrue(root.children().get(2).flag("visible", false));
+        state.general(17, false, false);
+        assertTrue(root.children().getLast().flag("visible", false));
+    }
+
+    @Test
+    void onlyTheMissingLockedStateUsesTheDefaultFallback() {
+        final var child = node("default", List.of());
+        final var properties = new JsonObject();
+        properties.addProperty("default_control", child.name());
+        final var root = new NativeUiScene.Node("owner", "button", properties, List.of(child), Integer.MIN_VALUE);
+        final var state = new NativeUiButton.State(NativeUiButton.parse(properties), root, true, false);
+        state.button(event(1, true), true, false);
+        assertFalse(child.flag("visible", true));
+        state.general(17, false, false);
+        assertTrue(child.flag("visible", false));
+        state.enabled(false);
+        state.hover(true, true);
+        assertFalse(child.flag("visible", true));
+    }
+
+    @Test
+    void namedSettersUseBreadthFirstOwnershipAndPreserveAliasOrder() {
+        final var deep = node("shared", List.of());
+        final var shallow = node("shared", List.of());
+        deep.properties().addProperty("visible", false);
+        shallow.properties().addProperty("visible", false);
+        final var properties = new JsonObject();
+        properties.addProperty("default_control", shallow.name());
+        properties.addProperty("pressed_control", shallow.name());
+        final var root = new NativeUiScene.Node("owner", "button", properties,
+            List.of(node("branch", List.of(deep)), shallow), Integer.MIN_VALUE);
+        final var state = new NativeUiButton.State(NativeUiButton.parse(properties), root, true, false);
+        assertFalse(deep.flag("visible", true));
+        assertTrue(shallow.flag("visible", false));
+        state.button(event(1, true), true, false);
+        assertFalse(shallow.flag("visible", true));
+        assertFalse(deep.flag("visible", true));
+        final long revision = state.revision();
+        state.attach(root, true, false);
+        assertEquals(revision, state.revision());
+    }
+
+    private static NativeUiScene.Node button(final boolean consume) {
+        final var properties = new JsonObject();
+        properties.addProperty("consume_event", consume);
+        final List<NativeUiScene.Node> children = List.of("default", "hover", "pressed", "locked").stream()
+            .map(name -> node(name, List.of())).toList();
+        for (final var child : children) properties.addProperty(child.name() + "_control", child.name());
+        return new NativeUiScene.Node("owner", "button", properties, children, Integer.MIN_VALUE);
+    }
+
+    private static NativeUiScene.Node node(final String name, final List<NativeUiScene.Node> children) {
+        final var properties = new JsonObject();
+        properties.addProperty("visible", true);
+        return new NativeUiScene.Node(name, "panel", properties, children, Integer.MIN_VALUE);
+    }
+
+    private static NativeUiInput.ButtonEvent event(final int phase, final boolean update) {
+        return new NativeUiInput.ButtonEvent(0, 0, 0, phase, false, 1, NativeUiInput.Scope.DEFAULT, update, update);
+    }
+}
