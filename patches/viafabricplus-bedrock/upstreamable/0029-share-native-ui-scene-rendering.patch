@@ -0,0 +1,64 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonParser;
+import com.mojang.serialization.JsonOps;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.MutableComponent;
+import net.minecraft.network.chat.Style;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.network.chat.ComponentSerialization;
+import net.raphimc.viabedrock.api.util.TextUtil;
+
+public final class NativeUiText {
+    private NativeUiText() {}
+
+    public static List<FormattedCharSequence> tooltipLines(final Font font, final Component text, final int width) {
+        final List<FormattedCharSequence> result = new ArrayList<>();
+        for (final var paragraph : paragraphs(text)) {
+            final var wrapped = font.split(paragraph, width);
+            if (wrapped.isEmpty()) result.add(FormattedCharSequence.EMPTY);
+            else result.addAll(wrapped);
+        }
+        return List.copyOf(result);
+    }
+
+    static List<Component> paragraphs(final Component text) {
+        final List<Component> lines = new ArrayList<>();
+        final MutableComponent[] current = {Component.empty()};
+        final boolean[] carriageReturn = {false};
+        text.visit((style, value) -> {
+            final StringBuilder run = new StringBuilder();
+            for (int i = 0; i < value.length(); i++) {
+                final char character = value.charAt(i);
+                if (carriageReturn[0] && character == '\n') {
+                    carriageReturn[0] = false;
+                    continue;
+                }
+                carriageReturn[0] = character == '\r';
+                if (character == '\n' || character == '\r') {
+                    current[0].append(Component.literal(run.toString()).withStyle(style));
+                    run.setLength(0);
+                    lines.add(current[0]);
+                    current[0] = Component.empty();
+                } else run.append(character);
+            }
+            current[0].append(Component.literal(run.toString()).withStyle(style));
+            return Optional.empty();
+        }, Style.EMPTY);
+        lines.add(current[0]);
+        return List.copyOf(lines);
+    }
+
+    public static Component component(final String text) {
+        return ComponentSerialization.CODEC.parse(JsonOps.INSTANCE, JsonParser.parseString(TextUtil.stringToJson(text))).getOrThrow();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiViewport.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiViewport.java
