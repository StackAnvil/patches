+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiLinesTest {
+    @Test
+    void preservesNativeRangesWidthsAndAlignmentAcrossLineBoundaries() throws Exception {
+        try (var stream = OreUiLinesTest.class.getResourceAsStream("/oreui/native-lines-2225.json")) {
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var sample = entry.getAsJsonObject();
+                final var source = sample.getAsJsonArray("advances");
+                final float[] advances = new float[source.size()];
+                for (int index = 0; index < advances.length; index++) advances[index] = source.get(index).getAsFloat();
+                final var result = OreUiLines.layout(sample.get("text").getAsString().codePoints().toArray(), advances,
+                        new OreUiFont.LineMetrics(20F, 24F), sample.get("width").getAsFloat(), sample.get("indent").getAsFloat(),
+                        sample.get("letterSpacing").getAsFloat(), OreUiLines.WhiteSpace.values()[sample.get("whitespace").getAsInt()],
+                        OreUiLines.OverflowWrap.values()[sample.get("wordbreak").getAsInt()],
+                        OreUiLines.Alignment.values()[sample.get("alignment").getAsInt()], sample.get("fill").getAsBoolean());
+                final var lines = sample.getAsJsonArray("lines");
+                assertEquals(lines.size(), result.lines().size(), sample.toString());
+                for (int index = 0; index < lines.size(); index++) {
+                    final var line = lines.get(index).getAsJsonObject();
+                    assertEquals(new OreUiLines.Line(line.get("start").getAsInt(), line.get("end").getAsInt(),
+                            line.get("x").getAsFloat(), line.get("baseline").getAsFloat(), line.get("width").getAsFloat(),
+                            line.get("height").getAsFloat(), line.get("hardBreak").getAsBoolean()), result.lines().get(index), sample.toString());
+                }
+                assertEquals(sample.getAsJsonArray("extent").get(0).getAsFloat(), result.width(), sample.toString());
+                assertEquals(sample.getAsJsonArray("extent").get(1).getAsFloat(), result.height(), sample.toString());
+            }
+        }
+    }
+}
