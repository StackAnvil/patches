+
+final class NativeUiRendererTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void measuresStyledParagraphsAndEmptyLinesInsteadOfLiteralEscapeSequences() {
+        final var font = mock(Font.class);
+        when(font.width(any(FormattedText.class))).thenAnswer(call -> (int) Math.ceil(((FormattedText) call.getArgument(0)).getString().length() * 6.5F));
+        final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+        final String first = UUID.randomUUID().toString().substring(0, 35), second = UUID.randomUUID().toString().substring(0, 10);
+        final var node = label(first + "\n\n" + second);
+        final var size = renderer.intrinsic(node);
+        assertEquals(Math.ceil(first.length() * 6.5F), size.width());
+        assertEquals(30, size.height());
+        final var escaped = label(first + "\\n" + second);
+        assertEquals(Math.ceil((first.length() + second.length() + 2) * 6.5F), renderer.intrinsic(escaped).width());
+        assertEquals(10, renderer.intrinsic(escaped).height());
+        final var terminated = label("WW" + (char) 0 + "WWW\nWWW");
+        assertEquals(13, renderer.intrinsic(terminated).width());
+        assertEquals(10, renderer.intrinsic(terminated).height());
+    }
+
+    @Test
+    void retainsWrappingForLiveScenesAndReleasesRetiredNodes() {
+        final var font = mock(Font.class);
+        when(font.split(any(FormattedText.class), anyInt())).thenReturn(List.of(FormattedCharSequence.EMPTY));
+        final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+        final var root = label(UUID.randomUUID().toString());
+        final var title = label(UUID.randomUUID().toString());
+        renderer.constrained(root, 100);
+        renderer.constrained(title, 100);
+        renderer.retain(List.of(root));
+        renderer.constrained(root, 100);
+        verify(font, times(2)).split(any(FormattedText.class), eq(100));
+        renderer.constrained(title, 100);
+        verify(font, times(3)).split(any(FormattedText.class), eq(100));
+        renderer.constrained(root, 50);
+        verify(font).split(any(FormattedText.class), eq(50));
+        renderer.reset();
+        renderer.constrained(root, 50);
+        verify(font, times(2)).split(any(FormattedText.class), eq(50));
+    }
+
+    @Test
+    void truncatesNativeTextChannelsAndClampsOpacityAtSubmission() {
+        final var node = label("A");
+        node.properties().add("color", JsonParser.parseString("[0.3,0.5,0.75]"));
+        // Bedrock 1.26.60.5 cached-glyph writes truncate each scaled RGBA channel.
+        assertEquals(0x7F4C7FBF, NativeUiRenderer.color(node, .5F));
+        node.properties().add("color", JsonParser.parseString("[0.25]"));
+        assertEquals(0xFF3FFFFF, NativeUiRenderer.color(node, 1));
+        node.properties().add("color", JsonParser.parseString("[-0.01,1.01,0.1]"));
+        assertEquals(0xFF00FF19, NativeUiRenderer.color(node, 1.2F));
+        assertEquals(0x0000FF19, NativeUiRenderer.color(node, -.1F));
+    }
+
+    @Test
+    void submitsOnlyTheNativeAdmittedLinesAtAdjacentFloatBoundaries() {
+        // Native 1.26.60.5 bitmap and MinecraftTen captures, including scaled second and third rows.
+        final float[][] samples = {
+            {10, .5F, 4, 1}, {10, 1, 8, 1}, {10, 1.5F, 12, 1},
+            {10, 1, 18, 2}, {10, 1, 28, 3},
+            {11.8125F, .5F, 5, 1}, {11.8125F, .5F, 11, 2}, {11.8125F, .5F, 17, 3},
+            {11.8125F, 1, 10, 1}, {11.8125F, 1, 22, 2}, {11.8125F, 1, 34, 3},
+            {11.8125F, 1.5F, 15, 1}, {11.8125F, 1.5F, 33, 2}, {11.8125F, 1.5F, 51, 3}
+        };
+        try (final var viewport = mockStatic(NativeUiViewport.class)) {
+            viewport.when(NativeUiViewport::current).thenReturn(new NativeUiViewport(640, 360, 2, 2));
+            for (final var sample : samples) {
+                final var node = label("WWW\nWWW\nWWW");
+                node.properties().addProperty("font_line_height", sample[0]);
+                node.properties().addProperty("font_scale_factor", sample[1]);
+                final var font = drawingFont();
+                final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+                final var submitted = new ArrayList<String>();
+                final var graphics = graphics(font, submitted, new ArrayList<>());
+                renderer.label(graphics, box(node, Math.nextDown(sample[2])), 1);
+                assertEquals((int) sample[3] - 1, submitted.size(), "preceding float: " + sample[2]);
+                submitted.clear();
+                renderer.label(graphics, box(node, sample[2]), 1);
+                assertEquals((int) sample[3], submitted.size(), "exact boundary: " + sample[2]);
+                if (sample[3] < 3) assertTrue(submitted.getLast().endsWith("..."));
+                else assertEquals(List.of("WWW", "WWW", "WWW"), submitted);
+                // Height admission does not reduce the complete wrapped measurement or rebuild it on resize.
+                assertEquals(3 * sample[0] * sample[1], renderer.constrained(node, 70).height());
+                verify(font, times(3)).split(any(FormattedText.class), anyInt());
+            }
+        }
+    }
+
+    @Test
+    void keepsFractionalGlyphSpacingWhenAdmissionUsesRoundedRows() {
+        try (final var viewport = mockStatic(NativeUiViewport.class)) {
+            viewport.when(NativeUiViewport::current).thenReturn(new NativeUiViewport(640, 360, 2, 2));
+            final var node = label("WWW\nWWW\nWWW");
+            node.properties().addProperty("font_line_height", 11.8125F);
+            final var font = drawingFont();
+            final var positions = new ArrayList<Float>();
+            new NativeUiRenderer(font, mock(NativeUiImages.class)).label(
+                graphics(font, new ArrayList<>(), positions), box(node, 34), 1);
+            assertEquals(List.of(1F, 12.5F, 24.5F), positions);
+        }
+    }
+
+    @Test
+    void submitsSelectedTrueTypeLabelsOnTheirDisplayGrid() {
+        try (final var viewport = mockStatic(NativeUiViewport.class)) {
+            viewport.when(NativeUiViewport::current).thenReturn(new NativeUiViewport(640, 360, 2, 2));
+            final var font = drawingFont();
+            final var renderer = new NativeUiRenderer(font, mock(NativeUiImages.class));
+            final var origins = new ArrayList<NativeUiFont.Origin>();
+            final var graphics = mock(GuiGraphicsExtractor.class);
+            final var pose = new Matrix3x2fStack(16);
+            when(graphics.pose()).thenReturn(pose);
+            doAnswer(call -> {
+                origins.add(new NativeUiFont.Origin(pose.m20(), pose.m21()));
+                return null;
+            }).when(graphics).text(eq(font), any(FormattedCharSequence.class), eq(0), eq(0), anyInt(), eq(false));
+            for (final float[] sample : new float[][] {{10, 300}, {90, 300}, {170, 300}, {-10, -3}, {-.125F, -.125F}}) {
+                final var node = label("W");
+                node.properties().addProperty("font_origin_scale", 1.5F);
+                final var bounds = new NativeUiLayout.Rect(sample[0], sample[1], 70, 28);
+                final var box = new NativeUiLayout.Box(node, bounds, new NativeUiLayout.Rect(0, 0, 640, 360),
+                        new NativeUiLayout.Size(70, 28), bounds, 0, List.of());
+                renderer.label(graphics, box, 1);
+            }
+            assertEquals(List.of(new NativeUiFont.Origin(9.75F, 300.75F), new NativeUiFont.Origin(90, 300.75F),
+                    new NativeUiFont.Origin(169.5F, 300.75F), new NativeUiFont.Origin(-9.75F, -1.5F),
+                    new NativeUiFont.Origin(0, .75F)), origins);
+        }
+    }
+
+    private static NativeUiLayout.Box box(final NativeUiScene.Node node, final float height) {
+        final var bounds = new NativeUiLayout.Rect(0, 0, 70, height);
+        return new NativeUiLayout.Box(node, bounds, new NativeUiLayout.Rect(0, 0, 640, 360),
+            new NativeUiLayout.Size(70, 30), bounds, 0, List.of());
+    }
+
+    private static Font drawingFont() {
+        final var font = mock(Font.class);
+        final var splitter = new StringSplitter((codePoint, style) -> codePoint == '.' ? 2 : 6);
+        when(font.getSplitter()).thenReturn(splitter);
+        when(font.width(any(FormattedCharSequence.class))).thenAnswer(call -> (int) Math.ceil(splitter.stringWidth((FormattedCharSequence) call.getArgument(0))));
+        when(font.split(any(FormattedText.class), anyInt())).thenAnswer(call -> splitter
+            .splitLines((FormattedText) call.getArgument(0), (int) call.getArgument(1), Style.EMPTY).stream()
+            .map(Language.getInstance()::getVisualOrder).toList());
+        return font;
+    }
+
+    private static GuiGraphicsExtractor graphics(final Font font, final List<String> text, final List<Float> positions) {
+        final var graphics = mock(GuiGraphicsExtractor.class);
+        final var pose = new Matrix3x2fStack(16);
+        when(graphics.pose()).thenReturn(pose);
+        doAnswer(call -> {
+            final StringBuilder value = new StringBuilder();
+            ((FormattedCharSequence) call.getArgument(1)).accept((index, style, codePoint) -> { value.appendCodePoint(codePoint); return true; });
+            text.add(value.toString());
+            positions.add(pose.m21());
+            return null;
+        }).when(graphics).text(eq(font), any(FormattedCharSequence.class), eq(0), eq(0), anyInt(), eq(false));
+        return graphics;
+    }
+
+    private static NativeUiScene.Node label(final String value) {
+        final var properties = new JsonObject();
+        properties.addProperty("text", value);
+        return new NativeUiScene.Node(UUID.randomUUID().toString(), "label", properties, List.of(), Integer.MIN_VALUE);
+    }
+}
