index 0000000..2a7b151
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockGuiActorAppearanceTest.java
@@ -0,0 +1,92 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockGuiActorAppearanceTest {
+    @Test
+    void samplesVariantSelectionAndPoseInSeparatePersistentPerspectives() throws Exception {
+        final var library = BedrockResourceLibrary.read(Map.of(
+            "library/vanilla/entity/probe.json", bytes("""
+                {"minecraft:client_entity":{"description":{"identifier":"test:probe",
+                 "materials":{"default":"npc"},"geometry":{"default":"geometry.probe"},
+                 "textures":{"first":"textures/first","second":"textures/second"},
+                 "animations":{"pose":"animation.probe"},"scripts":{"initialize":["v.counter=0;"],
+                   "pre_animation":["v.counter=v.counter+1;"],"animate":["pose"]},
+                 "render_controllers":["controller.render.probe"]}}}
+                """),
+            "library/vanilla/animations/probe.json", bytes("""
+                {"animations":{"animation.probe":{"loop":true,"bones":{"head":{
+                  "position":["v.counter",0,0],"rotation":["q.target_x_rotation","q.target_y_rotation",0]}}}}}
+                """),
+            "library/vanilla/render_controllers/probe.json", bytes("""
+                {"render_controllers":{"controller.render.probe":{
+                  "arrays":{"textures":{"Array.skins":["Texture.first","Texture.second"]}},
+                  "geometry":"Geometry.default","materials":[{"*":"Material.default"}],
+                  "textures":["Array.skins[q.variant]"],"part_visibility":[{"*":"q.is_in_ui"}]}}}
+                """),
+            "library/vanilla/materials/probe.material", bytes("""
+                {"materials":{"npc:entity_alphatest":{}}}
+                """)));
+        final var first = BedrockGuiActorAppearance.load(library, "test:probe");
+        final var second = BedrockGuiActorAppearance.load(library, "test:probe");
+        try (final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID())) {
+            final var a = sample(context, first, 0, 0);
+            final var b = sample(context, first, 1, 1);
+            final var c = sample(context, second, 0, 1);
+            assertEquals(1, a.pose().get("head").position().x());
+            assertEquals(2, b.pose().get("head").position().x());
+            assertEquals(1, c.pose().get("head").position().x());
+            assertEquals(12, b.pose().get("head").rotation().x());
+            assertEquals(-8, b.pose().get("head").rotation().y());
+            assertNotEquals(a.draws().surfaces().getFirst().texture(), b.draws().surfaces().getFirst().texture());
+            assertEquals(b.draws(), c.draws());
+            assertTrue(b.draws().surfaces().getFirst().visibility().getFirst().visible());
+            assertTrue(first.materials().alphaTest(b.draws().surfaces().getFirst().material()).isPresent());
+        }
+        assertThrows(IllegalStateException.class, () -> first.sample(2, null, 0, 0, 0));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_NPC_ASSETS", matches = ".+")
+    void resolvesEveryLicensedNpcVariantWithItsNativeGeometryTextureAndMaterial() throws Exception {
+        final var library = BedrockBuiltinAssets.load().library();
+        final var appearance = BedrockGuiActorAppearance.load(library, "minecraft:npc");
+        final var selected = new java.util.HashSet<String>();
+        try (final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID())) {
+            for (int variant = 0; variant < 60; variant++) {
+                final var frame = sample(context, appearance, variant / 60F, variant);
+                assertEquals(1, frame.draws().surfaces().size());
+                final var draw = frame.draws().surfaces().getFirst();
+                assertTrue(selected.add(draw.texture()));
+                assertFalse(appearance.model(draw.geometry()).getParents().isEmpty());
+                assertNotNull(appearance.image(draw.texture()));
+                assertTrue(appearance.materials().alphaTest(draw.material()).isPresent());
+                assertFalse(frame.pose().isEmpty());
+            }
+        }
+    }
+
+    private static BedrockGuiActorAppearance.Frame sample(final BedrockGuiActorContext context,
+            final BedrockGuiActorAppearance appearance, final float seconds, final int variant) {
+        context.camera(12, -8);
+        return context.scoped(() -> {
+            try { return appearance.sample(seconds, null, variant, 12, -8); }
+            catch (final IOException error) { throw new java.io.UncheckedIOException(error); }
+        });
+    }
+
+    private static byte[] bytes(final String json) { return json.getBytes(StandardCharsets.UTF_8); }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockGuiActorContextTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockGuiActorContextTest.java
new file mode 100644
index 0000000..d53ff81
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockGuiActorContextTest.java
@@ -0,0 +1,108 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import java.util.Map;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockGuiActorContextTest {
+    @Test
+    void keepsGuiClockAndScriptVariablesSeparateFromWorldAndOtherPortraits() throws Exception {
+        final var graph = BedrockActorAnimation.read(JsonParser.parseString("""
+            {"animations":{"idle":"animation.idle"},"scripts":{
+             "initialize":["v.counter=0;"],"pre_animation":["v.counter=v.counter+1;"],"animate":["idle"]}}
+            """).getAsJsonObject(), Map.of(), JsonParser.parseString("""
+            {"animation.idle":{"loop":true,"bones":{"head":{"position":["v.counter",0,0]}}}}
+            """).getAsJsonObject(), new JsonObject(), "1.10.0");
+        final var world = graph.playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of("is_in_ui", true), Map.of());
+        final var gui = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var other = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var guiActor = gui.playback(world);
+        assertNotSame(world, guiActor);
+        assertSame(guiActor, gui.playback(world));
+        assertEquals(1, guiActor.sample(0, frame).get("head").position().x());
+        assertEquals(2, guiActor.sample(1, frame).get("head").position().x());
+        assertEquals(1, world.sample(0, frame).get("head").position().x());
+        assertEquals(1, other.playback(world).sample(0, frame).get("head").position().x());
+        assertNotSame(guiActor, gui.playback(graph.playback()));
+    }
+
+    @Test
+    void correctsPipUniformDepthScaleWithoutChangingWorldOrOrdinaryGuiTransforms() {
+        for (final int guiScale : new int[] {1, 2, 3}) {
+            final var pose = new com.mojang.blaze3d.vertex.PoseStack();
+            pose.translate(40 * guiScale, 65 * guiScale, 0);
+            pose.scale(60 * guiScale, 60 * guiScale, -60 * guiScale);
+            pose.pushPose();
+            BedrockGuiActorContext.correctPose(pose, 60, guiScale);
+            pose.translate(0, 0, -5);
+            final var matrix = pose.last().pose();
+            assertEquals(60 * guiScale, matrix.m00(), .00001F);
+            assertEquals(-60 * guiScale, matrix.m11(), .00001F);
+            assertEquals(1, matrix.m22(), .00001F);
+            assertEquals(-5, matrix.m32(), .00001F);
+            assertEquals(40 * guiScale, matrix.m30(), .00001F);
+            pose.popPose();
+            assertEquals(-60 * guiScale, pose.last().pose().m22(), .00001F);
+        }
+    }
+
+    @Test
+    void retainsGuiEffectsAndRejectsUnimplementedSubmissionInsteadOfPlayingIntoWorld() throws Exception {
+        final var graph = BedrockActorAnimation.read(JsonParser.parseString("{\"sound_effects\":{\"click\":\"gui.click\"}}").getAsJsonObject(),
+                Map.of(), new JsonObject(), new JsonObject(), "1.10.0").playback();
+        final var gui = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        gui.requireSupportedEffects();
+        final var sound = graph.soundCue(new BedrockAnimationSound(0, "click", "head"));
+        gui.sound(sound);
+        assertEquals(java.util.List.of(sound), gui.sounds());
+        assertThrows(IllegalArgumentException.class, gui::requireSupportedEffects);
+        gui.camera(0, 0);
+        gui.requireSupportedEffects();
+    }
+
+    @Test
+    void retiresExtractedFramesAndEquipmentResourcesWithoutTouchingAnotherPerspective() {
+        final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var other = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var frame = new net.minecraft.client.renderer.entity.state.AvatarRenderState();
+        final var otherFrame = new net.minecraft.client.renderer.entity.state.AvatarRenderState();
+        context.scoped(() -> { BedrockGuiActorContext.extracted(frame); return null; });
+        other.scoped(() -> { BedrockGuiActorContext.extracted(otherFrame); return null; });
+        final Object key = new Object();
+        final Object equipment = context.resource(key, "appearance", Object::new);
+        assertSame(equipment, context.resource(key, "appearance", Object::new));
+        assertNotSame(equipment, context.resource(key, "replacement", Object::new));
+        final Object replacement = context.resource(new Object(), "appearance", Object::new);
+        assertNotSame(equipment, replacement);
+        context.close();
+        assertNull(BedrockGuiActorContext.frame(frame));
+        assertSame(other, BedrockGuiActorContext.frame(otherFrame));
+        assertNotSame(replacement, context.resource(key, "appearance", Object::new));
+        other.close();
+    }
