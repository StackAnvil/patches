+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OreUiCharactersTest {
+    @Test
+    void preservesNativeSourceOffsetsAcrossNewlinesSupplementaryCharactersAndCollapsedWhitespace() throws Exception {
+        try (var stream = OreUiCharactersTest.class.getResourceAsStream("/oreui/native-characters-2225.json")) {
+            final var fixture = JsonParser.parseString(new String(stream.readAllBytes(), StandardCharsets.UTF_8)).getAsJsonObject();
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var sample = entry.getAsJsonObject();
+                final String source = sample.get("source").getAsString();
+                final var result = OreUiCharacters.prepare(source, OreUiCharacters.LineEndings.values()[sample.get("mode").getAsInt()],
+                        OreUiLines.WhiteSpace.values()[sample.get("whitespace").getAsInt()], 20F, .4F);
+                assertArrayEquals(integers(sample.getAsJsonArray("scalars")), result.scalars(), sample.toString());
+                assertArrayEquals(integers(sample.getAsJsonArray("utf16Offsets")),
+                        result.characters().stream().mapToInt(OreUiCharacters.Scalar::sourceOffset).toArray(), sample.toString());
+                assertEquals(sample.get("trailingAdvance").getAsFloat(), result.trailingAdvance(), sample.toString());
+                assertEquals(source.length(), result.sourceOffset(result.characters().size()), sample.toString());
+            }
+        }
+    }
+
+    @Test
+    void wrapsTheCollapsedTextAndMapsItsSecondLineBackToTheOriginalSource() {
+        final var source = OreUiCharacters.prepare(" \ud83d\ude00\t\r\nB ", OreUiCharacters.LineEndings.NORMALIZE,
+                OreUiLines.WhiteSpace.NORMAL, 20F, .4F);
+        assertEquals("\ud83d\ude00 B", source.text());
+        final var layout = OreUiLines.layout(source.scalars(), new float[]{10F, 4F, 10F},
+                new OreUiFont.LineMetrics(20F, 24F), 15F, 0F, 0F, OreUiLines.WhiteSpace.NORMAL,
+                OreUiLines.OverflowWrap.NORMAL, OreUiLines.Alignment.LEFT, false);
+        assertEquals(2, layout.lines().size());
+        final var second = layout.lines().get(1);
+        assertEquals("B ", " \ud83d\ude00\t\r\nB ".substring(source.sourceOffset(second.start()), source.sourceOffset(second.end())));
+        assertEquals(48F, layout.height());
+    }
+
+    @Test
+    void rejectsUnpairedSurrogatesInsteadOfReplacingTheSourceCharacter() {
+        for (final String source : new String[]{"A\ud800", "\udc00B", "\ud800B"}) {
+            assertThrows(IllegalArgumentException.class, () -> OreUiCharacters.prepare(source,
+                    OreUiCharacters.LineEndings.NORMALIZE, OreUiLines.WhiteSpace.NORMAL, 20F, 0F));
+        }
+    }
+
+    private static int[] integers(final JsonArray values) {
+        final int[] result = new int[values.size()];
+        for (int index = 0; index < result.length; index++) result[index] = values.get(index).getAsInt();
+        return result;
+    }
+}
