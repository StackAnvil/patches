+    public static OreUiAnimation decode(final byte[] bytes) throws IOException {
+        if (bytes.length < 13 || bytes.length > 16 * 1024 * 1024) throw new IOException("Invalid OreUI animation size");
+        final var readers = ImageIO.getImageReadersByFormatName("gif");
+        if (!readers.hasNext()) throw new IOException("GIF decoder is unavailable");
+        final var reader = readers.next();
+        try (var input = new MemoryCacheImageInputStream(new ByteArrayInputStream(bytes))) {
+            reader.setInput(input, false, false);
+            final Node screen = child(reader.getStreamMetadata().getAsTree("javax_imageio_gif_stream_1.0"), "LogicalScreenDescriptor");
+            final int width = integer(screen, "logicalScreenWidth"), height = integer(screen, "logicalScreenHeight");
+            final int count = reader.getNumImages(true);
+            if (width <= 0 || height <= 0 || width > 2048 || height > 2048 || count < 1 || count > 256
+                    || (long) width * height * 4 * count > MAX_DECODED_BYTES) throw new IOException("OreUI animation exceeds decoded limits");
+            int[] canvas = new int[width * height];
+            final List<Frame> frames = new ArrayList<>();
+            long duration = 0;
+            for (int index = 0; index < count; index++) {
+                final Node metadata = reader.getImageMetadata(index).getAsTree("javax_imageio_gif_image_1.0");
+                final Node image = child(metadata, "ImageDescriptor"), control = child(metadata, "GraphicControlExtension");
+                final int left = integer(image, "imageLeftPosition"), top = integer(image, "imageTopPosition");
+                final int frameWidth = integer(image, "imageWidth"), frameHeight = integer(image, "imageHeight");
+                final int delay = integer(control, "delayTime") * 10;
+                if (left < 0 || top < 0 || frameWidth <= 0 || frameHeight <= 0 || left + frameWidth > width
+                        || top + frameHeight > height || delay <= 0) throw new IOException("Unsupported OreUI animation frame");
