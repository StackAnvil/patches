+    @Test
+    void retainsSignedInteriorForUndersizedDestinationsAndZerosOnlyZeroAxisBorders() {
+        final var small = regions(new NativeUiLayout.Rect(100, 200, 5, 4), 0, 0);
+        assertEquals(new NativeUiImageRegions.Region(100, 200, 103, 204, 0, 0, 3, 4), small.get(0));
