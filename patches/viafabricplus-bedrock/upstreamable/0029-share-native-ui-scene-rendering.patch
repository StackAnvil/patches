+    private OreUiAssets(final Map<String, byte[]> files, final List<Face> faces, final String stylesheet, final List<String> images) {
+        this.files = Map.copyOf(files); this.faces = List.copyOf(faces); this.stylesheet = stylesheet; this.images = List.copyOf(images);
+    }
