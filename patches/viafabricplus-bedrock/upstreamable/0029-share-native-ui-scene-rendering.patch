@@ -0,0 +1,180 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.foreign.Arena;
+import java.lang.foreign.FunctionDescriptor;
+import java.lang.foreign.Linker;
+import java.lang.foreign.MemoryLayout;
+import java.lang.foreign.MemorySegment;
+import java.lang.foreign.SymbolLookup;
+import java.lang.invoke.MethodHandle;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.HexFormat;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import static java.lang.foreign.ValueLayout.ADDRESS;
+import static java.lang.foreign.ValueLayout.JAVA_INT;
+
+/** Owns a compatible shaping engine without changing LWJGL's process-global HarfBuzz selection. */
+public final class OreUiShaper implements AutoCloseable {
+    static final int MAX_FONTS = 32;
+    static final MemoryLayout P = ADDRESS, I = JAVA_INT;
+    static final MemorySegment NULL = MemorySegment.NULL;
+    private static final int MAX_LIBRARY_BYTES = 16 * 1024 * 1024;
+    private static final String RESOURCE = "/assets/viafabricplus-bedrock/oreui-shaper/";
+    private final Arena arena = Arena.ofShared();
+    private final SymbolLookup symbols;
+    private final Map<String, MethodHandle> calls = new HashMap<>();
+    private final Set<OreUiFont> fonts = new HashSet<>();
+    private final Path temporary;
+    private boolean closed;
+
+    /** The path entry point is also used by native-boundary integration tests. */
+    OreUiShaper(final Path library) throws IOException { this(library, null); }
+
+    private OreUiShaper(final Path library, final Path temporary) throws IOException {
+        this.temporary = temporary;
+        try {
+            this.symbols = SymbolLookup.libraryLookup(library.toAbsolutePath(), this.arena);
+            final String version = this.pointer("hb_version_string", new MemoryLayout[0]).reinterpret(64).getString(0);
+            if (!version.equals("14.3.0")) throw new IOException("Incompatible OreUI shaping engine: " + version);
+        } catch (final IOException | RuntimeException | Error failure) {
+            this.arena.close();
+            throw failure;
+        }
+    }
+
+    public static OreUiShaper bundled() throws IOException {
+        final String platform = platform();
+        final String root = RESOURCE + platform + "/";
+        final String library = platform.startsWith("windows-") ? "stackanvil_oreui_harfbuzz.dll"
+                : platform.startsWith("macos-") ? "libstackanvil_oreui_harfbuzz.dylib" : "libstackanvil_oreui_harfbuzz.so";
+        final byte[] bytes;
+        try {
+            final var manifest = JsonParser.parseString(new String(resource(root + "manifest.json", 8192), StandardCharsets.UTF_8)).getAsJsonObject();
+            if (manifest.get("format").getAsInt() != 1 || !manifest.get("engine").getAsString().equals("HarfBuzz")
+                    || !manifest.get("version").getAsString().equals("14.3.0")
+                    || !manifest.get("target").getAsString().equals("Bedrock 1.26.60.5 OreUI")
+                    || !(manifest.get("platform").getAsString() + "-" + manifest.get("architecture").getAsString()).equals(platform)
+                    || !manifest.get("library").getAsString().equals(library)) throw new IOException("Invalid OreUI engine identity");
+            bytes = resource(root + library, MAX_LIBRARY_BYTES);
+            if (!digest(bytes).equals(manifest.get("sha256").getAsString())) throw new IOException("OreUI engine checksum mismatch");
+        } catch (final RuntimeException invalid) { throw new IOException("Invalid OreUI engine manifest", invalid); }
+        final Path directory = Files.createTempDirectory("viafabricplus-oreui-");
+        final Path extracted = directory.resolve(library);
+        try {
+            Files.write(extracted, bytes);
+            return new OreUiShaper(extracted, directory);
+        } catch (final IOException | RuntimeException | Error failure) {
+            try { Files.deleteIfExists(extracted); Files.deleteIfExists(directory); }
+            catch (final IOException cleanup) { failure.addSuppressed(cleanup); }
+            throw failure;
+        }
+    }
+
+    static String platform() throws IOException {
+        final String os = System.getProperty("os.name", "").toLowerCase(Locale.ROOT);
+        final String system = os.startsWith("windows") ? "windows" : os.startsWith("mac") ? "macos" : os.startsWith("linux") ? "linux" : "";
+        final String architecture = switch (System.getProperty("os.arch", "").toLowerCase(Locale.ROOT)) {
+            case "amd64", "x86_64" -> "x64";
+            case "aarch64", "arm64" -> "arm64";
+            default -> "";
+        };
+        if (system.isEmpty() || architecture.isEmpty()) throw new IOException("Unsupported OreUI engine platform");
+        return system + "-" + architecture;
+    }
+
+    private static byte[] resource(final String path, final int limit) throws IOException {
+        try (InputStream input = OreUiShaper.class.getResourceAsStream(path)) {
+            if (input == null) throw new IOException("Missing bundled OreUI resource: " + path);
+            final byte[] bytes = input.readNBytes(limit + 1);
+            if (bytes.length == 0 || bytes.length > limit) throw new IOException("Invalid bundled OreUI resource size");
+            return bytes;
+        }
+    }
+
+    private static String digest(final byte[] bytes) {
+        try { return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)); }
+        catch (final NoSuchAlgorithmException impossible) { throw new AssertionError(impossible); }
+    }
+
+    public synchronized OreUiFont font(final byte[] bytes, final int pixels) throws IOException {
+        this.requireOpen();
+        if (this.fonts.size() >= MAX_FONTS) throw new IOException("Too many active OreUI font faces");
+        final var font = new OreUiFont(this, bytes, pixels);
+        this.fonts.add(font);
+        return font;
+    }
+
+    void retired(final OreUiFont font) { this.fonts.remove(font); }
+
+    void requireOpen() {
+        if (this.closed) throw new IllegalStateException("OreUI shaping engine is closed");
+    }
+
+    private Object call(final String name, final MemoryLayout result, final MemoryLayout[] arguments, final Object[] values) {
+        this.requireOpen();
+        final var handle = this.calls.computeIfAbsent(name, key -> Linker.nativeLinker().downcallHandle(this.symbols.findOrThrow(key),
+                result == null ? FunctionDescriptor.ofVoid(arguments) : FunctionDescriptor.of(result, arguments)));
+        try { return handle.invokeWithArguments(values); }
+        catch (final RuntimeException | Error failure) { throw failure; }
+        catch (final Throwable failure) { throw new IllegalStateException("OreUI native call failed: " + name, failure); }
+    }
+
+    MemorySegment pointer(final String name, final MemoryLayout[] arguments, final Object... values) {
+        return (MemorySegment) this.call(name, P, arguments, values);
+    }
+
+    int integer(final String name, final MemoryLayout[] arguments, final Object... values) {
+        return (int) this.call(name, I, arguments, values);
+    }
+
+    void run(final String name, final MemoryLayout[] arguments, final Object... values) {
+        this.call(name, null, arguments, values);
+    }
+
+    @Override
+    public synchronized void close() throws IOException {
+        if (this.closed) return;
+        Throwable failure = null;
+        for (final var font : Set.copyOf(this.fonts)) {
+            try { font.close(); }
+            catch (final RuntimeException | Error error) {
+                if (failure == null) failure = error; else failure.addSuppressed(error);
+            }
+        }
+        this.closed = true;
+        this.calls.clear();
+        try {
+            this.arena.close();
+        } catch (final RuntimeException | Error error) {
+            if (failure == null) failure = error; else failure.addSuppressed(error);
+        }
+        try {
+            if (this.temporary != null) {
+                try (var entries = Files.list(this.temporary)) {
+                    for (final Path entry : entries.toList()) Files.deleteIfExists(entry);
+                } finally { Files.deleteIfExists(this.temporary); }
+            }
+        } catch (final IOException | RuntimeException | Error error) {
+            if (failure == null) failure = error; else failure.addSuppressed(error);
+        }
+        if (failure instanceof IOException error) throw error;
+        if (failure instanceof RuntimeException error) throw error;
+        if (failure instanceof Error error) throw error;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiText.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/oreui/OreUiText.java
