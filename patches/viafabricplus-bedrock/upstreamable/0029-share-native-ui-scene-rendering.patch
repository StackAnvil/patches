+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.input;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScreen;
+import net.minecraft.client.MouseHandler;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.MouseButtonEvent;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(MouseHandler.class)
+public abstract class MixinNativeUiInput {
+    private static MouseButtonEvent nativeEvent(final Screen screen, final MouseButtonEvent event) {
+        if (!(screen instanceof NativeUiScreen nativeScreen)) return event;
+        final var viewport = nativeScreen.nativeViewport();
+        return new MouseButtonEvent(viewport.pointer(event.x()), viewport.pointer(event.y()), event.buttonInfo());
+    }
+
+    @WrapOperation(method = "onButton", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;mouseClicked(Lnet/minecraft/client/input/MouseButtonEvent;Z)Z"))
+    private boolean mouseClicked(final Screen screen, final MouseButtonEvent event, final boolean doubleClick,
+                                   final Operation<Boolean> original) {
+        return original.call(screen, nativeEvent(screen, event), doubleClick);
+    }
+
+    @WrapOperation(method = "onButton", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;mouseReleased(Lnet/minecraft/client/input/MouseButtonEvent;)Z"))
+    private boolean mouseReleased(final Screen screen, final MouseButtonEvent event, 
+                                   final Operation<Boolean> original) {
+        return original.call(screen, nativeEvent(screen, event));
+    }
+
+    @WrapOperation(method = "handleAccumulatedMovement", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;mouseMoved(DD)V"))
+    private void mouseMoved(final Screen screen, final double x, final double y, final Operation<Void> original) {
+        if (screen instanceof NativeUiScreen nativeScreen) {
+            final var viewport = nativeScreen.nativeViewport();
+            original.call(screen, viewport.pointer(x), viewport.pointer(y));
+        } else original.call(screen, x, y);
+    }
+
+    @WrapOperation(method = "handleAccumulatedMovement", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;mouseDragged(Lnet/minecraft/client/input/MouseButtonEvent;DD)Z"))
+    private boolean mouseDragged(final Screen screen, final MouseButtonEvent event, final double x, final double y,
+                                 final Operation<Boolean> original) {
+        if (screen instanceof NativeUiScreen nativeScreen) {
+            final var viewport = nativeScreen.nativeViewport();
+            return original.call(screen, nativeEvent(screen, event), viewport.pointer(x), viewport.pointer(y));
+        }
+        return original.call(screen, event, x, y);
+    }
+
+    @WrapOperation(method = "onScroll", at = @At(value = "INVOKE", target =
+        "Lnet/minecraft/client/gui/screens/Screen;mouseScrolled(DDDD)Z"))
+    private boolean mouseScrolled(final Screen screen, final double x, final double y, final double horizontal,
+                                  final double vertical, final Operation<Boolean> original) {
+        if (screen instanceof NativeUiScreen nativeScreen) {
+            final var viewport = nativeScreen.nativeViewport();
+            return original.call(screen, viewport.pointer(x), viewport.pointer(y), horizontal, vertical);
+        }
+        return original.call(screen, x, y, horizontal, vertical);
+    }
+}
