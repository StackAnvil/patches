+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/** Ordered font assignment for the ordinary native path, before line construction and draw shaping. */
+public record OreUiFonts(List<Glyph> glyphs) {
+    public OreUiFonts { glyphs = List.copyOf(glyphs); }
+    public record Glyph(int scalar, int index, int font, float advance) { }
+
+    public interface Font {
+        int[] glyphs(int[] scalars) throws IOException;
+        float[] advances(int[] scalars) throws IOException;
+    }
+
+    /** Null entries retain the positions of unavailable native font families. */
+    public static OreUiFonts assign(final OreUiCharacters text, final List<? extends Font> supplied) throws IOException {
+        final List<? extends Font> fonts = new ArrayList<>(supplied);
+        final int[] scalars = text.scalars();
+        if (scalars.length > 16384 || fonts.size() > 32) throw new IOException("OreUI font assignment exceeds limits");
+        final int[] glyphs = new int[scalars.length], selected = new int[scalars.length];
+        final float[] advances = new float[scalars.length];
+        for (int index = 0; index < fonts.size(); index++) {
+            final var font = fonts.get(index);
+            if (font == null) continue;
+            for (int start = 0; start < scalars.length;) {
+                while (start < scalars.length && glyphs[start] != 0) start++;
+                int end = start;
+                while (end < scalars.length && glyphs[end] == 0) end++;
+                if (start == end) break;
+                final int[] span = Arrays.copyOfRange(scalars, start, end);
+                final int[] mapped = font.glyphs(span);
+                requireGlyphs(mapped, span.length);
+                // Measure the whole unresolved span before the next font fills any remaining holes.
+                final float[] measured = font.advances(span);
+                requireAdvances(measured, span.length);
+                System.arraycopy(mapped, 0, glyphs, start, span.length);
+                System.arraycopy(measured, 0, advances, start, span.length);
+                Arrays.fill(selected, start, end, index);
+                start = end;
+            }
+        }
+        for (int index = 0; index < scalars.length; index++) {
+            if (!whitespace(scalars[index])) continue;
+            if (index > 0 && index + 1 < scalars.length && selected[index - 1] == selected[index + 1]
+                    && selected[index] != selected[index + 1]) {
+                final int candidate = selected[index + 1];
+                final var font = fonts.get(candidate);
+                if (font != null) {
+                    final int[] scalar = {scalars[index]};
+                    final int[] mapped = font.glyphs(scalar);
+                    requireGlyphs(mapped, 1);
+                    if (mapped[0] != 0) {
+                        final float[] measured = font.advances(scalar);
+                        requireAdvances(measured, 1);
+                        selected[index] = candidate;
+                        advances[index] = measured[0];
+                    }
+                }
+            }
+            glyphs[index] = -1;
+        }
+        final List<Glyph> result = new ArrayList<>(scalars.length);
+        for (int index = 0; index < scalars.length; index++)
+            result.add(new Glyph(scalars[index], glyphs[index], selected[index], advances[index]));
+        return new OreUiFonts(result);
+    }
+
+    private static boolean whitespace(final int scalar) {
+        return scalar == 0 || scalar == '\t' || scalar == '\n' || scalar == 0xb || scalar == 0xc || scalar == ' ';
+    }
+
+    private static void requireGlyphs(final int[] values, final int count) throws IOException {
+        if (values == null || values.length != count) throw new IOException("Invalid OreUI glyph coverage");
+        for (final int value : values) if (value < 0) throw new IOException("Invalid OreUI glyph index");
+    }
+
+    private static void requireAdvances(final float[] values, final int count) throws IOException {
+        if (values == null || values.length != count) throw new IOException("Invalid OreUI font advances");
+        for (final float value : values) if (!Float.isFinite(value)) throw new IOException("Invalid OreUI font advance");
+    }
+}
