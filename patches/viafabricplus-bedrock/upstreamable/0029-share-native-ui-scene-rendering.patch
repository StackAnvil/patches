+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeHudMessage;
+
+/** Separate capabilities retain the existing title wire format for older add-ons. */
+public record NativeHudPayload(Kind kind, NativeHudMessage message) implements CustomPacketPayload {
+    public enum Kind {
+        ROOT(NativeHudMessage.ROOT_CHANNEL),
+        TITLE(NativeHudMessage.CHANNEL),
+        ACTIONBAR(NativeHudMessage.ACTIONBAR_CHANNEL);
+
+        private final Type<NativeHudPayload> type;
+        private final StreamCodec<RegistryFriendlyByteBuf, NativeHudPayload> codec;
+
+        Kind(final String channel) {
+            this.type = new Type<>(Identifier.parse(channel));
+            this.codec = CustomPacketPayload.codec(
+                (payload, buffer) -> NativeHudMessage.TYPE.write(buffer, payload.message),
+                buffer -> new NativeHudPayload(this, NativeHudMessage.TYPE.read(buffer)));
+        }
+
+        public Type<NativeHudPayload> type() { return this.type; }
+        public StreamCodec<RegistryFriendlyByteBuf, NativeHudPayload> codec() { return this.codec; }
+    }
+
+    @Override public Type<NativeHudPayload> type() { return this.kind.type(); }
+}
