+package com.viaversion.viafabricplus.bedrock.render.oreui;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Ordinary line construction after text preprocessing and font selection. */
+public record OreUiLines(List<Line> lines, float width, float height) {
+    public OreUiLines { lines = List.copyOf(lines); }
+
+    /** Ranges index supplied Unicode scalars, including consumed spaces and explicit line endings. */
+    public record Fragment(int start, int end, int font, float x, float baseline, float width, float height) { }
+    /** A mixed-font line retains each fragment's own baseline. The summary uses its first fragment. */
+    public record Line(int start, int end, float x, float baseline, float width, float height, boolean hardBreak,
+                       List<Fragment> fragments) {
+        public Line { fragments = List.copyOf(fragments); }
+        public Line(final int start, final int end, final float x, final float baseline, final float width,
+                    final float height, final boolean hardBreak) {
+            this(start, end, x, baseline, width, height, hardBreak, start == end && !hardBreak ? List.of()
+                    : List.of(new Fragment(start, end, 1, x, baseline, width, height)));
+        }
+    }
+    /** Equal identities share one native face. Zero represents an unavailable face. */
+    public record Font(int identity, OreUiFont.LineMetrics metrics) { }
+    public enum WhiteSpace { NORMAL, NO_WRAP, PRE, PRE_WRAP }
+    public enum OverflowWrap { NORMAL, BREAK_WORD, ANYWHERE }
+    public enum Alignment { LEFT, RIGHT, CENTER }
+
+    public static OreUiLines layout(final int[] scalars, final float[] advances, final OreUiFont.LineMetrics metrics,
+                                    final float availableWidth, final float indent, final float letterSpacing,
+                                    final WhiteSpace whitespace, final OverflowWrap wrap,
+                                    final Alignment alignment, final boolean fillAvailable) {
+        return layout(scalars, advances, new int[scalars.length], List.of(new Font(1, metrics)), availableWidth,
+                indent, letterSpacing, whitespace, wrap, alignment, fillAvailable);
+    }
+
+    public static OreUiLines layout(final int[] scalars, final float[] advances, final int[] fontMap, final List<Font> supplied,
+                                    final float availableWidth, final float indent, final float letterSpacing,
+                                    final WhiteSpace whitespace, final OverflowWrap wrap,
+                                    final Alignment alignment, final boolean fillAvailable) {
+        return layout(scalars, advances, fontMap, supplied, availableWidth, indent, letterSpacing, whitespace, wrap,
+                alignment, fillAvailable, 0F);
+    }
+
+    /** The preprocessing reserve adjusts row bounds before alignment without changing fragment advances. */
+    public static OreUiLines layout(final int[] scalars, final float[] advances, final int[] fontMap, final List<Font> supplied,
+                                    final float availableWidth, final float indent, final float letterSpacing,
+                                    final WhiteSpace whitespace, final OverflowWrap wrap,
+                                    final Alignment alignment, final boolean fillAvailable, final float trailingAdvance) {
+        final List<Font> fonts = List.copyOf(supplied);
+        if (scalars.length > 16384 || advances.length != scalars.length || fontMap.length != scalars.length
+                || fonts.isEmpty() || fonts.size() > 32 || !Float.isFinite(availableWidth)
+                || availableWidth < 0 || !Float.isFinite(indent) || !Float.isFinite(letterSpacing) || !Float.isFinite(trailingAdvance))
+            throw new IllegalArgumentException("Invalid OreUI line bounds");
+        for (final var font : fonts) {
+            if (!Float.isFinite(font.metrics.baselineOffset()) || !Float.isFinite(font.metrics.advance()) || font.metrics.advance() < 0)
+                throw new IllegalArgumentException("Invalid OreUI line metrics");
+        }
+        final float[] tracked = new float[advances.length + 1];
+        for (int index = 0; index < advances.length; index++) {
+            if (!Float.isFinite(advances[index]) || fontMap[index] < 0 || fontMap[index] >= fonts.size())
+                throw new IllegalArgumentException("Invalid OreUI character advance or font");
+            tracked[index] = advances[index] + (index < advances.length - 1 ? letterSpacing : 0F);
+            if (!Float.isFinite(tracked[index])) throw new IllegalArgumentException("Invalid OreUI tracked advance");
+        }
+        final var state = new Builder(scalars, fontMap, fonts, availableWidth, indent, whitespace);
+        for (; state.index <= scalars.length; state.index++) {
+            final int scalar = state.index == scalars.length ? '\n' : scalars[state.index];
+            final boolean space = space(scalar), hardBreak = scalar == '\n';
+            final boolean word = !space && !hardBreak && scalar != '\r';
+            final boolean fontChange = (word || space) && state.fontAt(state.index).identity != state.font;
+            if (word && state.wordStart < 0) state.wordStart = state.index;
+            final float wordWidth = state.wordWidth(tracked);
+            final boolean breakWord = wrap == OverflowWrap.BREAK_WORD && wordWidth > availableWidth;
+            if (space || hardBreak || breakWord || wrap == OverflowWrap.ANYWHERE || fontChange) {
+                if (state.wordStart >= 0) {
+                    final float combined = state.currentWidth + state.pendingSpace + wordWidth;
+                    if (state.remaining < state.x + combined && (whitespace == WhiteSpace.NORMAL || whitespace == WhiteSpace.PRE_WRAP)) {
+                        state.flushLine(false);
+                        state.start = state.wordStart;
+                        state.end = state.index;
+                        state.currentWidth = wordWidth;
+                        state.refreshFont();
+                    } else {
+                        state.currentWidth = combined;
+                        state.end = state.index;
+                        state.pendingSpace = 0;
+                    }
+                    if (breakWord && state.end - state.start > 1) {
+                        state.end--;
+                        state.currentWidth -= tracked[state.index - 1];
+                        state.flushLine(false);
+                        state.index--;
+                        final int previous = scalars[state.index];
+                        if (!space(previous) && previous != '\r' && previous != '\n') state.wordStart = state.index;
+                        continue;
+                    }
+                }
+                if (word) state.wordStart = state.index;
+                else {
+                    state.wordStart = -1;
+                    if (space) state.pendingSpace += tracked[state.index];
+                }
+                if (fontChange) state.flushFragment(false);
+                if (hardBreak) state.flushLine(true);
+            }
+        }
+        if (Math.abs(trailingAdvance) > .001F) {
+            for (int index = 0; index < state.lines.size(); index++) {
+                final var line = state.lines.get(index);
+                final float available = index == 0 ? availableWidth - indent : availableWidth;
+                final float limit = available <= line.width ? line.width : available;
+                final float reserved = line.width + trailingAdvance;
+                final float adjusted = reserved <= limit ? reserved : limit;
+                state.lines.set(index, new Line(line.start, line.end, line.x, line.baseline, adjusted, line.height,
+                        line.hardBreak, line.fragments));
+            }
+        }
+        float width = 0F;
+        boolean softWrap = false;
+        for (int index = 0; index < state.lines.size(); index++) {
+            final var line = state.lines.get(index);
+            if (index == 0 || line.width() > width) width = line.width();
+            if (index < state.lines.size() - 1 && !line.hardBreak()) softWrap = true;
+        }
+        final float overflow = Math.max(0F, width - availableWidth);
+        final float alignmentWidth = width < availableWidth && fillAvailable && softWrap ? availableWidth : width;
+        final List<Line> aligned = new ArrayList<>(state.lines.size());
+        for (final var line : state.lines) {
+            float offset = 0F;
+            if (!line.fragments.isEmpty() && alignment != Alignment.LEFT && Math.abs(line.width - alignmentWidth) > .001F) {
+                offset = Math.max(0F, (alignmentWidth - overflow) - line.width);
+                if (alignment == Alignment.CENTER) offset *= .5F;
+            }
+            if (offset == 0F) { aligned.add(line); continue; }
+            final List<Fragment> fragments = new ArrayList<>(line.fragments.size());
+            for (final var fragment : line.fragments) fragments.add(new Fragment(fragment.start, fragment.end, fragment.font,
+                    offset + fragment.x, fragment.baseline, fragment.width, fragment.height));
+            aligned.add(new Line(line.start, line.end, offset + line.x, line.baseline, line.width, line.height, line.hardBreak, fragments));
+        }
+        return new OreUiLines(aligned, width, state.height);
+    }
+
+    private static boolean space(final int scalar) {
+        return scalar == 0 || scalar == '\t' || scalar == 0xb || scalar == 0xc || scalar == ' ';
+    }
+
+    private static final class Builder {
+        private final List<Line> lines = new ArrayList<>();
+        private final List<Fragment> fragments = new ArrayList<>();
+        private final int[] scalars, fontMap;
+        private final List<Font> fonts;
+        private final float width, indent;
+        private final WhiteSpace whitespace;
+        private int wordStart = -1, index, start, end, font;
+        private int measuredStart = -1, measuredEnd;
+        private float measuredWidth;
+        private float remaining, currentWidth, pendingSpace, height, x, baseline, fragmentHeight, rowWidth, rowHeight;
+
+        private Builder(final int[] scalars, final int[] fontMap, final List<Font> fonts,
+                        final float width, final float indent, final WhiteSpace whitespace) {
+            this.scalars = scalars; this.fontMap = fontMap; this.fonts = fonts;
+            this.width = width; this.indent = indent; this.whitespace = whitespace;
+            this.remaining = width - indent;
+            if (!this.refreshFont() && scalars.length == 0) {
+                final var fallback = fonts.stream().filter(value -> value.identity != 0).findFirst()
+                        .orElseThrow(() -> new IllegalArgumentException("No OreUI font for an empty line"));
+                this.font = fallback.identity;
+                this.baseline = fallback.metrics.baselineOffset();
+                this.fragmentHeight = fallback.metrics.advance();
+                // The original empty-input path retains this seed before forcing the final fragment.
+                this.fragments.add(new Fragment(0, 0, this.font, 0F, this.baseline, 0F, this.fragmentHeight));
+            }
+        }
+
+        private Font fontAt(final int index) { return this.fonts.get(index < this.fontMap.length ? this.fontMap[index] : 0); }
+
+        private boolean refreshFont() {
+            final var selected = this.fontAt(this.start);
+            if (selected.identity == this.font) return false;
+            this.font = selected.identity;
+            this.baseline = this.height + selected.metrics.baselineOffset();
+            this.fragmentHeight = selected.metrics.advance();
+            return true;
+        }
+
+        private float wordWidth(final float[] advances) {
+            if (this.wordStart < 0) return advances[this.index];
+            if (this.measuredStart != this.wordStart || this.measuredEnd > this.index) {
+                this.measuredStart = this.measuredEnd = this.wordStart;
+                this.measuredWidth = 0F;
+            }
+            while (this.measuredEnd < this.index) this.measuredWidth += advances[this.measuredEnd++];
+            return this.measuredWidth;
+        }
+
+        private void flushFragment(final boolean force) {
+            final int requested = this.wordStart < 0 ? this.index : this.wordStart;
+            final boolean advanced = this.end < requested;
+            if (advanced) this.end = requested;
+            if (this.start == this.end && !force) return;
+            if (advanced && (this.whitespace == WhiteSpace.PRE || this.whitespace == WhiteSpace.PRE_WRAP)) {
+                this.currentWidth += Math.min(Math.max(0F, this.remaining - this.currentWidth), Math.max(0F, this.pendingSpace));
+            }
+            if (force && this.index != this.scalars.length) this.end++;
+            this.fragments.add(new Fragment(this.start, this.end, this.font, this.x, this.baseline, this.currentWidth, this.fragmentHeight));
+            this.rowHeight = Math.max(this.rowHeight, this.fragmentHeight);
+            this.rowWidth = this.currentWidth + this.rowWidth;
+            this.start = this.end;
+            this.x = this.currentWidth + this.x;
+            this.currentWidth = 0F;
+            this.refreshFont();
+        }
+
+        private void flushLine(final boolean hardBreak) {
+            this.flushFragment(hardBreak);
+            if (this.indent == 0F && this.fragments.isEmpty()) return;
+            if (this.fragments.isEmpty()) this.lines.add(new Line(0, 0, 0F, 0F, this.rowWidth, this.rowHeight, hardBreak, List.of()));
+            else {
+                final var first = this.fragments.getFirst(); final var last = this.fragments.getLast();
+                this.lines.add(new Line(first.start, last.end, first.x, first.baseline, this.rowWidth, this.rowHeight, hardBreak, this.fragments));
+            }
+            this.height = this.rowHeight + this.height;
+            this.fragments.clear(); this.rowWidth = this.rowHeight = 0F;
+            this.x = 0F;
+            this.baseline = this.height + this.fontAt(this.start).metrics.baselineOffset();
+            this.pendingSpace = 0F;
+            this.remaining = this.width;
+        }
+    }
+}
