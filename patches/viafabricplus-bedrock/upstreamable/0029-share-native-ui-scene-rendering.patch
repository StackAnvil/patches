+package com.viaversion.viafabricplus.bedrock.render.font;
+
+import com.mojang.blaze3d.font.GlyphInfo;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.textures.GpuTextureView;
+import com.viaversion.viafabricplus.bedrock.render.font.BedrockBitmapFont.Cell;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiViewport;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.font.TextRenderable;
+import net.minecraft.client.gui.font.glyphs.BakedGlyph;
+import net.minecraft.client.gui.font.glyphs.BakedSheetGlyph;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.network.chat.Style;
+import org.joml.Matrix4fc;
+
+/** Carries native cell geometry through GUI text and preserves Java's world-text path. */
+final class BedrockBitmapGlyph implements BakedGlyph {
+    private final BakedSheetGlyph glyph;
+    private final Cell cell;
+    private final boolean smooth;
+
+    BedrockBitmapGlyph(final BakedSheetGlyph glyph, final Cell cell, final boolean smooth) {
+        this.smooth = smooth;
+        this.glyph = glyph;
+        this.cell = cell;
+    }
+
+    @Override
+    public GlyphInfo info() { return this.glyph.info(); }
+
+    @Override
+    public TextRenderable.Styled createGlyph(final float x, final float y, final int color, final int shadowColor,
+                                             final Style style, final float boldOffset, final float shadowOffset) {
+        final var source = this.glyph.createGlyph(x, y, color, shadowColor, style, boldOffset, shadowOffset);
+        final var gui = style.isItalic()
+                ? this.glyph.createGlyph(x, y, color, shadowColor, style.withItalic(false), boldOffset, shadowOffset) : source;
+        return new Instance(source, gui, this.cell, style.isItalic(),
+                this.smooth && NativeUiViewport.current().scale() == 1);
+    }
+
+    private record Instance(TextRenderable.Styled source, TextRenderable.Styled gui, Cell cell, boolean italic,
+                            boolean smooth) implements TextRenderable.Styled {
+        @Override
+        public void render(final Matrix4fc pose, final VertexConsumer vertices, final int light, final boolean inverseDepth) {
+            if (inverseDepth) {
+                this.gui.render(pose, new CellVertices(vertices, this.cell, Minecraft.getInstance().getWindow().getGuiScale(), this.italic), light, true);
+            } else {
+                this.source.render(pose, vertices, light, false);
+            }
+        }
+
+        @Override public RenderType renderType(final Font.DisplayMode mode) { return this.source.renderType(mode); }
+        @Override public GpuTextureView textureView() { return this.source.textureView(); }
+        @Override public RenderPipeline guiPipeline() { return this.smooth ? BedrockBitmapPipeline.GUI_SMOOTH : BedrockBitmapPipeline.GUI; }
+        @Override public Style style() { return this.source.style(); }
+        @Override public float left() { return this.italic ? Math.min(this.source.left(), this.gui.left() - 1) : this.source.left(); }
+        @Override public float top() { return this.source.top(); }
+        @Override public float right() { return this.italic ? Math.max(this.source.right(), this.gui.right() + 1) : this.source.right(); }
+        @Override public float bottom() { return this.source.bottom(); }
+        @Override public float activeLeft() { return this.italic ? Math.min(this.source.activeLeft(), this.gui.activeLeft() - 1) : this.source.activeLeft(); }
+        @Override public float activeTop() { return this.source.activeTop(); }
+        @Override public float activeRight() { return this.italic ? Math.max(this.source.activeRight(), this.gui.activeRight() + 1) : this.source.activeRight(); }
+        @Override public float activeBottom() { return this.source.activeBottom(); }
+    }
+
+    /** D3D11 sets up interpolation on positions snapped to the nearest even n.8 raster coordinate. */
+    static float rasterSnap(final float value, final int guiScale) {
+        final float rasterScale = 256 * guiScale;
+        return (float) Math.rint(value * rasterScale) / rasterScale;
+    }
+
+    /**
+     * Carries native vertex precision and top-edge coverage into Java's offscreen GUI target.
+     * One native 8-bit raster step selects the top half-pixel edge; the shader cancels its UV displacement.
+     */
+    private static final class CellVertices implements VertexConsumer {
+        private final VertexConsumer target;
+        private final Cell cell;
+        private final int guiScale;
+        private final boolean italic;
+        private int vertex;
+
+        private CellVertices(final VertexConsumer target, final Cell cell, final int guiScale, final boolean italic) {
+            this.target = target;
+            this.cell = cell;
+            this.guiScale = guiScale;
+            this.italic = italic;
+        }
+        @Override public VertexConsumer addVertex(final float x, final float y, final float z) {
+            this.target.addVertex(rasterSnap(x, this.guiScale),
+                rasterSnap(y, this.guiScale) - 1F / (256 * this.guiScale), z);
+            return this;
+        }
+        @Override public VertexConsumer addVertex(final Matrix4fc pose, final float x, final float y, final float z) {
+            final int corner = this.vertex++ & 3;
+            final float shear = this.italic ? (corner == 0 || corner == 3 ? 1 : -1) : 0;
+            return VertexConsumer.super.addVertex(pose, half(x + shear), half(y), half(z));
+        }
+        private static float half(final float value) {
+            return Float.float16ToFloat(Float.floatToFloat16(value));
+        }
+        @Override public VertexConsumer setColor(final int r, final int g, final int b, final int a) {
+            this.target.setColor(r, g, b, a);
+            return this;
+        }
+        @Override public VertexConsumer setColor(final int color) { this.target.setColor(color); return this; }
+        @Override public VertexConsumer setUv(final float u, final float v) {
+            this.target.setUv(u, v).setUv1(this.cell.x(), this.cell.y()).setUv3(this.cell.width(), this.cell.height());
+            return this;
+        }
+        @Override public VertexConsumer setUv1(final int u, final int v) { this.target.setUv1(u, v); return this; }
+        @Override public VertexConsumer setUv2(final int u, final int v) { this.target.setUv2(u, v); return this; }
+        @Override public VertexConsumer setUv3(final float u, final float v) { this.target.setUv3(u, v); return this; }
+        @Override public VertexConsumer setNormal(final float x, final float y, final float z) {
+            this.target.setNormal(x, y, z);
+            return this;
+        }
+        @Override public VertexConsumer setLineWidth(final float width) { this.target.setLineWidth(width); return this; }
+    }
+}
