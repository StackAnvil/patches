+
+    private static int inputIndex(final NativeUiScene.Node node) {
+        return node.properties().getAsJsonObject("input").get("index").getAsBigDecimal().intValueExact();
+    }
+
+    private void activate(final NativeUiScene.Node node) {
+        switch (this.controller.activate(node)) {
+            case CLOSE -> this.minecraft.setScreenAndShow(null);
+            case STAY -> this.refreshScene();
+            case REPLACED -> { /* The controller transferred focus to another native screen. */ }
+        }
+    }
+
+    private static NativeUiLayout.Box sliderOwner(final NativeUiLayout.Box box, final NativeUiScene.Node target,
+                                                     final NativeUiLayout.Box owner) {
+        final var current = box.node().type().equals("slider") ? box : owner;
+        if (box.node() == target) return current;
+        for (final var child : box.children()) {
+            final var found = sliderOwner(child, target, current);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private void slide(final InputDrag drag, final double x, final double y) {
+        final boolean vertical = drag.owner.node().string("slider_direction", "horizontal").equals("vertical");
+        final float extent = vertical ? drag.owner.bounds().height() : drag.owner.bounds().width();
+        if (extent <= 0) return;
+        this.controller.inputs().slide(drag.index, NativeUiSlider.pointerFraction(drag.owner, x, y));
+        this.refreshScene();
+        this.inputDrag = drag;
+    }
+
+    private void refreshPendingScene() {
+        if (this.refreshPending) this.refreshScene();
+    }
+
+    private void refreshScene() {
+        this.refreshPending = false;
+        try {
+            final List<ControlBox> previousControls = new ArrayList<>();
+            controls(this.root, "", 0, previousControls);
+            final Map<String, NativeUiScene.Node> previousNodes = new HashMap<>();
+            for (final var control : previousControls) previousNodes.put(control.key, control.box.node());
+            final Map<String, Float> offsets = new HashMap<>();
+            this.scrollOffsets(this.scene, "", offsets, false);
+            this.controller.refresh();
+            this.scene = this.controller.root();
+            this.resetAnimations();
+            if (this.renderer != null) this.renderer.reset();
+            this.scroll.clear();
+            this.scrollOffsets(this.scene, "", offsets, true);
+            this.layout();
+            this.reconcileWidgets();
+            final List<ControlBox> currentControls = new ArrayList<>();
+            controls(this.root, "", 0, currentControls);
+            final Map<NativeUiScene.Node, NativeUiScene.Node> replacements = new IdentityHashMap<>();
+            for (final var control : currentControls) {
+                final var previous = previousNodes.get(control.key);
+                if (previous != null) replacements.put(previous, control.box.node());
+            }
+            this.focusHistory.remap(replacements, this.focusTargets());
+        } catch (final RuntimeException error) {
+            this.controller.failed(error);
+        }
+    }
+
+    private void scrollOffsets(final NativeUiScene.Node node, final String parent, final Map<String, Float> offsets,
+                               final boolean restore) {
+        final String key = parent + "/" + node.name();
+        if (node.scroll()) {
+            if (restore) this.scroll.put(node, offsets.getOrDefault(key, 0F));
+            else offsets.put(key, this.scroll.getOrDefault(node, 0F));
+        }
+        for (final var child : node.children()) this.scrollOffsets(child, key, offsets, restore);
+    }
+
+    private record InputDrag(int index, NativeUiLayout.Box owner) {}
+
+    private interface NativeInput {
+        NativeUiScene.Node node();
+        AbstractWidget widget();
+        void place(NativeUiLayout.Box box);
+        void setEditable(boolean editable);
+    }
+
+    private static NativeUiScene.Node inputTextStyle(final NativeUiLayout.Box owner) {
+        final String name = owner.node().string("text_control", "");
+        final var control = name.isEmpty() ? null : NativeUiScroll.descendant(owner, name);
+        return control == null ? owner.node() : control.node();
+    }
+
+    private final class SingleLineInput extends EditBox implements NativeInput {
+        private NativeUiScene.Node node;
+        private NativeUiLayout.Box box;
+
+        SingleLineInput(final NativeUiLayout.Box box) {
+            super(NativeUiSceneScreen.this.font, 0, 0, 1, 1, NativeUiText.component(Action.caption(box.node())));
+            this.node = box.node();
+            final int index = inputIndex(this.node);
+            this.setMaxLength(NativeUiSceneScreen.this.controller.inputs().maxLength(index));
+            this.setBordered(false);
+            this.place(box);
+            this.setValue(NativeUiSceneScreen.this.controller.inputs().text(index));
+            this.setHint(NativeUiText.component(NativeUiSceneScreen.this.controller.inputs().placeholder(index)));
+            this.setResponder(value -> {
+                NativeUiSceneScreen.this.refreshPending |= NativeUiSceneScreen.this.controller.inputs().setText(index, value);
+            });
+        }
+
+        @Override
+        public void place(final NativeUiLayout.Box box) {
+            this.node = box.node();
+            this.box = box;
+            final var bounds = box.bounds();
+            this.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                Math.round(bounds.x()), Math.round(bounds.y()));
+            final var style = inputTextStyle(box);
+            this.setTextColor(NativeUiRenderer.color(style, 1));
+            this.setTextColorUneditable(NativeUiRenderer.color(style, 1));
+            // EditBox calculates horizontal scrolling when its cursor moves, not
+            // when its rectangle changes. Reflow without changing the selection.
+            this.setCursorPosition(this.getCursorPosition());
+        }
+
+        @Override
+        public NativeUiScene.Node node() { return this.node; }
+
+        @Override
+        public AbstractWidget widget() { return this; }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+    }
+
+    private final class MultilineInput extends NativeUiMultilineInput implements NativeInput {
+        private NativeUiLayout.Box box;
+
+        MultilineInput(final NativeUiLayout.Box box) {
+            super(NativeUiSceneScreen.this.font, NativeUiText.component(Action.caption(box.node())),
+                NativeUiSceneScreen.this.controller.inputs().text(inputIndex(box.node())),
+                NativeUiSceneScreen.this.controller.inputs().placeholder(inputIndex(box.node())),
+                NativeUiSceneScreen.this.controller.inputs().maxLength(inputIndex(box.node())),
+                value -> NativeUiSceneScreen.this.refreshPending |=
+                    NativeUiSceneScreen.this.controller.inputs().setText(inputIndex(box.node()), value));
+            this.place(box);
+        }
+
+        @Override
+        public void place(final NativeUiLayout.Box box) {
+            this.box = box;
+            final var style = inputTextStyle(box);
+            this.configure(box.bounds(), NativeUiRenderer.color(style, 1), style.flag("shadow", false));
+        }
+
+        @Override
+        public NativeUiScene.Node node() { return this.box.node(); }
+
+        @Override
+        public AbstractWidget widget() { return this; }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+    }
+
+    private record Drag(NativeUiScene.Node node, float grab) {}
+
+    private final class Action extends AbstractButton {
+        private NativeUiScene.Node node;
+        private NativeUiLayout.Box box;
+        private boolean eligible;
+
+        Action(final NativeUiLayout.Box box) {
+            super(0, 0, 1, 1, NativeUiText.component(caption(box.node())));
+            this.node = box.node();
+            this.place(box);
+        }
+
+        void place(final NativeUiLayout.Box box) {
+            this.node = box.node();
+            this.setMessage(NativeUiText.component(caption(this.node)));
+            final String tooltip = this.node.string("tooltip", "");
+            this.setTooltip(tooltip.isEmpty() ? null : Tooltip.create(NativeUiText.component(tooltip)));
+            this.box = box;
+            final var bounds = box.bounds();
+            this.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                Math.round(bounds.x()), Math.round(bounds.y()));
+        }
+
+        @Override
+        public void onPress(final InputWithModifiers input) {
+            NativeUiSceneScreen.this.activate(this.node);
+        }
+
+        @Override
+        protected void extractContents(final GuiGraphicsExtractor graphics, final int x, final int y, final float delta) {
+            // Native button controls are hit targets. Their authored state children
+            // provide visuals; a control without visual children stays transparent.
+        }
+
+        @Override
+        public ComponentPath nextFocusPath(final FocusNavigationEvent event) {
+            return this.node.flag("focus_enabled", false) ? super.nextFocusPath(event) : null;
+        }
+
+        @Override
+        public boolean isMouseOver(final double x, final double y) {
+            return this.box.visibleBounds().contains(x, y) && super.isMouseOver(x, y);
+        }
+
+        @Override
+        protected void updateWidgetNarration(final NarrationElementOutput output) {
+            this.defaultButtonNarrationText(output);
+        }
+
+        private static String caption(final NativeUiScene.Node node) {
+            final String text = node.string("text", "");
+            if (!text.isEmpty()) return text;
+            for (final var child : node.children()) {
+                final String value = caption(child);
+                if (!value.isEmpty()) return value;
+            }
+            return node.name();
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScissor.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiScissor.java
