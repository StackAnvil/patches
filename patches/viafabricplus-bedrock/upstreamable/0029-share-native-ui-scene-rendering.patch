+
+/** An independent GUI actor perspective over the licensed library and accepted pack overrides. */
+public final class BedrockGuiActorAppearance {
+    private final BedrockResourceLibrary library;
+    private final BedrockActorAnimation.Playback playback;
+    private final BedrockPlayerControllers controllers;
+    private final com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions materials;
+    private final Map<String, BedrockGeometryModel> models = new HashMap<>();
+    private final Map<String, BufferedImage> images = new HashMap<>();
+
+    public static Object resources() throws IOException { return BedrockServerResources.library(); }
+
+    public static BedrockGuiActorAppearance load(final Object resources, final String identifier) throws IOException {
+        return new BedrockGuiActorAppearance((BedrockResourceLibrary) resources, identifier);
+    }
+
+    private BedrockGuiActorAppearance(final BedrockResourceLibrary library, final String identifier) throws IOException {
+        this.library = library;
+        this.materials = library.materials();
+        final var entity = library.entity(identifier);
+        if (entity == null) throw new IOException("Missing native GUI actor " + identifier);
+        final var description = entity.getAsJsonObject("description");
+        this.playback = BedrockActorAnimation.read(description, Map.of(), library).playback();
+        final var document = new JsonObject();
+        final var definitions = new JsonObject();
+        library.definitions("render_controllers", "render_controllers").forEach((name, value) -> definitions.add(name, value.value()));
+        document.add("render_controllers", definitions);
+        final var controllers = new HashMap<String, org.cube.converter.data.bedrock.controller.BedrockRenderController>();
+        BedrockControllerParser.parse(document.toString()).forEach(value -> controllers.put(value.identifier(), value));
+        final var wrapper = new JsonObject();
+        wrapper.add("minecraft:client_entity", entity);
+        this.controllers = new BedrockPlayerControllers(BedrockEntityParser.parse(wrapper.toString()), controllers);
+    }
+
+    public Frame sample(final float seconds, final NativeActorMessage.Snapshot actor, final int variant,
+                        final float pitch, final float yaw) throws IOException {
+        final var input = new com.viaversion.viafabricplus.bedrock.render.BedrockActorFrame(seconds, yaw, 0, 0, -1).input(actor);
+        final var queries = new HashMap<>(input.queries());
+        queries.put("variant", variant);
+        queries.put("is_in_ui", true);
+        queries.put("is_alive", true);
+        queries.put("target_x_rotation", pitch);
+        queries.put("target_y_rotation", yaw);
+        queries.put("modified_move_speed", 0F);
+        queries.put("modified_distance_moved", 0F);
+        final var gui = com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext.current();
+        if (gui == null) throw new IllegalStateException("GUI actor sample has no retained perspective");
+        final var pose = this.playback.sample(seconds, new BedrockActorAnimation.Frame(queries, Map.of()), true, gui::sound, gui::particle);
+        gui.requireSupportedEffects();
+        return new Frame(this.playback.renderControllers(this.controllers), pose, this.playback.visibility(), this.playback.scale());
+    }
+
+    public BedrockGeometryModel model(final String identifier) throws IOException {
+        final var cached = this.models.get(identifier);
+        if (cached != null) return cached;
+        final var definition = this.library.model(identifier);
+        if (definition == null) throw new IOException("Missing native GUI actor geometry " + identifier);
+        final var document = com.viaversion.viaversion.libs.gson.JsonParser.parseString(definition.toString()).getAsJsonObject();
+        final var model = BedrockGeometryModel.fromJson(document).stream().filter(value -> value.getIdentifier().equals(identifier)).findFirst()
+            .orElseThrow(() -> new IOException("Invalid native GUI actor geometry " + identifier));
+        this.models.put(identifier, model);
+        return model;
+    }
+
+    public com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions materials() { return this.materials; }
+    public Object resourceGeneration() { return this.library; }
+
+    public BufferedImage image(final String path) throws IOException {
+        final var cached = this.images.get(path);
+        if (cached != null) return cached;
+        final var image = this.library.image(path);
+        this.images.put(path, image);
+        return image;
+    }
+
+    public record Frame(BedrockPlayerControllers.Selection draws, Map<String, BedrockBoneAnimation.Transform> pose,
+                        BedrockActorAnimation.Visibility visibility, BedrockBoneAnimation.Vector scale) {}
+}
