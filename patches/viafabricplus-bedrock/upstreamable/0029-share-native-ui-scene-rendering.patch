index 0000000..2b63181
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiInput.java
@@ -0,0 +1,248 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Consumer;
+
+/** Native mapping factory fields, event phases, pointer scopes and double-press state. */
+public record NativeUiInput(Options options, List<Mapping> mappings, List<HoverBinding> hoverBindings) {
+    public static NativeUiInput parse(final JsonObject properties) {
+        final List<Mapping> mappings = new ArrayList<>();
+        final List<HoverBinding> hover = new ArrayList<>();
+        boolean wildcard = false;
+        Scope wildcardScope = Scope.DEFAULT;
+        final var entries = properties.get("button_mappings");
+        if (entries != null && entries.isJsonArray()) for (final var value : entries.getAsJsonArray()) {
+            if (!value.isJsonObject()) continue;
+            final var mapping = value.getAsJsonObject();
+            if (flag(mapping, "ignored", false)) continue;
+            final String source = string(mapping, "from_button_id");
+            final String target = string(mapping, "to_button_id");
+            final Kind kind = switch (string(mapping, "mapping_type")) {
+                case "global" -> Kind.GLOBAL;
+                case "double_pressed" -> Kind.DOUBLE_PRESSED;
+                case "focused" -> Kind.FOCUSED;
+                default -> Kind.PRESSED;
+            };
+            final Scope scope = switch (string(mapping, "scope")) {
+                case "view" -> Scope.VIEW;
+                case "global" -> Scope.GLOBAL;
+                default -> Scope.DEFAULT;
+            };
+            if (source.equals("any")) {
+                wildcard = true;
+                wildcardScope = scope;
+            } else if (source.isEmpty() || target.isEmpty()) {
+                if (source.isEmpty() && !target.isEmpty() && kind == Kind.PRESSED) hover.add(new HoverBinding(symbol(target), scope));
+            } else {
+                final Condition condition = switch (string(mapping, "input_mode_condition")) {
+                    case "not_gamepad" -> Condition.NOT_GAMEPAD;
+                    case "gamepad" -> Condition.GAMEPAD;
+                    default -> Condition.ANY;
+                };
+                mappings.add(new Mapping(symbol(source), symbol(target), kind, scope,
+                    flag(mapping, "button_up_right_of_first_refusal", false), flag(mapping, "handle_select", true),
+                    flag(mapping, "handle_deselect", true), flag(mapping, "alternate_input_scope", false),
+                    flag(mapping, "consume_event", true), condition, flag(mapping, "ignore_input_scope", false)));
+            }
+        }
+        final var options = new Options(wildcardScope, flag(properties, "always_handle_pointer", false),
+            flag(properties, "always_handle_controller_direction", false), wildcard,
+            flag(properties, "always_listen_to_input", false), flag(properties, "modal", false),
+            flag(properties, "inline_modal", false), flag(properties, "hover_enabled", true),
+            flag(properties, "consume_hover_events", true), flag(properties, "prevent_touch_input", false),
+            flag(properties, "gamepad_deflection_mode", false));
+        return new NativeUiInput(options, List.copyOf(mappings), List.copyOf(hover));
+    }
+
+    private static String string(final JsonObject properties, final String key) {
+        final var value = properties.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+    }
+
+    private static boolean flag(final JsonObject properties, final String key, final boolean fallback) {
+        return NativeUiScene.flag(properties, key, fallback);
+    }
+
+    public static int symbol(final String value) {
+        int result = 0x811c9dc5;
+        for (final byte octet : value.getBytes(StandardCharsets.UTF_8)) result = (result ^ Byte.toUnsignedInt(octet)) * 0x01000193;
+        return result;
+    }
+
+    public static final class State {
+        private final NativeUiInput definition;
+        private final int[] phases;
+        private final java.util.Map<Integer, PressHistory> presses = new java.util.HashMap<>();
+
+        public State(final NativeUiInput definition) {
+            this.definition = definition;
+            this.phases = new int[definition.mappings.size()];
+        }
+
+        public int phase(final int index) { return this.phases[index]; }
+
+        /** Visibility callbacks and input-order removal preserve double-press history. */
+        public void invalidateMappings() { java.util.Arrays.fill(this.phases, 2); }
+
+        /** Dispatches an Input component without sibling event handlers. */
+        public Dispatch dispatch(final int source, final int phase, final Context context) {
+            return this.dispatch(source, phase, context, _ -> { });
+        }
+
+        /** Sibling components run before the sender commits its accepted mapping phase. */
+        public Dispatch dispatch(final int source, final int phase, final Context context, final Consumer<ButtonEvent> handler) {
+            final List<ButtonEvent> events = new ArrayList<>();
+            int result = 0;
+            if (this.definition.options.wildcard) {
+                final var event = event(source, source, 2, phase, context.mode, this.definition.options.wildcardScope, false, false);
+                handler.accept(event);
+                events.add(event);
+                result = 1;
+            }
+            final boolean doubled = this.doublePress(source, phase, context);
+            for (int index = 0; index < this.definition.mappings.size(); index++) {
+                final var mapping = this.definition.mappings.get(index);
+                if (mapping.source != source || doubled != (mapping.kind == Kind.DOUBLE_PRESSED || context.touchFallback)) continue;
+                final boolean condition = mapping.condition != Condition.NOT_GAMEPAD || context.mode != 3;
+                final boolean gamepad = mapping.condition != Condition.GAMEPAD || context.mode == 3;
+                final boolean ordinary = !doubled || context.touchFallback;
+                final boolean admitted = condition && gamepad && switch (mapping.kind) {
+                    case GLOBAL -> true;
+                    case FOCUSED -> (context.flags & 0x82) != 0;
+                    case PRESSED -> ordinary && this.pointer(mapping, phase, this.phases[index], context);
+                    case DOUBLE_PRESSED -> !ordinary && this.pointer(mapping, phase, this.phases[index], context);
+                };
+                if (!admitted) { this.phases[index] = 2; result = 0; continue; }
+                final int previous = this.phases[index];
+                final var event = event(mapping.source, mapping.target, previous, phase, context.mode,
+                    mapping.scope, mapping.handleSelect, mapping.handleDeselect);
+                handler.accept(event);
+                events.add(event);
+                this.phases[index] = phase;
+                if ((context.handlerMask & 1) == 0) result = mapping.consume ? 1 : 2;
+                return new Dispatch(result, List.copyOf(events), phase == 1 && mapping.firstRefusal ? List.of(source) : List.of());
+            }
+            return new Dispatch(result, List.copyOf(events), List.of());
+        }
+
+        /** The caller supplies geometry/control admission; hover_enabled is checked by the native pointer entry, not this handler. */
+        public Hover hover(final boolean previous, final boolean inside, final boolean forcedOut, final int handlerMask) {
+            final boolean hovered = !forcedOut && inside;
+            final boolean changed = previous != hovered;
+            final List<ButtonEvent> events = new ArrayList<>();
+            if (changed) for (final var binding : this.definition.hoverBindings) {
+                events.add(new ButtonEvent(0, binding.target, 0, hovered ? 1 : 0, false, 0, binding.scope, false, false));
+            }
+            final boolean handled = hovered && (!changed || (handlerMask & 1) == 0);
+            return new Hover(forcedOut || handled && this.definition.options.consumeHoverEvents ? 1 : 0,
+                hovered, changed, List.copyOf(events));
+        }
+
+        public Pointer pointer(final boolean previous, final boolean inside, final boolean forcedOut, final int handlerMask) {
+            if (!this.definition.options.hoverEnabled) return new Pointer(0, new Hover(0, previous, false, List.of()), false);
+            final Hover hover = this.hover(previous, inside, forcedOut, handlerMask);
+            final boolean deliverPointer = !forcedOut || this.definition.options.alwaysHandlePointer;
+            return new Pointer(deliverPointer && (handlerMask & 1) != 0 ? 0 : hover.result, hover, deliverPointer);
+        }
+
+        public void suppress(final int source, final int phase, final Context context) {
+            final boolean doubled = this.doublePress(source, phase, context);
+            for (int index = 0; index < this.definition.mappings.size(); index++) {
+                final var mapping = this.definition.mappings.get(index);
+                if (mapping.source == source && doubled == (mapping.kind == Kind.DOUBLE_PRESSED || context.touchFallback)) this.phases[index] = 2;
+            }
+        }
+
+        private boolean pointer(final Mapping mapping, final int phase, final int previous, final Context context) {
+            if (mapping.ignoreScope && (context.flags & 0x20) != 0) return true;
+            final boolean admitted = mapping.alternateScope ? context.insideAlternate
+                : (context.flags & 2) != 0 || this.definition.options.alwaysListenToInput && context.inside;
+            return admitted && (context.mode == 3 || context.insideClip) || phase == 0 && mapping.firstRefusal && previous == 1;
+        }
+
+        private boolean doublePress(final int source, final int phase, final Context context) {
+            if (!context.touchFallback && this.definition.mappings.stream().noneMatch(mapping -> mapping.source == source && mapping.kind == Kind.DOUBLE_PRESSED)) return false;
+            final var history = this.presses.computeIfAbsent(source, key -> new PressHistory());
+            if (phase != 1) {
+                if (history.phase != 2) return false;
+                if (phase == 0) history.phase = 0;
+                return true;
+            }
+            final float dx = context.x - history.x, dy = context.y - history.y;
+            final float distance = (float) Math.sqrt(dx * dx + dy * dy);
+            final boolean doubled = history.phase != 0 && context.nanos - history.nanos <= 499_999_999L && distance < 10F;
+            history.phase = doubled ? 2 : 1;
+            history.nanos = context.nanos;
+            history.x = context.x;
+            history.y = context.y;
+            return doubled;
+        }
+
+        private static ButtonEvent event(final int source, final int target, final int previous, final int phase,
+                                         final int mode, final Scope scope, final boolean select, final boolean deselect) {
+            final int activation = mode == 2 ? 0 : 1;
+            return new ButtonEvent(source, target, previous, phase, phase == activation && previous != activation,
+                mode, scope, select, deselect);
+        }
+
+        private static final class PressHistory {
+            private int phase;
+            private long nanos;
+            private float x;
+            private float y;
+        }
+    }
+
+    public record Bounds(float x, float y, float width, float height) {
+        public boolean contains(final float pointX, final float pointY) {
+            return pointX >= this.x && pointX <= this.x + this.width && pointY >= this.y && pointY <= this.y + this.height;
+        }
+    }
+
+    public record Ancestor(Bounds bounds, boolean clip, boolean scroll, Bounds alternateTrack) {}
+
+    /** Ancestors are supplied nearest first; native input tests only the nearest clipping ancestor. */
+    public record Geometry(Bounds bounds, List<Ancestor> ancestors) {
+        public boolean insideClip(final float x, final float y) {
+            for (final var parent : this.ancestors) if (parent.clip) return parent.bounds.contains(x, y);
+            return true;
+        }
+
+        public boolean insideAlternate(final int flags, final float x, final float y) {
+            if (this.ancestors.isEmpty()) return false;
+            final var parent = this.ancestors.getFirst();
+            if (parent.scroll && (parent.alternateTrack == null || !parent.alternateTrack.contains(x, y))) return false;
+            return (flags & 0xc) != 0xc || !this.bounds.contains(x, y);
+        }
+    }
+
+    public record Context(int flags, int mode, float x, float y, boolean inside, boolean insideClip,
+                          boolean insideAlternate, boolean touchFallback, long nanos, int handlerMask) {}
+
+    /** Retains the native raw phase; only phase one is a pressed controller event. */
+    public record ButtonEvent(int source, int target, int previous, int phase, boolean transition, int mode,
+                              Scope scope, boolean handleSelect, boolean handleDeselect) {
+        public boolean pressed() { return this.phase == 1; }
+    }
+    public record Dispatch(int result, List<ButtonEvent> events, List<Integer> captureRequests) {}
+    public record Hover(int result, boolean hovered, boolean changed, List<ButtonEvent> events) {}
+    public record Pointer(int result, Hover hover, boolean pointerEvent) {}
+
+    public record Options(Scope wildcardScope, boolean alwaysHandlePointer, boolean alwaysHandleControllerDirection,
+                          boolean wildcard, boolean alwaysListenToInput, boolean modal, boolean inlineModal,
+                          boolean hoverEnabled, boolean consumeHoverEvents, boolean preventTouchInput, boolean gamepadDeflectionMode) {}
+    public record Mapping(int source, int target, Kind kind, Scope scope, boolean firstRefusal, boolean handleSelect,
+                          boolean handleDeselect, boolean alternateScope, boolean consume, Condition condition, boolean ignoreScope) {}
+    public record HoverBinding(int target, Scope scope) {}
+    public enum Kind { GLOBAL, DOUBLE_PRESSED, PRESSED, FOCUSED }
+    public enum Scope { DEFAULT, VIEW, GLOBAL }
+    public enum Condition { ANY, NOT_GAMEPAD, GAMEPAD }
+}
