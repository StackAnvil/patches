+    // MultilineTextField uses the target client's nine-pixel line spacing for pointer navigation.
+    private static final int LINE_HEIGHT = 9;
+    private final Font font;
+    private final String placeholder;
+    private final int maximumLength;
+    private final Consumer<String> responder;
+    private TextField text;
+    private int layoutWidth;
+    private String lastValue;
+    private int textColor = 0xFFFFFFFF;
+    private boolean shadow;
+    private boolean editable = true;
+    private double scroll;
+    private long focusedTime;
+    private IMEPreeditOverlay preedit;
+
+    NativeUiMultilineInput(final Font font, final Component caption, final String value, final String placeholder,
+                           final int maximumLength, final Consumer<String> responder) {
+        super(0, 0, 1, 1, caption);
+        this.font = font;
+        this.placeholder = placeholder;
+        this.maximumLength = maximumLength;
+        this.responder = responder;
+        this.text = this.field(1, value);
+        this.layoutWidth = 1;
+        this.listen();
+    }
+
+    private TextField field(final int width, final String value) {
+        final var result = new TextField(this.font, width);
+        result.setCharacterLimit(this.maximumLength);
+        result.setValue(value);
+        return result;
+    }
+
+    private void listen() {
+        this.lastValue = this.text.value();
+        this.text.setValueListener(value -> {
+            if (!value.equals(this.lastValue)) {
+                this.lastValue = value;
+                this.responder.accept(value);
+            }
+        });
+        this.text.setCursorListener(this::revealCursor);
+    }
+
+    final void configure(final NativeUiLayout.Rect bounds, final int color, final boolean shadow) {
+        final int width = Math.max(1, Math.round(bounds.width()));
+        this.setRectangle(width, Math.max(1, Math.round(bounds.height())), Math.round(bounds.x()), Math.round(bounds.y()));
+        this.textColor = color;
+        this.shadow = shadow;
+        if (width != this.layoutWidth) {
+            final int cursor = this.text.cursor();
+            final var selection = this.text.selection();
+            final int anchor = cursor == selection.start() ? selection.end() : selection.start();
+            this.text = this.field(width, this.text.value());
+            this.text.seekCursor(Whence.ABSOLUTE, anchor);
+            this.text.setSelecting(true);
+            this.text.seekCursor(Whence.ABSOLUTE, cursor);
+            this.text.setSelecting(false);
+            this.layoutWidth = width;
+            this.listen();
+        }
+        this.scroll = Math.clamp(this.scroll, 0, this.maximumScroll());
+        if (this.isFocused()) this.revealCursor();
+    }
+
+    public final void setEditable(final boolean editable) {
+        final boolean changed = this.editable != editable;
+        this.editable = editable;
+        if (!editable) this.preedit = null;
+        if (changed && this.isFocused()) Minecraft.getInstance().onTextInputFocusChange(this, this.capturesInput());
+    }
+
+    final String value() { return this.text.value(); }
+    final int cursor() { return this.text.cursor(); }
+    final String selectedText() { return this.text.getSelectedText(); }
+
+    private double maximumScroll() {
+        return Math.max(0, this.text.getLineCount() * LINE_HEIGHT - this.height);
+    }
+
+    private void revealCursor() {
+        final double top = this.text.getLineAtCursor() * LINE_HEIGHT;
+        if (top < this.scroll) this.scroll = top;
+        else if (top + LINE_HEIGHT > this.scroll + this.height) this.scroll = top + LINE_HEIGHT - this.height;
+        this.scroll = Math.clamp(this.scroll, 0, this.maximumScroll());
+        this.focusedTime = Util.getMillis();
+    }
+
+    @Override
+    public void setFocused(final boolean focused) {
+        final boolean changed = this.isFocused() != focused;
+        super.setFocused(focused);
+        if (changed) {
+            this.preedit = null;
+            if (focused) this.revealCursor();
+            Minecraft.getInstance().onTextInputFocusChange(this, focused);
+        }
+    }
+
+    @Override
+    public boolean capturesInput() {
+        return this.visible && this.active && this.editable && this.isFocused();
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        return this.capturesInput() && this.text.keyPressed(event);
+    }
+
+    @Override
+    public boolean charTyped(final CharacterEvent event) {
+        if (!this.capturesInput() || !event.isAllowedChatCharacter()) return false;
+        this.text.insertText(event.codepointAsString());
+        return true;
+    }
+
+    @Override
+    public boolean preeditUpdated(final PreeditEvent event) {
+        if (!this.capturesInput()) return false;
+        this.preedit = event == null ? null : new IMEPreeditOverlay(event, this.font, LINE_HEIGHT + 1);
+        return true;
+    }
+
+    @Override
+    public void onClick(final MouseButtonEvent event, final boolean doubleClick) {
+        if (!this.editable) return;
+        if (doubleClick) this.text.selectWordAtCursor();
+        else {
+            this.text.setSelecting(event.hasShiftDown());
+            this.seek(event);
+        }
+    }
+
+    @Override
+    protected void onDrag(final MouseButtonEvent event, final double deltaX, final double deltaY) {
+        if (!this.capturesInput()) return;
+        this.text.setSelecting(true);
+        this.seek(event);
+        this.text.setSelecting(event.hasShiftDown());
+    }
+
+    private void seek(final MouseButtonEvent event) {
+        this.text.seekCursorToPoint(event.x() - this.getX(), event.y() - this.getY() + this.scroll);
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        if (!this.active || !this.visible || !this.isMouseOver(x, y) || vertical == 0) return false;
+        final double previous = this.scroll;
+        this.scroll = Math.clamp(previous - vertical * LINE_HEIGHT, 0, this.maximumScroll());
+        return this.scroll != previous;
+    }
+
+    @Override
+    public void playDownSound(final SoundManager sounds) {
+        // Editing text does not play a button activation sound.
+    }
+
+    @Override
+    protected void extractWidgetRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY,
+                                            final float delta) {
+        graphics.enableScissor(this.getX(), this.getY(), this.getRight(), this.getBottom());
+        try {
+            final int color = Math.round(this.alpha * (this.textColor >>> 24)) << 24 | this.textColor & 0xFFFFFF;
+            final String value = this.text.value();
+            final int cursorLine = this.text.getLineAtCursor();
+            final var cursorView = this.text.line(cursorLine);
+            final int cursorX = this.getX() + this.font.width(value.substring(cursorView.start(), this.text.cursor()));
+            final int cursorY = this.getY() + cursorLine * LINE_HEIGHT - (int) this.scroll;
+            if (value.isEmpty() && !this.isFocused()) {
+                graphics.textWithWordWrap(this.font, NativeUiText.component(this.placeholder), this.getX(), this.getY(),
+                    this.width, color);
+            } else {
+                final var selected = this.text.selection();
+                int y = this.getY() - (int) this.scroll;
+                for (final var line : this.text.lines()) {
+                    if (y + LINE_HEIGHT > this.getY() && y < this.getBottom()) {
+                        graphics.text(this.font, value.substring(line.start(), line.end()), this.getX(), y, color, this.shadow);
+                        final int start = Math.max(line.start(), selected.start());
+                        final int end = Math.min(line.end(), selected.end());
+                        if (start < end || selected.start() <= line.end() && selected.end() > line.end()) {
+                            final int left = this.getX() + this.font.width(value.substring(line.start(), start));
+                            final int right = selected.end() > line.end() ? this.getRight()
+                                : this.getX() + this.font.width(value.substring(line.start(), end));
+                            graphics.textHighlight(left, y, right, y + LINE_HEIGHT, true);
+                        }
+                    }
+                    y += LINE_HEIGHT;
+                }
+            }
+            if (this.capturesInput()) {
+                if (TextCursorUtils.isCursorVisible(Util.getMillis() - this.focusedTime))
+                    TextCursorUtils.extractInsertCursor(graphics, cursorX, cursorY, color, LINE_HEIGHT);
+                if (this.preedit == null)
+                    Minecraft.getInstance().textInputManager().setTextInputArea(cursorX, cursorY, cursorX + 1, cursorY + LINE_HEIGHT + 1);
+                else {
+                    this.preedit.updateInputPosition(cursorX, cursorY);
+                    graphics.setPreeditOverlay(this.preedit);
+                }
+            }
+            if (this.isHovered() && this.active && this.editable) graphics.requestCursor(CursorTypes.IBEAM);
+        } finally {
+            graphics.disableScissor();
+        }
+    }
+
+    private record Range(int start, int end) {}
+
+    /** Exposes the protected line spans to the authored renderer without changing editing behavior. */
+    private static final class TextField extends MultilineTextField {
+        TextField(final Font font, final int width) { super(font, width); }
+
+        Range selection() {
+            final var selected = this.getSelected();
+            return new Range(selected.beginIndex(), selected.endIndex());
+        }
+
+        Range line(final int index) {
+            final var line = this.getLineView(index);
+            return new Range(line.beginIndex(), line.endIndex());
+        }
+
+        List<Range> lines() {
+            final List<Range> lines = new ArrayList<>();
+            for (final var line : this.iterateLines()) lines.add(new Range(line.beginIndex(), line.endIndex()));
+            return lines;
+        }
+    }
+
+    @Override
+    protected void updateWidgetNarration(final NarrationElementOutput narration) {
+        narration.add(NarratedElementType.TITLE, Component.translatable("gui.narrate.editBox", this.getMessage(), this.value()));
+    }
+}
