+            final JsonObject manifest;
+            try { manifest = json(resource(ROOT + ".manifest.json", 8192)); }
+            catch (final RuntimeException failure) { throw new IOException("Invalid OreUI bundle identity", failure); }
+            bundled = read(archive, manifest);
