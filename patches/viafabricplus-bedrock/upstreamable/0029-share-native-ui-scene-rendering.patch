+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+/** Applies authored animation destruction to the resolved control tree. */
+public final class NativeUiAnimationLifecycle {
+    private NativeUiScene.Node root;
+    private final NativeUiAnimations animations;
+    private final Map<NativeUiScene.Node, List<NativeUiScene.Node>> paths = new IdentityHashMap<>();
+    private final Set<NativeUiScene.Node> destroyed = Collections.newSetFromMap(new IdentityHashMap<>());
+
+    public NativeUiAnimationLifecycle(final NativeUiScene.Node root) {
+        this.root = root;
+        collect(root, List.of());
+        this.animations = new NativeUiAnimations((node, name) -> {
+            final var control = target(this.paths.get(node), name);
+            if (control == null) return false;
+            control.properties().addProperty("ignored", true);
+            this.destroyed.add(control);
+            return true;
+        });
+    }
+
+    public void advance(final long elapsedNanos) {
+        this.animations.advance(this.root, elapsedNanos);
+    }
+
+    public NativeUiAnimations animations() { return this.animations; }
+
+    /** Binding refreshes retain control clocks; new controls start at the refresh time. */
+    public void replaceRoot(final NativeUiScene.Node root, final long elapsedNanos) {
+        this.advance(elapsedNanos);
+        final Map<List<Identity>, NativeUiScene.Node> previous = new HashMap<>(), current = new HashMap<>();
+        index(this.root, List.of(), 0, previous);
+        index(root, List.of(), 0, current);
+        final Map<NativeUiScene.Node, NativeUiScene.Node> replacements = new IdentityHashMap<>();
+        final Set<NativeUiScene.Node> retainedDestroyed = Collections.newSetFromMap(new IdentityHashMap<>());
+        for (final var control : current.entrySet()) {
+            final var old = previous.get(control.getKey());
+            final var node = control.getValue();
+            if (old != null && this.destroyed.contains(old)
+                && Objects.equals(old.properties().get("animation_program"), node.properties().get("animation_program"))) {
+                node.properties().addProperty("ignored", true);
+                retainedDestroyed.add(node);
+            }
+            // New controls have no old identity. Each replacement still needs its own clock entry.
+            replacements.put(old == null ? node : old, node);
+        }
+        this.animations.reconcile(replacements, elapsedNanos);
+        this.destroyed.clear();
+        this.destroyed.addAll(retainedDestroyed);
+        this.root = root;
+        this.paths.clear();
+        collect(root, List.of());
+    }
+
+    private static void index(final NativeUiScene.Node node, final List<Identity> ancestors, final int occurrence,
+                              final Map<List<Identity>, NativeUiScene.Node> controls) {
+        final var path = new ArrayList<>(ancestors);
+        path.add(identity(node, occurrence));
+        controls.put(List.copyOf(path), node);
+        final Map<Identity, Integer> occurrences = new HashMap<>();
+        for (final var child : node.children()) {
+            final int index = occurrences.merge(identity(child, 0), 1, Integer::sum) - 1;
+            index(child, path, index, controls);
+        }
+    }
+
+    private static Identity identity(final NativeUiScene.Node node, final int occurrence) {
+        return new Identity(node.name(), node.type(), String.valueOf(node.properties().get("inventory_slot")),
+            String.valueOf(node.properties().get("collection")), occurrence);
+    }
+
+    private record Identity(String name, String type, String slot, String collection, int occurrence) {}
+
+    boolean active() { return active(this.root); }
+
+    private static boolean active(final NativeUiScene.Node node) {
+        if (node.flag("ignored", false) || !node.flag("visible", true)) return false;
+        if (!node.string("factory_name", "").isEmpty()) return node.children().stream().anyMatch(NativeUiAnimationLifecycle::visible);
+        return node.children().isEmpty() || node.children().stream().anyMatch(NativeUiAnimationLifecycle::active);
+    }
+
+    private static boolean visible(final NativeUiScene.Node node) {
+        return !node.flag("ignored", false) && node.flag("visible", true);
+    }
+
+    private void collect(final NativeUiScene.Node node, final List<NativeUiScene.Node> ancestors) {
+        final var path = new ArrayList<>(ancestors);
+        path.add(node);
+        this.paths.put(node, List.copyOf(path));
+        for (final var child : node.children()) collect(child, path);
+    }
+
+    private static NativeUiScene.Node target(final List<NativeUiScene.Node> path, final String name) {
+        for (int i = path.size() - 1; i >= 0; i--) {
+            final var node = path.get(i);
+            if (matches(node, name)) return node;
+        }
+        for (int i = path.size() - 1; i >= 0; i--) {
+            final var found = descendant(path.get(i), name);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private static NativeUiScene.Node descendant(final NativeUiScene.Node node, final String name) {
+        if (matches(node, name)) return node;
+        for (final var child : node.children()) {
+            final var found = descendant(child, name);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private static boolean matches(final NativeUiScene.Node node, final String name) {
+        return node.name().equals(name) || node.name().endsWith("." + name);
+    }
+}
