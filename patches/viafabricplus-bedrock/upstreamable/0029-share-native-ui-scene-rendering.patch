+        assertTrue(BedrockBitmapFont.ownsUnicode(Identifier.fromNamespaceAndPath("viabedrock", "font/glyph_00.png")));
+        assertFalse(BedrockBitmapFont.ownsUnicode(Identifier.fromNamespaceAndPath("server", "font/glyph_00.png")));
+        assertFalse(BedrockBitmapFont.ownsUnicode(Identifier.fromNamespaceAndPath("viabedrock", "font/bedrock_bitmap/default8_0.png")));
+    }
+
+    @Test
