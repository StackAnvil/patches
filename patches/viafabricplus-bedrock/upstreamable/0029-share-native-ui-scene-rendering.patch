+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.render.BedrockGuiActorContext;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+import net.minecraft.client.renderer.entity.state.AvatarRenderState;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+final class NativeUiPlayerCameraTest {
+    private static final NativeUiPlayerCamera.Rotation ROTATION = new NativeUiPlayerCamera.Rotation(37, 41, 7, 11, 23, 29);
+
+    @Test
+    void projectsTheOriginalStandingAndGlidingMatricesAcrossClipsAndGuiScales() {
+        final var control = new NativeUiLayout.Rect(10, 20, 30, 30);
+        final float[][] matrices = {
+            {30, -2.6226833e-6F, 0, 0, -2.447944e-6F, -28.001217F, .35890564F, 0,
+                9.412958e-7F, 10.767169F, .93337387F, 0, 25, 35, -990, 1},
+            {18, -1.5497033e-6F, -2.732545e-7F, 0, -1.57361e-6F, -17.72654F, -3.125667F, 0,
+                0, -.17364818F, .98480773F, 0, 25, 50, -990, 1}
+        };
+        for (int index = 0; index < matrices.length; index++) {
+            for (final var viewport : List.of(new NativeUiLayout.Rect(0, 0, 400, 300),
+                    new NativeUiLayout.Rect(8, 12, 80, 100), new NativeUiLayout.Rect(20, 30, 10, 10))) {
+                final var camera = NativeUiPlayerCamera.resolve(control, viewport, 0, properties(true),
+                        new NativeUiPlayerCamera.Cursor(80, 105), ROTATION, index == 1, false, false);
+                project(camera, viewport, new Matrix4f().set(matrices[index]));
+            }
+        }
+    }
+
+    @Test
+    void retainsIndependentGuiRotationsAndClearsThePlayerTransformForHorseFrames() {
+        final var context = new BedrockGuiActorContext(UUID.randomUUID(), UUID.randomUUID());
+        final var camera = NativeUiPlayerCamera.resolve(new NativeUiLayout.Rect(10, 20, 30, 30),
+                new NativeUiLayout.Rect(0, 0, 400, 300), 0, properties(true),
+                new NativeUiPlayerCamera.Cursor(80, 105), ROTATION, false, false, false);
+        context.pose(camera.pitch(), camera.yaw(), camera.bodyYaw(), camera.headYaw(), camera.modelTransform());
+        final var state = new AvatarRenderState();
+        context.scoped(() -> { BedrockGuiActorContext.extracted(state); return null; });
+        assertEquals(21.033003F, state.xRot, .00001F);
+        assertEquals(-18.84F, state.yRot, .00001F);
+        assertEquals(-18.84F, state.bodyRot, .00001F);
+        assertEquals(-37.68F, context.yaw(), .00001F);
+        context.camera(5, 9);
+        context.scoped(() -> { BedrockGuiActorContext.extracted(state); return null; });
+        assertEquals(5, state.xRot);
+        assertEquals(0, state.yRot);
+        assertEquals(9, state.bodyRot);
+        final var pose = new PoseStack();
+        context.transform(pose);
+        assertEquals(new Matrix4f(), pose.last().pose());
+        context.close();
+        assertNull(BedrockGuiActorContext.frame(state));
+    }
+
+    @Test
+    void matchesTheOriginalPlayerRendererReference() throws Exception {
+        final String fixture = System.getenv("STACKANVIL_NATIVE_PLAYER_RENDERER_FIXTURE");
+        assumeTrue(fixture != null);
+        final var rows = JsonParser.parseString(Files.readString(Path.of(fixture))).getAsJsonObject().getAsJsonArray("rows");
+        assertEquals(672, rows.size());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var rect = row.getAsJsonArray("rect");
+            final var control = new NativeUiLayout.Rect(rect.get(0).getAsFloat(), rect.get(1).getAsFloat(),
+                    rect.get(2).getAsFloat(), rect.get(3).getAsFloat());
+            final var viewport = new NativeUiLayout.Rect(0, 0, 400, 300);
+            final var cursorData = row.getAsJsonObject("cursor");
+            NativeUiPlayerCamera.Cursor cursor = null;
+            if (row.get("mode").getAsInt() == 1) {
+                final var mouse = row.getAsJsonArray("mouse");
+                final float scale = row.get("guiScale").getAsFloat();
+                cursor = new NativeUiPlayerCamera.Cursor(mouse.get(0).getAsFloat() * scale, mouse.get(1).getAsFloat() * scale);
+            } else if (cursorData.get("present").getAsBoolean()
+                    && (cursorData.get("firstAdmission").getAsBoolean() || cursorData.get("secondAdmission").getAsBoolean())) {
+                final var point = cursorData.getAsJsonArray("position");
+                cursor = new NativeUiPlayerCamera.Cursor(point.get(0).getAsFloat(), point.get(1).getAsFloat());
+            }
+            final String pose = row.get("pose").getAsString();
+            final var camera = NativeUiPlayerCamera.resolve(control, viewport, 0,
+                    properties(!row.get("lookAtCursor").isJsonNull() && row.get("lookAtCursor").getAsBoolean()), cursor,
+                    ROTATION, pose.contains("glid"), pose.contains("swim"), pose.contains("crawl"));
+            final var result = row.getAsJsonObject("result");
+            final var actor = result.getAsJsonArray("actorRotation");
+            assertEquals(actor.get(0).getAsFloat(), camera.pitch(), .00001F);
+            assertEquals(actor.get(1).getAsFloat(), camera.yaw(), .00001F);
+            assertEquals(result.getAsJsonArray("bodyYaw").get(0).getAsFloat(), camera.bodyYaw(), .00001F);
+            if (row.get("headYawComponentPresent").getAsBoolean())
+                assertEquals(result.getAsJsonArray("headYaw").get(0).getAsFloat(), camera.headYaw(), .00001F);
+            final float[] matrix = new float[16];
+            for (int index = 0; index < matrix.length; index++) matrix[index] = result.getAsJsonArray("model").get(index).getAsFloat();
+            project(camera, viewport, new Matrix4f().set(matrix));
+        }
+    }
+
+    private static void project(final NativeUiPlayerCamera camera, final NativeUiLayout.Rect viewport, final Matrix4f nativeMatrix) {
+        for (final int scale : new int[] {1, 2, 4}) {
+            final var pose = new PoseStack();
+            pose.translate((viewport.x() + viewport.width() * .5F) * scale, (viewport.y() + viewport.height() * .5F) * scale, 0);
+            pose.scale(camera.scale() * scale, camera.scale() * scale, -camera.scale() * scale);
+            BedrockGuiActorContext.correctPose(pose, camera.scale(), scale);
+            final var translation = camera.translation(1);
+            pose.translate(translation.x, translation.y, translation.z);
+            pose.mulPose(camera.modelTransform());
+            for (final var point : List.of(new Vector3f(), new Vector3f(.3F, .9F, -.4F), new Vector3f(-.58F, 2.21F, .51F))) {
+                final var expected = nativeMatrix.transformPosition(new Vector3f(point).add(0, -1.501F * .9375F, 0));
+                final var actual = pose.last().pose().transformPosition(new Vector3f(point));
+                assertEquals(expected.x * scale, actual.x, .002F);
+                assertEquals(expected.y * scale, actual.y, .002F);
+                assertEquals(expected.z, actual.z, .001F);
+            }
+        }
+    }
+
+    private static JsonObject properties(final boolean look) {
+        final var properties = new JsonObject();
+        final var bag = new JsonObject();
+        bag.addProperty("#look_at_cursor", look);
+        properties.add("property_bag", bag);
+        return properties;
+    }
+}
