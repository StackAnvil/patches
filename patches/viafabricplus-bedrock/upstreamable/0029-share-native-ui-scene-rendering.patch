@@ -0,0 +1,27 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+uniform sampler2D Sampler0;
+layout(location = 0) in vec4 nativeTint;
+layout(location = 1) in vec2 glyphUv;
+layout(location = 2) in float coverageRatio;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    float coverage = texture(Sampler0, glyphUv).r;
+#ifdef OREUI_SDF
+    float distance = (0.501960813999176 / coverageRatio - 3.984375) + coverage * 7.96875;
+    coverage = clamp((coverageRatio * 0.9960936903953552) * distance, 0.0, 1.0);
+    coverage = (coverage * coverage) * (3.0 - coverage * 2.0);
+#endif
+    float luminance = (nativeTint.r * 0.2125999927520752 + nativeTint.g * 0.7152000069618225)
+        + nativeTint.b * 0.0722000002861023;
+#ifdef OREUI_LINEAR_TINT
+    luminance = luminance > 0.0031308000907301903
+        ? exp2(log2(luminance) * 0.4166666567325592) * 1.0549999475479126 - 0.054999999701976776
+        : luminance * 12.920000076293945;
+#endif
+    float exponent = max(abs(1.4500000476837158 - luminance), 0.00009999999747378752);
+    coverage = coverage == 0.0 ? 0.0 : exp2(log2(abs(coverage)) * exponent);
+    fragColor = nativeTint * coverage;
+}
