+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiImageRegionsTest {
+    @Test
+    void ordinaryImagesPreserveSourceRatioByDefaultAndPermitAuthoredStretching() {
+        final JsonObject image = new JsonObject();
+        final var node = new NativeUiScene.Node("image", "image", image, List.of(), -1);
+        final var bounds = new NativeUiLayout.Rect(100, 200, 66, 21);
+        final var fitted = NativeUiImageRegions.regions(node, bounds, 360, 94).getFirst();
