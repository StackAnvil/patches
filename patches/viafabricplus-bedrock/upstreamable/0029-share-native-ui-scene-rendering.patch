+
+    @ParameterizedTest
+    @EnumSource(NativeUiController.Activation.class)
+    void preservesDomainActionIndicesAndDoesNotCloseAReplacementScreen(final NativeUiController.Activation activation) throws Exception {
+        final var controller = new Controller(activation);
+        withScreen(controller, (game, screen) -> {
+            assertEquals(3, screen.children().size());
+            final var selected = screen.getChildAt(10, 40).orElseThrow();
+            assertTrue(screen.mouseClicked(event(10, 40), false));
+            assertEquals(List.of(177), controller.responses);
+            if (activation == NativeUiController.Activation.CLOSE) verify(game).setScreenAndShow(null);
+            else verify(game, never()).setScreenAndShow(any());
+            assertEquals(activation == NativeUiController.Activation.STAY ? 1 : 0, controller.refreshes);
+            if (activation == NativeUiController.Activation.STAY)
+                assertSame(selected, screen.getChildAt(10, 40).orElseThrow());
+            assertEquals(0, controller.cancels);
+            assertTrue(controller.validated.stream().anyMatch(node -> node.action() == 177));
+        });
+    }
+
+    @Test
+    void overlappingActionsFollowTheSameNestedLayerOrderAsTheirDraws() throws Exception {
+        for (final boolean reversed : new boolean[]{false, true}) {
+            final var background = control("button", 100, 20, 0);
+            background.addProperty("layer", 2);
+            background.addProperty("action", 10);
+            final var foreground = control("button", 100, 20, 0);
+            foreground.addProperty("layer", 2);
+            foreground.addProperty("action", 20);
+            final var wrapper = control("panel", 100, 20, 0);
+            final var nested = new JsonArray();
+            nested.add(foreground);
+            wrapper.add("children", nested);
+            final var root = control("panel", 200, 100, 0);
+            final var children = new JsonArray();
+            children.add(reversed ? wrapper : background);
+            children.add(reversed ? background : wrapper);
+            root.add("children", children);
+            final var scene = new JsonObject();
+            scene.addProperty("format", 1);
+            scene.add("root", root);
+            final var controller = new Controller(NativeUiController.Activation.STAY,
+                    NativeUiScene.parse(scene.toString(), Set.of()).root());
+            withScreen(controller, (game, screen) -> {
+                assertTrue(screen.mouseClicked(event(10, 10), false));
+                assertEquals(List.of(reversed ? 10 : 20), controller.responses);
+            });
+        }
+    }
+
+    @Test
+    void abandonsAStaleConnectionWithoutSendingCancellation() throws Exception {
+        final var controller = new Controller(NativeUiController.Activation.STAY);
+        withScreen(controller, (game, screen) -> {
+            controller.current = false;
+            screen.tick();
+            verify(game).setScreenAndShow(null);
+            assertTrue(controller.responses.isEmpty());
+            assertEquals(0, controller.cancels);
+        });
+    }
+
+    @Test
+    void requiresAuthoredFocusWithoutDisablingPointerActions() throws Exception {
+        for (final var entry : List.of(Map.entry(JsonNull.INSTANCE, false), Map.entry(new JsonPrimitive(false), false),
+                Map.entry(new JsonPrimitive(true), true), Map.entry(new JsonPrimitive(0), false),
+                Map.entry(new JsonPrimitive(-1), true), Map.entry(new JsonPrimitive(1), true),
+                Map.entry(new JsonPrimitive(1.0), false), Map.entry(new JsonPrimitive("true"), false))) {
+            final var value = entry.getKey();
+            final var root = root();
+            final var target = root.children().get(1);
+            if (!value.isJsonNull()) target.properties().add("focus_enabled", value);
+            final var controller = new Controller(NativeUiController.Activation.STAY, root);
+            withScreen(controller, (game, screen) -> {
+                final var action = screen.getChildAt(10, 40).orElseThrow();
+                assertEquals(entry.getValue(), action.nextFocusPath(new FocusNavigationEvent.TabNavigation(true)) != null);
+                assertTrue(screen.mouseClicked(event(10, 40), false));
+                assertEquals(List.of(177), controller.responses);
+            });
+        }
+    }
+
+    @Test
+    void arrowInputFollowsAuthoredOverridesStopsAndWrapsWithoutSubmittingResponses() throws Exception {
+        final var root = root();
+        for (int index = 0; index < root.children().size(); index++) {
+            root.children().get(index).properties().addProperty("focus_enabled", true);
+            root.children().get(index).properties().addProperty("focus_identifier", "control_" + index);
+        }
+        root.children().getFirst().properties().addProperty("focus_change_down", "control_2");
+        root.children().getLast().properties().addProperty("focus_change_up", "FOCUS_OVERRIDE_STOP");
+        final var controller = new Controller(NativeUiController.Activation.STAY, root);
+        withScreen(controller, (game, screen) -> {
+            final var first = screen.getChildAt(10, 10).orElseThrow();
+            final var last = screen.getChildAt(10, 70).orElseThrow();
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            assertSame(first, screen.getFocused());
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            assertSame(last, screen.getFocused());
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_UP, 0, 0)));
+            assertSame(last, screen.getFocused());
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            assertSame(first, screen.getFocused());
+            assertTrue(controller.responses.isEmpty());
+            assertEquals(0, controller.refreshes);
+        });
+    }
+
+    @Test
+    void remembersTheLastControlInAGroupAcrossRetainedSceneRefreshes() throws Exception {
+        final var root = control("panel", 200, 100, 0);
+        final var children = new JsonArray();
+        for (final String name : List.of("left", "right")) {
+            final var group = control("panel", 80, 100, 0);
+            group.addProperty("name", name);
+            group.getAsJsonArray("offset").set(0, new JsonPrimitive(name.equals("right") ? 100 : 0));
+            group.addProperty("focus_container", true);
+            group.addProperty("use_last_focus", true);
+            final var buttons = new JsonArray();
+            for (int index = 0; index < 2; index++) {
+                final var button = control("button", 60, 20, index * 30);
+                button.addProperty("focus_enabled", true);
+                button.addProperty("action", index);
+                buttons.add(button);
+            }
+            group.add("children", buttons);
+            children.add(group);
+        }
+        root.add("children", children);
+        final var envelope = new JsonObject();
+        envelope.addProperty("format", 1);
+        envelope.add("root", root);
+        final var controller = new Controller(NativeUiController.Activation.STAY, NativeUiScene.parse(envelope.toString(), Set.of()).root());
+        controller.replaceRootOnRefresh = true;
+        withScreen(controller, (game, screen) -> {
+            final var left = screen.getChildAt(10, 10).orElseThrow();
+            final var rightBottom = screen.getChildAt(110, 40).orElseThrow();
+            screen.setFocused(rightBottom);
+            screen.setFocused(left);
+            assertTrue(screen.mouseClicked(event(10, 10), false));
+            assertEquals(1, controller.refreshes);
+            assertSame(left, screen.getFocused());
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_RIGHT, 0, 0)));
+            assertSame(rightBottom, screen.getFocused());
+            assertEquals(1, controller.responses.size());
+        });
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void arrowNavigationRevealsAnOffscreenControlWithoutWrappingWithinTheScrollView(final boolean editable) throws Exception {
+        final var root = control("scroll_view", 100, 50, 0);
+        root.addProperty("scroll_view_port", "viewport");
+        root.addProperty("scroll_content", "items");
+        final var viewport = control("panel", 100, 50, 0);
+        viewport.addProperty("name", "viewport");
+        final var items = control("stack_panel", 100, 120, 0);
+        items.addProperty("name", "items");
+        final var buttons = new JsonArray();
+        for (int index = 0; index < 3; index++) {
+            final var button = control(editable && index > 0 ? "edit_box" : "button", 100, 40, 0);
+            if (editable && index > 0) {
+                final var input = new JsonObject();
+                input.addProperty("index", index);
+                button.add("input", input);
+            }
+            button.addProperty("focus_enabled", true);
+            button.addProperty("action", index);
+            buttons.add(button);
+        }
+        items.add("children", buttons);
+        final var content = new JsonArray();
+        content.add(items);
+        viewport.add("children", content);
+        final var children = new JsonArray();
+        children.add(viewport);
+        root.add("children", children);
+        final var envelope = new JsonObject();
+        envelope.addProperty("format", 1);
+        envelope.add("root", root);
+        final var controller = new Controller(NativeUiController.Activation.STAY, NativeUiScene.parse(envelope.toString(), Set.of()).root());
+        if (editable) {
+            controller.values = mock(NativeUiController.Inputs.class);
+            when(controller.values.maxLength(anyInt())).thenReturn(32);
+            when(controller.values.text(anyInt())).thenReturn("");
+            when(controller.values.placeholder(anyInt())).thenReturn("");
+        }
+        withScreen(controller, (game, screen) -> {
+            final var first = screen.getChildAt(10, 10).orElseThrow();
+            screen.setFocused(first);
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            assertNotSame(first, screen.getFocused());
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            final var last = screen.getFocused();
+            assertNotSame(first, last);
+            assertSame(last, screen.getChildAt(10, 30).orElseThrow());
+            assertTrue(last.isFocused());
+            if (editable) {
+                assertTrue(screen.charTyped(new CharacterEvent('x')));
+                verify(controller.values).setText(2, "x");
+            }
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_DOWN, 0, 0)));
+            assertSame(last, screen.getFocused());
+            assertTrue(controller.responses.isEmpty());
+        });
+    }
+
+    private static void withScreen(final Controller controller, final Interaction interaction) throws Exception {
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        when(font.width(anyString())).thenAnswer(call -> ((String) call.getArgument(0)).length() * 6);
+        when(font.plainSubstrByWidth(anyString(), anyInt())).thenAnswer(call -> {
+            final String value = call.getArgument(0);
+            return value.substring(0, Math.min(value.length(), Math.max(0, ((int) call.getArgument(1)) / 6)));
+        });
+        when(font.plainSubstrByWidth(anyString(), anyInt(), anyBoolean())).thenAnswer(call -> {
+            final String value = call.getArgument(0);
+            final int length = Math.min(value.length(), Math.max(0, ((int) call.getArgument(1)) / 6));
+            return (boolean) call.getArgument(2) ? value.substring(value.length() - length) : value.substring(0, length);
+        });
+        final Minecraft game = mock(Minecraft.class);
+        when(game.getSoundManager()).thenReturn(mock(SoundManager.class));
+        final var field = Minecraft.class.getField("font");
+        field.setAccessible(true);
+        field.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new NativeUiSceneScreen(controller);
+            screen.width = 200;
+            screen.height = 100;
+            screen.init();
+            try {
+                interaction.run(game, screen);
+            } finally {
+                screen.removed();
+            }
+        }
+    }
+
+    private static MouseButtonEvent event(final double x, final double y) {
+        return new MouseButtonEvent(x, y, new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+    }
+
+    private static NativeUiScene.Node root() {
+        final var root = control("panel", 200, 100, 0);
+        final var children = new JsonArray();
+        for (final int index : new int[] {2, 177, -1}) {
+            final var button = control("button", 100, 20, children.size() * 30);
+            button.addProperty("action", index);
+            button.addProperty("default_control", "normal");
+            children.add(button);
+        }
+        root.add("children", children);
+        final var scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        return NativeUiScene.parse(scene.toString(), Set.of()).root();
+    }
+
+    private static JsonObject control(final String type, final int width, final int height, final int y) {
+        final var control = new JsonObject();
+        control.addProperty("name", "repeated_template");
+        control.addProperty("type", type);
+        control.addProperty("anchor_from", "top_left");
+        control.addProperty("anchor_to", "top_left");
+        final var size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        control.add("size", size);
+        final var offset = new JsonArray();
+        offset.add(0);
+        offset.add(y);
+        control.add("offset", offset);
+        return control;
+    }
+
+    private static final class Controller implements NativeUiController {
+        private final Activation activation;
+        private NativeUiScene.Node root;
+        private boolean replaceRootOnRefresh;
+        private Inputs values;
+        private final List<Integer> responses = new ArrayList<>();
+        private List<NativeUiScene.Node> validated = List.of();
+        private int refreshes, cancels;
+        private boolean current = true;
+
+        private Controller(final Activation activation) { this(activation, NativeUiSceneScreenInteractionTest.root()); }
+        private Controller(final Activation activation, final NativeUiScene.Node root) {
+            this.activation = activation;
+            this.root = root;
+        }
+        @Override public Inputs inputs() { return this.values; }
+        @Override public String title() { return ""; }
+        @Override public NativeUiScene.Node root() { return this.root; }
+        @Override public void validateVisibleControls() { NativeUiScene.validateVisibleControls(this.root, Set.of()); }
+        @Override public void validateResponseControls(final List<NativeUiScene.Node> controls) { this.validated = controls; }
+        @Override public boolean current() { return this.current; }
+        @Override public Activation activate(final NativeUiScene.Node node) {
+            this.responses.add(node.action());
+            return this.activation;
+        }
+        @Override public void cancel() { this.cancels++; }
+        @Override public void failed(final RuntimeException error) { throw error; }
+        @Override public void refresh() {
+            this.refreshes++;
+            if (this.replaceRootOnRefresh) this.root = copy(this.root);
+        }
+        private static NativeUiScene.Node copy(final NativeUiScene.Node node) {
+            return new NativeUiScene.Node(node.name(), node.type(), node.properties().deepCopy(),
+                node.children().stream().map(Controller::copy).toList(), node.action());
+        }
+    }
+
+    private interface Interaction {
+        void run(Minecraft game, NativeUiSceneScreen screen) throws Exception;
+    }
+}
