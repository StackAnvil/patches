@@ -0,0 +1,83 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import javax.imageio.ImageIO;
+import javax.imageio.stream.MemoryCacheImageInputStream;
+import net.minecraft.client.renderer.texture.ReloadableTexture;
+import net.minecraft.client.renderer.texture.TextureContents;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiTextureLimits;
+
+/** Native JPEG resources keep their encoding in the pack and decode only when displayed. */
+final class NativeUiJpegTexture extends ReloadableTexture {
+    private BufferedImage prepared;
+
+    NativeUiJpegTexture(final Identifier id, final BufferedImage prepared) {
+        super(id);
+        this.prepared = prepared;
+    }
+
+    @Override
+    public TextureContents loadContents(final ResourceManager resources) throws IOException {
+        BufferedImage image = this.prepared;
+        this.prepared = null;
+        if (image == null) {
+            try (final var input = resources.getResourceOrThrow(this.resourceId()).open()) {
+                image = decode(input);
+            }
+        }
+        return new TextureContents(pixels(image), null);
+    }
+
+    @Override
+    public void close() {
+        this.prepared = null;
+        super.close();
+    }
+
+    static BufferedImage decode(final InputStream source) throws IOException {
+        final byte[] bytes = source.readNBytes(UiTextureLimits.MAX_ENCODED_BYTES + 1);
+        if (bytes.length > UiTextureLimits.MAX_ENCODED_BYTES) throw new IOException("Native UI texture exceeds byte limits");
+        try (final var input = new MemoryCacheImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(input);
+            if (!readers.hasNext()) throw new IOException("Unsupported native UI image");
+            final var reader = readers.next();
+            try {
+                reader.setInput(input, true, true);
+                if (!UiTextureLimits.supportsDimensions(reader.getWidth(0), reader.getHeight(0)))
+                    throw new IOException("Native UI texture exceeds dimension limits");
+                final BufferedImage image = reader.read(0);
+                if (image == null || !UiTextureLimits.supportsDimensions(image.getWidth(), image.getHeight()))
+                    throw new IOException("Invalid native UI image");
+                return image;
+            } finally {
+                reader.dispose();
+            }
+        }
+    }
+
+    static NativeImage pixels(final BufferedImage image) {
+        final NativeImage pixels = new NativeImage(image.getWidth(), image.getHeight(), false);
+        try {
+            final int[] row = new int[image.getWidth()];
+            for (int y = 0; y < image.getHeight(); y++) {
+                image.getRGB(0, y, image.getWidth(), 1, row, 0, image.getWidth());
+                for (int x = 0; x < image.getWidth(); x++) pixels.setPixel(x, y, row[x]);
+            }
+            return pixels;
+        } catch (final RuntimeException | Error failure) {
+            pixels.close();
+            throw failure;
+        }
+    }
+}
