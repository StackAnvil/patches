+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import java.util.UUID;
+import net.minecraft.SharedConstants;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Gui;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeUiHurtEvent;
+import org.junit.jupiter.api.Test;
+
+import static org.mockito.Mockito.*;
+
+final class BedrockNativeUiHurtTest {
+    @Test
+    void checksTheSceneAtConsumptionAndRejectsRetiredConnectionsAndActorLifetimes() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var client = mock(Minecraft.class);
+        final var player = mock(LocalPlayer.class);
+        client.player = player;
+        client.level = mock(ClientLevel.class);
+        final var listener = mock(ClientPacketListener.class);
+        final var connection = mock(Connection.class);
+        when(listener.getConnection()).thenReturn(connection);
+        when(connection.isConnected()).thenReturn(true);
+        when(client.getConnection()).thenReturn(listener);
+        final var gui = mock(Gui.class);
+        final var guiField = Minecraft.class.getField("gui");
+        guiField.setAccessible(true);
+        guiField.set(client, gui);
+        final UUID playerId = UUID.randomUUID(), lifetime = UUID.randomUUID();
+        when(player.getUUID()).thenReturn(playerId);
+        final var screen = mock(Screen.class, withSettings().extraInterfaces(NativeUiScreen.class));
+        when(((NativeUiScreen) screen).closeOnPlayerHurt()).thenReturn(true);
+        when(gui.screen()).thenReturn(screen);
+        try (final var actors = mockStatic(BedrockActorState.class)) {
+            actors.when(() -> BedrockActorState.lifetime(playerId)).thenReturn(lifetime);
+            BedrockNativeUiHurt.apply(mock(Connection.class), new NativeUiHurtEvent(lifetime, 2, 14), client);
+            BedrockNativeUiHurt.apply(connection, new NativeUiHurtEvent(UUID.randomUUID(), 2, 14), client);
+            BedrockNativeUiHurt.tick(client);
+            verify(screen, never()).onClose();
+
+            // The scene at receipt is not the scene the next player update necessarily evaluates.
+            when(gui.screen()).thenReturn(null);
+            BedrockNativeUiHurt.apply(connection, new NativeUiHurtEvent(lifetime, 2, 14), client);
+            when(gui.screen()).thenReturn(screen);
+            BedrockNativeUiHurt.tick(client);
+            verify(screen).onClose();
+
+            final UUID respawn = UUID.randomUUID();
+            actors.when(() -> BedrockActorState.lifetime(playerId)).thenReturn(respawn);
+            BedrockNativeUiHurt.apply(connection, new NativeUiHurtEvent(lifetime, 2, 14), client);
+            BedrockNativeUiHurt.tick(client);
+            verify(screen).onClose();
+            BedrockNativeUiHurt.apply(connection, new NativeUiHurtEvent(respawn, 81, 2), client);
+            BedrockNativeUiHurt.tick(client);
+            verify(screen, times(2)).onClose();
+        }
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeHudOverlayStateTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeHudOverlayStateTest.java
