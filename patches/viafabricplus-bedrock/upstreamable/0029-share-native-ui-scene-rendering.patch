+
+    private static int program(final boolean smooth, final boolean feedback) {
+        return program(smooth, feedback, resource("vsh", smooth));
+    }
+
+    private static int program(final boolean smooth, final boolean feedback, final String vertexSource) {
+        final int program = glCreateProgram();
+        final int vertex = shader(GL_VERTEX_SHADER, vertexSource);
+        final int fragment = shader(GL_FRAGMENT_SHADER, resource("fsh", smooth));
+        try {
+            glAttachShader(program, vertex);
+            glAttachShader(program, fragment);
+            if (feedback) glTransformFeedbackVaryings(program, new String[] {"glyphUv", "glyphBounds"}, GL_INTERLEAVED_ATTRIBS);
+            glLinkProgram(program);
+            assertEquals(GL_TRUE, glGetProgrami(program, GL_LINK_STATUS), glGetProgramInfoLog(program));
+            return program;
+        } finally { glDeleteShader(vertex); glDeleteShader(fragment); }
+    }
+
+    private static int shader(final int type, final String source) {
+        final int shader = glCreateShader(type);
+        glShaderSource(shader, source);
+        glCompileShader(shader);
+        assertEquals(GL_TRUE, glGetShaderi(shader, GL_COMPILE_STATUS), glGetShaderInfoLog(shader));
+        return shader;
+    }
+
+    private static String resource(final String extension, final boolean smooth) {
+        final String path = "/assets/viafabricplus-bedrock/shaders/core/bedrock_bitmap_font." + extension;
+        try (var input = BedrockBitmapShaderGpuTest.class.getResourceAsStream(path)) {
+            assertNotNull(input);
+            return new String(input.readAllBytes(), StandardCharsets.UTF_8)
+                .replace("#version 330", "#version 330\n" + (smooth ? "#define BITMAP_SMOOTH\n" : ""))
+                .replace("#include <minecraft:dynamictransforms.glsl>", "uniform mat4 ModelViewMat; uniform vec4 ColorModulator;")
+                .replace("#include <minecraft:projection.glsl>", "uniform mat4 ProjMat;");
+        } catch (final IOException error) { throw new IllegalStateException(error); }
+    }
+}
