+import net.minecraft.server.packs.metadata.MetadataSectionType;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.minecraft.server.packs.resources.ResourceMetadata;
+import org.joml.Matrix4fc;
+
+/** Owns native CPU font resources; Java's stitcher owns the uploaded glyph textures. */
+public final class BedrockTrueTypeFont implements GlyphProvider {
+    private static final MetadataSectionType<Integer> LAYOUT = new MetadataSectionType<>("viabedrock:truetype",
+            Codec.intRange(1, 255).fieldOf("render_height").codec());
+    private final BedrockTrueTypeRaster raster;
+    private final IntSet supported;
+    private boolean closed;
+
+    BedrockTrueTypeFont(final BedrockTrueTypeRaster raster, final String skip) {
+        this.raster = raster;
+        final var supported = new IntOpenHashSet(raster.supported());
+        skip.codePoints().forEach(supported::remove);
+        this.supported = IntSets.unmodifiable(supported);
+    }
+
+    public static boolean owns(final Identifier location) {
+        return location.getNamespace().equals("viabedrock") && location.getPath().matches("server_ui/[0-9a-f]{32}\\.ttf");
+    }
+
+    /** The descriptor and bytes must come from the same selected pack. Older exports use vanilla loading. */
+    public static GlyphProvider load(final ResourceManager resources, final Identifier location, final String skip) throws IOException {
+        final var file = location.withPrefix("font/");
+        final var resource = resources.getResourceOrThrow(file);
+        final var metadata = resource.source().getResource(PackType.CLIENT_RESOURCES, file.withSuffix(".mcmeta"));
+        if (metadata == null) return null;
+        final Optional<Integer> height;
+        try (var input = metadata.get()) { height = ResourceMetadata.fromJsonStream(input).getSection(LAYOUT); }
+        if (height.isEmpty()) return null;
+        final byte[] bytes;
+        try (var input = resource.open()) { bytes = input.readNBytes(BedrockTrueTypeRaster.MAX_FONT_BYTES + 1); }
+        final var raster = new BedrockTrueTypeRaster(bytes, height.get());
+        try { return new BedrockTrueTypeFont(raster, skip); }
+        catch (final RuntimeException | Error failure) { raster.close(); throw failure; }
+    }
+
+    @Override public IntSet getSupportedGlyphs() { return this.supported; }
+
+    @Override
+    public synchronized UnbakedGlyph getGlyph(final int codepoint) {
+        if (this.closed || !this.supported.contains(codepoint)) return null;
+        return new Glyph(this, codepoint, GlyphInfo.simple(this.raster.advance(codepoint)));
+    }
+
+    private synchronized BakedGlyph bake(final UnbakedGlyph.Stitcher stitcher, final int codepoint, final GlyphInfo info) {
+        if (this.closed) throw new IllegalStateException("Native TrueType font is closed");
+        final BedrockTrueTypeRaster.Glyph glyph;
+        try { glyph = this.raster.raster(codepoint); }
+        catch (final IOException malformed) { return stitcher.getMissing(); }
+        final BakedGlyph baked = stitcher.stitch(info, new Bitmap(glyph));
+        return new BakedGlyph() {
+            @Override public GlyphInfo info() { return baked.info(); }
+            @Override public TextRenderable.Styled createGlyph(final float x, final float y, final int color, final int shadowColor,
+                                                               final Style style, final float bold, final float shadow) {
+                final var source = baked.createGlyph(x, y, color, shadowColor, style, bold, shadow);
+                final var gui = style.isItalic()
+                        ? baked.createGlyph(x, y, color, shadowColor, style.withItalic(false), bold, shadow) : source;
+                return new Instance(source, gui, style.isItalic(), glyph.sampling());
+            }
+        };
+    }
+
+    @Override
+    public synchronized void close() {
+        if (this.closed) return;
+        this.closed = true;
+        this.raster.close();
+    }
+
+    public static boolean usesNativeSampling(final TextRenderable renderable) { return renderable instanceof Instance; }
+
+    public static boolean usesNativeSampling(final GlyphBitmap bitmap) { return bitmap instanceof Bitmap; }
+
+    private record Bitmap(BedrockTrueTypeRaster.Glyph glyph) implements GlyphBitmap {
+        @Override public int getPixelWidth() { return this.glyph.width(); }
+        @Override public int getPixelHeight() { return this.glyph.height(); }
+        @Override public float getOversample() { return this.glyph.oversample(); }
+        @Override public float getBearingLeft() { return this.glyph.left(); }
+        @Override public float getBearingTop() { return 7 - this.glyph.top(); }
+        @Override public boolean isColored() { return false; }
+        @Override public void upload(final int x, final int y, final GpuTexture texture) {
+            // FontTexture reserves a one-pixel gutter; native cache padding is zero.
+            final int width = Math.min(this.glyph.width() + 1, texture.getWidth(0) - x);
+            final int height = Math.min(this.glyph.height() + 1, texture.getHeight(0) - y);
+            try (var image = new NativeImage(NativeImage.Format.LUMINANCE, width, height, true)) {
+                final var pixels = image.getPixelBytes();
+                for (int row = 0; row < this.glyph.height(); row++) {
+                    pixels.position(row * width).put(this.glyph.pixels(), row * this.glyph.width(), this.glyph.width());
+                }
+                RenderSystem.getDevice().createCommandEncoder().writeToTexture(texture, image, 0, 0, x, y);
+            }
+        }
+    }
+
+    /** Native stores cache-space vertices as half floats before the 1.5 display transform. */
+    private static final class CacheVertices implements VertexConsumer {
+        private final VertexConsumer target;
+        private final boolean italic;
+        private final BedrockTrueTypeRaster.Sampling sampling;
+        private final int width, height;
+        private int vertex;
+
+        private CacheVertices(final VertexConsumer target, final boolean italic, final BedrockTrueTypeRaster.Sampling sampling,
+                              final GpuTextureView texture) {
+            this.target = target;
+            this.italic = italic;
+            this.sampling = sampling;
+            this.width = texture.getWidth(0);
+            this.height = texture.getHeight(0);
+        }
+        @Override public VertexConsumer addVertex(final float x, final float y, final float z) {
+            this.target.addVertex(x, y, z);
+            return this;
+        }
+        @Override public VertexConsumer addVertex(final Matrix4fc pose, final float x, final float y, final float z) {
+            // Java submits top-left, bottom-left, bottom-right, top-right for each glyph quad.
+            final int corner = this.vertex++ & 3;
+            final float shear = this.italic ? (corner == 0 || corner == 3 ? 1 : -1) : 0;
+            this.target.addVertex(pose, cacheCoordinate(x, shear), cacheCoordinate(y, 0), z);
+            return this;
+        }
+        private static float cacheCoordinate(final float value, final float shear) {
+            return Float.float16ToFloat(Float.floatToFloat16(value / 1.5F + shear)) * 1.5F;
+        }
+        @Override public VertexConsumer setColor(final int r, final int g, final int b, final int a) { this.target.setColor(r, g, b, a); return this; }
+        @Override public VertexConsumer setColor(final int color) { this.target.setColor(color); return this; }
+        @Override public VertexConsumer setUv(final float u, final float v) {
+            final int corner = (this.vertex - 1) & 3;
+            this.target.setUv(u + this.sampling.correction(true, corner == 2 || corner == 3) / this.width,
+                    v + this.sampling.correction(false, corner == 1 || corner == 2) / this.height);
+            return this;
+        }
+        @Override public VertexConsumer setUv1(final int u, final int v) { this.target.setUv1(u, v); return this; }
+        @Override public VertexConsumer setUv2(final int u, final int v) { this.target.setUv2(u, v); return this; }
+        @Override public VertexConsumer setUv3(final float u, final float v) { this.target.setUv3(u, v); return this; }
+        @Override public VertexConsumer setNormal(final float x, final float y, final float z) { this.target.setNormal(x, y, z); return this; }
+        @Override public VertexConsumer setLineWidth(final float width) { this.target.setLineWidth(width); return this; }
+    }
+
+    private record Glyph(BedrockTrueTypeFont font, int codepoint, GlyphInfo info) implements UnbakedGlyph {
+        @Override public BakedGlyph bake(final Stitcher stitcher) { return this.font.bake(stitcher, this.codepoint, this.info); }
+    }
+
+    private record Instance(TextRenderable.Styled source, TextRenderable.Styled gui, boolean italic,
+                            BedrockTrueTypeRaster.Sampling sampling) implements TextRenderable.Styled {
+        @Override public void render(final Matrix4fc pose, final VertexConsumer vertices, final int light, final boolean inverseDepth) {
+            if (inverseDepth) this.gui.render(pose, new CacheVertices(vertices, this.italic, this.sampling, this.textureView()), light, true);
+            else this.source.render(pose, vertices, light, false);
+        }
+        @Override public RenderType renderType(final Font.DisplayMode mode) { return this.source.renderType(mode); }
+        @Override public GpuTextureView textureView() { return this.source.textureView(); }
+        @Override public RenderPipeline guiPipeline() { return Pipeline.GUI; }
+        @Override public Style style() { return this.source.style(); }
+        // Bounds cover both native GUI shear and the retained Java world-text geometry.
+        @Override public float left() { return this.italic ? Math.min(this.source.left(), this.gui.left() - 1.5F) : this.source.left(); }
+        @Override public float top() { return this.source.top(); }
+        @Override public float right() { return this.italic ? Math.max(this.source.right(), this.gui.right() + 1.5F) : this.source.right(); }
+        @Override public float bottom() { return this.source.bottom(); }
+    }
+
+    private static final class Pipeline {
+        static final RenderPipeline GUI = create();
+        private static RenderPipeline create() {
+            final var original = RenderPipelines.GUI_TEXT;
+            final var colors = original.getColorTargetStates().toArray(ColorTargetState[]::new);
+            final var snippet = new RenderPipeline.Snippet(original.getShaders(), Optional.of(original.getShaderDefines()),
+                    Optional.of(original.getBindGroupLayouts()), colors, colors.length, Optional.ofNullable(original.getDepthStencilState()),
+                    Optional.of(original.getPolygonMode()), Optional.of(original.isCull()),
+                    original.getVertexFormatBindings().toArray(VertexFormat[]::new), Optional.of(original.getPrimitiveTopology()), original.pushConstantSize());
+            return BedrockShaderPipelines.register(RenderPipeline.builder(snippet)
+                    .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/truetype_font"))
+                    .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_truetype_font")).build(), original, 0);
+        }
+    }
+}
