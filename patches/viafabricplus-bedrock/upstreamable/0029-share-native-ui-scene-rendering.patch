+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonObject;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiFocusTest {
+    @Test
+    void measuresTheNearestDirectionalEdgeRatherThanTheCenter() {
+        final var current = target(0, 0, 20, 20);
+        final var nearerCenter = target(100, 0, 10, 10);
+        final var nearerEdge = target(40, 0, 200, 20);
+        assertSame(nearerEdge, NativeUiFocus.next(List.of(current, nearerCenter, nearerEdge), current.box().node(), NativeUiFocus.Direction.RIGHT, 800, 480, new NativeUiFocus.History()));
+    }
+
+    @Test
+    void equalDistancesRetainRegistrationOrder() {
+        final var current = target(0, 0, 20, 20);
+        final var first = target(50, 0, 20, 20);
+        final var second = target(50, 0, 20, 20);
+        assertSame(first, NativeUiFocus.next(List.of(current, first, second), current.box().node(), NativeUiFocus.Direction.RIGHT, 800, 480, new NativeUiFocus.History()));
+        assertSame(second, NativeUiFocus.next(List.of(current, second, first), current.box().node(), NativeUiFocus.Direction.RIGHT, 800, 480, new NativeUiFocus.History()));
+    }
+
+    @Test
+    void usesTheNearestClippingAncestorForNavigation() {
+        final var current = target(10, 90, 20, 20).box();
+        final var next = target(40, 140, 20, 20).box();
+        final var inner = clip(new NativeUiLayout.Rect(20, 150, 40, 80), next);
+        final var outer = clip(new NativeUiLayout.Rect(0, 0, 100, 100), current, inner);
+        final var targets = NativeUiFocus.targets(outer, _ -> true);
+        assertEquals(2, targets.size());
+        assertSame(inner.node(), targets.getLast().clip().owner());
+        assertSame(next.node(), NativeUiFocus.next(targets, current.node(), NativeUiFocus.Direction.DOWN, 800, 480, new NativeUiFocus.History()).box().node());
+    }
+
+    @Test
+    void appliesContainerPoliciesAndLetsExplicitOverridesBypassThem() {
+        final var source = target(0, 0, 20, 20).box();
+        final var inside = target(40, 0, 20, 20).box();
+        final var destination = target(80, 0, 20, 20).box();
+        final var inner = group("inner", inside);
+        final var outer = group("outer", source, inner);
+        final var other = group("other", destination);
+        final var root = box(new NativeUiScene.Node("root", "panel", new JsonObject(), List.of(), 0),
+            new NativeUiLayout.Rect(0, 0, 200, 100), List.of(outer, other));
+        final var targets = NativeUiFocus.targets(root, _ -> true);
+        final var history = new NativeUiFocus.History();
+        outer.node().properties().addProperty("focus_navigation_mode_right", "contained");
+        assertSame(inside.node(), NativeUiFocus.next(targets, source.node(), NativeUiFocus.Direction.RIGHT, 200, 100, history).box().node());
+        outer.node().properties().addProperty("focus_navigation_mode_right", "stop");
+        assertSame(source.node(), NativeUiFocus.next(targets, source.node(), NativeUiFocus.Direction.RIGHT, 200, 100, history).box().node());
+        destination.node().properties().addProperty("focus_identifier", "explicit_destination");
+        source.node().properties().addProperty("focus_change_right", "explicit_destination");
+        assertSame(destination.node(), NativeUiFocus.next(targets, source.node(), NativeUiFocus.Direction.RIGHT, 200, 100, history).box().node());
+    }
+
+    private static NativeUiLayout.Box group(final String name, final NativeUiLayout.Box... children) {
+        final var properties = new JsonObject();
+        properties.addProperty("focus_container", true);
+        return box(new NativeUiScene.Node(name, "panel", properties, List.of(), 0),
+            new NativeUiLayout.Rect(0, 0, 200, 100), List.of(children));
+    }
+
+    private static NativeUiFocus.Target target(final float x, final float y, final float width, final float height) {
+        final var properties = new JsonObject();
+        properties.addProperty("focus_enabled", true);
+        final var node = new NativeUiScene.Node("", "button", properties, List.of(), Integer.MIN_VALUE);
+        return new NativeUiFocus.Target(box(node, new NativeUiLayout.Rect(x, y, width, height), List.of()), null, List.of());
+    }
+
+    private static NativeUiLayout.Box clip(final NativeUiLayout.Rect bounds, final NativeUiLayout.Box... children) {
+        final var properties = new JsonObject();
+        properties.addProperty("clips_children", true);
+        final var node = new NativeUiScene.Node("", "panel", properties, List.of(), Integer.MIN_VALUE);
+        return box(node, bounds, List.of(children));
+    }
+
+    private static NativeUiLayout.Box box(final NativeUiScene.Node node, final NativeUiLayout.Rect bounds, final List<NativeUiLayout.Box> children) {
+        return new NativeUiLayout.Box(node, bounds, bounds, new NativeUiLayout.Size(bounds.width(), bounds.height()), bounds, 0, children);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiImageCacheTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/ui/NativeUiImageCacheTest.java
