+    private STBTTVertex.Buffer vertices(final int glyph, final IntSet parents) throws IOException {
+        if (parents.size() >= 16 || !parents.add(glyph)) throw new IOException("Cyclic or excessive native glyph composition");
+        try {
+            final int flags = FreeType.FT_LOAD_NO_SCALE | FreeType.FT_LOAD_NO_HINTING | FreeType.FT_LOAD_NO_BITMAP
+                    | FreeType.FT_LOAD_IGNORE_TRANSFORM | FreeType.FT_LOAD_NO_RECURSE;
+            if (FreeType.FT_Load_Glyph(this.face, glyph, flags) != 0) throw new IOException("Cannot read native font glyph");
