+        // Original 1.26.60.5 glyph writer at 0x141590f60, with bitmap height 12 and offset -3.
+        final var bitmap = BedrockBitmapFont.Cell.bitmap(1, 4, 8, 12, 128, 128, -3);
+        assertEquals(.0625F, bitmap.u0());
+        assertEquals(.375F, bitmap.v0());
+        assertEquals(.12499219179153442F, bitmap.u1());
+        assertEquals(.4687421917915344F, bitmap.v1());
+        final var unicode = new BedrockBitmapFont.Cell(16, 64, 16, 16, 256, 256, .5F, 0, 0, .01F);
+        assertEquals(.0625F, unicode.u0());
+        assertEquals(.25F, unicode.v0());
+        assertEquals(.12496093660593033F, unicode.u1());
+        assertEquals(.31246092915534973F, unicode.v1());
+    }
+
+    @Test
+    void retainsPageCoordinatesAndFullCellBoundsAtDifferentResolutions() {
+        for (final int resolution : new int[] {256, 512, 1024}) {
+            final int size = resolution / 16;
+            final var cell = new BedrockBitmapFont.Cell(size * 15, size * 7, size, size,
+                    resolution, resolution, 8F / size, -.5F, -4, .01F);
+            assertEquals(15F / 16, cell.u0());
+            assertEquals(7F / 16, cell.v0());
+            assertEquals(7.5F, cell.right());
+            assertEquals(4, cell.bottom());
+        }
+    }
