diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetHttpProbeTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetHttpProbeTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..365fb623619315700464cce8133f5cd723c5c98b
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetHttpProbeTest.java
@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.sun.net.httpserver.HttpServer;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class NetherNetHttpProbeTest {
+    @Test
+    void acceptsAServerThatAnswersTheNativeCapabilityRequest() throws IOException {
+        final HttpServer server = capabilityServer(200);
+        try {
+            assertTrue(NetherNetHttpProbe.accepts("127.0.0.1", server.getAddress().getPort()));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void rejectsAnHttpServerWithoutTheCapabilityEndpoint() throws IOException {
+        final HttpServer server = capabilityServer(404);
+        try {
+            assertFalse(NetherNetHttpProbe.accepts("127.0.0.1", server.getAddress().getPort()));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void rejectsAJavaServerThatClosesTheConnectionOnAnHttpRequest() throws Exception {
+        try (ServerSocket server = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+            final Thread java = Thread.ofVirtual().start(() -> {
+                try (Socket client = server.accept()) {
+                    client.getInputStream().read();
+                } catch (IOException ignored) {
+                }
+            });
+            assertFalse(NetherNetHttpProbe.accepts("127.0.0.1", server.getLocalPort()));
+            java.join();
+        }
+    }
+
+    private static HttpServer capabilityServer(final int status) throws IOException {
+        final HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
+        server.createContext("/", exchange -> {
+            exchange.sendResponseHeaders(exchange.getRequestURI().getPath().equals("/v1/join") ? status : 404, -1);
+            exchange.close();
+        });
+        server.start();
+        return server;
+    }
+}
