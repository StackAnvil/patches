+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+
+/** Shares the native random offset between the rendered model and its physical shape. */
+public final class BedrockBlockOffsets {
+    private static final CustomBlockOffset.Axis XZ = new CustomBlockOffset.Axis(-0.25F, 0.25F, 16);
+    private static final CustomBlockOffset HORIZONTAL = new CustomBlockOffset(XZ, CustomBlockOffset.ZERO, XZ);
+    private static final CustomBlockOffset VERTICAL = new CustomBlockOffset(XZ,
+            new CustomBlockOffset.Axis(-0.2F, 0F, 16), XZ);
+
+    private BedrockBlockOffsets() {}
+
+    public static Vec3 offset(final BlockPos position, final BlockBehaviour.OffsetType type,
+                              final boolean bamboo, final boolean thick) {
+        if (type == BlockBehaviour.OffsetType.NONE) return Vec3.ZERO;
+        final var random = (type == BlockBehaviour.OffsetType.XYZ ? VERTICAL : HORIZONTAL)
+                .at(position.getX(), position.getY(), position.getZ());
+        // Java bamboo meshes are centered on pixel eight. Native stalks start at eight,
+        // with widths two and three. Translate the shared model/shape origin once.
+        final double origin = bamboo ? (thick ? 1.5D : 1D) / 16D : 0D;
+        return new Vec3(random.x() + origin, random.y(), random.z() + origin);
+    }
+}
