+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BedrockBlockOffsetsTest {
+    @Test
+    void alignsBothStalkMeshesAndShapesWithTheNativeStalkOrigin() {
+        final var axis = new CustomBlockOffset.Axis(-0.25F, 0.25F, 16);
+        final var sampler = new CustomBlockOffset(axis, CustomBlockOffset.ZERO, axis);
+        for (final var position : new BlockPos[]{new BlockPos(0, 64, 0), new BlockPos(-17, 80, 93),
+                new BlockPos(Integer.MIN_VALUE, 10, Integer.MAX_VALUE)}) {
+            final var nativeOffset = sampler.at(position.getX(), position.getY(), position.getZ());
+            for (final boolean thick : new boolean[]{false, true}) {
+                final var offset = BedrockBlockOffsets.offset(position, BlockBehaviour.OffsetType.XZ, true, thick);
+                final double javaStart = thick ? 6.5D : 7D;
+                final double javaEnd = thick ? 9.5D : 9D;
+                assertEquals(8D / 16D + nativeOffset.x(), javaStart / 16D + offset.x, 1E-9);
+                assertEquals((thick ? 11D : 10D) / 16D + nativeOffset.z(), javaEnd / 16D + offset.z, 1E-9);
+                assertEquals(0D, offset.y);
+                assertEquals(offset, BedrockBlockOffsets.offset(position.above(200), BlockBehaviour.OffsetType.XZ, true, thick));
+            }
+        }
+    }
+}
