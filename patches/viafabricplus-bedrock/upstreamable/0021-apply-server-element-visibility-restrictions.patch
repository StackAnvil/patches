+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/hud/BedrockLocatorBar.java
@@ -0,0 +1,121 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.hud;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import java.util.ArrayList;
+import java.util.Comparator;
+import net.minecraft.client.DeltaTracker;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.Connection;
+import net.minecraft.util.Util;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.LocatorBarSnapshot;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint;
+
+/** Retains native groups and uses the current camera and interpolated actor positions. */
+public final class BedrockLocatorBar {
+    private static final LocatorBarSession SESSION = new LocatorBarSession();
+    private static final LocatorBarImages IMAGES = new LocatorBarImages();
+    private static final LocatorBarMotion MOTION = new LocatorBarMotion();
+    private static final int WIDTH = 182;
+    private static final int HEIGHT = 5;
+    private static final long ANIMATION_START = Util.getNanos();
+    private static long previousFrame;
+
+    private BedrockLocatorBar() {}
+
+    public static void accept(final Connection connection, final LocatorBarSnapshot snapshot) {
+        final long generation = SESSION.generation();
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (connection.isConnected() && listener != null && listener.getConnection() == connection) {
+                SESSION.accept(generation, snapshot);
+                MOTION.retain(snapshot.waypoints().keySet());
+            }
+        });
+    }
+
+    public static boolean active() {
+        return SESSION.snapshot() != null;
+    }
+
+    public static boolean hasWaypoints(final boolean javaWaypoints) {
+        return active() ? !SESSION.snapshot().waypoints().isEmpty() : javaWaypoints;
+    }
+
+    public static void background(final GuiGraphicsExtractor graphics) {
+        IMAGES.background(graphics, graphics.guiWidth() / 2F - WIDTH / 2F, graphics.guiHeight() - 30, WIDTH, HEIGHT);
+    }
+
+    public static void icons(final GuiGraphicsExtractor graphics, final DeltaTracker delta) {
+        final var snapshot = SESSION.snapshot();
+        final var minecraft = Minecraft.getInstance();
+        if (snapshot == null || minecraft.level == null || minecraft.player == null) return;
+        final var camera = minecraft.gameRenderer.mainCamera();
+        if (!camera.isInitialized()) return;
+        final Vec3 observer = minecraft.player.getEyePosition(delta.getGameTimeDeltaPartialTick(!minecraft.player.isRemoved()));
+        final long now = Util.getNanos();
+        final float elapsed = previousFrame == 0 ? 0 : (now - previousFrame) / 1_000_000_000F;
+        previousFrame = now;
+        final float arrowOffset = (now - ANIMATION_START) / 1_000_000_000F % 0.7F > 0.45F ? 1.5F : 0.5F;
+        final var icons = new ArrayList<Icon>();
+        for (final var entry : snapshot.waypoints().entrySet()) {
+            final Vec3 target = position(entry.getValue(), delta);
+            final Vec3 position = MOTION.advance(entry.getKey(), target, observer, elapsed);
+            if (position != null) icons.add(new Icon(entry.getValue(), position, target.distanceToSqr(observer)));
+        }
+        icons.sort(Comparator.comparingDouble(Icon::distanceSquared).reversed());
+        for (final Icon icon : icons) {
+            final LocatorBarWaypoint waypoint = icon.waypoint();
+            if (!waypoint.visible() || waypoint.texture().isEmpty()
+                    || !Float.isFinite(waypoint.size().width()) || !Float.isFinite(waypoint.size().height())) continue;
+            final Vec3 target = icon.position();
+            final float width = LocatorBarProjection.iconExtent(waypoint.size().width());
+            final float height = LocatorBarProjection.iconExtent(waypoint.size().height());
+            if (!Float.isFinite(width) || !Float.isFinite(height)) continue;
+            final var projection = LocatorBarProjection.project(target.x - observer.x, target.y - observer.y,
+                    target.z - observer.z, camera.yRot(), camera.xRot(), WIDTH, HEIGHT, width, camera.getFov());
+            if (projection == null) continue;
+            final float x = graphics.guiWidth() / 2F + projection.offset();
+            final float y = graphics.guiHeight() - 27.5F;
+            final var image = IMAGES.image(waypoint.texture());
+            if (image == null) continue;
+            image.draw(graphics, x - width / 2, y - height / 2, width, height, waypoint.color());
+            if (projection.arrow() != 0) {
+                final var arrow = IMAGES.image(projection.arrow() > 0
+                        ? "textures/ui/locator_arrow_up" : "textures/ui/locator_arrow_down");
+                if (arrow != null) {
+                    final float top = y + (projection.arrow() > 0 ? -HEIGHT - arrowOffset : HEIGHT + arrowOffset)
+                            - (HEIGHT - 1) / 2F;
+                    arrow.draw(graphics, x - (HEIGHT + 2) / 2F, top, HEIGHT + 2, HEIGHT - 1, -1);
+                }
+            }
+        }
+    }
+
+    private static Vec3 position(final LocatorBarWaypoint waypoint, final DeltaTracker delta) {
+        final var minecraft = Minecraft.getInstance();
+        if (waypoint.clientPositionAuthority() && waypoint.actorUniqueId() != null) {
+            final var uuid = BedrockActorState.uuidByUniqueId(waypoint.actorUniqueId());
+            final var entity = uuid == null ? null : minecraft.level.getEntity(uuid);
+            if (entity != null) return entity.getPosition(delta.getGameTimeDeltaPartialTick(!entity.isRemoved()));
+        }
+        if (waypoint.position() == null) return null;
+        final var position = waypoint.position().position();
+        return new Vec3(position.x(), position.y(), position.z());
+    }
+
+    public static void clear() {
+        SESSION.clear();
+        IMAGES.clear();
+        MOTION.clear();
+        previousFrame = 0;
+    }
+
+    private record Icon(LocatorBarWaypoint waypoint, Vec3 position, double distanceSquared) {}
+}
