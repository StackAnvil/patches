+package com.viaversion.viafabricplus.bedrock.hud;
+
+import net.raphimc.viabedrock.api.model.HudVisibilityState;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudElement;
+
+/** Connection-scoped server restrictions leave local visibility settings intact. */
+public final class BedrockHudVisibility {
+
+    private static HudVisibilityState state = HudVisibilityState.DEFAULT;
+
+    private BedrockHudVisibility() {
+    }
+
+    public static HudVisibilityState current() {
+        return state;
+    }
+
+    public static void accept(final HudVisibilityState snapshot) {
+        state = snapshot;
+    }
+
+    public static boolean hidden(final HudElement element) {
+        return state.hides(element);
+    }
+
+    public static void clear() {
+        state = HudVisibilityState.DEFAULT;
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/hud/HudVisibilityPayload.java b/src/main/java/com/viaversion/viafabricplus/bedrock/hud/HudVisibilityPayload.java
