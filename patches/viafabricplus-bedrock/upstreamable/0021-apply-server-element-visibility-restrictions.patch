@@ -0,0 +1,50 @@
+package com.viaversion.viafabricplus.bedrock.hud;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarProjectionTest {
+    @Test
+    void iconExtentPreservesNativeZeroAndReversedQuads() {
+        assertEquals(4.5F, LocatorBarProjection.iconExtent(0.5F));
+        assertEquals(7F, LocatorBarProjection.iconExtent(1));
+        assertEquals(12F, LocatorBarProjection.iconExtent(2));
+        assertEquals(17F, LocatorBarProjection.iconExtent(3));
+        assertEquals(2F, LocatorBarProjection.iconExtent(0));
+        assertEquals(1F, LocatorBarProjection.iconExtent(-0.2F));
+        assertEquals(0F, LocatorBarProjection.iconExtent(-0.4F));
+        assertEquals(-3F, LocatorBarProjection.iconExtent(-1));
+    }
+
+    @Test
+    void headingWrapAndRangeFollowTheNativeBar() {
+        final double sine = Math.sin(Math.toRadians(30)) * 40;
+        final double cosine = Math.cos(Math.toRadians(30)) * 40;
+        assertEquals(42F, LocatorBarProjection.project(-sine, 0, cosine, 0, 0, 182, 5, 7, 70).offset(), 0.0001F);
+        assertEquals(-42F, LocatorBarProjection.project(sine, 0, cosine, 360, 0, 182, 5, 7, 70).offset(), 0.0001F);
+        assertEquals(0F, LocatorBarProjection.project(0, 0, -40, 180, 0, 182, 5, 7, 70).offset(), 0.0001F);
+        assertNull(LocatorBarProjection.project(-40, 0, 0, 0, 0, 182, 5, 7, 70));
+        assertNull(LocatorBarProjection.project(0, 0, -40, 0, 0, 182, 5, 7, 70));
+        assertNull(LocatorBarProjection.project(Double.NaN, 0, 40, 0, 0, 182, 5, 7, 70));
+    }
+
+    @Test
+    void iconWidthAndCameraFovChangeTheNativeProjection() {
+        final double sine = Math.sin(Math.toRadians(30)) * 40;
+        final double cosine = Math.cos(Math.toRadians(30)) * 40;
+        assertEquals(40.75F, LocatorBarProjection.project(-sine, 0, cosine, 0, 0, 182, 5, 12, 70).offset(), 0.0001F);
+        assertEquals(1, LocatorBarProjection.project(0, 22, 40, 0, 0, 182, 5, 7, 60).arrow());
+        assertEquals(0, LocatorBarProjection.project(0, 22, 40, 0, 0, 182, 5, 7, 90).arrow());
+        assertNull(LocatorBarProjection.project(0, 0, 40, 60, 0, 182, 5, 7, 70));
+    }
+
+    @Test
+    void heightDirectionAccountsForCameraPitchAndHorizontalDistance() {
+        assertEquals(0, LocatorBarProjection.project(0, 10, 40, 0, 0, 182, 5, 7, 70).arrow());
+        assertEquals(1, LocatorBarProjection.project(0, 40, 40, 0, 0, 182, 5, 7, 70).arrow());
+        assertEquals(-1, LocatorBarProjection.project(0, -40, 40, 0, 0, 182, 5, 7, 70).arrow());
+        assertEquals(0, LocatorBarProjection.project(0, 40, 40, 0, -45, 182, 5, 7, 70).arrow());
+        assertEquals(1, LocatorBarProjection.project(0, 0, 40, 0, 45, 182, 5, 7, 70).arrow());
+        assertEquals(0, LocatorBarProjection.project(0, 10, 80, 0, 0, 182, 5, 7, 70).arrow());
+    }
+}
