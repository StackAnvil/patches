@@ -0,0 +1,96 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.hud;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.resourcepack.ui.JsonUiProgram;
+
+/** Uses accepted converted pack resources, including native defaults and server texture overrides. */
+final class LocatorBarImages {
+    private final Map<Identifier, Image> images = new LinkedHashMap<>(16, 0.75F, true);
+    private final Map<Identifier, Object> failures = new LinkedHashMap<>();
+
+    Image image(final String texture) {
+        final Identifier id;
+        try {
+            id = Identifier.parse(JsonUiProgram.textureId(texture));
+        } catch (final IllegalArgumentException invalid) {
+            return null;
+        }
+        final var resource = Minecraft.getInstance().getResourceManager().getResource(id).orElse(null);
+        if (resource == null) return null;
+        final var cached = this.images.get(id);
+        if (cached != null && cached.source() == resource.source()) return cached;
+        if (this.failures.get(id) == resource.source()) return null;
+        try (final var input = resource.open(); final NativeImage pixels = NativeImage.read(input)) {
+            if (pixels.getWidth() > 4096 || pixels.getHeight() > 4096) throw new IOException("Locator texture exceeds size limits");
+            final var image = new Image(id, pixels.getWidth(), pixels.getHeight(), resource.source());
+            this.images.put(id, image);
+            if (this.images.size() > 256) this.images.remove(this.images.keySet().iterator().next());
+            this.failures.remove(id);
+            return image;
+        } catch (final IOException | RuntimeException failure) {
+            this.failures.put(id, resource.source());
+            if (this.failures.size() > 256) this.failures.remove(this.failures.keySet().iterator().next());
+            ViaFabricPlusBedrock.impl().logger().warn("Could not load native locator texture {}", id, failure);
+            return null;
+        }
+    }
+
+    void background(final GuiGraphicsExtractor graphics, final float x, final float y, final float width, final float height) {
+        final var image = this.image("textures/ui/locator_bg");
+        if (image == null) return;
+        // The pinned native locator background uses [5, 1, 5, 1] nine-slice borders.
+        final float borderX = Math.min(5, Math.min(width / 2, image.width() / 2F));
+        final float borderY = Math.min(1, Math.min(height / 2, image.height() / 2F));
+        final float[] targetX = {x, x + borderX, x + width - borderX, x + width};
+        final float[] targetY = {y, y + borderY, y + height - borderY, y + height};
+        final float[] sourceX = {0, borderX, image.width() - borderX, image.width()};
+        final float[] sourceY = {0, borderY, image.height() - borderY, image.height()};
+        for (int row = 0; row < 3; row++) for (int column = 0; column < 3; column++) {
+            image.region(graphics, targetX[column], targetY[row], targetX[column + 1] - targetX[column],
+                    targetY[row + 1] - targetY[row], sourceX[column], sourceY[row],
+                    sourceX[column + 1] - sourceX[column], sourceY[row + 1] - sourceY[row], -1);
+        }
+    }
+
+    void clear() {
+        this.images.clear();
+        this.failures.clear();
+    }
+
+    record Image(Identifier id, int width, int height, Object source) {
+        void draw(final GuiGraphicsExtractor graphics, final float x, final float y,
+                  final float width, final float height, final int color) {
+            this.region(graphics, x, y, width, height, 0, 0, this.width, this.height, color);
+        }
+
+        void region(final GuiGraphicsExtractor graphics, final float x, final float y,
+                    final float width, final float height, final float u, final float v,
+                    final float sourceWidth, final float sourceHeight, final int color) {
+            if (!Float.isFinite(width) || !Float.isFinite(height) || width == 0 || height == 0
+                    || sourceWidth <= 0 || sourceHeight <= 0) return;
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(x, y);
+                graphics.pose().scale(width / sourceWidth, height / sourceHeight);
+                graphics.blit(RenderPipelines.GUI_TEXTURED, this.id, 0, 0, u, v,
+                        (int) sourceWidth, (int) sourceHeight, (int) sourceWidth, (int) sourceHeight,
+                        this.width, this.height, color);
+            } finally {
+                graphics.pose().popMatrix();
+            }
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/hud/LocatorBarMotion.java b/src/main/java/com/viaversion/viafabricplus/bedrock/hud/LocatorBarMotion.java
