+package com.viaversion.viafabricplus.bedrock.hud;
+
+import java.util.Map;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.model.LocatorBarSnapshot;
+import net.raphimc.viabedrock.api.model.LocatorBarWaypoint;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarSessionTest {
+    @Test
+    void queuedSnapshotCannotRestoreStateAfterDisconnect() {
+        final var state = new LocatorBarSession();
+        final long beforeExit = state.generation();
+        final var populated = new LocatorBarSnapshot(Map.of(UUID.randomUUID(), LocatorBarWaypoint.EMPTY));
+        assertTrue(state.accept(beforeExit, populated));
+        state.clear();
+        assertFalse(state.accept(beforeExit, populated));
+        assertNull(state.snapshot());
+        final var empty = new LocatorBarSnapshot(Map.of());
+        assertTrue(state.accept(state.generation(), empty));
+        assertSame(empty, state.snapshot());
+    }
+}
