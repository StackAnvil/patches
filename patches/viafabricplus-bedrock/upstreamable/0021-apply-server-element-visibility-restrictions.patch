+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.v2.WrapWithCondition;
+import com.viaversion.viafabricplus.bedrock.hud.BedrockHudVisibility;
+import net.minecraft.client.DeltaTracker;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.Hud;
+import net.minecraft.client.gui.components.spectator.SpectatorGui;
+import net.minecraft.client.gui.contextualbar.ContextualBar;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.HudElement;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(Hud.class)
+public abstract class MixinBedrockHudVisibility {
+
+    @Inject(method = "extractCrosshair", at = @At("HEAD"), cancellable = true)
+    private void hideCrosshair(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.Crosshair)) ci.cancel();
+    }
+
+    @Inject(method = "extractItemHotbar", at = @At("HEAD"), cancellable = true)
+    private void hideHotbar(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.HotBar)) ci.cancel();
+    }
+
+    @Inject(method = "extractArmor", at = @At("HEAD"), cancellable = true)
+    private static void hideArmor(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.Armor)) ci.cancel();
+    }
+
+    @Inject(method = "extractHearts", at = @At("HEAD"), cancellable = true)
+    private void hideHealth(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.Health)) ci.cancel();
+    }
+
+    @Inject(method = "extractFood", at = @At("HEAD"), cancellable = true)
+    private void hideHunger(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.Hunger)) ci.cancel();
+    }
+
+    @Inject(method = "extractAirBubbles", at = @At("HEAD"), cancellable = true)
+    private void hideAir(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.AirBubbles)) ci.cancel();
+    }
+
+    @Inject(method = "extractVehicleHealth", at = @At("HEAD"), cancellable = true)
+    private void hideVehicleHealth(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.HorseHealth)) ci.cancel();
+    }
+
+    @Inject(method = "extractEffects", at = @At("HEAD"), cancellable = true)
+    private void hideEffects(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.StatusEffects)) ci.cancel();
+    }
+
+    @Inject(method = "extractSelectedItemName", at = @At("HEAD"), cancellable = true)
+    private void hideItemText(final CallbackInfo ci) {
+        if (BedrockHudVisibility.hidden(HudElement.ItemText)) ci.cancel();
+    }
+
+    @WrapWithCondition(method = "extractHotbarAndDecorations", at = {
+            @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/contextualbar/ContextualBar;extractBackground(Lnet/minecraft/client/gui/GuiGraphicsExtractor;Lnet/minecraft/client/DeltaTracker;)V"),
+            @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/contextualbar/ContextualBar;extractRenderState(Lnet/minecraft/client/gui/GuiGraphicsExtractor;Lnet/minecraft/client/DeltaTracker;)V")})
+    private boolean showProgress(final ContextualBar bar, final GuiGraphicsExtractor graphics, final DeltaTracker delta) {
+        return !BedrockHudVisibility.hidden(HudElement.ProgressBar);
+    }
+
+    @WrapWithCondition(method = "extractHotbarAndDecorations", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/gui/contextualbar/ContextualBar;extractExperienceLevel(Lnet/minecraft/client/gui/GuiGraphicsExtractor;Lnet/minecraft/client/gui/Font;I)V"))
+    private boolean showLevel(final GuiGraphicsExtractor graphics, final Font font, final int level) {
+        return !BedrockHudVisibility.hidden(HudElement.ProgressBar);
+    }
+
+    @WrapWithCondition(method = "extractHotbarAndDecorations", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/gui/components/spectator/SpectatorGui;extractHotbar(Lnet/minecraft/client/gui/GuiGraphicsExtractor;)V"))
+    private boolean showSpectatorHotbar(final SpectatorGui spectator, final GuiGraphicsExtractor graphics) {
+        return !BedrockHudVisibility.hidden(HudElement.HotBar);
+    }
+
+    @WrapWithCondition(method = "extractHotbarAndDecorations", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/gui/components/spectator/SpectatorGui;extractAction(Lnet/minecraft/client/gui/GuiGraphicsExtractor;)V"))
+    private boolean showSpectatorItemText(final SpectatorGui spectator, final GuiGraphicsExtractor graphics) {
+        return !BedrockHudVisibility.hidden(HudElement.ItemText);
+    }
+
+}
