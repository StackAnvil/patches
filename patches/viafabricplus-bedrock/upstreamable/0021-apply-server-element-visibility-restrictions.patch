@@ -0,0 +1,26 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.hud;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.HudVisibilityState;
+
+public record HudVisibilityPayload(HudVisibilityState state) implements CustomPacketPayload {
+
+    public static final Type<HudVisibilityPayload> TYPE = new Type<>(Identifier.parse(HudVisibilityState.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, HudVisibilityPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> HudVisibilityState.TYPE.write(buffer, payload.state),
+            buffer -> new HudVisibilityPayload(HudVisibilityState.TYPE.read(buffer)));
+
+    @Override
+    public Type<HudVisibilityPayload> type() {
+        return TYPE;
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinBedrockHudVisibility.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinBedrockHudVisibility.java
