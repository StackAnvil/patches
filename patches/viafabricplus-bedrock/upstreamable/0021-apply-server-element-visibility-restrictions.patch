+package com.viaversion.viafabricplus.bedrock.hud;
+
+import java.util.Set;
+import java.util.UUID;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class LocatorBarMotionTest {
+    @Test
+    void smoothingUsesElapsedTimeAndNativeDistanceRates() {
+        final UUID id = UUID.randomUUID();
+        final var thirtyFrames = new LocatorBarMotion();
+        final var sixtyFrames = new LocatorBarMotion();
+        thirtyFrames.advance(id, Vec3.ZERO, Vec3.ZERO, 0);
+        sixtyFrames.advance(id, Vec3.ZERO, Vec3.ZERO, 0);
+        final Vec3 target = new Vec3(100, 0, 0);
+        Vec3 a = Vec3.ZERO;
+        Vec3 b = Vec3.ZERO;
+        for (int frame = 0; frame < 30; frame++) a = thirtyFrames.advance(id, target, Vec3.ZERO, 1F / 30);
+        for (int frame = 0; frame < 60; frame++) b = sixtyFrames.advance(id, target, Vec3.ZERO, 1F / 60);
+        assertEquals(86.4664717, a.x, 0.00001);
+        assertEquals(a.x, b.x, 0.00001);
+        final var nearby = new LocatorBarMotion();
+        nearby.advance(id, Vec3.ZERO, Vec3.ZERO, 0);
+        assertEquals(8.64664717, nearby.advance(id, new Vec3(10, 0, 0), Vec3.ZERO, 0.1F).x, 0.00001);
+    }
+
+    @Test
+    void removalAndInvalidPositionsResetInterpolation() {
+        final UUID id = UUID.randomUUID();
+        final var motion = new LocatorBarMotion();
+        final Vec3 target = new Vec3(30, 10, 20);
+        motion.advance(id, Vec3.ZERO, Vec3.ZERO, 0);
+        motion.retain(Set.of());
+        assertEquals(target, motion.advance(id, target, Vec3.ZERO, 0));
+        assertNull(motion.advance(id, new Vec3(Double.NaN, 0, 0), Vec3.ZERO, 0.1F));
+        assertEquals(Vec3.ZERO, motion.advance(id, Vec3.ZERO, Vec3.ZERO, 0));
+        motion.clear();
+        assertEquals(target, motion.advance(id, target, Vec3.ZERO, 0));
+    }
+}
