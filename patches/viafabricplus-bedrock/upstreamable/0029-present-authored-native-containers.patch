+    private boolean playerEvents(final NativePlayerPresentation player, final NativeContainerInput.Result result) {
+        final var state = player.state();
+        InventoryOptions options = new InventoryOptions(state.leftTab(), state.rightTab(), state.filtering(),
+                state.inventoryLayout(), state.craftingLayout());
+        final var initial = options;
+        boolean handled = false;
+        for (final var event : result.events()) {
+            if (event.button() != null && event.button().phase() != 0 && event.button().phase() != 1) continue;
+            if (event.change() != null) {
+                final var change = event.change();
+                final String group = event.node().string("toggle_name", "");
+                if (change.group() != NativeUiInput.symbol(group)) throw new IllegalArgumentException("Mismatched player preference group");
+                if (player.idle()) {
+                    switch (group) {
+                        case "navigation_tab" -> options = new InventoryOptions(change.index(), options.rightTab(), options.filtering(), options.inventoryLayout(), options.craftingLayout());
+                        case "toggle.enableFiltering" -> options = new InventoryOptions(options.leftTab(), options.rightTab(), change.checked(), options.inventoryLayout(), options.craftingLayout());
+                        case "layout_toggle" -> {
+                            if (this.menu.getCarried().isEmpty()) options = new InventoryOptions(options.leftTab(), options.rightTab(), options.filtering(),
+                                    state.workbench() ? options.inventoryLayout() : change.index(), state.workbench() ? change.index() : options.craftingLayout());
+                        }
+                        default -> throw new IllegalArgumentException("Unknown native player preference");
+                    }
+                }
+                handled = true;
+            } else if (event.button() != null && event.button().transition() && event.button().target() == NativeUiInput.symbol("button.hide_bundle_tooltip")) {
+                handled |= this.tooltipSources.hide();
+            } else if (event.button() != null && event.button().pressed() && event.button().previous() != 1
+                    && event.button().target() == NativeUiInput.symbol("button.tapped_bundle_item_icon") && event.collection().equals("bundle_items")) {
+                // Native state52 consumes desktop mode2 cell input without changing selection.
+                if (this.tooltipSources.mode() == 1) this.fallback(new IllegalArgumentException("Retained bundle detail input is not supported"));
+                handled = true;
+            } else if (event.button() != null && event.button().transition()
+                    && playerUnsupportedHostAction(event.button().target())) {
+                this.fallback(new IllegalArgumentException("Native inventory host action is not supported"));
+                handled = true;
+            } else if (event.button() != null && event.button().target() == NativeUiInput.symbol("button.container_slot_hovered")) {
+                if (event.button().pressed()) player.select(event.collection(), event.collectionIndex());
+                else player.deselect(event.collection(), event.collectionIndex());
+            } else if (event.button() != null && event.button().transition()
+                    && event.button().target() == NativeUiInput.symbol("button.search_bar_clear")) {
+                BedrockNativePlayerInventory.query(this.owner, this.menu, "");
+                handled = true;
+            } else if (event.button() != null && event.button().pressed() && this.search != null
+                    && event.node().type().equals("edit_box") && event.button().target() == NativeUiInput.symbol("button.search_bar_selected")) {
+                if (event.button().handleSelect()) this.focusSearch();
+                else if (event.button().handleDeselect()) this.setFocused(null);
+                handled = true;
+            }
+        }
+        if (!options.equals(initial)) BedrockNativePlayerInventory.preferences(this.owner, this.menu, options);
+        return handled;
+    }
