+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeFurnacePreferenceStateTest {
+    @Test
+    void oldReceiversAndDisconnectsCannotOverwriteTheNewConnectionsIndependentFamilies() {
+        final var state = new NativeFurnacePreferenceState<Object>();
+        final var old = new Object();
+        final var current = new Object();
+        final var furnace = new FurnaceOptions(1, 4, true, 2);
+        final var smoker = new FurnaceOptions(3, 1, false, 1);
+        state.begin(old);
+        state.accept(old, furnace);
+        final long before = state.revision(old);
+        state.accept(old, furnace);
+        assertEquals(before, state.revision(old));
+        state.accept(old, smoker);
+        assertTrue(state.revision(old) > before);
+        assertEquals(furnace, state.options(old, 1));
+        assertEquals(smoker, state.options(old, 3));
+        state.begin(current);
+        state.accept(old, furnace);
+        state.clear(old);
+        assertNull(state.options(current, 1));
+        assertEquals(-1, state.revision(old));
+        state.accept(current, smoker);
+        state.accept(null, furnace);
+        assertEquals(smoker, state.options(current, 3));
+        state.accept(current, new FurnaceOptions(3, Integer.MIN_VALUE, true, Integer.MAX_VALUE));
+        assertEquals(Integer.MIN_VALUE, state.options(current, 3).leftTab());
+        state.clear(current);
+        state.accept(current, smoker);
+        assertNull(state.options(current, 3));
+        assertEquals(-1, state.revision(current));
+    }
+}
