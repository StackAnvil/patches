+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+
+public record NativeBundleActionPayload(NativeBundleAction action) implements CustomPacketPayload {
+    public static final Type<NativeBundleActionPayload> TYPE = new Type<>(Identifier.parse(NativeBundleAction.CHANNEL));
+    public static final Type<NativeBundleActionPayload> SELECTION_TYPE = new Type<>(Identifier.parse(NativeBundleAction.SELECTION_CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeBundleActionPayload> SELECTION_CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeBundleAction.SELECTION_TYPE.write(buffer, payload.action),
+            buffer -> new NativeBundleActionPayload(NativeBundleAction.SELECTION_TYPE.read(buffer)));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeBundleActionPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeBundleAction.TYPE.write(buffer, payload.action),
+            buffer -> new NativeBundleActionPayload(NativeBundleAction.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeBundleActionPayload> type() { return this.action.channel().equals(NativeBundleAction.SELECTION_CHANNEL) ? SELECTION_TYPE : TYPE; }
+}
