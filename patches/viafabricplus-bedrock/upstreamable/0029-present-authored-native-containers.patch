+    private static Object get(final Object target, final String name) throws Exception {
+        final var field = target.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        return field.get(target);
+    }
+
+    private static void set(final Class<?> type, final Object target, final String name, final Object value) throws Exception {
+        final var field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    private static MouseButtonEvent pointer(final BedrockNativeContainerScreen screen,
+                                           final Predicate<NativeUiPresentation.Draw> matches) throws Exception {
+        final var field = BedrockNativeContainerScreen.class.getDeclaredField("draws");
+        field.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        final var draws = (List<NativeUiPresentation.Draw>) field.get(screen);
+        final var box = draws.stream().filter(matches).filter(draw -> draw.enabled() && draw.alpha() > 0)
+                .map(draw -> draw.box().visibleBounds()).filter(bounds -> bounds.width() > 0 && bounds.height() > 0).findFirst().orElseThrow();
+        return new MouseButtonEvent(box.x() + box.width() / 2, box.y() + box.height() / 2,
+                new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+    }
+}
