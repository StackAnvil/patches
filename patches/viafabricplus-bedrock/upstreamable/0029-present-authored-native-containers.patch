+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+final class NativeContainerPresentation implements NativeInventoryPresentation {
+    private final ContainerUi program;
+    private final ContainerUi.Kind kind;
+    private List<Integer> data;
+    private long revision;
+
+    NativeContainerPresentation(final ContainerUi program, final ContainerUi.Kind kind, final List<Integer> data) {
+        this.program = program;
+        this.kind = kind;
+        this.data(data);
+    }
+
+    ContainerUi.Kind kind() { return this.kind; }
+
+    void data(final List<Integer> values) {
+        this.kind.validateData(values);
+        if (!values.equals(this.data)) {
+            this.data = List.copyOf(values);
+            this.revision++;
+        }
+    }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags) {
+        final var scene = this.program.resolve(new ContainerUi.MenuView(menuId, this.kind, title, slots, cursor, this.data));
+        if (scene == null) throw new IllegalArgumentException("Unresolved native inventory presentation");
+        return new Frame(scene, this.kind.containerSlots(), Map.of(), new CookingUi.RecipeActionScope(Map.of()));
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java
new file mode 100644
