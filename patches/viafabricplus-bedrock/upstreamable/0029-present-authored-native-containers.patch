+        final var recipe = this.geometry.recipe(event.x(), event.y());
+        if (recipe != null) {
+            this.capturedButtons.add(event.button());
+            final var mode = recipe.inputs().get(input);
+            if (mode != null && BedrockNativeCooking.action(this.owner, this.menu, recipe.id(), mode, 0))
+                this.recipePress = new RecipePress(event.button(), recipe.id(), mode);
+            return true;
+        }
+        if (this.actionScope.subset()) {
+            if (this.activated && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+                final int slot = this.geometry.hovered(event.x(), event.y());
+                if (this.actionScope.slots().contains(slot) && this.menu.slots.get(slot).isActive())
+                    this.send(NativeContainerAction.Mode.AUTO_PLACE_ONE, slot);
+            }
+            return true;
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    private static String source(final int button) {
+        return switch (button) {
+            case InputConstants.MOUSE_BUTTON_LEFT -> "button.menu_select";
+            case InputConstants.MOUSE_BUTTON_RIGHT -> "button.menu_secondary_select";
+            default -> "";
+        };
+    }
+
+    @Override
+    public void mouseMoved(final double x, final double y) {
+        if (this.current() && this.presentation instanceof NativeCookingPresentation) {
+            final var result = this.nativeInput.pointer(x, y, 1, this.clock.getAsLong(), this.componentEnabled());
+            if (!this.waitingForPreference()) this.componentEvents(result);
+        }
+        super.mouseMoved(x, y);
+    }
+
+    private boolean componentEnabled() {
+        return this.presentation instanceof NativeCookingPresentation cooking && cooking.idle()
+            && !this.waitingForPreference() && this.capturedButtons.isEmpty();
+    }
+
+    private boolean componentEvents(final NativeContainerInput.Result result) {
+        if (!(this.presentation instanceof NativeCookingPresentation cooking)) return false;
+        final var message = cooking.message();
+        final var initial = NativeCookingPreferenceControl.snapshot(message.view().family(), message.view().book());
+        FurnaceOptions desired = initial;
+        boolean handled = false;
+        for (final var event : result.events()) {
+            if (event.button() != null && event.button().phase() != 0 && event.button().phase() != 1) continue;
+            if (event.change() != null) {
+                final var preference = NativeCookingPreferenceControl.parse(event.node());
+                if (preference != null) {
+                    desired = this.changePreference(preference, event.change(), desired);
+                    handled = true;
+                }
+            } else if (NativeCookingNavigation.supports(event.button().target())) {
+                if (cooking.idle() && this.nativeInput.enabled(event.node())
+                        && message.updateSequence() == this.cookingUpdate && Minecraft.getInstance().gui.screen() == this) {
+                    final var transition = NativeCookingNavigation.transition(desired, message.view().book(), event.button());
+                    desired = transition.options();
+                    if (transition.refresh()) cooking.tabChanged();
+                }
+                handled = true;
+            } else {
+                if (event.button().target() == NativeUiInput.symbol("button.filter_toggle_hovered") && event.button().pressed())
+                    cooking.select("filter_toggle", 0);
+                else if (event.button().target() == NativeUiInput.symbol("button.container_slot_hovered")) {
+                    final String collection = event.node().string("collection", "");
+                    if (event.button().pressed()) cooking.select(collection, event.collectionIndex());
+                    else cooking.deselect(collection, event.collectionIndex());
+                }
+            }
+        }
+        if (!desired.equals(initial)) {
+            this.preferenceChange = new PreferenceChange(message.updateSequence(), this.clock.getAsLong(), desired);
+            try {
+                if (!BedrockFurnacePreferences.change(this.owner.getConnection(), desired))
+                    throw new IllegalStateException("Unable to send native cooking preference");
+            } catch (final RuntimeException error) { this.fallback(error); }
+        }
+        return handled;
+    }
+
+    private FurnaceOptions changePreference(final NativeCookingPreferenceControl control, final NativeUiToggle.Change change,
+                                            final FurnaceOptions current) {
+        if (!(this.presentation instanceof NativeCookingPresentation cooking) || !cooking.idle()
+                || Minecraft.getInstance().gui.screen() != this
+                || control.kind() == NativeCookingPreferenceControl.Kind.LAYOUT && !this.menu.getCarried().isEmpty()) return current;
+        final var message = cooking.message();
+        if (message.updateSequence() != this.cookingUpdate) return current;
+        try {
+            return control.options(current, message.view().book().forcedRecipeBookLayout(), change);
+        } catch (final RuntimeException error) { this.fallback(error); return current; }
+    }
+
+    private boolean waitingForPreference() {
+        if (this.preferenceChange == null || !(this.presentation instanceof NativeCookingPresentation cooking)) return false;
+        final var message = cooking.message();
+        final var book = message.view().book();
+        final var expected = this.preferenceChange.expected;
+        if (message.updateSequence() > this.preferenceChange.update && book.tab() == expected.leftTab()
+                && book.filtering() == expected.filtering() && book.effectiveLayout() == expected.layout()) {
+            this.preferenceChange = null;
+            return false;
+        }
+        return true;
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double dx, final double dy) {
+        if (this.presentation instanceof NativeCookingPresentation) this.mouseMoved(event.x(), event.y());
+        if (this.capturedButtons.contains(event.button()) || this.nativeButtons.contains(event.button())) return true;
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.drag(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseDragged(event, dx, dy);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (this.current() && this.presentation instanceof NativeCookingPresentation) {
+            final var hover = this.nativeInput.pointer(event.x(), event.y(), 1, this.clock.getAsLong(), this.componentEnabled());
+            final var released = this.nativeInput.button(source(event.button()), false, 1, this.clock.getAsLong(), this.componentEnabled());
+            if (!this.waitingForPreference()) { this.componentEvents(hover); this.componentEvents(released); }
+        }
+        if (this.nativeButtons.remove(event.button())) {
+            this.consumedReleases.add(event.button());
+            return true;
+        }
+        if (this.capturedButtons.remove(event.button())) {
+            this.consumedReleases.add(event.button());
+            final var press = this.recipePress;
+            if (press != null && press.button == event.button()) {
+                this.recipePress = null;
+                BedrockNativeCooking.action(this.owner, this.menu, press.recipe, press.mode, 2);
+            }
+            return true;
+        }
+        if (this.consumedReleases.contains(event.button())) return true;
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.release()) {
+            this.scrollAnimation(true);
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseReleased(event);
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (!this.current()) return false;
+        if (this.waitingForPreference()) {
+            if (event.key() == InputConstants.KEY_ESCAPE) this.onClose();
+            else {
+                final String source = keyboardSource(event.key());
+                if (source != null) this.nativeInput.button(source, true, 1, this.clock.getAsLong(), false);
+                if (event.key() == InputConstants.KEY_RETURN || event.key() == InputConstants.KEY_SPACE) this.keyboardPressed = true;
+            }
+            return true;
+        }
+        if (this.presentation instanceof NativeCookingPresentation) {
+            final String source = keyboardSource(event.key());
+            if (source != null) {
+                if (event.key() == InputConstants.KEY_RETURN || event.key() == InputConstants.KEY_SPACE) this.keyboardPressed = true;
+                return this.keyboardInput(source, true);
+            }
+        }
+        if (!this.actionScope.subset()) return super.keyPressed(event);
+        if (event.key() == InputConstants.KEY_ESCAPE
+                || this.minecraft.options.keyInventory.matches(event)) this.onClose();
+        return true;
+    }
+
+    private boolean supportsKeyboardInput(final NativeUiScene.Node node, final NativeUiInput.Mapping mapping) {
+        if (mapping.scope() == NativeUiInput.Scope.VIEW) return NativeContainerInput.supportsViewTarget(mapping.target());
+        final int target = mapping.target();
+        if (node.type().equals("toggle") || target == NativeUiInput.symbol("button.container_slot_hovered")
+                || NativeCookingNavigation.supports(target)) return true;
+        if (node.properties().has("recipe_id")) {
+            final int recipe = node.properties().get("recipe_id").getAsInt();
+            return this.recipeActions.getOrDefault(recipe, Set.of()).stream().anyMatch(action -> NativeUiInput.symbol(action) == target);
+        }
+        if (node.properties().has("inventory_slot"))
+            return this.nativeActions && this.actionScope.subset() && target == NativeUiInput.symbol("button.container_auto_place_one");
+        return node.string("inventory_command", "").equals("close")
+            && (target == NativeUiInput.symbol("button.menu_exit") || target == NativeUiInput.symbol("button.try_menu_exit"));
+    }
+
+    private boolean keyboardEvents(final NativeContainerInput.Result result) {
+        boolean handled = this.componentEvents(result);
+        for (final var event : result.events()) {
+            final var button = event.button();
+            if (button == null || button.phase() != 0 && button.phase() != 1) continue;
+            final var node = event.node();
+            if (node.properties().has("recipe_id")) {
+                final int recipe = node.properties().get("recipe_id").getAsInt();
+                final var mode = java.util.Arrays.stream(NativeCookingAction.Mode.values())
+                    .filter(candidate -> NativeUiInput.symbol(candidate.button()) == button.target()).findFirst().orElse(null);
+                if (mode != null && this.recipeActions.getOrDefault(recipe, Set.of()).contains(mode.button())) {
+                    if (button.transition() && this.recipePress == null && BedrockNativeCooking.action(this.owner, this.menu, recipe, mode, 0))
+                        this.recipePress = new RecipePress(-1, recipe, mode);
+                    handled = true;
+                }
+            } else if (button.transition() && button.target() == NativeUiInput.symbol("button.container_auto_place_one")
+                    && node.properties().has("inventory_slot")) {
+                final int slot = node.properties().get("inventory_slot").getAsInt();
+                if (this.activated && this.actionScope.slots().contains(slot) && this.menu.slots.get(slot).isActive())
+                    this.send(NativeContainerAction.Mode.AUTO_PLACE_ONE, slot);
+                handled = true;
+            } else if (button.transition() && node.string("inventory_command", "").equals("close")
+                    && (button.target() == NativeUiInput.symbol("button.menu_exit") || button.target() == NativeUiInput.symbol("button.try_menu_exit"))) {
+                this.onClose();
+                handled = true;
+            }
+        }
+        return handled || result.consumed();
+    }
+
+    private static String keyboardSource(final int key) {
+        return switch (key) {
+            case InputConstants.KEY_UP -> "button.menu_up";
+            case InputConstants.KEY_DOWN -> "button.menu_down";
+            case InputConstants.KEY_LEFT -> "button.menu_left";
+            case InputConstants.KEY_RIGHT -> "button.menu_right";
+            case InputConstants.KEY_RETURN, InputConstants.KEY_SPACE -> "button.menu_ok";
+            default -> null;
+        };
+    }
+
+    private boolean keyboardInput(final String source, final boolean pressed) {
+        final var previous = this.nativeInput.focused();
+        final var result = this.nativeInput.button(source, pressed, 1, this.clock.getAsLong(), this.componentEnabled());
+        final boolean handled = !this.waitingForPreference() && this.keyboardEvents(result);
+        return handled || previous != this.nativeInput.focused() || result.consumed();
+    }
+
+    private void revealFocus(final NativeUiScene.Node focused) {
+        if (this.scroll.reveal(this.root, focused)) this.scrollAnimation(true);
+        this.layout(this.animationTime(), -1, -1);
+    }
+
+    @Override
+    public boolean keyReleased(final KeyEvent event) {
+        final String source = keyboardSource(event.key());
+        if (this.current() && this.presentation instanceof NativeCookingPresentation && source != null) {
+            final boolean handled = this.keyboardInput(source, false);
+            if (event.key() != InputConstants.KEY_RETURN && event.key() != InputConstants.KEY_SPACE) return handled;
+            final var press = this.recipePress;
+            if (press != null && press.button == -1) {
+                this.recipePress = null;
+                BedrockNativeCooking.action(this.owner, this.menu, press.recipe, press.mode, 2);
+            }
+            final boolean consumed = this.keyboardPressed;
+            this.keyboardPressed = false;
+            return consumed || handled;
+        }
+        return super.keyReleased(event);
+    }
+
+    void fallback(final RuntimeException error) {
+        if (this.fallingBack) return;
+        this.fallingBack = true;
+        try {
+            this.deactivate();
+            this.retireCooking();
+        } catch (final RuntimeException transportError) {
+            if (transportError != error) error.addSuppressed(transportError);
+        } finally {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn(
+                            "Unsupported native inventory presentation; retaining ordinary menu"
+                                    + " controls",
+                            error);
+            // Controller retirement must not prevent restoring the still-displayed menu.
+            final var client = net.minecraft.client.Minecraft.getInstance();
+            if (client.gui.screen() == this && client.getConnection() == this.owner
+                    && this.owner.getConnection().isConnected() && client.player != null && client.player.containerMenu == this.menu)
+                BedrockNativeContainers.replace(this.ordinary);
+        }
+    }
+
+    private void retireCooking() {
+        this.capturedButtons.clear();
+        this.nativeButtons.clear();
+        this.keyboardPressed = false;
+        this.consumedReleases.clear();
+        this.recipePress = null;
+        this.preferenceChange = null;
+        if (this.presentation instanceof NativeCookingPresentation cooking)
+            BedrockNativeCooking.retire(this.owner, this.menu, cooking);
+    }
+
+    void discard() { if (this.renderer != null) this.renderer.close(); this.images.close(); }
+
+    @Override
+    public void removed() {
+        try {
+            this.deactivate();
+            this.retireCooking();
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn("Unable to retire native inventory activation", error);
+        } finally {
+            try {
+                this.discard();
+            } finally {
+                super.removed();
+            }
+        }
+    }
+}
