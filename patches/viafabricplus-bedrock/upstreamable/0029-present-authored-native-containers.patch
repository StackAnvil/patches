+import net.raphimc.viabedrock.api.model.NativeCookingQueryResult;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldAction;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldResult;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceAction;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceResult;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+class NativeCookingActionsTest {
+    private static NativeCookingMessage first;
+    private static final CookingUi.RecipeActionScope ALL_COMMANDS = new CookingUi.RecipeActionScope(Map.of(7,
+            Set.of(NativeCookingAction.Mode.PRIMARY.button(), NativeCookingAction.Mode.SECONDARY.button(), NativeCookingAction.Mode.TERTIARY.button())));
+
+    @Test
+    void sourceDrawingRetainsItsOriginalFrameAndBlocksOtherCommandsThroughCompletion() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingSourceAction>();
+        assertTrue(actions.source(0, 4, 4, NativeCookingSourceAction.Kind.DRAW, sent::add));
+        final var source = sent.getFirst();
+        assertEquals(NativeCookingControl.forMessage(first, NativeCookingControl.Mode.ACTIVATE), source.source());
+        assertEquals(4, source.quantity());
+        assertTrue(actions.sourcePending());
+        assertFalse(actions.sourceAdmitted());
+        assertFalse(actions.query("food", _ -> fail("The source command owns input")));
+        assertFalse(actions.hold(0, NativeCookingHoldAction.Phase.START, 0, _ -> fail("The source command owns input")));
+        actions.update(update(2));
+        assertTrue(actions.result(new NativeCookingSourceResult(source, true, false)));
+        assertTrue(actions.sourceAdmitted());
+        assertFalse(actions.query("food", _ -> fail("Drawing retains its input owner")));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, _ -> fail("Drawing retains its input owner")));
+        actions.finishSourceDrawing();
+        final var queries = new ArrayList<NativeCookingQuery>();
+        assertTrue(actions.query("food", queries::add));
+        assertEquals(2, queries.getFirst().requestSequence());
+        assertEquals(2, queries.getFirst().source().updateSequence());
+        assertFalse(actions.result(new NativeCookingSourceResult(source, false, false)));
+        assertTrue(actions.queryPending());
+    }
+
+    @Test
+    void aTapWaitsForReplacementAuthorityUnlessItArrivedBeforeTheReply() {
+        for (final boolean earlyFrame : new boolean[]{false, true}) {
+            final var actions = new NativeCookingActions(first, () -> 0);
+            final var sent = new ArrayList<NativeCookingSourceAction>();
+            assertTrue(actions.source(0, 4, 1, NativeCookingSourceAction.Kind.TAP, sent::add));
+            if (earlyFrame) actions.update(update(2));
+            assertTrue(actions.result(new NativeCookingSourceResult(sent.getFirst(), true, false)));
+            assertFalse(actions.sourceDrawing());
+            if (!earlyFrame) {
+                assertFalse(actions.idle());
+                actions.update(update(2));
+            }
+            assertTrue(actions.idle());
+        }
+    }
+
+    @Test
+    void reentrantSourceRepliesCannotSendAnotherCommandBeforeDispatchReturns() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        assertTrue(actions.source(0, 4, 9, NativeCookingSourceAction.Kind.DRAW, action -> {
+            assertTrue(actions.result(new NativeCookingSourceResult(action, true, false)));
+            assertFalse(actions.source(0, 5, 9, NativeCookingSourceAction.Kind.DRAW, _ -> fail("No nested send")));
+        }));
+        assertTrue(actions.sourceAdmitted());
+    }
+
+    @Test
+    void aReplyWithAnotherSnapshotCannotReleaseThePendingSourceCommand() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingSourceAction>();
+        assertTrue(actions.source(0, 4, 9, NativeCookingSourceAction.Kind.DRAW, sent::add));
+        final var forged = new NativeCookingSourceAction(NativeCookingControl.forMessage(update(2), NativeCookingControl.Mode.ACTIVATE),
+                0, 4, 9, NativeCookingSourceAction.Kind.DRAW, sent.getFirst().requestSequence());
+        assertFalse(actions.result(new NativeCookingSourceResult(forged, true, false)));
+        assertTrue(actions.sourcePending());
+        assertFalse(actions.sourceAdmitted());
+    }
+
+    @Test
+    void anAmbiguousSourceSendRetainsExactlyOneTerminalDrawingRelease() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingSourceAction>();
+        assertThrows(IllegalStateException.class, () -> actions.source(0, 4, 9, NativeCookingSourceAction.Kind.DRAW, action -> {
+            sent.add(action);
+            throw new IllegalStateException("Transport failed after dispatch");
+        }));
+        assertTrue(actions.cancel(_ -> fail("No recipe release"), _ -> fail("No held release"), sent::add));
+        assertFalse(actions.cancel(_ -> fail("No recipe release"), _ -> fail("No held release"), sent::add));
+        assertEquals(2, sent.size());
+        assertTrue(sent.getLast().continues(sent.getFirst()));
+        assertFalse(actions.idle());
+    }
+
+    @Test
+    void aTimedOutSourceReplyCannotReviveTheRetiredPresentation() {
+        final var now = new AtomicLong();
+        final var actions = new NativeCookingActions(first, now::get);
+        final var sent = new ArrayList<NativeCookingSourceAction>();
+        assertTrue(actions.source(0, 4, 4, NativeCookingSourceAction.Kind.TAP, sent::add));
+        now.set(10_000_000_000L);
+        assertTrue(actions.expired());
+        assertFalse(actions.result(new NativeCookingSourceResult(sent.getFirst(), true, true)));
+        assertThrows(IllegalArgumentException.class, () -> actions.update(update(2)));
+        assertFalse(actions.idle());
+    }
+
+    @BeforeAll
+    static void bootstrap() throws Exception {
+        NativeCookingPresentationTest.bootstrap();
+        first = NativeCookingPresentationTest.message(CookingUi.Family.FURNACE, 1);
+    }
+
+    @Test
+    void bundleRepliesWaitForFreshAuthorityAndShareSearchAndHoldRequestOrder() {
+        for (final boolean snapshotFirst : new boolean[]{false, true}) {
+            final var actions = new NativeCookingActions(first, () -> 0);
+            final var bundles = new ArrayList<NativeCookingBundleAction>();
+            final var queries = new ArrayList<NativeCookingQuery>();
+            final var holds = new ArrayList<NativeCookingHoldAction>();
+            actions.presented(first, ALL_COMMANDS);
+            assertTrue(actions.bundle("inventory_items", 0, NativeBundleAction.Kind.SECONDARY, 2, 3, bundles::add));
+            final var action = bundles.getFirst();
+            assertFalse(actions.query("ore", queries::add));
+            assertFalse(actions.hold(3, NativeCookingHoldAction.Phase.START, 0, holds::add));
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, ignored -> fail("A bundle owns the input")));
+            final var source = action.source();
+            final var wrong = new NativeCookingBundleAction(new NativeCookingControl(source.menuId(), source.sequence(),
+                    source.updateSequence(), source.menuRevision(), source.inventoryRevision(), source.cursorRevision() + 1,
+                    NativeCookingControl.Mode.ACTIVATE), action.collection(), action.index(), action.kind(),
+                    action.tooltipMode(), action.selectedCell(), action.requestSequence());
+            assertFalse(actions.result(NativeCookingBundleResult.reply(wrong, true, false)));
+            if (snapshotFirst) actions.update(update(2));
+            assertTrue(actions.result(NativeCookingBundleResult.reply(action, true, false)));
+            if (!snapshotFirst) {
+                assertFalse(actions.idle(), "An acknowledgment alone cannot renew item authority");
+                actions.update(update(2));
+            }
+            assertTrue(actions.idle());
+            assertFalse(actions.result(NativeCookingBundleResult.reply(action, true, false)));
+            assertTrue(actions.query("ore", queries::add));
+            assertEquals(2, queries.getFirst().requestSequence());
+            assertTrue(actions.result(new NativeCookingQueryResult(queries.getFirst(), true)));
+            actions.update(update(3));
+            assertTrue(actions.hold(3, NativeCookingHoldAction.Phase.START, 0, holds::add));
+            assertEquals(3, holds.getFirst().requestSequence());
+        }
+    }
+
+    @Test
+    void nonmutatingBundleResultsKeepTheCurrentFrameUsable() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingBundleAction>();
+        assertTrue(actions.bundle("hotbar_items", 0, NativeBundleAction.Kind.SECONDARY, 2, -1, sent::add));
+        assertTrue(actions.result(NativeCookingBundleResult.reply(sent.getFirst(), true, true)));
+        assertTrue(actions.idle());
+        assertTrue(actions.query("ore", ignored -> {}));
+    }
+
+    @Test
+    void missingBundlePublicationsTimeOutAndRetirementRejectsLateResults() {
+        final var clock = new AtomicLong();
+        final var actions = new NativeCookingActions(first, clock::get);
+        final var sent = new ArrayList<NativeCookingBundleAction>();
+        assertTrue(actions.bundle("hotbar_items", 0, NativeBundleAction.Kind.PRIMARY, 0, -1, sent::add));
+        assertTrue(actions.result(NativeCookingBundleResult.reply(sent.getFirst(), true, false)));
+        clock.set(10_000_000_000L);
+        assertTrue(actions.expired());
+        assertFalse(actions.bundle("hotbar_items", 0, NativeBundleAction.Kind.PRIMARY, 0, -1, sent::add));
+        actions.retire();
+        assertFalse(actions.result(NativeCookingBundleResult.reply(sent.getFirst(), true, false)));
+        assertEquals(1, sent.size());
+    }
+
+    @Test
+    void followUpPhasesRetainOriginalAuthorityAcrossNewFramesAndOutOfOrderReplies() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        final var next = update(2);
+        actions.update(next);
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 1, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 1, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertEquals(3, sent.size());
+        for (int phase = 0; phase < 3; phase++) assertEquals(new NativeCookingAction(first.menuId(), first.sequence(), first.updateSequence(),
+                first.menuRevision(), first.inventoryRevision(), first.cursorRevision(), 7, NativeCookingAction.Mode.PRIMARY, 1, phase, phase + 1), sent.get(phase));
+        actions.presented(next, ALL_COMMANDS);
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(2), true, false)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(0), true, false)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(1), true, false)));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertEquals(new NativeCookingAction(next.menuId(), next.sequence(), next.updateSequence(), next.menuRevision(),
+                next.inventoryRevision(), next.cursorRevision(), 7, NativeCookingAction.Mode.PRIMARY, 1, 0, 4), sent.getLast());
+    }
+
+    @Test
+    void onlyPresentedCommandsCanStartInputButUpdatedScopesCannotStrandItsRelease() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        actions.presented(first, new CookingUi.RecipeActionScope(Map.of(7, Set.of(NativeCookingAction.Mode.PRIMARY.button()))));
+        assertFalse(actions.send(8, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.SECONDARY, 1, 0, sent::add));
+        for (final int phase : new int[]{-1, 1, 2, 3}) assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, phase, sent::add));
+        assertTrue(sent.isEmpty());
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        actions.update(update(2));
+        assertThrows(IllegalArgumentException.class, () -> actions.presented(first, ALL_COMMANDS));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.SECONDARY, 1, 2, sent::add));
+        assertFalse(actions.send(8, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
