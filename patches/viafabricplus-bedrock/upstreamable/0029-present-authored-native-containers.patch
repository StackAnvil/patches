@@ -0,0 +1,133 @@
+package com.viaversion.viafabricplus.bedrock.screen.ui;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.form.BedrockFormScene;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeUiFontTest {
+    private static final NativeUiLayout.Metrics METRICS = new NativeUiLayout.Metrics() {
+        @Override
+        public NativeUiLayout.Size intrinsic(final NativeUiScene.Node node) {
+            return NativeUiFont.intrinsic(node, 60, 1, 9);
+        }
+
+        @Override
+        public NativeUiLayout.Size constrained(final NativeUiScene.Node node, final float width) {
+            return NativeUiFont.constrained(node, width, Math.ceilDiv(60, NativeUiFont.wrapWidth(node, width)), 9);
+        }
+    };
+
+    @Test
+    void measuresNativeFontSizesAndAuthoredFactorsThroughWrappedStackLayout() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonArray children = new JsonArray();
+        for (final String size : new String[] {"small", "normal", "large", "extra_large"}) {
+            final JsonObject label = node("label", 30, "default");
+            label.addProperty("font_size", size);
+            children.add(label);
+        }
+        root.add("children", children);
+        final var box = layout(root);
+        final float[] heights = {4.5F, 18, 72, 324};
+        float position = 0;
+        for (int i = 0; i < heights.length; i++) {
+            assertEquals(heights[i], box.children().get(i).bounds().height());
+            assertEquals(position, box.children().get(i).bounds().y());
+            position += heights[i];
+        }
+        assertEquals(position, box.bounds().height());
+
+        children.get(3).getAsJsonObject().addProperty("font_scale_factor", .4F);
+        children.get(0).getAsJsonObject().addProperty("font_scale_factor", .64F);
+        final var scaled = layout(root);
+        assertEquals(2.88F, scaled.children().getFirst().bounds().height(), .0001F);
+        assertEquals(57.6F, scaled.children().get(3).bounds().height(), .0001F);
+    }
+
+    @Test
+    void preservesFixedClippingAndZeroSizeWithoutRemappingResponseControls() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonObject large = node("label", 30, 12);
+        large.addProperty("font_size", "large");
+        final JsonObject zero = node("label", "default", "default");
+        zero.addProperty("font_scale_factor", 0);
+        final JsonObject hidden = node("label", 30, 90);
+        hidden.addProperty("font_scale_factor", -1);
+        hidden.addProperty("visible", false);
+        final JsonObject button = node("button", 30, 20);
+        button.addProperty("action", 0);
+        final JsonArray children = new JsonArray();
+        for (final var child : new JsonObject[] {large, zero, hidden, button}) children.add(child);
+        root.add("children", children);
+        final var box = layout(root);
+        assertEquals(12, box.children().getFirst().visibleBounds().height());
+        assertEquals(0, box.children().get(1).bounds().width());
+        assertEquals(0, box.children().get(1).bounds().height());
+        assertEquals(0, box.children().get(2).bounds().height());
+        assertEquals(12, box.children().get(3).bounds().y());
+        assertEquals(0, box.children().get(3).node().action());
+        hidden.addProperty("visible", true);
+        assertThrows(IllegalArgumentException.class, () -> layout(root));
+    }
+
+    @Test
+    void usesNativeNormalFallbackAndPreservesSmallFactorsWithoutClamping() {
+        final JsonObject label = node("label", "default", "default");
+        assertEquals(new NativeUiLayout.Rect(0, 0, 60, 9), layout(label).bounds());
+        label.addProperty("font_size", "unknown");
+        assertEquals(new NativeUiLayout.Rect(0, 0, 60, 9), layout(label).bounds());
+        label.addProperty("font_scale_factor", .0625F);
+        assertEquals(new NativeUiLayout.Rect(0, 0, 3.75F, .5625F), layout(label).bounds());
+    }
+
+    @Test
+    void keepsFractionalFamilyLineAdvancesThroughWrappedStackLayout() {
+        final JsonObject root = node("stack_panel", 30, "100%c");
+        final JsonObject title = node("label", 30, "default");
+        title.addProperty("font_size", "large");
+        title.addProperty("font_line_height", 11.8125F);
+        final JsonObject fallback = node("label", 30, "default");
+        final JsonArray children = new JsonArray();
+        children.add(title);
+        children.add(fallback);
+        root.add("children", children);
+        final var box = layout(root);
+        assertEquals(94.5F, box.children().getFirst().bounds().height());
+        assertEquals(94.5F, box.children().get(1).bounds().y());
+        assertEquals(112.5F, box.bounds().height());
+        assertEquals(11.8125F, NativeUiFont.lineHeight(box.children().getFirst().node(), 9));
+        assertEquals(9, NativeUiFont.lineHeight(box.children().get(1).node(), 9));
+        title.addProperty("font_line_height", -1);
+        assertThrows(IllegalArgumentException.class, () -> layout(root));
+    }
+
+    private static NativeUiLayout.Box layout(final JsonObject root) {
+        root.addProperty("anchor_from", "top_left");
+        root.addProperty("anchor_to", "top_left");
+        final JsonObject scene = new JsonObject();
+        scene.addProperty("format", 1);
+        scene.add("root", root);
+        final JsonObject fallback = new JsonObject();
+        final JsonArray buttons = new JsonArray();
+        buttons.add(new JsonObject());
+        fallback.add("buttons", buttons);
+        scene.add("fallback", fallback);
+        return new NativeUiLayout(METRICS).layout(BedrockFormScene.parse(scene.toString()).root(), 200, 500, Map.of());
+    }
+
+    private static JsonObject node(final String type, final Object width, final Object height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("type", type);
+        final JsonArray size = new JsonArray();
+        for (final Object value : new Object[] {width, height}) {
+            if (value instanceof Number number) size.add(number);
+            else size.add(value.toString());
+        }
+        node.add("size", size);
+        return node;
+    }
+}
