index 0000000..42d8a59
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerGeometry.java
@@ -0,0 +1,194 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+
+/** Authored, clipped controls share one front-to-back policy for slot and command input. */
+final class NativeContainerGeometry {
+    private static final Set<String> RECIPE_MAPPING_FIELDS = Set.of("from_button_id", "to_button_id", "mapping_type", "ignored", "consume_event");
+    private final List<ControlRegion> controls;
+    private final Set<Integer> registered = new HashSet<>();
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount) {
+        this(draws, slotCount, Map.of());
+    }
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount,
+                            final Map<Integer, Set<String>> recipeActions) {
+        this(draws, slotCount, recipeActions, false);
+    }
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount,
+                            final Map<Integer, Set<String>> recipeActions, final boolean cooking) {
+        final List<ControlRegion> regions = new ArrayList<>();
+        for (final var draw : draws) {
+            final var box = draw.box();
+            final var node = box.node();
+            final var recipe = recipe(node, draw.enabled(), recipeActions);
+            final var preference = cooking ? NativeCookingPreferenceControl.parse(node) : null;
+            validateActions(node, recipe);
+            final boolean mappedSlot = node.properties().has("inventory_actions") && node.properties().has("inventory_slot");
+            final boolean command = node.type().equals("button") && node.string("inventory_command", "").equals("close");
+            if (mappedSlot && recipe != null) throw new IllegalArgumentException("Recipe control cannot also own an inventory slot");
+            if (!mappedSlot && !command && recipe == null && preference == null) continue;
+            final int slot = mappedSlot ? node.properties().get("inventory_slot").getAsInt() : -1;
+            if (mappedSlot && (slot < 0 || slot >= slotCount))
+                throw new IllegalArgumentException("Invalid native inventory slot");
+            // A mapped control remains registered while its entrance animation has zero extent.
+            // Pointer regions below still require visible, non-empty geometry.
+            if (mappedSlot) this.registered.add(slot);
+            if (draw.enabled() && draw.alpha() > 0 && box.visibleBounds().width() > 0 && box.visibleBounds().height() > 0)
+                regions.add(new ControlRegion(slot, closeInputs(node), recipe, preference, box.bounds(), box.clip(), box.layer()));
+        }
+        // Later draws cover earlier controls when their authored layers are equal.
+        final var frontToBack = new ArrayList<>(regions.reversed());
+        frontToBack.sort(Comparator.comparingDouble(ControlRegion::layer).reversed());
+        this.controls = List.copyOf(frontToBack);
+    }
+
+    private static Set<String> closeInputs(final NativeUiScene.Node node) {
+        if (!node.string("inventory_command", "").equals("close") || !node.properties().has("button_mappings")) return Set.of();
+        final Set<String> inputs = new HashSet<>();
+        for (final var element : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = element.getAsJsonObject();
+            if (mapping.has("ignored") && mapping.get("ignored").getAsBoolean()) continue;
+            if (!NativeUiScene.string(mapping, "mapping_type", "").equals("pressed")) continue;
+            if (Set.of("button.menu_exit", "button.try_menu_exit").contains(NativeUiScene.string(mapping, "to_button_id", "")))
+                inputs.add(NativeUiScene.string(mapping, "from_button_id", ""));
+        }
+        inputs.remove("");
+        return Set.copyOf(inputs);
+    }
+
+    private static RecipeControl recipe(final NativeUiScene.Node node, final boolean enabled, final Map<Integer, Set<String>> authority) {
+        if (!node.properties().has("recipe_actions")) return null;
+        if (!node.type().equals("button") || !node.string("collection", "").equals("recipe_book")
+                || !node.properties().has("recipe_id") || node.properties().has("inventory_slot") || node.properties().has("inventory_actions"))
+            throw new IllegalArgumentException("Recipe input has no distinct authored cell");
+        final int id = node.properties().get("recipe_id").getAsBigDecimal().intValueExact();
+        final Map<String, NativeCookingAction.Mode> inputs = new HashMap<>();
+        for (final var value : node.properties().getAsJsonArray("recipe_actions")) {
+            final var mapping = value.getAsJsonObject();
+            if (mapping.has("ignored")) {
+                if (!mapping.get("ignored").isJsonPrimitive() || !mapping.get("ignored").getAsJsonPrimitive().isBoolean())
+                    throw new IllegalArgumentException("Invalid native recipe mapping state");
+                if (mapping.get("ignored").getAsBoolean()) continue;
+            }
+            if (!RECIPE_MAPPING_FIELDS.containsAll(mapping.keySet())
+                    || !mappingString(mapping, "from_button_id") || !mappingString(mapping, "to_button_id") || !mappingString(mapping, "mapping_type")
+                    || mapping.has("consume_event") && (!mapping.get("consume_event").isJsonPrimitive()
+                        || !mapping.get("consume_event").getAsJsonPrimitive().isBoolean()))
+                throw new IllegalArgumentException("Unsupported native recipe mapping attributes");
+            final var mode = java.util.Arrays.stream(NativeCookingAction.Mode.values())
+                    .filter(candidate -> candidate.button().equals(NativeUiScene.string(mapping, "to_button_id", ""))).findFirst().orElseThrow();
+            final String source = NativeUiScene.string(mapping, "from_button_id", "");
+            if (source.isEmpty() || !NativeUiScene.string(mapping, "mapping_type", "").equals("pressed")
+                    || mapping.has("consume_event") && !mapping.get("consume_event").getAsBoolean()
+                    || enabled && !authority.getOrDefault(id, Set.of()).contains(mode.button())
+                    || closeInputs(node).contains(source)
+                    || !node.properties().getAsJsonArray("button_mappings").contains(mapping))
+                throw new IllegalArgumentException("Unsupported or unauthorized native recipe mapping");
+            final var previous = inputs.putIfAbsent(source, mode);
+            if (previous != null && previous != mode) throw new IllegalArgumentException("Ambiguous native recipe input");
+        }
+        if (id < 0 || inputs.keySet().stream().noneMatch(Set.of("button.menu_select", "button.menu_secondary_select")::contains))
+            throw new IllegalArgumentException("Native recipe has no supported pointer input");
+        return new RecipeControl(id, Map.copyOf(inputs));
+    }
+
+    private static boolean mappingString(final JsonObject mapping, final String key) {
+        return mapping.has(key) && mapping.get(key).isJsonPrimitive() && mapping.get(key).getAsJsonPrimitive().isString();
+    }
+
+    private static void validateActions(final NativeUiScene.Node node, final RecipeControl recipe) {
+        if (!node.type().equals("button") || !node.properties().has("button_mappings")) return;
+        final Set<String> supported = new HashSet<>();
+        if (recipe != null) recipe.inputs.values().forEach(mode -> supported.add(mode.button()));
+        if (node.properties().has("inventory_actions")) {
+            for (final var action : node.properties().getAsJsonArray("inventory_actions"))
+                supported.add(action.getAsJsonObject().get("to_button_id").getAsString());
+        }
+        if (node.string("inventory_command", "").equals("close")) {
+            supported.add("button.menu_exit");
+            supported.add("button.try_menu_exit");
+        }
+        for (final var element : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = element.getAsJsonObject();
+            final var ignored = mapping.get("ignored");
+            if (ignored != null && ignored.isJsonPrimitive() && ignored.getAsJsonPrimitive().isBoolean() && ignored.getAsBoolean()) continue;
+            final var action = mapping.get("to_button_id");
+            if (action != null && !action.getAsString().isEmpty() && !supported.contains(action.getAsString()))
+                throw new IllegalArgumentException("Unsupported native inventory button action");
+        }
+    }
+
+    int hovered(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.slot;
+        return -1;
+    }
+
+    RecipeControl recipe(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.recipe;
+        return null;
+    }
+
+    record RecipeControl(int id, Map<String, NativeCookingAction.Mode> inputs) { }
+
+    NativeCookingPreferenceControl preference(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.preference;
+        return null;
+    }
+
+    boolean hasPreferences() { return this.controls.stream().anyMatch(region -> region.preference != null); }
+
+    boolean contains(final int slot, final double x, final double y) {
+        return slot >= 0 && this.hovered(x, y) == slot;
+    }
+
+    boolean closes(final double x, final double y, final String input) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.closeInputs.contains(input);
+        return false;
+    }
+
+    void requireAuthoredCoverage(final Set<Integer> requiredSlots, final int slotCount) {
+        if (requiredSlots.isEmpty()) {
+            throw new IllegalArgumentException("Native inventory has no actionable slots");
+        }
+        for (final int slot : requiredSlots) {
+            if (slot < 0 || slot >= slotCount) {
+                throw new IllegalArgumentException("Invalid authored inventory slot");
+            }
+            if (!this.registered.contains(slot)) {
+                throw new IllegalArgumentException(
+                        "Native inventory has an inaccessible authored slot");
+            }
+        }
+    }
+
+    void requireComplete(final int slotCount) {
+        for (int slot = 0; slot < slotCount; slot++) {
+            if (!this.registered.contains(slot))
+                throw new IllegalArgumentException("Native inventory has inaccessible slots");
+        }
+    }
+
+    private record ControlRegion(int slot, Set<String> closeInputs, RecipeControl recipe, NativeCookingPreferenceControl preference,
+                                 NativeUiLayout.Rect bounds, NativeUiLayout.Rect clip, float layer) {
+        boolean contains(final double x, final double y) { return this.bounds.intersect(this.clip).contains(x, y); }
+    }
+}
