+        clock.set(10_000_000_001L);
+        assertTrue(presentation.expired());
+        presentation.retire();
+        assertFalse(presentation.result(new NativePlayerInventoryResult(1, 8, 3, 2, true)));
+        assertFalse(presentation.bundle("hotbar_items", 1, NativeBundleAction.Kind.SECONDARY, 0, bundles::add));
+        final var pending = new NativePlayerPresentation(message(false, 2, 0, 1, "", false), Map.of(), Map.of(), clock::get);
+        assertFalse(pending.bundle("inventory_items", 4, NativeBundleAction.Kind.PRIMARY, 0, bundles::add));
+        assertEquals(2, bundles.size());
+    }
