@@ -0,0 +1,65 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+/**
+ * A bounded presentation waits for actual contents of this menu object, never a future reusable
+ * menu number.
+ */
+final class NativeContainerPending<C, M, P> {
+    private final C connection;
+    private final M menu;
+    private final int menuId;
+    private final long sequence;
+    private final long deadline;
+    private P presentation;
+
+    NativeContainerPending(
+            final C connection,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final long now,
+            final P presentation) {
+        if (connection == null || menu == null || presentation == null || sequence <= 0 || now < 0)
+            throw new IllegalArgumentException("Invalid pending native menu");
+        this.connection = connection;
+        this.menu = menu;
+        this.menuId = menuId;
+        this.sequence = sequence;
+        this.deadline = Math.addExact(now, 100);
+        this.presentation = presentation;
+    }
+
+    boolean current(
+            final C connection,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final long now) {
+        return this.presentation != null
+                && this.connection == connection
+                && this.menu == menu
+                && this.menuId == menuId
+                && this.sequence == sequence
+                && now < this.deadline;
+    }
+
+    P contents(
+            final C connection,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final long now) {
+        if (!this.current(connection, menu, menuId, sequence, now)) {
+            this.presentation = null;
+            return null;
+        }
+        final P result = this.presentation;
+        this.presentation = null;
+        return result;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentation.java
