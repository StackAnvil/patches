+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.inventory;
+
+import com.viaversion.viafabricplus.bedrock.screen.container.BedrockNativeContainerScreen;
+import com.viaversion.viafabricplus.bedrock.screen.container.BedrockNativeContainers;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.Font;
+import net.minecraft.world.item.ItemStack;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import net.minecraft.world.inventory.Slot;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+@Mixin(AbstractContainerScreen.class)
+public abstract class MixinNativeContainerGeometry {
+    @Inject(method = "getHoveredSlot", at = @At("HEAD"), cancellable = true)
+    private void nativeSlot(final double x, final double y, final CallbackInfoReturnable<Slot> ci) {
+        if ((Object) this instanceof BedrockNativeContainerScreen nativeScreen) ci.setReturnValue(nativeScreen.nativeHoveredSlot(x, y));
+    }
+
+    @Inject(method = "isHovering(Lnet/minecraft/world/inventory/Slot;DD)Z", at = @At("HEAD"), cancellable = true)
+    private void nativeHit(final Slot slot, final double x, final double y, final CallbackInfoReturnable<Boolean> ci) {
+        if ((Object) this instanceof BedrockNativeContainerScreen nativeScreen) ci.setReturnValue(nativeScreen.nativeIsHovering(slot, x, y));
+    }
+
+    @WrapOperation(method = "extractSlot", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/GuiGraphicsExtractor;itemDecorations(Lnet/minecraft/client/gui/Font;Lnet/minecraft/world/item/ItemStack;IILjava/lang/String;)V"))
+    private void nativeDecorations(final GuiGraphicsExtractor graphics, final Font font, final ItemStack stack,
+                                   final int x, final int y, final String count, final Operation<Void> original) {
+        if ((Object) this instanceof BedrockNativeContainerScreen nativeScreen) nativeScreen.nativeDecorations(stack, count);
+        else original.call(graphics, font, stack, x, y, count);
+    }
+
+    @Inject(method = "removed", at = @At("HEAD"), cancellable = true)
+    private void retainPresentedMenu(final CallbackInfo ci) {
+        if (BedrockNativeContainers.replacing(((AbstractContainerScreen<?>) (Object) this).getMenu())) ci.cancel();
+    }
+}
