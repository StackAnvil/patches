+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+        tooltip.putIntArray("amounts", new int[]{0, 2});
+        tooltip.put(NativeBundleTooltipItems.TAG, new ByteArrayTag(new byte[0]));
+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+        tooltip.remove(NativeBundleTooltipItems.TAG);
+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+    }
+
+    private static ItemStack bundle(final List<Integer> counts, final Map<Integer, NativeBundleTooltipItems.Preview> items) {
+        final var stack = new ItemStack(Items.BUNDLE);
+        stack.set(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+        final var custom = new CompoundTag();
+        final var data = new CompoundTag();
+        data.putInt("version", NativeBundleTooltipData.VERSION);
+        data.putInt("identity", 7);
+        data.putInt("viewable_slots", 12);
+        data.put("amounts", new IntArrayTag(counts.stream().mapToInt(Integer::intValue).toArray()));
+        data.putString("primary_name", "§dOriginal bundle");
+        data.putString("empty_description", "Native description");
+        data.put(NativeBundleTooltipItems.TAG, new ByteArrayTag(new NativeBundleTooltipItems(7, counts.size(), items).encode()));
+        custom.put(NativeBundleTooltipData.TAG, data);
+        final var storage = new CompoundTag();
+        storage.putInt("version", NativeItemStorageData.VERSION);
+        storage.putInt("modifier", 4);
+        storage.putInt("capacity", 64);
+        storage.putInt("weight", counts.stream().mapToInt(Integer::intValue).sum());
+        custom.put(NativeItemStorageData.TAG, storage);
+        stack.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        return stack;
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        if (root.has("children")) root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void authoredLabelsCapNativeCountsWithoutChangingNumericBindingsOrQuickcraftText() {
+        final Map<Integer, String> reference = Map.of(
+                -1, "", 0, "", 1, "", 2, "2", 9, "9", 10, "10", 99, "99", 100, "99+", 255, "99+", Integer.MAX_VALUE, "99+");
+        reference.forEach((count, text) -> assertEquals(text, NativeInventoryItemPresentation.countText(count, null)));
+        final var stack = mock(ItemStack.class);
+        when(stack.getCount()).thenReturn(100);
+        assertEquals(100, NativeInventoryItemPresentation.values(stack, false, false).get("#inventory_stack_count").getAsInt());
+        assertEquals("§e64", NativeInventoryItemPresentation.countText(100, "§e64"));
+        assertEquals("", NativeInventoryItemPresentation.countText(100, ""));
+    }
+
+    @Test
+    void retainedTypedLockModesKeepSlotAndCursorScopesWithoutNumericCoercion() {
+        final var stack = mock(ItemStack.class);
+        when(stack.getCount()).thenReturn(8);
+        when(stack.getMaxDamage()).thenReturn(100);
+        when(stack.getDamageValue()).thenReturn(35);
+        when(stack.isDamageableItem()).thenReturn(true);
+        when(stack.isDamaged()).thenReturn(true);
+        final var data = new CompoundTag();
+        final var snapshot = new CompoundTag();
+        snapshot.putInt("version", NativeItemStackData.VERSION);
+        data.put(ItemDataRewriter.BEDROCK_STACK_TAG, snapshot);
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        final var userData = new CompoundTag();
+        snapshot.put("user_data", userData);
+        for (final int mode : new int[] {0, 1, 2, 3, 255}) {
+            userData.putByte("minecraft:item_lock", (byte) mode);
+            when(stack.get(DataComponents.CUSTOM_DATA)).thenReturn(CustomData.of(data));
+            assertEquals(mode, NativeInventoryItemPresentation.lock(data));
+            if (mode != 0) {
+                assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, null));
+                final var shown = NativeInventoryItemPresentation.values(stack, false, true);
+                assertEquals(mode == 1, shown.get("#item_lock_in_slot").getAsBoolean());
+                assertEquals(mode == 2, shown.get("#item_lock_in_inventory").getAsBoolean());
+                assertTrue(shown.get("#item_lock").getAsBoolean());
+                assertFalse(NativeInventoryItemPresentation.values(stack, true, false)
+                    .get("#inventory_selected_item_lock_in_inventory").getAsBoolean());
+                continue;
+            }
+            final var slot = NativeInventoryItemPresentation.values(stack, false, null);
+            final var cursor = NativeInventoryItemPresentation.values(stack, true, null);
+            assertFalse(slot.get("#item_lock_in_slot").getAsBoolean());
+            assertFalse(cursor.get("#inventory_selected_item_lock_in_inventory").getAsBoolean());
+            assertFalse(slot.get("#item_lock").getAsBoolean());
+            assertEquals(8, slot.get("#inventory_stack_count").getAsInt());
+            assertEquals(65, slot.get("#item_durability_current_amount").getAsInt());
+            assertFalse(slot.containsKey("#inventory_selected_item_lock_in_inventory"));
+            assertFalse(slot.containsKey("#item_storage_visible"));
+        }
+        userData.putInt("minecraft:item_lock", 1);
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        userData.putString("minecraft:item_lock", "2");
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        snapshot.putInt("version", NativeItemStackData.VERSION + 1);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.lock(data));
+        when(stack.has(DataComponents.BUNDLE_CONTENTS)).thenReturn(true);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, null));
+    }
+
+    @Test
+    void nativeStorageBindingsKeepTheirSnapshotInsteadOfReadingJavaBundleWeight() {
+        final var stack = new ItemStack(Items.BUNDLE);
+        stack.set(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+        final var data = new CompoundTag();
+        final var storage = new CompoundTag();
+        storage.putInt("version", NativeItemStorageData.VERSION);
+        storage.putInt("modifier", 4);
+        storage.putInt("weight", 22);
+        storage.putInt("capacity", 64);
+        data.put(NativeItemStorageData.TAG, storage);
+        stack.set(DataComponents.CUSTOM_DATA, CustomData.of(data));
+        final var slot = NativeInventoryItemPresentation.values(stack, false, false);
+        assertTrue(slot.get("#item_storage_visible").getAsBoolean());
+        assertEquals(22F, slot.get("#item_storage_current_amount").getAsFloat());
+        assertEquals(64F, slot.get("#item_storage_total_amount").getAsFloat());
+        assertFalse(slot.containsKey("#selected_item_storage_current_amount"));
+        assertEquals(22F, NativeInventoryItemPresentation.values(stack, true, false)
+                .get("#selected_item_storage_current_amount").getAsFloat());
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.requireTooltip(stack));
+        storage.putInt("weight", 0);
+        data.put(NativeItemStorageData.TAG, storage);
+        stack.set(DataComponents.CUSTOM_DATA, CustomData.of(data));
+        assertFalse(NativeInventoryItemPresentation.values(stack, false, false).get("#item_storage_visible").getAsBoolean());
+        storage.putInt("version", NativeItemStorageData.VERSION + 1);
+        data.put(NativeItemStorageData.TAG, storage);
+        stack.set(DataComponents.CUSTOM_DATA, CustomData.of(data));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, false));
+        stack.remove(DataComponents.CUSTOM_DATA);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, false));
+    }
+}
