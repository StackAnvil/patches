+                        case "navigation_tab" -> options = new InventoryOptions(change.index(), options.rightTab(), options.filtering(), options.inventoryLayout(), options.craftingLayout());
+                        case "toggle.enableFiltering" -> options = new InventoryOptions(options.leftTab(), options.rightTab(), change.checked(), options.inventoryLayout(), options.craftingLayout());
+                        case "layout_toggle" -> {
