+        layout(input, host);
+        button.properties().addProperty("enabled", true);
+        layout(input, host);
+        assertTrue(button.children().get(1).flag("visible", true));
+        assertFalse(button.children().get(2).flag("visible", true));
+    }
+
+    @Test
+    void suppressedSelectionSurvivesReplacementUntilAnActualPropertyEvent() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var original = button(true, false);
+        final var originalHost = new NativeUiScene.Node("host", "panel", properties(100, 100), List.of(original), Integer.MIN_VALUE);
+        layout(input, originalHost);
+        input.pointer(5, 5, 1, 0, true);
+        input.button("button.menu_ok", true, 1, 1, true);
+        assertTrue(original.children().get(1).flag("visible", true));
+        final var replacement = button(true, false);
+        final var host = new NativeUiScene.Node("host", "panel", properties(100, 100), List.of(replacement), Integer.MIN_VALUE);
+        layout(input, host);
+        assertTrue(replacement.children().get(1).flag("visible", true));
+        assertFalse(replacement.children().get(2).flag("visible", true));
+        host.properties().addProperty("enabled", false);
+        layout(input, host);
+        host.properties().addProperty("enabled", true);
+        layout(input, host);
+        assertTrue(replacement.children().get(2).flag("visible", true));
+    }
+
+    private static NativeUiScene.Node nestedInput(final boolean childFirst, final boolean alias) {
+        final var owner = button(false, true);
+        owner.properties().addProperty("layer", 10);
+        final var mapping = owner.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject();
+        mapping.addProperty("mapping_type", "global");
+        if (alias) {
+            owner.properties().addProperty("hover_control", "default");
+            owner.properties().addProperty("pressed_control", "default");
+        }
+        final var children = new java.util.ArrayList<>(owner.children());
+        final var original = children.getFirst();
+        original.properties().addProperty("layer", childFirst ? 1 : -1);
+        final var childMapping = mapping.deepCopy();
+        childMapping.addProperty("to_button_id", "fixture.child");
+        childMapping.addProperty("consume_event", false);
+        final var mappings = new JsonArray();
+        mappings.add(childMapping);
+        original.properties().add("button_mappings", mappings);
+        children.set(0, new NativeUiScene.Node(original.name(), "input_panel", original.properties(), original.children(), original.action()));
+        return new NativeUiScene.Node(owner.name(), owner.type(), owner.properties(), List.copyOf(children), owner.action());
+    }
+
+    private static NativeUiLayout.Box layout(final NativeContainerInput input, final NativeUiScene.Node node) {
+        input.prepare(node);
+        final var root = new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(node, 100, 100, Map.of());
+        final var draws = NativeUiPresentation.draws(root, _ -> true, _ -> new NativeUiPresentation.Opacity(1, 1), input::hasButtonState);
+        input.layout(root, draws, 100, 100);
+        return root;
+    }
+
+    private static NativeUiScene.Node button(final boolean consume, final boolean select) {
+        final var properties = properties(0, 20);
+        properties.getAsJsonArray("size").set(0, new com.google.gson.JsonPrimitive("100%c"));
+        properties.addProperty("consume_event", consume);
+        final var mapping = new JsonObject();
+        mapping.addProperty("from_button_id", "button.menu_ok");
+        mapping.addProperty("to_button_id", "button.menu_select");
+        mapping.addProperty("mapping_type", "pressed");
+        mapping.addProperty("handle_select", select);
+        final var mappings = new JsonArray();
+        mappings.add(mapping);
+        properties.add("button_mappings", mappings);
+        final List<NativeUiScene.Node> children = new java.util.ArrayList<>();
+        for (final String role : List.of("default", "hover", "pressed", "locked")) {
+            final var child = new NativeUiScene.Node(role, "panel", properties((children.size() + 1) * 10, 20), List.of(), Integer.MIN_VALUE);
+            children.add(child);
+            properties.addProperty(role + "_control", role);
+        }
+        return new NativeUiScene.Node("owner", "button", properties, List.copyOf(children), 0);
+    }
+
+    private static JsonObject properties(final int width, final int height) {
+        final var properties = new JsonObject();
+        properties.addProperty("anchor_from", "top_left");
+        properties.addProperty("anchor_to", "top_left");
+        final var size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        properties.add("size", size);
+        return properties;
+    }
+}
