+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.world.Container;
+import net.minecraft.world.SimpleContainer;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.inventory.Slot;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeContainerItems;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+
+/**
+ * Items of one logical container presentation, keyed by full Bedrock slot. The Java menu holds only the first
+ * slots, so these read-only slots back the scene instead. Native count-one actions remain the only input on them.
+ */
+final class NativeLogicalContents<C, M> {
+    private final C owner;
+    private final M menu;
+    private final int menuId;
+    private final long sequence;
+    private final SimpleContainer items;
+    private final List<Slot> slots;
+    private boolean received;
+    private long revision;
+
+    NativeLogicalContents(final C owner, final M menu, final int menuId, final long sequence, final int size) {
+        if (owner == null || menu == null) throw new IllegalArgumentException("Logical contents need a menu owner");
+        ContainerUi.Kind.LOGICAL_CHEST.validateContainerSlots(size);
+        this.owner = owner;
+        this.menu = menu;
+        this.menuId = menuId;
+        this.sequence = sequence;
+        this.items = new SimpleContainer(size);
+        final List<Slot> slots = new ArrayList<>(size);
+        for (int index = 0; index < size; index++) slots.add(new LogicalSlot(this.items, index));
+        this.slots = List.copyOf(slots);
+    }
+
+    int size() { return this.items.getContainerSize(); }
+    List<Slot> slots() { return this.slots; }
+    boolean received() { return this.received; }
+    long revision() { return this.revision; }
+
+    boolean owns(final C owner, final M menu, final int menuId, final long sequence) {
+        return this.owner == owner && this.menu == menu && this.menuId == menuId && this.sequence == sequence;
+    }
+
+    /** Applies one ordered message. A reset first clears every slot it does not list. */
+    boolean apply(final C owner, final M menu, final NativeContainerItems message, final List<ItemStack> stacks) {
+        if (!this.owns(owner, menu, message.menuId(), message.sequence()) || message.containerSlots() != this.size()
+                || stacks.size() != message.entries().size() || !this.received && !message.reset()) return false;
+        if (message.reset()) this.items.clearContent();
+        for (int index = 0; index < stacks.size(); index++)
+            this.items.setItem(message.entries().get(index).slot(), stacks.get(index).copy());
+        this.received = true;
+        this.revision++;
+        return true;
+    }
+
+    /** Server-owned display slot. Vanilla pickup and placement never apply because its Java menu slot is absent. */
+    static final class LogicalSlot extends Slot {
+        LogicalSlot(final Container container, final int index) {
+            super(container, index, 0, 0);
+            this.index = index;
+        }
+
+        @Override public boolean mayPlace(final ItemStack stack) { return false; }
+        @Override public boolean mayPickup(final Player player) { return false; }
+    }
+}
