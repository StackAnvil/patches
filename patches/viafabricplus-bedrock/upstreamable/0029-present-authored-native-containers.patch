+        converted.forEach(item -> item.setCount(1));
+        decoded.items().get(1).setCount(1);
+        assertSame(Items.IRON_INGOT, decoded.item(1).getItem());
+        assertEquals(255, decoded.item(1).getCount());
+        assertEquals(2, decoded.item(3).getCount());
+        final var view = decoded.view(2, 1, false, 2, false);
+        assertEquals(List.of(0, 255, 0, 2), view.contents().amounts());
+        assertEquals("Last physical item", view.items().get(3).primaryName());
+        assertEquals(255, view.items().get(1).presentation().get("#inventory_stack_count").getAsInt());
+        final var kind = ContainerUi.Kind.CHEST_3_ROWS;
+        final var ui = ContainerUi.forContext(new ResourcePackStorage(List.of()).getJsonUiProgram(), new ContainerUi.Title("Chest", false), false);
+        final var presentation = new NativeContainerPresentation(ui, kind, List.of());
+        final var empty = NativeInventoryItemPresentation.values(ItemStack.EMPTY, false, false);
+        final var slots = IntStream.range(0, 63).mapToObj(slot -> new ContainerUi.Slot(slot, empty)).toList();
+        final var frame = presentation.resolve(7, "Chest", slots, Map.of(), false, view);
+        final var controls = nodes(frame.scene().getAsJsonObject("root"));
+        assertTrue(controls.stream().anyMatch(node -> node.has("text") && node.get("text").isJsonPrimitive()
+                && node.get("text").getAsString().equals("§dOriginal bundle")));
+        final var physical = controls.stream().filter(node -> node.has("bundle_slot")).toList();
+        assertFalse(physical.isEmpty());
+        assertTrue(physical.stream().noneMatch(node -> node.has("inventory_slot") || node.has("inventory_actions")));
+        assertTrue(physical.stream().anyMatch(node -> node.get("bundle_slot").getAsInt() == 3));
+        final var icons = physical.stream().filter(node -> node.has("renderer")
+                && node.get("renderer").getAsString().equals("inventory_item_renderer")).toList();
+        assertFalse(icons.isEmpty());
+        for (final var icon : icons) {
+            final var stack = decoded.item(renderedNode(icon));
+            final int slot = icon.get("bundle_slot").getAsInt();
+            assertEquals(slot == 1 ? 255 : 2, stack.getCount());
+            assertSame(Items.IRON_INGOT, stack.getItem());
+            assertEquals(slot == 1 ? "99+" : "2", NativeInventoryItemPresentation.countText(stack.getCount(), null));
+            stack.setCount(1);
+            assertEquals(slot == 1 ? 255 : 2, decoded.item(renderedNode(icon)).getCount());
+        }
+        // Rendering and input admission remain explicit until the native screen can consume these views.
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.requireTooltip(source));
+    }
+
+    @Test
+    void renderedBundleReferencesRejectStaleIdentitiesHolesAndTruncatedIndices() {
+        final var source = bundle(List.of(0, 255, 0, 2), Map.of(
+                1, new NativeBundleTooltipItems.Preview("First", new StructuredItem(7, 255, new StructuredDataContainer())),
+                3, new NativeBundleTooltipItems.Preview("Last", new StructuredItem(7, 2, new StructuredDataContainer()))));
+        final var decoded = NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount()));
+        final var reference = new JsonObject();
+        reference.addProperty("bundle_identity", 7);
+        reference.addProperty("bundle_slot", 3);
+        assertEquals(2, decoded.item(renderedNode(reference)).getCount());
+        for (final int slot : List.of(-1, 0, 2, 4, Integer.MAX_VALUE)) {
+            reference.addProperty("bundle_slot", slot);
+            assertThrows(IllegalArgumentException.class, () -> decoded.item(renderedNode(reference)));
+        }
+        reference.addProperty("bundle_slot", 1.5);
+        assertThrows(IllegalArgumentException.class, () -> decoded.item(renderedNode(reference)));
+        reference.addProperty("bundle_slot", "1");
+        assertThrows(IllegalArgumentException.class, () -> decoded.item(renderedNode(reference)));
+        reference.addProperty("bundle_slot", 1);
+        reference.addProperty("bundle_identity", 8);
+        assertThrows(IllegalArgumentException.class, () -> decoded.item(renderedNode(reference)));
+        reference.addProperty("bundle_identity", 7);
+        reference.addProperty("inventory_slot", 1);
+        assertThrows(IllegalArgumentException.class, () -> decoded.item(renderedNode(reference)));
+    }
+
+    private static NativeUiScene.Node renderedNode(final JsonObject reference) {
+        return NativeUiScene.parse("{\"format\":1,\"root\":" + reference + "}", Set.of("inventory_item_renderer")).root();
+    }
+
+    @Test
+    void missingMalformedAndMismatchedTablesNeverBecomeEmptyOrCompactedNativeViews() {
+        final var empty = bundle(List.of(0, 0), Map.of());
+        assertNotNull(NativeInventoryItemPresentation.bundleTooltip(empty, item -> { throw new AssertionError("Empty table decoded an item"); }));
+        final var source = bundle(List.of(0, 2), Map.of(1,
+                new NativeBundleTooltipItems.Preview("Native", new StructuredItem(7, 2, new StructuredDataContainer()))));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, 1)));
+        final var custom = source.get(DataComponents.CUSTOM_DATA).copyTag();
+        final var tooltip = (CompoundTag) custom.get(NativeBundleTooltipData.TAG);
+        tooltip.putIntArray("amounts", new int[]{0, 1});
+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+        tooltip.putIntArray("amounts", new int[]{0, 2});
+        tooltip.put(NativeBundleTooltipItems.TAG, new ByteArrayTag(new byte[0]));
+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+        tooltip.remove(NativeBundleTooltipItems.TAG);
+        source.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.bundleTooltip(source, item -> new ItemStack(Items.IRON_INGOT, item.amount())));
+    }
+
+    private static ItemStack bundle(final List<Integer> counts, final Map<Integer, NativeBundleTooltipItems.Preview> items) {
+        final var stack = new ItemStack(Items.BUNDLE);
+        stack.set(DataComponents.BUNDLE_CONTENTS, BundleContents.EMPTY);
+        final var custom = new CompoundTag();
+        final var data = new CompoundTag();
+        data.putInt("version", NativeBundleTooltipData.VERSION);
+        data.putInt("identity", 7);
+        data.putInt("viewable_slots", 12);
+        data.put("amounts", new IntArrayTag(counts.stream().mapToInt(Integer::intValue).toArray()));
+        data.putString("primary_name", "§dOriginal bundle");
+        data.putString("empty_description", "Native description");
+        data.put(NativeBundleTooltipItems.TAG, new ByteArrayTag(new NativeBundleTooltipItems(7, counts.size(), items).encode()));
+        custom.put(NativeBundleTooltipData.TAG, data);
+        final var storage = new CompoundTag();
+        storage.putInt("version", NativeItemStorageData.VERSION);
+        storage.putInt("modifier", 4);
+        storage.putInt("capacity", 64);
+        storage.putInt("weight", counts.stream().mapToInt(Integer::intValue).sum());
+        custom.put(NativeItemStorageData.TAG, storage);
+        stack.set(DataComponents.CUSTOM_DATA, CustomData.of(custom));
+        return stack;
+    }
+
+    private static List<JsonObject> nodes(final JsonObject root) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(root);
+        if (root.has("children")) root.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    @Test
+    void authoredLabelsCapNativeCountsWithoutChangingNumericBindingsOrQuickcraftText() {
+        final Map<Integer, String> reference = Map.of(
+                -1, "", 0, "", 1, "", 2, "2", 9, "9", 10, "10", 99, "99", 100, "99+", 255, "99+", Integer.MAX_VALUE, "99+");
+        reference.forEach((count, text) -> assertEquals(text, NativeInventoryItemPresentation.countText(count, null)));
