+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemOpacity;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.state.gui.GuiItemRenderState;
+import net.minecraft.client.renderer.state.gui.GuiRenderState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(GuiGraphicsExtractor.class)
+public abstract class MixinNativeGuiItemExtraction implements IBedrockGuiItemOpacity {
+    @Unique private float nativeItemOpacity = 1;
+
+    @Override public float stackanvil$itemOpacity() { return this.nativeItemOpacity; }
+    @Override public void stackanvil$itemOpacity(final float opacity) { this.nativeItemOpacity = opacity; }
+
+    @WrapOperation(method = "item(Lnet/minecraft/world/entity/LivingEntity;Lnet/minecraft/world/level/Level;Lnet/minecraft/world/item/ItemStack;III)V",
+            at = @At(value = "INVOKE", target = "Lnet/minecraft/client/renderer/state/gui/GuiRenderState;addItem(Lnet/minecraft/client/renderer/state/gui/GuiItemRenderState;)V"))
+    private void captureOpacity(final GuiRenderState gui, final GuiItemRenderState item, final Operation<Void> original) {
+        ((IBedrockGuiItemOpacity) (Object) item).stackanvil$itemOpacity(this.nativeItemOpacity);
+        original.call(gui, item);
+    }
+}
