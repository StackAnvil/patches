+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerSessionTest {
+    @Test
+    void rejectsLatePresentationsAndReusedMenuNumbers() {
+        final var session = new NativeContainerSession<Object, Object>();
+        final Object owner = new Object(), first = new Object(), replacement = new Object();
+        assertTrue(session.accept(owner, first, 7, 7, 1));
+        assertFalse(session.accept(owner, first, 7, 7, 1));
+        assertFalse(session.accept(owner, first, 7, 7, 0));
+        assertFalse(session.current(owner, replacement, 7));
+        session.close();
+        assertFalse(session.current(owner, first, 7));
+        assertFalse(session.accept(owner, replacement, 7, 7, 1));
+        assertTrue(session.accept(owner, replacement, 7, 7, 2));
+        assertTrue(session.current(owner, replacement, 7));
+    }
+
+    @Test
+    void onlyNewConnectionsResetSequenceAndMismatchesCannotConsumeIt() {
+        final var session = new NativeContainerSession<Object, Object>();
+        final Object first = new Object(), second = new Object(), menu = new Object();
+        assertTrue(session.accept(first, menu, 3, 3, 100));
+        assertFalse(session.accept(first, menu, 3, 4, 200));
+        assertTrue(session.accept(first, menu, 3, 3, 101));
+        assertTrue(session.accept(second, menu, 3, 3, 1));
+        assertFalse(session.current(first, menu, 3));
+        session.clear();
+        assertFalse(session.current(second, menu, 3));
+    }
