+        if (this.dragInput != null) {
+            if (this.dragInput.button == event.button()) this.visitDragSlot(event.x(), event.y());
+            return true;
+        }
+        if (this.capturedButtons.contains(event.button()) || this.nativeButtons.contains(event.button())) return true;
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.drag(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseDragged(event, dx, dy);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (this.closing()) return true;
+        boolean gestureReleaseDelivered = !this.authoredController();
+        final boolean touch = this.inputMode() == 2;
+        // Keep contact through the final slot release, then retire its pointer hover.
+        final String pressedSource = touch ? this.pointerSources.get(event.button()) : this.pointerSources.remove(event.button());
+        final String componentSource = pressedSource == null ? source(event.button()) : pressedSource;
+        if (this.current() && this.authoredController()) {
+            if (this.helpView) this.inventoryInput.button(componentSource, false, 1, this.clock.getAsLong(), false);
+            final var hover = this.nativeInput.pointer(event.x(), event.y(), this.inputMode(), this.clock.getAsLong(), this.pointerEnabled());
+            final var released = this.nativeInput.button(componentSource, false, this.inputMode(), this.clock.getAsLong(),
+                    this.viewInputEnabled() || this.dragInput != null || this.cookingHold.busy());
+            if (!this.waitingForPreference()) { this.componentEvents(hover); this.componentEvents(released); }
+            gestureReleaseDelivered = released.events().stream().anyMatch(control -> control.button() != null
+                    && control.button().phase() == 0
+                    && (this.presentation instanceof NativeCookingPresentation && NativeCookingReset.edge(control.button()) == NativeCookingReset.Edge.COMPLETE
+                        || control.node().properties().has("inventory_slot")
+                            && (control.button().target() == NativeUiInput.symbol("button.container_take_all_place_all")
+                                || control.button().target() == NativeUiInput.symbol("button.container_take_half_place_one"))));
+        }
+        if (touch) {
+            this.pointerSources.remove(event.button());
+            if (this.current() && this.inputMode() == 2 && !this.waitingForPreference())
+                this.componentEvents(this.nativeInput.pointer(event.x(), event.y(), this.inputMode(), this.clock.getAsLong(), this.pointerEnabled()));
+        }
+        if (this.current() && this.presentation instanceof NativeCookingPresentation cooking
+                && this.cookingHold.release(event.button(), gestureReleaseDelivered)) {
+            this.nativeButtons.remove(event.button());
+            this.consumedReleases.add(event.button());
+            this.cookingHold.flush(cooking, this.menu.getCarried(), this::sendCookingHold);
+            cooking.holdInput(this.cookingHold.busy());
+            cooking.quantity(this.cookingHold.quantity());
+            this.refreshSafely();
+            return true;
+        }
+        if (this.dragInput != null && (this.authoredController() || this.dragInput.button == event.button())) {
+            // Native keeps redistributing on pointer entry after an unhandled physical release.
+            if (gestureReleaseDelivered) {
+                this.finishDragInput();
+                this.consumedReleases.add(event.button());
+            }
+            return true;
+        }
+        if (this.nativeButtons.remove(event.button())) {
+            this.consumedReleases.add(event.button());
+            return true;
+        }
+        if (this.capturedButtons.remove(event.button())) {
+            this.consumedReleases.add(event.button());
+            final var press = this.recipePress;
+            if (press != null && press.button == event.button()) {
+                this.recipePress = null;
+                BedrockNativeCooking.action(this.owner, this.menu, press.recipe, press.mode, 2);
+            }
+            return true;
+        }
+        if (this.consumedReleases.contains(event.button())) return true;
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.release()) {
+            this.scrollAnimation(true);
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseReleased(event);
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (this.closing()) return true;
+        if (!this.current()) return false;
+        if (this.cookingHold.busy() && event.key() == InputConstants.KEY_ESCAPE) { this.onClose(); return true; }
+        if (this.searchInput) {
+            if (event.key() != InputConstants.KEY_ESCAPE) {
+                if (this.search.isFocused()) this.search.keyPressed(event);
+                return true;
+            }
+            if (this.getFocused() == this.search) {
+                this.setFocused(null);
+                return true;
+            }
+        }
+        if (this.waitingForPreference() || this.presentation instanceof NativePlayerPresentation player && !player.idle()
+                || this.presentation instanceof NativeCookingPresentation cooking && cooking.bundlePending()) {
+            if (event.key() == InputConstants.KEY_ESCAPE) this.onClose();
+            else {
+                final String source = keyboardSource(event.key());
+                if (source != null) {
+                    final String alias = this.keyboardAlias(event.key());
+                    if (alias != null) {
+                        final var state = this.nativeInput.button(alias, true, this.inputMode(), this.clock.getAsLong(), this.viewInputEnabled());
+                        if (!this.waitingForPreference()) this.bookkeepingEvents(state);
+                    }
+                    final var result = this.nativeInput.button(source, true, this.inputMode(), this.clock.getAsLong(), this.viewInputEnabled());
+                    if (!this.waitingForPreference()) this.bookkeepingEvents(result);
+                }
+                if (event.key() == InputConstants.KEY_RETURN || event.key() == InputConstants.KEY_SPACE) this.keyboardPressed = true;
+            }
+            return true;
+        }
+        if (this.authoredController()) {
+            final String exit = this.exitSource(event);
+            if (exit != null) {
+                if (exit.equals("button.menu_inventory_cancel") && this.searchHovered()) return true;
+                this.keyboardExit(exit);
+                return true;
+            }
+        }
+        if (this.authoredController() && !this.helpView
+                && Minecraft.getInstance().options.keyDrop.matches(event)) {
+            final String source = this.dropSources.computeIfAbsent(event.key(), _ -> event.hasControlDown()
+                    ? "button.menu_inventory_drop_all" : "button.menu_inventory_drop");
+            this.keyboardInput(source, true);
+            return true;
+        }
+        if (this.authoredController()) {
+            final String source = keyboardSource(event.key());
+            if (source != null) {
+                final String alias = this.keyboardAlias(event.key());
+                if (alias != null) this.keyboardInput(alias, true);
+                if (event.key() == InputConstants.KEY_RETURN || event.key() == InputConstants.KEY_SPACE) this.keyboardPressed = true;
+                return this.keyboardInput(source, true);
+            }
+        }
+        if (this.helpView) {
+            if (event.key() == InputConstants.KEY_ESCAPE) this.onClose();
+            return true;
+        }
+        if (!this.actionScope.subset()) return super.keyPressed(event);
+        if (event.key() == InputConstants.KEY_ESCAPE
+                || this.minecraft.options.keyInventory.matches(event)) this.onClose();
+        return true;
+    }
+
+    private boolean supportsKeyboardInput(final NativeUiScene.Node node, final NativeUiInput.Mapping mapping) {
+        if (mapping.scope() == NativeUiInput.Scope.VIEW) return NativeContainerInput.supportsViewTarget(mapping.target());
+        final int target = mapping.target();
+        if (NativeContainerInput.exitTarget(target)) return true;
+        if (this.presentation instanceof NativeCookingPresentation && NativeCookingNavigation.unregistered(target)) return true;
+        if (this.presentation instanceof NativeCookingPresentation && NativeCookingSourceInput.controlTarget(target)) return true;
+        if (this.presentation instanceof NativeCookingPresentation && (NativeCookingHold.returnTarget(target) || NativeCookingReset.target(target))) return true;
+        // A count-one menu has no held selection for the shared scrolling panel to destroy.
+        if (this.presentation instanceof NativeContainerPresentation && this.actionScope.subset()
+                && target == NativeUiInput.symbol("button.destroy_selection")) return true;
+        if (node.type().equals("toggle") || target == NativeUiInput.symbol("button.container_slot_hovered")
+                || NativeCookingNavigation.supports(target)) return true;
+        if (node.properties().has("recipe_id")) {
+            final int recipe = node.properties().get("recipe_id").getAsInt();
+            return this.authoredController() && isDropTarget(target)
+                    || this.recipeActions.getOrDefault(recipe, Set.of()).stream().anyMatch(action -> NativeUiInput.symbol(action) == target);
+        }
+        if (this.authoredController() && NativeInventorySourceState.navigation(target)) return true;
+        if (this.presentation instanceof NativePlayerPresentation && playerUnsupportedHostAction(target)) return true;
+        if (node.properties().has("inventory_slot"))
+            return this.presentation instanceof NativePlayerPresentation && playerSlotInput(target) != null
+                || this.presentation instanceof NativeCookingPresentation && (isDropTarget(target) || cookingSlotInput(target) != null)
+                || this.nativeActions && this.actionScope.subset() && target == NativeUiInput.symbol("button.container_auto_place_one");
+        if (this.presentation instanceof NativeCookingPresentation cooking && cooking.searchAvailable()
+                && target == NativeUiInput.symbol("button.search_bar_clear")) return true;
+        if (this.help() != null && target == NativeUiInput.symbol("button.help")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && target == NativeUiInput.symbol("button.hide_bundle_tooltip")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && target == NativeUiInput.symbol("button.tapped_bundle_item_icon")) return true;
+        if (this.authoredController() && NativeContainerInput.cursorDropButton(target) >= 0) return true;
+        if (this.authoredController() && node.type().equals("edit_box")
+                && target == NativeUiInput.symbol("button.search_bar_selected")) return true;
+        return (node.string("inventory_command", "").equals("close") || node.flag("help_close", false))
+            && (target == NativeUiInput.symbol("button.menu_exit") || target == NativeUiInput.symbol("button.try_menu_exit"));
+    }
+
+    private static boolean isDropTarget(final int target) {
+        return target == NativeUiInput.symbol("button.drop_one") || target == NativeUiInput.symbol("button.drop_all");
+    }
+
+    private static SlotInput playerSlotInput(final int target) {
+        for (final var entry : PLAYER_SLOT_INPUTS.entrySet())
+            if (NativeUiInput.symbol(entry.getKey()) == target) return entry.getValue();
+        return null;
+    }
+
+    private boolean playerSlotAction(final int slot, final int target) {
+        final var input = playerSlotInput(target);
+        if (input == null || slot < 0 || slot >= this.menu.slots.size()) return false;
+        this.slotClicked(this.menu.getSlot(slot), slot, input.button(), input.input());
+        return true;
+    }
+
+    private static SlotInput cookingSlotInput(final int target) {
+        final var input = playerSlotInput(target);
+        return input != null && input.input() == ContainerInput.PICKUP ? input : null;
+    }
+
+    private boolean cookingKeyboardSlot(final NativeContainerInput.Event event) {
+        final var input = cookingSlotInput(event.button().target());
+        if (input == null || !event.node().properties().has("inventory_slot")) return false;
+        if (!(this.presentation instanceof NativeCookingPresentation cooking) || !cooking.idle()
+                || this.cookingHold.busy() || this.actionScope.subset()) return true;
+        final int index = event.node().properties().get("inventory_slot").getAsInt();
+        final var slot = this.menu.getSlot(index);
+        if (!slot.isActive() || this.menu.getCarried().isEmpty() && slot.hasItem() && !slot.mayPickup(this.minecraft.player)) return true;
+        if (input.button() == 0 && this.menu.getCarried().isEmpty() && slot.hasItem() && cooking.holdsAvailable()) {
+            final var bounds = this.nativeInput.bounds(event.node());
+            if (bounds != null && this.cookingHold.pickupReturn(index, slot.getItem(), cooking.message().updateSequence(),
+                    this.clock.getAsLong(), bounds.x() + bounds.width() / 2, bounds.y() + bounds.height() / 2))
+                cooking.holdInput(true);
+        }
+        this.slotClicked(slot, index, input.button(), input.input());
+        return true;
+    }
+
+    private record SlotInput(ContainerInput input, int button) {}
+
+    private static boolean playerUnsupportedHostAction(final int target) {
+        return NativeContainerGeometry.PLAYER_FALLBACK_ACTIONS.stream().anyMatch(action -> NativeUiInput.symbol(action) == target);
+    }
+
+    private boolean keyboardEvents(final NativeContainerInput.Result result) {
+        if (this.presentation instanceof NativeCookingPresentation && (!this.componentEnabled() || this.dragInput != null))
+            return this.bookkeepingEvents(result) || result.consumed();
+        boolean handled = this.componentEvents(result);
+        for (final var event : result.events()) {
+            final var button = event.button();
+            if (button == null || button.phase() != 0 && button.phase() != 1) continue;
+            final var node = event.node();
+            if (this.authoredController() && !this.helpView && isDropTarget(button.target())) {
+                if (button.transition()) {
+                    // Native slot bindings prefer a held stack for drop_one. A held stack blocks
+                    // drop_all, including when the pointed slot contains another item.
+                    if (!this.menu.getCarried().isEmpty()) {
+                        if (button.target() == NativeUiInput.symbol("button.drop_one"))
+                            this.slotClicked(null, -999, 1, ContainerInput.PICKUP);
+                    } else if (node.properties().has("inventory_slot")) {
+                        this.playerSlotAction(node.properties().get("inventory_slot").getAsInt(), button.target());
+                    }
+                }
+                handled = true;
+            } else if (node.properties().has("recipe_id")) {
+                final int recipe = node.properties().get("recipe_id").getAsInt();
+                final var mode = java.util.Arrays.stream(NativeCookingAction.Mode.values())
+                    .filter(candidate -> NativeUiInput.symbol(candidate.button()) == button.target()).findFirst().orElse(null);
+                if (mode == null && button.transition() && this.presentation instanceof NativePlayerPresentation && NativeContainerGeometry.RECIPE_AUXILIARY_ACTIONS.stream()
+                        .anyMatch(action -> NativeUiInput.symbol(action) == button.target())) {
+                    this.fallback(new IllegalArgumentException("Native recipe auxiliary input is not supported"));
+                    handled = true;
+                } else if (mode != null && this.recipeActions.getOrDefault(recipe, Set.of()).contains(mode.button())) {
+                    if (this.presentation instanceof NativePlayerPresentation) {
+                        if (button.transition()) BedrockNativePlayerInventory.action(this.owner, this.menu, recipe, playerMode(mode));
+                    } else if (button.transition() && this.recipePress == null && BedrockNativeCooking.action(this.owner, this.menu, recipe, mode, 0))
+                        this.recipePress = new RecipePress(-1, recipe, mode);
+                    handled = true;
+                }
+            } else if (this.bundleEvent(event)) {
+                handled = true;
+            } else if (button.transition() && this.presentation instanceof NativeCookingPresentation && this.cookingKeyboardSlot(event)) {
+                handled = true;
+            } else if (button.transition() && this.presentation instanceof NativePlayerPresentation && node.properties().has("inventory_slot")
+                    && this.playerSlotAction(node.properties().get("inventory_slot").getAsInt(), button.target())) {
+                handled = true;
+            } else if (button.transition() && button.target() == NativeUiInput.symbol("button.container_auto_place_one")
+                    && node.properties().has("inventory_slot")) {
+                final int slot = node.properties().get("inventory_slot").getAsInt();
+                if (this.activated && this.actionScope.slots().contains(slot) && this.sceneSlots.get(slot).isActive())
+                    this.send(NativeContainerAction.Mode.AUTO_PLACE_ONE, slot);
+                handled = true;
+            } else if (button.transition() && node.string("inventory_command", "").equals("close")
+                    && button.target() == NativeUiInput.symbol("button.try_menu_exit")) {
+                this.onClose();
+                handled = true;
+            }
+        }
+        return handled || result.consumed();
+    }
+
+    private String exitSource(final KeyEvent event) {
+        if (event.key() == InputConstants.KEY_ESCAPE) return "button.menu_cancel";
+        return this.minecraft.options.keyInventory != null && this.minecraft.options.keyInventory.matches(event)
+                ? "button.menu_inventory_cancel" : null;
+    }
+
+    private String keyboardAlias(final int key) {
+        if (!(this.presentation instanceof NativeCookingPresentation) || this.helpView) return null;
+        return switch (key) {
+            case InputConstants.KEY_RETURN -> "button.return";
+            case InputConstants.KEY_UP -> "button.arrow_up";
+            case InputConstants.KEY_DOWN -> "button.arrow_down";
+            case InputConstants.KEY_LEFT -> "button.arrow_left";
+            case InputConstants.KEY_RIGHT -> "button.arrow_right";
+            default -> null;
+        };
+    }
+
+    private String keyboardSource(final int key) {
+        return switch (key) {
+            case InputConstants.KEY_UP -> "button.menu_up";
+            case InputConstants.KEY_DOWN -> "button.menu_down";
+            case InputConstants.KEY_LEFT -> "button.menu_left";
+            case InputConstants.KEY_RIGHT -> "button.menu_right";
+            case InputConstants.KEY_RETURN -> "button.menu_ok";
+            case InputConstants.KEY_SPACE -> this.presentation instanceof NativeCookingPresentation && !this.helpView ? null : "button.menu_ok";
+            default -> null;
+        };
+    }
+
+    private void keyboardExit(final String source) {
+        final var result = this.nativeInput.button(source, true, this.inputMode(), this.clock.getAsLong(), this.componentEnabled());
+        this.keyboardEvents(result);
+        // An inactive editor can consume menu_cancel to report deselection. That callback
+        // does not replace the screen exit after active text editing handled Escape above.
+        if (result.events().stream().allMatch(event -> event.button() != null
+                && event.button().target() == NativeUiInput.symbol("button.search_bar_deselected"))) this.onClose();
+        if (this.updateWindows()) this.refreshSafely();
+    }
+
+    private boolean keyboardInput(final String source, final boolean pressed) {
+        final var previous = this.nativeInput.focused();
+        final var result = this.nativeInput.button(source, pressed, this.inputMode(), this.clock.getAsLong(),
+                this.viewInputEnabled() || !pressed && this.cookingHold.busy());
+        final boolean handled = !this.waitingForPreference() && this.keyboardEvents(result);
+        if (this.updateWindows()) this.refreshSafely();
+        return handled || previous != this.nativeInput.focused() || result.consumed();
+    }
+
+    private void revealFocus(final NativeUiScene.Node focused) {
+        if (this.scroll.reveal(this.root, focused)) this.scrollAnimation(true);
+        this.layout(this.animationTime(), -1, -1);
+    }
+
+    @Override
+    public boolean keyReleased(final KeyEvent event) {
+        if (this.closing()) return true;
+        final String dropSource = this.dropSources.remove(event.key());
+        if (dropSource != null) {
+            if (this.current()) this.keyboardInput(dropSource, false);
+            return true;
+        }
+        final String exit = this.exitSource(event);
+        final String source = exit != null ? exit : keyboardSource(event.key());
+        if (this.current() && this.authoredController() && source != null) {
+            if (this.helpView) this.inventoryInput.button(source, false, 1, this.clock.getAsLong(), false);
+            final String alias = this.keyboardAlias(event.key());
+            if (alias != null) this.keyboardInput(alias, false);
+            final boolean handled = this.keyboardInput(source, false);
+            if (event.key() != InputConstants.KEY_RETURN && event.key() != InputConstants.KEY_SPACE) return handled;
+            final var press = this.recipePress;
+            if (press != null && press.button == -1) {
+                this.recipePress = null;
+                BedrockNativeCooking.action(this.owner, this.menu, press.recipe, press.mode, 2);
+            }
+            final boolean consumed = this.keyboardPressed;
+            this.keyboardPressed = false;
+            return consumed || handled;
+        }
+        return super.keyReleased(event);
+    }
+
+    void fallback(final RuntimeException error) {
+        if (this.fallingBack) return;
+        this.fallingBack = true;
+        try {
+            if (this.sourceInput != null && this.inputMode() == 2) this.sourceInput.finish();
+            this.finishDragInput();
+            this.deactivate();
+            this.retireCooking();
+        } catch (final RuntimeException transportError) {
+            if (transportError != error) error.addSuppressed(transportError);
+        } finally {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn(
+                            "Unsupported native inventory presentation; retaining ordinary menu"
+                                    + " controls",
+                            error);
+            // Controller retirement must not prevent restoring the still-displayed menu.
+            final var client = Minecraft.getInstance();
+            if (client.gui.screen() == this && client.getConnection() == this.owner
+                    && this.owner.getConnection().isConnected() && client.player != null && client.player.containerMenu == this.menu)
+                BedrockNativeContainers.replace(this.ordinary);
+        }
+    }
+
+    private void retireCooking() {
+        this.dragInput = null;
+        this.cookingHold.clear();
+        this.capturedButtons.clear();
+        this.nativeButtons.clear();
+        this.pointerSources.clear();
+        this.dropSources.clear();
+        this.keyboardPressed = false;
+        this.consumedReleases.clear();
+        this.recipePress = null;
+        this.preferenceChange = null;
+        if (this.presentation instanceof NativeCookingPresentation cooking)
+            BedrockNativeCooking.retire(this.owner, this.menu, cooking);
+        if (this.presentation instanceof NativePlayerPresentation player) BedrockNativePlayerInventory.retire(player);
+    }
+
+    void discard() { this.releaseSearch(); if (this.renderer != null) this.renderer.close(); this.images.close(); }
+
+    @Override
+    public void removed() {
+        this.exitFinished = true;
+        try {
+            this.deactivate();
+            this.retireCooking();
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn("Unable to retire native inventory activation", error);
+        } finally {
+            try {
+                this.discard();
+            } finally {
+                super.removed();
+            }
+        }
+    }
+}
