+            if (box.visibleBounds().contains(mouseX, mouseY)) NativeInventoryItemPresentation.requireTooltip(stack);
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(box.bounds().x(), box.bounds().y());
+                graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+                NativeInventoryItemStyle.extract((IBedrockGuiItemStyle) graphics, NativeInventoryItemStyle.from(box.node(), alpha), () -> graphics.item(stack, 0, 0));
+            } finally { graphics.pose().popMatrix(); }
+            return;
+        }
+        if (!box.node().properties().has("inventory_slot"))
+            throw new IllegalArgumentException("Inventory item has no actual slot");
+        final int sceneIndex = box.node().properties().get("inventory_slot").getAsInt();
+        final Slot slot = this.sceneSlots.get(sceneIndex);
+        final var heldPreview = this.cookingHold.preview(sceneIndex, slot.getItem());
+        if (heldPreview != slot.getItem()) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(box.bounds().x(), box.bounds().y());
+                graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+                NativeInventoryItemStyle.extract((IBedrockGuiItemStyle) graphics, NativeInventoryItemStyle.from(box.node(), alpha),
