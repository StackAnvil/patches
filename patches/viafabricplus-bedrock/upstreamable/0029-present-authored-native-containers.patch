+        when(game.getConnection()).thenReturn(listener);
+        final var sessions = BedrockNativeContainers.class.getDeclaredField("PRESENTATIONS");
+        sessions.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        final var session = (NativeContainerPresentationController<ClientPacketListener, AbstractContainerMenu, ?>) sessions.get(null);
+        final var minecraft = Screen.class.getDeclaredField("minecraft");
+        minecraft.setAccessible(true);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            for (final var kind : ContainerUi.Kind.values()) {
+                if (kind == ContainerUi.Kind.BREWING_STAND) continue;
+                final AbstractContainerMenu menu = switch (kind) {
+                    case HOPPER -> new HopperMenu(7, inventory);
+                    case BREWING_STAND -> new net.minecraft.world.inventory.BrewingStandMenu(7, inventory);
+                    case DISPENSER, DROPPER -> new DispenserMenu(7, inventory);
+                    case SHULKER_BOX -> new ShulkerBoxMenu(7, inventory);
+                    case CHEST_6_ROWS -> ChestMenu.sixRows(7, inventory);
+                    default -> ChestMenu.threeRows(7, inventory);
+                };
+                assertTrue(BedrockNativeContainers.matches(menu, kind));
+                assertEquals(kind.containerSlots() + 36, menu.slots.size());
+                assertFalse(BedrockNativeContainers.matches(new HopperMenu(7, inventory),
+                        kind == ContainerUi.Kind.HOPPER ? ContainerUi.Kind.DROPPER : kind));
+                final AbstractContainerScreen<?> ordinary = switch (menu) {
+                    case net.minecraft.world.inventory.BrewingStandMenu brewing -> new net.minecraft.client.gui.screens.inventory.BrewingStandScreen(brewing, inventory, Component.empty());
+                    case HopperMenu hopper -> new HopperScreen(hopper, inventory, Component.empty());
+                    case DispenserMenu dispenser -> new DispenserScreen(dispenser, inventory, Component.empty());
+                    case ShulkerBoxMenu shulker -> new ShulkerBoxScreen(shulker, inventory, Component.empty());
+                    case ChestMenu chest -> new ContainerScreen(chest, inventory, Component.empty());
+                    default -> throw new AssertionError();
+                };
+                player.containerMenu = menu;
