+    private void item(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final int mouseX, final int mouseY, final float alpha) {
+        if (box.node().flag("disabled_filter_visible", false))
+            throw new IllegalArgumentException("Unsupported native inactive-item filter");
+        if (box.node().flag("inventory_cursor", false))
+            return; // Vanilla extractCarriedItem owns its actual quickcraft remainder.
+        if (box.node().properties().has("recipe_id")) {
+            final var stack = this.recipePreviews.get(box.node().properties().get("recipe_id").getAsInt());
+            if (stack == null) throw new IllegalArgumentException("Recipe item has no authoritative preview");
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(box.bounds().x(), box.bounds().y());
+                graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+                NativeInventoryItemOpacity.extract((IBedrockGuiItemOpacity) graphics, alpha, () -> graphics.item(stack, 0, 0));
+            } finally { graphics.pose().popMatrix(); }
+            return;
+        }
+        if (!box.node().properties().has("inventory_slot"))
+            throw new IllegalArgumentException("Inventory item has no actual slot");
+        final Slot slot =
+                this.menu.slots.get(box.node().properties().get("inventory_slot").getAsInt());
+        this.drawingSlot = slot;
+        graphics.pose().pushMatrix();
+        try {
+            graphics.pose().translate(box.bounds().x(), box.bounds().y());
+            graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+            graphics.pose().translate(-slot.x, -slot.y);
