+    @Test
+    void exactCookingFamiliesMatchActualJavaMenus() {
+        final var player = org.mockito.Mockito.mock(net.minecraft.client.player.LocalPlayer.class);
+        final var inventory = new net.minecraft.world.entity.player.Inventory(player, new net.minecraft.world.entity.EntityEquipment());
+        final var level = org.mockito.Mockito.mock(net.minecraft.client.multiplayer.ClientLevel.class);
+        org.mockito.Mockito.when(player.level()).thenReturn(level);
+        org.mockito.Mockito.when(level.recipeAccess()).thenReturn(org.mockito.Mockito.mock(net.minecraft.world.item.crafting.RecipeAccess.class));
+        for (final var family : CookingUi.Family.values()) {
+            final net.minecraft.world.inventory.AbstractContainerMenu menu = switch (family) {
+                case FURNACE -> new net.minecraft.world.inventory.FurnaceMenu(5, inventory);
+                case BLAST_FURNACE -> new net.minecraft.world.inventory.BlastFurnaceMenu(5, inventory);
+                case SMOKER -> new net.minecraft.world.inventory.SmokerMenu(5, inventory);
+            };
+            for (final var candidate : CookingUi.Family.values()) assertEquals(family == candidate, BedrockNativeCooking.matches(menu, candidate));
+            assertFalse(BedrockNativeCooking.matches(new net.minecraft.world.inventory.HopperMenu(5, inventory), family));
+        }
+    }
