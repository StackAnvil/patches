+            final var presentation = new NativeCookingPresentation(message, Map.of(7, stack));
+            stack.setCount(64);
+            final var before = presentation.resolve(5, "", slots(), Map.of(), false);
+            assertEquals(3, before.recipes().get(7).getCount());
+            final var identity = NativeCookingControl.forMessage(message, NativeCookingControl.Mode.ACTIVATE);
+            final var progress = new CookingUi.Progress(50, 100, 200, 0);
+            final long revision = presentation.revision();
+            assertTrue(presentation.update(new NativeCookingProgress(5, 3, 1, 1, progress)));
+            assertEquals(revision + 1, presentation.revision());
+            final var after = presentation.resolve(5, "", slots(), Map.of(), false);
+            assertEquals(progress.arrowRatio(family), arrow(after.scene()));
+            assertEquals(1F, arrow(before.scene()));
+            assertEquals(identity, NativeCookingControl.forMessage(presentation.message(), NativeCookingControl.Mode.ACTIVATE));
+            assertEquals(0, presentation.message().view().progress().cooking());
+            assertFalse(presentation.update(new NativeCookingProgress(5, 3, 1, 1, progress)));
