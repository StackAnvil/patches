+            new NativeUiLayout.Rect(0, 0, 20, 20), bounds, new NativeUiLayout.Size(20, 20), bounds, 0, List.of())).toList();
+        final var rootNode = new NativeUiScene.Node("root", "panel", new JsonObject(), List.of(nodes), Integer.MIN_VALUE);
+        final var root = new NativeUiLayout.Box(rootNode, bounds, bounds, new NativeUiLayout.Size(100, 100), bounds, 0, children);
+        final var draws = children.stream().filter(box -> box.node().flag("visible", true)).map(box -> new NativeUiPresentation.Draw(box, 1, 1, true)).toList();
