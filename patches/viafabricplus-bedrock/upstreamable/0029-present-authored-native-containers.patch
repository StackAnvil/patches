+    private boolean componentEvents(final NativeContainerInput.Result result) {
+        try {
+            for (final var event : result.events()) {
+                if (event.button() == null || event.button().target() != NativeUiInput.symbol("button.container_slot_hovered")
+                        || event.button().phase() != 0 && event.button().phase() != 1) continue;
+                final Source source = new Source(event.collection(), event.collectionIndex());
+                if (event.button().pressed()) this.tooltipSources.hover(source, this.tooltipData(source) != null);
+                else this.tooltipSources.leave(source);
+            }
+        } catch (final RuntimeException error) {
+            this.fallback(error);
+            return true;
+        }
+        final boolean cursorHandled = this.cursorEvents(result);
+        if (this.presentation instanceof NativePlayerPresentation player) return this.playerEvents(player, result) || cursorHandled;
+        if (!(this.presentation instanceof NativeCookingPresentation cooking)) return cursorHandled;
+        final var message = cooking.message();
+        final var initial = NativeCookingPreferenceControl.snapshot(message.view().family(), message.view().book());
+        FurnaceOptions desired = initial;
+        boolean handled = cursorHandled;
+        for (final var event : result.events()) {
+            if (event.button() != null && event.button().phase() != 0 && event.button().phase() != 1) continue;
+            if (event.change() != null) {
+                final var preference = NativeCookingPreferenceControl.parse(event.node());
+                if (preference != null) {
+                    desired = this.changePreference(preference, event.change(), desired);
+                    handled = true;
+                }
+            } else if (event.button() != null && event.button().target() == NativeUiInput.symbol("button.search_bar_clear") && event.button().transition()) {
+                handled |= this.clearSearch();
+            } else if (event.button() != null && event.button().target() == NativeUiInput.symbol("button.text_edit_box_clear")
+                    && event.button().transition() && this.geometry.clearsSearch(event.node())) {
+                if (this.searchInput) this.clearSearch();
+                handled = true;
+            } else if (event.button() != null && event.node().type().equals("edit_box")
+                    && event.button().target() == NativeUiInput.symbol("button.search_bar_selected") && event.button().pressed() && this.search != null) {
+                if (event.button().handleSelect()) this.focusSearch();
+                else if (event.button().handleDeselect()) this.setFocused(null);
+                handled = true;
+            } else if (event.button() != null && event.node().type().equals("edit_box") && event.button().pressed()
+                    && event.button().target() == NativeUiInput.symbol("button.search_bar_deselected")) {
+                if (event.button().handleDeselect()) this.setFocused(null);
+                handled = true;
+            } else if (event.button() != null && NativeCookingNavigation.supports(event.button().target())) {
+                if (cooking.idle() && this.nativeInput.enabled(event.node())
+                        && message.updateSequence() == this.cookingUpdate && Minecraft.getInstance().gui.screen() == this) {
+                    final var transition = NativeCookingNavigation.transition(desired, message.view().book(), event.button());
+                    desired = transition.options();
+                    if (transition.refresh()) cooking.tabChanged();
+                }
+                handled = true;
+            } else {
+                if (event.button().target() == NativeUiInput.symbol("button.filter_toggle_hovered") && event.button().pressed())
+                    cooking.select("filter_toggle", 0);
+                else if (event.button().target() == NativeUiInput.symbol("button.container_slot_hovered")) {
+                    final String collection = event.collection();
+                    if (event.button().pressed()) cooking.select(collection, event.collectionIndex());
+                    else cooking.deselect(collection, event.collectionIndex());
+                }
+            }
+        }
+        if (!desired.equals(initial)) {
+            this.preferenceChange = new PreferenceChange(message.updateSequence(), this.clock.getAsLong(), desired);
+            try {
+                if (!BedrockFurnacePreferences.change(this.owner.getConnection(), desired))
+                    throw new IllegalStateException("Unable to send native cooking preference");
+            } catch (final RuntimeException error) { this.fallback(error); }
+        }
+        return handled;
+    }
