@@ -0,0 +1,63 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiToggle;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+/** Controller preferences consume emitted native toggle changes, independently of the original button event. */
+record NativeCookingPreferenceControl(Kind kind, int index) {
+    static NativeCookingPreferenceControl parse(final NativeUiScene.Node node) {
+        if (!node.type().equals("toggle")) return null;
+        final var state = node.properties().get("toggle_state");
+        if (state == null || !state.isJsonPrimitive() || !state.getAsJsonPrimitive().isBoolean()
+                || node.properties().has("inventory_slot") || node.properties().has("inventory_actions")
+                || node.properties().has("recipe_actions") || node.properties().has("inventory_command"))
+            throw new IllegalArgumentException("Unbound native cooking preference");
+        final Kind kind = switch (node.string("toggle_name", "")) {
+            case "navigation_tab" -> Kind.TAB;
+            case "toggle.enable_filtering" -> Kind.FILTER;
+            case "layout_toggle" -> Kind.LAYOUT;
+            default -> throw new IllegalArgumentException("Unsupported native cooking toggle group");
+        };
+        final var toggle = NativeUiToggle.parse(node.properties());
+        if (kind != Kind.FILTER && (toggle.forcedIndex() < 1 || toggle.forcedIndex() > (kind == Kind.TAB ? 5 : 2)))
+            throw new IllegalArgumentException("Native preference has no authored selection index");
+        final var input = NativeUiInput.parse(node.properties());
+        if (input.options().wildcard() && input.options().wildcardScope() == NativeUiInput.Scope.GLOBAL)
+            throw new IllegalArgumentException("Unsupported recursive native global wildcard");
+        return new NativeCookingPreferenceControl(kind, kind == Kind.FILTER ? -1 : toggle.forcedIndex());
+    }
+
+    FurnaceOptions options(final FurnaceOptions current, final boolean forcedLayout, final NativeUiToggle.Change change) {
+        final String group = switch (this.kind) {
+            case TAB -> "navigation_tab";
+            case FILTER -> "toggle.enable_filtering";
+            case LAYOUT -> "layout_toggle";
+        };
+        if (change.group() != NativeUiInput.symbol(group) || this.kind != Kind.FILTER && change.index() != this.index)
+            throw new IllegalArgumentException("Native preference event differs from its control");
+        if (this.kind == Kind.LAYOUT && forcedLayout)
+            throw new IllegalArgumentException("Unsupported forced native layout preference");
+        return new FurnaceOptions(current.furnaceType(), this.kind == Kind.TAB ? change.index() : current.leftTab(),
+                this.kind == Kind.FILTER ? change.checked() : current.filtering(),
+                this.kind == Kind.LAYOUT ? change.index() : current.layout());
+    }
+
+    static FurnaceOptions snapshot(final CookingUi.Family family, final CookingUi.Book book) {
+        final int type = switch (family) {
+            case FURNACE -> 1;
+            case BLAST_FURNACE -> 2;
+            case SMOKER -> 3;
+        };
+        return new FurnaceOptions(type, book.tab(), book.filtering(), book.effectiveLayout());
+    }
+
+    enum Kind { TAB, FILTER, LAYOUT }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentation.java
