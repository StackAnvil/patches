+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.function.Function;
+import java.util.regex.Pattern;
+import java.util.regex.Matcher;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiExpression;
+
+/** Input instructions use this client's actual bindings; unsupported inline glyphs cannot leak as token names. */
+final class NativePlayerHelpText {
+    private static final Pattern TOKEN = Pattern.compile(":([A-Za-z0-9_.]+):");
+
+    private NativePlayerHelpText() {}
+
+    static void resolve(final JsonObject scene, final Function<String, String> input) {
+        resolveNode(scene.getAsJsonObject("root"), true, input);
+    }
+
+    private static void resolveNode(final JsonObject node, final boolean parentVisible, final Function<String, String> input) {
+        final boolean visible = parentVisible && (!node.has("visible") || UiExpression.truth(node.get("visible")))
+                && (!UiExpression.truth(node.get("ignored")));
+        if (visible && node.has("type") && node.get("type").getAsString().equals("label") && node.has("text")) {
+            node.addProperty("text", expand(node.get("text").getAsString(), input));
+            if (node.has("text_component")) node.add("text_component", component(node.get("text_component"), input));
+        }
+        if (node.has("children")) for (final var child : node.getAsJsonArray("children")) resolveNode(child.getAsJsonObject(), visible, input);
+    }
+    private static String expand(final String value, final Function<String, String> input) {
+        final var matcher = TOKEN.matcher(value);
+        final var text = new StringBuilder();
+        while (matcher.find()) {
+            final String replacement = input.apply(matcher.group(1));
+            if (replacement == null) throw new IllegalArgumentException("Unsupported native Help glyph " + matcher.group(1));
+            matcher.appendReplacement(text, Matcher.quoteReplacement(replacement));
+        }
+        matcher.appendTail(text);
+        return text.toString();
+    }
+
+    private static JsonElement component(final JsonElement source, final Function<String, String> input) {
+        if (source.isJsonPrimitive() && source.getAsJsonPrimitive().isString()) return new JsonPrimitive(expand(source.getAsString(), input));
+        if (source.isJsonArray()) {
+            final var values = new JsonArray();
+            for (final var value : source.getAsJsonArray()) values.add(component(value, input));
+            return values;
+        }
+        final JsonElement result = source.deepCopy();
+        if (result.isJsonObject()) {
+            final var object = result.getAsJsonObject();
+            if (object.has("text")) object.addProperty("text", expand(object.get("text").getAsString(), input));
+            for (final String key : new String[]{"extra", "with"}) if (object.has(key)) object.add(key, component(object.get(key), input));
+        }
+        return result;
+    }
+
+}
