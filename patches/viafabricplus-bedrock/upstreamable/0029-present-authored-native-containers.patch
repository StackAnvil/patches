+        assertEquals(255, decoded.item(1).getCount());
+        assertEquals(2, decoded.item(3).getCount());
+        final var view = decoded.view(2, 1, false, 2, false);
+        assertEquals(List.of(0, 255, 0, 2), view.contents().amounts());
+        assertEquals("Last physical item", view.items().get(3).primaryName());
+        assertEquals(255, view.items().get(1).presentation().get("#inventory_stack_count").getAsInt());
+        final var ui = new ResourcePackStorage(List.of()).getContainerUi();
+        final var kind = ContainerUi.Kind.CHEST_3_ROWS;
+        final var program = ui.exportProgram(kind, new ContainerUi.Title("Chest", false));
+        final var presentation = new NativeContainerPresentation(ContainerUi.fromProgram(program), kind, List.of());
+        final var empty = NativeInventoryItemPresentation.values(ItemStack.EMPTY, false, false);
+        final var slots = IntStream.range(0, 63).mapToObj(slot -> new ContainerUi.Slot(slot, empty)).toList();
+        final var frame = presentation.resolve(7, "Chest", slots, Map.of(), false, view);
+        final var controls = nodes(frame.scene().getAsJsonObject("root"));
+        assertTrue(controls.stream().anyMatch(node -> node.has("text") && node.get("text").isJsonPrimitive()
+                && node.get("text").getAsString().equals("§dOriginal bundle")));
+        final var physical = controls.stream().filter(node -> node.has("bundle_slot")).toList();
+        assertFalse(physical.isEmpty());
+        assertTrue(physical.stream().noneMatch(node -> node.has("inventory_slot") || node.has("inventory_actions")));
+        assertTrue(physical.stream().anyMatch(node -> node.get("bundle_slot").getAsInt() == 3));
+        final var icons = physical.stream().filter(node -> node.has("renderer")
+                && node.get("renderer").getAsString().equals("inventory_item_renderer")).toList();
+        assertFalse(icons.isEmpty());
+        for (final var icon : icons) {
