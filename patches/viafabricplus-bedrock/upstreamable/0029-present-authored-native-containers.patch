+        final var forced = new CookingUi.Book(1, true, 3, true, 1, 1, 1, "", "",
+                book.selection(), book.catalog(), book.visibleRecipes());
+        assertThrows(IllegalArgumentException.class, () -> control.options(NativeCookingPreferenceControl.snapshot(CookingUi.Family.FURNACE, forced), forced.forcedRecipeBookLayout(), new NativeUiToggle.Change(NativeUiInput.symbol("layout_toggle"), 1, true, false, true)));
+    }
+
+    @Test
+    void preferenceTogglesAndSlotsShareClippedPainterOrder() {
+        final var slot = draw(0, true, 1, 0, 0, 18, new NativeUiLayout.Rect(0, 0, 100, 100), 1);
+        final var toggle = preference();
+        final var front = new NativeContainerGeometry(List.of(slot, toggle), 1, Map.of(), true);
+        assertTrue(front.hasPreferences());
