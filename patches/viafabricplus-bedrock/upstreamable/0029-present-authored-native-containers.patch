+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.UiProgramFixtures;
+import static org.junit.jupiter.api.Assertions.*;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicLong;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleResult;
