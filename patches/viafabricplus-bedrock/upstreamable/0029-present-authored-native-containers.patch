+
+class NativeCookingPresentationControllerTest {
+    @BeforeAll
+    static void bootstrap() throws Exception { NativeCookingPresentationTest.bootstrap(); }
+
+    @Test
+    void actionsAndRepliesStayWithThePresentedFrameAndCapabilityWithdrawalRetiresItsGesture() {
+        final var controller = new NativeCookingPresentationController<Object, Object>();
+        final var owner = new Object();
+        final var menu = new Object();
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        final var sent = new ArrayList<NativeCookingAction>();
+        controller.begin(owner);
+        assertTrue(controller.accept(owner, menu, 5, first, item -> new ItemStack(Items.IRON_INGOT, 3)));
+        final var presentation = controller.current(owner, menu, 5);
+        // A delayed initial advertisement must not retire a passive presentation.
+        controller.capability(owner, false);
+        assertSame(presentation, controller.current(owner, menu, 5));
+        assertFalse(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        present(presentation);
+        controller.capability(owner, true);
+        assertFalse(controller.action(new Object(), menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(controller.action(owner, new Object(), 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(controller.action(owner, menu, 6, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(sent.isEmpty());
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 2), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertEquals(first.updateSequence(), sent.getLast().updateSequence());
+        final var result = new NativeCookingActionResult(sent.getFirst(), true, false);
+        assertFalse(controller.result(new Object(), menu, 5, result));
+        assertFalse(controller.result(owner, new Object(), 5, result));
+        assertTrue(controller.result(owner, menu, 5, result));
+        assertFalse(controller.result(owner, menu, 5, result));
+        controller.capability(new Object(), false);
+        assertSame(presentation, controller.current(owner, menu, 5));
+        controller.capability(owner, false);
+        assertNull(controller.current(owner, menu, 5));
+        assertFalse(presentation.action(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(controller.result(owner, menu, 5, new NativeCookingActionResult(sent.getLast(), true, false)));
+        controller.capability(owner, true);
+        assertFalse(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 3), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertTrue(controller.accept(owner, menu, 5, sequence(first, 4), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        present(controller.current(owner, menu, 5));
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertEquals(1, sent.getLast().requestSequence());
+        assertEquals(4, sent.getLast().sequence());
+        assertFalse(controller.result(owner, menu, 5, result));
+    }
+
+    @Test
+    void invalidUpdatesAndMenuReuseCannotRevivePendingInput() {
+        final var controller = new NativeCookingPresentationController<Object, Object>();
+        final var owner = new Object();
+        final var menu = new Object();
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        final var sent = new ArrayList<NativeCookingAction>();
+        controller.begin(owner);
+        assertTrue(controller.accept(owner, menu, 5, first, item -> new ItemStack(Items.IRON_INGOT, 3)));
+        final var old = controller.current(owner, menu, 5);
+        present(old);
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertThrows(IllegalArgumentException.class, () -> controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 2), item -> ItemStack.EMPTY));
+        assertFalse(old.result(new NativeCookingActionResult(sent.getFirst(), true, true)));
+        assertTrue(controller.accept(owner, menu, 5, sequence(first, 4), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        final var next = controller.current(owner, menu, 5);
+        present(next);
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        controller.tick(owner, new Object(), 5);
+        assertFalse(next.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+        assertFalse(controller.accept(owner, menu, 5, sequence(first, 4), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        final var nextOwner = new Object();
+        controller.begin(nextOwner);
+        assertTrue(controller.accept(nextOwner, menu, 5, first, item -> new ItemStack(Items.IRON_INGOT, 3)));
+        present(controller.current(nextOwner, menu, 5));
+        assertTrue(controller.action(nextOwner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(controller.result(owner, menu, 5, new NativeCookingActionResult(sent.getFirst(), true, true)));
+    }
+
+    @Test
+    void responseTimeoutRetiresTheOpeningWithoutResettingItsSequenceFloor() {
+        final var clock = new AtomicLong();
+        final var controller = new NativeCookingPresentationController<Object, Object>(clock::get);
+        final var owner = new Object();
+        final var menu = new Object();
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        final var sent = new ArrayList<NativeCookingAction>();
+        controller.begin(owner);
+        assertTrue(controller.accept(owner, menu, 5, first, item -> new ItemStack(Items.IRON_INGOT, 3)));
+        present(controller.current(owner, menu, 5));
+        assertTrue(controller.action(owner, menu, 5, 7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 2), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        clock.set(10_000_000_000L);
+        controller.tick(owner, menu, 5);
+        assertNull(controller.current(owner, menu, 5));
+        controller.begin(owner);
+        assertFalse(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 3), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertFalse(controller.result(owner, menu, 5, new NativeCookingActionResult(sent.getFirst(), true, true)));
+    }
+
+    private static void present(final NativeCookingPresentation presentation) {
+        final var message = presentation.message();
+        presentation.resolve(message.menuId(), "", message.view().slots(), Map.of(), false);
+    }
+
+    @Test
+    void snapshotsAndProgressStayWithTheirConnectionAndExactMenuLifetime() {
+        final var controller = new NativeCookingPresentationController<Object, Object>();
+        final var owner = new Object();
+        final var menu = new Object();
+        final var otherMenu = new Object();
+        final var decoded = new AtomicInteger();
+        final java.util.function.Function<com.viaversion.viaversion.api.minecraft.item.Item, ItemStack> decoder =
+                item -> { decoded.incrementAndGet(); return new ItemStack(Items.IRON_INGOT, item.amount()); };
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        controller.begin(owner);
+        assertFalse(controller.accept(new Object(), menu, 5, first, decoder));
+        assertFalse(controller.accept(owner, menu, 6, first, decoder));
+        assertFalse(controller.accept(owner, null, 5, first, decoder));
+        assertEquals(0, decoded.get());
+        assertTrue(controller.accept(owner, menu, 5, first, decoder));
+        final var presentation = controller.current(owner, menu, 5);
+        assertNotNull(presentation);
+        assertFalse(controller.accept(owner, menu, 5, first, decoder));
+        assertFalse(controller.accept(owner, otherMenu, 5, first, decoder));
+        assertEquals(1, decoded.get());
+        assertTrue(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 2), decoder));
+        assertSame(presentation, controller.current(owner, menu, 5));
+        final var progress = new NativeCookingProgress(5, 3, 2, 1, new CookingUi.Progress(1, 2, 3, 4));
+        assertFalse(controller.progress(owner, menu, 5, new NativeCookingProgress(5, 3, 1, 1, progress.progress())));
+        assertFalse(controller.progress(owner, otherMenu, 5, progress));
+        assertTrue(controller.progress(owner, menu, 5, progress));
+        assertFalse(controller.progress(owner, menu, 5, progress));
+        assertEquals(2, presentation.message().updateSequence());
+        controller.tick(owner, otherMenu, 5);
+        assertNull(controller.current(owner, menu, 5));
+        assertFalse(controller.accept(owner, otherMenu, 5, message(CookingUi.Family.FURNACE, 3), decoder));
+        final var next = sequence(first, 4);
+        assertTrue(controller.accept(owner, otherMenu, 5, next, decoder));
+        assertNotSame(presentation, controller.current(owner, otherMenu, 5));
+        assertFalse(controller.progress(owner, otherMenu, 5, progress));
+        controller.clear(new Object());
+        assertNotNull(controller.current(owner, otherMenu, 5));
+        controller.clear(owner);
+        assertNull(controller.current(owner, otherMenu, 5));
+        final var nextOwner = new Object();
+        controller.begin(nextOwner);
+        assertTrue(controller.accept(nextOwner, otherMenu, 5, first, decoder));
+    }
+
+    @Test
+    void invalidNewerItemConversionRetiresOldAuthorityWithoutAcceptingLateFrames() {
+        final var controller = new NativeCookingPresentationController<Object, Object>();
+        final var owner = new Object();
+        final var menu = new Object();
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        controller.begin(owner);
+        assertTrue(controller.accept(owner, menu, 5, first, item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertThrows(IllegalArgumentException.class, () -> controller.accept(owner, menu, 5,
+                message(CookingUi.Family.FURNACE, 2), item -> ItemStack.EMPTY));
+        assertNull(controller.current(owner, menu, 5));
+        assertFalse(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 3),
+                item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertThrows(IllegalStateException.class, () -> controller.accept(owner, menu, 5, sequence(first, 4),
+                item -> { throw new IllegalStateException(); }));
+        assertNull(controller.current(owner, menu, 5));
+        assertFalse(controller.accept(owner, menu, 5, sequence(first, 4), item -> new ItemStack(Items.IRON_INGOT, 3)));
+        assertTrue(controller.accept(owner, menu, 5, sequence(first, 5), item -> new ItemStack(Items.IRON_INGOT, 3)));
+    }
+
+    @Test
+    void exactCookingFamiliesMatchActualJavaMenus() {
+        final var player = org.mockito.Mockito.mock(net.minecraft.client.player.LocalPlayer.class);
+        final var inventory = new net.minecraft.world.entity.player.Inventory(player, new net.minecraft.world.entity.EntityEquipment());
+        final var level = org.mockito.Mockito.mock(net.minecraft.client.multiplayer.ClientLevel.class);
+        org.mockito.Mockito.when(player.level()).thenReturn(level);
+        org.mockito.Mockito.when(level.recipeAccess()).thenReturn(org.mockito.Mockito.mock(net.minecraft.world.item.crafting.RecipeAccess.class));
+        for (final var family : CookingUi.Family.values()) {
+            final net.minecraft.world.inventory.AbstractContainerMenu menu = switch (family) {
+                case FURNACE -> new net.minecraft.world.inventory.FurnaceMenu(5, inventory);
+                case BLAST_FURNACE -> new net.minecraft.world.inventory.BlastFurnaceMenu(5, inventory);
+                case SMOKER -> new net.minecraft.world.inventory.SmokerMenu(5, inventory);
+            };
+            for (final var candidate : CookingUi.Family.values()) assertEquals(family == candidate, BedrockNativeCooking.matches(menu, candidate));
+            assertFalse(BedrockNativeCooking.matches(new net.minecraft.world.inventory.HopperMenu(5, inventory), family));
+        }
+    }
+
+    private static NativeCookingMessage sequence(final NativeCookingMessage source, final long sequence) {
+        return new NativeCookingMessage(source.menuId(), sequence, source.updateSequence(), source.menuRevision(),
+                source.inventoryRevision(), source.cursorRevision(), source.program(), source.snapshot(), source.recipeItems());
+    }
