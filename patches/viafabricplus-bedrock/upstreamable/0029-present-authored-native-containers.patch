+            } else if (event.button() != null && event.button().transition() && event.button().target() == NativeUiInput.symbol("button.help")) {
+                player.openHelp();
+                handled = true;
+            } else if (event.button() != null && event.button().transition() && event.button().target() == NativeUiInput.symbol("button.hide_bundle_tooltip")) {
+                handled |= this.tooltipSources.hide();
+            } else if (event.button() != null && event.button().pressed() && event.button().previous() != 1
+                    && event.button().target() == NativeUiInput.symbol("button.tapped_bundle_item_icon") && event.collection().equals("bundle_items")) {
