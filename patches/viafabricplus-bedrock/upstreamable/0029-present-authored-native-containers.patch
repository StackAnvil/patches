+    private void updateGeometry() {
+        if (this.geometry != null && this.geometry.reusableFor(this.draws)) return;
+        this.geometry = new NativeContainerGeometry(this.draws, this.sceneSlots.size(), this.recipeActions,
+                this.presentation instanceof NativeCookingPresentation && !this.helping(), this.presentation instanceof NativePlayerPresentation || this.helping());
