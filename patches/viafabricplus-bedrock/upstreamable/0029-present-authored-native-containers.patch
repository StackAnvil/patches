+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiAnimationLifecycle;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeContainerDrawsTest {
+    @Test
+    void keyboardFocusKeepsItsVisualStateWhenThePointerIsOutsideTheControls() {
+        final var scene = NativeUiScene.parse("""
+                {"format":1,"root":{"name":"host","type":"panel","size":[100,100],
+                  "button_mappings":[{"from_button_id":"button.menu_right","to_button_id":"button.menu_right",
+                    "mapping_type":"global","scope":"view"}],"children":[
+                  {"name":"first","type":"toggle","toggle_state":true,"focus_enabled":true,"anchor_from":"top_left","anchor_to":"top_left",
+                    "size":[40,40],"checked_control":"first_default","checked_hover_control":"first_focused",
+                    "children":[{"name":"first_default","type":"image"},{"name":"first_focused","type":"image"}]},
+                  {"name":"second","type":"toggle","toggle_state":true,"focus_enabled":true,"anchor_from":"top_left","anchor_to":"top_left",
+                    "offset":[50,0],"size":[40,40],"checked_control":"second_default","checked_hover_control":"second_focused",
+                    "children":[{"name":"second_default","type":"image"},{"name":"second_focused","type":"image"}]}]}}
+                """, Set.of()).root();
+        final var root = layout(scene);
+        final var lifecycle = new NativeUiAnimationLifecycle(scene);
+        final var input = new NativeContainerInput(_ -> { });
+        input.prepare(scene);
+        final var draws = new NativeContainerDraws();
+        final var initial = draws.update(root, 60, 20, lifecycle.animations(), input, 0);
+        input.layout(root, initial, 100, 100);
+        input.button("button.menu_right", true, 1, 0, true);
+        assertSame(scene.children().getFirst(), input.focused());
+        final var focused = draws.update(root, 60, 20, lifecycle.animations(), input, 0);
+        assertTrue(focused.stream().anyMatch(draw -> draw.box().node().name().equals("first_focused")));
+        assertFalse(focused.stream().anyMatch(draw -> draw.box().node().name().equals("first_default")));
+        assertFalse(focused.stream().anyMatch(draw -> draw.box().node().name().equals("second_focused")));
+        final var moved = draws.update(root, 91, 91, lifecycle.animations(), input, 1);
+        assertTrue(moved.stream().anyMatch(draw -> draw.box().node().name().equals("first_focused")));
+        input.layout(root, moved, 100, 100);
+        input.pointer(91, 91, 1, 2, true);
+        assertSame(scene.children().getFirst(), input.focused());
+        final var pointer = draws.update(root, 91, 91, lifecycle.animations(), input, 2);
+        assertTrue(pointer.stream().anyMatch(draw -> draw.box().node().name().equals("first_default")));
+        assertFalse(pointer.stream().anyMatch(draw -> draw.box().node().name().equals("first_focused")));
+        input.button("button.menu_right", false, 1, 2, true);
+        input.button("button.menu_right", true, 1, 3, true);
+        assertSame(scene.children().getLast(), input.focused());
+        final var next = draws.update(root, 91, 91, lifecycle.animations(), input, 3);
+        assertTrue(next.stream().anyMatch(draw -> draw.box().node().name().equals("second_focused")));
+        assertTrue(next.stream().anyMatch(draw -> draw.box().node().name().equals("first_default")));
+        assertFalse(next.stream().anyMatch(draw -> draw.box().node().name().equals("first_focused")));
+    }
+
+    @Test
+    void aStationaryPointerDoesNotFreezeFadesOrEventResets() {
+        final var scene = NativeUiScene.parse("""
+                {"format":1,"root":{"name":"backdrop","type":"image","alpha":0.4,"size":[100,100],
+                  "animation_program":{"roots":[0],"tracks":[
+                    {"anim_type":"alpha","from":0,"to":1,"duration":1,"easing":"linear",
+                     "scale_from_starting_alpha":true,"play_event":"fade","reset_event":"reset"}]}}}
+                """, Set.of()).root();
+        final var root = layout(scene);
+        final var lifecycle = new NativeUiAnimationLifecycle(scene);
+        final var input = new NativeContainerInput(_ -> { });
+        input.prepare(scene);
+        final var draws = new NativeContainerDraws();
+        lifecycle.animations().event(scene, "fade", 0);
+        lifecycle.advance(500_000_000);
+        assertEquals(.2F, draws.update(root, 50, 50, lifecycle.animations(), input, 500_000_000).getFirst().alpha(), .000001F);
+        lifecycle.animations().event(scene, "reset", 500_000_000);
+        assertEquals(0, draws.update(root, 50, 50, lifecycle.animations(), input, 500_000_000).getFirst().alpha());
+        lifecycle.animations().event(scene, "fade", 500_000_000);
+        lifecycle.advance(1_500_000_000);
+        assertEquals(.4F, draws.update(root, 50, 50, lifecycle.animations(), input, 1_500_000_000).getFirst().alpha(), .000001F);
+        lifecycle.advance(2_000_000_000);
+        assertEquals(.4F, draws.update(root, 50, 50, lifecycle.animations(), input, 2_000_000_000).getFirst().alpha(), .000001F);
+    }
+
+    @Test
+    void togglingWithoutPointerMovementReplacesTheVisibleState() {
+        final var scene = NativeUiScene.parse("""
+                {"format":1,"root":{"name":"filter","type":"toggle","size":[100,100],
+                  "toggle_state":false,"toggle_name":"toggle.enable_filtering",
+                  "checked_control":"checked","unchecked_control":"unchecked",
+                  "button_mappings":[{"from_button_id":"button.menu_select",
+                    "to_button_id":"button.menu_select","mapping_type":"pressed"}],
+                  "children":[{"name":"checked","type":"image","size":[100,100]},
+                              {"name":"unchecked","type":"image","size":[100,100]}]}}
+                """, Set.of()).root();
+        final var root = layout(scene);
+        final var lifecycle = new NativeUiAnimationLifecycle(scene);
+        final var input = new NativeContainerInput(_ -> { });
+        input.prepare(scene);
+        final var draws = new NativeContainerDraws();
+        final var initial = draws.update(root, 50, 50, lifecycle.animations(), input, 0);
+        assertSame(scene.children().getLast(), initial.getLast().box().node());
+        input.layout(root, initial, 100, 100);
+        input.pointer(50, 50, 1, 0, true);
+        assertTrue(input.button("button.menu_select", true, 1, 0, true).events().getFirst().change().checked());
+        assertSame(scene.children().getFirst(), draws.update(root, 50, 50, lifecycle.animations(), input, 0).getLast().box().node());
+    }
+
+    private static NativeUiLayout.Box layout(final NativeUiScene.Node scene) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(scene, 100, 100, Map.of());
+    }
+}
