+
+    private static float arrow(final JsonObject scene) {
+        return nodes(scene.getAsJsonObject("root")).stream().filter(n -> n.has("clip_ratio")
+                && n.has("clip_direction") && n.get("clip_direction").getAsString().equals("left"))
+                .findFirst().orElseThrow().get("clip_ratio").getAsFloat();
+    }
+
+    private static List<JsonObject> nodes(final JsonObject node) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(node);
+        if (node.has("children")) node.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    private static List<ContainerUi.Slot> slots() {
+        return IntStream.range(0, 39).mapToObj(slot -> new ContainerUi.Slot(slot,
+                Map.of("#inventory_stack_count", new JsonPrimitive(slot == 0 ? 2 : 0)))).toList();
+    }
