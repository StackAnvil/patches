+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.ChestMenu;
+import net.minecraft.world.inventory.BrewingStandMenu;
+import net.minecraft.world.inventory.DispenserMenu;
+import net.minecraft.world.inventory.HopperMenu;
+import net.minecraft.world.inventory.ShulkerBoxMenu;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+
+/** Accepts presentation only after Java opened the exact menu; never queues it for a later menu. */
+public final class BedrockNativeContainers {
+    private static final NativeContainerPresentationController<ClientPacketListener, AbstractContainerMenu, Presentation>
+            PRESENTATIONS = new NativeContainerPresentationController<>();
+    private static AbstractContainerMenu replacing;
+    private static long ticks;
+
+    private record Presentation(
+            ClientPacketListener owner,
+            AbstractContainerMenu menu,
+            AbstractContainerScreen<?> ordinary,
+            NativeContainerMessage message,
+            ContainerUi program,
+            boolean nativeActions) {}
+
+    private BedrockNativeContainers() {}
+
+    public static void register() {
+        BedrockNativeCooking.register();
+        PayloadTypeRegistry.clientboundPlay().register(NativeContainerPayload.TYPE, NativeContainerPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay()
+                .register(NativeContainerCurrentPayload.TYPE, NativeContainerCurrentPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay()
+                .register(NativeContainerFamiliesPayload.TYPE, NativeContainerFamiliesPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay()
+                .register(NativeContainerStatusPayload.TYPE, NativeContainerStatusPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeContainerWorkstationsPayload.TYPE, NativeContainerWorkstationsPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeContainerDataPayload.TYPE, NativeContainerDataPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            ClientPlayNetworking.registerReceiver(NativeContainerWorkstationsPayload.TYPE, (payload, context) -> accept(listener, payload.message(), 4));
+            ClientPlayNetworking.registerReceiver(NativeContainerDataPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (client.gui.screen() instanceof BedrockNativeContainerScreen screen) screen.updateData(listener, payload.data());
+            }));
+        });
+        PayloadTypeRegistry.serverboundPlay()
+                .register(NativeContainerActionPayload.TYPE, NativeContainerActionPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register(
+                (listener, client) -> {
+                    PRESENTATIONS.begin(listener);
+                    ClientPlayNetworking.registerReceiver(
+                            NativeContainerPayload.TYPE,
+                            (payload, context) -> accept(listener, payload.message(), 1));
+                });
+        ClientPlayConnectionEvents.INIT.register(
+                (listener, client) ->
+                        ClientPlayNetworking.registerReceiver(
+                                NativeContainerCurrentPayload.TYPE,
+                                (payload, context) ->
+                                        accept(listener, payload.message(), 2)));
+        ClientPlayConnectionEvents.INIT.register(
+                (listener, client) ->
+                        ClientPlayNetworking.registerReceiver(
+                                NativeContainerFamiliesPayload.TYPE,
+                                (payload, context) ->
+                                        accept(listener, payload.message(), 3)));
+        ClientPlayConnectionEvents.INIT.register(
+                (listener, client) ->
+                        ClientPlayNetworking.registerReceiver(
+                                NativeContainerStatusPayload.TYPE,
+                                (payload, context) ->
+                                        client.execute(
+                                                () -> {
+                                                    if (client.gui.screen()
+                                                            instanceof
+                                                            BedrockNativeContainerScreen screen)
+                                                        screen.activationResult(
+                                                                listener,
+                                                                payload.status());
+                                                })));
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> PRESENTATIONS.clear(listener));
+        ClientTickEvents.END_CLIENT_TICK.register(
+                client -> {
+                    ticks++;
+                    final var listener = client.getConnection();
+                    final var menu = client.player == null ? null : client.player.containerMenu;
+                    PRESENTATIONS.tick(
+                            listener,
+                            menu,
+                            menu == null ? -1 : menu.containerId,
+                            ticks);
+                });
+    }
+
+    static void accept(
+            final ClientPacketListener owner,
+            final NativeContainerMessage message,
+            final int format) {
+        final Minecraft client = Minecraft.getInstance();
+        client.execute(
+                () -> {
+                    if (!connected(owner) || client.player == null) return;
+                    final var menu = client.player.containerMenu;
+                    if (!(client.gui.screen() instanceof AbstractContainerScreen<?> ordinary)
+                            || ordinary.getMenu() != menu
+                            || !matches(menu, message.kind())
+                            || !PRESENTATIONS.claim(
+                                    owner,
+                                    menu,
+                                    menu.containerId,
+                                    message.menuId(),
+                                    message.sequence())) return;
+                    try {
+                        final var program =
+                                JsonParser.parseString(message.program()).getAsJsonObject();
+                        final boolean nativeActions = program.has("native_actions");
+                        if (format == 1 && nativeActions || format == 2 && !nativeActions
+                                || nativeActions && (!program.get("native_actions").isJsonPrimitive()
+                                    || !program.get("native_actions").getAsJsonPrimitive().isBoolean()
+                                    || !program.get("native_actions").getAsBoolean()))
+                            throw new IllegalArgumentException("Native inventory action capability differs");
+                        if (!program.get("condition_title")
+                                .getAsString()
+                                .equals(message.conditionTitle()))
+                            throw new IllegalArgumentException(
+                                    "Native inventory condition identity differs");
+                        final var presentation =
+                                new Presentation(
+                                        owner,
+                                        menu,
+                                        ordinary,
+                                        message,
+                                        ContainerUi.fromProgram(program),
+                                        nativeActions);
+                        final boolean awaiting =
+                                nativeActions
+                                        && program.has("awaiting_contents")
+                                        && program.get("awaiting_contents").getAsBoolean();
+                        final var ready =
+                                PRESENTATIONS.offer(
+                                        owner,
+                                        menu,
+                                        menu.containerId,
+                                        message.sequence(),
+                                        awaiting,
+                                        ticks,
+                                        presentation);
+                        if (ready != null) present(ready);
+                    } catch (final RuntimeException error) {
+                        ViaFabricPlusBedrock.impl()
+                                .logger()
+                                .warn(
+                                        "Unsupported native inventory presentation; keeping"
+                                                + " ordinary controls",
+                                        error);
+                    }
+                });
+    }
+
+    /** Called after vanilla applied a real content packet on the client thread. */
+    public static void contents(final ClientPacketListener owner, final int menuId) {
+        final Minecraft client = Minecraft.getInstance();
+        if (!connected(owner) || client.player == null) return;
+        final var menu = client.player.containerMenu;
+        if (menu.containerId != menuId) return;
+        final var presentation = PRESENTATIONS.contents(owner, menu, menuId, ticks);
+        if (presentation != null) present(presentation);
+    }
+
+    private static void present(final Presentation presentation) {
+        final Minecraft client = Minecraft.getInstance();
+        if (!current(presentation.owner, presentation.menu)
+                || !(client.gui.screen() instanceof AbstractContainerScreen<?> ordinary)
+                || ordinary.getMenu() != presentation.menu) return;
+        final var screen =
+                new BedrockNativeContainerScreen(
+                        presentation.owner,
+                        presentation.ordinary,
+                        client.player.getInventory(),
+                        presentation.ordinary.getTitle(),
+                        presentation.program,
+                        presentation.message.kind(),
+                        presentation.nativeActions,
+                        presentation.message.sequence(), presentation.message.data());
+        try {
+            screen.prepare(
+                    client.font,
+                    screen.nativeViewport().width(),
+                    screen.nativeViewport().height());
+            replace(screen);
+            screen.activate();
+        } catch (final RuntimeException error) {
+            failedPresentation(screen, error);
+        }
+    }
+
+    static void failedPresentation(
+            final BedrockNativeContainerScreen screen, final RuntimeException error) {
+        if (Minecraft.getInstance().gui.screen() == screen) {
+            screen.fallback(error);
+        } else {
+            screen.discard();
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn(
+                            "Unsupported native inventory presentation; keeping ordinary controls",
+                            error);
+        }
+    }
+
+    static boolean matches(final AbstractContainerMenu menu, final ContainerUi.Kind kind) {
+        if (menu == null || menu.slots.size() != kind.containerSlots() + 36) return false;
+        return switch (kind) {
+            case CHEST_3_ROWS, CHEST_6_ROWS, ENDER_CHEST, BARREL ->
+                    menu instanceof ChestMenu chest && chest.getRowCount() * 9 == kind.containerSlots();
+            case SHULKER_BOX -> menu instanceof ShulkerBoxMenu
+                    || menu instanceof ChestMenu chest && chest.getRowCount() == 3;
+            case HOPPER -> menu instanceof HopperMenu;
+            case BREWING_STAND -> menu instanceof BrewingStandMenu;
+            case DISPENSER, DROPPER -> menu instanceof DispenserMenu;
+        };
+    }
+
+    private static boolean connected(final ClientPacketListener owner) {
+        final var listener = Minecraft.getInstance().getConnection();
+        return owner != null && listener == owner && owner.getConnection().isConnected();
+    }
+
+    static boolean current(final ClientPacketListener owner, final AbstractContainerMenu menu) {
+        final Minecraft client = Minecraft.getInstance();
+        return connected(owner)
+                && client.player != null
+                && client.player.containerMenu == menu
+                && PRESENTATIONS.current(owner, menu, menu.containerId);
+    }
+
+    static void replace(final AbstractContainerScreen<?> screen) {
+        final Minecraft client = Minecraft.getInstance();
+        if (client.player == null || client.player.containerMenu != screen.getMenu()) return;
+        replacing = screen.getMenu();
+        try { client.setScreenAndShow(screen); }
+        finally { replacing = null; }
+    }
+
+    /** Suppress menu teardown only during a presentation swap of the same live menu object. */
+    public static boolean replacing(final AbstractContainerMenu menu) { return replacing != null && replacing == menu; }
+}
