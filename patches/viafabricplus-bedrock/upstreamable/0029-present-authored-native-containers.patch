@@ -0,0 +1,187 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+import net.raphimc.viabedrock.api.model.NativeCookingQuery;
+import net.raphimc.viabedrock.api.model.NativeCookingQueryResult;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Authority and progress stay server-owned; genuine client stacks supply rendering and hover data. */
+final class NativeCookingPresentation implements NativeInventoryPresentation {
+    private final NativeCookingActions actions;
+    private NativeCookingMessage message;
+    private CookingUi program;
+    private CookingUi.MenuView view;
+    private Map<Integer, ItemStack> recipes;
+    private CookingUi.Progress progress;
+    private CookingUi.Selection selection;
+    private long dataRevision = -1;
+    private long revision;
+    private String query;
+    private boolean queryDirty;
+    private boolean searchAvailable;
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        this(message, recipes, System::nanoTime);
+    }
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes, final LongSupplier clock) {
+        this.replace(message, recipes);
+        this.actions = new NativeCookingActions(message, clock);
+    }
+
+    boolean update(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence()
+                || message.view().family() != this.view.family()) return false;
+        this.replace(message, recipes);
+        this.actions.update(message);
+        return true;
+    }
+
+    private void replace(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (!recipes.keySet().equals(message.recipeItems().keySet()) || recipes.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Cooking previews differ from the authoritative catalog");
+        final var program = CookingUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+        final var view = message.view();
+        final Map<Integer, ItemStack> copies = new HashMap<>();
+        recipes.forEach((id, item) -> copies.put(id, item.copy()));
+        if (this.view == null || !this.view.book().selection().equals(view.book().selection()))
+            this.selection = view.book().selection();
+        if (this.query == null || !this.queryDirty && (this.actions == null || !this.actions.queryPending()))
+            this.query = view.book().searchText();
+        this.message = message;
+        this.program = program;
+        this.view = view;
+        this.recipes = Map.copyOf(copies);
+        this.progress = view.progress();
+        this.dataRevision = -1;
+        this.revision++;
+    }
+
+    boolean update(final NativeCookingProgress update) {
+        if (update.menuId() != this.message.menuId() || update.sequence() != this.message.sequence()
+                || update.updateSequence() != this.message.updateSequence() || update.dataRevision() <= this.dataRevision) return false;
+        this.progress = update.progress();
+        this.dataRevision = update.dataRevision();
+        this.revision++;
+        return true;
+    }
+
+    NativeCookingMessage message() { return this.message; }
+
+    boolean select(final String collection, final int index) {
+        final var selected = new CookingUi.Selection(collection, index);
+        if (selected.equals(this.selection)) return false;
+        this.selection = selected;
+        this.revision++;
+        return true;
+    }
+
+    boolean deselect(final String collection, final int index) {
+        if (!this.selection.equals(new CookingUi.Selection(collection, index))) return false;
+        return this.select("", -1);
+    }
+
+    void tabChanged() {
+        this.selection = new CookingUi.Selection("", -1);
+        this.revision++;
+    }
+
+    boolean idle() { return !this.queryDirty && this.actions.idle(); }
+
+    boolean searchAvailable() { return this.searchAvailable; }
+
+    void searchCapability(final boolean available) {
+        if (this.searchAvailable == available) return;
+        if (!available && (this.queryDirty || this.actions.queryPending())) this.retire();
+        this.searchAvailable = available;
+        this.revision++;
+    }
+
+    String query() { return this.query; }
+
+    void restoreQuery(final String text) {
+        if (this.query.equals(text)) return;
+        this.query = text;
+        this.queryDirty = !text.equals(this.message.view().book().searchText());
+        this.revision++;
+    }
+
+    boolean query(final String text) {
+        if (!this.searchAvailable || this.expired() || text.length() > NativeCookingQuery.MAX_TEXT_LENGTH) return false;
+        this.query = text;
+        this.queryDirty = true;
+        this.revision++;
+        return true;
+    }
+
+    boolean flushQuery(final Consumer<NativeCookingQuery> sender) {
+        if (!this.searchAvailable || !this.queryDirty) return false;
+        this.queryDirty = false;
+        if (this.actions.query(this.query, sender)) return true;
+        this.queryDirty = true;
+        return false;
+    }
+
+    boolean result(final NativeCookingQueryResult result) {
+        if (!this.actions.result(result)) return false;
+        if (!result.accepted()) this.queryDirty = true;
+        else {
+            this.selection = new CookingUi.Selection("", -1);
+            this.revision++;
+        }
+        return true;
+    }
+
+    boolean forcedRecipeBookLayout() { return this.view.book().forcedRecipeBookLayout(); }
+
+    boolean action(final int recipe, final NativeCookingAction.Mode mode, final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        return (!this.queryDirty || phase == 2) && this.actions.send(recipe, mode, controllerMode, phase, sender);
+    }
+
+    boolean result(final NativeCookingActionResult result) { return this.actions.result(result); }
+
+    boolean expired() { return this.actions.expired(); }
+
+    void retire() { this.actions.retire(); }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender) { return this.actions.cancel(sender); }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags, final BundleTooltipUi.View tooltip) {
+        if (menuId != this.message.menuId()) throw new IllegalArgumentException("Cooking view belongs to another menu");
+        final var source = this.view.book();
+        final var catalog = source.catalog().stream().map(recipe -> {
+            final Map<String, JsonElement> values = new HashMap<>(NativeInventoryItemPresentation.values(this.recipes.get(recipe.id()), false, showTags));
+            values.putAll(recipe.presentation());
+            return new CookingUi.Recipe(recipe.id(), recipe.uniqueId(), recipe.priority(), recipe.unlocked(), recipe.outputName(), recipe.evaluation(), values);
+        }).toList();
+        final var book = new CookingUi.Book(source.layout(), source.forcedRecipeBookLayout(), source.tab(), source.filtering(),
+                source.foodCount(), source.itemCount(), source.blockCount(), source.tabLabel(), this.query, this.selection, catalog, source.visibleRecipes());
+        final var scene = this.program.resolve(new CookingUi.MenuView(menuId, this.view.family(), this.view.title(), slots, cursor, this.progress, book), tooltip);
+        final var scope = CookingUi.actionScope(scene, book);
+        this.actions.presented(this.message, scope);
+        return new Frame(scene, 3, this.recipes, scope.actions());
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentationController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentationController.java
new file mode 100644
index 0000000..d57202b
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentationController.java
@@ -0,0 +1,141 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import java.util.HashMap;
+import java.util.EnumMap;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+
+/** Never retains a presentation for a menu that has not opened or has already closed. */
+final class NativeCookingPresentationController<C, M> {
+    private final NativeContainerSession<C, M> session = new NativeContainerSession<>();
+    private final LongSupplier clock;
+    private C owner;
+    private NativeCookingPresentation presentation;
+    private boolean capabilityAvailable;
+    private final Map<CookingUi.Family, String> queries = new EnumMap<>(CookingUi.Family.class);
+
+    NativeCookingPresentationController() { this(System::nanoTime); }
+
+    NativeCookingPresentationController(final LongSupplier clock) { this.clock = java.util.Objects.requireNonNull(clock); }
+
+    void begin(final C owner) {
+        if (owner == null) throw new IllegalArgumentException("Cooking play session is required");
+        if (this.owner == owner) return;
+        this.retirePresentation();
+        this.session.clear();
+        this.owner = owner;
+        this.queries.clear();
+        this.capabilityAvailable = false;
+    }
+
+    boolean accept(final C owner, final M menu, final int currentMenuId,
+                   final NativeCookingMessage message, final Function<Item, ItemStack> decode) {
+        if (owner == null || this.owner != owner || menu == null || currentMenuId != message.menuId()) return false;
+        final boolean update = this.current(owner, menu, currentMenuId) != null
+                && this.session.sequence() == message.sequence();
+        if (update) {
+            final var previous = this.presentation.message();
+            if (message.updateSequence() <= previous.updateSequence()
+                    || message.view().family() != previous.view().family()) return false;
+        } else if (message.sequence() <= this.session.sequence()) return false;
+        try {
+            final Map<Integer, ItemStack> items = new HashMap<>();
+            message.recipeItems().forEach((id, item) -> items.put(id, decode.apply(item.copy())));
+            if (update) {
+                if (!this.presentation.update(message, items)) return false;
+                this.restoreQuery(this.presentation);
+                return true;
+            }
+            final var next = new NativeCookingPresentation(message, items, this.clock);
+            this.restoreQuery(next);
+            if (!this.session.accept(owner, menu, currentMenuId, message.menuId(), message.sequence())) return false;
+            if (this.presentation != null) this.presentation.retire();
+            this.presentation = next;
+            return true;
+        } catch (final RuntimeException unsupported) {
+            // An invalid newer frame cannot leave the older item authority actionable.
+            if (update || this.session.accept(owner, menu, currentMenuId, message.menuId(), message.sequence())) {
+                this.retirePresentation();
+            }
+            throw unsupported;
+        }
+    }
+
+    private void restoreQuery(final NativeCookingPresentation presentation) {
+        final String retained = this.queries.get(presentation.message().view().family());
+        if (retained != null) presentation.restoreQuery(retained);
+    }
+
+    boolean query(final C owner, final M menu, final int menuId, final String text) {
+        final var current = this.current(owner, menu, menuId);
+        if (current == null || !current.query(text)) return false;
+        this.queries.put(current.message().view().family(), text);
+        return true;
+    }
+
+    boolean progress(final C owner, final M menu, final int menuId, final NativeCookingProgress progress) {
+        final var current = this.current(owner, menu, menuId);
+        return current != null && current.update(progress);
+    }
+
+    NativeCookingPresentation current(final C owner, final M menu, final int menuId) {
+        return this.owner == owner && this.session.current(owner, menu, menuId) ? this.presentation : null;
+    }
+
+    boolean action(final C owner, final M menu, final int menuId, final int recipe, final NativeCookingAction.Mode mode,
+                   final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        final var current = this.current(owner, menu, menuId);
+        return current != null && current.action(recipe, mode, controllerMode, phase, sender);
+    }
+
+    boolean result(final C owner, final M menu, final int menuId, final NativeCookingActionResult result) {
+        final var current = this.current(owner, menu, menuId);
+        return current != null && current.result(result);
+    }
+
+    void retire(final C owner, final M menu, final int menuId) {
+        if (this.current(owner, menu, menuId) != null) this.retirePresentation();
+    }
+
+    void capability(final C owner, final boolean available) {
+        if (this.owner != owner) return;
+        if (this.capabilityAvailable && !available) this.retirePresentation();
+        this.capabilityAvailable = available;
+    }
+
+    void tick(final C owner, final M menu, final int menuId) {
+        if (this.owner == owner && (this.current(owner, menu, menuId) == null || this.presentation.expired())) {
+            this.retirePresentation();
+        }
+    }
+
+    void clear(final C owner) {
+        if (this.owner != owner) return;
+        this.retirePresentation();
+        this.session.clear();
+        this.owner = null;
+        this.queries.clear();
+        this.capabilityAvailable = false;
+    }
+
+    private void retirePresentation() {
+        if (this.presentation != null) this.presentation.retire();
+        this.presentation = null;
+        this.session.close();
+    }
+}
