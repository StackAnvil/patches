+
+/** Different native menu controllers share one renderer and the genuine Java inventory event path. */
+sealed interface NativeInventoryPresentation permits NativeContainerPresentation, NativeCookingPresentation, NativePlayerPresentation {
+    default Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                          final Map<String, JsonElement> cursor, final Boolean showTags) {
+        return this.resolve(menuId, title, slots, cursor, showTags, BundleTooltipUi.View.inactive());
+    }
+
+    Frame resolve(int menuId, String title, List<ContainerUi.Slot> slots, Map<String, JsonElement> cursor,
+                  Boolean showTags, BundleTooltipUi.View tooltip);
+
+    long revision();
+
+    record Frame(JsonObject scene, int containerSlots, Map<Integer, ItemStack> recipes, Map<Integer, Set<String>> recipeActions,
+                 Map<Integer, ItemStack> craftingPreview) {
+        public Frame(final JsonObject scene, final int containerSlots, final Map<Integer, ItemStack> recipes,
+                     final Map<Integer, Set<String>> recipeActions) {
+            this(scene, containerSlots, recipes, recipeActions, Map.of());
+        }
+
+        public Frame {
+            if (scene == null || containerSlots < 0) throw new IllegalArgumentException("Invalid native inventory frame");
+            final Map<Integer, ItemStack> stacks = new HashMap<>();
+            recipes.forEach((id, item) -> stacks.put(id, item.copy()));
+            recipes = Map.copyOf(stacks);
+            Objects.requireNonNull(recipeActions);
+            final Map<Integer, Set<String>> actions = new HashMap<>();
+            recipeActions.forEach((id, values) -> actions.put(id, Set.copyOf(values)));
+            recipeActions = Map.copyOf(actions);
+            final Map<Integer, ItemStack> ghosts = new HashMap<>();
+            craftingPreview.forEach((slot, item) -> ghosts.put(slot, item.copy()));
+            craftingPreview = Map.copyOf(ghosts);
+        }
+    }
+}
