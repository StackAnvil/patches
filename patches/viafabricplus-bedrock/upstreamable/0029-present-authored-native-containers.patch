+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeInventoryProgressTest {
+    @Test
+    void quantizesDeviceEndpointsAndUsesAuthoredFlagsForShadowAndRounding() {
+        final var box = bar(false, false, false, 3);
+        final var scaled = NativeInventoryProgress.quads(box, 1, 1.5F);
+        assertEquals(2, scaled.size());
+        assertEquals(3.333334F, scaled.getLast().bounds().width(), .0001F);
+        assertEquals(.666668F, scaled.getLast().bounds().height(), .0001F);
+        box.node().properties().getAsJsonObject("property_bag").addProperty("round_value", true);
+        assertEquals(3, NativeInventoryProgress.quads(box, 1, 1.5F).getLast().bounds().width());
+        box.node().properties().getAsJsonObject("property_bag").addProperty("drop_shadow", true);
+        final var shadow = NativeInventoryProgress.quads(box, 1, 1);
+        assertEquals(3, shadow.size());
+        assertEquals(13, shadow.getFirst().bounds().width());
+        assertEquals(2, shadow.getFirst().bounds().height());
+        assertEquals(12, shadow.get(1).bounds().width());
+    }
+
+    @Test
+    void usesDurabilityHueAndStorageMinimumWhileRejectingInvalidVisibleInputs() {
+        final var durability = bar(true, false, false, 7.5F);
+        final var fill = NativeInventoryProgress.quads(durability, .8F, 1).getLast();
+        assertEquals(.5F, fill.color().red());
+        assertEquals(1, fill.color().green());
+        assertEquals(.8F, fill.color().alpha());
+        assertEquals(9, fill.bounds().width());
+        final var storage = bar(false, true, true, 0);
+        assertEquals(1, NativeInventoryProgress.quads(storage, 1, 1).getLast().bounds().width());
+        storage.node().properties().addProperty("progress_bar_total_amount", 0);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryProgress.quads(storage, 1, 1));
+        storage.node().properties().addProperty("progress_bar_visible", false);
+        assertTrue(NativeInventoryProgress.quads(storage, 1, 1).isEmpty());
+    }
+
+    @Test
+    void fullStoragePreservesAuthoredPrimaryAndShadowBoundsBeforeOverrides() {
+        final var plain = bar(false, false, true, 10);
+        assertEquals(12, NativeInventoryProgress.quads(plain, 1, 1).getLast().bounds().width());
+        plain.node().properties().getAsJsonObject("property_bag").addProperty("round_value", true);
+        assertEquals(13, NativeInventoryProgress.quads(plain, 1, 1).getLast().bounds().width());
+        final var storage = bar(false, true, true, 10);
+        storage.node().properties().add("primary_color", com.google.gson.JsonParser.parseString("[.2,.4,.6,.1]"));
+        final var primary = NativeInventoryProgress.quads(storage, .7F, 1).getLast();
+        assertEquals(13, primary.bounds().width());
+        assertEquals(.2F, primary.color().red());
+        assertEquals(.6F, primary.color().blue());
+        assertEquals(.7F, primary.color().alpha());
+        storage.node().properties().add("full_storage_color", com.google.gson.JsonParser.parseString("[.9,.8,.3,.2]"));
+        final var full = NativeInventoryProgress.quads(storage, .7F, 1).getLast().color();
+        assertEquals(.9F, full.red());
+        assertEquals(.7F, full.alpha());
+    }
+
+    private static NativeUiLayout.Box bar(final boolean durability, final boolean storage, final boolean shadow, final float current) {
+        final var props = new JsonObject();
+        props.addProperty("touch_progress_bar_visible", true);
+        props.addProperty("progress_bar_visible", true);
+        props.addProperty("progress_bar_current_amount", current);
+        props.addProperty("progress_bar_total_amount", 10);
+        final var bag = new JsonObject();
+        bag.addProperty("is_durability", durability);
+        bag.addProperty("is_storage_bar", storage);
+        bag.addProperty("drop_shadow", shadow);
+        props.add("property_bag", bag);
+        final var node = new NativeUiScene.Node("progress", "custom", props, List.of(), Integer.MIN_VALUE);
+        final var rect = new NativeUiLayout.Rect(10, 20, 12, 1);
+        return new NativeUiLayout.Box(node, rect, rect, new NativeUiLayout.Size(12, 1), rect, 0, List.of());
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventorySourceStateTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventorySourceStateTest.java
