+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+/** Keeps native tab, filter and layout choices independent of Java's recipe-book projection. */
+public final class BedrockFurnacePreferences {
+    private static final NativeFurnacePreferenceState<ClientPacketListener> STATE = new NativeFurnacePreferenceState<>();
+
+    private BedrockFurnacePreferences() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativeFurnaceOptionsPayload.TYPE, NativeFurnaceOptionsPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(NativeFurnaceOptionsPayload.TYPE, NativeFurnaceOptionsPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            STATE.begin(listener);
+            ClientPlayNetworking.registerReceiver(NativeFurnaceOptionsPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (client.getConnection() == listener) STATE.accept(listener, payload.options());
+            }));
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> STATE.clear(listener));
+    }
+
+    public static FurnaceOptions options(final Connection owner, final int family) {
+        return STATE.options(currentListener(owner), family);
+    }
+
+    public static long revision(final Connection owner) {
+        return STATE.revision(currentListener(owner));
+    }
+
+    public static boolean change(final Connection owner, final FurnaceOptions options) {
+        final var listener = currentListener(owner);
+        if (!available(owner)) return false;
+        ClientPlayNetworking.send(new NativeFurnaceOptionsPayload(options));
+        STATE.accept(listener, options);
+        return true;
+    }
+
+    static boolean available(final Connection owner) {
+        final var listener = currentListener(owner);
+        return listener != null && STATE.revision(listener) >= 0
+                && ClientPlayNetworking.canSend(NativeFurnaceOptionsPayload.TYPE);
+    }
+
+    private static ClientPacketListener currentListener(final Connection owner) {
+        final var listener = Minecraft.getInstance().getConnection();
+        return owner != null && listener != null && listener.getConnection() == owner ? listener : null;
+    }
+}
