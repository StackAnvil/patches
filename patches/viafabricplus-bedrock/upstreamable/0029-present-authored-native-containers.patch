+        final var program = new JsonUiProgram(List.of(Map.of("ui/furnace_screen.json", document.getBytes(StandardCharsets.UTF_8))));
+        final int context = UiProgramFixtures.publish(program);
+        final var presentation = new NativeCookingPresentation(retainedMessage(context, 3, 1, "Furnace"), Map.of());
+        long update = 1;
+        for (final int amount : List.of(2, 5, 0, 7)) {
+            if (update > 1) assertTrue(presentation.update(retainedMessage(context, 3, update, "Furnace"), Map.of()));
+            final var frame = presentation.resolve(5, "Furnace", countedSlots(amount), Map.of(), false);
+            assertEquals("2", observedText(frame.scene(), "once"));
+            assertEquals(amount == 0 ? "" : Integer.toString(amount), observedText(frame.scene(), "always"));
+            update++;
+        }
+        assertTrue(presentation.update(retainedMessage(context, 3, update++, "Renamed"), Map.of()));
+        final var renamed = presentation.resolve(5, "Furnace", countedSlots(7), Map.of(), false).scene();
+        assertEquals("2", observedText(renamed, "once"));
+        assertEquals("Renamed", observedText(renamed, "caption"));
+        assertFalse(presentation.update(retainedMessage(context, 4, update, "Furnace"), Map.of()));
+        final var reopened = new NativeCookingPresentation(retainedMessage(context, 4, 1, "Furnace"), Map.of());
+        assertEquals("7", observedText(reopened.resolve(5, "Furnace", countedSlots(7), Map.of(), false).scene(), "once"));
+        final int replacement = UiProgramFixtures.publish(program);
+        assertTrue(presentation.update(retainedMessage(replacement, 3, update, "Furnace"), Map.of()));
+        assertEquals("7", observedText(presentation.resolve(5, "Furnace", countedSlots(7), Map.of(), false).scene(), "once"));
