+
+    @Test
+    void aSelfReferenceResetsButtonAppearanceBeforeTheSenderCommitsItsPhase() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var owner = button(false, true);
+        owner.properties().addProperty("default_control", owner.name());
+        owner.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject().addProperty("mapping_type", "global");
+        layout(input, owner);
