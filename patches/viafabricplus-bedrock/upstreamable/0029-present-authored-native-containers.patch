+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.Set;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingNavigation;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+/** Admits cooking hosts and resolves native tab and layout callbacks. */
+final class NativeCookingNavigation {
+    static final Set<String> TARGETS = Set.of("button.left_panel_tab_decrement", "button.left_panel_tab_increment",
+            "button.layout_decrement", "button.layout_increment");
+
+    private NativeCookingNavigation() { }
+
+    static boolean supports(final int target) {
+        return target == NativeUiInput.symbol("button.left_panel_tab_decrement")
+            || target == NativeUiInput.symbol("button.left_panel_tab_increment")
+            || target == NativeUiInput.symbol("button.layout_decrement")
+            || target == NativeUiInput.symbol("button.layout_increment");
+    }
+
+    static boolean mapped(final NativeUiScene.Node node) {
+        final var mappings = NativeUiInput.parse(node.properties()).mappings();
+        if (mappings.stream().anyMatch(mapping -> supports(mapping.target()) && !mapping.consume()))
+            throw new IllegalArgumentException("Unsupported mixed native navigation and inventory dispatch");
+        return mappings.stream().anyMatch(mapping -> supports(mapping.target()));
+    }
+
+    static boolean host(final NativeUiScene.Node node) {
+        if (!Set.of("input_panel", "screen").contains(node.type())) return false;
+        final var input = NativeUiInput.parse(node.properties());
+        return !input.options().wildcard() && input.hoverBindings().isEmpty() && !input.mappings().isEmpty()
+            && input.mappings().stream().allMatch(mapping -> mapping.scope() == NativeUiInput.Scope.VIEW
+                ? NativeContainerInput.supportsViewTarget(mapping.target())
+                : supports(mapping.target()) || NativeContainerInput.cursorDropButton(mapping.target()) >= 0);
+    }
+
+    static Transition transition(final FurnaceOptions current, final CookingUi.Book book, final NativeUiInput.ButtonEvent event) {
+        if (!supports(event.target())) throw new IllegalArgumentException("Unknown native cooking navigation action");
+        if (!event.transition()) return new Transition(current, false);
+        if (event.target() == NativeUiInput.symbol("button.layout_increment") || event.target() == NativeUiInput.symbol("button.layout_decrement")) {
+            final var direction = event.target() == NativeUiInput.symbol("button.layout_increment")
+                    ? CookingNavigation.Direction.NEXT : CookingNavigation.Direction.PREVIOUS;
+            final int layout = CookingNavigation.layout(book.forcedRecipeBookLayout(), current.layout(), direction);
+            return new Transition(new FurnaceOptions(current.furnaceType(), current.leftTab(), current.filtering(), layout), !book.forcedRecipeBookLayout());
+        }
+        final int delta = event.target() == NativeUiInput.symbol("button.left_panel_tab_decrement") ? -1 : 1;
+        final var next = CookingNavigation.moveTab(book.forcedRecipeBookLayout(), current.layout(), book.foodCount(),
+            book.itemCount(), book.blockCount(), current.leftTab(), delta);
+        return new Transition(next.refresh() ? new FurnaceOptions(current.furnaceType(), next.tab(), current.filtering(), current.layout()) : current,
+            next.refresh());
+    }
+
+    record Transition(FurnaceOptions options, boolean refresh) { }
+}
