+            } else if (button.transition() && this.presentation instanceof NativePlayerPresentation && node.properties().has("inventory_slot")
+                    && this.playerSlotAction(node.properties().get("inventory_slot").getAsInt(), button.target())) {
+                handled = true;
+            } else if (button.transition() && button.target() == NativeUiInput.symbol("button.container_auto_place_one")
