--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingActions.java
@@ -0,0 +1,389 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleResult;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingControl;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldAction;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldResult;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceAction;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceResult;
+import net.raphimc.viabedrock.api.model.NativeCookingQuery;
+import net.raphimc.viabedrock.api.model.NativeCookingQueryResult;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** One menu's input phases retain their original authority while predicted frames advance. */
+final class NativeCookingActions {
+    private static final long RESPONSE_TIMEOUT_NANOS = 10_000_000_000L;
+    private final LongSupplier clock;
+    private final Map<Long, Pending> pending = new HashMap<>();
+    private final Map<Long, HeldPending> heldPending = new HashMap<>();
+    private final Set<Event> emitted = new HashSet<>();
+    private NativeCookingMessage message;
+    private Map<Integer, Set<String>> commands = Map.of();
+    private NativeCookingAction gesture;
+    private NativeCookingAction releaseSource;
+    private NativeCookingHoldAction held;
+    private NativeCookingHoldAction heldReleaseSource;
+    private boolean heldRejected;
+    private Set<String> gestureCommands = Set.of();
+    private long requestSequence;
+    private NativeCookingQuery query;
+    private NativeCookingBundleAction bundle;
+    private long bundleSentAt;
+    private long bundleAwaitingUpdate;
+    private long querySentAt;
+    private long queryAwaitingUpdate;
+    private long invalidatedUpdate;
+    private NativeCookingSourceAction source;
+    private NativeCookingSourceAction sourceRelease;
+    private long sourceSentAt;
+    private long sourceAwaitingUpdate;
+    private boolean sourceDrawing;
+    private boolean retired;
+    private boolean dispatching;
+
+    NativeCookingActions(final NativeCookingMessage message, final LongSupplier clock) {
+        this.message = Objects.requireNonNull(message);
+        this.clock = Objects.requireNonNull(clock);
+    }
+
+    void update(final NativeCookingMessage message) {
+        if (this.retired || message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence())
+            throw new IllegalArgumentException("Cooking action authority belongs to another frame");
+        this.message = message;
+        if (message.updateSequence() > this.queryAwaitingUpdate) this.queryAwaitingUpdate = 0;
+        if (message.updateSequence() > this.bundleAwaitingUpdate) this.bundleAwaitingUpdate = 0;
+        if (message.updateSequence() > this.sourceAwaitingUpdate) this.sourceAwaitingUpdate = 0;
+        this.commands = Map.of();
+    }
+
+    void presented(final NativeCookingMessage message, final CookingUi.RecipeActionScope scope) {
+        if (this.retired || message != this.message)
+            throw new IllegalArgumentException("Cooking actions require the displayed frame");
+        this.commands = scope.actions();
+    }
+
+    boolean reset(final Consumer<NativeCookingAction> sender) {
+        final var original = this.gesture;
+        return original != null && this.send(original.recipeId(), original.mode(), original.controllerInputMode(), 2, sender);
+    }
+
+    boolean send(final int recipe, final NativeCookingAction.Mode mode, final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        if (this.retired || this.dispatching || this.sourcePending() || this.sourceDrawing || this.bundlePending() || this.query != null || this.held != null || !this.heldPending.isEmpty() || mode == null || controllerMode < 0 || controllerMode > 3 || phase < 0 || phase > 2 || this.expired()) return false;
+        final NativeCookingAction original;
+        final boolean startsFocus = phase == 1 && mode == NativeCookingAction.Mode.PRIMARY && controllerMode == 2 && this.gesture == null;
+        final boolean focused = this.gesture != null && this.gesture.eventPhase() == 1;
+        if (phase == 0 || startsFocus) {
+            if (this.gesture != null && (!focused || mode != NativeCookingAction.Mode.PRIMARY) || !this.pending.isEmpty() && !focused
+                    || this.message.updateSequence() <= this.invalidatedUpdate
+                    || !this.commands.getOrDefault(recipe, Set.of()).contains(mode.button())) return false;
+            original = null;
+        } else {
+            original = this.gesture;
+            if (original == null || original.eventPhase() == 1 && mode != NativeCookingAction.Mode.PRIMARY
+                    || original.recipeId() != recipe || !this.gestureCommands.contains(mode.button())
+                    || this.emitted.contains(new Event(mode, phase))) return false;
+        }
+        if (this.requestSequence == Long.MAX_VALUE) {
+            this.retire();
+            return false;
+        }
+        Objects.requireNonNull(sender);
+        final var action = original == null
+                ? new NativeCookingAction(this.message.menuId(), this.message.sequence(), this.message.updateSequence(),
+                        this.message.menuRevision(), this.message.inventoryRevision(), this.message.cursorRevision(), recipe, mode, controllerMode, phase, ++this.requestSequence)
+                : new NativeCookingAction(original.menuId(), original.sequence(), original.updateSequence(), original.menuRevision(),
+                        original.inventoryRevision(), original.cursorRevision(), recipe, mode, original.controllerInputMode(), phase, ++this.requestSequence);
+        // A local bridge can return a snapshot and acknowledgment before send() returns.
+        this.pending.put(action.requestSequence(), new Pending(action, this.clock.getAsLong()));
+        if (original == null) {
+            this.gesture = action;
+            this.emitted.clear();
+            if (mode == NativeCookingAction.Mode.PRIMARY) this.releaseSource = action;
+            this.gestureCommands = this.commands.get(recipe);
+        }
+        this.emitted.add(new Event(mode, phase));
+        if (phase == 2 && (mode != NativeCookingAction.Mode.TERTIARY || this.gesture.mode() != NativeCookingAction.Mode.PRIMARY))
+            this.clearGesture();
+        this.dispatching = true;
+        try {
+            sender.accept(action);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            // The packet may already have reached core. Never retry an ambiguous send.
+            this.retire();
+            throw failedTransport;
+        } finally {
+            this.dispatching = false;
+        }
+    }
+
+    boolean result(final NativeCookingActionResult result) {
+        if (this.expired()) {
+            this.retire();
+            return false;
+        }
+        final var action = result.action();
+        final var pending = this.pending.get(action.requestSequence());
+        if (pending == null || !pending.action.equals(action)) return false;
+        this.pending.remove(action.requestSequence());
+        if (this.releaseSource != null && this.releaseSource.requestSequence() <= action.requestSequence()
+                && ((action.eventPhase() == 0 || action.equals(this.releaseSource)) && !result.accepted()
+                    || action.eventPhase() == 2 && result.accepted() && action.mode() != NativeCookingAction.Mode.TERTIARY)) this.releaseSource = null;
+        if (!result.accepted() && (this.gesture == null || action.requestSequence() >= this.gesture.requestSequence())) this.clearGesture();
+        if (!result.accepted() || !result.current())
+            this.invalidatedUpdate = Math.max(this.invalidatedUpdate, action.updateSequence());
+        return true;
+    }
+
+    boolean bundle(final String collection, final int index, final NativeBundleAction.Kind kind, final int tooltipMode,
+                   final int selectedCell, final Consumer<NativeCookingBundleAction> sender) {
+        if (!this.idle() || this.dispatching || this.message.updateSequence() <= this.invalidatedUpdate) return false;
+        if (this.requestSequence == Long.MAX_VALUE) { this.retire(); return false; }
+        final var action = new NativeCookingBundleAction(NativeCookingControl.forMessage(this.message, NativeCookingControl.Mode.ACTIVATE),
+                collection, index, kind, tooltipMode, selectedCell, ++this.requestSequence);
+        this.bundle = action;
+        this.bundleSentAt = this.clock.getAsLong();
+        this.dispatching = true;
+        try {
+            sender.accept(action);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            this.retire();
+            throw failedTransport;
+        } finally { this.dispatching = false; }
+    }
+
+    boolean result(final NativeCookingBundleResult result) {
+        if (this.expired()) { this.retire(); return false; }
+        if (!result.action().equals(this.bundle)) return false;
+        this.bundle = null;
+        this.bundleAwaitingUpdate = !result.current() && this.message.updateSequence() <= result.action().source().updateSequence()
+                ? result.action().source().updateSequence() : 0;
+        return true;
+    }
+
+    boolean bundlePending() { return this.bundle != null || this.bundleAwaitingUpdate != 0; }
+
+    boolean source(final int sourceSlot, final int destinationSlot, final int quantity,
+                   final NativeCookingSourceAction.Kind kind, final Consumer<NativeCookingSourceAction> sender) {
+        if (kind == NativeCookingSourceAction.Kind.RETIRE || !this.idle() || this.dispatching
+                || this.message.updateSequence() <= this.invalidatedUpdate) return false;
+        if (this.requestSequence == Long.MAX_VALUE) { this.retire(); return false; }
+        final var action = new NativeCookingSourceAction(NativeCookingControl.forMessage(this.message, NativeCookingControl.Mode.ACTIVATE),
+                sourceSlot, destinationSlot, quantity, kind, ++this.requestSequence);
+        this.source = action;
+        this.sourceSentAt = this.clock.getAsLong();
+        this.sourceDrawing = kind == NativeCookingSourceAction.Kind.DRAW;
+        if (this.sourceDrawing) this.sourceRelease = action;
+        this.dispatching = true;
+        try {
+            sender.accept(action);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            this.retire();
+            throw failedTransport;
+        } finally { this.dispatching = false; }
+    }
+
+    boolean result(final NativeCookingSourceResult result) {
+        if (this.expired()) { this.retire(); return false; }
+        if (!result.action().equals(this.source)) return false;
+        this.source = null;
+        if (!result.accepted()) {
+            this.sourceDrawing = false;
+            this.sourceRelease = null;
+        }
+        // An admitted drawing operation continues against its retained source after item frames advance.
+        this.sourceAwaitingUpdate = !this.sourceDrawing && !result.current()
+                && this.message.updateSequence() <= result.action().source().updateSequence()
+                ? result.action().source().updateSequence() : 0;
+        return true;
+    }
+
+    boolean sourcePending() { return this.source != null || this.sourceAwaitingUpdate != 0; }
+    boolean sourceDrawing() { return this.sourceDrawing; }
+    boolean sourceAdmitted() { return this.sourceDrawing && this.source == null && !this.expired(); }
+
+    /** The input owner sends its ordered terminal quick-craft phase before retiring this allocation. */
+    void finishSourceDrawing() {
+        this.sourceDrawing = false;
+        this.sourceRelease = null;
+    }
+
+    boolean query(final String text, final Consumer<NativeCookingQuery> sender) {
+        if (!this.idle() || this.dispatching || this.message.updateSequence() <= this.invalidatedUpdate) return false;
+        if (this.requestSequence == Long.MAX_VALUE) {
+            this.retire();
+            return false;
+        }
+        final var query = NativeCookingQuery.forMessage(this.message, ++this.requestSequence, text);
+        this.query = query;
+        this.querySentAt = this.clock.getAsLong();
+        this.dispatching = true;
+        try {
+            sender.accept(query);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            this.retire();
+            throw failedTransport;
+        } finally {
+            this.dispatching = false;
+        }
+    }
+
+    boolean result(final NativeCookingQueryResult result) {
+        if (this.expired()) {
+            this.retire();
+            return false;
+        }
+        if (!result.query().equals(this.query)) return false;
+        this.query = null;
+        this.queryAwaitingUpdate = this.message.updateSequence() <= result.query().source().updateSequence() ? result.query().source().updateSequence() : 0;
+        this.invalidatedUpdate = Math.max(this.invalidatedUpdate, result.query().source().updateSequence());
+        return true;
+    }
+
+    boolean queryPending() { return this.query != null || this.queryAwaitingUpdate != 0; }
+
+    boolean hold(final int slot, final NativeCookingHoldAction.Phase phase, final int quantity,
+                 final Consumer<NativeCookingHoldAction> sender) {
+        if (this.expired() || this.dispatching || this.sourcePending() || this.sourceDrawing || this.bundlePending() || this.queryPending() || phase == null) return false;
+        if (phase == NativeCookingHoldAction.Phase.START ? !this.idle() || this.message.updateSequence() <= this.invalidatedUpdate
+                : this.held == null || slot != this.held.slot()
+                    || this.heldPending.values().stream().anyMatch(p -> p.action.phase() == phase)) return false;
+        if (this.requestSequence == Long.MAX_VALUE) { this.retire(); return false; }
+        final var action = new NativeCookingHoldAction(phase == NativeCookingHoldAction.Phase.START
+                ? NativeCookingControl.forMessage(this.message, NativeCookingControl.Mode.ACTIVATE) : this.held.source(),
+                slot, phase, quantity, ++this.requestSequence);
+        this.heldPending.put(action.requestSequence(), new HeldPending(action, this.clock.getAsLong()));
+        if (phase == NativeCookingHoldAction.Phase.START) {
+            this.held = action;
+            this.heldReleaseSource = action;
+            this.heldRejected = false;
+        }
+        this.dispatching = true;
+        try {
+            sender.accept(action);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            this.retire();
+            throw failedTransport;
+        } finally { this.dispatching = false; }
+    }
+
+    boolean result(final NativeCookingHoldResult result) {
+        if (this.expired()) { this.retire(); return false; }
+        final var action = result.action();
+        final var pending = this.heldPending.get(action.requestSequence());
+        if (pending == null || !pending.action.equals(action)) return false;
+        this.heldPending.remove(action.requestSequence());
+        if (!result.accepted()) this.heldRejected = true;
+        if (!result.accepted() || action.phase() != NativeCookingHoldAction.Phase.START) {
+            this.held = null;
+            this.heldReleaseSource = null;
+            this.invalidatedUpdate = Math.max(this.invalidatedUpdate, action.source().updateSequence());
+        }
+        return true;
+    }
+
+    boolean holding() { return this.held != null; }
+    boolean holdPending() { return !this.heldPending.isEmpty(); }
+    boolean holdRejected() { return this.heldRejected; }
+
+    boolean expired() {
+        final long now = this.clock.getAsLong();
+        return this.retired || this.sourcePending() && now - this.sourceSentAt >= RESPONSE_TIMEOUT_NANOS
+                || this.bundlePending() && now - this.bundleSentAt >= RESPONSE_TIMEOUT_NANOS
+                || this.queryPending() && now - this.querySentAt >= RESPONSE_TIMEOUT_NANOS
+                || this.pending.values().stream().anyMatch(pending -> now - pending.sentAt >= RESPONSE_TIMEOUT_NANOS)
+                || this.heldPending.values().stream().anyMatch(pending -> now - pending.sentAt >= RESPONSE_TIMEOUT_NANOS);
+    }
+
+    boolean idle() { return !this.expired() && !this.sourcePending() && !this.sourceDrawing && !this.bundlePending() && this.gesture == null && this.pending.isEmpty() && !this.queryPending()
+            && this.held == null && this.heldPending.isEmpty(); }
+
+    /** Terminal release is safe after authority retires: phase two never repeats a transfer. */
+    boolean cancel(final Consumer<NativeCookingAction> sender) {
+        return this.cancel(sender, null);
+    }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender, final Consumer<NativeCookingHoldAction> heldSender) {
+        return this.cancel(sender, heldSender, null);
+    }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender, final Consumer<NativeCookingHoldAction> heldSender,
+                   final Consumer<NativeCookingSourceAction> sourceSender) {
+        final var source = this.sourceRelease;
+        if (source != null && sourceSender != null && this.requestSequence != Long.MAX_VALUE) {
+            this.sourceRelease = null;
+            final var action = new NativeCookingSourceAction(source.source(), source.sourceSlot(), source.destinationSlot(),
+                    source.quantity(), NativeCookingSourceAction.Kind.RETIRE, ++this.requestSequence);
+            this.retire();
+            sourceSender.accept(action);
+            return true;
+        }
+        final var held = this.heldReleaseSource;
+        if (held != null && heldSender != null && this.requestSequence != Long.MAX_VALUE) {
+            final var action = new NativeCookingHoldAction(held.source(), held.slot(), NativeCookingHoldAction.Phase.RETIRE,
+                    0, ++this.requestSequence);
+            this.held = null;
+            this.heldReleaseSource = null;
+            this.retire();
+            heldSender.accept(action);
+            return true;
+        }
+        this.retire();
+        final var original = this.releaseSource;
+        this.releaseSource = null;
+        if (original == null || this.requestSequence == Long.MAX_VALUE) return false;
+        final var release = new NativeCookingAction(original.menuId(), original.sequence(), original.updateSequence(),
+                original.menuRevision(), original.inventoryRevision(), original.cursorRevision(), original.recipeId(),
+                NativeCookingAction.Mode.PRIMARY, original.controllerInputMode(), 2, ++this.requestSequence);
+        sender.accept(release);
+        return true;
+    }
+
+    void retire() {
+        this.retired = true;
+        this.pending.clear();
+        this.heldPending.clear();
+        this.held = null;
+        this.query = null;
+        this.queryAwaitingUpdate = 0;
+        this.bundle = null;
+        this.bundleAwaitingUpdate = 0;
+        this.source = null;
+        this.sourceAwaitingUpdate = 0;
+        this.sourceDrawing = false;
+        this.commands = Map.of();
+        this.clearGesture();
+    }
+
+    private void clearGesture() {
+        this.gesture = null;
+        this.gestureCommands = Set.of();
+        this.emitted.clear();
+    }
+
+    private record Event(NativeCookingAction.Mode mode, int phase) { }
+    private record Pending(NativeCookingAction action, long sentAt) { }
+    private record HeldPending(NativeCookingHoldAction action, long sentAt) { }
+}
