+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.util.function.IntFunction;
+
+/** A Help view retains its inventory owner while navigating authored topics. */
+final class NativeInventoryHelp {
+    private final IntFunction<JsonObject> resolver;
+    private int topic = -1;
+    private long revision;
+
+    NativeInventoryHelp(final IntFunction<JsonObject> resolver) { this.resolver = resolver; }
+
+    boolean active() { return this.topic >= 0; }
+    long revision() { return this.revision; }
+
+    void open(final int topic) {
+        if (this.active()) return;
+        this.resolver.apply(topic);
+        this.topic = topic;
+        this.revision++;
+    }
+
+    boolean close() {
+        if (!this.active()) return false;
+        this.topic = -1;
+        this.revision++;
+        return true;
+    }
+
+    void select(final int topic) {
+        if (!this.active() || this.topic == topic) return;
+        this.resolver.apply(topic);
+        this.topic = topic;
+        this.revision++;
+    }
+
+    JsonObject resolve() {
+        if (!this.active()) throw new IllegalStateException("Native Help is closed");
+        return this.resolver.apply(this.topic);
+    }
+}
