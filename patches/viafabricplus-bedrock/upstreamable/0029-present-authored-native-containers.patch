+final class NativeContainerGeometryTest {
+    @Test
+    void embeddedSearchClearRequiresAnEditorOwnerAndBlocksCoveredSlots() {
+        final var clearProperties = JsonParser.parseString("""
+                {"button_mappings":[{"from_button_id":"button.menu_select",
+                "to_button_id":"button.text_edit_box_clear","mapping_type":"pressed"}]}
+                """).getAsJsonObject();
+        final var clear = new NativeUiScene.Node("clear_text_button", "button", clearProperties, List.of(), Integer.MIN_VALUE);
+        final var editorProperties = JsonParser.parseString("""
+                {"text_box_name":"#text_box_name","property_bag":{"#property_field":"#item_name"},
+                "button_mappings":[{"from_button_id":"button.menu_select","to_button_id":"button.search_bar_selected",
+                "mapping_type":"pressed","handle_select":true}]}
+                """).getAsJsonObject();
+        final var editor = new NativeUiScene.Node("editor", "edit_box", editorProperties, List.of(clear), Integer.MIN_VALUE);
+        final var bounds = new NativeUiLayout.Rect(0, 0, 18, 18);
+        final var size = new NativeUiLayout.Size(18, 18);
+        final var clearDraw = new NativeUiPresentation.Draw(new NativeUiLayout.Box(clear, bounds, bounds, size, bounds, 2, List.of()), 1, 1, true);
+        final var editorDraw = new NativeUiPresentation.Draw(new NativeUiLayout.Box(editor, bounds, bounds, size, bounds, 1, List.of()), 1, 1, true);
+        final var slot = draw(0, true, 1, 0, 0, 18, bounds, 0);
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(slot, clearDraw), 1, Map.of(), true));
+        final var geometry = new NativeContainerGeometry(List.of(slot, editorDraw, clearDraw), 1, Map.of(), true);
+        assertTrue(geometry.clearsSearch(clear));
+        assertTrue(geometry.clearsSearch(1, 1, "button.menu_select"));
+        assertFalse(geometry.clearsSearch(1, 1, "button.menu_secondary_select"));
+        assertEquals(-1, geometry.hovered(1, 1));
+        assertFalse(new NativeContainerGeometry(List.of(editorDraw, clearDraw, draw(0, true, 1, 0, 0, 18, bounds, 3)),
+                1, Map.of(), true).clearsSearch(1, 1, "button.menu_select"));
+    }
+
+    @Test
+    void retainedHitRegionsFollowVisibilityEnablementAndLayoutChanges() {
+        final var slot = draw(0, true, 1, 0, 0, 18, new NativeUiLayout.Rect(0, 0, 100, 100), 1);
+        var geometry = new NativeContainerGeometry(List.of(slot), 1);
+        assertEquals(0, geometry.hovered(1, 1));
+        final var fading = new NativeUiPresentation.Draw(slot.box(), .4F, 1, true);
+        assertTrue(geometry.reusableFor(List.of(fading)));
+        assertEquals(0, geometry.hovered(1, 1));
+        for (final var hidden : List.of(new NativeUiPresentation.Draw(slot.box(), 0, 1, true),
+                new NativeUiPresentation.Draw(slot.box(), 1, 1, false))) {
+            assertFalse(geometry.reusableFor(List.of(hidden)));
+            final var inactive = new NativeContainerGeometry(List.of(hidden), 1);
+            assertEquals(-1, inactive.hovered(1, 1));
+            assertFalse(inactive.reusableFor(List.of(slot)));
+        }
+        final var moved = draw(0, true, 1, 40, 0, 18, new NativeUiLayout.Rect(0, 0, 100, 100), 1);
+        assertFalse(geometry.reusableFor(List.of(moved)));
+        geometry = new NativeContainerGeometry(List.of(moved), 1);
+        assertEquals(-1, geometry.hovered(1, 1));
+        assertEquals(0, geometry.hovered(41, 1));
+        assertFalse(geometry.reusableFor(List.of()));
+    }
+
+    @Test
+    void layoutPreferencesPreserveTheirNativeFamilyAndRejectForcedProfiles() {
