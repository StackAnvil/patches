@@ -0,0 +1,37 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+/** Presentation authority is tied to an existing connection and menu object, never only its reusable number. */
+final class NativeContainerSession<C, M> {
+    private C connection;
+    private long sequence = -1;
+    private M menu;
+    private int menuId = -1;
+
+    boolean accept(final C connection, final M menu, final int currentMenuId,
+                   final int messageMenuId, final long sequence) {
+        if (connection == null || menu == null || currentMenuId != messageMenuId || sequence < 0) return false;
+        if (this.connection != connection) this.clear();
+        if (sequence <= this.sequence) return false;
+        this.connection = connection;
+        this.menu = menu;
+        this.menuId = currentMenuId;
+        this.sequence = sequence;
+        return true;
+    }
+
+    boolean current(final C connection, final M menu, final int menuId) {
+        return this.connection == connection && this.menu == menu && this.menuId == menuId;
+    }
+
+    long sequence() {
+        return this.sequence;
+    }
+
+    void close() { this.menu = null; this.menuId = -1; }
+    void clear() { this.close(); this.connection = null; this.sequence = -1; }
+}
