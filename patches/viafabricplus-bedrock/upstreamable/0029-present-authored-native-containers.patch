+                                    {"from_button_id":"button.menu_ok","to_button_id":"button.menu_select","mapping_type":"focused"}],
+                                    "bindings":[{"binding_name":"#is_left_tab_items","binding_name_override":"#toggle_state"}]}}
+                                    """)
+                            .getAsJsonObject();
+            if (kind == Kind.FILTER) {
+                final var toggle = control.getAsJsonObject("preference");
+                toggle.addProperty("toggle_name", "toggle.enable_filtering");
+                toggle.getAsJsonArray("bindings")
+                        .get(0)
+                        .getAsJsonObject()
+                        .addProperty("binding_name", "#filtering_enabled");
+            }
+            if (kind == Kind.LAYOUT) {
+                final var toggle = control.getAsJsonObject("preference");
+                toggle.addProperty("toggle_name", "layout_toggle");
+                toggle.addProperty("toggle_group_forced_index", 1);
+                toggle.getAsJsonArray("bindings")
+                        .get(0)
+                        .getAsJsonObject()
+                        .addProperty("binding_name", "#is_survival_layout");
+                final var other = control.deepCopy();
+                final var opposite = other.getAsJsonObject("preference");
+                opposite.addProperty("toggle_group_forced_index", 2);
+                opposite.getAsJsonArray("offset")
+                        .set(0, new com.viaversion.viaversion.libs.gson.JsonPrimitive(340));
+                opposite.getAsJsonArray("bindings")
+                        .get(0)
+                        .getAsJsonObject()
+                        .addProperty("binding_name", "#is_recipe_book_layout");
+                final var sibling = new JsonObject();
+                sibling.add("other_layout", opposite);
+                panel.getAsJsonArray("controls").add(sibling);
+            }
+            panel.getAsJsonArray("controls").add(control);
+            final var book = next.view().book();
+            final var changedBook =
+                    new CookingUi.Book(
+                            layout,
+                            book.forcedRecipeBookLayout(),
+                            tab,
+                            filtering,
+                            book.foodCount(),
+                            book.itemCount(),
+                            book.blockCount(),
+                            book.tabLabel(),
+                            book.searchText(),
+                            book.selection(),
+                            book.catalog(),
+                            book.visibleRecipes());
+            final var view = next.view();
+            final var changedView =
+                    new CookingUi.MenuView(
+                            view.menuId(),
+                            view.family(),
+                            view.title(),
+                            view.slots(),
+                            view.cursor(),
+                            view.progress(),
+                            changedBook);
+            final var program = CookingUi.fromProgram(exported);
+            final var changed =
+                    NativeCookingMessage.create(
+                            program,
+                            changedView,
+                            next.sequence(),
+                            update,
+                            next.menuRevision(),
+                            next.inventoryRevision(),
+                            next.cursorRevision(),
+                            next.recipeItems());
+            assertTrue(
+                    this.controller.accept(
+                            this.owner,
+                            this.menu,
+                            5,
+                            changed,
+                            _ -> new ItemStack(Items.IRON_INGOT)));
+            this.screen.containerTick();
+            assertSame(this.screen, this.displayed.get());
+        }
+
+        @Override
+        public void close() {
+            try {
+                this.screen.discard();
+                this.controller.clear(this.owner);
+            } finally {
+                this.entrypoint.close();
+                this.networking.close();
+                this.singleton.close();
+            }
+        }
+
+        void navigation(final long update, final int delta, final int tab, final int layout, final boolean forced, final NavigationHost host) {
+            final var source = message(update, true);
+            final var exported = JsonParser.parseString(source.program()).getAsJsonObject();
+            final var recipe = exported.getAsJsonObject("definitions").getAsJsonObject("furnace.recipe").getAsJsonObject("value");
+            recipe.getAsJsonArray("button_mappings").add(JsonParser.parseString("""
+                {"to_button_id":"button.container_slot_hovered","mapping_type":"pressed"}
+                """));
+            recipe.add("controls", JsonParser.parseString("""
+                [{"selected_recipe":{"type":"panel","bindings":[
+                  {"binding_name":"#is_recipe_selected_slot","binding_name_override":"#visible"}]}}]
+                """));
+            final var control = JsonParser.parseString(host != NavigationHost.BUTTON ? """
+                {"type":"input_panel","size":[0,0],"button_mappings":[
+                 {"from_button_id":"button.menu_ok","mapping_type":"global"}]}
+                """ : """
+                {"type":"button","size":[20,20],"offset":[300,0],"anchor_from":"top_left","anchor_to":"top_left",
+                 "focus_enabled":true,"button_mappings":[
+                  {"from_button_id":"button.menu_select","mapping_type":"pressed"},
+                  {"from_button_id":"button.menu_ok","mapping_type":"focused"}]}
+                """).getAsJsonObject();
+            for (final var value : control.getAsJsonArray("button_mappings"))
+                value.getAsJsonObject().addProperty("to_button_id", delta < 0 ? "button.left_panel_tab_decrement" : "button.left_panel_tab_increment");
+            if (host == NavigationHost.VIEW_TABS || host == NavigationHost.FOCUSED_VIEW_TABS) {
+                for (final var value : control.getAsJsonArray("button_mappings")) {
+                    value.getAsJsonObject().addProperty("to_button_id", delta < 0 ? "button.menu_tab_left" : "button.menu_tab_right");
+                    value.getAsJsonObject().addProperty("scope", "view");
+                }
+                final var controls = exported.getAsJsonObject("definitions").getAsJsonObject("furnace.furnace_panel")
+                    .getAsJsonObject("value").getAsJsonArray("controls");
+                for (final int index : List.of(3, 1, 2)) {
+                    final var toggle = new JsonObject();
+                    toggle.addProperty("type", "toggle");
+                    toggle.addProperty("focus_enabled", host == NavigationHost.FOCUSED_VIEW_TABS);
+                    toggle.addProperty("toggle_name", "navigation_tab");
+                    toggle.addProperty("toggle_group_forced_index", index);
+                    toggle.add("size", JsonParser.parseString("[20,20]"));
+                    final var binding = new JsonObject();
+                    binding.addProperty("binding_name", "#is_left_tab_" + List.of("food", "items", "blocks").get(index - 1));
+                    binding.addProperty("binding_name_override", "#toggle_state");
+                    final var bindings = new com.viaversion.viaversion.libs.gson.JsonArray();
+                    bindings.add(binding);
+                    toggle.add("bindings", bindings);
+                    final var wrapped = new JsonObject();
+                    wrapped.add("tab" + index, toggle);
+                    controls.add(wrapped);
+                }
+            }
+            if (host == NavigationHost.GLOBAL_PANEL) {
+                for (final var value : control.getAsJsonArray("button_mappings")) value.getAsJsonObject().addProperty("scope", "global");
+            }
+            if (host == NavigationHost.SCREEN) {
+                exported.getAsJsonObject("definitions").getAsJsonObject("furnace.furnace_screen").getAsJsonObject("value")
+                    .add("button_mappings", control.getAsJsonArray("button_mappings"));
+            } else {
+                final var wrapped = new JsonObject();
+                wrapped.add("navigation", control);
+                exported.getAsJsonObject("definitions").getAsJsonObject("furnace.furnace_panel").getAsJsonObject("value")
+                    .getAsJsonArray("controls").add(wrapped);
+            }
+            final var view = source.view();
+            final var book = view.book();
+            final var changedBook = new CookingUi.Book(layout, forced, tab, true, book.foodCount(), book.itemCount(), book.blockCount(),
+                book.tabLabel(), book.searchText(), book.selection(), book.catalog(), book.visibleRecipes());
+            final var changedView = new CookingUi.MenuView(view.menuId(), view.family(), view.title(), view.slots(), view.cursor(), view.progress(), changedBook);
+            final var changed = NativeCookingMessage.create(CookingUi.fromProgram(exported), changedView, source.sequence(), update,
+                source.menuRevision(), source.inventoryRevision(), source.cursorRevision(), source.recipeItems());
+            assertTrue(this.controller.accept(this.owner, this.menu, 5, changed, _ -> new ItemStack(Items.IRON_INGOT)));
+            this.screen.containerTick();
+        }
+    }
+
+    private static NativeCookingMessage message(final long update, final boolean recipeVisible) {
+        final var source = NativeCookingPresentationTest.message(CookingUi.Family.FURNACE, update);
+        final var previous = source.view();
+        final var book = previous.book();
+        final var selected =
+                new CookingUi.Book(
+                        book.layout(),
+                        book.forcedRecipeBookLayout(),
+                        book.tab(),
+                        book.filtering(),
+                        book.foodCount(),
+                        book.itemCount(),
+                        book.blockCount(),
+                        book.tabLabel(),
+                        book.searchText(),
+                        book.selection(),
+                        book.catalog(),
+                        recipeVisible ? Set.of(7) : Set.of());
+        final var view =
+                new CookingUi.MenuView(
+                        5,
+                        previous.family(),
+                        previous.title(),
+                        previous.slots(),
+                        previous.cursor(),
+                        previous.progress(),
+                        selected);
+        return NativeCookingMessage.create(
+                program(),
+                view,
+                source.sequence(),
+                update,
+                source.menuRevision(),
+                source.inventoryRevision(),
+                source.cursorRevision(),
+                source.recipeItems());
+    }
+
+    private enum NavigationHost { BUTTON, PANEL, SCREEN, GLOBAL_PANEL, VIEW_TABS, FOCUSED_VIEW_TABS }
+
+    private static CookingUi program() {
+        final var definitions = new JsonObject();
+        final var root =
+                JsonParser.parseString("{\"type\":\"panel\",\"size\":[640,320],\"controls\":[]}")
+                        .getAsJsonObject();
+        definitions.add(
+                "furnace.slot",
+                definition(
+                        JsonParser.parseString(
+                                        """
+                                        {"type":"button","size":[18,18],"button_mappings":[
+                                         {"from_button_id":"button.menu_select","to_button_id":"button.container_take_all_place_all","mapping_type":"pressed"}]}
+                                        """)
+                                .getAsJsonObject()));
+        definitions.add(
+                "furnace.recipe",
+                definition(
+                        JsonParser.parseString(
+                                        """
+                                        {"type":"button","size":[18,18],"button_mappings":[
+                                         {"from_button_id":"button.menu_select","to_button_id":"button.recipe_select","mapping_type":"pressed"},
+                                         {"from_button_id":"button.menu_secondary_select","to_button_id":"button.recipe_secondary","mapping_type":"pressed"}]}
+                                        """)
+                                .getAsJsonObject()));
+        int y = 60;
+        for (final String collection :
+                List.of(
+                        "furnace_ingredient_items",
+                        "furnace_fuel_items",
+                        "furnace_output_items",
+                        "inventory_items",
+                        "hotbar_items",
+                        "recipe_book")) {
+            final var grid =
+                    JsonParser.parseString(
+                                    "{\"type\":\"grid\",\"anchor_from\":\"top_left\",\"anchor_to\":\"top_left\"}")
+                            .getAsJsonObject();
+            grid.addProperty("collection_name", collection);
+            grid.addProperty(
+                    "grid_item_template",
+                    collection.equals("recipe_book") ? "furnace.recipe" : "furnace.slot");
+            grid.add(
+                    "grid_dimensions",
+                    JsonParser.parseString(
+                            collection.equals("inventory_items")
+                                    ? "[9,3]"
+                                    : collection.equals("hotbar_items") ? "[9,1]" : "[1,1]"));
+            grid.add(
+                    "size",
+                    JsonParser.parseString(
+                            collection.equals("inventory_items")
+                                    ? "[162,54]"
+                                    : collection.equals("hotbar_items") ? "[162,18]" : "[18,18]"));
+            grid.add(
+                    "offset",
+                    JsonParser.parseString(
+                            collection.equals("recipe_book")
+                                    ? "[20,20]"
+                                    : collection.equals("hotbar_items")
+                                            ? "[100,210]"
+                                            : "[100," + y + "]"));
+            final var control = new JsonObject();
+            control.add(collection, grid);
+            root.getAsJsonArray("controls").add(control);
+            y += 30;
+        }
+        definitions.add("furnace.furnace_panel", definition(root));
+        definitions.add(
+                "furnace.furnace_screen",
+                definition(
+                        JsonParser.parseString("""
+                            {"type":"screen","size":[640,320],"$screen_content":"furnace.furnace_panel",
+                             "controls":[{"root_screen_panel@$screen_content":{}}]}
+                            """)
+                                .getAsJsonObject()));
+        final var exported = new JsonObject();
+        exported.add("definitions", definitions);
+        exported.addProperty("cooking_family", "FURNACE");
+        exported.add(
+                "globals",
+                JsonParser.parseString("{\"$container_title\":\"\",\"$localize_title\":false}"));
+        return CookingUi.fromProgram(exported);
+    }
+
+    private static JsonObject definition(final JsonObject value) {
+        final var definition = new JsonObject();
+        definition.addProperty("parent", "");
+        definition.add("value", value);
+        return definition;
+    }
+}
