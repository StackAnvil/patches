+    }
+
+    @Test
+    void globalScopePreferencesRemainAdmittedThroughTheirNativeEventAdapter() {
+        final var toggle = preference();
+        final var mappings = toggle.box().node().properties().getAsJsonArray("button_mappings");
+        final var alias = mappings.get(0).getAsJsonObject();
+        mappings.add(alias.deepCopy());
+        alias.addProperty("from_button_id", "button.menu_ok");
+        alias.addProperty("scope", "global");
