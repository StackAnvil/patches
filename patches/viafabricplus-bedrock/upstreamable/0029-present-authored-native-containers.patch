+        assertNull(front.preference(1, 1));
+        assertEquals(-1, front.hovered(9, 1));
+        assertEquals(new NativeCookingPreferenceControl(NativeCookingPreferenceControl.Kind.TAB, 2), front.preference(9, 1));
+        assertNull(front.recipe(9, 1));
+        final var behind = new NativeContainerGeometry(List.of(toggle, slot), 1, Map.of(), true);
+        assertEquals(0, behind.hovered(9, 1));
+        assertNull(behind.preference(9, 1));
