+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativePlayerInventoryLifetimeTest {
+    @BeforeAll
+    static void bootstrap() throws Exception {
+        NativePlayerPresentationTest.bootstrap();
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"honey block", ""})
+    void closingBeforeTheSearchReplyRetainsTheLatestEditOnlyWithinItsConnection(final String latest) throws Exception {
+        final var game = mock(Minecraft.class);
+        final var player = mock(LocalPlayer.class);
+        final var menu = new InventoryMenu(new Inventory(player, new EntityEquipment()), true, player);
+        final var owner = mock(ClientPacketListener.class);
+        final var connection = mock(Connection.class);
+        final var screen = mock(AbstractContainerScreen.class);
+        final var gui = mock(Gui.class);
+        when(owner.getConnection()).thenReturn(connection);
+        when(connection.isConnected()).thenReturn(true);
+        when(game.getConnection()).thenReturn(owner);
+        when(screen.getMenu()).thenReturn(menu);
+        when(gui.screen()).thenReturn(screen);
+        set(Minecraft.class, game, "player", player);
+        set(Minecraft.class, game, "gui", gui);
+        set(Player.class, player, "inventoryMenu", menu);
+        final List<NativePlayerInventoryAction> sent = new ArrayList<>();
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var network = mockStatic(ClientPlayNetworking.class);
+             final var screens = mockStatic(BedrockPlayerInventory.class);
+             final var containers = mockStatic(BedrockNativeContainers.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            containers.when(BedrockNativeContainers::enabled).thenReturn(true);
+            network.when(() -> ClientPlayNetworking.canSend(NativePlayerInventoryActionPayload.TYPE)).thenReturn(true);
+            network.when(() -> ClientPlayNetworking.send(any(NativePlayerInventoryActionPayload.class))).thenAnswer(call -> {
+                sent.add(((NativePlayerInventoryActionPayload) call.getArgument(0)).action());
+                return null;
+            });
+            try {
+                set(BedrockNativePlayerInventory.class, null, "owner", owner);
+                screens.when(() -> BedrockPlayerInventory.opening(owner, menu)).thenReturn(1L);
+                accept(owner, message(1, 8, "oak planks"));
+                final var original = presentation();
+                BedrockNativePlayerInventory.query(owner, menu, "h");
+                BedrockNativePlayerInventory.query(owner, menu, latest);
+                assertEquals(latest, original.query());
+                assertEquals(1, sent.size());
+                BedrockNativePlayerInventory.retire(original);
+
+                screens.when(() -> BedrockPlayerInventory.opening(owner, menu)).thenReturn(2L);
+                accept(owner, message(2, 9, "h"));
+                final var reopened = presentation();
+                assertNotSame(original, reopened);
+                assertEquals(latest, reopened.query());
+                assertEquals(2, sent.size());
+                final var replacement = sent.getLast();
+                assertEquals(latest, replacement.query());
+                assertEquals(2, replacement.opening());
+                assertEquals(9, replacement.generation());
+                assertFalse(original.result(new NativePlayerInventoryResult(1, 8, 1, 2, true)));
+                assertEquals(latest, reopened.query());
+                assertFalse(reopened.send(NativePlayerInventoryAction.Kind.PRIMARY, 0, "", null, sent::add));
+
+                clear();
+                final var nextOwner = mock(ClientPacketListener.class);
+                when(nextOwner.getConnection()).thenReturn(connection);
+                when(game.getConnection()).thenReturn(nextOwner);
+                set(BedrockNativePlayerInventory.class, null, "owner", nextOwner);
+                screens.when(() -> BedrockPlayerInventory.opening(nextOwner, menu)).thenReturn(1L);
+                accept(nextOwner, message(1, 1, "sand"));
+                assertEquals("sand", presentation().query());
+                assertEquals(2, sent.size());
+            } finally {
+                clear();
+            }
+        }
+    }
+
+    private static NativePlayerInventoryMessage message(final long opening, final long generation, final String query) {
+        final var state = new PlayerInventoryUi.State(false, false, 2, 2, 5, 2, true, query, "Recipes", "Crafting",
+                List.of(1, 0, 0, 0), List.of(), "", -1);
+        final var ui = new PlayerInventoryUi(new ResourcePackStorage(List.of()).getJsonUiProgram());
+        return new NativePlayerInventoryMessage(0, opening, generation, 1, ui.exportProgram(false).toString(),
+                GsonUtil.getGson().toJson(state), Map.of());
+    }
+
+    private static void accept(final ClientPacketListener owner, final NativePlayerInventoryMessage message) throws Exception {
+        final var method = BedrockNativePlayerInventory.class.getDeclaredMethod("accept", ClientPacketListener.class, NativePlayerInventoryMessage.class);
+        method.setAccessible(true);
+        method.invoke(null, owner, message);
+    }
+
+    private static NativePlayerPresentation presentation() throws Exception {
+        final var field = BedrockNativePlayerInventory.class.getDeclaredField("presentation");
+        field.setAccessible(true);
+        return (NativePlayerPresentation) field.get(null);
+    }
+
+    private static void clear() throws Exception {
+        final var method = BedrockNativePlayerInventory.class.getDeclaredMethod("clear");
+        method.setAccessible(true);
+        method.invoke(null);
+    }
+
+    private static void set(final Class<?> type, final Object owner, final String name, final Object value) throws Exception {
+        final var field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(owner, value);
+    }
+}
