+    @Test
+    void typingSurvivesPendingCommandsAndAcknowledgementWithoutTransferringToAReopenedInventory() {
+        final var clock = new AtomicLong();
+        final var presentation = new NativePlayerPresentation(message(false, 1, 0, 1, "", false), Map.of(), Map.of(), clock::get);
+        final List<NativePlayerInventoryAction> sent = new ArrayList<>();
