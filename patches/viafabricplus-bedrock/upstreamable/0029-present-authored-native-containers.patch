+
+/**
+ * Real menu presentation; generic menus retain vanilla dispatch, scoped count-one controls use the
+ * negotiated native request backend.
+ */
+public final class BedrockNativeContainerScreen extends AbstractContainerScreen<AbstractContainerMenu> implements NativeUiScreen {
+    static final Set<String> RENDERERS =
+            Set.of(
+                    "inventory_item_renderer",
+                    "hover_text_renderer",
+                    "progress_bar_renderer",
+                    "flying_item_renderer",
+                    "live_horse_renderer");
+    private final ClientPacketListener owner;
+    private final AbstractContainerScreen<?> ordinary;
+    private final NativeInventoryPresentation presentation;
+    private final boolean nativeActions;
+    private final long sequence;
+    private final LongSupplier clock;
+    private final BooleanSupplier currentOwner;
+    private ContainerUi.ActionScope actionScope =
+            new ContainerUi.ActionScope(false, Set.of(), Set.of());
+    private boolean activated;
+    private boolean activationPending;
+    private int activationTicks;
+    private final NativeUiImages images = new NativeUiImages();
+    private NativeUiRenderer renderer;
+    private NativeUiScene.Node scene;
+    private NativeUiAnimationLifecycle lifecycle;
+    private long animationStarted;
+    private long layoutRevision;
+    private NativeUiLayout.Box root;
+    private NativeContainerGeometry geometry;
+    private List<NativeUiPresentation.Draw> draws = List.of();
+    private long previousPresentationRevision = -1;
+    private Map<Integer, ItemStack> recipePreviews = Map.of();
+    private Map<Integer, Set<String>> recipeActions = Map.of();
+    private long cookingUpdate = -1;
+    private final Set<Integer> capturedButtons = new HashSet<>();
+    private final Set<Integer> consumedReleases = new HashSet<>();
+    private RecipePress recipePress;
+    private record RecipePress(int button, int recipe, NativeCookingAction.Mode mode) { }
+    private PreferenceChange preferenceChange;
+    private record PreferenceChange(long update, long sentAt, FurnaceOptions expected) { }
+
+    boolean presents(final NativeCookingPresentation candidate) { return this.presentation == candidate; }
+    AbstractContainerScreen<?> original() { return this.ordinary; }
+    private List<ItemStack> previous = List.of();
+    private ItemStack previousCarried = ItemStack.EMPTY;
+    private boolean fallingBack;
+    private final NativeContainerScroll scroll = new NativeContainerScroll();
+    private final NativeInventoryFlights flights = new NativeInventoryFlights();
+    private final Map<Integer, Preview> previews = new HashMap<>();
+    private final Map<Integer, NativeInventoryFlights.Anchor> anchors = new HashMap<>();
+    private NativeUiScene.Node flightOwner;
+    private final Set<NativeUiScene.Node> vanillaCursor = Collections.newSetFromMap(new IdentityHashMap<>());
+    private Slot drawingSlot;
+    private long imageRevision;
+    private Boolean showTags;
+
+    BedrockNativeContainerScreen(
+            final ClientPacketListener owner,
+            final AbstractContainerScreen<?> ordinary,
+            final Inventory inventory,
+            final Component title,
+            final ContainerUi program,
+            final ContainerUi.Kind kind,
+            final boolean nativeActions,
+            final long sequence, final List<Integer> data) {
+        this(owner, ordinary, inventory, title, program, kind, nativeActions, sequence, data, System::nanoTime);
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final ContainerUi program, final ContainerUi.Kind kind,
+                                final boolean nativeActions, final long sequence, final List<Integer> data, final LongSupplier clock) {
+        this(owner, ordinary, inventory, title, new NativeContainerPresentation(program, kind, data), nativeActions, sequence, clock);
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final NativeInventoryPresentation presentation,
+                                final boolean nativeActions, final long sequence, final LongSupplier clock) {
+        this(owner, ordinary, inventory, title, presentation, nativeActions, sequence, clock,
+                () -> BedrockNativeContainers.current(owner, ordinary.getMenu()));
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final NativeInventoryPresentation presentation,
+                                final boolean nativeActions, final long sequence, final LongSupplier clock, final BooleanSupplier currentOwner) {
+        super(ordinary.getMenu(), inventory, title);
+        this.ordinary = ordinary;
+        this.owner = owner;
+        this.presentation = presentation;
+        this.nativeActions = nativeActions;
+        this.sequence = sequence;
+        this.clock = clock;
+        this.currentOwner = currentOwner;
+    }
+
+    boolean updateData(final ClientPacketListener owner, final net.raphimc.viabedrock.api.model.NativeContainerData update) {
+        if (owner == this.owner && this.current() && update.menuId() == this.menu.containerId
+                && update.sequence() == this.sequence && this.presentation instanceof NativeContainerPresentation container
+                && update.kind() == container.kind()) {
+            container.data(update.data());
+            return true;
+        }
+        return false;
+    }
+
+    void prepare(final Font font, final int width, final int height) {
+        this.width = width;
+        this.height = height;
+        if (this.renderer != null) this.renderer.close();
+        this.renderer = new NativeUiRenderer(font, this.images);
+        this.refresh();
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        this.leftPos = 0;
+        this.topPos = 0;
+        if (this.renderer != null) this.renderer.close();
+        this.renderer = new NativeUiRenderer(this.font, this.images);
+        this.refresh();
+    }
+
+    private boolean current() {
+        return this.currentOwner.getAsBoolean();
+    }
+
+    private void refresh() {
+        if (!this.current())
+            throw new IllegalStateException("Native inventory no longer owns the current menu");
+        if (this.presentation instanceof NativeCookingPresentation && !this.menu.getCarried().isEmpty())
+            throw new IllegalArgumentException("Native cooking carried-item controls are not implemented");
+        this.renderer.reset();
+        this.showTags = this.showTags();
+        final List<ContainerUi.Slot> slots = new ArrayList<>();
+        for (final Slot slot : this.menu.slots) slots.add(new ContainerUi.Slot(slot.index, NativeInventoryItemPresentation.values(slot.getItem(), false, this.showTags)));
+        final var frame = this.presentation.resolve(this.menu.containerId, this.title.getString(), slots,
+                NativeInventoryItemPresentation.values(this.menu.getCarried(), true, this.showTags), this.showTags);
+        final var resolved = frame.scene();
+        this.recipePreviews = frame.recipes();
+        this.recipeActions = frame.recipeActions().actions();
+        this.cookingUpdate = this.presentation instanceof NativeCookingPresentation cooking ? cooking.message().updateSequence() : -1;
+        this.actionScope =
+                this.nativeActions
+                        ? ContainerUi.actionScope(resolved, frame.containerSlots())
+                        : new ContainerUi.ActionScope(false, Set.of(), Set.of());
+        if (this.nativeActions) {
+            for (final int slot : this.actionScope.referencedSlots()) {
+                if (!slots.get(slot).presentation().containsKey("#hover_text")) {
+                    throw new IllegalArgumentException("Unsupported native manual item description");
+                }
+            }
+        }
+        this.scene = NativeUiScene.parse(resolved.toString(), RENDERERS).root();
+        if (this.lifecycle == null) {
+            this.animationStarted = this.clock.getAsLong();
+            this.lifecycle = new NativeUiAnimationLifecycle(this.scene);
+            this.lifecycle.animations().event(this.scene, "screen.entrance_push", 0);
+        } else this.lifecycle.replaceRoot(this.scene, this.animationTime());
+        this.layout(this.animationTime(), -1, -1);
+        for (final var draw : this.draws) {
+            final var node = draw.box().node();
+            if (this.presentation instanceof NativeCookingPresentation
+                    && (Set.of("edit_box", "slider", "slider_box").contains(node.type())
+                        || !Set.of("button", "toggle").contains(node.type()) && node.properties().has("button_mappings")))
+                throw new IllegalArgumentException("Unsupported native cooking control");
+            final String custom = node.string("renderer", "");
+            if (custom.equals("inventory_item_renderer")
+                    && node.flag("disabled_filter_visible", false))
+                throw new IllegalArgumentException("Unsupported native inactive-item filter");
+            if (custom.equals("progress_bar_renderer"))
+                NativeInventoryProgress.quads(draw.box(), draw.alpha(), 1);
+        }
+        final var current = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        if (!this.previous.isEmpty()) this.flights.update(this.previous, current, this.anchors, this.clock.getAsLong());
+        this.previous = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        this.previousCarried = this.menu.getCarried().copy();
+        this.previousPresentationRevision = this.presentation.revision();
+        this.imageRevision = this.images.revision();
+        if (this.activated && !this.actionScope.subset())
+            throw new IllegalArgumentException("Native inventory action scope changed");
+    }
+
+    private long animationTime() { return this.clock.getAsLong() - this.animationStarted; }
+
+    private void scrollAnimation(final boolean released) {
+        final var target = this.scroll.animationTarget();
+        if (target == null || this.lifecycle == null) return;
+        final long now = this.animationTime();
+        this.lifecycle.animations().event(target, "scrollbar.active", now);
+        if (released) this.lifecycle.animations().event(target, "scrollbar.released", now);
+    }
+
+    private void layout(final long now, final double pointerX, final double pointerY) {
+        final var animations = this.lifecycle.animations();
+        this.lifecycle.advance(now);
+        this.renderer.prepare(this.scene);
+        this.root = new NativeUiLayout(this.renderer, animations).layout(this.scene, this.width, this.height, this.scroll.offsets(this.scene));
+        this.draws = NativeUiPresentation.draws(this.root, box -> box.visibleBounds().contains(pointerX, pointerY), node -> animations.opacityAt(node, now));
+        this.geometry = new NativeContainerGeometry(this.draws, this.menu.slots.size(), this.recipeActions,
+                this.presentation instanceof NativeCookingPresentation);
+        this.requireCoverage();
+        this.vanillaCursor.clear();
+        this.cursor(this.root, false);
+        this.anchors.clear();
+        this.flightOwner = null;
+        this.anchors(this.root);
+        this.layoutRevision = animations.layoutRevision();
+    }
+
+    private void requireCoverage() {
+        if (this.geometry.hasPreferences() && !BedrockFurnacePreferences.available(this.owner.getConnection()))
+            throw new IllegalStateException("Native cooking preferences are unavailable");
+        if (this.actionScope.subset()) {
+            this.geometry.requireAuthoredCoverage(this.actionScope.slots(), this.menu.slots.size());
+            this.requireSubsetMappings();
+        } else this.geometry.requireComplete(this.menu.slots.size());
+    }
+
+    private void requireSubsetMappings() {
+        for (final var draw : this.draws) {
+            if (!draw.box().node().properties().has("inventory_actions")) continue;
+            for (final var value :
+                    draw.box().node().properties().getAsJsonArray("inventory_actions")) {
+                final var mapping = value.getAsJsonObject();
+                final String target = mapping.get("to_button_id").getAsString();
+                if (target.equals("button.container_slot_hovered")) continue;
+                if (!target.equals("button.container_auto_place_one")
+                        || !mapping.get("mapping_type").getAsString().equals("pressed")
+                        || !Set.of("button.menu_select", "button.menu_ok")
+                                .contains(mapping.get("from_button_id").getAsString()))
+                    throw new IllegalArgumentException("Unsupported native subset input mapping");
+            }
+        }
+    }
+
+    void activate() {
+        if (!this.current() || !this.actionScope.subset() || !this.nativeActions) return;
+        this.activationPending = true;
+        this.activationTicks = 0;
+        this.send(NativeContainerAction.Mode.ACTIVATE, -1);
+    }
+
+    void activationResult(
+            final ClientPacketListener owner,
+            final net.raphimc.viabedrock.api.model.NativeContainerStatus status) {
+        if (owner != this.owner
+                || !this.current()
