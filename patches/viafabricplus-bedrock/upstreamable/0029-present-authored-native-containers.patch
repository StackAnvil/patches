diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/PlayerInventoryScreenLifecycle.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/PlayerInventoryScreenLifecycle.java
