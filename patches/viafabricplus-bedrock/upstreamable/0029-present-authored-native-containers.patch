@@ -0,0 +1,81 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.Function;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+
+/** Never retains a presentation for a menu that has not opened or has already closed. */
+final class NativeCookingPresentationController<C, M> {
+    private final NativeContainerSession<C, M> session = new NativeContainerSession<>();
+    private C owner;
+    private NativeCookingPresentation presentation;
+
+    void begin(final C owner) {
+        if (owner == null) throw new IllegalArgumentException("Cooking play session is required");
+        if (this.owner == owner) return;
+        this.session.clear();
+        this.presentation = null;
+        this.owner = owner;
+    }
+
+    boolean accept(final C owner, final M menu, final int currentMenuId,
+                   final NativeCookingMessage message, final Function<Item, ItemStack> decode) {
+        if (owner == null || this.owner != owner || menu == null || currentMenuId != message.menuId()) return false;
+        final boolean update = this.current(owner, menu, currentMenuId) != null
+                && this.session.sequence() == message.sequence();
+        if (update) {
+            final var previous = this.presentation.message();
+            if (message.updateSequence() <= previous.updateSequence()
+                    || message.view().family() != previous.view().family()) return false;
+        } else if (message.sequence() <= this.session.sequence()) return false;
+        try {
+            final Map<Integer, ItemStack> items = new HashMap<>();
+            message.recipeItems().forEach((id, item) -> items.put(id, decode.apply(item.copy())));
+            if (update) return this.presentation.update(message, items);
+            final var next = new NativeCookingPresentation(message, items);
+            if (!this.session.accept(owner, menu, currentMenuId, message.menuId(), message.sequence())) return false;
+            this.presentation = next;
+            return true;
+        } catch (final RuntimeException unsupported) {
+            // An invalid newer frame cannot leave the older item authority actionable.
+            if (update || this.session.accept(owner, menu, currentMenuId, message.menuId(), message.sequence())) {
+                this.session.close();
+                this.presentation = null;
+            }
+            throw unsupported;
+        }
+    }
+
+    boolean progress(final C owner, final M menu, final int menuId, final NativeCookingProgress progress) {
+        final var current = this.current(owner, menu, menuId);
+        return current != null && current.update(progress);
+    }
+
+    NativeCookingPresentation current(final C owner, final M menu, final int menuId) {
+        return this.owner == owner && this.session.current(owner, menu, menuId) ? this.presentation : null;
+    }
+
+    void tick(final C owner, final M menu, final int menuId) {
+        if (this.owner == owner && this.current(owner, menu, menuId) == null) {
+            this.session.close();
+            this.presentation = null;
+        }
+    }
+
+    void clear(final C owner) {
+        if (this.owner != owner) return;
+        this.session.clear();
+        this.presentation = null;
+        this.owner = null;
+    }
+}
+
