+    private void requireCoverage() {
+        if (this.presentation instanceof NativePlayerPresentation || this.helping()) return;
+        if (this.presentation instanceof NativeCookingPresentation cooking
+                && this.geometry.hasLayoutPreferences() && cooking.forcedRecipeBookLayout())
+            throw new IllegalArgumentException("Forced native recipe-book layout controls are unsupported");
+        if (this.geometry.hasPreferences() && !BedrockFurnacePreferences.available(this.owner.getConnection()))
+            throw new IllegalStateException("Native cooking preferences are unavailable");
+        if (this.actionScope.subset()) {
+            this.geometry.requireAuthoredCoverage(this.actionScope.slots(), this.sceneSlots.size());
