+        final boolean clearSearch = this.presentation instanceof NativeCookingPresentation
+                && this.geometry.clearsSearch(event.x(), event.y(), source(event.button()));
+        final boolean editorInput = clearSearch && !this.waitingForPreference() && this.capturedButtons.isEmpty();
+        if (!clearSearch && this.search != null && this.search.visible && this.searchBox != null
+                && this.searchBox.visibleBounds().contains(event.x(), event.y()) && this.search.mouseClicked(event, doubleClick)) {
+            this.focusSearch();
+            return true;
+        }
+        if (!clearSearch && this.searchInput && NativeUiFocus.targets(this.root, _ -> true).stream()
+                .anyMatch(target -> target.box().visibleBounds().contains(event.x(), event.y()))) this.releaseSearch();
+        this.setFocused(null);
+        final String componentSource = this.presentation instanceof NativePlayerPresentation && event.hasShiftDown()
+                && (this.geometry.recipe(event.x(), event.y()) != null || this.geometry.hovered(event.x(), event.y()) >= 0)
+                && (event.button() == InputConstants.MOUSE_BUTTON_LEFT || event.button() == InputConstants.MOUSE_BUTTON_RIGHT)
+                ? "button.menu_auto_place" : source(event.button());
+        this.pointerSources.put(event.button(), componentSource);
+        NativeContainerInput.Result componentEvent = null;
+        if (this.authoredController()) {
+            final var hover = this.nativeInput.pointer(event.x(), event.y(), 1, this.clock.getAsLong(), editorInput || this.pointerEnabled());
+            componentEvent = this.nativeInput.button(componentSource, true, 1, this.clock.getAsLong(), editorInput || this.componentEnabled());
+            if (!this.waitingForPreference()) this.componentEvents(hover);
+        }
+        if (this.waitingForPreference() || this.presentation instanceof NativePlayerPresentation player && !player.idle()) {
+            this.capturedButtons.add(event.button());
+            return true;
+        }
+        if (!this.capturedButtons.isEmpty()) {
+            this.capturedButtons.add(event.button());
+            return true;
+        }
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.press(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        final String input = componentSource;
+        if (componentEvent != null && (this.componentEvents(componentEvent) || this.bundleEvents(componentEvent))) {
+            this.nativeButtons.add(event.button());
+            return true;
+        }
+        if (componentEvent != null && this.presentation instanceof NativePlayerPresentation) {
+            for (final var control : componentEvent.events()) {
+                if (control.button() == null || !control.button().transition()) continue;
+                final var slotInput = playerSlotInput(control.button().target());
+                if (slotInput != null && slotInput.input() == ContainerInput.QUICK_MOVE
+                        && control.node().properties().has("inventory_slot")
+                        && this.playerSlotAction(control.node().properties().get("inventory_slot").getAsInt(), control.button().target())) {
+                    this.nativeButtons.add(event.button());
+                    return true;
+                }
+            }
+        }
+        if (this.presentation instanceof NativePlayerPresentation player && this.geometry.help(event.x(), event.y(), input)) {
+            player.openHelp();
+            this.nativeButtons.add(event.button());
+            return true;
+        }
+        if (this.geometry.closes(event.x(), event.y(), input)) { this.onClose(); return true; }
+        final var preference = this.geometry.preference(event.x(), event.y());
+        if (preference != null) {
+            this.nativeButtons.add(event.button());
+            return true;
+        }
+        final var recipe = this.geometry.recipe(event.x(), event.y());
+        if (recipe != null) {
+            this.capturedButtons.add(event.button());
+            final var mode = recipe.inputs().get(input);
+            if (this.presentation instanceof NativePlayerPresentation) {
+                if (mode != null) BedrockNativePlayerInventory.action(this.owner, this.menu, recipe.id(), playerMode(mode));
+            } else if (mode != null && BedrockNativeCooking.action(this.owner, this.menu, recipe.id(), mode, 0))
