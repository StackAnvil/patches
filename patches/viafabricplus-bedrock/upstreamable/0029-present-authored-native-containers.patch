+        assertEquals(List.of("ir"), sent.stream().map(NativeCookingQuery::text).toList());
+        assertTrue(p.query("iron"));
+        assertFalse(p.flushQuery(sent::add));
+        assertTrue(p.update(message(CookingUi.Family.FURNACE, 2), Map.of(7, new ItemStack(Items.IRON_INGOT))));
+        assertEquals("iron", p.query());
+        assertTrue(p.result(new NativeCookingQueryResult(sent.getFirst(), true)));
