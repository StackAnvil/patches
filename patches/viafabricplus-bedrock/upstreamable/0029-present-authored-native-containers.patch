+    @Test
+    void bundleRepliesSerializeSearchAndCraftingAgainstTheLatestPublishedRevision() {
+        final var clock = new AtomicLong();
+        final var presentation = new NativePlayerPresentation(message(false, 1, 8, 1, "", false), Map.of(), Map.of(), clock::get);
+        final List<NativeBundleAction> bundles = new ArrayList<>();
+        final List<NativePlayerInventoryAction> recipes = new ArrayList<>();
+        assertTrue(presentation.bundle("inventory_items", 4, NativeBundleAction.Kind.PRIMARY, 2, bundles::add));
+        assertEquals(new NativeBundleAction(0, 1, 8, 1, 1, "inventory_items", 4, NativeBundleAction.Kind.PRIMARY, 2), bundles.getFirst());
+        presentation.query("oak", recipes::add);
+        assertTrue(recipes.isEmpty());
+        assertFalse(presentation.send(NativePlayerInventoryAction.Kind.PRIMARY, 0, "", null, recipes::add));
+        assertFalse(presentation.result(new NativePlayerInventoryResult(2, 8, 1, 2, true)));
+        assertFalse(presentation.result(new NativePlayerInventoryResult(1, 9, 1, 2, true)));
+        assertFalse(presentation.result(new NativePlayerInventoryResult(1, 8, 2, 2, true)));
+        assertFalse(presentation.idle());
+        assertTrue(presentation.update(message(false, 1, 8, 2, "", false), Map.of(), Map.of()));
+        assertTrue(presentation.result(new NativePlayerInventoryResult(1, 8, 1, 2, false)));
+        presentation.flush(recipes::add);
+        assertEquals(1, recipes.size());
+        assertEquals(2, recipes.getFirst().request());
+        assertEquals(2, recipes.getFirst().revision());
+        assertEquals("oak", recipes.getFirst().query());
+        assertFalse(presentation.result(new NativePlayerInventoryResult(1, 8, 1, 2, true)));
+        assertTrue(presentation.result(new NativePlayerInventoryResult(1, 8, 2, 2, true)));
+        assertTrue(presentation.bundle("hotbar_items", 1, NativeBundleAction.Kind.SECONDARY, 0, bundles::add));
