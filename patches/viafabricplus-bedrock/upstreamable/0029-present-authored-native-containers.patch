+        return UiProgramFixtures.container(JsonParser.parseString("""
+                {"native_actions":true,"definitions":{
+                 "chest.small_chest_screen":{"parent":"","value":{"type":"screen","$screen_content":"chest.shop",
+                   "controls":[{"content@$screen_content":{}}]}},
