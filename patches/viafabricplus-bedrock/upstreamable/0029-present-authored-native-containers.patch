+        field.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        final var draws = (List<NativeUiPresentation.Draw>) field.get(screen);
+        final var box = draws.stream().filter(matches).filter(draw -> draw.enabled() && draw.alpha() > 0)
+                .map(draw -> draw.box().visibleBounds()).filter(bounds -> bounds.width() > 0 && bounds.height() > 0).findFirst().orElseThrow();
+        return new MouseButtonEvent(box.x() + box.width() / 2, box.y() + box.height() / 2,
+                new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+    }
+}
