+                  "checked_control":"checked","unchecked_control":"unchecked",
+                  "button_mappings":[{"from_button_id":"button.menu_select",
+                    "to_button_id":"button.menu_select","mapping_type":"pressed"}],
+                  "children":[{"name":"checked","type":"image","size":[100,100]},
+                              {"name":"unchecked","type":"image","size":[100,100]}]}}
+                """, Set.of()).root();
+        final var root = layout(scene);
+        final var lifecycle = new NativeUiAnimationLifecycle(scene);
+        final var input = new NativeContainerInput(_ -> { });
+        input.prepare(scene);
+        final var draws = new NativeContainerDraws();
+        final var initial = draws.update(root, 50, 50, lifecycle.animations(), input, 0);
+        assertSame(scene.children().getLast(), initial.getLast().box().node());
+        input.layout(root, initial, 100, 100);
+        input.pointer(50, 50, 1, 0, true);
+        assertTrue(input.button("button.menu_select", true, 1, 0, true).events().getFirst().change().checked());
+        assertSame(scene.children().getFirst(), draws.update(root, 50, 50, lifecycle.animations(), input, 0).getLast().box().node());
+    }
+
+    private static NativeUiLayout.Box layout(final NativeUiScene.Node scene) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(scene, 100, 100, Map.of());
+    }
