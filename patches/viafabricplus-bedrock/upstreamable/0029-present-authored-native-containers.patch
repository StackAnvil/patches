+    @ParameterizedTest
+    @ValueSource(ints = {1, 2})
+    void sourceSelectionLeavesItemsInPlaceAndDrawingStartsWithTheTwoRetainedDestinations(final int previous) throws Exception {
+        final var fixture = new Fixture();
+        fixture.select();
+        assertEquals(SOURCE, fixture.sources.primary());
+        assertTrue(fixture.commands.isEmpty());
+        fixture.shape(FIRST);
+        assertTrue(fixture.commands.isEmpty(), "The first destination only establishes drawing history");
+        fixture.shape(SECOND);
+        fixture.shape(THIRD);
+        fixture.shape(SECOND);
+        final var start = fixture.commands.getFirst();
+        assertEquals(NativeCookingSourceAction.Kind.DRAW, start.kind());
+        assertEquals(0, start.sourceSlot());
+        assertEquals(4, start.destinationSlot());
+        assertEquals(9, start.quantity());
+        assertEquals(List.of(new Click(5, 1), new Click(6, 1), new Click(5, 1)), fixture.clicks);
+        assertTrue(fixture.presentation.sourcePending());
+        assertFalse(fixture.presentation.source(0, 6, 1, NativeCookingSourceAction.Kind.TAP,
+                _ -> fail("Drawing must keep its action owner while admission waits")));
+        assertTrue(fixture.input.event(button("container_take_half_place_one", previous, 0), THIRD, true));
+        assertEquals(List.of(new Click(5, 1), new Click(6, 1), new Click(5, 1), new Click(-999, 2)), fixture.clicks);
+        assertEquals(NativeInventorySourceState.NONE, fixture.sources.primary());
+        assertTrue(fixture.presentation.sourcePending(), "Physical completion must still wait for its original command reply");
+        assertTrue(fixture.presentation.result(new NativeCookingSourceResult(start, true, true)));
+        assertTrue(fixture.presentation.idle());
+        assertFalse(fixture.input.finish(), "A second release cannot send another completion");
+    }
