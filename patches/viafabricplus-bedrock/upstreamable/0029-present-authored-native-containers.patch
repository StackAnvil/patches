+        final Map<NativeUiScene.Node, Entry> indexed = new IdentityHashMap<>();
+        final Map<NativeUiScene.Node, NativeUiScene.Node> replacements = new IdentityHashMap<>();
+        final Map<List<Identity>, NativeUiScene.Node> nodes = new HashMap<>();
