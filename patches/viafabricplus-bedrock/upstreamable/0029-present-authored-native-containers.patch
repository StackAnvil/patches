+    @Test
+    void defaultPlayerAndWorkbenchScenesBindAllRealSlotsAndRouteTheAuthoredHelpControl() {
+        for (final boolean table : new boolean[]{false, true}) {
+            final var presentation = new NativePlayerPresentation(message(table, table ? 0 : 1, 8, 1, "oak", true),
+                    Map.of(0, new ItemStack(Items.IRON_INGOT)), Map.of(), System::nanoTime);
+            final var slots = slots();
+            final var frame = presentation.resolve(table ? 7 : 0, "", slots, Map.of(), false);
+            assertEquals(Set.of(0), frame.recipes().keySet());
+            final var scene = NativeUiScene.parse(frame.scene().toString(), BedrockNativeContainerScreen.RENDERERS).root();
+            final var images = new NativeUiImages();
+            final var renderer = new NativeUiRenderer(mock(Font.class), images);
+            try {
+                renderer.prepare(scene);
