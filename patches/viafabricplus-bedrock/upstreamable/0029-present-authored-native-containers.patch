+            properties.addProperty("default_focus_precedence", index == 1 ? 2 : 0);
+            final var node = new NativeUiScene.Node("candidate" + index, "panel", properties, List.of(), Integer.MIN_VALUE);
+            final var rect = new NativeUiLayout.Rect(index * 40, 0, 20, 20);
+            children.add(new NativeUiLayout.Box(node, rect, bounds, new NativeUiLayout.Size(20, 20), bounds, 0, List.of()));
+        }
+        final var scene = new NativeUiScene.Node(rootNode.name(), rootNode.type(), rootNode.properties(),
+            children.stream().map(NativeUiLayout.Box::node).toList(), rootNode.action());
