+final class NativeContainerButtonTest {
+    @Test
+    void matchingSceneCopiesDoNotReplayAliasedVisibilityCallbacks() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var owner = nestedInput(false, true);
+        owner.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject().addProperty("handle_select", false);
+        layout(input, owner);
+        final var first = input.button("button.menu_ok", true, 1, 1, true);
+        assertSame(owner.children().getFirst(), first.events().get(1).node());
+        assertEquals(2, first.events().get(1).button().previous());
+
+        final var replacement = nestedInput(false, true);
+        replacement.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject().addProperty("handle_select", false);
+        layout(input, replacement);
+        final var repeated = input.button("button.menu_ok", true, 1, 2, true);
+        assertSame(replacement.children().getFirst(), repeated.events().get(1).node());
+        assertEquals(1, repeated.events().get(1).button().previous());
+        assertTrue(replacement.children().getFirst().flag("visible", false));
+    }
+
+    @Test
+    void namedVisibilityCallbacksPrecedeLaterControlsButRegistrationWaitsForPrepare() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var owner = nestedInput(false, false);
+        final var child = owner.children().getFirst();
+        layout(input, owner);
+        final var pressed = input.button("button.menu_ok", true, 1, 1, true);
+        assertEquals(2, pressed.events().size());
+        assertSame(child, pressed.events().get(1).node());
+        assertEquals(2, pressed.events().get(1).button().previous());
+        assertFalse(child.flag("visible", true));
+        assertTrue(input.enabled(child));
+        layout(input, owner);
+        assertFalse(input.enabled(child));
+        assertEquals(1, input.button("button.menu_ok", false, 1, 2, true).events().size());
+        assertTrue(child.flag("visible", false));
+        assertFalse(input.enabled(child));
+        layout(input, owner);
+        assertTrue(input.enabled(child));
+    }
+
+    @Test
+    void aLaterParentSetterInvalidatesTheChildsAlreadyDeliveredMapping() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var owner = nestedInput(true, false);
+        final var child = owner.children().getFirst();
+        layout(input, owner);
+        final var first = input.button("button.menu_ok", true, 1, 1, true);
+        assertSame(child, first.events().getFirst().node());
+        assertEquals(0, first.events().getFirst().button().previous());
+        final var repeated = input.button("button.menu_ok", true, 1, 2, true);
+        assertSame(child, repeated.events().getFirst().node());
+        assertEquals(2, repeated.events().getFirst().button().previous());
+    }
+
+    @Test
+    void initialAliasedSettersReachChildComponentsBeforeTheirFinalVisibleState() {
+        final var input = new NativeContainerInput(_ -> { });
