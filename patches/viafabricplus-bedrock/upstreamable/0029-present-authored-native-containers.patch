@@ -0,0 +1,25 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+
+/** Bedrock 1.26.60.5 reset callbacks use raw phases, independently of activation. */
+final class NativeCookingReset {
+    static final String TARGET = "button.container_reset_held";
+
+    private NativeCookingReset() { }
+
+    static boolean target(final int target) { return target == NativeUiInput.symbol(TARGET); }
+
+    static Edge edge(final NativeUiInput.ButtonEvent event) {
+        if (!target(event.target())) return Edge.NONE;
+        if (event.phase() == 1) return Edge.EMPTY_SOURCE;
+        return event.phase() == 0 && event.previous() != 1 ? Edge.COMPLETE : Edge.NONE;
+    }
+
+    enum Edge { NONE, EMPTY_SOURCE, COMPLETE }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingSourceInput.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingSourceInput.java
new file mode 100644
index 0000000000000000000000000000000000000000..59fe3736ddf0d240049599b9f1aeda34ff589f5f
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingSourceInput.java
@@ -0,0 +1,250 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.container.NativeInventorySourceState.Source;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+import java.util.Set;
+import java.util.function.Function;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceAction;
+
+/** Touch source selection and drawing retain their original slot instead of picking up the cursor. */
+final class NativeCookingSourceInput {
+    static final Set<String> CONTROL_TARGETS = Set.of("button.arrow_key", "button.scrollbar_touch");
+
+    static boolean controlTarget(final int target) {
+        return CONTROL_TARGETS.stream().anyMatch(name -> NativeUiInput.symbol(name) == target);
+    }
+
+    // Bedrock 1.26.60.5 option600 (ctrl_stacksplittingtriggertime), in milliseconds.
+    private static final int DEFAULT_SPLIT_TRIGGER = 525;
+    private final NativeInventorySourceState sources;
+    private final Function<Source, Cell> cells;
+    private final Transport transport;
+    private Source previous = NativeInventorySourceState.NONE;
+    private boolean selecting;
+    private boolean secondary;
+    private boolean drawing;
+    private boolean arrowHeld;
+    private boolean shapeBlocked;
+    private Source holdSource = NativeInventorySourceState.NONE;
+    private Source quantitySource = NativeInventorySourceState.NONE;
+    private long holdStarted = Long.MIN_VALUE;
+    private short holdX;
+    private short holdY;
+    private short quantityOriginX;
+    private float quantityFraction;
+    private boolean quantityActive;
+
+    NativeCookingSourceInput(final NativeInventorySourceState sources, final Function<Source, Cell> cells,
+                             final Transport transport) {
+        this.sources = sources;
+        this.cells = cells;
+        this.transport = transport;
+    }
+
+    /** Raw edge callbacks share a single native flag for scrollbar touch and cursor-drop-all. */
+    void control(final NativeUiInput.ButtonEvent input) {
+        final boolean down = input.phase() == 1 && input.previous() != 1;
+        final boolean up = input.phase() == 0 && input.previous() == 1;
+        if (input.target() == NativeUiInput.symbol("button.arrow_key")) {
+            if (down) this.arrowHeld = true;
+            else if (up) this.arrowHeld = false;
+        } else if (input.target() == NativeUiInput.symbol("button.scrollbar_touch")
+                || input.target() == NativeUiInput.symbol("button.cursor_drop_all")) {
+            if (down) this.shapeBlocked = true;
+            else if (up) this.shapeBlocked = false;
+        }
+    }
+
+    boolean event(final NativeUiInput.ButtonEvent input, final Source source, final boolean cursorEmpty) {
+        this.frame();
+        final boolean all = input.target() == NativeUiInput.symbol("button.container_take_all_place_all");
+        final boolean one = input.target() == NativeUiInput.symbol("button.container_take_half_place_one");
+        final boolean shape = input.target() == NativeUiInput.symbol("button.shape_drawing");
+        if (!all && !one && !shape || !cursorEmpty && !this.drawing) return false;
+        if (input.phase() != 0 && input.phase() != 1) return false;
+        if (!this.drawing && !this.transport.available()) return true;
+        final Cell cell = source.present() ? this.cells.apply(source) : null;
+        if (shape) {
+            if (input.phase() != 1) return false;
+            if (this.quantityActive) return true;
+            this.shape(source, cell);
+            return true;
+        }
+        if (input.phase() == 1 && input.previous() != 1) {
+            if (cell != null && cell.selectable()) this.shapeBlocked = false;
+            final Cell selected = this.cells.apply(this.sources.primary());
+            if (!this.drawing && cell != null && cell.selectable() && !this.holdSource.present()) this.holdSource = source;
+            if (this.drawing || this.selecting || selected != null && selected.selectable()) return true;
+            if (one && cell != null && cell.selectable()) {
+                this.secondary = true;
+                return true;
+            }
+            if (!all || cell == null || !cell.selectable()) return false;
+            this.selecting = true;
+            return true;
+        }
+        // Native activation can finish after a mapping was invalidated (previous phase two).
+        if (input.phase() != 0 || input.previous() == 0) return this.selecting || this.drawing || this.sources.primary().present();
+        this.cancelHold();
+        if (this.quantityActive) {
+            // Native state18 exit clears the active contact, not the retained source or quantity.
+            this.quantityActive = false;
+            this.previous = NativeInventorySourceState.NONE;
+            return true;
+        }
+        if (this.drawing) {
+            this.finish();
+            return true;
+        }
+        if (this.selecting) {
+            this.selecting = this.secondary = false;
+            this.previous = NativeInventorySourceState.NONE;
+            this.sources.primary(cell != null ? source : NativeInventorySourceState.NONE);
+            return true;
+        }
+        if (this.secondary) {
+            this.secondary = false;
+            this.previous = NativeInventorySourceState.NONE;
+            if (cell != null) this.transport.pickup(cell.slot(), 1);
+            return true;
+        }
+        final Cell selected = this.cells.apply(this.sources.primary());
+        if (selected == null || !selected.selectable() || cell == null) return false;
+        if (selected.slot() != cell.slot()
+                && !this.transport.start(selected.slot(), cell.slot(), one ? 1 : this.quantity(selected), NativeCookingSourceAction.Kind.TAP))
+            return true;
+        this.clear();
+        return true;
+    }
+
+    private void shape(final Source source, final Cell cell) {
+        if (this.drawing) {
+            this.visit(cell);
+        } else {
+            final Cell selected = this.cells.apply(this.sources.primary());
+            if (selected == null || !selected.selectable()) {
+                if (!this.shapeBlocked && cell != null && cell.selectable()) {
+                    this.selecting = true;
+                    if (!this.holdSource.present()) this.holdSource = source;
+                }
+            } else if (!this.arrowHeld && selected.selectable() && cell != null && cell.slot() != selected.slot()
+                    && this.previous.present()) {
+                final Cell previous = this.cells.apply(this.previous);
+                final Cell first = previous != null && previous.slot() != selected.slot() ? previous : cell;
+                if (this.transport.start(selected.slot(), first.slot(), this.quantity(selected), NativeCookingSourceAction.Kind.DRAW)) {
+                    this.drawing = true;
+                    this.selecting = false;
+                    this.cancelHold();
+                    if (cell.slot() != first.slot()) this.visit(cell);
+                }
+            }
+        }
+        // Native retains the latest destination even while an arrow blocks distribution entry.
+        this.previous = source;
+    }
+
+    private void visit(final Cell cell) {
+        // Authority owns destination eligibility and duplicate allocation. A rejected or locked
+        // destination may become eligible before this pointer returns to it.
+        if (cell != null) this.transport.visit(cell.slot());
+    }
+
+    boolean finish() {
+        final boolean active = this.drawing || this.selecting || this.secondary || this.sources.primary().present();
+        if (this.drawing) this.transport.finish();
+        this.clear();
+        return active;
+    }
+
+    /** Rejected or retired admission cannot leave a local drawing owner behind. */
+    void frame() {
+        if (this.drawing && !this.transport.drawing()) this.clear();
+    }
+
+    /** Native pointer coordinates are physical pixels; scale converts the authored GUI units. */
+    void frame(final long nanos, final double x, final double y, final float scale, final boolean contact) {
+        this.frame();
+        if (!contact || this.drawing || !this.transport.available()) {
+            this.cancelHold();
+            this.quantityActive = false;
+            return;
+        }
+        final short pointerX = (short) x;
+        final short pointerY = (short) y;
+        if (this.holdSource.present() && !this.quantityActive) {
+            if (this.holdStarted == Long.MIN_VALUE) {
+                this.holdStarted = nanos / 1_000_000;
+                this.holdX = pointerX;
+                this.holdY = pointerY;
+            }
+            final short dx = (short) (pointerX - this.holdX);
+            final short dy = (short) (pointerY - this.holdY);
+            if ((short) (dx * dx + dy * dy) >= 900) {
+                this.cancelHold();
+                this.selecting = this.secondary = false;
+            } else if (nanos / 1_000_000 - this.holdStarted > DEFAULT_SPLIT_TRIGGER
+                    && !this.holdSource.collection().equals("recipe_search")
+                    && (!this.quantitySource.present() || this.quantitySource.equivalent(this.holdSource))) {
+                final Cell held = this.cells.apply(this.holdSource);
+                if (held != null && held.selectable() && held.count() > 1) {
+                    this.sources.primary(this.holdSource);
+                    if (!this.quantitySource.present()) {
+                        this.quantitySource = this.holdSource;
+                        this.quantityOriginX = pointerX;
+                        this.quantityFraction = 0;
+                    }
+                    this.quantityActive = true;
+                    this.selecting = this.secondary = false;
+                    this.cancelHold();
+                }
+            }
+        }
+        if (this.quantityActive) {
+            final float normalized = Math.clamp((pointerX - this.quantityOriginX) / (scale * 32F), -1F, 1F);
+            final float angle = (float) (normalized * Math.PI * 0.5D);
+            this.quantityFraction = ((float) Math.sin(angle) + 1F) * 0.5F;
+        }
+    }
+
+    private int quantity(final Cell selected) {
+        return this.quantitySource.present() && this.quantitySource.equivalent(this.sources.primary())
+                ? (int) ((selected.count() - 1) * this.quantityFraction) + 1 : selected.count();
+    }
+
+    Cell selection() {
+        final Cell selected = this.cells.apply(this.sources.primary());
+        return selected != null && selected.selectable()
+                ? new Cell(selected.slot(), this.quantity(selected), true) : null;
+    }
+
+    private void cancelHold() {
+        this.holdSource = NativeInventorySourceState.NONE;
+        this.holdStarted = Long.MIN_VALUE;
+    }
+
+    private void clear() {
+        this.drawing = this.selecting = this.secondary = false;
+        this.quantityActive = false;
+        this.quantitySource = NativeInventorySourceState.NONE;
+        this.quantityFraction = 0;
+        this.cancelHold();
+        this.previous = NativeInventorySourceState.NONE;
+        this.sources.primary(NativeInventorySourceState.NONE);
+    }
+
+    record Cell(int slot, int count, boolean selectable) { }
+
+    interface Transport {
+        boolean available();
+        boolean drawing();
+        boolean start(int source, int destination, int quantity, NativeCookingSourceAction.Kind kind);
+        void visit(int slot);
+        void pickup(int slot, int button);
+        void finish();
+    }
+}
