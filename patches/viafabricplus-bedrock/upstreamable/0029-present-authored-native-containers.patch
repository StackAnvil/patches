+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipLayout;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiFactoryInstances;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+
+/** Retained native source contexts, separate from recipe hover and Java menu item ordinals. */
+final class NativeInventorySourceState {
+    static final Source NONE = new Source("", -1);
+    static final Source CURSOR = new Source("cursor_items", 0);
+    private Source primary = NONE;
+    private Source pending = NONE;
+    private Source secondary = NONE;
+    private boolean secondarySelected;
+    private Source hover = NONE;
+    private Source bundle = NONE;
+    private int mode;
+    private int inputMode = 1;
+    private boolean hidden;
+    private Integer selectedCell;
+    private long revision;
+    private final UiFactoryInstances details = new UiFactoryInstances();
+
+    long revision() { return this.revision; }
+    Source bundle() { return this.bundle; }
+    Source hover() { return this.hover; }
+    int mode() { return this.mode; }
+
+    /** Desktop state1 activation with no retained primary or secondary source. */
+    NativeBundleAction.Kind desktopBundleInput(final NativeContainerInput.Event event, final boolean heldStorage,
+                                               final boolean heldEmpty, final boolean clickedStorage, final boolean clickedEmpty) {
+        final var button = event.button();
+        if (button == null || !button.transition() || button.mode() != 1 && button.mode() != 3
+                || this.primary.present() || this.secondarySelected || this.mode == 1
+                || event.collectionIndex() < 0 || event.collectionIndex() > 255 || event.collection().isEmpty()) return null;
+        if (button.target() == NativeUiInput.symbol("button.container_take_all_place_all")
+                && (heldStorage && !clickedEmpty || !heldEmpty && clickedStorage)) return NativeBundleAction.Kind.PRIMARY;
+        if (button.target() == NativeUiInput.symbol("button.container_take_half_place_one")
+                && (heldStorage && clickedEmpty || heldEmpty && clickedStorage && this.mode == 2)) return NativeBundleAction.Kind.SECONDARY;
+        return null;
+    }
+
+    void inputMode(final int mode) {
+        if (this.inputMode != mode) {
+            this.inputMode = mode;
+            this.revision++;
+        }
+    }
+
+    /** Called after controller-specific primary-source admission. */
+    void primary(final Source source) {
+        this.primary = Objects.requireNonNull(source);
+        this.revision++;
+    }
+
+    void savePrimary() { this.pending = this.primary; }
+    void restorePrimary() { this.primary = this.pending; }
+
+    /** Supplies the held-source context and flag used by the native selected-context getter. */
+    void secondary(final Source source, final boolean selected) {
+        this.secondary = Objects.requireNonNull(source);
+        this.secondarySelected = selected;
+    }
+
+    /** Source-pointer portion of the native getter; the action backend owns transfer quantity. */
+    Source selected(final boolean cursorEmpty) {
+        if (this.primary.present() && cursorEmpty) return this.primary;
+        return this.secondarySelected ? this.secondary : CURSOR;
+    }
+
+    boolean hover(final Source source, final boolean admitted) {
+        if (this.primary.equals(source)) return admitted;
+        this.hover = Objects.requireNonNull(source);
+        if (this.inputMode != 2) {
+            if (this.mode == 2) {
+                this.clear();
+                this.revision++;
+            }
+            if (admitted) {
+                this.bundle = source;
+                this.mode = 2;
+                this.hidden = false;
+                this.selectedCell = null;
+                this.revision++;
+            }
+        }
+        return admitted;
+    }
+
+    void leave(final Source source) {
+        if (this.mode == 2 && this.hover.equivalent(source)) {
+            this.hover = NONE;
+            this.clear();
+            this.revision++;
+        }
+    }
+
+    /** The native controller update rechecks retained sources without synthesizing pointer events. */
+    boolean refresh(final Predicate<Source> admitted) {
+        boolean changed = false;
+        if ((this.inputMode == 2 ? this.mode == 1 : this.mode == 2) && !admitted.test(this.bundle)) {
+            this.clearBundle();
+            changed = true;
+        }
+        if (this.inputMode != 2) {
+            if (this.mode == 2 && !admitted.test(this.hover)) {
+                this.clear();
+                changed = true;
+            }
+            if (this.mode != 2 && admitted.test(this.hover) && admitted.test(this.hover)) {
+                this.bundle = this.hover;
+                this.mode = 2;
+                this.hidden = false;
+                this.selectedCell = null;
+                changed = true;
+            }
+        }
+        if (changed) this.revision++;
+        return changed;
+    }
+
+    /** Retains the bundle-context portion of an admitted native controller state-49 entry. */
+    void bundleOpened(final Source source) {
+        this.bundle = Objects.requireNonNull(source);
+        this.mode = 1;
+        this.hidden = false;
+        this.selectedCell = null;
+        this.revision++;
+    }
+
+    boolean hide() {
+        if (this.inputMode != 2) return false;
+        this.hidden = true;
+        this.revision++;
+        return true;
+    }
+
+    /** State 52 only selects a cell and requests details; it does not move inventory items. */
+    int selectCell(final int cell, final BundleTooltipLayout layout, final IntFunction<String> hoverText) {
+        if (this.mode != 1) return -1;
+        this.selectedCell = Objects.equals(this.selectedCell, cell) ? null : cell;
+        this.hidden = true;
+        this.revision++;
+        final int slot = this.selectedCell == null || cell < 0 || cell >= layout.sourceSlots().size() ? -1 : layout.sourceSlots().get(cell);
+        if (slot >= 0) {
+            final var properties = new JsonObject();
+            properties.addProperty("name", "popup_tip_text");
+            properties.addProperty("#selected_hover_text", Objects.requireNonNull(hoverText.apply(slot)));
+            properties.addProperty("exclusive", true);
+            this.details.create(properties);
+        }
+        return slot;
+    }
+
+    boolean retireDetails(final long creation) {
+        if (!this.details.retire(creation)) return false;
+        this.revision++;
+        return true;
+    }
+
+    BundleTooltipUi.View view(final Function<Source, NativeInventoryItemPresentation.BundleTooltip> contents,
+                              final Boolean showTags) {
+        if (this.mode == 0) return new BundleTooltipUi.View(0, this.inputMode, this.hidden, this.selectedCell, null, null, List.of(), this.details.instances());
+        final var snapshot = contents.apply(this.bundle);
+        if (snapshot == null) throw new IllegalArgumentException("Retained native bundle source is unavailable");
+        return snapshot.view(this.mode, this.inputMode, this.hidden, this.selectedCell, showTags).withDetails(this.details.instances());
+    }
+
+    private void clear() {
+        this.primary = NONE;
+        this.clearBundle();
+    }
+
+    private void clearBundle() {
+        this.bundle = NONE;
+        this.mode = 0;
+        this.hidden = false;
+        this.selectedCell = null;
+    }
+
+    record Source(String collection, int index) {
+        Source { Objects.requireNonNull(collection); }
+
+        boolean present() { return !this.collection.isEmpty() && this.index != -1; }
+
+        boolean equivalent(final Source other) {
+            if (this.equals(other)) return true;
+            if (this.collection.equals("hotbar_items") && other.collection.equals("combined_hotbar_and_inventory_items")
+                    || this.collection.equals("combined_hotbar_and_inventory_items") && other.collection.equals("hotbar_items"))
+                return Integer.compareUnsigned(this.index, 9) < 0 && this.index == other.index;
+            if (this.collection.equals("inventory_items") && other.collection.equals("combined_hotbar_and_inventory_items"))
+                return this.index == other.index - 9;
+            return this.collection.equals("combined_hotbar_and_inventory_items") && other.collection.equals("inventory_items")
+                && this.index - 9 == other.index;
+        }
+    }
+}
