+        assertThrows(IllegalArgumentException.class, () -> geometry.requireComplete(2));
+    }
+
+    @Test
+    void recipeCellsShareSlotPainterOrderClippingAndSourceSpecificCommands() {
+        final var slot = draw(0, true, 1, 0, 0, 18, new NativeUiLayout.Rect(0, 0, 100, 100), 1);
+        final var recipe = recipe(7, 1);
+        final var authority = Map.of(7, Set.of(NativeCookingAction.Mode.PRIMARY.button(), NativeCookingAction.Mode.SECONDARY.button()));
+        final var geometry = new NativeContainerGeometry(List.of(slot, recipe), 1, authority);
+        assertEquals(0, geometry.hovered(1, 1));
+        assertNull(geometry.recipe(1, 1));
+        assertEquals(-1, geometry.hovered(9, 1));
+        assertFalse(geometry.contains(0, 9, 1));
+        assertEquals(7, geometry.recipe(9, 1).id());
+        assertEquals(NativeCookingAction.Mode.PRIMARY, geometry.recipe(9, 1).inputs().get("button.menu_select"));
+        assertEquals(NativeCookingAction.Mode.SECONDARY, geometry.recipe(9, 1).inputs().get("button.menu_secondary_select"));
+        assertFalse(geometry.closes(9, 1, "button.menu_select"));
+        assertNull(new NativeContainerGeometry(List.of(recipe, slot), 1, authority).recipe(9, 1));
+        for (final var inactive : List.of(new NativeUiPresentation.Draw(recipe.box(), 0, 1, true),
+                new NativeUiPresentation.Draw(recipe.box(), 1, 1, false))) {
+            final var hidden = new NativeContainerGeometry(List.of(slot, inactive), 1, authority);
+            assertNull(hidden.recipe(9, 1));
+            assertEquals(0, hidden.hovered(9, 1));
+        }
+    }
+
+    @Test
+    void recipeAdmissionRequiresActualScopeAndUnambiguousConsumedMappings() {
+        final var authority = Map.of(7, Set.of(NativeCookingAction.Mode.PRIMARY.button(), NativeCookingAction.Mode.SECONDARY.button()));
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(recipe(7, 1)), 1));
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(recipe(8, 1)), 1, authority));
+        for (int change = 0; change < 7; change++) {
+            final var recipe = recipe(7, 1);
+            final var props = recipe.box().node().properties();
+            final var mapping = props.getAsJsonArray("recipe_actions").get(0).getAsJsonObject();
+            switch (change) {
+                case 0 -> props.addProperty("inventory_slot", 0);
+                case 1 -> { mapping.addProperty("consume_event", false); props.getAsJsonArray("button_mappings").set(0, mapping.deepCopy()); }
+                case 2 -> { mapping.addProperty("mapping_type", "global"); props.getAsJsonArray("button_mappings").set(0, mapping.deepCopy()); }
+                case 3 -> props.getAsJsonArray("button_mappings").add(com.google.gson.JsonParser.parseString("""
+                    {"from_button_id":"button.menu_select","to_button_id":"button.drop_one","mapping_type":"pressed"}
+                    """));
+                case 4 -> { mapping.addProperty("from_button_id", "button.menu_secondary_select");
+                    props.getAsJsonArray("button_mappings").set(0, mapping.deepCopy()); }
+                case 5 -> { mapping.addProperty("handle_select", false); props.getAsJsonArray("button_mappings").set(0, mapping.deepCopy()); }
+                case 6 -> { mapping.addProperty("consume_event", "true"); props.getAsJsonArray("button_mappings").set(0, mapping.deepCopy()); }
+            }
+            assertThrows(RuntimeException.class, () -> new NativeContainerGeometry(List.of(recipe), 1, authority));
+        }
+    }
+
+    private static NativeUiPresentation.Draw recipe(final int id, final float layer) {
+        final var props = new JsonObject();
+        props.addProperty("recipe_id", id);
+        props.addProperty("collection", "recipe_book");
+        final var mappings = com.google.gson.JsonParser.parseString("""
+            [{"from_button_id":"button.menu_select","to_button_id":"button.recipe_select","mapping_type":"pressed"},
+             {"from_button_id":"button.menu_secondary_select","to_button_id":"button.recipe_secondary","mapping_type":"pressed"}]
+            """).getAsJsonArray();
+        props.add("button_mappings", mappings.deepCopy());
+        props.add("recipe_actions", mappings);
+        final var node = new NativeUiScene.Node("recipe", "button", props, List.of(), Integer.MIN_VALUE);
+        final var bounds = new NativeUiLayout.Rect(0, 0, 18, 18);
+        return new NativeUiPresentation.Draw(new NativeUiLayout.Box(node, bounds, new NativeUiLayout.Rect(8, 0, 10, 18),
+                new NativeUiLayout.Size(18, 18), bounds, layer, List.of()), 1, 1, true);
+    }
+
+    private static NativeUiPresentation.Draw draw(final int slot, final boolean enabled, final float alpha,
+            final float x, final float y, final float size, final NativeUiLayout.Rect clip, final float layer) {
+        final var properties = new JsonObject();
+        properties.addProperty("inventory_slot", slot);
+        properties.add("inventory_actions", new JsonArray());
+        final var node = new NativeUiScene.Node("slot", "button", properties, List.of(), -2);
+        final var rect = new NativeUiLayout.Rect(x, y, size, size);
+        return new NativeUiPresentation.Draw(new NativeUiLayout.Box(node, rect, clip, new NativeUiLayout.Size(size, size), rect, layer, List.of()), alpha, alpha, enabled);
+    }
+}
