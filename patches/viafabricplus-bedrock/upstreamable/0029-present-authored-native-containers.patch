+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+
+public record PlayerInventoryScreenRequestPayload(PlayerInventoryScreenRequest request, boolean deferred) implements CustomPacketPayload {
+    public static final Type<PlayerInventoryScreenRequestPayload> TYPE = new Type<>(Identifier.parse(PlayerInventoryScreenRequest.CHANNEL));
+    public static final Type<PlayerInventoryScreenRequestPayload> DEFERRED_TYPE = new Type<>(Identifier.parse(PlayerInventoryScreenRequest.DEFERRED_CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, PlayerInventoryScreenRequestPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> PlayerInventoryScreenRequest.TYPE.write(buffer, payload.request),
+            buffer -> new PlayerInventoryScreenRequestPayload(PlayerInventoryScreenRequest.TYPE.read(buffer)));
+    public static final StreamCodec<RegistryFriendlyByteBuf, PlayerInventoryScreenRequestPayload> DEFERRED_CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> PlayerInventoryScreenRequest.TYPE.write(buffer, payload.request),
+            buffer -> new PlayerInventoryScreenRequestPayload(PlayerInventoryScreenRequest.TYPE.read(buffer), true));
+
+    public PlayerInventoryScreenRequestPayload(final PlayerInventoryScreenRequest request) { this(request, false); }
+
+    @Override
+    public Type<PlayerInventoryScreenRequestPayload> type() { return this.deferred ? DEFERRED_TYPE : TYPE; }
+}
