+    @Test
+    void snapshotUpdatesRetainSearchWhileChangedResourceBytesReplaceTheAuthoredLabel() {
+        final var source = message(false, 1, 8, 1, "", false);
+        final var authored = JsonParser.parseString(source.program()).getAsJsonObject();
+        final var host = authored.getAsJsonObject("definitions").getAsJsonObject("crafting.inventory_screen").getAsJsonObject("value");
+        if (!host.has("controls")) host.add("controls", new JsonArray());
+        final var extra = JsonParser.parseString("""
+                {"resource_label":{"type":"label","text":"First resource title","size":[120,20]}}
+                """).getAsJsonObject();
+        host.getAsJsonArray("controls").add(extra);
+        final String firstProgram = authored.toString();
+        final var first = new NativePlayerInventoryMessage(0, 1, 8, 1, firstProgram, source.snapshot(), Map.of());
+        final var presentation = new NativePlayerPresentation(first, Map.of(), Map.of(), () -> 0);
+        assertTrue(presentation.resolve(0, "", slots(), Map.of(), false).scene().toString().contains("First resource title"));
+        final var searched = message(false, 1, 8, 2, "oak", false);
