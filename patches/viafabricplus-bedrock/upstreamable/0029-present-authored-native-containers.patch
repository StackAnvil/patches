+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+
+final class NativeContainerPresentation implements NativeInventoryPresentation {
+    private final ContainerUi program;
+    private final ContainerUi.Kind kind;
+    private List<Integer> data;
+    private long revision;
+
+    NativeContainerPresentation(final ContainerUi program, final ContainerUi.Kind kind, final List<Integer> data) {
+        this.program = program;
+        this.kind = kind;
+        this.data(data);
+    }
+
+    ContainerUi.Kind kind() { return this.kind; }
+
+    void data(final List<Integer> values) {
+        this.kind.validateData(values);
+        if (!values.equals(this.data)) {
+            this.data = List.copyOf(values);
+            this.revision++;
+        }
+    }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags) {
+        final var scene = this.program.resolve(new ContainerUi.MenuView(menuId, this.kind, title, slots, cursor, this.data));
+        if (scene == null) throw new IllegalArgumentException("Unresolved native inventory presentation");
+        return new Frame(scene, this.kind.containerSlots(), Map.of());
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java
new file mode 100644
index 0000000..219a21c
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java
@@ -0,0 +1,95 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+/**
+ * The receiver's real menu lifetime and content-order state, independently testable without a
+ * renderer.
+ */
+final class NativeContainerPresentationController<C, M, P> {
+    private final NativeContainerSession<C, M> session = new NativeContainerSession<>();
+    private NativeContainerPending<C, M, P> pending;
+    private C owner;
+    private C contentOwner;
+    private M contentMenu;
+
+    void begin(final C owner) {
+        if (owner == null) throw new IllegalArgumentException("Native play session is required");
+        if (this.owner == owner) return;
+        this.clear();
+        this.owner = owner;
+    }
+
+    boolean claim(
+            final C owner,
+            final M menu,
+            final int currentMenuId,
+            final int messageMenuId,
+            final long sequence) {
+        if (owner == null || this.owner != owner) return false;
+        final boolean accepted =
+                this.session.accept(owner, menu, currentMenuId, messageMenuId, sequence);
+        if (accepted) this.pending = null;
+        return accepted;
+    }
+
+    P offer(
+            final C owner,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final boolean awaitingContents,
+            final long now,
+            final P presentation) {
+        if (!this.current(owner, menu, menuId) || this.session.sequence() != sequence)
+            return null;
+        if (awaitingContents && (this.contentOwner != owner || this.contentMenu != menu)) {
+            this.pending =
+                    new NativeContainerPending<>(owner, menu, menuId, sequence, now, presentation);
+            return null;
+        }
+        return presentation;
+    }
+
+    P contents(final C owner, final M menu, final int menuId, final long now) {
+        if (owner == null || this.owner != owner || menu == null) return null;
+        this.contentOwner = owner;
+        this.contentMenu = menu;
+        if (this.pending == null) return null;
+        final P result = this.pending.contents(owner, menu, menuId, this.session.sequence(), now);
+        this.pending = null;
+        return this.current(owner, menu, menuId) ? result : null;
+    }
+
+    void tick(final C owner, final M menu, final int menuId, final long now) {
+        if (this.owner != owner) return;
+        if (this.pending != null
+                && (!this.current(owner, menu, menuId)
+                        || !this.pending.current(
+                                owner, menu, menuId, this.session.sequence(), now)))
+            this.pending = null;
+        if (this.contentMenu != menu || this.contentOwner != owner) {
+            this.contentOwner = null;
+            this.contentMenu = null;
+        }
+    }
+
+    boolean current(final C owner, final M menu, final int menuId) {
+        return owner != null && this.owner == owner && this.session.current(owner, menu, menuId);
+    }
+
+    void clear(final C owner) {
+        if (this.owner == owner) this.clear();
+    }
+
+    void clear() {
+        this.owner = null;
+        this.session.clear();
+        this.pending = null;
+        this.contentOwner = null;
+        this.contentMenu = null;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerScroll.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerScroll.java
