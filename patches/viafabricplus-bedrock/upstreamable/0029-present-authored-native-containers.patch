+        assertEquals(Set.of(0), presentation.resolve(0, "", actual, Map.of(), false).craftingPreview().keySet());
+        final var searched = message(false, 1, 8, 3, "no results", false);
+        assertTrue(presentation.update(new NativePlayerInventoryMessage(searched.context(),0, 1, 8, 3, searched.snapshot(),
+                Map.of(), wireGhosts), Map.of(), Map.of(0, new ItemStack(Items.IRON_INGOT, 4), 1, new ItemStack(Items.IRON_INGOT))));
+        assertEquals(Set.of(0, 1), presentation.resolve(0, "", slots(), Map.of(), false).craftingPreview().keySet());
