+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+
+class NativeContainerPresentationControllerTest {
+    @Test
+    void waitsForRealContentsThenPresentsOnceAndPreservesPendingAgainstStaleMessages() {
+        final var controller = new NativeContainerPresentationController<Object, Object, Object>();
+        final var connection = new Object();
+        final var menu = new Object();
+        final var presentation = new Object();
+        controller.begin(connection);
+        assertTrue(controller.claim(connection, menu, 6, 6, 1));
+        assertNull(controller.offer(connection, menu, 6, 1, true, 0, presentation));
+        assertFalse(controller.claim(connection, menu, 6, 6, 1));
+        assertSame(presentation, controller.contents(connection, menu, 6, 1));
+        assertNull(controller.contents(connection, menu, 6, 2));
+        assertTrue(controller.current(connection, menu, 6));
+    }
+
+    @Test
+    void closeReuseDisconnectAndExpiryNeverAdoptContentsForAnotherMenu() {
+        final var connection = new Object();
+        final var menu = new Object();
+        final var replacement = new Object();
+        for (final int failure : new int[] {0, 1, 2}) {
+            final var controller =
+                    new NativeContainerPresentationController<Object, Object, Object>();
+            controller.begin(connection);
+            assertTrue(controller.claim(connection, menu, 6, 6, 1));
+            assertNull(controller.offer(connection, menu, 6, 1, true, 0, new Object()));
+            if (failure == 0) controller.tick(connection, replacement, 6, 1);
+            if (failure == 1) controller.clear();
+            if (failure == 2) controller.tick(connection, menu, 6, 100);
+            assertNull(controller.contents(connection, replacement, 6, 101));
+            assertNull(controller.contents(connection, menu, 6, 102));
+        }
+    }
+
+    @Test
+    void contentsBeforePresentationAndLegacyImmediatePresentationKeepTheirOrder() {
+        final var controller = new NativeContainerPresentationController<Object, Object, Object>();
+        final var connection = new Object();
+        final var menu = new Object();
+        final var presentation = new Object();
+        controller.begin(connection);
+        assertNull(controller.contents(connection, menu, 6, 0));
+        assertTrue(controller.claim(connection, menu, 6, 6, 1));
+        assertSame(presentation, controller.offer(connection, menu, 6, 1, true, 1, presentation));
+        final var replacement = new Object();
+        assertTrue(controller.claim(connection, replacement, 7, 7, 2));
+        assertSame(
+                presentation,
+                controller.offer(connection, replacement, 7, 2, false, 2, presentation));
+    }
+
+    @Test
+    void reconfigurationRejectsOldCallbacksAndDisconnectWithoutConsumingNewPendingContents() {
+        final var controller = new NativeContainerPresentationController<Object, Object, Object>();
+        final var oldSession = new Object();
+        final var newSession = new Object();
+        final var menu = new Object();
+        final var presentation = new Object();
+        controller.begin(oldSession);
+        assertTrue(controller.claim(oldSession, menu, 6, 6, 19));
+        assertNull(controller.offer(oldSession, menu, 6, 19, true, 0, new Object()));
+        controller.begin(newSession);
+        assertFalse(controller.current(oldSession, menu, 6));
+        assertTrue(controller.claim(newSession, menu, 6, 6, 1));
+        assertNull(controller.offer(newSession, menu, 6, 1, true, 1, presentation));
+        assertFalse(controller.claim(oldSession, menu, 6, 6, 20));
+        assertNull(controller.offer(oldSession, menu, 6, 20, false, 2, new Object()));
+        assertNull(controller.contents(oldSession, menu, 6, 2));
+        controller.tick(oldSession, menu, 6, 200);
+        controller.clear(oldSession);
+        controller.begin(newSession);
+        assertTrue(controller.current(newSession, menu, 6));
+        assertSame(presentation, controller.contents(newSession, menu, 6, 3));
+        controller.clear(newSession);
+        assertFalse(controller.claim(newSession, menu, 6, 6, 2));
+        assertFalse(controller.current(newSession, menu, 6));
+    }
+
+}
