+        properties.addProperty("toggle_state", checked);
+        final var mappings = new JsonArray();
+        final var mapping = new JsonObject();
+        mapping.addProperty("from_button_id", "button.menu_select");
+        mapping.addProperty("to_button_id", "button.menu_select");
