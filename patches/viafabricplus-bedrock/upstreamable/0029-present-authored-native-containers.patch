+    @Test
+    void bundleSoundsBelongToOnePendingOperationAndNeverARecipeOrReplacementOpening() {
+        final var presentation = new NativePlayerPresentation(message(false, 1, 8, 1, "", false), Map.of(), Map.of(), () -> 0);
+        final List<NativeBundleResult.Sound> sounds = new ArrayList<>();
+        assertTrue(presentation.bundle("inventory_items", 4, NativeBundleAction.Kind.PRIMARY, 2, ignored -> {}));
+        for (final var foreign : List.of(new NativePlayerInventoryResult(2, 8, 1, 2, true),
+                new NativePlayerInventoryResult(1, 9, 1, 2, true), new NativePlayerInventoryResult(1, 8, 2, 2, true))) {
+            assertFalse(presentation.result(new NativeBundleResult(foreign, NativeBundleResult.Sound.INSERT), sounds::add));
+        }
+        assertFalse(presentation.result(new NativeBundleResult(new NativePlayerInventoryResult(1, 8, 1, 2, true),
+                NativeBundleResult.Sound.REMOVE_ONE), sounds::add));
+        assertFalse(presentation.idle());
+        assertTrue(sounds.isEmpty());
+        assertTrue(presentation.update(message(false, 1, 8, 2, "", false), Map.of(), Map.of()));
+        final var failure = new NativeBundleResult(new NativePlayerInventoryResult(1, 8, 1, 2, false), NativeBundleResult.Sound.INSERT_FAIL);
+        assertTrue(presentation.result(failure, sounds::add));
+        assertEquals(List.of(NativeBundleResult.Sound.INSERT_FAIL), sounds);
+        assertTrue(presentation.idle());
+        assertFalse(presentation.result(failure, sounds::add));
+        assertTrue(presentation.send(NativePlayerInventoryAction.Kind.SEARCH, -1, "oak", null, ignored -> {}));
+        assertFalse(presentation.result(new NativeBundleResult(new NativePlayerInventoryResult(1, 8, 2, 2, true),
