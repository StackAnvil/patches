@@ -0,0 +1,65 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.world.item.ItemStack;
+
+/** Matched real slot loss/gain, native quintic motion and expiration. Cursor collection membership is unbound. */
+final class NativeInventoryFlights {
+    private final List<Flight> flights = new ArrayList<>();
+
+    void update(final List<ItemStack> before, final List<ItemStack> after, final Map<Integer, Anchor> anchors, final long now) {
+        if (before.size() != after.size()) throw new IllegalArgumentException("Inventory flight snapshot sizes differ");
+        final int[] lost = new int[before.size()], gained = new int[after.size()];
+        for (int i = 0; i < lost.length; i++) {
+            final var old = before.get(i);
+            final var current = after.get(i);
+            final int retained = same(old, current) ? Math.min(old.getCount(), current.getCount()) : 0;
+            lost[i] = old.getCount() - retained;
+            gained[i] = current.getCount() - retained;
+        }
+        this.expire(now);
+        for (int source = 0; source < lost.length; source++) {
+            for (int destination = 0; lost[source] > 0 && destination < gained.length; destination++) {
+                if (gained[destination] <= 0 || !same(before.get(source), after.get(destination))) continue;
+                final int count = Math.min(lost[source], gained[destination]);
+                lost[source] -= count;
+                gained[destination] -= count;
+                final Anchor origin = anchors.get(source), target = anchors.get(destination);
+                if (origin == null || target == null || this.flights.size() >= 128) continue;
+                final float distance = (float) Math.hypot(target.x - origin.x, target.y - origin.y);
+                final float duration = Math.clamp(distance / 230 * .3F, .15F, .3F);
+                this.flights.add(new Flight(before.get(source).copy(), origin, target, now, duration));
+            }
+        }
+    }
+
+    private static boolean same(final ItemStack left, final ItemStack right) {
+        return !left.isEmpty() && !right.isEmpty() && ItemStack.isSameItemSameComponents(left, right);
+    }
+
+    private void expire(final long now) { this.flights.removeIf(flight -> (now - flight.start) / 1_000_000_000F > .3F); }
+
+    List<Frame> frames(final long now) {
+        this.expire(now);
+        return this.flights.stream().map(flight -> {
+            final float t = Math.clamp((now - flight.start) / 1_000_000_000F / flight.duration, 0, 1);
+            final float d = t - 1;
+            final float eased = 1 + d * d * d * d * d;
+            return new Frame(flight.stack, blend(flight.origin.x, flight.destination.x, eased),
+                blend(flight.origin.y, flight.destination.y, eased), blend(flight.origin.scale, flight.destination.scale, eased));
+        }).toList();
+    }
+
+    private static float blend(final float from, final float to, final float t) { return from + (to - from) * t; }
+
+    record Anchor(float x, float y, float scale) {}
+    record Frame(ItemStack stack, float x, float y, float scale) {}
+    private record Flight(ItemStack stack, Anchor origin, Anchor destination, long start, float duration) {}
+}
