+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemStyle;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import net.minecraft.client.renderer.state.gui.BlitRenderState;
+import net.raphimc.viabedrock.api.resourcepack.ui.InventoryItemFilter;
+
+/** Lighting and opacity belong to an extracted item, not its shared atlas entry. */
+public record NativeInventoryItemStyle(float opacity, float lightMultiplier) {
+    public static final NativeInventoryItemStyle NORMAL = new NativeInventoryItemStyle(1, 1);
+
+    public NativeInventoryItemStyle {
+        if (!Float.isFinite(opacity) || opacity < 0 || opacity > 1)
+            throw new IllegalArgumentException("Invalid native item opacity");
+    }
+
+    static NativeInventoryItemStyle from(final NativeUiScene.Node node, final float opacity) {
+        final var value = node.properties().get("disabled_filter_visible");
+        final boolean disabled = value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean() && value.getAsBoolean();
+        final var configured = node.properties().get("filtered_light_multiplier");
+        JsonElement scalar = null;
+        if (configured != null && configured.isJsonPrimitive()) {
+            final var primitive = configured.getAsJsonPrimitive();
+            if (primitive.isBoolean()) scalar = new JsonPrimitive(primitive.getAsBoolean());
+            else if (primitive.isNumber()) scalar = new JsonPrimitive(primitive.getAsNumber());
+        }
+        return new NativeInventoryItemStyle(opacity, InventoryItemFilter.lightMultiplier(disabled, scalar));
+    }
+
+    public static void extract(final IBedrockGuiItemStyle graphics, final NativeInventoryItemStyle style, final Runnable extraction) {
+        final var previous = graphics.stackanvil$itemStyle();
+        graphics.stackanvil$itemStyle(style);
+        try { extraction.run(); }
+        finally { graphics.stackanvil$itemStyle(previous); }
+    }
+
+    /** Native filtering preserves alpha; the cached premultiplied texture then receives control opacity. */
+    public static BlitRenderState apply(final BlitRenderState blit, final NativeInventoryItemStyle style) {
+        if (style.equals(NORMAL)) return blit;
+        final int color = InventoryItemFilter.color(blit.color(), style.lightMultiplier);
+        int faded = 0;
+        for (int shift = 0; shift < 32; shift += 8)
+            faded |= Math.round(((color >>> shift) & 255) * style.opacity) << shift;
+        return new BlitRenderState(blit.pipeline(), blit.textureSetup(), blit.pose(),
+                blit.x0(), blit.y0(), blit.x1(), blit.y1(), blit.u0(), blit.u1(), blit.v0(), blit.v1(),
+                faded, blit.scissorArea(), blit.bounds());
+    }
+}
