@@ -0,0 +1,222 @@
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.container.NativeInventorySourceState.Source;
+import java.util.List;
+import java.util.stream.IntStream;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.component.DataComponentMap;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.raphimc.viabedrock.api.model.NativeBundleTooltipData;
+import net.raphimc.viabedrock.api.model.NativeItemStorageData;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipLayout;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeInventorySourceStateTest {
+    private static final Source INVENTORY = new Source("inventory_items", 4);
+    private static final Source HOTBAR = new Source("hotbar_items", 2);
+
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        if (!Items.IRON_INGOT.builtInRegistryHolder().areComponentsBound()) Items.IRON_INGOT.builtInRegistryHolder().bindComponents(DataComponentMap.EMPTY);
+    }
+
+    @Test
+    void restoresThePendingSourceWithoutReplacingItWithTheCarriedItemOrSecondaryContext() {
+        final var state = new NativeInventorySourceState();
+        assertEquals(NativeInventorySourceState.CURSOR, state.selected(true));
+        state.primary(INVENTORY);
+        state.savePrimary();
+        state.primary(HOTBAR);
+        state.secondary(new Source("container_items", 7), true);
+        assertEquals(HOTBAR, state.selected(true));
+        assertEquals(new Source("container_items", 7), state.selected(false));
+        state.restorePrimary();
+        assertEquals(INVENTORY, state.selected(true));
+        state.secondary(new Source("container_items", 7), false);
+        assertEquals(NativeInventorySourceState.CURSOR, state.selected(false));
+        state.primary(new Source("inventory_items", -1));
+        assertEquals(NativeInventorySourceState.CURSOR, state.selected(true));
+        // The native getter uses -1 as its sentinel, not a signed nonnegative test.
+        state.primary(new Source("inventory_items", -2));
+        assertEquals(new Source("inventory_items", -2), state.selected(true));
+    }
+
+    @Test
+    void refreshesTheHoveredBundleAndClearsItOnlyWhenItsEquivalentSourceLeaves() {
+        final var state = new NativeInventorySourceState();
+        state.hover(INVENTORY, true);
+        assertEquals("Inventory bundle", view(state).contents().primaryName());
+        state.leave(HOTBAR);
+        assertEquals(2, view(state).mode());
+        state.leave(new Source("combined_hotbar_and_inventory_items", 13));
+        assertEquals(0, view(state).mode());
+        assertEquals(NativeInventorySourceState.NONE, state.hover());
+        assertEquals(NativeInventorySourceState.CURSOR, state.selected(true));
+        state.hover(new Source("combined_hotbar_and_inventory_items", 13), true);
+        state.leave(INVENTORY);
+        assertEquals(0, view(state).mode());
+
+        state.hover(HOTBAR, true);
+        state.leave(new Source("combined_hotbar_and_inventory_items", 9));
+        assertEquals(2, view(state).mode());
+        state.leave(new Source("combined_hotbar_and_inventory_items", 2));
+        assertEquals(0, view(state).mode());
+        state.hover(new Source("hotbar_items", 9), true);
+        state.leave(new Source("combined_hotbar_and_inventory_items", 9));
+        assertEquals(2, view(state).mode());
+        state.hover(INVENTORY, true);
+        assertThrows(IllegalArgumentException.class, () -> state.view(_ -> null, false));
+        assertEquals(INVENTORY, state.bundle());
+        assertEquals("Replacement bundle", state.view(_ -> snapshot("Replacement bundle", 5), false).contents().primaryName());
+        state.hover(new Source("recipe_items", 0), false);
+        assertEquals(0, view(state).mode());
+        final long revision = state.revision();
+        state.hover(new Source("recipe_items", 1), false);
+        assertEquals(revision, state.revision(), "Inactive hover must not rebuild the bundle scene");
+    }
+
+    @Test
+    void desktopUpdatesRestoreStationarySourcesWithoutDiscardingTheIndependentPrimary() {
+        for (final int mode : new int[]{1, 3}) {
+            final var state = new NativeInventorySourceState();
+            state.inputMode(mode);
+            state.primary(HOTBAR);
+            state.hover(INVENTORY, true);
+            final long stable = state.revision();
+            assertFalse(state.refresh(INVENTORY::equals));
+            assertEquals(stable, state.revision(), "Unchanged hover must not rebuild each frame");
+            assertTrue(state.refresh(ignored -> false));
+            assertEquals(0, state.mode());
+            assertEquals(NativeInventorySourceState.NONE, state.bundle());
+            assertEquals(INVENTORY, state.hover());
+            assertEquals(HOTBAR, state.selected(true));
+            assertFalse(state.refresh(ignored -> false));
+            assertTrue(state.refresh(INVENTORY::equals));
+            assertEquals(2, state.mode());
+            assertEquals(INVENTORY, state.bundle());
+            assertEquals(HOTBAR, state.selected(true));
+            final long restored = state.revision();
+            assertFalse(state.refresh(INVENTORY::equals));
+            assertEquals(restored, state.revision());
+            state.leave(INVENTORY);
+            assertFalse(state.refresh(INVENTORY::equals));
+            assertEquals(0, state.mode(), "A real pointer leave must prevent later restoration");
+        }
+    }
+
+    @Test
+    void touchUpdatesClearMissingRetainedBundlesWithoutOpeningOneFromTheHoverSource() {
+        final var state = new NativeInventorySourceState();
+        state.inputMode(2);
+        state.hover(INVENTORY, true);
+        state.bundleOpened(HOTBAR);
+        state.primary(INVENTORY);
+        assertTrue(state.refresh(INVENTORY::equals));
+        assertEquals(0, state.mode());
+        assertEquals(INVENTORY, state.hover());
+        assertEquals(INVENTORY, state.selected(true));
+        assertFalse(state.refresh(ignored -> true));
+        assertEquals(0, state.mode());
+    }
+
+    @Test
+    void matchingPrimaryHoverAndTouchHoverRetainTheExistingBundleSource() {
+        final var state = new NativeInventorySourceState();
+        state.bundleOpened(INVENTORY);
+        state.primary(HOTBAR);
+        state.hover(HOTBAR, true);
+        assertEquals(INVENTORY, state.bundle());
+        assertEquals(NativeInventorySourceState.NONE, state.hover());
+        state.inputMode(2);
+        state.hover(new Source("container_items", 7), true);
+        assertEquals(new Source("container_items", 7), state.hover());
+        assertEquals("Inventory bundle", view(state).contents().primaryName());
+        state.leave(new Source("container_items", 7));
+        assertEquals(1, view(state).mode());
+        assertTrue(state.hide());
+        assertTrue(view(state).hidden());
+        state.inputMode(1);
+        assertFalse(state.hide());
+        assertTrue(view(state).hidden());
+    }
+
+    @Test
+    void selectingAPhysicalCellHidesTheTooltipAndRepeatedSelectionClearsItWithoutMovingItems() {
+        final var state = new NativeInventorySourceState();
+        state.bundleOpened(INVENTORY);
+        final var contents = snapshot("Inventory bundle", 5);
+        final var layout = BundleTooltipLayout.resolve(contents.contents());
+        assertEquals(4, state.selectCell(3, layout, slot -> "Native child " + slot));
+        final var selected = state.view(_ -> contents, false);
+        assertEquals(3, selected.selectedCell());
+        assertTrue(selected.hidden());
+        assertEquals("child 4", selected.items().get(4).primaryName());
+        assertEquals(1, contents.item(4).getCount());
+        assertEquals(-1, state.selectCell(3, layout, slot -> "Native child " + slot));
+        assertNull(state.view(_ -> contents, false).selectedCell());
+        assertEquals(1, contents.item(4).getCount());
+
+        state.selectCell(1, layout, slot -> "Native child " + slot);
+        assertEquals(1, state.view(_ -> contents, false).selectedCell());
+        assertEquals(-1, layout.sourceSlots().get(1));
+        assertEquals(-1, state.selectCell(200, layout, slot -> "Native child " + slot));
+        assertEquals(200, state.view(_ -> contents, false).selectedCell());
+        final var overflowing = snapshot("Inventory bundle", 13);
+        assertEquals(-1, state.selectCell(11, BundleTooltipLayout.resolve(overflowing.contents()), slot -> fail("Overflow has no child details")));
+        assertEquals(11, state.view(_ -> overflowing, false).selectedCell());
+
+        state.hover(HOTBAR, true);
+        assertEquals(-1, state.selectCell(3, layout, slot -> "Native child " + slot));
+        assertEquals(2, view(state).mode());
+        assertFalse(view(state).hidden());
+        assertNull(view(state).selectedCell());
+    }
+
+    @Test
+    void cellSelectionCreatesExclusiveDetailsWithoutClearingThemOnDeselectionOrRetiringAReplacementLate() {
+        final var state = new NativeInventorySourceState();
+        final var contents = snapshot("Inventory bundle", 5);
+        final var layout = BundleTooltipLayout.resolve(contents.contents());
+        state.bundleOpened(INVENTORY);
+        state.selectCell(3, layout, slot -> "§bNative child " + slot + "\n§7Description");
+        final var first = view(state).details().getFirst();
+        assertEquals("popup_tip_text", first.name());
+        assertEquals("§bNative child 4\n§7Description", first.properties().get("#selected_hover_text").getAsString());
+        state.selectCell(3, layout, slot -> fail("Deselection must not format a child"));
+        state.selectCell(1, layout, slot -> fail("Padding has no child"));
+        assertEquals(List.of(first), view(state).details());
+        state.selectCell(4, layout, slot -> "Other native child " + slot);
+        final var second = view(state).details().getFirst();
+        assertNotEquals(first.id(), second.id());
+        assertEquals("Other native child 3", second.properties().get("#selected_hover_text").getAsString());
+        final long revision = state.revision();
+        assertFalse(state.retireDetails(first.id()));
+        assertEquals(revision, state.revision());
+        state.hover(HOTBAR, true);
+        state.leave(HOTBAR);
+        assertEquals(0, view(state).mode());
+        assertEquals(List.of(second), view(state).details(), "Source lifetime does not cancel an independently fading popup");
+        assertTrue(state.retireDetails(second.id()));
+        assertTrue(view(state).details().isEmpty());
+    }
+
+    private static BundleTooltipUi.View view(final NativeInventorySourceState state) {
+        return state.view(source -> snapshot(source.equals(INVENTORY) ? "Inventory bundle" : "Hotbar bundle", 5), false);
+    }
+
+    private static NativeInventoryItemPresentation.BundleTooltip snapshot(final String name, final int size) {
+        final List<Integer> counts = IntStream.range(0, size).mapToObj(_ -> 1).toList();
+        final var contents = new NativeBundleTooltipData(42, 12, counts, name, "Empty");
+        return new NativeInventoryItemPresentation.BundleTooltip(contents, new NativeItemStorageData(4, size, 64),
+            IntStream.range(0, size).mapToObj(slot -> "child " + slot).toList(),
+            IntStream.range(0, size).mapToObj(_ -> new ItemStack(Items.IRON_INGOT)).toList());
+    }
+}
