diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockPlayerInventory.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockPlayerInventory.java
new file mode 100644
index 0000000..6f7e980
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockPlayerInventory.java
@@ -0,0 +1,144 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.gui.screens.inventory.CreativeModeInventoryScreen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InteractPacketPayload_Action;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerInventoryScreenTracker;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Owns requested and installed player inventory screens on direct and ViaProxy connections. */
+final class BedrockPlayerInventory {
+    private static final PlayerInventoryScreenLifecycle<ClientPacketListener, Screen, AbstractContainerMenu> SCREENS =
+            new PlayerInventoryScreenLifecycle<>();
+    private static boolean admitting;
+
+    private BedrockPlayerInventory() {}
+
+    static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(PlayerInventoryScreenClosePayload.TYPE, PlayerInventoryScreenClosePayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(PlayerInventoryScreenReadyPayload.TYPE, PlayerInventoryScreenReadyPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(PlayerInventoryScreenRequestPayload.TYPE, PlayerInventoryScreenRequestPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(PlayerInventoryScreenRequestPayload.DEFERRED_TYPE, PlayerInventoryScreenRequestPayload.DEFERRED_CODEC);
+        ClientPlayConnectionEvents.INIT.register((owner, client) -> {
+            SCREENS.begin(owner);
+            ClientPlayNetworking.registerReceiver(PlayerInventoryScreenClosePayload.TYPE, (payload, context) ->
+                    client.execute(() -> closeInstalled(owner, SCREENS.close(owner, payload.close().opening()))));
+            ClientPlayNetworking.registerReceiver(PlayerInventoryScreenReadyPayload.TYPE, (payload, context) ->
+                    client.execute(() -> ready(owner, payload.ready().opening())));
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((owner, client) -> SCREENS.clear(owner));
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            final var owner = client.getConnection();
+            closeInstalled(owner, SCREENS.capability(owner, SCREENS.pending(owner) ? deferredAvailable() : available()));
+            installed();
+        });
+    }
+
+    static void installed() {
+        final var client = Minecraft.getInstance();
+        final var owner = client.getConnection();
+        if (owner == null || client.player == null) return;
+        final var displayed = client.gui.screen();
+        final var menu = client.player.inventoryMenu;
+        if (displayed == null && SCREENS.pending(owner) && SCREENS.opening(owner, menu) != 0) return;
+        final boolean playerInventory = displayed instanceof AbstractContainerScreen<?> container
+                && (container.getMenu() == menu && client.player.containerMenu == menu
+                    || displayed instanceof CreativeModeInventoryScreen && client.player.containerMenu == container.getMenu());
+        SCREENS.installed(owner, playerInventory ? displayed : null, playerInventory ? menu : null,
+                playerInventory && (admitting || BedrockNativeContainers.replacing(menu)), available(),
+                BedrockPlayerInventory::send, BedrockPlayerInventory::legacyOpen);
+    }
+
+    static boolean admit(final Screen screen) {
+        final var client = Minecraft.getInstance();
+        final var owner = client.getConnection();
+        if (owner == null || client.player == null) return true;
+        final var menu = client.player.inventoryMenu;
+        final boolean playerInventory = screen instanceof AbstractContainerScreen<?> container
+                && (container.getMenu() == menu || screen instanceof CreativeModeInventoryScreen);
+        if (SCREENS.pending(owner)) {
+            // Native repeats the interaction while retaining the same pending screen intent.
+            if (playerInventory) {
+                SCREENS.request(owner, screen, menu, BedrockPlayerInventory::send);
+                return false;
+            }
+            SCREENS.installed(owner, null, null, false, available(), BedrockPlayerInventory::send, () -> {});
+        }
+        if (playerInventory && client.gui.screen() == null && deferredAvailable()
+                && SCREENS.opening(owner, menu) == 0 && !BedrockNativeContainers.replacing(menu)) {
+            SCREENS.request(owner, screen, menu, BedrockPlayerInventory::send);
+            return false;
+        }
+        return true;
+    }
+
+    static Screen pendingScreen(final ClientPacketListener owner) { return SCREENS.pendingScreen(owner); }
+
+    static void ready(final ClientPacketListener owner, final long opening) {
+        final var client = Minecraft.getInstance();
+        if (client.getConnection() != owner || client.player == null || client.gui.screen() != null
+                || SCREENS.opening(owner, client.player.inventoryMenu) != opening) return;
+        final var screen = SCREENS.ready(owner, opening);
+        if (screen == null) return;
+        // InventoryScreen can redirect to Creative during init before setScreen returns.
+        admitting = true;
+        try { client.gui.setScreen(screen); }
+        finally { admitting = false; }
+    }
+
+    private static void send(final PlayerInventoryScreenRequest request) {
+        ClientPlayNetworking.send(new PlayerInventoryScreenRequestPayload(request, deferredAvailable()));
+    }
+
+    static long opening(final ClientPacketListener owner, final AbstractContainerMenu menu) {
+        return SCREENS.opening(owner, menu);
+    }
+
+    private static boolean available() {
+        return ClientPlayNetworking.canSend(PlayerInventoryScreenRequestPayload.TYPE);
+    }
+
+    private static boolean deferredAvailable() {
+        return ClientPlayNetworking.canSend(PlayerInventoryScreenRequestPayload.DEFERRED_TYPE);
+    }
+
+    private static void closeInstalled(final ClientPacketListener owner, final Screen screen) {
+        final var client = Minecraft.getInstance();
+        if (screen != null && client.getConnection() == owner && client.player != null && client.gui.screen() == screen)
+            client.player.closeContainer();
+    }
+
+    private static void legacyOpen() {
+        if (!ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST)) return;
+        final var user = ViaFabricPlus.api().userConnection();
+        if (user == null || user.get(EntityTracker.class) == null) return;
+        final var screens = user.get(PlayerInventoryScreenTracker.class);
+        if (screens != null && screens.ownsClose()) return;
+        final var packet = PacketWrapper.create(ServerboundBedrockPackets.INTERACT, user);
+        packet.write(Types.UNSIGNED_BYTE, (short) InteractPacketPayload_Action.OpenInventory.getValue());
+        packet.write(BedrockTypes.UNSIGNED_VAR_LONG, user.get(EntityTracker.class).getClientPlayer().runtimeId());
+        packet.write(BedrockTypes.OPTIONAL_POSITION_3F, null);
+        packet.sendToServer(BedrockProtocol.class);
+    }
+}
