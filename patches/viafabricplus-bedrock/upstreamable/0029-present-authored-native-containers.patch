diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPreferenceControl.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPreferenceControl.java
new file mode 100644
index 0000000..ab23f11
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPreferenceControl.java
@@ -0,0 +1,97 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+import java.util.Set;
+
+/** Authored toggle events select native tabs or publish their new filtering state. */
+record NativeCookingPreferenceControl(Kind kind, int index, boolean checked) {
+    private static final Set<String> MAPPING_FIELDS =
+            Set.of("from_button_id", "to_button_id", "mapping_type", "ignored", "consume_event");
+
+    static NativeCookingPreferenceControl parse(final NativeUiScene.Node node) {
+        if (!node.type().equals("toggle")) return null;
+        final var state = node.properties().get("toggle_state");
+        if (state == null
+                || !state.isJsonPrimitive()
+                || !state.getAsJsonPrimitive().isBoolean()
+                || !node.properties().has("button_mappings")
+                || node.properties().has("inventory_slot")
+                || node.properties().has("inventory_actions")
+                || node.properties().has("recipe_actions")
+                || node.properties().has("inventory_command"))
+            throw new IllegalArgumentException("Unbound native cooking preference");
+        final Kind kind =
+                switch (node.string("toggle_name", "")) {
+                    case "navigation_tab" -> Kind.TAB;
+                    case "toggle.enable_filtering" -> Kind.FILTER;
+                    default ->
+                            throw new IllegalArgumentException(
+                                    "Unsupported native cooking toggle group");
+                };
+        final int index;
+        if (kind == Kind.TAB) {
+            final var value = node.properties().get("toggle_group_forced_index");
+            if (value == null
+                    || !value.isJsonPrimitive()
+                    || !value.getAsJsonPrimitive().isNumber()
+                    || !value.getAsString().matches("[1-5]"))
+                throw new IllegalArgumentException("Native tab has no authored selection index");
+            index = value.getAsInt();
+        } else index = -1;
+        boolean pointer = false;
+        for (final var entry : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = entry.getAsJsonObject();
+            for (final String flag : Set.of("ignored", "consume_event")) {
+                if (mapping.has(flag)
+                        && (!mapping.get(flag).isJsonPrimitive()
+                                || !mapping.get(flag).getAsJsonPrimitive().isBoolean()))
+                    throw new IllegalArgumentException("Invalid native preference mapping state");
+            }
+            if (mapping.has("ignored") && mapping.get("ignored").getAsBoolean()) continue;
+            if (!MAPPING_FIELDS.containsAll(mapping.keySet())
+                    || !"button.menu_select"
+                            .equals(NativeUiScene.string(mapping, "from_button_id", ""))
+                    || !"button.menu_select"
+                            .equals(NativeUiScene.string(mapping, "to_button_id", ""))
+                    || !"pressed".equals(NativeUiScene.string(mapping, "mapping_type", ""))
+                    || mapping.has("consume_event") && !mapping.get("consume_event").getAsBoolean())
+                throw new IllegalArgumentException("Unsupported native preference input");
+            pointer = true;
+        }
+        if (!pointer) throw new IllegalArgumentException("Native preference has no pointer input");
+        return new NativeCookingPreferenceControl(kind, index, state.getAsBoolean());
+    }
+
+    FurnaceOptions options(final CookingUi.Family family, final CookingUi.Book book) {
+        final int type =
+                switch (family) {
+                    case FURNACE -> 1;
+                    case BLAST_FURNACE -> 2;
+                    case SMOKER -> 3;
+                };
+        final boolean expected =
+                this.kind == Kind.TAB ? book.tab() == this.index : book.filtering();
+        if (this.checked != expected)
+            throw new IllegalArgumentException(
+                    "Native preference differs from its cooking snapshot");
+        return new FurnaceOptions(
+                type,
+                this.kind == Kind.TAB ? this.index : book.tab(),
+                this.kind == Kind.FILTER ? !this.checked : book.filtering(),
+                book.effectiveLayout());
+    }
+
+    enum Kind {
+        TAB,
+        FILTER
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentation.java
new file mode 100644
index 0000000..bf52b6c
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentation.java
@@ -0,0 +1,112 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Authority and progress stay server-owned; genuine client stacks supply rendering and hover data. */
+final class NativeCookingPresentation implements NativeInventoryPresentation {
+    private final NativeCookingActions actions;
+    private NativeCookingMessage message;
+    private CookingUi program;
+    private CookingUi.MenuView view;
+    private Map<Integer, ItemStack> recipes;
+    private CookingUi.Progress progress;
+    private long dataRevision = -1;
+    private long revision;
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        this(message, recipes, System::nanoTime);
+    }
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes, final LongSupplier clock) {
+        this.replace(message, recipes);
+        this.actions = new NativeCookingActions(message, clock);
+    }
+
+    boolean update(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence()
+                || message.view().family() != this.view.family()) return false;
+        this.replace(message, recipes);
+        this.actions.update(message);
+        return true;
+    }
+
+    private void replace(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (!recipes.keySet().equals(message.recipeItems().keySet()) || recipes.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Cooking previews differ from the authoritative catalog");
+        final var program = CookingUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+        final var view = message.view();
+        final Map<Integer, ItemStack> copies = new HashMap<>();
+        recipes.forEach((id, item) -> copies.put(id, item.copy()));
+        this.message = message;
+        this.program = program;
+        this.view = view;
+        this.recipes = Map.copyOf(copies);
+        this.progress = view.progress();
+        this.dataRevision = -1;
+        this.revision++;
+    }
+
+    boolean update(final NativeCookingProgress update) {
+        if (update.menuId() != this.message.menuId() || update.sequence() != this.message.sequence()
+                || update.updateSequence() != this.message.updateSequence() || update.dataRevision() <= this.dataRevision) return false;
+        this.progress = update.progress();
+        this.dataRevision = update.dataRevision();
+        this.revision++;
+        return true;
+    }
+
+    NativeCookingMessage message() { return this.message; }
+
+    boolean idle() { return this.actions.idle(); }
+
+    boolean action(final int recipe, final NativeCookingAction.Mode mode, final int phase, final Consumer<NativeCookingAction> sender) {
+        return this.actions.send(recipe, mode, phase, sender);
+    }
+
+    boolean result(final NativeCookingActionResult result) { return this.actions.result(result); }
+
+    boolean expired() { return this.actions.expired(); }
+
+    void retire() { this.actions.retire(); }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender) { return this.actions.cancel(sender); }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags) {
+        if (menuId != this.message.menuId()) throw new IllegalArgumentException("Cooking view belongs to another menu");
+        final var source = this.view.book();
+        final var catalog = source.catalog().stream().map(recipe -> {
+            final Map<String, JsonElement> values = new HashMap<>(NativeInventoryItemPresentation.values(this.recipes.get(recipe.id()), false, showTags));
+            values.putAll(recipe.presentation());
+            return new CookingUi.Recipe(recipe.id(), recipe.uniqueId(), recipe.priority(), recipe.unlocked(), recipe.outputName(), recipe.evaluation(), values);
+        }).toList();
+        final var book = new CookingUi.Book(source.layout(), source.forcedRecipeBookLayout(), source.tab(), source.filtering(),
+                source.foodCount(), source.itemCount(), source.blockCount(), source.tabLabel(), source.searchText(), source.selection(), catalog, source.visibleRecipes());
+        final var scene = this.program.resolve(new CookingUi.MenuView(menuId, this.view.family(), this.view.title(), slots, cursor, this.progress, book));
+        final var scope = CookingUi.actionScope(scene, book);
+        this.actions.presented(this.message, scope);
+        return new Frame(scene, 3, this.recipes, scope);
+    }
+}
