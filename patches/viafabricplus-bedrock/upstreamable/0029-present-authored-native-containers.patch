+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemOpacity;
+import net.minecraft.client.renderer.state.gui.BlitRenderState;
+
+public final class NativeInventoryItemOpacity {
+    private NativeInventoryItemOpacity() {}
+
+    public static void extract(final IBedrockGuiItemOpacity graphics, final float opacity, final Runnable extraction) {
+        if (!Float.isFinite(opacity) || opacity < 0 || opacity > 1)
+            throw new IllegalArgumentException("Invalid native item opacity");
+        final float previous = graphics.stackanvil$itemOpacity();
+        graphics.stackanvil$itemOpacity(opacity);
+        try { extraction.run(); }
+        finally { graphics.stackanvil$itemOpacity(previous); }
+    }
+
+    /** Cached GUI textures contain premultiplied pixels: attenuate RGB along with alpha. */
+    public static BlitRenderState apply(final BlitRenderState blit, final float opacity) {
+        if (opacity == 1) return blit;
+        final int color = blit.color();
+        int faded = 0;
+        for (int shift = 0; shift < 32; shift += 8)
+            faded |= Math.round(((color >>> shift) & 255) * opacity) << shift;
+        return new BlitRenderState(blit.pipeline(), blit.textureSetup(), blit.pose(),
+                blit.x0(), blit.y0(), blit.x1(), blit.y1(), blit.u0(), blit.u1(), blit.v0(), blit.v1(),
+                faded, blit.scissorArea(), blit.bounds());
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventoryItemPresentation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventoryItemPresentation.java
