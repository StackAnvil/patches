+
+final class NativeInventoryProgressTest {
+    @Test
+    void quantizesDeviceEndpointsAndUsesAuthoredFlagsForShadowAndRounding() {
+        final var box = bar(false, false, false, 3);
+        final var scaled = NativeInventoryProgress.quads(box, 1, 1.5F);
+        assertEquals(2, scaled.size());
