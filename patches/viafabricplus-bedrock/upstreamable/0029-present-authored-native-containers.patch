+    private boolean bundleEvents(final NativeContainerInput.Result result) {
+        boolean handled = false;
+        for (final var event : result.events()) handled |= this.bundleEvent(event);
+        return handled;
+    }
+
+    private boolean bundleEvent(final NativeContainerInput.Event event) {
