+    @Test
+    void closingBeforeReplyRetainsTheLatestEditOrClearForTheNextOpeningOnly() {
+        for (final String latest : new String[]{"stone", ""}) {
+            final var controller = new NativeCookingPresentationController<Object, Object>();
+            final var owner = new Object();
+            final var menu = new Object();
+            final var base = message(CookingUi.Family.FURNACE, 1);
+            final var snapshot = JsonParser.parseString(base.snapshot()).getAsJsonObject();
+            snapshot.getAsJsonObject("book").addProperty("searchText", "iron");
+            final var first = new NativeCookingMessage(base.context(),base.menuId(), base.sequence(), base.updateSequence(), base.menuRevision(),
+                    base.inventoryRevision(), base.cursorRevision(), snapshot.toString(), base.recipeItems());
+            controller.begin(owner);
+            assertTrue(controller.accept(owner, menu, 5, first, _ -> new ItemStack(Items.IRON_INGOT)));
+            final var old = controller.current(owner, menu, 5);
+            old.searchCapability(true);
+            assertTrue(controller.query(owner, menu, 5, "iron"));
+            final var sent = new ArrayList<NativeCookingQuery>();
+            assertTrue(old.flushQuery(sent::add));
+            assertTrue(controller.query(owner, menu, 5, latest));
+            controller.tick(owner, new Object(), 5);
+            assertTrue(old.expired());
+            final var nextMenu = new Object();
+            assertTrue(controller.accept(owner, nextMenu, 5, sequence(first, 4), _ -> new ItemStack(Items.IRON_INGOT)));
+            final var reopened = controller.current(owner, nextMenu, 5);
+            reopened.searchCapability(true);
+            assertEquals(latest, reopened.query());
+            assertTrue(reopened.flushQuery(sent::add));
+            assertEquals(latest, sent.getLast().text());
+            assertEquals(4, sent.getLast().source().sequence());
+            assertEquals(1, sent.getLast().requestSequence());
+            assertFalse(reopened.result(new NativeCookingQueryResult(sent.getFirst(), true)));
+            assertEquals(latest, reopened.query());
+            controller.clear(owner);
+            final var newOwner = new Object();
+            controller.begin(newOwner);
+            final var newMenu = new Object();
+            assertTrue(controller.accept(newOwner, newMenu, 5, base, _ -> new ItemStack(Items.IRON_INGOT)));
+            assertEquals("", controller.current(newOwner, newMenu, 5).query());
+        }
+    }
