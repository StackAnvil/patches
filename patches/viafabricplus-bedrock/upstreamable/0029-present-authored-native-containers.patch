+        presentation.query("o", sent::add);
+        presentation.query("oak", sent::add);
+        assertEquals(1, sent.size());
+        assertEquals("oak", presentation.query());
+        assertTrue(presentation.update(message(false, 1, 8, 2, "o", false), Map.of(), Map.of()));
+        assertFalse(presentation.result(new NativePlayerInventoryResult(2, 0, 1, 2, true)));
+        assertFalse(presentation.idle());
+        assertTrue(presentation.result(new NativePlayerInventoryResult(1, 0, 1, 2, true)));
+        presentation.flush(sent::add);
+        assertEquals(2, sent.size());
+        assertEquals("oak", sent.getLast().query());
+        assertEquals(8, sent.getLast().generation());
+        assertEquals(2, sent.getLast().revision());
+        assertFalse(presentation.update(message(false, 2, 8, 3, "", false), Map.of(), Map.of()));
+        assertFalse(presentation.update(message(false, 1, 9, 3, "", false), Map.of(), Map.of()));
+        clock.set(10_000_000_001L);
+        assertTrue(presentation.expired());
