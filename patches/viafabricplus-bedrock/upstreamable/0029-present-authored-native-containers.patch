--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockNativePlayerInventory.java
@@ -0,0 +1,191 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockInventorySounds;
+import com.viaversion.viafabricplus.bedrock.creative.BedrockCreativeCatalog;
+import java.util.HashMap;
+import java.util.Map;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.gui.screens.inventory.CreativeModeInventoryScreen;
+import net.minecraft.client.gui.screens.inventory.InventoryScreen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.CraftingMenu;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativePlayerInventoryAction;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import net.raphimc.viabedrock.api.model.NativePlayerInventoryMessage;
+import net.raphimc.viabedrock.protocol.model.InventoryOptions;
+
+/** Direct and proxy routes use the same typed snapshots and exact installed-screen owner. */
+final class BedrockNativePlayerInventory {
+    private static ClientPacketListener owner;
+    private static AbstractContainerMenu menu;
+    private static NativePlayerPresentation presentation;
+    private static String retainedQuery;
+    private static AbstractContainerMenu retiredMenu;
+    private static long retiredOpening;
+    private static long retiredGeneration;
+
+    private BedrockNativePlayerInventory() {}
+
+    static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativePlayerInventoryPayload.TYPE, NativePlayerInventoryPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativePlayerInventoryResultPayload.TYPE, NativePlayerInventoryResultPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeBundleResultPayload.TYPE, NativeBundleResultPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(NativePlayerInventoryActionPayload.TYPE, NativePlayerInventoryActionPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(NativePlayerInventoryActionPayload.AUTO_DESTROY_TYPE, NativePlayerInventoryActionPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(NativeBundleActionPayload.TYPE, NativeBundleActionPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            clear();
+            owner = listener;
+            ClientPlayNetworking.registerReceiver(NativePlayerInventoryPayload.TYPE,
+                    (payload, context) -> client.execute(() -> accept(listener, payload.message())));
+            ClientPlayNetworking.registerReceiver(NativePlayerInventoryResultPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (current(listener, menu) && presentation != null && presentation.result(payload.result())) presentation.flush(BedrockNativePlayerInventory::send);
+            }));
+            ClientPlayNetworking.registerReceiver(NativeBundleResultPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (current(listener, menu) && presentation != null && presentation.result(payload.result(), BedrockInventorySounds::play))
+                    presentation.flush(BedrockNativePlayerInventory::send);
+            }));
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> { if (owner == listener) clear(); });
+        ClientTickEvents.END_CLIENT_TICK.register(BedrockNativePlayerInventory::tick);
+    }
+
+    private static void clear() {
+        if (presentation != null) presentation.retire();
+        presentation = null;
+        retainedQuery = null;
+        menu = null;
+        owner = null;
+        retiredMenu = null;
+        retiredOpening = retiredGeneration = 0;
+    }
+
+    private static boolean current(final ClientPacketListener listener, final AbstractContainerMenu expected) {
+        final var client = Minecraft.getInstance();
+        if (owner != listener || listener == null || client.getConnection() != listener || !listener.getConnection().isConnected()
+                || client.player == null || expected == null || menu != expected || !ClientPlayNetworking.canSend(NativePlayerInventoryActionPayload.TYPE)) return false;
+        if (presentation != null && !presentation.state().workbench())
+            return expected == client.player.inventoryMenu && BedrockPlayerInventory.opening(listener, expected) == presentation.message().opening();
+        return client.player.containerMenu == expected;
+    }
+
+    private static void accept(final ClientPacketListener listener, final NativePlayerInventoryMessage message) {
+        if (!BedrockNativeContainers.enabled()) return;
+        final var client = Minecraft.getInstance();
+        if (owner != listener || client.getConnection() != listener || client.player == null) return;
+        final var candidate = client.gui.screen() == null ? BedrockPlayerInventory.pendingScreen(listener) : client.gui.screen();
+        if (!(candidate instanceof AbstractContainerScreen<?> displayed)) return;
+        final var expected = message.state().workbench() ? client.player.containerMenu : client.player.inventoryMenu;
+        if (message.menuId() != expected.containerId || expected.slots.size() != 46
+                || message.state().workbench() && (!(expected instanceof CraftingMenu) || displayed.getMenu() != expected)
+                || !message.state().workbench() && (BedrockPlayerInventory.opening(listener, expected) != message.opening()
+                    || displayed.getMenu() != expected && !(displayed instanceof CreativeModeInventoryScreen))) return;
+        if (expected == retiredMenu && message.opening() == retiredOpening
+                && (retiredOpening != 0 || message.generation() == retiredGeneration)) return;
+        try {
+            final Map<Integer, ItemStack> previews = new HashMap<>();
+            message.items().forEach((id, item) -> previews.put(id, BedrockCreativeCatalog.toNative(item, client.player.registryAccess())));
+            final Map<Integer, ItemStack> craftingPreview = new HashMap<>();
+            message.craftingPreview().forEach((slot, item) -> craftingPreview.put(slot, BedrockCreativeCatalog.toNative(item, client.player.registryAccess())));
+            if (menu == expected && presentation != null && presentation.message().opening() == message.opening()
+                    && (presentation.message().generation() == 0 || presentation.message().generation() == message.generation())) {
+                presentation.update(message, previews, craftingPreview);
+            } else {
+                if (presentation != null) presentation.retire();
+                menu = expected;
+                presentation = new NativePlayerPresentation(message, previews, craftingPreview, System::nanoTime);
+                if (retainedQuery != null) presentation.query(retainedQuery, BedrockNativePlayerInventory::send);
+            }
+        } catch (final RuntimeException unsupported) {
+            ViaFabricPlusBedrock.impl().logger().warn("Unsupported native player inventory presentation", unsupported);
+        }
+    }
+
+    private static void tick(final Minecraft client) {
+        if (!BedrockNativeContainers.enabled()) return;
+        final var active = presentation;
+        if (active == null) return;
+        if (!current(owner, menu) || active.expired()) {
+            retire(active);
+            return;
+        }
+        if (!(client.gui.screen() instanceof AbstractContainerScreen<?> displayed)) return;
+        if (displayed instanceof BedrockNativeContainerScreen nativeScreen && nativeScreen.presents(active)) return;
+        AbstractContainerScreen<?> ordinary = displayed instanceof BedrockNativeContainerScreen nativeScreen ? nativeScreen.original() : displayed;
+        if (!active.state().workbench() && displayed instanceof CreativeModeInventoryScreen) {
+            ordinary = new InventoryScreen(client.player);
+            client.player.containerMenu = menu;
+        }
+        if (ordinary.getMenu() != menu || client.player.containerMenu != menu) return;
+        final var expectedMenu = menu;
+        final var expectedOwner = owner;
+        final var screen = new BedrockNativeContainerScreen(owner, ordinary, client.player.getInventory(), ordinary.getTitle(), active,
+                false, active.message().revision(), System::nanoTime,
+                () -> current(expectedOwner, expectedMenu) && presentation == active);
+        try {
+            screen.prepare(client.font, screen.nativeViewport().width(), screen.nativeViewport().height());
+            BedrockNativeContainers.replace(screen);
+        } catch (final RuntimeException unsupported) {
+            retire(active);
+            BedrockNativeContainers.failedPresentation(screen, unsupported);
+        }
+    }
+
+    static boolean autoDestroyAvailable(final ClientPacketListener listener, final AbstractContainerMenu expected) {
+        return current(listener, expected) && presentation != null && ClientPlayNetworking.canSend(NativePlayerInventoryActionPayload.AUTO_DESTROY_TYPE);
+    }
+
+    static boolean action(final ClientPacketListener listener, final AbstractContainerMenu expected, final int target, final NativePlayerInventoryAction.Kind kind) {
+        return current(listener, expected) && presentation != null
+                && (kind != NativePlayerInventoryAction.Kind.AUTO_DESTROY || ClientPlayNetworking.canSend(NativePlayerInventoryActionPayload.AUTO_DESTROY_TYPE))
+                && presentation.send(kind, target, "", null, BedrockNativePlayerInventory::send);
+    }
+
+    static boolean bundlesAvailable(final ClientPacketListener listener, final AbstractContainerMenu expected) {
+        return current(listener, expected) && presentation != null && ClientPlayNetworking.canSend(NativeBundleActionPayload.TYPE);
+    }
+
+    static boolean bundle(final ClientPacketListener listener, final AbstractContainerMenu expected, final NativeInventorySourceState.Source source,
+                          final NativeBundleAction.Kind kind, final int tooltipMode) {
+        return bundlesAvailable(listener, expected) && presentation.bundle(source.collection(), source.index(), kind, tooltipMode,
+                action -> ClientPlayNetworking.send(new NativeBundleActionPayload(action)));
+    }
+
+    static boolean preferences(final ClientPacketListener listener, final AbstractContainerMenu expected, final InventoryOptions options) {
+        return current(listener, expected) && presentation != null
+                && presentation.send(NativePlayerInventoryAction.Kind.PREFERENCES, -1, "", options, BedrockNativePlayerInventory::send);
+    }
+
+    static void query(final ClientPacketListener listener, final AbstractContainerMenu expected, final String value) {
+        if (current(listener, expected) && presentation != null) {
+            // Local edits outlive a closed menu even when its last command has no reply yet.
+            retainedQuery = value;
+            presentation.query(value, BedrockNativePlayerInventory::send);
+        }
+    }
+
+    static void retire(final NativePlayerPresentation candidate) {
+        candidate.retire();
+        if (presentation == candidate) {
+            retiredMenu = menu;
+            retiredOpening = candidate.message().opening();
+            retiredGeneration = candidate.message().generation();
+            presentation = null;
+        }
+    }
