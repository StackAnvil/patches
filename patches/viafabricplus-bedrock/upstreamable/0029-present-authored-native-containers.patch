+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.List;
+import java.util.Map;
+import net.minecraft.SharedConstants;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class NativeInventoryFlightsTest {
+    @Test
+    void pairsRealLossGainWithoutAnimatingUnmatchedOrUnchangedCounts() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var flights = new NativeInventoryFlights();
+        final var anchors = Map.of(0, new NativeInventoryFlights.Anchor(0, 0, 1),
+            1, new NativeInventoryFlights.Anchor(230, 0, 2), 2, new NativeInventoryFlights.Anchor(100, 40, 1));
+        flights.update(List.of(stack(8), stack(2), ItemStack.EMPTY), List.of(stack(3), stack(4), stack(3)), anchors, 0);
+        final var frames = flights.frames(0);
+        assertEquals(2, frames.size());
+        assertTrue(frames.stream().allMatch(frame -> ItemStack.isSameItemSameComponents(frame.stack(), stack(1))));
+        assertEquals(0, frames.getFirst().x());
+        final var middle = flights.frames(150_000_000);
+        assertEquals(222.8125F, middle.getFirst().x(), .001F);
+        assertEquals(1.96875F, middle.getFirst().scale(), .001F);
+        assertEquals(230, flights.frames(300_000_000).getFirst().x());
+        assertTrue(flights.frames(300_100_000).isEmpty());
+        flights.update(List.of(stack(3), ItemStack.EMPTY), List.of(ItemStack.EMPTY, stack(Items.DIRT, 3)), anchors, 400_000_000);
+        assertTrue(flights.frames(400_000_000).isEmpty());
+        flights.update(List.of(stack(4), stack(1)), List.of(stack(4), stack(1)), anchors, 500_000_000);
+        assertTrue(flights.frames(500_000_000).isEmpty());
+    }
+
+    @Test
+    void swapsUseBothOriginalIdentitiesAndMissingAnchorsPreventFalseMotion() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var flights = new NativeInventoryFlights();
+        final var before = List.of(stack(5), stack(Items.DIRT, 2));
+        final var after = List.of(stack(Items.DIRT, 2), stack(5));
+        flights.update(before, after, Map.of(0, new NativeInventoryFlights.Anchor(10, 20, 1)), 0);
+        assertTrue(flights.frames(0).isEmpty());
+        flights.update(before, after, Map.of(0, new NativeInventoryFlights.Anchor(10, 20, 1),
+            1, new NativeInventoryFlights.Anchor(30, 20, 1)), 1_000_000_000);
+        assertEquals(2, flights.frames(1_000_000_000).size());
+        assertEquals(30, flights.frames(1_150_000_000).getFirst().x());
+        assertEquals(10, flights.frames(1_150_000_000).get(1).x());
+        assertEquals(5, before.getFirst().getCount());
+        assertEquals(2, after.getFirst().getCount());
+    }
+
+    private static ItemStack stack(final int count) { return stack(Items.COBBLESTONE, count); }
+    private static ItemStack stack(final net.minecraft.world.item.Item item, final int count) {
+        // Local actual ItemStack fixture: no datapack default-components bootstrap or global registry mutation.
+        try {
+            final var constructor = ItemStack.class.getDeclaredConstructor(net.minecraft.core.Holder.class, int.class,
+                net.minecraft.core.component.PatchedDataComponentMap.class);
+            constructor.setAccessible(true);
+            return constructor.newInstance(item.builtInRegistryHolder(), count,
+                new net.minecraft.core.component.PatchedDataComponentMap(net.minecraft.core.component.DataComponentMap.EMPTY));
+        } catch (final ReflectiveOperationException error) { throw new AssertionError(error); }
+    }
+}
