+        assertFalse(presentation.idle());
+        assertEquals(1, sounds.size());
+        assertTrue(presentation.result(new NativePlayerInventoryResult(1, 8, 2, 2, true)));
+        assertTrue(presentation.bundle("inventory_items", 4, NativeBundleAction.Kind.SECONDARY, 2, ignored -> {}));
+        final var extraction = new NativeBundleResult(new NativePlayerInventoryResult(1, 8, 3, 2, true), NativeBundleResult.Sound.REMOVE_ONE);
+        assertTrue(presentation.result(extraction, sounds::add));
+        assertEquals(List.of(NativeBundleResult.Sound.INSERT_FAIL, NativeBundleResult.Sound.REMOVE_ONE), sounds);
+        assertTrue(presentation.bundle("inventory_items", 4, NativeBundleAction.Kind.SECONDARY, 2, ignored -> {}));
+        assertTrue(presentation.result(new NativeBundleResult(new NativePlayerInventoryResult(1, 8, 4, 2, false),
+                NativeBundleResult.Sound.NONE), sounds::add));
