+    private static List<ContainerUi.Slot> slots() {
+        return IntStream.range(0, 39).mapToObj(slot -> new ContainerUi.Slot(slot,
+                Map.of("#inventory_stack_count", new JsonPrimitive(slot == 0 ? 2 : 0)))).toList();
+    }
