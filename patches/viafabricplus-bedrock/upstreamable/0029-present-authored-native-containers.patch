+            player.containerMenu = menu;
+            final var ordinary = mock(AbstractContainerScreen.class);
+            when(ordinary.getMenu()).thenReturn(menu);
+            final var game = mock(Minecraft.class);
+            when(game.getLastInputType()).thenReturn(InputType.MOUSE);
+            when(game.getNarrator()).thenReturn(mock(GameNarrator.class));
+            game.player = player;
