+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeContainerMessage;
+
+public record NativeContainerPayload(NativeContainerMessage message) implements CustomPacketPayload {
+    public static final Type<NativeContainerPayload> TYPE = new Type<>(Identifier.parse(NativeContainerMessage.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeContainerPayload> CODEC = CustomPacketPayload.codec(
