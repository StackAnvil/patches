+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PlayerInventoryScreenLifecycleTest {
+    @Test
+    void pendingInventoryRepeatsItsInteractionAndAdmitsOnlyItsAcknowledgement() {
+        final var f = new Fixture();
+        final var intended = new Object();
+        f.screens.request(f.owner, intended, f.menu, f.sent::add);
+        f.screens.request(f.owner, new Object(), f.menu, f.sent::add);
+        assertTrue(f.screens.pending(f.owner));
+        assertSame(intended, f.screens.pendingScreen(f.owner));
+        assertNull(f.screens.ready(f.owner, 2));
+        assertEquals(List.of(new PlayerInventoryScreenRequest(1, true), new PlayerInventoryScreenRequest(1, true)), f.sent);
+        assertSame(intended, f.screens.ready(f.owner, 1));
+        f.install(intended, false, true);
+        assertFalse(f.screens.pending(f.owner));
+        assertNull(f.screens.ready(f.owner, 1));
+        assertEquals(2, f.sent.size());
+    }
+
+    @Test
+    void anotherScreenCancelsThePendingInventoryAndLateAcknowledgementCannotAdmitIt() {
+        final var f = new Fixture();
+        f.screens.request(f.owner, new Object(), f.menu, f.sent::add);
+        f.install(null, false, true);
+        assertNull(f.screens.ready(f.owner, 1));
+        assertNull(f.screens.pendingScreen(f.owner));
+        assertEquals(List.of(new PlayerInventoryScreenRequest(1, true), new PlayerInventoryScreenRequest(1, false)), f.sent);
+        final var next = new Object();
+        f.screens.request(f.owner, next, f.menu, f.sent::add);
+        assertNull(f.screens.ready(f.owner, 1));
+        assertSame(next, f.screens.ready(f.owner, 2));
+    }
+
+    @Test
+    void capabilityWithdrawalAndNewConnectionDiscardPendingAdmission() {
+        final var f = new Fixture();
+        f.screens.request(f.owner, new Object(), f.menu, f.sent::add);
+        f.screens.capability(f.owner, false);
+        assertFalse(f.screens.pending(f.owner));
+        assertNull(f.screens.ready(f.owner, 1));
+        f.screens.request(f.owner, new Object(), f.menu, f.sent::add);
+        f.screens.begin(new Object());
+        assertNull(f.screens.ready(f.owner, 2));
+        assertFalse(f.screens.pending(f.owner));
+    }
+
+    @Test
+    void ordinaryReopenGetsANewIdentityEvenWithTheSamePersistentMenu() {
+        final var f = new Fixture();
+        final var first = new Object();
+        final var second = new Object();
+        f.install(first, false, true);
+        f.install(first, false, true);
+        f.install(second, false, true);
+        assertEquals(List.of(new PlayerInventoryScreenRequest(1, true), new PlayerInventoryScreenRequest(1, false),
+                new PlayerInventoryScreenRequest(2, true)), f.sent);
+        assertNull(f.screens.close(f.owner, 1));
+        assertSame(second, f.screens.close(f.owner, 2));
+    }
+
+    @Test
+    void genuinePresentationReplacementRetainsItsOpeningAndClosesExactlyOnce() {
+        final var f = new Fixture();
+        final var ordinary = new Object();
+        final var authored = new Object();
+        f.install(ordinary, false, true);
+        f.install(authored, true, true);
+        assertEquals(List.of(new PlayerInventoryScreenRequest(1, true)), f.sent);
+        assertSame(authored, f.screens.close(f.owner, 1));
+        f.install(null, false, true);
+        assertEquals(1, f.sent.size());
+    }
+
+    @Test
+    void lateCapabilityDoesNotDuplicateALegacyOpeningAndAppliesToTheNextScreen() {
+        final var f = new Fixture();
+        final var legacy = new Object();
+        f.install(legacy, false, false);
+        f.install(legacy, false, true);
+        assertEquals(1, f.legacyOpens);
+        assertTrue(f.sent.isEmpty());
+        assertNull(f.screens.close(f.owner, 1));
+        f.install(null, false, true);
+        f.install(new Object(), false, true);
+        assertEquals(List.of(new PlayerInventoryScreenRequest(2, true)), f.sent);
+    }
+
+    @Test
+    void disconnectAndOldConnectionCallbacksNeverCloseANewConnectionsScreen() {
+        final var f = new Fixture();
+        f.install(new Object(), false, true);
+        final var nextOwner = new Object();
+        f.screens.begin(nextOwner);
+        final var current = new Object();
+        f.screens.installed(nextOwner, current, f.menu, false, true, f.sent::add, () -> fail());
+        f.screens.clear(f.owner);
+        assertNull(f.screens.close(f.owner, 1));
+        assertSame(current, f.screens.close(nextOwner, 2));
+    }
+
+    @Test
+    void capabilityWithdrawalRetiresOnlyABridgedScreen() {
+        final var f = new Fixture();
+        final var current = new Object();
+        f.install(current, false, true);
+        assertSame(current, f.screens.capability(f.owner, false));
+        assertNull(f.screens.capability(f.owner, false));
+        f.install(new Object(), false, false);
+        assertNull(f.screens.capability(f.owner, false));
+        assertEquals(1, f.legacyOpens);
+    }
+
+    private static final class Fixture {
+        private final Object owner = new Object();
+        private final Object menu = new Object();
+        private final PlayerInventoryScreenLifecycle<Object, Object, Object> screens = new PlayerInventoryScreenLifecycle<>();
+        private final List<PlayerInventoryScreenRequest> sent = new ArrayList<>();
+        private int legacyOpens;
+
+        private Fixture() { this.screens.begin(this.owner); }
+
+        private void install(final Object screen, final boolean replacing, final boolean available) {
+            this.screens.installed(this.owner, screen, screen == null ? null : this.menu, replacing, available,
+                    this.sent::add, () -> this.legacyOpens++);
+        }
+    }
+}
