+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiAnimations;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import java.util.List;
+
+/** Retains painter traversal until layout, component state, pointer or opacity changes. */
+final class NativeContainerDraws {
+    private NativeUiLayout.Box root;
+    private double pointerX, pointerY;
+    private long inputRevision, opacityRevision;
+    private List<NativeUiPresentation.Draw> draws = List.of();
+
+    List<NativeUiPresentation.Draw> update(final NativeUiLayout.Box root, final double pointerX,
+            final double pointerY, final NativeUiAnimations animations, final NativeContainerInput input, final long now) {
+        final long inputRevision = input.visualRevision();
+        if (this.root != root || this.pointerX != pointerX || this.pointerY != pointerY
+                || this.inputRevision != inputRevision || this.opacityRevision != animations.opacityRevision()) {
+            this.draws = NativeUiPresentation.draws(root, box -> box.visibleBounds().contains(pointerX, pointerY),
+                    node -> animations.opacityAt(node, now), input::hasButtonState);
+            this.root = root;
+            this.pointerX = pointerX;
+            this.pointerY = pointerY;
+            this.inputRevision = inputRevision;
+            // First-render tracks can start while collecting this frame.
+            this.opacityRevision = animations.opacityRevision();
+        }
+        return this.draws;
+    }
+}
