@@ -0,0 +1,98 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.function.Consumer;
+import net.raphimc.viabedrock.api.model.PlayerInventoryScreenRequest;
+
+/** Opening ownership survives presentation swaps, but never an ordinary reopen of menu zero. */
+final class PlayerInventoryScreenLifecycle<O, S, M> {
+    private O owner;
+    private S screen;
+    private M menu;
+    private long sequence;
+    private long opening;
+    private boolean bridged;
+    private boolean pending;
+
+    void begin(final O owner) {
+        this.owner = owner;
+        this.screen = null;
+        this.menu = null;
+        // Reconfiguration replaces the play listener while the native connection survives.
+        // Keep tokens monotonic across listener replacement and physical reconnects.
+        this.opening = 0;
+        this.bridged = false;
+        this.pending = false;
+    }
+
+    void installed(final O owner, final S screen, final M menu, final boolean replacing,
+                   final boolean available, final Consumer<PlayerInventoryScreenRequest> send, final Runnable legacyOpen) {
+        if (owner == null || owner != this.owner || this.screen == screen && this.menu == menu) return;
+        if (replacing && this.screen != null && screen != null && this.menu == menu) {
+            this.screen = screen;
+            return;
+        }
+        final long previous = this.opening;
+        final boolean close = this.screen != null && this.bridged && available;
+        this.screen = null;
+        this.menu = null;
+        this.opening = 0;
+        this.bridged = false;
+        this.pending = false;
+        if (close) send.accept(new PlayerInventoryScreenRequest(previous, false));
+        if (screen == null) return;
+        this.screen = screen;
+        this.menu = menu;
+        this.opening = this.sequence = Math.incrementExact(this.sequence);
+        this.bridged = available;
+        if (available) send.accept(new PlayerInventoryScreenRequest(this.opening, true));
+        else legacyOpen.run();
+    }
+
+    S close(final O owner, final long opening) {
+        if (owner != this.owner || !this.bridged || opening != this.opening) return null;
+        final S screen = this.screen;
+        this.screen = null;
+        this.menu = null;
+        this.opening = 0;
+        this.bridged = false;
+        this.pending = false;
+        return screen;
+    }
+
+    void request(final O owner, final S screen, final M menu, final Consumer<PlayerInventoryScreenRequest> send) {
+        if (owner != this.owner) return;
+        if (this.pending) {
+            send.accept(new PlayerInventoryScreenRequest(this.opening, true));
+            return;
+        }
+        this.installed(owner, screen, menu, false, true, send, () -> {});
+        this.pending = true;
+    }
+
+    boolean pending(final O owner) { return owner == this.owner && this.pending; }
+
+    S pendingScreen(final O owner) { return this.pending(owner) ? this.screen : null; }
+
+    S ready(final O owner, final long opening) {
+        if (!this.pending(owner) || !this.bridged || opening != this.opening) return null;
+        this.pending = false;
+        return this.screen;
+    }
+
+    S capability(final O owner, final boolean available) {
+        return !available && this.bridged ? this.close(owner, this.opening) : null;
+    }
+
+    long opening(final O owner, final M menu) {
+        return owner == this.owner && menu == this.menu && this.bridged ? this.opening : 0;
+    }
+
+    void clear(final O owner) {
+        if (owner == this.owner) this.begin(null);
+    }
+}
