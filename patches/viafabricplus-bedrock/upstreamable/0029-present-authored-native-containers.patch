diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingHold.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingHold.java
new file mode 100644
index 0000000000000000000000000000000000000000..8a18950acbcb13c309598f7a8ce0a98eb0ec080b
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingHold.java
@@ -0,0 +1,166 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiHold;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+import java.util.function.Consumer;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldAction;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** One ordinary pickup retains its source while desktop quantity selection and replies advance. */
+final class NativeCookingHold {
+    private static final long TIMEOUT = 10_000_000_000L;
+    private final NativeUiHold view;
+    private int button = -1, slot = -1;
+    private ItemStack item = ItemStack.EMPTY;
+    private long pickupUpdate, pressedAt;
+    private int enteredMillis, elapsedMillis;
+    private float x, y;
+    private boolean selecting, finished, started, completed;
+    private boolean returnHeld;
+    private int completion;
+    private long completionUpdate;
+
+    NativeCookingHold(final long now) { this.view = new NativeUiHold(now); }
+
+    boolean busy() { return this.slot >= 0; }
+    int slot() { return this.slot; }
+    boolean selecting() { return this.busy() && this.selecting && !this.finished; }
+    boolean owns(final int button) { return this.busy() && this.button == button; }
+    boolean inside(final NativeContainerGeometry geometry) { return this.busy() && geometry.contains(this.slot, this.x, this.y); }
+
+    void pickup(final int button, final int slot, final ItemStack item, final long update,
+                final long now, final double x, final double y) {
+        if (this.busy() || slot < 0 || item.isEmpty() || item.getCount() > 255)
+            throw new IllegalArgumentException("Native hold requires one admitted pickup");
+        this.button = button;
+        this.slot = slot;
+        this.item = item.copy();
+        this.pickupUpdate = update;
+        this.pressedAt = now;
+        this.pointer(x, y, true);
+        this.view.result(2, this.x, this.y);
+    }
+
+    static boolean returnTarget(final int target) { return target == NativeUiInput.symbol("button.return"); }
+
+    /** The native Return edge also supplies the keyboard branch of held quantity input. */
+    void returnInput(final NativeUiInput.ButtonEvent input) {
+        // Native edge filters are independent of the mode-specific activation flag.
+        if (input.phase() == 1 && input.previous() != 1) this.returnHeld = true;
+        else if (input.phase() == 0 && input.previous() == 1) {
+            this.returnHeld = false;
+            if (this.owns(InputConstants.KEY_RETURN)) this.release(InputConstants.KEY_RETURN, true);
+        }
+    }
+
+    boolean pickupReturn(final int slot, final ItemStack item, final long update, final long now,
+                         final double x, final double y) {
+        if (!this.returnHeld) return false;
+        this.pickup(InputConstants.KEY_RETURN, slot, item, update, now, x, y);
+        return true;
+    }
+
+    void pointer(final double x, final double y, final boolean inside) {
+        this.x = (float) x;
+        this.y = (float) y;
+        if (this.selecting() && !inside) this.finish();
+    }
+
+    boolean release(final int button, final boolean completionDelivered) {
+        if (!this.owns(button) && !(this.selecting() && completionDelivered)) return false;
+        if (this.selecting) this.finish();
+        else this.clear();
+        return true;
+    }
+
+    void reset() {
+        if (this.selecting) this.finish();
+        else this.clear();
+    }
+
+    boolean frame(final long now, final boolean inside, final ItemStack cursor,
+                  final NativeCookingPresentation presentation, final Consumer<NativeCookingHoldAction> sender) {
+        final var before = this.quantity();
+        final var event = this.view.frame(now, this.x, this.y);
+        if (!this.busy()) return false;
+        if (!presentation.holdsAvailable()) { this.clear(); return true; }
+        if (now - this.pressedAt >= TIMEOUT && !this.started) { this.clear(); return true; }
+        if (this.started && !presentation.holding()) {
+            // Phase admission is independent of the subsequent authoritative inventory reply.
+            if (!presentation.holdPending() && (presentation.holdRejected() || !this.completed
+                    || presentation.message().updateSequence() > this.completionUpdate)) { this.clear(); return true; }
+            return !before.equals(this.quantity());
+        }
+        if (!this.started && presentation.message().updateSequence() > this.pickupUpdate && !ItemStack.matches(cursor, this.item)) {
+            this.clear();
+            return true;
+        }
+        if (!this.selecting && event != null && !event.moved() && inside && ItemStack.matches(cursor, this.item)) {
+            this.selecting = true;
+            this.enteredMillis = (int) (now / 1_000_000L);
+            this.elapsedMillis = 0;
+        }
+        if (this.selecting() && !inside) this.finish();
+        if (this.selecting())
+            this.elapsedMillis = (int) (now / 1_000_000L) - this.enteredMillis;
+        this.flush(presentation, cursor, sender);
+        return !before.equals(this.quantity());
+    }
+
+    void flush(final NativeCookingPresentation presentation, final ItemStack cursor,
+               final Consumer<NativeCookingHoldAction> sender) {
+        if (!this.busy() || !this.selecting) return;
+        if (!this.started && presentation.message().updateSequence() > this.pickupUpdate
+                && ItemStack.matches(cursor, this.item)) {
+            this.started = presentation.hold(this.slot, NativeCookingHoldAction.Phase.START, 0, sender);
+        }
+        if (this.started && this.finished && !this.completed) {
+            this.completionUpdate = presentation.message().updateSequence();
+            this.completed = presentation.hold(this.slot, NativeCookingHoldAction.Phase.COMPLETE, this.completion, sender);
+        }
+    }
+
+    private void finish() {
+        if (this.finished) return;
+        this.completion = this.selectedCount();
+        this.finished = true;
+        this.view.result(4, this.x, this.y);
+    }
+
+    private int selectedCount() {
+        return (int) ((this.item.getCount() - 1) * Math.min(this.elapsedMillis / 1000F, 1F)) + 1;
+    }
+
+    CookingUi.QuantitySelection quantity() {
+        return this.selecting() ? new CookingUi.QuantitySelection(this.item.getCount(), this.selectedCount())
+                : CookingUi.QuantitySelection.inactive();
+    }
+
+    ItemStack preview(final int slot, final ItemStack actual) {
+        if (!this.busy() || !this.selecting || this.slot != slot) return actual;
+        return this.item.copyWithCount(this.finished ? this.item.getCount() - this.completion : this.item.getCount());
+    }
+
+    ItemStack cursor(final ItemStack actual) {
+        if (!this.busy() || !this.selecting) return actual;
+        return this.finished ? this.item.copyWithCount(this.completion) : ItemStack.EMPTY;
+    }
+
+    boolean previewsCursor() { return this.busy() && this.selecting; }
+
+    void clear() {
+        this.view.result(4, this.x, this.y);
+        this.button = -1;
+        this.slot = -1;
+        this.item = ItemStack.EMPTY;
+        this.selecting = this.finished = this.started = this.completed = false;
+        this.elapsedMillis = 0;
+    }
+}
