+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Different native menu controllers share one renderer and the genuine Java inventory event path. */
+sealed interface NativeInventoryPresentation permits NativeContainerPresentation, NativeCookingPresentation {
+    Frame resolve(int menuId, String title, List<ContainerUi.Slot> slots, Map<String, JsonElement> cursor, Boolean showTags);
+
+    long revision();
+
+    record Frame(JsonObject scene, int containerSlots, Map<Integer, ItemStack> recipes, CookingUi.RecipeActionScope recipeActions) {
+        public Frame {
+            if (scene == null || containerSlots < 0) throw new IllegalArgumentException("Invalid native inventory frame");
+            recipes = Map.copyOf(recipes);
+            Objects.requireNonNull(recipeActions);
+        }
+    }
+}
