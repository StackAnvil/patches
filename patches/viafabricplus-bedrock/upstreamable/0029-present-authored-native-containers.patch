+                        this.playerSlotAction(node.properties().get("inventory_slot").getAsInt(), button.target());
+                    }
+                }
+                handled = true;
+            } else if (node.properties().has("recipe_id")) {
+                final int recipe = node.properties().get("recipe_id").getAsInt();
