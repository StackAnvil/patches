+
+/** Capability marker. Input uses the ordered Java quick-craft phases. */
+public record NativeInventoryDragPayload() implements CustomPacketPayload {
+    public static final Type<NativeInventoryDragPayload> TYPE = new Type<>(Identifier.parse(Container.INCREMENTAL_DRAG_CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeInventoryDragPayload> CODEC = CustomPacketPayload.codec(
