+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.llamalad7.mixinextras.sugar.Local;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemOpacity;
+import com.viaversion.viafabricplus.bedrock.screen.container.NativeInventoryItemOpacity;
+import net.minecraft.client.gui.render.GuiRenderer;
+import net.minecraft.client.renderer.state.gui.BlitRenderState;
+import net.minecraft.client.renderer.state.gui.GuiItemRenderState;
+import net.minecraft.client.renderer.state.gui.GuiRenderState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(GuiRenderer.class)
+public abstract class MixinNativeGuiItemAtlas {
+    @WrapOperation(method = "submitBlitFromItemAtlas", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/client/renderer/state/gui/GuiRenderState;addBlitToCurrentLayer(Lnet/minecraft/client/renderer/state/gui/BlitRenderState;)V"))
+    private void fadeItem(final GuiRenderState gui, final BlitRenderState blit, final Operation<Void> original,
+                          @Local(argsOnly = true) final GuiItemRenderState item) {
+        original.call(gui, NativeInventoryItemOpacity.apply(blit, ((IBedrockGuiItemOpacity) (Object) item).stackanvil$itemOpacity()));
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinNativeGuiItemExtraction.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinNativeGuiItemExtraction.java
