+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BedrockInventorySoundsTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void bodyCenterKeepsNativeFloatRoundingAtLargePositiveAndNegativeCoordinates() {
+        // Original 1.26.60.5 helper140ba2af0(mode1) outputs these centers.
+        assertEquals(new Vec3(16777216, 0, 0), BedrockInventorySounds.center(new AABB(16777216, -1, -1, 16777218, 1, 1)));
+        assertEquals(new Vec3(-16777216, 0, 0), BedrockInventorySounds.center(new AABB(-16777218, -1, -1, -16777216, 1, 1)));
+    }
+
+    @Test
+    void dispatchesAtTheNativeBodyCenterThroughCurrentLevelResourcesAndSkipsMissingActors() throws Exception {
+        final var minecraft = mock(Minecraft.class);
+        final var player = mock(LocalPlayer.class);
+        Minecraft.class.getDeclaredField("player").set(minecraft, player);
+        when(player.getBoundingBox()).thenReturn(new AABB(11.25, -35.5, 4093.125, 13.25, -31.5, 4099.125));
+        final var library = BedrockResourceLibrary.withServerPacks(null, List.of(Map.of(
+                "sounds.json", """
+                        {"individual_event_sounds":{"events":{"bundle.insert":{
+                          "sound":"test:bundle","volume":0.25,"pitch":1.2}}}}
+                        """.getBytes(StandardCharsets.UTF_8),
+                "sounds/sound_definitions.json", """
+                        {"format_version":"1.14.0","sound_definitions":{"test:bundle":{
+                          "category":"player","subtitle":"subtitles.test.bundle","sounds":["sounds/missing"]}}}
+                        """.getBytes(StandardCharsets.UTF_8))));
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var resources = mockStatic(BedrockServerResources.class);
+             final var playback = mockStatic(BedrockSoundPlayback.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(minecraft);
+            resources.when(BedrockServerResources::library).thenReturn(library);
+            BedrockInventorySounds.play(NativeBundleResult.Sound.INSERT);
+            playback.verify(() -> BedrockSoundPlayback.playLevel(library, "bundle.insert", new Vec3(12.25, -33.5, 4096.125)));
+            final var selected = library.levelSound("bundle.insert", new Random(1));
+            assertEquals(new BedrockResourceLibrary.LevelSound("test:bundle", .25F, 1.2F), selected);
+            assertEquals("subtitles.test.bundle", library.soundDefinition(selected.name()).subtitle());
+            BedrockInventorySounds.play(NativeBundleResult.Sound.NONE);
+            Minecraft.class.getDeclaredField("player").set(minecraft, null);
+            BedrockInventorySounds.play(NativeBundleResult.Sound.INSERT);
+            resources.verify(BedrockServerResources::library, times(1));
+            playback.verifyNoMoreInteractions();
+        }
+    }
+}
