--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativePlayerPresentation.java
@@ -0,0 +1,250 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativePlayerInventoryAction;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import net.raphimc.viabedrock.api.model.NativeBundleResult;
+import net.raphimc.viabedrock.api.model.NativePlayerInventoryMessage;
+import net.raphimc.viabedrock.api.model.NativePlayerInventoryResult;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.PlayerInventoryUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.UiBindings;
+import net.raphimc.viabedrock.protocol.model.InventoryOptions;
+
+/** One installed menu retains its actual catalog and serializes edits against acknowledged snapshots. */
+final class NativePlayerPresentation implements NativeInventoryPresentation {
+    private final LongSupplier clock;
+    private NativePlayerInventoryMessage message;
+    private PlayerInventoryUi program;
+    private PlayerInventoryUi.State state;
+    private Map<Integer, ItemStack> previews;
+    private Map<Integer, ItemStack> craftingPreview;
+    private Map<String, UiBindings.Window> windows = Map.of();
+    private long revision;
+    private long sequence;
+    private NativePlayerInventoryAction pending;
+    private NativeBundleAction pendingBundle;
+    private long sentAt;
+    private String queuedQuery;
+    private boolean retired;
+    private String selectedCollection = "";
+    private int selectedIndex = -1;
+    private int helpTopic = -1;
+    private boolean helpCreative;
+
+    NativePlayerPresentation(final NativePlayerInventoryMessage message, final Map<Integer, ItemStack> previews,
+                             final Map<Integer, ItemStack> craftingPreview, final LongSupplier clock) {
+        this.clock = clock;
+        this.replace(message, message.state(), previews, craftingPreview);
+    }
+
+    private void replace(final NativePlayerInventoryMessage message, final PlayerInventoryUi.State state,
+                         final Map<Integer, ItemStack> previews,
+                         final Map<Integer, ItemStack> craftingPreview) {
+        if (!previews.keySet().equals(message.items().keySet()) || previews.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Player previews differ from the retained collection");
+        final Map<Integer, ItemStack> owned = new HashMap<>();
+        previews.forEach((id, item) -> owned.put(id, item.copy()));
+        if (!craftingPreview.keySet().equals(message.craftingPreview().keySet()) || craftingPreview.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Crafting previews differ from the retained recipe");
+        final Map<Integer, ItemStack> ghosts = new HashMap<>();
+        craftingPreview.forEach((slot, item) -> ghosts.put(slot, item.copy()));
+        // Snapshot revisions can retain the same immutable authored resources.
+        if (this.message == null || !this.message.program().equals(message.program()))
+            this.program = PlayerInventoryUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+        if (this.message != null && !this.state.cells().equals(state.cells())) this.select("", -1);
+        this.message = message;
+        this.state = state;
+        this.previews = Map.copyOf(owned);
+        this.craftingPreview = Map.copyOf(ghosts);
+        this.revision++;
+    }
+
+    boolean update(final NativePlayerInventoryMessage message, final Map<Integer, ItemStack> previews,
+                   final Map<Integer, ItemStack> craftingPreview) {
+        if (this.retired || message.menuId() != this.message.menuId() || message.opening() != this.message.opening()
+                || message.revision() <= this.message.revision()
+                || this.message.generation() != 0 && message.generation() != this.message.generation()) return false;
+        final var state = message.state();
+        if (state.workbench() != this.state.workbench()) return false;
+        this.replace(message, state, previews, craftingPreview);
+        return true;
+    }
+
+    NativePlayerInventoryMessage message() { return this.message; }
+    PlayerInventoryUi.State state() { return this.state; }
+    boolean idle() { return !this.retired && this.pending == null && this.pendingBundle == null; }
+    boolean expired() { return (this.pending != null || this.pendingBundle != null) && this.clock.getAsLong() - this.sentAt >= 10_000_000_000L; }
+    void retire() { this.retired = true; this.pending = null; this.pendingBundle = null; this.queuedQuery = null; }
+    String query() { return this.queuedQuery != null ? this.queuedQuery : this.pending != null && this.pending.kind() == NativePlayerInventoryAction.Kind.SEARCH
+            ? this.pending.query() : this.state.query(); }
+
+    boolean windows(final Map<String, UiBindings.Window> windows) {
+        final var replacement = Map.copyOf(windows);
+        if (this.windows.equals(replacement)) return false;
+        this.windows = replacement;
+        return true;
+    }
+
+    boolean helping() { return this.helpTopic >= 0; }
+
+    void openHelp() {
+        if (this.retired || this.helping()) return;
+        this.helpCreative = this.state.creative();
+        this.helpTopic = this.helpCreative ? 47 : 5;
+        this.revision++;
+    }
+
+    boolean closeHelp() {
+        if (!this.helping()) return false;
+        this.helpTopic = -1;
+        this.revision++;
+        return true;
+    }
+
+    void helpTopic(final int index) {
+        if (!this.helping() || this.retired || index == this.helpTopic) return;
+        this.program.help(this.helpCreative, index);
+        this.helpTopic = index;
+        this.revision++;
+    }
+
+    boolean select(final String collection, final int index) {
+        if (this.selectedCollection.equals(collection) && this.selectedIndex == index) return false;
+        this.selectedCollection = collection;
+        this.selectedIndex = index;
+        this.revision++;
+        return true;
+    }
+
+    boolean deselect(final String collection, final int index) {
+        return this.selectedCollection.equals(collection) && this.selectedIndex == index && this.select("", -1);
+    }
+
+    void query(final String value, final Consumer<NativePlayerInventoryAction> sender) {
+        if (this.retired) return;
+        if (!value.equals(this.query())) this.revision++;
+        this.queuedQuery = value;
+        this.flush(sender);
+    }
+
+    void flush(final Consumer<NativePlayerInventoryAction> sender) {
+        if (!this.idle() || this.queuedQuery == null) return;
+        final String query = this.queuedQuery;
+        this.queuedQuery = null;
+        if (!query.equals(this.state.query())) this.send(NativePlayerInventoryAction.Kind.SEARCH, -1, query, null, sender);
+    }
+
+    boolean send(final NativePlayerInventoryAction.Kind kind, final int target, final String query,
+                 final InventoryOptions options, final Consumer<NativePlayerInventoryAction> sender) {
+        if (!this.idle()) return false;
+        final var message = this.message;
+        final var action = new NativePlayerInventoryAction(message.menuId(), message.opening(), message.generation(), message.revision(),
+                this.sequence = Math.incrementExact(this.sequence), kind, target, query, options);
+        this.pending = action;
+        this.sentAt = this.clock.getAsLong();
+        sender.accept(action);
+        return true;
+    }
+
+    boolean result(final NativePlayerInventoryResult result) {
+        if (this.retired || this.pending == null && this.pendingBundle == null) return false;
+        final long opening = this.pendingBundle == null ? this.pending.opening() : this.pendingBundle.opening();
+        final long generation = this.pendingBundle == null ? this.pending.generation() : this.pendingBundle.generation();
+        final long request = this.pendingBundle == null ? this.pending.request() : this.pendingBundle.request();
+        if (result.opening() != opening || result.generation() != generation || result.request() != request) return false;
+        if (!result.accepted() && this.pending != null && this.pending.kind() == NativePlayerInventoryAction.Kind.SEARCH && this.queuedQuery == null)
+            this.queuedQuery = this.pending.query();
+        this.pending = null;
+        this.pendingBundle = null;
+        this.revision++;
+        return true;
+    }
+
+    boolean result(final NativeBundleResult result, final Consumer<NativeBundleResult.Sound> sounds) {
+        if (this.pendingBundle == null) return false;
+        if (result.sound() != NativeBundleResult.Sound.NONE
+                && (this.pendingBundle.kind() == NativeBundleAction.Kind.SECONDARY) != (result.sound() == NativeBundleResult.Sound.REMOVE_ONE)) return false;
+        if (!this.result(result.result())) return false;
+        if (result.sound() != NativeBundleResult.Sound.NONE) sounds.accept(result.sound());
+        return true;
+    }
+
+    boolean bundle(final String collection, final int index, final NativeBundleAction.Kind kind, final int tooltipMode,
+                   final Consumer<NativeBundleAction> sender) {
+        if (!this.idle() || this.message.generation() <= 0) return false;
+        final var message = this.message;
+        final var action = new NativeBundleAction(message.menuId(), message.opening(), message.generation(), message.revision(),
+                Math.incrementExact(this.sequence), collection, index, kind, tooltipMode);
+        this.sequence = action.request();
+        this.pendingBundle = action;
+        this.sentAt = this.clock.getAsLong();
+        sender.accept(action);
+        return true;
+    }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags, final BundleTooltipUi.View tooltip) {
+        if (menuId != this.message.menuId() || this.retired) throw new IllegalArgumentException("Retired player menu");
+        if (this.helping()) return new Frame(this.program.help(this.helpCreative, this.helpTopic), 46, Map.of(), Map.of());
+        final var source = this.state;
+        final var cells = source.cells().stream().map(cell -> {
+            final Map<String, JsonElement> values = new HashMap<>(NativeInventoryItemPresentation.values(this.previews.get(cell.id()), false, showTags));
+            values.putAll(cell.presentation());
+            return new PlayerInventoryUi.Cell(cell.id(), cell.sourceId(), cell.groupIndex(), cell.modifier(), cell.availability(),
+                    cell.quantity(), cell.disabled(), cell.needsTable(), cell.groupName(), values);
+        }).toList();
+        final var state = new PlayerInventoryUi.State(source.workbench(), source.creative(), source.inventoryLayout(), source.craftingLayout(), source.leftTab(), source.rightTab(),
+                source.filtering(), this.query(), source.tabLabel(), source.craftingLabel(), source.categoryCounts(), cells, this.selectedCollection, this.selectedIndex);
+        final Map<Integer, ItemStack> ghosts = new HashMap<>();
+        final var displayedSlots = slots.stream().map(slot -> {
+            final var ghost = this.craftingPreview.get(slot.javaSlot());
+            if (ghost == null || slot.presentation().get("#inventory_stack_count").getAsInt() != 0) return slot;
+            final Map<String, JsonElement> values = new HashMap<>(slot.presentation());
+            values.putAll(NativeInventoryItemPresentation.values(ghost, false, showTags));
+            values.put("#container_item_background", new JsonPrimitive(3));
+            ghosts.put(slot.javaSlot(), ghost);
+            return new ContainerUi.Slot(slot.javaSlot(), values);
+        }).toList();
+        final var scene = this.program.resolve(new PlayerInventoryUi.MenuView(menuId, state, displayedSlots, cursor), this.windows, tooltip);
+        final Map<Integer, Set<String>> actions = new HashMap<>();
+        final Map<Integer, ItemStack> visible = new HashMap<>();
+        this.scope(scene.getAsJsonObject("root"), actions, visible);
+        return new Frame(scene, 46, visible, actions, ghosts);
+    }
+
+    private void scope(final JsonObject node, final Map<Integer, Set<String>> actions, final Map<Integer, ItemStack> visible) {
+        if (node.has("recipe_id")) {
+            final int id = node.get("recipe_id").getAsInt();
+            final var item = this.previews.get(id);
+            if (item == null) throw new IllegalArgumentException("Unknown player cell");
+            visible.put(id, item);
+        }
+        if (node.has("recipe_actions")) {
+            final int id = node.get("recipe_id").getAsInt();
+            final Set<String> values = actions.computeIfAbsent(id, ignored -> new HashSet<>());
+            for (final var action : node.getAsJsonArray("recipe_actions")) values.add(action.getAsJsonObject().get("to_button_id").getAsString());
+        }
+        if (node.has("children")) for (final var child : node.getAsJsonArray("children")) this.scope(child.getAsJsonObject(), actions, visible);
+    }
+}
