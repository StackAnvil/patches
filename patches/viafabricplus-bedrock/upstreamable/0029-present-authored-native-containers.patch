+                assertSame(menu.slots.getFirst(), screen.nativeHoveredSlot(101, 51));
+                reset(game.gameMode);
+                for (final var input : List.of(ContainerInput.PICKUP, ContainerInput.QUICK_MOVE, ContainerInput.QUICK_CRAFT)) {
+                    screen.slotClicked(menu.slots.getFirst(), 999, 0, input);
+                    verify(game.gameMode).handleContainerInput(7, 0, 0, input, player);
