+
+    @Test
+    void hiddenControlsRetireMappingsButDeliverTheirCapturedGlobalRelease() {
+        for (final boolean own : List.of(false, true)) {
+            for (final String property : List.of("visible", "ignored")) {
+                final var input = new NativeContainerInput(_ -> { });
+                final var button = button(true, true);
+                final var mapping = button.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject();
+                mapping.addProperty("mapping_type", "global");
+                mapping.addProperty("button_up_right_of_first_refusal", true);
+                final var host = new NativeUiScene.Node("host", "panel", properties(100, 100), List.of(button), Integer.MIN_VALUE);
+                final var target = own ? button : host;
+                layout(input, host);
+                input.pointer(5, 5, 1, 0, true);
+                input.button("button.menu_ok", true, 1, 1, true);
+                target.properties().addProperty(property, property.equals("ignored"));
+                layout(input, host);
+                assertTrue(button.children().getFirst().flag("visible", true));
+                assertTrue(input.captures("button.menu_ok"));
+                assertTrue(input.button("button.menu_ok", true, 1, 2, true).events().isEmpty());
+                final var release = input.button("button.menu_ok", false, 1, 3, true);
+                assertEquals(1, release.events().size());
+                assertEquals(2, release.events().getFirst().button().previous());
+                assertFalse(input.captures("button.menu_ok"));
+                layout(input, host);
+                assertTrue(input.button("button.menu_ok", false, 1, 4, true).events().isEmpty());
+                target.properties().addProperty(property, property.equals("visible"));
+                layout(input, host);
+                final var reopened = input.button("button.menu_ok", true, 1, 5, true);
+                assertEquals(own ? 2 : 0, reopened.events().getFirst().button().previous());
+                assertTrue(button.children().get(2).flag("visible", true));
+            }
+        }
+    }
+
+    @Test
+    void initiallyHiddenControlsInvalidateMappingsWhenTheScreenAdmitsItsTree() {
+        for (final boolean own : List.of(false, true)) {
+            for (final String property : List.of("visible", "ignored")) {
+                final var input = new NativeContainerInput(_ -> { });
+                final var button = button(true, true);
+                button.properties().getAsJsonArray("button_mappings").get(0).getAsJsonObject().addProperty("mapping_type", "global");
+                final var host = new NativeUiScene.Node("host", "panel", properties(100, 100), List.of(button), Integer.MIN_VALUE);
