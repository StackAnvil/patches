+@Mixin(Gui.class)
+public abstract class MixinNativeContainerScreenAdmission {
+    @Inject(method = "setScreen", at = @At("HEAD"), cancellable = true)
+    private void deferPlayerInventory(final Screen screen, final CallbackInfo ci) {
+        if (!BedrockNativeContainers.admitPlayerScreen(screen)) ci.cancel();
+    }
+
+    @Inject(method = "setScreen", at = @At("RETURN"))
+    private void playerInventoryLifecycle(final Screen screen, final CallbackInfo ci) {
+        BedrockNativeContainers.playerScreenInstalled();
+    }
+
+    @Inject(method = "setScreen", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/client/MouseHandler;resyncMousePosition()V", shift = At.Shift.AFTER))
+    private void initialPointer(final Screen screen, final CallbackInfo ci) {
+        BedrockNativeContainers.screenInstalled(screen);
+    }
+}
