+        assertFalse(controller.claim(oldSession, menu, 6, 6, 20));
+        assertNull(controller.offer(oldSession, menu, 6, 20, false, 2, new Object()));
+        assertNull(controller.contents(oldSession, menu, 6, 2));
+        controller.tick(oldSession, menu, 6, 200);
+        controller.clear(oldSession);
+        controller.begin(newSession);
+        assertTrue(controller.current(newSession, menu, 6));
+        assertSame(presentation, controller.contents(newSession, menu, 6, 3));
+        controller.clear(newSession);
+        assertFalse(controller.claim(newSession, menu, 6, 6, 2));
+        assertFalse(controller.current(newSession, menu, 6));
+    }
+
+}
