+                {"from_button_id":"button.menu_secondary_select","to_button_id":"button.cursor_drop_one","mapping_type":"pressed"}""";
+        final String place = """
+                {"from_button_id":"button.menu_select","to_button_id":"button.container_auto_place_one","mapping_type":"pressed"}""";
