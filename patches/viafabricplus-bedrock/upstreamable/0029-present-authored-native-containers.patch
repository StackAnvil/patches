--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/BedrockNativeCooking.java
@@ -0,0 +1,145 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.creative.BedrockCreativeCatalog;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.BlastFurnaceMenu;
+import net.minecraft.world.inventory.FurnaceMenu;
+import net.minecraft.world.inventory.SmokerMenu;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.InputMode;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Retains server cooking authority independently of the ordinary screen and its recipe projection. */
+final class BedrockNativeCooking {
+    private static final NativeCookingPresentationController<ClientPacketListener, AbstractContainerMenu> PRESENTATIONS =
+            new NativeCookingPresentationController<>();
+
+    private BedrockNativeCooking() {}
+
+    static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativeCookingPayload.TYPE, NativeCookingPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeCookingProgressPayload.TYPE, NativeCookingProgressPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeCookingActionResultPayload.TYPE, NativeCookingActionResultPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(NativeCookingActionPayload.TYPE, NativeCookingActionPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((owner, client) -> {
+            PRESENTATIONS.begin(owner);
+            ClientPlayNetworking.registerReceiver(NativeCookingPayload.TYPE,
+                    (payload, context) -> client.execute(() -> accept(owner, payload.message())));
+            ClientPlayNetworking.registerReceiver(NativeCookingProgressPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (!connected(owner) || client.player == null) return;
+                final var menu = client.player.containerMenu;
+                PRESENTATIONS.progress(owner, menu, menu.containerId, payload.progress());
+            }));
+            ClientPlayNetworking.registerReceiver(NativeCookingActionResultPayload.TYPE, (payload, context) -> client.execute(() -> {
+                if (!connected(owner) || client.player == null) return;
+                final var menu = client.player.containerMenu;
+                PRESENTATIONS.result(owner, menu, menu.containerId, payload.result());
+            }));
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((owner, client) -> PRESENTATIONS.clear(owner));
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            final var menu = client.player == null ? null : client.player.containerMenu;
+            PRESENTATIONS.capability(client.getConnection(), ClientPlayNetworking.canSend(NativeCookingActionPayload.TYPE));
+            PRESENTATIONS.tick(client.getConnection(), menu, menu == null ? -1 : menu.containerId);
+            present(client);
+        });
+    }
+
+    static boolean action(final ClientPacketListener owner, final AbstractContainerMenu menu, final int recipe,
+                          final NativeCookingAction.Mode mode, final int phase) {
+        final var client = Minecraft.getInstance();
+        if (!connected(owner) || client.player == null || client.player.containerMenu != menu
+                || !(client.gui.screen() instanceof AbstractContainerScreen<?> screen) || screen.getMenu() != menu
+                || phase == 0 && !menu.getCarried().isEmpty()) return false;
+        final var presentation = PRESENTATIONS.current(owner, menu, menu.containerId);
+        if (presentation == null || !(screen instanceof BedrockNativeContainerScreen nativeScreen) || !nativeScreen.presents(presentation)) return false;
+        final boolean available = ClientPlayNetworking.canSend(NativeCookingActionPayload.TYPE);
+        PRESENTATIONS.capability(owner, available);
+        if (!available) return false;
+        try {
+            return PRESENTATIONS.action(owner, menu, menu.containerId, recipe, mode, InputMode.Mouse.getValue(), phase,
+                    action -> ClientPlayNetworking.send(new NativeCookingActionPayload(action)));
+        } catch (final RuntimeException failedTransport) {
+            PRESENTATIONS.retire(owner, menu, menu.containerId);
+            ViaFabricPlusBedrock.impl().logger().warn("Unable to send native cooking input; retiring its presentation", failedTransport);
+            return false;
+        }
+    }
+
+    static void retire(final ClientPacketListener owner, final AbstractContainerMenu menu, final NativeCookingPresentation presentation) {
+        try {
+            final var client = Minecraft.getInstance();
+            final var current = PRESENTATIONS.current(owner, menu, menu.containerId);
+            if (connected(owner) && client.player != null && client.player.containerMenu == menu
+                    && (current == null || current == presentation) && ClientPlayNetworking.canSend(NativeCookingActionPayload.TYPE))
+                presentation.cancel(action -> ClientPlayNetworking.send(new NativeCookingActionPayload(action)));
+            else presentation.retire();
+        } catch (final RuntimeException failedRelease) {
+            ViaFabricPlusBedrock.impl().logger().warn("Unable to release retired native cooking input", failedRelease);
+        } finally {
+            if (PRESENTATIONS.current(owner, menu, menu.containerId) == presentation) PRESENTATIONS.retire(owner, menu, menu.containerId);
+        }
+    }
+
+    private static void present(final Minecraft client) {
+        final var owner = client.getConnection();
+        if (!connected(owner) || client.player == null || !ClientPlayNetworking.canSend(NativeCookingActionPayload.TYPE)) return;
+        final var menu = client.player.containerMenu;
+        final var presentation = PRESENTATIONS.current(owner, menu, menu.containerId);
+        if (presentation == null || !(client.gui.screen() instanceof AbstractContainerScreen<?> displayed) || displayed.getMenu() != menu) return;
+        if (displayed instanceof BedrockNativeContainerScreen nativeScreen && nativeScreen.presents(presentation)) return;
+        final var ordinary = displayed instanceof BedrockNativeContainerScreen nativeScreen ? nativeScreen.original() : displayed;
+        final var screen = new BedrockNativeContainerScreen(owner, ordinary, client.player.getInventory(), ordinary.getTitle(), presentation,
+                false, presentation.message().sequence(), System::nanoTime,
+                () -> connected(owner) && client.player != null && client.player.containerMenu == menu
+                        && PRESENTATIONS.current(owner, menu, menu.containerId) == presentation);
+        try {
+            screen.prepare(client.font, screen.nativeViewport().width(), screen.nativeViewport().height());
+            BedrockNativeContainers.replace(screen);
+        } catch (final RuntimeException unsupported) {
+            retire(owner, menu, presentation);
+            BedrockNativeContainers.failedPresentation(screen, unsupported);
+        }
+    }
+
+    private static void accept(final ClientPacketListener owner, final NativeCookingMessage message) {
+        final var client = Minecraft.getInstance();
+        if (!connected(owner) || client.player == null) return;
+        final var menu = client.player.containerMenu;
+        if (!(client.gui.screen() instanceof AbstractContainerScreen<?> screen)
+                || screen.getMenu() != menu || !matches(menu, message.view().family())) return;
+        try {
+            PRESENTATIONS.accept(owner, menu, menu.containerId, message,
+                    item -> BedrockCreativeCatalog.toNative(item, client.player.registryAccess()));
+        } catch (final RuntimeException unsupported) {
+            ViaFabricPlusBedrock.impl().logger().warn("Unsupported native cooking presentation; retaining ordinary controls", unsupported);
+        }
+    }
+
+    static boolean matches(final AbstractContainerMenu menu, final CookingUi.Family family) {
+        if (menu == null || menu.slots.size() != 39) return false;
+        return switch (family) {
+            case FURNACE -> menu instanceof FurnaceMenu;
+            case BLAST_FURNACE -> menu instanceof BlastFurnaceMenu;
+            case SMOKER -> menu instanceof SmokerMenu;
+        };
+    }
+
+    private static boolean connected(final ClientPacketListener owner) {
+        return owner != null && Minecraft.getInstance().getConnection() == owner && owner.getConnection().isConnected();
+    }
+}
