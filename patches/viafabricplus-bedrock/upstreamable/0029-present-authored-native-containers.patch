+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemStyle;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+import net.minecraft.client.renderer.state.gui.BlitRenderState;
+import org.joml.Matrix3x2f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeInventoryItemStyleTest {
+    @Test
+    void cachedPremultipliedTextureFadesAtSubmissionWithoutChangingGeometryOrOpaqueUsers() {
+        final var clip = new ScreenRectangle(0, 0, 40, 40);
+        final var source = new BlitRenderState(null, null, new Matrix3x2f(),
+                2, 3, 18, 19, 0.2F, 0.4F, 0.3F, 0.5F, 0xC0804020, clip, clip);
+        final var half = NativeInventoryItemStyle.apply(source, new NativeInventoryItemStyle(.5F, 1));
+        assertEquals(0x60402010, half.color());
+        assertSame(source.pose(), half.pose());
+        assertSame(clip, half.scissorArea());
+        assertSame(source.bounds(), half.bounds());
+        assertEquals(source.u0(), half.u0());
+        assertEquals(source.v1(), half.v1());
+        assertSame(source, NativeInventoryItemStyle.apply(source, NativeInventoryItemStyle.NORMAL));
+        assertEquals(0, NativeInventoryItemStyle.apply(source, new NativeInventoryItemStyle(0, 1)).color());
+        assertEquals(0xC0804020, source.color());
+
+        final var vertices = mock(VertexConsumer.class, RETURNS_SELF);
+        half.buildVertices(vertices);
+        verify(vertices, times(4)).setColor(half.color());
+        verify(vertices).addVertexWith2DPose(half.pose(), 2F, 3F);
+        verify(vertices).addVertexWith2DPose(half.pose(), 18F, 19F);
+    }
+
+    @Test
+    void inactiveIconsKeepTheirCoverageWhileDimmingAtAtlasSubmission() {
+        final var properties = new JsonObject();
+        properties.addProperty("disabled_filter_visible", true);
+        final var node = new NativeUiScene.Node("item", "custom", properties, List.of(), -1);
+        final var style = NativeInventoryItemStyle.from(node, 1);
+        final var source = new BlitRenderState(null, null, new Matrix3x2f(),
+                0, 0, 16, 16, 0, 1, 0, 1, 0xFFFFFFFF, null, null);
+        assertEquals(0xFF3F3F3F, NativeInventoryItemStyle.apply(source, style).color());
+        assertEquals(0x80202020, NativeInventoryItemStyle.apply(source, NativeInventoryItemStyle.from(node, .5F)).color());
+        properties.addProperty("filtered_light_multiplier", .5F);
+        assertEquals(0xFF7F7F7F, NativeInventoryItemStyle.apply(source, NativeInventoryItemStyle.from(node, 1)).color());
+        properties.addProperty("disabled_filter_visible", false);
+        assertSame(source, NativeInventoryItemStyle.apply(source, NativeInventoryItemStyle.from(node, 1)));
+    }
+
+    @Test
+    void nestedExtractionRestoresLightingAndOpacityWhenAnItemFails() {
+        final var graphics = new IBedrockGuiItemStyle() {
+            private NativeInventoryItemStyle style = NativeInventoryItemStyle.NORMAL;
+            public NativeInventoryItemStyle stackanvil$itemStyle() { return this.style; }
+            public void stackanvil$itemStyle(final NativeInventoryItemStyle value) { this.style = value; }
+        };
+        final var failure = new IllegalStateException();
+        NativeInventoryItemStyle.extract(graphics, new NativeInventoryItemStyle(.5F, .25F), () -> {
+            assertEquals(new NativeInventoryItemStyle(.5F, .25F), graphics.stackanvil$itemStyle());
+            assertSame(failure, assertThrows(IllegalStateException.class,
+                    () -> NativeInventoryItemStyle.extract(graphics, new NativeInventoryItemStyle(.25F, .63F), () -> {
+                        assertEquals(new NativeInventoryItemStyle(.25F, .63F), graphics.stackanvil$itemStyle());
+                        throw failure;
+                    })));
+            assertEquals(new NativeInventoryItemStyle(.5F, .25F), graphics.stackanvil$itemStyle());
+        });
+        assertEquals(NativeInventoryItemStyle.NORMAL, graphics.stackanvil$itemStyle());
+        for (final float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, -1, 2})
+            assertThrows(IllegalArgumentException.class,
+                    () -> new NativeInventoryItemStyle(invalid, 1));
+        assertEquals(NativeInventoryItemStyle.NORMAL, graphics.stackanvil$itemStyle());
+    }
+}
