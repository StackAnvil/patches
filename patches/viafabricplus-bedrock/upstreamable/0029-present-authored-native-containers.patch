+        buffer -> new NativeContainerPayload(NativeContainerMessage.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeContainerPayload> type() { return TYPE; }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPending.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPending.java
