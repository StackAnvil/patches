+    @Test
+    void inventoryPointerEventsDoNotDispatchTheirCancelBinding() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var player = mock(LocalPlayer.class);
+        final var inventory = new Inventory(player, new EntityEquipment());
+        final var menu = ChestMenu.threeRows(7, inventory);
+        player.containerMenu = menu;
+        final var game = mock(Minecraft.class);
+        game.player = player;
+        game.gameMode = mock(MultiPlayerGameMode.class);
+        final var gui = Minecraft.class.getField("gui");
+        gui.setAccessible(true);
+        gui.set(game, mock(net.minecraft.client.gui.Gui.class));
+        final var options = Minecraft.class.getDeclaredField("options");
+        options.setAccessible(true);
+        options.set(game, mock(net.minecraft.client.Options.class));
+        final var pick = net.minecraft.client.Options.class.getDeclaredField("keyPickItem");
+        pick.setAccessible(true);
+        pick.set(game.options, mock(net.minecraft.client.KeyMapping.class));
+        final var clock = new java.util.concurrent.atomic.AtomicLong();
+        try (var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var ordinary = new ContainerScreen(menu, inventory, Component.empty());
+            final var screen = new BedrockNativeContainerScreen(mock(ClientPacketListener.class), ordinary, inventory,
+                    Component.empty(), new NativeContainerPresentation(program(), ContainerUi.Kind.CHEST_3_ROWS, List.of()),
+                    false, 1, clock::get, () -> true);
+            final var minecraft = Screen.class.getDeclaredField("minecraft");
+            minecraft.setAccessible(true);
+            minecraft.set(screen, game);
+            screen.prepare(mock(Font.class), 640, 320);
+            clock.set(1_000_000_000);
+            screen.containerTick();
+            final var drawsField = BedrockNativeContainerScreen.class.getDeclaredField("draws");
+            drawsField.setAccessible(true);
+            @SuppressWarnings("unchecked")
+            final var draws = (List<NativeUiPresentation.Draw>) drawsField.get(screen);
+            int clicked = 0;
+            for (final var draw : draws) {
+                final var node = draw.box().node();
+                final var bounds = draw.box().visibleBounds();
+                if (!node.properties().has("inventory_actions") || !node.string("inventory_command", "").equals("close")
+                        || !draw.enabled() || draw.alpha() <= 0 || bounds.width() <= 0 || bounds.height() <= 0) continue;
+                final double x = bounds.x() + bounds.width() / 2;
+                final double y = bounds.y() + bounds.height() / 2;
+                assertNotNull(screen.nativeHoveredSlot(x, y));
+                for (final int button : List.of(com.mojang.blaze3d.platform.InputConstants.MOUSE_BUTTON_LEFT,
+                        com.mojang.blaze3d.platform.InputConstants.MOUSE_BUTTON_RIGHT)) {
+                    final var event = new net.minecraft.client.input.MouseButtonEvent(x, y,
+                            new net.minecraft.client.input.MouseButtonInfo(button, 0));
+                    assertTrue(screen.mouseClicked(event, false));
+                    screen.mouseReleased(event);
+                }
+                clicked++;
+            }
+            assertTrue(clicked >= menu.slots.size());
+            verify(player, never()).closeContainer();
+            screen.discard();
+        }
+    }
