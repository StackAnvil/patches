@@ -0,0 +1,135 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Authority and progress stay server-owned; genuine client stacks supply rendering and hover data. */
+final class NativeCookingPresentation implements NativeInventoryPresentation {
+    private final NativeCookingActions actions;
+    private NativeCookingMessage message;
+    private CookingUi program;
+    private CookingUi.MenuView view;
+    private Map<Integer, ItemStack> recipes;
+    private CookingUi.Progress progress;
+    private CookingUi.Selection selection;
+    private long dataRevision = -1;
+    private long revision;
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        this(message, recipes, System::nanoTime);
+    }
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes, final LongSupplier clock) {
+        this.replace(message, recipes);
+        this.actions = new NativeCookingActions(message, clock);
+    }
+
+    boolean update(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence()
+                || message.view().family() != this.view.family()) return false;
+        this.replace(message, recipes);
+        this.actions.update(message);
+        return true;
+    }
+
+    private void replace(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (!recipes.keySet().equals(message.recipeItems().keySet()) || recipes.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Cooking previews differ from the authoritative catalog");
+        final var program = CookingUi.fromProgram(JsonParser.parseString(message.program()).getAsJsonObject());
+        final var view = message.view();
+        final Map<Integer, ItemStack> copies = new HashMap<>();
+        recipes.forEach((id, item) -> copies.put(id, item.copy()));
+        if (this.view == null || !this.view.book().selection().equals(view.book().selection()))
+            this.selection = view.book().selection();
+        this.message = message;
+        this.program = program;
+        this.view = view;
+        this.recipes = Map.copyOf(copies);
+        this.progress = view.progress();
+        this.dataRevision = -1;
+        this.revision++;
+    }
+
+    boolean update(final NativeCookingProgress update) {
+        if (update.menuId() != this.message.menuId() || update.sequence() != this.message.sequence()
+                || update.updateSequence() != this.message.updateSequence() || update.dataRevision() <= this.dataRevision) return false;
+        this.progress = update.progress();
+        this.dataRevision = update.dataRevision();
+        this.revision++;
+        return true;
+    }
+
+    NativeCookingMessage message() { return this.message; }
+
+    boolean select(final String collection, final int index) {
+        final var selected = new CookingUi.Selection(collection, index);
+        if (selected.equals(this.selection)) return false;
+        this.selection = selected;
+        this.revision++;
+        return true;
+    }
+
+    boolean deselect(final String collection, final int index) {
+        if (!this.selection.equals(new CookingUi.Selection(collection, index))) return false;
+        return this.select("", -1);
+    }
+
+    void tabChanged() {
+        this.selection = new CookingUi.Selection("", -1);
+        this.revision++;
+    }
+
+    boolean idle() { return this.actions.idle(); }
+
+    boolean forcedRecipeBookLayout() { return this.view.book().forcedRecipeBookLayout(); }
+
+    boolean action(final int recipe, final NativeCookingAction.Mode mode, final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        return this.actions.send(recipe, mode, controllerMode, phase, sender);
+    }
+
+    boolean result(final NativeCookingActionResult result) { return this.actions.result(result); }
+
+    boolean expired() { return this.actions.expired(); }
+
+    void retire() { this.actions.retire(); }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender) { return this.actions.cancel(sender); }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags) {
+        if (menuId != this.message.menuId()) throw new IllegalArgumentException("Cooking view belongs to another menu");
+        final var source = this.view.book();
+        final var catalog = source.catalog().stream().map(recipe -> {
+            final Map<String, JsonElement> values = new HashMap<>(NativeInventoryItemPresentation.values(this.recipes.get(recipe.id()), false, showTags));
+            values.putAll(recipe.presentation());
+            return new CookingUi.Recipe(recipe.id(), recipe.uniqueId(), recipe.priority(), recipe.unlocked(), recipe.outputName(), recipe.evaluation(), values);
+        }).toList();
+        final var book = new CookingUi.Book(source.layout(), source.forcedRecipeBookLayout(), source.tab(), source.filtering(),
+                source.foodCount(), source.itemCount(), source.blockCount(), source.tabLabel(), source.searchText(), this.selection, catalog, source.visibleRecipes());
+        final var scene = this.program.resolve(new CookingUi.MenuView(menuId, this.view.family(), this.view.title(), slots, cursor, this.progress, book));
+        final var scope = CookingUi.actionScope(scene, book);
+        this.actions.presented(this.message, scope);
+        return new Frame(scene, 3, this.recipes, scope);
+    }
+}
