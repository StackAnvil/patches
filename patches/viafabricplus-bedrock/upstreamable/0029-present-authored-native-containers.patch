@@ -0,0 +1,158 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** One menu's input phases retain their original authority while predicted frames advance. */
+final class NativeCookingActions {
+    private static final long RESPONSE_TIMEOUT_NANOS = 10_000_000_000L;
+    private final LongSupplier clock;
+    private final Map<Long, Pending> pending = new HashMap<>();
+    private final Set<Event> emitted = new HashSet<>();
+    private NativeCookingMessage message;
+    private Map<Integer, Set<String>> commands = Map.of();
+    private NativeCookingAction gesture;
+    private NativeCookingAction releaseSource;
+    private Set<String> gestureCommands = Set.of();
+    private long requestSequence;
+    private long invalidatedUpdate;
+    private boolean retired;
+    private boolean dispatching;
+
+    NativeCookingActions(final NativeCookingMessage message, final LongSupplier clock) {
+        this.message = Objects.requireNonNull(message);
+        this.clock = Objects.requireNonNull(clock);
+    }
+
+    void update(final NativeCookingMessage message) {
+        if (this.retired || message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence())
+            throw new IllegalArgumentException("Cooking action authority belongs to another frame");
+        this.message = message;
+        this.commands = Map.of();
+    }
+
+    void presented(final NativeCookingMessage message, final CookingUi.RecipeActionScope scope) {
+        if (this.retired || message != this.message)
+            throw new IllegalArgumentException("Cooking actions require the displayed frame");
+        this.commands = scope.actions();
+    }
+
+    boolean send(final int recipe, final NativeCookingAction.Mode mode, final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        if (this.retired || this.dispatching || mode == null || controllerMode < 0 || controllerMode > 3 || phase < 0 || phase > 2 || this.expired()) return false;
+        final NativeCookingAction original;
+        final boolean startsFocus = phase == 1 && mode == NativeCookingAction.Mode.PRIMARY && controllerMode == 2 && this.gesture == null;
+        final boolean focused = this.gesture != null && this.gesture.eventPhase() == 1;
+        if (phase == 0 || startsFocus) {
+            if (this.gesture != null && (!focused || mode != NativeCookingAction.Mode.PRIMARY) || !this.pending.isEmpty() && !focused
+                    || this.message.updateSequence() <= this.invalidatedUpdate
+                    || !this.commands.getOrDefault(recipe, Set.of()).contains(mode.button())) return false;
+            original = null;
+        } else {
+            original = this.gesture;
+            if (original == null || original.eventPhase() == 1 && mode != NativeCookingAction.Mode.PRIMARY
+                    || original.recipeId() != recipe || !this.gestureCommands.contains(mode.button())
+                    || this.emitted.contains(new Event(mode, phase))) return false;
+        }
+        if (this.requestSequence == Long.MAX_VALUE) {
+            this.retire();
+            return false;
+        }
+        Objects.requireNonNull(sender);
+        final var action = original == null
+                ? new NativeCookingAction(this.message.menuId(), this.message.sequence(), this.message.updateSequence(),
+                        this.message.menuRevision(), this.message.inventoryRevision(), this.message.cursorRevision(), recipe, mode, controllerMode, phase, ++this.requestSequence)
+                : new NativeCookingAction(original.menuId(), original.sequence(), original.updateSequence(), original.menuRevision(),
+                        original.inventoryRevision(), original.cursorRevision(), recipe, mode, original.controllerInputMode(), phase, ++this.requestSequence);
+        // A local bridge can return a snapshot and acknowledgment before send() returns.
+        this.pending.put(action.requestSequence(), new Pending(action, this.clock.getAsLong()));
+        if (original == null) {
+            this.gesture = action;
+            this.emitted.clear();
+            if (mode == NativeCookingAction.Mode.PRIMARY) this.releaseSource = action;
+            this.gestureCommands = this.commands.get(recipe);
+        }
+        this.emitted.add(new Event(mode, phase));
+        if (phase == 2 && (mode != NativeCookingAction.Mode.TERTIARY || this.gesture.mode() != NativeCookingAction.Mode.PRIMARY))
+            this.clearGesture();
+        this.dispatching = true;
+        try {
+            sender.accept(action);
+            return true;
+        } catch (final RuntimeException failedTransport) {
+            // The packet may already have reached core. Never retry an ambiguous send.
+            this.retire();
+            throw failedTransport;
+        } finally {
+            this.dispatching = false;
+        }
+    }
+
+    boolean result(final NativeCookingActionResult result) {
+        if (this.expired()) {
+            this.retire();
+            return false;
+        }
+        final var action = result.action();
+        final var pending = this.pending.get(action.requestSequence());
+        if (pending == null || !pending.action.equals(action)) return false;
+        this.pending.remove(action.requestSequence());
+        if (this.releaseSource != null && this.releaseSource.requestSequence() <= action.requestSequence()
+                && ((action.eventPhase() == 0 || action.equals(this.releaseSource)) && !result.accepted()
+                    || action.eventPhase() == 2 && result.accepted() && action.mode() != NativeCookingAction.Mode.TERTIARY)) this.releaseSource = null;
+        if (!result.accepted() && (this.gesture == null || action.requestSequence() >= this.gesture.requestSequence())) this.clearGesture();
+        if (!result.accepted() || !result.current())
+            this.invalidatedUpdate = Math.max(this.invalidatedUpdate, action.updateSequence());
+        return true;
+    }
+
+    boolean expired() {
+        final long now = this.clock.getAsLong();
+        return this.retired || this.pending.values().stream().anyMatch(pending -> now - pending.sentAt >= RESPONSE_TIMEOUT_NANOS);
+    }
+
+    boolean idle() { return !this.expired() && this.gesture == null && this.pending.isEmpty(); }
+
+    /** Terminal release is safe after authority retires: phase two never repeats a transfer. */
+    boolean cancel(final Consumer<NativeCookingAction> sender) {
+        this.retire();
+        final var original = this.releaseSource;
+        this.releaseSource = null;
+        if (original == null || this.requestSequence == Long.MAX_VALUE) return false;
+        final var release = new NativeCookingAction(original.menuId(), original.sequence(), original.updateSequence(),
+                original.menuRevision(), original.inventoryRevision(), original.cursorRevision(), original.recipeId(),
+                NativeCookingAction.Mode.PRIMARY, original.controllerInputMode(), 2, ++this.requestSequence);
+        sender.accept(release);
+        return true;
+    }
+
+    void retire() {
+        this.retired = true;
+        this.pending.clear();
+        this.commands = Map.of();
+        this.clearGesture();
+    }
+
+    private void clearGesture() {
+        this.gesture = null;
+        this.gestureCommands = Set.of();
+        this.emitted.clear();
+    }
+
+    private record Event(NativeCookingAction.Mode mode, int phase) { }
+    private record Pending(NativeCookingAction action, long sentAt) { }
+}
