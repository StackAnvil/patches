+        final var otherMenu = new Object();
+        final var decoded = new AtomicInteger();
+        final java.util.function.Function<com.viaversion.viaversion.api.minecraft.item.Item, ItemStack> decoder =
+                item -> { decoded.incrementAndGet(); return new ItemStack(Items.IRON_INGOT, item.amount()); };
+        final var first = message(CookingUi.Family.FURNACE, 1);
+        controller.begin(owner);
+        assertFalse(controller.accept(new Object(), menu, 5, first, decoder));
+        assertFalse(controller.accept(owner, menu, 6, first, decoder));
+        assertFalse(controller.accept(owner, null, 5, first, decoder));
+        assertEquals(0, decoded.get());
+        assertTrue(controller.accept(owner, menu, 5, first, decoder));
+        final var presentation = controller.current(owner, menu, 5);
+        assertNotNull(presentation);
+        assertFalse(controller.accept(owner, menu, 5, first, decoder));
+        assertFalse(controller.accept(owner, otherMenu, 5, first, decoder));
+        assertEquals(1, decoded.get());
+        assertTrue(controller.accept(owner, menu, 5, message(CookingUi.Family.FURNACE, 2), decoder));
