+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import net.raphimc.viabedrock.protocol.model.FurnaceOptions;
+
+/** Native preferences outlive individual screens, but never their connection. */
+final class NativeFurnacePreferenceState<C> {
+    private C owner;
+    private final Map<Integer, FurnaceOptions> values = new HashMap<>();
+    private long revision;
+
+    void begin(final C connection) {
+        this.owner = Objects.requireNonNull(connection);
+        this.values.clear();
+        this.revision++;
+    }
+
+    void accept(final C connection, final FurnaceOptions options) {
+        if (connection == null || this.owner != connection) return;
+        if (!Objects.equals(this.values.put(options.furnaceType(), options), options)) this.revision++;
+    }
+
+    FurnaceOptions options(final C connection, final int family) {
+        return connection != null && this.owner == connection ? this.values.get(family) : null;
+    }
+
+    long revision(final C connection) {
+        return connection != null && this.owner == connection ? this.revision : -1;
+    }
+
+    void clear(final C connection) {
+        if (connection == null || this.owner != connection) return;
+        this.owner = null;
+        this.values.clear();
+        this.revision++;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventoryFlights.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventoryFlights.java
