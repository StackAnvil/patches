+    @Test
+    void cookingSnapshotsRetainFirstCountUntilAnotherOpeningOrProgram() {
+        final String document = """
+                {"namespace":"furnace","furnace_screen":{"type":"screen","controls":[
+                  {"observer":{"type":"grid","grid_dimensions":[1,1],"collection_name":"inventory_items",
+                    "grid_item_template":"furnace.observer_cell"}}]},
+                 "observer_cell":{"type":"panel","controls":[
+                   {"caption":{"type":"label","text":"$container_title"}},
+                   {"once":{"type":"label","text":"#observed_count","bindings":[{
+                     "binding_type":"collection","binding_collection_name":"inventory_items",
+                     "binding_name":"#inventory_stack_count","binding_name_override":"#observed_count","binding_condition":"once"}]}},
+                   {"always":{"type":"label","text":"#observed_count","bindings":[{
+                     "binding_type":"collection","binding_collection_name":"inventory_items",
+                     "binding_name":"#inventory_stack_count","binding_name_override":"#observed_count","binding_condition":"always"}]}}
+                 ]}}
