+                && target == NativeUiInput.symbol("button.search_bar_selected")) return true;
+        return (node.string("inventory_command", "").equals("close") || node.flag("help_close", false))
+            && (target == NativeUiInput.symbol("button.menu_exit") || target == NativeUiInput.symbol("button.try_menu_exit"));
+    }
+
+    private static boolean isDropTarget(final int target) {
+        return target == NativeUiInput.symbol("button.drop_one") || target == NativeUiInput.symbol("button.drop_all");
+    }
+
+    private static SlotInput playerSlotInput(final int target) {
+        for (final var entry : PLAYER_SLOT_INPUTS.entrySet())
+            if (NativeUiInput.symbol(entry.getKey()) == target) return entry.getValue();
+        return null;
+    }
+
+    private boolean playerSlotAction(final int slot, final int target) {
+        final var input = playerSlotInput(target);
+        if (input == null || slot < 0 || slot >= this.menu.slots.size()) return false;
+        this.slotClicked(this.menu.getSlot(slot), slot, input.button(), input.input());
+        return true;
+    }
+
+    private record SlotInput(ContainerInput input, int button) {}
+
+    private static boolean playerUnsupportedHostAction(final int target) {
+        return NativeContainerGeometry.PLAYER_FALLBACK_ACTIONS.stream().anyMatch(action -> NativeUiInput.symbol(action) == target);
+    }
+
+    private boolean keyboardEvents(final NativeContainerInput.Result result) {
+        boolean handled = this.componentEvents(result);
+        for (final var event : result.events()) {
+            final var button = event.button();
