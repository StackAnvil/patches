@@ -0,0 +1,268 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.BedrockUiContext;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleAction;
+import net.raphimc.viabedrock.api.model.NativeCookingBundleResult;
+import net.raphimc.viabedrock.api.model.NativeBundleAction;
+import net.raphimc.viabedrock.api.model.NativeBundleResult;
+import net.raphimc.viabedrock.api.model.NativeCookingActionResult;
+import net.raphimc.viabedrock.api.model.NativeCookingMessage;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldAction;
+import net.raphimc.viabedrock.api.model.NativeCookingHoldResult;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceAction;
+import net.raphimc.viabedrock.api.model.NativeCookingSourceResult;
+import net.raphimc.viabedrock.api.model.NativeCookingProgress;
+import net.raphimc.viabedrock.api.model.NativeCookingQuery;
+import net.raphimc.viabedrock.api.model.NativeCookingQueryResult;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.CookingUi;
+
+/** Authority and progress stay server-owned; genuine client stacks supply rendering and hover data. */
+final class NativeCookingPresentation implements NativeInventoryPresentation {
+    private final NativeCookingActions actions;
+    private final NativeInventoryHelp help = new NativeInventoryHelp(topic -> this.program.help(topic));
+    private NativeCookingMessage message;
+    private CookingUi program;
+    private CookingUi.MenuView view;
+    private Map<Integer, ItemStack> recipes;
+    private CookingUi.Progress progress;
+    private CookingUi.Selection selection;
+    private long dataRevision = -1;
+    private long revision;
+    private String query;
+    private boolean queryDirty;
+    private boolean searchAvailable;
+    private boolean holdsAvailable;
+    private boolean sourcesAvailable;
+    private boolean bundlesAvailable;
+    private boolean holdInput;
+    private CookingUi.QuantitySelection quantity = CookingUi.QuantitySelection.inactive();
+    private ContainerUi.SelectedItem selectedItem;
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        this(message, recipes, System::nanoTime);
+    }
+
+    NativeCookingPresentation(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes, final LongSupplier clock) {
+        this.replace(message, recipes);
+        this.actions = new NativeCookingActions(message, clock);
+    }
+
+    boolean update(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (message.menuId() != this.message.menuId() || message.sequence() != this.message.sequence()
+                || message.updateSequence() <= this.message.updateSequence()
+                || message.view().family() != this.view.family()) return false;
+        this.replace(message, recipes);
+        this.actions.update(message);
+        return true;
+    }
+
+    private void replace(final NativeCookingMessage message, final Map<Integer, ItemStack> recipes) {
+        if (!recipes.keySet().equals(message.recipeItems().keySet()) || recipes.values().stream().anyMatch(ItemStack::isEmpty))
+            throw new IllegalArgumentException("Cooking previews differ from the authoritative catalog");
+        final var context = BedrockUiContext.program(message.context());
+        if (context == null) throw new IllegalArgumentException("Cooking belongs to another UI program");
+        final var view = message.view();
+        final var program = this.message != null && this.message.context() == message.context() && this.view.family() == view.family()
+                ? this.program.withTitle(view.title()) : message.ui(context);
+        final Map<Integer, ItemStack> copies = new HashMap<>();
+        recipes.forEach((id, item) -> copies.put(id, item.copy()));
+        if (this.view == null || !this.view.book().selection().equals(view.book().selection()))
+            this.selection = view.book().selection();
+        if (this.query == null || !this.queryDirty && (this.actions == null || !this.actions.queryPending()))
+            this.query = view.book().searchText();
+        this.message = message;
+        this.program = program;
+        this.view = view;
+        this.recipes = Map.copyOf(copies);
+        this.progress = view.progress();
+        this.dataRevision = -1;
+        this.revision++;
+    }
+
+    boolean update(final NativeCookingProgress update) {
+        if (update.menuId() != this.message.menuId() || update.sequence() != this.message.sequence()
+                || update.updateSequence() != this.message.updateSequence() || update.dataRevision() <= this.dataRevision) return false;
+        this.progress = update.progress();
+        this.dataRevision = update.dataRevision();
+        this.revision++;
+        return true;
+    }
+
+    NativeInventoryHelp help() { return this.help; }
+
+    void openHelp() {
+        if (!this.expired()) this.help.open(31);
+    }
+
+    NativeCookingMessage message() { return this.message; }
+
+    CookingUi.Selection selectedSource() { return this.selection; }
+
+    void selectedSource(final CookingUi.Selection source) {
+        if (!this.selection.equals(source)) { this.selection = source; this.revision++; }
+    }
+
+    void selectedItem(final ContainerUi.SelectedItem selected) {
+        if (!Objects.equals(this.selectedItem, selected)) { this.selectedItem = selected; this.revision++; }
+    }
+
+    boolean resetRecipe(final Consumer<NativeCookingAction> sender) { return this.actions.reset(sender); }
+
+    boolean idle() { return !this.holdInput && !this.queryDirty && this.actions.idle(); }
+
+    boolean searchAvailable() { return this.searchAvailable; }
+
+    boolean bundlesAvailable() { return this.bundlesAvailable; }
+    boolean bundlePending() { return this.actions.bundlePending(); }
+
+    void bundleCapability(final boolean available) {
+        if (this.bundlesAvailable && !available && this.actions.bundlePending()) this.retire();
+        this.bundlesAvailable = available;
+    }
+
+    boolean bundle(final String collection, final int index, final NativeBundleAction.Kind kind, final int tooltipMode,
+                   final int selectedCell, final Consumer<NativeCookingBundleAction> sender) {
+        return this.bundlesAvailable && !this.holdInput && !this.queryDirty
+                && this.actions.bundle(collection, index, kind, tooltipMode, selectedCell, sender);
+    }
+
+    boolean result(final NativeCookingBundleResult result, final Consumer<NativeBundleResult.Sound> sounds) {
+        if (!this.actions.result(result)) return false;
+        if (result.sound() != NativeBundleResult.Sound.NONE) sounds.accept(result.sound());
+        return true;
+    }
+
+    boolean holdsAvailable() { return this.holdsAvailable; }
+    boolean sourcesAvailable() { return this.sourcesAvailable; }
+    void sourceCapability(final boolean available) {
+        if (this.sourcesAvailable && !available && (this.actions.sourcePending() || this.actions.sourceDrawing())) this.retire();
+        this.sourcesAvailable = available;
+    }
+    boolean source(final int sourceSlot, final int destinationSlot, final int quantity,
+                   final NativeCookingSourceAction.Kind kind, final Consumer<NativeCookingSourceAction> sender) {
+        return this.sourcesAvailable && !this.holdInput && !this.queryDirty
+                && this.actions.source(sourceSlot, destinationSlot, quantity, kind, sender);
+    }
+    boolean sourcePending() { return this.actions.sourcePending(); }
+    boolean sourceDrawing() { return this.actions.sourceDrawing(); }
+    boolean sourceAdmitted() { return this.actions.sourceAdmitted(); }
+    void finishSourceDrawing() { this.actions.finishSourceDrawing(); }
+    boolean result(final NativeCookingSourceResult result) { return this.actions.result(result); }
+    void holdInput(final boolean active) { this.holdInput = active; }
+    void holdCapability(final boolean available) {
+        if (this.holdsAvailable && !available && (this.actions.holding() || this.actions.holdPending())) this.retire();
+        this.holdsAvailable = available;
+    }
+    boolean holding() { return this.actions.holding(); }
+    boolean holdPending() { return this.actions.holdPending(); }
+    boolean holdRejected() { return this.actions.holdRejected(); }
+    boolean hold(final int slot, final NativeCookingHoldAction.Phase phase, final int quantity,
+                 final Consumer<NativeCookingHoldAction> sender) {
+        return this.holdsAvailable && !this.queryDirty && this.actions.hold(slot, phase, quantity, sender);
+    }
+    boolean result(final NativeCookingHoldResult result) { return this.actions.result(result); }
+    void quantity(final CookingUi.QuantitySelection quantity) {
+        if (!this.quantity.equals(quantity)) { this.quantity = quantity; this.revision++; }
+    }
+
+    void searchCapability(final boolean available) {
+        if (this.searchAvailable == available) return;
+        if (!available && (this.queryDirty || this.actions.queryPending())) this.retire();
+        this.searchAvailable = available;
+        this.revision++;
+    }
+
+    String query() { return this.query; }
+
+    void restoreQuery(final String text) {
+        if (this.query.equals(text)) return;
+        this.query = text;
+        this.queryDirty = !text.equals(this.message.view().book().searchText());
+        this.revision++;
+    }
+
+    boolean query(final String text) {
+        if (!this.searchAvailable || this.holdInput || this.expired() || text.length() > NativeCookingQuery.MAX_TEXT_LENGTH) return false;
+        this.query = text;
+        this.queryDirty = true;
+        this.revision++;
+        return true;
+    }
+
+    boolean flushQuery(final Consumer<NativeCookingQuery> sender) {
+        if (!this.searchAvailable || this.holdInput || !this.queryDirty) return false;
+        this.queryDirty = false;
+        if (this.actions.query(this.query, sender)) return true;
+        this.queryDirty = true;
+        return false;
+    }
+
+    boolean result(final NativeCookingQueryResult result) {
+        if (!this.actions.result(result)) return false;
+        if (!result.accepted()) this.queryDirty = true;
+        else {
+            this.selection = new CookingUi.Selection("", -1);
+            this.revision++;
+        }
+        return true;
+    }
+
+    boolean forcedRecipeBookLayout() { return this.view.book().forcedRecipeBookLayout(); }
+
+    boolean action(final int recipe, final NativeCookingAction.Mode mode, final int controllerMode, final int phase, final Consumer<NativeCookingAction> sender) {
+        return !this.holdInput && (!this.queryDirty || phase == 2) && this.actions.send(recipe, mode, controllerMode, phase, sender);
+    }
+
+    boolean result(final NativeCookingActionResult result) { return this.actions.result(result); }
+
+    boolean expired() { return this.actions.expired(); }
+
+    void retire() { this.actions.retire(); }
+
+    boolean cancel(final Consumer<NativeCookingAction> sender) { return this.actions.cancel(sender); }
+    boolean cancel(final Consumer<NativeCookingAction> sender, final Consumer<NativeCookingHoldAction> heldSender) {
+        return this.actions.cancel(sender, heldSender);
+    }
+    boolean cancel(final Consumer<NativeCookingAction> sender, final Consumer<NativeCookingHoldAction> heldSender,
+                   final Consumer<NativeCookingSourceAction> sourceSender) {
+        return this.actions.cancel(sender, heldSender, sourceSender);
+    }
+
+    @Override public long revision() { return this.revision + this.help.revision(); }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags, final BundleTooltipUi.View tooltip) {
+        if (menuId != this.message.menuId()) throw new IllegalArgumentException("Cooking view belongs to another menu");
+        if (this.help.active()) return new Frame(this.help.resolve(), 3, Map.of(), Map.of());
+        final var source = this.view.book();
+        final var catalog = source.catalog().stream().map(recipe -> {
+            final Map<String, JsonElement> values = new HashMap<>(NativeInventoryItemPresentation.values(this.recipes.get(recipe.id()), false, showTags));
+            values.putAll(recipe.presentation());
+            return new CookingUi.Recipe(recipe.id(), recipe.uniqueId(), recipe.priority(), recipe.unlocked(), recipe.outputName(), recipe.evaluation(), values);
+        }).toList();
+        final var book = new CookingUi.Book(source.layout(), source.forcedRecipeBookLayout(), source.tab(), source.filtering(),
+                source.foodCount(), source.itemCount(), source.blockCount(), source.tabLabel(), this.query, this.selection, catalog, source.visibleRecipes());
+        final var scene = this.program.resolve(new CookingUi.MenuView(menuId, this.view.family(), this.view.title(), slots, cursor, this.progress, book), tooltip, this.quantity, this.selectedItem);
+        final var scope = CookingUi.actionScope(scene, book);
+        this.actions.presented(this.message, scope);
+        return new Frame(scene, 3, this.recipes, scope.actions());
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentationController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeCookingPresentationController.java
