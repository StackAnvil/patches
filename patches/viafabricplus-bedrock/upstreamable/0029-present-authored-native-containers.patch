+    @SuppressWarnings("unchecked")
+    private static boolean persistentTextVisibleAfterFrame(final BedrockNativeContainerScreen screen) throws Exception {
+        final var graphics = mock(GuiGraphicsExtractor.class, withSettings().extraInterfaces(IBedrockGuiItemStyle.class));
+        when(graphics.pose()).thenReturn(new Matrix3x2fStack(8));
+        when(((IBedrockGuiItemStyle) graphics).stackanvil$itemStyle()).thenReturn(NativeInventoryItemStyle.NORMAL);
+        final var logger = ViaFabricPlusBedrock.impl().logger();
+        doAnswer(call -> { throw new AssertionError("Unexpected frame fallback", (Throwable) call.getArgument(1)); })
+                .when(logger).warn(anyString(), any(Throwable.class));
+        // The native scissor extension is installed by client mixins, outside this unit fixture.
+        try (final var scissor = mockStatic(NativeUiScissor.class)) {
+            screen.extractContents(graphics, 0, 0, 0);
+        }
+        final var field = BedrockNativeContainerScreen.class.getDeclaredField("draws");
+        field.setAccessible(true);
+        final var draws = (List<NativeUiPresentation.Draw>) field.get(screen);
+        return draws.stream().anyMatch(draw -> draw.box().node().name().equals("persistent_text") && draw.alpha() > 0
+                && draw.box().node().flag("visible", true) && draw.box().visibleBounds().width() > 0);
+    }
