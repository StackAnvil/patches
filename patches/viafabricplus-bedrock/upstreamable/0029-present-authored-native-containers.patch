+
+@Mixin(PictureInPictureRenderer.class)
+public abstract class MixinNativeGuiOversizedItem {
+    @WrapOperation(method = "blitTexture", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/client/renderer/state/gui/GuiRenderState;addBlitToCurrentLayer(Lnet/minecraft/client/renderer/state/gui/BlitRenderState;)V"))
+    private void fadeOversizedItem(final GuiRenderState gui, final BlitRenderState blit, final Operation<Void> original,
+                                   @Local(argsOnly = true) final PictureInPictureRenderState picture) {
