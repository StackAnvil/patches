+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java
@@ -0,0 +1,95 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+/**
+ * The receiver's real menu lifetime and content-order state, independently testable without a
+ * renderer.
+ */
+final class NativeContainerPresentationController<C, M, P> {
+    private final NativeContainerSession<C, M> session = new NativeContainerSession<>();
+    private NativeContainerPending<C, M, P> pending;
+    private C owner;
+    private C contentOwner;
+    private M contentMenu;
+
+    void begin(final C owner) {
+        if (owner == null) throw new IllegalArgumentException("Native play session is required");
+        if (this.owner == owner) return;
+        this.clear();
+        this.owner = owner;
+    }
+
+    boolean claim(
+            final C owner,
+            final M menu,
+            final int currentMenuId,
+            final int messageMenuId,
+            final long sequence) {
+        if (owner == null || this.owner != owner) return false;
+        final boolean accepted =
+                this.session.accept(owner, menu, currentMenuId, messageMenuId, sequence);
+        if (accepted) this.pending = null;
+        return accepted;
+    }
+
+    P offer(
+            final C owner,
+            final M menu,
+            final int menuId,
+            final long sequence,
+            final boolean awaitingContents,
+            final long now,
+            final P presentation) {
+        if (!this.current(owner, menu, menuId) || this.session.sequence() != sequence)
+            return null;
+        if (awaitingContents && (this.contentOwner != owner || this.contentMenu != menu)) {
+            this.pending =
+                    new NativeContainerPending<>(owner, menu, menuId, sequence, now, presentation);
+            return null;
+        }
+        return presentation;
+    }
+
+    P contents(final C owner, final M menu, final int menuId, final long now) {
+        if (owner == null || this.owner != owner || menu == null) return null;
+        this.contentOwner = owner;
+        this.contentMenu = menu;
+        if (this.pending == null) return null;
+        final P result = this.pending.contents(owner, menu, menuId, this.session.sequence(), now);
+        this.pending = null;
+        return this.current(owner, menu, menuId) ? result : null;
+    }
+
+    void tick(final C owner, final M menu, final int menuId, final long now) {
+        if (this.owner != owner) return;
+        if (this.pending != null
+                && (!this.current(owner, menu, menuId)
+                        || !this.pending.current(
+                                owner, menu, menuId, this.session.sequence(), now)))
+            this.pending = null;
+        if (this.contentMenu != menu || this.contentOwner != owner) {
+            this.contentOwner = null;
+            this.contentMenu = null;
+        }
+    }
+
+    boolean current(final C owner, final M menu, final int menuId) {
+        return owner != null && this.owner == owner && this.session.current(owner, menu, menuId);
+    }
+
+    void clear(final C owner) {
+        if (this.owner == owner) this.clear();
+    }
+
+    void clear() {
+        this.owner = null;
+        this.session.clear();
+        this.pending = null;
+        this.contentOwner = null;
+        this.contentMenu = null;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerScroll.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerScroll.java
new file mode 100644
index 0000000..110ebd1
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerScroll.java
@@ -0,0 +1,143 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScroll;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Keeps scroll position across real menu model revisions without changing slot addresses. */
+final class NativeContainerScroll {
+    private final Map<String, Float> positions = new HashMap<>();
+    private final Map<NativeUiScene.Node, String> paths = new IdentityHashMap<>();
+    private String dragging;
+    private NativeUiScene.Node animationTarget;
+    private float grab;
+
+    Map<NativeUiScene.Node, Float> offsets(final NativeUiScene.Node root) {
+        final String target = this.paths.get(this.animationTarget);
+        this.paths.clear();
+        final Map<NativeUiScene.Node, Float> result = new IdentityHashMap<>();
+        this.index(root, "", result);
+        this.animationTarget = this.paths.entrySet().stream().filter(entry -> entry.getValue().equals(target))
+            .map(Map.Entry::getKey).findFirst().orElse(null);
+        return result;
+    }
+
+    NativeUiScene.Node animationTarget() { return this.animationTarget; }
+
+    private void index(final NativeUiScene.Node node, final String parent, final Map<NativeUiScene.Node, Float> result) {
+        final String path = parent + "/" + node.name()
+            + (node.properties().has("inventory_slot") ? "#" + node.properties().get("inventory_slot").getAsInt() : "");
+        if (node.scroll()) {
+            this.paths.put(node, path);
+            result.put(node, this.positions.getOrDefault(path, 0F));
+        }
+        for (final var child : node.children()) this.index(child, path, result);
+    }
+
+    boolean wheel(final NativeUiLayout.Box root, final double x, final double y, final double horizontal, final double vertical) {
+        final var view = this.target(root, x, y, false);
+        if (view == null) return false;
+        this.animationTarget = view.node();
+        final double delta = NativeUiScroll.horizontal(view) && horizontal != 0 ? horizontal : vertical;
+        this.set(view, this.offset(view) - (float) delta * view.node().number("scroll_speed", 18));
+        return true;
+    }
+
+    boolean press(final NativeUiLayout.Box root, final double x, final double y) {
+        final var view = this.target(root, x, y, true);
+        if (view == null) return false;
+        this.animationTarget = view.node();
+        final var model = NativeUiScroll.model(view, this.offset(view));
+        this.grab = model.containsThumb(x, y) ? model.pointer(x, y) - model.start() : model.extent() / 2;
+        this.dragging = this.paths.get(view.node());
+        this.set(view, model.offsetAt(model.pointer(x, y), this.grab));
+        return true;
+    }
+
+    boolean drag(final NativeUiLayout.Box root, final double x, final double y) {
+        if (this.dragging == null) return false;
+        final var view = this.find(root, this.dragging);
+        if (view != null) this.animationTarget = view.node();
+        final var model = view == null ? null : NativeUiScroll.model(view, this.offset(view));
+        if (model != null) this.set(view, model.offsetAt(model.pointer(x, y), Math.min(this.grab, model.extent())));
+        return true;
+    }
+
+    boolean reveal(final NativeUiLayout.Box box, final NativeUiScene.Node selected) {
+        this.animationTarget = null;
+        this.revealPath(box, selected);
+        return this.animationTarget != null;
+    }
+
+    private boolean revealPath(final NativeUiLayout.Box box, final NativeUiScene.Node selected) {
+        if (box.node() == selected) return true;
+        for (final var child : box.children()) {
+            if (!this.revealPath(child, selected)) continue;
+            if (box.node().scroll()) {
+                final var control = findNode(box, selected);
+                final var viewport = box.scrollViewport().intersect(box.clip());
+                final boolean horizontal = NativeUiScroll.horizontal(box);
+                final float start = horizontal ? control.bounds().x() : control.bounds().y();
+                final float extent = horizontal ? control.bounds().width() : control.bounds().height();
+                final float viewportStart = horizontal ? viewport.x() : viewport.y();
+                final float viewportExtent = horizontal ? viewport.width() : viewport.height();
+                final float delta = start < viewportStart ? start - viewportStart : Math.max(0, start + extent - viewportStart - viewportExtent);
+                if (delta != 0) {
+                    this.animationTarget = box.node();
+                    this.set(box, this.offset(box) + delta);
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    private static NativeUiLayout.Box findNode(final NativeUiLayout.Box box, final NativeUiScene.Node node) {
+        if (box.node() == node) return box;
+        for (final var child : box.children()) {
+            final var result = findNode(child, node);
+            if (result != null) return result;
+        }
+        return null;
+    }
+
+    boolean release() {
+        if (this.dragging == null) return false;
+        this.dragging = null;
+        return true;
+    }
+
+    private float offset(final NativeUiLayout.Box view) { return this.positions.getOrDefault(this.paths.get(view.node()), 0F); }
+    private void set(final NativeUiLayout.Box view, final float offset) {
+        this.positions.put(this.paths.get(view.node()), Math.clamp(offset, 0, NativeUiScroll.maximum(view)));
+    }
+
+    private NativeUiLayout.Box find(final NativeUiLayout.Box box, final String path) {
+        if (path.equals(this.paths.get(box.node()))) return box;
+        for (final var child : box.children()) {
+            final var result = this.find(child, path);
+            if (result != null) return result;
+        }
+        return null;
+    }
+
+    private NativeUiLayout.Box target(final NativeUiLayout.Box box, final double x, final double y, final boolean track) {
+        if (!box.node().flag("visible", true) || !box.node().flag("enabled", true) || !box.clip().contains(x, y)) return null;
+        for (final var child : box.children().reversed()) {
+            final var result = this.target(child, x, y, track);
+            if (result != null) return result;
+        }
+        if (!box.node().scroll() || NativeUiScroll.maximum(box) <= 0) return null;
+        if (!track) return box.bounds().contains(x, y) ? box : null;
+        final var model = NativeUiScroll.model(box, this.offset(box));
+        return model != null && model.originalThumb().node().flag("enabled", true) && model.containsTrack(x, y) ? box : null;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerSession.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerSession.java
