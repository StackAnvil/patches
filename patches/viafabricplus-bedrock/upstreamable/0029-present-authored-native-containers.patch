+        assertEquals("oak", presentation.query());
+        assertTrue(presentation.resolve(0, "", slots(), Map.of(), false).scene().toString().contains("First resource title"));
+        extra.getAsJsonObject("resource_label").addProperty("text", "Replacement resource title");
+        assertTrue(presentation.update(new NativePlayerInventoryMessage(0, 1, 8, 3,
+                authored.toString(), searched.snapshot(), Map.of()), Map.of(), Map.of()));
+        final String replaced = presentation.resolve(0, "", slots(), Map.of(), false).scene().toString();
