+                assertSame(menu, screen.getMenu());
+                player.containerMenu = ChestMenu.threeRows(7, inventory);
+                assertNull(screen.nativeHoveredSlot(101, 51));
+                screen.discard();
+            }
+        } finally { session.clear(); }
+    }
