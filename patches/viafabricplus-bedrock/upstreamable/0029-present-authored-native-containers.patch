--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeInventoryItemPresentation.java
@@ -0,0 +1,241 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.viaversion.nbt.io.NBTIO;
+import com.viaversion.nbt.limiter.TagLimiter;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.ByteTag;
+import net.minecraft.nbt.ByteArrayTag;
+import net.minecraft.nbt.IntArrayTag;
+import net.minecraft.nbt.StringTag;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.IntTag;
+import net.minecraft.nbt.NbtIo;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeItemHoverText;
+import net.raphimc.viabedrock.api.model.NativeBundleTooltipData;
+import net.raphimc.viabedrock.api.model.NativeBundleTooltipItems;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+import com.viaversion.viaversion.api.minecraft.item.Item;
+import net.raphimc.viabedrock.api.model.NativeItemStackData;
+import net.raphimc.viabedrock.api.model.NativeItemStorageData;
+import net.raphimc.viabedrock.api.resourcepack.ui.InventoryStackCount;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.function.Function;
+import java.util.stream.IntStream;
+import java.util.Map;
+
+/** Actual Java damage/count plus the original typed lock byte retained before conversion. */
+final class NativeInventoryItemPresentation {
+    private NativeInventoryItemPresentation() {}
+
+    static String countText(final int count, final String override) {
+        return override != null ? override : InventoryStackCount.format(count);
+    }
+
+    static Map<String, JsonElement> values(final ItemStack stack, final boolean cursor, final Boolean showTags) {
+        final var custom = stack.get(DataComponents.CUSTOM_DATA);
+        final CompoundTag data = custom == null ? new CompoundTag() : custom.copyTag();
+        final var storage = storage(stack, data);
+        final int lock = lock(data);
+        if (lock != 0 && !stack.isEmpty() && showTags == null)
+            throw new IllegalArgumentException("Native locked-item gamerule is unavailable");
+        final boolean showLock = !stack.isEmpty() && Boolean.TRUE.equals(showTags);
+        final String item = cursor ? "#selected_item_" : "#item_";
+        final String selected = cursor ? "#inventory_selected_item_" : "#item_";
+        final Map<String, JsonElement> result = new HashMap<>();
+        result.put(
+                cursor ? "#inventory_selected_item_stack_count" : "#inventory_stack_count",
+                new JsonPrimitive(stack.getCount()));
+        result.put(
+                item + "durability_visible",
+                new JsonPrimitive(stack.isDamageableItem() && stack.isDamaged()));
+        result.put(item + "durability_total_amount", new JsonPrimitive(stack.getMaxDamage()));
+        result.put(
+                item + "durability_current_amount",
+                new JsonPrimitive(stack.getMaxDamage() - stack.getDamageValue()));
+        result.put(selected + "lock_in_inventory", new JsonPrimitive(showLock && lock == 2));
+        result.put(selected + "lock_in_slot", new JsonPrimitive(showLock && lock == 1));
+        result.put(selected + "lock", new JsonPrimitive(showLock && lock != 0));
+        final String hover = hover(stack, data);
+        if (hover != null) result.put("#hover_text", new JsonPrimitive(hover));
+        if (storage != null) {
+            result.put(item + "storage_visible", new JsonPrimitive(storage.visible()));
+            result.put(item + "storage_total_amount", new JsonPrimitive((float) storage.capacity()));
+            result.put(item + "storage_current_amount", new JsonPrimitive((float) storage.weight()));
+        }
+        return Map.copyOf(result);
+    }
+
+    private static NativeItemStorageData storage(final ItemStack stack, final CompoundTag data) {
+        if (data.get(NativeItemStorageData.TAG) instanceof CompoundTag tag
+                && tag.get("version") instanceof IntTag version && version.intValue() == NativeItemStorageData.VERSION
+                && tag.get("modifier") instanceof IntTag modifier && tag.get("weight") instanceof IntTag weight
+                && tag.get("capacity") instanceof IntTag capacity)
+            return new NativeItemStorageData(modifier.intValue(), weight.intValue(), capacity.intValue());
+        if (data.contains(NativeItemStorageData.TAG) || bundle(stack, data))
+            throw new IllegalArgumentException("Native storage item has no complete weight snapshot");
+        return null;
+    }
+
+    static BundleTooltip bundleTooltip(final ItemStack stack, final Function<Item, ItemStack> decode) {
+        if (stack.isEmpty()) return null;
+        final var custom = stack.get(DataComponents.CUSTOM_DATA);
+        final var data = custom == null ? new CompoundTag() : custom.copyTag();
+        if (!data.contains(NativeItemStorageData.TAG) && !bundle(stack, data)) return null;
+        if (!(data.get(NativeBundleTooltipData.TAG) instanceof CompoundTag tag)
+                || !(tag.get("version") instanceof IntTag version) || version.intValue() != NativeBundleTooltipData.VERSION
+                || !(tag.get("identity") instanceof IntTag identity) || !(tag.get("viewable_slots") instanceof IntTag viewable)
+                || !(tag.get("amounts") instanceof IntArrayTag counts) || counts.size() > 64
+                || !(tag.get("primary_name") instanceof StringTag name)
+                || !(tag.get("empty_description") instanceof StringTag description)
+                || !(tag.get(NativeBundleTooltipItems.TAG) instanceof ByteArrayTag bytes))
+            throw new IllegalArgumentException("Native bundle tooltip snapshot is incomplete");
+        final var contents = new NativeBundleTooltipData(identity.intValue(), viewable.intValue(),
+                Arrays.stream(counts.getAsIntArray()).boxed().toList(), name.value(), description.value());
+        final var previews = NativeBundleTooltipItems.decode(bytes.getAsByteArray(), contents);
+        if (previews == null) throw new IllegalArgumentException("Native bundle previews differ from the source snapshot");
+        final List<ItemStack> items = new ArrayList<>(Collections.nCopies(contents.amounts().size(), ItemStack.EMPTY));
+        final List<String> names = new ArrayList<>(Collections.nCopies(contents.amounts().size(), ""));
+        for (final var entry : previews.entries().entrySet()) {
+            final var item = decode.apply(entry.getValue().item());
+            if (item == null || item.isEmpty() || item.getCount() != contents.amounts().get(entry.getKey()))
+                throw new IllegalArgumentException("Decoded native bundle preview changed its source count");
+            items.set(entry.getKey(), item);
+            names.set(entry.getKey(), entry.getValue().primaryName());
+        }
+        return new BundleTooltip(contents, storage(stack, data), names, items);
+    }
+
+    static void requireTooltip(final ItemStack stack) {
+        if (stack.isEmpty()) return;
+        final var custom = stack.get(DataComponents.CUSTOM_DATA);
+        final var data = custom == null ? new CompoundTag() : custom.copyTag();
+        if (data.contains(NativeItemStorageData.TAG) || bundle(stack, data))
+            throw new IllegalArgumentException("Native storage item tooltip contents are not yet supported");
+    }
+
+    private static boolean bundle(final ItemStack stack, final CompoundTag data) {
+        final String identifier = data.getStringOr(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "");
+        return stack.has(DataComponents.BUNDLE_CONTENTS) || identifier.equals("minecraft:bundle")
+                || identifier.startsWith("minecraft:") && identifier.endsWith("_bundle");
+    }
+
+    static String hover(final ItemStack item, final CompoundTag custom) {
+        if (item.isEmpty()) return "";
+        if (!(custom.get(ItemDataRewriter.BEDROCK_STACK_TAG) instanceof CompoundTag retained))
+            return null;
+        if (retained.sizeInBytes() > 1 << 20) return null;
+        try {
+            final var bytes = new BoundedBytes();
+            NbtIo.write(retained, new DataOutputStream(bytes));
+            final var tag =
+                    NBTIO.readTag(
+                            new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())),
+                            TagLimiter.create(1 << 20, 64),
+                            true,
+                            com.viaversion.nbt.tag.CompoundTag.class);
+            final var snapshot = NativeItemStackData.fromTag(tag);
+            return snapshot == null ? null : NativeItemHoverText.custom(false, snapshot.userData());
+        } catch (final IOException | IllegalArgumentException invalid) {
+            return null;
+        }
+    }
+
+    private static final class BoundedBytes extends ByteArrayOutputStream {
+        @Override
+        public synchronized void write(final int value) {
+            this.require(1);
+            super.write(value);
+        }
+
+        @Override
+        public synchronized void write(final byte[] bytes, final int offset, final int length) {
+            this.require(length);
+            super.write(bytes, offset, length);
+        }
+
+        private void require(final int length) {
+            if (length < 0 || this.count > (1 << 20) - length)
+                throw new IllegalArgumentException(
+                        "Retained native hover data exceeds its work limit");
+        }
+    }
+
+    static int lock(final CompoundTag custom) {
+        final var snapshot = custom.get(ItemDataRewriter.BEDROCK_STACK_TAG);
+        if (snapshot == null) return 0;
+        if (!(snapshot instanceof CompoundTag stack)
+                || !(stack.get("version") instanceof IntTag version)
+                || version.intValue() != NativeItemStackData.VERSION)
+            throw new IllegalArgumentException("Invalid retained native inventory stack");
+        final var userData = stack.get("user_data");
+        if (!(userData instanceof CompoundTag tag)) return 0;
+        return tag.get("minecraft:item_lock") instanceof ByteTag value
+                ? Byte.toUnsignedInt(value.byteValue())
+                : 0;
+    }
+    record BundleTooltip(NativeBundleTooltipData contents, NativeItemStorageData storage, List<String> names, List<ItemStack> items) {
+        BundleTooltip {
+            names = List.copyOf(names);
+            items = items.stream().map(ItemStack::copy).toList();
+            if (names.size() != contents.amounts().size() || items.size() != names.size())
+                throw new IllegalArgumentException("Incomplete decoded native bundle contents");
+            for (int slot = 0; slot < items.size(); slot++) {
+                if (items.get(slot).getCount() != contents.amounts().get(slot))
+                    throw new IllegalArgumentException("Decoded native bundle source count changed");
+            }
+        }
+
+        @Override
+        public List<ItemStack> items() { return this.items.stream().map(ItemStack::copy).toList(); }
+
+        ItemStack item(final int physicalSlot) { return this.items.get(physicalSlot).copy(); }
+
+        ItemStack item(final NativeUiScene.Node node) {
+            final var identity = node.properties().get("bundle_identity");
+            final var reference = node.properties().get("bundle_slot");
+            if (identity == null || !identity.isJsonPrimitive() || !identity.getAsJsonPrimitive().isNumber()
+                    || reference == null || !reference.isJsonPrimitive() || !reference.getAsJsonPrimitive().isNumber()
+                    || node.properties().has("inventory_slot") || node.properties().has("recipe_id") || node.flag("inventory_cursor", false))
+                throw new IllegalArgumentException("Invalid native bundle preview reference");
+            final int slot;
+            final int source;
+            try {
+                slot = reference.getAsBigDecimal().intValueExact();
+                source = identity.getAsBigDecimal().intValueExact();
+            } catch (final ArithmeticException invalid) {
+                throw new IllegalArgumentException("Invalid native bundle preview reference", invalid);
+            }
+            if (source != this.contents.identity() || slot < 0 || slot >= this.items.size() || this.contents.amounts().get(slot) == 0)
+                throw new IllegalArgumentException("Native bundle preview does not match its retained physical source");
+            return this.item(slot);
+        }
+
