+        assertEquals(new NativeCookingPreferenceControl(NativeCookingPreferenceControl.Kind.TAB, 2), geometry.preference(9, 1));
+    }
+
+    @Test
+    void globalAliasesCannotAuthorizeASeparateDirectPointerAction() {
+        final var slot = draw(0, true, 1, 0, 0, 18, new NativeUiLayout.Rect(0, 0, 100, 100), 1);
+        final var props = slot.box().node().properties();
+        final var action = new JsonObject();
+        action.addProperty("from_button_id", "button.menu_select");
+        action.addProperty("to_button_id", "button.container_auto_place_one");
+        action.addProperty("mapping_type", "pressed");
+        final var mappings = new JsonArray();
+        mappings.add(action);
+        props.add("button_mappings", mappings);
+        props.getAsJsonArray("inventory_actions").add(action.deepCopy());
+        assertDoesNotThrow(() -> new NativeContainerGeometry(List.of(slot), 1, Map.of(), true));
+        action.addProperty("scope", "global");
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(slot), 1, Map.of(), true));
+        action.remove("scope");
+        final var alias = new JsonObject();
+        alias.addProperty("from_button_id", "button.menu_ok");
+        alias.addProperty("to_button_id", "button.menu_select");
+        alias.addProperty("mapping_type", "global");
+        alias.addProperty("scope", "global");
+        final var aliases = new JsonArray();
+        aliases.add(alias);
+        final var hostProperties = new JsonObject();
+        hostProperties.add("button_mappings", aliases);
+        final var host = new NativeUiScene.Node("alias", "input_panel", hostProperties, List.of(), Integer.MIN_VALUE);
+        final var hostBox = new NativeUiLayout.Box(host, slot.box().bounds(), slot.box().clip(), slot.box().content(), slot.box().scrollViewport(), 0, List.of());
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(slot, new NativeUiPresentation.Draw(hostBox, 1, 1, true)), 1, Map.of(), true));
+    }
+
+    @Test
+    void incompletePreferenceStatesAndUnsupportedInputCannotBecomeActionable() {
+        for (int invalid = 0; invalid < 10; invalid++) {
+            final var toggle = preference();
+            final var properties = toggle.box().node().properties();
+            final var mapping = properties.getAsJsonArray("button_mappings").get(0).getAsJsonObject();
+            switch (invalid) {
+                case 0 -> properties.addProperty("toggle_state", "false");
+                case 1 -> properties.addProperty("toggle_group_forced_index", 2.0);
+                case 2 -> properties.addProperty("toggle_name", "unknown_group");
+                case 3 -> properties.add("recipe_actions", new JsonArray());
+                case 4 -> properties.addProperty("toggle_group_forced_index", 0);
+                case 5 -> { mapping.addProperty("from_button_id", "any"); mapping.addProperty("scope", "global"); }
+                case 6 -> properties.addProperty("inventory_slot", 0);
+                case 7 -> { properties.addProperty("toggle_name", "layout_toggle"); properties.addProperty("toggle_group_forced_index", 3); }
+                case 8 -> { properties.addProperty("toggle_name", "layout_toggle"); properties.addProperty("toggle_group_forced_index", "1"); }
+                case 9 -> { properties.addProperty("toggle_name", "layout_toggle"); properties.addProperty("toggle_group_forced_index", 1.0); }
+            }
+            assertThrows(RuntimeException.class, () -> new NativeContainerGeometry(List.of(toggle), 1, Map.of(), true));
+        }
+    }
+
+    @Test
+    void disabledTooltipControlsStayInactiveAndAreRevalidatedBeforeTheyBecomeActionable() {
+        final var properties = new JsonObject();
+        properties.add("button_mappings", JsonParser.parseString("""
+            [{"from_button_id":"button.menu_select","to_button_id":"button.tapped_bundle_tooltip","mapping_type":"pressed"}]
+            """).getAsJsonArray());
+        final var node = new NativeUiScene.Node("empty_button", "button", properties, List.of(), Integer.MIN_VALUE);
+        final var rect = new NativeUiLayout.Rect(0, 0, 18, 18);
+        final var box = new NativeUiLayout.Box(node, rect, rect, new NativeUiLayout.Size(18, 18), rect, 0, List.of());
+        final var disabled = new NativeUiPresentation.Draw(box, 1, 1, false);
+        final var enabled = new NativeUiPresentation.Draw(box, 1, 1, true);
+        final var geometry = new NativeContainerGeometry(List.of(disabled), 46, Map.of(), false, true);
+        assertEquals(-1, geometry.hovered(9, 9));
+        assertFalse(geometry.reusableFor(List.of(enabled)));
+        assertThrows(IllegalArgumentException.class, () -> new NativeContainerGeometry(List.of(enabled), 46, Map.of(), false, true));
+    }
+
+    private static NativeUiPresentation.Draw preference() {
+        final var properties = com.google.gson.JsonParser.parseString("""
+                {"toggle_name":"navigation_tab","toggle_group_forced_index":2,"toggle_state":false,
+                 "button_mappings":[{"from_button_id":"button.menu_select","to_button_id":"button.menu_select","mapping_type":"pressed"}]}
+                """).getAsJsonObject();
