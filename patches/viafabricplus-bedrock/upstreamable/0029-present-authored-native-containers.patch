+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeCookingPresentationTest {
+    @BeforeAll
+    static void bootstrap() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        if (!Items.IRON_INGOT.builtInRegistryHolder().areComponentsBound()) {
+            Items.IRON_INGOT.builtInRegistryHolder().bindComponents(DataComponentMap.EMPTY);
+        }
+        Class.forName(StructuredDataKey.class.getName());
+    }
+
+    @Test
+    void anOlderCellExitCannotEraseNewSelectionOrAdvanceItsRevision() {
+        for (final var family : CookingUi.Family.values()) {
+            final var presentation = new NativeCookingPresentation(message(family, 1), Map.of(7, new ItemStack(Items.IRON_INGOT)));
+            assertTrue(presentation.select("recipe_book", 0));
+            assertTrue(presentation.select("inventory_items", 3));
+            final long revision = presentation.revision();
+            assertFalse(presentation.deselect("recipe_book", 0));
+            assertFalse(presentation.deselect("inventory_items", 2));
+            assertEquals(revision, presentation.revision());
+            assertTrue(presentation.deselect("inventory_items", 3));
+            assertEquals(revision + 1, presentation.revision());
+            assertFalse(presentation.deselect("", -1));
+            assertTrue(presentation.select("recipe_book", 0));
+            assertTrue(presentation.update(message(family, 2), Map.of(7, new ItemStack(Items.IRON_INGOT))));
+            assertTrue(presentation.deselect("recipe_book", 0));
+        }
+    }
+
+    @Test
+    void realRecipesAndProgressResolveWithoutChangingItemAuthority() {
+        for (final var family : CookingUi.Family.values()) {
+            final var message = message(family, 1);
+            final var stack = new ItemStack(Items.IRON_INGOT, 3);
+            final var presentation = new NativeCookingPresentation(message, Map.of(7, stack));
+            stack.setCount(64);
+            final var before = presentation.resolve(5, "", slots(), Map.of(), false);
+            assertEquals(3, before.recipes().get(7).getCount());
+            final var identity = NativeCookingControl.forMessage(message, NativeCookingControl.Mode.ACTIVATE);
+            final var progress = new CookingUi.Progress(50, 100, 200, 0);
+            final long revision = presentation.revision();
+            assertTrue(presentation.update(new NativeCookingProgress(5, 3, 1, 1, progress)));
+            assertEquals(revision + 1, presentation.revision());
+            final var after = presentation.resolve(5, "", slots(), Map.of(), false);
+            assertEquals(progress.arrowRatio(family), arrow(after.scene()));
+            assertEquals(1F, arrow(before.scene()));
+            assertEquals(identity, NativeCookingControl.forMessage(presentation.message(), NativeCookingControl.Mode.ACTIVATE));
+            assertEquals(0, presentation.message().view().progress().cooking());
+            assertFalse(presentation.update(new NativeCookingProgress(5, 3, 1, 1, progress)));
+            assertFalse(presentation.update(new NativeCookingProgress(5, 2, 1, 2, progress)));
+            assertTrue(presentation.update(message(family, 2), Map.of(7, new ItemStack(Items.IRON_INGOT, 3))));
+            assertFalse(presentation.update(new NativeCookingProgress(5, 3, 1, 3, progress)));
+            assertFalse(presentation.update(message(family, 1), Map.of(7, new ItemStack(Items.IRON_INGOT, 3))));
+            assertThrows(IllegalArgumentException.class, () -> presentation.resolve(6, "", slots(), Map.of(), false));
+        }
+    }
+
+    @Test
+    void nativeRecipeScenesReachTheSharedLayoutWithDistinctInventoryAndRecipeIdentities() {
+        final var presentation = new NativeCookingPresentation(message(CookingUi.Family.FURNACE, 1), Map.of(7, new ItemStack(Items.IRON_INGOT, 3)));
+        final var frame = presentation.resolve(5, "", slots(), Map.of(), false);
+        final var scene = NativeUiScene.parse(frame.scene().toString(), BedrockNativeContainerScreen.RENDERERS);
+        final var images = new NativeUiImages();
+        final var renderer = new NativeUiRenderer(mock(Font.class), images);
+        try {
+            final var root = new NativeUiLayout(renderer).layout(scene.root(), 427, 240, Map.of());
+            final var draws = NativeUiPresentation.draws(root, _ -> false);
+            assertEquals(39, draws.stream().map(draw -> draw.box().node().properties()).filter(n -> n.has("inventory_slot"))
+                    .map(n -> n.get("inventory_slot").getAsInt()).distinct().count());
+            final var recipes = draws.stream().map(draw -> draw.box().node().properties()).filter(n -> n.has("recipe_id")).toList();
+            assertFalse(recipes.isEmpty());
+            assertTrue(recipes.stream().allMatch(n -> n.get("recipe_id").getAsInt() == 7 && !n.has("inventory_slot")));
+        } finally { renderer.close(); images.close(); }
+    }
+
+    private static float arrow(final JsonObject scene) {
+        return nodes(scene.getAsJsonObject("root")).stream().filter(n -> n.has("clip_ratio")
+                && n.has("clip_direction") && n.get("clip_direction").getAsString().equals("left"))
+                .findFirst().orElseThrow().get("clip_ratio").getAsFloat();
+    }
+
+    private static List<JsonObject> nodes(final JsonObject node) {
+        final List<JsonObject> result = new ArrayList<>();
+        result.add(node);
+        if (node.has("children")) node.getAsJsonArray("children").forEach(child -> result.addAll(nodes(child.getAsJsonObject())));
+        return result;
+    }
+
+    private static List<ContainerUi.Slot> slots() {
+        return IntStream.range(0, 39).mapToObj(slot -> new ContainerUi.Slot(slot,
+                Map.of("#inventory_stack_count", new JsonPrimitive(slot == 0 ? 2 : 0)))).toList();
+    }
+
+    static NativeCookingMessage message(final CookingUi.Family family, final long update) {
+        final var book = new CookingUi.Book(2, false, 4, false, 0, 1, 0, "", "", new CookingUi.Selection("", -1),
+                List.of(new CookingUi.Recipe(7, "test:iron", 0, true, "iron_ingot", 1,
+                        Map.of("#container_item_background", new JsonPrimitive(1)))), Set.of(7));
+        final var view = new CookingUi.MenuView(5, family, new ContainerUi.Title("", false), slots(), Map.of(), new CookingUi.Progress(0, 0, 0, 0), book);
+        return NativeCookingMessage.create(new ResourcePackStorage(List.of()).getCookingUi(), view, 3, update, 1, 2, 3,
+                Map.of(7, new StructuredItem(BuiltInRegistries.ITEM.getId(Items.IRON_INGOT), 3, new StructuredDataContainer())));
+    }
+}
