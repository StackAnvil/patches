+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import net.raphimc.viabedrock.api.model.NativeItemStackData;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class NativeInventoryItemPresentationTest {
+    @Test
+    void retainedTypedLockModesKeepSlotAndCursorScopesWithoutNumericCoercion() {
+        final var stack = mock(ItemStack.class);
+        when(stack.getCount()).thenReturn(8);
+        when(stack.getMaxDamage()).thenReturn(100);
+        when(stack.getDamageValue()).thenReturn(35);
+        when(stack.isDamageableItem()).thenReturn(true);
+        when(stack.isDamaged()).thenReturn(true);
+        final var data = new CompoundTag();
+        final var snapshot = new CompoundTag();
+        snapshot.putInt("version", NativeItemStackData.VERSION);
+        data.put(ItemDataRewriter.BEDROCK_STACK_TAG, snapshot);
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        final var userData = new CompoundTag();
+        snapshot.put("user_data", userData);
+        for (final int mode : new int[] {0, 1, 2, 3, 255}) {
+            userData.putByte("minecraft:item_lock", (byte) mode);
+            when(stack.get(DataComponents.CUSTOM_DATA)).thenReturn(CustomData.of(data));
+            assertEquals(mode, NativeInventoryItemPresentation.lock(data));
+            if (mode != 0) {
+                assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, null));
+                final var shown = NativeInventoryItemPresentation.values(stack, false, true);
+                assertEquals(mode == 1, shown.get("#item_lock_in_slot").getAsBoolean());
+                assertEquals(mode == 2, shown.get("#item_lock_in_inventory").getAsBoolean());
+                assertTrue(shown.get("#item_lock").getAsBoolean());
+                assertFalse(NativeInventoryItemPresentation.values(stack, true, false)
+                    .get("#inventory_selected_item_lock_in_inventory").getAsBoolean());
+                continue;
+            }
+            final var slot = NativeInventoryItemPresentation.values(stack, false, null);
+            final var cursor = NativeInventoryItemPresentation.values(stack, true, null);
+            assertFalse(slot.get("#item_lock_in_slot").getAsBoolean());
+            assertFalse(cursor.get("#inventory_selected_item_lock_in_inventory").getAsBoolean());
+            assertFalse(slot.get("#item_lock").getAsBoolean());
+            assertEquals(8, slot.get("#inventory_stack_count").getAsInt());
+            assertEquals(65, slot.get("#item_durability_current_amount").getAsInt());
+            assertFalse(slot.containsKey("#inventory_selected_item_lock_in_inventory"));
+            assertFalse(slot.containsKey("#item_storage_visible"));
+        }
+        userData.putInt("minecraft:item_lock", 1);
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        userData.putString("minecraft:item_lock", "2");
+        assertEquals(0, NativeInventoryItemPresentation.lock(data));
+        snapshot.putInt("version", NativeItemStackData.VERSION + 1);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.lock(data));
+        when(stack.has(DataComponents.BUNDLE_CONTENTS)).thenReturn(true);
+        assertThrows(IllegalArgumentException.class, () -> NativeInventoryItemPresentation.values(stack, false, null));
+    }
+}
