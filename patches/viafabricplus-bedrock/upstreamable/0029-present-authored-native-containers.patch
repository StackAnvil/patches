+    private boolean cursorEvents(final NativeContainerInput.Result result) {
+        final boolean available = !this.helpView && !(this.presentation instanceof NativePlayerPresentation player && player.helping());
+        boolean handled = false;
+        for (final var event : result.events()) {
+            final var input = event.button();
+            if (input == null || input.phase() != 0 && input.phase() != 1) continue;
+            final int button = NativeContainerInput.cursorDropButton(input.target());
+            if (button < 0) continue;
+            if (input.transition() && available && this.componentEnabled() && this.nativeInput.enabled(event.node())
+                    && !this.actionScope.subset() && !this.menu.getCarried().isEmpty())
+                this.slotClicked(null, -999, button, ContainerInput.PICKUP);
+            handled = true;
+        }
+        return handled;
+    }
