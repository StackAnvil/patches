+                1, new StructuredItem(321, 1, new StructuredDataContainer()));
+        final var selected = new NativePlayerInventoryMessage(source.context(),0, 1, 8, 2, source.snapshot(), Map.of(), wireGhosts);
+        final var output = new ItemStack(Items.IRON_INGOT, 4);
+        final var ghosts = Map.of(0, output, 1, new ItemStack(Items.IRON_INGOT));
+        final var presentation = new NativePlayerPresentation(selected, Map.of(), ghosts, () -> 0);
+        output.setCount(64);
+        final var actual = new ArrayList<>(slots());
+        final var first = presentation.resolve(0, "", actual, Map.of(), false);
+        assertEquals(Set.of(0, 1), first.craftingPreview().keySet());
+        assertEquals(4, first.craftingPreview().get(0).getCount());
+        assertEquals(0, actual.get(1).presentation().get("#inventory_stack_count").getAsInt());
+        assertTrue(first.recipes().isEmpty());
