+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Original progress consumer math; device-pixel quantization is supplied by the Java render context. */
+final class NativeInventoryProgress {
+    private NativeInventoryProgress() {}
+
+    static List<Quad> quads(final NativeUiLayout.Box box, final float alpha, final float scale) {
+        final var node = box.node();
+        final JsonObject bag = node.properties().has("property_bag") ? node.properties().getAsJsonObject("property_bag") : new JsonObject();
+        final boolean storage = flag(bag, "is_storage_bar"), durability = flag(bag, "is_durability");
+        if (!node.flag(durability ? "touch_progress_bar_visible" : "progress_bar_visible", false)) return List.of();
+        final float total = node.number("progress_bar_total_amount", 0), current = node.number("progress_bar_current_amount", 0);
+        if (!Float.isFinite(scale) || scale <= 0 || total <= 0 || current < 0)
+            throw new IllegalArgumentException("Unsupported native inventory progress input");
+        final float fraction = Math.min(current / total, 1);
+        final boolean shadow = flag(bag, "drop_shadow");
+        final float x = box.bounds().x(), y = box.bounds().y();
+        final float width = box.bounds().width() + (shadow ? 1 : 0);
+        final float height = box.bounds().height() + (shadow ? 1 : 0);
+        final float left = quantize(x, scale), top = quantize(y, scale);
+        final float right = quantize(x + width, scale), bottom = quantize(y + height, scale);
+        final List<Quad> result = new ArrayList<>();
+        if (shadow) result.add(quad(left, top, right, bottom, new Color(0, 0, 0, alpha)));
+        final Color background = durability ? new Color(0, 0, 0, alpha) : color(node, "secondary_color", .3F, .3F, .3F, alpha);
+        result.add(quad(left, top, right - (shadow ? 1 : 0), bottom - (shadow ? 1 : 0), background));
+        float end = quantize(x + fraction * width, scale);
+        if (shadow && right - end < 1) end = right - 1;
+        if (flag(bag, "round_value")) end = x + (float) Math.floor(width * fraction);
+        if (storage) end = x + Math.min(width, (float) Math.floor((width - 1) * fraction + 1));
+        final Color fill = durability ? new Color(Math.min(1, 2 - 2 * fraction), Math.min(1, 2 * fraction), 0, alpha)
+            : storage && fraction == 1 && node.properties().has("full_storage_color") ? color(node, "full_storage_color", 1, .4F, .4F, alpha)
+                : color(node, "primary_color", 0, 1, 0, alpha);
+        result.add(quad(left, top, end, bottom - (shadow ? 1 : 0), fill));
+        return List.copyOf(result);
+    }
+
+    private static boolean flag(final JsonObject bag, final String name) {
+        final var value = bag.get(name);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean() && value.getAsBoolean();
+    }
+
+    private static float quantize(final float value, final float scale) { return (int) (value * scale) / scale; }
+    private static Quad quad(final float x, final float y, final float right, final float bottom, final Color color) {
+        return new Quad(new NativeUiLayout.Rect(x, y, right - x, bottom - y), color);
+    }
+    private static Color color(final NativeUiScene.Node node, final String name, final float red, final float green,
+            final float blue, final float alpha) {
+        return new Color(NativeUiLayout.vector(node, name, 0, red), NativeUiLayout.vector(node, name, 1, green),
+            NativeUiLayout.vector(node, name, 2, blue), alpha);
+    }
+
+    record Quad(NativeUiLayout.Rect bounds, Color color) {}
+    record Color(float red, float green, float blue, float alpha) {
+        int argb() {
+            return Math.round(Math.clamp(this.alpha, 0, 1) * 255) << 24 | Math.round(Math.clamp(this.red, 0, 1) * 255) << 16
+                | Math.round(Math.clamp(this.green, 0, 1) * 255) << 8 | Math.round(Math.clamp(this.blue, 0, 1) * 255);
+        }
+    }
+}
