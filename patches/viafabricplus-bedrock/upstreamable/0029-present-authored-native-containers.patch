+        return NativeCookingMessage.create(new ResourcePackStorage(List.of()).getCookingUi(), view, 3, update, 1, 2, 3,
+                Map.of(7, new StructuredItem(BuiltInRegistries.ITEM.getId(Items.IRON_INGOT), 3, new StructuredDataContainer())));
+    }
