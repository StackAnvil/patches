@@ -0,0 +1,328 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiInput;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.api.model.NativeCookingAction;
+
+/** Authored, clipped controls share one front-to-back policy for slot and command input. */
+final class NativeContainerGeometry {
+    static final Set<String> PLAYER_FALLBACK_ACTIONS = Set.of("button.container_reset_held", "button.destroy_selection");
+    static final Set<String> RECIPE_AUXILIARY_ACTIONS = Set.of("button.drop_one", "button.drop_all", "button.shape_drawing");
+    private static final Set<String> RECIPE_MAPPING_FIELDS = Set.of("from_button_id", "to_button_id", "mapping_type", "ignored", "consume_event");
+    private final Set<NativeUiScene.Node> searchClear = Collections.newSetFromMap(new IdentityHashMap<>());
+    private final List<ControlRegion> controls;
+    private final List<NativeUiPresentation.Draw> draws;
+    private final Set<Integer> registered = new HashSet<>();
+    private boolean navigation;
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount) {
+        this(draws, slotCount, Map.of());
+    }
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount,
+                            final Map<Integer, Set<String>> recipeActions) {
+        this(draws, slotCount, recipeActions, false);
+    }
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount,
+                            final Map<Integer, Set<String>> recipeActions, final boolean cooking) {
+        this(draws, slotCount, recipeActions, cooking, false);
+    }
+
+    NativeContainerGeometry(final List<NativeUiPresentation.Draw> draws, final int slotCount,
+                            final Map<Integer, Set<String>> recipeActions, final boolean cooking, final boolean player) {
+        this.draws = List.copyOf(draws);
+        if (cooking) for (final var draw : draws) {
+            if (cookingSearchEditor(draw.box().node())) this.collectSearchClear(draw.box().node());
+        }
+        final Set<Integer> reinjected = new HashSet<>();
+        if (cooking) for (final var draw : draws) {
+            final var input = NativeUiInput.parse(draw.box().node().properties());
+            for (final var mapping : input.mappings()) if (mapping.scope() == NativeUiInput.Scope.GLOBAL) reinjected.add(mapping.target());
+            for (final var mapping : input.hoverBindings()) if (mapping.scope() == NativeUiInput.Scope.GLOBAL) reinjected.add(mapping.target());
+        }
+        final List<ControlRegion> regions = new ArrayList<>();
+        for (final var draw : draws) {
+            final var box = draw.box();
+            final var node = box.node();
+            final var recipe = recipe(node, draw.enabled(), recipeActions);
+            final var preference = cooking ? NativeCookingPreferenceControl.parse(node) : null;
+            final boolean navigation = cooking && NativeCookingNavigation.mapped(node);
+            if (draw.enabled()) validateActions(node, recipe, cooking, reinjected, player, this.searchClear.contains(node));
+            final boolean mappedSlot = node.properties().has("inventory_actions") && node.properties().has("inventory_slot");
+            final Set<String> help = player ? helpInputs(node) : Set.of();
+            final boolean command = !help.isEmpty() || node.type().equals("button") && (node.string("inventory_command", "").equals("close") || node.flag("help_close", false));
+            if (mappedSlot && recipe != null) throw new IllegalArgumentException("Recipe control cannot also own an inventory slot");
+            if (navigation && (mappedSlot || recipe != null))
+                throw new IllegalArgumentException("Native navigation cannot also own an inventory or recipe action");
+            this.navigation |= navigation;
+            final Set<String> clearInputs = this.searchClear.contains(node) ? searchClearInputs(node) : Set.of();
+            if (!mappedSlot && !command && recipe == null && preference == null && !navigation && clearInputs.isEmpty()) continue;
+            final int slot = mappedSlot ? node.properties().get("inventory_slot").getAsInt() : -1;
+            if (mappedSlot && (slot < 0 || slot >= slotCount))
+                throw new IllegalArgumentException("Invalid native inventory slot");
+            // A mapped control remains registered while its entrance animation has zero extent.
+            // Pointer regions below still require visible, non-empty geometry.
+            if (mappedSlot) this.registered.add(slot);
+            if (draw.enabled() && draw.alpha() > 0 && box.visibleBounds().width() > 0 && box.visibleBounds().height() > 0) {
+                regions.add(new ControlRegion(slot, closeInputs(node), help, clearInputs, recipe, preference, box.bounds(), box.clip(), box.layer()));
+            }
+        }
+        // Later draws cover earlier controls when their authored layers are equal.
+        final var frontToBack = new ArrayList<>(regions.reversed());
+        frontToBack.sort(Comparator.comparingDouble(ControlRegion::layer).reversed());
+        this.controls = List.copyOf(frontToBack);
+    }
+
+    /** Box identity retains bounds, clipping, layers and the prepared scene's action mappings. */
+    boolean reusableFor(final List<NativeUiPresentation.Draw> draws) {
+        if (this.draws.size() != draws.size()) return false;
+        for (int index = 0; index < draws.size(); index++) {
+            final var previous = this.draws.get(index);
+            final var current = draws.get(index);
+            if (previous.box() != current.box() || previous.enabled() != current.enabled()
+                    || (previous.alpha() > 0) != (current.alpha() > 0)) return false;
+        }
+        return true;
+    }
+
+    static boolean cookingSearchEditor(final NativeUiScene.Node node) {
+        if (!node.type().equals("edit_box")) return false;
+        final var input = NativeUiInput.parse(node.properties());
+        if (input.mappings().isEmpty() || input.options().wildcard()) return false;
+        if (node.string("text_box_name", "").equals("item_name"))
+            return input.mappings().stream().allMatch(mapping -> mapping.target() == NativeUiInput.symbol("button.search_bar_selected"));
+        final var bag = node.properties().get("property_bag");
+        if (!node.string("text_box_name", "").equals("#text_box_name") || bag == null || !bag.isJsonObject()
+                || !bag.getAsJsonObject().has("#property_field")
+                || !bag.getAsJsonObject().get("#property_field").equals(new JsonPrimitive("#item_name"))) return false;
+        final Set<Integer> targets = Set.of(NativeUiInput.symbol("button.search_bar_selected"),
+                NativeUiInput.symbol("button.search_bar_deselected"), NativeUiInput.symbol("button.search_bar_clear"));
+        return input.mappings().stream().allMatch(mapping -> targets.contains(mapping.target()))
+                && input.mappings().stream().anyMatch(mapping -> mapping.target() == NativeUiInput.symbol("button.search_bar_selected") && mapping.handleSelect())
+                && input.hoverBindings().stream().allMatch(mapping -> mapping.target() == NativeUiInput.symbol("button.search_bar_hovered"));
+    }
+
+    private void collectSearchClear(final NativeUiScene.Node node) {
+        for (final var child : node.children()) {
+            if (child.type().equals("button") && NativeUiInput.parse(child.properties()).mappings().stream()
+                    .anyMatch(mapping -> mapping.target() == NativeUiInput.symbol("button.text_edit_box_clear"))) this.searchClear.add(child);
+            this.collectSearchClear(child);
+        }
+    }
+
+    private static Set<String> searchClearInputs(final NativeUiScene.Node node) {
+        final Set<String> inputs = new HashSet<>();
+        for (final var value : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = value.getAsJsonObject();
+            if (!NativeUiScene.string(mapping, "to_button_id", "").equals("button.text_edit_box_clear")
+                    || !NativeUiScene.string(mapping, "mapping_type", "").equals("pressed") || mapping.has("ignored") && mapping.get("ignored").getAsBoolean()) continue;
+            inputs.add(NativeUiScene.string(mapping, "from_button_id", ""));
+        }
+        inputs.remove("");
+        return Set.copyOf(inputs);
+    }
+
+    boolean clearsSearch(final NativeUiScene.Node node) { return this.searchClear.contains(node); }
+
+    boolean clearsSearch(final double x, final double y, final String input) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.searchClearInputs.contains(input);
+        return false;
+    }
+
+    private static Set<String> closeInputs(final NativeUiScene.Node node) {
+        if (!(node.string("inventory_command", "").equals("close") || node.flag("help_close", false)) || !node.properties().has("button_mappings")) return Set.of();
+        final Set<String> inputs = new HashSet<>();
+        for (final var element : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = element.getAsJsonObject();
+            if (mapping.has("ignored") && mapping.get("ignored").getAsBoolean()) continue;
+            if (!NativeUiScene.string(mapping, "mapping_type", "").equals("pressed")) continue;
+            if (Set.of("button.menu_exit", "button.try_menu_exit").contains(NativeUiScene.string(mapping, "to_button_id", "")))
+                inputs.add(NativeUiScene.string(mapping, "from_button_id", ""));
+        }
+        inputs.remove("");
+        return Set.copyOf(inputs);
+    }
+
+    private static Set<String> helpInputs(final NativeUiScene.Node node) {
+        if (!node.type().equals("button") || !node.properties().has("button_mappings")) return Set.of();
+        final Set<String> inputs = new HashSet<>();
+        for (final var value : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = value.getAsJsonObject();
+            if (mapping.has("ignored") && mapping.get("ignored").getAsBoolean()) continue;
+            if (NativeUiScene.string(mapping, "mapping_type", "").equals("pressed")
+                    && NativeUiScene.string(mapping, "to_button_id", "").equals("button.help"))
+                inputs.add(NativeUiScene.string(mapping, "from_button_id", ""));
+        }
+        inputs.remove("");
+        return Set.copyOf(inputs);
+    }
+
+    private static RecipeControl recipe(final NativeUiScene.Node node, final boolean enabled, final Map<Integer, Set<String>> authority) {
+        if (!node.properties().has("recipe_actions")) return null;
+        if (!node.type().equals("button") || !node.string("collection", "").equals("recipe_book")
+                || !node.properties().has("recipe_id") || node.properties().has("inventory_slot") || node.properties().has("inventory_actions"))
+            throw new IllegalArgumentException("Recipe input has no distinct authored cell");
+        final int id = node.properties().get("recipe_id").getAsBigDecimal().intValueExact();
+        final Map<String, NativeCookingAction.Mode> inputs = new HashMap<>();
+        for (final var value : node.properties().getAsJsonArray("recipe_actions")) {
+            final var mapping = value.getAsJsonObject();
+            if (mapping.has("ignored")) {
+                if (!mapping.get("ignored").isJsonPrimitive() || !mapping.get("ignored").getAsJsonPrimitive().isBoolean())
+                    throw new IllegalArgumentException("Invalid native recipe mapping state");
+                if (mapping.get("ignored").getAsBoolean()) continue;
+            }
+            if (!RECIPE_MAPPING_FIELDS.containsAll(mapping.keySet())
+                    || !mappingString(mapping, "from_button_id") || !mappingString(mapping, "to_button_id") || !mappingString(mapping, "mapping_type")
+                    || mapping.has("consume_event") && (!mapping.get("consume_event").isJsonPrimitive()
+                        || !mapping.get("consume_event").getAsJsonPrimitive().isBoolean()))
+                throw new IllegalArgumentException("Unsupported native recipe mapping attributes");
+            final var mode = java.util.Arrays.stream(NativeCookingAction.Mode.values())
+                    .filter(candidate -> candidate.button().equals(NativeUiScene.string(mapping, "to_button_id", ""))).findFirst().orElseThrow();
+            final String source = NativeUiScene.string(mapping, "from_button_id", "");
+            if (source.isEmpty() || !NativeUiScene.string(mapping, "mapping_type", "").equals("pressed")
+                    || mapping.has("consume_event") && !mapping.get("consume_event").getAsBoolean()
+                    || enabled && !authority.getOrDefault(id, Set.of()).contains(mode.button())
+                    || closeInputs(node).contains(source)
+                    || !node.properties().getAsJsonArray("button_mappings").contains(mapping))
+                throw new IllegalArgumentException("Unsupported or unauthorized native recipe mapping");
+            final var previous = inputs.putIfAbsent(source, mode);
+            if (previous != null && previous != mode) throw new IllegalArgumentException("Ambiguous native recipe input");
+        }
+        if (id < 0 || inputs.keySet().stream().noneMatch(Set.of("button.menu_select", "button.menu_secondary_select")::contains))
+            throw new IllegalArgumentException("Native recipe has no supported pointer input");
+        return new RecipeControl(id, Map.copyOf(inputs));
+    }
+
+    private static boolean mappingString(final JsonObject mapping, final String key) {
+        return mapping.has(key) && mapping.get(key).isJsonPrimitive() && mapping.get(key).getAsJsonPrimitive().isString();
+    }
+
+    private static void validateActions(final NativeUiScene.Node node, final RecipeControl recipe, final boolean cooking, final Set<Integer> reinjected, final boolean player, final boolean searchClear) {
+        if (!node.type().equals("button") || !node.properties().has("button_mappings")) return;
+        final Set<String> supported = new HashSet<>();
+        if (cooking && NativeCookingNavigation.mapped(node)) supported.addAll(NativeCookingNavigation.TARGETS);
+        if (cooking) supported.add("button.search_bar_clear");
+        if (searchClear) supported.add("button.text_edit_box_clear");
+        if (recipe != null) recipe.inputs.values().forEach(mode -> supported.add(mode.button()));
+        if (recipe != null) supported.add("button.container_slot_hovered");
+        if (recipe != null && player) supported.addAll(RECIPE_AUXILIARY_ACTIONS);
+        if (player) supported.addAll(PLAYER_FALLBACK_ACTIONS);
+        if (player && node.properties().has("inventory_slot")) supported.add("button.container_auto_destroy");
+        if (player) supported.addAll(Set.of("button.help", "button.search_bar_clear", "button.left_panel_tab_increment", "button.left_panel_tab_decrement",
+                "button.hide_bundle_tooltip", "button.tapped_bundle_item_icon"));
+        if (node.properties().has("inventory_actions")) {
+            for (final var action : node.properties().getAsJsonArray("inventory_actions"))
+                supported.add(action.getAsJsonObject().get("to_button_id").getAsString());
+        }
+        if (node.string("inventory_command", "").equals("close") || node.flag("help_close", false)) {
+            supported.add("button.menu_exit");
+            supported.add("button.try_menu_exit");
+        }
+        if (cooking) {
+            // These commands still use the direct pointer controller below. GLOBAL aliases
+            // must not bypass that controller's action ownership or press/release protocol.
+            final Set<Integer> pointerTargets = new HashSet<>();
+            for (final String target : supported) {
+                if (!NativeCookingNavigation.TARGETS.contains(target) && !target.equals("button.container_slot_hovered"))
+                    pointerTargets.add(NativeUiInput.symbol(target));
+            }
+            final var input = NativeUiInput.parse(node.properties());
+            if (input.mappings().stream().anyMatch(mapping -> pointerTargets.contains(mapping.target())
+                    && (mapping.scope() == NativeUiInput.Scope.GLOBAL || reinjected.contains(mapping.source())))
+                    || input.hoverBindings().stream().anyMatch(mapping -> pointerTargets.contains(mapping.target()) && mapping.scope() == NativeUiInput.Scope.GLOBAL))
+                throw new IllegalArgumentException("Unsupported native reinjected pointer action");
+        }
+        for (final var element : node.properties().getAsJsonArray("button_mappings")) {
+            final var mapping = element.getAsJsonObject();
+            final var ignored = mapping.get("ignored");
+            if (ignored != null && ignored.isJsonPrimitive() && ignored.getAsJsonPrimitive().isBoolean() && ignored.getAsBoolean()) continue;
+            final var action = mapping.get("to_button_id");
+            if (action != null && !action.getAsString().isEmpty() && !supported.contains(action.getAsString()))
+                throw new IllegalArgumentException("Unsupported native inventory button action " + action.getAsString() + " on " + node.name());
+        }
+    }
+
+    int hovered(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.slot;
+        return -1;
+    }
+
+    RecipeControl recipe(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.recipe;
+        return null;
+    }
+
+    record RecipeControl(int id, Map<String, NativeCookingAction.Mode> inputs) { }
+
+    NativeCookingPreferenceControl preference(final double x, final double y) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.preference;
+        return null;
+    }
+
+    boolean hasPreferences() { return this.navigation || this.controls.stream().anyMatch(region -> region.preference != null); }
+
+    boolean hasLayoutPreferences() {
+        return this.controls.stream().anyMatch(region -> region.preference != null
+                && region.preference.kind() == NativeCookingPreferenceControl.Kind.LAYOUT);
+    }
+
+    boolean contains(final int slot, final double x, final double y) {
+        return slot >= 0 && this.hovered(x, y) == slot;
+    }
+
+    boolean closes(final double x, final double y, final String input) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.closeInputs.contains(input);
+        return false;
+    }
+
+    boolean help(final double x, final double y, final String input) {
+        for (final var region : this.controls) if (region.contains(x, y)) return region.helpInputs.contains(input);
+        return false;
+    }
+
+    void requireAuthoredCoverage(final Set<Integer> requiredSlots, final int slotCount) {
+        if (requiredSlots.isEmpty()) {
+            throw new IllegalArgumentException("Native inventory has no actionable slots");
+        }
+        for (final int slot : requiredSlots) {
+            if (slot < 0 || slot >= slotCount) {
+                throw new IllegalArgumentException("Invalid authored inventory slot");
+            }
+            if (!this.registered.contains(slot)) {
+                throw new IllegalArgumentException(
+                        "Native inventory has an inaccessible authored slot");
+            }
+        }
+    }
+
+    void requireComplete(final int slotCount) {
+        for (int slot = 0; slot < slotCount; slot++) {
+            if (!this.registered.contains(slot))
+                throw new IllegalArgumentException("Native inventory has inaccessible slots");
+        }
+    }
+
+    private record ControlRegion(int slot, Set<String> closeInputs, Set<String> helpInputs, Set<String> searchClearInputs, RecipeControl recipe, NativeCookingPreferenceControl preference,
+                                 NativeUiLayout.Rect bounds, NativeUiLayout.Rect clip, float layer) {
+        boolean contains(final double x, final double y) { return this.bounds.intersect(this.clip).contains(x, y); }
+    }
+}
