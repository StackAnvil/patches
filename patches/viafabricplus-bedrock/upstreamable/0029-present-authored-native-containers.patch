+                new NativeUiPresentation.Draw(toggle.box(), 1, 1, false))) {
+            final var geometry = new NativeContainerGeometry(List.of(slot, inactive), 1, Map.of(), true);
+            assertEquals(0, geometry.hovered(9, 1));
+            assertNull(geometry.preference(9, 1));
+            assertFalse(geometry.hasPreferences());
