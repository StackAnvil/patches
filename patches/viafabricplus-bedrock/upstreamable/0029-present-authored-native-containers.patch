+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemOpacity;
+import net.minecraft.client.gui.navigation.ScreenRectangle;
+import net.minecraft.client.renderer.state.gui.BlitRenderState;
+import org.joml.Matrix3x2f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class NativeInventoryItemOpacityTest {
+    @Test
+    void cachedPremultipliedTextureFadesAtSubmissionWithoutChangingGeometryOrOpaqueUsers() {
+        final var clip = new ScreenRectangle(0, 0, 40, 40);
+        final var source = new BlitRenderState(null, null, new Matrix3x2f(),
+                2, 3, 18, 19, 0.2F, 0.4F, 0.3F, 0.5F, 0xC0804020, clip, clip);
+        final var half = NativeInventoryItemOpacity.apply(source, 0.5F);
+        assertEquals(0x60402010, half.color());
+        assertSame(source.pose(), half.pose());
+        assertSame(clip, half.scissorArea());
+        assertSame(source.bounds(), half.bounds());
+        assertEquals(source.u0(), half.u0());
+        assertEquals(source.v1(), half.v1());
+        assertSame(source, NativeInventoryItemOpacity.apply(source, 1));
+        assertEquals(0, NativeInventoryItemOpacity.apply(source, 0).color());
+        assertEquals(0xC0804020, source.color());
+
+        final var vertices = mock(VertexConsumer.class, RETURNS_SELF);
+        half.buildVertices(vertices);
+        verify(vertices, times(4)).setColor(half.color());
+        verify(vertices).addVertexWith2DPose(half.pose(), 2F, 3F);
+        verify(vertices).addVertexWith2DPose(half.pose(), 18F, 19F);
+    }
+
+    @Test
+    void nestedExtractionRestoresOpacityEvenWhenItemExtractionFails() {
+        final var graphics = new IBedrockGuiItemOpacity() {
+            private float opacity = 1;
+            public float stackanvil$itemOpacity() { return this.opacity; }
+            public void stackanvil$itemOpacity(final float value) { this.opacity = value; }
+        };
+        final var failure = new IllegalStateException();
+        NativeInventoryItemOpacity.extract(graphics, 0.5F, () -> {
+            assertEquals(0.5F, graphics.stackanvil$itemOpacity());
+            assertSame(failure, assertThrows(IllegalStateException.class,
+                    () -> NativeInventoryItemOpacity.extract(graphics, 0.25F, () -> {
+                        assertEquals(0.25F, graphics.stackanvil$itemOpacity());
+                        throw failure;
+                    })));
+            assertEquals(0.5F, graphics.stackanvil$itemOpacity());
+        });
+        assertEquals(1, graphics.stackanvil$itemOpacity());
+        for (final float invalid : new float[]{Float.NaN, Float.POSITIVE_INFINITY, -1, 2})
+            assertThrows(IllegalArgumentException.class,
+                    () -> NativeInventoryItemOpacity.extract(graphics, invalid, () -> fail()));
+        assertEquals(1, graphics.stackanvil$itemOpacity());
+    }
+}
