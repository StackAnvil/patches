+            when(game.getConnection()).thenReturn(owner);
+            final var current = new AtomicBoolean(true);
+            final var implementation = mock(ViaFabricPlusBedrock.class);
+            when(implementation.logger()).thenReturn(mock(Logger.class));
+            try (final var singleton = mockStatic(Minecraft.class);
+                 final var entrypoint = mockStatic(ViaFabricPlusBedrock.class)) {
+                singleton.when(Minecraft::getInstance).thenReturn(game);
+                entrypoint.when(ViaFabricPlusBedrock::impl).thenReturn(implementation);
+                final var presentation = new NativeContainerPresentation(program(), ContainerUi.Kind.CHEST_3_ROWS, List.of());
+                final var screen = new BedrockNativeContainerScreen(owner, ordinary, inventory, Component.empty(),
+                        presentation, false, 1, () -> 0, current::get);
+                final var minecraft = Screen.class.getDeclaredField("minecraft");
+                minecraft.setAccessible(true);
+                minecraft.set(screen, game);
+                final var font = Screen.class.getDeclaredField("font");
+                font.setAccessible(true);
+                font.set(screen, mock(Font.class));
+                when(gui.screen()).thenReturn(screen);
+                try {
+                    screen.init(640, 320);
+                    current.set(false);
+                    if (!sameMenu) player.containerMenu = ChestMenu.threeRows(8, inventory);
+                    assertDoesNotThrow(() -> screen.resize(512, 300));
+                    if (sameMenu) verify(game).setScreenAndShow(ordinary);
+                    else verify(game, never()).setScreenAndShow(any());
+                    assertSame(carried, menu.getCarried());
+                    assertEquals(3, menu.getCarried().getCount());
+                    verify(player, never()).closeContainer();
+                } finally {
+                    screen.discard();
+                }
+            }
