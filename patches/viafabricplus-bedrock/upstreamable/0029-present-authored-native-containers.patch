+        assertEquals(30, layout(input, replacement).bounds().width(), 0.0001);
+        assertTrue(replacement.children().get(2).flag("visible", true));
+        assertFalse(input.button("button.menu_ok", false, 1, 2, true).consumed());
+        assertEquals(20, layout(input, replacement).bounds().width(), 0.0001);
+    }
+
+    @Test
+    void ancestorAndOwnEnabledChangesKeepTheirSeparatePressLifetimes() {
+        final var input = new NativeContainerInput(_ -> { });
+        final var button = button(true, true);
+        final var host = new NativeUiScene.Node("host", "panel", properties(100, 100), List.of(button), Integer.MIN_VALUE);
+        layout(input, host);
