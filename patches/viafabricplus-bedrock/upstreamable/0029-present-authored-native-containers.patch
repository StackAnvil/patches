+                || this.minecraft.options.keyInventory.matches(event)) this.onClose();
+        return true;
+    }
+
+    private boolean supportsKeyboardInput(final NativeUiScene.Node node, final NativeUiInput.Mapping mapping) {
+        if (mapping.scope() == NativeUiInput.Scope.VIEW) return NativeContainerInput.supportsViewTarget(mapping.target());
+        final int target = mapping.target();
+        if (node.type().equals("toggle") || target == NativeUiInput.symbol("button.container_slot_hovered")
+                || NativeCookingNavigation.supports(target)) return true;
+        if (node.properties().has("recipe_id")) {
+            final int recipe = node.properties().get("recipe_id").getAsInt();
+            return this.presentation instanceof NativePlayerPresentation && isDropTarget(target)
+                    || this.recipeActions.getOrDefault(recipe, Set.of()).stream().anyMatch(action -> NativeUiInput.symbol(action) == target);
+        }
+        if (this.presentation instanceof NativePlayerPresentation && playerUnsupportedHostAction(target)) return true;
+        if (node.properties().has("inventory_slot"))
+            return this.presentation instanceof NativePlayerPresentation && playerSlotInput(target) != null
+                || this.nativeActions && this.actionScope.subset() && target == NativeUiInput.symbol("button.container_auto_place_one");
+        if (this.presentation instanceof NativeCookingPresentation cooking && cooking.searchAvailable()
+                && target == NativeUiInput.symbol("button.search_bar_clear")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && target == NativeUiInput.symbol("button.help")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && target == NativeUiInput.symbol("button.hide_bundle_tooltip")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && target == NativeUiInput.symbol("button.tapped_bundle_item_icon")) return true;
+        if (this.presentation instanceof NativePlayerPresentation && NativeContainerInput.cursorDropButton(target) >= 0) return true;
