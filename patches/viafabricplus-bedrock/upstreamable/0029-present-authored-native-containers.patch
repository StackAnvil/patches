@@ -0,0 +1,91 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.google.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiToggle;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.api.resourcepack.ui.BundleTooltipUi;
+
+final class NativeContainerPresentation implements NativeInventoryPresentation {
+    private final ContainerUi program;
+    private final ContainerUi.Kind kind;
+    private final int containerSlots;
+    private List<Integer> data;
+    private long revision;
+    private final Map<String, Boolean> toggles = new HashMap<>();
+
+    NativeContainerPresentation(final ContainerUi program, final ContainerUi.Kind kind, final List<Integer> data) {
+        this(program, kind, kind.containerSlots(), data);
+    }
+
+    NativeContainerPresentation(final ContainerUi program, final ContainerUi.Kind kind, final int containerSlots, final List<Integer> data) {
+        kind.validateContainerSlots(containerSlots);
+        this.program = program;
+        this.kind = kind;
+        this.containerSlots = containerSlots;
+        this.data(data);
+    }
+
+    ContainerUi.Kind kind() { return this.kind; }
+
+    void data(final List<Integer> values) {
+        this.kind.validateData(values);
+        if (!values.equals(this.data)) {
+            this.data = List.copyOf(values);
+            this.revision++;
+        }
+    }
+
+    @Override public long revision() { return this.revision; }
+
+    @Override
+    public Frame resolve(final int menuId, final String title, final List<ContainerUi.Slot> slots,
+                         final Map<String, JsonElement> cursor, final Boolean showTags, final BundleTooltipUi.View tooltip) {
+        final var view = new ContainerUi.MenuView(menuId, this.kind, title, slots, cursor, this.data, this.containerSlots);
+        var scene = this.program.resolve(view, tooltip, this.toggles);
+        if (scene != null && this.defaults(scene.getAsJsonObject("root")))
+            scene = this.program.resolve(view, tooltip, this.toggles);
+        if (scene == null) throw new IllegalArgumentException("Unresolved native inventory presentation");
+        return new Frame(scene, this.containerSlots, Map.of(), Map.of());
+    }
+
+    private boolean defaults(final JsonObject node) {
+        boolean added = false;
+        if (node.has("type") && node.get("type").getAsString().equals("toggle")) {
+            final String alias = node.has("toggle_view_binding_name") && !node.get("toggle_view_binding_name").getAsString().isEmpty()
+                    ? node.get("toggle_view_binding_name").getAsString() : node.get("name").getAsString();
+            if (!alias.isEmpty() && !this.toggles.containsKey(alias)) {
+                final int index = node.has("collection_index") ? node.get("collection_index").getAsInt() : 0;
+                this.toggles.put(alias, NativeUiToggle.parse(JsonParser.parseString(node.toString()).getAsJsonObject()).initialChecked(index));
+                added = true;
+            }
+        }
+        if (node.has("children")) for (final var child : node.getAsJsonArray("children"))
+            added |= this.defaults(child.getAsJsonObject());
+        return added;
+    }
+
+    boolean localControls() { return !this.toggles.isEmpty(); }
+
+    boolean toggles(final Map<String, Boolean> values) {
+        boolean changed = false;
+        for (final var entry : values.entrySet()) {
+            if (this.toggles.containsKey(entry.getKey()) && !this.toggles.get(entry.getKey()).equals(entry.getValue())) {
+                this.toggles.put(entry.getKey(), entry.getValue());
+                changed = true;
+            }
+        }
+        if (changed) this.revision++;
+        return changed;
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/container/NativeContainerPresentationController.java
