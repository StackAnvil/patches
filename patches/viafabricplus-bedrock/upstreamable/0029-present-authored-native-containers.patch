+                    && event.button().target() != NativeUiInput.symbol("button.container_take_half_place_one")) return false;
+        try {
+            final var source = new Source(event.collection(), event.collectionIndex());
+            final var clicked = this.sourceItem(source);
+            if (clicked == null) return false;
+            final var kind = this.tooltipSources.desktopBundleInput(event, this.tooltipData(NativeInventorySourceState.CURSOR) != null,
+                    this.menu.getCarried().isEmpty(), this.tooltipData(source) != null, clicked.isEmpty());
+            if (kind == null || !BedrockNativePlayerInventory.bundlesAvailable(this.owner, this.menu)) return false;
+            if (player.idle()) BedrockNativePlayerInventory.bundle(this.owner, this.menu, source, kind, this.tooltipSources.mode());
+            return true;
+        } catch (final RuntimeException unsupported) { this.fallback(unsupported); return true; }
+    }
+
+    private FurnaceOptions changePreference(final NativeCookingPreferenceControl control, final NativeUiToggle.Change change,
+                                            final FurnaceOptions current) {
+        if (!(this.presentation instanceof NativeCookingPresentation cooking) || !cooking.idle()
