+            assertTrue(presentation.update(message(family, 2), Map.of(7, new ItemStack(Items.IRON_INGOT, 3))));
+            assertFalse(presentation.update(new NativeCookingProgress(5, 3, 1, 3, progress)));
+            assertFalse(presentation.update(message(family, 1), Map.of(7, new ItemStack(Items.IRON_INGOT, 3))));
+            assertThrows(IllegalArgumentException.class, () -> presentation.resolve(6, "", slots(), Map.of(), false));
+        }
+    }
+
+    @Test
+    void nativeRecipeScenesReachTheSharedLayoutWithDistinctInventoryAndRecipeIdentities() {
+        final var presentation = new NativeCookingPresentation(message(CookingUi.Family.FURNACE, 1), Map.of(7, new ItemStack(Items.IRON_INGOT, 3)));
+        final var frame = presentation.resolve(5, "", slots(), Map.of(), false);
+        final var scene = NativeUiScene.parse(frame.scene().toString(), BedrockNativeContainerScreen.RENDERERS);
+        final var images = new NativeUiImages();
+        final var renderer = new NativeUiRenderer(mock(Font.class), images);
+        try {
+            final var root = new NativeUiLayout(renderer).layout(scene.root(), 427, 240, Map.of());
+            final var draws = NativeUiPresentation.draws(root, _ -> false);
+            assertEquals(39, draws.stream().map(draw -> draw.box().node().properties()).filter(n -> n.has("inventory_slot"))
+                    .map(n -> n.get("inventory_slot").getAsInt()).distinct().count());
+            final var recipes = draws.stream().map(draw -> draw.box().node().properties()).filter(n -> n.has("recipe_id")).toList();
+            assertFalse(recipes.isEmpty());
+            assertTrue(recipes.stream().allMatch(n -> n.get("recipe_id").getAsInt() == 7 && !n.has("inventory_slot")));
+        } finally { renderer.close(); images.close(); }
