+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockGuiItemOpacity;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiAnimationLifecycle;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiImages;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiPresentation;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiRenderer;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScreen;
+import com.viaversion.viafabricplus.injection.access.core.IConnection;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.ContainerInput;
+import net.minecraft.world.inventory.Slot;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeContainerAction;
+import net.raphimc.viabedrock.api.resourcepack.ui.ContainerUi;
+import net.raphimc.viabedrock.protocol.storage.GameRulesStorage;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.function.LongSupplier;
+import java.util.function.BooleanSupplier;
+
+/**
+ * Real menu presentation; generic menus retain vanilla dispatch, scoped count-one controls use the
+ * negotiated native request backend.
+ */
+public final class BedrockNativeContainerScreen extends AbstractContainerScreen<AbstractContainerMenu> implements NativeUiScreen {
+    static final Set<String> RENDERERS =
+            Set.of(
+                    "inventory_item_renderer",
+                    "hover_text_renderer",
+                    "progress_bar_renderer",
+                    "flying_item_renderer",
+                    "live_horse_renderer");
+    private final ClientPacketListener owner;
+    private final AbstractContainerScreen<?> ordinary;
+    private final NativeInventoryPresentation presentation;
+    private final boolean nativeActions;
+    private final long sequence;
+    private final LongSupplier clock;
+    private final BooleanSupplier currentOwner;
+    private ContainerUi.ActionScope actionScope =
+            new ContainerUi.ActionScope(false, Set.of(), Set.of());
+    private boolean activated;
+    private boolean activationPending;
+    private int activationTicks;
+    private final NativeUiImages images = new NativeUiImages();
+    private NativeUiRenderer renderer;
+    private NativeUiScene.Node scene;
+    private NativeUiAnimationLifecycle lifecycle;
+    private long animationStarted;
+    private long layoutRevision;
+    private NativeUiLayout.Box root;
+    private NativeContainerGeometry geometry;
+    private List<NativeUiPresentation.Draw> draws = List.of();
+    private long previousPresentationRevision = -1;
+    private Map<Integer, ItemStack> recipePreviews = Map.of();
+    private List<ItemStack> previous = List.of();
+    private ItemStack previousCarried = ItemStack.EMPTY;
+    private boolean fallingBack;
+    private final NativeContainerScroll scroll = new NativeContainerScroll();
+    private final NativeInventoryFlights flights = new NativeInventoryFlights();
+    private final Map<Integer, Preview> previews = new HashMap<>();
+    private final Map<Integer, NativeInventoryFlights.Anchor> anchors = new HashMap<>();
+    private NativeUiScene.Node flightOwner;
+    private final Set<NativeUiScene.Node> vanillaCursor = Collections.newSetFromMap(new IdentityHashMap<>());
+    private Slot drawingSlot;
+    private long imageRevision;
+    private Boolean showTags;
+
+    BedrockNativeContainerScreen(
+            final ClientPacketListener owner,
+            final AbstractContainerScreen<?> ordinary,
+            final Inventory inventory,
+            final Component title,
+            final ContainerUi program,
+            final ContainerUi.Kind kind,
+            final boolean nativeActions,
+            final long sequence, final List<Integer> data) {
+        this(owner, ordinary, inventory, title, program, kind, nativeActions, sequence, data, System::nanoTime);
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final ContainerUi program, final ContainerUi.Kind kind,
+                                final boolean nativeActions, final long sequence, final List<Integer> data, final LongSupplier clock) {
+        this(owner, ordinary, inventory, title, new NativeContainerPresentation(program, kind, data), nativeActions, sequence, clock);
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final NativeInventoryPresentation presentation,
+                                final boolean nativeActions, final long sequence, final LongSupplier clock) {
+        this(owner, ordinary, inventory, title, presentation, nativeActions, sequence, clock,
+                () -> BedrockNativeContainers.current(owner, ordinary.getMenu()));
+    }
+
+    BedrockNativeContainerScreen(final ClientPacketListener owner, final AbstractContainerScreen<?> ordinary, final Inventory inventory,
+                                final Component title, final NativeInventoryPresentation presentation,
+                                final boolean nativeActions, final long sequence, final LongSupplier clock, final BooleanSupplier currentOwner) {
+        super(ordinary.getMenu(), inventory, title);
+        this.ordinary = ordinary;
+        this.owner = owner;
+        this.presentation = presentation;
+        this.nativeActions = nativeActions;
+        this.sequence = sequence;
+        this.clock = clock;
+        this.currentOwner = currentOwner;
+    }
+
+    boolean updateData(final ClientPacketListener owner, final net.raphimc.viabedrock.api.model.NativeContainerData update) {
+        if (owner == this.owner && this.current() && update.menuId() == this.menu.containerId
+                && update.sequence() == this.sequence && this.presentation instanceof NativeContainerPresentation container
+                && update.kind() == container.kind()) {
+            container.data(update.data());
+            return true;
+        }
+        return false;
+    }
+
+    void prepare(final Font font, final int width, final int height) {
+        this.width = width;
+        this.height = height;
+        if (this.renderer != null) this.renderer.close();
+        this.renderer = new NativeUiRenderer(font, this.images);
+        this.refresh();
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        this.leftPos = 0;
+        this.topPos = 0;
+        if (this.renderer != null) this.renderer.close();
+        this.renderer = new NativeUiRenderer(this.font, this.images);
+        this.refresh();
+    }
+
+    private boolean current() {
+        return this.currentOwner.getAsBoolean();
+    }
+
+    private void refresh() {
+        if (!this.current())
+            throw new IllegalStateException("Native inventory no longer owns the current menu");
+        this.renderer.reset();
+        this.showTags = this.showTags();
+        final List<ContainerUi.Slot> slots = new ArrayList<>();
+        for (final Slot slot : this.menu.slots) slots.add(new ContainerUi.Slot(slot.index, NativeInventoryItemPresentation.values(slot.getItem(), false, this.showTags)));
+        final var frame = this.presentation.resolve(this.menu.containerId, this.title.getString(), slots,
+                NativeInventoryItemPresentation.values(this.menu.getCarried(), true, this.showTags), this.showTags);
+        final var resolved = frame.scene();
+        this.recipePreviews = frame.recipes();
+        this.actionScope =
+                this.nativeActions
+                        ? ContainerUi.actionScope(resolved, frame.containerSlots())
+                        : new ContainerUi.ActionScope(false, Set.of(), Set.of());
+        if (this.nativeActions) {
+            for (final int slot : this.actionScope.referencedSlots()) {
+                if (!slots.get(slot).presentation().containsKey("#hover_text")) {
+                    throw new IllegalArgumentException("Unsupported native manual item description");
+                }
+            }
+        }
+        this.scene = NativeUiScene.parse(resolved.toString(), RENDERERS).root();
+        if (this.lifecycle == null) {
+            this.animationStarted = this.clock.getAsLong();
+            this.lifecycle = new NativeUiAnimationLifecycle(this.scene);
+            this.lifecycle.animations().event(this.scene, "screen.entrance_push", 0);
+        } else this.lifecycle.replaceRoot(this.scene, this.animationTime());
+        this.layout(this.animationTime(), -1, -1);
+        for (final var draw : this.draws) {
+            final var node = draw.box().node();
+            final String custom = node.string("renderer", "");
+            if (custom.equals("inventory_item_renderer")
+                    && node.flag("disabled_filter_visible", false))
+                throw new IllegalArgumentException("Unsupported native inactive-item filter");
+            if (custom.equals("progress_bar_renderer"))
+                NativeInventoryProgress.quads(draw.box(), draw.alpha(), 1);
+        }
+        final var current = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        if (!this.previous.isEmpty()) this.flights.update(this.previous, current, this.anchors, this.clock.getAsLong());
+        this.previous = this.menu.slots.stream().map(slot -> slot.getItem().copy()).toList();
+        this.previousCarried = this.menu.getCarried().copy();
+        this.previousPresentationRevision = this.presentation.revision();
+        this.imageRevision = this.images.revision();
+        if (this.activated && !this.actionScope.subset())
+            throw new IllegalArgumentException("Native inventory action scope changed");
+    }
+
+    private long animationTime() { return this.clock.getAsLong() - this.animationStarted; }
+
+    private void scrollAnimation(final boolean released) {
+        final var target = this.scroll.animationTarget();
+        if (target == null || this.lifecycle == null) return;
+        final long now = this.animationTime();
+        this.lifecycle.animations().event(target, "scrollbar.active", now);
+        if (released) this.lifecycle.animations().event(target, "scrollbar.released", now);
+    }
+
+    private void layout(final long now, final double pointerX, final double pointerY) {
+        final var animations = this.lifecycle.animations();
+        this.lifecycle.advance(now);
+        this.renderer.prepare(this.scene);
+        this.root = new NativeUiLayout(this.renderer, animations).layout(this.scene, this.width, this.height, this.scroll.offsets(this.scene));
+        this.draws = NativeUiPresentation.draws(this.root, box -> box.visibleBounds().contains(pointerX, pointerY), node -> animations.opacityAt(node, now));
+        this.geometry = new NativeContainerGeometry(this.draws, this.menu.slots.size());
+        this.requireCoverage();
+        this.vanillaCursor.clear();
+        this.cursor(this.root, false);
+        this.anchors.clear();
+        this.flightOwner = null;
+        this.anchors(this.root);
+        this.layoutRevision = animations.layoutRevision();
+    }
+
+    private void requireCoverage() {
+        if (this.actionScope.subset()) {
+            this.geometry.requireAuthoredCoverage(this.actionScope.slots(), this.menu.slots.size());
+            this.requireSubsetMappings();
+        } else this.geometry.requireComplete(this.menu.slots.size());
+    }
+
+    private void requireSubsetMappings() {
+        for (final var draw : this.draws) {
+            if (!draw.box().node().properties().has("inventory_actions")) continue;
+            for (final var value :
+                    draw.box().node().properties().getAsJsonArray("inventory_actions")) {
+                final var mapping = value.getAsJsonObject();
+                final String target = mapping.get("to_button_id").getAsString();
+                if (target.equals("button.container_slot_hovered")) continue;
+                if (!target.equals("button.container_auto_place_one")
+                        || !mapping.get("mapping_type").getAsString().equals("pressed")
+                        || !Set.of("button.menu_select", "button.menu_ok")
+                                .contains(mapping.get("from_button_id").getAsString()))
+                    throw new IllegalArgumentException("Unsupported native subset input mapping");
+            }
+        }
+    }
+
+    void activate() {
+        if (!this.current() || !this.actionScope.subset() || !this.nativeActions) return;
+        this.activationPending = true;
+        this.activationTicks = 0;
+        this.send(NativeContainerAction.Mode.ACTIVATE, -1);
+    }
+
+    void activationResult(
+            final ClientPacketListener owner,
+            final net.raphimc.viabedrock.api.model.NativeContainerStatus status) {
+        if (owner != this.owner
+                || !this.current()
+                || !this.activationPending
+                || status.menuId() != this.menu.containerId
+                || status.sequence() != this.sequence) return;
+        if (!status.accepted()) {
+            this.fallback(
+                    new IllegalArgumentException("Server rejected native inventory action scope"));
+            return;
+        }
+        this.activationPending = false;
+        this.activated = true;
+    }
+
+    private void send(final NativeContainerAction.Mode mode, final int slot) {
+        if (!this.current()) return;
+        ClientPlayNetworking.send(
+                new NativeContainerActionPayload(
+                        new NativeContainerAction(
+                                this.menu.containerId,
+                                this.sequence,
+                                this.menu.getStateId(),
+                                mode,
+                                slot)));
+    }
+
+    private void deactivate() {
+        try {
+            if (this.activated || this.activationPending)
+                this.send(NativeContainerAction.Mode.DEACTIVATE, -1);
+        } finally {
+            this.activated = false;
+            this.activationPending = false;
+        }
+    }
+
+    private Boolean showTags() {
+        if (!(this.owner.getConnection() instanceof IConnection connection)) return null;
+        final var user = connection.viaFabricPlus$getUserConnection();
+        final var storage = user == null ? null : user.get(GameRulesStorage.class);
+        final Object rule = storage == null ? null : storage.getGameRule("showTags");
+        return rule instanceof Boolean value ? value : null;
+    }
+
+    @Override
+    protected void containerTick() {
+        if (!this.current()) return;
+        if (this.activationPending && ++this.activationTicks >= 100) {
+            this.fallback(new IllegalStateException("Native inventory activation timed out"));
+            return;
+        }
+        boolean changed = this.presentation.revision() != this.previousPresentationRevision || this.previous.size() != this.menu.slots.size()
+            || !ItemStack.matches(this.previousCarried, this.menu.getCarried());
+        for (int i = 0; !changed && i < this.previous.size(); i++)
+            changed = !ItemStack.matches(this.previous.get(i), this.menu.slots.get(i).getItem());
+        if (changed || !Objects.equals(this.showTags, this.showTags()) || this.images.revision() != this.imageRevision) {
+            this.refreshSafely();
+        }
+    }
+
+    private void refreshSafely() {
+        try {
+            this.refresh();
+        } catch (final RuntimeException error) {
+            this.fallback(error);
+        }
+    }
+
+    public Slot nativeHoveredSlot(final double x, final double y) {
+        if (!this.current() || this.geometry == null) return null;
+        final int index = this.geometry.hovered(x, y);
+        return index >= 0 && this.menu.slots.get(index).isActive() ? this.menu.slots.get(index) : null;
+    }
+
+    public boolean nativeIsHovering(final Slot slot, final double x, final double y) {
+        return this.current() && this.geometry != null && this.geometry.contains(slot.index, x, y);
+    }
+
+    @Override
+    public void extractContents(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        if (!this.current() || this.geometry == null) return;
+        try {
+            final long now = this.animationTime();
+            this.lifecycle.advance(now);
+            if (this.lifecycle.animations().layoutRevision() != this.layoutRevision) this.layout(now, mouseX, mouseY);
+            this.draws = NativeUiPresentation.draws(this.root, box -> box.visibleBounds().contains(mouseX, mouseY),
+                node -> this.lifecycle.animations().opacityAt(node, now));
+            this.geometry = new NativeContainerGeometry(this.draws, this.menu.slots.size());
+            this.requireCoverage();
+            this.hoveredSlot = this.nativeHoveredSlot(mouseX, mouseY);
+            final List<NativeUiPresentation.Draw> ordered = new ArrayList<>(this.draws);
+            ordered.sort(Comparator.comparingDouble(draw -> draw.box().layer()));
+            this.previews.clear();
+            for (final var draw : ordered) {
+                final var box = draw.box();
+                if (this.vanillaCursor.contains(box.node())) continue;
+                if (draw.alpha() <= 0 || box.visibleBounds().width() <= 0 || box.visibleBounds().height() <= 0) continue;
+                final var clip =
+                        box.node().type().equals("label") ? box.visibleBounds() : box.clip();
+                graphics.enableScissor(Math.round(clip.x()), Math.round(clip.y()),
+                    Math.round(clip.x() + clip.width()), Math.round(clip.y() + clip.height()));
+                try {
+                    final String custom = box.node().string("renderer", "");
+                    if (box.node().string("inventory_count", "").equals("slot"))
+                        this.count(graphics, box, draw.alpha());
+                    else if (box.node().string("inventory_count", "").equals("cursor")) {
+                        /* Vanilla carried decorations remain authoritative. */
+                    } else if (custom.equals("inventory_item_renderer"))
+                        this.item(graphics, box, mouseX, mouseY, draw.alpha());
+                    else if (custom.equals("progress_bar_renderer"))
+                        this.progress(graphics, box, draw.alpha());
+                    else if (custom.equals("flying_item_renderer")
+                            && box.node() == this.flightOwner) this.flying(graphics, draw.alpha());
+                    else if (box.node().type().equals("custom")
+                            && custom.equals("live_horse_renderer"))
+                        this.renderer.portrait(graphics, box, mouseX, mouseY, delta, draw.alpha());
+                    else this.renderer.draw(graphics, draw, this.lifecycle.animations());
+                } finally { graphics.disableScissor(); }
+            }
+        } catch (final RuntimeException error) { this.fallback(error); }
+    }
+
+    private void item(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final int mouseX, final int mouseY, final float alpha) {
+        if (box.node().flag("disabled_filter_visible", false))
+            throw new IllegalArgumentException("Unsupported native inactive-item filter");
+        if (box.node().flag("inventory_cursor", false))
+            return; // Vanilla extractCarriedItem owns its actual quickcraft remainder.
+        if (box.node().properties().has("recipe_id")) {
+            final var stack = this.recipePreviews.get(box.node().properties().get("recipe_id").getAsInt());
+            if (stack == null) throw new IllegalArgumentException("Recipe item has no authoritative preview");
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(box.bounds().x(), box.bounds().y());
+                graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+                NativeInventoryItemOpacity.extract((IBedrockGuiItemOpacity) graphics, alpha, () -> graphics.item(stack, 0, 0));
+            } finally { graphics.pose().popMatrix(); }
+            return;
+        }
+        if (!box.node().properties().has("inventory_slot"))
+            throw new IllegalArgumentException("Inventory item has no actual slot");
+        final Slot slot =
+                this.menu.slots.get(box.node().properties().get("inventory_slot").getAsInt());
+        this.drawingSlot = slot;
+        graphics.pose().pushMatrix();
+        try {
+            graphics.pose().translate(box.bounds().x(), box.bounds().y());
+            graphics.pose().scale(box.bounds().width() / 16, box.bounds().height() / 16);
+            graphics.pose().translate(-slot.x, -slot.y);
+            NativeInventoryItemOpacity.extract((IBedrockGuiItemOpacity) graphics, alpha,
+                    () -> super.extractSlot(graphics, slot, mouseX, mouseY));
+        } finally { graphics.pose().popMatrix(); this.drawingSlot = null; }
+    }
+
+    /** Called only from the scoped vanilla decoration hook, preserving its computed quickcraft stack/count. */
+    public void nativeDecorations(final ItemStack stack, final String count) {
+        if (this.drawingSlot != null) this.previews.put(this.drawingSlot.index, new Preview(stack.copy(), count));
+    }
+
+    private void count(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        final int slot = box.node().properties().get("inventory_slot").getAsInt();
+        final var preview = this.previews.getOrDefault(slot, new Preview(this.menu.slots.get(slot).getItem(), null));
+        final String count =
+                preview.count != null
+                        ? preview.count
+                        : preview.stack.getCount() > 1
+                                ? Integer.toString(preview.stack.getCount())
+                                : "";
+        if (count.isEmpty()) return;
+        this.renderer.label(graphics, box, alpha, this.renderer.styled(box.node(), Component.literal(count)));
+    }
+
+    private void progress(final GuiGraphicsExtractor graphics, final NativeUiLayout.Box box, final float alpha) {
+        var progress = box;
+        final var bag = box.node().properties().getAsJsonObject("property_bag");
+        if (bag != null && bag.has("is_durability") && bag.get("is_durability").getAsBoolean()
+            && box.node().properties().has("inventory_slot")) {
+            final var preview =
+                    this.previews.get(box.node().properties().get("inventory_slot").getAsInt());
+            if (preview != null) {
+                final var props = box.node().properties().deepCopy();
+                props.addProperty(
+                        "touch_progress_bar_visible",
+                        preview.stack.isDamageableItem() && preview.stack.isDamaged());
+                props.addProperty("progress_bar_total_amount", preview.stack.getMaxDamage());
+                props.addProperty(
+                        "progress_bar_current_amount",
+                        preview.stack.getMaxDamage() - preview.stack.getDamageValue());
+                final var node = new NativeUiScene.Node(box.node().name(), box.node().type(), props, box.node().children(), box.node().action());
+                progress = new NativeUiLayout.Box(node, box.bounds(), box.clip(), box.content(), box.scrollViewport(), box.layer(), box.children());
+            }
+        }
+        for (final var quad : NativeInventoryProgress.quads(progress, alpha, (float) this.minecraft.getWindow().getGuiScale())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(quad.bounds().x(), quad.bounds().y());
+                graphics.pose().scale(quad.bounds().width(), quad.bounds().height());
+                graphics.fill(0, 0, 1, 1, quad.color().argb());
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void flying(final GuiGraphicsExtractor graphics, final float alpha) {
+        for (final var frame : this.flights.frames(this.clock.getAsLong())) {
+            graphics.pose().pushMatrix();
+            try {
+                graphics.pose().translate(frame.x(), frame.y());
+                graphics.pose().scale(frame.scale(), frame.scale());
+                NativeInventoryItemOpacity.extract((IBedrockGuiItemOpacity) graphics, alpha,
+                        () -> graphics.item(frame.stack(), 0, 0));
+            } finally { graphics.pose().popMatrix(); }
+        }
+    }
+
+    private void cursor(final NativeUiLayout.Box box, final boolean inherited) {
+        final boolean cursor = inherited || box.node().flag("follows_cursor", false);
+        if (cursor) this.vanillaCursor.add(box.node());
+        for (final var child : box.children()) this.cursor(child, cursor);
+    }
+
+    private void anchors(final NativeUiLayout.Box box) {
+        final var node = box.node();
+        if (this.flightOwner == null && node.string("renderer", "").equals("flying_item_renderer"))
+            this.flightOwner = node;
+        if (node.properties().has("inventory_slot") && node.properties().has("collection")
+            && box.bounds().width() > 0 && box.bounds().height() > 0)
+            this.anchors.putIfAbsent(node.properties().get("inventory_slot").getAsInt(),
+                new NativeInventoryFlights.Anchor(box.bounds().x(), box.bounds().y(), box.bounds().width() / 16));
+        for (final var child : box.children()) this.anchors(child);
+    }
+
+    @Override
+    protected void slotClicked(final Slot slot, final int index, final int button, final ContainerInput input) {
+        if (!this.current()) return;
+        if (this.actionScope.subset()) return;
+        super.slotClicked(slot, index, button, input);
+        this.refreshSafely();
+    }
+
+    private record Preview(ItemStack stack, String count) {}
+
+    @Override
+    public void extractBackground(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        // The resource-pack scene owns its background, including any world overlay.
+    }
+
+    @Override
+    protected boolean hasClickedOutside(final double x, final double y, final int left, final int top) {
+        return this.root == null || !this.root.bounds().contains(x, y);
+    }
+
+    @Override
+    public boolean mouseScrolled(final double x, final double y, final double horizontal, final double vertical) {
+        if (!this.current()) return false;
+        if (!this.scroll.wheel(this.root, x, y, horizontal, vertical)) return super.mouseScrolled(x, y, horizontal, vertical);
+        this.scrollAnimation(true);
+        this.refreshSafely();
+        return true;
+    }
+
+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.press(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        for (final var draw : this.draws.reversed()) if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && draw.enabled() && draw.alpha() > 0
+            && draw.box().node().string("inventory_command", "").equals("close")
+            && draw.box().visibleBounds().contains(event.x(), event.y())) { this.onClose(); return true; }
+        if (this.actionScope.subset()) {
+            if (this.activated && event.button() == InputConstants.MOUSE_BUTTON_LEFT) {
+                final int slot = this.geometry.hovered(event.x(), event.y());
+                if (this.actionScope.slots().contains(slot) && this.menu.slots.get(slot).isActive())
+                    this.send(NativeContainerAction.Mode.AUTO_PLACE_ONE, slot);
+            }
+            return true;
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
+
+    @Override
+    public boolean mouseDragged(final MouseButtonEvent event, final double dx, final double dy) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.drag(this.root, event.x(), event.y())) {
+            this.scrollAnimation(false);
+            this.refreshSafely();
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseDragged(event, dx, dy);
+    }
+
+    @Override
+    public boolean mouseReleased(final MouseButtonEvent event) {
+        if (!this.current()) return false;
+        if (event.button() == InputConstants.MOUSE_BUTTON_LEFT && this.scroll.release()) {
+            this.scrollAnimation(true);
+            return true;
+        }
+        return this.actionScope.subset() || super.mouseReleased(event);
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (!this.current()) return false;
+        if (!this.actionScope.subset()) return super.keyPressed(event);
+        if (event.key() == InputConstants.KEY_ESCAPE
+                || this.minecraft.options.keyInventory.matches(event)) this.onClose();
+        return true;
+    }
+
+    void fallback(final RuntimeException error) {
+        if (this.fallingBack) return;
+        this.fallingBack = true;
+        try {
+            this.deactivate();
+        } catch (final RuntimeException transportError) {
+            if (transportError != error) error.addSuppressed(transportError);
+        } finally {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn(
+                            "Unsupported native inventory presentation; retaining ordinary menu"
+                                    + " controls",
+                            error);
+            if (this.current())
+                BedrockNativeContainers.replace(this.ordinary);
+        }
+    }
+
+    void discard() { if (this.renderer != null) this.renderer.close(); this.images.close(); }
+
+    @Override
+    public void removed() {
+        try {
+            this.deactivate();
+        } catch (final RuntimeException error) {
+            ViaFabricPlusBedrock.impl()
+                    .logger()
+                    .warn("Unable to retire native inventory activation", error);
+        } finally {
+            try {
+                this.discard();
+            } finally {
+                super.removed();
+            }
+        }
+    }
+}
