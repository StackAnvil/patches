+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PlayerInventoryAdmissionTest {
+    @BeforeAll
+    static void bootstrap() throws Exception { NativePlayerPresentationTest.bootstrap(); }
+
+    @Test
+    void playerInventoryLeavesGameplayVisibleUntilItsOwnAcknowledgement() throws Exception {
+        try (var f = new Fixture()) {
+            assertFalse(BedrockPlayerInventory.admit(f.screen));
+            assertNull(f.gui.screen());
+            verify(f.gui, never()).setScreen(any());
+            assertFalse(BedrockPlayerInventory.admit(f.screen));
+            assertEquals(2, f.sent.size());
+            assertEquals(f.sent.getFirst().request().opening(), f.sent.getLast().request().opening());
+            assertTrue(f.sent.getFirst().deferred());
+            final long opening = f.sent.getFirst().request().opening();
+            BedrockPlayerInventory.ready(f.owner, opening + 1);
+            verify(f.gui, never()).setScreen(any());
+            BedrockPlayerInventory.ready(f.owner, opening);
+            verify(f.gui).setScreen(f.screen);
+            BedrockPlayerInventory.ready(f.owner, opening);
+            verify(f.gui, times(1)).setScreen(f.screen);
+        }
+    }
+
+    @Test
+    void chatOrPauseCancelsPendingAdmissionWithoutLateScreenReplacement() throws Exception {
+        try (var f = new Fixture()) {
+            assertFalse(BedrockPlayerInventory.admit(f.screen));
+            final long opening = f.sent.getFirst().request().opening();
+            final var other = mock(Screen.class);
+            assertTrue(BedrockPlayerInventory.admit(other));
+            assertEquals(2, f.sent.size());
+            assertFalse(f.sent.getLast().request().open());
+            assertEquals(opening, f.sent.getLast().request().opening());
+            when(f.gui.screen()).thenReturn(other);
+            BedrockPlayerInventory.ready(f.owner, opening);
+            when(f.gui.screen()).thenReturn(null);
+            BedrockPlayerInventory.ready(f.owner, opening);
+            verify(f.gui, never()).setScreen(any());
+        }
+    }
+
+    @Test
+    void initializationRedirectKeepsTheAcknowledgedOpeningInsteadOfClosingAndRequestingAgain() throws Exception {
+        try (var f = new Fixture()) {
+            final var redirected = mock(AbstractContainerScreen.class);
+            doReturn(f.menu).when(redirected).getMenu();
+            field(Player.class, "containerMenu").set(f.player, f.menu);
+            doAnswer(call -> {
+                when(f.gui.screen()).thenReturn(redirected);
+                BedrockPlayerInventory.installed();
+                return null;
+            }).when(f.gui).setScreen(f.screen);
+            assertFalse(BedrockPlayerInventory.admit(f.screen));
+            final long opening = f.sent.getFirst().request().opening();
+            BedrockPlayerInventory.ready(f.owner, opening);
+            assertEquals(1, f.sent.size());
+            assertEquals(opening, BedrockPlayerInventory.opening(f.owner, f.menu));
+            assertSame(redirected, f.lifecycle.close(f.owner, opening));
+        }
+    }
+
+    @Test
+    void replacementPlayerMenuRetiresPendingAdmissionBeforeItsAcknowledgementCanDisplayTheOldScreen() throws Exception {
+        try (var f = new Fixture()) {
+            assertFalse(BedrockPlayerInventory.admit(f.screen));
+            final long opening = f.sent.getFirst().request().opening();
+            field(Player.class, "inventoryMenu").set(f.player, mock(InventoryMenu.class));
+            BedrockPlayerInventory.ready(f.owner, opening);
+            verify(f.gui, never()).setScreen(any());
+            BedrockPlayerInventory.installed();
+            assertEquals(2, f.sent.size());
+            assertFalse(f.sent.getLast().request().open());
+            assertEquals(opening, f.sent.getLast().request().opening());
+            assertNull(BedrockPlayerInventory.pendingScreen(f.owner));
+        }
+    }
+
+    private static final class Fixture implements AutoCloseable {
+        private final Minecraft game = mock(Minecraft.class);
+        private final LocalPlayer player = mock(LocalPlayer.class);
+        private final InventoryMenu menu = mock(InventoryMenu.class);
+        private final ClientPacketListener owner = mock(ClientPacketListener.class);
+        private final Gui gui = mock(Gui.class);
+        private final AbstractContainerScreen<?> screen = mock(AbstractContainerScreen.class);
+        private final List<PlayerInventoryScreenRequestPayload> sent = new ArrayList<>();
+        private final MockedStatic<Minecraft> singleton = mockStatic(Minecraft.class);
+        private final MockedStatic<ClientPlayNetworking> network = mockStatic(ClientPlayNetworking.class);
+        private final PlayerInventoryScreenLifecycle<ClientPacketListener, Screen, InventoryMenu> lifecycle;
+
+        @SuppressWarnings("unchecked")
+        private Fixture() throws Exception {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            when(game.getConnection()).thenReturn(owner);
+            doReturn(menu).when(screen).getMenu();
+            field(Minecraft.class, "player").set(game, player);
+            field(Minecraft.class, "gui").set(game, gui);
+            field(Player.class, "inventoryMenu").set(player, menu);
+            lifecycle = (PlayerInventoryScreenLifecycle<ClientPacketListener, Screen, InventoryMenu>) field(BedrockPlayerInventory.class, "SCREENS").get(null);
+            lifecycle.begin(owner);
+            network.when(() -> ClientPlayNetworking.canSend(PlayerInventoryScreenRequestPayload.TYPE)).thenReturn(true);
+            network.when(() -> ClientPlayNetworking.canSend(PlayerInventoryScreenRequestPayload.DEFERRED_TYPE)).thenReturn(true);
+            network.when(() -> ClientPlayNetworking.send(any(PlayerInventoryScreenRequestPayload.class))).thenAnswer(call -> {
+                sent.add(call.getArgument(0));
+                return null;
+            });
+        }
+
+        @Override
+        public void close() {
+            lifecycle.clear(owner);
+            network.close();
+            singleton.close();
+        }
+    }
+
+    private static Field field(final Class<?> type, final String name) throws Exception {
+        final var field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        return field;
+    }
+}
