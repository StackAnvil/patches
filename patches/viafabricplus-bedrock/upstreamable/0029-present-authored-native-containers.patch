+        BundleTooltipUi.View view(final int mode, final int inputMode, final boolean hidden, final Integer selectedCell, final Boolean showTags) {
+            final var cells = IntStream.range(0, this.items.size()).mapToObj(slot -> new BundleTooltipUi.Item(this.names.get(slot),
+                    NativeInventoryItemPresentation.values(this.items.get(slot), false, showTags))).toList();
+            return new BundleTooltipUi.View(mode, inputMode, hidden, selectedCell, this.contents, this.storage, cells);
