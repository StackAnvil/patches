+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+class NativeCookingActionsTest {
+    private static NativeCookingMessage first;
+    private static final CookingUi.RecipeActionScope ALL_COMMANDS = new CookingUi.RecipeActionScope(Map.of(7,
+            Set.of(NativeCookingAction.Mode.PRIMARY.button(), NativeCookingAction.Mode.SECONDARY.button(), NativeCookingAction.Mode.TERTIARY.button())));
+
+    @BeforeAll
+    static void bootstrap() throws Exception {
+        NativeCookingPresentationTest.bootstrap();
+        first = NativeCookingPresentationTest.message(CookingUi.Family.FURNACE, 1);
+    }
+
+    @Test
+    void followUpPhasesRetainOriginalAuthorityAcrossNewFramesAndOutOfOrderReplies() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        final var next = update(2);
+        actions.update(next);
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 1, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 1, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertEquals(3, sent.size());
+        for (int phase = 0; phase < 3; phase++) assertEquals(new NativeCookingAction(first.menuId(), first.sequence(), first.updateSequence(),
+                first.menuRevision(), first.inventoryRevision(), first.cursorRevision(), 7, NativeCookingAction.Mode.PRIMARY, 1, phase, phase + 1), sent.get(phase));
+        actions.presented(next, ALL_COMMANDS);
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(2), true, false)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(0), true, false)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.get(1), true, false)));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertEquals(new NativeCookingAction(next.menuId(), next.sequence(), next.updateSequence(), next.menuRevision(),
+                next.inventoryRevision(), next.cursorRevision(), 7, NativeCookingAction.Mode.PRIMARY, 1, 0, 4), sent.getLast());
+    }
+
+    @Test
+    void onlyPresentedCommandsCanStartInputButUpdatedScopesCannotStrandItsRelease() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        actions.presented(first, new CookingUi.RecipeActionScope(Map.of(7, Set.of(NativeCookingAction.Mode.PRIMARY.button()))));
+        assertFalse(actions.send(8, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.SECONDARY, 1, 0, sent::add));
+        for (final int phase : new int[]{-1, 1, 2, 3}) assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, phase, sent::add));
+        assertTrue(sent.isEmpty());
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        actions.update(update(2));
+        assertThrows(IllegalArgumentException.class, () -> actions.presented(first, ALL_COMMANDS));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.SECONDARY, 1, 2, sent::add));
+        assertFalse(actions.send(8, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertEquals(2, sent.size());
+    }
+
+    @Test
+    void rejectedInputsRequireNewAuthorityAndForgedRepliesCannotAcknowledgeAnotherCommand() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        final var original = sent.getFirst();
+        final var forged = new NativeCookingAction(original.menuId(), original.sequence(), original.updateSequence(), original.menuRevision(),
+                original.inventoryRevision(), original.cursorRevision(), original.recipeId(), NativeCookingAction.Mode.SECONDARY, 1, 0, original.requestSequence());
+        assertFalse(actions.result(new NativeCookingActionResult(forged, true, true)));
+        assertTrue(actions.result(new NativeCookingActionResult(original, false, true)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        actions.presented(first, ALL_COMMANDS);
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        final var next = update(2);
+        actions.update(next);
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        actions.presented(next, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertEquals(2, sent.getLast().requestSequence());
+        assertFalse(actions.result(new NativeCookingActionResult(original, true, true)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+    }
+
+    @Test
+    void acceptedInputCannotReuseAuthorityTheCoreAlreadyConsumed() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, false)));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, false)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        final var next = update(2);
+        actions.update(next);
+        actions.presented(next, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+    }
+
+    @Test
+    void secondaryAndTertiaryInputsFinishButTertiaryFollowUpRetainsPrimarySelection() {
+        for (final var mode : List.of(NativeCookingAction.Mode.SECONDARY, NativeCookingAction.Mode.TERTIARY)) {
+            final var actions = new NativeCookingActions(first, () -> 0);
+            final var sent = new ArrayList<NativeCookingAction>();
+            actions.presented(first, ALL_COMMANDS);
+            assertTrue(actions.send(7, mode, 1, 0, sent::add));
+            assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            assertTrue(actions.send(7, mode, 1, 2, sent::add));
+            assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+            assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            assertTrue(actions.send(7, NativeCookingAction.Mode.TERTIARY, 1, 2, sent::add));
+            assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+            assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+            assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        }
+    }
+
+    @Test
+    void synchronousSnapshotsAndRepliesCannotRacePendingRegistrationOrReenterSending() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var next = update(2);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, action -> {
+            sent.add(action);
+            actions.update(next);
+            actions.presented(next, ALL_COMMANDS);
+            assertTrue(actions.result(new NativeCookingActionResult(action, true, false)));
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        }));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, action -> {
+            sent.add(action);
+            assertTrue(actions.result(new NativeCookingActionResult(action, true, false)));
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        }));
+        assertEquals(first.updateSequence(), sent.getLast().updateSequence());
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertEquals(next.updateSequence(), sent.getLast().updateSequence());
+    }
+
+    @Test
+    void failedTransportAndTimeoutCannotRetryAmbiguousInputsOrAcceptLateReplies() {
+        final var clock = new AtomicLong();
+        final var actions = new NativeCookingActions(first, clock::get);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        final var error = new IllegalStateException();
+        assertSame(error, assertThrows(IllegalStateException.class, () -> actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, action -> {
+            sent.add(action);
+            throw error;
+        })));
+        assertTrue(actions.expired());
+        assertFalse(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertThrows(IllegalArgumentException.class, () -> actions.presented(first, ALL_COMMANDS));
+
+        final var waiting = new NativeCookingActions(first, clock::get);
+        waiting.presented(first, ALL_COMMANDS);
+        assertTrue(waiting.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        clock.set(9_999_999_999L);
+        assertFalse(waiting.expired());
+        clock.incrementAndGet();
+        assertTrue(waiting.expired());
+        assertFalse(waiting.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+        assertFalse(waiting.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+    }
+
+    @Test
+    void terminalCancellationReleasesOriginalAuthorityOnceAfterTimeoutOrAmbiguousTransport() {
+        for (final boolean ambiguous : List.of(false, true)) {
+            final var clock = new AtomicLong();
+            final var actions = new NativeCookingActions(first, clock::get);
+            actions.presented(first, ALL_COMMANDS);
+            final var sent = new ArrayList<NativeCookingAction>();
+            if (ambiguous) assertThrows(IllegalStateException.class, () -> actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, input -> {
+                sent.add(input);
+                throw new IllegalStateException();
+            }));
+            else {
+                assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+                actions.update(update(2));
+            }
+            clock.set(10_000_000_000L);
+            assertTrue(actions.expired());
+            actions.retire();
+            assertTrue(actions.cancel(sent::add));
+            assertEquals(2, sent.size());
+            final var release = sent.getLast();
+            assertEquals(new NativeCookingAction(first.menuId(), first.sequence(), first.updateSequence(), first.menuRevision(),
+                    first.inventoryRevision(), first.cursorRevision(), 7, NativeCookingAction.Mode.PRIMARY, 1, 2, 2), release);
+            assertFalse(actions.cancel(sent::add));
+            assertFalse(actions.result(new NativeCookingActionResult(release, true, true)));
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        }
+    }
+
+    @Test
+    void releaseAcknowledgmentsRetireCleanupButFailedReleaseTransportStillPermitsOneTerminalRelease() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertTrue(actions.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+        assertThrows(IllegalStateException.class, () -> actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, input -> {
+            sent.add(input);
+            throw new IllegalStateException();
+        }));
+        assertTrue(actions.cancel(sent::add));
+        assertEquals(3, sent.getLast().requestSequence());
+        assertEquals(first.updateSequence(), sent.getLast().updateSequence());
+        assertFalse(actions.cancel(sent::add));
+        for (final boolean accepted : List.of(false, true)) {
+            final var complete = new NativeCookingActions(first, () -> 0);
+            complete.presented(first, ALL_COMMANDS);
+            assertTrue(complete.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+            assertTrue(complete.result(new NativeCookingActionResult(sent.getLast(), accepted, true)));
+            if (accepted) {
+                assertTrue(complete.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+                assertTrue(complete.result(new NativeCookingActionResult(sent.getLast(), true, true)));
+            }
+            assertFalse(complete.cancel(sent::add));
+        }
+    }
+
+    @Test
+    void cancellationCannotRetryAnAmbiguousTerminalSend() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        actions.presented(first, ALL_COMMANDS);
+        final var sent = new ArrayList<NativeCookingAction>();
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 0, sent::add));
+        assertThrows(IllegalStateException.class, () -> actions.cancel(input -> { sent.add(input); throw new IllegalStateException(); }));
+        assertEquals(2, sent.size());
+        assertFalse(actions.cancel(sent::add));
+    }
+
+    @Test
+    void focusStartsOnlyInItsNativeContextAndReleaseKeepsTheSelectedContext() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        for (final int context : new int[]{-1, 0, 1, 3, 4})
+            assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, context, 1, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 1, input -> {
+            sent.add(input);
+            assertTrue(actions.result(new NativeCookingActionResult(input, true, true)));
+        }));
+        assertFalse(actions.idle());
+        assertFalse(actions.send(7, NativeCookingAction.Mode.SECONDARY, 2, 0, sent::add));
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 1, sent::add));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 0, sent::add));
+        final var press = sent.getLast();
+        assertFalse(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 0, sent::add));
+        final var next = update(2);
+        actions.update(next);
+        actions.presented(next, new CookingUi.RecipeActionScope(Map.of()));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        final var release = sent.getLast();
+        assertEquals(press.controllerInputMode(), release.controllerInputMode());
+        assertEquals(press.updateSequence(), release.updateSequence());
+        assertEquals(press.cursorRevision(), release.cursorRevision());
+        final var forged = new NativeCookingAction(press.menuId(), press.sequence(), press.updateSequence(), press.menuRevision(),
+                press.inventoryRevision(), press.cursorRevision(), press.recipeId(), press.mode(), 1, press.eventPhase(), press.requestSequence());
+        assertFalse(actions.result(new NativeCookingActionResult(forged, true, true)));
+        assertTrue(actions.result(new NativeCookingActionResult(release, true, false)));
+        assertTrue(actions.result(new NativeCookingActionResult(press, true, false)));
+        assertEquals(3, sent.size());
+        assertFalse(actions.cancel(sent::add));
+    }
+
+    @Test
+    void focusCancellationReleasesItsOriginalContextAfterNewFramesOrAmbiguousTransport() {
+        for (final boolean ambiguous : new boolean[]{false, true}) {
+            final var actions = new NativeCookingActions(first, () -> 0);
+            final var sent = new ArrayList<NativeCookingAction>();
+            actions.presented(first, ALL_COMMANDS);
+            if (ambiguous) {
+                assertThrows(IllegalStateException.class, () -> actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 1, input -> {
+                    sent.add(input);
+                    throw new IllegalStateException();
+                }));
+            } else {
+                assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 1, sent::add));
+                actions.update(update(2));
+            }
+            assertTrue(actions.cancel(sent::add));
+            final var focus = sent.getFirst();
+            final var release = sent.getLast();
+            assertEquals(2, release.eventPhase());
+            assertEquals(focus.controllerInputMode(), release.controllerInputMode());
+            assertEquals(focus.updateSequence(), release.updateSequence());
+            assertEquals(focus.cursorRevision(), release.cursorRevision());
+            assertFalse(actions.cancel(sent::add));
+            assertEquals(2, sent.size());
+        }
+    }
+
+    @Test
+    void aLateFocusRejectionCannotStrandANewerSelection() {
+        final var actions = new NativeCookingActions(first, () -> 0);
+        final var sent = new ArrayList<NativeCookingAction>();
+        actions.presented(first, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 1, sent::add));
+        final var focus = sent.getFirst();
+        final var next = update(2);
+        actions.update(next);
+        actions.presented(next, ALL_COMMANDS);
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 2, 0, sent::add));
+        final var press = sent.getLast();
+        assertTrue(actions.result(new NativeCookingActionResult(focus, false, false)));
+        assertTrue(actions.send(7, NativeCookingAction.Mode.PRIMARY, 1, 2, sent::add));
+        final var release = sent.getLast();
+        assertEquals(press.updateSequence(), release.updateSequence());
+        assertEquals(press.controllerInputMode(), release.controllerInputMode());
+        assertTrue(actions.result(new NativeCookingActionResult(release, true, false)));
+        assertTrue(actions.result(new NativeCookingActionResult(press, true, false)));
+        assertFalse(actions.cancel(sent::add));
+    }
+
+    private static NativeCookingMessage update(final long update) {
+        return new NativeCookingMessage(first.menuId(), first.sequence(), update, update + 10, update + 20, update + 30,
+                first.program(), first.snapshot(), first.recipeItems());
+    }
+}
