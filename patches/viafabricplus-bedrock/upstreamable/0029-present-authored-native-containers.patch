+            if (event.button() != null && event.button().phase() != 0 && event.button().phase() != 1) continue;
+            if (player.helping()) {
+                if (event.change() != null && event.change().checked() && event.node().properties().has("help_topic")) {
+                    player.helpTopic(event.node().properties().get("help_topic").getAsInt());
+                    handled = true;
+                } else if (event.button() != null && event.button().transition() && event.node().flag("help_close", false)) {
+                    player.closeHelp();
+                    handled = true;
+                }
+                continue;
+            }
+            if (event.change() != null) {
+                final var change = event.change();
+                final String group = event.node().string("toggle_name", "");
+                if (change.group() != NativeUiInput.symbol(group)) throw new IllegalArgumentException("Mismatched player preference group");
+                if (player.idle()) {
