+package com.viaversion.viafabricplus.bedrock.screen.container;
+
+import com.viaversion.viafabricplus.bedrock.creative.BedrockCreativeCatalog;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.api.model.NativeContainerItems;
+
+/** Logical container items, decoded with the same component patch format as ordinary menu contents. */
+public record NativeContainerItemsPayload(NativeContainerItems message, List<ItemStack> stacks) implements CustomPacketPayload {
+    public static final Type<NativeContainerItemsPayload> TYPE = new Type<>(Identifier.parse(NativeContainerItems.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeContainerItemsPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeContainerItems.TYPE.write(buffer, payload.message),
+            buffer -> {
+                final var message = NativeContainerItems.TYPE.read(buffer);
+                final List<ItemStack> stacks = new ArrayList<>(message.entries().size());
+                for (final var entry : message.entries())
+                    stacks.add(entry.item() == null ? ItemStack.EMPTY : BedrockCreativeCatalog.toNative(entry.item(), buffer.registryAccess()));
+                return new NativeContainerItemsPayload(message, stacks);
+            });
+
+    public NativeContainerItemsPayload {
+        stacks = List.copyOf(stacks);
+        if (stacks.size() != message.entries().size()) throw new IllegalArgumentException("Native container item count differs");
+    }
+
+    @Override
+    public Type<NativeContainerItemsPayload> type() {
+        return TYPE;
+    }
+}
