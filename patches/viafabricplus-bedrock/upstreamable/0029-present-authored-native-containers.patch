+    private void reconcileSearch() {
+        if (!this.authoredController()) return;
+        this.searchBox = null;
+        for (final var draw : this.draws) {
+            if (!draw.box().node().type().equals("edit_box")) continue;
+            if (this.searchBox != null) throw new IllegalArgumentException("Multiple native player search editors");
+            this.searchBox = draw.box();
+            if (this.search == null) {
+                this.search = new EditBox(this.font, 0, 0, 1, 1, Component.empty());
+                this.search.setBordered(false);
+                this.search.setResponder(value -> {
+                    if (!this.synchronizingSearch) this.searchQuery(value);
+                });
+            }
+            if (!this.children().contains(this.search)) this.addWidget(this.search);
+            final var bounds = draw.box().bounds();
+            this.search.setRectangle(Math.max(1, Math.round(bounds.width())), Math.max(1, Math.round(bounds.height())),
+                    Math.round(bounds.x()), Math.round(bounds.y()));
+            final int maximum = Math.round(draw.box().node().number("max_length", 0));
+            if (maximum <= 0 || maximum > 8192) throw new IllegalArgumentException("Invalid native search editor length");
+            this.search.setMaxLength(maximum);
+            this.search.visible = draw.box().visibleBounds().width() > 0 && draw.box().visibleBounds().height() > 0;
+            this.search.active = draw.enabled();
+            this.search.setEditable(draw.enabled());
+            this.search.setAlpha(draw.alpha());
+            if (!this.search.getValue().equals(this.searchQuery())) {
+                this.synchronizingSearch = true;
+                try { this.search.setValue(this.searchQuery()); }
+                finally { this.synchronizingSearch = false; }
+            }
+        }
+        if (this.search != null && this.searchBox == null) this.search.visible = false;
+        if (this.searchInput && (!this.search.visible || !this.search.active)) this.releaseSearch();
+        this.synchronizeSearchInput();
+    }
