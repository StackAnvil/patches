+    @Test
+    void snapshotUpdatesRetainSearchWhileChangedResourceBytesReplaceTheAuthoredLabel() {
+        final var source = message(false, 1, 8, 1, "", false);
+        final var authored = UiProgramFixtures.definitions(UiProgramFixtures.defaults());
+        final var host = authored.getAsJsonObject("definitions").getAsJsonObject("crafting.inventory_screen").getAsJsonObject("value");
+        if (!host.has("controls")) host.add("controls", new JsonArray());
+        final var extra = JsonParser.parseString("""
+                {"resource_label":{"type":"label","text":"First resource title","size":[120,20]}}
+                """).getAsJsonObject();
+        host.getAsJsonArray("controls").add(extra);
+        final int firstProgram = UiProgramFixtures.publish(UiProgramFixtures.program(authored));
+        final var first = new NativePlayerInventoryMessage(firstProgram, 0, 1, 8, 1, source.snapshot(), Map.of());
+        final var presentation = new NativePlayerPresentation(first, Map.of(), Map.of(), () -> 0);
+        assertTrue(presentation.resolve(0, "", slots(), Map.of(), false).scene().toString().contains("First resource title"));
+        final var searched = message(false, 1, 8, 2, "oak", false);
+        assertTrue(presentation.update(new NativePlayerInventoryMessage(firstProgram, 0, 1, 8, 2,
+                searched.snapshot(), Map.of()), Map.of(), Map.of()));
+        assertEquals("oak", presentation.query());
+        assertTrue(presentation.resolve(0, "", slots(), Map.of(), false).scene().toString().contains("First resource title"));
+        extra.getAsJsonObject("resource_label").addProperty("text", "Replacement resource title");
+        // Changed resources arrive as another confirmed program generation.
+        assertTrue(presentation.update(new NativePlayerInventoryMessage(UiProgramFixtures.publish(UiProgramFixtures.program(authored)), 0, 1, 8, 3,
+                searched.snapshot(), Map.of()), Map.of(), Map.of()));
+        final String replaced = presentation.resolve(0, "", slots(), Map.of(), false).scene().toString();
+        assertTrue(replaced.contains("Replacement resource title"));
+        assertFalse(replaced.contains("First resource title"));
+        assertEquals("oak", presentation.query());
+        // A message for a retired generation has no program and leaves the current presentation in place.
+        assertThrows(RuntimeException.class, () -> presentation.update(new NativePlayerInventoryMessage(
+                firstProgram, 0, 1, 8, 4, searched.snapshot(), Map.of()), Map.of(), Map.of()));
+        assertEquals(3, presentation.message().revision());
+        assertEquals("oak", presentation.query());
+        assertTrue(presentation.resolve(0, "", slots(), Map.of(), false).scene().toString().contains("Replacement resource title"));
+    }
