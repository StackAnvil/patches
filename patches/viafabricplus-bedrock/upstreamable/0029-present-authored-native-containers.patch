+
+class NativePlayerHelpTextTest {
+    @Test
+    void inputNamesReplaceVisibleComponentTextWithoutChangingFormattingOrHiddenContent() {
+        final var scene = JsonParser.parseString("""
+                {"root":{"type":"panel","children":[
+                  {"type":"label","text":"Press :_input_key.inventory:",
+                   "text_component":{"text":"Press ","extra":[{"text":":_input_key.inventory:","color":"#ded605"}]}},
+                  {"type":"label","visible":false,"text":":unsupported:","text_component":":unsupported:"}
+                ]}}
+                """).getAsJsonObject();
+        NativePlayerHelpText.resolve(scene, token -> token.equals("_input_key.inventory") ? "$E" : null);
+        final var label = scene.getAsJsonObject("root").getAsJsonArray("children").get(0).getAsJsonObject();
+        assertEquals("Press $E", label.get("text").getAsString());
+        final var styled = label.getAsJsonObject("text_component").getAsJsonArray("extra").get(0).getAsJsonObject();
+        assertEquals("$E", styled.get("text").getAsString());
+        assertEquals("#ded605", styled.get("color").getAsString());
+        final var hidden = scene.getAsJsonObject("root").getAsJsonArray("children").get(1).getAsJsonObject();
+        assertEquals(":unsupported:", hidden.get("text").getAsString());
+        hidden.addProperty("visible", true);
+        assertThrows(IllegalArgumentException.class, () -> NativePlayerHelpText.resolve(scene, token -> null));
+    }
+}
