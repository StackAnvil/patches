+
+    record Frame(JsonObject scene, int containerSlots, Map<Integer, ItemStack> recipes, Map<Integer, Set<String>> recipeActions,
+                 Map<Integer, ItemStack> craftingPreview) {
+        public Frame(final JsonObject scene, final int containerSlots, final Map<Integer, ItemStack> recipes,
+                     final Map<Integer, Set<String>> recipeActions) {
+            this(scene, containerSlots, recipes, recipeActions, Map.of());
+        }
+
+        public Frame {
+            if (scene == null || containerSlots < 0) throw new IllegalArgumentException("Invalid native inventory frame");
+            final Map<Integer, ItemStack> stacks = new HashMap<>();
+            recipes.forEach((id, item) -> stacks.put(id, item.copy()));
+            recipes = Map.copyOf(stacks);
+            Objects.requireNonNull(recipeActions);
+            final Map<Integer, Set<String>> actions = new HashMap<>();
