+
+    private void collect(final NativeUiScene.Node node, final List<Identity> parent, final int occurrence,
+                         final boolean inheritedEnabled, final Map<List<Identity>, Entry> current,
+                         final Map<NativeUiScene.Node, Entry> indexed,
+                         final Map<NativeUiScene.Node, NativeUiScene.Node> replacements, final Map<List<Identity>, NativeUiScene.Node> nodes) {
+        final List<Identity> path = new ArrayList<>(parent);
+        path.add(identity(node, occurrence));
+        final List<Identity> key = List.copyOf(path);
+        nodes.put(key, node);
+        final var previousNode = this.nodes.get(key);
+        if (previousNode != null) replacements.put(previousNode, node);
+        final boolean enabled = inheritedEnabled && node.flag("enabled", true);
+        if (node.type().equals("button") || node.type().equals("toggle") || node.properties().has("button_mappings")) {
+            final var input = NativeUiInput.parse(node.properties());
+            final var toggle = node.type().equals("toggle") ? NativeUiToggle.parse(node.properties()) : null;
+            final var button = node.type().equals("button") ? NativeUiButton.parse(node.properties()) : null;
+            final var previous = this.entries.get(key);
+            final Entry entry;
+            if (previous != null && previous.definition.equals(input) && java.util.Objects.equals(previous.toggleDefinition, toggle)
+                    && java.util.Objects.equals(previous.buttonDefinition, button)) {
+                entry = previous;
+                replacements.put(previous.node, node);
+                entry.node = node;
+            } else entry = new Entry(key, node, input, toggle, button, enabled, this::visible);
+            if (toggle != null && (previousNode != node || previous != entry)) {
+                final var value = node.properties().get("toggle_state");
+                final Boolean binding = value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean() ? value.getAsBoolean() : null;
+                if (binding != null && !binding.equals(entry.binding)) entry.toggle.bindChecked(binding);
+                entry.binding = binding;
+            }
+            if (toggle != null) node.properties().addProperty("toggle_state", entry.toggle.checked());
+            current.put(key, entry);
+            indexed.put(node, entry);
+        }
+        final Map<Identity, Integer> occurrences = new HashMap<>();
+        for (final var child : node.children()) {
+            final int next = occurrences.merge(identity(child, 0), 1, Integer::sum) - 1;
+            this.collect(child, key, next, enabled, current, indexed, replacements, nodes);
+        }
+    }
+
+    private void updateComponents(final NativeUiScene.Node node, final boolean inheritedEnabled, final boolean inheritedVisible) {
+        final boolean enabled = inheritedEnabled && node.flag("enabled", true);
+        final var entry = this.indexed.get(node);
+        if (entry != null) {
+            final boolean enabledChanged = entry.enabled != enabled;
+            entry.enabled = enabled;
+            if (entry.button != null) {
+                entry.button.attach(node, enabled, entry.hovered);
+                if (entry.ownEnabled != node.flag("enabled", true)) entry.button.enabled(node.flag("enabled", true));
+            }
+            this.visibility(entry);
+            if (entry.button != null && enabledChanged) entry.button.general(17, enabled, entry.hovered);
+            entry.ownEnabled = node.flag("enabled", true);
+        }
+        final boolean visible = inheritedVisible && node.flag("visible", true) && !node.flag("ignored", false);
+        if (entry != null) {
+            if (!visible) {
+                if (entry.visible) entry.input.invalidateMappings();
+                if (entry.hovered) {
+                    entry.hovered = false;
+                    if (entry.button != null) entry.button.hover(false, enabled);
+                    if (entry.toggle != null) entry.toggle.hover(false);
+                }
+            }
+            entry.visible = visible;
+        }
+        for (final var child : node.children()) this.updateComponents(child, enabled, visible);
+    }
+
+    private void visible(final NativeUiScene.Node node, final boolean visible) {
+        node.properties().addProperty("visible", visible);
+        final var entry = this.indexed.get(node);
+        if (entry != null) this.visibility(entry);
+    }
+
+    private void visibility(final Entry entry) {
+        final boolean visible = entry.node.flag("visible", true);
+        final boolean ignored = entry.node.flag("ignored", false);
+        if (entry.ownVisible == visible && entry.ignored == ignored) return;
+        entry.ownVisible = visible;
+        entry.ignored = ignored;
+        // UIControl notifies Input before Button. Inherited visibility and registration wait for the View update.
+        entry.input.invalidateMappings();
+        if (entry.button != null) entry.button.visibility(visible && !ignored, entry.enabled, entry.hovered);
+    }
