+        final List<NativeUiInput.Ancestor> nested = new ArrayList<>();
+        final var track = node.scroll() ? NativeUiScroll.descendant(box, node.string("scrollbar_track", "")) : null;
+        nested.add(new NativeUiInput.Ancestor(bounds(node.scroll() ? box.scrollViewport() : box.bounds()), node.scroll() || node.flag("clips_children", false),
+            node.scroll(), track == null ? null : bounds(track.bounds())));
+        nested.addAll(ancestors);
+        for (final var child : box.children()) this.geometry(child, List.copyOf(nested));
+    }
+
+    boolean hasButtonState(final NativeUiScene.Node node) {
+        final var entry = this.indexed.get(node);
+        return entry != null && entry.button != null;
+    }
+
+    long visualRevision() {
+        long revision = this.toggleRevision;
+        for (final var entry : this.entries.values()) if (entry.button != null) revision += entry.button.revision();
+        return revision;
+    }
+
+    private static Identity identity(final NativeUiScene.Node node, final int occurrence) {
+        return new Identity(node.name(), node.type(), String.valueOf(node.properties().get("inventory_slot")),
+            String.valueOf(node.properties().get("collection")), String.valueOf(node.properties().get("collection_index")),
+            String.valueOf(node.properties().get("factory_instance_id")), occurrence);
+    }
+
+    private static NativeUiInput.Bounds bounds(final NativeUiLayout.Rect rect) {
+        return new NativeUiInput.Bounds(rect.x(), rect.y(), rect.width(), rect.height());
+    }
+
+    Result pointer(final double x, final double y, final int mode, final long nanos, final boolean enabled) {
+        this.inputX = (float) x;
+        this.inputY = (float) y;
+        return this.hover(x, y, mode, nanos, enabled);
+    }
+
+    private Result hover(final double x, final double y, final int mode, final long nanos, final boolean enabled) {
+        this.pointerX = (float) x;
+        this.pointerY = (float) y;
+        return this.hoverAt((float) x, (float) y, mode, nanos, enabled);
+    }
+
+    private Result hoverAt(final float x, final float y, final int mode, final long nanos, final boolean enabled) {
+        final List<Event> events = new ArrayList<>();
+        boolean consumed = false;
+        for (final var frame : this.frames) {
+            final var entry = frame.entry;
+            final boolean inside = entry.geometry.bounds().contains(x, y) && entry.geometry.insideClip(x, y);
+            final boolean active = frame.enabled && enabled;
+            final int mask = entry.buttonDefinition == null ? 0 : entry.buttonDefinition.handlerMask(active);
+            final var result = entry.input.pointer(entry.hovered, inside, consumed || !active, mask);
+            entry.hovered = result.hover().hovered();
+            if (entry.button != null && result.hover().changed()) entry.button.hover(entry.hovered, active);
+            if (entry.toggle != null) this.change(entry, entry.toggle.hover(entry.hovered), events);
+            for (final var button : result.hover().events()) events.add(new Event(entry.node, button, null));
+            consumed |= active && result.result() == 1;
+        }
+        return this.deliver(consumed, events, mode, nanos, enabled);
+    }
+
+    Result button(final String source, final boolean pressed, final int mode, final long nanos, final boolean active) {
+        if (source.isEmpty()) return new Result(false, List.of());
+        return this.button(NativeUiInput.symbol(source), pressed ? 1 : 0, mode, nanos, active);
+    }
+
+    private Result button(final int source, final int phase, final int mode, final long nanos, final boolean active) {
+        final List<NativeUiInputRouter.Control<List<Identity>>> controls = new ArrayList<>();
+        final List<Event> events = new ArrayList<>();
+        final var registered = new HashSet<Entry>();
+        for (final var frame : this.frames) {
+            final var entry = frame.entry;
+            registered.add(entry);
+            controls.add(this.control(entry, frame.enabled && active, mode, nanos, events, true));
+        }
+        // Native captures own weak control references independently of normal input registration.
+        for (final var entry : this.entries.values()) if (!registered.contains(entry))
+            controls.add(this.control(entry, entry.enabled && active, mode, nanos, events, false));
+        final var result = this.router.dispatch(source, phase, controls);
+        return this.deliver(result.consumed(), events, mode, nanos, active);
+    }
+
+    private NativeUiInputRouter.Control<List<Identity>> control(final Entry entry, final boolean enabled, final int mode,
+                                                               final long nanos, final List<Event> events, final boolean registered) {
+        return new NativeUiInputRouter.Control<>(entry.key, entry.input, () -> this.context(entry, enabled, mode, nanos),
+            event -> this.button(entry, event, enabled, events), registered);
+    }
+
+    private NativeUiInput.Context context(final Entry entry, final boolean enabled, final int mode, final long nanos) {
+        // FocusManager ownership does not set the edit-box selection flag.
+        final int flags = (enabled ? 0x60 : 0) | (entry.ownVisible ? 4 : 0) | (entry.ignored ? 0 : 8)
+            | (entry.visible ? 0x10 : 0) | (entry.hovered ? 2 : 0);
+        final int mask = entry.buttonDefinition == null ? 0 : entry.buttonDefinition.handlerMask(enabled);
+        return new NativeUiInput.Context(flags, mode, this.inputX, this.inputY,
+            entry.geometry.bounds().contains(this.inputX, this.inputY), entry.geometry.insideClip(this.inputX, this.inputY),
+            entry.geometry.insideAlternate(flags, this.inputX, this.inputY), false, nanos, mask);
+    }
+
+    private void button(final Entry entry, final NativeUiInput.ButtonEvent button, final boolean enabled, final List<Event> events) {
+        // Native component callbacks enqueue changes before ScreenView applies the button's scope.
+        if (entry.button != null) entry.button.button(button, enabled, entry.hovered);
+        if (entry.toggle != null) this.change(entry, entry.toggle.button(button, enabled), events);
+        events.add(new Event(entry.node, button, null));
+    }
+
+    private void change(final Entry entry, final NativeUiToggle.Change change, final List<Event> events) {
+        if (change == null) return;
+        this.toggleRevision++;
+        for (final var sibling : this.entries.values()) {
+            if (sibling.toggle == null) continue;
+            sibling.toggle.sibling(change);
+            sibling.node.properties().addProperty("toggle_state", sibling.toggle.checked());
+        }
+        events.add(new Event(entry.node, null, change));
+    }
+
+    private Result deliver(final boolean consumed, final List<Event> queued, final int mode, final long nanos, final boolean active) {
+        final List<Event> nested = new ArrayList<>();
+        final List<Event> forwarded = new ArrayList<>();
+        for (final var event : queued) {
+            if (event.button != null) {
+                if (event.button.scope() == NativeUiInput.Scope.GLOBAL)
+                    nested.addAll(this.button(event.button.target(), event.button.previous(), mode, nanos, active).events());
+                else if (event.button.scope() == NativeUiInput.Scope.VIEW) {
+                    final var direction = direction(event.button.target());
+                    if (active && event.button.transition() && direction != null) nested.addAll(this.navigate(direction, mode, nanos));
+                    final var right = tabDirection(event.button.target());
+                    if (active && event.button.transition() && right != null) nested.addAll(this.navigateTab(right, mode, nanos));
+                    continue;
+                }
+            }
+            forwarded.add(event);
+        }
+        // ScreenView applies VIEW actions before delivering its queued controller events.
+        // Focus changes recursively deliver hover events before that outer queue.
+        nested.addAll(forwarded);
+        return new Result(consumed, List.copyOf(nested));
+    }
+
+    private List<Event> navigate(final NativeUiFocus.Direction direction, final int mode, final long nanos) {
+        final var target = NativeUiFocus.next(this.targets(), this.focused, direction, this.viewportWidth, this.viewportHeight, this.history);
+        if (target == null || target.box().node() == this.focused) return List.of();
+        final var revealed = this.focus(target);
+        if (revealed == null) return List.of();
+        final var bounds = revealed.box().bounds();
+        return this.hover(bounds.x() + bounds.width() * .5F, bounds.y() + bounds.height() * .5F, mode, nanos, true).events();
+    }
+
+    private NativeUiFocus.Target focus(final NativeUiFocus.Target target) {
+        this.focused = target.box().node();
+        this.history.select(target);
+        this.revealFocus.accept(this.focused);
+        // Revealing a descendant can relayout the tree and replace its geometry.
+        return this.targets().stream().filter(candidate -> candidate.box().node() == this.focused).findFirst().orElse(null);
+    }
+
+    static boolean supportsViewTarget(final int target) {
+        return target == NativeUiInput.symbol("button.menu_select") || direction(target) != null || tabDirection(target) != null;
+    }
+
+    private static Boolean tabDirection(final int target) {
+        if (target == NativeUiInput.symbol("button.menu_tab_left")) return false;
+        if (target == NativeUiInput.symbol("button.menu_tab_right")) return true;
+        return null;
+    }
+
+    private List<Entry> navigationTabs() {
+        final Map<NativeUiScene.Node, Entry> indexed = new IdentityHashMap<>();
+        for (final var entry : this.entries.values()) indexed.put(entry.node, entry);
+        final List<Entry> tabs = new ArrayList<>();
+        if (this.root != null) navigationTabs(this.root, indexed, tabs);
+        return tabs;
+    }
+
+    private static void navigationTabs(final NativeUiLayout.Box box, final Map<NativeUiScene.Node, Entry> indexed, final List<Entry> tabs) {
+        final var node = box.node();
+        if (!node.flag("visible", true) || node.flag("ignored", false) || !node.flag("enabled", true)) return;
+        final var entry = indexed.get(node);
+        if (entry != null && entry.toggle != null && entry.toggleDefinition.group() == NativeUiInput.symbol("navigation_tab")) tabs.add(entry);
+        for (final var child : box.children()) navigationTabs(child, indexed, tabs);
+    }
+
+    private List<Event> navigateTab(final boolean right, final int mode, final long nanos) {
+        final var tabs = this.navigationTabs();
+        if (tabs.isEmpty()) return List.of();
+        int current = 0, minimum = Integer.MAX_VALUE, maximum = Integer.MIN_VALUE;
+        for (final var entry : tabs) if (entry.toggle.checked()) current = entry.toggleDefinition.index(0);
+        int selected = right ? Integer.MAX_VALUE : Integer.MIN_VALUE;
+        boolean found = false;
+        for (final var entry : tabs) {
+            final int index = entry.toggleDefinition.index(0);
+            minimum = Math.min(minimum, index);
+            maximum = Math.max(maximum, index);
+            if (right ? current < index && index < selected : selected < index && index < current) {
+                selected = index;
+                found = true;
+            }
+        }
+        if (!found) {
+            if ((right ? maximum : minimum) != current) return List.of();
+            selected = right ? minimum : maximum;
+        }
+        if (selected == -1) return List.of();
+        this.toggleRevision++;
+        Entry previous = null, target = null;
+        for (final var entry : tabs) {
+            final boolean checked = entry.toggleDefinition.index(0) == selected;
+            if (checked) target = entry;
+            else if (entry.toggle.checked()) previous = entry;
+            entry.toggle.bindChecked(checked);
+            entry.node.properties().addProperty("toggle_state", checked);
+        }
+        if (target == null) return List.of();
+        final List<Event> events = new ArrayList<>();
+        final var selectedTarget = target;
+        final var focus = this.targets().stream().filter(candidate -> candidate.box().node() == selectedTarget.node).findFirst().orElse(null);
+        if (focus != null) {
+            final var revealed = this.focus(focus);
+            if (revealed != null) {
+                final var bounds = revealed.box().bounds();
+                // A forced tab focus refresh delivers the whole hover queue before its group change,
+                // using the revealed center without replacing either stored View pointer.
+                events.addAll(this.hoverAt(bounds.x() + bounds.width() * .5F, bounds.y() + bounds.height() * .5F, mode, nanos, true).events());
+            }
+            events.add(new Event(target.node, null, new NativeUiToggle.Change(target.toggleDefinition.group(), selected, true, false, false)));
+            return List.copyOf(events);
+        }
+        events.add(new Event(target.node, null, new NativeUiToggle.Change(target.toggleDefinition.group(), selected, true, false, false)));
+        final List<Event> hover = new ArrayList<>();
+        if (previous != null) this.tabHover(previous, true, hover);
+        this.tabHover(target, false, hover);
+        // View delivers the group change before the old/new tab hover queue.
+        // These control-local pointer calls do not replace the View's logical or physical pointer.
+        events.addAll(this.deliver(false, hover, mode, nanos, true).events());
+        return List.copyOf(events);
+    }
+
+    private void tabHover(final Entry entry, final boolean forcedOut, final List<Event> events) {
+        final var bounds = entry.geometry.bounds();
+        final float x = bounds.x() + bounds.width() * .5F, y = bounds.y() + bounds.height() * .5F;
+        final boolean enabled = this.frames.stream().filter(frame -> frame.entry == entry).allMatch(Frame::enabled);
+        final var result = entry.input.pointer(entry.hovered, bounds.contains(x, y) && entry.geometry.insideClip(x, y), forcedOut || !enabled, 0);
+        entry.hovered = result.hover().hovered();
+        this.change(entry, entry.toggle.hover(entry.hovered), events);
+        for (final var button : result.hover().events()) events.add(new Event(entry.node, button, null));
+    }
+
+    private static NativeUiFocus.Direction direction(final int target) {
+        if (target == NativeUiInput.symbol("button.menu_up")) return NativeUiFocus.Direction.UP;
+        if (target == NativeUiInput.symbol("button.menu_down")) return NativeUiFocus.Direction.DOWN;
+        if (target == NativeUiInput.symbol("button.menu_left")) return NativeUiFocus.Direction.LEFT;
+        if (target == NativeUiInput.symbol("button.menu_right")) return NativeUiFocus.Direction.RIGHT;
+        return null;
+    }
+
+    private List<NativeUiFocus.Target> targets() {
+        return this.root == null ? List.of() : NativeUiFocus.targets(this.root, _ -> true);
+    }
+
+    NativeUiScene.Node focused() { return this.focused; }
+    boolean enabled(final NativeUiScene.Node node) { return this.frames.stream().anyMatch(frame -> frame.entry.node == node && frame.enabled); }
+    boolean captures(final String source) { return this.router.captures(NativeUiInput.symbol(source)); }
+
+    record Event(NativeUiScene.Node node, NativeUiInput.ButtonEvent button, NativeUiToggle.Change change) {
+        String collection() {
+            final var value = this.property("#collection_name");
+            return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isString() ? value.getAsString() : "";
+        }
+
+        int collectionIndex() {
+            final var value = this.property("#collection_index");
+            if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) return -1;
+            final String encoded = value.getAsString();
+            if (encoded.indexOf('.') >= 0 || encoded.indexOf('e') >= 0 || encoded.indexOf('E') >= 0) return -1;
+            try {
+                final var integer = new BigInteger(encoded);
+                return integer.bitLength() <= (integer.signum() < 0 ? 63 : 64) ? integer.intValue() : -1;
+            } catch (final NumberFormatException invalid) { return -1; }
+        }
+
+        private JsonElement property(final String name) {
+            final var bag = this.node.properties().get("property_bag");
+            return bag != null && bag.isJsonObject() ? bag.getAsJsonObject().get(name) : null;
+        }
+    }
+    record Result(boolean consumed, List<Event> events) {}
+    private record Identity(String name, String type, String slot, String collection, String index, String factoryInstance, int occurrence) {}
+    private record Frame(Entry entry, boolean enabled) {}
+
+    private static final class Entry {
+        private final List<Identity> key;
+        private NativeUiScene.Node node;
+        private final NativeUiInput definition;
+        private final NativeUiToggle toggleDefinition;
+        private final NativeUiButton buttonDefinition;
+        private final NativeUiInput.State input;
+        private final NativeUiToggle.State toggle;
+        private final NativeUiButton.State button;
+        private boolean ownEnabled;
+        private boolean ownVisible;
+        private boolean ignored;
+        private boolean visible = true;
+        private boolean enabled;
+        private NativeUiInput.Geometry geometry;
+        private boolean hovered;
+        private Boolean binding;
+
+        private Entry(final List<Identity> key, final NativeUiScene.Node node, final NativeUiInput input, final NativeUiToggle toggle,
+                      final NativeUiButton button, final boolean enabled, final BiConsumer<NativeUiScene.Node, Boolean> visibility) {
+            this.key = key;
+            this.node = node;
+            this.definition = input;
+            this.toggleDefinition = toggle;
+            this.buttonDefinition = button;
+            this.ownEnabled = node.flag("enabled", true);
+            this.ownVisible = node.flag("visible", true);
+            this.ignored = node.flag("ignored", false);
+            this.enabled = enabled;
+            final var options = input.options();
+            if (options.wildcard() && options.wildcardScope() == NativeUiInput.Scope.GLOBAL)
+                throw new IllegalArgumentException("Unsupported recursive native global wildcard");
+            if (options.wildcard() && options.wildcardScope() == NativeUiInput.Scope.VIEW
+                    || input.mappings().stream().anyMatch(mapping -> mapping.scope() == NativeUiInput.Scope.VIEW
+                        && !supportsViewTarget(mapping.target()))
+                    || input.hoverBindings().stream().anyMatch(mapping -> mapping.scope() == NativeUiInput.Scope.VIEW
+                        && !supportsViewTarget(mapping.target())))
+                throw new IllegalArgumentException("Unsupported native view-owned input");
+            if (options.modal() || options.inlineModal() || options.alwaysHandleControllerDirection()
+                    || options.preventTouchInput() || options.gamepadDeflectionMode())
+                throw new IllegalArgumentException("Unsupported native input screen dispatch");
+            this.input = new NativeUiInput.State(input);
+            if (toggle != null && toggle.forcedIndex() < 0 && !node.string("toggle_grid_collection_name", "").isEmpty())
+                throw new IllegalArgumentException("Unsupported native toggle collection index");
+            this.toggle = toggle == null ? null : new NativeUiToggle.State(toggle, 0);
+            this.button = button == null ? null : new NativeUiButton.State(button, visibility);
+        }
+    }
+}
