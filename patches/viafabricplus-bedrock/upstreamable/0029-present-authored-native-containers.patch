+    private static ItemStack bundle(final int amount) {
+        final var data = new CompoundTag();
+        final var storage = new CompoundTag();
+        storage.putInt("version", NativeItemStorageData.VERSION);
+        storage.putInt("modifier", 4);
+        storage.putInt("weight", amount * 4);
+        storage.putInt("capacity", 64);
+        data.put(NativeItemStorageData.TAG, storage);
+        final var tooltip = new CompoundTag();
+        tooltip.putInt("version", NativeBundleTooltipData.VERSION);
+        tooltip.putInt("identity", 42);
+        tooltip.putInt("viewable_slots", 12);
+        tooltip.putIntArray("amounts", new int[]{amount, 0, 0, 0});
+        tooltip.putString("primary_name", "Bundle");
+        tooltip.putString("empty_description", "Empty");
+        final Map<Integer, NativeBundleTooltipItems.Preview> previews = amount == 0 ? Map.of()
+                : Map.of(0, new NativeBundleTooltipItems.Preview("Iron Ingot", new StructuredItem(320, amount, new StructuredDataContainer())));
+        tooltip.putByteArray(NativeBundleTooltipItems.TAG, new NativeBundleTooltipItems(42, 4, previews).encode());
+        data.put(NativeBundleTooltipData.TAG, tooltip);
+        final var bundle = new ItemStack(Items.BUNDLE);
+        bundle.set(DataComponents.CUSTOM_DATA, CustomData.of(data));
+        return bundle;
+    }
