+    /**
+     * Count-one actions never pick up an item, but the server can still fill the cursor. Native input could then
+     * drop or place that item, which the count-one transport cannot send, so the stock screen takes over.
+     */
+    private void requireSubsetCursor() {
+        if (this.actionScope.subset() && !this.helping() && !this.menu.getCarried().isEmpty())
+            throw new IllegalArgumentException("Native count-one scope cannot own a carried item");
+    }
