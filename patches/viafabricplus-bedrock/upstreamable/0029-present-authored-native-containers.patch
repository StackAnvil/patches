+final class NativeContainerDrawsTest {
+    @Test
+    void aStationaryPointerDoesNotFreezeFadesOrEventResets() {
+        final var scene = NativeUiScene.parse("""
+                {"format":1,"root":{"name":"backdrop","type":"image","alpha":0.4,"size":[100,100],
+                  "animation_program":{"roots":[0],"tracks":[
+                    {"anim_type":"alpha","from":0,"to":1,"duration":1,"easing":"linear",
+                     "scale_from_starting_alpha":true,"play_event":"fade","reset_event":"reset"}]}}}
+                """, Set.of()).root();
+        final var root = layout(scene);
+        final var lifecycle = new NativeUiAnimationLifecycle(scene);
+        final var input = new NativeContainerInput(_ -> { });
+        input.prepare(scene);
+        final var draws = new NativeContainerDraws();
+        lifecycle.animations().event(scene, "fade", 0);
+        lifecycle.advance(500_000_000);
+        assertEquals(.2F, draws.update(root, 50, 50, lifecycle.animations(), input, 500_000_000).getFirst().alpha(), .000001F);
+        lifecycle.animations().event(scene, "reset", 500_000_000);
+        assertEquals(0, draws.update(root, 50, 50, lifecycle.animations(), input, 500_000_000).getFirst().alpha());
+        lifecycle.animations().event(scene, "fade", 500_000_000);
+        lifecycle.advance(1_500_000_000);
+        assertEquals(.4F, draws.update(root, 50, 50, lifecycle.animations(), input, 1_500_000_000).getFirst().alpha(), .000001F);
+        lifecycle.advance(2_000_000_000);
+        assertEquals(.4F, draws.update(root, 50, 50, lifecycle.animations(), input, 2_000_000_000).getFirst().alpha(), .000001F);
+    }
