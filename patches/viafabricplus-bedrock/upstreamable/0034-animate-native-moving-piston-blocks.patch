+package net.raphimc.viabedrock.protocol.rewriter.blockentity;
+
+import com.viaversion.viafabricplus.bedrock.block.BedrockMovingPistonBlockEntity;
+import com.viaversion.viaversion.api.type.Types;
+import io.netty.buffer.Unpooled;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.util.ProblemReporter;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.piston.MovingPistonBlock;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import net.minecraft.world.level.block.state.properties.Half;
+import net.minecraft.world.level.block.state.properties.StairsShape;
+import net.minecraft.world.level.storage.TagValueInput;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import java.util.Locale;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+/** Runs the core producer against Minecraft's real decoder without widening its production API. */
+class NativePistonBlockEntityCodecTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void translatedCarriedStatesDecodeWithTheirPropertiesAndMotion() throws Exception {
+        final var registries = RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY);
+        final BlockGetter level = mock(BlockGetter.class);
+        final var carried = new net.raphimc.viabedrock.api.model.BlockState[]{
+                net.raphimc.viabedrock.api.model.BlockState.fromString("minecraft:stone"),
+                net.raphimc.viabedrock.api.model.BlockState.fromString("minecraft:oak_stairs[facing=west,half=top,shape=inner_right,waterlogged=true]")};
+        final var expected = new net.minecraft.world.level.block.state.BlockState[]{
+                Blocks.STONE.defaultBlockState(),
+                Blocks.OAK_STAIRS.defaultBlockState().setValue(BlockStateProperties.HORIZONTAL_FACING, Direction.WEST)
+                        .setValue(BlockStateProperties.HALF, Half.TOP).setValue(BlockStateProperties.STAIRS_SHAPE, StairsShape.INNER_RIGHT)
+                        .setValue(BlockStateProperties.WATERLOGGED, true)};
+        for (final Direction facing : Direction.values()) {
+            final var base = net.raphimc.viabedrock.api.model.BlockState.fromString(
+                    "minecraft:sticky_piston[extended=false,facing=" + facing.name().toLowerCase(Locale.ROOT) + "]");
+            for (final boolean extending : new boolean[]{false, true}) {
+                final var moving = new com.viaversion.nbt.tag.CompoundTag();
+                moving.putByte("expanding", (byte) (extending ? 1 : 0));
+                final var arm = new com.viaversion.nbt.tag.CompoundTag();
+                arm.putByte("State", (byte) (extending ? 1 : 3));
+                arm.putFloat("Progress", extending ? 0.25F : 0.75F);
+                for (int index = 0; index < carried.length; index++) {
+                    final var buffer = new FriendlyByteBuf(Unpooled.buffer());
+                    try {
+                        Types.COMPOUND_TAG.write(buffer, MovingBlockBlockEntityRewriter.javaData(moving, carried[index], base, arm));
+                        final var tag = buffer.readNbt();
+                        assertFalse(buffer.isReadable());
+                        final var state = Blocks.MOVING_PISTON.defaultBlockState().setValue(MovingPistonBlock.FACING, Direction.EAST);
+                        final var piston = new BedrockMovingPistonBlockEntity(BlockPos.ZERO, state);
+                        final var problems = new ProblemReporter.Collector();
+                        piston.loadCustomOnly(TagValueInput.create(problems, registries, tag));
+                        assertTrue(problems.isEmpty(), problems.getReport());
+                        assertSame(expected[index], piston.getMovedState());
+                        assertSame(facing, piston.getDirection());
+                        assertEquals(extending, piston.isExtending());
+                        assertEquals(0.25F, piston.getProgress(1F));
+                        assertFalse(piston.awaitingData());
+                        assertFalse(piston.getCollisionShape(level, BlockPos.ZERO).isEmpty());
+                    } finally {
+                        buffer.release();
+                    }
+                }
+            }
+        }
+    }
+}
