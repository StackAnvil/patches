+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.piston.MovingPistonBlock;
+import net.minecraft.world.level.block.piston.PistonMovingBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.storage.ValueInput;
+
+/** Keeps a translated moving block safe until its separate carried-block update arrives. */
+public final class BedrockMovingPistonBlockEntity extends PistonMovingBlockEntity {
+    private boolean awaitingData = true;
+
+    public BedrockMovingPistonBlockEntity(final BlockPos position, final BlockState state) {
+        super(position, state, Blocks.AIR.defaultBlockState(), state.getValue(MovingPistonBlock.FACING), false, false);
+    }
+
+    public boolean awaitingData() {
+        return this.awaitingData;
+    }
+
+    @Override
+    protected void loadAdditional(final ValueInput input) {
+        super.loadAdditional(input);
+        this.awaitingData = false;
+    }
+}
