+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import net.minecraft.world.level.material.FluidState;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class BedrockBucketInteractionTest {
+
+    @BeforeAll
+    static void initializeBlocks() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void findsTheSourceFaceForBothLiquids() {
+        for (final var block : new net.minecraft.world.level.block.Block[]{Blocks.WATER, Blocks.LAVA}) {
+            final var hit = BedrockBucketInteraction.sourceHit(level(Map.of(BlockPos.ZERO, block.defaultBlockState())),
+                    new Vec3(0.5, 2, 0.5), new Vec3(0.5, -1, 0.5), CollisionContext.empty());
+            assertNotNull(hit);
+            assertEquals(BlockPos.ZERO, hit.getBlockPos());
+            assertEquals(Direction.UP, hit.getDirection());
+        }
+    }
+
+    @Test
+    void flowingWaterAndSourcesOutsideReachDoNotBecomeBlockInteractions() {
+        assertNull(BedrockBucketInteraction.sourceHit(level(Map.of(BlockPos.ZERO,
+                        Blocks.WATER.defaultBlockState().setValue(BlockStateProperties.LEVEL, 1))),
+                new Vec3(0.5, 2, 0.5), new Vec3(0.5, -1, 0.5), CollisionContext.empty()));
+        assertNull(BedrockBucketInteraction.sourceHit(level(Map.of(BlockPos.ZERO, Blocks.WATER.defaultBlockState())),
+                new Vec3(0.5, 2, 0.5), new Vec3(0.5, 1, 0.5), CollisionContext.empty()));
+    }
+
+    @Test
+    void anOccludingBlockPreventsPickingTheSourceBehindIt() {
+        assertNull(BedrockBucketInteraction.sourceHit(level(Map.of(
+                        BlockPos.ZERO, Blocks.WATER.defaultBlockState(),
+                        BlockPos.ZERO.above(), Blocks.STONE.defaultBlockState())),
+                new Vec3(0.5, 3, 0.5), new Vec3(0.5, -1, 0.5), CollisionContext.empty()));
+    }
+
+    private static BlockGetter level(final Map<BlockPos, BlockState> blocks) {
+        return new BlockGetter() {
+            @Override
+            public BlockEntity getBlockEntity(final BlockPos position) { return null; }
+            @Override
+            public BlockState getBlockState(final BlockPos position) {
+                return blocks.getOrDefault(position, Blocks.AIR.defaultBlockState());
+            }
+            @Override
+            public FluidState getFluidState(final BlockPos position) { return this.getBlockState(position).getFluidState(); }
+            @Override
+            public int getHeight() { return 384; }
+            @Override
+            public int getMinY() { return -64; }
+        };
+    }
+}
