+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.ClipContext;
+import net.minecraft.world.level.material.Fluids;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.HitResult;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import org.jspecify.annotations.Nullable;
+
+public final class BedrockBucketInteraction {
+
+    private BedrockBucketInteraction() {
+    }
+
+    public static @Nullable BlockHitResult sourceHit(final BlockGetter level, final Vec3 start, final Vec3 end,
+                                                     final CollisionContext context) {
+        final var hit = level.clip(new ClipContext(start, end,
+                ClipContext.Block.OUTLINE, ClipContext.Fluid.SOURCE_ONLY, context));
+        if (hit.getType() != HitResult.Type.BLOCK) {
+            return null;
+        }
+        final var fluid = level.getFluidState(hit.getBlockPos());
+        return fluid.isSource() && (fluid.getType() == Fluids.WATER || fluid.getType() == Fluids.LAVA)
+                ? hit : null;
+    }
+}
