diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_clouds.vsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_clouds.vsh
new file mode 100644
index 0000000..d41b705
--- /dev/null
+++ b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_clouds.vsh
@@ -0,0 +1,42 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <minecraft:fog.glsl>
+#include <minecraft:dynamictransforms.glsl>
+#include <minecraft:projection.glsl>
+
+layout(std140) uniform CloudInfo {
+    vec4 CloudColor;
+    vec3 CloudOffset;
+    vec3 CellSize;
+};
+uniform isamplerBuffer CloudFaces;
+layout(location = 0) out float vertexDistance;
+layout(location = 1) out vec4 vertexColor;
+
+vec3 corner(int index) {
+    return vec3((0xF03CC3 >> index) & 1, (0x6666F0 >> index) & 1, (0xC3F066 >> index) & 1);
+}
+
+float faceLight(int direction) {
+    if (direction == 0) return 0.7;
+    if (direction == 1) return 1.0;
+    return direction < 4 ? 0.8 : 0.9;
+}
+
+void main() {
+    int quad = (gl_VertexIndex / 4) * 3;
+    int flags = texelFetch(CloudFaces, quad + 2).r;
+    int direction = flags & 7;
+    int vertex = gl_VertexIndex % 4;
+    if ((flags & 16) != 0) vertex = 3 - vertex;
+    int cellX = (texelFetch(CloudFaces, quad).r << 1) | ((flags >> 7) & 1);
+    int cellZ = (texelFetch(CloudFaces, quad + 1).r << 1) | ((flags >> 6) & 1);
+    vec3 position = (corner(direction * 4 + vertex) + vec3(cellX, 0, cellZ)) * CellSize + CloudOffset;
+    gl_Position = ProjMat * ModelViewMat * vec4(position, 1.0);
+    vertexDistance = length(position);
+    vertexColor = CloudColor * vec4(vec3(faceLight((flags & 32) != 0 ? 1 : direction)), 1.0);
+    #ifndef OIT_DEPTH_BOUNDS
+    vertexColor.a *= clamp(1.0 - max(vertexDistance / FogCloudsEnd - 0.9, 0.0), 0.0, 1.0);
+    #endif
+}
