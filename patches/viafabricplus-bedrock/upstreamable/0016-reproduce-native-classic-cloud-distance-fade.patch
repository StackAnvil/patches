+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+
+public final class BedrockCloudPipelines {
+    private static final Map<RenderPipeline, RenderPipeline> VARIANTS = variants();
+    public static final List<RenderPipeline> PIPELINES = List.copyOf(VARIANTS.values());
+
+    private BedrockCloudPipelines() {
+    }
+
+    public static RenderPipeline select(final RenderPipeline pipeline, final boolean nativeContext) {
+        return nativeContext ? VARIANTS.getOrDefault(pipeline, pipeline) : pipeline;
+    }
+
+    private static Map<RenderPipeline, RenderPipeline> variants() {
+        final List<RenderPipeline> originals = List.of(RenderPipelines.CLOUDS,
+            RenderPipelines.OIT_CLOUDS.depthBoundsPipeline(), RenderPipelines.OIT_CLOUDS.transmittancePipeline(),
+            RenderPipelines.OIT_CLOUDS.accumulatePipeline());
+        final Map<RenderPipeline, RenderPipeline> variants = new LinkedHashMap<>();
+        for (final RenderPipeline original : originals) variants.put(original, copy(original));
+        return Map.copyOf(variants);
+    }
+
+    static RenderPipeline copy(final RenderPipeline original) {
+        final ColorTargetState[] colors = original.getColorTargetStates().toArray(ColorTargetState[]::new);
+        final RenderPipeline.Snippet snippet = new RenderPipeline.Snippet(original.getShaders(),
+            Optional.of(original.getShaderDefines()), Optional.of(original.getBindGroupLayouts()), colors, colors.length,
+            Optional.ofNullable(original.getDepthStencilState()), Optional.of(original.getPolygonMode()),
+            Optional.of(original.isCull()), original.getVertexFormatBindings().toArray(VertexFormat[]::new),
+            Optional.of(original.getPrimitiveTopology()), original.pushConstantSize());
+        return RenderPipeline.builder(snippet)
+            .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/clouds/" + original.getLocation().getPath()))
+            .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_clouds"))
+            .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_clouds"))
+            .build();
+    }
+}
