+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.llamalad7.mixinextras.sugar.Local;
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockCloudFog;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.fog.environment.AtmosphericFogEnvironment;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(AtmosphericFogEnvironment.class)
+public abstract class MixinBedrockCloudFog {
+    @ModifyExpressionValue(method = "setupFog", at = @At(value = "INVOKE", target = "Ljava/lang/Math;min(FF)F", ordinal = 2))
+    private float nativeCloudDistance(final float javaDistance, @Local(argsOnly = true) final float terrainDistance) {
+        return BedrockCloudFog.active(Minecraft.getInstance()) ? terrainDistance : javaDistance;
+    }
+}
