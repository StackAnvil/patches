@@ -0,0 +1,39 @@
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import java.util.HashSet;
+import java.util.stream.Stream;
+import net.minecraft.client.renderer.RenderPipelines;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class BedrockCloudPipelinesTest {
+    @ParameterizedTest
+    @MethodSource("cloudPipelines")
+    void preservesRenderStateAndLeavesUnsupportedContextUnchanged(final RenderPipeline original) {
+        final RenderPipeline nativePipeline = BedrockCloudPipelines.select(original, true);
+        assertNotSame(original, nativePipeline);
+        assertSame(original, BedrockCloudPipelines.select(original, false));
+        assertEquals(original.getShaderDefines(), nativePipeline.getShaderDefines());
+        // The public builder stores layouts as a set; shader bindings are resolved by uniform name.
+        assertEquals(new HashSet<>(original.getBindGroupLayouts()), new HashSet<>(nativePipeline.getBindGroupLayouts()));
+        assertEquals(original.getColorTargetStates(), nativePipeline.getColorTargetStates());
+        assertEquals(original.getDepthStencilState(), nativePipeline.getDepthStencilState());
+        assertEquals(original.getPolygonMode(), nativePipeline.getPolygonMode());
+        assertEquals(original.isCull(), nativePipeline.isCull());
+        assertEquals(original.getVertexFormatBindings(), nativePipeline.getVertexFormatBindings());
+        assertEquals(original.getPrimitiveTopology(), nativePipeline.getPrimitiveTopology());
+        assertEquals(original.pushConstantSize(), nativePipeline.pushConstantSize());
+        assertSame(RenderPipelines.FLAT_CLOUDS, BedrockCloudPipelines.select(RenderPipelines.FLAT_CLOUDS, true));
+        assertEquals(4, BedrockCloudPipelines.PIPELINES.size());
+    }
+
+    private static Stream<RenderPipeline> cloudPipelines() {
+        return Stream.of(RenderPipelines.CLOUDS, RenderPipelines.OIT_CLOUDS.depthBoundsPipeline(),
+            RenderPipelines.OIT_CLOUDS.transmittancePipeline(), RenderPipelines.OIT_CLOUDS.accumulatePipeline());
+    }
+}
