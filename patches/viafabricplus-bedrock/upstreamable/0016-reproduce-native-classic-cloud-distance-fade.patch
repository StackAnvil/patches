+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import net.minecraft.client.CloudStatus;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.effect.MobEffects;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.jetbrains.annotations.Nullable;
+
+/** Verified classic cloud fog scope for Bedrock 1.26.51.1. */
+public final class BedrockCloudFog {
+    private BedrockCloudFog() {
+    }
+
+    public static boolean active(final Minecraft minecraft) {
+        final Dimension dimension = BedrockLightmapExtractor.dimension(minecraft);
+        if (dimension == null) return false;
+        final var camera = minecraft.gameRenderer.mainCamera();
+        final boolean obscured = camera.entity() instanceof LivingEntity living
+            && (living.hasEffect(MobEffects.BLINDNESS) || living.hasEffect(MobEffects.DARKNESS));
+        return supported(dimension, minecraft.options.getCloudStatus(), camera.getFluidInCamera(),
+            minecraft.level.getRainLevel(1F), minecraft.level.getThunderLevel(1F), obscured,
+            minecraft.gui.hud.getBossOverlay().shouldCreateWorldFog(), minecraft.options.getEffectiveRenderDistance());
+    }
+
+    static boolean supported(final @Nullable Dimension dimension, final CloudStatus clouds, final FogType fluid,
+                             final float rain, final float thunder, final boolean obscured,
+                             final boolean bossFog, final int effectiveChunks) {
+        // Native world captures establish D = effective terrain blocks above the low-range margin branches.
+        return dimension == Dimension.OVERWORLD && clouds == CloudStatus.FANCY && fluid == FogType.NONE
+            && rain <= 0F && thunder <= 0F && !obscured && !bossFog && effectiveChunks >= 5;
+    }
+}
