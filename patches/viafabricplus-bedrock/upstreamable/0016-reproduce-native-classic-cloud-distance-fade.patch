+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import net.minecraft.client.CloudStatus;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.junit.jupiter.api.Test;
+
+import static com.viaversion.viafabricplus.bedrock.render.light.BedrockCloudFog.supported;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BedrockCloudFogTest {
+    @Test
+    void restrictsNativeCloudFogToVerifiedOrdinaryAtmosphere() {
+        assertTrue(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, false, 10));
+        assertTrue(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, false, 5));
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, false, 4));
+        assertFalse(supported(null, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, false, 10));
+        for (final Dimension dimension : new Dimension[]{Dimension.NETHER, Dimension.END}) {
+            assertFalse(supported(dimension, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, false, 10));
+        }
+        for (final CloudStatus clouds : new CloudStatus[]{CloudStatus.FAST, CloudStatus.OFF}) {
+            assertFalse(supported(Dimension.OVERWORLD, clouds, FogType.NONE, 0F, 0F, false, false, 10));
+        }
+        for (final FogType fluid : new FogType[]{FogType.WATER, FogType.LAVA, FogType.POWDER_SNOW}) {
+            assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, fluid, 0F, 0F, false, false, 10));
+        }
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0.1F, 0F, false, false, 10));
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0.1F, false, false, 10));
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, Float.NaN, 0F, false, false, 10));
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0F, true, false, 10));
+        assertFalse(supported(Dimension.OVERWORLD, CloudStatus.FANCY, FogType.NONE, 0F, 0F, false, true, 10));
+    }
+
+}
