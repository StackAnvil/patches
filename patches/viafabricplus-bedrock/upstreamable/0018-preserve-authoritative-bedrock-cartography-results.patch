+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.raphimc.viabedrock.api.model.CartographyState;
+
+public record CartographyPayload(CartographyState state) implements CustomPacketPayload {
+    public static final Type<CartographyPayload> TYPE = new Type<>(net.minecraft.resources.Identifier.parse(CartographyState.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, CartographyPayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> CartographyState.TYPE.write(buffer, payload.state),
+        buffer -> new CartographyPayload(CartographyState.TYPE.read(buffer)));
+
+    @Override
+    public Type<CartographyPayload> type() {
+        return TYPE;
+    }
+}
