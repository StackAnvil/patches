+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.inventory;
+
+/** A delayed acknowledgement must not replace text the player has already edited again. */
+public final class CartographyNameSynchronization {
+    private int sent;
+
+    public CartographyNameSynchronization(final int acknowledged) {
+        this.sent = acknowledged;
+    }
+
+    public void edited() {
+        this.sent++;
+    }
+
+    public boolean acknowledge(final int acknowledged) {
+        if (acknowledged < this.sent) return false;
+        this.sent = acknowledged;
+        return true;
+    }
+}
