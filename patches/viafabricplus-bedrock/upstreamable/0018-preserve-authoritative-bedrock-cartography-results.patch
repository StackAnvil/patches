+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import com.viaversion.viafabricplus.bedrock.screen.BedrockCartographyScreen;
+import net.minecraft.client.Minecraft;
+import net.raphimc.viabedrock.api.model.CartographyState;
+
+/** Initial state precedes OPEN_SCREEN, including an empty table on a ViaProxy connection. */
+public final class BedrockCartographyContext {
+    private static CartographyState pending;
+
+    private BedrockCartographyContext() {}
+
+    public static void accept(final CartographyState state) {
+        if (Minecraft.getInstance().gui.screen() instanceof BedrockCartographyScreen screen
+            && screen.getMenu().containerId == state.windowId()) {
+            screen.accept(state);
+        } else {
+            pending = state;
+        }
+    }
+
+    public static CartographyState take(final int windowId) {
+        final CartographyState state = pending;
+        pending = null;
+        return state != null && state.windowId() == windowId ? state : null;
+    }
+
+    public static void clear() {
+        pending = null;
+    }
+}
