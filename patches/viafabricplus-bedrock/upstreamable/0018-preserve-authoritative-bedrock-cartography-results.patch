@@ -0,0 +1,30 @@
+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class CartographyNameSynchronizationTest {
+    @Test
+    void delayedEchoCannotReplaceASecondEdit() {
+        final var names = new CartographyNameSynchronization(4);
+        names.edited();
+        names.edited();
+        assertFalse(names.acknowledge(4));
+        assertFalse(names.acknowledge(5));
+        assertTrue(names.acknowledge(6));
+        names.edited();
+        assertFalse(names.acknowledge(6));
+        assertTrue(names.acknowledge(7));
+    }
+
+    @Test
+    void authoritativeInputChangeAppliesWhenNoEditIsPending() {
+        final var names = new CartographyNameSynchronization(0);
+        assertTrue(names.acknowledge(0));
+        assertTrue(names.acknowledge(1));
+        names.edited();
+        names.edited();
+        assertFalse(names.acknowledge(2));
+        assertTrue(names.acknowledge(3));
+    }
+}
