+import net.minecraft.network.chat.Component;
+import net.minecraft.network.protocol.game.ServerboundRenameItemPacket;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.inventory.CartographyTableMenu;
+import net.minecraft.world.inventory.ContainerInput;
+import net.minecraft.world.inventory.Slot;
+import net.raphimc.viabedrock.api.model.CartographyState;
+
+/** Native layout over the real Java menu, with all recipes and results supplied by ViaBedrock. */
+public final class BedrockCartographyScreen extends AbstractContainerScreen<CartographyTableMenu> {
+    private static final int TEXT_COLOR = 0xFF373737;
+    private final BedrockCartographyImages images = new BedrockCartographyImages();
+    private final CartographyNameSynchronization names;
+    private CartographyState state;
+    private EditBox nameField;
+    private boolean applyingName;
+
+    public BedrockCartographyScreen(final CartographyTableMenu menu, final Inventory inventory, final Component title,
+                                   final CartographyState state) {
+        super(menu, inventory, title, 176, 220);
+        this.state = state;
+        this.names = new CartographyNameSynchronization(state.editAcknowledgements());
+        this.inventoryLabelY = 130;
+        move(menu.getSlot(0), 8, 59);
+        move(menu.getSlot(1), 8, 98);
+        move(menu.getSlot(2), 149, 79);
+        for (int index = 3; index < 30; index++) move(menu.getSlot(index), 8 + (index - 3) % 9 * 18, 140 + (index - 3) / 9 * 18);
+        for (int index = 30; index < 39; index++) move(menu.getSlot(index), 8 + (index - 30) * 18, 198);
+    }
+
+    private static void move(final Slot slot, final int x, final int y) {
+        final var position = (IBedrockSlotPosition) slot;
+        position.viaFabricPlusBedrock$setX(x);
+        position.viaFabricPlusBedrock$setY(y);
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        final String previous = this.nameField == null ? this.state.name() : this.nameField.getValue();
+        this.nameField = this.addRenderableWidget(new EditBox(this.font, this.leftPos + 9, this.topPos + 34,
+            158, 14, Component.translatable("cartography.viafabricplus.map_name")));
+        this.addRenderableWidget(Button.builder(Component.literal("×"), button -> this.onClose())
+            .bounds(this.leftPos + 176, this.topPos, 20, 20).build());
+        this.nameField.setBordered(false);
+        this.nameField.setMaxLength(30);
+        this.nameField.setValue(previous);
+        this.nameField.setResponder(name -> {
+            if (!this.applyingName && this.minecraft.getConnection() != null) {
+                this.names.edited();
+                this.minecraft.getConnection().send(new ServerboundRenameItemPacket(name));
+            }
+        });
+    }
+
+    @Override
+    protected void containerTick() {
+        final var result = this.menu.getSlot(2).getItem();
+        this.nameField.setHint(result.isEmpty() ? Component.empty() : result.getHoverName());
+    }
+
+    public void accept(final CartographyState state) {
+        this.state = state;
+        if (this.nameField != null && this.names.acknowledge(state.editAcknowledgements())
+            && !this.nameField.getValue().equals(state.name())) {
+            this.applyingName = true;
+            try {
+                this.nameField.setValue(state.name());
+            } finally {
+                this.applyingName = false;
+            }
+        }
+    }
+
+    @Override
+    public void extractBackground(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        super.extractBackground(graphics, mouseX, mouseY, delta);
+        final int x = this.leftPos, y = this.topPos;
+        graphics.fill(x, y, x + this.imageWidth, y + this.imageHeight, 0xFF373737);
+        graphics.fill(x + 1, y + 1, x + 175, y + 219, 0xFFFFFFFF);
+        graphics.fill(x + 3, y + 3, x + 173, y + 217, 0xFFC6C6C6);
+        graphics.fill(x + 6, y + 30, x + 170, y + 49, 0xFF373737);
+        graphics.fill(x + 7, y + 31, x + 169, y + 48, 0xFFFFFFFF);
+        graphics.fill(x + 8, y + 32, x + 168, y + 47, 0xFF5B5B5B);
+        for (final Slot slot : this.menu.slots) slotFrame(graphics, x + slot.x, y + slot.y, 16);
+        slotFrame(graphics, x + 145, y + 75, 24);
+        this.images.draw(graphics, "anvil-plus", x + 9, y + 80, 13, 13);
+        this.images.draw(graphics, "arrow", x + 32, y + 81, 16, 13);
+        this.images.draw(graphics, "arrow", x + 125, y + 81, 16, 13);
+        final String preview = switch (this.state.operation()) {
+            case "clone" -> "cartography_table_copy";
+            case "extend" -> "cartography_table_zoom";
+            case "lock" -> "cartography_table_glass";
+            case "empty" -> "cartography_table_empty";
+            default -> "cartography_table_map";
+        };
+        if (!this.images.draw(graphics, preview, x + 55, y + 55, 66, 66)) {
+            graphics.textWithWordWrap(this.font, Component.translatable(this.images.loading()
+                ? "cartography.viafabricplus.loading_images" : "cartography.viafabricplus.missing_images"), x + 55, y + 73, 66, TEXT_COLOR, false);
+        }
+    }
+
+    private static void slotFrame(final GuiGraphicsExtractor graphics, final int x, final int y, final int size) {
+        graphics.fill(x - 1, y - 1, x + size + 1, y + size + 1, 0xFFFFFFFF);
+        graphics.fill(x - 1, y - 1, x + size, y + size, 0xFF373737);
+        graphics.fill(x, y, x + size, y + size, 0xFF8B8B8B);
+    }
+
+    @Override
+    protected void extractLabels(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY) {
+        graphics.text(this.font, this.title, (this.imageWidth - this.font.width(this.title)) / 2, 6, TEXT_COLOR, false);
+        graphics.text(this.font, Component.translatable("cartography.viafabricplus.map_name"), 6, 20, TEXT_COLOR, false);
+        graphics.text(this.font, this.playerInventoryTitle, 6, this.inventoryLabelY, TEXT_COLOR, false);
+        if (!"empty".equals(this.state.operation())) {
+            final Component caption = Component.translatable("cartography.viafabricplus." + this.state.operation());
+            graphics.text(this.font, caption, (this.imageWidth - this.font.width(caption)) / 2, 122, TEXT_COLOR, false);
+        }
+    }
+
+    @Override
+    public boolean keyPressed(final KeyEvent event) {
+        if (event.isEscape()) {
+            this.onClose();
+            return true;
+        }
+        if (this.nameField.keyPressed(event) || this.nameField.canConsumeInput()) return true;
+        return super.keyPressed(event);
+    }
+
+    @Override
+    protected void slotClicked(final Slot slot, final int id, final int button, final ContainerInput action) {
+        super.slotClicked(slot, id, id == 2 && action == ContainerInput.QUICK_MOVE ? 0 : button, action);
+    }
+
+    @Override
+    public void removed() {
+        this.images.close();
+        super.removed();
+    }
+}
