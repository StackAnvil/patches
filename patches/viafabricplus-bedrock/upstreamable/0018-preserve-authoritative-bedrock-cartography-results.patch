+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CartographyUiResourceRewriter;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+
+/** Resolves accepted server overrides first, with independently licensed native images underneath. */
+public final class BedrockCartographyImages implements AutoCloseable {
+    private final Map<String, Image> images = new LinkedHashMap<>();
+    private boolean closed;
+    private boolean loading = true;
+
+    public BedrockCartographyImages() {
+        final var account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null) {
+            this.loading = false;
+            return;
+        }
+        CompletableFuture.supplyAsync(() -> {
+            final Map<String, byte[]> bytes = new LinkedHashMap<>();
+            try {
+                final var library = BedrockBuiltinAssets.load(account).library();
+                for (final String name : CartographyUiResourceRewriter.IMAGES) {
+                    final byte[] file = library.particleTexture("textures/ui/" + name);
+                    if (file != null) {
+                        final var image = BedrockParticleTexture.read(file);
+                        if (image.getWidth() > 1024 || image.getHeight() > 1024) continue;
+                        final var encoded = new java.io.ByteArrayOutputStream();
+                        javax.imageio.ImageIO.write(image, "png", encoded);
+                        bytes.put(name, encoded.toByteArray());
+                    }
+                }
+            } catch (final Exception ignored) {
+                // The screen remains usable while acquisition is unavailable. No unlicensed substitute is shipped.
+            }
+            return bytes;
+        }).thenAccept(bytes -> Minecraft.getInstance().execute(() -> {
+            this.loading = false;
+            if (this.closed || ViaFabricPlusBedrock.impl().account().get() != account) return;
+            for (final var entry : bytes.entrySet()) {
+                try {
+                    final NativeImage pixels = NativeImage.read(entry.getValue());
+                    if (pixels.getWidth() > 1024 || pixels.getHeight() > 1024) {
+                        pixels.close();
+                        continue;
+                    }
+                    final Identifier id = Identifier.fromNamespaceAndPath("viafabricplus-bedrock",
+                        "cartography/" + UUID.randomUUID() + '/' + entry.getKey());
+                    Minecraft.getInstance().getTextureManager().register(id, new DynamicTexture(id::toString, pixels));
+                    this.images.put(entry.getKey(), new Image(id, pixels.getWidth(), pixels.getHeight()));
+                } catch (final Exception ignored) {
+                    // A missing image does not change the server's recipe or result.
+                }
+            }
+        }));
+    }
+
+    public boolean draw(final GuiGraphicsExtractor graphics, final String name, final int x, final int y,
+                        final int width, final int height) {
+        final var minecraft = Minecraft.getInstance();
+        final Identifier server = Identifier.fromNamespaceAndPath("viabedrock", "textures/cartography/" + name + ".png");
+        final var resource = minecraft.getResourceManager().getResource(server);
+        if (resource.isPresent() && resource.get().source().location().source() == PackSource.SERVER) {
+            graphics.blit(RenderPipelines.GUI_TEXTURED, server, x, y, 0, 0, width, height,
+                width, height, width, height);
+            return true;
+        }
+        final Image image = this.images.get(name);
+        if (image == null) return false;
+        graphics.blit(RenderPipelines.GUI_TEXTURED, image.id, x, y, 0, 0, width, height,
+            image.width, image.height, image.width, image.height);
+        return true;
+    }
+
+    public boolean loading() {
+        return this.loading;
+    }
+
+    @Override
+    public void close() {
+        this.closed = true;
+        for (final Image image : this.images.values()) Minecraft.getInstance().getTextureManager().release(image.id);
+        this.images.clear();
+    }
+
+    private record Image(Identifier id, int width, int height) {}
+}
