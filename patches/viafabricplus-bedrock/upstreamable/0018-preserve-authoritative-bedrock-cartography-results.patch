+import com.viaversion.viafabricplus.bedrock.inventory.BedrockCartographyContext;
+import com.viaversion.viafabricplus.bedrock.screen.BedrockCartographyScreen;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.MenuScreens;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.inventory.AbstractContainerMenu;
+import net.minecraft.world.inventory.MenuType;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(MenuScreens.class)
+public abstract class MixinBedrockCartographyScreen {
+    @Inject(method = "create", at = @At("HEAD"), cancellable = true)
+    private static <T extends AbstractContainerMenu> void openCartography(final MenuType<T> type, final Minecraft minecraft,
+                                                                         final int id, final Component title, final CallbackInfo ci) {
+        final var state = BedrockCartographyContext.take(id);
+        if (type != MenuType.CARTOGRAPHY_TABLE || state == null || minecraft.player == null) return;
+        final var inventory = minecraft.player.getInventory();
+        final var menu = MenuType.CARTOGRAPHY_TABLE.create(id, inventory);
+        minecraft.player.containerMenu = menu;
+        minecraft.gui.setScreen(new BedrockCartographyScreen(menu, inventory, title, state));
+        ci.cancel();
+    }
+}
