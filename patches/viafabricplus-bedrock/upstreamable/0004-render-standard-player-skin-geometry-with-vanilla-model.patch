From c322d85eea1a03b300113d25ac6938330ed2283b Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 09:48:53 +0200
Subject: [PATCH] fix(bedrock): render standard player skin geometry with
 vanilla model

Bedrock standard and slim humanoid geometry use the same player UV layout as Java. Rendering those skins through the custom geometry path misplaces texture regions and overlays. Keep custom geometry rendering for actual custom models while letting the vanilla player renderer handle standard geometry.
---
 .../viafabricplus/bedrock/render/BedrockPlayerSkins.java   | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
index 80e5831..0daed6c 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
@@ -157,13 +157,18 @@ public final class BedrockPlayerSkins {
     }
 
     private static BedrockGeometryModel geometry(final SkinData skin) {
+        final String name = geometryName(skin);
+        if ("geometry.humanoid.custom".equalsIgnoreCase(name) || "geometry.humanoid.customSlim".equalsIgnoreCase(name)) {
+            // These are Bedrock's standard Steve and Alex models. Minecraft's
+            // player renderer already knows their exact UVs and overlay layout.
+            return null;
+        }
         if (skin.geometryData() == null || skin.geometryData().isBlank() || "null".equalsIgnoreCase(skin.geometryData())) {
             return null;
         }
         try {
             final JsonObject data = JsonParser.parseString(skin.geometryData()).getAsJsonObject();
             final List<BedrockGeometryModel> models = BedrockGeometryModel.fromJson(data);
-            final String name = geometryName(skin);
             return models.stream().filter(model -> model.getIdentifier().equals(name)).findFirst()
                 .orElseGet(() -> models.isEmpty() ? null : models.getFirst());
         } catch (RuntimeException e) {
