@@ -0,0 +1,34 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+/** Ordinary player FOV modifier from Bedrock 1.26.60.5. */
+public final class BedrockPlayerFov {
+    private BedrockPlayerFov() { }
+
+    /** A negative Slowness amplifier means the effect is absent. */
+    public static float modifier(final boolean effects, final boolean flying, final float movementSpeed,
+                                 final float walkingSpeed, final int slownessAmplifier, final float swimMultiplier,
+                                 final boolean usingBow, final int useTicks, final boolean scoping) {
+        float modifier = 1F;
+        if (effects) {
+            if (flying) modifier = 1.1F;
+            // Keep the native float order and zero-speed division. Projection clamps the final degrees,
+            // while the modifier history must retain extreme values for later interpolation.
+            modifier *= slownessAmplifier < 0
+                    ? ((movementSpeed / walkingSpeed) * 1.2F + 1F) * .5F
+                    : Math.max(.01F, slownessAmplifier * -.1F + 1F);
+            if (swimMultiplier > 1F) modifier *= 1.1F;
+            if (usingBow) {
+                final float charge = useTicks / 20F;
+                final float squared = charge * charge;
+                modifier *= squared > 1F ? .85F : Math.max(squared, 0F) * -.15F + 1F;
+            }
+        }
+        // Native scoping overrides the ordinary modifier even when gameplay FOV is disabled.
+        return scoping ? .1F : modifier;
+    }
+}
