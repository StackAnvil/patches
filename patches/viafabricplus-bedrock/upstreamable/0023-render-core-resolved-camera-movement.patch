+    }
+
+    @Inject(method = "alignWithEntity", at = @At("TAIL"))
+    private void applyServerShake(final float partialTick, final CallbackInfo ci) {
+        if ((Object) this != Minecraft.getInstance().gameRenderer.mainCamera()) return;
+        final CameraPose normal = CameraPose.fromDegrees(new CameraPose.Vector((float) this.position.x,
+                (float) this.position.y, (float) this.position.z), this.xRot, this.yRot,
+                this.fov, net.minecraft.client.Minecraft.getInstance().options.getCameraType() == net.minecraft.client.CameraType.FIRST_PERSON
+                        ? CameraPositionState.Mode.FIRST_PERSON.ordinal()
+                        : net.minecraft.client.Minecraft.getInstance().options.getCameraType() == net.minecraft.client.CameraType.THIRD_PERSON_FRONT
+                                ? CameraPositionState.Mode.THIRD_PERSON_FRONT.ordinal() : CameraPositionState.Mode.THIRD_PERSON.ordinal());
+        final CameraPose pose = BedrockCameraPosition.frame(normal);
+        if (pose != null) {
+            final var angles = pose.orientation().angles();
+            this.setRotation(180F - angles.y() / CameraPose.DEGREES, -angles.x() / CameraPose.DEGREES);
+            this.setPosition(new Vec3(pose.position().x(), pose.position().y(), pose.position().z()));
+            this.detached = pose.renderingMode() == CameraPositionState.Mode.BOOM.ordinal()
+                    || pose.renderingMode() == CameraPositionState.Mode.FREE.ordinal()
+                    || pose.renderingMode() == CameraPositionState.Mode.THIRD_PERSON.ordinal()
+                    || pose.renderingMode() == CameraPositionState.Mode.THIRD_PERSON_FRONT.ordinal();
+        }
+        final var timeline = BedrockCameraShake.advance();
+        if (!BedrockCameraShake.enabled()) return;
+        final var state = timeline.snapshot();
+        if (state.rotational() > 0) {
+            final var rotation = timeline.offset(1);
+            final float degrees = 180F / (float) Math.PI;
+            this.setRotation(
+                    this.yRot + rotation.y() * degrees, this.xRot + rotation.x() * degrees);
+        }
+        if (state.positional() > 0) {
+            final var position = timeline.offset(0);
+            this.setPosition(this.position.add(position.x(), position.y(), position.z()));
+        }
+    }
+}
