+        PENDING.addLast(snapshot);
+    }
+
+    public static void accept(final CameraTrackingState snapshot) {
+        TRACKING.accept(snapshot);
+    }
+
+    public static void accept(final CameraSplineState snapshot) {
+        TRACKING.accept(snapshot);
+    }
+
+    public static void accept(final CameraFollowState snapshot) {
+        FOLLOW.accept(snapshot);
+    }
+
+    public static void turn(final float pitchDelta, final float yawDelta) {
+        final var requested = PENDING.isEmpty() ? state : PENDING.getLast();
+        if (requested.mode() == Mode.BOOM && Float.isFinite(pitchDelta) && Float.isFinite(yawDelta)) {
+            FOLLOW.input(requested.sequence(), pitchDelta, yawDelta);
+        }
+    }
+
+    public static void clear() {
+        FOLLOW.clear();
+        TRACKING.clear();
+        PENDING.clear();
+        state = CameraPositionState.EMPTY;
+        rendered = null;
+        acceptedSequence = appliedSequence = -1;
+        previousFrame = 0;
+        preparingTarget = false;
+        partialTick = 0;
+    }
+
+    public static void beginFrame(final float tick) {
+        partialTick = tick;
+        preparingTarget = true;
+    }
+
+    public static CameraAudioListener playerListener() {
+        final var player = Minecraft.getInstance().player;
+        if (state.mode() == Mode.LOCAL || !state.playerAudio() || player == null) return null;
+        final var position = player.getEyePosition(partialTick);
+        return CameraAudioListener.player(new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z),
+                player.getXRot(), player.getYRot());
+    }
+
+    public static CameraType perspective(final CameraType local) {
+        final Mode mode;
+        if (preparingTarget) {
+            final CameraPositionState requested = PENDING.isEmpty() ? state : PENDING.getLast();
+            // Detached targets have their own poses. Normal alignment supplies the local blend input.
+            mode = requested.mode() == Mode.FREE || requested.mode() == Mode.BOOM ? Mode.LOCAL : requested.mode();
+        } else {
+            mode = state.mode() == Mode.LOCAL || rendered == null ? Mode.LOCAL : Mode.values()[rendered.renderingMode()];
+        }
+        return switch (mode) {
+            case LOCAL -> local;
+            case FIRST_PERSON -> CameraType.FIRST_PERSON;
+            case THIRD_PERSON, FREE, BOOM -> CameraType.THIRD_PERSON_BACK;
+            case THIRD_PERSON_FRONT -> CameraType.THIRD_PERSON_FRONT;
+        };
+    }
+
+    public static CameraPose frame(final CameraPose normal) {
+        preparingTarget = false;
+        final long now = System.nanoTime();
+        final float delta = previousFrame == 0 ? 0 : Math.max(0, (now - previousFrame) / 1_000_000_000F);
+        previousFrame = now;
+        boolean changed = false;
+        while (!PENDING.isEmpty()) {
+            final CameraPositionState snapshot = PENDING.removeFirst();
+            state = snapshot;
+            if (snapshot.mode() != Mode.LOCAL) {
+                // A snapshot lacks the old client's interrupted frame. Restore its settled target,
+                // rather than replaying an expired or newly negotiated cutscene from a guessed pose.
+                final boolean continuous = snapshot.live() && snapshot.sequence() == appliedSequence + 1;
+                TIMELINE.begin(rendered != null ? rendered : normal, continuous ? snapshot.duration() : 0, snapshot.ease());
+            }
+            appliedSequence = snapshot.sequence();
+            changed = true;
+        }
+        TRACKING.advance(delta, BedrockCameraPosition::targetActor);
+        FOLLOW.advance(delta, localFollowActor(), BedrockCameraPosition::followActor, new BedrockCameraWorld(Minecraft.getInstance().level));
+        if (state.mode() == Mode.LOCAL) {
+            rendered = normal;
+            return null;
+        }
+        final CameraPose tracked = TRACKING.active(state.sequence(), normal.fov(), Mode.FREE.ordinal());
+        final CameraPose follow = FOLLOW.active(state.sequence(), normal.fov(), Mode.BOOM.ordinal());
+        final CameraPose target = switch (state.mode()) {
+            case BOOM -> follow != null ? follow : rendered != null ? rendered : normal;
+            case FREE -> tracked != null ? tracked : CameraPose.fromDegrees(state.position(), state.pitch(), state.yaw(), normal.fov(), Mode.FREE.ordinal());
+            default -> new CameraPose(normal.position(), normal.orientation(), normal.fov(), state.mode().ordinal());
+        };
+        rendered = TIMELINE.advance(changed ? 0 : delta, target, null);
+        return rendered;
+    }
+
+    private static CameraTrackingRuntime.Actor targetActor(final long uniqueId) {
+        final var actor = followActor(uniqueId);
+        return actor == null || actor.sample() == null ? null
+                : new CameraTrackingRuntime.Actor(actor.lifetime(), new CameraTargetTracker.Sample(actor.sample().center(), actor.sample().yaw()));
+    }
+
+    private static CameraFollowRuntime.Actor localFollowActor() {
+        final var player = Minecraft.getInstance().player;
+        if (player == null) return null;
+        final var snapshot = BedrockActorState.state(player.getUUID());
+        if (snapshot == null) return null;
+        final var position = player.getPosition(partialTick);
+        final var origin = new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z);
+        return new CameraFollowRuntime.Actor(snapshot.lifetime(), new CameraFollowRuntime.Sample(origin, origin, player.getYRot(partialTick)));
+    }
+
+    private static CameraFollowRuntime.Actor followActor(final long uniqueId) {
+        final var level = Minecraft.getInstance().level;
+        final var uuid = BedrockActorState.uuidByUniqueId(uniqueId);
+        if (level == null || uuid == null) return null;
+        final var snapshot = BedrockActorState.state(uuid);
+        if (snapshot == null) return null;
+        final var entity = level.getEntity(uuid);
+        final var bounds = BedrockActorState.bounds(uuid);
+        if (entity == null || entity.isRemoved() || bounds == null || !bounds.lifetime().equals(snapshot.lifetime()) || bounds.height() == null)
+            return new CameraFollowRuntime.Actor(snapshot.lifetime(), null);
+        if (!Float.isFinite(bounds.height()) || bounds.height() < 0 || !Float.isFinite(snapshot.scale()) || snapshot.scale() < 0
+                || !Float.isFinite(bounds.height() * snapshot.scale()) || bounds.height() * snapshot.scale() >= 1E9F)
+            return new CameraFollowRuntime.Actor(snapshot.lifetime(), null);
+        final float height = NativeActorBoundsMessage.scaledDimension(bounds.height(), snapshot.scale());
+        final var position = entity.getPosition(partialTick);
+        return new CameraFollowRuntime.Actor(snapshot.lifetime(), new CameraFollowRuntime.Sample(
+                new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z),
+                new CameraPose.Vector((float) position.x, (float) position.y + height * .5F, (float) position.z), entity.getYRot(partialTick)));
+    }
+}
