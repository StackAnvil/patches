+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.raphimc.viabedrock.api.model.CameraAimAssistActivation;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.CameraAimAssistClientState;
+import net.raphimc.viabedrock.api.model.CameraAimAssistMessage;
+import net.raphimc.viabedrock.api.model.CameraAimAssistView;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+
+import java.util.UUID;
+
+/** Connection-scoped catalog and actor bindings. Selection and rotation require separate native execution. */
+public final class BedrockCameraAimAssist {
+    private static long sentView = -1;
+    private static boolean sentAllowed;
+    private static final CameraAimAssistClientState STATE = new CameraAimAssistClientState();
+
+    private BedrockCameraAimAssist() { }
+
+    public static void register() {
+        PayloadTypeRegistry.serverboundPlay().register(CameraAimAssistControlPayload.TYPE, CameraAimAssistControlPayload.CODEC);
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            final var view = STATE.view();
+            if (client.player == null || client.getConnection() == null || view == null) {
+                return;
+            }
+            final boolean allowed = CameraAimAssistActivation.allowed(view.camera(), client.options.getCameraType().isFirstPerson());
+            if (STATE.viewSequence() != sentView || allowed != sentAllowed) {
+                ClientPlayNetworking.send(new CameraAimAssistControlPayload(new CameraAimAssistActivation.Control(STATE.viewSequence(), allowed)));
+                sentView = STATE.viewSequence();
+                sentAllowed = allowed;
+            }
+        });
+    }
+
+    public static void accept(final Connection connection, final CameraAimAssistMessage message) {
+        final long generation = STATE.generation();
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (STATE.generation() == generation && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                STATE.accept(generation, message);
+            }
+        });
+    }
+
+    public static CameraAimAssistView view() {
+        return STATE.view();
+    }
+
+    public static CameraAimAssistMessage.Binding binding(final UUID actor) {
+        return STATE.binding(actor, BedrockActorState::lifetime);
+    }
+
+    public static void clear() {
+        STATE.clear();
+        sentView = -1;
+        sentAllowed = false;
+    }
+}
