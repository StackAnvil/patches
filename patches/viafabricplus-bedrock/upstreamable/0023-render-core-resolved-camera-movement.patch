+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.server.Bootstrap;
+import net.raphimc.viabedrock.api.model.CameraEase;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraPositionState.Mode;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+
+final class BedrockCameraPositionTest {
+    private static final CameraPose PLAYER = CameraPose.fromDegrees(new CameraPose.Vector(.5F, 71.62F, .5F), 0, 0, 70, Mode.LOCAL.ordinal());
+    private static final CameraPose.Vector OLD = new CameraPose.Vector(-7.5F, 74.5F, -3.5F);
+    private static final CameraPose.Vector TARGET = new CameraPose.Vector(8.5F, 74.5F, -3.5F);
+
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @AfterEach
+    void clear() {
+        BedrockCameraPosition.clear();
+    }
+
+    @Test
+    void clearBeforeAnotherCommandInTheSameFrameStartsItsBlendAtThePlayerCamera() {
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(mock(Minecraft.class));
+            BedrockCameraPosition.accept(command(1, Mode.FREE, OLD, 0));
+            assertEquals(OLD, BedrockCameraPosition.frame(PLAYER).position());
+
+            BedrockCameraPosition.accept(command(2, Mode.LOCAL, CameraPose.Vector.ZERO, 0));
+            BedrockCameraPosition.accept(command(3, Mode.FREE, TARGET, 2));
+            final CameraPose first = BedrockCameraPosition.frame(PLAYER);
+            assertEquals(PLAYER.position(), first.position());
+        }
+    }
+
+    @Test
+    void anotherFreeCommandWithoutClearStartsItsBlendAtTheRenderedCamera() {
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(mock(Minecraft.class));
+            BedrockCameraPosition.accept(command(1, Mode.FREE, OLD, 0));
+            assertEquals(OLD, BedrockCameraPosition.frame(PLAYER).position());
+
+            BedrockCameraPosition.accept(command(2, Mode.FREE, TARGET, 2));
+            assertEquals(OLD, BedrockCameraPosition.frame(PLAYER).position());
+        }
+    }
+
+    private static CameraPositionState command(final long sequence, final Mode mode, final CameraPose.Vector position, final float duration) {
+        return new CameraPositionState(sequence, 0, true, mode, position, 0, 0, duration, CameraEase.LINEAR, true, false);
+    }
+}
