+import com.mojang.blaze3d.audio.ListenerTransform;
+import com.viaversion.viafabricplus.bedrock.camera.BedrockCameraPosition;
+import net.minecraft.client.sounds.SoundEngine;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(SoundEngine.class)
+public abstract class MixinBedrockCameraListener {
+
+    @ModifyExpressionValue(method = "updateSource", at = @At(value = "NEW", target = "(Lnet/minecraft/world/phys/Vec3;Lnet/minecraft/world/phys/Vec3;Lnet/minecraft/world/phys/Vec3;)Lcom/mojang/blaze3d/audio/ListenerTransform;"))
+    private ListenerTransform selectPlayerListener(final ListenerTransform camera) {
+        final var player = BedrockCameraPosition.playerListener();
+        return player == null ? camera : new ListenerTransform(vector(player.position()), vector(player.forward()), vector(player.up()));
+    }
+
+    private static Vec3 vector(final CameraPose.Vector value) {
+        return new Vec3(value.x(), value.y(), value.z());
+    }
+
+}
