+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.CameraFollowRuntime;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockDeathCameraTest {
+    @Test
+    void continuesAfterTheHostDeathCounterStopsAndRestartsAfterRespawn() {
+        final var camera = new BedrockDeathCamera();
+        camera.tick(true, 20);
+        final float early = camera.fieldOfView(.5F);
+        for (int i = 0; i < 100; i++) camera.tick(true, 20);
+        assertEquals(84F, camera.fieldOfView(.5F));
+        assertTrue(early < camera.fieldOfView(.5F));
+        camera.tick(false, 20);
+        assertFalse(camera.active());
+        camera.tick(true, 0);
+        assertEquals(60F, camera.fieldOfView(0));
+    }
+
+    @Test
+    void retainsTheSignedShortCounterWhenTheDeathScreenStaysOpen() {
+        final var camera = new BedrockDeathCamera();
+        camera.tick(true, Short.MAX_VALUE);
+        assertEquals(84F, camera.fieldOfView(0));
+        camera.tick(true, 20);
+        assertEquals(60F, camera.fieldOfView(0));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_DEATH_CAMERA_REFERENCE", matches = ".+")
+    void matchesTheExecutedDefaultDeathProjectionAcrossSliderAndFluidInputs() throws Exception {
+        final var fixture = reference("native-world-default-death-cases.json");
+        int checked = 0;
+        for (final var value : fixture.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            if (row.get("alive").getAsBoolean()) continue;
+            final var camera = new BedrockDeathCamera();
+            camera.tick(true, row.get("ticks").getAsInt());
+            final float normal = row.get("fov").getAsFloat() * row.get("modifier").getAsFloat();
+            assertEquals(row.get("bits").getAsInt(), Float.floatToRawIntBits(camera.projection(normal,
+                    row.get("effects").getAsBoolean() ? 1F : 0F, row.get("alpha").getAsFloat())), row::toString);
+            checked++;
+        }
+        assertTrue(checked > 0, "The native fixture contains no default death projections");
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_DEATH_CAMERA_REFERENCE", matches = ".+")
+    void projectsTheSettledDeathViewOntoBothNativeMarkerCaptures() throws Exception {
+        final var fixture = reference("native-death-geometry-review.json");
+        final var eye = fixture.getAsJsonArray("eye");
+        final var camera = new BedrockDeathCamera();
+        camera.tick(true, 120);
+        final var pose = camera.pose(new CameraPose.Vector(eye.get(0).getAsFloat(), eye.get(1).getAsFloat(),
+                eye.get(2).getAsFloat()), 0, camera.fieldOfView(0), 0, new CameraFollowRuntime.World() {
+            @Override
+            public boolean insideSolidBlock(final CameraPose.Vector origin) { return false; }
+            @Override
+            public CameraPose.Vector cast(final CameraPose.Vector start, final CameraPose.Vector end) { return null; }
+        });
+        final var angles = pose.orientation().angles();
+        final double pitch = -angles.x(), yaw = CameraPose.PI - angles.y();
+        final double sx = Math.sin(yaw), cx = Math.cos(yaw), sp = Math.sin(pitch), cp = Math.cos(pitch);
+        final double focal = 360 / Math.tan(pose.fov() * Math.PI / 360);
+        final double[][] bounds = new double[2][4];
+        for (int marker = 0; marker < 2; marker++) {
+            bounds[marker] = new double[]{Double.POSITIVE_INFINITY, Double.POSITIVE_INFINITY,
+                    Double.NEGATIVE_INFINITY, Double.NEGATIVE_INFINITY};
+            for (final int x : new int[]{-marker * 2, 1 - marker * 2}) {
+                for (final int y : new int[]{102, 103}) {
+                    final double dx = x - pose.position().x(), dy = y - pose.position().y(), dz = 8 - pose.position().z();
+                    final double depth = -sx * cp * dx - sp * dy + cx * cp * dz;
+                    final double px = 640 + (-cx * dx - sx * dz) * focal / depth;
+                    final double py = 360 - (-sx * sp * dx + cp * dy + cx * sp * dz) * focal / depth;
+                    bounds[marker][0] = Math.min(bounds[marker][0], px);
+                    bounds[marker][1] = Math.min(bounds[marker][1], py);
+                    bounds[marker][2] = Math.max(bounds[marker][2], px);
+                    bounds[marker][3] = Math.max(bounds[marker][3], py);
+                }
+            }
+        }
+        for (final var value : fixture.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            final var boxes = row.getAsJsonArray("boxes");
+            for (int marker = 0; marker < 2; marker++) {
+                for (int edge = 0; edge < 4; edge++) {
+                    assertEquals(boxes.get(marker).getAsJsonArray().get(edge).getAsDouble(), bounds[marker][edge],
+                            1.1, row::toString);
+                }
+            }
+        }
+    }
+
+    private static JsonObject reference(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_DEATH_CAMERA_REFERENCE"), name)))
+                .getAsJsonObject();
+    }
+}
