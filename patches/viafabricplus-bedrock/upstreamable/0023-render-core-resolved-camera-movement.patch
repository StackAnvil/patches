--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockCameraWorld.java
@@ -0,0 +1,95 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import com.viaversion.viafabricplus.bedrock.block.BedrockCustomBlocks;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.core.BlockPos;
+import net.minecraft.tags.FluidTags;
+import net.minecraft.world.level.block.LiquidBlock;
+import net.minecraft.world.level.material.FluidState;
+import net.raphimc.viabedrock.api.model.CameraFollowRuntime;
+import net.raphimc.viabedrock.api.model.CameraPose.Vector;
+import net.raphimc.viabedrock.api.model.CameraRaycast;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual;
+
+import java.util.List;
+
+/** Supplies the translated world's geometry to the shared native camera tracer. */
+final class BedrockCameraWorld implements CameraFollowRuntime.World, CameraRaycast.World {
+
+    private final ClientLevel level;
+
+    BedrockCameraWorld(final ClientLevel level) {
+        this.level = level;
+    }
+
+    @Override
+    public boolean insideSolidBlock(final Vector origin) {
+        if (this.level == null) return false;
+        final var state = this.level.getBlockState(BlockPos.containing(origin.x(), origin.y(), origin.z()));
+        final var custom = BedrockCustomBlocks.current(state);
+        return custom != null ? custom.definition().occluding() : state.isSolidRender();
+    }
+
+    @Override
+    public Vector cast(final Vector start, final Vector end) {
+        final var hit = CameraRaycast.cast(start, end, this);
+        return hit != null ? hit.position() : null;
+    }
+
+    @Override
+    public CameraRaycast.Block base(final int x, final int y, final int z) {
+        if (this.level == null) return null;
+        final var pos = new BlockPos(x, y, z);
+        final var state = this.level.getBlockState(pos);
+        if (state.isAir()) return null;
+        if (state.getBlock() instanceof LiquidBlock) return liquid(state.getFluidState());
+        final var custom = BedrockCustomBlocks.current(state);
+        if (custom != null) {
+            final var definition = custom.definition();
+            return new CameraRaycast.Block(null, false, envelope(definition.cameraBoxesAt(x, y, z)),
+                    envelope(definition.selectionBoxesAt(x, y, z)), CameraRaycast.Pick.ALWAYS);
+        }
+        final var shape = state.getCollisionShape(this.level, pos);
+        if (shape.isEmpty()) return null;
+        final var bounds = shape.bounds();
+        final var box = new CameraRaycast.Box(x + (float) bounds.minX, y + (float) bounds.minY, z + (float) bounds.minZ,
+                x + (float) bounds.maxX, y + (float) bounds.maxY, z + (float) bounds.maxZ);
+        return new CameraRaycast.Block(null, false, box, box, CameraRaycast.Pick.ALWAYS);
+    }
+
+    @Override
+    public CameraRaycast.Block extra(final int x, final int y, final int z) {
+        if (this.level == null) return null;
+        final var state = this.level.getBlockState(new BlockPos(x, y, z));
+        return state.getBlock() instanceof LiquidBlock || state.getFluidState().isEmpty() ? null : liquid(state.getFluidState());
+    }
+
+    private static CameraRaycast.Block liquid(final FluidState fluid) {
+        final Object material = fluid.is(FluidTags.WATER) ? FluidTags.WATER : fluid.is(FluidTags.LAVA) ? FluidTags.LAVA : fluid.getType();
+        return new CameraRaycast.Block(material, true, null, null, CameraRaycast.Pick.LIQUID);
+    }
+
+    private static CameraRaycast.Box envelope(final List<CustomBlockVisual.Box> boxes) {
+        if (boxes.isEmpty()) return null;
+        float minX = Float.POSITIVE_INFINITY;
+        float minY = Float.POSITIVE_INFINITY;
+        float minZ = Float.POSITIVE_INFINITY;
+        float maxX = Float.NEGATIVE_INFINITY;
+        float maxY = Float.NEGATIVE_INFINITY;
+        float maxZ = Float.NEGATIVE_INFINITY;
+        for (final var box : boxes) {
+            minX = Math.min(minX, (float) box.minX());
+            minY = Math.min(minY, (float) box.minY());
+            minZ = Math.min(minZ, (float) box.minZ());
+            maxX = Math.max(maxX, (float) box.maxX());
+            maxY = Math.max(maxY, (float) box.maxY());
+            maxZ = Math.max(maxZ, (float) box.maxZ());
+        }
+        return new CameraRaycast.Box(minX, minY, minZ, maxX, maxY, maxZ);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockDeathCamera.java b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockDeathCamera.java
