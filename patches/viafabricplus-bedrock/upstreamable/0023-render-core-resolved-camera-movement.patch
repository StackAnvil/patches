--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockDeathCamera.java
@@ -0,0 +1,79 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.raphimc.viabedrock.api.model.CameraAvoidance;
+import net.raphimc.viabedrock.api.model.CameraFollowRuntime;
+import net.raphimc.viabedrock.api.model.CameraOrbit;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+
+/** The default death profile and counter in Bedrock 1.26.60.5. */
+final class BedrockDeathCamera {
+    private static final float RADIUS = 8F;
+    private static final float POLAR = 60F * CameraPose.DEGREES;
+    private boolean active;
+    private short ticks;
+    private CameraOrbit orbit;
+    private CameraAvoidance avoidance;
+
+    void tick(final boolean dead, final int initialDeathTicks) {
+        if (!dead) {
+            this.clear();
+        } else if (this.active) {
+            this.ticks++;
+        } else {
+            this.active = true;
+            this.ticks = (short) initialDeathTicks;
+        }
+    }
+
+    boolean active() {
+        return this.active;
+    }
+
+    float fieldOfView(final float partialTick) {
+        return fieldOfView(this.ticks, partialTick);
+    }
+
+    float projection(final float normalFov, final float effectScale, final float partialTick) {
+        final float nativeFov = this.fieldOfView(partialTick);
+        // Disabled gameplay effects preserve the existing modifier history before it converges to one.
+        return effectScale == 1F ? nativeFov : normalFov + effectScale * (nativeFov - normalFov);
+    }
+
+    static float fieldOfView(final int deathTicks, final float partialTick) {
+        final float progress = Math.clamp(((float) (short) deathTicks + partialTick) / 120F, 0F, 1F);
+        // The original renderer uses the native sine lookup, then replaces the slider-derived FOV.
+        final float eased = .4F * BedrockTrigonometry.sine(progress * (CameraPose.PI * .5F));
+        return (eased + 1F) * 60F;
+    }
+
+    CameraPose pose(final CameraPose.Vector eye, final float yaw, final float fov, final float delta,
+                    final CameraFollowRuntime.World world) {
+        final var target = new CameraOrbit.Target(RADIUS, (yaw - 90F) * CameraPose.DEGREES, POLAR);
+        if (this.orbit == null) {
+            this.orbit = new CameraOrbit(new CameraOrbit.Settings(0, 0, 0, POLAR, POLAR,
+                    -CameraPose.PI, CameraPose.PI, false, false),
+                    new CameraOrbit.State(RADIUS, target.yaw(), POLAR, 0, 0, 0), target);
+            this.avoidance = new CameraAvoidance(CameraAvoidance.Settings.boom(), new CameraAvoidance.State(RADIUS, 0));
+        }
+        this.orbit.target(target);
+        this.orbit.input(0, 0);
+        final var requested = this.orbit.advance(delta, eye, eye, Float.MAX_VALUE);
+        final var position = this.avoidance.advance(delta, eye, requested, RADIUS, .025F,
+                world.insideSolidBlock(eye), null, world);
+        return CameraPose.fromDegrees(position, 30F, yaw, fov, CameraPositionState.Mode.THIRD_PERSON.ordinal());
+    }
+
+    void clear() {
+        this.active = false;
+        this.ticks = 0;
+        this.orbit = null;
+        this.avoidance = null;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockPlayerFov.java b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockPlayerFov.java
