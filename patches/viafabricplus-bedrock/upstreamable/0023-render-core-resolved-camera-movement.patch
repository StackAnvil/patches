diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinBedrockCameraFov.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinBedrockCameraFov.java
new file mode 100644
index 0000000..e09bea0
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/render/MixinBedrockCameraFov.java
@@ -0,0 +1,85 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.ModifyReturnValue;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockItemMetadata;
+import com.viaversion.viafabricplus.bedrock.camera.BedrockCameraFov;
+import com.viaversion.viafabricplus.bedrock.camera.BedrockCameraPosition;
+import com.viaversion.viafabricplus.bedrock.camera.BedrockPlayerFov;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.input.BedrockMovementEffects;
+import net.minecraft.client.Camera;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.player.AbstractClientPlayer;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.effect.MobEffects;
+import net.minecraft.world.entity.ai.attributes.Attributes;
+import net.minecraft.world.item.Items;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(Camera.class)
+public abstract class MixinBedrockCameraFov {
+    @Shadow private float fov;
+    @Shadow private boolean isPanoramicMode;
+
+    @Inject(method = "tick", at = @At("HEAD"))
+    private void advanceNativeDeathCounter(final CallbackInfo ci) {
+        if ((Object) this == Minecraft.getInstance().gameRenderer.mainCamera()) BedrockCameraPosition.tickDeath();
+    }
+
+    @WrapOperation(method = "calculateFov", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/Camera;modifyFovBasedOnDeathOrFluid(FF)F"))
+    private float nativeDeathProjection(final Camera camera, final float partialTick, final float fov,
+                                         final Operation<Float> original) {
+        if (camera != Minecraft.getInstance().gameRenderer.mainCamera() || !BedrockCameraPosition.defaultDeathActive())
+            return original.call(camera, partialTick, fov);
+        final var options = Minecraft.getInstance().options;
+        return BedrockCameraPosition.deathFieldOfView(partialTick, fov,
+                options.fovEffectScale().get().floatValue());
+    }
+
+    @WrapOperation(method = "tickFov", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/player/AbstractClientPlayer;getFieldOfViewModifier(ZF)F"))
+    private float nativePlayerModifier(final AbstractClientPlayer player, final boolean firstPerson,
+                                       final float effectScale, final Operation<Float> original) {
+        if (!BedrockInputPermissions.isBedrockConnection()) return original.call(player, firstPerson, effectScale);
+        final var slowness = player.getEffect(MobEffects.SLOWNESS);
+        final var item = player.getUseItem();
+        final String identifier = BedrockItemMetadata.get(item.get(DataComponents.CUSTOM_DATA)).identifier();
+        final boolean bow = player.isUsingItem() && (identifier == null ? item.is(Items.BOW) : "minecraft:bow".equals(identifier));
+        final boolean scoping = player.isUsingItem() && firstPerson && player.isScoping();
+        final float modifier = BedrockPlayerFov.modifier(effectScale > 0, player.getAbilities().flying,
+                (float) player.getAttributeValue(Attributes.MOVEMENT_SPEED), player.getAbilities().getWalkingSpeed(),
+                slowness == null ? -1 : slowness.getAmplifier(),
+                BedrockMovementEffects.swimSpeedMultiplier(player.getId(), player.isSwimming()),
+                bow, player.getTicksUsingItem(), scoping);
+        // Bedrock has a boolean preference. Retain Java's additional fractional accessibility setting,
+        // but use the exact native result at full scale and for the independent scope override.
+        return scoping || effectScale == 1F ? modifier : 1F + effectScale * (modifier - 1F);
+    }
+
+    @WrapOperation(method = "tickFov", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/util/Mth;clamp(FFF)F"))
+    private float retainNativeModifierHistory(final float value, final float minimum, final float maximum,
+                                              final Operation<Float> original) {
+        return BedrockInputPermissions.isBedrockConnection() ? value : original.call(value, minimum, maximum);
+    }
+
+    @ModifyReturnValue(method = "calculateFov", at = @At("RETURN"))
+    private float serverProjection(final float normal) {
+        if ((Object) this != Minecraft.getInstance().gameRenderer.mainCamera()) return normal;
+        final float local = BedrockInputPermissions.isBedrockConnection() && !this.isPanoramicMode
+                ? Math.clamp(normal, 5F, 130F) : normal;
+        return BedrockCameraFov.project(local, this.fov);
+    }
+}
