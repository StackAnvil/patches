+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.raphimc.viabedrock.api.model.CameraFovState;
+import net.raphimc.viabedrock.api.model.CameraFovState.Value;
+import net.raphimc.viabedrock.api.model.CameraFovTimeline;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+
+/** Supplies local projection inputs to the shared native transition rules. */
+public final class BedrockCameraFov {
+    private static final CameraFovTimeline TIMELINE = new CameraFovTimeline();
+    private static final Deque<Pending> PENDING = new ArrayDeque<>();
+    private static long acceptedSequence = -1;
+    private static long appliedSequence = -1;
+    private static long previousFrame;
+
+    private BedrockCameraFov() { }
+
+    public static void accept(final CameraFovState state) {
+        if (state.sequence() <= acceptedSequence) return;
+        acceptedSequence = state.sequence();
+        PENDING.addLast(new Pending(state, System.nanoTime()));
+    }
+
+    public static CameraFovState.Transition current() { return TIMELINE.state(); }
+
+    public static void clear() {
+        TIMELINE.restore(CameraFovState.Transition.EMPTY);
+        PENDING.clear();
+        acceptedSequence = -1;
+        appliedSequence = -1;
+        previousFrame = 0;
+    }
+
+    public static float project(final float normalDegrees, final float renderedDegrees) {
+        final long now = System.nanoTime();
+        final float delta = previousFrame == 0 ? 0 : Math.max(0, (now - previousFrame) / 1_000_000_000F);
+        previousFrame = now;
+        final Value normal = Value.constant(normalDegrees * CameraFovState.DEGREES_TO_RADIANS);
+        final Value rendered = Float.isFinite(renderedDegrees) && renderedDegrees > 0
+                ? Value.constant(renderedDegrees * CameraFovState.DEGREES_TO_RADIANS) : normal;
+        boolean restored = false;
+        Value projection = null;
+        while (!PENDING.isEmpty()) {
+            final Pending pending = PENDING.removeFirst();
+            final CameraFovState snapshot = pending.state;
+            if (snapshot.command() != null && snapshot.sequence() == appliedSequence + 1) {
+                TIMELINE.apply(snapshot.command(), rendered, normal);
+                restored = false;
+            } else {
+                TIMELINE.restore(snapshot.transition().resolveLocal(normal.radians()));
+                projection = TIMELINE.advance(snapshot.elapsed() + Math.max(0, (now - pending.receivedAt) / 1_000_000_000F));
+                restored = true;
+            }
+            appliedSequence = snapshot.sequence();
+        }
+        if (!restored) projection = TIMELINE.advance(delta);
+        return projection == null ? normalDegrees : projection.radians() / CameraFovState.DEGREES_TO_RADIANS;
+    }
+
+    private record Pending(CameraFovState state, long receivedAt) { }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockCameraPosition.java b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockCameraPosition.java
new file mode 100644
index 0000000..cec3cf2
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/camera/BedrockCameraPosition.java
@@ -0,0 +1,224 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.minecraft.client.CameraType;
+import net.minecraft.client.player.LocalPlayer;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import net.raphimc.viabedrock.api.model.CameraTrackingState;
+import net.raphimc.viabedrock.api.model.CameraSplineState;
+import net.raphimc.viabedrock.api.model.CameraFollowState;
+import net.raphimc.viabedrock.api.model.CameraFollowRuntime;
+import net.raphimc.viabedrock.api.model.CameraTrackingRuntime;
+import net.raphimc.viabedrock.api.model.CameraTargetTracker;
+import net.raphimc.viabedrock.api.model.NativeActorBoundsMessage;
+import net.minecraft.client.Minecraft;
+import net.raphimc.viabedrock.api.model.CameraAudioListener;
+import net.raphimc.viabedrock.api.model.CameraPose;
+import net.raphimc.viabedrock.api.model.CameraPoseTimeline;
+import net.raphimc.viabedrock.api.model.CameraPositionState;
+import net.raphimc.viabedrock.api.model.CameraPositionState.Mode;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+
+/** Supplies rendered frame inputs to core's command and blend rules. */
+public final class BedrockCameraPosition {
+    private static final CameraFollowRuntime FOLLOW = new CameraFollowRuntime();
+    private static final CameraTrackingRuntime TRACKING = new CameraTrackingRuntime();
+    private static final CameraPoseTimeline TIMELINE = new CameraPoseTimeline();
+    private static final BedrockDeathCamera DEATH = new BedrockDeathCamera();
+    private static LocalPlayer deathSubject;
+    private static final Deque<CameraPositionState> PENDING = new ArrayDeque<>();
+    private static CameraPositionState state = CameraPositionState.EMPTY;
+    private static CameraPose rendered;
+    private static long acceptedSequence = -1;
+    private static long appliedSequence = -1;
+    private static long previousFrame;
+    private static boolean preparingTarget;
+    private static float partialTick;
+
+    private BedrockCameraPosition() { }
+
+    public static void accept(final CameraPositionState snapshot) {
+        if (snapshot.sequence() <= acceptedSequence) return;
+        acceptedSequence = snapshot.sequence();
+        PENDING.addLast(snapshot);
+    }
+
+    public static void accept(final CameraTrackingState snapshot) {
+        TRACKING.accept(snapshot);
+    }
+
+    public static void accept(final CameraSplineState snapshot) {
+        TRACKING.accept(snapshot);
+    }
+
+    public static void accept(final CameraFollowState snapshot) {
+        FOLLOW.accept(snapshot);
+    }
+
+    public static void turn(final float pitchDelta, final float yawDelta) {
+        final var requested = PENDING.isEmpty() ? state : PENDING.getLast();
+        if (requested.mode() == Mode.BOOM && Float.isFinite(pitchDelta) && Float.isFinite(yawDelta)) {
+            FOLLOW.input(requested.sequence(), pitchDelta, yawDelta);
+        }
+    }
+
+    public static void clear() {
+        DEATH.clear();
+        deathSubject = null;
+        FOLLOW.clear();
+        TRACKING.clear();
+        PENDING.clear();
+        state = CameraPositionState.EMPTY;
+        rendered = null;
+        acceptedSequence = appliedSequence = -1;
+        previousFrame = 0;
+        preparingTarget = false;
+        partialTick = 0;
+    }
+
+    public static void beginFrame(final float tick) {
+        partialTick = tick;
+        preparingTarget = true;
+    }
+
+    public static void tickDeath() {
+        final var client = Minecraft.getInstance();
+        final var player = client.player;
+        if (!BedrockInputPermissions.isBedrockConnection() || player == null || client.getCameraEntity() != player) {
+            DEATH.clear();
+            deathSubject = null;
+            return;
+        }
+        if (deathSubject != player) {
+            DEATH.clear();
+            deathSubject = player;
+        }
+        // Java stops ticking its dead local actor. The native death counter continues on camera ticks.
+        DEATH.tick(player.getHealth() <= 0, player.deathTime);
+    }
+
+    public static boolean defaultDeathActive() {
+        final var requested = PENDING.isEmpty() ? state : PENDING.getLast();
+        return DEATH.active() && requested.mode() == Mode.LOCAL;
+    }
+
+    public static float deathFieldOfView(final float partialTick, final float normalFov, final float effectScale) {
+        return DEATH.projection(normalFov, effectScale, partialTick);
+    }
+
+    public static CameraAudioListener playerListener() {
+        final var player = Minecraft.getInstance().player;
+        if (state.mode() == Mode.LOCAL || !state.playerAudio() || player == null) return null;
+        final var position = player.getEyePosition(partialTick);
+        return CameraAudioListener.player(new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z),
+                player.getXRot(), player.getYRot());
+    }
+
+    public static CameraType perspective(final CameraType local) {
+        if (!preparingTarget && defaultDeathActive()) return CameraType.THIRD_PERSON_BACK;
+        final Mode mode;
+        if (preparingTarget) {
+            final CameraPositionState requested = PENDING.isEmpty() ? state : PENDING.getLast();
+            // Detached targets have their own poses. Normal alignment supplies the local blend input.
+            mode = requested.mode() == Mode.FREE || requested.mode() == Mode.BOOM ? Mode.LOCAL : requested.mode();
+        } else {
+            mode = state.mode() == Mode.LOCAL || rendered == null ? Mode.LOCAL : Mode.values()[rendered.renderingMode()];
+        }
+        return switch (mode) {
+            case LOCAL -> local;
+            case FIRST_PERSON -> CameraType.FIRST_PERSON;
+            case THIRD_PERSON, FREE, BOOM -> CameraType.THIRD_PERSON_BACK;
+            case THIRD_PERSON_FRONT -> CameraType.THIRD_PERSON_FRONT;
+        };
+    }
+
+    public static CameraPose frame(final CameraPose normal) {
+        preparingTarget = false;
+        final long now = System.nanoTime();
+        final float delta = previousFrame == 0 ? 0 : Math.max(0, (now - previousFrame) / 1_000_000_000F);
+        previousFrame = now;
+        final var player = Minecraft.getInstance().player;
+        final CameraPose local;
+        if (DEATH.active() && player != null) {
+            final var eye = player.getEyePosition(partialTick);
+            local = DEATH.pose(new CameraPose.Vector((float) eye.x, (float) eye.y, (float) eye.z),
+                    player.getYRot(partialTick), normal.fov(), delta, new BedrockCameraWorld(Minecraft.getInstance().level));
+        } else {
+            local = normal;
+        }
+        boolean changed = false;
+        while (!PENDING.isEmpty()) {
+            final CameraPositionState snapshot = PENDING.removeFirst();
+            state = snapshot;
+            if (snapshot.mode() == Mode.LOCAL) {
+                // Clear resets the next blend even when both commands arrive before this frame.
+                rendered = local;
+            } else {
+                // A snapshot lacks the old client's interrupted frame. Restore its settled target,
+                // rather than replaying an expired or newly negotiated cutscene from a guessed pose.
+                final boolean continuous = snapshot.live() && snapshot.sequence() == appliedSequence + 1;
+                TIMELINE.begin(rendered != null ? rendered : local, continuous ? snapshot.duration() : 0, snapshot.ease());
+            }
+            appliedSequence = snapshot.sequence();
+            changed = true;
+        }
+        TRACKING.advance(delta, BedrockCameraPosition::targetActor);
+        FOLLOW.advance(delta, localFollowActor(), BedrockCameraPosition::followActor, new BedrockCameraWorld(Minecraft.getInstance().level));
+        if (state.mode() == Mode.LOCAL) {
+            rendered = local;
+            return local != normal ? local : null;
+        }
+        final CameraPose tracked = TRACKING.active(state.sequence(), normal.fov(), Mode.FREE.ordinal());
+        final CameraPose follow = FOLLOW.active(state.sequence(), normal.fov(), Mode.BOOM.ordinal());
+        final CameraPose target = switch (state.mode()) {
+            case BOOM -> follow != null ? follow : rendered != null ? rendered : normal;
+            case FREE -> tracked != null ? tracked : CameraPose.fromDegrees(state.position(), state.pitch(), state.yaw(), normal.fov(), Mode.FREE.ordinal());
+            default -> new CameraPose(normal.position(), normal.orientation(), normal.fov(), state.mode().ordinal());
+        };
+        rendered = TIMELINE.advance(changed ? 0 : delta, target, null);
+        return rendered;
+    }
+
+    private static CameraTrackingRuntime.Actor targetActor(final long uniqueId) {
+        final var actor = followActor(uniqueId);
+        return actor == null || actor.sample() == null ? null
+                : new CameraTrackingRuntime.Actor(actor.lifetime(), new CameraTargetTracker.Sample(actor.sample().center(), actor.sample().yaw()));
+    }
+
+    private static CameraFollowRuntime.Actor localFollowActor() {
+        final var player = Minecraft.getInstance().player;
+        if (player == null) return null;
+        final var snapshot = BedrockActorState.state(player.getUUID());
+        if (snapshot == null) return null;
+        final var position = player.getPosition(partialTick);
+        final var origin = new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z);
+        return new CameraFollowRuntime.Actor(snapshot.lifetime(), new CameraFollowRuntime.Sample(origin, origin, player.getYRot(partialTick)));
+    }
+
+    private static CameraFollowRuntime.Actor followActor(final long uniqueId) {
+        final var level = Minecraft.getInstance().level;
+        final var uuid = BedrockActorState.uuidByUniqueId(uniqueId);
+        if (level == null || uuid == null) return null;
+        final var snapshot = BedrockActorState.state(uuid);
+        if (snapshot == null) return null;
+        final var entity = level.getEntity(uuid);
+        final var bounds = BedrockActorState.bounds(uuid);
+        if (entity == null || entity.isRemoved() || bounds == null || !bounds.lifetime().equals(snapshot.lifetime()) || bounds.height() == null)
+            return new CameraFollowRuntime.Actor(snapshot.lifetime(), null);
+        if (!Float.isFinite(bounds.height()) || bounds.height() < 0 || !Float.isFinite(snapshot.scale()) || snapshot.scale() < 0
+                || !Float.isFinite(bounds.height() * snapshot.scale()) || bounds.height() * snapshot.scale() >= 1E9F)
+            return new CameraFollowRuntime.Actor(snapshot.lifetime(), null);
+        final float height = NativeActorBoundsMessage.scaledDimension(bounds.height(), snapshot.scale());
+        final var position = entity.getPosition(partialTick);
+        return new CameraFollowRuntime.Actor(snapshot.lifetime(), new CameraFollowRuntime.Sample(
+                new CameraPose.Vector((float) position.x, (float) position.y, (float) position.z),
+                new CameraPose.Vector((float) position.x, (float) position.y + height * .5F, (float) position.z), entity.getYRot(partialTick)));
+    }
+}
