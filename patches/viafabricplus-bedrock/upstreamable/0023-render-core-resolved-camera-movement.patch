+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.camera;
+
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.raphimc.viabedrock.api.model.CameraFadeState;
+
+public final class BedrockCameraFade {
+    private static CameraFadeState state = CameraFadeState.EMPTY;
+    private static long receivedAt;
+
+    private BedrockCameraFade() { }
+
+    public static void accept(final CameraFadeState snapshot) {
+        state = snapshot;
+        receivedAt = System.nanoTime();
+    }
+
+    public static CameraFadeState current() { return state; }
+
+    public static void clear() {
+        state = CameraFadeState.EMPTY;
+        receivedAt = 0;
+    }
+
+    public static void extract(final GuiGraphicsExtractor graphics) {
+        if (state.points().isEmpty()) return;
+        final float elapsed = state.elapsed() + Math.max(0, (System.nanoTime() - receivedAt) / 1_000_000_000F);
+        final float alpha = state.alpha(elapsed);
+        if (alpha <= 0) return;
+        final int color = channel(alpha) << 24 | channel(state.red()) << 16 | channel(state.green()) << 8 | channel(state.blue());
+        graphics.fill(0, 0, graphics.guiWidth(), graphics.guiHeight(), color);
+        graphics.nextStratum();
+    }
+
+    private static int channel(final float value) { return Math.round(Math.clamp(value, 0, 1) * 255); }
+}
