+    static Geometry personaGeometry(final String name, final String geometryData,
+                                    final List<SkinData.AnimationData> animations, final String animationData) {
+        if (geometryData == null || geometryData.isBlank() || !animations.isEmpty()
+            || animationData != null && !animationData.isBlank() && !"null".equalsIgnoreCase(animationData)
+            && !"{}".equals(animationData.strip())) {
+            return null;
+        }
+        try {
+            final JsonObject data = JsonParser.parseString(geometryData).getAsJsonObject();
+            final JsonArray models = data.getAsJsonArray("minecraft:geometry");
+            if (models == null || models.size() != 1) {
+                return null;
+            }
+            final JsonObject model = models.get(0).getAsJsonObject().deepCopy();
+            if (!name.equals(model.getAsJsonObject("description").get("identifier").getAsString())) {
+                return null;
+            }
+            final Map<String, JsonObject> meshes = new HashMap<>();
+            final Map<String, Boolean> surfaces = new HashMap<>();
+            for (var entry : model.getAsJsonArray("bones")) {
+                final JsonObject bone = entry.getAsJsonObject();
+                final String boneName = bone.get("name").getAsString();
+                if (!bone.has("pivot")) {
+                    bone.add("pivot", zeroVector());
+                }
+                if (!bone.has("rotation")) {
+                    bone.add("rotation", zeroVector());
+                }
+                if (bone.has("poly_mesh")) {
+                    meshes.put(boneName, bone.getAsJsonObject("poly_mesh"));
+                }
+                if (bone.has("cubes")) {
+                    for (var cubeEntry : bone.getAsJsonArray("cubes")) {
+                        final JsonObject cube = cubeEntry.getAsJsonObject();
+                        if (!cube.has("pivot")) {
+                            cube.add("pivot", bone.getAsJsonArray("pivot").deepCopy());
+                        }
+                        if (!cube.has("rotation")) {
+                            cube.add("rotation", zeroVector());
+                        }
+                    }
+                }
+                surfaces.put(boneName.toLowerCase(Locale.ROOT).replace("_", ""),
+                    bone.has("poly_mesh") || bone.has("cubes") && !bone.getAsJsonArray("cubes").isEmpty());
+            }
+            for (String part : List.of("head", "body", "rightarm", "leftarm", "rightleg", "leftleg")) {
+                if (!surfaces.getOrDefault(part, false)) {
+                    return null;
+                }
+            }
+            final JsonObject normalized = new JsonObject();
+            final JsonArray selected = new JsonArray();
+            selected.add(model);
+            normalized.add("minecraft:geometry", selected);
+            final BedrockGeometryModel parsed = BedrockGeometryModel.fromJson(normalized).getFirst();
+            // Parse the polygons now so a malformed skin never installs a blank renderer.
+            BedrockGeometry.playerModel(parsed, false, meshes);
+            return new Geometry(parsed, Map.copyOf(meshes));
+        } catch (RuntimeException e) {
+            ViaFabricPlusBedrock.impl().logger().warn("Failed to parse Bedrock persona geometry", e);
+            return null;
+        }
+    }
+
+    private static JsonArray zeroVector() {
+        final JsonArray vector = new JsonArray();
+        vector.add(0);
+        vector.add(0);
+        vector.add(0);
+        return vector;
+    }
+
+    record Geometry(BedrockGeometryModel model, Map<String, JsonObject> meshes) {
+    }
+
