+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.net.InetSocketAddress;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import net.raphimc.viabedrock.netty.nethernet.BedrockHttpSignaling;
+
+/** The server status that an HTTP NetherNet server reports from its capability endpoint. */
+public record NetherNetServerStatus(String name, String version, int protocol, int players, int maxPlayers) {
+
+    private static final Duration TIMEOUT = Duration.ofSeconds(5);
+
+    /**
+     * Blocks for at most a few seconds. Throws when the server does not answer with a valid status.
+     * The request tries HTTPS before plaintext like a join, because public servers answer only over TLS.
+     */
+    public static NetherNetServerStatus query(final String host, final int port) throws IOException, InterruptedException {
+        final CompletableFuture<HttpResponse<String>> request =
+            BedrockHttpSignaling.requestJoinInfo(InetSocketAddress.createUnresolved(host, port));
+        final HttpResponse<String> response;
+        try {
+            response = request.get(TIMEOUT.toMillis(), TimeUnit.MILLISECONDS);
+        } catch (final ExecutionException exception) {
+            throw new IOException("NetherNet status request failed", exception.getCause());
+        } catch (final TimeoutException exception) {
+            request.cancel(true);
+            throw new IOException("NetherNet status request timed out", exception);
+        } catch (final InterruptedException exception) {
+            request.cancel(true);
+            throw exception;
+        }
+        if (response.statusCode() / 100 != 2) {
+            throw new IOException("NetherNet status request failed with HTTP " + response.statusCode());
+        }
+        try {
+            final JsonObject info = JsonParser.parseString(response.body()).getAsJsonObject();
+            return new NetherNetServerStatus(info.get("name").getAsString(), info.get("version").getAsString(),
+                info.get("protocol").getAsInt(), info.get("players").getAsInt(), info.get("maxPlayers").getAsInt());
+        } catch (RuntimeException exception) {
+            throw new IOException("Invalid NetherNet status response", exception);
+        }
+    }
+
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetServerStatusTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetServerStatusTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1eac07115998d32681590aeb817de4d34f99c132
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetServerStatusTest.java
@@ -0,0 +1,59 @@
+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.sun.net.httpserver.HttpServer;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.nio.charset.StandardCharsets;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class NetherNetServerStatusTest {
+    @Test
+    void readsTheStatusThatTheCapabilityEndpointReports() throws Exception {
+        final HttpServer server = statusServer(200, """
+                {"name":"Nythera Playground","version":"1.26.65","protocol":975,"players":3,"maxPlayers":20}""");
+        try {
+            assertEquals(new NetherNetServerStatus("Nythera Playground", "1.26.65", 975, 3, 20),
+                NetherNetServerStatus.query("127.0.0.1", server.getAddress().getPort()));
+        } finally {
+            server.stop(0);
+        }
+    }
+
+    @Test
+    void failsForAServerThatRejectsTheRequestOrAnswersWithoutAStatus() throws IOException {
+        for (final HttpServer server : new HttpServer[]{statusServer(404, "{}"), statusServer(200, "<html></html>")}) {
+            try {
+                assertThrows(IOException.class, () -> NetherNetServerStatus.query("127.0.0.1", server.getAddress().getPort()));
+            } finally {
+                server.stop(0);
+            }
+        }
+    }
+
+    @Test
+    void failsForAnAddressWithoutAServer() throws IOException {
+        final int port;
+        try (ServerSocket socket = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+            port = socket.getLocalPort();
+        }
+        assertThrows(IOException.class, () -> NetherNetServerStatus.query("127.0.0.1", port));
+    }
+
+    private static HttpServer statusServer(final int status, final String body) throws IOException {
+        final HttpServer server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
+        server.createContext("/", exchange -> {
+            final byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+            exchange.sendResponseHeaders(exchange.getRequestURI().getPath().equals("/v1/join") ? status : 404, bytes.length);
+            exchange.getResponseBody().write(bytes);
+            exchange.close();
+        });
+        server.start();
+        return server;
+    }
+}
