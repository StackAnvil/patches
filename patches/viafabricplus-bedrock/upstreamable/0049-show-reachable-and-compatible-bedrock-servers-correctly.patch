diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetServerStatus.java b/src/main/java/com/viaversion/viafabricplus/bedrock/protocoltranslator/network/NetherNetServerStatus.java
