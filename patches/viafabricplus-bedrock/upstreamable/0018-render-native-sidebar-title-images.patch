@@ -0,0 +1,110 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.hud;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.chat.Component;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.network.chat.numbers.StyledFormat;
+import net.minecraft.world.scores.Objective;
+import net.minecraft.world.scores.PlayerScoreEntry;
+import net.minecraft.world.scores.PlayerTeam;
+
+import java.util.Comparator;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class BedrockScoreboardRenderer {
+    private BedrockScoreboardRenderer() {
+    }
+
+    public static boolean render(final Minecraft minecraft, final GuiGraphicsExtractor graphics, final Font font,
+                                 final Objective objective, final Comparator<PlayerScoreEntry> order) {
+        if (!BedrockRenderingMetadata.active()) return false;
+        final var image = BedrockScoreboardImages.image(objective.getDisplayName());
+        if (image == null) return false;
+        final var scoreboard = objective.getScoreboard();
+        final var format = objective.numberFormatOrDefault(StyledFormat.SIDEBAR_DEFAULT);
+        final var entries = scoreboard.listPlayerScores(objective).stream().filter(entry -> !entry.isHidden()).sorted(order).limit(15)
+            .map(entry -> new Entry(PlayerTeam.formatNameForTeam(scoreboard.getPlayersTeam(entry.owner()), entry.ownerName()), entry.formatValue(format)))
+            .toList();
+        int width = image.width() + Math.abs(image.offsetX()) * 2;
+        final int separator = font.width(": ");
+        for (final var entry : entries) {
+            final int scoreWidth = font.width(entry.score);
+            width = Math.max(width, font.width(entry.name) + (scoreWidth == 0 ? 0 : separator + scoreWidth));
+        }
+        if (image.background() != null) width += Math.abs(image.background().rowOffsetX());
+        final Layout layout = layout(graphics.guiWidth(), graphics.guiHeight(), width, entries.size(), image);
+        if (image.background() == null) {
+            graphics.fill(layout.left - 2, layout.headerTop - 1, layout.right, layout.rowTop - 1, minecraft.options.getBackgroundColor(.4F));
+            graphics.fill(layout.left - 2, layout.rowTop - 1, layout.right, layout.bottom, minecraft.options.getBackgroundColor(.3F));
+        } else {
+            final var background = image.background();
+            final int color = Math.round(background.alpha() * 255F) << 24 | 0xFFFFFF;
+            for (final var quad : slices(layout, background)) {
+                graphics.blit(RenderPipelines.GUI_TEXTURED, background.texture(), quad.left, quad.top, quad.u, quad.v,
+                    quad.right - quad.left, quad.bottom - quad.top, quad.sourceWidth, quad.sourceHeight,
+                    background.baseWidth(), background.baseHeight(), color);
+            }
+        }
+        graphics.blit(image.texture(), layout.imageX, layout.imageY, layout.imageX + image.width(), layout.imageY + image.height(), 0, 1, 0, 1);
+        for (int i = 0; i < entries.size(); i++) {
+            final var entry = entries.get(i);
+            final int y = layout.rowTop + i * image.rowHeight();
+            graphics.text(font, entry.name, layout.rowX, y, -1, false);
+            graphics.text(font, entry.score, layout.right - font.width(entry.score), y, -1, false);
+        }
+        return true;
+    }
+
+    static Layout layout(final int guiWidth, final int guiHeight, final int width, final int rows, final BedrockScoreboardImages.Image image) {
+        final int headerHeight = Math.max(9, image.height() + image.offsetY()) - Math.min(0, image.offsetY());
+        final var background = image.background();
+        final int paddingX = background == null ? 0 : background.paddingX();
+        final int paddingY = background == null ? 0 : background.paddingY();
+        final int backgroundTop = (guiHeight - headerHeight - rows * image.rowHeight() - paddingY) / 2;
+        final int headerTop = backgroundTop + paddingY / 2;
+        final int rowTop = headerTop + headerHeight + (background == null ? 0 : background.rowOffsetY());
+        final int bottom = headerTop + headerHeight + rows * image.rowHeight();
+        final int origin = headerTop - Math.min(0, image.offsetY());
+        final int left = guiWidth - width - 3;
+        return new Layout(left, guiWidth - 1, headerTop, rowTop, bottom,
+            left + (width - image.width()) / 2 + image.offsetX(), origin + image.offsetY(),
+            left + (background == null ? 0 : background.rowOffsetX()), left - paddingX / 2, backgroundTop,
+            left + width + paddingX - paddingX / 2, bottom + paddingY - paddingY / 2);
+    }
+
+    static List<Quad> slices(final Layout layout, final BedrockScoreboardImages.Background background) {
+        final int borderX = Math.min(background.slice(), (layout.backgroundRight - layout.backgroundLeft) / 2);
+        final int borderY = Math.min(background.slice(), (layout.backgroundBottom - layout.backgroundTop) / 2);
+        final int[] x = {layout.backgroundLeft, layout.backgroundLeft + borderX, layout.backgroundRight - borderX, layout.backgroundRight};
+        final int[] y = {layout.backgroundTop, layout.backgroundTop + borderY, layout.backgroundBottom - borderY, layout.backgroundBottom};
+        final int[] u = {0, background.slice(), background.baseWidth() - background.slice(), background.baseWidth()};
+        final int[] v = {0, background.slice(), background.baseHeight() - background.slice(), background.baseHeight()};
+        final List<Quad> quads = new ArrayList<>(9);
+        for (int row = 0; row < 3; row++) {
+            for (int column = 0; column < 3; column++) {
+                if (x[column] == x[column + 1] || y[row] == y[row + 1]) continue;
+                quads.add(new Quad(x[column], y[row], x[column + 1], y[row + 1],
+                    u[column], v[row], u[column + 1] - u[column], v[row + 1] - v[row]));
+            }
+        }
+        return List.copyOf(quads);
+    }
+
+    record Quad(int left, int top, int right, int bottom, int u, int v, int sourceWidth, int sourceHeight) {
+    }
+
+    private record Entry(Component name, Component score) {
+    }
+
+    record Layout(int left, int right, int headerTop, int rowTop, int bottom, int imageX, int imageY, int rowX, int backgroundLeft, int backgroundTop, int backgroundRight, int backgroundBottom) {
+    }
+}
