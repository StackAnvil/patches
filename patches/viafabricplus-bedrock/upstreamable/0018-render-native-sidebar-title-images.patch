diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/hud/BedrockScoreboardImagesTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/hud/BedrockScoreboardImagesTest.java
new file mode 100644
index 0000000..b1872d5
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/hud/BedrockScoreboardImagesTest.java
@@ -0,0 +1,155 @@
+package com.viaversion.viafabricplus.bedrock.render.hud;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.FontDescription;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockScoreboardImagesTest {
+    private static final Identifier FONT = Identifier.parse("viabedrock:scoreboard/" + "a".repeat(64));
+    private static final Identifier TEXTURE = Identifier.parse("viabedrock:textures/scoreboard/" + "a".repeat(64) + ".png");
+
+    @AfterEach
+    void clear() {
+        BedrockScoreboardImages.clear();
+    }
+
+    @Test
+    void onlyAnAcceptedServerPackAndExactDedicatedTitleActivateImages() {
+        final var listener = new BedrockScoreboardImages();
+        final var local = resources(PackSource.DEFAULT, true);
+        listener.apply(listener.prepare(local, null), local, null);
+        assertNull(BedrockScoreboardImages.image(title()));
+        final var accepted = resources(PackSource.SERVER, true);
+        listener.apply(listener.prepare(accepted, null), accepted, null);
+        assertNotNull(BedrockScoreboardImages.image(title()));
+        assertNull(BedrockScoreboardImages.image(Component.literal("ordinary")));
+        assertNull(BedrockScoreboardImages.image(title().append("extra")));
+        assertNull(BedrockScoreboardImages.image(Component.literal("other").withStyle(style -> style.withFont(new FontDescription.Resource(FONT)))));
+    }
+
+    @Test
+    void missingServerImageOrFontResourcesNeverActivateMetadata() {
+        final var listener = new BedrockScoreboardImages();
+        final var incomplete = resources(PackSource.SERVER, false);
+        listener.apply(listener.prepare(incomplete, null), incomplete, null);
+        assertNull(BedrockScoreboardImages.image(title()));
+    }
+
+    @Test
+    void removedPackAndStaleReloadCompletionCannotReactivateImages() {
+        final var listener = new BedrockScoreboardImages();
+        final var accepted = resources(PackSource.SERVER, true);
+        final var pending = listener.prepare(accepted, null);
+        BedrockScoreboardImages.clear();
+        listener.apply(pending, accepted, null);
+        assertNull(BedrockScoreboardImages.image(title()));
+        listener.apply(listener.prepare(accepted, null), accepted, null);
+        assertNotNull(BedrockScoreboardImages.image(title()));
+        final var older = listener.prepare(accepted, null);
+        final var removed = resources();
+        listener.apply(listener.prepare(removed, null), removed, null);
+        listener.apply(older, accepted, null);
+        assertNull(BedrockScoreboardImages.image(title()));
+    }
+
+    @Test
+    void invalidProtocolDimensionsAndConflictingFontsAreRejected() {
+        final JsonObject metadata = metadata();
+        assertThrows(UnsupportedOperationException.class, () -> BedrockScoreboardImages.parse(metadata).clear());
+        metadata.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION + .5);
+        assertThrows(ArithmeticException.class, () -> BedrockScoreboardImages.parse(metadata));
+        metadata.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        final JsonObject image = metadata.getAsJsonArray("images").get(0).getAsJsonObject();
+        image.addProperty("height", 0);
+        assertThrows(IllegalArgumentException.class, () -> BedrockScoreboardImages.parse(metadata));
+        image.addProperty("height", 21);
+        metadata.getAsJsonArray("images").add(image.deepCopy());
+        assertThrows(IllegalArgumentException.class, () -> BedrockScoreboardImages.parse(metadata));
+    }
+
+    @Test
+    void authoredHeaderAndRowsDoNotOverlapAtDifferentViewportSizes() {
+        final var image = BedrockScoreboardImages.parse(metadata()).get(FONT);
+        for (int width : new int[]{320, 640, 1280}) {
+            for (int rows : new int[]{0, 1, 9, 15}) {
+                final var layout = BedrockScoreboardRenderer.layout(width, 347, 100, rows, image);
+                assertEquals(21, layout.rowTop() - layout.headerTop());
+                assertTrue(Math.abs((layout.headerTop() + layout.bottom()) / 2 - 347 / 2) <= 1);
+                assertEquals(rows * 10, layout.bottom() - layout.rowTop());
+                assertEquals(layout.headerTop(), layout.imageY());
+                assertEquals(layout.left() + 17, layout.imageX());
+                assertTrue(layout.imageY() + image.height() <= layout.rowTop());
+            }
+        }
+    }
+
+    @Test
+    void positiveAndNegativeImageOffsetsRemainInsideTheHeaderBudget() {
+        for (int y : new int[]{-20, -1, 0, 1, 20}) {
+            final var image = new BedrockScoreboardImages.Image(FONT, TEXTURE, 66, 21, 4, y, 10);
+            final var layout = BedrockScoreboardRenderer.layout(640, 347, 100, 8, image);
+            assertTrue(layout.imageY() >= layout.headerTop());
+            assertTrue(layout.imageY() + image.height() <= layout.rowTop());
+        }
+    }
+
+    private static net.minecraft.network.chat.MutableComponent title() {
+        return Component.literal(Character.toString(0xE000)).withStyle(style -> style.withFont(new FontDescription.Resource(FONT)));
+    }
+
+    private static JsonObject metadata() {
+        final JsonObject metadata = new JsonObject();
+        metadata.addProperty("format", 1);
+        metadata.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        final JsonObject image = new JsonObject();
+        image.addProperty("font", FONT.toString());
+        image.addProperty("texture", TEXTURE.toString());
+        image.addProperty("width", 66);
+        image.addProperty("height", 21);
+        image.addProperty("row_height", 10);
+        image.addProperty("offset_x", 0);
+        image.addProperty("offset_y", 0);
+        final JsonArray images = new JsonArray();
+        images.add(image);
+        metadata.add("images", images);
+        return metadata;
+    }
+
+    private static ResourceManager resources(final PackSource source, final boolean complete) {
+        final PackLocationInfo location = new PackLocationInfo("fixture", Component.empty(), source, Optional.empty());
+        final PackResources pack = (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class<?>[]{PackResources.class},
+            (proxy, method, args) -> method.getName().equals("location") ? location : null);
+        final Resource metadata = new Resource(pack, () -> new ByteArrayInputStream(metadata().toString().getBytes(StandardCharsets.UTF_8)));
+        final ResourceManager resourceManager = (ResourceManager) Proxy.newProxyInstance(ResourceManager.class.getClassLoader(), new Class<?>[]{ResourceManager.class},
+            (proxy, method, args) -> switch (method.getName()) {
+                case "getResourceStack" -> List.of(metadata);
