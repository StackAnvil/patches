@@ -0,0 +1,139 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.hud;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.FontDescription;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.minecraft.server.packs.resources.SimplePreparableReloadListener;
+import net.minecraft.util.profiling.ProfilerFiller;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Images are active only for a converted, accepted server resource pack in the current reload. */
+public final class BedrockScoreboardImages extends SimplePreparableReloadListener<BedrockScoreboardImages.Prepared> {
+    private static final Identifier LOCATION = Identifier.fromNamespaceAndPath("viabedrock", "scoreboard_ui.json");
+    private static final AtomicReference<State> STATE = new AtomicReference<>(new State(Map.of()));
+
+    public static Image image(final Component title) {
+        if (!"\uE000".equals(title.getString()) || !title.getSiblings().isEmpty()
+            || !(title.getStyle().getFont() instanceof FontDescription.Resource font)) return null;
+        return STATE.get().images.get(font.id());
+    }
+
+    public static void clear() {
+        STATE.set(new State(Map.of()));
+    }
+
+    @Override
+    protected Prepared prepare(final ResourceManager resources, final ProfilerFiller profiler) {
+        final State pending = new State(Map.of());
+        STATE.set(pending);
+        final var stack = resources.getResourceStack(LOCATION);
+        for (int i = stack.size() - 1; i >= 0; i--) {
+            final Resource resource = stack.get(i);
+            if (resource.source().location().source() != PackSource.SERVER) continue;
+            try (final var input = resource.open()) {
+                final byte[] bytes = input.readNBytes(32769);
+                if (bytes.length > 32768) return new Prepared(pending, Map.of());
+                final Map<Identifier, Image> images = parse(JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)));
+                for (final Image image : images.values()) {
+                    if (!sameServerPack(resources, resource, image.texture)
+                        || !sameServerPack(resources, resource, image.font.withPrefix("font/").withSuffix(".json"))
+                        || image.background != null && !sameServerPack(resources, resource, image.background.texture))
+                        return new Prepared(pending, Map.of());
+                }
+                return new Prepared(pending, images);
+            } catch (final IOException | RuntimeException ignored) {
+                return new Prepared(pending, Map.of());
+            }
+        }
+        return new Prepared(pending, Map.of());
+    }
+
+    @Override
+    protected void apply(final Prepared prepared, final ResourceManager resources, final ProfilerFiller profiler) {
+        STATE.compareAndSet(prepared.pending, new State(prepared.images));
+    }
+
+    private static boolean sameServerPack(final ResourceManager resources, final Resource metadata, final Identifier location) {
+        final var resource = resources.getResource(location);
+        return resource.isPresent() && resource.get().source() == metadata.source();
+    }
+
+    static Map<Identifier, Image> parse(final JsonElement element) {
+        if (!element.isJsonObject()) throw new IllegalArgumentException("Invalid scoreboard image metadata");
+        final var object = element.getAsJsonObject();
+        if (integer(object.get("format"), 1, 1) != 1
+            || integer(object.get("bedrock_protocol"), ProtocolConstants.BEDROCK_PROTOCOL_VERSION, ProtocolConstants.BEDROCK_PROTOCOL_VERSION) != ProtocolConstants.BEDROCK_PROTOCOL_VERSION
+            || !object.has("images") || !object.get("images").isJsonArray() || object.getAsJsonArray("images").size() > 64)
+            throw new IllegalArgumentException("Unsupported scoreboard image metadata");
+        final Map<Identifier, Image> images = new LinkedHashMap<>();
+        for (final JsonElement entry : object.getAsJsonArray("images")) {
+            final var image = entry.getAsJsonObject();
+            final String fontName = image.get("font").getAsString();
+            final String textureName = image.get("texture").getAsString();
+            if (!fontName.matches("viabedrock:scoreboard/[a-f0-9]{64}")
+                || !textureName.equals(fontName.replace("viabedrock:", "viabedrock:textures/") + ".png"))
+                throw new IllegalArgumentException("Invalid scoreboard image identifier");
+            final Identifier font = Identifier.parse(fontName);
+            final Background background;
+            if (image.has("background")) {
+                final var panel = image.getAsJsonObject("background");
+                final String backgroundTexture = panel.get("texture").getAsString();
+                if (!backgroundTexture.equals(textureName.replace(".png", "_background.png")))
+                    throw new IllegalArgumentException("Invalid scoreboard background identifier");
+                final float alpha = panel.get("alpha").getAsFloat();
+                if (!Float.isFinite(alpha) || alpha <= 0 || alpha > 1)
+                    throw new IllegalArgumentException("Invalid scoreboard background alpha");
+                background = new Background(Identifier.parse(backgroundTexture), alpha,
+                    integer(panel.get("base_width"), 1, 1024), integer(panel.get("base_height"), 1, 1024),
+                    integer(panel.get("slice"), 0, 512), integer(panel.get("padding_x"), 0, 1024), integer(panel.get("padding_y"), 0, 1024),
+                    integer(panel.get("row_offset_x"), -1024, 1024), integer(panel.get("row_offset_y"), -1024, 1024));
+                if (background.slice * 2 > Math.min(background.baseWidth, background.baseHeight))
+                    throw new IllegalArgumentException("Scoreboard background slice exceeds its base dimensions");
+            } else {
+                background = null;
+            }
+            final Image definition = new Image(font, Identifier.parse(textureName), integer(image.get("width"), 1, 1024),
+                integer(image.get("height"), 1, 1024), integer(image.get("offset_x"), -1024, 1024), integer(image.get("offset_y"), -1024, 1024), integer(image.get("row_height"), 1, 64), background);
+            if (images.putIfAbsent(font, definition) != null) throw new IllegalArgumentException("Duplicate scoreboard image font");
+        }
+        return Map.copyOf(images);
+    }
+
+    private static int integer(final JsonElement value, final int min, final int max) {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber())
+            throw new IllegalArgumentException("Expected scoreboard image integer");
+        final BigDecimal number = value.getAsBigDecimal();
+        final int result = number.intValueExact();
+        if (result < min || result > max) throw new IllegalArgumentException("Scoreboard image value exceeds bounds");
+        return result;
+    }
+
+    record State(Map<Identifier, Image> images) {
+    }
+
+    record Prepared(State pending, Map<Identifier, Image> images) {
+    }
+
+    public record Background(Identifier texture, float alpha, int baseWidth, int baseHeight, int slice, int paddingX, int paddingY, int rowOffsetX, int rowOffsetY) {
+    }
+
+    public record Image(Identifier font, Identifier texture, int width, int height, int offsetX, int offsetY, int rowHeight, Background background) {
+    }
+}
