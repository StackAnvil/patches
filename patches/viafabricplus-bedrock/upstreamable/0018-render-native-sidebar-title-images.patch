+        final var layout = BedrockScoreboardRenderer.layout(640, 347, 110, 8, image);
+        assertEquals(113, layout.backgroundRight() - layout.backgroundLeft());
+        assertEquals(106, layout.backgroundBottom() - layout.backgroundTop());
+        assertEquals(layout.left() + 2, layout.rowX());
+        assertEquals(layout.headerTop() + 20, layout.rowTop());
+        final var quads = BedrockScoreboardRenderer.slices(layout, image.background());
+        assertEquals(9, quads.size());
+        assertEquals(2, quads.getFirst().right() - quads.getFirst().left());
+        assertEquals(2, quads.getFirst().sourceWidth());
+        final int[][] coverage = new int[106][113];
+        for (final var quad : quads) {
+            assertTrue(quad.u() >= 0 && quad.v() >= 0);
+            assertTrue(quad.u() + quad.sourceWidth() <= 6 && quad.v() + quad.sourceHeight() <= 6);
+            for (int y = quad.top(); y < quad.bottom(); y++) for (int x = quad.left(); x < quad.right(); x++)
+                coverage[y - layout.backgroundTop()][x - layout.backgroundLeft()]++;
+        }
+        for (final var row : coverage) for (final int covered : row) assertEquals(1, covered);
+    }
