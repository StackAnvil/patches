+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+
+/** Render-controller UV expressions share the sampled actor's variable scope. */
+record BedrockActorUvAnimation(String offsetU, String offsetV, String scaleU, String scaleV) {
+    static BedrockActorUvAnimation compile(final BedrockRenderController.UvAnimation animation) {
+        return new BedrockActorUvAnimation(animation.offsetU(), animation.offsetV(), animation.scaleU(), animation.scaleV());
+    }
+
+    BedrockActorUvTransform evaluate(final BedrockActorAnimation.Playback playback) {
+        return new BedrockActorUvTransform(playback.expression(this.offsetU, 0F), playback.expression(this.offsetV, 0F),
+                playback.expression(this.scaleU, 1F), playback.expression(this.scaleV, 1F));
+    }
+}
