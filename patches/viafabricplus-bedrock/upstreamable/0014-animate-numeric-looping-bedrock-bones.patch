 /** A resource-defined actor graph with shared variables and independent playback clocks. */
 public final class BedrockActorAnimation {
+    public static BedrockActorAnimation serverEntity(final ResourcePackStorage packs,
+                                                     final String identifier) throws IOException {
+        return serverActor(packs, "entity/", "minecraft:client_entity", identifier);
+    }
+
+    private static BedrockActorAnimation serverActor(final ResourcePackStorage packs,
+                                                    final String folder, final String field, final String identifier) throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>();
+        JsonObject entity = null;
+        try {
+            for (final var pack : packs.getPackStackBottomToTop()) {
+                for (final String path : pack.content().getFilesDeep(folder, ".json")) {
+                    final JsonObject document = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject();
+                    if (!document.has(field)) continue;
+                    final JsonObject description = document.getAsJsonObject(field).getAsJsonObject("description");
+                    if (identifier.equals(description.get("identifier").getAsString())) entity = description;
+                }
+                for (final String resourceFolder : List.of("animations/", "animation_controllers/")) {
+                    for (final String path : pack.content().getFilesDeep(resourceFolder, ".json")) {
+                        final JsonObject document = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject();
+                        final String resourceField = resourceFolder.equals("animations/") ? "animations" : "animation_controllers";
+                        final JsonObject definitions = document.getAsJsonObject(resourceField);
+                        if (definitions == null) continue;
+                        final boolean deferred = deferredEntry(document.has("format_version") ? document.get("format_version").getAsString() : "1.10.0");
+                        for (final var entry : definitions.entrySet()) {
+                            if (resourceField.equals("animations")) animations.put(entry.getKey(), entry.getValue().getAsJsonObject());
+                            else controllers.put(entry.getKey(), new ControllerResource(entry.getValue().getAsJsonObject(), deferred));
+                        }
+                        if (animations.size() > 4096 || controllers.size() > 4096) throw new IOException("Too many server actor animation resources");
+                    }
+                }
+            }
+            return entity == null ? null : new BedrockActorAnimation(entity, Map.of(), animations, controllers, BedrockResourceLibrary.serverEffects(packs));
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid server actor animation graph", e);
+        }
+    }
