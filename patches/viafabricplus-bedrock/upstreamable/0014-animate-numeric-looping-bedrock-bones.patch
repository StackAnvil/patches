+        assertEquals(90F, new BedrockEntityAnimation.Frame(0, 0, -1, 0, 0).rotationToCamera(1));
+        assertEquals(-180F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, -1).rotationToCamera(1));
+        assertEquals(-225F, new BedrockEntityAnimation.Frame(0, 0, -1, 0, -1).rotationToCamera(1));
+        assertEquals(-45F, new BedrockEntityAnimation.Frame(0, 0, 0, 1, 1).rotationToCamera(0));
+        assertEquals(45F, new BedrockEntityAnimation.Frame(0, 0, 0, -1, 1).rotationToCamera(0));
+        assertEquals(-90F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, 0).rotationToCamera(1));
+        assertEquals(0F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, 0).rotationToCamera(0), 0F);
+        assertEquals(0F, new BedrockEntityAnimation.Frame(0, 0, 1, 1, 1).rotationToCamera(2));
+    }
