+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMolangColor;
+import java.util.HashMap;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+/** Immutable camera and authoritative actor inputs for one submitted frame. */
+public record BedrockActorFrame(float seconds, float bodyYaw, double cameraOffsetX,
+                               double cameraOffsetY, double cameraOffsetZ) {
+    public BedrockActorAnimation.Frame input(final NativeActorMessage.Snapshot actor) {
+        final Map<String, Object> queries = new HashMap<>();
+        queries.put("body_y_rotation", this.bodyYaw);
+        queries.put("life_time", this.seconds);
+        queries.put("rotation_to_camera", (BedrockActorAnimation.Query) args ->
+                args.size() == 1 && args.getFirst() instanceof Number axis ? this.rotationToCamera(axis.intValue()) : 0F);
+        if (actor != null) {
+            queries.put("variant", actor.variant());
+            queries.put("mark_variant", actor.markVariant());
+            queries.put("property", (BedrockActorAnimation.Query) args -> args.isEmpty() ? 0F : actor.properties().getOrDefault(String.valueOf(args.getFirst()), 0F));
+            queries.put("has_property", (BedrockActorAnimation.Query) args -> !args.isEmpty() && actor.properties().containsKey(String.valueOf(args.getFirst())));
+            queries.put("is_charging", actor.flags().contains(ActorFlags.CHARGING));
+            queries.put("is_sneaking", actor.flags().contains(ActorFlags.SNEAKING));
+            queries.put("is_riding", actor.flags().contains(ActorFlags.RIDING));
+            queries.put("is_baby", actor.flags().contains(ActorFlags.BABY));
+            queries.put("spellcolor", actor.spellColor() == null ? BedrockMolangColor.ZERO
+                    : BedrockMolangColor.fromArgb(actor.spellColor()));
+        }
+        return new BedrockActorAnimation.Frame(queries, Map.of());
+    }
+
+    public float rotationToCamera(final int axis) {
+        if (axis < 0 || axis > 1) {
+            return 0F;
+        }
+        // Target 1.26.51.1 query callback 14065a850 normalizes camera minus actor.
+        final double length = Math.sqrt(this.cameraOffsetX * this.cameraOffsetX
+            + this.cameraOffsetY * this.cameraOffsetY + this.cameraOffsetZ * this.cameraOffsetZ);
+        final double x = length < 0.0001D ? 0D : this.cameraOffsetX / length;
+        final double y = length < 0.0001D ? 0D : this.cameraOffsetY / length;
+        final double z = length < 0.0001D ? 0D : this.cameraOffsetZ / length;
+        return axis == 1 ? (float) Math.toDegrees(Math.atan2(z, x)) - 90F
+            : (float) -Math.toDegrees(Math.atan2(y, Math.sqrt(x * x + z * z)));
+    }
+}
