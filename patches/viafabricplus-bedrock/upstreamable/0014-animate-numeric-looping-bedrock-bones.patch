     public static Model<EntityRenderState> entityModel(final BedrockGeometryModel geometry) {
         return new Model<>(root(geometry, false), RenderTypes::entityTranslucent) {
+            @Override
+            public void setupAnim(final EntityRenderState state) {
+                this.resetPose();
+                if (state instanceof BedrockEntityRenderer.State bedrockState) {
+                    for (BedrockEntityAnimation animation : bedrockState.animations()) {
+                        animation.apply(this.root, state.ageInTicks / 20F);
+                    }
+                }
+            }
         };
     }
 
