+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+final class BedrockEntityAnimationTest {
+
+    @Test
+    void interpolatesAndLoopsBoneRotationAndPosition() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {
+              "loop": true,
+              "animation_length": 2,
+              "bones": {
+                "tail": {
+                  "rotation": {"0": [0, 0, 0], "1": [0, 90, 0], "2": [0, 0, 0]},
+                  "position": {"0": [0, 0, 0], "1": [2, 4, 6], "2": [0, 0, 0]}
+                }
+              }
+            }
+            """));
+        assertNotNull(animation);
+
+        final ModelPart tail = new ModelPart(List.of(), Map.of());
+        tail.setPos(3F, 5F, 7F);
+        final ModelPart root = new ModelPart(List.of(), Map.of("tail", tail));
+
+        animation.apply(root, new BedrockEntityAnimation.Frame(0.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+
+        tail.setPos(3F, 5F, 7F);
+        tail.setRotation(0F, 0F, 0F);
+        animation.apply(root, new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+    }
+
+    @Test
+    void selectsOnlyUnconditionalAnimationAliases() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop": true, "bones": {"tail": {"rotation": [0, 15, 0]}}}
+            """));
+        assertNotNull(animation);
+        final var scripts = new BedrockEntityData.Scripts(List.of(), List.of(),
+            new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of(
+                new BedrockEntityData.Scripts.Animate("idle", ""),
+                new BedrockEntityData.Scripts.Animate("walk", "query.modified_move_speed")
+            ));
+        final var entity = new BedrockEntityData("test:mob", scripts, List.of(), Map.of(),
+            Map.of("idle", "animation.test.idle", "walk", "animation.test.walk"), Map.of(), Map.of());
+
+        assertEquals(List.of(animation), BedrockEntityAnimation.select(Map.of(
+            "animation.test.idle", animation, "animation.test.walk", animation
+        ), entity));
+    }
+
+    @Test
+    void acceptsTimingExpressionsAndRejectsCustomTimeUpdates() {
+        assertNotNull(BedrockEntityAnimation.parse(json("""
+            {"loop": true, "bones": {"tail": {"rotation": ["query.life_time * 20", 0, 0]}}}
+            """)));
+        assertNull(BedrockEntityAnimation.parse(json("""
+            {"loop": true, "anim_time_update": "query.modified_distance_moved", "bones": {"tail": {"rotation": [0, 15, 0]}}}
+            """)));
+    }
+
+    @Test
+    void evaluatesCameraFacingRotationWithoutInventingUnsupportedPositionVariables() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop":true,"animation_length":1,"bones":{"full_banner":{
+              "rotation":[0,"query.rotation_to_camera(1) - query.body_y_rotation",0],
+              "position":[0,"variable.growth * -6",0]}}}
+            """));
+        assertNotNull(animation);
+        final ModelPart banner = new ModelPart(List.of(), Map.of());
+        banner.setPos(3F, 5F, 7F);
