+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import java.util.Map;
+import net.minecraft.world.phys.Vec3;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockCustomActorModelTest {
+    @Test
+    void preservesDistinctAuthoredNamesAndResetsSharedModelsBeforeEachActor() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.actor","texture_width":16,"texture_height":16},
+              "bones":[{"name":"root","pivot":[0,0,0]},
+                {"name":"root_bone","pivot":[0,0,0]},
+                {"name":"rootbone","pivot":[0,0,0]}]}]}
+            """).getFirst();
+        final var model = BedrockGeometry.actorModel(geometry);
+        final var zero = new BedrockBoneAnimation.Vector(0,0,0);
+        final var one = new BedrockBoneAnimation.Vector(1,1,1);
+        model.pose(Map.of("root_bone", new BedrockBoneAnimation.Transform(zero,
+                new BedrockBoneAnimation.Vector(0,45,0), one, false),
+                "rootbone", new BedrockBoneAnimation.Transform(zero,
+                new BedrockBoneAnimation.Vector(0,90,0), one, false)));
+        assertEquals((float) Math.toRadians(45),model.model().root().getChild("root_bone").yRot,.00001F);
+        assertEquals((float) Math.toRadians(90),model.model().root().getChild("rootbone").yRot,.00001F);
+        assertEquals(0F,model.model().root().getChild("root").yRot);
+        model.pose(Map.of());
+        assertEquals(0F,model.model().root().getChild("root_bone").yRot);
+        assertEquals(0F,model.model().root().getChild("rootbone").yRot);
+    }
+
+    @Test
+    void scalesLocatorOffsetsAroundTheActorOriginAndPreservesWorldTranslation() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.actor","texture_width":16,"texture_height":16},
+              "bones":[{"name":"hand","pivot":[0,16,0]}]}]}
+            """).getFirst();
+        final var model = BedrockGeometry.actorModel(geometry);
+        final var locator = new BedrockModelLocators.Locator("hand",4,0,0,0,0,0,false);
+        final Vec3 origin = new Vec3(10,20,30);
+        final var ordinary = model.worldLocator(locator,origin,180,1);
+        final var scaled = model.worldLocator(locator,origin,180,2);
+        assertEquals((ordinary.m30()-10)*2+10,scaled.m30(),.00001F);
+        assertEquals((ordinary.m31()-20)*2+20,scaled.m31(),.00001F);
+        assertEquals((ordinary.m32()-30)*2+30,scaled.m32(),.00001F);
+        final var normal = scaled.transformDirection(new Vector3f(1,0,0));
+        assertEquals(2F,normal.length(),.00001F);
+    }
+}
