+        assertEquals(2F, part.yScale);
+        assertEquals(-2F, part.zScale);
+        assertEquals(0F, part.yRot);
+    }
+
+    private static JsonObject json(final String source) {
+        return JsonParser.parseString(source).getAsJsonObject();
+    }
+
+}
