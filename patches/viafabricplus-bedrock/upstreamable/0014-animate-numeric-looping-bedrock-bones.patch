+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+final class BedrockEntityAnimationTest {
+
+    @Test
+    void interpolatesAndLoopsBoneRotationAndPosition() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {
+              "loop": true,
+              "animation_length": 2,
+              "bones": {
+                "tail": {
+                  "rotation": {"0": [0, 0, 0], "1": [0, 90, 0], "2": [0, 0, 0]},
+                  "position": {"0": [0, 0, 0], "1": [2, 4, 6], "2": [0, 0, 0]}
+                }
+              }
+            }
+            """));
+        assertNotNull(animation);
+
+        final ModelPart tail = new ModelPart(List.of(), Map.of());
+        tail.setPos(3F, 5F, 7F);
+        final ModelPart root = new ModelPart(List.of(), Map.of("tail", tail));
+
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(0.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+
+        tail.setPos(3F, 5F, 7F);
+        tail.setRotation(0F, 0F, 0F);
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+    }
+
+    @Test
+    void selectsOnlyUnconditionalAnimationAliases() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop": true, "bones": {"tail": {"rotation": [0, 15, 0]}}}
+            """));
+        assertNotNull(animation);
+        final var scripts = new BedrockEntityData.Scripts(List.of(), List.of(),
+            new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of(
+                new BedrockEntityData.Scripts.Animate("idle", ""),
+                new BedrockEntityData.Scripts.Animate("walk", "query.modified_move_speed")
+            ));
+        final var entity = new BedrockEntityData("test:mob", scripts, List.of(), Map.of(),
+            Map.of("idle", "animation.test.idle", "walk", "animation.test.walk"), Map.of(), Map.of());
+
+        assertEquals(List.of(animation), BedrockEntityAnimation.select(Map.of(
+            "animation.test.idle", animation, "animation.test.walk", animation
+        ), entity));
+    }
+
+    @Test
+    void acceptsTimingExpressionsAndRejectsCustomTimeUpdates() {
+        assertNotNull(BedrockEntityAnimation.parse(json("""
+            {"loop": true, "bones": {"tail": {"rotation": ["query.life_time * 20", 0, 0]}}}
+            """)));
+        assertNull(BedrockEntityAnimation.parse(json("""
+            {"loop": true, "anim_time_update": "query.modified_distance_moved", "bones": {"tail": {"rotation": [0, 15, 0]}}}
+            """)));
+    }
+
+    @Test
+    void evaluatesCameraFacingRotationWithoutInventingUnsupportedPositionVariables() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop":true,"animation_length":1,"bones":{"full_banner":{
+              "rotation":[0,"query.rotation_to_camera(1) - query.body_y_rotation",0],
+              "position":[0,"variable.growth * -6",0]}}}
+            """));
+        assertNotNull(animation);
+        final ModelPart banner = new ModelPart(List.of(), Map.of());
+        banner.setPos(3F, 5F, 7F);
+        final ModelPart root = new ModelPart(List.of(), Map.of("full_banner", banner));
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(2F, 30F, 1D, 0D, 1D));
+        assertEquals((float) Math.toRadians(-75D), banner.yRot, 0.00001F);
+        assertEquals(3F, banner.x);
+        assertEquals(5F, banner.y);
+        assertEquals(7F, banner.z);
+
+        banner.setRotation(0F, 0F, 0F);
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(2F, -45F, -1D, 0D, 1D));
+        assertEquals((float) Math.toRadians(90D), banner.yRot, 0.00001F);
+    }
+
+    @Test
+    void preservesNativeCameraAxisAndAngleRange() {
+        assertEquals(0F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, 1).rotationToCamera(1));
+        assertEquals(-90F, new BedrockEntityAnimation.Frame(0, 0, 1, 0, 0).rotationToCamera(1));
+        assertEquals(90F, new BedrockEntityAnimation.Frame(0, 0, -1, 0, 0).rotationToCamera(1));
+        assertEquals(-180F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, -1).rotationToCamera(1));
+        assertEquals(-225F, new BedrockEntityAnimation.Frame(0, 0, -1, 0, -1).rotationToCamera(1));
+        assertEquals(-45F, new BedrockEntityAnimation.Frame(0, 0, 0, 1, 1).rotationToCamera(0));
+        assertEquals(45F, new BedrockEntityAnimation.Frame(0, 0, 0, -1, 1).rotationToCamera(0));
+        assertEquals(-90F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, 0).rotationToCamera(1));
+        assertEquals(0F, new BedrockEntityAnimation.Frame(0, 0, 0, 0, 0).rotationToCamera(0), 0F);
+        assertEquals(0F, new BedrockEntityAnimation.Frame(0, 0, 1, 1, 1).rotationToCamera(2));
+    }
+
+    @Test
+    void distinguishesLoopedAnimationTimeFromActorLifetimeAndRejectsUnknownQueries() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop":true,"animation_length":2,"bones":{
+              "tail":{"rotation":["q.life_time * 20","query.anim_time * 10",0]},
+              "head":{"rotation":[0,"query.health",0],"position":[1,2,3]}}}
+            """));
+        assertNotNull(animation);
+        final ModelPart tail = new ModelPart(List.of(), Map.of());
+        final ModelPart head = new ModelPart(List.of(), Map.of());
+        final ModelPart root = new ModelPart(List.of(), Map.of("tail", tail, "head", head));
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 1D));
+        assertEquals((float) Math.toRadians(50D), tail.xRot, 0.00001F);
+        assertEquals((float) Math.toRadians(5D), tail.yRot, 0.00001F);
+        assertEquals(0F, head.yRot);
+        assertEquals(1F, head.x);
+        assertEquals(-2F, head.y);
+        assertEquals(3F, head.z);
+    }
+
+    @Test
+    void holdsStaticPositionAndMultipliesScaleWithoutAnAnimationLength() {
+        final var animation = BedrockEntityAnimation.parse(json("""
+            {"loop":"hold_on_last_frame","bones":{"root":{"position":[0,32.5,-16.25],"scale":2}}}
+            """));
+        assertNotNull(animation);
+        final ModelPart part = new ModelPart(List.of(), Map.of());
+        part.setPos(1F, 2F, 3F);
+        part.xScale = 2F;
+        animation.apply(Map.of("root", part)::get, new BedrockEntityAnimation.Frame(600F, 0F, 0D, 0D, 1D));
+        assertEquals(1F, part.x);
+        assertEquals(-30.5F, part.y);
+        assertEquals(-13.25F, part.z);
+        assertEquals(4F, part.xScale);
+        assertEquals(2F, part.yScale);
+        assertEquals(2F, part.zScale);
+    }
+
+    @Test
+    void clampsHeldChannelsAndWrapsRepeatingChannelsAtTheEndpoint() {
+        final String channels = "\"animation_length\":2,\"bones\":{\"root\":{\"scale\":{\"0\":[1,2,3],\"2\":[3,4,5]},\"position\":[0,\"query.anim_time\",0]}}";
+        final var held = BedrockEntityAnimation.parse(json("{\"loop\":\"hold_on_last_frame\"," + channels + "}"));
+        final var repeating = BedrockEntityAnimation.parse(json("{\"loop\":true," + channels + "}"));
+        assertNotNull(held);
+        assertNotNull(repeating);
+        final ModelPart heldPart = new ModelPart(List.of(), Map.of());
+        final ModelPart repeatedPart = new ModelPart(List.of(), Map.of());
+        held.apply(Map.of("root", heldPart)::get, new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 1D));
+        repeating.apply(Map.of("root", repeatedPart)::get, new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 1D));
+        assertEquals(3F, heldPart.xScale);
+        assertEquals(4F, heldPart.yScale);
+        assertEquals(5F, heldPart.zScale);
+        assertEquals(-2F, heldPart.y);
+        assertEquals(1.5F, repeatedPart.xScale);
+        assertEquals(2.5F, repeatedPart.yScale);
+        assertEquals(3.5F, repeatedPart.zScale);
+        assertEquals(-0.5F, repeatedPart.y);
+    }
+
+    @Test
+    void evaluatesScaleExpressionsAndRetainsUnitScaleWithUnsupportedNeighbors() {
+        final var animation = BedrockEntityAnimation.parse(json("""
+            {"loop":"hold_on_last_frame","bones":{"root":{"scale":[1,"1 + query.life_time * 0.5",-2],
+              "rotation":[0,"variable.unsupported",0]}}}
