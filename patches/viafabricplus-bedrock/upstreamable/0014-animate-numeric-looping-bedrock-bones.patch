+        final var first = graph.playback();
+        final var second = graph.playback();
+        final var a = first.sample(0, input(0, .25F));
+        final var b = second.sample(0, input(0, .75F));
+        assertEquals(4F, a.get("root").position().x());
+        assertEquals(22.5F, a.get("root").rotation().y());
+        assertEquals(67.5F, b.get("root").rotation().y());
+        assertEquals(.25F, first.expression("v.weight", -1));
+        assertEquals(.75F, second.expression("v.weight", -1));
+    }
