+    @Test
+    void distinguishesLoopedAnimationTimeFromActorLifetimeAndRejectsUnknownQueries() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {"loop":true,"animation_length":2,"bones":{
+              "tail":{"rotation":["q.life_time * 20","query.anim_time * 10",0]},
+              "head":{"rotation":[0,"query.health",0],"position":[1,2,3]}}}
+            """));
+        assertNotNull(animation);
+        final ModelPart tail = new ModelPart(List.of(), Map.of());
