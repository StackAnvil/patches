+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+
+/** Ordered, unconditional animation references from controllers without state transitions. */
+record BedrockAnimationController(List<String> animations) {
+
+    BedrockAnimationController {
+        animations = List.copyOf(animations);
+    }
+
+    private static final int MAX_DEPTH = 16;
+    private static final int MAX_REFERENCES = 256;
+
+    static Map<String, BedrockAnimationController> load(final ResourcePackStorage packs) {
+        final Map<String, BedrockAnimationController> controllers = new HashMap<>();
+        for (var pack : packs.getPackStackBottomToTop()) {
+            for (String path : pack.content().getFilesDeep("animation_controllers/", ".json")) {
+                try {
+                    final JsonObject definitions = pack.content().getJson(path).getAsJsonObject("animation_controllers");
+                    if (definitions == null) {
+                        continue;
+                    }
+                    for (var entry : definitions.entrySet()) {
+                        final BedrockAnimationController controller = entry.getValue().isJsonObject()
+                            ? parse(entry.getValue().getAsJsonObject()) : null;
+                        if (controller == null) {
+                            controllers.remove(entry.getKey());
+                        } else {
+                            controllers.put(entry.getKey(), controller);
+                        }
+                    }
+                } catch (RuntimeException ignored) {
+                    // An invalid file must not prevent other packs from providing controllers.
+                }
+            }
+        }
+        return Map.copyOf(controllers);
+    }
+
+    static BedrockAnimationController parse(final JsonObject json) {
+        try {
+            final JsonObject states = json.getAsJsonObject("states");
+            if (states == null || states.size() != 1) {
+                return null;
+            }
+            final String initial = json.has("initial_state") ? json.get("initial_state").getAsString() : "default";
+            final JsonElement selected = states.get(initial);
+            if (selected == null || !selected.isJsonObject()) {
+                return null;
+            }
+            final JsonObject state = selected.getAsJsonObject();
+            for (String key : state.keySet()) {
+                if (!key.equals("animations") && !key.equals("transitions")) {
+                    return null;
+                }
+            }
+            if (state.has("transitions") && state.getAsJsonArray("transitions").size() != 0) {
+                return null;
+            }
+            final List<String> animations = new ArrayList<>();
+            if (state.has("animations")) {
+                for (JsonElement entry : state.getAsJsonArray("animations")) {
+                    if (entry.isJsonPrimitive() && entry.getAsJsonPrimitive().isString()) {
+                        animations.add(entry.getAsString());
+                    }
+                    // Weighted references need blend evaluation; never run them unconditionally.
+                }
+            }
+            return new BedrockAnimationController(List.copyOf(animations));
+        } catch (RuntimeException ignored) {
+            return null;
+        }
+    }
+
+    static List<BedrockEntityAnimation> select(
+        final Map<String, BedrockEntityAnimation> animations,
+        final Map<String, BedrockAnimationController> controllers,
+        final BedrockEntityData entity
+    ) {
+        final Map<String, String> aliases = new HashMap<>(entity.getAnimations());
+        for (var controller : entity.getAnimationControllers()) {
+            aliases.putIfAbsent(controller.alias(), controller.identifier());
+        }
+        final List<BedrockEntityAnimation> selected = new ArrayList<>();
+        for (var animate : entity.getScripts().animates()) {
+            if (animate.expression().isBlank()) {
+                selectRoot(aliases.get(animate.name()), aliases, animations, controllers, selected);
+            }
+        }
+        for (var controller : entity.getAnimationControllers()) {
+            selectRoot(controller.identifier(), aliases, animations, controllers, selected);
+        }
+        return List.copyOf(selected);
+    }
+
+    private static void selectRoot(
+        final String identifier, final Map<String, String> aliases,
+        final Map<String, BedrockEntityAnimation> animations,
+        final Map<String, BedrockAnimationController> controllers,
+        final List<BedrockEntityAnimation> selected
+    ) {
+        final List<BedrockEntityAnimation> branch = new ArrayList<>();
+        if (expand(identifier, aliases, animations, controllers, branch, new HashSet<>(), new int[1], 0)) {
+            selected.addAll(branch);
+        }
+    }
+
+    private static boolean expand(
+        final String identifier, final Map<String, String> aliases,
+        final Map<String, BedrockEntityAnimation> animations,
+        final Map<String, BedrockAnimationController> controllers,
+        final List<BedrockEntityAnimation> selected, final Set<String> path,
+        final int[] references, final int depth
+    ) {
+        if (++references[0] > MAX_REFERENCES || depth > MAX_DEPTH) {
+            return false;
+        }
+        if (identifier == null) {
+            return true;
+        }
+        final BedrockEntityAnimation animation = animations.get(identifier);
+        if (animation != null) {
+            selected.add(animation);
+            return true;
+        }
+        final BedrockAnimationController controller = controllers.get(identifier);
+        if (controller == null) {
+            return true;
+        }
+        if (!path.add(identifier)) {
+            return false;
+        }
+        try {
+            for (String alias : controller.animations) {
+                if (!expand(aliases.get(alias), aliases, animations, controllers, selected, path, references, depth + 1)) {
+                    return false;
+                }
+            }
+            return true;
+        } finally {
+            path.remove(identifier);
+        }
+    }
+}
