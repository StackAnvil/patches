+
+/** Compiled controller expressions evaluated against the actual submitted actor camera. */
+record BedrockActorUvAnimation(BedrockEntityAnimation.Component offsetU, BedrockEntityAnimation.Component offsetV,
+                              BedrockEntityAnimation.Component scaleU, BedrockEntityAnimation.Component scaleV) {
+    private static final Set<String> QUERIES = Set.of("rotation_to_camera", "body_y_rotation", "life_time");
+
+    static BedrockActorUvAnimation compile(final BedrockRenderController.UvAnimation animation) {
+        return new BedrockActorUvAnimation(component(animation.offsetU(), 0F), component(animation.offsetV(), 0F),
+            component(animation.scaleU(), 1F), component(animation.scaleV(), 1F));
+    }
+
+    private static BedrockEntityAnimation.Component component(final String expression, final float fallback) {
+        final var component = BedrockEntityAnimation.Component.parse(new JsonPrimitive(expression), QUERIES);
+        return component == null ? new BedrockEntityAnimation.Component(fallback, List.of()) : component;
+    }
+
+    BedrockActorUvTransform evaluate(final BedrockEntityAnimation.Frame frame) {
+        final Scope scope = frame.scope(0F);
+        return new BedrockActorUvTransform(this.offsetU.evaluate(scope, 0F), this.offsetV.evaluate(scope, 0F),
+            this.scaleU.evaluate(scope, 1F), this.scaleV.evaluate(scope, 1F));
+    }
+}
