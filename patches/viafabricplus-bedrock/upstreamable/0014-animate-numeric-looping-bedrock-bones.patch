+    @Test
+    void interpolatesAndLoopsBoneRotationAndPosition() {
+        final BedrockEntityAnimation animation = BedrockEntityAnimation.parse(json("""
+            {
+              "loop": true,
+              "animation_length": 2,
+              "bones": {
+                "tail": {
+                  "rotation": {"0": [0, 0, 0], "1": [0, 90, 0], "2": [0, 0, 0]},
+                  "position": {"0": [0, 0, 0], "1": [2, 4, 6], "2": [0, 0, 0]}
+                }
+              }
+            }
+            """));
+        assertNotNull(animation);
+
+        final ModelPart tail = new ModelPart(List.of(), Map.of());
+        tail.setPos(3F, 5F, 7F);
+        final ModelPart root = new ModelPart(List.of(), Map.of("tail", tail));
+
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(0.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+
+        tail.setPos(3F, 5F, 7F);
+        tail.setRotation(0F, 0F, 0F);
+        animation.apply(root.createPartLookup(), new BedrockEntityAnimation.Frame(2.5F, 0F, 0D, 0D, 0D));
+        assertEquals(4F, tail.x);
+        assertEquals(3F, tail.y);
+        assertEquals(10F, tail.z);
+        assertEquals((float) Math.PI / 4F, tail.yRot, 0.0001F);
+    }
+
+    @Test
