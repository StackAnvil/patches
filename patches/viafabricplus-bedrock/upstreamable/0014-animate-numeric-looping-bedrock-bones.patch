+        lower.putString("entity/actor.json", """
+            {"minecraft:client_entity":{"description":{"identifier":"fixture:actor","animations":{"idle":"animation.idle"},"scripts":{"animate":["idle"]}}}}
+            """);
+        lower.putString("animations/actor.json", """
+            {"format_version":"1.8.0","animations":{"animation.idle":{"loop":true,"bones":{"root":{"scale":1}}}}}
+            """);
+        final var higher = content();
+        higher.putString("animations/replacement.json", """
+            {"format_version":"1.8.0","animations":{"animation.idle":{"loop":"hold_on_last_frame","bones":{"root":{"position":[0,32.5,-16.25],"scale":2}}}}}
+            """);
+        final var stack = new ResourcePackStorage(List.of(new ResourcePack(higher),new ResourcePack(lower)));
+        final var graph = BedrockActorAnimation.serverEntity(stack,"fixture:actor");
+        final var pose = graph.playback().sample(0,input(0,0)).get("root");
+        assertEquals(32.5F,pose.position().y());
+        assertEquals(-16.25F,pose.position().z());
+        assertEquals(2F,pose.scale().x());
+        assertNull(BedrockActorAnimation.serverEntity(stack,"fixture:missing"));
+    }
+
+    private static BedrockActorAnimation.Frame input(final float time, final float weight) {
+        final var actor = new NativeActorMessage.Snapshot(UUID.randomUUID(),UUID.randomUUID(),false,1,"fixture:actor","",1,
+                Set.of(),0,0,null,Map.of("fixture:weight",weight));
+        return new BedrockActorFrame(time,0,0,0,1).input(actor);
+    }
+
+    private static InMemoryContent content() {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"fixture\",\"uuid\":\"" + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        return content;
+    }
+
+    private static ResourcePackStorage stack(final InMemoryContent content) { return new ResourcePackStorage(List.of(new ResourcePack(content))); }
+}
