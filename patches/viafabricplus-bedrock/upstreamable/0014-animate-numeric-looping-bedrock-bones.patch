+        final var animation = BedrockActorUvAnimation.compile(snapshot.uvAnimation());
+        final var first = animation.evaluate(frame(2F, 0F, 0D, 1D, 1D));
+        assertEquals(0.75F, first.offsetU());
+        assertEquals(-0.25F, first.offsetV());
+        final var uv = first.apply(new Matrix4f()).transform(new Vector4f(0.25F, 0.5F, 0F, 1F));
+        assertEquals(0.25F, uv.x);
+        assertEquals(0F, uv.y);
+        final var second = animation.evaluate(frame(4F, 0F, 1D, 0D, 0D));
+        assertEquals(1.25F, second.offsetU());
+        assertEquals(0F, second.offsetV(), 0F);
+    }
+
+    @Test
+    void retainsFiniteComponentsAndEvaluatesMissingQueriesAsZero() throws Exception {
+        final var definition = new BedrockRenderController.UvAnimation("query.life_time * 0.125", "variable.unknown", "query.health", "-2");
+        final var actual = BedrockActorUvAnimation.compile(definition).evaluate(frame(4F, 0F, 0D, 0D, 1D));
+        assertEquals(new BedrockActorUvTransform(0.5F, 0F, 0F, -2F), actual);
+        assertEquals(BedrockActorUvTransform.IDENTITY,
+            BedrockActorUvAnimation.compile(BedrockRenderController.UvAnimation.IDENTITY)
+                .evaluate(frame(9F, 0F, 0D, 0D, 1D)));
+        final var nonfinite = new BedrockRenderController.UvAnimation("10000000000000000000000000000000000000000", "0", "10000000000000000000000000000000000000000", "query.anim_time");
+        assertEquals(new BedrockActorUvTransform(0F, 0F, 0F, 0F), BedrockActorUvAnimation.compile(nonfinite)
+            .evaluate(frame(9F, 0F, 0D, 0D, 1D)));
+    }
+}
