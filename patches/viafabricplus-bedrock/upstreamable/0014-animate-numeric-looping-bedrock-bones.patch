+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeAnimationMessage;
+
+public record NativeAnimationPayload(NativeAnimationMessage message) implements CustomPacketPayload {
+    public static final Type<NativeAnimationPayload> TYPE = new Type<>(Identifier.parse(NativeAnimationMessage.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeAnimationPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeAnimationMessage.TYPE.write(buffer, payload.message),
+            buffer -> new NativeAnimationPayload(NativeAnimationMessage.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeAnimationPayload> type() {
+        return TYPE;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAnimationCommandsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAnimationCommandsTest.java
new file mode 100644
index 0000000..223ecab
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAnimationCommandsTest.java
@@ -0,0 +1,180 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.NativeAnimationControllers;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockAnimationCommandsTest {
+    private static final BedrockActorAnimation.Frame FRAME = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+
+    private static BedrockActorAnimation graph() throws IOException {
+        return BedrockActorAnimation.read(json("""
+                {"animations":{"raise":"animation.raise","lower":"animation.lower","finite":"animation.finite"},
+                 "sound_effects":{"cue":"fixture.cue"}, "particle_effects":{"spark":"fixture:spark"}}
+                """), Map.of(), json("""
+                {"animation.raise":{"loop":true,"animation_length":100,
+                   "bones":{"arm":{"position":["q.anim_time","q.state_time",10]}}},
+                 "animation.lower":{"loop":true,"animation_length":100,
+                   "bones":{"arm":{"position":["q.anim_time","q.state_time",-10]}}},
+                 "animation.finite":{"animation_length":0.5,
+                   "bones":{"head":{"position":["q.anim_time",0,0]}},
+                   "sound_effects":{"0":{"effect":"cue"}},
+                   "particle_effects":{"0":{"effect":"spark"}}},
+                 "animation.global":{"loop":true,"animation_length":100,
+                   "bones":{"hand":{"position":[2,0,0]}}}}
+                """), new JsonObject(), "1.10.0");
+    }
+
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+
+    private static ActorAnimationCommand command(final String animation, final String next, final String condition,
+                                                 final String slot, final float blend) {
+        return new ActorAnimationCommand(animation, next, condition, 1, slot, blend);
+    }
+
+    @Test
+    void resetsRepeatedSelectionsAndAppliesOnlyTheLastSelectionInAFrame() throws IOException {
+        final var playback = graph().playback();
+        final var commands = new NativeAnimationControllers();
+        playback.commands(commands);
+        commands.apply(command("raise", "default", "0", "slot", 0));
+        assertEquals(new BedrockBoneAnimation.Vector(0, 0, 10), playback.sample(0, FRAME).get("arm").position());
+        assertEquals(new BedrockBoneAnimation.Vector(0.5F, 0.5F, 10), playback.sample(0.5F, FRAME).get("arm").position());
+        commands.apply(command("lower", "default", "0", "slot", 0));
+        commands.apply(command("raise", "default", "0", "slot", 0));
+        assertEquals(new BedrockBoneAnimation.Vector(0.25F, 0, 10), playback.sample(0.75F, FRAME).get("arm").position());
+        assertEquals(0.25F, playback.sample(1, FRAME).get("arm").position().y());
+    }
+
+    @Test
+    void transitionsToUncommandedAliasesAndUsesPreviousChildCompletion() throws IOException {
+        final var playback = graph().playback();
+        final var commands = new NativeAnimationControllers();
+        playback.commands(commands);
+        commands.apply(command("finite", "lower", "q.any_animation_finished", "slot", 0));
+        assertTrue(playback.sample(0, FRAME).containsKey("head"));
+        assertTrue(playback.sample(0.5F, FRAME).containsKey("head"));
+        final var after = playback.sample(0.75F, FRAME);
+        assertFalse(after.containsKey("head"));
+        assertEquals(new BedrockBoneAnimation.Vector(0.25F, 0.75F, -10), after.get("arm").position());
+        commands.apply(command("lower", "default", "1", "slot", 0));
+        assertTrue(playback.sample(1, FRAME).containsKey("arm"));
+        assertTrue(playback.sample(1.25F, FRAME).isEmpty());
+    }
+
+    @Test
+    void usesTheOutgoingCurveAndPreservesTheNativeSameStateDoubleSample() throws IOException {
+        final var playback = graph().playback();
+        final var commands = new NativeAnimationControllers();
+        playback.commands(commands);
+        commands.apply(command("raise", "default", "0", "slot", 2));
+        playback.sample(0, FRAME);
+        playback.sample(0.5F, FRAME);
+        commands.apply(command("lower", "default", "0", "slot", 0));
+        final var blended = playback.sample(0.75F, FRAME).get("arm").position();
+        assertEquals(7.5F, blended.z(), 0.00001F);
+        assertEquals(0.6875F, blended.x(), 0.00001F);
+        assertEquals(1, blended.y(), 0.00001F);
+        commands.apply(command("lower", "default", "0", "slot", 2));
+        assertEquals(-10, playback.sample(1, FRAME).get("arm").position().z());
+        commands.apply(command("lower", "default", "0", "slot", 2));
+        assertEquals(0.28125F, playback.sample(1.25F, FRAME).get("arm").position().x(), 0.00001F);
+    }
+
+    @Test
+    void ignoresUnavailableAnimationsAndKeepsSlotsAndPerspectivesIndependent() throws IOException {
+        final var body = graph().playback();
+        final var firstPerson = body.fork();
+        final var commands = new NativeAnimationControllers();
+        body.commands(commands);
+        firstPerson.commands(commands);
+        commands.apply(command("raise", "default", "0", "one", 0));
+        commands.apply(command("animation.global", "default", "0", "two", 0));
+        final var pose = body.sample(0, FRAME);
+        assertEquals(10, pose.get("arm").position().z());
+        assertEquals(2, pose.get("hand").position().x());
+        body.sample(0.5F, FRAME);
+        commands.apply(command("missing", "raise", "1", "one", 0));
+        assertEquals(0.75F, body.sample(0.75F, FRAME).get("arm").position().x());
+        assertEquals(0, firstPerson.sample(0.75F, FRAME).get("arm").position().x());
+        body.commands(null);
+        assertTrue(body.sample(1, FRAME).isEmpty());
+        assertTrue(body.sample(0, FRAME).isEmpty());
+    }
+
+    @Test
+    void replaysFiniteEffectsAfterAForcedResetWithoutSharingThemAcrossPerspectives() throws IOException {
+        final var playback = graph().playback();
+        final var commands = new NativeAnimationControllers();
+        final var sounds = new ArrayList<BedrockActorAnimation.SoundCue>();
+        final var particles = new ArrayList<BedrockActorAnimation.ParticleCue>();
+        playback.commands(commands);
+        commands.apply(command("finite", "default", "q.any_animation_finished", "slot", 0));
+        playback.sample(0, FRAME, true, sounds::add, particles::add);
+        assertEquals(1, sounds.size());
+        assertEquals(1, particles.size());
+        playback.sample(0.25F, FRAME, true, sounds::add, particles::add);
+        assertEquals(1, sounds.size());
+        commands.apply(command("finite", "default", "q.any_animation_finished", "slot", 0));
+        playback.sample(0.5F, FRAME, true, sounds::add, particles::add);
+        assertEquals(2, sounds.size());
+        assertEquals(2, particles.size());
+        final var firstPerson = playback.fork();
+        firstPerson.commands(commands);
+        firstPerson.sample(0.5F, FRAME, false, sounds::add, particles::add);
+        assertEquals(2, sounds.size());
+        assertEquals(2, particles.size());
+    }
+
+    @Test
+    void selectsAnAuthoredControllerWithoutSamplingItTwiceOrReplacingItsStates() throws IOException {
+        final var graph = BedrockActorAnimation.read(json("""
+                {"animations":{"slot":"controller.animation.slot","raise":"animation.raise","lower":"animation.lower"},
+                 "scripts":{"animate":["slot"]}}
+                """), Map.of(), json("""
+                {"animation.raise":{"loop":true,"bones":{"arm":{"position":[0,0,10]}}},
+                 "animation.lower":{"loop":true,"bones":{"arm":{"position":[0,0,-10]}}}}
+                """), json("""
+                {"controller.animation.slot":{"states":{"default":{"animations":["lower"]}}}}
+                """), "1.10.0");
+        final var playback = graph.playback();
+        final var commands = new NativeAnimationControllers();
+        playback.commands(commands);
+        assertEquals(-10, playback.sample(0, FRAME).get("arm").position().z());
+        commands.apply(command("raise", "default", "1", "slot", 0));
+        assertEquals(10, playback.sample(0.25F, FRAME).get("arm").position().z());
+        assertEquals(-10, playback.sample(0.5F, FRAME).get("arm").position().z());
+    }
+
+    @Test
+    void createsSlotsInTheOrderOfTheirFirstResolvableCommands() throws IOException {
+        final var graph = BedrockActorAnimation.read(json("""
+                {"animations":{"write":"animation.write","read":"animation.read"}}
+                """), Map.of(), json("""
+                {"animation.write":{"loop":true,"bones":{"writer":{"position":["v.shared = 7; return v.shared;",0,0]}}},
+                 "animation.read":{"loop":true,"bones":{"reader":{"position":["v.shared",0,0]}}}}
+                """), new JsonObject(), "1.10.0");
+        final var playback = graph.playback();
+        final var commands = new NativeAnimationControllers();
+        playback.commands(commands);
+        commands.apply(command("missing", "default", "0", "reader", 0));
+        commands.apply(command("write", "default", "0", "writer", 0));
+        commands.apply(command("read", "default", "0", "reader", 0));
+        assertEquals(7, playback.sample(0, FRAME).get("reader").position().x());
+    }
+
+}
