+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Repeating and held bone channels with verified camera and timing MoLang queries. */
+record BedrockEntityAnimation(float length, boolean holdLastFrame, Map<String, Bone> bones) {
+
+    private static final Scope BASE_SCOPE = MochaEngine.createStandard().scope();
+    private static final Set<String> QUERIES = Set.of("rotation_to_camera", "body_y_rotation", "life_time", "anim_time");
+    private static final float DEGREES_TO_RADIANS = (float) (Math.PI / 180D);
+
+    static Map<String, BedrockEntityAnimation> load(final ResourcePackStorage packs) {
+        final Map<String, BedrockEntityAnimation> animations = new HashMap<>();
+        for (var pack : packs.getPackStackBottomToTop()) {
+            for (String path : pack.content().getFilesDeep("animations/", ".json")) {
+                try {
+                    final JsonObject definitions = pack.content().getJson(path).getAsJsonObject("animations");
+                    if (definitions == null) {
+                        continue;
+                    }
+                    for (var entry : definitions.entrySet()) {
+                        final BedrockEntityAnimation animation = parse(entry.getValue().getAsJsonObject());
+                        if (animation == null) {
+                            animations.remove(entry.getKey());
+                        } else {
+                            animations.put(entry.getKey(), animation);
+                        }
+                    }
+                } catch (RuntimeException ignored) {
+                    // An invalid file must not prevent other packs from providing animations.
+                }
+            }
+        }
+        return Map.copyOf(animations);
+    }
+
+    static BedrockEntityAnimation parse(final JsonObject json) {
+        final JsonElement loop = json.get("loop");
+        final boolean hold = loop != null && loop.isJsonPrimitive() && loop.getAsJsonPrimitive().isString()
+            && loop.getAsString().equals("hold_on_last_frame");
+        final boolean repeating = loop != null && loop.isJsonPrimitive() && loop.getAsJsonPrimitive().isBoolean() && loop.getAsBoolean();
+        if ((!hold && !repeating)
+            || json.has("anim_time_update") || json.has("blend_weight") || json.has("override_previous_animation")
+            || json.has("start_delay") || json.has("loop_delay")) {
+            return null;
+        }
+        final JsonObject boneData = json.getAsJsonObject("bones");
+        if (boneData == null) {
+            return null;
+        }
+        final Map<String, Bone> bones = new HashMap<>();
+        float lastFrame = 0F;
+        for (var entry : boneData.entrySet()) {
+            if (!entry.getValue().isJsonObject()) {
+                return null;
+            }
+            final JsonObject channels = entry.getValue().getAsJsonObject();
+            for (String channel : channels.keySet()) {
+                if (!channel.equals("position") && !channel.equals("rotation") && !channel.equals("scale")) {
+                    return null;
+                }
+            }
+            final Channel position = channels.has("position") ? Channel.parse(channels.get("position")) : null;
+            final Channel rotation = channels.has("rotation") ? Channel.parse(channels.get("rotation")) : null;
+            final Channel scale = channels.has("scale") ? Channel.parse(channels.get("scale")) : null;
+            if (position != null || rotation != null || scale != null) {
+                bones.put(entry.getKey(), new Bone(position, rotation, scale));
+                lastFrame = Math.max(lastFrame, Math.max(scale == null ? 0F : scale.lastFrame(),
+                    Math.max(position == null ? 0F : position.lastFrame(), rotation == null ? 0F : rotation.lastFrame())));
+            }
+        }
+        if (bones.isEmpty()) {
+            return null;
+        }
+        final float defaultLength = lastFrame > 0F || hold ? lastFrame : 1F;
+        final float length = json.has("animation_length") ? json.get("animation_length").getAsFloat() : defaultLength;
+        if (!Float.isFinite(length) || length < 0F || (!hold && length == 0F) || length < lastFrame) {
+            return null;
+        }
+        return new BedrockEntityAnimation(length, hold, Map.copyOf(bones));
+    }
+
+    void apply(final Function<String, ModelPart> lookup, final Frame frame) {
+        final float time = this.holdLastFrame ? Math.clamp(frame.seconds, 0F, this.length) : frame.seconds % this.length;
+        final Scope scope = frame.scope(time);
+        for (var entry : this.bones.entrySet()) {
+            final ModelPart part = lookup.apply(entry.getKey());
+            if (part == null) {
+                continue;
+            }
+            final Bone bone = entry.getValue();
+            if (bone.position != null) {
+                final Vec3 position = bone.position.sample(time, scope, 0F);
+                part.x += position.x;
+                part.y -= position.y;
+                part.z += position.z;
+            }
+            if (bone.rotation != null) {
+                final Vec3 rotation = bone.rotation.sample(time, scope, 0F);
+                part.xRot += rotation.x * DEGREES_TO_RADIANS;
+                part.yRot += rotation.y * DEGREES_TO_RADIANS;
+                part.zRot += rotation.z * DEGREES_TO_RADIANS;
+            }
+            if (bone.scale != null) {
+                final Vec3 scale = bone.scale.sample(time, scope, 1F);
+                part.xScale *= scale.x;
+                part.yScale *= scale.y;
+                part.zScale *= scale.z;
+            }
+        }
+    }
+
+    private record Bone(Channel position, Channel rotation, Channel scale) {
+    }
+
+    private record Vec3(float x, float y, float z) {
+
+        private Vec3 interpolate(final Vec3 next, final float fraction) {
+            return new Vec3(
+                this.x + (next.x - this.x) * fraction,
+                this.y + (next.y - this.y) * fraction,
+                this.z + (next.z - this.z) * fraction
+            );
+        }
+
+    }
+
+    record Frame(float seconds, float bodyYaw, double cameraOffsetX, double cameraOffsetY, double cameraOffsetZ) {
+
+        Scope scope(final float animationTime) {
+            final Scope scope = BASE_SCOPE.copy();
+            final MutableObjectBinding queries = new MutableObjectBinding();
+            queries.set("body_y_rotation", Value.of(this.bodyYaw));
+            queries.set("life_time", Value.of(this.seconds));
+            queries.set("anim_time", Value.of(animationTime));
+            queries.set("rotation_to_camera", (team.unnamed.mocha.runtime.value.Function<Object>) (_, arguments) ->
+                Value.of(arguments.length() == 1 ? this.rotationToCamera((int) arguments.next().eval().getAsNumber()) : 0F));
+            queries.block();
+            scope.set("query", queries);
+            scope.set("q", queries);
+            return scope;
+        }
+
+        float rotationToCamera(final int axis) {
+            if (axis < 0 || axis > 1) {
+                return 0F;
+            }
+            // Target 1.26.51.1 query callback 14065a850 normalizes camera minus actor.
+            final double length = Math.sqrt(this.cameraOffsetX * this.cameraOffsetX
+                + this.cameraOffsetY * this.cameraOffsetY + this.cameraOffsetZ * this.cameraOffsetZ);
+            final double x = length < 0.0001D ? 0D : this.cameraOffsetX / length;
+            final double y = length < 0.0001D ? 0D : this.cameraOffsetY / length;
+            final double z = length < 0.0001D ? 0D : this.cameraOffsetZ / length;
+            return axis == 1 ? (float) Math.toDegrees(Math.atan2(z, x)) - 90F
+                : (float) -Math.toDegrees(Math.atan2(y, Math.sqrt(x * x + z * z)));
+        }
+
+    }
+
+    record Component(float constant, List<Expression> expression) {
+
+        static Component parse(final JsonElement value, final Set<String> queries) {
+            if (!value.isJsonPrimitive()) {
+                return null;
+            }
+            if (value.getAsJsonPrimitive().isNumber()) {
+                final float number = value.getAsFloat();
+                return Float.isFinite(number) ? new Component(number, List.of()) : null;
+            }
+            if (!value.getAsJsonPrimitive().isString()) {
+                return null;
+            }
+            try {
+                final List<Expression> expressions = MoLangEngine.parse(value.getAsString());
+                return expressions.size() == 1 && supported(expressions.getFirst(), queries)
+                    ? new Component(0F, expressions) : null;
+            } catch (IOException invalid) {
+                return null;
+            }
+        }
+
+        private static boolean supported(final Expression expression, final Set<String> queries) {
+            if (expression instanceof DoubleExpression) {
+                return true;
+            }
+            if (expression instanceof AccessExpression access && access.object() instanceof IdentifierExpression identifier) {
+                return switch (identifier.name()) {
+                    case "query", "q" -> queries.contains(access.property());
+                    case "math" -> ((ObjectValue) BASE_SCOPE.get("math")).get(access.property()) != null;
+                    default -> false;
+                };
+            }
+            if (expression instanceof CallExpression call) {
+                return supported(call.function(), queries) && call.arguments().stream().allMatch(argument -> supported(argument, queries));
+            }
+            if (expression instanceof UnaryExpression unary) {
+                return supported(unary.expression(), queries);
+            }
+            if (expression instanceof BinaryExpression binary) {
+                return binary.op() != BinaryExpression.Op.ASSIGN && binary.op() != BinaryExpression.Op.ARROW
+                    && supported(binary.left(), queries) && supported(binary.right(), queries);
+            }
+            if (expression instanceof TernaryConditionalExpression ternary) {
+                return supported(ternary.condition(), queries) && supported(ternary.trueExpression(), queries) && supported(ternary.falseExpression(), queries);
+            }
+            return false;
+        }
+
+        float evaluate(final Scope scope, final float fallback) {
+            final float result = this.expression.isEmpty() ? this.constant : (float) MoLangEngine.eval(scope, this.expression).getAsNumber();
+            return Float.isFinite(result) ? result : fallback;
+        }
+
+    }
+
+    private record Vector(Component x, Component y, Component z) {
+
+        private static Vector parse(final JsonElement value) {
+            if (!value.isJsonArray()) {
+                final Component component = Component.parse(value, QUERIES);
+                return component == null ? null : new Vector(component, component, component);
+            }
+            final var array = value.getAsJsonArray();
+            if (array.size() != 1 && array.size() != 3) {
+                return null;
+            }
+            final Component x = Component.parse(array.get(0), QUERIES);
+            final Component y = Component.parse(array.get(array.size() == 1 ? 0 : 1), QUERIES);
+            final Component z = Component.parse(array.get(array.size() == 1 ? 0 : 2), QUERIES);
+            return x == null || y == null || z == null ? null : new Vector(x, y, z);
+        }
+
+        private Vec3 evaluate(final Scope scope, final float fallback) {
+            return new Vec3(this.x.evaluate(scope, fallback), this.y.evaluate(scope, fallback), this.z.evaluate(scope, fallback));
+        }
+
+    }
+
+    private record Keyframe(float time, Vector value) {
+    }
+
+    private record Channel(List<Keyframe> keyframes) {
+
+        private static Channel parse(final JsonElement value) {
+            if (!value.isJsonObject()) {
+                final Vector vector = Vector.parse(value);
+                return vector == null ? null : new Channel(List.of(new Keyframe(0F, vector)));
+            }
+            final List<Keyframe> frames = new ArrayList<>();
+            for (var entry : value.getAsJsonObject().entrySet()) {
+                final float time;
+                try {
+                    time = Float.parseFloat(entry.getKey());
+                } catch (NumberFormatException ignored) {
+                    return null;
+                }
+                final Vector vector = Vector.parse(entry.getValue());
+                if (!Float.isFinite(time) || time < 0F || vector == null) {
+                    return null;
+                }
+                frames.add(new Keyframe(time, vector));
+            }
+            if (frames.isEmpty()) {
+                return null;
+            }
+            frames.sort(Comparator.comparingDouble(Keyframe::time));
+            return new Channel(List.copyOf(frames));
+        }
+
+        private float lastFrame() {
+            return this.keyframes.getLast().time;
+        }
+
+        private Vec3 sample(final float time, final Scope scope, final float fallback) {
+            Keyframe previous = this.keyframes.getFirst();
+            for (int i = 1; i < this.keyframes.size(); i++) {
+                final Keyframe next = this.keyframes.get(i);
+                if (time < next.time) {
+                    final float fraction = Math.clamp((time - previous.time) / (next.time - previous.time), 0F, 1F);
+                    return previous.value.evaluate(scope, fallback).interpolate(next.value.evaluate(scope, fallback), fraction);
+                }
+                previous = next;
+            }
+            return previous.value.evaluate(scope, fallback);
+        }
+
+    }
+
+}
