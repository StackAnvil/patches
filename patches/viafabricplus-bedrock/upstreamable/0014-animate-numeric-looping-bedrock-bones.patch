+            {"format_version":"1.8.0","minecraft:client_entity":{"description":{
+              "identifier":"fixture:actor","animation_controllers":[{"legacy":"controller.fixture"}],
+              "animations":{"pose":"animation.pose","weight":"animation.weight","__legacy_controller_0":"animation.weight"},
+              "scripts":{"initialize":["v.bias=4;"],"pre_animation":["v.weight=q.property('fixture:weight');"],
