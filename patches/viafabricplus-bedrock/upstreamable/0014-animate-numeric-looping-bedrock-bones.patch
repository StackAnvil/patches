+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+import org.cube.converter.parser.bedrock.controller.BedrockControllerParser;
+import org.joml.Matrix4f;
+import org.joml.Vector4f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class BedrockActorUvAnimationTest {
+    private static com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation.Playback frame(
+            final float time, final float yaw, final double x, final double y, final double z) throws Exception {
+        final var content = new net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"fixture\",\"uuid\":\"" + java.util.UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        content.putString("entity/actor.json", "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"fixture:actor\"}}}");
+        final var packs = new net.raphimc.viabedrock.protocol.storage.ResourcePackStorage(
+                java.util.List.of(new net.raphimc.viabedrock.api.resourcepack.ResourcePack(content)));
+        final var playback = com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation.serverEntity(packs, "fixture:actor").playback();
+        playback.sample(time, new BedrockActorFrame(time, yaw, x, y, z).input(null));
+        return playback;
+    }
+
+    @Test
+    void evaluatesControllerSnapshotAgainstEachSubmittedCameraAndLifetime() throws Exception {
+        final var controller = BedrockControllerParser.parse("""
+            {"render_controllers":{"controller.render.actor":{"uv_anim":{
+              "offset":["(-query.rotation_to_camera(1) + 180) / 360 + query.life_time * 0.125",
+                        "query.rotation_to_camera(0) / 180"],"scale":[-2,0.5]}}}}
+            """).getFirst();
+        final var snapshot = new CustomEntity.EvaluatedModel("actor", "geometry", "texture", Map.of(), false, 1F, controller.uvAnimation());
+        final var animation = BedrockActorUvAnimation.compile(snapshot.uvAnimation());
+        final var first = animation.evaluate(frame(2F, 0F, 0D, 1D, 1D));
+        assertEquals(0.75F, first.offsetU());
+        assertEquals(-0.25F, first.offsetV());
+        final var uv = first.apply(new Matrix4f()).transform(new Vector4f(0.25F, 0.5F, 0F, 1F));
+        assertEquals(0.25F, uv.x);
+        assertEquals(0F, uv.y);
+        final var second = animation.evaluate(frame(4F, 0F, 1D, 0D, 0D));
+        assertEquals(1.25F, second.offsetU());
+        assertEquals(0F, second.offsetV(), 0F);
+    }
+
+    @Test
+    void retainsFiniteComponentsAndEvaluatesMissingQueriesAsZero() throws Exception {
+        final var definition = new BedrockRenderController.UvAnimation("query.life_time * 0.125", "variable.unknown", "query.health", "-2");
+        final var actual = BedrockActorUvAnimation.compile(definition).evaluate(frame(4F, 0F, 0D, 0D, 1D));
+        assertEquals(new BedrockActorUvTransform(0.5F, 0F, 0F, -2F), actual);
+        assertEquals(BedrockActorUvTransform.IDENTITY,
+            BedrockActorUvAnimation.compile(BedrockRenderController.UvAnimation.IDENTITY)
+                .evaluate(frame(9F, 0F, 0D, 0D, 1D)));
+        final var nonfinite = new BedrockRenderController.UvAnimation("10000000000000000000000000000000000000000", "0", "10000000000000000000000000000000000000000", "query.anim_time");
+        assertEquals(new BedrockActorUvTransform(0F, 0F, 0F, 0F), BedrockActorUvAnimation.compile(nonfinite)
+            .evaluate(frame(9F, 0F, 0D, 0D, 1D)));
+    }
+}
