+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import net.minecraft.client.model.geom.ModelPart;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+
+/** A numeric, looping Bedrock animation. MoLang and animation controllers are intentionally excluded. */
+record BedrockEntityAnimation(float length, Map<String, Bone> bones) {
+
+    private static final float DEGREES_TO_RADIANS = (float) (Math.PI / 180D);
+
+    static Map<String, BedrockEntityAnimation> load(final ResourcePackStorage packs) {
+        final Map<String, BedrockEntityAnimation> animations = new HashMap<>();
+        for (var pack : packs.getPackStackBottomToTop()) {
+            for (String path : pack.content().getFilesDeep("animations/", ".json")) {
+                try {
+                    final JsonObject definitions = pack.content().getJson(path).getAsJsonObject("animations");
+                    if (definitions == null) {
+                        continue;
+                    }
+                    for (var entry : definitions.entrySet()) {
+                        final BedrockEntityAnimation animation = parse(entry.getValue().getAsJsonObject());
+                        if (animation == null) {
+                            animations.remove(entry.getKey());
+                        } else {
+                            animations.put(entry.getKey(), animation);
+                        }
+                    }
+                } catch (RuntimeException ignored) {
+                    // An invalid file must not prevent other packs from providing animations.
+                }
+            }
+        }
+        return Map.copyOf(animations);
+    }
+
+    static List<BedrockEntityAnimation> select(final Map<String, BedrockEntityAnimation> library, final BedrockEntityData entity) {
+        final List<BedrockEntityAnimation> selected = new ArrayList<>();
+        for (var animate : entity.getScripts().animates()) {
+            if (!animate.expression().isBlank()) {
+                continue;
+            }
+            final String identifier = entity.getAnimations().get(animate.name());
+            if (identifier == null) {
+                continue;
+            }
+            final BedrockEntityAnimation animation = library.get(identifier);
+            if (animation != null) {
+                selected.add(animation);
+            }
+        }
+        return List.copyOf(selected);
+    }
+
+    static BedrockEntityAnimation parse(final JsonObject json) {
+        if (!json.has("loop") || !json.get("loop").getAsBoolean()
+            || json.has("anim_time_update") || json.has("blend_weight") || json.has("override_previous_animation")
+            || json.has("start_delay") || json.has("loop_delay")) {
+            return null;
+        }
+        final JsonObject boneData = json.getAsJsonObject("bones");
+        if (boneData == null) {
+            return null;
+        }
+        final Map<String, Bone> bones = new HashMap<>();
+        float lastFrame = 0F;
+        for (var entry : boneData.entrySet()) {
+            if (!entry.getValue().isJsonObject()) {
+                return null;
+            }
+            final JsonObject channels = entry.getValue().getAsJsonObject();
+            for (String channel : channels.keySet()) {
+                if (!channel.equals("position") && !channel.equals("rotation")) {
+                    return null;
+                }
+            }
+            final Channel position = channels.has("position") ? Channel.parse(channels.get("position")) : null;
+            final Channel rotation = channels.has("rotation") ? Channel.parse(channels.get("rotation")) : null;
+            if (channels.has("position") && position == null || channels.has("rotation") && rotation == null) {
+                return null;
+            }
+            if (position != null || rotation != null) {
+                bones.put(entry.getKey(), new Bone(position, rotation));
+                lastFrame = Math.max(lastFrame, Math.max(position == null ? 0F : position.lastFrame(), rotation == null ? 0F : rotation.lastFrame()));
+            }
+        }
+        if (bones.isEmpty()) {
+            return null;
+        }
+        final float length = json.has("animation_length") ? json.get("animation_length").getAsFloat() : lastFrame > 0F ? lastFrame : 1F;
+        if (!Float.isFinite(length) || length <= 0F || length < lastFrame) {
+            return null;
+        }
+        return new BedrockEntityAnimation(length, Map.copyOf(bones));
+    }
+
+    void apply(final ModelPart root, final float seconds) {
+        final float time = seconds % this.length;
+        final Function<String, ModelPart> lookup = root.createPartLookup();
+        for (var entry : this.bones.entrySet()) {
+            final ModelPart part = lookup.apply(entry.getKey());
+            if (part == null) {
+                continue;
+            }
+            final Bone bone = entry.getValue();
+            if (bone.position != null) {
+                final Vec3 position = bone.position.sample(time);
+                part.x += position.x;
+                part.y -= position.y;
+                part.z += position.z;
+            }
+            if (bone.rotation != null) {
+                final Vec3 rotation = bone.rotation.sample(time);
+                part.xRot += rotation.x * DEGREES_TO_RADIANS;
+                part.yRot += rotation.y * DEGREES_TO_RADIANS;
+                part.zRot += rotation.z * DEGREES_TO_RADIANS;
+            }
+        }
+    }
+
+    private record Bone(Channel position, Channel rotation) {
+    }
+
+    private record Vec3(float x, float y, float z) {
+
+        private static Vec3 parse(final JsonElement value) {
+            if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()) {
+                final float number = value.getAsFloat();
+                return Float.isFinite(number) ? new Vec3(number, number, number) : null;
+            }
+            if (!value.isJsonArray() || value.getAsJsonArray().size() != 1 && value.getAsJsonArray().size() != 3) {
+                return null;
+            }
+            final var array = value.getAsJsonArray();
+            for (JsonElement component : array) {
+                if (!component.isJsonPrimitive() || !component.getAsJsonPrimitive().isNumber() || !Float.isFinite(component.getAsFloat())) {
+                    return null;
+                }
+            }
+            if (array.size() == 1) {
+                final float number = array.get(0).getAsFloat();
+                return new Vec3(number, number, number);
+            }
+            return new Vec3(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+        }
+
+        private Vec3 interpolate(final Vec3 next, final float fraction) {
+            return new Vec3(
+                this.x + (next.x - this.x) * fraction,
+                this.y + (next.y - this.y) * fraction,
+                this.z + (next.z - this.z) * fraction
+            );
+        }
+
+    }
+
+    private record Keyframe(float time, Vec3 value) {
+    }
+
+    private record Channel(List<Keyframe> keyframes) {
+
+        private static Channel parse(final JsonElement value) {
+            if (!value.isJsonObject()) {
+                final Vec3 vector = Vec3.parse(value);
+                return vector == null ? null : new Channel(List.of(new Keyframe(0F, vector)));
+            }
+            final List<Keyframe> frames = new ArrayList<>();
+            for (var entry : value.getAsJsonObject().entrySet()) {
+                final float time;
+                try {
+                    time = Float.parseFloat(entry.getKey());
+                } catch (NumberFormatException ignored) {
+                    return null;
+                }
+                final Vec3 vector = Vec3.parse(entry.getValue());
+                if (!Float.isFinite(time) || time < 0F || vector == null) {
+                    return null;
+                }
+                frames.add(new Keyframe(time, vector));
+            }
+            if (frames.isEmpty()) {
+                return null;
+            }
+            frames.sort(Comparator.comparingDouble(Keyframe::time));
+            return new Channel(List.copyOf(frames));
+        }
+
+        private float lastFrame() {
+            return this.keyframes.getLast().time;
+        }
+
+        private Vec3 sample(final float time) {
+            Keyframe previous = this.keyframes.getFirst();
+            for (int i = 1; i < this.keyframes.size(); i++) {
+                final Keyframe next = this.keyframes.get(i);
+                if (time < next.time) {
+                    final float fraction = Math.clamp((time - previous.time) / (next.time - previous.time), 0F, 1F);
+                    return previous.value.interpolate(next.value, fraction);
+                }
+                previous = next;
+            }
+            return previous.value;
+        }
+
+    }
+
+}
