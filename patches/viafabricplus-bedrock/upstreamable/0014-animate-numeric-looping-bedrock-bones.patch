+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.cube.converter.parser.bedrock.data.impl.BedrockEntityParser;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+final class BedrockAnimationControllerTest {
+
+    @Test
+    void legacyControllerSelectsCameraAnimationWithoutUnsupportedSibling() {
+        final var entity = BedrockEntityParser.parse("""
+            {"format_version":"1.8.0","minecraft:client_entity":{"description":{
+              "identifier":"test:label","animations":{
+                "face":"animation.test.face","center":"animation.test.center"},
+              "animation_controllers":[{"default":"controller.animation.test.label"}]}}}
+            """);
+        final var face = BedrockEntityAnimation.parse(json("""
+            {"loop":true,"bones":{"root":{"rotation":[
+              "query.rotation_to_camera(0)","query.rotation_to_camera(1)",0]}}}
+            """));
+        assertNotNull(face);
+        assertNull(BedrockEntityAnimation.parse(json("""
+            {"loop":true,"bones":{"root":{"position":["variable.length * -6",0,0]}}}
+            """)));
+        final var selected = BedrockAnimationController.select(Map.of("animation.test.face", face),
+            Map.of("controller.animation.test.label", controller("face", "center")), entity);
+        assertEquals(List.of(face), selected);
+        assertThrows(UnsupportedOperationException.class, selected::clear);
+        final ModelPart part = new ModelPart(List.of(), Map.of());
+        selected.forEach(animation -> animation.apply(Map.of("root", part)::get,
+            new BedrockEntityAnimation.Frame(2, 0, 1, 1, 1)));
+        assertEquals((float) Math.toRadians(-45), part.yRot, 0.00001F);
+        assertEquals((float) -Math.atan(1 / Math.sqrt(2)), part.xRot, 0.00001F);
+        part.setRotation(0, 0, 0);
+        selected.forEach(animation -> animation.apply(Map.of("root", part)::get,
+            new BedrockEntityAnimation.Frame(2, 0, -1, 0, 1)));
+        assertEquals((float) Math.toRadians(45), part.yRot, 0.00001F);
+    }
+
+    @Test
+    void preservesDirectAndNestedDeclarationOrderWithoutImplicitControllers() {
+        final var first = animation(10);
+        final var second = animation(20);
+        final var entity = entity(Map.of("first", "animation.first", "second", "animation.second",
+            "nested", "controller.nested"), List.of("first"), List.of("controller.root"));
+        final var controllers = Map.of("controller.root", controller("second", "nested", "first"),
+            "controller.nested", controller("first", "second"), "controller.unused", controller("second"));
+        final var library = Map.of("animation.first", first, "animation.second", second);
+        assertEquals(List.of(first, second, first, second, first),
+            BedrockAnimationController.select(library, controllers, entity));
+        assertEquals(List.of(), BedrockAnimationController.select(library, controllers,
+            entity(entity.getAnimations(), List.of(), List.of())));
+        final var modern = entity(Map.of("root", "controller.root", "second", "animation.second"),
+            List.of("root"), List.of());
+        assertEquals(List.of(second), BedrockAnimationController.select(library, controllers, modern));
+    }
+
+    @Test
+    void honorsOnlyStateAndRejectsTransitionsAndStateSideEffects() {
+        assertEquals(List.of("idle"), BedrockAnimationController.parse(json("""
+            {"initial_state":"rest","states":{"rest":{"animations":["idle"],"transitions":[]}}}
+            """)).animations());
+        for (String definition : List.of(
+            "{\"states\":{\"rest\":{\"animations\":[\"idle\"]}}}",
+            "{\"states\":{\"default\":{},\"walking\":{}}}",
+            "{\"states\":{\"default\":{\"transitions\":[{\"default\":\"query.is_alive\"}]}}}",
+            "{\"states\":{\"default\":{\"on_entry\":[\"variable.ready=1\"]}}}",
+            "{\"states\":{\"default\":{\"animations\":3}}}"
+        )) {
+            assertNull(BedrockAnimationController.parse(json(definition)));
+        }
+    }
+
+    @Test
+    void doesNotInventUnconditionalPlaybackForWeightedEntries() {
+        final var parsed = BedrockAnimationController.parse(json("""
+            {"states":{"default":{"animations":["idle",{"walk":"query.modified_move_speed"},"face"]}}}
+            """));
+        assertNotNull(parsed);
+        assertEquals(List.of("idle", "face"), parsed.animations());
+    }
+
+    @Test
+    void rejectsCyclicBranchWithoutRemovingUnrelatedDirectAnimation() {
+        final var pose = animation(15);
+        final var entity = entity(Map.of("idle", "animation.idle", "root", "controller.root", "cycle", "controller.cycle"),
+            List.of("idle"), List.of("controller.root"));
+        final var controllers = Map.of("controller.root", controller("idle", "cycle"),
+            "controller.cycle", controller("root"));
+        assertEquals(List.of(pose), BedrockAnimationController.select(Map.of("animation.idle", pose), controllers, entity));
+    }
+
+    @Test
+    void boundsControllerDepthAndExpansionBeforePublishingBranch() {
+        final var pose = animation(15);
+        final Map<String, String> aliases = new HashMap<>(Map.of("idle", "animation.idle"));
+        final Map<String, BedrockAnimationController> controllers = new HashMap<>();
+        for (int i = 0; i < 20; i++) {
+            aliases.put("level" + i, "controller.level" + i);
+            controllers.put("controller.level" + i, controller("idle", "level" + (i + 1)));
+        }
+        assertEquals(List.of(pose), BedrockAnimationController.select(Map.of("animation.idle", pose), controllers,
+            entity(aliases, List.of("idle"), List.of("controller.level0"))));
+        final List<String> wide = new ArrayList<>();
+        for (int i = 0; i < 300; i++) {
+            wide.add("idle");
+        }
+        assertEquals(List.of(pose), BedrockAnimationController.select(Map.of("animation.idle", pose),
+            Map.of("controller.wide", new BedrockAnimationController(List.copyOf(wide))),
+            entity(aliases, List.of("idle"), List.of("controller.wide"))));
+    }
+
+    private static BedrockEntityData entity(final Map<String, String> animations, final List<String> scripts,
+                                           final List<String> controllers) {
+        final var scriptData = new BedrockEntityData.Scripts(List.of(), List.of(),
+            new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), scripts.stream()
+                .map(alias -> new BedrockEntityData.Scripts.Animate(alias, "")).toList());
+        return new BedrockEntityData("test:actor", scriptData, List.of(), Map.of(), animations, Map.of(), Map.of(),
+            controllers.stream().map(identifier -> new BedrockEntityData.AnimationController(identifier, identifier)).toList());
+    }
+
+    private static BedrockEntityAnimation animation(final int rotation) {
+        return BedrockEntityAnimation.parse(json("{\"loop\":true,\"bones\":{\"root\":{\"rotation\":[0," + rotation + ",0]}}}"));
+    }
+
+    private static BedrockAnimationController controller(final String... animations) {
+        final JsonArray entries = new JsonArray();
+        for (String animation : animations) {
+            entries.add(animation);
+        }
+        final JsonObject state = new JsonObject();
+        state.add("animations", entries);
+        final JsonObject states = new JsonObject();
+        states.add("default", state);
+        final JsonObject definition = new JsonObject();
+        definition.add("states", states);
+        return BedrockAnimationController.parse(definition);
+    }
+
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+}
