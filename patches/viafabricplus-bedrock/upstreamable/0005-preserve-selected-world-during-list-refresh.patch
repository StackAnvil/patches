From 74c2885cbbad463afdacb493db22a1f85e6db506 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:10:44 +0200
Subject: [PATCH] fix(friends): preserve selected world during list refresh

Refreshing the friends or worlds list rebuilds its entries and drops keyboard focus. The Join button then becomes disabled even while the same world is still available. Restore focus by world handle or user XUID when the rebuilt list contains that entry.
---
 .../bedrock/screen/BedrockFriendsScreen.java  | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/BedrockFriendsScreen.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/BedrockFriendsScreen.java
index 5cd2422..46e2737 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/BedrockFriendsScreen.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/BedrockFriendsScreen.java
@@ -110,6 +110,27 @@ public final class BedrockFriendsScreen extends VFPScreen {
         super(TITLE, true);
     }
 
+    @Override
+    protected void rebuildWidgets() {
+        final VFPListEntry focused = this.list == null ? null : this.list.getFocused();
+        final String worldId = focused instanceof WorldEntry entry ? entry.world.handleId() : null;
+        final String userXuid = focused instanceof UserEntry entry ? entry.user.xuid() : null;
+        super.rebuildWidgets();
+        if (this.list == null || (worldId == null && userXuid == null)) {
+            return;
+        }
+        for (VFPListEntry entry : this.list.children()) {
+            final boolean sameWorld = entry instanceof WorldEntry world && worldId != null
+                && worldId.equals(world.world.handleId());
+            final boolean sameUser = entry instanceof UserEntry user && userXuid != null
+                && userXuid.equals(user.user.xuid());
+            if (sameWorld || sameUser) {
+                this.list.setFocused(entry);
+                break;
+            }
+        }
+    }
+
     @Override
     protected void init() {
         final int tabWidth = Math.min(88, (this.width - 20) / View.values().length);
-- 
