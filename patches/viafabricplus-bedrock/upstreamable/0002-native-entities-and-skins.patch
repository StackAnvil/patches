+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Set;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorMaterialsTest {
+    @Test
+    void partitionsMixedMaterialsWithLaterBoneOverrides() {
+        final var selections = new LinkedHashMap<String, String>();
+        selections.put("*", "entity_alphatest");
+        selections.put("Light*", "entity_emissive_alpha");
+        selections.put("LightFrame", "entity_alphatest_one_sided");
+        final var partition = BedrockActorMaterials.partition(List.of("Body", "Light", "LightBulb", "LightFrame"), selections);
+        assertEquals(Set.of("Body"), partition.get("entity_alphatest"));
+        assertEquals(Set.of("Light", "LightBulb"), partition.get("entity_emissive_alpha"));
+        assertEquals(Set.of("LightFrame"), partition.get("entity_alphatest_one_sided"));
+        assertTrue(BedrockActorMaterials.matches("*Light*Frame*", "RedLightGlassFrameTop"));
+        assertFalse(BedrockActorMaterials.matches("Light*Frame", "LightFrameTop"));
+    }
+
+    @Test
+    void bonePartitionKeepsAncestorTransformsButOmitsAncestorGeometry() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.partition","texture_width":32,"texture_height":32},
+            "bones":[{"name":"Body","pivot":[0,12,0],"rotation":[0,0,30],
+                "cubes":[{"origin":[0,0,0],"size":[2,2,2],"uv":[0,0]}]},
+                {"name":"Light","parent":"Body","pivot":[0,18,0],
+                "cubes":[{"origin":[0,16,0],"size":[2,2,2],"uv":[0,0]}]}]}]}
+            """).getFirst();
+        final var model = BedrockGeometry.entityModel(geometry, Set.of("Light"));
+        final var body = model.root().getChild("Body");
+        final var light = body.getChild("Light");
+        assertFalse(body.hasChild("cube_0"));
+        assertTrue(light.hasChild("cube_0"));
+        assertEquals(-6F, light.y);
+        assertEquals((float) Math.PI / 6F, body.zRot, 0.000001F);
+    }
+}
