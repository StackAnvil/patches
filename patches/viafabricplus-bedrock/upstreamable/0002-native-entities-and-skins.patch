+package com.viaversion.viafabricplus.bedrock.render;
+
+import org.joml.Matrix4f;
+import org.joml.Vector4f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorUvTransformTest {
+    @Test
+    void appliesNativeScaleThenOffsetWithoutMutatingExistingTransforms() {
+        final Matrix4f existing = new Matrix4f().translation(0.1F, 0.2F, 0F);
+        final Matrix4f original = new Matrix4f(existing);
+        final var transform = new BedrockActorUvTransform(-0.25F, 0.75F, -2F, 0F);
+        final var result = transform.apply(existing).transform(new Vector4f(0.3F, 0.4F, 0F, 1F));
+        assertEquals(-1.05F, result.x, 1E-6F);
+        assertEquals(0.75F, result.y, 1E-6F);
+        assertEquals(original, existing);
+        assertEquals(new Vector4f(0.3F, 0.4F, 0F, 1F),
+            BedrockActorUvTransform.IDENTITY.apply(new Matrix4f()).transform(new Vector4f(0.3F, 0.4F, 0F, 1F)));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockCubeFacesTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockCubeFacesTest.java
