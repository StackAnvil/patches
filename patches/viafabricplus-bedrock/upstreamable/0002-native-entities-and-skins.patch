+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.api.model.entity.BoatEntity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+final class BedrockRidingAnchorsTest {
+    @Test
+    void rotatesBoatSeatsInTheNativeHullFrame() {
+        final Fixture fixture = new Fixture();
+        final BoatEntity boat = new BoatEntity(fixture.user, 3, 3, "minecraft:boat", 30,
+                UUID.randomUUID(), EntityTypes26_3.OAK_BOAT);
+        fixture.tracker.addEntity(boat, false);
+        fixture.passenger.setMountEntityRuntimeId(boat.runtimeId());
+        fixture.seat(new Position3f(0F, 1.245F, -0.6F));
+        for (final float yaw : new float[]{0F, 90F, 180F, -90F}) {
+            boat.setRotation(new Position3f(0, yaw, yaw));
+            BedrockRidingAnchors.update(fixture.user, fixture.passenger);
+            final Vec3 result = BedrockRidingAnchors.ridingPosition(fixture.user, fixture.passenger.javaId(),
+                    fixture.passenger.javaUuid(), boat.javaUuid(), Vec3.ZERO, boat.javaRotation().y(), Vec3.ZERO);
+            final double radians = Math.toRadians(-yaw);
+            assertPosition(new Vec3(-0.6 * Math.sin(radians), 0, -0.6 * Math.cos(radians)), result, 1E-6);
+        }
+    }
+
+    @Test
+    void matchesNativeEyeAnchorsAndCancelsJavaPassengerAttachmentOnce() {
+        final Fixture fixture = new Fixture();
+        fixture.mount();
+        fixture.seat(new Position3f(0F, 1.72F, -0.1F));
+        final Vec3 attachment = new Vec3(0.2, 0.6, -0.3);
+        // Independently recorded source actor and passenger coordinates, with different vehicle yaw.
+        final double[][] pairs = {
+            {-3.9279013, 40.00001, 5.882186, 179.22815, -3.9265542, 41.72001, 5.982177},
+            {-5.3660965, 40.00001, 5.1736393, -145.44173, -5.422821, 41.72001, 5.2559943}
+        };
+        for (double[] pair : pairs) {
+            final Vec3 sourceEye = new Vec3(pair[4], pair[5], pair[6]);
+            final Vec3 attachmentPoint = fixture.position(new Vec3(pair[0], pair[1], pair[2]), (float) pair[3], attachment);
+            final Vec3 feet = attachmentPoint.subtract(attachment);
+            assertPosition(sourceEye.add(0, -fixture.passenger.eyeOffset(), 0), feet, 0.000001);
+        }
+    }
+
+    @Test
+    void waitsForResolvedMountAndKeepsSparseSeatUpdatesImmutable() {
+        final Fixture fixture = new Fixture();
+        fixture.seat(new Position3f(2F, 3F, 4F));
+        assertNull(fixture.position());
+        fixture.mount();
+        assertPosition(new Vec3(2, 3 - fixture.passenger.eyeOffset(), 4), fixture.position(), 0.000001);
+        fixture.passenger.entityData().put(ActorDataIds.RESERVED_056,
+                new EntityData(56, EntityDataTypesBedrock.POSITION_3F, new Position3f(5F, 6F, 7F)));
+        // Network state changes do not mutate an already-published render snapshot.
+        assertPosition(new Vec3(2, 3 - fixture.passenger.eyeOffset(), 4), fixture.position(), 0.000001);
+        BedrockRidingAnchors.update(fixture.user, fixture.passenger);
+        assertPosition(new Vec3(5, 6 - fixture.passenger.eyeOffset(), 7), fixture.position(), 0.000001);
+        BedrockRidingAnchors.update(fixture.user, fixture.passenger);
+        assertPosition(new Vec3(5, 6 - fixture.passenger.eyeOffset(), 7), fixture.position(), 0.000001);
+    }
+
+    @Test
+    void fallsBackForAbsentInvalidOrStaleAnchorsAndClearsDismounts() {
+        final Fixture fixture = new Fixture();
+        fixture.mount();
+        assertNull(fixture.position());
+        fixture.seat(Position3f.ZERO);
+        assertPosition(new Vec3(0, -fixture.passenger.eyeOffset(), 0), fixture.position(), 0.000001);
+        assertNull(BedrockRidingAnchors.ridingPosition(fixture.user, fixture.passenger.javaId(),
+                UUID.randomUUID(), fixture.vehicle.javaUuid(), Vec3.ZERO, 0, Vec3.ZERO));
+        assertNull(BedrockRidingAnchors.ridingPosition(fixture.user, fixture.passenger.javaId(),
+                fixture.passenger.javaUuid(), UUID.randomUUID(), Vec3.ZERO, 0, Vec3.ZERO));
+        assertNull(BedrockRidingAnchors.ridingPosition(null, fixture.passenger.javaId(),
+                fixture.passenger.javaUuid(), fixture.vehicle.javaUuid(), Vec3.ZERO, 0, Vec3.ZERO));
+        fixture.seat(new Position3f(0, Float.POSITIVE_INFINITY, 0));
+        assertNull(fixture.position());
+        fixture.seat(Position3f.ZERO);
+        fixture.passenger.setMountEntityRuntimeId(-1);
+        BedrockRidingAnchors.update(fixture.user, fixture.passenger);
+        assertNull(fixture.position());
+        fixture.mount();
+        BedrockRidingAnchors.remove(fixture.user, fixture.passenger);
+        assertNull(fixture.position());
+    }
+
+    private static void assertPosition(final Vec3 expected, final Vec3 actual, final double tolerance) {
+        assertEquals(expected.x, actual.x, tolerance);
+        assertEquals(expected.y, actual.y, tolerance);
+        assertEquals(expected.z, actual.z, tolerance);
+    }
+
+    private static final class Fixture {
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (_, method, args) -> switch (method.getName()) {
+                    case "get" -> this.stores.get(args[0]);
+                    case "put" -> this.stores.put(args[0].getClass(), args[0]);
+                    default -> null;
+                });
+        final EntityTracker tracker = new EntityTracker(this.user);
+        final Entity vehicle = new Entity(this.user, 1, 1, "minecraft:pig", 10, UUID.randomUUID(), EntityTypes26_3.PIG);
+        final Entity passenger = new Entity(this.user, 2, 2, "minecraft:player", 20, UUID.randomUUID(), EntityTypes26_3.PLAYER) {
+            @Override public float eyeOffset() { return 1.62F; }
+        };
+
+        Fixture() {
+            this.stores.put(EntityTracker.class, this.tracker);
+            this.tracker.addEntity(this.vehicle, false);
+            this.tracker.addEntity(this.passenger, false);
+        }
+
+        void mount() {
+            this.passenger.setMountEntityRuntimeId(this.vehicle.runtimeId());
+            BedrockRidingAnchors.update(this.user, this.passenger);
+        }
+
+        void seat(final Position3f position) {
+            this.passenger.entityData().put(ActorDataIds.RESERVED_056,
+                    new EntityData(56, EntityDataTypesBedrock.POSITION_3F, position));
+            BedrockRidingAnchors.update(this.user, this.passenger);
+        }
+
+        Vec3 position() { return this.position(Vec3.ZERO, 0F, Vec3.ZERO); }
+        Vec3 position(final Vec3 vehiclePosition, final float yaw, final Vec3 attachment) {
+            return BedrockRidingAnchors.ridingPosition(this.user, this.passenger.javaId(),
+                    this.passenger.javaUuid(), this.vehicle.javaUuid(), vehiclePosition, yaw, attachment);
+        }
+    }
+}
