@@ -0,0 +1,40 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.BiConsumer;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+
+/** Keeps ordered skin updates until their source connection has a client play listener. */
+final class BedrockSkinQueue {
+    private final Map<UserConnection, List<Update>> pending = new IdentityHashMap<>();
+
+    void add(final UserConnection connection, final UUID player, final SkinData skin) {
+        if (connection.getChannel().isActive()) {
+            this.pending.computeIfAbsent(connection, _ -> new ArrayList<>()).add(new Update(player, skin));
+        }
+    }
+
+    void drain(final UserConnection current, final BiConsumer<UUID, SkinData> install) {
+        this.discardDisconnected();
+        final List<Update> updates = this.pending.remove(current);
+        if (updates != null) {
+            for (final Update update : updates) install.accept(update.player(), update.skin());
+        }
+    }
+
+    void discardDisconnected() {
+        this.pending.keySet().removeIf(connection -> !connection.getChannel().isActive());
+    }
+
+    private record Update(UUID player, SkinData skin) {}
+}
