+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.ChatFormatting;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.Style;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockNameTagsTest {
+    @Test
+    void leavesSingleLineComponentsAndOffsetsIntact() {
+        final var name = Component.literal("ordinary").withStyle(ChatFormatting.GOLD);
+        final var lines = BedrockNameTags.layout(name, 9, 7);
+        assertEquals(1, lines.size());
+        assertSame(name, lines.getFirst().text());
+        assertEquals(7, lines.getFirst().baseline());
+    }
+
+    @Test
+    void keepsStyledSiblingsAcrossNewlinesAndAnchorsTheLastRow() {
+        final var red = Style.EMPTY.withColor(ChatFormatting.RED);
+        final var blue = Style.EMPTY.withColor(ChatFormatting.BLUE).withBold(true);
+        final var name = Component.literal("a\nb").setStyle(red)
+            .append(Component.literal("c\nd").setStyle(blue));
+        final var lines = BedrockNameTags.layout(name, 9, 4);
+        assertEquals(List.of(-14, -5, 4), lines.stream().map(BedrockNameTags.Line::baseline).toList());
+        assertEquals(List.of(red), styles(lines.getFirst().text()));
+        assertEquals(List.of(red, blue), styles(lines.get(1).text()));
+        assertEquals(List.of(blue), styles(lines.getLast().text()));
+        assertEquals(2, lines.get(1).text().getString().codePointCount(0, lines.get(1).text().getString().length()));
+    }
+
+    @Test
+    void retainsBlankRowsAndWholeUnicodeCodepoints() {
+        final var name = Component.literal("\n\n\uD83D\uDE00\n");
+        final var lines = BedrockNameTags.layout(name, 10, 2);
+        assertEquals(List.of(-28, -18, -8, 2), lines.stream().map(BedrockNameTags.Line::baseline).toList());
+        assertTrue(lines.getFirst().text().getString().isEmpty());
+        assertTrue(lines.get(1).text().getString().isEmpty());
+        assertEquals(1, lines.get(2).text().getString().codePointCount(0, lines.get(2).text().getString().length()));
+        assertTrue(lines.getLast().text().getString().isEmpty());
+    }
+
+    @Test
+    void resolvesTranslatedStyledArgumentsBeforeLayingOutRows() {
+        final var first = Component.literal("a").withStyle(ChatFormatting.GREEN);
+        final var second = Component.literal("b").withStyle(ChatFormatting.AQUA);
+        final var translated = Component.translatableWithFallback("stackanvil.test.name.lines", "%s\n%s", first, second);
+        final var lines = BedrockNameTags.layout(translated, 9, 0);
+        assertEquals(2, lines.size());
+        assertEquals(styles(first), styles(lines.getFirst().text()));
+        assertEquals(styles(second), styles(lines.getLast().text()));
+        assertEquals(-9, lines.getFirst().baseline());
+        assertEquals(0, lines.getLast().baseline());
+    }
+
+    private static List<Style> styles(final Component component) {
+        final List<Style> styles = new ArrayList<>();
+        component.getVisualOrderText().accept((_, style, _) -> {
+            styles.add(style);
+            return true;
+        });
+        return styles;
+    }
+}
