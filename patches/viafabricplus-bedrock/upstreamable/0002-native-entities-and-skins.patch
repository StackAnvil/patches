+
+@Pseudo
+@Mixin(targets = "net.irisshaders.iris.gl.program.ProgramSamplers$Builder", remap = false)
+public abstract class MixinIrisMaskReservation {
+    @ModifyVariable(method = "<init>", at = @At(value = "INVOKE", target = "Ljava/lang/Object;<init>()V", shift = Shift.AFTER), argsOnly = true)
+    private Set<Integer> bedrock$reserveMask(final Set<Integer> reserved, @Local(argsOnly = true) final int program) {
+        if (GL46C.glGetUniformLocation(program, BedrockIrisMaskedTexture.SAMPLER) < 0) return reserved;
+        final Set<Integer> result = new HashSet<>(reserved);
+        result.add(BedrockIrisMaskedTexture.UNIT);
+        return Set.copyOf(result);
+    }
+}
