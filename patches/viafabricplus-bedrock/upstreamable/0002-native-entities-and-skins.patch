+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import java.util.Set;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.core.Direction;
+import org.joml.Vector3f;
+
+/** Native polygons remain authoritative after construction, including per-face UVs and poly meshes. */
+final class BedrockModelCube extends ModelPart.Cube {
+    BedrockModelCube(final float x, final float y, final float z, final float sizeX, final float sizeY, final float sizeZ,
+                     final float inflate, final boolean mirror, final float width, final float height, final Set<Direction> faces) {
+        super(0, 0, x, y, z, sizeX, sizeY, sizeZ, inflate, inflate, inflate, mirror, width, height, faces);
+    }
+
+    @Override
+    public void compile(final PoseStack.Pose pose, final VertexConsumer consumer, final int light, final int overlay, final int color) {
+        final Vector3f transformed = new Vector3f();
+        for (final ModelPart.Polygon polygon : this.polygons) {
+            pose.transformNormal(polygon.normal(), transformed);
+            final float normalX = transformed.x, normalY = transformed.y, normalZ = transformed.z;
+            for (final ModelPart.Vertex vertex : polygon.vertices()) {
+                pose.pose().transformPosition(vertex.worldX(), vertex.worldY(), vertex.worldZ(), transformed);
+                consumer.addVertex(transformed.x, transformed.y, transformed.z, color, vertex.u(), vertex.v(), overlay, light,
+                        normalX, normalY, normalZ);
+            }
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTagAnchors.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTagAnchors.java
