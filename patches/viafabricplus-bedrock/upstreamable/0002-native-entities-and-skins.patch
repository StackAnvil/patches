+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.client.renderer.entity.state.EntityRenderState;
+import org.junit.jupiter.api.Test;
+import org.joml.Vector3f;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class BedrockEntityRendererTest {
+
+    @Test
+    void ignoresVanillaRenderStates() {
+        final var context = new EntityRendererProvider.Context(
+            null, null, null, null, null, null, null, null, null, null, null
+        );
+        final var renderer = new BedrockEntityRenderer(context);
+
+        assertDoesNotThrow(() -> renderer.submit(new EntityRenderState(), null, null, null));
+    }
+
+    @Test
+    void scalesGeometryAroundNativeActorOrigin() {
+        for (float scale : new float[]{1F, 1.7F, 5F, 0F, -2F}) {
+            final PoseStack poses = new PoseStack();
+            poses.translate(12F, 34F, 56F);
+            BedrockEntityRenderer.applyActorTransform(poses, 180F, scale);
+
+            // BedrockGeometry places the native origin at Java model Y=24/16.
+            final Vector3f origin = poses.last().pose().transformPosition(new Vector3f(0F, 1.5F, 0F));
+            assertEquals(12F, origin.x, 0.00001F);
+            assertEquals(34F, origin.y, 0.00001F);
+            assertEquals(56F, origin.z, 0.00001F);
+
+            final Vector3f vertex = poses.last().pose().transformPosition(new Vector3f(-1F, 0.5F, 1F));
+            assertEquals(12F + scale, vertex.x, 0.00001F);
+            assertEquals(34F + scale, vertex.y, 0.00001F);
+            assertEquals(56F + scale, vertex.z, 0.00001F);
+        }
+    }
+
+}
