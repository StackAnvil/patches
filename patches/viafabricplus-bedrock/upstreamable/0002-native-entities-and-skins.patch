+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.List;
+import net.minecraft.client.renderer.entity.state.AvatarRenderState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockPlayerMaterialsTest {
+    @Test
+    void keepsSpectatorTranslucentAndHiddenOutlineRoutes() {
+        final var state = new AvatarRenderState();
+        assertTrue(BedrockPlayerRenderer.usesNativeMaterial(state, true, false));
+        assertFalse(BedrockPlayerRenderer.usesNativeMaterial(state, false, false));
+        assertFalse(BedrockPlayerRenderer.usesNativeMaterial(state, false, true));
+        assertFalse(BedrockPlayerRenderer.usesNativeMaterial(state, true, true));
+        state.isSpectator = true;
+        assertFalse(BedrockPlayerRenderer.usesNativeMaterial(state, true, false));
+        assertFalse(BedrockPlayerRenderer.usesNativeMaterial(state, false, true));
+    }
+
+    @Test
+    void selectsNativeOpaqueNocullSkinPipelinesWithImmutableDimensionLighting() {
+        final var overworld = BedrockActorRenderTypes.selectPipeline(false, false, false, false);
+        final var nether = BedrockActorRenderTypes.selectPipeline(false, false, false, true);
+        assertNotSame(overworld, nether);
+        assertSame(overworld, BedrockActorRenderTypes.selectPipeline(false, false, false, false));
+        for (final var pipeline : List.of(overworld, nether)) {
+            assertFalse(pipeline.isCull());
+            assertTrue(pipeline.getDepthStencilState().writeDepth());
+            assertEquals(1, pipeline.getColorTargetStates().size());
+            assertTrue(pipeline.getColorTargetStates().getFirst().blendFunction().isEmpty());
+        }
+        assertSame(BedrockActorRenderTypes.selectPipeline(false, true, false, false),
+            BedrockActorRenderTypes.selectPipeline(false, true, false, true));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockSkinQueueTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockSkinQueueTest.java
