+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.injection.mixin.compat.iris;
+
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import com.mojang.renderpearl.backend.opengl.GlProgram;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.render.compat.iris.BedrockIrisEmission;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import net.irisshaders.iris.gl.blending.AlphaTest;
+import net.irisshaders.iris.gl.state.FogMode;
+import net.irisshaders.iris.pipeline.programs.ShaderKey;
+import net.irisshaders.iris.pipeline.programs.ShaderSupplier;
+import net.irisshaders.iris.pipeline.transform.Patch;
+import net.irisshaders.iris.shaderpack.loading.ProgramId;
+import net.irisshaders.iris.shaderpack.programs.ProgramFallbackResolver;
+import net.irisshaders.iris.shaderpack.programs.ProgramSource;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Pseudo;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+
+@Pseudo
+@Mixin(targets = "net.irisshaders.iris.pipeline.IrisRenderingPipeline", remap = false)
+public abstract class MixinIrisEmissionPrograms implements BedrockIrisEmission {
+    @Shadow @Final private ProgramFallbackResolver resolver;
+    @Shadow @Final private Set<GlProgram> loadedShaders;
+    @Unique private final Map<BedrockIrisEmission.Key, GlProgram> bedrock$emissionPrograms = new HashMap<>();
+    @Unique private final Set<BedrockIrisEmission.Key> bedrock$unsupportedEmission = new HashSet<>();
+
+    @Shadow
+    protected abstract ShaderSupplier createShader(String name, ShaderKey key, ProgramSource source, ProgramId program,
+            AlphaTest alpha, VertexFormat format, FogMode fog, boolean intensity, boolean ignoreLightmap,
+            boolean glint, boolean text, boolean fullbright, Patch patch) throws IOException;
+
+    @Override
+    public GlProgram bedrock$emissionProgram(final ShaderKey body, final ShaderKey eyeKey) {
+        final var selection = new BedrockIrisEmission.Key(body, eyeKey);
+        if (this.bedrock$unsupportedEmission.contains(selection)) return null;
+        final GlProgram cached = this.bedrock$emissionPrograms.get(selection);
+        if (cached != null) return cached;
+        final var vertex = this.resolver.resolveNullable(body.getProgram());
+        final var eye = this.resolver.resolveNullable(eyeKey.getProgram());
+        if (vertex == null || eye == null) {
+            this.bedrock$unsupportedEmission.add(selection);
+            return null;
+        }
+        try {
+            // Retain every geometry-producing stage, attribute decision and deformation from the body.
+            // The eye fragment and its framebuffer directives retain the pack's radiance output.
+            final String name = "bedrock_emission_" + body.getName() + "_" + eyeKey.getName();
+            final var source = IrisProgramSourceConstructor.bedrock$create(name,
+                    vertex.getVertexSource().orElse(null), vertex.getGeometrySource().orElse(null),
+                    vertex.getTessControlSource().orElse(null), vertex.getTessEvalSource().orElse(null),
+                    eye.getFragmentSource().orElse(null), eye.getDirectives(), eye.getParent());
+            final GlProgram program = this.createShader(name, eyeKey, source, eyeKey.getProgram(), eyeKey.getAlphaTest(),
+                    body.getVertexFormat(), body.getFogMode(), body.isIntensity(), body.shouldIgnoreLightmap(),
+                    body.isGlint(), body.isText(), false, body.patch).shader().get();
+            this.loadedShaders.add(program);
+            this.bedrock$emissionPrograms.put(selection, program);
+            return program;
+        } catch (IOException | RuntimeException incompatible) {
+            this.bedrock$unsupportedEmission.add(selection);
+            ViaFabricPlusBedrock.impl().logger().warn("Could not pair native emission with shader body {}", body, incompatible);
+            return null;
+        }
+    }
+}
