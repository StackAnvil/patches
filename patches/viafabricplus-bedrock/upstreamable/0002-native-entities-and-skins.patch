index 0000000..e04661c
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderPipelinesTest.java
@@ -0,0 +1,89 @@
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockShaderPipelinesTest {
+    @Test
+    void mapsEveryActorMaterialToTheMatchingShaderFamilyWithoutChangingNativeState() {
+        for (final boolean alphaTest : new boolean[] {false, true})
+            for (final boolean cull : new boolean[] {false, true})
+                for (final boolean unlit : new boolean[] {false, true})
+                    for (final boolean emissive : new boolean[] {false, true})
+                        for (final boolean nether : new boolean[] {false, true}) {
+                            final var material = new BedrockActorMaterialDefinitions.Material(alphaTest, cull, emissive, false, false);
+                            final var actor = BedrockActorRenderTypes.selectPipeline(material, unlit, nether);
+                            final var expected = emissive ? RenderPipelines.EYES
+                                : !alphaTest ? RenderPipelines.ENTITY_SOLID
+                                : unlit ? RenderPipelines.ENTITY_CUTOUT_Z_OFFSET
+                                : cull ? RenderPipelines.ENTITY_CUTOUT_CULL : RenderPipelines.ENTITY_CUTOUT;
+                            assertSame(expected, BedrockShaderPipelines.equivalent(actor));
+                            if (!alphaTest || emissive) assertTrue(Float.isNaN(BedrockShaderPipelines.alphaReference(actor)));
+                            else assertEquals(0.5F, BedrockShaderPipelines.alphaReference(actor));
+                            assertEquals(expected.getVertexFormatBindings(), actor.getVertexFormatBindings());
+                            assertEquals(cull, actor.isCull());
+                            assertTrue(actor.getDepthStencilState().writeDepth());
+                            assertEquals(RenderPipelines.ENTITY_SOLID.getDepthStencilState().depthTest(), actor.getDepthStencilState().depthTest());
+                            assertTrue(actor.getColorTargetStates().getFirst().blendFunction().isEmpty());
+                            assertSame(actor, BedrockActorRenderTypes.selectPipeline(material, unlit, nether));
+                        }
+    }
+
+    @Test
+    void bypassesWorldLightWithoutChangingOrdinaryActorLight() {
+        for (final int light : new int[] {0, 0x80, 0x900050, net.minecraft.util.LightCoordsUtil.FULL_BRIGHT}) {
+            assertEquals(light, BedrockActorRenderTypes.lightCoords(light, false));
+            assertEquals(net.minecraft.util.LightCoordsUtil.FULL_BRIGHT, BedrockActorRenderTypes.lightCoords(light, true));
+        }
+    }
+
+    @Test
+    void associatesEveryWorldEmissionPipelineWithItsExactBody() {
+        final var bodies = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<RenderPipeline, Boolean>());
+        for (final var emission : BedrockShaderEmission.PIPELINES) {
+            final var body = BedrockShaderEmission.bodyPipeline(emission);
+            assertNotNull(body);
+            assertTrue(bodies.add(body));
+            assertFalse(body.getShaderDefines().flags().contains("USE_EMISSIVE"));
+            assertFalse(body.getShaderDefines().flags().contains("GUI_PORTRAIT"));
+            assertEquals(body.isCull(), emission.isCull());
+            assertFalse(emission.getDepthStencilState().writeDepth());
+            assertTrue(emission.getColorTargetStates().getFirst().blendFunction().isPresent());
+            assertNull(BedrockShaderEmission.bodyPipeline(body));
+        }
+        assertEquals(12, bodies.size());
+        assertNull(BedrockShaderEmission.bodyPipeline(null));
+    }
+
+    @Test
+    void restoresCompilationContextAfterNestedLookupsAndFailures() {
+        assertNull(BedrockShaderPipelines.compiling());
+        final var body = BedrockActorRenderTypes.PIPELINES.getFirst();
+        final var emission = BedrockShaderEmission.PIPELINES.getFirst();
+        BedrockShaderPipelines.compiling(body, () -> {
+            assertSame(body, BedrockShaderPipelines.compiling());
+            assertThrows(IllegalStateException.class, () -> BedrockShaderPipelines.compiling(emission, () -> {
+                assertSame(emission, BedrockShaderPipelines.compiling());
+                throw new IllegalStateException();
+            }));
+            assertSame(body, BedrockShaderPipelines.compiling());
+            return null;
+        });
+        assertNull(BedrockShaderPipelines.compiling());
+    }
+
+    @Test
+    void leavesUnregisteredPipelinesAndSeparatelyBuiltPipelinesUnchanged() {
+        assertSame(RenderPipelines.ENTITY_CUTOUT, BedrockShaderPipelines.equivalent(RenderPipelines.ENTITY_CUTOUT));
+        final var custom = RenderPipeline.builder(RenderPipelines.ENTITY_SNIPPET)
+            .withLocation(Identifier.fromNamespaceAndPath("test", "shader_equivalent")).build();
+        assertSame(custom, BedrockShaderPipelines.equivalent(custom));
+        assertTrue(Float.isNaN(BedrockShaderPipelines.alphaReference(custom)));
+        assertSame(custom, BedrockShaderPipelines.register(custom, RenderPipelines.EYES));
+        assertSame(RenderPipelines.EYES, BedrockShaderPipelines.equivalent(custom));
+    }
+}
