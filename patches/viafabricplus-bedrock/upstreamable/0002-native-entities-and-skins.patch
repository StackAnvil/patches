@@ -0,0 +1,48 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.function.Supplier;
+
+/** Reuses resolved draws only while the authoritative snapshot and rendering inputs are unchanged. */
+final class BedrockRenderSnapshotCache<K, S, V> {
+    private final Map<K, Entry<S, V>> entries;
+
+    BedrockRenderSnapshotCache(final int maximumEntries) {
+        if (maximumEntries <= 0) throw new IllegalArgumentException("Invalid render cache capacity");
+        this.entries = new LinkedHashMap<>(16, 0.75F, true) {
+            @Override
+            protected boolean removeEldestEntry(final Map.Entry<K, Entry<S, V>> eldest) {
+                return this.size() > maximumEntries;
+            }
+        };
+    }
+
+    V resolve(final K owner, final S snapshot, final Object generation, final boolean netherLighting,
+              final Supplier<V> resolver) {
+        final Entry<S, V> cached = this.entries.get(owner);
+        // Snapshot identity avoids comparing entire model/material lists in the render hot path.
+        if (cached != null && cached.snapshot == snapshot && cached.generation == generation
+                && cached.netherLighting == netherLighting) return cached.value;
+        final V value = resolver.get();
+        this.entries.put(owner, new Entry<>(snapshot, generation, netherLighting, value));
+        return value;
+    }
+
+    void remove(final K owner) {
+        this.entries.remove(owner);
+    }
+
+    void clear() {
+        this.entries.clear();
+    }
+
+    private record Entry<S, V>(S snapshot, Object generation, boolean netherLighting, V value) {
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockRidingAnchors.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockRidingAnchors.java
