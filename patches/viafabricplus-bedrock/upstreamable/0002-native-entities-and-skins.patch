+
+final class BedrockPlayerRenderer extends AvatarRenderer<AbstractClientPlayer> {
+
+    private final Map<Boolean, RenderType> nativeMaterials = new HashMap<>();
+
+    BedrockPlayerRenderer(final EntityRendererProvider.Context context, final PlayerModel model, final boolean slim) {
+        super(context, slim);
+        this.model = model;
+    }
+
+    @Override
+    protected RenderType getRenderType(final AvatarRenderState state, final boolean visible, final boolean translucent, final boolean glowing) {
+        if (usesNativeMaterial(state, visible, translucent)) {
+            final boolean netherLighting = BedrockActorRenderTypes.usesNetherLighting();
+            return this.nativeMaterials.computeIfAbsent(netherLighting, _ -> BedrockActorRenderTypes.create(
+                this.getTextureLocation(state), BedrockActorMaterialDefinitions.Material.CUTOUT, false, 1F, BedrockActorUvTransform.IDENTITY, netherLighting));
+        }
+        return super.getRenderType(state, visible, translucent, glowing);
+    }
+
+    static boolean usesNativeMaterial(final AvatarRenderState state, final boolean visible, final boolean translucent) {
+        return visible && !translucent && !state.isSpectator;
+    }
+
+}
