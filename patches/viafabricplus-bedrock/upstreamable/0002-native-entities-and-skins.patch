+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.compat.iris;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderAlpha;
+import org.lwjgl.opengl.GL46C;
+
+/** Locations belong to one program; values belong to each pipeline bind. */
+public final class BedrockIrisAlphaUniforms {
+    private final int enabled;
+    private final int reference;
+    private final int sampler;
+    private final int masked;
+    private final int maskSampler;
+
+    public BedrockIrisAlphaUniforms(final int program) {
+        this.enabled = GL46C.glGetUniformLocation(program, BedrockIrisAlpha.ENABLED);
+        this.reference = GL46C.glGetUniformLocation(program, BedrockIrisAlpha.REFERENCE);
+        this.sampler = GL46C.glGetUniformLocation(program, BedrockIrisAlpha.SAMPLER);
+        this.masked = GL46C.glGetUniformLocation(program, BedrockIrisMaskedTexture.ENABLED);
+        this.maskSampler = GL46C.glGetUniformLocation(program, BedrockIrisMaskedTexture.SAMPLER);
+    }
+
+    /** Call after Iris updates uniforms and samplers, while this program is current. */
+    public void bind() {
+        final float nativeReference = BedrockShaderAlpha.reference(Float.NaN);
+        GL46C.glUniform1i(this.enabled, Float.isNaN(nativeReference) ? 0 : 1);
+        GL46C.glUniform1f(this.reference, Float.isNaN(nativeReference) ? 0F : nativeReference);
+        // A pack may replace gtexture. This separate sampler always reads the actor's unit zero.
+        GL46C.glUniform1i(this.sampler, 0);
+        GL46C.glUniform1i(this.masked, BedrockShaderAlpha.masked() ? 1 : 0);
+        GL46C.glUniform1i(this.maskSampler, BedrockIrisMaskedTexture.UNIT);
+    }
+}
