+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import java.util.ArrayList;
+import java.util.Set;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.core.Direction;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockModelCubeTest {
+    @Test
+    void compilesAuthoredPolygonsInsteadOfConstructorCuboidsUnderReflectedTransforms() {
+        final var cube = new BedrockModelCube(0, 0, 0, 0, 0, 0, 0, false, 1, 1, Set.of(Direction.NORTH));
+        final ModelPart.Vertex[] vertices = {
+                new ModelPart.Vertex(16, 16, 16, .2F, .3F), new ModelPart.Vertex(32, 16, 16, .4F, .3F),
+                new ModelPart.Vertex(32, 16, 32, .4F, .5F), new ModelPart.Vertex(16, 16, 32, .2F, .5F)};
+        cube.polygons[0] = new ModelPart.Polygon(vertices, new Vector3f(0, 1, 0));
+        final var poses = new PoseStack();
+        poses.translate(2, 3, 4);
+        poses.scale(2, -1, 3);
+        final var consumer = mock(VertexConsumer.class);
+        final var emitted = new ArrayList<float[]>();
+        doAnswer(call -> {
+            emitted.add(new float[] {call.getArgument(0), call.getArgument(1), call.getArgument(2),
+                    call.getArgument(4), call.getArgument(5), call.getArgument(8), call.getArgument(9), call.getArgument(10)});
+            assertEquals(0x12345678, (int) call.getArgument(3));
+            assertEquals(23, (int) call.getArgument(6));
+            assertEquals(42, (int) call.getArgument(7));
+            return null;
+        }).when(consumer).addVertex(anyFloat(), anyFloat(), anyFloat(), anyInt(), anyFloat(), anyFloat(), anyInt(), anyInt(), anyFloat(), anyFloat(), anyFloat());
+        new ModelPart(java.util.List.of(cube), java.util.Map.of()).render(poses, consumer, 42, 23, 0x12345678);
+        assertEquals(4, emitted.size());
+        assertArrayEquals(new float[] {4, 2, 7, .2F, .3F, 0, -1, 0}, emitted.getFirst(), .00001F);
+        assertArrayEquals(new float[] {6, 2, 10, .4F, .5F, 0, -1, 0}, emitted.get(2), .00001F);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTagAnchorsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTagAnchorsTest.java
