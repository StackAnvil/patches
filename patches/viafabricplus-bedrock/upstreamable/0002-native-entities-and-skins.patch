+                                    final @Nullable Vec3 attachment, final int offset, final Component name,
+                                    final boolean seeThrough, final int light, final CameraRenderState camera,
+                                    final Operation<Void> original) {
+        final boolean bedrock = BedrockNameTagAnchors.enabled(ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST));
+        original.call(collector, poses, attachment, offset, name, seeThrough,
+                bedrock ? BedrockNameTagAnchors.light(!seeThrough, light) : light, camera);
+    }
+}
