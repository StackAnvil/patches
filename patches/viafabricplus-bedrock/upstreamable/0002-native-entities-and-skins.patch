+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockAcceptedResourcesTest {
+
+    @AfterEach
+    void clear() {
+        BedrockAcceptedResources.clear();
+    }
+
+    @Test
+    void sharesTheHighestAcceptedArchiveBetweenActorAndEffectConsumers() throws Exception {
+        final var lowerOpens = new AtomicInteger();
+        final var upperOpens = new AtomicInteger();
+        final var localOpens = new AtomicInteger();
+        final var manager = resources(List.of(resource(PackSource.SERVER, archive((byte) 1), lowerOpens),
+                resource(PackSource.SERVER, archive((byte) 2), upperOpens),
+                resource(PackSource.DEFAULT, archive((byte) 3), localOpens)));
+        final var actors = BedrockAcceptedResources.layers(manager);
+        final var effects = NativeActorLibrary.effects(BedrockAcceptedResources.layers(manager));
+        assertSame(actors, BedrockAcceptedResources.layers(manager));
+        assertEquals(List.of(false, true), actors.stream().map(NativeActorLibrary.Layer::server).toList());
+        assertTrue(effects.getFirst().isEmpty());
+        assertArrayEquals(new byte[]{2}, effects.getLast().get("textures/shared.png"));
+        assertEquals(0, lowerOpens.get());
+        assertEquals(1, upperOpens.get());
+        assertEquals(0, localOpens.get());
+    }
+
+    @Test
+    void reloadAndResourceManagerReplacementDiscardDecodedLayers() throws Exception {
+        final var opens = new AtomicInteger();
+        final var manager = resources(List.of(resource(PackSource.SERVER, archive((byte) 1), opens)));
+        final var first = BedrockAcceptedResources.layers(manager);
+        BedrockAcceptedResources.clear();
+        assertNotSame(first, BedrockAcceptedResources.layers(manager));
+        assertEquals(2, opens.get());
+        final var replacement = resources(List.of(resource(PackSource.SERVER, archive((byte) 2), opens)));
+        assertArrayEquals(new byte[]{2}, BedrockAcceptedResources.layers(replacement).getLast().resources().get("textures/shared.png"));
+        assertEquals(3, opens.get());
+    }
+
+    @Test
+    void retainsDecodeErrorsUntilReloadAndThenRetriesTheAcceptedArchive() throws Exception {
+        final var opens = new AtomicInteger();
+        final var bytes = new AtomicReference<>(new byte[]{1, 2});
+        final var manager = resources(List.of(resource(PackSource.SERVER, bytes, opens)));
+        assertThrows(IOException.class, () -> BedrockAcceptedResources.layers(manager));
+        bytes.set(archive((byte) 4).get());
+        assertThrows(IOException.class, () -> BedrockAcceptedResources.layers(manager));
+        assertEquals(1, opens.get());
+        BedrockAcceptedResources.clear();
+        assertEquals(2, BedrockAcceptedResources.layers(manager).size());
+        assertEquals(2, opens.get());
+    }
+
+    @Test
+    void ignoresLocalResourcesAndAllowsNoAcceptedArchive() throws Exception {
+        final var opens = new AtomicInteger();
+        assertTrue(BedrockAcceptedResources.layers(resources(List.of())).isEmpty());
+        assertTrue(BedrockAcceptedResources.layers(resources(List.of(resource(PackSource.DEFAULT, new AtomicReference<>(new byte[]{1}), opens)))).isEmpty());
+        assertEquals(0, opens.get());
+    }
+
+    private static AtomicReference<byte[]> archive(final byte texture) throws IOException {
+        final InMemoryContent lower = new InMemoryContent();
+        final InMemoryContent upper = new InMemoryContent();
+        for (final var content : List.of(lower, upper)) {
+            content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                    + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        }
+        upper.put("textures/shared.png", new byte[]{texture});
+        final var packs = List.of(new ResourcePack(lower), new ResourcePack(upper));
+        return new AtomicReference<>(NativeActorLibrary.encode(packs, pack -> pack == packs.getLast()));
+    }
+
+    private static Resource resource(final PackSource source, final AtomicReference<byte[]> bytes, final AtomicInteger opens) {
+        final var location = new PackLocationInfo("test", Component.empty(), source, Optional.empty());
+        final var pack = (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class[]{PackResources.class},
+                (proxy, method, arguments) -> method.getName().equals("location") ? location : null);
+        return new Resource(pack, () -> {
+            opens.incrementAndGet();
+            return new ByteArrayInputStream(bytes.get());
+        });
+    }
+
+    private static ResourceManager resources(final List<Resource> stack) {
+        return (ResourceManager) Proxy.newProxyInstance(ResourceManager.class.getClassLoader(), new Class[]{ResourceManager.class},
+                (proxy, method, arguments) -> method.getName().equals("getResourceStack") ? stack : null);
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialDefinitionsTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialDefinitionsTest.java
