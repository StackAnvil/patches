+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.awt.image.BufferedImage;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockSkinQueueTest {
+    @Test
+    void retainsEveryConfigurationUpdateInOrderUntilTheMatchingPlayListenerExists() {
+        final var queue = new BedrockSkinQueue();
+        final var channel = new EmbeddedChannel();
+        try {
+            final UserConnection connection = connection(channel);
+            final UUID player = UUID.randomUUID();
+            final SkinData first = skin(0xFFFF0000), second = skin(0xFF0000FF);
+            final List<SkinData> installed = new ArrayList<>();
+            queue.add(connection, player, first);
+            queue.add(connection, player, second);
+            queue.drain(null, (_, skin) -> installed.add(skin));
+            assertTrue(installed.isEmpty());
+            queue.discardDisconnected();
+            queue.drain(connection, (id, skin) -> {
+                assertEquals(player, id);
+                installed.add(skin);
+            });
+            assertEquals(List.of(first, second), installed);
+            queue.drain(connection, (_, skin) -> fail("A drained update was installed again"));
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    void keepsReconnectsSeparateAndDiscardsUpdatesFromClosedConnections() {
+        final var queue = new BedrockSkinQueue();
+        final var oldChannel = new EmbeddedChannel();
+        final var newChannel = new EmbeddedChannel();
+        try {
+            final UserConnection oldConnection = connection(oldChannel), newConnection = connection(newChannel);
+            final UUID player = UUID.randomUUID();
+            final SkinData oldSkin = skin(0xFFFF0000), newSkin = skin(0xFF0000FF);
+            final List<SkinData> installed = new ArrayList<>();
+            queue.add(oldConnection, player, oldSkin);
+            queue.add(newConnection, player, newSkin);
+            queue.drain(newConnection, (_, skin) -> installed.add(skin));
+            assertEquals(List.of(newSkin), installed);
+            oldChannel.close();
+            queue.add(oldConnection, player, oldSkin);
+            queue.drain(oldConnection, (_, skin) -> fail("A disconnected skin crossed into the replacement connection"));
+        } finally {
+            oldChannel.finishAndReleaseAll();
+            newChannel.finishAndReleaseAll();
+        }
+    }
+
+    private static UserConnection connection(final EmbeddedChannel channel) {
+        return (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(), new Class<?>[]{UserConnection.class},
+                (_, method, _) -> {
+                    if (method.getName().equals("getChannel")) return channel;
+                    throw new UnsupportedOperationException(method.getName());
+                });
+    }
+
+    private static SkinData skin(final int color) {
+        final var image = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(0, 0, color);
+        return new SkinData("", "", "", image, List.of(), null, "", "", "", false, false, false, false,
+                "", "", "wide", "", List.of(), List.of(), false, "", "");
+    }
+}
