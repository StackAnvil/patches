+        final Operation<Map<EntityType<?>, EntityRenderer<?, ?>>> original
+    ) {
+        final Map<EntityType<?>, EntityRenderer<?, ?>> renderers = original.call(context);
+        this.stackanvil$bedrockRenderer = new BedrockEntityRenderer(context);
+        BedrockPlayerSkins.rendererContext(context);
+        return renderers;
+    }
+
+    @SuppressWarnings("unchecked")
