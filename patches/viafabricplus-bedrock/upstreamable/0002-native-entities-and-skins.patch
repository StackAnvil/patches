+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+public final class BedrockActorMaterials {
+    private BedrockActorMaterials() {
+    }
+
+    public static Map<String, Set<String>> partition(final Iterable<String> bones, final Map<String, String> materials) {
+        final Map<String, Set<String>> result = new LinkedHashMap<>();
+        for (String bone : bones) {
+            String material = "";
+            for (var selection : materials.entrySet()) {
+                if (matches(selection.getKey(), bone)) {
+                    material = selection.getValue();
+                }
+            }
+            result.computeIfAbsent(material, _ -> new LinkedHashSet<>()).add(bone);
+        }
+        result.replaceAll((_, selected) -> Set.copyOf(selected));
+        return result;
+    }
+
+    static boolean matches(final String pattern, final String bone) {
+        int patternIndex = 0;
+        int boneIndex = 0;
+        int star = -1;
+        int retry = 0;
+        while (boneIndex < bone.length()) {
+            if (patternIndex < pattern.length() && pattern.charAt(patternIndex) == bone.charAt(boneIndex)) {
+                patternIndex++;
+                boneIndex++;
+            } else if (patternIndex < pattern.length() && pattern.charAt(patternIndex) == '*') {
+                star = patternIndex++;
+                retry = boneIndex;
+            } else if (star != -1) {
+                patternIndex = star + 1;
+                boneIndex = ++retry;
+            } else {
+                return false;
+            }
+        }
+        while (patternIndex < pattern.length() && pattern.charAt(patternIndex) == '*') {
+            patternIndex++;
+        }
+        return patternIndex == pattern.length();
+    }
+}
