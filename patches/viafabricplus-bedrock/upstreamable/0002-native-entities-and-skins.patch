@@ -0,0 +1,56 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+
+public final class BedrockActorMaterials {
+    private BedrockActorMaterials() {
+    }
+
+    public static Map<String, Set<String>> partition(final Iterable<String> bones, final Map<String, String> materials) {
+        final Map<String, Set<String>> result = new LinkedHashMap<>();
+        for (String bone : bones) {
+            String material = "";
+            for (var selection : materials.entrySet()) {
+                if (matches(selection.getKey(), bone)) {
+                    material = selection.getValue();
+                }
+            }
+            result.computeIfAbsent(material, _ -> new LinkedHashSet<>()).add(bone);
+        }
+        result.replaceAll((_, selected) -> Set.copyOf(selected));
+        return result;
+    }
+
+    static boolean matches(final String pattern, final String bone) {
+        int patternIndex = 0;
+        int boneIndex = 0;
+        int star = -1;
+        int retry = 0;
+        while (boneIndex < bone.length()) {
+            if (patternIndex < pattern.length() && pattern.charAt(patternIndex) == bone.charAt(boneIndex)) {
+                patternIndex++;
+                boneIndex++;
+            } else if (patternIndex < pattern.length() && pattern.charAt(patternIndex) == '*') {
+                star = patternIndex++;
+                retry = boneIndex;
+            } else if (star != -1) {
+                patternIndex = star + 1;
+                boneIndex = ++retry;
+            } else {
+                return false;
+            }
+        }
+        while (patternIndex < pattern.length() && pattern.charAt(patternIndex) == '*') {
+            patternIndex++;
+        }
+        return patternIndex == pattern.length();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorRenderTypes.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorRenderTypes.java
new file mode 100644
index 0000000..25e7542
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorRenderTypes.java
@@ -0,0 +1,116 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.pipeline.BindGroupLayout;
+import com.mojang.renderpearl.api.pipeline.UniformType;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockActorRenderType;
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.BindGroupLayouts;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.level.Level;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+public final class BedrockActorRenderTypes {
+    private static final java.util.Map<PipelineKey, RenderPipeline> MATERIAL_PIPELINES = pipelines();
+    public static final List<RenderPipeline> PIPELINES = List.copyOf(MATERIAL_PIPELINES.values());
+
+    private BedrockActorRenderTypes() {}
+
+    private static java.util.Map<PipelineKey, RenderPipeline> pipelines() {
+        final var result = new java.util.LinkedHashMap<PipelineKey, RenderPipeline>();
+        for (final boolean alphaTest : new boolean[] {false, true})
+            for (final boolean cull : new boolean[] {false, true})
+                for (final boolean unlit : new boolean[] {false, true})
+                    for (final boolean emissive : new boolean[] {false, true})
+                        for (final boolean nether : new boolean[] {false, true})
+                            for (final boolean masked : new boolean[] {false, true}) {
+                            if (unlit && nether || masked && (!alphaTest || emissive)) continue;
+                            final var key = new PipelineKey(alphaTest, cull, unlit, emissive, nether, masked);
+                            result.put(key, pipeline(key));
+                        }
+        return java.util.Collections.unmodifiableMap(result);
+    }
+
+    private static RenderPipeline pipeline(final PipelineKey key) {
+        final var builder = RenderPipeline.builder(RenderPipelines.ENTITY_SNIPPET)
+            .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/actor_" + key.alphaTest + "_" + key.cull + "_" + key.unlit + "_" + key.emissive + "_" + key.nether + (key.masked ? "_masked" : "")))
+            .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_actor"))
+            .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_actor"))
+            .withBindGroupLayout(BindGroupLayouts.SAMPLER1)
+            .withColorTargetState(ColorTargetState.DEFAULT)
+            .withCull(key.cull);
+        if (key.masked) builder.withShaderDefine("MASKED_MULTITEXTURE")
+            .withBindGroupLayout(BindGroupLayout.builder().withUniform("BedrockMaskTexture", UniformType.COMBINED_IMAGE_SAMPLER).build());
+        if (key.alphaTest) builder.withShaderDefine("ALPHA_TEST");
+        if (key.unlit) builder.withShaderDefine("IGNORE_LIGHTING");
+        if (key.nether) builder.withShaderDefine("NETHER_LIGHTING");
+        if (key.emissive) builder.withShaderDefine("USE_EMISSIVE");
+        final var shaderPipeline = key.emissive ? RenderPipelines.EYES
+            : !key.alphaTest ? RenderPipelines.ENTITY_SOLID
+            : key.unlit ? RenderPipelines.ENTITY_CUTOUT_Z_OFFSET
+            : key.cull ? RenderPipelines.ENTITY_CUTOUT_CULL : RenderPipelines.ENTITY_CUTOUT;
+        return BedrockShaderPipelines.register(builder.build(), shaderPipeline,
+                key.alphaTest && !key.emissive ? 0.5F : Float.NaN);
+    }
+
+    public static int lightCoords(final int light, final boolean ignoreLighting) {
+        return ignoreLighting ? net.minecraft.util.LightCoordsUtil.FULL_BRIGHT : light;
+    }
+
+    public static boolean usesNetherLighting() {
+        final var connection = ViaFabricPlus.api().userConnection();
+        if (connection != null && connection.has(ChunkTracker.class)) {
+            return connection.get(ChunkTracker.class).getDimension() == Dimension.NETHER;
+        }
+        // A Java connection through ViaProxy retains the canonical dimension identity.
+        final var level = Minecraft.getInstance().level;
+        return level != null && level.dimension().equals(Level.NETHER);
+    }
+
+    public static RenderType create(final List<Identifier> textures, final BedrockActorMaterialDefinitions.Material material, final boolean ignoreLighting, final float multiplier, final BedrockActorUvTransform uv, final boolean netherLighting) {
+        final var setup = textures(RenderSetup.builder(selectPipeline(material, ignoreLighting, netherLighting)), textures, material);
+        final RenderType type = RenderType.create("bedrock_actor", setup.useLightmap().useOverlay().createRenderSetup());
+        ((IBedrockActorRenderType) type).bedrock$lightColorMultiplier(multiplier);
+        ((IBedrockActorRenderType) type).bedrock$uvTransform(uv);
+        if (material.emissive()) BedrockShaderEmission.register(type, textures.getFirst(), material, ignoreLighting, multiplier, uv, netherLighting);
+        return type;
+    }
+
+    static RenderPipeline selectPipeline(final BedrockActorMaterialDefinitions.Material material,
+                                         final boolean ignoreLighting, final boolean netherLighting) {
+        return MATERIAL_PIPELINES.get(new PipelineKey(material.alphaTest(), material.cull(), ignoreLighting,
+                material.emissive(), netherLighting && !ignoreLighting, material.masked()));
+    }
+
+    private static RenderSetup.RenderSetupBuilder textures(final RenderSetup.RenderSetupBuilder setup,
+            final List<Identifier> textures, final BedrockActorMaterialDefinitions.Material material) {
+        if (textures.size() < material.textureCount()) throw new IllegalArgumentException("Missing material sampler binding");
+        if (material.masked()) {
+            setup.withTexture("Sampler0", textures.getFirst(), () -> clampedSampler(textures.getFirst()));
+            setup.withTexture("BedrockMaskTexture", textures.get(1), () -> clampedSampler(textures.get(1)));
+        } else setup.withTexture("Sampler0", textures.getFirst());
+        return setup;
+    }
+
+    private static com.mojang.renderpearl.api.textures.GpuSampler clampedSampler(final Identifier texture) {
+        final var original = Minecraft.getInstance().getTextureManager().getTexture(texture).getSampler();
+        return com.mojang.blaze3d.systems.RenderSystem.getSamplerCache().getSampler(
+                com.mojang.renderpearl.api.textures.AddressMode.CLAMP_TO_EDGE,
+                com.mojang.renderpearl.api.textures.AddressMode.CLAMP_TO_EDGE,
+                original.getMinFilter(), original.getMagFilter(), original.getMaxLod().isEmpty());
+    }
+
+    private record PipelineKey(boolean alphaTest, boolean cull, boolean unlit, boolean emissive, boolean nether, boolean masked) {}
+}
