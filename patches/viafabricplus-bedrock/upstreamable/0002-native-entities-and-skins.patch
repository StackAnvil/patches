+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderAlpha;
+import com.viaversion.viafabricplus.bedrock.render.compat.iris.BedrockIrisAlphaUniforms;
+import org.lwjgl.opengl.GL46C;
+import org.spongepowered.asm.mixin.Mixin;
