+ */
+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.math.Axis;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.render.CustomEntityRenderStore.RenderData;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.LinkedHashMap;
+import java.util.Set;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.model.Model;
+import net.minecraft.client.renderer.SubmitNodeCollector;
+import net.minecraft.client.renderer.culling.Frustum;
+import net.minecraft.client.renderer.entity.EntityRenderer;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.client.renderer.entity.state.EntityRenderState;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.renderer.rendertype.RenderTypes;
+import net.minecraft.client.renderer.state.level.CameraRenderState;
+import net.minecraft.client.renderer.texture.OverlayTexture;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.entity.Interaction;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import net.raphimc.viabedrock.api.util.StringUtil;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+
+/** Renders ViaBedrock custom actors while leaving ordinary interactions invisible. */
+public final class BedrockEntityRenderer extends EntityRenderer<Interaction, EntityRenderState> {
+
+    private final Map<ModelKey, Model<EntityRenderState>> models = new HashMap<>();
+    private final BedrockRenderSnapshotCache<UUID, RenderData, List<RenderedModel>> resolvedModels = new BedrockRenderSnapshotCache<>(1024);
+    private final Map<MaterialKey, RenderType> renderTypes = new LinkedHashMap<>(16, 0.75F, true) {
+        @Override
+        protected boolean removeEldestEntry(final Map.Entry<MaterialKey, RenderType> eldest) {
+            // Animated multipliers must not retain a render type for every frame.
+            return this.size() > 256;
+        }
+    };
+    private ResourcePackStorage currentPacks;
+    private BedrockActorMaterialDefinitions materialDefinitions;
+
+    public BedrockEntityRenderer(final EntityRendererProvider.Context context) {
+        super(context);
+    }
+
+    @Override
+    public State createRenderState() {
+        return new State();
+    }
+
+    @Override
+    public boolean shouldRender(final Interaction entity, final Frustum frustum, final double x, final double y, final double z, final float partialTicks) {
+        if (CustomEntityRenderStore.get(entity.getUUID()) != null) {
+            // The renderer supplies camera world coordinates, not entity-relative offsets.
+            return entity.distanceToSqr(x, y, z) <= 96D * 96D;
+        }
+        return super.shouldRender(entity, frustum, x, y, z, partialTicks);
+    }
+
+    @Override
+    public void extractRenderState(final Interaction entity, final EntityRenderState renderState, final float partialTicks) {
+        super.extractRenderState(entity, renderState, partialTicks);
+        if (!(renderState instanceof State state)) {
+            return;
+        }
+        state.models = List.of();
+        state.scale = 1F;
+        final ResourcePackStorage packs = BedrockActorResources.get();
+        if (packs == null) {
+            this.currentPacks = null;
+            this.materialDefinitions = null;
+            this.models.clear();
+            this.renderTypes.clear();
+            this.resolvedModels.clear();
+            return;
+        }
+        final RenderData renderData = CustomEntityRenderStore.get(entity.getUUID());
+        if (renderData == null) {
+            this.resolvedModels.remove(entity.getUUID());
+            return;
+        }
+        if (this.currentPacks != packs) {
+            this.currentPacks = packs;
+            this.materialDefinitions = BedrockActorMaterialDefinitions.load(packs);
+            this.models.clear();
+            this.renderTypes.clear();
+            this.resolvedModels.clear();
+        }
+        final boolean netherLighting = BedrockActorRenderTypes.usesNetherLighting();
+        state.models = this.resolvedModels.resolve(entity.getUUID(), renderData, packs, netherLighting,
+                () -> this.resolveModels(renderData, packs, netherLighting));
+        state.scale = renderData.scale();
+        state.yaw = entity.getYRot();
+    }
+
+    private List<RenderedModel> resolveModels(
+        final RenderData renderData,
+        final ResourcePackStorage packs,
+        final boolean netherLighting
+    ) {
+        final List<RenderedModel> resolved = new ArrayList<>();
+        for (var evaluated : renderData.models()) {
+            final BedrockGeometryModel geometry = packs.getModels().entityModels().get(evaluated.geometryValue());
+            if (geometry == null) {
+                ViaFabricPlusBedrock.impl().logger().warn("Unresolved native entity geometry {} for {}", evaluated.geometryValue(), renderData.identifier());
+                continue;
+            }
+            final List<Identifier> textures = evaluated.textureValues().stream().map(value -> Identifier.fromNamespaceAndPath("viabedrock",
+                    "textures/item/entities/" + StringUtil.makeIdentifierValueSafe(value.replace("textures/", "")) + ".png")).toList();
+            final Identifier texture = textures.getFirst();
+            if (Minecraft.getInstance().getResourceManager().getResource(texture).isEmpty()) {
+                ViaFabricPlusBedrock.impl().logger().warn("Unresolved native entity texture {} for {}", evaluated.textureValues().getFirst(), renderData.identifier());
+                continue;
+            }
+            final var materials = BedrockActorMaterials.partition(geometry.getParents().stream().map(parent -> parent.getName()).toList(), evaluated.materials());
+            for (var material : materials.entrySet()) {
+                final ModelKey modelKey = new ModelKey(evaluated.geometryValue(), material.getValue());
+                final Model<EntityRenderState> model = this.models.computeIfAbsent(modelKey, _ -> BedrockGeometry.entityModel(geometry, material.getValue()));
+                final var resolvedMaterial = this.materialDefinitions.material(material.getKey()).filter(value ->
+                        textures.size() >= value.textureCount() && textures.stream().limit(value.textureCount())
+                                .allMatch(id -> Minecraft.getInstance().getResourceManager().getResource(id).isPresent()));
+                final RenderType type;
+                if (resolvedMaterial.isPresent()) {
+                    final MaterialKey key = new MaterialKey(textures, resolvedMaterial.get(), evaluated.ignoreLighting(), evaluated.lightColorMultiplier(), netherLighting);
+                    type = this.renderTypes.computeIfAbsent(key, _ -> BedrockActorRenderTypes.create(key.textures(), key.material(), key.ignoreLighting(), key.multiplier(), BedrockActorUvTransform.IDENTITY, key.netherLighting()));
+                } else {
+                    type = RenderTypes.entityTranslucent(texture);
+                }
+                resolved.add(new RenderedModel(model, type));
+            }
+        }
+        return List.copyOf(resolved);
+    }
+
+    @Override
+    public void submit(final EntityRenderState renderState, final PoseStack poseStack, final SubmitNodeCollector nodes, final CameraRenderState camera) {
+        if (!(renderState instanceof State state)) {
+            return;
+        }
+        for (RenderedModel rendered : state.models) {
+            poseStack.pushPose();
+            applyActorTransform(poseStack, state.yaw, state.scale);
+            nodes.submitModel(rendered.model, state, poseStack, rendered.renderType, state.lightCoords, OverlayTexture.NO_OVERLAY, state.outlineColor);
+            poseStack.popPose();
+        }
+        super.submit(renderState, poseStack, nodes, camera);
+    }
+
+    static void applyActorTransform(final PoseStack poseStack, final float yaw, final float scale) {
+        // Scale around the native actor origin before compensating for the Java model origin.
+        poseStack.scale(scale, scale, scale);
+        poseStack.rotateDegrees(Axis.YP, 180F - yaw);
+        poseStack.scale(-1F, -1F, 1F);
+        poseStack.translate(0F, -1.5F, 0F);
+    }
+
+    public static final class State extends EntityRenderState {
+        private List<RenderedModel> models = List.of();
+        private float yaw;
+        private float scale = 1F;
+    }
+
+    private record ModelKey(String geometry, Set<String> bones) {
+    }
+
+    private record MaterialKey(List<Identifier> textures, BedrockActorMaterialDefinitions.Material material, boolean ignoreLighting, float multiplier, boolean netherLighting) {
+    }
+
+    private record RenderedModel(Model<EntityRenderState> model, RenderType renderType) {
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockGeometry.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockGeometry.java
