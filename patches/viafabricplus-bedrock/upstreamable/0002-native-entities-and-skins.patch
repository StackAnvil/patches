+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeSkinAssembler;
+import net.raphimc.viabedrock.api.model.NativeSkinFragment;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.model.Model;
+import net.minecraft.client.renderer.rendertype.RenderTypes;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.client.renderer.entity.player.AvatarRenderer;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.core.ClientAsset;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.entity.player.PlayerModelType;
+import net.minecraft.world.entity.player.PlayerSkin;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+
+/** Owns client textures and geometry for Bedrock player appearances. */
+public final class BedrockPlayerSkins {
+
+    private static final int MAX_TEXTURE_DIMENSION = 1024;
+    private static final Map<UUID, Appearance> APPEARANCES = new HashMap<>();
+    private static final Map<Identifier, UUID> PLAYER_BY_TEXTURE = new HashMap<>();
+    private static final NativeSkinAssembler SKIN_ASSEMBLER = new NativeSkinAssembler();
+    private static Connection skinConnection;
+    private static volatile EntityRendererProvider.Context rendererContext;
+    private static volatile long rendererEpoch;
+
+    private BedrockPlayerSkins() {
+    }
+
+    /** Accepts the same complete skin transport from direct connections and ViaProxy. */
+    public static void accept(final Connection connection, final NativeSkinFragment fragment) {
+        Minecraft.getInstance().execute(() -> {
+            if (!isCurrent(connection)) return;
+            if (skinConnection != connection) {
+                SKIN_ASSEMBLER.clear();
+                skinConnection = connection;
+            }
+            try {
+                final SkinData skin = SKIN_ASSEMBLER.accept(fragment);
+                if (skin != null) {
+                    final UUID id = fragment.localPlayer()
+                            ? Minecraft.getInstance().getConnection().getLocalGameProfile().id() : fragment.player();
+                    accept(connection, id, skin);
+                }
+            } catch (RuntimeException e) {
+                SKIN_ASSEMBLER.clear();
+                ViaFabricPlusBedrock.impl().logger().warn("Could not receive native player skin", e);
+            }
+        });
+    }
+
+    /** Installs a received or locally selected skin only in the connection that supplied it. */
+    public static void accept(final Connection connection, final UUID playerUuid, final SkinData skin) {
+        if (skin == null || skin.skinData() == null || skin.persona() || !supportedImage(skin.skinData())) {
+            return;
+        }
+        Minecraft.getInstance().execute(() -> {
+            if (isCurrent(connection)) install(playerUuid, skin);
+        });
+    }
+
+    private static boolean isCurrent(final Connection connection) {
+        final var listener = Minecraft.getInstance().getConnection();
+        return connection.isConnected() && listener != null && listener.getConnection() == connection;
+    }
+
+    /** Creates a private menu appearance. Call and close it on the Minecraft thread. */
+    public static Preview preview(final SkinData skin) {
+        if (skin == null || skin.skinData() == null || skin.persona() || !supportedImage(skin.skinData())) {
+            throw new IllegalArgumentException("Invalid skin preview");
+        }
+        final UUID id = UUID.randomUUID();
+        return new Preview(id, install(id, skin));
+    }
+
+    public record Preview(UUID id, PlayerSkin skin) implements AutoCloseable {
+        @Override
+        public void close() {
+            final Appearance appearance = APPEARANCES.remove(this.id);
+            if (appearance != null) {
+                PLAYER_BY_TEXTURE.remove(appearance.bodyId);
+                release(appearance);
+            }
+        }
+    }
+
+    private static PlayerSkin install(final UUID playerUuid, final SkinData skin) {
+        final Appearance previous = APPEARANCES.remove(playerUuid);
+        if (previous != null) {
+            PLAYER_BY_TEXTURE.remove(previous.bodyId);
+            release(previous);
+        }
+        final BedrockGeometryModel geometry = geometry(skin);
+        final Identifier bodyId = textureId(playerUuid, "body");
+        register(bodyId, skin.skinData());
+        final BufferedImage headImage = BedrockSkinImages.javaHeadTexture(skin.skinData(), geometry);
+        final Identifier headId = headImage == skin.skinData() ? bodyId : textureId(playerUuid, "head");
+        if (!headId.equals(bodyId)) register(headId, headImage);
+        final Identifier capeId = supportedImage(skin.capeData()) ? textureId(playerUuid, "cape") : null;
+        if (capeId != null) {
+            register(capeId, skin.capeData());
+        }
+        final boolean slim = "slim".equalsIgnoreCase(skin.armSize()) || geometryName(skin).toLowerCase(Locale.ROOT).contains("slim");
+        final PlayerModelType modelType = slim ? PlayerModelType.SLIM : PlayerModelType.WIDE;
+        final PlayerSkin playerSkin = PlayerSkin.insecure(new ClientAsset.ResourceTexture(bodyId, bodyId),
+            capeId == null ? null : new ClientAsset.ResourceTexture(capeId, capeId), null, modelType);
+        APPEARANCES.put(playerUuid, new Appearance(playerSkin, headId.equals(bodyId) ? playerSkin : PlayerSkin.insecure(
+                new ClientAsset.ResourceTexture(headId, headId), null, null, modelType), headId, geometry, slim, bodyId, capeId));
+        PLAYER_BY_TEXTURE.put(bodyId, playerUuid);
+        return playerSkin;
+    }
+
+    public static PlayerSkin skin(final UUID playerUuid, final PlayerSkin fallback) {
+        final Appearance appearance = APPEARANCES.get(playerUuid);
+        return appearance == null ? fallback : appearance.skin;
+    }
+
+    /** Supplies the square layout sampled by Java player glyphs and skull models. */
+    public static PlayerSkin headSkin(final UUID playerUuid, final PlayerSkin fallback) {
+        final Appearance appearance = APPEARANCES.get(playerUuid);
+        return appearance == null ? fallback : appearance.headSkin;
+    }
+
+    public static boolean hasInstalledSkins() {
+        return !APPEARANCES.isEmpty();
+    }
+
+    public static AvatarRenderer<?> renderer(final UUID playerUuid) {
+        final Appearance appearance = APPEARANCES.get(playerUuid);
+        if (appearance == null || appearance.geometry == null || rendererContext == null) {
+            return null;
+        }
+        if (appearance.renderer == null || appearance.rendererEpoch != rendererEpoch) {
+            appearance.renderer = new BedrockPlayerRenderer(rendererContext, BedrockGeometry.playerModel(appearance.geometry, appearance.slim), appearance.slim);
+            appearance.rendererEpoch = rendererEpoch;
+        }
+        return appearance.renderer;
+    }
+
+    public static AvatarRenderer<?> renderer(final PlayerSkin skin) {
+        if (skin == null || skin.body() == null) {
+            return null;
+        }
+        final UUID playerUuid = PLAYER_BY_TEXTURE.get(skin.body().id());
+        return playerUuid == null ? null : renderer(playerUuid);
+    }
+
+    public static Model.Simple previewModel(final Identifier texture) {
+        final UUID id = PLAYER_BY_TEXTURE.get(texture);
+        final Appearance appearance = id == null ? null : APPEARANCES.get(id);
+        if (appearance == null || appearance.geometry == null) return null;
+        if (appearance.previewModel == null)
+            appearance.previewModel = new Model.Simple(BedrockGeometry.playerModel(appearance.geometry, appearance.slim).root(), RenderTypes::entityTranslucent);
+        return appearance.previewModel;
+    }
+
+    public static void rendererContext(final EntityRendererProvider.Context context) {
+        BedrockActorResources.clear();
+        rendererContext = context;
+        rendererEpoch++;
+    }
+
+    public static void clear() {
+        BedrockActorResources.clear();
+        APPEARANCES.values().forEach(BedrockPlayerSkins::release);
+        APPEARANCES.clear();
+        PLAYER_BY_TEXTURE.clear();
+        SKIN_ASSEMBLER.clear();
+        skinConnection = null;
+    }
+
+    private static void release(final Appearance appearance) {
+        final var textureManager = Minecraft.getInstance().getTextureManager();
+        textureManager.release(appearance.bodyId);
+        if (!appearance.headId.equals(appearance.bodyId)) textureManager.release(appearance.headId);
+        if (appearance.capeId != null) {
+            textureManager.release(appearance.capeId);
+        }
+    }
+
+    private static Identifier textureId(final UUID playerUuid, final String kind) {
+        return Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "skins/" + playerUuid + '/' + kind);
+    }
+
+    private static boolean supportedImage(final BufferedImage image) {
+        return image != null && image.getWidth() > 0 && image.getHeight() > 0
+            && image.getWidth() <= MAX_TEXTURE_DIMENSION && image.getHeight() <= MAX_TEXTURE_DIMENSION;
+    }
+
+    private static void register(final Identifier id, final BufferedImage image) {
+        final NativeImage nativeImage = new NativeImage(image.getWidth(), image.getHeight(), false);
+        for (int y = 0; y < image.getHeight(); y++) {
+            for (int x = 0; x < image.getWidth(); x++) {
+                final int argb = image.getRGB(x, y);
+                final int abgr = (argb & 0xFF00FF00) | ((argb & 0xFF) << 16) | ((argb >>> 16) & 0xFF);
+                nativeImage.setPixelABGR(x, y, abgr);
+            }
+        }
+        Minecraft.getInstance().getTextureManager().register(id, new DynamicTexture(id::toString, nativeImage));
+    }
+
+    private static String geometryName(final SkinData skin) {
+        try {
+            return JsonParser.parseString(skin.skinResourcePatch()).getAsJsonObject()
+                .getAsJsonObject("geometry").get("default").getAsString();
+        } catch (RuntimeException e) {
+            return "";
+        }
+    }
+
+    private static BedrockGeometryModel geometry(final SkinData skin) {
+        final String name = geometryName(skin);
+        if (skin.geometryData() == null || skin.geometryData().isBlank()) {
+            return null;
+        }
+        try {
+            final var parsed = JsonParser.parseString(skin.geometryData());
+            if (parsed.isJsonNull()) {
+                return null;
+            }
+            final JsonObject data = parsed.getAsJsonObject();
+            final List<BedrockGeometryModel> models = BedrockGeometryModel.fromJson(data);
+            return models.stream().filter(model -> model.getIdentifier().equals(name)).findFirst()
+                .orElseGet(() -> models.isEmpty() ? null : models.getFirst());
+        } catch (RuntimeException e) {
+            ViaFabricPlusBedrock.impl().logger().warn("Failed to parse Bedrock player geometry", e);
+            return null;
+        }
+    }
+
+    private static final class Appearance {
+        private final PlayerSkin skin;
+        private final PlayerSkin headSkin;
+        private final Identifier headId;
+        private final BedrockGeometryModel geometry;
+        private final boolean slim;
+        private final Identifier bodyId;
+        private final Identifier capeId;
+        private AvatarRenderer<?> renderer;
+        private Model.Simple previewModel;
+        private long rendererEpoch;
+
+        private Appearance(final PlayerSkin skin, final PlayerSkin headSkin, final Identifier headId, final BedrockGeometryModel geometry, final boolean slim,
+                           final Identifier bodyId, final Identifier capeId) {
+            this.skin = skin;
+            this.headSkin = headSkin;
+            this.headId = headId;
+            this.geometry = geometry;
+            this.slim = slim;
+            this.bodyId = bodyId;
+            this.capeId = capeId;
+        }
+    }
+
+}
