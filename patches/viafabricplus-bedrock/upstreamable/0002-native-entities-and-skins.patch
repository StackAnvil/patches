@@ -0,0 +1,42 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** The material of the GPU pipeline being bound, rather than the shared shader program. */
+public final class BedrockShaderAlpha {
+    private static final ThreadLocal<State> REFERENCE = ThreadLocal.withInitial(State::new);
+
+    private BedrockShaderAlpha() {}
+
+    public static float reference(final float fallback) {
+        final float value = REFERENCE.get().reference;
+        return Float.isNaN(value) ? fallback : value;
+    }
+
+    public static void bind(final float reference, final Runnable action) {
+        bind(reference, false, action);
+    }
+
+    public static boolean masked() { return REFERENCE.get().masked; }
+
+    public static void bind(final float reference, final boolean masked, final Runnable action) {
+        final State current = REFERENCE.get();
+        final float previous = current.reference;
+        final boolean previousMask = current.masked;
+        current.reference = reference;
+        current.masked = masked;
+        try {
+            action.run();
+        } finally {
+            current.reference = previous;
+            current.masked = previousMask;
+        }
+    }
+    private static final class State {
+        private float reference = Float.NaN;
+        private boolean masked;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderEmission.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderEmission.java
