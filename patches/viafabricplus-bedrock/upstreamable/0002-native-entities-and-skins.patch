@@ -0,0 +1,46 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <minecraft:fog.glsl>
+#include <minecraft:dynamictransforms.glsl>
+
+uniform sampler2D Sampler0;
+layout(location = 0) in float sphericalVertexDistance;
+layout(location = 1) in float cylindricalVertexDistance;
+layout(location = 2) in vec4 vertexColor;
+#ifndef IGNORE_LIGHTING
+layout(location = 4) in vec4 lightMapColor;
+#endif
+layout(location = 5) in vec4 overlayColor;
+layout(location = 6) in vec2 texCoord0;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    vec4 color = texture(Sampler0, texCoord0);
+#ifdef USE_EMISSIVE
+    // Native AlphaTestEmissive uses inverse alpha as the emissive mask and
+    // discards only entirely empty texels, including their RGB channels.
+    if (dot(color, vec4(1.0)) <= 0.0) {
+        discard;
+    }
+    color.rgb = mix(overlayColor.rgb, color.rgb, overlayColor.a);
+    vec3 lighting = vertexColor.rgb * ColorModulator.rgb;
+#ifndef IGNORE_LIGHTING
+    lighting *= lightMapColor.rgb;
+#endif
+    color.rgb *= mix(vec3(1.0), lighting, color.a);
+#else
+    // Native ENTITY survives only when alpha is strictly above DiscardValue.x.
+    if (color.a <= 0.5) {
+        discard;
+    }
+    color.rgb = mix(overlayColor.rgb, color.rgb, overlayColor.a);
+    color.rgb *= vertexColor.rgb * ColorModulator.rgb;
+#ifndef IGNORE_LIGHTING
+    color.rgb *= lightMapColor.rgb;
+#endif
+#endif
+    fragColor = apply_fog(color, sphericalVertexDistance, cylindricalVertexDistance,
+        FogEnvironmentalStart, FogEnvironmentalEnd, FogRenderDistanceStart,
+        FogRenderDistanceEnd, FogColor);
+}
diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.vsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.vsh
