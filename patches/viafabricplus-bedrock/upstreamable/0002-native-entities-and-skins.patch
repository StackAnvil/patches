+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+@Pseudo
+@Mixin(targets = "net.irisshaders.iris.pipeline.programs.ShaderMap", remap = false)
+public abstract class MixinIrisEmissionLookup {
+    @Inject(method = "getShader", at = @At("HEAD"), cancellable = true)
+    private void bedrock$bodyVertexStages(final ShaderKey key, final CallbackInfoReturnable<GlProgram> callback) {
+        final var body = BedrockShaderEmission.bodyPipeline(BedrockShaderPipelines.compiling());
+        if (body == null || ShadowRenderingState.areShadowsCurrentlyBeingRendered()
+                || !(Iris.getPipelineManager().getPipelineNullable() instanceof IrisRenderingPipeline world)) return;
+        final var bodyKey = IrisPipelines.getPipeline(world, body);
+        if (bodyKey == null) return;
+        final GlProgram program = ((BedrockIrisEmission) world).bedrock$emissionProgram(bodyKey, key);
+        if (program != null) callback.setReturnValue(program);
+    }
+}
