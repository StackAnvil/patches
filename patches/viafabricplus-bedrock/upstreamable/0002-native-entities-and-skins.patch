+        final var overworld = BedrockActorRenderTypes.selectPipeline(BedrockActorMaterialDefinitions.Material.CUTOUT, false, false);
+        final var nether = BedrockActorRenderTypes.selectPipeline(BedrockActorMaterialDefinitions.Material.CUTOUT, false, true);
+        assertNotSame(overworld, nether);
+        assertSame(overworld, BedrockActorRenderTypes.selectPipeline(BedrockActorMaterialDefinitions.Material.CUTOUT, false, false));
