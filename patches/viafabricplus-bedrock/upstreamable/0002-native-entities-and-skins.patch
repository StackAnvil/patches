--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/compat/iris/BedrockIrisMaskedTexture.java
@@ -0,0 +1,138 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.compat.iris;
+
+import io.github.douira.glsl_transformer.ast.node.Identifier;
+import io.github.douira.glsl_transformer.ast.node.TranslationUnit;
+import io.github.douira.glsl_transformer.ast.node.declaration.FunctionParameter;
+import io.github.douira.glsl_transformer.ast.node.expression.Expression;
+import io.github.douira.glsl_transformer.ast.node.expression.ReferenceExpression;
+import io.github.douira.glsl_transformer.ast.node.expression.unary.FunctionCallExpression;
+import io.github.douira.glsl_transformer.ast.node.external_declaration.FunctionDefinition;
+import io.github.douira.glsl_transformer.ast.node.type.FullySpecifiedType;
+import io.github.douira.glsl_transformer.ast.node.type.specifier.BuiltinFixedTypeSpecifier;
+import io.github.douira.glsl_transformer.ast.node.type.specifier.BuiltinNumericTypeSpecifier;
+import io.github.douira.glsl_transformer.util.Type;
+import io.github.douira.glsl_transformer.ast.node.type.specifier.BuiltinFixedTypeSpecifier.BuiltinType;
+import io.github.douira.glsl_transformer.ast.node.type.specifier.FunctionPrototype;
+import io.github.douira.glsl_transformer.ast.transform.ASTInjectionPoint;
+import io.github.douira.glsl_transformer.ast.transform.ASTParser;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/** Compose sampled native images before a shader pack applies its material shading. */
+public final class BedrockIrisMaskedTexture {
+    public static final String ENABLED = "iris_bedrock_Masked";
+    public static final String SAMPLER = "BedrockMaskTexture";
+    // Iris reserves 0/1/2 for the primary image, overlay and lightmap. Reserve this separately.
+    public static final int UNIT = 3;
+    private static final Set<String> PRIMARY = Set.of("tex", "texture", "gtexture", "u_MainSampler", "Sampler0");
+
+    private BedrockIrisMaskedTexture() {}
+
+    public static void transform(final ASTParser parser, final TranslationUnit tree) {
+        final var root = tree.getRoot();
+        final List<FunctionPrototype> prototypes = root.nodeIndex.getStream(FunctionPrototype.class).toList();
+        // The union keeps overload selection stable when only some signatures accept samplers.
+        final Map<Signature, Set<Integer>> arguments = new HashMap<>();
+        for (final var prototype : prototypes) {
+            final var key = new Signature(prototype.getName().getName(), prototype.getParameters().size());
+            for (int index = 0; index < key.count(); index++) {
+                if (sampler(prototype.getParameters().get(index)))
+                    arguments.computeIfAbsent(key, _ -> new TreeSet<>()).add(index);
+            }
+        }
+        final Set<Sample> samples = new LinkedHashSet<>();
+        // Snapshot before adding wrappers so their own texture reads are never rewritten.
+        for (final var call : root.nodeIndex.getStream(FunctionCallExpression.class).toList()) {
+            if (call.getFunctionName() == null) continue;
+            final String name = call.getFunctionName().getName();
+            final int count = call.getParameters().size();
+            final var forwarded = arguments.get(new Signature(name, count));
+            if (forwarded != null) {
+                for (final int index : forwarded)
+                    call.getParameters().add(parser.parseExpression(root, nativeArgument(call, call.getParameters().get(index))));
+            } else if (count >= 2) {
+                final String nativeArgument = nativeArgument(call, call.getParameters().getFirst());
+                final Sample sample = Sample.of(name, count);
+                if (sample != null && !nativeArgument.equals("false")) {
+                    samples.add(sample);
+                    call.getFunctionName().setName(sample.wrapper());
+                    call.getParameters().add(parser.parseExpression(root, nativeArgument));
+                }
+            }
+        }
+        for (final var prototype : prototypes) {
+            final var forwarded = arguments.get(new Signature(prototype.getName().getName(), prototype.getParameters().size()));
+            if (forwarded == null) continue;
+            for (final int index : forwarded) {
+                final var parameter = root.indexNodes(() -> new FunctionParameter(
+                        new FullySpecifiedType(new BuiltinNumericTypeSpecifier(Type.BOOL)), new Identifier(flag(index))));
+                prototype.getParameters().add(parameter);
+            }
+        }
+        final List<String> declarations = new ArrayList<>();
+        declarations.add("uniform int " + ENABLED + ";");
+        declarations.add("uniform sampler2D " + SAMPLER + ";");
+        declarations.add("""
+                vec4 iris_bedrock_Compose(vec4 base, vec4 mask) {
+                    if (iris_bedrock_Masked == 0) return base;
+                    float keepBase = clamp(ceil((mask.r + mask.g + mask.b) * (1.0 - mask.a)), 0.0, 1.0);
+                    return mix(mask, base, keepBase);
+                }
+                """);
+        samples.forEach(sample -> declarations.add(sample.source()));
+        tree.parseAndInjectNodes(parser, ASTInjectionPoint.BEFORE_DECLARATIONS, declarations.toArray(String[]::new));
+    }
+
+    private static boolean sampler(final FunctionParameter parameter) {
+        return parameter.getType().getTypeSpecifier() instanceof BuiltinFixedTypeSpecifier builtin && builtin.type == BuiltinType.SAMPLER2D;
+    }
+
+    private static String flag(final int index) { return "iris_bedrock_arg" + index; }
+
+    private static String nativeArgument(final FunctionCallExpression call, final Expression expression) {
+        if (!(expression instanceof ReferenceExpression reference)) return "false";
+        final String name = reference.getIdentifier().getName();
+        final var definition = call.getAncestor(FunctionDefinition.class);
+        if (definition != null) {
+            final var parameters = definition.getFunctionPrototype().getParameters();
+            for (int index = 0; index < parameters.size(); index++) {
+                final var parameter = parameters.get(index);
+                if (parameter.getName() != null && parameter.getName().getName().equals(name))
+                    return sampler(parameter) ? flag(index) : "false";
+            }
+        }
+        return PRIMARY.contains(name) ? "true" : "false";
+    }
+
+    private record Signature(String name, int count) {}
+    private record Sample(String function, int count, String parameters, String arguments) {
+        private static Sample of(final String name, final int count) {
+            return switch (name) {
+                case "texture", "texture2D" -> count == 2 ? new Sample("texture", count, "", "")
+                        : count == 3 ? new Sample("texture", count, ", float bias", ", bias") : null;
+                case "textureLod", "texture2DLod" -> count == 3 ? new Sample("textureLod", count, ", float lod", ", lod") : null;
+                case "textureGrad", "texture2DGradARB" -> count == 4 ? new Sample("textureGrad", count,
+                        ", vec2 dx, vec2 dy", ", dx, dy") : null;
+                default -> null;
+            };
+        }
+        private String wrapper() { return "iris_bedrock_" + this.function + this.count; }
+        private String source() {
+            return "vec4 " + wrapper() + "(sampler2D image, vec2 uv" + this.parameters + ", bool actor) {\n"
+                    + "if (actor && " + ENABLED + " != 0) return iris_bedrock_Compose("
+                    + this.function + "(" + BedrockIrisAlpha.SAMPLER + ", uv" + this.arguments + "), "
+                    + this.function + "(" + SAMPLER + ", uv" + this.arguments + "));\n"
+                    + "return " + this.function + "(image, uv" + this.arguments + ");\n}";
+        }
+    }
+}
