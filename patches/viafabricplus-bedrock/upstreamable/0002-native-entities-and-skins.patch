+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockShaderPipeline;
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderPipelines;
+import org.spongepowered.asm.mixin.Mixin;
+
+@Mixin(RenderSystem.class)
+public abstract class MixinNativeShaderCompilation {
+    @WrapMethod(method = "getCompiledPipelineNullable")
+    private static CompiledRenderPipeline bedrock$material(final RenderPipeline pipeline, final Operation<CompiledRenderPipeline> original) {
+        // Wrap the complete method so this sees Iris's cached override, including cancelled returns.
+        final CompiledRenderPipeline compiled = BedrockShaderPipelines.compiling(pipeline, () -> original.call(pipeline));
+        if (compiled instanceof FrontendRenderPipeline frontend && frontend.backendRenderPipeline() instanceof IBedrockShaderPipeline material) {
+            material.bedrock$material(BedrockShaderPipelines.alphaReference(pipeline), pipeline.getShaderDefines().flags().contains("MASKED_MULTITEXTURE"));
+        }
+        return compiled;
+    }
+}
