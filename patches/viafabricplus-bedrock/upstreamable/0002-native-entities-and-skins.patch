+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Shader-pack equivalents for native pipelines, independent of an installed shader mod. */
+public final class BedrockShaderPipelines {
+    private static final Map<RenderPipeline, Material> MATERIALS = Collections.synchronizedMap(new IdentityHashMap<>());
+
+    private static final ThreadLocal<RenderPipeline> COMPILING = new ThreadLocal<>();
+
+    private BedrockShaderPipelines() {
+    }
+
+    public static RenderPipeline register(final RenderPipeline nativePipeline, final RenderPipeline shaderPipeline) {
+        return register(nativePipeline, shaderPipeline, Float.NaN);
+    }
+
+    public static RenderPipeline register(final RenderPipeline nativePipeline, final RenderPipeline shaderPipeline, final float alphaReference) {
+        MATERIALS.put(nativePipeline, new Material(shaderPipeline, alphaReference));
+        return nativePipeline;
+    }
+
+    /** Scope nested program lookups to their actual native pipeline, including cached Iris overrides. */
+    public static <T> T compiling(final RenderPipeline pipeline, final java.util.function.Supplier<T> action) {
+        final RenderPipeline previous = COMPILING.get();
+        COMPILING.set(pipeline);
+        try { return action.get(); }
+        finally {
+            if (previous == null) COMPILING.remove();
+            else COMPILING.set(previous);
+        }
+    }
+
+    public static RenderPipeline compiling() { return COMPILING.get(); }
+
+    public static RenderPipeline equivalent(final RenderPipeline pipeline) {
+        final Material material = MATERIALS.get(pipeline);
+        return material == null ? pipeline : material.pipeline();
+    }
+
+    public static float alphaReference(final RenderPipeline pipeline) {
+        final Material material = MATERIALS.get(pipeline);
+        return material == null ? Float.NaN : material.alphaReference();
+    }
+
+    private record Material(RenderPipeline pipeline, float alphaReference) {}
+}
