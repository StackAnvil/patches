+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockActorRenderType;
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.BindGroupLayouts;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.level.Level;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+
+public final class BedrockActorRenderTypes {
+    public static final List<RenderPipeline> PIPELINES = List.of(
+        pipeline(false, false, false, false), pipeline(true, false, false, false),
+        pipeline(false, true, false, false), pipeline(true, true, false, false),
+        pipeline(false, false, true, false), pipeline(true, false, true, false),
+        pipeline(false, true, true, false), pipeline(true, true, true, false),
+        pipeline(false, false, false, true), pipeline(true, false, false, true),
+        pipeline(false, false, true, true), pipeline(true, false, true, true));
+
+    private BedrockActorRenderTypes() {
+    }
+
+    private static RenderPipeline pipeline(final boolean cull, final boolean ignoreLighting, final boolean emissive, final boolean netherLighting) {
+        final var builder = RenderPipeline.builder(RenderPipelines.ENTITY_SNIPPET)
+            .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/actor_" + cull + "_" + ignoreLighting + "_" + emissive + "_" + netherLighting))
+            .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_actor"))
+            .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_actor"))
+            .withBindGroupLayout(BindGroupLayouts.SAMPLER1)
+            .withColorTargetState(ColorTargetState.DEFAULT)
+            .withCull(cull);
+        if (ignoreLighting) {
+            builder.withShaderDefine("IGNORE_LIGHTING");
+        }
+        if (netherLighting) {
+            builder.withShaderDefine("NETHER_LIGHTING");
+        }
+        if (emissive) {
+            builder.withShaderDefine("USE_EMISSIVE");
+        }
+        // Fullbright materials use Iris's eyes path; ordinary actors retain entity diffuse lighting.
+        final var shaderPipeline = ignoreLighting || emissive ? RenderPipelines.EYES
+            : cull ? RenderPipelines.ENTITY_CUTOUT_CULL : RenderPipelines.ENTITY_CUTOUT;
+        return BedrockShaderPipelines.register(builder.build(), shaderPipeline);
+    }
+
+    public static boolean usesNetherLighting() {
+        final var connection = ViaFabricPlus.api().userConnection();
+        if (connection != null && connection.has(ChunkTracker.class)) {
+            return connection.get(ChunkTracker.class).getDimension() == Dimension.NETHER;
+        }
+        // A Java connection through ViaProxy retains the canonical dimension identity.
+        final var level = Minecraft.getInstance().level;
+        return level != null && level.dimension().equals(Level.NETHER);
+    }
+
+    public static RenderType create(final Identifier texture, final boolean cull, final boolean ignoreLighting, final boolean emissive, final float multiplier, final BedrockActorUvTransform uv, final boolean netherLighting) {
+        final RenderType type = RenderType.create("bedrock_actor", RenderSetup.builder(selectPipeline(cull, ignoreLighting, emissive, netherLighting))
+            .withTexture("Sampler0", texture).useLightmap().useOverlay().createRenderSetup());
+        ((IBedrockActorRenderType) type).bedrock$lightColorMultiplier(multiplier);
+        ((IBedrockActorRenderType) type).bedrock$uvTransform(uv);
+        return type;
+    }
+
+    static RenderPipeline selectPipeline(final boolean cull, final boolean ignoreLighting, final boolean emissive, final boolean netherLighting) {
+        final int lightingFamily = netherLighting && !ignoreLighting ? 8 + (emissive ? 2 : 0)
+            : (emissive ? 4 : 0) + (ignoreLighting ? 2 : 0);
+        return PIPELINES.get(lightingFamily + (cull ? 1 : 0));
+    }
+}
