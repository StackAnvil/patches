+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Pseudo
+@Mixin(targets = "net.irisshaders.iris.pipeline.programs.FallbackShader", remap = false)
+public abstract class MixinIrisFallbackAlpha {
+    @Unique
+    private int bedrock$alphaLocation = -1;
+    @Unique
+    private float bedrock$alphaReference;
+    @Unique
+    private BedrockIrisAlphaUniforms bedrock$sourceAlpha;
+
+    @Inject(method = "<init>", at = @At("RETURN"))
+    private void bedrock$locations(final CallbackInfo ci) {
+        this.bedrock$sourceAlpha = new BedrockIrisAlphaUniforms(((GlProgram) (Object) this).getProgramId());
+    }
+
+    @Inject(method = "iris$setupState", at = @At("RETURN"))
+    private void bedrock$bindSourceAlpha(final CallbackInfo ci) {
+        this.bedrock$sourceAlpha.bind();
+    }
+
+    @WrapOperation(method = "<init>", at = @At(value = "INVOKE", target = "Lorg/lwjgl/opengl/GL46C;glUniform1f(IF)V"))
+    private void bedrock$rememberAlpha(final int location, final float reference, final Operation<Void> original) {
+        this.bedrock$alphaLocation = location;
+        this.bedrock$alphaReference = reference;
+        original.call(location, reference);
+    }
+
+    @Inject(method = "iris$setupState", at = @At(value = "INVOKE",
+        target = "Lcom/mojang/renderpearl/backend/opengl/GlStateManager;_glUseProgram(I)V", shift = At.Shift.AFTER))
+    private void bedrock$alphaReference(final CallbackInfo ci) {
+        if (this.bedrock$alphaLocation >= 0) {
+            // Fallback programs are shared too, so restore their original value on every Java draw.
+            GL46C.glUniform1f(this.bedrock$alphaLocation, BedrockShaderAlpha.reference(this.bedrock$alphaReference));
+        }
+    }
+}
