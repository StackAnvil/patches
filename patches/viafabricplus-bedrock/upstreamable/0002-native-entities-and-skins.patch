@@ -0,0 +1,53 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+
+import java.io.IOException;
+import java.util.List;
+
+/** Actor and effect loaders share one decoded accepted archive during each resource generation. */
+public final class BedrockAcceptedResources {
+
+    private static Snapshot snapshot;
+
+    private BedrockAcceptedResources() {}
+
+    /** Decoding accepted assets never requests authentication or a direct Bedrock connection. */
+    public static synchronized List<NativeActorLibrary.Layer> layers(final ResourceManager resources) throws IOException {
+        if (snapshot == null || snapshot.resources != resources) {
+            try {
+                snapshot = new Snapshot(resources, read(resources), null);
+            } catch (IOException | RuntimeException invalid) {
+                snapshot = new Snapshot(resources, List.of(), new IOException("Could not read accepted native resources", invalid));
+            }
+        }
+        if (snapshot.error != null) throw snapshot.error;
+        return snapshot.layers;
+    }
+
+    private static List<NativeActorLibrary.Layer> read(final ResourceManager resources) throws IOException {
+        final var stack = resources.getResourceStack(Identifier.fromNamespaceAndPath("viabedrock", "actor_library.bin"));
+        for (int index = stack.size() - 1; index >= 0; index--) {
+            final var resource = stack.get(index);
+            if (resource.source().location().source() != PackSource.SERVER) continue;
+            try (var input = resource.open()) {
+                return NativeActorLibrary.decode(input);
+            }
+        }
+        return List.of();
+    }
+
+    public static synchronized void clear() {
+        snapshot = null;
+    }
+
+    private record Snapshot(ResourceManager resources, List<NativeActorLibrary.Layer> layers, IOException error) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialDefinitions.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialDefinitions.java
new file mode 100644
index 0000000..3bb710c
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialDefinitions.java
@@ -0,0 +1,174 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Resolves pack material inheritance before selecting the verified native actor shader family. */
+public final class BedrockActorMaterialDefinitions {
+    private final Map<String, Definition> definitions = new HashMap<>();
+    private final Map<String, Optional<Material>> resolved = new HashMap<>();
+
+    private BedrockActorMaterialDefinitions(final List<JsonObject> documents) {
+        // Authored metadata for the target's verified ENTITY material families.
+        this.add(JsonParser.parseString("""
+            {"materials":{
+                "entity":{"vertexShader":"shaders/entity.vertex","fragmentShader":"shaders/entity.fragment",
+                    "defines":["USE_OVERLAY"]},
+                "entity_nocull:entity":{"+states":["DisableCulling"]},
+                "entity_alphatest:entity_nocull":{"+defines":["ALPHA_TEST"]},
+                "entity_alphatest_one_sided:entity":{"+defines":["ALPHA_TEST"]},
+                "entity_multitexture_masked:entity_alphatest":{"+defines":["MASKED_MULTITEXTURE"]},
+                "entity_emissive:entity":{"+defines":["USE_EMISSIVE"]},
+                "entity_emissive_alpha:entity_nocull":{"+defines":["ALPHA_TEST","USE_EMISSIVE"]},
+                "entity_emissive_alpha_one_sided:entity":{"+defines":["ALPHA_TEST","USE_EMISSIVE"]}
+            }}
+            """).getAsJsonObject());
+        documents.forEach(this::add);
+    }
+
+    public static BedrockActorMaterialDefinitions load(final ResourcePackStorage packs) {
+        final List<JsonObject> documents = new ArrayList<>();
+        for (var pack : packs.getPackStackBottomToTop()) {
+            for (String path : pack.content().getFilesDeep("materials/", ".material")) {
+                try {
+                    final JsonObject document = pack.content().getJson(path);
+                    documents.add(packs.isServerPack(pack) ? document : nativeDefinitions(document));
+                } catch (RuntimeException invalid) {
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not parse actor material definitions {}", path, invalid);
+                }
+            }
+        }
+        return read(documents);
+    }
+
+    static BedrockActorMaterialDefinitions read(final List<JsonObject> documents) {
+        return new BedrockActorMaterialDefinitions(documents);
+    }
+
+    /** Fixed native buffers and CPU bone poses replace the package's GPU layout and skinning variants. */
+    static JsonObject nativeDefinitions(final JsonObject document) {
+        final JsonObject compiled = document.deepCopy();
+        final JsonElement materials = compiled.get("materials");
+        if (materials == null || !materials.isJsonObject()) return compiled;
+        for (final JsonElement definition : materials.getAsJsonObject().asMap().values()) {
+            if (!definition.isJsonObject()) continue;
+            for (final String field : List.of("vertexFields", "+vertexFields", "-vertexFields", "variants",
+                    "vrGeometryShader", "samplerStates", "+samplerStates", "-samplerStates"))
+                definition.getAsJsonObject().remove(field);
+        }
+        return compiled;
+    }
+
+    public Optional<Material> material(final String name) {
+        if (!this.definitions.containsKey(name)) return Optional.empty();
+        return this.resolved.computeIfAbsent(name, identifier -> {
+            final Effective effective = this.resolve(identifier, new HashSet<>());
+            final Set<String> shaderDefines = new HashSet<>(effective == null ? Set.of() : effective.defines);
+            shaderDefines.remove("USE_UV_ANIM");
+            // The target native legacy define map does not assign either name a shader flag.
+            shaderDefines.removeAll(Set.of("USE_MASK", "Blending"));
+            // Java uses reversed depth; the actor pipeline already implements native LessEqual.
+            if (effective == null || !effective.verifiedFields
+                || !"shaders/entity.vertex".equals(effective.vertexShader)
+                || !"shaders/entity.fragment".equals(effective.fragmentShader)
+                || !"LessEqual".equals(effective.depthFunction)
+                || !shaderDefines.contains("USE_OVERLAY")
+                || !Set.of("USE_OVERLAY", "ALPHA_TEST", "USE_EMISSIVE", "MASKED_MULTITEXTURE").containsAll(shaderDefines)
+                || !Set.of("DisableCulling").containsAll(effective.states)) {
+                return Optional.empty();
+            }
+            final boolean masked = effective.defines.contains("MASKED_MULTITEXTURE");
+            if (masked && (!effective.defines.contains("ALPHA_TEST") || effective.defines.contains("USE_EMISSIVE"))) {
+                return Optional.empty();
+            }
+            return Optional.of(new Material(effective.defines.contains("ALPHA_TEST"), !effective.states.contains("DisableCulling"), effective.defines.contains("USE_EMISSIVE"), effective.defines.contains("USE_UV_ANIM"), masked));
+        });
+    }
+
+    private void add(final JsonObject document) {
+        final JsonElement materialElement = document.get("materials");
+        if (materialElement == null || !materialElement.isJsonObject()) return;
+        final JsonObject materials = materialElement.getAsJsonObject();
+        for (var entry : materials.entrySet()) {
+            if (!entry.getValue().isJsonObject()) continue;
+            final int separator = entry.getKey().indexOf(':');
+            final String name = separator < 0 ? entry.getKey() : entry.getKey().substring(0, separator);
+            final String parent = separator < 0 ? null : entry.getKey().substring(separator + 1);
+            this.definitions.put(name, new Definition(parent, entry.getValue().getAsJsonObject().deepCopy()));
+        }
+    }
+
+    private Effective resolve(final String name, final Set<String> ancestors) {
+        final Definition definition = this.definitions.get(name);
+        if (definition == null || ancestors.size() >= 128 || !ancestors.add(name)) return null;
+        final Effective parent = definition.parent == null ? new Effective(null, null, "LessEqual", Set.of(), Set.of(), true)
+            : this.resolve(definition.parent, ancestors);
+        ancestors.remove(name);
+        if (parent == null) return null;
+        final JsonObject fields = definition.fields;
+        try {
+            boolean verified = parent.verifiedFields;
+            for (String key : fields.keySet()) {
+                if (!Set.of("vertexShader", "fragmentShader", "defines", "+defines", "-defines",
+                    "states", "+states", "-states", "msaaSupport", "depthFunc").contains(key)) verified = false;
+            }
+            return new Effective(string(fields, "vertexShader", parent.vertexShader),
+                string(fields, "fragmentShader", parent.fragmentShader),
+                string(fields, "depthFunc", parent.depthFunction),
+                flags(fields, "defines", parent.defines), flags(fields, "states", parent.states), verified);
+        } catch (RuntimeException invalid) {
+            return null;
+        }
+    }
+
+    private static String string(final JsonObject fields, final String key, final String inherited) {
+        if (!fields.has(key)) return inherited;
+        final JsonElement value = fields.get(key);
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+            throw new IllegalArgumentException("Invalid actor material string field");
+        }
+        return value.getAsString();
+    }
+
+    private static Set<String> flags(final JsonObject fields, final String key, final Set<String> inherited) {
+        final Set<String> result = new HashSet<>(fields.has(key) ? strings(fields.get(key)) : inherited);
+        if (fields.has("-" + key)) result.removeAll(strings(fields.get("-" + key)));
+        if (fields.has("+" + key)) result.addAll(strings(fields.get("+" + key)));
+        return Set.copyOf(result);
+    }
+
+    private static Set<String> strings(final JsonElement array) {
+        final Set<String> result = new HashSet<>();
+        for (JsonElement value : array.getAsJsonArray()) result.add(value.getAsString());
+        return result;
+    }
+
+    public record Material(boolean alphaTest, boolean cull, boolean emissive, boolean uvAnimation, boolean masked) {
+        public static final Material CUTOUT = new Material(true, false, false, false, false);
+
+        public Material {
+            if (masked && (!alphaTest || emissive)) throw new IllegalArgumentException("Unsupported masked material family");
+        }
+
+        public int textureCount() { return this.masked ? 2 : 1; }
+        public Material withoutEmission() { return new Material(this.alphaTest, this.cull, false, this.uvAnimation, this.masked); }
+    }
+    private record Definition(String parent, JsonObject fields) {}
+    private record Effective(String vertexShader, String fragmentShader, String depthFunction, Set<String> defines,
+                             Set<String> states, boolean verifiedFields) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterials.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterials.java
