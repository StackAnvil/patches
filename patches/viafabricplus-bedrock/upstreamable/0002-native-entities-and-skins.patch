+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorMaterialDefinitionsTest {
+    @Test
+    void resolvesNativeAlphaTestInheritanceAndCulling() {
+        final var materials = read("""
+            {"banner:entity":{"+defines":["ALPHA_TEST"]},
+             "double_sided:banner":{"+states":["DisableCulling"]},
+             "single_sided:double_sided":{"-states":["DisableCulling"]}}
+            """);
+        assertTrue(materials.alphaTest("banner").orElseThrow().cull());
+        assertFalse(materials.alphaTest("double_sided").orElseThrow().cull());
+        assertTrue(materials.alphaTest("single_sided").orElseThrow().cull());
+        assertFalse(materials.alphaTest("entity_alphatest").orElseThrow().cull());
+        assertTrue(materials.alphaTest("entity_alphatest_one_sided").orElseThrow().cull());
+    }
+
+    @Test
+    void resolvesEmissiveAlphaInheritanceWithoutAcceptingOtherEffects() {
+        final var materials = read("""
+            {"cube:entity_emissive_alpha_one_sided":{},
+             "double_sided:cube":{"+states":["DisableCulling"]},
+             "unsupported:cube":{"+defines":["USE_ONLY_EMISSIVE"]}}
+            """);
+        assertTrue(materials.alphaTest("cube").orElseThrow().cull());
+        assertTrue(materials.alphaTest("cube").orElseThrow().emissive());
+        assertFalse(materials.alphaTest("double_sided").orElseThrow().cull());
+        assertTrue(materials.alphaTest("double_sided").orElseThrow().emissive());
+        assertTrue(materials.alphaTest("entity_emissive_alpha").orElseThrow().emissive());
+        assertTrue(materials.alphaTest("unsupported").isEmpty());
+    }
+
+    @Test
+    void higherPackReplacesTheWholeDefinitionAndItsParent() {
+        final var materials = BedrockActorMaterialDefinitions.read(List.of(document("""
+            {"banner:entity_alphatest":{"+states":["DisableDepthWrite"]},
+             "dependent:banner":{}}
+            """), document("""
+            {"banner:entity_alphatest_one_sided":{}}
+            """)));
+        assertTrue(materials.alphaTest("dependent").orElseThrow().cull());
+        final var separatePack = read("""
+            {"banner:entity_alphatest":{}}
+            """);
+        assertFalse(separatePack.alphaTest("banner").orElseThrow().cull());
+    }
+
+    @Test
+    void replacementAndRemovalSelectEffectiveShaderFlags() {
+        final var materials = read("""
+            {"emission:entity_alphatest":{"+defines":["USE_EMISSIVE"]},
+             "removed:emission":{"-defines":["USE_EMISSIVE"]},
+             "replacement:emission":{"defines":["USE_OVERLAY","ALPHA_TEST"],"states":[]},
+             "opaque:entity_alphatest":{"-defines":["ALPHA_TEST"]}}
+            """);
+        assertTrue(materials.alphaTest("emission").orElseThrow().emissive());
+        assertFalse(materials.alphaTest("removed").orElseThrow().emissive());
+        assertFalse(materials.alphaTest("replacement").orElseThrow().emissive());
+        assertFalse(materials.alphaTest("removed").orElseThrow().cull());
+        assertTrue(materials.alphaTest("replacement").orElseThrow().cull());
+        assertTrue(materials.alphaTest("opaque").isEmpty());
+    }
+
+    @Test
+    void unsupportedShaderAndRenderStatesRetainFallback() {
+        final var materials = read("""
+            {"shader:entity_alphatest":{"fragmentShader":"shaders/other.fragment"},
+             "blend:entity_alphatest":{"+states":["Blending"]},
+             "depth:entity_alphatest":{"depthFunc":"Always"},
+             "uv:entity_alphatest":{"+defines":["USE_UV_ANIM"]},
+             "malformed:entity_alphatest":{"defines":false}}
+            """);
+        for (String name : List.of("shader", "blend", "depth", "uv", "malformed", "missing")) {
+            assertTrue(materials.alphaTest(name).isEmpty());
+        }
+    }
+
+    @Test
+    void cyclicAndMissingParentsDoNotResolve() {
+        final var materials = read("""
+            {"a:b":{},"b:a":{},"self:self":{},"missing_parent:absent":{}}
+            """);
+        for (String name : List.of("a", "b", "self", "missing_parent")) {
+            assertTrue(materials.alphaTest(name).isEmpty());
+        }
+    }
+
+    @Test
+    void malformedDocumentsPreserveValidNeighborDefinitions() {
+        final var materials = BedrockActorMaterialDefinitions.read(List.of(
+            document("null"), document("[]"), document("false"), document("\"invalid\""),
+            document("{\"banner:entity_alphatest_one_sided\":{}}")));
+        assertTrue(materials.alphaTest("banner").orElseThrow().cull());
+    }
+
+    private static BedrockActorMaterialDefinitions read(final String materials) {
+        return BedrockActorMaterialDefinitions.read(List.of(document(materials)));
+    }
+
+    private static JsonObject document(final String materials) {
+        return JsonParser.parseString("{\"materials\":" + materials + "}").getAsJsonObject();
+    }
+}
