@@ -0,0 +1,58 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <minecraft:fog.glsl>
+#include <minecraft:dynamictransforms.glsl>
+
+uniform sampler2D Sampler0;
+#ifdef MASKED_MULTITEXTURE
+uniform sampler2D BedrockMaskTexture;
+#endif
+layout(location = 0) in float sphericalVertexDistance;
+layout(location = 1) in float cylindricalVertexDistance;
+layout(location = 2) in vec4 vertexColor;
+#ifndef IGNORE_LIGHTING
+layout(location = 4) in vec4 lightMapColor;
+#endif
+layout(location = 5) in vec4 overlayColor;
+layout(location = 6) in vec2 texCoord0;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    vec4 color = texture(Sampler0, texCoord0);
+#ifdef MASKED_MULTITEXTURE
+    vec4 mask = texture(BedrockMaskTexture, texCoord0);
+    float keepBase = clamp(ceil((mask.r + mask.g + mask.b) * (1.0 - mask.a)), 0.0, 1.0);
+    color = mix(mask, color, keepBase);
+#endif
+#ifdef USE_EMISSIVE
+    // Native AlphaTestEmissive uses inverse alpha as the emissive mask and
+    // discards only entirely empty texels, including their RGB channels.
+#ifdef ALPHA_TEST
+    if (dot(color, vec4(1.0)) <= 0.0) {
+        discard;
+    }
+#endif
+    color.rgb = mix(overlayColor.rgb, color.rgb, overlayColor.a);
+    vec3 lighting = vertexColor.rgb * ColorModulator.rgb;
+#ifndef IGNORE_LIGHTING
+    lighting *= lightMapColor.rgb;
+#endif
+    color.rgb *= mix(vec3(1.0), lighting, color.a);
+#else
+    // Native ENTITY survives only when alpha is strictly above DiscardValue.x.
+#ifdef ALPHA_TEST
+    if (color.a <= 0.5) {
+        discard;
+    }
+#endif
+    color.rgb = mix(overlayColor.rgb, color.rgb, overlayColor.a);
+    color.rgb *= vertexColor.rgb * ColorModulator.rgb;
+#ifndef IGNORE_LIGHTING
+    color.rgb *= lightMapColor.rgb;
+#endif
+#endif
+    fragColor = apply_fog(color, sphericalVertexDistance, cylindricalVertexDistance,
+        FogEnvironmentalStart, FogEnvironmentalEnd, FogRenderDistanceStart,
+        FogRenderDistanceEnd, FogColor);
+}
diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.vsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.vsh
new file mode 100644
index 0000000..103e2fe
--- /dev/null
+++ b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.vsh
@@ -0,0 +1,47 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#ifndef IGNORE_LIGHTING
+#include <minecraft:sample_lightmap.glsl>
+uniform sampler2D Sampler2;
+#endif
+#include <minecraft:fog.glsl>
+#include <minecraft:dynamictransforms.glsl>
+#include <minecraft:projection.glsl>
+
+uniform sampler2D Sampler1;
+layout(location = 0) in vec3 Position;
+layout(location = 1) in vec4 Color;
+layout(location = 2) in vec2 UV0;
+layout(location = 3) in ivec2 UV1;
+layout(location = 4) in ivec2 UV2;
+layout(location = 5) in vec3 Normal;
+
+layout(location = 0) out float sphericalVertexDistance;
+layout(location = 1) out float cylindricalVertexDistance;
+layout(location = 2) out vec4 vertexColor;
+#ifndef IGNORE_LIGHTING
+layout(location = 4) out vec4 lightMapColor;
+#endif
+layout(location = 5) out vec4 overlayColor;
+layout(location = 6) out vec2 texCoord0;
+
+void main() {
+    gl_Position = ProjMat * ModelViewMat * vec4(Position, 1.0);
+    sphericalVertexDistance = fog_spherical_distance(Position);
+    cylindricalVertexDistance = fog_cylindrical_distance(Position);
+    overlayColor = texelFetch(Sampler1, UV1, 0);
+    // Native ENTITY shades world-space normals before the camera transform.
+    vec3 normal = normalize(Normal);
+    float verticalNormal = normal.y;
+#if defined(NETHER_LIGHTING) && !defined(IGNORE_LIGHTING)
+    verticalNormal = -verticalNormal;
+#endif
+    float shade = 0.45 - 0.1 * normal.x * normal.x + 0.1 * normal.z * normal.z
+        + 0.35 * (1.0 - overlayColor.a) + 0.275 * (verticalNormal + 1.0);
+    vertexColor = vec4(Color.rgb * shade, Color.a);
+#ifndef IGNORE_LIGHTING
+    lightMapColor = sample_lightmap(Sampler2, UV2);
+#endif
+    texCoord0 = (TextureMat * vec4(UV0, 0.0, 1.0)).xy;
+}
