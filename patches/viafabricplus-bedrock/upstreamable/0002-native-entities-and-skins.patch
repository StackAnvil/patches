@@ -0,0 +1,27 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** Native inverse-alpha emission split into an opaque lit surface and additive radiance. */
+final class BedrockEmissiveMask {
+    private BedrockEmissiveMask() {}
+
+    static int lit(final int argb) {
+        return argb == 0 ? 0 : 0xFF000000 | weight(argb, argb >>> 24);
+    }
+
+    static int emission(final int argb) {
+        final int rgb = weight(argb, 255 - (argb >>> 24));
+        return rgb == 0 ? 0 : 0xFF000000 | rgb;
+    }
+
+    private static int weight(final int argb, final int alpha) {
+        final int r = ((argb >>> 16 & 255) * alpha + 127) / 255;
+        final int g = ((argb >>> 8 & 255) * alpha + 127) / 255;
+        final int b = ((argb & 255) * alpha + 127) / 255;
+        return r << 16 | g << 8 | b;
+    }
+}
