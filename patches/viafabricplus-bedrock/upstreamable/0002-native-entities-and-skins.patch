+package com.viaversion.viafabricplus.bedrock.render;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockEmissiveMaskTest {
+    @Test
+    void reconstructsNativeRadianceAcrossEveryAlphaAndChannelValue() {
+        for (int alpha = 0; alpha < 256; alpha++) for (int channel = 0; channel < 256; channel++) {
+            final int pixel = alpha << 24 | channel << 16 | channel << 8 | channel;
+            final int lit = BedrockEmissiveMask.lit(pixel), emission = BedrockEmissiveMask.emission(pixel);
+            assertEquals(channel, (lit & 255) + (emission & 255));
+            if (pixel != 0) assertEquals(255, lit >>> 24);
+            for (final float light : new float[]{0, .2F, .75F, 1}) {
+                final float expected = channel * (1 - alpha / 255F + light * alpha / 255F);
+                assertEquals(expected, (lit & 255) * light + (emission & 255), .51F);
+            }
+        }
+    }
+
+    @Test
+    void preservesCoverageWithoutTurningEmissionIntoTransparency() {
+        assertEquals(0, BedrockEmissiveMask.lit(0));
+        assertEquals(0, BedrockEmissiveMask.emission(0));
+        assertEquals(0xFF000000, BedrockEmissiveMask.lit(0x00123456));
+        assertEquals(0xFF123456, BedrockEmissiveMask.emission(0x00123456));
+        assertEquals(0xFF123456, BedrockEmissiveMask.lit(0xFF123456));
+        assertEquals(0, BedrockEmissiveMask.emission(0xFF123456));
+        assertEquals(0xFF000000, BedrockEmissiveMask.lit(0x01000000));
+    }
+}
