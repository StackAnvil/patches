+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorMaterialDefinitionsTest {
+    @Test
+    void retainsMaskedSamplingAcrossInheritanceAndRejectsUnverifiedFamilyCombinations() {
+        final var materials = read("""
+            {"masked:entity_multitexture_masked":{"+defines":["USE_UV_ANIM"]},
+             "single:masked":{"-defines":["MASKED_MULTITEXTURE"]},
+             "opaque:masked":{"-defines":["ALPHA_TEST"]},
+             "emissive:masked":{"+defines":["USE_EMISSIVE"]}}
+            """);
+        final var masked = materials.material("masked").orElseThrow();
+        assertTrue(masked.masked());
+        assertTrue(masked.alphaTest());
+        assertTrue(masked.uvAnimation());
+        assertEquals(2, masked.textureCount());
+        assertEquals(masked, masked.withoutEmission());
+        assertFalse(materials.material("single").orElseThrow().masked());
+        assertEquals(1, materials.material("single").orElseThrow().textureCount());
+        assertTrue(materials.material("opaque").isEmpty());
+        assertTrue(materials.material("emissive").isEmpty());
+    }
+
+    @Test
+    void retainsOpaqueCoverageAcrossInheritanceAndEmissionChanges() {
+        final var materials = read("""
+            {"opaque:entity":{}, "two_sided:entity_nocull":{},
+             "emission:entity_emissive":{"+defines":["USE_UV_ANIM"]},
+             "cutout:emission":{"+defines":["ALPHA_TEST"]},
+             "removed:cutout":{"-defines":["ALPHA_TEST"]}}
+            """);
+        final var opaque = materials.material("opaque").orElseThrow();
+        assertFalse(opaque.alphaTest());
+        assertTrue(opaque.cull());
+        assertFalse(opaque.emissive());
+        assertFalse(materials.material("two_sided").orElseThrow().cull());
+        final var emission = materials.material("emission").orElseThrow();
+        assertFalse(emission.alphaTest());
+        assertTrue(emission.emissive());
+        assertTrue(emission.uvAnimation());
+        assertTrue(materials.material("cutout").orElseThrow().alphaTest());
+        assertEquals(emission, materials.material("removed").orElseThrow());
+        assertEquals(new BedrockActorMaterialDefinitions.Material(false, true, false, true, false), emission.withoutEmission());
+    }
+
+    @Test
+    void inheritsSupportedDepthComparisonAndAllowsAnExplicitOverrideToRecoverIt() {
+        final var materials = read("""
+            {"declared:entity_alphatest":{"depthFunc":"LessEqual"},
+             "inherited:declared":{},
+             "always:declared":{"depthFunc":"Always"},
+             "unsupported:always":{},
+             "restored:always":{"depthFunc":"LessEqual"}}
+            """);
+        final var expected = materials.material("entity_alphatest").orElseThrow();
+        assertEquals(expected, materials.material("declared").orElseThrow());
+        assertEquals(expected, materials.material("inherited").orElseThrow());
+        assertEquals(expected, materials.material("restored").orElseThrow());
+        assertTrue(materials.material("always").isEmpty());
+        assertTrue(materials.material("unsupported").isEmpty());
+        for (final String value : List.of("null", "true", "4", "[\"LessEqual\"]", "{}", "\"lessEqual\"")) {
+            final var malformed = read("{\"invalid:entity_alphatest\":{\"depthFunc\":" + value + "}}");
+            assertTrue(malformed.material("invalid").isEmpty());
+        }
+    }
+
+    @Test
+    void resolvesNativeGpuMetadataWithCpuSkinnedBuffersWithoutBroadeningServerShaders() {
+        final var source = document("""
+            {"entity_static":{"vertexShader":"shaders/entity.vertex","fragmentShader":"shaders/entity.fragment",
+                "vertexFields":[{"field":"Position"},{"field":"Normal"},{"field":"UV0"}],
+                "variants":[{"skinning":{"+defines":["USE_SKINNING"]}}],
+                "+samplerStates":[{"samplerIndex":0,"textureFilter":"Point"}]},
+             "entity:entity_static":{"+defines":["USE_OVERLAY"]},
+             "entity_alphatest:entity":{"+defines":["ALPHA_TEST"],"+states":["DisableCulling"]},
+             "custom:entity_alphatest":{},"unsafe:custom":{"depthFunc":"Always"}}
+            """);
+        final var compiled = BedrockActorMaterialDefinitions.read(List.of(BedrockActorMaterialDefinitions.nativeDefinitions(source)));
+        assertFalse(compiled.material("custom").orElseThrow().cull());
+        assertTrue(compiled.material("unsafe").isEmpty());
+        assertTrue(BedrockActorMaterialDefinitions.read(List.of(source)).material("custom").isEmpty());
+        assertTrue(source.getAsJsonObject("materials").getAsJsonObject("entity_static").has("variants"));
+    }
+
+    @Test
+    void resolvesNativeAlphaTestInheritanceAndCulling() {
+        final var materials = read("""
+            {"banner:entity":{"+defines":["ALPHA_TEST"]},
+             "double_sided:banner":{"+states":["DisableCulling"]},
+             "single_sided:double_sided":{"-states":["DisableCulling"]}}
+            """);
+        assertTrue(materials.material("banner").orElseThrow().cull());
+        assertFalse(materials.material("double_sided").orElseThrow().cull());
+        assertTrue(materials.material("single_sided").orElseThrow().cull());
+        assertFalse(materials.material("entity_alphatest").orElseThrow().cull());
+        assertTrue(materials.material("entity_alphatest_one_sided").orElseThrow().cull());
+    }
+
+    @Test
+    void resolvesEmissiveAlphaInheritanceWithoutAcceptingOtherEffects() {
+        final var materials = read("""
+            {"cube:entity_emissive_alpha_one_sided":{},
+             "double_sided:cube":{"+states":["DisableCulling"]},
+             "unsupported:cube":{"+defines":["USE_ONLY_EMISSIVE"]}}
+            """);
+        assertTrue(materials.material("cube").orElseThrow().cull());
+        assertTrue(materials.material("cube").orElseThrow().emissive());
+        assertFalse(materials.material("double_sided").orElseThrow().cull());
+        assertTrue(materials.material("double_sided").orElseThrow().emissive());
+        assertTrue(materials.material("entity_emissive_alpha").orElseThrow().emissive());
+        assertTrue(materials.material("unsupported").isEmpty());
+    }
+
+    @Test
+    void higherPackReplacesTheWholeDefinitionAndItsParent() {
+        final var materials = BedrockActorMaterialDefinitions.read(List.of(document("""
+            {"banner:entity_alphatest":{"+states":["DisableDepthWrite"]},
+             "dependent:banner":{}}
+            """), document("""
+            {"banner:entity_alphatest_one_sided":{}}
+            """)));
+        assertTrue(materials.material("dependent").orElseThrow().cull());
+        final var separatePack = read("""
+            {"banner:entity_alphatest":{}}
+            """);
+        assertFalse(separatePack.material("banner").orElseThrow().cull());
+    }
+
+    @Test
+    void replacementAndRemovalSelectEffectiveShaderFlags() {
+        final var materials = read("""
+            {"emission:entity_alphatest":{"+defines":["USE_EMISSIVE"]},
+             "removed:emission":{"-defines":["USE_EMISSIVE"]},
+             "replacement:emission":{"defines":["USE_OVERLAY","ALPHA_TEST"],"states":[]},
+             "opaque:entity_alphatest":{"-defines":["ALPHA_TEST"]}}
+            """);
+        assertTrue(materials.material("emission").orElseThrow().emissive());
+        assertFalse(materials.material("removed").orElseThrow().emissive());
+        assertFalse(materials.material("replacement").orElseThrow().emissive());
+        assertFalse(materials.material("removed").orElseThrow().cull());
+        assertTrue(materials.material("replacement").orElseThrow().cull());
+        assertFalse(materials.material("opaque").orElseThrow().alphaTest());
+    }
+
+    @Test
+    void unsupportedShaderAndRenderStatesRetainFallback() {
+        final var materials = read("""
+            {"shader:entity_alphatest":{"fragmentShader":"shaders/other.fragment"},
+             "blend:entity_alphatest":{"+states":["Blending"]},
+             "depth:entity_alphatest":{"depthFunc":"Always"},
+             "uv:entity_alphatest":{"+defines":["USE_UV_ANIM"]},
+             "malformed:entity_alphatest":{"defines":false}}
+            """);
+        for (String name : List.of("shader", "blend", "depth", "malformed", "missing")) {
+            assertTrue(materials.material(name).isEmpty());
+        }
+    }
+
+    @Test
+    void recognizesUvAnimationOnlyAlongsideVerifiedShaderEffects() {
+        final var materials = read("""
+            {"moving:entity_alphatest":{"+defines":["USE_UV_ANIM"]},
+             "emissive:entity_emissive_alpha_one_sided":{"+defines":["USE_UV_ANIM"]},
+             "unsupported:moving":{"+defines":["USE_COLOR_MASK"]}}
+            """);
+        assertTrue(materials.material("moving").orElseThrow().uvAnimation());
+        assertTrue(materials.material("emissive").orElseThrow().uvAnimation());
+        assertTrue(materials.material("emissive").orElseThrow().emissive());
+        assertFalse(materials.material("entity_alphatest").orElseThrow().uvAnimation());
+        assertTrue(materials.material("unsupported").isEmpty());
+    }
+
+    @Test
+    void ignoresVerifiedNoOpDefinesWithoutIgnoringShaderEffectsOrStates() {
+        final var materials = read("""
+            {"compatibility:entity_alphatest_one_sided":{"+defines":["USE_MASK","Blending","USE_UV_ANIM"]},
+             "inherited:compatibility":{"+defines":["USE_EMISSIVE"],"+states":["DisableCulling"]},
+             "stationary:inherited":{"-defines":["USE_UV_ANIM"]},
+             "color_mask:compatibility":{"+defines":["USE_COLOR_MASK"]},
+             "unknown:compatibility":{"+defines":["FUTURE_SHADER_EFFECT"]},
+             "blend_state:compatibility":{"+states":["Blending"]}}
+            """);
+        assertEquals(new BedrockActorMaterialDefinitions.Material(true, true, false, true, false), materials.material("compatibility").orElseThrow());
+        assertEquals(new BedrockActorMaterialDefinitions.Material(true, false, true, true, false), materials.material("inherited").orElseThrow());
+        assertEquals(new BedrockActorMaterialDefinitions.Material(true, false, true, false, false), materials.material("stationary").orElseThrow());
+        for (String name : List.of("color_mask", "unknown", "blend_state")) {
+            assertTrue(materials.material(name).isEmpty());
+        }
+    }
+
+    @Test
+    void cyclicAndMissingParentsDoNotResolve() {
+        final var materials = read("""
+            {"a:b":{},"b:a":{},"self:self":{},"missing_parent:absent":{}}
+            """);
+        for (String name : List.of("a", "b", "self", "missing_parent")) {
+            assertTrue(materials.material(name).isEmpty());
+        }
+    }
+
+    @Test
+    void malformedDocumentsPreserveValidNeighborDefinitions() {
+        final var materials = BedrockActorMaterialDefinitions.read(List.of(
+            document("null"), document("[]"), document("false"), document("\"invalid\""),
+            document("{\"banner:entity_alphatest_one_sided\":{}}")));
+        assertTrue(materials.material("banner").orElseThrow().cull());
+    }
+
+    private static BedrockActorMaterialDefinitions read(final String materials) {
+        return BedrockActorMaterialDefinitions.read(List.of(document(materials)));
+    }
+
+    private static JsonObject document(final String materials) {
+        return JsonParser.parseString("{\"materials\":" + materials + "}").getAsJsonObject();
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialsGpuTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialsGpuTest.java
new file mode 100644
index 0000000..0ed9ef3
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorMaterialsGpuTest.java
@@ -0,0 +1,185 @@
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import org.lwjgl.system.MemoryStack;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.lwjgl.opengl.GL33C.*;
+
+/** Compares real fragment pixels and depth against externally captured target shader controls. */
+@EnabledIfEnvironmentVariable(named = "STACKANVIL_IRIS_ALPHA_GPU_TESTS", matches = "1")
+@EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ACTOR_MATERIALS", matches = ".+")
+final class BedrockActorMaterialsGpuTest {
+    @Test
+    void matchesNativeOpaqueAndAlphaTestFragmentsWithoutDiscardingOpaqueDepth() throws IOException {
+        final var reference = JsonParser.parseString(Files.readString(
+                Path.of(System.getenv("STACKANVIL_NATIVE_ACTOR_MATERIALS")))).getAsJsonObject();
+        final var cases = reference.getAsJsonArray("cases");
+        assertEquals(672, cases.size());
+        EglTestContext.run(() -> verify(cases));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_MASKED_MATERIALS", matches = ".+")
+    void matchesNativeMaskedOverwriteColorDiscardAndDepth() throws IOException {
+        final var reference = JsonParser.parseString(Files.readString(
+                Path.of(System.getenv("STACKANVIL_NATIVE_MASKED_MATERIALS")))).getAsJsonObject();
+        final var cases = reference.getAsJsonArray("cases");
+        assertEquals(512, cases.size());
+        EglTestContext.run(() -> verify(cases));
+    }
+
+    private static void verify(final com.google.gson.JsonArray cases) {
+        final int vao = glGenVertexArrays(), framebuffer = glGenFramebuffers();
+        final int color = glGenTextures(), depth = glGenTextures(), source = glGenTextures(), secondary = glGenTextures();
+        final int fog = glGenBuffers(), dynamic = glGenBuffers();
+        final var programs = new HashMap<com.mojang.renderpearl.api.pipeline.RenderPipeline, Integer>();
+        try {
+            glBindVertexArray(vao);
+            glBindTexture(GL_TEXTURE_2D, color);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, 1, 1, 0, GL_RGBA, GL_FLOAT, 0L);
+            glBindTexture(GL_TEXTURE_2D, depth);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT32F, 1, 1, 0, GL_DEPTH_COMPONENT, GL_FLOAT, 0L);
+            glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, color, 0);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depth, 0);
+            assertEquals(GL_FRAMEBUFFER_COMPLETE, glCheckFramebufferStatus(GL_FRAMEBUFFER));
+            glViewport(0, 0, 1, 1);
+            glDisable(GL_BLEND);
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(GL_LESS);
+            glDepthMask(true);
+            for (final var element : cases) {
+                final var control = element.getAsJsonObject();
+                final boolean masked = control.has("secondary");
+                final var material = new BedrockActorMaterialDefinitions.Material(masked || control.get("alphaTest").getAsBoolean(),
+                        false, !masked && control.get("emissive").getAsBoolean(), false, masked);
+                final var pipeline = BedrockActorRenderTypes.selectPipeline(material,
+                        !masked && control.get("ignoreLighting").getAsBoolean(), false);
+                final int program = programs.computeIfAbsent(pipeline, BedrockActorMaterialsGpuTest::program);
+                glUseProgram(program);
+                vector(program, "inputVertex", floats(control, "vertex"));
+                vector(program, "inputLightmap", floats(control, "lightmap"));
+                vector(program, "inputOverlay", floats(control, "overlay"));
+                final float[] fogInput = floats(control, "fog"), modulator = floats(control, "modulator");
+                glUniform1f(glGetUniformLocation(program, "inputDistance"), fogInput[3]);
+                try (var stack = MemoryStack.stackPush()) {
+                    final var fogBytes = stack.callocFloat(12);
+                    fogBytes.put(0, fogInput[0]).put(1, fogInput[1]).put(2, fogInput[2]).put(3, 1F);
+                    fogBytes.put(5, 1F).put(7, 1F);
+                    buffer(program, "Fog", fog, 0, fogBytes);
+                    final var dynamicBytes = stack.callocFloat(40);
+                    for (int i = 0; i < 4; i++) dynamicBytes.put(32 + i, modulator[i]);
+                    buffer(program, "DynamicTransforms", dynamic, 1, dynamicBytes);
+                    glActiveTexture(GL_TEXTURE0);
+                    glBindTexture(GL_TEXTURE_2D, source);
+                    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, 1, 1, 0, GL_RGBA, GL_FLOAT,
+                            stack.floats(floats(control, masked ? "primary" : "texture")));
+                    glUniform1i(glGetUniformLocation(program, "Sampler0"), 0);
+                    if (masked) {
+                        glActiveTexture(GL_TEXTURE1);
+                        glBindTexture(GL_TEXTURE_2D, secondary);
+                        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, 1, 1, 0, GL_RGBA, GL_FLOAT,
+                                stack.floats(floats(control, "secondary")));
+                        glUniform1i(glGetUniformLocation(program, "BedrockMaskTexture"), 1);
+                    }
+                    glClearColor(.8F, .6F, .4F, 1F);
+                    glClearDepth(1);
+                    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+                    glDrawArrays(GL_TRIANGLES, 0, 3);
+                    final var pixel = stack.mallocFloat(4);
+                    final var depthPixel = stack.mallocFloat(1);
+                    glReadPixels(0, 0, 1, 1, GL_RGBA, GL_FLOAT, pixel);
+                    glReadPixels(0, 0, 1, 1, GL_DEPTH_COMPONENT, GL_FLOAT, depthPixel);
+                    final boolean discarded = control.get("discarded").getAsBoolean();
+                    final float[] expected = discarded ? new float[] {.8F, .6F, .4F, 1F} : floats(control, "expected");
+                    for (int i = 0; i < 4; i++) assertEquals(expected[i], pixel.get(i), .000001F, control::toString);
+                    assertEquals(discarded ? 1F : .5F, depthPixel.get(0), .000001F, control::toString);
+                }
+            }
+        } finally {
+            glUseProgram(0);
+            programs.values().forEach(program -> glDeleteProgram(program));
+            glBindFramebuffer(GL_FRAMEBUFFER, 0);
+            glDeleteFramebuffers(framebuffer);
+            glDeleteTextures(color); glDeleteTextures(depth); glDeleteTextures(source); glDeleteTextures(secondary);
+            glDeleteBuffers(fog); glDeleteBuffers(dynamic); glDeleteVertexArrays(vao);
+        }
+    }
+
+    private static void buffer(final int program, final String name, final int buffer, final int binding,
+                               final java.nio.FloatBuffer bytes) {
+        glBindBuffer(GL_UNIFORM_BUFFER, buffer);
+        glBufferData(GL_UNIFORM_BUFFER, bytes, GL_STATIC_DRAW);
+        glBindBufferBase(GL_UNIFORM_BUFFER, binding, buffer);
+        glUniformBlockBinding(program, glGetUniformBlockIndex(program, name), binding);
+    }
+
+    private static float[] floats(final JsonObject object, final String key) {
+        final var array = object.getAsJsonArray(key);
+        final float[] values = new float[array.size()];
+        for (int i = 0; i < values.length; i++) values[i] = array.get(i).getAsFloat();
+        return values;
+    }
+
+    private static void vector(final int program, final String name, final float[] value) {
+        glUniform4f(glGetUniformLocation(program, name), value[0], value[1], value[2], value[3]);
+    }
+
+    private static int program(final com.mojang.renderpearl.api.pipeline.RenderPipeline pipeline) {
+        final String vertex = """
+                #version 330
+                #extension GL_ARB_separate_shader_objects : require
+                uniform vec4 inputVertex, inputLightmap, inputOverlay;
+                uniform float inputDistance;
+                layout(location=0) out float sphericalVertexDistance;
+                layout(location=1) out float cylindricalVertexDistance;
+                layout(location=2) out vec4 vertexColor;
+                layout(location=4) out vec4 lightMapColor;
+                layout(location=5) out vec4 overlayColor;
+                layout(location=6) out vec2 texCoord0;
+                void main() {
+                    vec2 position=vec2((gl_VertexID<<1)&2, gl_VertexID&2);
+                    gl_Position=vec4(position*2.0-1.0,0.0,1.0);
+                    sphericalVertexDistance=inputDistance; cylindricalVertexDistance=inputDistance;
+                    vertexColor=inputVertex; lightMapColor=inputLightmap; overlayColor=inputOverlay; texCoord0=vec2(0.5);
+                }
+                """;
+        final String fragment = resource("/assets/viafabricplus-bedrock/shaders/core/bedrock_actor.fsh")
+                .replace("#version 330", "#version 330\n" + pipeline.getShaderDefines().asSourceDirectives())
+                .replace("#include <minecraft:fog.glsl>", resource("/assets/minecraft/shaders/include/fog.glsl"))
+                .replace("#include <minecraft:dynamictransforms.glsl>", resource("/assets/minecraft/shaders/include/dynamictransforms.glsl"));
+        final int vs = shader(GL_VERTEX_SHADER, vertex), fs = shader(GL_FRAGMENT_SHADER, fragment), program = glCreateProgram();
+        try {
+            glAttachShader(program, vs); glAttachShader(program, fs); glLinkProgram(program);
+            assertEquals(GL_TRUE, glGetProgrami(program, GL_LINK_STATUS), glGetProgramInfoLog(program));
+            return program;
+        } finally { glDeleteShader(vs); glDeleteShader(fs); }
+    }
+
+    private static int shader(final int type, final String source) {
+        final int shader = glCreateShader(type);
+        glShaderSource(shader, source); glCompileShader(shader);
+        assertEquals(GL_TRUE, glGetShaderi(shader, GL_COMPILE_STATUS), glGetShaderInfoLog(shader));
+        return shader;
+    }
+
+    private static String resource(final String path) {
+        try (final var input = BedrockActorMaterialsGpuTest.class.getResourceAsStream(path)) {
+            assertNotNull(input, path);
+            return new String(input.readAllBytes(), StandardCharsets.UTF_8);
+        } catch (final IOException failure) { throw new IllegalStateException(failure); }
+    }
+}
