+/** Publishes immutable actor render state across the protocol and render threads. */
+public final class CustomEntityRenderStore {
+
+    private static final Map<UUID, RenderData> MODELS = new ConcurrentHashMap<>();
+
+    private CustomEntityRenderStore() {
+    }
+
+    public static void update(final UUID uuid, final String identifier, final float scale, final List<CustomEntity.EvaluatedModel> models) {
+        MODELS.put(uuid, new RenderData(identifier, scale, List.copyOf(models)));
+    }
+
+    public static RenderData get(final UUID uuid) {
+        return MODELS.get(uuid);
+    }
+
+    public static void remove(final UUID uuid) {
+        MODELS.remove(uuid);
+    }
+
+    public static void clear() {
+        MODELS.clear();
+    }
+
+    public record RenderData(String identifier, float scale, List<CustomEntity.EvaluatedModel> models) {
+    }
+
+}
