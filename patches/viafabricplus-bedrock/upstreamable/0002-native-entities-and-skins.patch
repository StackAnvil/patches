index 0000000..7854792
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderEmission.java
@@ -0,0 +1,196 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockActorRenderType;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockDynamicTexture;
+import java.io.IOException;
+import java.lang.invoke.MethodHandles;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+import java.util.function.BooleanSupplier;
+import net.fabricmc.loader.api.FabricLoader;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.renderer.rendertype.RenderSetup;
+import net.minecraft.client.renderer.RenderPipelines;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.BlendFunction;
+import net.minecraft.client.renderer.texture.AbstractTexture;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+
+/** Retains the native inverse-alpha mask when a shader pack replaces the actor shader. */
+public final class BedrockShaderEmission {
+    private static final Map<RenderPipeline, RenderPipeline> EMISSION_PIPELINES = emissionPipelines();
+    public static final List<RenderPipeline> PIPELINES = List.copyOf(EMISSION_PIPELINES.values());
+    private static final BooleanSupplier SHADERS = shaderState();
+    private static final Map<RenderType, EmissionKey> MATERIALS = new WeakHashMap<>();
+    private static final Map<Identifier, Textures> TEXTURES = new HashMap<>();
+    private static final Set<Identifier> FAILED = new HashSet<>();
+    private static final List<Textures> RETIRED = new java.util.ArrayList<>();
+    private static long nextTexture;
+
+    private BedrockShaderEmission() {}
+
+    private static Map<RenderPipeline, RenderPipeline> emissionPipelines() {
+        final Map<RenderPipeline, RenderPipeline> result = new java.util.IdentityHashMap<>();
+        for (final var body : BedrockActorRenderTypes.PIPELINES) {
+            final var flags = body.getShaderDefines().flags();
+            if (flags.contains("USE_EMISSIVE") || flags.contains("GUI_PORTRAIT") || flags.contains("MASKED_MULTITEXTURE")) continue;
+            final var emission = BedrockShaderPipelines.register(RenderPipeline.builder(RenderPipelines.ENTITY_SNIPPET, RenderPipelines.EYES_SNIPPET)
+                    .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", body.getLocation().getPath() + "_emission"))
+                    .withBindGroupLayout(net.minecraft.client.renderer.BindGroupLayouts.SAMPLER1)
+                    .withCull(body.isCull()).withColorTargetState(new ColorTargetState(BlendFunction.ADDITIVE))
+                    .withDepthStencilState(RenderPipelines.EYES.getDepthStencilState()).build(), RenderPipelines.EYES);
+            result.put(body, emission);
+        }
+        return java.util.Collections.unmodifiableMap(result);
+    }
+
+    /** The additive draw must use the same pack vertex stages as its depth-writing body. */
+    public static RenderPipeline bodyPipeline(final RenderPipeline emission) {
+        if (emission == null) return null;
+        for (final var entry : EMISSION_PIPELINES.entrySet()) if (entry.getValue() == emission) return entry.getKey();
+        return null;
+    }
+
+    static void register(final RenderType type, final Identifier texture, final BedrockActorMaterialDefinitions.Material material,
+                         final boolean unlit, final float multiplier, final BedrockActorUvTransform uv,
+                         final boolean nether) {
+        MATERIALS.put(type, new EmissionKey(texture, material, unlit, multiplier, uv, nether));
+    }
+
+    public static List<Pass> passes(final RenderType type) {
+        final EmissionKey material = MATERIALS.get(type);
+        if (material == null || !SHADERS.getAsBoolean()) return List.of(new Pass(type, false));
+        try {
+            final Textures textures = textures(material.texture());
+            return textures.passes.computeIfAbsent(material, key -> {
+                final RenderType lit = BedrockActorRenderTypes.create(List.of(textures.litId), key.material().withoutEmission(), key.unlit(), key.multiplier(), key.uv(), key.nether());
+                final RenderType emission = RenderType.create("bedrock_emission", RenderSetup.builder(EMISSION_PIPELINES.get(lit.pipeline()))
+                        .withTexture("Sampler0", textures.emissionId).useLightmap().useOverlay().createRenderSetup());
+                // Radiance bypasses the native lighting multiplier but shares its texture coordinates.
+                ((IBedrockActorRenderType) emission).bedrock$uvTransform(key.uv());
+                return List.of(new Pass(lit, false), new Pass(emission, true));
+            });
+        } catch (IOException | RuntimeException invalid) {
+            if (FAILED.add(material.texture())) ViaFabricPlusBedrock.impl().logger()
+                    .warn("Could not retain the native emissive mask for {}", material.texture(), invalid);
+            return List.of(new Pass(type, false));
+        }
+    }
+
+    private static Textures textures(final Identifier id) throws IOException {
+        final var minecraft = Minecraft.getInstance();
+        final var manager = minecraft.getTextureManager();
+        final AbstractTexture source = manager.getTexture(id);
+        final long generation = source instanceof IBedrockDynamicTexture dynamic ? dynamic.bedrock$uploadGeneration() : 0;
+        Textures cached = TEXTURES.get(id);
+        if (cached != null && cached.source == source && cached.generation == generation) return cached;
+        NativeImage image = null;
+        final boolean borrowed = source instanceof DynamicTexture;
+        try {
+            if (source instanceof DynamicTexture dynamic) image = dynamic.getPixels();
+            else try (final var input = minecraft.getResourceManager().getResourceOrThrow(id).open()) {
+                image = NativeImage.read(input);
+            }
+            if (image == null || image.isClosed()) throw new IOException("Missing native texture pixels");
+            if (cached == null || cached.width != image.getWidth() || cached.height != image.getHeight()) {
+                // Keep queued draws valid until the resource lifetime ends, including size-changing uploads.
+                final String path = "shader_emission/" + nextTexture++;
+                cached = new Textures(source, image.getWidth(), image.getHeight(),
+                        Identifier.fromNamespaceAndPath("viafabricplus-bedrock", path + "/lit"),
+                        Identifier.fromNamespaceAndPath("viafabricplus-bedrock", path + "/emission"));
+                if (TEXTURES.containsKey(id)) RETIRED.add(TEXTURES.get(id));
+                TEXTURES.put(id, cached);
+                manager.register(cached.litId, cached.lit);
+                manager.register(cached.emissionId, cached.emission);
+            }
+            for (int y = 0; y < image.getHeight(); y++) for (int x = 0; x < image.getWidth(); x++) {
+                final int pixel = image.getPixel(x, y);
+                cached.lit.getPixels().setPixel(x, y, BedrockEmissiveMask.lit(pixel));
+                cached.emission.getPixels().setPixel(x, y, BedrockEmissiveMask.emission(pixel));
+            }
+            cached.lit.upload();
+            cached.emission.upload();
+            cached.source = source;
+            cached.generation = generation;
+            return cached;
+        } finally {
+            if (!borrowed && image != null) image.close();
+        }
+    }
+
+    public static void clear() {
+        if (!TEXTURES.isEmpty() || !RETIRED.isEmpty()) {
+            final var manager = Minecraft.getInstance().getTextureManager();
+            for (final Textures textures : TEXTURES.values()) textures.release(manager);
+            for (final Textures textures : RETIRED) textures.release(manager);
+        }
+        TEXTURES.clear();
+        RETIRED.clear();
+        FAILED.clear();
+    }
+
+    private static BooleanSupplier shaderState() {
+        if (!FabricLoader.getInstance().isModLoaded("iris")) return () -> false;
+        try {
+            // Link only the installed public Iris API, without a required Iris dependency.
+            final Class<?> api = Class.forName("net.irisshaders.iris.api.v0.IrisApi");
+            final Object instance = api.getMethod("getInstance").invoke(null);
+            final var active = MethodHandles.publicLookup().unreflect(api.getMethod("isShaderPackInUse")).bindTo(instance);
+            return () -> {
+                try { return (boolean) active.invokeExact(); }
+                catch (Throwable failure) { throw new IllegalStateException("Could not read Iris shader state", failure); }
+            };
+        } catch (ReflectiveOperationException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not link the installed Iris API", invalid);
+            return () -> false;
+        }
+    }
+
+    public record Pass(RenderType type, boolean emission) {}
+    private record EmissionKey(Identifier texture, BedrockActorMaterialDefinitions.Material material, boolean unlit, float multiplier,
+                            BedrockActorUvTransform uv, boolean nether) {}
+
+    private static final class Textures {
+        private AbstractTexture source;
+        private long generation;
+        private final int width, height;
+        private final Identifier litId, emissionId;
+        private final DynamicTexture lit, emission;
+        private final Map<EmissionKey, List<Pass>> passes = new java.util.LinkedHashMap<>(16, .75F, true) {
+            @Override
+            protected boolean removeEldestEntry(final Map.Entry<EmissionKey, List<Pass>> eldest) {
+                return this.size() > 256;
+            }
+        };
+
+        private Textures(final AbstractTexture source, final int width, final int height,
+                         final Identifier litId, final Identifier emissionId) {
+            this.source = source;
+            this.width = width;
+            this.height = height;
+            this.litId = litId;
+            this.emissionId = emissionId;
+            this.lit = new DynamicTexture("Bedrock lit surface", width, height, false);
+            this.emission = new DynamicTexture("Bedrock emitted radiance", width, height, false);
+        }
+
+        private void release(final net.minecraft.client.renderer.texture.TextureManager manager) {
+            manager.release(this.litId);
+            manager.release(this.emissionId);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderPipelines.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderPipelines.java
