+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.awt.image.BufferedImage;
+import org.cube.converter.model.element.Cube;
+import org.cube.converter.model.element.Parent;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.cube.converter.util.element.Position2V;
+import org.cube.converter.util.element.Position3V;
+import org.cube.converter.util.element.UVMap;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockSkinImagesTest {
+    @Test
+    void doubleSizeTexturesUseTheDeclaredGeometryAtlasForEveryHeadFace() {
+        final BufferedImage source = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 128; y++) for (int x = 0; x < 128; x++)
+            source.setRGB(x, y, 0xFF000000 | y << 12 | x);
+        for (final int nativeSize : new int[] {64, 128}) {
+            final var model = head(nativeSize);
+            final BufferedImage atlas = BedrockSkinImages.javaHeadTexture(source, model);
+            if (nativeSize == 64) assertSame(source, atlas);
+            else assertNotSame(source, atlas);
+            for (final int offset : new int[] {0, 32}) {
+                for (final var uv : UVMap.fromBoxUV(new Position3V(8, 8, 8), new Float[]{(float) offset, 0F}, false).getUvMap().values()) {
+                    for (int y = Math.round(Math.min(uv[1], uv[3]) * 2); y < Math.round(Math.max(uv[1], uv[3]) * 2); y++) {
+                        for (int x = Math.round(Math.min(uv[0], uv[2]) * 2); x < Math.round(Math.max(uv[0], uv[2]) * 2); x++)
+                            assertEquals(source.getRGB(x * 64 / nativeSize, y * 64 / nativeSize), atlas.getRGB(x, y));
+                    }
+                }
+            }
+        }
+        assertEquals(0xFF018018, source.getRGB(24, 24));
+    }
+
+    private static BedrockGeometryModel head(final int textureSize) {
+        final var model = new BedrockGeometryModel("geometry.head", new Position2V(textureSize, textureSize));
+        final var bone = new Parent("head", new Position3V(0, 0, 0), new Position3V(0, 0, 0));
+        for (final int offset : new int[] {0, 32}) {
+            final var cube = new Cube(new Position3V(0, 0, 0), new Position3V(-4, 24, -4), new Position3V(8, 8, 8),
+                new Position3V(0, 0, 0), false, UVMap.fromBoxUV(new Position3V(8, 8, 8), new Float[]{(float) offset, 0F}, false));
+            cube.setInflate(offset == 0 ? 0 : .25F);
+            bone.getCubes().put(offset, cube);
+        }
+        model.getParents().add(bone);
+        return model;
+    }
+
+    @Test
+    void legacyHeadAndHatKeepTheirPixelsAtJavaGlyphCoordinates() {
+        for (final int scale : new int[] {1, 2, 4}) {
+            final BufferedImage legacy = new BufferedImage(64 * scale, 32 * scale, BufferedImage.TYPE_INT_ARGB);
+            for (int y = 0; y < legacy.getHeight(); y++) {
+                for (int x = 0; x < legacy.getWidth(); x++) legacy.setRGB(x, y, 0xFF000000 | y << 12 | x);
+            }
+            final BufferedImage square = BedrockSkinImages.javaHeadTexture(legacy);
+            assertEquals(64 * scale, square.getHeight());
+            for (final int faceX : new int[] {8, 40}) {
+                for (int y = 8 * scale; y < 16 * scale; y++) {
+                    for (int x = faceX * scale; x < (faceX + 8) * scale; x++) {
+                        assertEquals(legacy.getRGB(x, y), square.getRGB(x, y));
+                    }
+                }
+            }
+            assertEquals(0, square.getRGB(8 * scale, 40 * scale));
+            assertEquals(32 * scale, legacy.getHeight());
+        }
+    }
+
+    @Test
+    void squareAndCustomAtlasImagesRemainUnchanged() {
+        for (final int[] size : new int[][] {{64, 64}, {128, 128}, {32, 32}, {256, 128 + 1}}) {
+            final BufferedImage source = new BufferedImage(size[0], size[1], BufferedImage.TYPE_INT_ARGB);
+            assertSame(source, BedrockSkinImages.javaHeadTexture(source));
+        }
+    }
+}
