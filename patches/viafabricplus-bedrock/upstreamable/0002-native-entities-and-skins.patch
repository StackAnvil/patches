+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.Map;
+import java.util.Arrays;
+import org.cube.converter.model.element.Cube;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.cube.converter.util.element.Direction;
+import org.cube.converter.util.element.Position3V;
+import org.cube.converter.util.element.UVMap;
+
+final class BedrockSkinImages {
+    private BedrockSkinImages() { }
+
+    /** Projects authored head faces onto the atlas sampled by Java glyphs and skulls. */
+    static BufferedImage javaHeadTexture(final BufferedImage source, final BedrockGeometryModel model) {
+        if (model == null || !Float.isFinite(model.getTextureSize().getX()) || !Float.isFinite(model.getTextureSize().getY())
+            || model.getTextureSize().getX() <= 0 || model.getTextureSize().getY() <= 0)
+            return javaHeadTexture(source);
+        final List<Cube> head = cubes(model, "head");
+        final Cube face = head.stream().filter(cube -> cube.getInflate() <= 0).findFirst().orElse(null);
+        final Cube hat = cubes(model, "hat").stream().findFirst()
+            .orElseGet(() -> head.stream().filter(cube -> cube.getInflate() > 0).findFirst().orElse(null));
+        if (!ordinaryHead(face) || hat != null && !ordinaryHead(hat)) return javaHeadTexture(source);
+        final int size = Math.max(64, source.getWidth());
+        if (sameCoordinates(source, model, face, 0, size) && hat != null && sameCoordinates(source, model, hat, 32, size))
+            return javaHeadTexture(source);
+        final BufferedImage atlas = new BufferedImage(size, size, BufferedImage.TYPE_INT_ARGB);
+        copyFaces(source, atlas, model, face, 0);
+        if (hat != null) copyFaces(source, atlas, model, hat, 32);
+        return atlas;
+    }
+
+    private static List<Cube> cubes(final BedrockGeometryModel model, final String bone) {
+        return model.getParents().stream().filter(parent -> parent.getName().equalsIgnoreCase(bone))
+            .flatMap(parent -> parent.getCubes().entrySet().stream().sorted(Map.Entry.comparingByKey()).map(Map.Entry::getValue))
+            .toList();
+    }
+
+    private static boolean ordinaryHead(final Cube cube) {
+        return cube != null && cube.getSize().getX() == 8 && cube.getSize().getY() == 8 && cube.getSize().getZ() == 8
+            && cube.getRotation().getX() == 0 && cube.getRotation().getY() == 0 && cube.getRotation().getZ() == 0
+            && cube.getUvMap().getUvRotation().values().stream().allMatch(rotation -> rotation == 0);
+    }
+
+    private static UVMap target(final int offset) {
+        return UVMap.fromBoxUV(new Position3V(8, 8, 8), new Float[]{(float) offset, 0F}, false);
+    }
+
+    private static boolean sameCoordinates(final BufferedImage source, final BedrockGeometryModel model,
+                                           final Cube cube, final int offset, final int size) {
+        if (cube.getUvMap().getUvType() != UVMap.UVType.BOX) return false;
+        for (final var entry : target(offset).getUvMap().entrySet()) {
+            final Float[] uv = cube.getUvMap().getUvMap().get(entry.getKey());
+            if (uv == null) return false;
+            for (int i = 0; i < 4; i++) {
+                final float pixels = uv[i] * (i % 2 == 0 ? source.getWidth() / model.getTextureSize().getX()
+                    : source.getHeight() / model.getTextureSize().getY());
+                if (pixels != entry.getValue()[i] * size / 64) return false;
+            }
+        }
+        return true;
+    }
+
+    private static void copyFaces(final BufferedImage source, final BufferedImage atlas, final BedrockGeometryModel model,
+                                  final Cube cube, final int offset) {
+        final float scale = atlas.getWidth() / 64F;
+        for (final var entry : target(offset).getUvMap().entrySet()) {
+            final Float[] uv = cube.getUvMap().getUvMap().get(entry.getKey());
+            if (uv == null || Arrays.stream(uv).anyMatch(value -> value == null || !Float.isFinite(value))) continue;
+            final Float[] destination = entry.getValue();
+            final int left = Math.round(Math.min(destination[0], destination[2]) * scale);
+            final int top = Math.round(Math.min(destination[1], destination[3]) * scale);
+            final int right = Math.round(Math.max(destination[0], destination[2]) * scale);
+            final int bottom = Math.round(Math.max(destination[1], destination[3]) * scale);
+            final boolean turn = cube.getUvMap().getUvType() != UVMap.UVType.BOX
+                && (entry.getKey() == Direction.UP || entry.getKey() == Direction.DOWN);
+            for (int y = top; y < bottom; y++) for (int x = left; x < right; x++) {
+                float u = ((x + .5F) / scale - destination[0]) / (destination[2] - destination[0]);
+                float v = ((y + .5F) / scale - destination[1]) / (destination[3] - destination[1]);
+                if (turn) { u = 1 - u; v = 1 - v; }
+                final int sourceX = (int) Math.floor((uv[0] + u * (uv[2] - uv[0])) * source.getWidth() / model.getTextureSize().getX());
+                final int sourceY = (int) Math.floor((uv[1] + v * (uv[3] - uv[1])) * source.getHeight() / model.getTextureSize().getY());
+                if (sourceX >= 0 && sourceY >= 0 && sourceX < source.getWidth() && sourceY < source.getHeight())
+                    atlas.setRGB(x, y, source.getRGB(sourceX, sourceY));
+            }
+        }
+    }
+
+    /** Legacy skins keep their head and hat in the top half of the modern square atlas. */
+    static BufferedImage javaHeadTexture(final BufferedImage source) {
+        final int width = source.getWidth();
+        final int height = source.getHeight();
+        if (width != height * 2) return source;
+        final BufferedImage square = new BufferedImage(width, width, BufferedImage.TYPE_INT_ARGB);
+        square.setRGB(0, 0, width, height, source.getRGB(0, 0, width, height, null, 0, width), 0, width);
+        return square;
+    }
+}
