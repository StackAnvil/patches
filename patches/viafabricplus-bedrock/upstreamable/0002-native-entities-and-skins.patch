@@ -0,0 +1,38 @@
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.concurrent.CompletableFuture;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockShaderAlphaTest {
+    @Test
+    void scopesTheReferenceToEachBindingAndRestoresNestedJavaAndNativeDraws() {
+        assertEquals(0.1F, BedrockShaderAlpha.reference(0.1F));
+        BedrockShaderAlpha.bind(0.5F, true, () -> {
+            assertTrue(BedrockShaderAlpha.masked());
+            assertEquals(0.5F, BedrockShaderAlpha.reference(0.1F));
+            BedrockShaderAlpha.bind(Float.NaN, () -> {
+                assertFalse(BedrockShaderAlpha.masked());
+                assertEquals(0.1F, BedrockShaderAlpha.reference(0.1F));
+            });
+            assertTrue(BedrockShaderAlpha.masked());
+            assertEquals(0.5F, BedrockShaderAlpha.reference(0.1F));
+            BedrockShaderAlpha.bind(0F, () -> assertEquals(0F, BedrockShaderAlpha.reference(0.1F)));
+            assertEquals(0.5F, BedrockShaderAlpha.reference(0.1F));
+        });
+        assertFalse(BedrockShaderAlpha.masked());
+        assertEquals(0.1F, BedrockShaderAlpha.reference(0.1F));
+    }
+
+    @Test
+    void restoresTheBindingAfterFailureAndDoesNotAffectOtherThreads() {
+        final var failure = new IllegalStateException();
+        assertSame(failure, assertThrows(IllegalStateException.class, () -> BedrockShaderAlpha.bind(0.5F, () -> {
+            assertEquals(0.1F, CompletableFuture.supplyAsync(() -> BedrockShaderAlpha.reference(0.1F)).join());
+            throw failure;
+        })));
+        assertFalse(BedrockShaderAlpha.masked());
+        assertEquals(0.1F, BedrockShaderAlpha.reference(0.1F));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderPipelinesTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockShaderPipelinesTest.java
