+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import net.raphimc.viabedrock.api.model.NativeCustomEntityMessage;
+import java.util.List;
+
+final class CustomEntityRenderStoreTest {
+
+    @Test
+    void scaleUpdatesPublishIndependentImmutableSnapshots() {
+        final UUID uuid = UUID.randomUUID();
+        final var models = new ArrayList<CustomEntity.EvaluatedModel>();
+        try {
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(uuid, "test:actor", 5F, models));
+            final var before = CustomEntityRenderStore.get(uuid);
+            models.add(null);
+            assertEquals(0, before.models().size());
+
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(uuid, "test:actor", 1.7F, before.models()));
+            assertEquals(5F, before.scale());
+            assertEquals(1.7F, CustomEntityRenderStore.get(uuid).scale());
+        } finally {
+            CustomEntityRenderStore.clear();
+        }
+    }
+
+    @Test
+    void clearsSelectionsRemovesActorsAndSeparatesReusedIdentities() {
+        final UUID first = UUID.randomUUID();
+        final UUID second = UUID.randomUUID();
+        final var model = new CustomEntity.EvaluatedModel("body", "geometry.body", "textures/body", java.util.Map.of(), false, 1F, null);
+        try {
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(first, "test:actor", 2F, List.of(model)));
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(second, "test:actor", 3F, List.of(model)));
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(first, "test:actor", 0F, List.of()));
+            assertTrue(CustomEntityRenderStore.get(first).models().isEmpty());
+            assertEquals(0F, CustomEntityRenderStore.get(first).scale());
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Remove(first));
+            assertNull(CustomEntityRenderStore.get(first));
+            assertEquals(3F, CustomEntityRenderStore.get(second).scale());
+            CustomEntityRenderStore.apply(new NativeCustomEntityMessage.Snapshot(first, "test:replacement", -1F, List.of(model)));
+            assertEquals(-1F, CustomEntityRenderStore.get(first).scale());
+            CustomEntityRenderStore.clear();
+            assertNull(CustomEntityRenderStore.get(first));
+            assertNull(CustomEntityRenderStore.get(second));
+        } finally {
+            CustomEntityRenderStore.clear();
+        }
+    }
+
+}
