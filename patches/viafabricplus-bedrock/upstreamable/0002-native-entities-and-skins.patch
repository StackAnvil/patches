+    private Supplier<PlayerSkinRenderCache.RenderInfo> nativeLookup(final ResolvableProfile profile,
+            final Operation<Supplier<PlayerSkinRenderCache.RenderInfo>> original) {
+        final var fallback = original.call(profile);
+        // Glyphs keep their supplier. Resolve again so later skin packets and resource reloads remain visible.
+        return () -> this.nativeHead(profile, fallback.get());
+    }
+
+    @Inject(method = "getOrDefault", at = @At("RETURN"), cancellable = true)
+    private void nativeDefault(final ResolvableProfile profile,
+            final CallbackInfoReturnable<PlayerSkinRenderCache.RenderInfo> result) {
+        result.setReturnValue(this.nativeHead(profile, result.getReturnValue()));
+    }
+
+    @Unique
+    private PlayerSkinRenderCache.RenderInfo nativeHead(final ResolvableProfile profile,
+                                                        final PlayerSkinRenderCache.RenderInfo fallback) {
+        final var skin = BedrockPlayerSkins.headSkin(profile.partialProfile().id(), fallback.playerSkin());
+        if (skin == fallback.playerSkin()) {
+            this.nativeHeads.remove(profile);
+            return fallback;
+        }
+        final var cached = this.nativeHeads.get(profile);
+        if (cached != null && cached.playerSkin().equals(skin)) return cached;
+        final var installed = ((PlayerSkinRenderCache) (Object) this).new RenderInfo(profile.partialProfile(), skin, profile.skinPatch());
+        this.nativeHeads.put(profile, installed);
+        return installed;
+    }
+}
