diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockRenderSnapshotCacheTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockRenderSnapshotCacheTest.java
new file mode 100644
index 0000000..4a9a4de
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockRenderSnapshotCacheTest.java
@@ -0,0 +1,123 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockRenderSnapshotCacheTest {
+    @Test
+    void resolvesRetainedSnapshotsOnceAcrossRepeatedFrames() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, List<String>>(8);
+        final Object snapshot = new Object();
+        final Object generation = new Object();
+        final AtomicInteger resolutions = new AtomicInteger();
+        final var expected = cache.resolve("actor", snapshot, generation, false, () -> {
+            resolutions.incrementAndGet();
+            return List.of("geometry.body");
+        });
+
+        for (int frame = 0; frame < 144; frame++) {
+            assertSame(expected, cache.resolve("actor", snapshot, generation, false, () -> {
+                throw new AssertionError("Resolved an unchanged actor frame");
+            }));
+        }
+        assertEquals(1, resolutions.get());
+    }
+
+    @Test
+    void replacesEqualSnapshotsAndKeepsActorsIndependent() {
+        final var cache = new BedrockRenderSnapshotCache<String, List<String>, Object>(8);
+        final Object generation = new Object();
+        final List<String> before = new ArrayList<>(List.of("geometry.body"));
+        final List<String> replacement = new ArrayList<>(before);
+        final Object first = new Object();
+        final Object second = new Object();
+        final Object updated = new Object();
+        assertSame(first, cache.resolve("first", before, generation, false, () -> first));
+        assertSame(second, cache.resolve("second", before, generation, false, () -> second));
+        assertSame(updated, cache.resolve("first", replacement, generation, false, () -> updated));
+        assertSame(second, cache.resolve("second", before, generation, false, () -> {
+            throw new AssertionError("Invalidated another actor");
+        }));
+    }
+
+    @Test
+    void invalidatesPackGenerationsAndLightingChanges() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, String>(8);
+        final Object snapshot = new Object();
+        final Object before = new Object();
+        final Object replacement = new Object();
+        assertEquals("overworld", cache.resolve("actor", snapshot, before, false, () -> "overworld"));
+        assertEquals("nether", cache.resolve("actor", snapshot, before, true, () -> "nether"));
+        assertEquals("replacement", cache.resolve("actor", snapshot, replacement, true, () -> "replacement"));
+        assertEquals("overworld again", cache.resolve("actor", snapshot, replacement, false, () -> "overworld again"));
+    }
+
+    @Test
+    void retainsMissingAssetsUntilReplacementResourcesAreAvailable() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, List<String>>(8);
+        final Object snapshot = new Object();
+        final Object missingGeneration = new Object();
+        final AtomicInteger resourceReads = new AtomicInteger();
+        final Map<String, String> assets = new java.util.HashMap<>();
+        final java.util.function.Supplier<List<String>> resolve = () -> {
+            resourceReads.incrementAndGet();
+            final String asset = assets.get("geometry.body");
+            return asset == null ? List.of() : List.of(asset);
+        };
+        assertEquals(List.of(), cache.resolve("actor", snapshot, missingGeneration, false, resolve));
+        assertEquals(List.of(), cache.resolve("actor", snapshot, missingGeneration, false, resolve));
+        assertEquals(1, resourceReads.get());
+
+        assets.put("geometry.body", "replacement texture");
+        assertEquals(List.of("replacement texture"), cache.resolve("actor", snapshot, new Object(), false, resolve));
+        assertEquals(2, resourceReads.get());
+    }
+
+    @Test
+    void boundsRetainedSnapshotsWithAccessOrderEviction() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, String>(2);
+        final Object snapshot = new Object();
+        final Object generation = new Object();
+        cache.resolve("first", snapshot, generation, false, () -> "first");
+        cache.resolve("second", snapshot, generation, false, () -> "second");
+        assertEquals("first", cache.resolve("first", snapshot, generation, false, () -> "unexpected"));
+        cache.resolve("third", snapshot, generation, false, () -> "third");
+        assertEquals("first", cache.resolve("first", snapshot, generation, false, () -> "unexpected"));
+        assertEquals("second resolved again", cache.resolve("second", snapshot, generation, false, () -> "second resolved again"));
+    }
+
+    @Test
+    void removalAndClearDiscardCachedAssets() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, String>(8);
+        final Object snapshot = new Object();
+        final Object generation = new Object();
+        cache.resolve("first", snapshot, generation, false, () -> "first");
+        cache.resolve("second", snapshot, generation, false, () -> "second");
+        cache.remove("first");
+        assertEquals("new actor", cache.resolve("first", snapshot, generation, false, () -> "new actor"));
+        cache.clear();
+        assertEquals("reloaded", cache.resolve("second", snapshot, generation, false, () -> "reloaded"));
+    }
+
+    @Test
+    void failedResolutionRemainsRetryable() {
+        final var cache = new BedrockRenderSnapshotCache<String, Object, String>(8);
+        final Object snapshot = new Object();
+        final Object generation = new Object();
+        assertThrows(IllegalStateException.class, () -> cache.resolve("actor", snapshot, generation, false, () -> {
+            throw new IllegalStateException("Asset load failed");
+        }));
+        assertEquals("retry", cache.resolve("actor", snapshot, generation, false, () -> "retry"));
+    }
+}
