+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.entities.EntityTypes26_3;
+import com.viaversion.viaversion.api.minecraft.entitydata.EntityData;
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import net.minecraft.util.LightCoordsUtil;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import net.raphimc.viabedrock.protocol.types.entitydata.EntityDataTypesBedrock;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+final class BedrockNameTagAnchorsTest {
+    @Test
+    void usesNativeCollisionHeightAndPreservesUnknownAttachments() {
+        final Fixture fixture = new Fixture();
+        final Vec3 fallback = new Vec3(0.1, 1.8, 0.2);
+        BedrockNameTagAnchors.update(fixture.user, fixture.actor);
+        assertSame(fallback, fixture.snapshot().attachment(fallback));
+        fixture.height(2F);
+        // Java's submission adds .5; the native producer adds .7 to the AABB height.
+        assertEquals(2.7, fixture.snapshot().attachment(fallback).y + 0.5, 0.000001);
+        fixture.actor.entityData().put(ActorDataIds.RESERVED_038, new EntityData(38, EntityDataTypesBedrock.FLOAT, 1.75F));
+        BedrockNameTagAnchors.update(fixture.user, fixture.actor);
+        assertEquals(4.2, fixture.snapshot().attachment(fallback).y + 0.5, 0.000001);
+        fixture.height(0F);
+        assertEquals(0.705, fixture.snapshot().attachment(fallback).y + 0.5, 0.000001);
+        fixture.height(Float.NaN);
+        assertSame(fallback, fixture.snapshot().attachment(fallback));
+    }
+
+    @Test
+    void publishesImmutableSnapshotsAndRejectsReusedEntityIds() {
+        final Fixture fixture = new Fixture();
+        fixture.height(2F);
+        final BedrockNameTagAnchors.Snapshot old = fixture.snapshot();
+        fixture.actor.entityData().put(ActorDataIds.RESERVED_054,
+                new EntityData(54, EntityDataTypesBedrock.FLOAT, 3F));
+        assertEquals(2.2, old.attachment(Vec3.ZERO).y, 0.000001);
+        BedrockNameTagAnchors.update(fixture.user, fixture.actor);
+        assertEquals(3.2, fixture.snapshot().attachment(Vec3.ZERO).y, 0.000001);
+        assertEquals(2.2, old.attachment(Vec3.ZERO).y, 0.000001);
+        assertNull(BedrockNameTagAnchors.get(fixture.user, fixture.actor.javaId(), UUID.randomUUID()));
+        assertNull(BedrockNameTagAnchors.get(null, fixture.actor.javaId(), fixture.actor.javaUuid()));
+        BedrockNameTagAnchors.remove(fixture.user, fixture.actor);
+        assertNull(fixture.snapshot());
+    }
+
+    @Test
+    void keepsDepthTestedLightingAndUsesUnlitOrdinaryNameMaterial() {
+        final int worldLight = LightCoordsUtil.pack(3, 7);
+        assertEquals(worldLight, BedrockNameTagAnchors.light(true, worldLight));
+        assertEquals(LightCoordsUtil.FULL_BRIGHT, BedrockNameTagAnchors.light(false, worldLight));
+    }
+
+    @Test
+    void keepsAmbiguousProxyBoundsAndOrdinaryJavaAttachments() {
+        final Vec3 fallback = new Vec3(0.1, 1.8, 0.2);
+        for (float unknown : new float[]{0F, 1F, Float.NaN, Float.POSITIVE_INFINITY, -1F}) {
+            assertSame(fallback, BedrockNameTagAnchors.proxyAttachment(true, true, false, unknown, fallback));
+        }
+        assertSame(fallback, BedrockNameTagAnchors.proxyAttachment(false, true, false, 2F, fallback));
+        assertSame(fallback, BedrockNameTagAnchors.proxyAttachment(true, false, false, 2F, fallback));
+        assertEquals(2.7, BedrockNameTagAnchors.proxyAttachment(true, true, false, 2F, fallback).y + 0.5, 0.000001);
+        assertEquals(4.2, BedrockNameTagAnchors.proxyAttachment(true, true, false, 3.5F, fallback).y + 0.5, 0.000001);
+    }
+
+    @Test
+    void usesClampedNativeHeightOnlyForProxyMarkerArmorStands() {
+        final Vec3 fallback = new Vec3(0.1, 1.8, 0.2);
+        assertEquals(0.705, BedrockNameTagAnchors.proxyAttachment(true, false, true, 0F, fallback).y + 0.5, 0.000001);
+        assertSame(fallback, BedrockNameTagAnchors.proxyAttachment(false, false, true, 0F, fallback));
+        assertSame(fallback, BedrockNameTagAnchors.proxyAttachment(true, false, false, 0F, fallback));
+    }
+
+    @Test
+    void requiresDirectBedrockOrAcceptedNativeRenderingMetadata() {
+        BedrockRenderingMetadata.clear();
+        assertFalse(BedrockNameTagAnchors.enabled(false));
+        assertTrue(BedrockNameTagAnchors.enabled(true));
+    }
+
+    private static final class Fixture {
+        final Map<Class<?>, Object> stores = new HashMap<>();
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+                new Class<?>[]{UserConnection.class}, (_, method, args) -> switch (method.getName()) {
+                    case "get" -> this.stores.get(args[0]);
+                    case "put" -> this.stores.put(args[0].getClass(), args[0]);
+                    default -> null;
+                });
+        final Entity actor = new Entity(this.user, 1, 1, "minecraft:armor_stand", 10,
+                UUID.randomUUID(), EntityTypes26_3.INTERACTION);
+
+        void height(final float height) {
+            this.actor.entityData().put(ActorDataIds.RESERVED_054,
+                    new EntityData(54, EntityDataTypesBedrock.FLOAT, height));
+            BedrockNameTagAnchors.update(this.user, this.actor);
+        }
+
+        BedrockNameTagAnchors.Snapshot snapshot() {
+            return BedrockNameTagAnchors.get(this.user, this.actor.javaId(), this.actor.javaUuid());
+        }
+    }
+}
