@@ -0,0 +1,69 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.compat.iris;
+
+import io.github.douira.glsl_transformer.ast.node.TranslationUnit;
+import io.github.douira.glsl_transformer.ast.transform.ASTInjectionPoint;
+import io.github.douira.glsl_transformer.ast.transform.ASTParser;
+import io.github.douira.glsl_transformer.ast.transform.JobParameters;
+import io.github.douira.glsl_transformer.ast.transform.SingleASTTransformer;
+import net.irisshaders.iris.pipeline.transform.PatchShaderType;
+import net.irisshaders.iris.pipeline.transform.parameter.Parameters;
+import net.irisshaders.iris.pipeline.transform.parameter.VanillaParameters;
+
+/** Native coverage uses the original actor texture, before shader-pack color or UV changes. */
+public final class BedrockIrisAlpha {
+    public static final String ENABLED = "iris_bedrock_AlphaEnabled";
+    public static final String REFERENCE = "iris_bedrock_AlphaReference";
+    public static final String SAMPLER = "iris_bedrock_SourceTexture";
+    private static final String UV = "iris_bedrock_SourceUv";
+
+    private BedrockIrisAlpha() {}
+
+    public static boolean supports(final Parameters parameters) {
+        // Extra stages need their own varying transport. Do not create an unlinked interface.
+        return parameters instanceof VanillaParameters vanilla && vanilla.inputs.hasTex()
+            && !vanilla.isClouds() && !vanilla.hasGeometry && !vanilla.hasTesselation;
+    }
+
+    public static String javaAlphaTest(final String expression) {
+        return "if (" + ENABLED + " == 0) {\n" + expression + "\n}\n";
+    }
+
+    public static void transform(final ASTParser parser, final TranslationUnit tree, final Parameters parameters) {
+        if (!supports(parameters)) return;
+        if (parameters.type == PatchShaderType.VERTEX) {
+            vertex(parser, tree, "iris_UV0");
+        } else if (parameters.type == PatchShaderType.FRAGMENT) {
+            fragment(parser, tree);
+        }
+    }
+
+    public static String fallback(final String source, final boolean vertex) {
+        final var transformer = new SingleASTTransformer<JobParameters>();
+        transformer.setTransformation(tree -> {
+            if (vertex) vertex(transformer, tree, "UV0");
+            else fragment(transformer, tree);
+        });
+        return transformer.transform(source);
+    }
+
+    private static void vertex(final ASTParser parser, final TranslationUnit tree, final String attribute) {
+        tree.parseAndInjectNode(parser, ASTInjectionPoint.BEFORE_DECLARATIONS, "out vec2 " + UV + ";");
+        tree.prependMainFunctionBody(parser, UV + " = " + attribute + ";");
+    }
+
+    private static void fragment(final ASTParser parser, final TranslationUnit tree) {
+        BedrockIrisMaskedTexture.transform(parser, tree);
+        tree.parseAndInjectNodes(parser, ASTInjectionPoint.BEFORE_DECLARATIONS,
+            "in vec2 " + UV + ";",
+            "uniform int " + ENABLED + ";",
+            "uniform float " + REFERENCE + ";",
+            "uniform sampler2D " + SAMPLER + ";");
+        tree.prependMainFunctionBody(parser, "if (" + ENABLED + " != 0 && !(iris_bedrock_Compose(texture("
+            + SAMPLER + ", " + UV + "), texture(" + BedrockIrisMaskedTexture.SAMPLER + ", " + UV + ")).a > " + REFERENCE + ")) { discard; }");
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/compat/iris/BedrockIrisAlphaUniforms.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/compat/iris/BedrockIrisAlphaUniforms.java
