+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.util.LightCoordsUtil;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+
+/** Publishes native name geometry without reading mutable network state while drawing. */
+public final class BedrockNameTagAnchors implements StorableObject {
+    private final Map<Integer, Snapshot> actors = new ConcurrentHashMap<>();
+
+    private BedrockNameTagAnchors() {}
+
+    public static void update(final UserConnection connection, final Entity actor) {
+        BedrockNameTagAnchors store = connection.get(BedrockNameTagAnchors.class);
+        if (store == null) {
+            store = new BedrockNameTagAnchors();
+            connection.put(store);
+        }
+        store.actors.put(actor.javaId(), new Snapshot(actor.javaUuid(), actor.boundingBoxDimensions().height()));
+    }
+
+    public static void remove(final UserConnection connection, final Entity actor) {
+        final BedrockNameTagAnchors store = connection.get(BedrockNameTagAnchors.class);
+        if (store != null) store.actors.computeIfPresent(actor.javaId(),
+                (_, snapshot) -> snapshot.uuid().equals(actor.javaUuid()) ? null : snapshot);
+    }
+
+    public static Snapshot get(final UserConnection connection, final int id, final UUID uuid) {
+        if (connection == null) return null;
+        final BedrockNameTagAnchors store = connection.get(BedrockNameTagAnchors.class);
+        final Snapshot snapshot = store == null ? null : store.actors.get(id);
+        return snapshot != null && snapshot.uuid().equals(uuid) ? snapshot : null;
+    }
+
+    public static boolean enabled(final boolean directBedrock) {
+        return directBedrock || BedrockRenderingMetadata.active();
+    }
+
+    public static Vec3 proxyAttachment(final boolean nativeContext, final boolean interaction, final boolean markerArmorStand,
+                                       final float height, final Vec3 fallback) {
+        if (!nativeContext) return fallback;
+        // Explicit zero native armor-stand dimensions become Java's marker flag.
+        // Native collision dimensions still clamp to .005 rather than Java's zero.
+        if (markerArmorStand) return new Vec3(0, 0.005 + 0.2, 0);
+        // A proxy cannot expose native snapshots. Interaction dimensions are translated
+        // into Java metadata, but Java's default height of one is ambiguous when only
+        // width was supplied. Keep that case and unknown entity types unchanged.
+        if (!interaction || !Float.isFinite(height) || height < 0.005F || height == 1F) return fallback;
+        return new Vec3(0, height + 0.2, 0);
+    }
+
+    public static int light(final boolean depthTested, final int worldLight) {
+        return depthTested ? worldLight : LightCoordsUtil.FULL_BRIGHT;
+    }
+
+    public record Snapshot(UUID uuid, Optional<Float> height) {
+        public Vec3 attachment(final Vec3 fallback) {
+            // Java adds .5 blocks when drawing; native anchors .7 blocks above the collision box.
+            if (this.height.isPresent()) return new Vec3(0, this.height.get() + 0.2, 0);
+            return fallback;
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTags.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockNameTags.java
