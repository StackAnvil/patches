diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/compat/iris/BedrockIrisMaskedTexture.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/compat/iris/BedrockIrisMaskedTexture.java
