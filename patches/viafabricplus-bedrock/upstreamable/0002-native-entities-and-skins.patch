+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.ChatFormatting;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.Style;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockNameTagsTest {
+    @Test
+    void preservesForegroundRgbAcrossNativeOrdinaryAndCrouchedPasses() {
+        for (final int color : new int[]{0x2054FF54, 0x80FFFFFF, 0x7F123456, 0xFFABCDEF}) {
+            assertEquals(color | 0xFF000000,
+                    BedrockNameTags.foregroundColor(true, true, Font.DisplayMode.SEE_THROUGH, color));
+            assertEquals(color,
+                    BedrockNameTags.foregroundColor(true, true, Font.DisplayMode.NORMAL, color));
+            assertEquals(color & 0x00FFFFFF | 0x20000000,
+                    BedrockNameTags.foregroundColor(true, false, Font.DisplayMode.NORMAL, color));
+        }
+    }
+
+    @Test
+    void retainsOtherModesAndJavaConnections() {
+        for (final int color : new int[]{0x2054FF54, 0x80FFFFFF, 0x7F123456, 0xFFABCDEF}) {
+            for (final Font.DisplayMode mode : Font.DisplayMode.values()) {
+                for (final boolean seeThrough : new boolean[]{false, true}) {
+                    assertEquals(color, BedrockNameTags.foregroundColor(false, seeThrough, mode, color));
+                    if (mode != Font.DisplayMode.NORMAL && mode != Font.DisplayMode.SEE_THROUGH) {
+                        assertEquals(color, BedrockNameTags.foregroundColor(true, seeThrough, mode, color));
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    void leavesSingleLineComponentsAndOffsetsIntact() {
+        final var name = Component.literal("ordinary").withStyle(ChatFormatting.GOLD);
+        final var lines = BedrockNameTags.layout(name, 7);
+        assertEquals(1, lines.size());
+        assertSame(name, lines.getFirst().text());
+        assertEquals(7, lines.getFirst().baseline());
+    }
+
+    @Test
+    void keepsStyledSiblingsAcrossNewlinesAndStartsAtTheOrigin() {
+        final var red = Style.EMPTY.withColor(ChatFormatting.RED);
+        final var blue = Style.EMPTY.withColor(ChatFormatting.BLUE).withBold(true);
+        final var name = Component.literal("a\nb").setStyle(red)
+            .append(Component.literal("c\nd").setStyle(blue));
+        final var lines = BedrockNameTags.layout(name, 4);
+        assertEquals(List.of(4, 14, 24), lines.stream().map(BedrockNameTags.Line::baseline).toList());
+        assertEquals(List.of(red), styles(lines.getFirst().text()));
+        assertEquals(List.of(red, blue), styles(lines.get(1).text()));
+        assertEquals(List.of(blue), styles(lines.getLast().text()));
+        assertEquals(2, lines.get(1).text().getString().codePointCount(0, lines.get(1).text().getString().length()));
+    }
+
+    @Test
+    void skipsEmptyNativeRowsAndKeepsWholeUnicodeCodepoints() {
+        final var lines = BedrockNameTags.layout(Component.literal("\n\n\uD83D\uDE00\n"), 2);
+        assertEquals(1, lines.size());
+        assertEquals(2, lines.getFirst().baseline());
+        assertEquals(1, lines.getFirst().text().getString().codePointCount(0, lines.getFirst().text().getString().length()));
+        assertTrue(BedrockNameTags.layout(Component.literal("\n\n"), 2).isEmpty());
+        assertTrue(BedrockNameTags.layout(Component.empty(), 2).isEmpty());
+        assertEquals(0, BedrockNameTags.rowLift(0));
+        assertEquals(3, BedrockNameTags.layout(Component.literal("a\n \nb"), 0).size());
+        final var separated = BedrockNameTags.layout(Component.literal("a\n\nb\n"), 0);
+        assertEquals(List.of(0, 10), separated.stream().map(BedrockNameTags.Line::baseline).toList());
+        assertEquals(0.125, BedrockNameTags.rowLift(separated.size()));
+    }
+
+    @Test
+    void resolvesTranslatedStyledArgumentsBeforeLayingOutRows() {
+        final var first = Component.literal("a").withStyle(ChatFormatting.GREEN);
+        final var second = Component.literal("b").withStyle(ChatFormatting.AQUA);
+        final var translated = Component.translatableWithFallback("stackanvil.test.name.lines", "%s\n%s", first, second);
+        final var lines = BedrockNameTags.layout(translated, 0);
+        assertEquals(2, lines.size());
+        assertEquals(styles(first), styles(lines.getFirst().text()));
+        assertEquals(styles(second), styles(lines.getLast().text()));
+        assertEquals(0, lines.getFirst().baseline());
+        assertEquals(10, lines.getLast().baseline());
+    }
+
+    @Test
+    void reproducesNativePixelScaleAndIntegerHalfWidths() {
+        assertEquals(0x3C5A740F, Float.floatToRawIntBits(BedrockNameTags.pixelScale(0.5F)));
+        assertEquals(0x3CDA740F, Float.floatToRawIntBits(BedrockNameTags.pixelScale(1F)));
+        assertEquals(0x3D5A740F, Float.floatToRawIntBits(BedrockNameTags.pixelScale(2F)));
+        for (final int width : new int[]{0, 1, 2, 7, 8, 15, 16}) {
+            assertEquals(-(float) (width / 2), BedrockNameTags.centerX(-width / 2F));
+        }
+    }
+
+    @Test
+    void liftsTheOriginBeforeAdvancingEachNativeRow() {
+        for (int rows = 1; rows <= 4; rows++) {
+            assertEquals((rows - 1) * 0.125, BedrockNameTags.rowLift(rows));
+            final var lines = BedrockNameTags.layout(Component.literal("a\n".repeat(rows - 1) + "b"), 0);
+            for (int row = 0; row < rows; row++) {
+                assertEquals(row * 10, lines.get(row).baseline());
+                final double position = BedrockNameTags.rowLift(rows) - lines.get(row).baseline() * BedrockNameTags.pixelScale(1F);
+                assertEquals((rows - 1) * 0.125 - row * Float.intBitsToFloat(0x3CDA740F) * 10, position, 0.0000001);
+            }
+        }
+    }
+
+    private static List<Style> styles(final Component component) {
+        final List<Style> styles = new ArrayList<>();
+        component.getVisualOrderText().accept((_, style, _) -> {
+            styles.add(style);
+            return true;
+        });
+        return styles;
+    }
+}
