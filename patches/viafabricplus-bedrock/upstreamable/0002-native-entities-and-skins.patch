+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.mojang.renderpearl.api.buffers.GpuBufferSlice;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockActorRenderType;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorUvTransform;
+import net.minecraft.client.renderer.DynamicGpuData;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.joml.Vector4f;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(RenderType.class)
+public abstract class MixinBedrockActorRenderType implements IBedrockActorRenderType {
+    @Unique
+    private float bedrock$multiplier = 1F;
+
+    @Unique
+    private BedrockActorUvTransform bedrock$uv = BedrockActorUvTransform.IDENTITY;
+
+    @Override
+    public void bedrock$uvTransform(final BedrockActorUvTransform transform) {
+        this.bedrock$uv = transform;
+    }
+
+    @Override
+    public void bedrock$lightColorMultiplier(final float multiplier) {
+        this.bedrock$multiplier = multiplier;
+    }
+
+    @WrapOperation(method = "writeDynamicTransforms", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/renderer/DynamicGpuData;writeTransform(Lorg/joml/Matrix4f;Lorg/joml/Matrix4f;)Lcom/mojang/renderpearl/api/buffers/GpuBufferSlice;"))
+    private GpuBufferSlice actorMultiplier(final DynamicGpuData data, final Matrix4f modelView, final Matrix4f texture, final Operation<GpuBufferSlice> original) {
+        if (this.bedrock$multiplier == 1F && this.bedrock$uv.equals(BedrockActorUvTransform.IDENTITY)) {
+            return original.call(data, modelView, texture);
+        }
+        return data.writeTransform(modelView, new Vector4f(this.bedrock$multiplier, this.bedrock$multiplier, this.bedrock$multiplier, 1F), new Vector3f(), this.bedrock$uv.apply(texture));
+    }
+}
