+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import net.raphimc.viabedrock.api.model.NativeCustomEntityMessage;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+
+/** Publishes immutable actor render state across the protocol and render threads. */
+public final class CustomEntityRenderStore {
+
+    private static final Map<UUID, RenderData> MODELS = new ConcurrentHashMap<>();
+
+    private static volatile long generation;
+
+    private CustomEntityRenderStore() {
+    }
+
+    public static void accept(final Connection connection, final NativeCustomEntityMessage message) {
+        final long receivedGeneration = generation;
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (generation == receivedGeneration && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                apply(message);
+            }
+        });
+    }
+
+    static void apply(final NativeCustomEntityMessage message) {
+        if (message instanceof NativeCustomEntityMessage.Snapshot snapshot) {
+            MODELS.put(snapshot.uuid(), new RenderData(snapshot.identifier(), snapshot.scale(), snapshot.models()));
+        } else if (message instanceof NativeCustomEntityMessage.Remove remove) {
+            MODELS.remove(remove.uuid());
+        }
+    }
+
+    public static RenderData get(final UUID uuid) {
+        return MODELS.get(uuid);
+    }
+
+    public static void clear() {
+        generation++;
+        MODELS.clear();
+    }
+
+    public record RenderData(String identifier, float scale, List<CustomEntity.EvaluatedModel> models) {
+    }
+
+}
