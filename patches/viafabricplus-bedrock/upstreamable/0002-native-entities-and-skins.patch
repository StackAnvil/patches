@@ -0,0 +1,76 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.MutableComponent;
+import net.minecraft.network.chat.Style;
+
+/** Keeps server name components styled while laying out explicit line breaks. */
+public final class BedrockNameTags {
+    // Native 1.26.51.1 name records use ten pixels even when the Java font advances nine.
+    private static final int LINE_ADVANCE = 10;
+
+    private BedrockNameTags() {
+    }
+
+    public static int foregroundColor(final boolean nativeContext, final boolean seeThrough,
+                                      final Font.DisplayMode mode, final int color) {
+        if (!nativeContext) return color;
+        if (!seeThrough && mode == Font.DisplayMode.NORMAL) return color & 0x00FFFFFF | 0x20000000;
+        return mode == Font.DisplayMode.SEE_THROUGH ? color | 0xFF000000 : color;
+    }
+
+    public static float pixelScale(final float recordScale) {
+        // Keep the two original native float multiplications in order.
+        return recordScale * 1.6F * 0.016666668F;
+    }
+
+    public static float centerX(final float javaCenter) {
+        // Java centers at -width / 2F; native truncates the integer half-width first.
+        final int halfWidth = (int) -javaCenter;
+        return -(float) halfWidth;
+    }
+
+    public static double rowLift(final int rows) {
+        return Math.max(0, rows - 1) * 0.125;
+    }
+
+    public static List<Line> layout(final Component name, final int baseline) {
+        if (name.getString().isEmpty()) return List.of();
+        if (!name.getString().contains("\n")) return List.of(new Line(name, baseline));
+        final List<MutableComponent> rows = new ArrayList<>();
+        rows.add(Component.empty());
+        name.visit((style, text) -> {
+            int start = 0;
+            for (int end = 0; end < text.length(); end++) {
+                if (text.charAt(end) != '\n') continue;
+                append(rows.getLast(), text.substring(start, end), style);
+                rows.add(Component.empty());
+                start = end + 1;
+            }
+            append(rows.getLast(), text.substring(start), style);
+            return Optional.empty();
+        }, Style.EMPTY);
+        rows.removeIf(row -> row.getString().isEmpty());
+        final List<Line> lines = new ArrayList<>(rows.size());
+        for (int index = 0; index < rows.size(); index++) {
+            lines.add(new Line(rows.get(index), baseline + index * LINE_ADVANCE));
+        }
+        return List.copyOf(lines);
+    }
+
+    private static void append(final MutableComponent line, final String text, final Style style) {
+        if (!text.isEmpty()) line.append(Component.literal(text).setStyle(style));
+    }
+
+    public record Line(Component text, int baseline) {
+    }
+}
