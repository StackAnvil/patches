+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import org.joml.Matrix4f;
+import org.joml.Matrix4fc;
+
+/** Immutable native normalized-UV scale and offset for one submitted draw. */
+public record BedrockActorUvTransform(float offsetU, float offsetV, float scaleU, float scaleV) {
+    public static final BedrockActorUvTransform IDENTITY = new BedrockActorUvTransform(0F, 0F, 1F, 1F);
+
+    public Matrix4f apply(final Matrix4fc texture) {
+        return new Matrix4f().translation(this.offsetU, this.offsetV, 0F).scale(this.scaleU, this.scaleV, 1F).mul(texture);
+    }
+}
