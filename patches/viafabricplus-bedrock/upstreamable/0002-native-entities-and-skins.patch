+        target = "Lnet/irisshaders/iris/gl/sampler/SamplerHolder;addExternalSampler(I[Ljava/lang/String;)V"))
+    private static void bedrock$source(final SamplerHolder samplers, final int unit, final String[] names,
+                                      final Operation<Void> original) {
+        original.call(samplers, unit, names);
+        if (unit == 0) {
+            // Register separately: a gtexture override must not replace the native source as well.
+            samplers.addExternalSampler(0, BedrockIrisAlpha.SAMPLER);
+            if (samplers.hasSampler(BedrockIrisMaskedTexture.SAMPLER))
+                samplers.addExternalSampler(BedrockIrisMaskedTexture.UNIT, BedrockIrisMaskedTexture.SAMPLER);
+        }
