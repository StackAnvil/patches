+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.model.entity.CustomEntity;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class CustomEntityRenderStoreTest {
+
+    @Test
+    void scaleUpdatesPublishIndependentImmutableSnapshots() {
+        final UUID uuid = UUID.randomUUID();
+        final var models = new ArrayList<CustomEntity.EvaluatedModel>();
+        try {
+            CustomEntityRenderStore.update(uuid, "test:actor", 5F, models);
+            final var before = CustomEntityRenderStore.get(uuid);
+            models.add(null);
+            assertEquals(0, before.models().size());
+
+            CustomEntityRenderStore.update(uuid, "test:actor", 1.7F, before.models());
+            assertEquals(5F, before.scale());
+            assertEquals(1.7F, CustomEntityRenderStore.get(uuid).scale());
+        } finally {
+            CustomEntityRenderStore.remove(uuid);
+        }
+    }
+
+}
