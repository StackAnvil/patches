+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.client.Minecraft;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+import java.io.IOException;
+
+/** Accepted native actor assets use the same resource-manager lifetime on direct and proxy connections. */
+public final class BedrockActorResources {
+
+    private static boolean loaded;
+    private static ResourcePackStorage packs;
+
+    private BedrockActorResources() {
+    }
+
+    /** Called on the Minecraft thread. Reading accepted assets never initiates account sign-in. */
+    public static ResourcePackStorage get() {
+        if (loaded) return packs;
+        loaded = true;
+        try {
+            final var layers = BedrockAcceptedResources.layers(Minecraft.getInstance().getResourceManager());
+            if (!layers.isEmpty()) packs = ResourcePackStorage.nativeActors(layers);
+        } catch (IOException | RuntimeException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not read accepted native actor resources", invalid);
+        }
+        return packs;
+    }
+
+    public static void clear() {
+        BedrockAcceptedResources.clear();
+        loaded = false;
+        packs = null;
+    }
+
+}
