+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.entity.Entity;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+
+/** Immutable native passenger anchors published by the connection thread. */
+public final class BedrockRidingAnchors implements StorableObject {
+    private final Map<Integer, Anchor> anchors = new ConcurrentHashMap<>();
+
+    private BedrockRidingAnchors() {}
+
+    public static void update(final UserConnection connection, final Entity passenger) {
+        BedrockRidingAnchors store = connection.get(BedrockRidingAnchors.class);
+        final EntityTracker tracker = connection.get(EntityTracker.class);
+        final Entity vehicle = tracker == null ? null : tracker.getEntityByRid(passenger.mountEntityRuntimeId());
+        final Position3f seat = passenger.riderSeatPosition().orElse(null);
+        if (vehicle == null || seat == null) {
+            remove(connection, passenger);
+            return;
+        }
+        if (store == null) {
+            store = new BedrockRidingAnchors();
+            connection.put(store);
+        }
+        store.anchors.put(passenger.javaId(), new Anchor(passenger.javaUuid(), vehicle.javaUuid(),
+                new Vec3(seat.x(), seat.y(), seat.z()), passenger.eyeOffset(), vehicle.eyeOffset()));
+    }
+
+    public static void remove(final UserConnection connection, final Entity passenger) {
+        final BedrockRidingAnchors store = connection.get(BedrockRidingAnchors.class);
+        if (store != null) store.anchors.computeIfPresent(passenger.javaId(),
+                (_, anchor) -> anchor.passenger().equals(passenger.javaUuid()) ? null : anchor);
+    }
+
+    /** Returns the Java vehicle attachment point; positionRider subtracts the passenger attachment. */
+    public static Vec3 ridingPosition(final UserConnection connection, final int passengerId,
+                                     final UUID passengerUuid, final UUID vehicleUuid,
+                                     final Vec3 vehiclePosition, final float vehicleYaw,
+                                     final Vec3 passengerAttachment) {
+        if (connection == null) return null;
+        final BedrockRidingAnchors store = connection.get(BedrockRidingAnchors.class);
+        final Anchor anchor = store == null ? null : store.anchors.get(passengerId);
+        if (anchor == null || !anchor.passenger().equals(passengerUuid) || !anchor.vehicle().equals(vehicleUuid))
+            return null;
+        return anchor.position(vehiclePosition, vehicleYaw, passengerAttachment);
+    }
+
+    private record Anchor(UUID passenger, UUID vehicle, Vec3 seat, float passengerEyeOffset, float vehicleEyeOffset) {
+        Vec3 position(final Vec3 vehiclePosition, final float vehicleYaw, final Vec3 passengerAttachment) {
+            final double radians = Math.toRadians(-vehicleYaw);
+            final double cos = Math.cos(radians);
+            final double sin = Math.sin(radians);
+            final Vec3 offset = new Vec3(this.seat.x * cos + this.seat.z * sin, this.seat.y,
+                    this.seat.z * cos - this.seat.x * sin);
+            return vehiclePosition.add(offset).add(0, this.vehicleEyeOffset - this.passengerEyeOffset, 0)
+                    .add(passengerAttachment);
+        }
+    }
+}
