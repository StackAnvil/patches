+
+@Mixin(SubmitNodeCollection.class)
+public abstract class MixinBedrockNameTags {
+    @WrapOperation(method = "submitNameTag", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/renderer/SubmitNodeCollection;nameTag(Lorg/joml/Matrix4f;FFLnet/minecraft/util/FormattedCharSequence;IIILnet/minecraft/client/gui/Font$DisplayMode;)Lnet/minecraft/client/renderer/feature/TextFeatureRenderer$Submit;"))
+    private TextFeatureRenderer.Submit submitNativeNamePart(final Matrix4f pose, final float x, final float y,
+                                                           final FormattedCharSequence name, final int light,
+                                                           final int color, final int background,
+                                                           final Font.DisplayMode mode,
+                                                           final Operation<TextFeatureRenderer.Submit> original,
+                                                           @Local(argsOnly = true) final boolean seeThrough) {
+        final boolean nativeContext = BedrockNameTagAnchors.enabled(
+                ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST));
+        return original.call(pose, nativeContext ? BedrockNameTags.centerX(x) : x, y, name, light,
+                BedrockNameTags.foregroundColor(nativeContext, seeThrough, mode, color), background, mode);
+    }
+
+    @WrapOperation(method = "submitNameTag", at = @At(value = "INVOKE",
+            target = "Lcom/mojang/blaze3d/vertex/PoseStack;scale(FFF)V"))
+    private void scaleNativeName(final PoseStack poses, final float x, final float y, final float z,
+                                 final Operation<Void> original) {
+        if (BedrockNameTagAnchors.enabled(ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST))) {
+            final float scale = BedrockNameTags.pixelScale(1F);
+            original.call(poses, scale, -scale, scale);
+        } else {
+            original.call(poses, x, y, z);
+        }
+    }
+
+    @WrapMethod(method = "submitNameTag")
+    private void renderServerNameLines(final PoseStack poses, final @Nullable Vec3 attachment,
+                                      final int offset, final Component name, final boolean seeThrough,
+                                      final int light, final CameraRenderState camera, final Operation<Void> original) {
+        if (!BedrockNameTagAnchors.enabled(ViaFabricPlus.api().targetVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST))) {
+            original.call(poses, attachment, offset, name, seeThrough, light, camera);
+            return;
+        }
+        final var lines = BedrockNameTags.layout(name, offset);
+        final Vec3 lifted = attachment == null || lines.size() <= 1 ? attachment
+                : attachment.add(0, BedrockNameTags.rowLift(lines.size()), 0);
+        for (final var line : lines) {
+            original.call(poses, lifted, line.baseline(), line.text(), seeThrough, light, camera);
+        }
+    }
+}
