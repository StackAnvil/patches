+    /** Image-only layers in native order, without replacing the core's vanilla definitions. */
+    List<net.raphimc.viabedrock.api.resourcepack.ResourcePack> imagePacks() {
+        final List<net.raphimc.viabedrock.api.resourcepack.ResourcePack> result = new ArrayList<>();
+        for (final Pack pack : this.packs) {
+            final var content = new net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent();
+            for (final var entry : pack.files.entrySet()) {
+                final String path = entry.getKey();
+                if (path.startsWith("textures/")
+                        && (path.endsWith(".png") || path.endsWith(".jpg") || path.endsWith(".tga")))
+                    content.put(path, entry.getValue().clone());
+            }
+            if (content.size() == 0) continue;
+            final JsonObject manifest = new JsonObject(), header = new JsonObject();
+            manifest.addProperty("format_version", 2);
+            header.addProperty("name", "Licensed Bedrock images: " + pack.name);
+            header.addProperty("uuid", java.util.UUID.nameUUIDFromBytes(
+                    ("viafabricplus-bedrock/builtin-images/" + pack.name).getBytes(StandardCharsets.UTF_8)).toString());
+            final JsonArray version = new JsonArray();
+            version.add(1);
+            version.add(0);
+            version.add(0);
+            header.add("version", version);
+            manifest.add("header", header);
+            content.putString("manifest.json", manifest.toString());
+            result.add(new net.raphimc.viabedrock.api.resourcepack.ResourcePack(content));
+        }
+        return List.copyOf(result);
+    }
+
     byte[] file(final String path) throws IOException {
