+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.resourcepack.BaseGameVersion;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockWorldResourceVersionsTest {
+    private static final BaseGameVersion OLDER = BaseGameVersion.parse("1.20.0");
+
+    @Test
+    void selectsTexturesSoundsAndGraphsTogetherAndCanReturnToTheLatestView() throws Exception {
+        final var raw = library();
+        assertResources(raw, 9);
+        final var older = raw.forVersion(OLDER);
+        assertResources(older, 1);
+        assertEquals(OLDER, older.baseGameVersion());
+        assertSame(raw, older.forVersion(BaseGameVersion.CURRENT));
+        assertSame(older, raw.forVersion(OLDER));
+        assertResources(raw, 9);
+        // Cache eviction cannot make a partial older view the source for a newer world.
+        for (int patch = 1; patch <= 6; patch++) raw.forVersion(new BaseGameVersion(1, 20, patch));
+        assertResources(older.forVersion(BaseGameVersion.CURRENT), 9);
+        assertResources(raw.forVersion(OLDER), 1);
+    }
+
+    @Test
+    void retainsHigherServerOverridesAndTheirWorldContext() throws Exception {
+        final var older = library().forVersion(OLDER);
+        final var merged = BedrockResourceLibrary.withServerPacks(older, List.of(resources(7)));
+        assertResources(merged, 7);
+        assertEquals(OLDER, merged.baseGameVersion());
+        assertResources(older, 1);
+        assertThrows(IllegalStateException.class, () -> merged.forVersion(BaseGameVersion.CURRENT));
+    }
+
+    private static void assertResources(final BedrockResourceLibrary library, final int value) throws Exception {
+        assertArrayEquals(new byte[]{(byte) value}, library.file("textures/versioned.png"));
+        assertArrayEquals(new byte[]{(byte) value}, library.sound("sounds/versioned.wav"));
+        assertEquals(value, library.soundDefinition("fixture.versioned").select(_ -> 0, 1, 1, false).volume());
+        final var entity = JsonParser.parseString("""
+                {"animations":{"pose":"animation.versioned"},"scripts":{"animate":["pose"]}}
+                """).getAsJsonObject();
+        final var pose = BedrockActorAnimation.read(entity, Map.of(), library).playback()
+                .sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(value, pose.get("head").position().x());
+    }
+
+    private static BedrockResourceLibrary library() throws Exception {
+        final Map<String, byte[]> files = new HashMap<>();
+        resources(1).forEach((path, bytes) -> files.put("library/vanilla/" + path, bytes));
+        resources(9).forEach((path, bytes) -> files.put("library/vanilla_1.26.60/" + path, bytes));
+        return BedrockResourceLibrary.read(files);
+    }
+
+    private static Map<String, byte[]> resources(final int value) {
+        final var definitions = JsonParser.parseString("""
+                {"sound_definitions":{"fixture.versioned":{"sounds":[{"name":"sounds/versioned","volume":1}]}}}
+                """).getAsJsonObject();
+        definitions.getAsJsonObject("sound_definitions").getAsJsonObject("fixture.versioned")
+                .getAsJsonArray("sounds").get(0).getAsJsonObject().addProperty("volume", value);
+        final var position = new com.google.gson.JsonArray(); position.add(value); position.add(0); position.add(0);
+        final var head = new JsonObject(); head.add("position", position);
+        final var bones = new JsonObject(); bones.add("head", head);
+        final var animation = new JsonObject(); animation.addProperty("loop", true); animation.add("bones", bones);
+        final var animations = new JsonObject(); animations.add("animation.versioned", animation);
+        final var document = new JsonObject(); document.addProperty("format_version", "1.8.0"); document.add("animations", animations);
+        return Map.of("textures/versioned.png", new byte[]{(byte) value},
+                "sounds/versioned.wav", new byte[]{(byte) value},
+                "sounds/sound_definitions.json", definitions.toString().getBytes(StandardCharsets.UTF_8),
+                "animations/versioned.json", document.toString().getBytes(StandardCharsets.UTF_8));
+    }
+}
