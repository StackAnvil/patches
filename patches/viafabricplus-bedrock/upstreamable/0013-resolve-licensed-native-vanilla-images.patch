@@ -0,0 +1,85 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ViaFabricPlusBuiltinResourcePackProviderTest {
+    @Test
+    void loadsBundledImagesWithoutAnAccount() throws Exception {
+        final var packs = new ViaFabricPlusBuiltinResourcePackProvider().load(null);
+        assertFalse(packs.isEmpty());
+        assertTrue(packs.stream().anyMatch(pack -> pack.content().get("textures/items/bread.png") != null));
+    }
+
+    @Test
+    void reportsDamagedBundledResources() {
+        final var provider = new ViaFabricPlusBuiltinResourcePackProvider(() -> { throw new IOException(); });
+        assertThrows(IOException.class, () -> provider.load(null));
+    }
+
+    @Test
+    void preservesNativeLayersAndExactPathsWithoutExportingDefinitions() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        files.put("library/vanilla_1.10/textures/items/shared.tga", new byte[] {10});
+        files.put("library/vanilla/textures/items/shared.png", new byte[] {1});
+        files.put("library/vanilla_1.9/textures/items/shared.png", new byte[] {9});
+        files.put("library/vanilla_base/textures/items/CaseSensitive.jpg", new byte[] {2});
+        files.put("library/vanilla/textures/item_texture.json", new byte[] {'{', '}'});
+        files.put("library/vanilla/entity/player.entity.json", new byte[] {'{', '}'});
+        files.put("library/vanilla_1.11/manifest.json", new byte[] {'{', '}'});
+        final var library = BedrockResourceLibrary.read(files);
+        final var packs = library.imagePacks();
+        assertEquals(4, packs.size());
+        assertArrayEquals(new byte[] {1}, packs.get(0).content().get("textures/items/shared.png"));
+        assertArrayEquals(new byte[] {2}, packs.get(1).content().get("textures/items/CaseSensitive.jpg"));
+        assertNull(packs.get(1).content().get("textures/items/casesensitive.jpg"));
+        assertArrayEquals(new byte[] {9}, packs.get(2).content().get("textures/items/shared.png"));
+        assertArrayEquals(new byte[] {10}, packs.get(3).content().get("textures/items/shared.tga"));
+        for (final ResourcePack pack : packs) {
+            assertFalse(pack.content().contains("textures/item_texture.json"));
+            assertFalse(pack.content().contains("entity/player.entity.json"));
+        }
+        assertEquals(4, packs.stream().map(ResourcePack::key).distinct().count());
+        assertEquals(packs.stream().map(ResourcePack::key).toList(),
+                library.imagePacks().stream().map(ResourcePack::key).toList());
+        packs.getFirst().content().get("textures/items/shared.png")[0] = 99;
+        assertArrayEquals(new byte[] {1}, files.get("library/vanilla/textures/items/shared.png"));
+        assertArrayEquals(new byte[] {1}, library.imagePacks().getFirst().content().get("textures/items/shared.png"));
+    }
+
+    @Test
+    void resolvesHigherNativeExtensionsBelowServerOverrides() throws Exception {
+        final var library = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/textures/items/shared.png", new byte[] {1},
+                "library/vanilla_1.26.51/textures/items/shared.tga", new byte[] {2}));
+        final var provider = new ViaFabricPlusBuiltinResourcePackProvider(() -> library);
+        final var builtin = provider.load(null);
+        final var stack = new ResourcePackStorage(List.of(), builtin);
+        assertArrayEquals(new byte[] {2}, selectedImage(stack, "textures/items/shared"));
+
+        final var serverContent = new InMemoryContent();
+        serverContent.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"server\","
+                + "\"uuid\":\"6c9c1d60-6b4c-4ddb-b0be-8531a370f405\",\"version\":[1,0,0]}}");
+        serverContent.put("textures/items/shared.png", new byte[] {3});
+        final var server = new ResourcePack(serverContent);
+        assertArrayEquals(new byte[] {3}, selectedImage(new ResourcePackStorage(List.of(server), builtin),
+                "textures/items/shared"));
+    }
+
+    private static byte[] selectedImage(final ResourcePackStorage stack, final String path) {
+        for (final ResourcePack pack : stack.getPackStackTopToBottom()) {
+            final String fullPath = pack.content().getFullPath(path, "png", "jpg", "tga");
+            if (fullPath != null) return pack.content().get(fullPath);
+        }
+        return null;
+    }
+}
