+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorDependenciesTest {
+    @Test
+    void sharesTheLicensedPayloadAcrossCachedVisualAndActorSelections() throws Exception {
+        final byte[] texture = new byte[2 * 1024 * 1024];
+        final var builtin = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/textures/entity/probe.png", texture));
+        final var packs = builtin.resourcePacks();
+        assertSame(packs, builtin.resourcePacks());
+        assertSame(texture, packs.getFirst().content().get("textures/entity/probe.png"));
+        final var layers = builtin.actorLayers();
+        assertSame(layers, builtin.actorLayers());
+        assertSame(texture, layers.getFirst().resources().get("textures/entity/probe.png"));
+        assertThrows(UnsupportedOperationException.class, () -> layers.getFirst().resources().clear());
+    }
+
+    @Test
+    void selectsBuiltinVisualPacksOnlyOnceAndRetainsServerOverrides() throws Exception {
+        final byte[] texture = new byte[1024];
+        final var builtin = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/textures/entity/probe.png", texture,
+                "library/vanilla/entity/probe.json", bytes("""
+                {"minecraft:client_entity":{"description":{"identifier":"test:probe",
+                  "textures":{"default":"textures/entity/probe","retained":"textures/entity/probe"}}}}
+                """)));
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        final byte[] override = new byte[] {17};
+        content.put("textures/entity/probe.png", override);
+        content.putString("entity/probe.json", """
+                {"minecraft:client_entity":{"description":{"identifier":"test:probe",
+                  "textures":{"default":"textures/entity/server"}}}}
+                """);
+        final var server = new ResourcePack(content);
+        final var accepted = new ResourcePackStorage(List.of(server), builtin.resourcePacks());
+        final var dependencies = BedrockActorDependencies.resolve(builtin, accepted);
+        final var layers = dependencies.layers();
+        assertEquals(accepted.getPackStackBottomToTop().size(), layers.size());
+        assertEquals(1, layers.stream().filter(layer -> layer.resources().get("textures/entity/probe.png") == texture).count());
+        final var highest = layers.getLast();
+        assertTrue(highest.server());
+        assertSame(override, highest.resources().get("textures/entity/probe.png"));
+        assertSame(override, dependencies.library().file("textures/entity/probe.png"));
+        final var textures = dependencies.library().entity("test:probe").getAsJsonObject("description").getAsJsonObject("textures");
+        assertEquals("textures/entity/server", textures.get("default").getAsString());
+        assertEquals("textures/entity/probe", textures.get("retained").getAsString());
+    }
+
+    @Test
+    void sharesParsedInheritedDefinitionsAndReplacesOnlyHigherIdentifiers() throws Exception {
+        final var builtin = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/animations/probe.json", bytes("""
+                {"format_version":"1.10.0","animations":{
+                  "animation.retained":{"loop":true},"animation.replaced":{"loop":false}}}
+                """)));
+        final var definitions = builtin.definitions("animations", "animations");
+        assertSame(definitions, builtin.definitions("animations", "animations"));
+        final var accepted = BedrockResourceLibrary.withServerPacks(builtin, List.of(Map.of(
+                "animations/server.json", bytes("""
+                {"format_version":"1.26.0","animations":{"animation.replaced":{"loop":true}}}
+                """))));
+        final var inherited = accepted.definitions("animations", "animations");
+        assertSame(inherited, accepted.definitions("animations", "animations"));
+        assertSame(definitions.get("animation.retained"), inherited.get("animation.retained"));
+        assertNotSame(definitions.get("animation.replaced"), inherited.get("animation.replaced"));
+        assertTrue(inherited.get("animation.replaced").value().get("loop").getAsBoolean());
+        assertFalse(definitions.get("animation.replaced").value().get("loop").getAsBoolean());
+        assertThrows(UnsupportedOperationException.class, () -> inherited.clear());
+    }
+
+    @Test
+    void sharesParsedNativeBuffersWithoutCachingDifferentAcceptedDocuments() throws Exception {
+        final byte[] nativeBytes = bytes("""
+                {"animations":{"animation.probe":{"loop":true}}}
+                """);
+        final var builtin = BedrockResourceLibrary.read(Map.of("library/vanilla/animations/probe.json", nativeBytes));
+        final var nativeDocument = builtin.document("animations/probe.json", nativeBytes);
+        assertSame(nativeDocument, builtin.document("animations/probe.json", nativeBytes.clone()));
+        final var acceptedBytes = bytes("""
+                {"animations":{"animation.probe":{"loop":false}}}
+                """);
+        final var accepted = builtin.document("animations/probe.json", acceptedBytes);
+        assertNotSame(nativeDocument, accepted);
+        assertFalse(accepted.getAsJsonObject("animations").getAsJsonObject("animation.probe").get("loop").getAsBoolean());
+        assertTrue(nativeDocument.getAsJsonObject("animations").getAsJsonObject("animation.probe").get("loop").getAsBoolean());
+        assertNotSame(accepted, builtin.document("animations/probe.json", acceptedBytes));
+        assertSame(nativeDocument.getAsJsonObject("animations").getAsJsonObject("animation.probe"),
+                builtin.definitions("animations", "animations").get("animation.probe").value());
+    }
+
+    private static byte[] bytes(final String json) { return json.getBytes(StandardCharsets.UTF_8); }
+}
