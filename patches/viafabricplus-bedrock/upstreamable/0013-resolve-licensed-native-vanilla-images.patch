+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** One shared native dependency selection and parsed model library per accepted resource generation. */
+final class BedrockActorDependencies {
+    private static ResourcePackStorage source;
+    private static CompletableFuture<Resolved> dependencies;
+
+    private BedrockActorDependencies() {}
+
+    static synchronized CompletableFuture<Resolved> get(final ResourcePackStorage accepted) {
+        if (source != accepted) {
+            clear();
+            source = accepted;
+            dependencies = CompletableFuture.supplyAsync(() -> {
+                try {
+                    return resolve(BedrockBuiltinAssets.load().library(), accepted);
+                } catch (IOException invalid) {
+                    throw new CompletionException(invalid);
+                }
+            });
+        }
+        return dependencies;
+    }
+
+    static Resolved resolve(final BedrockResourceLibrary builtin, final ResourcePackStorage accepted) throws IOException {
+        // Direct connections already include the very same bundled visual packs. Reuse them below
+        // core metadata instead of selecting and parsing every licensed model a second time.
+        final var selected = builtin.forVersion(accepted.getBaseGameVersion());
+        final var builtinPacks = selected.resourcePacks();
+        final var acceptedPacks = accepted.getPackStackBottomToTop().stream()
+                .filter(pack -> !builtinPacks.contains(pack)).toList();
+        return merge(selected, NativeActorLibrary.resources(acceptedPacks, accepted::isServerPack));
+    }
+
+    static Resolved merge(final BedrockResourceLibrary builtin, final List<NativeActorLibrary.Layer> accepted) throws IOException {
+        final var layers = new ArrayList<>(builtin.actorLayers());
+        layers.addAll(accepted);
+        final var library = BedrockResourceLibrary.withServerPacks(builtin,
+                accepted.stream().map(NativeActorLibrary.Layer::resources).toList());
+        return new Resolved(library, List.copyOf(layers));
+    }
+
+    static synchronized void clear() {
+        if (dependencies != null) dependencies.cancel(false);
+        source = null;
+        dependencies = null;
+    }
+
+    record Resolved(BedrockResourceLibrary library, List<NativeActorLibrary.Layer> layers) {}
+}
