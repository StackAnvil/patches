+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.BaseGameVersion;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePackExecutor;
+import net.raphimc.viabedrock.protocol.provider.BuiltinResourcePackProvider;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutionException;
+
+/** Supplies bundled native visual and actor resources on ViaBedrock's resource-pack worker. */
+public final class ViaFabricPlusBuiltinResourcePackProvider extends BuiltinResourcePackProvider implements AutoCloseable {
+    private final LibraryLoader library;
+    private final ResourcePackExecutor preparation = new ResourcePackExecutor(1, 1, "Bedrock Builtin Asset Preparation");
+    private CompletableFuture<BedrockResourceLibrary> prepared;
+
+    public ViaFabricPlusBuiltinResourcePackProvider() {
+        this(() -> BedrockBuiltinAssets.load().library());
+    }
+
+    ViaFabricPlusBuiltinResourcePackProvider(final LibraryLoader library) {
+        this.library = library;
+    }
+
+    /** Starts the same validated load that joining awaits, without blocking client startup. */
+    public void prepare() {
+        this.preparedLibrary();
+    }
+
+    private synchronized CompletableFuture<BedrockResourceLibrary> preparedLibrary() {
+        if (this.prepared == null) {
+            this.prepared = this.preparation.submit(() -> {
+                try {
+                    return this.library.load();
+                } catch (final IOException error) {
+                    throw new CompletionException(error);
+                }
+            });
+        }
+        return this.prepared;
+    }
+
+    @Override
+    public List<ResourcePack> load(final UserConnection user, final BaseGameVersion version) throws IOException {
+        try {
+            return this.preparedLibrary().get().forVersion(version).resourcePacks();
+        } catch (final InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IOException("Interrupted while preparing bundled Bedrock assets", interrupted);
+        } catch (final ExecutionException failed) {
+            Throwable cause = failed.getCause();
+            while (cause instanceof CompletionException && cause.getCause() != null) cause = cause.getCause();
+            if (cause instanceof IOException error) throw error;
+            throw new IOException("Failed to prepare bundled Bedrock assets", cause);
+        }
+    }
+
+    @Override
+    public void close() {
+        this.preparation.stop();
+    }
+
+    @FunctionalInterface
+    interface LibraryLoader {
+        BedrockResourceLibrary load() throws IOException;
+    }
+}
