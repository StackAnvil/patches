+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.api.resourcepack.BedrockResourcePackPayloads;
+import net.raphimc.viabedrock.api.resourcepack.BaseGameVersion;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Reuses decoded bytes across resource generations without retaining their managers, packs or streams. */
+final class BedrockAcceptedArchiveCache {
+    private final Decoder decoder;
+    private final long budget;
+    private final int maxEntries;
+    private final int maxEncodedBytes;
+    private final Map<String, Entry> entries = new LinkedHashMap<>(4, .75F, true);
+    private long retained;
+
+    BedrockAcceptedArchiveCache(final Decoder decoder, final long budget, final int maxEntries, final int maxEncodedBytes) {
+        this.decoder = decoder;
+        this.budget = budget;
+        this.maxEntries = maxEntries;
+        this.maxEncodedBytes = maxEncodedBytes;
+    }
+
+    synchronized NativeActorLibrary.Archive decode(final BedrockResourcePackPayloads.Sources sources) throws IOException {
+        final BaseGameVersion version;
+        try {
+            version = BaseGameVersion.parse(sources.baseGameVersion());
+        } catch (final IllegalArgumentException invalid) {
+            throw new IOException("Invalid Bedrock source base version", invalid);
+        }
+        return load("packs:" + sources.cacheKey(), () -> new NativeActorLibrary.Archive(version,
+                this.decoder.decode(sources)), sources.encodedBytes() <= this.maxEncodedBytes);
+    }
+
+    private NativeActorLibrary.Archive load(final String key, final Loader loader, final boolean cacheable) throws IOException {
+        if (!cacheable) return loader.load();
+        final Entry cached = this.entries.get(key);
+        if (cached != null) {
+            return copy(cached.archive);
+        }
+        final NativeActorLibrary.Archive archive = loader.load();
+        final long weight = weight(archive);
+        if (weight <= this.budget) {
+            this.entries.put(key, new Entry(copy(archive), weight));
+            this.retained += weight;
+            final var eldest = this.entries.values().iterator();
+            while (this.retained > this.budget || this.entries.size() > this.maxEntries) {
+                this.retained -= eldest.next().weight;
+                eldest.remove();
+            }
+        }
+        return archive;
+    }
+
+    private static NativeActorLibrary.Archive copy(final NativeActorLibrary.Archive archive) {
+        final var layers = new ArrayList<NativeActorLibrary.Layer>(archive.layers().size());
+        final Map<byte[], byte[]> copies = new IdentityHashMap<>();
+        for (final var layer : archive.layers()) {
+            final Map<String, byte[]> files = copyFiles(layer.resources(), copies);
+            final Map<String, byte[]> source = layer.sourceResources() == layer.resources() ? files : copyFiles(layer.sourceResources(), copies);
+            layers.add(new NativeActorLibrary.Layer(layer.server(), files, source, layer.selectedSubpack()));
+        }
+        return new NativeActorLibrary.Archive(archive.version(), layers);
+    }
+
+    private static Map<String, byte[]> copyFiles(final Map<String, byte[]> files, final Map<byte[], byte[]> copies) {
+        final Map<String, byte[]> result = new LinkedHashMap<>();
+        files.forEach((path, bytes) -> result.put(path, copies.computeIfAbsent(bytes, byte[]::clone)));
+        return result;
+    }
+
+    private static long weight(final NativeActorLibrary.Archive archive) {
+        long weight = 256;
+        final Map<byte[], Boolean> counted = new IdentityHashMap<>();
+        for (final var layer : archive.layers()) {
+            weight += 128L + layer.selectedSubpack().length() * 2L;
+            final var views = layer.resources() == layer.sourceResources() ? List.of(layer.resources()) : List.of(layer.resources(), layer.sourceResources());
+            for (final var files : views) {
+                for (final var entry : files.entrySet()) {
+                    weight += 128L + entry.getKey().length() * 2L;
+                    if (counted.put(entry.getValue(), Boolean.TRUE) == null) weight += entry.getValue().length;
+                }
+            }
+        }
+        return weight;
+    }
+
+    @FunctionalInterface
+    private interface Loader {
+        NativeActorLibrary.Archive load() throws IOException;
+    }
+
+    @FunctionalInterface
+    interface Decoder {
+        List<NativeActorLibrary.Layer> decode(BedrockResourcePackPayloads.Sources sources) throws IOException;
+    }
+
+    private record Entry(NativeActorLibrary.Archive archive, long weight) { }
+}
