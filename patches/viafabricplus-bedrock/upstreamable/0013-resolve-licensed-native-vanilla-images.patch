+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.protocol.provider.BuiltinResourcePackProvider;
+
+import java.io.IOException;
+import java.util.List;
+
+/** Supplies bundled native images on ViaBedrock's resource-pack worker. */
+public final class ViaFabricPlusBuiltinResourcePackProvider extends BuiltinResourcePackProvider {
+    private final LibraryLoader library;
+
+    public ViaFabricPlusBuiltinResourcePackProvider() {
+        this(() -> BedrockBuiltinAssets.load().library());
+    }
+
+    ViaFabricPlusBuiltinResourcePackProvider(final LibraryLoader library) {
+        this.library = library;
+    }
+
+    @Override
+    public List<ResourcePack> load(final UserConnection user) throws IOException {
+        return this.library.load().imagePacks();
+    }
+
+    @FunctionalInterface
+    interface LibraryLoader {
+        BedrockResourceLibrary load() throws IOException;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java
