+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.protocol.provider.BuiltinResourcePackProvider;
+
+import java.io.IOException;
+import java.util.List;
+
+/** Supplies bundled native visual and actor resources on ViaBedrock's resource-pack worker. */
+public final class ViaFabricPlusBuiltinResourcePackProvider extends BuiltinResourcePackProvider {
+    private final LibraryLoader library;
+
+    public ViaFabricPlusBuiltinResourcePackProvider() {
+        this(() -> BedrockBuiltinAssets.load().library());
+    }
+
+    ViaFabricPlusBuiltinResourcePackProvider(final LibraryLoader library) {
+        this.library = library;
+    }
+
+    @Override
+    public List<ResourcePack> load(final UserConnection user) throws IOException {
+        return this.library.load().resourcePacks();
+    }
+
+    @FunctionalInterface
+    interface LibraryLoader {
+        BedrockResourceLibrary load() throws IOException;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java
new file mode 100644
index 0000000..8a17510
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java
@@ -0,0 +1,122 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ViaFabricPlusBuiltinResourcePackProviderTest {
+    @Test
+    void loadsBundledImagesWithoutAnAccount() throws Exception {
+        final var packs = new ViaFabricPlusBuiltinResourcePackProvider().load(null);
+        assertFalse(packs.isEmpty());
+        assertTrue(packs.stream().anyMatch(pack -> pack.content().get("textures/items/bread.png") != null));
+    }
+
+    @Test
+    void resolvesActualBundledNativeAlphaTestFamilies() throws Exception {
+        final ResourcePackStorage stack;
+        try (final var viaBedrock = org.mockito.Mockito.mockStatic(net.raphimc.viabedrock.ViaBedrock.class)) {
+            final var platform = org.mockito.Mockito.mock(net.raphimc.viabedrock.platform.ViaBedrockPlatform.class);
+            org.mockito.Mockito.when(platform.getLogger()).thenReturn(java.util.logging.Logger.getAnonymousLogger());
+            viaBedrock.when(net.raphimc.viabedrock.ViaBedrock::getPlatform).thenReturn(platform);
+            stack = new ResourcePackStorage(List.of(), new ViaFabricPlusBuiltinResourcePackProvider().load(null));
+        }
+        assertNotNull(stack.getModels().getEntityModel("geometry.shield"));
+        final var materials = com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions.load(stack);
+        for (final String family : List.of("entity_alphatest", "entity_alphatest_one_sided",
+                "entity_emissive_alpha", "entity_emissive_alpha_one_sided")) {
+            final var material = materials.alphaTest(family).orElseThrow();
+            assertEquals(family.endsWith("one_sided"), material.cull());
+            assertEquals(family.startsWith("entity_emissive"), material.emissive());
+        }
+        assertTrue(stack.getPackStackTopToBottom().stream()
+                .anyMatch(pack -> !pack.content().getFilesDeep("attachables/", ".json").isEmpty()));
+    }
+
+    @Test
+    void reportsDamagedBundledResources() {
+        final var provider = new ViaFabricPlusBuiltinResourcePackProvider(() -> { throw new IOException(); });
+        assertThrows(IOException.class, () -> provider.load(null));
+    }
+
+    @Test
+    void preservesNativeLayersAndExactPathsWithoutExportingDefinitions() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        files.put("library/vanilla_1.10/textures/items/shared.tga", new byte[] {10});
+        files.put("library/vanilla/textures/items/shared.png", new byte[] {1});
+        files.put("library/vanilla_1.9/textures/items/shared.png", new byte[] {9});
+        files.put("library/vanilla_base/textures/items/CaseSensitive.jpg", new byte[] {2});
+        files.put("library/vanilla/textures/item_texture.json", new byte[] {'{', '}'});
+        files.put("library/vanilla/entity/player.entity.json", new byte[] {'{', '}'});
+        files.put("library/vanilla_1.11/manifest.json", new byte[] {'{', '}'});
+        final var library = BedrockResourceLibrary.read(files);
+        final var packs = library.resourcePacks();
+        assertEquals(4, packs.size());
+        assertArrayEquals(new byte[] {1}, packs.get(0).content().get("textures/items/shared.png"));
+        assertArrayEquals(new byte[] {2}, packs.get(1).content().get("textures/items/CaseSensitive.jpg"));
+        assertNull(packs.get(1).content().get("textures/items/casesensitive.jpg"));
+        assertArrayEquals(new byte[] {9}, packs.get(2).content().get("textures/items/shared.png"));
+        assertArrayEquals(new byte[] {10}, packs.get(3).content().get("textures/items/shared.tga"));
+        for (final ResourcePack pack : packs) {
+            assertFalse(pack.content().contains("textures/item_texture.json"));
+            assertFalse(pack.content().contains("entity/player.entity.json"));
+        }
+        assertEquals(4, packs.stream().map(ResourcePack::key).distinct().count());
+        assertEquals(packs.stream().map(ResourcePack::key).toList(),
+                library.resourcePacks().stream().map(ResourcePack::key).toList());
+        packs.getFirst().content().get("textures/items/shared.png")[0] = 99;
+        assertArrayEquals(new byte[] {1}, files.get("library/vanilla/textures/items/shared.png"));
+        assertArrayEquals(new byte[] {1}, library.resourcePacks().getFirst().content().get("textures/items/shared.png"));
+    }
+
+    @Test
+    void resolvesHigherNativeExtensionsBelowServerOverrides() throws Exception {
+        final var library = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/textures/items/shared.png", new byte[] {1},
+                "library/vanilla_1.26.51/textures/items/shared.tga", new byte[] {2}));
+        final var provider = new ViaFabricPlusBuiltinResourcePackProvider(() -> library);
+        final var builtin = provider.load(null);
+        final var stack = new ResourcePackStorage(List.of(), builtin);
+        assertArrayEquals(new byte[] {2}, selectedImage(stack, "textures/items/shared"));
+
+        final var serverContent = new InMemoryContent();
+        serverContent.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"server\","
+                + "\"uuid\":\"6c9c1d60-6b4c-4ddb-b0be-8531a370f405\",\"version\":[1,0,0]}}");
+        serverContent.put("textures/items/shared.png", new byte[] {3});
+        final var server = new ResourcePack(serverContent);
+        assertArrayEquals(new byte[] {3}, selectedImage(new ResourcePackStorage(List.of(server), builtin),
+                "textures/items/shared"));
+    }
+
+    @Test
+    void deliversBundledActorDependenciesAndMaterialInheritance() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        final byte[] definition = "{}".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        for (final String folder : List.of("models", "animations", "animation_controllers", "render_controllers"))
+            files.put("library/vanilla/" + folder + "/native.json", definition);
+        files.put("library/vanilla/materials/entity.material", definition);
+        files.put("library/vanilla_1.26.10/attachables/native.json", definition);
+        final var packs = new ViaFabricPlusBuiltinResourcePackProvider(() -> BedrockResourceLibrary.read(files)).load(null);
+        assertEquals(2, packs.size());
+        for (final String folder : List.of("models", "animations", "animation_controllers", "render_controllers"))
+            assertArrayEquals(definition, packs.getFirst().content().get(folder + "/native.json"));
+        assertArrayEquals(definition, packs.getFirst().content().get("materials/entity.material"));
+        assertArrayEquals(definition, packs.getLast().content().get("attachables/native.json"));
+    }
+
+    private static byte[] selectedImage(final ResourcePackStorage stack, final String path) {
+        for (final ResourcePack pack : stack.getPackStackTopToBottom()) {
+            final String fullPath = pack.content().getFullPath(path, "png", "jpg", "tga");
+            if (fullPath != null) return pack.content().get(fullPath);
+        }
+        return null;
+    }
+}
