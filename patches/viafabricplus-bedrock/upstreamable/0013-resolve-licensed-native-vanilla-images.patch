+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.raphimc.viabedrock.api.resourcepack.BaseGameVersion;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import net.raphimc.viabedrock.api.resourcepack.BedrockResourcePackPayloads;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import java.io.IOException;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockAcceptedArchiveCacheTest {
+    @Test
+    void reloadsReuseDecodedContentWithoutSharingMutableBytesBetweenGenerations() throws Exception {
+        final var decodes = new AtomicInteger();
+        final var cache = new BedrockAcceptedArchiveCache(input -> {
+            decodes.incrementAndGet();
+            return BedrockResourcePackPayloads.decode(input);
+        }, 4096, 2, 4096);
+        final byte[] encoded = {1, 2, 3};
+        final var first = cache.decode(source(encoded));
+        first.layers().getFirst().resources().get("textures/probe.png")[0] = 99;
+        final var second = cache.decode(source(encoded));
+        assertEquals(1, decodes.get());
+        assertNotSame(first, second);
+        assertEquals(first.version(), second.version());
+        assertEquals("", second.layers().getFirst().selectedSubpack());
+        assertArrayEquals(encoded, second.layers().getFirst().sourceResources().get("future/probe.custom"));
+        second.layers().getFirst().sourceResources().get("future/probe.custom")[0] = 88;
+        assertArrayEquals(encoded, cache.decode(source(encoded)).layers().getFirst().sourceResources().get("future/probe.custom"));
+        assertArrayEquals(encoded, second.layers().getFirst().resources().get("textures/probe.png"));
+        second.layers().getFirst().resources().get("textures/probe.png")[1] = 99;
+        assertArrayEquals(encoded, cache.decode(source(encoded)).layers().getFirst().resources().get("textures/probe.png"));
+        assertEquals(1, decodes.get());
+        assertArrayEquals(new byte[]{4}, cache.decode(source(new byte[]{4})).layers().getFirst().resources().get("textures/probe.png"));
+        assertEquals(2, decodes.get());
+    }
+
+    @Test
+    void entryAndByteBudgetsDoNotRetainUnboundedArchives() throws Exception {
+        final var decodes = new AtomicInteger();
+        final BedrockAcceptedArchiveCache.Decoder decoder = input -> {
+            decodes.incrementAndGet();
+            return BedrockResourcePackPayloads.decode(input);
+        };
+        final var oneEntry = new BedrockAcceptedArchiveCache(decoder, 4096, 1, 4096);
+        for (final int marker : List.of(1, 2, 1)) oneEntry.decode(source(new byte[]{(byte) marker}));
+        assertEquals(3, decodes.get());
+        final var noSpace = new BedrockAcceptedArchiveCache(decoder, 1, 2, 4096);
+        noSpace.decode(source(new byte[]{3}));
+        noSpace.decode(source(new byte[]{3}));
+        assertEquals(5, decodes.get());
+    }
+
+    @Test
+    void uncacheableLargeInputsReachTheCodecWithoutTruncationAndFailuresCanRetry() throws Exception {
+        final var decodes = new AtomicInteger();
+        final var cache = new BedrockAcceptedArchiveCache(input -> {
+            decodes.incrementAndGet();
+            final var layers = BedrockResourcePackPayloads.decode(input);
+            final byte[] bytes = layers.getFirst().resources().get("textures/probe.png");
+            if (bytes[0] == 0) throw new IOException("Invalid archive");
+            return layers;
+        }, 4096, 2, 2);
+        final byte[] large = {1, 2, 3, 4, 5};
+        assertArrayEquals(large, cache.decode(source(large)).layers().getFirst().resources().get("textures/probe.png"));
+        cache.decode(source(large));
+        assertEquals(2, decodes.get());
+        assertThrows(IOException.class, () -> cache.decode(source(new byte[]{0})));
+        assertThrows(IOException.class, () -> cache.decode(source(new byte[]{0})));
+        assertEquals(4, decodes.get());
+    }
+
+    private static BedrockResourcePackPayloads.Sources source(final byte[] bytes) throws IOException {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"cache\",\"uuid\":\"00000000-0000-0000-0000-000000000001\",\"version\":[1,0,0]}}");
+        content.put("textures/probe.png", bytes);
+        content.put("future/probe.custom", bytes.clone());
+        final var exported = BedrockResourcePackPayloads.export(BaseGameVersion.CURRENT.toString(), List.of(new ResourcePack(content)), ignored -> true);
+        return BedrockResourcePackPayloads.prepare(exported.getJson("pack.mcmeta").getAsJsonObject(BedrockResourcePackPayloads.METADATA_SECTION),
+                sha -> new ByteArrayInputStream(exported.get(BedrockResourcePackPayloads.PAYLOAD_DIRECTORY + sha + ".mcpack")));
+    }
+}
