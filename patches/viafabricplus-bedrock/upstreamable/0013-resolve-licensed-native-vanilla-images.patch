+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.protocol.provider.BuiltinResourcePackProvider;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.function.Supplier;
+
+/** Resolves licensed native images on ViaBedrock's resource-pack worker. */
+public final class ViaFabricPlusBuiltinResourcePackProvider extends BuiltinResourcePackProvider {
+    private final Supplier<BedrockAuthManager> account;
+    private final LibraryLoader library;
+
+    public ViaFabricPlusBuiltinResourcePackProvider() {
+        this(() -> ViaFabricPlusBedrock.impl().account().get(),
+                account -> BedrockBuiltinAssets.load(account).library());
+    }
+
+    ViaFabricPlusBuiltinResourcePackProvider(final Supplier<BedrockAuthManager> account, final LibraryLoader library) {
+        this.account = account;
+        this.library = library;
+    }
+
+    @Override
+    public List<ResourcePack> load(final UserConnection user) throws Exception {
+        final BedrockAuthManager selected = this.account.get();
+        if (selected == null) return List.of();
+        try {
+            return this.library.load(selected).imagePacks();
+        } catch (IOException unavailable) {
+            // Licensed images supplement the normal mappings and server resources.
+            // An unavailable optional download must not reject the server's pack stack.
+            return List.of();
+        }
+    }
+
+    @FunctionalInterface
+    interface LibraryLoader {
+        BedrockResourceLibrary load(BedrockAuthManager account) throws Exception;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/ViaFabricPlusBuiltinResourcePackProviderTest.java
new file mode 100644
index 0000000..2c3050d
