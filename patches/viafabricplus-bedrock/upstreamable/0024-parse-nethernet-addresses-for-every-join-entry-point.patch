From 1db48a167daa5fa26773b515d45b52f223974453 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Tue, 6 Oct 2026 03:01:01 +0200
Subject: [PATCH] fix(network): parse NetherNet addresses for every join entry
 point

Quick Play calls ServerAddress.parseString directly and skips the multiplayer screen wrapper. A direct NetherNet URI consequently reaches DNS as an invalid host before signaling starts. Parse the supported schemes at the shared address entry point and remove the redundant screen parser so launcher, saved-server, and menu joins retain the same socket address. Ordinary addresses keep vanilla parsing and existing default-port handling.
---
 .../mixin/core/access/MixinServerAddress.java     | 15 ++++++++++++++-
 .../integration/MixinJoinMultiplayerScreen.java   | 13 -------------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinServerAddress.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinServerAddress.java
index a23abf4..edcf9cb 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinServerAddress.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/access/MixinServerAddress.java
@@ -22,8 +22,8 @@
 package com.viaversion.viafabricplus.bedrock.injection.mixin.core.access;
 
 import com.viaversion.viafabricplus.bedrock.injection.access.IServerAddress;
-import java.net.SocketAddress;
 import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.NetherNetAddressParser;
+import java.net.SocketAddress;
 import net.minecraft.client.multiplayer.resolver.ServerAddress;
 import org.spongepowered.asm.mixin.Mixin;
 import org.spongepowered.asm.mixin.Unique;
@@ -34,6 +34,19 @@ import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
 @Mixin(ServerAddress.class)
 public abstract class MixinServerAddress implements IServerAddress {
 
+    @Inject(method = "parseString", at = @At("HEAD"), cancellable = true)
+    private static void parseNetherNetAddress(final String input, final CallbackInfoReturnable<ServerAddress> cir) {
+        if (input == null) {
+            return;
+        }
+        final SocketAddress netherNetAddress = NetherNetAddressParser.parse(input);
+        if (netherNetAddress != null) {
+            final ServerAddress address = new ServerAddress("nethernet.viafabricplus.localhost", 25565);
+            ((IServerAddress) (Object) address).viaFabricPlusBedrock$setNetherNetAddress(netherNetAddress);
+            cir.setReturnValue(address);
+        }
+    }
+
     @Inject(method = "isValidAddress", at = @At("HEAD"), cancellable = true)
     private static void allowNetherNetAddress(final String input, final CallbackInfoReturnable<Boolean> cir) {
         if (NetherNetAddressParser.parse(input) != null) {
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/integration/MixinJoinMultiplayerScreen.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/integration/MixinJoinMultiplayerScreen.java
