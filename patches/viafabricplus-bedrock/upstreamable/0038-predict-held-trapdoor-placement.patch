@@ -0,0 +1,37 @@
+package com.viaversion.viafabricplus.bedrock.input;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class HeldBlockUseTimingTest {
+    @Test
+    void successfulUsesRestartTheDelayWhileFailedRepeatsAndItemChangesDoNot() {
+        final var timing = new HeldBlockUseTiming();
+        assertFalse(timing.ready(1_000_000_000L));
+        timing.attempted(1_000_000_000L, false);
+        assertFalse(timing.ready(1_299_999_999L));
+        assertTrue(timing.ready(1_300_000_000L));
+        timing.attempted(1_350_000_000L, false);
+        assertTrue(timing.ready(1_350_000_000L));
+        assertTrue(timing.ready(1_351_000_000L));
+        timing.attempted(1_400_000_000L, true);
+        assertFalse(timing.ready(1_699_999_999L));
+        assertTrue(timing.ready(1_700_000_000L));
+        timing.clear();
+        timing.clear();
+        assertFalse(timing.active());
+        timing.attempted(2_000_000_000L, false);
+        assertFalse(timing.ready(2_299_999_999L));
+        assertTrue(timing.ready(2_300_000_000L));
+    }
+
+    @Test
+    void monotonicClockRolloverKeepsTheSameDelay() {
+        final var timing = new HeldBlockUseTiming();
+        final long start = Long.MAX_VALUE - 150_000_000L;
+        timing.attempted(start, false);
+        assertFalse(timing.ready(start + 299_999_999L));
+        assertTrue(timing.ready(start + 300_000_000L));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/inventory/TrapdoorPlacementTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/inventory/TrapdoorPlacementTest.java
