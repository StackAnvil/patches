+
+    @Test
+    void movingLineRepeatsFollowTheirPreviousDeadlineAtMostOneHundredEightyMillisecondsBehind() {
+        final var input = new ItemUseState();
+        input.attemptedBlock(1_000_000_000L, true);
+        // Six blocks per second: 900 / 6 = 150 ms.
+        input.pace(true, false, 36F, false);
+        assertFalse(input.frameReady(1_150_000_000L));
+        assertTrue(input.frameReady(1_150_000_001L));
+        input.attemptedBlock(1_170_000_000L, true);
+        assertFalse(input.frameReady(1_300_000_000L));
+        assertTrue(input.frameReady(1_300_000_001L));
+        input.attemptedBlock(1_700_000_000L, true);
+        assertFalse(input.frameReady(1_670_000_000L));
+        assertTrue(input.frameReady(1_670_000_001L));
+    }
+
+    @Test
+    void movingDelayIsCappedAtOneHundredEightyAndFloorsAtOneHundredOutsideCreative() {
+        final var input = new ItemUseState();
+        input.attemptedBlock(1_000_000_000L, true);
+        input.pace(true, false, 1F, false);
+        assertFalse(input.frameReady(1_180_000_000L));
+        assertTrue(input.frameReady(1_180_000_001L));
+        input.pace(true, false, 400F, false);
+        assertFalse(input.frameReady(1_100_000_000L));
+        assertTrue(input.frameReady(1_100_000_001L));
+        input.pace(true, false, 400F, true);
+        assertFalse(input.frameReady(1_045_000_000L));
+        assertTrue(input.frameReady(1_045_000_001L));
+    }
+
+    @Test
+    void movingBeforeALineKeepsTheFirstBuildDelay() {
+        final var input = new ItemUseState();
+        input.attemptedBlock(1_000_000_000L, true);
+        input.pace(false, false, 36F, false);
+        assertFalse(input.frameReady(1_300_000_000L));
+        assertTrue(input.frameReady(1_300_000_001L));
+    }
+
+    @Test
+    void monotonicClockRolloverKeepsBothDeadlines() {
+        final var timing = new ItemUseState();
+        final long start = Long.MAX_VALUE - 150_000_000L;
+        timing.attemptedBlock(start, true);
+        timing.release();
+        assertTrue(timing.admitLegacyAirUse(start, InteractionHand.MAIN_HAND, true, false, true));
+        assertFalse(timing.frameReady(start + 200_000_000L));
+        assertTrue(timing.frameReady(start + 200_000_001L));
+        timing.release();
+        timing.attemptedBlock(start, true);
+        assertFalse(timing.frameReady(start + 299_999_999L));
+        assertFalse(timing.frameReady(start + 300_000_000L));
+        assertTrue(timing.frameReady(start + 300_000_001L));
+    }
+}
