+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.inventory;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockItemUse;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ServerboundUseItemOnPacket;
+import net.minecraft.network.protocol.game.ServerboundUseItemPacket;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+import net.minecraft.client.player.LocalPlayer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(MultiPlayerGameMode.class)
+public abstract class MixinHeldBlockUse {
+    @WrapOperation(method = "performUseItemOn", at = @At(value = "INVOKE",
+        target = "Lnet/minecraft/client/player/LocalPlayer;isSecondaryUseActive()Z"))
+    private boolean suppressBlockInteraction(final LocalPlayer player, final Operation<Boolean> original) {
+        return BedrockItemUse.suppressInteraction() || original.call(player);
+    }
+
+    @Inject(method = "useItemOn", at = @At("HEAD"), cancellable = true)
+    private void restrictSnappedTargets(final LocalPlayer player, final InteractionHand hand, final BlockHitResult hit,
+                                       final CallbackInfoReturnable<InteractionResult> cir) {
+        if (!BedrockItemUse.allows(hit.getBlockPos(), player.level().getBlockState(hit.getBlockPos()))) {
+            cir.setReturnValue(InteractionResult.FAIL);
+        }
+    }
+
+    @Inject(method = "performUseItemOn", at = @At("HEAD"))
+    private void beginLocalPrediction(final LocalPlayer player, final InteractionHand hand, final BlockHitResult hit,
+                                      final CallbackInfoReturnable<InteractionResult> cir) {
+        BedrockItemUse.beginPrediction(hit);
+    }
+
+    @Inject(method = "performUseItemOn", at = @At("RETURN"))
+    private void retainLocalResult(final LocalPlayer player, final InteractionHand hand, final BlockHitResult hit,
+                                  final CallbackInfoReturnable<InteractionResult> cir) {
+        BedrockItemUse.predicted(cir.getReturnValue().consumesAction());
+    }
+
+    @WrapOperation(method = "startPrediction", at = @At(value = "INVOKE",
+        target = "Lnet/minecraft/client/multiplayer/ClientPacketListener;send(Lnet/minecraft/network/protocol/Packet;)V"))
+    private void sendLocalItemPrediction(final ClientPacketListener connection, final Packet<?> packet, final Operation<Void> original) {
+        if (packet instanceof ServerboundUseItemOnPacket use) {
+            BedrockItemUse.sendPrediction(use.sequence());
+        } else if (packet instanceof ServerboundUseItemPacket use) {
+            // Local item prediction has finished; send its result before the concluding use packet.
+            BedrockItemUse.sendItemPrediction(use.sequence(), use.hand());
+        }
+        original.call(connection, packet);
+    }
+
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/input/BedrockItemUse.java b/src/main/java/com/viaversion/viafabricplus/bedrock/input/BedrockItemUse.java
new file mode 100644
index 0000000..4cad621
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/input/BedrockItemUse.java
@@ -0,0 +1,269 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import com.viaversion.viafabricplus.bedrock.inventory.TrapdoorPlacement;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockItemMetadata;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.BlockItem;
+import net.minecraft.world.level.block.TrapDoorBlock;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.HitResult;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.api.model.PlayerBlockUse;
+import net.raphimc.viabedrock.api.model.ItemUsePrediction;
+
+public final class BedrockItemUse {
+    private static final TrapdoorPlacement PLACEMENT = new TrapdoorPlacement();
+    private static final BlockPlacementPath PATH = new BlockPlacementPath();
+    private static boolean held;
+    private static boolean placedBlock;
+    private static boolean successfulAttempt;
+    private static boolean airAllowed;
+    private static Boolean pendingAirPredicate;
+    private static boolean pendingAirItem;
+    private static boolean pendingFoodUse;
+    private static ItemStack predictedItem = ItemStack.EMPTY;
+    private static final ItemUseState INPUT = new ItemUseState();
+    private static Position3f cursor;
+    private static BlockUsePrediction.Result predictedResult = BlockUsePrediction.Result.FAILED;
+
+    private BedrockItemUse() {}
+
+    public static void register() {
+        PayloadTypeRegistry.serverboundPlay().register(BlockUsePayload.TYPE, BlockUsePayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(ItemUsePredictionPayload.TYPE, ItemUsePredictionPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(BlockUsePredictionPayload.TYPE, BlockUsePredictionPayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(BlockUsePredictionPayload.AIR_TYPE, BlockUsePredictionPayload.AIR_CODEC);
+        ClientTickEvents.START_CLIENT_TICK.register(client -> refresh());
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> reset());
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> reset());
+    }
+
+    public static void begin(final boolean freshPress) {
+        if (freshPress) {
+            update(false);
+        }
+        update(true);
+        successfulAttempt = false;
+    }
+
+    public static boolean beginAirUse(final InteractionHand hand, final ItemStack item) {
+        if (!bedrockConnection()) {
+            return true;
+        }
+        final var consumable = item.get(DataComponents.CONSUMABLE);
+        final boolean canConsume = consumable != null && consumable.canConsume(Minecraft.getInstance().player, item);
+        pendingAirPredicate = null;
+        final Boolean predicate = BedrockItemMetadata.get(item.get(DataComponents.CUSTOM_DATA)).retainsAirUse();
+        if (predicate == null) {
+            return INPUT.admitLegacyAirUse(System.nanoTime(), hand, item.has(DataComponents.FOOD), held && item.getItem() instanceof BlockItem, canConsume);
+        }
+        final boolean admitted = INPUT.admitAirUse(System.nanoTime(), hand);
+        if (admitted && hand == InteractionHand.MAIN_HAND) {
+            pendingAirPredicate = predicate;
+            pendingAirItem = !item.isEmpty();
+            // Java can finish zero-duration food inside useItem; retain its admitted native use route.
+            pendingFoodUse = item.has(DataComponents.FOOD) && canConsume;
+        }
+        return admitted;
+    }
+
+    public static void beginItemPrediction(final InteractionHand hand, final ItemStack item) {
+        predictedItem = hand == InteractionHand.MAIN_HAND && bedrockConnection()
+            && ClientPlayNetworking.canSend(ItemUsePredictionPayload.TYPE) ? item.copy() : ItemStack.EMPTY;
+    }
+
+    public static void sendItemPrediction(final int sequence, final InteractionHand hand) {
+        final var player = Minecraft.getInstance().player;
+        if (!predictedItem.isEmpty() && hand == InteractionHand.MAIN_HAND && player != null && bedrockConnection()
+                && ClientPlayNetworking.canSend(ItemUsePredictionPayload.TYPE)) {
+            final ItemStack after = player.getItemInHand(hand);
+            final boolean consumed = after.getCount() < predictedItem.getCount()
+                && (after.isEmpty() || BedrockUsedItem.matches(after, predictedItem));
+            ClientPlayNetworking.send(new ItemUsePredictionPayload(new ItemUsePrediction(sequence, consumed)));
+        }
+        predictedItem = ItemStack.EMPTY;
+    }
+
+    public static void airResult(final InteractionHand hand) {
+        if (hand == InteractionHand.MAIN_HAND && pendingAirPredicate != null && bedrockConnection()) {
+            INPUT.airResult(Minecraft.getInstance().player.isUsingItem() || pendingFoodUse, pendingAirItem, pendingAirPredicate);
+        }
+        pendingAirPredicate = null;
+        predictedItem = ItemStack.EMPTY;
+    }
+
+    public static HitResult.Type hitType(final HitResult.Type target, final InteractionHand hand) {
+        return INPUT.hitType(System.nanoTime(), target, hand);
+    }
+
+    private static boolean bedrockConnection() {
+        return Minecraft.getInstance().getConnection() != null && BedrockInputPermissions.isBedrockConnection();
+    }
+
+    public static void release() {
+        update(false);
+    }
+
+    private static boolean canPredict() {
+        return ClientPlayNetworking.canSend(BlockUsePredictionPayload.TYPE)
+            || ClientPlayNetworking.canSend(BlockUsePredictionPayload.AIR_TYPE);
+    }
+
+    private static void update(final boolean value) {
+        if (!bedrockConnection()) {
+            reset();
+            return;
+        }
+        if (!value) {
+            INPUT.release();
+        }
+        if (!ClientPlayNetworking.canSend(BlockUsePayload.TYPE) || !canPredict()) {
+            resetBlockUse();
+            return;
+        }
+        if (held != value) {
+            held = value;
+            ClientPlayNetworking.send(new BlockUsePayload(new PlayerBlockUse(value)));
+        }
+        if (!value) {
+            PLACEMENT.clear();
+            PATH.clear();
+        }
+    }
+
+    private static boolean holdingTrapdoor() {
+        final var player = Minecraft.getInstance().player;
+        return player != null && player.getMainHandItem().getItem() instanceof BlockItem block
+            && block.getBlock() instanceof TrapDoorBlock;
+    }
+
+    public static InteractionResult blockResult(final InteractionResult result, final InteractionHand hand) {
+        final var player = Minecraft.getInstance().player;
+        // Java stops at FAIL; native still invokes the block item's first ordinary air use.
+        return held && hand == InteractionHand.MAIN_HAND && !INPUT.blockActive() && player != null
+            && player.getMainHandItem().getItem() instanceof BlockItem && result instanceof InteractionResult.Fail
+            ? InteractionResult.PASS : result;
+    }
+
+    public static void attempted() {
+        if (held && Minecraft.getInstance().player.getMainHandItem().isEmpty()) {
+            INPUT.retainBlockUse();
+        }
+        if (held && (successfulAttempt || INPUT.blockActive())) {
+            INPUT.attemptedBlock(System.nanoTime(), successfulAttempt);
+        }
+    }
+
+    public static boolean repeatsFromFrames() {
+        return INPUT.repeatsFromFrames();
+    }
+
+    public static boolean frameReady() {
+        return repeatsFromFrames() && INPUT.frameReady(System.nanoTime(), PATH.active());
+    }
+
+    public static void refresh() {
+        final var client = Minecraft.getInstance();
+        update(client.player != null && client.gui.screen() == null && client.gui.overlay() == null
+            && !client.player.isSpectator() && client.options.keyUse.isDown());
+    }
+
+    public static boolean suppressInteraction() {
+        final var player = Minecraft.getInstance().player;
+        return held && INPUT.blockActive() && player != null && player.getMainHandItem().getItem() instanceof BlockItem;
+    }
+
+    public static boolean allows(final BlockPos target, final BlockState state) {
+        return !held || !holdingTrapdoor() || PLACEMENT.allows(target, state);
+    }
+
+    public static BlockHitResult blockHit(final BlockHitResult hit, final boolean frameRepeat) {
+        final var player = Minecraft.getInstance().player;
+        return held && frameRepeat && INPUT.blockActive() && player != null
+                && player.getMainHandItem().getItem() instanceof BlockItem
+                ? PATH.select(player.getEyePosition(1F), hit) : hit;
+    }
+
+    public static void buildAttempt(final BlockPos position, final boolean success, final boolean atUpperBuildLimit) {
+        if (held) {
+            PATH.attempted(position, success, atUpperBuildLimit);
+        }
+    }
+
+    public static void placed(final BlockState state, final BlockPos support, final Vec3 hit) {
+        placedBlock = true;
+        if (held) {
+            PLACEMENT.remember(state, support, hit);
+        }
+    }
+
+    public static void beginPrediction(final BlockHitResult hit) {
+        clearPrediction();
+        final Vec3 relative = held && holdingTrapdoor() ? PLACEMENT.clickPosition(hit.getBlockPos(), hit.getLocation())
+            : hit.getLocation().subtract(Vec3.atLowerCornerOf(hit.getBlockPos()));
+        cursor = new Position3f((float) relative.x, (float) relative.y, (float) relative.z);
+    }
+
+    private static void clearPrediction() {
+        cursor = null;
+        placedBlock = false;
+        predictedResult = BlockUsePrediction.Result.FAILED;
+        airAllowed = false;
+    }
+
+    public static void predicted(final boolean success) {
+        successfulAttempt |= success;
+        predictedResult = !success ? BlockUsePrediction.Result.FAILED
+            : placedBlock ? BlockUsePrediction.Result.PLACED : BlockUsePrediction.Result.INTERACTED;
+        if (held && predictedResult == BlockUsePrediction.Result.PLACED) {
+            airAllowed = INPUT.placedBlock(System.nanoTime(), !Minecraft.getInstance().player.getMainHandItem().isEmpty());
+        }
+    }
+
+    public static void sendPrediction(final int sequence) {
+        if (cursor != null && BedrockInputPermissions.isBedrockConnection() && Minecraft.getInstance().getConnection() != null
+                && canPredict()) {
+            ClientPlayNetworking.send(new BlockUsePredictionPayload(new BlockUsePrediction(sequence, predictedResult, cursor, airAllowed),
+                ClientPlayNetworking.canSend(BlockUsePredictionPayload.AIR_TYPE)));
+        }
+        clearPrediction();
+    }
+
+    public static BlockState placement(final BlockState state) {
+        return held ? PLACEMENT.apply(state) : state;
+    }
+
+    private static void resetBlockUse() {
+        held = false;
+        INPUT.cancelPlacement();
+        clearPrediction();
+        PLACEMENT.clear();
+        PATH.clear();
+    }
+
+    private static void reset() {
+        resetBlockUse();
+        INPUT.clear();
+        pendingAirPredicate = null;
+        pendingAirItem = false;
+        pendingFoodUse = false;
+        predictedItem = ItemStack.EMPTY;
+    }
+}
