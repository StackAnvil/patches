+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.phys.HitResult;
+
+/** A physical hold retains its air or placement route until release. */
+public final class ItemUseState {
+    private static final long AIR_DELAY_NANOS = 200_000_000L;
+    private static final long BLOCK_DELAY_NANOS = 300_000_000L;
+    private static final long LINE_DELAY_NANOS = 200_000_000L;
+    private boolean airActive;
+    private boolean airAttempted;
+    private long airStartedAt;
+    private boolean blockActive;
+    private long blockStartedAt;
+    private boolean blockDelayed;
+
+    public boolean canAttempt(final long now) {
+        return !this.airAttempted || now - this.airStartedAt > AIR_DELAY_NANOS;
+    }
+
+    public boolean admitAirUse(final long now, final InteractionHand hand) {
+        if (hand != InteractionHand.MAIN_HAND) {
+            return !this.airActive && !this.blockActive;
+        }
+        if (this.blockActive) {
+            return false;
+        }
+        if (!this.canAttempt(now)) {
+            if (!this.airActive) {
+                this.blockActive = true;
+            }
+            return false;
+        }
+        this.recordAirUse(now);
+        return true;
+    }
+
+    public void airResult(final boolean activeUse, final boolean retainedItem, final boolean retainsAirUse) {
+        if (!this.airActive) {
+            this.airActive = activeUse || retainedItem && retainsAirUse;
+            this.blockActive = !this.airActive;
+        }
+    }
+
+    /** Older proxy cores do not provide native item predicates. Preserve their prior route selection. */
+    public boolean admitLegacyAirUse(final long now, final InteractionHand hand, final boolean food, final boolean blockItem, final boolean canConsume) {
+        if (hand != InteractionHand.MAIN_HAND) {
+            return !this.airActive && !this.blockActive;
+        }
+        if (this.blockActive) {
+            return false;
+        }
+        if (!this.canAttempt(now)) {
+            if (!this.airActive && (food || blockItem)) {
+                this.blockActive = true;
+            }
+            return false;
+        }
+        if (!this.airActive && !food && !blockItem) {
+            return true;
+        }
+        if (this.airActive || food && canConsume) {
+            this.airActive = true;
+        } else {
+            this.blockActive = true;
+        }
+        this.recordAirUse(now);
+        return true;
+    }
+
+    public boolean placedBlock(final long now, final boolean hasRemainder) {
+        if (!this.airActive && !this.blockActive && hasRemainder && this.canAttempt(now)) {
+            this.recordAirUse(now);
+            return true;
+        }
+        return false;
+    }
+
+    private void recordAirUse(final long now) {
+        this.airAttempted = true;
+        this.airStartedAt = now;
+    }
+
+    public HitResult.Type hitType(final long now, final HitResult.Type target, final InteractionHand hand) {
+        if (!this.blockActive && target == HitResult.Type.ENTITY && !this.canAttempt(now)) {
+            return HitResult.Type.MISS;
+        }
+        return this.airActive || this.blockActive && hand != InteractionHand.MAIN_HAND ? HitResult.Type.MISS : target;
+    }
+
+    public void retainBlockUse() {
+        if (!this.airActive) {
+            this.blockActive = true;
+        }
+    }
+
+    public void attemptedBlock(final long now, final boolean success) {
+        if (!this.airActive && (!this.blockActive || success)) {
+            this.blockStartedAt = now;
+            this.blockDelayed = true;
+            this.blockActive = true;
+        }
+    }
+
+    public boolean blockActive() {
+        return this.blockActive;
+    }
+
+    public boolean repeatsFromFrames() {
+        return this.airActive || this.blockActive;
+    }
+
+    public boolean frameReady(final long now, final boolean placementLine) {
+        return this.blockActive
+            ? !this.blockDelayed || now - this.blockStartedAt > (placementLine ? LINE_DELAY_NANOS : BLOCK_DELAY_NANOS)
+            : this.canAttempt(now) && this.airActive;
+    }
+
+    public void cancelPlacement() {
+        this.blockActive = false;
+        this.blockDelayed = false;
+    }
+
+    public void release() {
+        this.airActive = false;
+        this.cancelPlacement();
+    }
+
+    public void clear() {
+        this.release();
+        this.airAttempted = false;
+    }
+}
