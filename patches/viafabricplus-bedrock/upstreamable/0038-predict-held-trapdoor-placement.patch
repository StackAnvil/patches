+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.component.DataComponentMap;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.entity.player.Inventory;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.component.CustomData;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.mockito.Mockito.*;
+
+final class BedrockItemUseReleaseTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        // The client normally receives holder defaults from the server, so bind them when this class runs alone.
+        if (!Items.PAPER.builtInRegistryHolder().areComponentsBound()) {
+            Items.PAPER.builtInRegistryHolder().bindComponents(DataComponentMap.EMPTY);
+        }
+    }
+
+    @Test
+    void mouseUpReleasesNativeShooterOnceWithoutAJavaUseCycle() throws Exception {
+        final var game = mock(Minecraft.class);
+        final var player = mock(LocalPlayer.class);
+        final var mode = mock(MultiPlayerGameMode.class);
+        final var inventory = mock(Inventory.class);
+        Minecraft.class.getField("player").set(game, player);
+        Minecraft.class.getField("gameMode").set(game, mode);
+        when(game.getConnection()).thenReturn(mock(ClientPacketListener.class));
+        when(player.getInventory()).thenReturn(inventory);
+        when(inventory.getSelectedSlot()).thenReturn(0);
+        final var tag = new CompoundTag();
+        tag.putString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "fixture:shooter");
+        tag.putBoolean(ItemDataRewriter.BEDROCK_USE_RELEASE_TAG, true);
+        final var item = new ItemStack(Items.PAPER);
+        item.set(DataComponents.CUSTOM_DATA, CustomData.of(tag));
+        when(player.getMainHandItem()).thenReturn(item);
+        when(player.isUsingItem()).thenReturn(false);
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var permissions = mockStatic(BedrockInputPermissions.class);
+             final var network = mockStatic(ClientPlayNetworking.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            permissions.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            BedrockItemUse.beginItemPrediction(InteractionHand.MAIN_HAND, item);
+            BedrockItemUse.airResult(InteractionHand.MAIN_HAND);
+            BedrockItemUse.releaseKey();
+            BedrockItemUse.releaseKey();
+            verify(mode, times(1)).releaseUsingItem(player);
+
+            // Sharing the Java carrier does not give an ordinary native item a release lifetime.
+            clearInvocations(mode);
+            tag.putString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "fixture:ordinary");
+            tag.putBoolean(ItemDataRewriter.BEDROCK_USE_RELEASE_TAG, false);
+            item.set(DataComponents.CUSTOM_DATA, CustomData.of(tag));
+            BedrockItemUse.beginItemPrediction(InteractionHand.MAIN_HAND, item);
+            BedrockItemUse.airResult(InteractionHand.MAIN_HAND);
+            BedrockItemUse.releaseKey();
+            verifyNoInteractions(mode);
+        }
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/input/BlockPlacementPathTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/input/BlockPlacementPathTest.java
