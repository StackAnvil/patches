+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+
+/** Retains the next cell after adjacent build attempts establish a placement direction. */
+public final class BlockPlacementPath {
+    private BlockPos previous;
+    private BlockPos next;
+    private Direction direction;
+    private boolean succeeded;
+
+    public void attempted(final BlockPos position, final boolean success, final boolean atUpperBuildLimit) {
+        if (this.next == null && this.succeeded && this.previous != null && this.previous.distManhattan(position) == 1) {
+            final BlockPos delta = position.subtract(this.previous);
+            this.direction = Direction.getNearest(delta, Direction.UP);
+            this.next = position.immutable();
+        }
+        if (success && position.equals(this.next)) {
+            this.next = position.relative(this.direction);
+        }
+        // Ordinary failure preserves the last build position; the upper height limit records its attempt.
+        if (success || atUpperBuildLimit) {
+            this.previous = position.immutable();
+        }
+        this.succeeded |= success;
+    }
+
+    public boolean active() {
+        return this.next != null;
+    }
+
+    public BlockHitResult select(final Vec3 origin, final BlockHitResult hit) {
+        if (this.next == null) {
+            return hit;
+        }
+        return intersects(this.next, origin, hit.getLocation())
+                ? hit.withPosition(this.next.relative(this.direction.getOpposite())).withDirection(this.direction) : null;
+    }
+
+    // Native 1.26.60.5 segment/box SAT uses float midpoints, half extents and 0.0001 cross-axis tolerance.
+    static boolean intersects(final BlockPos cell, final Vec3 origin, final Vec3 end) {
+        final float ox = (float) origin.x;
+        final float oy = (float) origin.y;
+        final float oz = (float) origin.z;
+        final float dx = ((float) end.x - ox) * .5F;
+        final float dy = ((float) end.y - oy) * .5F;
+        final float dz = ((float) end.z - oz) * .5F;
+        final float minX = cell.getX();
+        final float minY = cell.getY();
+        final float minZ = cell.getZ();
+        final float maxX = minX + 1F;
+        final float maxY = minY + 1F;
+        final float maxZ = minZ + 1F;
+        final float ex = (maxX - minX) * .5F;
+        final float ey = (maxY - minY) * .5F;
+        final float ez = (maxZ - minZ) * .5F;
+        final float x = (ox + dx) - (maxX + minX) * .5F;
+        final float y = (oy + dy) - (maxY + minY) * .5F;
+        final float z = (oz + dz) - (maxZ + minZ) * .5F;
+        final float ax = Math.abs(dx);
+        final float ay = Math.abs(dy);
+        final float az = Math.abs(dz);
+        return Math.abs(x) <= ax + ex && Math.abs(y) <= ay + ey && Math.abs(z) <= az + ez
+                && Math.abs(dy * z - y * dz) <= ay * ez + ey * az + .0001F
+                && Math.abs(dz * x - dx * z) <= az * ex + ax * ez + .0001F
+                && Math.abs(dx * y - dy * x) <= ax * ey + ay * ex + .0001F;
+    }
+
+    public void clear() {
+        this.previous = null;
+        this.next = null;
+        this.direction = null;
+        this.succeeded = false;
+    }
+}
