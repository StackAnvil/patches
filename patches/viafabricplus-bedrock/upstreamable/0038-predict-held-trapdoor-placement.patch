+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.input;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockItemUse;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.client.gui.screens.Screen;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(Minecraft.class)
+public abstract class MixinItemUseControl {
+    @Shadow protected abstract void pick(float partialTick);
+    @Shadow protected abstract void startUseItem();
+    @Inject(method = "startUseItem", at = @At("HEAD"), cancellable = true)
+    private void beginItemUse(final CallbackInfo ci) {
+        if (!BedrockItemUse.begin()) {
+            ci.cancel();
+        }
+    }
+
+    @WrapOperation(method = "startUseItem", at = @At(value = "INVOKE",
+        target = "Lnet/minecraft/client/multiplayer/MultiPlayerGameMode;useItem(Lnet/minecraft/world/entity/player/Player;Lnet/minecraft/world/InteractionHand;)Lnet/minecraft/world/InteractionResult;"))
+    private InteractionResult admitFoodUse(final MultiPlayerGameMode gameMode, final Player player,
+                                          final InteractionHand hand, final Operation<InteractionResult> original) {
+        return BedrockItemUse.beginFoodUse(hand, player.getItemInHand(hand))
+            ? original.call(gameMode, player, hand) : InteractionResult.PASS;
+    }
+
+    @Inject(method = "startUseItem", at = @At("RETURN"))
+    private void retainNativeRepeatDelay(final CallbackInfo ci) {
+        BedrockItemUse.attempted();
+    }
+
+    @ModifyExpressionValue(method = "handleKeybinds", at = @At(value = "FIELD",
+        target = "Lnet/minecraft/client/Minecraft;rightClickDelay:I"))
+    private int repeatHeldUseFromFrames(final int original) {
+        return BedrockItemUse.repeatsFromFrames() ? 1 : original;
+    }
+
+    @Inject(method = "runTick", at = @At(value = "INVOKE",
+        target = "Lnet/minecraft/client/MouseHandler;handleAccumulatedMovement()V", shift = At.Shift.AFTER))
+    private void repeatAfterCameraInput(final boolean renderLevel, final CallbackInfo ci) {
+        BedrockItemUse.refresh();
+        final var player = ((Minecraft) (Object) this).player;
+        if (player != null && !player.isUsingItem() && BedrockItemUse.frameReady()) {
+            this.pick(1F);
+            this.startUseItem();
+        }
+    }
+
+    @Inject(method = "disconnect(Lnet/minecraft/client/gui/screens/Screen;ZZ)V", at = @At("HEAD"))
+    private void releaseBeforeDisconnect(final Screen screen, final boolean transferring, final boolean skipSaving, final CallbackInfo ci) {
+        BedrockItemUse.release();
+    }
+}
