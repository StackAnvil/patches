+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.PlayerBlockUse;
+
+public record BlockUsePayload(PlayerBlockUse use) implements CustomPacketPayload {
+    public static final Type<BlockUsePayload> TYPE = new Type<>(Identifier.parse(PlayerBlockUse.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, BlockUsePayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> PlayerBlockUse.TYPE.write(buffer, payload.use),
+        buffer -> new BlockUsePayload(PlayerBlockUse.TYPE.read(buffer)));
+
+    @Override
+    public Type<BlockUsePayload> type() {
+        return TYPE;
+    }
+}
