@@ -0,0 +1,53 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+/** Food's connection deadline and held placement's success delay have different lifetimes. */
+public final class ItemUseTiming {
+    private static final long FOOD_DELAY_NANOS = 200_000_000L;
+    private static final long BLOCK_DELAY_NANOS = 300_000_000L;
+    private boolean foodAttempted;
+    private long foodStartedAt;
+    private boolean blockActive;
+    private long blockStartedAt;
+
+    public boolean canAttempt(final long now) {
+        return !this.foodAttempted || now - this.foodStartedAt > FOOD_DELAY_NANOS;
+    }
+
+    public boolean tryFoodUse(final long now) {
+        if (!this.canAttempt(now)) {
+            return false;
+        }
+        this.foodAttempted = true;
+        this.foodStartedAt = now;
+        return true;
+    }
+
+    public void attemptedBlock(final long now, final boolean success) {
+        if (!this.blockActive || success) {
+            this.blockStartedAt = now;
+            this.blockActive = true;
+        }
+    }
+
+    public boolean blockActive() {
+        return this.blockActive;
+    }
+
+    public boolean frameReady(final long now, final boolean food) {
+        return this.canAttempt(now) && (food || this.blockActive && now - this.blockStartedAt >= BLOCK_DELAY_NANOS);
+    }
+
+    public void release() {
+        this.blockActive = false;
+    }
+
+    public void clear() {
+        this.release();
+        this.foodAttempted = false;
+    }
+}
