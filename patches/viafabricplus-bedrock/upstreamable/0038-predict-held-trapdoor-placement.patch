+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+
+final class BedrockItemUsePlacementTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        if (!Items.SHULKER_BOX.builtInRegistryHolder().areComponentsBound()) {
+            Items.SHULKER_BOX.builtInRegistryHolder().bindComponents(DataComponentMap.EMPTY);
+        }
+    }
+
+    @Test
+    void dispenserPlacementWithoutAnyPlayerIsIgnored() {
+        // The integrated server can tick a dispenser that places a shulker box before the client player exists.
+        final var level = mock(Level.class);
+        when(level.getBlockState(any())).thenReturn(Blocks.AIR.defaultBlockState());
+        final var context = new DirectionalPlaceContext(level, new BlockPos(0, 64, 0), Direction.DOWN,
+                new ItemStack(Items.SHULKER_BOX), Direction.UP);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(mock(Minecraft.class));
+            assertDoesNotThrow(() -> BedrockItemUse.placementAttempt(context, true));
+            assertDoesNotThrow(() -> BedrockItemUse.placementAttempt(context, false));
+        }
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/input/BedrockItemUseReleaseTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/input/BedrockItemUseReleaseTest.java
