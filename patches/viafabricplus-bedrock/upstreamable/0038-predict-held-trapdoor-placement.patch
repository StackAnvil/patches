+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import net.minecraft.core.Direction;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.TrapDoorBlock;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.Half;
+
+/** Placement orientation survives changes to the hit face and selected trapdoor material. */
+public final class TrapdoorPlacement {
+    private Direction facing;
+    private Half half;
+    private BlockPos support;
+    private Vec3 initialHit;
+
+    public boolean active() {
+        return this.facing != null;
+    }
+
+    public void remember(final BlockState state, final BlockPos support, final Vec3 hit) {
+        if (!this.active() && state.getBlock() instanceof TrapDoorBlock) {
+            this.facing = state.getValue(TrapDoorBlock.FACING);
+            this.half = state.getValue(TrapDoorBlock.HALF);
+            this.support = support.immutable();
+            this.initialHit = hit;
+        }
+    }
+
+    public boolean allows(final BlockPos target, final BlockState state) {
+        return !this.active() || state.getBlock() instanceof TrapDoorBlock || target.equals(this.support);
+    }
+
+    public BlockState apply(final BlockState state) {
+        return this.active() && state.getBlock() instanceof TrapDoorBlock
+            ? state.setValue(TrapDoorBlock.FACING, this.facing).setValue(TrapDoorBlock.HALF, this.half) : state;
+    }
+
+    // Native held snapping reuses the first world hit, even outside the current target cube.
+    public Vec3 clickPosition(final BlockPos target, final Vec3 hit) {
+        return (this.active() ? this.initialHit : hit).subtract(Vec3.atLowerCornerOf(target));
+    }
+
+    public void clear() {
+        this.facing = null;
+        this.half = null;
+        this.support = null;
+        this.initialHit = null;
+    }
+}
