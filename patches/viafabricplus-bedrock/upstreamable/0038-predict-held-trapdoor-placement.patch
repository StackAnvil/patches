+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+/** Native use waits after the first attempt or a success, then retries on each input frame. */
+public final class HeldBlockUseTiming {
+    private static final long USE_DELAY_NANOS = 300_000_000L;
+    private boolean active;
+    private long delayStartedAt;
+
+    public void attempted(final long now, final boolean success) {
+        if (!this.active || success) {
+            this.delayStartedAt = now;
+            this.active = true;
+        }
+    }
+
+    public boolean active() {
+        return this.active;
+    }
+
+    public boolean ready(final long now) {
+        return this.active && now - this.delayStartedAt >= USE_DELAY_NANOS;
+    }
+
+    public void clear() {
+        this.active = false;
+    }
+}
