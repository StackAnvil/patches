+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/inventory/TrapdoorPlacementTest.java
@@ -0,0 +1,100 @@
+package com.viaversion.viafabricplus.bedrock.inventory;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.core.Direction;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.TrapDoorBlock;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.level.block.state.properties.Half;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class TrapdoorPlacementTest {
+    @BeforeAll
+    static void initializeBlocks() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void preservesTheFirstFacingAndHalfAcrossMaterialsWithoutReplacingOtherProperties() {
+        final var placement = new TrapdoorPlacement();
+        placement.remember(Blocks.OAK_TRAPDOOR.defaultBlockState()
+            .setValue(TrapDoorBlock.FACING, Direction.SOUTH).setValue(TrapDoorBlock.HALF, Half.TOP), BlockPos.ZERO, Vec3.ZERO);
+        final var birch = Blocks.BIRCH_TRAPDOOR.defaultBlockState()
+            .setValue(TrapDoorBlock.FACING, Direction.WEST).setValue(TrapDoorBlock.HALF, Half.BOTTOM)
+            .setValue(TrapDoorBlock.WATERLOGGED, true).setValue(TrapDoorBlock.POWERED, true).setValue(TrapDoorBlock.OPEN, true);
+        placement.remember(birch, BlockPos.ZERO, Vec3.ZERO);
+        final var result = placement.apply(birch);
+        assertTrue(result.is(Blocks.BIRCH_TRAPDOOR));
+        assertEquals(Direction.SOUTH, result.getValue(TrapDoorBlock.FACING));
+        assertEquals(Half.TOP, result.getValue(TrapDoorBlock.HALF));
+        assertTrue(result.getValue(TrapDoorBlock.WATERLOGGED));
+        assertTrue(result.getValue(TrapDoorBlock.POWERED));
+        assertTrue(result.getValue(TrapDoorBlock.OPEN));
+    }
+
+    @Test
+    void releaseAllowsTheNextPlacementToChooseItsOwnOrientation() {
+        final var placement = new TrapdoorPlacement();
+        placement.remember(Blocks.OAK_TRAPDOOR.defaultBlockState(), BlockPos.ZERO, Vec3.ZERO);
+        placement.clear();
+        final var next = Blocks.BIRCH_TRAPDOOR.defaultBlockState()
+            .setValue(TrapDoorBlock.FACING, Direction.EAST).setValue(TrapDoorBlock.HALF, Half.TOP);
+        assertFalse(placement.active());
+        assertSame(next, placement.apply(next));
+        placement.remember(next, BlockPos.ZERO, Vec3.ZERO);
+        assertEquals(Direction.EAST, placement.apply(Blocks.OAK_TRAPDOOR.defaultBlockState()).getValue(TrapDoorBlock.FACING));
+    }
+
+    @Test
+    void ordinaryBlocksNeitherStartNorInheritTrapdoorOrientation() {
+        final var placement = new TrapdoorPlacement();
+        final var stone = Blocks.STONE.defaultBlockState();
+        placement.remember(stone, BlockPos.ZERO, Vec3.ZERO);
+        assertFalse(placement.active());
+        placement.remember(Blocks.OAK_TRAPDOOR.defaultBlockState(), BlockPos.ZERO, Vec3.ZERO);
+        assertSame(stone, placement.apply(stone));
+        placement.remember(stone, new BlockPos(5, 8, 9), new Vec3(5.5, 8.5, 9.5));
+        assertTrue(placement.active());
+        assertEquals(Vec3.ZERO, placement.clickPosition(BlockPos.ZERO, new Vec3(1, 2, 3)));
+    }
+    @Test
+    void continuationUsesTrapdoorsOrTheOriginalSupportUntilRelease() {
+        final var placement = new TrapdoorPlacement();
+        final var support = new BlockPos(2, 65, 4);
+        final var other = new BlockPos(5, 64, 8);
+        placement.remember(Blocks.OAK_TRAPDOOR.defaultBlockState(), support, Vec3.atLowerCornerOf(support));
+        assertTrue(placement.allows(support, Blocks.STONE.defaultBlockState()));
+        assertTrue(placement.allows(other, Blocks.BIRCH_TRAPDOOR.defaultBlockState()));
+        assertFalse(placement.allows(other, Blocks.STONE.defaultBlockState()));
+        assertFalse(placement.allows(other, Blocks.CHEST.defaultBlockState()));
+        placement.clear();
+        assertTrue(placement.allows(other, Blocks.CHEST.defaultBlockState()));
+    }
+
+    @Test
+    void continuationKeepsTheInitialWorldHitEvenOutsideTheNewTargetsCube() {
+        final var placement = new TrapdoorPlacement();
+        final var support = new BlockPos(2, 65, 4);
+        final var firstHit = new Vec3(2.5, 65.625, 4);
+        final var nextTarget = new BlockPos(2, 65, 3);
+        final var laterHit = new Vec3(2.25, 65.8125, 3.5);
+        assertEquals(new Vec3(0.25, 0.8125, 0.5), placement.clickPosition(nextTarget, laterHit));
+        placement.remember(Blocks.OAK_TRAPDOOR.defaultBlockState(), support, firstHit);
+        assertEquals(new Vec3(0.5, 0.625, 1), placement.clickPosition(nextTarget, laterHit));
+        placement.remember(Blocks.BIRCH_TRAPDOOR.defaultBlockState(), nextTarget, laterHit);
+        assertEquals(new Vec3(2.5, 0.625, 1), placement.clickPosition(new BlockPos(0, 65, 3), laterHit));
+        placement.clear();
+        final var released = placement.clickPosition(nextTarget, laterHit);
+        assertEquals(0.25, released.x);
+        assertEquals(0.8125, released.y);
+        assertEquals(0.5, released.z);
+    }
+
+
+}
