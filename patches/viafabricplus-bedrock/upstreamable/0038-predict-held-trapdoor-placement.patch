@@ -0,0 +1,72 @@
+package com.viaversion.viafabricplus.bedrock.input;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ItemUseTimingTest {
+    @Test
+    void releasedFoodKeepsItsDeadlineForFreshClicksUntilConnectionReplacement() {
+        final var timing = new ItemUseTiming();
+        assertTrue(timing.tryFoodUse(1_000_000_000L));
+        timing.release();
+        assertFalse(timing.tryFoodUse(1_131_000_000L));
+        assertFalse(timing.tryFoodUse(1_200_000_000L));
+        assertTrue(timing.tryFoodUse(1_616_000_000L));
+        assertFalse(timing.canAttempt(1_700_000_000L));
+        timing.clear();
+        assertTrue(timing.tryFoodUse(1_700_000_000L));
+    }
+
+    @Test
+    void heldFoodUsesTheFirstEligibleInputFrameInsteadOfARepeatedTickCount() {
+        final var timing = new ItemUseTiming();
+        final List<Integer> usedAt = new ArrayList<>();
+        for (final int milliseconds : new int[] {0, 47, 94, 141, 188, 236, 284, 332, 380, 428, 475, 542, 609, 676}) {
+            final long now = 1_000_000_000L + milliseconds * 1_000_000L;
+            if (timing.frameReady(now, true) && timing.tryFoodUse(now)) {
+                usedAt.add(milliseconds);
+            }
+        }
+        assertEquals(List.of(0, 236, 475, 676), usedAt);
+    }
+
+    @Test
+    void foodAndPlacementKeepIndependentDelaysAcrossHeldItemChanges() {
+        final var timing = new ItemUseTiming();
+        assertFalse(timing.frameReady(1_000_000_000L, false));
+        timing.attemptedBlock(1_000_000_000L, false);
+        assertTrue(timing.frameReady(1_100_000_000L, true));
+        assertTrue(timing.tryFoodUse(1_100_000_000L));
+        assertFalse(timing.frameReady(1_300_000_000L, false));
+        assertTrue(timing.frameReady(1_301_000_000L, false));
+        timing.attemptedBlock(1_310_000_000L, false);
+        assertTrue(timing.frameReady(1_311_000_000L, false));
+        timing.attemptedBlock(1_320_000_000L, true);
+        assertTrue(timing.tryFoodUse(1_400_000_000L));
+        assertFalse(timing.frameReady(1_600_000_000L, true));
+        assertTrue(timing.frameReady(1_600_000_001L, true));
+        assertFalse(timing.frameReady(1_619_999_999L, false));
+        assertTrue(timing.frameReady(1_620_000_000L, false));
+        assertTrue(timing.tryFoodUse(1_630_000_000L));
+        timing.release();
+        assertFalse(timing.frameReady(1_700_000_000L, true));
+        assertTrue(timing.frameReady(1_830_000_001L, true));
+        assertFalse(timing.frameReady(1_900_000_000L, false));
+    }
+
+    @Test
+    void monotonicClockRolloverKeepsBothDeadlines() {
+        final var timing = new ItemUseTiming();
+        final long start = Long.MAX_VALUE - 150_000_000L;
+        timing.attemptedBlock(start, true);
+        assertTrue(timing.tryFoodUse(start));
+        assertFalse(timing.frameReady(start + 200_000_000L, true));
+        assertTrue(timing.frameReady(start + 200_000_001L, true));
+        assertFalse(timing.frameReady(start + 299_999_999L, false));
+        assertTrue(timing.frameReady(start + 300_000_000L, false));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/inventory/TrapdoorPlacementTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/inventory/TrapdoorPlacementTest.java
