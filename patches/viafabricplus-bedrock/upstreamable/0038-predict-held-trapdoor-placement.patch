diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/input/ItemUseState.java b/src/main/java/com/viaversion/viafabricplus/bedrock/input/ItemUseState.java
new file mode 100644
index 0000000000000000000000000000000000000000..e8c153bc0efb259d065a1bfd52089e9163cac762
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/input/ItemUseState.java
@@ -0,0 +1,196 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.phys.HitResult;
+
+/** A physical hold retains its air or placement route until release. */
+public final class ItemUseState {
+    private static final long AIR_DELAY_NANOS = 200_000_000L;
+    private static final float BLOCK_DELAY_MILLIS = 300F;
+    private static final float LINE_DELAY_MILLIS = 200F;
+    private static final float MOVING_DELAY_MILLIS = 900F;
+    private static final float MAX_MOVING_DELAY_MILLIS = 180F;
+    private static final float MIN_DELAY_MILLIS = 100F;
+    private static final long MOVING_ANCHOR_NANOS = 180_000_000L;
+    private int releaseSlot = -1;
+    private String releaseDefinition;
+    private boolean airActive;
+    private boolean airAttempted;
+    private long airStartedAt;
+    private boolean blockActive;
+    private long blockStartedAt;
+    private boolean blockDelayed;
+    private long blockDelay = (long) BLOCK_DELAY_MILLIS * 1_000_000L;
+    private boolean moving;
+    private boolean heldRepeat;
+
+    public boolean canAttempt(final long now) {
+        return !this.airAttempted || now - this.airStartedAt > AIR_DELAY_NANOS;
+    }
+
+    public boolean admitAirUse(final long now, final InteractionHand hand) {
+        if (hand != InteractionHand.MAIN_HAND) {
+            return !this.airActive && !this.blockActive;
+        }
+        if (this.blockActive) {
+            return false;
+        }
+        if (!this.canAttempt(now)) {
+            if (!this.airActive) {
+                this.blockActive = true;
+            }
+            return false;
+        }
+        this.recordAirUse(now);
+        return true;
+    }
+
+    public void airResult(final boolean activeUse, final boolean retainedItem, final boolean retainsAirUse) {
+        if (!this.airActive) {
+            this.airActive = activeUse || retainedItem && retainsAirUse;
+            this.blockActive = !this.airActive;
+        }
+    }
+
+    /** Older proxy cores do not provide native item predicates. Preserve their prior route selection. */
+    public boolean admitLegacyAirUse(final long now, final InteractionHand hand, final boolean food, final boolean blockItem, final boolean canConsume) {
+        if (hand != InteractionHand.MAIN_HAND) {
+            return !this.airActive && !this.blockActive;
+        }
+        if (this.blockActive) {
+            return false;
+        }
+        if (!this.canAttempt(now)) {
+            if (!this.airActive && (food || blockItem)) {
+                this.blockActive = true;
+            }
+            return false;
+        }
+        if (!this.airActive && !food && !blockItem) {
+            return true;
+        }
+        if (this.airActive || food && canConsume) {
+            this.airActive = true;
+        } else {
+            this.blockActive = true;
+        }
+        this.recordAirUse(now);
+        return true;
+    }
+
+    public boolean placedBlock(final long now, final boolean hasRemainder) {
+        if (!this.airActive && !this.blockActive && hasRemainder && this.canAttempt(now)) {
+            this.recordAirUse(now);
+            return true;
+        }
+        return false;
+    }
+
+    private void recordAirUse(final long now) {
+        this.airAttempted = true;
+        this.airStartedAt = now;
+    }
+
+    /** Native sends one actor interaction per press; a held button never repeats it. */
+    public void beginAttempt(final boolean freshPress) {
+        this.heldRepeat = !freshPress;
+    }
+
+    public HitResult.Type hitType(final long now, final HitResult.Type target, final InteractionHand hand) {
+        if (target == HitResult.Type.ENTITY && this.heldRepeat) {
+            return HitResult.Type.MISS;
+        }
+        if (!this.blockActive && target == HitResult.Type.ENTITY && !this.canAttempt(now)) {
+            return HitResult.Type.MISS;
+        }
+        return this.airActive || this.blockActive && hand != InteractionHand.MAIN_HAND ? HitResult.Type.MISS : target;
+    }
+
+    public void retainBlockUse() {
+        if (!this.airActive) {
+            this.blockActive = true;
+        }
+    }
+
+    /** A repeat records its attempt on success or outside the build height; other failures keep the deadline. */
+    public void attemptedBlock(final long now, final boolean recorded) {
+        if (!this.airActive && (!this.blockActive || recorded)) {
+            long recordedAt = now;
+            if (this.blockActive && this.blockDelayed && this.moving) {
+                // A moving repeat keeps its previous deadline, falling at most 180 ms behind the clock.
+                final long deadline = this.blockStartedAt + this.blockDelay;
+                recordedAt = deadline - (now - MOVING_ANCHOR_NANOS) > 0 ? deadline : now - MOVING_ANCHOR_NANOS;
+            }
+            this.blockStartedAt = recordedAt;
+            this.blockDelayed = true;
+            this.blockActive = true;
+        }
+    }
+
+    public boolean blockActive() {
+        return this.blockActive;
+    }
+
+    public boolean repeatsFromFrames() {
+        return this.airActive || this.blockActive;
+    }
+
+    /**
+     * Native continueBuildBlock derives each repeat delay from sneaking, the build line and post-tick speed.
+     * Sneaking keeps 300 ms. A moving line waits 900 ms divided by its speed in blocks per second, at most 180 ms.
+     * Only Creative skips the 100 ms floor.
+     */
+    public void pace(final boolean placementLine, final boolean sneaking, final float speedSquared, final boolean creative) {
+        float delay = sneaking || !placementLine ? BLOCK_DELAY_MILLIS : LINE_DELAY_MILLIS;
+        if (!sneaking && placementLine && speedSquared > 0F) {
+            delay = Math.min(MOVING_DELAY_MILLIS / (float) Math.sqrt(speedSquared), MAX_MOVING_DELAY_MILLIS);
+        }
+        if (!creative) {
+            delay = Math.max(MIN_DELAY_MILLIS, delay);
+        }
+        this.blockDelay = (int) delay * 1_000_000L;
+        this.moving = speedSquared > 0F;
+    }
+
+    public boolean frameReady(final long now) {
+        return this.blockActive
+            ? !this.blockDelayed || now - this.blockStartedAt > this.blockDelay
+            : this.canAttempt(now) && this.airActive;
+    }
+
+    public void cancelPlacement() {
+        this.blockActive = false;
+        this.blockDelayed = false;
+    }
+
+    /** A native shooter can remain active even when its Java carrier has no use cycle. */
+    public void armRelease(final int slot, final String definition) {
+        this.releaseSlot = slot;
+        this.releaseDefinition = definition;
+    }
+
+    public boolean takeRelease(final int slot, final String definition) {
+        final boolean matches = this.releaseDefinition != null && this.releaseSlot == slot
+            && this.releaseDefinition.equals(definition);
+        this.releaseSlot = -1;
+        this.releaseDefinition = null;
+        return matches;
+    }
+
+    public void release() {
+        this.airActive = false;
+        this.cancelPlacement();
+    }
+
+    public void clear() {
+        this.release();
+        this.airAttempted = false;
+        this.releaseSlot = -1;
+        this.releaseDefinition = null;
+    }
+}
