diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/input/BlockPlacementPathTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/input/BlockPlacementPathTest.java
new file mode 100644
index 0000000..e4fe3f2
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/input/BlockPlacementPathTest.java
@@ -0,0 +1,128 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BlockPlacementPathTest {
+    private static final Vec3 EYE = new Vec3(.5F, -58.37998962402344F, -3.5F);
+
+    @Test
+    void rejectsTheNewTopFaceUntilTheRayCrossesTheRetainedNextCell() {
+        final var path = northPath();
+        final var top = new BlockHitResult(new Vec3(.5001634359359741F, -59F, -1.7961400747299194F),
+                Direction.UP, new BlockPos(0, -60, -2), false);
+        assertNull(path.select(EYE, top));
+
+        // Native re-aims onto the floor, but dispatches the retained north face of the last placed block.
+        final var floor = new BlockHitResult(new Vec3(.5001088380813599F, -60F, -2.365708589553833F),
+                Direction.UP, new BlockPos(0, -61, -3), false);
+        final var selected = path.select(EYE, floor);
+        assertNotNull(selected);
+        assertEquals(new BlockPos(0, -60, -2), selected.getBlockPos());
+        assertEquals(Direction.NORTH, selected.getDirection());
+        assertEquals(floor.getLocation(), selected.getLocation());
+        assertEquals(new BlockPos(0, -61, -3), floor.getBlockPos());
+    }
+
+    @Test
+    void successfulBuildsAdvanceTheCellWhileRejectedBuildsKeepRetryingIt() {
+        final var path = northPath();
+        path.attempted(new BlockPos(0, -60, -3), true, false);
+        final var hit = new BlockHitResult(new Vec3(.5000479817390442F, -59.09409713745117F, -3F),
+                Direction.NORTH, new BlockPos(0, -60, -3), false);
+        assertEquals(new BlockPos(0, -60, -3), path.select(EYE, hit).getBlockPos());
+        path.attempted(new BlockPos(0, -60, -4), false, false);
+        assertEquals(new BlockPos(0, -60, -3), path.select(EYE, hit).getBlockPos());
+        path.clear();
+        assertSame(hit, path.select(EYE, hit));
+    }
+
+    @Test
+    void aRejectedFirstBuildOrNonadjacentTargetsDoNotStartAPlacementLine() {
+        final var path = new BlockPlacementPath();
+        final var hit = new BlockHitResult(Vec3.ZERO, Direction.UP, BlockPos.ZERO, false);
+        path.attempted(BlockPos.ZERO, false, false);
+        path.attempted(new BlockPos(1, 0, 0), false, false);
+        assertSame(hit, path.select(EYE, hit));
+        path.attempted(new BlockPos(4, 0, 0), true, false);
+        path.attempted(new BlockPos(6, 0, 0), true, false);
+        assertSame(hit, path.select(EYE, hit));
+    }
+
+    @Test
+    void retainsTheAxisForUpwardDownwardAndHorizontalLines() {
+        for (final Direction direction : Direction.values()) {
+            final var path = new BlockPlacementPath();
+            path.attempted(BlockPos.ZERO, true, false);
+            path.attempted(BlockPos.ZERO.relative(direction), true, false);
+            final BlockPos next = BlockPos.ZERO.relative(direction, 2);
+            final var point = Vec3.atCenterOf(next);
+            final var hit = new BlockHitResult(point, Direction.UP, next, false);
+            final var selected = path.select(point, hit);
+            assertNotNull(selected, direction.name());
+            assertEquals(direction, selected.getDirection());
+            assertEquals(BlockPos.ZERO.relative(direction), selected.getBlockPos());
+        }
+    }
+
+    @Test
+    void anEstablishedLineUsesTheStrictShorterDelayAfterTheSecondBuild() {
+        final var path = new BlockPlacementPath();
+        final var input = new ItemUseState();
+        path.attempted(new BlockPos(0, -60, -1), true, false);
+        input.attemptedBlock(1_000_000_000L, true);
+        assertFalse(input.frameReady(1_300_000_000L, path.active()));
+        assertTrue(input.frameReady(1_300_000_001L, path.active()));
+        path.attempted(new BlockPos(0, -60, -2), true, false);
+        input.attemptedBlock(1_310_000_000L, true);
+        assertFalse(input.frameReady(1_510_000_000L, path.active()));
+        assertTrue(input.frameReady(1_510_000_001L, path.active()));
+    }
+
+    @Test
+    void largeCoordinateCellsRetainNativeFloatCollapseInsteadOfGainingAnExtraExtent() {
+        assertFalse(BlockPlacementPath.intersects(new BlockPos(16_777_217, 0, 0),
+                new Vec3(16_777_216, 2.1F, .5F), new Vec3(16_777_218, .1F, .5F)));
+    }
+
+    @Test
+    void aFailedDistantAttemptDoesNotReplaceTheLastSuccessfulBuildPosition() {
+        final var path = new BlockPlacementPath();
+        path.attempted(new BlockPos(0, -60, -1), true, false);
+        path.attempted(new BlockPos(2, -60, -1), false, false);
+        path.attempted(new BlockPos(0, -60, -2), true, false);
+        final var top = new BlockHitResult(new Vec3(.5001634359359741F, -59F, -1.7961400747299194F),
+                Direction.UP, new BlockPos(0, -60, -2), false);
+        assertNull(path.select(EYE, top));
+    }
+
+    @Test
+    void theUpperBuildLimitKeepsItsSeparateAttemptHistoryException() {
+        final var path = new BlockPlacementPath();
+        path.attempted(BlockPos.ZERO, true, false);
+        path.attempted(new BlockPos(3, 320, 0), false, true);
+        path.attempted(new BlockPos(3, 319, 0), true, false);
+        final Vec3 point = Vec3.atCenterOf(new BlockPos(3, 318, 0));
+        final var hit = new BlockHitResult(point, Direction.UP, new BlockPos(3, 318, 0), false);
+        final var selected = path.select(point, hit);
+        assertEquals(Direction.DOWN, selected.getDirection());
+        assertEquals(new BlockPos(3, 319, 0), selected.getBlockPos());
+    }
+
+    private static BlockPlacementPath northPath() {
+        final var path = new BlockPlacementPath();
+        path.attempted(new BlockPos(0, -60, -1), true, false);
+        path.attempted(new BlockPos(0, -60, -2), true, false);
+        return path;
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/input/ItemUseStateTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/input/ItemUseStateTest.java
new file mode 100644
index 0000000..00f79ed
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/input/ItemUseStateTest.java
@@ -0,0 +1,286 @@
+package com.viaversion.viafabricplus.bedrock.input;
+
+import org.junit.jupiter.api.Test;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.phys.HitResult;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ItemUseStateTest {
+    @Test
+    void admittedProjectileOwnsTheDeadlineAndAirRouteEvenWithoutAnActiveUseCycle() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        input.airResult(false, true, true);
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertFalse(input.frameReady(1_200_000_000L, false));
+        assertTrue(input.frameReady(1_200_000_001L, false));
+        input.release();
+        assertFalse(input.admitAirUse(1_100_000_000L, InteractionHand.MAIN_HAND));
+    }
+
+    @Test
+    void rejectedFreshProjectileHoldDoesNotResumeAirUseAfterTheDeadline() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        input.airResult(false, true, true);
+        input.release();
+        assertFalse(input.admitAirUse(1_100_000_000L, InteractionHand.MAIN_HAND));
+        assertEquals(HitResult.Type.BLOCK, input.hitType(1_300_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertTrue(input.frameReady(1_300_000_000L, false));
+        assertFalse(input.admitAirUse(1_300_000_000L, InteractionHand.MAIN_HAND));
+        input.release();
+        assertTrue(input.admitAirUse(1_300_000_001L, InteractionHand.MAIN_HAND));
+        input.airResult(false, true, true);
+        assertEquals(HitResult.Type.MISS, input.hitType(1_600_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+    }
+
+    @Test
+    void projectileHoldKeepsAirRoutingAfterSwitchingToAnOrdinaryBlock() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        input.airResult(false, true, true);
+        assertTrue(input.admitAirUse(1_250_000_000L, InteractionHand.MAIN_HAND));
+        input.airResult(false, true, false);
+        assertFalse(input.blockActive());
+        assertFalse(input.admitAirUse(1_250_000_001L, InteractionHand.OFF_HAND));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_600_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+    }
+
+    @Test
+    void activeUseCanRetainAirWithoutAThrowablePredicateButAnOrdinaryResultCannot() {
+        final var active = new ItemUseState();
+        assertTrue(active.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        active.airResult(true, true, false);
+        assertEquals(HitResult.Type.MISS, active.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        final var ordinary = new ItemUseState();
+        assertTrue(ordinary.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        ordinary.airResult(false, true, false);
+        assertEquals(HitResult.Type.BLOCK, ordinary.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertFalse(ordinary.admitAirUse(1_500_000_000L, InteractionHand.MAIN_HAND));
+    }
+
+    @Test
+    void aMissingRetainedStackDoesNotAcquireAirFromItsItemPredicate() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitAirUse(1_000_000_000L, InteractionHand.MAIN_HAND));
+        input.airResult(false, false, true);
+        assertTrue(input.blockActive());
+        input.release();
+        assertFalse(input.admitAirUse(1_200_000_000L, InteractionHand.MAIN_HAND));
+        input.clear();
+        assertTrue(input.admitAirUse(1_200_000_000L, InteractionHand.MAIN_HAND));
+    }
+
+    @Test
+    void releasedFoodKeepsItsDeadlineForFreshClicksUntilConnectionReplacement() {
+        final var timing = new ItemUseState();
+        assertTrue(timing.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        timing.release();
+        assertFalse(timing.admitLegacyAirUse(1_131_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        timing.release();
+        assertFalse(timing.admitLegacyAirUse(1_200_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        timing.release();
+        assertTrue(timing.admitLegacyAirUse(1_616_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        assertFalse(timing.canAttempt(1_700_000_000L));
+        timing.clear();
+        assertTrue(timing.admitLegacyAirUse(1_700_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void heldFoodUsesTheFirstEligibleInputFrameInsteadOfARepeatedTickCount() {
+        final var timing = new ItemUseState();
+        final List<Integer> usedAt = new ArrayList<>();
+        assertFalse(timing.frameReady(1_000_000_000L, false));
+        assertTrue(timing.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        usedAt.add(0);
+        for (final int milliseconds : new int[] {47, 94, 141, 188, 236, 284, 332, 380, 428, 475, 542, 609, 676}) {
+            final long now = 1_000_000_000L + milliseconds * 1_000_000L;
+            if (timing.frameReady(now, false) && timing.admitLegacyAirUse(now, InteractionHand.MAIN_HAND, true, false, true)) {
+                usedAt.add(milliseconds);
+            }
+        }
+        assertEquals(List.of(0, 236, 475, 676), usedAt);
+    }
+
+    @Test
+    void foodHoldKeepsAirUseAcrossBlockAndEntityTargetsUntilRelease() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.ENTITY, InteractionHand.MAIN_HAND));
+        input.attemptedBlock(1_100_000_000L, true);
+        assertFalse(input.frameReady(1_200_000_000L, false));
+        assertTrue(input.frameReady(1_200_000_001L, false));
+        assertTrue(input.admitLegacyAirUse(1_200_000_001L, InteractionHand.MAIN_HAND, false, false, true));
+        assertFalse(input.admitLegacyAirUse(1_300_000_000L, InteractionHand.OFF_HAND, false, false, true));
+        input.cancelPlacement();
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        input.release();
+        assertEquals(HitResult.Type.BLOCK, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertFalse(input.canAttempt(1_400_000_001L));
+        assertTrue(input.canAttempt(1_400_000_002L));
+    }
+
+    @Test
+    void placementHoldDoesNotStartEatingWhenTheSelectedItemChanges() {
+        final var input = new ItemUseState();
+        input.attemptedBlock(1_000_000_000L, true);
+        assertFalse(input.frameReady(1_200_000_001L, false));
+        assertFalse(input.frameReady(1_300_000_000L, false));
+        assertTrue(input.frameReady(1_300_000_001L, false));
+        assertEquals(HitResult.Type.BLOCK, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.OFF_HAND));
+        assertFalse(input.admitLegacyAirUse(1_300_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.attemptedBlock(1_310_000_000L, false);
+        assertTrue(input.frameReady(1_311_000_000L, false));
+        input.attemptedBlock(1_320_000_000L, true);
+        assertFalse(input.frameReady(1_619_999_999L, false));
+        assertFalse(input.frameReady(1_620_000_000L, false));
+        assertTrue(input.frameReady(1_620_000_001L, false));
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_630_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        assertFalse(input.canAttempt(1_800_000_000L));
+        input.clear();
+        assertEquals(HitResult.Type.ENTITY, input.hitType(1_500_000_000L, HitResult.Type.ENTITY, InteractionHand.MAIN_HAND));
+        assertTrue(input.admitLegacyAirUse(1_800_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void initiallyRefusedFoodKeepsUntimedBlockRepeatsWhileFreshCallsKeepTheAirDeadline() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, false));
+        input.attemptedBlock(1_010_000_000L, false);
+        assertEquals(HitResult.Type.BLOCK, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertTrue(input.frameReady(1_052_000_000L, false));
+        assertFalse(input.admitLegacyAirUse(1_052_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.attemptedBlock(1_105_000_000L, true);
+        assertFalse(input.frameReady(1_404_999_999L, false));
+        assertFalse(input.frameReady(1_405_000_000L, false));
+        assertTrue(input.frameReady(1_405_000_001L, false));
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_500_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void foodThatBecomesRefusedDuringAnAirHoldRetainsItsAirRouteAndDeadline() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        assertTrue(input.admitLegacyAirUse(1_201_000_000L, InteractionHand.MAIN_HAND, true, false, false));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertFalse(input.frameReady(1_401_000_000L, false));
+        assertTrue(input.frameReady(1_401_000_001L, false));
+    }
+
+    @Test
+    void rejectedBlockStartsUntimedFrameContinuationAndOnlyOneAirUse() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, false, true, false));
+        input.attemptedBlock(1_001_000_000L, false);
+        assertTrue(input.blockActive());
+        assertTrue(input.frameReady(1_016_000_000L, false));
+        assertFalse(input.admitLegacyAirUse(1_016_000_000L, InteractionHand.MAIN_HAND, false, true, false));
+        assertFalse(input.admitLegacyAirUse(1_016_000_000L, InteractionHand.OFF_HAND, true, false, true));
+        input.attemptedBlock(1_080_000_000L, false);
+        assertTrue(input.frameReady(1_096_000_000L, false));
+        input.attemptedBlock(1_100_000_000L, true);
+        assertFalse(input.frameReady(1_400_000_000L, false));
+        assertTrue(input.frameReady(1_400_000_001L, false));
+    }
+
+    @Test
+    void successfulFirstPlacementSharesItsAirDeadlineButHeldPlacementDoesNotRestartIt() {
+        final var input = new ItemUseState();
+        assertTrue(input.placedBlock(1_000_000_000L, true));
+        input.attemptedBlock(1_001_000_000L, true);
+        assertFalse(input.placedBlock(1_350_000_000L, true));
+        input.attemptedBlock(1_351_000_000L, true);
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_400_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void placingTheLastBlockDoesNotCreateAnAirDeadline() {
+        final var input = new ItemUseState();
+        assertFalse(input.placedBlock(1_000_000_000L, false));
+        input.attemptedBlock(1_001_000_000L, true);
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_050_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void freshSuccessfulBlockBeforeTheAirDeadlineDoesNotRefreshOrAdmitThatAirPhase() {
+        final var input = new ItemUseState();
+        assertTrue(input.placedBlock(1_000_000_000L, true));
+        input.attemptedBlock(1_001_000_000L, true);
+        input.release();
+        assertFalse(input.placedBlock(1_172_000_000L, true));
+        input.attemptedBlock(1_173_000_000L, true);
+        assertFalse(input.frameReady(1_200_000_000L, false));
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_201_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void freshAirSuppressionRetainsUntimedBlockContinuationUntilRelease() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.release();
+        assertFalse(input.admitLegacyAirUse(1_172_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        assertTrue(input.frameReady(1_173_000_000L, false));
+        assertFalse(input.admitLegacyAirUse(1_201_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.attemptedBlock(1_202_000_000L, false);
+        assertTrue(input.frameReady(1_203_000_000L, false));
+        input.release();
+        assertTrue(input.admitLegacyAirUse(1_204_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void emptyHandContinuationUsesFramesWithoutTakingAnExistingAirHold() {
+        final var input = new ItemUseState();
+        input.retainBlockUse();
+        input.attemptedBlock(1_000_000_000L, false);
+        assertTrue(input.frameReady(1_001_000_000L, false));
+        assertFalse(input.admitLegacyAirUse(1_002_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.release();
+        assertFalse(input.frameReady(1_003_000_000L, false));
+        assertTrue(input.admitLegacyAirUse(1_010_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.retainBlockUse();
+        assertEquals(HitResult.Type.MISS, input.hitType(1_500_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertFalse(input.frameReady(1_210_000_000L, false));
+        assertTrue(input.frameReady(1_210_000_001L, false));
+    }
+
+    @Test
+    void freshBlockDispatchDoesNotBypassTheExistingEntityAndAirDeadline() {
+        final var input = new ItemUseState();
+        assertTrue(input.admitLegacyAirUse(1_000_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.release();
+        assertEquals(HitResult.Type.BLOCK, input.hitType(1_172_000_000L, HitResult.Type.BLOCK, InteractionHand.MAIN_HAND));
+        assertEquals(HitResult.Type.MISS, input.hitType(1_172_000_000L, HitResult.Type.ENTITY, InteractionHand.MAIN_HAND));
+        assertFalse(input.admitLegacyAirUse(1_172_000_000L, InteractionHand.MAIN_HAND, true, false, true));
+        input.release();
+        assertEquals(HitResult.Type.MISS, input.hitType(1_200_000_000L, HitResult.Type.ENTITY, InteractionHand.MAIN_HAND));
+        assertEquals(HitResult.Type.ENTITY, input.hitType(1_200_000_001L, HitResult.Type.ENTITY, InteractionHand.MAIN_HAND));
+        assertTrue(input.admitLegacyAirUse(1_200_000_001L, InteractionHand.MAIN_HAND, true, false, true));
+    }
+
+    @Test
+    void monotonicClockRolloverKeepsBothDeadlines() {
+        final var timing = new ItemUseState();
+        final long start = Long.MAX_VALUE - 150_000_000L;
+        timing.attemptedBlock(start, true);
+        timing.release();
+        assertTrue(timing.admitLegacyAirUse(start, InteractionHand.MAIN_HAND, true, false, true));
+        assertFalse(timing.frameReady(start + 200_000_000L, false));
+        assertTrue(timing.frameReady(start + 200_000_001L, false));
+        timing.release();
+        timing.attemptedBlock(start, true);
+        assertFalse(timing.frameReady(start + 299_999_999L, false));
+        assertFalse(timing.frameReady(start + 300_000_000L, false));
+        assertTrue(timing.frameReady(start + 300_000_001L, false));
+    }
+}
