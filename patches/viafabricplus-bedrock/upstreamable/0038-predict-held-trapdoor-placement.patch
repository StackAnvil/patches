+package com.viaversion.viafabricplus.bedrock.input;
+
+import com.viaversion.viafabricplus.bedrock.inventory.TrapdoorPlacement;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.api.model.PlayerBlockUse;
+
+public final class BedrockBlockUse {
+    private static final TrapdoorPlacement PLACEMENT = new TrapdoorPlacement();
+    private static boolean held;
+    private static boolean placedBlock;
+    private static Position3f cursor;
+    private static BlockUsePrediction.Result predictedResult = BlockUsePrediction.Result.FAILED;
+
+    private BedrockBlockUse() {}
+
+    public static void register() {
+        PayloadTypeRegistry.serverboundPlay().register(BlockUsePayload.TYPE, BlockUsePayload.CODEC);
+        PayloadTypeRegistry.serverboundPlay().register(BlockUsePredictionPayload.TYPE, BlockUsePredictionPayload.CODEC);
+        ClientTickEvents.START_CLIENT_TICK.register(client -> update(
+            client.player != null && client.gui.screen() == null && client.gui.overlay() == null
+                && !client.player.isSpectator() && client.options.keyUse.isDown()));
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> reset());
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> reset());
+    }
+
+    public static void begin() {
+        update(true);
+    }
+
+    public static void release() {
+        update(false);
+    }
+
+    private static void update(final boolean value) {
+        if (!BedrockInputPermissions.isBedrockConnection() || Minecraft.getInstance().getConnection() == null
+                || !ClientPlayNetworking.canSend(BlockUsePayload.TYPE)
+                || !ClientPlayNetworking.canSend(BlockUsePredictionPayload.TYPE)) {
+            reset();
+            return;
+        }
+        if (held != value) {
+            held = value;
+            ClientPlayNetworking.send(new BlockUsePayload(new PlayerBlockUse(value)));
+        }
+        if (!value) {
+            PLACEMENT.clear();
+        }
+    }
+
+    public static boolean suppressInteraction() {
+        return held && PLACEMENT.active();
+    }
+
+    public static boolean allows(final BlockPos target, final BlockState state) {
+        return !held || PLACEMENT.allows(target, state);
+    }
+
+    public static void placed(final BlockState state, final BlockPos support, final Vec3 hit) {
+        placedBlock = true;
+        if (held) {
+            PLACEMENT.remember(state, support, hit);
+        }
+    }
+
+    public static void beginPrediction(final BlockHitResult hit) {
+        clearPrediction();
+        final Vec3 relative = held ? PLACEMENT.clickPosition(hit.getBlockPos(), hit.getLocation())
+            : hit.getLocation().subtract(Vec3.atLowerCornerOf(hit.getBlockPos()));
+        cursor = new Position3f((float) relative.x, (float) relative.y, (float) relative.z);
+    }
+
+    private static void clearPrediction() {
+        cursor = null;
+        placedBlock = false;
+        predictedResult = BlockUsePrediction.Result.FAILED;
+    }
+
+    public static void predicted(final boolean success) {
+        predictedResult = !success ? BlockUsePrediction.Result.FAILED
+            : placedBlock ? BlockUsePrediction.Result.PLACED : BlockUsePrediction.Result.INTERACTED;
+    }
+
+    public static void sendPrediction(final int sequence) {
+        if (cursor != null && BedrockInputPermissions.isBedrockConnection() && Minecraft.getInstance().getConnection() != null
+                && ClientPlayNetworking.canSend(BlockUsePredictionPayload.TYPE)) {
+            ClientPlayNetworking.send(new BlockUsePredictionPayload(new BlockUsePrediction(sequence, predictedResult, cursor)));
+        }
+        clearPrediction();
+    }
+
+    public static BlockState placement(final BlockState state) {
+        return held ? PLACEMENT.apply(state) : state;
+    }
+
+    private static void reset() {
+        held = false;
+        clearPrediction();
+        PLACEMENT.clear();
+    }
+}
