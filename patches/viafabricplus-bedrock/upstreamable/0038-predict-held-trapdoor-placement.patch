+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.BlockUsePrediction;
+
+public record BlockUsePredictionPayload(BlockUsePrediction use) implements CustomPacketPayload {
+    public static final Type<BlockUsePredictionPayload> TYPE = new Type<>(Identifier.parse(BlockUsePrediction.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, BlockUsePredictionPayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> BlockUsePrediction.TYPE.write(buffer, payload.use),
+        buffer -> new BlockUsePredictionPayload(BlockUsePrediction.TYPE.read(buffer)));
+
+    @Override
+    public Type<BlockUsePredictionPayload> type() {
+        return TYPE;
+    }
+}
