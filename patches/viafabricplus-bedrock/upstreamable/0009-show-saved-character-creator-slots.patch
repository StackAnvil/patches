+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+final class BedrockParticleEffectTest {
+    @Test
+    void decodesTheSameParticlePixelsFromPngAndTga() throws Exception {
+        final var image = new java.awt.image.BufferedImage(3, 2, java.awt.image.BufferedImage.TYPE_INT_ARGB);
+        final byte[] tga = new byte[18 + 3 * 2 * 4];
+        tga[2] = 2; tga[12] = 3; tga[14] = 2; tga[16] = 32; tga[17] = 0x28;
+        final var pixels = java.nio.ByteBuffer.wrap(tga).order(java.nio.ByteOrder.LITTLE_ENDIAN);
+        pixels.position(18);
+        for (int y = 0; y < 2; y++) for (int x = 0; x < 3; x++) {
+            final int color = (127 + y * 127) << 24 | x * 100 << 16 | y * 120 << 8 | 99;
+            image.setRGB(x, y, color); pixels.putInt(color);
+        }
+        final var png = new java.io.ByteArrayOutputStream();
+        javax.imageio.ImageIO.write(image, "png", png);
+        for (final byte[] bytes : List.of(tga, png.toByteArray())) {
+            final var decoded = BedrockParticleTexture.read(bytes);
+            assertEquals(image.getWidth(), decoded.getWidth());
+            assertEquals(image.getHeight(), decoded.getHeight());
+            for (int y = 0; y < 2; y++) for (int x = 0; x < 3; x++) assertEquals(image.getRGB(x, y), decoded.getRGB(x, y));
+        }
+        assertThrows(IOException.class, () -> BedrockParticleTexture.read(java.util.Arrays.copyOf(tga, tga.length - 1)));
+    }
+
+    @Test
+    void isolatesParticleVariablesAndPreservesActorQueries() throws Exception {
+        final JsonObject document = burst();
+        final var components = components(document);
+        components.add("minecraft:particle_initialization", json("""
+                {"creation_expression":"v.phase=0;", "per_render_expression":"v.phase=v.phase+1;"}
+                """));
+        components.add("minecraft:particle_appearance_billboard", json("""
+                {"size":["v.phase+q.scale",0.25],"facing_camera_mode":"rotate_xyz"}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("phase", 9);
+        environment.queries(Map.of("scale", 2), 0, 0, 0);
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment.copy(), new Random(1), Vec3.ZERO);
+        emitter.advance(0, 10, null, (x, y, z) -> List.of());
+        final var first = emitter.visuals();
+        assertEquals(2, first.size());
+        assertEquals(3, first.get(0).width());
+        assertEquals(first.get(0).width(), first.get(1).width());
+        emitter.advance(50_000_000, 8, null, (x, y, z) -> List.of());
+        assertEquals(4, emitter.visuals().getFirst().width());
+        assertEquals(9, environment.evaluate(BedrockMolang.Program.parse(JsonParser.parseString("\"v.phase\""), 0), 0));
+    }
+
+    @Test
+    void retainsBirthOriginAndWaitsForFreeCapacityOnTheNextUpdate() throws Exception {
+        final var document = burst();
+        final var components = components(document);
+        components.remove("minecraft:emitter_rate_instant");
+        components.add("minecraft:emitter_rate_steady", json("{\"spawn_rate\":10,\"max_particles\":1}"));
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":0.1}"));
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(2), Vec3.ZERO);
+        final var first = new Vec3(1, 2, 3);
+        final var second = new Vec3(4, 5, 6);
+        emitter.advance(100_000_000, 1, new BedrockParticleAttachment(first, 180, null, null, java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(new Vector3f((float) first.x, (float) first.y, (float) first.z), emitter.visuals().getFirst().position());
+        emitter.advance(50_000_000, 0, new BedrockParticleAttachment(second, 180, null, null, java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(0, emitter.size());
+        emitter.advance(50_000_000, 1, new BedrockParticleAttachment(second, 180, null, null, java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(1, emitter.size());
+        assertEquals(new Vector3f((float) second.x, (float) second.y, (float) second.z), emitter.visuals().getFirst().position());
+        for (int index = 0; index < 3; index++)
+            emitter.advance(100_000_000, 0, new BedrockParticleAttachment(second, 180, null, null, java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(0, emitter.size());
+        assertFalse(emitter.alive());
+    }
+
+    @Test
+    void retainsNativeSteadyRateUntilTheNextEmission() throws Exception {
+        final var document = burst();
+        final var components = components(document);
+        components.remove("minecraft:emitter_rate_instant");
+        components.add("minecraft:emitter_rate_steady", json("{\"spawn_rate\":\"v.rate\",\"max_particles\":50}"));
+        components.add("minecraft:emitter_lifetime_once", json("{\"active_time\":10}"));
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":10}"));
+        final var environment = new BedrockMolang();
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(3), Vec3.ZERO);
+        final long[] deltas = {62_500_000,62_500_000,62_500_000,93_750_000,50_000_000};
+        final float[] rates = {8,1,16,16,2};
+        final int[] counts = {0,1,1,1,1};
+        for (int index = 0; index < deltas.length; index++) {
+            environment.variable("rate", rates[index]);
+            emitter.advance(deltas[index], 50, null, (x, y, z) -> List.of());
+            assertEquals(counts[index], emitter.size());
+        }
+    }
+
+    @Test
+    void rejectsComponentsThatNeedAnotherRuntime() throws Exception {
+        final var document = burst();
+        components(document).add("minecraft:emitter_rate_manual", new JsonObject());
+        assertThrows(IOException.class, () -> BedrockParticleEffect.read(document));
