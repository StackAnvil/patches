+
+// Releases assemble the helpers built on each OS into one resource directory.
+// Local builds embed the helper for the build host.
+val prebuiltPersonaHelpers = providers.environmentVariable("STACKANVIL_NATIVE_ASSETS")
+val nativeRoot = layout.projectDirectory.dir("native/persona-assets")
+val hostOs = System.getProperty("os.name").lowercase().let {
+    when { it.contains("win") -> "windows"; it.contains("mac") -> "macos"; else -> "linux" }
+}
+val hostArch = System.getProperty("os.arch").lowercase().let {
+    when (it) { "amd64", "x86_64" -> "x86_64"; "arm64", "aarch64" -> "aarch64"; else -> error("Unsupported package helper architecture: $it") }
+}
+val helperName = "persona-assets" + if (hostOs == "windows") ".exe" else ""
+val helperResources = layout.buildDirectory.dir("persona-helper-resources")
+val buildPersonaHelper by tasks.registering(Exec::class) {
+    onlyIf { !prebuiltPersonaHelpers.isPresent }
+    workingDir(nativeRoot)
+    commandLine("cargo", "+1.98.1", "build", "--release", "--locked")
+    inputs.files(nativeRoot.file("Cargo.toml"), nativeRoot.file("Cargo.lock"))
+    inputs.dir(nativeRoot.dir("src"))
+    outputs.file(nativeRoot.file("target/release/$helperName"))
+}
+val embedPersonaHelper by tasks.registering {
+    if (prebuiltPersonaHelpers.isPresent) {
+        inputs.dir(prebuiltPersonaHelpers)
+    } else {
+        dependsOn(buildPersonaHelper)
+        inputs.file(nativeRoot.file("target/release/$helperName"))
+    }
+    inputs.files(nativeRoot.file("LICENSE"), nativeRoot.file("NOTICE"))
+    outputs.dir(helperResources)
+    doLast {
+        val root = helperResources.get().asFile
+        root.deleteRecursively()
+        if (prebuiltPersonaHelpers.isPresent) {
+            copy { from(prebuiltPersonaHelpers); into(root.resolve("assets/viafabricplus-bedrock/native")) }
+        } else {
+            val source = nativeRoot.file("target/release/$helperName").asFile
+            val directory = root.resolve("assets/viafabricplus-bedrock/native/$hostOs-$hostArch")
+            directory.mkdirs()
+            source.copyTo(directory.resolve(helperName), overwrite = true)
+            val digest = MessageDigest.getInstance("SHA-256").digest(source.readBytes())
+            directory.resolve("$helperName.sha256").writeText(HexFormat.of().formatHex(digest) + "\n")
+        }
+        val notices = root.resolve("assets/viafabricplus-bedrock/native")
+        nativeRoot.file("LICENSE").asFile.copyTo(notices.resolve("LICENSE"), overwrite = true)
+        nativeRoot.file("NOTICE").asFile.copyTo(notices.resolve("NOTICE"), overwrite = true)
+    }
+}
+sourceSets.main { resources.srcDir(embedPersonaHelper) }
+tasks.processResources { dependsOn(embedPersonaHelper) }
