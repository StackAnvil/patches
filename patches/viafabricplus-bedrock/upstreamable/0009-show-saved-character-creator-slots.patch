+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import java.io.IOException;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+final class BedrockStoreTokensTest {
+    @Test
+    void preservesBothAudiencesWithoutChangingTheTokenResponse() throws IOException {
+        final JsonObject response = response();
+        final JsonObject original = response.deepCopy();
+        final String xbox = java.util.UUID.randomUUID().toString();
+        final JsonObject credentials = BedrockStoreTokens.credentials(response, xbox);
+        assertEquals(original, response);
+        assertEquals(response.get("access_token"), credentials.get("accessToken"));
+        assertEquals(response.get("user_id"), credentials.get("ticketReference"));
+        assertEquals(xbox, credentials.get("xboxTicket").getAsString());
+    }
+
+    @Test
+    void rejectsMissingIdentityAndTokensThatExceedTheProcessBudget() {
+        final JsonObject response = response();
+        response.remove("user_id");
+        assertThrows(IOException.class, () -> BedrockStoreTokens.credentials(response, "ticket"));
+        final JsonObject oversized = response();
+        oversized.addProperty("access_token", "x".repeat(8193));
+        assertThrows(IOException.class, () -> BedrockStoreTokens.credentials(oversized, "ticket"));
+        assertThrows(IOException.class, () -> BedrockStoreTokens.credentials(response(), "x".repeat(8193)));
+    }
+
+    private static JsonObject response() {
+        final JsonObject result = new JsonObject();
+        result.addProperty("access_token", java.util.UUID.randomUUID().toString());
+        result.addProperty("user_id", java.util.UUID.randomUUID().toString().replace("-", "").substring(0, 16));
+        return result;
+    }
+}
