+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockItemAnimation;
+import java.util.HashMap;
+import java.util.List;
+
+/** Supplies the native hand renderer's inputs to its independent actor graph. */
+final class BedrockFirstPersonInput {
+    private BedrockFirstPersonInput() {
+    }
+
+    static BedrockActorAnimation.Frame bind(final BedrockActorAnimation.Frame actor, final BedrockItemAnimation items,
+                                            final float oldMainHeight, final float mainHeight,
+                                            final float oldOffHeight, final float offHeight,
+                                            final float partialTick) {
+        final var queries = new HashMap<>(actor.queries());
+        // Hand rendering retains the previous stack while the equipped slot changes.
+        queries.putAll(items.queries());
+        final var variables = new HashMap<>(actor.variables());
+        final var context = new HashMap<>(actor.context());
+        // Native clears actor, head, and body rotations while rendering hands. Camera pitch remains a variable.
+        queries.put("target_x_rotation", 0F);
+        queries.put("target_y_rotation", 0F);
+        variables.put("player_arm_height", oldMainHeight + (mainHeight - oldMainHeight) * partialTick);
+        context.put("player_offhand_arm_height", oldOffHeight + (offHeight - oldOffHeight) * partialTick);
+        final var query = actor.queries().get("get_default_bone_pivot");
+        if (query instanceof BedrockActorAnimation.Query pivot) {
+            variables.put("short_arm_offset_right", 22F - ((Number) pivot.evaluate(List.of("rightarm", 1))).floatValue());
+            variables.put("short_arm_offset_left", 22F - ((Number) pivot.evaluate(List.of("leftarm", 1))).floatValue());
+        }
+        return new BedrockActorAnimation.Frame(queries, variables, context);
+    }
+}
