+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.joml.Vector3f;
+
+import java.util.OptionalLong;
+
+/** Independent native dynamics and appearance counters, driven once per render frame. */
+final class BedrockParticleInterpolation {
+    static final int PC_FRAMES = 2;
+    private final int frames;
+    private int dynamics, lastDynamics, renders, lastRender;
+    private long pending;
+
+    BedrockParticleInterpolation(final int frames) {
+        if (frames < 1) throw new IllegalArgumentException("Invalid particle interpolation period");
+        this.frames = frames;
+        this.lastDynamics = this.lastRender = ~frames;
+    }
+
+    static long elapsed(final long nanos) {
+        return nanos < 101_000_000 ? Math.max(0, nanos) : 100_000_000;
+    }
+
+    OptionalLong update(final long nanos) {
+        this.pending += elapsed(nanos);
+        if (++this.dynamics - this.lastDynamics < this.frames) return OptionalLong.empty();
+        this.lastDynamics = this.dynamics;
+        final long elapsed = this.pending;
+        this.pending = 0;
+        return OptionalLong.of(elapsed);
+    }
+
+    Frame render(final boolean shortLived) {
+        final boolean refresh = ++this.renders - this.lastRender >= this.frames;
+        if (refresh) this.lastRender = this.renders;
+        final boolean startup = this.lastRender < 2 || this.lastDynamics <= 1;
+        return new Frame(refresh, startup && shortLived, !startup || shortLived,
+                (float) (this.dynamics - this.lastDynamics) / this.frames,
+                (float) (this.renders - this.lastRender) / this.frames);
+    }
+
+    static float blend(final float previous, final float current, final float alpha) {
+        return (current - previous) * alpha + previous;
+    }
+
+    static Vector3f position(final Vector3f previous, final Vector3f current, final float alpha) {
+        return new Vector3f(current).sub(previous).mul(alpha).add(previous);
+    }
+
+    record Frame(boolean refresh, boolean force, boolean visible, float motionAlpha, float appearanceAlpha) {}
+}
