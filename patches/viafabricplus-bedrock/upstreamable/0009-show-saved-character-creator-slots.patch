index 0000000..ff0be71
--- /dev/null
+++ b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_particle.fsh
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+#include <minecraft:fog.glsl>
+#include <minecraft:dynamictransforms.glsl>
+#include <minecraft:oit.glsl>
+
+uniform sampler2D Sampler0;
+
+layout(location = 0) in float sphericalVertexDistance;
+layout(location = 1) in float cylindricalVertexDistance;
+layout(location = 2) in vec2 texCoord0;
+layout(location = 3) in vec4 vertexColor;
+#ifndef OIT_ALPHA_ONLY
+layout(location = 0) out vec4 fragColor;
+#endif
+
+void main() {
+    vec4 texel = texture(Sampler0, texCoord0);
+    #ifdef ALPHA_TEST
+    if (texel.a < 0.5) discard;
+    #endif
+    #ifdef TRANSLUCENT
+    vec4 color = texel * vertexColor * ColorModulator;
+    #else
+    vec4 color = vec4(texel.rgb * vertexColor.rgb * ColorModulator.rgb, 1.0);
+    #endif
+    #ifdef OIT_DEPTH_BOUNDS
+    // Native translucent particles have no alpha cutoff, including the depth bounds pass.
+    #ifdef OIT_ADDITIVE
+    // Additive color never makes the surface opaque to particles behind it.
+    calculateDepthBounds(gl_FragCoord.z, 0.0);
+    #else
+    calculateDepthBounds(gl_FragCoord.z, color.a);
+    #endif
+    #elif defined(OIT_ALPHA_ONLY)
+    executeAlphaOnlyPhase(gl_FragCoord.z, color.a);
+    #else
+    color = apply_fog(color, sphericalVertexDistance, cylindricalVertexDistance,
+        FogEnvironmentalStart, FogEnvironmentalEnd, FogRenderDistanceStart, FogRenderDistanceEnd, FogColor);
+    #ifdef TRANSLUCENT
+    // The target Transparent particle fragment applies the same fog interpolation twice.
+    color = apply_fog(color, sphericalVertexDistance, cylindricalVertexDistance,
+        FogEnvironmentalStart, FogEnvironmentalEnd, FogRenderDistanceStart, FogRenderDistanceEnd, FogColor);
+    #endif
+    #ifdef OIT_ACCUMULATE
+    color = sampleColorForAccumulation(color);
+    #endif
+    fragColor = color;
+    #endif
+}
