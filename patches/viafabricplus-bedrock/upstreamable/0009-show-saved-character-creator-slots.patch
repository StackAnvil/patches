+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockFirstPersonCameraTest {
+    private static final String[] FIELDS = {"previousPitch", "previousYaw", "angularPitch", "angularYaw",
+            "pitch", "yaw", "velocityPitch", "velocityYaw"};
+
+    @Test
+    void wrapsCameraYawAndIntegratesIndependentSpringsWithNativeSubsteps() {
+        final var camera = new BedrockFirstPersonCamera();
+        final var rotation = camera.update(10, 20, -170, 170, .5F, 1F / 64F);
+        assertEquals(Float.intBitsToFloat(1060764672), rotation.pitch());
+        assertEquals(Float.intBitsToFloat((int) 3208248320L), rotation.yaw());
+        final var longFrame = new BedrockFirstPersonCamera().update(10, 20, -170, 170, .5F, 1F);
+        assertEquals(Float.intBitsToFloat(1069645305), longFrame.pitch());
+        assertEquals(Float.intBitsToFloat((int) 3231792720L), longFrame.yaw());
+        assertEquals(longFrame, new BedrockFirstPersonCamera().update(10, 20, -170, 170, .5F, .2F));
+    }
+
+    @Test
+    void keepsTheClockAndStateLocalToEachAppearance() {
+        final var camera = new BedrockFirstPersonCamera();
+        assertEquals(new BedrockFirstPersonCamera().update(10, 20, -170, 170, .5F, .2F),
+                camera.sample(10, 20, -170, 170, .5F, 100D));
+        final var next = camera.sample(20, 20, 170, 170, .5F, 100D + 1D / 64D);
+        final var reference = new BedrockFirstPersonCamera();
+        reference.update(10, 20, -170, 170, .5F, .2F);
+        assertEquals(reference.update(20, 20, 170, 170, .5F, 1F / 64F), next);
+        assertEquals(BedrockFirstPersonCamera.Rotation.ZERO,
+                new BedrockFirstPersonCamera().sample(0, 0, 0, 0, .5F, 101D));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_CAMERA_SPRING", matches = ".+")
+    void matchesExecutableInterpolationDampingAndRetainedFrameSchedules() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_CAMERA_SPRING"))))
+                .getAsJsonObject();
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var camera = new BedrockFirstPersonCamera();
+            final var row = entry.getAsJsonObject();
+            load(camera, row.getAsJsonArray("state"));
+            compare(camera, row);
+        }
+        for (final var sequence : fixture.getAsJsonArray("sequences")) {
+            final var camera = new BedrockFirstPersonCamera();
+            for (final var row : sequence.getAsJsonObject().getAsJsonArray("frames")) compare(camera, row.getAsJsonObject());
+        }
+    }
+
+    private static void load(final BedrockFirstPersonCamera camera, final JsonArray state) throws Exception {
+        for (int i = 0; i < FIELDS.length; i++) {
+            final var field = BedrockFirstPersonCamera.class.getDeclaredField(FIELDS[i]);
+            field.setAccessible(true);
+            field.setFloat(camera, state.get(i).getAsFloat());
+        }
+    }
+
+    private static void compare(final BedrockFirstPersonCamera camera, final JsonObject row) throws Exception {
+        final var angles = row.getAsJsonArray("angles");
+        camera.update(angles.get(2).getAsFloat(), angles.get(0).getAsFloat(),
+                angles.get(3).getAsFloat(), angles.get(1).getAsFloat(), row.get("alpha").getAsFloat(), row.get("elapsed").getAsFloat());
+        for (int i = 0; i < FIELDS.length; i++) {
+            final var field = BedrockFirstPersonCamera.class.getDeclaredField(FIELDS[i]);
+            field.setAccessible(true);
+            final float actual = field.getFloat(camera);
+            final int expected = row.getAsJsonArray("result").get(i).getAsInt();
+            if (Float.isNaN(Float.intBitsToFloat(expected))) assertTrue(Float.isNaN(actual));
+            else assertEquals(expected, Float.floatToRawIntBits(actual), FIELDS[i]);
+        }
+    }
+}
