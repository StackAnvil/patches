+
+    static Map<String, BedrockPersonaAssets.Pack> packs(
+            final BedrockBuiltinAssets.Contents assets, final BedrockPersonaProfile handles)
+            throws Exception {
+        final Map<String, BedrockPersonaAssets.Pack> result = new LinkedHashMap<>();
+        for (final var handle : handles.pieces())
+            result.put(handle.id(), assets.piece(handle.id()));
+        return result;
+    }
+
+    private static String id(final BedrockCharacterProfiles.Slot slot, final String type) {
+        return slot.pieceIds().stream()
+                .map(recipe -> recipe.split("/", 2)[0])
+                .filter(id -> type.equals(BedrockPersonaProfile.defaultType(id)))
+                .findFirst()
+                .orElseThrow();
+    }
+
+    static BedrockCharacterProfiles.Slot slot(
+            final JsonObject profile, final String arm, final String color) {
+        final List<String> ids =
+                profile
+                        .getAsJsonObject("personaCollection")
+                        .getAsJsonArray("universalApp")
+                        .asList()
+                        .stream()
+                        .map(entry -> entry.getAsJsonObject())
+                        .filter(entry -> entry.has("id"))
+                        .map(entry -> entry.get("id").getAsString())
+                        .toList();
+        return new BedrockCharacterProfiles.Slot(1, arm, color, ids, "test-profile", profile);
+    }
+
+    static Map<String, JsonObject> bones(final BedrockPersonaModel.Converted model) {
+        final Map<String, JsonObject> result = new LinkedHashMap<>();
+        for (final var bone :
+                JsonParser.parseString(model.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")) {
+            final var node = bone.getAsJsonObject();
+            result.put(node.get("name").getAsString(), node);
+        }
+        return result;
+    }
+
+    private static void parse(final BedrockPersonaModel.Converted model) {
+        org.cube.converter.model.impl.bedrock.BedrockGeometryModel.fromJson(
+                com.viaversion.viaversion.libs.gson.JsonParser.parseString(model.geometry())
+                        .getAsJsonObject());
+    }
+
+    private static BedrockPersonaAssets.Pack pack(
+            final String id,
+            final String meta,
+            final String geometry,
+            final Map<String, byte[]> files) {
+        final Map<String, byte[]> result = new LinkedHashMap<>(files);
+        result.put("piece.meta.json", meta.getBytes(StandardCharsets.UTF_8));
+        result.put("piece.geometry.json", geometry.getBytes(StandardCharsets.UTF_8));
+        return new BedrockPersonaAssets.Pack(id, result);
+    }
+
+    private static byte[] clothingMap() {
+        final byte[] bytes = new byte[18 + 128 * 128 * 4];
+        bytes[2] = 2;
+        bytes[12] = (byte) 128;
+        bytes[14] = (byte) 128;
+        bytes[16] = 32;
+        bytes[17] = 32;
+        final int offset = 18 + (12 * 128 + 10) * 4;
+        bytes[offset + 1] = (byte) 129;
+        bytes[offset + 2] = (byte) 127;
+        bytes[offset + 3] = (byte) 255;
+        return bytes;
+    }
+
+    private static BufferedImage image(final int width, final int height, final int color) {
+        final BufferedImage result = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < height; y++) for (int x = 0; x < width; x++) result.setRGB(x, y, color);
+        return result;
+    }
+
+    private static byte[] png(final BufferedImage image) throws Exception {
+        final var output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
