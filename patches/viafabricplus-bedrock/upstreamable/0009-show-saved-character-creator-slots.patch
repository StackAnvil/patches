+        queries.put("shield_blocking_bob", BedrockActorState.shieldBlockingBob(entity.getUUID(), partialTick));
+        queries.put("target_x_rotation", state.xRot);
+        queries.put("target_y_rotation", state.yRot);
+        queries.put("body_y_rotation", state.bodyRot);
+        queries.put("walk_distance", entity instanceof BedrockWalkingAnimation.Provider walking
+                ? walking.bedrockWalkingAnimation().sample(partialTick) : 0F);
+        queries.put("modified_distance_moved", state.walkAnimationPos);
+        queries.put("modified_move_speed", state.walkAnimationSpeed);
+        queries.put(
+                "sleep_rotation",
+                state.bedOrientation == null ? 0F : state.bedOrientation.toYRot());
+        queries.put("cape_flap_amount", Math.clamp(state.capeFlap / 32F, 0, 1));
+        final boolean mainRight = entity.getMainArm() == HumanoidArm.RIGHT;
+        queries.putAll(
+                itemAnimation(entity,
+                        mainRight ? state.rightHandItemStack : state.leftHandItemStack,
+                        mainRight ? state.leftHandItemStack : state.rightHandItemStack)
+                        .queries());
+        queries.putAll(BedrockItemAnimation.equipmentQueries(Map.of(
+                "slot.weapon.mainhand", item(entity.getMainHandItem(), entity),
+                "slot.weapon.offhand", item(entity.getOffhandItem(), entity),
+                "slot.armor.head", item(entity.getItemBySlot(EquipmentSlot.HEAD), entity),
+                "slot.armor.chest", item(entity.getItemBySlot(EquipmentSlot.CHEST), entity),
