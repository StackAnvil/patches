+                new BedrockItemAnimation(bow, crossbow, BedrockItemAnimation.Item.EMPTY, bow, 12);
+        final var queries = items.queries();
+        assertEquals("", query(queries, "get_equipped_item_name", List.of(0, 1)));
+        assertEquals("bow", query(queries, "get_equipped_item_name", List.of("off_hand", 1)));
+        assertEquals("crossbow", query(queries, "get_equipped_item_name", List.of(1.9F)));
+        assertEquals("", query(queries, "get_equipped_item_name", List.of(2)));
+        assertEquals("", query(queries, "get_equipped_item_name", List.of(Float.NaN)));
+        assertEquals(true, query(queries, "item_is_charged", List.of("off_hand")));
+        assertEquals(false, query(queries, "item_is_charged", List.of(2)));
+        assertEquals(0F, query(queries, "item_remaining_use_duration", List.of(0, 1)));
+        assertEquals(0.48F, query(queries, "item_remaining_use_duration", List.of("off_hand", 1)));
+    }
+
+    @Test
