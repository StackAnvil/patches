+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/** A resource-defined actor graph with shared variables and independent playback clocks. */
+public final class BedrockActorAnimation {
+    @FunctionalInterface
+    public interface Query {
+        Object evaluate(List<Object> arguments);
+    }
+
+    public record Frame(Map<String, Object> queries, Map<String, Float> variables, Map<String, Object> context) {
+        public Frame(final Map<String, Object> queries, final Map<String, Float> variables) {
+            this(queries, variables, Map.of());
+        }
+        public Frame {
+            queries = Map.copyOf(queries);
+            variables = Map.copyOf(variables);
+            context = Map.copyOf(context);
+        }
+    }
+
+    private final Map<String, String> aliases;
+    private final Map<String, String> soundAliases;
+    private final Map<String, String> particleAliases;
+    private final BedrockResourceLibrary resources;
+    private final Map<String, BedrockBoneAnimation> animations;
+    private final Map<String, Controller> controllers;
+    private final List<BedrockMolang.Program> initialize, preAnimation;
+    private final List<Reference> roots;
+    private final BedrockActorVisibility visibility;
+    private final BedrockActorScale scale;
+
+    private BedrockActorAnimation(
+            final JsonObject entity, final Map<String, String> overrides,
+            final Map<String, JsonObject> animationDefinitions,
+            final Map<String, ControllerResource> controllerDefinitions,
+            final BedrockResourceLibrary resources) throws IOException {
+        this.resources = resources;
+        final Map<String, JsonObject> renderControllers = new LinkedHashMap<>();
+        if (resources != null)
+            resources.definitions("render_controllers", "render_controllers")
+                    .forEach((name, definition) -> renderControllers.put(name, definition.value()));
+        this.visibility = BedrockActorVisibility.read(entity, renderControllers);
+        final Map<String, String> soundAliases = new LinkedHashMap<>();
+        final JsonObject sounds = entity.getAsJsonObject("sound_effects");
+        if (sounds != null) {
+            if (sounds.size() > 4096) throw new IOException("Too many actor sound aliases");
+            for (final var entry : sounds.entrySet()) {
+                final String name = entry.getValue().getAsString();
+                if (entry.getKey().length() > 512 || name.length() > 512)
+                    throw new IOException("Invalid actor sound alias");
+                soundAliases.put(entry.getKey(), name);
+            }
+        }
+        this.soundAliases = Map.copyOf(soundAliases);
+        final Map<String, String> particleAliases = new LinkedHashMap<>();
+        final JsonObject particles = entity.getAsJsonObject("particle_effects");
+        if (particles != null) {
+            if (particles.size() > 4096) throw new IOException("Too many actor particle aliases");
+            for (final var entry : particles.entrySet()) {
+                final String name = entry.getValue().getAsString();
+                if (entry.getKey().length() > 512 || name.length() > 512)
+                    throw new IOException("Invalid actor particle alias");
+                particleAliases.put(entry.getKey(), name);
+            }
+        }
+        this.particleAliases = Map.copyOf(particleAliases);
+        final Map<String, String> aliases = new LinkedHashMap<>();
+        final JsonObject declaredAnimations = entity.getAsJsonObject("animations");
+        if (declaredAnimations != null) {
+            declaredAnimations.entrySet()
+                    .forEach(entry -> aliases.put(entry.getKey(), entry.getValue().getAsString()));
+        }
+        aliases.putAll(overrides);
+        this.aliases = Map.copyOf(aliases);
+        final JsonObject scripts = entity.getAsJsonObject("scripts");
+        this.scale = BedrockActorScale.read(scripts);
+        this.initialize = programs(scripts == null ? null : scripts.get("initialize"));
+        this.preAnimation = programs(scripts == null ? null : scripts.get("pre_animation"));
+        this.roots = references(scripts == null ? null : scripts.get("animate"));
+        this.animations = new LinkedHashMap<>();
+        this.controllers = new LinkedHashMap<>();
+        for (final Reference root : this.roots)
+            this.resolve(
+                    root.name, animationDefinitions, controllerDefinitions, new HashSet<>(), 0);
+    }
+
+    static BedrockActorAnimation read(
+            final BedrockResourceLibrary library, final BedrockClassicOptions options)
+            throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>();
+        library.definitions("animations", "animations")
+                .forEach((name, resource) -> animations.put(name, resource.value()));
+        for (final var entry :
+                library.definitions("animation_controllers", "animation_controllers").entrySet()) {
+            final var resource = entry.getValue();
+            controllers.put(
+                    entry.getKey(),
+                    new ControllerResource(
+                            resource.value(), deferredEntry(resource.formatVersion())));
+        }
+        try {
+            return new BedrockActorAnimation(
+                    library.entity("minecraft:player").getAsJsonObject("description"),
+                    options.animations(),
+                    animations,
+                    controllers,
+                    library);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid actor animation library", invalid);
+        }
+    }
+
+    static BedrockActorAnimation read(
+            final JsonObject entity,
+            final Map<String, String> overrides,
+            final JsonObject animations,
+            final JsonObject controllers,
+            final String controllerFormat)
+            throws IOException {
+        final Map<String, JsonObject> animationDefinitions = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllerDefinitions = new LinkedHashMap<>();
+        final boolean deferred = deferredEntry(controllerFormat);
+        animations
+                .entrySet()
+                .forEach(
+                        entry ->
+                                animationDefinitions.put(
+                                        entry.getKey(), entry.getValue().getAsJsonObject()));
+        controllers
+                .entrySet()
+                .forEach(
+                        entry ->
+                                controllerDefinitions.put(
+                                        entry.getKey(),
+                                        new ControllerResource(
+                                                entry.getValue().getAsJsonObject(), deferred)));
+        return new BedrockActorAnimation(
+                entity, overrides, animationDefinitions, controllerDefinitions, null);
+    }
+
+    private void resolve(
+            final String alias,
+            final Map<String, JsonObject> animations,
+            final Map<String, ControllerResource> controllers,
+            final Set<String> chain,
+            final int depth)
+            throws IOException {
+        final String name = this.aliases.get(alias);
+        // Matching vanilla controllers retain references to aliases removed by newer entities.
+        if (name == null || name.isEmpty()) return;
+        if (depth > 32 || !chain.add(name))
+            throw new IOException("Cyclic actor animation controller");
+        if (name.startsWith("controller.animation.")) {
+            if (!this.controllers.containsKey(name)) {
+                final ControllerResource resource = controllers.get(name);
+                if (resource != null) {
+                    final Controller controller =
+                            Controller.read(resource.definition, resource.deferredEntry);
+                    for (final State state : controller.states.values())
+                        for (final Reference reference : state.animations)
+                            this.resolve(reference.name, animations, controllers, chain, depth + 1);
+                    this.controllers.put(name, controller);
+                }
+            }
+        } else if (!this.animations.containsKey(name)) {
+            final JsonObject definition = animations.get(name);
+            if (definition != null)
+                this.animations.put(name, BedrockBoneAnimation.parse(definition));
+        }
+        chain.remove(name);
+    }
+
+    public Playback playback() {
+        return new Playback();
+    }
+
+    /** A resolved actor alias. The locator remains authored data for the position resolver. */
+    public final class SoundCue {
+        private final String event, locator;
+
+        private SoundCue(final String event, final String locator) {
+            this.event = event;
+            this.locator = locator;
+        }
+
+        public String event() { return this.event; }
+        public String locator() { return this.locator; }
+
+        public void play(final net.minecraft.world.phys.Vec3 position) {
+            if (resources != null) BedrockSoundPlayback.play(resources, this.event, position);
+        }
+    }
+
+    /** A particle alias with emitter-local initialization and an immutable event declaration. */
+    public final class ParticleCue {
+        private final String event;
+        private final BedrockAnimationParticle declaration;
+        private final BedrockMolang environment;
+        private ParticleCue(final String event, final BedrockAnimationParticle declaration, final BedrockMolang environment) {
+            this.event = event;
+            this.declaration = declaration;
+            this.environment = environment;
+        }
+        public String event() { return this.event; }
+        public String locator() { return this.declaration.locator(); }
+        public boolean attached() { return this.declaration.attached(); }
+        public void play(final net.minecraft.world.phys.Vec3 position,
+                         final java.util.function.Supplier<BedrockParticleAttachment> attachment) {
+            if (resources != null) BedrockParticlePlayback.play(resources, this.event, this.environment,
+                    this.declaration.initialization(), position, attachment);
+        }
+    }
+
+    public record PartVisibility(java.util.regex.Pattern pattern, boolean visible) {}
+
+    public record Visibility(boolean specified, List<List<PartVisibility>> controllers) {
+        public static final Visibility UNSPECIFIED = new Visibility(false, List.of());
+
+        public Visibility {
+            controllers = controllers.stream().map(List::copyOf).toList();
+        }
+
+        public boolean visible(final String bone) {
+            if (!this.specified) return true;
+            for (final List<PartVisibility> controller : this.controllers) {
+                boolean visible = true;
+                for (final PartVisibility part : controller)
+                    if (part.pattern.matcher(bone).matches()) visible = part.visible;
+                if (visible) return true;
+            }
+            return false;
+        }
+    }
+
+    public final class Playback {
+        private BedrockMolang molang = new BedrockMolang();
+        private List<Active> active;
+        private StatePlayback queryState;
+        private float previousTime = Float.NaN;
+        private float delta;
+        private int allocated;
+        private Map<String, BedrockBoneAnimation.Transform> pose = Map.of();
+        private boolean eventsEnabled;
+        private Consumer<SoundCue> soundOutput;
+        private Consumer<ParticleCue> particleOutput;
+
+        public Map<String, BedrockBoneAnimation.Transform> sample(
+                final float time, final Frame input) {
+            return this.sample(time, input, true, null);
+        }
+
+        public Map<String, BedrockBoneAnimation.Transform> sample(
+                final float time, final Frame input, final boolean eventsEnabled,
+                final Consumer<SoundCue> soundOutput) {
+            return this.sample(time, input, eventsEnabled, soundOutput, null);
+        }
+
+        public Map<String, BedrockBoneAnimation.Transform> sample(
+                final float time, final Frame input, final boolean eventsEnabled,
+                final Consumer<SoundCue> soundOutput, final Consumer<ParticleCue> particleOutput) {
+            if (!Float.isFinite(time)) return Map.of();
+            if (time == this.previousTime) return this.pose;
+            this.eventsEnabled = eventsEnabled;
+            this.soundOutput = soundOutput;
+            this.particleOutput = particleOutput;
+            if (time < this.previousTime) {
+                this.molang = new BedrockMolang();
+                this.active = null;
+                this.allocated = 0;
+            }
+            this.delta = this.active == null ? 0 : Math.max(0, time - this.previousTime);
+            this.previousTime = time;
+            this.queryState = null;
+            final Map<String, Object> queries = new HashMap<>(input.queries);
+            queries.put(
+                    "state_time", (Query) _ -> this.queryState == null ? 0F : this.queryState.time);
+            queries.put(
+                    "all_animations_finished",
+                    (Query) _ -> this.queryState != null && this.queryState.allFinished());
+            queries.put(
+                    "any_animation_finished",
+                    (Query) _ -> this.queryState != null && this.queryState.anyFinished());
+            this.molang.queries(queries, 0, time, this.delta);
+            this.molang.context(input.context());
+            if (this.active == null) {
+                this.active = this.create(roots);
+                this.run(initialize);
+            }
+            this.molang.variables(input.variables);
+            this.run(preAnimation);
+            final Map<String, BedrockBoneAnimation.Transform> result = new LinkedHashMap<>();
+            for (final Active value : this.active) value.apply(time, 1, queries, result);
+            this.pose = Map.copyOf(result);
+            return this.pose;
+        }
+
+        private void sound(final BedrockAnimationSound sound) {
+            if (this.soundOutput == null) return;
+            final SoundCue cue = this.soundCue(sound);
+            if (cue != null) this.soundOutput.accept(cue);
+        }
+
+        private void particle(final BedrockAnimationParticle.Cue declaration) {
+            if (this.particleOutput == null) return;
+            final var cue = this.particleCue(declaration);
+            if (cue != null) this.particleOutput.accept(cue);
+        }
+
+        public ParticleCue particleCue(final BedrockAnimationParticle.Cue cue) {
+            final BedrockAnimationParticle declaration = cue.declaration;
+            final String event = particleAliases.get(declaration.effect());
+            return event == null || event.isEmpty() ? null : new ParticleCue(event, declaration, cue.environment);
+        }
+
+        /** Creates another perspective without sharing animation clocks or variables. */
+        public Playback fork() {
+            return new Playback();
+        }
+
+        /** Uses the variables left by the sampled graph, without rerunning actor scripts. */
+        public Visibility visibility() {
+            return BedrockActorAnimation.this.visibility.sample(this.molang);
+        }
+
+        /** Resolves complete render-controller draws in this perspective's sampled variable scope. */
+        public BedrockPlayerControllers.Selection renderControllers(final BedrockPlayerControllers controllers) throws IOException {
+            return controllers.select(this.molang, true);
+        }
+
+        /** Evaluates draw-time scale after the sampled graph, without rerunning animation scripts. */
+        public BedrockBoneAnimation.Vector scale() {
+            return BedrockActorAnimation.this.scale.sample(this.molang);
+        }
+
+        public SoundCue soundCue(final BedrockAnimationSound sound) {
+            final String event = soundAliases.get(sound.effect());
+            return event == null || event.isEmpty() ? null : new SoundCue(event, sound.locator());
+        }
+
+        private List<Active> create(final List<Reference> references) {
+            final List<Active> values = new ArrayList<>();
+            for (final Reference reference : references) {
+                final String name = aliases.get(reference.name);
+                if (name == null || name.isEmpty()) continue;
+                if (++this.allocated > 4096) break;
+                values.add(
+                        new Active(
+                                reference,
+                                name.startsWith("controller.animation."),
+                                animations.get(name),
+                                controllers.get(name)));
+            }
+            return List.copyOf(values);
+        }
+
+        private void run(final List<BedrockMolang.Program> programs) {
+            programs.forEach(program -> this.molang.evaluate(program, 0));
+        }
+
+        private final class Active {
+            private final Reference reference;
+            private final boolean controllerReference;
+            private final BedrockBoneAnimation animation;
+            private final Controller controller;
+            private final Map<String, StatePlayback> states = new HashMap<>();
+            private BedrockBoneAnimation.Playback playback;
+            private StatePlayback current, outgoing;
+            private float elapsed, blendTime;
+
+            private Active(
+                    final Reference reference,
+                    final boolean controllerReference,
+                    final BedrockBoneAnimation animation,
+                    final Controller controller) {
+                this.reference = reference;
+                this.controllerReference = controllerReference;
+                this.animation = animation;
+                this.controller = controller;
+                if (animation != null) this.playback = animation.playback(molang);
+            }
+
+            private boolean completed() {
+                return this.playback != null
+                        ? this.playback.completed()
+                        : this.current != null && this.current.completed;
+            }
+
+            private void reset() {
+                this.elapsed = 0;
+                if (this.animation != null) this.playback = this.animation.playback(molang);
+                // Native nested controllers retain their selected state when their player resets.
+                else if (this.current != null) this.current.reset();
+            }
+
+            private StatePlayback state(final String name) {
+                return this.states.computeIfAbsent(
+                        name, key -> new StatePlayback(this.controller.states.get(key)));
+            }
+
+            private void apply(
+                    final float time,
+                    final float inheritedWeight,
+                    final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                // Unresolved native animation players retain their incomplete state without
+                // updates.
+                if (this.playback == null && !this.controllerReference) return;
+                final float weight = inheritedWeight * molang.evaluate(this.reference.weight, 1);
+                if (weight < Math.ulp(1F)) return;
+                if (this.playback != null) {
+                    this.elapsed += delta;
+                    this.animation.compose(
+                            pose, this.playback.sample(this.elapsed, queries, pose, eventsEnabled, Playback.this::sound, Playback.this::particle), weight);
+                    molang.queries(queries, 0, time, delta);
+                    return;
+                }
+                if (this.controller == null) return;
+                final var saved = molang.saveVariables(this.controller.variables);
+                StatePlayback entered = null;
+                try {
+                    final boolean first = this.current == null;
+                    if (first) this.current = this.state(this.controller.initial);
+                    if (first && this.controller.deferredEntry) {
+                        this.current.reset();
+                        if (eventsEnabled) run(this.current.definition.entry);
+                        entered = this.current;
+                    } else {
+                        queryState = this.current;
+                        this.current.time += delta;
+                        boolean transitioned = false;
+                        for (final Transition transition : this.current.definition.transitions) {
+                            if (molang.evaluate(transition.condition, 0) == 0) continue;
+                            final StatePlayback previous = this.current;
+                            this.current = this.state(transition.target);
+                            this.current.reset();
+                            this.outgoing = previous.definition.blend.isEmpty() ? null : previous;
+                            this.blendTime = 0;
+                            if (!first && previous != this.current && eventsEnabled)
+                                run(previous.definition.exit);
+                            if (first || previous != this.current) {
+                                if (eventsEnabled) run(this.current.definition.entry);
+                                entered = this.current;
+                            }
+                            transitioned = true;
+                            break;
+                        }
+                        if (first && !transitioned) {
+                            if (eventsEnabled) run(this.current.definition.entry);
+                            entered = this.current;
+                        }
+                    }
+                    this.applyStates(time, weight, queries, pose);
+                    // The native controller queues entry sounds after its sampled children.
+                    if (entered != null && eventsEnabled) {
+                        entered.definition.particles.forEach(declaration -> Playback.this.particle(
+                                new BedrockAnimationParticle.Cue(declaration, molang.copy())));
+                        entered.definition.sounds.forEach(Playback.this::sound);
+                    }
+                } finally {
+                    queryState = null;
+                    molang.restoreVariables(saved);
+                }
+            }
+
+            private void applyStates(
+                    final float time, final float weight, final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                if (this.outgoing == null) {
+                    this.current.apply(time, weight, queries, pose);
+                    return;
+                }
+                this.outgoing.time += delta;
+                this.blendTime += delta;
+                final float oldWeight = curve(this.outgoing.definition.blend, this.blendTime);
+                if (oldWeight < Math.ulp(1F)) {
+                    final StatePlayback previous = this.outgoing;
+                    this.outgoing = null;
+                    this.blendTime = 0;
+                    this.current.apply(time, weight, queries, pose);
+                    previous.time = 0;
+                } else if (this.outgoing.definition.shortestPath) {
+                    final Map<String, BedrockBoneAnimation.Transform>
+                            before = new LinkedHashMap<>(),
+                            after = new LinkedHashMap<>();
+                    this.outgoing.apply(time, 1, queries, before);
+                    this.current.apply(time, 1, queries, after);
+                    BedrockBoneAnimation.blendStates(pose, before, after, 1 - oldWeight);
+                } else {
+                    // The target controller uses curve weights directly during a crossfade.
+                    this.outgoing.apply(time, oldWeight, queries, pose);
+                    this.current.apply(time, 1 - oldWeight, queries, pose);
+                }
+            }
+        }
+
+        private final class StatePlayback {
+            private final State definition;
+            private final List<Active> children;
+            private float time;
+            private boolean completed;
+
+            private StatePlayback(final State definition) {
+                this.definition = definition;
+                this.children = create(definition.animations);
+            }
+
+            private boolean allFinished() {
+                return this.children.stream().allMatch(Active::completed);
+            }
+
+            private boolean anyFinished() {
+                return this.children.stream().anyMatch(Active::completed);
+            }
+
+            private void reset() {
+                this.time = 0;
+                this.completed = false;
+                this.children.forEach(Active::reset);
+            }
+
+            private void apply(
+                    final float time,
+                    final float weight,
+                    final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                if (weight < Math.ulp(1F)) return;
+                for (final var variable : this.definition.variables.entrySet())
+                    molang.variable(variable.getKey(), variable.getValue().sample(molang));
+                for (final Active child : this.children) child.apply(time, weight, queries, pose);
+                this.completed = this.allFinished();
+            }
+        }
+    }
+
+    private record Reference(String name, BedrockMolang.Program weight) {}
+
+    private record Transition(String target, BedrockMolang.Program condition) {}
+
+    private record Point(float input, float output) {}
+
+    private record Variable(BedrockMolang.Program input, List<Point> curve) {
+        float sample(final BedrockMolang molang) {
+            final float value = molang.evaluate(this.input, 0);
+            return this.curve.isEmpty() ? value : BedrockActorAnimation.curve(this.curve, value);
+        }
+    }
+
+    private static float curve(final List<Point> points, final float value) {
+        if (value <= points.getFirst().input) return points.getFirst().output;
+        for (int index = 1; index < points.size(); index++) {
+            final Point right = points.get(index), left = points.get(index - 1);
+            if (value <= right.input)
+                return left.output
+                        + (right.output - left.output)
+                                * (value - left.input)
+                                / (right.input - left.input);
+        }
+        return points.getLast().output;
+    }
+
+    private record State(
+            List<Reference> animations,
+            List<Transition> transitions,
+            List<BedrockMolang.Program> entry,
+            List<BedrockMolang.Program> exit,
+            List<BedrockAnimationSound> sounds,
+            List<BedrockAnimationParticle> particles,
+            Map<String, Variable> variables,
+            List<Point> blend,
+            boolean shortestPath) {}
+
+    private record ControllerResource(JsonObject definition, boolean deferredEntry) {}
+
+    private record Controller(
+            String initial,
+            Map<String, State> states,
+            Set<String> variables,
+            boolean deferredEntry) {
+        static Controller read(final JsonObject definition, final boolean deferredEntry)
+                throws IOException {
+            final Map<String, State> states = new LinkedHashMap<>();
+            final JsonObject source = definition.getAsJsonObject("states");
+            if (source == null || source.isEmpty() || source.size() > 128)
+                throw new IOException("Invalid actor controller state count");
+            for (final var entry : source.entrySet()) {
+                final JsonObject state = entry.getValue().getAsJsonObject();
+                final List<Transition> transitions = new ArrayList<>();
+                if (state.has("transitions"))
+                    for (final JsonElement transition : state.getAsJsonArray("transitions")) {
+                        if (transition.getAsJsonObject().size() != 1)
+                            throw new IOException("Invalid actor controller transition");
+                        final var target =
+                                transition.getAsJsonObject().entrySet().iterator().next();
+                        if (!source.has(target.getKey()))
+                            throw new IOException(
+                                    "The actor controller transition target is missing");
+                        transitions.add(
+                                new Transition(
+                                        target.getKey(),
+                                        BedrockMolang.Program.parse(target.getValue(), 0)));
+                    }
+                final Map<String, Variable> variables = new LinkedHashMap<>();
+                if (state.has("variables"))
+                    for (final var variable : state.getAsJsonObject("variables").entrySet()) {
+                        final JsonObject data = variable.getValue().getAsJsonObject();
+                        final List<Point> curve = new ArrayList<>();
+                        if (data.has("remap_curve"))
+                            for (final var point : data.getAsJsonObject("remap_curve").entrySet()) {
+                                final float input = Float.parseFloat(point.getKey()),
+                                        output = point.getValue().getAsFloat();
+                                if (!Float.isFinite(input) || !Float.isFinite(output))
+                                    throw new IOException("Invalid actor variable curve");
+                                curve.add(new Point(input, output));
+                            }
+                        curve.sort(java.util.Comparator.comparingDouble(Point::input));
+                        for (int index = 1; index < curve.size(); index++)
+                            if (curve.get(index).input == curve.get(index - 1).input)
+                                throw new IOException("Duplicate actor variable curve point");
+                        variables.put(
+                                variable.getKey(),
+                                new Variable(
+                                        BedrockMolang.Program.parse(data.get("input"), 0),
+                                        List.copyOf(curve)));
+                    }
+                states.put(
+                        entry.getKey(),
+                        new State(
+                                references(state.get("animations")),
+                                List.copyOf(transitions),
+                                programs(state.get("on_entry")),
+                                programs(state.get("on_exit")),
+                                BedrockAnimationSound.entries(state.get("sound_effects")),
+                                BedrockAnimationParticle.entries(state.get("particle_effects")),
+                                java.util.Collections.unmodifiableMap(variables),
+                                blend(state.get("blend_transition")),
+                                state.has("blend_via_shortest_path")
+                                        && state.get("blend_via_shortest_path").getAsBoolean()));
+            }
+            final String initial =
+                    definition.has("initial_state")
+                            ? definition.get("initial_state").getAsString()
+                            : "default";
+            if (!states.containsKey(initial))
+                throw new IOException("The actor controller initial state is missing");
+            final Set<String> variables = new HashSet<>();
+            states.values().forEach(state -> variables.addAll(state.variables.keySet()));
+            return new Controller(
+                    initial, Map.copyOf(states), Set.copyOf(variables), deferredEntry);
+        }
+    }
+
+    private static boolean deferredEntry(final String version) throws IOException {
+        final String[] parts = version.split("\\.", -1);
+        if (parts.length != 3) throw new IOException("Invalid actor controller format version");
+        final int[] threshold = {1, 18, 10};
+        int comparison = 0;
+        for (int index = 0; index < parts.length; index++) {
+            final int value;
+            try {
+                if (!parts[index].matches("[0-9]{1,5}")) throw new NumberFormatException();
+                value = Integer.parseInt(parts[index]);
+                if (value > 65535) throw new NumberFormatException();
+            } catch (NumberFormatException e) {
+                throw new IOException("Invalid actor controller format version", e);
+            }
+            if (comparison == 0) comparison = Integer.compare(value, threshold[index]);
+        }
+        return comparison >= 0;
+    }
+
+    private static List<Point> blend(final JsonElement definition) throws IOException {
+        if (definition == null) return List.of();
+        if (!definition.isJsonPrimitive() || !definition.getAsJsonPrimitive().isNumber())
+            throw new IOException("Invalid actor transition blend");
+        final float duration = definition.getAsFloat();
+        if (!Float.isFinite(duration) || duration < 0 || duration > 600)
+            throw new IOException("Invalid actor transition duration");
+        return duration == 0 ? List.of() : List.of(new Point(0, 1), new Point(duration, 0));
+    }
+
+    private static List<Reference> references(final JsonElement definitions) throws IOException {
+        if (definitions == null) return List.of();
+        final List<Reference> result = new ArrayList<>();
+        for (final JsonElement element : definitions.getAsJsonArray()) {
+            if (element.isJsonPrimitive() && element.getAsJsonPrimitive().isString())
+                result.add(
+                        new Reference(element.getAsString(), BedrockMolang.Program.parse(null, 1)));
+            else {
+                if (element.getAsJsonObject().size() != 1)
+                    throw new IOException("Invalid actor animation reference");
+                final var entry = element.getAsJsonObject().entrySet().iterator().next();
+                result.add(
+                        new Reference(
+                                entry.getKey(), BedrockMolang.Program.parse(entry.getValue(), 1)));
+            }
+        }
+        if (result.size() > 256) throw new IOException("Too many actor animation references");
+        return List.copyOf(result);
+    }
+
+    private static List<BedrockMolang.Program> programs(final JsonElement definitions)
+            throws IOException {
+        return definitions == null ? List.of() : List.of(BedrockMolang.Program.script(definitions));
+    }
+
+}
