+    private void nextColorChannel() {
+        final List<ColorTarget> targets = this.availableColors;
+        if (targets.size() < 2) {
+            return;
+        }
+        this.colorTarget = targets.get((targets.indexOf(this.colorTarget) + 1) % targets.size());
+        this.selectedColor = this.colorTarget.paletteIndex(this.currentColor());
+        this.editFailed = false;
+        this.acquisitionFailed = false;
+        this.updateControls();
+    }
+
+    private boolean isEquipped(final WardrobeItem item, final Slot slot) {
+        return slot.pieceIds().stream().anyMatch(item::matches);
+    }
+
+    private boolean isSaved(final WardrobeItem item) {
+        return this.wardrobe.slots().stream().anyMatch(slot -> this.isEquipped(item, slot))
+            || BedrockCharacterProfiles.hasPresetPiece(item) || this.category == Category.CAPES;
+    }
+
+    private boolean isEquippedHere(final WardrobeItem item, final Slot slot) {
+        return this.category == Category.EMOTES
+            ? item.matches(BedrockCharacterProfiles.emoteIds(slot, this.items).get(this.selectedEmoteSlot))
+            : this.isLimbCategory() ? BedrockCharacterProfiles.limbEquipped(slot, item, this.limbSide)
+            : this.isEquipped(item, slot);
+    }
+
+    private boolean isLimbCategory() {
+        return this.category == Category.ARMS || this.category == Category.LEGS;
+    }
