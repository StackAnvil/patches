+        HEADWEAR("DressingRoom_Headwears", "Headwear"),
+        GLOVES("DressingRoom_Gloves", "Gloves"),
+        FOOTWEAR("DressingRoom_Footwears", "Footwear"),
+        FACE_ITEMS("DressingRoom_FaceItems", "Face items"),
+        BACK_ITEMS("DressingRoom_BackItems", "Back items"),
+        CAPES("DressingRoom_Capes", "Capes"),
+        EMOTES("DressingRoom_Emotes", "Emotes");
+
+        private final String page;
+        private final String label;
+
+        Category(final String page, final String label) {
+            this.page = page;
+            this.label = label;
+        }
+
+        public String page() {
+            return this.page;
+        }
+
+        public List<ColorTarget> colorTargets() {
+            return switch (this) {
+                case HAIRS -> List.of(ColorTarget.HAIR);
+                case FACIAL_HAIRS -> List.of(ColorTarget.FACIAL_HAIR);
+                case MOUTHS -> List.of(ColorTarget.MOUTH);
+                case EYES -> List.of(ColorTarget.IRIS, ColorTarget.EYEBROWS, ColorTarget.SCLERA);
+                default -> List.of();
+            };
+        }
+
+
+        public String label() {
+            return this.label;
+        }
+    }
+
+    public record WardrobeItem(String id, String name, String type, String thumbnailUrl, String packId,
+                               boolean owned, int price, boolean requiresRedeem) {
+        public boolean freelyAvailable() {
+            return this.price == 0 && !this.requiresRedeem;
+        }
+
+        public boolean canEquip() {
+            return this.owned || this.freelyAvailable() || BedrockPersonaProfile.defaultType(this.packId) != null;
+        }
+
+        public boolean matches(final String pieceId) {
+            return !this.packId.isBlank() && (pieceId.equalsIgnoreCase(this.packId)
+                || pieceId.regionMatches(true, 0, this.packId + "/", 0, this.packId.length() + 1));
+        }
+    }
