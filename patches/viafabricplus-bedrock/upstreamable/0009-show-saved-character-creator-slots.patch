+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMolangColor;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.api.model.NativeActorStates;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+import java.util.UUID;
+
+/** Native actor inputs received on the current Minecraft connection's client thread. */
+public final class BedrockActorState {
+    private static final NativeActorStates ACTORS = new NativeActorStates();
+    private static volatile long generation;
+
+    private BedrockActorState() {}
+
+    public static void accept(final Connection connection, final NativeActorMessage message) {
+        final long receivedGeneration = generation;
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (generation == receivedGeneration && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                apply(message, listener.getLocalGameProfile().id());
+            }
+        });
+    }
+
+    static void apply(final NativeActorMessage message, final UUID localPlayer) {
+        ACTORS.apply(message, localPlayer);
+    }
+
+    public static NativeActorMessage.Snapshot state(final UUID uuid) {
+        return ACTORS.get(uuid);
+    }
+
+    public static NativeActorMessage.Snapshot stateByRuntimeId(final long runtimeId) {
+        return ACTORS.getByRuntimeId(runtimeId);
+    }
+
+    public static UUID lifetime(final UUID uuid) {
+        final var state = state(uuid);
+        return state == null ? null : state.lifetime();
+    }
+
+    public static boolean isCharging(final UUID uuid) {
+        final var state = state(uuid);
+        return state != null && state.flags().contains(ActorFlags.CHARGING);
+    }
+
+    public static boolean isBlocking(final UUID uuid, final boolean javaBlocking) {
+        final var state = state(uuid);
+        return state == null ? javaBlocking : state.flags().contains(ActorFlags.BLOCKING);
+    }
+
+    public static void tick() {
+        ACTORS.tick();
+    }
+
+    public static float shieldBlockingBob(final UUID uuid, final float frameAlpha) {
+        return ACTORS.shieldBlockingBob(uuid, frameAlpha);
+    }
+
+    public static BedrockMolangColor spellColor(final UUID uuid, final UUID lifetime) {
+        final var state = state(uuid);
+        return state != null && state.lifetime().equals(lifetime) && state.spellColor() != null
+                ? BedrockMolangColor.fromArgb(state.spellColor()) : BedrockMolangColor.ZERO;
+    }
+
+    public static void clear() {
+        generation++;
+        ACTORS.clear();
+    }
+}
