+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+import java.util.List;
+import java.util.regex.Pattern;
+
+final class BedrockAnimatedModelTest {
+    @Test
+    void hidesParentSurfacesWithoutDroppingAnimatedChildTransforms() {
+        final var geometry = BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.hand","texture_width":64,"texture_height":64},
+                  "bones":[{"name":"body","pivot":[0,24,0],"cubes":[{"origin":[-4,12,-2],"size":[8,12,4],"uv":[0,0]}]},
+                    {"name":"rightArm","parent":"body","pivot":[5,22,0],
+                     "cubes":[{"origin":[4,10,-2],"size":[4,12,4],"uv":[0,0]}]}]}]}
+                """).getFirst();
+        final var model = BedrockGeometry.animatedModel(geometry, Map.of());
+        final var body = model.model().root().getChild("body");
+        final var arm = body.getChild("rightArm");
+        model.pose(Map.of("body", new BedrockBoneAnimation.Transform(new BedrockBoneAnimation.Vector(0, 2, 0),
+                new BedrockBoneAnimation.Vector(0, 0, 90), new BedrockBoneAnimation.Vector(1, 1, 1), false)));
+        model.visibility(new BedrockActorAnimation.Visibility(true, List.of(List.of(
+                new BedrockActorAnimation.PartVisibility(Pattern.compile(".*"), false),
+                new BedrockActorAnimation.PartVisibility(Pattern.compile("rightArm"), true)))));
+        assertTrue(body.visible);
+        assertFalse(body.getChild("cube_0").visible);
+        assertTrue(arm.getChild("cube_0").visible);
+        final var poses = new PoseStack();
+        body.translateAndRotate(poses);
+        arm.translateAndRotate(poses);
+        final var origin = poses.last().pose().transformPosition(new Vector3f());
+        assertEquals(-2F / 16F, origin.x, .00001F);
+        assertEquals(3F / 16F, origin.y, .00001F);
+        model.visibility(BedrockActorAnimation.Visibility.UNSPECIFIED);
+        assertTrue(body.getChild("cube_0").visible);
+    }
+
+    @Test
+    void keepsTheWaistHierarchyAndResetsPoseBetweenPlaybacks() throws Exception {
+        final var geometry =
+                BedrockGeometryModel.fromJson(
+                                """
+                                {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+                                  "bones":[{"name":"root","pivot":[0,0,0],"rotation":[0,0,0]},
+                                    {"name":"waist","parent":"root","pivot":[0,12,0],"rotation":[0,0,0]},
+                                    {"name":"body","parent":"waist","pivot":[0,24,0],"rotation":[0,0,0]},
+                                    {"name":"head","parent":"body","pivot":[0,24,0],"rotation":[0,0,0]}]}]}
+                                """)
+                        .getFirst();
+        final var model = BedrockGeometry.animatedModel(geometry, Map.of());
+        final var root = model.model().root().getChild("root");
+        final var waist = root.getChild("waist");
+        final var body = waist.getChild("body");
+        final var head = body.getChild("head");
+        final var animation =
+                BedrockBoneAnimation.parse(
+                        JsonParser.parseString(
+                                        """
+                                        {"bones":{"hip":{"rotation":[0,0,90]},"root":{"position":[0,2,0]}}}
+                                        """)
+                                .getAsJsonObject());
+        for (int frame = 0; frame < 3; frame++) {
+            model.pose(animation.playback().sample(0, Map.of()));
+            final var pose = new PoseStack();
+            root.translateAndRotate(pose);
+            waist.translateAndRotate(pose);
+            body.translateAndRotate(pose);
+            head.translateAndRotate(pose);
+            final Vector3f headOrigin = pose.last().pose().transformPosition(new Vector3f());
+            assertEquals(.75F, headOrigin.x, 0.0001F);
+            assertEquals(.625F, headOrigin.y, 0.0001F);
+        }
+        model.pose(Map.of());
+        assertEquals(24, root.y);
+        assertEquals(0, waist.zRot);
+    }
+}
