+    private static FirstPersonFrame firstPersonFrame(final AvatarRenderState state,
+                                                     final FirstPersonHandsAndItemsRenderState items,
+                                                     final float partialTick) {
+        final var player = Minecraft.getInstance().player;
+        final Appearance appearance = firstPersonAppearance(state);
+        if (appearance == null) return null;
+        final var source = actor(appearance);
+        if (appearance.firstPersonSource != source) {
+            appearance.firstPersonSource = source;
+            appearance.firstPersonActor = source.fork();
+        }
+        final Map<String, Object> queries = new HashMap<>(actorQueries(player, state, partialTick));
+        queries.put("is_first_person", true);
+        queries.put("is_spectator", state.isSpectator);
+        final Geometry geometry = geometry(appearance, true);
+        if (geometry != null) queries.putAll(geometry.queries());
+        final var frame = BedrockFirstPersonInput.bind(
+                new BedrockActorAnimation.Frame(queries, actorVariables(player, state, true), Map.of("is_first_person", 1)),
+                itemAnimation(player, items.mainHandItem, items.offHandItem), items.oldMainHandHeight,
+                items.mainHandHeight, items.oldOffHandHeight, items.offHandHeight, partialTick);
+        final var pose = appearance.firstPersonActor.sample((System.nanoTime() - appearance.started) / 1_000_000_000F,
+                frame, false, null, null);
+        final var camera = Minecraft.getInstance().options.bobView().get()
+                ? appearance.firstPersonCamera.sample(player.xRotO, player.getXRot(), player.yRotO, player.getYRot(),
+                    partialTick, System.nanoTime() / 1_000_000_000D)
+                : BedrockFirstPersonCamera.Rotation.ZERO;
+        final var scale = appearance.firstPersonActor.scale();
+        final var nativeState = BedrockActorState.state(player.getUUID());
+        final var visibility = appearance.firstPersonActor.visibility();
+        if (geometry != null && appearance.firstPersonModels == null) {
+            final List<FirstPersonSurface> surfaces = new ArrayList<>();
+            surfaces.add(new FirstPersonSurface(BedrockGeometry.animatedModel(geometry.model(), geometry.meshes()), appearance.bodyId));
+            for (final var surface : appearance.surfaces)
+                surfaces.add(new FirstPersonSurface(BedrockGeometry.animatedModel(surface.geometry().model(), surface.geometry().meshes()), surface.texture()));
+            appearance.firstPersonModels = List.copyOf(surfaces);
+        }
+        final boolean nativeDrawing = !state.isInvisible && visibility.specified() && appearance.firstPersonModels != null;
+        if (nativeDrawing) for (final var surface : appearance.firstPersonModels) {
+            surface.model.pose(pose);
+            surface.model.visibility(visibility);
+        }
+        return new FirstPersonFrame(appearance.bodyId, visibility, camera,
+                nativeDrawing ? appearance.firstPersonModels : List.of(),
+                nativeDrawing ? BedrockFirstPersonActor.root(player.getEyeHeight(), player.getScale() / 16F,
+                        new org.joml.Vector3f(scale.x(), scale.y(), scale.z()), false,
+                        BedrockFirstPersonActor.global(player.deathTime, partialTick,
+                                nativeState == null ? "" : nativeState.name(), player.getBbHeight())) : null);
+    }
