diff --git a/native/persona-assets/src/remote.rs b/native/persona-assets/src/remote.rs
new file mode 100644
index 0000000..5e52f28
--- /dev/null
+++ b/native/persona-assets/src/remote.rs
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use msixvc::models::xvd::XvdHeader;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    future::Future,
+    io::{self, SeekFrom},
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::io::{AsyncRead, AsyncSeek, ReadBuf};
+
+const BLOCK: u64 = 65536;
+type Pending = Pin<Box<dyn Future<Output = io::Result<Vec<u8>>> + Send>>;
+
+pub struct Remote {
+    client: reqwest::Client,
+    url: String,
+    length: u64,
+    position: u64,
+    cache: BTreeMap<u64, Vec<u8>>,
+    pending: Option<(u64, Pending)>,
+    tree: Vec<u8>,
+    data_start: u64,
+    leaf_start: usize,
+}
+
+impl Remote {
+    pub async fn new(client: reqwest::Client, url: &str) -> io::Result<Self> {
+        validate_url(url)?;
+        let response = client
+            .get(url)
+            .header("Range", "bytes=0-4095")
+            .send()
+            .await
+            .map_err(io::Error::other)?;
+        if response.status() != 206 {
+            return Err(io::Error::other("The CDN does not support ranges"));
+        }
+        let range = response
+            .headers()
+            .get("Content-Range")
+            .and_then(|h| h.to_str().ok())
+            .ok_or_else(|| io::Error::other("Missing range"))?;
+        let length: u64 = range
+            .strip_prefix("bytes 0-4095/")
+            .ok_or_else(|| io::Error::other("Invalid range"))?
+            .parse()
+            .map_err(io::Error::other)?;
+        if !(4096..=16 * 1024 * 1024 * 1024).contains(&length) {
+            return Err(io::Error::other("Invalid package size"));
+        }
+        let mut remote = Self {
+            client,
+            url: url.into(),
+            length,
+            position: 0,
+            cache: BTreeMap::new(),
+            pending: None,
+            tree: Vec::new(),
+            data_start: 0,
+            leaf_start: 0,
+        };
+        let header = body(response, 4096).await?;
+        if header.len() != 4096 {
+            return Err(io::Error::other("Truncated header"));
+        }
+        // The first complete block is fetched on demand and pinned by the caller.
+        remote.cache.clear();
+        Ok(remote)
+    }
+
+    pub async fn authenticate(&mut self, header: &XvdHeader) -> io::Result<()> {
+        let layout = header.layout();
+        let tree = self
+            .bytes(layout.hash_tree.start.to_bytes().0, layout.hash_tree.len.0)
+            .await?;
+        let levels = [
+            layout.hash_tree_layout.level3,
+            layout.hash_tree_layout.level2,
+            layout.hash_tree_layout.level1,
+            layout.hash_tree_layout.level0,
+        ];
+        let mut parent = None;
+        for level in levels.into_iter().filter(|level| level.num_pages().0 != 0) {
+            let start = level.page_range.start.0 as usize * 4096;
+            for page in 0..level.num_pages().0 as usize {
+                let hash = Sha256::digest(&tree[start + page * 4096..start + (page + 1) * 4096]);
+                if let Some(parent_start) = parent {
+                    let entry = parent_start + page / 170 * 4096 + page % 170 * 24;
+                    if hash[..20] != tree[entry..entry + 20] {
+                        return Err(io::Error::other("Package hash tree mismatch"));
+                    }
+                } else if hash[..] != header.top_hash_block_hash {
+                    return Err(io::Error::other("Package root hash mismatch"));
+                }
+            }
+            parent = Some(start);
+        }
+        self.leaf_start = layout.hash_tree_layout.level0.page_range.start.0 as usize * 4096;
+        self.data_start = layout.user_data.start.to_bytes().0;
+        self.tree = tree;
+        Ok(())
+    }
+
+    pub fn verify_page(&self, offset: u64, page: &[u8]) -> io::Result<()> {
+        if self.tree.is_empty()
+            || offset < self.data_start
+            || page.len() != 4096
+            || !offset.is_multiple_of(4096)
+        {
+            return Err(io::Error::other("Invalid authenticated page"));
+        }
+        let page_number = ((offset - self.data_start) / 4096) as usize;
+        let entry = self.leaf_start + page_number / 170 * 4096 + page_number % 170 * 24;
+        let expected = self
+            .tree
+            .get(entry..entry + 20)
+            .ok_or_else(|| io::Error::other("Page exceeds hash tree"))?;
+        if Sha256::digest(page)[..20] != *expected {
+            return Err(io::Error::other(format!(
+                "Package page hash mismatch at {offset:#x}"
+            )));
+        }
+        Ok(())
+    }
+
+    pub async fn bytes(&self, offset: u64, length: u64) -> io::Result<Vec<u8>> {
+        fetch(
+            self.client.clone(),
+            self.url.clone(),
+            self.length,
+            offset,
+            length,
+        )
+        .await
+    }
+}
+
+pub fn validate_url(url: &str) -> io::Result<()> {
+    let url = reqwest::Url::parse(url).map_err(io::Error::other)?;
+    let host = url.host_str().unwrap_or_default();
+    let number = host
+        .strip_prefix("assets")
+        .and_then(|s| s.strip_suffix(".xboxlive.com"));
+    if !matches!(url.scheme(), "http" | "https")
+        || number.is_none_or(|s| s.is_empty() || !s.bytes().all(|b| b.is_ascii_digit()))
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.port().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+    {
+        return Err(io::Error::other("Invalid package CDN"));
+    }
+    Ok(())
+}
+
+async fn fetch(
+    client: reqwest::Client,
+    url: String,
+    size: u64,
+    start: u64,
+    length: u64,
+) -> io::Result<Vec<u8>> {
+    if length == 0 {
+        return Ok(Vec::new());
+    }
+    let end = start
+        .checked_add(length)
+        .filter(|end| *end <= size)
+        .ok_or_else(|| io::Error::other("Range exceeds package"))?
+        - 1;
+    if length > 64 * 1024 * 1024 {
+        return Err(io::Error::other("Range is too large"));
+    }
+    for _ in 0..3 {
+        let Ok(response) = client
+            .get(&url)
+            .header("Range", format!("bytes={start}-{end}"))
+            .send()
+            .await
+        else {
+            continue;
+        };
+        let expected = format!("bytes {start}-{end}/{size}");
+        if response.status() != 206
+            || response
+                .headers()
+                .get("Content-Range")
+                .and_then(|h| h.to_str().ok())
+                != Some(expected.as_str())
+        {
+            return Err(io::Error::other("Invalid CDN range response"));
+        }
+        match body(response, length).await {
+            Ok(bytes) => return Ok(bytes),
+            _ => continue,
+        }
+    }
+    Err(io::Error::other("Package download failed"))
+}
+
+async fn body(mut response: reqwest::Response, length: u64) -> io::Result<Vec<u8>> {
+    let mut output = Vec::with_capacity(length as usize);
+    while let Some(bytes) = response.chunk().await.map_err(io::Error::other)? {
+        if bytes.len() as u64 > length - output.len() as u64 {
+            return Err(io::Error::other("Oversized range response"));
+        }
+        output.extend_from_slice(&bytes);
+    }
+    if output.len() as u64 != length {
+        return Err(io::Error::other("Truncated range response"));
+    }
+    Ok(output)
+}
+
+impl AsyncRead for Remote {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buffer: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        if buffer.remaining() == 0 || this.position == this.length {
+            return Poll::Ready(Ok(()));
+        }
+        let block = this.position / BLOCK * BLOCK;
+        if !this.cache.contains_key(&block) {
+            if this.cache.len() >= 4096 {
+                return Poll::Ready(Err(io::Error::other("Package metadata is too large")));
+            }
+            if this
+                .pending
+                .as_ref()
+                .is_none_or(|(offset, _)| *offset != block)
+            {
+                this.pending = Some((
+                    block,
+                    Box::pin(fetch(
+                        this.client.clone(),
+                        this.url.clone(),
+                        this.length,
+                        block,
+                        BLOCK.min(this.length - block),
+                    )),
+                ));
+            }
+            match this.pending.as_mut().unwrap().1.as_mut().poll(cx) {
+                Poll::Pending => return Poll::Pending,
+                Poll::Ready(Err(err)) => {
+                    this.pending = None;
+                    return Poll::Ready(Err(err));
+                }
+                Poll::Ready(Ok(bytes)) => {
+                    this.cache.insert(block, bytes);
+                    this.pending = None;
+                }
+            }
+        }
+        let bytes = &this.cache[&block];
+        let offset = (this.position - block) as usize;
+        let count = buffer.remaining().min(bytes.len() - offset);
+        if !this.tree.is_empty() && this.position >= this.data_start {
+            let first = offset / 4096 * 4096;
+            let last = (offset + count).div_ceil(4096) * 4096;
+            for position in (first..last).step_by(4096) {
+                if let Err(error) =
+                    this.verify_page(block + position as u64, &bytes[position..position + 4096])
+                {
+                    return Poll::Ready(Err(error));
+                }
+            }
+        }
+        buffer.put_slice(&bytes[offset..offset + count]);
+        this.position += count as u64;
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncSeek for Remote {
+    fn start_seek(self: Pin<&mut Self>, position: SeekFrom) -> io::Result<()> {
+        let this = self.get_mut();
+        let next = match position {
+            SeekFrom::Start(p) => i128::from(p),
+            SeekFrom::Current(p) => i128::from(this.position) + i128::from(p),
+            SeekFrom::End(p) => i128::from(this.length) + i128::from(p),
+        };
+        if next < 0 || next > i128::from(this.length) {
+            return Err(io::Error::other("Invalid seek"));
+        }
+        this.position = next as u64;
+        Ok(())
+    }
+    fn poll_complete(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<u64>> {
+        Poll::Ready(Ok(self.position))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn limits_downloads_to_official_package_hosts() {
+        assert!(validate_url("http://assets1.xboxlive.com/title/package.msixvc").is_ok());
+        for url in [
+            "https://assets1.xboxlive.com.evil.com/a",
+            "http://user@assets1.xboxlive.com/a",
+            "file:///a",
+            "http://assets1.xboxlive.com:9000/a",
+        ] {
+            assert!(validate_url(url).is_err());
+        }
+    }
+}
