+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockFirstPersonActorTest {
+    @Test
+    void placesConvertedPixelsInCameraSpaceWithoutJavaHandTransforms() {
+        final var matrix = BedrockFirstPersonActor.root(.9F, 1F / 16F, new Vector3f(1), false, new Matrix4f());
+        final var pivot = matrix.transformPosition(new Vector3f(5F / 16F, 26F / 16F, 0));
+        assertEquals(5F / 16F, pivot.x);
+        assertEquals(1.5078125F - .9F - 26F / 16F, pivot.y, .000001F);
+        assertEquals(0, pivot.z);
+        final var near = matrix.transformPosition(new Vector3f(0, 0, 12F / 16F));
+        assertEquals(-12F / 16F, near.z);
+    }
+
+    @Test
+    void matchesVisibleGeometryAgainstTheLiveNativeHandMatrix() {
+        // Standing actor and posed bone matrices captured in Bedrock 1.26.51.1.
+        final var nativeRoot = new Matrix4f().scaling(-.0546875F, -.0546875F, .0546875F)
+                .setTranslation(0, -.30067408084869385F, 0);
+        final var convertedRoot = BedrockFirstPersonActor.root(1.6200100183486938F, 1F / 16F,
+                new Vector3f(.875F), false, new Matrix4f());
+        final var nativeBones = new Vector3f[]{new Vector3f(8, 15, 10), new Vector3f(1, 18, -1)};
+        final var origins = new float[]{-8, 4};
+        for (int bone = 0; bone < nativeBones.length; bone++) {
+            final var pivot = nativeBones[bone];
+            for (final float x : new float[]{origins[bone], origins[bone] + 4})
+                for (final float y : new float[]{-12, -8}) for (final float z : new float[]{16, 20}) {
+                    final var posedPixel = new Vector3f(x, y, z).add(pivot);
+                    final var nativePoint = nativeRoot.transformPosition(new Vector3f(posedPixel));
+                    final var convertedPoint = convertedRoot.transformPosition(new Vector3f(posedPixel).div(16F));
+                    // The Java camera faces the opposite X/Z basis from the native hand pass.
+                    assertEquals(-nativePoint.x, convertedPoint.x, .000001F);
+                    assertEquals(nativePoint.y, convertedPoint.y, .000001F);
+                    assertEquals(-nativePoint.z, convertedPoint.z, .000001F);
+                }
