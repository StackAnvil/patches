+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.blaze3d.audio.Channel;
+import com.mojang.blaze3d.audio.Library;
+import com.mojang.blaze3d.audio.SoundBuffer;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockChannelAccess;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockSoundEngine;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.sound.MixinBedrockChannel;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.sound.MixinBedrockSoundManager;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.sounds.AudioStream;
+import net.minecraft.client.sounds.ChannelAccess;
+import net.minecraft.client.sounds.SoundEngine;
+import net.minecraft.sounds.SoundSource;
+import net.raphimc.viabedrock.api.model.SoundPlaybackMessage;
+import net.raphimc.viabedrock.api.model.SoundListenerRange;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.SoundUpdate;
+import net.minecraft.world.phys.Vec3;
+import org.lwjgl.openal.AL;
+import org.lwjgl.openal.AL10;
+import org.lwjgl.openal.AL11;
+
+import javax.sound.sampled.AudioFormat;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.util.Arrays;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadLocalRandom;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Bedrock PCM channels in the client's existing audio device and listener. */
+public final class BedrockSoundPlayback {
+    private static final long MAX_ACTIVE_PCM_BYTES = 128L * 1024 * 1024;
+    private static final Map<String, SoundSource> CATEGORIES = Map.of(
+            "ambient", SoundSource.AMBIENT, "block", SoundSource.BLOCKS,
+            "hostile", SoundSource.HOSTILE, "neutral", SoundSource.NEUTRAL,
+            "player", SoundSource.PLAYERS, "record", SoundSource.RECORDS,
+            "weather", SoundSource.WEATHER, "music", SoundSource.MUSIC, "ui", SoundSource.MASTER);
+    private static final Map<SoundEngine, State> STATES = new ConcurrentHashMap<>();
+    private static final ExecutorService DECODER = Executors.newSingleThreadExecutor(
+            Thread.ofPlatform().daemon().name("Bedrock sound decoder").factory());
+
+    private BedrockSoundPlayback() {}
+
+    static void play(final BedrockResourceLibrary resources, final String event, final Vec3 position) {
+        // The native attached-sound backend snapshots position once and uses 2/1.
+        play(event, position, () -> resources.soundEvent(event, bound -> ThreadLocalRandom.current().nextInt(bound), 2, 1, false));
+    }
+
+    static void playLevel(final BedrockResourceLibrary resources, final String event, final Vec3 position) {
+        final var sound = resources.levelSound(event, ThreadLocalRandom.current());
+        if (sound == null) return;
+        final Minecraft minecraft = Minecraft.getInstance();
+        final SoundEngine engine = ((MixinBedrockSoundManager) minecraft.getSoundManager()).viaFabricPlusBedrock$engine();
+        final var listener = engine.getListenerTransform();
+        final Vec3 listenerPosition = listener.position();
+        final var source = new Position3f((float) position.x, (float) position.y, (float) position.z);
+        if (!SoundListenerRange.passes(source,
+                new Position3f((float) listenerPosition.x, (float) listenerPosition.y, (float) listenerPosition.z), sound.volume())) return;
+        BedrockSoundCaptions.accept(resources, sound, source, listener);
+        play(sound.name(), position, () -> resources.soundEvent(sound.name(),
+                bound -> ThreadLocalRandom.current().nextInt(bound), sound.volume(), sound.pitch(), false));
+    }
+
+    private static void play(final String event, final Vec3 position, final Resolver resolver) {
+        play(event, position, resolver, null);
+    }
+
+    private static void play(final String event, final Vec3 position, final Resolver resolver, final ServerRequest request) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        final SoundEngine engine = ((MixinBedrockSoundManager) minecraft.getSoundManager()).viaFabricPlusBedrock$engine();
+        final var access = (IBedrockSoundEngine) engine;
+        if (!access.viaFabricPlusBedrock$isLoaded()) return;
+        if (request != null) {
+            final Vec3 listener = engine.getListenerTransform().position();
+            if (!request.play.sound().passesListenerRange((float) listener.x, (float) listener.y, (float) listener.z)) return;
+            BedrockSoundCaptions.accept(request.play, engine.getListenerTransform());
+        }
+        final State state = STATES.computeIfAbsent(engine, _ -> new State());
+        if (state.abandoned) return;
+        if (request != null) {
+            request.musicGeneration = state.musicStops.get();
+            state.requests.add(request);
+            final Long id = request.play.sound().serverHandle();
+            if (id != null) {
+                final ServerRequest replaced = state.handles.put(id, request);
+                if (replaced != null) cancel(state, replaced);
+            }
+        }
+        if (state.pending.incrementAndGet() > 32) { state.pending.decrementAndGet(); cancel(state, request); return; }
+        final long generation = state.generation.get();
+        final long animationGeneration = state.animationGeneration.get();
+        DECODER.execute(() -> {
+            try {
+                if (!current(state, generation, animationGeneration, request)) return;
+                final var sound = resolver.resolve();
+                if (sound == null || request != null && request.musicGeneration != state.musicStops.get()
+                        && sound.event().category().equals("music")) { cancel(state, request); return; }
+                final int size = sound.audio().pcm().length;
+                // Reserve before queuing onto the client: decoded requests count toward the cap too.
+                if (state.bytes.addAndGet(size) > MAX_ACTIVE_PCM_BYTES) { state.bytes.addAndGet(-size); cancel(state, request); return; }
+                minecraft.execute(() -> {
+                    if (!current(state, generation, animationGeneration, request) || !access.viaFabricPlusBedrock$isLoaded()) {
+                        state.bytes.addAndGet(-size);
+                        return;
+                    }
+                    final ChannelAccess channels = access.viaFabricPlusBedrock$channels();
+                    channels.createHandle(sound.selection().sample().stream() ? Library.Pool.STREAMING : Library.Pool.STATIC)
+                            .whenComplete((handle, error) -> {
+                                if (error != null || handle == null) {
+                                    state.bytes.addAndGet(-size);
+                                    cancel(state, request);
+                                    if (error != null) ViaFabricPlusBedrock.impl().logger()
+                                            .warn("Could not allocate Bedrock animation sound channel", error);
+                                    return;
+                                }
+                                if (!current(state, generation, animationGeneration, request)) {
+                                    ((IBedrockChannelAccess) channels).viaFabricPlusBedrock$release(
+                                            handle, () -> state.bytes.addAndGet(-size));
+                                    return;
+                                }
+                                handle.execute(channel -> {
+                                    if (!current(state, generation, animationGeneration, request)) {
+                                        ((IBedrockChannelAccess) channels).viaFabricPlusBedrock$release(
+                                                handle, () -> state.bytes.addAndGet(-size));
+                                        return;
+                                    }
+                                    start(state, handle, channel, sound, position, access, request);
+                                });
+                            });
+                });
+            } catch (Exception error) {
+                cancel(state, request);
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock animation sound {}", event, error);
+            } finally {
+                state.pending.decrementAndGet();
+            }
+        });
+    }
+
+    public static void accept(final SoundPlaybackMessage message) {
+        if (message instanceof SoundPlaybackMessage.Play play) {
+            final var position = play.sound().positionEighths();
+            play(play.sound().name(), new Vec3(position.x() / 8D, position.y() / 8D, position.z() / 8D),
+                    () -> BedrockServerSounds.resolve(play), new ServerRequest(play));
+        } else if (message instanceof SoundPlaybackMessage.Update update) {
+            STATES.values().forEach(state -> {
+                final ServerRequest request = state.handles.get(update.handle());
+                if (request == null) return;
+                if (update.event() instanceof SoundUpdate.Stop) { cancel(state, request); return; }
+                synchronized (request) {
+                    if (request.cancelled) return;
+                    if (request.handle == null) {
+                        if (request.commands.size() >= 256) cancel(state, request);
+                        else request.commands.addLast(update.event());
+                    } else request.handle.execute(channel -> {
+                        if (!request.cancelled) apply(state, request, channel, update.event());
+                    });
+                }
+            });
+        } else if (message instanceof SoundPlaybackMessage.Stop stop) {
+            STATES.values().forEach(state -> {
+                if (stop.music()) state.musicStops.incrementAndGet();
+                state.requests.forEach(request -> {
+                    if (stop.all() || request.play.sound().name().equals(stop.name())
+                            || stop.music() && (request.play.category() == SoundSource.MUSIC.ordinal()
+                            || request.sound != null && request.sound.event().category().equals("music"))) cancel(state, request);
+                });
+            });
+        }
+    }
+
+    public static void stopServer() {
+        BedrockSoundCaptions.clear();
+        STATES.values().forEach(state -> state.requests.forEach(request -> cancel(state, request)));
+        BedrockServerResources.clear();
+    }
+
+    private static boolean current(final State state, final long generation, final long animationGeneration, final ServerRequest request) {
+        return state.generation.get() == generation && (request == null
+                ? state.animationGeneration.get() == animationGeneration : !request.cancelled);
+    }
+
+    private static void cancel(final State state, final ServerRequest request) {
+        if (request == null) return;
+        request.cancelled = true;
+        state.requests.remove(request);
+        if (request.play.sound().serverHandle() != null) state.handles.remove(request.play.sound().serverHandle(), request);
+        if (request.handle != null) request.handle.execute(Channel::stop);
+    }
+
+    private static void apply(final State state, final ServerRequest request, final Channel channel, final SoundUpdate.Event event) {
+        try {
+            if (event instanceof SoundUpdate.Volume volume) request.envelope.set(volume.volume());
+            else if (event instanceof SoundUpdate.Fade fade) request.envelope.fade(fade.duration(), fade.targetVolume(), System.nanoTime());
+            else if (event instanceof SoundUpdate.Pitch pitch) {
+                if (!Float.isFinite(pitch.pitch()) || pitch.pitch() <= 0) return;
+                channel.setPitch(pitch.pitch() * request.sound.selection().sample().pitch());
+            } else if (event instanceof SoundUpdate.Pause) {
+                request.paused = true;
+                channel.pause();
+            } else if (event instanceof SoundUpdate.Resume) {
+                request.paused = false;
+                if (!state.paused || state.pauseExceptions.contains(request.voice.category)) channel.unpause();
+            } else if (event instanceof SoundUpdate.Seek seek) {
+                if (!Float.isFinite(seek.seconds()) || seek.seconds() < 0) return;
+                final int loops = request.stream.remainingLoops(AL10.alGetSourcei(request.voice.source, AL11.AL_SAMPLE_OFFSET));
+                final var audio = request.sound.audio();
+                channel.stop();
+                ((MixinBedrockChannel) channel).viaFabricPlusBedrock$removeProcessedBuffers();
+                request.stream.close();
+                request.stream = new BedrockPcmStream(audio.pcm(), request.stream.getFormat(), loops, seek.seconds());
+                channel.attachBufferStream(request.stream);
+                channel.play();
+                if (request.paused || state.paused && !state.pauseExceptions.contains(request.voice.category)) channel.pause();
+            }
+            volume(channel, request.voice, (IBedrockSoundEngine) ((MixinBedrockSoundManager) Minecraft.getInstance().getSoundManager()).viaFabricPlusBedrock$engine());
+        } catch (RuntimeException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not apply server sound control", invalid);
+        }
+    }
+
+    private static final class ServerRequest {
+        private final SoundPlaybackMessage.Play play;
+        private final BedrockSoundEnvelope envelope;
+        private final java.util.ArrayDeque<SoundUpdate.Event> commands = new java.util.ArrayDeque<>();
+        private volatile boolean cancelled, paused;
+        private long musicGeneration;
+        private volatile ChannelAccess.ChannelHandle handle;
+        private volatile BedrockBuiltinAssets.Contents.ResolvedSound sound;
+        private Voice voice;
+        private BedrockPcmStream stream;
+
+        private ServerRequest(final SoundPlaybackMessage.Play play) {
+            this.play = play;
+            this.envelope = new BedrockSoundEnvelope(play.sound().volume());
+        }
+    }
+
+    @FunctionalInterface
+    private interface Resolver {
+        BedrockBuiltinAssets.Contents.ResolvedSound resolve() throws IOException;
+    }
+
+    private static void start(
+            final State state, final ChannelAccess.ChannelHandle handle, final Channel channel,
+            final BedrockBuiltinAssets.Contents.ResolvedSound sound, final Vec3 position,
+            final IBedrockSoundEngine engine, final ServerRequest request) {
+        final var audio = sound.audio();
+        final var selection = sound.selection();
+        final SoundSource category = sound.event().group(CATEGORIES, SoundSource.MASTER);
+        final AudioFormat format = new AudioFormat(audio.sampleRate(), 16, audio.channels(), true, false);
+        SoundBuffer buffer = null;
+        try {
+            if (request != null) {
+                request.stream = new BedrockPcmStream(audio.pcm(), format, request.play.sound().loopCount(),
+                        request.play.sound().playbackPosition() == null ? 0 : request.play.sound().playbackPosition());
+                channel.attachBufferStream(request.stream);
+            } else if (selection.sample().stream()) {
+                channel.attachBufferStream(new PcmStream(audio.pcm(), format));
+            } else {
+                final ByteBuffer pcm = ByteBuffer.allocateDirect(audio.pcm().length);
+                pcm.put(audio.pcm()).flip();
+                buffer = new SoundBuffer(pcm, format);
+                channel.attachStaticBuffer(buffer);
+            }
+            channel.setPitch(selection.pitch());
+            channel.setLooping(false);
+            channel.setRelative(!selection.positional());
+            channel.setSelfPosition(selection.positional() ? position : Vec3.ZERO);
+            final int source = ((MixinBedrockChannel) channel).viaFabricPlusBedrock$source();
+            if (selection.positional()) {
+                final var attenuation = sound.event().attenuation(BedrockSoundEvent.Rolloff.INVERSE);
+                AL10.alSourcei(source, AL10.AL_DISTANCE_MODEL,
+                        attenuation.rolloff() == BedrockSoundEvent.Rolloff.INVERSE
+                                ? AL10.AL_INVERSE_DISTANCE_CLAMPED : AL11.AL_LINEAR_DISTANCE_CLAMPED);
+                AL10.alSourcef(source, AL10.AL_REFERENCE_DISTANCE, attenuation.minimum());
+                AL10.alSourcef(source, AL10.AL_MAX_DISTANCE, attenuation.maximum());
+                AL10.alSourcef(source, AL10.AL_ROLLOFF_FACTOR, 1);
+            } else channel.disableAttenuation();
+            final Voice voice = new Voice(buffer, audio.pcm().length, category, selection.volume(), source, request);
+            state.voices.put(handle, voice);
+            channel.play();
+            if (request != null) {
+                synchronized (request) {
+                    request.voice = voice;
+                    request.sound = sound;
+                    request.handle = handle;
+                    if (request.cancelled) channel.stop();
+                    else while (!request.commands.isEmpty()) apply(state, request, channel, request.commands.removeFirst());
+                }
+            }
+            volume(channel, voice, engine);
+            if (state.paused && !state.pauseExceptions.contains(category) || request != null && request.paused) channel.pause();
+        } catch (RuntimeException error) {
+            state.voices.remove(handle);
+            cancel(state, request);
+            final SoundBuffer failedBuffer = buffer;
+            ((IBedrockChannelAccess) engine.viaFabricPlusBedrock$channels()).viaFabricPlusBedrock$release(handle, () -> {
+                if (failedBuffer != null) failedBuffer.discardAlBuffer();
+                state.bytes.addAndGet(-audio.pcm().length);
+            });
+            ViaFabricPlusBedrock.impl().logger().warn("Could not start Bedrock animation sound", error);
+        }
+    }
+
+    private static void volume(final Channel channel, final Voice voice, final IBedrockSoundEngine engine) {
+        final float raw = voice.request == null ? voice.volume
+                : voice.request.envelope.volume(System.nanoTime()) * voice.request.sound.selection().sample().volume();
+        final float gain = raw * engine.viaFabricPlusBedrock$categoryGain(1, voice.category);
+        AL10.alSourcef(voice.source, AL10.AL_MAX_GAIN,
+                AL.getCapabilities().AL_SOFT_gain_clamp_ex ? Math.max(1, gain) : 1);
+        channel.setVolume(gain);
+    }
+
+    public static void tick(final SoundEngine engine) {
+        final State state = STATES.get(engine);
+        if (state == null) return;
+        final var access = (IBedrockSoundEngine) engine;
+        state.voices.forEach((handle, voice) -> {
+            if (handle.isStopped()) {
+                if (state.voices.remove(handle, voice)) {
+                    if (voice.buffer != null) voice.buffer.discardAlBuffer();
+                    state.bytes.addAndGet(-voice.bytes);
+                    cancel(state, voice.request);
+                }
+            } else handle.execute(channel -> volume(channel, voice, access));
+        });
+    }
+
+    /** Called after vanilla releases every channel, while its OpenAL context still exists. */
+    public static void cleared(final SoundEngine engine) {
+        final State state = STATES.remove(engine);
+        if (state == null) return;
+        state.generation.incrementAndGet();
+        state.requests.forEach(request -> cancel(state, request));
+        BedrockServerResources.clear();
+        state.voices.values().forEach(voice -> { if (voice.buffer != null) voice.buffer.discardAlBuffer(); });
+        state.voices.clear();
+    }
+
+    /** The emergency path has already destroyed the audio context; do not call OpenAL. */
+    public static void abandoned(final SoundEngine engine) {
+        final State state = STATES.computeIfAbsent(engine, _ -> new State());
+        state.abandoned = true;
+        state.generation.incrementAndGet();
+        state.requests.forEach(request -> request.cancelled = true);
+        state.requests.clear();
+        state.handles.clear();
+        BedrockServerResources.clear();
+        state.voices.clear();
+    }
+
+    public static void stop() {
+        STATES.values().forEach(state -> {
+            state.animationGeneration.incrementAndGet();
+            state.voices.forEach((handle, voice) -> { if (voice.request == null) handle.execute(Channel::stop); });
+        });
+    }
+
+    public static void pause(final SoundEngine engine, final SoundSource[] exceptions) {
+        final State state = STATES.computeIfAbsent(engine, _ -> new State());
+        state.paused = true;
+        state.pauseExceptions = Set.copyOf(Arrays.asList(exceptions));
+        state.voices.forEach((handle, voice) -> {
+            if (!state.pauseExceptions.contains(voice.category)) handle.execute(Channel::pause);
+        });
+    }
+
+    public static void resume(final SoundEngine engine) {
+        final State state = STATES.get(engine);
+        if (state != null) { state.paused = false; state.pauseExceptions = Set.of(); }
+        // Vanilla resumes all channels; restore restrictions from independent server pause commands.
+        if (state != null) state.requests.forEach(request -> {
+            if (request.paused && request.handle != null) request.handle.execute(Channel::pause);
+        });
+    }
+
+    private static final class State {
+        private final AtomicLong generation = new AtomicLong(), animationGeneration = new AtomicLong(), musicStops = new AtomicLong(), bytes = new AtomicLong();
+        private final Set<ServerRequest> requests = ConcurrentHashMap.newKeySet();
+        private final Map<Long, ServerRequest> handles = new ConcurrentHashMap<>();
+        private final AtomicInteger pending = new AtomicInteger();
+        private final Map<ChannelAccess.ChannelHandle, Voice> voices = new ConcurrentHashMap<>();
+        private volatile boolean paused, abandoned;
+        private volatile Set<SoundSource> pauseExceptions = Set.of();
+    }
+
+    private record Voice(SoundBuffer buffer, int bytes, SoundSource category, float volume, int source, ServerRequest request) {}
+
+    private static final class PcmStream implements AudioStream {
+        private final AudioFormat format;
+        private byte[] pcm;
+        private int cursor;
+
+        private PcmStream(final byte[] pcm, final AudioFormat format) { this.pcm = pcm; this.format = format; }
+        @Override public AudioFormat getFormat() { return this.format; }
+        @Override public ByteBuffer read(final int requested) {
+            if (requested < 0) throw new IllegalArgumentException("Negative PCM buffer size");
+            final int frames = requested / this.format.getFrameSize();
+            final int count = this.pcm == null ? 0
+                    : Math.min(frames * this.format.getFrameSize(), this.pcm.length - this.cursor);
+            final ByteBuffer bytes = ByteBuffer.allocateDirect(count);
+            if (count > 0) { bytes.put(this.pcm, this.cursor, count); this.cursor += count; }
+            return bytes.flip();
+        }
+        @Override public void close() { this.pcm = null; }
+    }
+}
