+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import net.raphimc.minecraftauth.msa.model.MsaToken;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockStoreBrowserTest {
+    @Test
+    void cancellingAuthenticationDoesNotInterruptPackPreparation() throws Exception {
+        final var started = new CompletableFuture<Void>();
+        final var stopped = new CompletableFuture<Void>();
+        final var session = new BedrockStoreBrowser.Session(() -> {
+            started.complete(null);
+            try {
+                new CompletableFuture<Void>().get();
+                throw new AssertionError();
+            } finally {
+                stopped.complete(null);
+            }
+        });
+        try {
+            started.get(5, TimeUnit.SECONDS);
+            session.cancel();
+            assertThrows(BedrockStoreBrowser.SignInCancelledException.class, session::await);
+            assertFalse(Thread.currentThread().isInterrupted());
+            stopped.get(5, TimeUnit.SECONDS);
+        } finally {
+            session.cancel();
+        }
+    }
+
+    @Test
+    void closingAfterCompletionPreservesTheAuthenticatedToken() throws Exception {
+        final var token = new MsaToken(Long.MAX_VALUE, UUID.randomUUID().toString(), UUID.randomUUID().toString());
+        final var session = new BedrockStoreBrowser.Session(() -> token);
+        assertSame(token, session.await());
+        session.cancel();
+        assertSame(token, session.await());
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockStoreSignInTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockStoreSignInTest.java
