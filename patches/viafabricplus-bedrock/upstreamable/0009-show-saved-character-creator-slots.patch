+
+    private boolean compactCategories() {
+        return this.contentTop() + 52 + Category.values().length * 19 > this.height - FOOTER_HEIGHT;
+    }
+
+    private int limbControlsTop() {
+        return Math.min(this.contentTop() + 250, this.height - FOOTER_HEIGHT - 32);
+    }
+
+    private int wardrobeLeft() {
+        return Math.max(12, (this.width - 1000) / 2);
+    }
