+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockControllerAnimationTest {
+    private static final BedrockActorAnimation.Frame FRAME =
+            new BedrockActorAnimation.Frame(Map.of(), Map.of());
+
+    private static JsonObject json(final String source) {
+        return JsonParser.parseString(source).getAsJsonObject();
+    }
+
+    private static BedrockActorAnimation graph(final String states, final String animations)
+            throws IOException {
+        return BedrockActorAnimation.read(
+                json(
+                        """
+                        {"animations":{"root":"controller.animation.root","a":"animation.a","b":"animation.b","c":"animation.c"},
+                         "scripts":{"animate":["root"]}}
+                        """),
+                Map.of(),
+                json(animations),
+                json("{\"controller.animation.root\":{\"states\":" + states + "}}"),
+                "1.18.10");
+    }
+
+    @Test
+    void readsPreviousCompletionResetsOnReentryAndFreezesZeroWeightTracks() throws IOException {
+        final var actor =
+                graph(
+                                """
+                                {"default":{"animations":["a",{"b":"q.enabled"}],"transitions":[{"done":"q.all_animations_finished"}]},
+                                 "done":{"animations":["c"],"transitions":[{"default":"q.restart"}]}}
+                                """,
+                                """
+                                {"animation.a":{"animation_length":0.25,"loop":true,"bones":{"a":{"position":[1,0,0]}}},
+                                 "animation.b":{"animation_length":0.5,"loop":"hold_on_last_frame","bones":{"b":{"position":[2,0,0]}}},
+                                 "animation.c":{"loop":true,"bones":{"c":{"position":[3,"q.state_time",0]}}}}
+                                """)
+                        .playback();
+        final var enabled = new BedrockActorAnimation.Frame(Map.of("enabled", 1F), Map.of());
+        assertTrue(actor.sample(0, FRAME).containsKey("a"));
+        assertTrue(actor.sample(0.5F, FRAME).containsKey("a"));
+        assertTrue(actor.sample(0.75F, enabled).containsKey("b"));
+        assertTrue(actor.sample(1, enabled).containsKey("a"));
+        final var done = actor.sample(1.25F, enabled);
+        assertFalse(done.containsKey("a"));
+        assertEquals(1.25F, done.get("c").position().y());
+        assertEquals(0.25F, actor.sample(1.5F, enabled).get("c").position().y());
+        final var restart =
+                new BedrockActorAnimation.Frame(Map.of("enabled", 1F, "restart", 1F), Map.of());
+        assertTrue(actor.sample(1.75F, restart).containsKey("a"));
+        assertTrue(actor.sample(2, enabled).containsKey("a"));
+        assertTrue(actor.sample(2.25F, enabled).containsKey("c"));
+        assertTrue(actor.sample(0, enabled).containsKey("a"));
+    }
+
+    @Test
+    void handlesEmptyCompletionInitialEntryAndDuplicateRenderPasses() throws IOException {
+        final var actor =
+                graph(
+                                """
+                                {"default":{"on_entry":["v.entries=(v.entries??0)+1;"],"transitions":[{"done":"q.all_animations_finished && !q.any_animation_finished"}]},
+                                 "done":{"animations":["a"]}}
+                                """,
+                                """
+                                {"animation.a":{"loop":true,"bones":{"head":{"position":["v.entries","q.state_time",0]}}}}
+                                """)
+                        .playback();
+        assertTrue(actor.sample(0, FRAME).isEmpty());
+        assertTrue(actor.sample(0, FRAME).isEmpty());
+        final var transitioned = actor.sample(0.25F, FRAME);
+        assertEquals(
+                new BedrockBoneAnimation.Vector(1, 0.25F, 0), transitioned.get("head").position());
+        assertSame(transitioned, actor.sample(0.25F, FRAME));
+        assertEquals(0.25F, actor.sample(0.5F, FRAME).get("head").position().y());
+        assertTrue(actor.sample(0, FRAME).isEmpty());
+    }
+
+    @Test
+    void keepsBothStatesAdvancingAndUsesNativeWeightsDuringCrossfades() throws IOException {
+        final var graph =
+                graph(
+                        """
+                        {"default":{"animations":["a"],"blend_transition":1,"transitions":[{"next":"q.state_time>=0.5"}]},
+                         "next":{"animations":["b"]}}
+                        """,
+                        """
+                        {"animation.a":{"animation_length":5,"bones":{"head":{"rotation":[0,0,0],"position":["q.anim_time",0,0],"scale":[2,1,1]}}},
+                         "animation.b":{"animation_length":5,"bones":{"head":{"rotation":[100,0,0],"position":[0,"q.anim_time",0],"scale":[4,1,1]}}}}
+                        """);
+        final var actor = graph.playback();
+        actor.sample(0, FRAME);
+        actor.sample(0.25F, FRAME);
+        var pose = actor.sample(0.5F, FRAME).get("head");
+        assertEquals(25, pose.rotation().x());
+        assertEquals(new BedrockBoneAnimation.Vector(0.375F, 0.0625F, 0), pose.position());
+        assertEquals(3.0625F, pose.scale().x());
+        pose = actor.sample(0.75F, FRAME).get("head");
+        assertEquals(50, pose.rotation().x());
+        assertEquals(new BedrockBoneAnimation.Vector(0.375F, 0.25F, 0), pose.position());
+        assertEquals(100, actor.sample(1.25F, FRAME).get("head").rotation().x());
+    }
+
+    @Test
+    void blendsShortestEulerPathsAndMissingBonesIntoExistingPose() throws IOException {
+        final var actor =
+                graph(
+                                """
+                                {"default":{"animations":["a"],"blend_transition":1,"blend_via_shortest_path":true,"transitions":[{"next":"q.state_time>=0.5"}]},
+                                 "next":{"animations":["b"]}}
+                                """,
+                                """
+                                {"animation.a":{"animation_length":5,"bones":{"head":{"rotation":[170,0,0],"scale":[2,1,1]},"old":{"position":[4,0,0]}}},
+                                 "animation.b":{"animation_length":5,"bones":{"head":{"rotation":[-170,0,0],"scale":[4,1,1]},"new":{"position":[0,4,0]}}}}
+                                """)
+                        .playback();
+        actor.sample(0, FRAME);
+        actor.sample(0.25F, FRAME);
+        final var pose = actor.sample(0.75F, FRAME);
+        assertEquals(180, pose.get("head").rotation().x());
+        assertEquals(3, pose.get("head").scale().x());
+        assertEquals(2, pose.get("old").position().x());
+        assertEquals(2, pose.get("new").position().y());
+    }
+
+    @Test
+    void completionOfNestedControllerUsesCurrentStateAndClearsQueryBindingAfterItsUpdate()
+            throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"root":"controller.animation.root","child":"controller.animation.child","a":"animation.a","b":"animation.b"},
+                                 "scripts":{"animate":["root","b"]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.a":{"animation_length":0.25,"loop":"hold_on_last_frame","bones":{"a":{"position":[1,0,0]}}},
+                                 "animation.b":{"loop":true,"bones":{"b":{"position":["q.state_time","q.all_animations_finished",0]}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"states":{"default":{"animations":["child","b"],"transitions":[{"done":"q.any_animation_finished"}]},"done":{"animations":["a"]}}},
+                                 "controller.animation.child":{"states":{"default":{"animations":["a"]}}}}
+                                """),
+                        "1.18.10");
+        final var actor = graph.playback();
+        actor.sample(0, FRAME);
+        final var before = actor.sample(0.25F, FRAME);
+        assertTrue(before.containsKey("a"));
+        assertEquals(new BedrockBoneAnimation.Vector(0, 0, 0), before.get("b").position());
+        assertEquals(1, actor.sample(0.5F, FRAME).get("a").position().x());
+    }
+
+    @Test
+    void resetsSelfTransitionsWithoutRepeatingEntryOrExitScripts() throws IOException {
+        final var actor =
+                graph(
+                                """
+                                {"default":{"on_entry":["v.entries=(v.entries??0)+1;"],"on_exit":["v.exits=(v.exits??0)+1;"],
+                                 "animations":["a"],"transitions":[{"default":"q.restart"}]}}
+                                """,
+                                """
+                                {"animation.a":{"animation_length":5,"bones":{"head":{"position":["q.anim_time","v.entries","v.exits??0"]}}}}
+                                """)
+                        .playback();
+        actor.sample(0, FRAME);
+        actor.sample(0.25F, FRAME);
+        final var restart = new BedrockActorAnimation.Frame(Map.of("restart", 1F), Map.of());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(0.25F, 1, 0),
+                actor.sample(0.5F, restart).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(0.25F, 1, 0),
+                actor.sample(0.75F, restart).get("head").position());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_CONTROLLER_RESULT", matches = ".+")
+    void matchesNativeVersionDependentInitialTransitions() throws IOException {
+        final var results =
+                json(
+                        Files.readString(
+                                Path.of(System.getenv("STACKANVIL_ANIMATION_CONTROLLER_RESULT"))));
+        for (final var element : results.getAsJsonArray("versions")) {
+            final var entry = element.getAsJsonObject();
+            final var actor =
+                    BedrockActorAnimation.read(
+                                    json(
+                                            """
+                                            {"animations":{"root":"controller.animation.root","a":"animation.a"},"scripts":{"animate":["root"]}}
+                                            """),
+                                    Map.of(),
+                                    json(
+                                            """
+                                            {"animation.a":{"loop":true,"bones":{"head":{"position":["v.initial??0","v.exit??0","v.entered??0"]}}}}
+                                            """),
+                                    json(
+                                            """
+                                            {"controller.animation.root":{"states":{
+                                               "default":{"on_entry":["v.initial=1;"],"on_exit":["v.exit=1;"],"transitions":[{"next":"q.all_animations_finished"}]},
+                                               "next":{"on_entry":["v.entered=1;"],"animations":["a"]}}}}
+                                            """),
+                                    entry.get("version").getAsString())
+                            .playback();
+            final boolean deferred = entry.get("deferred").getAsBoolean();
+            final var first = actor.sample(0, FRAME);
+            assertEquals(deferred, first.isEmpty(), entry.get("version").getAsString());
+            final var pose = actor.sample(0.25F, FRAME).get("head");
+            assertEquals(
+                    new BedrockBoneAnimation.Vector(deferred ? 1 : 0, deferred ? 1 : 0, 1),
+                    pose.position());
+        }
+    }
+
+    @Test
+    void rejectsInvalidBlendDurations() {
+        for (final String value : List.of("-1", "601", "\"nan\"", "{}"))
+            assertThrows(
+                    IOException.class,
+                    () -> graph("{\"default\":{\"blend_transition\":" + value + "}}", "{}"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_CONTROLLER_RESULT", matches = ".+")
+    void matchesIndependentNativeControllerUpdates() throws IOException {
+        final var results =
+                json(
+                        Files.readString(
+                                Path.of(System.getenv("STACKANVIL_ANIMATION_CONTROLLER_RESULT"))));
+        for (final String name :
+                List.of("any", "all", "time", "blend_1", "blend_0.25", "blend_0", "blend_jump")) {
+            final var result = results.getAsJsonObject(name);
+            final var config = result.getAsJsonObject("config");
+            final var lengths = config.getAsJsonArray("lengths");
+            final JsonObject entity =
+                    json(
+                            "{\"animations\":{\"root\":\"controller.animation.root\"},\"scripts\":{\"animate\":[{\"root\":\"q.weight\"}]}}");
+            final JsonObject animations = new JsonObject(), states = new JsonObject();
+            for (int index = 0; index < lengths.size(); index++) {
+                entity.getAsJsonObject("animations")
+                        .addProperty("a" + index, "animation.a" + index);
+                animations.add(
+                        "animation.a" + index,
+                        json(
+                                "{\"animation_length\":"
+                                        + lengths.get(index)
+                                        + ",\"loop\":\"hold_on_last_frame\",\"bones\":{\"bone"
+                                        + index
+                                        + "\":{\"rotation\":[\"q.state_time\",0,0],\"position\":[1,\"q.anim_time\",0]}}}"));
+            }
+            for (int index = 0; index < 2; index++) {
+                final JsonObject state = new JsonObject();
+                final JsonArray refs = new JsonArray();
+                for (final var child :
+                        config.getAsJsonArray("children").get(index).getAsJsonArray())
+                    refs.add("a" + child.getAsInt());
+                state.add("animations", refs);
+                if (index == 0) {
+                    state.add(
+                            "transitions",
+                            json("{\"values\":[{\"next\":\""
+                                            + (name.startsWith("blend") || name.equals("time")
+                                                    ? "q.state_time>=0.5"
+                                                    : name.equals("any")
+                                                            ? "q.any_animation_finished"
+                                                            : "q.all_animations_finished")
+                                            + "\"}]}")
+                                    .get("values"));
+                    if (config.has("curve")) state.addProperty("blend_transition", 1);
+                }
+                states.add(index == 0 ? "default" : "next", state);
+            }
+            final JsonObject controller = new JsonObject(), definition = new JsonObject();
+            definition.add("states", states);
+            controller.add("controller.animation.root", definition);
+            final var actor =
+                    BedrockActorAnimation.read(entity, Map.of(), animations, controller, "1.18.10")
+                            .playback();
+            float time = 0;
+            for (final var element : result.getAsJsonArray("steps")) {
+                final var step = element.getAsJsonObject();
+                time += step.get("delta").getAsFloat();
+                final var pose =
+                        actor.sample(
+                                time,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("weight", step.get("weight").getAsFloat()),
+                                        Map.of()));
+                assertEquals(
+                        step.getAsJsonArray("updates").size(), pose.size(), name + " at " + time);
+                for (final var update : step.getAsJsonArray("updates")) {
+                    final var child = update.getAsJsonObject();
+                    final int index = child.get("child").getAsInt();
+                    final float weight = child.get("weight").getAsFloat();
+                    final var transform = pose.get("bone" + index);
+                    assertEquals(weight, transform.position().x(), 1E-5, name);
+                    assertEquals(
+                            weight
+                                    * Math.min(
+                                            lengths.get(index).getAsFloat(),
+                                            child.get("clock").getAsFloat()),
+                            transform.position().y(),
+                            1E-5,
+                            name);
+                    assertEquals(
+                            weight * child.get("state_time").getAsFloat(),
+                            transform.rotation().x(),
+                            1E-5,
+                            name);
+                }
+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_SHORTEST_RESULT", matches = ".+")
+    void matchesIndependentNativeShortestPathComposition() throws IOException {
+        for (final var element :
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(
+                                                System.getenv(
+                                                        "STACKANVIL_ANIMATION_SHORTEST_RESULT"))))
+                        .getAsJsonArray()) {
+            final var entry = element.getAsJsonObject();
+            final Map<String, BedrockBoneAnimation.Transform> pose = new LinkedHashMap<>();
+            pose.put(
+                    "head",
+                    transform(
+                            new float[] {2, 0, 0}, new float[] {10, 0, 0}, new float[] {2, 1, 1}));
+            BedrockBoneAnimation.blendStates(
+                    pose,
+                    Map.of(
+                            "head",
+                            transform(
+                                    new float[] {1, 2, 3},
+                                    vector(entry.getAsJsonArray("before")),
+                                    new float[] {2, 3, 4})),
+                    Map.of(
+                            "head",
+                            transform(
+                                    new float[] {5, 6, 7},
+                                    vector(entry.getAsJsonArray("after")),
+                                    new float[] {4, 5, 6})),
+                    entry.get("weight").getAsFloat());
+            assertEquals(
+                    transform(
+                            vector(entry.getAsJsonArray("position")),
+                            vector(entry.getAsJsonArray("rotation")),
+                            vector(entry.getAsJsonArray("scale"))),
+                    pose.get("head"));
+        }
+    }
+
+    private static float[] vector(final JsonArray array) {
+        return new float[] {
+            array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat()
+        };
+    }
+
+    private static BedrockBoneAnimation.Transform transform(
+            final float[] position, final float[] rotation, final float[] scale) {
+        return new BedrockBoneAnimation.Transform(
+                new BedrockBoneAnimation.Vector(position[0], position[1], position[2]),
+                new BedrockBoneAnimation.Vector(rotation[0], rotation[1], rotation[2]),
+                new BedrockBoneAnimation.Vector(scale[0], scale[1], scale[2]),
+                false);
+    }
+}
