+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Particle declarations in stable timeline or controller entry order. */
+public record BedrockAnimationParticle(float time, String effect, String locator, boolean attached,
+                                      BedrockMolang.Program initialization) {
+    public static final class Cue {
+        final BedrockAnimationParticle declaration;
+        final BedrockMolang environment;
+        Cue(final BedrockAnimationParticle declaration, final BedrockMolang environment) {
+            this.declaration = declaration;
+            this.environment = environment;
+        }
+        public BedrockAnimationParticle declaration() { return this.declaration; }
+    }
+
+    static List<BedrockAnimationParticle> timeline(final JsonElement declared) throws IOException {
+        if (declared == null) return List.of();
+        if (!declared.isJsonObject() || declared.getAsJsonObject().size() > 4096)
+            throw new IOException("Invalid animation particle timeline");
+        final List<BedrockAnimationParticle> result = new ArrayList<>();
+        try {
+            for (final var entry : declared.getAsJsonObject().entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 600) throw new IOException("Invalid particle event time");
+                if (entry.getValue().isJsonArray()) {
+                    for (final var value : entry.getValue().getAsJsonArray()) add(result, time, value);
+                } else add(result, time, entry.getValue());
+            }
+            result.sort(Comparator.comparingDouble(BedrockAnimationParticle::time));
+            return List.copyOf(result);
+        } catch (RuntimeException invalid) { throw new IOException("Invalid animation particle declaration", invalid); }
+    }
+
+    static List<BedrockAnimationParticle> entries(final JsonElement declared) throws IOException {
+        if (declared == null) return List.of();
+        if (!declared.isJsonArray() || declared.getAsJsonArray().size() > 4096)
+            throw new IOException("Invalid controller particle list");
+        final List<BedrockAnimationParticle> result = new ArrayList<>();
+        try {
+            for (final var value : declared.getAsJsonArray()) add(result, 0, value);
+            return List.copyOf(result);
+        } catch (RuntimeException invalid) { throw new IOException("Invalid controller particle declaration", invalid); }
+    }
+
+    private static void add(final List<BedrockAnimationParticle> result, final float time, final JsonElement value) throws IOException {
+        if (!value.isJsonObject() || result.size() >= 4096) throw new IOException("Invalid animation particle entry");
+        final var object = value.getAsJsonObject();
+        result.add(new BedrockAnimationParticle(time, name(object.get("effect")), name(object.get("locator")),
+                !object.has("bind_to_actor") || object.get("bind_to_actor").getAsBoolean(),
+                BedrockMolang.Program.parse(object.get("pre_effect_script"), 0)));
+    }
+
+    private static String name(final JsonElement value) throws IOException {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) return "";
+        final String name = value.getAsString();
+        if (name.length() > 512 || name.indexOf('\0') >= 0) throw new IOException("Invalid particle event name");
+        return name;
+    }
+}
