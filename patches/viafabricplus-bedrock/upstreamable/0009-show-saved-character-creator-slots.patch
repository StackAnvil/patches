+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleLifetimeTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeLifetimeAndEmissionSchedules() throws Exception {
+        final var cases = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-lifetime-result.json"))).getAsJsonObject().getAsJsonArray("cases");
+        int updates = 0;
+        for (final var entry : cases) {
+            final var row = entry.getAsJsonObject();
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            components.remove("minecraft:emitter_lifetime_once");
+            final var lifetime = new JsonObject();
+            final boolean expression = row.get("kind").getAsString().equals("expression");
+            lifetime.add(expression ? "activation_expression" : "active_time", row.get("first"));
+            lifetime.add(expression ? "expiration_expression" : "sleep_time", row.get("second"));
+            components.add("minecraft:emitter_lifetime_" + row.get("kind").getAsString(), lifetime);
+            if (row.has("duration")) {
+                final var duration = new JsonObject();
+                duration.add("active_time", row.get("duration"));
+                if (row.has("pause")) duration.add("sleep_time", row.get("pause"));
+                components.add("minecraft:emitter_lifetime_" + (row.has("duration_kind")
+                        ? row.get("duration_kind").getAsString() : "once"), duration);
+            }
+            final var initialization = new JsonObject();
+            initialization.addProperty("creation_expression", "v.creations=v.creations+1;");
+            components.add("minecraft:emitter_initialization", initialization);
+            components.add("minecraft:particle_lifetime_expression", JsonParser.parseString("{\"max_lifetime\":0}"));
+            if (row.get("rate").getAsString().equals("steady")) {
+                components.remove("minecraft:emitter_rate_instant");
+                components.add("minecraft:emitter_rate_steady", JsonParser.parseString("{\"spawn_rate\":20,\"max_particles\":50}"));
+            } else components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 3);
+            final var environment = new BedrockMolang();
+            // The native probe supplies the creation callback and its zero initial counter.
+            environment.variable("creations", 0);
+            final int[] births = {0};
+            environment.queries(java.util.Map.of("birth", (BedrockActorAnimation.Query) _ -> ++births[0]), 0, 0, 0);
+            components.add("minecraft:particle_initialization", JsonParser.parseString("{\"creation_expression\":\"q.birth();\"}"));
+            final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1), Vec3.ZERO);
+            int creations = 1;
+            for (final var step : row.getAsJsonArray("steps")) {
+                final var expected = step.getAsJsonObject();
+                final String context = row.get("kind") + "/" + row.get("rate") + "/" + row.get("first") + "/" + updates++;
+                births[0] = 0;
+                emitter.advance(BedrockParticleInterpolation.elapsed(expected.get("nanos").getAsLong()), 1000,
+                        row.get("actor").getAsBoolean() ? new BedrockParticleAttachment(Vec3.ZERO, 180, null, new AABB(0, 0, 0, 1, 2, 1), java.util.Map.of()) : null, (x, y, z) -> List.of());
+                creations += expected.get("resets").getAsInt();
+                assertEquals(expected.get("births").getAsInt(), births[0], context);
+                assertEquals(0, emitter.size(), context);
+                assertEquals(creations, value(environment, "creations"), context);
+                assertEquals((float) expected.get("context_age").getAsLong() / 1_000_000_000F, value(environment, "emitter_age"), context);
+                assertEquals(!expected.get("expired").getAsBoolean() || emitter.size() > 0, emitter.alive(), context);
+            }
+        }
+        assertEquals(416, updates);
+    }
+
+    @Test
+    void defaultsMissingActiveTimeToZeroInBothDurationComponents() throws Exception {
+        for (final String kind : List.of("once", "looping")) {
+            final var components = new JsonObject();
+            components.add("minecraft:emitter_lifetime_" + kind, new JsonObject());
+            final var environment = new BedrockMolang();
+            final var clock = BedrockParticleLifetime.read(components).clock(environment);
+            final int[] restarts = {0};
+            final var first = clock.advance(50_000_000, true, true, environment, () -> {}, () -> restarts[0]++, () -> {});
+            assertEquals(0, first.lifetime());
+            assertTrue(first.emitting());
+            assertEquals(1, restarts[0]);
+            assertEquals(kind.equals("once"), clock.expired());
+        }
+    }
+
+    @Test
+    void evaluatesActivationBeforeUpdateAndExpirationAfterUpdate() throws Exception {
+        final var components = new JsonObject();
+        components.add("minecraft:emitter_lifetime_expression", JsonParser.parseString("""
+                {"activation_expression":"v.on", "expiration_expression":"v.stop"}
+                """));
+        final var environment = new BedrockMolang();
+        final var clock = BedrockParticleLifetime.read(components).clock(environment);
+        environment.variable("on", 0);
+        final var first = clock.advance(50_000_000, true, true, environment, () -> environment.variable("on", 1), () -> fail(), () -> {});
+        assertFalse(first.emitting());
+        assertFalse(clock.expired());
+        final var second = clock.advance(50_000_000, true, true, environment, () -> environment.variable("stop", 1), () -> fail(), () -> {});
+        assertFalse(second.emitting());
+        assertTrue(clock.expired());
+    }
+
+    @Test
+    void reevaluatesLoopTimesBeforeCreationAndRetainsPreResetMolangAge() throws Exception {
+        final var components = new JsonObject();
+        components.add("minecraft:emitter_lifetime_looping", JsonParser.parseString("""
+                {"active_time":"v.duration", "sleep_time":"v.pause"}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("duration", .05F);
+        final var clock = BedrockParticleLifetime.read(components).clock(environment);
+        final int[] creations = {0};
+        final var frame = clock.advance(100_000_000, true, true, environment,
+                () -> { environment.variable("duration", .1F); environment.variable("pause", .05F); },
+                () -> { creations[0]++; assertEquals(.1F, assertDoesNotThrow(() -> value(environment, "emitter_age"))); }, () -> {});
+        assertTrue(frame.emitting());
+        assertEquals(1, creations[0]);
+        final var next = clock.advance(50_000_000, true, true, environment, () -> {}, () -> fail(), () -> {});
+        assertEquals(.05F, next.age());
+        assertEquals(.1F, next.lifetime());
+        assertTrue(next.emitting());
+        assertEquals(.05F, value(environment, "emitter_age"));
+    }
+
+    @Test
+    void drainsParticlesAfterExpiryAndExpiresWhenItsActorDisappears() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.remove("minecraft:emitter_lifetime_once");
+        components.add("minecraft:emitter_lifetime_expression", new JsonObject());
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        emitter.advance(0, 10, new BedrockParticleAttachment(Vec3.ZERO, 180, null, new AABB(0, 0, 0, 1, 2, 1), java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        emitter.advance(50_000_000, 10, null, (x, y, z) -> List.of());
+        assertTrue(emitter.alive());
+        for (int index = 0; index < 11; index++) emitter.advance(100_000_000, 10, null, (x, y, z) -> List.of());
+        assertEquals(0, emitter.size());
+        assertFalse(emitter.alive());
+    }
+
+    private static float value(final BedrockMolang environment, final String variable) throws Exception {
+        return environment.evaluate(BedrockMolang.Program.parse(JsonParser.parseString("\"v." + variable + "\""), 0), 0);
+    }
+}
