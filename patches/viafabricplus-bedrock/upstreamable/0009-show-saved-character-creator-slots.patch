+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.AABB;
+import net.raphimc.viabedrock.api.model.NativeActorPickingMessage;
+
+import java.util.function.Predicate;
+
+/** Negotiated picking targets on the current connection; actor physics stay untouched. */
+public final class BedrockActorPicking {
+    private static final BedrockActorPickingState STATE = new BedrockActorPickingState();
+
+    private BedrockActorPicking() {}
+
+    public static void accept(final Connection connection, final NativeActorPickingMessage message) {
+        final long receivedGeneration = STATE.generation();
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (STATE.generation() == receivedGeneration && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                STATE.accept(receivedGeneration, message, BedrockActorState::lifetime, listener.getLocalGameProfile().id());
+            }
+        });
+    }
+
+    public static AABB bounds(final Entity proxy) {
+        final var part = STATE.part(proxy.getUUID(), BedrockActorState::lifetime);
+        return part == null ? null : bounds(proxy.getX(), proxy.getY(), proxy.getZ(), part);
+    }
+
+    static AABB bounds(final double x, final double y, final double z, final NativeActorPickingMessage.Part part) {
+        return new AABB(x - part.widthX() * .5D, y, z - part.widthZ() * .5D,
+                x + part.widthX() * .5D, y + part.height(), z + part.widthZ() * .5D);
+    }
+
+    public static Entity owner(final Entity proxy) {
+        final var snapshot = STATE.proxyOwner(proxy.getUUID(), BedrockActorState::lifetime);
+        return snapshot == null ? null : proxy.level().getEntity(snapshot.owner());
+    }
+
+    public static Predicate<Entity> filter(final Predicate<Entity> vanilla, final Entity camera) {
+        return candidate -> STATE.eligible(candidate.getUUID(), BedrockActorState::lifetime, camera.getUUID(), uuid -> {
+            final Entity owner = candidate.getUUID().equals(uuid) ? candidate : candidate.level().getEntity(uuid);
+            return owner != null && !owner.isRemoved() && vanilla.test(owner);
+        });
+    }
+
+    public static void clear() {
+        STATE.clear();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorPickingState.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorPickingState.java
new file mode 100644
index 0000000..d05c95f
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockActorPickingState.java
@@ -0,0 +1,99 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.raphimc.viabedrock.api.model.NativeActorPickingMessage;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/** Lifetime-scoped owner and proxy identities, without retaining client entities. */
+public final class BedrockActorPickingState {
+    private final Map<UUID, NativeActorPickingMessage.Snapshot> owners = new HashMap<>();
+    private final Map<UUID, UUID> proxies = new HashMap<>();
+    private volatile long generation;
+
+    public long generation() {
+        return this.generation;
+    }
+
+    public boolean accept(final long receivedGeneration, final NativeActorPickingMessage message,
+                          final Function<UUID, UUID> lifetimes, final UUID localPlayer) {
+        return receivedGeneration == this.generation && this.apply(message, lifetimes, localPlayer);
+    }
+
+    public boolean apply(final NativeActorPickingMessage message, final Function<UUID, UUID> lifetimes, final UUID localPlayer) {
+        if (message instanceof NativeActorPickingMessage.Remove remove) {
+            final var prior = this.owners.get(remove.owner());
+            if (prior == null || !prior.lifetime().equals(remove.lifetime())) {
+                return false;
+            }
+            this.remove(remove.owner());
+            return true;
+        }
+        final var snapshot = (NativeActorPickingMessage.Snapshot) message;
+        if (snapshot.owner().equals(localPlayer) || !snapshot.lifetime().equals(lifetimes.apply(snapshot.owner()))
+                || this.proxies.containsKey(snapshot.owner())) {
+            return false;
+        }
+        for (var part : snapshot.parts()) {
+            final UUID previousOwner = this.proxies.get(part.proxy());
+            if (part.proxy().equals(localPlayer) || this.owners.containsKey(part.proxy())
+                    || previousOwner != null && !previousOwner.equals(snapshot.owner())) {
+                return false;
+            }
+        }
+        this.remove(snapshot.owner());
+        if (!snapshot.parts().isEmpty()) {
+            this.owners.put(snapshot.owner(), snapshot);
+            snapshot.parts().forEach(part -> this.proxies.put(part.proxy(), snapshot.owner()));
+        }
+        return true;
+    }
+
+    private void remove(final UUID owner) {
+        final var removed = this.owners.remove(owner);
+        if (removed != null) {
+            removed.parts().forEach(part -> this.proxies.remove(part.proxy()));
+        }
+    }
+
+    public NativeActorPickingMessage.Snapshot owner(final UUID uuid, final Function<UUID, UUID> lifetimes) {
+        final var snapshot = this.owners.get(uuid);
+        if (snapshot != null && !snapshot.lifetime().equals(lifetimes.apply(uuid))) {
+            return null;
+        }
+        return snapshot;
+    }
+
+    public NativeActorPickingMessage.Snapshot proxyOwner(final UUID proxy, final Function<UUID, UUID> lifetimes) {
+        final UUID owner = this.proxies.get(proxy);
+        return owner == null ? null : this.owner(owner, lifetimes);
+    }
+
+    public NativeActorPickingMessage.Part part(final UUID proxy, final Function<UUID, UUID> lifetimes) {
+        final var owner = this.proxyOwner(proxy, lifetimes);
+        return owner == null ? null : owner.parts().stream().filter(part -> part.proxy().equals(proxy)).findFirst().orElse(null);
+    }
+
+    public boolean eligible(final UUID candidate, final Function<UUID, UUID> lifetimes, final UUID camera,
+                            final Predicate<UUID> vanillaEligibility) {
+        final var proxyOwner = this.proxyOwner(candidate, lifetimes);
+        if (proxyOwner != null) {
+            return !proxyOwner.owner().equals(camera) && vanillaEligibility.test(proxyOwner.owner());
+        }
+        return !this.proxies.containsKey(candidate) && this.owner(candidate, lifetimes) == null && vanillaEligibility.test(candidate);
+    }
+
+    public void clear() {
+        this.generation++;
+        this.owners.clear();
+        this.proxies.clear();
+    }
+}
