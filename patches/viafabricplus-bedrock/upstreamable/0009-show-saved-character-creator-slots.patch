+
+final class BedrockParticleSoundTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeDispatchOrderCoordinatesAndUnknownSuppression() throws Exception {
+        for (final var entry : fixture("native-particle-sound-dispatch-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final boolean known = row.get("event").getAsInt() != 614;
+            final JsonObject leaf = new JsonObject(), sound = new JsonObject(), document = new JsonObject();
+            // These native cases supply raw enum fields. Compare dispatch, not enum-name mapping.
+            sound.addProperty("event_name", known ? "BLOCK.CLICK" : "unknown.test.event");
+            leaf.add("sound_effect", sound);
+            if (row.get("expression").getAsBoolean()) leaf.addProperty("expression", "v.trace=17;");
+            if (row.get("log").getAsBoolean()) leaf.addProperty("log", "test");
+            document.add("run", leaf);
+            final var position = row.getAsJsonArray("position");
+            final var origin = new Vector3f(position.get(0).getAsFloat(), position.get(1).getAsFloat(), position.get(2).getAsFloat());
+            final var environment = new BedrockMolang();
+            final List<String> actual = new ArrayList<>(), expected = new ArrayList<>();
+            BedrockParticleEvents.read(document).run(List.of("run"), environment, new Random(1), origin, new Vector3f(), action -> {
+                final var request = assertInstanceOf(BedrockParticleEvents.Sound.class, action);
+                assertEquals(origin, request.position());
+                assertEquals(0, environment.evaluate(variable(), 0));
+                actual.add("sound");
+            }, _ -> {
+                assertEquals(row.get("expression").getAsBoolean() ? 17 : 0, environment.evaluate(variable(), 0));
+                actual.add("log");
+            });
+            for (final var receipt : row.getAsJsonArray("trace")) {
+                final var observed = receipt.getAsJsonObject();
+                if (!observed.has("phase")) continue;
+                final String phase = observed.get("phase").getAsString();
+                if (!phase.equals("level")) expected.add(phase);
+            }
+            assertEquals(expected, actual);
+            assertEquals(row.get("expression").getAsBoolean() ? 17 : 0, environment.evaluate(variable(), 0));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeRangeParsingAndSampling() throws Exception {
+        for (final var entry : fixture("native-particle-sound-range-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var incoming = row.getAsJsonArray("incoming");
+            final var result = row.getAsJsonArray("result");
+            assertEquals(new BedrockLevelSounds.Range(result.get(0).getAsFloat(), result.get(1).getAsFloat()),
+                    BedrockLevelSounds.Range.read(row.get("input"), new BedrockLevelSounds.Range(incoming.get(0).getAsFloat(), incoming.get(1).getAsFloat())));
+        }
+        for (final var entry : fixture("native-particle-sound-volume-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final float volume = BedrockLevelSounds.volume(row.get("input").getAsFloat());
+            assertEquals(row.getAsJsonObject("result").get("volume").getAsFloat(), volume);
+            assertEquals(row.getAsJsonObject("result").get("play").getAsBoolean(), volume > 0);
+        }
+        for (final var entry : fixture("native-particle-sound-sample-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var limits = row.getAsJsonArray("range");
+            final var draws = row.getAsJsonArray("draws");
+            final int[] index = {0};
+            final var random = new Random() {
+                @Override public int nextInt() { return (int) draws.get(index[0]++).getAsLong(); }
+            };
+            assertEquals(row.get("result").getAsFloat(), new BedrockLevelSounds.Range(limits.get(0).getAsFloat(), limits.get(1).getAsFloat()).sample(random));
+            assertEquals(row.get("consumed").getAsInt(), index[0]);
+        }
+    }
+
+    @Test
+    void selectsCaptionMetadataBeforeOpeningAnUnavailableSample() throws Exception {
+        final var library = BedrockResourceLibrary.withServerPacks(null, List.of(Map.of(
+                "sounds.json", """
+                        {"individual_event_sounds":{"events":{"block.click":{"sound":"test:click","volume":0.5,"pitch":1.2}}}}
+                        """.getBytes(StandardCharsets.UTF_8),
+                "sounds/sound_definitions.json", """
+                        {"format_version":"1.14.0","sound_definitions":{"test:click":{
+                          "category":"block","subtitle":"subtitles.test.click","sounds":["sounds/missing"]}}}
+                        """.getBytes(StandardCharsets.UTF_8),
+                "texts/en_US.lang", "subtitles.test.click=Click\n".getBytes(StandardCharsets.UTF_8))));
+        final var random = new Random(1);
+        final var request = library.levelSound("BLOCK.CLICK", random);
+        assertNotNull(request);
+        assertEquals(.5F, request.volume());
+        assertEquals(1.2F, request.pitch());
+        final var definition = library.soundDefinition(request.name());
+        assertNotNull(definition);
+        assertFalse(library.translate(definition.subtitle(), "de_de").isEmpty());
+        assertThrows(IOException.class, () -> library.soundEvent(request.name(), random::nextInt, request.volume(), request.pitch(), false));
+        assertNull(library.levelSound("unknown.test.event", random));
+    }
+
+    @Test
+    void retainsInheritedRangesAndOrdersMixedActions() throws Exception {
+        final var configurations = BedrockLevelSounds.read(json("""
+                {"individual_event_sounds":{"volume":"[0.2, 0.6]","pitch":1.2,"events":{
+                  "BLOCK.CLICK":"test:click", "DRIP.LAVA.POINTED_DRIPSTONE":{"sound":"test:lava","pitch":{"min":0.5,"max":0.8}},
+                  "unknown.test.event":{"sound":[]}}}}
+                """));
+        assertEquals(new BedrockLevelSounds.Range(.2F, .6F), configurations.get("block.click").volume());
+        assertEquals(new BedrockLevelSounds.Range(1.2F, 1.2F), configurations.get("block.click").pitch());
+        assertEquals(new BedrockLevelSounds.Range(.5F, .8F), configurations.get("drip.lava.pointed_dripstone").pitch());
+        assertEquals(2, configurations.size());
+        final var graph = BedrockParticleEvents.read(json("""
+                {"run":{"particle_effect":{"effect":"test:child","type":"emitter"},
+                  "sound_effect":{"event_name":"BLOCK.CLICK"},"expression":"v.trace=1;","log":"finished"}}
+                """));
+        final var environment = new BedrockMolang();
+        final List<BedrockParticleEvents.Action> requests = new ArrayList<>();
+        graph.run(List.of("run"), environment, new Random(1), new Vector3f(1, 2, 3), new Vector3f(), action -> {
+            assertEquals(0, environment.evaluate(variable(), 0));
+            requests.add(action);
+        }, _ -> assertEquals(1, environment.evaluate(variable(), 0)));
+        assertInstanceOf(BedrockParticleEvents.Request.class, requests.getFirst());
+        final var sound = assertInstanceOf(BedrockParticleEvents.Sound.class, requests.getLast());
+        final var exposed = sound.position(); exposed.zero();
+        assertEquals(new Vector3f(1, 2, 3), sound.position());
+        assertThrows(IOException.class, () -> BedrockLevelSounds.Range.read(JsonParser.parseString("1e99"), BedrockLevelSounds.Range.UNSET));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void resolvesOfficialDripEventsThroughVersionedConfigurationsAndAudio() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), "particle-sound-resources");
+        final var files = new LinkedHashMap<String, byte[]>();
+        try (var paths = Files.walk(root)) {
+            for (final var path : paths.filter(Files::isRegularFile).toList())
+                files.put(root.relativize(path).toString().replace('\\', '/'), Files.readAllBytes(path));
+        }
+        final var library = BedrockResourceLibrary.read(files);
+        assertTrue(library.packNames().size() > 40);
+        final var random = new Random() {
+            @Override public int nextInt() { return 0; }
+            @Override public int nextInt(final int bound) { return 0; }
+        };
+        final List<String> events = List.of("drip.lava.pointed_dripstone", "drip.water.pointed_dripstone", "block.beehive.drip");
+        for (final String event : events) {
+            final var request = library.levelSound(event, random);
+            assertNotNull(request, event);
+            final var resolved = library.soundEvent(request.name(), random::nextInt, request.volume(), request.pitch(), false);
+            assertNotNull(resolved, event);
+            assertTrue(resolved.audio().pcm().length > 0);
+            assertSame(library.soundDefinitions().get(event), resolved.event());
+            assertEquals(event.equals("block.beehive.drip") ? .3F : .65F, resolved.selection().volume(), 1e-6F);
+            assertEquals(event.equals("block.beehive.drip") ? .8F : 1, resolved.selection().pitch(), 1e-6F);
+        }
+        assertNull(library.levelSound("unknown.test.event", random));
+    }
+
+    private static BedrockMolang.Program variable() {
+        try { return BedrockMolang.Program.parse(JsonParser.parseString("\"v.trace\""), 0); }
+        catch (IOException invalid) { throw new AssertionError(invalid); }
+    }
+    private static JsonObject fixture(final String name) throws IOException {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), name))).getAsJsonObject();
+    }
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+}
