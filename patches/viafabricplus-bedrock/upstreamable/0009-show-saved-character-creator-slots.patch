+    static JsonObject selectionRequest(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()) {
+            throw new IOException("Character slot is out of range");
+        }
+        final Slot slot = wardrobe.slots().get(slotNumber - 1);
+        if (!slot.occupied()) {
+            throw new IOException("Character slot has no saved recipe");
+        }
+        final JsonObject settings = settingsForSlot(wardrobe, slotNumber);
+        final JsonArray objects = new JsonArray();
+        objects.add(appearanceObject("personaProfile", settings));
+        objects.add(appearanceObject("personaProfile" + slotNumber, slot.profile()));
+        final JsonObject request = new JsonObject();
+        request.add("appearanceObjects", objects);
+        return request;
+    }
