+    private void loadCategory() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.itemsLoading
+            || this.loadedCategory == this.category && this.items != null) {
+            return;
+        }
+        final Category requested = this.category;
+        this.itemsLoading = true;
+        this.itemsFailed = false;
+        BedrockCharacterProfiles.loadItems(account, requested).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            this.itemsLoading = false;
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            if (this.category != requested) {
+                this.loadCategory();
+                return;
+            }
+            if (error != null) {
+                this.itemsFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock wardrobe items", error);
+            } else {
+                this.items = loaded;
+                this.loadedCategory = requested;
+                this.selectedItem = Math.min(this.selectedItem, Math.max(0, loaded.size() - 1));
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void loadAvatar(final BedrockAuthManager account) {
+        this.activeAvatar = null;
+        final long request = ++this.avatarRequest;
+        BedrockCharacterProfiles.loadActiveAvatar(account).whenComplete((encoded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this || this.avatarRequest != request) {
+                return;
+            }
+            if (error != null) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character preview", error);
+            } else {
+                this.activeAvatar = encoded;
+            }
+        }));
+    }
