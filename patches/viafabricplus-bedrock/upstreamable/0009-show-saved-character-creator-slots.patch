+/** Converts the account's assembled GLTF preview into a static Bedrock player geometry and atlas. */
+public final class BedrockPersonaModel {
+
+    private static final int MAX_MODEL_BYTES = 4 * 1024 * 1024;
+    private static final int MAX_VERTICES = 32768;
+    private static final int GLTF_MAGIC = 0x46546C67;
+    private static final int JSON_CHUNK = 0x4E4F534A;
+    private static final int BINARY_CHUNK = 0x004E4942;
+
+    private BedrockPersonaModel() {
+    }
+
+    public static Converted convert(final byte[] source) throws IOException {
+        if (source.length < 28 || source.length > MAX_MODEL_BYTES) {
+            throw new IOException("Bedrock character model has an invalid size");
+        }
+        try {
+            return parse(source);
+        } catch (RuntimeException e) {
+            throw new IOException("Bedrock character model is invalid", e);
+        }
+    }
+
+    private static Converted parse(final byte[] source) throws IOException {
+        final ByteBuffer file = ByteBuffer.wrap(source).order(ByteOrder.LITTLE_ENDIAN);
+        if (file.getInt() != GLTF_MAGIC || file.getInt() != 2 || file.getInt() != source.length) {
+            throw new IOException("Bedrock did not return a GLTF 2 model");
+        }
+        final int jsonLength = file.getInt();
+        if (file.getInt() != JSON_CHUNK || jsonLength < 2 || jsonLength > file.remaining()) {
+            throw new IOException("Bedrock character model has no JSON chunk");
+        }
+        final byte[] jsonBytes = new byte[jsonLength];
+        file.get(jsonBytes);
+        final JsonObject gltf = JsonParser.parseString(new String(jsonBytes, StandardCharsets.UTF_8)).getAsJsonObject();
+        if (file.remaining() < 8) {
+            throw new IOException("Bedrock character model has no binary chunk");
+        }
+        final int binaryLength = file.getInt();
+        if (file.getInt() != BINARY_CHUNK || binaryLength < 0 || binaryLength != file.remaining()) {
+            throw new IOException("Bedrock character model has an invalid binary chunk");
+        }
+        final ByteBuffer binary = file.slice().order(ByteOrder.LITTLE_ENDIAN);
+        final Model model = new Model(gltf, binary);
+        return model.convert();
+    }
+
+    public record Converted(BufferedImage atlas, String geometry, String resourcePatch) {
+    }
+
+    private record Placement(BufferedImage image, int x, int y) {
+    }
+
+    private static final class Model {
+
+        private final JsonObject data;
+        private final ByteBuffer binary;
+        private final JsonArray views;
+        private final JsonArray accessors;
+        private final JsonArray nodes;
+        private final JsonArray meshes;
+        private final JsonArray materials;
+        private final JsonArray textures;
+        private final List<BufferedImage> images;
+        private final Set<String> names = new HashSet<>();
+        private final Set<Integer> visited = new HashSet<>();
+        private int atlasSize;
+        private List<Placement> placements;
+        private int vertexCount;
+
+        private Model(final JsonObject data, final ByteBuffer binary) throws IOException {
+            this.data = data;
+            this.binary = binary;
+            this.views = array(data, "bufferViews");
+            this.accessors = array(data, "accessors");
+            this.nodes = array(data, "nodes");
+            this.meshes = array(data, "meshes");
+            this.materials = array(data, "materials");
+            this.textures = array(data, "textures");
+            this.images = this.readImages();
+            if (this.nodes.isEmpty() || this.meshes.isEmpty() || this.images.isEmpty()) {
+                throw new IOException("Bedrock character model has no geometry or textures");
+            }
+        }
+
+        private Converted convert() throws IOException {
+            this.packImages();
+            final BufferedImage atlas = new BufferedImage(this.atlasSize, this.atlasSize, BufferedImage.TYPE_INT_ARGB);
+            final Graphics2D graphics = atlas.createGraphics();
+            try {
+                for (final Placement placement : this.placements) {
+                    graphics.drawImage(placement.image(), placement.x(), placement.y(), null);
+                }
+            } finally {
+                graphics.dispose();
+            }
