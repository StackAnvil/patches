@@ -0,0 +1,67 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+
+/** Native recipe side flags for owned, free, and built-in arms and legs. */
+public enum BedrockLimbSide {
+    BOTH("", 3),
+    LEFT("l", 1),
+    RIGHT("r", 2);
+
+    private final String suffix;
+    private final int mask;
+
+    BedrockLimbSide(final String suffix, final int mask) {
+        this.suffix = suffix;
+        this.mask = mask;
+    }
+
+    public int mask() {
+        return this.mask;
+    }
+
+    public static BedrockLimbSide fromRecipe(final String id) {
+        return switch (flags(id)) {
+            case "l", "fl", "dl" -> LEFT;
+            case "r", "fr", "dr" -> RIGHT;
+            default -> BOTH;
+        };
+    }
+
+    static boolean supportsSides(final String id) {
+        if (id.endsWith("/")) return false;
+        return switch (flags(id)) {
+            case "", "l", "r", "f", "fl", "fr", "d", "dl", "dr" -> true;
+            default -> false;
+        };
+    }
+
+    public String recipe(final String id) throws IOException {
+        if (!supportsSides(id)) throw new IOException("This limb piece has unknown recipe flags");
+        final int separator = id.indexOf('/');
+        final String base = separator < 0 ? id : id.substring(0, separator);
+        final String flags = flags(id);
+        final String source = flags.startsWith("f") ? "f" : flags.startsWith("d") ? "d" : "";
+        final String suffix = source + this.suffix;
+        return suffix.isEmpty() ? base : base + "/" + suffix;
+    }
+
+    private static String flags(final String id) {
+        final int separator = id.indexOf('/');
+        return separator < 0 ? "" : id.substring(separator + 1);
+    }
+
+    public String packetType(final String category) {
+        final String limb = "persona_arms".equals(category) ? "Arm" : "Leg";
+        return this == BOTH ? limb + "s" : (this == LEFT ? "Left" : "Right") + limb;
+    }
+
+    static BedrockLimbSide fromMask(final int mask) {
+        return mask == 1 ? LEFT : mask == 2 ? RIGHT : BOTH;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMarketplaceAssets.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMarketplaceAssets.java
new file mode 100644
index 0000000..2d4b898
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMarketplaceAssets.java
@@ -0,0 +1,311 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import java.util.zip.ZipInputStream;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/** Acquires and decodes licensed Marketplace content using the selected account. */
+final class BedrockMarketplaceAssets {
+    private static final URI INVENTORY =
+            URI.create(
+                    "https://entitlements.mktpl.minecraft-services.net/api/v1.0/player/inventory?includeReceipt=true");
+    private static final URI CATALOG =
+            URI.create("https://20ca2.playfabapi.com/Catalog/GetPublishedItem");
+    private static final int MAX_JSON_BYTES = 2 * 1024 * 1024;
+    private static final int MAX_PACK_BYTES = 32 * 1024 * 1024;
+    private static final HttpClient HTTP =
+            HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();
+
+    private BedrockMarketplaceAssets() {}
+
+    static Map<String, byte[]> accountKeys(final BedrockAuthManager account) throws Exception {
+        final JsonObject inventory =
+                json(
+                        request(
+                                HttpRequest.newBuilder(INVENTORY)
+                                        .header(
+                                                "Authorization",
+                                                account.getMinecraftSession()
+                                                        .getUpToDate()
+                                                        .getAuthorizationHeader())
+                                        .header("Accept", "application/json")
+                                        .GET(),
+                                MAX_JSON_BYTES));
+        return receiptKeys(
+                json(
+                        Base64.getDecoder()
+                                .decode(
+                                        inventory
+                                                .getAsJsonObject("result")
+                                                .get("receipt")
+                                                .getAsString())));
+    }
+
+    static JsonObject published(final BedrockAuthManager account, final String product)
+            throws Exception {
+        final JsonObject body = new JsonObject();
+        body.addProperty("ItemId", UUID.fromString(product).toString());
+        final JsonObject response =
+                json(
+                        request(
+                                HttpRequest.newBuilder(CATALOG)
+                                        .header(
+                                                "X-EntityToken",
+                                                account.getPlayFabToken()
+                                                        .getUpToDate()
+                                                        .getEntityToken()
+                                                        .getToken())
+                                        .header("Content-Type", "application/json")
+                                        .POST(HttpRequest.BodyPublishers.ofString(body.toString())),
+                                MAX_JSON_BYTES));
+        return response.getAsJsonObject("data").getAsJsonObject("Item");
+    }
+
+    static byte[] download(final JsonObject item, final String type) throws Exception {
+        URI download = null;
+        for (final var element : item.getAsJsonArray("Contents")) {
+            final var content = element.getAsJsonObject();
+            if (type.equals(content.get("Type").getAsString())) {
+                download = URI.create(content.get("Url").getAsString());
+                break;
+            }
+        }
+        validateDownload(download);
+        return request(
+                HttpRequest.newBuilder(download)
+                        .header("User-Agent", "libhttpclient/1.0.0.0")
+                        .header("Accept", "*/*")
+                        .GET(),
+                MAX_PACK_BYTES);
+    }
+
+    static void validateDownload(final URI download) throws IOException {
+        if (download == null
+                || !"https".equalsIgnoreCase(download.getScheme())
+                || download.getUserInfo() != null
+                || download.getFragment() != null
+                || (download.getPort() != -1 && download.getPort() != 443)
+                || download.getHost() == null) {
+            throw new IOException("The Marketplace catalog returned an invalid asset location");
+        }
+        final String host = download.getHost().toLowerCase(Locale.ROOT);
+        if (!host.matches("xforgeassets[0-9]+\\.xboxlive\\.com")
+                && !host.matches("content[0-9]+\\.prod\\.catalog\\.playfab\\.com")) {
+            throw new IOException("The Marketplace catalog returned an invalid asset location");
+        }
+    }
+
+    static Map<String, byte[]> receiptKeys(final JsonObject receipt) throws IOException {
+        try {
+            final byte[] entity =
+                    receipt.get("EntityId").getAsString().getBytes(StandardCharsets.UTF_8);
+            final byte[] device =
+                    receipt.getAsJsonObject("ReceiptData")
+                            .get("DeviceId")
+                            .getAsString()
+                            .getBytes(StandardCharsets.UTF_8);
+            if (entity.length < 32 || device.length < 32)
+                throw new IOException("The entitlement receipt has an invalid identity");
+            final Map<String, byte[]> keys = new LinkedHashMap<>();
+            for (final var element : receipt.getAsJsonArray("EntitlementReceipts")) {
+                final JsonObject entry = element.getAsJsonObject();
+                if (!entry.has("ContentKey")
+                        || entry.get("ContentKey").isJsonNull()
+                        || entry.get("ContentKey").getAsString().isEmpty()) continue;
+                final byte[] encoded =
+                        Base64.getDecoder().decode(entry.get("ContentKey").getAsString());
+                if (encoded.length != 64)
+                    throw new IOException("The entitlement receipt has an invalid content key");
+                final byte[] key = new byte[32];
+                for (int index = 0; index < key.length; index++)
+                    key[index] = (byte) (entity[index] ^ device[index] ^ encoded[index * 2]);
+                keys.put(UUID.fromString(entry.get("PackId").getAsString()).toString(), key);
+            }
+            return keys;
+        } catch (RuntimeException e) {
+            throw new IOException("The entitlement receipt is invalid", e);
+        }
+    }
+
+    static Pack decode(
+            final byte[] source, final String expectedPack, final Collection<byte[]> keys)
+            throws IOException {
+        try {
+            Map<String, byte[]> files = unzip(source);
+            if (files.size() == 1) {
+                final var wrapper = files.entrySet().iterator().next();
+                if (wrapper.getKey().endsWith(".zip")) files = unzip(wrapper.getValue());
+            }
+            final JsonObject manifest = json(required(files, "manifest.json"));
+            if (!expectedPack.equals(
+                    manifest.getAsJsonObject("header").get("uuid").getAsString())) {
+                throw new IOException("The downloaded Marketplace pack has a different identity");
+            }
+            final byte[] contents = required(files, "contents.json");
+            if (contents.length < 256
+                    || contents[4] != (byte) 0xFC
+                    || contents[5] != (byte) 0xB9
+                    || contents[6] != (byte) 0xCF
+                    || contents[7] != (byte) 0x9B
+                    || (contents[16] & 0xFF) != expectedPack.length()
+                    || !expectedPack.equals(
+                            new String(
+                                    contents, 17, expectedPack.length(), StandardCharsets.UTF_8))) {
+                throw new IOException(
+                        "The downloaded Marketplace pack has an invalid content index");
+            }
+            final byte[] encryptedIndex = Arrays.copyOfRange(contents, 256, contents.length);
+            JsonObject index = null;
+            final List<byte[]> attempted = new ArrayList<>();
+            for (final byte[] key : keys) {
+                if (attempted.stream().anyMatch(previous -> Arrays.equals(previous, key))) continue;
+                attempted.add(key);
+                try {
+                    final JsonObject candidate = json(decrypt(encryptedIndex, key));
+                    if (candidate.has("content") && candidate.get("content").isJsonArray()) {
+                        index = candidate;
+                        break;
+                    }
+                } catch (IOException | GeneralSecurityException e) {
+                    // A free Marketplace pack can share a key with a different receipt entry.
+                    // Try the remaining account keys without retaining or logging them.
+                }
+            }
+            if (index == null)
+                throw new IOException("No account receipt key decodes this Marketplace pack");
+            final Map<String, byte[]> decoded = new LinkedHashMap<>();
+            for (final var element : index.getAsJsonArray("content")) {
+                final JsonObject entry = element.getAsJsonObject();
+                final String path = entry.get("path").getAsString();
+                if (path.endsWith("/")) continue;
+                final byte[] data = required(files, path);
+                decoded.put(
+                        path,
+                        entry.has("key")
+                                        && !entry.get("key").isJsonNull()
+                                        && !entry.get("key").getAsString().isEmpty()
+                                ? decrypt(
+                                        data,
+                                        entry.get("key")
+                                                .getAsString()
+                                                .getBytes(StandardCharsets.ISO_8859_1))
+                                : data);
+            }
+            decoded.put("manifest.json", files.get("manifest.json"));
+            return new Pack(expectedPack, Map.copyOf(decoded));
+        } catch (GeneralSecurityException | RuntimeException e) {
+            throw new IOException("The Marketplace pack could not be decoded", e);
+        }
+    }
+
+    private static byte[] decrypt(final byte[] data, final byte[] key)
+            throws GeneralSecurityException {
+        if (key.length != 32) throw new GeneralSecurityException("Invalid content key length");
+        final Cipher cipher = Cipher.getInstance("AES/CFB8/NoPadding");
+        cipher.init(
+                Cipher.DECRYPT_MODE,
+                new SecretKeySpec(key, "AES"),
+                new IvParameterSpec(Arrays.copyOf(key, 16)));
+        return cipher.doFinal(data);
+    }
+
+    private static Map<String, byte[]> unzip(final byte[] source) throws IOException {
+        if (source.length > MAX_PACK_BYTES)
+            throw new IOException("The Marketplace archive is too large");
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        int total = 0;
+        try (final ZipInputStream input = new ZipInputStream(new ByteArrayInputStream(source))) {
+            for (var entry = input.getNextEntry(); entry != null; entry = input.getNextEntry()) {
+                if (entry.isDirectory()) continue;
+                final String path = entry.getName();
+                if (files.size() >= 1024
+                        || path.startsWith("/")
+                        || path.contains("\\")
+                        || Arrays.asList(path.split("/")).contains(".."))
+                    throw new IOException("The Marketplace archive has an invalid path");
+                final byte[] data = limited(input, MAX_PACK_BYTES - total);
+                total += data.length;
+                // Native archives contain an obsolete contents.json before their final encrypted
+                // index.
+                if (files.put(path, data) != null && !"contents.json".equals(path)) {
+                    throw new IOException("The Marketplace archive has duplicate entries");
+                }
+            }
+        }
+        if (files.isEmpty()) throw new IOException("The Marketplace archive is empty");
+        return files;
+    }
+
+    private static byte[] required(final Map<String, byte[]> files, final String path)
+            throws IOException {
+        final byte[] value = files.get(path);
+        if (value == null)
+            throw new IOException("The Marketplace archive is missing an indexed file");
+        return value;
+    }
+
+    static byte[] request(final HttpRequest.Builder builder, final int limit)
+            throws IOException, InterruptedException {
+        final var response =
+                HTTP.send(
+                        builder.timeout(Duration.ofSeconds(30)).build(),
+                        HttpResponse.BodyHandlers.ofInputStream());
+        try (final InputStream input = response.body()) {
+            if (response.statusCode() / 100 != 2)
+                throw new IOException(
+                        "The Marketplace asset request failed: HTTP " + response.statusCode());
+            return limited(input, limit);
+        }
+    }
+
+    private static byte[] limited(final InputStream input, final int limit) throws IOException {
+        final byte[] data = input.readNBytes(limit + 1);
+        if (data.length > limit)
+            throw new IOException("The Marketplace asset exceeds the size limit");
+        return data;
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes.length > MAX_JSON_BYTES)
+            throw new IOException("The Marketplace metadata is too large");
+        try {
+            return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                    .getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("The Marketplace metadata is invalid", e);
+        }
+    }
+
+    record Pack(String id, Map<String, byte[]> files) {}
+}
