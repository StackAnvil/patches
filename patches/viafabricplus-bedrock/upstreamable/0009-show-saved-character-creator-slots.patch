+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockFirstPersonActorTest {
+    @Test
+    void placesConvertedPixelsInCameraSpaceWithoutJavaHandTransforms() {
+        final var matrix = BedrockFirstPersonActor.root(.9F, 1F / 16F, new Vector3f(1), false, new Matrix4f());
+        final var pivot = matrix.transformPosition(new Vector3f(5F / 16F, 26F / 16F, 0));
+        assertEquals(5F / 16F, pivot.x);
+        assertEquals(1.5078125F - .9F - 26F / 16F, pivot.y, .000001F);
+        assertEquals(0, pivot.z);
+        final var near = matrix.transformPosition(new Vector3f(0, 0, 12F / 16F));
+        assertEquals(-12F / 16F, near.z);
+    }
+
+    @Test
+    void matchesVisibleGeometryAgainstTheLiveNativeHandMatrix() {
+        // Standing actor and posed bone matrices captured in Bedrock 1.26.51.1.
+        final var nativeRoot = new Matrix4f().scaling(-.0546875F, -.0546875F, .0546875F)
+                .setTranslation(0, -.30067408084869385F, 0);
+        final var convertedRoot = BedrockFirstPersonActor.root(1.6200100183486938F, 1F / 16F,
+                new Vector3f(.875F), false, new Matrix4f());
+        final var nativeBones = new Vector3f[]{new Vector3f(8, 15, 10), new Vector3f(1, 18, -1)};
+        final var origins = new float[]{-8, 4};
+        for (int bone = 0; bone < nativeBones.length; bone++) {
+            final var pivot = nativeBones[bone];
+            for (final float x : new float[]{origins[bone], origins[bone] + 4})
+                for (final float y : new float[]{-12, -8}) for (final float z : new float[]{16, 20}) {
+                    final var posedPixel = new Vector3f(x, y, z).add(pivot);
+                    final var nativePoint = nativeRoot.transformPosition(new Vector3f(posedPixel));
+                    final var convertedPoint = convertedRoot.transformPosition(new Vector3f(posedPixel).div(16F));
+                    // The Java camera faces the opposite X/Z basis from the native hand pass.
+                    assertEquals(-nativePoint.x, convertedPoint.x, .000001F);
+                    assertEquals(nativePoint.y, convertedPoint.y, .000001F);
+                    assertEquals(-nativePoint.z, convertedPoint.z, .000001F);
+                }
+        }
+    }
+
+    @Test
+    void retainsSignedScriptScaleAndZeroModelScale() {
+        final var collapsed = BedrockFirstPersonActor.root(.9F, 0, new Vector3f(2, -3, 4), false, new Matrix4f());
+        final var point = collapsed.transformPosition(new Vector3f(9, 18, 27));
+        assertEquals(0, point.x);
+        assertEquals(-.9F - 3F / 128F, point.y);
+        assertEquals(0, point.z);
+        final var skipped = BedrockFirstPersonActor.root(.9F, .125F, new Vector3f(2, -3, 4), true, new Matrix4f());
+        final var expanded = skipped.transformPosition(new Vector3f(1, 2.5F, 3));
+        assertEquals(4, expanded.x);
+        assertEquals(14.1F, expanded.y, .000001F);
+        assertEquals(-24, expanded.z);
+    }
+
+    @Test
+    void composesDeathAndNamedTransformsBeforeAxisConversionAndModelOffsets() {
+        final var normal = BedrockFirstPersonActor.global(0, .5F, "other", 1.8F);
+        assertEquals(new Matrix4f(), normal);
+        final var dying = BedrockFirstPersonActor.global(21, 0, "Dinnerbone", 1.8F);
+        final var root = BedrockFirstPersonActor.root(.9F, 1F / 16F, new Vector3f(1), false, dying);
+        final var point = root.transformPosition(new Vector3f(0, 24F / 16F, 0));
+        assertEquals(1.8921875F, point.x, .000001F);
+        assertEquals(-.9F, point.y, .000001F);
+        assertEquals(0, point.z, .000001F);
+        assertEquals(new Matrix4f(), BedrockFirstPersonActor.global(0, 0, "dinnerbone", 1.8F));
+        assertEquals(new Matrix4f(), BedrockFirstPersonActor.global(0, 0, "§aDinnerbone", 1.8F));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_GLOBAL_FIRST_PERSON", matches = ".+")
+    void matchesGlobalTransformsFromTheTargetExecutable() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_GLOBAL_FIRST_PERSON")))).getAsJsonObject();
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final float[] input = new float[16];
+            for (int i = 0; i < 16; i++) input[i] = row.getAsJsonArray("input").get(i).getAsFloat();
+            final var actual = new Matrix4f().set(input).mul(BedrockFirstPersonActor.global(
+                    row.get("death").getAsInt(), row.get("alpha").getAsFloat(), row.get("name").getAsString(),
+                    row.get("height").getAsFloat())).get(new float[16]);
+            for (int i = 0; i < 16; i++) assertEquals(row.getAsJsonArray("result").get(i).getAsFloat(), actual[i], .00001F);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ACTOR_ROOT", matches = ".+")
+    void matchesTargetExecutableRootMatrices() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_ACTOR_ROOT")))).getAsJsonObject();
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            if (row.get("yaw").getAsFloat() != 0) continue;
+            final float[] input = new float[16];
+            for (int i = 0; i < 16; i++) input[i] = row.getAsJsonArray("input").get(i).getAsFloat();
+            final var script = row.getAsJsonArray("script_scale");
+            final var scale = row.get("uniform").isJsonNull()
+                    ? new Vector3f(script.get(0).getAsFloat(), script.get(1).getAsFloat(), script.get(2).getAsFloat())
+                    : new Vector3f(row.get("uniform").getAsFloat());
+            final var position = row.getAsJsonArray("position");
+            final var actual = new Matrix4f().set(input).translate(position.get(0).getAsFloat(), position.get(1).getAsFloat(), position.get(2).getAsFloat())
+                    .mul(BedrockFirstPersonActor.root(row.get("height").getAsFloat(), row.get("model_scale").getAsFloat(), scale, row.get("skip_offset").getAsBoolean(), new Matrix4f()))
+                    .scale(1F / 16F).get(new float[16]);
+            for (int i = 0; i < 16; i++) assertEquals(row.getAsJsonArray("result").get(i).getAsFloat(), actual[i], .00001F);
+        }
+    }
+}
