+    public static boolean limbEquipped(final Slot slot, final WardrobeItem item, final BedrockLimbSide side) {
+        int mask = 0;
+        for (final String id : slot.pieceIds()) {
+            if (item.matches(id)) mask |= BedrockLimbSide.fromRecipe(id).mask();
+        }
+        return (mask & side.mask()) == side.mask();
+    }
