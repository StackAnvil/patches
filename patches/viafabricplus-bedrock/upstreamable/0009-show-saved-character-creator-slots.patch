index 0000000..6c054da
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorAnimationTest.java
@@ -0,0 +1,205 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.Map;
+
+final class BedrockActorAnimationTest {
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+
+    @Test
+    void sharesVariablesAcrossOrderedAnimationsAndKeepsActorStateIndependent() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"a":"animation.a","b":"animation.b"},"scripts":{
+                                  "initialize":["variable.counter=0;"], "pre_animation":["variable.counter=variable.counter+1;"],"animate":["a",{"b":0.5}]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.a":{"loop":true,"bones":{"arm":{"rotation":["variable.counter",0,0],"position":[1,0,0]}}},
+                                 "animation.b":{"loop":true,"bones":{"arm":{"rotation":[2,0,0],"position":[0,3,0]}}}}
+                                """),
+                        new JsonObject());
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        final var actor = graph.playback();
+        final var first = actor.sample(0, frame).get("arm");
+        assertEquals(new BedrockBoneAnimation.Vector(1, 1.5F, 0), first.position());
+        assertEquals(2, first.rotation().x());
+        assertEquals(3, actor.sample(0.5F, frame).get("arm").rotation().x());
+        assertEquals(2, graph.playback().sample(0, frame).get("arm").rotation().x());
+    }
+
+    @Test
+    void usesStringQueriesTransitionOrderNestedControllersAndEmptyOverrides() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"root":"controller.animation.root","child":"controller.animation.child","idle":"animation.idle","selected":"animation.selected","removed":"animation.missing"},
+                                 "scripts":{"animate":["root"]}}
+                                """),
+                        Map.of("removed", ""),
+                        json(
+                                """
+                                {"animation.idle":{"loop":true,"bones":{"arm":{"rotation":1}}},"animation.selected":{"loop":true,"bones":{"arm":{"rotation":9}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"initial_state":"idle","states":{
+                                   "idle":{"animations":["idle"],"transitions":[{"first":"query.get_equipped_item_name == 'bow'"},{"second":"query.enabled"}]},
+                                   "first":{"animations":["child","removed"]},"second":{"animations":["idle"]}}},
+                                 "controller.animation.child":{"initial_state":"default","states":{"default":{"animations":[{"selected":"query.get_equipped_item_name('off_hand') != 'bow'"}]}}}}
+                                """));
+        final BedrockActorAnimation.Query items = arguments -> arguments.isEmpty() ? "bow" : "map";
+        assertEquals(
+                9,
+                graph.playback()
+                        .sample(
+                                0,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("get_equipped_item_name", items, "enabled", 1F),
+                                        Map.of()))
+                        .get("arm")
+                        .rotation()
+                        .x());
+        assertEquals(
+                1,
+                graph.playback()
+                        .sample(
+                                0,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("get_equipped_item_name", "map", "enabled", 1F),
+                                        Map.of()))
+                        .get("arm")
+                        .rotation()
+                        .x());
+    }
+
+    @Test
+    void restartsClocksWhenAStateReentersAndEvaluatesEntryExitScripts() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"root":"controller.animation.root","move":"animation.move"},"scripts":{"initialize":["variable.count=0;"],"animate":["root"]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.move":{"animation_length":2,"bones":{"arm":{"rotation":{"0":[0,0,0],"2":[20,0,0]},"position":["variable.count",0,0]}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"initial_state":"on","states":{"on":{"on_entry":["variable.count=variable.count+1;"],"on_exit":["variable.count=variable.count+10;"],
+                                 "animations":["move"],"transitions":[{"off":"!query.enabled"}]},"off":{"transitions":[{"on":"query.enabled"}]}}}}
+                                """));
+        final var actor = graph.playback();
+        final var on = new BedrockActorAnimation.Frame(Map.of("enabled", 1F), Map.of());
+        assertEquals(0, actor.sample(0, on).get("arm").rotation().x());
+        assertEquals(5, actor.sample(0.5F, on).get("arm").rotation().x());
+        assertTrue(actor.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of())).isEmpty());
+        final var restarted = actor.sample(1.5F, on).get("arm");
+        assertEquals(0, restarted.rotation().x());
+        assertEquals(12, restarted.position().x());
+    }
+
+    @Test
+    void scopesRemappedVariablesAcrossNestedControllersAndPreservesQuotedFloatSuffixes()
+            throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"parent":"controller.animation.parent","child":"controller.animation.child","pose":"animation.pose","after":"animation.after"},
+                                 "scripts":{"initialize":["variable.level=9;"],"animate":["parent","after"]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.pose":{"loop":true,"bones":{"arm":{"rotation":["variable.level",0,0]}}},
+                                 "animation.after":{"loop":true,"bones":{"body":{"rotation":["variable.level",0,"query.get_equipped_item_name == '1.0f' ? 2.0f : 0.0f"]}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.parent":{"states":{"default":{"variables":{"level":{"input":"query.speed","remap_curve":{"0":2,"1":6}}},"animations":["child","pose"]}}},
+                                 "controller.animation.child":{"states":{"default":{"variables":{"level":{"input":3}},"animations":["pose"]}}}}
+                                """));
+        final var actor = graph.playback();
+        final var frame =
+                new BedrockActorAnimation.Frame(
+                        Map.of("speed", 0.5F, "get_equipped_item_name", "1.0f"), Map.of());
+        for (final float time : new float[] {0, 0.1F}) {
+            final var pose = actor.sample(time, frame);
+            assertEquals(7, pose.get("arm").rotation().x());
+            assertEquals(new BedrockBoneAnimation.Vector(9, 0, 2), pose.get("body").rotation());
+        }
+    }
+
+    @Test
+    void rejectsCyclesAndMissingStateTargetsBeforePlayback() {
+        final var entity =
+                json(
+                        "{\"animations\":{\"root\":\"controller.animation.root\"},\"scripts\":{\"animate\":[\"root\"]}}");
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockActorAnimation.read(
+                                entity,
+                                Map.of(),
+                                new JsonObject(),
+                                json(
+                                        "{\"controller.animation.root\":{\"states\":{\"default\":{\"animations\":[\"root\"]}}}}")));
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockActorAnimation.read(
+                                entity,
+                                Map.of(),
+                                new JsonObject(),
+                                json(
+                                        "{\"controller.animation.root\":{\"states\":{\"default\":{\"transitions\":[{\"absent\":1}]}}}}")));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_OFFICIAL_PERSONA", matches = ".+")
+    void playsTheLicensedPlayerGraphWithClassicAliasesAndNativePostureLayers() throws Exception {
+        final var files =
+                BedrockBuiltinAssets.unpack(Path.of(System.getenv("STACKANVIL_OFFICIAL_PERSONA")));
+        final var graph =
+                BedrockActorAnimation.read(
+                        files,
+                        new BedrockClassicOptions(
+                                Map.of("move.arms", "animation.player.move.arms.zombie"),
+                                Map.of()));
+        final var actor = graph.playback();
+        final var preview =
+                actor.sample(
+                        0,
+                        new BedrockActorAnimation.Frame(
+                                Map.of("is_alive", true),
+                                Map.of("is_paperdoll", 1F, "gliding_speed_value", 1F)));
+        assertEquals(-90, preview.get("leftarm").rotation().x());
+        assertEquals(-90, preview.get("rightarm").rotation().x());
+        final var riding =
+                actor.sample(
+                        0.1F,
+                        new BedrockActorAnimation.Frame(
+                                Map.of("is_riding", true, "is_alive", true),
+                                Map.of("is_paperdoll", 0F, "gliding_speed_value", 1F)));
+        assertEquals(-126, riding.get("leftarm").rotation().x());
+        assertEquals(-126, riding.get("rightarm").rotation().x());
+    }
+}
