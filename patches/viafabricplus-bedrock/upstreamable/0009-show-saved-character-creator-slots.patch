+            final var image = BedrockPersonaSources.tga(bytes.array());
+            for (int row = 0; row < 2; row++)
+                for (int column = 0; column < 2; column++) {
+                    final int x = (descriptor & 0x10) != 0 ? 1 - column : column;
+                    final int y = (descriptor & 0x20) != 0 ? row : 1 - row;
+                    assertEquals(colors[row * 2 + column], image.getRGB(x, y));
