+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/** Vanilla resources in pack order, with identifier overrides and per-resource format versions. */
+final class BedrockResourceLibrary {
+    private static final Pattern VERSION_PACK =
+            Pattern.compile("vanilla_(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?");
+    private static final Pattern MODEL_IDENTIFIER =
+            Pattern.compile("(?:[a-z0-9_.-]{1,64}:)?geometry\\.[a-zA-Z0-9_.'-]{1,128}");
+    private final List<Pack> packs;
+    private final Map<String, List<JsonObject>> models;
+    private final Map<String, BedrockSoundEvent> sounds;
+
+    private BedrockResourceLibrary(final List<Pack> packs) throws IOException {
+        this.packs = List.copyOf(packs);
+        final Map<String, List<JsonObject>> models = new LinkedHashMap<>();
+        for (final Pack pack : packs) {
+            final Map<String, List<JsonObject>> local = new LinkedHashMap<>();
+            for (final var entry : pack.files.entrySet()) {
+                if (!entry.getKey().startsWith("models/") || !entry.getKey().endsWith(".json"))
+                    continue;
+                final JsonObject document = json(entry.getValue());
+                if (document.has("minecraft:geometry")) {
+                    for (final var element : document.getAsJsonArray("minecraft:geometry")) {
+                        final String identifier =
+                                element.getAsJsonObject()
+                                        .getAsJsonObject("description")
+                                        .get("identifier")
+                                        .getAsString();
+                        final JsonArray geometries = new JsonArray();
+                        geometries.add(element.deepCopy());
+                        final JsonObject selected = format(document);
+                        selected.add("minecraft:geometry", geometries);
+                        addModel(local, identifier, selected);
+                    }
+                } else {
+                    for (final var definition : document.entrySet()) {
+                        if (!definition.getKey().startsWith("geometry.")) continue;
+                        final JsonObject selected = format(document);
+                        selected.add(definition.getKey(), definition.getValue().deepCopy());
+                        addModel(local, definition.getKey().split(":", -1)[0], selected);
+                    }
+                }
+            }
+            // Identifier overrides replace the entire lower-pack definition.
+            models.putAll(local);
+        }
+        models.replaceAll((name, documents) -> List.copyOf(documents));
+        this.models = Map.copyOf(models);
+        this.sounds = this.readSounds();
+    }
+
+    static BedrockResourceLibrary read(final Map<String, byte[]> files) throws IOException {
+        try {
+            final Map<String, Map<String, byte[]>> grouped = new LinkedHashMap<>();
+            for (final var entry : files.entrySet()) {
+                if (!entry.getKey().startsWith("library/")) continue;
+                BedrockBuiltinAssets.validPath(entry.getKey());
+                final String path = entry.getKey().substring("library/".length());
+                final int separator = path.indexOf('/');
+                if (separator < 0 || !packName(path.substring(0, separator)))
+                    throw new IOException("Invalid vanilla resource pack");
+                grouped.computeIfAbsent(path.substring(0, separator), name -> new LinkedHashMap<>())
+                        .put(path.substring(separator + 1), entry.getValue());
+            }
+            final List<Pack> packs = new ArrayList<>();
+            for (final String name : grouped.keySet().stream().sorted(PACK_ORDER).toList()) {
+                if (!packs.isEmpty() && PACK_ORDER.compare(packs.getLast().name, name) == 0)
+                    throw new IOException("Ambiguous vanilla overlay version");
+                packs.add(new Pack(name, Map.copyOf(grouped.get(name))));
+            }
+            return new BedrockResourceLibrary(packs);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid vanilla resource library", invalid);
+        }
+    }
+
+    static boolean packName(final String name) {
+        if (name.equals("vanilla") || name.equals("vanilla_base")) return true;
+        final var match = VERSION_PACK.matcher(name);
+        if (!match.matches()) return false;
+        try {
+            for (int part = 1; part <= 3; part++)
+                if (match.group(part) != null) Integer.parseInt(match.group(part));
+            return true;
+        } catch (NumberFormatException invalid) {
+            return false;
+        }
+    }
+
+    private static final Comparator<String> PACK_ORDER =
+            (left, right) -> {
+                final int leftRank = rank(left), rightRank = rank(right);
+                if (leftRank != rightRank) return Integer.compare(leftRank, rightRank);
+                if (leftRank < 2) return 0;
+                final String[] leftParts = left.substring("vanilla_".length()).split("\\.");
+                final String[] rightParts = right.substring("vanilla_".length()).split("\\.");
+                for (int part = 0; part < 3; part++) {
+                    final int result =
+                            Integer.compare(
+                                    part < leftParts.length ? Integer.parseInt(leftParts[part]) : 0,
+                                    part < rightParts.length
+                                            ? Integer.parseInt(rightParts[part])
+                                            : 0);
+                    if (result != 0) return result;
+                }
+                return 0;
+            };
+
+    private static int rank(final String pack) {
+        return pack.equals("vanilla") ? 0 : pack.equals("vanilla_base") ? 1 : 2;
+    }
+
+    List<String> packNames() {
+        return this.packs.stream().map(Pack::name).toList();
+    }
+
+    byte[] file(final String path) throws IOException {
+        BedrockBuiltinAssets.validPath(path);
+        for (int index = this.packs.size() - 1; index >= 0; index--) {
+            final byte[] bytes = this.packs.get(index).files.get(path);
+            if (bytes != null) return bytes;
+        }
+        return null;
+    }
+
+    JsonObject particle(final String identifier) throws IOException {
+        JsonObject selected = null;
+        int count = 0;
+        for (final Pack pack : this.packs) {
+            final Map<String, JsonObject> local = new LinkedHashMap<>();
+            for (final var entry : pack.files.entrySet()) {
+                if (!entry.getKey().startsWith("particles/") || !entry.getKey().endsWith(".json")) continue;
+                if (++count > 4096) throw new IOException("Too many particle definitions");
+                final JsonObject document = BedrockParticleDefinition.read(entry.getValue());
+                final String name = document.getAsJsonObject("particle_effect").getAsJsonObject("description").get("identifier").getAsString();
+                final JsonObject previous = local.putIfAbsent(name, document);
+                if (previous != null && !previous.equals(document)) throw new IOException("Conflicting particle identifiers");
+            }
+            if (local.containsKey(identifier)) selected = local.get(identifier);
+        }
+        return selected;
+    }
+
+    byte[] particleTexture(final String path) throws IOException {
+        BedrockBuiltinAssets.validPath(path);
+        if (!path.startsWith("textures/")) throw new IOException("Invalid particle texture path");
+        for (int index = this.packs.size() - 1; index >= 0; index--) {
+            final Map<String, byte[]> files = this.packs.get(index).files;
+            if (path.endsWith(".png") || path.endsWith(".tga")) {
+                if (files.containsKey(path)) return files.get(path);
+            } else {
+                for (final String extension : List.of(".png", ".tga"))
+                    if (files.containsKey(path + extension)) return files.get(path + extension);
+            }
+        }
+        return null;
+    }
+
+    byte[] sound(final String path) throws IOException {
+        BedrockBuiltinAssets.validPath(path);
+        if (!path.startsWith("sounds/")) throw new IOException("Invalid built-in sound path");
+        if (path.endsWith(".fsb") || path.endsWith(".ogg")) return this.file(path);
+        // A higher pack can replace an FSB bank with an Ogg file. Resolve the pack
+        // before its extension, retaining the native FSB-before-Ogg search order.
+        for (int index = this.packs.size() - 1; index >= 0; index--) {
+            final Map<String, byte[]> files = this.packs.get(index).files;
+            for (final String extension : List.of(".fsb", ".ogg")) {
+                final byte[] bytes = files.get(path + extension);
+                if (bytes != null) return bytes;
+            }
+        }
+        return null;
+    }
+
+    BedrockBuiltinAssets.Contents.ResolvedSound soundEvent(
+            final String name, final java.util.function.IntUnaryOperator random,
+            final float volume, final float pitch, final boolean forceNonpositional) throws IOException {
+        final BedrockSoundEvent event = this.sounds.get(name);
+        if (event == null) return null;
+        final BedrockSoundEvent.Selection selection = event.select(random, volume, pitch, forceNonpositional);
+        if (selection == null) return null;
+        return new BedrockBuiltinAssets.Contents.ResolvedSound(
+                event, selection, BedrockSoundFile.read(this.sound(selection.sample().name())));
+    }
+
+    JsonObject model(final String identifier) throws IOException {
+        final List<JsonObject> definitions = this.models.get(identifier);
+        if (definitions == null) return null;
+        if (definitions.size() != 1) throw new IOException("The built-in model name is ambiguous");
+        return definitions.getFirst();
+    }
+
+    Map<String, Definition> definitions(final String directory, final String field)
+            throws IOException {
+        try {
+            final Map<String, Definition> resolved = new LinkedHashMap<>();
+            for (final Pack pack : this.packs) {
+                final Map<String, Definition> local = new LinkedHashMap<>();
+                for (final var entry : pack.files.entrySet()) {
+                    if (!entry.getKey().startsWith(directory + "/")
+                            || !entry.getKey().endsWith(".json")) continue;
+                    final JsonObject document = json(entry.getValue());
+                    final JsonObject definitions = document.getAsJsonObject(field);
+                    if (definitions == null) continue;
+                    final String version =
+                            document.has("format_version")
+                                    ? document.get("format_version").getAsString()
+                                    : "1.10.0";
+                    for (final var definition : definitions.entrySet()) {
+                        final Definition value =
+                                new Definition(definition.getValue().getAsJsonObject(), version);
+                        final Definition previous = local.putIfAbsent(definition.getKey(), value);
+                        if (previous != null && !previous.equals(value))
+                            throw new IOException("Ambiguous resource identifier in " + pack.name);
+                    }
+                    if (local.size() > 4096)
+                        throw new IOException("Too many actor animation resources");
+                }
+                resolved.putAll(local);
+                if (resolved.size() > 4096)
+                    throw new IOException("Too many actor animation resources");
+            }
+            return Map.copyOf(resolved);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid actor animation resource", invalid);
+        }
+    }
+
+    JsonObject entity(final String identifier) throws IOException {
+        try {
+            JsonObject resolved = null;
+            for (final Pack pack : this.packs) {
+                JsonObject local = null;
+                for (final var entry : pack.files.entrySet()) {
+                    if (!entry.getKey().startsWith("entity/") || !entry.getKey().endsWith(".json"))
+                        continue;
+                    final JsonObject entity =
+                            json(entry.getValue()).getAsJsonObject("minecraft:client_entity");
+                    if (entity == null
+                            || !identifier.equals(
+                                    entity.getAsJsonObject("description")
+                                            .get("identifier")
+                                            .getAsString())) continue;
+                    if (local != null && !local.equals(entity))
+                        throw new IOException("Ambiguous client entity identifier in " + pack.name);
+                    local = entity;
+                }
+                if (local != null) resolved = local;
+            }
+            if (resolved == null)
+                throw new IOException("The client entity resource is missing: " + identifier);
+            return resolved;
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid client entity resource", invalid);
+        }
+    }
+
+    Map<String, BedrockSoundEvent> soundDefinitions() {
+        return this.sounds;
+    }
+
+    private Map<String, BedrockSoundEvent> readSounds() throws IOException {
+        try {
+            final Map<String, JsonObject> resolved = new LinkedHashMap<>();
+            for (final Pack pack : this.packs) {
+                final byte[] bytes = pack.files.get("sounds/sound_definitions.json");
+                if (bytes == null) continue;
+                final JsonObject document = json(bytes);
+                final JsonObject definitions =
+                        document.has("sound_definitions")
+                                ? document.getAsJsonObject("sound_definitions")
+                                : document;
+                for (final var entry : definitions.entrySet()) {
+                    if (entry.getKey().equals("format_version")) continue;
+                    resolved.put(
+                            entry.getKey(),
+                            entry.getValue().getAsJsonObject());
+                }
+                if (resolved.size() > 4096) throw new IOException("Too many sound definitions");
+            }
+            final Map<String, BedrockSoundEvent> sounds = new LinkedHashMap<>();
+            for (final var entry : resolved.entrySet())
+                sounds.put(entry.getKey(), BedrockSoundEvent.read(entry.getValue()));
+            return Map.copyOf(sounds);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid sound definition catalog", invalid);
+        }
+    }
+
+    private static JsonObject format(final JsonObject document) {
+        final JsonObject selected = new JsonObject();
+        if (document.has("format_version"))
+            selected.add("format_version", document.get("format_version").deepCopy());
+        return selected;
+    }
+
+    private static void addModel(
+            final Map<String, List<JsonObject>> models,
+            final String identifier,
+            final JsonObject document)
+            throws IOException {
+        if (!MODEL_IDENTIFIER.matcher(identifier).matches())
+            throw new IOException("Invalid built-in model identifier");
+        final List<JsonObject> definitions =
+                models.computeIfAbsent(identifier, name -> new ArrayList<>());
+        if (!definitions.contains(document)) definitions.add(document);
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("Missing or oversized vanilla resource");
+        try {
+            return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                    .getAsJsonObject();
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid vanilla resource", invalid);
+        }
+    }
+
+    record Definition(JsonObject value, String formatVersion) {}
+
+    private record Pack(String name, Map<String, byte[]> files) {}
+}
