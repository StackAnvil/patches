+
+final class BedrockPersonaModelTest {
+
+    @Test
+    void packsTextureAndTranslatesMeshIntoBedrockCoordinates() throws Exception {
+        final byte[] glb = model();
+        final var converted = BedrockPersonaModel.convert(glb);
+        final var geometry = JsonParser.parseString(converted.geometry()).getAsJsonObject();
+        final var body = geometry.getAsJsonArray("minecraft:geometry").get(0).getAsJsonObject()
+            .getAsJsonArray("bones").get(1).getAsJsonObject();
+        final var mesh = body.getAsJsonObject("poly_mesh");
+
+        assertEquals(128, converted.atlas().getWidth());
+        assertEquals(0xFF2474A8, converted.atlas().getRGB(0, 0));
+        assertEquals(24F, body.getAsJsonArray("pivot").get(1).getAsFloat());
+        assertEquals(-5F, body.getAsJsonArray("pivot").get(2).getAsFloat());
+        assertEquals(-6F, mesh.getAsJsonArray("positions").get(0).getAsJsonArray().get(2).getAsFloat());
+        assertEquals(-1F, mesh.getAsJsonArray("normals").get(0).getAsJsonArray().get(2).getAsFloat());
+        assertEquals(25F, mesh.getAsJsonArray("positions").get(1).getAsJsonArray().get(1).getAsFloat());
+        assertEquals(1F, mesh.getAsJsonArray("positions").get(2).getAsJsonArray().get(0).getAsFloat());
+        assertEquals(24F, mesh.getAsJsonArray("positions").get(0).getAsJsonArray().get(1).getAsFloat());
+        assertEquals(1F, mesh.getAsJsonArray("uvs").get(0).getAsJsonArray().get(1).getAsFloat());
+        assertEquals("tri_list", mesh.get("polys").getAsString());
