+    void matchesNativeItemNameSourcesAndArgumentHandling() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_ITEM_NAMES")))).getAsJsonArray();
+        for (final var raw : fixture) {
+            final var row = raw.getAsJsonObject();
+            final String sourceName = "item" + (row.get("component").getAsBoolean() ? 29 : 13);
+            final var item = row.get("empty").getAsBoolean() ? BedrockItemAnimation.Item.EMPTY
+                    : BedrockItemAnimation.Item.fromIdentifiers("probe:" + sourceName, "paper", 0, false, ItemAnimationData.EMPTY);
+            final var items = new BedrockItemAnimation(item, item, item, item, 0);
+            final var hashes = row.getAsJsonArray("hashes");
+            final String expected = hashes.isEmpty() || hashes.get(0).getAsLong() == 0 ? ""
+                    : "item" + hashes.get(0).getAsLong();
+            assertEquals(expected, query(items.queries(), "get_equipped_item_name", arguments(row.get("args"))), row.toString());
+        }
+    }
+
+    private static List<Object> arguments(final JsonElement value) {
+        final List<Object> arguments = new ArrayList<>();
+        for (final var item : value.getAsJsonArray())
+            arguments.add(
+                    item.getAsJsonPrimitive().isString() ? item.getAsString() : item.getAsDouble());
+        return List.copyOf(arguments);
+    }
