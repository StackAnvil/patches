+    void inheritsLicensedActorAliasesRootsAndScriptFieldsAcrossPartialOverlays() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        put(files, "vanilla", "entity/player.json",
+                "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\","
+                        + "\"animations\":{\"right\":\"animation.fixture.right\",\"left\":\"animation.fixture.left\"},"
+                        + "\"scripts\":{\"animate\":[\"right\",\"left\"],\"scale\":0.9375}}}}");
+        put(files, "vanilla", "animations/arms.json",
+                "{\"animations\":{\"animation.fixture.right\":{\"loop\":true,\"bones\":{\"rightArm\":{\"position\":[2,3,4]}}},"
+                        + "\"animation.fixture.left\":{\"loop\":true,\"bones\":{\"leftArm\":{\"position\":[1,6,-1]}}}}}");
+        put(files, "vanilla_1.10.0", "entity/overlay.json",
+                "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\","
+                        + "\"animations\":{\"right\":\"animation.fixture.overlay_right\"},\"scripts\":{\"scale\":0.875}}}}");
+        put(files, "vanilla_1.10.0", "animations/overlay.json",
+                "{\"animations\":{\"animation.fixture.overlay_right\":{\"loop\":true,\"bones\":{\"rightArm\":{\"position\":[8,9,10]}}}}}");
+        final var library = BedrockResourceLibrary.read(files);
+        final var playback = BedrockActorAnimation.read(library, BedrockClassicOptions.EMPTY).playback();
+        final var pose = playback.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        final var right = pose.get("rightArm").position();
+        final var left = pose.get("leftArm").position();
+        assertEquals(List.of(8F, 9F, 10F), List.of(right.x(), right.y(), right.z()));
+        assertEquals(List.of(1F, 6F, -1F), List.of(left.x(), left.y(), left.z()));
+        assertEquals(.875F, playback.scale().x());
+        final var resolved = library.entity("minecraft:player");
+        resolved.getAsJsonObject("description").remove("scripts");
+        assertTrue(library.entity("minecraft:player").getAsJsonObject("description").has("scripts"));
+        final var overlay = new JsonObject();
+        overlay.addProperty("identifier", "minecraft:player");
+        final var scripts = new JsonObject();
+        scripts.add("animate", new com.google.gson.JsonArray());
+        overlay.add("scripts", scripts);
+        final var entity = new JsonObject();
+        entity.add("description", overlay);
+        final var document = new JsonObject();
+        document.add("minecraft:client_entity", entity);
+        put(files, "vanilla_1.11.0", "entity/empty.json", document.toString());
+        final var empty = BedrockActorAnimation.read(BedrockResourceLibrary.read(files), BedrockClassicOptions.EMPTY).playback();
+        assertTrue(empty.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of())).isEmpty());
+        assertEquals(.875F, empty.scale().y());
+    }
+
+}
