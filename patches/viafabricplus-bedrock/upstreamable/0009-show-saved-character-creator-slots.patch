+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import java.lang.ref.WeakReference;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.Map;
+import java.util.WeakHashMap;
+import net.minecraft.client.model.geom.ModelPart;
+import org.joml.Matrix4f;
+
+/** Retains full native matrices during drawing and bounds visits, including singular parent scales. */
+public final class BedrockModelTransforms {
+    private static final Map<ModelPart, Binding> BINDINGS = Collections.synchronizedMap(new WeakHashMap<>());
+    private static final ThreadLocal<Frame> FRAME = new ThreadLocal<>();
+
+    private BedrockModelTransforms() {
+    }
+
+    static void register(final BedrockAnimatedModel model, final ModelPart root, final Collection<ModelPart> bones) {
+        final var owner = new WeakReference<>(model);
+        BINDINGS.put(root, new Binding(owner, true));
+        for (final ModelPart bone : bones) BINDINGS.put(bone, new Binding(owner, false));
+    }
+
+    public static void visit(final ModelPart part, final PoseStack poses, final Runnable original) {
+        final Binding binding = BINDINGS.get(part);
+        final BedrockAnimatedModel owner = binding == null ? null : binding.owner.get();
+        if (owner == null || !binding.root || !owner.usesNativeMatrices()) {
+            original.run();
+            return;
+        }
+        final Frame previous = FRAME.get();
+        try {
+            FRAME.set(new Frame(owner, poses, owner.drawingMatrices()));
+            original.run();
+        } finally {
+            if (previous == null) FRAME.remove();
+            else FRAME.set(previous);
+        }
+    }
+
+    public static void transform(final ModelPart part, final PoseStack poses, final Runnable original) {
+        final Frame frame = FRAME.get();
+        final Binding binding = frame == null ? null : BINDINGS.get(part);
+        if (binding == null || binding.owner.get() != frame.owner || poses != frame.poses) {
+            original.run();
+            return;
+        }
+        if (binding.root) {
+            original.run();
+            frame.base = new Matrix4f(poses.last().pose());
+        } else if (frame.base == null) {
+            original.run();
+        } else {
+            final var pose = poses.last();
+            pose.setIdentity();
+            pose.mulPose(new Matrix4f(frame.base).mul(frame.matrices.get(part)));
+        }
+    }
+
+    private record Binding(WeakReference<BedrockAnimatedModel> owner, boolean root) {
+    }
+
+    private static final class Frame {
+        private final BedrockAnimatedModel owner;
+        private final PoseStack poses;
+        private final Map<ModelPart, Matrix4f> matrices;
+        private Matrix4f base;
+
+        private Frame(final BedrockAnimatedModel owner, final PoseStack poses, final Map<ModelPart, Matrix4f> matrices) {
+            this.owner = owner;
+            this.poses = poses;
+            this.matrices = matrices;
+        }
+    }
+}
