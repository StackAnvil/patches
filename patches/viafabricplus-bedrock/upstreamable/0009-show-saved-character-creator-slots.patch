+/** Converts the account's assembled GLTF preview into a static Bedrock player geometry and atlas. */
+public final class BedrockPersonaModel {
+
+    private static final int MAX_MODEL_BYTES = 4 * 1024 * 1024;
+    private static final int MAX_VERTICES = 32768;
+    private static final int GLTF_MAGIC = 0x46546C67;
+    private static final int JSON_CHUNK = 0x4E4F534A;
+    private static final int BINARY_CHUNK = 0x004E4942;
+
+    private BedrockPersonaModel() {
+    }
+
+    public static Converted convert(final byte[] source) throws IOException {
+        if (source.length < 28 || source.length > MAX_MODEL_BYTES) {
+            throw new IOException("Bedrock character model has an invalid size");
+        }
+        try {
+            return parse(source);
+        } catch (RuntimeException e) {
+            throw new IOException("Bedrock character model is invalid", e);
+        }
+    }
+
+    private static Converted parse(final byte[] source) throws IOException {
+        final ByteBuffer file = ByteBuffer.wrap(source).order(ByteOrder.LITTLE_ENDIAN);
+        if (file.getInt() != GLTF_MAGIC || file.getInt() != 2 || file.getInt() != source.length) {
+            throw new IOException("Bedrock did not return a GLTF 2 model");
+        }
+        final int jsonLength = file.getInt();
+        if (file.getInt() != JSON_CHUNK || jsonLength < 2 || jsonLength > file.remaining()) {
+            throw new IOException("Bedrock character model has no JSON chunk");
+        }
+        final byte[] jsonBytes = new byte[jsonLength];
+        file.get(jsonBytes);
+        final JsonObject gltf = JsonParser.parseString(new String(jsonBytes, StandardCharsets.UTF_8)).getAsJsonObject();
+        if (file.remaining() < 8) {
+            throw new IOException("Bedrock character model has no binary chunk");
+        }
+        final int binaryLength = file.getInt();
+        if (file.getInt() != BINARY_CHUNK || binaryLength < 0 || binaryLength != file.remaining()) {
+            throw new IOException("Bedrock character model has an invalid binary chunk");
+        }
+        final ByteBuffer binary = file.slice().order(ByteOrder.LITTLE_ENDIAN);
+        final Model model = new Model(gltf, binary);
+        return model.convert();
+    }
+
+    public record Converted(BufferedImage atlas, String geometry, String resourcePatch, List<net.raphimc.viabedrock.protocol.model.SkinData.AnimationData> animations) {
+        public Converted { animations = List.copyOf(animations); }
+    }
+
+    private record Placement(BufferedImage image, int x, int y) {
+    }
+
+    private static final class Model {
+
+        private final JsonObject data;
+        private final ByteBuffer binary;
+        private final JsonArray views;
+        private final JsonArray accessors;
+        private final JsonArray nodes;
+        private final JsonArray meshes;
+        private final JsonArray materials;
+        private final JsonArray textures;
+        private final List<BufferedImage> images;
+        private final Set<String> names = new HashSet<>();
+        private final Set<Integer> visited = new HashSet<>();
+        private int atlasSize;
+        private List<Placement> placements;
+        private int vertexCount;
+
+        private Model(final JsonObject data, final ByteBuffer binary) throws IOException {
+            this.data = data;
+            this.binary = binary;
+            this.views = array(data, "bufferViews");
+            this.accessors = array(data, "accessors");
+            this.nodes = array(data, "nodes");
+            this.meshes = array(data, "meshes");
+            this.materials = array(data, "materials");
+            this.textures = array(data, "textures");
+            this.images = this.readImages();
+            if (this.nodes.isEmpty() || this.meshes.isEmpty() || this.images.isEmpty()) {
+                throw new IOException("Bedrock character model has no geometry or textures");
+            }
+        }
+
+        private Converted convert() throws IOException {
+            this.packImages();
+            final BufferedImage atlas = new BufferedImage(this.atlasSize, this.atlasSize, BufferedImage.TYPE_INT_ARGB);
+            final Graphics2D graphics = atlas.createGraphics();
+            try {
+                for (final Placement placement : this.placements) {
+                    graphics.drawImage(placement.image(), placement.x(), placement.y(), null);
+                }
+            } finally {
+                graphics.dispose();
+            }
+
+            final JsonArray bones = new JsonArray();
+            final JsonArray scenes = array(this.data, "scenes");
+            if (scenes.isEmpty()) {
+                throw new IOException("Bedrock character model has no scene");
+            }
+            final int sceneIndex = number(this.data, "scene", 0);
+            for (final JsonElement root : array(scenes.get(sceneIndex).getAsJsonObject(), "nodes")) {
+                this.visit(root.getAsInt(), null, new float[3], bones, 0);
+            }
+            if (this.vertexCount == 0) {
+                throw new IOException("Bedrock character model has no triangles");
+            }
+            final String identifier = "geometry.viafabricplus.account_character";
+            final JsonObject description = new JsonObject();
+            description.addProperty("identifier", identifier);
+            description.addProperty("texture_width", this.atlasSize);
+            description.addProperty("texture_height", this.atlasSize);
+            final JsonObject model = new JsonObject();
+            model.add("description", description);
+            model.add("bones", bones);
+            final JsonArray definitions = new JsonArray();
+            definitions.add(model);
+            final JsonObject geometry = new JsonObject();
+            geometry.addProperty("format_version", "1.12.0");
+            geometry.add("minecraft:geometry", definitions);
+            return new Converted(atlas, geometry.toString(),
+                "{\"geometry\":{\"default\":\"" + identifier + "\"}}", List.of());
+        }
+
+        private void visit(final int index, final String parent, final float[] offset,
+                           final JsonArray bones, final int depth) throws IOException {
+            if (index < 0 || index >= this.nodes.size() || depth > 64 || !this.visited.add(index)) {
+                throw new IOException("Bedrock character model has an invalid node tree");
+            }
+            final JsonObject node = this.nodes.get(index).getAsJsonObject();
+            if (node.has("rotation") || node.has("scale") || node.has("matrix")) {
+                throw new IOException("Bedrock character model uses unsupported node transforms");
+            }
+            final String name = string(node, "name", "node" + index).toLowerCase(Locale.ROOT);
+            if (!name.matches("[a-z0-9_]+") || !this.names.add(name)) {
+                throw new IOException("Bedrock character model has duplicate or invalid bone names");
+            }
+            final float[] pivot = offset.clone();
+            final JsonArray translation = array(node, "translation");
+            if (!translation.isEmpty()) {
+                if (translation.size() != 3) {
+                    throw new IOException("Bedrock character model has an invalid translation");
+                }
+                for (int component = 0; component < 3; component++) {
+                    pivot[component] += translation.get(component).getAsFloat() * (component == 2 ? -1F : 1F);
+                }
+            }
+            final JsonObject bone = new JsonObject();
+            bone.addProperty("name", name);
+            if (parent != null) {
+                bone.addProperty("parent", parent);
+            }
+            bone.add("pivot", vector(pivot));
+            if (node.has("mesh")) {
+                bone.add("poly_mesh", this.mesh(node.get("mesh").getAsInt(), pivot));
+            }
+            bones.add(bone);
+            for (final JsonElement child : array(node, "children")) {
+                this.visit(child.getAsInt(), name, pivot, bones, depth + 1);
+            }
+        }
+
+        private JsonObject mesh(final int index, final float[] offset) throws IOException {
+            final JsonArray positions = new JsonArray();
+            final JsonArray normals = new JsonArray();
+            final JsonArray uvs = new JsonArray();
+            for (final JsonElement entry : array(this.meshes.get(index).getAsJsonObject(), "primitives")) {
+                final JsonObject primitive = entry.getAsJsonObject();
+                if (number(primitive, "mode", 4) != 4) {
+                    throw new IOException("Bedrock character model has non-triangle geometry");
+                }
+                final JsonObject attributes = object(primitive, "attributes");
+                final float[][] sourcePositions = this.floats(attributes.get("POSITION").getAsInt(), 3);
+                final float[][] sourceNormals = this.floats(attributes.get("NORMAL").getAsInt(), 3);
+                final float[][] sourceUvs = this.floats(attributes.get("TEXCOORD_0").getAsInt(), 2);
+                if (sourcePositions.length != sourceNormals.length || sourcePositions.length != sourceUvs.length) {
+                    throw new IOException("Bedrock character model has mismatched vertex data");
+                }
+                final Placement image = this.texture(primitive.get("material").getAsInt());
+                final int[] indices = primitive.has("indices")
+                    ? this.indices(primitive.get("indices").getAsInt()) : sequential(sourcePositions.length);
+                if (indices.length % 3 != 0 || (this.vertexCount += indices.length) > MAX_VERTICES) {
+                    throw new IOException("Bedrock character model has too many vertices");
+                }
+                // ModelBinary faces +Z; native skin geometry faces -Z. Reflect Z and reverse
+                // each triangle so its winding still agrees with the reflected normal.
+                for (int corner = 0; corner < indices.length; corner++) {
+                    final int vertex = indices[corner % 3 == 0 ? corner : corner % 3 == 1 ? corner + 1 : corner - 1];
+                    if (vertex < 0 || vertex >= sourcePositions.length) {
+                        throw new IOException("Bedrock character model has an invalid vertex index");
+                    }
+                    final float[] position = sourcePositions[vertex].clone();
+                    position[2] = -position[2];
+                    for (int component = 0; component < 3; component++) {
+                        position[component] += offset[component];
+                    }
+                    positions.add(vector(position));
+                    final float[] normal = sourceNormals[vertex].clone();
+                    normal[2] = -normal[2];
+                    normals.add(vector(normal));
+                    final float[] uv = sourceUvs[vertex];
+                    final JsonArray mapped = new JsonArray();
+                    mapped.add((image.x() + uv[0] * image.image().getWidth()) / this.atlasSize);
+                    mapped.add(1F - (image.y() + uv[1] * image.image().getHeight()) / this.atlasSize);
+                    uvs.add(mapped);
+                }
+            }
+            final JsonObject mesh = new JsonObject();
+            mesh.addProperty("normalized_uvs", true);
+            mesh.add("positions", positions);
+            mesh.add("normals", normals);
+            mesh.add("uvs", uvs);
+            mesh.addProperty("polys", "tri_list");
+            return mesh;
+        }
+
+        private Placement texture(final int materialIndex) throws IOException {
+            final JsonObject material = this.materials.get(materialIndex).getAsJsonObject();
+            final JsonObject pbr = object(material, "pbrMetallicRoughness");
+            if (pbr.has("baseColorFactor")) {
+                final JsonArray factor = pbr.getAsJsonArray("baseColorFactor");
+                for (final JsonElement channel : factor) {
+                    if (channel.getAsFloat() != 1F) {
+                        throw new IOException("Bedrock character model has an unsupported material tint");
+                    }
+                }
+            }
+            final int texture = object(pbr, "baseColorTexture").get("index").getAsInt();
+            final int image = this.textures.get(texture).getAsJsonObject().get("source").getAsInt();
+            return this.placements.get(image);
+        }
+
+        private float[][] floats(final int index, final int dimensions) throws IOException {
+            final JsonObject accessor = this.accessors.get(index).getAsJsonObject();
+            if (number(accessor, "componentType", 0) != 5126
+                || !String.valueOf("VEC" + dimensions).equals(string(accessor, "type", ""))) {
+                throw new IOException("Bedrock character model has unsupported vertex data");
+            }
+            final int count = number(accessor, "count", 0);
+            if (count < 0 || count > MAX_VERTICES) {
+                throw new IOException("Bedrock character model has too many vertex values");
+            }
+            final JsonObject view = this.views.get(accessor.get("bufferView").getAsInt()).getAsJsonObject();
+            final int viewOffset = number(view, "byteOffset", 0);
+            final int viewLength = number(view, "byteLength", 0);
+            final int accessorOffset = number(accessor, "byteOffset", 0);
+            final long start = (long) viewOffset + accessorOffset;
+            final int stride = number(view, "byteStride", dimensions * Float.BYTES);
+            final long end = start + (count == 0 ? 0L : (long) (count - 1) * stride + dimensions * Float.BYTES);
+            if (viewOffset < 0 || viewLength < 0 || accessorOffset < 0 || stride < dimensions * Float.BYTES
+                || end > (long) viewOffset + viewLength || end > this.binary.limit()) {
+                throw new IOException("Bedrock character model has an invalid vertex buffer");
+            }
+            final float[][] values = new float[count][dimensions];
+            for (int row = 0; row < count; row++) {
+                for (int component = 0; component < dimensions; component++) {
+                    final float value = this.binary.getFloat((int) (start + (long) row * stride + component * Float.BYTES));
+                    if (!Float.isFinite(value)) {
+                        throw new IOException("Bedrock character model has a non-finite vertex value");
+                    }
+                    values[row][component] = value;
+                }
+            }
+            return values;
+        }
+
+        private int[] indices(final int index) throws IOException {
+            final JsonObject accessor = this.accessors.get(index).getAsJsonObject();
+            final int type = number(accessor, "componentType", 0);
+            final int width = switch (type) {
+                case 5121 -> 1;
+                case 5123 -> 2;
+                case 5125 -> 4;
+                default -> throw new IOException("Bedrock character model has unsupported triangle indices");
+            };
+            if (!"SCALAR".equals(string(accessor, "type", ""))) {
+                throw new IOException("Bedrock character model has invalid triangle indices");
+            }
+            final int count = number(accessor, "count", 0);
+            final JsonObject view = this.views.get(accessor.get("bufferView").getAsInt()).getAsJsonObject();
+            final int viewOffset = number(view, "byteOffset", 0);
+            final int viewLength = number(view, "byteLength", 0);
+            final int accessorOffset = number(accessor, "byteOffset", 0);
+            final long start = (long) viewOffset + accessorOffset;
+            final int stride = number(view, "byteStride", width);
+            final long end = start + (count == 0 ? 0L : (long) (count - 1) * stride + width);
+            if (count < 0 || count > MAX_VERTICES || viewOffset < 0 || viewLength < 0 || accessorOffset < 0
+                || stride < width || end > (long) viewOffset + viewLength || end > this.binary.limit()) {
+                throw new IOException("Bedrock character model has an invalid triangle buffer");
+            }
+            final int[] values = new int[count];
+            for (int position = 0; position < count; position++) {
+                final int offset = (int) (start + (long) position * stride);
+                values[position] = switch (width) {
+                    case 1 -> Byte.toUnsignedInt(this.binary.get(offset));
+                    case 2 -> Short.toUnsignedInt(this.binary.getShort(offset));
+                    default -> this.binary.getInt(offset);
+                };
+            }
+            return values;
+        }
+
+        private List<BufferedImage> readImages() throws IOException {
+            final JsonArray descriptions = array(this.data, "images");
+            if (descriptions.size() > 32) {
+                throw new IOException("Bedrock character model has too many textures");
+            }
+            final List<BufferedImage> result = new ArrayList<>(descriptions.size());
+            for (final JsonElement entry : descriptions) {
+                final JsonObject image = entry.getAsJsonObject();
+                if (!"image/png".equals(string(image, "mimeType", ""))) {
+                    throw new IOException("Bedrock character model has an unsupported texture");
+                }
+                final JsonObject view = this.views.get(image.get("bufferView").getAsInt()).getAsJsonObject();
+                final int offset = number(view, "byteOffset", 0);
+                final int length = number(view, "byteLength", 0);
+                if (offset < 0 || length < 8 || length > 1024 * 1024 || offset + (long) length > this.binary.limit()) {
+                    throw new IOException("Bedrock character model has an invalid texture buffer");
+                }
+                final byte[] png = new byte[length];
+                this.binary.duplicate().position(offset).get(png);
+                try (ImageInputStream input = ImageIO.createImageInputStream(new ByteArrayInputStream(png))) {
+                    final var readers = ImageIO.getImageReaders(input);
+                    if (!readers.hasNext()) {
+                        throw new IOException("Bedrock character model has an invalid PNG texture");
+                    }
+                    final ImageReader reader = readers.next();
+                    try {
+                        if (!"png".equalsIgnoreCase(reader.getFormatName())) {
+                            throw new IOException("Bedrock character model has a non-PNG texture");
+                        }
+                        reader.setInput(input);
+                        final int width = reader.getWidth(0);
+                        final int height = reader.getHeight(0);
+                        if (width < 1 || height < 1 || width > 512 || height > 512
+                            || Integer.bitCount(width) != 1 || Integer.bitCount(height) != 1) {
+                            throw new IOException("Bedrock character model has unsupported texture dimensions");
+                        }
+                        result.add(reader.read(0));
+                    } finally {
+                        reader.dispose();
+                    }
+                }
+            }
+            return List.copyOf(result);
+        }
+
+        private void packImages() throws IOException {
+            for (int size = 128; size <= 1024; size *= 2) {
+                final List<Placement> packed = new ArrayList<>(this.images.size());
+                int x = 0;
+                int y = 0;
+                int rowHeight = 0;
+                for (final BufferedImage image : this.images) {
+                    if (image.getWidth() > size || image.getHeight() > size) {
+                        break;
+                    }
+                    if (x + image.getWidth() > size) {
+                        x = 0;
+                        y += rowHeight;
+                        rowHeight = 0;
+                    }
+                    if (y + image.getHeight() > size) {
+                        break;
+                    }
+                    packed.add(new Placement(image, x, y));
+                    x += image.getWidth();
+                    rowHeight = Math.max(rowHeight, image.getHeight());
+                }
+                if (packed.size() == this.images.size()) {
+                    this.atlasSize = size;
+                    this.placements = List.copyOf(packed);
+                    return;
+                }
+            }
+            throw new IOException("Bedrock character textures do not fit a skin atlas");
+        }
+
+        private static int[] sequential(final int length) {
+            final int[] values = new int[length];
+            for (int index = 0; index < length; index++) {
+                values[index] = index;
+            }
+            return values;
+        }
+
+        private static JsonArray vector(final float[] values) {
+            final JsonArray vector = new JsonArray();
+            for (final float value : values) {
+                vector.add(value);
+            }
+            return vector;
+        }
+
+        private static JsonArray array(final JsonObject object, final String key) {
+            return object.has(key) && object.get(key).isJsonArray() ? object.getAsJsonArray(key) : new JsonArray();
+        }
+
+        private static JsonObject object(final JsonObject parent, final String key) {
+            return parent.has(key) && parent.get(key).isJsonObject() ? parent.getAsJsonObject(key) : new JsonObject();
+        }
+
+        private static int number(final JsonObject object, final String key, final int fallback) {
+            return object.has(key) ? object.get(key).getAsInt() : fallback;
+        }
+
+        private static String string(final JsonObject object, final String key, final String fallback) {
+            return object.has(key) ? object.get(key).getAsString() : fallback;
+        }
+    }
+}
