+                new BedrockItemAnimation.Use(food, food, 21, BedrockItemAnimation.Action.OTHER)
+                        .variables();
+        assertEquals(1F, cycle.get("use_item_startup_progress"));
+        assertEquals(0.75F, cycle.get("use_item_interval_progress"));
+        assertEquals(0F, cycle.get("charge_amount"));
+        final var trident = new BedrockItemAnimation.Item("trident", 72000, false);
+        final var charge =
+                new BedrockItemAnimation.Use(
+                                trident, trident, 71995, BedrockItemAnimation.Action.TRIDENT)
+                        .variables();
+        assertEquals(1F, charge.get("is_brandishing_spear"));
