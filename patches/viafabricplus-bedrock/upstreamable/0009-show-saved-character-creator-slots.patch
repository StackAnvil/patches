+                        if (eventsEnabled) run(this.current.definition.entry);
+                        entered = this.current;
+                    } else {
+                        queryState = this.current;
+                        this.current.time += delta;
+                        boolean transitioned = false;
+                        for (final Transition transition : this.current.definition.transitions) {
+                            if (molang.evaluate(transition.condition, 0) == 0) continue;
+                            final StatePlayback previous = this.current;
+                            this.current = this.state(transition.target);
+                            this.current.reset();
+                            this.outgoing = previous.definition.blend.isEmpty() ? null : previous;
+                            this.blendTime = 0;
+                            if (!first && previous != this.current && eventsEnabled)
+                                run(previous.definition.exit);
+                            if (first || previous != this.current) {
+                                if (eventsEnabled) run(this.current.definition.entry);
+                                entered = this.current;
+                            }
+                            transitioned = true;
+                            break;
+                        }
+                        if (first && !transitioned) {
+                            if (eventsEnabled) run(this.current.definition.entry);
+                            entered = this.current;
