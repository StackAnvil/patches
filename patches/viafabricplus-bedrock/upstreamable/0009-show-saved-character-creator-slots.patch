+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Model-space locators converted relative to their authored bone pivots. */
+final class BedrockModelLocators {
+    private BedrockModelLocators() {}
+
+    static Map<String, Locator> read(final JsonObject document, final String identifier) {
+        if (document.has("minecraft:geometry")) {
+            for (final var entry : document.getAsJsonArray("minecraft:geometry")) {
+                final JsonObject model = entry.getAsJsonObject();
+                if (identifier.equals(model.getAsJsonObject("description").get("identifier").getAsString()))
+                    return model(model, true);
+            }
+        } else if (document.has(identifier)) return model(document.getAsJsonObject(identifier), false);
+        return Map.of();
+    }
+
+    static Map<String, Locator> model(final JsonObject model) {
+        return model(model, true);
+    }
+
+    private static Map<String, Locator> model(final JsonObject model, final boolean modern) {
+        final Map<String, Locator> locators = new LinkedHashMap<>();
+        if (!model.has("bones")) return Map.of();
+        for (final var entry : model.getAsJsonArray("bones")) {
+            final JsonObject bone = entry.getAsJsonObject();
+            if (!bone.has("locators")) continue;
+            final String name = bone.get("name").getAsString();
+            final Vector3f pivot = vector(bone.get("pivot"));
+            for (final var location : bone.getAsJsonObject("locators").entrySet()) {
+                final JsonElement value = location.getValue();
+                final JsonObject properties = value.isJsonObject() ? value.getAsJsonObject() : null;
+                final Vector3f offset = vector(properties == null ? value : properties.get("offset"));
+                offset.sub(pivot).mul(1, -1, 1);
+                final Vector3f rotation = vector(modern && properties != null ? properties.get("rotation") : null);
+                final boolean ignoreScale = properties != null && properties.has("ignore_inherited_scale")
+                        && properties.get("ignore_inherited_scale").getAsBoolean();
+                if (location.getKey().length() > 512 || locators.size() >= 4096
+                        || locators.putIfAbsent(location.getKey(), new Locator(name, offset.x, offset.y, offset.z, rotation.x, rotation.y, rotation.z, ignoreScale)) != null)
+                    throw new IllegalArgumentException("Invalid or ambiguous model locator");
+            }
+        }
+        return Map.copyOf(locators);
+    }
+
+    private static Vector3f vector(final JsonElement element) {
+        if (element == null || element.isJsonNull()) return new Vector3f();
+        if (!element.isJsonArray() || element.getAsJsonArray().size() != 3)
+            throw new IllegalArgumentException("Invalid model locator vector");
+        final var values = element.getAsJsonArray();
+        final Vector3f vector = new Vector3f(values.get(0).getAsFloat(), values.get(1).getAsFloat(), values.get(2).getAsFloat());
+        if (!vector.isFinite() || Math.max(Math.max(Math.abs(vector.x), Math.abs(vector.y)), Math.abs(vector.z)) > 100000)
+            throw new IllegalArgumentException("Model locator exceeds coordinate limits");
+        return vector;
+    }
+
+    static Matrix4f transform(final Matrix4f bone, final Locator locator) {
+        final Matrix4f matrix = new Matrix4f(bone).translate(locator.x(), locator.y(), locator.z())
+                .rotateZYX((float) Math.toRadians(locator.rotationZ()), (float) Math.toRadians(locator.rotationY()),
+                        (float) Math.toRadians(locator.rotationX()));
+        if (!locator.ignoreScale()) return matrix;
+        // Native scale suppression preserves the translated attachment point and normalizes the final axes.
+        final float x = length(matrix.m00(), matrix.m01(), matrix.m02());
+        final float y = length(matrix.m10(), matrix.m11(), matrix.m12());
+        final float z = length(matrix.m20(), matrix.m21(), matrix.m22());
+        if (x == 0 || y == 0 || z == 0) return null;
+        final float inverseX = 1 / x, inverseY = 1 / y, inverseZ = 1 / z;
+        return matrix.m00(matrix.m00() * inverseX).m01(matrix.m01() * inverseX).m02(matrix.m02() * inverseX)
+                .m10(matrix.m10() * inverseY).m11(matrix.m11() * inverseY).m12(matrix.m12() * inverseY)
+                .m20(matrix.m20() * inverseZ).m21(matrix.m21() * inverseZ).m22(matrix.m22() * inverseZ);
+    }
+
+    private static float length(final float x, final float y, final float z) {
+        return (float) Math.sqrt((x * x + y * y) + z * z);
+    }
+
+    record Locator(String bone, float x, float y, float z,
+                   float rotationX, float rotationY, float rotationZ, boolean ignoreScale) {}
+}
