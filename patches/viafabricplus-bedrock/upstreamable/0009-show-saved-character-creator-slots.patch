+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+final class BedrockEmotesTest {
+    @Test
+    void resolvesTheReferencedAnimationAndPreservesTheWireIdentity() throws Exception {
+        final UUID id = UUID.randomUUID();
+        final var files = new HashMap<String, byte[]>();
+        files.put(
+                "wave.meta.json",
+                ("""
+                {"piece_type":"persona_emote","piece_id":"%s","animation_sources":[
+                  {"name":"animation.wave","animationFile":"wave.animation.json"}]}
+                """)
+                        .formatted(id)
+                        .getBytes(StandardCharsets.UTF_8));
+        files.put(
+                "wave.animation.json",
+                """
+                {"animations":{"animation.unused":{"bones":{}},"animation.wave":{
+                  "animation_length":4.75,"bones":{"rightArm":{"rotation":[90,0,0]}}
+                }}}
+                """
+                        .getBytes(StandardCharsets.UTF_8));
+        final UUID packId = UUID.randomUUID();
+        final var pack = new BedrockPersonaAssets.Pack(packId.toString(), files);
+        final var emote = BedrockEmotes.read(pack);
+        assertEquals(packId, emote.id());
+        assertEquals(4.75F, emote.animation().length());
+        assertEquals(
+                90,
+                emote.animation().playback().sample(1, Map.of()).get("rightArm").rotation().x());
+        files.remove("wave.animation.json");
+        assertThrows(IOException.class, () -> BedrockEmotes.read(pack));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_EMOTE_ASSETS", matches = ".+")
+    void samplesEveryFrameOfTheTwoOwnedNativeAnimations() throws Exception {
+        final Path directory = Path.of(System.getenv("STACKANVIL_EMOTE_ASSETS"));
+        for (final var entry :
+                Map.of(
+                                "5bf11df3-97a9-e4aa-2276-291b92e7c012",
+                                6.5F,
+                                "238c8de3-766a-a419-a3dc-c23063ce680e",
+                                4.75F)
+                        .entrySet()) {
+            final Map<String, byte[]> files = new HashMap<>();
+            try (var paths = Files.list(directory.resolve(entry.getKey()))) {
+                for (final Path path : paths.toList())
+                    files.put(path.getFileName().toString(), Files.readAllBytes(path));
+            }
+            final var emote =
+                    BedrockEmotes.read(new BedrockPersonaAssets.Pack(entry.getKey(), files));
+            assertEquals(entry.getValue(), emote.animation().length());
+            final var playback = emote.animation().playback();
+            for (float time = 0; time <= emote.animation().length(); time += 1F / 60) {
+                final var pose = playback.sample(time, Map.of());
+                assertTrue(pose.size() >= 6);
+                for (final var transform : pose.values()) {
+                    assertTrue(Float.isFinite(transform.rotation().x()));
+                    assertTrue(Float.isFinite(transform.position().y()));
+                    assertEquals(new BedrockBoneAnimation.Vector(1, 1, 1), transform.scale());
+                }
+            }
+        }
+    }
+}
