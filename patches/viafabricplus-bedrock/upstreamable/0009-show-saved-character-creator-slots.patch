+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockSoundEventTest {
+    @Test
+    void resolvesSelectedSamplesFromTheEffectiveLibrary() throws Exception {
+        final JsonObject definition = new JsonObject();
+        definition.addProperty("category", "player");
+        final JsonArray samples = new JsonArray();
+        samples.add("sounds/missing");
+        final JsonObject sample = new JsonObject();
+        sample.addProperty("name", "sounds/selected");
+        sample.addProperty("weight", 3);
+        sample.addProperty("volume", .25F);
+        sample.addProperty("pitch", 2);
+        samples.add(sample);
+        definition.add("sounds", samples);
+        final JsonObject catalog = new JsonObject();
+        catalog.add("test", definition);
+        final ByteBuffer bank = ByteBuffer.allocate(72).order(ByteOrder.LITTLE_ENDIAN);
+        bank.putInt(0x35425346).putInt(1).putInt(1).putInt(8).putInt(0).putInt(4).putInt(2);
+        bank.position(60);
+        bank.putLong((2L << 34) | 18).putShort((short) 200).putShort((short) -400);
+        final var library = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/sounds/sound_definitions.json",
+                catalog.toString().getBytes(StandardCharsets.UTF_8),
+                "library/vanilla/sounds/selected.fsb", bank.array()));
+        final var contents = new BedrockBuiltinAssets.Contents("1.26.51.1", Map.of(), Map.of(), library);
+        final var resolved = contents.soundEvent("test", bound -> {
+            assertEquals(4, bound);
+            return 1;
+        }, 2, .5F, false);
+        assertNotNull(resolved);
+        assertEquals(.5F, resolved.selection().volume());
+        assertEquals(1, resolved.selection().pitch());
+        assertTrue(resolved.selection().positional());
+        assertEquals(48000, resolved.audio().sampleRate());
+        assertArrayEquals(new byte[] {(byte) 200, 0, 112, (byte) 254}, resolved.audio().pcm());
+        assertNull(contents.soundEvent("missing", bound -> fail(), 2, 1, false));
+    }
+
+    @Test
+    void boundsWeightsAndDrawsBeforeAssetResolution() throws Exception {
+        final JsonObject definition = new JsonObject();
+        final JsonArray samples = new JsonArray();
+        final JsonObject sample = new JsonObject();
+        sample.addProperty("weight", 0);
+        samples.add(sample);
+        definition.add("sounds", samples);
+        assertNull(BedrockSoundEvent.read(definition).select(bound -> fail(), 1, 1, false));
+        for (final int weight : new int[] {-1, Integer.MAX_VALUE}) {
+            sample.addProperty("weight", weight);
+            samples.add(sample.deepCopy());
+            final var event = BedrockSoundEvent.read(definition);
+            assertThrows(IOException.class, () -> event.select(bound -> fail(), 1, 1, false));
+            samples.remove(samples.size() - 1);
+        }
+        sample.addProperty("weight", 1);
+        final var event = BedrockSoundEvent.read(definition);
+        for (final int draw : new int[] {-1, 1, Integer.MAX_VALUE})
+            assertThrows(IOException.class, () -> event.select(bound -> draw, 1, 1, false));
+        assertThrows(IOException.class, () -> event.select(bound -> 0, Float.NaN, 1, false));
+        sample.addProperty("volume", Double.MAX_VALUE);
+        assertThrows(IOException.class, () -> BedrockSoundEvent.read(definition));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void resolvesLicensedEventSamplesAndMatchesIndependentPcm() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_SOUND_EVENTS"));
+        final Map<String, byte[]> files = new LinkedHashMap<>(NativeAssetFixture.read(root.resolve("package-assets")));
+        for (final var entry : NativeAssetFixture.read(root.resolve("overlay-package-assets")).entrySet()) {
+            final String[] path = entry.getKey().split("/", 3);
+            if (path.length == 3 && path[0].equals("library") && BedrockResourceLibrary.packName(path[1]))
+                files.put(entry.getKey(), entry.getValue());
+        }
+        final var library = BedrockResourceLibrary.read(files);
+        final var contents = new BedrockBuiltinAssets.Contents("1.26.51.1", Map.of(), Map.of(), library);
+        final JsonObject reference = JsonParser.parseString(Files.readString(root.resolve("sound-reference.json")))
+                .getAsJsonObject().getAsJsonObject("files");
+        final var decoded = new HashSet<String>();
+        for (final var entry : library.soundDefinitions().entrySet()) {
+            int draw = 0;
+            final BedrockSoundEvent event = entry.getValue();
+            for (final var sample : event.samples()) {
+                final int choice = draw;
+                draw += sample.weight();
+                if (sample.weight() == 0) continue;
+                final var selected = event.select(bound -> choice, 2, 1, false);
+                assertSame(sample, selected.sample());
+                final String path = sample.name() + ".fsb";
+                if (library.file(path) == null || !decoded.add(path)) continue;
+                final var resolved = contents.soundEvent(entry.getKey(), bound -> choice, 2, 1, false);
+                assertNotNull(resolved);
+                assertSame(sample, resolved.selection().sample());
+                final JsonObject expected = reference.getAsJsonObject("package-assets/library/vanilla/" + path);
+                assertNotNull(expected, path);
+                assertEquals(expected.get("hash").getAsString(), BedrockBuiltinAssets.hash(resolved.audio().pcm()), path);
+                assertEquals(expected.get("rate").getAsInt(), resolved.audio().sampleRate(), path);
+                assertEquals(expected.get("channels").getAsInt(), resolved.audio().channels(), path);
+                assertEquals(expected.get("samples").getAsInt(), resolved.audio().samples(), path);
+                assertEquals(expected.get("loopStart").getAsInt(), resolved.audio().loopStart(), path);
+                assertEquals(expected.get("loopEnd").getAsInt(), resolved.audio().loopEnd(), path);
+            }
+        }
+        assertTrue(decoded.size() >= 1000);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesNativeCatalogAndScalarConversions() throws Exception {
+        for (final JsonElement row : cases("native-sound-catalog-result.json")) {
+            final JsonObject entry = row.getAsJsonObject();
+            final JsonObject definition = new JsonObject();
+            final JsonArray samples = new JsonArray();
+            switch (entry.get("scope").getAsString()) {
+                case "category" -> {
+                    definition.add("category", entry.get("category"));
+                    definition.add("min_distance", entry.get("minimum"));
+                    definition.add("max_distance", entry.get("maximum"));
+                    samples.add("sounds/test");
+                }
+                case "object", "string" -> {
+                    definition.addProperty("category", entry.get("inherited").getAsBoolean() ? "player" : "ui");
+                    samples.add(entry.has("fields") ? entry.get("fields") : new JsonPrimitive("sounds/test"));
+                }
+                case "sequential-is3D" -> {
+                    final JsonObject first = new JsonObject();
+                    first.add("is3D", entry.get("first"));
+                    samples.add(first);
+                    samples.add(entry.get("second"));
+                }
+                default -> fail("Unknown native sound fixture scope");
+            }
+            definition.add("sounds", samples);
+            final var event = BedrockSoundEvent.read(definition);
+            final JsonObject expected = entry.getAsJsonObject("result");
+            assertSample(expected, event.samples().getLast());
+            if (entry.get("scope").getAsString().equals("category")) {
+                assertEquals(expected.get("minimum").getAsFloat(), event.minimumDistance());
+                assertEquals(expected.get("maximum").getAsFloat(), event.maximumDistance());
+                assertEquals(expected.get("legacy").getAsBoolean(), event.legacyMaximumDistance());
+            }
+        }
+        for (final JsonElement row : cases("native-sound-scalar-result.json")) {
+            final JsonObject entry = row.getAsJsonObject(), definition = new JsonObject(), sample = new JsonObject();
+            definition.addProperty("category", entry.get("inherited").getAsBoolean() ? "player" : "ui");
+            sample.add(entry.get("field").getAsString(), entry.get("value"));
+            final JsonArray samples = new JsonArray();
+            samples.add(sample);
+            definition.add("sounds", samples);
+            assertSample(entry.getAsJsonObject("result"), BedrockSoundEvent.read(definition).samples().getFirst());
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesNativeWeightedSelectionAndCategoryRouting() throws Exception {
+        for (final JsonElement row : cases("native-sound-weighted-result.json")) {
+            final JsonObject entry = row.getAsJsonObject(), definition = new JsonObject();
+            final JsonArray samples = new JsonArray(), weights = entry.getAsJsonArray("weights");
+            final float[] volumes = {0, .25F, 4}, pitches = {.5F, 1, 2};
+            for (int index = 0; index < weights.size(); index++) {
+                final JsonObject sample = new JsonObject();
+                sample.add("weight", weights.get(index));
+                sample.addProperty("volume", volumes[index]);
+                sample.addProperty("pitch", pitches[index]);
+                sample.add("is3D", entry.get("positional"));
+                samples.add(sample);
+            }
+            definition.add("sounds", samples);
+            final var event = BedrockSoundEvent.read(definition);
+            final var actual = event.select(bound -> entry.get("draw").getAsInt(), 2, 1,
+                    entry.get("force_nonpositional").getAsBoolean());
+            if (entry.get("result").isJsonNull()) assertNull(actual);
+            else {
+                final JsonObject expected = entry.getAsJsonObject("result");
+                assertNotNull(actual);
+                assertSame(event.samples().get(expected.get("index").getAsInt()), actual.sample());
+                assertEquals(expected.get("volume").getAsFloat(), actual.volume());
+                assertEquals(expected.get("pitch").getAsFloat(), actual.pitch());
+                assertEquals(expected.get("positional").getAsBoolean(), actual.positional());
+            }
+        }
+        final List<String> categories = List.of("ambient", "block", "hostile", "neutral", "player", "record", "weather");
+        final JsonArray routing = cases("native-sound-routing-result.json");
+        final Map<String, Long> groups = new HashMap<>();
+        long effects = 0;
+        for (final JsonElement row : routing) {
+            final JsonObject entry = row.getAsJsonObject();
+            if (!entry.get("groups_available").getAsBoolean()) effects = entry.get("selected_group").getAsLong();
+            else if (!entry.get("groups_null").getAsBoolean() && categories.contains(entry.get("category").getAsString()))
+                groups.put(entry.get("category").getAsString(), entry.get("selected_group").getAsLong());
+        }
+        for (final JsonElement row : routing) {
+            final JsonObject entry = row.getAsJsonObject(), definition = new JsonObject();
+            definition.add("category", entry.get("category"));
+            final Map<String, Long> available = new HashMap<>(groups);
+            if (!entry.get("groups_available").getAsBoolean()) available.clear();
+            else if (entry.get("groups_null").getAsBoolean()) available.replaceAll((key, value) -> null);
+            final Long actual = BedrockSoundEvent.read(definition).group(available, effects);
+            assertEquals(entry.get("selected_group").getAsLong(), actual == null ? 0 : actual);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesNativeAttenuationRequests() throws Exception {
+        for (final JsonElement row : cases("native-sound-attenuation-result.json")) {
+            final JsonObject entry = row.getAsJsonObject(), definition = new JsonObject();
+            definition.add("min_distance", entry.get("minimum"));
+            definition.add("max_distance", entry.get("maximum"));
+            definition.add("__use_legacy_max_distance", entry.get("legacy"));
+            int mode = entry.get("initial_mode").getAsInt();
+            float minimum = Float.NaN, maximum = Float.NaN;
+            boolean subsound = false;
+            for (final JsonElement request : entry.getAsJsonArray("requests")) {
+                final JsonObject value = request.getAsJsonObject();
+                if (value.get("sound").getAsInt() != 0) { subsound = true; continue; }
+                if (value.get("kind").getAsString().equals("mode")) mode = value.get("mode").getAsInt();
+                else { minimum = value.get("minimum").getAsFloat(); maximum = value.get("maximum").getAsFloat(); }
+            }
+            final var actual = BedrockSoundEvent.read(definition).attenuation(
+                    entry.get("initial_mode").getAsInt() == 0x200000 ? BedrockSoundEvent.Rolloff.LINEAR : BedrockSoundEvent.Rolloff.INVERSE);
+            assertEquals(mode == 0x200000 ? BedrockSoundEvent.Rolloff.LINEAR : BedrockSoundEvent.Rolloff.INVERSE, actual.rolloff());
+            assertEquals(minimum, actual.minimum());
+            assertEquals(maximum, actual.maximum());
+            if (entry.get("subsounds").getAsInt() == 2) assertEquals(!subsound, actual.parentOnly());
+        }
+    }
+
+    private static JsonArray cases(final String file) throws IOException {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_SOUND_EVENTS")).resolve(file)))
+                .getAsJsonObject().getAsJsonArray("cases");
+    }
+
+    private static void assertSample(final JsonObject expected, final BedrockSoundEvent.Sample sample) {
+        assertEquals(expected.get("positional").getAsBoolean(), sample.positional());
+        if (!expected.has("volume")) return;
+        assertEquals(expected.get("volume").getAsFloat(), sample.volume());
+        assertEquals(expected.get("pitch").getAsFloat(), sample.pitch());
+        assertEquals(expected.get("weight").getAsInt(), sample.weight());
+        assertEquals(expected.get("stream").getAsBoolean(), sample.stream());
+        assertEquals(expected.get("interruptible").getAsBoolean(), sample.interruptible());
+        assertEquals(expected.get("concurrent").getAsBoolean(), sample.concurrent());
+    }
+}
