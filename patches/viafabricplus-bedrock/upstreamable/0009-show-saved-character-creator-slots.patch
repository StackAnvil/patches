+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.raphimc.viabedrock.api.model.NativeBlockIdentifiers;
+import net.raphimc.viabedrock.api.model.NativeBlockView;
+
+/** Client lifecycle adapter for the core's authoritative block mirror. */
+public final class BedrockNativeBlocks {
+    private static final NativeBlockView VIEW = new NativeBlockView();
+    private static ClientLevel level;
+
+    private BedrockNativeBlocks() {}
+
+    public static void accept(final NativeBlockIdentifiers message) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (!minecraft.isSameThread()) { minecraft.execute(() -> accept(message)); return; }
+        if (minecraft.level == null) return;
+        synchronizeLevel(minecraft);
+        VIEW.accept(message);
+    }
+
+    public static void clear() {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (!minecraft.isSameThread()) { minecraft.execute(BedrockNativeBlocks::clear); return; }
+        VIEW.clear();
+        level = null;
+    }
+
+    static BedrockParticleBlocks.World world() {
+        final Minecraft minecraft = Minecraft.getInstance();
+        synchronizeLevel(minecraft);
+        return VIEW.ready() ? VIEW::block : null;
+    }
+
+    private static void synchronizeLevel(final Minecraft minecraft) {
+        if (level == minecraft.level) return;
+        VIEW.clear();
+        level = minecraft.level;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java
