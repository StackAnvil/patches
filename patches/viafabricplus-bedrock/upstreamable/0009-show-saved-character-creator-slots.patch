+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.client.model.geom.ModelPart;
+import org.joml.Matrix4f;
+
+/** Composes a native bone in model coordinates, before the actor and camera transforms. */
+final class BedrockBoneTransform {
+    private BedrockBoneTransform() {
+    }
+
+    static Matrix4f compose(final Matrix4f parent, final ModelPart bone, final boolean entityRelative) {
+        parent.translate(bone.x, bone.y, bone.z);
+        if (entityRelative) {
+            // Native preserves the translated origin, then clears the entire inherited basis.
+            parent.m00(1).m01(0).m02(0).m03(0)
+                    .m10(0).m11(1).m12(0).m13(0)
+                    .m20(0).m21(0).m22(1).m23(0);
+        }
+        return parent.rotateZYX(bone.zRot, bone.yRot, bone.xRot)
+                .scale(bone.xScale, bone.yScale, bone.zScale);
+    }
+}
