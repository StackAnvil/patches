+    #[test]
+    fn selects_persona_and_actor_library_files() {
+        assert_eq!(
+            asset_path("data\\resource_packs\\persona\\pieces\\wave.brarchive").unwrap(),
+            Some("pieces/wave.brarchive".into())
+        );
+        for relative in [
+            "models/mobs.json",
+            "models/entity/zombie.v1.0.geo.json",
+            "__brarchive/models.brarchive",
+            "__brarchive/models/entity.brarchive",
+            "animations/player.animation.json",
+            "animation_controllers/player.animation_controllers.json",
+            "entity/player.entity.json",
+            "__brarchive/animations.brarchive",
+            "__brarchive/animation_controllers.brarchive",
+            "__brarchive/entity.brarchive",
+        ] {
+            assert_eq!(
+                asset_path(&format!("data/resource_packs/vanilla/{relative}")).unwrap(),
+                Some(format!("library/vanilla/{relative}"))
+            );
+        }
+        for relative in [
+            "textures/steve.png",
+            "__brarchive/textures.brarchive",
+            "models/../outside.json",
+        ] {
+            let result = asset_path(&format!("data/resource_packs/vanilla/{relative}"));
