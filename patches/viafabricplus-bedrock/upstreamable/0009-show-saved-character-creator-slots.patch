+    private static String colorLabel(final ColorTarget target) {
+        return switch (target) {
+            case SKIN -> "bedrock_character_slots.viafabricplus.skin_tone";
+            case HAIR -> "bedrock_character_slots.viafabricplus.hair_color";
+            case FACIAL_HAIR -> "bedrock_character_slots.viafabricplus.facial_hair_color";
+            case IRIS -> "bedrock_character_slots.viafabricplus.iris_color";
+            case EYEBROWS -> "bedrock_character_slots.viafabricplus.eyebrow_color";
+            case SCLERA -> "bedrock_character_slots.viafabricplus.sclera_color";
+            case MOUTH -> "bedrock_character_slots.viafabricplus.mouth_color";
+        };
+    }
+
+    private void nextColorChannel() {
+        final List<ColorTarget> targets = this.category.colorTargets();
+        if (targets.size() < 2) {
+            return;
+        }
+        this.colorTarget = targets.get((targets.indexOf(this.colorTarget) + 1) % targets.size());
+        this.selectedColor = this.palette().indexOf(this.currentColor());
+        this.editFailed = false;
+        this.updateControls();
