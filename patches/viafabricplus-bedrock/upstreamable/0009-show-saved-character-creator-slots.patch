+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.settings.StoreSignInMode;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.ConfirmScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.network.chat.Component;
+
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+
+/** Consent for an optional Store login, shared by asset requests for the same account. */
+final class BedrockStoreSignIn {
+    static final BedrockStoreSignIn INSTANCE = new BedrockStoreSignIn(BedrockStoreSignIn::prompt);
+
+    private final Map<String, CompletableFuture<Boolean>> decisions = new ConcurrentHashMap<>();
+    private final Supplier<CompletableFuture<Boolean>> prompt;
+
+    BedrockStoreSignIn(final Supplier<CompletableFuture<Boolean>> prompt) {
+        this.prompt = prompt;
+    }
+
+    void acquire(final String account, final StoreSignInMode mode, final Acquisition headless,
+                 final Acquisition interactive) throws Exception {
+        try {
+            headless.run();
+            return;
+        } catch (BedrockPackageHelper.StoreSignInRequiredException missing) {
+            final boolean allowed = switch (mode) {
+                case NEVER -> false;
+                case ALLOW -> true;
+                case ASK -> this.decisions.computeIfAbsent(account, ignored -> this.prompt.get()).get();
+            };
+            if (!allowed) throw missing;
+        }
+        try {
+            interactive.run();
+        } catch (BedrockStoreBrowser.SignInCancelledException cancelled) {
+            if (mode == StoreSignInMode.ASK) this.decisions.put(account, CompletableFuture.completedFuture(false));
+            throw cancelled;
+        }
+    }
+
+    private static CompletableFuture<Boolean> prompt() {
+        final CompletableFuture<Boolean> result = new CompletableFuture<>();
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (minecraft.isSameThread()) {
+            throw new IllegalStateException("Asset acquisition must run outside the game thread");
+        }
+        minecraft.execute(() -> {
+            final Screen previous = minecraft.gui.screen();
+            minecraft.gui.setScreen(new ConsentScreen(minecraft, previous, result));
+        });
+        return result;
+    }
+
+    private static final class ConsentScreen extends ConfirmScreen {
+        private final Minecraft client;
+        private final Screen previous;
+        private final CompletableFuture<Boolean> decision;
+
+        ConsentScreen(final Minecraft client, final Screen previous, final CompletableFuture<Boolean> decision) {
+            super(accepted -> {
+                decision.complete(accepted);
+                client.gui.setScreen(previous);
+            }, Component.translatable("bedrock_store.viafabricplus.consent.title"),
+                Component.translatable("bedrock_store.viafabricplus.consent.message"),
+                Component.translatable("bedrock_store.viafabricplus.consent.sign_in"),
+                Component.translatable("bedrock_store.viafabricplus.consent.skip"));
+            this.client = client;
+            this.previous = previous;
+            this.decision = decision;
+        }
+
+        @Override
+        public void onClose() {
+            this.decision.complete(false);
+            this.client.gui.setScreen(this.previous);
+        }
+
+        @Override
+        public void removed() {
+            this.decision.complete(false);
+            super.removed();
+        }
+    }
+
+    @FunctionalInterface
+    interface Acquisition {
+        void run() throws Exception;
+    }
+}
