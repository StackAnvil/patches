+    public static CompletableFuture<List<WardrobeItem>> loadItems(final BedrockAuthManager account, final Category category) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(STORE.resolve(category.page()))
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString("{\"entitlements\":[],\"inventoryVersion\":\"\",\"listVersion\":\"\"}"))
+                    .build();
+                return catalogItems(send(request));
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock wardrobe items", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<String> loadActiveAvatar(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(AVATAR)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("Accept", "image/png")
+                    .GET().build();
+                final HttpResponse<byte[]> response = HTTP.send(request, HttpResponse.BodyHandlers.ofByteArray());
+                final byte[] image = response.body();
+                if (response.statusCode() / 100 != 2 || image.length < 8 || image.length > 2 * 1024 * 1024
+                    || image[0] != (byte) 0x89 || image[1] != 'P' || image[2] != 'N' || image[3] != 'G') {
+                    throw new IOException("Bedrock did not return a valid character preview");
+                }
+                return Base64.getEncoder().encodeToString(image);
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock character preview", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<PreparedCharacter> loadActiveModel(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final AccountWardrobe before = loadNow(account);
+                if (before.activeSlot() < 1 || before.activeSlot() > before.slots().size()) {
+                    throw new IOException("Select a character slot first");
+                }
+                final Slot active = before.slots().get(before.activeSlot() - 1);
+                if (!active.occupied() || active.profileHash().isBlank()) {
+                    throw new IOException("The active character has no saved appearance");
+                }
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(MODEL)
+                    .timeout(Duration.ofSeconds(20))
+                    .header("Authorization", authorization)
+                    .header("session-id", UUID.randomUUID().toString())
+                    .header("Accept", "model/gltf-binary, application/octet-stream")
+                    .GET().build();
+                final HttpResponse<byte[]> response = HTTP.send(request, HttpResponse.BodyHandlers.ofByteArray());
+                if (response.statusCode() / 100 != 2) {
+                    throw new IOException("Bedrock character model request failed: HTTP " + response.statusCode());
+                }
+                final BedrockPersonaModel.Converted converted = BedrockPersonaModel.convert(response.body());
+                final List<WardrobeItem> catalog = new ArrayList<>();
+                if (active.pieceIds().stream().anyMatch(id -> !id.endsWith("/d") && !id.endsWith("/de")
+                    && !id.endsWith("/e") && !id.matches("[0-9a-fA-F-]{36}\\.[0-9]+"))) {
+                    final Category[] categories = Category.values();
+                    for (int offset = 0; offset < categories.length; offset += 4) {
+                        final List<CompletableFuture<List<WardrobeItem>>> requests = new ArrayList<>();
+                        for (int index = offset; index < Math.min(offset + 4, categories.length); index++) {
+                            requests.add(loadItems(account, categories[index]));
+                        }
+                        for (final var category : requests) {
+                            catalog.addAll(category.join());
+                        }
+                    }
+                }
+                final BedrockPersonaProfile profile = BedrockPersonaProfile.from(active, catalog);
+                final var assembled = BedrockPersonaAssembler.assemble(converted, active, BedrockPersonaAssets.load(account, profile));
+                final AccountWardrobe after = loadNow(account);
+                if (after.activeSlot() != active.number()
+                    || !after.slots().get(active.number() - 1).profileHash().equals(active.profileHash())) {
+                    throw new IOException("The active character changed while its model was loading");
+                }
+                return new PreparedCharacter(active, assembled, profile);
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load the active Bedrock character model", e);
+            }
+        });
+    }
