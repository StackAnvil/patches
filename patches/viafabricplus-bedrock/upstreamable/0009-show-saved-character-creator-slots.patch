+
+final class BedrockFirstPersonInputTest {
+    private static final BedrockItemAnimation EMPTY_ITEMS = new BedrockItemAnimation(
+            BedrockItemAnimation.Item.EMPTY, BedrockItemAnimation.Item.EMPTY,
+            BedrockItemAnimation.Item.EMPTY, BedrockItemAnimation.Item.EMPTY, 0);
+    @Test
+    void preservesActorScopeAndUsesAuthoredPivotsForIndependentHands() throws Exception {
+        final var queries = new HashMap<>(pivots(19.25F, 24F));
+        queries.put("target_x_rotation", 37F);
+        queries.put("target_y_rotation", -80F);
+        final var actor = new BedrockActorAnimation.Frame(queries,
+                Map.of("attack_time", .25F, "player_x_rotation", 37F), Map.of("is_first_person", 1));
+        final var hands = BedrockFirstPersonInput.bind(actor, EMPTY_ITEMS, .1F, .9F, .8F, .2F, .5F);
+        assertEquals(.25F, hands.variables().get("attack_time"));
+        assertEquals(.5F, hands.variables().get("player_arm_height"), .00001F);
+        assertEquals(.5F, ((Number) hands.context().get("player_offhand_arm_height")).floatValue(), .00001F);
+        assertEquals(1, hands.context().get("is_first_person"));
+        assertEquals(2.75F, hands.variables().get("short_arm_offset_right"));
+        assertEquals(-2F, hands.variables().get("short_arm_offset_left"));
+        assertEquals(37F, hands.variables().get("player_x_rotation"));
+        assertEquals(0F, hands.queries().get("target_x_rotation"));
+        assertEquals(0F, hands.queries().get("target_y_rotation"));
+        assertEquals(37F, actor.queries().get("target_x_rotation"));
+        assertEquals(-80F, actor.queries().get("target_y_rotation"));
+        assertEquals(actor.queries().get("get_default_bone_pivot"), hands.queries().get("get_default_bone_pivot"));
+        assertFalse(actor.variables().containsKey("player_arm_height"));
+        assertFalse(actor.context().containsKey("player_offhand_arm_height"));
+        assertFalse(hands.variables().containsKey("player_offhand_arm_height"));
+    }
+
+    @Test
+    void distinguishesUnavailableGeometryFromADataModelWithoutArms() throws Exception {
+        final var absent = BedrockFirstPersonInput.bind(new BedrockActorAnimation.Frame(Map.of(), Map.of()), EMPTY_ITEMS, 0, 1, 0, 1, .5F);
+        assertFalse(absent.variables().containsKey("short_arm_offset_right"));
+        final var model = BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.empty","texture_width":64,"texture_height":64},"bones":[]}]}
+                """).getFirst();
+        final var empty = BedrockFirstPersonInput.bind(new BedrockActorAnimation.Frame(BedrockGeometryQueries.of(model), Map.of()), EMPTY_ITEMS, 0, 1, 0, 1, .5F);
+        assertEquals(22F, empty.variables().get("short_arm_offset_right"));
+        assertEquals(22F, empty.variables().get("short_arm_offset_left"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_FIRST_PERSON_INPUTS", matches = ".+")
+    void matchesTargetExecutableHeightAndArmOffsetResults() throws Exception {
+        final var fixture = json(Files.readString(Path.of(System.getenv("STACKANVIL_FIRST_PERSON_INPUTS"))));
+        for (final var entry : fixture.getAsJsonArray("heights")) {
+            final var row = entry.getAsJsonObject();
+            final var frame = BedrockFirstPersonInput.bind(new BedrockActorAnimation.Frame(Map.of(), Map.of()), EMPTY_ITEMS,
+                    bits(row, "main_old"), bits(row, "main"), bits(row, "off_old"), bits(row, "off"), bits(row, "alpha"));
+            assertEquals(row.get("main_result").getAsInt(), Float.floatToRawIntBits(frame.variables().get("player_arm_height")));
+            assertEquals(row.get("off_result").getAsInt(), Float.floatToRawIntBits(((Number) frame.context().get("player_offhand_arm_height")).floatValue()));
+        }
+        for (final var entry : fixture.getAsJsonArray("arms")) {
+            final var row = entry.getAsJsonObject();
+            final var actor = new BedrockActorAnimation.Frame(pivots(row.get("right").getAsFloat(), row.get("left").getAsFloat()), Map.of());
+            final var frame = BedrockFirstPersonInput.bind(actor, EMPTY_ITEMS, 0, 0, 0, 0, 0);
+            assertEquals(row.get("right_result").getAsInt(), Float.floatToRawIntBits(frame.variables().get("short_arm_offset_right")));
+            assertEquals(row.get("left_result").getAsInt(), Float.floatToRawIntBits(frame.variables().get("short_arm_offset_left")));
+        }
+    }
+
+    @Test
+    void samplesVisibleHandItemsIndependentlyAcrossSwapFrames() throws Exception {
+        final var bow = new BedrockItemAnimation.Item("bow", 72000, false, ItemAnimationData.EMPTY);
+        final var crossbow = new BedrockItemAnimation.Item("crossbow", 25, true, ItemAnimationData.EMPTY);
+        final var shield = new BedrockItemAnimation.Item("shield", 72000, false, ItemAnimationData.EMPTY);
+        final var equipped = new BedrockItemAnimation(crossbow, shield, crossbow, shield, 12);
+        final var actor = new BedrockActorAnimation.Frame(equipped.queries(), Map.of());
+        final var animations = json("""
+                {"animation.pose":{"loop":true,"bones":{"rightarm":{"position":[
+                  "query.get_equipped_item_name('main_hand',1)=='bow'?8:(query.get_equipped_item_name('main_hand',1)=='crossbow'?2:0)",
+                  "query.get_equipped_item_name('main_hand')=='crossbow'?3:0",
+                  "query.item_is_charged('main_hand')?4:0"]},
+                "leftarm":{"position":["query.get_equipped_item_name('off_hand',1)=='shield'?6:0",0,0]}}}}
+                """);
+        final var playback = BedrockBoneAnimation.parse(animations.getAsJsonObject("animation.pose")).playback();
+        final var renderedMain = java.util.List.of(bow, crossbow, BedrockItemAnimation.Item.EMPTY);
+        final var renderedOff = java.util.List.of(BedrockItemAnimation.Item.EMPTY, shield, shield);
+        for (int frame = 0; frame < renderedMain.size(); frame++) {
+            final var items = new BedrockItemAnimation(crossbow, shield, renderedMain.get(frame), renderedOff.get(frame), 12);
+            final var hands = BedrockFirstPersonInput.bind(actor, items, .1F, .9F, .8F, .2F, .5F);
+            final var pose = playback.sample(frame * .05F, hands.queries());
+            assertEquals(frame == 0 ? 8F : frame == 1 ? 2F : 0F, pose.get("rightarm").position().x());
+            assertEquals(3F, pose.get("rightarm").position().y());
+            assertEquals(4F, pose.get("rightarm").position().z());
+            assertEquals(frame == 0 ? 0F : 6F, pose.get("leftarm").position().x());
+            assertEquals(12, hands.queries().get("main_hand_item_use_duration"));
+        }
+        final var unchanged = playback.sample(.2F, actor.queries());
+        assertEquals(2F, unchanged.get("rightarm").position().x());
+        assertEquals(6F, unchanged.get("leftarm").position().x());
+    }
+
+    private static Map<String, Object> pivots(final float right, final float left) throws Exception {
+        final var model = BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.hands","texture_width":64,"texture_height":64},
+                 "bones":[{"name":"body","pivot":[0,24,0],"rotation":[20,40,0]},
+                  {"name":"rightarm","parent":"body","pivot":[-5,%s,0]},
+                  {"name":"leftarm","parent":"body","pivot":[5,%s,0]}]}]}
+                """.formatted(right, left)).getFirst();
+        return BedrockGeometryQueries.of(model);
+    }
+
+    private static float bits(final JsonObject row, final String name) {
+        return Float.intBitsToFloat(row.get(name).getAsInt());
+    }
+
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+}
