+        assertTrue(surface.visibility().get(1).matches("rightArm"));
+        assertEquals(draws, hands.renderControllers(selection));
+        final var original = body.renderControllers(selection);
+        assertTrue(original.bodyVisible());
+        assertEquals(1, original.surfaces().size());
+        assertTrue(original.surfaces().getFirst().nativeBody());
+        assertEquals(draws, hands.renderControllers(selection));
+    }
+}
