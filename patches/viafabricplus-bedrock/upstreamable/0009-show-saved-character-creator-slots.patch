+
+    @Test
+    void retainsSignedScriptScaleAndZeroModelScale() {
+        final var collapsed = BedrockFirstPersonActor.root(.9F, 0, new Vector3f(2, -3, 4), false, new Matrix4f());
+        final var point = collapsed.transformPosition(new Vector3f(9, 18, 27));
+        assertEquals(0, point.x);
+        assertEquals(-.9F - 3F / 128F, point.y);
+        assertEquals(0, point.z);
+        final var skipped = BedrockFirstPersonActor.root(.9F, .125F, new Vector3f(2, -3, 4), true, new Matrix4f());
+        final var expanded = skipped.transformPosition(new Vector3f(1, 2.5F, 3));
+        assertEquals(4, expanded.x);
+        assertEquals(14.1F, expanded.y, .000001F);
+        assertEquals(-24, expanded.z);
