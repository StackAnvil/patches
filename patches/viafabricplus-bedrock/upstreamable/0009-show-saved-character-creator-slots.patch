@@ -0,0 +1,96 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.AlphaComposite;
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Packs native animated texture collections into horizontal columns of repeating strips. */
+final class BedrockPersonaAnimationAtlas {
+    private final int height;
+    private final Map<String, Tile> tiles = new LinkedHashMap<>();
+    private int width;
+    private int frames = 1;
+
+    BedrockPersonaAnimationAtlas(final int height) {
+        this.height = height;
+    }
+
+    static void validate(final BufferedImage image, final int frames, final int size)
+            throws IOException {
+        if (frames < 1
+                || frames > 256
+                || (frames & (frames - 1)) != 0
+                || image.getWidth() != size
+                || image.getHeight() != size * frames)
+            throw new IOException(
+                    "A persona animation needs square native frames and a power-of-two length");
+    }
+
+    Tile add(final String id, final BufferedImage image, final int frames) throws IOException {
+        final Tile existing = this.tiles.get(id);
+        if (existing != null) return existing;
+        if (image.getHeight() != this.height * frames
+                || frames < 1
+                || frames > 256
+                || (frames & (frames - 1)) != 0)
+            throw new IOException("A persona animation has incompatible frames");
+        final int width = this.width + image.getWidth(), count = Math.max(this.frames, frames);
+        if (width > 1024 || (long) width * this.height * count > 4 * 1024 * 1024)
+            throw new IOException("The equipped animations exceed the texture atlas");
+        final Tile tile = new Tile(image, this.width, frames, this.height);
+        this.tiles.put(id, tile);
+        this.width = width;
+        this.frames = count;
+        return tile;
+    }
+
+    int width() {
+        return this.width;
+    }
+
+    int height() {
+        return this.height;
+    }
+
+    int frames() {
+        return this.frames;
+    }
+
+    BufferedImage image() {
+        final BufferedImage image =
+                new BufferedImage(
+                        this.width, this.height * this.frames, BufferedImage.TYPE_INT_ARGB);
+        final Graphics2D graphics = image.createGraphics();
+        try {
+            graphics.setComposite(AlphaComposite.Src);
+            for (final var tile : this.tiles.values())
+                for (int frame = 0; frame < this.frames; frame++) {
+                    final int offset = frame % tile.frames() * this.height;
+                    graphics.drawImage(
+                            tile.image(),
+                            tile.x(),
+                            frame * this.height,
+                            tile.x() + tile.image().getWidth(),
+                            (frame + 1) * this.height,
+                            0,
+                            offset,
+                            tile.image().getWidth(),
+                            offset + this.height,
+                            null);
+                }
+        } finally {
+            graphics.dispose();
+        }
+        return image;
+    }
+
+    record Tile(BufferedImage image, int x, int frames, int height) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java
new file mode 100644
index 0000000..5582677
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java
@@ -0,0 +1,128 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+import net.raphimc.viabedrock.protocol.types.primitive.ImageType;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+
+import javax.imageio.ImageIO;
+
+/** Stores animation strips as PNGs while supplying the native RGBA client claims. */
+final class BedrockPersonaAnimations {
+    private BedrockPersonaAnimations() {}
+
+    static JsonArray write(final List<AnimationData> animations) throws IOException {
+        final JsonArray result = new JsonArray();
+        for (final var animation : animations) {
+            validate(animation);
+            final ByteArrayOutputStream output = new ByteArrayOutputStream();
+            ImageIO.write(animation.image(), "png", output);
+            final JsonObject entry = new JsonObject();
+            entry.addProperty("image", Base64.getEncoder().encodeToString(output.toByteArray()));
+            entry.addProperty("type", animation.type());
+            entry.addProperty("frames", animation.frames());
+            entry.addProperty("expression", animation.expression());
+            result.add(entry);
+        }
+        return result;
+    }
+
+    static List<AnimationData> read(final JsonArray json) throws IOException {
+        if (json == null) return List.of();
+        if (json.size() > 3) throw new IOException("The character has too many animation surfaces");
+        final List<AnimationData> result = new ArrayList<>();
+        for (final var element : json) {
+            final JsonObject entry = element.getAsJsonObject();
+            final byte[] bytes = Base64.getDecoder().decode(entry.get("image").getAsString());
+            final BufferedImage image = image(bytes);
+            final AnimationData animation =
+                    new AnimationData(
+                            image,
+                            entry.get("type").getAsInt(),
+                            entry.get("frames").getAsFloat(),
+                            entry.get("expression").getAsInt());
+            validate(animation);
+            result.add(animation);
+        }
+        return List.copyOf(result);
+    }
+
+    static BufferedImage image(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("The animation image is missing or too large");
+        try (final var stream = ImageIO.createImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(stream);
+            if (!readers.hasNext()) throw new IOException("The animation image is invalid");
+            final var reader = readers.next();
+            try {
+                reader.setInput(stream);
+                final int width = reader.getWidth(0);
+                final int height = reader.getHeight(0);
+                if (width < 1
+                        || height < 1
+                        || width > 1024
+                        || height > 32768
+                        || (long) width * height > 4 * 1024 * 1024) {
+                    throw new IOException("The animation image dimensions are invalid");
+                }
+                return reader.read(0);
+            } finally {
+                reader.dispose();
+            }
+        }
+    }
+
+    static List<Map<String, Object>> claims(final List<AnimationData> animations) {
+        return animations.stream()
+                .map(
+                        animation ->
+                                Map.<String, Object>of(
+                                        "Image",
+                                        Base64.getEncoder()
+                                                .encodeToString(
+                                                        ImageType.getImageData(animation.image())),
+                                        "ImageWidth",
+                                        animation.image().getWidth(),
+                                        "ImageHeight",
+                                        animation.image().getHeight(),
+                                        "Type",
+                                        animation.type(),
+                                        "Frames",
+                                        animation.frames(),
+                                        "AnimationExpression",
+                                        animation.expression()))
+                .toList();
+    }
+
+    private static void validate(final AnimationData animation) throws IOException {
+        final BufferedImage image = animation.image();
+        if (image == null
+                || animation.type() < 1
+                || animation.type() > 3
+                || animation.frames() < 1
+                || animation.frames() > 256
+                || animation.frames() != Math.floor(animation.frames())
+                || image.getWidth() < 1
+                || image.getWidth() > 1024
+                || image.getHeight() < 1
+                || (long) image.getWidth() * image.getHeight() > 4 * 1024 * 1024
+                || image.getHeight() % (int) animation.frames() != 0) {
+            throw new IOException("The character animation strip is invalid");
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java
new file mode 100644
index 0000000..3c94c2b
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAssembler.java
@@ -0,0 +1,193 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Binds locally composed body layers and equipped geometry to native animated texture groups. */
+final class BedrockPersonaAssembler {
+    private BedrockPersonaAssembler() {}
+
+    static BedrockPersonaModel.Converted assemble(
+            final BedrockPersonaModel.Converted preview,
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        if (packs.isEmpty()) return preview;
+        final var skinColor = BedrockPersonaTint.skinColor(slot, packs);
+        final var composed = BedrockPersonaFace.assemble(preview, slot, packs);
+        final JsonObject geometry = JsonParser.parseString(composed.geometry()).getAsJsonObject();
+        final JsonArray models = geometry.getAsJsonArray("minecraft:geometry");
+        final JsonObject patch = JsonParser.parseString(composed.resourcePatch()).getAsJsonObject();
+        final JsonObject bindings = patch.getAsJsonObject("geometry");
+        final Map<Integer, BedrockPersonaAnimationAtlas> atlases = new LinkedHashMap<>();
+        final List<Surface> surfaces = new ArrayList<>();
+        final List<AnimationData> animations = new ArrayList<>();
+        for (final var animation : composed.animations()) {
+            if (animation.type() == 1) {
+                animations.add(animation);
+                continue;
+            }
+            final int type = animation.type(), size = type == 3 ? 128 : 32;
+            final String binding = binding(type), identifier = bindings.get(binding).getAsString();
+            JsonObject model = null;
+            for (int index = models.size() - 1; index >= 0; index--) {
+                final JsonObject candidate = models.get(index).getAsJsonObject();
+                if (candidate
+                        .getAsJsonObject("description")
+                        .get("identifier")
+                        .getAsString()
+                        .equals(identifier)) {
+                    model = candidate;
+                    models.remove(index);
+                    break;
+                }
+            }
+            if (model == null)
+                throw new IOException("An animated persona texture is missing its model");
+            final var atlas =
+                    atlases.computeIfAbsent(
+                            type, ignored -> new BedrockPersonaAnimationAtlas(size));
+            final var tile = atlas.add(identifier, animation.image(), (int) animation.frames());
+            surfaces.add(new Surface(model, tile, type, 3, false));
+        }
+        for (final var pack : packs.values()) {
+            final var geometries = BedrockPersonaSources.geometries(pack);
+            final var equipped = BedrockPersonaSources.recipes(pack, slot);
+            final List<JsonObject> recipes =
+                    equipped.isEmpty() ? List.of(new JsonObject()) : equipped;
+            for (final var asset :
+                    BedrockPersonaSources.read(
+                            pack,
+                            source ->
+                                    source.has("geometry")
+                                            && source.has("animated")
+                                            && source.get("animated").getAsBoolean()
+                                            && BedrockPersonaSources.matches(source, slot)
+                                            && recipes.stream()
+                                                    .anyMatch(
+                                                            recipe ->
+                                                                    BedrockPersonaGeometry.includes(
+                                                                            source,
+                                                                            side(recipe))))) {
+                for (final var recipe : recipes) {
+                    final JsonObject source = asset.source();
+                    final int sideMask = side(recipe);
+                    if (!BedrockPersonaGeometry.includes(source, sideMask)) continue;
+                    final int size = asset.image().getWidth(), type = size == 32 ? 2 : 3;
+                    BedrockPersonaAnimationAtlas.validate(
+                            asset.image(), asset.frames(), type == 2 ? 32 : 128);
+                    final var atlas =
+                            atlases.computeIfAbsent(
+                                    type, ignored -> new BedrockPersonaAnimationAtlas(size));
+                    final var tile =
+                            atlas.add(
+                                    pack.id()
+                                            + "/"
+                                            + source.get("texture").getAsString()
+                                            + "/"
+                                            + recipe,
+                                    BedrockPersonaTint.apply(
+                                            asset,
+                                            BedrockPersonaTint.palette(
+                                                    asset, slot, recipe, skinColor)),
+                                    asset.frames());
+                    final JsonObject model = geometries.get(source.get("geometry").getAsString());
+                    if (model == null)
+                        throw new IOException("A persona animation is missing its geometry");
+                    surfaces.add(new Surface(model, tile, type, sideMask, true));
+                }
+            }
+        }
+        if (surfaces.isEmpty()) return composed;
+        final Map<String, JsonObject> body = new LinkedHashMap<>();
+        models.get(0)
+                .getAsJsonObject()
+                .getAsJsonArray("bones")
+                .forEach(
+                        element -> {
+                            final JsonObject bone = element.getAsJsonObject();
+                            body.put(bone.get("name").getAsString(), bone);
+                        });
+        for (final var entry : atlases.entrySet()) {
+            final int type = entry.getKey();
+            final var atlas = entry.getValue();
+            final Map<String, JsonObject> animated = new LinkedHashMap<>();
+            for (final var bone : body.values()) {
+                final JsonObject pose = bone.deepCopy();
+                pose.remove("poly_mesh");
+                pose.remove("cubes");
+                animated.put(pose.get("name").getAsString(), pose);
+            }
+            for (final var surface : surfaces) {
+                if (surface.type() != type) continue;
+                for (final var element : surface.geometry().getAsJsonArray("bones")) {
+                    if (!BedrockPersonaGeometry.includes(
+                            surface.geometry(), element.getAsJsonObject(), surface.sideMask()))
+                        continue;
+                    final JsonObject incoming =
+                            BedrockPersonaGeometry.canonical(element.getAsJsonObject());
+                    final String name = incoming.get("name").getAsString();
+                    if (!incoming.has("cubes") && !incoming.has("poly_mesh")) continue;
+                    if (surface.replacesStatic() && body.containsKey(name)) {
+                        body.get(name).remove("poly_mesh");
+                        body.get(name).remove("cubes");
+                    }
+                    BedrockPersonaGeometry.mapUvs(
+                            incoming,
+                            surface.tile().image().getWidth(),
+                            surface.tile().height(),
+                            surface.tile().x(),
+                            0,
+                            atlas.width(),
+                            atlas.height());
+                    BedrockPersonaGeometry.merge(animated, incoming);
+                }
+            }
+            final String identifier = "geometry.persona." + binding(type);
+            final JsonObject model = new JsonObject(), description = new JsonObject();
+            description.addProperty("identifier", identifier);
+            description.addProperty("texture_width", atlas.width());
+            description.addProperty("texture_height", atlas.height());
+            model.add("description", description);
+            final JsonArray bones = new JsonArray();
+            animated.values().forEach(bones::add);
+            model.add("bones", bones);
+            models.add(model);
+            bindings.addProperty(binding(type), identifier);
+            animations.add(new AnimationData(atlas.image(), type, atlas.frames(), 0));
+        }
+        return new BedrockPersonaModel.Converted(
+                composed.atlas(), geometry.toString(), patch.toString(), List.copyOf(animations));
+    }
+
+    private static int side(final JsonObject recipe) {
+        return recipe.has("id")
+                ? BedrockLimbSide.fromRecipe(recipe.get("id").getAsString()).mask()
+                : 3;
+    }
+
+    private static String binding(final int type) {
+        return type == 2 ? "animated_32x32" : "animated_128x128";
+    }
+
+    private record Surface(
+            JsonObject geometry,
+            BedrockPersonaAnimationAtlas.Tile tile,
+            int type,
+            int sideMask,
+            boolean replacesStatic) {}
+}
