+    public static boolean canEditLimbSides(final AccountWardrobe wardrobe, final Slot slot,
+                                            final List<WardrobeItem> categoryItems, final WardrobeItem item) {
+        if (!("persona_arms".equals(item.type()) || "persona_legs".equals(item.type()))
+            || !item.canEquip()) return false;
+        try {
+            if (!BedrockLimbSide.supportsSides(string(recipeFor(wardrobe, item), "id"))) return false;
+        } catch (IOException e) {
+            return false;
+        }
+        return slot.pieceIds().stream().filter(id -> categoryItems.stream().anyMatch(piece -> piece.matches(id)))
+            .allMatch(BedrockLimbSide::supportsSides);
+    }
+
+    public static boolean limbEquipped(final Slot slot, final WardrobeItem item, final BedrockLimbSide side) {
+        int mask = 0;
+        for (final String id : slot.pieceIds()) {
+            if (item.matches(id)) mask |= BedrockLimbSide.fromRecipe(id).mask();
+        }
+        return (mask & side.mask()) == side.mask();
+    }
+
+    public static boolean canResetLimb(final Slot slot, final Category category,
+                                      final List<WardrobeItem> items, final BedrockLimbSide side) {
+        if (!slot.occupied() || !(category == Category.ARMS || category == Category.LEGS)
+            || items.isEmpty() || items.stream().anyMatch(item ->
+                !(category == Category.ARMS ? "persona_arms" : "persona_legs").equals(item.type()))) return false;
+        final List<String> equipped = slot.pieceIds().stream()
+            .filter(id -> items.stream().anyMatch(item -> item.matches(id))).toList();
+        return equipped.stream().allMatch(BedrockLimbSide::supportsSides)
+            && equipped.stream().anyMatch(id -> (BedrockLimbSide.fromRecipe(id).mask() & side.mask()) != 0);
+    }
