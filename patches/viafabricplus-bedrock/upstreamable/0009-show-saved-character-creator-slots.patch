+    @FunctionalInterface
+    private interface ProfileEdit {
+        JsonObject apply(AccountWardrobe current) throws IOException;
+    }
+
+    private static AccountWardrobe loadNow(final BedrockAuthManager account) throws IOException, InterruptedException {
+        return parse(readProfiles(account));
+    }
+
+    static AccountWardrobe parse(final JsonObject profiles) throws IOException {
+        final ParsedProfiles parsed = parseProfiles(profiles);
+        return new AccountWardrobe(parsed.slots(), parsed.activeSlot(), parsed.profileVersion(), parsed.settings());
+    }
+
+    private static JsonObject readProfiles(final BedrockAuthManager account) throws IOException, InterruptedException {
+        final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+        final HttpRequest profilesRequest = HttpRequest.newBuilder(PROFILES)
+            .timeout(Duration.ofSeconds(15))
+            .header("Authorization", authorization)
+            .header("session-id", UUID.randomUUID().toString())
+            .header("Accept", "application/json")
+            .GET().build();
+        return send(profilesRequest);
+    }
