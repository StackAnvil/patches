+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockAnimationParticleTest {
+    @Test
+    void capturesStandaloneTrackVariablesAndOrdersEffects() throws Exception {
+        final var definition = json("""
+                {"animation_length":1,"bones":{"head":{"position":["v.seed=7;return v.seed;",0,0]}},
+                 "particle_effects":{"0":[{"effect":"a","pre_effect_script":"v.seed=v.seed+1;"},{"effect":"b"}]},
+                 "sound_effects":{"0":{"effect":"c"}},"timeline":{"0":"v.seed=99;"}}
+                """);
+        final var playback = BedrockBoneAnimation.parse(definition).playback();
+        final List<BedrockAnimationParticle.Cue> particles = new ArrayList<>();
+        final List<String> order = new ArrayList<>();
+        playback.sample(0, Map.of(), true, sound -> order.add(sound.effect()), particle -> {
+            particles.add(particle);
+            order.add(particle.declaration().effect());
+        });
+        assertEquals(List.of("a","b","c"), order);
+        final var first = particles.getFirst();
+        first.environment.evaluate(first.declaration.initialization(), 0);
+        final var seed = BedrockMolang.Program.parse(JsonParser.parseString("\"v.seed\""), 0);
+        assertEquals(8, first.environment.evaluate(seed, 0));
+        assertEquals(7, particles.get(1).environment.evaluate(seed, 0));
+        playback.sample(0, Map.of(), true, null, particles::add);
+        assertEquals(2, particles.size());
+    }
+
+    @Test
+    void consumesSuppressedEventsAndResetsOnReplay() throws Exception {
+        final var playback = BedrockBoneAnimation.parse(json("""
+                {"animation_length":1,"loop":true,"particle_effects":{
+                "0":{"effect":"a"},"0.25":{"effect":"b"},"0.75":{"effect":"c"},"1":{"effect":"d"}}}
+                """)).playback();
+        final List<BedrockAnimationParticle.Cue> particles = new ArrayList<>();
+        playback.sample(.5F, Map.of(), false, null, particles::add);
+        assertTrue(particles.isEmpty());
+        playback.sample(.75F, Map.of(), true, null, particles::add);
+        assertEquals(List.of(.75F), particles.stream().map(cue -> cue.declaration.time()).toList());
+        particles.clear();
+        playback.sample(3.25F, Map.of(), true, null, particles::add);
+        assertEquals(List.of(0F,.25F), particles.stream().map(cue -> cue.declaration.time()).toList());
+        particles.clear();
+        playback.sample(0, Map.of(), true, null, particles::add);
+        assertEquals(List.of(0F), particles.stream().map(cue -> cue.declaration.time()).toList());
+    }
+
+    @Test
+    void infersLengthAndBoundsDeclarations() throws Exception {
+        final var definition = json("{\"particle_effects\":{\"3.5\":{}}}");
+        assertEquals(3.5F, BedrockBoneAnimation.parse(definition).length());
+        for (final float time : new float[] {-1, Float.NaN, Float.POSITIVE_INFINITY, 601}) {
+            final var events = new JsonObject(); events.add(Float.toString(time), new JsonObject());
+            assertThrows(IOException.class, () -> BedrockAnimationParticle.timeline(events));
+        }
+        final var entries = new com.google.gson.JsonArray();
+        for (int index = 0; index < 4097; index++) entries.add(new JsonObject());
+        assertThrows(IOException.class, () -> BedrockAnimationParticle.entries(entries));
+    }
+
+    @Test
+    void resolvesControllerAliasesAndQueuesAfterChildEffects() throws Exception {
+        final var entity = json("""
+                {"animations":{"root":"controller.animation.test","child":"animation.child"},
+                 "scripts":{"animate":["root"]},"particle_effects":{"a":"test:burst"},"sound_effects":{"a":"test:sound"}}
+                """);
+        final var animations = json("""
+                {"animation.child":{"animation_length":1,"particle_effects":{"0":{"effect":"a","locator":"child"}}}}
+                """);
+        final var controllers = json("""
+                {"controller.animation.test":{"states":{"default":{"animations":["child"],
+                "particle_effects":[{"effect":"a","locator":"first"},{"effect":"a","locator":"second","bind_to_actor":false}],
+                "sound_effects":[{"effect":"a","locator":"sound"}]}}}}
+                """);
+        final var playback = BedrockActorAnimation.read(entity, Map.of(), animations, controllers, "1.10.0").playback();
+        final List<String> order = new ArrayList<>();
+        final List<BedrockActorAnimation.ParticleCue> particles = new ArrayList<>();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        playback.sample(0, frame, true, sound -> order.add(sound.locator()), particle -> {
+            order.add(particle.locator()); particles.add(particle);
+        });
+        assertEquals(List.of("child","first","second","sound"), order);
+        assertTrue(particles.get(1).attached());
+        assertFalse(particles.get(2).attached());
+        assertEquals(entity.getAsJsonObject("particle_effects").get("a").getAsString(), particles.getFirst().event());
+        playback.sample(0, frame, true, null, particles::add);
+        assertEquals(3, particles.size());
+        entity.remove("particle_effects");
+        BedrockActorAnimation.read(entity, Map.of(), animations, controllers, "1.10.0").playback().sample(0, frame, true, null, particles::add);
+        assertEquals(3, particles.size());
+    }
+
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAnimationSoundTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockAnimationSoundTest.java
