+        final byte[] bytes = archive();
+        final var files = BedrockBrArchive.read(bytes);
+        assertArrayEquals(new byte[] {1, 2, 3}, files.get("nested/one"));
+        assertArrayEquals(files.get("nested/one"), files.get("two"));
+        assertFalse(files.containsKey("loose.png"));
+        Files.createDirectories(directory.resolve("__brarchive/pieces/test"));
+        Files.createDirectories(directory.resolve("pieces/test"));
+        Files.write(directory.resolve("__brarchive/pieces/test.brarchive"), bytes);
+        Files.write(directory.resolve("pieces/test/loose.png"), new byte[] {4});
+        final var unpacked = BedrockBuiltinAssets.unpack(directory);
+        assertArrayEquals(new byte[] {4}, unpacked.get("pieces/test/loose.png"));
+        assertArrayEquals(new byte[] {1, 2, 3}, unpacked.get("pieces/test/nested/one"));
+    }
