+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockResourceLibraryTest {
+    private static void put(
+            final Map<String, byte[]> files,
+            final String pack,
+            final String path,
+            final String json) {
+        files.put("library/" + pack + "/" + path, json.getBytes(StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void ordersNumericLayersAndOverridesIdentifiersAcrossDifferentFiles() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        for (final String pack :
+                List.of("vanilla_1.10.0", "vanilla_base", "vanilla_1.9.0", "vanilla")) {
+            final int value =
+                    pack.equals("vanilla_1.10.0")
+                            ? 10
+                            : pack.equals("vanilla_1.9.0")
+                                    ? 9
+                                    : pack.equals("vanilla_base") ? 2 : 1;
+            put(
+                    files,
+                    pack,
+                    "models/" + value + ".json",
+                    "{\"geometry.test\":{\"bones\":[{\"name\":\"head\",\"pivot\":["
+                            + value
+                            + ",0,0]}]}}");
+            put(
+                    files,
+                    pack,
+                    "animations/" + value + ".json",
+                    "{\"animations\":{\"animation.test\":{\"loop\":true,\"bones\":{\"head\":{\"position\":["
+                            + value
+                            + ",0,0]}}}}}");
+        }
+        put(
+                files,
+                "vanilla",
+                "animations/retained.json",
+                "{\"animations\":{\"animation.retained\":{\"bones\":{\"body\":{\"position\":[0,3,0]}}}}}");
+        put(
+                files,
+                "vanilla",
+                "entity/player.entity.json",
+                "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"animations\":{\"root\":\"animation.absent\"},\"scripts\":{\"animate\":[\"root\"]}}}}");
+        put(
+                files,
+                "vanilla_1.10.0",
+                "entity/renamed.json",
+                "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"animations\":{\"root\":\"animation.test\",\"retained\":\"animation.retained\"},\"scripts\":{\"animate\":[\"root\",\"retained\"]}}}}");
+        final var library = BedrockResourceLibrary.read(files);
+        final var pose =
+                BedrockActorAnimation.read(library, BedrockClassicOptions.EMPTY)
+                        .playback()
+                        .sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(10, pose.get("head").position().x());
+        assertEquals(3, pose.get("body").position().y());
+        final var geometry =
+                org.cube.converter.model.impl.bedrock.BedrockGeometryModel.fromJson(
+                                BedrockClassicModel.read("{}", "geometry.test", library::model)
+                                        .geometry())
+                        .getFirst();
+        assertEquals(10, geometry.getParents().getFirst().getPivot().getX());
+    }
+
+    @Test
+    void keepsControllerFormatsWhenHigherPacksAddOtherIdentifiers() throws Exception {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        put(
+                files,
+                "vanilla",
+                "entity/player.json",
+                "{\"minecraft:client_entity\":{\"description\":{\"identifier\":\"minecraft:player\",\"animations\":{\"legacy\":\"controller.animation.legacy\",\"modern\":\"controller.animation.modern\",\"a\":\"animation.a\",\"b\":\"animation.b\",\"c\":\"animation.c\",\"d\":\"animation.d\"},\"scripts\":{\"animate\":[\"legacy\",\"modern\"]}}}}");
+        put(
+                files,
+                "vanilla",
+                "animations/pose.json",
+                "{\"animations\":{\"animation.a\":{\"loop\":true,\"bones\":{\"legacy\":{\"position\":[1,0,0]}}},\"animation.b\":{\"loop\":true,\"bones\":{\"modern\":{\"position\":[2,0,0]}}},\"animation.c\":{\"loop\":true,\"bones\":{\"legacy\":{\"position\":[3,0,0]}}},\"animation.d\":{\"loop\":true,\"bones\":{\"modern\":{\"position\":[4,0,0]}}}}}");
+        for (final String pack : List.of("vanilla", "vanilla_1.26.51")) {
+            final boolean modern = !pack.equals("vanilla");
+            put(
+                    files,
+                    pack,
