+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_ACTIONS", matches = ".+")
+    void matchesNativeActiveUseTimingAndTridentState() throws Exception {
+        final Path fixtures = Path.of(System.getenv("STACKANVIL_ITEM_ACTIONS"));
+        for (final var raw :
+                JsonParser.parseString(Files.readString(fixtures.resolve("native-food.json")))
+                        .getAsJsonArray()) {
