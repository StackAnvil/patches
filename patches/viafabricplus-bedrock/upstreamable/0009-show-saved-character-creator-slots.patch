+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/** Replaces static preview surfaces with equipped animated geometry and texture strips. */
+final class BedrockPersonaAssembler {
+    private static final int FRAME_SIZE = 128;
+
+    private BedrockPersonaAssembler() {}
+
+    static BedrockPersonaModel.Converted assemble(
+            final BedrockPersonaModel.Converted preview,
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockPersonaAssets.Pack> packs)
+            throws IOException {
+        if (packs.isEmpty()) return preview;
+        final String height =
+                BedrockCharacterProfiles.height(slot)
+                        .orElseThrow(
+                                () -> new IOException("The character has an unknown body size"))
+                        .name()
+                        .toLowerCase(Locale.ROOT);
+        final List<Surface> surfaces = new ArrayList<>();
+        final Map<String, Tile> tiles = new LinkedHashMap<>();
+        int x = 0, y = 0, rowHeight = 0, frames = 1;
+        for (final var pack : packs.values()) {
+            final Map<String, JsonObject> geometries = new LinkedHashMap<>();
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".geometry.json")) continue;
+                final JsonObject json = json(file.getValue());
+                if (json.has("minecraft:geometry"))
+                    json.getAsJsonArray("minecraft:geometry")
+                            .forEach(
+                                    model ->
+                                            geometries.put(
+                                                    model.getAsJsonObject()
+                                                            .getAsJsonObject("description")
+                                                            .get("identifier")
+                                                            .getAsString(),
+                                                    model.getAsJsonObject()));
+                else
+                    json.entrySet().stream()
+                            .filter(entry -> entry.getKey().startsWith("geometry."))
+                            .forEach(
+                                    entry ->
+                                            geometries.put(
+                                                    entry.getKey(),
+                                                    entry.getValue().getAsJsonObject()));
+            }
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".meta.json")) continue;
+                final JsonObject metadata = json(file.getValue());
+                if (!metadata.has("geometry_sources")) continue;
+                for (final var element : metadata.getAsJsonArray("geometry_sources")) {
+                    final JsonObject source = element.getAsJsonObject();
+                    if (!source.has("animated")
+                            || !source.get("animated").getAsBoolean()
+                            || !matches(source, "arm_size", slot.arm())
+                            || !matches(source, "body_size", height)) continue;
+                    if (source.has("tint_map")) {
+                        throw new IOException("This animated persona piece needs tint map support");
+                    }
+                    final String texture = source.get("texture").getAsString();
+                    final String tileId = pack.id() + "/" + texture;
+                    Tile tile = tiles.get(tileId);
+                    final int count = source.get("frames").getAsInt();
+                    if (tile == null) {
+                        final BufferedImage image =
+                                BedrockPersonaAnimations.image(pack.files().get(texture));
+                        if (count < 1 || count > 256 || image.getHeight() % count != 0)
+                            throw new IOException("Invalid persona animation length");
+                        final int width = image.getWidth(), frameHeight = image.getHeight() / count;
+                        if (width > FRAME_SIZE || frameHeight > FRAME_SIZE)
+                            throw new IOException("A persona animation frame is too large");
+                        if (x + width > FRAME_SIZE) {
+                            x = 0;
+                            y += rowHeight;
+                            rowHeight = 0;
+                        }
+                        if (y + frameHeight > FRAME_SIZE)
+                            throw new IOException(
+                                    "The equipped animations exceed the texture atlas");
+                        tile = new Tile(image, x, y, count, frameHeight);
+                        tiles.put(tileId, tile);
+                        x += width;
+                        rowHeight = Math.max(rowHeight, frameHeight);
+                        frames = lcm(frames, count);
+                    } else if (count != tile.frames())
+                        throw new IOException(
+                                "A persona texture has conflicting animation lengths");
+                    final JsonObject geometry =
+                            geometries.get(source.get("geometry").getAsString());
+                    if (geometry == null)
+                        throw new IOException("A persona animation is missing its geometry");
+                    int sideMask = 0;
+                    for (final String recipe : slot.pieceIds()) {
+                        if (recipe.split("/", 2)[0].equalsIgnoreCase(pack.id()))
+                            sideMask |= BedrockLimbSide.fromRecipe(recipe).mask();
+                    }
+                    surfaces.add(new Surface(geometry, tile, sideMask == 0 ? 3 : sideMask));
+                }
+            }
+        }
+        if (surfaces.isEmpty()) return preview;
+        final JsonObject geometry = JsonParser.parseString(preview.geometry()).getAsJsonObject();
+        final JsonArray models = geometry.getAsJsonArray("minecraft:geometry");
+        final Map<String, JsonObject> body = new LinkedHashMap<>(),
+                animated = new LinkedHashMap<>();
+        models.get(0)
+                .getAsJsonObject()
+                .getAsJsonArray("bones")
+                .forEach(
+                        element -> {
+                            final JsonObject bone = element.getAsJsonObject(),
+                                    pose = bone.deepCopy();
+                            pose.remove("poly_mesh");
+                            pose.remove("cubes");
+                            final String name = bone.get("name").getAsString();
+                            body.put(name, bone);
+                            animated.put(name, pose);
+                        });
+        for (final var surface : surfaces)
+            for (final var element : surface.geometry().getAsJsonArray("bones")) {
+                if (!includesBone(surface, element.getAsJsonObject())) continue;
+                final JsonObject incoming = element.getAsJsonObject().deepCopy();
+                final String name = incoming.get("name").getAsString().toLowerCase(Locale.ROOT);
+                incoming.addProperty("name", name);
+                if (incoming.has("parent"))
+                    incoming.addProperty(
+                            "parent",
+                            incoming.get("parent").getAsString().toLowerCase(Locale.ROOT));
+                final JsonObject target =
+                        animated.computeIfAbsent(
+                                name,
+                                ignored -> {
+                                    final JsonObject pose = incoming.deepCopy();
+                                    pose.remove("cubes");
+                                    pose.remove("poly_mesh");
+                                    return pose;
+                                });
+                if (!incoming.has("cubes") && !incoming.has("poly_mesh")) continue;
+                if (body.containsKey(name)) {
+                    body.get(name).remove("poly_mesh");
+                    body.get(name).remove("cubes");
+                }
+                rewriteUvs(incoming, surface.tile());
+                if (incoming.has("cubes")) {
+                    if (!target.has("cubes")) target.add("cubes", new JsonArray());
+                    incoming.getAsJsonArray("cubes").forEach(target.getAsJsonArray("cubes")::add);
+                }
+                if (incoming.has("poly_mesh")) {
+                    if (target.has("poly_mesh"))
+                        throw new IOException("Two animated pieces replace the same polygon mesh");
+                    target.add("poly_mesh", incoming.get("poly_mesh"));
+                }
+            }
+        final String identifier = "geometry.persona.animated_pieces";
+        final JsonObject model = new JsonObject(), description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        description.addProperty("texture_width", FRAME_SIZE);
+        description.addProperty("texture_height", FRAME_SIZE);
+        model.add("description", description);
+        final JsonArray bones = new JsonArray();
+        animated.values().forEach(bones::add);
+        model.add("bones", bones);
+        models.add(model);
+        final JsonObject patch = JsonParser.parseString(preview.resourcePatch()).getAsJsonObject();
+        patch.getAsJsonObject("geometry").addProperty("animated_128x128", identifier);
+        final BufferedImage strip =
+                new BufferedImage(FRAME_SIZE, FRAME_SIZE * frames, BufferedImage.TYPE_INT_ARGB);
+        final Graphics2D graphics = strip.createGraphics();
+        try {
+            for (int frame = 0; frame < frames; frame++)
+                for (final var tile : tiles.values()) {
+                    final int offset = frame % tile.frames() * tile.height();
+                    graphics.drawImage(
+                            tile.image(),
+                            tile.x(),
+                            frame * FRAME_SIZE + tile.y(),
+                            tile.x() + tile.image().getWidth(),
+                            frame * FRAME_SIZE + tile.y() + tile.height(),
+                            0,
+                            offset,
+                            tile.image().getWidth(),
+                            offset + tile.height(),
+                            null);
+                }
+        } finally {
+            graphics.dispose();
+        }
+        return new BedrockPersonaModel.Converted(
+                preview.atlas(),
+                geometry.toString(),
+                patch.toString(),
+                List.of(new AnimationData(strip, 3, frames, 0)));
+    }
+
+    private static boolean includesBone(final Surface surface, final JsonObject bone)
+            throws IOException {
+        if (surface.sideMask() == 3) return true;
+        String name = bone.get("name").getAsString();
+        final Map<String, JsonObject> bones = new LinkedHashMap<>();
+        for (final var entry : surface.geometry().getAsJsonArray("bones")) {
+            final JsonObject node = entry.getAsJsonObject();
+            bones.put(node.get("name").getAsString(), node);
+        }
+        final Set<String> visited = new HashSet<>();
+        while (name != null) {
+            if (!visited.add(name))
+                throw new IOException("An animated limb has a cyclic bone hierarchy");
+            final String normalized = name.toLowerCase(Locale.ROOT);
+            if (normalized.startsWith("left")) return (surface.sideMask() & 1) != 0;
+            if (normalized.startsWith("right")) return (surface.sideMask() & 2) != 0;
+            final JsonObject node = bones.get(name);
+            name = node != null && node.has("parent") ? node.get("parent").getAsString() : null;
+        }
+        return true;
+    }
+
+    private static void rewriteUvs(final JsonObject bone, final Tile tile) throws IOException {
+        if (bone.has("cubes"))
+            for (final var element : bone.getAsJsonArray("cubes")) {
+                final JsonObject cube = element.getAsJsonObject();
+                if (!cube.has("uv")) continue;
+                if (cube.get("uv").isJsonArray())
+                    offset(cube.getAsJsonArray("uv"), tile.x(), tile.y());
+                else
+                    for (final var face : cube.getAsJsonObject("uv").entrySet())
+                        offset(
+                                face.getValue().getAsJsonObject().getAsJsonArray("uv"),
+                                tile.x(),
+                                tile.y());
+            }
+        if (bone.has("poly_mesh")) {
+            final JsonObject mesh = bone.getAsJsonObject("poly_mesh");
+            final boolean normalized =
+                    mesh.has("normalized_uvs") && mesh.get("normalized_uvs").getAsBoolean();
+            for (final var element : mesh.getAsJsonArray("uvs")) {
+                final JsonArray uv = element.getAsJsonArray(), mapped = new JsonArray();
+                final float u = uv.get(0).getAsFloat(), v = uv.get(1).getAsFloat();
+                mapped.add(
+                        normalized
+                                ? (tile.x() + u * tile.image().getWidth()) / FRAME_SIZE
+                                : tile.x() + u);
+                mapped.add(
+                        normalized
+                                ? 1F - (tile.y() + (1F - v) * tile.height()) / FRAME_SIZE
+                                : FRAME_SIZE - tile.y() - tile.height() + v);
+                uv.set(0, mapped.get(0));
+                uv.set(1, mapped.get(1));
+            }
+        }
+    }
+
+    private static void offset(final JsonArray uv, final int x, final int y) throws IOException {
+        if (uv == null || uv.size() != 2)
+            throw new IOException("A persona cube has invalid UV coordinates");
+        final JsonArray shifted = new JsonArray();
+        shifted.add(uv.get(0).getAsFloat() + x);
+        shifted.add(uv.get(1).getAsFloat() + y);
+        uv.set(0, shifted.get(0));
+        uv.set(1, shifted.get(1));
+    }
+
+    private static int lcm(final int left, final int right) throws IOException {
+        int a = left, b = right;
+        while (b != 0) {
+            final int remainder = a % b;
+            a = b;
+            b = remainder;
+        }
+        final int length = left / a * right;
+        if (length > 256)
+            throw new IOException("The equipped animations have incompatible lengths");
+        return length;
+    }
+
+    private static boolean matches(
+            final JsonObject source, final String property, final String expected) {
+        return !source.has(property) || expected.equals(source.get(property).getAsString());
+    }
+
+    private static JsonObject json(final byte[] bytes) {
+        return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)).getAsJsonObject();
+    }
+
+    private record Tile(BufferedImage image, int x, int y, int frames, int height) {}
+
+    private record Surface(JsonObject geometry, Tile tile, int sideMask) {}
+}
