+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleDefinitionTest.java
@@ -0,0 +1,190 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+
+final class BedrockParticleDefinitionTest {
+    @Test
+    void decodesHashedComponentsAndMolangVariants() throws Exception {
+        for (final int patch : new int[] {10, 30}) {
+            final byte[] bytes = definition();
+            ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).putShort(8, (short) patch);
+            final var parsed =
+                    BedrockParticleDefinition.read(bytes).getAsJsonObject("particle_effect");
+            final var emitter =
+                    parsed.getAsJsonObject("components")
+                            .getAsJsonObject("minecraft:emitter_lifetime_once");
+            assertEquals(1.25F, emitter.get("active_time").getAsFloat());
+            assertFalse(parsed.has("curves"));
+            assertFalse(parsed.has("events"));
+        }
+    }
+
+    @Test
+    void rejectsTruncationUnknownComponentsVariantsAndTrailingData() throws Exception {
+        final byte[] bytes = definition();
+        for (int length = 1; length < bytes.length; length++) {
+            final byte[] truncated = Arrays.copyOf(bytes, length);
+            assertThrows(IOException.class, () -> BedrockParticleDefinition.read(truncated));
+        }
+        final byte[] unknown = bytes.clone();
+        ByteBuffer.wrap(unknown).order(ByteOrder.LITTLE_ENDIAN).putInt(bytes.length - 11, 0);
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(unknown));
+        final byte[] tag = bytes.clone();
+        tag[bytes.length - 7] = 2;
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(tag));
+        final byte[] bool = bytes.clone();
+        bool[bytes.length - 1] = 2;
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(bool));
+        assertThrows(
+                IOException.class,
+                () -> BedrockParticleDefinition.read(Arrays.copyOf(bytes, bytes.length + 1)));
+    }
+
+    @Test
+    void rejectsInvalidUtf8LengthsVersionsAndNonFiniteValues() {
+        final byte[] bytes = definition();
+        final byte[] version = bytes.clone();
+        version[6]++;
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(version));
+        final byte[] length = bytes.clone();
+        Arrays.fill(length, 12, 17, (byte) 0xFF);
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(length));
+        final byte[] utf8 = bytes.clone();
+        utf8[13] = (byte) 0xFF;
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(utf8));
+        final byte[] number = bytes.clone();
+        ByteBuffer.wrap(number)
+                .order(ByteOrder.LITTLE_ENDIAN)
+                .putFloat(bytes.length - 6, Float.NaN);
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(number));
+    }
+
+    @Test
+    void rejectsDuplicateComponentsAndExcessiveCounts() throws Exception {
+        final byte[] bytes = definition();
+        final byte[] count = bytes.clone();
+        ByteBuffer.wrap(count).order(ByteOrder.LITTLE_ENDIAN).putInt(bytes.length - 15, -1);
+        assertThrows(IOException.class, () -> BedrockParticleDefinition.read(count));
+        final var duplicate = new ByteArrayOutputStream();
+        duplicate.writeBytes(Arrays.copyOf(bytes, bytes.length - 15));
+        duplicate.writeBytes(
+                ByteBuffer.allocate(4).order(ByteOrder.LITTLE_ENDIAN).putInt(2).array());
+        for (int i = 0; i < 2; i++)
+            duplicate.writeBytes(Arrays.copyOfRange(bytes, bytes.length - 11, bytes.length - 2));
+        duplicate.write(0);
+        duplicate.write(0);
+        assertThrows(
+                IOException.class, () -> BedrockParticleDefinition.read(duplicate.toByteArray()));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesReferenceDefinitionsThroughTheLicensedAssetLoader() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"));
+        final var library =
+                BedrockBuiltinAssets.index(
+                        "1.26.51.1", BedrockBuiltinAssets.unpack(root.resolve("package-assets")));
+        int count = 0;
+        try (var files = Files.list(root.resolve("decoded-particles"))) {
+            for (final Path expected :
+                    files.filter(path -> path.toString().endsWith(".json")).toList()) {
+                equivalent(
+                        JsonParser.parseString(Files.readString(expected)),
+                        library.particle("particles/" + expected.getFileName()));
+                count++;
+            }
+        }
+        assertEquals(115, count);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesLicensedVersionedOverlayDefinitions() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"));
+        final var paths =
+                JsonParser.parseString(
+                                Files.readString(root.resolve("overlay-particle-reference.json")))
+                        .getAsJsonArray();
+        for (final var path : paths) {
+            final String relative = path.getAsString();
+            equivalent(
+                    JsonParser.parseString(
+                            Files.readString(
+                                    root.resolve("decoded-overlay-particles").resolve(relative))),
+                    BedrockParticleDefinition.read(
+                            Files.readAllBytes(
+                                    root.resolve("overlay-package-unpacked").resolve(relative))));
+        }
+        assertEquals(108, paths.size());
+    }
+
+    private static void equivalent(final JsonElement expected, final JsonElement actual) {
+        if (expected.isJsonObject()) {
+            assertTrue(actual.isJsonObject());
+            assertEquals(expected.getAsJsonObject().keySet(), actual.getAsJsonObject().keySet());
+            for (final var entry : expected.getAsJsonObject().entrySet())
+                equivalent(entry.getValue(), actual.getAsJsonObject().get(entry.getKey()));
+        } else if (expected.isJsonArray()) {
+            assertTrue(actual.isJsonArray());
+            assertEquals(expected.getAsJsonArray().size(), actual.getAsJsonArray().size());
+            for (int i = 0; i < expected.getAsJsonArray().size(); i++)
+                equivalent(expected.getAsJsonArray().get(i), actual.getAsJsonArray().get(i));
+        } else if (expected.isJsonPrimitive() && expected.getAsJsonPrimitive().isNumber()) {
+            assertTrue(actual.isJsonPrimitive() && actual.getAsJsonPrimitive().isNumber());
+            final double value = expected.getAsDouble();
+            // The reference exporter prints float32 values with seven significant digits.
+            assertEquals(value, actual.getAsDouble(), Math.max(1E-7, Math.abs(value) * 6E-7));
+        } else assertEquals(expected, actual);
+    }
+
+    private static byte[] definition() {
+        final var bytes = new ByteArrayOutputStream();
+        bytes.writeBytes(
+                ByteBuffer.allocate(12)
+                        .order(ByteOrder.LITTLE_ENDIAN)
+                        .putInt(0x42434D7F)
+                        .putShort((short) 1)
+                        .putShort((short) 26)
+                        .putShort((short) 10)
+                        .put((byte) 0)
+                        .put((byte) 0)
+                        .array());
+        for (final String value :
+                new String[] {
+                    "particle_effect",
+                    "minecraft:fixture",
+                    "particles_alpha",
+                    "textures/particle/particles"
+                }) {
+            final byte[] text = value.getBytes(StandardCharsets.UTF_8);
+            bytes.write(text.length);
+            bytes.writeBytes(text);
+        }
+        bytes.writeBytes(
+                ByteBuffer.allocate(13)
+                        .order(ByteOrder.LITTLE_ENDIAN)
+                        .putInt(1)
+                        .putInt(BedrockParticleDefinition.hash("minecraft:emitter_lifetime_once"))
+                        .put((byte) 1)
+                        .putFloat(1.25F)
+                        .array());
+        bytes.write(0);
+        bytes.write(0);
+        return bytes.toByteArray();
+    }
+}
