+                JsonParser.parseString(Files.readString(capture.resolve("result.json")))
+                        .getAsJsonObject();
+        final String packId = evidence.get("cape").getAsString();
+        final var capePack =
+                BedrockMarketplaceAssets.decode(
+                        Files.readAllBytes(capture.resolve("cape-pack.zip")),
+                        packId, List.of(BedrockMarketplaceAssets.receiptKeys(receipt).get(packId)));
+        final var assets = BedrockPersonaBodyTest.assets();
+        final var original =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        for (final var height : BedrockCharacterProfiles.Height.values()) {
+            final var wardrobe =
+                    new BedrockCharacterProfiles.AccountWardrobe(
+                            List.of(original),
+                            1,
+                            1,
+                            JsonParser.parseString(
+                                            "{\"version\":\"0.1.0\",\"personaCollection\":{\"universalApp\":[{}]}}")
+                                    .getAsJsonObject());
+            final var profile =
+                    height == BedrockCharacterProfiles.height(original).orElseThrow()
+                            ? original.profile().deepCopy()
+                            : BedrockCharacterProfiles.heightChangeRequest(wardrobe, 1, height)
+                                    .getAsJsonArray("appearanceObjects")
+                                    .get(1)
+                                    .getAsJsonObject()
+                                    .getAsJsonObject("personaAppearance");
+            final var selected =
+                    BedrockPersonaBodyTest.slot(profile, original.arm(), original.skinColor());
+            final var handles = BedrockPersonaProfile.from(selected, List.of());
+            final var packs = new LinkedHashMap<>(BedrockPersonaBodyTest.packs(assets, handles));
+            profile.getAsJsonObject("personaCollection")
+                    .getAsJsonArray("universalApp")
+                    .add(JsonParser.parseString("{\"id\":\"" + packId + "\"}"));
+            final var slot =
+                    BedrockPersonaBodyTest.slot(profile, original.arm(), original.skinColor());
+            assertFalse(BedrockPersonaBody.available(slot, handles, packs));
+            packs.put(packId, capePack);
+            assertTrue(BedrockPersonaBody.available(slot, handles, packs));
+            final var body =
+                    BedrockPersonaBody.assemble(slot, packs, assets.model("geometry.cape"));
+            final var bones = BedrockPersonaBodyTest.bones(body);
+            final var cape = BedrockPersonaCape.read(slot, packs);
+            final var uv =
+                    bones.get("cape")
+                            .getAsJsonArray("cubes")
+                            .get(0)
+                            .getAsJsonObject()
+                            .getAsJsonObject("uv")
+                            .getAsJsonObject("north")
+                            .getAsJsonArray("uv");
+            final int x = uv.get(0).getAsInt() - 1, y = uv.get(1).getAsInt() - 1;
+            final BufferedImage image = cape.image();
+            for (int sy = 0; sy < image.getHeight(); sy++)
+                for (int sx = 0; sx < image.getWidth(); sx++)
+                    assertEquals(image.getRGB(sx, sy), body.atlas().getRGB(x + sx, y + sy));
+            final var actual =
+                    vertices(
+                            bones,
+                            body.atlas().getWidth(),
+                            x,
+                            y,
+                            image.getWidth(),
+                            image.getHeight());
+            final var expected =
+                    JsonParser.parseString(
+                                    Files.readString(
+                                            capture.resolve(
+                                                    height.name().toLowerCase(Locale.ROOT)
+                                                            + "-cape-mesh.json")))
+                            .getAsJsonObject();
+            final float bodyHeight = bones.get("body").getAsJsonArray("pivot").get(1).getAsFloat();
+            assertEquals(24, actual.size());
+            for (final var vertex : actual) {
+                boolean matched = false;
+                for (int index = 0; index < expected.getAsJsonArray("positions").size(); index++) {
+                    final var position =
+                            vector(
+                                    expected.getAsJsonArray("positions")
+                                            .get(index)
+                                            .getAsJsonArray());
+                    position.y += bodyHeight;
+                    position.z = 2 - position.z;
+                    final var normal =
+                            vector(expected.getAsJsonArray("normals").get(index).getAsJsonArray());
+                    normal.z = -normal.z;
+                    final var nativeUv = expected.getAsJsonArray("uvs").get(index).getAsJsonArray();
+                    if (vertex.position().distance(position) < 0.0005
+                            && vertex.normal().distance(normal) < 0.0001
+                            && Math.abs(vertex.u() - nativeUv.get(0).getAsFloat()) < 0.000001
+                            && Math.abs(vertex.v() - nativeUv.get(1).getAsFloat()) < 0.000001)
+                        matched = true;
+                }
+                assertTrue(matched, () -> height + " cape vertex differs: " + vertex);
+            }
+            final var assembled = BedrockPersonaAssembler.assemble(body, slot, packs);
+            assertEquals(bones.get("cape"), BedrockPersonaBodyTest.bones(assembled).get("cape"));
+            final var store =
+                    new BedrockAppearanceStore(
+                            directory.resolve(height.name()),
+                            _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+            store.importPersona(
+                    "123", assembled, "cape-fixture", slot.arm(), slot.skinColor(), handles);
+            final var saved = store.load("123").skinData("{}");
+            final var buffer = io.netty.buffer.Unpooled.buffer();
+            try {
+                final var type = new net.raphimc.viabedrock.protocol.types.model.SkinType();
+                type.write(buffer, saved);
+                final var decoded = type.read(buffer);
+                assertEquals(assembled.geometry(), decoded.geometryData());
+                assertEquals(assembled.animations().size(), decoded.animations().size());
+                assertArrayEquals(
+                        net.raphimc.viabedrock.protocol.types.primitive.ImageType.getImageData(
+                                assembled.atlas()),
+                        net.raphimc.viabedrock.protocol.types.primitive.ImageType.getImageData(
+                                decoded.skinData()));
+            } finally {
+                buffer.release();
+            }
+        }
+    }
+
+    private static List<Vertex> vertices(
+            final Map<String, JsonObject> bones,
+            final int atlasSize,
+            final int x,
+            final int y,
+            final int width,
+            final int height) {
+        final JsonObject model = new JsonObject(),
+                description = new JsonObject(),
+                document = new JsonObject();
+        description.addProperty("identifier", "geometry.test");
+        description.addProperty("texture_width", atlasSize);
+        description.addProperty("texture_height", atlasSize);
+        model.add("description", description);
+        final JsonArray array = new JsonArray();
+        for (final String name : List.of("root", "waist", "body", "cape"))
+            if (bones.containsKey(name)) array.add(bones.get(name));
+        model.add("bones", array);
+        final JsonArray models = new JsonArray();
+        models.add(model);
+        document.add("minecraft:geometry", models);
+        final var geometry = BedrockGeometryModel.fromJson(document.toString()).getFirst();
+        final var animated = BedrockGeometry.animatedModel(geometry, Map.of());
+        ModelPart part = animated.model().root();
+        final PoseStack pose = new PoseStack();
+        for (final String name : List.of("root", "waist", "body", "cape", "cube_0")) {
+            if (!part.hasChild(name)) continue;
+            part = part.getChild(name);
+            part.translateAndRotate(pose);
+        }
+        final List<Vertex> result = new ArrayList<>();
+        for (final var polygon : part.getRandomCube(RandomSource.create()).polygons)
+            for (final var vertex : polygon.vertices()) {
+                final var position =
+                        pose.last()
+                                .pose()
+                                .transformPosition(
+                                        new Vector3f(vertex.x(), vertex.y(), vertex.z()).div(16))
+                                .mul(16);
+                position.y = 24 - position.y;
+                final var normal = pose.last().normal().transform(new Vector3f(polygon.normal()));
+                normal.y = -normal.y;
+                result.add(
+                        new Vertex(
+                                position,
+                                normal,
+                                (vertex.u() * atlasSize - x) / width,
+                                (vertex.v() * atlasSize - y) / height));
+            }
+        return result;
+    }
+
+    private static Vector3f vector(final JsonArray vector) {
+        return new Vector3f(
+                vector.get(0).getAsFloat(), vector.get(1).getAsFloat(), vector.get(2).getAsFloat());
+    }
+
+    private record Vertex(Vector3f position, Vector3f normal, float u, float v) {}
+}
