@@ -0,0 +1,90 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.settings.StoreSignInMode;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockStoreSignInTest {
+    @Test
+    void existingAssetsAndTokensDoNotPromptOrStartInteractiveLogin() throws Exception {
+        final var gate = new BedrockStoreSignIn(() -> { throw new AssertionError(); });
+        final var calls = new AtomicInteger();
+        for (final var mode : StoreSignInMode.values()) {
+            gate.acquire("account", mode, calls::incrementAndGet, () -> { throw new AssertionError(); });
+        }
+        assertEquals(3, calls.get());
+    }
+
+    @Test
+    void concurrentMissingCredentialsShareConsentAndRememberDeclining() throws Exception {
+        final var consent = new CompletableFuture<Boolean>();
+        final var opened = new CountDownLatch(1);
+        final var prompts = new AtomicInteger();
+        final var gate = new BedrockStoreSignIn(() -> {
+            prompts.incrementAndGet();
+            opened.countDown();
+            return consent;
+        });
+        final var first = CompletableFuture.runAsync(() -> assertDeclined(gate));
+        assertTrue(opened.await(5, TimeUnit.SECONDS));
+        final var second = CompletableFuture.runAsync(() -> assertDeclined(gate));
+        consent.complete(false);
+        first.get(5, TimeUnit.SECONDS);
+        second.get(5, TimeUnit.SECONDS);
+        assertDeclined(gate);
+        assertEquals(1, prompts.get());
+    }
+
+    @Test
+    void interactiveLoginRequiresConsentUnlessExplicitlyAllowed() throws Exception {
+        final var calls = new AtomicInteger();
+        final var gate = new BedrockStoreSignIn(() -> CompletableFuture.completedFuture(true));
+        gate.acquire("account", StoreSignInMode.ASK, BedrockStoreSignInTest::missing, calls::incrementAndGet);
+        gate.acquire("account", StoreSignInMode.ALLOW, BedrockStoreSignInTest::missing, calls::incrementAndGet);
+        assertEquals(2, calls.get());
+        assertThrows(BedrockPackageHelper.StoreSignInRequiredException.class,
+                () -> gate.acquire("account", StoreSignInMode.NEVER, BedrockStoreSignInTest::missing, calls::incrementAndGet));
+        assertEquals(2, calls.get());
+    }
+
+    @Test
+    void cancellingAnAcceptedBrowserLoginPreventsRepeatedAssetPrompts() throws Exception {
+        final var prompts = new AtomicInteger();
+        final var gate = new BedrockStoreSignIn(() -> {
+            prompts.incrementAndGet();
+            return CompletableFuture.completedFuture(true);
+        });
+        assertThrows(BedrockStoreBrowser.SignInCancelledException.class,
+            () -> gate.acquire("account", StoreSignInMode.ASK, BedrockStoreSignInTest::missing,
+                () -> { throw new BedrockStoreBrowser.SignInCancelledException(); }));
+        assertDeclined(gate);
+        assertEquals(1, prompts.get());
+        final var retries = new AtomicInteger();
+        gate.acquire("account", StoreSignInMode.ALLOW, BedrockStoreSignInTest::missing, retries::incrementAndGet);
+        assertEquals(1, retries.get());
+    }
+
+    @Test
+    void unrelatedDownloadFailuresDoNotStartLogin() {
+        final var gate = new BedrockStoreSignIn(() -> { throw new AssertionError(); });
+        final var failure = new IOException();
+        assertSame(failure, assertThrows(IOException.class,
+                () -> gate.acquire("account", StoreSignInMode.ASK, () -> { throw failure; }, () -> { throw new AssertionError(); })));
+    }
+
+    private static void assertDeclined(final BedrockStoreSignIn gate) {
+        assertThrows(BedrockPackageHelper.StoreSignInRequiredException.class,
+                () -> gate.acquire("account", StoreSignInMode.ASK, BedrockStoreSignInTest::missing, () -> { throw new AssertionError(); }));
+    }
+
+    private static void missing() throws BedrockPackageHelper.StoreSignInRequiredException {
+        throw new BedrockPackageHelper.StoreSignInRequiredException();
+    }
+}
