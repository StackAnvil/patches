+            "experimental_vanilla_experiments",
+            "beta",
+            "platform_gdk_pc",
+        ] {
+            assert!(!library_pack(pack));
+            assert!(
+                asset_path(&format!("data/resource_packs/{pack}/models/mobs.json"))
+                    .unwrap()
+                    .is_none()
+            );
+        }
