+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonParser;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+
+/** Loads animation data only after the current account receipt authorizes its pack. */
+public final class BedrockEmotes {
+    private BedrockEmotes() {}
+
+    public static CompletableFuture<Emote> load(
+            final BedrockAuthManager account, final BedrockCharacterProfiles.WardrobeItem item) {
+        return CompletableFuture.supplyAsync(
+                () -> {
+                    try {
+                        if (!item.owned() || !"persona_emote".equals(item.type()))
+                            throw new IOException("Choose an owned emote");
+                        final var packs =
+                                BedrockPersonaAssets.load(
+                                        account,
+                                        List.of(
+                                                new BedrockPersonaAssets.Reference(
+                                                        item.packId(), item.id())));
+                        final var pack = packs.get(item.packId());
+                        if (pack == null)
+                            throw new IOException("This emote has no asset entitlement");
+                        return read(pack);
+                    } catch (Exception e) {
+                        throw new IllegalStateException(
+                                "Could not load the owned Bedrock emote", e);
+                    }
+                });
+    }
+
+    static Emote read(final BedrockPersonaAssets.Pack pack) throws IOException {
+        try {
+            Emote result = null;
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".meta.json")) continue;
+                final var metadata =
+                        JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8))
+                                .getAsJsonObject();
+                if (!"persona_emote".equals(metadata.get("piece_type").getAsString())) continue;
+                if (result != null) throw new IOException("The emote pack has ambiguous metadata");
+                final var sources = metadata.getAsJsonArray("animation_sources");
+                if (sources == null || sources.size() != 1)
+                    throw new IOException("The emote needs multiple animation sources");
+                final var source = sources.get(0).getAsJsonObject();
+                final String path = source.get("animationFile").getAsString();
+                final byte[] bytes = pack.files().get(path);
+                if (bytes == null || bytes.length > 2 * 1024 * 1024)
+                    throw new IOException("The emote animation file is missing or too large");
+                final var definitions =
+                        JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                                .getAsJsonObject()
+                                .getAsJsonObject("animations");
+                final var animation = definitions.getAsJsonObject(source.get("name").getAsString());
+                if (animation == null) throw new IOException("The emote animation name is missing");
+                result =
+                        new Emote(
+                                UUID.fromString(pack.id()),
+                                BedrockBoneAnimation.parse(animation));
+            }
+            if (result == null) throw new IOException("The pack has no emote animation");
+            return result;
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid Bedrock emote metadata", e);
+        }
+    }
+
+    public record Emote(UUID id, BedrockBoneAnimation animation) {}
+}
