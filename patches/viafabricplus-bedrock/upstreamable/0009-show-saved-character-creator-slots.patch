+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.Locale;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Installs the helper embedded in this add-on and communicates without passing secrets as
+ * arguments.
+ */
+final class BedrockPackageHelper {
+    private BedrockPackageHelper() {}
+
+    static Path install(final Path root) throws IOException {
+        final String os = System.getProperty("os.name").toLowerCase(Locale.ROOT);
+        final String platform =
+                os.contains("win")
+                        ? "windows"
+                        : os.contains("mac")
+                                ? "macos"
+                                : os.contains("linux") ? "linux" : "unsupported";
+        final String arch =
+                switch (System.getProperty("os.arch").toLowerCase(Locale.ROOT)) {
+                    case "amd64", "x86_64" -> "x86_64";
+                    case "aarch64", "arm64" -> "aarch64";
+                    default -> "unsupported";
+                };
+        final String name = "persona-assets" + (platform.equals("windows") ? ".exe" : "");
+        final String resource =
+                "/assets/viafabricplus-bedrock/native/" + platform + "-" + arch + "/" + name;
+        final byte[] bytes = BedrockBuiltinAssets.resource(resource);
+        final String digest =
+                new String(
+                                BedrockBuiltinAssets.resource(resource + ".sha256"),
+                                StandardCharsets.US_ASCII)
+                        .strip();
+        if (!BedrockBuiltinAssets.hash(bytes).equals(digest))
+            throw new IOException("The bundled package helper failed its checksum check");
+        final Path directory = root.resolve(digest);
+        Files.createDirectories(directory);
+        final Path executable = directory.resolve(name);
+        if (!Files.isRegularFile(executable)
+                || !BedrockBuiltinAssets.hash(Files.readAllBytes(executable)).equals(digest)) {
+            final Path temporary = Files.createTempFile(directory, ".helper-", ".tmp");
+            try {
+                Files.write(temporary, bytes);
+                Files.move(
+                        temporary,
+                        executable,
+                        StandardCopyOption.ATOMIC_MOVE,
+                        StandardCopyOption.REPLACE_EXISTING);
+            } finally {
+                Files.deleteIfExists(temporary);
+            }
+        }
+        if (!platform.equals("windows") && !executable.toFile().setExecutable(true, true))
+            throw new IOException("Could not make the package helper executable");
+        return executable;
+    }
+
+    static void acquire(final Path executable, final JsonObject request) throws Exception {
+        final Process process =
+                new ProcessBuilder(executable.toAbsolutePath().toString())
+                        .redirectErrorStream(true)
+                        .start();
+        final CompletableFuture<String> output = new CompletableFuture<>();
+        Thread.ofVirtual()
+                .start(
+                        () -> {
+                            try (InputStream input = process.getInputStream()) {
+                                final byte[] bytes = input.readNBytes(16384);
+                                // Drain unexpected diagnostics without placing them in a log or UI.
+                                input.transferTo(java.io.OutputStream.nullOutputStream());
+                                output.complete(new String(bytes, StandardCharsets.UTF_8));
+                            } catch (IOException e) {
+                                output.completeExceptionally(e);
+                            }
+                        });
+        try {
+            try (var input = process.getOutputStream()) {
+                input.write(request.toString().getBytes(StandardCharsets.UTF_8));
+            }
+            if (!process.waitFor(20, TimeUnit.MINUTES))
+                throw new IOException("Microsoft Store sign-in or persona download timed out");
+            final String text = output.get(10, TimeUnit.SECONDS);
+            boolean success = false;
+            for (final String line : text.lines().toList()) {
+                if (!line.startsWith("{")) continue;
+                try {
+                    success =
+                            JsonParser.parseString(line).getAsJsonObject().get("ok").getAsBoolean();
+                } catch (RuntimeException ignored) {
+                    /* Ignore helper diagnostics. */
+                }
+            }
+            if (process.exitValue() != 0 || !success)
+                throw new IOException(
+                        "Could not acquire built-in assets. Sign in with the selected account and"
+                                + " check that it owns Minecraft for Windows.");
+        } finally {
+            if (process.isAlive()) {
+                process.descendants().forEach(ProcessHandle::destroy);
+                process.destroyForcibly();
+            }
+        }
+    }
+}
