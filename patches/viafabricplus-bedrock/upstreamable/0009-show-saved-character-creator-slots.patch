+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+
+/** Binds immutable native geometry values before any render-space conversion or animation. */
+final class BedrockGeometryQueries {
+    private BedrockGeometryQueries() {
+    }
+
+    static Map<String, Object> of(final BedrockGeometryModel geometry) {
+        final Map<String, Pivot> pivots = new HashMap<>();
+        for (final var bone : geometry.getParents()) {
+            final var pivot = bone.getPivot();
+            pivots.put(nativeName(bone.getName()), new Pivot(pivot.getX(), pivot.getY(), pivot.getZ()));
+        }
+        final Map<String, Pivot> snapshot = Map.copyOf(pivots);
+        return Map.of("get_default_bone_pivot", (BedrockActorAnimation.Query) arguments -> pivot(snapshot, arguments));
+    }
+
+    private static String nativeName(final String name) {
+        final char[] characters = name.toCharArray();
+        for (int i = 0; i < characters.length; i++)
+            if (characters[i] >= 'A' && characters[i] <= 'Z') characters[i] += 'a' - 'A';
+        return new String(characters);
+    }
+
+    private static float pivot(final Map<String, Pivot> pivots, final List<Object> arguments) {
+        if (arguments.size() != 2 || !(arguments.getFirst() instanceof String name)) return 0;
+        final Pivot pivot = pivots.get(name);
+        if (pivot == null) return 0;
+        final Object argument = arguments.get(1);
+        final int axis;
+        if (argument instanceof Number number) {
+            final float value = number.floatValue();
+            // Native converts float to signed 64-bit, then tests the low unsigned 32 bits.
+            axis = Float.isNaN(value) || value >= 0x1p63F || value < -0x1p63F ? 0 : (int) (long) value;
+        } else if (argument instanceof String axisName) {
+            axis = switch (axisName) {
+                case "x" -> 0;
+                case "y" -> 1;
+                case "z" -> 2;
+                default -> -1;
+            };
+        } else {
+            return 0;
+        }
+        return switch (axis) {
+            case 0 -> pivot.x();
+            case 1 -> pivot.y();
+            case 2 -> pivot.z();
+            default -> 0;
+        };
+    }
+
+    private record Pivot(float x, float y, float z) {
+    }
+}
