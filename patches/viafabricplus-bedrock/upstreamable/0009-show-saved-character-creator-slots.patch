+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockActorAnimationTest {
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+
+    @Test
+    void retainsEffectBindingsWithoutAnimationOrScriptSections() throws IOException {
+        for (final boolean animations : List.of(false, true)) {
+            for (final boolean scripts : List.of(false, true)) {
+                final var entity = json("""
+                        {"sound_effects":{"clang":"emote.clang"},
+                         "particle_effects":{"spark":"test:spark"}}
+                        """);
+                if (animations) entity.add("animations", new JsonObject());
+                if (scripts) entity.add("scripts", new JsonObject());
+                final var playback = BedrockActorAnimation.read(entity, Map.of(),
+                        new JsonObject(), new JsonObject(), "1.10.0").playback();
+                assertTrue(playback.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of())).isEmpty());
+                final var sound = new BedrockAnimationSound(0, "clang", "hand");
+                final var resolvedSound = playback.soundCue(sound);
+                assertEquals(entity.getAsJsonObject("sound_effects").get(sound.effect()).getAsString(),
+                        resolvedSound.event());
+                assertEquals(sound.locator(), resolvedSound.locator());
+                final var particle = new BedrockAnimationParticle(0, "spark", "head", false,
+                        BedrockMolang.Program.parse(null, 0));
+                final var resolvedParticle = playback.particleCue(
+                        new BedrockAnimationParticle.Cue(particle, new BedrockMolang()));
+                assertEquals(entity.getAsJsonObject("particle_effects").get(particle.effect()).getAsString(),
+                        resolvedParticle.event());
+                assertEquals(particle.locator(), resolvedParticle.locator());
+                assertEquals(particle.attached(), resolvedParticle.attached());
+                assertNull(playback.soundCue(new BedrockAnimationSound(0, "unknown", "")));
+            }
+        }
+    }
+
+    @Test
+    void resolvesAnimationOverridesWithoutAnEntityAliasSection() throws IOException {
+        final var graph = BedrockActorAnimation.read(
+                json("{\"scripts\":{\"animate\":[\"root\"]}}"),
+                Map.of("root", "animation.root"),
+                json("{\"animation.root\":{\"bones\":{\"head\":{\"position\":[2,0,0]}}}}"),
+                new JsonObject(), "1.10.0");
+        final var pose = graph.playback().sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(2, pose.get("head").position().x());
+    }
+
+    @Test
+    void evaluatesLongScriptFragmentsWithinTheAggregateBudget() throws IOException {
+        final var molang = new BedrockMolang();
+        final var script = BedrockMolang.Program.script(List.of(
+                "v.counter=0;" + "v.counter=v.counter+1;".repeat(240),
+                "return v.counter;"));
+        assertEquals(240, molang.value(script).getAsNumber());
+        assertThrows(IOException.class, () -> BedrockMolang.Program.script(List.of(" ".repeat(16385))));
+        assertThrows(IOException.class, () -> BedrockMolang.Program.script(List.of(" ".repeat(8193), " ".repeat(8193))));
+    }
+
+    @Test
+    void sharesVariablesAcrossOrderedAnimationsAndKeepsActorStateIndependent() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"a":"animation.a","b":"animation.b"},"scripts":{
+                                  "initialize":["variable.counter=0;"], "pre_animation":["variable.counter=variable.counter+1;"],"animate":["a",{"b":0.5}]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.a":{"loop":true,"bones":{"arm":{"rotation":["variable.counter",0,0],"position":[1,0,0]}}},
+                                 "animation.b":{"loop":true,"bones":{"arm":{"rotation":[2,0,0],"position":[0,3,0]}}}}
+                                """),
+                        new JsonObject(),
+                        "1.10.0");
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        final var actor = graph.playback();
+        final var first = actor.sample(0, frame).get("arm");
+        assertEquals(new BedrockBoneAnimation.Vector(1, 1.5F, 0), first.position());
+        assertEquals(2, first.rotation().x());
+        assertEquals(3, actor.sample(0.5F, frame).get("arm").rotation().x());
+        assertEquals(2, graph.playback().sample(0, frame).get("arm").rotation().x());
+    }
+
+    @Test
+    void evaluatesChannelThisAgainstEarlierWeightedTracksWithoutInheritingMissingChannels()
+            throws IOException {
+        final var actor =
+                BedrockActorAnimation.read(
+                                json(
+                                        """
+                                        {"animations":{"base":"animation.base","relative":"animation.relative"},
+                                         "scripts":{"animate":["base",{"relative":0.5}]}}
+                                        """),
+                                Map.of(),
+                                json(
+                                        """
+                                        {"animation.base":{"loop":true,"bones":{"arm":{
+                                          "position":[2,4,6],"rotation":[10,20,30],"scale":[2,3,4]}}},
+                                         "animation.relative":{"loop":true,"bones":{"arm":{
+                                          "position":["-this",0,0],"rotation":["-60-this",0,0],
+                                          "scale":["1/this",1,1]}}}}
+                                        """),
+                                new JsonObject(),
+                                "1.10.0")
+                        .playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        for (final float time : new float[] {0, 0.1F}) {
+            final var arm = actor.sample(time, frame).get("arm");
+            assertEquals(new BedrockBoneAnimation.Vector(1, 4, 6), arm.position());
+            assertEquals(new BedrockBoneAnimation.Vector(-25, 20, 30), arm.rotation());
+            assertEquals(new BedrockBoneAnimation.Vector(1.5F, 3, 4), arm.scale());
+        }
+    }
+
+    @Test
+    void usesStringQueriesTransitionOrderNestedControllersAndEmptyOverrides() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"root":"controller.animation.root","child":"controller.animation.child","idle":"animation.idle","selected":"animation.selected","removed":"animation.missing"},
+                                 "scripts":{"animate":["root"]}}
+                                """),
+                        Map.of("removed", ""),
+                        json(
+                                """
+                                {"animation.idle":{"loop":true,"bones":{"arm":{"rotation":1}}},"animation.selected":{"loop":true,"bones":{"arm":{"rotation":9}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"initial_state":"idle","states":{
+                                   "idle":{"animations":["idle"],"transitions":[{"first":"query.get_equipped_item_name == 'bow'"},{"second":"query.enabled"}]},
+                                   "first":{"animations":["child","removed"]},"second":{"animations":["idle"]}}},
+                                 "controller.animation.child":{"initial_state":"default","states":{"default":{"animations":[{"selected":"query.get_equipped_item_name('off_hand') != 'bow'"}]}}}}
+                                """),
+                        "1.10.0");
+        final BedrockActorAnimation.Query items = arguments -> arguments.isEmpty() ? "bow" : "map";
+        final var selected = graph.playback();
+        selected.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(
+                9,
+                selected.sample(
+                                0.1F,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("get_equipped_item_name", items, "enabled", 1F),
+                                        Map.of()))
+                        .get("arm")
+                        .rotation()
+                        .x());
+        assertEquals(
+                1,
+                graph.playback()
+                        .sample(
+                                0,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("get_equipped_item_name", "map", "enabled", 1F),
+                                        Map.of()))
+                        .get("arm")
+                        .rotation()
+                        .x());
+    }
+
+    @Test
+    void sharesTimelineWritesWithLaterTracksAndControllerTransitions() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"writer":"animation.writer","root":"controller.animation.root",
+                                   "before":"animation.before","after":"animation.after"},
+                                 "scripts":{"animate":["writer","root"]}}
+                                """),
+                        Map.of(),
+                        json(
