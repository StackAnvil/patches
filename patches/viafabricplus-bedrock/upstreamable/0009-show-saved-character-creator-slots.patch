+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockPersonaProfileTest {
+    @Test
+    void resolvesAllPresetsWithoutCatalogOrPrivateAssets() throws Exception {
+        for (final var starter : BedrockCharacterProfiles.Starter.values()) {
+            final var slot = starterSlot(starter);
+            final var profile = BedrockPersonaProfile.from(slot, List.of());
+            assertTrue(profile.pieces().size() >= 9);
+            assertTrue(profile.pieces().stream().allMatch(piece -> piece.defaultPiece() && piece.productId().isEmpty()));
+            assertEquals(profile.pieces().size(), profile.pieces().stream().map(piece -> piece.id()).distinct().count());
+            assertEquals(profile, BedrockPersonaProfile.fromJson(profile.toJson()));
+            for (final var tint : profile.tints()) {
+                assertEquals(4, tint.colors().size());
+                assertTrue(profile.pieces().stream().anyMatch(piece -> piece.type().equals(tint.type())));
+            }
+        }
+    }
+
+    @Test
+    void resolvesOwnedHandlesAndTintsWithoutIncludingEmotesOrCapes() throws Exception {
+        final var slot = starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var entries = slot.profile().getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        final var owned = new BedrockCharacterProfiles.WardrobeItem("28c8346d-8b28-4968-b00b-6b89e3542a1a", "Office shirt",
+            "persona_top", "", "4a227a96-4467-412a-ba09-aee5f58bf344", true);
+        entries.add(BedrockCharacterProfiles.catalogRecipe(owned));
+        entries.add(JsonParser.parseString("{\"id\":\"33a50358-82f8-07f0-8382-5c04a07628eb.0\"}"));
+        final var profile = BedrockPersonaProfile.from(slot, List.of(owned));
+        final var handle = profile.pieces().getLast();
+        assertFalse(handle.defaultPiece());
+        assertEquals(owned.packId(), handle.id());
+        assertEquals(owned.packId(), handle.packId());
+        assertEquals(owned.id(), handle.productId());
+        assertEquals(3, profile.tints().size());
+        assertEquals(profile, BedrockPersonaProfile.fromJson(profile.toJson()));
+        assertEquals("Top", handle.type());
+        assertEquals("persona_top", profile.pieceClaims().getLast().get("PieceType"));
+        assertEquals(handle.id(), profile.pieceClaims().getLast().get("PieceId"));
+        assertEquals(profile.tints().getFirst().colors(), profile.tintClaims().getFirst().get("Colors"));
+    }
+
+    @Test
+    void convertsCatalogClaimTypesToPacketTypesAndBack() throws Exception {
+        for (final String type : List.of("persona_high_pants", "persona_facial_hair", "persona_hand",
+            "persona_face_accessory", "persona_arms", "persona_legs")) {
+            final var slot = starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+            final var item = new BedrockCharacterProfiles.WardrobeItem(java.util.UUID.randomUUID().toString(), "",
+                type, "", java.util.UUID.randomUUID().toString(), true);
+            slot.profile().getAsJsonObject("personaCollection").getAsJsonArray("universalApp")
+                .add(BedrockCharacterProfiles.catalogRecipe(item));
+            final var profile = BedrockPersonaProfile.from(slot, List.of(item));
+            final var piece = profile.pieces().getLast();
+            assertNotNull(net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.persona_PieceType.getByName(piece.type()));
+            assertEquals(item.type(), profile.pieceClaims().getLast().get("PieceType"));
+        }
+    }
+
+    @Test
+    void rejectsUnresolvedPiecesAndMalformedTintGroups() throws Exception {
+        final var slot = starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var entries = slot.profile().getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        final var unknown = JsonParser.parseString("{\"id\":\"11111111-1111-4111-8111-111111111111\"}");
+        entries.add(unknown);
+        assertThrows(java.io.IOException.class, () -> BedrockPersonaProfile.from(slot, List.of()));
+        entries.remove(entries.size() - 1);
+        entries.get(3).getAsJsonObject().getAsJsonArray("col").remove(0);
+        assertThrows(java.io.IOException.class, () -> BedrockPersonaProfile.from(slot, List.of()));
+    }
+
+    static BedrockCharacterProfiles.Slot starterSlot(final BedrockCharacterProfiles.Starter starter) throws Exception {
+        final List<BedrockCharacterProfiles.Slot> slots = new ArrayList<>();
+        for (int index = 1; index <= 5; index++) {
+            slots.add(new BedrockCharacterProfiles.Slot(index, "wide", "#ffb37b62", List.of(), "", new JsonObject()));
+        }
+        final var settings = JsonParser.parseString("{\"version\":\"0.1.0\",\"personaCollection\":{\"universalApp\":[{\"lastUsedPersonaSlot\":\"persona_profile_persona1\"}]}}").getAsJsonObject();
+        final var wardrobe = new BedrockCharacterProfiles.AccountWardrobe(slots, 1, 1, settings);
+        final JsonObject profile = BedrockCharacterProfiles.createStarterRequest(wardrobe, 1, starter)
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance");
+        final List<String> ids = new ArrayList<>();
+        profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp").forEach(element -> {
+            if (element.getAsJsonObject().has("id")) ids.add(element.getAsJsonObject().get("id").getAsString());
+        });
+        return new BedrockCharacterProfiles.Slot(1, "wide", starter.skinColor(), ids, "test-profile", profile);
+    }
+}
