+                final Map<String, Object> queries =
+                        new java.util.HashMap<>(
+                                new BedrockItemAnimation(
+                                                item,
+                                                BedrockItemAnimation.Item.EMPTY,
+                                                item,
+                                                BedrockItemAnimation.Item.EMPTY,
