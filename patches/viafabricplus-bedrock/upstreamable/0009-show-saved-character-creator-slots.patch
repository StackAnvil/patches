+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/** Render-controller part visibility evaluated in the animated actor's variable scope. */
+final class BedrockActorVisibility {
+    private final List<Controller> controllers;
+    private final Map<String, String> geometries;
+
+    private BedrockActorVisibility(final List<Controller> controllers, final Map<String, String> geometries) {
+        this.controllers = List.copyOf(controllers);
+        this.geometries = Map.copyOf(geometries);
+    }
+
+    static BedrockActorVisibility read(final JsonObject entity,
+                                       final Map<String, JsonObject> definitions) throws IOException {
+        final List<Controller> controllers = new ArrayList<>();
+        final JsonElement references = entity.get("render_controllers");
+        if (references != null) {
+            for (final var reference : references.getAsJsonArray()) {
+                final String name;
+                final JsonElement condition;
+                if (reference.isJsonPrimitive() && reference.getAsJsonPrimitive().isString()) {
+                    name = reference.getAsString();
+                    condition = null;
+                } else {
+                    if (reference.getAsJsonObject().size() != 1)
+                        throw new IOException("Invalid actor render controller reference");
+                    final var entry = reference.getAsJsonObject().entrySet().iterator().next();
+                    name = entry.getKey();
+                    condition = entry.getValue();
+                }
+                final JsonObject definition = definitions.get(name);
+                if (definition == null) continue;
+                final List<Rule> rules = new ArrayList<>();
+                final var visibility = definition.getAsJsonArray("part_visibility");
+                if (visibility != null) {
+                    for (final var group : visibility) {
+                        for (final var entry : group.getAsJsonObject().entrySet()) {
+                            if (entry.getKey().length() > 512 || rules.size() >= 4096)
+                                throw new IOException("Too many actor part visibility rules");
+                            final String regex = Pattern.quote(entry.getKey()).replace("*", "\\E.*\\Q");
+                            rules.add(new Rule(Pattern.compile(regex), expression(entry.getValue())));
+                        }
+                    }
+                }
+                controllers.add(new Controller(expression(condition),
+                        definition.has("geometry") ? expression(definition.get("geometry")) : null, List.copyOf(rules)));
+                if (controllers.size() > 256) throw new IOException("Too many actor render controllers");
+            }
+        }
+        final Map<String, String> geometries = new java.util.LinkedHashMap<>();
+        if (entity.has("geometry"))
+            entity.getAsJsonObject("geometry").entrySet()
+                    .forEach(entry -> geometries.put(entry.getKey(), entry.getValue().getAsString()));
+        return new BedrockActorVisibility(controllers, geometries);
+    }
+
+    private static BedrockMolang.Program expression(final JsonElement value) throws IOException {
+        return BedrockMolang.Program.parse(value != null && value.isJsonPrimitive()
+                && value.getAsJsonPrimitive().isBoolean()
+                ? new com.google.gson.JsonPrimitive(value.getAsBoolean() ? 1 : 0) : value, 1);
+    }
+
+    BedrockActorAnimation.Visibility sample(final BedrockMolang molang) {
+        if (this.controllers.isEmpty()) return BedrockActorAnimation.Visibility.UNSPECIFIED;
+        molang.binding("geometry", this.geometries);
+        final String primary = this.geometries.get("default");
+        final List<List<BedrockActorAnimation.PartVisibility>> selected = new ArrayList<>();
+        for (final Controller controller : this.controllers) {
+            if (molang.evaluate(controller.condition, 0) == 0) continue;
+            if (primary != null && controller.geometry != null
+                    && !primary.equals(molang.value(controller.geometry).getAsString())) continue;
+            final List<BedrockActorAnimation.PartVisibility> parts = new ArrayList<>();
+            for (final Rule rule : controller.rules)
+                parts.add(new BedrockActorAnimation.PartVisibility(rule.pattern, molang.evaluate(rule.expression, 0) != 0));
+            selected.add(List.copyOf(parts));
+        }
+        return new BedrockActorAnimation.Visibility(true, List.copyOf(selected));
