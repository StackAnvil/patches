+        final var starter =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final JsonObject profile = starter.profile().deepCopy();
+        final JsonArray entries =
+                profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        entries.get(0)
+                .getAsJsonObject()
+                .addProperty("skcol", capture.get("SkinColor").getAsString());
+        for (final var tint : capture.getAsJsonArray("PieceTintColors")) {
+            final JsonObject group = tint.getAsJsonObject();
+            for (final var entry : entries) {
+                final JsonObject recipe = entry.getAsJsonObject();
+                if (recipe.has("id")
+                        && group.get("PieceType")
+                                .getAsString()
+                                .equals(
+                                        BedrockPersonaProfile.defaultType(
+                                                recipe.get("id").getAsString().split("/", 2)[0])))
+                    recipe.add("col", group.get("Colors").deepCopy());
+            }
+        }
+        final var slot =
+                new BedrockCharacterProfiles.Slot(
+                        starter.number(),
+                        starter.arm(),
+                        capture.get("SkinColor").getAsString(),
+                        starter.pieceIds(),
+                        starter.profileHash(),
+                        profile);
+        final Map<String, BedrockMarketplaceAssets.Pack> packs = new LinkedHashMap<>();
+        for (final var handle : BedrockPersonaProfile.from(slot, List.of()).pieces())
+            packs.put(handle.id(), assets.piece(handle.id()));
+        final BufferedImage atlas = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        final JsonObject document = new JsonObject(),
+                body = new JsonObject(),
+                description = new JsonObject();
+        description.addProperty("identifier", "geometry.test");
+        description.addProperty("texture_width", 128);
+        description.addProperty("texture_height", 128);
+        body.add("description", description);
+        final JsonArray bones = new JsonArray();
+        for (final String name : new String[] {"root", "waist", "body", "head", "hat"}) {
+            final JsonObject bone = new JsonObject();
+            bone.addProperty("name", name);
+            if (!name.equals("root"))
+                bone.addProperty(
+                        "parent",
+                        name.equals("waist")
+                                ? "root"
+                                : name.equals("body")
+                                        ? "waist"
+                                        : name.equals("head") ? "body" : "head");
+            bone.add("cubes", new JsonArray());
+            bones.add(bone);
+        }
+        body.add("bones", bones);
+        final JsonArray models = new JsonArray();
+        models.add(body);
+        document.add("minecraft:geometry", models);
+        final var preview =
+                new BedrockPersonaModel.Converted(
+                        atlas,
+                        document.toString(),
+                        "{\"geometry\":{\"default\":\"geometry.test\"}}",
+                        List.of());
+        final var assembled = BedrockPersonaAssembler.assemble(preview, slot, packs);
+        assertDoesNotThrow(
+                () ->
+                        org.cube.converter.model.impl.bedrock.BedrockGeometryModel.fromJson(
+                                com.viaversion.viaversion.libs.gson.JsonParser.parseString(
+                                                assembled.geometry())
+                                        .getAsJsonObject()));
+        final var face =
+                assembled.animations().stream()
+                        .filter(animation -> animation.type() == 1)
+                        .findFirst()
+                        .orElseThrow();
+        final JsonObject nativeFace =
+                capture.getAsJsonArray("AnimatedImageData").asList().stream()
+                        .map(element -> element.getAsJsonObject())
+                        .filter(animation -> animation.get("Type").getAsInt() == 1)
+                        .findFirst()
+                        .orElseThrow();
+        final byte[] rgba = Base64.getDecoder().decode(nativeFace.get("Image").getAsString());
+        assertEquals(nativeFace.get("ImageWidth").getAsInt(), face.image().getWidth());
+        assertEquals(nativeFace.get("ImageHeight").getAsInt(), face.image().getHeight());
+        assertEquals(nativeFace.get("Frames").getAsInt(), face.frames());
+        assertEquals(nativeFace.get("AnimationExpression").getAsInt(), face.expression());
+        int offset = 0;
+        for (int y = 0; y < face.image().getHeight(); y++)
+            for (int x = 0; x < face.image().getWidth(); x++) {
+                final int expected =
+                        (rgba[offset + 3] & 255) << 24
+                                | (rgba[offset] & 255) << 16
+                                | (rgba[offset + 1] & 255) << 8
+                                | rgba[offset + 2] & 255;
+                assertEquals(expected, face.image().getRGB(x, y));
+                offset += 4;
+            }
+        final var assembledModels =
+                JsonParser.parseString(assembled.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry");
+        for (final var bone : assembledModels.get(0).getAsJsonObject().getAsJsonArray("bones")) {
+            final JsonObject node = bone.getAsJsonObject();
+            if (node.get("name").getAsString().equals("head")
+                    || node.get("name").getAsString().equals("hat")) assertFalse(node.has("cubes"));
+        }
+        assertEquals(
+                2,
+                assembledModels.get(1).getAsJsonObject().getAsJsonArray("bones").asList().stream()
+                        .filter(element -> element.getAsJsonObject().has("poly_mesh"))
+                        .count());
+        assertTrue(
+                JsonParser.parseString(preview.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")
+                        .get(3)
+                        .getAsJsonObject()
+                        .has("cubes"));
+    }
+}
