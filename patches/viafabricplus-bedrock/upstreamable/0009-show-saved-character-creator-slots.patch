+    private static void playEffects(
+            final Appearance appearance, final Avatar entity, final AvatarRenderState state,
+            final Map<String, BedrockBoneAnimation.Transform> pose, final List<BedrockActorAnimation.SoundCue> sounds,
+            final List<BedrockActorAnimation.ParticleCue> particles) {
+        if (appearance == null) return;
+        if (sounds.isEmpty() && particles.isEmpty() && appearance.soundModel == null) return;
+        final Geometry geometry = geometry(appearance, true);
+        if (geometry != null && appearance.soundModel == null)
+            appearance.soundModel = BedrockGeometry.animatedModel(geometry.model(), geometry.meshes());
+        if (appearance.soundModel != null) appearance.soundModel.pose(pose);
+        for (final var sound : sounds)
+            sound.play(effectPosition(appearance, geometry, entity, state.bodyRot, sound.locator()));
+        final var world = entity.level();
+        final var registryOwner = BedrockActorState.lifetime(entity.getUUID());
+        for (final var particle : particles) {
+            if (particle.attached()) {
+                particle.play(net.minecraft.world.phys.Vec3.ZERO,
+                        () -> Minecraft.getInstance().level != world || entity.isRemoved()
+                                && (registryOwner == null || !registryOwner.equals(BedrockActorState.lifetime(entity.getUUID())))
+                                ? null : particleAttachment(appearance, geometry, entity, particle.locator()));
+            } else {
+                final var position = effectPosition(appearance, geometry, entity, state.bodyRot, particle.locator());
+                particle.play(position, null);
+            }
+        }
+    }
