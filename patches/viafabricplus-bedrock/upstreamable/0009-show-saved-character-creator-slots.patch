+            }
+            request.xuid = xuid;
+        }
+        let count = acquire(request).await.unwrap();
+        assert!(count > 100);
+        eprintln!("Acquired {count} official persona files");
+    }
+    #[test]
+    fn selects_persona_actor_and_effect_library_files() {
