+                    assertEquals(-166.5F - 22.5F * Math.min(elapsed / 10F, 1), arm.x(), 0.0001F);
+                    assertEquals(0F, arm.y());
+                } else {
+                    final float startup = Math.min(elapsed / 8F, 1);
