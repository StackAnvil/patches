+        assertTrue(initial.extent(2, .5F).x > Math.hypot(2, .5F));
+        assertEquals(new Vector3f(1, 0, 0), initial.x());
+    }
+
+    private static JsonArray fixture(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE")).resolve(name)))
+                .getAsJsonObject().getAsJsonArray("cases");
+    }
+    private static BedrockParticleAttachment.Matrix matrix(final JsonArray array) {
+        final float[] values = new float[array.size()];
+        for (int index = 0; index < values.length; index++) values[index] = array.get(index).getAsFloat();
+        return new BedrockParticleAttachment.Matrix(values);
+    }
+    private static Vector3f vector(final JsonArray array) {
+        return new Vector3f(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+    private static void assertVector(final JsonArray expected, final Vector3f actual, final String context) {
+        for (int axis = 0; axis < 3; axis++) assertEquals(expected.get(axis).getAsFloat(), actual.get(axis), 1e-6F, context);
+    }
+}
