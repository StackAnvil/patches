+                }
+                this.outgoing.time += delta;
+                this.blendTime += delta;
+                final float oldWeight = curve(this.outgoing.definition.blend, this.blendTime);
+                if (oldWeight < Math.ulp(1F)) {
+                    final StatePlayback previous = this.outgoing;
+                    this.outgoing = null;
+                    this.blendTime = 0;
+                    this.current.apply(time, weight, queries, pose);
+                    previous.time = 0;
+                } else if (this.outgoing.definition.shortestPath) {
+                    final Map<String, BedrockBoneAnimation.Transform>
+                            before = new LinkedHashMap<>(),
+                            after = new LinkedHashMap<>();
+                    this.outgoing.apply(time, 1, queries, before);
+                    this.current.apply(time, 1, queries, after);
