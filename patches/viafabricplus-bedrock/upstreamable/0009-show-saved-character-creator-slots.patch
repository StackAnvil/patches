+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleFramesTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeBatchesRemovalAndChildrenAcrossManagerFrames() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-manager-update-result.json"))).getAsJsonObject();
+        int frames = 0;
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final List<Node> emitters = new ArrayList<>();
+            final Map<Integer, Node> nodes = new HashMap<>();
+            for (int id = 0; id < 3; id++) {
+                final Node node = new Node(id);
+                emitters.add(node);
+                nodes.put(id, node);
+            }
+            for (final var frame : row.getAsJsonArray("steps")) {
+                frames++;
+                final var step = frame.getAsJsonObject();
+                final List<Receipt> actual = new ArrayList<>();
+                // Native initialization and skip gates select whether a batch runs. This test compares batch semantics.
+                if (step.get("index").getAsInt() > 0 && !step.get("skip").getAsBoolean()) {
+                    final var batch = BedrockParticleFrames.batch(emitters, node -> {
+                        if (!node.alive) actual.add(new Receipt("destroyed", node.id));
+                        return node.alive;
+                    });
+                    for (final Node node : batch) {
+                        actual.add(new Receipt("update", node.id));
+                        node.updates++;
+                        if (node.id == row.get("spawner").getAsInt() && node.updates == 1) {
+                            for (int id = 10; id < 10 + row.get("children").getAsInt(); id++) {
+                                final Node child = new Node(id);
+                                emitters.add(child);
+                                nodes.put(id, child);
+                                actual.add(new Receipt("born", id));
+                            }
+                        }
+                        if (node.id == row.get("expires").getAsInt() && node.updates == 1) {
+                            node.alive = false;
+                            node.size = 0;
+                            actual.add(new Receipt("expired", node.id));
+                        }
+                    }
+                }
+                final List<Receipt> expected = new ArrayList<>();
+                for (final var receipt : step.getAsJsonArray("events")) {
+                    final var event = receipt.getAsJsonObject();
+                    for (final String kind : List.of("update", "born", "expired", "destroyed"))
+                        if (event.has(kind)) expected.add(new Receipt(kind, event.get(kind).getAsInt()));
+                }
+                assertEquals(expected, actual, step.toString());
+                assertEquals(step.getAsJsonArray("members").asList().stream().map(value -> value.getAsInt()).toList(),
+                        emitters.stream().map(node -> node.id).toList());
+                for (final var expectedSize : step.getAsJsonObject("sizes").entrySet())
+                    assertEquals(expectedSize.getValue().getAsInt(), nodes.get(Integer.parseInt(expectedSize.getKey())).size);
+                for (final var expectedUpdates : step.getAsJsonObject("updates").entrySet())
+                    assertEquals(expectedUpdates.getValue().getAsInt(), nodes.get(Integer.parseInt(expectedUpdates.getKey())).updates);
+            }
+        }
+        assertEquals(80, frames);
+    }
+
+    @Test
+    void retainsEmittersThatDieDuringTheirUpdateUntilTheNextBatch() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 0);
+        components.getAsJsonObject("minecraft:emitter_lifetime_once").addProperty("active_time", 0);
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var emitters = new ArrayList<>(List.of(emitter));
+        final var first = BedrockParticleFrames.batch(emitters, BedrockParticleEffect.Emitter::alive);
+        assertEquals(1, first.size());
+        emitter.advance(1, 0, null, (x, y, z) -> List.of());
+        assertFalse(emitter.alive());
+        assertEquals(1, emitters.size());
+        assertTrue(BedrockParticleFrames.batch(emitters, BedrockParticleEffect.Emitter::alive).isEmpty());
+        assertTrue(emitters.isEmpty());
+        assertEquals(1, first.size());
+    }
+
+    private record Receipt(String kind, int id) {}
+    private static final class Node {
+        final int id;
+        boolean alive = true;
+        int size = 1, updates;
+
+        Node(final int id) { this.id = id; }
+    }
+}
