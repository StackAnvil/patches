+    private void selectCategory(final Category category) {
+        if (this.category == category) {
+            return;
+        }
+        this.category = category;
+        this.limbSide = BedrockLimbSide.BOTH;
+        this.selectedItem = 0;
+        this.itemPage = 0;
+        this.items = null;
+        this.itemsFailed = false;
+        this.editFailed = false;
+        this.updateControls();
+        this.loadCategory();
+    }
