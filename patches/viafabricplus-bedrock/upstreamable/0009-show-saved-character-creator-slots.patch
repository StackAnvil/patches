+            value.add("uv", uv);
+            final var declared = BedrockParticleEffect.Billboard.read(value);
+            final var parsed = new BedrockParticleEffect.Billboard(declared.size(), declared.uv(), declared.uvSize(),
+                    declared.base(), declared.step(), declared.frames(), declared.inverseWidth(), declared.inverseHeight(),
+                    declared.fps(), declared.stretch(), declared.loop(), declared.flipbook(), declared.mode(),
+                    declared.customDirection(), declared.direction(),
+                    config.has("threshold") ? config.get("threshold").getAsFloat() : .01F);
+            final var velocity = config.has("velocity") ? vector(config,"velocity") : new Vector3f(2,-1,3);
+            final var previous = config.has("previous_direction") ? vector(config,"previous_direction") : new Vector3f(0,1,0);
+            final var view = parsed.sample(new BedrockMolang(), config.get("age").getAsFloat(), config.get("lifetime").getAsFloat(), velocity, previous);
+            final var size = expected.getAsJsonArray("size");
+            final var coords = expected.getAsJsonArray("uv");
+            assertEquals(size.get(0).getAsFloat(), view.width());
+            assertEquals(size.get(1).getAsFloat(), view.height());
+            assertEquals(coords.get(0).getAsFloat(), view.u0());
+            assertEquals(coords.get(1).getAsFloat(), view.v0());
+            assertEquals(coords.get(2).getAsFloat(), view.u1());
+            assertEquals(coords.get(3).getAsFloat(), view.v1());
+            compare(vector(expected,"direction"), previous);
+        }
+        assertEquals(492, cases.size());
+    }
+
+    private static void compare(final Vector3f expected, final Vector3f actual) {
+        for (int index = 0; index < 3; index++) assertEquals(expected.get(index), actual.get(index));
+    }
+    private static Vector3f vector(final JsonObject value, final String name) {
+        final var array = value.getAsJsonArray(name);
+        return new Vector3f(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+    private static JsonObject fixture(final String name) throws IOException {
+        return json(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE")).resolve(name)));
+    }
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+    private static JsonObject components(final JsonObject document) { return document.getAsJsonObject("particle_effect").getAsJsonObject("components"); }
+    static JsonObject burst() {
+        return json("""
+                {"particle_effect":{"description":{"identifier":"test:burst","basic_render_parameters":{
+                "material":"particles_blend","texture":"textures/particles/test"}},"components":{
+                "minecraft:emitter_lifetime_once":{"active_time":0.5},"minecraft:emitter_rate_instant":{"num_particles":2},
+                "minecraft:emitter_shape_point":{"direction":[0,1,0]},"minecraft:particle_initial_speed":0,
+                "minecraft:particle_lifetime_expression":{"max_lifetime":1},
+                "minecraft:particle_motion_dynamic":{},"minecraft:particle_appearance_billboard":{"size":[0.5,0.25]}}}}
+                """);
