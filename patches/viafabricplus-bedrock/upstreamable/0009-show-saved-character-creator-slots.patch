+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+
+import team.unnamed.mocha.MochaEngine;
+import team.unnamed.mocha.parser.ast.AccessExpression;
+import team.unnamed.mocha.parser.ast.ArrayAccessExpression;
+import team.unnamed.mocha.parser.ast.BinaryExpression;
+import team.unnamed.mocha.parser.ast.CallExpression;
+import team.unnamed.mocha.parser.ast.DoubleExpression;
+import team.unnamed.mocha.parser.ast.ExecutionScopeExpression;
+import team.unnamed.mocha.parser.ast.Expression;
+import team.unnamed.mocha.parser.ast.IdentifierExpression;
+import team.unnamed.mocha.parser.ast.StatementExpression;
+import team.unnamed.mocha.parser.ast.StringExpression;
+import team.unnamed.mocha.parser.ast.TernaryConditionalExpression;
+import team.unnamed.mocha.parser.ast.UnaryExpression;
+import team.unnamed.mocha.runtime.value.Function;
+import team.unnamed.mocha.runtime.value.NumberValue;
+import team.unnamed.mocha.runtime.value.ObjectProperty;
+import team.unnamed.mocha.runtime.value.ObjectValue;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** Actor-local variables and frame queries for parsed Molang expressions. */
+final class BedrockMolang {
+    private final MochaEngine<?> engine = MochaEngine.createStandard();
+    private Map<String, Float> queries = Map.of();
+    private float time, elapsed, delta;
+    private int iterations;
+
+    BedrockMolang() {
+        final ObjectValue query =
+                name ->
+                        ObjectProperty.property(
+                                NumberValue.of(
+                                        switch (name) {
+                                            case "anim_time" -> this.time;
+                                            case "life_time" ->
+                                                    this.queries.getOrDefault(name, this.elapsed);
+                                            case "delta_time" -> this.delta;
+                                            default -> this.queries.getOrDefault(name, 0F);
+                                        }),
+                                true);
+        this.engine.scope().set("query", query);
+        this.engine.scope().set("q", query);
+        this.engine
+                .scope()
+                .set(
+                        "stackanvil_iteration",
+                        (Function<Object>)
+                                (_, _) -> {
+                                    if (++this.iterations > 16384) throw new EvaluationLimit();
+                                    return NumberValue.zero();
+                                });
+    }
+
+    void queries(
+            final Map<String, Float> queries,
+            final float time,
+            final float elapsed,
+            final float delta) {
+        this.queries = queries;
+        this.time = time;
+        this.elapsed = elapsed;
+        this.delta = delta;
+    }
+
+    float evaluate(final Program program, final float current) {
+        if (program == null) return current;
+        if (program.expressions() == null) return program.constant();
+        this.engine.scope().set("this", NumberValue.of(current));
+        this.iterations = 0;
+        final double value;
+        try {
+            value = this.engine.eval(program.expressions());
+        } catch (EvaluationLimit e) {
+            return 0;
+        }
+        // Native Molang converts bad arithmetic results to zero.
+        return Double.isFinite(value) && Math.abs(value) <= 32768 ? (float) value : 0;
+    }
+
+    private static final class EvaluationLimit extends RuntimeException {}
+
+    record Program(float constant, List<Expression> expressions) {
+        static Program parse(final JsonElement json, final float fallback) throws IOException {
+            if (json == null) return new Program(fallback, null);
+            if (!json.isJsonPrimitive()) throw new IOException("Invalid animation expression");
+            if (json.getAsJsonPrimitive().isNumber()) {
+                final float value = json.getAsFloat();
+                if (!Float.isFinite(value) || Math.abs(value) > 32768)
+                    throw new IOException("Invalid animation value");
+                return new Program(value, null);
+            }
+            if (!json.getAsJsonPrimitive().isString() || json.getAsString().length() > 4096)
+                throw new IOException("Invalid animation expression");
+            try {
+                final List<Expression> expressions =
+                        MochaEngine.createStandard().parse(json.getAsString());
+                final Limits limits = new Limits();
+                final List<Expression> bounded = new ArrayList<>();
+                for (final Expression expression : expressions)
+                    bounded.add(limits.normalize(expression, 0));
+                return new Program(0, List.copyOf(bounded));
+            } catch (RuntimeException e) {
+                throw new IOException("Invalid Molang animation expression", e);
+            }
+        }
+    }
+
+    private static final class Limits {
+        private int nodes;
+
+        private static Expression boundedBody(final Expression expression) throws IOException {
+            if (!(expression instanceof ExecutionScopeExpression scope))
+                throw new IOException("Invalid Molang loop body");
+            final List<Expression> body = new ArrayList<>();
+            body.add(
+                    new CallExpression(
+                            new IdentifierExpression("stackanvil_iteration"), List.of()));
+            body.addAll(scope.expressions());
+            return new ExecutionScopeExpression(body);
+        }
+
+        Expression normalize(final Expression expression, final int depth) throws IOException {
+            if (++this.nodes > 512 || depth > 32)
+                throw new IOException("The animation expression is too complex");
+            return switch (expression) {
+                case DoubleExpression _,
+                        StringExpression _,
+                        IdentifierExpression _,
+                        StatementExpression _ ->
+                        expression;
+                case AccessExpression value ->
+                        new AccessExpression(
+                                this.normalize(value.object(), depth + 1), value.property());
+                case ArrayAccessExpression value ->
+                        new ArrayAccessExpression(
+                                this.normalize(value.array(), depth + 1),
+                                this.normalize(value.index(), depth + 1));
+                case BinaryExpression value ->
+                        new BinaryExpression(
+                                value.op(),
+                                this.normalize(value.left(), depth + 1),
+                                this.normalize(value.right(), depth + 1));
+                case UnaryExpression value ->
+                        new UnaryExpression(
+                                value.op(), this.normalize(value.expression(), depth + 1));
+                case TernaryConditionalExpression value ->
+                        new TernaryConditionalExpression(
+                                this.normalize(value.condition(), depth + 1),
+                                this.normalize(value.trueExpression(), depth + 1),
+                                this.normalize(value.falseExpression(), depth + 1));
+                case ExecutionScopeExpression value -> {
+                    final List<Expression> body = new ArrayList<>();
+                    for (final Expression child : value.expressions())
+                        body.add(this.normalize(child, depth + 1));
+                    yield new ExecutionScopeExpression(body);
+                }
+                case CallExpression value -> {
+                    final List<Expression> arguments = new ArrayList<>();
+                    for (final Expression argument : value.arguments())
+                        arguments.add(this.normalize(argument, depth + 1));
+                    Expression function = this.normalize(value.function(), depth + 1);
+                    if (function instanceof IdentifierExpression id
+                            && id.name().equalsIgnoreCase("loop")) {
+                        if (arguments.size() != 2)
+                            throw new IOException("Invalid Molang loop arguments");
+                        // Bedrock caps each loop at 1024 iterations. Mocha leaves this to its host.
+                        arguments.set(
+                                0,
+                                new CallExpression(
+                                        new AccessExpression(
+                                                new IdentifierExpression("math"), "floor"),
+                                        List.of(
+                                                new CallExpression(
+                                                        new AccessExpression(
+                                                                new IdentifierExpression("math"),
+                                                                "clamp"),
+                                                        List.of(
+                                                                arguments.getFirst(),
+                                                                DoubleExpression.ZERO,
+                                                                new DoubleExpression(1024))))));
+                        function = new IdentifierExpression("loop");
+                        arguments.set(1, boundedBody(arguments.get(1)));
+                    }
+                    if (function instanceof IdentifierExpression id
+                            && id.name().equalsIgnoreCase("for_each")) {
+                        if (arguments.size() != 3)
+                            throw new IOException("Invalid Molang for_each arguments");
+                        function = new IdentifierExpression("for_each");
+                        arguments.set(2, boundedBody(arguments.get(2)));
+                    }
+                    yield new CallExpression(function, arguments);
+                }
+                default -> throw new IOException("Unsupported Molang expression node");
+            };
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java
