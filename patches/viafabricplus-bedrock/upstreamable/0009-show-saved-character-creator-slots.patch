+        final int thumbnailSize = compact ? 32 : 80;
+        BedrockImageCache.drawRemote(graphics, item.thumbnailUrl(), detailLeft, top + (compact ? 32 : 44), thumbnailSize, thumbnailSize);
+        if (!compact) {
+            graphics.textWithWordWrap(this.font, Component.literal(item.type().replace("persona_", "").replace('_', ' ')),
+                detailLeft + 88, top + 44, Math.max(32, statusWidth - 88), ACCENT_COLOR);
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.selected", this.selectedSlot + 1),
+                detailLeft, top + 136, -1);
+        }
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        if (this.saving) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.saving_piece"),
+                statusLeft, statusTop, statusWidth, ACCENT_COLOR);
+        } else if (this.editFailed) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.edit_failed"),
+                statusLeft, statusTop, statusWidth, ACCENT_COLOR);
+        } else if (this.isEquippedHere(item, slot)) {
+            final Component status = this.category == Category.EMOTES
+                ? Component.translatable("bedrock_character_slots.viafabricplus.emote_equipped", this.selectedEmoteSlot + 1)
+                : Component.translatable("bedrock_character_slots.viafabricplus.equipped");
