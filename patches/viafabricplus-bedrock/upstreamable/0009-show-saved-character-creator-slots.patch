+            final var attachment = new BedrockParticleAttachment(new Vec3(position.x, position.y, position.z),
+                    config.get("yaw").getAsFloat(), config.get("locator_found").getAsBoolean()
+                    ? new Matrix4f().set(values(config.getAsJsonArray("locator_matrix"))) : null, null);
