+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.regex.Pattern;
+
+/** Compiles visibility rules once, with a separate match for normalized humanoid bone names. */
+public final class BedrockBonePattern {
+    private final Pattern exact;
+    private final Pattern humanoid;
+
+    public BedrockBonePattern(final Pattern exact) {
+        this.exact = exact;
+        this.humanoid = Pattern.compile(exact.pattern(), exact.flags() | Pattern.CASE_INSENSITIVE);
+    }
+
+    public static BedrockBonePattern wildcard(final String pattern) {
+        return new BedrockBonePattern(Pattern.compile(Pattern.quote(pattern).replace("*", "\\E.*\\Q")));
+    }
+
+    public Pattern exact() {
+        return this.exact;
+    }
+
+    public boolean matches(final String bone, final boolean humanoidNames) {
+        return (humanoidNames ? this.humanoid : this.exact).matcher(bone).matches();
+    }
+}
