+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.util.Comparator;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.IntUnaryOperator;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import java.util.zip.ZipOutputStream;
+
+/** Obtains the versioned built-in persona pack through the selected account's Store license. */
+final class BedrockBuiltinAssets {
+    static final int MAX_FILE_BYTES = 32 * 1024 * 1024;
+    static final int MAX_TOTAL_BYTES = 256 * 1024 * 1024;
+    private static final int MAX_LOGICAL_FILES = 32768;
+    private static final int CACHE_FORMAT = 10;
+    private static final String PACK_ID = "2099de18-429a-465a-a49b-fc4710a17bb3";
+    private static final Map<String, Contents> LOADED = new java.util.concurrent.ConcurrentHashMap<>();
+
+    private BedrockBuiltinAssets() {}
+
+    static synchronized Contents load(final BedrockAuthManager account) throws Exception {
+        final String accountId = BedrockAppearanceStore.accountId(account);
+        if ("offline".equals(accountId))
+            throw new IOException("Sign in to a Bedrock account to download built-in assets");
+        final JsonObject build =
+                json(resource("/assets/viafabricplus-bedrock/persona-package.json"));
+        if (!ProtocolConstants.BEDROCK_VERSION_NAME.equals(
+                build.get("protocolVersion").getAsString()))
+            throw new IOException("No official persona package is pinned for this Bedrock version");
+        final String version = build.get("version").getAsString();
+        final String identity = build.get("headerSha256").getAsString();
+        final String key = accountId + "/" + version + "/" + identity;
+        if (LOADED.containsKey(key)) return LOADED.get(key);
+        final Path root = ViaFabricPlus.api().path().resolve("bedrock-assets");
+        final Path cache = root.resolve("persona").resolve(accountId).resolve(version + ".zip");
+        final Contents contents =
+                cached(
+                        cache,
+                        version,
+                        identity,
+                        staging -> acquire(root, staging, account, accountId, build));
+        LOADED.put(key, contents);
+        return contents;
+    }
+
+    static Contents loaded(final BedrockAuthManager account) throws IOException {
+        if (account == null) return null;
+        final JsonObject build = json(resource("/assets/viafabricplus-bedrock/persona-package.json"));
+        return LOADED.get(BedrockAppearanceStore.accountId(account) + "/" + build.get("version").getAsString()
+                + "/" + build.get("headerSha256").getAsString());
+    }
+
+    @FunctionalInterface
+    interface Acquisition {
+        void download(Path staging) throws Exception;
+    }
+
+    static Contents cached(
+            final Path cache,
+            final String version,
+            final String identity,
+            final Acquisition acquisition)
+            throws Exception {
+        if (Files.isRegularFile(cache, LinkOption.NOFOLLOW_LINKS)) {
+            try {
+                return readCache(cache, version, identity);
+            } catch (IOException | RuntimeException invalid) {
+                /* Replace a damaged or obsolete cache atomically. */
+            }
+        }
+        Files.createDirectories(cache.getParent());
+        final Path staging = Files.createTempDirectory(cache.getParent(), ".persona-");
+        final Path zip = staging.resolve("cache.zip");
+        try {
+            final Path raw = staging.resolve("raw");
+            Files.createDirectory(raw);
+            acquisition.download(raw);
+            final Map<String, byte[]> files = unpack(raw);
+            requireLibrary(files, version);
+            final Contents contents = index(version, files);
+            writeCache(zip, version, identity, files);
+            // Re-read the saved representation before publishing it.
+            readCache(zip, version, identity);
+            Files.move(
+                    zip,
+                    cache,
+                    StandardCopyOption.ATOMIC_MOVE,
+                    StandardCopyOption.REPLACE_EXISTING);
+            return contents;
+        } finally {
+            try (var paths = Files.walk(staging)) {
+                for (final Path path : paths.sorted(Comparator.reverseOrder()).toList())
+                    Files.deleteIfExists(path);
+            }
+        }
+    }
+
+    static Map<String, byte[]> unpack(final Path raw) throws IOException {
+        return unpack(raw, MAX_TOTAL_BYTES);
+    }
+
+    static Map<String, byte[]> unpack(final Path raw, final long maximumBytes) throws IOException {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        final Map<String, byte[]> archives = new LinkedHashMap<>();
+        long inputBytes = 0;
+        long expandedBytes = 0;
+        try (var paths = Files.walk(raw)) {
+            for (final Path path : paths.sorted().toList()) {
+                if (Files.isSymbolicLink(path))
+                    throw new IOException("Persona assets contain a symbolic link");
+                if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) continue;
+                final String name = raw.relativize(path).toString().replace('\\', '/');
+                validPath(name);
+                final long size = Files.size(path);
+                if (size > MAX_FILE_BYTES || (inputBytes += size) > maximumBytes)
+                    throw new IOException("Persona assets exceed the size limit");
+                final byte[] bytes = Files.readAllBytes(path);
+                final String[] parts = name.split("/", 3);
+                final boolean libraryArchive =
+                        parts.length == 3
+                                && parts[0].equals("library")
+                                && BedrockResourceLibrary.packName(parts[1])
+                                && parts[2].startsWith("__brarchive/");
+                if ((name.startsWith("__brarchive/") || libraryArchive)
+                        && name.endsWith(".brarchive")) archives.put(name, bytes);
+                else {
+                    files.put(name, bytes);
+                    expandedBytes += size;
+                }
+                if (files.size() + archives.size() > 8192)
+                    throw new IOException("Too many persona files");
+            }
+        }
+        for (final var archive : archives.entrySet()) {
+            final String name = archive.getKey();
+            final int marker = name.indexOf("__brarchive/");
+            final String prefix =
+                    name.substring(0, marker)
+                            + name.substring(
+                                    marker + "__brarchive/".length(),
+                                    name.length() - ".brarchive".length())
+                            + "/";
+            for (final var entry : BedrockBrArchive.read(archive.getValue()).entrySet()) {
+                if ((expandedBytes += entry.getValue().length) > maximumBytes
+                        || files.size() >= MAX_LOGICAL_FILES)
+                    throw new IOException("Unpacked persona assets exceed the size limit");
+                // Empty archive stubs leave the separately supplied loose file intact.
+                if (files.putIfAbsent(prefix + entry.getKey(), entry.getValue()) != null)
+                    throw new IOException("Persona archive conflicts with a loose file");
+            }
+        }
+        return Map.copyOf(files);
+    }
+
+    static Contents index(final String version, final Map<String, byte[]> files)
+            throws IOException {
+        try {
+            final JsonObject manifest = json(files.get("manifest.json"));
+            if (!PACK_ID.equals(manifest.getAsJsonObject("header").get("uuid").getAsString()))
+                throw new IOException("The package has a different persona pack");
+            final Map<UUID, BedrockMarketplaceAssets.Pack> pieces = new LinkedHashMap<>();
+            for (final var entry : files.entrySet()) {
+                if (entry.getKey().startsWith("library/")
+                        || !entry.getKey().endsWith(".meta.json")
+                        || entry.getValue().length == 0) continue;
+                final JsonObject metadata = json(entry.getValue());
+                if (!metadata.has("piece_id")) continue;
+                final UUID id = UUID.fromString(metadata.get("piece_id").getAsString());
+                final String prefix =
+                        entry.getKey().substring(0, entry.getKey().lastIndexOf('/') + 1);
+                final Map<String, byte[]> local = new LinkedHashMap<>();
+                files.forEach(
+                        (name, bytes) -> {
+                            if (name.startsWith(prefix))
+                                local.put(name.substring(prefix.length()), bytes);
+                        });
+                if (pieces.putIfAbsent(
+                                id, new BedrockMarketplaceAssets.Pack(id.toString(), Map.copyOf(local)))
+                        != null) throw new IOException("Duplicate built-in persona piece");
+            }
+            if (pieces.isEmpty())
+                throw new IOException("The package has no built-in persona pieces");
+            long pixels = 0;
+            for (final var piece : pieces.entrySet()) {
+                final var textures = BedrockPersonaSources.read(piece.getValue());
+                for (final var texture : textures) {
+                    pixels +=
+                            (long) texture.image().getWidth()
+                                    * texture.image().getHeight()
+                                    * (texture.tintMap() == null ? 1 : 2);
+                    if (pixels > 16 * 1024 * 1024)
+                        throw new IOException("Decoded persona textures exceed the size limit");
+                }
+            }
+            return new Contents(
+                    version,
+                    Map.copyOf(files),
+                    Map.copyOf(pieces),
+                    BedrockResourceLibrary.read(files));
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid built-in persona metadata", e);
+        }
+    }
+
+    private static void acquire(
+            final Path root, final Path output, final BedrockAuthManager account, final String accountId, final JsonObject build)
+            throws Exception {
+        final JsonObject request = new JsonObject();
+        request.addProperty("url", build.get("url").getAsString());
+        request.addProperty("headerSha256", build.get("headerSha256").getAsString());
+        request.addProperty("packageVersion", build.get("packageVersion").getAsString());
+        request.addProperty("xuid", accountId);
+        request.addProperty("state", root.resolve("store").toAbsolutePath().toString());
+        request.addProperty("output", output.toAbsolutePath().toString());
+        BedrockStoreSignIn.INSTANCE.acquire(accountId,
+                ViaFabricPlusBedrock.impl().settings().storeSignIn().value(),
+                () -> {
+                    final Path helper = BedrockPackageHelper.install(root.resolve("helpers"));
+                    try {
+                        BedrockPackageHelper.acquire(helper, request);
+                    } catch (BedrockPackageHelper.StoreSignInRequiredException missing) {
+                        try {
+                            request.add("storeAuth", BedrockStoreTokens.acquire(account));
+                        } catch (InterruptedException interrupted) {
+                            throw interrupted;
+                        } catch (Exception unavailable) {
+                            throw missing;
+                        }
+                        BedrockPackageHelper.acquire(helper, request);
+                    }
+                },
+                () -> {
+                    final var msa = BedrockStoreBrowser.signIn(account);
+                    request.add("storeAuth", BedrockStoreTokens.acquire(account.getMsaApplicationConfig(), msa));
+                    BedrockPackageHelper.acquire(BedrockPackageHelper.install(root.resolve("helpers")), request);
+                    // The helper verified this ticket against the selected XUID before extraction.
+                    account.getMsaToken().set(msa);
+                });
+    }
+
+    private static void writeCache(
+            final Path target,
+            final String version,
+            final String identity,
+            final Map<String, byte[]> files)
+            throws Exception {
+        final JsonObject metadata = new JsonObject(), hashes = new JsonObject();
+        metadata.addProperty("format", CACHE_FORMAT);
+        metadata.addProperty("version", version);
+        metadata.addProperty("package", identity);
+        try (var zip = new ZipOutputStream(Files.newOutputStream(target))) {
+            for (final var entry :
+                    files.entrySet().stream().sorted(Map.Entry.comparingByKey()).toList()) {
+                zip.putNextEntry(new ZipEntry(entry.getKey()));
+                zip.write(entry.getValue());
+                zip.closeEntry();
+                hashes.addProperty(entry.getKey(), hash(entry.getValue()));
+            }
+            metadata.add("files", hashes);
+            zip.putNextEntry(new ZipEntry(".asset-cache.json"));
+            zip.write(metadata.toString().getBytes(StandardCharsets.UTF_8));
+            zip.closeEntry();
+        }
+    }
+
+    private static Contents readCache(final Path cache, final String version, final String identity)
+            throws IOException {
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        long total = 0;
+        try (var zip = new ZipInputStream(Files.newInputStream(cache))) {
+            for (ZipEntry entry; (entry = zip.getNextEntry()) != null; ) {
+                validPath(entry.getName());
+                if (entry.isDirectory() || files.size() >= MAX_LOGICAL_FILES + 1)
+                    throw new IOException("Invalid persona cache entry");
+                final byte[] bytes = zip.readNBytes(MAX_FILE_BYTES + 1);
+                if (bytes.length > MAX_FILE_BYTES
+                        || (total += bytes.length) > MAX_TOTAL_BYTES
+                        || files.putIfAbsent(entry.getName(), bytes) != null)
+                    throw new IOException("Invalid persona cache size or duplicate entry");
+            }
+        }
+        try {
+            final JsonObject metadata = json(files.remove(".asset-cache.json"));
+            if (metadata.get("format").getAsInt() != CACHE_FORMAT
+                    || !version.equals(metadata.get("version").getAsString())
+                    || !identity.equals(metadata.get("package").getAsString()))
+                throw new IOException("The persona cache belongs to a different package");
+            final JsonObject hashes = metadata.getAsJsonObject("files");
+            if (hashes.size() != files.size())
+                throw new IOException("The persona cache is incomplete");
+            for (final var entry : files.entrySet()) {
+                if (!hashes.has(entry.getKey())
+                        || !hash(entry.getValue()).equals(hashes.get(entry.getKey()).getAsString()))
+                    throw new IOException("Persona cache checksum mismatch");
+            }
+            requireLibrary(files, version);
+            return index(version, files);
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid persona cache metadata", e);
+        }
+    }
+
+    private static void requireLibrary(final Map<String, byte[]> files, final String version)
+            throws IOException {
+        final String[] parts = version.split("\\.");
+        if (parts.length != 4
+                || !BedrockResourceLibrary.packName(
+                        "vanilla_" + String.join(".", java.util.Arrays.copyOf(parts, 3))))
+            throw new IOException("Invalid persona package version");
+        final BedrockResourceLibrary library = BedrockResourceLibrary.read(files);
+        final String latest = "vanilla_" + String.join(".", java.util.Arrays.copyOf(parts, 3));
+        if (!library.packNames().containsAll(List.of("vanilla", "vanilla_base", latest)))
+            throw new IOException("The cache is missing the versioned vanilla resource stack");
+        for (final String pack : library.packNames()) {
+            final JsonObject manifest = json(files.get("library/" + pack + "/manifest.json"));
+            final JsonObject header = manifest.getAsJsonObject("header");
+            final String expected =
+                    pack.equals("vanilla_base")
+                            ? "9ae3d2cc-7811-404c-b578-cb27689c8ac5"
+                            : "0575c61f-a5da-4b7f-9961-ffda2908861e";
+            if (!expected.equals(header.get("uuid").getAsString()))
+                throw new IOException("The package has a different vanilla resource pack");
+            if (!pack.equals("vanilla") && !pack.equals("vanilla_base")) {
+                final String[] packVersion = pack.substring("vanilla_".length()).split("\\.");
+                final var declared = header.getAsJsonArray("version");
+                if (declared.size() != 3) throw new IOException("Invalid vanilla overlay version");
+                for (int part = 0; part < 3; part++)
+                    if (declared.get(part).getAsInt()
+                            != (part < packVersion.length
+                                    ? Integer.parseInt(packVersion[part])
+                                    : 0))
+                        throw new IOException(
+                                "The vanilla overlay version does not match its directory");
+            }
+        }
+        for (final String path : List.of(
+                "models/mobs.json", "entity/player.entity.json", "animations/player.animation.json",
+                "animation_controllers/player.animation_controllers.json",
+                "render_controllers/player.render_controllers.json",
+                "sounds/sound_definitions.json", "sounds.json", "texts/en_US.lang")) {
+            final byte[] bytes = files.get("library/vanilla/" + path);
+            if (bytes == null || bytes.length == 0)
+                throw new IOException("The cache is missing a required player resource: " + path);
+        }
+        if (!hasResource(files, "sounds/", ".fsb", ".ogg", ".wav")
+                || !hasResource(files, "particles/", ".json")
+                || !hasResource(files, "textures/particle/", ".png", ".tga"))
+            throw new IOException("The cache is missing the animation effect library");
+        if (!hasResource(files, "textures/items/", ".png", ".jpg", ".tga"))
+            throw new IOException("The cache is missing the vanilla image library");
+    }
+
+    private static boolean hasResource(
+            final Map<String, byte[]> files, final String directory, final String... extensions) {
+        return files.entrySet().stream()
+                .anyMatch(
+                        entry ->
+                                entry.getValue().length > 0
+                                        && entry.getKey().startsWith("library/vanilla/" + directory)
+                                        && java.util.Arrays.stream(extensions)
+                                                .anyMatch(entry.getKey()::endsWith));
+    }
+
+    static void validPath(final String name) throws IOException {
+        if (name.isEmpty()
+                || name.startsWith("/")
+                || name.contains("\\")
+                || name.contains(":")
+                || name.contains("\0")
+                || java.util.Arrays.stream(name.split("/", -1))
+                        .anyMatch(part -> part.isEmpty() || part.equals(".") || part.equals("..")))
+            throw new IOException("Invalid persona asset path");
+    }
+
+    static String hash(final byte[] bytes) {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+        } catch (java.security.NoSuchAlgorithmException impossible) {
+            throw new AssertionError(impossible);
+        }
+    }
+
+    static byte[] resource(final String name) throws IOException {
+        try (InputStream input = BedrockBuiltinAssets.class.getResourceAsStream(name)) {
+            if (input == null) throw new IOException("The add-on does not include " + name);
+            return input.readAllBytes();
+        }
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("Missing or oversized persona metadata");
+        return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)).getAsJsonObject();
+    }
+
+    record Contents(
+            String version,
+            Map<String, byte[]> files,
+            Map<UUID, BedrockMarketplaceAssets.Pack> pieces,
+            BedrockResourceLibrary library) {
+        JsonObject model(final String identifier) throws IOException {
+            return library.model(identifier);
+        }
+
+        BedrockSoundBank.Audio sound(final String path) throws IOException {
+            return BedrockSoundFile.read(library.sound(path));
+        }
+
+        ResolvedSound soundEvent(
+                final String name,
+                final IntUnaryOperator random,
+                final float volume,
+                final float pitch,
+                final boolean forceNonpositional) throws IOException {
+            return library.soundEvent(name, random, volume, pitch, forceNonpositional);
+        }
+
+        record ResolvedSound(
+                BedrockSoundEvent event,
+                BedrockSoundEvent.Selection selection,
+                BedrockSoundBank.Audio audio) {}
+
+        JsonObject particle(final String path) throws IOException {
+            validPath(path);
+            if (!path.startsWith("particles/") || !path.endsWith(".json"))
+                throw new IOException("Invalid built-in particle path");
+            return BedrockParticleDefinition.read(library.file(path));
+        }
+
+        BedrockMarketplaceAssets.Pack piece(final String id) throws IOException {
+            try {
+                final var piece = pieces.get(UUID.fromString(id));
+                if (piece == null)
+                    throw new IOException(
+                            "The built-in persona piece is missing from this game version");
+                return piece;
+            } catch (IllegalArgumentException invalid) {
+                throw new IOException("Invalid built-in persona identity", invalid);
+            }
+        }
+    }
+}
