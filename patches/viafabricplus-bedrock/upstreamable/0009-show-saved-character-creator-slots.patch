+            assertEquals(
+                    row.get("startup").getAsFloat(),
+                    variables.get("use_item_startup_progress"),
+                    row.toString());
+            assertEquals(
+                    row.get("interval").getAsFloat(),
+                    variables.get("use_item_interval_progress"),
