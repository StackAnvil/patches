+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorRenderSelectionTest {
+    @Test
+    void selectsAllSurfacesAfterAnimationAndScaleInAnIndependentPerspective() throws Exception {
+        final var definition = JsonParser.parseString("""
+                {"minecraft:client_entity":{"description":{"identifier":"minecraft:player",
+                 "animations":{"pose":"controller.pose"},
+                 "scripts":{"initialize":["v.counter=0;"],
+                 "pre_animation":["v.counter=v.counter+1;v.view=c.is_first_person;"],
+                 "scale":"v.counter=v.counter+10;return 0.9375;","animate":["pose"]}}}}
+                """).getAsJsonObject();
+        final var controllers = JsonParser.parseString("""
+                {"animation_controllers":{"controller.pose":{"states":{"default":{
+                 "on_entry":["v.pick=1;"]}}}}}
+                """).getAsJsonObject();
+        final var graph = BedrockActorAnimation.read(BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/entity/player.entity.json", definition.toString().getBytes(StandardCharsets.UTF_8),
+                "library/vanilla/animation_controllers/pose.json", controllers.toString().getBytes(StandardCharsets.UTF_8))), BedrockClassicOptions.EMPTY);
+        final var entity = new BedrockEntityData("minecraft:player",
+                new BedrockEntityData.Scripts(List.of("v.counter=999;"), List.of("v.pick=0;"),
+                        new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of()),
+                List.of(new BedrockEntityData.RenderController("controller.hands", "v.view && v.counter==11"),
+                        new BedrockEntityData.RenderController("controller.body", "!v.view")),
+                Map.of("default", "entity_alphatest"), Map.of(), Map.of("default", "textures/entity/steve"),
+                Map.of("default", "geometry.humanoid.custom", "hands", "geometry.hands"));
+        final var handsController = new BedrockRenderController("controller.hands", Map.of("*", "Material.default"),
+                "Array.models[v.pick]", List.of("Texture.default", "Texture.default"), List.of(), List.of(),
+                List.of(new BedrockRenderController.Array("Array.models", List.of("Geometry.default", "Geometry.hands"))),
+                true, "v.counter/11", new BedrockRenderController.UvAnimation("v.pick/4", "0", "0.5", "1"),
+                List.of(new BedrockRenderController.BoneVisibility("*", "0"), new BedrockRenderController.BoneVisibility("right*", "v.view")));
+        final var bodyController = new BedrockRenderController("controller.body", Map.of("*", "Material.default"),
+                "Geometry.default", List.of("Texture.default"), List.of(), List.of(), List.of(), false, "1", BedrockRenderController.UvAnimation.IDENTITY);
+        final var selection = new BedrockPlayerControllers(entity, Map.of("controller.hands", handsController, "controller.body", bodyController));
+        final var body = graph.playback();
+        final var hands = body.fork();
+        body.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 0)));
+        hands.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 1)));
+        hands.scale();
+        final var draws = hands.renderControllers(selection);
+        assertFalse(draws.bodyVisible());
+        assertEquals(2, draws.surfaces().size());
+        final var surface = draws.surfaces().getFirst();
+        assertEquals("geometry.hands", surface.geometry());
+        assertTrue(surface.ignoreLighting());
+        assertEquals(1F, surface.lightMultiplier());
+        assertEquals(new BedrockPlayerControllers.Uv(.25F, 0, .5F, 1), surface.uv());
+        assertTrue(surface.visibility().get(1).visible());
+        assertTrue(surface.visibility().get(1).matches("rightArm"));
+        assertEquals(draws, hands.renderControllers(selection));
+        final var original = body.renderControllers(selection);
+        assertTrue(original.bodyVisible());
+        assertEquals(1, original.surfaces().size());
+        assertTrue(original.surfaces().getFirst().nativeBody());
+        assertEquals(draws, hands.renderControllers(selection));
+    }
+}
