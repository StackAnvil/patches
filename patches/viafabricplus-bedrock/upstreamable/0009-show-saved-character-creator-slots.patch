+            final var config = result.getAsJsonObject("config");
+            final var lengths = config.getAsJsonArray("lengths");
+            final JsonObject entity =
+                    json(
+                            "{\"animations\":{\"root\":\"controller.animation.root\"},\"scripts\":{\"animate\":[{\"root\":\"q.weight\"}]}}");
+            final JsonObject animations = new JsonObject(), states = new JsonObject();
+            for (int index = 0; index < lengths.size(); index++) {
+                entity.getAsJsonObject("animations")
+                        .addProperty("a" + index, "animation.a" + index);
+                animations.add(
+                        "animation.a" + index,
+                        json(
+                                "{\"animation_length\":"
+                                        + lengths.get(index)
+                                        + ",\"loop\":\"hold_on_last_frame\",\"bones\":{\"bone"
+                                        + index
+                                        + "\":{\"rotation\":[\"q.state_time\",0,0],\"position\":[1,\"q.anim_time\",0]}}}"));
+            }
+            for (int index = 0; index < 2; index++) {
+                final JsonObject state = new JsonObject();
+                final JsonArray refs = new JsonArray();
+                for (final var child :
+                        config.getAsJsonArray("children").get(index).getAsJsonArray())
+                    refs.add("a" + child.getAsInt());
+                state.add("animations", refs);
+                if (index == 0) {
+                    state.add(
+                            "transitions",
+                            json("{\"values\":[{\"next\":\""
+                                            + (name.startsWith("blend") || name.equals("time")
+                                                    ? "q.state_time>=0.5"
+                                                    : name.equals("any")
+                                                            ? "q.any_animation_finished"
+                                                            : "q.all_animations_finished")
+                                            + "\"}]}")
+                                    .get("values"));
+                    if (config.has("curve")) state.addProperty("blend_transition", 1);
+                }
+                states.add(index == 0 ? "default" : "next", state);
+            }
+            final JsonObject controller = new JsonObject(), definition = new JsonObject();
+            definition.add("states", states);
+            controller.add("controller.animation.root", definition);
+            final var actor =
+                    BedrockActorAnimation.read(entity, Map.of(), animations, controller, "1.18.10")
+                            .playback();
+            float time = 0;
+            for (final var element : result.getAsJsonArray("steps")) {
+                final var step = element.getAsJsonObject();
+                time += step.get("delta").getAsFloat();
+                final var pose =
+                        actor.sample(
+                                time,
+                                new BedrockActorAnimation.Frame(
+                                        Map.of("weight", step.get("weight").getAsFloat()),
+                                        Map.of()));
+                assertEquals(
+                        step.getAsJsonArray("updates").size(), pose.size(), name + " at " + time);
+                for (final var update : step.getAsJsonArray("updates")) {
+                    final var child = update.getAsJsonObject();
+                    final int index = child.get("child").getAsInt();
+                    final float weight = child.get("weight").getAsFloat();
+                    final var transform = pose.get("bone" + index);
+                    assertEquals(weight, transform.position().x(), 1E-5, name);
+                    assertEquals(
+                            weight
+                                    * Math.min(
+                                            lengths.get(index).getAsFloat(),
+                                            child.get("clock").getAsFloat()),
+                            transform.position().y(),
+                            1E-5,
+                            name);
+                    assertEquals(
+                            weight * child.get("state_time").getAsFloat(),
+                            transform.rotation().x(),
+                            1E-5,
+                            name);
+                }
+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_SHORTEST_RESULT", matches = ".+")
+    void matchesIndependentNativeShortestPathComposition() throws IOException {
+        for (final var element :
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(
+                                                System.getenv(
+                                                        "STACKANVIL_ANIMATION_SHORTEST_RESULT"))))
+                        .getAsJsonArray()) {
+            final var entry = element.getAsJsonObject();
+            final Map<String, BedrockBoneAnimation.Transform> pose = new LinkedHashMap<>();
+            pose.put(
+                    "head",
+                    transform(
+                            new float[] {2, 0, 0}, new float[] {10, 0, 0}, new float[] {2, 1, 1}));
+            BedrockBoneAnimation.blendStates(
+                    pose,
+                    Map.of(
+                            "head",
+                            transform(
+                                    new float[] {1, 2, 3},
+                                    vector(entry.getAsJsonArray("before")),
+                                    new float[] {2, 3, 4})),
+                    Map.of(
+                            "head",
+                            transform(
+                                    new float[] {5, 6, 7},
+                                    vector(entry.getAsJsonArray("after")),
+                                    new float[] {4, 5, 6})),
+                    entry.get("weight").getAsFloat());
+            assertEquals(
+                    transform(
+                            vector(entry.getAsJsonArray("position")),
+                            vector(entry.getAsJsonArray("rotation")),
+                            vector(entry.getAsJsonArray("scale"))),
+                    pose.get("head"));
+        }
+    }
+
+    private static float[] vector(final JsonArray array) {
+        return new float[] {
+            array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat()
+        };
+    }
+
+    private static BedrockBoneAnimation.Transform transform(
+            final float[] position, final float[] rotation, final float[] scale) {
+        return new BedrockBoneAnimation.Transform(
+                new BedrockBoneAnimation.Vector(position[0], position[1], position[2]),
+                new BedrockBoneAnimation.Vector(rotation[0], rotation[1], rotation[2]),
+                new BedrockBoneAnimation.Vector(scale[0], scale[1], scale[2]),
+                false);
+    }
+}
