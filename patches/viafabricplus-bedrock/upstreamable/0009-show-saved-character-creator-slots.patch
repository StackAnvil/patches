+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_QUERIES", matches = ".+")
+    void matchesIndependentNativeDurationAndChargedQueries() throws Exception {
+        final var fixture =
+                JsonParser.parseString(
+                                Files.readString(Path.of(System.getenv("STACKANVIL_ITEM_QUERIES"))))
+                        .getAsJsonObject();
+        for (final var raw : fixture.getAsJsonArray("remaining")) {
+            final var row = raw.getAsJsonObject();
+            if (row.get("legacy").getAsBoolean()) continue;
+            final var main =
+                    row.get("main_empty").getAsBoolean()
+                            ? BedrockItemAnimation.Item.EMPTY
+                            : new BedrockItemAnimation.Item(
+                                    "crossbow", row.get("main_max").getAsInt(), false);
+            final var off =
+                    new BedrockItemAnimation.Item("bow", row.get("off_max").getAsInt(), false);
+            final var items =
+                    new BedrockItemAnimation(main, off, main, off, row.get("remaining").getAsInt());
+            assertEquals(
+                    row.get("value").getAsFloat(),
+                    ((Number)
+                                    query(
+                                            items.queries(),
+                                            "item_remaining_use_duration",
+                                            arguments(row.get("args"))))
+                            .floatValue(),
+                    row.toString());
+        }
+        for (final var raw : fixture.getAsJsonArray("charged")) {
+            final var row = raw.getAsJsonObject();
+            final var main =
+                    new BedrockItemAnimation.Item("crossbow", 25, row.get("main").getAsBoolean());
+            final var off =
+                    new BedrockItemAnimation.Item("crossbow", 25, row.get("off").getAsBoolean());
+            final var items = new BedrockItemAnimation(main, off, main, off, 0);
+            assertEquals(
+                    row.get("value").getAsFloat() != 0,
+                    query(items.queries(), "item_is_charged", arguments(row.get("args"))),
+                    row.toString());
+        }
+        for (final var raw : fixture.getAsJsonArray("main")) {
+            final var row = raw.getAsJsonObject();
+            final var main =
+                    row.get("empty").getAsBoolean()
+                            ? BedrockItemAnimation.Item.EMPTY
+                            : new BedrockItemAnimation.Item("crossbow", 25, false);
+            final var items =
+                    new BedrockItemAnimation(
+                            main,
+                            BedrockItemAnimation.Item.EMPTY,
+                            main,
+                            BedrockItemAnimation.Item.EMPTY,
+                            row.get("remaining").getAsInt());
+            assertEquals(
+                    row.get("max").getAsFloat(),
+                    ((Number) query(items.queries(), "main_hand_item_max_duration", List.of()))
+                            .floatValue());
+            assertEquals(
+                    row.get("use").getAsFloat(),
+                    ((Number) query(items.queries(), "main_hand_item_use_duration", List.of()))
+                            .floatValue());
+        }
+    }
+
+    private static List<Object> arguments(final JsonElement value) {
+        final List<Object> arguments = new ArrayList<>();
+        for (final var item : value.getAsJsonArray())
+            arguments.add(
+                    item.getAsJsonPrimitive().isString() ? item.getAsString() : item.getAsDouble());
+        return List.copyOf(arguments);
+    }
+}
