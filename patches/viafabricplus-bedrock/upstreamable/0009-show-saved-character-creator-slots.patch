+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static com.viaversion.viafabricplus.bedrock.appearance.BedrockParticleDefinition.*;
+
+import static java.util.Map.entry;
+
+import java.util.Map;
+
+/** Binary field layouts verified against the Bedrock 1.26.51.1 particle library. */
+final class BedrockParticleLayouts {
+    private BedrockParticleLayouts() {}
+
+    static Map<String, Layout> definitions() {
+        return Map.ofEntries(
+                entry(
+                        "Color Proxy",
+                        object(
+                                field("gradient", ref("particle_appearance_tinting gradient")),
+                                field("interpolant", ref("Expression Node")))),
+                entry(
+                        "DirectionSettings Proxy",
+                        object(
+                                field(
+                                        "mode",
+                                        ref(
+                                                "particle_appearance_billboard"
+                                                    + " direction_settings_mode")),
+                                optional("custom_direction", array(ref("Expression Node"), 3)),
+                                field("min_speed_threshold", FLOAT))),
+                entry(
+                        "Expression Node",
+                        variant(choice(0, ref("Molang string")), choice(1, FLOAT))),
+                entry("FileReference 21", TEXT),
+                entry("Molang string", TEXT),
+                entry(
+                        "Particle Effect Data",
+                        object(
+                                field("description", ref("particle_effect description")),
+                                field("components", ref("particle_effect component")),
+                                optional("curves", map(ref("particle_curve"))),
+                                optional("events", map(ref("particle_event_node"))))),
+                entry(
+                        "ParticleLifetimeEvents Proxy",
+                        object(
+                                field("creation_event", ref("VectorEvents")),
+                                field("expiration_event", ref("VectorEvents")),
+                                optional("timeline", map(ref("VectorEvents"))))),
+                entry("Reference 0", TEXT),
+                entry(
+                        "UV Proxy",
+                        object(
+                                field("texture_width", INT),
+                                field("texture_height", INT),
+                                optional("uv", array(ref("Expression Node"), 2)),
+                                optional("uv_size", array(ref("Expression Node"), 2)),
+                                optional(
+                                        "flipbook",
+                                        ref("particle_appearance_billboard flipbook_data")))),
+                entry("VectorEvents", array(ref("hashed_string"), -1)),
+                entry("color_expr", array(ref("Expression Node"), 4)),
+                entry("direction_type", text("inwards", "outwards")),
+                entry(
+                        "emitter_initialization",
+                        object(
+                                field("creation_expression", ref("Expression Node")),
+                                field("per_update_expression", ref("Expression Node")))),
+                entry("emitter_lifetime_events", ref("emitter_lifetime_events proxy")),
+                entry(
+                        "emitter_lifetime_events proxy",
+                        object(
+                                field("creation_event", ref("VectorEvents")),
+                                field("expiration_event", ref("VectorEvents")),
+                                field("timeline", map(ref("VectorEvents"))),
+                                field("travel_distance_events", map(ref("VectorEvents"))),
