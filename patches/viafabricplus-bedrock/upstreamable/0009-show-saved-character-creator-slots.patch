+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import java.util.function.ToIntFunction;
+import java.util.function.Predicate;
+
+/** Removes dead emitters before capturing the native manager's update batch. */
+final class BedrockParticleFrames {
+    private BedrockParticleFrames() {}
+
+    static <T> void advance(final List<T> emitters, final BedrockParticleCounts counts,
+                            final Function<T, String> effect, final Predicate<T> alive,
+                            final Consumer<T> update, final ToIntFunction<T> population) {
+        final var batch = batch(emitters, emitter -> {
+            if (alive.test(emitter)) return true;
+            counts.removed(effect.apply(emitter));
+            return false;
+        });
+        final Map<String, Long> particles = new HashMap<>();
+        for (final T emitter : batch) {
+            update.accept(emitter);
+            // Sample each emitter immediately after its update, before later callbacks can change its population.
+            particles.merge(effect.apply(emitter), (long) population.applyAsInt(emitter), Long::sum);
+        }
+        counts.publish(particles);
+    }
+
+    static <T> List<T> batch(final List<T> emitters, final Predicate<T> alive) {
+        int index = 0;
+        while (index < emitters.size()) {
+            if (alive.test(emitters.get(index))) {
+                index++;
+            } else {
+                final T last = emitters.removeLast();
+                if (index < emitters.size()) emitters.set(index, last);
+            }
+        }
+        return List.copyOf(emitters);
+    }
+}
