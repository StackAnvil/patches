+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.zip.ZipInputStream;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/** Downloads and decodes pieces authorized by the current account's entitlement receipt. */
+final class BedrockPersonaAssets {
+    private static final URI INVENTORY =
+            URI.create(
+                    "https://entitlements.mktpl.minecraft-services.net/api/v1.0/player/inventory?includeReceipt=true");
+    private static final URI CATALOG =
+            URI.create("https://20ca2.playfabapi.com/Catalog/GetPublishedItem");
+    private static final int MAX_JSON_BYTES = 2 * 1024 * 1024;
+    private static final int MAX_PACK_BYTES = 32 * 1024 * 1024;
+    private static final HttpClient HTTP =
+            HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();
+
+    private BedrockPersonaAssets() {}
+
+    static Map<String, Pack> load(
+            final BedrockAuthManager account, final BedrockPersonaProfile profile)
+            throws Exception {
+        return load(account, profile.pieces().stream()
+            .filter(piece -> !piece.defaultPiece() && !piece.productId().isEmpty())
+            .map(piece -> new Reference(piece.packId(), piece.productId())).toList());
+    }
+
+    static Map<String, Pack> load(final BedrockAuthManager account, final List<Reference> references)
+            throws Exception {
+        if (references.isEmpty()) return Map.of();
+        final String authorization =
+                account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+        final JsonObject inventory =
+                json(
+                        request(
+                                HttpRequest.newBuilder(INVENTORY)
+                                        .header("Authorization", authorization)
+                                        .header("Accept", "application/json")
+                                        .GET(),
+                                MAX_JSON_BYTES));
+        final JsonObject receipt =
+                json(
+                        Base64.getDecoder()
+                                .decode(
+                                        inventory
+                                                .getAsJsonObject("result")
+                                                .get("receipt")
+                                                .getAsString()));
+        final Map<String, byte[]> keys = receiptKeys(receipt);
+        final Map<String, Pack> packs = new LinkedHashMap<>();
+        for (final Reference piece : references) {
+            if (packs.containsKey(piece.packId())) continue;
+            final byte[] key = keys.get(piece.packId());
+            // Free pieces without a receipt continue to use the service's assembled model.
+            if (key == null) continue;
+            final JsonObject body = new JsonObject();
+            body.addProperty("ItemId", UUID.fromString(piece.productId()).toString());
+            final JsonObject catalog =
+                    json(
+                            request(
+                                    HttpRequest.newBuilder(CATALOG)
+                                            .header(
+                                                    "X-EntityToken",
+                                                    account.getPlayFabToken()
+                                                            .getUpToDate()
+                                                            .getEntityToken()
+                                                            .getToken())
+                                            .header("Content-Type", "application/json")
+                                            .POST(
+                                                    HttpRequest.BodyPublishers.ofString(
+                                                            body.toString())),
+                                    MAX_JSON_BYTES));
+            final JsonObject item = catalog.getAsJsonObject("data").getAsJsonObject("Item");
+            URI download = null;
+            for (final var element : item.getAsJsonArray("Contents")) {
+                final JsonObject content = element.getAsJsonObject();
+                if ("personabinary".equals(content.get("Type").getAsString())) {
+                    download = URI.create(content.get("Url").getAsString());
+                    break;
+                }
+            }
+            if (download == null
+                    || !"https".equals(download.getScheme())
+                    || download.getUserInfo() != null
+                    || download.getHost() == null
+                    || !download.getHost().matches("xforgeassets[0-9]+\\.xboxlive\\.com")) {
+                throw new IOException("The persona catalog returned an invalid asset location");
+            }
+            final byte[] bytes =
+                    request(
+                            HttpRequest.newBuilder(download)
+                                    .header("User-Agent", "libhttpclient/1.0.0.0")
+                                    .header("Accept", "*/*")
+                                    .GET(),
+                            MAX_PACK_BYTES);
+            packs.put(piece.packId(), decode(bytes, piece.packId(), key));
+        }
+        return Map.copyOf(packs);
+    }
+
+    static Map<String, byte[]> receiptKeys(final JsonObject receipt) throws IOException {
+        try {
+            final byte[] entity =
+                    receipt.get("EntityId").getAsString().getBytes(StandardCharsets.UTF_8);
+            final byte[] device =
+                    receipt.getAsJsonObject("ReceiptData")
+                            .get("DeviceId")
+                            .getAsString()
+                            .getBytes(StandardCharsets.UTF_8);
+            if (entity.length < 32 || device.length < 32)
+                throw new IOException("The entitlement receipt has an invalid identity");
+            final Map<String, byte[]> keys = new LinkedHashMap<>();
+            for (final var element : receipt.getAsJsonArray("EntitlementReceipts")) {
+                final JsonObject entry = element.getAsJsonObject();
+                if (!entry.has("ContentKey")
+                        || entry.get("ContentKey").isJsonNull()
+                        || entry.get("ContentKey").getAsString().isEmpty()) continue;
+                final byte[] encoded =
+                        Base64.getDecoder().decode(entry.get("ContentKey").getAsString());
+                if (encoded.length != 64)
+                    throw new IOException("The entitlement receipt has an invalid content key");
+                final byte[] key = new byte[32];
+                for (int index = 0; index < key.length; index++)
+                    key[index] = (byte) (entity[index] ^ device[index] ^ encoded[index * 2]);
+                keys.put(UUID.fromString(entry.get("PackId").getAsString()).toString(), key);
+            }
+            return keys;
+        } catch (RuntimeException e) {
+            throw new IOException("The entitlement receipt is invalid", e);
+        }
+    }
+
+    static Pack decode(final byte[] source, final String expectedPack, final byte[] key)
+            throws IOException {
+        try {
+            Map<String, byte[]> files = unzip(source);
+            if (files.size() == 1 && files.containsKey("ppack0.zip"))
+                files = unzip(files.get("ppack0.zip"));
+            final JsonObject manifest = json(required(files, "manifest.json"));
+            if (!expectedPack.equals(
+                    manifest.getAsJsonObject("header").get("uuid").getAsString())) {
+                throw new IOException("The downloaded persona pack has a different identity");
+            }
+            final byte[] contents = required(files, "contents.json");
+            if (contents.length < 256
+                    || contents[4] != (byte) 0xFC
+                    || contents[5] != (byte) 0xB9
+                    || contents[6] != (byte) 0xCF
+                    || contents[7] != (byte) 0x9B
+                    || (contents[16] & 0xFF) != expectedPack.length()
+                    || !expectedPack.equals(
+                            new String(
+                                    contents, 17, expectedPack.length(), StandardCharsets.UTF_8))) {
+                throw new IOException("The downloaded persona pack has an invalid content index");
+            }
+            final JsonObject index =
+                    json(decrypt(Arrays.copyOfRange(contents, 256, contents.length), key));
+            final Map<String, byte[]> decoded = new LinkedHashMap<>();
+            for (final var element : index.getAsJsonArray("content")) {
+                final JsonObject entry = element.getAsJsonObject();
+                final String path = entry.get("path").getAsString();
+                if (path.endsWith("/")) continue;
+                final byte[] data = required(files, path);
+                decoded.put(
+                        path,
+                        entry.has("key")
+                                        && !entry.get("key").isJsonNull()
+                                        && !entry.get("key").getAsString().isEmpty()
+                                ? decrypt(
+                                        data,
+                                        entry.get("key")
+                                                .getAsString()
+                                                .getBytes(StandardCharsets.ISO_8859_1))
+                                : data);
+            }
+            decoded.put("manifest.json", files.get("manifest.json"));
+            return new Pack(expectedPack, Map.copyOf(decoded));
+        } catch (GeneralSecurityException | RuntimeException e) {
+            throw new IOException("The entitled persona pack could not be decoded", e);
+        }
+    }
+
+    private static byte[] decrypt(final byte[] data, final byte[] key)
+            throws GeneralSecurityException {
+        if (key.length != 32) throw new GeneralSecurityException("Invalid content key length");
+        final Cipher cipher = Cipher.getInstance("AES/CFB8/NoPadding");
+        cipher.init(
+                Cipher.DECRYPT_MODE,
+                new SecretKeySpec(key, "AES"),
+                new IvParameterSpec(Arrays.copyOf(key, 16)));
+        return cipher.doFinal(data);
+    }
+
+    private static Map<String, byte[]> unzip(final byte[] source) throws IOException {
+        if (source.length > MAX_PACK_BYTES)
+            throw new IOException("The persona archive is too large");
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        int total = 0;
+        try (final ZipInputStream input = new ZipInputStream(new ByteArrayInputStream(source))) {
+            for (var entry = input.getNextEntry(); entry != null; entry = input.getNextEntry()) {
+                if (entry.isDirectory()) continue;
+                final String path = entry.getName();
+                if (files.size() >= 1024
+                        || path.startsWith("/")
+                        || path.contains("\\")
+                        || Arrays.asList(path.split("/")).contains(".."))
+                    throw new IOException("The persona archive has an invalid path");
+                final byte[] data = limited(input, MAX_PACK_BYTES - total);
+                total += data.length;
+                // Native archives contain an obsolete contents.json before their final encrypted
+                // index.
+                if (files.put(path, data) != null && !"contents.json".equals(path)) {
+                    throw new IOException("The persona archive has duplicate entries");
+                }
+            }
+        }
+        if (files.isEmpty()) throw new IOException("The persona archive is empty");
+        return files;
+    }
+
+    private static byte[] required(final Map<String, byte[]> files, final String path)
+            throws IOException {
+        final byte[] value = files.get(path);
+        if (value == null) throw new IOException("The persona archive is missing an indexed file");
+        return value;
+    }
+
+    private static byte[] request(final HttpRequest.Builder builder, final int limit)
+            throws IOException, InterruptedException {
+        final var response =
+                HTTP.send(
+                        builder.timeout(Duration.ofSeconds(30)).build(),
+                        HttpResponse.BodyHandlers.ofInputStream());
+        try (final InputStream input = response.body()) {
+            if (response.statusCode() / 100 != 2)
+                throw new IOException(
+                        "The persona asset request failed: HTTP " + response.statusCode());
+            return limited(input, limit);
+        }
+    }
+
+    private static byte[] limited(final InputStream input, final int limit) throws IOException {
+        final byte[] data = input.readNBytes(limit + 1);
+        if (data.length > limit) throw new IOException("The persona asset exceeds the size limit");
+        return data;
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes.length > MAX_JSON_BYTES)
+            throw new IOException("The persona metadata is too large");
+        try {
+            return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                    .getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("The persona metadata is invalid", e);
+        }
+    }
+
+    record Reference(String packId, String productId) {}
+
+    record Pack(String id, Map<String, byte[]> files) {}
+}
