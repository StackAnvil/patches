@@ -0,0 +1,70 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.minecraftauth.msa.model.MsaApplicationConfig;
+import net.raphimc.minecraftauth.msa.model.MsaToken;
+
+/** Requests the licensing audience with the selected account's existing MSA refresh token. */
+final class BedrockStoreTokens {
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(15)).build();
+
+    private BedrockStoreTokens() {}
+
+    static JsonObject acquire(final BedrockAuthManager account) throws Exception {
+        return acquire(account.getMsaApplicationConfig(), account.getMsaToken().getUpToDate());
+    }
+
+    static JsonObject acquire(final MsaApplicationConfig application, final MsaToken msa) throws Exception {
+        final String body = "client_id=" + encode(application.getClientId())
+            + "&scope=" + encode("service::www.microsoft.com::MBI_SSL")
+            + "&grant_type=refresh_token&refresh_token=" + encode(msa.getRefreshToken())
+            + (application.getClientSecret() == null ? "" : "&client_secret=" + encode(application.getClientSecret()));
+        final var request = HttpRequest.newBuilder(URI.create("https://login.live.com/oauth20_token.srf"))
+            .timeout(Duration.ofSeconds(30)).header("Content-Type", "application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString(body)).build();
+        final var response = HTTP.send(request, HttpResponse.BodyHandlers.ofInputStream());
+        try (final var input = response.body()) {
+            if (response.statusCode() != 200) throw new IOException("The selected account requires interactive Store sign-in");
+            final byte[] bytes = input.readNBytes(16385);
+            if (bytes.length > 16384) throw new IOException("The licensing token response is too large");
+            return credentials(JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)).getAsJsonObject(),
+                (application.isTitleClientId() ? "t=" : "d=") + msa.getAccessToken());
+        }
+    }
+
+    static JsonObject credentials(final JsonObject response, final String xboxTicket) throws IOException {
+        try {
+            final String token = response.get("access_token").getAsString();
+            final String puid = response.get("user_id").getAsString();
+            if (token.isBlank() || token.length() > 8192 || xboxTicket.length() > 8192 || !puid.matches("[0-9a-fA-F]{16}")) {
+                throw new IOException("The licensing response has invalid credentials");
+            }
+            final JsonObject result = new JsonObject();
+            result.addProperty("accessToken", token);
+            result.addProperty("ticketReference", puid);
+            result.addProperty("xboxTicket", xboxTicket);
+            return result;
+        } catch (RuntimeException invalid) {
+            throw new IOException("The licensing response is incomplete", invalid);
+        }
+    }
+
+    private static String encode(final String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+}
