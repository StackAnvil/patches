+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.api.connection.StorableObject;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.raphimc.viabedrock.api.model.entity.PlayerEntity;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Immutable actor inputs published by the connection's network thread for rendering. */
+public final class BedrockPlayerActorState implements StorableObject {
+    private final Map<UUID, State> players = new ConcurrentHashMap<>();
+
+    private BedrockPlayerActorState() {}
+
+    /**
+     * Called after ViaBedrock accepts metadata, while its entity state is still on the network
+     * thread.
+     */
+    public static void update(final UserConnection connection, final PlayerEntity player) {
+        BedrockPlayerActorState store = connection.get(BedrockPlayerActorState.class);
+        if (store == null) {
+            store = new BedrockPlayerActorState();
+            connection.put(store);
+        }
+        store.players.put(
+                player.javaUuid(),
+                new State(player, player.entityFlags().contains(ActorFlags.CHARGING)));
+    }
+
+    public static void remove(final UserConnection connection, final PlayerEntity player) {
+        final BedrockPlayerActorState store = connection.get(BedrockPlayerActorState.class);
+        if (store != null)
+            store.players.computeIfPresent(
+                    player.javaUuid(), (_, state) -> state.owner() == player ? null : state);
+    }
+
+    public static boolean isCharging(final UserConnection connection, final UUID playerUuid) {
+        if (connection == null) return false;
+        final BedrockPlayerActorState store = connection.get(BedrockPlayerActorState.class);
+        final State state = store == null ? null : store.players.get(playerUuid);
+        return state != null && state.charging();
+    }
+
+    private record State(PlayerEntity owner, boolean charging) {}
+}
