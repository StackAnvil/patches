+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** The ordinary hand camera in Bedrock 1.26.51.1, independent of the world FOV slider. */
+final class BedrockFirstPersonProjection {
+    static final float NEAR_PLANE = .025F;
+
+    private BedrockFirstPersonProjection() {}
+
+    static float fieldOfView(final boolean effects, final boolean underwater, final boolean alive,
+                             final int deathTicks, final float partialTick) {
+        float fov = 70F;
+        if (effects) {
+            if (underwater) fov = fov * 60F / 70F;
+            if (!alive) {
+                // DeathTickingComponent stores a signed short. The native curve has no 20-tick cap.
+                final float elapsed = (float) (short) deathTicks + partialTick;
+                final float factor = 1F - 500F / (elapsed + 500F);
+                fov /= factor + factor + 1F;
+            }
+        }
+        return Math.clamp(fov, 5F, 130F);
+    }
+}
