@@ -0,0 +1,139 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+final class BedrockPackageHelperTest {
+    @TempDir Path directory;
+    @Test
+    void drainsDiagnosticsWhileDeliveringTheRequestAndFindsTheFinalReceipt() throws Exception {
+        final JsonObject request = request();
+        final Process process = child(0, request);
+        BedrockPackageHelper.exchange(process, request);
+        assertEquals(0, process.exitValue());
+        assertFalse(process.isAlive());
+    }
+
+    @ParameterizedTest
+    @ValueSource(ints = {1, 2, 3})
+    void rejectsEarlyExitEvenWhenTheChildClaimsSuccess(final int mode) throws Exception {
+        final JsonObject request = request();
+        final Process process = child(mode, request);
+        assertThrows(IOException.class, () -> BedrockPackageHelper.exchange(process, request));
+        assertFalse(process.isAlive());
+    }
+
+    @Test
+    void reportsHeadlessSignInRequirementAfterDrainingTheHelper() throws Exception {
+        final JsonObject request = request();
+        final Process process = child(5, request);
+        assertThrows(BedrockPackageHelper.StoreSignInRequiredException.class,
+                () -> BedrockPackageHelper.exchange(process, request));
+        assertFalse(process.isAlive());
+    }
+
+    @Test
+    void stopsTheHelperWhenTheClientJvmExits() throws Exception {
+        final Path pidFile = directory.resolve("helper-pid");
+        final String classpath = Stream.of(BedrockPackageHelper.class, JsonObject.class, Child.class)
+                .map(type -> {
+                    try {
+                        return Path.of(type.getProtectionDomain().getCodeSource().getLocation().toURI()).toString();
+                    } catch (Exception e) {
+                        throw new IllegalStateException(e);
+                    }
+                }).distinct().collect(Collectors.joining(java.io.File.pathSeparator));
+        final Process parent = new ProcessBuilder(javaExecutable().toString(), "-cp", classpath,
+                ShutdownParent.class.getName(), pidFile.toString()).redirectErrorStream(true).start();
+        ProcessHandle helper = null;
+        try {
+            final long deadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(10);
+            while (!Files.exists(pidFile) && parent.isAlive() && System.nanoTime() < deadline) Thread.sleep(10);
+            assertTrue(Files.exists(pidFile));
+            helper = ProcessHandle.of(Long.parseLong(Files.readString(pidFile))).orElseThrow();
+            assertTrue(helper.isAlive());
+            parent.destroy();
+            assertTrue(parent.waitFor(10, java.util.concurrent.TimeUnit.SECONDS));
+            final long exitDeadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(10);
+            while (helper.isAlive() && System.nanoTime() < exitDeadline) Thread.sleep(10);
+            assertFalse(helper.isAlive());
+        } finally {
+            parent.destroy();
+            if (!parent.waitFor(10, java.util.concurrent.TimeUnit.SECONDS)) parent.destroyForcibly();
+            if (helper != null && helper.isAlive()) helper.destroyForcibly();
+        }
+    }
+
+    private static Path javaExecutable() {
+        return Path.of(System.getProperty("java.home"), "bin",
+                System.getProperty("os.name").startsWith("Windows") ? "java.exe" : "java");
+    }
+
+    private static JsonObject request() {
+        final JsonObject request = new JsonObject();
+        request.addProperty("payload", "x".repeat(1024 * 1024));
+        return request;
+    }
+
+    private static Process child(final int mode, final JsonObject request) throws Exception {
+        final Path java = javaExecutable();
+        final String classes = Path.of(Child.class.getProtectionDomain().getCodeSource().getLocation().toURI()).toString();
+        return new ProcessBuilder(java.toString(), "-cp", classes, Child.class.getName(),
+                Integer.toString(mode), Integer.toString(request.toString().getBytes(StandardCharsets.UTF_8).length))
+                .redirectErrorStream(true).start();
+    }
+
+    public static final class ShutdownParent {
+        public static void main(final String[] args) throws Exception {
+            final Process helper = new ProcessBuilder(javaExecutable().toString(), "-cp",
+                    System.getProperty("java.class.path"), Child.class.getName(), "4", "0", args[0])
+                    .redirectErrorStream(true).start();
+            BedrockPackageHelper.exchange(helper, new JsonObject());
+        }
+    }
+
+    public static final class Child {
+        public static void main(final String[] args) throws Exception {
+            final int mode = Integer.parseInt(args[0]);
+            if (mode == 5) {
+                System.in.readAllBytes();
+                System.out.println("x".repeat(32768));
+                System.out.println("{\"ok\":false,\"error\":\"interactive_sign_in_required\"}");
+                System.exit(1);
+            }
+            if (mode == 4) {
+                System.in.readAllBytes();
+                final Path ready = Path.of(args[2]);
+                final Path temporary = ready.resolveSibling(ready.getFileName() + ".tmp");
+                Files.writeString(temporary, Long.toString(ProcessHandle.current().pid()));
+                Files.move(temporary, ready, StandardCopyOption.ATOMIC_MOVE);
+                Thread.sleep(60000);
+                return;
+            }
+            if (mode != 0) {
+                System.in.close();
+                if (mode != 1) System.out.println("{\"ok\":" + (mode == 3) + "}");
+                System.exit(mode == 3 ? 0 : 1);
+            }
+            // Write more than either pipe can hold before consuming the request.
+            System.out.println("x".repeat(32768));
+            for (int line = 0; line < 1000; line++) System.out.println("diagnostic");
+            final int received = System.in.readAllBytes().length;
+            final boolean complete = received == Integer.parseInt(args[1]);
+            System.out.print("{\"ok\":" + complete + "}");
+            System.exit(complete ? 0 : 1);
+        }
+    }
+}
