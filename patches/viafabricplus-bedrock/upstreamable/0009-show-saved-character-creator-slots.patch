+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import org.joml.Vector3f;
+import net.minecraft.world.phys.Vec3;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Swept sphere bounds and axis response used by Bedrock 1.26.51 particles. */
+record BedrockParticleCollision(BedrockMolang.Program enabled, float drag, float restitution,
+                                float radius, boolean expireOnContact, List<Trigger> events) {
+    BedrockParticleCollision { events = List.copyOf(events); }
+
+    record Trigger(String name, float minimumSpeed) {}
+    record Contact(List<String> names, BedrockParticleAttachment.Matrix transform, Vector3f velocity) {
+        Contact { names = List.copyOf(names); velocity = new Vector3f(velocity); }
+    }
+    @FunctionalInterface
+    interface Terrain {
+        List<Box> boxes(int x, int y, int z);
+    }
+
+    record Box(float minX, float minY, float minZ, float maxX, float maxY, float maxZ) {
+        float min(final int axis) { return axis == 0 ? this.minX : axis == 1 ? this.minY : this.minZ; }
+        float max(final int axis) { return axis == 0 ? this.maxX : axis == 1 ? this.maxY : this.maxZ; }
+    }
+
+    static BedrockParticleCollision read(final JsonObject value) throws IOException {
+        final List<Trigger> events = new ArrayList<>();
+        if (value.has("events")) {
+            final var declared = value.get("events");
+            if (declared.isJsonArray()) {
+                if (declared.getAsJsonArray().size() > 256) throw new IOException("Particle collision events exceed their limit");
+                for (final var event : declared.getAsJsonArray()) {
+                    if (!event.isJsonObject()) throw new IOException("Invalid particle collision event");
+                    events.add(trigger(event.getAsJsonObject()));
+                }
+            } else if (declared.isJsonObject()) events.add(trigger(declared.getAsJsonObject()));
+            else throw new IOException("Invalid particle collision events");
+        }
+        final var enabled = value.get("enabled");
+        final BedrockMolang.Program program = enabled != null && enabled.isJsonPrimitive() && enabled.getAsJsonPrimitive().isBoolean()
+                ? new BedrockMolang.Program(enabled.getAsBoolean() ? 1 : 0, null) : BedrockMolang.Program.parse(enabled, 1);
+        final var expire = value.get("expire_on_contact");
+        if (expire != null && (!expire.isJsonPrimitive() || !expire.getAsJsonPrimitive().isBoolean()))
+            throw new IOException("Invalid particle contact expiration");
+        return new BedrockParticleCollision(program, number(value, "collision_drag", 0),
+                number(value, "coefficient_of_restitution", 0), Math.clamp(number(value, "collision_radius", 0), 0, .5F),
+                expire != null && expire.getAsBoolean(), events);
+    }
+
+    private static Trigger trigger(final JsonObject value) throws IOException {
+        final var event = value.get("event");
+        if (event == null || !event.isJsonPrimitive() || !event.getAsJsonPrimitive().isString()
+                || event.getAsString().isEmpty() || event.getAsString().length() > 256)
+            throw new IOException("Invalid particle collision event name");
+        return new Trigger(event.getAsString(), Math.max(2, number(value, "min_speed", 2)));
+    }
+
+    /** Positions are relative to the supplied world origin. Returns whether any pass made contact. */
+    boolean collide(final Vector3f previous, final Vector3f position, final Vector3f velocity,
+                    final long nanos, final BedrockMolang environment, final Vec3 origin, final Terrain terrain,
+                    final long lifetime, final java.util.function.Function<Vector3f, Vector3f> eventVelocity,
+                    final java.util.function.Consumer<Contact> sink) {
+        if (environment.evaluate(this.enabled, 1) == 0) return false;
+        final Vector3f translation = new Vector3f((float) origin.x, (float) origin.y, (float) origin.z);
+        final Vector3f start = new Vector3f(previous).add(translation);
+        position.add(translation);
+        final Vector3f displacement = new Vector3f(position).sub(start);
+        final float distance = (float) Math.sqrt(displacement.x * displacement.x + displacement.y * displacement.y + displacement.z * displacement.z);
+        if (distance > 1) {
+            final float scale = 1F / distance;
+            start.set(position.x - displacement.x * scale, position.y - displacement.y * scale, position.z - displacement.z * scale);
+        }
+        final List<Box> boxes = collect(start, position, terrain);
+        final float drag = ((float) nanos / 1_000_000_000F) * this.drag;
+        final Vector3f incoming = new Vector3f(velocity);
+        int lastAxis = -1;
+        boolean contacted = false;
+        for (int pass = 0; pass < 3; pass++) {
+            final int axis = sweep(start, position, velocity, boxes);
+            if (axis < 0) break;
+            contacted = true;
+            lastAxis = axis;
+            // Native drag removes speed in the contact plane once per collision pass.
+            final Vector3f tangent = new Vector3f(velocity).setComponent(axis, 0);
+            final float squared = tangent.x * tangent.x + tangent.y * tangent.y + tangent.z * tangent.z;
+            float changeX = 0, changeY = 0, changeZ = 0;
+            if (squared > 0) {
+                final float length = (float) Math.sqrt(squared);
+                final float remaining = Math.max(0, length - drag);
+                final float x = length >= .0001F ? tangent.x / length : 0;
+                final float y = length >= .0001F ? tangent.y / length : 0;
+                final float z = length >= .0001F ? tangent.z / length : 0;
+                changeX = x * remaining - tangent.x;
+                changeY = y * remaining - tangent.y;
+                changeZ = z * remaining - tangent.z;
+            }
+            velocity.add(changeX, changeY, changeZ);
+        }
+        // Dispatch once after all passes, against incoming velocity and the last contact axis.
+        if (contacted && lifetime > 0 && !this.events.isEmpty()) {
+            final float speed = Math.abs(incoming.get(lastAxis));
+            final List<String> names = new ArrayList<>();
+            for (final Trigger event : this.events) if (event.minimumSpeed <= speed) names.add(event.name);
+            if (!names.isEmpty()) {
+                final Vector3f source = eventVelocity.apply(incoming);
+                sink.accept(new Contact(names, frame(lastAxis, position, source), source));
+            }
+        }
+        position.sub(translation);
+        return contacted;
+    }
+
+    static BedrockParticleAttachment.Matrix frame(final int axis, final Vector3f position, final Vector3f source) {
+        final float squared = (source.y * source.y + source.x * source.x) + source.z * source.z;
+        if (squared <= 0x1.0p-46F)
+            return BedrockParticleAttachment.Matrix.translation(new Vec3(position.x, position.y, position.z));
+        final float length = (float) Math.sqrt(squared);
+        final Vector3f velocity = length >= .0001F
+                ? new Vector3f(source.x / length, source.y / length, source.z / length) : new Vector3f();
+        final Vector3f normal = new Vector3f().setComponent(axis, 1);
+        final float dot = (normal.z * velocity.z + normal.y * velocity.y) + velocity.x * normal.x;
+        if (dot < -.99F) {
+            final float x = Math.abs(normal.y) >= .99F ? 1 : 0;
+            final float y = Math.abs(normal.y) >= .99F ? 0 : 1;
+            normal.set(velocity.y * 0 - y * velocity.z,
+                    x * velocity.z - velocity.x * 0, y * velocity.x - x * velocity.y);
+        }
+        final float rightX = velocity.z * normal.y - velocity.y * normal.z;
+        final float rightY = velocity.x * normal.z - velocity.z * normal.x;
+        final float rightZ = velocity.y * normal.x - velocity.x * normal.y;
+        return new BedrockParticleAttachment.Matrix(new float[] {
+                rightX, rightY, rightZ, 0, normal.x, normal.y, normal.z, 0,
+                normal.z * rightY - normal.y * rightZ,
+                normal.x * rightZ - normal.z * rightX,
+                normal.y * rightX - normal.x * rightY, 0,
+                position.x, position.y, position.z, 1});
+    }
+
+    private List<Box> collect(final Vector3f start, final Vector3f end, final Terrain terrain) {
+        final List<Box> result = new ArrayList<>();
+        final int minX = Math.max(floor(Math.min(start.x, end.x) - this.radius), floor(start.x) - 1);
+        final int minY = Math.max(floor(Math.min(start.y, end.y) - this.radius), floor(start.y) - 1);
+        final int minZ = Math.max(floor(Math.min(start.z, end.z) - this.radius), floor(start.z) - 1);
+        final int maxX = Math.min(floor(Math.max(start.x, end.x) + this.radius), floor(start.x) + 1);
+        final int maxY = Math.min(floor(Math.max(start.y, end.y) + this.radius), floor(start.y) + 1);
+        final int maxZ = Math.min(floor(Math.max(start.z, end.z) + this.radius), floor(start.z) + 1);
+        for (int x = minX; x <= maxX; x++) for (int z = minZ; z <= maxZ; z++) for (int y = maxY; y >= minY; y--)
+            result.addAll(terrain.boxes(x, y, z));
+        return result;
+    }
+
+    private int sweep(final Vector3f start, final Vector3f end, final Vector3f velocity, final List<Box> boxes) {
+        final Vector3f minimum = new Vector3f(Math.min(start.x, end.x) - this.radius,
+                Math.min(start.y, end.y) - this.radius, Math.min(start.z, end.z) - this.radius);
+        final Vector3f maximum = new Vector3f(Math.max(start.x, end.x) + this.radius,
+                Math.max(start.y, end.y) + this.radius, Math.max(start.z, end.z) + this.radius);
+        final Vector3f delta = new Vector3f(end).sub(start);
+        float first = Float.MAX_VALUE;
+        int axis = -1;
+        final float[] near = new float[3], far = new float[3];
+        for (final Box box : boxes) {
+            boolean admitted = true;
+            for (int dimension = 0; dimension < 3; dimension++) {
+                if (!(minimum.get(dimension) < box.max(dimension) && box.min(dimension) < maximum.get(dimension))) {
+                    admitted = false;
+                    break;
+                }
+                final float lower = box.min(dimension) - this.radius, upper = box.max(dimension) + this.radius;
+                if (Math.abs(delta.get(dimension)) >= Math.ulp(1F)) {
+                    final float inverse = 1F / delta.get(dimension);
+                    final float from = (lower - start.get(dimension)) * inverse, to = (upper - start.get(dimension)) * inverse;
+                    near[dimension] = Math.min(from, to);
+                    far[dimension] = Math.max(from, to);
+                } else {
+                    if (end.get(dimension) <= lower || upper <= end.get(dimension)) { admitted = false; break; }
+                    near[dimension] = -Float.MAX_VALUE;
+                    far[dimension] = Float.MAX_VALUE;
+                }
+            }
+            if (!admitted) continue;
+            final int candidate = near[0] > near[1] && near[0] > near[2] ? 0 : near[1] > near[2] ? 1 : 2;
+            final float time = near[candidate];
+            if (!(time >= 0 && time <= 1 && time <= far[0] && time <= far[1] && time <= far[2])) continue;
+            final float biased = time != 1 && time > 0x1.0p-15F ? time - 0x1.0p-15F : time;
+            if (biased < first) { first = biased; axis = candidate; }
+        }
+        if (axis >= 0) {
+            final float correction = (1 - first) * -delta.get(axis);
+            end.setComponent(axis, end.get(axis) + correction);
+            velocity.setComponent(axis, -velocity.get(axis) * this.restitution);
+        }
+        return axis;
+    }
+
+    private static int floor(final float value) { return (int) Math.floor(value); }
+    private static float number(final JsonObject value, final String name, final float fallback) throws IOException {
+        final float number = value.has(name) ? value.get(name).getAsFloat() : fallback;
+        if (!Float.isFinite(number) || Math.abs(number) > 32768) throw new IOException("Invalid particle collision number");
+        return number;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCounts.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCounts.java
