@@ -0,0 +1,142 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorVisibilityTest {
+    @Test
+    void usesTheSampledActorScopeWithoutRunningScriptsTwiceAndSeparatesPerspectives() throws Exception {
+        final var entity = json("""
+                {"description":{"identifier":"minecraft:player","scripts":{
+                 "initialize":["v.counter=0;"],"pre_animation":["v.counter=v.counter+1;v.is_first_person=c.is_first_person;"]},
+                 "render_controllers":[{"controller.front":"v.is_first_person"},
+                                       {"controller.back":"!v.is_first_person"}]}}
+                """);
+        final var definitions = json("""
+                {"render_controllers":{
+                 "controller.front":{"part_visibility":[{"*":false},{"right*":"v.counter==1"}]},
+                 "controller.back":{"part_visibility":[{"*":false},{"left*":true}]}}}
+                """);
+        final var graph = BedrockActorAnimation.read(library(entity, definitions), BedrockClassicOptions.EMPTY);
+        final var body = graph.playback();
+        final var hands = body.fork();
+        body.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 0)));
+        assertTrue(body.visibility().visible("leftArm"));
+        assertFalse(body.visibility().visible("rightArm"));
+        hands.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 1)));
+        assertTrue(hands.visibility().visible("rightArm"));
+        assertTrue(hands.visibility().visible("rightSleeve"));
+        assertFalse(hands.visibility().visible("leftArm"));
+        assertTrue(hands.visibility().visible("rightArm"));
+        assertTrue(body.visibility().visible("leftArm"));
+        hands.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 1)));
+        assertFalse(hands.visibility().visible("rightArm"));
+    }
+
+    @Test
+    void keepsOrderedWildcardOverridesAndIndependentControllerDraws() throws Exception {
+        final var entity = json("""
+                {"description":{"identifier":"minecraft:player","render_controllers":[
+                 {"controller.one":"q.enabled"}, {"controller.two":"q.second"}]}}
+                """);
+        final var definitions = json("""
+                {"render_controllers":{
+                 "controller.one":{"part_visibility":[{"*":false},{"*Arm":true},{"leftArm":false}]},
+                 "controller.two":{"part_visibility":[{"*":false},{"leftArm":true}]}}}
+                """);
+        final var actor = BedrockActorAnimation.read(library(entity, definitions), BedrockClassicOptions.EMPTY).playback();
+        actor.sample(0, new BedrockActorAnimation.Frame(Map.of("enabled", 1, "second", 0), Map.of()));
+        assertTrue(actor.visibility().visible("rightArm"));
+        assertFalse(actor.visibility().visible("leftArm"));
+        actor.sample(1, new BedrockActorAnimation.Frame(Map.of("enabled", 1, "second", 1), Map.of()));
+        assertTrue(actor.visibility().visible("leftArm"));
+        actor.sample(2, new BedrockActorAnimation.Frame(Map.of("enabled", 0, "second", 0), Map.of()));
+        assertFalse(actor.visibility().visible("rightArm"));
+        assertFalse(actor.visibility().visible("leftArm"));
+        assertTrue(BedrockActorAnimation.Visibility.UNSPECIFIED.visible("rightArm"));
+    }
+
+    @Test
+    void visibilityFromOtherModelsDoesNotExposeHiddenBodyParts() throws Exception {
+        final var entity = json("""
+                {"description":{"identifier":"minecraft:player","geometry":{
+                 "default":"geometry.body","cape":"geometry.cape"},
+                 "render_controllers":["controller.body","controller.cape"]}}
+                """);
+        final var definitions = json("""
+                {"render_controllers":{
+                 "controller.body":{"geometry":"Geometry.default","part_visibility":[{"*":false},{"rightArm":true}]},
+                 "controller.cape":{"geometry":"Geometry.cape","part_visibility":[{"*":true}]}}}
+                """);
+        final var actor = BedrockActorAnimation.read(library(entity, definitions), BedrockClassicOptions.EMPTY).playback();
+        actor.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertTrue(actor.visibility().visible("rightArm"));
+        assertFalse(actor.visibility().visible("leftArm"));
+        assertFalse(actor.visibility().visible("head"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_FIRST_PERSON_RESOURCES", matches = ".+")
+    void matchingLicensedControllersSelectHandsFromEquipmentUseAndChargedState() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_FIRST_PERSON_RESOURCES"));
+        final Map<String, byte[]> files = new HashMap<>();
+        try (var paths = Files.walk(root.resolve("library"))) {
+            for (final Path path : paths.filter(Files::isRegularFile).toList())
+                files.put(root.relativize(path).toString().replace('\\', '/'), Files.readAllBytes(path));
+        }
+        final var graph = BedrockActorAnimation.read(BedrockResourceLibrary.read(files), BedrockClassicOptions.EMPTY);
+        int cases = 0;
+        for (final String main : List.of("", "filled_map", "crossbow", "shield")) {
+            for (final String off : List.of("", "filled_map", "shield")) {
+                for (final boolean charged : List.of(false, true)) {
+                    for (final boolean spectator : List.of(false, true)) {
+                        for (final float use : new float[]{0, 0.5F, 1}) {
+                            final var playback = graph.playback();
+                            final var frame = new BedrockActorAnimation.Frame(Map.of(
+                                    "is_spectator", spectator, "item_is_charged", charged,
+                                    "main_hand_item_use_duration", use * 20, "main_hand_item_max_duration", 20,
+                                    "get_equipped_item_name", (BedrockActorAnimation.Query) args ->
+                                            !args.isEmpty() && "off_hand".equals(args.getFirst()) ? off : main),
+                                    Map.of("is_first_person", 1F, "item_use_normalized", use));
+                            playback.sample(0, frame, false, null, null);
+                            final var visibility = playback.visibility();
+                            assertTrue(visibility.specified());
+                            final boolean right = !spectator && (main.isEmpty() || main.equals("filled_map"));
+                            final boolean left = !spectator && (main.equals("filled_map") && !off.equals("shield")
+                                    || off.equals("filled_map") && !charged || !charged && use > 0 && use < 1);
+                            assertEquals(right, visibility.visible("rightArm"));
+                            assertEquals(right, visibility.visible("rightSleeve"));
+                            assertEquals(left, visibility.visible("leftArm"));
+                            assertEquals(left, visibility.visible("leftSleeve"));
+                            assertFalse(visibility.visible("head"));
+                            assertFalse(visibility.visible("body"));
+                            cases++;
+                        }
+                    }
+                }
+            }
+        }
+        assertEquals(144, cases);
+    }
+
+    private static BedrockResourceLibrary library(final JsonObject entity, final JsonObject definitions) throws Exception {
+        final var client = new JsonObject();
+        client.add("minecraft:client_entity", entity);
+        return BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/entity/player.entity.json", client.toString().getBytes(StandardCharsets.UTF_8),
+                "library/vanilla/render_controllers/player.json", definitions.toString().getBytes(StandardCharsets.UTF_8)));
+    }
+
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+}
