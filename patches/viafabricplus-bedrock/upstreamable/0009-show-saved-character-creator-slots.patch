+                diagnostics.add("Particle flipbook base UV is missing. Used zero.");
+                base = vector(null, 2, 0);
+            } else if (!declaredBase.isJsonArray() || declaredBase.getAsJsonArray().size() != 2) {
+                diagnostics.add("Particle flipbook base UV must have two components. Used zero.");
+                base = vector(null, 2, 0);
+            } else {
+                final List<BedrockMolang.Program> programs = new ArrayList<>(2);
+                for (final JsonElement axis : declaredBase.getAsJsonArray())
+                    programs.add(expression(axis, 0, false, diagnostics));
+                base = List.copyOf(programs);
+            }
+            final float[] size = constantVector(object.get("size_UV"), 1, diagnostics);
+            final float[] step = constantVector(object.get("step_UV"), 0, diagnostics);
+            return new Flipbook(base, size[0], size[1], step[0], step[1],
+                    expression(object.get("max_frame"), 1, true, diagnostics),
+                    constant(object.get("frames_per_second"), 0, diagnostics),
+                    flag(object.get("stretch_to_lifetime"), diagnostics), flag(object.get("loop"), diagnostics));
+        }
+
+        private static BedrockMolang.Program expression(final JsonElement value, final float fallback,
+                                                        final boolean required, final List<String> diagnostics) throws IOException {
+            if (value == null || value.isJsonNull()) {
+                diagnostics.add(required ? "Particle flipbook frame count is missing. Used one."
+                        : "Particle flipbook base component must be a number or Molang expression. Used zero.");
+                return new BedrockMolang.Program(fallback, null);
+            }
+            if (value.isJsonPrimitive()) {
+                if (value.getAsJsonPrimitive().isNumber()) return new BedrockMolang.Program(value.getAsFloat(), null);
+                if (value.getAsJsonPrimitive().isBoolean()) return new BedrockMolang.Program(value.getAsBoolean() ? 1 : 0, null);
+                try {
+                    return BedrockMolang.Program.parse(value, fallback);
+                } catch (ParseException invalid) {
+                    diagnostics.add("Could not parse particle flipbook expression. Retained its default.");
+                    return new BedrockMolang.Program(fallback, null);
+                }
+            }
+            diagnostics.add("Particle flipbook field must be a number or Molang expression. Retained its default.");
+            return new BedrockMolang.Program(fallback, null);
+        }
+
+        private static float[] constantVector(final JsonElement value, final float fallback, final List<String> diagnostics) {
+            if (value == null || value.isJsonNull()) return new float[]{fallback, fallback};
+            if (!value.isJsonArray() || value.getAsJsonArray().size() != 2) {
+                diagnostics.add("Particle flipbook size and step must have two numeric components. Retained their defaults.");
+                return new float[]{fallback, fallback};
+            }
+            return new float[]{constant(value.getAsJsonArray().get(0), fallback, diagnostics),
+                    constant(value.getAsJsonArray().get(1), fallback, diagnostics)};
+        }
+
+        private static float constant(final JsonElement value, final float fallback, final List<String> diagnostics) {
+            if (value == null || value.isJsonNull()) return fallback;
+            if (value.isJsonPrimitive()) {
+                if (value.getAsJsonPrimitive().isNumber()) return value.getAsFloat();
+                if (value.getAsJsonPrimitive().isBoolean()) return value.getAsBoolean() ? 1 : 0;
+            }
+            diagnostics.add("Particle flipbook numeric field has an invalid type. Retained its default.");
+            return fallback;
+        }
+
+        private static boolean flag(final JsonElement value, final List<String> diagnostics) {
+            if (value == null || value.isJsonNull()) return false;
+            if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isBoolean()) return value.getAsBoolean();
+            diagnostics.add("Particle flipbook flag must be a Boolean. Used false.");
+            return false;
+        }
+
+        float frame(final BedrockMolang environment, final float age, final float lifetime) {
+            final float frames = environment.evaluate(this.frames, 1);
+            final float rate = this.stretch ? 1F / (lifetime / frames) : this.fps;
+            final float clock = rate * age;
+            final float frame = (float) Math.copySign(Math.floor(Math.abs(clock) + .5D), clock);
+            return this.loop ? frame % frames : frame >= frames ? frames - 1 : frame;
+        }
+    }
+
+    record Direction(boolean custom, List<BedrockMolang.Program> vector, float thresholdSquared,
+                     boolean readUv, List<String> diagnostics) {
+        private static final float DEFAULT_THRESHOLD_SQUARED = .01F;
+
+        static Direction read(final JsonElement value) throws IOException {
+            final List<BedrockMolang.Program> zero = BedrockParticleEffect.vector(null, 3, 0);
+            if (value == null) return new Direction(false, zero, DEFAULT_THRESHOLD_SQUARED, true, List.of());
+            // Native JSON treats null as an empty object here, rather than an absent section.
+            if (!value.isJsonNull() && !value.isJsonObject())
+                return new Direction(false, zero, DEFAULT_THRESHOLD_SQUARED, false,
+                        List.of("Invalid particle direction section. Retained defaults and skipped UV settings."));
+            final JsonObject object = value.isJsonNull() ? new JsonObject() : value.getAsJsonObject();
+            final JsonElement declaredMode = object.get("mode");
+            final String mode = declaredMode != null && declaredMode.isJsonPrimitive() && declaredMode.getAsJsonPrimitive().isString()
+                    ? declaredMode.getAsString() : "derive_from_velocity";
+            if (mode.equals("derive_from_velocity")) {
+                final JsonElement speed = object.get("min_speed_threshold");
+                if (speed == null || speed.isJsonNull()) return new Direction(false, zero, 0, true, List.of());
+                if (!speed.isJsonPrimitive() || speed.getAsJsonPrimitive().isString())
+                    return new Direction(false, zero, 0, true, List.of("Particle speed threshold must be a number. Used zero."));
+                final float threshold = speed.getAsJsonPrimitive().isBoolean() ? (speed.getAsBoolean() ? 1 : 0) : speed.getAsFloat();
+                return new Direction(false, zero, threshold * threshold, true, List.of());
+            }
+            if (!mode.equals("custom"))
+                return new Direction(false, zero, DEFAULT_THRESHOLD_SQUARED, true,
+                        List.of("Unknown particle direction mode. Retained the default direction."));
+            if (!object.has("custom_direction"))
+                return new Direction(false, zero, DEFAULT_THRESHOLD_SQUARED, false,
+                        List.of("Custom particle direction is missing. Retained defaults and skipped UV settings."));
+            final JsonElement vector = object.get("custom_direction");
+            if (!vector.isJsonArray() || vector.getAsJsonArray().size() != 3)
+                return new Direction(true, zero, DEFAULT_THRESHOLD_SQUARED, true,
+                        List.of("Custom particle direction must have three components. Used the zero vector."));
+            final List<BedrockMolang.Program> programs = new ArrayList<>(3);
+            final List<String> diagnostics = new ArrayList<>();
+            for (final JsonElement axis : vector.getAsJsonArray()) {
+                if (!axis.isJsonPrimitive()) {
+                    diagnostics.add("Custom particle direction component " + programs.size() + " must be a number or Molang expression. Used zero.");
+                    programs.add(new BedrockMolang.Program(0, null));
+                } else if (axis.getAsJsonPrimitive().isBoolean()) {
+                    programs.add(new BedrockMolang.Program(axis.getAsBoolean() ? 1 : 0, null));
+                } else if (axis.getAsJsonPrimitive().isNumber()) {
+                    // Native numeric array fields retain their float value, including overflow.
+                    programs.add(new BedrockMolang.Program(axis.getAsFloat(), null));
+                } else {
+                    try {
+                        programs.add(BedrockMolang.Program.parse(axis, 0));
+                    } catch (ParseException invalid) {
+                        diagnostics.add("Could not parse custom particle direction component " + programs.size() + ". Used zero.");
+                        programs.add(new BedrockMolang.Program(0, null));
+                    }
+                }
+            }
+            return new Direction(true, List.copyOf(programs), DEFAULT_THRESHOLD_SQUARED, true, List.copyOf(diagnostics));
+        }
+
+        void sample(final BedrockMolang environment, final Vector3f velocity, final Vector3f previous) {
+            if (this.custom) previous.set(evaluated(this.vector, environment));
+            else if (velocity.lengthSquared() > this.thresholdSquared)
+                previous.set(velocity).mul(1F / (float) Math.sqrt(velocity.lengthSquared()));
+        }
+    }
+
+    record View(float width, float height, float u0, float v0, float u1, float v1) {}
+    private record Stop(float time, List<BedrockMolang.Program> color) {}
+    private record Tint(List<Stop> stops, BedrockMolang.Program interpolant) {
+        static Tint read(final JsonElement color) throws IOException {
+            final List<Stop> stops = new ArrayList<>();
+            if (color != null && color.isJsonObject()) {
+                final var object = color.getAsJsonObject();
+                final var gradient = object.get("gradient");
+                if (gradient == null) throw new IOException("Missing particle tint gradient");
+                if (gradient.isJsonArray()) {
+                    final var array = gradient.getAsJsonArray();
+                    if (array.isEmpty() || array.size() > 256) throw new IOException("Invalid particle tint gradient");
+                    for (int index = 0; index < array.size(); index++)
+                        stops.add(new Stop(array.size() == 1 ? 0 : (float) index / (array.size() - 1), color(array.get(index))));
+                } else {
+                    for (final var entry : gradient.getAsJsonObject().entrySet()) {
+                        final float time = Float.parseFloat(entry.getKey());
+                        if (!Float.isFinite(time) || stops.size() >= 256) throw new IOException("Invalid particle tint stop");
+                        stops.add(new Stop(time, color(entry.getValue())));
+                    }
+                }
+                if (stops.isEmpty()) throw new IOException("Empty particle tint gradient");
+                stops.sort(Comparator.comparingDouble(Stop::time));
+                return new Tint(List.copyOf(stops), program(object, "interpolant", 0));
+            }
+            return new Tint(List.of(new Stop(0, color(color))), null);
+        }
+
+        BedrockMolangColor sample(final BedrockMolang environment) {
+            final float time = environment.evaluate(this.interpolant, 0);
+            Stop before = this.stops.getFirst(), after = before;
+            for (final Stop stop : this.stops) {
+                after = stop;
+                if (stop.time >= time) break;
+                before = stop;
+            }
+            final float blend = after.time == before.time ? 0 : Math.clamp((time - before.time) / (after.time - before.time), 0, 1);
+            final float[] channels = new float[4];
+            for (int channel = 0; channel < 4; channel++) {
+                final float from = environment.evaluate(before.color.get(channel), 1);
+                final float to = before == after ? from : environment.evaluate(after.color.get(channel), 1);
+                channels[channel] = from + (to - from) * blend;
+            }
+            return new BedrockMolangColor(channels[0], channels[1], channels[2], channels[3]);
+        }
+
+        private static List<BedrockMolang.Program> color(final JsonElement value) throws IOException {
+            if (value == null) return vector(null, 4, 1);
+            if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                final String hex = value.getAsString();
+                if (!hex.matches("#[a-fA-F0-9]{6}(?:[a-fA-F0-9]{2})?")) throw new IOException("Invalid particle tint color");
+                final long packed = Long.parseLong(hex.substring(1), 16);
+                return List.of(constant((packed >>> 16 & 255) / 255F), constant((packed >>> 8 & 255) / 255F),
+                        constant((packed & 255) / 255F), constant(hex.length() == 7 ? 1 : (packed >>> 24 & 255) / 255F));
+            }
+            final var array = value.getAsJsonArray();
+            if (array.size() != 3 && array.size() != 4) throw new IOException("Invalid particle tint channels");
+            final List<BedrockMolang.Program> result = new ArrayList<>();
+            for (final JsonElement channel : array) result.add(BedrockMolang.Program.parse(channel, 1));
+            if (result.size() == 3) result.add(constant(1));
+            return List.copyOf(result);
+        }
+    }
+
+    static int manualCapacity(final float value) {
+        // Native converts through unsigned 64-bit before applying the 2,000-particle cap.
+        return !Float.isFinite(value) || value <= -1 || value >= 2000 ? 2000 : (int) value;
+    }
+    static int boundedCount(final float value, final int maximum) {
+        return Float.isFinite(value) ? (int) Math.clamp(value, 0, maximum) : 0;
+    }
+    private static void randomVariables(final BedrockMolang environment, final RandomGenerator random, final String prefix) {
+        for (int index = 1; index <= 4; index++) environment.variable(prefix + "_random_" + index, random.nextFloat());
+    }
+    static Vector3f evaluated(final List<BedrockMolang.Program> values, final BedrockMolang environment) {
+        return new Vector3f(environment.evaluate(values.get(0), 0), environment.evaluate(values.get(1), 0), environment.evaluate(values.get(2), 0));
+    }
+    static List<BedrockMolang.Program> vector(final JsonElement value, final int length, final float fallback) throws IOException {
+        final List<BedrockMolang.Program> result = new ArrayList<>();
+        if (value != null && (!value.isJsonArray() || value.getAsJsonArray().size() != length)) throw new IOException("Invalid particle vector");
+        for (int index = 0; index < length; index++) result.add(BedrockMolang.Program.parse(value == null ? null : value.getAsJsonArray().get(index), fallback));
+        return List.copyOf(result);
+    }
+    private static BedrockMolang.Program constant(final float value) { return new BedrockMolang.Program(value, null); }
+    static BedrockMolang.Program program(final JsonObject value, final String name, final float fallback) throws IOException {
+        return BedrockMolang.Program.parse(value.get(name), fallback);
+    }
+    static JsonObject object(final JsonObject value, final String name) {
+        return value.has("minecraft:" + name) ? value.getAsJsonObject("minecraft:" + name) : new JsonObject();
+    }
+    static boolean bool(final JsonObject value, final String name) { return value.has(name) && value.get(name).getAsBoolean(); }
+    private static float number(final JsonObject value, final String name, final float fallback) throws IOException {
+        final float result = value.has(name) ? value.get(name).getAsFloat() : fallback;
+        if (!Float.isFinite(result) || Math.abs(result) > 32768) throw new IOException("Invalid particle number");
+        return result;
+    }
+}
