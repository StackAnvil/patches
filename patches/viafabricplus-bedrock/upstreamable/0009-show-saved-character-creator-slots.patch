+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.Map;
+
+final class BedrockSoundFileTest {
+    @Test
+    void resolvesFormatsWithinTheHighestPackBeforeFallingBack() throws Exception {
+        final byte[] base = {1}, replacement = {2}, preferred = {3};
+        final var library = BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/sounds/sample.fsb", base,
+                "library/vanilla_base/sounds/sample.ogg", replacement,
+                "library/vanilla_base/sounds/dual.fsb", preferred,
+                "library/vanilla_base/sounds/dual.ogg", replacement));
+        assertSame(replacement, library.sound("sounds/sample"));
+        assertSame(preferred, library.sound("sounds/dual"));
+        assertSame(base, library.sound("sounds/sample.fsb"));
+        assertNull(library.sound("sounds/missing"));
+        for (final String path : new String[] {"sounds/../sample", "models/sample", "/sounds/sample"})
+            assertThrows(IOException.class, () -> library.sound(path));
+    }
+
+    @Test
+    void rejectsInvalidContainersAndDimensionsBeforeDecoding() {
+        assertThrows(IOException.class, () -> BedrockSoundFile.read(null));
+        final byte[] ogg = new byte[58];
+        final ByteBuffer data = ByteBuffer.wrap(ogg).order(ByteOrder.LITTLE_ENDIAN);
+        data.putInt(0, 0x5367674F).put(5, (byte) 2).put(26, (byte) 1).put(27, (byte) 30);
+        data.put(28, (byte) 1).putInt(29, 0x62726F76).putShort(33, (short) 0x7369);
+        data.put(39, (byte) 1).putInt(40, 48000).put(56, (byte) 0xB8).put(57, (byte) 1);
+        for (final int length : new int[] {0, 4, 26, 27, 28, 40, 57})
+            assertThrows(IOException.class, () -> BedrockSoundFile.read(Arrays.copyOf(ogg, length)));
+        for (final int offset : new int[] {4, 5, 26, 27, 28, 29, 33, 35, 39, 40, 56, 57}) {
+            final byte[] invalid = ogg.clone();
+            invalid[offset] = (byte) 255;
+            assertThrows(IOException.class, () -> BedrockSoundFile.read(invalid));
+        }
+        assertThrows(IOException.class, () -> BedrockSoundFile.read(ogg));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesIndependentVorbisSamplesAndResolvesLicensedEvents() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_SOUND_EVENTS"));
+        final var manifest = JsonParser.parseString(Files.readString(root.resolve("ogg-reference.json")))
+                .getAsJsonObject().getAsJsonArray("files");
+        for (final var row : manifest) {
+            final var expected = row.getAsJsonObject();
+            final byte[] encoded = Files.readAllBytes(root.resolve(expected.get("path").getAsString()));
+            final var audio = BedrockSoundFile.read(encoded);
+            assertEquals(expected.get("rate").getAsInt(), audio.sampleRate());
+            assertEquals(expected.get("channels").getAsInt(), audio.channels());
+            assertEquals(expected.get("samples").getAsInt(), audio.samples());
+            final ByteBuffer reference = ByteBuffer.wrap(Files.readAllBytes(
+                    root.resolve(expected.get("reference").getAsString()))).order(ByteOrder.LITTLE_ENDIAN);
+            final ByteBuffer pcm = ByteBuffer.wrap(audio.pcm()).order(ByteOrder.LITTLE_ENDIAN);
+            assertEquals(reference.remaining() / 2, pcm.remaining());
+            while (reference.hasRemaining()) {
+                final int sample = Math.clamp(Math.round(reference.getFloat() * 32768F), Short.MIN_VALUE, Short.MAX_VALUE);
+                assertTrue(Math.abs(sample - pcm.getShort()) <= 1, expected.get("path").getAsString());
+            }
+            assertEquals(0, audio.loopStart());
+            assertEquals(0, audio.loopEnd());
+            for (final int length : new int[] {encoded.length / 2, encoded.length - 1})
+                assertThrows(IOException.class, () -> BedrockSoundFile.read(Arrays.copyOf(encoded, length)));
+            final byte[] excessive = encoded.clone();
+            final ByteBuffer invalid = ByteBuffer.wrap(excessive).order(ByteOrder.LITTLE_ENDIAN);
+            int last = 0;
+            for (int cursor = 0; cursor < excessive.length;) {
+                last = cursor;
+                final int segments = Byte.toUnsignedInt(invalid.get(cursor + 26));
+                int next = cursor + 27 + segments;
+                for (int index = 0; index < segments; index++) next += Byte.toUnsignedInt(invalid.get(cursor + 27 + index));
+                cursor = next;
+            }
+            invalid.putLong(last + 6, Long.MAX_VALUE);
+            assertThrows(IOException.class, () -> BedrockSoundFile.read(excessive));
+        }
+        final var contents = BedrockBuiltinAssets.index("1.26.51.1",
+                BedrockBuiltinAssets.unpack(root.resolve("package-assets")));
+        int resolved = 0;
+        for (final var entry : contents.library().soundDefinitions().entrySet()) {
+            int draw = 0;
+            for (final var sample : entry.getValue().samples()) {
+                final int chosen = draw;
+                draw += sample.weight();
+                if (sample.weight() <= 0 || contents.library().file(sample.name() + ".ogg") == null) continue;
+                final var sound = contents.soundEvent(entry.getKey(), bound -> chosen, 2, 1, false);
+                assertNotNull(sound);
+                assertSame(sample, sound.selection().sample());
+                assertArrayEquals(contents.sound(sample.name() + ".ogg").pcm(), sound.audio().pcm());
+                resolved++;
+            }
+        }
+        assertTrue(resolved >= 3);
+    }
+}
