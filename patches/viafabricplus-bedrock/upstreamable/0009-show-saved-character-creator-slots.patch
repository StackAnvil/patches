+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import javax.imageio.ImageIO;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockPersonaAssemblerTest {
+    @Test
+    void combinesDifferentLoopsAndFiltersUnusedBodyVariants() throws Exception {
+        final var preview = new BedrockPersonaModel.Converted(new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB),
+            """
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":128,"texture_height":128},
+              "bones":[{"name":"root"},{"name":"leftarmarmor","parent":"root","cubes":[{}]}]}]}
+            """, "{\"geometry\":{\"default\":\"geometry.test\"}}", List.of());
+        final String metadata = """
+            {"geometry_sources":[
+              {"geometry":"geometry.left","texture":"first.png","animated":true,"frames":2,"arm_size":"wide","body_size":"medium"},
+              {"geometry":"geometry.right","texture":"second.png","animated":true,"frames":3,"arm_size":"wide","body_size":"medium"},
+              {"geometry":"geometry.unused","texture":"missing.png","animated":true,"frames":5,"arm_size":"slim","body_size":"medium"}]}
+            """;
+        final String geometry = """
+            {"format_version":"1.8.0",
+             "geometry.left":{"bones":[{"name":"leftArmArmor","parent":"root","cubes":[{"origin":[0,0,0],"size":[1,1,1],"uv":[0,0]}]}]},
+             "geometry.right":{"bones":[{"name":"rightArmArmor","parent":"root","cubes":[{"origin":[0,0,0],"size":[1,1,1],"uv":{"north":{"uv":[0,0],"uv_size":[1,1]}}}]}]}}
+            """;
+        final var pack = new BedrockPersonaAssets.Pack("pack", Map.of(
+            "piece.meta.json", metadata.getBytes(StandardCharsets.UTF_8),
+            "piece.geometry.json", geometry.getBytes(StandardCharsets.UTF_8),
+            "first.png", strip(2), "second.png", strip(3)));
+        final var slot = BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var result = BedrockPersonaAssembler.assemble(preview, slot, Map.of(pack.id(), pack));
+        final var animation = result.animations().getFirst();
+        assertEquals(6, animation.frames());
+        for (int frame = 0; frame < 6; frame++) {
+            assertEquals(0xFF000001 + frame % 2, animation.image().getRGB(0, frame * 128));
+            assertEquals(0xFF000001 + frame % 3, animation.image().getRGB(2, frame * 128));
+        }
+        final var models = JsonParser.parseString(result.geometry()).getAsJsonObject().getAsJsonArray("minecraft:geometry");
+        assertFalse(models.get(0).getAsJsonObject().getAsJsonArray("bones").get(1).getAsJsonObject().has("cubes"));
+        final var bones = models.get(1).getAsJsonObject().getAsJsonArray("bones");
+        final JsonObject right = bones.get(2).getAsJsonObject().getAsJsonArray("cubes").get(0).getAsJsonObject();
+        assertEquals(2, right.getAsJsonObject("uv").getAsJsonObject("north").getAsJsonArray("uv").get(0).getAsInt());
+        final JsonObject rightRecipe = slot.profile().deepCopy();
+        final JsonObject arm = new JsonObject();
+        arm.addProperty("id", pack.id() + "/r");
+        rightRecipe.getAsJsonObject("personaCollection").getAsJsonArray("universalApp").add(arm);
+        final var rightSlot = new BedrockCharacterProfiles.Slot(slot.number(), slot.arm(), slot.skinColor(),
+            java.util.stream.Stream.concat(slot.pieceIds().stream(), java.util.stream.Stream.of(pack.id() + "/r")).toList(),
+            slot.profileHash(), rightRecipe);
+        final var rightOnly = BedrockPersonaAssembler.assemble(preview, rightSlot, Map.of(pack.id(), pack));
+        final var rightModels = JsonParser.parseString(rightOnly.geometry()).getAsJsonObject().getAsJsonArray("minecraft:geometry");
+        assertTrue(rightModels.get(0).getAsJsonObject().getAsJsonArray("bones").get(1).getAsJsonObject().has("cubes"));
+        final var rightBones = rightModels.get(1).getAsJsonObject().getAsJsonArray("bones");
+        assertFalse(rightBones.get(1).getAsJsonObject().has("cubes"));
+        assertTrue(rightBones.get(2).getAsJsonObject().has("cubes"));
+        assertTrue(JsonParser.parseString(preview.geometry()).getAsJsonObject().getAsJsonArray("minecraft:geometry")
+            .get(0).getAsJsonObject().getAsJsonArray("bones").get(1).getAsJsonObject().has("cubes"));
+    }
+
+    private static byte[] strip(final int frames) throws Exception {
+        final BufferedImage image = new BufferedImage(2, frames * 2, BufferedImage.TYPE_INT_ARGB);
+        for (int frame = 0; frame < frames; frame++) image.setRGB(0, frame * 2, 0xFF000001 + frame);
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
+}
