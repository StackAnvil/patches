+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockEmotePlayback;
+
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.components.Tooltip;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.input.KeyEvent;
+import net.minecraft.network.chat.Component;
+
+import org.jspecify.annotations.NonNull;
+
+/** Four native wheel positions, available by mouse or the 1-4 keys. */
+public final class BedrockEmoteWheelScreen extends Screen {
+    private final Button[] slots = new Button[4];
+
+    public BedrockEmoteWheelScreen() {
+        super(Component.translatable("bedrock_emote.viafabricplus.wheel"));
+    }
+
+    @Override
+    protected void init() {
+        BedrockEmotePlayback.refresh();
+        final int slotWidth = Math.min(110, (this.width - 32) / 3 - 4);
+        final int slotHeight = Math.max(32, Math.min(70, (this.height - 90) / 3 - 4));
+        final int centerX = this.width / 2;
+        final int centerY = this.height / 2 - 10;
+        final int[] x = {0, 1, 0, -1}, y = {-1, 0, 1, 0};
+        for (int index = 0; index < 4; index++) {
+            final int slot = index;
+            this.slots[index] =
+                    this.addRenderableWidget(
+                            Button.builder(Component.empty(), _ -> BedrockEmotePlayback.play(slot))
+                                    .bounds(
+                                            centerX + x[index] * (slotWidth + 4) - slotWidth / 2,
+                                            centerY + y[index] * (slotHeight + 4) - slotHeight / 2,
+                                            slotWidth,
+                                            slotHeight)
+                                    .build());
+        }
+        this.addRenderableWidget(
+                Button.builder(
+                                Component.translatable("bedrock_emote.viafabricplus.change"),
+                                _ ->
+                                        new BedrockCharacterSlotsScreen(
+                                                        com.viaversion.viafabricplus.bedrock
+                                                                .appearance.BedrockCharacterProfiles
+                                                                .Category.EMOTES)
+                                                .open(this))
+                        .bounds(centerX - 80, this.height - 28, 160, 20)
+                        .build());
+        this.tick();
+    }
+
+    @Override
+    public void tick() {
+        final var names = BedrockEmotePlayback.wheelNames();
+        for (int index = 0; index < 4; index++) {
+            this.slots[index].setMessage(
+                    Component.translatable(
+                            "bedrock_emote.viafabricplus.position",
+                            index + 1,
+                            names.get(index).isBlank()
+                                    ? Component.translatable(
+                                            "bedrock_emote.viafabricplus.unassigned")
+                                    : Component.literal(names.get(index))));
+            this.slots[index].active = BedrockEmotePlayback.ready(index);
+            this.slots[index].setTooltip(
+                    BedrockEmotePlayback.unavailable(index)
+                            ? Tooltip.create(
+                                    Component.translatable(
+                                            "bedrock_emote.viafabricplus.unavailable"))
+                            : null);
+        }
+    }
+
+    @Override
+    public boolean keyPressed(final @NonNull KeyEvent event) {
+        if (BedrockEmotePlayback.KEY.matches(event)) {
+            this.onClose();
+            return true;
+        }
+        if (event.key() >= InputConstants.KEY_1 && event.key() <= InputConstants.KEY_4) {
+            BedrockEmotePlayback.play(event.key() - InputConstants.KEY_1);
+            return true;
+        }
+        return super.keyPressed(event);
+    }
+
+    @Override
+    public void extractRenderState(
+            final @NonNull GuiGraphicsExtractor graphics,
+            final int mouseX,
+            final int mouseY,
+            final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        graphics.centeredText(this.font, this.title, this.width / 2, 12, -1);
+        final String status =
+                BedrockEmotePlayback.failed()
+                        ? "bedrock_emote.viafabricplus.failed"
+                        : BedrockEmotePlayback.loading()
+                                ? "bedrock_emote.viafabricplus.loading"
+                                : null;
+        if (status != null)
+            graphics.centeredText(
+                    this.font,
+                    Component.translatable(status),
+                    this.width / 2,
+                    this.height - 42,
+                    -1);
+    }
+
+    @Override
+    public boolean isPauseScreen() {
+        return false;
+    }
+}
