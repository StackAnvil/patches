@@ -0,0 +1,177 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.Locale;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Installs the helper embedded in this add-on and communicates without passing secrets as
+ * arguments.
+ */
+final class BedrockPackageHelper {
+    private BedrockPackageHelper() {}
+
+    static Path install(final Path root) throws IOException {
+        final String os = System.getProperty("os.name").toLowerCase(Locale.ROOT);
+        final String platform =
+                os.contains("win")
+                        ? "windows"
+                        : os.contains("mac")
+                                ? "macos"
+                                : os.contains("linux") ? "linux" : "unsupported";
+        final String arch =
+                switch (System.getProperty("os.arch").toLowerCase(Locale.ROOT)) {
+                    case "amd64", "x86_64" -> "x86_64";
+                    case "aarch64", "arm64" -> "aarch64";
+                    default -> "unsupported";
+                };
+        final String name = "persona-assets"
+                + (platform.equals("windows") ? ".exe" : "");
+        final String resource =
+                "/assets/viafabricplus-bedrock/native/" + platform + "-" + arch + "/" + name;
+        final byte[] bytes = BedrockBuiltinAssets.resource(resource);
+        final String digest =
+                new String(
+                                BedrockBuiltinAssets.resource(resource + ".sha256"),
+                                StandardCharsets.US_ASCII)
+                        .strip();
+        if (!BedrockBuiltinAssets.hash(bytes).equals(digest))
+            throw new IOException("The bundled package helper failed its checksum check");
+        final Path directory = root.resolve(digest);
+        Files.createDirectories(directory);
+        final Path executable = directory.resolve(name);
+        if (!Files.isRegularFile(executable)
+                || !BedrockBuiltinAssets.hash(Files.readAllBytes(executable)).equals(digest)) {
+            final Path temporary = Files.createTempFile(directory, ".helper-", ".tmp");
+            try {
+                Files.write(temporary, bytes);
+                Files.move(
+                        temporary,
+                        executable,
+                        StandardCopyOption.ATOMIC_MOVE,
+                        StandardCopyOption.REPLACE_EXISTING);
+            } finally {
+                Files.deleteIfExists(temporary);
+            }
+        }
+        if (!platform.equals("windows") && !executable.toFile().setExecutable(true, true))
+            throw new IOException("Could not make the package helper executable");
+        return executable;
+    }
+
+    static void acquire(final Path executable, final JsonObject request) throws Exception {
+        final Process process = new ProcessBuilder(executable.toAbsolutePath().toString()).redirectErrorStream(true).start();
+        exchange(process, request);
+    }
+
+    static void exchange(final Process process, final JsonObject request) throws Exception {
+        final Thread shutdown = Thread.ofPlatform().unstarted(() -> terminate(process));
+        Runtime.getRuntime().addShutdownHook(shutdown);
+        final CompletableFuture<Receipt> receipt = new CompletableFuture<>();
+        Thread.ofVirtual()
+                .start(
+                        () -> {
+                            try (InputStream input = process.getInputStream()) {
+                                receipt.complete(readReceipt(input));
+                            } catch (IOException e) {
+                                receipt.completeExceptionally(e);
+                            }
+                        });
+        try {
+            IOException writeFailure = null;
+            try (var input = process.getOutputStream()) {
+                input.write(request.toString().getBytes(StandardCharsets.UTF_8));
+            } catch (IOException e) {
+                // A linker or sandbox failure can close stdin before the request arrives.
+                // Collect its exit and receipt so a broken pipe does not hide the cause.
+                writeFailure = e;
+            }
+            if (!process.waitFor(20, TimeUnit.MINUTES))
+                throw new IOException("The built-in asset download timed out");
+            final Receipt result = receipt.get(10, TimeUnit.SECONDS);
+            if (result == null) {
+                throw new IOException("The bundled asset helper could not start. Check its system dependencies.");
+            }
+            if (result.signInRequired())
+                throw new StoreSignInRequiredException();
+            if (process.exitValue() != 0 || !result.success() || writeFailure != null)
+                throw new IOException(
+                        "Could not acquire built-in assets. Sign in with the selected account and"
+                                + " check that it owns Minecraft for Windows.", writeFailure);
+        } finally {
+            try {
+                Runtime.getRuntime().removeShutdownHook(shutdown);
+            } catch (IllegalStateException ignored) {
+                // JVM shutdown already runs the hook.
+            }
+            terminate(process);
+        }
+    }
+
+    private static void terminate(final Process process) {
+        if (process.isAlive()) {
+            process.descendants().forEach(ProcessHandle::destroy);
+            process.destroyForcibly();
+        }
+    }
+
+    private static Receipt readReceipt(final InputStream input) throws IOException {
+        final byte[] line = new byte[16384];
+        int length = 0;
+        boolean oversized = false;
+        Receipt receipt = null;
+        int value;
+        while ((value = input.read()) != -1) {
+            if (value == '\n') {
+                if (!oversized) receipt = parseReceipt(line, length, receipt);
+                length = 0;
+                oversized = false;
+            } else if (length < line.length) {
+                line[length++] = (byte) value;
+            } else {
+                oversized = true;
+            }
+        }
+        return oversized ? receipt : parseReceipt(line, length, receipt);
+    }
+
+    private static Receipt parseReceipt(final byte[] line, final int length, final Receipt previous) {
+        if (length == 0 || line[0] != '{') return previous;
+        try {
+            final var result = JsonParser.parseString(new String(line, 0, length, StandardCharsets.UTF_8));
+            if (!result.isJsonObject()) return previous;
+            final var success = result.getAsJsonObject().get("ok");
+            if (success != null && success.isJsonPrimitive() && success.getAsJsonPrimitive().isBoolean()) {
+                final var error = result.getAsJsonObject().get("error");
+                return new Receipt(success.getAsBoolean(), !success.getAsBoolean() && error != null
+                        && error.isJsonPrimitive() && error.getAsJsonPrimitive().isString()
+                        && "interactive_sign_in_required".equals(error.getAsString()));
+            }
+        } catch (RuntimeException ignored) {
+            /* Discard diagnostics without exposing credentials in logs or the UI. */
+        }
+        return previous;
+    }
+
+    private record Receipt(boolean success, boolean signInRequired) {}
+
+    static final class StoreSignInRequiredException extends IOException {
+        StoreSignInRequiredException() {
+            super("Microsoft Store sign-in is required to download these built-in assets.");
+        }
+    }
+}
