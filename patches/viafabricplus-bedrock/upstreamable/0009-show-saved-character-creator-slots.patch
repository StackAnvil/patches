+    public record PreparedClassicCharacter(Slot slot, BedrockClassicSkinPack pack,
+                                           BedrockClassicSkinPack.Skin skin) implements PreparedCharacter {
+        @Override
+        public BedrockAppearanceStore.Appearance importInto(final BedrockAppearanceStore store, final String accountId) throws IOException {
+            return store.importPackSkin(accountId, this.pack, this.skin, this.slot.classicSlim());
