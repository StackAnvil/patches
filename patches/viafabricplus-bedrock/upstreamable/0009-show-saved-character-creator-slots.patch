+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.connection.UserConnection;
+
+import net.minecraft.client.Minecraft;
+import net.raphimc.viabedrock.protocol.provider.EmoteProvider;
+
+import java.util.UUID;
+
+public final class ViaFabricPlusEmoteProvider extends EmoteProvider {
+    @Override
+    public boolean isEmoting(final UserConnection user) {
+        return BedrockEmotePlayback.isLocalEmoting(user);
+    }
+
+    @Override
+    public void play(
+            final UserConnection user,
+            final UUID player,
+            final UUID emote,
+            final long lengthTicks,
+            final int flags) {
+        Minecraft.getInstance()
+                .execute(() -> BedrockEmotePlayback.receive(user, player, emote, lengthTicks));
+    }
+
+    @Override
+    public void setAvailable(final UserConnection user, final UUID player, final UUID[] emotes) {
+        final UUID[] copy = emotes.clone();
+        Minecraft.getInstance().execute(() -> BedrockEmotePlayback.available(user, player, copy));
+    }
+}
