@@ -0,0 +1,94 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.client.sounds.JOrbisAudioStream;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Decodes licensed samples without an audio device or an external converter. */
+final class BedrockSoundFile {
+    private BedrockSoundFile() {}
+
+    static BedrockSoundBank.Audio read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length < 4 || bytes.length > BedrockBuiltinAssets.MAX_FILE_BYTES)
+            throw new IOException("Missing or oversized Bedrock sound file");
+        final ByteBuffer data = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        return switch (data.getInt(0)) {
+            case 0x35425346 -> BedrockSoundBank.read(bytes);
+            case 0x5367674F -> vorbis(bytes, data);
+            default -> throw new IOException("Unsupported Bedrock sound file format");
+        };
+    }
+
+    private static BedrockSoundBank.Audio vorbis(final byte[] bytes, final ByteBuffer data)
+            throws IOException {
+        // Check dimensions before JOrbis allocates its channel buffers. Check every page
+        // and the final granule before allocating PCM, so truncation cannot become silence.
+        final int first = pageEnd(data, 0);
+        final int header = 27 + Byte.toUnsignedInt(data.get(26));
+        if (data.get(5) != 2 || first - header < 30 || data.get(header) != 1
+                || data.getInt(header + 1) != 0x62726F76 || data.getShort(header + 5) != 0x7369
+                || data.getInt(header + 7) != 0 || (data.get(header + 29) & 1) == 0)
+            throw new IOException("Invalid Bedrock Vorbis identification header");
+        final int channels = Byte.toUnsignedInt(data.get(header + 11));
+        final int rate = data.getInt(header + 12);
+        final int blocks = Byte.toUnsignedInt(data.get(header + 28));
+        if (channels < 1 || channels > 2 || rate < 1000 || rate > 192000
+                || (blocks & 15) < 6 || (blocks >>> 4) > 13 || (blocks & 15) > (blocks >>> 4))
+            throw new IOException("Unsupported Bedrock Vorbis dimensions");
+        final int serial = data.getInt(14);
+        long samples = -1;
+        int sequence = data.getInt(18);
+        for (int cursor = 0; cursor < bytes.length; sequence++) {
+            final int end = pageEnd(data, cursor);
+            final int flags = Byte.toUnsignedInt(data.get(cursor + 5));
+            if (data.getInt(cursor + 14) != serial || data.getInt(cursor + 18) != sequence
+                    || (flags & ~7) != 0 || cursor != 0 && (flags & 2) != 0
+                    || (flags & 4) != 0 && end != bytes.length)
+                throw new IOException("Invalid Bedrock Vorbis page sequence");
+            if (end == bytes.length) {
+                if ((flags & 4) == 0)
+                    throw new IOException("Truncated Bedrock Vorbis stream");
+                samples = data.getLong(cursor + 6);
+            }
+            cursor = end;
+        }
+        final long size = samples * channels * 2;
+        if (samples <= 0 || samples > BedrockSoundBank.MAX_PCM_BYTES / (channels * 2)
+                || size > BedrockSoundBank.MAX_PCM_BYTES)
+            throw new IOException("Invalid Bedrock Vorbis sample count");
+        final ByteBuffer pcm = ByteBuffer.allocate((int) size).order(ByteOrder.LITTLE_ENDIAN);
+        try (final var stream = new JOrbisAudioStream(new ByteArrayInputStream(bytes))) {
+            if (stream.getFormat().getChannels() != channels || stream.getFormat().getSampleRate() != rate)
+                throw new IOException("Inconsistent Bedrock Vorbis format");
+            while (stream.readChunk(sample -> {
+                if (!Float.isFinite(sample)) throw new IllegalArgumentException("Non-finite Vorbis sample");
+                pcm.putShort((short) Math.clamp(Math.round(sample * 32768F), Short.MIN_VALUE, Short.MAX_VALUE));
+            })) { /* JOrbis advances through the bounded input one packet at a time. */ }
+            if (pcm.hasRemaining()) throw new IOException("Incomplete Bedrock Vorbis samples");
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid Bedrock Vorbis stream", invalid);
+        }
+        return new BedrockSoundBank.Audio(pcm.array(), rate, channels, (int) samples, 0, 0);
+    }
+
+    private static int pageEnd(final ByteBuffer data, final int cursor) throws IOException {
+        if ((long) cursor + 27 > data.limit() || data.getInt(cursor) != 0x5367674F
+                || data.get(cursor + 4) != 0)
+            throw new IOException("Invalid Bedrock Ogg page header");
+        final int segments = Byte.toUnsignedInt(data.get(cursor + 26));
+        int end = cursor + 27 + segments;
+        if (end > data.limit()) throw new IOException("Truncated Bedrock Ogg segment table");
+        for (int index = 0; index < segments; index++)
+            end += Byte.toUnsignedInt(data.get(cursor + 27 + index));
+        if (end > data.limit()) throw new IOException("Truncated Bedrock Ogg page");
+        return end;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockSoundPlayback.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockSoundPlayback.java
