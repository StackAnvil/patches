+                        .asList()
+                        .stream()
+                        .map(entry -> entry.getAsJsonObject())
+                        .filter(entry -> entry.has("id"))
+                        .map(entry -> entry.get("id").getAsString())
+                        .toList();
+        return new BedrockCharacterProfiles.Slot(1, arm, color, ids, "test-profile", profile);
+    }
+
+    static Map<String, JsonObject> bones(final BedrockPersonaModel.Converted model) {
+        final Map<String, JsonObject> result = new LinkedHashMap<>();
+        for (final var bone :
+                JsonParser.parseString(model.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")) {
+            final var node = bone.getAsJsonObject();
+            result.put(node.get("name").getAsString(), node);
+        }
+        return result;
+    }
+
+    private static void parse(final BedrockPersonaModel.Converted model) {
+        org.cube.converter.model.impl.bedrock.BedrockGeometryModel.fromJson(
+                com.viaversion.viaversion.libs.gson.JsonParser.parseString(model.geometry())
+                        .getAsJsonObject());
+    }
+
+    private static BedrockMarketplaceAssets.Pack pack(
+            final String id,
+            final String meta,
+            final String geometry,
+            final Map<String, byte[]> files) {
+        final Map<String, byte[]> result = new LinkedHashMap<>(files);
+        result.put("piece.meta.json", meta.getBytes(StandardCharsets.UTF_8));
+        result.put("piece.geometry.json", geometry.getBytes(StandardCharsets.UTF_8));
+        return new BedrockMarketplaceAssets.Pack(id, result);
+    }
