+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+
+/** Emitter lifecycle and distance events use the same cached world position and velocity. */
+record BedrockEmitterEvents(BedrockParticleLifetimeEvents lifetime, List<Distance> travel, List<Distance> looping) {
+    static BedrockEmitterEvents read(final JsonObject value) throws IOException {
+        final var lifetime = BedrockParticleLifetimeEvents.read(value, Set.of("creation_event", "expiration_event", "timeline",
+                "travel_distance_events", "looping_travel_distance_events"));
+        final List<Distance> travel = new ArrayList<>(), looping = new ArrayList<>();
+        if (value.has("travel_distance_events")) {
+            final var entries = value.get("travel_distance_events");
+            if (!entries.isJsonObject() || entries.getAsJsonObject().size() > 256)
+                throw new IOException("Invalid emitter travel events");
+            for (final var entry : new TreeMap<>(entries.getAsJsonObject().asMap()).entrySet())
+                travel.add(new Distance(distance(entry.getKey()), BedrockParticleLifetimeEvents.names(entry.getValue())));
+        }
+        if (value.has("looping_travel_distance_events")) {
+            final var entries = value.get("looping_travel_distance_events");
+            if (!entries.isJsonArray() || entries.getAsJsonArray().size() > 256)
+                throw new IOException("Invalid repeating emitter travel events");
+            for (final JsonElement entry : entries.getAsJsonArray()) {
+                if (!entry.isJsonObject()) throw new IOException("Invalid repeating emitter travel event");
+                final var event = entry.getAsJsonObject();
+                if (!event.has("distance") || !event.get("distance").isJsonPrimitive()
+                        || !event.getAsJsonPrimitive("distance").isNumber())
+                    throw new IOException("Invalid repeating emitter travel distance");
+                looping.add(new Distance(distance(event.get("distance").getAsString()), BedrockParticleLifetimeEvents.names(event.get("effects"))));
+            }
+        }
+        return new BedrockEmitterEvents(lifetime, List.copyOf(travel), List.copyOf(looping));
+    }
+
+    void travel(final float previous, final float current, final boolean expired, final Consumer<List<String>> sink) {
+        if (expired) return;
+        for (final Distance event : this.travel)
+            if (previous <= event.distance && event.distance < current) sink.accept(event.names);
+        // Native dispatches each repeating event once, even when several intervals are crossed.
+        for (final Distance event : this.looping) {
+            final float before = floor(previous / event.distance), after = floor(current / event.distance);
+            if (Math.abs(before - after) >= Math.ulp(1F)) sink.accept(event.names);
+        }
+    }
+
+    private static float distance(final String value) throws IOException {
+        try {
+            final float distance = Float.parseFloat(value);
+            if (Float.isFinite(distance) && Math.abs(distance) <= 1_000_000) return distance;
+        } catch (NumberFormatException invalid) { throw new IOException("Invalid emitter event distance", invalid); }
+        throw new IOException("Invalid emitter event distance");
+    }
+
+    private static float floor(final float value) {
+        final int integer = !Float.isFinite(value) || value >= 0x1p31F || value < -0x1p31F ? Integer.MIN_VALUE : (int) value;
+        return (float) (integer - ((float) integer > value ? 1 : 0));
+    }
+
+    record Distance(float distance, List<String> names) {
+        Distance { names = List.copyOf(names); }
+    }
+}
