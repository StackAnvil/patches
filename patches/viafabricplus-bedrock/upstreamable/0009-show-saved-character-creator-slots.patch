+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+import net.raphimc.viabedrock.protocol.types.primitive.ImageType;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+
+import javax.imageio.ImageIO;
+
+/** Stores animation strips as PNGs while supplying the native RGBA client claims. */
+final class BedrockPersonaAnimations {
+    private BedrockPersonaAnimations() {}
+
+    static JsonArray write(final List<AnimationData> animations) throws IOException {
+        final JsonArray result = new JsonArray();
+        for (final var animation : animations) {
+            validate(animation);
+            final ByteArrayOutputStream output = new ByteArrayOutputStream();
+            ImageIO.write(animation.image(), "png", output);
+            final JsonObject entry = new JsonObject();
+            entry.addProperty("image", Base64.getEncoder().encodeToString(output.toByteArray()));
+            entry.addProperty("type", animation.type());
+            entry.addProperty("frames", animation.frames());
+            entry.addProperty("expression", animation.expression());
+            result.add(entry);
+        }
+        return result;
+    }
+
+    static List<AnimationData> read(final JsonArray json) throws IOException {
+        if (json == null) return List.of();
+        if (json.size() > 3) throw new IOException("The character has too many animation surfaces");
+        final List<AnimationData> result = new ArrayList<>();
+        for (final var element : json) {
+            final JsonObject entry = element.getAsJsonObject();
+            final byte[] bytes = Base64.getDecoder().decode(entry.get("image").getAsString());
+            final BufferedImage image = image(bytes);
+            final AnimationData animation =
+                    new AnimationData(
+                            image,
+                            entry.get("type").getAsInt(),
+                            entry.get("frames").getAsFloat(),
+                            entry.get("expression").getAsInt());
+            validate(animation);
+            result.add(animation);
+        }
+        return List.copyOf(result);
+    }
+
+    static BufferedImage image(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("The animation image is missing or too large");
+        try (final var stream = ImageIO.createImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(stream);
+            if (!readers.hasNext()) throw new IOException("The animation image is invalid");
+            final var reader = readers.next();
+            try {
+                reader.setInput(stream);
+                final int width = reader.getWidth(0);
+                final int height = reader.getHeight(0);
+                if (width < 1
+                        || height < 1
+                        || width > 1024
+                        || height > 32768
+                        || (long) width * height > 4 * 1024 * 1024) {
+                    throw new IOException("The animation image dimensions are invalid");
+                }
+                return reader.read(0);
+            } finally {
+                reader.dispose();
+            }
+        }
+    }
+
+    static List<Map<String, Object>> claims(final List<AnimationData> animations) {
+        return animations.stream()
+                .map(
+                        animation ->
+                                Map.<String, Object>of(
+                                        "Image",
+                                        Base64.getEncoder()
+                                                .encodeToString(
+                                                        ImageType.getImageData(animation.image())),
+                                        "ImageWidth",
+                                        animation.image().getWidth(),
+                                        "ImageHeight",
+                                        animation.image().getHeight(),
+                                        "Type",
+                                        animation.type(),
+                                        "Frames",
+                                        animation.frames(),
+                                        "AnimationExpression",
+                                        animation.expression()))
+                .toList();
+    }
+
+    private static void validate(final AnimationData animation) throws IOException {
+        final BufferedImage image = animation.image();
+        if (image == null
+                || animation.type() < 1
+                || animation.type() > 3
+                || animation.frames() < 1
+                || animation.frames() > 256
+                || animation.frames() != Math.floor(animation.frames())
+                || image.getWidth() < 1
+                || image.getWidth() > 1024
+                || image.getHeight() < 1
+                || (long) image.getWidth() * image.getHeight() > 4 * 1024 * 1024
+                || image.getHeight() % (int) animation.frames() != 0) {
+            throw new IOException("The character animation strip is invalid");
+        }
+    }
+}
