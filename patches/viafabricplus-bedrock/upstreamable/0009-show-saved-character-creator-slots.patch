@@ -0,0 +1,438 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+
+import net.raphimc.viabedrock.api.util.MoLangEngine;
+import net.raphimc.viabedrock.api.util.MoLangMath;
+
+import net.raphimc.viabedrock.api.model.MolangVariables;
+import org.redlance.mocha.runtime.MolangInterpreter;
+import org.redlance.mocha.parser.ast.AccessExpression;
+import org.redlance.mocha.parser.ast.ArrayAccessExpression;
+import org.redlance.mocha.parser.ast.BinaryExpression;
+import org.redlance.mocha.parser.ast.CallExpression;
+import org.redlance.mocha.parser.ast.FloatExpression;
+import org.redlance.mocha.parser.ast.ExecutionScopeExpression;
+import org.redlance.mocha.parser.ast.Expression;
+import org.redlance.mocha.parser.ast.IdentifierExpression;
+import org.redlance.mocha.parser.ast.StatementExpression;
+import org.redlance.mocha.parser.ast.StringExpression;
+import org.redlance.mocha.parser.ast.TernaryConditionalExpression;
+import org.redlance.mocha.parser.ast.UnaryExpression;
+import org.redlance.mocha.runtime.value.Function;
+import org.redlance.mocha.runtime.value.MutableObjectBinding;
+import org.redlance.mocha.runtime.value.NumberValue;
+import org.redlance.mocha.runtime.value.ObjectProperty;
+import org.redlance.mocha.runtime.value.ObjectValue;
+import org.redlance.mocha.runtime.value.Value;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/** Actor-local variables and frame queries for parsed Molang expressions. */
+final class BedrockMolang {
+    private final MolangInterpreter<?> engine = MolangInterpreter.standard();
+    private Map<String, ?> queries = Map.of();
+    private final BedrockMolangVariables variables = new BedrockMolangVariables();
+    private float time, elapsed, delta;
+    private int iterations;
+
+    BedrockMolang() {
+        this.engine
+                .scope()
+                .set(
+                        "math",
+                        MoLangMath.extend((ObjectValue) this.engine.scope().get("math")));
+        final ObjectValue query =
+                name ->
+                        ObjectProperty.property(
+                                (Function<Object>)
+                                        (_, arguments) -> {
+                                            final List<Object> values = new ArrayList<>();
+                                            for (int index = 0;
+                                                    index < arguments.length();
+                                                    index++) {
+                                                final Value value = arguments.next().eval();
+                                                values.add(
+                                                        value != null && value.isString()
+                                                                ? value.getAsString()
+                                                                : value == null
+                                                                        ? 0D
+                                                                        : value.getAsNumber());
+                                            }
+                                            final Object supplied = this.queries.get(name);
+                                            if (supplied
+                                                    instanceof BedrockActorAnimation.Query function)
+                                                return Value.of(
+                                                        function.evaluate(List.copyOf(values)));
+                                            return Value.of(
+                                                    switch (name) {
+                                                        case "anim_time" -> this.time;
+                                                        case "life_time" ->
+                                                                supplied == null
+                                                                        ? this.elapsed
+                                                                        : supplied;
+                                                        case "delta_time" -> this.delta;
+                                                        case "spellcolor" -> supplied == null ? BedrockMolangColor.ZERO : supplied;
+                                                        default -> supplied == null ? 0F : supplied;
+                                                    });
+                                        },
+                                true);
+        this.engine.scope().set("query", query);
+        this.engine.scope().set("q", query);
+        this.engine.scope().set("variable", this.variables);
+        this.engine.scope().set("v", this.variables);
+        this.engine
+                .scope()
+                .set(
+                        "stackanvil_equal",
+                        (Function<Object>)
+                                (_, arguments) -> {
+                                    final Value first = arguments.next().eval(),
+                                            second = arguments.next().eval();
+                                    final boolean equal =
+                                            first != null
+                                                    && second != null
+                                                    && (first.isString() || second.isString()
+                                                            ? first.isString()
+                                                                    && second.isString()
+                                                                    && first.getAsString()
+                                                                            .equals(
+                                                                                    second
+                                                                                            .getAsString())
+                                                            : first.getAsNumber()
+                                                                    == second.getAsNumber());
+                                    return Value.of(equal);
+                                });
+        this.engine
+                .scope()
+                .set(
+                        "stackanvil_iteration",
+                        (Function<Object>)
+                                (_, _) -> {
+                                    if (++this.iterations > 16384) throw new EvaluationLimit();
+                                    return NumberValue.zero();
+                                });
+    }
+
+    BedrockMolang copy() {
+        final BedrockMolang copy = new BedrockMolang();
+        copy.variables.setAllFrom(this.variables);
+        copy.queries = Map.copyOf(this.queries);
+        copy.time = this.time;
+        copy.elapsed = this.elapsed;
+        copy.delta = this.delta;
+        return copy;
+    }
+
+    void queries(
+            final Map<String, ?> queries,
+            final float time,
+            final float elapsed,
+            final float delta) {
+        this.queries = queries;
+        this.time = time;
+        this.elapsed = elapsed;
+        this.delta = delta;
+    }
+
+    void queries(final Map<String, ?> queries) { this.queries = queries; }
+
+    void addQueries(final Map<String, ?> queries) {
+        final Map<String, Object> merged = new HashMap<>(this.queries);
+        merged.putAll(queries);
+        this.queries = Map.copyOf(merged);
+    }
+
+    /** Advances particle clocks while retaining the captured actor query bindings. */
+    void clock(final float time, final float elapsed, final float delta) {
+        this.time = time;
+        this.elapsed = elapsed;
+        this.delta = delta;
+    }
+
+    void variables(final Map<String, Float> values) {
+        values.forEach((name, value) -> this.variables.set(name, NumberValue.of(value)));
+    }
+
+    void variables(final MolangVariables values) {
+        this.variables.apply(values);
+    }
+
+    void variable(final String name, final float value) {
+        this.variables.set(name, NumberValue.of(value));
+    }
+
+    void binding(final String name, final Map<String, ?> values) {
+        final MutableObjectBinding binding = new MutableObjectBinding();
+        values.forEach((key, value) -> binding.set(key.toLowerCase(java.util.Locale.ROOT), Value.of(value)));
+        this.engine.scope().set(name, binding);
+    }
+
+    void context(final Map<String, ?> values) {
+        this.binding("context", values);
+        this.engine.scope().set("c", this.engine.scope().get("context"));
+    }
+
+    Value value(final Program program) {
+        this.iterations = 0;
+        try {
+            return program.expressions() == null
+                    ? NumberValue.of(program.constant())
+                    : MoLangEngine.eval(this.engine.scope(), program.expressions());
+        } catch (EvaluationLimit e) {
+            return NumberValue.zero();
+        }
+    }
+
+    Map<String, Value> saveVariables(final Set<String> names) {
+        final Map<String, Value> saved = new HashMap<>();
+        for (final String name : names) {
+            final ObjectProperty property = this.variables.getProperty(name);
+            saved.put(name, property == null ? null : property.value());
+        }
+        return saved;
+    }
+
+    void restoreVariables(final Map<String, Value> saved) {
+        saved.forEach(this.variables::set);
+    }
+
+    float evaluate(final Program program, final float current) {
+        if (program == null) return current;
+        if (program.expressions() == null) return program.constant();
+        this.engine.scope().set("this", NumberValue.of(current));
+        this.iterations = 0;
+        final float value;
+        try {
+            value = this.engine.eval(program.expressions());
+        } catch (EvaluationLimit e) {
+            return 0;
+        }
+        // Native Molang converts bad arithmetic results to zero.
+        return Float.isFinite(value) ? value : 0;
+    }
+
+    private static final class EvaluationLimit extends RuntimeException {}
+
+    record Program(float constant, List<Expression> expressions) {
+        private static final Pattern FLOAT_SUFFIX =
+                Pattern.compile("(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?[fF](?![\\w.])");
+
+        static Program parse(final JsonElement json, final float fallback) throws IOException {
+            return parse(json, fallback, 4096, 512);
+        }
+
+        static Program script(final JsonElement json) throws IOException {
+            if (json == null || !json.isJsonArray()) return parse(json, 0);
+            if (json.getAsJsonArray().size() > 256)
+                throw new IOException("Too many actor animation scripts");
+            final StringBuilder combined = new StringBuilder();
+            for (final JsonElement line : json.getAsJsonArray()) {
+                if (!line.isJsonPrimitive()
+                        || !line.getAsJsonPrimitive().isString()
+                        || combined.length() + line.getAsString().length() > 16384)
+                    throw new IOException("Invalid actor animation script");
+                combined.append(line.getAsString());
+            }
+            return parse(new com.google.gson.JsonPrimitive(combined.toString()), 0, 16384, 2048);
+        }
+
+        static Program script(final List<String> lines) throws IOException {
+            final JsonArray json = new JsonArray();
+            lines.forEach(json::add);
+            return script(json);
+        }
+
+        private static Program parse(
+                final JsonElement json,
+                final float fallback,
+                final int maxLength,
+                final int maxNodes)
+                throws IOException {
+            if (json == null) return new Program(fallback, null);
+            if (!json.isJsonPrimitive()) throw new IOException("Invalid animation expression");
+            if (json.getAsJsonPrimitive().isNumber()) {
+                final float value = json.getAsFloat();
+                if (!Float.isFinite(value))
+                    throw new IOException("Invalid animation value");
+                return new Program(value, null);
+            }
+            if (!json.getAsJsonPrimitive().isString() || json.getAsString().length() > maxLength)
+                throw new IOException("Invalid animation expression");
+            try {
+                final List<Expression> expressions =
+                        BedrockMolangParser.parse(numericSuffixes(json.getAsString()));
+                final Limits limits = new Limits(maxNodes);
+                final List<Expression> bounded = new ArrayList<>();
+                for (final Expression expression : expressions)
+                    bounded.add(limits.normalize(expression, 0));
+                return new Program(0, List.copyOf(bounded));
+            } catch (RuntimeException e) {
+                throw new IOException("Invalid Molang animation expression", e);
+            }
+        }
+
+        // Vanilla player controllers retain C-style float suffixes. Preserve quoted values.
+        private static String numericSuffixes(final String expression) {
+            final StringBuilder result = new StringBuilder();
+            char quote = 0;
+            for (int index = 0; index < expression.length(); index++) {
+                final char current = expression.charAt(index);
+                if (quote != 0) {
+                    result.append(current);
+                    if (current == '\\' && index + 1 < expression.length())
+                        result.append(expression.charAt(++index));
+                    else if (current == quote) quote = 0;
+                    continue;
+                }
+                if (current == '\'' || current == '"') quote = current;
+                if ((Character.isDigit(current) || current == '.')
+                        && (index == 0
+                                || !Character.isJavaIdentifierPart(expression.charAt(index - 1))
+                                        && expression.charAt(index - 1) != '.')) {
+                    final var match =
+                            FLOAT_SUFFIX.matcher(expression).region(index, expression.length());
+                    if (match.lookingAt()) {
+                        result.append(expression, index, match.end() - 1);
+                        index = match.end() - 1;
+                        continue;
+                    }
+                }
+                result.append(current);
+            }
+            return result.toString();
+        }
+    }
+
+    private static final class Limits {
+        private int nodes;
+        private final int maxNodes;
+
+        private Limits(final int maxNodes) {
+            this.maxNodes = maxNodes;
+        }
+
+        private static Expression boundedBody(final Expression expression) throws IOException {
+            if (!(expression instanceof ExecutionScopeExpression scope))
+                throw new IOException("Invalid Molang loop body");
+            final List<Expression> body = new ArrayList<>();
+            body.add(
+                    new CallExpression(
+                            new IdentifierExpression("stackanvil_iteration"), List.of()));
+            body.addAll(scope.expressions());
+            return new ExecutionScopeExpression(body);
+        }
+
+        Expression normalize(final Expression expression, final int depth) throws IOException {
+            if (++this.nodes > this.maxNodes || depth > 32)
+                throw new IOException("The animation expression is too complex");
+            return switch (expression) {
+                case FloatExpression _,
+                        StringExpression _,
+                        IdentifierExpression _,
+                        StatementExpression _ ->
+                        expression;
+                case AccessExpression value -> {
+                    final AccessExpression access =
+                            new AccessExpression(
+                                    this.normalize(value.object(), depth + 1), value.property());
+                    yield query(value) ? new CallExpression(access, List.of()) : access;
+                }
+                case ArrayAccessExpression value ->
+                        new ArrayAccessExpression(
+                                this.normalize(value.array(), depth + 1),
+                                this.normalize(value.index(), depth + 1));
+                case BinaryExpression value -> {
+                    final Expression left = this.normalize(value.left(), depth + 1),
+                            right = this.normalize(value.right(), depth + 1);
+                    if (value.op() == BinaryExpression.Op.EQ
+                            || value.op() == BinaryExpression.Op.NEQ) {
+                        final Expression equality =
+                                new CallExpression(
+                                        new IdentifierExpression("stackanvil_equal"),
+                                        List.of(left, right));
+                        yield value.op() == BinaryExpression.Op.EQ
+                                ? equality
+                                : new UnaryExpression(
+                                        UnaryExpression.Op.LOGICAL_NEGATION, equality);
+                    }
+                    yield new BinaryExpression(value.op(), left, right);
+                }
+                case UnaryExpression value ->
+                        new UnaryExpression(
+                                value.op(), this.normalize(value.expression(), depth + 1));
+                case TernaryConditionalExpression value ->
+                        new TernaryConditionalExpression(
+                                this.normalize(value.condition(), depth + 1),
+                                this.normalize(value.trueExpression(), depth + 1),
+                                this.normalize(value.falseExpression(), depth + 1));
+                case ExecutionScopeExpression value -> {
+                    final List<Expression> body = new ArrayList<>();
+                    for (final Expression child : value.expressions())
+                        body.add(this.normalize(child, depth + 1));
+                    yield new ExecutionScopeExpression(body);
+                }
+                case CallExpression value -> {
+                    final List<Expression> arguments = new ArrayList<>();
+                    for (final Expression argument : value.arguments())
+                        arguments.add(this.normalize(argument, depth + 1));
+                    Expression function =
+                            value.function() instanceof AccessExpression access && query(access)
+                                    ? new AccessExpression(
+                                            this.normalize(access.object(), depth + 1),
+                                            access.property())
+                                    : this.normalize(value.function(), depth + 1);
+                    if (function instanceof IdentifierExpression id
+                            && id.name().equalsIgnoreCase("loop")) {
+                        if (arguments.size() != 2)
+                            throw new IOException("Invalid Molang loop arguments");
+                        // Bedrock caps each loop at 1024 iterations. Mocha leaves this to its host.
+                        arguments.set(
+                                0,
+                                new CallExpression(
+                                        new AccessExpression(
+                                                new IdentifierExpression("math"), "floor"),
+                                        List.of(
+                                                new CallExpression(
+                                                        new AccessExpression(
+                                                                new IdentifierExpression("math"),
+                                                                "clamp"),
+                                                        List.of(
+                                                                arguments.getFirst(),
+                                                                FloatExpression.ZERO,
+                                                                FloatExpression.of(1024))))));
+                        function = new IdentifierExpression("loop");
+                        arguments.set(1, boundedBody(arguments.get(1)));
+                    }
+                    if (function instanceof IdentifierExpression id
+                            && id.name().equalsIgnoreCase("for_each")) {
+                        if (arguments.size() != 3)
+                            throw new IOException("Invalid Molang for_each arguments");
+                        function = new IdentifierExpression("for_each");
+                        arguments.set(2, boundedBody(arguments.get(2)));
+                    }
+                    yield new CallExpression(function, arguments);
+                }
+                default -> throw new IOException("Unsupported Molang expression node");
+            };
+        }
+
+        private static boolean query(final AccessExpression access) {
+            return access.object() instanceof IdentifierExpression object
+                    && (object.name().equalsIgnoreCase("query")
+                            || object.name().equalsIgnoreCase("q"));
+        }
+    }
+}
