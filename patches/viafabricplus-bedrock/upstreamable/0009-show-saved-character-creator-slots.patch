+        Files.write(directory.resolve("__brarchive/pieces.brarchive"), archive());
+        Files.write(directory.resolve("loose.png"), new byte[10]);
+        // Input is 797 bytes and the logical output is 16 bytes. Counting both
+        // representations together would incorrectly reject the 800-byte limit.
+        assertEquals(3, BedrockBuiltinAssets.unpack(directory, 800).size());
