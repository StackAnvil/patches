+        remote.seek(std::io::SeekFrom::Start(0)).await.unwrap();
+        let package = XvdFile::parse(&mut remote).await.unwrap();
+        let files = package.parse_user_package_files(&mut remote).await.unwrap();
+        eprintln!("User package files: {:?}", files.keys().collect::<Vec<_>>());
+        let files = index::ntfs(&mut remote, &header, &package).unwrap();
+        let persona = files.len();
+        assert!(files.contains_key("manifest.json"));
+        assert!(files.contains_key("library/vanilla/__brarchive/models.brarchive"));
+        assert!(files.contains_key("library/vanilla/__brarchive/models/entity.brarchive"));
+
+        assert!(persona > 100);
+        eprintln!(
+            "Verified package {}, {} persona entries",
+            header.package_version, persona
+        );
+    }
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore]
+    async fn official_persona_assets() {
+        let path = std::env::var("STACKANVIL_PACKAGE_REQUEST").unwrap();
+        let mut request: Request =
+            serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+        let tokens = TokenManager::new(
+            Arc::new(store::FileBackend::new(request.state.clone(), request.xuid.clone()).unwrap()),
+            Arc::new(MemoryBackend::default()),
+        );
+        let xodus::models::secrets::Token::Legacy(device) = tokens.get_device_sts_token().unwrap()
+        else {
+            panic!("Missing device fixture")
+        };
+        let xodus::models::secrets::Token::Legacy(user) = tokens.get_user_sts_token().unwrap()
+        else {
+            panic!("Missing account fixture")
+        };
+        let response =
+            xodus::api::xbox::run(&reqwest::Client::new(), device, user, "http://xboxlive.com")
+                .await;
+        let response = serde_json::to_value(response).unwrap();
+        let xuid = response
+            .pointer("/DisplayClaims/xui/0/xid")
+            .unwrap()
+            .as_str()
+            .unwrap()
+            .to_owned();
+        if xuid != request.xuid {
+            for key in ["user-tokens", "user-DA"] {
+                std::fs::copy(
+                    request.state.join(format!("{}-{key}.json", request.xuid)),
+                    request.state.join(format!("{xuid}-{key}.json")),
