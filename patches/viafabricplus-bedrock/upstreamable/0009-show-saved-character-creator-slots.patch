+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import org.joml.Vector3f;
+
+/** Attached birth transforms precede initialization and inherited velocity. */
+record BedrockParticleSpace(boolean position, boolean rotation, boolean velocity) {
+    static BedrockParticleSpace read(final JsonObject components) {
+        final JsonObject value = BedrockParticleEffect.object(components, "emitter_local_space");
+        return new BedrockParticleSpace(BedrockParticleEffect.bool(value, "position"),
+                BedrockParticleEffect.bool(value, "rotation"), BedrockParticleEffect.bool(value, "velocity"));
+    }
+
+    void birth(final BedrockParticleAttachment.Matrix matrix, final boolean found,
+               final Vector3f position, final Vector3f velocity, final Vector3f facing,
+               final Runnable initialize, final Vector3f inherited) {
+        if (matrix != null) {
+            if (!this.position || found) matrix.position(position);
+            if (!this.rotation || found) {
+                matrix.direction(velocity);
+                matrix.direction(facing);
+            }
+        }
+        initialize.run();
+        if (this.velocity) velocity.add(inherited);
+    }
+}
