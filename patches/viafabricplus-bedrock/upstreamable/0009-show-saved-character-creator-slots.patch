+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.joml.Matrix4f;
+import org.joml.Vector4f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockFirstPersonProjectionTest {
+    @Test
+    void usesWaterAndDeathEffectsWithTheNativeCounterWidth() {
+        assertEquals(70F, BedrockFirstPersonProjection.fieldOfView(false, true, false, 120, .5F));
+        assertEquals(60F, BedrockFirstPersonProjection.fieldOfView(true, true, true, 0, .5F));
+        assertEquals(35F, BedrockFirstPersonProjection.fieldOfView(true, false, false, 500, 0));
+        assertEquals(30F, BedrockFirstPersonProjection.fieldOfView(true, true, false, 500, 0));
+        assertTrue(BedrockFirstPersonProjection.fieldOfView(true, false, false, 120, .5F)
+                < BedrockFirstPersonProjection.fieldOfView(true, false, false, 20, .5F));
+        assertEquals(BedrockFirstPersonProjection.fieldOfView(true, false, false, -32768, .5F),
+                BedrockFirstPersonProjection.fieldOfView(true, false, false, 32768, .5F));
+        assertEquals(70F, BedrockFirstPersonProjection.fieldOfView(true, false, false, 65536, 0));
+    }
+
+    @Test
+    void preservesReversedDepthAtTheNativeNearPlane() {
+        for (final boolean zeroToOne : new boolean[]{false, true}) {
+            final var matrix = projection(70F, 1920F, 1080F, 128F, zeroToOne);
+            final var near = matrix.transform(new Vector4f(0, 0, -BedrockFirstPersonProjection.NEAR_PLANE, 1));
+            final var far = matrix.transform(new Vector4f(0, 0, -128F, 1));
+            assertEquals(1F, near.z / near.w, 1E-6F);
+            assertEquals(zeroToOne ? 0F : -1F, far.z / far.w, 1E-6F);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_HAND_PROJECTION", matches = ".+")
+    void matchesExecutableOrdinaryHandFovBits() throws Exception {
+        for (final var entry : fixture().getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            // The separate native DeathCameraComponent controller still needs integration.
+            if (row.get("death_camera").getAsBoolean()) continue;
+            final float actual = BedrockFirstPersonProjection.fieldOfView(row.get("effects").getAsBoolean(),
+                    row.get("water").getAsBoolean(), row.get("alive").getAsBoolean(),
+                    row.get("ticks").getAsInt(), row.get("alpha").getAsFloat());
+            assertEquals(row.get("result").getAsInt(), Float.floatToRawIntBits(actual), row::toString);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_HAND_PROJECTION", matches = ".+")
+    void matchesExecutableProjectionWithBothGpuDepthRanges() throws Exception {
+        for (final var entry : fixture().getAsJsonArray("matrices")) {
+            final var row = entry.getAsJsonObject();
+            for (final boolean zeroToOne : new boolean[]{false, true}) {
+                final float[] actual = new float[16];
+                projection(row.get("fov").getAsFloat(), row.get("width").getAsFloat(),
+                        row.get("height").getAsFloat(), row.get("far").getAsFloat(), zeroToOne).get(actual);
+                for (int i = 0; i < actual.length; i++) {
+                    final float nativeValue = row.getAsJsonArray("result").get(i).getAsFloat();
+                    final float expected = i == 10 ? zeroToOne ? (-1F - nativeValue) * .5F : -nativeValue
+                            : i == 14 ? zeroToOne ? -nativeValue * .5F : -nativeValue : nativeValue;
+                    assertEquals(expected, actual[i], Math.max(2E-6F, Math.abs(expected) * 1E-6F));
+                }
+            }
+        }
+    }
+
+    private static Matrix4f projection(final float fov, final float width, final float height,
+                                       final float far, final boolean zeroToOne) {
+        // Projection.getMatrix passes physical far before physical near for reversed depth.
+        return new Matrix4f().setPerspective(fov * .017453292F, width / height,
+                far, BedrockFirstPersonProjection.NEAR_PLANE, zeroToOne);
+    }
+
+    private static JsonObject fixture() throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_HAND_PROJECTION")))).getAsJsonObject();
+    }
+}
