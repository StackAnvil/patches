+// SPDX-License-Identifier: GPL-3.0-or-later
+use std::{fs, path::PathBuf};
+use xodus::tokens::store::{TokenBackend, TokenStoreError};
+
+pub struct FileBackend {
+    root: PathBuf,
+    account: String,
+}
+impl FileBackend {
+    pub fn new(root: PathBuf, account: String) -> std::io::Result<Self> {
+        fs::create_dir_all(&root)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&root, fs::Permissions::from_mode(0o700))?;
+        }
+        Ok(Self { root, account })
+    }
+    pub fn prune_expired(&self) -> Result<(), TokenStoreError> {
+        for key in ["device-tokens", "user-tokens"] {
+            let Some(bytes) = self.get(key)? else {
+                continue;
+            };
+            let tokens: xodus::models::secrets::TokenStore = serde_json::from_slice(&bytes)?;
+            let valid = tokens
+                .tokens
+                .get(xodus::tokens::manager::PASSPORT_STS)
+                .is_some_and(|token| {
+                    if let xodus::models::secrets::Token::Legacy(token) = token {
+                        chrono::DateTime::parse_from_rfc3339(&token.lifetime.expires).is_ok_and(
+                            |expires| expires.timestamp() > chrono::Utc::now().timestamp() + 60,
+                        )
+                    } else {
+                        false
+                    }
+                });
+            if !valid {
+                self.remove(key)?;
+            }
+        }
+        Ok(())
+    }
+    fn path(&self, key: &str) -> std::io::Result<PathBuf> {
+        if !matches!(
+            key,
+            "dev_license" | "device-tokens" | "user-tokens" | "user-DA"
+        ) {
+            return Err(std::io::Error::other("Unknown credential"));
+        }
+        let name = if key.starts_with("user-") {
+            format!("{}-{key}.json", self.account)
+        } else {
+            format!("{key}.json")
+        };
+        Ok(self.root.join(name))
+    }
+}
+impl TokenBackend for FileBackend {
+    fn get(&self, key: &str) -> Result<Option<Vec<u8>>, TokenStoreError> {
+        let path = self.path(key)?;
+        match fs::read(path) {
+            Ok(bytes) => Ok(Some(bytes)),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(err) => Err(err.into()),
+        }
+    }
+    fn set(&self, key: &str, bytes: &[u8]) -> Result<(), TokenStoreError> {
+        let path = self.path(key)?;
+        let temporary = path.with_extension("tmp");
+        use std::io::Write;
+        let mut options = fs::OpenOptions::new();
+        options.create(true).truncate(true).write(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options.open(&temporary)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        drop(file);
+        fs::rename(temporary, path)?;
+        Ok(())
+    }
+    fn remove(&self, key: &str) -> Result<(), TokenStoreError> {
+        match fs::remove_file(self.path(key)?) {
+            Ok(()) => Ok(()),
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(err) => Err(err.into()),
+        }
+    }
+}
