+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.api.model.MolangVariables;
+import org.redlance.mocha.runtime.value.NumberValue;
+import org.redlance.mocha.runtime.value.MutableObjectBinding;
+import org.redlance.mocha.runtime.value.ObjectProperty;
+import org.redlance.mocha.runtime.value.ObjectValue;
+import org.redlance.mocha.runtime.value.Value;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Locale;
+
+/** Native hashed variables copy struct values and retain case-sensitive members. */
+// Mocha assignments dispatch only to MutableObjectBinding, including nested member writes.
+final class BedrockMolangVariables extends MutableObjectBinding {
+    private final Map<Long, ObjectProperty> properties = new HashMap<>();
+
+    @Override
+    public ObjectProperty getProperty(final String name) {
+        return this.properties.get(MolangVariables.hash("variable." + name.toLowerCase(Locale.ROOT)));
+    }
+
+    @Override
+    public boolean set(final String name, final Value value) {
+        if (this.blocked()) return false;
+        this.set(MolangVariables.hash("variable." + name.toLowerCase(Locale.ROOT)), value);
+        return true;
+    }
+
+    private void set(final long hash, final Value value) {
+        if (value == null) this.properties.remove(hash);
+        else this.properties.put(hash, ObjectProperty.property(copy(value), false));
+    }
+
+    void setAllFrom(final BedrockMolangVariables source) {
+        source.properties.forEach((hash, property) -> this.set(hash, property.value()));
+    }
+
+    void apply(final MolangVariables source) {
+        // Repeated valid roots replace their previous value. Unknown typed values were skipped by core.
+        for (final var entry : source.entries()) this.set(MolangVariables.hash(entry.name()), convert(entry.value()));
+    }
+
+    private static Value convert(final MolangVariables.Value value) {
+        return switch (value) {
+            case MolangVariables.Scalar scalar -> NumberValue.of(scalar.value());
+            case MolangVariables.Members members -> {
+                final Members binding = new Members();
+                for (final var entry : members.entries()) {
+                    // Native member traversal stops at the first hash match.
+                    binding.properties.putIfAbsent(MolangVariables.hash(entry.name()), ObjectProperty.property(convert(entry.value()), false));
+                }
+                yield binding;
+            }
+        };
+    }
+
+    private static Value copy(final Value value) {
+        if (value instanceof Members members) {
+            final Members result = new Members();
+            members.properties.forEach((name, property) -> result.properties.put(name, ObjectProperty.property(copy(property.value()), false)));
+            return result;
+        }
+        if (value instanceof ObjectValue object && !object.entries().isEmpty()) {
+            final Members result = new Members();
+            object.entries().forEach((name, property) -> result.set(name, property.value()));
+            return result;
+        }
+        return value;
+    }
+
+    private static final class Members extends MutableObjectBinding {
+        private final Map<Long, ObjectProperty> properties = new HashMap<>();
+
+        @Override
+        public ObjectProperty getProperty(final String name) {
+            return this.properties.get(MolangVariables.hash(name.toLowerCase(Locale.ROOT)));
+        }
+
+        @Override
+        public boolean set(final String name, final Value value) {
+            if (this.blocked()) return false;
+            final long hash = MolangVariables.hash(name.toLowerCase(Locale.ROOT));
+            if (value == null) this.properties.remove(hash);
+            else this.properties.put(hash, ObjectProperty.property(copy(value), false));
+            return true;
+        }
+    }
+}
