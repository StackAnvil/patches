+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.joml.Matrix4f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockViewBobbingTest {
+    @Test
+    void samplesNativeSidewaysOffsetAndSeparateAirborneTilt() {
+        final var view = new BedrockViewBobbing();
+        view.tick(.3F, .42F, .4F, true, false, true, false);
+        final var matrix = view.matrix(.3F, .5F);
+        assertEquals(-.0021033855F, matrix.m30(), 1E-9F);
+        assertEquals(-.002350955F, matrix.m31(), 1E-9F);
+        assertEquals(-.0001694354F, matrix.m01(), 1E-9F);
+        assertEquals(.00014496568F, matrix.m12(), 1E-9F);
+        final var airborne = new BedrockViewBobbing();
+        airborne.tick(0, .42F, 0, false, false, true, false);
+        final var tilt = airborne.matrix(0, 1);
+        assertEquals(0F, tilt.m30(), 0F);
+        assertEquals(0F, tilt.m31(), 0F);
+        assertEquals(-.008775744F, tilt.m12(), 1E-7F);
+        final var dead = new BedrockViewBobbing();
+        dead.tick(.3F, .42F, .4F, false, false, false, false);
+        assertTrue(new Matrix4f().equals(dead.matrix(.3F, 1), 0F));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_WALK_BOB", matches = ".+")
+    void matchesExecutableBobAndTiltComponentUpdates() throws Exception {
+        final var fixture = fixture();
+        for (final var entry : fixture.getAsJsonArray("updates")) {
+            final var row = entry.getAsJsonObject();
+            final var view = new BedrockViewBobbing();
+            set(view, "bob", row.get("current").getAsFloat());
+            set(view, "tilt", row.get("tilt").getAsFloat());
+            final var velocity = row.getAsJsonArray("velocity");
+            view.tick(velocity.get(0).getAsFloat(), velocity.get(1).getAsFloat(), velocity.get(2).getAsFloat(),
+                    row.get("ground").getAsBoolean(), row.get("swimming").getAsBoolean(),
+                    row.get("health").getAsFloat() > 0, row.get("riding").getAsBoolean());
+            assertEquals(row.getAsJsonArray("bob").get(0).getAsInt(), Float.floatToRawIntBits(get(view, "bob")));
+            assertEquals(row.getAsJsonArray("bob").get(1).getAsInt(), Float.floatToRawIntBits(get(view, "previousBob")));
+            assertEquals(Float.intBitsToFloat(row.get("tilt_result").getAsInt()), get(view, "tilt"), 1E-6F);
+            assertEquals(row.get("tilt").getAsFloat(), get(view, "previousTilt"));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_WALK_BOB", matches = ".+")
+    void matchesExecutableMatrixCompositionWithExistingCameraTransforms() throws Exception {
+        for (final var entry : fixture().getAsJsonArray("matrices")) {
+            final var row = entry.getAsJsonObject();
+            final var values = new float[16];
+            for (int i = 0; i < values.length; i++) values[i] = row.getAsJsonArray("input").get(i).getAsFloat();
+            final float alpha = row.get("alpha").getAsFloat();
+            final float previous = row.get("previous").getAsFloat();
+            final float oldTilt = row.get("old_tilt").getAsFloat();
+            BedrockViewBobbing.transform(new Matrix4f().set(values), row.get("distance").getAsFloat() * .6F,
+                    (row.get("amplitude").getAsFloat() - previous) * alpha + previous,
+                    (row.get("tilt").getAsFloat() - oldTilt) * alpha + oldTilt).get(values);
+            for (int i = 0; i < values.length; i++) {
+                assertEquals(row.getAsJsonArray("result").get(i).getAsFloat(), values[i], 2E-6F);
+            }
+        }
+    }
+
+    private static com.google.gson.JsonObject fixture() throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_WALK_BOB")))).getAsJsonObject();
+    }
+
+    private static void set(final BedrockViewBobbing view, final String name, final float value) throws Exception {
+        final var field = BedrockViewBobbing.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.setFloat(view, value);
+    }
+
+    private static float get(final BedrockViewBobbing view, final String name) throws Exception {
+        final var field = BedrockViewBobbing.class.getDeclaredField(name);
+        field.setAccessible(true);
+        return field.getFloat(view);
+    }
+}
