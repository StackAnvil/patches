+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_CAPTURE", matches = ".+")
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_OFFICIAL_PERSONA", matches = ".+")
+    void reproducesEveryNativeFacePixelAndBindsBothHeadLayers() throws Exception {
+        final JsonObject capture =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_PERSONA_CAPTURE"))))
+                        .getAsJsonObject();
+        final var assets =
+                BedrockBuiltinAssets.index(
+                        "1.26.51.1",
+                        NativeAssetFixture.read(
