+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+
+import net.minecraft.client.renderer.entity.state.AvatarRenderState;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+import java.util.Map;
+
+final class BedrockPlayerModelTest {
+    @Test
+    void switchesTreesForAnEmoteAndRestoresTheOrdinaryPlayer() throws Exception {
+        final var geometry =
+                BedrockGeometryModel.fromJson(
+                                """
+                                {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+                                  "bones":[{"name":"root","pivot":[0,0,0],"rotation":[0,0,0]},
+                                    {"name":"waist","parent":"root","pivot":[0,12,0],"rotation":[0,0,0]},
+                                    {"name":"body","parent":"waist","pivot":[0,24,0],"rotation":[0,0,0]},
+                                    {"name":"head","parent":"body","pivot":[0,24,0],"rotation":[0,0,0]},
+                                    {"name":"rightArm","parent":"body","pivot":[-5,22,0],"rotation":[0,0,0]},
+                                    {"name":"leftArm","parent":"body","pivot":[5,22,0],"rotation":[0,0,0]},
+                                    {"name":"rightLeg","parent":"root","pivot":[-1.9,12,0],"rotation":[0,0,0]},
+                                    {"name":"leftLeg","parent":"root","pivot":[1.9,12,0],"rotation":[0,0,0]}]}]}
+                                """)
+                        .getFirst();
+        final var model = BedrockGeometry.playerModel(geometry, false);
+        final var state = new State();
+        state.pose =
+                BedrockBoneAnimation.parse(
+                                JsonParser.parseString(
+                                                """
+                                                {"bones":{"hip":{"rotation":[0,0,90]},"root":{"position":[0,2,0]}}}
+                                                """)
+                                        .getAsJsonObject())
+                        .playback()
+                        .sample(0, Map.of());
+        for (int frame = 0; frame < 3; frame++) {
+            model.setupAnim(state);
+            assertTrue(model.root().hasChild("animated"));
+            assertFalse(model.root().hasChild("head"));
+            assertEquals(12, model.head.x, 0.0001F);
+            assertEquals(10, model.head.y, 0.0001F);
+            assertEquals((float) Math.PI / 2, model.rightArm.zRot, 0.0001F);
+        }
+        state.pose = Map.of();
+        model.setupAnim(state);
+        assertFalse(model.root().hasChild("animated"));
+        assertTrue(model.root().hasChild("head"));
+        assertEquals(0, model.head.x);
+        assertEquals(0, model.head.y);
+    }
+
+    @Test
+    void keepsEntityRelativeHeadRotationIndependentOfAnimatedParents() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.relative","texture_width":64,"texture_height":64},
+             "bones":[{"name":"root","pivot":[0,0,0],"rotation":[0,0,0]},
+              {"name":"body","parent":"root","pivot":[0,24,0],"rotation":[0,0,0]},
+              {"name":"head","parent":"body","pivot":[0,24,0],"rotation":[0,0,0]},
+              {"name":"rightArm","parent":"body","pivot":[-5,22,0],"rotation":[0,0,0]},
+              {"name":"leftArm","parent":"body","pivot":[5,22,0],"rotation":[0,0,0]},
+              {"name":"rightLeg","parent":"root","pivot":[-1.9,12,0],"rotation":[0,0,0]},
+              {"name":"leftLeg","parent":"root","pivot":[1.9,12,0],"rotation":[0,0,0]}]}]}
+            """).getFirst();
+        final var model = BedrockGeometry.playerModel(geometry, false);
+        final State state = new State();
+        state.pose = BedrockBoneAnimation.parse(JsonParser.parseString("""
+            {"bones":{"body":{"rotation":[30,45,20]},"head":{"relative_to":{"rotation":"entity"},"rotation":[10,25,0]}}}
+            """).getAsJsonObject()).playback().sample(0, Map.of());
+        for (int frame = 0; frame < 3; frame++) {
+            model.setupAnim(state);
+            assertEquals(Math.toRadians(10), model.head.xRot, 0.00001);
+            assertEquals(Math.toRadians(25), model.head.yRot, 0.00001);
+            assertEquals(0, model.head.zRot, 0.00001);
+            assertEquals(Math.toRadians(30), model.rightArm.xRot, 0.00001);
+            assertEquals(Math.toRadians(45), model.rightArm.yRot, 0.00001);
+            assertEquals(Math.toRadians(20), model.rightArm.zRot, 0.00001);
+        }
+    }
+
+    private static final class State extends AvatarRenderState implements BedrockPlayerAnimationState {
+        private Map<String, BedrockBoneAnimation.Transform> pose = Map.of();
+
+        @Override
+        public Map<String, BedrockBoneAnimation.Transform> bedrockAnimationPose() {
+            return this.pose;
+        }
+
+        @Override
+        public void bedrockAnimationPose(final Map<String, BedrockBoneAnimation.Transform> pose) {
+            this.pose = pose;
+        }
+    }
+}
