+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import net.minecraft.world.phys.Vec3;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import java.util.Map;
+
+final class BedrockModelLocatorsTest {
+    @Test
+    void tracksBoneTransformsAndCanDiscardInheritedScale() {
+        final JsonObject document = new JsonObject(), geometry = new JsonObject(), description = new JsonObject();
+        description.addProperty("identifier", "geometry.test"); description.addProperty("texture_width", 64); description.addProperty("texture_height", 64);
+        geometry.add("description", description);
+        final JsonArray bones = new JsonArray();
+        final JsonObject root = bone("root", 0, 0, 0), hand = bone("hand", 0, 16, 0);
+        hand.addProperty("parent", "root");
+        final JsonObject locators = new JsonObject(); locators.add("tip", vector(4, 16, 0));
+        final JsonObject unscaled = new JsonObject(); unscaled.add("offset", vector(4, 16, 0)); unscaled.addProperty("ignore_inherited_scale", true); locators.add("fixed", unscaled); hand.add("locators", locators);
+        bones.add(root); bones.add(hand); geometry.add("bones", bones);
+        final JsonArray geometries = new JsonArray(); geometries.add(geometry); document.add("minecraft:geometry", geometries);
+        final var parsed = BedrockModelLocators.read(document, description.get("identifier").getAsString());
+        final var model = BedrockGeometry.animatedModel(BedrockGeometryModel.fromJson(document).getFirst(), Map.of());
+        assertEquals(4, model.locator(parsed.get("tip")).x, .00001F);
+        assertEquals(8, model.locator(parsed.get("tip")).y, .00001F);
+        final var zero = new BedrockBoneAnimation.Vector(0, 0, 0);
+        model.pose(Map.of("hand", new BedrockBoneAnimation.Transform(zero,
+                new BedrockBoneAnimation.Vector(0, 0, 90), new BedrockBoneAnimation.Vector(2, 2, 2), false)));
+        assertEquals(16, model.locator(parsed.get("tip")).y, .00001F);
+        assertEquals(16, model.locator(parsed.get("fixed")).y, .00001F);
+        final var world = model.worldLocator(parsed.get("tip"), new Vec3(10, 20, 30), 180);
+        assertEquals(20.5F, world.m31(), .00001F);
+        final var direction = world.transformDirection(new Vector3f(1, 0, 0));
+        assertEquals(0, direction.x, .00001F);
+        assertEquals(2, direction.y, .00001F);
+        assertEquals(0, direction.z, .00001F);
+        final var unscaledDirection = model.worldLocator(parsed.get("fixed"), Vec3.ZERO, 180)
+                .transformDirection(new Vector3f(1, 0, 0));
+        assertEquals(1, unscaledDirection.y, .00001F);
+        model.pose(Map.of());
+        assertEquals(8, model.locator(parsed.get("tip")).y, .00001F);
+        assertThrows(UnsupportedOperationException.class, () -> parsed.clear());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeLocatorCompositionAndScaleSuppression() throws Exception {
+        final var fixture = com.google.gson.JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_PARTICLE_REFERENCE"), "native-locator-transform-result.json"))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (final var row : cases) {
+            final var value = row.getAsJsonObject();
+            final float[] offset = values(value.getAsJsonArray("offset")), rotation = values(value.getAsJsonArray("rotation"));
+            final var locator = new BedrockModelLocators.Locator("bone", offset[0], offset[1], offset[2],
+                    rotation[0], rotation[1], rotation[2], value.get("ignore_scale").getAsBoolean());
+            final var actual = BedrockModelLocators.transform(new Matrix4f().set(values(value.getAsJsonArray("bone"))), locator);
+            assertNotNull(actual);
+            assertArrayEquals(values(value.getAsJsonArray("matrix")), actual.get(new float[16]), .000005F);
+        }
+        assertEquals(144, cases.size());
+    }
+
+    @Test
+    void appliesModernLocatorRotationAndKeepsLegacyOffsets() {
+        final JsonObject geometry = new JsonObject(), description = new JsonObject();
+        description.addProperty("identifier", "geometry.test"); geometry.add("description", description);
+        final JsonObject root = bone("root", 0, 0, 0), properties = new JsonObject(), locators = new JsonObject();
+        properties.add("offset", vector(4, 2, 3)); properties.add("rotation", vector(0, 0, 90));
+        locators.add("tip", properties); root.add("locators", locators);
+        final JsonArray bones = new JsonArray(); bones.add(root); geometry.add("bones", bones);
+        final JsonArray geometries = new JsonArray(); geometries.add(geometry);
+        final JsonObject modern = new JsonObject(); modern.add("minecraft:geometry", geometries);
+        final var matrix = new Matrix4f().scaling(2, 3, 4);
+        final var rotated = BedrockModelLocators.transform(matrix, BedrockModelLocators.read(modern, "geometry.test").get("tip"));
+        final var direction = rotated.transformDirection(new Vector3f(1, 0, 0));
+        assertEquals(0, direction.x, .00001F); assertEquals(3, direction.y, .00001F);
+        assertEquals(8, rotated.m30(), .00001F); assertEquals(-6, rotated.m31(), .00001F); assertEquals(12, rotated.m32(), .00001F);
+        final JsonObject legacy = new JsonObject(); legacy.add("geometry.test", geometry);
+        final var unrotated = BedrockModelLocators.transform(matrix, BedrockModelLocators.read(legacy, "geometry.test").get("tip"));
+        direction.set(1, 0, 0); unrotated.transformDirection(direction);
+        assertEquals(2, direction.x, .00001F); assertEquals(0, direction.y, .00001F);
+        properties.addProperty("ignore_inherited_scale", true);
+        final var fixed = BedrockModelLocators.transform(matrix, BedrockModelLocators.read(modern, "geometry.test").get("tip"));
+        assertEquals(rotated.m30(), fixed.m30()); assertEquals(rotated.m31(), fixed.m31()); assertEquals(rotated.m32(), fixed.m32());
+        assertEquals(1, fixed.transformDirection(new Vector3f(1, 0, 0)).length(), .00001F);
+    }
+
+    private static float[] values(final com.google.gson.JsonArray values) {
+        final float[] result = new float[values.size()];
+        for (int i = 0; i < result.length; i++) result[i] = values.get(i).getAsFloat();
+        return result;
+    }
+
+    private static JsonObject bone(final String name, final float x, final float y, final float z) {
+        final JsonObject bone = new JsonObject(); bone.addProperty("name", name); bone.add("pivot", vector(x, y, z)); bone.add("rotation", vector(0, 0, 0)); return bone;
+    }
+
+    private static JsonArray vector(final float x, final float y, final float z) {
+        final JsonArray vector = new JsonArray(); vector.add(x); vector.add(y); vector.add(z); return vector;
+    }
+}
