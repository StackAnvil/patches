+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Map;
+import java.util.UUID;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+final class BedrockPersonaAssetsTest {
+    @Test
+    void decodesOnlyThePackAuthorizedByTheReceipt() throws Exception {
+        final String id = UUID.randomUUID().toString();
+        final byte[] key = new byte[32], fileKey = new byte[32], data = new byte[8192];
+        new java.util.Random(17).nextBytes(key);
+        Arrays.fill(fileKey, (byte) 'a');
+        new java.util.Random(31).nextBytes(data);
+        final JsonObject receipt = new JsonObject(),
+                receiptData = new JsonObject(),
+                entitlement = new JsonObject();
+        final String entity = UUID.randomUUID().toString(), device = UUID.randomUUID().toString();
+        receipt.addProperty("EntityId", entity);
+        receiptData.addProperty("DeviceId", device);
+        receipt.add("ReceiptData", receiptData);
+        final byte[] wrapped = new byte[64];
+        for (int index = 0; index < key.length; index++)
+            wrapped[index * 2] = (byte) (key[index] ^ entity.charAt(index) ^ device.charAt(index));
+        entitlement.addProperty("PackId", id);
+        entitlement.addProperty("ContentKey", Base64.getEncoder().encodeToString(wrapped));
+        final JsonArray entitlements = new JsonArray();
+        entitlements.add(entitlement);
+        receipt.add("EntitlementReceipts", entitlements);
+        final var keys = BedrockPersonaAssets.receiptKeys(receipt);
+        assertArrayEquals(key, keys.get(id));
+        assertFalse(keys.containsKey(UUID.randomUUID().toString()));
+        final byte[] archive = archive(id, key, fileKey, data);
+        assertArrayEquals(
+                data,
+                BedrockPersonaAssets.decode(archive, id, keys.get(id)).files().get("texture.png"));
+        assertThrows(
+                IOException.class,
+                () -> BedrockPersonaAssets.decode(archive, UUID.randomUUID().toString(), key));
+        assertThrows(
+                IOException.class, () -> BedrockPersonaAssets.decode(archive, id, new byte[32]));
+        assertThrows(IOException.class, () -> BedrockPersonaAssets.decode(new byte[8], id, key));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_ASSETS", matches = ".+")
+    void assemblesTheEntitledAnimatedArmsFromPrivateNativeAssets() throws Exception {
+        final Path directory = Path.of(System.getenv("STACKANVIL_PERSONA_ASSETS"));
+        final var receipt =
+                JsonParser.parseString(Files.readString(directory.resolve("receipt.json")))
+                        .getAsJsonObject();
+        final String id = "cb19d2bc-73c7-7bf2-6810-0fa769b1a04d";
+        final var pack =
+                BedrockPersonaAssets.decode(
+                        Files.readAllBytes(directory.resolve("arms-pack.zip")),
+                        id,
+                        BedrockPersonaAssets.receiptKeys(receipt).get(id));
+        final var preview =
+                BedrockPersonaModel.convert(
+                        Files.readAllBytes(directory.resolve("arms-model.glb")));
+        final var slot =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var assembled = BedrockPersonaAssembler.assemble(preview, slot, Map.of(id, pack));
+        assertEquals(1, assembled.animations().size());
+        final var animation = assembled.animations().getFirst();
+        assertEquals(16, animation.frames());
+        assertEquals(128, animation.image().getWidth());
+        assertEquals(2048, animation.image().getHeight());
+        final var restored =
+                BedrockPersonaAnimations.read(
+                                BedrockPersonaAnimations.write(assembled.animations()))
+                        .getFirst();
+        assertArrayEquals(
+                animation.image().getRGB(0, 0, 128, 2048, null, 0, 128),
+                restored.image().getRGB(0, 0, 128, 2048, null, 0, 128));
+        final var models =
+                JsonParser.parseString(assembled.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry");
+        assertEquals(2, models.size());
+        final var bones = models.get(0).getAsJsonObject().getAsJsonArray("bones");
+        for (final var element : bones) {
+            final var bone = element.getAsJsonObject();
+            if (bone.get("name").getAsString().endsWith("armarmor"))
+                assertFalse(bone.has("poly_mesh"));
+        }
+        final var animatedBones = models.get(1).getAsJsonObject().getAsJsonArray("bones");
+        assertEquals(
+                10,
+                java.util.stream.StreamSupport.stream(animatedBones.spliterator(), false)
+                        .filter(bone -> bone.getAsJsonObject().has("cubes"))
+                        .mapToInt(bone -> bone.getAsJsonObject().getAsJsonArray("cubes").size())
+                        .sum());
+    }
+
+    private static byte[] archive(
+            final String id, final byte[] key, final byte[] fileKey, final byte[] data)
+            throws Exception {
+        final JsonObject manifest = new JsonObject(), header = new JsonObject();
+        header.addProperty("uuid", id);
+        manifest.add("header", header);
+        final JsonObject index = new JsonObject(), entry = new JsonObject();
+        entry.addProperty("path", "texture.png");
+        entry.addProperty("key", new String(fileKey, StandardCharsets.ISO_8859_1));
+        final JsonArray content = new JsonArray();
+        content.add(entry);
+        index.add("content", content);
+        final ByteArrayOutputStream contents = new ByteArrayOutputStream();
+        final byte[] prefix = new byte[256];
+        prefix[4] = (byte) 0xFC;
+        prefix[5] = (byte) 0xB9;
+        prefix[6] = (byte) 0xCF;
+        prefix[7] = (byte) 0x9B;
+        prefix[16] = (byte) id.length();
+        System.arraycopy(id.getBytes(StandardCharsets.UTF_8), 0, prefix, 17, id.length());
+        contents.write(prefix);
+        contents.write(encrypt(index.toString().getBytes(StandardCharsets.UTF_8), key));
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        try (final ZipOutputStream zip = new ZipOutputStream(output)) {
+            for (final var file :
+                    Map.of(
+                                    "manifest.json",
+                                    manifest.toString().getBytes(StandardCharsets.UTF_8),
+                                    "contents.json",
+                                    contents.toByteArray(),
+                                    "texture.png",
+                                    encrypt(data, fileKey))
+                            .entrySet()) {
+                zip.putNextEntry(new ZipEntry(file.getKey()));
+                zip.write(file.getValue());
+                zip.closeEntry();
+            }
+        }
+        return output.toByteArray();
+    }
+
+    private static byte[] encrypt(final byte[] data, final byte[] key) throws Exception {
+        final Cipher cipher = Cipher.getInstance("AES/CFB8/NoPadding");
+        cipher.init(
+                Cipher.ENCRYPT_MODE,
+                new SecretKeySpec(key, "AES"),
+                new IvParameterSpec(Arrays.copyOf(key, 16)));
+        return cipher.doFinal(data);
+    }
+}
