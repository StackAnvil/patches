+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Random;
+
+final class BedrockParticleSpaceTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeActorMatricesAndLocatorSelection() throws Exception {
+        final var cases = fixture("native-particle-attachment-matrix-result.json");
+        for (final var row : cases) {
+            final var expected = row.getAsJsonObject();
+            final var config = expected.getAsJsonObject("config");
+            final Vector3f position = vector(config.getAsJsonArray("actor_position"));
+            final Vector3f offset = vector(config.getAsJsonArray("offset"));
+            final var attachment = new BedrockParticleAttachment(new Vec3(position.x, position.y, position.z),
+                    config.get("yaw").getAsFloat(), config.get("locator_found").getAsBoolean()
+                    ? new Matrix4f().set(values(config.getAsJsonArray("locator_matrix"))) : null, null, java.util.Map.of())
+                    .withOffset(new Vec3(offset.x, offset.y, offset.z));
+            final boolean includePosition = config.get("position").getAsBoolean();
+            assertEquals(expected.get("found").getAsBoolean(), attachment.hasLocator(includePosition));
+            assertArrayEquals(values(expected.getAsJsonArray("matrix")),
+                    attachment.matrix(includePosition, config.get("rotation").getAsBoolean()).values());
+        }
+        assertEquals(192, cases.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeBirthProductsAndInitializationOrder() throws Exception {
+        final var cases = fixture("native-particle-birth-transform-result.json");
+        for (final var row : cases) {
+            final var expected = row.getAsJsonObject();
+            final var config = expected.getAsJsonObject("config");
+            final var position = vector(config.getAsJsonArray("position"));
+            final var velocity = vector(config.getAsJsonArray("velocity"));
+            final var facing = vector(config.getAsJsonArray("facing"));
+            final var space = new BedrockParticleSpace(config.get("local_position").getAsBoolean(),
+                    config.get("local_rotation").getAsBoolean(), config.get("local_velocity").getAsBoolean());
+            final var initialization = expected.getAsJsonArray("trace").get(1).getAsJsonObject();
+            space.birth(new BedrockParticleAttachment.Matrix(values(config.getAsJsonArray("matrix"))),
+                    config.get("locator_found").getAsBoolean(), position, velocity, facing, () -> {
+                        assertVector(initialization.getAsJsonArray("position"), position);
+                        assertVector(initialization.getAsJsonArray("velocity"), velocity);
+                        assertVector(initialization.getAsJsonArray("facing"), facing);
+                    }, vector(config.getAsJsonArray("inherited")));
+            assertVector(expected.getAsJsonArray("position"), position);
+            assertVector(expected.getAsJsonArray("velocity"), velocity);
+            assertVector(expected.getAsJsonArray("facing"), facing);
+        }
+        assertEquals(60, cases.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeRenderPositionProducts() throws Exception {
+        final var cases = fixture("native-particle-render-position-result.json");
+        for (final var row : cases) {
+            final var expected = row.getAsJsonObject();
+            final var previous = vector(expected.getAsJsonArray("previous"));
+            final var current = vector(expected.getAsJsonArray("current"));
+            current.sub(previous).mul(expected.get("alpha").getAsFloat()).add(previous);
+            final var matrix = new BedrockParticleAttachment.Matrix(values(expected.getAsJsonArray("matrix")));
+            assertVector(expected.getAsJsonArray("position"), matrix.position(current));
+        }
+        assertEquals(180, cases.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeEmitterOriginsCachedVelocityAndActorLoss() throws Exception {
+        final var cases = fixture("native-particle-attachment-update-result.json");
+        for (final var row : cases) {
+            final var expected = row.getAsJsonObject();
+            final var config = expected.getAsJsonObject("config");
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            final var local = new JsonObject();
+            local.addProperty("position", config.get("local_position").getAsBoolean());
+            local.addProperty("rotation", config.get("local_rotation").getAsBoolean());
+            local.addProperty("velocity", config.get("local_velocity").getAsBoolean());
+            components.add("minecraft:emitter_local_space", local);
+            components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 1);
+            components.getAsJsonObject("minecraft:emitter_lifetime_once").addProperty("active_time", 10);
+            components.getAsJsonObject("minecraft:particle_lifetime_expression").addProperty("max_lifetime", 10);
+            final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+            for (final var item : expected.getAsJsonArray("steps")) {
+                final var step = item.getAsJsonObject();
+                final var shift = vector(step.getAsJsonArray("translation"));
+                final var actorPosition = new Vec3(10.5F + shift.x, -2F + shift.y, 7F + shift.z);
+                final var locator = config.get("locator_found").getAsBoolean()
+                        ? new Matrix4f().translation(2F + shift.x, -3F + shift.y, 4F + shift.z) : null;
+                final var attachment = step.get("actor").getAsBoolean()
+                        ? new BedrockParticleAttachment(actorPosition, config.get("yaw").getAsFloat(), locator, null, java.util.Map.of()) : null;
+                emitter.advance(step.get("nanos").getAsLong(), 1000, attachment, (x, y, z) -> List.of());
+                assertVector(step.getAsJsonArray("origin"), field(emitter, "currentOrigin"));
+                assertVector(step.getAsJsonArray("velocity"), field(emitter, "inheritedVelocity"));
+                assertEquals(step.get("population").getAsInt(), emitter.size());
+            }
+        }
+        assertEquals(48, cases.size());
+    }
+
+    @Test
+    void followsLocalAttachmentsAndKeepsUnboundBirthsFixed() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:emitter_local_space", JsonParser.parseString("{\"position\":true,\"rotation\":true}"));
+        components.add("minecraft:emitter_shape_point", JsonParser.parseString("{\"offset\":[1,2,3]}"));
+        final var effect = BedrockParticleEffect.read(document);
+        final var local = effect.emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var fixed = effect.emitter(new BedrockMolang(), new Random(1), new Vec3(10, 20, 30));
+        final var matrix = new Matrix4f().translation(2, 4, 6).scale(2, 3, 4);
+        local.advance(0, 10, new BedrockParticleAttachment(Vec3.ZERO, 180, matrix, null, java.util.Map.of()), (x, y, z) -> List.of());
+        fixed.advance(0, 10, null, (x, y, z) -> List.of());
+        assertEquals(new Vector3f(4, 10, 18), local.visuals().getFirst().position());
+        assertEquals(new Vector3f(11, 22, 33), fixed.visuals().getFirst().position());
+        matrix.translation(100, 200, 300);
+        // A frame owns its matrix snapshot until the next actor sample.
+        assertEquals(new Vector3f(4, 10, 18), local.visuals().getFirst().position());
+        local.advance(0, 0, new BedrockParticleAttachment(Vec3.ZERO, 180, matrix, null, java.util.Map.of()), (x, y, z) -> List.of());
+        assertEquals(new Vector3f(101, 202, 303), local.visuals().getFirst().position());
+        local.advance(0, 0, null, (x, y, z) -> List.of());
+        assertEquals(0, local.size());
+        fixed.advance(0, 0, null, (x, y, z) -> List.of());
+        assertEquals(new Vector3f(11, 22, 33), fixed.visuals().getFirst().position());
+    }
+
+    private static Vector3f field(final Object object, final String name) throws Exception {
+        final var field = object.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        return (Vector3f) field.get(object);
+    }
+    private static JsonArray fixture(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE")).resolve(name)))
+                .getAsJsonObject().getAsJsonArray("cases");
+    }
+    private static float[] values(final JsonArray array) {
+        final float[] values = new float[array.size()];
+        for (int index = 0; index < values.length; index++) values[index] = array.get(index).getAsFloat();
+        return values;
+    }
+    private static Vector3f vector(final JsonArray array) { return new Vector3f(values(array)); }
+    private static void assertVector(final JsonArray expected, final Vector3f actual) {
+        for (int axis = 0; axis < 3; axis++) assertEquals(expected.get(axis).getAsFloat(), actual.get(axis));
+    }
+}
