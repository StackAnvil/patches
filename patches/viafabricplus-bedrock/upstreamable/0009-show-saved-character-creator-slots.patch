+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.HashMap;
+import java.util.UUID;
+
+final class BedrockEmoteMessagesTest {
+    @Test
+    void substitutesNamesWithoutParsingThemAndPreservesNativeMarkerOrder() {
+        assertEquals("§bA&B@C§r §ahello§r", BedrockEmoteMessages.format("@ &hello&", "A&B@C"));
+        assertEquals("@ &", BedrockEmoteMessages.format("\\@ \\&", "Player"));
+        assertEquals("\\x\\§bPlayer§r", BedrockEmoteMessages.format("\\x\\@", "Player"));
+        assertEquals("§ax§bPlayer§r y§r", BedrockEmoteMessages.format("&x@ y", "Player"));
+        assertEquals("§a", BedrockEmoteMessages.format("&", "Player"));
+    }
+
+    @Test
+    void readsBothPackLayoutsAndFallsBackPerKeyWithoutReplacingEmptyTranslations()
+            throws Exception {
+        final var files = new HashMap<String, byte[]>();
+        files.put(
+                "en_US.lang",
+                bytes(
+                        "\uFEFFpersona.emote.chat_message=@ &hello&.\r\n"
+                                + "persona.emote.easter_egg=@ again.\t###{LOCKED}\r\n"));
+        files.put("texts/de_DE.lang", bytes("persona.emote.chat_message=@ hallo=ja.\n"));
+        var messages = BedrockEmoteMessages.read(files);
+        assertEquals("§bPlayer§r hallo=ja.", messages.message("de_de", false, "Player"));
+        assertEquals("§bPlayer§r again.", messages.message("de_de", true, "Player"));
+        assertEquals("§bPlayer§r §ahello§r.", messages.message("fr_fr", false, "Player"));
+        files.put("texts/de_DE.lang", bytes("persona.emote.chat_message=\n"));
+        assertEquals("", BedrockEmoteMessages.read(files).message("de_de", false, "Player"));
+        files.put("texts/en_US.lang", bytes("persona.emote.chat_message=Different"));
+        assertThrows(IOException.class, () -> BedrockEmoteMessages.read(files));
+    }
+
+    @Test
+    void extendsTheCooldownAndResetsRepeatsForAnotherEmoteOrAnExpiredChain() {
+        final var repeat = new BedrockEmoteMessages.Repeat();
+        final UUID first = UUID.randomUUID();
+        final UUID second = UUID.randomUUID();
+        assertEquals(false, repeat.select(first, 0));
+        assertNull(repeat.select(second, 1000));
+        assertNull(repeat.select(second, 2499));
+        assertEquals(false, repeat.select(second, 3999));
+        assertEquals(false, repeat.select(second, 5499));
+        assertEquals(false, repeat.select(second, 6999));
+        assertEquals(false, repeat.select(second, 8499));
+        assertEquals(true, repeat.select(second, 9999));
+        assertEquals(false, repeat.select(second, 10000));
+        assertEquals(false, repeat.select(second, 40001));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_EMOTE_MESSAGES_RESULT", matches = ".+")
+    void matchesIndependentNativeFormattingAndRepeatExecution() throws Exception {
+        final var result =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_EMOTE_MESSAGES_RESULT"))))
+                        .getAsJsonObject();
+        for (final var value : result.getAsJsonArray("formats")) {
+            final var row = value.getAsJsonObject();
+            assertEquals(
+                    row.get("result").getAsString(),
+                    BedrockEmoteMessages.format(
+                            row.get("template").getAsString(), row.get("player").getAsString()));
+        }
+        for (final var sequence : result.getAsJsonArray("repeats")) {
+            final var repeat = new BedrockEmoteMessages.Repeat();
+            for (final var value : sequence.getAsJsonArray()) {
+                final var row = value.getAsJsonObject();
+                final UUID id = UUID.nameUUIDFromBytes(bytes(row.get("id").getAsString()));
+                final Boolean expected =
+                        row.get("result").isJsonNull() ? null : row.get("result").getAsBoolean();
+                assertEquals(expected, repeat.select(id, row.get("time").getAsLong()));
+            }
+        }
+    }
+
+    private static byte[] bytes(final String value) {
+        return value.getBytes(StandardCharsets.UTF_8);
+    }
+}
