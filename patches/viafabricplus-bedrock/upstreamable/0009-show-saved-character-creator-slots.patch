+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleDispatchTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void initializesChildrenInlineBeforeSourceExpressionsLikeNativeDispatch() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-child-actor-context-result.json"))).getAsJsonObject();
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final List<Integer> actual = new ArrayList<>();
+            final var childEnvironment = new BedrockMolang();
+            final var initialized = BedrockMolang.Program.parse(new com.google.gson.JsonPrimitive("v.initialized"), 0);
+            final var source = new BedrockMolang();
+            source.variable("source", 99);
+            final List<Integer> expected = new ArrayList<>();
+            for (final var receipt : row.getAsJsonArray("trace")) {
+                final var step = receipt.getAsJsonObject();
+                if (step.has("child_initialization")) expected.add(1);
+                if (step.has("source_expression")) expected.add(2);
+            }
+            source.queries(Map.of("trace", (BedrockActorAnimation.Query) _ -> {
+                assertEquals(expected.contains(1) ? 7 : 0, childEnvironment.evaluate(initialized, 0));
+                actual.add(2);
+                return 0;
+            }));
+            final var parentDocument = BedrockParticleEffectTest.burst();
+            final var definition = parentDocument.getAsJsonObject("particle_effect");
+            definition.add("events", JsonParser.parseString("""
+                    {"run":{"particle_effect":{"effect":"test:child","type":"emitter",
+                      "pre_effect_expression":"v.initialized=v.source+7;"},"expression":"q.trace();"}}
+                    """));
+            definition.getAsJsonObject("events").getAsJsonObject("run").getAsJsonObject("particle_effect")
+                    .addProperty("type", row.get("kind").getAsString());
+            final var components = definition.getAsJsonObject("components");
+            components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 0);
+            components.add("minecraft:emitter_lifetime_events", JsonParser.parseString("{\"creation_event\":\"run\"}"));
+            final var parent = BedrockParticleEffect.read(parentDocument).emitter(source, new Random(1), Vec3.ZERO);
+            final String binding = row.get("binding").getAsString();
+            final BedrockParticleAttachment attachment = binding.equals("none") ? null : binding.equals("actor")
+                    ? new BedrockParticleAttachment(Vec3.ZERO, 180, null, null, Map.of())
+                    : BedrockParticleAttachment.registry(Vec3.ZERO, Vec3.ZERO, 0, 0, 0, null);
+            parent.dispatcher(action -> {
+                final var request = assertInstanceOf(BedrockParticleEvents.Request.class, action);
+                if (!row.get("valid_handle").getAsBoolean()) return;
+                final var bound = request.spawn().kind() == BedrockParticleEvents.Kind.EMITTER_BOUND ? attachment : null;
+                try {
+                    final var child = BedrockParticleEffect.read(BedrockParticleEffectTest.burst())
+                            .emitter(childEnvironment, new Random(2), request.emitterTransform(bound, parent.baseOrigin()));
+                    child.queryContext(bound, Vec3.ZERO);
+                    child.initialize(request.spawn().initialization());
+                    if (childEnvironment.evaluate(initialized, 0) != 0) actual.add(1);
+                } catch (java.io.IOException invalid) { throw new AssertionError(invalid); }
+            });
+            parent.advance(0, 0, attachment, (x, y, z) -> List.of());
+            assertEquals(expected, actual, row.toString());
+        }
+    }
+
+    @Test
+    void sharesAvailablePopulationWithManualChildrenDuringBirths() throws Exception {
+        final var parentDocument = BedrockParticleEffectTest.burst();
+        final var definition = parentDocument.getAsJsonObject("particle_effect");
+        definition.add("events", JsonParser.parseString("""
+                {"birth":{"particle_effect":{"effect":"test:child","type":"particle"}}}
+                """));
+        definition.getAsJsonObject("components").add("minecraft:particle_lifetime_events",
+                JsonParser.parseString("{\"creation_event\":\"birth\"}"));
+        final var parent = BedrockParticleEffect.read(parentDocument).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var child = BedrockParticleEffect.read(BedrockParticleEventsTest.manual())
+                .emitter(new BedrockMolang(), new Random(2), Vec3.ZERO);
+        parent.dispatcher(action -> {
+            final var request = assertInstanceOf(BedrockParticleEvents.Request.class, action);
+            child.emit(request.position(), request.velocity(), 2 - parent.size() - child.size());
+        });
+        parent.advance(0, () -> 2 - parent.size() - child.size(), null, (x, y, z) -> List.of());
+        assertEquals(1, parent.size());
+        assertEquals(1, child.size());
+        assertEquals(parent.visuals().getFirst().position(), child.visuals().getFirst().position());
+    }
+}
