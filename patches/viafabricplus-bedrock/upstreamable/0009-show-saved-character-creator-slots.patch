+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.client.model.player.PlayerModel;
+import net.minecraft.client.renderer.entity.state.AvatarRenderState;
+
+import java.util.Map;
+
+/** Uses the authored tree during emotes and Java's humanoid pose during ordinary movement. */
+final class BedrockPlayerModel extends PlayerModel {
+    private final Map<String, ModelPart> children;
+    private final Map<String, ModelPart> ordinary;
+    private final BedrockAnimatedModel animated;
+
+    BedrockPlayerModel(
+            final ModelPart root,
+            final boolean slim,
+            final Map<String, ModelPart> children,
+            final BedrockAnimatedModel animated) {
+        super(root, slim);
+        this.children = children;
+        this.ordinary = Map.copyOf(children);
+        this.animated = animated;
+    }
+
+    @Override
+    public void setupAnim(final AvatarRenderState state) {
+        this.children.clear();
+        this.children.putAll(this.ordinary);
+        super.setupAnim(state);
+        if (!(state instanceof BedrockEmoteRenderState emote) || emote.bedrockEmotePose().isEmpty())
+            return;
+        this.animated.pose(emote.bedrockEmotePose());
+        this.animated.copyHumanoidPose(this);
+        this.children.clear();
+        this.children.put("emote", this.animated.model().root());
+    }
+}
