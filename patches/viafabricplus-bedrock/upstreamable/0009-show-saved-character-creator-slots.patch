+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+
+/** Immutable animation tracks with a separate Molang environment for each playback. */
+public final class BedrockBoneAnimation {
+    private final float length;
+    private final boolean loop;
+    private final boolean holdLastFrame;
+    private final boolean overridePose;
+    private final Map<String, Bone> bones;
+    private final BedrockMolang.Program blendWeight;
+    private final BedrockMolang.Program timeUpdate;
+    private final BedrockMolang.Program startDelay;
+    private final BedrockMolang.Program loopDelay;
+    private final List<TimelineEntry> timeline;
+    private final List<BedrockAnimationSound> sounds;
+    private final List<BedrockAnimationParticle> particles;
+
+    private BedrockBoneAnimation(
+            final float length,
+            final boolean loop,
+            final boolean holdLastFrame,
+            final boolean overridePose,
+            final Map<String, Bone> bones,
+            final BedrockMolang.Program blendWeight,
+            final BedrockMolang.Program timeUpdate,
+            final BedrockMolang.Program startDelay,
+            final BedrockMolang.Program loopDelay,
+            final List<TimelineEntry> timeline,
+            final List<BedrockAnimationSound> sounds,
+            final List<BedrockAnimationParticle> particles) {
+        this.length = length;
+        this.loop = loop;
+        this.holdLastFrame = holdLastFrame;
+        this.overridePose = overridePose;
+        this.bones = bones;
+        this.blendWeight = blendWeight;
+        this.timeUpdate = timeUpdate;
+        this.startDelay = startDelay;
+        this.loopDelay = loopDelay;
+        this.timeline = timeline;
+        this.sounds = sounds;
+        this.particles = particles;
+    }
+
+    public float length() {
+        return this.length;
+    }
+
+    public boolean loop() {
+        return this.loop;
+    }
+
+    public boolean holdLastFrame() {
+        return this.holdLastFrame;
+    }
+
+    public boolean overridePose() {
+        return this.overridePose;
+    }
+
+    private static final Vector ZERO = new Vector(0, 0, 0);
+    private static final Vector ONE = new Vector(1, 1, 1);
+
+    public static BedrockBoneAnimation parse(final JsonObject animation) throws IOException {
+        try {
+            final JsonObject definitions = animation.has("bones")
+                    ? animation.getAsJsonObject("bones") : new JsonObject();
+            if (definitions.size() > 256)
+                throw new IOException("Invalid animation bone count");
+            final Map<String, Bone> bones = new LinkedHashMap<>();
+            final List<TimelineEntry> timeline = TimelineEntry.parse(animation.get("timeline"));
+            final List<BedrockAnimationSound> sounds = BedrockAnimationSound.read(animation.get("sound_effects"));
+            final var particles = BedrockAnimationParticle.timeline(animation.get("particle_effects"));
+            float end = Math.max(
+                    timeline.isEmpty() ? 0 : timeline.getLast().time,
+                    sounds.isEmpty() ? 0 : sounds.getLast().time());
+            end = Math.max(end, particles.isEmpty() ? 0 : particles.getLast().time());
+            for (final var entry : definitions.entrySet()) {
+                final JsonObject definition = entry.getValue().getAsJsonObject();
+                final JsonObject relative = definition.getAsJsonObject("relative_to");
+                if (relative != null
+                        && (relative.size() != 1
+                                || !relative.has("rotation")
+                                || !"entity".equals(relative.get("rotation").getAsString())))
+                    throw new IOException("Invalid animation rotation space");
+                final Channel position = Channel.parse(definition.get("position"), ZERO);
+                final Channel rotation = Channel.parse(definition.get("rotation"), ZERO);
+                final Channel scale = Channel.parse(definition.get("scale"), ONE);
+                bones.put(entry.getKey(), new Bone(position, rotation, scale, relative != null));
+                end =
+                        Math.max(
+                                end,
+                                Math.max(position.end(), Math.max(rotation.end(), scale.end())));
+            }
+            final float length =
+                    animation.has("animation_length")
+                            ? animation.get("animation_length").getAsFloat()
+                            : (end > 0 ? end : 1);
+            if (!Float.isFinite(length) || length <= 0 || length > 600)
+                throw new IOException("Invalid animation length");
+            final JsonElement looping = animation.get("loop");
+            final boolean hold =
+                    looping != null && "hold_on_last_frame".equals(looping.getAsString());
+            final boolean loop = looping != null && !hold && looping.getAsBoolean();
+            return new BedrockBoneAnimation(
+                    length,
+                    loop,
+                    hold,
+                    animation.has("override_previous_animation")
+                            && animation.get("override_previous_animation").getAsBoolean(),
+                    Map.copyOf(bones),
+                    BedrockMolang.Program.parse(animation.get("blend_weight"), 1),
+                    animation.has("anim_time_update")
+                            ? BedrockMolang.Program.parse(animation.get("anim_time_update"), 0)
+                            : null,
+                    BedrockMolang.Program.parse(animation.get("start_delay"), 0),
+                    BedrockMolang.Program.parse(animation.get("loop_delay"), 0),
+                    timeline,
+                    sounds, particles);
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid Bedrock bone animation", e);
+        }
+    }
+
+    private record TimelineEntry(float time, BedrockMolang.Program script) {
+        private static List<TimelineEntry> parse(final JsonElement json) throws IOException {
+            if (json == null) return List.of();
+            if (!json.isJsonObject() || json.getAsJsonObject().size() > 4096)
+                throw new IOException("Invalid animation timeline");
+            final List<TimelineEntry> entries = new ArrayList<>();
+            for (final var entry : json.getAsJsonObject().entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 600)
+                    throw new IOException("Invalid animation event time");
+                final JsonElement value = entry.getValue();
+                if (value.isJsonArray()) {
+                    for (final JsonElement script : value.getAsJsonArray())
+                        add(entries, time, script);
+                } else add(entries, time, value);
+            }
+            // The target normalizes entries with a stable sort, including equal numeric keys.
+            entries.sort(Comparator.comparingDouble(TimelineEntry::time));
+            return List.copyOf(entries);
+        }
+
+        private static void add(
+                final List<TimelineEntry> entries, final float time, final JsonElement script)
+                throws IOException {
+            if (entries.size() >= 4096)
+                throw new IOException("Too many animation timeline scripts");
+            if (script.isJsonObject())
+                throw new IOException("This animation needs named actor event playback");
+            if (!script.isJsonPrimitive() || !script.getAsJsonPrimitive().isString())
+                throw new IOException("Invalid animation timeline script");
+            entries.add(new TimelineEntry(time, BedrockMolang.Program.parse(script, 0)));
+        }
+    }
+
+    public Playback playback() {
+        return new Playback(new BedrockMolang());
+    }
+
+    Playback playback(final BedrockMolang molang) {
+        return new Playback(molang);
+    }
+
+    void compose(
+            final Map<String, Transform> pose,
+            final Map<String, Transform> sampled,
+            final float weight) {
+        sampled.forEach(
+                (name, transform) -> {
+                    final Transform previous =
+                            pose.getOrDefault(name, new Transform(ZERO, ZERO, ONE, false));
+                    final Transform base =
+                            this.overridePose ? new Transform(ZERO, ZERO, ONE, false) : previous;
+                    pose.put(
+                            name,
+                            new Transform(
+                                    base.position.add(transform.position.multiply(weight)),
+                                    base.rotation.add(transform.rotation.multiply(weight)),
+                                    base.scale.multiply(transform.scale.blend(ONE, weight)), base.entityRelativeRotation || transform.entityRelativeRotation));
+                });
+    }
+
+    static void blendStates(
+            final Map<String, Transform> pose,
+            final Map<String, Transform> before,
+            final Map<String, Transform> after,
+            final float fraction) {
+        final var names = new java.util.HashSet<>(before.keySet());
+        names.addAll(after.keySet());
+        final Transform identity = new Transform(ZERO, ZERO, ONE, false);
+        for (final String name : names) {
+            final Transform base = pose.getOrDefault(name, identity),
+                    old = before.getOrDefault(name, identity),
+                    next = after.getOrDefault(name, identity);
+            pose.put(
+                    name,
+                    new Transform(
+                            base.position.add(old.position.interpolate(next.position, fraction)),
+                            base.rotation.add(
+                                    new Vector(
+                                            angle(old.rotation.x, next.rotation.x, fraction),
+                                            angle(old.rotation.y, next.rotation.y, fraction),
+                                            angle(old.rotation.z, next.rotation.z, fraction))),
+                            base.scale.multiply(old.scale.interpolate(next.scale, fraction)),
+                            base.entityRelativeRotation
+                                    || old.entityRelativeRotation
+                                    || next.entityRelativeRotation));
+        }
+    }
+
+    private static float angle(final float before, final float after, final float fraction) {
+        final float shifted = after - before + 180;
+        final float remainder = shifted % 360;
+        return before + ((remainder < 0 ? remainder + 360 : remainder) - 180) * fraction;
+    }
+
+    public final class Playback {
+        private final BedrockMolang molang;
+        private float previousElapsed = Float.NaN;
+        private float clock;
+        private float previousEventTime = -1;
+        private float delay = Float.NaN;
+        private boolean completed;
+        private Map<String, Transform> pose = Map.of();
+
+        private Playback(final BedrockMolang molang) {
+            this.molang = molang;
+        }
+
+        /** Whether this playback has reached its end at least once, including a loop. */
+        public boolean completed() {
+            return this.completed;
+        }
+
+        /** A stopped track contributes no pose; held tracks retain their final frame. */
+        public boolean stopped() {
+            return !loop && !holdLastFrame && this.clock > length;
+        }
+
+        public Map<String, Transform> sample(final float elapsed, final Map<String, ?> queries) {
+            return this.sample(elapsed, queries, Map.of());
+        }
+
+        public Map<String, Transform> sample(
+                final float elapsed, final Map<String, ?> queries,
+                final boolean eventsEnabled, final Consumer<BedrockAnimationSound> sounds) {
+            return this.sample(elapsed, queries, Map.of(), eventsEnabled, sounds);
+        }
+
+        Map<String, Transform> sample(
+                final float elapsed,
+                final Map<String, ?> queries,
+                final Map<String, Transform> currentPose) {
+            return this.sample(elapsed, queries, currentPose, true, null);
+        }
+
+        public Map<String, Transform> sample(
+                final float elapsed, final Map<String, ?> queries, final boolean eventsEnabled,
+                final Consumer<BedrockAnimationSound> soundOutput,
+                final Consumer<BedrockAnimationParticle.Cue> particleOutput) {
+            return this.sample(elapsed, queries, Map.of(), eventsEnabled, soundOutput, particleOutput);
+        }
+
+        Map<String, Transform> sample(
+                final float elapsed, final Map<String, ?> queries,
+                final Map<String, Transform> currentPose, final boolean eventsEnabled,
+                final Consumer<BedrockAnimationSound> soundOutput) {
+            return this.sample(elapsed, queries, currentPose, eventsEnabled, soundOutput, null);
+        }
+
+        Map<String, Transform> sample(
+                final float elapsed, final Map<String, ?> queries,
+                final Map<String, Transform> currentPose, final boolean eventsEnabled,
+                final Consumer<BedrockAnimationSound> soundOutput,
+                final Consumer<BedrockAnimationParticle.Cue> particleOutput) {
+            if (!Float.isFinite(elapsed)) return Map.of();
+            final float time = Math.max(0, elapsed);
+            if (time < this.previousElapsed) {
+                this.previousElapsed = Float.NaN;
+                this.clock = 0;
+                this.previousEventTime = -1;
+                this.delay = Float.NaN;
+                this.completed = false;
+            }
+            if (time == this.previousElapsed) return this.pose;
+            float delta = Float.isNaN(this.previousElapsed) ? time : time - this.previousElapsed;
+            this.previousElapsed = time;
+            this.pose = Map.of();
+            this.molang.queries(queries, this.clock, time, delta);
+            final float weight = Math.clamp(this.molang.evaluate(blendWeight, 1), 0, 1);
+            if (weight < Math.ulp(1F)) return this.pose;
+            if (Float.isNaN(this.delay))
+                this.delay = Math.max(0, this.molang.evaluate(startDelay, 0));
+            if (this.delay > 0) {
+                this.delay -= delta;
+                // The target player retains the full delta when delay reaches exactly zero.
+                if (this.delay < 0) delta = -this.delay;
+            }
+            if (this.delay > 0) return this.pose;
+            this.molang.queries(queries, this.clock, time, delta);
+            this.clock = this.molang.evaluate(timeUpdate, this.clock + delta);
+            if (this.clock >= length) {
+                this.completed = true;
+                this.delay = 0;
+            }
+            if (holdLastFrame) this.clock = Math.min(this.clock, length);
+            else if (loop && this.completed) {
+                // The native completion flag persists, so this runs on every later active update.
+                this.delay = Math.max(0, this.molang.evaluate(loopDelay, 0));
+                if (this.clock > length) {
+                    this.previousEventTime = -1;
+                    this.clock %= length;
+                }
+            }
+            if (this.stopped()) return this.pose;
+            this.molang.queries(queries, this.clock, time, delta);
+            final Map<String, Transform> result = new LinkedHashMap<>();
+            bones.forEach(
+                    (name, bone) -> {
+                        final Transform current =
+                                overridePose
+                                        ? new Transform(ZERO, ZERO, ONE, false)
+                                        : currentPose.getOrDefault(
+                                                name, new Transform(ZERO, ZERO, ONE, false));
+                        result.put(
+                                name,
+                                new Transform(
+                                        bone.position()
+                                                .sample(this.clock, this.molang, current.position())
+                                                .blend(ZERO, weight),
+                                        bone.rotation()
+                                                .sample(this.clock, this.molang, current.rotation())
+                                                .blend(ZERO, weight),
+                                        bone.scale()
+                                                .sample(this.clock, this.molang, current.scale())
+                                                .blend(ONE, weight),
+                                        bone.entityRelativeRotation));
+                    });
+            this.pose = Map.copyOf(result);
+            if (eventsEnabled) {
+                if (particleOutput != null)
+                    for (final BedrockAnimationParticle particle : particles)
+                        if (this.previousEventTime < particle.time() && particle.time() <= this.clock)
+                            particleOutput.accept(new BedrockAnimationParticle.Cue(particle, this.molang.copy()));
+                if (soundOutput != null)
+                    for (final BedrockAnimationSound sound : sounds)
+                        if (this.previousEventTime < sound.time() && sound.time() <= this.clock)
+                            soundOutput.accept(sound);
+                for (final TimelineEntry entry : timeline)
+                    if (this.previousEventTime < entry.time && entry.time <= this.clock)
+                        this.molang.evaluate(entry.script, 0);
+            }
+            this.previousEventTime = this.clock;
+            return this.pose;
+        }
+    }
+
+    public record Transform(Vector position, Vector rotation, Vector scale, boolean entityRelativeRotation) {}
+
+    public record Vector(float x, float y, float z) {
+        private Vector add(final Vector value) {
+            return new Vector(this.x + value.x, this.y + value.y, this.z + value.z);
+        }
+
+        private Vector multiply(final float value) {
+            return new Vector(this.x * value, this.y * value, this.z * value);
+        }
+
+        private Vector multiply(final Vector value) {
+            return new Vector(this.x * value.x, this.y * value.y, this.z * value.z);
+        }
+
+        private Vector blend(final Vector base, final float weight) {
+            return new Vector(
+                    base.x + (this.x - base.x) * weight,
+                    base.y + (this.y - base.y) * weight,
+                    base.z + (this.z - base.z) * weight);
+        }
+
+        private Vector interpolate(final Vector next, final float fraction) {
+            return next.blend(this, fraction);
+        }
+
+        private Vector catmull(
+                final Vector before, final Vector next, final Vector after, final float t) {
+            return new Vector(
+                    catmull(before.x, this.x, next.x, after.x, t),
+                    catmull(before.y, this.y, next.y, after.y, t),
+                    catmull(before.z, this.z, next.z, after.z, t));
+        }
+
+        private static float catmull(
+                final float a, final float b, final float c, final float d, final float t) {
+            return 0.5F
+                    * ((2 * b)
+                            + (-a + c) * t
+                            + (2 * a - 5 * b + 4 * c - d) * t * t
+                            + (-a + 3 * b - 3 * c + d) * t * t * t);
+        }
+    }
+
+    private record Bone(Channel position, Channel rotation, Channel scale, boolean entityRelativeRotation) {}
+
+    private record Components(
+            BedrockMolang.Program x,
+            BedrockMolang.Program y,
+            BedrockMolang.Program z,
+            Vector fallback) {
+        private static Components parse(final JsonElement json, final Vector fallback)
+                throws IOException {
+            if (json == null) return new Components(null, null, null, fallback);
+            if (json.isJsonArray()) {
+                final var values = json.getAsJsonArray();
+                if (values.size() != 1 && values.size() != 3)
+                    throw new IOException("Invalid animation vector");
+                return new Components(
+                        BedrockMolang.Program.parse(values.get(0), fallback.x),
+                        BedrockMolang.Program.parse(
+                                values.get(values.size() == 1 ? 0 : 1), fallback.y),
+                        BedrockMolang.Program.parse(
+                                values.get(values.size() == 1 ? 0 : 2), fallback.z),
+                        fallback);
+            }
+            final var scalar = BedrockMolang.Program.parse(json, fallback.x);
+            return new Components(scalar, scalar, scalar, fallback);
+        }
+
+        private Vector evaluate(final BedrockMolang molang, final Vector current) {
+            return new Vector(
+                    this.x == null ? this.fallback.x : molang.evaluate(this.x, current.x),
+                    this.y == null ? this.fallback.y : molang.evaluate(this.y, current.y),
+                    this.z == null ? this.fallback.z : molang.evaluate(this.z, current.z));
+        }
+    }
+
+    private record Keyframe(float time, Components pre, Components post, boolean catmull) {}
+
+    private record Channel(List<Keyframe> keyframes) {
+        private static Channel parse(final JsonElement json, final Vector fallback)
+                throws IOException {
+            if (json == null || !json.isJsonObject()) {
+                final Components value = Components.parse(json, fallback);
+                return new Channel(List.of(new Keyframe(0, value, value, false)));
+            }
+            final List<Keyframe> frames = new ArrayList<>();
+            for (final var entry : json.getAsJsonObject().entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 600)
+                    throw new IOException("Invalid animation key time");
+                Components pre, post;
+                boolean catmull = false;
+                if (entry.getValue().isJsonObject()) {
+                    final JsonObject frame = entry.getValue().getAsJsonObject();
+                    if (!frame.has("pre") && !frame.has("post"))
+                        throw new IOException("Empty animation keyframe");
+                    pre =
+                            Components.parse(
+                                    frame.has("pre") ? frame.get("pre") : frame.get("post"),
+                                    fallback);
+                    post =
+                            Components.parse(
+                                    frame.has("post") ? frame.get("post") : frame.get("pre"),
+                                    fallback);
+                    final String mode =
+                            frame.has("lerp_mode")
+                                    ? frame.get("lerp_mode").getAsString()
+                                    : "linear";
+                    if (!mode.equals("linear") && !mode.equals("catmullrom"))
+                        throw new IOException("Unknown animation interpolation");
+                    catmull = mode.equals("catmullrom");
+                } else pre = post = Components.parse(entry.getValue(), fallback);
+                frames.add(new Keyframe(time, pre, post, catmull));
+            }
+            if (frames.isEmpty() || frames.size() > 4096)
+                throw new IOException("Invalid animation keyframe count");
+            frames.sort(Comparator.comparingDouble(Keyframe::time));
+            for (int index = 1; index < frames.size(); index++) {
+                if (frames.get(index).time == frames.get(index - 1).time)
+                    throw new IOException("Duplicate animation key time");
+            }
+            return new Channel(List.copyOf(frames));
+        }
+
+        private float end() {
+            return this.keyframes.getLast().time;
+        }
+
+        private Vector sample(final float time, final BedrockMolang molang, final Vector current) {
+            if (time < this.keyframes.getFirst().time)
+                return this.keyframes.getFirst().pre.evaluate(molang, current);
+            // Search sorted times so dense native emotes do not scan every keyframe per frame.
+            int low = 0, high = this.keyframes.size();
+            while (low < high) {
+                final int middle = (low + high) >>> 1;
+                if (this.keyframes.get(middle).time <= time) low = middle + 1;
+                else high = middle;
+            }
+            final int previousIndex = low - 1;
+            final Keyframe previous = this.keyframes.get(previousIndex);
+            final Vector value = previous.post.evaluate(molang, current);
+            if (low == this.keyframes.size() || time == previous.time) return value;
+            final Keyframe next = this.keyframes.get(low);
+            final float fraction = (time - previous.time) / (next.time - previous.time);
+            final Vector nextValue = next.pre.evaluate(molang, current);
+            if (!previous.catmull && !next.catmull) return value.interpolate(nextValue, fraction);
+            final Vector before =
+                    this.keyframes.get(Math.max(0, previousIndex - 1)).post.evaluate(molang, current);
+            final Vector after =
+                    this.keyframes
+                            .get(Math.min(this.keyframes.size() - 1, low + 1))
+                            .pre
+                            .evaluate(molang, current);
+            return value.catmull(before, nextValue, after, fraction);
+        }
+    }
+}
