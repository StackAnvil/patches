+
+    @Test
+    void resetsTheTimelineCursorOnReplayAndRunsEventOnlyAnimations() throws Exception {
+        final var molang = new BedrockMolang();
+        final var player =
+                animation(
+                                """
+                                {"timeline":{"0":"v.starts=(v.starts??0)+1;",
+                                   "1":"v.ends=(v.ends??0)+1;"}}
+                                """)
+                        .playback(molang);
+        final var starts = BedrockMolang.Program.parse(JsonParser.parseString("\"v.starts\""), 0);
+        final var ends = BedrockMolang.Program.parse(JsonParser.parseString("\"v.ends??0\""), 0);
+        assertTrue(player.sample(0, Map.of()).isEmpty());
+        assertEquals(1, molang.evaluate(starts, 0));
+        player.sample(0, Map.of());
+        assertEquals(1, molang.evaluate(starts, 0));
+        player.sample(1, Map.of());
+        assertEquals(1, molang.evaluate(ends, 0));
+        player.sample(2, Map.of());
+        assertTrue(player.stopped());
+        player.sample(0, Map.of());
+        assertFalse(player.completed());
+        assertEquals(2, molang.evaluate(starts, 0));
+        assertEquals(1, molang.evaluate(ends, 0));
+    }
+
+    @Test
+    void rejectsInvalidAndOversizedTimelinesBeforePlayback() {
+        for (final String timeline :
+                new String[] {
+                    "[]", "{\"NaN\":\"v.a=1;\"}", "{\"-1\":\"v.a=1;\"}",
+                    "{\"601\":\"v.a=1;\"}", "{\"0\":null}", "{\"0\":[1]}",
+                    "{\"0\":{\"event\":\"attack\"}}", "{\"0\":\"v.a=);\"}"
+                })
+            assertThrows(IOException.class, () -> animation("{\"timeline\":" + timeline + "}"));
+        final var source = new JsonObject();
+        final var timeline = new JsonObject();
+        final var scripts = new JsonArray();
+        for (int i = 0; i < 4097; i++) scripts.add("v.a=1;");
+        timeline.add("0", scripts);
+        source.add("timeline", timeline);
+        assertThrows(IOException.class, () -> BedrockBoneAnimation.parse(source));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_TIMELINE_RESULT", matches = ".+")
+    void matchesIndependentTargetGameTimelineNormalizationAndPlayback() throws Exception {
+        final var cases =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(
+                                                System.getenv(
+                                                        "STACKANVIL_ANIMATION_TIMELINE_RESULT"))))
+                        .getAsJsonArray();
+        for (final var element : cases) {
+            final var data = element.getAsJsonObject();
+            final var config = data.getAsJsonObject("config");
+            final var source =
+                    JsonParser.parseString(
+                                    """
+                                    {"animation_length":1,"bones":{"head":{"position":["v.events??0","q.anim_time",0]}}}
+                                    """)
+                            .getAsJsonObject();
+            for (final String field : new String[] {"start_delay", "loop_delay"}) {
+                final String key = field.equals("start_delay") ? "start" : field;
+                source.addProperty(field, config.has(key) ? config.get(key).getAsFloat() : 0);
+            }
+            source.addProperty(
+                    "blend_weight", config.has("weight") ? config.get("weight").getAsFloat() : 1);
+            source.addProperty(
+                    "anim_time_update",
+                    "q.override ? q.clock : q.anim_time+q.delta_time*"
+                            + (config.has("speed") ? config.get("speed").getAsFloat() : 1));
+            final int mode = config.has("loop") ? config.get("loop").getAsInt() : 0;
+            if (mode == 2) source.addProperty("loop", "hold_on_last_frame");
+            else source.addProperty("loop", mode == 1);
+            final var timeline = new JsonObject();
+            final var entries = data.getAsJsonArray("entries");
+            for (int i = 0; i < entries.size(); i++) {
+                final String key = Float.toString(entries.get(i).getAsFloat());
+                if (!timeline.has(key)) timeline.add(key, new JsonArray());
+                timeline.getAsJsonArray(key)
+                        .add(
+                                "v.events=math.mod((v.events??0)*10+"
+                                        + (i + 1)
+                                        + ",30000);v.event_time=q.anim_time;v.event_delta=q.delta_time;");
+            }
+            source.add("timeline", timeline);
+            final var molang = new BedrockMolang();
+            final var player = BedrockBoneAnimation.parse(source).playback(molang);
+            final var count =
+                    BedrockMolang.Program.parse(JsonParser.parseString("\"v.events??0\""), 0);
+            final var eventTime =
+                    BedrockMolang.Program.parse(JsonParser.parseString("\"v.event_time??0\""), 0);
+            final var eventDelta =
+                    BedrockMolang.Program.parse(JsonParser.parseString("\"v.event_delta??0\""), 0);
+            float elapsed = 0, previous = Float.NaN;
+            for (final var frame : data.getAsJsonArray("steps")) {
+                final var expected = frame.getAsJsonObject();
+                elapsed += expected.get("delta").getAsFloat();
+                final var override = expected.get("clock_override");
+                final var pose =
+                        player.sample(
+                                elapsed,
+                                override.isJsonNull()
+                                        ? Map.of()
+                                        : Map.of("override", 1F, "clock", override.getAsFloat()));
+                assertEquals(expected.get("value").getAsInt(), molang.evaluate(count, 0));
+                assertEquals(expected.get("completed").getAsInt() == 1, player.completed());
+                assertEquals(expected.get("sampled").getAsBoolean(), !pose.isEmpty());
+                // Repeated Java render passes retain their already sampled pose.
+                if (!pose.isEmpty() && elapsed != previous) {
+                    assertEquals(
+                            expected.get("pose_events").getAsInt(),
+                            pose.get("head").position().x());
+                    assertEquals(
+                            expected.get("clock").getAsFloat(),
+                            pose.get("head").position().y(),
+                            0.000001F);
+                }
+                final var events = expected.getAsJsonArray("events");
+                if (!events.isEmpty()) {
+                    final var last = events.get(events.size() - 1).getAsJsonObject();
+                    assertEquals(
+                            last.get("clock").getAsFloat(),
+                            molang.evaluate(eventTime, 0),
+                            0.000001F);
+                    assertEquals(
+                            last.get("delta").getAsFloat(),
+                            molang.evaluate(eventDelta, 0),
+                            0.000001F);
+                }
+                previous = elapsed;
+            }
+        }
+    }
+
+    @Test
+    void rejectsAmbiguousKeysAndInvalidPrograms() {
+        assertThrows(
