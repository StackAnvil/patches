+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockActorStateTest {
+    @Test
+    void usesNativeBlockingFlagsAcrossActorReplacementAndRemoval() {
+        final UUID player = UUID.randomUUID(), lifetime = UUID.randomUUID(), replacement = UUID.randomUUID();
+        try {
+            assertTrue(BedrockActorState.isBlocking(player, true));
+            assertFalse(BedrockActorState.isBlocking(player, false));
+            BedrockActorState.apply(snapshot(player, lifetime, Set.of(ActorFlags.BLOCKING, ActorFlags.TRANSITION_BLOCKING), null), null);
+            assertTrue(BedrockActorState.isBlocking(player, false));
+            BedrockActorState.apply(snapshot(player, replacement, Set.of(ActorFlags.BLOCKED_USING_SHIELD), null), null);
+            BedrockActorState.apply(new NativeActorMessage.Remove(player, lifetime, false), null);
+            assertFalse(BedrockActorState.isBlocking(player, true));
+            BedrockActorState.apply(new NativeActorMessage.Remove(player, replacement, false), null);
+            assertTrue(BedrockActorState.isBlocking(player, true));
+            BedrockActorState.clear();
+            assertFalse(BedrockActorState.isBlocking(player, false));
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_BLOCKING_REFERENCE", matches = ".+")
+    void matchesNativeBlockingQueryInstructions() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_BLOCKING_REFERENCE"), "native-blocking-query.json"))).getAsJsonObject();
+        final UUID player = UUID.randomUUID(), lifetime = UUID.randomUUID();
+        try {
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var row = entry.getAsJsonObject();
+                final var flags = java.util.EnumSet.noneOf(ActorFlags.class);
+                for (final var flag : row.getAsJsonArray("flags")) flags.add(ActorFlags.getByValue(flag.getAsInt()));
+                BedrockActorState.clear();
+                if (row.get("actor").getAsBoolean()) BedrockActorState.apply(snapshot(player, lifetime, flags, null), null);
+                assertEquals(row.get("blocking").getAsBoolean(), BedrockActorState.isBlocking(player, false));
+            }
+            assertEquals(64, fixture.getAsJsonArray("cases").size());
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    void updatesFlagsAndColorWithoutRetainingAProtocolPlayerObject() {
+        final UUID player = UUID.randomUUID(), lifetime = UUID.randomUUID();
+        try {
+            assertFalse(BedrockActorState.isCharging(player));
+            BedrockActorState.apply(snapshot(player, lifetime, true, 0xFF102030), null);
+            assertTrue(BedrockActorState.isCharging(player));
+            final var prior = BedrockActorState.spellColor(player, lifetime);
+            BedrockActorState.apply(snapshot(player, lifetime, false, 0x4080A0FF), null);
+            assertFalse(BedrockActorState.isCharging(player));
+            assertNotEquals(prior, BedrockActorState.spellColor(player, lifetime));
+            assertEquals(16 / 255F, prior.r());
+            final UUID replacement = UUID.randomUUID();
+            BedrockActorState.apply(snapshot(player, replacement, true, 0xFFABCDEF), null);
+            BedrockActorState.apply(new NativeActorMessage.Remove(player, lifetime, false), null);
+            assertEquals(BedrockMolangColor.ZERO, BedrockActorState.spellColor(player, lifetime));
+            assertEquals(0xAB / 255F, BedrockActorState.spellColor(player, replacement).r());
+            BedrockActorState.apply(new NativeActorMessage.Remove(player, replacement, false), null);
+            assertNull(BedrockActorState.lifetime(player));
+            assertEquals(BedrockMolangColor.ZERO, BedrockActorState.spellColor(player, replacement));
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    void mapsTheLocalAvatarAndClearsItsRuntimeIdentity() {
+        final UUID player = UUID.randomUUID();
+        final var source = snapshot(UUID.randomUUID(), UUID.randomUUID(), true, null);
+        try {
+            final var local = new NativeActorMessage.Snapshot(source.uuid(), source.lifetime(), true, source.runtimeId(), source.identifier(), source.name(),
+                    source.scale(), source.flags(), source.variant(), source.markVariant(), source.spellColor(), source.properties());
+            BedrockActorState.apply(local, player);
+            assertSame(local, BedrockActorState.state(player));
+            assertSame(local, BedrockActorState.stateByRuntimeId(local.runtimeId()));
+            BedrockActorState.clear();
+            assertNull(BedrockActorState.state(player));
+            assertNull(BedrockActorState.stateByRuntimeId(local.runtimeId()));
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_ACTIONS", matches = ".+")
+    void matchesCapturedNativeChargingTransitions() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_ITEM_ACTIONS"), "native-charging.json"))).getAsJsonArray();
+        final UUID player = UUID.randomUUID(), lifetime = UUID.randomUUID();
+        try {
+            for (final var entry : fixture) {
+                final var row = entry.getAsJsonObject();
+                BedrockActorState.clear();
+                if (row.get("actor").getAsBoolean()) {
+                    BedrockActorState.apply(snapshot(player, lifetime, row.get("charging").getAsBoolean(), null), null);
+                }
+                assertEquals(row.get("value").getAsFloat() != 0F, BedrockActorState.isCharging(player));
+            }
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeSpellColorWithTypedCoreMetadata() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), "native-spellcolor-query-result.json"))).getAsJsonObject();
+        final UUID player = UUID.randomUUID();
+        try {
+            for (final var entry : fixture.getAsJsonArray("cases")) {
+                final var row = entry.getAsJsonObject();
+                final var actor = new Entity(null, 1, 2, "minecraft:player", 3, player, EntityTypes26_3.PLAYER);
+                final int color = (int) row.get("argb").getAsLong(), kind = row.get("type").getAsInt();
+                final Object payload = switch (kind) {
+                    case 0 -> (byte) color;
+                    case 1 -> (short) color;
+                    case 2 -> color;
+                    case 3 -> (float) color;
+                    case 7 -> (long) color;
+                    case 8 -> new net.raphimc.viabedrock.protocol.model.Position3f(0, 0, 0);
+                    default -> throw new AssertionError(kind);
+                };
+                if (row.get("metadata").getAsBoolean() && row.get("span_bytes").getAsInt() >= 0x270) {
+                    actor.entityData().put(ActorDataIds.DATA_SPELL_CASTING_COLOR,
+                            new EntityData(ActorDataIds.DATA_SPELL_CASTING_COLOR.getValue(), EntityDataTypesBedrock.values()[kind], payload));
+                }
+                final var snapshot = actor.nativeActorSnapshot();
+                BedrockActorState.clear();
+                if (row.get("actor").getAsBoolean()) BedrockActorState.apply(snapshot, null);
+                final var actual = BedrockActorState.spellColor(player, snapshot.lifetime());
+                final var expected = row.getAsJsonArray("rgba");
+                assertEquals(expected.get(0).getAsFloat(), actual.r());
+                assertEquals(expected.get(1).getAsFloat(), actual.g());
+                assertEquals(expected.get(2).getAsFloat(), actual.b());
+                assertEquals(expected.get(3).getAsFloat(), actual.a());
+            }
+            assertEquals(1504, fixture.getAsJsonArray("cases").size());
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    private static NativeActorMessage.Snapshot snapshot(final UUID player, final UUID lifetime, final boolean charging, final Integer color) {
+        return snapshot(player, lifetime, charging ? Set.of(ActorFlags.CHARGING) : Set.of(), color);
+    }
+
+    private static NativeActorMessage.Snapshot snapshot(final UUID player, final UUID lifetime, final Set<ActorFlags> flags, final Integer color) {
+        return new NativeActorMessage.Snapshot(player, lifetime, false, 17, "minecraft:player", "Dinnerbone", 1F,
+                flags, 0, 0, color, Map.of());
+    }
+}
