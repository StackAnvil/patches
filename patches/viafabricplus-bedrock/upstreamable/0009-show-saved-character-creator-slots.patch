@@ -0,0 +1,92 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.client.Minecraft;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.NativeParticleLibrary;
+import net.raphimc.viabedrock.api.resourcepack.NativeSoundLibrary;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Shared server graphs, textures, audio and captions use accepted packs and already licensed assets. */
+final class BedrockServerResources {
+    private static final AtomicLong GENERATION = new AtomicLong();
+    private static volatile Snapshot snapshot;
+
+    private BedrockServerResources() {}
+
+    static void clear() { GENERATION.incrementAndGet(); snapshot = null; }
+
+    static synchronized BedrockResourceLibrary library() throws IOException {
+        final long generation = GENERATION.get();
+        final var cached = snapshot;
+        final var builtin = BedrockBuiltinAssets.loaded(ViaFabricPlusBedrock.impl().account().get());
+        if (cached != null && cached.generation == generation && cached.builtin == builtin) return cached.library;
+        final List<Map<String, byte[]>> packs;
+        if (cached != null && cached.generation == generation) packs = cached.packs;
+        else {
+            final ResourceManager resources = Minecraft.getInstance().getResourceManager();
+            final List<List<Map<String, byte[]>>> archives = new ArrayList<>();
+            read(resources, "sound_library.zip", NativeSoundLibrary::decode, archives);
+            read(resources, "sound_translations.zip", NativeSoundLibrary::decodeTranslations, archives);
+            read(resources, "particle_library.zip", NativeParticleLibrary::decode, archives);
+            packs = mergeLibraries(archives);
+        }
+        final var library = BedrockResourceLibrary.withServerPacks(builtin == null ? null : builtin.library(), packs);
+        if (GENERATION.get() == generation) snapshot = new Snapshot(generation, builtin, packs, library);
+        return library;
+    }
+
+    private static void read(final ResourceManager resources, final String path, final Decoder decoder,
+                             final List<List<Map<String, byte[]>>> archives) throws IOException {
+        final var stack = resources.getResourceStack(Identifier.fromNamespaceAndPath("viabedrock", path));
+        for (int index = stack.size() - 1; index >= 0; index--) {
+            final var resource = stack.get(index);
+            if (resource.source().location().source() != PackSource.SERVER) continue;
+            try (var input = resource.open()) { archives.add(decoder.read(input)); }
+            return;
+        }
+    }
+
+    static List<Map<String, byte[]>> mergeLibraries(final List<List<Map<String, byte[]>>> archives) throws IOException {
+        if (archives.isEmpty()) return List.of();
+        final int count = archives.getFirst().size();
+        final List<Map<String, byte[]>> merged = new ArrayList<>();
+        for (int index = 0; index < count; index++) merged.add(new LinkedHashMap<>());
+        long total = 0;
+        int files = 0;
+        for (final var archive : archives) {
+            if (archive.size() != count) throw new IOException("Mismatched native resource pack indexes");
+            for (int index = 0; index < count; index++) {
+                for (final var entry : archive.get(index).entrySet()) {
+                    total += entry.getValue().length;
+                    if (++files > 32768 || entry.getValue().length > BedrockBuiltinAssets.MAX_FILE_BYTES
+                            || total > BedrockBuiltinAssets.MAX_TOTAL_BYTES)
+                        throw new IOException("Native server resources exceed limits");
+                    if (merged.get(index).putIfAbsent(entry.getKey(), entry.getValue()) != null)
+                        throw new IOException("Duplicate native resource across archives");
+                }
+            }
+        }
+        return merged.stream().map(Map::copyOf).toList();
+    }
+
+    @FunctionalInterface
+    private interface Decoder { List<Map<String, byte[]>> read(InputStream input) throws IOException; }
+
+    private record Snapshot(long generation, BedrockBuiltinAssets.Contents builtin,
+                            List<Map<String, byte[]>> packs, BedrockResourceLibrary library) {}
+}
