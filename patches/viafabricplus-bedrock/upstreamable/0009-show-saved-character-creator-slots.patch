diff --git a/native/persona-assets/Cargo.toml b/native/persona-assets/Cargo.toml
new file mode 100644
index 0000000..e42be8b
--- /dev/null
+++ b/native/persona-assets/Cargo.toml
@@ -0,0 +1,27 @@
+[package]
+name = "persona-assets"
+version = "0.1.0"
+edition = "2024"
+rust-version = "1.98"
+license = "GPL-3.0-or-later"
+
+[dependencies]
+base64 = "0.22"
+xodus = { git = "https://github.com/xodus-gaming/xodus", rev = "a3afa0569332e32ce2677c0edc643ef85477ee3e" }
+msixvc = { git = "https://github.com/xodus-gaming/xodus", rev = "a3afa0569332e32ce2677c0edc643ef85477ee3e" }
+msixvc-common = { git = "https://github.com/xodus-gaming/xodus", rev = "a3afa0569332e32ce2677c0edc643ef85477ee3e" }
+tokio = { version = "1.53.1", features = ["full"] }
+reqwest = { version = "0.13.4", features = ["json", "stream"] }
+serde = { version = "1.0.229", features = ["derive"] }
+serde_json = "1.0.151"
+sha2 = "0.11"
+uuid = "1.25"
+fs2 = "0.4"
+chrono = "0.4"
+gpt = "4.1"
+ntfs = "0.4"
+tokio-util = { version = "0.7", features = ["io-util"] }
+
+[patch.crates-io]
+ntfs = { git = "https://github.com/xodus-gaming/ntfs", rev = "5edc794c3ec73a2722dad24abefd05f270d3e066" }
+
