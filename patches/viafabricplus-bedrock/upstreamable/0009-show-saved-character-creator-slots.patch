+        assertEquals(123, player.sample(0.75F, Map.of()).get("head").position().x());
+        assertEquals(1234, player.sample(2, Map.of()).get("head").position().x());
+        assertEquals(
+                2,
+                molang.evaluate(
+                        BedrockMolang.Program.parse(JsonParser.parseString("\"v.event_time\""), 0),
+                        0));
+        assertEquals(
+                1.25F,
