+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.raphimc.viabedrock.api.util.BedrockTrigonometry;
+import org.joml.Matrix4f;
+
+/** Bedrock 1.26.51 PlayerBob and Mob tilt, sampled independently of Java's bob. */
+final class BedrockViewBobbing {
+    private float bob;
+    private float previousBob;
+    private float tilt;
+    private float previousTilt;
+
+    void tick(final float velocityX, final float velocityY, final float velocityZ, final boolean onGround,
+              final boolean swimming, final boolean alive, final boolean riding) {
+        this.previousBob = this.bob;
+        float target = 0;
+        if (onGround && !swimming && alive) {
+            final float speed = (float) Math.sqrt(velocityX * velocityX + velocityZ * velocityZ);
+            target = speed <= 0.1F ? speed : 0.1F;
+        }
+        this.bob += (target - this.bob) * 0.08F;
+        if (riding) {
+            this.previousBob = this.bob;
+            this.bob = 0;
+        }
+        this.previousTilt = this.tilt;
+        final float targetTilt = !onGround && alive ? (float) Math.atan(velocityY * -0.2F) * 15F : 0;
+        this.tilt += (targetTilt - this.tilt) * 0.4F;
+    }
+
+    Matrix4f matrix(final float walkingDistance, final float frameAlpha) {
+        return transform(new Matrix4f(), walkingDistance,
+                (this.bob - this.previousBob) * frameAlpha + this.previousBob,
+                (this.tilt - this.previousTilt) * frameAlpha + this.previousTilt);
+    }
+
+    static Matrix4f transform(final Matrix4f matrix, final float walkingDistance, final float bob, final float tilt) {
+        final float phase = -walkingDistance * (float) Math.PI;
+        final float sine = BedrockTrigonometry.sine(phase);
+        final float radians = (float) Math.PI / 180F;
+        return matrix.translate(sine * bob * 0.65F, -Math.abs(BedrockTrigonometry.cosine(phase) * bob), 0)
+                .rotateZ(sine * bob * 3F * radians)
+                .rotateX(Math.abs(bob * BedrockTrigonometry.cosine(phase - 0.2F)) * 5F * radians)
+                .rotateX(tilt * radians);
+    }
+}
