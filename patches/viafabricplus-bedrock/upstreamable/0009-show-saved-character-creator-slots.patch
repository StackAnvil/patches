+
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+
+import javax.imageio.ImageIO;
+
+final class BedrockPersonaAssemblerTest {
+    @Test
+    void retainsIndependentLimbTintsFromTheSameAnimatedPack() throws Exception {
+        final var preview =
+                new BedrockPersonaModel.Converted(
+                        new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB),
+                        """
+                        {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":128,"texture_height":128},
+                          "bones":[{"name":"root"},{"name":"leftarm","parent":"root"},{"name":"rightarm","parent":"root"}]}]}
+                        """,
+                        "{\"geometry\":{\"default\":\"geometry.test\"}}",
+                        List.of());
+        final String id = java.util.UUID.randomUUID().toString();
+        final var source = new BufferedImage(2, 4, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 4; y++) for (int x = 0; x < 2; x++) source.setRGB(x, y, 0xFFCC9966);
+        final var png = new ByteArrayOutputStream();
+        ImageIO.write(source, "png", png);
+        final byte[] tga = new byte[18 + 2 * 4 * 4];
+        tga[2] = 2;
+        tga[12] = 2;
+        tga[14] = 4;
+        tga[16] = 32;
+        tga[17] = 32;
+        for (int pixel = 0; pixel < 8; pixel++) tga[18 + pixel * 4 + 2] = (byte) 255;
+        final var pack =
+                new BedrockPersonaAssets.Pack(
+                        id,
+                        Map.of(
+                                "piece.meta.json",
+                                """
+                                {"piece_type":"persona_arms","tint_base_color":{"r_color":"#CC9966"},"geometry_sources":[
+                                 {"geometry":"geometry.arms","texture":"source.png","tint_map":"mask.tga","animated":true,"frames":2}]}
+                                """
+                                        .getBytes(StandardCharsets.UTF_8),
+                                "piece.geometry.json",
+                                """
+                                {"geometry.arms":{"bones":[
+                                  {"name":"leftarm","parent":"root","cubes":[{"origin":[0,0,0],"size":[1,1,1],"uv":[0,0]}]},
+                                  {"name":"rightarm","parent":"root","cubes":[{"origin":[0,0,0],"size":[1,1,1],"uv":[0,0]}]}]}}
+                                """
+                                        .getBytes(StandardCharsets.UTF_8),
+                                "source.png",
+                                png.toByteArray(),
+                                "mask.tga",
+                                tga));
+        final var starter =
+                BedrockPersonaProfileTest.starterSlot(BedrockCharacterProfiles.Starter.STEVE);
+        final var profile = starter.profile().deepCopy();
+        final var entries =
+                profile.getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        entries.add(
+                JsonParser.parseString(
+                        "{\"id\":\"" + id + "/l\",\"col\":[\"#FFB03020\",\"#0\",\"#0\",\"#0\"]}"));
+        entries.add(
+                JsonParser.parseString(
+                        "{\"id\":\"" + id + "/r\",\"col\":[\"#FF2030B0\",\"#0\",\"#0\",\"#0\"]}"));
+        final var slot =
+                new BedrockCharacterProfiles.Slot(
+                        starter.number(),
+                        starter.arm(),
+                        starter.skinColor(),
+                        starter.pieceIds(),
+                        starter.profileHash(),
+                        profile);
+        final var assembled = BedrockPersonaAssembler.assemble(preview, slot, Map.of(id, pack));
+        final var animation = assembled.animations().getFirst();
+        final var bones =
+                JsonParser.parseString(assembled.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(1)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones");
+        final int left =
