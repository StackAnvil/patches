+
+import static org.junit.jupiter.api.Assertions.*;
+
+@EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+final class BedrockParticleRegistryTest {
+    @Test
+    void matchesNativeRegistryInterpolationAndLocatorMatrices() throws Exception {
+        for (final var entry : fixture("native-registry-attachment-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var attachment = BedrockParticleAttachment.registry(vector(row.getAsJsonArray("previous_position")),
+                    vector(row.getAsJsonArray("current_position")), row.get("previous_yaw").getAsFloat(),
+                    row.get("current_yaw").getAsFloat(), row.get("partial").getAsFloat(),
+                    row.get("locator").getAsString().equals("found") ? new Matrix4f().set(values(row.getAsJsonArray("locator_matrix"))) : null)
+                    .withOffset(vector(row.getAsJsonArray("binding_offset")));
+            final boolean position = row.get("position").getAsBoolean();
+            assertFalse(attachment.hasActor());
+            assertEquals(row.get("locator_found").getAsBoolean(), attachment.hasLocator(position));
+            assertArrayEquals(values(row.getAsJsonArray("matrix")),
+                    attachment.matrix(position, row.get("rotation").getAsBoolean()).values(), row.toString());
+        }
+    }
+
+    @Test
+    void matchesNativeFirstBirthsClearingAndRenderGates() throws Exception {
+        final var gates = fixture("native-registry-render-gate-result.json").getAsJsonArray("cases");
+        for (final var entry : fixture("native-registry-lifecycle-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            final boolean local = row.get("local_position").getAsBoolean();
+            components.add("minecraft:emitter_local_space", JsonParser.parseString("{\"position\":" + local + "}"));
+            components.getAsJsonObject("minecraft:emitter_lifetime_once").addProperty("active_time", 10);
+            components.getAsJsonObject("minecraft:particle_lifetime_expression").addProperty("max_lifetime", 1);
+            if (row.get("rate").getAsString().equals("steady")) {
+                components.remove("minecraft:emitter_rate_instant");
+                components.add("minecraft:emitter_rate_steady", JsonParser.parseString("{\"spawn_rate\":20,\"max_particles\":3}"));
+            }
+            final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+            for (final var update : row.getAsJsonArray("steps")) {
+                final var step = update.getAsJsonObject();
+                final boolean valid = step.get("context_valid").getAsBoolean();
+                final var attachment = valid ? new BedrockParticleAttachment(Vec3.ZERO, 180, null, null, Map.of())
+                        : BedrockParticleAttachment.registry(Vec3.ZERO, Vec3.ZERO, 0, 0, .5F, null);
+                emitter.queryContext(attachment, Vec3.ZERO);
+                emitter.advance(50_000_000, 1000, attachment, (x, y, z) -> List.of());
+                emitter.queryContext(attachment, Vec3.ZERO);
+                final int population = step.get("population").getAsInt();
+                assertEquals(population, emitter.size(), step.toString());
+                final boolean visible = java.util.stream.StreamSupport.stream(gates.spliterator(), false)
+                        .map(element -> element.getAsJsonObject())
+                        .filter(gate -> gate.get("enabled").getAsBoolean() && gate.get("local_position").getAsBoolean() == local
+                                && gate.get("context_valid").getAsBoolean() == valid)
+                        .findFirst().orElseThrow().get("passes_gate").getAsBoolean();
+                assertEquals(visible ? population : 0, emitter.visuals().size(), step.toString());
+            }
+            emitter.advance(2_000_000_000, 1000, null, (x, y, z) -> List.of());
+            for (int i = 0; i < 12; i++) emitter.advance(100_000_000, 1000, null, (x, y, z) -> List.of());
+            assertFalse(emitter.alive());
+        }
+    }
+
+    @Test
+    void matchesNativeChildFramesInitializationGatesAndRetainedOffsets() throws Exception {
+        final var initialization = BedrockMolang.Program.parse(JsonParser.parseString("\"v.initialized=1;v.camera=q.distance_from_camera;\""), 0);
+        for (final var entry : fixture("native-child-actor-context-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var kind = BedrockParticleEvents.Kind.valueOf(row.get("kind").getAsString().toUpperCase(java.util.Locale.ROOT));
+            final var parentOrigin = vector(row.getAsJsonArray("parent_base_origin"));
+            final var parent = switch (row.get("binding").getAsString()) {
+                case "none" -> null;
+                case "actor" -> new BedrockParticleAttachment(Vec3.ZERO, 180, null, null, Map.of());
+                default -> BedrockParticleAttachment.registry(Vec3.ZERO, Vec3.ZERO, 0, 0, .5F, null);
+            };
+            final var attachment = parent == null ? null : parent.withOffset(new Vec3(100, 200, 300));
+            final var request = new BedrockParticleEvents.Request(new BedrockParticleEvents.Spawn("test:child", kind, initialization),
+                    new BedrockParticleAttachment.Matrix(values(row.getAsJsonArray("event_matrix"))), new Vector3f());
+            final var transform = request.emitterTransform(attachment, parentOrigin);
+            assertArrayEquals(values(row.getAsJsonArray("constructor_matrix")), transform.values());
+            if (!row.get("valid_handle").getAsBoolean()) continue;
+            final var bound = kind == BedrockParticleEvents.Kind.EMITTER_BOUND && attachment != null
+                    ? attachment.withOffset(attachment.childOffset(parentOrigin)) : null;
+            if (bound != null) assertEquals(vector(row.getAsJsonArray("binding_offset")), bound.childOffset(parentOrigin));
+            final var environment = new BedrockMolang();
+            final var emitter = BedrockParticleEffect.read(BedrockParticleEffectTest.burst()).emitter(environment, new Random(1), transform);
+            emitter.queryContext(bound, new Vec3(1, 2, 3));
+            emitter.initialize(initialization);
+            final var nativeInitialization = java.util.stream.StreamSupport.stream(row.getAsJsonArray("trace").spliterator(), false)
+                    .map(element -> element.getAsJsonObject()).filter(event -> event.has("child_initialization")).findFirst();
+            assertEquals(nativeInitialization.isPresent() ? 1 : 0,
+                    environment.evaluate(BedrockMolang.Program.parse(JsonParser.parseString("\"v.initialized\""), 0), 0));
+            if (nativeInitialization.isPresent()) assertEquals(nativeInitialization.get().getAsJsonObject("child_initialization").get("distance").getAsFloat(),
+                    environment.evaluate(BedrockMolang.Program.parse(JsonParser.parseString("\"v.camera\""), 0), 0));
+        }
+    }
+
+    private static JsonObject fixture(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), name))).getAsJsonObject();
+    }
+
+    private static Vec3 vector(final JsonArray array) {
+        return new Vec3(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+
+    private static float[] values(final JsonArray array) {
+        final float[] result = new float[array.size()];
+        for (int i = 0; i < result.length; i++) result[i] = array.get(i).getAsFloat();
+        return result;
+    }
+}
