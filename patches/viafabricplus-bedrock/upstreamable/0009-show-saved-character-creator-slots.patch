+
+    #[test]
+    fn traverses_selected_library_directories_and_their_archive_parents() {
+        for relative in [
+            "__brarchive",
+            "sounds",
+            "sounds/emote",
+            "particles",
+            "__brarchive/sounds",
+            "__brarchive/textures",
+            "textures",
+            "textures/particle",
+            "__brarchive/textures/particle",
+            "textures/items",
+            "textures/entity",
+            "__brarchive/textures/items",
