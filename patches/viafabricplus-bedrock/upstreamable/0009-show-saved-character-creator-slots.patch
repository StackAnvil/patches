+    private static byte[] archive() {
+        final ByteBuffer bytes =
+                ByteBuffer.allocate(16 + 3 * 256 + 3).order(ByteOrder.LITTLE_ENDIAN);
+        bytes.putLong(0x267052A0B125277DL).putInt(3).putInt(1);
+        descriptor(bytes, 0, "nested/one", 0, 3);
+        descriptor(bytes, 1, "two", 0, 3);
+        descriptor(bytes, 2, "loose.png", 0, 0);
+        bytes.position(16 + 3 * 256);
+        bytes.put(new byte[] {1, 2, 3});
+        return bytes.array();
