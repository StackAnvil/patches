+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class BedrockCharacterProfilesTest {
+
+    @Test
+    void separatesCharacterSlotsFromTheAccountSettingsProfile() throws Exception {
+        final JsonObject profiles = JsonParser.parseString("""
+            {"result":[
+              {"slotname":"personaProfile3","version":"0.0.1","profileHash":"third","personaCollection":{"universalApp":[
+                {"arm":"slim","cs_arm":"slim","skcol":"#ffccaa","skin":false},{"id":"hat"},{"col":["#ff0000","#0"],"id":"top"}]}},
+              {"slotname":"personaProfile1","version":"0.0.1","profileHash":"first","personaCollection":{"universalApp":[
+                {"arm":"wide","skcol":"#aabbcc","skin":"base"},{"id":"hair"}]}},
+              {"slotname":"personaProfile2","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile4","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile5","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile","version":"0.1.0","personaCollection":{"universalApp":[
+                {"id":"settings","lastUsedPersonaSlot":"persona_profile_persona3","isPlatformLocked":false}]}}
+            ],"profileVersion":70}
+            """).getAsJsonObject();
+        final var wardrobe = BedrockCharacterProfiles.parse(profiles);
+
+        assertEquals(5, wardrobe.slots().size());
+        assertEquals("wide", wardrobe.slots().getFirst().arm());
+        assertEquals("#aabbcc", wardrobe.slots().getFirst().skinColor());
+        assertEquals(1, wardrobe.slots().getFirst().pieceIds().size());
+        assertFalse(wardrobe.slots().get(1).occupied());
+        assertTrue(wardrobe.slots().get(2).occupied());
+        assertEquals(2, wardrobe.slots().get(2).pieceIds().size());
