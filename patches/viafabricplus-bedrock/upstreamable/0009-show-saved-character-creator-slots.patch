+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import org.joml.Vector3f;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.IntSupplier;
+import java.util.random.RandomGenerator;
+
+/** Parsed emitter components with independent Molang state for each emitted particle. */
+final class BedrockParticleEffect {
+    private static final Set<String> COMPONENTS = Set.of(
+            "minecraft:emitter_initialization", "minecraft:emitter_lifetime_events", "minecraft:emitter_lifetime_once",
+            "minecraft:emitter_lifetime_looping", "minecraft:emitter_lifetime_expression",
+            "minecraft:emitter_rate_instant", "minecraft:emitter_rate_steady", "minecraft:emitter_rate_manual",
+            "minecraft:emitter_local_space",
+            "minecraft:emitter_shape_point", "minecraft:emitter_shape_custom",
+            "minecraft:emitter_shape_box", "minecraft:emitter_shape_sphere",
+            "minecraft:emitter_shape_disc", "minecraft:emitter_shape_entity_aabb",
+            "minecraft:particle_initialization", "minecraft:particle_initial_speed",
+            "minecraft:particle_initial_spin", "minecraft:particle_lifetime_expression", "minecraft:particle_lifetime_events",
+            "minecraft:particle_motion_dynamic", "minecraft:particle_motion_parametric", "minecraft:particle_motion_collision",
+            "minecraft:particle_appearance_billboard", "minecraft:particle_appearance_tinting",
+            "minecraft:particle_appearance_lighting", "minecraft:particle_expire_if_in_blocks", "minecraft:particle_expire_if_not_in_blocks");
+    final String identifier, texture, material;
+    final boolean lighting;
+    private final BedrockMolang.Program creation, update, particleCreation, particleUpdate, particleRender;
+    private final BedrockMolang.Program count, rate, capacity, lifetime, expiration;
+    private final BedrockParticleLifetime emitterLifetime;
+    private final BedrockMolang.Program rotation, rotationRate;
+    private final BedrockParticleShape shape;
+    private final InitialSpeed speed;
+    private final Motion motion;
+    private final BedrockParticleCollision collision;
+    private final BedrockParticleBlocks blocks;
+    private final List<BedrockMolang.Program> parametric, parametricDirection;
+    private final BedrockMolang.Program parametricRotation;
+    private final Billboard billboard;
+    private final Tint tint;
+    private final BedrockParticleSpace space;
+    private final BedrockParticleCurves curves;
+    private final boolean manual;
+    private final BedrockParticleEvents events;
+    private final BedrockParticleLifetimeEvents particleEvents;
+    private final BedrockEmitterEvents emitterEvents;
+
+    private BedrockParticleEffect(final JsonObject definition) throws IOException {
+        this.events = BedrockParticleEvents.read(definition.get("events"));
+        this.curves = BedrockParticleCurves.read(definition.get("curves"));
+        final JsonObject description = definition.getAsJsonObject("description");
+        this.identifier = description.get("identifier").getAsString();
+        final JsonObject render = description.getAsJsonObject("basic_render_parameters");
+        this.texture = render.get("texture").getAsString();
+        BedrockBuiltinAssets.validPath(this.texture);
+        if (!this.texture.startsWith("textures/")) throw new IOException("Invalid particle texture");
+        this.material = render.get("material").getAsString();
+        if (!Set.of("particles_alpha", "particles_blend").contains(this.material))
+            throw new IOException("Unsupported particle material: " + this.material);
+        final JsonObject components = definition.getAsJsonObject("components");
+        if (components == null || components.size() > 64) throw new IOException("Invalid particle components");
+        for (final String component : components.keySet())
+            if (!COMPONENTS.contains(component)) throw new IOException("Unsupported particle component: " + component);
+        this.blocks = BedrockParticleBlocks.read(components);
+        this.manual = components.has("minecraft:emitter_rate_manual");
+        if ((components.has("minecraft:emitter_rate_instant") ? 1 : 0)
+                + (components.has("minecraft:emitter_rate_steady") ? 1 : 0) + (this.manual ? 1 : 0) != 1)
+            throw new IOException("The particle effect needs one emission rate");
+        this.particleEvents = BedrockParticleLifetimeEvents.read(object(components, "particle_lifetime_events"));
+        this.emitterEvents = BedrockEmitterEvents.read(object(components, "emitter_lifetime_events"));
+        final JsonObject emitterInit = object(components, "emitter_initialization");
+        this.creation = program(emitterInit, "creation_expression", 0);
+        this.update = program(emitterInit, "per_update_expression", 0);
+        final JsonObject particleInit = object(components, "particle_initialization");
+        this.particleCreation = program(particleInit, "creation_expression", 0);
+        this.particleUpdate = program(particleInit, "per_update_expression", 0);
+        this.particleRender = program(particleInit, "per_render_expression", 0);
+        this.emitterLifetime = BedrockParticleLifetime.read(components);
+        this.space = BedrockParticleSpace.read(components);
+        this.count = components.has("minecraft:emitter_rate_instant")
+                ? program(object(components, "emitter_rate_instant"), "num_particles", 10) : null;
+        final JsonObject steady = object(components, "emitter_rate_steady");
+        this.rate = program(steady, "spawn_rate", 1);
+        this.capacity = program(this.manual ? object(components, "emitter_rate_manual") : steady, "max_particles", 50);
+        this.shape = BedrockParticleShape.read(components);
+        final JsonElement speed = components.get("minecraft:particle_initial_speed");
+        this.speed = InitialSpeed.read(speed);
+        final JsonObject life = object(components, "particle_lifetime_expression");
+        this.lifetime = program(life, "max_lifetime", 1);
+        this.expiration = program(life, "expiration_expression", 0);
+        final JsonObject spin = object(components, "particle_initial_spin");
+        this.rotation = program(spin, "rotation", 0);
+        this.rotationRate = program(spin, "rotation_rate", 0);
+        if (components.has("minecraft:particle_motion_dynamic") && components.has("minecraft:particle_motion_parametric"))
+            throw new IOException("Ambiguous particle motion");
+        this.motion = components.has("minecraft:particle_motion_dynamic")
+                ? Motion.read(object(components, "particle_motion_dynamic")) : null;
+        this.collision = components.has("minecraft:particle_motion_collision")
+                ? BedrockParticleCollision.read(object(components, "particle_motion_collision")) : null;
+        final JsonObject parameter = components.getAsJsonObject("minecraft:particle_motion_parametric");
+        this.parametric = parameter == null ? null : vector(parameter.get("relative_position"), 3, 0);
+        this.parametricDirection = parameter == null ? null : vector(parameter.get("direction"), 3, 0);
+        this.parametricRotation = parameter == null ? null : program(parameter, "rotation", 0);
+        this.billboard = Billboard.read(object(components, "particle_appearance_billboard"));
+        this.tint = Tint.read(object(components, "particle_appearance_tinting").get("color"));
+        this.lighting = components.has("minecraft:particle_appearance_lighting");
+    }
+
+    static BedrockParticleEffect read(final JsonObject document) throws IOException {
+        try { return new BedrockParticleEffect(document.getAsJsonObject("particle_effect")); }
+        catch (RuntimeException invalid) { throw new IOException("Invalid particle effect", invalid); }
+    }
+
+    boolean manual() { return this.manual; }
+
+    Set<String> childEffects() { return this.events.effects(); }
+
+    Emitter emitter(final BedrockMolang environment, final RandomGenerator random, final net.minecraft.world.phys.Vec3 origin) {
+        return this.emitter(environment, random, BedrockParticleAttachment.Matrix.translation(origin));
+    }
+
+    Emitter emitter(final BedrockMolang environment, final RandomGenerator random, final BedrockParticleAttachment.Matrix transform) {
+        return this.emitter(environment, random, transform, null);
+    }
+
+    Emitter emitter(final BedrockMolang environment, final RandomGenerator random,
+                    final BedrockParticleAttachment.Matrix transform, final BedrockParticleBlocks.World world) {
+        return this.emitter(environment, random, transform, world, Map.of());
+    }
+
+    Emitter emitter(final BedrockMolang environment, final RandomGenerator random,
+                    final BedrockParticleAttachment.Matrix transform, final BedrockParticleBlocks.World world,
+                    final Map<String, Object> countQueries) {
+        if (blocks.required() && world == null) throw new IllegalArgumentException("Particle effect requires Bedrock block access");
+        return new Emitter(environment, random, transform, world, countQueries);
+    }
+
+    final class Emitter {
+        private final BedrockMolang environment;
+        private final RandomGenerator random;
+        private final Map<String, Object> countQueries;
+        private final BedrockParticleBlocks.World world;
+        private final List<Particle> particles = new ArrayList<>();
+        private Consumer<BedrockParticleEvents.Action> dispatcher = _ -> {};
+        private final List<String> eventLogs = new ArrayList<>();
+        private final int[] eventBudget = {1024};
+        private final BedrockParticleLifetime.Clock clock;
+        private final net.minecraft.world.phys.Vec3 baseOrigin;
+        private final BedrockParticleAttachment.Matrix baseMatrix;
+        private final Vector3f currentOrigin = new Vector3f(), previousOrigin = new Vector3f(), inheritedVelocity = new Vector3f();
+        private BedrockParticleAttachment.Matrix renderMatrix;
+        private boolean firstUpdate = true, hadAttachment, absolute, attached, contextValid = true;
+        private float remainder, cachedRate, distance;
+        private int maximum, emitted;
+
+        private Emitter(final BedrockMolang environment, final RandomGenerator random, final BedrockParticleAttachment.Matrix transform,
+                        final BedrockParticleBlocks.World world, final Map<String, Object> countQueries) {
+            this.world = world;
+            this.countQueries = Map.copyOf(countQueries);
+            environment.addQueries(BedrockParticleCounts.UNBOUND);
+            environment.addQueries(Map.of("spellcolor", BedrockMolangColor.ZERO));
+            this.environment = environment;
+            this.random = random;
+            this.baseOrigin = transform.origin();
+            this.baseMatrix = transform;
+            this.renderMatrix = this.baseMatrix;
+            this.clock = emitterLifetime.clock(environment);
+            this.restart();
+            environment.addQueries(this.countQueries);
+        }
+
+        private void restart() {
+            this.maximum = 0;
+            this.emitted = 0;
+            randomVariables(this.environment, this.random, "emitter");
+            this.environment.evaluate(creation, 0);
+        }
+
+        boolean alive() { return !this.clock.expired() || !this.particles.isEmpty(); }
+        int size() { return this.particles.size(); }
+        void dispatcher(final Consumer<BedrockParticleEvents.Action> dispatcher) { this.dispatcher = java.util.Objects.requireNonNull(dispatcher); }
+        net.minecraft.world.phys.Vec3 baseOrigin() { return this.baseOrigin; }
+
+        void advance(final long nanos, final int available, final BedrockParticleAttachment attachment,
+                     final BedrockParticleCollision.Terrain terrain) {
+            this.advance(nanos, () -> available, attachment, terrain);
+        }
+
+        void advance(final long nanos, final IntSupplier available, final BedrockParticleAttachment attachment,
+                     final BedrockParticleCollision.Terrain terrain) {
+            this.eventBudget[0] = 1024;
+            this.attached = attachment != null;
+            this.contextValid = attachment == null ? !this.hadAttachment : attachment.hasActor();
+            if (!this.contextValid && this.clock.expired() && space.position()) this.particles.clear();
+            if (attachment != null && !this.hadAttachment) this.absolute = !space.position();
+            this.hadAttachment |= attachment != null;
+            final var frame = this.clock.advance(nanos, attachment != null, this.contextValid, this.environment,
+                    () -> this.environment.evaluate(update, 0), this::restart, () -> {
+                        this.emitterEvent(emitterEvents.lifetime().expiration());
+                        if (!this.contextValid && space.position()) this.particles.clear();
+                    });
+            final float seconds = (float) frame.nanos() / 1_000_000_000F;
+            int requested = 0;
+            if (frame.emitting()) {
+                if (count != null) {
+                    if (this.emitted == 0) {
+                        this.maximum = 1000;
+                        requested = boundedCount(this.environment.evaluate(count, 10), 1000);
+                    }
+                } else if (!manual) {
+                    if (this.maximum == 0) {
+                        this.maximum = boundedCount(this.environment.evaluate(capacity, 50), 1000);
+                        this.cachedRate = Math.max(0, this.environment.evaluate(rate, 1));
+                    }
+                    this.remainder += seconds;
+                    final float interval = 1F / this.cachedRate;
+                    if (this.remainder >= interval) {
+                        requested = boundedCount((float) Math.floor(this.remainder / interval), 1000);
+                        this.remainder %= interval;
+                        this.cachedRate = Math.max(0, this.environment.evaluate(rate, 1));
+                    }
+                }
+            }
+            final int room = Math.min(Math.max(0, available.getAsInt()), this.maximum - this.particles.size());
+            for (int index = 0; index < Math.min(requested, room); index++) {
+                if (available.getAsInt() <= 0) break;
+                final Particle particle = new Particle(this.environment.copy(), this.random, attachment, this.inheritedVelocity, new Vector3f(), new Vector3f());
+                this.particles.add(particle);
+                this.event(particleEvents.creation(), particle);
+                this.emitted++;
+            }
