+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Reads version 1 BR archives, whose offsets are relative to the end of the index. */
+final class BedrockBrArchive {
+    private static final int MAX_BYTES = 32 * 1024 * 1024;
+    private static final int MAX_FILE_BYTES = 8 * 1024 * 1024;
+
+    private BedrockBrArchive() {}
+
+    static Map<String, byte[]> read(final byte[] data) throws IOException {
+        if (data.length < 16 || data.length > MAX_BYTES)
+            throw new IOException("Invalid native archive size");
+        final ByteBuffer input = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN);
+        if (input.getLong() != 0x267052A0B125277DL)
+            throw new IOException("Invalid native archive signature");
+        final long count = Integer.toUnsignedLong(input.getInt());
+        if (input.getInt() != 1 || count > 4096 || 16 + count * 256 > data.length)
+            throw new IOException("Invalid native archive index");
+        final int content = 16 + (int) count * 256;
+        final Map<String, byte[]> files = new LinkedHashMap<>();
+        final java.util.Set<String> names = new java.util.HashSet<>();
+        long total = 0;
+        for (int index = 0; index < count; index++) {
+            input.position(16 + index * 256);
+            final int length = Byte.toUnsignedInt(input.get());
+            if (length == 0 || length > 247) throw new IOException("Invalid native archive name");
+            final byte[] nameBytes = new byte[length];
+            input.get(nameBytes);
+            final String name =
+                    StandardCharsets.UTF_8
+                            .newDecoder()
+                            .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+                            .decode(ByteBuffer.wrap(nameBytes))
+                            .toString();
+            if (name.startsWith("/")
+                    || name.contains("\\")
+                    || name.contains(":")
+                    || name.contains("\0")
+                    || name.equals(".")
+                    || java.util.Arrays.stream(name.split("/", -1))
+                            .anyMatch(
+                                    part -> part.isEmpty() || part.equals(".") || part.equals(".."))
+                    || !names.add(name)) throw new IOException("Invalid native archive path");
+            input.position(16 + index * 256 + 248);
+            final long offset = Integer.toUnsignedLong(input.getInt()),
+                    size = Integer.toUnsignedLong(input.getInt());
+            if (size > MAX_FILE_BYTES
+                    || content + offset + size > data.length
+                    || (total += size) > MAX_BYTES)
+                throw new IOException("Invalid native archive entry bounds");
+            if (size == 0)
+                continue; // Native archives also register loose assets with empty entries.
+            if (files.putIfAbsent(
+                            name,
+                            java.util.Arrays.copyOfRange(
+                                    data, content + (int) offset, content + (int) (offset + size)))
+                    != null) throw new IOException("Duplicate native archive entry");
+        }
+        return Map.copyOf(files);
+    }
+}
