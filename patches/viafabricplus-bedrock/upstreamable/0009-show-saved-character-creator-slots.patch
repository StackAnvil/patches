+
+final class BedrockMolangTest {
+    private static float evaluate(final BedrockMolang context, final String expression)
+            throws IOException {
+        return context.evaluate(BedrockMolang.Program.parse(new JsonPrimitive(expression), 0), 0);
+    }
+
+    @Test
+    void preservesFloatRoundingInConditionsAssignmentsAndQueryInputs() throws IOException {
+        final var context = new BedrockMolang();
+        assertEquals(0F, evaluate(context, "16777216 + 1 - 16777216"));
+        assertEquals(1F, evaluate(context, "(0.1 + 0.2) == 0.3"));
+        assertEquals(1F, evaluate(context, "16777217 == 16777216"));
+        assertEquals(0F, evaluate(context, "v.a=16777216; v.a=v.a+1; return v.a-16777216;"));
+        context.queries(Map.of("number", 16777217), 0, 0, 0);
+        assertEquals(0F, evaluate(context, "q.number-16777216"));
+    }
+
+    @Test
+    void preservesDirectedRotationsAndLargeFiniteValues() throws IOException {
+        final var context = new BedrockMolang();
+        assertEquals(67.5F, evaluate(context, "math.lerprotate(90,0,0.25)"));
+        assertEquals(360F, evaluate(context, "math.lerprotate(350,10,0.5)"));
+        assertEquals(-90F, evaluate(context, "math.lerprotate(0,180,0.5)"));
+        assertEquals(-180F, evaluate(context, "math.min_angle(180)"));
+        context.queries(Map.of("angle", 1E30F), 0, 0, 0);
+        assertEquals(-60F, evaluate(context, "math.min_angle(q.angle)"));
+        assertEquals(1E30F, evaluate(context, "q.angle"));
+        assertEquals(40000F, evaluate(context, "40000"));
+        assertEquals(Float.MAX_VALUE, context.evaluate(BedrockMolang.Program.parse(new JsonPrimitive(Float.MAX_VALUE), 0), 0));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_MOLANG_ANGLES", matches = ".+")
+    void sharesCoreAngleSemanticsForNativeFloatCases() throws IOException {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_MOLANG_ANGLES")))).getAsJsonObject();
+        final var context = new BedrockMolang();
+        final var angle = BedrockMolang.Program.parse(new JsonPrimitive("math.min_angle(q.a)"), 0);
+        final var rotation = BedrockMolang.Program.parse(new JsonPrimitive("math.lerprotate(q.a,q.b,q.t)"), 0);
+        for (var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var args = row.getAsJsonArray("arguments");
+            final boolean rotated = args.size() == 3;
+            context.queries(Map.of("a", args.get(0).getAsFloat(), "b", rotated ? args.get(1).getAsFloat() : 0F,
+                    "t", rotated ? args.get(2).getAsFloat() : 0F), 0, 0, 0);
+            final float expected = Float.intBitsToFloat((int) row.get("resultBits").getAsLong());
+            assertEquals(Float.isFinite(expected) ? (expected == 0F ? 0F : expected) : 0F,
+                    context.evaluate(rotated ? rotation : angle, 0), row.toString());
+        }
+    }
+
+    @Test
+    void keepsNativeEndpointsOvershootExtrapolationAndInvalidArithmetic() throws IOException {
+        final var context = new BedrockMolang();
+        assertEquals(1F / 1024, evaluate(context, "math.ease_in_expo(0,1,0)"));
+        assertEquals(1F - 1F / 1024, evaluate(context, "math.ease_out_expo(0,1,1)"));
+        assertEquals(1F / 2048, evaluate(context, "math.ease_in_out_expo(0,1,0)"));
+        assertEquals(1F - 1F / 2048, evaluate(context, "math.ease_in_out_expo(0,1,1)"));
+        assertEquals(2, evaluate(context, "math.inverse_lerp(5,7,9)"));
+        assertEquals(.25F, evaluate(context, "math.inverse_lerp(7,3,6)"));
+        assertEquals(0, evaluate(context, "math.inverse_lerp(2,2,3)"));
+        assertEquals(0, evaluate(context, "math.ease_in_circ(0,1,2)"));
+        assertEquals(4, evaluate(context, "math.ease_in_quad(0,1,2)"));
+        assertTrue(evaluate(context, "math.ease_in_back(0,1,0.25)") < 0);
+        assertTrue(evaluate(context, "math.ease_out_back(0,1,0.75)") > 1);
+        assertEquals(3, evaluate(context, "math.ease_in_out_elastic(3,7,0)"));
+        assertEquals(7, evaluate(context, "math.ease_in_out_elastic(3,7,1)"));
+        // Native in-out elastic uses the same 0.3 period as the in and out curves.
+        assertEquals(-.0078125F, evaluate(context, "math.ease_in_out_elastic(0,1,0.25)"), 0.00001F);
+    }
+
+    @Test
+    void evaluatesArgumentsInOrderAndPreservesStandardMath() throws IOException {
+        final var context = new BedrockMolang();
+        assertEquals(
+                2,
+                evaluate(
+                        context,
+                        "v.a=0; return Math.Ease_In_Quad(v.a=v.a+1,v.a=v.a+1,v.a=v.a+1) - v.a * v.a"
+                                + " + 1;"));
+        assertEquals(3, evaluate(context, "v.a"));
+        assertEquals(1, evaluate(context, "math.sin(90)"), 0.000001F);
+        assertEquals(2, evaluate(context, "math.sqrt(4)"));
+        assertEquals(2, evaluate(context, "math.lerp(1,3,0.5)"));
+    }
+
+    @Test
+    void preservesAssignmentTargetsParenthesesAndModernConditionalPrecedence() throws IOException {
+        final var context = new BedrockMolang();
+        context.queries(Map.of("max", 1000F, "remaining", 988.5F), 0, 0, 0);
+        assertEquals(10.5F, evaluate(context, "v.a=q.max>0 ?q.max-(q.remaining+1):0; return v.a;"));
+        assertEquals(0, evaluate(context, "v.a=false?5:0; return v.a;"));
+        assertEquals(3, evaluate(context, "(v.a=false)?2:3"));
+        assertEquals(0, evaluate(context, "v.a"));
+        assertEquals(2, evaluate(context, "v.a=true?2:false?3:4; return v.a;"));
+        assertEquals(3, evaluate(context, "v.a=false?2:true?3:4; return v.a;"));
+        assertEquals(7, evaluate(context, "v.a=v.b=7; return v.a;"));
+        assertEquals(7, evaluate(context, "v.b"));
+        assertEquals(-2.5F, evaluate(context, "-math.ease_in_quad(0,10,0.5)"));
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockMolang.Program.parse(
+                                new JsonPrimitive("(".repeat(100) + "1" + ")".repeat(100)), 0));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_MOLANG_EASING", matches = ".+")
+    void matchesNativeCurvesWithFloatInputsAcrossBranchesAndExtrapolation() throws IOException {
+        final var fixture =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_MOLANG_EASING"))))
+                        .getAsJsonObject();
+        final var context = new BedrockMolang();
+        final Map<String, BedrockMolang.Program> programs = new HashMap<>();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final String name = row.get("name").getAsString();
+            var program = programs.get(name);
+            if (program == null) {
+                program =
+                        BedrockMolang.Program.parse(
+                                new JsonPrimitive(name + "(q.start,q.end,q.progress)"), 0);
+                programs.put(name, program);
+            }
+            final var arguments = row.getAsJsonArray("arguments");
+            final float start = arguments.get(0).getAsFloat(),
+                    end = arguments.get(1).getAsFloat(),
+                    progress = arguments.get(2).getAsFloat();
+            context.queries(Map.of("start", start, "end", end, "progress", progress), 0, 0, 0);
+            final float expected =
+                    row.get("result").isJsonNull() ? 0 : row.get("result").getAsFloat();
+            // Java regenerates the sine table; the target's CRT sine has small rounding
+            // differences.
+            final float tolerance = 8 * Math.ulp(expected) + .00001F;
+            assertEquals(
+                    expected,
+                    context.evaluate(program, 0),
+                    tolerance,
+                    () -> name + "(" + start + "," + end + "," + progress + ")");
+        }
+        assertEquals(31, programs.size());
+    }
+}
