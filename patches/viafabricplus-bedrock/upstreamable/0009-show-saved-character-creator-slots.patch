+            case HAIR -> "bedrock_character_slots.viafabricplus.hair_color";
+            case FACIAL_HAIR -> "bedrock_character_slots.viafabricplus.facial_hair_color";
+            case IRIS -> "bedrock_character_slots.viafabricplus.iris_color";
