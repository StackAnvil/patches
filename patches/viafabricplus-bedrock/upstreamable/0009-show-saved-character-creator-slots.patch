--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCurves.java
@@ -0,0 +1,173 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TreeMap;
+
+/** Particle render curves, including the target client's evaluation order and float arithmetic. */
+final class BedrockParticleCurves {
+    private final Map<String, Curve> curves;
+
+    private BedrockParticleCurves(final Map<String, Curve> curves) {
+        this.curves = java.util.Collections.unmodifiableMap(curves);
+    }
+
+    static BedrockParticleCurves read(final JsonElement value) throws IOException {
+        try { return readDefinitions(value); }
+        catch (RuntimeException invalid) { throw new IOException("Invalid particle curves", invalid); }
+    }
+
+    private static BedrockParticleCurves readDefinitions(final JsonElement value) throws IOException {
+        final Map<String, Curve> curves = new TreeMap<>();
+        if (value != null) {
+            if (!value.isJsonObject() || value.getAsJsonObject().size() > 128)
+                throw new IOException("Invalid particle curves");
+            for (final var entry : value.getAsJsonObject().entrySet()) {
+                final String name = entry.getKey().toLowerCase(Locale.ROOT);
+                if (!name.matches("(?:variable|v)\\.[a-z_][a-z0-9_]*") || !entry.getValue().isJsonObject())
+                    throw new IOException("Invalid particle curve variable");
+                final String variable = name.substring(name.indexOf('.') + 1);
+                if (curves.putIfAbsent(variable, readCurve(entry.getValue().getAsJsonObject())) != null)
+                    throw new IOException("Duplicate particle curve variable");
+            }
+        }
+        return new BedrockParticleCurves(curves);
+    }
+
+    void apply(final BedrockMolang environment) {
+        this.curves.forEach((name, curve) -> {
+            final Float value = curve.sample(environment);
+            if (value != null) environment.variable(name, value);
+        });
+    }
+
+    private static Curve readCurve(final JsonObject value) throws IOException {
+        final String type = value.get("type").getAsString();
+        final var input = BedrockMolang.Program.parse(value.get("input"), 0);
+        if (type.equals("bezier_chain")) {
+            final JsonObject nodes = value.getAsJsonObject("nodes");
+            if (nodes == null || nodes.size() > 256) throw new IOException("Invalid Bezier chain nodes");
+            final List<Node> points = new ArrayList<>();
+            for (final var entry : nodes.entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || !entry.getValue().isJsonObject())
+                    throw new IOException("Invalid Bezier chain node");
+                final var node = entry.getValue().getAsJsonObject();
+                final float center = number(node, "value", 0), slope = number(node, "slope", 0);
+                points.add(new Node(time, number(node, "left_value", center), number(node, "right_value", center),
+                        number(node, "left_slope", slope), number(node, "right_slope", slope)));
+            }
+            points.sort(Comparator.comparingDouble(Node::time));
+            final List<Segment> segments = new ArrayList<>();
+            for (int index = 1; index < points.size(); index++) {
+                final Node left = points.get(index - 1), right = points.get(index);
+                segments.add(new Segment(left.time, right.time, left.right, right.left,
+                        left.right + left.rightSlope / 3F, right.left - right.leftSlope / 3F));
+            }
+            return new Chain(input, List.copyOf(segments));
+        }
+        if (!List.of("linear", "bezier", "catmull_rom").contains(type))
+            throw new IOException("Unsupported particle curve type: " + type);
+        final JsonElement nodes = value.get("nodes");
+        if (nodes == null || !nodes.isJsonArray() || nodes.getAsJsonArray().size() > 256
+                || type.equals("bezier") && nodes.getAsJsonArray().size() != 4)
+            throw new IOException("Invalid particle curve nodes");
+        final List<BedrockMolang.Program> programs = new ArrayList<>();
+        for (final var node : nodes.getAsJsonArray()) programs.add(BedrockMolang.Program.parse(node, 0));
+        return new Simple(type, input, BedrockMolang.Program.parse(value.get("horizontal_range"), 1), List.copyOf(programs));
+    }
+
+    private static float number(final JsonObject node, final String name, final float fallback) throws IOException {
+        if (!node.has(name)) return fallback;
+        final var value = node.get(name);
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber() || !Float.isFinite(value.getAsFloat()))
+            throw new IOException("Invalid Bezier chain value");
+        return value.getAsFloat();
+    }
+
+    private interface Curve {
+        Float sample(BedrockMolang environment);
+    }
+
+    private record Simple(String type, BedrockMolang.Program input, BedrockMolang.Program range,
+                          List<BedrockMolang.Program> nodes) implements Curve {
+        @Override
+        public Float sample(final BedrockMolang environment) {
+            final float input = environment.evaluate(this.input, 0);
+            final float time = input / Math.max(Math.ulp(1F), environment.evaluate(this.range, 1));
+            final int size = this.nodes.size();
+            if (this.type.equals("bezier")) {
+                // The native evaluator reads every Bezier node, from last to first, before clamping.
+                final float last = this.node(3, environment), right = this.node(2, environment);
+                final float left = this.node(1, environment), first = this.node(0, environment);
+                if (time <= 0) return first;
+                if (time >= 1) return last;
+                return bezier(time, first, left, right, last);
+            }
+            final boolean catmull = this.type.equals("catmull_rom");
+            if (size == 0 || catmull && size < 4) return 0F;
+            if (time <= 0 || size == 1) return this.node(catmull ? 1 : 0, environment);
+            if (time >= 1) return this.node(catmull ? size - 2 : size - 1, environment);
+            final float scaled = time * (size - (catmull ? 3 : 1));
+            final int index = (int) Math.floor(scaled);
+            final float fraction = scaled - index;
+            if (!catmull) {
+                final float right = this.node(index + 1, environment), left = this.node(index, environment);
+                return fraction * (right - left) + left;
+            }
+            final float a = this.node(index, environment), b = this.node(index + 1, environment);
+            final float c = this.node(index + 2, environment), d = this.node(index + 3, environment);
+            return ((((b - c) * 3F + (d - a)) * fraction + ((c * 4F - 5F * b + a + a) - d))
+                    * fraction + (c - a)) * fraction * .5F + b;
+        }
+
+        private float node(final int index, final BedrockMolang environment) {
+            return environment.evaluate(this.nodes.get(index), 0);
+        }
+    }
+
+    private record Node(float time, float left, float right, float leftSlope, float rightSlope) {}
+    private record Segment(float start, float end, float left, float right, float leftControl, float rightControl) {}
+
+    private record Chain(BedrockMolang.Program input, List<Segment> segments) implements Curve {
+        @Override
+        public Float sample(final BedrockMolang environment) {
+            // An empty native chain leaves its registered variable unchanged.
+            if (this.segments.isEmpty()) return null;
+            final float time = environment.evaluate(this.input, 0);
+            if (time <= this.segments.getFirst().start) return this.segments.getFirst().left;
+            if (time >= this.segments.getLast().end) return this.segments.getLast().right;
+            for (final Segment segment : this.segments) {
+                if (segment.start <= time && time <= segment.end) {
+                    final float duration = segment.end - segment.start;
+                    if (duration < Math.ulp(1F)) return segment.left;
+                    final float fraction = (time - segment.start) / duration;
+                    if (fraction <= 0) return segment.left;
+                    if (fraction >= 1) return segment.right;
+                    return bezier(fraction, segment.left, segment.leftControl, segment.rightControl, segment.right);
+                }
+            }
+            return 0F;
+        }
+    }
+
+    private static float bezier(final float time, final float first, final float left, final float right, final float last) {
+        final float inverse = 1F - time, square = time * time, inverseSquare = inverse * inverse;
+        final float leftTerm = time * 3F * inverseSquare * left;
+        final float rightTerm = square * 3F * inverse * right;
+        final float firstTerm = inverse * inverseSquare * first;
+        return time * square * last + (rightTerm + (leftTerm + firstTerm));
+    }
+}
