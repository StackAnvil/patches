diff --git a/native/persona-assets/src/index.rs b/native/persona-assets/src/index.rs
new file mode 100644
index 0000000..f25e099
--- /dev/null
+++ b/native/persona-assets/src/index.rs
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use crate::{Result, remote::Remote};
+use msixvc::{
+    models::xvd::XvdHeader,
+    xvd::{SegmentFile, SyncSubstream, XvdFile},
+};
+use ntfs::{Ntfs, NtfsFile, attribute_value::NtfsAttributeValue};
+use std::{
+    collections::BTreeMap,
+    io::{Read, Seek, SeekFrom, Write},
+};
+use tokio_util::io::SyncIoBridge;
+
+pub enum Asset {
+    Resident(Vec<u8>),
+    Segments { length: u64, runs: Vec<SegmentFile> },
+}
+impl Asset {
+    pub fn length(&self) -> u64 {
+        match self {
+            Self::Resident(b) => b.len() as u64,
+            Self::Segments { length, .. } => *length,
+        }
+    }
+}
+
+pub fn ntfs(
+    remote: &mut Remote,
+    header: &XvdHeader,
+    package: &XvdFile,
+) -> Result<BTreeMap<String, Asset>> {
+    tokio::task::block_in_place(|| {
+        let layout = header.layout();
+        let drive = ReadOnly(SyncSubstream::new(
+            SyncIoBridge::new(remote),
+            layout.drive_data.start.to_bytes().0,
+            header.drive_size.0,
+        ));
+        let disk = gpt::GptConfig::new()
+            .writable(false)
+            .logical_block_size(gpt::disk::LogicalBlockSize::Lb4096)
+            .open_from_device(drive)?;
+        let (_, partition) = disk
+            .partitions()
+            .iter()
+            .find(|(_, part)| part.is_used())
+            .ok_or("Missing package partition")?;
+        let start = partition.bytes_start(*disk.logical_block_size())?;
+        let length = partition.bytes_len(*disk.logical_block_size())?;
+        let offset = layout.drive_data.start.to_bytes().0 + start;
+        let mut fs = SyncSubstream::new(disk.take_device(), start, length);
+        let mut ntfs = Ntfs::new(&mut fs)?;
+        ntfs.read_upcase_table(&mut fs)?;
+        let mut dir = ntfs.root_directory(&mut fs)?;
+        for component in ["data", "resource_packs"] {
+            dir = child(&ntfs, &mut fs, &dir, component)?;
+            if !dir.is_directory() {
+                return Err("Invalid package resource directory".into());
+            }
+        }
+        let mut assets = BTreeMap::new();
+        let pack_index = dir.directory_index(&mut fs)?;
+        let mut pack_entries = pack_index.entries();
+        let mut required = [false; 3];
+        while let Some(entry) = pack_entries.next(&mut fs) {
+            let entry = entry?;
+            let Some(key) = entry.key() else {
+                continue;
+            };
+            let name = key?.name().to_string_lossy();
+            if name != "persona" && !crate::library_pack(&name) {
+                continue;
+            }
+            let pack = entry.to_file(&ntfs, &mut fs)?;
+            if !pack.is_directory() {
+                return Err("Invalid package asset directory".into());
+            }
+            for (index, required_name) in ["persona", "vanilla", "vanilla_base"].iter().enumerate()
+            {
+                if name == *required_name {
+                    required[index] = true;
+                }
+            }
+            walk(
+                &ntfs,
+                &mut fs,
+                &pack,
+                &format!("data/resource_packs/{name}/"),
+                offset,
+                &mut assets,
+                0,
+            )?;
+        }
+        if !required.into_iter().all(|present| present) {
+            return Err("The package is missing a required asset directory".into());
+        }
+        for asset in assets.values_mut() {
+            if let Asset::Segments { runs, .. } = asset {
+                for (index, run) in runs.iter_mut().enumerate() {
+                    let mut files = std::collections::HashMap::from([(
+                        index.to_string(),
+                        std::mem::replace(
+                            run,
+                            SegmentFile {
+                                offset: 0,
+                                length: 0,
+                                data_hashs: Vec::new(),
+                                keep_encrypted: false,
+                            },
+                        ),
+                    )]);
+                    package.populate_segment_hashes(&mut files)?;
+                    *run = files.remove(&index.to_string()).unwrap();
+                }
+            }
+        }
+        Ok(assets)
+    })
+}
+
+fn child<'n, T: Read + Seek>(
+    ntfs: &'n Ntfs,
+    fs: &mut T,
+    dir: &NtfsFile<'n>,
+    name: &str,
+) -> Result<NtfsFile<'n>> {
+    let index = dir.directory_index(fs)?;
+    let mut entries = index.entries();
+    while let Some(entry) = entries.next(fs) {
+        let entry = entry?;
+        if let Some(key) = entry.key()
+            && key?.name().to_string_lossy().eq_ignore_ascii_case(name)
+        {
+            return Ok(entry.to_file(ntfs, fs)?);
+        }
+    }
+    Err("The package is missing a required asset directory".into())
+}
+
+fn walk<T: Read + Seek>(
+    ntfs: &Ntfs,
+    fs: &mut T,
+    dir: &NtfsFile<'_>,
+    prefix: &str,
+    offset: u64,
+    assets: &mut BTreeMap<String, Asset>,
+    depth: usize,
+) -> Result<()> {
+    if depth > 16 || assets.len() >= 8192 {
+        return Err("Invalid persona directory depth or count".into());
+    }
+    let index = dir.directory_index(fs)?;
+    let mut entries = index.entries();
+    while let Some(entry) = entries.next(fs) {
+        let entry = entry?;
+        let Some(key) = entry.key() else {
+            continue;
+        };
+        let name = key?.name().to_string_lossy();
+        if name == "." || name == ".." {
+            continue;
+        }
+        if name.is_empty() || name.contains(['/', '\\', ':', '\0']) {
+            return Err("Invalid NTFS asset path".into());
+        }
+        let path = format!("{prefix}{name}");
+        let file = entry.to_file(ntfs, fs)?;
+        if file.is_directory() {
+            if let Some(relative) = path.strip_prefix("data/resource_packs/")
+                && let Some((pack, relative)) = relative.split_once('/')
+                && crate::library_pack(pack)
+                && !crate::library_directory(relative)
+            {
+                continue;
+            }
+            walk(
+                ntfs,
+                fs,
+                &file,
+                &format!("{path}/"),
+                offset,
+                assets,
+                depth + 1,
+            )?;
+            continue;
+        }
+        let Some(output_path) = crate::asset_path(&path)? else {
+            continue;
+        };
+        let item = file.data(fs, "").ok_or("Missing asset stream")??;
+        let attribute = item.to_attribute()?;
+        let length = attribute.value_length();
+        if length > 32 * 1024 * 1024 {
+            return Err("Persona file is too large".into());
+        }
+        let asset = match attribute.value(fs)? {
+            NtfsAttributeValue::Resident(value) => Asset::Resident(value.data().to_vec()),
+            NtfsAttributeValue::NonResident(value) => {
+                let mut remaining = length;
+                let mut runs = Vec::new();
+                for run in value.data_runs() {
+                    let run = run?;
+                    let start = run
+                        .data_position()
+                        .value()
+                        .ok_or("Sparse persona file")?
+                        .get();
+                    let size = remaining.min(run.allocated_size());
+                    if size == 0 {
+                        break;
+                    }
+                    if !start.is_multiple_of(4096) {
+                        return Err("Unaligned persona segment".into());
+                    }
+                    runs.push(SegmentFile {
+                        offset: offset + start,
+                        length: size,
+                        data_hashs: Vec::new(),
+                        keep_encrypted: false,
+                    });
+                    remaining -= size;
+                }
+                if remaining != 0 {
+                    return Err("Incomplete persona stream".into());
+                }
+                Asset::Segments { length, runs }
+            }
+            NtfsAttributeValue::AttributeListNonResident(_) => {
+                return Err("Unsupported persona attribute-list stream".into());
+            }
+        };
+        if assets.insert(output_path, asset).is_some() {
+            return Err("Duplicate persona file".into());
+        }
+    }
+    Ok(())
+}
+
+struct ReadOnly<T>(T);
+impl<T: Read> Read for ReadOnly<T> {
+    fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+        self.0.read(bytes)
+    }
+}
+impl<T: Seek> Seek for ReadOnly<T> {
+    fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> {
+        self.0.seek(position)
+    }
+}
+impl<T> Write for ReadOnly<T> {
+    fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::other("Package is read-only"))
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<T> std::fmt::Debug for ReadOnly<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        f.write_str("ReadOnlyPackage")
+    }
+}
