+    private int categoryWidth() {
+        return Math.min(112, Math.max(72, this.width - 240));
+    }
+
+    private int gridLeft() {
+        return this.wardrobeLeft() + this.categoryWidth() + 8;
+    }
+
+    private int limbButtonWidth() {
+        final int available = this.width - this.gridLeft() - this.gridWidth() - 16 - this.wardrobeLeft();
+        return Math.min(48, (available - 8) / 3);
+    }
+
+    private int gridWidth() {
+        return Math.max(70, Math.min(420, this.width - this.gridLeft() - 272));
+    }
+
+    private int gridTop() {
+        return this.contentTop() + 75;
+    }
+
+    private int gridColumns() {
+        return Math.max(1, this.gridWidth() / 70);
+    }
+
+    private int pageSize() {
+        return this.gridColumns() * Math.max(1, (this.height - FOOTER_HEIGHT - this.gridTop() - 12) / 72);
+    }
