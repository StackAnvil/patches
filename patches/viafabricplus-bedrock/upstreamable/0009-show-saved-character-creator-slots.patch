+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockItemAnimationTest {
+    private static Object query(
+            final Map<String, Object> queries, final String name, final List<Object> arguments) {
+        final Object supplied = queries.get(name);
+        return supplied instanceof BedrockActorAnimation.Query function
+                ? function.evaluate(arguments)
+                : supplied;
+    }
+
+    @Test
+    void preservesElapsedTicksAcrossDifferentNativeAndJavaUseClocks() {
+        final int nativeMax = 1440000;
+        final int javaMax = 72000;
+        final var spear = new BedrockItemAnimation.Item("wooden_spear", nativeMax, false, ItemAnimationData.EMPTY);
+        for (final int elapsed : new int[]{0, 1, 19, 1000, javaMax - 1}) {
+            final int remaining = BedrockItemAnimation.remainingTicks(nativeMax, javaMax, javaMax - elapsed, true);
+            assertEquals(elapsed, nativeMax - remaining);
+            final var queries = new BedrockItemAnimation(spear, BedrockItemAnimation.Item.EMPTY,
+                    spear, BedrockItemAnimation.Item.EMPTY, remaining).queries();
+            assertEquals(nativeMax, queries.get("main_hand_item_max_duration"));
+            assertEquals(remaining, queries.get("main_hand_item_use_duration"));
+            assertEquals((float) remaining / nativeMax,
+                    query(queries, "item_remaining_use_duration", List.of(1)));
+        }
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, javaMax, false));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, 0, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, -1, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(0, javaMax, javaMax, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(32, javaMax, javaMax - 33, true));
+        assertEquals(16, BedrockItemAnimation.remainingTicks(32, 32, 16, true));
+        assertEquals(Integer.MAX_VALUE, BedrockItemAnimation.remainingTicks(Integer.MAX_VALUE, 0, 1, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(32, Integer.MAX_VALUE, 1, true));
+    }
+
+    @Test
+    void freezesAllEquipmentSlotsAndReadsOnlyMainHandKineticData() {
+        final var metadata = new ItemAnimationData(1440000, List.of("probe:one", "probe:two"), 13,
+                new ItemAnimationData.KineticWeapon(15, 300, 200, 100));
+        final var tagged = BedrockItemAnimation.Item.fromIdentifiers("probe:spear", "paper", 72000, false, metadata);
+        final var slots = new java.util.HashMap<String, BedrockItemAnimation.Item>();
+        for (final String slot : List.of("slot.weapon.mainhand", "slot.weapon.offhand", "slot.armor.head",
+                "slot.armor.chest", "slot.armor.legs", "slot.armor.feet", "slot.armor.body")) slots.put(slot, tagged);
+        final var queries = BedrockItemAnimation.equipmentQueries(slots);
+        slots.clear();
+        for (final String slot : List.of("slot.weapon.mainhand", "slot.weapon.offhand", "slot.armor.head",
+                "slot.armor.chest", "slot.armor.legs", "slot.armor.feet", "slot.armor.body")) {
+            assertEquals(true, query(queries, "equipped_item_any_tag", List.of(slot, "probe:missing", "probe:one")));
+            assertEquals(false, query(queries, "equipped_item_any_tag", List.of(slot, "probe:missing")));
+        }
+        assertEquals(false, query(queries, "equipped_item_any_tag", List.of("invalid", "probe:one")));
+        assertEquals(false, query(queries, "equipped_item_any_tag", List.of("slot.weapon.mainhand")));
+        final var main = new BedrockItemAnimation(tagged, BedrockItemAnimation.Item.EMPTY, tagged,
+                BedrockItemAnimation.Item.EMPTY, 1439983).queries();
+        final var off = new BedrockItemAnimation(BedrockItemAnimation.Item.EMPTY, tagged,
+                BedrockItemAnimation.Item.EMPTY, tagged, 0).queries();
+        assertEquals(metadata.useDurationTicks(), main.get("main_hand_item_max_duration"));
+        assertEquals(13 * 0.05F, main.get("base_swing_duration"));
+        assertEquals(15, main.get("kinetic_weapon_delay"));
+        assertEquals(300, main.get("kinetic_weapon_damage_duration"));
+        assertEquals(200, main.get("kinetic_weapon_knockback_duration"));
+        assertEquals(100, main.get("kinetic_weapon_dismount_duration"));
+        assertEquals(0, off.get("kinetic_weapon_delay"));
+        assertEquals(0.3F, off.get("base_swing_duration"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_KINETIC_QUERIES", matches = ".+")
+    void matchesNativeKineticSwingAndTagCallbacks() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_KINETIC_QUERIES")))).getAsJsonObject();
+        for (final var value : fixture.getAsJsonArray("kinetic")) {
+            final var row = value.getAsJsonObject();
+            final String field = row.get("field").getAsString();
+            final int raw = row.get("raw").getAsInt();
+            final int duration = row.get("condition").getAsBoolean() ? (short) raw : 0;
+            final var kinetic = !row.get("present").getAsBoolean() ? null
+                    : new ItemAnimationData.KineticWeapon(field.equals("delay") ? raw : 0,
+                            field.equals("damage") ? duration : 0, field.equals("knockback") ? duration : 0,
+                            field.equals("dismount") ? duration : 0);
+            final var item = new BedrockItemAnimation.Item("fixture", 0, false,
+                    new ItemAnimationData(null, List.of(), null, kinetic));
+            final var queries = new BedrockItemAnimation(item, BedrockItemAnimation.Item.EMPTY, item,
+                    BedrockItemAnimation.Item.EMPTY, 0).queries();
+            final String name = "kinetic_weapon_" + field + (field.equals("delay") ? "" : "_duration");
+            assertEquals(row.get("value").getAsFloat(), ((Number) queries.get(name)).floatValue());
+        }
+        for (final var value : fixture.getAsJsonArray("swing")) {
+            final var row = value.getAsJsonObject();
+            final var item = row.get("empty").getAsBoolean() ? BedrockItemAnimation.Item.EMPTY
+                    : new BedrockItemAnimation.Item("fixture", 0, false,
+                            new ItemAnimationData(null, List.of(), row.get("ticks").getAsInt(), null));
+            assertEquals(row.get("value").getAsFloat(), new BedrockItemAnimation(item,
+                    BedrockItemAnimation.Item.EMPTY, item, BedrockItemAnimation.Item.EMPTY, 0).queries().get("base_swing_duration"));
+        }
+        for (final var value : fixture.getAsJsonArray("tags")) {
+            final var row = value.getAsJsonObject();
+            final List<String> tags = new ArrayList<>();
+            for (final var tag : row.getAsJsonArray("tags")) tags.add(tag.getAsString());
+            final var item = new BedrockItemAnimation.Item("fixture", 0, false,
+                    new ItemAnimationData(null, tags, null, null));
+            final var queries = BedrockItemAnimation.equipmentQueries(Map.of("slot.weapon.mainhand", item));
+            assertEquals(row.get("value").getAsFloat() != 0,
+                    query(queries, "equipped_item_any_tag", arguments(row.getAsJsonArray("args"))));
+        }
+    }
+
+    @Test
+    void separatesEquippedAndRenderedHandsAndRejectsInvalidSlots() {
+        final var bow = new BedrockItemAnimation.Item("bow", 72000, false, ItemAnimationData.EMPTY);
+        final var crossbow = new BedrockItemAnimation.Item("crossbow", 25, true, ItemAnimationData.EMPTY);
+        final var items =
+                new BedrockItemAnimation(bow, crossbow, BedrockItemAnimation.Item.EMPTY, bow, 12);
+        final var queries = items.queries();
+        assertEquals("", query(queries, "get_equipped_item_name", List.of(0, 1)));
+        assertEquals("bow", query(queries, "get_equipped_item_name", List.of("off_hand", 1)));
+        assertEquals("crossbow", query(queries, "get_equipped_item_name", List.of(1.9F)));
+        assertEquals("bow", query(queries, "get_equipped_item_name", List.of("main_hand", 1, 2)));
