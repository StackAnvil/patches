+    public static List<String> emoteIds(final Slot slot, final List<WardrobeItem> categoryItems) {
+        final JsonArray entries = array(object(slot.profile(), "personaCollection"), "universalApp");
+        final int start = emoteStart(entries, categoryItems);
+        final List<String> ids = new ArrayList<>(4);
+        for (int index = 0; index < 4; index++) {
+            ids.add(start < 0 || start + index >= entries.size() ? ""
+                : string(entries.get(start + index).getAsJsonObject(), "id"));
+        }
+        return List.copyOf(ids);
+    }
