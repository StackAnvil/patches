+    public static boolean canEditLimbSides(final AccountWardrobe wardrobe, final Slot slot,
+                                            final List<WardrobeItem> categoryItems, final WardrobeItem item) {
+        if (!item.owned()) return false;
+        try {
+            if (!BedrockLimbSide.supportsSides(string(recipeFor(wardrobe, item), "id"))) return false;
+        } catch (IOException e) {
+            return false;
+        }
+        return slot.pieceIds().stream().filter(id -> categoryItems.stream().anyMatch(piece -> piece.matches(id)))
+            .allMatch(BedrockLimbSide::supportsSides);
+    }
