+        queries.put("is_in_water", (BedrockActorAnimation.Query) _ -> entity.isInWater());
+        queries.put("ground_speed", (BedrockActorAnimation.Query) _ -> BedrockParticleQueries.groundSpeed(entity.getDeltaMovement()));
+        queries.put("is_sneaking", state.isCrouching);
+        queries.put("is_sleeping", entity.isSleeping());
+        queries.put("is_riding", state.isPassenger);
