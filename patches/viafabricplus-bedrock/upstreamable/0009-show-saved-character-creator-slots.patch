+    public static Optional<Height> height(final Slot slot) {
+        Height selected = null;
+        for (final Height option : Height.values()) {
+            if (slot.pieceIds().contains(option.firstId) && slot.pieceIds().contains(option.secondId)) {
+                if (selected != null) {
+                    return Optional.empty();
+                }
+                selected = option;
+            }
+        }
+        return Optional.ofNullable(selected);
+    }
