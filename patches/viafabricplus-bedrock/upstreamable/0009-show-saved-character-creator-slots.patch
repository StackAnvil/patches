+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import org.joml.Vector3f;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Set;
+import java.util.random.RandomGenerator;
+
+/** Parsed emitter components with independent Molang state for each emitted particle. */
+final class BedrockParticleEffect {
+    private static final Set<String> COMPONENTS = Set.of(
+            "minecraft:emitter_initialization", "minecraft:emitter_lifetime_once",
+            "minecraft:emitter_lifetime_looping", "minecraft:emitter_lifetime_expression",
+            "minecraft:emitter_rate_instant", "minecraft:emitter_rate_steady",
+            "minecraft:emitter_local_space",
+            "minecraft:emitter_shape_point", "minecraft:emitter_shape_custom",
+            "minecraft:emitter_shape_box", "minecraft:emitter_shape_sphere",
+            "minecraft:emitter_shape_disc", "minecraft:emitter_shape_entity_aabb",
+            "minecraft:particle_initialization", "minecraft:particle_initial_speed",
+            "minecraft:particle_initial_spin", "minecraft:particle_lifetime_expression",
+            "minecraft:particle_motion_dynamic", "minecraft:particle_motion_parametric", "minecraft:particle_motion_collision",
+            "minecraft:particle_appearance_billboard", "minecraft:particle_appearance_tinting",
+            "minecraft:particle_appearance_lighting");
+    final String texture, material;
+    final boolean lighting;
+    private final BedrockMolang.Program creation, update, particleCreation, particleUpdate, particleRender;
+    private final BedrockMolang.Program count, rate, capacity, lifetime, expiration;
+    private final BedrockParticleLifetime emitterLifetime;
+    private final BedrockMolang.Program rotation, rotationRate;
+    private final BedrockParticleShape shape;
+    private final InitialSpeed speed;
+    private final Motion motion;
+    private final BedrockParticleCollision collision;
+    private final List<BedrockMolang.Program> parametric, parametricDirection;
+    private final BedrockMolang.Program parametricRotation;
+    private final Billboard billboard;
+    private final Tint tint;
+    private final BedrockParticleSpace space;
+
+    private BedrockParticleEffect(final JsonObject definition) throws IOException {
+        if (definition.has("curves") && !definition.getAsJsonObject("curves").isEmpty()
+                || definition.has("events") && !definition.getAsJsonObject("events").isEmpty())
+            throw new IOException("This particle effect needs curves or event playback");
+        final JsonObject description = definition.getAsJsonObject("description");
+        final JsonObject render = description.getAsJsonObject("basic_render_parameters");
+        this.texture = render.get("texture").getAsString();
+        BedrockBuiltinAssets.validPath(this.texture);
+        if (!this.texture.startsWith("textures/")) throw new IOException("Invalid particle texture");
+        this.material = render.get("material").getAsString();
