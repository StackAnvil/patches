+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockServerResourcesTest {
+    @Test
+    void combinesIndependentArchiveKindsWithoutShiftingTextureOnlyOverlays() throws Exception {
+        final var sound = List.of(Map.<String, byte[]>of(), Map.of("sounds/root.wav", new byte[]{1}), Map.<String, byte[]>of());
+        final var texts = List.of(Map.<String, byte[]>of(), Map.of("texts/en_US.lang", new byte[]{2}), Map.<String, byte[]>of());
+        final var particles = List.of(Map.<String, byte[]>of(), Map.of("particles/root.json", new byte[]{3}),
+                Map.of("textures/particle/root.png", new byte[]{4}));
+        final var packs = BedrockServerResources.mergeLibraries(List.of(sound, texts, particles));
+        assertEquals(3, packs.size());
+        assertTrue(packs.getFirst().isEmpty());
+        assertEquals(3, packs.get(1).size());
+        assertArrayEquals(new byte[]{1}, packs.get(1).get("sounds/root.wav"));
+        assertArrayEquals(new byte[]{3}, packs.get(1).get("particles/root.json"));
+        assertArrayEquals(new byte[]{4}, packs.get(2).get("textures/particle/root.png"));
+        assertThrows(UnsupportedOperationException.class, () -> packs.get(1).clear());
+    }
+
+    @Test
+    void acceptsMissingArchivesButRejectsInconsistentIndexesAndDuplicates() throws Exception {
+        assertTrue(BedrockServerResources.mergeLibraries(List.of()).isEmpty());
+        final var particles = List.of(Map.of("particles/root.json", new byte[]{3}));
+        assertEquals(1, BedrockServerResources.mergeLibraries(List.of(particles)).size());
+        assertThrows(IOException.class, () -> BedrockServerResources.mergeLibraries(List.of(particles, List.of())));
+        assertThrows(IOException.class, () -> BedrockServerResources.mergeLibraries(List.of(particles, particles)));
+    }
+}
