+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** Retains the target client's first-person rotation spring independently of Java hand bobbing. */
+final class BedrockFirstPersonCamera {
+    private float previousPitch, previousYaw;
+    private float angularPitch, angularYaw;
+    private float pitch, yaw;
+    private float velocityPitch, velocityYaw;
+    private double previousTime;
+
+    Rotation sample(final float oldPitch, final float currentPitch, final float oldYaw, final float currentYaw,
+                    final float alpha, final double now) {
+        final float elapsed = (float) (now - this.previousTime);
+        this.previousTime = now;
+        return this.update(oldPitch, currentPitch, oldYaw, currentYaw, alpha, elapsed);
+    }
+
+    Rotation update(final float oldPitch, final float currentPitch, final float oldYaw, final float currentYaw,
+                    final float alpha, final float elapsed) {
+        final float sampledPitch = wrap(currentPitch - oldPitch) * alpha + oldPitch;
+        final float sampledYaw = wrap(currentYaw - oldYaw) * alpha + oldYaw;
+        // The native clock caps long frames and substitutes 0.2 only below negative float epsilon.
+        final float delta = !(elapsed > -Math.ulp(1F)) ? .2F : Math.min(elapsed, .2F);
+        this.angularPitch = clamp(this.angularPitch * .8F + ((sampledPitch - this.previousPitch) / delta) * .2F);
+        this.angularYaw = clamp(this.angularYaw * .8F + (wrap(sampledYaw - this.previousYaw) / delta) * .2F);
+        final float drivePitch = this.angularPitch * 90F;
+        final float driveYaw = this.angularYaw * 90F;
+        for (float remaining = delta; remaining > 0F;) {
+            final float step = Math.min(remaining, 1F / 120F);
+            remaining -= step;
+            this.velocityPitch += ((this.velocityPitch * -42F - this.pitch * 900F) + drivePitch) * step;
+            this.velocityYaw += ((this.velocityYaw * -42F - this.yaw * 900F) + driveYaw) * step;
+            this.pitch += step * this.velocityPitch;
+            this.yaw += step * this.velocityYaw;
+        }
+        if (!(Math.abs(this.velocityPitch) < 1000F) || !(Math.abs(this.velocityYaw) < 1000F)) {
+            this.velocityPitch = this.velocityYaw = 0F;
+        }
+        this.previousPitch = sampledPitch;
+        this.previousYaw = sampledYaw;
+        return new Rotation(this.pitch, this.yaw);
+    }
+
+    private static float wrap(final float angle) {
+        final float remainder = (angle + 180F) % 360F;
+        return (remainder < 0F ? remainder + 360F : remainder) - 180F;
+    }
+
+    private static float clamp(final float velocity) {
+        return Math.clamp(velocity, -50F, 50F);
+    }
+
+    record Rotation(float pitch, float yaw) {
+        static final Rotation ZERO = new Rotation(0F, 0F);
+    }
+}
