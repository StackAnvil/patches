+    @FunctionalInterface
+    private interface ProfileEdit {
+        JsonObject apply(AccountWardrobe current) throws IOException;
+    }
+
+    private static AccountWardrobe loadNow(final BedrockAuthManager account) throws IOException, InterruptedException {
+        return parse(readProfiles(account));
+    }
+
+    static AccountWardrobe parse(final JsonObject profiles) throws IOException {
+        final ParsedProfiles parsed = parseProfiles(profiles);
+        return new AccountWardrobe(parsed.slots(), parsed.activeSlot(), parsed.profileVersion(), parsed.settings());
+    }
+
+    private static JsonObject readProfiles(final BedrockAuthManager account) throws IOException, InterruptedException {
+        final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+        final HttpRequest profilesRequest = HttpRequest.newBuilder(PROFILES)
+            .timeout(Duration.ofSeconds(15))
+            .header("Authorization", authorization)
+            .header("session-id", UUID.randomUUID().toString())
+            .header("Accept", "application/json")
+            .GET().build();
+        return send(profilesRequest);
+    }
+
+    static JsonObject selectionRequest(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()) {
+            throw new IOException("Character slot is out of range");
+        }
+        final Slot slot = wardrobe.slots().get(slotNumber - 1);
+        if (!slot.occupied()) {
+            throw new IOException("Character slot has no saved recipe");
+        }
+        final JsonObject settings = settingsForSlot(wardrobe, slotNumber);
+        final JsonArray objects = new JsonArray();
+        objects.add(appearanceObject("personaProfile", settings));
+        objects.add(appearanceObject("personaProfile" + slotNumber, slot.profile()));
+        final JsonObject request = new JsonObject();
+        request.add("appearanceObjects", objects);
+        return request;
+    }
+
+    public static CompletableFuture<AccountWardrobe> selectClassic(final BedrockAuthManager account,
+                                                                  final BedrockOwnedSkinPacks.Item owned,
+                                                                  final BedrockClassicSkinPack pack,
+                                                                  final BedrockClassicSkinPack.Skin skin) {
+        if (!pack.skins().contains(skin) || !owned.packId().equals(skin.packId()) || skin.skinId().isBlank()) {
+            return CompletableFuture.failedFuture(new IOException("Invalid account skin selection"));
+        }
+        return load(account).thenCompose(before -> {
+            final int slot = before.activeSlot();
+            if (slot < 1 || slot > before.slots().size()) {
+                return CompletableFuture.failedFuture(new IOException("Select a character slot first"));
+            }
+            return updateProfile(account, slot, before.slots().get(slot - 1).profileHash(), current -> {
+                if (current.activeSlot() != slot) throw new IOException("The active character changed. Select the skin again");
+                if (!current.slots().get(slot - 1).profile().getAsJsonObject("personaCollection")
+                    .equals(before.slots().get(slot - 1).profile().getAsJsonObject("personaCollection"))) {
+                    throw new IOException("This character changed on your account. Select the skin again");
+                }
+                return classicSelectionRequest(current, slot, skin);
+            });
+        });
+    }
+
+    static JsonObject classicSelectionRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                              final BedrockClassicSkinPack.Skin skin) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || skin.skinId().isBlank() || skin.index() < 0) {
+            throw new IOException("Invalid account skin selection");
+        }
+        final JsonObject edited = wardrobe.slots().get(slotNumber - 1).profile().deepCopy();
+        final JsonObject collection = object(edited, "personaCollection");
+        final JsonArray entries = array(collection, "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject() || !entries.get(0).getAsJsonObject().has("skin")) {
+            throw new IOException("Create a character before selecting an account skin");
+        }
+        final JsonObject header = entries.get(0).getAsJsonObject();
+        header.addProperty("skin", true);
+        header.addProperty("cs_arm", skin.slim() ? "slim" : "wide");
+        edited.addProperty("version", "0.1.0");
+        final JsonArray retained = new JsonArray();
+        for (final var entry : entries) {
+            if (!entry.isJsonObject() || !CLASSIC_ID.matcher(string(entry.getAsJsonObject(), "id")).matches()) {
+                retained.add(entry.deepCopy());
+            }
+        }
+        final JsonObject selected = new JsonObject();
+        selected.addProperty("id", skin.recipeId());
+        retained.add(selected);
+        collection.add("universalApp", retained);
+        return editRequest(slotNumber, settingsForSlot(wardrobe, slotNumber), edited);
+    }
