+/** Browses the saved Character Creator recipes and owned persona pieces for the signed-in account. */
+public final class BedrockCharacterSlotsScreen extends VFPScreen {
+
+    public static final Component TITLE = Component.translatable("screen.viafabricplus.bedrock_character_slots");
+
+    private enum View {
+        SLOTS, WARDROBE
+    }
+
+    private AccountWardrobe wardrobe;
+    private List<WardrobeItem> items;
+    private Category category = Category.HAIRS;
+    private Category loadedCategory;
+    private String activeAvatar;
+    private long avatarRequest;
+    private View view = View.SLOTS;
+    private int selectedSlot;
+    private int selectedItem;
+    private boolean loading;
+    private boolean failed;
+    private boolean itemsFailed;
+    private boolean itemsLoading;
+    private boolean saving;
+    private boolean selectionFailed;
+    private boolean editFailed;
+    private final Button[] slotButtons = new Button[5];
+    private Button slotsTab;
+    private Button wardrobeTab;
+    private Button categoryButton;
+    private Button previousItem;
+    private Button nextItem;
+    private Button useSlot;
+    private Button editPiece;
+
+    public BedrockCharacterSlotsScreen() {
+        super(TITLE, true);
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        final int left = this.width / 2 - 150;
+        final int top = this.contentTop();
+        this.slotsTab = this.addRenderableWidget(Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.slots"),
+            _ -> this.changeView(View.SLOTS)).bounds(left, top, 146, 20).build());
+        this.wardrobeTab = this.addRenderableWidget(Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.wardrobe"),
+            _ -> this.changeView(View.WARDROBE)).bounds(left + 154, top, 146, 20).build());
+        for (int index = 0; index < 5; index++) {
+            final int slot = index;
+            this.slotButtons[index] = this.addRenderableWidget(Button.builder(
+                Component.translatable("bedrock_character_slots.viafabricplus.slot", index + 1),
+                _ -> {
+                    this.selectedSlot = slot;
+                    this.selectionFailed = false;
+                    this.updateControls();
+                }).bounds(left + index * 61, top + 24, 56, 20).build());
+        }
+        this.categoryButton = this.addRenderableWidget(Button.builder(Component.empty(), _ -> this.nextCategory())
+            .bounds(left, top + 24, 300, 20).build());
+        this.previousItem = Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.previous"),
+            _ -> this.changeItem(-1)).build();
+        this.nextItem = Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.next"),
+            _ -> this.changeItem(1)).build();
+        this.useSlot = Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.use_slot"),
+            _ -> this.selectSlot()).build();
+        this.editPiece = Button.builder(Component.empty(), _ -> this.changePiece()).build();
+        this.addFooter(this.previousItem, this.nextItem, this.useSlot, this.editPiece,
+            Button.builder(Component.translatable("bedrock_character_slots.viafabricplus.refresh"), _ -> this.refresh()).build());
+        this.updateControls();
+        if (this.wardrobe == null && !this.loading) {
+            this.refresh();
+        }
+    }
+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    public void extractRenderState(final @NonNull GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        final int left = this.width / 2 - 150;
+        final int top = this.contentTop() + 52;
+        if (this.loading && this.wardrobe == null) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.loading"), left, top, ACCENT_COLOR);
+            return;
+        }
+        if (this.wardrobe == null) {
+            graphics.textWithWordWrap(this.font, Component.translatable(this.failed
+                ? "bedrock_character_slots.viafabricplus.failed" : "bedrock_character_slots.viafabricplus.sign_in"),
+                left, top, 300, ACCENT_COLOR);
+            return;
+        }
+        if (this.view == View.WARDROBE) {
+            this.renderWardrobe(graphics, left, top);
+            return;
+        }
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.selected", slot.number()),
+            left, top, -1);
+        graphics.text(this.font, Component.translatable(slot.occupied()
+            ? "bedrock_character_slots.viafabricplus.saved" : "bedrock_character_slots.viafabricplus.empty"),
+            left, top + 16, -1);
+        if (slot.occupied()) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.pieces", slot.pieceIds().size()),
+                left, top + 32, -1);
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.arms", slot.arm()),
+                left, top + 48, -1);
+        }
+        if (this.saving) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.saving"),
+                left, top + 64, ACCENT_COLOR);
+        } else if (this.selectionFailed) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.select_failed"),
+                left, top + 64, 300, ACCENT_COLOR);
+        } else if (this.wardrobe.activeSlot() == slot.number()) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.active"),
+                left, top + 64, ACCENT_COLOR);
+        }
+        if (this.wardrobe.activeSlot() == slot.number() && this.activeAvatar != null) {
+            BedrockImageCache.drawEncoded(graphics, slot.profileHash(), this.activeAvatar,
+                left + 188, top, 108, 144);
+        }
+        graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.recipe_notice"),
+            left, top + 160, 300, ACCENT_COLOR);
+    }
+
+    private int contentTop() {
+        return Math.max(CONTENT_TOP, (this.height - 250) / 2);
+    }
+
+    private void renderWardrobe(final GuiGraphicsExtractor graphics, final int left, final int top) {
+        if (this.items == null) {
+            graphics.textWithWordWrap(this.font, Component.translatable(this.itemsFailed
+                ? "bedrock_character_slots.viafabricplus.items_failed" : "bedrock_character_slots.viafabricplus.items_loading"),
+                left, top, 300, ACCENT_COLOR);
+            return;
+        }
+        graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.owned_pieces",
+            this.items.size()), left, top, -1);
+        if (this.items.isEmpty()) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.no_pieces"),
+                left, top + 24, 300, ACCENT_COLOR);
+            return;
+        }
+        final WardrobeItem item = this.items.get(this.selectedItem);
+        BedrockImageCache.drawRemote(graphics, item.thumbnailUrl(), left, top + 16, 52, 52);
+        graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.item_number",
+            this.selectedItem + 1, this.items.size()), left + 64, top + 16, ACCENT_COLOR);
+        graphics.textWithWordWrap(this.font, Component.literal(item.name()), left + 64, top + 32, 236, -1);
+        graphics.textWithWordWrap(this.font, Component.literal(item.type().replace("persona_", "").replace('_', ' ')),
+            left + 64, top + 64, 236, ACCENT_COLOR);
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.selected", slot.number()),
+            left, top + 94, -1);
+        if (this.saving) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.saving_piece"),
+                left, top + 110, ACCENT_COLOR);
+        } else if (this.editFailed) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.edit_failed"),
+                left, top + 110, 300, ACCENT_COLOR);
+        } else if (this.isEquipped(item, slot)) {
+            graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.equipped"),
+                left, top + 110, ACCENT_COLOR);
+        } else if (this.isSaved(item)) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.saved_piece"),
+                left, top + 110, 300, ACCENT_COLOR);
+        } else {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.catalog_only"),
+                left, top + 110, 300, ACCENT_COLOR);
+        }
+    }
+
+    private boolean isEquipped(final WardrobeItem item, final Slot slot) {
+        return slot.pieceIds().stream().anyMatch(id -> id.startsWith(item.packId() + "/"));
+    }
+
+    private boolean isSaved(final WardrobeItem item) {
+        return this.wardrobe.slots().stream().anyMatch(slot -> this.isEquipped(item, slot));
+    }
+
+    private boolean hasCategoryPiece(final Slot slot) {
+        return this.items != null && this.items.stream().anyMatch(item -> this.isEquipped(item, slot));
+    }
+
+    private void changeView(final View next) {
+        this.view = next;
+        this.updateControls();
+        if (next == View.WARDROBE) {
+            this.loadCategory();
+        }
+    }
+
+    private void nextCategory() {
+        final Category[] categories = Category.values();
+        this.category = categories[(this.category.ordinal() + 1) % categories.length];
+        this.selectedItem = 0;
+        this.items = null;
+        this.itemsFailed = false;
+        this.editFailed = false;
+        this.updateControls();
+        this.loadCategory();
+    }
+
+    private void loadCategory() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.itemsLoading
+            || this.loadedCategory == this.category && this.items != null) {
+            return;
+        }
+        final Category requested = this.category;
+        this.itemsLoading = true;
+        this.itemsFailed = false;
+        BedrockCharacterProfiles.loadItems(account, requested).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            this.itemsLoading = false;
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            if (this.category != requested) {
+                this.loadCategory();
+                return;
+            }
+            if (error != null) {
+                this.itemsFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock wardrobe items", error);
+            } else {
+                this.items = loaded;
+                this.loadedCategory = requested;
+                this.selectedItem = Math.min(this.selectedItem, Math.max(0, loaded.size() - 1));
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void loadAvatar(final BedrockAuthManager account) {
+        this.activeAvatar = null;
+        final long request = ++this.avatarRequest;
+        BedrockCharacterProfiles.loadActiveAvatar(account).whenComplete((encoded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this || this.avatarRequest != request) {
+                return;
+            }
+            if (error != null) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character preview", error);
+            } else {
+                this.activeAvatar = encoded;
+            }
+        }));
+    }
+
+    private void changeItem(final int offset) {
+        if (this.items == null || this.items.isEmpty()) {
+            return;
+        }
+        this.selectedItem = Math.floorMod(this.selectedItem + offset, this.items.size());
+        this.updateControls();
+    }
+
+    private void updateControls() {
+        this.slotsTab.active = this.view != View.SLOTS;
+        this.wardrobeTab.active = this.view != View.WARDROBE;
+        for (final Button button : this.slotButtons) {
+            button.visible = this.view == View.SLOTS;
+        }
+        this.categoryButton.visible = this.view == View.WARDROBE;
+        this.categoryButton.setMessage(Component.translatable("bedrock_character_slots.viafabricplus.category", this.category.label()));
+        this.previousItem.visible = this.view == View.WARDROBE;
+        this.nextItem.visible = this.view == View.WARDROBE;
+        this.useSlot.visible = this.view == View.SLOTS;
+        this.editPiece.visible = this.view == View.WARDROBE;
+        this.useSlot.active = this.wardrobe != null && !this.saving
+            && this.wardrobe.slots().get(this.selectedSlot).occupied()
+            && this.wardrobe.activeSlot() != this.selectedSlot + 1;
+        final boolean hasItems = this.items != null && this.items.size() > 1;
+        this.previousItem.active = hasItems;
+        this.nextItem.active = hasItems;
+        if (this.view == View.WARDROBE && this.wardrobe != null && this.items != null && !this.items.isEmpty()) {
+            final WardrobeItem item = this.items.get(this.selectedItem);
+            final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+            final boolean equipped = this.isEquipped(item, slot);
+            this.editPiece.setMessage(Component.translatable(equipped
+                ? "bedrock_character_slots.viafabricplus.remove_piece"
+                : "bedrock_character_slots.viafabricplus.use_piece"));
+            this.editPiece.active = !this.saving && this.hasCategoryPiece(slot) && (equipped || this.isSaved(item));
+        } else {
+            this.editPiece.active = false;
+        }
+    }
+
+    private void changePiece() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.items == null || this.items.isEmpty() || this.saving) {
+            return;
+        }
+        final WardrobeItem item = this.items.get(this.selectedItem);
+        final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+        final boolean remove = this.isEquipped(item, slot);
+        this.saving = true;
+        this.editFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.changeSavedPiece(account, slot.number(), slot.profileHash(), this.items, item, remove)
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                this.saving = false;
+                if (error != null) {
+                    this.editFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not edit Bedrock character piece", error);
+                } else {
+                    this.wardrobe = loaded;
+                    if (loaded.activeSlot() == slot.number()) {
+                        this.loadAvatar(account);
+                    }
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void selectSlot() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final int slotNumber = this.selectedSlot + 1;
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.selectSlot(account, slotNumber).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            this.saving = false;
+            if (error != null) {
+                this.selectionFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not select Bedrock character slot", error);
+            } else {
+                this.wardrobe = loaded;
+                this.loadAvatar(account);
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void refresh() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.loading) {
+            return;
+        }
+        this.loading = true;
+        this.failed = false;
+        this.selectionFailed = false;
+        BedrockCharacterProfiles.load(account).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            this.loading = false;
+            if (error != null) {
+                this.failed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character slots", error);
+            } else {
+                this.wardrobe = loaded;
+                this.items = null;
+                this.loadedCategory = null;
+                this.itemsFailed = false;
+                this.updateControls();
+                this.loadAvatar(account);
+                if (this.view == View.WARDROBE) {
+                    this.loadCategory();
+                }
+            }
+        }));
+    }
+
+}
