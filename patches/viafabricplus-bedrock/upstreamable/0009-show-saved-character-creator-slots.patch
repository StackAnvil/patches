+        private final class StatePlayback {
+            private final State definition;
+            private final List<Active> children;
+            private float time;
+            private boolean completed;
+
+            private StatePlayback(final State definition) {
+                this.definition = definition;
+                this.children = create(definition.animations);
+            }
+
+            private boolean allFinished() {
+                return this.children.stream().allMatch(Active::completed);
+            }
+
+            private boolean anyFinished() {
+                return this.children.stream().anyMatch(Active::completed);
+            }
+
+            private void reset() {
+                this.time = 0;
+                this.completed = false;
+                this.children.forEach(Active::reset);
+            }
+
+            private void apply(
+                    final float time,
+                    final float weight,
+                    final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                if (weight < Math.ulp(1F)) return;
+                for (final var variable : this.definition.variables.entrySet())
+                    molang.variable(variable.getKey(), variable.getValue().sample(molang));
+                for (final Active child : this.children) child.apply(time, weight, queries, pose);
+                this.completed = this.allFinished();
+            }
+        }
