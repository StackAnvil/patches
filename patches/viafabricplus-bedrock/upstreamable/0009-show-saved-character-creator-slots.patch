+    private static final int MAX_PARTICLES = 16384;
+    private static final long MAX_IMAGE_BYTES = 64L * 1024 * 1024;
+    private static final AtomicLong GENERATION = new AtomicLong(), IMAGE_BYTES = new AtomicLong();
+    private static final AtomicInteger PENDING = new AtomicInteger();
+    private static final ExecutorService DECODER = Executors.newSingleThreadExecutor(
+            Thread.ofPlatform().daemon().name("Bedrock particle decoder").factory());
+    private static final Map<Key, CompletableFuture<Loaded>> ASSETS = new HashMap<>();
+    private static final Map<Key, CompletableFuture<Void>> GRAPHS = new HashMap<>();
+    private static final List<Playing> EMITTERS = new ArrayList<>();
+    private static final BedrockParticleCounts COUNTS = new BedrockParticleCounts();
+    private static long textureSequence;
+    private static double previousClock = Double.NaN;
+    private static ClientLevel level;
+
+    private BedrockParticlePlayback() {}
+
+    static CompletableFuture<Boolean> play(final BedrockResourceLibrary resources, final String event,
+                                           final BedrockMolang environment, final BedrockMolang.Program initialization,
+                                           final Vec3 origin, final Supplier<BedrockParticleAttachment> attachment) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (minecraft.level == null || EMITTERS.size() >= 512) return CompletableFuture.completedFuture(false);
+        if (PENDING.incrementAndGet() > 32) { PENDING.decrementAndGet(); return CompletableFuture.completedFuture(false); }
+        final Key key = new Key(resources, event);
+        if (!GRAPHS.containsKey(key) && GRAPHS.size() >= 128) { PENDING.decrementAndGet(); return CompletableFuture.completedFuture(false); }
+        final long generation = GENERATION.get();
+        final ClientLevel requestedLevel = minecraft.level;
+        final var graph = GRAPHS.computeIfAbsent(key, _ -> BedrockParticleGraph.load(event, 128,
+                name -> asset(new Key(resources, name), generation).thenApply(loaded -> loaded.effect.childEffects()),
+                minecraft::execute));
+        final var started = new CompletableFuture<Boolean>();
+        graph.whenComplete((_, error) -> minecraft.execute(() -> {
+            try {
+                final Loaded loaded = loaded(key);
+                started.complete(error == null && generation == GENERATION.get() && minecraft.level == requestedLevel
+                        && loaded != null && start(key, loaded, environment, initialization,
+                        BedrockParticleAttachment.Matrix.translation(origin), attachment, 0, null, null));
+            } catch (RuntimeException invalid) {
+                started.completeExceptionally(invalid);
+            } finally { PENDING.decrementAndGet(); }
+        }));
+        return started;
+    }
+
+    private static CompletableFuture<Loaded> asset(final Key key, final long generation) {
+        if (generation != GENERATION.get())
+            return CompletableFuture.failedFuture(new IOException("Particle resource load was cancelled"));
+        final var existing = ASSETS.get(key);
+        if (existing != null) return existing;
+        if (ASSETS.size() >= 128)
+            return CompletableFuture.failedFuture(new IOException("Particle resource load was cancelled or exceeds its limit"));
+        final var result = new CompletableFuture<Loaded>();
+        ASSETS.put(key, result);
+        DECODER.execute(() -> load(key, generation, result));
+        return result;
+    }
+
+    private static Loaded loaded(final Key key) {
+        final var future = ASSETS.get(key);
+        return future == null || !future.isDone() || future.isCompletedExceptionally() || future.isCancelled()
+                ? null : future.getNow(null);
+    }
+
+    /** Runs inline from the event leaf, before its source expression. Definitions are already loaded. */
+    private static boolean start(final Key key, final Loaded loaded, final BedrockMolang environment,
+                              final BedrockMolang.Program initialization, final BedrockParticleAttachment.Matrix transform,
+                              final Supplier<BedrockParticleAttachment> attachment, final int depth,
+                              final BedrockParticleEvents.Request manual, final Playing parent) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (minecraft.level == null || depth > 16) return false;
+        Playing created = null;
+        try {
+            final var sampledAttachment = attachment == null ? null : attachment.get();
+            if (!valid(transform.origin()) || attachment != null && sampledAttachment == null) return false;
+            Playing playing = manual == null ? null : parent.manualChildren.get(key);
+            if (playing != null && !playing.emitter.alive()) {
+                parent.manualChildren.remove(key);
+                playing = null;
+            }
+            if (playing == null) {
+                if (EMITTERS.size() >= 512 || manual != null && !loaded.effect.manual()) return false;
+                // Animation roots supply their initial variables before creation; event children own fresh variables.
+                if (parent == null) environment.evaluate(initialization, 0);
+                final BedrockParticleBlocks.World world = BedrockNativeBlocks.world();
+                final var emitter = loaded.effect.emitter(environment, ThreadLocalRandom.current(), transform, world, COUNTS.queries(loaded.effect.identifier));
+                playing = new Playing(key, loaded, emitter, attachment, depth);
+                final Playing source = playing;
+                emitter.dispatcher(action -> dispatch(source, action));
+                EMITTERS.add(playing);
+                created = playing;
+                COUNTS.created(loaded.effect.identifier);
+                if (manual != null) parent.manualChildren.put(key, playing);
+            }
+            playing.emitter.queryContext(sampledAttachment, minecraft.gameRenderer.mainCamera().position());
+            if (parent != null) playing.emitter.initialize(initialization);
+            if (manual != null) playing.emitter.emit(manual.position(), manual.velocity(), available());
+            return true;
+        } catch (RuntimeException invalid) {
+            if (created != null) {
+                EMITTERS.remove(created);
+                COUNTS.removed(loaded.effect.identifier);
+                if (manual != null) parent.manualChildren.remove(key);
+            }
+            ViaFabricPlusBedrock.impl().logger().warn("Could not initialize Bedrock particle {}", key.event, invalid);
+            return false;
+        }
+    }
+
+    private static int available() {
+        int population = 0;
+        for (final Playing playing : EMITTERS) population += playing.emitter.size();
+        return MAX_PARTICLES - population;
+    }
+
+    private static void dispatch(final Playing parent, final BedrockParticleEvents.Action action) {
+        switch (action) {
+            case BedrockParticleEvents.Request particle -> child(parent, particle);
+            case BedrockParticleEvents.Sound sound -> {
+                final Vector3f position = sound.position();
+                final Vec3 origin = new Vec3(position.x, position.y, position.z);
+                if (valid(origin)) BedrockSoundPlayback.playLevel(parent.key.resources, sound.event(), origin);
+            }
+        }
+    }
+
+    private static void child(final Playing parent, final BedrockParticleEvents.Request request) {
+        final var spawn = request.spawn();
+        final boolean manual = spawn.kind().manual();
+        final var sampledAttachment = parent.attachment == null ? null : parent.attachment.get();
+        final boolean bound = spawn.kind() == BedrockParticleEvents.Kind.EMITTER_BOUND && sampledAttachment != null;
+        final var transform = request.emitterTransform(bound ? sampledAttachment : null, parent.emitter.baseOrigin());
+        final Vec3 offset = bound ? sampledAttachment.childOffset(parent.emitter.baseOrigin()) : Vec3.ZERO;
+        final Supplier<BedrockParticleAttachment> attachment = bound ? () -> {
+            final var sampled = parent.attachment.get();
+            return sampled == null ? null : sampled.withOffset(offset);
+        } : null;
+        final Key key = new Key(parent.key.resources, spawn.effect());
+        final Loaded loaded = loaded(key);
+        if (loaded != null) start(key, loaded, new BedrockMolang(), spawn.initialization(), transform,
+                attachment, parent.depth + 1, manual ? request : null, parent);
+    }
+
+    private static void load(final Key key, final long generation, final CompletableFuture<Loaded> result) {
+        long bytes = 0;
+        try {
+            final var document = key.resources.particle(key.event);
+            if (document == null) throw new IOException("Missing particle effect: " + key.event);
+            final var effect = BedrockParticleEffect.read(document);
+            final var image = BedrockParticleTexture.read(key.resources.particleTexture(effect.texture));
+            bytes = (long) image.getWidth() * image.getHeight() * 8;
+            if (IMAGE_BYTES.addAndGet(bytes) > MAX_IMAGE_BYTES) {
+                IMAGE_BYTES.addAndGet(-bytes);
+                bytes = 0;
+                throw new IOException("Particle images exceed the memory limit");
+            }
+            final long reserved = bytes;
+            Minecraft.getInstance().execute(() -> {
+                if (generation != GENERATION.get()) {
+                    IMAGE_BYTES.addAndGet(-reserved);
+                    result.completeExceptionally(new IOException("Particle resource load was cancelled"));
+                    return;
+                }
+                final Identifier texture = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "particles/" + textureSequence++);
+                try {
+                    register(texture, image);
+                    final var layer = effect.material.equals("particles_blend") ? SingleQuadParticle.Layer.TRANSLUCENT : SingleQuadParticle.Layer.OPAQUE;
+                    final var setup = RenderSetup.builder(layer.pipeline()).withTexture("Sampler0", texture).useLightmap();
+                    if (layer.translucent()) setup.sortOnUpload().setOitPipelines(layer.oitPipelineSet());
+                    final var type = MixinBedrockParticleRenderType.viaFabricPlusBedrock$create("bedrock_particle", setup.createRenderSetup());
+                    result.complete(new Loaded(effect, texture, type, reserved));
+                } catch (RuntimeException invalid) {
+                    Minecraft.getInstance().getTextureManager().release(texture);
+                    IMAGE_BYTES.addAndGet(-reserved);
+                    result.completeExceptionally(invalid);
+                }
+            });
+        } catch (Exception invalid) {
+            if (bytes != 0) IMAGE_BYTES.addAndGet(-bytes);
+            result.completeExceptionally(invalid);
+            ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock particle {}", key.event, invalid);
+        }
+    }
+
+    /** Releases textures and invalidates resource work before account or world state changes. */
+    public static void stop() {
+        BedrockServerResources.clear();
+        GENERATION.incrementAndGet();
+        final Minecraft minecraft = Minecraft.getInstance();
+        final Runnable clear = () -> {
+            for (final var future : ASSETS.values()) {
+                if (future.isCompletedExceptionally() || future.isCancelled()) continue;
+                final var loaded = future.getNow(null);
+                if (loaded != null) {
+                    minecraft.getTextureManager().release(loaded.texture);
+                    IMAGE_BYTES.addAndGet(-loaded.bytes);
+                }
+            }
+            ASSETS.clear();
+            GRAPHS.clear();
+            EMITTERS.clear();
+            COUNTS.clear();
+            previousClock = Double.NaN;
+            level = null;
+        };
+        if (minecraft.isSameThread()) clear.run(); else minecraft.execute(clear);
+    }
+
+    public static void extract(final ParticlesRenderState state, final Frustum frustum, final Camera camera, final float partialTick) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (minecraft.level == null) return;
+        if (level != null && level != minecraft.level) { stop(); return; }
+        level = minecraft.level;
+        final double clock = level.getGameTime() + Math.clamp(partialTick, 0, 1);
+        final long elapsed = Double.isNaN(previousClock) || clock < previousClock || minecraft.isPaused()
+                ? 0 : Math.round((clock - previousClock) * 50_000_000D);
+        previousClock = clock;
+        final List<Quad> quads = new ArrayList<>();
+        final Map<BlockPos, List<BedrockParticleCollision.Box>> collisionBoxes = new HashMap<>();
+        final BedrockParticleCollision.Terrain terrain = (x, y, z) -> {
+            final BlockPos cell = new BlockPos(x, y, z);
+            final var cached = collisionBoxes.get(cell);
+            if (cached != null) return cached;
+            final List<BedrockParticleCollision.Box> boxes = new ArrayList<>();
+            for (final var shape : level.getBlockCollisions(null, new AABB(x, y, z, x + 1D, y + 1D, z + 1D)))
+                for (final AABB box : shape.toAabbs())
+                    boxes.add(new BedrockParticleCollision.Box((float) box.minX, (float) box.minY, (float) box.minZ,
+                            (float) box.maxX, (float) box.maxY, (float) box.maxZ));
+            final var result = List.copyOf(boxes);
+            if (collisionBoxes.size() < 4096) collisionBoxes.put(cell, result);
+            return result;
+        };
+        final var cameraMatrix = new BedrockParticleAttachment.Matrix(
+                new Matrix4f().rotation(camera.rotation()).get(new float[16]));
+        // Prune before capturing the batch. Children appended during updates wait for the next batch.
+        BedrockParticleFrames.advance(EMITTERS, COUNTS, playing -> playing.loaded.effect.identifier,
+                playing -> playing.emitter.alive(), playing -> {
+            final var attachment = playing.attachment == null ? null : playing.attachment.get();
+            playing.emitter.queryContext(attachment, camera.position());
+            playing.emitter.advance(elapsed, BedrockParticlePlayback::available, attachment, terrain);
+            for (final String message : playing.emitter.drainLogs())
+                ViaFabricPlusBedrock.impl().logger().debug("Bedrock particle {}: {}", playing.key.event, message);
+        }, playing -> playing.emitter.size());
+        // Manual child particles are visible in this frame even though new emitters have not advanced yet.
+        for (final Playing playing : EMITTERS) {
+            final var attachment = playing.attachment == null ? null : playing.attachment.get();
+            playing.emitter.queryContext(attachment, camera.position());
+            for (final var visual : playing.emitter.visuals()) {
+                final Vec3 position = new Vec3(visual.position().x, visual.position().y, visual.position().z);
+                final double radius = Math.hypot(visual.width(), visual.height());
+                if (!valid(position) || !Float.isFinite(visual.u0()) || !Float.isFinite(visual.v0())
+                        || !Float.isFinite(visual.u1()) || !Float.isFinite(visual.v1()) || radius <= 0 || radius > 32768) continue;
+                final Vec3 relative = position.subtract(camera.position());
+                final var facing = BedrockParticleFacing.basis(visual.mode(),
+                        new Vector3f((float) relative.x, (float) relative.y, (float) relative.z), visual.direction(),
+                        cameraMatrix, visual.matrix()).rotate(visual.rotation());
+                if (!facing.finite()) continue;
+                final Vector3f extent = facing.extent(visual.width(), visual.height());
+                if (!frustum.isVisible(new AABB(position.x-extent.x, position.y-extent.y, position.z-extent.z,
+                        position.x+extent.x, position.y+extent.y, position.z+extent.z))) continue;
+                final int light = playing.loaded.effect.lighting
+                        ? LightCoordsUtil.getLightCoords(level, BlockPos.containing(position)) : LightCoordsUtil.FULL_BRIGHT;
+                quads.add(new Quad(playing.loaded.type, (float) relative.x, (float) relative.y, (float) relative.z,
+                        facing, visual.width(), visual.height(), visual.u0(), visual.v0(), visual.u1(), visual.v1(), visual.color(), light));
+            }
+        }
+        if (!quads.isEmpty()) {
+            final List<Quad> snapshot = List.copyOf(quads);
+            final ParticleGroupRenderState frame = (collector, _) -> {
+                final PoseStack poses = new PoseStack();
+                for (final Quad quad : snapshot)
+                    collector.submitCustomGeometry(poses, quad.type, (_, vertices) -> {
+                        final float[] x = {1, 1, -1, -1}, y = {-1, 1, 1, -1};
+                        final float[] u = {quad.u1, quad.u1, quad.u0, quad.u0}, v = {quad.v1, quad.v0, quad.v0, quad.v1};
+                        for (int index = 0; index < 4; index++) {
+                            final var point = quad.facing.point(x[index] * quad.width, y[index] * quad.height);
+                            vertices.addVertex(point.x + quad.x, point.y + quad.y, point.z + quad.z)
+                                    .setUv(u[index], v[index]).setColor(quad.color).setLight(quad.light);
+                        }
+                    });
+            };
+            state.add(frame);
+        }
+    }
+
+    private static boolean valid(final Vec3 position) {
+        return position != null && Double.isFinite(position.x) && Double.isFinite(position.y) && Double.isFinite(position.z);
+    }
+
+    private static void register(final Identifier texture, final BufferedImage image) {
+        final NativeImage pixels = new NativeImage(image.getWidth(), image.getHeight(), false);
+        try {
+            for (int y = 0; y < image.getHeight(); y++) for (int x = 0; x < image.getWidth(); x++) {
+                final int argb = image.getRGB(x, y);
+                pixels.setPixelABGR(x, y, (argb & 0xFF00FF00) | (argb & 255) << 16 | (argb >>> 16 & 255));
+            }
+            Minecraft.getInstance().getTextureManager().register(texture, new DynamicTexture(texture::toString, pixels));
+        } catch (RuntimeException invalid) { pixels.close(); throw invalid; }
+    }
+
+    private record Key(BedrockResourceLibrary resources, String event) {}
+    private record Loaded(BedrockParticleEffect effect, Identifier texture, RenderType type, long bytes) {}
+    private static final class Playing {
+        final Key key;
+        final Loaded loaded;
+        final BedrockParticleEffect.Emitter emitter;
+        final Supplier<BedrockParticleAttachment> attachment;
+        final int depth;
+        final Map<Key, Playing> manualChildren = new HashMap<>();
+
+        Playing(final Key key, final Loaded loaded, final BedrockParticleEffect.Emitter emitter,
+                final Supplier<BedrockParticleAttachment> attachment, final int depth) {
+            this.key = key;
+            this.loaded = loaded;
+            this.emitter = emitter;
+            this.attachment = attachment;
+            this.depth = depth;
+        }
+    }
+    private record Quad(RenderType type, float x, float y, float z, BedrockParticleFacing.Basis facing, float width, float height,
+                        float u0, float v0, float u1, float v1, int color, int light) {}
+}
