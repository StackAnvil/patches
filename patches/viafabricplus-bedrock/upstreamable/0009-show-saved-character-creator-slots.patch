+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleGraphTest {
+    @Test
+    void waitsForNestedSharedAndCyclicDependencies() {
+        final Map<String, CompletableFuture<Set<String>>> assets = new HashMap<>();
+        final List<String> requested = new ArrayList<>();
+        final var graph = BedrockParticleGraph.load("root", 8, name -> {
+            requested.add(name);
+            return assets.computeIfAbsent(name, _ -> new CompletableFuture<>());
+        }, Runnable::run);
+        assets.get("root").complete(Set.of("left", "right"));
+        assertFalse(graph.isDone());
+        assets.get("left").complete(Set.of("shared", "root"));
+        assertFalse(assets.containsKey("shared"));
+        assets.get("right").complete(Set.of("shared"));
+        assertFalse(graph.isDone());
+        assets.get("shared").complete(Set.of("left"));
+        graph.join();
+        assertEquals(Set.of("root", "left", "right", "shared"), Set.copyOf(requested));
+        assertEquals(4, requested.size());
+    }
+
+    @Test
+    void unavailableChildrenSettleTheGraphAndLimitsStopDiscovery() {
+        final List<String> requested = new ArrayList<>();
+        final var graph = BedrockParticleGraph.load("root", 8, name -> {
+            requested.add(name);
+            return name.equals("root") ? CompletableFuture.completedFuture(Set.of("missing", "child"))
+                    : CompletableFuture.failedFuture(new java.io.IOException());
+        }, Runnable::run);
+        graph.join();
+        assertEquals(3, requested.size());
+        requested.clear();
+        final var oversized = BedrockParticleGraph.load("0", 3, name -> {
+            requested.add(name);
+            return CompletableFuture.completedFuture(Set.of(Integer.toString(Integer.parseInt(name) + 1)));
+        }, Runnable::run);
+        assertThrows(CompletionException.class, oversized::join);
+        assertEquals(List.of("0", "1", "2"), requested);
+    }
+
+    @Test
+    void findsAllParsedBranchesWithoutExecutingTheirExpressions() throws Exception {
+        final var document = JsonParser.parseString("""
+                {"run":{"sequence":[
+                    {"particle_effect":{"effect":"test:ignored","type":"emitter"},
+                     "randomize":[
+                        {"particle_effect":{"effect":"test:left","type":"emitter"}},
+                        {"weight":0,"particle_effect":{"effect":"test:right","type":"emitter"}}]},
+                    {"particle_effect":{"effect":"test:left","type":"particle"},"expression":"v.executed=1;"}]}}
+                """).getAsJsonObject();
+        final var events = BedrockParticleEvents.read(document);
+        assertEquals(Set.of("test:left", "test:right"), events.effects());
+    }
+}
