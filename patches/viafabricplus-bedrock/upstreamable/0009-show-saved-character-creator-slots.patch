+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.persona_PieceType;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+
+final class BedrockLimbSideTest {
+    @Test
+    void changesSidesWithoutLosingTheRecipeSource() throws Exception {
+        final String id = UUID.randomUUID().toString();
+        for (final String source : List.of(id, id + "/f", id + "/d")) {
+            for (final var before : BedrockLimbSide.values()) {
+                final String original = before.recipe(source);
+                assertEquals(before, BedrockLimbSide.fromRecipe(original));
+                assertEquals(source, BedrockLimbSide.BOTH.recipe(original));
+                for (final var after : BedrockLimbSide.values()) {
+                    final String changed = after.recipe(original);
+                    assertEquals(after, BedrockLimbSide.fromRecipe(changed));
+                    assertEquals(original, before.recipe(changed));
+                }
+            }
+        }
+    }
+
+    @Test
+    void rejectsRecipesWhoseFlagsDoNotDescribeALimb() {
+        final String id = UUID.randomUUID().toString();
+        for (final String flags : List.of("/", "/e", "/de", "/df", "/lr", "/unknown", "/f/l")) {
+            final String recipe = id + flags;
+            assertFalse(BedrockLimbSide.supportsSides(recipe));
+            for (final var side : BedrockLimbSide.values()) {
+                assertThrows(IOException.class, () -> side.recipe(recipe));
+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_LIMB_RECIPE_RESULT", matches = ".+")
+    void matchesNativeRecipeEncodingAndPacketTypes() throws Exception {
+        final var rows =
+                JsonParser.parseString(
+                                Files.readString(
+                                        Path.of(System.getenv("STACKANVIL_LIMB_RECIPE_RESULT"))))
+                        .getAsJsonArray();
+        assertEquals(18, rows.size());
+        for (final var element : rows) {
+            final var row = element.getAsJsonObject();
+            final var nativeType = persona_PieceType.getByValue(row.get("pieceType").getAsInt());
+            final var side =
+                    switch (nativeType) {
+                        case LeftArm, LeftLeg -> BedrockLimbSide.LEFT;
+                        case RightArm, RightLeg -> BedrockLimbSide.RIGHT;
+                        case Arms, Legs -> BedrockLimbSide.BOTH;
+                        default ->
+                                throw new AssertionError(
+                                        "The native fixture contains a non-limb piece");
+                    };
+            final String recipe = row.get("recipe").getAsString();
+            final String base = recipe.split("/", 2)[0];
+            final String source =
+                    switch (row.get("source").getAsString()) {
+                        case "owned" -> base;
+                        case "free" -> base + "/f";
+                        case "default" -> base + "/d";
+                        default ->
+                                throw new AssertionError(
+                                        "The native fixture contains an unknown source");
+                    };
+            assertEquals(recipe, side.recipe(source));
+            assertEquals(side, BedrockLimbSide.fromRecipe(recipe));
+            final String category = nativeType.getValue() < 22 ? "persona_legs" : "persona_arms";
+            assertEquals(
+                    nativeType,
+                    persona_PieceType.getByName(
+                            BedrockLimbSide.fromRecipe(recipe).packetType(category)));
+        }
+    }
+}
