+    @Test
+    void keepsUnresolvedTracksInactiveWithoutCompletingControllerStates() throws IOException {
+        final var entity =
+                json(
+                        """
+                        {"animations":{"root":"controller.animation.root",
+                          "missing":"animation.missing","missing_controller":"controller.animation.missing",
+                          "finite":"animation.finite","observer":"animation.observer"},
+                         "scripts":{"initialize":["v.stage=0; v.animation_weights=0; v.controller_weights=0;"],
+                                    "animate":["root","observer"]}}
+                        """);
+        final var animations =
+                json(
+                        """
+                        {"animation.finite":{"animation_length":0.25,"loop":"hold_on_last_frame",
+                          "bones":{"arm":{"rotation":3}}},
+                         "animation.observer":{"loop":true,"bones":{"head":{
+                          "position":["v.stage",0,0],
+                          "rotation":["v.animation_weights","v.controller_weights",0]}}}}
+                        """);
+        final var controllers =
+                json(
+                        """
+                        {"controller.animation.root":{"states":{
+                          "default":{"animations":[
+                            {"missing":"v.animation_weights=v.animation_weights+1; return 1;"},
+                            {"missing_controller":"v.controller_weights=v.controller_weights+1; return 1;"},"finite"],
+                            "transitions":[{"all":"q.all_animations_finished"},{"any":"q.any_animation_finished"}]},
+                          "any":{"on_entry":["v.stage=2;"],"animations":[
+                            {"missing":"v.animation_weights=v.animation_weights+1; return 1;"},
+                            {"missing_controller":"v.controller_weights=v.controller_weights+1; return 1;"}],
+                            "transitions":[{"all":"q.all_animations_finished"}]},
+                          "all":{"on_entry":["v.stage=1;"]}}}}
+                        """);
+        final var graph =
+                BedrockActorAnimation.read(entity, Map.of(), animations, controllers, "1.10.0");
+        final var actor = graph.playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        final var first = actor.sample(0, frame);
+        assertEquals(3, first.get("arm").rotation().x());
+        assertEquals(new BedrockBoneAnimation.Vector(0, 1, 0), first.get("head").rotation());
+        assertEquals(0, actor.sample(0.25F, frame).get("head").position().x());
+        final var any = actor.sample(0.5F, frame);
+        assertEquals(2, any.get("head").position().x());
+        assertEquals(new BedrockBoneAnimation.Vector(0, 3, 0), any.get("head").rotation());
+        assertFalse(any.containsKey("arm"));
+        assertEquals(2, actor.sample(1, frame).get("head").position().x());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(0, 1, 0),
