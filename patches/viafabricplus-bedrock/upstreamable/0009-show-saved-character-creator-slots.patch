+        bytes[12] = (byte) 128;
+        bytes[14] = (byte) 128;
+        bytes[16] = 32;
+        bytes[17] = 32;
+        final int offset = 18 + (12 * 128 + 10) * 4;
+        bytes[offset + 1] = (byte) 129;
+        bytes[offset + 2] = (byte) 127;
+        bytes[offset + 3] = (byte) 255;
+        return bytes;
+    }
+
+    private static BufferedImage image(final int width, final int height, final int color) {
+        final BufferedImage result = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < height; y++) for (int x = 0; x < width; x++) result.setRGB(x, y, color);
+        return result;
+    }
+
+    private static byte[] png(final BufferedImage image) throws Exception {
+        final var output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
