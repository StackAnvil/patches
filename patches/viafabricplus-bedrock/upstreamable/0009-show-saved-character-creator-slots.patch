+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleQueriesTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeActorQueriesCameraDistanceAndSeparateClocks() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-query-context-result.json"))).getAsJsonObject();
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var actor = row.get("actor_bound").getAsBoolean()
+                    ? attachment(Map.of("is_in_water", row.get("water").getAsBoolean(),
+                        "ground_speed", BedrockParticleQueries.groundSpeed(vector(row.getAsJsonArray("motion"))),
+                        "anim_time", 91F, "delta_time", 92F, "frame_alpha", 93F, "life_time", 94F)) : null;
+            final var environment = new BedrockMolang();
+            environment.clock(95, 96, 97);
+            environment.queries(BedrockParticleQueries.sample(actor, new Vector3f((float) row.getAsJsonArray("origin").get(0).getAsDouble(),
+                        (float) row.getAsJsonArray("origin").get(1).getAsDouble(), (float) row.getAsJsonArray("origin").get(2).getAsDouble()),
+                    vector(row.getAsJsonArray("camera"))));
+            for (final String query : List.of("ground_speed", "is_in_water", "anim_time", "delta_time", "frame_alpha", "life_time", "distance_from_camera")) {
+                final String field = query.equals("distance_from_camera") ? "distance" : query;
+                assertEquals(row.get(field).getAsFloat(), evaluate(environment, "q." + query));
+            }
+        }
+    }
+
+    @Test
+    void refreshesExistingParticleQueriesWithoutResettingTheirVariables() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:emitter_local_space", JsonParser.parseString("{\"position\":false}"));
+        components.add("minecraft:particle_initialization", JsonParser.parseString("""
+                {"creation_expression":"v.local=7;", "per_update_expression":"v.local=v.local+1;"}
+                """));
+        components.add("minecraft:particle_appearance_billboard", JsonParser.parseString("""
+                {"size":["q.ground_speed+v.local+q.property('growth')", "q.is_in_water+q.distance_from_camera"]}
+                """));
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var first = new BedrockParticleAttachment(new Vec3(3, 4, 12), 180, null, null,
+                Map.of("ground_speed", 2F, "is_in_water", false, "property", (BedrockActorAnimation.Query) _ -> 5F));
+        emitter.queryContext(first, Vec3.ZERO);
+        emitter.advance(0, 10, first, (x, y, z) -> List.of());
+        emitter.queryContext(first, Vec3.ZERO);
+        assertEquals(15, emitter.visuals().getFirst().width());
+        assertEquals(13, emitter.visuals().getFirst().height());
+        final var second = new BedrockParticleAttachment(new Vec3(3, 4, 12), 180, null, null,
+                Map.of("ground_speed", 4F, "is_in_water", true, "property", (BedrockActorAnimation.Query) _ -> 6F));
+        emitter.queryContext(second, Vec3.ZERO);
+        emitter.advance(50_000_000, 10, second, (x, y, z) -> List.of());
+        emitter.queryContext(second, Vec3.ZERO);
+        assertEquals(19, emitter.visuals().getFirst().width());
+        assertEquals(14, emitter.visuals().getFirst().height());
+        emitter.queryContext(null, Vec3.ZERO);
+        assertEquals(9, emitter.visuals().getFirst().width());
+        assertEquals(13, emitter.visuals().getFirst().height());
+    }
+
+    @Test
+    void refreshesChildInitializationWithImmutableActorQuerySnapshots() throws Exception {
+        final Map<String, Object> queries = new HashMap<>();
+        queries.put("ground_speed", 4F);
+        queries.put("property", (BedrockActorAnimation.Query) arguments -> arguments.getFirst().equals("growth") ? 7F : 0F);
+        final var actor = attachment(queries);
+        queries.put("ground_speed", 99F);
+        final var child = new BedrockMolang();
+        child.variable("local", 2);
+        child.queries(BedrockParticleQueries.sample(actor, new Vector3f(3, 4, 0), Vec3.ZERO));
+        assertEquals(11, evaluate(child, "q.ground_speed+q.property('growth')"));
+        assertEquals(2, evaluate(child, "v.local"));
+        assertEquals(5, evaluate(child, "q.distance_from_camera"));
+        assertThrows(UnsupportedOperationException.class, () -> actor.queries().put("ground_speed", 5F));
+    }
+
+    private static BedrockParticleAttachment attachment(final Map<String, Object> queries) {
+        return new BedrockParticleAttachment(Vec3.ZERO, 180, null, null, queries);
+    }
+    private static Vec3 vector(final JsonArray array) {
+        return new Vec3(array.get(0).getAsDouble(), array.get(1).getAsDouble(), array.get(2).getAsDouble());
+    }
+    private static float evaluate(final BedrockMolang environment, final String expression) throws java.io.IOException {
+        return environment.evaluate(BedrockMolang.Program.parse(new com.google.gson.JsonPrimitive(expression), 0), 0);
+    }
+}
