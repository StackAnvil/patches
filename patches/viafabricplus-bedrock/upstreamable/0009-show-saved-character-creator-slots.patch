@@ -0,0 +1,70 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.client.sounds.AudioStream;
+
+import javax.sound.sampled.AudioFormat;
+import java.nio.ByteBuffer;
+import java.util.ArrayDeque;
+
+/** Repeats whole PCM frames without duplicating the sample, and tracks queued OpenAL frames. */
+public final class BedrockPcmStream implements AudioStream {
+    private final byte[] pcm;
+    private final AudioFormat format;
+    private final int frameCount;
+    private final int loops;
+    private final long end;
+    private final ArrayDeque<Integer> queued = new ArrayDeque<>();
+    private long cursor, processed;
+    private boolean closed;
+
+    BedrockPcmStream(final byte[] pcm, final AudioFormat format, final int loops, final float offset) {
+        if (pcm.length == 0 || pcm.length % format.getFrameSize() != 0 || loops < -1
+                || !Float.isFinite(offset) || offset < 0) throw new IllegalArgumentException("Invalid sound playback bounds");
+        this.pcm = pcm;
+        this.format = format;
+        this.frameCount = pcm.length / format.getFrameSize();
+        this.loops = loops;
+        this.end = loops == -1 ? Long.MAX_VALUE : (loops + 1L) * this.frameCount;
+        this.cursor = this.processed = Math.min(this.frameCount, (long) (offset * format.getSampleRate()));
+    }
+
+    @Override public AudioFormat getFormat() { return this.format; }
+
+    @Override
+    public ByteBuffer read(final int requested) {
+        if (requested < 0) throw new IllegalArgumentException("Negative PCM buffer size");
+        final int frames = this.closed ? 0 : (int) Math.min(requested / this.format.getFrameSize(), this.end - this.cursor);
+        if (frames == 0) return null;
+        final ByteBuffer bytes = ByteBuffer.allocateDirect(frames * this.format.getFrameSize());
+        int remaining = frames;
+        while (remaining > 0) {
+            final int start = (int) (this.cursor % this.frameCount);
+            final int count = Math.min(remaining, this.frameCount - start);
+            bytes.put(this.pcm, start * this.format.getFrameSize(), count * this.format.getFrameSize());
+            this.cursor += count;
+            remaining -= count;
+        }
+        if (frames > 0) this.queued.addLast(frames);
+        return bytes.flip();
+    }
+
+    /** Called on the sound executor after Channel removes processed OpenAL buffers. */
+    public void processed(final int count) {
+        for (int index = 0; index < count; index++) {
+            final Integer frames = this.queued.pollFirst();
+            if (frames == null) throw new IllegalStateException("Unexpected processed PCM buffer");
+            this.processed += frames;
+        }
+    }
+
+    int remainingLoops(final int sampleOffset) {
+        return this.loops == -1 ? -1 : (int) Math.max(0, this.loops - (this.processed + Math.max(0, sampleOffset)) / this.frameCount);
+    }
+
+    @Override public void close() { this.closed = true; }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimationAtlas.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimationAtlas.java
