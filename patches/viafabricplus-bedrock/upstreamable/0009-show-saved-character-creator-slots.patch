+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Particle evaluation keeps actor bindings separate from emitter variables and animation clocks. */
+public final class BedrockParticleQueries {
+    private static final BedrockActorAnimation.Query ZERO = _ -> 0F;
+
+    private BedrockParticleQueries() {}
+
+    static Map<String, Object> sample(final BedrockParticleAttachment attachment, final Vector3f origin, final Vec3 camera) {
+        final Map<String, Object> queries = new HashMap<>();
+        if (attachment != null && attachment.hasActor()) queries.putAll(attachment.queries());
+        final float x = origin.x - (float) camera.x, y = origin.y - (float) camera.y, z = origin.z - (float) camera.z;
+        queries.put("distance_from_camera", (float) Math.sqrt((y * y + x * x) + z * z));
+        // The target particle context leaves these generic animation fields at their constructor defaults.
+        queries.put("anim_time", ZERO);
+        queries.put("delta_time", ZERO);
+        queries.put("frame_alpha", 0F);
+        queries.put("life_time", 0F);
+        queries.putAll(BedrockParticleCounts.UNBOUND);
+        queries.putIfAbsent("spellcolor", BedrockMolangColor.ZERO);
+        return Map.copyOf(queries);
+    }
+
+    public static float groundSpeed(final Vec3 movement) {
+        final float x = (float) movement.x * 20F, y = (float) movement.y * 20F, z = (float) movement.z * 20F;
+        return (float) Math.sqrt(z * z + (y * y + x * x));
+    }
+}
