+    private void toggleColors() {
+        if (this.view == View.COLORS) {
+            this.view = this.colorOrigin;
+        } else {
+            if (this.availableColors.isEmpty()) return;
+            this.colorOrigin = this.view;
+            this.colorTarget = this.availableColors.getFirst();
+            this.selectedColor = this.colorTarget.paletteIndex(this.currentColor());
+            this.editFailed = false;
+            this.acquisitionFailed = false;
+            this.view = View.COLORS;
+        }
+        this.updateControls();
+    }
