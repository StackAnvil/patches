+final class BedrockParticleEffectTest {
+    @Test
+    void decodesTheSameParticlePixelsFromPngAndTga() throws Exception {
+        final var image = new java.awt.image.BufferedImage(3, 2, java.awt.image.BufferedImage.TYPE_INT_ARGB);
+        final byte[] tga = new byte[18 + 3 * 2 * 4];
+        tga[2] = 2; tga[12] = 3; tga[14] = 2; tga[16] = 32; tga[17] = 0x28;
+        final var pixels = java.nio.ByteBuffer.wrap(tga).order(java.nio.ByteOrder.LITTLE_ENDIAN);
+        pixels.position(18);
+        for (int y = 0; y < 2; y++) for (int x = 0; x < 3; x++) {
+            final int color = (127 + y * 127) << 24 | x * 100 << 16 | y * 120 << 8 | 99;
+            image.setRGB(x, y, color); pixels.putInt(color);
+        }
+        final var png = new java.io.ByteArrayOutputStream();
+        javax.imageio.ImageIO.write(image, "png", png);
+        for (final byte[] bytes : List.of(tga, png.toByteArray())) {
+            final var decoded = BedrockParticleTexture.read(bytes);
+            assertEquals(image.getWidth(), decoded.getWidth());
+            assertEquals(image.getHeight(), decoded.getHeight());
+            for (int y = 0; y < 2; y++) for (int x = 0; x < 3; x++) assertEquals(image.getRGB(x, y), decoded.getRGB(x, y));
+        }
+        assertThrows(IOException.class, () -> BedrockParticleTexture.read(java.util.Arrays.copyOf(tga, tga.length - 1)));
+    }
+
+    @Test
