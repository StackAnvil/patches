+
+final class BedrockPersonaAssetsTest {
+    @Test
+    void acceptsNativeContentHostsAndRejectsDeceptiveAssetLocations() {
+        for (final String host :
+                new String[] {
+                    "xforgeassets001.xboxlive.com",
+                    "content1.prod.catalog.playfab.com",
+                    "content2.prod.catalog.playfab.com"
+                }) {
+            final URI asset = URI.create("https://" + host + "/pack.zip");
+            assertDoesNotThrow(() -> BedrockMarketplaceAssets.validateDownload(asset));
+            for (final URI invalid :
+                    new URI[] {
+                        URI.create("http://" + host + "/pack.zip"),
+                        URI.create("https://" + host + ".example.com/pack.zip"),
+                        URI.create("https://" + host + "@example.com/pack.zip"),
+                        URI.create("https://" + host + ":8443/pack.zip"),
+                        URI.create("https://" + host + "/pack.zip#fragment")
+                    }) {
+                assertThrows(
+                        IOException.class,
+                        () -> BedrockMarketplaceAssets.validateDownload(invalid));
+            }
+        }
+        assertThrows(IOException.class, () -> BedrockMarketplaceAssets.validateDownload(null));
+    }
+
+    @Test
+    void decodesOnlyThePackAuthorizedByTheReceipt() throws Exception {
+        final String id = UUID.randomUUID().toString();
+        final byte[] key = new byte[32], fileKey = new byte[32], data = new byte[8192];
+        new java.util.Random(17).nextBytes(key);
+        Arrays.fill(fileKey, (byte) 'a');
+        new java.util.Random(31).nextBytes(data);
+        final JsonObject receipt = new JsonObject(),
+                receiptData = new JsonObject(),
+                entitlement = new JsonObject();
+        final String entity = UUID.randomUUID().toString(), device = UUID.randomUUID().toString();
+        receipt.addProperty("EntityId", entity);
+        receiptData.addProperty("DeviceId", device);
+        receipt.add("ReceiptData", receiptData);
+        final byte[] wrapped = new byte[64];
+        for (int index = 0; index < key.length; index++)
+            wrapped[index * 2] = (byte) (key[index] ^ entity.charAt(index) ^ device.charAt(index));
+        entitlement.addProperty("PackId", id);
+        entitlement.addProperty("ContentKey", Base64.getEncoder().encodeToString(wrapped));
+        final JsonArray entitlements = new JsonArray();
+        entitlements.add(entitlement);
+        receipt.add("EntitlementReceipts", entitlements);
+        final var keys = BedrockMarketplaceAssets.receiptKeys(receipt);
+        assertArrayEquals(key, keys.get(id));
+        assertFalse(keys.containsKey(UUID.randomUUID().toString()));
+        final byte[] archive = archive(id, key, fileKey, data);
+        assertArrayEquals(
+                data,
+                BedrockMarketplaceAssets.decode(archive, id, List.of(keys.get(id)))
+                        .files()
+                        .get("texture.png"));
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockMarketplaceAssets.decode(
+                                archive, UUID.randomUUID().toString(), List.of(key)));
+        assertThrows(
+                IOException.class,
+                () -> BedrockMarketplaceAssets.decode(archive, id, List.of(new byte[32])));
+        assertThrows(
+                IOException.class,
+                () -> BedrockMarketplaceAssets.decode(new byte[8], id, List.of(key)));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"ppack0.zip", "spack0.zip", "named_skinpack.zip"})
+    void resolvesSharedReceiptKeysWithoutChangingPackIdentityChecks(final String wrapperName)
+            throws Exception {
+        final String id = UUID.randomUUID().toString();
+        final byte[] key = new byte[32], fileKey = new byte[32], data = new byte[4096];
+        new java.util.Random(63).nextBytes(key);
+        Arrays.fill(fileKey, (byte) 'b');
+        new java.util.Random(7).nextBytes(data);
+        final byte[] inner = archive(id, key, fileKey, data);
+        final ByteArrayOutputStream wrapped = new ByteArrayOutputStream();
+        try (final ZipOutputStream zip = new ZipOutputStream(wrapped)) {
+            zip.putNextEntry(new ZipEntry(wrapperName));
+            zip.write(inner);
+            zip.closeEntry();
+        }
+        final var candidates = List.of(new byte[32], new byte[32], key, key);
+        assertArrayEquals(
+                data,
+                BedrockMarketplaceAssets.decode(wrapped.toByteArray(), id, candidates)
+                        .files()
+                        .get("texture.png"));
