+            if (!value.isJsonObject() || value.getAsJsonObject().size() > 256) throw new IOException("Invalid particle events");
+            final int[] remaining = {MAX_NODES};
+            for (final var entry : value.getAsJsonObject().entrySet()) {
+                if (entry.getKey().isEmpty() || entry.getKey().length() > 256) throw new IOException("Invalid particle event name");
+                events.put(entry.getKey(), node(entry.getValue(), 0, remaining));
+            }
+        }
+        return new BedrockParticleEvents(events);
+    }
+
+    private static Node node(final JsonElement value, final int depth, final int[] remaining) throws IOException {
+        if (!value.isJsonObject() || depth > MAX_DEPTH || --remaining[0] < 0) throw new IOException("Particle event tree exceeds its limit");
+        final JsonObject object = value.getAsJsonObject();
+        for (final String field : object.keySet())
+            if (!Set.of("sequence", "randomize", "weight", "particle_effect", "expression", "log", "sound_effect").contains(field))
+                throw new IOException("Unsupported particle event field: " + field);
+        final List<Node> sequence = new ArrayList<>();
+        if (object.has("sequence")) {
+            if (!object.get("sequence").isJsonArray()) throw new IOException("Invalid particle event sequence");
+            for (final var child : object.getAsJsonArray("sequence")) sequence.add(node(child, depth + 1, remaining));
+        }
+        final List<Weighted> randomize = new ArrayList<>();
+        float total = 0;
+        if (object.has("randomize")) {
+            if (!object.get("randomize").isJsonArray()) throw new IOException("Invalid random particle events");
+            for (final var child : object.getAsJsonArray("randomize")) {
+                if (!child.isJsonObject()) throw new IOException("Invalid random particle event");
+                final float weight = child.getAsJsonObject().has("weight") ? child.getAsJsonObject().get("weight").getAsFloat() : 1;
+                if (!Float.isFinite(weight) || weight < 0) throw new IOException("Invalid particle event weight");
+                total += weight;
+                if (!Float.isFinite(total)) throw new IOException("Particle event weights exceed their limit");
+                randomize.add(new Weighted(weight, node(child, depth + 1, remaining)));
+            }
+        }
+        // Both native parsers omit the leaf actions when sequence or randomize is present.
+        if (object.has("sequence") || object.has("randomize"))
+            return new Node(List.copyOf(sequence), List.copyOf(randomize), total, null, null, null, null);
+        String sound = null;
+        if (object.has("sound_effect")) {
+            final JsonElement valueName = object.getAsJsonObject("sound_effect").get("event_name");
+            if (valueName == null || !valueName.isJsonPrimitive() || !valueName.getAsJsonPrimitive().isString()
+                    || valueName.getAsString().length() > 256)
+                throw new IOException("Invalid particle level sound event");
+            // The native unknown event suppresses sound while retaining expressions and logs.
+            sound = BedrockLevelSounds.name(valueName.getAsString());
+        }
+        final JsonObject particle = object.has("particle_effect") ? object.getAsJsonObject("particle_effect") : null;
+        Spawn spawn = null;
+        if (particle != null) {
+            final String effect = particle.get("effect").getAsString();
+            if (!effect.matches("[a-z0-9_.-]+:[a-z0-9_./-]+") || effect.length() > 256) throw new IOException("Invalid child particle effect");
+            final Kind kind;
+            try { kind = Kind.valueOf(particle.get("type").getAsString().toUpperCase(java.util.Locale.ROOT)); }
+            catch (IllegalArgumentException invalid) { throw new IOException("Invalid child particle emission type", invalid); }
+            spawn = new Spawn(effect, kind, BedrockParticleEffect.program(particle, "pre_effect_expression", 0));
+        }
+        final String log = object.has("log") ? object.get("log").getAsString() : "";
+        if (log.length() > 4096) throw new IOException("Particle event log exceeds its limit");
+        return new Node(List.of(), List.of(), 0, spawn, sound, BedrockParticleEffect.program(object, "expression", 0), log);
+    }
+
+    Set<String> effects() {
+        final Set<String> result = new LinkedHashSet<>();
+        for (final Node node : this.events.values()) node.effects(result);
+        return Set.copyOf(result);
+    }
+
+    void run(final List<String> names, final BedrockMolang environment, final RandomGenerator random,
+             final Vector3f position, final Vector3f velocity, final Consumer<Action> sink, final Consumer<String> log) {
+        this.run(names, environment, random,
+                BedrockParticleAttachment.Matrix.translation(new net.minecraft.world.phys.Vec3(position.x, position.y, position.z)),
+                velocity, sink, log, new int[] {MAX_NODES});
+    }
+
+    void run(final List<String> names, final BedrockMolang environment, final RandomGenerator random,
+             final BedrockParticleAttachment.Matrix transform, final Vector3f velocity, final Consumer<Action> sink,
+             final Consumer<String> log, final int[] remaining) {
+        for (final String name : names) {
+            final Node node = this.events.get(name);
+            if (node != null) node.run(environment, random, transform, velocity, sink, log, remaining);
+        }
+    }
+
+    enum Kind {
+        PARTICLE, PARTICLE_WITH_VELOCITY, EMITTER, EMITTER_BOUND;
+
+        boolean manual() { return this == PARTICLE || this == PARTICLE_WITH_VELOCITY; }
+    }
+    record Spawn(String effect, Kind kind, BedrockMolang.Program initialization) {}
+    sealed interface Action permits Request, Sound {
+        Vector3f position();
+    }
+    record Request(Spawn spawn, BedrockParticleAttachment.Matrix transform, Vector3f velocity) implements Action {
+        Request { velocity = new Vector3f(velocity); }
+        public Vector3f position() { return this.transform.position(new Vector3f()); }
+
+        BedrockParticleAttachment.Matrix emitterTransform(final BedrockParticleAttachment attachment, final net.minecraft.world.phys.Vec3 parentOrigin) {
+            if (this.spawn.kind.manual()) return BedrockParticleAttachment.Matrix.IDENTITY;
+            if (this.spawn.kind != Kind.EMITTER_BOUND || attachment == null) return this.transform;
+            return attachment.hasActor() ? BedrockParticleAttachment.Matrix.IDENTITY
+                    : BedrockParticleAttachment.Matrix.translation(parentOrigin);
+        }
+    }
+    record Sound(String event, Vector3f position) implements Action {
+        Sound { position = new Vector3f(position); }
+        public Vector3f position() { return new Vector3f(this.position); }
+    }
+    private record Weighted(float weight, Node node) {}
+    private record Node(List<Node> sequence, List<Weighted> randomize, float total,
+                        Spawn spawn, String sound, BedrockMolang.Program expression, String log) {
+        void effects(final Set<String> result) {
+            if (this.spawn != null) result.add(this.spawn.effect);
+            for (final Node node : this.sequence) node.effects(result);
+            for (final Weighted choice : this.randomize) choice.node.effects(result);
+        }
+
+        void run(final BedrockMolang environment, final RandomGenerator random, final BedrockParticleAttachment.Matrix transform,
+                 final Vector3f velocity, final Consumer<Action> sink, final Consumer<String> logger, final int[] remaining) {
+            if (remaining[0]-- <= 0) return;
+            Node selected = null;
+            if (!this.randomize.isEmpty()) {
+                float draw = this.total * random.nextFloat();
+                selected = this.randomize.getLast().node;
+                for (final Weighted candidate : this.randomize) {
+                    if (draw <= candidate.weight) { selected = candidate.node; break; }
+                    draw -= candidate.weight;
+                }
+            }
+            // The outer draw happens before sequence execution, then its selected branch runs.
+            for (final Node child : this.sequence) child.run(environment, random, transform, velocity, sink, logger, remaining);
+            if (selected != null) selected.run(environment, random, transform, velocity, sink, logger, remaining);
+            if (this.spawn != null) sink.accept(new Request(this.spawn, transform,
+                    this.spawn.kind == Kind.PARTICLE_WITH_VELOCITY ? velocity : new Vector3f()));
+            if (this.sound != null) sink.accept(new Sound(this.sound, transform.position(new Vector3f())));
+            environment.evaluate(this.expression, 0);
+            if (this.log != null && !this.log.isEmpty()) logger.accept(this.log);
+        }
+    }
+}
