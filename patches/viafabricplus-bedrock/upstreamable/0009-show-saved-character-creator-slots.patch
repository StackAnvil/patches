+        final var replaced = BedrockCharacterProfiles.capeChangeRequest(wardrobe, 2, category, second, false)
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance")
+            .getAsJsonObject("personaCollection").getAsJsonArray("universalApp");
+        assertEquals(3, replaced.size());
+        assertEquals("22222222-2222-4222-8222-222222222222", replaced.get(2).getAsJsonObject().get("id").getAsString());
+
+        final var removed = BedrockCharacterProfiles.capeChangeRequest(wardrobe, 2, category, first, true)
+            .getAsJsonArray("appearanceObjects").get(1).getAsJsonObject().getAsJsonObject("personaAppearance")
