+
+final class BedrockParticleCollisionEventsTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeContactThresholdsFramesAndDispatchOrder() throws Exception {
+        for (final var entry : fixture("native-particle-collision-events-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var config = row.getAsJsonObject("config");
+            final var expected = row.getAsJsonObject("values");
+            final List<BedrockParticleCollision.Trigger> triggers = new ArrayList<>();
+            for (int index = 0; index < config.getAsJsonArray("event_limits").size(); index++)
+                triggers.add(new BedrockParticleCollision.Trigger(Integer.toString(index + 1), config.getAsJsonArray("event_limits").get(index).getAsFloat()));
+            final var component = new BedrockParticleCollision(new BedrockMolang.Program(1, null), number(config, "drag", 0),
+                    number(config, "restitution", .5F), number(config, "radius", .1F), false, triggers);
+            final var position = vector(config, "current");
+            final var velocity = vector(config, "velocity");
+            final var sourceVelocity = config.has("source_velocity") ? vector(config, "source_velocity") : new Vector3f(velocity);
+            final var offset = config.has("origin") && !config.get("absolute").getAsBoolean() ? vector(config, "origin") : new Vector3f();
+            final List<BedrockParticleCollision.Contact> contacts = new ArrayList<>();
+            component.collide(vector(config, "previous"), position, velocity, 50_000_000, new BedrockMolang(),
+                    new Vec3(offset.x, offset.y, offset.z), (x, y, z) -> boxes(config, x, y, z),
+                    config.has("lifetime") ? config.get("lifetime").getAsLong() : 1_000_000_000,
+                    _ -> sourceVelocity, contacts::add);
+            final List<Integer> names = new ArrayList<>();
+            for (final var contact : contacts) {
+                final float[] actual = contact.transform().values();
+                for (final String name : contact.names()) {
+                    final var event = expected.getAsJsonArray("events").get(names.size()).getAsJsonObject();
+                    names.add(Integer.parseInt(name));
+                    assertEquals(event.get("id").getAsInt(), Integer.parseInt(name));
+                    for (int index = 0; index < 15; index++)
+                        assertEquals(event.getAsJsonArray("matrix").get(index).getAsFloat(), actual[index]);
+                    assertEquals(vector(event, "velocity"), contact.velocity());
+                }
+            }
+            assertEquals(expected.getAsJsonArray("events").size(), names.size());
+            assertEquals(vector(expected, "position"), position);
+            assertEquals(vector(expected, "velocity"), velocity);
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeActorAndUnboundEventCoordinates() throws Exception {
+        for (final var entry : fixture("native-particle-event-space-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var space = new BedrockParticleSpace(row.get("local_position").getAsBoolean(), row.get("local_rotation").getAsBoolean(), false);
+            final var point = space.event(row.get("actor").getAsBoolean() && row.get("valid").getAsBoolean(),
+                    vector(row, "particle_position"), vector(row, "particle_velocity"),
+                    vector(row, "emitter_position"), vector(row, "emitter_velocity"));
