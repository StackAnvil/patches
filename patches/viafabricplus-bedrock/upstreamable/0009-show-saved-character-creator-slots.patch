+        } else if (this.isSaved(item)) {
+            graphics.textWithWordWrap(this.font, Component.translatable(this.category == Category.EMOTES
+                    ? "bedrock_character_slots.viafabricplus.emote_available"
+                    : this.category == Category.CAPES ? "bedrock_character_slots.viafabricplus.cape_available"
