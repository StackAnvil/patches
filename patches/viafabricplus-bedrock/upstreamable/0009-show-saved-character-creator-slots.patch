+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.joml.Vector3f;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleCollisionTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeSweepsResponseDragAndWorldCollection() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-collision-result.json"))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (int index = 0; index < cases.size(); index++) {
+            final var row = cases.get(index).getAsJsonObject();
+            final var config = row.getAsJsonObject("config");
+            final var expected = row.getAsJsonObject("values");
+            final var declaration = new JsonObject();
+            if (config.has("enabled")) declaration.add("enabled", config.get("enabled"));
+            declaration.addProperty("collision_radius", number(config, "radius", .1F));
+            declaration.addProperty("collision_drag", number(config, "drag", 0));
+            declaration.addProperty("coefficient_of_restitution", number(config, "restitution", .5F));
+            final var component = BedrockParticleCollision.read(declaration);
+            final Vector3f position = vector(config, "current"), previous = vector(config, "previous"), velocity = vector(config, "velocity");
+            final var origin = config.has("origin") && !config.get("absolute").getAsBoolean() ? vector(config, "origin") : new Vector3f();
+            final List<List<Integer>> queried = new ArrayList<>();
+            final boolean hit = component.collide(previous, position, velocity,
+                    config.has("nanos") ? config.get("nanos").getAsLong() : 50_000_000, new BedrockMolang(), new Vec3(origin.x, origin.y, origin.z), (x, y, z) -> {
+                        queried.add(List.of(x, y, z));
+                        final List<BedrockParticleCollision.Box> result = new ArrayList<>();
+                        for (final var element : config.getAsJsonArray("boxes")) {
+                            final var box = element.getAsJsonArray();
+                            if ((int) Math.floor(box.get(0).getAsFloat()) == x && (int) Math.floor(box.get(1).getAsFloat()) == y
+                                    && (int) Math.floor(box.get(2).getAsFloat()) == z)
+                                result.add(new BedrockParticleCollision.Box(box.get(0).getAsFloat(), box.get(1).getAsFloat(),
+                                        box.get(2).getAsFloat(), box.get(3).getAsFloat(), box.get(4).getAsFloat(), box.get(5).getAsFloat()));
+                        }
+                        return result;
+                    });
+            for (int axis = 0; axis < 3; axis++) {
+                assertEquals(vector(expected, "position").get(axis), position.get(axis), "position case " + index + " axis " + axis);
+                assertEquals(vector(expected, "velocity").get(axis), velocity.get(axis), "velocity case " + index + " axis " + axis);
+            }
+            final var expectedQueries = expected.getAsJsonArray("queries");
+            assertEquals(expectedQueries.size(), queried.size(), "queries case " + index);
+            for (int query = 0; query < queried.size(); query++) for (int axis = 0; axis < 3; axis++)
+                assertEquals(expectedQueries.get(query).getAsJsonArray().get(axis).getAsInt(), queried.get(query).get(axis));
+            if (config.has("expire") && config.get("expire").getAsBoolean())
+                assertEquals(expected.get("lifetime").getAsLong() == 50_000_000, hit);
+        }
+        assertEquals(364, cases.size());
+    }
+
+    @Test
+    void appliesContactResponseAndExpirationDuringEmitterUpdates() throws Exception {
+        for (final boolean enabled : new boolean[]{false, true}) for (final boolean expire : new boolean[]{false, true}) {
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            components.add("minecraft:emitter_shape_point", JsonParser.parseString("{\"offset\":[0.5,0.5,0.5]}"));
+            components.add("minecraft:particle_initial_speed", JsonParser.parseString("[20,0,0]"));
+            components.add("minecraft:particle_motion_collision", JsonParser.parseString("""
+                    {"enabled":"v.contact", "collision_radius":0.1,"coefficient_of_restitution":0.5}
+                    """));
+            components.getAsJsonObject("minecraft:particle_motion_collision").addProperty("expire_on_contact", expire);
+            final var environment = new BedrockMolang();
+            environment.variable("contact", enabled ? 1 : 0);
+            final var origin = new Vec3(10, 0, 0);
+            final var emitter = BedrockParticleEffect.read(document).emitter(environment, new java.util.Random(1), origin);
+            final BedrockParticleCollision.Terrain terrain = (x, y, z) -> {
+                assertTrue(enabled);
+                return x == 11 && y == 0 && z == 0 ? List.of(new BedrockParticleCollision.Box(11, 0, 0, 12, 1, 1)) : List.of();
+            };
+            emitter.advance(0, 2, null, terrain);
+            emitter.advance(50_000_000, 0, null, terrain);
+            if (enabled && expire) {
+                assertEquals(0, emitter.size());
+            } else {
+                assertEquals(2, emitter.size());
+                final float first = emitter.visuals().getFirst().position().x - (float) origin.x;
+                if (enabled) assertTrue(first < .9F && first > .899F);
+                else assertEquals(1.5F, first);
+                emitter.advance(50_000_000, 0, null, terrain);
+                final float next = emitter.visuals().getFirst().position().x - (float) origin.x;
+                if (enabled) assertEquals(first - .5F, next);
+                else assertEquals(2.5F, next);
+            }
+        }
+    }
+
+    @Test
+    void boundsRadiusAndRejectsUnsupportedContactEvents() throws Exception {
+        final var value = new JsonObject();
+        assertEquals(0, BedrockParticleCollision.read(value).radius());
+        for (final float radius : new float[]{-1, 0, .2F, .5F, 1}) {
+            value.addProperty("collision_radius", radius);
+            assertEquals(Math.clamp(radius, 0, .5F), BedrockParticleCollision.read(value).radius());
+        }
+        value.add("events", JsonParser.parseString("[{\"event\":\"impact\"}]"));
+        assertThrows(java.io.IOException.class, () -> BedrockParticleCollision.read(value));
+        value.remove("events");
+        value.addProperty("expire_on_contact", 1);
+        assertThrows(java.io.IOException.class, () -> BedrockParticleCollision.read(value));
+    }
+
+    private static float number(final JsonObject value, final String name, final float fallback) {
+        return value.has(name) ? value.get(name).getAsFloat() : fallback;
+    }
+    private static Vector3f vector(final JsonObject value, final String name) {
+        final var array = value.getAsJsonArray(name);
+        return new Vector3f(array.get(0).getAsFloat(), array.get(1).getAsFloat(), array.get(2).getAsFloat());
+    }
+}
