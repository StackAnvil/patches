+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+/** Reads the five Character Creator recipes saved to a Bedrock account. */
+public final class BedrockCharacterProfiles {
+
+    private static final URI PROFILES = URI.create("https://persona-secondary.franchise.minecraft-services.net/api/v1.0/appearance/retrieve"
+        + "?profilenames=personaProfile1&profilenames=personaProfile2&profilenames=personaProfile3"
+        + "&profilenames=personaProfile4&profilenames=personaProfile5&profilenames=personaProfile");
+    private static final URI APPEARANCE = URI.create("https://persona-secondary.franchise.minecraft-services.net/api/v1.0/appearance");
+    private static final URI STORE = URI.create("https://store.mktpl.minecraft-services.net/api/v2.0/layout/pages/");
+    private static final URI AVATAR = URI.create("https://persona-secondary.franchise.minecraft-services.net/api/v1.0/profile/image/avatar");
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();
+
+    private BedrockCharacterProfiles() {
+    }
+
+    public static CompletableFuture<AccountWardrobe> load(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                return loadNow(account);
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock character profiles", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<AccountWardrobe> selectSlot(final BedrockAuthManager account, final int slotNumber) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final AccountWardrobe current = loadNow(account);
+                final JsonObject requestBody = selectionRequest(current, slotNumber);
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(APPEARANCE)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("session-id", UUID.randomUUID().toString())
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .PUT(HttpRequest.BodyPublishers.ofString(requestBody.toString())).build();
+                final JsonObject response = send(request);
+                final JsonObject hashes = object(object(response, "result"), "profileHashes");
+                if (!hashes.has("PlayerProfileHash_personaProfile")
+                    || !hashes.has("PlayerProfileHash_personaProfile" + slotNumber)) {
+                    throw new IOException("Bedrock did not confirm the selected character slot");
+                }
+                final ParsedProfiles refreshed = parseProfiles(readProfiles(account));
+                if (refreshed.activeSlot() != slotNumber) {
+                    throw new IOException("Bedrock did not save the selected character slot");
+                }
+                return new AccountWardrobe(refreshed.slots(), refreshed.activeSlot(),
+                    refreshed.profileVersion(), refreshed.settings());
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not select a Bedrock character slot", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<AccountWardrobe> changeSavedPiece(final BedrockAuthManager account, final int slotNumber,
+                                                                       final String expectedProfileHash,
+                                                                       final List<WardrobeItem> categoryItems,
+                                                                       final WardrobeItem selectedItem, final boolean remove) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                if (slotNumber < 1 || slotNumber > 5) {
+                    throw new IOException("Character slot is out of range");
+                }
+                final AccountWardrobe current = loadNow(account);
+                if (!current.slots().get(slotNumber - 1).profileHash().equals(expectedProfileHash)) {
+                    throw new IOException("This character changed on your account. Refresh before editing it");
+                }
+                final JsonObject requestBody = pieceChangeRequest(current, slotNumber, categoryItems, selectedItem, remove);
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(APPEARANCE)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("session-id", UUID.randomUUID().toString())
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .PUT(HttpRequest.BodyPublishers.ofString(requestBody.toString())).build();
+                final JsonObject hashes = object(object(send(request), "result"), "profileHashes");
+                if (!hashes.has("PlayerProfileHash_personaProfile")
+                    || !hashes.has("PlayerProfileHash_personaProfile" + slotNumber)) {
+                    throw new IOException("Bedrock did not confirm the character edit");
+                }
+                final AccountWardrobe refreshed = parse(readProfiles(account));
+                final JsonObject expected = requestBody.getAsJsonArray("appearanceObjects").get(1)
+                    .getAsJsonObject().getAsJsonObject("personaAppearance").getAsJsonObject("personaCollection");
+                if (!expected.equals(refreshed.slots().get(slotNumber - 1).profile().getAsJsonObject("personaCollection"))) {
+                    throw new IOException("Bedrock did not save the character edit");
+                }
+                return refreshed;
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not edit the Bedrock character", e);
+            }
+        });
+    }
+
+    private static AccountWardrobe loadNow(final BedrockAuthManager account) throws IOException, InterruptedException {
+        return parse(readProfiles(account));
+    }
+
+    static AccountWardrobe parse(final JsonObject profiles) throws IOException {
+        final ParsedProfiles parsed = parseProfiles(profiles);
+        return new AccountWardrobe(parsed.slots(), parsed.activeSlot(), parsed.profileVersion(), parsed.settings());
+    }
+
+    private static JsonObject readProfiles(final BedrockAuthManager account) throws IOException, InterruptedException {
+        final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+        final HttpRequest profilesRequest = HttpRequest.newBuilder(PROFILES)
+            .timeout(Duration.ofSeconds(15))
+            .header("Authorization", authorization)
+            .header("session-id", UUID.randomUUID().toString())
+            .header("Accept", "application/json")
+            .GET().build();
+        return send(profilesRequest);
+    }
+
+    static JsonObject selectionRequest(final AccountWardrobe wardrobe, final int slotNumber) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()) {
+            throw new IOException("Character slot is out of range");
+        }
+        final Slot slot = wardrobe.slots().get(slotNumber - 1);
+        if (!slot.occupied()) {
+            throw new IOException("Character slot has no saved recipe");
+        }
+        final JsonObject settings = wardrobe.settingsProfile().deepCopy();
+        final JsonArray settingsEntries = array(object(settings, "personaCollection"), "universalApp");
+        if (settingsEntries.isEmpty() || !settingsEntries.get(0).isJsonObject()) {
+            throw new IOException("Bedrock account settings have no active slot");
+        }
+        settingsEntries.get(0).getAsJsonObject().addProperty("lastUsedPersonaSlot", "persona_profile_persona" + slotNumber);
+        final JsonArray objects = new JsonArray();
+        objects.add(appearanceObject("personaProfile", settings));
+        objects.add(appearanceObject("personaProfile" + slotNumber, slot.profile()));
+        final JsonObject request = new JsonObject();
+        request.add("appearanceObjects", objects);
+        return request;
+    }
+
+    static JsonObject pieceChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                         final List<WardrobeItem> categoryItems, final WardrobeItem selectedItem,
+                                         final boolean remove) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || !categoryItems.contains(selectedItem)) {
+            throw new IOException("Invalid character piece selection");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        final JsonObject edited = target.profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        final int existing = matchingPieceIndex(entries, categoryItems);
+        if (existing < 0) {
+            throw new IOException("This character has no piece in that category to replace");
+        }
+        final String existingId = string(entries.get(existing).getAsJsonObject(), "id");
+        if (remove) {
+            if (!belongsToPack(existingId, selectedItem.packId())) {
+                throw new IOException("This piece is not equipped in the selected character");
+            }
+            entries.remove(existing);
+        } else {
+            if (belongsToPack(existingId, selectedItem.packId())) {
+                throw new IOException("This piece is already equipped");
+            }
+            JsonObject source = null;
+            for (final Slot slot : wardrobe.slots()) {
+                for (final JsonElement entry : array(object(slot.profile(), "personaCollection"), "universalApp")) {
+                    if (entry.isJsonObject() && belongsToPack(string(entry.getAsJsonObject(), "id"), selectedItem.packId())) {
+                        source = entry.getAsJsonObject();
+                        break;
+                    }
+                }
+                if (source != null) {
+                    break;
+                }
+            }
+            if (source == null) {
+                throw new IOException("This piece is not in a saved character");
+            }
+            entries.set(existing, source.deepCopy());
+        }
+        final JsonArray objects = new JsonArray();
+        objects.add(appearanceObject("personaProfile", wardrobe.settingsProfile()));
+        objects.add(appearanceObject("personaProfile" + slotNumber, edited));
+        final JsonObject request = new JsonObject();
+        request.add("appearanceObjects", objects);
+        return request;
+    }
+
+    private static int matchingPieceIndex(final JsonArray entries, final List<WardrobeItem> categoryItems) {
+        for (int index = 0; index < entries.size(); index++) {
+            if (!entries.get(index).isJsonObject()) {
+                continue;
+            }
+            final String id = string(entries.get(index).getAsJsonObject(), "id");
+            if (categoryItems.stream().anyMatch(item -> belongsToPack(id, item.packId()))) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    private static boolean belongsToPack(final String id, final String packId) {
+        return !packId.isBlank() && (id.equalsIgnoreCase(packId)
+            || id.regionMatches(true, 0, packId + "/", 0, packId.length() + 1));
+    }
+
+    private static JsonObject appearanceObject(final String name, final JsonObject profile) throws IOException {
+        if (!profile.has("version") || !profile.has("personaCollection")) {
+            throw new IOException("Bedrock character profile is incomplete");
+        }
+        final JsonObject appearance = new JsonObject();
+        appearance.add("version", profile.get("version").deepCopy());
+        appearance.add("personaCollection", profile.get("personaCollection").deepCopy());
+        final JsonObject object = new JsonObject();
+        object.addProperty("profileName", name);
+        object.add("personaAppearance", appearance);
+        return object;
+    }
+
+    public static CompletableFuture<List<WardrobeItem>> loadItems(final BedrockAuthManager account, final Category category) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(STORE.resolve(category.page()))
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString("{\"entitlements\":[],\"inventoryVersion\":\"\",\"listVersion\":\"\"}"))
+                    .build();
+                return catalogItems(send(request));
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock wardrobe items", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<String> loadActiveAvatar(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest request = HttpRequest.newBuilder(AVATAR)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("Accept", "image/png")
+                    .GET().build();
+                final HttpResponse<byte[]> response = HTTP.send(request, HttpResponse.BodyHandlers.ofByteArray());
+                final byte[] image = response.body();
+                if (response.statusCode() / 100 != 2 || image.length < 8 || image.length > 2 * 1024 * 1024
+                    || image[0] != (byte) 0x89 || image[1] != 'P' || image[2] != 'N' || image[3] != 'G') {
+                    throw new IOException("Bedrock did not return a valid character preview");
+                }
+                return Base64.getEncoder().encodeToString(image);
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock character preview", e);
+            }
+        });
+    }
+
+    private static ParsedProfiles parseProfiles(final JsonObject profiles) throws IOException {
+        if (!profiles.has("result") || !profiles.get("result").isJsonArray()) {
+            throw new IOException("Bedrock character profiles response has no slots");
+        }
+        final JsonArray result = array(profiles, "result");
+        JsonObject settings = null;
+        for (final JsonElement element : result) {
+            if (element.isJsonObject() && "personaProfile".equals(string(element.getAsJsonObject(), "slotname"))) {
+                settings = element.getAsJsonObject().deepCopy();
+                break;
+            }
+        }
+        if (settings == null) {
+            throw new IOException("Bedrock account settings profile is missing");
+        }
+        final JsonArray settingsEntries = array(object(settings, "personaCollection"), "universalApp");
+        final String activeName = settingsEntries.isEmpty() || !settingsEntries.get(0).isJsonObject() ? ""
+            : string(settingsEntries.get(0).getAsJsonObject(), "lastUsedPersonaSlot");
+        int activeSlot = 0;
+        for (int index = 1; index <= 5; index++) {
+            if (("persona_profile_persona" + index).equals(activeName)) {
+                activeSlot = index;
+                break;
+            }
+        }
+        final List<Slot> slots = new ArrayList<>(5);
+        for (int index = 0; index < 5; index++) {
+            final String expectedName = "personaProfile" + (index + 1);
+            JsonObject slot = null;
+            for (final JsonElement element : result) {
+                if (element.isJsonObject() && expectedName.equals(string(element.getAsJsonObject(), "slotname"))) {
+                    slot = element.getAsJsonObject();
+                    break;
+                }
+            }
+            if (slot == null) {
+                throw new IOException("Bedrock character slot " + (index + 1) + " is missing");
+            }
+            final JsonObject collection = object(slot, "personaCollection");
+            final JsonArray pieces = array(collection, "universalApp");
+            String arm = "";
+            String skinColor = "";
+            final List<String> pieceIds = new ArrayList<>();
+            for (final JsonElement element : pieces) {
+                if (!element.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject piece = element.getAsJsonObject();
+                if (piece.has("skin")) {
+                    arm = string(piece, "arm");
+                    skinColor = string(piece, "skcol");
+                } else if (piece.has("id")) {
+                    pieceIds.add(string(piece, "id"));
+                }
+            }
+            slots.add(new Slot(index + 1, arm, skinColor, List.copyOf(pieceIds), string(slot, "profileHash"), slot.deepCopy()));
+        }
+        return new ParsedProfiles(List.copyOf(slots), activeSlot,
+            profiles.has("profileVersion") ? profiles.get("profileVersion").getAsInt() : 0, settings);
+    }
+
+    static List<WardrobeItem> catalogItems(final JsonObject response) {
+        final Map<String, WardrobeItem> items = new LinkedHashMap<>();
+        for (final JsonElement section : array(object(response, "result"), "layout")) {
+            if (!section.isJsonObject()) {
+                continue;
+            }
+            for (final JsonElement row : array(section.getAsJsonObject(), "rows")) {
+                if (!row.isJsonObject()) {
+                    continue;
+                }
+                for (final JsonElement component : array(row.getAsJsonObject(), "components")) {
+                    if (!component.isJsonObject()) {
+                        continue;
+                    }
+                    for (final JsonElement entry : array(component.getAsJsonObject(), "items")) {
+                        if (!entry.isJsonObject()) {
+                            continue;
+                        }
+                        final WardrobeItem item = catalogItem(entry.getAsJsonObject());
+                        if (item != null) {
+                            items.putIfAbsent(item.id(), item);
+                        }
+                    }
+                }
+            }
+        }
+        return List.copyOf(items.values());
+    }
+
+    static WardrobeItem catalogItem(final JsonObject item) {
+        if (!"PersonaDurable".equals(string(item, "contentType")) || string(item, "title").isBlank()) {
+            return null;
+        }
+        final JsonObject price = object(item, "price");
+        final boolean free = price.has("listPrice") && price.get("listPrice").isJsonPrimitive()
+            && price.get("listPrice").getAsInt() == 0;
+        final boolean owned = "Owned".equalsIgnoreCase(string(item, "ownership"))
+            || "Purchased".equalsIgnoreCase(string(item, "ownership"));
+        if (!free && !owned) {
+            return null;
+        }
+        String packId = "";
+        for (final JsonElement identity : array(item, "packIdentity")) {
+            if (identity.isJsonObject() && "persona_piece".equals(string(identity.getAsJsonObject(), "type"))) {
+                packId = string(identity.getAsJsonObject(), "uuid");
+                break;
+            }
+        }
+        if (packId.isBlank()) {
+            return null;
+        }
+        return new WardrobeItem(string(item, "id"), string(item, "title"), string(item, "pieceType"),
+            string(object(item, "thumbnail"), "url"), packId);
+    }
+
+    private static JsonObject send(final HttpRequest request) throws IOException, InterruptedException {
+        final HttpResponse<String> response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() / 100 != 2) {
+            throw new IOException("Bedrock wardrobe request failed: HTTP " + response.statusCode());
+        }
+        try {
+            return JsonParser.parseString(response.body()).getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("Bedrock wardrobe returned invalid JSON", e);
+        }
+    }
+
+    private static JsonObject object(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonObject() ? parent.getAsJsonObject(key) : new JsonObject();
+    }
+
+    private static JsonArray array(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonArray() ? parent.getAsJsonArray(key) : new JsonArray();
+    }
+
+    private static String string(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonPrimitive() ? parent.get(key).getAsString() : "";
+    }
+
+    public record AccountWardrobe(List<Slot> slots, int activeSlot,
+                                  int profileVersion, JsonObject settingsProfile) {
+    }
+
+    private record ParsedProfiles(List<Slot> slots, int activeSlot, int profileVersion, JsonObject settings) {
+    }
+
+    public record Slot(int number, String arm, String skinColor, List<String> pieceIds, String profileHash, JsonObject profile) {
+        public boolean occupied() {
+            return !this.pieceIds.isEmpty();
+        }
+    }
+
+    public enum Category {
+        BASES("DressingRoom_Bases", "Bases"),
+        HAIRS("DressingRoom_Hairs", "Hairs"),
+        EYES("DressingRoom_Eyes", "Eyes"),
+        MOUTHS("DressingRoom_Mouths", "Mouths"),
+        FACIAL_HAIRS("DressingRoom_FacialHairs", "Facial hair"),
+        ARMS("DressingRoom_Arms", "Arms"),
+        LEGS("DressingRoom_Legs", "Legs"),
+        TOPS("DressingRoom_Tops", "Tops"),
+        BOTTOMS("DressingRoom_Bottoms", "Bottoms"),
+        OUTERWEAR("DressingRoom_Outerwears", "Outerwear"),
+        HEADWEAR("DressingRoom_Headwears", "Headwear"),
+        GLOVES("DressingRoom_Gloves", "Gloves"),
+        FOOTWEAR("DressingRoom_Footwears", "Footwear"),
+        FACE_ITEMS("DressingRoom_FaceItems", "Face items"),
+        BACK_ITEMS("DressingRoom_BackItems", "Back items");
+
+        private final String page;
+        private final String label;
+
+        Category(final String page, final String label) {
+            this.page = page;
+            this.label = label;
+        }
+
+        public String page() {
+            return this.page;
+        }
+
+        public String label() {
+            return this.label;
+        }
+    }
+
+    public record WardrobeItem(String id, String name, String type, String thumbnailUrl, String packId) {
+    }
+
+}
