+
+    @Test
+    void sortsTimelineScriptsStablyAndRunsThemAfterBonesInTheCurrentFrameContext()
+            throws Exception {
+        final var molang = new BedrockMolang();
+        final var definition =
+                animation(
+                        """
+                        {"timeline":{"0.75":"v.order=v.order*10+4;",
+                           "0":["v.order=1;return 0;","v.order=v.order*10+2;"],
+                           "0.0":"v.order=v.order*10+3;",
+                           "2":"v.event_time=q.anim_time;v.event_delta=q.delta_time;"},
+                         "bones":{"head":{"position":["v.order??0","v.event_time??0","v.event_delta??0"]}}}
+                        """);
+        assertEquals(2, definition.length());
+        final var player = definition.playback(molang);
+        assertEquals(
+                new BedrockBoneAnimation.Vector(0, 0, 0),
+                player.sample(0, Map.of()).get("head").position());
