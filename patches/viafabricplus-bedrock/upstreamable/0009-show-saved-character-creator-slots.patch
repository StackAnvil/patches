+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+
+import java.io.IOException;
+import java.nio.BufferUnderflowException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Reads text and compiled particle definitions without a native game or external decoder. */
+final class BedrockParticleDefinition {
+    private static final int MAGIC = 0x42434D7F;
+    private static final int MAX_BYTES = 8 * 1024 * 1024;
+    private static final int MAX_ITEMS = 65536;
+    private static final int MAX_DEPTH = 96;
+
+    interface Layout {
+        JsonElement read(Reader reader) throws IOException;
+    }
+
+    static final Layout TEXT = reader -> new JsonPrimitive(reader.text());
+    static final Layout BOOL = reader -> new JsonPrimitive(reader.bool());
+    static final Layout INT = reader -> new JsonPrimitive(reader.data.getInt());
+    static final Layout SHORT = reader -> new JsonPrimitive(reader.data.getShort());
+    static final Layout FLOAT =
+            reader -> {
+                final float value = reader.data.getFloat();
+                if (!Float.isFinite(value)) throw new IOException("Non-finite particle value");
+                return new JsonPrimitive(value);
+            };
+    private static final Map<String, Layout> LAYOUTS = BedrockParticleLayouts.definitions();
+
+    private BedrockParticleDefinition() {}
+
+    static JsonObject read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length == 0 || bytes.length > MAX_BYTES)
+            throw new IOException("Missing or oversized particle definition");
+        try {
+            if (bytes.length < 4
+                    || ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).getInt() != MAGIC) {
+                final String text =
+                        StandardCharsets.UTF_8
+                                .newDecoder()
+                                .decode(ByteBuffer.wrap(bytes))
+                                .toString();
+                final JsonObject document = JsonParser.parseString(text).getAsJsonObject();
+                if (!document.has("particle_effect")
+                        || !document.get("particle_effect").isJsonObject())
+                    throw new IOException("Missing particle effect definition");
+                return document;
+            }
+            final Reader reader = new Reader(bytes);
+            reader.data.getInt();
+            final int major = Short.toUnsignedInt(reader.data.getShort());
+            final int minor = Short.toUnsignedInt(reader.data.getShort());
+            final int patch = Short.toUnsignedInt(reader.data.getShort());
+            final String prerelease = reader.text(), build = reader.text();
+            if (major != 1
+                    || minor != 26
+                    || (patch != 10 && patch != 30)
+                    || !prerelease.isEmpty()
+                    || !build.isEmpty())
+                throw new IOException("Unsupported compiled particle format version");
+            if (!reader.text().equals("particle_effect"))
+                throw new IOException("Unexpected compiled particle root");
+            final JsonObject document = new JsonObject();
+            document.addProperty("format_version", major + "." + minor + "." + patch);
+            document.add("particle_effect", reader.read(ref("Particle Effect Data")));
+            if (reader.data.hasRemaining())
+                throw new IOException("Trailing compiled particle data");
+            return document;
+        } catch (BufferUnderflowException
+                | CharacterCodingException
+                | IllegalStateException
+                | com.google.gson.JsonParseException invalid) {
+            throw new IOException("Invalid particle definition", invalid);
+        }
+    }
+
+    static Layout ref(final String name) {
+        return reader -> {
+            final Layout layout = LAYOUTS.get(name);
+            if (layout == null) throw new IOException("Unknown particle layout: " + name);
+            return reader.read(layout);
+        };
+    }
+
+    static Layout text(final String... allowed) {
+        final Set<String> values = Set.of(allowed);
+        return reader -> {
+            final String value = reader.text();
+            if (!values.contains(value)) throw new IOException("Unknown particle enum value");
+            return new JsonPrimitive(value);
+        };
+    }
+
+    record Field(String name, Layout layout, boolean optional) {}
+
+    static Field field(final String name, final Layout layout) {
+        return new Field(name, layout, false);
+    }
+
+    static Field optional(final String name, final Layout layout) {
+        return new Field(name, layout, true);
+    }
+
+    static Layout object(final Field... fields) {
+        final List<Field> ordered = List.of(fields);
+        return reader -> {
+            final JsonObject result = new JsonObject();
+            for (final Field field : ordered) {
+                if (field.optional && !reader.bool()) continue;
+                result.add(field.name, reader.read(field.layout));
+            }
+            return result;
+        };
+    }
+
+    static Layout components(final Field... fields) {
+        final Map<Integer, Field> hashes = new LinkedHashMap<>();
+        for (final Field field : fields) {
+            if (hashes.putIfAbsent(hash(field.name), field) != null)
+                throw new IllegalArgumentException("Colliding particle component layouts");
+        }
+        final Map<Integer, Field> definitions = Map.copyOf(hashes);
+        return reader -> {
+            final int count = reader.count(Integer.toUnsignedLong(reader.data.getInt()));
+            final JsonObject result = new JsonObject();
+            for (int i = 0; i < count; i++) {
+                final Field field = definitions.get(reader.data.getInt());
+                if (field == null) throw new IOException("Unknown compiled particle component");
+                if (result.has(field.name)) throw new IOException("Duplicate particle component");
+                result.add(field.name, reader.read(field.layout));
+            }
+            return result;
+        };
+    }
+
+    static Layout array(final Layout item, final int fixedLength) {
+        return reader -> {
+            final int count = fixedLength < 0 ? reader.count(reader.varint()) : fixedLength;
+            final JsonArray result = new JsonArray();
+            for (int i = 0; i < count; i++) result.add(reader.read(item));
+            return result;
+        };
+    }
+
+    static Layout tuple(final Layout... items) {
+        final List<Layout> ordered = List.of(items);
+        return reader -> {
+            final JsonArray result = new JsonArray();
+            for (final Layout item : ordered) result.add(reader.read(item));
+            return result;
+        };
+    }
+
+    static Layout map(final Layout value) {
+        return reader -> {
+            final int count = reader.count(reader.varint());
+            final JsonObject result = new JsonObject();
+            for (int i = 0; i < count; i++) {
+                final String key = reader.text();
+                if (result.has(key)) throw new IOException("Duplicate particle map key");
+                result.add(key, reader.read(value));
+            }
+            return result;
+        };
+    }
+
+    record Choice(int tag, Layout layout) {}
+
+    static Choice choice(final int tag, final Layout layout) {
+        return new Choice(tag, layout);
+    }
+
+    static Layout variant(final Choice... choices) {
+        final Map<Integer, Layout> definitions = new LinkedHashMap<>();
+        for (final Choice choice : choices) definitions.put(choice.tag, choice.layout);
+        return reader -> {
+            final Layout selected = definitions.get(Byte.toUnsignedInt(reader.data.get()));
+            if (selected == null) throw new IOException("Unknown particle variant tag");
+            return reader.read(selected);
+        };
+    }
+
+    static int hash(final String name) {
+        int hash = 0x811C9DC5;
+        for (final byte value : name.getBytes(StandardCharsets.UTF_8))
+            hash = (hash ^ Byte.toUnsignedInt(value)) * 0x01000193;
+        return hash;
+    }
+
+    private static final class Reader {
+        private final ByteBuffer data;
+        private int depth, nodes;
+
+        private Reader(final byte[] bytes) {
+            this.data = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        }
+
+        private JsonElement read(final Layout layout) throws IOException {
+            if (++this.nodes > MAX_ITEMS || ++this.depth > MAX_DEPTH)
+                throw new IOException("Compiled particle complexity exceeds the limit");
+            try {
+                return layout.read(this);
+            } finally {
+                this.depth--;
+            }
+        }
+
+        private int count(final long value) throws IOException {
+            if (value > MAX_ITEMS) throw new IOException("Particle collection exceeds the limit");
+            return (int) value;
+        }
+
+        private boolean bool() throws IOException {
+            final int value = Byte.toUnsignedInt(this.data.get());
+            if (value > 1) throw new IOException("Invalid particle boolean");
+            return value == 1;
+        }
+
+        private long varint() throws IOException {
+            long value = 0;
+            for (int index = 0; index < 5; index++) {
+                final int next = Byte.toUnsignedInt(this.data.get());
+                if (index == 4 && (next & 0xF0) != 0)
+                    throw new IOException("Particle length overflows uint32");
+                value |= (long) (next & 0x7F) << (index * 7);
+                if ((next & 0x80) == 0) return value;
+            }
+            throw new IOException("Invalid particle length");
+        }
+
+        private String text() throws IOException {
+            final long length = this.varint();
+            if (length > 1024 * 1024 || length > this.data.remaining())
+                throw new IOException("Invalid particle string length");
+            final byte[] bytes = new byte[(int) length];
+            this.data.get(bytes);
+            return StandardCharsets.UTF_8.newDecoder().decode(ByteBuffer.wrap(bytes)).toString();
+        }
+    }
+}
