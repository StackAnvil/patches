+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_ACTIONS", matches = ".+")
+    void matchesNativeSpecializedUseStatesWithIndependentCarriedAndActiveStacks() throws Exception {
+        final Path fixture =
+                Path.of(
+                        System.getenv("STACKANVIL_ITEM_ACTIONS"),
+                        "native-specialized-actions.json");
+        for (final var raw : JsonParser.parseString(Files.readString(fixture)).getAsJsonArray()) {
