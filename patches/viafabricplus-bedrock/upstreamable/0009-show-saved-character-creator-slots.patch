+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Consumer;
+
+/** A resource-defined actor graph with shared variables and independent playback clocks. */
+public final class BedrockActorAnimation {
+    @FunctionalInterface
+    public interface Query {
+        Object evaluate(List<Object> arguments);
+    }
+
+    public record Frame(Map<String, Object> queries, Map<String, Float> variables, Map<String, Object> context) {
+        public Frame(final Map<String, Object> queries, final Map<String, Float> variables) {
+            this(queries, variables, Map.of());
+        }
+        public Frame {
+            queries = Map.copyOf(queries);
+            variables = Map.copyOf(variables);
+            context = Map.copyOf(context);
+        }
+    }
+
+    private final Map<String, String> aliases;
+    private final Map<String, String> soundAliases;
+    private final Map<String, String> particleAliases;
+    private final BedrockResourceLibrary resources;
+    private final Map<String, BedrockBoneAnimation> animations;
+    private final Map<String, Controller> controllers;
+    private final List<BedrockMolang.Program> initialize, preAnimation;
+    private final List<Reference> roots;
+    private final BedrockActorVisibility visibility;
+    private final BedrockActorScale scale;
+
+    private BedrockActorAnimation(
+            final JsonObject entity, final Map<String, String> overrides,
+            final Map<String, JsonObject> animationDefinitions,
+            final Map<String, ControllerResource> controllerDefinitions,
+            final BedrockResourceLibrary resources) throws IOException {
+        this.resources = resources;
+        final Map<String, JsonObject> renderControllers = new LinkedHashMap<>();
+        if (resources != null)
+            resources.definitions("render_controllers", "render_controllers")
+                    .forEach((name, definition) -> renderControllers.put(name, definition.value()));
+        this.visibility = BedrockActorVisibility.read(entity, renderControllers);
+        final Map<String, String> soundAliases = new LinkedHashMap<>();
+        final JsonObject sounds = entity.getAsJsonObject("sound_effects");
+        if (sounds != null) {
+            if (sounds.size() > 4096) throw new IOException("Too many actor sound aliases");
+            for (final var entry : sounds.entrySet()) {
+                final String name = entry.getValue().getAsString();
+                if (entry.getKey().length() > 512 || name.length() > 512)
+                    throw new IOException("Invalid actor sound alias");
+                soundAliases.put(entry.getKey(), name);
+            }
+        }
+        this.soundAliases = Map.copyOf(soundAliases);
+        final Map<String, String> particleAliases = new LinkedHashMap<>();
+        final JsonObject particles = entity.getAsJsonObject("particle_effects");
+        if (particles != null) {
+            if (particles.size() > 4096) throw new IOException("Too many actor particle aliases");
+            for (final var entry : particles.entrySet()) {
+                final String name = entry.getValue().getAsString();
+                if (entry.getKey().length() > 512 || name.length() > 512)
+                    throw new IOException("Invalid actor particle alias");
+                particleAliases.put(entry.getKey(), name);
+            }
+        }
+        this.particleAliases = Map.copyOf(particleAliases);
+        final Map<String, String> aliases = new LinkedHashMap<>();
+        final JsonObject declaredAnimations = entity.getAsJsonObject("animations");
+        if (declaredAnimations != null) {
+            declaredAnimations.entrySet()
+                    .forEach(entry -> aliases.put(entry.getKey(), entry.getValue().getAsString()));
+        }
+        aliases.putAll(overrides);
+        this.aliases = Map.copyOf(aliases);
+        final JsonObject scripts = entity.getAsJsonObject("scripts");
+        this.scale = BedrockActorScale.read(scripts);
+        this.initialize = programs(scripts == null ? null : scripts.get("initialize"));
+        this.preAnimation = programs(scripts == null ? null : scripts.get("pre_animation"));
+        this.roots = references(scripts == null ? null : scripts.get("animate"));
+        this.animations = new LinkedHashMap<>();
+        this.controllers = new LinkedHashMap<>();
+        for (final Reference root : this.roots)
+            this.resolve(
+                    root.name, animationDefinitions, controllerDefinitions, new HashSet<>(), 0);
+    }
+
+    static BedrockActorAnimation read(
+            final BedrockResourceLibrary library, final BedrockClassicOptions options)
+            throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>();
+        library.definitions("animations", "animations")
+                .forEach((name, resource) -> animations.put(name, resource.value()));
+        for (final var entry :
+                library.definitions("animation_controllers", "animation_controllers").entrySet()) {
+            final var resource = entry.getValue();
+            controllers.put(
+                    entry.getKey(),
+                    new ControllerResource(
+                            resource.value(), deferredEntry(resource.formatVersion())));
+        }
+        try {
+            return new BedrockActorAnimation(
+                    library.entity("minecraft:player").getAsJsonObject("description"),
+                    options.animations(),
+                    animations,
+                    controllers,
+                    library);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid actor animation library", invalid);
+        }
+    }
+
+    static BedrockActorAnimation read(
+            final JsonObject entity,
+            final Map<String, String> overrides,
+            final JsonObject animations,
+            final JsonObject controllers,
+            final String controllerFormat)
+            throws IOException {
+        final Map<String, JsonObject> animationDefinitions = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllerDefinitions = new LinkedHashMap<>();
+        final boolean deferred = deferredEntry(controllerFormat);
+        animations
+                .entrySet()
+                .forEach(
+                        entry ->
+                                animationDefinitions.put(
+                                        entry.getKey(), entry.getValue().getAsJsonObject()));
+        controllers
+                .entrySet()
+                .forEach(
+                        entry ->
+                                controllerDefinitions.put(
+                                        entry.getKey(),
+                                        new ControllerResource(
+                                                entry.getValue().getAsJsonObject(), deferred)));
+        return new BedrockActorAnimation(
+                entity, overrides, animationDefinitions, controllerDefinitions, null);
+    }
+
+    private void resolve(
+            final String alias,
+            final Map<String, JsonObject> animations,
+            final Map<String, ControllerResource> controllers,
+            final Set<String> chain,
+            final int depth)
+            throws IOException {
+        final String name = this.aliases.get(alias);
+        // Matching vanilla controllers retain references to aliases removed by newer entities.
+        if (name == null || name.isEmpty()) return;
+        if (depth > 32 || !chain.add(name))
+            throw new IOException("Cyclic actor animation controller");
+        if (name.startsWith("controller.animation.")) {
+            if (!this.controllers.containsKey(name)) {
+                final ControllerResource resource = controllers.get(name);
+                if (resource != null) {
+                    final Controller controller =
+                            Controller.read(resource.definition, resource.deferredEntry);
+                    for (final State state : controller.states.values())
+                        for (final Reference reference : state.animations)
+                            this.resolve(reference.name, animations, controllers, chain, depth + 1);
+                    this.controllers.put(name, controller);
+                }
+            }
+        } else if (!this.animations.containsKey(name)) {
+            final JsonObject definition = animations.get(name);
+            if (definition != null)
+                this.animations.put(name, BedrockBoneAnimation.parse(definition));
+        }
+        chain.remove(name);
+    }
