+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMolangParser.java
@@ -0,0 +1,193 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import team.unnamed.mocha.lexer.MolangLexer;
+import team.unnamed.mocha.lexer.TokenKind;
+import team.unnamed.mocha.parser.ParseException;
+import team.unnamed.mocha.parser.ast.AccessExpression;
+import team.unnamed.mocha.parser.ast.ArrayAccessExpression;
+import team.unnamed.mocha.parser.ast.BinaryExpression;
+import team.unnamed.mocha.parser.ast.CallExpression;
+import team.unnamed.mocha.parser.ast.DoubleExpression;
+import team.unnamed.mocha.parser.ast.ExecutionScopeExpression;
+import team.unnamed.mocha.parser.ast.Expression;
+import team.unnamed.mocha.parser.ast.IdentifierExpression;
+import team.unnamed.mocha.parser.ast.StatementExpression;
+import team.unnamed.mocha.parser.ast.StringExpression;
+import team.unnamed.mocha.parser.ast.TernaryConditionalExpression;
+import team.unnamed.mocha.parser.ast.UnaryExpression;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Builds Mocha expressions with assignment precedence and modern nested Molang conditionals. */
+final class BedrockMolangParser {
+    private static final int ASSIGNMENT = 1, CONDITIONAL = 2, COALESCE = 3, UNARY = 1100;
+    private final MolangLexer lexer;
+    private int depth;
+
+    private BedrockMolangParser(final MolangLexer lexer) {
+        this.lexer = lexer;
+    }
+
+    static List<Expression> parse(final String source) throws IOException {
+        try (final MolangLexer lexer = MolangLexer.lexer(source)) {
+            lexer.next();
+            return new BedrockMolangParser(lexer).statements(TokenKind.EOF);
+        }
+    }
+
+    private TokenKind kind() {
+        return this.lexer.current().kind();
+    }
+
+    private void expect(final TokenKind kind) throws IOException {
+        if (this.kind() != kind) throw this.error("Expected " + kind);
+        this.lexer.next();
+    }
+
+    private ParseException error(final String message) {
+        return new ParseException(message + ", found " + this.kind(), this.lexer.cursor());
+    }
+
+    private List<Expression> statements(final TokenKind end) throws IOException {
+        final List<Expression> expressions = new ArrayList<>();
+        while (this.kind() != end) {
+            if (this.kind() == TokenKind.SEMICOLON) {
+                this.lexer.next();
+                continue;
+            }
+            expressions.add(this.expression(0));
+            if (this.kind() != end) this.expect(TokenKind.SEMICOLON);
+        }
+        return List.copyOf(expressions);
+    }
+
+    private Expression expression(final int minimum) throws IOException {
+        if (++this.depth > 64) throw this.error("The animation expression is too deeply nested");
+        try {
+            Expression left = this.prefix();
+            while (true) {
+                if (this.kind() == TokenKind.DOT) {
+                    this.lexer.next();
+                    final String property = this.lexer.current().value();
+                    this.expect(TokenKind.IDENTIFIER);
+                    left = new AccessExpression(left, property);
+                } else if (this.kind() == TokenKind.LPAREN) {
+                    this.lexer.next();
+                    final List<Expression> arguments = new ArrayList<>();
+                    if (this.kind() != TokenKind.RPAREN) {
+                        do {
+                            arguments.add(this.expression(0));
+                            if (this.kind() != TokenKind.COMMA) break;
+                            this.lexer.next();
+                        } while (true);
+                    }
+                    this.expect(TokenKind.RPAREN);
+                    left = new CallExpression(left, List.copyOf(arguments));
+                } else if (this.kind() == TokenKind.LBRACKET) {
+                    this.lexer.next();
+                    final Expression index = this.expression(0);
+                    this.expect(TokenKind.RBRACKET);
+                    left = new ArrayAccessExpression(left, index);
+                } else if (this.kind() == TokenKind.QUES) {
+                    if (minimum >= CONDITIONAL) return left;
+                    this.lexer.next();
+                    final Expression selected = this.expression(0);
+                    if (this.kind() == TokenKind.COLON) {
+                        this.lexer.next();
+                        left =
+                                new TernaryConditionalExpression(
+                                        left, selected, this.expression(CONDITIONAL - 1));
+                    } else {
+                        left =
+                                new BinaryExpression(
+                                        BinaryExpression.Op.CONDITIONAL, left, selected);
+                    }
+                } else {
+                    final BinaryExpression.Op operation = operation(this.kind());
+                    if (operation == null) return left;
+                    final int precedence =
+                            switch (operation) {
+                                case ASSIGN -> ASSIGNMENT;
+                                case CONDITIONAL -> CONDITIONAL;
+                                case NULL_COALESCE -> COALESCE;
+                                default -> operation.precedence();
+                            };
+                    if (minimum >= precedence) return left;
+                    this.lexer.next();
+                    left =
+                            new BinaryExpression(
+                                    operation,
+                                    left,
+                                    this.expression(
+                                            operation == BinaryExpression.Op.ASSIGN
+                                                    ? precedence - 1
+                                                    : precedence));
+                }
+            }
+        } finally {
+            this.depth--;
+        }
+    }
+
+    private Expression prefix() throws IOException {
+        final var token = this.lexer.current();
+        this.lexer.next();
+        return switch (token.kind()) {
+            case FLOAT -> new DoubleExpression(Double.parseDouble(token.value()));
+            case STRING -> new StringExpression(token.value());
+            case TRUE -> DoubleExpression.ONE;
+            case FALSE -> DoubleExpression.ZERO;
+            case IDENTIFIER -> new IdentifierExpression(token.value());
+            case LPAREN -> {
+                final Expression value = this.expression(0);
+                this.expect(TokenKind.RPAREN);
+                yield value;
+            }
+            case LBRACE -> {
+                final List<Expression> body = this.statements(TokenKind.RBRACE);
+                this.expect(TokenKind.RBRACE);
+                yield new ExecutionScopeExpression(body);
+            }
+            case SUB ->
+                    new UnaryExpression(
+                            UnaryExpression.Op.ARITHMETICAL_NEGATION, this.expression(UNARY));
+            case BANG ->
+                    new UnaryExpression(
+                            UnaryExpression.Op.LOGICAL_NEGATION, this.expression(UNARY));
+            case RETURN -> new UnaryExpression(UnaryExpression.Op.RETURN, this.expression(0));
+            case BREAK -> new StatementExpression(StatementExpression.Op.BREAK);
+            case CONTINUE -> new StatementExpression(StatementExpression.Op.CONTINUE);
+            default ->
+                    throw new ParseException(
+                            "Expected an expression, found " + token.kind(), this.lexer.cursor());
+        };
+    }
+
+    private static BinaryExpression.Op operation(final TokenKind kind) {
+        return switch (kind) {
+            case AMPAMP -> BinaryExpression.Op.AND;
+            case BARBAR -> BinaryExpression.Op.OR;
+            case LT -> BinaryExpression.Op.LT;
+            case LTE -> BinaryExpression.Op.LTE;
+            case GT -> BinaryExpression.Op.GT;
+            case GTE -> BinaryExpression.Op.GTE;
+            case PLUS -> BinaryExpression.Op.ADD;
+            case SUB -> BinaryExpression.Op.SUB;
+            case STAR -> BinaryExpression.Op.MUL;
+            case SLASH -> BinaryExpression.Op.DIV;
+            case QUESQUES -> BinaryExpression.Op.NULL_COALESCE;
+            case EQ -> BinaryExpression.Op.ASSIGN;
+            case EQEQ -> BinaryExpression.Op.EQ;
+            case BANGEQ -> BinaryExpression.Op.NEQ;
+            case ARROW -> BinaryExpression.Op.ARROW;
+            default -> null;
+        };
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockOwnedSkinPacks.java
