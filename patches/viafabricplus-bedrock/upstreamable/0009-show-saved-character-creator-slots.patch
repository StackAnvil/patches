+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockSoundEvent.java
@@ -0,0 +1,174 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.function.IntUnaryOperator;
+
+/** Authored sound parameters and sample selection for Bedrock 1.26.51.1. */
+record BedrockSoundEvent(
+        String category,
+        String subtitle,
+        float minimumDistance,
+        float maximumDistance,
+        boolean legacyMaximumDistance,
+        List<Sample> samples) {
+    BedrockSoundEvent {
+        samples = List.copyOf(samples);
+    }
+
+    static BedrockSoundEvent read(final JsonObject definition) throws IOException {
+        try {
+            final String category = string(definition.get("category"));
+            boolean positional = !asciiEquals(category, "music") && !asciiEquals(category, "ui");
+            final List<Sample> samples = new ArrayList<>();
+            final JsonElement declared = definition.get("sounds");
+            if (declared != null && !declared.isJsonNull()) {
+                if (!declared.isJsonArray() || declared.getAsJsonArray().size() > 4096)
+                    throw new IOException("Invalid Bedrock sound sample list");
+                for (final JsonElement value : declared.getAsJsonArray()) {
+                    if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                        samples.add(new Sample(string(value), 1, 1, 1, false, positional, false, false));
+                    } else if (value.isJsonObject()) {
+                        final JsonObject sample = value.getAsJsonObject();
+                        // The native reader carries each object's is3D value into the next sample.
+                        positional = bool(sample.get("is3D"), positional);
+                        samples.add(new Sample(
+                                string(sample.get("name")),
+                                scalar(sample.get("volume"), 1),
+                                scalar(sample.get("pitch"), 1),
+                                integer(sample.get("weight"), 1),
+                                bool(sample.get("stream"), false),
+                                positional,
+                                bool(sample.get("interruptible"), true),
+                                bool(sample.get("allow_concurrent_streaming"), true)));
+                    } else throw new IOException("Invalid Bedrock sound sample");
+                }
+            }
+            return new BedrockSoundEvent(
+                    category,
+                    string(definition.get("subtitle")),
+                    scalar(definition.get("min_distance"), 0),
+                    scalar(definition.get("max_distance"), 0),
+                    bool(definition.get("__use_legacy_max_distance"), false),
+                    samples);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid Bedrock sound definition", invalid);
+        }
+    }
+
+    /** Draw once from integer weights; an empty or zero-weight event has no request. */
+    Selection select(
+            final IntUnaryOperator random,
+            final float volume,
+            final float pitch,
+            final boolean forceNonpositional) throws IOException {
+        if (!Float.isFinite(volume) || !Float.isFinite(pitch))
+            throw new IOException("Invalid Bedrock sound playback parameters");
+        long total = 0;
+        for (final Sample sample : this.samples) {
+            if (sample.weight < 0) throw new IOException("Negative Bedrock sound sample weight");
+            total += sample.weight;
+        }
+        if (total == 0) return null;
+        if (total > Integer.MAX_VALUE) throw new IOException("Bedrock sound weights exceed the limit");
+        int choice = random.applyAsInt((int) total);
+        if (choice < 0 || choice >= total) throw new IOException("Invalid Bedrock sound sample draw");
+        for (final Sample sample : this.samples) {
+            choice -= sample.weight;
+            if (choice < 0) {
+                final float gain = volume * sample.volume, rate = pitch * sample.pitch;
+                if (!Float.isFinite(gain) || !Float.isFinite(rate))
+                    throw new IOException("Bedrock sound playback parameters exceed the limit");
+                return new Selection(sample, gain, rate, sample.positional && !forceNonpositional);
+            }
+        }
+        throw new IOException("Invalid Bedrock sound sample weights");
+    }
+
+    /** Attached animation sounds look up their category exactly, then fall back to Effects. */
+    <T> T group(final Map<String, T> categories, final T effects) {
+        return categories.containsKey(this.category) ? categories.get(this.category) : effects;
+    }
+
+    /** Distance requests preserve positive-minimum rolloff and the legacy parent-only path. */
+    Attenuation attenuation(final Rolloff current) {
+        if (this.minimumDistance < 0 || this.maximumDistance < 0
+                || this.minimumDistance == 0 && this.maximumDistance == 0)
+            return new Attenuation(Rolloff.INVERSE, 1, 10000, false);
+        if (this.minimumDistance > 0)
+            return new Attenuation(current, this.minimumDistance,
+                    this.maximumDistance > 0 ? this.maximumDistance : 10000, false);
+        return new Attenuation(Rolloff.LINEAR, 0, this.maximumDistance, this.legacyMaximumDistance);
+    }
+
+    private static String string(final JsonElement value) throws IOException {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString())
+            return "";
+        final String string = value.getAsString();
+        if (string.length() > 512 || string.indexOf('\0') >= 0)
+            throw new IOException("Invalid Bedrock sound name");
+        return string;
+    }
+
+    private static float scalar(final JsonElement value, final float fallback) throws IOException {
+        if (value == null || value.isJsonNull()) return fallback;
+        if (!value.isJsonPrimitive()) return 0;
+        final var primitive = value.getAsJsonPrimitive();
+        if (primitive.isBoolean()) return primitive.getAsBoolean() ? 1 : 0;
+        if (!primitive.isNumber()) return 0;
+        final float number = primitive.getAsFloat();
+        if (!Float.isFinite(number)) throw new IOException("Non-finite Bedrock sound parameter");
+        return number;
+    }
+
+    private static int integer(final JsonElement value, final int fallback) throws IOException {
+        if (value == null || value.isJsonNull()) return fallback;
+        if (!value.isJsonPrimitive()) return 0;
+        final var primitive = value.getAsJsonPrimitive();
+        if (primitive.isBoolean()) return primitive.getAsBoolean() ? 1 : 0;
+        if (!primitive.isNumber()) return 0;
+        final double number = primitive.getAsDouble();
+        if (!Double.isFinite(number) || number < Integer.MIN_VALUE || number > Integer.MAX_VALUE)
+            throw new IOException("Bedrock sound weight exceeds the limit");
+        return (int) number;
+    }
+
+    private static boolean bool(final JsonElement value, final boolean fallback) {
+        if (value == null || value.isJsonNull()) return fallback;
+        if (value.isJsonArray()) return !value.getAsJsonArray().isEmpty();
+        if (value.isJsonObject()) return !value.getAsJsonObject().isEmpty();
+        final var primitive = value.getAsJsonPrimitive();
+        if (primitive.isBoolean()) return primitive.getAsBoolean();
+        if (primitive.isNumber()) return primitive.getAsDouble() != 0;
+        return !primitive.getAsString().isEmpty();
+    }
+
+    private static boolean asciiEquals(final String value, final String lower) {
+        if (value.length() != lower.length()) return false;
+        for (int index = 0; index < value.length(); index++) {
+            final char c = value.charAt(index);
+            if ((c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c) != lower.charAt(index)) return false;
+        }
+        return true;
+    }
+
+    record Sample(
+            String name, float volume, float pitch, int weight, boolean stream,
+            boolean positional, boolean interruptible, boolean concurrent) {}
+
+    record Selection(Sample sample, float volume, float pitch, boolean positional) {}
+
+    enum Rolloff { INVERSE, LINEAR }
+
+    record Attenuation(Rolloff rolloff, float minimum, float maximum, boolean parentOnly) {}
+}
