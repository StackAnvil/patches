+    @Override
+    public boolean mouseClicked(final MouseButtonEvent event, final boolean doubleClick) {
+        if (this.view == View.WARDROBE && !this.saving && this.items != null && !this.items.isEmpty()
+            && event.button() == 0) {
+            final int column = ((int) event.x() - this.gridLeft()) / 70;
+            final int row = ((int) event.y() - this.gridTop()) / 72;
+            if (event.x() >= this.gridLeft() && event.y() >= this.gridTop()
+                && column >= 0 && column < this.gridColumns() && row >= 0
+                && row < this.pageSize() / this.gridColumns()
+                && (int) event.x() - this.gridLeft() - column * 70 < 64
+                && (int) event.y() - this.gridTop() - row * 72 < 64) {
+                final int index = this.itemPage * this.pageSize() + row * this.gridColumns() + column;
+                if (index < this.items.size()) {
+                    this.selectedItem = index;
+                    this.editFailed = false;
+                    this.updateControls();
+                    return true;
+                }
+            }
+        }
+        if (this.view == View.COLORS && !this.saving && event.button() == 0) {
+            final int left = this.width / 2 - 150;
+            final int top = this.contentTop() + 52 + 18;
+            for (int index = 0; index < this.palette().size(); index++) {
+                final int x = left + index % 6 * 48;
+                final int y = top + index / 6 * 34;
+                if (event.x() >= x && event.x() < x + 42 && event.y() >= y && event.y() < y + 30) {
+                    this.selectedColor = index;
+                    this.updateControls();
+                    return true;
+                }
+            }
+        }
+        return super.mouseClicked(event, doubleClick);
+    }
