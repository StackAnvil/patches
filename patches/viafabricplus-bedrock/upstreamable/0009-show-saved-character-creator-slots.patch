+
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+/** Reads the five Character Creator recipes saved to a Bedrock account. */
+public final class BedrockCharacterProfiles {
+
+    private static final URI PROFILES = URI.create("https://persona-secondary.franchise.minecraft-services.net/api/v1.0/appearance/retrieve"
+        + "?profilenames=personaProfile1&profilenames=personaProfile2&profilenames=personaProfile3"
+        + "&profilenames=personaProfile4&profilenames=personaProfile5&profilenames=personaProfile");
+    private static final URI INVENTORY = URI.create("https://entitlements.mktpl.minecraft-services.net/api/v1.0/player/inventory?includeReceipt=true");
+    private static final URI CATALOG = URI.create("https://20ca2.playfabapi.com/Catalog/GetPublishedItem");
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();
+
+    private BedrockCharacterProfiles() {
+    }
+
+    public static CompletableFuture<AccountWardrobe> load(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String authorization = account.getMinecraftSession().getUpToDate().getAuthorizationHeader();
+                final HttpRequest profilesRequest = HttpRequest.newBuilder(PROFILES)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("session-id", UUID.randomUUID().toString())
+                    .header("Accept", "application/json")
+                    .GET().build();
+                final HttpRequest inventoryRequest = HttpRequest.newBuilder(INVENTORY)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("Authorization", authorization)
+                    .header("Accept", "application/json")
+                    .GET().build();
+                return parse(send(profilesRequest), send(inventoryRequest));
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock character profiles", e);
+            }
+        });
+    }
+
+    public static CompletableFuture<List<WardrobeItem>> loadItems(final BedrockAuthManager account,
+                                                                   final List<Entitlement> entitlements) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final String entityToken = account.getPlayFabToken().getUpToDate().getEntityToken().getToken();
+                return catalogItems(entitlements, entityToken);
+            } catch (Exception e) {
+                throw new IllegalStateException("Could not load Bedrock wardrobe items", e);
+            }
+        });
+    }
+
+    static AccountWardrobe parse(final JsonObject profiles, final JsonObject inventory) throws IOException {
+        if (!profiles.has("result") || !profiles.get("result").isJsonArray()) {
+            throw new IOException("Bedrock character profiles response has no slots");
+        }
+        final JsonArray result = array(profiles, "result");
+        final List<Slot> slots = new ArrayList<>(5);
+        for (int index = 0; index < 5; index++) {
+            final String expectedName = "personaProfile" + (index + 1);
+            JsonObject slot = null;
+            for (final JsonElement element : result) {
+                if (element.isJsonObject() && expectedName.equals(string(element.getAsJsonObject(), "slotname"))) {
+                    slot = element.getAsJsonObject();
+                    break;
+                }
+            }
+            if (slot == null) {
+                throw new IOException("Bedrock character slot " + (index + 1) + " is missing");
+            }
+            final JsonObject collection = object(slot, "personaCollection");
+            final JsonArray pieces = array(collection, "universalApp");
+            String arm = "";
+            String skinColor = "";
+            final List<String> pieceIds = new ArrayList<>();
+            for (final JsonElement element : pieces) {
+                if (!element.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject piece = element.getAsJsonObject();
+                if (piece.has("skin")) {
+                    arm = string(piece, "arm");
+                    skinColor = string(piece, "skcol");
+                } else if (piece.has("id")) {
+                    pieceIds.add(string(piece, "id"));
+                }
+            }
+            slots.add(new Slot(index + 1, arm, skinColor, List.copyOf(pieceIds), string(slot, "profileHash")));
+        }
+        final JsonObject accountInventory = object(object(inventory, "result"), "inventory");
+        if (!accountInventory.has("entitlements") || !accountInventory.get("entitlements").isJsonArray()) {
+            throw new IOException("Bedrock account inventory has no entitlements");
+        }
+        final List<Entitlement> entitlements = new ArrayList<>();
+        for (final JsonElement element : array(accountInventory, "entitlements")) {
+            if (element.isJsonObject()) {
+                final JsonObject entitlement = element.getAsJsonObject();
+                final List<String> offerIds = new ArrayList<>();
+                for (final JsonElement offer : array(entitlement, "offerIds")) {
+                    if (offer.isJsonPrimitive()) {
+                        offerIds.add(offer.getAsString());
+                    }
+                }
+                entitlements.add(new Entitlement(string(entitlement, "id"), string(entitlement, "packId"),
+                    string(entitlement, "ownership"), List.copyOf(offerIds)));
+            }
+        }
+        return new AccountWardrobe(List.copyOf(slots), List.copyOf(entitlements));
+    }
+
+    private static List<WardrobeItem> catalogItems(final List<Entitlement> entitlements, final String entityToken) {
+        final Set<String> offerIds = new LinkedHashSet<>();
+        for (final Entitlement entitlement : entitlements) {
+            offerIds.addAll(entitlement.offerIds());
+        }
+        final List<WardrobeItem> items = new ArrayList<>();
+        for (final String offerId : offerIds) {
+            if (offerId.isBlank()) {
+                continue;
+            }
+            try {
+                final JsonObject body = new JsonObject();
+                body.addProperty("ETag", "");
+                body.addProperty("ItemId", offerId);
+                final HttpRequest request = HttpRequest.newBuilder(CATALOG)
+                    .timeout(Duration.ofSeconds(15))
+                    .header("X-EntityToken", entityToken)
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString(body.toString())).build();
+                final WardrobeItem item = catalogItem(send(request));
+                if (item != null) {
+                    items.add(item);
+                }
+            } catch (IOException | InterruptedException e) {
+                if (e instanceof InterruptedException) {
+                    Thread.currentThread().interrupt();
+                }
+                throw new IllegalStateException("Could not load a Bedrock wardrobe item", e);
+            }
+        }
+        items.sort(Comparator.comparing(WardrobeItem::name, String.CASE_INSENSITIVE_ORDER));
+        return List.copyOf(items);
+    }
+
+    static WardrobeItem catalogItem(final JsonObject response) {
+        final JsonObject item = object(object(response, "data"), "Item");
+        if (!"PersonaDurable".equals(string(item, "ContentType"))) {
+            return null;
+        }
+        final JsonObject title = object(item, "Title");
+        final String name = !string(title, "en-US").isBlank() ? string(title, "en-US") : string(title, "NEUTRAL");
+        if (name.isBlank()) {
+            return null;
+        }
+        String thumbnailUrl = "";
+        for (final JsonElement element : array(item, "Images")) {
+            if (element.isJsonObject() && "Thumbnail".equals(string(element.getAsJsonObject(), "Tag"))) {
+                thumbnailUrl = string(element.getAsJsonObject(), "Url");
+                break;
+            }
+        }
+        return new WardrobeItem(string(item, "Id"), name,
+            string(object(item, "DisplayProperties"), "pieceType"), thumbnailUrl);
+    }
+
+    private static JsonObject send(final HttpRequest request) throws IOException, InterruptedException {
+        final HttpResponse<String> response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() / 100 != 2) {
+            throw new IOException("Bedrock wardrobe request failed: HTTP " + response.statusCode());
+        }
+        try {
+            return JsonParser.parseString(response.body()).getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("Bedrock wardrobe returned invalid JSON", e);
+        }
+    }
+
+    private static JsonObject object(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonObject() ? parent.getAsJsonObject(key) : new JsonObject();
+    }
+
+    private static JsonArray array(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonArray() ? parent.getAsJsonArray(key) : new JsonArray();
+    }
+
+    private static String string(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonPrimitive() ? parent.get(key).getAsString() : "";
+    }
+
+    public record AccountWardrobe(List<Slot> slots, List<Entitlement> entitlements) {
+    }
+
+    public record Slot(int number, String arm, String skinColor, List<String> pieceIds, String profileHash) {
+        public boolean occupied() {
+            return !this.pieceIds.isEmpty();
+        }
+    }
+
+    public record Entitlement(String id, String packId, String ownership, List<String> offerIds) {
+    }
+
+    public record WardrobeItem(String id, String name, String type, String thumbnailUrl) {
+    }
+
+}
