+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import net.minecraft.world.phys.AABB;
+import org.joml.Vector3f;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.random.RandomGenerator;
+
+import static com.viaversion.viafabricplus.bedrock.appearance.BedrockParticleEffect.evaluated;
+import static com.viaversion.viafabricplus.bedrock.appearance.BedrockParticleEffect.vector;
+
+/** Target float32 sampling, including evaluation order and random stream consumption. */
+record BedrockParticleShape(Kind kind, List<BedrockMolang.Program> offset,
+                            List<BedrockMolang.Program> dimensions, BedrockMolang.Program radius,
+                            List<BedrockMolang.Program> normal, Direction mode,
+                            List<BedrockMolang.Program> direction, boolean surface) {
+    enum Kind { POINT, CUSTOM, BOX, SPHERE, DISC, ENTITY_AABB }
+    enum Direction { CUSTOM, INWARDS, OUTWARDS }
+    record Sample(Vector3f position, Vector3f direction) {}
+
+    static BedrockParticleShape read(final JsonObject components) throws IOException {
+        Kind kind = Kind.POINT;
+        JsonObject value = new JsonObject();
+        boolean found = false;
+        for (final Kind candidate : Kind.values()) {
+            final String name = "minecraft:emitter_shape_" + candidate.name().toLowerCase(java.util.Locale.ROOT);
+            if (!components.has(name)) continue;
+            if (found) throw new IOException("Ambiguous particle shape");
+            found = true;
+            kind = candidate;
+            value = components.getAsJsonObject(name);
+        }
+        final boolean point = kind == Kind.POINT || kind == Kind.CUSTOM;
+        final JsonElement direction = value.get("direction");
+        final Direction mode;
+        if (direction == null) mode = point ? Direction.CUSTOM : Direction.OUTWARDS;
+        else if (direction.isJsonArray()) mode = Direction.CUSTOM;
+        else if (!point && direction.isJsonPrimitive() && direction.getAsJsonPrimitive().isString()) {
+            mode = switch (direction.getAsString()) {
+                case "inwards" -> Direction.INWARDS;
+                case "outwards" -> Direction.OUTWARDS;
+                default -> throw new IOException("Invalid particle shape direction");
+            };
+        } else throw new IOException("Invalid particle shape direction");
+        if (kind == Kind.BOX && !value.has("half_dimensions"))
+            throw new IOException("The box emitter needs half dimensions");
+        final JsonElement normal = value.get("plane_normal");
+        final List<BedrockMolang.Program> plane;
+        if (normal == null) plane = axis(1);
+        else if (normal.isJsonPrimitive() && normal.getAsJsonPrimitive().isString()) {
+            plane = axis(switch (normal.getAsString()) {
+                case "x" -> 0;
+                case "y" -> 1;
+                case "z" -> 2;
+                default -> throw new IOException("Invalid particle disc plane");
+            });
+        } else plane = vector(normal, 3, 0);
+        return new BedrockParticleShape(kind, vector(value.get("offset"), 3, 0),
+                vector(value.get("half_dimensions"), 3, 0), BedrockMolang.Program.parse(value.get("radius"), 1),
+                plane, mode, vector(mode == Direction.CUSTOM ? direction : null, 3, 0),
+                value.has("surface_only") && value.get("surface_only").getAsBoolean());
+    }
+
+    private static List<BedrockMolang.Program> axis(final int axis) {
+        return List.of(new BedrockMolang.Program(axis == 0 ? 1 : 0, null),
+                new BedrockMolang.Program(axis == 1 ? 1 : 0, null), new BedrockMolang.Program(axis == 2 ? 1 : 0, null));
+    }
+
+    Sample sample(final BedrockMolang environment, final RandomGenerator random, final AABB bounds) {
+        return switch (this.kind) {
+            case POINT, CUSTOM -> point(environment);
+            case BOX -> {
+                final Vector3f offset = evaluated(this.offset, environment);
+                final Vector3f half = evaluated(this.dimensions, environment);
+                yield box(new Vector3f(offset).sub(half), new Vector3f(offset).add(half), half, environment, random);
+            }
+            case ENTITY_AABB -> entity(environment, random, bounds);
+            case SPHERE, DISC -> rounded(environment, random);
+        };
+    }
+
+    private Sample point(final BedrockMolang environment) {
+        final Vector3f position = new Vector3f(), direction = new Vector3f();
+        // Point/custom expressions interleave offset and direction for each axis.
+        for (int axis = 0; axis < 3; axis++) {
+            position.setComponent(axis, environment.evaluate(this.offset.get(axis), 0));
+            direction.setComponent(axis, environment.evaluate(this.direction.get(axis), 0));
+        }
+        return new Sample(position, normalize(direction));
+    }
+
+    private Sample entity(final BedrockMolang environment, final RandomGenerator random, final AABB bounds) {
+        if (bounds == null || bounds.minX == 0 && bounds.minY == 0 && bounds.minZ == 0
+                && bounds.maxX == 0 && bounds.maxY == 0 && bounds.maxZ == 0)
+            return new Sample(new Vector3f(), normalize(this.mode == Direction.CUSTOM
+                    ? evaluated(this.direction, environment) : new Vector3f()));
+        final float x = (float) bounds.maxX - (float) bounds.minX;
+        final float y = (float) bounds.maxY - (float) bounds.minY;
+        final float z = (float) bounds.maxZ - (float) bounds.minZ;
+        return box(new Vector3f(Math.min(-x * .5F, x * .5F), Math.min(0, y), Math.min(-z * .5F, z * .5F)),
+                new Vector3f(Math.max(-x * .5F, x * .5F), Math.max(0, y), Math.max(-z * .5F, z * .5F)),
+                new Vector3f(x, y, z), environment, random);
+    }
+
+    private Sample box(final Vector3f min, final Vector3f max, final Vector3f dimensions,
+                       final BedrockMolang environment, final RandomGenerator random) {
+        final Vector3f center = new Vector3f((max.x - min.x) * .5F + min.x,
+                (max.y - min.y) * .5F + min.y, (max.z - min.z) * .5F + min.z);
+        if (this.surface) {
+            final float areaX = dimensions.y * dimensions.z;
+            final float areaXY = areaX + dimensions.x * dimensions.z;
+            final float total = areaXY + dimensions.x * dimensions.y;
+            if (total > Math.ulp(1F)) {
+                final float face = total * random.nextFloat();
+                final int axis = face < areaX ? 0 : face < areaXY ? 1 : 2;
+                if (random.nextBoolean()) min.setComponent(axis, max.get(axis));
+                else max.setComponent(axis, min.get(axis));
+            }
+        }
+        final Vector3f position = new Vector3f((max.x - min.x) * random.nextFloat() + min.x,
+                (max.y - min.y) * random.nextFloat() + min.y, (max.z - min.z) * random.nextFloat() + min.z);
+        final Vector3f direction = switch (this.mode) {
+            case INWARDS -> center.sub(position);
+            case OUTWARDS -> new Vector3f(position).sub(center);
+            case CUSTOM -> evaluated(this.direction, environment);
+        };
+        return new Sample(position, normalize(direction));
+    }
+
+    private Sample rounded(final BedrockMolang environment, final RandomGenerator random) {
+        final Vector3f position = evaluated(this.offset, environment);
+        final Vector3f direction = new Vector3f((random.nextFloat() + 0F) - random.nextFloat(),
+                (random.nextFloat() + 0F) - random.nextFloat(), (random.nextFloat() + 0F) - random.nextFloat());
+        if (this.kind == Kind.DISC) {
+            final Vector3f normal = normalize(evaluated(this.normal, environment));
+            final float projection = direction.x * normal.x + direction.y * normal.y + direction.z * normal.z;
+            direction.set(direction.x - projection * normal.x, direction.y - normal.y * projection,
+                    direction.z - normal.z * projection);
+        }
+        normalize(direction);
+        if (direction.x == 0 && direction.y == 0 && direction.z == 0) direction.set(1, 0, 0);
+        float radius = environment.evaluate(this.radius, 1);
+        if (!this.surface) radius *= (random.nextFloat() * .5F + .5F) - random.nextFloat() * .5F;
+        position.set(radius * direction.x + position.x, radius * direction.y + position.y, radius * direction.z + position.z);
+        return new Sample(position, switch (this.mode) {
+            case INWARDS -> direction.negate();
+            case OUTWARDS -> direction;
+            // The rounded samplers retain authored magnitudes; the box and point samplers normalize them.
+            case CUSTOM -> evaluated(this.direction, environment);
+        });
+    }
+
+    static Vector3f normalize(final Vector3f value) {
+        final float length = (float) Math.sqrt(value.x * value.x + value.y * value.y + value.z * value.z);
+        return length < 1.0E-4F ? value.set(0, 0, 0) : value.set(value.x / length, value.y / length, value.z / length);
+    }
+}
