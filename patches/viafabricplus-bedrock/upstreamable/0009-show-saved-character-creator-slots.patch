+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+
+/** Native owned-piece recipe suffixes for independent arms and legs. */
+public enum BedrockLimbSide {
+    BOTH("", 3),
+    LEFT("l", 1),
+    RIGHT("r", 2);
+
+    private final String suffix;
+    private final int mask;
+
+    BedrockLimbSide(final String suffix, final int mask) {
+        this.suffix = suffix;
+        this.mask = mask;
+    }
+
+    public int mask() {
+        return this.mask;
+    }
+
+    public static BedrockLimbSide fromRecipe(final String id) {
+        return id.endsWith("/l") ? LEFT : id.endsWith("/r") ? RIGHT : BOTH;
+    }
+
+    static boolean supportsSides(final String id) {
+        return !id.contains("/") || fromRecipe(id) != BOTH;
+    }
+
+    public String recipe(final String id) throws IOException {
+        final String base = fromRecipe(id) == BOTH ? id : id.substring(0, id.length() - 2);
+        if (this == BOTH) return base;
+        if (base.contains("/"))
+            throw new IOException("This free limb piece needs a verified side recipe");
+        return base + "/" + this.suffix;
+    }
+
+    public String packetType(final String category) {
+        final String limb = "persona_arms".equals(category) ? "Arm" : "Leg";
+        return this == BOTH ? limb + "s" : (this == LEFT ? "Left" : "Right") + limb;
+    }
+
+    static BedrockLimbSide fromMask(final int mask) {
+        return mask == 1 ? LEFT : mask == 2 ? RIGHT : BOTH;
+    }
+}
