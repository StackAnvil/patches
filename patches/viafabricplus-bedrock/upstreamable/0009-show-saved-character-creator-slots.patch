+                                .toList(),
+                        slot.profileHash(),
+                        rightRecipe);
+        final var rightOnly =
+                BedrockPersonaAssembler.assemble(preview, rightSlot, Map.of(pack.id(), pack));
+        final var rightModels =
+                JsonParser.parseString(rightOnly.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry");
+        assertTrue(
+                rightModels
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")
+                        .get(1)
+                        .getAsJsonObject()
+                        .has("cubes"));
+        final var rightBones = rightModels.get(1).getAsJsonObject().getAsJsonArray("bones");
+        assertFalse(rightBones.get(1).getAsJsonObject().has("cubes"));
+        assertTrue(rightBones.get(2).getAsJsonObject().has("cubes"));
+        assertTrue(
+                JsonParser.parseString(preview.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonArray("bones")
+                        .get(1)
+                        .getAsJsonObject()
+                        .has("cubes"));
+    }
+
+    private static byte[] strip(final int frames) throws Exception {
+        final BufferedImage image = new BufferedImage(32, frames * 32, BufferedImage.TYPE_INT_ARGB);
+        for (int frame = 0; frame < frames; frame++)
+            image.setRGB(0, frame * 32, 0xFF000001 + frame);
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+        ImageIO.write(image, "png", output);
+        return output.toByteArray();
+    }
+}
