+            "__brarchive/animation_controllers.brarchive",
+            "__brarchive/entity.brarchive",
+            "sounds/sound_definitions.json",
+            "sounds/emote/clap.fsb",
+            "sounds/emote/clap.ogg",
+            "particles/basic_bubble.json",
+            "__brarchive/sounds.brarchive",
+            "__brarchive/particles.brarchive",
+            "textures/particle/particles.png",
+            "textures/particle/campfire_smoke.tga",
+            "textures/flame_atlas.png",
+            "textures/items/bread.png",
+            "textures/items/potion_bottle_heal.png",
+            "textures/entity/CaseSensitive.jpg",
+            "textures/steve.png",
+            "__brarchive/textures/particle.brarchive",
+            "__brarchive/textures/items.brarchive",
+            "__brarchive/textures/entity.brarchive",
+            "__brarchive/textures.brarchive",
+        ] {
+            assert_eq!(
+                asset_path(&format!("data/resource_packs/vanilla/{relative}")).unwrap(),
+                Some(format!("library/vanilla/{relative}"))
+            );
+        }
+        for relative in [
+            "sounds/clap.exe",
+            "models/clap.fsb",
+            "particles/clap.ogg",
+            "textures/particle/particles.json",
+            "textures/flame_atlas.png.exe",
+            "models/../outside.json",
+        ] {
+            let result = asset_path(&format!("data/resource_packs/vanilla/{relative}"));
+            assert!(result.is_err() || result.unwrap().is_none());
+        }
+        assert!(asset_path("Minecraft.Windows.exe").unwrap().is_none());
+        assert!(
+            asset_path("data/resource_packs/personality/a")
+                .unwrap()
+                .is_none()
+        );
+        assert!(asset_path("data/resource_packs/persona/../secret").is_err());
+    }
+
+    #[test]
+    fn selects_only_canonical_vanilla_layers() {
+        for pack in [
+            "vanilla",
+            "vanilla_base",
+            "vanilla_1.9.0",
+            "vanilla_1.14",
+            "vanilla_1.26.51",
