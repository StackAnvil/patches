+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Random;
+import java.util.random.RandomGenerator;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleShapeTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeSamplingProjectionDirectionsAndRandomConsumption() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-shape-result.json"))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (int index = 0; index < cases.size(); index++) {
+            final var row = cases.get(index).getAsJsonObject();
+            final var config = row.getAsJsonObject("config");
+            final var expected = row.getAsJsonObject("values");
+            final var value = new JsonObject();
+            value.add("offset", config.has("offset") ? config.get("offset") : JsonParser.parseString("[0,0,0]"));
+            value.add("half_dimensions", config.has("dimensions") ? config.get("dimensions") : JsonParser.parseString("[1,2,3]"));
+            value.add("radius", config.has("radius") ? config.get("radius") : JsonParser.parseString("1"));
+            value.add("plane_normal", config.has("normal") ? config.get("normal") : JsonParser.parseString("[0,1,0]"));
+            value.add("direction", config.has("direction") ? config.get("direction") : JsonParser.parseString("\"outwards\""));
+            value.addProperty("surface_only", config.has("surface") && config.get("surface").getAsBoolean());
+            final var components = new JsonObject();
+            components.add("minecraft:emitter_shape_" + config.get("kind").getAsString(), value);
+            final var random = new RecordedRandom(config);
+            final var bounds = config.has("bounds") ? config.getAsJsonArray("bounds") : JsonParser.parseString("[-0.3,0,-0.4,0.3,1.8,0.4]").getAsJsonArray();
+            final var sample = BedrockParticleShape.read(components).sample(new BedrockMolang(), random,
+                    new AABB(bounds.get(0).getAsDouble(), bounds.get(1).getAsDouble(), bounds.get(2).getAsDouble(),
+                            bounds.get(3).getAsDouble(), bounds.get(4).getAsDouble(), bounds.get(5).getAsDouble()));
+            assertVector(expected.getAsJsonArray("position"), sample.position(), "position case " + index);
+            assertVector(expected.getAsJsonArray("direction"), sample.direction(), "direction case " + index);
+            assertEquals(expected.getAsJsonArray("random_calls"), random.calls, "random calls case " + index);
+        }
+        assertEquals(646, cases.size());
+    }
+
+    @Test
+    void preservesExpressionOrderAndNormalizesRoundedDirectionsForScalarSpeed() throws Exception {
+        final var value = JsonParser.parseString("""
+                {"offset":["v.step=v.step+1;return v.step;","v.step=v.step+1;return v.step;","v.step=v.step+1;return v.step;"],
+                 "direction":["v.step=v.step+1;return v.step;","v.step=v.step+1;return v.step;","v.step=v.step+1;return v.step;"]}
+                """).getAsJsonObject();
+        for (final String kind : List.of("point", "custom")) {
+            final var components = new JsonObject();
+            components.add("minecraft:emitter_shape_" + kind, value);
+            final var sample = BedrockParticleShape.read(components).sample(new BedrockMolang(), new Random(1), null);
+            assertEquals(new Vector3f(1, 3, 5), sample.position());
+            final float length = (float) Math.sqrt(56);
+            assertEquals(new Vector3f(2 / length, 4 / length, 6 / length), sample.direction());
+        }
+        for (final String kind : List.of("sphere", "disc")) for (final boolean vectorSpeed : new boolean[]{false, true}) {
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            components.remove("minecraft:emitter_shape_point");
+            components.add("minecraft:emitter_shape_" + kind, JsonParser.parseString("{\"radius\":0,\"direction\":[2,-3,0.5]}"));
+            components.add("minecraft:particle_initial_speed", JsonParser.parseString(vectorSpeed ? "[1,2,3]" : "2"));
+            final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(2), Vec3.ZERO);
+            emitter.advance(0, 2, null, (x, y, z) -> List.of());
+            emitter.advance(50_000_000, 0, null, (x, y, z) -> List.of());
+            final float length = (float) Math.sqrt(13.25F);
+            assertEquals(vectorSpeed ? new Vector3f(.05F, .1F, .15F)
+                            : new Vector3f((2F / length) * 2F * .05F, (-3F / length) * 2F * .05F, (.5F / length) * 2F * .05F),
+                    emitter.visuals().getFirst().position());
+        }
+        final var speed = BedrockParticleEffect.InitialSpeed.read(JsonParser.parseString("\"v.step=v.step+1;return v.step;\""));
+        final var direction = new Vector3f(1, 1, 1);
+        final float length = (float) Math.sqrt(3);
+        assertEquals(new Vector3f(1F / length, (1F / length) * 2, (1F / length) * 3), speed.sample(new BedrockMolang(), direction));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeScalarAndVectorSpeedIncludingTinyDirections() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-initial-speed-result.json"))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (int index = 0; index < cases.size(); index++) {
+            final var row = cases.get(index).getAsJsonObject();
+            final var config = row.getAsJsonObject("config");
+            final var values = BedrockParticleEffect.vector(config.get("speed"), 3, 0);
+            final var speed = new BedrockParticleEffect.InitialSpeed(values, config.get("vector").getAsBoolean());
+            final var direction = config.getAsJsonArray("direction");
+            final var actual = speed.sample(new BedrockMolang(), new Vector3f(direction.get(0).getAsFloat(),
+                    direction.get(1).getAsFloat(), direction.get(2).getAsFloat()));
+            assertVector(row.getAsJsonObject("values").getAsJsonArray("velocity"), actual, "speed case " + index);
+        }
+        assertEquals(128, cases.size());
+    }
+
+    @Test
+    void samplesCurrentEntityDimensionsForEachNewParticle() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.remove("minecraft:emitter_shape_point");
+        components.remove("minecraft:emitter_rate_instant");
+        components.add("minecraft:emitter_shape_entity_aabb", new JsonObject());
+        components.add("minecraft:emitter_rate_steady", JsonParser.parseString("{\"spawn_rate\":10,\"max_particles\":2}"));
+        final var random = new Random(1) {
+            @Override public float nextFloat() { return .75F; }
+        };
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), random, Vec3.ZERO);
+        emitter.advance(100_000_000, 2, new BedrockParticleAttachment(Vec3.ZERO, 180, null, new AABB(10, 20, 30, 12, 24, 36)), (x, y, z) -> List.of());
+        emitter.advance(100_000_000, 1, new BedrockParticleAttachment(Vec3.ZERO, 180, null, new AABB(-10, -20, -30, -6, -12, -18)), (x, y, z) -> List.of());
+        assertEquals(new Vector3f(.5F, 3, 1.5F), emitter.visuals().get(0).position());
+        assertEquals(new Vector3f(1, 6, 3), emitter.visuals().get(1).position());
+    }
+
+    @Test
+    void rejectsAmbiguousShapesAndMalformedDirections() throws Exception {
+        final var components = new JsonObject();
+        components.add("minecraft:emitter_shape_box", new JsonObject());
+        assertThrows(IOException.class, () -> BedrockParticleShape.read(components));
+        components.remove("minecraft:emitter_shape_box");
+        components.add("minecraft:emitter_shape_sphere", JsonParser.parseString("{\"direction\":\"sideways\"}"));
+        assertThrows(IOException.class, () -> BedrockParticleShape.read(components));
+        components.add("minecraft:emitter_shape_point", new JsonObject());
+        assertThrows(IOException.class, () -> BedrockParticleShape.read(components));
+    }
+
+    private static void assertVector(final JsonArray expected, final Vector3f actual, final String message) {
+        for (int axis = 0; axis < 3; axis++) assertEquals(expected.get(axis).getAsFloat(), actual.get(axis), message + " axis " + axis);
+    }
+
+    private static final class RecordedRandom implements RandomGenerator {
+        private final JsonArray floats, booleans, calls = new JsonArray();
+        private int floatIndex, booleanIndex;
+        private RecordedRandom(final JsonObject config) {
+            this.floats = config.has("random_values") ? config.getAsJsonArray("random_values")
+                    : JsonParser.parseString("[0.1,0.8,0.2,0.7,0.3,0.6,0.4,0.9]").getAsJsonArray();
+            this.booleans = config.has("booleans") ? config.getAsJsonArray("booleans") : JsonParser.parseString("[false]").getAsJsonArray();
+        }
+        @Override public long nextLong() { throw new AssertionError("Unexpected random operation"); }
+        @Override public float nextFloat() {
+            final float value = this.floats.get(this.floatIndex++).getAsFloat();
+            final var call = new JsonArray(); call.add("float"); call.add(value); this.calls.add(call);
+            return value;
+        }
+        @Override public boolean nextBoolean() {
+            final boolean value = this.booleans.get(this.booleanIndex++).getAsBoolean();
+            final var call = new JsonArray(); call.add("boolean"); call.add(value); this.calls.add(call);
+            return value;
+        }
+    }
+}
