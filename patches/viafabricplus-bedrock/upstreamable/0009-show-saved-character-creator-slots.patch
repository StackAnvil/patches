@@ -0,0 +1,217 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonPrimitive;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+
+/** Evaluates the server's player controller graph using one actor-local variable scope. */
+public final class BedrockPlayerControllers {
+    private final BedrockEntityData entity;
+    private final Map<String, BedrockRenderController> controllers;
+    private final Map<String, UvAnimation> uvAnimations;
+    private final Map<String, BedrockBonePattern> visibilityPatterns;
+    private final BedrockMolang molang = new BedrockMolang();
+    private final Map<String, BedrockMolang.Program> programs = new HashMap<>();
+    private final Map<List<String>, BedrockMolang.Program> scripts = new HashMap<>();
+    private boolean initialized;
+    private float previousTime;
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers) {
+        this(entity, controllers, Map.of());
+    }
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers,
+            final Map<String, UvAnimation> uvAnimations) {
+        this.entity = entity;
+        this.controllers = Map.copyOf(controllers);
+        this.uvAnimations = Map.copyOf(uvAnimations);
+        final Map<String, BedrockBonePattern> patterns = new HashMap<>();
+        for (final var controller : this.controllers.values()) {
+            for (final var rule : controller.partVisibility())
+                patterns.computeIfAbsent(rule.pattern(), BedrockBonePattern::wildcard);
+        }
+        this.visibilityPatterns = Map.copyOf(patterns);
+        this.molang.binding("geometry", entity.getGeometries());
+        this.molang.binding("texture", entity.getTextures());
+        this.molang.binding("material", entity.getMaterials());
+    }
+
+    public Selection select(
+            final float time,
+            final Map<String, Object> properties,
+            final Map<String, Object> queries,
+            final Map<String, Float> variables)
+            throws IOException {
+        return this.select(time, properties, queries, variables, Map.of());
+    }
+
+    public Selection select(final float time, final Map<String, Object> properties,
+                            final Map<String, Object> queries, final Map<String, Float> variables,
+                            final Map<String, Object> context) throws IOException {
+        this.molang.context(context);
+        final Map<String, Object> frame = new HashMap<>(queries);
+        frame.put("life_time", time);
+        frame.put("property", (BedrockActorAnimation.Query) args -> args.isEmpty() ? 0 : properties.getOrDefault(String.valueOf(args.getFirst()), 0));
+        frame.put("has_property", (BedrockActorAnimation.Query) args -> !args.isEmpty() && properties.containsKey(String.valueOf(args.getFirst())));
+        this.molang.queries(frame, time, time, this.initialized ? Math.max(0, time - this.previousTime) : 0);
+        this.previousTime = time;
+        if (!this.initialized) {
+            this.run(this.entity.getScripts().initialize());
+            this.initialized = true;
+        }
+        this.molang.variables(variables);
+        this.run(this.entity.getScripts().pre_animation());
+
+        return this.select(this.molang, false);
+    }
+
+    /** Selects draws in a sampled actor scope without rerunning its scripts. */
+    Selection select(final BedrockMolang molang, final boolean includeBody) throws IOException {
+        molang.binding("geometry", this.entity.getGeometries());
+        molang.binding("texture", this.entity.getTextures());
+        molang.binding("material", this.entity.getMaterials());
+        final List<Surface> surfaces = new ArrayList<>();
+        boolean body = false;
+        for (final var reference : this.entity.getControllers()) {
+            if (!reference.condition().isBlank() && !this.value(molang, reference.condition()).getAsBoolean()) continue;
+            final BedrockRenderController controller = this.controllers.get(reference.identifier());
+            if (controller == null) continue;
+            final Map<String, Object> arrays = new HashMap<>();
+            for (final var group : List.of(controller.geometries(), controller.textures(), controller.materials())) {
+                for (final var array : group) {
+                    final String[] values = new String[array.values().size()];
+                    for (int index = 0; index < values.length; index++) values[index] = this.value(molang, array.values().get(index)).getAsString();
+                    arrays.put(array.name().replaceFirst("(?i)^array\\.", ""), values);
+                }
+            }
+            molang.binding("array", arrays);
+            final String geometry = this.value(molang, controller.geometryExpression()).getAsString();
+            final String material = controller.materialsMap().containsKey("*") ? this.value(molang, controller.materialsMap().get("*")).getAsString() : "entity_alphatest";
+            final var nativeUv = controller.uvAnimation();
+            final UvAnimation animation = this.uvAnimations.getOrDefault(reference.identifier(),
+                    new UvAnimation(nativeUv.offsetU(), nativeUv.offsetV(), nativeUv.scaleU(), nativeUv.scaleV()));
+            final Uv uv = new Uv(
+                    (float) this.value(molang, animation.offsetX()).getAsNumber(), (float) this.value(molang, animation.offsetY()).getAsNumber(),
+                    (float) this.value(molang, animation.scaleX()).getAsNumber(), (float) this.value(molang, animation.scaleY()).getAsNumber());
+            final List<Visibility> visibility = new ArrayList<>();
+            for (final var rule : controller.partVisibility()) {
+                visibility.add(new Visibility(rule.pattern(), this.value(molang, rule.expression()).getAsBoolean(),
+                        this.visibilityPatterns.get(rule.pattern())));
+            }
+            final float lightMultiplier = (float) this.value(molang, controller.lightColorMultiplierExpression()).getAsNumber();
+            for (final String expression : controller.textureExpressions()) {
+                final String texture = this.value(molang, expression).getAsString();
+                if ((geometry.equals("geometry.humanoid.custom") || geometry.equals("geometry.humanoid.customSlim"))
+                        && (texture.equals("textures/entity/steve") || texture.equals("textures/entity/alex"))) {
+                    body = true;
+                    if (!includeBody) continue;
+                }
+                if (!geometry.isBlank() && !texture.isBlank()) {
+                    surfaces.add(new Surface(reference.identifier(), geometry, texture, material, uv, List.copyOf(visibility), controller.ignoreLighting(), lightMultiplier));
+                }
+            }
+        }
+        return new Selection(body, List.copyOf(surfaces));
+    }
+
+    private void run(final List<String> expressions) throws IOException {
+        BedrockMolang.Program program = this.scripts.get(expressions);
+        if (program == null) {
+            program = BedrockMolang.Program.script(expressions);
+            this.scripts.put(List.copyOf(expressions), program);
+        }
+        this.molang.value(program);
+    }
+
+    private org.redlance.mocha.runtime.value.Value value(final BedrockMolang molang, final String expression) throws IOException {
+        BedrockMolang.Program program = this.programs.get(expression);
+        if (program == null) {
+            program = BedrockMolang.Program.parse(new JsonPrimitive(expression), 0);
+            this.programs.put(expression, program);
+        }
+        return molang.value(program);
+    }
+
+    /** Attachable setup runs in the owner's controller variable scope. */
+    public void parentSetup(final List<String> expressions, final Map<String, Object> context) throws IOException {
+        this.molang.context(context);
+        this.run(expressions);
+    }
+
+    public static final class Visibility {
+        private final String pattern;
+        private final boolean visible;
+        private final BedrockBonePattern compiled;
+
+        public Visibility(final String pattern, final boolean visible) {
+            this(pattern, visible, BedrockBonePattern.wildcard(pattern));
+        }
+
+        private Visibility(final String pattern, final boolean visible, final BedrockBonePattern compiled) {
+            this.pattern = pattern;
+            this.visible = visible;
+            this.compiled = compiled;
+        }
+
+        public BedrockBonePattern compiled() {
+            return this.compiled;
+        }
+
+        public String pattern() {
+            return this.pattern;
+        }
+
+        public boolean visible() {
+            return this.visible;
+        }
+
+        public boolean matches(final String bone) {
+            return this.matches(bone, false);
+        }
+
+        public boolean matches(final String bone, final boolean humanoidNames) {
+            return this.compiled.matches(bone, humanoidNames);
+        }
+
+        @Override
+        public boolean equals(final Object other) {
+            return other instanceof Visibility value
+                    && this.pattern.equals(value.pattern) && this.visible == value.visible;
+        }
+
+        @Override
+        public int hashCode() {
+            return 31 * this.pattern.hashCode() + Boolean.hashCode(this.visible);
+        }
+
+        @Override
+        public String toString() {
+            return "Visibility[pattern=" + this.pattern + ", visible=" + this.visible + "]";
+        }
+    }
+
+    public record UvAnimation(String offsetX, String offsetY, String scaleX, String scaleY) {}
+    public record Uv(float offsetX, float offsetY, float scaleX, float scaleY) {
+        public static final Uv IDENTITY = new Uv(0, 0, 1, 1);
+    }
+    public record Surface(String controller, String geometry, String texture, String material, Uv uv,
+                          List<Visibility> visibility, boolean ignoreLighting, float lightMultiplier) {
+        public boolean nativeBody() {
+            return (this.geometry.equals("geometry.humanoid.custom") || this.geometry.equals("geometry.humanoid.customSlim"))
+                    && (this.texture.equals("textures/entity/steve") || this.texture.equals("textures/entity/alex"));
+        }
+    }
+    public record Selection(boolean bodyVisible, List<Surface> surfaces) {}
+}
