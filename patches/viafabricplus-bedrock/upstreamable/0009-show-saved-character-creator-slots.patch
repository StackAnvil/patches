@@ -0,0 +1,146 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockAnimationSoundTest {
+    @Test
+    void preservesEqualTimeOrderAndBoundsDeclarations() throws Exception {
+        final JsonObject effects = new JsonObject();
+        for (int index = 0; index < 6; index++) {
+            final JsonObject sound = new JsonObject();
+            sound.addProperty("effect", Integer.toString(index));
+            effects.add((index % 2 == 0 ? "0.5" : "0.25") + "0".repeat(index), sound);
+        }
+        final var events = BedrockAnimationSound.read(effects);
+        assertEquals(List.of(1, 3, 5, 0, 2, 4), events.stream().map(sound -> Integer.parseInt(sound.effect())).toList());
+        assertThrows(UnsupportedOperationException.class, () -> events.clear());
+        final JsonObject invalid = new JsonObject();
+        for (final float time : new float[] {-1, Float.NaN, Float.POSITIVE_INFINITY, 601}) {
+            invalid.add(Float.toString(time), new JsonObject());
+            assertThrows(IOException.class, () -> BedrockAnimationSound.read(invalid));
+            invalid.remove(Float.toString(time));
+        }
+        final JsonArray excessive = new JsonArray();
+        for (int index = 0; index < 4097; index++) excessive.add(new JsonObject());
+        invalid.add("0", excessive);
+        assertThrows(IOException.class, () -> BedrockAnimationSound.read(invalid));
+    }
+
+    @Test
+    void includesTheLastSoundInInferredLength() throws Exception {
+        final JsonObject definition = new JsonObject(), effects = new JsonObject();
+        effects.add("3.5", new JsonObject());
+        definition.add("sound_effects", effects);
+        final var animation = BedrockBoneAnimation.parse(definition);
+        assertEquals(3.5F, animation.length());
+        definition.addProperty("animation_length", 2);
+        assertEquals(2F, BedrockBoneAnimation.parse(definition).length());
+    }
+
+    @Test
+    void advancesSuppressedEventsAndDoesNotReplaySkippedCycles() throws Exception {
+        final var animation = animation(List.of(0F, .25F, .75F, 1F), true);
+        final var playback = animation.playback();
+        final List<BedrockAnimationSound> sounds = new ArrayList<>();
+        playback.sample(.5F, Map.of(), false, sounds::add);
+        assertTrue(sounds.isEmpty());
+        playback.sample(.75F, Map.of(), true, sounds::add);
+        assertEquals(1, sounds.size());
+        playback.sample(.75F, Map.of(), true, sounds::add);
+        assertEquals(1, sounds.size());
+        sounds.clear();
+        playback.sample(3.25F, Map.of(), true, sounds::add);
+        assertEquals(List.of(0F, .25F), sounds.stream().map(BedrockAnimationSound::time).toList());
+        sounds.clear();
+        playback.sample(0, Map.of(), true, sounds::add);
+        assertEquals(List.of(0F), sounds.stream().map(BedrockAnimationSound::time).toList());
+    }
+
+    @Test
+    void resolvesActorAliasesWithoutAnIdentityFallback() throws Exception {
+        final JsonObject entity = new JsonObject(), aliases = new JsonObject(), soundAliases = new JsonObject(), scripts = new JsonObject();
+        aliases.addProperty("test", "animation.test");
+        entity.add("animations", aliases);
+        final JsonArray animate = new JsonArray(); animate.add("test"); scripts.add("animate", animate); entity.add("scripts", scripts);
+        final JsonObject animations = new JsonObject();
+        final JsonObject definition = new JsonObject(), effects = new JsonObject(), sound = new JsonObject();
+        definition.addProperty("animation_length", 1);
+        sound.addProperty("effect", "clang"); sound.addProperty("locator", "hand"); effects.add("0", sound); definition.add("sound_effects", effects); animations.add("animation.test", definition);
+        final var noBindings = BedrockActorAnimation.read(entity, Map.of(), animations, new JsonObject(), "1.10.0").playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        final List<BedrockActorAnimation.SoundCue> requests = new ArrayList<>();
+        noBindings.sample(0, frame, true, requests::add);
+        assertTrue(requests.isEmpty());
+        soundAliases.addProperty("clang", "emote.clang"); entity.add("sound_effects", soundAliases);
+        final var bound = BedrockActorAnimation.read(entity, Map.of(), animations, new JsonObject(), "1.10.0").playback();
+        bound.sample(0, frame, true, requests::add);
+        assertEquals(1, requests.size());
+        assertEquals(soundAliases.get("clang").getAsString(), requests.getFirst().event());
+        assertEquals(sound.get("locator").getAsString(), requests.getFirst().locator());
+        bound.sample(0, frame, true, requests::add);
+        assertEquals(1, requests.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesNativeSoundQueuesAndSuppression() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_SOUND_EVENTS"));
+        final var cases = JsonParser.parseString(Files.readString(root.resolve("native-actual-sound-queue-result.json")))
+                .getAsJsonObject().getAsJsonArray("cases");
+        for (final var row : cases) {
+            final JsonObject config = row.getAsJsonObject();
+            final boolean loop = config.has("loop") && config.get("loop").getAsBoolean();
+            final List<Float> entries = new ArrayList<>();
+            if (config.has("entries")) config.getAsJsonArray("entries").forEach(value -> entries.add(value.getAsFloat()));
+            else if (loop) entries.addAll(List.of(0F, .25F, .75F, 1F));
+            else if (config.has("suppression")) entries.addAll(List.of(0F, .25F, .75F));
+            else entries.add(.25F);
+            final var playback = animation(entries, loop).playback();
+            final var frames = config.has("suppression") ? config.getAsJsonArray("suppression") : config.getAsJsonArray("frames");
+            float elapsed = 0;
+            int index = 0;
+            for (final var value : frames) {
+                final JsonObject frame = value.getAsJsonObject();
+                elapsed += frame.get("delta").getAsFloat();
+                final boolean available = !config.has("alias") || config.get("alias").getAsBoolean()
+                        && config.get("binding").getAsBoolean() && config.get("actor").getAsBoolean();
+                final boolean enabled = config.has("suppression") ? index > 0 : !config.has("flags")
+                        || config.getAsJsonArray("flags").get(1).getAsInt() == 0;
+                final List<BedrockAnimationSound> requests = new ArrayList<>();
+                playback.sample(elapsed, Map.of(), enabled, available ? requests::add : null);
+                assertEquals(frame.getAsJsonArray("sounds").size(), requests.size());
+                for (int sound = 0; sound < requests.size(); sound++) {
+                    final JsonObject expected = frame.getAsJsonArray("sounds").get(sound).getAsJsonObject();
+                    assertEquals(expected.get("sound").getAsString(), "emote." + requests.get(sound).effect());
+                    assertEquals(expected.get("locator").getAsString(), requests.get(sound).locator());
+                }
+                index++;
+            }
+        }
+    }
+
+    private static BedrockBoneAnimation animation(final List<Float> times, final boolean loop) throws IOException {
+        final JsonObject definition = new JsonObject(), effects = new JsonObject();
+        definition.addProperty("animation_length", 1); definition.addProperty("loop", loop);
+        int index = 0;
+        for (final float time : times) {
+            final JsonObject sound = new JsonObject(); sound.addProperty("effect", "clang"); sound.addProperty("locator", "right_hand");
+            effects.add(Float.toString(time) + "0".repeat(index++), sound);
+        }
+        definition.add("sound_effects", effects);
+        return BedrockBoneAnimation.parse(definition);
+    }
+}
