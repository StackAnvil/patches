+    @Test
+    void restartsClocksWhenAStateReentersAndEvaluatesEntryExitScripts() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"root":"controller.animation.root","move":"animation.move"},"scripts":{"initialize":["variable.count=0;"],"animate":["root"]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.move":{"animation_length":2,"bones":{"arm":{"rotation":{"0":[0,0,0],"2":[20,0,0]},"position":["variable.count",0,0]}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"initial_state":"on","states":{"on":{"on_entry":["variable.count=variable.count+1;"],"on_exit":["variable.count=variable.count+10;"],
+                                 "animations":["move"],"transitions":[{"off":"!query.enabled"}]},"off":{"transitions":[{"on":"query.enabled"}]}}}}
+                                """),
+                        "1.10.0");
+        final var actor = graph.playback();
+        final var on = new BedrockActorAnimation.Frame(Map.of("enabled", 1F), Map.of());
+        assertEquals(0, actor.sample(0, on).get("arm").rotation().x());
+        assertEquals(5, actor.sample(0.5F, on).get("arm").rotation().x());
+        assertTrue(actor.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of())).isEmpty());
+        final var restarted = actor.sample(1.5F, on).get("arm");
+        assertEquals(5, restarted.rotation().x());
+        assertEquals(12, restarted.position().x());
+    }
