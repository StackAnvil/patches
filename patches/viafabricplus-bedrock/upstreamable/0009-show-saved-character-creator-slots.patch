+    static JsonObject armSizeChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                           final String armSize) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size()
+            || !("wide".equals(armSize) || "slim".equals(armSize))) {
+            throw new IOException("Invalid arm size");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        if (!target.occupied() || !("wide".equals(target.arm()) || "slim".equals(target.arm()))) {
+            throw new IOException("This character has no editable arm size");
+        }
+        if (armSize.equals(target.arm())) {
+            throw new IOException("This arm size is already equipped");
+        }
+        final JsonObject edited = target.profile().deepCopy();
+        final JsonArray entries = array(object(edited, "personaCollection"), "universalApp");
+        if (entries.isEmpty() || !entries.get(0).isJsonObject() || !entries.get(0).getAsJsonObject().has("skin")) {
+            throw new IOException("This character has no base entry");
+        }
+        entries.get(0).getAsJsonObject().addProperty("arm", armSize);
+        return editRequest(wardrobe, slotNumber, edited);
+    }
+
+    static JsonObject heightChangeRequest(final AccountWardrobe wardrobe, final int slotNumber,
+                                          final Height height) throws IOException {
+        if (slotNumber < 1 || slotNumber > wardrobe.slots().size() || height == null) {
+            throw new IOException("Invalid character height");
+        }
+        final Slot target = wardrobe.slots().get(slotNumber - 1);
+        final Height previous = height(target).orElseThrow(() -> new IOException("This character has no known height recipe"));
+        if (previous == height) {
+            throw new IOException("This height is already equipped");
+        }
+        final JsonObject edited = target.profile().deepCopy();
+        final JsonObject collection = object(edited, "personaCollection");
+        final JsonArray entries = array(collection, "universalApp");
+        final JsonArray remaining = new JsonArray();
+        int removed = 0;
+        for (final JsonElement entry : entries) {
+            if (!entry.isJsonObject()) {
+                remaining.add(entry.deepCopy());
+                continue;
+            }
+            final String id = string(entry.getAsJsonObject(), "id");
+            if (previous.contains(id)) {
+                removed++;
+            } else {
+                for (final Height option : Height.values()) {
+                    if (option.contains(id)) {
+                        throw new IOException("This character has conflicting height entries");
+                    }
+                }
+                remaining.add(entry.deepCopy());
+            }
+        }
+        if (removed != 2) {
+            throw new IOException("This character has an incomplete height recipe");
+        }
+        final int emotes = emoteStart(remaining, List.of());
+        final int insertion = emotes < 0 ? remaining.size() : emotes;
+        final JsonArray reordered = new JsonArray();
+        for (int index = 0; index <= remaining.size(); index++) {
+            if (index == insertion) {
+                final JsonObject first = new JsonObject();
+                first.addProperty("id", height.firstId);
+                reordered.add(first);
+                final JsonObject second = new JsonObject();
+                second.addProperty("id", height.secondId);
+                reordered.add(second);
+            }
+            if (index < remaining.size()) {
+                reordered.add(remaining.get(index));
+            }
+        }
+        collection.add("universalApp", reordered);
+        return editRequest(wardrobe, slotNumber, edited);
+    }
