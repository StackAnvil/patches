+    private static final URI MODEL = URI.create("https://persona-secondary.franchise.minecraft-services.net/api/v1.0/profile/image/ModelBinary");
+    private static final Pattern CAPE_ID = Pattern.compile("[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}");
