+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class BedrockCharacterProfilesTest {
+
+    @Test
+    void separatesCharacterSlotsFromTheAccountSettingsProfile() throws Exception {
+        final JsonObject profiles = JsonParser.parseString("""
+            {"result":[
+              {"slotname":"personaProfile3","profileHash":"third","personaCollection":{"universalApp":[
+                {"arm":"slim","skcol":"#ffccaa","skin":"base"},{"id":"hat"},{"col":"#ff0000","id":"top"}]}},
+              {"slotname":"personaProfile1","profileHash":"first","personaCollection":{"universalApp":[
+                {"arm":"wide","skcol":"#aabbcc","skin":"base"},{"id":"hair"}]}},
+              {"slotname":"personaProfile2","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile4","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile5","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile","personaCollection":{"universalApp":[
+                {"id":"settings","lastUsedPersonaSlot":3}]}}
+            ]}
+            """).getAsJsonObject();
+        final JsonObject inventory = JsonParser.parseString("""
+            {"result":{"inventory":{"entitlements":[
+              {"id":"product","packId":"pack","ownership":"Purchased","offerIds":["offer"]}
+            ]}}}
+            """).getAsJsonObject();
+
+        final var wardrobe = BedrockCharacterProfiles.parse(profiles, inventory);
+
+        assertEquals(5, wardrobe.slots().size());
+        assertEquals("wide", wardrobe.slots().getFirst().arm());
+        assertEquals("#aabbcc", wardrobe.slots().getFirst().skinColor());
+        assertEquals(1, wardrobe.slots().getFirst().pieceIds().size());
+        assertFalse(wardrobe.slots().get(1).occupied());
+        assertTrue(wardrobe.slots().get(2).occupied());
+        assertEquals(2, wardrobe.slots().get(2).pieceIds().size());
+        assertEquals(1, wardrobe.entitlements().size());
+        assertEquals("pack", wardrobe.entitlements().getFirst().packId());
+        assertEquals(1, wardrobe.entitlements().getFirst().offerIds().size());
+    }
+
+    @Test
+    void includesOnlyPersonaPiecesFromTheMarketplaceCatalog() {
+        final JsonObject response = JsonParser.parseString("""
+            {"data":{"Item":{"Id":"piece","ContentType":"PersonaDurable",
+              "Title":{"en-US":"Blue Hat"},"DisplayProperties":{"pieceType":"persona_head"},
+              "Images":[{"Tag":"Thumbnail","Url":"https://example.test/hat.png"}]}}}
+            """).getAsJsonObject();
+
+        final var item = BedrockCharacterProfiles.catalogItem(response);
+
+        assertNotNull(item);
+        assertEquals("Blue Hat", item.name());
+        assertEquals("persona_head", item.type());
+        assertEquals("https://example.test/hat.png", item.thumbnailUrl());
+        response.getAsJsonObject("data").getAsJsonObject("Item").addProperty("ContentType", "GrantBundle_V1.0");
+        assertNull(BedrockCharacterProfiles.catalogItem(response));
+    }
+
+}
