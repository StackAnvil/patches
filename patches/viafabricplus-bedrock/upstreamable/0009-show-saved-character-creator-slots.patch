+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.minecraft.Particle;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import com.viaversion.viaversion.protocols.v26_2to26_3.packet.ClientboundPackets26_3;
+import io.netty.buffer.Unpooled;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.Bootstrap;
+import net.raphimc.viabedrock.api.model.NativeParticlePlaybackMessage;
+import net.raphimc.viabedrock.api.util.PacketFactory;
+import net.raphimc.viabedrock.protocol.data.BedrockMappingData;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.protocol.model.SpawnParticleEffect;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockServerParticlesTest {
+    @Test
+    void decodesCoreFallbackWithMinecraftCodecAfterNativeTransport() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        // ViaVersion initializes its structured keys before the versioned type registry at runtime.
+        Class.forName("com.viaversion.viaversion.api.minecraft.data.StructuredDataKey");
+        final var particle = ParticleTypes.FLAME;
+        final var position = new Position3f(-1.25F, 70.5F, 9.75F);
+        final var javaParticle = new BedrockMappingData.JavaParticle(
+                new Particle(BuiltInRegistries.PARTICLE_TYPE.getId(particle)), .125F, .25F, .5F, .75F, 19);
+        final var wrapper = new PacketWrapperImpl(ClientboundPackets26_3.LEVEL_PARTICLES, null, null);
+        PacketFactory.writeJavaLevelParticles(wrapper, position, javaParticle);
+        final var buffer = Unpooled.buffer();
+        try {
+            wrapper.writeToBuffer(buffer);
+            assertEquals(ClientboundPackets26_3.LEVEL_PARTICLES.getId(), Types.VAR_INT.readPrimitive(buffer));
+            final byte[] body = new byte[buffer.readableBytes()];
+            buffer.readBytes(body);
+            final var effect = new SpawnParticleEffect(0, SpawnParticleEffect.WORLD, position, "test:missing", null);
+            final var message = new NativeParticlePlaybackMessage(effect, position, null, body);
+            buffer.clear();
+            NativeParticlePlaybackMessage.TYPE.write(buffer, message);
+            final var decoded = BedrockServerParticles.decodeFallback(NativeParticlePlaybackMessage.TYPE.read(buffer).fallback(), RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY));
+            assertSame(particle, decoded.particle());
+            assertEquals(position.x(), decoded.x());
+            assertEquals(position.y(), decoded.y());
+            assertEquals(position.z(), decoded.z());
+            assertEquals(javaParticle.offsetX(), decoded.xDist());
+            assertEquals(javaParticle.offsetY(), decoded.yDist());
+            assertEquals(javaParticle.offsetZ(), decoded.zDist());
+            assertEquals(javaParticle.speed(), decoded.xMaxSpeed());
+            assertEquals(javaParticle.speed(), decoded.yMaxSpeed());
+            assertEquals(javaParticle.speed(), decoded.zMaxSpeed());
+            assertEquals(javaParticle.count(), decoded.count());
+            assertFalse(decoded.overrideLimiter());
+            assertFalse(decoded.alwaysShow());
+            assertThrows(IllegalArgumentException.class,
+                    () -> BedrockServerParticles.decodeFallback(Arrays.copyOf(body, body.length + 1), RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY)));
+        } finally { buffer.release(); }
+    }
+}
