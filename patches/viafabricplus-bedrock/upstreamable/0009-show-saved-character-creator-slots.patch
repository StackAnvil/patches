+    @Test
+    void sharesTimelineWritesWithLaterTracksAndControllerTransitions() throws IOException {
+        final var graph =
+                BedrockActorAnimation.read(
+                        json(
+                                """
+                                {"animations":{"writer":"animation.writer","root":"controller.animation.root",
+                                   "before":"animation.before","after":"animation.after"},
+                                 "scripts":{"animate":["writer","root"]}}
+                                """),
+                        Map.of(),
+                        json(
+                                """
+                                {"animation.writer":{"animation_length":2,"timeline":{"0.5":"v.ready=1;"}},
+                                 "animation.before":{"loop":true,"bones":{"head":{"position":["v.ready??0",0,0]}}},
+                                 "animation.after":{"loop":true,"bones":{"head":{"position":[2,0,0]}}}}
+                                """),
+                        json(
+                                """
+                                {"controller.animation.root":{"states":{
+                                   "default":{"animations":["before"],"transitions":[{"ready":"v.ready"}]},
+                                   "ready":{"animations":["after"]}}}}
+                                """),
+                        "1.10.0");
+        final var actor = graph.playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        assertEquals(0, actor.sample(0, frame).get("head").position().x());
+        assertEquals(2, actor.sample(0.5F, frame).get("head").position().x());
+        assertEquals(2, actor.sample(1, frame).get("head").position().x());
+        assertEquals(0, graph.playback().sample(0, frame).get("head").position().x());
