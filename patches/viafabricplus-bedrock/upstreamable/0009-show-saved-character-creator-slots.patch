+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMarketplaceAssets.Pack;
+
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Downloads owned and zero-price pieces using the current account's receipt keys. */
+final class BedrockPersonaAssets {
+    private BedrockPersonaAssets() {}
+
+    static Map<String, Pack> load(
+            final BedrockAuthManager account,
+            final BedrockPersonaProfile profile,
+            final BedrockCharacterProfiles.Slot slot,
+            final List<BedrockCharacterProfiles.WardrobeItem> catalog)
+            throws Exception {
+        final List<Reference> references =
+                new ArrayList<>(
+                        profile.pieces().stream()
+                                .filter(
+                                        piece ->
+                                                BedrockPersonaProfile.defaultType(piece.id())
+                                                                == null
+                                                        && !piece.productId().isEmpty())
+                                .map(
+                                        piece ->
+                                                catalog.stream()
+                                                        .filter(
+                                                                item ->
+                                                                        item.id()
+                                                                                        .equals(
+                                                                                                piece
+                                                                                                        .productId())
+                                                                                && item.packId()
+                                                                                        .equals(
+                                                                                                piece
+                                                                                                        .packId()))
+                                                        .findFirst()
+                                                        .map(Reference::from)
+                                                        .orElseGet(
+                                                                () ->
+                                                                        new Reference(
+                                                                                piece.packId(),
+                                                                                piece.productId(),
+                                                                                false)))
+                                .toList());
+        references.addAll(BedrockPersonaCape.references(slot, catalog));
+        final Map<String, Pack> packs = new LinkedHashMap<>(load(account, references));
+        if (profile.pieces().stream()
+                .anyMatch(piece -> BedrockPersonaProfile.defaultType(piece.id()) != null)) {
+            final var builtins = BedrockBuiltinAssets.load(account);
+            for (final var piece : profile.pieces())
+                if (BedrockPersonaProfile.defaultType(piece.id()) != null)
+                    packs.put(piece.id(), builtins.piece(piece.id()));
+        }
+        return Map.copyOf(packs);
+    }
+
+    static Map<String, Pack> load(
+            final BedrockAuthManager account, final List<Reference> references) throws Exception {
+        if (references.isEmpty()) return Map.of();
+        final Map<String, byte[]> keys = BedrockMarketplaceAssets.accountKeys(account);
+        final Map<String, Pack> packs = new LinkedHashMap<>();
+        for (final Reference piece : references) {
+            if (packs.containsKey(piece.packId())) continue;
+            final byte[] key = keys.get(piece.packId());
+            if (key == null && (!piece.zeroPrice() || keys.isEmpty())) continue;
+            final JsonObject item = BedrockMarketplaceAssets.published(account, piece.productId());
+            if (key == null && !freePersonaItem(item, piece)) continue;
+            final byte[] bytes = BedrockMarketplaceAssets.download(item, "personabinary");
+            packs.put(
+                    piece.packId(),
+                    BedrockMarketplaceAssets.decode(
+                            bytes, piece.packId(), key == null ? keys.values() : List.of(key)));
+        }
+        return Map.copyOf(packs);
+    }
+
+    static boolean freePersonaItem(final JsonObject item, final Reference reference)
+            throws IOException {
+        try {
+            if (!reference.zeroPrice()
+                    || !reference.productId().equals(item.get("Id").getAsString())
+                    || !"PersonaDurable".equals(item.get("ContentType").getAsString()))
+                return false;
+            final JsonObject properties = item.getAsJsonObject("DisplayProperties");
+            final var price = properties.get("price");
+            if (price == null
+                    || !price.isJsonPrimitive()
+                    || !price.getAsJsonPrimitive().isNumber()
+                    || price.getAsBigDecimal().signum() != 0) return false;
+            for (final var identity : properties.getAsJsonArray("packIdentity")) {
+                final var pack = identity.getAsJsonObject();
+                if ("persona_piece".equals(pack.get("type").getAsString())
+                        && reference.packId().equals(pack.get("uuid").getAsString())) return true;
+            }
+            return false;
+        } catch (RuntimeException e) {
+            throw new IOException("The persona catalog returned invalid item metadata", e);
+        }
+    }
+
+    record Reference(String packId, String productId, boolean zeroPrice) {
+        static Reference from(final BedrockCharacterProfiles.WardrobeItem item) {
+            return new Reference(item.packId(), item.id(), item.price() == 0);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaBody.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaBody.java
new file mode 100644
index 0000000..642cc8d
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaBody.java
@@ -0,0 +1,389 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Builds the equipped skeleton, body zones and static piece surfaces from licensed assets. */
+final class BedrockPersonaBody {
+    private BedrockPersonaBody() {}
+
+    static boolean available(
+            final BedrockCharacterProfiles.Slot slot,
+            final BedrockPersonaProfile profile,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        if (profile.pieces().stream()
+                .anyMatch(
+                        piece ->
+                                !packs.containsKey(piece.id())
+                                        && !packs.containsKey(piece.packId()))) return false;
+        final var cape = BedrockPersonaCape.read(slot, packs);
+        for (final String id : slot.pieceIds()) {
+            if (id.endsWith("/e") || id.endsWith("/de")) continue;
+            if (cape != null && cape.packId().equalsIgnoreCase(id.split("/", 2)[0])) continue;
+            if (profile.pieces().stream()
+                    .noneMatch(piece -> piece.id().equalsIgnoreCase(id.split("/", 2)[0])))
+                return false;
+        }
+        return true;
+    }
+
+    static BedrockPersonaModel.Converted assemble(
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs,
+            final JsonObject capeModel)
+            throws IOException {
+        final var cape = BedrockPersonaCape.read(slot, packs);
+        final var skinColor = BedrockPersonaTint.skinColor(slot, packs);
+        final List<Piece> pieces = new ArrayList<>();
+        for (final var pack : packs.values()) {
+            final var recipes = BedrockPersonaSources.recipes(pack, slot);
+            if (recipes.isEmpty()) throw new IOException("A persona pack has no equipped recipe");
+            for (final var metadata : BedrockPersonaSources.metadata(pack)) {
+                if ("persona_capes".equals(metadata.get("piece_type").getAsString())) continue;
+                pieces.add(
+                        new Piece(
+                                pack,
+                                metadata,
+                                recipes,
+                                BedrockPersonaSources.order(
+                                        metadata.get("piece_type").getAsString())));
+            }
+        }
+        pieces.sort(
+                Comparator.comparingInt(Piece::order).thenComparing(piece -> piece.pack().id()));
+        final List<Layer> layers = new ArrayList<>();
+        final List<Surface> surfaces = new ArrayList<>();
+        boolean skeleton = false, body = false;
+        int bodySize = 128, bodyFrames = 1;
+        BufferedImage clothingMap = null;
+        for (final var piece : pieces) {
+            final String type = piece.metadata().get("piece_type").getAsString();
+            skeleton |= type.equals("persona_skeleton");
+            body |= type.equals("persona_body");
+            if (type.equals("persona_body") && piece.metadata().has("clothing_map")) {
+                final String path = piece.metadata().get("clothing_map").getAsString();
+                BedrockBuiltinAssets.validPath(path);
+                clothingMap = BedrockPersonaSources.tga(piece.pack().files().get(path));
+            }
+            final var textures =
+                    BedrockPersonaSources.read(
+                            piece.pack(),
+                            source ->
+                                    BedrockPersonaSources.matches(source, slot)
+                                            && piece.recipes().stream()
+                                                    .anyMatch(
+                                                            recipe ->
+                                                                    BedrockPersonaGeometry.includes(
+                                                                            source,
+                                                                            BedrockLimbSide
+                                                                                    .fromRecipe(
+                                                                                            recipe.get(
+                                                                                                            "id")
+                                                                                                    .getAsString())
+                                                                                    .mask())));
+            for (final var texture : textures) {
+                if (!texture.metadata().equals(piece.metadata())
+                        || texture.face()
+                        || texture.source().has("geometry")) continue;
+                if (texture.frames() > 1)
+                    BedrockPersonaAnimationAtlas.validate(texture.image(), texture.frames(), 128);
+                bodyFrames = Math.max(bodyFrames, texture.frames());
+                if (piece.recipes().size() != 1)
+                    throw new IOException("A body texture has an ambiguous recipe");
+                final int size = texture.image().getWidth();
+                if (size != texture.image().getHeight() / texture.frames())
+                    throw new IOException("A shared body texture must be square");
+                bodySize = Math.max(bodySize, size);
+                layers.add(
+                        new Layer(
+                                texture,
+                                BedrockPersonaTint.palette(
+                                        texture, slot, piece.recipes().getFirst(), skinColor)));
+            }
+            if (!piece.metadata().has("geometry_sources")) continue;
+            final var geometries = BedrockPersonaSources.geometries(piece.pack());
+            for (final var element : piece.metadata().getAsJsonArray("geometry_sources")) {
+                final JsonObject source = element.getAsJsonObject();
+                if (!BedrockPersonaSources.matches(source, slot)
+                        || source.has("is_face") && source.get("is_face").getAsBoolean()) continue;
+                final JsonObject geometry = geometries.get(source.get("geometry").getAsString());
+                if (geometry == null)
+                    throw new IOException("A persona piece is missing its geometry");
+                for (final var recipe : piece.recipes()) {
+                    final int side =
+                            BedrockLimbSide.fromRecipe(recipe.get("id").getAsString()).mask();
+                    if (!BedrockPersonaGeometry.includes(source, side)) continue;
+                    BedrockPersonaSources.Texture texture = null;
+                    if (source.has("texture")) {
+                        texture =
+                                textures.stream()
+                                        .filter(
+                                                candidate ->
+                                                        candidate
+                                                                        .metadata()
+                                                                        .equals(piece.metadata())
+                                                                && candidate
+                                                                        .source()
+                                                                        .equals(source))
+                                        .findFirst()
+                                        .orElseThrow(
+                                                () ->
+                                                        new IOException(
+                                                                "A persona geometry source has no"
+                                                                        + " texture"));
+                    }
+                    surfaces.add(new Surface(piece, source, geometry, texture, recipe, side));
+                }
+            }
+        }
+        if (!skeleton || !body || layers.isEmpty())
+            throw new IOException("The character is missing its skeleton, body or skin textures");
+        if (bodySize > 1024) throw new IOException("The persona body texture is too large");
+        if (bodyFrames > 1 && bodySize != 128)
+            throw new IOException("An animated shared body texture needs 128-pixel layers");
+        final BufferedImage composed = compose(layers, bodySize, clothingMap, bodyFrames);
+        final BufferedImage bodyTexture = composed.getSubimage(0, 0, bodySize, bodySize);
+        final BufferedImage bodyStrip = bodyFrames > 1 ? composed : null;
+        final Map<String, BufferedImage> images = new LinkedHashMap<>();
+        images.put("body", bodyTexture);
+        for (final var surface : surfaces)
+            if (surface.texture() != null
+                    && surface.texture().frames() == 1
+                    && !images.containsKey(surface.tileId()))
+                images.put(
+                        surface.tileId(),
+                        BedrockPersonaTint.apply(
+                                surface.texture(),
+                                BedrockPersonaTint.palette(
+                                        surface.texture(), slot, surface.recipe(), skinColor)));
+        if (cape != null) images.put("cape", cape.image());
+        final Map<String, Tile> tiles = pack(images);
+        final int atlasSize = tiles.values().iterator().next().atlasSize();
+        final BufferedImage atlas =
+                new BufferedImage(atlasSize, atlasSize, BufferedImage.TYPE_INT_ARGB);
+        for (final var tile : tiles.values()) {
+            final BufferedImage image = tile.image();
+            for (int y = -1; y <= image.getHeight(); y++)
+                for (int x = -1; x <= image.getWidth(); x++)
+                    atlas.setRGB(
+                            tile.x() + x,
+                            tile.y() + y,
+                            image.getRGB(
+                                    Math.clamp(x, 0, image.getWidth() - 1),
+                                    Math.clamp(y, 0, image.getHeight() - 1)));
+        }
+        final Map<String, Surface> owners = new LinkedHashMap<>();
+        for (final var surface : surfaces)
+            for (final String zone : zones(surface.source(), surface.side()))
+                owners.put(zone, surface);
+        final Map<String, JsonObject> bones = new LinkedHashMap<>(),
+                bodySurfaces = new LinkedHashMap<>();
+        for (final var surface : surfaces) {
+            final boolean animated = surface.texture() != null && surface.texture().frames() > 1;
+            final List<String> zones = zones(surface.source(), surface.side());
+            final boolean replaced =
+                    !zones.isEmpty()
+                            && zones.stream().allMatch(zone -> owners.get(zone) != surface);
+            if (!replaced && zones.stream().anyMatch(zone -> owners.get(zone) != surface))
+                throw new IOException("A persona geometry source has partially replaced zones");
+            final Tile tile = tiles.get(surface.texture() == null ? "body" : surface.tileId());
+            for (final var element : surface.geometry().getAsJsonArray("bones")) {
+                final JsonObject incoming = element.getAsJsonObject();
+                if (!BedrockPersonaGeometry.includes(surface.geometry(), incoming, surface.side()))
+                    continue;
+                final JsonObject bone = BedrockPersonaGeometry.canonical(incoming);
+                if (replaced || animated) {
+                    bone.remove("cubes");
+                    bone.remove("poly_mesh");
+                } else if (bodyStrip != null && surface.texture() == null) {
+                    BedrockPersonaGeometry.mapUvs(bone, bodySize, bodySize, 0, 0, bodySize);
+                    BedrockPersonaGeometry.merge(bodySurfaces, bone.deepCopy());
+                    bone.remove("cubes");
+                    bone.remove("poly_mesh");
+                } else
+                    BedrockPersonaGeometry.mapUvs(
+                            bone,
+                            tile.image().getWidth(),
+                            tile.image().getHeight(),
+                            tile.x(),
+                            tile.y(),
+                            atlasSize);
+                BedrockPersonaGeometry.merge(bones, bone);
+            }
+        }
+        if (cape != null) {
+            final Tile tile = tiles.get("cape");
+            cape.bind(bones, capeModel, tile.x(), tile.y(), atlasSize);
+        }
+        final String identifier = "geometry.persona.body";
+        final JsonObject model = new JsonObject(), description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        description.addProperty("texture_width", atlasSize);
+        description.addProperty("texture_height", atlasSize);
+        model.add("description", description);
+        final JsonArray boneArray = new JsonArray();
+        bones.values().forEach(boneArray::add);
+        model.add("bones", boneArray);
+        final JsonObject document = new JsonObject();
+        document.addProperty("format_version", "1.16.0");
+        final JsonArray models = new JsonArray();
+        models.add(model);
+        document.add("minecraft:geometry", models);
+        final JsonObject patch = new JsonObject(), bindings = new JsonObject();
+        bindings.addProperty("default", identifier);
+        patch.add("geometry", bindings);
+        final List<AnimationData> animations = new ArrayList<>();
+        if (bodyStrip != null) {
+            final Map<String, JsonObject> animated = new LinkedHashMap<>();
+            for (final var entry : bones.entrySet()) {
+                final JsonObject pose = entry.getValue().deepCopy();
+                pose.remove("cubes");
+                pose.remove("poly_mesh");
+                animated.put(entry.getKey(), pose);
+            }
+            for (final var bone : bodySurfaces.values())
+                BedrockPersonaGeometry.merge(animated, bone);
+            final JsonObject animatedModel = new JsonObject(),
+                    animatedDescription = new JsonObject();
+            animatedDescription.addProperty("identifier", "geometry.persona.animated_body");
+            animatedDescription.addProperty("texture_width", bodySize);
+            animatedDescription.addProperty("texture_height", bodySize);
+            animatedModel.add("description", animatedDescription);
+            final JsonArray animatedBones = new JsonArray();
+            animated.values().forEach(animatedBones::add);
+            animatedModel.add("bones", animatedBones);
+            models.add(animatedModel);
+            bindings.addProperty("animated_128x128", "geometry.persona.animated_body");
+            animations.add(new AnimationData(bodyStrip, 3, bodyFrames, 0));
+        }
+        return new BedrockPersonaModel.Converted(
+                atlas, document.toString(), patch.toString(), List.copyOf(animations));
+    }
+
+    private static List<String> zones(final JsonObject source, final int side) {
+        if (!source.has("zone")) return List.of();
+        final List<String> result = new ArrayList<>();
+        final var value = source.get("zone");
+        if (value.isJsonArray())
+            value.getAsJsonArray().forEach(zone -> result.add(zone.getAsString()));
+        else result.add(value.getAsString());
+        return result.stream()
+                .filter(
+                        zone ->
+                                (!zone.startsWith("left_") || (side & 1) != 0)
+                                        && (!zone.startsWith("right_") || (side & 2) != 0))
+                .toList();
+    }
+
+    private static BufferedImage compose(
+            final List<Layer> layers,
+            final int size,
+            final BufferedImage clothingMap,
+            final int frames) {
+        final BufferedImage image =
+                new BufferedImage(size, size * frames, BufferedImage.TYPE_INT_ARGB);
+        for (final var layer : layers) {
+            final var source = layer.texture();
+            final int height = source.image().getHeight() / source.frames();
+            for (int y = 0; y < image.getHeight(); y++) {
+                final int offset = y / size % source.frames() * height;
+                final int sy = (int) ((y % size + 0.5F) * height / size) + offset;
+                for (int x = 0; x < size; x++) {
+                    final int sx = (int) ((x + 0.5F) * source.image().getWidth() / size);
+                    if (clothingMap != null && source.image().getRGB(sx, sy) >>> 24 != 0) {
+                        final int map =
+                                clothingMap.getRGB(
+                                        x * clothingMap.getWidth() / size,
+                                        y % size * clothingMap.getHeight() / size);
+                        final int dx = Math.clamp(x + ((map >>> 16) & 255) - 128, 0, size - 1);
+                        final int dy = Math.max(0, y + ((map >>> 8) & 255) - 128);
+                        if (map >>> 24 != 0 && (dx != x || dy != y) && dy < image.getHeight()) {
+                            final int tx = (int) ((dx + 0.5F) * source.image().getWidth() / size);
+                            final int segment =
+                                    y / (size * source.frames()) * (size * source.frames());
+                            final int ty =
+                                    Math.clamp(
+                                            (dy - segment) * height / size,
+                                            0,
+                                            source.image().getHeight() - 1);
+                            if (source.image().getRGB(tx, ty) >>> 24 == 0) image.setRGB(dx, dy, 0);
+                        }
+                    }
+                    image.setRGB(
+                            x,
+                            y,
+                            BedrockPersonaTint.blend(
+                                    image.getRGB(x, y),
+                                    source.image().getRGB(sx, sy),
+                                    source.tintMap() == null ? 0 : source.tintMap().getRGB(sx, sy),
+                                    layer.palette().authored(),
+                                    layer.palette().selected()));
+                }
+            }
+        }
+        return image;
+    }
+
+    private static Map<String, Tile> pack(final Map<String, BufferedImage> images)
+            throws IOException {
+        for (int size = 256; size <= 2048; size *= 2) {
+            final Map<String, Tile> tiles = new LinkedHashMap<>();
+            int x = 0, y = 0, rowHeight = 0;
+            for (final var entry : images.entrySet()) {
+                final BufferedImage image = entry.getValue();
+                final int width = image.getWidth() + 2, height = image.getHeight() + 2;
+                if (width > size || height > size) break;
+                if (x + width > size) {
+                    x = 0;
+                    y += rowHeight;
+                    rowHeight = 0;
+                }
+                if (y + height > size) break;
+                tiles.put(entry.getKey(), new Tile(image, x + 1, y + 1, size));
+                x += width;
+                rowHeight = Math.max(rowHeight, height);
+            }
+            if (tiles.size() == images.size()) return tiles;
+        }
+        throw new IOException("The equipped persona surfaces exceed the texture atlas");
+    }
+
+    private record Piece(
+            BedrockMarketplaceAssets.Pack pack,
+            JsonObject metadata,
+            List<JsonObject> recipes,
+            int order) {}
+
+    private record Layer(
+            BedrockPersonaSources.Texture texture, BedrockPersonaTint.Palette palette) {}
+
+    private record Surface(
+            Piece piece,
+            JsonObject source,
+            JsonObject geometry,
+            BedrockPersonaSources.Texture texture,
+            JsonObject recipe,
+            int side) {
+        String tileId() {
+            return piece.pack().id() + "/" + source.get("texture").getAsString() + "/" + recipe;
+        }
+    }
+
+    private record Tile(BufferedImage image, int x, int y, int atlasSize) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaCape.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaCape.java
new file mode 100644
index 0000000..c9c0235
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaCape.java
@@ -0,0 +1,227 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+
+import org.cube.converter.util.element.Direction;
+import org.cube.converter.util.element.Position3V;
+import org.cube.converter.util.element.UVMap;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Binds an entitled cape texture to the licensed cape model and the equipped body pivot. */
+record BedrockPersonaCape(
+        String packId,
+        BedrockPersonaSources.Texture texture,
+        JsonObject recipe,
+        BedrockCharacterProfiles.Slot slot) {
+    static List<BedrockPersonaAssets.Reference> references(
+            final BedrockCharacterProfiles.Slot slot,
+            final List<BedrockCharacterProfiles.WardrobeItem> catalog)
+            throws IOException {
+        final List<BedrockPersonaAssets.Reference> references = new ArrayList<>();
+        for (final String id : slot.pieceIds()) {
+            final var matches =
+                    catalog.stream()
+                            .filter(item -> "persona_capes".equals(item.type()) && item.matches(id))
+                            .toList();
+            if (matches.size() > 1)
+                throw new IOException("The equipped cape catalog entry is ambiguous");
+            if (!matches.isEmpty()) {
+                final var item = matches.getFirst();
+                references.add(BedrockPersonaAssets.Reference.from(item));
+            }
+        }
+        if (references.size() > 1)
+            throw new IOException("The character has more than one equipped cape");
+        return List.copyOf(references);
+    }
+
+    static BedrockPersonaCape read(
+            final BedrockCharacterProfiles.Slot slot,
+            final Map<String, BedrockMarketplaceAssets.Pack> packs)
+            throws IOException {
+        BedrockPersonaCape cape = null;
+        for (final var pack : packs.values()) {
+            if (BedrockPersonaSources.metadata(pack).stream()
+                    .noneMatch(
+                            metadata ->
+                                    "persona_capes"
+                                            .equals(metadata.get("piece_type").getAsString())))
+                continue;
+            final var textures =
+                    BedrockPersonaSources.read(
+                                    pack, source -> BedrockPersonaSources.matches(source, slot))
+                            .stream()
+                            .filter(
+                                    texture ->
+                                            "persona_capes"
+                                                    .equals(
+                                                            texture.metadata()
+                                                                    .get("piece_type")
+                                                                    .getAsString()))
+                            .toList();
+            if (textures.isEmpty()) continue;
+            final var recipes = BedrockPersonaSources.recipes(pack, slot);
+            if (cape != null || recipes.size() != 1 || textures.size() != 1)
+                throw new IOException("The equipped cape assets are ambiguous");
+            cape = new BedrockPersonaCape(pack.id(), textures.getFirst(), recipes.getFirst(), slot);
+        }
+        return cape;
+    }
+
+    BufferedImage image() throws IOException {
+        return BedrockPersonaTint.apply(
+                texture, BedrockPersonaTint.palette(texture, slot, recipe, 0));
+    }
+
+    void bind(
+            final Map<String, JsonObject> equipped,
+            final JsonObject library,
+            final int x,
+            final int y,
+            final int atlasSize)
+            throws IOException {
+        if (library == null) throw new IOException("The licensed game package has no cape model");
+        if (texture.frames() != 1)
+            throw new IOException("The cape needs animated texture assembly");
+        final var normalized = BedrockClassicModel.read("{}", "geometry.cape", name -> library);
+        final JsonObject model =
+                JsonParser.parseString(normalized.geometry())
+                        .getAsJsonObject()
+                        .getAsJsonArray("minecraft:geometry")
+                        .get(0)
+                        .getAsJsonObject();
+        final Map<String, JsonObject> source = new LinkedHashMap<>();
+        for (final var element : model.getAsJsonArray("bones")) {
+            final JsonObject bone = BedrockPersonaGeometry.canonical(element.getAsJsonObject());
+            source.put(bone.get("name").getAsString(), bone);
+        }
+        final JsonObject authoredBody = source.get("body"), body = equipped.get("body");
+        if (authoredBody == null || body == null || !source.containsKey("cape"))
+            throw new IOException("The cape model has no body attachment");
+        final float[] offset = new float[3];
+        for (int axis = 0; axis < 3; axis++)
+            offset[axis] = pivot(body, axis) - pivot(authoredBody, axis);
+        final JsonObject description = model.getAsJsonObject("description");
+        final float scaleU =
+                (float) texture.image().getWidth() / description.get("texture_width").getAsInt();
+        final float scaleV =
+                (float) texture.image().getHeight() / description.get("texture_height").getAsInt();
+        for (final var bone : source.values()) {
+            String ancestor = bone.get("name").getAsString();
+            while (!ancestor.equals("cape") && source.containsKey(ancestor)) {
+                final var parent = source.get(ancestor).get("parent");
+                ancestor = parent == null ? "" : parent.getAsString();
+            }
+            if (!ancestor.equals("cape")) continue;
+            final String name = bone.get("name").getAsString();
+            if (equipped.containsKey(name))
+                throw new IOException("The cape conflicts with an equipped bone");
+            if (!bone.has("parent") || !equipped.containsKey(bone.get("parent").getAsString()))
+                throw new IOException("The cape has an unavailable parent bone");
+            translate(bone.getAsJsonArray("pivot"), offset);
+            if (bone.has("locators"))
+                for (final var locator : bone.getAsJsonObject("locators").entrySet()) {
+                    final var value = locator.getValue();
+                    translate(
+                            value.isJsonArray()
+                                    ? value.getAsJsonArray()
+                                    : value.getAsJsonObject().getAsJsonArray("offset"),
+                            offset);
+                }
+            if (bone.has("poly_mesh"))
+                for (final var position :
+                        bone.getAsJsonObject("poly_mesh").getAsJsonArray("positions"))
+                    translate(position.getAsJsonArray(), offset);
+            if (bone.has("cubes"))
+                for (final var element : bone.getAsJsonArray("cubes")) {
+                    final var cube = element.getAsJsonObject();
+                    translate(cube.getAsJsonArray("origin"), offset);
+                    translate(cube.getAsJsonArray("pivot"), offset);
+                    scaleCubeUvs(cube, bone, scaleU, scaleV);
+                }
+            BedrockPersonaGeometry.mapUvs(
+                    bone, texture.image().getWidth(), texture.image().getHeight(), x, y, atlasSize);
+            equipped.put(name, bone);
+        }
+    }
+
+    private static float pivot(final JsonObject bone, final int axis) {
+        return bone.has("pivot") ? bone.getAsJsonArray("pivot").get(axis).getAsFloat() : 0;
+    }
+
+    private static void translate(final JsonArray position, final float[] offset)
+            throws IOException {
+        if (position == null) return;
+        if (position.size() != 3) throw new IOException("The cape model has an invalid position");
+        for (int axis = 0; axis < 3; axis++)
+            position.set(axis, new JsonPrimitive(position.get(axis).getAsFloat() + offset[axis]));
+    }
+
+    private static void scaleCubeUvs(
+            final JsonObject cube, final JsonObject bone, final float scaleU, final float scaleV)
+            throws IOException {
+        if (!cube.has("uv")) return;
+        if (cube.get("uv").isJsonArray()) {
+            final JsonArray size = cube.getAsJsonArray("size"), uv = cube.getAsJsonArray("uv");
+            if (size.size() != 3 || uv.size() != 2)
+                throw new IOException("The cape cube has invalid UV coordinates");
+            final boolean mirror =
+                    cube.has("mirror")
+                            ? cube.get("mirror").getAsBoolean()
+                            : bone.has("mirror") && bone.get("mirror").getAsBoolean();
+            final var box =
+                    UVMap.fromBoxUV(
+                            new Position3V(
+                                    size.get(0).getAsFloat(),
+                                    size.get(1).getAsFloat(),
+                                    size.get(2).getAsFloat()),
+                            new Float[] {uv.get(0).getAsFloat(), uv.get(1).getAsFloat()},
+                            mirror);
+            final JsonObject faces = new JsonObject();
+            for (final var direction : Direction.values()) {
+                final Float[] face = box.getUvMap().get(direction);
+                // Native box UVs reverse both axes on the top and only V on the bottom.
+                final boolean flipU = direction == Direction.UP;
+                final boolean flipV = direction == Direction.UP || direction == Direction.DOWN;
+                final float u = flipU ? face[2] : face[0], v = flipV ? face[3] : face[1];
+                final JsonObject mapped = new JsonObject();
+                mapped.add("uv", pair(u, v));
+                mapped.add(
+                        "uv_size",
+                        pair((flipU ? face[0] : face[2]) - u, (flipV ? face[1] : face[3]) - v));
+                faces.add(direction.name().toLowerCase(Locale.ROOT), mapped);
+            }
+            cube.add("uv", faces);
+        }
+        for (final var entry : cube.getAsJsonObject("uv").entrySet())
+            for (final String field : List.of("uv", "uv_size")) {
+                final var value = entry.getValue().getAsJsonObject().getAsJsonArray(field);
+                if (value == null || value.size() != 2)
+                    throw new IOException("The cape cube has invalid face UV coordinates");
+                value.set(0, new JsonPrimitive(value.get(0).getAsFloat() * scaleU));
+                value.set(1, new JsonPrimitive(value.get(1).getAsFloat() * scaleV));
+            }
+    }
+
+    private static JsonArray pair(final float u, final float v) {
+        final JsonArray pair = new JsonArray();
+        pair.add(u);
+        pair.add(v);
+        return pair;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaColors.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaColors.java
