+    void unpacksModelArchivesUnderTheirLibraryRoot(final String pack) throws Exception {
+        final String root = "library/" + pack + "/";
+        Files.createDirectories(directory.resolve(root + "__brarchive/models"));
+        Files.write(directory.resolve(root + "__brarchive/models/entity.brarchive"), archive());
+        final var unpacked = BedrockBuiltinAssets.unpack(directory);
+        assertArrayEquals(new byte[] {1, 2, 3}, unpacked.get(root + "models/entity/nested/one"));
+        assertEquals(2, unpacked.size());
