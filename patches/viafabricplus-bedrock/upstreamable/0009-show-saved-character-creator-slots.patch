+final class BedrockBoneAnimationTest {
+    private static BedrockBoneAnimation animation(final String json) throws IOException {
+        return BedrockBoneAnimation.parse(JsonParser.parseString(json).getAsJsonObject());
+    }
+
+    @Test
+    void interpolatesIncomingPreAndOutgoingPostWithAnExactDiscontinuity() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"animation_length":2,"bones":{"head":{"position":{
+                                  "0":[0,0,0],"1":{"pre":[2,4,6],"post":[10,20,30]},"2":[12,24,36]
+                                }}}}
+                                """)
+                        .playback();
+        assertEquals(
+                new BedrockBoneAnimation.Vector(1, 2, 3),
+                playback.sample(.5F, Map.of()).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(10, 20, 30),
+                playback.sample(1, Map.of()).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(11, 22, 33),
+                playback.sample(1.5F, Map.of()).get("head").position());
+    }
+
+    @Test
+    void samplesSplineControlPointsAndScaleWithoutExtendingThePlaybackLength() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"animation_length":2,"bones":{"body":{"position":{
+                                  "0":[0,0,0],"1":[0,0,0],"2":{"post":[8,0,0],"lerp_mode":"catmullrom"},"3":[8,0,0]
+                                },"scale":2}}}
+                                """)
+                        .playback();
+        assertEquals(4, playback.sample(1.5F, Map.of()).get("body").position().x());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(2, 2, 2),
+                playback.sample(2, Map.of()).get("body").scale());
+    }
+
+    @Test
+    void keepsVariablesActorLocalAndExposesAnimationTimeQueries() throws Exception {
+        final var definition =
+                animation(
+                        """
+                        {"animation_length":5,"anim_time_update":"q.anim_time + q.delta_time * 2", "bones":{
+                          "head":{"position":["v.calls = (v.calls ?? 0) + 1; return v.calls;","q.anim_time","q.custom"]}
+                        }}
+                        """);
+        final var first = definition.playback();
+        assertEquals(
+                new BedrockBoneAnimation.Vector(1, 1, 7),
+                first.sample(.5F, Map.of("custom", 7F)).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(2, 2, 0),
+                first.sample(1, Map.of()).get("head").position());
+        assertEquals(1, definition.playback().sample(1, Map.of()).get("head").position().x());
+    }
+
+    @Test
+    void wrapsLoopsAndBlendsScaleFromOne() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"loop":true,"animation_length":2,"blend_weight":0.5,
+                                 "bones":{"head":{"rotation":["q.anim_time * 90",0,0],"scale":3}}}
+                                """)
+                        .playback();
+        final var transform = playback.sample(2.5F, Map.of()).get("head");
+        assertEquals(22.5F, transform.rotation().x());
+        assertEquals(new BedrockBoneAnimation.Vector(2, 2, 2), transform.scale());
+    }
+
+    @Test
+    void waitsForTheInitialDelayAndRetainsOnlyAnOvershootingFramesRemainder() throws Exception {
+        final var definition =
+                animation(
+                        """
+                        {"animation_length":2,"start_delay":"v.starts=(v.starts??0)+1;return 0.75;",
+                         "bones":{"head":{"position":["q.anim_time","v.starts","q.delta_time"]}}}
+                        """);
+        final var player = definition.playback();
+        assertTrue(player.sample(0, Map.of()).isEmpty());
+        assertTrue(player.sample(0.5F, Map.of()).isEmpty());
+        assertFalse(player.completed());
+        assertEquals(new BedrockBoneAnimation.Vector(0.25F, 1, 0.25F),
+                player.sample(1, Map.of()).get("head").position());
+        assertEquals(new BedrockBoneAnimation.Vector(0.5F, 1, 0.25F),
+                player.sample(1.25F, Map.of()).get("head").position());
+        assertEquals(1, definition.playback().sample(1, Map.of()).get("head").position().y());
+    }
+
+    @Test
+    void preservesNativeExactDelayAndLoopBoundariesAndPersistentCompletion() throws Exception {
+        final var player =
+                animation(
+                                """
+                                {"loop":true,"animation_length":1,"start_delay":0.5,
+                                 "loop_delay":"v.loops=(v.loops??0)+1;return 0.5;",
+                                 "bones":{"head":{"position":["q.anim_time","v.loops??0","q.delta_time"]}}}
+                                """)
+                        .playback();
+        assertTrue(player.sample(0, Map.of()).isEmpty());
+        assertEquals(new BedrockBoneAnimation.Vector(0.5F, 0, 0.5F),
+                player.sample(0.5F, Map.of()).get("head").position());
+        assertEquals(new BedrockBoneAnimation.Vector(1, 1, 0.5F),
+                player.sample(1, Map.of()).get("head").position());
+        assertTrue(player.completed());
+        assertFalse(player.stopped());
+        assertTrue(player.sample(1.25F, Map.of()).isEmpty());
+        final var restarted = player.sample(1.75F, Map.of()).get("head").position();
+        assertEquals(0.25F, restarted.x());
+        assertEquals(2, restarted.y());
+        assertEquals(0.25F, restarted.z());
+        assertTrue(player.sample(2, Map.of()).isEmpty());
+        assertEquals(3, player.sample(2.5F, Map.of()).get("head").position().y());
+    }
+
+    @Test
+    void usesTheWrappedClockForMolangAndDoesNotAdvanceRepeatedRenderPasses() throws Exception {
+        final var player =
+                animation(
+                                """
+                                {"loop":true,"animation_length":1,"anim_time_update":"q.anim_time+q.delta_time*2",
+                                 "bones":{"head":{"position":["q.anim_time","v.frames=(v.frames??0)+1;return v.frames;",0]}}}
+                                """)
+                        .playback();
+        assertEquals(0.5F, player.sample(0.25F, Map.of()).get("head").position().x());
+        final var boundary = player.sample(0.5F, Map.of());
+        assertEquals(1, boundary.get("head").position().x());
+        assertSame(boundary, player.sample(0.5F, Map.of()));
+        assertEquals(new BedrockBoneAnimation.Vector(0.5F, 3, 0),
+                player.sample(0.75F, Map.of()).get("head").position());
+        assertEquals(1, player.sample(1, Map.of()).get("head").position().x());
+    }
+
+    @Test
+    void freezesTheClockAndDelayWhileTheTrackHasNoBlendWeight() throws Exception {
+        final var player =
+                animation(
+                                """
+                                {"animation_length":2,"blend_weight":"q.enabled","start_delay":0.25,
+                                 "bones":{"head":{"position":["q.anim_time",0,0]}}}
+                                """)
+                        .playback();
+        assertTrue(player.sample(1, Map.of()).isEmpty());
+        assertTrue(player.sample(1.125F, Map.of("enabled", 1)).isEmpty());
+        assertTrue(player.sample(2, Map.of()).isEmpty());
+        assertEquals(0.125F, player.sample(2.25F, Map.of("enabled", 1))
+                .get("head").position().x());
+    }
+
+    @Test
+    void stopsAfterTheFinalFrameButKeepsHeldTracksAndReevaluatesDelaysOnRestart() throws Exception {
+        final var player =
+                animation(
+                                """
+                                {"animation_length":1,"start_delay":"v.starts=(v.starts??0)+1;return 0.25;",
+                                 "bones":{"head":{"position":["q.anim_time","v.starts",0]}}}
+                                """)
+                        .playback();
+        assertEquals(1, player.sample(1.25F, Map.of()).get("head").position().x());
+        assertTrue(player.completed());
+        assertFalse(player.stopped());
+        assertTrue(player.sample(1.5F, Map.of()).isEmpty());
+        assertTrue(player.stopped());
+        assertTrue(player.sample(0, Map.of()).isEmpty());
+        assertFalse(player.completed());
+        assertFalse(player.stopped());
+        assertEquals(2, player.sample(0.5F, Map.of()).get("head").position().y());
+        final var held =
+                animation(
+                                """
+                                {"loop":"hold_on_last_frame","animation_length":1,
+                                 "bones":{"head":{"position":["q.anim_time",0,0]}}}
+                                """)
+                        .playback();
+        assertEquals(1, held.sample(2, Map.of()).get("head").position().x());
+        assertTrue(held.completed());
+        assertFalse(held.stopped());
+        assertEquals(1, held.sample(3, Map.of()).get("head").position().x());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ANIMATION_CLOCK_RESULT", matches = ".+")
+    void matchesIndependentTargetGameClockExecution() throws Exception {
+        final var cases = JsonParser.parseString(Files.readString(
+                Path.of(System.getenv("STACKANVIL_ANIMATION_CLOCK_RESULT")))).getAsJsonArray();
+        for (final var element : cases) {
+            final var data = element.getAsJsonObject();
+            final var config = data.getAsJsonObject("config");
+            final var source =
+                    JsonParser.parseString(
+                                    """
+                                    {"animation_length":1,"bones":{"head":{"position":["q.anim_time","v.starts","v.loops??0"]}}}
+                                    """)
+                            .getAsJsonObject();
+            source.addProperty("start_delay", "v.starts=(v.starts??0)+1;return "
+                    + (config.has("start") ? config.get("start").getAsFloat() : 0) + ";");
+            source.addProperty("loop_delay", "v.loops=(v.loops??0)+1;return "
+                    + (config.has("loop_delay") ? config.get("loop_delay").getAsFloat() : 0) + ";");
+            source.addProperty("anim_time_update", "q.anim_time+q.delta_time*"
+                    + (config.has("speed") ? config.get("speed").getAsFloat() : 1));
+            final int mode = config.has("loop") ? config.get("loop").getAsInt() : 0;
+            if (mode == 2) source.addProperty("loop", "hold_on_last_frame");
+            else source.addProperty("loop", mode == 1);
+            final var player = BedrockBoneAnimation.parse(source).playback();
+            float elapsed = 0;
+            for (final var frame : data.getAsJsonArray("steps")) {
+                final var expected = frame.getAsJsonObject();
+                elapsed += expected.get("delta").getAsFloat();
+                final var pose = player.sample(elapsed, Map.of());
+                assertEquals(expected.get("completed").getAsInt() == 1, player.completed());
+                assertEquals(expected.get("sampled").getAsBoolean(), !pose.isEmpty());
+                if (pose.isEmpty()) continue;
+                final var position = pose.get("head").position();
+                assertEquals(expected.get("clock").getAsFloat(), position.x(), 0.000001F);
+                final var calls = expected.getAsJsonObject("calls");
+                assertEquals(calls.get("start").getAsInt(), position.y());
+                assertEquals(calls.get("loop").getAsInt(), position.z());
+            }
+        }
+    }
+
+    @Test
+    void capsNativeLoopsAndBoundsNestedExecution() throws Exception {
+        final var definition =
+                animation(
