+    private void renderWardrobe(final GuiGraphicsExtractor graphics, final int left, final int top) {
+        final int gridLeft = this.gridLeft();
+        final int gridTop = this.gridTop();
+        if (this.items == null) {
+            graphics.textWithWordWrap(this.font, Component.translatable(this.itemsFailed
+                ? "bedrock_character_slots.viafabricplus.items_failed" : "bedrock_character_slots.viafabricplus.items_loading"),
+                gridLeft, top, this.gridWidth(), ACCENT_COLOR);
+            return;
+        }
+        if (!this.compactCategories()) {
+            graphics.text(this.font, Component.literal(this.category.label() + " (" + this.items.size() + ")"), gridLeft, top, -1);
+        }
+        if (this.items.isEmpty()) {
+            graphics.textWithWordWrap(this.font, Component.translatable("bedrock_character_slots.viafabricplus.no_pieces"),
+                gridLeft, gridTop, this.gridWidth(), ACCENT_COLOR);
+            return;
+        }
+        final int pageSize = this.pageSize();
+        final int pages = (this.items.size() + pageSize - 1) / pageSize;
+        graphics.text(this.font, Component.literal((this.itemPage + 1) + " / " + pages),
+            gridLeft + this.gridWidth() - 42, top, ACCENT_COLOR);
+        for (int index = this.itemPage * pageSize; index < Math.min(this.items.size(), (this.itemPage + 1) * pageSize); index++) {
+            final WardrobeItem item = this.items.get(index);
+            final int offset = index - this.itemPage * pageSize;
+            final int x = gridLeft + offset % this.gridColumns() * 70;
+            final int y = gridTop + offset / this.gridColumns() * 72;
+            final Slot slot = this.wardrobe.slots().get(this.selectedSlot);
+            final int border = index == this.selectedItem ? 0xFFFFFFFF
+                : this.isEquipped(item, slot) ? 0xFF67C878 : this.isSaved(item) ? 0xFF719ED2 : 0xFF646464;
+            graphics.fill(x, y, x + 64, y + 64, border);
+            graphics.fill(x + 2, y + 2, x + 62, y + 62, 0xFF202428);
+            BedrockImageCache.drawRemote(graphics, item.thumbnailUrl(), x + 4, y + 4, 56, 56);
+        }
+        final WardrobeItem item = this.items.get(this.selectedItem);
+        final int detailLeft = gridLeft + this.gridWidth() + 16;
+        final int detailWidth = Math.max(120, this.width - detailLeft - this.wardrobeLeft());
+        final boolean compact = this.compactDetails();
+        final boolean showAvatar = !compact && this.wardrobe.activeSlot() == this.selectedSlot + 1
+            && this.activeAvatar != null && detailWidth >= 220;
+        final int statusLeft = compact ? detailLeft + 40 : detailLeft;
+        final int statusTop = top + (compact ? 32 : 152);
+        final int statusWidth = compact ? detailWidth - 40 : showAvatar ? detailWidth - 116 : detailWidth;
+        graphics.textWithWordWrap(this.font, Component.literal(item.name()), detailLeft, top, detailWidth, -1);
+        graphics.text(this.font, Component.translatable("bedrock_character_slots.viafabricplus.item_number",
