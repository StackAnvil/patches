+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Locale;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.model.SkinData.PersonaPieceData;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.persona_PieceType;
+import net.raphimc.viabedrock.protocol.model.SkinData.PersonaPieceTintData;
+
+/** Resolves account recipes into the persona handles and tints sent by Bedrock 1.26.51. */
+public record BedrockPersonaProfile(List<PersonaPieceData> pieces, List<PersonaPieceTintData> tints) {
+    private static final String DEFAULT_PACK = "2099de18-429a-465a-a49b-fc4710a17bb3";
+    private static final Map<String, String> DEFAULT_TYPES = defaultTypes();
+
+    public BedrockPersonaProfile {
+        pieces = List.copyOf(pieces);
+        tints = tints.stream().map(tint -> new PersonaPieceTintData(tint.type(), List.copyOf(tint.colors()))).toList();
+    }
+
+    public static BedrockPersonaProfile from(final BedrockCharacterProfiles.Slot slot,
+                                             final List<BedrockCharacterProfiles.WardrobeItem> catalog) throws IOException {
+        final List<PersonaPieceData> pieces = new ArrayList<>();
+        final List<PersonaPieceTintData> tints = new ArrayList<>();
+        for (final JsonElement element : slot.profile().getAsJsonObject("personaCollection").getAsJsonArray("universalApp")) {
+            final JsonObject entry = element.getAsJsonObject();
+            if (!entry.has("id")) {
+                continue;
+            }
+            final String recipeId = entry.get("id").getAsString();
+            if (recipeId.endsWith("/e") || recipeId.endsWith("/de") || recipeId.matches("[0-9a-fA-F-]{36}\\.[0-9]+")) {
+                continue; // Emotes and classic capes have separate packet fields.
+            }
+            final boolean builtin = recipeId.endsWith("/d");
+            final String id = recipeId.split("/", 2)[0];
+            final String type;
+            final String pack;
+            final String product;
+            if (builtin) {
+                type = DEFAULT_TYPES.get(id);
+                pack = DEFAULT_PACK;
+                product = "";
+            } else {
+                final var item = catalog.stream().filter(candidate -> candidate.matches(recipeId)).findFirst().orElse(null);
+                if (item == null) {
+                    throw new IOException("An equipped persona piece is missing from the account catalog");
+                }
+                type = item.type();
+                pack = item.packId();
+                product = item.id();
+            }
+            if ("persona_capes".equals(type) || "persona_emote".equals(type)) {
+                continue;
+            }
+            if (type == null || !type.startsWith("persona_")) {
+                throw new IOException("An equipped persona piece has no known type");
+            }
+            try {
+                UUID.fromString(id);
+                UUID.fromString(pack);
+            } catch (IllegalArgumentException e) {
+                throw new IOException("An equipped persona piece has an invalid ID", e);
+            }
+            final String packetType = "persona_arms".equals(type) || "persona_legs".equals(type)
+                ? BedrockLimbSide.fromRecipe(recipeId).packetType(type) : packetType(type);
+            pieces.add(new PersonaPieceData(id, packetType, pack, builtin, product));
+            if (entry.has("col")) {
+                final List<String> colors = new ArrayList<>();
+                for (final JsonElement color : entry.getAsJsonArray("col")) {
+                    final String value = color.getAsString();
+                    if (!value.matches("#(?:0|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})")) {
+                        throw new IOException("An equipped persona piece has an invalid tint");
+                    }
+                    colors.add(value);
+                }
+                if (colors.size() != 4) {
+                    throw new IOException("An equipped persona piece has an incomplete tint group");
+                }
+                tints.add(new PersonaPieceTintData(packetType, colors));
+            }
+        }
+        return new BedrockPersonaProfile(pieces, tints);
+    }
+
+    static String defaultType(final String id) {
+        return DEFAULT_TYPES.get(id);
+    }
+
+    private static String packetType(final String claim) throws IOException {
+        final String name = "persona_hand".equals(claim) ? "hands"
+            : claim.substring("persona_".length()).replace("_", "");
+        for (final var type : persona_PieceType.values()) {
+            if (type.name().replace("_", "").equalsIgnoreCase(name)) {
+                return type.name();
+            }
+        }
+        throw new IOException("An equipped persona piece has an unsupported type");
+    }
+
+    private static String claimType(final String packetType) {
+        if ("Hands".equals(packetType)) return "persona_hand";
+        return "persona_" + packetType.replaceAll("([a-z])([A-Z])", "$1_$2").toLowerCase(Locale.ROOT);
+    }
+
+    public List<Map<String, Object>> pieceClaims() {
+        return this.pieces.stream().map(piece -> Map.<String, Object>of("PieceId", piece.id(), "PieceType", claimType(piece.type()),
+            "PackId", piece.packId(), "IsDefault", piece.defaultPiece(), "ProductId", piece.productId())).toList();
+    }
+
+    public List<Map<String, Object>> tintClaims() {
+        return this.tints.stream().map(tint -> Map.<String, Object>of("PieceType", claimType(tint.type()), "Colors", tint.colors())).toList();
+    }
+
+    public JsonObject toJson() {
+        final JsonObject result = new JsonObject();
+        final JsonArray pieces = new JsonArray();
+        for (final var piece : this.pieces) {
+            final JsonObject item = new JsonObject();
+            item.addProperty("id", piece.id());
+            item.addProperty("type", piece.type());
+            item.addProperty("packId", piece.packId());
+            item.addProperty("default", piece.defaultPiece());
+            item.addProperty("productId", piece.productId());
+            pieces.add(item);
+        }
+        result.add("pieces", pieces);
+        final JsonArray tints = new JsonArray();
+        for (final var tint : this.tints) {
+            final JsonObject item = new JsonObject();
+            item.addProperty("type", tint.type());
+            final JsonArray colors = new JsonArray();
+            tint.colors().forEach(colors::add);
+            item.add("colors", colors);
+            tints.add(item);
+        }
+        result.add("tints", tints);
+        return result;
+    }
+
+    public static BedrockPersonaProfile fromJson(final JsonObject json) {
+        final List<PersonaPieceData> pieces = new ArrayList<>();
+        final List<PersonaPieceTintData> tints = new ArrayList<>();
+        for (final var element : json.getAsJsonArray("pieces")) {
+            final JsonObject item = element.getAsJsonObject();
+            pieces.add(new PersonaPieceData(item.get("id").getAsString(), item.get("type").getAsString(),
+                item.get("packId").getAsString(), item.get("default").getAsBoolean(), item.get("productId").getAsString()));
+        }
+        for (final var element : json.getAsJsonArray("tints")) {
+            final JsonObject item = element.getAsJsonObject();
+            final List<String> colors = new ArrayList<>();
+            item.getAsJsonArray("colors").forEach(color -> colors.add(color.getAsString()));
+            tints.add(new PersonaPieceTintData(item.get("type").getAsString(), colors));
+        }
+        return new BedrockPersonaProfile(pieces, tints);
+    }
+
+    private static Map<String, String> defaultTypes() {
+        try (final var stream = BedrockPersonaProfile.class.getResourceAsStream("/assets/viafabricplus-bedrock/persona-piece-types.json")) {
+            if (stream == null) {
+                throw new IllegalStateException("The built-in persona piece types are missing");
+            }
+            final JsonObject json = JsonParser.parseReader(new InputStreamReader(stream, StandardCharsets.UTF_8)).getAsJsonObject();
+            final Map<String, String> types = new LinkedHashMap<>();
+            json.entrySet().forEach(entry -> types.put(entry.getKey(), entry.getValue().getAsString()));
+            return Map.copyOf(types);
+        } catch (IOException e) {
+            throw new ExceptionInInitializerError(e);
+        }
+    }
+}
