+                        this.refreshCharacter(account);
+                        return;
+                    }
+                    this.saving = false;
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void deleteSelectedSlot() {
+        if (this.wardrobe != null && !this.wardrobe.slots().get(this.selectedSlot).occupied()) {
+            this.createCharacter(true, null);
+            return;
+        }
+        if (!this.confirmDelete) {
+            this.confirmDelete = true;
+            this.updateControls();
+            return;
+        }
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final Slot target = this.wardrobe.slots().get(this.selectedSlot);
+        final boolean deletingActive = this.wardrobe.activeSlot() == target.number();
+        this.confirmDelete = false;
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.deleteSlot(account, target.number(), target.profileHash())
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                if (error != null) {
+                    this.saving = false;
+                    this.selectionFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not delete Bedrock character", error);
+                } else {
+                    this.wardrobe = loaded;
+                    if (deletingActive) {
+                        this.loadAvatar(account);
+                        if (this.characterSelected) {
+                            this.refreshCharacter(account);
+                            return;
+                        }
+                    }
+                    this.saving = false;
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void refreshCharacter(final BedrockAuthManager account) {
+        try {
+            ViaFabricPlusBedrock.impl().appearances()
+                .select(BedrockAppearanceStore.accountId(account), Selection.STEVE);
+            this.characterSelected = false;
+            this.prepareCharacter(account);
+        } catch (java.io.IOException e) {
+            this.saving = false;
+            this.modelFailed = true;
+            ViaFabricPlusBedrock.impl().logger().warn("Could not retire the previous account character", e);
+            this.updateControls();
+        }
+    }
+
+    private void prepareCharacter(final BedrockAuthManager account) {
+        this.saving = true;
+        this.modelFailed = false;
+        this.updateControls();
+        final BedrockAppearanceStore store = ViaFabricPlusBedrock.impl().appearances();
+        final String accountId = BedrockAppearanceStore.accountId(account);
+        BedrockCharacterProfiles.loadActiveModel(account).whenComplete((prepared, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this || !accountId.equals(BedrockAppearanceStore.accountId(
+                    ViaFabricPlusBedrock.impl().account().get()))) {
+                return;
+            }
+            this.saving = false;
+            if (error != null) {
+                this.modelFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not use Bedrock account character in worlds", error);
+            } else {
+                try {
+                    prepared.importInto(store, accountId);
+                    this.characterSelected = true;
+                } catch (java.io.IOException e) {
+                    this.modelFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not save the account character", e);
+                }
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void refresh() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.loading || this.saving) {
+            return;
+        }
+        this.loading = true;
+        this.purchaseStatus = Component.translatable("bedrock_marketplace.viafabricplus.synchronizing");
+        this.colorContext = null;
+        this.availableColors = List.of();
+        this.colorsLoading = false;
+        this.colorRequest++;
+        this.updateControls();
+        this.failed = false;
+        this.selectionFailed = false;
+        this.modelFailed = false;
+        this.confirmDelete = false;
+        BedrockMarketplaceTransactions.redeemXbox(account).whenComplete((result, error) -> this.minecraft.execute(() -> {
+            if (ViaFabricPlusBedrock.impl().account().get() != account || this.minecraft.gui.screen() != this) {
+                this.loading = false;
+                this.purchaseStatus = null;
+                return;
+            }
+            if (error != null) {
+                this.purchaseStatus = Component.translatable("bedrock_marketplace.viafabricplus.sync_failed");
+                ViaFabricPlusBedrock.impl().logger().warn("Could not synchronize Microsoft Store purchases", error);
+            } else {
+                this.purchaseStatus = result.failed() == 0 ? null
+                    : Component.translatable("bedrock_marketplace.viafabricplus.sync_partial", result.failed());
+            }
+            this.wallet.refresh();
+            this.loadWardrobe(account);
+        }));
+    }
+
+    private void loadWardrobe(final BedrockAuthManager account) {
+        BedrockCharacterProfiles.load(account).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            this.loading = false;
+            if (this.minecraft.gui.screen() != this || ViaFabricPlusBedrock.impl().account().get() != account) {
+                return;
+            }
+            if (error != null) {
+                this.failed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character slots", error);
+            } else {
+                if (this.wardrobe == null && loaded.activeSlot() > 0
+                    && loaded.activeSlot() <= loaded.slots().size()) {
+                    this.selectedSlot = loaded.activeSlot() - 1;
+                }
+                this.wardrobe = loaded;
+                try {
+                    final var appearance = ViaFabricPlusBedrock.impl().appearances()
+                        .load(BedrockAppearanceStore.accountId(account));
+                    this.characterSelected = loaded.activeSlot() > 0
+                        && ViaFabricPlusBedrock.impl().appearances().usesAccountCharacter(
+                            BedrockAppearanceStore.accountId(account), loaded.slots().get(loaded.activeSlot() - 1));
+                    if (appearance.selection() == Selection.PERSONA && !this.characterSelected) {
+                        ViaFabricPlusBedrock.impl().appearances()
+                            .select(BedrockAppearanceStore.accountId(account), Selection.STEVE);
+                        this.modelFailed = true;
+                    }
+                } catch (java.io.IOException e) {
+                    this.characterSelected = false;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not load selected Bedrock character model", e);
+                }
+                this.items = null;
+                this.loadedCategory = null;
+                this.itemsFailed = false;
+                this.updateControls();
+                this.loadAvatar(account);
+                if (this.view == View.WARDROBE) {
+                    this.loadCategory();
+                }
+            }
+        }));
+    }
+
+}
