+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockControllerSoundTest.java
@@ -0,0 +1,150 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockControllerSoundTest {
+    @Test
+    void queuesControllerEntriesAfterTheirChildTimelines() throws Exception {
+        final var playback = graph(new JsonObject(), true).playback();
+        final List<BedrockActorAnimation.SoundCue> sounds = new ArrayList<>();
+        playback.sample(0, frame(false, 1), true, sounds::add);
+        assertEquals(List.of("child", "hand0"), sounds.stream().map(BedrockActorAnimation.SoundCue::locator).toList());
+        sounds.clear();
+        playback.sample(.25F, frame(true, 1), true, sounds::add);
+        assertEquals(List.of("child", "hand1"), sounds.stream().map(BedrockActorAnimation.SoundCue::locator).toList());
+        playback.sample(.25F, frame(true, 1), true, sounds::add);
+        assertEquals(2, sounds.size());
+    }
+
+    @Test
+    void consumesSuppressedEntriesAndTheirScriptsWithoutCatchup() throws Exception {
+        final var playback = graph(new JsonObject(), false).playback();
+        final List<BedrockActorAnimation.SoundCue> sounds = new ArrayList<>();
+        var pose = playback.sample(0, frame(false, 1), false, sounds::add);
+        assertEquals(new BedrockBoneAnimation.Vector(0, 0, 0), pose.get("head").position());
+        pose = playback.sample(.25F, frame(false, 1), true, sounds::add);
+        assertTrue(sounds.isEmpty());
+        assertEquals(new BedrockBoneAnimation.Vector(0, 0, 0), pose.get("head").position());
+        pose = playback.sample(.5F, frame(true, 1), true, sounds::add);
+        assertEquals(new BedrockBoneAnimation.Vector(0, 1, 1), pose.get("head").position());
+        assertEquals(1, sounds.size());
+        sounds.clear();
+        playback.sample(0, frame(false, 1), true, sounds::add);
+        assertEquals(1, sounds.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_EVENTS", matches = ".+")
+    void matchesNativeStateSoundQueuesAndScriptGates() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_SOUND_EVENTS"));
+        final var cases = json(Files.readString(root.resolve("native-controller-sound-result.json"))).getAsJsonArray("cases");
+        for (final var element : cases) {
+            final JsonObject config = element.getAsJsonObject();
+            final var playback = graph(config, false).playback();
+            final int[] scriptCalls = new int[4];
+            float elapsed = 0;
+            for (final var value : config.getAsJsonArray("frames")) {
+                final JsonObject nativeFrame = value.getAsJsonObject();
+                elapsed += nativeFrame.get("delta").getAsFloat();
+                final float weight = nativeFrame.get("weight").getAsFloat();
+                final boolean enabled = nativeFrame.get("events_enabled").getAsBoolean()
+                        && nativeFrame.get("actor").getAsBoolean();
+                final List<BedrockActorAnimation.SoundCue> sounds = new ArrayList<>();
+                final var pose = playback.sample(elapsed, frame(nativeFrame.get("switch").getAsBoolean(), weight), enabled, sounds::add);
+                final var expected = nativeFrame.getAsJsonArray("sounds");
+                assertEquals(expected.size(), sounds.size(), config.toString());
+                for (int index = 0; index < sounds.size(); index++) {
+                    final var sound = expected.get(index).getAsJsonObject();
+                    assertEquals(sound.get("sound").getAsString(), sounds.get(index).event());
+                    assertEquals(sound.get("locator").getAsString(), sounds.get(index).locator());
+                }
+                nativeFrame.getAsJsonArray("script_calls").forEach(marker -> scriptCalls[marker.getAsInt()]++);
+                if (weight > 0) {
+                    assertEquals(scriptCalls[0] * weight, pose.get("head").position().x(), .00001F);
+                    assertEquals(scriptCalls[1] * weight, pose.get("head").position().y(), .00001F);
+                    assertEquals(scriptCalls[2] * weight, pose.get("head").position().z(), .00001F);
+                    assertEquals(scriptCalls[3] * weight, pose.get("waist").position().x(), .00001F);
+                } else assertTrue(pose.isEmpty());
+            }
+        }
+    }
+
+    private static BedrockActorAnimation.Frame frame(final boolean transition, final float weight) {
+        return new BedrockActorAnimation.Frame(Map.of("switch", transition, "weight", weight), Map.of());
+    }
+
+    private static BedrockActorAnimation graph(final JsonObject config, final boolean timeline) throws IOException {
+        final JsonObject entity = json("""
+                {"animations":{"root":"controller.animation.test","a":"animation.a","b":"animation.b"},
+                 "scripts":{"animate":[{"root":"q.weight"}]}}
+                """);
+        if ((!config.has("alias") || config.get("alias").getAsBoolean())
+                && (!config.has("binding") || config.get("binding").getAsBoolean()))
+            entity.add("sound_effects", json("{\"clang\":\"emote.clang\"}"));
+        final JsonObject body = json("""
+                {"animation_length":5,"bones":{
+                 "head":{"position":["v.entry0??0","v.exit0??0","v.entry1??0"]},
+                 "waist":{"position":["v.exit1??0",0,0]}}}
+                """);
+        if (timeline) body.add("sound_effects", json("{\"0\":{\"effect\":\"clang\",\"locator\":\"child\"}}"));
+        final JsonObject animations = new JsonObject();
+        animations.add("animation.a", body);
+        animations.add("animation.b", body.deepCopy());
+        final JsonObject states = new JsonObject();
+        for (int index = 0; index < 2; index++) {
+            final JsonObject state = new JsonObject();
+            final JsonArray tracks = new JsonArray();
+            tracks.add(index == 0 ? "a" : "b");
+            state.add("animations", tracks);
+            final JsonArray entry = new JsonArray(), exit = new JsonArray();
+            entry.add("v.entry" + index + "=(v.entry" + index + "??0)+1;");
+            exit.add("v.exit" + index + "=(v.exit" + index + "??0)+1;");
+            state.add("on_entry", entry);
+            state.add("on_exit", exit);
+            if (index == 0 || config.has("reverse")) {
+                final String target = index == 1 || config.has("self_transition")
+                        && config.get("self_transition").getAsBoolean() ? "default" : "done";
+                final JsonObject transition = new JsonObject();
+                transition.addProperty(target, "q.switch");
+                final JsonArray transitions = new JsonArray();
+                transitions.add(transition);
+                state.add("transitions", transitions);
+            }
+            if (index == 0 && config.has("blend") && config.get("blend").getAsBoolean())
+                state.addProperty("blend_transition", 1);
+            final JsonArray sounds = new JsonArray();
+            final int count = index == 0 && config.has("source_order") ? config.get("source_order").getAsInt() : 1;
+            for (int sound = 0; sound < count; sound++) {
+                final JsonObject effect = new JsonObject();
+                effect.addProperty("effect", "clang");
+                effect.addProperty("locator", "hand" + (config.has("source_order") && index == 0 ? sound : index));
+                sounds.add(effect);
+            }
+            state.add("sound_effects", sounds);
+            states.add(index == 0 ? "default" : "done", state);
+        }
+        final JsonObject controller = new JsonObject();
+        controller.add("states", states);
+        final JsonObject controllers = new JsonObject();
+        controllers.add("controller.animation.test", controller);
+        return BedrockActorAnimation.read(entity, Map.of(), animations, controllers,
+                config.has("legacy") && config.get("legacy").getAsBoolean() ? "1.10.0" : "1.18.10");
+    }
+
+    private static JsonObject json(final String text) {
+        return JsonParser.parseString(text).getAsJsonObject();
+    }
+}
