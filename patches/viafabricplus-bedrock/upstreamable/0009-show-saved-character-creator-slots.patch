+        Files.writeString(
+                root.resolve("manifest.json"),
+                "{\"header\":{\"uuid\":\"2099de18-429a-465a-a49b-fc4710a17bb3\"}}");
+        Files.createDirectories(root.resolve("library/vanilla/models"));
+        Files.writeString(
+                root.resolve("library/vanilla/models/mobs.json"),
+                "{\"geometry.humanoid\":{\"bones\":[{\"name\":\"body\"}]}}");
+        Files.createDirectories(root.resolve("pieces/test"));
+        Files.writeString(
+                root.resolve("pieces/test/test.meta.json"),
+                "{\"piece_id\":\"00000000-0000-0000-0000-000000000001\"}");
+        Files.write(root.resolve("pieces/test/texture.png"), new byte[] {1, 2, 3});
+    }
+
+    private static byte[] archive() {
+        final ByteBuffer bytes =
+                ByteBuffer.allocate(16 + 3 * 256 + 3).order(ByteOrder.LITTLE_ENDIAN);
+        bytes.putLong(0x267052A0B125277DL).putInt(3).putInt(1);
+        descriptor(bytes, 0, "nested/one", 0, 3);
+        descriptor(bytes, 1, "two", 0, 3);
+        descriptor(bytes, 2, "loose.png", 0, 0);
+        bytes.position(16 + 3 * 256);
+        bytes.put(new byte[] {1, 2, 3});
+        return bytes.array();
+    }
+
+    private static void descriptor(
+            final ByteBuffer bytes,
+            final int index,
+            final String name,
+            final int offset,
+            final int size) {
+        final byte[] encoded = name.getBytes(StandardCharsets.UTF_8);
+        bytes.position(16 + index * 256);
+        bytes.put((byte) encoded.length).put(encoded);
+        bytes.position(16 + index * 256 + 248);
+        bytes.putInt(offset).putInt(size);
+    }
+}
