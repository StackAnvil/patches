+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Immutable animation tracks with a separate Molang environment for each playback. */
+public final class BedrockBoneAnimation {
+    private final float length;
+    private final boolean loop;
+    private final boolean holdLastFrame;
+    private final boolean overridePose;
+    private final Map<String, Bone> bones;
+    private final BedrockMolang.Program blendWeight;
+    private final BedrockMolang.Program timeUpdate;
+
+    private BedrockBoneAnimation(
+            final float length,
+            final boolean loop,
+            final boolean holdLastFrame,
+            final boolean overridePose,
+            final Map<String, Bone> bones,
+            final BedrockMolang.Program blendWeight,
+            final BedrockMolang.Program timeUpdate) {
+        this.length = length;
+        this.loop = loop;
+        this.holdLastFrame = holdLastFrame;
+        this.overridePose = overridePose;
+        this.bones = bones;
+        this.blendWeight = blendWeight;
+        this.timeUpdate = timeUpdate;
+    }
+
+    public float length() {
+        return this.length;
+    }
+
+    public boolean loop() {
+        return this.loop;
+    }
+
+    public boolean holdLastFrame() {
+        return this.holdLastFrame;
+    }
+
+    public boolean overridePose() {
+        return this.overridePose;
+    }
+
+    private static final Vector ZERO = new Vector(0, 0, 0);
+    private static final Vector ONE = new Vector(1, 1, 1);
+
+    public static BedrockBoneAnimation parse(final JsonObject animation) throws IOException {
+        try {
+            for (final String field :
+                    List.of(
+                            "sound_effects",
+                            "particle_effects",
+                            "timeline",
+                            "start_delay",
+                            "loop_delay")) {
+                if (animation.has(field))
+                    throw new IOException("This animation needs effect or delay playback");
+            }
+            final JsonObject definitions = animation.getAsJsonObject("bones");
+            if (definitions == null || definitions.size() > 256)
+                throw new IOException("Invalid animation bone count");
+            final Map<String, Bone> bones = new LinkedHashMap<>();
+            float end = 0;
+            for (final var entry : definitions.entrySet()) {
+                final JsonObject definition = entry.getValue().getAsJsonObject();
+                if (definition.has("relative_to"))
+                    throw new IOException("This animation needs entity-relative bone rotation");
+                final Channel position = Channel.parse(definition.get("position"), ZERO);
+                final Channel rotation = Channel.parse(definition.get("rotation"), ZERO);
+                final Channel scale = Channel.parse(definition.get("scale"), ONE);
+                bones.put(entry.getKey(), new Bone(position, rotation, scale));
+                end =
+                        Math.max(
+                                end,
+                                Math.max(position.end(), Math.max(rotation.end(), scale.end())));
+            }
+            final float length =
+                    animation.has("animation_length")
+                            ? animation.get("animation_length").getAsFloat()
+                            : (end > 0 ? end : 1);
+            if (!Float.isFinite(length) || length <= 0 || length > 600)
+                throw new IOException("Invalid animation length");
+            final JsonElement looping = animation.get("loop");
+            final boolean hold =
+                    looping != null && "hold_on_last_frame".equals(looping.getAsString());
+            final boolean loop = looping != null && !hold && looping.getAsBoolean();
+            return new BedrockBoneAnimation(
+                    length,
+                    loop,
+                    hold,
+                    animation.has("override_previous_animation")
+                            && animation.get("override_previous_animation").getAsBoolean(),
+                    Map.copyOf(bones),
+                    BedrockMolang.Program.parse(animation.get("blend_weight"), 1),
+                    animation.has("anim_time_update")
+                            ? BedrockMolang.Program.parse(animation.get("anim_time_update"), 0)
+                            : null);
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid Bedrock bone animation", e);
+        }
+    }
+
+    public Playback playback() {
+        return new Playback();
+    }
+
+    public final class Playback {
+        private final BedrockMolang molang = new BedrockMolang();
+        private float previousElapsed;
+        private float clock;
+
+        public Map<String, Transform> sample(
+                final float elapsed, final Map<String, Float> queries) {
+            final float delta = Math.max(0, elapsed - this.previousElapsed);
+            this.molang.queries(queries, this.clock, elapsed, delta);
+            this.clock =
+                    timeUpdate == null
+                            ? Math.max(0, elapsed)
+                            : Math.max(0, this.molang.evaluate(timeUpdate, this.clock));
+            final float time = loop ? this.clock % length : Math.min(this.clock, length);
+            this.molang.queries(queries, time, elapsed, delta);
+            this.previousElapsed = elapsed;
+            final float weight = Math.clamp(this.molang.evaluate(blendWeight, 1), 0, 1);
+            final Map<String, Transform> result = new LinkedHashMap<>();
+            bones.forEach(
+                    (name, bone) ->
+                            result.put(
+                                    name,
+                                    new Transform(
+                                            bone.position()
+                                                    .sample(time, this.molang)
+                                                    .blend(ZERO, weight),
+                                            bone.rotation()
+                                                    .sample(time, this.molang)
+                                                    .blend(ZERO, weight),
+                                            bone.scale()
+                                                    .sample(time, this.molang)
+                                                    .blend(ONE, weight))));
+            return Map.copyOf(result);
+        }
+    }
+
+    public record Transform(Vector position, Vector rotation, Vector scale) {}
+
+    public record Vector(float x, float y, float z) {
+        private Vector blend(final Vector base, final float weight) {
+            return new Vector(
+                    base.x + (this.x - base.x) * weight,
+                    base.y + (this.y - base.y) * weight,
+                    base.z + (this.z - base.z) * weight);
+        }
+
+        private Vector interpolate(final Vector next, final float fraction) {
+            return next.blend(this, fraction);
+        }
+
+        private Vector catmull(
+                final Vector before, final Vector next, final Vector after, final float t) {
+            return new Vector(
+                    catmull(before.x, this.x, next.x, after.x, t),
+                    catmull(before.y, this.y, next.y, after.y, t),
+                    catmull(before.z, this.z, next.z, after.z, t));
+        }
+
+        private static float catmull(
+                final float a, final float b, final float c, final float d, final float t) {
+            return 0.5F
+                    * ((2 * b)
+                            + (-a + c) * t
+                            + (2 * a - 5 * b + 4 * c - d) * t * t
+                            + (-a + 3 * b - 3 * c + d) * t * t * t);
+        }
+    }
+
+    private record Bone(Channel position, Channel rotation, Channel scale) {}
+
+    private record Components(
+            BedrockMolang.Program x,
+            BedrockMolang.Program y,
+            BedrockMolang.Program z,
+            Vector fallback) {
+        private static Components parse(final JsonElement json, final Vector fallback)
+                throws IOException {
+            if (json == null) return new Components(null, null, null, fallback);
+            if (json.isJsonArray()) {
+                final var values = json.getAsJsonArray();
+                if (values.size() != 1 && values.size() != 3)
+                    throw new IOException("Invalid animation vector");
+                return new Components(
+                        BedrockMolang.Program.parse(values.get(0), fallback.x),
+                        BedrockMolang.Program.parse(
+                                values.get(values.size() == 1 ? 0 : 1), fallback.y),
+                        BedrockMolang.Program.parse(
+                                values.get(values.size() == 1 ? 0 : 2), fallback.z),
+                        fallback);
+            }
+            final var scalar = BedrockMolang.Program.parse(json, fallback.x);
+            return new Components(scalar, scalar, scalar, fallback);
+        }
+
+        private Vector evaluate(final BedrockMolang molang) {
+            return new Vector(
+                    molang.evaluate(this.x, this.fallback.x),
+                    molang.evaluate(this.y, this.fallback.y),
+                    molang.evaluate(this.z, this.fallback.z));
+        }
+    }
+
+    private record Keyframe(float time, Components pre, Components post, boolean catmull) {}
+
+    private record Channel(List<Keyframe> keyframes) {
+        private static Channel parse(final JsonElement json, final Vector fallback)
+                throws IOException {
+            if (json == null || !json.isJsonObject()) {
+                final Components value = Components.parse(json, fallback);
+                return new Channel(List.of(new Keyframe(0, value, value, false)));
+            }
+            final List<Keyframe> frames = new ArrayList<>();
+            for (final var entry : json.getAsJsonObject().entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 600)
+                    throw new IOException("Invalid animation key time");
+                Components pre, post;
+                boolean catmull = false;
+                if (entry.getValue().isJsonObject()) {
+                    final JsonObject frame = entry.getValue().getAsJsonObject();
+                    if (!frame.has("pre") && !frame.has("post"))
+                        throw new IOException("Empty animation keyframe");
+                    pre =
+                            Components.parse(
+                                    frame.has("pre") ? frame.get("pre") : frame.get("post"),
+                                    fallback);
+                    post =
+                            Components.parse(
+                                    frame.has("post") ? frame.get("post") : frame.get("pre"),
+                                    fallback);
+                    final String mode =
+                            frame.has("lerp_mode")
+                                    ? frame.get("lerp_mode").getAsString()
+                                    : "linear";
+                    if (!mode.equals("linear") && !mode.equals("catmullrom"))
+                        throw new IOException("Unknown animation interpolation");
+                    catmull = mode.equals("catmullrom");
+                } else pre = post = Components.parse(entry.getValue(), fallback);
+                frames.add(new Keyframe(time, pre, post, catmull));
+            }
+            if (frames.isEmpty() || frames.size() > 4096)
+                throw new IOException("Invalid animation keyframe count");
+            frames.sort(Comparator.comparingDouble(Keyframe::time));
+            for (int index = 1; index < frames.size(); index++) {
+                if (frames.get(index).time == frames.get(index - 1).time)
+                    throw new IOException("Duplicate animation key time");
+            }
+            return new Channel(List.copyOf(frames));
+        }
+
+        private float end() {
+            return this.keyframes.getLast().time;
+        }
+
+        private Vector sample(final float time, final BedrockMolang molang) {
+            if (time < this.keyframes.getFirst().time)
+                return this.keyframes.getFirst().pre.evaluate(molang);
+            // Search sorted times so dense native emotes do not scan every keyframe per frame.
+            int low = 0, high = this.keyframes.size();
+            while (low < high) {
+                final int middle = (low + high) >>> 1;
+                if (this.keyframes.get(middle).time <= time) low = middle + 1;
+                else high = middle;
+            }
+            final int previousIndex = low - 1;
+            final Keyframe previous = this.keyframes.get(previousIndex);
+            final Vector value = previous.post.evaluate(molang);
+            if (low == this.keyframes.size() || time == previous.time) return value;
+            final Keyframe next = this.keyframes.get(low);
+            final float fraction = (time - previous.time) / (next.time - previous.time);
+            final Vector nextValue = next.pre.evaluate(molang);
+            if (!previous.catmull && !next.catmull) return value.interpolate(nextValue, fraction);
+            final Vector before =
+                    this.keyframes.get(Math.max(0, previousIndex - 1)).post.evaluate(molang);
+            final Vector after =
+                    this.keyframes
+                            .get(Math.min(this.keyframes.size() - 1, low + 1))
+                            .pre
+                            .evaluate(molang);
+            return value.catmull(before, nextValue, after, fraction);
+        }
+    }
+}
