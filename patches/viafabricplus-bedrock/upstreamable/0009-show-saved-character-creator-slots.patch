diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBoneAnimationTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBoneAnimationTest.java
new file mode 100644
index 0000000..59d2cc5
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockBoneAnimationTest.java
@@ -0,0 +1,124 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.util.Map;
+
+final class BedrockBoneAnimationTest {
+    private static BedrockBoneAnimation animation(final String json) throws IOException {
+        return BedrockBoneAnimation.parse(JsonParser.parseString(json).getAsJsonObject());
+    }
+
+    @Test
+    void interpolatesIncomingPreAndOutgoingPostWithAnExactDiscontinuity() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"animation_length":2,"bones":{"head":{"position":{
+                                  "0":[0,0,0],"1":{"pre":[2,4,6],"post":[10,20,30]},"2":[12,24,36]
+                                }}}}
+                                """)
+                        .playback();
+        assertEquals(
+                new BedrockBoneAnimation.Vector(1, 2, 3),
+                playback.sample(.5F, Map.of()).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(10, 20, 30),
+                playback.sample(1, Map.of()).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(11, 22, 33),
+                playback.sample(1.5F, Map.of()).get("head").position());
+    }
+
+    @Test
+    void samplesSplineControlPointsAndScaleWithoutExtendingThePlaybackLength() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"animation_length":2,"bones":{"body":{"position":{
+                                  "0":[0,0,0],"1":[0,0,0],"2":{"post":[8,0,0],"lerp_mode":"catmullrom"},"3":[8,0,0]
+                                },"scale":2}}}
+                                """)
+                        .playback();
+        assertEquals(4, playback.sample(1.5F, Map.of()).get("body").position().x());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(2, 2, 2),
+                playback.sample(2, Map.of()).get("body").scale());
+    }
+
+    @Test
+    void keepsVariablesActorLocalAndExposesAnimationTimeQueries() throws Exception {
+        final var definition =
+                animation(
+                        """
+                        {"animation_length":5,"anim_time_update":"q.anim_time + q.delta_time * 2", "bones":{
+                          "head":{"position":["v.calls = (v.calls ?? 0) + 1; return v.calls;","q.anim_time","q.custom"]}
+                        }}
+                        """);
+        final var first = definition.playback();
+        assertEquals(
+                new BedrockBoneAnimation.Vector(1, 1, 7),
+                first.sample(.5F, Map.of("custom", 7F)).get("head").position());
+        assertEquals(
+                new BedrockBoneAnimation.Vector(2, 2, 0),
+                first.sample(1, Map.of()).get("head").position());
+        assertEquals(1, definition.playback().sample(1, Map.of()).get("head").position().x());
+    }
+
+    @Test
+    void wrapsLoopsAndBlendsScaleFromOne() throws Exception {
+        final var playback =
+                animation(
+                                """
+                                {"loop":true,"animation_length":2,"blend_weight":0.5,
+                                 "bones":{"head":{"rotation":["q.anim_time * 90",0,0],"scale":3}}}
+                                """)
+                        .playback();
+        final var transform = playback.sample(2.5F, Map.of()).get("head");
+        assertEquals(22.5F, transform.rotation().x());
+        assertEquals(new BedrockBoneAnimation.Vector(2, 2, 2), transform.scale());
+    }
+
+    @Test
+    void capsNativeLoopsAndBoundsNestedExecution() throws Exception {
+        final var definition =
+                animation(
+                        """
+                        {"bones":{"head":{"position":[
+                          "v.n=0;loop(1000000,{v.n=v.n+1;});return v.n;",
+                          "loop(1024,{loop(1024,{v.n=v.n+1;});});return v.n;",
+                          "1/0"
+                        ]}}}
+                        """);
+        assertTimeoutPreemptively(
+                java.time.Duration.ofSeconds(2),
+                () -> {
+                    assertEquals(
+                            new BedrockBoneAnimation.Vector(1024, 0, 0),
+                            definition.playback().sample(0, Map.of()).get("head").position());
+                });
+    }
+
+    @Test
+    void rejectsAmbiguousKeysAndInvalidPrograms() {
+        assertThrows(
+                IOException.class,
+                () ->
+                        animation(
+                                """
+                                {"bones":{"head":{"rotation":{"0":[0,0,0],"0.0":[1,2,3]}}}}
+                                """));
+        assertThrows(
+                IOException.class,
+                () ->
+                        animation(
+                                """
+                                {"bones":{"head":{"rotation":"q.anim_time + )"}}}
+                                """));
+    }
+}
