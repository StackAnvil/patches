+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** A resource-defined actor graph with shared variables and independent playback clocks. */
+public final class BedrockActorAnimation {
+    @FunctionalInterface
+    public interface Query {
+        Object evaluate(List<Object> arguments);
+    }
+
+    public record Frame(Map<String, Object> queries, Map<String, Float> variables) {
+        public Frame {
+            queries = Map.copyOf(queries);
+            variables = Map.copyOf(variables);
+        }
+    }
+
+    private final Map<String, String> aliases;
+    private final Map<String, BedrockBoneAnimation> animations;
+    private final Map<String, Controller> controllers;
+    private final List<BedrockMolang.Program> initialize, preAnimation;
+    private final List<Reference> roots;
+
+    private BedrockActorAnimation(
+            final JsonObject entity,
+            final Map<String, String> overrides,
+            final Map<String, JsonObject> animationDefinitions,
+            final Map<String, JsonObject> controllerDefinitions)
+            throws IOException {
+        final Map<String, String> aliases = new LinkedHashMap<>();
+        entity.getAsJsonObject("animations")
+                .entrySet()
+                .forEach(entry -> aliases.put(entry.getKey(), entry.getValue().getAsString()));
+        aliases.putAll(overrides);
+        this.aliases = Map.copyOf(aliases);
+        final JsonObject scripts = entity.getAsJsonObject("scripts");
+        this.initialize = programs(scripts.get("initialize"));
+        this.preAnimation = programs(scripts.get("pre_animation"));
+        this.roots = references(scripts.get("animate"));
+        this.animations = new LinkedHashMap<>();
+        this.controllers = new LinkedHashMap<>();
+        for (final Reference root : this.roots)
+            this.resolve(
+                    root.name, animationDefinitions, controllerDefinitions, new HashSet<>(), 0);
+    }
+
+    static BedrockActorAnimation read(
+            final Map<String, byte[]> files, final BedrockClassicOptions options)
+            throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>(),
+                controllers = new LinkedHashMap<>();
+        try {
+            for (final var entry : files.entrySet()) {
+                final String name = entry.getKey();
+                final String field =
+                        name.startsWith("library/vanilla/animations/")
+                                ? "animations"
+                                : name.startsWith("library/vanilla/animation_controllers/")
+                                        ? "animation_controllers"
+                                        : null;
+                if (field == null || !name.endsWith(".json")) continue;
+                final JsonObject definitions = json(entry.getValue()).getAsJsonObject(field);
+                if (definitions == null) continue;
+                final Map<String, JsonObject> target =
+                        field.equals("animations") ? animations : controllers;
+                for (final var definition : definitions.entrySet()) {
+                    final JsonObject value = definition.getValue().getAsJsonObject();
+                    final JsonObject previous = target.putIfAbsent(definition.getKey(), value);
+                    if (previous != null && !previous.equals(value))
+                        throw new IOException("Ambiguous actor animation resource");
+                }
+                if (target.size() > 4096)
+                    throw new IOException("Too many actor animation resources");
+            }
+            return new BedrockActorAnimation(
+                    json(files.get("library/vanilla/entity/player.entity.json"))
+                            .getAsJsonObject("minecraft:client_entity")
+                            .getAsJsonObject("description"),
+                    options.animations(),
+                    animations,
+                    controllers);
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid actor animation library", e);
+        }
+    }
+
+    static BedrockActorAnimation read(
+            final JsonObject entity,
+            final Map<String, String> overrides,
+            final JsonObject animations,
+            final JsonObject controllers)
+            throws IOException {
+        final Map<String, JsonObject> animationDefinitions = new LinkedHashMap<>(),
+                controllerDefinitions = new LinkedHashMap<>();
+        animations
+                .entrySet()
+                .forEach(
+                        entry ->
+                                animationDefinitions.put(
+                                        entry.getKey(), entry.getValue().getAsJsonObject()));
+        controllers
+                .entrySet()
+                .forEach(
+                        entry ->
+                                controllerDefinitions.put(
+                                        entry.getKey(), entry.getValue().getAsJsonObject()));
+        return new BedrockActorAnimation(
+                entity, overrides, animationDefinitions, controllerDefinitions);
+    }
+
+    private void resolve(
+            final String alias,
+            final Map<String, JsonObject> animations,
+            final Map<String, JsonObject> controllers,
+            final Set<String> chain,
+            final int depth)
+            throws IOException {
+        final String name = this.aliases.get(alias);
+        if (name == null) throw new IOException("The actor animation alias is missing: " + alias);
+        if (name.isEmpty()) return;
+        if (depth > 32 || !chain.add(name))
+            throw new IOException("Cyclic actor animation controller");
+        if (name.startsWith("controller.animation.")) {
+            if (!this.controllers.containsKey(name)) {
+                final JsonObject definition = controllers.get(name);
+                if (definition == null)
+                    throw new IOException("The actor animation controller is missing: " + name);
+                final Controller controller = Controller.read(definition);
+                for (final State state : controller.states.values())
+                    for (final Reference reference : state.animations)
+                        this.resolve(reference.name, animations, controllers, chain, depth + 1);
+                this.controllers.put(name, controller);
+            }
+        } else if (!this.animations.containsKey(name)) {
+            final JsonObject definition = animations.get(name);
+            if (definition == null)
+                throw new IOException("The actor animation resource is missing: " + name);
+            this.animations.put(name, BedrockBoneAnimation.parse(definition));
+        }
+        chain.remove(name);
+    }
+
+    public Playback playback() {
+        return new Playback();
+    }
+
+    public final class Playback {
+        private final BedrockMolang molang = new BedrockMolang();
+        private final Map<String, Active> active = new HashMap<>();
+        private float previousTime;
+        private float delta;
+        private long frame;
+        private boolean initialized;
+
+        public Map<String, BedrockBoneAnimation.Transform> sample(
+                final float time, final Frame input) {
+            final float delta = this.initialized ? Math.max(0, time - this.previousTime) : 0;
+            this.delta = delta;
+            this.previousTime = time;
+            this.frame++;
+            this.molang.queries(input.queries, time, time, delta);
+            if (!this.initialized) {
+                this.run(initialize);
+                this.initialized = true;
+            }
+            this.molang.variables(input.variables);
+            this.run(preAnimation);
+            final Map<String, BedrockBoneAnimation.Transform> pose = new LinkedHashMap<>();
+            for (int index = 0; index < roots.size(); index++)
+                this.apply(roots.get(index), "root/" + index, time, 1, input.queries, pose, 0);
+            this.active.entrySet().removeIf(entry -> entry.getValue().frame != this.frame);
+            return Map.copyOf(pose);
+        }
+
+        private void run(final List<BedrockMolang.Program> programs) {
+            programs.forEach(program -> this.molang.evaluate(program, 0));
+        }
+
+        private void apply(
+                final Reference reference,
+                final String path,
+                final float time,
+                final float inheritedWeight,
+                final Map<String, ?> queries,
+                final Map<String, BedrockBoneAnimation.Transform> pose,
+                final int depth) {
+            if (depth > 32 || this.active.size() > 4096) return;
+            final float weight =
+                    inheritedWeight * Math.clamp(this.molang.evaluate(reference.weight, 1), 0, 1);
+            final String name = aliases.get(reference.name);
+            if (weight <= 0 || name == null || name.isEmpty()) return;
+            Active value = this.active.get(path);
+            if (value == null || value.frame < this.frame - 1) {
+                value =
+                        new Active(
+                                time,
+                                animations.containsKey(name)
+                                        ? animations.get(name).playback(this.molang)
+                                        : null);
+                this.active.put(path, value);
+            }
+            value.frame = this.frame;
+            if (value.animation != null) {
+                final BedrockBoneAnimation animation = animations.get(name);
+                animation.compose(
+                        pose, value.animation.sample(time - value.started, queries), weight);
+                this.molang.queries(queries, time, time, this.delta);
+                return;
+            }
+            final Controller controller = controllers.get(name);
+            final var saved = this.molang.saveVariables(controller.variables);
+            try {
+                if (value.state == null) {
+                    value.state = controller.initial;
+                    this.run(controller.states.get(value.state).entry);
+                }
+                State state = controller.states.get(value.state);
+                for (final var variable : state.variables.entrySet())
+                    this.molang.variable(
+                            variable.getKey(), variable.getValue().sample(this.molang));
+                for (final Transition transition : state.transitions) {
+                    if (this.molang.evaluate(transition.condition, 0) == 0) continue;
+                    this.run(state.exit);
+                    this.molang.restoreVariables(saved);
+                    value.state = transition.target;
+                    state = controller.states.get(value.state);
+                    this.run(state.entry);
+                    for (final var variable : state.variables.entrySet())
+                        this.molang.variable(
+                                variable.getKey(), variable.getValue().sample(this.molang));
+                    break;
+                }
+                for (int index = 0; index < state.animations.size(); index++)
+                    this.apply(
+                            state.animations.get(index),
+                            path + "/" + value.state + "/" + index,
+                            time,
+                            weight,
+                            queries,
+                            pose,
+                            depth + 1);
+            } finally {
+                this.molang.restoreVariables(saved);
+            }
+        }
+    }
+
+    private static final class Active {
+        final float started;
+        final BedrockBoneAnimation.Playback animation;
+        String state;
+        long frame;
+
+        Active(final float started, final BedrockBoneAnimation.Playback animation) {
+            this.started = started;
+            this.animation = animation;
+        }
+    }
+
+    private record Reference(String name, BedrockMolang.Program weight) {}
+
+    private record Transition(String target, BedrockMolang.Program condition) {}
+
+    private record Point(float input, float output) {}
+
+    private record Variable(BedrockMolang.Program input, List<Point> curve) {
+        float sample(final BedrockMolang molang) {
+            final float value = molang.evaluate(this.input, 0);
+            if (this.curve.isEmpty()) return value;
+            if (value <= this.curve.getFirst().input) return this.curve.getFirst().output;
+            for (int index = 1; index < this.curve.size(); index++) {
+                final Point right = this.curve.get(index), left = this.curve.get(index - 1);
+                if (value <= right.input)
+                    return left.output
+                            + (right.output - left.output)
+                                    * (value - left.input)
+                                    / (right.input - left.input);
+            }
+            return this.curve.getLast().output;
+        }
+    }
+
+    private record State(
+            List<Reference> animations,
+            List<Transition> transitions,
+            List<BedrockMolang.Program> entry,
+            List<BedrockMolang.Program> exit,
+            Map<String, Variable> variables) {}
+
+    private record Controller(String initial, Map<String, State> states, Set<String> variables) {
+        static Controller read(final JsonObject definition) throws IOException {
+            final Map<String, State> states = new LinkedHashMap<>();
+            final JsonObject source = definition.getAsJsonObject("states");
+            if (source == null || source.isEmpty() || source.size() > 128)
+                throw new IOException("Invalid actor controller state count");
+            for (final var entry : source.entrySet()) {
+                final JsonObject state = entry.getValue().getAsJsonObject();
+                for (final String unsupported :
+                        List.of(
+                                "blend_transition",
+                                "blend_via_shortest_path",
+                                "particle_effects",
+                                "sound_effects"))
+                    if (state.has(unsupported))
+                        throw new IOException(
+                                "This actor controller needs state blending or effects");
+                final List<Transition> transitions = new ArrayList<>();
+                if (state.has("transitions"))
+                    for (final JsonElement transition : state.getAsJsonArray("transitions")) {
+                        if (transition.getAsJsonObject().size() != 1)
+                            throw new IOException("Invalid actor controller transition");
+                        final var target =
+                                transition.getAsJsonObject().entrySet().iterator().next();
+                        if (!source.has(target.getKey()))
+                            throw new IOException(
+                                    "The actor controller transition target is missing");
+                        transitions.add(
+                                new Transition(
+                                        target.getKey(),
+                                        BedrockMolang.Program.parse(target.getValue(), 0)));
+                    }
+                final Map<String, Variable> variables = new LinkedHashMap<>();
+                if (state.has("variables"))
+                    for (final var variable : state.getAsJsonObject("variables").entrySet()) {
+                        final JsonObject data = variable.getValue().getAsJsonObject();
+                        final List<Point> curve = new ArrayList<>();
+                        if (data.has("remap_curve"))
+                            for (final var point : data.getAsJsonObject("remap_curve").entrySet()) {
+                                final float input = Float.parseFloat(point.getKey()),
+                                        output = point.getValue().getAsFloat();
+                                if (!Float.isFinite(input) || !Float.isFinite(output))
+                                    throw new IOException("Invalid actor variable curve");
+                                curve.add(new Point(input, output));
+                            }
+                        curve.sort(java.util.Comparator.comparingDouble(Point::input));
+                        for (int index = 1; index < curve.size(); index++)
+                            if (curve.get(index).input == curve.get(index - 1).input)
+                                throw new IOException("Duplicate actor variable curve point");
+                        variables.put(
+                                variable.getKey(),
+                                new Variable(
+                                        BedrockMolang.Program.parse(data.get("input"), 0),
+                                        List.copyOf(curve)));
+                    }
+                states.put(
+                        entry.getKey(),
+                        new State(
+                                references(state.get("animations")),
+                                List.copyOf(transitions),
+                                programs(state.get("on_entry")),
+                                programs(state.get("on_exit")),
+                                java.util.Collections.unmodifiableMap(variables)));
+            }
+            final String initial =
+                    definition.has("initial_state")
+                            ? definition.get("initial_state").getAsString()
+                            : "default";
+            if (!states.containsKey(initial))
+                throw new IOException("The actor controller initial state is missing");
+            final Set<String> variables = new HashSet<>();
+            states.values().forEach(state -> variables.addAll(state.variables.keySet()));
+            return new Controller(initial, Map.copyOf(states), Set.copyOf(variables));
+        }
+    }
+
+    private static List<Reference> references(final JsonElement definitions) throws IOException {
+        if (definitions == null) return List.of();
+        final List<Reference> result = new ArrayList<>();
+        for (final JsonElement element : definitions.getAsJsonArray()) {
+            if (element.isJsonPrimitive() && element.getAsJsonPrimitive().isString())
+                result.add(
+                        new Reference(element.getAsString(), BedrockMolang.Program.parse(null, 1)));
+            else {
+                if (element.getAsJsonObject().size() != 1)
+                    throw new IOException("Invalid actor animation reference");
+                final var entry = element.getAsJsonObject().entrySet().iterator().next();
+                result.add(
+                        new Reference(
+                                entry.getKey(), BedrockMolang.Program.parse(entry.getValue(), 1)));
+            }
+        }
+        if (result.size() > 256) throw new IOException("Too many actor animation references");
+        return List.copyOf(result);
+    }
+
+    private static List<BedrockMolang.Program> programs(final JsonElement definitions)
+            throws IOException {
+        if (definitions == null) return List.of();
+        final List<BedrockMolang.Program> result = new ArrayList<>();
+        if (definitions.isJsonArray())
+            for (final JsonElement value : definitions.getAsJsonArray())
+                result.add(BedrockMolang.Program.parse(value, 0));
+        else result.add(BedrockMolang.Program.parse(definitions, 0));
+        if (result.size() > 256) throw new IOException("Too many actor animation scripts");
+        return List.copyOf(result);
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("Missing or oversized actor animation document");
+        return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)).getAsJsonObject();
+    }
+}
