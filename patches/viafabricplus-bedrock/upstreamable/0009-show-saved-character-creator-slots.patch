+    /** Keeps native first-person state local to hand submission, including nested submissions and failures. */
+    public static void submitFirstPerson(final float partialTick, final AvatarRenderState state,
+                                         final FirstPersonHandsAndItemsRenderState items,
+                                         final Runnable submission) {
