+    private static ParsedProfiles parseProfiles(final JsonObject profiles) throws IOException {
+        if (!profiles.has("result") || !profiles.get("result").isJsonArray()) {
+            throw new IOException("Bedrock character profiles response has no slots");
+        }
+        final JsonArray result = array(profiles, "result");
+        JsonObject settings = null;
+        for (final JsonElement element : result) {
+            if (element.isJsonObject() && "personaProfile".equals(string(element.getAsJsonObject(), "slotname"))) {
+                settings = element.getAsJsonObject().deepCopy();
+                break;
+            }
+        }
+        if (settings == null) {
+            throw new IOException("Bedrock account settings profile is missing");
+        }
+        final JsonArray settingsEntries = array(object(settings, "personaCollection"), "universalApp");
+        final String activeName = settingsEntries.isEmpty() || !settingsEntries.get(0).isJsonObject() ? ""
+            : string(settingsEntries.get(0).getAsJsonObject(), "lastUsedPersonaSlot");
+        int activeSlot = 0;
+        for (int index = 1; index <= 5; index++) {
+            if (("persona_profile_persona" + index).equals(activeName)) {
+                activeSlot = index;
+                break;
+            }
+        }
+        final List<Slot> slots = new ArrayList<>(5);
+        for (int index = 0; index < 5; index++) {
+            final String expectedName = "personaProfile" + (index + 1);
+            JsonObject slot = null;
+            for (final JsonElement element : result) {
+                if (element.isJsonObject() && expectedName.equals(string(element.getAsJsonObject(), "slotname"))) {
+                    slot = element.getAsJsonObject();
+                    break;
+                }
+            }
+            if (slot == null) {
+                throw new IOException("Bedrock character slot " + (index + 1) + " is missing");
+            }
+            final JsonObject collection = object(slot, "personaCollection");
+            final JsonArray pieces = array(collection, "universalApp");
+            String arm = "";
+            String skinColor = "";
+            final List<String> pieceIds = new ArrayList<>();
+            for (final JsonElement element : pieces) {
+                if (!element.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject piece = element.getAsJsonObject();
+                if (piece.has("skin")) {
+                    arm = string(piece, "arm");
+                    skinColor = string(piece, "skcol");
+                } else if (piece.has("id")) {
+                    pieceIds.add(string(piece, "id"));
+                }
+            }
+            slots.add(new Slot(index + 1, arm, skinColor, List.copyOf(pieceIds), string(slot, "profileHash"), slot.deepCopy()));
+        }
+        return new ParsedProfiles(List.copyOf(slots), activeSlot,
+            profiles.has("profileVersion") ? profiles.get("profileVersion").getAsInt() : 0, settings);
+    }
+
+    static List<WardrobeItem> catalogItems(final JsonObject response) {
+        final Map<String, WardrobeItem> items = new LinkedHashMap<>();
+        for (final JsonElement section : array(object(response, "result"), "layout")) {
+            if (!section.isJsonObject()) {
+                continue;
+            }
+            for (final JsonElement row : array(section.getAsJsonObject(), "rows")) {
+                if (!row.isJsonObject()) {
+                    continue;
+                }
+                for (final JsonElement component : array(row.getAsJsonObject(), "components")) {
+                    if (!component.isJsonObject()) {
+                        continue;
+                    }
+                    for (final JsonElement entry : array(component.getAsJsonObject(), "items")) {
+                        if (!entry.isJsonObject()) {
+                            continue;
+                        }
+                        final WardrobeItem item = catalogItem(entry.getAsJsonObject());
+                        if (item != null) {
+                            items.putIfAbsent(item.id(), item);
+                        }
+                    }
+                }
+            }
+        }
+        return List.copyOf(items.values());
+    }
+
+    static WardrobeItem catalogItem(final JsonObject item) {
+        if (!"PersonaDurable".equals(string(item, "contentType")) || string(item, "title").isBlank()) {
+            return null;
+        }
+        final JsonObject price = object(item, "price");
+        final boolean free = price.has("listPrice") && price.get("listPrice").isJsonPrimitive()
+            && price.get("listPrice").getAsInt() == 0;
+        final boolean owned = "Owned".equalsIgnoreCase(string(item, "ownership"))
+            || "Purchased".equalsIgnoreCase(string(item, "ownership"));
+        if (!free && !owned) {
+            return null;
+        }
+        String packId = "";
+        for (final JsonElement identity : array(item, "packIdentity")) {
+            if (identity.isJsonObject() && "persona_piece".equals(string(identity.getAsJsonObject(), "type"))) {
+                packId = string(identity.getAsJsonObject(), "uuid");
+                break;
+            }
+        }
+        if (packId.isBlank()) {
+            return null;
+        }
+        return new WardrobeItem(string(item, "id"), string(item, "title"), string(item, "pieceType"),
+            string(object(item, "thumbnail"), "url"), packId, owned);
+    }
+
+    private static JsonObject send(final HttpRequest request) throws IOException, InterruptedException {
+        final HttpResponse<String> response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() / 100 != 2) {
+            throw new IOException("Bedrock wardrobe request failed: HTTP " + response.statusCode());
+        }
+        try {
+            return JsonParser.parseString(response.body()).getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("Bedrock wardrobe returned invalid JSON", e);
+        }
+    }
+
+    private static JsonObject object(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonObject() ? parent.getAsJsonObject(key) : new JsonObject();
+    }
+
+    private static JsonArray array(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonArray() ? parent.getAsJsonArray(key) : new JsonArray();
+    }
+
+    private static String string(final JsonObject parent, final String key) {
+        return parent.has(key) && parent.get(key).isJsonPrimitive() ? parent.get(key).getAsString() : "";
+    }
+
+    public record AccountWardrobe(List<Slot> slots, int activeSlot,
+                                  int profileVersion, JsonObject settingsProfile) {
+    }
+
+    private record ParsedProfiles(List<Slot> slots, int activeSlot, int profileVersion, JsonObject settings) {
+    }
+
+    public record Slot(int number, String arm, String skinColor, List<String> pieceIds, String profileHash, JsonObject profile) {
+        public boolean occupied() {
+            return !this.pieceIds.isEmpty();
+        }
+    }
+
+    public enum Category {
+        BASES("DressingRoom_Bases", "Bases"),
+        HAIRS("DressingRoom_Hairs", "Hairs"),
+        EYES("DressingRoom_Eyes", "Eyes"),
+        MOUTHS("DressingRoom_Mouths", "Mouths"),
+        FACIAL_HAIRS("DressingRoom_FacialHairs", "Facial hair"),
+        ARMS("DressingRoom_Arms", "Arms"),
+        LEGS("DressingRoom_Legs", "Legs"),
+        TOPS("DressingRoom_Tops", "Tops"),
+        BOTTOMS("DressingRoom_Bottoms", "Bottoms"),
+        OUTERWEAR("DressingRoom_Outerwears", "Outerwear"),
+        HEADWEAR("DressingRoom_Headwears", "Headwear"),
+        GLOVES("DressingRoom_Gloves", "Gloves"),
+        FOOTWEAR("DressingRoom_Footwears", "Footwear"),
+        FACE_ITEMS("DressingRoom_FaceItems", "Face items"),
+        BACK_ITEMS("DressingRoom_BackItems", "Back items"),
+        CAPES("DressingRoom_Capes", "Capes"),
+        EMOTES("DressingRoom_Emotes", "Emotes");
+
+        private final String page;
+        private final String label;
+
+        Category(final String page, final String label) {
+            this.page = page;
+            this.label = label;
+        }
+
+        public String page() {
+            return this.page;
+        }
+
+        public String label() {
+            return this.label;
+        }
+    }
+
+    public record WardrobeItem(String id, String name, String type, String thumbnailUrl, String packId, boolean owned) {
+        public boolean matches(final String pieceId) {
+            return !this.packId.isBlank() && (pieceId.equalsIgnoreCase(this.packId)
+                || pieceId.regionMatches(true, 0, this.packId + "/", 0, this.packId.length() + 1));
+        }
+    }
+
+    public record PreparedCharacter(Slot slot, BedrockPersonaModel.Converted model, BedrockPersonaProfile profile) {
+        public net.raphimc.viabedrock.protocol.model.SkinData skinData() {
+            final var persona = new BedrockAppearanceStore.Persona(this.model.geometry(), this.model.resourcePatch(),
+                this.slot.profileHash(), this.slot.arm(), this.slot.skinColor(), this.profile, this.model.animations());
+            return new BedrockAppearanceStore.Appearance(BedrockAppearanceStore.Selection.PERSONA,
+                "slim".equals(this.slot.arm()), this.model.atlas(), null, "persona_" + this.slot.profileHash(), "", null, persona).skinData("");
+        }
+    }
+
+}
