+    /** Submits the actor once before Java's per-hand item transforms. */
+    public static void submitFirstPersonActor(final PoseStack poses, final net.minecraft.client.renderer.SubmitNodeCollector collector,
+                                              final int packedLight) {
+        final var frame = firstPersonFrame;
+        if (frame == null || frame.surfaces.isEmpty()) return;
+        poses.pushPose();
+        try {
+            poses.mulPose(frame.root);
+            for (int index = 0; index < frame.surfaces.size(); index++) {
+                final var surface = frame.surfaces.get(index);
+                collector.order(index == 0 ? 0 : 1).submitModelPart(surface.model.model().root(), poses, surface.material(),
+                        packedLight, net.minecraft.client.renderer.texture.OverlayTexture.NO_OVERLAY, null);
+            }
+        } finally {
+            poses.popPose();
+        }
+    }
