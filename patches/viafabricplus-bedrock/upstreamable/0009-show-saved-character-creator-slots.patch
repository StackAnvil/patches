+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleCountsTest {
+    private static final Map<String, String> QUERIES = Map.of(
+            "effect_emitters", "effect_emitter_count", "effect_particles", "effect_particle_count",
+            "total_emitters", "total_emitter_count", "total_particles", "total_particle_count");
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeUnsignedConversionAndMissingContexts() throws Exception {
+        final var fixture = fixture("native-particle-count-query-result.json");
+        final var missing = new BedrockMolang();
+        missing.queries(BedrockParticleQueries.sample(null, new Vector3f(), Vec3.ZERO));
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final long count = Long.parseUnsignedLong(row.get("value").getAsString());
+            for (final String query : QUERIES.values()) {
+                final boolean context = row.get("context").getAsBoolean();
+                final boolean found = query.startsWith("total_") || row.get("lookup").getAsString().equals("match");
+                final float actual = !context ? evaluate(missing, "q." + query) : found ? BedrockParticleCounts.asFloat(count) : 0;
+                assertEquals(row.getAsJsonObject("observed").get(query).getAsFloat(), actual, row.toString());
+            }
+        }
+        assertEquals(84, fixture.getAsJsonArray("cases").size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeCountPublicationAroundChildBirthsAndRemoval() throws Exception {
+        final var fixture = fixture("native-particle-count-publication-result.json");
+        final var counts = new BedrockParticleCounts();
+        final List<Node> registered = new ArrayList<>();
+        final Map<Integer, Node> nodes = new HashMap<>();
+        for (final var entry : fixture.getAsJsonObject("effects").entrySet()) {
+            final Node node = new Node(Integer.parseInt(entry.getKey()), entry.getValue().getAsString(), counts);
+            nodes.put(node.id, node);
+        }
+        final var rootSamples = fixture.getAsJsonArray("root_samples");
+        for (int id = 0; id < 3; id++) {
+            registered.add(nodes.get(id));
+            counts.created(nodes.get(id).effect);
+            sample(rootSamples.get(id).getAsJsonObject(), "root_initialization", nodes.get(id));
+        }
+        int receipts = 0;
+        for (final var entry : fixture.getAsJsonArray("steps")) {
+            final var frame = entry.getAsJsonObject();
+            final var samples = frame.getAsJsonArray("samples");
+            final int[] index = {0};
+            // The fixture chooses the native initialization gate. Only batch publication is compared here.
+            if (frame.get("index").getAsInt() > 0) {
+                BedrockParticleFrames.advance(registered, counts, node -> node.effect, node -> node.alive, node -> {
+                    sample(samples.get(index[0]++).getAsJsonObject(), "before_update", node);
+                    node.updates++;
+                    node.size++;
+                    if (node.id == 0 && node.updates == 1) {
+                        final Node child = nodes.get(10);
+                        registered.add(child);
+                        counts.created(child.effect);
+                        sample(samples.get(index[0]++).getAsJsonObject(), "child_initialization", child);
+                    }
+                    if (node.id == 0 && node.updates == 2) {
+                        final Node child = nodes.get(10);
+                        child.size += 2;
+                        sample(samples.get(index[0]++).getAsJsonObject(), "after_manual_birth", child);
+                    }
+                    if (node.id == 2 && node.updates == 2) {
+                        final Node previous = nodes.get(0);
+                        previous.size += 3;
+                        sample(samples.get(index[0]++).getAsJsonObject(), "after_manual_birth", previous);
+                    }
+                    if (node.id == 1 && node.updates == 1) { node.alive = false; node.size = 0; }
+                    sample(samples.get(index[0]++).getAsJsonObject(), "after_update", node);
+                }, node -> node.size);
+            }
+            for (final int id : frame.get("index").getAsInt() == 0
+                    ? List.of(0, 1, 2) : List.of(0, 1, 2, 10))
+                sample(samples.get(index[0]++).getAsJsonObject(), "after_frame", nodes.get(id));
+            assertEquals(samples.size(), index[0]);
+            assertEquals(frame.getAsJsonArray("members").asList().stream().map(value -> value.getAsInt()).toList(),
+                    registered.stream().map(node -> node.id).toList());
+            receipts += index[0];
+        }
+        assertEquals(36, receipts);
+    }
+
+    @Test
+    void keepsLiveCountBindingsThroughCreationInitializationParticlesAndQueryRefresh() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:emitter_initialization", JsonParser.parseString("""
+                {"creation_expression":"v.prior=q.effect_emitter_count;v.actor=q.scale;"}
+                """));
+        components.add("minecraft:particle_appearance_billboard", JsonParser.parseString("""
+                {"size":["q.effect_particle_count", "q.total_emitter_count"]}
+                """));
+        final var counts = new BedrockParticleCounts();
+        counts.created("test:burst");
+        final var environment = new BedrockMolang();
+        environment.queries(Map.of("scale", 7F));
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1),
+                BedrockParticleAttachment.Matrix.IDENTITY, null, counts.queries("test:burst"));
+        assertEquals(0, evaluate(environment, "v.prior"));
+        assertEquals(7, evaluate(environment, "v.actor"));
+        counts.created("test:burst");
+        emitter.queryContext(null, Vec3.ZERO);
+        emitter.initialize(program("v.registered=q.effect_emitter_count;"));
+        assertEquals(2, evaluate(environment, "v.registered"));
+        emitter.advance(0, 10, null, (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        assertEquals(0, emitter.visuals().getFirst().width());
+        assertEquals(2, emitter.visuals().getFirst().height());
+        counts.publish(Map.of("test:burst", (long) emitter.size()));
+        emitter.queryContext(null, Vec3.ZERO);
+        assertEquals(2, emitter.visuals().getFirst().width());
+        counts.created("other:effect");
+        assertEquals(3, emitter.visuals().getFirst().height());
+        final var missingEffect = new BedrockMolang();
+        missingEffect.queries(counts.queries("missing:effect"));
+        assertEquals(0, evaluate(missingEffect, "q.effect_emitter_count+q.effect_particle_count"));
+        assertEquals(3, evaluate(missingEffect, "q.total_emitter_count"));
+        counts.clear();
+        assertEquals(0, emitter.visuals().getFirst().width());
+        assertEquals(0, emitter.visuals().getFirst().height());
+        assertEquals(0, evaluate(environment, "v.prior"));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeMissingOwnerOnFirstCreationAndBoundOwnerOnLoopRestart() throws Exception {
+        final var fixture = fixture("native-particle-count-creation-result.json");
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.remove("minecraft:emitter_lifetime_once");
+        components.add("minecraft:emitter_lifetime_looping", JsonParser.parseString("{\"active_time\":0.05,\"sleep_time\":0}"));
+        components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 0);
+        final String expression = "v.effect_emitters=q.effect_emitter_count;v.effect_particles=q.effect_particle_count;"
+                + "v.total_emitters=q.total_emitter_count;v.total_particles=q.total_particle_count;";
+        final var initialization = new JsonObject();
+        initialization.addProperty("creation_expression", expression);
+        components.add("minecraft:emitter_initialization", initialization);
+        final var counts = new BedrockParticleCounts();
+        counts.created("test:burst");
+        counts.created("test:burst");
+        final var environment = new BedrockMolang();
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1),
+                BedrockParticleAttachment.Matrix.IDENTITY, null, counts.queries("test:burst"));
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            if (row.get("owner").getAsBoolean()) {
+                emitter.queryContext(null, Vec3.ZERO);
+                emitter.advance(0, 0, null, (x, y, z) -> List.of());
+                emitter.advance(50_000_001, 0, null, (x, y, z) -> List.of());
+            }
+            for (final String key : QUERIES.keySet())
+                assertEquals(row.getAsJsonObject("observed").get(key).getAsFloat(), evaluate(environment, "v." + key));
+        }
+    }
+
+    private static void sample(final JsonObject expected, final String stage, final Node node) {
+        assertEquals(stage, expected.get("stage").getAsString());
+        assertEquals(node.id, expected.get("emitter").getAsInt());
+        for (final var query : QUERIES.entrySet())
+            assertEquals(expected.getAsJsonObject("counts").get(query.getKey()).getAsFloat(),
+                    evaluate(node.environment, "q." + query.getValue()), expected.toString());
+    }
+
+    private static JsonObject fixture(final String filename) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), filename))).getAsJsonObject();
+    }
+
+    private static BedrockMolang.Program program(final String expression) throws java.io.IOException {
+        return BedrockMolang.Program.parse(new JsonPrimitive(expression), 0);
+    }
+
+    private static float evaluate(final BedrockMolang environment, final String expression) {
+        try { return environment.evaluate(program(expression), 0); }
+        catch (java.io.IOException invalid) { throw new AssertionError(invalid); }
+    }
+
+    private static final class Node {
+        final int id;
+        final String effect;
+        final BedrockMolang environment = new BedrockMolang();
+        boolean alive = true;
+        int size = 1, updates;
+
+        Node(final int id, final String effect, final BedrockParticleCounts counts) {
+            this.id = id;
+            this.effect = effect;
+            this.environment.queries(counts.queries(effect));
+        }
+    }
+}
