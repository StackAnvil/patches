+            this.palette().get(this.selectedColor), this.colorTarget == ColorTarget.SKIN ? List.of() : this.items)
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                this.saving = false;
+                if (error != null) {
+                    this.editFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not change Bedrock character color", error);
+                } else {
+                    this.wardrobe = loaded;
+                    if (loaded.activeSlot() == slot.number()) {
+                        this.loadAvatar(account);
+                        if (this.personaSelected) {
+                            this.refreshPersona(account);
+                            return;
+                        }
+                    }
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void selectSlot() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final int slotNumber = this.selectedSlot + 1;
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.selectSlot(account, slotNumber).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            if (error != null) {
+                this.saving = false;
+                this.selectionFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not select Bedrock character slot", error);
+            } else {
+                this.wardrobe = loaded;
+                this.loadAvatar(account);
+                if (this.personaSelected) {
+                    this.refreshPersona(account);
+                    return;
+                }
+                this.saving = false;
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void useSelectedSlot() {
+        if (this.wardrobe != null && !this.wardrobe.slots().get(this.selectedSlot).occupied()) {
+            this.createCharacter(false);
+            return;
+        }
+        if (this.wardrobe != null && this.wardrobe.activeSlot() == this.selectedSlot + 1) {
+            final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+            if (account != null) {
+                this.preparePersona(account);
+            }
+        } else {
+            this.selectSlot();
+        }
+    }
+
+    private void createCharacter(final boolean copyActive) {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final Slot target = this.wardrobe.slots().get(this.selectedSlot);
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        final var operation = copyActive
+            ? BedrockCharacterProfiles.copyActiveToSlot(account, target.number(), target.profileHash())
+            : BedrockCharacterProfiles.createStarterCharacter(account, target.number(), target.profileHash());
+        operation
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                if (error != null) {
+                    this.saving = false;
+                    this.selectionFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not create Bedrock character", error);
+                } else {
+                    this.wardrobe = loaded;
+                    this.loadAvatar(account);
+                    if (this.personaSelected) {
+                        this.refreshPersona(account);
+                        return;
+                    }
+                    this.saving = false;
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void deleteSelectedSlot() {
+        if (this.wardrobe != null && !this.wardrobe.slots().get(this.selectedSlot).occupied()) {
+            this.createCharacter(true);
+            return;
+        }
+        if (!this.confirmDelete) {
+            this.confirmDelete = true;
+            this.updateControls();
+            return;
+        }
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.wardrobe == null || this.saving) {
+            return;
+        }
+        final Slot target = this.wardrobe.slots().get(this.selectedSlot);
+        final boolean deletingActive = this.wardrobe.activeSlot() == target.number();
+        this.confirmDelete = false;
+        this.saving = true;
+        this.selectionFailed = false;
+        this.updateControls();
+        BedrockCharacterProfiles.deleteSlot(account, target.number(), target.profileHash())
+            .whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() != this) {
+                    return;
+                }
+                if (error != null) {
+                    this.saving = false;
+                    this.selectionFailed = true;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not delete Bedrock character", error);
+                } else {
+                    this.wardrobe = loaded;
+                    if (deletingActive) {
+                        this.loadAvatar(account);
+                        if (this.personaSelected) {
+                            this.refreshPersona(account);
+                            return;
+                        }
+                    }
+                    this.saving = false;
+                }
+                this.updateControls();
+            }));
+    }
+
+    private void refreshPersona(final BedrockAuthManager account) {
+        try {
+            ViaFabricPlusBedrock.impl().appearances()
+                .select(BedrockAppearanceStore.accountId(account), Selection.STEVE);
+            this.personaSelected = false;
+            this.preparePersona(account);
+        } catch (java.io.IOException e) {
+            this.saving = false;
+            this.modelFailed = true;
+            ViaFabricPlusBedrock.impl().logger().warn("Could not retire the previous account character", e);
+            this.updateControls();
+        }
+    }
+
+    private void preparePersona(final BedrockAuthManager account) {
+        this.saving = true;
+        this.modelFailed = false;
+        this.updateControls();
+        final BedrockAppearanceStore store = ViaFabricPlusBedrock.impl().appearances();
+        final String accountId = BedrockAppearanceStore.accountId(account);
+        BedrockCharacterProfiles.loadActiveModel(account).thenApply(prepared -> {
+            try {
+                store.importPersona(accountId, prepared.model(), prepared.slot().profileHash(),
+                    prepared.slot().arm(), prepared.slot().skinColor());
+                return prepared;
+            } catch (java.io.IOException e) {
+                throw new IllegalStateException("Could not save the account character model", e);
+            }
+        }).whenComplete((_, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            this.saving = false;
+            if (error != null) {
+                this.modelFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not use Bedrock account character in worlds", error);
+            } else {
+                this.personaSelected = true;
+            }
+            this.updateControls();
+        }));
+    }
+
+    private void refresh() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null || this.loading) {
+            return;
+        }
+        this.loading = true;
+        this.failed = false;
+        this.selectionFailed = false;
+        this.modelFailed = false;
+        this.confirmDelete = false;
+        BedrockCharacterProfiles.load(account).whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            this.loading = false;
+            if (error != null) {
+                this.failed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock character slots", error);
+            } else {
+                this.wardrobe = loaded;
+                try {
+                    final var appearance = ViaFabricPlusBedrock.impl().appearances()
+                        .load(BedrockAppearanceStore.accountId(account));
+                    this.personaSelected = appearance.selection() == Selection.PERSONA
+                        && loaded.activeSlot() > 0
+                        && appearance.persona().profileHash()
+                            .equals(loaded.slots().get(loaded.activeSlot() - 1).profileHash());
+                    if (appearance.selection() == Selection.PERSONA && !this.personaSelected) {
+                        ViaFabricPlusBedrock.impl().appearances()
+                            .select(BedrockAppearanceStore.accountId(account), Selection.STEVE);
+                        this.modelFailed = true;
+                    }
+                } catch (java.io.IOException e) {
+                    this.personaSelected = false;
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not load selected Bedrock character model", e);
+                }
+                this.items = null;
+                this.loadedCategory = null;
+                this.itemsFailed = false;
+                this.updateControls();
+                this.loadAvatar(account);
+                if (this.view == View.WARDROBE) {
+                    this.loadCategory();
+                }
+            }
+        }));
+    }
+
+}
