+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+
+import net.minecraft.client.model.Model;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.client.model.player.PlayerModel;
+import net.minecraft.client.renderer.rendertype.RenderTypes;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Matrix4f;
+import org.joml.Quaternionf;
+import org.joml.Vector3f;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/** A menu model retaining the authored hierarchy, including root and waist pivots. */
+public final class BedrockAnimatedModel {
+    private final Model.Simple model;
+    private final Map<String, ModelPart> parts;
+    private final Map<ModelPart, ModelPart> parents = new HashMap<>();
+
+    BedrockAnimatedModel(
+            final ModelPart root,
+            final Map<String, ModelPart> parts,
+            final BedrockGeometryModel geometry) {
+        this.model = new Model.Simple(root, RenderTypes::entityTranslucent);
+        final Map<String, ModelPart> normalized = new HashMap<>();
+        parts.forEach((name, part) -> normalized.put(normalize(name), part));
+        this.parts = Map.copyOf(normalized);
+        for (final var definition : geometry.getParents()) {
+            final ModelPart child = parts.get(definition.getName());
+            final ModelPart parent = parts.get(definition.getParent());
+            if (parent != null) this.parents.put(child, parent);
+        }
+    }
+
+    public Model.Simple model() {
+        return this.model;
+    }
+
+    public void pose(final Map<String, BedrockBoneAnimation.Transform> transforms) {
+        this.model.root().getAllParts().forEach(ModelPart::resetPose);
+        transforms.forEach(
+                (name, transform) -> {
+                    final ModelPart part = this.parts.get(normalize(name));
+                    if (part == null) return;
+                    part.x += transform.position().x();
+                    part.y -= transform.position().y();
+                    part.z += transform.position().z();
+                    part.xRot += (float) Math.toRadians(transform.rotation().x());
+                    part.yRot += (float) Math.toRadians(transform.rotation().y());
+                    part.zRot += (float) Math.toRadians(transform.rotation().z());
+                    part.xScale *= transform.scale().x();
+                    part.yScale *= transform.scale().y();
+                    part.zScale *= transform.scale().z();
+                });
+    }
+
+    /** Flatten global bone transforms only for armor and held-item attachment models. */
+    void copyHumanoidPose(final PlayerModel target) {
+        final Map<ModelPart, Matrix4f> matrices = new HashMap<>();
+        final Map<String, ModelPart> humanoid =
+                Map.of(
+                        "head",
+                        target.head,
+                        "body",
+                        target.body,
+                        "rightarm",
+                        target.rightArm,
+                        "leftarm",
+                        target.leftArm,
+                        "rightleg",
+                        target.rightLeg,
+                        "leftleg",
+                        target.leftLeg);
+        humanoid.forEach(
+                (name, destination) -> {
+                    final ModelPart source = this.parts.get(name);
+                    if (source == null) return;
+                    source.visible = destination.visible;
+                    final Matrix4f matrix = this.global(source, matrices);
+                    final Vector3f position = matrix.getTranslation(new Vector3f());
+                    final Vector3f rotation =
+                            matrix.getUnnormalizedRotation(new Quaternionf())
+                                    .normalize()
+                                    .getEulerAnglesZYX(new Vector3f());
+                    final Vector3f scale = matrix.getScale(new Vector3f());
+                    destination.setPos(position.x, position.y, position.z);
+                    destination.setRotation(rotation.x, rotation.y, rotation.z);
+                    destination.xScale = scale.x;
+                    destination.yScale = scale.y;
+                    destination.zScale = scale.z;
+                });
+        target.hat.loadPose(target.head.storePose());
+        target.rightSleeve.loadPose(target.rightArm.storePose());
+        target.leftSleeve.loadPose(target.leftArm.storePose());
+        target.rightPants.loadPose(target.rightLeg.storePose());
+        target.leftPants.loadPose(target.leftLeg.storePose());
+        target.jacket.loadPose(target.body.storePose());
+    }
+
+    private Matrix4f global(final ModelPart part, final Map<ModelPart, Matrix4f> matrices) {
+        final Matrix4f cached = matrices.get(part);
+        if (cached != null) return cached;
+        final ModelPart parent = this.parents.get(part);
+        final Matrix4f transform =
+                parent == null ? new Matrix4f() : new Matrix4f(this.global(parent, matrices));
+        transform
+                .translate(part.x, part.y, part.z)
+                .rotateZYX(part.zRot, part.yRot, part.xRot)
+                .scale(part.xScale, part.yScale, part.zScale);
+        matrices.put(part, transform);
+        return transform;
+    }
+
+    private static String normalize(final String name) {
+        final String normalized = name.toLowerCase(Locale.ROOT).replace("_", "");
+        return normalized.equals("hip") ? "waist" : normalized;
+    }
+}
