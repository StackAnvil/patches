+                JsonParser.parseString("{}").getAsJsonObject(), JsonParser.parseString("{}").getAsJsonObject(), "1.10.0");
+    }
+
+    private static BedrockBoneAnimation.Vector vector(final float x, final float y, final float z) {
+        return new BedrockBoneAnimation.Vector(x, y, z);
+    }
+}
