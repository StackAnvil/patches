+    private void changePage(final int offset) {
+        if (this.items == null || this.items.isEmpty()) {
+            return;
+        }
+        final int pages = (this.items.size() + this.pageSize() - 1) / this.pageSize();
+        this.itemPage = Math.floorMod(this.itemPage + offset, pages);
+        this.selectedItem = Math.min(this.itemPage * this.pageSize(), this.items.size() - 1);
+        this.updateControls();
+    }
