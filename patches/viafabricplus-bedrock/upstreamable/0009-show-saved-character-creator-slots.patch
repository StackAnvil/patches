+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+
+final class BedrockBuiltinAssetsTest {
+    @TempDir Path directory;
+
+    @Test
+    void preservesSharedOffsetsNestedFilesAndLooseStubs() throws Exception {
+        final byte[] bytes = archive();
+        final var files = BedrockBrArchive.read(bytes);
+        assertArrayEquals(new byte[] {1, 2, 3}, files.get("nested/one"));
+        assertArrayEquals(files.get("nested/one"), files.get("two"));
+        assertFalse(files.containsKey("loose.png"));
+        Files.createDirectories(directory.resolve("__brarchive/pieces/test"));
+        Files.createDirectories(directory.resolve("pieces/test"));
+        Files.write(directory.resolve("__brarchive/pieces/test.brarchive"), bytes);
+        Files.write(directory.resolve("pieces/test/loose.png"), new byte[] {4});
+        final var unpacked = BedrockBuiltinAssets.unpack(directory);
+        assertArrayEquals(new byte[] {4}, unpacked.get("pieces/test/loose.png"));
+        assertArrayEquals(new byte[] {1, 2, 3}, unpacked.get("pieces/test/nested/one"));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"vanilla", "vanilla_base", "vanilla_1.14", "vanilla_1.26.51"})
+    void unpacksModelArchivesUnderTheirLibraryRoot(final String pack) throws Exception {
+        final String root = "library/" + pack + "/";
+        Files.createDirectories(directory.resolve(root + "__brarchive/models"));
+        Files.write(directory.resolve(root + "__brarchive/models/entity.brarchive"), archive());
+        final var unpacked = BedrockBuiltinAssets.unpack(directory);
+        assertArrayEquals(new byte[] {1, 2, 3}, unpacked.get(root + "models/entity/nested/one"));
+        assertEquals(2, unpacked.size());
+    }
+
+    @Test
+    void boundsInputAndExpandedBytesSeparately() throws Exception {
+        Files.createDirectories(directory.resolve("__brarchive"));
+        Files.write(directory.resolve("__brarchive/pieces.brarchive"), archive());
+        Files.write(directory.resolve("loose.png"), new byte[10]);
+        // Input is 797 bytes and the logical output is 16 bytes. Counting both
+        // representations together would incorrectly reject the 800-byte limit.
+        assertEquals(3, BedrockBuiltinAssets.unpack(directory, 800).size());
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.unpack(directory, 796));
+
+        Files.delete(directory.resolve("loose.png"));
+        Files.write(directory.resolve("__brarchive/pieces.brarchive"), sharedArchive(2, 1024));
+        // Shared offsets fit in 1552 input bytes but expand to 2048 logical bytes.
+        assertThrows(IOException.class, () -> BedrockBuiltinAssets.unpack(directory, 1700));
+        assertEquals(2, BedrockBuiltinAssets.unpack(directory, 2048).size());
+    }
+
+    @Test
+    void cachesExpandedLibrariesAboveTheRawFileLimitAndBoundsTheirLogicalCount() throws Exception {
+        final Path cache = directory.resolve("cache/images.zip");
+        final var first = BedrockBuiltinAssets.cached(cache, "1.26.51.1", "package", staging -> {
+            fixture(staging);
+            final Path archives = staging.resolve("__brarchive/pieces");
+            Files.createDirectories(archives);
+            for (int index = 0; index < 3; index++)
