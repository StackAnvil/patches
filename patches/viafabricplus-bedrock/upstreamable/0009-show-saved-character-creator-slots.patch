+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** Native walking distance, independent of Java's local hand bob and limb swing. */
+public final class BedrockWalkingAnimation {
+    final BedrockViewBobbing viewBobbing = new BedrockViewBobbing();
+    private float distance;
+    private float previousDistance;
+
+    public void tick(final float deltaX, final float deltaZ) {
+        this.previousDistance = this.distance;
+        this.distance += (float) Math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
+    }
+
+    public void tickView(final float velocityX, final float velocityY, final float velocityZ, final boolean onGround,
+                         final boolean swimming, final boolean alive, final boolean riding) {
+        this.viewBobbing.tick(velocityX, velocityY, velocityZ, onGround, swimming, alive, riding);
+    }
+
+    public float sample(final float frameAlpha) {
+        return sample(this.distance, this.previousDistance, frameAlpha);
+    }
+
+    static float sample(final float distance, final float previousDistance, final float frameAlpha) {
+        return (distance + frameAlpha * (distance - previousDistance)) * 0.6F;
+    }
+
+    public interface Provider {
+        BedrockWalkingAnimation bedrockWalkingAnimation();
+    }
+}
