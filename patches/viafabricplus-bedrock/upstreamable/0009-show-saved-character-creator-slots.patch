+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+
+/** Event times retain native float-to-nanosecond conversion and half-open update intervals. */
+record BedrockParticleLifetimeEvents(List<String> creation, List<String> expiration, List<Timed> timeline) {
+    static BedrockParticleLifetimeEvents read(final JsonObject value) throws IOException {
+        return read(value, Set.of("creation_event", "expiration_event", "timeline"));
+    }
+
+    static BedrockParticleLifetimeEvents read(final JsonObject value, final Set<String> fields) throws IOException {
+        for (final String field : value.keySet())
+            if (!fields.contains(field))
+                throw new IOException("Unsupported particle lifetime event field: " + field);
+        final List<Timed> times = new ArrayList<>();
+        if (value.has("timeline")) {
+            if (!value.get("timeline").isJsonObject() || value.getAsJsonObject("timeline").size() > 256)
+                throw new IOException("Invalid particle event timeline");
+            for (final var entry : new TreeMap<>(value.getAsJsonObject("timeline").asMap()).entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 1_000_000) throw new IOException("Invalid particle event time");
+                times.add(new Timed(BedrockParticleLifetime.duration(time), names(entry.getValue())));
+            }
+        }
+        return new BedrockParticleLifetimeEvents(names(value.get("creation_event")), names(value.get("expiration_event")), List.copyOf(times));
+    }
+
+    void advance(final long previous, final long current, final Consumer<List<String>> sink) {
+        for (final Timed event : this.timeline)
+            if (previous <= event.nanos && event.nanos < current) sink.accept(event.names);
+    }
+
+    static List<String> names(final JsonElement value) throws IOException {
+        if (value == null) return List.of();
+        final List<String> names = new ArrayList<>();
+        if (value.isJsonArray()) {
+            if (value.getAsJsonArray().size() > 256) throw new IOException("Particle event list exceeds its limit");
+            for (final var name : value.getAsJsonArray()) names.add(name(name));
+        } else names.add(name(value));
+        return List.copyOf(names);
+    }
+
+    private static String name(final JsonElement value) throws IOException {
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) throw new IOException("Invalid particle event name");
+        final String name = value.getAsString();
+        if (name.isEmpty() || name.length() > 256) throw new IOException("Invalid particle event name");
+        return name;
+    }
+
+    record Timed(long nanos, List<String> names) {}
+}
