new file mode 100644
index 0000000..3ed8f8d
--- /dev/null
+++ b/native/persona-assets/src/device.rs
@@ -0,0 +1,120 @@
+// Adapted from xodus-gaming/xodus (GPL-3.0), https://github.com/xodus-gaming/xodus/commit/a3afa0569332e32ce2677c0edc643ef85477ee3e.
+use xodus::licensing::splicense::SPLicense;
+use xodus::licensing::utils::{generate_string, parse_bcrypt_rsa_private};
+use xodus::models::devicecredential::{Authentication, ClientInfo, DeviceAddRequest, DeviceInfo};
+use xodus::models::secrets::Device;
+use xodus::models::soap::BodyContent;
+use xodus::tokens::TokenManager;
+
+/// Enroll an independent device identity without requesting elevated permissions.
+pub async fn ensure_credentials(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+) -> crate::Result<()> {
+    let license = match tokens.get_device_license() {
+        Ok(license) => license,
+        Err(_) => {
+            let username = format!("02{}", generate_string(14));
+            let password = generate_string(20);
+            let request = DeviceAddRequest {
+                client_info: ClientInfo::default(),
+                authentication: Authentication::new(username.clone(), password.clone()),
+                device_info: Some(DeviceInfo {
+                    id: "DeviceInfo".to_string(),
+                    components: provision_components(),
+                    tpm_info: None,
+                }),
+            };
+            let response = xodus::api::live::login_device_credential(client, request).await?;
+            let license = Device {
+                username,
+                password,
+                puid: response.puid,
+                hwid: response.hw_device_id,
+                device_id: response.license.binding.device_id.unwrap_or_default(),
+                splicense: response.license.splicense_block,
+            };
+            tokens.save_device_license(&license)?;
+            license
+        }
+    };
+    if tokens.get_device_sts_token().is_ok() {
+        return Ok(());
+    }
+    let license_data = SPLicense::parse_base64(&license.splicense)?;
+    let signing = license_data
+        .clep_sign_state
+        .ok_or("Device license has no signing state")?;
+    let private_key = parse_bcrypt_rsa_private(&signing.get_rsa_key())?;
+    let response =
+        xodus::api::live::authenticate_device(client, license.username, private_key).await?;
+    let BodyContent::RequestSecurityTokenResponse(response) = response.body.body else {
+        return Err("Device authentication returned no token".into());
+    };
+    let name = response
+        .requested_security_token
+        .encrypted_data
+        .as_ref()
+        .and_then(|data| data.key_info.key_name.as_ref())
+        .ok_or("Device token has no key name")?
+        .clone();
+    tokens.save_device_token(name, (*response).into())?;
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn provision_components() -> Vec<xodus::models::devicecredential::Component> {
+    xodus::hardware::probe_provision_components()
+}
+
+#[cfg(target_os = "linux")]
+fn provision_components() -> Vec<xodus::models::devicecredential::Component> {
+    use base64::{Engine, engine::general_purpose::STANDARD};
+    use xodus::models::devicecredential::Component;
+
+    // Xodus's Linux probe invokes pkexec for SMBIOS. Hardware is optional in
+    // this enrollment protocol: use its existing unavailable-hardware values.
+    let (challenge_v2, challenge_v4) =
+        xodus::clep::challenge::get_license_challange([0; 256], [0; 64]);
+    vec![
+        Component::new(4113, "AA==".to_string()),
+        Component::error(4101),
+        Component::new(8196, STANDARD.encode(challenge_v2)),
+        Component::new(8197, STANDARD.encode(challenge_v4)),
+        Component::error(4100),
+        Component::error(4101),
+        Component::error(4102),
+        Component::new(4145, "AQAAAA==".to_string()),
+        Component::error(4160),
+        Component::error(4161),
+    ]
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    #[test]
+    fn hardware_unavailability_retains_the_provisioning_challenges() {
+        let components = super::provision_components();
+        for id in [8196, 8197] {
+            let challenge = components
+                .iter()
+                .find(|component| component.name == id)
+                .unwrap();
+            assert!(challenge.error.is_none());
+            assert!(
+                challenge
+                    .value
+                    .as_ref()
+                    .is_some_and(|value| !value.is_empty())
+            );
+        }
+        for id in [4100, 4101, 4102] {
+            assert!(
+                components
+                    .iter()
+                    .filter(|component| component.name == id)
+                    .all(|component| component.error.is_some() && component.value.is_none())
+            );
+        }
+    }
+}
diff --git a/native/persona-assets/src/index.rs b/native/persona-assets/src/index.rs
new file mode 100644
index 0000000..f25e099
--- /dev/null
+++ b/native/persona-assets/src/index.rs
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use crate::{Result, remote::Remote};
+use msixvc::{
+    models::xvd::XvdHeader,
+    xvd::{SegmentFile, SyncSubstream, XvdFile},
+};
+use ntfs::{Ntfs, NtfsFile, attribute_value::NtfsAttributeValue};
+use std::{
+    collections::BTreeMap,
+    io::{Read, Seek, SeekFrom, Write},
+};
+use tokio_util::io::SyncIoBridge;
+
+pub enum Asset {
+    Resident(Vec<u8>),
+    Segments { length: u64, runs: Vec<SegmentFile> },
+}
+impl Asset {
+    pub fn length(&self) -> u64 {
+        match self {
+            Self::Resident(b) => b.len() as u64,
+            Self::Segments { length, .. } => *length,
+        }
+    }
+}
+
+pub fn ntfs(
+    remote: &mut Remote,
+    header: &XvdHeader,
+    package: &XvdFile,
+) -> Result<BTreeMap<String, Asset>> {
+    tokio::task::block_in_place(|| {
+        let layout = header.layout();
+        let drive = ReadOnly(SyncSubstream::new(
+            SyncIoBridge::new(remote),
+            layout.drive_data.start.to_bytes().0,
+            header.drive_size.0,
+        ));
+        let disk = gpt::GptConfig::new()
+            .writable(false)
+            .logical_block_size(gpt::disk::LogicalBlockSize::Lb4096)
+            .open_from_device(drive)?;
+        let (_, partition) = disk
+            .partitions()
+            .iter()
+            .find(|(_, part)| part.is_used())
+            .ok_or("Missing package partition")?;
+        let start = partition.bytes_start(*disk.logical_block_size())?;
+        let length = partition.bytes_len(*disk.logical_block_size())?;
+        let offset = layout.drive_data.start.to_bytes().0 + start;
+        let mut fs = SyncSubstream::new(disk.take_device(), start, length);
+        let mut ntfs = Ntfs::new(&mut fs)?;
+        ntfs.read_upcase_table(&mut fs)?;
+        let mut dir = ntfs.root_directory(&mut fs)?;
+        for component in ["data", "resource_packs"] {
+            dir = child(&ntfs, &mut fs, &dir, component)?;
+            if !dir.is_directory() {
+                return Err("Invalid package resource directory".into());
+            }
+        }
+        let mut assets = BTreeMap::new();
+        let pack_index = dir.directory_index(&mut fs)?;
+        let mut pack_entries = pack_index.entries();
+        let mut required = [false; 3];
+        while let Some(entry) = pack_entries.next(&mut fs) {
+            let entry = entry?;
+            let Some(key) = entry.key() else {
+                continue;
+            };
+            let name = key?.name().to_string_lossy();
+            if name != "persona" && !crate::library_pack(&name) {
+                continue;
+            }
+            let pack = entry.to_file(&ntfs, &mut fs)?;
+            if !pack.is_directory() {
+                return Err("Invalid package asset directory".into());
+            }
+            for (index, required_name) in ["persona", "vanilla", "vanilla_base"].iter().enumerate()
+            {
+                if name == *required_name {
+                    required[index] = true;
+                }
+            }
+            walk(
+                &ntfs,
+                &mut fs,
+                &pack,
+                &format!("data/resource_packs/{name}/"),
+                offset,
+                &mut assets,
+                0,
+            )?;
+        }
+        if !required.into_iter().all(|present| present) {
+            return Err("The package is missing a required asset directory".into());
+        }
+        for asset in assets.values_mut() {
+            if let Asset::Segments { runs, .. } = asset {
+                for (index, run) in runs.iter_mut().enumerate() {
+                    let mut files = std::collections::HashMap::from([(
+                        index.to_string(),
+                        std::mem::replace(
+                            run,
+                            SegmentFile {
+                                offset: 0,
+                                length: 0,
+                                data_hashs: Vec::new(),
+                                keep_encrypted: false,
+                            },
+                        ),
+                    )]);
+                    package.populate_segment_hashes(&mut files)?;
+                    *run = files.remove(&index.to_string()).unwrap();
+                }
+            }
+        }
+        Ok(assets)
+    })
+}
+
+fn child<'n, T: Read + Seek>(
+    ntfs: &'n Ntfs,
+    fs: &mut T,
+    dir: &NtfsFile<'n>,
+    name: &str,
+) -> Result<NtfsFile<'n>> {
+    let index = dir.directory_index(fs)?;
+    let mut entries = index.entries();
+    while let Some(entry) = entries.next(fs) {
+        let entry = entry?;
+        if let Some(key) = entry.key()
+            && key?.name().to_string_lossy().eq_ignore_ascii_case(name)
+        {
+            return Ok(entry.to_file(ntfs, fs)?);
+        }
+    }
+    Err("The package is missing a required asset directory".into())
+}
+
+fn walk<T: Read + Seek>(
+    ntfs: &Ntfs,
+    fs: &mut T,
+    dir: &NtfsFile<'_>,
+    prefix: &str,
+    offset: u64,
+    assets: &mut BTreeMap<String, Asset>,
+    depth: usize,
+) -> Result<()> {
+    if depth > 16 || assets.len() >= 8192 {
+        return Err("Invalid persona directory depth or count".into());
+    }
+    let index = dir.directory_index(fs)?;
+    let mut entries = index.entries();
+    while let Some(entry) = entries.next(fs) {
+        let entry = entry?;
+        let Some(key) = entry.key() else {
+            continue;
+        };
+        let name = key?.name().to_string_lossy();
+        if name == "." || name == ".." {
+            continue;
+        }
+        if name.is_empty() || name.contains(['/', '\\', ':', '\0']) {
+            return Err("Invalid NTFS asset path".into());
+        }
+        let path = format!("{prefix}{name}");
+        let file = entry.to_file(ntfs, fs)?;
+        if file.is_directory() {
+            if let Some(relative) = path.strip_prefix("data/resource_packs/")
+                && let Some((pack, relative)) = relative.split_once('/')
+                && crate::library_pack(pack)
+                && !crate::library_directory(relative)
+            {
+                continue;
+            }
+            walk(
+                ntfs,
+                fs,
+                &file,
+                &format!("{path}/"),
+                offset,
+                assets,
+                depth + 1,
+            )?;
+            continue;
+        }
+        let Some(output_path) = crate::asset_path(&path)? else {
+            continue;
+        };
+        let item = file.data(fs, "").ok_or("Missing asset stream")??;
+        let attribute = item.to_attribute()?;
+        let length = attribute.value_length();
+        if length > 32 * 1024 * 1024 {
+            return Err("Persona file is too large".into());
+        }
+        let asset = match attribute.value(fs)? {
+            NtfsAttributeValue::Resident(value) => Asset::Resident(value.data().to_vec()),
+            NtfsAttributeValue::NonResident(value) => {
+                let mut remaining = length;
+                let mut runs = Vec::new();
+                for run in value.data_runs() {
+                    let run = run?;
+                    let start = run
+                        .data_position()
+                        .value()
+                        .ok_or("Sparse persona file")?
+                        .get();
+                    let size = remaining.min(run.allocated_size());
+                    if size == 0 {
+                        break;
+                    }
+                    if !start.is_multiple_of(4096) {
+                        return Err("Unaligned persona segment".into());
+                    }
+                    runs.push(SegmentFile {
+                        offset: offset + start,
+                        length: size,
+                        data_hashs: Vec::new(),
+                        keep_encrypted: false,
+                    });
+                    remaining -= size;
+                }
+                if remaining != 0 {
+                    return Err("Incomplete persona stream".into());
+                }
+                Asset::Segments { length, runs }
+            }
+            NtfsAttributeValue::AttributeListNonResident(_) => {
+                return Err("Unsupported persona attribute-list stream".into());
+            }
+        };
+        if assets.insert(output_path, asset).is_some() {
+            return Err("Duplicate persona file".into());
+        }
+    }
+    Ok(())
+}
+
+struct ReadOnly<T>(T);
+impl<T: Read> Read for ReadOnly<T> {
+    fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+        self.0.read(bytes)
+    }
+}
+impl<T: Seek> Seek for ReadOnly<T> {
+    fn seek(&mut self, position: SeekFrom) -> std::io::Result<u64> {
+        self.0.seek(position)
+    }
+}
+impl<T> Write for ReadOnly<T> {
+    fn write(&mut self, _: &[u8]) -> std::io::Result<usize> {
+        Err(std::io::Error::other("Package is read-only"))
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+impl<T> std::fmt::Debug for ReadOnly<T> {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        f.write_str("ReadOnlyPackage")
+    }
+}
diff --git a/native/persona-assets/src/license.rs b/native/persona-assets/src/license.rs
new file mode 100644
index 0000000..4c2567a
--- /dev/null
+++ b/native/persona-assets/src/license.rs
@@ -0,0 +1,140 @@
+// Adapted from xodus-gaming/xodus (GPL-3.0), https://github.com/xodus-gaming/xodus/commit/a3afa0569332e32ce2677c0edc643ef85477ee3e.
+use xodus::licensing::splicense::{DeviceKey, SPLicense};
+use xodus::models::live::ExchangeUserTokenOutcome;
+use xodus::models::secrets::Token;
+use xodus::models::soap;
+use xodus::tokens::TokenManager;
+
+pub async fn get_license(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    content_id: String,
+    market: String,
+) -> std::result::Result<(DeviceKey, SPLicense), String> {
+    let dev_token = tokens.get_device_sts_token().unwrap();
+    let Token::Legacy(dev_token) = dev_token else {
+        return Err("Invalid STS token".to_string());
+    };
+    let user = tokens.get_user().unwrap();
+    let user_token = tokens.get_user_sts_token().unwrap();
+    let Token::Legacy(legacy) = user_token else {
+        return Err("Unspported user token".to_string());
+    };
+
+    let user_token = xodus::api::live::exchange_user_token(
+        client,
+        legacy,
+        user.username,
+        dev_token,
+        None,
+        Some("Silent".to_string()),
+        "{d6d5a677-0872-4ab0-9442-bb792fce85c5}".to_string(),
+        &[(
+            "www.microsoft.com".to_owned(),
+            Some(soap::PolicyReference::mbi_ssl()),
+        )],
+    )
+    .await
+    .expect("Failed to get ms user token");
+
+    let user_token: Token = match user_token {
+        ExchangeUserTokenOutcome::Fault(_) => {
+            return Err("Failed to get exchange MS token".to_string());
+        }
+        ExchangeUserTokenOutcome::Issued(
+            soap::BodyContent::RequestSecurityTokenResponseCollection(mut collection),
+        ) => {
+            let token = collection.security_tokens.remove(0);
+            token.into()
+        }
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(
+            token,
+        )) => (*token).into(),
+        _ => unreachable!("Only responses are handled"),
+    };
+    let Token::Compact(user_token) = user_token else {
+        return Err("Unsupported token".to_string());
+    };
+
+    get_license_with_token(client, tokens, user_token, user.puid, content_id, market).await
+}
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct StoreAuth {
+    pub access_token: String,
+    pub ticket_reference: String,
+    pub xbox_ticket: String,
+}
+
+impl StoreAuth {
+    pub async fn verify_account(&self, client: &reqwest::Client, xuid: &str) -> Result<(), String> {
+        let user = xodus::api::xbox::authenticate_xbox_user(client, self.xbox_ticket.clone())
+            .await
+            .map_err(|_| "Could not verify the selected account")?;
+        let xbox = xodus::api::xbox::request_xsts_token(client, user.token, "http://xboxlive.com")
+            .await
+            .map_err(|_| "Could not verify the selected account")?;
+        let claims = serde_json::to_value(xbox).map_err(|_| "Invalid Xbox identity")?;
+        if claims
+            .pointer("/DisplayClaims/xui/0/xid")
+            .and_then(|id| id.as_str())
+            != Some(xuid)
+        {
+            return Err("Sign in with the selected Bedrock account".into());
+        }
+        Ok(())
+    }
+}
+
+pub async fn get_license_with_token(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    user_token: String,
+    ticket_reference: String,
+    content_id: String,
+    market: String,
+) -> std::result::Result<(DeviceKey, SPLicense), String> {
+    let dev_token = tokens
+        .get_device_sts_token()
+        .map_err(|_| "Missing device credentials")?;
+    let Token::Legacy(dev_token) = dev_token else {
+        return Err("Invalid device credentials".into());
+    };
+    let ms_device_token = xodus::api::live::exchange_device_token(
+        client,
+        dev_token,
+        "{d6d5a677-0872-4ab0-9442-bb792fce85c5}".to_string(),
+        "www.microsoft.com".to_owned(),
+        Some(soap::PolicyReference::mbi_ssl()),
+    )
+    .await
+    .map_err(|_| "Could not obtain the device licensing token")?;
+
+    let Token::Compact(ms_device_token) = Token::from(ms_device_token) else {
+        return Err("Unsupported device token".into());
+    };
+
+    let (_content, game_license) = xodus::licensing::content::get_license_content(
+        client,
+        ms_device_token,
+        user_token,
+        ticket_reference,
+        content_id,
+        market,
+    )
+    .await
+    .map_err(|err| err.to_string())?;
+
+    let game_splicense = SPLicense::parse_base64(&game_license.splicense_block)
+        .expect("could not parse base64 game SPLicense");
+
+    let dev_license = tokens.get_device_license().unwrap();
+    let device_license = SPLicense::parse_base64(&dev_license.splicense)
+        .expect("could not parse base64 device SPLicense");
+    let key = device_license
+        .encrypted_device_key
+        .unwrap()
+        .derive_device_key();
+    Ok((key, game_splicense))
+}
diff --git a/native/persona-assets/src/main.rs b/native/persona-assets/src/main.rs
new file mode 100644
index 0000000..3e6207a
--- /dev/null
+++ b/native/persona-assets/src/main.rs
@@ -0,0 +1,584 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+mod device;
+mod index;
+mod license;
+mod remote;
+mod store;
+
+use msixvc::{models::xvd::XvdHeader, xvd::XvdFile};
+use msixvc_common::parse::BinaryTryParse;
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    io::{self, Read},
+    path::PathBuf,
+    sync::Arc,
+};
+use tokio::io::{AsyncReadExt, AsyncSeekExt};
+use xodus::tokens::{TokenManager, backend::MemoryBackend};
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Request {
+    store_auth: Option<license::StoreAuth>,
+    url: String,
+    header_sha256: String,
+    package_version: String,
+    xuid: String,
+    state: PathBuf,
+    output: PathBuf,
+}
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+
+#[derive(Debug)]
+struct InteractiveSignInRequired;
+
+impl std::fmt::Display for InteractiveSignInRequired {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("Interactive Microsoft Store sign-in is required")
+    }
+}
+
+impl std::error::Error for InteractiveSignInRequired {}
+
+#[tokio::main]
+async fn main() {
+    // Tokens enter only through private stdin. Receipts never include tokens or license keys.
+    std::panic::set_hook(Box::new(|_| eprintln!("The package service failed")));
+    match run().await {
+        Ok(count) => println!("{}", serde_json::json!({"ok": true, "files": count})),
+        Err(error) => {
+            let response = if error.is::<InteractiveSignInRequired>() {
+                serde_json::json!({"ok": false, "error": "interactive_sign_in_required"})
+            } else {
+                serde_json::json!({"ok": false})
+            };
+            println!("{response}");
+            std::process::exit(1);
+        }
+    }
+}
+
+async fn run() -> Result<usize> {
+    let mut text = String::new();
+    io::stdin().take(32769).read_to_string(&mut text)?;
+    if text.len() > 32768 {
+        return Err("Request is too large".into());
+    }
+    let request: Request = serde_json::from_str(&text)?;
+    acquire(request).await
+}
+
+async fn acquire(request: Request) -> Result<usize> {
+    if request.xuid.is_empty() || !request.xuid.bytes().all(|b| b.is_ascii_digit()) {
+        return Err("Invalid account".into());
+    }
+    let backend = Arc::new(store::FileBackend::new(
+        request.state.clone(),
+        request.xuid.clone(),
+    )?);
+    use fs2::FileExt;
+    let lock = std::fs::OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .read(true)
+        .write(true)
+        .open(request.state.join(".lock"))?;
+    lock.lock_exclusive()?;
+    backend.prune_expired()?;
+    let tokens = TokenManager::new(backend, Arc::new(MemoryBackend::default()));
+    // Browsing can request built-in assets in the background. Without interactive login,
+    // report missing Store credentials before downloading metadata or enrolling a device.
+    if tokens.get_user_sts_token().is_err() && request.store_auth.is_none() {
+        return Err(InteractiveSignInRequired.into());
+    }
+    let client = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(std::time::Duration::from_secs(15))
+        .timeout(std::time::Duration::from_secs(60))
+        .build()?;
+    let mut remote = remote::Remote::new(client.clone(), &request.url).await?;
+    let mut header = XvdHeader::buffer();
+    remote.read_exact(&mut header).await?;
+    if Sha256::digest(header)
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>()
+        != request.header_sha256
+    {
+        return Err("Package identity mismatch".into());
+    }
+    let parsed = XvdHeader::try_from_array(&header)?;
+    if parsed.package_version.to_string() != request.package_version {
+        return Err("Package version mismatch".into());
+    }
+    if let Some(auth) = &request.store_auth {
+        auth.verify_account(&client, &request.xuid).await?;
+    }
+    device::ensure_credentials(&client, &tokens).await?;
+    remote.authenticate(&parsed).await?;
+    remote.seek(std::io::SeekFrom::Start(0)).await?;
+    let package = XvdFile::parse(&mut remote).await?;
+    let user_files = package.parse_user_package_files(&mut remote).await?;
+    let selected = if let Some(metadata) = user_files.get("SegmentMetadata.bin") {
+        let files = package
+            .parse_segment_metadata(&mut remote, metadata)
+            .await?;
+        let mut selected = BTreeMap::new();
+        for (name, file) in files {
+            if let Some(name) = asset_path(&name)? {
+                if file.keep_encrypted {
+                    return Err("Encrypted persona entry".into());
+                }
+                let length = file.length;
+                if selected
+                    .insert(
+                        name,
+                        index::Asset::Segments {
+                            length,
+                            runs: vec![file],
+                        },
+                    )
+                    .is_some()
+                {
+                    return Err("Duplicate persona file".into());
+                }
+            }
+        }
+        selected
+    } else {
+        index::ntfs(&mut remote, &parsed, &package)?
+    };
+    if selected.len() > 8192
+        || selected
+            .values()
+            .any(|file| file.length() > 32 * 1024 * 1024)
+        || selected.values().map(|file| file.length()).sum::<u64>() > 256 * 1024 * 1024
+    {
+        return Err("Persona assets exceed the size limit".into());
+    }
+    if selected.is_empty() {
+        return Err("Package has no persona assets".into());
+    }
+    let (device_key, license) = if let Some(auth) = request.store_auth {
+        license::get_license_with_token(
+            &client,
+            &tokens,
+            auth.access_token,
+            auth.ticket_reference,
+            package.content_id().to_string(),
+            "neutral".into(),
+        )
+        .await?
+    } else {
+        let device = tokens.get_device_sts_token()?;
+        let user = tokens.get_user_sts_token()?;
+        let (
+            xodus::models::secrets::Token::Legacy(device),
+            xodus::models::secrets::Token::Legacy(user),
+        ) = (device, user)
+        else {
+            return Err("Invalid Store credentials".into());
+        };
+        let xbox = xodus::api::xbox::run(&client, device, user, "http://xboxlive.com").await;
+        let claims = serde_json::to_value(&xbox)?;
+        if claims
+            .pointer("/DisplayClaims/xui/0/xid")
+            .and_then(|id| id.as_str())
+            != Some(request.xuid.as_str())
+        {
+            tokens.remove_persistent()?;
+            return Err("Sign in with the selected Bedrock account".into());
+        }
+        license::get_license(
+            &client,
+            &tokens,
+            package.content_id().to_string(),
+            "neutral".into(),
+        )
+        .await?
+    };
+    if license.content_keys.len() != 1 {
+        return Err("Ambiguous package license".into());
+    }
+    let (_, content_key) = license
+        .content_keys
+        .into_iter()
+        .next()
+        .ok_or("Missing package key")?;
+    let key = content_key.unpack(&device_key)?;
+    drop(lock);
+    std::fs::create_dir_all(&request.output)?;
+    for (name, asset) in &selected {
+        let output = match asset {
+            index::Asset::Resident(bytes) => bytes.clone(),
+            index::Asset::Segments { length, runs } => {
+                let mut output = Vec::with_capacity(*length as usize);
+                for file in runs {
+                    let bytes = remote
+                        .bytes(file.offset, file.length.div_ceil(4096) * 4096)
+                        .await?;
+                    for (page, content) in bytes.as_chunks::<4096>().0.iter().enumerate() {
+                        remote.verify_page(file.offset + page as u64 * 4096, content)?;
+                    }
+                    let mut input = std::io::Cursor::new(bytes);
+                    let mut content = Vec::new();
+                    let padded = msixvc::xvd::SegmentFile {
+                        offset: file.offset,
+                        length: file.length.div_ceil(4096) * 4096,
+                        data_hashs: Vec::new(),
+                        keep_encrypted: false,
+                    };
+                    package
+                        .mount_mem_fd(&mut input, &mut content, &padded, *key, |_, _| {})
+                        .await?;
+                    content.truncate(file.length as usize);
+                    output.extend(content);
+                }
+                output
+            }
+        };
+        if output.len() != asset.length() as usize {
+            return Err("Asset length mismatch".into());
+        }
+        let path = request.output.join(name);
+        std::fs::create_dir_all(path.parent().ok_or("Missing parent")?)?;
+        std::fs::write(path, output)?;
+    }
+    Ok(selected.len())
+}
+
+const LIBRARY_DIRECTORIES: [&str; 8] = [
+    "models",
+    "animations",
+    "animation_controllers",
+    "render_controllers",
+    "entity",
+    "sounds",
+    "particles",
+    "texts",
+];
+
+fn library_directory(relative: &str) -> bool {
+    let relative = relative.strip_prefix("__brarchive/").unwrap_or(relative);
+    relative == "__brarchive"
+        || relative == "textures"
+        || relative.starts_with("textures/")
+        || LIBRARY_DIRECTORIES.iter().any(|directory| {
+            relative == *directory || relative.starts_with(&format!("{directory}/"))
+        })
+}
+
+fn library_asset(relative: &str) -> bool {
+    if let Some(archive) = relative.strip_prefix("__brarchive/") {
+        return archive
+            .strip_suffix(".brarchive")
+            .is_some_and(|directory| directory != "__brarchive" && library_directory(directory));
+    }
+    matches!(relative, "manifest.json" | "sounds.json")
+        || relative.ends_with(".json")
+            && LIBRARY_DIRECTORIES
+                .iter()
+                .any(|directory| relative.starts_with(&format!("{directory}/")))
+        || relative.starts_with("texts/") && relative.ends_with(".lang")
+        || relative.starts_with("sounds/")
+            && (relative.ends_with(".fsb")
+                || relative.ends_with(".ogg")
+                || relative.ends_with(".wav"))
+        || relative.starts_with("textures/")
+            && (relative.ends_with(".png")
+                || relative.ends_with(".jpg")
+                || relative.ends_with(".tga"))
+}
+
+fn library_pack(name: &str) -> bool {
+    if matches!(name, "vanilla" | "vanilla_base") {
+        return true;
+    }
+    let Some(version) = name.strip_prefix("vanilla_") else {
+        return false;
+    };
+    let parts: Vec<_> = version.split('.').collect();
+    (2..=3).contains(&parts.len())
+        && parts.iter().all(|part| {
+            !part.is_empty()
+                && (part.len() == 1 || !part.starts_with('0'))
+                && part.bytes().all(|byte| byte.is_ascii_digit())
+                && part.parse::<i32>().is_ok()
+        })
+}
+
+fn asset_path(path: &str) -> Result<Option<String>> {
+    let path = path.replace('\\', "/");
+    let Some(path) = path.strip_prefix("data/resource_packs/") else {
+        return Ok(None);
+    };
+    let Some((pack, relative)) = path.split_once('/') else {
+        return Ok(None);
+    };
+    if pack != "persona" && !library_pack(pack) {
+        return Ok(None);
+    }
+    if relative.is_empty()
+        || relative.split('/').any(|part| {
+            part.is_empty()
+                || part == "."
+                || part == ".."
+                || part.contains(':')
+                || part.contains('\0')
+        })
+    {
+        return Err("Invalid persona path".into());
+    }
+    if pack == "persona" {
+        return Ok(Some(relative.to_owned()));
+    }
+    if !library_asset(relative) {
+        return Ok(None);
+    }
+    Ok(Some(format!("library/{pack}/{relative}")))
+}
