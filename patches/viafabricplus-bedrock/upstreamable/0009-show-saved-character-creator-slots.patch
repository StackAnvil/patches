+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Alias and locator declarations in timeline or controller entry order. */
+public record BedrockAnimationSound(float time, String effect, String locator) {
+    static List<BedrockAnimationSound> read(final JsonElement declared) throws IOException {
+        if (declared == null) return List.of();
+        if (!declared.isJsonObject() || declared.getAsJsonObject().size() > 4096)
+            throw new IOException("Invalid animation sound timeline");
+        final List<BedrockAnimationSound> entries = new ArrayList<>();
+        try {
+            for (final var entry : declared.getAsJsonObject().entrySet()) {
+                final float time = Float.parseFloat(entry.getKey());
+                if (!Float.isFinite(time) || time < 0 || time > 600)
+                    throw new IOException("Invalid animation sound time");
+                final var value = entry.getValue();
+                if (value.isJsonArray()) {
+                    for (final JsonElement sound : value.getAsJsonArray()) add(entries, time, sound);
+                } else add(entries, time, value);
+            }
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid animation sound declaration", invalid);
+        }
+        entries.sort(Comparator.comparingDouble(BedrockAnimationSound::time));
+        return List.copyOf(entries);
+    }
+
+    static List<BedrockAnimationSound> entries(final JsonElement declared) throws IOException {
+        if (declared == null) return List.of();
+        if (!declared.isJsonArray() || declared.getAsJsonArray().size() > 4096)
+            throw new IOException("Invalid controller sound list");
+        final List<BedrockAnimationSound> entries = new ArrayList<>();
+        try {
+            for (final JsonElement value : declared.getAsJsonArray()) add(entries, 0, value);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid controller sound declaration", invalid);
+        }
+        return List.copyOf(entries);
+    }
+
+    private static void add(final List<BedrockAnimationSound> entries, final float time, final JsonElement value)
+            throws IOException {
+        if (!value.isJsonObject() || entries.size() >= 4096)
+            throw new IOException("Invalid animation sound entry");
+        final JsonObject object = value.getAsJsonObject();
+        entries.add(new BedrockAnimationSound(time, name(object.get("effect")), name(object.get("locator"))));
+    }
+
+    private static String name(final JsonElement value) throws IOException {
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) return "";
+        final String name = value.getAsString();
+        if (name.length() > 512 || name.indexOf('\0') >= 0) throw new IOException("Invalid animation sound name");
+        return name;
+    }
+}
