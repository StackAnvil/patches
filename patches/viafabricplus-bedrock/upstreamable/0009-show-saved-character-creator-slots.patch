+import java.lang.reflect.Proxy;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+final class BedrockPlayerActorStateTest {
+    @Test
+    void snapshotsAcceptedFlagsAndKeepsConnectionsSeparate() {
+        final UserConnection connection = connection();
+        final UUID id = UUID.randomUUID();
+        final PlayerEntity player = player(connection, id);
+        assertFalse(BedrockPlayerActorState.isCharging(null, id));
+        assertFalse(BedrockPlayerActorState.isCharging(connection, id));
+        flags(player, 1L << ActorFlags.CHARGING.getValue());
+        BedrockPlayerActorState.update(connection, player);
+        flags(player, 1L << ActorFlags.USINGITEM.getValue());
+        assertTrue(BedrockPlayerActorState.isCharging(connection, id));
+        assertFalse(BedrockPlayerActorState.isCharging(connection(), id));
+        BedrockPlayerActorState.update(connection, player);
+        assertFalse(BedrockPlayerActorState.isCharging(connection, id));
+        flags(player, Long.MIN_VALUE | (1L << ActorFlags.CHARGING.getValue()));
+        BedrockPlayerActorState.update(connection, player);
+        assertTrue(BedrockPlayerActorState.isCharging(connection, id));
+        connection.remove(BedrockPlayerActorState.class);
+        assertFalse(BedrockPlayerActorState.isCharging(connection, id));
+    }
+
+    @Test
+    void removingAnOldActorDoesNotRemoveItsReplacement() {
+        final UserConnection connection = connection();
+        final UUID id = UUID.randomUUID();
+        final PlayerEntity old = player(connection, id);
+        final PlayerEntity replacement = player(connection, id);
+        BedrockPlayerActorState.update(connection, old);
+        flags(replacement, 1L << ActorFlags.CHARGING.getValue());
+        BedrockPlayerActorState.update(connection, replacement);
+        BedrockPlayerActorState.remove(connection, old);
+        assertTrue(BedrockPlayerActorState.isCharging(connection, id));
+        BedrockPlayerActorState.remove(connection, replacement);
+        assertFalse(BedrockPlayerActorState.isCharging(connection, id));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_ITEM_ACTIONS", matches = ".+")
+    void matchesTargetChargingQuery() throws Exception {
+        final Path fixture =
+                Path.of(System.getenv("STACKANVIL_ITEM_ACTIONS"), "native-charging.json");
+        for (final var raw : JsonParser.parseString(Files.readString(fixture)).getAsJsonArray()) {
+            final var row = raw.getAsJsonObject();
+            final UserConnection connection = connection();
+            final UUID id = UUID.randomUUID();
+            final PlayerEntity player = player(connection, id);
+            if (row.get("actor").getAsBoolean()) {
+                flags(
+                        player,
+                        row.get("charging").getAsBoolean()
+                                ? 1L << ActorFlags.CHARGING.getValue()
+                                : 0L);
+                BedrockPlayerActorState.update(connection, player);
+            }
+            assertEquals(
+                    row.get("value").getAsFloat() != 0F,
+                    BedrockPlayerActorState.isCharging(connection, id),
+                    row.toString());
+        }
+    }
+
+    private static PlayerEntity player(final UserConnection connection, final UUID id) {
+        return new PlayerEntity(connection, 1, 1, id, new PlayerAbilities(1, (byte) 0, (byte) 0));
+    }
+
+    private static void flags(final PlayerEntity player, final long flags) {
+        player.entityData()
+                .put(
+                        ActorDataIds.RESERVED_0,
+                        new EntityData(
+                                ActorDataIds.RESERVED_0.getValue(),
+                                EntityDataTypesBedrock.LONG,
+                                flags));
+    }
+
+    private static UserConnection connection() {
+        final Map<Class<?>, StorableObject> storage = new ConcurrentHashMap<>();
+        return (UserConnection)
+                Proxy.newProxyInstance(
+                        UserConnection.class.getClassLoader(),
+                        new Class<?>[] {UserConnection.class},
+                        (_, method, arguments) ->
+                                switch (method.getName()) {
+                                    case "get" -> storage.get(arguments[0]);
+                                    case "put" ->
+                                            storage.put(
+                                                    arguments[0].getClass(),
+                                                    (StorableObject) arguments[0]);
+                                    case "remove" -> storage.remove(arguments[0]);
+                                    default ->
+                                            throw new UnsupportedOperationException(
+                                                    method.getName());
+                                });
+    }
+}
