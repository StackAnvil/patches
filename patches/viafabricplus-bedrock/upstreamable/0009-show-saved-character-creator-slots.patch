+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.blaze3d.Blaze3D;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import java.io.IOException;
+import java.net.URI;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.atomic.AtomicReference;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.MultiLineTextWidget;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.network.chat.Component;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.minecraftauth.msa.model.MsaDeviceCode;
+import net.raphimc.minecraftauth.msa.model.MsaToken;
+import net.raphimc.minecraftauth.msa.service.impl.DeviceCodeMsaAuthService;
+
+/** Keeps optional browser authentication cancellable without interrupting pack preparation. */
+final class BedrockStoreBrowser {
+    private BedrockStoreBrowser() {}
+
+    static MsaToken signIn(final BedrockAuthManager account) throws Exception {
+        final Minecraft client = Minecraft.getInstance();
+        if (client.isSameThread()) throw new IllegalStateException("Store sign-in must run outside the game thread");
+        final var service = new DeviceCodeMsaAuthService(account.getHttpClient(), account.getMsaApplicationConfig(), null, 900_000);
+        final var code = service.requestDeviceCode();
+        final Session session = new Session(() -> service.getToken(code));
+        final AtomicReference<SignInScreen> shown = new AtomicReference<>();
+        client.execute(() -> {
+            if (session.task.isDone()) return;
+            final SignInScreen screen = new SignInScreen(client, client.gui.screen(), session, code);
+            shown.set(screen);
+            client.gui.setScreen(screen);
+            openBrowser(code);
+        });
+        try {
+            return session.await();
+        } finally {
+            session.cancel();
+            client.execute(() -> {
+                final SignInScreen screen = shown.get();
+                if (screen != null && client.gui.screen() == screen) client.gui.setScreen(screen.previous);
+            });
+        }
+    }
+
+    private static void openBrowser(final MsaDeviceCode code) {
+        try {
+            Blaze3D.openUri(URI.create(code.getDirectVerificationUri()));
+        } catch (RuntimeException failure) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not open the Store sign-in browser");
+        }
+    }
+
+    static final class Session {
+        private final FutureTask<MsaToken> task;
+
+        Session(final Callable<MsaToken> authenticate) {
+            this.task = new FutureTask<>(authenticate);
+            Thread.ofVirtual().name("Bedrock Store browser sign-in").start(this.task);
+        }
+
+        MsaToken await() throws Exception {
+            try {
+                return this.task.get();
+            } catch (CancellationException cancelled) {
+                throw new SignInCancelledException();
+            } catch (ExecutionException failure) {
+                if (failure.getCause() instanceof Exception error) throw error;
+                throw new IOException("Store sign-in failed", failure.getCause());
+            }
+        }
+
+        void cancel() {
+            this.task.cancel(true);
+        }
+    }
+
+    static final class SignInCancelledException extends IOException {
+        SignInCancelledException() {
+            super("Microsoft Store sign-in was cancelled");
+        }
+    }
+
+    private static final class SignInScreen extends Screen {
+        private final Minecraft client;
+        private final Screen previous;
+        private final Session session;
+        private final MsaDeviceCode code;
+
+        SignInScreen(final Minecraft client, final Screen previous, final Session session, final MsaDeviceCode code) {
+            super(Component.translatable("bedrock_store.viafabricplus.browser.title"));
+            this.client = client;
+            this.previous = previous;
+            this.session = session;
+            this.code = code;
+        }
+
+        @Override
+        protected void init() {
+            final int contentWidth = Math.min(360, this.width - 40);
+            final int top = this.height / 3;
+            final var message = new MultiLineTextWidget(Component.translatable("bedrock_store.viafabricplus.browser.message"), this.font)
+                .setMaxWidth(contentWidth).setCentered(true);
+            message.setPosition((this.width - message.getWidth()) / 2, top);
+            this.addRenderableWidget(message);
+            final var code = new MultiLineTextWidget(Component.translatable("bedrock_store.viafabricplus.browser.code", this.code.getUserCode()), this.font)
+                .setMaxWidth(contentWidth).setCentered(true);
+            code.setPosition((this.width - code.getWidth()) / 2, top + message.getHeight() + 12);
+            this.addRenderableWidget(code);
+            final int row = code.getY() + code.getHeight() + 20;
+            final int buttonWidth = (contentWidth - 16) / 3;
+            final int left = (this.width - contentWidth) / 2;
+            this.addRenderableWidget(Button.builder(Component.translatable("bedrock_store.viafabricplus.browser.open"),
+                button -> openBrowser(this.code)).bounds(left, row, buttonWidth, 20).build());
+            this.addRenderableWidget(Button.builder(Component.translatable("base.viafabricplus.copy_link"),
+                button -> this.client.keyboardHandler.setClipboard(this.code.getDirectVerificationUri()))
+                .bounds(left + buttonWidth + 8, row, buttonWidth, 20).build());
+            this.addRenderableWidget(Button.builder(Component.translatable("gui.cancel"), button -> this.onClose())
+                .bounds(left + 2 * (buttonWidth + 8), row, buttonWidth, 20).build());
+        }
+
+        @Override
+        public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+            super.extractRenderState(graphics, mouseX, mouseY, delta);
+            graphics.centeredText(this.font, this.title, this.width / 2, this.height / 3 - 25, -1);
+        }
+
+        @Override
+        public void onClose() {
+            this.session.cancel();
+            this.client.gui.setScreen(this.previous);
+        }
+
+        @Override
+        public void removed() {
+            this.session.cancel();
+            super.removed();
+        }
+    }
+}
