+final class BedrockParticleCurvesTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesCurvesExecutedFromTheTargetClient() throws Exception {
+        final var fixture = json(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"))
+                .resolve("native-particle-curves-result.json")));
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var curve = new JsonObject();
+            curve.add("type", row.get("type"));
+            curve.add("nodes", row.get("nodes"));
+            curve.add("input", row.get("input"));
+            if (row.has("range")) curve.add("horizontal_range", row.get("range"));
+            final var curves = new JsonObject();
+            curves.add("variable.native", curve);
+            final var environment = new BedrockMolang();
+            environment.variable("native", 7);
+            BedrockParticleCurves.read(curves).apply(environment);
