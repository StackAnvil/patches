+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleAgingTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeBirthMotionExpiryAndCapacityOrder() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-aging-result.json"))).getAsJsonObject();
+        int updates = 0;
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var config = row.getAsJsonObject("config");
+            final var document = BedrockParticleEffectTest.burst();
+            final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+            components.add("minecraft:emitter_lifetime_once", json("{\"active_time\":10}"));
+            if (config.get("rate").getAsString().equals("steady")) {
+                components.remove("minecraft:emitter_rate_instant");
+                final var steady = json("{\"spawn_rate\":20}");
+                steady.add("max_particles", config.get("capacity"));
+                components.add("minecraft:emitter_rate_steady", steady);
+            }
+            final float lifetime = (float) config.get("lifetime_nanos").getAsLong() / 1_000_000_000F;
+            final var expiry = new JsonObject();
+            expiry.addProperty("max_lifetime", lifetime);
+            expiry.addProperty("expiration_expression", "q.expire(v.particle_age)");
+            components.add("minecraft:particle_lifetime_expression", expiry);
+            components.add("minecraft:particle_initialization", json("""
+                    {"creation_expression":"q.born();",
+                     "per_update_expression":"q.update(v.particle_age);"}
+                    """));
+            components.add("minecraft:emitter_shape_point", json("{\"offset\":[\"q.birth_position()\",0,0]}"));
+            components.add("minecraft:particle_initial_speed", JsonParser.parseString("[2,-1,0.5]"));
+            components.add("minecraft:particle_motion_dynamic", json("{\"linear_acceleration\":[1,2,-0.5]}"));
+            components.add("minecraft:particle_appearance_billboard", json("{\"size\":[\"v.particle_age\",1]}"));
+            final List<Callback> observed = new ArrayList<>();
+            final int[] born = {0};
+            final var environment = new BedrockMolang();
+            environment.queries(Map.of(
+                    "birth_position", (BedrockActorAnimation.Query) _ -> born[0] + 1,
+                    "born", (BedrockActorAnimation.Query) _ -> { observed.add(new Callback("birth", 0)); return ++born[0]; },
+                    "update", (BedrockActorAnimation.Query) args -> { observed.add(new Callback("update", ((Number) args.getFirst()).floatValue())); return 0; },
+                    "expire", (BedrockActorAnimation.Query) args -> {
+                        observed.add(new Callback("expiration", ((Number) args.getFirst()).floatValue()));
+                        return config.get("expire").getAsBoolean() ? 1 : 0;
+                    }), 0, 0, 0);
+            final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1), Vec3.ZERO);
+            for (final var item : row.getAsJsonArray("steps")) {
+                final var step = item.getAsJsonObject();
+                observed.clear();
+                final int previousBirths = born[0];
+                emitter.advance(step.get("nanos").getAsLong(), 1000, null, (x, y, z) -> List.of());
+                assertEquals(step.get("births").getAsInt(), born[0] - previousBirths, "update " + updates);
+                final List<Callback> expectedCallbacks = new ArrayList<>();
+                for (final var event : step.getAsJsonArray("events")) {
+                    if (!event.isJsonObject()) continue;
+                    final var eventObject = event.getAsJsonObject();
+                    final String phase = eventObject.get("phase").getAsString();
+                    if (phase.equals("birth")) expectedCallbacks.add(new Callback(phase, 0));
+                    else if (phase.equals("update") || phase.equals("expiration"))
+                        expectedCallbacks.add(new Callback(phase, Math.min((float) eventObject.get("age").getAsLong() / 1_000_000_000F, lifetime)));
+                }
+                assertEquals(expectedCallbacks, observed, "update " + updates);
+                final var expected = step.getAsJsonArray("particles");
+                final var actual = emitter.visuals();
+                assertEquals(expected.size(), actual.size(), "update " + updates);
+                for (int index = 0; index < expected.size(); index++) {
+                    final var particle = expected.get(index).getAsJsonObject();
+                    final var position = particle.getAsJsonArray("position");
+                    for (int axis = 0; axis < 3; axis++)
+                        assertEquals(position.get(axis).getAsFloat(), actual.get(index).position().get(axis), "update " + updates);
+                    assertEquals(Math.min((float) particle.get("age").getAsLong() / 1_000_000_000F, lifetime), actual.get(index).width());
+                }
+                updates++;
+            }
+        }
+        assertEquals(360, updates);
+    }
+
+    @Test
+    void separatesUpdateAndRenderExpressionsAndClampsRenderAge() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:particle_initialization", json("""
+                {"per_update_expression":"v.updates=v.updates+1; v.sample=v.particle_age;",
+                 "per_render_expression":"v.renders=v.renders+1;"}
+                """));
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":0.05}"));
+        components.add("minecraft:particle_appearance_billboard", json("""
+                {"size":["v.updates*100+v.renders","v.sample+v.particle_age"]}
+                """));
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        emitter.advance(75_000_000, 10, null, (x, y, z) -> List.of());
+        final var first = emitter.visuals().getFirst();
+        assertEquals(101, first.width());
+        assertEquals(.05F, first.height());
+        assertEquals(102, emitter.visuals().getFirst().width());
+        emitter.advance(0, 10, null, (x, y, z) -> List.of());
+        assertEquals(0, emitter.size());
+    }
+
+    private record Callback(String phase, float age) {}
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+}
