+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+/** Bounded particle atlas decoding for PNG and true-color TGA resources. */
+final class BedrockParticleTexture {
+    private BedrockParticleTexture() {}
+
+    static BufferedImage read(final byte[] bytes) throws IOException {
+        try {
+            return bytes != null && bytes.length >= 8 && ByteBuffer.wrap(bytes).getLong() == 0x89504E470D0A1A0AL
+                    ? BedrockPersonaAnimations.image(bytes) : BedrockPersonaSources.tga(bytes);
+        } catch (IOException invalid) {
+            throw new IOException("The Bedrock particle texture is invalid", invalid);
+        }
+    }
+}
