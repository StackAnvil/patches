+    @Test
+    void separatesCharacterSlotsFromTheAccountSettingsProfile() throws Exception {
+        final JsonObject profiles = JsonParser.parseString("""
+            {"result":[
+              {"slotname":"personaProfile3","version":"0.0.1","profileHash":"third","personaCollection":{"universalApp":[
+                {"arm":"slim","cs_arm":"slim","skcol":"#ffccaa","skin":false},{"id":"hat"},{"col":["#ff0000","#0"],"id":"top"}]}},
+              {"slotname":"personaProfile1","version":"0.0.1","profileHash":"first","personaCollection":{"universalApp":[
+                {"arm":"wide","skcol":"#aabbcc","skin":"base"},{"id":"hair"}]}},
+              {"slotname":"personaProfile2","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile4","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile5","version":"0.0.1","personaCollection":{"universalApp":[]}},
+              {"slotname":"personaProfile","version":"0.1.0","personaCollection":{"universalApp":[
+                {"id":"settings","lastUsedPersonaSlot":"persona_profile_persona3","isPlatformLocked":false}]}}
+            ],"profileVersion":70}
+            """).getAsJsonObject();
+        final var wardrobe = BedrockCharacterProfiles.parse(profiles);
+
+        assertEquals(5, wardrobe.slots().size());
+        assertEquals("wide", wardrobe.slots().getFirst().arm());
+        assertEquals("#aabbcc", wardrobe.slots().getFirst().skinColor());
+        assertEquals(1, wardrobe.slots().getFirst().pieceIds().size());
+        assertFalse(wardrobe.slots().get(1).occupied());
+        assertTrue(wardrobe.slots().get(2).occupied());
+        assertEquals(2, wardrobe.slots().get(2).pieceIds().size());
+        assertEquals(3, wardrobe.activeSlot());
+        assertEquals(70, wardrobe.profileVersion());
+        assertEquals("slim", wardrobe.slots().get(2).profile().getAsJsonObject("personaCollection")
+            .getAsJsonArray("universalApp").get(0).getAsJsonObject().get("cs_arm").getAsString());
+
+        final JsonObject selection = BedrockCharacterProfiles.selectionRequest(wardrobe, 1);
+        final var objects = selection.getAsJsonArray("appearanceObjects");
+        assertEquals(2, objects.size());
+        final var settings = objects.get(0).getAsJsonObject().getAsJsonObject("personaAppearance");
+        assertEquals("persona_profile_persona1", settings.getAsJsonObject("personaCollection")
+            .getAsJsonArray("universalApp").get(0).getAsJsonObject().get("lastUsedPersonaSlot").getAsString());
+        assertFalse(settings.getAsJsonObject("personaCollection").getAsJsonArray("universalApp")
+            .get(0).getAsJsonObject().get("isPlatformLocked").getAsBoolean());
+        assertEquals("persona_profile_persona3", wardrobe.settingsProfile().getAsJsonObject("personaCollection")
+            .getAsJsonArray("universalApp").get(0).getAsJsonObject().get("lastUsedPersonaSlot").getAsString());
+        assertEquals("base", objects.get(1).getAsJsonObject().getAsJsonObject("personaAppearance")
+            .getAsJsonObject("personaCollection").getAsJsonArray("universalApp")
+            .get(0).getAsJsonObject().get("skin").getAsString());
+    }
+
+    @Test
+    void readsFreeAndOwnedPersonaPiecesFromTheNativeLayout() {
+        final JsonObject response = JsonParser.parseString("""
+            {"result":{"layout":[{"rows":[{"components":[{"items":[
+              {"id":"free","contentType":"PersonaDurable","title":"Blue Hat","pieceType":"persona_head",
+                "thumbnail":{"url":"https://example.test/hat.png"},"price":{"listPrice":0},
