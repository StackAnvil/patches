+    private void saveSize(final BedrockAuthManager account, final Slot slot,
+                          final CompletableFuture<AccountWardrobe> operation) {
+        this.saving = true;
+        this.editFailed = false;
+        this.updateControls();
+        operation.whenComplete((loaded, error) -> this.minecraft.execute(() -> {
+            if (this.minecraft.gui.screen() != this) {
+                return;
+            }
+            this.saving = false;
+            if (error != null) {
+                this.editFailed = true;
+                ViaFabricPlusBedrock.impl().logger().warn("Could not change Bedrock character size", error);
+            } else {
+                this.wardrobe = loaded;
+                if (loaded.activeSlot() == slot.number()) {
