+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.llamalad7.mixinextras.sugar.Local;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.render.BedrockSignText;
+import java.util.function.Function;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.renderer.blockentity.AbstractSignRenderer;
+import net.minecraft.client.renderer.blockentity.state.HangingSignRenderState;
+import net.minecraft.client.renderer.blockentity.state.SignRenderState;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.world.level.block.entity.SignText;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+
+/** Bedrock wraps long sign lines into the following rows. Java clips each line at the sign's width. */
+@Mixin(AbstractSignRenderer.class)
+public abstract class MixinAbstractSignRenderer {
+    @Shadow @Final private Font font;
+
+    @WrapOperation(method = "submitSignText", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/world/level/block/entity/SignText;getRenderMessages(ZLjava/util/function/Function;)[Lnet/minecraft/util/FormattedCharSequence;"),
+            require = 1, allow = 1)
+    private FormattedCharSequence[] wrapBedrockRows(final SignText text, final boolean filtered,
+                                                    final Function<Component, FormattedCharSequence> prepare,
+                                                    final Operation<FormattedCharSequence[]> original,
+                                                    @Local(argsOnly = true) final SignRenderState state) {
+        if (!BedrockInputPermissions.isBedrockConnection()) return original.call(text, filtered, prepare);
+        final int width = state instanceof HangingSignRenderState ? BedrockSignText.HANGING_WIDTH : BedrockSignText.STANDING_WIDTH;
+        return original.call(text, filtered, BedrockSignText.rows(this.font, text.getMessages(filtered), width));
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignText.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignText.java
new file mode 100644
index 0000000000000000000000000000000000000000..6f3e65598c54259b7bccc18da83fb4df56481d3e
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignText.java
@@ -0,0 +1,163 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.Function;
+import java.util.function.ToIntFunction;
+import net.minecraft.client.gui.Font;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.Style;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.util.StringDecomposer;
+
+/**
+ * Wraps sign text into rows like the Bedrock 1.26.60.5 client. The native layout (0x140e69dd0) breaks lines at spaces
+ * and line breaks, and all lines share one budget of four rows. A word wider than the row is broken with a hyphen
+ * (0x140e6b010). Java clips each line at the row width instead.
+ */
+public final class BedrockSignText {
+    public static final int STANDING_WIDTH = 89;
+    public static final int HANGING_WIDTH = 60;
+    static final int ROWS = 4;
+
+    private BedrockSignText() {}
+
+    /**
+     * Prepares the messages of one sign face for {@code SignText.getRenderMessages}, which caches the result. The
+     * first message lays out the whole face. Each call then returns the next row.
+     */
+    public static Function<Component, FormattedCharSequence> rows(final Font font, final List<Component> messages, final int width) {
+        final FormattedCharSequence[][] rows = {null};
+        final int[] next = {0};
+        return message -> {
+            if (rows[0] == null) rows[0] = rows(messages, width, glyphs -> font.width(sequence(glyphs)));
+            return next[0] < rows[0].length ? rows[0][next[0]++] : FormattedCharSequence.EMPTY;
+        };
+    }
+
+    static FormattedCharSequence[] rows(final List<Component> messages, final int width, final ToIntFunction<List<Glyph>> measure) {
+        final List<List<Glyph>> lines = new ArrayList<>(messages.size());
+        for (final Component message : messages) {
+            final List<Glyph> line = new ArrayList<>();
+            StringDecomposer.iterateFormatted(message, Style.EMPTY, (index, style, codePoint) -> line.add(new Glyph(codePoint, style)));
+            lines.add(line);
+        }
+        final FormattedCharSequence[] result = new FormattedCharSequence[messages.size()];
+        Arrays.fill(result, FormattedCharSequence.EMPTY);
+        final List<List<Glyph>> rows = layout(lines, width, measure);
+        for (int i = 0; i < Math.min(result.length, rows.size()); i++) result[i] = sequence(rows.get(i));
+        return result;
+    }
+
+    /** Lays out the lines into at most four rows of at most {@code width} units. */
+    static List<List<Glyph>> layout(final List<List<Glyph>> lines, final int width, final ToIntFunction<List<Glyph>> measure) {
+        final List<List<Glyph>> rows = new ArrayList<>(ROWS);
+        final int hyphenWidth = measure.applyAsInt(List.of(new Glyph('-', Style.EMPTY)));
+        for (final List<Glyph> line : lines) {
+            if (rows.size() == ROWS) break;
+            if (line.isEmpty()) rows.add(line);
+            else wrap(line, width, hyphenWidth, measure, rows);
+        }
+        return rows;
+    }
+
+    private static void wrap(final List<Glyph> line, final int width, final int hyphenWidth,
+                             final ToIntFunction<List<Glyph>> measure, final List<List<Glyph>> rows) {
+        List<Glyph> current = List.of();
+        int start = 0;
+        while (start < line.size()) {
+            // A token is one space or one word.
+            int end = start + 1;
+            if (line.get(start).codePoint() != ' ') {
+                while (end < line.size() && line.get(end).codePoint() != ' ') end++;
+            }
+            final List<Glyph> token = line.subList(start, end);
+            start = end;
+            final List<Glyph> candidate = concat(current, token);
+            if (measure.applyAsInt(candidate) <= width) {
+                current = candidate;
+            } else if (measure.applyAsInt(token) >= width) {
+                // The word fills the current row and continues on the next rows.
+                List<Glyph> text = candidate;
+                do {
+                    final Split split = split(text, width, hyphenWidth, measure);
+                    rows.add(split.head());
+                    if (rows.size() == ROWS) return;
+                    current = token.subList(Math.max(0, token.size() - split.tail()), token.size());
+                    text = current;
+                } while (measure.applyAsInt(current) >= width);
+            } else {
+                // A space that does not fit stays at the end of its row.
+                final boolean space = token.getFirst().codePoint() == ' ';
+                rows.add(space ? candidate : current);
+                if (rows.size() == ROWS) return;
+                current = space ? List.of() : token;
+            }
+        }
+        if (!current.isEmpty()) rows.add(current);
+    }
+
+    /** Splits the longest fitting head from the text. A hyphen marks a break inside a word. */
+    private static Split split(final List<Glyph> text, final int width, final int hyphenWidth, final ToIntFunction<List<Glyph>> measure) {
+        final int plain = fit(text, width, 0, measure);
+        if (!hyphenates(text, plain)) return new Split(text.subList(0, plain), text.size() - plain);
+        final int hyphenated = fit(text, width, hyphenWidth, measure);
+        if (!hyphenates(text, hyphenated)) return new Split(text.subList(0, plain), text.size() - plain);
+        final List<Glyph> head = new ArrayList<>(text.subList(0, hyphenated));
+        head.add(new Glyph('-', head.getLast().style()));
+        return new Split(head, text.size() - hyphenated);
+    }
+
+    /** The native search drops one character at a time from the end, but always keeps one. */
+    private static int fit(final List<Glyph> text, final int width, final int extra, final ToIntFunction<List<Glyph>> measure) {
+        int length = text.size();
+        while (length >= 2 && measure.applyAsInt(text.subList(0, length)) + extra > width) length--;
+        return length;
+    }
+
+    /** Native 0x140e6bbc0: no hyphen at either end of the text, next to a hyphen, after a space or beside wide script. */
+    private static boolean hyphenates(final List<Glyph> text, final int split) {
+        if (split == 0 || split == text.size()) return false;
+        final int left = text.get(split - 1).codePoint();
+        final int right = text.get(split).codePoint();
+        return left != '-' && right != '-' && left != ' ' && !wide(left) && !wide(right);
+    }
+
+    private static boolean wide(final int codePoint) {
+        return codePoint >= 0x1100 && codePoint <= 0x11FF
+                || codePoint >= 0x2329 && codePoint <= 0x232A
+                || codePoint >= 0x2E80 && codePoint <= 0xA4CF
+                || codePoint >= 0xAC00 && codePoint <= 0xD7FF
+                || codePoint >= 0xF900 && codePoint <= 0xFAFF
+                || codePoint >= 0xFE10 && codePoint <= 0xFE6F
+                || codePoint >= 0xFF01 && codePoint <= 0xFFEF
+                || codePoint >= 0x1B000 && codePoint <= 0x1B16F
+                || codePoint >= 0x20000 && codePoint <= 0x323AF;
+    }
+
+    private static List<Glyph> concat(final List<Glyph> first, final List<Glyph> second) {
+        final List<Glyph> result = new ArrayList<>(first.size() + second.size());
+        result.addAll(first);
+        result.addAll(second);
+        return result;
+    }
+
+    private static FormattedCharSequence sequence(final List<Glyph> glyphs) {
+        return sink -> {
+            for (int i = 0; i < glyphs.size(); i++) {
+                if (!sink.accept(i, glyphs.get(i).style(), glyphs.get(i).codePoint())) return false;
+            }
+            return true;
+        };
+    }
+
+    record Glyph(int codePoint, Style style) {}
+
+    private record Split(List<Glyph> head, int tail) {}
+}
