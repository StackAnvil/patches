diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignTextTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignTextTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2074fb855b4a160ab3289a77c00122de75fbd7b4
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockSignTextTest.java
@@ -0,0 +1,112 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.ChatFormatting;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.Style;
+import net.minecraft.network.chat.TextColor;
+import net.minecraft.util.FormattedCharSequence;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class BedrockSignTextTest {
+    @Test
+    void longLinesWrapAtSpacesAndPushLaterLinesOutOfTheFourRows() {
+        // 8 + 1 + 8 glyphs are 100 units wide, more than the 89-unit standing sign row.
+        final var rows = rows(BedrockSignText.STANDING_WIDTH, "aaaaaaaa bbbbbbbb", "second", "third", "fourth");
+        assertEquals(List.of("aaaaaaaa ", "bbbbbbbb", "second", "third"), rows);
+    }
+
+    @Test
+    void wordsWiderThanTheRowBreakWithHyphensInTheirOwnColor() {
+        final var red = Style.EMPTY.withColor(ChatFormatting.RED);
+        final FormattedCharSequence[] rows = BedrockSignText.rows(
+            List.of(Component.literal("abcdefghijkl").setStyle(red), Component.empty(), Component.empty(), Component.empty()),
+            30, true, BedrockSignTextTest::width);
+        assertEquals(List.of("abcd-", "efgh-", "ijkl", ""), text(rows));
+        final Set<TextColor> colors = new HashSet<>();
+        for (final FormattedCharSequence row : rows) colors.addAll(colors(row));
+        assertEquals(Set.of(red.getColor()), colors);
+    }
+
+    @Test
+    void withoutPersistFormattingWrappedRowsKeepOnlyTheirOwnFormatting() {
+        // ViaBedrock gives the line's root the sign color and each formatting code its own part.
+        final Style black = Style.EMPTY.withColor(0x000000);
+        final Style red = Style.EMPTY.withColor(ChatFormatting.RED);
+        final List<Component> messages = List.of(
+            Component.empty().setStyle(black).append(Component.literal("abcdefgh").setStyle(red)),
+            Component.empty().setStyle(black).append(Component.literal("aa ")).append(Component.literal("bbbb").setStyle(red)),
+            Component.empty(), Component.empty());
+        final FormattedCharSequence[] reset = BedrockSignText.rows(messages, 30, false, BedrockSignTextTest::width);
+        assertEquals(List.of("abcd-", "efgh", "aa ", "bbbb"), text(reset));
+        assertEquals(Set.of(red.getColor()), colors(reset[0]));
+        assertEquals(Set.of(black.getColor()), colors(reset[1]));
+        // A code inside a continuation row still applies, as the native row keeps that code.
+        assertEquals(Set.of(red.getColor()), colors(reset[3]));
+
+        final FormattedCharSequence[] persisted = BedrockSignText.rows(messages, 30, true, BedrockSignTextTest::width);
+        assertEquals(Set.of(red.getColor()), colors(persisted[1]));
+    }
+
+    @Test
+    void longWordsFillTheRestOfTheCurrentRow() {
+        assertEquals(List.of("ab c-", "defg-", "hij", ""), rows(30, "ab cdefghij"));
+    }
+
+    @Test
+    void hyphensAreNotAddedBesideHyphensOrWideCharacters() {
+        assertEquals(List.of("abcd-", "efgh-", "ij", ""), rows(30, "abcd-efghij"));
+        assertEquals(List.of("一二三", "四五六", "", ""), rows(30, "一二三四五六"));
+    }
+
+    @Test
+    void oneLongWordUsesAtMostFourRows() {
+        assertEquals(List.of("aaaa-", "aaaa-", "aaaa-", "aaaa-"), rows(30, "a".repeat(30), "hidden"));
+    }
+
+    private static List<String> rows(final int width, final String... lines) {
+        final List<Component> messages = new ArrayList<>();
+        for (final String line : lines) messages.add(Component.literal(line));
+        while (messages.size() < 4) messages.add(Component.empty());
+        return text(BedrockSignText.rows(messages, width, true, BedrockSignTextTest::width));
+    }
+
+    private static List<String> text(final FormattedCharSequence[] rows) {
+        final List<String> result = new ArrayList<>();
+        for (final FormattedCharSequence row : rows) {
+            final StringBuilder text = new StringBuilder();
+            row.accept((index, style, codePoint) -> {
+                text.appendCodePoint(codePoint);
+                return true;
+            });
+            result.add(text.toString());
+        }
+        return result;
+    }
+
+    private static Set<TextColor> colors(final FormattedCharSequence row) {
+        final Set<TextColor> colors = new HashSet<>();
+        row.accept((index, style, codePoint) -> {
+            colors.add(style.getColor());
+            return true;
+        });
+        return colors;
+    }
+
+    /** Spaces are 4 units, wide characters 9 and other glyphs 6, as in the Bedrock bitmap font. */
+    private static int width(final List<BedrockSignText.Glyph> glyphs) {
+        int width = 0;
+        for (final var glyph : glyphs) width += glyph.codePoint() == ' ' ? 4 : glyph.codePoint() >= 0x2E80 ? 9 : 6;
+        return width;
+    }
+}
