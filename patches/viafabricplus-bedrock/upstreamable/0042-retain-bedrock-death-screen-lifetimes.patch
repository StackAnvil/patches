+
+    @Test
+    void gameMenuNeedsEnabledControlsAndReturnsToTheRetainedScreen() {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        screen.rebuild(BedrockDeathScreenStages.BUTTON_TICKS - 1, false);
+        assertFalse(fixture.updates.gameMenu(fixture.owner, fixture.player, screen), "Controls are not shown yet");
+        screen.tickStage(false);
+        assertTrue(fixture.updates.gameMenu(fixture.owner, fixture.player, screen));
+        assertTrue(fixture.receive(mock(Screen.class), fixture.screen("Late reason")), "The menu stays open");
+
+        final var reentry = fixture.updates.automaticScreen(fixture.owner, fixture.player, fixture.screen(""));
+        assertSame(screen, reentry, "Closing the menu returns to the same death screen");
+        assertEquals("Late reason", screen.bedrockDeathReason().getString());
+
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, screen);
+        assertFalse(fixture.updates.gameMenu(fixture.owner, fixture.player, screen), "A pending respawn keeps the route");
+    }
+
+    private static String key(final Component component) {
+        return ((TranslatableContents) component.getContents()).getKey();
+    }
+
+    private static final class Fixture {
+        private long time;
+        private final BedrockDeathScreenUpdates updates = new BedrockDeathScreenUpdates(() -> this.time);
+        private final ClientPacketListener owner = this.listener();
+        private final LocalPlayer player = mock(LocalPlayer.class);
+        private final AtomicBoolean dead = new AtomicBoolean(true);
+
+        private Fixture() {
+            when(this.player.isDeadOrDying()).thenAnswer(call -> this.dead.get());
+            when(this.player.getId()).thenReturn(7);
+        }
+
+        private ClientPacketListener listener() {
+            final var listener = mock(ClientPacketListener.class, withSettings().extraInterfaces(BedrockDeathScreenUpdates.Owner.class));
+            when(((BedrockDeathScreenUpdates.Owner) listener).bedrockDeathScreens()).thenReturn(this.updates);
+            final var connection = mock(Connection.class);
+            when(listener.getConnection()).thenReturn(connection);
+            when(connection.isConnected()).thenReturn(true);
+            return listener;
+        }
+
+        private TestDeathScreen screen(final String reason) { return new TestDeathScreen(reason, this.player); }
+
+        private boolean receive(final Screen foreground, final TestDeathScreen incoming) {
+            return this.updates.receive(this.owner, this.owner, this.player, foreground, incoming);
+        }
+
+        private void tick(final long time, final Screen foreground) {
+            this.time = time;
+            this.updates.tick(this.owner, this.player, foreground);
+        }
+    }
+
+    /** Headless bridge for the fields supplied by DeathScreenAccess in the installed client. */
+    private static final class TestDeathScreen extends DeathScreen implements DeathScreenAccess {
+        private TestDeathScreen(final String reason, final LocalPlayer player) {
+            this(reason, player, false);
+        }
+
+        private TestDeathScreen(final String reason, final LocalPlayer player, final boolean hardcore) {
+            super(Component.literal(reason), hardcore, player);
+        }
+
+        /** Mirrors Java's rebuildWidgets plus the installed init injections. */
+        private void rebuild(final int previousDelay, final boolean pending) {
+            this.clearWidgets();
+            this.init();
+            BedrockDeathScreenStages.arrange(this, previousDelay, pending);
+        }
+
+        /** Mirrors Java's tick plus the installed tick injection. */
+        private void tickStage(final boolean pending) {
+            this.tick();
+            BedrockDeathScreenStages.update(this, pending);
+        }
+
+        private List<String> labels() {
+            return this.exitButtons().stream().map(button -> key(button.getMessage())).toList();
+        }
+
+        private Object field(final String name) {
+            try {
+                final Field field = DeathScreen.class.getDeclaredField(name);
+                field.setAccessible(true);
+                return field.get(this);
+            } catch (ReflectiveOperationException error) {
+                throw new AssertionError(error);
+            }
+        }
+
+        @SuppressWarnings("unchecked")
+        private List<Button> exitButtons() { return (List<Button>) this.field("exitButtons"); }
+
+        @Override public List<Button> bedrockDeathButtons() { return this.exitButtons(); }
+        @Override public int bedrockDeathDelay() { return (int) this.field("delayTicker"); }
+        @Override public void bedrockDeathDelay(final int delay) { this.set("delayTicker", delay); }
+        @Override public LocalPlayer bedrockDeathPlayer() { return (LocalPlayer) this.field("player"); }
+        @Override public boolean bedrockDeathHardcore() { return (boolean) this.field("hardcore"); }
+        @Override public Component bedrockDeathReason() { return (Component) this.field("causeOfDeath"); }
+        @Override public void bedrockDeathReason(final Component reason) { this.set("causeOfDeath", reason); }
+
+        private void set(final String name, final Object value) {
+            try {
+                final Field field = DeathScreen.class.getDeclaredField(name);
+                field.setAccessible(true);
+                field.set(this, value);
+            } catch (ReflectiveOperationException error) {
+                throw new AssertionError(error);
+            }
+        }
+    }
+}
