+package com.viaversion.viafabricplus.bedrock.screen.death;
+
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen.DeathScreenAccess;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import java.util.function.LongSupplier;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.DeathScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.util.Util;
+
+/** One connection's death reason updates do not re-enter its screen or undo a pending respawn. */
+public final class BedrockDeathScreenUpdates {
+    private final LongSupplier clock;
+    private ClientPacketListener owner;
+    private LocalPlayer player;
+    private DeathScreen screen;
+    private boolean respawning;
+    private boolean loading;
+    private long deadline;
+
+    public BedrockDeathScreenUpdates() { this(Util::getMillis); }
+    BedrockDeathScreenUpdates(final LongSupplier clock) { this.clock = clock; }
+
+    /** The command and automatic GUI paths share one pending attempt per local death. */
+    public static boolean requestRespawn(final LocalPlayer player, final DeathScreen screen) {
+        final var client = Minecraft.getInstance();
+        if (!BedrockInputPermissions.isBedrockConnection() || !(client.getConnection() instanceof Owner owner)) return false;
+        if (player == client.player) {
+            owner.bedrockDeathScreens().respawn(client.getConnection(), client.getConnection(), player, screen);
+        }
+        return true;
+    }
+
+    public static boolean respawning(final DeathScreen screen) {
+        final var client = Minecraft.getInstance();
+        return client.getConnection() instanceof Owner owner
+                && owner.bedrockDeathScreens().pending(client.getConnection(), client.player, screen);
+    }
+
+    /** True consumes an update; false admits the supplied screen through the ordinary screen path. */
+    public boolean receive(final ClientPacketListener source, final ClientPacketListener current,
+                           final LocalPlayer player, final Screen foreground, final DeathScreen incoming) {
+        this.tick(current, player);
+        if (source != current || source == null || !source.getConnection().isConnected()) return true;
+        if (player == null || !player.isDeadOrDying() || !(incoming instanceof DeathScreenAccess next)
+                || next.bedrockDeathPlayer() != player) return false;
+
+        // Prefer the actual foreground if Java or another screen path replaced the retained instance.
+        if (foreground instanceof DeathScreen existing && existing instanceof DeathScreenAccess previous
+                && previous.bedrockDeathPlayer() == player
+                && previous.bedrockDeathHardcore() == next.bedrockDeathHardcore()) {
+            this.owner = source;
+            this.player = player;
+            this.screen = existing;
+        }
+        if (this.screen == null || this.owner != source || this.player != player
+                || ((DeathScreenAccess) this.screen).bedrockDeathHardcore() != next.bedrockDeathHardcore()) {
+            this.owner = source;
+            this.player = player;
+            this.screen = incoming;
+            return false;
+        }
+        ((DeathScreenAccess) this.screen).bedrockDeathReason(next.bedrockDeathReason());
+        return true;
+    }
+
+    public void tick(final ClientPacketListener current, final LocalPlayer player) {
+        if (this.owner != null && (this.owner != current || this.player != player
+                || player == null || !player.isDeadOrDying() || !this.owner.getConnection().isConnected())) {
+            this.owner = null;
+            this.player = null;
+            this.screen = null;
+            this.respawning = false;
+        }
+    }
+
+    public void tick(final ClientPacketListener current, final LocalPlayer player, final Screen foreground) {
+        this.tick(current, player);
+        if (!this.respawning) return;
+        // Leaving the active native route disposes its timer, including while a modal is visible.
+        if (foreground != this.screen) {
+            this.respawning = false;
+            return;
+        }
+        final long now = this.clock.getAsLong();
+        if (now < this.deadline) return;
+        if (!this.loading) {
+            this.loading = true;
+        } else {
+            this.player.respawn();
+        }
+        // Native setTimeout schedules from callback delivery. A stalled client must not catch up requests.
+        this.deadline = now + 1000;
+    }
+
+    public void respawn(final ClientPacketListener source, final ClientPacketListener current,
+                        final LocalPlayer player, final DeathScreen screen) {
+        this.tick(current, player);
+        if (source != current || source == null || !source.getConnection().isConnected()
+                || player == null || !player.isDeadOrDying() || this.respawning) return;
+        if (screen != null && (!(screen instanceof DeathScreenAccess access) || access.bedrockDeathPlayer() != player)) return;
+        this.owner = source;
+        this.player = player;
+        this.screen = screen;
+        this.respawning = true;
+        this.loading = false;
+        this.deadline = this.clock.getAsLong() + 500;
+        player.respawn();
+    }
+
+    /** Java's null-screen path must not replace a screen whose respawn is still pending. */
+    public DeathScreen automaticScreen(final ClientPacketListener current, final LocalPlayer player, final DeathScreen incoming) {
+        this.tick(current, player);
+        if (this.pending(current, player, this.screen) && this.screen != null
+                && incoming instanceof DeathScreenAccess next && next.bedrockDeathPlayer() == player
+                && next.bedrockDeathHardcore() == ((DeathScreenAccess) this.screen).bedrockDeathHardcore()) return this.screen;
+        return incoming;
+    }
+
+    private boolean pending(final ClientPacketListener current, final LocalPlayer player, final DeathScreen screen) {
+        return this.respawning && this.owner == current && this.player == player && this.screen == screen;
+    }
+
+    public interface Owner {
+        BedrockDeathScreenUpdates bedrockDeathScreens();
+    }
+}
