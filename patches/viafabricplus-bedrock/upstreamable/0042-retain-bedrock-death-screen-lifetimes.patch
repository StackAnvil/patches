@@ -0,0 +1,77 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.death;
+
+import com.mojang.blaze3d.platform.InputConstants;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen.DeathScreenAccess;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.DeathScreen;
+import net.minecraft.network.chat.Component;
+
+/**
+ * Projects the Bedrock death screen stages onto Java's death screen controls.
+ *
+ * <p>The keyboard and mouse layout shows the reason after 500 ms and the buttons after 1000 ms. Non-hardcore
+ * worlds offer Respawn and Game menu; hardcore worlds offer Exit world first and Spectate world second. A
+ * respawn request hides both, then shows a progress line until the player is alive.</p>
+ */
+public final class BedrockDeathScreenStages {
+    /** Java client ticks before the reason appears (native ContentPrompt). */
+    public static final int MESSAGE_TICKS = 10;
+    /** Java client ticks before the buttons appear and accept input (native ContentButton). */
+    public static final int BUTTON_TICKS = 20;
+    /** The DOM button 3 that opens the native game menu is the first extra (back) mouse button. */
+    public static final int GAME_MENU_MOUSE_BUTTON = InputConstants.MOUSE_BUTTON_4;
+
+    private static final Component GAME_MENU = Component.translatable("menu.game");
+    private static final Component EXIT_WORLD = Component.translatable("death_screen.viafabricplus.exit_world");
+    private static final Component RESPAWNING = Component.translatable("death_screen.viafabricplus.respawning");
+    private static final Component SAVING = Component.translatable("death_screen.viafabricplus.saving");
+
+    private BedrockDeathScreenStages() {}
+
+    /**
+     * Labels and orders Java's two buttons after each init. Java restarts its button delay whenever it rebuilds
+     * widgets, for example after a resize or when the game menu closes. The native stage does not restart.
+     */
+    public static void arrange(final DeathScreen screen, final int delay, final boolean pending) {
+        final var access = (DeathScreenAccess) screen;
+        access.bedrockDeathDelay(delay);
+        final Button primary = access.bedrockDeathButtons().get(0);
+        final Button secondary = access.bedrockDeathButtons().get(1);
+        if (access.bedrockDeathHardcore()) {
+            // Java places Spectate World first. Native places Exit world first.
+            final int top = primary.getY();
+            primary.setY(secondary.getY());
+            secondary.setY(top);
+            secondary.setMessage(EXIT_WORLD);
+        } else {
+            secondary.setMessage(GAME_MENU);
+        }
+        update(screen, pending);
+    }
+
+    public static void update(final DeathScreen screen, final boolean pending) {
+        final boolean shown = buttonsShown(screen, pending);
+        for (final Button button : ((DeathScreenAccess) screen).bedrockDeathButtons()) {
+            button.visible = shown;
+            button.active = shown;
+        }
+    }
+
+    public static boolean messageShown(final DeathScreen screen, final boolean pending) {
+        return !pending && ((DeathScreenAccess) screen).bedrockDeathDelay() >= MESSAGE_TICKS;
+    }
+
+    public static boolean buttonsShown(final DeathScreen screen, final boolean pending) {
+        return !pending && ((DeathScreenAccess) screen).bedrockDeathDelay() >= BUTTON_TICKS;
+    }
+
+    /** Native selects this progress text by world mode, including a hardcore spectate request. */
+    public static Component progress(final DeathScreen screen) {
+        return ((DeathScreenAccess) screen).bedrockDeathHardcore() ? SAVING : RESPAWNING;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/death/BedrockDeathScreenUpdates.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/death/BedrockDeathScreenUpdates.java
