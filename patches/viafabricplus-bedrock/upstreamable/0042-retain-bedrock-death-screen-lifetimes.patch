+package com.viaversion.viafabricplus.bedrock.screen.death;
+
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen.DeathScreenAccess;
+import net.minecraft.client.gui.screens.DeathScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.LocalPlayer;
+
+/** One connection's death reason updates do not re-enter its screen or undo a pending respawn. */
+public final class BedrockDeathScreenUpdates {
+    private ClientPacketListener owner;
+    private LocalPlayer player;
+    private DeathScreen screen;
+
+    /** True consumes an update; false admits the supplied screen through the ordinary screen path. */
+    public boolean receive(final ClientPacketListener source, final ClientPacketListener current,
+                           final LocalPlayer player, final Screen foreground, final DeathScreen incoming) {
+        this.tick(current, player);
+        if (source != current || source == null || !source.getConnection().isConnected()) return true;
+        if (player == null || !player.isDeadOrDying() || !(incoming instanceof DeathScreenAccess next)
+                || next.bedrockDeathPlayer() != player) return false;
+
+        // Prefer the actual foreground if Java or another screen path replaced the retained instance.
+        if (foreground instanceof DeathScreen existing && existing instanceof DeathScreenAccess previous
+                && previous.bedrockDeathPlayer() == player
+                && previous.bedrockDeathHardcore() == next.bedrockDeathHardcore()) {
+            this.owner = source;
+            this.player = player;
+            this.screen = existing;
+        }
+        if (this.screen == null || this.owner != source || this.player != player
+                || ((DeathScreenAccess) this.screen).bedrockDeathHardcore() != next.bedrockDeathHardcore()) {
+            this.owner = source;
+            this.player = player;
+            this.screen = incoming;
+            return false;
+        }
+        ((DeathScreenAccess) this.screen).bedrockDeathReason(next.bedrockDeathReason());
+        return true;
+    }
+
+    public void tick(final ClientPacketListener current, final LocalPlayer player) {
+        if (this.screen != null && (this.owner != current || this.player != player
+                || player == null || !player.isDeadOrDying() || !this.owner.getConnection().isConnected())) {
+            this.owner = null;
+            this.player = null;
+            this.screen = null;
+        }
+    }
+}
