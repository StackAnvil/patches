+package com.viaversion.viafabricplus.bedrock.screen.death;
+
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen.DeathScreenAccess;
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.DeathScreen;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.network.Connection;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.Bootstrap;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.mockito.MockedStatic;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BedrockDeathScreenUpdatesTest {
+    private MockedStatic<Minecraft> singleton;
+
+    @BeforeEach
+    void client() {
+        final var client = mock(Minecraft.class);
+        this.singleton = mockStatic(Minecraft.class);
+        this.singleton.when(Minecraft::getInstance).thenReturn(client);
+    }
+
+    @AfterEach
+    void closeClient() { this.singleton.close(); }
+
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void reasonChangesKeepTheExistingButtonDeadlineAndEnabledControls() throws Exception {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        final var button = mock(Button.class);
+        button.active = false;
+        screen.exitButtons().add(button);
+        assertFalse(fixture.receive(null, screen), "The first death must still open a screen");
+        for (int tick = 0; tick < 19; tick++) screen.tick();
+        assertTrue(fixture.receive(screen, fixture.screen("Late reason")));
+        assertEquals("Late reason", screen.bedrockDeathReason().getString());
+        assertFalse(button.active);
+        screen.tick();
+        assertTrue(button.active, "A text update must not restart the existing button deadline");
+        assertTrue(fixture.receive(screen, fixture.screen("")));
+        assertEquals("", screen.bedrockDeathReason().getString());
+        assertTrue(button.active, "Hiding the reason must retain enabled controls");
+    }
+
+    @Test
+    void lateTextUpdatesTheRetainedScreenWithoutReplacingAModalOrPendingRespawn() {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        assertFalse(fixture.receive(null, screen));
+        final var confirmation = mock(Screen.class);
+        assertTrue(fixture.receive(confirmation, fixture.screen("While confirming")));
+        assertEquals("While confirming", screen.bedrockDeathReason().getString());
+        assertTrue(fixture.receive(null, fixture.screen("While respawning")));
+        assertEquals("While respawning", screen.bedrockDeathReason().getString());
+    }
+
+    @Test
+    void adoptsThePlayersAlreadyOpenDeathScreenBeforeTheFirstReasonPacket() throws Exception {
+        final var fixture = new Fixture();
+        final var automatic = fixture.screen("");
+        for (int tick = 0; tick < 9; tick++) automatic.tick();
+        assertTrue(fixture.receive(automatic, fixture.screen("First reason")));
+        assertEquals("First reason", automatic.bedrockDeathReason().getString());
+        assertEquals(9, automatic.field("delayTicker"));
+    }
+
+    @Test
+    void updatesTheVisibleReplacementInsteadOfAnOlderRetainedScreen() {
+        final var fixture = new Fixture();
+        final var old = fixture.screen("Original");
+        assertFalse(fixture.receive(null, old));
+        final var replacement = fixture.screen("Replacement");
+        assertTrue(fixture.receive(replacement, fixture.screen("Current reason")));
+        assertEquals("Current reason", replacement.bedrockDeathReason().getString());
+        assertEquals("Original", old.bedrockDeathReason().getString());
+    }
+
+    @Test
+    void respawnAndConnectionReplacementRetireOldReasonsEvenWhenPlayerIdsRepeat() {
+        final var fixture = new Fixture();
+        final var old = fixture.screen("Old death");
+        assertFalse(fixture.receive(null, old));
+        fixture.dead.set(false);
+        fixture.updates.tick(fixture.owner, fixture.player);
+        fixture.dead.set(true);
+        final var next = fixture.screen("Next death");
+        assertFalse(fixture.receive(null, next));
+        assertEquals("Old death", old.bedrockDeathReason().getString());
+
+        final var replacementOwner = fixture.listener();
+        final var replacementPlayer = mock(LocalPlayer.class);
+        when(replacementPlayer.isDeadOrDying()).thenReturn(true);
+        when(replacementPlayer.getId()).thenReturn(7);
+        fixture.updates.tick(replacementOwner, replacementPlayer);
+        assertTrue(fixture.updates.receive(fixture.owner, replacementOwner, replacementPlayer, null,
+            new TestDeathScreen("Stale packet", replacementPlayer)));
+        final var current = new TestDeathScreen("Current death", replacementPlayer);
+        assertFalse(fixture.updates.receive(replacementOwner, replacementOwner, replacementPlayer, null, current));
+        assertEquals("Next death", next.bedrockDeathReason().getString());
+        assertTrue(fixture.updates.receive(replacementOwner, replacementOwner, replacementPlayer, current,
+            new TestDeathScreen("Current update", replacementPlayer)));
+        assertEquals("Current update", current.bedrockDeathReason().getString());
+    }
+
+    private static final class Fixture {
+        private final BedrockDeathScreenUpdates updates = new BedrockDeathScreenUpdates();
+        private final ClientPacketListener owner = this.listener();
+        private final LocalPlayer player = mock(LocalPlayer.class);
+        private final AtomicBoolean dead = new AtomicBoolean(true);
+
+        private Fixture() {
+            when(this.player.isDeadOrDying()).thenAnswer(call -> this.dead.get());
+            when(this.player.getId()).thenReturn(7);
+        }
+
+        private ClientPacketListener listener() {
+            final var listener = mock(ClientPacketListener.class);
+            final var connection = mock(Connection.class);
+            when(listener.getConnection()).thenReturn(connection);
+            when(connection.isConnected()).thenReturn(true);
+            return listener;
+        }
+
+        private TestDeathScreen screen(final String reason) { return new TestDeathScreen(reason, this.player); }
+
+        private boolean receive(final Screen foreground, final TestDeathScreen incoming) {
+            return this.updates.receive(this.owner, this.owner, this.player, foreground, incoming);
+        }
+    }
+
+    /** Headless bridge for the fields supplied by DeathScreenAccess in the installed client. */
+    private static final class TestDeathScreen extends DeathScreen implements DeathScreenAccess {
+        private TestDeathScreen(final String reason, final LocalPlayer player) {
+            super(Component.literal(reason), false, player);
+        }
+
+        private Object field(final String name) {
+            try {
+                final Field field = DeathScreen.class.getDeclaredField(name);
+                field.setAccessible(true);
+                return field.get(this);
+            } catch (ReflectiveOperationException error) {
+                throw new AssertionError(error);
+            }
+        }
+
+        @SuppressWarnings("unchecked")
+        private List<Button> exitButtons() { return (List<Button>) this.field("exitButtons"); }
+
+        @Override public LocalPlayer bedrockDeathPlayer() { return (LocalPlayer) this.field("player"); }
+        @Override public boolean bedrockDeathHardcore() { return (boolean) this.field("hardcore"); }
+        @Override public Component bedrockDeathReason() { return (Component) this.field("causeOfDeath"); }
+        @Override public void bedrockDeathReason(final Component reason) {
+            try {
+                final Field field = DeathScreen.class.getDeclaredField("causeOfDeath");
+                field.setAccessible(true);
+                field.set(this, reason);
+            } catch (ReflectiveOperationException error) {
+                throw new AssertionError(error);
+            }
+        }
+    }
+}
