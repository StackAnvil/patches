+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.screen;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.screen.death.BedrockDeathScreenUpdates;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Gui;
+import net.minecraft.client.gui.screens.DeathScreen;
+import net.minecraft.client.player.LocalPlayer;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(Gui.class)
+public abstract class MixinBedrockAutomaticRespawn {
+    @WrapOperation(method = "setScreen", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/player/LocalPlayer;respawn()V"))
+    private void requestRespawn(final LocalPlayer player, final Operation<Void> original) {
+        if (!BedrockDeathScreenUpdates.requestRespawn(player, null)) original.call(player);
+    }
+
+    @ModifyExpressionValue(method = "setScreen", at = @At(value = "NEW", target =
+            "(Lnet/minecraft/network/chat/Component;ZLnet/minecraft/client/player/LocalPlayer;)Lnet/minecraft/client/gui/screens/DeathScreen;"))
+    private DeathScreen retainPendingScreen(final DeathScreen incoming) {
+        final var client = Minecraft.getInstance();
+        if (BedrockInputPermissions.isBedrockConnection() && client.getConnection() instanceof BedrockDeathScreenUpdates.Owner owner) {
+            return owner.bedrockDeathScreens().automaticScreen(client.getConnection(), client.player, incoming);
+        }
+        return incoming;
+    }
+}
