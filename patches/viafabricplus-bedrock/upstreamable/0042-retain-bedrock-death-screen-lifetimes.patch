+    @Test
+    void reasonChangesKeepTheExistingButtonDeadlineAndEnabledControls() throws Exception {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        final var button = mock(Button.class);
+        button.active = false;
+        screen.exitButtons().add(button);
+        assertFalse(fixture.receive(null, screen), "The first death must still open a screen");
+        for (int tick = 0; tick < 19; tick++) screen.tick();
+        assertTrue(fixture.receive(screen, fixture.screen("Late reason")));
+        assertEquals("Late reason", screen.bedrockDeathReason().getString());
+        assertFalse(button.active);
+        screen.tick();
+        assertTrue(button.active, "A text update must not restart the existing button deadline");
+        assertTrue(fixture.receive(screen, fixture.screen("")));
+        assertEquals("", screen.bedrockDeathReason().getString());
+        assertTrue(button.active, "Hiding the reason must retain enabled controls");
+    }
+
+    @Test
+    void lateTextUpdatesTheRetainedScreenWithoutReplacingAModalOrPendingRespawn() {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        assertFalse(fixture.receive(null, screen));
+        final var confirmation = mock(Screen.class);
+        assertTrue(fixture.receive(confirmation, fixture.screen("While confirming")));
+        assertEquals("While confirming", screen.bedrockDeathReason().getString());
+        assertTrue(fixture.receive(null, fixture.screen("While respawning")));
+        assertEquals("While respawning", screen.bedrockDeathReason().getString());
+    }
+
+    @Test
+    void adoptsThePlayersAlreadyOpenDeathScreenBeforeTheFirstReasonPacket() throws Exception {
+        final var fixture = new Fixture();
+        final var automatic = fixture.screen("");
+        for (int tick = 0; tick < 9; tick++) automatic.tick();
+        assertTrue(fixture.receive(automatic, fixture.screen("First reason")));
+        assertEquals("First reason", automatic.bedrockDeathReason().getString());
+        assertEquals(9, automatic.field("delayTicker"));
+    }
+
+    @Test
+    void updatesTheVisibleReplacementInsteadOfAnOlderRetainedScreen() {
+        final var fixture = new Fixture();
+        final var old = fixture.screen("Original");
+        assertFalse(fixture.receive(null, old));
+        final var replacement = fixture.screen("Replacement");
+        assertTrue(fixture.receive(replacement, fixture.screen("Current reason")));
+        assertEquals("Current reason", replacement.bedrockDeathReason().getString());
+        assertEquals("Original", old.bedrockDeathReason().getString());
+    }
+
+    @Test
+    void respawnAndConnectionReplacementRetireOldReasonsEvenWhenPlayerIdsRepeat() {
+        final var fixture = new Fixture();
+        final var old = fixture.screen("Old death");
+        assertFalse(fixture.receive(null, old));
+        fixture.dead.set(false);
+        fixture.updates.tick(fixture.owner, fixture.player);
+        fixture.dead.set(true);
+        final var next = fixture.screen("Next death");
+        assertFalse(fixture.receive(null, next));
+        assertEquals("Old death", old.bedrockDeathReason().getString());
+
+        final var replacementOwner = fixture.listener();
+        final var replacementPlayer = mock(LocalPlayer.class);
+        when(replacementPlayer.isDeadOrDying()).thenReturn(true);
+        when(replacementPlayer.getId()).thenReturn(7);
+        fixture.updates.tick(replacementOwner, replacementPlayer);
+        assertTrue(fixture.updates.receive(fixture.owner, replacementOwner, replacementPlayer, null,
+            new TestDeathScreen("Stale packet", replacementPlayer)));
+        final var current = new TestDeathScreen("Current death", replacementPlayer);
+        assertFalse(fixture.updates.receive(replacementOwner, replacementOwner, replacementPlayer, null, current));
+        assertEquals("Next death", next.bedrockDeathReason().getString());
+        assertTrue(fixture.updates.receive(replacementOwner, replacementOwner, replacementPlayer, current,
+            new TestDeathScreen("Current update", replacementPlayer)));
+        assertEquals("Current update", current.bedrockDeathReason().getString());
+    }
+
+    @Test
+    void automaticRespawnSendsOnceThenWaitsForTheLoadingStageAndRetryDeadline() {
+        final var fixture = new Fixture();
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+        for (int time = 0; time < 500; time += 50) {
+            fixture.tick(time, null);
+            fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+        }
+        verify(fixture.player).respawn();
+        fixture.tick(500, null);
+        fixture.tick(1499, null);
+        verify(fixture.player).respawn();
+        fixture.tick(1500, null);
+        verify(fixture.player, times(2)).respawn();
+        fixture.tick(2499, null);
+        verify(fixture.player, times(2)).respawn();
+        fixture.tick(2500, null);
+        verify(fixture.player, times(3)).respawn();
+    }
+
+    @Test
+    void pendingManualRespawnRetainsTheScreenReasonAndDeadlineThroughJavaReentry() {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        fixture.receive(null, screen);
+        fixture.time = 1000;
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, screen);
+        fixture.tick(1250, screen);
+        assertTrue(fixture.receive(screen, fixture.screen("Late reason")));
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, screen);
+        assertSame(screen, fixture.updates.automaticScreen(fixture.owner, fixture.player, fixture.screen("")));
+        assertEquals("Late reason", screen.bedrockDeathReason().getString());
+        fixture.tick(1500, screen);
+        fixture.tick(2499, screen);
+        verify(fixture.player).respawn();
+        fixture.tick(2500, screen);
+        verify(fixture.player, times(2)).respawn();
+    }
+
+    @Test
+    void delayedTimerDeliveryDoesNotBurstObsoleteRespawnRequests() {
+        final var fixture = new Fixture();
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+        fixture.tick(5000, null);
+        fixture.tick(5999, null);
+        verify(fixture.player).respawn();
+        fixture.tick(6000, null);
+        verify(fixture.player, times(2)).respawn();
+        fixture.tick(10000, null);
+        fixture.tick(10999, null);
+        verify(fixture.player, times(3)).respawn();
+        fixture.tick(11000, null);
+        verify(fixture.player, times(4)).respawn();
+    }
+
+    @Test
+    void alivePlayerDisconnectedOwnerReplacementAndHiddenRouteCancelRetries() {
+        for (int boundary = 0; boundary < 5; boundary++) {
+            final var fixture = new Fixture();
+            fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+            fixture.tick(500, null);
+            fixture.time = 1500;
+            switch (boundary) {
+                case 0 -> {
+                    fixture.dead.set(false);
+                    fixture.updates.tick(fixture.owner, fixture.player, null);
+                }
+                case 1 -> {
+                    when(fixture.owner.getConnection().isConnected()).thenReturn(false);
+                    fixture.updates.tick(fixture.owner, fixture.player, null);
+                }
+                case 2 -> fixture.updates.tick(fixture.listener(), fixture.player, null);
+                case 3 -> fixture.updates.tick(fixture.owner, mock(LocalPlayer.class), null);
+                case 4 -> fixture.updates.tick(fixture.owner, fixture.player, mock(Screen.class));
+            }
+            fixture.tick(10000, null);
+            verify(fixture.player, description("Boundary " + boundary)).respawn();
+        }
+        final var fixture = new Fixture();
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+        fixture.dead.set(false);
+        fixture.tick(500, null);
+        fixture.dead.set(true);
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, null);
+        verify(fixture.player, times(2)).respawn();
+    }
+
+    @Test
+    void commandBridgeDropsOldPlayerActionsAndLeavesJavaSessionsToTheirOriginalPath() {
+        final var fixture = new Fixture();
+        final var client = Minecraft.getInstance();
+        client.player = fixture.player;
+        when(client.getConnection()).thenReturn(fixture.owner);
+        final var oldPlayer = mock(LocalPlayer.class);
+        try (final var permissions = mockStatic(BedrockInputPermissions.class)) {
+            permissions.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            assertTrue(BedrockDeathScreenUpdates.requestRespawn(oldPlayer, null));
+            verifyNoInteractions(oldPlayer);
+            verify(fixture.player, never()).respawn();
+            assertTrue(BedrockDeathScreenUpdates.requestRespawn(fixture.player, null));
+            verify(fixture.player).respawn();
+            permissions.when(BedrockInputPermissions::isBedrockConnection).thenReturn(false);
+            assertFalse(BedrockDeathScreenUpdates.requestRespawn(fixture.player, null));
+            verify(fixture.player).respawn();
+        }
+    }
+
+    @Test
+    void controlsAppearAfterOneSecondAndJavaWidgetRebuildsDoNotRestartTheStage() {
+        final var fixture = new Fixture();
+        final var screen = fixture.screen("Initial reason");
+        screen.rebuild(0, false);
+        for (int tick = 0; tick < BedrockDeathScreenStages.MESSAGE_TICKS; tick++) {
+            assertFalse(BedrockDeathScreenStages.messageShown(screen, false), "Tick " + tick);
+            screen.tickStage(false);
+        }
+        assertTrue(BedrockDeathScreenStages.messageShown(screen, false));
+        for (int tick = BedrockDeathScreenStages.MESSAGE_TICKS; tick < BedrockDeathScreenStages.BUTTON_TICKS; tick++) {
+            assertFalse(screen.exitButtons().getFirst().visible, "Tick " + tick);
+            screen.tickStage(false);
+        }
+        assertEquals(List.of("deathScreen.respawn", "menu.game"), screen.labels());
+        assertTrue(screen.exitButtons().stream().allMatch(button -> button.visible && button.active));
+
+        // Java restarts delayTicker in init after a resize or when the game menu returns to the screen.
+        screen.rebuild((int) screen.field("delayTicker"), false);
+        assertTrue(screen.exitButtons().stream().allMatch(button -> button.visible && button.active));
+    }
+
+    @Test
+    void hardcorePlacesExitWorldAboveSpectateWorld() {
+        final var fixture = new Fixture();
+        final var screen = new TestDeathScreen("Reason", fixture.player, true);
+        screen.rebuild(BedrockDeathScreenStages.BUTTON_TICKS, false);
+        final var spectate = screen.exitButtons().get(0);
+        final var exit = screen.exitButtons().get(1);
+        assertEquals(List.of("deathScreen.spectate", "death_screen.viafabricplus.exit_world"), screen.labels());
+        assertTrue(exit.getY() < spectate.getY(), "Exit world is the primary action");
+        assertEquals("death_screen.viafabricplus.saving", key(BedrockDeathScreenStages.progress(screen)));
+    }
+
+    @Test
+    void respawnRequestHidesTheContentThenShowsProgressAfterTheInitialWait() {
+        final var fixture = new Fixture();
+        final var client = Minecraft.getInstance();
+        client.player = fixture.player;
+        when(client.getConnection()).thenReturn(fixture.owner);
+        final var screen = fixture.screen("Reason");
+        screen.rebuild(BedrockDeathScreenStages.BUTTON_TICKS, false);
+        fixture.updates.respawn(fixture.owner, fixture.owner, fixture.player, screen);
+        assertTrue(BedrockDeathScreenUpdates.respawning(screen));
+        screen.tickStage(true);
+        assertFalse(BedrockDeathScreenStages.messageShown(screen, true));
+        assertTrue(screen.exitButtons().stream().noneMatch(button -> button.visible || button.active));
+        assertFalse(BedrockDeathScreenUpdates.loading(screen));
+        fixture.tick(500, screen);
+        assertTrue(BedrockDeathScreenUpdates.loading(screen));
+        assertEquals("death_screen.viafabricplus.respawning", key(BedrockDeathScreenStages.progress(screen)));
+        verify(fixture.player).respawn();
