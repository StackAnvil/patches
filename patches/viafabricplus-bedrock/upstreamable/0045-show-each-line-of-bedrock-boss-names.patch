+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.render;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiText;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.BossHealthOverlay;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+import net.minecraft.world.BossEvent;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+
+/**
+ * Bedrock's boss_name label shows each line of the boss name. The block is as wide as its widest line and centered
+ * above the bar, its lines are left-aligned 10 units apart, and the bar covers the lines below the first.
+ */
+@Mixin(BossHealthOverlay.class)
+public abstract class MixinBossHealthOverlay {
+    @Unique
+    private static final int BEDROCK_LINE_HEIGHT = 10;
+
+    @WrapOperation(method = "extractRenderState", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/client/gui/components/BossHealthOverlay;extractBar(Lnet/minecraft/client/gui/GuiGraphicsExtractor;IILnet/minecraft/world/BossEvent;)V"),
+            require = 1, allow = 1)
+    private void bedrockLinesBehindBar(final BossHealthOverlay overlay, final GuiGraphicsExtractor graphics, final int x, final int y,
+                                       final BossEvent event, final Operation<Void> original) {
+        final List<FormattedCharSequence> lines = viafabricplus_bedrock$lines(event.getName());
+        if (lines != null) {
+            final Font font = Minecraft.getInstance().font;
+            final int left = viafabricplus_bedrock$left(graphics, font, lines);
+            for (int line = 1; line < lines.size(); line++) {
+                graphics.text(font, lines.get(line), left, y - 9 + line * BEDROCK_LINE_HEIGHT, -1);
+            }
+        }
+        original.call(overlay, graphics, x, y, event);
+    }
+
+    @WrapOperation(method = "extractRenderState", at = @At(value = "INVOKE", target =
+            "Lnet/minecraft/client/gui/GuiGraphicsExtractor;text(Lnet/minecraft/client/gui/Font;Lnet/minecraft/network/chat/Component;III)V"),
+            require = 1, allow = 1)
+    private void bedrockFirstLine(final GuiGraphicsExtractor graphics, final Font font, final Component name, final int x, final int y,
+                                  final int color, final Operation<Void> original) {
+        final List<FormattedCharSequence> lines = viafabricplus_bedrock$lines(name);
+        if (lines == null) original.call(graphics, font, name, x, y, color);
+        else graphics.text(font, lines.getFirst(), viafabricplus_bedrock$left(graphics, font, lines), y, color);
+    }
+
+    /** The name's lines, or null for a single-line name or a Java server, which keep Java's layout. */
+    @Unique
+    private static List<FormattedCharSequence> viafabricplus_bedrock$lines(final Component name) {
+        if (!BedrockInputPermissions.isBedrockConnection() || !name.getString().contains("\n")) return null;
+        final List<FormattedCharSequence> lines = NativeUiText.tooltipLines(Minecraft.getInstance().font, name, Integer.MAX_VALUE);
+        return lines.size() > 1 ? lines : null;
+    }
+
+    @Unique
+    private static int viafabricplus_bedrock$left(final GuiGraphicsExtractor graphics, final Font font, final List<FormattedCharSequence> lines) {
+        int width = 0;
+        for (final FormattedCharSequence line : lines) width = Math.max(width, font.width(line));
+        return graphics.guiWidth() / 2 - width / 2;
+    }
+}
