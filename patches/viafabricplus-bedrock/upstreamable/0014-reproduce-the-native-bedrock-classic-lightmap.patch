+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockRenderingMetadataTest {
+    @AfterEach
+    void clear() {
+        BedrockRenderingMetadata.clear();
+    }
+
+    @Test
+    void onlyAcceptsTheSupportedIntegerProtocolAndFormat() {
+        final JsonObject data = metadata();
+        assertTrue(BedrockRenderingMetadata.supported(data));
+        data.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION + 0.5);
+        assertFalse(BedrockRenderingMetadata.supported(data));
+        data.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION - 1);
+        assertFalse(BedrockRenderingMetadata.supported(data));
+        data.addProperty("bedrock_protocol", String.valueOf(ProtocolConstants.BEDROCK_PROTOCOL_VERSION));
+        assertFalse(BedrockRenderingMetadata.supported(data));
+        data.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        data.addProperty("format", 2);
+        assertFalse(BedrockRenderingMetadata.supported(data));
+    }
+
+    @Test
+    void localResourcePacksCannotActivateNativeRendering() {
+        final var listener = new BedrockRenderingMetadata();
+        final ResourceManager resources = resources(PackSource.DEFAULT);
+        listener.apply(listener.prepare(resources, null), resources, null);
+        assertFalse(BedrockRenderingMetadata.active());
+    }
+
+    @Test
+    void serverPackReloadRemovalRestoresOrdinaryJavaRendering() {
+        final var listener = new BedrockRenderingMetadata();
+        final ResourceManager accepted = resources(PackSource.SERVER);
+        listener.apply(listener.prepare(accepted, null), accepted, null);
+        assertTrue(BedrockRenderingMetadata.active());
+        final ResourceManager removed = resources();
+        listener.apply(listener.prepare(removed, null), removed, null);
+        assertFalse(BedrockRenderingMetadata.active());
+    }
+
+    @Test
+    void staleReloadCompletionCannotReactivateAfterDisconnectOrAReplacementReload() {
+        final var listener = new BedrockRenderingMetadata();
+        final ResourceManager accepted = resources(PackSource.SERVER);
+        final var pending = listener.prepare(accepted, null);
+        BedrockRenderingMetadata.clear();
+        listener.apply(pending, accepted, null);
+        assertFalse(BedrockRenderingMetadata.active());
+        final var older = listener.prepare(accepted, null);
+        final ResourceManager removed = resources();
+        listener.apply(listener.prepare(removed, null), removed, null);
+        listener.apply(older, accepted, null);
+        assertFalse(BedrockRenderingMetadata.active());
+    }
+
+    private static JsonObject metadata() {
+        final JsonObject metadata = new JsonObject();
+        metadata.addProperty("format", 1);
+        metadata.addProperty("bedrock_protocol", ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+        return metadata;
+    }
+
+    private static ResourceManager resources(final PackSource... sources) {
+        final List<Resource> resources = java.util.Arrays.stream(sources).map(source -> {
+            final PackLocationInfo location = new PackLocationInfo("fixture", Component.empty(), source, Optional.empty());
+            final PackResources pack = (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class<?>[]{PackResources.class},
+                (proxy, method, args) -> method.getName().equals("location") ? location : null);
+            return new Resource(pack, () -> new ByteArrayInputStream(metadata().toString().getBytes(StandardCharsets.UTF_8)));
+        }).toList();
+        return (ResourceManager) Proxy.newProxyInstance(ResourceManager.class.getClassLoader(), new Class<?>[]{ResourceManager.class},
+            (proxy, method, args) -> method.getName().equals("getResourceStack") ? resources : null);
+    }
+}
