+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockLightmapWeather;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.effect.MobEffectInstance;
+import net.minecraft.world.effect.MobEffects;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import net.raphimc.viabedrock.protocol.storage.ChunkTracker;
+import net.raphimc.viabedrock.protocol.storage.GameSessionStorage;
+import org.jetbrains.annotations.Nullable;
+
+public final class BedrockLightmapExtractor {
+    private BedrockLightmapExtractor() {
+    }
+
+    public static @Nullable BedrockLightmapParameters extract(final Minecraft minecraft, final float partialTick) {
+        final var level = minecraft.level;
+        final var player = minecraft.player;
+        final Dimension dimension = dimension(minecraft);
+        if (dimension == null) return null;
+        // The End uses a separate animated sky producer, rather than this classic daylight calculation.
+        if (dimension != Dimension.OVERWORLD && dimension != Dimension.NETHER) return null;
+        final boolean nether = dimension == Dimension.NETHER;
+        final var weather = (IBedrockLightmapWeather) level;
+        // Native sky contribution extraction samples its dimension at partial tick 1.
+        final var sky = BedrockLightmapMath.sky(nether, level.getOverworldClockTime(), level.getRainLevel(1F), weather.viaFabricPlusBedrock$thunder());
+        final float darkness = player.getEffectBlendFactor(MobEffects.DARKNESS, partialTick)
+            * minecraft.options.darknessEffectScale().get().floatValue();
+        final float gamma = Math.max(minecraft.options.gamma().get().floatValue() - darkness, 0F);
+        final MobEffectInstance nightVision = player.getEffect(MobEffects.NIGHT_VISION);
+        final MobEffectInstance conduit = player.getEffect(MobEffects.CONDUIT_POWER);
+        final int duration = longestDuration(nightVision, conduit);
+        final float vision = nightVision != null || conduit != null ? BedrockLightmapMath.nightVision(duration) : 0F;
+        return new BedrockLightmapParameters(BedrockLightmapMath.levels(nether), sky.color(),
+            sky.factor(), gamma, BedrockLightmapMath.darknessPulse(level.getLevelData().getGameTime(), partialTick, darkness),
+            vision, !nether && !minecraft.options.hideLightningFlash().get() && weather.viaFabricPlusBedrock$skyFlash() > 0);
+    }
+
+    public static @Nullable Dimension dimension(final Minecraft minecraft) {
+        if (minecraft.level == null || minecraft.player == null) return null;
+        final var connection = ViaFabricPlus.api().userConnection();
+        if (connection != null && connection.getProtocolInfo().serverProtocolVersion().equals(BedrockProtocolVersion.BEDROCK_LATEST)) {
+            if (!connection.has(ChunkTracker.class) || !connection.has(GameSessionStorage.class)) return null;
+            return connection.get(ChunkTracker.class).getDimension();
+        }
+        if (!BedrockRenderingMetadata.active() || minecraft.getConnection() == null) return null;
+        final String key = minecraft.level.dimension().identifier().toString();
+        for (final Dimension dimension : Dimension.values()) {
+            if (dimension.getKey().equals(key)) return dimension;
+        }
+        return null;
+    }
+
+    private static int longestDuration(final @Nullable MobEffectInstance first, final @Nullable MobEffectInstance second) {
+        final int a = first != null ? first.getDuration() : 0;
+        final int b = second != null ? second.getDuration() : 0;
+        return a == -1 || b == -1 ? -1 : Math.max(a, b);
+    }
+}
