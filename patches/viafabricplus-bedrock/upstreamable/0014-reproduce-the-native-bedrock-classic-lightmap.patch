@@ -0,0 +1,49 @@
+#version 330
+#extension GL_ARB_separate_shader_objects : require
+
+layout(std140) uniform BedrockLightmapInfo {
+    vec4 SkyColor;
+    vec4 LightLevels[4];
+    vec4 Factors; // sky factor, gamma factor, darkness pulse, night vision
+    vec4 State; // lightning flash, padding
+} lightmapInfo;
+
+layout(location = 0) in vec2 texCoord;
+layout(location = 0) out vec4 fragColor;
+
+float brightness(int level) {
+    return lightmapInfo.LightLevels[level / 4][level % 4];
+}
+
+void main() {
+    int blockLevel = clamp(int(floor(texCoord.x * 16.0)), 0, 15);
+    int skyLevel = clamp(int(floor(texCoord.y * 16.0)), 0, 15);
+    float block = brightness(blockLevel) * 1.6;
+    vec3 blockColor = vec3(block,
+        ((block * 0.6 + 0.4) * 0.6 + 0.4) * block,
+        (block * block * 0.6 + 0.4) * block);
+    float sky = brightness(skyLevel);
+    float skyFactor = lightmapInfo.Factors.x;
+    vec3 skyColor = vec3(sky);
+    if (lightmapInfo.State.x == 0.0) {
+        float tint = lightmapInfo.SkyColor.a * 0.3;
+        skyColor = lightmapInfo.SkyColor.rgb * sky * tint
+            + vec3((1.0 - tint) * (skyFactor * 0.95 + 0.05) * sky);
+    }
+    skyColor.rg *= skyFactor * 0.65 + 0.35;
+    vec3 color = (blockColor + skyColor) * 0.96 + vec3(0.03);
+    float vision = lightmapInfo.Factors.w;
+    if (vision > 0.0) {
+        float maximum = max(max(color.r, color.g), color.b);
+        color = color * (vision / maximum) + color * (1.0 - vision);
+    }
+    color = clamp(color - vec3(lightmapInfo.Factors.z), 0.0, 1.0);
+    vec3 inverse = vec3(1.0) - color;
+    vec3 gamma = vec3(1.0) - inverse * inverse * inverse * inverse;
+    float gammaFactor = lightmapInfo.Factors.y;
+    color = gamma * gammaFactor + color * (1.0 - gammaFactor);
+    color = color * 0.96 + vec3(0.03);
+    // Native image construction truncates channels to bytes before upload.
+    color = floor(clamp(color, 0.0, 1.0) * 255.0) / 255.0;
+    fragColor = vec4(color, 1.0);
+}
