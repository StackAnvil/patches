+import com.viaversion.viafabricplus.bedrock.render.light.BedrockLightmapExtractor;
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockLightmapParameters;
+import java.util.Objects;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.LightmapRenderStateExtractor;
+import net.minecraft.client.renderer.state.LightmapRenderState;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(LightmapRenderStateExtractor.class)
+public abstract class MixinBedrockLightmapExtractor {
+    @Shadow @Final private Minecraft minecraft;
+    @Unique private BedrockLightmapParameters viaFabricPlusBedrock$lastParameters;
+
+    @Inject(method = "extract", at = @At("TAIL"))
+    private void extractNative(final LightmapRenderState state, final float partialTick, final CallbackInfo ci) {
+        final var parameters = BedrockLightmapExtractor.extract(this.minecraft, partialTick);
+        // Native snapshots can change between ticks, including gamma changes and the darkness pulse.
+        state.needsUpdate |= !Objects.equals(parameters, this.viaFabricPlusBedrock$lastParameters);
+        this.viaFabricPlusBedrock$lastParameters = parameters;
+        ((IBedrockLightmapState) state).viaFabricPlusBedrock$lightmap(parameters);
+    }
+}
