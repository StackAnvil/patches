@@ -0,0 +1,76 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.minecraft.server.packs.resources.SimplePreparableReloadListener;
+import net.minecraft.util.profiling.ProfilerFiller;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Versioned, reload-scoped appearance provenance supplied by a converted server pack. */
+public final class BedrockRenderingMetadata extends SimplePreparableReloadListener<BedrockRenderingMetadata.Prepared> {
+    private static final Logger LOGGER = LogManager.getLogger("Bedrock rendering metadata");
+    private static final Identifier LOCATION = Identifier.fromNamespaceAndPath("viabedrock", "client_rendering.json");
+    private static final AtomicReference<State> STATE = new AtomicReference<>(new State(false));
+
+    public static boolean active() {
+        return STATE.get().active;
+    }
+
+    public static void clear() {
+        STATE.set(new State(false));
+    }
+
+    @Override
+    protected Prepared prepare(final ResourceManager resources, final ProfilerFiller profiler) {
+        final State pending = new State(false);
+        STATE.set(pending);
+        for (final var resource : resources.getResourceStack(LOCATION)) {
+            if (resource.source().location().source() != PackSource.SERVER) continue;
+            try (final var input = resource.open()) {
+                final byte[] content = input.readNBytes(513);
+                if (content.length > 512) continue;
+                if (supported(JsonParser.parseString(new String(content, StandardCharsets.UTF_8)))) return new Prepared(pending, true);
+            } catch (final IOException | RuntimeException error) {
+                LOGGER.debug("Ignoring invalid Bedrock rendering metadata", error);
+            }
+        }
+        return new Prepared(pending, false);
+    }
+
+    @Override
+    protected void apply(final Prepared prepared, final ResourceManager resources, final ProfilerFiller profiler) {
+        STATE.compareAndSet(prepared.pending, new State(prepared.supported));
+    }
+
+    record State(boolean active) {
+    }
+
+    record Prepared(State pending, boolean supported) {
+    }
+
+    static boolean supported(final JsonElement metadata) {
+        return metadata.isJsonObject()
+            && numberMatches(metadata.getAsJsonObject().get("format"), 1)
+            && numberMatches(metadata.getAsJsonObject().get("bedrock_protocol"), ProtocolConstants.BEDROCK_PROTOCOL_VERSION);
+    }
+
+    private static boolean numberMatches(final JsonElement value, final int expected) {
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()
+            && value.getAsBigDecimal().compareTo(BigDecimal.valueOf(expected)) == 0;
+    }
+}
diff --git a/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_lightmap.fsh b/src/main/resources/assets/viafabricplus-bedrock/shaders/core/bedrock_lightmap.fsh
