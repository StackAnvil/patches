@@ -0,0 +1,38 @@
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockLightmapParametersTest {
+    @Test
+    void uniformSnapshotOwnsItsTableAndPacksWithoutChangingChannelOrder() {
+        final float[] levels = new float[16];
+        for (int index = 0; index < 16; index++) levels[index] = index / 15F;
+        final var parameters = new BedrockLightmapParameters(new BedrockLightmapParameters.Levels(levels),
+            new BedrockLightmapParameters.Color(0.7F, 0.2F, 0.1F, 0.8F), 0.9F, 0.6F, 0.3F, 0.4F, true);
+        final var sameInputs = new BedrockLightmapParameters(new BedrockLightmapParameters.Levels(levels.clone()),
+            parameters.skyColor(), parameters.skyFactor(), parameters.gammaFactor(), parameters.darknessPulse(), parameters.nightVision(), parameters.neutralSky());
+        assertEquals(parameters, sameInputs);
+        assertNotEquals(parameters, new BedrockLightmapParameters(parameters.levels(), parameters.skyColor(),
+            parameters.skyFactor(), parameters.gammaFactor(), parameters.darknessPulse() + 0.01F, parameters.nightVision(), parameters.neutralSky()));
+        levels[12] = 0F;
+        final ByteBuffer buffer = ByteBuffer.allocateDirect(BedrockLightmapParameters.UNIFORM_SIZE).order(ByteOrder.nativeOrder());
+        parameters.write(buffer);
+        assertEquals(112, BedrockLightmapParameters.UNIFORM_SIZE);
+        assertEquals(0.7F, buffer.getFloat(0));
+        assertEquals(0.8F, buffer.getFloat(12));
+        for (int index = 0; index < 16; index++) assertEquals(index / 15F, buffer.getFloat(16 + index * Float.BYTES));
+        assertEquals(0.9F, buffer.getFloat(80));
+        assertEquals(0.6F, buffer.getFloat(84));
+        assertEquals(0.3F, buffer.getFloat(88));
+        assertEquals(0.4F, buffer.getFloat(92));
+        assertEquals(1F, buffer.getFloat(96));
+        assertEquals(0F, buffer.getFloat(100));
+        assertEquals(0F, buffer.getFloat(104));
+        assertEquals(0F, buffer.getFloat(108));
+    }
+}
