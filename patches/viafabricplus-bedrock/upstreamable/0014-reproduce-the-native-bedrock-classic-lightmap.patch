--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/light/BedrockLightmapMath.java
@@ -0,0 +1,74 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import net.minecraft.util.Mth;
+
+/** Inputs to the classic Bedrock 1.26.51 light-image builder. */
+public final class BedrockLightmapMath {
+    private static final float[] BRIGHTNESS = {
+        0F, 0.017543857917189598F, 0.03703703731298447F, 0.05882352590560913F,
+        0.0833333283662796F, 0.1111111268401146F, 0.1428571194410324F, 0.1794871985912323F,
+        0.2222222536802292F, 0.2727273106575012F, 0.3333333432674408F, 0.4074074327945709F,
+        0.5000000596046448F, 0.6190476417541504F, 0.7777777314186096F, 1F
+    };
+    private static final BedrockLightmapParameters.Color WHITE = new BedrockLightmapParameters.Color(1F, 1F, 1F, 1F);
+    private static final BedrockLightmapParameters.Color NO_SUNRISE = new BedrockLightmapParameters.Color(0F, 0F, 0F, 0F);
+    private static final BedrockLightmapParameters.Levels OVERWORLD_LEVELS = new BedrockLightmapParameters.Levels(BRIGHTNESS);
+    private static final BedrockLightmapParameters.Levels NETHER_LEVELS = netherLevels();
+
+    private BedrockLightmapMath() {
+    }
+
+    public static BedrockLightmapParameters.Levels levels(final boolean nether) {
+        return nether ? NETHER_LEVELS : OVERWORLD_LEVELS;
+    }
+
+    private static BedrockLightmapParameters.Levels netherLevels() {
+        final float[] levels = BRIGHTNESS.clone();
+        for (int index = 0; index < levels.length; index++) levels[index] = Mth.clamp(levels[index] + 0.1F, 0F, 1F);
+        return new BedrockLightmapParameters.Levels(levels);
+    }
+
+    public static Sky sky(final boolean nether, final long time, final float rain, final float thunder) {
+        if (nether) return new Sky(WHITE, 1F);
+        final float angle = overworldAngle(time, 1F);
+        return new Sky(sunrise(angle), skyFactor(angle, rain, thunder));
+    }
+
+    public record Sky(BedrockLightmapParameters.Color color, float factor) {
+    }
+
+    public static float overworldAngle(final long time, final float partialTick) {
+        float fraction = ((time % 24000L) + partialTick) / 24000F - 0.25F;
+        if (fraction < 0F) fraction += 1F;
+        if (fraction > 1F) fraction -= 1F;
+        final float eased = 1F - (Mth.cos(fraction * (float) Math.PI) + 1F) * 0.5F;
+        return fraction + (eased - fraction) / 3F;
+    }
+
+    public static float skyFactor(final float angle, final float rain, final float thunder) {
+        final float daylight = 1F - Mth.clamp(1F - ((float) Math.cos(angle * ((float) Math.PI * 2F)) * 2F + 0.2F), 0F, 1F);
+        return 0.2F + 0.8F * (daylight * (1F - 0.3125F * thunder) * (1F - 0.3125F * rain));
+    }
+
+    public static BedrockLightmapParameters.Color sunrise(final float angle) {
+        final float cosine = Mth.cos(angle * ((float) Math.PI * 2F));
+        if (Math.abs(cosine) > 0.4F) return NO_SUNRISE;
+        final float progress = cosine / 0.4F * 0.5F + 0.5F;
+        final float alpha = 1F - (1F - Mth.sin(progress * (float) Math.PI)) * 0.99F;
+        return new BedrockLightmapParameters.Color(progress * 0.3F + 0.7F, progress * progress * 0.7F + 0.2F, 0.2F, alpha * alpha);
+    }
+
+    public static float nightVision(final int duration) {
+        if (duration == -1 || duration > 200) return 1F;
+        return Mth.sin((duration - 1F) * (float) Math.PI * 0.2F) * 0.3F + 0.7F;
+    }
+
+    public static float darknessPulse(final long worldTick, final float partialTick, final float intensity) {
+        return Math.max((float) Math.cos((worldTick - partialTick) * 0.07853981852531433F) * 0.45F * intensity, 0F);
+    }
+}
