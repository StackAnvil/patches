+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import com.mojang.blaze3d.buffers.Std140Builder;
+import com.mojang.blaze3d.buffers.Std140SizeCalculator;
+
+import java.nio.ByteBuffer;
+import java.util.Arrays;
+
+/** A render-thread snapshot of the native light-image builder inputs. */
+public record BedrockLightmapParameters(
+    Levels levels, Color skyColor, float skyFactor, float gammaFactor, float darknessPulse,
+    float nightVision, boolean neutralSky
+) {
+    public static final int UNIFORM_SIZE = new Std140SizeCalculator()
+        .putVec4().putVec4().putVec4().putVec4().putVec4()
+        .putVec4().putVec4().get();
+
+    public void write(final ByteBuffer buffer) {
+        final Std140Builder builder = Std140Builder.intoBuffer(buffer);
+        putColor(builder, this.skyColor);
+        for (int index = 0; index < 16; index++) builder.putFloat(this.levels.at(index));
+        builder.putFloat(this.skyFactor).putFloat(this.gammaFactor).putFloat(this.darknessPulse).putFloat(this.nightVision);
+        builder.putFloat(this.neutralSky ? 1F : 0F).putFloat(0F).putFloat(0F).putFloat(0F);
+    }
+
+    private static void putColor(final Std140Builder builder, final Color color) {
+        builder.putFloat(color.red).putFloat(color.green).putFloat(color.blue).putFloat(color.alpha);
+    }
+
+    public record Color(float red, float green, float blue, float alpha) {
+    }
+
+    public static final class Levels {
+        private final float[] values;
+
+        public Levels(final float[] values) {
+            if (values.length != 16) throw new IllegalArgumentException("Lightmap requires 16 brightness levels");
+            this.values = values.clone();
+        }
+
+        public float at(final int level) {
+            return this.values[level];
+        }
+
+        @Override
+        public boolean equals(final Object other) {
+            return other instanceof Levels levels && Arrays.equals(this.values, levels.values);
+        }
+
+        @Override
+        public int hashCode() {
+            return Arrays.hashCode(this.values);
+        }
+    }
+}
