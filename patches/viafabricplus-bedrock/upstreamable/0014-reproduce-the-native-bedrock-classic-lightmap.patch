+package com.viaversion.viafabricplus.bedrock.render.light;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockLightmapMathTest {
+    @Test
+    void netherAddsItsNativeAmbientOffsetBeforeClamping() {
+        final var overworld = BedrockLightmapMath.levels(false);
+        final var nether = BedrockLightmapMath.levels(true);
+        assertEquals(0F, overworld.at(0));
+        assertEquals(0.1F, nether.at(0));
+        assertEquals(0.6000001F, nether.at(12));
+        assertEquals(1F, nether.at(15));
+        for (int level = 0; level < 15; level++) assertTrue(nether.at(level) > overworld.at(level));
+    }
+
+    @Test
+    void skyUsesIndependentWeatherChannelsAndANativeNightFloor() {
+        assertEquals(1F, BedrockLightmapMath.skyFactor(0F, 0F, 0F));
+        assertEquals(0.75F, BedrockLightmapMath.skyFactor(0F, 1F, 0F));
+        assertEquals(0.578125F, BedrockLightmapMath.skyFactor(0F, 1F, 1F));
+        assertEquals(0.2F, BedrockLightmapMath.skyFactor(0.5F, 1F, 1F));
+        assertEquals(0.2F, BedrockLightmapMath.skyFactor(0.5F, 0F, 0F));
+    }
+
+    @Test
+    void netherSkyContributionKeepsItsNativeWhiteColorAndFullFactor() {
+        final var expected = new BedrockLightmapMath.Sky(new BedrockLightmapParameters.Color(1F, 1F, 1F, 1F), 1F);
+        for (long time : new long[] {0L, 6000L, 12000L, 18000L}) {
+            assertEquals(expected, BedrockLightmapMath.sky(true, time, 0F, 0F));
+            assertEquals(expected, BedrockLightmapMath.sky(true, time, 1F, 1F));
+        }
+    }
+
+    @Test
+    void fractionalInputsMatchNativeFloatCosineReferenceVectors() {
+        assertEquals(0.7268046736717224F, BedrockLightmapMath.skyFactor(0.125F, 0.73F, 0.47F), 0.0000001F);
+        assertEquals(0.7414843440055847F, BedrockLightmapMath.skyFactor(0.16185066F, 0.81F, 0.3F), 0.0000001F);
+        assertEquals(0.4152044653892517F, BedrockLightmapMath.skyFactor(0.234561F, 0.21F, 0.86F), 0.0000001F);
+        assertEquals(0.18035398423671722F, BedrockLightmapMath.darknessPulse(13L, 0.4F, 0.73F), 0.0000001F);
+        assertEquals(0.056559834629297256F, BedrockLightmapMath.darknessPulse(11137L, 0.87F, 0.42F), 0.0000001F);
+    }
+
+    @Test
+    void sunriseAlphaAppearsOnlyAroundTheHorizon() {
+        assertEquals(0F, BedrockLightmapMath.sunrise(0F).alpha());
+        assertEquals(0F, BedrockLightmapMath.sunrise(0.5F).alpha());
+        final var horizon = BedrockLightmapMath.sunrise(0.25F);
+        assertEquals(0.85F, horizon.red(), 0.0001F);
+        assertEquals(0.375F, horizon.green(), 0.0001F);
+        assertEquals(0.2F, horizon.blue());
+        assertEquals(1F, horizon.alpha(), 0.0001F);
+    }
+
+    @Test
+    void dayAngleWrapsAndRepeatsWithoutUsingJavaEnvironmentAttributes() {
+        for (int time = 0; time < 24000; time += 137) {
+            assertEquals(BedrockLightmapMath.overworldAngle(time, 1F), BedrockLightmapMath.overworldAngle(time + 24000L, 1F));
+            assertTrue(BedrockLightmapMath.overworldAngle(time, 1F) >= 0F);
+            assertTrue(BedrockLightmapMath.overworldAngle(time, 1F) <= 1F);
+        }
+        assertEquals(0F, BedrockLightmapMath.overworldAngle(6000L, 0F));
+        assertEquals(0.5F, BedrockLightmapMath.overworldAngle(18000L, 0F), 0.0001F);
+    }
+
+    @Test
+    void effectsKeepNativeInfiniteDurationAndWorldClockSemantics() {
+        assertEquals(1F, BedrockLightmapMath.nightVision(-1));
+        assertEquals(1F, BedrockLightmapMath.nightVision(201));
+        assertEquals(0.7F, BedrockLightmapMath.nightVision(1));
+        assertEquals(0.45F, BedrockLightmapMath.darknessPulse(0L, 0F, 1F));
+        assertEquals(0F, BedrockLightmapMath.darknessPulse(40L, 0F, 1F));
+        assertEquals(0F, BedrockLightmapMath.darknessPulse(0L, 0F, 0F));
+    }
+}
