+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.CompareOp;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockEntityResources;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.Set;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientLifecycleEvents;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.loader.api.FabricLoader;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.entity.Entity;
+
+/** Occlusion acceleration cannot discard materials that intentionally draw behind opaque geometry. */
+public final class BedrockActorOcclusion {
+    private static volatile Set<Entity> visible = Set.of();
+
+    private BedrockActorOcclusion() {}
+
+    public static void register() {
+        if (!FabricLoader.getInstance().isModLoaded("entityculling")) return;
+        ClientLifecycleEvents.CLIENT_STARTED.register(client ->
+                com.viaversion.viafabricplus.bedrock.render.compat.entityculling.BedrockEntityCulling.register());
+        ClientTickEvents.END_CLIENT_TICK.register(BedrockActorOcclusion::tick);
+    }
+
+    /** The culling worker reads only an immutable snapshot, never resource managers or actor graphs. */
+    public static boolean ignoresOcclusion(final Entity entity) { return visible.contains(entity); }
+
+    private static void tick(final Minecraft client) {
+        final Set<Entity> next = new HashSet<>();
+        if (client.level != null) {
+            final var accepted = BedrockActorResources.get();
+            if (accepted != null) for (final var entity : client.level.entitiesForRendering()) {
+                final var snapshot = BedrockActorState.state(entity.getUUID());
+                if (snapshot == null || !entity.isAlive()) continue;
+                final var resources = BedrockEntityResources.get(accepted, snapshot.identifier());
+                if (resources != null && resources.ignoresOcclusion()) next.add(entity);
+            }
+        }
+        visible = Set.copyOf(next);
+        // A definition can finish loading after the worker has already marked its entity as culled.
+        next.forEach(com.viaversion.viafabricplus.bedrock.render.compat.entityculling.BedrockEntityCulling::show);
+    }
+
+    /** Inspect all declared alternatives without advancing animation or emitting effects. */
+    public static boolean ignoresOcclusion(final Collection<String> names, final BedrockActorMaterialDefinitions definitions) {
+        return names.stream().map(definitions::material).flatMap(java.util.Optional::stream)
+                .anyMatch(material -> ignoresOcclusion(material.depth()));
+    }
+
+    static boolean ignoresOcclusion(final BedrockActorDepth depth) {
+        final var comparison = depth.comparison();
+        return comparison == null || comparison == CompareOp.ALWAYS_PASS || comparison == CompareOp.NOT_EQUAL
+                || comparison == CompareOp.LESS_THAN || comparison == CompareOp.LESS_THAN_OR_EQUAL;
+    }
+
+    public static void clear() { visible = Set.of(); }
+}
