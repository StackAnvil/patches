+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Assumptions;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockWorldActorAppearanceTest {
+    private static BedrockWorldActorAppearance appearance(final String controller) throws Exception {
+        Assumptions.assumeTrue(BedrockWorldActorAppearance.class.getResource("/assets/viafabricplus-bedrock/builtin/manifest.json") != null);
+        final var files = new java.util.HashMap<String, byte[]>();
+        files.put("manifest.json", ("{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                + java.util.UUID.randomUUID() + "\",\"version\":[1,0,0]}}").getBytes(StandardCharsets.UTF_8));
+        if (controller != null) files.put("render_controllers/override.json", controller.getBytes(StandardCharsets.UTF_8));
+        final var packs = BedrockEntityResources.merge(BedrockBuiltinAssets.load().library(),
+                List.of(new NativeActorLibrary.Layer(true, files)), "minecraft:ender_crystal");
+        return new BedrockWorldActorAppearance(packs, "minecraft:ender_crystal");
+    }
+
+    @Test
+    void rendersTheBundledCrystalWithoutServerOverridesAndDoesNotFaceTheCamera() throws Exception {
+        final var actor = appearance(null).playback();
+        final var first = actor.sample(0, new BedrockActorAnimation.Frame(Map.of("show_bottom", true, "rotation_to_camera", 0F), Map.of("time_offset", 0F)));
+        assertNotNull(first);
+        assertEquals(1, first.draws().size());
+        assertNotNull(first.draws().getFirst().image());
+        assertFalse(first.pose().isEmpty());
+        final var turned = appearance(null).playback().sample(0, new BedrockActorAnimation.Frame(Map.of("show_bottom", false, "rotation_to_camera", 180F), Map.of("time_offset", 0F)));
+        assertEquals(first.pose(), turned.pose());
+        assertTrue(first.draws().getFirst().surface().visibility().getFirst().visible());
+        assertFalse(turned.draws().getFirst().surface().visibility().getFirst().visible());
+    }
+
+    @Test
+    void keepsTheNativeCrystalRateAcrossFrameRatesAndAnimationLoops() throws Exception {
