+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_ACTOR_QUERIES", matches = ".+")
+    void matchesNativeMotionAndStatusQueriesForLiveActorContexts() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_ACTOR_QUERIES"))))
+                .getAsJsonObject();
+        final var entity = mock(Entity.class);
+        for (final var value : fixture.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            if (!row.get("bound").getAsBoolean() || row.get("generation").getAsString().equals("stale")) continue;
+            final var flags = EnumSet.noneOf(ActorFlags.class);
+            if (row.get("sitting").getAsBoolean()) flags.add(ActorFlags.SITTING);
+            if (row.get("dashCooldown").getAsBoolean()) flags.add(ActorFlags.HAS_DASH_COOLDOWN);
+            if (row.get("saddled").getAsBoolean()) flags.add(ActorFlags.SADDLED);
+            final var actor = actor(flags);
+            final var motion = row.getAsJsonArray("motion");
+            when(entity.getDeltaMovement()).thenReturn(new Vec3(motion.get(0).getAsFloat(), motion.get(1).getAsFloat(), motion.get(2).getAsFloat()));
+            when(entity.isInLava()).thenReturn(row.get("inLava").getAsBoolean());
+            final var input = new BedrockActorFrame(0, 0, 0, 0, 0).input(actor);
+            final var queries = BedrockWorldActorRenderer.actorQueries(entity, actor, 0, 0, input.queries());
+            for (final var expected : row.getAsJsonObject("queries").entrySet()) {
+                final Object result = queries.get(expected.getKey());
+                final float actual = result instanceof Boolean state ? state ? 1F : 0F : ((Number) result).floatValue();
+                assertEquals(Float.floatToRawIntBits(expected.getValue().getAsFloat()), Float.floatToRawIntBits(actual));
+            }
+        }
