+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.renderpearl.api.pipeline.CompareOp;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockActorOcclusionTest {
+    @Test
+    void retainsExactlyThePredicatesThatCanPassBehindAnOpaqueOccluder() {
+        // Reversed depth: an occluded fragment has a smaller value than the existing opaque depth.
+        final Set<CompareOp> behind = Set.of(CompareOp.ALWAYS_PASS, CompareOp.NOT_EQUAL,
+                CompareOp.LESS_THAN, CompareOp.LESS_THAN_OR_EQUAL);
+        for (final var comparison : CompareOp.values()) for (final boolean write : new boolean[]{false, true}) {
+            assertEquals(behind.contains(comparison), BedrockActorOcclusion.ignoresOcclusion(new BedrockActorDepth(comparison, write)));
+        }
+        assertTrue(BedrockActorOcclusion.ignoresOcclusion(BedrockActorDepth.DISABLED));
+    }
+
+    @Test
+    void resolvesInheritedAlternativesWithoutExemptingUnknownOrOrdinaryMaterials() {
+        final var definitions = BedrockActorMaterialDefinitions.read(List.of(JsonParser.parseString("""
+                {"materials":{
+                  "overlay:entity":{"depthFunc":"Always"},
+                  "inherited:overlay":{"+states":["DisableDepthWrite"]},
+                  "restored:inherited":{"depthFunc":"LessEqual"},
+                  "unsupported:overlay":{"geometryShader":"custom"},
+                  "disabled:entity":{"+states":["DisableDepthTest"]}
+                }}
+                """).getAsJsonObject()));
+        assertFalse(BedrockActorOcclusion.ignoresOcclusion(List.of("entity", "restored", "missing", "unsupported"), definitions));
+        assertTrue(BedrockActorOcclusion.ignoresOcclusion(List.of("entity", "inherited"), definitions));
+        assertTrue(BedrockActorOcclusion.ignoresOcclusion(List.of("disabled"), definitions));
+    }
+}
