+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorMaterialDefinitions;
+
+/** A native world appearance replaces Java only when its entire sampled draw is supported. */
+public final class BedrockWorldActorAppearance {
+    private final Map<String, BufferedImage> images = new java.util.HashMap<>();
+    private final ResourcePackStorage packs;
+    private final BedrockActorAnimation graph;
+    private final org.cube.converter.data.bedrock.BedrockEntityData definition;
+    private final BedrockActorMaterialDefinitions materials;
+
+    public BedrockWorldActorAppearance(final ResourcePackStorage packs, final String identifier) throws IOException {
+        this.packs = packs;
+        this.definition = packs.getEntities().get(identifier).entityData();
+        this.graph = BedrockActorAnimation.serverEntity(packs, identifier);
+        this.materials = BedrockActorMaterialDefinitions.load(packs);
+    }
+
+    public Playback playback() { return new Playback(); }
+
+    public final class Playback {
+        private final BedrockActorAnimation.Playback animation = graph.playback();
+        private final BedrockPlayerControllers controllers = new BedrockPlayerControllers(definition,
+                packs.getRenderControllers().renderControllers());
+
+        public void commands(final net.raphimc.viabedrock.api.model.NativeAnimationControllers commands) { this.animation.commands(commands); }
+
+        public Frame sample(final float seconds, final BedrockActorAnimation.Frame input) throws IOException {
+            // Effect locators and special entity layers need their own world integration.
+            if (graph.hasEffects()) return null;
+            final var pose = this.animation.sample(seconds, input, false, null, null);
+            final var selection = this.animation.renderControllers(this.controllers);
+            final var scale = this.animation.scale();
+            if (!this.animation.hasCompleteQueries() || selection.surfaces().isEmpty()) return null;
+            final List<Draw> draws = new ArrayList<>();
+            for (final var surface : selection.surfaces()) {
+                final var controller = packs.getRenderControllers().renderControllers().get(surface.controller());
+                if (controller == null || !controller.materialsMap().keySet().equals(Set.of("*"))) return null;
+                final var geometry = packs.getModels().entityModels().get(surface.geometry());
+                final var material = materials.alphaTest(surface.material()).orElse(null);
+                if (geometry == null || material == null) return null;
+                BufferedImage image = images.get(surface.texture());
+                if (image == null) for (final var pack : packs.getPackStackTopToBottom()) {
+                    final var found = pack.content().getShortnameImage(surface.texture());
+                    if (found != null) { image = found.getImage(); images.put(surface.texture(), image); break; }
+                }
+                if (image == null) return null;
+                draws.add(new Draw(surface, geometry, image, material));
+            }
+            return new Frame(pose, scale, List.copyOf(draws));
+        }
+    }
+
+    public record Frame(Map<String, BedrockBoneAnimation.Transform> pose, BedrockBoneAnimation.Vector scale, List<Draw> draws) {}
+    public record Draw(BedrockPlayerControllers.Surface surface, BedrockGeometryModel geometry,
+                       BufferedImage image, BedrockActorMaterialDefinitions.AlphaTest material) {}
+}
