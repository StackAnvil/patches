+    static ModelPart meshPart(final JsonObject mesh, final Parent bone, final float textureWidth, final float textureHeight) {
+        final JsonArray positions = mesh.getAsJsonArray("positions");
+        final JsonArray normals = mesh.getAsJsonArray("normals");
+        final JsonArray uvs = mesh.getAsJsonArray("uvs");
+        final var faces = mesh.get("polys");
+        if (positions == null || normals == null || uvs == null || faces == null) {
+            throw new IllegalArgumentException("Incomplete Bedrock poly mesh");
+        }
+        final boolean normalized = mesh.has("normalized_uvs") && mesh.get("normalized_uvs").getAsBoolean();
+        final List<ModelPart.Cube> cubes = new ArrayList<>();
+        if (faces.isJsonArray()) {
+            if (faces.getAsJsonArray().size() > MAX_MESH_FACES) {
+                throw new IllegalArgumentException("Bedrock poly mesh exceeds face limit");
+            }
+            for (var face : faces.getAsJsonArray()) {
+                cubes.add(meshFace(face.getAsJsonArray(), positions, normals, uvs, bone,
+                    normalized ? 1F : textureWidth, normalized ? 1F : textureHeight));
+            }
+        } else {
+            final int corners = switch (faces.getAsString()) {
+                case "tri_list" -> 3;
+                case "quad_list" -> 4;
+                default -> throw new IllegalArgumentException("Unknown Bedrock poly mesh layout");
+            };
+            if (positions.size() != normals.size() || positions.size() != uvs.size() || positions.size() % corners != 0) {
+                throw new IllegalArgumentException("Invalid Bedrock poly mesh vertex lists");
+            }
+            if (positions.size() / corners > MAX_MESH_FACES) {
+                throw new IllegalArgumentException("Bedrock poly mesh exceeds face limit");
+            }
+            for (int start = 0; start < positions.size(); start += corners) {
+                final JsonArray face = new JsonArray();
+                for (int i = 0; i < corners; i++) {
+                    final JsonArray indices = new JsonArray();
+                    indices.add(start + i);
+                    indices.add(start + i);
+                    indices.add(start + i);
+                    face.add(indices);
+                }
+                cubes.add(meshFace(face, positions, normals, uvs, bone,
+                    normalized ? 1F : textureWidth, normalized ? 1F : textureHeight));
+            }
+        }
+        return new ModelPart(cubes, Map.of());
+    }
+
+    private static ModelPart.Cube meshFace(final JsonArray face, final JsonArray positions, final JsonArray normals,
+                                           final JsonArray uvs, final Parent bone, final float width, final float height) {
+        if (face.size() != 3 && face.size() != 4) {
+            throw new IllegalArgumentException("Bedrock poly mesh face must have three or four vertices");
+        }
+        final ModelPart.Vertex[] vertices = new ModelPart.Vertex[4];
+        final Vector3f normal = new Vector3f();
+        for (int i = 0; i < face.size(); i++) {
+            final JsonArray indices = face.get(i).getAsJsonArray();
+            if (indices.size() != 3) {
+                throw new IllegalArgumentException("Invalid Bedrock poly mesh indices");
+            }
+            final JsonArray position = positions.get(indices.get(0).getAsInt()).getAsJsonArray();
+            final JsonArray direction = normals.get(indices.get(1).getAsInt()).getAsJsonArray();
+            final JsonArray uv = uvs.get(indices.get(2).getAsInt()).getAsJsonArray();
+            vertices[i] = new ModelPart.Vertex(
+                position.get(0).getAsFloat() - bone.getPivot().getX(),
+                bone.getPivot().getY() - position.get(1).getAsFloat(),
+                position.get(2).getAsFloat() - bone.getPivot().getZ(),
+                uv.get(0).getAsFloat() / width, 1F - uv.get(1).getAsFloat() / height
+            );
+            normal.add(direction.get(0).getAsFloat(), -direction.get(1).getAsFloat(), direction.get(2).getAsFloat());
+        }
+        if (face.size() == 3) {
+            vertices[3] = vertices[2];
+        }
+        if (normal.lengthSquared() == 0F) {
+            throw new IllegalArgumentException("Bedrock poly mesh face has no normal");
+        }
+        normal.normalize();
+        final ModelPart.Cube cube = new BedrockModelCube(0, 0, 0, 0, 0, 0, 0, false, 1, 1, Set.of(Direction.NORTH));
+        cube.polygons[0] = new ModelPart.Polygon(vertices, normal);
+        return cube;
+    }
+
