+    @Test
+    void followsBlinkControllerStateBoundariesAndSamplesEachOpenEvaluation() {
+        final var draws = new java.util.ArrayDeque<Double>(List.of(0.5, 1.0, 0.5, 0.0));
+        final var animation =
+                new BedrockSkinAnimation(
+                        new SkinData.AnimationData(
+                                new BufferedImage(32, 64, BufferedImage.TYPE_INT_ARGB), 1, 2, 1),
+                        parse(model(32, 32)),
+                        draws::removeFirst);
+        assertEquals(0, animation.frameIndex(0));
+        assertEquals(0, animation.frameIndex(0.1F));
+        assertEquals(0, animation.frameIndex(4F)); // High threshold keeps the eyes open.
+        assertEquals(0, animation.frameIndex(4F)); // Repeated render passes do not resample.
+        assertEquals(0, animation.frameIndex(4.01F)); // Enter blink after a new low threshold.
+        assertTrue(draws.isEmpty());
+        assertEquals(1, animation.frameIndex(4.02F));
+        assertEquals(1, animation.frameIndex(4.11F));
+        assertEquals(1, animation.frameIndex(4.12F)); // Exit transition keeps this state's value.
+        draws.addAll(List.of(0.5, 1.0));
+        assertEquals(0, animation.frameIndex(4.13F));
+        assertTrue(draws.isEmpty());
+        assertEquals(0, animation.frameIndex(0)); // A new entity lifetime resets the controller.
+        assertEquals(0, animation.frameIndex(0.1F));
+    }
+
+    @Test
+    void appliesBlinkExpressionOnlyToFacesAndKeepsLifetimePhase() {
+        final var animation =
+                new BedrockSkinAnimation(
+                        new SkinData.AnimationData(
+                                new BufferedImage(32, 512, BufferedImage.TYPE_INT_ARGB), 2, 16, 1),
+                        parse(model(32, 32)),
+                        () -> {
+                            throw new AssertionError("Body animation sampled blink randomness");
+                        });
+        assertEquals(6, animation.frameIndex(10));
+        assertEquals(13, animation.frameIndex(11));
+        assertEquals(0, animation.frameIndex(-1));
+        assertThrows(IllegalArgumentException.class, () -> animation.frameIndex(Float.NaN));
+        assertThrows(
+                IllegalArgumentException.class,
+                () -> animation.frameIndex(Float.POSITIVE_INFINITY));
+    }
