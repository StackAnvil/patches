diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaCaptureTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaCaptureTest.java
new file mode 100644
index 0000000..4b6195e
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaCaptureTest.java
@@ -0,0 +1,70 @@
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Runs against a private native login capture without adding account data to the test fixtures. */
+final class BedrockPersonaCaptureTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PERSONA_CAPTURE", matches = ".+")
+    void rendersEveryAnimatedSurfaceFromNativeClientData() throws Exception {
+        final JsonObject capture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PERSONA_CAPTURE")))).getAsJsonObject();
+        final String geometry = decode(capture.get("SkinGeometryData").getAsString());
+        final String patch = decode(capture.get("SkinResourcePatch").getAsString());
+        final var image = image(capture.get("SkinData").getAsString(), capture.get("SkinImageWidth").getAsInt(),
+            capture.get("SkinImageHeight").getAsInt());
+        final List<SkinData.AnimationData> animations = new ArrayList<>();
+        for (final var entry : capture.getAsJsonArray("AnimatedImageData")) {
+            final JsonObject animation = entry.getAsJsonObject();
+            animations.add(new SkinData.AnimationData(image(animation.get("Image").getAsString(),
+                animation.get("ImageWidth").getAsInt(), animation.get("ImageHeight").getAsInt()),
+                animation.get("Type").getAsInt(), animation.get("Frames").getAsFloat(),
+                animation.get("AnimationExpression").getAsInt()));
+        }
+        final var parsed = BedrockPlayerSkins.personaGeometry(BedrockPlayerSkins.geometryName(patch, "default"), Map.of(
+            1, BedrockPlayerSkins.geometryName(patch, "animated_face"),
+            2, BedrockPlayerSkins.geometryName(patch, "animated_32x32"),
+            3, BedrockPlayerSkins.geometryName(patch, "animated_128x128")), geometry, image, animations);
+        assertNotNull(parsed);
+        assertEquals(animations.size(), parsed.surfaces().size());
+        for (final var surface : parsed.surfaces()) {
+            final var animation = new BedrockSkinAnimation(surface.animation(), surface.model());
+            final var first = animation.frame(0);
+            final var last = animation.frame((int) surface.animation().frames() - 1);
+            assertEquals(first.getWidth(), last.getWidth());
+            assertEquals(first.getHeight(), last.getHeight());
+            if (surface.animation().frames() > 1) {
+                assertFalse(java.util.Arrays.equals(first.getRGB(0, 0, first.getWidth(), first.getHeight(), null, 0, first.getWidth()),
+                    last.getRGB(0, 0, last.getWidth(), last.getHeight(), null, 0, last.getWidth())));
+            }
+        }
+    }
+
+    private static String decode(final String value) {
+        return new String(Base64.getDecoder().decode(value), StandardCharsets.UTF_8);
+    }
+
+    private static BufferedImage image(final String value, final int width, final int height) {
+        final byte[] data = Base64.getDecoder().decode(value);
+        assertEquals(width * height * 4, data.length);
+        final BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        for (int pixel = 0; pixel < width * height; pixel++) {
+            final int offset = pixel * 4;
+            image.setRGB(pixel % width, pixel / width, (data[offset + 3] & 255) << 24 | (data[offset] & 255) << 16
+                | (data[offset + 1] & 255) << 8 | data[offset + 2] & 255);
+        }
+        return image;
+    }
+}
