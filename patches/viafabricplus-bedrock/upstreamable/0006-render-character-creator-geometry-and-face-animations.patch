+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockSkinAnimationTest {
+    @Test
+    void normalizesNativeVerticalStripGeometryAndBottomOriginMeshUvs() {
+        final JsonObject model = model(32, 64);
+        final var image = new BufferedImage(32, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(3, 7, 0xFF112233);
+        image.setRGB(3, 39, 0xFF445566);
+        final var data = new SkinData.AnimationData(image, 1, 2, 1);
+        BedrockSkinAnimation.normalizeGeometry(model, data);
+        final var uv = model.getAsJsonArray("bones").get(0).getAsJsonObject().getAsJsonObject("poly_mesh")
+            .getAsJsonArray("uvs").get(0).getAsJsonArray();
+        assertEquals(0.5F, uv.get(1).getAsFloat());
+        final var animation = new BedrockSkinAnimation(data, parse(model));
+        assertEquals(32, animation.frame(0).getHeight());
+        assertEquals(0xFF112233, animation.frame(0).getRGB(3, 7));
+        assertEquals(0xFF445566, animation.frame(1).getRGB(3, 7));
+        assertEquals(1, animation.frameIndex(0));
+        assertEquals(0, animation.frameIndex(100));
+        assertEquals(1, animation.frameIndex(4000));
+    }
+
+    @Test
+    void handlesHorizontalBodyFramesAndLinearWraparound() {
+        final JsonObject model = model(64, 32);
+        final var image = new BufferedImage(64, 32, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(5, 8, 0xFF112233);
+        image.setRGB(37, 8, 0xFF445566);
+        final var data = new SkinData.AnimationData(image, 2, 2, 0);
+        BedrockSkinAnimation.normalizeGeometry(model, data);
+        final var animation = new BedrockSkinAnimation(data, parse(model));
+        assertEquals(32, animation.frame(0).getWidth());
+        assertEquals(0xFF445566, animation.frame(1).getRGB(5, 8));
+        assertEquals(0, animation.frameIndex(0));
+        assertEquals(1, animation.frameIndex(100));
+        assertEquals(0, animation.frameIndex(200));
+    }
+
+    @Test
+    void acceptsFrameSizedGeometryAndRejectsIncompleteOrUnboundedStrips() {
+        final JsonObject model = model(32, 32);
+        final var data = new SkinData.AnimationData(new BufferedImage(32, 512, BufferedImage.TYPE_INT_ARGB), 2, 16, 0);
+        BedrockSkinAnimation.normalizeGeometry(model, data);
+        final var animation = new BedrockSkinAnimation(data, parse(model));
+        assertEquals(15, animation.frameIndex(1500));
+        assertEquals(0, animation.frameIndex(1600));
+        assertThrows(IllegalArgumentException.class, () -> animation.frame(16));
+        assertThrows(IllegalArgumentException.class, () -> new BedrockSkinAnimation(
+            new SkinData.AnimationData(data.image(), 2, Float.NaN, 0), parse(model)));
+        assertThrows(IllegalArgumentException.class, () -> new BedrockSkinAnimation(
+            new SkinData.AnimationData(data.image(), 2, 512, 0), parse(model)));
+        assertThrows(IllegalArgumentException.class, () -> new BedrockSkinAnimation(
+            new SkinData.AnimationData(new BufferedImage(32, 511, BufferedImage.TYPE_INT_ARGB), 2, 16, 0), parse(model)));
+    }
+
+    private static JsonObject model(final int width, final int height) {
+        final var model = JsonParser.parseString("""
+            {"description":{"identifier":"geometry.animation","texture_width":32,"texture_height":32},
+             "bones":[{"name":"head","pivot":[0,24,0],"rotation":[0,0,0],
+              "poly_mesh":{"normalized_uvs":true,"uvs":[[0.25,0.75]]}}]}
+            """).getAsJsonObject();
+        model.getAsJsonObject("description").addProperty("texture_width", width);
+        model.getAsJsonObject("description").addProperty("texture_height", height);
+        return model;
+    }
+
+    private static BedrockGeometryModel parse(final JsonObject model) {
+        final JsonObject data = new JsonObject();
+        final var models = new com.viaversion.viaversion.libs.gson.JsonArray();
+        models.add(model);
+        data.add("minecraft:geometry", models);
+        return BedrockGeometryModel.fromJson(data).getFirst();
+    }
+}
