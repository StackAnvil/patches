+import net.minecraft.client.renderer.texture.OverlayTexture;
+import net.minecraft.resources.Identifier;
+
+final class BedrockPersonaLayer extends RenderLayer<AvatarRenderState, PlayerModel> {
+
+    private final PlayerModel surfaceModel;
+    private final Identifier surfaceTexture;
+    private final Map<Boolean, RenderType> nativeMaterials = new HashMap<>();
+
+    BedrockPersonaLayer(final AvatarRenderer<?> parent, final PlayerModel surfaceModel, final Identifier surfaceTexture) {
+        super(parent);
+        this.surfaceModel = surfaceModel;
+        this.surfaceTexture = surfaceTexture;
+    }
+
+    @Override
+    public void submit(final PoseStack poseStack, final SubmitNodeCollector collector, final int packedLight,
+                       final AvatarRenderState state, final float yRot, final float xRot) {
+        this.surfaceModel.setupAnim(state);
+        final RenderType renderType;
+        if (BedrockPlayerRenderer.usesNativeMaterial(state, !state.isInvisible, false)) {
+            renderType = this.nativeMaterial();
+        } else {
+            renderType = RenderTypes.entityTranslucent(this.surfaceTexture);
+        }
+        collector.order(1).submitModel(this.surfaceModel, state, poseStack, renderType,
+            packedLight, OverlayTexture.NO_OVERLAY, state.outlineColor);
+    }
+
+    void submitHand(final PoseStack poseStack, final SubmitNodeCollector collector, final int packedLight,
+                    final boolean right, final boolean hasSleeve) {
+        final ModelPart arm = prepareHand(this.surfaceModel, right, hasSleeve);
+        collector.order(1).submitModelPart(arm, poseStack, this.nativeMaterial(), packedLight, OverlayTexture.NO_OVERLAY, null);
+    }
+
+    static ModelPart prepareHand(final PlayerModel model, final boolean right, final boolean hasSleeve) {
+        final ModelPart arm = right ? model.rightArm : model.leftArm;
+        // Keep this surface's bind pivot. World animation must not leak into Java's hand pass.
+        arm.getAllParts().forEach(ModelPart::resetPose);
+        arm.visible = true;
+        model.leftSleeve.visible = hasSleeve;
+        model.rightSleeve.visible = hasSleeve;
+        model.leftArm.zRot = -0.1F;
+        model.rightArm.zRot = 0.1F;
+        return arm;
+    }
+
+    private RenderType nativeMaterial() {
+        final boolean netherLighting = BedrockActorRenderTypes.usesNetherLighting();
+        return this.nativeMaterials.computeIfAbsent(netherLighting, _ -> BedrockActorRenderTypes.create(
+            this.surfaceTexture, false, false, false, 1F, BedrockActorUvTransform.IDENTITY, netherLighting));
+    }
+
+}
