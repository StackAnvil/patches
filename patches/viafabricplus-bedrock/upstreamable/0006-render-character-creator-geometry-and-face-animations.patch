+
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.awt.image.BufferedImage;
+import java.util.List;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.minecraft.util.RandomSource;
+import org.cube.converter.model.element.Parent;
+import org.cube.converter.util.element.Position3V;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+final class BedrockPersonaGeometryTest {
+
+    @Test
+    void buildsIndexedMeshFacesWithBedrockPivotsAndNormalizedUvs() {
+        final JsonObject mesh = mesh();
+        final var bone = new Parent("head", new Position3V(2, 24, 0), Position3V.zero());
+        final var part = BedrockGeometry.meshPart(mesh, bone, 256, 256);
+        final var face = part.getRandomCube(RandomSource.create()).polygons[0];
+
+        assertEquals(4, face.vertices().length);
+        assertEquals(-2, face.vertices()[0].x());
+        assertEquals(1, face.vertices()[0].y());
+        assertEquals(0.5F, face.vertices()[0].u());
+        assertEquals(0.75F, face.vertices()[0].v());
+        assertEquals(-1F, face.normal().y());
+    }
+
+    @Test
+    void installsOnlyCompleteStaticPersonaGeometry() {
+        final JsonObject model = new JsonObject();
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", "geometry.test.persona");
+        description.addProperty("texture_width", 256);
+        description.addProperty("texture_height", 256);
+        model.add("description", description);
+        final JsonArray bones = new JsonArray();
+        for (String name : List.of("head", "body", "rightarm", "leftarm", "rightleg", "leftleg")) {
+            final JsonObject bone = new JsonObject();
+            bone.addProperty("name", name);
+            bone.add("poly_mesh", mesh());
+            bones.add(bone);
+        }
+        model.add("bones", bones);
+        final JsonObject data = new JsonObject();
+        final JsonArray models = new JsonArray();
+        models.add(model);
+        data.add("minecraft:geometry", models);
+
+        assertNotNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(), List.of()));
+        models.add(model.deepCopy());
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(), List.of()));
+        models.remove(1);
+        bones.remove(0);
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(), List.of()));
+    }
+
+    @Test
+    void combinesBodyAndAnimatedFaceModels() {
+        final JsonObject body = personaModel("geometry.test.persona");
+        final JsonArray bodyBones = body.getAsJsonArray("bones");
+        bodyBones.get(0).getAsJsonObject().remove("poly_mesh");
+        final JsonObject data = new JsonObject();
+        final JsonArray models = new JsonArray();
+        models.add(body);
+        models.add(faceModel("geometry.animated_face_test"));
+        data.add("minecraft:geometry", models);
+        final BufferedImage faceImage = new BufferedImage(256, 256, BufferedImage.TYPE_INT_ARGB);
+        final List<SkinData.AnimationData> animations = List.of(new SkinData.AnimationData(faceImage, 1, 1F, 1));
+
+        final BedrockPlayerSkins.Geometry geometry = BedrockPlayerSkins.personaGeometry(
+            "geometry.test.persona", "", data.toString(), bodyImage(), animations);
+
+        assertNotNull(geometry);
+        assertNotNull(geometry.face());
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(), List.of()));
+
+        final SkinData.AnimationData bodyAnimation = new SkinData.AnimationData(
+            new BufferedImage(64, 32, BufferedImage.TYPE_INT_ARGB), 2, 2F, 0);
+        final BedrockPlayerSkins.Geometry withBodyAnimation = BedrockPlayerSkins.personaGeometry(
+            "geometry.test.persona", "", data.toString(), bodyImage(), List.of(bodyAnimation, animations.getFirst()));
+        assertNotNull(withBodyAnimation);
+        assertNotNull(withBodyAnimation.face());
+    }
+
+    @Test
+    void selectsNamedPersonaGeometryAmongUnusedModels() {
+        final JsonArray models = new JsonArray();
+        models.add(personaModel("geometry.unused.variant"));
+        models.add(personaModel("geometry.test.persona"));
+        models.add(personaModel("geometry.unused.variant_two"));
+        final JsonObject data = new JsonObject();
+        data.add("minecraft:geometry", models);
+
+        final BedrockPlayerSkins.Geometry geometry = BedrockPlayerSkins.personaGeometry(
+            "geometry.test.persona", "", data.toString(), bodyImage(), List.of());
+
+        assertNotNull(geometry);
+        assertEquals("geometry.test.persona", geometry.model().getIdentifier());
+        assertNull(geometry.face());
+    }
+
+    @Test
+    void keepsAnimatedFaceWhenUnusedModelsArePresent() {
+        final JsonArray models = new JsonArray();
+        models.add(personaModel("geometry.unused.variant"));
+        models.add(personaModel("geometry.test.persona"));
+        models.add(faceModel("geometry.animated_face_test"));
+        final JsonObject data = new JsonObject();
+        data.add("minecraft:geometry", models);
+        final BufferedImage faceImage = new BufferedImage(256, 256, BufferedImage.TYPE_INT_ARGB);
+        final List<SkinData.AnimationData> animations = List.of(new SkinData.AnimationData(faceImage, 1, 1F, 1));
+
+        final BedrockPlayerSkins.Geometry geometry = BedrockPlayerSkins.personaGeometry(
+            "geometry.test.persona", "", data.toString(), bodyImage(), animations);
+
+        assertNotNull(geometry);
+        assertNotNull(geometry.face());
+        final BufferedImage invalidFaceImage = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(),
+            List.of(new SkinData.AnimationData(invalidFaceImage, 1, 1F, 1))));
+        models.add(personaModel("geometry.animated_face_other"));
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(), bodyImage(), animations));
+    }
+
+    @Test
+    void selectsAnimatedFaceNamedByResourcePatch() {
+        final JsonArray models = new JsonArray();
+        models.add(personaModel("geometry.test.persona"));
+        models.add(faceModel("geometry.animated_face_unused"));
+        models.add(faceModel("geometry.animated_face_selected"));
+        final JsonObject data = new JsonObject();
+        data.add("minecraft:geometry", models);
+        final String resourcePatch = "{\"geometry\":{\"default\":\"geometry.test.persona\","
+            + "\"animated_face\":\"geometry.animated_face_selected\"}}";
+        final BufferedImage faceImage = new BufferedImage(256, 256, BufferedImage.TYPE_INT_ARGB);
+        final List<SkinData.AnimationData> animations = List.of(new SkinData.AnimationData(faceImage, 1, 1F, 1));
+
+        final BedrockPlayerSkins.Geometry geometry = BedrockPlayerSkins.personaGeometry(
+            BedrockPlayerSkins.geometryName(resourcePatch, "default"),
+            BedrockPlayerSkins.geometryName(resourcePatch, "animated_face"),
+            data.toString(), bodyImage(), animations);
+
+        assertNotNull(geometry);
+        assertNotNull(geometry.face());
+        assertEquals("geometry.animated_face_selected", geometry.face().model().getIdentifier());
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "geometry.animated_face_missing",
+            data.toString(), bodyImage(), animations));
+    }
+
+    @Test
+    void rejectsPersonaGeometryWithMismatchedBodyTexture() {
+        final JsonObject data = new JsonObject();
+        final JsonArray models = new JsonArray();
+        models.add(personaModel("geometry.test.persona"));
+        data.add("minecraft:geometry", models);
+
+        assertNull(BedrockPlayerSkins.personaGeometry("geometry.test.persona", "", data.toString(),
+            new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB), List.of()));
+    }
+
+    private static BufferedImage bodyImage() {
+        return new BufferedImage(256, 256, BufferedImage.TYPE_INT_ARGB);
+    }
+
+    private static JsonObject faceModel(final String identifier) {
+        final JsonObject face = personaModel(identifier);
+        final JsonArray bones = face.getAsJsonArray("bones");
+        for (int index = bones.size() - 1; index > 0; index--) {
+            bones.remove(index);
+        }
+        return face;
+    }
+
+    private static JsonObject personaModel(final String identifier) {
+        final JsonObject model = new JsonObject();
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", identifier);
+        description.addProperty("texture_width", 256);
+        description.addProperty("texture_height", 256);
+        model.add("description", description);
+        final JsonArray bones = new JsonArray();
+        for (String name : List.of("head", "body", "rightarm", "leftarm", "rightleg", "leftleg")) {
+            final JsonObject bone = new JsonObject();
+            bone.addProperty("name", name);
+            bone.add("poly_mesh", mesh());
+            bones.add(bone);
+        }
+        model.add("bones", bones);
+        return model;
+    }
+
+    private static JsonObject mesh() {
+        final JsonObject mesh = new JsonObject();
+        mesh.addProperty("normalized_uvs", true);
+        final JsonArray positions = new JsonArray();
+        positions.add(vector(0, 23, 0));
+        positions.add(vector(1, 23, 0));
+        positions.add(vector(1, 24, 0));
+        positions.add(vector(0, 24, 0));
+        mesh.add("positions", positions);
+        final JsonArray normals = new JsonArray();
+        normals.add(vector(0, 1, 0));
+        mesh.add("normals", normals);
+        final JsonArray uvs = new JsonArray();
+        uvs.add(vector(0.5F, 0.25F));
+        uvs.add(vector(0.75F, 0.25F));
+        uvs.add(vector(0.75F, 0.5F));
+        uvs.add(vector(0.5F, 0.5F));
+        mesh.add("uvs", uvs);
+        final JsonArray polygon = new JsonArray();
+        for (int i = 0; i < 4; i++) {
+            final JsonArray indices = new JsonArray();
+            indices.add(i);
+            indices.add(0);
+            indices.add(i);
+            polygon.add(indices);
+        }
+        final JsonArray polygons = new JsonArray();
+        polygons.add(polygon);
+        mesh.add("polys", polygons);
+        return mesh;
+    }
+
+    private static JsonArray vector(final float... values) {
+        final JsonArray vector = new JsonArray();
+        for (float value : values) {
+            vector.add(value);
+        }
+        return vector;
+    }
+}
