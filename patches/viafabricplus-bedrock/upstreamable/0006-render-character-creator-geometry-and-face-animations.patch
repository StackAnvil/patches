+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockPersonaHandsTest {
+    @Test
+    void resetsEachSurfaceToItsOwnBindPoseWithoutLosingNestedGeometry() {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.hand","texture_width":32,"texture_height":32},
+            "bones":[{"name":"rightArm","pivot":[-6,21,2],"rotation":[12,34,56],
+            "cubes":[{"origin":[-9,9,0],"size":[4,12,4],"uv":[0,0]}]},
+            {"name":"rightSleeve","pivot":[-5,20,3]},
+            {"name":"leftArm","pivot":[7,23,-1],"rotation":[-10,20,30],
+            "cubes":[{"origin":[5,11,-3],"size":[4,12,4],"uv":[0,0]}]},
+            {"name":"leftSleeve","pivot":[6,21,0]}]}]}
+            """).getFirst();
+        final var model = BedrockGeometry.playerModel(geometry, false);
+        for (boolean right : new boolean[]{true, false}) {
+            final var arm = right ? model.rightArm : model.leftArm;
+            final var bind = arm.getInitialPose();
+            arm.setPos(100, 200, 300);
+            arm.setRotation(1, 2, 3);
+            arm.xScale = arm.yScale = arm.zScale = 4;
+            arm.visible = false;
+            final var sleeve = right ? model.rightSleeve : model.leftSleeve;
+            sleeve.loadPose(arm.storePose());
+            final var cube = arm.getChild("cube_0");
+            final var cubeBind = cube.getInitialPose();
+            cube.setPos(10, 20, 30);
+            cube.setRotation(1, 2, 3);
+            cube.xScale = 5;
+
+            assertSame(arm, BedrockPersonaLayer.prepareHand(model, right, false));
+            assertEquals(bind.x(), arm.x);
+            assertEquals(bind.y(), arm.y);
+            assertEquals(bind.z(), arm.z);
+            assertEquals(bind.xRot(), arm.xRot);
+            assertEquals(bind.yRot(), arm.yRot);
+            assertEquals(right ? 0.1F : -0.1F, arm.zRot);
+            assertEquals(1, arm.xScale);
+            assertEquals(1, arm.yScale);
+            assertEquals(1, arm.zScale);
+            assertTrue(arm.visible);
+            assertEquals(cubeBind, cube.storePose());
+            assertEquals(sleeve.getInitialPose(), sleeve.storePose());
+            assertFalse(model.rightSleeve.visible);
+            assertFalse(model.leftSleeve.visible);
+
+            // Converted arms hold their cubes in children, even when the arm itself is empty.
+            assertTrue(arm.isEmpty());
+            final var cubes = new AtomicInteger();
+            arm.visit(new PoseStack(), (_, _, _, _) -> cubes.incrementAndGet());
+            assertEquals(1, cubes.get());
+            BedrockPersonaLayer.prepareHand(model, right, true);
+            assertTrue(model.rightSleeve.visible);
+            assertTrue(model.leftSleeve.visible);
+        }
+        assertEquals(1, model.rightSleeve.x);
+        assertEquals(1, model.rightSleeve.y);
+        assertEquals(1, model.rightSleeve.z);
+        assertEquals(-1, model.leftSleeve.x);
+        assertEquals(2, model.leftSleeve.y);
+        assertEquals(1, model.leftSleeve.z);
+    }
+}
