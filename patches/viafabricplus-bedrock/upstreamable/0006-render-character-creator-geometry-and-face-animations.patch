+            this.blinking = false;
+        }
+        if (lifeTime != this.lastSampleTime) {
+            // Bedrock 1.26.51.1's persona blink controller evaluates one state per frame.
+            // Its random threshold is sampled on every open-state evaluation.
+            switch (this.blinkState) {
+                case DEFAULT -> {
+                    this.blinking = false;
+                    this.lastBlinkTime = lifeTime;
+                    if (lifeTime != 0) this.blinkState = BlinkState.OPEN;
+                }
+                case OPEN -> {
+                    this.blinking = false;
+                    this.returnFromBlink = lifeTime + (float) (this.random.getAsDouble() * 0.2);
+                    if (lifeTime
+                            > this.lastBlinkTime + (float) (3 + this.random.getAsDouble() * 37)) {
+                        this.blinkState = BlinkState.BLINK;
+                    }
+                }
+                case BLINK -> {
+                    this.blinking = true;
+                    this.lastBlinkTime = lifeTime;
+                    // This controller's blink state has no animations to await.
+                    if (lifeTime > this.returnFromBlink) this.blinkState = BlinkState.OPEN;
+                }
+            }
+            this.lastSampleTime = lifeTime;
+        }
+        return this.blinking ? this.frameCount / 2 : 0;
+    }
+
+    private enum BlinkState {
+        DEFAULT,
+        OPEN,
+        BLINK
+    }
+
+    BufferedImage frame(final int index) {
+        if (index < 0 || index >= this.frameCount) {
+            throw new IllegalArgumentException("Invalid animation frame index");
+        }
+        return this.image.getSubimage(
+                this.vertical ? 0 : index * this.width,
+                this.vertical ? index * this.height : 0,
+                this.width,
+                this.height);
+    }
+
+    void update(final Identifier textureId, final float lifeTimeSeconds) {
+        if (this.frameCount == 1) {
+            return;
+        }
+        final int next = this.frameIndex(lifeTimeSeconds);
+        if (next == this.currentFrame) {
+            return;
+        }
+        final DynamicTexture texture =
+                (DynamicTexture) Minecraft.getInstance().getTextureManager().getTexture(textureId);
+        final NativeImage pixels = texture.getPixels();
+        final BufferedImage frame = this.frame(next);
+        for (int y = 0; y < this.height; y++) {
+            for (int x = 0; x < this.width; x++) {
+                final int argb = frame.getRGB(x, y);
+                pixels.setPixelABGR(
+                        x, y, (argb & 0xFF00FF00) | ((argb & 0xFF) << 16) | ((argb >>> 16) & 0xFF));
+            }
+        }
+        texture.upload();
+        this.currentFrame = next;
+    }
+}
