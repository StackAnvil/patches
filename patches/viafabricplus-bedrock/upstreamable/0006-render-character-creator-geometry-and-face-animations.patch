+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+import net.raphimc.viabedrock.protocol.model.SkinData;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+import java.awt.image.BufferedImage;
+import java.util.List;
+
+final class BedrockSkinAnimationTest {
+    @Test
+    void normalizesNativeVerticalStripGeometryAndBottomOriginMeshUvs() {
+        final JsonObject model = model(32, 64);
+        final var image = new BufferedImage(32, 64, BufferedImage.TYPE_INT_ARGB);
+        image.setRGB(3, 7, 0xFF112233);
+        image.setRGB(3, 39, 0xFF445566);
+        final var data = new SkinData.AnimationData(image, 1, 2, 1);
+        BedrockSkinAnimation.normalizeGeometry(model, data);
+        final var uv =
+                model.getAsJsonArray("bones")
+                        .get(0)
+                        .getAsJsonObject()
+                        .getAsJsonObject("poly_mesh")
+                        .getAsJsonArray("uvs")
+                        .get(0)
+                        .getAsJsonArray();
+        assertEquals(0.5F, uv.get(1).getAsFloat());
+        final var animation = new BedrockSkinAnimation(data, parse(model));
+        assertEquals(32, animation.frame(0).getHeight());
+        assertEquals(0xFF112233, animation.frame(0).getRGB(3, 7));
+        assertEquals(0xFF445566, animation.frame(1).getRGB(3, 7));
