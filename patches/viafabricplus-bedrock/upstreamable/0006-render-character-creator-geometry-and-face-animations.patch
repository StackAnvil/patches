+                return animations.isEmpty() ? new Geometry(parsedBody, Map.copyOf(bodyMeshes), null) : null;
+            }
+            if (animations.size() != 1 || animations.getFirst().type() != 1 || !supportedImage(animations.getFirst().image())) {
+                return null;
+            }
+            final BedrockGeometryModel parsedFace = parsePersonaModel(face);
+            BedrockGeometry.playerModel(parsedFace, false, faceMeshes);
+            try {
+                new BedrockPersonaFaceAnimation(animations.getFirst(), parsedFace);
+            } catch (IllegalArgumentException e) {
+                return null;
+            }
+            return new Geometry(parsedBody, Map.copyOf(bodyMeshes),
+                new Face(parsedFace, Map.copyOf(faceMeshes), animations.getFirst()));
+        } catch (RuntimeException e) {
+            ViaFabricPlusBedrock.impl().logger().warn("Failed to parse Bedrock persona geometry", e);
+            return null;
+        }
+    }
+
+    private static Map<String, JsonObject> normalizePersonaModel(final JsonObject model, final Map<String, Boolean> surfaces) {
+        final Map<String, JsonObject> meshes = new HashMap<>();
+        for (var entry : model.getAsJsonArray("bones")) {
+            final JsonObject bone = entry.getAsJsonObject();
+            final String boneName = bone.get("name").getAsString();
+            if (!bone.has("pivot")) {
+                bone.add("pivot", zeroVector());
+            }
+            if (!bone.has("rotation")) {
+                bone.add("rotation", zeroVector());
+            }
+            if (bone.has("poly_mesh")) {
+                meshes.put(boneName, bone.getAsJsonObject("poly_mesh"));
+            }
+            if (bone.has("cubes")) {
+                for (var cubeEntry : bone.getAsJsonArray("cubes")) {
+                    final JsonObject cube = cubeEntry.getAsJsonObject();
+                    if (!cube.has("pivot")) {
+                        cube.add("pivot", bone.getAsJsonArray("pivot").deepCopy());
+                    }
+                    if (!cube.has("rotation")) {
+                        cube.add("rotation", zeroVector());
+                    }
+                }
+            }
+            final boolean hasSurface = bone.has("poly_mesh") || bone.has("cubes") && !bone.getAsJsonArray("cubes").isEmpty();
+            surfaces.merge(boneName.toLowerCase(Locale.ROOT).replace("_", ""), hasSurface, Boolean::logicalOr);
+        }
+        return meshes;
+    }
+
+    private static BedrockGeometryModel parsePersonaModel(final JsonObject model) {
+        final JsonObject normalized = new JsonObject();
+        final JsonArray selected = new JsonArray();
+        selected.add(model);
+        normalized.add("minecraft:geometry", selected);
+        return BedrockGeometryModel.fromJson(normalized).getFirst();
+    }
+
+    private static JsonArray zeroVector() {
+        final JsonArray vector = new JsonArray();
+        vector.add(0);
+        vector.add(0);
+        vector.add(0);
+        return vector;
+    }
+
+    record Geometry(BedrockGeometryModel model, Map<String, JsonObject> meshes, Face face) {
+    }
+
+    record Face(BedrockGeometryModel model, Map<String, JsonObject> meshes, SkinData.AnimationData animation) {
+    }
