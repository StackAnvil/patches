@@ -0,0 +1,135 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import java.awt.image.BufferedImage;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+
+/** Uploads frames for the separate animated surfaces in a Bedrock skin. */
+final class BedrockSkinAnimation {
+
+    private static final long FRAME_DURATION_MS = 100;
+    private static final long BLINK_PERIOD_MS = 4_000;
+
+    private final BufferedImage image;
+    private final int width;
+    private final int height;
+    private final int frameCount;
+    private final boolean vertical;
+    private final int expression;
+    private int currentFrame;
+
+    BedrockSkinAnimation(final SkinData.AnimationData animation, final BedrockGeometryModel model) {
+        this.image = animation.image();
+        this.width = (int) model.getTextureSize().getX();
+        this.height = (int) model.getTextureSize().getY();
+        this.expression = animation.expression();
+        final int declaredFrames = (int) animation.frames();
+        if (this.image == null || this.width <= 0 || this.height <= 0 || declaredFrames < 1
+            || declaredFrames > 256 || declaredFrames != animation.frames()
+            || this.width > 1024 || this.height > 1024
+            || (long) this.image.getWidth() * this.image.getHeight() > 4 * 1024 * 1024) {
+            throw new IllegalArgumentException("Invalid Bedrock skin animation");
+        }
+        if (declaredFrames == 1 && this.image.getWidth() == this.width && this.image.getHeight() == this.height) {
+            this.frameCount = 1;
+            this.vertical = true;
+        } else if (this.image.getWidth() == this.width && this.image.getHeight() == this.height * declaredFrames) {
+            this.frameCount = declaredFrames;
+            this.vertical = true;
+        } else if (this.image.getWidth() == this.width * declaredFrames && this.image.getHeight() == this.height) {
+            this.frameCount = declaredFrames;
+            this.vertical = false;
+        } else {
+            throw new IllegalArgumentException("Animation frames do not match geometry texture size");
+        }
+    }
+
+    static void normalizeGeometry(final JsonObject model, final SkinData.AnimationData animation) {
+        final JsonObject description = model.getAsJsonObject("description");
+        final int width = description.get("texture_width").getAsInt();
+        final int height = description.get("texture_height").getAsInt();
+        final BufferedImage image = animation.image();
+        final int frames = (int) animation.frames();
+        if (image == null || frames < 1 || frames > 256 || frames != animation.frames()
+            || width < 1 || height < 1) {
+            throw new IllegalArgumentException("Invalid animated geometry texture");
+        }
+        if (frames == 1 || image.getWidth() != width || image.getHeight() != height) {
+            return;
+        }
+        final int nominalSize = animation.type() == 3 ? 128 : 32;
+        final boolean horizontal = height == nominalSize && width == nominalSize * frames;
+        final int frameWidth = horizontal ? width / frames : width;
+        final int frameHeight = horizontal ? height : height / frames;
+        if ((!horizontal && height % frames != 0) || frameHeight < 1) {
+            throw new IllegalArgumentException("Animation strip does not contain complete frames");
+        }
+        description.addProperty("texture_width", frameWidth);
+        description.addProperty("texture_height", frameHeight);
+        for (final var element : model.getAsJsonArray("bones")) {
+            final JsonObject bone = element.getAsJsonObject();
+            if (!bone.has("poly_mesh")) {
+                continue;
+            }
+            final JsonObject mesh = bone.getAsJsonObject("poly_mesh");
+            final boolean normalized = mesh.has("normalized_uvs") && mesh.get("normalized_uvs").getAsBoolean();
+            for (final var entry : mesh.getAsJsonArray("uvs")) {
+                final var uv = entry.getAsJsonArray();
+                if (normalized) {
+                    uv.set(0, new com.viaversion.viaversion.libs.gson.JsonPrimitive(uv.get(0).getAsFloat() * width / frameWidth));
+                    uv.set(1, new com.viaversion.viaversion.libs.gson.JsonPrimitive(1F - (1F - uv.get(1).getAsFloat()) * height / frameHeight));
+                } else {
+                    uv.set(1, new com.viaversion.viaversion.libs.gson.JsonPrimitive(uv.get(1).getAsFloat() - height + frameHeight));
+                }
+            }
+        }
+    }
+
+    int frameIndex(final long elapsedMillis) {
+        final long elapsed = Math.max(0, elapsedMillis);
+        return this.expression == 1
+            ? elapsed % BLINK_PERIOD_MS < (long) (this.frameCount - 1) * FRAME_DURATION_MS
+                ? 1 + (int) (elapsed % BLINK_PERIOD_MS / FRAME_DURATION_MS) : 0
+            : (int) (elapsed / FRAME_DURATION_MS % this.frameCount);
+    }
+
+    BufferedImage frame(final int index) {
+        if (index < 0 || index >= this.frameCount) {
+            throw new IllegalArgumentException("Invalid animation frame index");
+        }
+        return this.image.getSubimage(this.vertical ? 0 : index * this.width,
+            this.vertical ? index * this.height : 0, this.width, this.height);
+    }
+
+    void update(final Identifier textureId, final long nowMillis) {
+        if (this.frameCount == 1) {
+            return;
+        }
+        final int next = this.frameIndex(nowMillis);
+        if (next == this.currentFrame) {
+            return;
+        }
+        final DynamicTexture texture = (DynamicTexture) Minecraft.getInstance().getTextureManager().getTexture(textureId);
+        final NativeImage pixels = texture.getPixels();
+        final BufferedImage frame = this.frame(next);
+        for (int y = 0; y < this.height; y++) {
+            for (int x = 0; x < this.width; x++) {
+                final int argb = frame.getRGB(x, y);
+                pixels.setPixelABGR(x, y, (argb & 0xFF00FF00) | ((argb & 0xFF) << 16) | ((argb >>> 16) & 0xFF));
+            }
+        }
+        texture.upload();
+        this.currentFrame = next;
+    }
+
+}
