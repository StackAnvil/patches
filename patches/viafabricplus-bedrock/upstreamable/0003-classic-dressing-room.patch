+            put(zip, "manifest.json", "{" +
+                "\"modules\":[{\"type\":\"skin_pack\"}]}");
+            put(zip, "skins.json", "{" +
+                "\"localization_name\":\"example\",\"skins\":[" +
+                "{\"localization_name\":\"one\",\"geometry\":\"geometry.humanoid.customSlim\",\"texture\":\"one.png\"}," +
+                "{\"localization_name\":\"two\",\"geometry\":\"geometry.humanoid.custom\",\"texture\":\"two.png\"}]}");
+            put(zip, "texts/en_US.lang", "skinpack.example=Example pack\nskin.example.one=First skin\n");
+            put(zip, "one.png", image(64, 64));
+            put(zip, "two.png", image(128, 128));
+        }
+
+        final BedrockClassicSkinPack pack = BedrockClassicSkinPack.read(archive);
+        assertEquals("Example pack", pack.name());
