+            {"format_version":"1.8.0","geometry.robot":{"texturewidth":64,"textureheight":32,
+              "bones":[{"name":"body","pivot":[0,12,0],"cubes":[{"origin":[-4,0,-2],"size":[8,24,4],"uv":[0,0]}]}]}}
