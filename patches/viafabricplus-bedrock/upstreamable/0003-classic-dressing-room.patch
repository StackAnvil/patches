index 0000000..41eea2d
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockClassicSkinPack.java
@@ -0,0 +1,193 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/** Reads the standard manifest.json and skins.json format of a local Classic Skin pack. */
+public record BedrockClassicSkinPack(Path path, String name, List<Skin> skins) {
+
+    private static final int MAX_ARCHIVE_BYTES = 64 * 1024 * 1024;
+    private static final int MAX_METADATA_BYTES = 1024 * 1024;
+    private static final int MAX_SKIN_BYTES = 8 * 1024 * 1024;
+
+    public static BedrockClassicSkinPack read(final Path path) throws IOException {
+        if (!Files.isRegularFile(path) || Files.size(path) > MAX_ARCHIVE_BYTES) {
+            throw new IOException("The skin pack is missing or too large");
+        }
+        try (ZipFile zip = new ZipFile(path.toFile())) {
+            validateEntries(zip);
+            final String root = packRoot(zip);
+            final JsonObject manifest = json(zip, root + "manifest.json");
+            if (!isSkinPack(manifest)) {
+                throw new IOException("The archive is not a Bedrock skin pack");
+            }
+            final JsonObject definitions = json(zip, root + "skins.json");
+            final String key = string(definitions, "localization_name");
+            final Map<String, String> names = translations(zip, root);
+            final String packName = names.getOrDefault("skinpack." + key, key);
+            final List<Skin> skins = new ArrayList<>();
+            final JsonArray entries = definitions.has("skins") && definitions.get("skins").isJsonArray()
+                ? definitions.getAsJsonArray("skins") : new JsonArray();
+            for (final JsonElement element : entries) {
+                if (!element.isJsonObject()) {
+                    continue;
+                }
+                final JsonObject definition = element.getAsJsonObject();
+                final String geometry = string(definition, "geometry");
+                final boolean standard = "geometry.humanoid.custom".equals(geometry) || "geometry.humanoid.customSlim".equals(geometry);
+                final BedrockClassicModel model = standard ? null : BedrockClassicModel.read(
+                    json(zip, root + "geometry.json").toString(), geometry);
+                final String texture = string(definition, "texture");
+                if (!safePath(texture) || !texture.endsWith(".png")
+                    || zip.getEntry(root + texture) == null) {
+                    continue;
+                }
+                final String skinKey = string(definition, "localization_name");
+                final String name = names.getOrDefault("skin." + key + "." + skinKey, skinKey);
+                skins.add(new Skin(name.isBlank() ? texture : name, root + texture, geometry.endsWith("customSlim"), model));
+                if (skins.size() > 256) {
+                    throw new IOException("The skin pack contains too many skins");
+                }
+            }
+            if (skins.isEmpty()) {
+                throw new IOException("The skin pack has no supported Classic Skins");
+            }
+            return new BedrockClassicSkinPack(path, packName.isBlank() ? path.getFileName().toString() : packName,
+                List.copyOf(skins));
+        } catch (IllegalStateException | com.google.gson.JsonParseException e) {
+            throw new IOException("The skin pack metadata is invalid", e);
+        }
+    }
+
+    public BufferedImage image(final Skin skin) throws IOException {
+        if (!this.skins.contains(skin)) {
+            throw new IOException("The skin is not in this pack");
+        }
+        try (ZipFile zip = new ZipFile(this.path.toFile())) {
+            return skin.model() == null ? BedrockAppearanceStore.readSkin(bytes(zip, skin.texture(), MAX_SKIN_BYTES))
+                : BedrockAppearanceStore.readTexture(bytes(zip, skin.texture(), MAX_SKIN_BYTES));
+        }
+    }
+
+    private static String packRoot(final ZipFile zip) throws IOException {
+        final List<String> roots = zip.stream()
+            .filter(entry -> !entry.isDirectory() && (entry.getName().equals("manifest.json")
+                || entry.getName().endsWith("/manifest.json")))
+            .map(entry -> entry.getName().substring(0, entry.getName().length() - "manifest.json".length()))
+            .filter(root -> zip.getEntry(root + "skins.json") != null)
+            .toList();
+        if (roots.size() != 1) {
+            throw new IOException("The archive must contain one skin pack manifest and skins.json");
+        }
+        return roots.getFirst();
+    }
+
+    private static void validateEntries(final ZipFile zip) throws IOException {
+        if (zip.size() > 4096) {
+            throw new IOException("The skin pack contains too many files");
+        }
+        final Set<String> names = new HashSet<>();
+        long size = 0;
+        final var entries = zip.entries();
+        while (entries.hasMoreElements()) {
+            final ZipEntry entry = entries.nextElement();
+            final String name = entry.getName();
+            final String path = entry.isDirectory() && name.endsWith("/")
+                ? name.substring(0, name.length() - 1) : name;
+            if (!safePath(path) || !names.add(name)) {
+                throw new IOException("The skin pack contains an invalid or duplicate path");
+            }
+            if (entry.getSize() < 0 || entry.getSize() > MAX_ARCHIVE_BYTES
+                || (size += entry.getSize()) > MAX_ARCHIVE_BYTES) {
+                throw new IOException("The expanded skin pack is too large");
+            }
+        }
+    }
+
+    private static boolean safePath(final String name) {
+        if (name.isBlank() || name.startsWith("/") || name.contains("\\") || name.contains(":")) return false;
+        for (final String part : name.split("/", -1)) {
+            if (part.isEmpty() || part.equals(".") || part.equals("..")) return false;
+        }
+        return true;
+    }
+
+    private static boolean isSkinPack(final JsonObject manifest) {
+        if (!manifest.has("modules") || !manifest.get("modules").isJsonArray()) {
+            return false;
+        }
+        for (final JsonElement element : manifest.getAsJsonArray("modules")) {
+            if (element.isJsonObject() && "skin_pack".equals(string(element.getAsJsonObject(), "type"))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static JsonObject json(final ZipFile zip, final String name) throws IOException {
+        try {
+            return JsonParser.parseString(new String(bytes(zip, name, MAX_METADATA_BYTES), StandardCharsets.UTF_8)).getAsJsonObject();
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid " + name + " in skin pack", e);
+        }
+    }
+
+    private static Map<String, String> translations(final ZipFile zip, final String root) throws IOException {
+        if (zip.getEntry(root + "texts/en_US.lang") == null) {
+            return Map.of();
+        }
+        final Map<String, String> names = new HashMap<>();
+        final String contents = new String(bytes(zip, root + "texts/en_US.lang", MAX_METADATA_BYTES), StandardCharsets.UTF_8);
+        for (final String line : contents.split("\\R")) {
+            final int equals = line.indexOf('=');
+            if (equals > 0 && !line.startsWith("#")) {
+                names.put(line.substring(0, equals).trim(), line.substring(equals + 1).trim());
+            }
+        }
+        return names;
+    }
+
+    private static byte[] bytes(final ZipFile zip, final String name, final int maxBytes) throws IOException {
+        final ZipEntry entry = zip.getEntry(name);
+        if (entry == null || entry.isDirectory() || entry.getSize() > maxBytes) {
+            throw new IOException("Missing or oversized " + name + " in skin pack");
+        }
+        try (InputStream input = zip.getInputStream(entry)) {
+            final byte[] bytes = input.readNBytes(maxBytes + 1);
+            if (bytes.length > maxBytes) {
+                throw new IOException("Oversized " + name + " in skin pack");
+            }
+            return bytes;
+        }
+    }
+
+    private static String string(final JsonObject object, final String key) {
+        return object.has(key) && object.get(key).isJsonPrimitive() ? object.get(key).getAsString() : "";
+    }
+
+    public record Skin(String name, String texture, boolean slim, BedrockClassicModel model) {
+    }
+
+}
