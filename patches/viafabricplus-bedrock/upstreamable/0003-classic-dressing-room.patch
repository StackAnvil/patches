+
+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockAppearanceStore;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerSkins;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockClassicSkinPack;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockClassicSkinPack.Skin;
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.components.PlayerSkinWidget;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.entity.player.PlayerSkin;
+import org.jspecify.annotations.NonNull;
+
+/** Lets the player inspect and select one skin from a local Classic Skin pack. */
+public final class BedrockClassicSkinPackScreen extends VFPScreen {
+
+    private final BedrockDressingRoomScreen dressingRoom;
+    private final BedrockClassicSkinPack pack;
+    private int selected;
+    private PlayerSkin previewSkin;
+    private BufferedImage selectedImage;
+    private Component error;
+    private BedrockPlayerSkins.Preview preview;
+
+    public BedrockClassicSkinPackScreen(final BedrockDressingRoomScreen dressingRoom, final BedrockClassicSkinPack pack) {
+        super(Component.literal(pack.name()), true);
+        this.dressingRoom = dressingRoom;
+        this.pack = pack;
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        final int left = this.width / 2 - 150;
+        final int top = Math.max(CONTENT_TOP, (this.height - 250) / 2);
+        this.addRenderableWidget(Button.builder(Component.translatable("bedrock_dressing_room.viafabricplus.previous_skin"),
+            _ -> this.changeSkin(-1)).bounds(left, top, 146, 20).build());
+        this.addRenderableWidget(Button.builder(Component.translatable("bedrock_dressing_room.viafabricplus.next_skin"),
+            _ -> this.changeSkin(1)).bounds(left + 154, top, 146, 20).build());
+        this.addFooter(Button.builder(Component.translatable("bedrock_dressing_room.viafabricplus.use_pack_skin"),
+            _ -> this.importSkin()).build());
+        final PlayerSkinWidget preview = new PlayerSkinWidget(145, Math.min(200, Math.max(60, this.height - top - 90)),
+            this.minecraft.getEntityModels(), () -> this.previewSkin);
+        preview.setX(left);
+        preview.setY(top + 30);
+        this.addRenderableWidget(preview);
+        this.showSkin();
+    }
+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    public void extractRenderState(final @NonNull GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        final int left = this.width / 2 - 150;
+        final int top = Math.max(CONTENT_TOP, (this.height - 250) / 2) + 30;
+        final Skin skin = this.pack.skins().get(this.selected);
+        graphics.textWithWordWrap(this.font, Component.literal(skin.name()), left + 157, top + 4, 143, -1);
+        graphics.text(this.font, Component.translatable("bedrock_dressing_room.viafabricplus.pack_skin_number",
+            this.selected + 1, this.pack.skins().size()), left + 157, top + 38, ACCENT_COLOR);
+        graphics.text(this.font, Component.translatable(skin.slim()
+            ? "bedrock_dressing_room.viafabricplus.slim" : "bedrock_dressing_room.viafabricplus.wide"),
+            left + 157, top + 55, ACCENT_COLOR);
+        if (this.error != null) {
+            graphics.textWithWordWrap(this.font, this.error, left, top + 110, 300, ACCENT_COLOR);
+        }
+    }
+
+    @Override
+    public void removed() {
+        this.releasePreview();
+        super.removed();
+    }
+
+    private void changeSkin(final int offset) {
+        this.selected = Math.floorMod(this.selected + offset, this.pack.skins().size());
+        this.showSkin();
+    }
+
+    private void showSkin() {
+        this.releasePreview();
+        this.selectedImage = null;
+        this.previewSkin = null;
+        this.error = null;
+        try {
+            final Skin skin = this.pack.skins().get(this.selected);
+            this.selectedImage = this.pack.image(skin);
+            final var appearance = new BedrockAppearanceStore.Appearance(BedrockAppearanceStore.Selection.CUSTOM,
+                skin.slim(), this.selectedImage, null, "preview", "", skin.model());
+            this.preview = BedrockPlayerSkins.preview(appearance.skinData(""));
+            this.previewSkin = this.preview.skin();
+        } catch (IOException e) {
+            this.error = Component.literal(e.getMessage());
+        }
+    }
+
+    private void importSkin() {
+        if (this.selectedImage == null) {
+            return;
+        }
+        final Skin skin = this.pack.skins().get(this.selected);
+        this.minecraft.gui.setScreen(this.dressingRoom);
+        this.dressingRoom.importSkinPackSkin(this.selectedImage, skin);
+    }
+
+    private void releasePreview() {
+        if (this.preview != null) {
+            this.preview.close();
+            this.preview = null;
+        }
+    }
+
+}
