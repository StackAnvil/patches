+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+
+/** Selected custom geometry from a Classic Skin pack, normalized for persistence and transport. */
+public record BedrockClassicModel(String geometry, String identifier) {
+    public static BedrockClassicModel read(final String data, final String identifier)
+            throws IOException {
+        if (data.length() > 1024 * 1024 || !identifier.matches("geometry\\.[a-zA-Z0-9_.-]{1,128}"))
+            throw new IOException("The classic skin geometry is too large or has an invalid name");
+        try {
+            final JsonObject document = JsonParser.parseString(data).getAsJsonObject();
+            JsonObject selected = null;
+            if (document.has("minecraft:geometry")) {
+                for (final var element : document.getAsJsonArray("minecraft:geometry")) {
+                    final JsonObject model = element.getAsJsonObject();
+                    if (identifier.equals(
+                            model.getAsJsonObject("description").get("identifier").getAsString())) {
+                        if (selected != null)
+                            throw new IOException("The skin geometry name is ambiguous");
+                        selected = model.deepCopy();
+                    }
+                }
+            } else if (document.has(identifier)) {
+                selected = document.getAsJsonObject(identifier).deepCopy();
+                final JsonObject description = new JsonObject();
+                description.addProperty("identifier", identifier);
+                description.add("texture_width", selected.remove("texturewidth"));
+                description.add("texture_height", selected.remove("textureheight"));
+                selected.add("description", description);
+            }
+            if (selected == null)
+                throw new IOException("The pack is missing the selected skin geometry");
+            final JsonObject description = selected.getAsJsonObject("description");
+            for (final String dimension : new String[] {"texture_width", "texture_height"}) {
+                final int size = description.get(dimension).getAsInt();
+                if (size < 1 || size > 1024)
+                    throw new IOException("The skin geometry texture size is invalid");
+            }
+            validateNumbers(selected, 0);
+            final JsonArray bones = selected.getAsJsonArray("bones");
+            if (bones == null || bones.size() > 256)
+                throw new IOException("The skin geometry has too many bones");
+            final Map<String, String> parents = new HashMap<>();
+            int cubes = 0;
+            for (final var element : bones) {
+                final JsonObject bone = element.getAsJsonObject();
+                final String name = bone.get("name").getAsString();
+                if (name.isBlank()
+                        || parents.putIfAbsent(
+                                        name,
+                                        bone.has("parent") ? bone.get("parent").getAsString() : "")
+                                != null)
+                    throw new IOException("The skin geometry has a duplicate or empty bone name");
+                if (bone.has("cubes") && (cubes += bone.getAsJsonArray("cubes").size()) > 2048)
+                    throw new IOException("The skin geometry has too many cubes");
+            }
+            for (final String name : parents.keySet()) {
+                final var visited = new HashSet<String>();
+                String ancestor = name;
+                while (!ancestor.isEmpty()) {
+                    if (!visited.add(ancestor) || !parents.containsKey(ancestor))
+                        throw new IOException("The skin geometry has an invalid bone hierarchy");
+                    ancestor = parents.get(ancestor);
+                }
+            }
+            final JsonArray models = new JsonArray();
+            models.add(selected);
+            final JsonObject normalized = new JsonObject();
+            normalized.addProperty("format_version", "1.12.0");
+            normalized.add("minecraft:geometry", models);
+            final String geometry = normalized.toString();
+            if (BedrockGeometryModel.fromJson(geometry).size() != 1)
+                throw new IOException("The skin geometry could not be decoded");
+            return new BedrockClassicModel(geometry, identifier);
+        } catch (RuntimeException e) {
+            throw new IOException("The classic skin geometry is invalid", e);
+        }
+    }
+
+    private static void validateNumbers(final JsonElement element, final int depth)
+            throws IOException {
+        if (depth > 32) throw new IOException("The skin geometry is nested too deeply");
+        if (element.isJsonObject()) {
+            for (final var entry : element.getAsJsonObject().entrySet())
+                validateNumbers(entry.getValue(), depth + 1);
+        } else if (element.isJsonArray()) {
+            for (final var item : element.getAsJsonArray()) validateNumbers(item, depth + 1);
+        } else if (element.isJsonPrimitive() && element.getAsJsonPrimitive().isNumber()) {
+            final double value = element.getAsDouble();
+            if (!Double.isFinite(value) || Math.abs(value) > 32768)
+                throw new IOException("The skin geometry contains an invalid coordinate");
+        }
+    }
+
+    public String resourcePatch() {
+        final JsonObject bindings = new JsonObject(), patch = new JsonObject();
+        bindings.addProperty("default", this.identifier);
+        patch.add("geometry", bindings);
+        return patch.toString();
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockClassicSkinPack.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockClassicSkinPack.java
