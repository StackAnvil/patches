+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.awt.image.BufferedImage;
+
+/** Expands the mirrored limbs of a legacy skin into independent modern UV regions. */
+final class BedrockLegacySkin {
+    private BedrockLegacySkin() {}
+
+    static BufferedImage convert(final BufferedImage source) {
+        if (source.getWidth() != 64 || source.getHeight() != 32) return source;
+        final BufferedImage result = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        result.setRGB(0, 0, 64, 32, source.getRGB(0, 0, 64, 32, null, 0, 64), 0, 64);
+        mirrorLimb(source, result, 0, 16);
+        mirrorLimb(source, result, 40, 32);
+        // Legacy images often filled their unused hat region with an opaque background.
+        boolean opaqueHat = true;
+        for (int y = 0; y < 32 && opaqueHat; y++)
+            for (int x = 32; x < 64; x++)
+                if ((source.getRGB(x, y) >>> 24) < 128) {
+                    opaqueHat = false;
+                    break;
+                }
+        if (opaqueHat)
+            for (int y = 0; y < 16; y++)
+                for (int x = 32; x < 64; x++) result.setRGB(x, y, result.getRGB(x, y) & 0xFFFFFF);
+        return result;
+    }
+
+    private static void mirrorLimb(
+            final BufferedImage source,
+            final BufferedImage target,
+            final int sourceX,
+            final int targetX) {
+        // Top and bottom retain their positions. Mirroring swaps the two side faces.
+        copyFace(source, target, sourceX + 4, 16, targetX + 4, 48, 4);
+        copyFace(source, target, sourceX + 8, 16, targetX + 8, 48, 4);
+        copyFace(source, target, sourceX, 20, targetX + 8, 52, 12);
+        copyFace(source, target, sourceX + 4, 20, targetX + 4, 52, 12);
+        copyFace(source, target, sourceX + 8, 20, targetX, 52, 12);
+        copyFace(source, target, sourceX + 12, 20, targetX + 12, 52, 12);
+    }
+
+    private static void copyFace(
+            final BufferedImage source,
+            final BufferedImage target,
+            final int sourceX,
+            final int sourceY,
+            final int targetX,
+            final int targetY,
+            final int height) {
+        for (int y = 0; y < height; y++)
+            for (int x = 0; x < 4; x++)
+                target.setRGB(
+                        targetX + x, targetY + y, source.getRGB(sourceX + 3 - x, sourceY + y));
+    }
+}
