+    @TempDir
+    Path directory;
+
+    @Test
+    void keepsSelectionsAndCapesSeparateByAccount() throws IOException {
+        final BedrockAppearanceStore store = this.store();
+        final Path skin = this.image(64, 64);
+        final Path cape = this.image(64, 32);
+
+        final var imported = store.importSkin("123", skin);
+        assertEquals(Selection.CUSTOM, imported.selection());
+        assertEquals(Selection.STEVE, store.load("456").selection());
+
+        store.setSlim("123", true);
+        final var withCape = store.importCape("123", cape);
+        assertTrue(withCape.effectiveSlim());
+        assertEquals(64, withCape.cape().getWidth());
+
+        store.select("123", Selection.ALEX);
+        assertTrue(store.load("123").effectiveSlim());
+        assertNotEquals(withCape.skinId(), store.load("123").skinId());
+        store.select("123", Selection.CUSTOM);
+        assertTrue(store.load("123").effectiveSlim());
+        assertTrue(store.hasCustomSkin("123"));
+
+        assertEquals(Selection.CUSTOM, this.store().load("123").selection());
+        assertEquals(Selection.STEVE, this.store().load("456").selection());
+        assertNull(store.removeCape("123").cape());
+    }
+
+    @Test
+    void rejectsInvalidSkinWithoutChangingSelection() throws IOException {
+        final BedrockAppearanceStore store = this.store();
+        final Path invalid = this.image(64, 48);
+
+        assertThrows(IOException.class, () -> store.importSkin("123", invalid));
+        assertEquals(Selection.STEVE, store.load("123").selection());
+        assertFalse(store.hasCustomSkin("123"));
+    }
+
+    @Test
+    void keepsTheModelSelectedByAnImportedSkinPack() throws IOException {
+        final BedrockAppearanceStore store = this.store();
+        final BufferedImage skin = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+
+        store.importSkinImage("123", skin, true);
+
+        assertTrue(this.store().load("123").effectiveSlim());
+        assertThrows(IOException.class, () -> store.importSkinImage("123",
+            new BufferedImage(64, 48, BufferedImage.TYPE_INT_ARGB), false));
+        assertTrue(this.store().load("123").effectiveSlim());
+    }
+
+    @Test
+    void expandsLegacyLimbsAndPersistsTheConvertedSkin() throws IOException {
+        final BufferedImage source = new BufferedImage(64, 32, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 32; y++)
+            for (int x = 0; x < 64; x++) source.setRGB(x, y, 0xFF000000 | y << 8 | x);
+        source.setRGB(32, 0, 0); // Keep the authored hat rather than treating it as a background.
+        final var imported = this.store().importSkinImage("123", source, false);
+        assertEquals(64, imported.skin().getHeight());
+        assertEquals(source.getRGB(7, 16), imported.skin().getRGB(20, 48));
+        assertEquals(source.getRGB(3, 20), imported.skin().getRGB(24, 52));
+        assertEquals(source.getRGB(11, 31), imported.skin().getRGB(16, 63));
+        assertEquals(source.getRGB(43, 20), imported.skin().getRGB(40, 52));
+        assertEquals(source.getRGB(51, 31), imported.skin().getRGB(32, 63));
+        assertEquals(0, imported.skin().getRGB(0, 32));
+        assertEquals(0, imported.skin().getRGB(48, 48));
+        assertEquals(32, source.getHeight());
+        final var restored = this.store().load("123");
+        assertEquals(imported.skin().getRGB(40, 52), restored.skin().getRGB(40, 52));
+        assertEquals(64, restored.skin().getHeight());
+        final Path png = this.directory.resolve("legacy.png");
+        ImageIO.write(source, "png", png.toFile());
+        assertEquals(restored.skin().getRGB(40, 52), this.store().importSkin("456", png).skin().getRGB(40, 52));
+    }
+
+    private BedrockAppearanceStore store() {
+        return new BedrockAppearanceStore(this.directory.resolve("appearances"),
+            _ -> new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB));
+    }
+
+    private Path image(final int width, final int height) throws IOException {
+        final Path path = this.directory.resolve(width + "x" + height + ".png");
+        ImageIO.write(new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB), "png", path.toFile());
+        return path;
+    }
+
+}
