+@Mixin(KeyboardInput.class)
+public abstract class MixinKeyboardInput extends ClientInput {
+    @Inject(method = "tick", at = @At("TAIL"))
+    private void applyPermissions(final CallbackInfo ci) {
+        final var player = Minecraft.getInstance().player;
+        this.keyPresses = BedrockInputPermissions.filter(this.keyPresses, player != null && player.isPassenger());
+        this.moveVector = BedrockInputPermissions.movement(this.keyPresses);
+    }
+}
