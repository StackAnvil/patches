+@Mixin(MouseHandler.class)
+public abstract class MixinMouseHandler {
+    @Shadow @Final private SmoothDouble smoothTurnX;
+    @Shadow @Final private SmoothDouble smoothTurnY;
+    @Inject(method = "turnPlayer", at = @At("HEAD"), cancellable = true)
+    private void applyCameraPermission(final double deltaTime, final CallbackInfo ci) {
+        if (!BedrockInputPermissions.current().allows(PlayerInputPermissions.Control.CAMERA)) {
+            this.smoothTurnX.reset();
+            this.smoothTurnY.reset();
+            ci.cancel();
+        }
+    }
