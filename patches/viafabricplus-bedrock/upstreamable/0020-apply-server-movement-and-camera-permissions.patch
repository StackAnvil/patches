+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.raphimc.viabedrock.api.model.PlayerInput;
+
+/** Retain held input without sending redundant samples. A new connection starts with a fresh sample. */
+public final class RawInputTracker {
+    private PlayerInput previous;
+
+    public boolean changed(final PlayerInput sample) {
+        if (sample.equals(this.previous)) {
+            return false;
+        }
+        this.previous = sample;
+        return true;
+    }
+
+    public void clear() {
+        this.previous = null;
+    }
+}
