+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.entity.player.Input;
+import net.minecraft.world.phys.Vec2;
+import net.raphimc.viabedrock.api.model.PlayerInput;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+
+/** Connection-scoped permissions also work when ViaBedrock runs remotely in ViaProxy. */
+public final class BedrockInputPermissions {
+    private static PlayerInputPermissions permissions = PlayerInputPermissions.NONE;
+    private static boolean active;
+    private static final RawInputTracker RAW_INPUT = new RawInputTracker();
+
+    private BedrockInputPermissions() {}
+
+    public static PlayerInputPermissions current() {
+        return permissions;
+    }
+
+    public static void accept(final PlayerInputPermissions value) {
+        permissions = value;
+        active = true;
+    }
+
+    public static void clear() {
+        permissions = PlayerInputPermissions.NONE;
+        active = false;
+        RAW_INPUT.clear();
+    }
+
+    public static PlayerInput sample(final Input input) {
+        return new PlayerInput((input.forward() ? 1 : 0) | (input.backward() ? 2 : 0) | (input.left() ? 4 : 0)
+            | (input.right() ? 8 : 0) | (input.jump() ? 16 : 0) | (input.shift() ? 32 : 0) | (input.sprint() ? 64 : 0));
+    }
+
+    public static void capture(final Input input) {
+        if (!active || Minecraft.getInstance().getConnection() == null || !ClientPlayNetworking.canSend(RawInputPayload.TYPE)) {
+            return;
+        }
+        final PlayerInput sample = sample(input);
+        if (RAW_INPUT.changed(sample)) {
+            ClientPlayNetworking.send(new RawInputPayload(sample));
+        }
+    }
+
+    public static Input filter(final Input input, final boolean passenger) {
+        final int filtered = permissions.filterInput(sample(input).flags(), passenger);
+        return new Input((filtered & 1) != 0, (filtered & 2) != 0, (filtered & 4) != 0,
+            (filtered & 8) != 0, (filtered & 16) != 0, (filtered & 32) != 0, (filtered & 64) != 0);
+    }
+
+    public static Vec2 movement(final Input input) {
+        return new Vec2(impulse(input.left(), input.right()), impulse(input.forward(), input.backward())).normalized();
+    }
+
+    private static float impulse(final boolean positive, final boolean negative) {
+        return positive == negative ? 0F : positive ? 1F : -1F;
+    }
+}
