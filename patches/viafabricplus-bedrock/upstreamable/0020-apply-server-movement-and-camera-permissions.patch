+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+
+public record InputPermissionsPayload(PlayerInputPermissions permissions) implements CustomPacketPayload {
+    public static final Type<InputPermissionsPayload> TYPE = new Type<>(Identifier.parse(PlayerInputPermissions.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, InputPermissionsPayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> PlayerInputPermissions.TYPE.write(buffer, payload.permissions),
+        buffer -> new InputPermissionsPayload(PlayerInputPermissions.TYPE.read(buffer)));
+
+    @Override
+    public Type<InputPermissionsPayload> type() {
+        return TYPE;
+    }
+}
