@@ -0,0 +1,60 @@
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.world.entity.player.Input;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import static net.raphimc.viabedrock.api.model.PlayerInputPermissions.Control.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockInputPermissionsTest {
+    @AfterEach
+    void disconnect() {
+        BedrockInputPermissions.clear();
+    }
+
+    @Test
+    void rawStreamKeepsHeldControlsWhileFilteredPredictionStops() {
+        final var held = new Input(true, false, false, true, true, true, false);
+        BedrockInputPermissions.accept(new PlayerInputPermissions(MOVEMENT.mask()));
+        final var raw = BedrockInputPermissions.sample(held);
+        assertEquals(1 | 8 | 16 | 32, raw.flags());
+        assertEquals(net.raphimc.viabedrock.api.model.PlayerInput.NONE,
+            BedrockInputPermissions.sample(BedrockInputPermissions.filter(held, false)));
+        final var tracker = new RawInputTracker();
+        assertTrue(tracker.changed(raw));
+        assertFalse(tracker.changed(raw));
+        BedrockInputPermissions.accept(PlayerInputPermissions.NONE);
+        assertFalse(tracker.changed(raw));
+        tracker.clear();
+        assertTrue(tracker.changed(raw));
+        assertTrue(tracker.changed(net.raphimc.viabedrock.api.model.PlayerInput.NONE));
+    }
+
+    @Test
+    void opposingInputsResolveAfterDirectionalPermissionFiltering() {
+        final var all = new Input(true, true, true, true, true, true, true);
+        assertEquals(0F, BedrockInputPermissions.movement(all).length());
+        BedrockInputPermissions.accept(new PlayerInputPermissions(BACKWARD.mask() | RIGHT.mask()));
+        final var filtered = BedrockInputPermissions.filter(all, false);
+        assertTrue(filtered.jump());
+        assertTrue(filtered.shift());
+        assertTrue(filtered.sprint());
+        final var vector = BedrockInputPermissions.movement(filtered);
+        assertEquals(1F, vector.length(), 0.00001F);
+        assertEquals(vector.x, vector.y);
+        assertTrue(vector.x > 0F);
+    }
+
+    @Test
+    void resetRestoresHeldControlsAndDoesNotLeakIntoNextConnection() {
+        final var held = new Input(true, false, true, false, true, true, false);
+        BedrockInputPermissions.accept(new PlayerInputPermissions(MOVEMENT.mask() | CAMERA.mask()));
+        assertEquals(0F, BedrockInputPermissions.movement(BedrockInputPermissions.filter(held, false)).length());
+        assertFalse(BedrockInputPermissions.current().allows(CAMERA));
+        BedrockInputPermissions.clear();
+        assertEquals(held, BedrockInputPermissions.filter(held, false));
+        assertTrue(BedrockInputPermissions.current().allows(CAMERA));
+    }
+}
