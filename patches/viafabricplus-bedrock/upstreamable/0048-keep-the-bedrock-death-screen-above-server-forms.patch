+    @Test
+    void formsWaitBehindTheDeathScreenUntilThePlayerIsAliveAndInGame() {
+        final var fixture = new Fixture();
+        final var opened = new AtomicInteger();
+        final var screen = fixture.screen("Reason");
+        assertTrue(fixture.updates.deferForm(fixture.player, opened::incrementAndGet));
+        fixture.tick(0, screen);
+        assertEquals(0, opened.get(), "The death route outranks forms");
+
+        final var respawned = mock(LocalPlayer.class);
+        fixture.updates.tick(fixture.owner, respawned, mock(LevelLoadingScreen.class));
+        assertEquals(0, opened.get(), "Java's terrain screen is still loading");
+        fixture.updates.tick(fixture.owner, respawned, null);
+        fixture.updates.tick(fixture.owner, respawned, null);
+        assertEquals(1, opened.get());
+        assertFalse(fixture.updates.deferForm(respawned, opened::incrementAndGet), "Alive players see forms at once");
+    }
+
+    @Test
+    void closeFormRequestDropsAFormHeldBehindTheDeathScreen() {
+        final var fixture = new Fixture();
+        final var opened = new AtomicInteger();
+        fixture.updates.deferForm(fixture.player, opened::incrementAndGet);
+        fixture.updates.clearForm();
+        fixture.dead.set(false);
+        fixture.updates.tick(fixture.owner, fixture.player, null);
+        assertEquals(0, opened.get());
+    }
+
     private static String key(final Component component) {
         return ((TranslatableContents) component.getContents()).getKey();
