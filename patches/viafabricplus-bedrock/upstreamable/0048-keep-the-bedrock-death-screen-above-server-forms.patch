     public BedrockDeathScreenUpdates() { this(Util::getMillis); }
     BedrockDeathScreenUpdates(final LongSupplier clock) { this.clock = clock; }
@@ -97,6 +99,11 @@ public final class BedrockDeathScreenUpdates {
 
     public void tick(final ClientPacketListener current, final LocalPlayer player, final Screen foreground) {
         this.tick(current, player);
+        if (this.form != null && player != null && !player.isDeadOrDying() && !(foreground instanceof LevelLoadingScreen)) {
+            final Runnable open = this.form;
+            this.form = null;
+            open.run();
+        }
         if (!this.respawning) return;
         // Leaving the active native route disposes its timer, including while a modal is visible.
         if (foreground != this.screen) {
@@ -156,6 +163,21 @@ public final class BedrockDeathScreenUpdates {
         return this.respawning && this.owner == current && this.player == player && this.screen == screen;
     }
 
+    /**
+     * Native routes a dead player to the death screen before any data-driven form. Hold a form that arrives
+     * meanwhile and open it once the player is alive. A newer request replaces the held one.
+     */
+    public boolean deferForm(final LocalPlayer player, final Runnable open) {
+        if (player == null || !player.isDeadOrDying()) return false;
+        this.form = open;
+        return true;
+    }
+
+    /** The server's close-form request also closes a form held behind the death screen. */
+    public void clearForm() {
+        this.form = null;
+    }
+
     public interface Owner {
         BedrockDeathScreenUpdates bedrockDeathScreens();
     }
