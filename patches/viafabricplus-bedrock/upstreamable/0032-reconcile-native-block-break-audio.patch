+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.protocol.data.enums.java.LevelEvent;
+
+/** Local destruction retains particles; reconciled native server events own its sound. */
+public final class BedrockMiningAudio {
+    private BedrockMiningAudio() {}
+
+    public static int localEvent(final int event, final boolean bedrock, final boolean localActor) {
+        return bedrock && localActor && event == LevelEvent.PARTICLES_DESTROY_BLOCK.getValue()
+                ? LevelEvent.PARTICLES_DESTROY_BLOCK_NO_SOUND.getValue() : event;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/sound/MixinBedrockMiningAudio.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/sound/MixinBedrockMiningAudio.java
new file mode 100644
