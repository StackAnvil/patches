+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.sound;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMiningAudio;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.ModifyVariable;
+
+@Mixin(ClientLevel.class)
+public abstract class MixinBedrockMiningAudio {
+    @ModifyVariable(method = "levelEvent(Lnet/minecraft/world/entity/Entity;ILnet/minecraft/core/BlockPos;I)V",
+            at = @At("HEAD"), argsOnly = true, ordinal = 0)
+    private int reconcileLocalDestruction(final int event, final Entity source, final int originalEvent,
+                                         final BlockPos position, final int data) {
+        return BedrockMiningAudio.localEvent(event, BedrockInputPermissions.isBedrockConnection(), source instanceof LocalPlayer);
+    }
+}
