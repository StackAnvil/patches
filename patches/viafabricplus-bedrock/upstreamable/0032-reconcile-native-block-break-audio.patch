--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMiningAudioTest.java
@@ -0,0 +1,16 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.protocol.data.enums.java.LevelEvent;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class BedrockMiningAudioTest {
+    @Test
+    void onlyLocalNativeDestructionLeavesSoundToTheServer() {
+        final int destruction = LevelEvent.PARTICLES_DESTROY_BLOCK.getValue();
+        assertEquals(LevelEvent.PARTICLES_DESTROY_BLOCK_NO_SOUND.getValue(), BedrockMiningAudio.localEvent(destruction, true, true));
+        assertEquals(destruction, BedrockMiningAudio.localEvent(destruction, false, true));
+        assertEquals(destruction, BedrockMiningAudio.localEvent(destruction, true, false));
+        assertEquals(LevelEvent.SOUND_ANVIL_USED.getValue(), BedrockMiningAudio.localEvent(LevelEvent.SOUND_ANVIL_USED.getValue(), true, true));
+    }
+}
