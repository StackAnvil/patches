+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.viaversion.viaversion.api.protocol.packet.PacketWrapper;
+import com.viaversion.viaversion.api.type.Types;
+import com.viaversion.viaversion.api.type.types.FixedByteArrayType;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import org.cloudburstmc.netty.channel.raknet.RakConstants;
+
+final class BedrockRakNetPong {
+
+    private static final FixedByteArrayType MAGIC_TYPE = new FixedByteArrayType(RakConstants.DEFAULT_UNCONNECTED_MAGIC.length);
+
+    private BedrockRakNetPong() {
+    }
+
+    static String[] read(final PacketWrapper wrapper) {
+        wrapper.read(Types.LONG); // Time echoed by the server.
+        wrapper.read(Types.LONG); // Server GUID.
+        if (!Arrays.equals(wrapper.read(MAGIC_TYPE), RakConstants.DEFAULT_UNCONNECTED_MAGIC)) {
+            throw new IllegalStateException("Invalid offline message data id");
+        }
+        final int length = wrapper.read(Types.UNSIGNED_SHORT);
+        final byte[] message = wrapper.read(new FixedByteArrayType(length));
+        return new String(message, StandardCharsets.UTF_8).split(";", -1);
+    }
+}
