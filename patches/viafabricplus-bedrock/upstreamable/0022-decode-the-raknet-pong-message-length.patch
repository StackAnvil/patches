+package com.viaversion.viafabricplus.bedrock.protocoltranslator.network;
+
+import com.viaversion.viaversion.api.connection.ProtocolInfo;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.protocol.version.ProtocolVersion;
+import com.viaversion.viaversion.exception.InformativeException;
+import com.viaversion.viaversion.protocol.packet.PacketWrapperImpl;
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import org.cloudburstmc.netty.channel.raknet.RakConstants;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class BedrockRakNetPongTest {
+
+    @Test
+    void binaryLengthCannotShiftMotdOrPlayerCounts() throws Exception {
+        for (final int length : new int[]{0x013B, 0x3B01}) {
+            final String suffix = ";2193;1.26.51;4;20;1;World;Survival;1;19132;19133;";
+            final String motd = "x".repeat(length - "MCPE;".length() - suffix.length());
+            final byte[] message = ("MCPE;" + motd + suffix).getBytes(StandardCharsets.UTF_8);
+            final ByteBuf input = pong(message.length, message);
+            try {
+                final String[] fields = BedrockRakNetPong.read(new PacketWrapperImpl(28, input, null));
+                assertEquals(motd, fields[1]);
+                assertEquals(4, Integer.parseInt(fields[4]));
+                assertEquals(20, Integer.parseInt(fields[5]));
+                assertEquals(13, fields.length);
+                assertEquals(0, fields[12].length());
+                assertEquals(0, input.readableBytes());
+            } finally {
+                input.release();
+            }
+        }
+    }
+
+    @Test
+    void rejectsTruncatedStatusPayload() throws Exception {
+        final ProtocolInfo info = (ProtocolInfo) Proxy.newProxyInstance(ProtocolInfo.class.getClassLoader(),
+            new Class<?>[]{ProtocolInfo.class}, (proxy, method, args) -> ProtocolVersion.v1_21_4);
+        final UserConnection user = (UserConnection) Proxy.newProxyInstance(UserConnection.class.getClassLoader(),
+            new Class<?>[]{UserConnection.class}, (proxy, method, args) -> info);
+        final ByteBuf input = pong(50, new byte[4]);
+        try {
+            assertThrows(InformativeException.class,
+                () -> BedrockRakNetPong.read(new PacketWrapperImpl(28, input, user)));
+            assertEquals(34, input.readerIndex());
+            assertEquals(4, input.readableBytes());
+        } finally {
+            input.release();
+        }
+    }
+
+    private static ByteBuf pong(final int length, final byte[] message) {
+        return Unpooled.buffer().writeLong(0).writeLong(1)
+            .writeBytes(RakConstants.DEFAULT_UNCONNECTED_MAGIC).writeShort(length).writeBytes(message);
+    }
+}
