+    @Test
+    void followsTheThreeCurrentNativeStateVectorStepsAcrossALargeMove() {
+        final var interpolation = new RemotePlayerInterpolation();
+        interpolation.receive(movement(0, new Position3f(1.5F, 73.24002F, 5.5F), 0, 3));
+        Position3f position = new Position3f(0, 0, 5.5F);
+        final Position3f[] expected = {
+                new Position3f(.5F, 24.413341522216797F, 5.5F),
+                new Position3f(1F, 48.826683044433594F, 5.5F),
+                new Position3f(1.5F, 73.24002075195312F, 5.5F)
+        };
+        for (final var nativePosition : expected) {
+            final var step = interpolation.tick(position, 0, 0, 0, 0, 0);
+            assertEquals(nativePosition, step.position());
+            assertTrue(step.clearMotion());
+            position = step.position();
+        }
+        assertFalse(interpolation.active());
+        assertFalse(interpolation.tick(position, 0, 0, 0, 0, 0).clearMotion());
+    }
