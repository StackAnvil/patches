@@ -0,0 +1,74 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class NativeRemoteInterpolationReferenceTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_REMOTE_INTERPOLATION_REFERENCE", matches = ".+")
+    void matchesCurrentNativePositionMainRotationAndHeadCounterInstructions() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_REMOTE_INTERPOLATION_REFERENCE"),
+                "native-current-interpolation-tick-controls.json"))).getAsJsonObject();
+        assertEquals("Bedrock1.26.60.5/protocol2225", reference.get("target").getAsString());
+        assertEquals("988f6a61403b4381aa41e6c66d64cce441b14e561a9b10f647c2758ef3f2672a", reference.get("sha256").getAsString());
+        int cases = 0;
+        for (final var element : reference.getAsJsonArray("rows")) {
+            final var row = element.getAsJsonObject();
+            // Remote players retain a head component. Missing-component factories have a separate admission boundary.
+            if (!row.get("headPresent").getAsBoolean()) continue;
+            final var interpolation = new RemotePlayerInterpolation();
+            set(interpolation, "target", position(row.getAsJsonArray("target")));
+            set(interpolation, "rotation", new Position3f(190.25F, -190.5F, 175.25F));
+            set(interpolation, "headTarget", 175.25F);
+            set(interpolation, "positionSteps", row.get("positionSteps").getAsInt());
+            set(interpolation, "rotationSteps", row.get("rotationSteps").getAsInt());
+            set(interpolation, "headSteps", row.get("headSteps").getAsInt());
+            final var input = position(row.getAsJsonArray("inputPosition"));
+            final var step = interpolation.tick(input, -179.75F, 179.5F, 90.25F, -90.5F, 179.75F);
+            final var expectedPosition = row.get("positionRequest");
+            assertEquals(expectedPosition.isJsonNull() ? input : position(expectedPosition.getAsJsonArray()), step.position());
+            final var rotation = row.getAsJsonArray("rotation");
+            assertEquals(rotation.get(0).getAsFloat(), step.pitch());
+            assertEquals(rotation.get(1).getAsFloat(), step.yaw());
+            assertEquals(rotation.get(2).getAsFloat(), step.previousPitch());
+            assertEquals(rotation.get(3).getAsFloat(), step.previousYaw());
+            assertEquals(row.getAsJsonArray("head").get(0).getAsFloat(), step.headYaw());
+            assertEquals(row.getAsJsonArray("motion").get(0).getAsFloat() == 0F, step.clearMotion());
+            final var counters = row.getAsJsonArray("postCounters");
+            assertEquals(counters.get(0).getAsInt(), get(interpolation, "positionSteps"));
+            assertEquals(counters.get(1).getAsInt(), get(interpolation, "rotationSteps"));
+            assertEquals(counters.get(2).getAsInt(), get(interpolation, "headSteps"));
+            cases++;
+        }
+        assertEquals(256, cases);
+    }
+
+    private static Position3f position(final JsonArray value) {
+        return new Position3f(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+
+    private static void set(final RemotePlayerInterpolation interpolation, final String name, final Object value) throws Exception {
+        final var field = RemotePlayerInterpolation.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(interpolation, value);
+    }
+
+    private static int get(final RemotePlayerInterpolation interpolation, final String name) throws Exception {
+        final var field = RemotePlayerInterpolation.class.getDeclaredField(name);
+        field.setAccessible(true);
+        return field.getInt(interpolation);
+    }
+}
