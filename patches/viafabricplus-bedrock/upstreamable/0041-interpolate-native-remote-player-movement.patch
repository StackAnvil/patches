@@ -0,0 +1,239 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.movement.RemotePlayerRotationAccess;
+import com.viaversion.viafabricplus.bedrock.movement.replay.PhysicalReplayContext;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerPitch;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.RemotePlayer;
+import net.minecraft.core.PositionAndRotation;
+import net.minecraft.world.entity.InterpolationHandler;
+import net.minecraft.world.entity.InterpolationTracker;
+import net.minecraft.world.entity.PositionPath;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.RemotePlayerMovement;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.UUID;
+
+/** Decorates the real host handler so ordinary Java and unsupported modes retain their existing path. */
+public final class RemotePlayerInterpolationHandler implements InterpolationHandler, BedrockPlayerPitch {
+    private final RemotePlayer player;
+    private final InterpolationHandler host;
+    private final RemotePlayerInterpolation nativeInterpolation = new RemotePlayerInterpolation();
+    private ClientPacketListener connection;
+    private ClientLevel level;
+    private UUID lifetime;
+    private float originOffset;
+    private Position3f eye;
+    private Position3f previousEye;
+    private Vec3 appliedPosition;
+    private Vec3 appliedPreviousPosition;
+    private float previousPitch;
+    private boolean hasPitchHistory;
+
+    public RemotePlayerInterpolationHandler(final RemotePlayer player, final InterpolationHandler host) {
+        this.player = player;
+        this.host = host;
+    }
+
+    public boolean receive(final RemotePlayerMovement movement) {
+        if (movement == null || movement.riding() || this.player.isPassenger()
+                || this.player.isLocalInstanceAuthoritative() || !BedrockInputPermissions.isBedrockConnection()
+                || !movement.uuid().equals(this.player.getUUID()) || movement.entityId() != this.player.getId()
+                || !movement.lifetime().equals(BedrockActorState.liveLifetime(this.player.getUUID()))) {
+            this.releaseNative();
+            return false;
+        }
+        final Minecraft client = Minecraft.getInstance();
+        if (client.level == null || client.getConnection() == null || !client.getConnection().getConnection().isConnected() || this.player.level() != client.level
+                || client.level.getEntity(this.player.getId()) != this.player
+                || ((movement.mode() == 0 || movement.mode() == RemotePlayerMovement.ACTOR) && !client.level.isTickingEntity(this.player))
+                || client.player == null || this.player.hasIndirectPassenger(client.player) || this.player.isRemoved()) {
+            this.releaseNative();
+            return false;
+        }
+        final boolean continuing = this.validContext() && movement.lifetime().equals(this.lifetime);
+        if (!continuing) {
+            this.nativeInterpolation.clear();
+            this.hasPitchHistory = false;
+        }
+        this.host.cancel();
+        this.connection = client.getConnection();
+        this.level = client.level;
+        this.lifetime = movement.lifetime();
+        this.originOffset = movement.originOffset();
+        if (!continuing || !this.player.position().equals(this.appliedPosition)) this.captureEye();
+        final Vec3 oldPosition = this.player.oldPosition();
+        if (!continuing || !oldPosition.equals(this.appliedPreviousPosition)) {
+            this.previousEye = oldPosition.equals(this.appliedPosition) ? this.eye : this.eyePosition(oldPosition);
+            this.appliedPreviousPosition = oldPosition;
+        }
+        if (movement.mode() != RemotePlayerMovement.ACTOR) {
+            // Native packet dispatch computes motion before the mode-specific helper, even for head-only input.
+            this.player.setDeltaMovement(new Vec3(movement.position().x() - this.previousEye.x(),
+                    movement.position().y() - this.previousEye.y(), movement.position().z() - this.previousEye.z()));
+        }
+        this.nativeInterpolation.receive(movement);
+        // Every legacy head packet for these sources precedes its paired position packet.
+        this.player.lerpHeadTo(this.player.getYHeadRot(), 0);
+        if (movement.mode() == 1 || movement.mode() == 2 || movement.mode() == 3) {
+            this.applyRotation(movement.rotation().x(), movement.mode() == 3 ? this.player.getYRot() : movement.rotation().y());
+        }
+        if (movement.mode() == 1 || movement.mode() == 2) {
+            final Position3f source = movement.position();
+            // Teleport passes through native feet and eye conversions; respawn publishes the raw eye position.
+            this.eye = movement.mode() == 2 ? new Position3f(source.x() + 0F,
+                    (source.y() - this.originOffset) + this.originOffset, source.z() + 0F) : source;
+            this.player.setPos(this.eye.x(), (double) this.eye.y() - this.originOffset, this.eye.z());
+            this.appliedPosition = this.player.position();
+            this.player.setDeltaMovement(Vec3.ZERO);
+            if (movement.mode() == 1) {
+                ((RemotePlayerRotationAccess) this.player).bedrockRemotePitch(0F);
+            } else {
+                this.player.setOldPosAndRot(this.appliedPosition, this.player.yRotO, this.player.xRotO);
+                this.previousEye = this.eye;
+                this.appliedPreviousPosition = this.player.oldPosition();
+            }
+        }
+        this.player.onInterpolationStart(this);
+        return true;
+    }
+
+    private void applyRotation(final float rawPitch, final float rawYaw) {
+        final float previousPitch = this.previousPitch();
+        final float pitch = RemotePlayerInterpolation.wrap(rawPitch);
+        final float yaw = RemotePlayerInterpolation.wrap(rawYaw);
+        ((RemotePlayerRotationAccess) this.player).bedrockRemotePitch(pitch);
+        this.player.setYRot(yaw);
+        this.player.xRotO = RemotePlayerInterpolation.wrap((pitch - rawPitch) + previousPitch);
+        this.player.yRotO = RemotePlayerInterpolation.wrap((yaw - rawYaw) + this.player.yRotO);
+        this.capturePitchHistory();
+    }
+
+    private boolean validContext() {
+        final Minecraft client = Minecraft.getInstance();
+        return this.lifetime != null && BedrockInputPermissions.isBedrockConnection()
+                && client.getConnection() == this.connection && client.level == this.level
+                && this.connection.getConnection().isConnected()
+                && this.player.level() == this.level && !this.player.isRemoved() && !this.player.isPassenger()
+                && !this.player.isLocalInstanceAuthoritative() && this.level.getEntity(this.player.getId()) == this.player
+                && this.lifetime.equals(BedrockActorState.liveLifetime(this.player.getUUID()));
+    }
+
+    private void captureEye() {
+        this.eye = this.eyePosition(this.player.position());
+        this.appliedPosition = this.player.position();
+    }
+
+    private Position3f eyePosition(final Vec3 feet) {
+        return new Position3f((float) feet.x, (float) feet.y + this.originOffset, (float) feet.z);
+    }
+
+    public Position3f bodyDisplacement() {
+        if (PhysicalReplayContext.replaying() || !this.validContext()) return null;
+        if (!this.player.position().equals(this.appliedPosition)) this.captureEye();
+        return new Position3f(this.eye.x() - this.previousEye.x(), this.eye.y() - this.previousEye.y(), this.eye.z() - this.previousEye.z());
+    }
+
+    @Override
+    public float previousPitch() {
+        return this.hasPitchHistory && this.validContext() ? this.previousPitch : this.player.xRotO;
+    }
+
+    private void capturePitchHistory() {
+        this.previousPitch = this.player.xRotO;
+        this.hasPitchHistory = true;
+    }
+
+    public void finishBodyTick() {
+        if (PhysicalReplayContext.replaying() || !this.validContext()) return;
+        if (!this.player.position().equals(this.appliedPosition)) this.captureEye();
+        // LivingEntity later shifts xRotO by 360 for its linear renderer; native queries retain this value.
+        this.capturePitchHistory();
+        // Native body control reads displacement before the end-of-tick StateVector copy.
+        this.previousEye = this.eye;
+        this.appliedPreviousPosition = this.player.oldPosition();
+    }
+
+    @Override
+    public void interpolate() {
+        if (PhysicalReplayContext.replaying()) return;
+        if (this.lifetime == null) {
+            this.host.interpolate();
+            return;
+        }
+        if (!this.validContext()) {
+            this.cancel();
+            return;
+        }
+        if (!this.player.position().equals(this.appliedPosition)) this.captureEye();
+        if (!this.nativeInterpolation.active()) return;
+        final var next = this.nativeInterpolation.tick(this.eye, this.player.getXRot(), this.player.getYRot(), this.player.xRotO, this.player.yRotO, this.player.getYHeadRot());
+        if (next.clearMotion()) this.player.setDeltaMovement(Vec3.ZERO);
+        if (!next.position().equals(this.eye)) {
+            this.eye = next.position();
+            this.player.setPos(this.eye.x(), (double) this.eye.y() - this.originOffset, this.eye.z());
+        }
+        this.appliedPosition = this.player.position();
+        ((RemotePlayerRotationAccess) this.player).bedrockRemotePitch(next.pitch());
+        this.player.setYRot(next.yaw());
+        this.player.xRotO = next.previousPitch();
+        this.player.yRotO = next.previousYaw();
+        this.player.setYHeadRot(next.headYaw());
+        this.capturePitchHistory();
+    }
+
+    @Override
+    public PositionAndRotation target() {
+        if (this.lifetime == null || this.nativeInterpolation.target() == null) return this.host.target();
+        final var position = this.nativeInterpolation.target();
+        final var rotation = this.nativeInterpolation.rotation();
+        return PositionAndRotation.of(new Vec3(position.x(), (double) position.y() - this.originOffset, position.z()), rotation.y(), rotation.x());
+    }
+
+    @Override
+    public boolean interpolateTo(final PositionPath path, final float yaw, final float pitch, final boolean hasRotation) {
+        this.releaseNative();
+        return this.host.interpolateTo(path, yaw, pitch, hasRotation);
+    }
+
+    @Override
+    public InterpolationTracker interpolationTracker() { return this.host.interpolationTracker(); }
+
+    @Override
+    public void applyPredictedMovement(final Vec3 movement) {
+        if (this.lifetime == null) this.host.applyPredictedMovement(movement);
+    }
+
+    @Override
+    public boolean hasActiveInterpolation() {
+        return this.lifetime == null ? this.host.hasActiveInterpolation() : this.nativeInterpolation.active();
+    }
+
+    @Override
+    public void cancel() {
+        this.releaseNative();
+        this.host.cancel();
+    }
+
+    private void releaseNative() {
+        this.nativeInterpolation.clear();
+        this.lifetime = null;
+        this.hasPitchHistory = false;
+        this.connection = null;
+        this.level = null;
+        this.eye = null;
+        this.previousEye = null;
+        this.appliedPosition = null;
+        this.appliedPreviousPosition = null;
+    }
+}
