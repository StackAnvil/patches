+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class RemotePlayerInterpolationHandlerTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void appliesNativeFloatStepsWithoutTheHostDistanceCutoffOrPreviousPositionReset() {
+        try (final var f = new Fixture()) {
+            assertTrue(f.handler.receive(f.movement(0, false)));
+            f.handler.interpolate();
+            assertEquals(.5D, f.position.get().x);
+            assertEquals((double) 24.413341522216797F - 1.62001F, f.position.get().y);
+            f.handler.interpolate();
+            assertEquals(1D, f.position.get().x);
+            f.handler.interpolate();
+            assertEquals(1.5D, f.position.get().x);
+            assertEquals((double) 73.24002F - 1.62001F, f.position.get().y);
+            assertFalse(f.handler.hasActiveInterpolation());
+            verify(f.player, times(3)).setDeltaMovement(Vec3.ZERO);
+            verify(f.player, never()).snapTo(any(Vec3.class), anyFloat(), anyFloat());
+            verify(f.host, never()).interpolate();
+        }
+    }
+
+    @Test
+    void leavesOrdinaryJavaInterpolationHistoryIntactAcrossUnpairedPackets() {
+        try (final var f = new Fixture()) {
+            final var first = PositionPath.of(new Vec3(1, 2, 3));
+            final var second = PositionPath.of(new Vec3(4, 5, 6));
+            when(f.host.interpolateTo(any(), anyFloat(), anyFloat(), anyBoolean())).thenReturn(true);
+            assertFalse(f.handler.receive(null));
+            assertTrue(f.handler.interpolateTo(first, 1, 2, true));
+            assertFalse(f.handler.receive(null));
+            assertTrue(f.handler.interpolateTo(second, 3, 4, true));
+            f.handler.interpolate();
+            verify(f.host, never()).cancel();
+            verify(f.host).interpolateTo(first, 1, 2, true);
+            verify(f.host).interpolateTo(second, 3, 4, true);
+            verify(f.host).interpolate();
+        }
+    }
+
+    @Test
+    void headOnlyReceiptAppliesRawPitchAndKeepsTheActiveMovement() {
+        try (final var f = new Fixture()) {
+            assertTrue(f.handler.receive(f.movement(0, false)));
+            f.handler.interpolate();
+            assertEquals(.5D, f.position.get().x);
