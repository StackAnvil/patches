+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.movement;
+
+import com.llamalad7.mixinextras.injector.wrapmethod.WrapMethod;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockRemotePlayerMovement;
+import com.viaversion.viafabricplus.bedrock.movement.RemotePlayerInterpolationHandler;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.RemotePlayer;
+import net.minecraft.network.protocol.PacketUtils;
+import net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket;
+import net.minecraft.network.protocol.game.ClientboundMoveEntityPacket;
+import org.spongepowered.asm.mixin.Mixin;
+
+@Mixin(ClientPacketListener.class)
+public abstract class MixinRemotePlayerMovementPacketListener {
+    @WrapMethod(method = "handleEntityPositionSync")
+    private void applyNativeRemoteMovement(final ClientboundEntityPositionSyncPacket packet, final Operation<Void> original) {
+        final Minecraft client = Minecraft.getInstance();
+        PacketUtils.ensureRunningOnSameThread(packet, (ClientPacketListener) (Object) this, client.packetProcessor());
+        if (client.getConnection() == (Object) this && client.level != null) {
+            final var actor = client.level.getEntity(packet.id());
+            final var movement = BedrockRemotePlayerMovement.consume(packet, actor);
+            if (actor instanceof RemotePlayer && actor.getInterpolation() instanceof RemotePlayerInterpolationHandler interpolation
+                    && interpolation.receive(movement)) {
+                actor.getPositionCodec().setBase(packet.position().endPosition());
+                actor.setOnGround(packet.onGround());
+                return;
+            }
+        }
+        original.call(packet);
+    }
+
+    @WrapMethod(method = "handleMoveEntity")
+    private void applyNativeRemoteHead(final ClientboundMoveEntityPacket packet, final Operation<Void> original) {
+        final Minecraft client = Minecraft.getInstance();
+        PacketUtils.ensureRunningOnSameThread(packet, (ClientPacketListener) (Object) this, client.packetProcessor());
+        if (client.getConnection() == (Object) this && client.level != null && !packet.hasPosition() && packet.hasRotation()) {
+            final var actor = packet.getEntity(client.level);
+            final var movement = BedrockRemotePlayerMovement.consume(packet, actor);
+            if (actor instanceof RemotePlayer && actor.getInterpolation() instanceof RemotePlayerInterpolationHandler interpolation
+                    && interpolation.receive(movement)) {
+                actor.setOnGround(packet.isOnGround());
+                return;
+            }
+        }
+        original.call(packet);
+    }
+}
