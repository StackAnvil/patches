diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/movement/NativeRemoteInterpolationReferenceTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/movement/NativeRemoteInterpolationReferenceTest.java
