+package com.viaversion.viafabricplus.bedrock.movement;
+
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.injection.mixin.features.movement.RemotePlayerRotationAccess;
+import com.viaversion.viafabricplus.bedrock.movement.replay.PhysicalReplayContext;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerBodyRotation;
+import net.minecraft.SharedConstants;
