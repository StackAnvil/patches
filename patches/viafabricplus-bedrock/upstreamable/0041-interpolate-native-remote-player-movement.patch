+package com.viaversion.viafabricplus.bedrock.input;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket;
+import net.minecraft.network.protocol.game.ClientboundMoveEntityPacket;
+import net.minecraft.world.entity.Entity;
+import net.raphimc.viabedrock.api.model.RemotePlayerMovement;
+import net.raphimc.viabedrock.api.model.RemotePlayerMovementTracker;
+
+public final class BedrockRemotePlayerMovement {
+    private static final RemotePlayerMovementTracker TRACKER = new RemotePlayerMovementTracker();
+    private static ClientPacketListener connection;
+    private static ClientLevel level;
+
+    private BedrockRemotePlayerMovement() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(RemotePlayerMovementPayload.TYPE, RemotePlayerMovementPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            TRACKER.clear();
+            connection = listener;
+            level = null;
+            ClientPlayNetworking.registerReceiver(RemotePlayerMovementPayload.TYPE, (payload, context) -> {
+                if (connection == listener && context.client().getConnection() == listener && BedrockInputPermissions.isBedrockConnection()) {
+                    bindWorld(context.client());
+                    if (level != null) TRACKER.accept(payload.movement());
+                }
+            });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> {
+            if (connection == listener) {
+                TRACKER.clear();
+                connection = null;
+                level = null;
+            }
+        });
+    }
+
+    private static void bindWorld(final Minecraft client) {
+        if (level != client.level) {
+            TRACKER.clear();
+            level = client.level;
+        }
+    }
+
+    public static RemotePlayerMovement consume(final ClientboundEntityPositionSyncPacket packet, final Entity actor) {
+        final Minecraft client = Minecraft.getInstance();
+        if (!BedrockInputPermissions.isBedrockConnection() || client.getConnection() != connection) {
+            TRACKER.clear();
+            return null;
+        }
+        bindWorld(client);
+        final var end = packet.position().endPosition();
+        return TRACKER.consume(packet.id(), new RemotePlayerMovement.JavaTarget(true, end.x, end.y, end.z,
+                        packet.yRot(), packet.xRot(), packet.onGround()),
+                actor == null ? null : actor.getUUID(), actor == null ? null : BedrockActorState.liveLifetime(actor.getUUID()));
+    }
+
+    public static RemotePlayerMovement consume(final ClientboundMoveEntityPacket packet, final Entity actor) {
+        final Minecraft client = Minecraft.getInstance();
+        if (!BedrockInputPermissions.isBedrockConnection() || client.getConnection() != connection) {
+            TRACKER.clear();
+            return null;
+        }
+        bindWorld(client);
+        return TRACKER.consume(actor == null ? -1 : actor.getId(), new RemotePlayerMovement.JavaTarget(false, 0, 0, 0,
+                        packet.getYRot(), packet.getXRot(), packet.isOnGround()),
+                actor == null ? null : actor.getUUID(), actor == null ? null : BedrockActorState.liveLifetime(actor.getUUID()));
+    }
+}
