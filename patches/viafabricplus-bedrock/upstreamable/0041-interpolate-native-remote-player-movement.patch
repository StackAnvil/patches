+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/movement/RemotePlayerInterpolation.java
@@ -0,0 +1,142 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.raphimc.viabedrock.api.model.RemotePlayerMovement;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Native float position, main-rotation, and head components with independent counters. */
+public final class RemotePlayerInterpolation {
+    private Position3f target;
+    private Position3f rotation;
+    private int positionSteps;
+    private int rotationSteps;
+    private int headSteps;
+    private float headTarget;
+    private boolean mustComplete;
+    private Queued queued;
+
+    public void receive(final RemotePlayerMovement movement) {
+        if (movement.mode() == 1 || movement.mode() == 2) {
+            this.resetTargets();
+            this.headTarget = movement.rotation().z();
+            return;
+        }
+        if (movement.mode() == 3) {
+            this.headTarget = movement.rotation().z();
+            this.headSteps = Math.max(this.positionSteps, this.rotationSteps);
+            return;
+        }
+        if (movement.mode() == 0) {
+            this.target = movement.position();
+            this.rotation = movement.rotation();
+            this.positionSteps = 3;
+            this.rotationSteps = 3;
+            this.headTarget = movement.rotation().z();
+            this.headSteps = 3;
+            return;
+        }
+        if (movement.mode() != RemotePlayerMovement.ACTOR) {
+            this.clear();
+            return;
+        }
+        final int steps = Long.compareUnsigned(movement.duration(), 3) < 0 ? 3 : (int) movement.duration();
+        final boolean forced = (movement.flags() & 8) != 0;
+        if (this.mustComplete && this.positionSteps != 0 && !forced) {
+            this.queued = new Queued(movement.position(), movement.rotation(), steps);
+        } else {
+            this.target = movement.position();
+            this.positionSteps = steps;
+            this.mustComplete = forced;
+            this.queued = null;
+        }
+        // The remote-player category retains its independent three-step main rotation.
+        this.rotation = movement.rotation();
+        this.rotationSteps = 3;
+        this.headTarget = movement.rotation().z();
+        this.headSteps = 3;
+    }
+
+    public Step tick(final Position3f position, final float pitch, final float yaw, final float previousPitch, final float previousYaw, final float headYaw) {
+        final boolean clearMotion = this.positionSteps > 0;
+        final Position3f next;
+        if (this.positionSteps > 0) {
+            final float inverse = 1F / this.positionSteps;
+            next = this.positionSteps == 1 ? this.target : new Position3f(
+                    position.x() + (this.target.x() - position.x()) * inverse,
+                    position.y() + (this.target.y() - position.y()) * inverse,
+                    position.z() + (this.target.z() - position.z()) * inverse);
+            this.positionSteps--;
+        } else {
+            next = position;
+        }
+        float nextPitch = pitch;
+        float nextYaw = yaw;
+        float oldPitch = previousPitch;
+        float oldYaw = previousYaw;
+        if (this.rotationSteps > 0) {
+            final float inverse = 1F / this.rotationSteps;
+            final float rawPitch = this.rotationSteps == 1 ? this.rotation.x() : pitch + wrap(this.rotation.x() - pitch) * inverse;
+            final float rawYaw = this.rotationSteps == 1 ? this.rotation.y() : yaw + wrap(this.rotation.y() - yaw) * inverse;
+            nextPitch = wrap(rawPitch);
+            nextYaw = wrap(rawYaw);
+            oldPitch = wrap(previousPitch + (nextPitch - rawPitch));
+            oldYaw = wrap(previousYaw + (nextYaw - rawYaw));
+            this.rotationSteps--;
+        }
+        float nextHeadYaw = headYaw;
+        if (this.headSteps > 0) {
+            nextHeadYaw = this.headSteps == 1 ? this.headTarget : headYaw + wrap(this.headTarget - headYaw) * (1F / this.headSteps);
+            this.headSteps--;
+        }
+        if (this.queued != null) {
+            if (this.mustComplete && this.positionSteps != 0) {
+                this.queued = new Queued(this.queued.position, this.queued.rotation, Math.max(2, this.queued.steps) - 1);
+            } else {
+                this.target = this.queued.position;
+                this.rotation = this.queued.rotation;
+                this.positionSteps = this.queued.steps;
+                this.rotationSteps = this.queued.steps;
+                this.headTarget = 0F;
+                this.headSteps = 0;
+                this.mustComplete = false;
+                this.queued = null;
+            }
+        }
+        return new Step(next, nextPitch, nextYaw, oldPitch, oldYaw, nextHeadYaw, clearMotion);
+    }
+
+    public boolean active() {
+        return this.positionSteps != 0 || this.rotationSteps != 0 || this.headSteps != 0 || this.queued != null;
+    }
+
+    public Position3f target() { return this.target; }
+    public Position3f rotation() { return this.rotation; }
+
+    public void clear() {
+        this.resetTargets();
+        this.queued = null;
+    }
+
+    private void resetTargets() {
+        this.target = null;
+        this.rotation = null;
+        this.positionSteps = 0;
+        this.rotationSteps = 0;
+        this.headSteps = 0;
+        this.headTarget = 0F;
+        this.mustComplete = false;
+    }
+
+    static float wrap(final float value) {
+        float result = (value + 180F) % 360F;
+        if (result < 0F) result += 360F;
+        return result - 180F;
+    }
+
+    public record Step(Position3f position, float pitch, float yaw, float previousPitch, float previousYaw, float headYaw, boolean clearMotion) {}
+    private record Queued(Position3f position, Position3f rotation, int steps) {}
+}
