+package com.viaversion.viafabricplus.bedrock.creative;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import com.viaversion.viaversion.api.data.FullMappings;
+import com.viaversion.viaversion.api.minecraft.data.StructuredData;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataContainer;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import com.viaversion.viaversion.api.minecraft.item.StructuredItem;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionContents;
+import com.viaversion.viaversion.api.minecraft.item.data.PotionEffect;
+import com.viaversion.viaversion.api.type.types.item.ItemType1_20_5;
+import com.viaversion.viaversion.api.type.types.item.StructuredDataType;
+import io.netty.buffer.Unpooled;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.core.component.DataComponentMap;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.raphimc.viabedrock.api.model.NativeItemStackData;
+import net.raphimc.viabedrock.protocol.model.BedrockItem;
+import net.raphimc.viabedrock.protocol.model.CreativeCatalog;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockCreativeCatalogTest {
+    @BeforeAll
+    static void bootstrap() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        bindTestItemDefaults(Items.LINGERING_POTION);
+        bindTestItemDefaults(Items.PAPER);
+        Class.forName(StructuredDataKey.class.getName());
+    }
+
+    private static void bindTestItemDefaults(final Item item) {
+        // The client normally receives these holder defaults from the server's component registry.
+        if (!item.builtInRegistryHolder().areComponentsBound()) {
+            item.builtInRegistryHolder().bindComponents(DataComponentMap.EMPTY);
+        }
+    }
+
+    @Test
+    void convertsCompletePotionAndCreativeIdentityUsingMinecraftWireCodec() throws Exception {
+        final var registries = RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY);
+        final var custom = new CompoundTag();
+        custom.putInt("viabedrock:creative_entry", 72);
+        final var data = new StructuredDataContainer(new StructuredData<?>[]{
+                StructuredData.of(StructuredDataKey.CUSTOM_DATA, custom,
+                        BuiltInRegistries.DATA_COMPONENT_TYPE.getId(DataComponents.CUSTOM_DATA)),
+                StructuredData.of(StructuredDataKey.POTION_CONTENTS1_21_2,
+                        new PotionContents(null, 0x23AABC, new PotionEffect[0], "test"),
+                        BuiltInRegistries.DATA_COMPONENT_TYPE.getId(DataComponents.POTION_CONTENTS)),
+                StructuredData.of(StructuredDataKey.MAX_STACK_SIZE, 1,
+                        BuiltInRegistries.DATA_COMPONENT_TYPE.getId(DataComponents.MAX_STACK_SIZE))});
+        final var input = new StructuredItem(BuiltInRegistries.ITEM.getId(Items.LINGERING_POTION), 64, data);
+        final var result = BedrockCreativeCatalog.toNative(input,
+                registries);
+        assertSame(Items.LINGERING_POTION, result.getItem());
+        assertEquals(1, result.getCount());
+        assertEquals(1, result.getMaxStackSize());
+        assertEquals(0x23AABC, result.get(DataComponents.POTION_CONTENTS).customColor().orElseThrow());
+        assertEquals("test", result.get(DataComponents.POTION_CONTENTS).customName().orElseThrow());
+        assertEquals(72, result.get(DataComponents.CUSTOM_DATA).copyTag().getIntOr("viabedrock:creative_entry", 0));
+        assertEquals(64, input.amount());
+    }
+
+    @Test
+    void preservesCustomItemSnapshotThroughNativeCodecAndCreativeSelection() throws Exception {
+        final var nativeData = new CompoundTag();
+        nativeData.putString("custom_id", "geysermc:furnace_minecart");
+        final var nativeItem = new BedrockItem(5001, (short) 0, (byte) 1, nativeData);
+        final var context = new CompoundTag();
+        context.put(ItemDataRewriter.BEDROCK_STACK_TAG,
+            NativeItemStackData.fromItem(nativeItem).toTag());
+        final var data = new StructuredDataContainer(new StructuredData<?>[]{
+            StructuredData.of(StructuredDataKey.CUSTOM_DATA, context,
+                BuiltInRegistries.DATA_COMPONENT_TYPE.getId(DataComponents.CUSTOM_DATA)),
+            StructuredData.of(StructuredDataKey.MAX_STACK_SIZE, 1,
+                BuiltInRegistries.DATA_COMPONENT_TYPE.getId(DataComponents.MAX_STACK_SIZE))});
+        bindMappings(data);
+        final var item = new StructuredItem(BuiltInRegistries.ITEM.getId(Items.PAPER), 1, data);
+        final var catalog = new CreativeCatalog(List.of(), List.of(
+            new CreativeCatalog.Entry(42, 0, nativeItem, item, true, false)));
+        final var result = BedrockCreativeCatalog.toNative(catalog.entries().getFirst().javaItem(),
+            RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY));
+        assertEquals(1, result.getMaxStackSize());
+        final var buffer = new RegistryFriendlyByteBuf(Unpooled.buffer(),
+            RegistryAccess.fromRegistryOfRegistries(BuiltInRegistries.REGISTRY));
+        try {
+            ItemStack.OPTIONAL_STREAM_CODEC.encode(buffer, result);
