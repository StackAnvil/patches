+package com.viaversion.viafabricplus.bedrock.creative;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.type.types.version.VersionedTypes;
+import io.netty.buffer.Unpooled;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.world.item.ItemStack;
+import net.raphimc.viabedrock.protocol.model.CreativeCatalog;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+public final class BedrockCreativeCatalog {
+
+    private BedrockCreativeCatalog() {
+    }
+
+    public static @Nullable CreativeCatalog current() {
+        final UserConnection connection = ViaFabricPlus.api().userConnection();
+        final ItemRewriter rewriter = connection != null ? connection.get(ItemRewriter.class) : null;
+        return rewriter != null ? rewriter.creativeCatalog() : null;
+    }
+
+    /** Use the native group icon as the anchor in Java's more detailed creative tabs. */
+    public static List<CreativeCatalog.Entry> entriesForDisplay(final CreativeCatalog catalog, final int javaItemId) {
+        final Set<Integer> canonicalIds = catalog.entries().stream().filter(CreativeCatalog.Entry::canonical)
+            .map(entry -> entry.javaItem().identifier()).collect(Collectors.toSet());
+        return catalog.entries().stream().filter(CreativeCatalog.Entry::canonical).filter(entry -> {
+            if (entry.groupIndex() >= 0 && entry.groupIndex() < catalog.groups().size()) {
+                final var icon = catalog.groups().get(entry.groupIndex()).icon();
+                final boolean hasAnchor = !icon.isEmpty() && canonicalIds.contains(icon.identifier());
+                if (hasAnchor) {
+                    return icon.identifier() == javaItemId;
+                }
+            }
+            return entry.javaItem().identifier() == javaItemId;
+        }).toList();
+    }
+
+    public static ItemStack toNative(final CreativeCatalog.Entry entry) {
+        final var connection = Minecraft.getInstance().getConnection();
+        if (connection == null) {
+            return ItemStack.EMPTY;
+        }
+        return toNative(entry.javaItem(), connection.registryAccess());
+    }
+
+    public static ItemStack toNative(final com.viaversion.viaversion.api.minecraft.item.Item item,
+                                     final RegistryAccess registries) {
+        final var buffer = new RegistryFriendlyByteBuf(Unpooled.buffer(), registries);
+        try {
+            // Decode the same complete component patch used by normal inventory packets.
+            VersionedTypes.V26_3.item.write(buffer, item);
+            final ItemStack result = ItemStack.OPTIONAL_STREAM_CODEC.decode(buffer);
+            if (buffer.isReadable()) {
+                throw new IllegalArgumentException("Trailing creative item data");
+            }
+            result.setCount(1);
+            return result;
+        } catch (final Exception exception) {
+            throw new IllegalArgumentException("Cannot decode creative item data", exception);
+        } finally {
+            buffer.release();
+        }
+    }
+}
