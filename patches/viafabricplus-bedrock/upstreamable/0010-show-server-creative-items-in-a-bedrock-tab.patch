+package com.viaversion.viafabricplus.bedrock.creative;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import com.viaversion.viaversion.api.minecraft.data.StructuredDataKey;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.component.CustomData;
+import net.minecraft.world.item.component.CustomModelData;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.model.CreativeCatalog;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public final class BedrockCreativeCatalog {
+
+    private BedrockCreativeCatalog() {
+    }
+
+    public static @Nullable CreativeCatalog current() {
+        final UserConnection connection = ViaFabricPlus.api().userConnection();
+        final ItemRewriter rewriter = connection != null ? connection.get(ItemRewriter.class) : null;
+        return rewriter != null ? rewriter.creativeCatalog() : null;
+    }
+
+    public static boolean contains(final Item item, final CreativeCatalog catalog) {
+        final String javaIdentifier = BuiltInRegistries.ITEM.getKey(item).toString();
+        final Integer javaId = BedrockProtocol.MAPPINGS.getJavaItems().get(javaIdentifier);
+        return javaId != null && catalog.containsJavaItem(javaId);
+    }
+
+    public static ItemStack toNative(final CreativeCatalog.Entry entry, final String bedrockIdentifier) {
+        final com.viaversion.viaversion.api.minecraft.item.Item javaItem = entry.javaItem();
+        final String javaIdentifier = BedrockProtocol.MAPPINGS.getJavaItems().inverse().get(javaItem.identifier());
+        final Identifier itemId = javaIdentifier != null ? Identifier.tryParse(javaIdentifier) : null;
+        final Item nativeItem = itemId != null ? BuiltInRegistries.ITEM.getValue(itemId) : null;
+        final ItemStack stack = new ItemStack(nativeItem != null ? nativeItem : Items.PAPER);
+
+        final com.viaversion.nbt.tag.CompoundTag data = javaItem.dataContainer().get(StructuredDataKey.CUSTOM_DATA);
+        final com.viaversion.nbt.tag.IntTag entryId = data != null
+            ? (com.viaversion.nbt.tag.IntTag) data.get("viabedrock:creative_entry") : null;
+        if (entryId != null) {
+            final CompoundTag nativeData = new CompoundTag();
+            nativeData.putInt("viabedrock:creative_entry", entryId.asInt());
+            stack.set(DataComponents.CUSTOM_DATA, CustomData.of(nativeData));
+        }
+
+        final var itemModel = javaItem.dataContainer().get(StructuredDataKey.ITEM_MODEL);
+        if (itemModel != null) {
+            final Identifier modelId = Identifier.tryParse(itemModel.key().toString());
+            if (modelId != null) {
+                stack.set(DataComponents.ITEM_MODEL, modelId);
+            }
+        }
+        final var customModelData = javaItem.dataContainer().get(StructuredDataKey.CUSTOM_MODEL_DATA1_21_4);
+        if (customModelData != null) {
+            final List<Float> floats = new ArrayList<>(customModelData.floats().length);
+            for (final float value : customModelData.floats()) {
+                floats.add(value);
+            }
+            final List<Boolean> booleans = new ArrayList<>(customModelData.booleans().length);
+            for (final boolean value : customModelData.booleans()) {
+                booleans.add(value);
+            }
+            stack.set(DataComponents.CUSTOM_MODEL_DATA, new CustomModelData(
+                floats,
+                booleans,
+                Arrays.asList(customModelData.strings()),
+                Arrays.stream(customModelData.colors()).boxed().toList()));
+        }
+        final com.viaversion.nbt.tag.Tag translatedName = javaItem.dataContainer().get(StructuredDataKey.ITEM_NAME);
+        if (translatedName instanceof com.viaversion.nbt.tag.CompoundTag name
+            && name.get("text") instanceof com.viaversion.nbt.tag.StringTag text) {
+            stack.set(DataComponents.ITEM_NAME, Component.literal(text.getValue()));
+        } else if (bedrockIdentifier != null) {
+            stack.set(DataComponents.ITEM_NAME, Component.literal(bedrockIdentifier));
+        }
+        return stack;
+    }
+}
