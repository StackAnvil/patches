+package net.minecraft.world.item;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viafabricplus.bedrock.creative.BedrockCreativeCatalog;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.minecraft.core.Registry;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.Identifier;
+import net.minecraft.resources.ResourceKey;
+import net.raphimc.viabedrock.protocol.model.CreativeCatalog;
+import net.raphimc.viabedrock.protocol.rewriter.ItemRewriter;
+
+/** Bridges the protected creative tab display API in Minecraft's own package. */
+public final class BedrockCreativeTab {
+
+    private BedrockCreativeTab() {
+    }
+
+    public static void register(final Registry<CreativeModeTab> registry) {
+        final CreativeModeTab tab = CreativeModeTab.builder(CreativeModeTab.Row.TOP, 7)
+            .title(Component.translatable("itemGroup.viafabricplus.bedrock"))
+            .icon(() -> new ItemStack(Items.BEDROCK))
+            .displayItems((parameters, output) -> {
+                final UserConnection connection = ViaFabricPlus.api().userConnection();
+                final ItemRewriter rewriter = connection != null ? connection.get(ItemRewriter.class) : null;
+                if (rewriter == null) {
+                    return;
+                }
+                for (final CreativeCatalog.Entry entry : rewriter.creativeCatalog().entries()) {
+                    if (entry.bedrockOnly()) {
+                        output.accept(BedrockCreativeCatalog.toNative(entry,
+                            rewriter.getItems().inverse().get(entry.bedrockItem().identifier())));
+                    }
+                }
+            })
+            .build();
+        Registry.register(registry,
+            ResourceKey.create(Registries.CREATIVE_MODE_TAB,
+                Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "bedrock")), tab);
+    }
+}
