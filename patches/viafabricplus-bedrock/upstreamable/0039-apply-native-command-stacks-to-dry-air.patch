@@ -0,0 +1,96 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.texture.AbstractTexture;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.resources.ResourceManager;
+import org.jetbrains.annotations.Nullable;
+
+/** The world's selected licensed vanilla texture, below accepted server overrides. */
+public final class BedrockEndSkyTexture {
+    private static final Identifier LOCATION = Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "environment/end_sky");
+    private static long generation = -1;
+    private static ResourceManager resources;
+    private static CompletableFuture<byte[]> pending;
+    private static AbstractTexture texture;
+
+    private BedrockEndSkyTexture() {
+    }
+
+    public static @Nullable AbstractTexture get() {
+        return generation == BedrockServerResources.generation()
+            && resources == Minecraft.getInstance().getResourceManager() ? texture : null;
+    }
+
+    /** Upload before rendering begins. Texture writes are invalid inside an active sky pass. */
+    public static void tick() {
+        final var minecraft = Minecraft.getInstance();
+        final long current = BedrockServerResources.generation();
+        if (generation != current || resources != minecraft.getResourceManager()) {
+            clear();
+            generation = current;
+            resources = minecraft.getResourceManager();
+            final ResourceManager selected = resources;
+            pending = CompletableFuture.supplyAsync(() -> {
+                try {
+                    final var library = BedrockServerResources.library(selected, BedrockBuiltinAssets.load());
+                    return encode(library.particleTexture("textures/environment/end_sky"));
+                } catch (final IOException | RuntimeException failure) {
+                    throw new CompletionException(failure);
+                }
+            });
+        }
+        if (pending != null && pending.isDone()) {
+            final var completed = pending;
+            pending = null;
+            try {
+                final byte[] encoded = completed.join();
+                if (encoded != null) {
+                    final NativeImage pixels = NativeImage.read(encoded);
+                    DynamicTexture loaded = null;
+                    try {
+                        loaded = new DynamicTexture(LOCATION::toString, pixels);
+                        minecraft.getTextureManager().register(LOCATION, loaded);
+                        texture = loaded;
+                    } catch (final RuntimeException failure) {
+                        if (loaded == null) pixels.close();
+                        else loaded.close();
+                        throw failure;
+                    }
+                }
+            } catch (final IOException | RuntimeException failure) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load the native End sky texture", failure);
+            }
+        }
+    }
+
+    private static byte @Nullable [] encode(final byte[] bytes) throws IOException {
+        if (bytes == null) return null;
+        final var image = BedrockParticleTexture.read(bytes);
+        if (image.getWidth() > 4096 || image.getHeight() > 4096) throw new IOException("End sky texture exceeds size limits");
+        final var encoded = new ByteArrayOutputStream();
+        if (!javax.imageio.ImageIO.write(image, "png", encoded)) throw new IOException("Could not encode the End sky texture");
+        return encoded.toByteArray();
+    }
+
+    public static void clear() {
+        if (pending != null) pending.cancel(false);
+        pending = null;
+        if (texture != null) Minecraft.getInstance().getTextureManager().release(LOCATION);
+        texture = null;
+        resources = null;
+        generation = -1;
+    }
+}
