+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import net.raphimc.viabedrock.api.model.FogState;
+
+/** Queued network callbacks cannot restore a previous connection's resources or commands. */
+final class FogSession {
+    private long generation;
+    private FogState snapshot = FogState.EMPTY;
+
+    long begin() {
+        this.snapshot = FogState.EMPTY;
+        return ++this.generation;
+    }
+
+    boolean accept(final long generation, final FogState snapshot) {
+        if (generation != this.generation) return false;
+        this.snapshot = snapshot;
+        return true;
+    }
+
+    void clear() {
+        this.begin();
+    }
+
+    FogState snapshot() {
+        return this.snapshot;
+    }
+}
