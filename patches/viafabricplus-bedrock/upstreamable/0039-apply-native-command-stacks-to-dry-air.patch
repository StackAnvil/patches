+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderPipelines;
+import java.util.Optional;
+import net.minecraft.client.renderer.BindGroupLayouts;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.resources.Identifier;
+
+public final class BedrockEndSkyPipeline {
+    public static final RenderPipeline PIPELINE = create();
+
+    private BedrockEndSkyPipeline() {
+    }
+
+    private static RenderPipeline create() {
+        final RenderPipeline original = RenderPipelines.END_SKY;
+        final ColorTargetState[] colors = original.getColorTargetStates().toArray(ColorTargetState[]::new);
+        final var snippet = new RenderPipeline.Snippet(original.getShaders(), Optional.of(original.getShaderDefines()),
+            Optional.of(original.getBindGroupLayouts()), colors, colors.length, Optional.ofNullable(original.getDepthStencilState()),
+            Optional.of(original.getPolygonMode()), Optional.of(original.isCull()),
+            original.getVertexFormatBindings().toArray(VertexFormat[]::new), Optional.of(original.getPrimitiveTopology()),
+            original.pushConstantSize());
+        final var builder = RenderPipeline.builder(snippet)
+            .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/end_sky"))
+            .withVertexShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_end_sky"))
+            .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_end_sky"));
+        if (!original.getBindGroupLayouts().contains(BindGroupLayouts.FOG)) builder.withBindGroupLayout(BindGroupLayouts.FOG);
+        return BedrockShaderPipelines.register(builder.build(), original);
+    }
+}
