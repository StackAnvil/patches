+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.FogState;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FogStackTest {
+    private static final FogState.Distance RED = new FogState.Distance(0, 32, 0xFF0000, false);
+    private static final FogState.Distance GREEN = new FogState.Distance(0, 96, 0x00FF00, false);
+    private static final FogState.Layer RED_BIOME = new FogState.Layer("test:red", Map.of("air", RED));
+
+    @Test
+    void biomeSamplesWithoutAirFogPassTheirShareToTheDataDefault() {
+        final var state = new FogState(List.of(), Map.of("minecraft:the_end", RED_BIOME), Map.of("air", GREEN));
+        // 9 of the 27 samples near a biome boundary fall in the red End biome.
+        final List<String> samples = new ArrayList<>();
+        for (int i = 0; i < FogStack.BIOME_SAMPLES.length; i++) {
+            samples.add(i % 3 == 0 ? "minecraft:the_end" : i % 3 == 1 ? "minecraft:plains" : null);
+        }
+        final FogSetting setting = FogStack.resolve(state, "air", samples, 176);
+        assertNotNull(setting);
+        assertEquals(1F / 3F, setting.red(), 0.00001F);
+        assertEquals(2F / 3F, setting.green(), 0.00001F);
+        assertEquals(0F, setting.blue());
+        assertEquals(32F / 3F + 64F, setting.end(), 0.0001F);
+    }
+
+    @Test
+    void partialBiomeCoverageWithoutDataDefaultFadesToBlackAtDistanceZero() {
+        final var state = new FogState(List.of(), Map.of("minecraft:the_end", RED_BIOME), Map.of());
+        final List<String> samples = new ArrayList<>();
+        for (int i = 0; i < FogStack.BIOME_SAMPLES.length; i++) {
+            samples.add(i % 3 == 0 ? "minecraft:the_end" : "minecraft:plains");
+        }
+        // The undefined two thirds take native's zeroed setting instead of repeating the red End fog.
+        assertEquals(new FogSetting(1F / 3F, 0, 0, 0, 32F / 3F), FogStack.resolve(state, "air", samples, 176));
+    }
+
+    @Test
+    void topmostCommandDefiningTheMediumReplacesBiomesAndDefaults() {
+        final var blue = new FogState.Distance(8, 16, 0x0000FF, false);
+        final var state = new FogState(List.of(
+            new FogState.Layer("test:blue", Map.of("air", blue)),
+            new FogState.Layer("test:water_only", Map.of("water", GREEN))
+        ), Map.of("minecraft:the_end", RED_BIOME), Map.of("air", GREEN));
+        assertEquals(new FogSetting(0, 0, 1, 8, 16), FogStack.resolve(state, "air", List.of("minecraft:the_end"), 176));
+        // The water-only command above it does not take any air weight.
+        assertEquals(new FogSetting(0, 1, 0, 0, 96), FogStack.resolve(state, "water", List.of("minecraft:the_end"), 176));
+    }
+
+    @Test
+    void renderRelativeAndFixedSamplesAverageInBlocks() {
+        final var relative = new FogState.Layer("test:relative", Map.of("air", new FogState.Distance(0.5F, 1, 0, true)));
+        final var state = new FogState(List.of(), Map.of("minecraft:the_end", RED_BIOME, "minecraft:plains", relative), Map.of());
+        final FogSetting setting = FogStack.resolve(state, "air", List.of("minecraft:the_end", "minecraft:plains"), 100);
+        assertNotNull(setting);
+        assertEquals(25F, setting.start(), 0.0001F);
+        assertEquals(66F, setting.end(), 0.0001F);
+    }
+
+    @Test
+    void undefinedMediumKeepsJavaFog() {
+        final var state = new FogState(List.of(), Map.of("minecraft:the_end", RED_BIOME), Map.of());
+        assertNull(FogStack.resolve(state, "air", List.of("minecraft:plains"), 176));
+        assertNull(FogStack.resolve(state, "water", List.of("minecraft:the_end"), 176));
+    }
+}
