+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import net.raphimc.viabedrock.api.model.FogState;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class FogSessionTest {
+    @Test
+    void oldCallbacksCannotRestoreResourcesAfterReplacementOrDisconnect() {
+        final var session = new FogSession();
+        final long first = session.begin();
+        final var old = new FogState(List.of(new FogState.Layer("test:old", Map.of(
+                "air", new FogState.Distance(0, 16, 0xFFFFFF, false)))), Map.of(), Map.of());
+        assertTrue(session.accept(first, old));
+        final long replacement = session.begin();
+        assertSame(FogState.EMPTY, session.snapshot());
+        assertFalse(session.accept(first, old));
+        final var current = new FogState(List.of(new FogState.Layer("test:current", Map.of(
+                "air", new FogState.Distance(0, 128, 0, false)))), Map.of(), Map.of());
+        assertTrue(session.accept(replacement, current));
+        assertSame(current, session.snapshot());
+        session.clear();
+        assertFalse(session.accept(replacement, current));
+        assertSame(FogState.EMPTY, session.snapshot());
+    }
+
+    @Test
+    void emptyUpdatesRemoveEarlierLayersWithinOneConnection() {
+        final var session = new FogSession();
+        final long generation = session.begin();
+        assertTrue(session.accept(generation, new FogState(List.of(new FogState.Layer("test:air", Map.of(
+                "air", new FogState.Distance(0, 16, 0, false)))), Map.of(), Map.of())));
+        assertNotNull(session.snapshot().resolve("air", "the_end"));
+        assertTrue(session.accept(generation, FogState.EMPTY));
+        assertNull(session.snapshot().resolve("air", "the_end"));
+    }
+    @Test
+    void replacingWorldResourcesRetiresBaseSettingsAndEmptyCommandsRetainTheCurrentBiome() {
+        final var session = new FogSession();
+        final var oldAir = new FogState.Distance(0, 64, 0x0000FF, false);
+        final var currentAir = new FogState.Distance(0, 32, 0xFF0000, false);
+        final long first = session.begin();
+        final var old = new FogState(List.of(), Map.of("the_end", new FogState.Layer("test:old", Map.of("air", oldAir))), Map.of());
+        assertTrue(session.accept(first, old));
+        assertSame(oldAir, session.snapshot().resolve("air", "the_end"));
+        final long second = session.begin();
+        assertNull(session.snapshot().resolve("air", "the_end"));
+        assertFalse(session.accept(first, old));
+        final var current = new FogState(List.of(), Map.of("the_end", new FogState.Layer("test:new", Map.of("air", currentAir))), Map.of());
+        assertTrue(session.accept(second, current));
+        assertSame(currentAir, session.snapshot().resolve("air", "the_end"));
+        session.clear();
+        assertNull(session.snapshot().resolve("air", "the_end"));
+        assertFalse(session.accept(second, current));
+    }
+
+}
