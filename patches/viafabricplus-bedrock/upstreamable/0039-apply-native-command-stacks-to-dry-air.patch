@@ -0,0 +1,24 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+/** A resolved fog color and its start and end distances in blocks. */
+record FogSetting(float red, float green, float blue, float start, float end) {
+    /** Native 1.26.60.5 moves dry-air fog 1% of the way to its target each frame (0x145373dd8, 0.01 at 0x14f0b7770). */
+    static final float AIR_RATE = 0.01F;
+
+    FogSetting withColor(final float red, final float green, final float blue) {
+        return new FogSetting(red, green, blue, this.start, this.end);
+    }
+
+    /** Matches the native operand order: colors use target * f + previous * (1 - f), distances previous + (target - previous) * f. */
+    FogSetting toward(final FogSetting target, final float rate) {
+        final float keep = 1F - rate;
+        return new FogSetting(target.red * rate + keep * this.red, target.green * rate + keep * this.green,
+            target.blue * rate + keep * this.blue, (target.start - this.start) * rate + this.start,
+            (target.end - this.end) * rate + this.end);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/fog/FogStack.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/fog/FogStack.java
