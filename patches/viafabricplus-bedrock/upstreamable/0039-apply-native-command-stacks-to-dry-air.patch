+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockLightmapExtractor;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockEndSkyTexture;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Camera;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.renderer.fog.FogData;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.jetbrains.annotations.Nullable;
+
+public final class BedrockFog {
+    private static final FogSession SESSION = new FogSession();
+    private static @Nullable ClientPacketListener owner;
+
+    private BedrockFog() {
+    }
+
+    public static void register() {
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            if (BedrockLightmapExtractor.dimension(client) == Dimension.END) BedrockEndSkyTexture.tick();
+        });
+        PayloadTypeRegistry.clientboundPlay().register(FogPayload.TYPE, FogPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            BedrockEndSkyTexture.clear();
+            owner = listener;
+            final long generation = SESSION.begin();
+            ClientPlayNetworking.registerReceiver(FogPayload.TYPE, (payload, context) -> {
+                if (client.getConnection() == listener) SESSION.accept(generation, payload.state());
+            });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> client.execute(() -> {
+            // Disconnect can run on Netty; retire GPU resources on the client thread, for this listener only.
+            if (owner == listener) {
+                owner = null;
+                SESSION.clear();
+                BedrockEndSkyTexture.clear();
+            }
+        }));
+    }
+
+    public static @Nullable FogState.Distance air(final Camera camera, final ClientLevel level) {
+        return active(BedrockLightmapExtractor.dimension(Minecraft.getInstance()), camera, level)
+            ? SESSION.snapshot().resolve("air", biome(camera, level)) : null;
+    }
+
+    private static @Nullable String biome(final Camera camera, final ClientLevel level) {
+        return level.getBiome(camera.blockPosition()).unwrapKey().map(key -> key.identifier().toString()).orElse(null);
+    }
+
+    private static boolean active(final @Nullable Dimension dimension, final Camera camera, final ClientLevel level) {
+        return owner != null && owner == Minecraft.getInstance().getConnection()
+            && supported(dimension, camera.getFluidInCamera(), level.getRainLevel(1F), level.getThunderLevel(1F));
+    }
+
+    public static boolean endSky() {
+        final var minecraft = Minecraft.getInstance();
+        return minecraft.level != null && BedrockLightmapExtractor.dimension(minecraft) == Dimension.END
+            && air(minecraft.gameRenderer.mainCamera(), minecraft.level) != null;
+    }
+
+    static boolean supported(final @Nullable Dimension dimension, final FogType medium, final float rain, final float thunder) {
+        return dimension != null && medium == FogType.NONE && rain <= 0 && thunder <= 0;
+    }
+
+    public static void applyDistance(final FogData fog, final Camera camera, final ClientLevel level, final float renderDistance) {
+        final Dimension dimension = BedrockLightmapExtractor.dimension(Minecraft.getInstance());
+        if (!active(dimension, camera, level)) return;
+        boolean livingDragon = false;
+        if (dimension == Dimension.END) {
+            // Native retains an admitted dragon across a distant teleport, until its actor lifetime ends.
+            for (final var entity : level.entitiesForRendering()) {
+                if (entity.getType() == EntityTypes.ENDER_DRAGON && entity.isAlive()) {
+                    livingDragon = true;
+                    break;
+                }
+            }
+        }
+        final Range range = range(dimension, livingDragon, SESSION.snapshot().resolve("air", biome(camera, level)), renderDistance);
+        if (range == null) return;
+        fog.environmentalStart = range.start;
+        fog.environmentalEnd = range.end;
+        fog.skyEnd = Math.min(renderDistance, range.end);
+        fog.cloudEnd = Math.min(fog.cloudEnd, range.end);
+    }
+
+    static @Nullable Range range(final @Nullable Dimension dimension, final boolean livingDragon,
+                                 final @Nullable FogState.Distance setting, final float renderDistance) {
+        if (dimension == null) return null;
+        // Native 1.26.60.5 uniforms establish 0..100 blocks, capped by the effective render distance.
+        // The dragon replaces distances even without a command, while the ordinary color path remains intact.
+        if (dimension == Dimension.END && livingDragon) return new Range(0, Math.min(100, renderDistance));
+        return setting == null ? null : new Range(setting.start(renderDistance), setting.end(renderDistance));
+    }
+
+    record Range(float start, float end) {
+    }
+}
