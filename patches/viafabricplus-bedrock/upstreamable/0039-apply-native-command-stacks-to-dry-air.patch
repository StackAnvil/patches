+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import java.util.Map;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockFogTest {
+    @Test
+    void dryAirCommandsDoNotReplaceUnverifiedFluidOrWeatherDistanceRules() {
+        for (final Dimension dimension : Dimension.values()) {
+            assertTrue(BedrockFog.supported(dimension, FogType.NONE, 0, 0));
+            assertFalse(BedrockFog.supported(dimension, FogType.NONE, 0.5F, 0));
+            assertFalse(BedrockFog.supported(dimension, FogType.NONE, 0, 0.5F));
+            for (final FogType fluid : new FogType[]{FogType.WATER, FogType.LAVA, FogType.POWDER_SNOW}) {
+                assertFalse(BedrockFog.supported(dimension, fluid, 0, 0));
+            }
+        }
+        assertFalse(BedrockFog.supported(null, FogType.NONE, 0, 0));
+    }
+
+    @Test
+    void livingEndDragonCapsDistanceWithOrWithoutFogCommands() {
+        for (final var observed : Map.of(80F, 80F, 192F, 100F).entrySet()) {
+            final float renderDistance = observed.getKey();
+            final var expected = new BedrockFog.Range(0, observed.getValue());
+            assertEquals(expected, BedrockFog.range(Dimension.END, true, null, renderDistance));
+            for (final var command : new FogState.Distance[]{
+                new FogState.Distance(0, 16, 0xFFFFFF, false),
+                new FogState.Distance(0, 128, 0xFF0000, false),
+                new FogState.Distance(-0.25F, 0.75F, 0, true)
+            }) {
+                assertEquals(expected, BedrockFog.range(Dimension.END, true, command, renderDistance));
+                assertEquals(new BedrockFog.Range(command.start(renderDistance), command.end(renderDistance)),
+                    BedrockFog.range(Dimension.END, false, command, renderDistance));
+            }
+            assertNull(BedrockFog.range(Dimension.END, false, null, renderDistance));
+        }
+    }
+
+    @Test
+    void dragonOverrideDoesNotEscapeTheEndOrAnAcceptedNativeContext() {
+        final var command = new FogState.Distance(0, 16, 0, false);
+        assertNull(BedrockFog.range(null, true, command, 192));
+        for (final Dimension dimension : new Dimension[]{Dimension.OVERWORLD, Dimension.NETHER}) {
+            assertNull(BedrockFog.range(dimension, true, null, 192));
+            assertEquals(new BedrockFog.Range(0, 16), BedrockFog.range(dimension, true, command, 192));
+        }
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/fog/FogSessionTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/fog/FogSessionTest.java
