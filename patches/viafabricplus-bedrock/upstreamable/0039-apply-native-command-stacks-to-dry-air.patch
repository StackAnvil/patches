+
+#include <minecraft:fog.glsl>
+uniform sampler2D Sampler0;
+layout(location = 0) in vec2 texCoord0;
+layout(location = 0) out vec4 fragColor;
+
+void main() {
+    // Native 1.26.60.5 EndSky multiplies the grayscale texture by twice the fog color.
+    fragColor = vec4(texture(Sampler0, texCoord0).rgb * FogColor.rgb * 2.0, 1.0);
