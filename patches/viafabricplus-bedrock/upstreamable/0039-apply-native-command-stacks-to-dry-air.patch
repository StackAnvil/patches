--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/fog/FogStack.java
@@ -0,0 +1,85 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import com.viaversion.viaversion.util.Key;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import net.raphimc.viabedrock.api.model.FogState;
+import org.jetbrains.annotations.Nullable;
+
+/** Resolves a medium through the native weighted fog stack: commands, camera biome samples, then data defaults. */
+final class FogStack {
+    /**
+     * Native 1.26.60.5 biome sample offsets from the floored camera position (table 0x14f246c50):
+     * the center, 12 blocks along each horizontal axis and 8 blocks along each diagonal, at dy 0, -3 and +3.
+     */
+    static final int[][] BIOME_SAMPLES = {
+        {0, 0, 0}, {-12, 0, 0}, {-8, 0, -8}, {0, 0, -12}, {8, 0, -8}, {12, 0, 0}, {8, 0, 8}, {0, 0, 12}, {-8, 0, 8},
+        {0, -3, 0}, {-12, -3, 0}, {-8, -3, -8}, {0, -3, -12}, {8, -3, -8}, {12, -3, 0}, {8, -3, 8}, {0, -3, 12}, {-8, -3, 8},
+        {0, 3, 0}, {-12, 3, 0}, {-8, 3, -8}, {0, 3, -12}, {8, 3, -8}, {12, 3, 0}, {8, 3, 8}, {0, 3, 12}, {-8, 3, 8}
+    };
+
+    private FogStack() {
+    }
+
+    /**
+     * Native FogManager::calculateCurrentDistanceSetting (0x142148a80) walks the layers from the top. Each layer adds
+     * the remaining weight times the sum of its defined samples divided by its sample count, then keeps the weight of
+     * its undefined samples for the layers below. A command layer holds one sample, so the topmost command that
+     * defines the medium takes all weight. The biome layer holds one sample per biome position. The data default
+     * comes last (fallback lambda 0x1421c9ad0) and any weight left after it adds black at distance 0.
+     *
+     * @param biomes the biome key at each sample position, or null where none is known
+     * @param distance the native fog distance that scales render-relative settings
+     * @return the blended setting in blocks, or null if no layer defines the medium
+     */
+    static @Nullable FogSetting resolve(final FogState state, final String medium, final List<@Nullable String> biomes,
+                                        final float distance) {
+        final List<List<FogState.@Nullable Distance>> layers = new ArrayList<>();
+        for (int i = state.layers().size() - 1; i >= 0; i--) {
+            layers.add(Collections.singletonList(state.layers().get(i).distances().get(medium)));
+        }
+        final List<FogState.@Nullable Distance> samples = new ArrayList<>(biomes.size());
+        for (final String biome : biomes) {
+            final FogState.Layer layer = biome == null ? null : state.biomes().get(Key.namespaced(biome));
+            samples.add(layer == null ? null : layer.distances().get(medium));
+        }
+        layers.add(samples);
+        layers.add(Collections.singletonList(state.defaults().get(medium)));
+
+        float weight = 1F;
+        float red = 0, green = 0, blue = 0, start = 0, end = 0;
+        for (final var layer : layers) {
+            if (layer.isEmpty()) continue;
+            int defined = 0;
+            float layerRed = 0, layerGreen = 0, layerBlue = 0, layerStart = 0, layerEnd = 0;
+            for (final FogState.Distance sample : layer) {
+                if (sample == null) continue;
+                defined++;
+                layerRed += (sample.color() >> 16 & 255) / 255F;
+                layerGreen += (sample.color() >> 8 & 255) / 255F;
+                layerBlue += (sample.color() & 255) / 255F;
+                layerStart += sample.start(distance);
+                layerEnd += sample.end(distance);
+            }
+            final float share = weight / layer.size();
+            red += layerRed * share;
+            green += layerGreen * share;
+            blue += layerBlue * share;
+            start += layerStart * share;
+            end += layerEnd * share;
+            if (defined == layer.size()) return new FogSetting(red, green, blue, start, end);
+            weight *= 1F - (float) defined / layer.size();
+        }
+        // Native would resolve black fog at distance 0 here. No defined layer usually means the world's fog data has
+        // not arrived, so keep Java fog instead.
+        if (weight >= 1F) return null;
+        // Native fills the rest with a zeroed setting: black, start and end 0 (0x152945670, set by 0x1421ccd30).
+        return new FogSetting(red, green, blue, start, end);
+    }
+}
