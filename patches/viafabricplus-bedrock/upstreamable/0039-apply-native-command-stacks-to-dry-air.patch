diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/fog/BedrockFogTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/fog/BedrockFogTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..acb475b152fa3b718285bc026e3d940d12d05447
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/fog/BedrockFogTest.java
@@ -0,0 +1,126 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import java.util.List;
+import java.util.Map;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.api.model.FogState;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockFogTest {
+    @Test
+    void overworldFogUsesNativeDayNightModulationBeforeVisionEffects() {
+        final var day = BedrockFog.color(rgb(0x204060), Dimension.OVERWORLD, 6000);
+        assertEquals(0.1254902035F, day.x(), 0.000001F);
+        assertEquals(0.2509804070F, day.y(), 0.000001F);
+        assertEquals(0.3764707744F, day.z(), 0.000001F);
+        final var night = BedrockFog.color(rgb(0x204060), Dimension.OVERWORLD, 18000);
+        assertEquals(0.0075294119F, night.x(), 0.000001F);
+        assertEquals(0.0150588239F, night.y(), 0.000001F);
+        assertEquals(0.0338823721F, night.z(), 0.000001F);
+        final var dusk = BedrockFog.color(rgb(0x204060), Dimension.OVERWORLD, 13000);
+        assertEquals(0.0522189364F, dusk.x(), 0.00001F);
+        assertEquals(0.1044378728F, dusk.y(), 0.00001F);
+        assertEquals(0.1636722237F, dusk.z(), 0.00001F);
+        for (final Dimension dimension : new Dimension[]{Dimension.NETHER, Dimension.END}) {
+            assertEquals(day, BedrockFog.color(rgb(0x204060), dimension, 18000));
+        }
+    }
+
+    @Test
+    void dryAirCommandsDoNotReplaceUnverifiedFluidOrWeatherDistanceRules() {
+        for (final Dimension dimension : Dimension.values()) {
+            assertTrue(BedrockFog.supported(dimension, FogType.NONE, 0, 0));
+            assertFalse(BedrockFog.supported(dimension, FogType.NONE, 0.5F, 0));
+            assertFalse(BedrockFog.supported(dimension, FogType.NONE, 0, 0.5F));
+            for (final FogType fluid : new FogType[]{FogType.WATER, FogType.LAVA, FogType.POWDER_SNOW}) {
+                assertFalse(BedrockFog.supported(dimension, fluid, 0, 0));
+            }
+        }
+        assertFalse(BedrockFog.supported(null, FogType.NONE, 0, 0));
+    }
+
+    @Test
+    void livingEndDragonCapsDistanceWithOrWithoutFogCommands() {
+        // A 5-chunk view leaves 72 fog blocks, below the dragon's 100-block end.
+        for (final var observed : Map.of(80F, 72F, 192F, 100F).entrySet()) {
+            final float renderDistance = observed.getKey();
+            final var expected = new BedrockFog.Range(0, observed.getValue());
+            assertEquals(expected, BedrockFog.range(Dimension.END, true, null, renderDistance));
+            for (final var command : new FogState.Distance[]{
+                new FogState.Distance(0, 16, 0xFFFFFF, false),
+                new FogState.Distance(0, 128, 0xFF0000, false),
+                new FogState.Distance(-0.25F, 0.75F, 0, true)
+            }) {
+                assertEquals(expected, BedrockFog.range(Dimension.END, true, setting(command, renderDistance), renderDistance));
+            }
+            assertNull(BedrockFog.range(Dimension.END, false, null, renderDistance));
+        }
+    }
+
+    @Test
+    void fogSettingsScaleByAndStayWithinTheNativeFogDistance() {
+        final var relative = new FogState.Distance(0.5F, 1, 0, true);
+        final var farFixed = new FogState.Distance(300, 1024, 0, false);
+        final var nearFixed = new FogState.Distance(0, 32, 0, false);
+        // Render distance in blocks -> {relative, far fixed} ranges; margins are 1/16, 8 and 16 blocks.
+        final Map<Float, BedrockFog.Range[]> observed = Map.of(
+            32F, new BedrockFog.Range[]{new BedrockFog.Range(15, 30), new BedrockFog.Range(26, 30)},
+            64F, new BedrockFog.Range[]{new BedrockFog.Range(30, 60), new BedrockFog.Range(50, 60)},
+            80F, new BedrockFog.Range[]{new BedrockFog.Range(36, 72), new BedrockFog.Range(56, 72)},
+            192F, new BedrockFog.Range[]{new BedrockFog.Range(88, 176), new BedrockFog.Range(108, 176)},
+            512F, new BedrockFog.Range[]{new BedrockFog.Range(248, 496), new BedrockFog.Range(300, 496)});
+        for (final var entry : observed.entrySet()) {
+            final float renderDistance = entry.getKey();
+            assertEquals(entry.getValue()[0], BedrockFog.range(Dimension.OVERWORLD, false, setting(relative, renderDistance), renderDistance));
+            assertEquals(entry.getValue()[1], BedrockFog.range(Dimension.OVERWORLD, false, setting(farFixed, renderDistance), renderDistance));
+            assertEquals(new BedrockFog.Range(0, Math.min(32, entry.getValue()[1].end())),
+                BedrockFog.range(Dimension.END, false, setting(nearFixed, renderDistance), renderDistance));
+        }
+    }
+
+    @Test
+    void dragonOverrideDoesNotEscapeTheEndOrAnAcceptedNativeContext() {
+        final var command = setting(new FogState.Distance(0, 16, 0, false), 192);
+        assertNull(BedrockFog.range(null, true, command, 192));
+        for (final Dimension dimension : new Dimension[]{Dimension.OVERWORLD, Dimension.NETHER}) {
+            assertNull(BedrockFog.range(dimension, true, null, 192));
+            assertEquals(new BedrockFog.Range(0, 16), BedrockFog.range(dimension, true, command, 192));
+        }
+    }
+
+    @Test
+    void airFogSnapsToItsFirstTargetThenMovesOnePercentPerFrame() {
+        final var clear = new FogSetting(1, 1, 1, 0, 200);
+        final var red = new FogSetting(1, 0, 0, 0, 100);
+        assertEquals(clear, BedrockFog.advance(null, clear));
+        FogSetting frame = clear;
+        for (int i = 0; i < 100; i++) {
+            frame = BedrockFog.advance(frame, red);
+        }
+        // After 100 frames the remaining difference is 0.99^100 = 36.6% of the step.
+        assertEquals(1F, frame.red(), 0.00001F);
+        assertEquals(0.36603F, frame.green(), 0.0001F);
+        assertEquals(136.603F, frame.end(), 0.01F);
+        // A frame without native air fog, such as one in a fluid, makes the next target apply at once.
+        assertNull(BedrockFog.advance(frame, null));
+        assertEquals(clear, BedrockFog.advance(BedrockFog.advance(frame, null), clear));
+    }
+
+    private static FogSetting setting(final FogState.Distance air, final float renderDistance) {
+        final var state = new FogState(List.of(), Map.of(), Map.of("air", air));
+        return FogStack.resolve(state, "air", List.of(), BedrockFog.fogDistance(renderDistance));
+    }
+
+    private static Vector3f rgb(final int color) {
+        return new Vector3f((color >> 16 & 255) / 255F, (color >> 8 & 255) / 255F, (color & 255) / 255F);
+    }
+}
