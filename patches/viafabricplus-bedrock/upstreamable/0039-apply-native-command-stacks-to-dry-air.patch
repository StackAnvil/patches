+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockLightmapExtractor;
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockLightmapMath;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockEndSkyTexture;
+import java.util.ArrayList;
+import java.util.List;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Camera;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.renderer.fog.FogData;
+import net.minecraft.core.BlockPos;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.level.material.FogType;
+import net.raphimc.viabedrock.protocol.data.enums.Dimension;
+import org.jetbrains.annotations.Nullable;
+import org.joml.Vector3f;
+
+public final class BedrockFog {
+    private static final FogSession SESSION = new FogSession();
+    private static @Nullable ClientPacketListener owner;
+    /** Dry-air fog after the latest frame's blend, or null when that frame used Java fog. */
+    private static @Nullable FogSetting frame;
+
+    private BedrockFog() {
+    }
+
+    public static void register() {
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            if (BedrockLightmapExtractor.dimension(client) == Dimension.END) BedrockEndSkyTexture.tick();
+        });
+        PayloadTypeRegistry.clientboundPlay().register(FogPayload.TYPE, FogPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            BedrockEndSkyTexture.clear();
+            owner = listener;
+            frame = null;
+            final long generation = SESSION.begin();
+            ClientPlayNetworking.registerReceiver(FogPayload.TYPE, (payload, context) -> {
+                if (client.getConnection() == listener) SESSION.accept(generation, payload.state());
+            });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> client.execute(() -> {
+            // Disconnect can run on Netty; retire GPU resources on the client thread, for this listener only.
+            if (owner == listener) {
+                owner = null;
+                frame = null;
+                SESSION.clear();
+                BedrockEndSkyTexture.clear();
+            }
+        }));
+    }
+
+    /**
+     * Advances the dry-air fog once per frame, before vision and camera modifiers, and returns its color.
+     *
+     * @return the blended color, or null to keep Java's fog for this frame
+     */
+    public static @Nullable Vector3f frameColor(final Camera camera, final ClientLevel level, final int renderChunks) {
+        final Dimension dimension = BedrockLightmapExtractor.dimension(Minecraft.getInstance());
+        FogSetting target = null;
+        if (active(dimension, camera, level)) {
+            target = FogStack.resolve(SESSION.snapshot(), "air", biomes(camera, level), fogDistance(renderChunks * 16F));
+        }
+        if (target != null) {
+            // Native blends the clock-modulated color (0x145373c82 precedes the blend at 0x145373e20).
+            final Vector3f rgb = color(new Vector3f(target.red(), target.green(), target.blue()), dimension, level.getOverworldClockTime());
+            target = target.withColor(rgb.x, rgb.y, rgb.z);
+        }
+        frame = advance(frame, target);
+        return frame == null ? null : new Vector3f(frame.red(), frame.green(), frame.blue());
+    }
+
+    /**
+     * Native 1.26.60.5 keeps the previous frame's air fog and moves it toward each new target. The first frame and a
+     * frame after a camera medium change take the target directly (0x145373cd6..0x145373d0f).
+     */
+    static @Nullable FogSetting advance(final @Nullable FogSetting previous, final @Nullable FogSetting target) {
+        if (target == null) return null;
+        return previous == null ? target : previous.toward(target, FogSetting.AIR_RATE);
+    }
+
+    /** The camera biome at each native sample position around the floored camera position. */
+    private static List<@Nullable String> biomes(final Camera camera, final ClientLevel level) {
+        final BlockPos origin = camera.blockPosition();
+        final var position = new BlockPos.MutableBlockPos();
+        final List<@Nullable String> biomes = new ArrayList<>(FogStack.BIOME_SAMPLES.length);
+        for (final int[] offset : FogStack.BIOME_SAMPLES) {
+            position.setWithOffset(origin, offset[0], offset[1], offset[2]);
+            biomes.add(level.getBiome(position).unwrapKey().map(key -> key.identifier().toString()).orElse(null));
+        }
+        return biomes;
+    }
+
+    private static boolean active(final @Nullable Dimension dimension, final Camera camera, final ClientLevel level) {
+        return owner != null && owner == Minecraft.getInstance().getConnection()
+            && supported(dimension, camera.getFluidInCamera(), level.getRainLevel(1F), level.getThunderLevel(1F));
+    }
+
+    public static boolean endSky() {
+        final var minecraft = Minecraft.getInstance();
+        return minecraft.level != null && BedrockLightmapExtractor.dimension(minecraft) == Dimension.END && frame != null;
+    }
+
+    static boolean supported(final @Nullable Dimension dimension, final FogType medium, final float rain, final float thunder) {
+        return dimension != null && medium == FogType.NONE && rain <= 0 && thunder <= 0;
+    }
+
+    public static Vector3f color(final Vector3f rgb, final Dimension dimension, final long time) {
+        if (dimension == Dimension.OVERWORLD) {
+            final float angle = BedrockLightmapMath.overworldAngle(time, 0F);
+            final float daylight = Mth.clamp((float) Math.cos(angle * ((float) Math.PI * 2F)) * 2F + 0.5F, 0F, 1F);
+            rgb.mul(daylight * 0.94F + 0.06F, daylight * 0.94F + 0.06F, daylight * 0.91F + 0.09F);
+        }
+        return rgb;
+    }
+
+    public static void applyDistance(final FogData fog, final Camera camera, final ClientLevel level, final float renderDistance) {
+        final Dimension dimension = BedrockLightmapExtractor.dimension(Minecraft.getInstance());
+        if (!active(dimension, camera, level)) return;
+        boolean livingDragon = false;
+        if (dimension == Dimension.END) {
+            // Native retains an admitted dragon across a distant teleport, until its actor lifetime ends.
+            for (final var entity : level.entitiesForRendering()) {
+                if (entity.getType() == EntityTypes.ENDER_DRAGON && entity.isAlive()) {
+                    livingDragon = true;
+                    break;
+                }
+            }
+        }
+        final Range range = range(dimension, livingDragon, frame, renderDistance);
+        if (range == null) return;
+        fog.environmentalStart = range.start;
+        fog.environmentalEnd = range.end;
+        fog.skyEnd = Math.min(renderDistance, range.end);
+        fog.cloudEnd = Math.min(fog.cloudEnd, range.end);
+    }
+
+    static @Nullable Range range(final @Nullable Dimension dimension, final boolean livingDragon,
+                                 final @Nullable FogSetting setting, final float renderDistance) {
+        if (dimension == null) return null;
+        final float distance = fogDistance(renderDistance);
+        // The dragon replaces distances with 0..100 even without a command, before the render distance cap.
+        // The ordinary color path remains intact.
+        if (dimension == Dimension.END && livingDragon) return cap(0, 100, distance);
+        return setting == null ? null : cap(setting.start(), setting.end(), distance);
+    }
+
+    /** Native fog reaches the render distance in blocks less a margin of 1/16, 8 or 16 blocks. */
+    static float fogDistance(final float renderDistance) {
+        final float margin = renderDistance <= 64 ? renderDistance / 16F : renderDistance <= 80 ? 8F : 16F;
+        return renderDistance - margin;
+    }
+
+    /** Native final fog keeps the end within 0..distance and starts at least 4 to 96 blocks before it. */
+    private static Range cap(final float start, final float end, final float distance) {
+        final float startLimit = distance - Mth.clamp((distance - 40F) * 0.5F, 4F, 96F);
+        return new Range(Math.min(start, startLimit), Mth.clamp(end, 0F, distance));
+    }
+
+    record Range(float start, float end) {
+    }
+}
