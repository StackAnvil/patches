+package com.viaversion.viafabricplus.bedrock.render.fog;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.FogState;
+
+public record FogPayload(FogState state) implements CustomPacketPayload {
+    public static final Type<FogPayload> TYPE = new Type<>(Identifier.parse(FogState.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, FogPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> FogState.TYPE.write(buffer, payload.state),
+            buffer -> new FogPayload(FogState.TYPE.read(buffer)));
+
+    @Override
+    public Type<FogPayload> type() {
+        return TYPE;
+    }
+}
