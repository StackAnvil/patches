From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:02:10 +0100
Subject: [PATCH] fix(chat): hide the unverifiable chat toast on Bedrock
 servers

Every join to a Bedrock server showed Java's "Chat messages can't be
verified" toast. ViaBedrock reports that the server does not enforce
secure chat, which is accurate, but Bedrock has no chat signing at all
and the native client never shows such a notice. Skip the toast on
Bedrock connections; other targets keep it.

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/chat/MixinInsecureChatToast.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/chat/MixinInsecureChatToast.java
new file mode 100644
index 0000000000000000000000000000000000000000..c58cd91f77cae963cf551c2ce37d9ece9485cddb
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/chat/MixinInsecureChatToast.java
@@ -0,0 +1,27 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.chat;
+
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.client.gui.components.toasts.Toast;
+import net.minecraft.client.gui.components.toasts.ToastManager;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+/** Bedrock has no chat signing, so the Java notice about unverifiable chat does not apply to Bedrock servers. */
+@Mixin(ClientPacketListener.class)
+public abstract class MixinInsecureChatToast {
+
+    @WrapOperation(method = "handleLogin", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/gui/components/toasts/ToastManager;addToast(Lnet/minecraft/client/gui/components/toasts/Toast;)V"),
+            require = 1, allow = 1)
+    private void hideInsecureChatToast(final ToastManager toasts, final Toast toast, final Operation<Void> original) {
+        if (!BedrockInputPermissions.isBedrockConnection()) original.call(toasts, toast);
+    }
+}
diff --git a/src/main/resources/viafabricplus-bedrock.mixins.json b/src/main/resources/viafabricplus-bedrock.mixins.json
index 11884a554fceef63a2b3c81896ad014f21e104a0..8217157a5ddf8538f6b888e628dc2903fa84d49a 100644
--- a/src/main/resources/viafabricplus-bedrock.mixins.json
+++ b/src/main/resources/viafabricplus-bedrock.mixins.json
@@ -9,6 +9,7 @@
     "features.misc.MixinPauseScreenDressingRoom",
     "features.render.MixinDownloadedPackSourceDownloader",
     "features.render.MixinDownloadedPackSourceProgress",
+    "features.chat.MixinInsecureChatToast",
     "features.screen.GuiGraphicsExtractorAccess",
     "compat.moreculling.MixinMoreCullingOcclusion",
     "compat.emf.MixinEmfModelRoots",
