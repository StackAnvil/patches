+public final class ParticleViewDistanceScreen extends VFPScreen {
+    private final ParticleViewDistanceSetting setting;
+
+    public ParticleViewDistanceScreen(final ParticleViewDistanceSetting setting) {
+        super(setting.name(), true);
+        this.setting = setting;
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        final int sliderWidth = Math.min(300, this.width - 40);
+        this.addRenderableWidget(new DistanceSlider((this.width - sliderWidth) / 2, this.height / 2 - 10,
+                sliderWidth, this.setting));
+        this.addFooter(Button.builder(Component.translatable("controls.reset"), _ -> {
+            this.setting.set(NativeParticleRange.DEFAULT_VIEW_DISTANCE);
+            this.rebuildWidgets();
+        }).build(), Button.builder(Component.translatable("gui.done"), _ -> this.onClose()).build());
+    }
+
+    @Override
+    public void extractRenderState(final @NonNull GuiGraphicsExtractor graphics, final int mouseX,
+                                   final int mouseY, final float partialTick) {
+        super.extractRenderState(graphics, mouseX, mouseY, partialTick);
+        this.renderScreenTitle(graphics);
+    }
+
+    private static final class DistanceSlider extends AbstractSliderButton {
+        private final ParticleViewDistanceSetting setting;
+
+        private DistanceSlider(final int x, final int y, final int width, final ParticleViewDistanceSetting setting) {
+            super(x, y, width, 20, Component.empty(), setting.value());
+            this.setting = setting;
+            this.updateMessage();
+        }
+
+        @Override
+        protected void updateMessage() {
+            this.setMessage(Component.translatable("options.generic_value", this.setting.name(), this.setting.percentage()));
+        }
+
+        @Override
+        protected void applyValue() { this.setting.set((float) this.value); }
+    }
+}
