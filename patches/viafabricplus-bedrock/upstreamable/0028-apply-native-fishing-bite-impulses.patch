+package com.viaversion.viafabricplus.bedrock.settings;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class ParticleViewDistanceSettingTest {
+    @Test
+    void persistsContinuousValuesWithoutRounding() {
+        final var setting = new ParticleViewDistanceSetting();
+        setting.set(0.37251F);
+        final var json = new JsonObject();
+        setting.write(json);
+        final var loaded = new ParticleViewDistanceSetting();
+        loaded.read(json);
+        assertEquals(0.37251F, loaded.value());
+        loaded.set(2F);
+        loaded.write(json);
+        setting.read(json);
+        assertEquals(1F, setting.value());
+        loaded.set(-1F);
+        loaded.write(json);
+        setting.read(json);
+        assertEquals(0F, setting.value());
+    }
+
+    @Test
+    void retainsStateWhenSavedDataIsMissingOrHasAnInvalidType() {
+        final var setting = new ParticleViewDistanceSetting();
+        setting.set(0.5F);
+        final var json = new JsonObject();
+        setting.write(json);
+        final String key = json.keySet().iterator().next();
+        for (final var invalid : new com.google.gson.JsonElement[]{JsonNull.INSTANCE, new JsonObject(), new JsonArray(), new JsonPrimitive(true)}) {
+            json.add(key, invalid);
+            setting.read(json);
+            assertEquals(0.5F, setting.value());
+        }
+        setting.read(new JsonObject());
+        assertEquals(0.5F, setting.value());
+    }
+}
