 /** Server effects use accepted native resources, with their complete Java translation as a fallback. */
 public final class BedrockServerParticles {
+    private static final BedrockParticlePending FISHING_RESOURCES = new BedrockParticlePending(32);
+
     private BedrockServerParticles() {}
 
+    /** Fishing effects sample the current local hook and remain fixed in world space. */
+    public static void fishingEvent(final FishingHook hook, final NativeFishingEvent message) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        final ClientLevel level = minecraft.level;
+        if (level == null || hook.isRemoved() || level.getEntity(hook.getId()) != hook) return;
+        final Position3f position = new Position3f((float) hook.getX(), (float) hook.getY(), (float) hook.getZ());
+        final float boxMinY = (float) hook.getBoundingBox().minY;
+        final Position3f waterPosition = message.waterPosition(position, boxMinY);
+        final var block = level.getBlockState(new BlockPos((int) waterPosition.x(), (int) waterPosition.y(), (int) waterPosition.z()));
+        final boolean water = block.is(Blocks.WATER);
+        final float sample = message.kind() == NativeFishingEvent.Kind.APPROACH ? level.getRandom().nextFloat() : 0F;
+        final var camera = minecraft.gameRenderer.mainCamera();
+        final var cameraPosition = camera.position();
+        final Position3f renderedCamera = camera.isInitialized() ? new Position3f((float) cameraPosition.x(),
+                (float) cameraPosition.y(), (float) cameraPosition.z()) : null;
+        final List<NativeFishingEvent.Emission> effects = message.particles(position, boxMinY, hook.getBbWidth(), sample, water)
+                .stream().filter(effect -> !effect.legacy() || NativeParticleRange.contains(effect.origin(), renderedCamera,
+                        minecraft.options.renderDistance().get(), ViaFabricPlusBedrock.impl().settings().particleViewDistance().value(), false))
+                .toList();
+        if (effects.isEmpty()) return;
+        if (!FISHING_RESOURCES.acquire()) {
+            for (final var effect : effects) fishingFallback(effect, level);
+            return;
+        }
+        final ResourceManager manager = minecraft.getResourceManager();
+        final long generation = BedrockServerResources.generation();
+        final var prepared = new CompletableFuture<FishingParticles>();
+        prepared.whenCompleteAsync((particles, error) -> {
+            FISHING_RESOURCES.release();
+            if (minecraft.level != level || minecraft.getResourceManager() != manager
+                    || BedrockServerResources.generation() != generation) return;
+            if (error != null) {
+                ViaFabricPlusBedrock.impl().logger().debug("Could not prepare fishing particle resources", error);
+                for (final var effect : effects) fishingFallback(effect, level);
+                return;
+            }
+            for (int index = 0; index < effects.size(); index++) {
+                final NativeFishingEvent.Emission effect = effects.get(index);
+                try {
+                    BedrockParticlePlayback.play(particles.resources(), effect.identifier(), particles.environments().get(index),
+                            null, position(effect.origin()), null).whenComplete((started, failure) -> minecraft.execute(() -> {
+                        if (failure != null || !Boolean.TRUE.equals(started)) fishingFallback(effect, level);
+                    }));
+                } catch (RuntimeException unavailable) {
+                    ViaFabricPlusBedrock.impl().logger().debug("Could not start fishing particle {}", effect, unavailable);
+                    fishingFallback(effect, level);
+                }
+            }
+        }, minecraft::execute);
+        try {
+            Thread.ofVirtual().name("Bedrock fishing resources").start(() -> {
+                try {
+                    final var resources = BedrockServerResources.library(manager, BedrockBuiltinAssets.load());
+                    final List<BedrockMolang> environments = effects.stream().map(effect -> {
+                        final var environment = new BedrockMolang();
+                        final Position3f direction = effect.direction();
+                        environment.variables(new MolangVariables(List.of(new MolangVariables.Member("variable.direction",
+                                new MolangVariables.Members(List.of(new MolangVariables.Member("x", new MolangVariables.Scalar(direction.x())),
+                                        new MolangVariables.Member("y", new MolangVariables.Scalar(direction.y())),
+                                        new MolangVariables.Member("z", new MolangVariables.Scalar(direction.z()))))))));
+                        return environment;
+                    }).toList();
+                    prepared.complete(new FishingParticles(resources, environments));
+                } catch (IOException | RuntimeException unavailable) {
+                    prepared.completeExceptionally(unavailable);
+                }
+            });
+        } catch (RuntimeException unavailable) {
+            prepared.completeExceptionally(unavailable);
+        }
+    }
+
+    private record FishingParticles(BedrockResourceLibrary resources, List<BedrockMolang> environments) {}
+
+    private static void fishingFallback(final NativeFishingEvent.Emission effect, final ClientLevel level) {
+        if (Minecraft.getInstance().level != level) return;
+        final var particle = switch (effect.identifier()) {
+            case "minecraft:water_wake_particle" -> ParticleTypes.FISHING;
+            case "minecraft:water_splash_particle" -> ParticleTypes.SPLASH;
+            default -> null;
+        };
+        if (particle != null) {
+            final Position3f origin = effect.origin();
+            final Position3f direction = effect.direction();
+            level.addParticle(particle, origin.x(), origin.y(), origin.z(), direction.x(), direction.y(), direction.z());
+        }
+    }
+
     public static void accept(final NativeParticlePlaybackMessage message) {
         final Minecraft minecraft = Minecraft.getInstance();
         if (!minecraft.isSameThread()) { minecraft.execute(() -> accept(message)); return; }
