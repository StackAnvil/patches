+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeFishingBite;
+
+public record NativeFishingBitePayload(NativeFishingBite message) implements CustomPacketPayload {
+    public static final Type<NativeFishingBitePayload> TYPE = new Type<>(Identifier.parse(NativeFishingBite.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeFishingBitePayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeFishingBite.TYPE.write(buffer, payload.message),
+            buffer -> new NativeFishingBitePayload(NativeFishingBite.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeFishingBitePayload> type() {
+        return TYPE;
+    }
+}
