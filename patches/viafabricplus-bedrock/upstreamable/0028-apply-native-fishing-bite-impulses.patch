+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeFishingEvent;
+
+public record NativeFishingEventPayload(NativeFishingEvent message) implements CustomPacketPayload {
+    public static final Type<NativeFishingEventPayload> TYPE = new Type<>(Identifier.parse(NativeFishingEvent.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeFishingEventPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeFishingEvent.TYPE.write(buffer, payload.message),
+            buffer -> new NativeFishingEventPayload(NativeFishingEvent.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeFishingEventPayload> type() {
+        return TYPE;
+    }
+}
