+package com.viaversion.viafabricplus.bedrock.settings;
+
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.api.settings.base.Setting;
+import net.minecraft.network.chat.Component;
+import net.raphimc.viabedrock.api.model.NativeParticleRange;
+
+/** The native option is continuous and ignores changes within its comparison tolerance. */
+public final class ParticleViewDistanceSetting implements Setting {
+    private static final String KEY = "particle_view_distance";
+    private float value = NativeParticleRange.DEFAULT_VIEW_DISTANCE;
+
+    public float value() { return this.value; }
+
+    public void set(final float requested) {
+        this.value = NativeParticleRange.updateViewDistance(this.value, requested);
+    }
+
+    public Component percentage() {
+        return Component.literal((Math.round(this.value * 1000F) / 10F) + "%");
