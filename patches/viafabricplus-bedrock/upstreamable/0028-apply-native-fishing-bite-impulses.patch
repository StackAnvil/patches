+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockServerParticles;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.minecraft.world.entity.projectile.FishingHook;
+import net.raphimc.viabedrock.api.model.NativeFishingBite;
+
+/** The translated hook receives the native impulse without Java's unrelated biting timer. */
+public final class BedrockFishingFeedback {
+    private BedrockFishingFeedback() {}
+
+    public static void accept(final Connection connection, final NativeFishingBite message) {
+        final Minecraft client = Minecraft.getInstance();
+        client.execute(() -> {
+            final var listener = client.getConnection();
+            if (!connection.isConnected() || listener == null || listener.getConnection() != connection || client.level == null) return;
+            final var entity = client.level.getEntity(message.entityId());
+            if (!(entity instanceof FishingHook hook) || hook.isRemoved() || !message.uuid().equals(hook.getUUID())) return;
+            final var motion = hook.getDeltaMovement();
+            hook.setDeltaMovement(motion.x(), NativeFishingBite.verticalVelocity(motion.y()), motion.z());
+            BedrockServerParticles.fishingBite(hook);
+        });
+    }
+}
