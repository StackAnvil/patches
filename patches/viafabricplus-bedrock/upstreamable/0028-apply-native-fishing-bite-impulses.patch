+public final class ParticleViewDistanceEntry extends VFPListEntry {
+    private final ParticleViewDistanceSetting setting;
+
+    public ParticleViewDistanceEntry(final ParticleViewDistanceSetting setting) { this.setting = setting; }
+
+    @Override
+    public @NonNull Component getNarration() {
+        return Component.translatable("options.generic_value", this.setting.name(), this.setting.percentage());
+    }
+
+    @Override
+    public void mappedMouseClicked() {
+        new ParticleViewDistanceScreen(this.setting).open(Minecraft.getInstance().gui.screen());
+    }
+
+    @Override
+    public void mappedRender(final GuiGraphicsExtractor graphics, final int entryWidth, final int entryHeight) {
+        final var font = Minecraft.getInstance().font;
+        final var value = this.setting.percentage();
+        final int offset = font.width(value) + 2;
+        this.renderScrollableText(graphics, this.setting.name().copy().withStyle(ChatFormatting.GRAY), offset);
+        graphics.text(font, value, entryWidth - offset, (entryHeight - font.lineHeight) / 2, VFPScreen.ACCENT_COLOR);
+    }
+}
