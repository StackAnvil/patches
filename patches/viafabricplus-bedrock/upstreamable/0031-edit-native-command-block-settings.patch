+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.screens.inventory.CommandBlockEditScreen;
+import net.minecraft.core.BlockPos;
+import net.minecraft.network.Connection;
+import net.minecraft.network.protocol.game.ServerboundContainerClosePacket;
+import net.minecraft.world.level.block.entity.CommandBlockEntity;
+import net.raphimc.viabedrock.api.model.CommandBlockOpen;
+
+public final class BedrockCommandBlockScreen extends CommandBlockEditScreen {
+    private final Connection connection;
+    private final byte containerId;
+    private boolean serverClosed;
+
+    private BedrockCommandBlockScreen(final CommandBlockEntity block, final Connection connection, final byte containerId) {
+        super(block);
+        this.connection = connection;
+        this.containerId = containerId;
+    }
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(CommandBlockOpenPayload.TYPE, CommandBlockOpenPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+                ClientPlayNetworking.registerReceiver(CommandBlockOpenPayload.TYPE, (payload, context) -> {
+                    if (context.client().getConnection() == listener) accept(context.client(), payload.message());
+                }));
+    }
+
+    private static void accept(final Minecraft client, final CommandBlockOpen message) {
+        if (!BedrockInputPermissions.isBedrockConnection() || client.getConnection() == null || client.level == null) return;
+        if (!message.open()) {
+            if (client.gui.screen() instanceof BedrockCommandBlockScreen screen && screen.containerId == message.containerId()) {
+                screen.serverClosed = true;
+                client.setScreenAndShow(null);
+            }
+            return;
+        }
+        final var position = message.position();
+        if (!(client.level.getBlockEntity(new BlockPos(position.x(), position.y(), position.z())) instanceof CommandBlockEntity block)) {
+            client.getConnection().send(new ServerboundContainerClosePacket(Byte.toUnsignedInt(message.containerId())));
+            return;
+        }
+        final var screen = new BedrockCommandBlockScreen(block, client.getConnection().getConnection(), message.containerId());
+        client.setScreenAndShow(screen);
+        screen.updateGui();
+    }
+
+    @Override
+    public void removed() {
+        super.removed();
+        if (!this.serverClosed && this.minecraft.getConnection() != null
+                && this.minecraft.getConnection().getConnection() == this.connection) {
+            this.minecraft.getConnection().send(new ServerboundContainerClosePacket(Byte.toUnsignedInt(this.containerId)));
+        }
+    }
+}
