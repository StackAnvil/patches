+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.CommandBlockEdit;
+
+public record CommandBlockEditPayload(CommandBlockEdit edit) implements CustomPacketPayload {
+    public static final Type<CommandBlockEditPayload> TYPE = new Type<>(Identifier.parse(CommandBlockEdit.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, CommandBlockEditPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> CommandBlockEdit.TYPE.write(buffer, payload.edit),
+            buffer -> new CommandBlockEditPayload(CommandBlockEdit.TYPE.read(buffer)));
+    @Override public Type<CommandBlockEditPayload> type() { return TYPE; }
+}
