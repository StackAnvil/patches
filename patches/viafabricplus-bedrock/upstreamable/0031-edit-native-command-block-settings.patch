+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.inventory;
+
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockCommandBlockSettings;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.screen.CommandBlockEditPayload;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.gui.components.CycleButton;
+import net.minecraft.client.gui.components.EditBox;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.screens.inventory.AbstractCommandBlockEditScreen;
+import net.minecraft.client.gui.screens.inventory.CommandBlockEditScreen;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.level.block.entity.CommandBlockEntity;
+import net.raphimc.viabedrock.api.model.CommandBlockEdit;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(CommandBlockEditScreen.class)
+public abstract class MixinBedrockCommandBlockScreen extends AbstractCommandBlockEditScreen {
+    @Shadow private CommandBlockEntity autoCommandBlock;
+    @Shadow private CommandBlockEntity.Mode mode;
+    @Shadow private boolean conditional;
+    @Shadow private boolean autoexec;
+    @Unique private EditBox viaFabricPlusBedrock$tickDelay;
+    @Unique private CycleButton<Boolean> viaFabricPlusBedrock$firstTick;
+    @Unique private boolean viaFabricPlusBedrock$initialized;
+    @Unique private String viaFabricPlusBedrock$validDelay = "0";
+
+    @Inject(method = "addExtraControls", at = @At("TAIL"))
+    private void addNativeControls(final CallbackInfo ci) {
+        if (!BedrockInputPermissions.isBedrockConnection() || !ClientPlayNetworking.canSend(CommandBlockEditPayload.TYPE)) return;
+        final var settings = (IBedrockCommandBlockSettings) this.autoCommandBlock;
+        final String delay = this.viaFabricPlusBedrock$tickDelay == null
+                ? Integer.toString(settings.viaFabricPlusBedrock$tickDelay()) : this.viaFabricPlusBedrock$tickDelay.getValue();
+        final boolean first = this.viaFabricPlusBedrock$firstTick == null
+                ? settings.viaFabricPlusBedrock$executeOnFirstTick() : this.viaFabricPlusBedrock$firstTick.getValue();
+        this.viaFabricPlusBedrock$tickDelay = this.addRenderableWidget(new EditBox(this.font,
+                this.width / 2 - 150, 200, 100, 20, Component.translatable("command_block.viafabricplus.tick_delay")));
+        this.viaFabricPlusBedrock$tickDelay.setMaxLength(10);
+        this.viaFabricPlusBedrock$validDelay = delay;
+        this.viaFabricPlusBedrock$tickDelay.setResponder(value -> {
+            if (value.isEmpty() || validDelay(value)) this.viaFabricPlusBedrock$validDelay = value;
+            else this.viaFabricPlusBedrock$tickDelay.setValue(this.viaFabricPlusBedrock$validDelay);
+        });
+        this.viaFabricPlusBedrock$tickDelay.setValue(delay);
+        this.viaFabricPlusBedrock$firstTick = this.addRenderableWidget(CycleButton.booleanBuilder(
+                Component.translatable("options.on"), Component.translatable("options.off"), first).create(
+                this.width / 2 - 40, 200, 190, 20, Component.translatable("command_block.viafabricplus.first_tick"), (button, value) -> {}));
+    }
+
+    @Inject(method = "init", at = @At("TAIL"))
+    private void leaveRoomForNativeControls(final CallbackInfo ci) {
+        if (this.viaFabricPlusBedrock$tickDelay == null) return;
+        final int actionsY = Math.max(this.doneButton.getY(), this.viaFabricPlusBedrock$tickDelay.getBottom() + 12);
+        this.doneButton.setY(actionsY);
+        this.cancelButton.setY(actionsY);
+    }
+
+    @Unique private static boolean validDelay(final String value) {
+        try { return !value.startsWith("-") && Integer.parseInt(value) >= 0; }
+        catch (final NumberFormatException invalid) { return false; }
+    }
+
+    @Inject(method = "updateGui", at = @At("TAIL"))
+    private void refreshNativeSettings(final CallbackInfo ci) {
+        if (this.viaFabricPlusBedrock$tickDelay == null || this.viaFabricPlusBedrock$initialized) return;
+        final var settings = (IBedrockCommandBlockSettings) this.autoCommandBlock;
+        this.viaFabricPlusBedrock$tickDelay.setValue(Integer.toString(settings.viaFabricPlusBedrock$tickDelay()));
+        this.viaFabricPlusBedrock$firstTick.setValue(settings.viaFabricPlusBedrock$executeOnFirstTick());
+        this.viaFabricPlusBedrock$initialized = true;
+    }
+
+    @Inject(method = "populateAndSendPacket", at = @At("HEAD"), cancellable = true)
+    private void sendNativeEdit(final CallbackInfo ci) {
+        if (!BedrockInputPermissions.isBedrockConnection() || this.viaFabricPlusBedrock$tickDelay == null) return;
+        final var position = this.autoCommandBlock.getBlockPos();
+        final String delay = this.viaFabricPlusBedrock$tickDelay.getValue();
+        ClientPlayNetworking.send(new CommandBlockEditPayload(new CommandBlockEdit(
+                new BlockPosition(position.getX(), position.getY(), position.getZ()), this.commandEdit.getValue(),
+                this.mode.ordinal(), this.autoCommandBlock.getCommandBlock().isTrackOutput(), this.conditional, this.autoexec,
+                delay.isEmpty() ? 0 : Integer.parseInt(delay), this.viaFabricPlusBedrock$firstTick.getValue())));
+        ci.cancel();
+    }
+
+    @Override
+    public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float delta) {
+        super.extractRenderState(graphics, mouseX, mouseY, delta);
+        if (this.viaFabricPlusBedrock$tickDelay != null) {
+            graphics.text(this.font, Component.translatable("command_block.viafabricplus.tick_delay"), this.width / 2 - 150, 189, 0xFFA0A0A0, false);
+        }
+    }
+}
