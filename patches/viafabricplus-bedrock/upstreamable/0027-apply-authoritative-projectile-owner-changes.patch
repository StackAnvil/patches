--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockProjectileOwners.java
@@ -0,0 +1,67 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.entity.projectile.FishingHook;
+import net.minecraft.world.entity.projectile.Projectile;
+import net.raphimc.viabedrock.api.model.NativeProjectileOwnerMessage;
+import net.raphimc.viabedrock.api.model.NativeProjectileOwners;
+
+/** Connection-scoped owner changes for direct and remote ViaBedrock translations. */
+public final class BedrockProjectileOwners {
+    private static final NativeProjectileOwners<Entity> OWNERS = new NativeProjectileOwners<>(BedrockProjectileOwners::lookup,
+            BedrockProjectileOwners::assign);
+    private static volatile long generation;
+
+    private BedrockProjectileOwners() {}
+
+    public static void accept(final Connection connection, final NativeProjectileOwnerMessage message) {
+        final long receivedGeneration = generation;
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (generation == receivedGeneration && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                OWNERS.apply(message);
+            }
+        });
+    }
+
+    public static void actorSpawned(final Entity entity) {
+        OWNERS.actorSpawned(entity.getId(), entity.getUUID());
+    }
+
+    public static void actorRemoved(final Entity entity) {
+        OWNERS.actorRemoved(entity.getId(), entity.getUUID(), entity);
+    }
+
+    public static void clear() {
+        generation++;
+        OWNERS.clear();
+    }
+
+    private static Entity lookup(final NativeProjectileOwnerMessage.Target reference) {
+        final Minecraft client = Minecraft.getInstance();
+        final Entity entity = client.level == null ? null : client.level.getEntity(reference.entityId());
+        if (entity == null || entity.isRemoved()) {
+            return null;
+        }
+        return reference.localPlayer() ? entity == client.player ? entity : null
+                : reference.uuid().equals(entity.getUUID()) ? entity : null;
+    }
+
+    private static void assign(final Entity source, final Entity owner) {
+        if (source instanceof Projectile projectile) {
+            if (projectile instanceof FishingHook hook && projectile.getOwner() instanceof Player previous && previous.fishing == hook) {
+                previous.fishing = null;
+            }
+            projectile.setOwner(owner);
+        }
+    }
+}
