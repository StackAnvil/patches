+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.entities;
+
+import com.llamalad7.mixinextras.injector.WrapWithCondition;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.world.entity.projectile.FishingHook;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(FishingHook.class)
+public abstract class MixinFishingHookOwner {
+    /** Bedrock supplies actor removal; an unavailable owner must not erase a pending bobber. */
+    @WrapWithCondition(method = {"recreateFromPacket", "tick"}, at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/world/entity/projectile/FishingHook;discard()V", ordinal = 0))
+    private boolean retainBedrockBobberWithoutOwner(final FishingHook hook) {
+        return !BedrockInputPermissions.isBedrockConnection() || !hook.level().isClientSide() || hook.getPlayerOwner() != null;
+    }
+}
