From 18ca2d0ba52aaa294673e51b12ea89bee5a4a4cb Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:56:49 +0200
Subject: [PATCH] fix(bedrock): select the bound persona face geometry

The skin resource patch can identify the animated face model explicitly. Use that identifier when multiple face definitions share a geometry payload so the renderer does not choose an unrelated face or drop a valid skin. Keep the existing unique-face fallback for skins without a face binding.
---
 .../bedrock/render/BedrockPlayerSkins.java    | 19 ++++--
 .../render/BedrockPersonaGeometryTest.java    | 68 +++++++++++++------
 2 files changed, 59 insertions(+), 28 deletions(-)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
index 9bd4fe0..ad795c6 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockPlayerSkins.java
@@ -170,9 +170,15 @@ public final class BedrockPlayerSkins {
     }
 
     private static String geometryName(final SkinData skin) {
+        return geometryName(skin.skinResourcePatch(), "default");
+    }
+
+    static String geometryName(final String resourcePatch, final String binding) {
         try {
-            return JsonParser.parseString(skin.skinResourcePatch()).getAsJsonObject()
-                .getAsJsonObject("geometry").get("default").getAsString();
+            final var geometry = JsonParser.parseString(resourcePatch).getAsJsonObject().getAsJsonObject("geometry");
+            final var name = geometry.get(binding);
+            return name != null && name.isJsonPrimitive() && name.getAsJsonPrimitive().isString()
+                ? name.getAsString() : "";
         } catch (RuntimeException e) {
             return "";
         }
@@ -181,7 +187,8 @@ public final class BedrockPlayerSkins {
     private static Geometry geometry(final SkinData skin) {
         final String name = geometryName(skin);
         if (skin.persona()) {
-            return personaGeometry(name, skin.geometryData(), skin.skinData(), skin.animations());
+            return personaGeometry(name, geometryName(skin.skinResourcePatch(), "animated_face"),
+                skin.geometryData(), skin.skinData(), skin.animations());
         }
         if ("geometry.humanoid.custom".equalsIgnoreCase(name) || "geometry.humanoid.customSlim".equalsIgnoreCase(name)) {
             // These are Bedrock's standard Steve and Alex models. Minecraft's
@@ -203,8 +210,8 @@ public final class BedrockPlayerSkins {
         }
     }
 
-    static Geometry personaGeometry(final String name, final String geometryData, final BufferedImage skinImage,
-                                    final List<SkinData.AnimationData> animations) {
+    static Geometry personaGeometry(final String name, final String faceName, final String geometryData,
+                                    final BufferedImage skinImage, final List<SkinData.AnimationData> animations) {
         if (name.isBlank() || geometryData == null || geometryData.isBlank() || !supportedImage(skinImage)) {
             return null;
         }
@@ -226,7 +233,7 @@ public final class BedrockPlayerSkins {
                         return null;
                     }
                     body = model.deepCopy();
-                } else if (identifier.startsWith("geometry.animated_face_")) {
+                } else if (faceName.isEmpty() ? identifier.startsWith("geometry.animated_face_") : faceName.equals(identifier)) {
                     if (face != null) {
                         return null;
                     }
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaGeometryTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaGeometryTest.java
index a722d20..88e06cb 100644
--- a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaGeometryTest.java
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockPersonaGeometryTest.java
