+            for (final boolean dimming : new boolean[]{false, true}) {
+                final Samples result = sample(level, Blocks.STONE.defaultBlockState(), new CustomBlockLighting(strength, dimming),
+                        Direction.UP, Direction.DOWN, positions);
+                for (int vertex = 0; vertex < 4; vertex++) {
+                    assertEquals(light[vertex], result.light()[vertex]);
+                    assertEquals((float) Math.pow(ambient[vertex] * (dimming ? CardinalLighting.DEFAULT.down() : 1F), strength),
+                            result.shade()[vertex], 1E-7F);
+                }
+            }
+        }
+    }
+
+    private static Samples sample(final BlockAndTintGetter level, final BlockState state, final CustomBlockLighting material,
+                                  final Direction face, final Direction shadeDirection, final float[][] positions) {
+        final int[] light = new int[4];
+        final float[] shade = new float[4];
+        BedrockTerrainLighting.prepare(level, state, BlockPos.ZERO, material, face, shadeDirection,
+                (vertex, axis) -> positions[vertex][axis], (vertex, value, brightness) -> {
+                    light[vertex] = value;
+                    shade[vertex] = brightness;
+                });
+        return new Samples(light, shade);
+    }
+
+    private static BlockAndTintGetter level(final boolean constant) {
+        return (BlockAndTintGetter) Proxy.newProxyInstance(BlockAndTintGetter.class.getClassLoader(), new Class<?>[]{BlockAndTintGetter.class},
+                (_, method, arguments) -> switch (method.getName()) {
+                    case "cardinalLighting" -> CardinalLighting.DEFAULT;
+                    case "getBlockState" -> Blocks.AIR.defaultBlockState();
+                    case "getBrightness" -> {
+                        final BlockPos pos = (BlockPos) arguments[1];
+                        yield constant ? arguments[0] == LightLayer.SKY ? 3 : 0
+                                : Math.floorMod(pos.getX() * 7 + pos.getY() * 3 + pos.getZ() * 11 + (arguments[0] == LightLayer.SKY ? 5 : 1), 16);
+                    }
+                    default -> throw new UnsupportedOperationException(method.getName());
+                });
+    }
+
+    private static List<int[]> permutations() {
+        final List<int[]> result = new ArrayList<>();
+        for (int first = 0; first < 4; first++) for (int second = 0; second < 4; second++)
+            for (int third = 0; third < 4; third++) for (int fourth = 0; fourth < 4; fourth++)
+                if (first != second && first != third && first != fourth && second != third && second != fourth && third != fourth)
+                    result.add(new int[]{first, second, third, fourth});
+        return result;
+    }
+
+    private record Samples(int[] light, float[] shade) {
+
+    }
