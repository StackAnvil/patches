+
+class BedrockTerrainLightingTest {
+
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void mapsPhysicalCornersIndependentlyOfVertexOrderAcrossEveryFace() {
+        final BlockAndTintGetter level = level(false);
+        final CustomBlockLighting material = new CustomBlockLighting(2F, true);
+        for (final Direction face : Direction.values()) {
+            final int axis = face.getAxis().ordinal();
+            final int inner = axis == 0 ? 2 : 0, outer = axis == 1 ? 2 : 1;
+            for (final float plane : new float[]{0F, 0.5F, 1F}) {
+                final float[][] positions = new float[4][3];
+                for (int vertex = 0; vertex < 4; vertex++) {
