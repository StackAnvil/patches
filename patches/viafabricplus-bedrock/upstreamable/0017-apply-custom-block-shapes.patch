+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static net.raphimc.viabedrock.api.model.CustomBlockCulling.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockCustomCullingTest {
+
+    @Test
+    void preservesIndependentIdentityAndLayerConditionsAndOpaqueNeighborControl() {
+        final Definition own = definition("test:glass", "test:glass[lit=true]", "test:glass_layer");
+        final Definition sameBlock = definition("test:glass", "test:glass[lit=false]", "test:other_layer");
+        final Definition sameLayer = definition("test:other", "test:other", "test:glass_layer");
+        assertTrue(BedrockCustomCulling.hidden(own, sameBlock, false, rule(Condition.SAME_BLOCK, false)));
+        assertFalse(BedrockCustomCulling.hidden(own, sameBlock, false, rule(Condition.SAME_BLOCK_PERMUTATION, false)));
+        assertTrue(BedrockCustomCulling.hidden(own, own, false, rule(Condition.SAME_BLOCK_PERMUTATION, false)));
+        assertTrue(BedrockCustomCulling.hidden(own, sameLayer, false, rule(Condition.SAME_CULLING_LAYER, false)));
+        assertFalse(BedrockCustomCulling.hidden(own, sameBlock, false, rule(Condition.SAME_CULLING_LAYER, false)));
+        assertTrue(BedrockCustomCulling.hidden(own, null, true, rule(Condition.DEFAULT, true)));
+        assertFalse(BedrockCustomCulling.hidden(own, null, true, rule(Condition.DEFAULT, false)));
+        final Definition undefined = definition("", "", "minecraft:culling_layer.undefined");
+        assertFalse(BedrockCustomCulling.hidden(undefined, undefined, false, rule(Condition.SAME_CULLING_LAYER, false)));
+    }
+
+    @Test
+    void defaultComparisonRequiresOppositeFaceParticipationAndCompleteCoverage() {
+        final Definition own = new Definition("", "", "", Map.of(Direction.NORTH, List.of(new Rectangle(0, 0, 1, 0.5))), Set.of(Direction.NORTH));
+        final Definition neighbor = new Definition("", "", "", Map.of(Direction.SOUTH, List.of(new Rectangle(0, 0, 0.5, 1), new Rectangle(0.5, 0, 1, 0.5))), Set.of(Direction.SOUTH));
+        assertTrue(BedrockCustomCulling.hidden(own, neighbor, false, rule(Condition.DEFAULT, false)));
+        final Definition disabledOwn = new Definition("", "", "", own.slices(), Set.of());
+        assertFalse(BedrockCustomCulling.hidden(disabledOwn, neighbor, false, rule(Condition.DEFAULT, false)));
+        final Definition disabled = new Definition("", "", "", neighbor.slices(), Set.of());
+        assertFalse(BedrockCustomCulling.hidden(own, disabled, false, rule(Condition.DEFAULT, false)));
+        final Definition gap = new Definition("", "", "", Map.of(Direction.SOUTH, List.of(new Rectangle(0, 0, 0.49, 1), new Rectangle(0.5, 0, 1, 1))), Set.of(Direction.SOUTH));
+        assertFalse(BedrockCustomCulling.hidden(own, gap, false, rule(Condition.DEFAULT, false)));
+    }
+
+    private static Definition definition(final String identifier, final String permutation, final String layer) {
+        return new Definition(identifier, permutation, layer, Map.of(), Set.of());
+    }
+
+    private static Rule rule(final Condition condition, final boolean opaque) {
+        return new Rule(Direction.NORTH, condition, opaque);
+    }
+}
