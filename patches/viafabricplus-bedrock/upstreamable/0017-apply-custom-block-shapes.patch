+        final BlockState state = (BlockState) (Object) this;
+        if (BedrockCustomBlocks.current(state) != null) {
+            cir.setReturnValue(support.isSupporting(state, level, pos, direction));
+        }
+    }
+
+    @Inject(method = "isSuffocating", at = @At("HEAD"), cancellable = true)
+    private void customSuffocation(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().occluding() && Shapes.equal(visual.collision(pos), Shapes.block()));
+        }
+    }
+
+    @Inject(method = "getShadeBrightness", at = @At("HEAD"), cancellable = true)
+    private void customShade(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<Float> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().occluding() ? 0.2F : 1F);
+        }
+    }
+
+    @Inject(method = "getLightEmission", at = @At("HEAD"), cancellable = true)
+    private void customEmission(final CallbackInfoReturnable<Integer> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightEmission());
+        }
+    }
+
+    @Inject(method = "getLightDampening", at = @At("HEAD"), cancellable = true)
+    private void customDampening(final CallbackInfoReturnable<Integer> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightDampening());
+        }
+    }
+
+    @Inject(method = "propagatesSkylightDown", at = @At("HEAD"), cancellable = true)
+    private void customSkylight(final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightDampening() == 0);
+        }
+    }
+}
