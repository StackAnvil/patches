+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(BlockModelLighter.class)
+public abstract class MixinCustomBlockLighting {
+
+    @Inject(method = "prepareQuadAmbientOcclusion", at = @At("HEAD"), cancellable = true)
+    private void nativeAmbientCorners(final BlockAndTintGetter level, final BlockState state, final BlockPos pos,
+                                       final BakedQuad quad, final QuadInstance instance, final CallbackInfo ci) {
+        final CustomBlockLighting material = lighting(state, quad);
+        if (material != null) {
+            prepareNativeFace(level, state, pos, quad, instance, material);
+            ci.cancel();
+        }
+    }
+
+    @Inject(method = "prepareQuadFlat", at = @At("HEAD"), cancellable = true)
+    private void nativeFlatCorners(final BlockAndTintGetter level, final BlockState state, final BlockPos pos,
+                                         final int lightCoords, final BakedQuad quad, final QuadInstance instance, final CallbackInfo ci) {
+        final CustomBlockLighting material = lighting(state, quad);
+        if (material != null) {
+            // Use the authored material's corner inputs when Java selects flat lighting.
+            prepareNativeFace(level, state, pos, quad, instance, material);
+            ci.cancel();
+        }
+    }
+
+    @Unique
+    private static void prepareNativeFace(final BlockAndTintGetter level, final BlockState state, final BlockPos pos,
+                                          final BakedQuad quad, final QuadInstance instance, final CustomBlockLighting material) {
+        BedrockTerrainLighting.prepare(level, state, pos, material, quad.direction(), quad.materialInfo().shadeDirectionOverride(),
+                (vertex, axis) -> quad.position(vertex).get(axis), (vertex, light, shade) -> {
+                    instance.setLightCoords(vertex, light);
+                    instance.setColor(vertex, ARGB.gray(shade));
+                });
+    }
+
+    @Unique
+    private static CustomBlockLighting lighting(final BlockState state, final BakedQuad quad) {
+        return BedrockCustomBlocks.current(state) == null ? null : ((BedrockBlockFace) (Object) quad).viaFabricPlusBedrock$lighting();
+    }
+
+}
