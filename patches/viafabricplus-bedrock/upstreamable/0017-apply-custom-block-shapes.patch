+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.client.renderer.block.BlockAndTintGetter;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.util.LightCoordsUtil;
+import net.minecraft.world.level.LightLayer;
+import net.minecraft.world.level.block.state.BlockState;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.model.CustomBlockFaceLighting;
+import net.raphimc.viabedrock.api.model.CustomBlockLighting;
+
+/** Adapts client world and physical quad coordinates to the shared native corner calculation. */
+public final class BedrockTerrainLighting {
+
+    private BedrockTerrainLighting() {
+    }
+
+    public static void prepare(final BlockAndTintGetter level, final BlockState state, final BlockPos pos,
+                               final CustomBlockLighting material, final Direction faceDirection, final Direction shadeDirection,
+                               final Positions positions, final Corners output) {
+        final var direction = CustomBlockCulling.Direction.values()[faceDirection.ordinal()];
+        final int innerAxis = direction.axis() == 0 ? 2 : 0;
+        final int outerAxis = direction.axis() == 1 ? 2 : 1;
+        float minInner = Float.POSITIVE_INFINITY, maxInner = Float.NEGATIVE_INFINITY;
+        float minOuter = Float.POSITIVE_INFINITY, maxOuter = Float.NEGATIVE_INFINITY;
+        float bound = direction.positive() ? Float.NEGATIVE_INFINITY : Float.POSITIVE_INFINITY;
+        for (int i = 0; i < 4; i++) {
+            minInner = Math.min(minInner, positions.coordinate(i, innerAxis));
+            maxInner = Math.max(maxInner, positions.coordinate(i, innerAxis));
+            minOuter = Math.min(minOuter, positions.coordinate(i, outerAxis));
+            maxOuter = Math.max(maxOuter, positions.coordinate(i, outerAxis));
+            bound = direction.positive() ? Math.max(bound, positions.coordinate(i, direction.axis())) : Math.min(bound, positions.coordinate(i, direction.axis()));
+        }
+        final BlockPos.MutableBlockPos samplePos = new BlockPos.MutableBlockPos();
+        final var face = CustomBlockFaceLighting.sample(direction, CustomBlockFaceLighting.outerPlane(direction, bound), state.isSolidRender(),
+                nativeLight(level, state, pos), material, level.cardinalLighting().byFace(shadeDirection == null ? faceDirection : shadeDirection),
+                (x, y, z) -> {
+                    samplePos.setWithOffset(pos, x, y, z);
+                    final BlockState sample = level.getBlockState(samplePos);
+                    return new CustomBlockFaceLighting.Sample(nativeLight(level, sample, samplePos), sample.getShadeBrightness(level, samplePos), sample.isSolidRender());
+                });
+        final float middleInner = (minInner + maxInner) * 0.5F, middleOuter = (minOuter + maxOuter) * 0.5F;
+        for (int i = 0; i < 4; i++) {
+            final float inner = positions.coordinate(i, innerAxis), outer = positions.coordinate(i, outerAxis);
+            output.corner(i, face.corner(inner > middleInner, outer > middleOuter).light(), Math.clamp(face.shade(inner, outer), 0F, 1F));
+        }
+    }
+
+    private static int nativeLight(final BlockAndTintGetter level, final BlockState state, final BlockPos pos) {
+        return CustomBlockFaceLighting.withBlockEmission(LightCoordsUtil.pack(level.getBrightness(LightLayer.BLOCK, pos),
+                level.getBrightness(LightLayer.SKY, pos)), state.getLightEmission());
+    }
+
+    @FunctionalInterface
+    public interface Positions {
+
+        float coordinate(int vertex, int axis);
+
+    }
+
+    @FunctionalInterface
+    public interface Corners {
+
+        void corner(int vertex, int light, float shade);
+
+    }
+
+}
