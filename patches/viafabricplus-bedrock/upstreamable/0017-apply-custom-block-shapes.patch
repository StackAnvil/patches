+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.block;
+
+import com.viaversion.viafabricplus.bedrock.block.BedrockCustomBlocks;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.SupportType;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+@Mixin(BlockBehaviour.BlockStateBase.class)
+public abstract class MixinCustomBlockState {
+
+    @Inject(method = {"getShape(Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;)Lnet/minecraft/world/phys/shapes/VoxelShape;",
+        "getInteractionShape"}, at = @At("HEAD"), cancellable = true)
+    private void customSelection(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.selection());
+        }
+    }
+
+    @Inject(method = {"getShape(Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/phys/shapes/CollisionContext;)Lnet/minecraft/world/phys/shapes/VoxelShape;",
+        "getVisualShape"}, at = @At("HEAD"), cancellable = true)
+    private void customSelectionWithContext(final BlockGetter level, final BlockPos pos, final CollisionContext context, final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.selection());
+        }
+    }
+
+    @Inject(method = {"getCollisionShape(Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;)Lnet/minecraft/world/phys/shapes/VoxelShape;",
+        "getBlockSupportShape"}, at = @At("HEAD"), cancellable = true)
+    private void customCollision(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.collision());
+        }
+    }
+
+    @Inject(method = "getCollisionShape(Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/phys/shapes/CollisionContext;)Lnet/minecraft/world/phys/shapes/VoxelShape;",
+        at = @At("HEAD"), cancellable = true)
+    private void customCollisionWithContext(final BlockGetter level, final BlockPos pos, final CollisionContext context, final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.collision());
+        }
+    }
+
+    @Inject(method = "getOcclusionShape", at = @At("HEAD"), cancellable = true)
+    private void customOcclusion(final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.occlusion());
+        }
+    }
+
+    @Inject(method = "getFaceOcclusionShape", at = @At("HEAD"), cancellable = true)
+    private void customFaceOcclusion(final Direction direction, final CallbackInfoReturnable<VoxelShape> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.occlusion().getFaceShape(direction));
+        }
+    }
+
+    @Inject(method = {"canOcclude", "isSolidRender"}, at = @At("HEAD"), cancellable = true)
+    private void customOccluding(final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().occluding());
+        }
+    }
+
+    @Inject(method = "isCollisionShapeFullBlock", at = @At("HEAD"), cancellable = true)
+    private void customFullCollision(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.fullCollision());
+        }
+    }
+
+    @Inject(method = "hasLargeCollisionShape", at = @At("HEAD"), cancellable = true)
+    private void customLargeCollision(final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.largeCollision());
+        }
+    }
+
+    @Inject(method = "isFaceSturdy(Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;Lnet/minecraft/core/Direction;Lnet/minecraft/world/level/block/SupportType;)Z",
+        at = @At("HEAD"), cancellable = true)
+    private void customSupport(final BlockGetter level, final BlockPos pos, final Direction direction, final SupportType support, final CallbackInfoReturnable<Boolean> cir) {
+        final BlockState state = (BlockState) (Object) this;
+        if (BedrockCustomBlocks.current(state) != null) {
+            cir.setReturnValue(support.isSupporting(state, level, pos, direction));
+        }
+    }
+
+    @Inject(method = "isSuffocating", at = @At("HEAD"), cancellable = true)
+    private void customSuffocation(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().occluding() && visual.fullCollision());
+        }
+    }
+
+    @Inject(method = "getShadeBrightness", at = @At("HEAD"), cancellable = true)
+    private void customShade(final BlockGetter level, final BlockPos pos, final CallbackInfoReturnable<Float> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().occluding() ? 0.2F : 1F);
+        }
+    }
+
+    @Inject(method = "getLightEmission", at = @At("HEAD"), cancellable = true)
+    private void customEmission(final CallbackInfoReturnable<Integer> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightEmission());
+        }
+    }
+
+    @Inject(method = "getLightDampening", at = @At("HEAD"), cancellable = true)
+    private void customDampening(final CallbackInfoReturnable<Integer> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightDampening());
+        }
+    }
+
+    @Inject(method = "propagatesSkylightDown", at = @At("HEAD"), cancellable = true)
+    private void customSkylight(final CallbackInfoReturnable<Boolean> cir) {
+        final var visual = BedrockCustomBlocks.current((BlockState) (Object) this);
+        if (visual != null) {
+            cir.setReturnValue(visual.definition().lightDampening() == 0);
+        }
+    }
+}
