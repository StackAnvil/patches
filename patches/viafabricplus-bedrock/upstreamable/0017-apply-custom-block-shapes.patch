+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.nbt.tag.CompoundTag;
+import net.minecraft.client.resources.model.cuboid.CuboidModel;
+import net.minecraft.client.resources.model.cuboid.UnbakedCuboidGeometry;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.CardinalLighting;
+import net.raphimc.viabedrock.protocol.rewriter.resourcepack.CustomBlockModel;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import java.io.StringReader;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockCustomBlockLightingTest {
+
+    @Test
+    void javaDecoderRetainsPerFaceDimmingWithoutFullbrightOrExtraFaces() {
+        final CompoundTag material = new CompoundTag();
+        material.putString("texture", "mushroom_block_skin_red");
+        final CompoundTag unshaded = material.copy();
+        unshaded.putByte("face_dimming", (byte) 0);
+        final CompoundTag materials = new CompoundTag();
+        materials.put("*", material);
+        materials.put("west", unshaded);
+        final CompoundTag components = new CompoundTag();
+        components.putString("minecraft:geometry", "minecraft:geometry.full_block");
+        components.put("minecraft:material_instances", materials);
+        final var visual = CustomBlockModel.compile(new ResourcePackStorage(List.of()), "test:block", 1, components);
+        final var model = CuboidModel.fromStream(new StringReader(visual.modelJson()));
+        final var geometry = (UnbakedCuboidGeometry) model.geometry();
+        assertEquals(2, geometry.elements().size());
+        int faceCount = 0;
+        for (final var element : geometry.elements()) {
+            faceCount += element.faces().size();
+            assertEquals(0, element.lightEmission());
+            assertEquals(0, element.from().x());
+            assertEquals(16, element.to().x());
+            if (element.faces().containsKey(Direction.WEST)) {
+                assertEquals(Direction.UP, element.shadeDirectionOverride());
+                assertEquals(1F, CardinalLighting.DEFAULT.byFace(element.shadeDirectionOverride()));
+                assertEquals(1, element.faces().size());
+            } else {
+                assertNull(element.shadeDirectionOverride());
+                assertEquals(5, element.faces().size());
+            }
+        }
+        assertEquals(6, faceCount);
+        assertEquals(0, visual.lightEmission());
+        assertTrue(model.ambientOcclusion());
+    }
+}
