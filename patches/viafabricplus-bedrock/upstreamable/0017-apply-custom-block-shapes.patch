+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.block;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.viaversion.viafabricplus.bedrock.block.BedrockCustomBlocks;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Cursor3D;
+import net.minecraft.world.level.BlockCollisions;
+import net.minecraft.world.level.BlockGetter;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(BlockCollisions.class)
+public abstract class MixinCustomBlockCollisions {
+    @Shadow @Final private Cursor3D cursor;
+    @Shadow @Final private BlockPos.MutableBlockPos pos;
+
+    @Shadow private BlockGetter getChunk(final int x, final int z) {
+        throw new AssertionError();
+    }
+
+    @ModifyExpressionValue(method = "computeNext", at = @At(value = "INVOKE", target = "Lnet/minecraft/core/Cursor3D;getNextType()I"))
+    private int customCollisionBoundary(final int original) {
+        if (original == 0 || !BedrockCustomBlocks.hasExtendedCollision()) return original;
+        final BlockGetter chunk = this.getChunk(this.cursor.nextX(), this.cursor.nextZ());
+        if (chunk == null) return original;
+        this.pos.set(this.cursor.nextX(), this.cursor.nextY(), this.cursor.nextZ());
+        final var visual = BedrockCustomBlocks.current(chunk.getBlockState(this.pos));
+        // Java excludes edge/corner cells except moving pistons. Native custom
+        // components can extend into these cells on several axes simultaneously.
+        return visual != null && visual.largeCollision() ? 0 : original;
+    }
+}
