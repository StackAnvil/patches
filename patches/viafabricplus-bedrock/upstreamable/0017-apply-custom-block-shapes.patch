+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.block;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.llamalad7.mixinextras.sugar.Local;
+import com.viaversion.viafabricplus.bedrock.block.BedrockCustomBlocks;
+import net.minecraft.client.renderer.block.BlockModelLighter;
+import net.minecraft.client.resources.model.geometry.BakedQuad;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.block.state.BlockState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+@Mixin(BlockModelLighter.class)
+public abstract class MixinCustomBlockLighting {
+
+    @ModifyExpressionValue(method = {"prepareQuadAmbientOcclusion", "prepareQuadFlat"}, at = @At(value = "INVOKE",
+        target = "Lnet/minecraft/client/renderer/block/BlockModelLighter;getDirectionalBrightness(Lnet/minecraft/world/level/CardinalLighting;Lnet/minecraft/client/resources/model/geometry/BakedQuad;Lnet/minecraft/core/Direction;)F"))
+    private float customDirectionalBrightness(final float original, @Local(argsOnly = true) final BlockState state,
+                                              @Local(argsOnly = true) final BakedQuad quad) {
+        // Converted custom models mark face_dimming=false with an upward override.
+        // Honor that explicit setting even when the dimension dims upward faces.
+        return quad.materialInfo().shadeDirectionOverride() == Direction.UP && BedrockCustomBlocks.current(state) != null ? 1F : original;
+    }
+}
