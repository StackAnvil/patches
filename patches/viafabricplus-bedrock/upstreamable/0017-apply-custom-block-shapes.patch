+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+import net.minecraft.core.Direction;
+import net.minecraft.core.BlockPos;
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual;
+import net.raphimc.viabedrock.api.model.CustomBlockProperties;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BedrockCustomBlocksTest {
+
+    @Test
+    void keepsSelectionWhenCollisionIsDisabledAndDoesNotOccludeCutoutGeometry() {
+        final CustomBlockProperties definition = definition(List.of(), List.of(box(0.25, 0, 0.25, 0.75, 0.5, 0.75)), false);
+        final var visual = BedrockCustomBlocks.visual(definition);
+
+        assertTrue(visual.collision().isEmpty());
+        assertFalse(visual.selection().isEmpty());
+        assertEquals(0.25, visual.selection().min(Direction.Axis.X));
+        assertEquals(0.5, visual.selection().max(Direction.Axis.Y));
+        assertTrue(visual.occlusion().isEmpty());
+        assertFalse(visual.fullCollision());
+        assertFalse(visual.largeCollision());
+    }
+
+    @Test
+    void retainsHolesAndRecognizesCollisionExtendingOutsideTheBlock() {
+        final var visual = BedrockCustomBlocks.visual(definition(List.of(
+            box(-0.25, 0, 0, 0.25, 1, 1), box(0.75, 0, 0, 1.25, 1, 1)), List.of(), false));
+
+        assertTrue(visual.largeCollision());
+        assertFalse(visual.fullCollision());
+        assertFalse(Shapes.joinIsNotEmpty(visual.collision(), Shapes.box(0.3, 0.1, 0.1, 0.7, 0.9, 0.9), BooleanOp.AND));
+        assertEquals(-0.25, visual.collision().min(Direction.Axis.X));
+        assertEquals(1.25, visual.collision().max(Direction.Axis.X));
+    }
+
+    @Test
+    void joinsOverlappingBoxesIntoAFullBlock() {
+        final var visual = BedrockCustomBlocks.visual(definition(List.of(
+            box(0, 0, 0, 0.5, 1, 1), box(0.5, 0, 0, 1, 1, 1),
+            box(0, 0, 0, 0.5, 1, 1)), List.of(), true));
+
+        assertTrue(visual.fullCollision());
+        assertFalse(visual.largeCollision());
+        assertTrue(Shapes.equal(Shapes.block(), visual.occlusion()));
+        assertTrue(Shapes.equal(Shapes.block(), visual.collision()));
+    }
+
+    @Test
+    void offsetsTerrainAndOutlinesContinuouslyButFloorsWorldCollision() {
+        final var offset = new CustomBlockOffset(new CustomBlockOffset.Axis(-0.125F, -0.125F, 0),
+            new CustomBlockOffset.Axis(0.125F, 0.125F, 0), new CustomBlockOffset.Axis(0.25F, 0.25F, 0));
+        final var bounds = box(0.25, 0, 0.25, 0.75, 0.5, 0.75);
+        final var definition = new CustomBlockProperties("test:block", 1, List.of(bounds), List.of(bounds), false, 0, 0, offset);
+        final var visual = BedrockCustomBlocks.visual(definition);
+        final BlockPos pos = new BlockPos(-17, 64, 93);
+        assertEquals(-0.125, visual.offset(pos).x);
+        assertEquals(0.125, visual.selection(pos).min(Direction.Axis.X));
+        assertEquals(0.125, visual.selection(pos).min(Direction.Axis.Y));
+        assertEquals(-0.75, visual.collision(pos).min(Direction.Axis.X));
+        assertEquals(0, visual.collision(pos).min(Direction.Axis.Y));
+        assertTrue(visual.largeCollision());
+        assertFalse(visual.fullCollision());
+        assertTrue(Shapes.equal(visual.selection(pos), visual.camera(pos)));
+        assertTrue(visual.occlusion().isEmpty());
+        final var remote = CustomBlockProperties.decode(CustomBlockProperties.encode(List.of(new CustomBlockVisual("test:block", 1,
+            "texture", "{}", "opaque", List.of(bounds), List.of(bounds), false, 0, 0, java.util.Map.of(), java.util.Map.of(), offset)))).get(1);
+        assertTrue(Shapes.equal(visual.collision(pos), BedrockCustomBlocks.visual(remote).collision(pos)));
+        assertEquals(visual.offset(pos), BedrockCustomBlocks.visual(remote).offset(pos));
+    }
+
+    private static CustomBlockProperties definition(final List<CustomBlockVisual.Box> collision, final List<CustomBlockVisual.Box> selection, final boolean occluding) {
+        return new CustomBlockProperties("test:block", 1, collision, selection, occluding, 0, 0, CustomBlockOffset.NONE);
+    }
+
+    private static CustomBlockVisual.Box box(final double minX, final double minY, final double minZ, final double maxX, final double maxY, final double maxZ) {
+        return new CustomBlockVisual.Box(minX, minY, minZ, maxX, maxY, maxZ);
+    }
+}
