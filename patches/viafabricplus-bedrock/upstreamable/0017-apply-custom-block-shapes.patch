+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.viafabricplus.ViaFabricPlus;
+import com.viaversion.viaversion.api.connection.UserConnection;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual;
+import net.raphimc.viabedrock.api.model.CustomBlockProperties;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Session-specific shapes for block states reserved by the resource-pack converter. */
+public final class BedrockCustomBlocks {
+
+    private static volatile Snapshot snapshot = new Snapshot(null, Map.of(), Map.of(), Map.of(), false);
+
+    private BedrockCustomBlocks() {
+    }
+
+    public static void clear() {
+        snapshot = new Snapshot(null, Map.of(), Map.of(), Map.of(), false);
+    }
+
+    public static @Nullable Visual current(final BlockState state) {
+        final Snapshot current = currentSnapshot();
+        return current == null ? null : current.visuals().get(Block.getId(state));
+    }
+
+    public static boolean hasExtendedCollision() {
+        final Snapshot current = currentSnapshot();
+        return current != null && current.extendedCollision();
+    }
+
+    private static @Nullable Snapshot currentSnapshot() {
+        if (Minecraft.getInstance() == null || Minecraft.getInstance().getConnection() == null) {
+            return null;
+        }
+        final UserConnection connection = ViaFabricPlus.api().userConnection();
+        final ResourcePackStorage storage = connection != null ? connection.get(ResourcePackStorage.class) : null;
+        final Map<Integer, CustomBlockVisual> direct = storage != null ? storage.getCustomBlockVisuals() : Map.of();
+        final Map<Integer, CustomBlockProperties> remote = BedrockCustomBlockResources.current();
+        final Object owner = Minecraft.getInstance().getConnection().getConnection();
+        Snapshot current = snapshot;
+        if (current.connection() != owner || current.direct() != direct || current.remote() != remote) {
+            current = createSnapshot(owner, direct, remote);
+        }
+        return current;
+    }
+
+    private static synchronized Snapshot createSnapshot(final Object connection, final Map<Integer, CustomBlockVisual> direct,
+                                                        final Map<Integer, CustomBlockProperties> remote) {
+        final Snapshot current = snapshot;
+        if (current.connection() == connection && current.direct() == direct && current.remote() == remote) {
+            return current;
+        }
+        final Map<Integer, Visual> visuals = new HashMap<>();
+        if (!direct.isEmpty()) {
+            direct.forEach((state, definition) -> visuals.put(state, visual(CustomBlockProperties.of(definition))));
+        } else {
+            remote.forEach((state, definition) -> visuals.put(state, visual(definition)));
+        }
+        final Snapshot updated = new Snapshot(connection, direct, remote, Map.copyOf(visuals), visuals.values().stream().anyMatch(Visual::largeCollision));
+        snapshot = updated;
+        return updated;
+    }
+
+    static Visual visual(final CustomBlockProperties definition) {
+        final VoxelShape collision = shape(definition.collisionBoxes());
+        final VoxelShape selection = shape(definition.selectionBoxes());
+        final boolean fullCollision = Shapes.equal(collision, Shapes.block());
+        final var offset = definition.randomOffset();
+        final boolean largeCollision = !collision.isEmpty() && (collision.bounds().minX + Math.floor(offset.x().min()) < 0
+            || collision.bounds().minY + Math.floor(offset.y().min()) < 0 || collision.bounds().minZ + Math.floor(offset.z().min()) < 0
+            || collision.bounds().maxX + Math.floor(offset.x().max()) > 1 || collision.bounds().maxY + Math.floor(offset.y().max()) > 1
+            || collision.bounds().maxZ + Math.floor(offset.z().max()) > 1);
+        return new Visual(definition, collision, selection, definition.occluding() ? Shapes.block() : Shapes.empty(), fullCollision, largeCollision);
+    }
+
+    static VoxelShape shape(final List<CustomBlockVisual.Box> boxes) {
+        VoxelShape shape = Shapes.empty();
+        for (final CustomBlockVisual.Box box : boxes) {
+            shape = Shapes.or(shape, Shapes.box(box.minX(), box.minY(), box.minZ(), box.maxX(), box.maxY(), box.maxZ()));
+        }
+        return shape.optimize();
+    }
+
+    public record Visual(CustomBlockProperties definition, VoxelShape collision, VoxelShape selection, VoxelShape occlusion,
+                         boolean fullCollision, boolean largeCollision) {
+
+        public Vec3 offset(final BlockPos pos) {
+            final var offset = this.definition.randomOffset().at(pos.getX(), pos.getY(), pos.getZ());
+            return new Vec3(offset.x(), offset.y(), offset.z());
+        }
+
+        public VoxelShape collision(final BlockPos pos) {
+            if (this.definition.randomOffset().equals(CustomBlockOffset.NONE)) return this.collision;
+            return localShape(this.definition.collisionBoxesAt(pos.getX(), pos.getY(), pos.getZ()), pos);
+        }
+
+        public VoxelShape selection(final BlockPos pos) {
+            if (this.definition.randomOffset().equals(CustomBlockOffset.NONE)) return this.selection;
+            return localShape(this.definition.selectionBoxesAt(pos.getX(), pos.getY(), pos.getZ()), pos);
+        }
+
+        public VoxelShape camera(final BlockPos pos) {
+            final var shape = localShape(this.definition.cameraBoxesAt(pos.getX(), pos.getY(), pos.getZ()), pos);
+            return shape.isEmpty() ? shape : Shapes.create(shape.bounds());
+        }
+
+        private static VoxelShape localShape(final List<CustomBlockVisual.Box> boxes, final BlockPos pos) {
+            VoxelShape shape = Shapes.empty();
+            for (final var box : boxes) {
+                shape = Shapes.or(shape, Shapes.box(box.minX() - pos.getX(), box.minY() - pos.getY(), box.minZ() - pos.getZ(),
+                    box.maxX() - pos.getX(), box.maxY() - pos.getY(), box.maxZ() - pos.getZ()));
+            }
+            return shape.optimize();
+        }
+    }
+
+    private record Snapshot(Object connection, Map<Integer, CustomBlockVisual> direct, Map<Integer, CustomBlockProperties> remote, Map<Integer, Visual> visuals, boolean extendedCollision) {
+    }
+}
