+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.state.BlockState;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Definition;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling.Rule;
+
+import java.util.List;
+
+public final class BedrockCustomCulling {
+    private BedrockCustomCulling() {
+    }
+
+    public static boolean visible(final BlockGetter level, final BlockPos pos, final BlockState state, final List<Rule> rules) {
+        final var definitions = BedrockCustomBlockResources.currentCulling();
+        final Definition own = definitions.get(Block.getId(state));
+        if (own == null) return true;
+        for (Rule rule : rules) {
+            final Direction direction = Direction.valueOf(rule.direction().name());
+            final BlockState neighbor = level.getBlockState(pos.relative(direction));
+            final Definition other = definitions.get(Block.getId(neighbor));
+            final var physical = BedrockCustomBlockResources.current().get(Block.getId(neighbor));
+            final boolean opaque = physical != null ? physical.occluding() : neighbor.isSolidRender();
+            if (hidden(own, other, opaque, rule)) return false;
+        }
+        return true;
+    }
+
+    static boolean hidden(final Definition own, final Definition other, final boolean fullAndOpaque, final Rule rule) {
+        if (rule.cullAgainstFullAndOpaque() && fullAndOpaque) return true;
+        if (other == null) return false;
+        return switch (rule.condition()) {
+            case SAME_BLOCK -> !own.identifier().isEmpty() && own.identifier().equals(other.identifier());
+            case SAME_BLOCK_PERMUTATION -> !own.permutation().isEmpty() && own.permutation().equals(other.permutation());
+            case SAME_CULLING_LAYER -> !own.layer().isEmpty() && !own.layer().equals("minecraft:culling_layer.undefined") && own.layer().equals(other.layer());
+            case DEFAULT -> own.directions().contains(rule.direction())
+                && other.directions().contains(rule.direction().opposite())
+                && CustomBlockCulling.covers(own.slice(rule.direction()), other.slice(rule.direction().opposite()));
+        };
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/block/MixinBlockColors.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/block/MixinBlockColors.java
