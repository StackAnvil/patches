+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import net.raphimc.viabedrock.api.model.CustomBlockCulling;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.minecraft.server.packs.resources.SimplePreparableReloadListener;
+import net.minecraft.util.profiling.ProfilerFiller;
+import net.raphimc.viabedrock.api.model.CustomBlockProperties;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Physical block properties from the accepted, versioned server pack on either connection route. */
+public final class BedrockCustomBlockResources extends SimplePreparableReloadListener<BedrockCustomBlockResources.Prepared> {
+    private static final Logger LOGGER = LogManager.getLogger("Bedrock custom blocks");
+    private static final Identifier LOCATION = Identifier.fromNamespaceAndPath("viabedrock", "custom_blocks.json");
+    private static final AtomicReference<State> STATE = new AtomicReference<>(new State(Map.of(), Map.of()));
+
+    public static Map<Integer, CustomBlockProperties> current() {
+        return STATE.get().definitions();
+    }
+
+    public static void clear() {
+        STATE.set(new State(Map.of(), Map.of()));
+    }
+
+    @Override
+    protected Prepared prepare(final ResourceManager resources, final ProfilerFiller profiler) {
+        final State pending = STATE.updateAndGet(current -> new State(current.definitions(), current.culling()));
+        return new Prepared(pending, read(resources, LOCATION, CustomBlockProperties::decode),
+            read(resources, Identifier.fromNamespaceAndPath("viabedrock", "block_culling.json"), CustomBlockCulling::decode));
+    }
+
+    public static Map<Integer, CustomBlockCulling.Definition> currentCulling() {
+        return STATE.get().culling();
+    }
+
+    private static <T> Map<Integer, T> read(final ResourceManager resources, final Identifier location,
+                                           final Function<JsonElement, Map<Integer, T>> decoder) {
+        final var stack = resources.getResourceStack(location);
+        for (int i = stack.size() - 1; i >= 0; i--) {
+            final var resource = stack.get(i);
+            if (resource.source().location().source() != PackSource.SERVER) continue;
+            try (final var input = resource.open()) {
+                final byte[] content = input.readNBytes(CustomBlockProperties.MAX_BYTES + 1);
+                if (content.length > CustomBlockProperties.MAX_BYTES) {
+                    throw new IOException("Custom block metadata exceeds the byte limit");
+                }
+                return decoder.apply(JsonParser.parseString(new String(content, StandardCharsets.UTF_8)));
+            } catch (IOException | RuntimeException error) {
+                LOGGER.warn("Could not load Bedrock block metadata {}", location, error);
+                return Map.of();
+            }
+        }
+        return Map.of();
+    }
+
+    @Override
+    protected void apply(final Prepared prepared, final ResourceManager resources, final ProfilerFiller profiler) {
+        STATE.compareAndSet(prepared.pending(), new State(prepared.definitions(), prepared.culling()));
+    }
+
+    record State(Map<Integer, CustomBlockProperties> definitions, Map<Integer, CustomBlockCulling.Definition> culling) {
+    }
+
+    record Prepared(State pending, Map<Integer, CustomBlockProperties> definitions, Map<Integer, CustomBlockCulling.Definition> culling) {
+    }
+}
