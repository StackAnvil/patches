+    @Test
+    void appliesEveryMaterialStrengthToHeterogeneousNativeCorners() {
+        final BlockAndTintGetter level = (BlockAndTintGetter) Proxy.newProxyInstance(BlockAndTintGetter.class.getClassLoader(),
+                new Class<?>[]{BlockAndTintGetter.class}, (_, method, arguments) -> switch (method.getName()) {
+                    case "cardinalLighting" -> CardinalLighting.DEFAULT;
+                    case "getBlockState" -> {
+                        final BlockPos pos = (BlockPos) arguments[0];
+                        yield (pos.getX() == 0 && pos.getZ() == -1) || (pos.getX() == 1 && pos.getZ() == 0)
+                                ? Blocks.STONE.defaultBlockState() : Blocks.AIR.defaultBlockState();
+                    }
+                    case "getBrightness" -> {
+                        final BlockPos pos = (BlockPos) arguments[1];
+                        yield arguments[0] == LightLayer.SKY ? pos.getZ() > 0 ? 12 : 2 : pos.getX() > 0 ? 9 : 1;
+                    }
+                    default -> throw new UnsupportedOperationException(method.getName());
+                });
+        final float[][] positions = {{0, 1, 0}, {1, 1, 0}, {0, 1, 1}, {1, 1, 1}};
+        final float[] ambient = {0.8F, 0.4F, 1F, 0.8F};
+        final int[] light = {LightCoordsUtil.pack(1, 2), LightCoordsUtil.pack(9, 2),
+                LightCoordsUtil.pack(1, 12), LightCoordsUtil.pack(9, 12)};
