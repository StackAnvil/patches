+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(RedstoneWireBlock.class)
+public abstract class MixinRedstoneWireBlock {
+
+    @Inject(method = "animateTick", at = @At("HEAD"), cancellable = true)
+    private void suppressCarrierParticles(final BlockState state, final Level level, final BlockPos pos, final RandomSource random, final CallbackInfo ci) {
+        if (BedrockCustomBlocks.current(state) != null) {
+            ci.cancel();
+        }
+    }
+
+}
