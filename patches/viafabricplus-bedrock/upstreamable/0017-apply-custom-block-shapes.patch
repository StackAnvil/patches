+package com.viaversion.viafabricplus.bedrock.block;
+
+import net.raphimc.viabedrock.api.model.CustomBlockOffset;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.model.CustomBlockProperties;
+import net.raphimc.viabedrock.api.model.CustomBlockVisual;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.lang.reflect.Proxy;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockCustomBlockResourcesTest {
+
+    @AfterEach
+    void clear() {
+        BedrockCustomBlockResources.clear();
+    }
+
+    @Test
+    void readsAcceptedServerPackPropertiesAndIgnoresLocalOverrides() {
+        final var visual = definition(0.5, 3);
+        final var ignored = definition(1, 15);
+        final ResourceManager resources = resources(List.of(resource(PackSource.SERVER, visual), resource(PackSource.DEFAULT, ignored)));
+        final var listener = new BedrockCustomBlockResources();
+        listener.apply(listener.prepare(resources, null), resources, null);
+        assertEquals(Map.of(42, CustomBlockProperties.of(visual)), BedrockCustomBlockResources.current());
+        final var loaded = BedrockCustomBlocks.visual(BedrockCustomBlockResources.current().get(42));
+        assertEquals(0.5, loaded.collision().max(net.minecraft.core.Direction.Axis.Y));
+        assertEquals(3, loaded.definition().lightDampening());
+    }
+
+    @Test
+    void keepsExistingPhysicsDuringReloadAndPreventsLateReloadAfterDisconnect() {
+        final ResourceManager resources = resources(List.of(resource(PackSource.SERVER, definition(0.5, 3))));
+        final var listener = new BedrockCustomBlockResources();
+        listener.apply(listener.prepare(resources, null), resources, null);
+        final var previous = BedrockCustomBlockResources.current();
+        final var pending = listener.prepare(resources, null);
+        assertSame(previous, BedrockCustomBlockResources.current());
+        BedrockCustomBlockResources.clear();
+        listener.apply(pending, resources, null);
+        assertTrue(BedrockCustomBlockResources.current().isEmpty());
+    }
+
+    @Test
+    void latestServerPackAndLatestReloadReplacePreviousState() {
+        final var first = definition(0.5, 3);
+        final var second = definition(1, 15);
+        final ResourceManager resources = resources(List.of(resource(PackSource.SERVER, first), resource(PackSource.SERVER, second)));
+        final var listener = new BedrockCustomBlockResources();
+        final var stale = listener.prepare(resources, null);
+        final var latest = listener.prepare(resources, null);
+        listener.apply(stale, resources, null);
+        assertTrue(BedrockCustomBlockResources.current().isEmpty());
+        listener.apply(latest, resources, null);
+        assertEquals(CustomBlockProperties.of(second), BedrockCustomBlockResources.current().get(42));
+        final ResourceManager empty = resources(List.of());
+        listener.apply(listener.prepare(empty, null), empty, null);
+        assertTrue(BedrockCustomBlockResources.current().isEmpty());
+    }
+
+    private static CustomBlockVisual definition(final double height, final int dampening) {
+        return new CustomBlockVisual("test:block", 42, "texture", "{}", "opaque",
+                List.of(new CustomBlockVisual.Box(0, 0, 0, 1, height, 1)), List.of(), false, 0, dampening, Map.of(), Map.of(), CustomBlockOffset.NONE);
+    }
+
+    private static Resource resource(final PackSource source, final CustomBlockVisual visual) {
+        final PackLocationInfo location = new PackLocationInfo("test", Component.empty(), source, Optional.empty());
+        final PackResources pack = (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class[]{PackResources.class},
+                (proxy, method, arguments) -> method.getName().equals("location") ? location : null);
+        final byte[] content = CustomBlockProperties.encode(List.of(visual)).toString().getBytes(StandardCharsets.UTF_8);
+        return new Resource(pack, () -> new ByteArrayInputStream(content));
+    }
+
+    private static ResourceManager resources(final List<Resource> stack) {
+        return (ResourceManager) Proxy.newProxyInstance(ResourceManager.class.getClassLoader(), new Class[]{ResourceManager.class},
+                (proxy, method, arguments) -> method.getName().equals("getResourceStack") ? ((net.minecraft.resources.Identifier) arguments[0]).getPath().equals("custom_blocks.json") ? stack : List.of() : null);
+    }
+}
