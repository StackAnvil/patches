@@ -0,0 +1,91 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.BedrockUiContext;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiSceneScreen;
+import java.util.Optional;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.network.protocol.common.ServerboundCustomClickActionPacket;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeFormMessage;
+import net.raphimc.viabedrock.api.resourcepack.ui.ServerFormUi;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+
+public final class BedrockNativeForms {
+    private BedrockNativeForms() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(NativeFormPayload.TYPE, NativeFormPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(NativeFormPayload.TYPE,
+                (payload, context) -> accept(listener, payload.message())));
+    }
+
+    /**
+     * Resolves a server form with the confirmed UI program, exactly as the backend resolved it to choose this path.
+     * Without that program, the backend opens the ordinary form controls instead.
+     */
+    static void accept(final ClientPacketListener owner, final NativeFormMessage message) {
+        final Minecraft client = Minecraft.getInstance();
+        client.execute(() -> {
+            if (!current(owner)) return;
+            final var program = BedrockUiContext.program(message.context());
+            if (program == null) {
+                fallback(owner, message.formId());
+                return;
+            }
+            try {
+                final var resolver = new ServerFormUi(program);
+                final var form = JsonParser.parseString(message.form()).getAsJsonObject();
+                // Expanded scenes are local data, not another network message with the 1 MiB wire bound.
+                final var scene = resolver.resolve(form);
+                if (scene == null) throw new IllegalArgumentException("Unsupported native form");
+                if ("custom_form".equals(form.get("type").getAsString())) {
+                    final BedrockCustomFormState state = new BedrockCustomFormState(resolver, form, scene);
+                    client.setScreenAndShow(new NativeUiSceneScreen(new BedrockFormController(owner, message.formId(), state.scene(), state)));
+                } else {
+                    final String source = scene.toString();
+                    client.setScreenAndShow(new NativeUiSceneScreen(new BedrockFormController(owner, message.formId(),
+                        BedrockFormScene.parse(source), null, BedrockActionFormText.parse(source))));
+                }
+            } catch (final RuntimeException error) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not render native form; requesting its ordinary controls", error);
+                fallback(owner, message.formId());
+            }
+        });
+    }
+
+    static void fallback(final ClientPacketListener owner, final int formId) {
+        final CompoundTag result = new CompoundTag();
+        result.putBoolean("fallback", true);
+        respond(owner, formId, result);
+    }
+
+    static boolean current(final ClientPacketListener owner) {
+        final var listener = Minecraft.getInstance().getConnection();
+        return owner != null && listener == owner && owner.getConnection().isConnected();
+    }
+
+    static void respond(final ClientPacketListener owner, final int formId, final int button) {
+        if (!current(owner)) return;
+        final CompoundTag result = new CompoundTag();
+        if (button < 0) result.putBoolean("exit", true);
+        else result.putInt("button_id", button);
+        respond(owner, formId, result);
+    }
+
+    static void respond(final ClientPacketListener owner, final int formId, final CompoundTag result) {
+        if (!current(owner)) return;
+        owner.send(new ServerboundCustomClickActionPacket(Identifier.fromNamespaceAndPath("viabedrock", "form/" + formId), Optional.of(result)));
+    }
+}
