@@ -0,0 +1,159 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiController;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiSlider;
+import com.viaversion.viaversion.libs.gson.JsonArray;
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonNull;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viaversion.libs.gson.JsonPrimitive;
+import java.util.HashSet;
+import java.util.Set;
+import net.minecraft.nbt.CompoundTag;
+import net.raphimc.viabedrock.api.resourcepack.ui.ServerFormUi;
+
+/** Edits local input state through the same core resolver used by direct and proxy connections. */
+final class BedrockCustomFormState implements NativeUiController.Inputs {
+    private final ServerFormUi resolver;
+    private final com.viaversion.viaversion.libs.gson.JsonObject form;
+    private final JsonArray values;
+    private final Set<Integer> expanded = new HashSet<>();
+    private final com.viaversion.viaversion.libs.gson.JsonObject[] inputs;
+
+    /** Starts from the scene the same resolver produced for the form's initial values. */
+    BedrockCustomFormState(final ServerFormUi resolver, final com.viaversion.viaversion.libs.gson.JsonObject form,
+                           final com.viaversion.viaversion.libs.gson.JsonObject scene) {
+        if (scene.get("format").getAsBigDecimal().intValueExact() != 2)
+            throw new IllegalArgumentException("Unsupported custom form scene");
+        this.resolver = resolver;
+        this.form = form.deepCopy();
+        final int count = this.form.getAsJsonArray("content").size();
+        this.inputs = new com.viaversion.viaversion.libs.gson.JsonObject[count];
+        this.values = new JsonArray();
+        for (int i = 0; i < count; i++) this.values.add(JsonNull.INSTANCE);
+        for (final JsonElement entry : scene.getAsJsonArray("inputs")) {
+            final var input = entry.getAsJsonObject();
+            final int index = input.get("index").getAsBigDecimal().intValueExact();
+            if (index < 0 || index >= count || this.inputs[index] != null)
+                throw new IllegalArgumentException("Invalid custom form input index");
+            this.inputs[index] = input.deepCopy();
+            this.values.set(index, input.get("value").deepCopy());
+        }
+        ServerFormUi.responseValues(this.form, this.values);
+    }
+
+    BedrockFormScene scene() {
+        final var resolved = this.resolver.resolve(this.form, this.values, this.expanded);
+        if (resolved == null) throw new IllegalArgumentException("Unsupported custom form state");
+        return BedrockFormScene.parse(resolved.toString());
+    }
+
+    String type(final int index) {
+        return this.input(index).get("type").getAsString();
+    }
+
+    @Override
+    public String text(final int index) {
+        return this.values.get(index).getAsString();
+    }
+
+    @Override
+    public String placeholder(final int index) {
+        final var value = this.input(index).get("placeholder");
+        return value == null ? "" : value.getAsString();
+    }
+
+    @Override
+    public int maxLength(final int index) {
+        final var value = this.input(index).get("max_length");
+        return value == null ? 100 : value.getAsInt();
+    }
+
+    @Override
+    public boolean isSlider(final int index) {
+        return this.type(index).equals("slider") || this.type(index).equals("step_slider");
+    }
+
+    @Override
+    public boolean setText(final int index, final String value) {
+        if (!this.type(index).equals("input")) throw new IllegalArgumentException("Not a text input");
+        if (value.length() > this.maxLength(index)) throw new IllegalArgumentException("Custom form text exceeds input limit");
+        if (this.text(index).equals(value)) return false;
+        this.values.set(index, new JsonPrimitive(value));
+        return true;
+    }
+
+    void toggle(final int index) {
+        if (!this.type(index).equals("toggle")) throw new IllegalArgumentException("Not a toggle input");
+        this.values.set(index, new JsonPrimitive(!this.values.get(index).getAsBoolean()));
+    }
+
+    void expand(final int index) {
+        this.input(index);
+        if (!this.expanded.remove(index)) this.expanded.add(index);
+    }
+
+    void select(final int index, final int option) {
+        final var input = this.input(index);
+        if (!Set.of("dropdown", "step_slider").contains(this.type(index))
+                || option < 0 || option >= input.getAsJsonArray("options").size())
+            throw new IllegalArgumentException("Invalid custom form option");
+        this.values.set(index, new JsonPrimitive(option));
+        this.expanded.remove(index);
+    }
+
+    @Override
+    public void slide(final int index, final double fraction) {
+        if (!Double.isFinite(fraction)) throw new IllegalArgumentException("Non-finite slider input");
+        final var input = this.input(index);
+        final double position = Math.clamp(fraction, 0, 1);
+        if (this.type(index).equals("step_slider")) {
+            this.select(index, NativeUiSlider.stepIndex((float) position, input.getAsJsonArray("options").size()));
+        } else if (this.type(index).equals("slider")) {
+            final float min = input.get("min").getAsFloat(), max = input.get("max").getAsFloat();
+            final float step = input.get("step").getAsFloat();
+            final float units = (max - min) * (float) position / step;
+            final float rounded = (float) Math.floor((double) units + .5D);
+            this.values.set(index, new JsonPrimitive(Math.clamp(min + rounded * step, min, max)));
+        } else throw new IllegalArgumentException("Not a slider input");
+    }
+
+    @Override
+    public void adjust(final int index, final int direction) {
+        final var input = this.input(index);
+        if (Set.of("dropdown", "step_slider").contains(this.type(index)))
+            this.select(index, Math.clamp(this.values.get(index).getAsInt() + direction, 0, input.getAsJsonArray("options").size() - 1));
+        else if (this.type(index).equals("slider"))
+            this.values.set(index, new JsonPrimitive(Math.clamp(this.values.get(index).getAsFloat() + direction * input.get("step").getAsFloat(),
+                input.get("min").getAsFloat(), input.get("max").getAsFloat())));
+        else if (this.type(index).equals("toggle")) this.toggle(index);
+    }
+
+    CompoundTag response() {
+        final JsonArray validated = ServerFormUi.responseValues(this.form, this.values);
+        final CompoundTag payload = new CompoundTag();
+        for (int index = 0; index < validated.size(); index++) {
+            final var value = validated.get(index);
+            if (value.isJsonNull()) continue;
+            final String key = String.valueOf(index);
+            switch (this.type(index)) {
+                case "toggle" -> payload.putBoolean(key, value.getAsBoolean());
+                case "slider" -> payload.putFloat(key, value.getAsFloat());
+                case "dropdown", "step_slider", "input" -> payload.putString(key, value.getAsString());
+                default -> throw new IllegalArgumentException("Unsupported custom form response");
+            }
+        }
+        return payload;
+    }
+
+    private com.viaversion.viaversion.libs.gson.JsonObject input(final int index) {
+        if (index < 0 || index >= this.inputs.length || this.inputs[index] == null)
+            throw new IllegalArgumentException("Invalid custom form input");
+        return this.inputs[index];
+    }
+}
