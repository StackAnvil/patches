+
+    @Test
+    void doesNotCloseAnUnrelatedScreenAndDropsOldConnectionCallbacks() throws Exception {
+        try (final var harness = new Harness()) {
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(1, 177), false);
+            harness.run();
+            final var unrelated = mock(Screen.class);
+            harness.screen.set(unrelated);
+            BedrockNativeNpcs.accept(harness.listener, new NativeNpcDialogueMessage(1, "viabedrock:npc/1", null), false);
+            harness.run();
+            assertSame(unrelated, harness.screen.get());
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(2, 255), false);
+            final var reconfigured = mock(ClientPacketListener.class);
+            when(reconfigured.getConnection()).thenReturn(harness.owner);
+            when(harness.game.getConnection()).thenReturn(reconfigured);
+            harness.run();
+            assertSame(unrelated, harness.screen.get());
+            verify(harness.owner, never()).send(any());
+            BedrockNativeNpcs.accept(reconfigured, BedrockNpcConversationTest.message(2, 255), false);
+            harness.run();
+            final var current = harness.screen.get();
+            assertNotSame(unrelated, current);
+            BedrockNativeNpcs.disconnected(harness.listener);
+            assertSame(current, harness.screen.get());
+            BedrockNativeNpcs.disconnected(reconfigured);
