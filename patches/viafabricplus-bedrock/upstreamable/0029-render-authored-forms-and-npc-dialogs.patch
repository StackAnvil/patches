+        final var source = resolver.resolve(coreProgram.getAsJsonObject("form"));
+        assertTrue(source != null);
+        final var state = new BedrockCustomFormState(resolver, coreProgram.getAsJsonObject("form"), source);
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        when(font.plainSubstrByWidth(anyString(), anyInt())).thenAnswer(call ->
+            substring(call.getArgument(0), call.getArgument(1), false));
+        when(font.plainSubstrByWidth(anyString(), anyInt(), anyBoolean())).thenAnswer(call ->
+            substring(call.getArgument(0), call.getArgument(1), call.getArgument(2)));
+        when(font.width(anyString())).thenAnswer(call -> ((String) call.getArgument(0)).length() * 6);
+        final Minecraft game = mock(Minecraft.class);
+        final Field fontField = Minecraft.class.getField("font");
+        fontField.setAccessible(true);
+        fontField.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new NativeUiSceneScreen(new BedrockFormController(null, 0, state.scene(), state));
+            screen.width = 200;
+            screen.height = 100;
+            final var init = NativeUiSceneScreen.class.getDeclaredMethod("init");
+            init.setAccessible(true);
+            init.invoke(screen);
+            final EditBox input = (EditBox) screen.children().stream().filter(EditBox.class::isInstance).findFirst().orElseThrow();
+            final Field display = EditBox.class.getDeclaredField("displayPos");
+            display.setAccessible(true);
+            assertEquals(0, display.getInt(input), "Initial input sizing must not hide leading characters");
+            screen.setFocused(input);
+            input.setCursorPosition(3);
+            input.setHighlightPos(1);
+            final Method refresh = NativeUiSceneScreen.class.getDeclaredMethod("refreshScene");
+            refresh.setAccessible(true);
+            refresh.invoke(screen);
+            assertTrue(screen.children().contains(input));
+            assertTrue(screen.getFocused() == input);
+            assertTrue(input.getCursorPosition() == 3);
+            assertTrue(input.getHighlighted().length() == 2);
+            input.setCursorPosition(3);
+            input.setHighlightPos(3);
+            assertTrue(screen.charTyped(new CharacterEvent('x')));
+            assertTrue(state.text(0).equals("abcx"));
+            assertTrue(screen.children().contains(input));
+            assertTrue(screen.getFocused() == input);
+            assertTrue(input.getCursorPosition() == 4);
+            final Field sceneField = NativeUiSceneScreen.class.getDeclaredField("scene");
+            sceneField.setAccessible(true);
+            final var current = (com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene.Node) sceneField.get(screen);
+            assertTrue(current.children().get(1).flag("visible",false));
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_HOME,(1<<30)|InputConstants.KEY_HOME,0)));
+            assertTrue(input.getCursorPosition() == 0);
+            assertTrue(screen.keyPressed(new KeyEvent(InputConstants.KEY_END,(1<<30)|InputConstants.KEY_END,0)));
+            assertTrue(input.getCursorPosition() == 4);
+            assertTrue(!state.setText(0,"abcx"));
+            final var bounds = new NativeUiLayout.Rect(0,0,120,20);
+            final var clipped = new NativeUiLayout.Box(current.children().get(0),bounds,new NativeUiLayout.Rect(0,0,120,10),new NativeUiLayout.Size(120,20),bounds,0,java.util.List.of());
+            final Method place = input.getClass().getDeclaredMethod("place", NativeUiLayout.Box.class);
+            place.setAccessible(true);
+            place.invoke(input, clipped);
+            assertTrue(input.isMouseOver(2,2));
+            assertTrue(!input.isMouseOver(2,15));
+        }
+    }
+    private static String substring(final String text, final int width, final boolean reverse) {
+        final int count = Math.min(text.length(), Math.max(0, width / 6));
+        return reverse ? text.substring(text.length() - count) : text.substring(0, count);
+    }
+
