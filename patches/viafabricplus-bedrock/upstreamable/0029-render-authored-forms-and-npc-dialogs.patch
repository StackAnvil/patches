+class BedrockCustomFormEditingTest {
+    @org.junit.jupiter.api.Test
+    void retainsEditingAndClippingAcrossDependentSceneUpdates() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final JsonObject program = JsonParser.parseString("""
+            {"form":{"type":"custom_form","title":"","content":[{"type":"input","text":"","default":"abc"}]},
