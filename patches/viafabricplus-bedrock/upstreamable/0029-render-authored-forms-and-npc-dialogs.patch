+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.net.URI;
+import java.util.Set;
+import net.raphimc.viabedrock.api.model.NativeNpcDialogueMessage;
+
+/** Conversation authority stays separate from forms and their contiguous response indices. */
+record BedrockNpcScene(String identifier, String title, NativeUiScene.Node root, String editorSource) {
+    BedrockNpcScene(final String identifier, final String title, final NativeUiScene.Node root) {
+        this(identifier, title, root, null);
+    }
+    static final Set<String> RENDERERS = Set.of("hover_text_renderer", "actor_portrait_renderer", "live_horse_renderer");
+
+    static BedrockNpcScene parse(final NativeNpcDialogueMessage message) {
+        final var document = JsonParser.parseString(message.scene()).getAsJsonObject();
+        if (!message.responseIdentifier().equals(document.get("response_id").getAsString()))
+            throw new IllegalArgumentException("Native NPC response identity does not match its scene");
+        final var root = NativeUiScene.parse(message.scene(), RENDERERS).root();
+        validate(root);
+        return new BedrockNpcScene(message.responseIdentifier(), document.getAsJsonObject("conversation").get("title").getAsString(), root,
+            document.get("format").getAsInt() == 2 ? message.scene() : null);
+    }
+
+    private static void validate(final NativeUiScene.Node node) {
+        if (node.properties().has("action") && (node.action() < -1 || node.action() >= 256))
+            throw new IllegalArgumentException("Invalid native NPC response index");
+        if (node.properties().has("url")) {
+            link(node);
+            if (node.properties().has("action")) throw new IllegalArgumentException("NPC URL also has a command response");
+        }
+        for (final var child : node.children()) validate(child);
+    }
+
+    static URI link(final NativeUiScene.Node node) {
+        final URI uri = URI.create(node.string("url", ""));
+        if (uri.getHost() == null || !("https".equalsIgnoreCase(uri.getScheme()) || "http".equalsIgnoreCase(uri.getScheme())))
+            throw new IllegalArgumentException("Invalid native NPC link");
+        return uri;
+    }
+}
