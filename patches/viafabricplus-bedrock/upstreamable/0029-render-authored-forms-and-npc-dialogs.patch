+            final var response = org.mockito.ArgumentCaptor.forClass(ServerboundCustomClickActionPacket.class);
+            verify(harness.owner).send(response.capture());
+            assertEquals("viabedrock:npc/1", response.getValue().id().toString());
+            assertTrue(((net.minecraft.nbt.CompoundTag) response.getValue().payload().orElseThrow()).getBooleanOr("exit", false));
+            assertNull(harness.screen.get());
+        }
+    }
+
+    @Test
+    void rejectedReplacementRetiresOldCallbacksAndAllowsTheNextValidScene() throws Exception {
+        try (final var harness = new Harness()) {
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(1, 177));
+            harness.run();
+            final var first = (NativeUiSceneScreen) harness.screen.get();
+            final var invalid = BedrockNpcConversationTest.message(2, 256);
+            BedrockNativeNpcs.accept(harness.listener, invalid);
+            harness.run();
+            assertNull(harness.screen.get());
+            first.onClose();
+            final var response = org.mockito.ArgumentCaptor.forClass(ServerboundCustomClickActionPacket.class);
+            verify(harness.owner).send(response.capture());
+            assertEquals(invalid.responseIdentifier(), response.getValue().id().toString());
+            assertTrue(((net.minecraft.nbt.CompoundTag) response.getValue().payload().orElseThrow()).getBooleanOr("exit", false));
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(3, 255));
