+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.net.URI;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.IntConsumer;
+
+/** Retain original sparse command indices and retire replaced scenes without sending an exit. */
+final class BedrockNpcConversation {
+    private final BedrockNpcScene scene;
+    private final Set<NativeUiScene.Node> controls = Collections.newSetFromMap(new IdentityHashMap<>());
+    private boolean retired;
+
+    BedrockNpcConversation(final BedrockNpcScene scene) {
+        this.scene = scene;
+        this.collect(scene.root());
+    }
+
+    BedrockNpcScene scene() { return this.scene; }
+    boolean current() { return !this.retired; }
+    void retire() { this.retired = true; }
+
+    boolean activate(final NativeUiScene.Node node, final IntConsumer response, final Consumer<URI> openLink) {
+        if (this.retired || !this.controls.contains(node)) return false;
+        if (node.properties().has("url")) {
+            openLink.accept(BedrockNpcScene.link(node));
+            return false;
+        }
+        if (!node.properties().has("action")) return false;
+        this.retired = true;
+        response.accept(node.action());
+        return true;
+    }
+
+    void cancel(final IntConsumer response) {
+        if (this.retired) return;
+        this.retired = true;
+        response.accept(-1);
+    }
+
+    private void collect(final NativeUiScene.Node node) {
+        if (node.interactive()) this.controls.add(node);
+        node.children().forEach(this::collect);
+    }
+}
