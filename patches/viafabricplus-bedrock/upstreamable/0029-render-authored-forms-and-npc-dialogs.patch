+package com.viaversion.viafabricplus.bedrock.screen.npc;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.List;
+import net.raphimc.viabedrock.api.model.NativeNpcDialogueMessage;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockNpcConversationTest {
+    @Test
+    void sendsOneOriginalSparseIndexAndDoesNotSendAnExitAfterSubmission() {
+        final var state = new BedrockNpcConversation(scene(1, 2, 177, 255, -1));
+        final List<Integer> responses = new ArrayList<>();
+        final var button = state.scene().root().children().get(1);
+        assertTrue(state.activate(button, responses::add, _ -> fail()));
+        assertFalse(state.activate(button, responses::add, _ -> fail()));
+        state.cancel(responses::add);
+        assertEquals(List.of(177), responses);
+        assertFalse(state.current());
+    }
+
+    @Test
+    void opensLinksWithoutCompletingOrSendingACommandAndRetiresReplacedScenes() {
+        final var state = new BedrockNpcConversation(scene(1, -1));
+        final List<Integer> responses = new ArrayList<>();
+        final List<URI> links = new ArrayList<>();
+        final var link = state.scene().root().children().getLast();
+        assertFalse(state.activate(link, responses::add, links::add));
+        assertTrue(state.current());
+        assertTrue(responses.isEmpty());
+        assertEquals(List.of(BedrockNpcScene.link(link)), links);
+        state.retire();
+        assertFalse(state.activate(link, responses::add, links::add));
+        state.cancel(responses::add);
+        assertTrue(responses.isEmpty());
+        assertEquals(1, links.size());
+    }
+
+    @Test
+    void rejectsControlsFromAnotherSceneAndCancelsExactlyOnce() {
+        final var state = new BedrockNpcConversation(scene(1, 177));
+        final var replacement = new BedrockNpcConversation(scene(2, 177));
+        final List<Integer> responses = new ArrayList<>();
+        assertFalse(state.activate(replacement.scene().root().children().getFirst(), responses::add, _ -> fail()));
+        assertTrue(state.current());
+        state.cancel(responses::add);
+        state.cancel(responses::add);
+        assertEquals(List.of(-1), responses);
+        assertTrue(replacement.current());
+    }
+
+    @Test
+    void rejectsInvalidIdentityActionIndicesAndLinksBeforeActivation() {
+        final var valid = message(1, 177);
+        final var wrongIdentity = new NativeNpcDialogueMessage("viabedrock:npc/2", valid.scene());
+        assertThrows(IllegalArgumentException.class, () -> BedrockNpcScene.parse(wrongIdentity));
+        assertThrows(IllegalArgumentException.class, () -> scene(1, 256));
+        assertThrows(IllegalArgumentException.class, () -> scene(1, -2));
+        final var document = com.google.gson.JsonParser.parseString(valid.scene()).getAsJsonObject();
+        final var link = document.getAsJsonObject("root").getAsJsonArray("children").get(1).getAsJsonObject();
+        for (final String uri : List.of("file:///tmp/probe", "javascript:alert(1)", "https:relative")) {
+            link.addProperty("url", uri);
+            assertThrows(IllegalArgumentException.class, () -> BedrockNpcScene.parse(new NativeNpcDialogueMessage(valid.responseIdentifier(), document.toString())));
+        }
+        link.addProperty("url", "https://example.com/");
+        link.addProperty("action", 177);
+        assertThrows(IllegalArgumentException.class, () -> BedrockNpcScene.parse(new NativeNpcDialogueMessage(valid.responseIdentifier(), document.toString())));
+    }
+
+    static BedrockNpcScene scene(final int sequence, final int... indices) { return BedrockNpcScene.parse(message(sequence, indices)); }
+
+    static NativeNpcDialogueMessage message(final int sequence, final int... indices) {
+        final String identifier = "viabedrock:npc/" + sequence;
+        final var document = new JsonObject();
+        document.addProperty("format", 1);
+        document.addProperty("response_id", identifier);
+        final var conversation = new JsonObject();
+        conversation.addProperty("title", "");
+        document.add("conversation", conversation);
+        final var root = new JsonObject();
+        root.addProperty("type", "panel");
+        final var children = new JsonArray();
+        for (final int index : indices) {
+            final var button = new JsonObject();
+            button.addProperty("type", "button");
+            button.addProperty("action", index);
+            children.add(button);
+        }
+        final var link = new JsonObject();
+        link.addProperty("type", "button");
+        link.addProperty("url", "https://example.com/");
+        children.add(link);
+        root.add("children", children);
+        document.add("root", root);
+        return new NativeNpcDialogueMessage(identifier, document.toString());
+    }
+}
