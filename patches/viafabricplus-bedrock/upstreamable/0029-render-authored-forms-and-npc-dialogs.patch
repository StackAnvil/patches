+    @Test
+    void ignoresDelayedClosesAndCallbacksFromReplacedConversations() throws Exception {
+        try (final var harness = new Harness()) {
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(1, 177));
+            harness.run();
+            final var first = (NativeUiSceneScreen) harness.screen.get();
+            BedrockNativeNpcs.accept(harness.listener, BedrockNpcConversationTest.message(2, 255));
+            harness.run();
+            final var second = harness.screen.get();
+            assertNotSame(first, second);
+            first.onClose();
+            assertSame(second, harness.screen.get());
+            verify(harness.owner, never()).send(any());
+            BedrockNativeNpcs.accept(harness.listener, new NativeNpcDialogueMessage("viabedrock:npc/1", null));
+            harness.run();
+            assertSame(second, harness.screen.get());
+            BedrockNativeNpcs.accept(harness.listener, new NativeNpcDialogueMessage("viabedrock:npc/2", null));
