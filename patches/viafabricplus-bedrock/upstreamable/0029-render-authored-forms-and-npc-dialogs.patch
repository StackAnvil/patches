diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormSceneTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormSceneTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..cea67062505ec97ab2e2e69f2170c9d0f9f6df43
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormSceneTest.java
@@ -0,0 +1,124 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiLayout;
+import java.util.Map;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockFormSceneTest {
+    @Test
+    void rejectsUnsupportedControlsAndInvalidResponseIndicesButKeepsFallback() {
+        final JsonObject unknown = node("custom", 20, 20);
+        final String unknownScene = json(unknown).toString();
+        assertThrows(IllegalArgumentException.class, () -> BedrockFormScene.parse(unknownScene));
+        assertEquals(10, BedrockFormScene.fallback(unknownScene).buttons().size());
+        final JsonObject button = node("button", 100, 20);
+        button.addProperty("action", 10);
+        assertThrows(IllegalArgumentException.class, () -> scene(button));
+        button.addProperty("action", Integer.MIN_VALUE);
+        assertThrows(IllegalArgumentException.class, () -> scene(button));
+        button.addProperty("action", -1);
+        assertEquals(-1, scene(button).root().action());
+        button.add("size", pair("100% + bogus", 20));
+        assertThrows(IllegalArgumentException.class, () -> layout(scene(button), 320, 200));
+    }
+
+    @Test
+    void failedAuthoredControlsKeepResolvedFallbackCaptionsAndSparseResponses() {
+        final JsonObject root = node("panel", 200, 100);
+        final JsonObject title = node("label", 200, 20);
+        title.addProperty("text", "Menu");
+        final JsonObject choice = node("button", 200, 20);
+        choice.addProperty("action", 0);
+        final JsonObject label = node("label", 200, 20);
+        label.addProperty("text", "Resolved choice");
+        final JsonArray captions = new JsonArray();
+        captions.add(label);
+        choice.add("children", captions);
+        final JsonObject close = node("custom", 20, 20);
+        close.addProperty("renderer", "unsupported_renderer");
+        close.addProperty("action", 8);
+        close.addProperty("tts_name", "accessibility.button.tts.title");
+        final JsonObject hidden = node("button", 200, 20);
+        hidden.addProperty("action", 1);
+        hidden.addProperty("visible", false);
+        final JsonArray children = new JsonArray();
+        children.add(title); children.add(close); children.add(choice); children.add(hidden);
+        root.add("children", children);
+        final JsonObject payload = json(root);
+        payload.getAsJsonObject("fallback").addProperty("title", "selector_Menu");
+        payload.getAsJsonObject("fallback").getAsJsonArray("buttons").get(8).getAsJsonObject().addProperty("text", "Close");
+
+        assertThrows(IllegalArgumentException.class, () -> BedrockFormScene.parse(payload.toString()));
+        final var fallback = BedrockFormScene.fallback(payload.toString());
+        assertEquals("Menu", fallback.title());
+        assertEquals(10, fallback.sourceButtonCount());
+        assertEquals(List.of(new BedrockFormScene.FallbackButton(0, "Resolved choice"),
+                new BedrockFormScene.FallbackButton(8, "Close")), fallback.buttons());
+        // The source index remains valid even when it exceeds the displayed button count.
+        close.addProperty("type", "button");
+        assertEquals(fallback, BedrockFormScene.parse(payload.toString()).fallback());
+    }
+
+    @Test
+    void malformedProjectionKeepsOriginalActionsAndCustomFormsKeepTheirOwnTitle() {
+        final JsonObject root = node("label", 200, 20);
+        root.addProperty("text", "First question");
+        final JsonObject custom = json(root);
+        custom.addProperty("format", 2);
+        custom.getAsJsonObject("fallback").addProperty("title", "Questionnaire");
+        custom.getAsJsonObject("fallback").add("buttons", new JsonArray());
+        assertEquals("Questionnaire", BedrockFormScene.fallback(custom.toString()).title());
+        final JsonObject malformed = json(root);
+        malformed.getAsJsonObject("fallback").addProperty("title", "Original form");
+        final JsonArray invalid = new JsonArray();
+        invalid.add("unsupported child");
+        root.add("children", invalid);
+        final var fallback = BedrockFormScene.fallback(malformed.toString());
+        assertEquals("Original form", fallback.title());
+        assertEquals(10, fallback.buttons().size());
+        assertEquals(new BedrockFormScene.FallbackButton(9, "9"), fallback.buttons().getLast());
+    }
+
+    private static JsonObject json(final JsonObject root) {
+        final JsonObject value = new JsonObject(), fallback = new JsonObject();
+        value.addProperty("format", 1);
+        value.add("root", root);
+        final JsonArray buttons = new JsonArray();
+        for (int i = 0; i < 10; i++) {
+            final JsonObject button = new JsonObject();
+            button.addProperty("text", Integer.toString(i));
+            buttons.add(button);
+        }
+        fallback.add("buttons", buttons);
+        value.add("fallback", fallback);
+        return value;
+    }
+
+    private static BedrockFormScene scene(final JsonObject root) { return BedrockFormScene.parse(json(root).toString()); }
+    private static NativeUiLayout.Box layout(final BedrockFormScene scene, final int width, final int height) {
+        return new NativeUiLayout(_ -> new NativeUiLayout.Size(0, 0)).layout(scene.root(), width, height, Map.of());
+    }
+    private static JsonObject node(final String type, final Object width, final Object height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("type", type);
+        node.add("size", pair(width, height));
+        return node;
+    }
+    private static JsonArray pair(final Object first, final Object second) {
+        final var array = new JsonArray();
+        for (final Object value : new Object[] {first, second}) {
+            if (value instanceof Number number) array.add(number);
+            else array.add(value.toString());
+        }
+        return array;
+    }
+}
