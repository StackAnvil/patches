+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiController;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import net.minecraft.nbt.ByteArrayTag;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.StringTag;
+
+/**
+ * Text values that an authored action form submits as a string array instead of a button ordinal. A native field is
+ * unset until it gains focus or text: submitting an untouched field sends {@code [null]}, while a focused or cleared
+ * field sends {@code [""]}.
+ */
+final class BedrockActionFormText implements NativeUiController.Inputs {
+    /** Null marks a field that has neither gained focus nor received text. */
+    private final String[] values;
+    private final String[] placeholders;
+    private final int[] limits;
+
+    private BedrockActionFormText(final String[] placeholders, final int[] limits) {
+        this.values = new String[limits.length];
+        this.placeholders = placeholders;
+        this.limits = limits;
+    }
+
+    /** Returns null when the scene has no submitted text values. */
+    static BedrockActionFormText parse(final String source) {
+        final var scene = JsonParser.parseString(source).getAsJsonObject();
+        if (!scene.has("text_inputs")) return null;
+        final var inputs = scene.getAsJsonArray("text_inputs");
+        if (inputs.isEmpty() || inputs.size() > 16) throw new IllegalArgumentException("Invalid action form text inputs");
+        final String[] placeholders = new String[inputs.size()];
+        final int[] limits = new int[inputs.size()];
+        for (int index = 0; index < inputs.size(); index++) {
+            final var input = inputs.get(index).getAsJsonObject();
+            final int limit = input.get("max_length").getAsBigDecimal().intValueExact();
+            if (input.get("index").getAsBigDecimal().intValueExact() != index || limit < 0 || limit > 100)
+                throw new IllegalArgumentException("Invalid action form text input");
+            limits[index] = limit;
+            placeholders[index] = input.has("placeholder") ? input.get("placeholder").getAsString() : "";
+        }
+        return new BedrockActionFormText(placeholders, limits);
+    }
+
+    @Override
+    public int maxLength(final int index) { return this.limits[this.index(index)]; }
+
+    @Override
+    public String text(final int index) {
+        final String value = this.values[this.index(index)];
+        return value == null ? "" : value;
+    }
+
+    @Override
+    public String placeholder(final int index) { return this.placeholders[this.index(index)]; }
+
+    @Override
+    public boolean setText(final int index, final String value) {
+        if (value.length() > this.maxLength(index)) throw new IllegalArgumentException("Action form text exceeds its limit");
+        // Editors call this when they gain focus, which initializes an unset field to its current text.
+        this.values[index] = value;
+        // Native search fields do not filter locally; the server answers the submitted text.
+        return false;
+    }
+
+    @Override
+    public boolean isSlider(final int index) {
+        this.index(index);
+        return false;
+    }
+
+    @Override
+    public void slide(final int index, final double fraction) { throw new IllegalArgumentException("Not a slider input"); }
+
+    @Override
+    public void adjust(final int index, final int direction) { this.index(index); }
+
+    CompoundTag response() {
+        final ListTag values = new ListTag();
+        final byte[] set = new byte[this.values.length];
+        for (int index = 0; index < this.values.length; index++) {
+            values.add(StringTag.valueOf(this.text(index)));
+            set[index] = (byte) (this.values[index] == null ? 0 : 1);
+        }
+        final CompoundTag payload = new CompoundTag();
+        payload.put("text_values", values);
+        payload.put("text_set", new ByteArrayTag(set));
+        return payload;
+    }
+
+    private int index(final int index) {
+        if (index < 0 || index >= this.values.length) throw new IllegalArgumentException("Invalid action form text input");
+        return index;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockCustomFormState.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockCustomFormState.java
