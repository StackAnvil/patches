--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormController.java
@@ -0,0 +1,122 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiController;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+
+/** Original form identities and typed values, independent of the shared authored-screen renderer. */
+final class BedrockFormController implements NativeUiController {
+    private final ClientPacketListener owner;
+    private final int formId;
+    private final BedrockCustomFormState custom;
+    private final BedrockActionFormText text;
+    private BedrockFormScene scene;
+    private boolean responded;
+
+    BedrockFormController(final ClientPacketListener owner, final int formId, final BedrockFormScene scene,
+                          final BedrockCustomFormState custom) {
+        this(owner, formId, scene, custom, null);
+    }
+
+    BedrockFormController(final ClientPacketListener owner, final int formId, final BedrockFormScene scene,
+                          final BedrockCustomFormState custom, final BedrockActionFormText text) {
+        if (custom != null && text != null) throw new IllegalArgumentException("Custom forms carry their own inputs");
+        this.owner = owner;
+        this.formId = formId;
+        this.scene = scene;
+        this.custom = custom;
+        this.text = text;
+    }
+
+    @Override
+    public String title() { return this.scene.fallback().title(); }
+
+    @Override
+    public NativeUiScene.Node root() { return this.scene.root(); }
+
+    @Override
+    public void validateVisibleControls() { this.scene.validateVisibleControls(); }
+
+    @Override
+    public void validateResponseControls(final List<NativeUiScene.Node> controls) {
+        if (!this.scene.fallback().buttons().isEmpty() && controls.stream().noneMatch(node -> node.action() >= 0))
+            throw new IllegalArgumentException("Native form has no usable response controls");
+    }
+
+    @Override
+    public boolean current() { return BedrockNativeForms.current(this.owner); }
+
+    @Override
+    public Inputs inputs() { return this.custom != null ? this.custom : this.text; }
+
+    @Override
+    public void refresh() {
+        if (this.custom != null) this.scene = this.custom.scene();
+    }
+
+    @Override
+    public Activation activate(final NativeUiScene.Node node) {
+        if (this.responded) return Activation.STAY;
+        if (this.custom == null) {
+            if (node.string("command", "").equals("submit")) {
+                if (this.text == null) return Activation.STAY;
+                this.responded = true;
+                BedrockNativeForms.respond(this.owner, this.formId, this.text.response());
+                return Activation.CLOSE;
+            }
+            if (node.properties().has("input")) return Activation.STAY;
+            this.respond(node.action());
+            return Activation.CLOSE;
+        }
+        final String command = node.string("command", "");
+        if (command.equals("cancel") || node.action() == -1) {
+            this.cancel();
+            return Activation.CLOSE;
+        }
+        if (command.equals("submit")) {
+            final var response = this.custom.response();
+            this.responded = true;
+            BedrockNativeForms.respond(this.owner, this.formId, response);
+            return Activation.CLOSE;
+        }
+        if (!node.properties().has("input")) return Activation.STAY;
+        final var input = node.properties().getAsJsonObject("input");
+        final int index = input.get("index").getAsBigDecimal().intValueExact();
+        if (command.equals("expand")) this.custom.expand(index);
+        else if (input.has("option")) this.custom.select(index, input.get("option").getAsBigDecimal().intValueExact());
+        else if (this.custom.type(index).equals("toggle")) this.custom.toggle(index);
+        else if (this.custom.isSlider(index)) this.custom.adjust(index, 1);
+        return Activation.STAY;
+    }
+
+    @Override
+    public void cancel() { this.respond(-1); }
+
+    private void respond(final int action) {
+        if (this.responded) return;
+        this.responded = true;
+        BedrockNativeForms.respond(this.owner, this.formId, action);
+    }
+
+    @Override
+    public void failed(final RuntimeException error) {
+        if (this.responded || !this.current()) return;
+        ViaFabricPlusBedrock.impl().logger().warn("Could not render native form; requesting its ordinary controls", error);
+        this.responded = true;
+        final Minecraft client = Minecraft.getInstance();
+        if (this.custom == null)
+            client.setScreenAndShow(new BedrockFallbackFormScreen(this.owner, this.formId, this.scene.fallback()));
+        else {
+            BedrockNativeForms.fallback(this.owner, this.formId);
+            client.setScreenAndShow(null);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormScene.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormScene.java
new file mode 100644
index 0000000000000000000000000000000000000000..26dd934cf619f40e7e8a9f9f2d622b956df93ada
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockFormScene.java
@@ -0,0 +1,84 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.viaversion.viaversion.libs.gson.JsonElement;
+import com.viaversion.viaversion.libs.gson.JsonObject;
+import com.viaversion.viaversion.libs.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import net.raphimc.viabedrock.api.resourcepack.ui.ServerFormUi;
+
+/** A bounded, core-resolved scene. Layout never interprets server response indices. */
+public record BedrockFormScene(NativeUiScene.Node root, Fallback fallback) {
+    private static final Set<String> RENDERERS = Set.of("hover_text_renderer", "live_horse_renderer", "live_player_renderer");
+
+    public static BedrockFormScene parse(final String json) {
+        final JsonObject scene = JsonParser.parseString(json).getAsJsonObject();
+        final Fallback fallback = fallback(scene);
+        final NativeUiScene.Node root = NativeUiScene.parse(json, RENDERERS).root();
+        validateActions(root, fallback.sourceButtonCount());
+        return new BedrockFormScene(root, fallback);
+    }
+
+    private static void validateActions(final NativeUiScene.Node node, final int count) {
+        if (node.properties().has("action") && (node.action() < -1 || node.action() >= count))
+            throw new IllegalArgumentException("Invalid native form response index");
+        for (final var child : node.children()) validateActions(child, count);
+    }
+
+    public static Fallback fallback(final String json) {
+        return fallback(JsonParser.parseString(json).getAsJsonObject());
+    }
+
+    void validateVisibleControls() {
+        NativeUiScene.validateVisibleControls(this.root, RENDERERS);
+    }
+
+    private static Fallback fallback(final JsonObject scene) {
+        final JsonObject form = scene.getAsJsonObject("fallback");
+        if (form == null) throw new IllegalArgumentException("Missing native form fallback");
+        final List<FallbackButton> buttons = new ArrayList<>();
+        if (form.has("buttons")) {
+            final var entries = form.getAsJsonArray("buttons");
+            if (entries.size() > 1024) throw new IllegalArgumentException("Too many form buttons");
+            for (int index = 0; index < entries.size(); index++)
+                buttons.add(new FallbackButton(index, string(entries.get(index).getAsJsonObject(), "text", "")));
+        }
+        final var original = new Fallback(string(form, "title", ""), string(form, "content", ""), buttons.size(), buttons);
+        if (!scene.has("root") || !scene.get("root").isJsonObject() || !scene.has("format")) return original;
+        try {
+            // Custom forms retain their title and typed input fallback in the protocol layer.
+            if (scene.get("format").getAsInt() != 1) return original;
+            final var presentation = ServerFormUi.presentation(scene);
+            if (presentation.buttons().isEmpty() || presentation.buttons().keySet().stream()
+                    .anyMatch(index -> index < 0 || index >= original.sourceButtonCount())) return original;
+            final List<FallbackButton> projected = new ArrayList<>();
+            for (final var button : original.buttons()) {
+                final String caption = presentation.buttons().get(button.responseIndex());
+                if (caption != null) projected.add(new FallbackButton(button.responseIndex(),
+                        caption.isBlank() ? button.caption() : caption));
+            }
+            return new Fallback(presentation.title(), presentation.content(), original.sourceButtonCount(), projected);
+        } catch (final RuntimeException unsupported) {
+            // A rejected scene can still carry an intact original form.
+            return original;
+        }
+    }
+
+    public static String string(final JsonObject properties, final String key, final String fallback) {
+        final JsonElement value = properties.get(key);
+        return value == null || !value.isJsonPrimitive() ? fallback : value.getAsString();
+    }
+
+    public record FallbackButton(int responseIndex, String caption) {}
+
+    public record Fallback(String title, String content, int sourceButtonCount, List<FallbackButton> buttons) {
+        public Fallback { buttons = List.copyOf(buttons); }
+    }
+}
