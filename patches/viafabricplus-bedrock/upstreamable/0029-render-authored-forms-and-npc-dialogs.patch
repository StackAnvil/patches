+              {"dependent":{"type":"panel","collection_index":0,"size":[20,20],"bindings":[{"binding_type":"view","source_property_name":"(#custom_input_text = 'abcx')","target_property_name":"#visible"}]}}
+            ]}}}}
+            """).getAsJsonObject();
+        final var coreProgram = com.viaversion.viaversion.libs.gson.JsonParser.parseString(program.toString()).getAsJsonObject();
