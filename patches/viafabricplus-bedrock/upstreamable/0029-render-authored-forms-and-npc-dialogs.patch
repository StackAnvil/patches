+final class BedrockActionFormTextTest {
+    @Test
+    void searchTextIsSubmittedAsTheNativeStringArrayWithoutLocalFiltering() throws Exception {
+        withScreen((screen, forms) -> {
+            final EditBox search = screen.children().stream().filter(EditBox.class::isInstance).map(EditBox.class::cast)
+                .findFirst().orElseThrow();
+            assertEquals("", search.getValue());
+            search.setValue("red");
+            final var rows = find(root(screen), node -> node.name().equals("row"));
+            assertTrue(rows.bounds().width() > 0);
+            assertEquals("red", search.getValue());
+            click(screen, find(root(screen), node -> node.string("command", "").equals("submit")));
+            final ListTag expected = new ListTag();
+            expected.add(StringTag.valueOf("red"));
+            forms.verify(() -> BedrockNativeForms.respond(null, 7, response(expected, 1)));
+            forms.verify(() -> BedrockNativeForms.respond(any(), anyInt(), anyInt()), never());
+        });
+    }
+
+    /** Native 1.26.60 control: an untouched field submits [null]; focus alone initializes it to "". */
+    @Test
+    void untouchedSearchStaysUnsetUntilItGainsFocus() throws Exception {
+        final ListTag empty = new ListTag();
+        empty.add(StringTag.valueOf(""));
+        withScreen((screen, forms) -> {
+            click(screen, find(root(screen), node -> node.string("command", "").equals("submit")));
+            forms.verify(() -> BedrockNativeForms.respond(null, 7, response(empty, 0)));
+        });
+        withScreen((screen, forms) -> {
+            screen.setFocused(search(screen));
+            click(screen, find(root(screen), node -> node.string("command", "").equals("submit")));
+            forms.verify(() -> BedrockNativeForms.respond(null, 7, response(empty, 1)));
+        });
+    }
+
+    /**
+     * Real CubeCraft search fields nest their text and placeholder labels inside centering and clipping panels, and
+     * draw state images at the edit box's own layer. The editor must draw above those images, at its text control,
+     * and replace only the labels that belong to this edit box.
+     */
+    @Test
+    void editorDrawsAboveItsBackgroundAtTheNestedTextControl() throws Exception {
+        withScreen(NESTED_SEARCH, (screen, forms) -> {
+            final var root = root(screen);
+            final var draws = NativeUiPresentation.draws(root, box -> false);
+            final var editBox = find(root, node -> node.type().equals("edit_box"));
+            final var text = find(editBox, node -> node.name().equals("display_text"));
+            assertTrue(draws.stream().noneMatch(draw -> draw.box() == text));
+            assertTrue(draws.stream().noneMatch(draw -> draw.box() == find(editBox, node -> node.name().equals("place_holder_control"))));
+            assertTrue(draws.stream().anyMatch(draw -> draw.box().node().name().equals("place_holder_control")),
+                "a same-named control outside the edit box stays visible");
+            final var background = draws.stream().filter(draw -> draw.box().node().name().equals("default")).findFirst().orElseThrow();
+            assertTrue(draws.stream().noneMatch(draw -> draw.box().node().name().equals("hover")));
+
+            final var inputDraws = NativeUiSceneScreen.class.getDeclaredMethod("inputDraws", List.class);
+            inputDraws.setAccessible(true);
+            final List<?> inputs = (List<?>) inputDraws.invoke(screen, draws);
+            assertEquals(1, inputs.size());
+            final var layer = inputs.getFirst().getClass().getDeclaredMethod("layer");
+            layer.setAccessible(true);
+            assertTrue((float) layer.invoke(inputs.getFirst()) > background.box().layer());
+
+            final EditBox search = search(screen);
+            assertEquals(Math.round(text.bounds().x()), search.getX());
+            assertEquals(Math.round(editBox.bounds().x()) + 3, search.getX());
+            assertEquals(Math.round(text.bounds().y()), search.getY());
+            search.setValue("red");
+            assertEquals("red", search.getValue());
+        });
+    }
+
+    private static CompoundTag response(final ListTag values, final int set) {
+        final CompoundTag payload = new CompoundTag();
+        payload.put("text_values", values);
+        payload.put("text_set", new ByteArrayTag(new byte[] {(byte) set}));
+        return payload;
+    }
+
+    private static EditBox search(final NativeUiSceneScreen screen) {
+        return screen.children().stream().filter(EditBox.class::isInstance).map(EditBox.class::cast).findFirst().orElseThrow();
+    }
+
+    private static final String SEARCH = """
+        {"search":{"type":"edit_box","size":[100,20],"offset":[0,0],"anchor_from":"top_left","anchor_to":"top_left","max_length":20,
+          "text_edit_box_grid_collection_name":"custom_form","place_holder_control":"hint",
+          "controls":[{"hint":{"type":"label","text":"search...","size":[100,20]}}]}}""";
+
+    private static final String NESTED_SEARCH = """
+        {"search":{"type":"edit_box","size":[100,18],"offset":[0,0],"anchor_from":"top_left","anchor_to":"top_left","max_length":20,
+          "layer":1,"text_edit_box_grid_collection_name":"custom_form","text_control":"display_text",
+          "place_holder_control":"place_holder_control","default_control":"default","hover_control":"hover",
+          "pressed_control":"pressed","locked_control":"locked",
+          "controls":[
+            {"centering_panel":{"type":"panel","size":["100% - 6px","100% - 4px"],"controls":[
+              {"clipper_panel":{"type":"panel","size":["100%","100%"],"clips_children":true,
+                "anchor_from":"left_middle","anchor_to":"left_middle","controls":[
+                {"display_text":{"type":"label","text":"","layer":1,"anchor_from":"left_middle","anchor_to":"left_middle"}},
+                {"visibility_panel":{"type":"panel","controls":[
+                  {"place_holder_control":{"type":"label","text":"search...","layer":1,
+                    "anchor_from":"right_middle","anchor_to":"right_middle"}}]}}]}}]}},
+            {"locked":{"type":"panel"}},
+            {"default":{"type":"image"}},
+            {"hover":{"type":"image"}},
+            {"pressed":{"type":"image"}}]}},
+        {"caption":{"type":"panel","offset":[0,60],"anchor_from":"top_left","anchor_to":"top_left","size":[100,20],"controls":[
+          {"place_holder_control":{"type":"label","text":"unrelated"}}]}}""";
+
+    @Test
+    void ordinaryButtonsKeepTheirResponseOrdinal() throws Exception {
+        withScreen((screen, forms) -> {
+            click(screen, find(root(screen), node -> node.name().equals("row")));
+            forms.verify(() -> BedrockNativeForms.respond(null, 7, 0));
+            forms.verify(() -> BedrockNativeForms.respond(any(), anyInt(), any(CompoundTag.class)), never());
+        });
+    }
+
+    @Test
+    void rejectsTextBeyondThePresentedLimit() {
+        final var text = BedrockActionFormText.parse("""
+            {"text_inputs":[{"index":0,"max_length":3,"placeholder":"search..."}]}
+            """);
+        assertEquals("search...", text.placeholder(0));
+        assertThrows(IllegalArgumentException.class, () -> text.setText(0, "redd"));
+        assertThrows(IllegalArgumentException.class, () -> text.text(1));
+        assertNull(BedrockActionFormText.parse("{\"format\":1}"));
+    }
+
+    private static void withScreen(final Interaction interaction) throws Exception {
+        withScreen(SEARCH, interaction);
+    }
+
+    private static void withScreen(final String search, final Interaction interaction) throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var program = com.viaversion.viaversion.libs.gson.JsonParser.parseString("""
+            {"definitions":{
+              "server_form.main_screen_content":{"parent":"","value":{"type":"panel","size":[240,120],"anchor_from":"top_left","anchor_to":"top_left","controls":[
+                %s,
+                {"submit":{"type":"button","size":[20,20],"offset":[110,0],"anchor_from":"top_left","anchor_to":"top_left",
+                  "$pressed_button_name":"button.submit_custom_form"}},
+                {"row":{"type":"button","size":[100,20],"offset":[0,40],"anchor_from":"top_left","anchor_to":"top_left",
+                  "collection_index":0,"$pressed_button_name":"button.form_button_click"}}]}}}}
+            """.formatted(search)).getAsJsonObject();
+        final var form = com.viaversion.viaversion.libs.gson.JsonParser.parseString("""
+            {"type":"form","title":"Wardrobe","content":"","elements":[{"type":"button","text":"Hat"}]}
+            """).getAsJsonObject();
+        final var scene = new ServerFormUi(UiProgramFixtures.program(program)).resolve(form);
+        assertNotNull(scene);
+        assertEquals(List.of(20), ServerFormUi.actionTextLimits(scene));
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        when(font.plainSubstrByWidth(anyString(), anyInt())).thenAnswer(call -> fit(call.getArgument(0), call.getArgument(1), false));
+        when(font.plainSubstrByWidth(anyString(), anyInt(), anyBoolean())).thenAnswer(call -> fit(call.getArgument(0), call.getArgument(1), call.getArgument(2)));
+        when(font.width(anyString())).thenAnswer(call -> ((String) call.getArgument(0)).length() * 6);
+        final Minecraft game = mock(Minecraft.class);
+        when(game.getSoundManager()).thenReturn(mock(SoundManager.class));
+        final var field = Minecraft.class.getField("font");
+        field.setAccessible(true);
+        field.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class);
+             final var forms = mockStatic(BedrockNativeForms.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final String source = scene.toString();
+            final var screen = new NativeUiSceneScreen(new BedrockFormController(null, 7, BedrockFormScene.parse(source), null,
+                BedrockActionFormText.parse(source)));
+            screen.width = 240;
+            screen.height = 120;
+            final var init = NativeUiSceneScreen.class.getDeclaredMethod("init");
+            init.setAccessible(true);
+            init.invoke(screen);
+            interaction.run(screen, forms);
+        }
+    }
+
+    private static String fit(final String text, final int width, final boolean reverse) {
+        final int count = Math.min(text.length(), Math.max(0, width / 6));
+        return reverse ? text.substring(text.length() - count) : text.substring(0, count);
+    }
+
+    private static NativeUiLayout.Box root(final NativeUiSceneScreen screen) throws Exception {
+        final var field = NativeUiSceneScreen.class.getDeclaredField("root");
+        field.setAccessible(true);
+        return (NativeUiLayout.Box) field.get(screen);
+    }
+
+    private static NativeUiLayout.Box find(final NativeUiLayout.Box box, final Predicate<NativeUiScene.Node> predicate) {
+        if (predicate.test(box.node())) return box;
+        for (final var child : box.children()) {
+            final var found = find(child, predicate);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private static void click(final NativeUiSceneScreen screen, final NativeUiLayout.Box box) {
+        assertNotNull(box);
+        final var event = new MouseButtonEvent(box.bounds().x() + 5, box.bounds().y() + 5,
+            new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+        assertTrue(screen.mouseClicked(event, false));
+        screen.mouseReleased(event);
+    }
+
+    private interface Interaction {
+        void run(NativeUiSceneScreen screen, MockedStatic<BedrockNativeForms> forms) throws Exception;
+    }
+}
