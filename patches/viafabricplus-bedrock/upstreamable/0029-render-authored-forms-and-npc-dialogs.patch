+    private static BedrockNpcController activeController() throws Exception {
+        final var field = BedrockNativeNpcs.class.getDeclaredField("active");
+        field.setAccessible(true);
+        return (BedrockNpcController) field.get(null);
+    }
+
+    private static NativeUiScene.Node command(final NativeUiScene.Node root, final String name) {
+        if (name.equals(root.string("command", "")) && root.interactive()) return root;
+        for (final var child : root.children()) {
+            final var result = findCommand(child, name);
+            if (result != null) return result;
+        }
+        throw new AssertionError("Missing editor command " + name);
+    }
+
+    private static NativeUiScene.Node findCommand(final NativeUiScene.Node root, final String name) {
+        if (name.equals(root.string("command", "")) && root.interactive()) return root;
+        for (final var child : root.children()) {
+            final var result = findCommand(child, name);
+            if (result != null) return result;
+        }
+        return null;
+    }
+
+    private static NativeNpcDialogueMessage editorMessage() {
+        final var source = JsonParser.parseString("""
+                {"response_id":"viabedrock:npc/42","unique_id":-23,"name":"Editor","dialogue":"text",
+                 "skin_index":0,"commands_enabled":true,"education":false,
+                 "actor_data":{"skin_list":[{"variant":0}]},
+                 "actions":[{"button_name":"Choice","type":1,"mode":0,"text":"say initial","data":[]}]}
+                """).getAsJsonObject();
+        final var program = new ResourcePackStorage(java.util.List.of()).getJsonUiProgram();
+        final var scene = new NpcDialogueUi(program).resolve(new NpcEditorState(source));
+        return new NativeNpcDialogueMessage(source.get("response_id").getAsString(), scene.toString());
+    }
+
+    private static final class Harness implements AutoCloseable {
+        private final Minecraft game = mock(Minecraft.class);
+        private final Connection owner = mock(Connection.class);
+        private final ClientPacketListener listener = mock(ClientPacketListener.class);
+        private final AtomicReference<Screen> screen = new AtomicReference<>();
+        private final ArrayDeque<Runnable> queue = new ArrayDeque<>();
+        private final MockedStatic<Minecraft> singleton;
+        private final MockedStatic<ViaFabricPlusBedrock> addon;
+
+        private Harness() throws Exception {
+            when(game.getConnection()).thenReturn(listener);
+            when(listener.getConnection()).thenReturn(owner);
+            doAnswer(call -> { owner.send(call.getArgument(0)); return null; })
+                    .when(listener).send(any());
+            when(owner.isConnected()).thenReturn(true);
+            final var gui = mock(Gui.class);
+            final var field = Minecraft.class.getField("gui");
+            field.setAccessible(true);
+            field.set(game, gui);
+            when(gui.screen()).thenAnswer(_ -> screen.get());
+            doAnswer(call -> { queue.add(call.getArgument(0)); return null; }).when(game).execute(any(Runnable.class));
+            doAnswer(call -> { screen.set(call.getArgument(0)); return null; }).when(game).setScreenAndShow(any());
+            singleton = mockStatic(Minecraft.class);
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            addon = mockStatic(ViaFabricPlusBedrock.class);
+            final var implementation = mock(ViaFabricPlusBedrock.class);
+            when(implementation.logger()).thenReturn(mock(org.apache.logging.log4j.Logger.class));
+            addon.when(ViaFabricPlusBedrock::impl).thenReturn(implementation);
+        }
+
+        private void run() { queue.removeFirst().run(); }
+
+        @Override
+        public void close() {
+            BedrockNativeNpcs.disconnected(listener);
+            while (!queue.isEmpty()) run();
+            addon.close();
+            singleton.close();
+        }
+    }
+}
