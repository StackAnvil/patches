+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.StringSplitter;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.input.MouseButtonEvent;
+import net.minecraft.client.input.MouseButtonInfo;
+import net.minecraft.client.sounds.SoundManager;
+import net.minecraft.server.Bootstrap;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BedrockNativeFormWidgetIdentityTest {
+    @Test
+    void keepsRepeatedControlsDistinctAcrossRefreshAndSendsOnlyTheClickedIndex() throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final JsonObject root = panel(0, 200, 100);
+        final JsonArray copies = new JsonArray();
+        for (int index = 0; index < 3; index++) {
+            final JsonObject copy = panel(index * 30, 100, 20);
+            final JsonObject button = panel(0, 100, 20);
+            button.addProperty("type", "button");
+            button.addProperty("action", index);
+            final JsonArray children = new JsonArray();
+            children.add(button);
+            copy.add("children", children);
+            copies.add(copy);
+        }
+        root.add("children", copies);
+        final JsonObject json = new JsonObject();
+        json.addProperty("format", 2);
+        json.add("root", root);
+        final var scene = new BedrockFormScene(NativeUiScene.parse(json.toString(), Set.of()).root(),
+            new BedrockFormScene.Fallback("", "", List.of("", "", "")));
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        final Minecraft game = mock(Minecraft.class);
+        when(game.getSoundManager()).thenReturn(mock(SoundManager.class));
+        final var fontField = Minecraft.class.getField("font");
+        fontField.setAccessible(true);
+        fontField.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new NativeUiSceneScreen(new BedrockFormController(null, 0, scene, null));
+            screen.width = 200;
+            screen.height = 100;
+            initialize(screen);
+            assertEquals(3, screen.children().size());
+            final var controls = List.of(screen.getChildAt(10, 10).orElseThrow(),
+                screen.getChildAt(10, 40).orElseThrow(), screen.getChildAt(10, 70).orElseThrow());
+            assertEquals(3, Set.copyOf(controls).size());
+            initialize(screen);
+            for (int index = 0; index < controls.size(); index++)
+                assertSame(controls.get(index), screen.getChildAt(10, 10 + index * 30).orElseThrow());
+            try (final var forms = mockStatic(BedrockNativeForms.class)) {
+                assertTrue(screen.mouseClicked(new MouseButtonEvent(10, 40,
+                    new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0)), false));
+                forms.verify(() -> BedrockNativeForms.respond(null, 0, 1));
+                // The same screen must never send a second response while it is being closed.
+                screen.mouseClicked(new MouseButtonEvent(10, 70,
+                    new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0)), false);
+                forms.verifyNoMoreInteractions();
+            }
+        }
+    }
+
+    private static void initialize(final NativeUiSceneScreen screen) throws Exception {
+        final var init = NativeUiSceneScreen.class.getDeclaredMethod("init");
+        init.setAccessible(true);
+        init.invoke(screen);
+    }
+
+    private static JsonObject panel(final int y, final int width, final int height) {
+        final JsonObject node = new JsonObject();
+        node.addProperty("name", "template");
+        node.addProperty("type", "panel");
+        node.addProperty("anchor_from", "top_left");
+        node.addProperty("anchor_to", "top_left");
+        final JsonArray size = new JsonArray();
+        size.add(width);
+        size.add(height);
+        node.add("size", size);
+        final JsonArray offset = new JsonArray();
+        offset.add(0);
+        offset.add(y);
+        node.add("offset", offset);
+        return node;
+    }
+}
