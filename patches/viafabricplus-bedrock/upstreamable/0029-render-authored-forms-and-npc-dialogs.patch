+                  {"options":{"type":"stack_panel","size":[100,"100%c"],"offset":[0,20],"anchor_from":"top_left","anchor_to":"top_left","visible":"#custom_dropdown","collection_name":"custom_dropdown","factory":{"control_name":"@server_form.option"}}}]}},
+                {"range@server_form.track":{"collection_index":3,"offset":[0,110],"slider_inverted":true,"bindings":[{"binding_name":"#custom_slider_value","binding_name_override":"#slider_value"}]}},
+                {"steps@server_form.track":{"collection_index":4,"offset":[0,140],"bindings":[{"binding_name":"#custom_slider_step_value","binding_name_override":"#slider_value"},{"binding_name":"#custom_slider_steps","binding_name_override":"#slider_steps"}]}},
+                {"only@server_form.track":{"collection_index":5,"offset":[0,170],"bindings":[{"binding_name":"#custom_slider_step_value","binding_name_override":"#slider_value"},{"binding_name":"#custom_slider_steps","binding_name_override":"#slider_steps"}]}}
+              ]}},
+              "server_form.option":{"parent":"","value":{"type":"toggle","size":[100,20],"bindings":[{"binding_name":"#custom_radio_toggled","binding_name_override":"#toggle_state"}]}},
+              "server_form.track":{"parent":"","value":{"type":"slider","size":[100,20],"anchor_from":"top_left","anchor_to":"top_left","default_control":"normal","hover_control":"over","slider_box_control":"thumb","controls":[
+                {"normal":{"type":"panel","size":[100,20]}},{"over":{"type":"panel","size":[100,20],"visible":false}},
+                {"thumb@server_form.thumb":{}}]}},
+              "server_form.thumb":{"parent":"","value":{"type":"slider_box","size":[20,20],"default_control":"normal","hover_control":"over","locked_control":"locked","indent_control":"indent","controls":[
+                {"normal":{"type":"panel","size":[20,20]}},{"over":{"type":"panel","size":[20,20],"visible":false}},
+                {"locked":{"type":"panel","size":[20,20],"visible":false}},{"indent":{"type":"panel","size":[20,20],"visible":false}}]}}
+             }}
+            """).getAsJsonObject();
+    }
+
+    private static void withScreen(final JsonObject program, final Interaction interaction) throws Exception {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var core = com.viaversion.viaversion.libs.gson.JsonParser.parseString(program.toString()).getAsJsonObject();
+        final var resolver = new net.raphimc.viabedrock.api.resourcepack.ui.ServerFormUi(UiProgramFixtures.program(core));
+        final var source = resolver.resolve(core.getAsJsonObject("form"));
+        assertNotNull(source);
+        final var state = new BedrockCustomFormState(resolver, core.getAsJsonObject("form"), source);
+        final Font font = mock(Font.class);
+        when(font.getSplitter()).thenReturn(new StringSplitter((c, style) -> 6));
+        final Minecraft game = mock(Minecraft.class);
+        when(game.getSoundManager()).thenReturn(mock(SoundManager.class));
+        final var field = Minecraft.class.getField("font");
+        field.setAccessible(true);
+        field.set(game, font);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            final var screen = new NativeUiSceneScreen(new BedrockFormController(null, 0, state.scene(), state));
+            screen.width = 240;
+            screen.height = 210;
+            final var init = NativeUiSceneScreen.class.getDeclaredMethod("init");
+            init.setAccessible(true);
+            init.invoke(screen);
+            interaction.run(state, screen);
+        }
+    }
+
+    private static NativeUiLayout.Box root(final NativeUiSceneScreen screen) throws Exception {
+        final var field = NativeUiSceneScreen.class.getDeclaredField("root");
+        field.setAccessible(true);
+        return (NativeUiLayout.Box) field.get(screen);
+    }
+
+    private static NativeUiLayout.Box input(final NativeUiSceneScreen screen, final int index,
+                                                final String type) throws Exception {
+        return find(root(screen), node -> node.type().equals(type) && node.properties().has("input")
+            && node.properties().getAsJsonObject("input").get("index").getAsInt() == index
+            && !node.properties().getAsJsonObject("input").has("option"));
+    }
+
+    private static NativeUiLayout.Box find(final NativeUiLayout.Box box, final Predicate<NativeUiScene.Node> predicate) {
+        if (predicate.test(box.node())) return box;
+        for (final var child : box.children()) {
+            final var found = find(child, predicate);
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    private static void click(final NativeUiSceneScreen screen, final NativeUiLayout.Box box) {
+        assertNotNull(box);
+        final var event = event(box.bounds().x() + 5, box.bounds().y() + 5);
+        assertTrue(screen.mouseClicked(event, false));
+        screen.mouseReleased(event);
+    }
+
+    private static MouseButtonEvent event(final double x, final double y) {
+        return new MouseButtonEvent(x, y, new MouseButtonInfo(InputConstants.MOUSE_BUTTON_LEFT, 0));
+    }
+
+    private static void pointer(final NativeUiSceneScreen screen, final double x, final double y) throws Exception {
+        for (final String axis : new String[] {"X", "Y"}) {
+            final var field = NativeUiSceneScreen.class.getDeclaredField("pointer" + axis);
+            field.setAccessible(true);
+            field.setDouble(screen, axis.equals("X") ? x : y);
+        }
+    }
+
+    private static void invokeLayout(final NativeUiSceneScreen screen) throws Exception {
+        final var method = NativeUiSceneScreen.class.getDeclaredMethod("layout");
+        method.setAccessible(true);
+        method.invoke(screen);
+    }
+
+    private interface Interaction {
+        void run(BedrockCustomFormState state, NativeUiSceneScreen screen) throws Exception;
