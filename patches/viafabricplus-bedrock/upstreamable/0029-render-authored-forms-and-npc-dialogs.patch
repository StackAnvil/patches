@@ -0,0 +1,60 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.screen.form;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.screen.ui.NativeUiScene;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** A bounded, core-resolved scene. Layout never interprets server response indices. */
+public record BedrockFormScene(NativeUiScene.Node root, Fallback fallback) {
+    private static final Set<String> RENDERERS = Set.of("hover_text_renderer", "live_horse_renderer");
+
+    public static BedrockFormScene parse(final String json) {
+        final JsonObject scene = JsonParser.parseString(json).getAsJsonObject();
+        final Fallback fallback = fallback(scene);
+        final NativeUiScene.Node root = NativeUiScene.parse(json, RENDERERS).root();
+        validateActions(root, fallback.buttons.size());
+        return new BedrockFormScene(root, fallback);
+    }
+
+    private static void validateActions(final NativeUiScene.Node node, final int count) {
+        if (node.properties().has("action") && (node.action() < -1 || node.action() >= count))
+            throw new IllegalArgumentException("Invalid native form response index");
+        for (final var child : node.children()) validateActions(child, count);
+    }
+
+    public static Fallback fallback(final String json) {
+        return fallback(JsonParser.parseString(json).getAsJsonObject());
+    }
+
+    void validateVisibleControls() {
+        NativeUiScene.validateVisibleControls(this.root, RENDERERS);
+    }
+
+    private static Fallback fallback(final JsonObject scene) {
+        final JsonObject form = scene.getAsJsonObject("fallback");
+        if (form == null) throw new IllegalArgumentException("Missing native form fallback");
+        final List<String> buttons = new ArrayList<>();
+        if (form.has("buttons")) {
+            final var entries = form.getAsJsonArray("buttons");
+            if (entries.size() > 1024) throw new IllegalArgumentException("Too many form buttons");
+            for (final var entry : entries) buttons.add(string(entry.getAsJsonObject(), "text", ""));
+        }
+        return new Fallback(string(form, "title", ""), string(form, "content", ""), List.copyOf(buttons));
+    }
+
+    public static String string(final JsonObject properties, final String key, final String fallback) {
+        final JsonElement value = properties.get(key);
+        return value == null || !value.isJsonPrimitive() ? fallback : value.getAsString();
+    }
+
+    public record Fallback(String title, String content, List<String> buttons) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockNativeForms.java b/src/main/java/com/viaversion/viafabricplus/bedrock/screen/form/BedrockNativeForms.java
