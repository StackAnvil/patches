+            verify(harness.owner, times(4)).send(packets.capture());
+            final var responses = packets.getAllValues().stream()
+                    .map(packet -> (net.minecraft.nbt.CompoundTag) packet.payload().orElseThrow()).toList();
+            assertEquals(5, responses.get(0).getIntOr("edit_type", -1));
+            assertEquals("first\nsecond", responses.get(0).getStringOr("data", ""));
+            final var actions = JsonParser.parseString(responses.get(1).getStringOr("data", "")).getAsJsonArray();
+            assertEquals("say first\nsay second\n", actions.get(0).getAsJsonObject().get("text").getAsString());
+            assertEquals(2, actions.get(0).getAsJsonObject().getAsJsonArray("data").size());
+            assertTrue(responses.get(3).getBooleanOr("exit", false));
+            assertFalse(controller.current());
