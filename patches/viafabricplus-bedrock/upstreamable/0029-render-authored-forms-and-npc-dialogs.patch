+final class BedrockCustomFormInteractionTest {
+    @Test
+    void updatesDependentVisibilityAndDropdownResponsesThroughScreenEvents() throws Exception {
+        withScreen(program(), (state, screen) -> {
+            assertEquals(0, find(root(screen), node -> node.name().equals("dependent")).bounds().width());
+            click(screen, input(screen, 1, "toggle"));
+            assertTrue(state.response().getBoolean("1").orElseThrow());
+            assertEquals(30, find(root(screen), node -> node.name().equals("dependent")).bounds().width());
+            click(screen, input(screen, 2, "toggle"));
+            final var option = find(root(screen), node -> node.properties().has("input")
+                && node.properties().getAsJsonObject("input").has("option")
+                && node.properties().getAsJsonObject("input").get("option").getAsInt() == 2);
+            assertTrue(option.bounds().height() > 0);
+            click(screen, option);
+            assertEquals(0, find(root(screen), node -> node.name().equals("options")).bounds().height());
+            final var response = state.response();
+            assertTrue(response.getBoolean("1").orElseThrow());
+            assertEquals(2, Integer.parseInt(response.getString("2").orElseThrow()));
+            assertFalse(response.contains("0"));
+            assertFalse(response.contains("6"));
+            click(screen, input(screen, 1, "toggle"));
+            assertEquals(0, find(root(screen), node -> node.name().equals("dependent")).bounds().width());
+        });
+    }
+
+    @Test
+    void dragsInvertedRangesAndFloatStepsAcrossTheFullOwnerTrack() throws Exception {
+        withScreen(program(), (state, screen) -> {
+            final var range = input(screen, 3, "slider");
+            assertTrue(screen.mouseClicked(event(range.bounds().x() + 25, range.bounds().y() + 10), false));
+            assertEquals(7, state.response().getFloat("3").orElseThrow());
+            final var thumb = input(screen, 3, "slider_box");
+            assertEquals(range.bounds().x() + 20, thumb.bounds().x() + thumb.bounds().width() / 2, .001F);
+            assertEquals(20, thumb.children().get(3).bounds().width());
+            assertEquals(0, thumb.children().get(1).bounds().width());
+            assertTrue(screen.mouseDragged(event(range.bounds().x() + 100, range.bounds().y() + 10), 75, 0));
+            assertEquals(3, state.response().getFloat("3").orElseThrow());
+            assertTrue(screen.mouseReleased(event(range.bounds().x() + 100, range.bounds().y() + 10)));
+            pointer(screen, range.bounds().x() + 95, range.bounds().y() + 10);
+            invokeLayout(screen);
+            final var hovered = input(screen, 3, "slider_box");
+            assertEquals(20, hovered.children().get(1).bounds().width());
+            assertEquals(0, hovered.children().get(3).bounds().width());
+            final var steps = input(screen, 4, "slider");
+            assertTrue(screen.mouseClicked(event(steps.bounds().x() + 24.99, steps.bounds().y() + 10), false));
+            assertEquals(0, Integer.parseInt(state.response().getString("4").orElseThrow()));
+            assertTrue(screen.mouseDragged(event(steps.bounds().x() + 25, steps.bounds().y() + 10), .01, 0));
+            assertEquals(1, Integer.parseInt(state.response().getString("4").orElseThrow()));
+            assertTrue(screen.mouseDragged(event(steps.bounds().x() + 100, steps.bounds().y() + 10), 75, 0));
+            assertEquals(2, Integer.parseInt(state.response().getString("4").orElseThrow()));
+            assertTrue(screen.mouseReleased(event(steps.bounds().x() + 100, steps.bounds().y() + 10)));
+            state.slide(3, .099999994F);
+            assertEquals(3, state.response().getFloat("3").orElseThrow());
+            state.slide(3, .10000000149F);
+            assertEquals(4, state.response().getFloat("3").orElseThrow());
+        });
+    }
+
+    @Test
+    void keepsTheOnlyStepOptionValidAcrossPointerInteraction() throws Exception {
+        withScreen(program(), (state, screen) -> {
+            final var slider = input(screen, 5, "slider");
+            assertTrue(screen.mouseClicked(event(slider.bounds().x(), slider.bounds().y() + 10), false));
+            assertTrue(screen.mouseDragged(event(slider.bounds().x() + 100, slider.bounds().y() + 10), 100, 0));
+            assertTrue(screen.mouseReleased(event(slider.bounds().x() + 100, slider.bounds().y() + 10)));
+            assertEquals(0, Integer.parseInt(state.response().getString("5").orElseThrow()));
+        });
+    }
+
+    @Test
+    void rejectsAnUnsupportedRetainedStateChildWhenHoverActivatesIt() throws Exception {
+        final var program = program();
+        final var hover = program.getAsJsonObject("definitions").getAsJsonObject("server_form.thumb")
+            .getAsJsonObject("value").getAsJsonArray("controls").get(1).getAsJsonObject().getAsJsonObject("over");
+        hover.add("controls", JsonParser.parseString("[{\"future\":{\"type\":\"unsupported_widget\",\"size\":[10,10]}}]"));
+        withScreen(program, (state, screen) -> {
+            final var thumb = input(screen, 3, "slider_box");
+            assertEquals(0, thumb.children().get(1).children().getFirst().bounds().width());
+            pointer(screen, thumb.bounds().x() + 5, thumb.bounds().y() + 5);
+            final var failure = assertThrows(InvocationTargetException.class, () -> invokeLayout(screen));
+            assertInstanceOf(IllegalArgumentException.class, failure.getCause());
+        });
+    }
