+
+import net.minecraft.SharedConstants;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.network.Connection;
+import net.minecraft.network.protocol.common.ServerboundCustomClickActionPacket;
+import net.minecraft.server.Bootstrap;
+import net.raphimc.viabedrock.api.model.NativeFormMessage;
+
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+final class BedrockNativeFormsTest {
+    @Test
+    void largeActionFormsCrossTheWireAsTheFormAndResolveTheBackendSceneLocally() {
+        final String ui = """
+                {"namespace":"server_form","third_party_server_screen":{"$screen_content":"server_form.main_screen_content"},
+                 "main_screen_content":{"type":"grid","collection_name":"form_buttons","grid_item_template":"server_form.row"},
+                 "row":{"type":"button","size":[100,20],"$pressed_button_name":"button.form_button_click","controls":[
+                   {"caption":{"type":"label","text":"#form_button_text"}},
+                   {"decoration":{"type":"label","visible":false,"text":"DECORATION"}}]}}
+                """.replace("DECORATION", "x".repeat(8192));
+        final var form = JsonParser.parseString("""
+                {"type":"form","title":"Results","content":"","elements":[]}
+                """).getAsJsonObject();
+        for (int index = 0; index < 160; index++) {
+            final var button = new JsonObject();
+            button.addProperty("type", "button");
+            button.addProperty("text", "Choice " + index);
+            form.getAsJsonArray("elements").add(button);
+        }
+        final var backend = new ServerFormUi(new JsonUiProgram(List.of(Map.of(
+            "ui/server_form.json", ui.getBytes(StandardCharsets.UTF_8)))));
+        final var scene = backend.resolve(form);
+        assertNotNull(scene);
+        // The resolved scene exceeds the wire bound; the message carries only the form.
+        assertTrue(scene.toString().getBytes(StandardCharsets.UTF_8).length > NativeFormMessage.MAX_PAYLOAD_BYTES);
+        final int context = UiProgramFixtures.publish(new JsonUiProgram(List.of(Map.of(
+            "ui/server_form.json", ui.getBytes(StandardCharsets.UTF_8)))));
+        final var message = new NativeFormMessage(context, 7, form.toString());
+        final var local = new ServerFormUi(BedrockUiContext.program(message.context()))
+            .resolve(JsonParser.parseString(message.form()).getAsJsonObject());
+        assertEquals(scene, local);
+        final var rebuilt = BedrockFormScene.parse(local.toString());
+        assertEquals(159, rebuilt.root().children().get(159).action());
+        assertEquals("Choice 159", rebuilt.fallback().buttons().getLast().caption());
+        assertThrows(IllegalArgumentException.class, () -> new NativeFormMessage(0, 7, form.toString()));
+    }
+
+    @Test
+    void reconfigurationDropsQueuedFormsAndResponsesOnTheSameConnectedTransport() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var game = mock(Minecraft.class);
+        final var transport = mock(Connection.class);
+        final var oldSession = mock(ClientPacketListener.class);
+        final var newSession = mock(ClientPacketListener.class);
+        when(transport.isConnected()).thenReturn(true);
+        when(oldSession.getConnection()).thenReturn(transport);
+        when(newSession.getConnection()).thenReturn(transport);
+        when(game.getConnection()).thenReturn(oldSession);
+        final var queue = new ArrayDeque<Runnable>();
+        doAnswer(call -> { queue.add(call.getArgument(0)); return null; })
+                .when(game).execute(any(Runnable.class));
+        final int context = UiProgramFixtures.publish(new JsonUiProgram(List.of(Map.of("ui/server_form.json", """
+                {"namespace":"server_form","main_screen_content":{"type":"button","size":[100,100],"collection_index":0,
+                 "$pressed_button_name":"button.form_button_click"}}
+                """.getBytes(StandardCharsets.UTF_8)))));
+        final var message = new NativeFormMessage(context, 7, """
+                {"type":"form","title":"","content":"","elements":[{"type":"button","text":"Open"}]}
+                """);
+        try (final var singleton = mockStatic(Minecraft.class)) {
+            singleton.when(Minecraft::getInstance).thenReturn(game);
+            BedrockNativeForms.accept(oldSession, message);
+            queue.removeFirst().run();
+            verify(game).setScreenAndShow(any(NativeUiSceneScreen.class));
+            clearInvocations(game);
+            BedrockNativeForms.accept(oldSession, message);
+            BedrockNativeForms.accept(oldSession, new NativeFormMessage(context, 7, "{}"));
+            when(game.getConnection()).thenReturn(newSession);
+            while (!queue.isEmpty()) queue.removeFirst().run();
+            verify(game, never()).setScreenAndShow(any());
+            assertFalse(BedrockNativeForms.current(oldSession));
+            assertTrue(BedrockNativeForms.current(newSession));
+            BedrockNativeForms.respond(oldSession, 7, 0);
+            BedrockNativeForms.fallback(oldSession, 7);
+            verify(oldSession, never()).send(any());
+            verify(newSession, never()).send(any());
+            BedrockNativeForms.respond(newSession, 7, 1);
+            final var response = ArgumentCaptor.forClass(ServerboundCustomClickActionPacket.class);
+            verify(newSession).send(response.capture());
+            assertEquals(1, ((net.minecraft.nbt.CompoundTag)
+                    response.getValue().payload().orElseThrow()).getIntOr("button_id", -1));
+        }
+    }
+}
