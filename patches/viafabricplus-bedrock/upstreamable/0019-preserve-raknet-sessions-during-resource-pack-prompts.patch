From 2969d51f4d369f8f3316fc2b079d77efd8f3c4e2 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 3 Oct 2026 14:48:47 +0200
Subject: [PATCH] fix(network): preserve native sessions during asset prompts

Java's application read timeout closes a live Bedrock connection after
thirty seconds while the player answers a resource or Store prompt, or
while licensed built-in assets download. The native transport can remain
healthy without decoded game packets during this phase.

Remove the vanilla application timeout from RakClientChannel and
NetherNetClientChannel connections. RakNet retains its configured session
and connection timeouts. NetherNet retains its handshake deadline and
reliable data-channel close callback. TCP connections keep their handler.
Core cannot change Minecraft's direct channel initialization, so this
integration belongs in the add-on.

The matching reference uses Bedrock 1.26.51.1 build 51061372, protocol
2193, and Java 26.3. Cloudburst's pinned NetherNetChannel closes the Netty
channel when the reliable data channel closes. The macOS report at
https://mclo.gs/2gcbHoK shows completed resource downloads followed thirty
seconds later by application ReadTimeoutException on NetherNet. The
subsequent helper interruption is disconnect cancellation, not evidence
that the helper or launcher failed to start.
---
 .../mixin/core/connection/MixinConnection_1.java         | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/connection/MixinConnection_1.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/connection/MixinConnection_1.java
index cd74fe9..c653b09 100644
--- a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/connection/MixinConnection_1.java
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/core/connection/MixinConnection_1.java
@@ -24,10 +24,12 @@ package com.viaversion.viafabricplus.bedrock.injection.mixin.core.connection;
 import com.viaversion.viafabricplus.injection.access.core.IConnection;
 import com.viaversion.viaversion.platform.ViaDecodeHandler;
 import org.cloudburstmc.netty.channel.nethernet.config.NetherChannelOption;
+import org.cloudburstmc.netty.channel.nethernet.NetherNetClientChannel;
 import io.netty.channel.Channel;
 import io.netty.channel.ChannelConfig;
 import io.netty.channel.ChannelOption;
 import io.netty.channel.ChannelPipeline;
+import io.netty.handler.timeout.ReadTimeoutHandler;
 import java.util.concurrent.ThreadLocalRandom;
 import net.minecraft.network.Connection;
 import net.minecraft.network.HandlerNames;
@@ -37,6 +39,7 @@ import net.raphimc.viabedrock.netty.DisconnectHandler;
 import net.raphimc.viabedrock.netty.PacketCodec;
 import net.raphimc.viabedrock.netty.raknet.MessageCodec;
 import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.cloudburstmc.netty.channel.raknet.RakClientChannel;
 import org.cloudburstmc.netty.channel.raknet.config.RakChannelOption;
 import org.spongepowered.asm.mixin.Final;
 import org.spongepowered.asm.mixin.Mixin;
@@ -75,6 +78,12 @@ public abstract class MixinConnection_1 {
 
         // ViaBedrock, added around the Via handlers ViaFabricPlus put into the pipeline before
         final ChannelPipeline pipeline = channel.pipeline();
+        // Native transport liveness continues while game packets pause at resource or Store prompts.
+        // NetherNet reports the reliable data channel closing; RakNet retains its session timeout.
+        if ((channel instanceof RakClientChannel || channel instanceof NetherNetClientChannel)
+                && pipeline.get(HandlerNames.TIMEOUT) instanceof ReadTimeoutHandler) {
+            pipeline.remove(HandlerNames.TIMEOUT);
+        }
         pipeline.addBefore(HandlerNames.SPLITTER, DisconnectHandler.NAME, new DisconnectHandler());
         pipeline.addBefore(HandlerNames.SPLITTER, MessageCodec.NAME, new MessageCodec());
         pipeline.replace(HandlerNames.SPLITTER, HandlerNames.SPLITTER, new BatchLengthCodec());
