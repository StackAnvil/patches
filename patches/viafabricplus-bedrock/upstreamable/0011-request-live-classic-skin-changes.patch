+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+/** Correlates native confirmations with the actual Java connection and selection that requested them. */
+final class SkinChangeSession<O> {
+    private Pending<O> pending;
+
+    synchronized CompletableFuture<Boolean> begin(final O owner, final UUID request) {
+        final Pending<O> previous = this.pending;
+        final var next = new Pending<>(owner, request, new CompletableFuture<Boolean>());
+        this.pending = next;
+        if (previous != null) previous.confirmation().complete(false);
+        next.confirmation().completeOnTimeout(false, 45, TimeUnit.SECONDS);
+        next.confirmation().whenComplete((_, _) -> this.remove(next));
+        return next.confirmation();
+    }
+
+    synchronized void complete(final O owner, final UUID request, final boolean confirmed) {
+        final Pending<O> current = this.pending;
+        if (current != null && current.owner() == owner && current.request().equals(request)) {
+            this.pending = null;
+            current.confirmation().complete(confirmed);
+        }
+    }
+
+    synchronized void disconnect(final O owner) {
+        if (this.pending != null && this.pending.owner() == owner) {
+            final Pending<O> previous = this.pending;
+            this.pending = null;
+            previous.confirmation().complete(false);
+        }
+    }
+
+    private synchronized void remove(final Pending<O> completed) {
+        if (this.pending == completed) this.pending = null;
+    }
+
+    private record Pending<O>(O owner, UUID request, CompletableFuture<Boolean> confirmation) {}
+}
