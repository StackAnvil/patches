+    private void applyAppearance(final Appearance appearance) {
+        this.showAppearance(appearance);
+        final CompletableFuture<Boolean> confirmation = ClassicSkinChange.request(appearance);
+        if (confirmation != null) {
+            this.status = Component.translatable("bedrock_dressing_room.viafabricplus.live_request");
+            confirmation.whenComplete((confirmed, error) -> this.minecraft.execute(() -> {
+                if (this.minecraft.gui.screen() == this && this.appearance == appearance) {
+                    this.status = Component.translatable(error == null && confirmed
+                        ? "bedrock_dressing_room.viafabricplus.live_confirmed"
+                        : "bedrock_dressing_room.viafabricplus.live_unconfirmed");
+                }
+            }));
+        }
+    }
