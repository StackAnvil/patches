+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockAppearanceStore.Appearance;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockAppearanceStore.Persona;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockAppearanceStore.Selection;
+import io.netty.buffer.Unpooled;
+import java.awt.image.BufferedImage;
+import java.util.List;
+import java.util.UUID;
+import net.raphimc.viabedrock.protocol.types.model.SkinType;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class BedrockSkinChangeTest {
+
+    @Test
+    void serializesImportedSkinAndCapeForLiveChange() throws Exception {
+        final BufferedImage skinImage = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        final BufferedImage capeImage = new BufferedImage(64, 32, BufferedImage.TYPE_INT_ARGB);
+        skinImage.setRGB(1, 2, 0xFF1A2B3C);
+        capeImage.setRGB(3, 4, 0xFF4D5E6F);
+        final Appearance appearance = new Appearance(Selection.CUSTOM, true, skinImage, capeImage, "skin", "cape", null, new BedrockClassicOptions(java.util.Map.of("move.arms", "animation.player.move.arms.zombie"), java.util.Map.of("hide_armor", true)), null);
+
+        final var skin = appearance.skinData("{}");
+        final var bytes = Unpooled.buffer();
+        try {
+            new SkinType().write(bytes, skin);
+            final var decoded = new SkinType().read(bytes);
+            assertEquals(0xFF1A2B3C, decoded.skinData().getRGB(1, 2));
+            assertNotNull(decoded.capeData());
+            assertEquals(0xFF4D5E6F, decoded.capeData().getRGB(3, 4));
+            assertTrue(decoded.capeOnClassic());
+            assertFalse(decoded.persona());
+            assertTrue(decoded.animations().isEmpty());
+            assertEquals(appearance.classicOptions(), BedrockClassicOptions.read(com.google.gson.JsonParser.parseString(decoded.skinResourcePatch()).getAsJsonObject()));
+            assertEquals(0, bytes.readableBytes());
+        } finally {
+            bytes.release();
+        }
+    }
+
+    @Test
+    void omitsCapeAfterItIsRemoved() {
+        final Appearance appearance = new Appearance(Selection.STEVE, false,
+            new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB), null, "skin", "", null, BedrockClassicOptions.EMPTY, null);
+
+        final var skin = appearance.skinData("{}");
+        assertFalse(skin.capeOnClassic());
+        assertNull(skin.capeData());
+        assertFalse(skin.persona());
+    }
+
+    @Test
+    void serializesConvertedAccountCharacterForLiveChange() throws Exception {
+        final BufferedImage atlas = new BufferedImage(128, 128, BufferedImage.TYPE_INT_ARGB);
+        atlas.setRGB(2, 3, 0xFF356789);
+        final Persona persona = new Persona("{\"minecraft:geometry\":[]}",
+            "{\"geometry\":{\"default\":\"geometry.test\"}}", "profile-hash", "slim", "#ff2474a8", new BedrockPersonaProfile(List.of(
+                new net.raphimc.viabedrock.protocol.model.SkinData.PersonaPieceData("piece", "Hair", UUID.randomUUID().toString(), true, "")),
+                List.of(new net.raphimc.viabedrock.protocol.model.SkinData.PersonaPieceTintData("Hair",
+                    List.of("#ff112233", "#0", "#0", "#0")))), List.of(
+                    new net.raphimc.viabedrock.protocol.model.SkinData.AnimationData(
+                        new BufferedImage(32, 64, BufferedImage.TYPE_INT_ARGB), 1, 2, 1)));
+        final Appearance appearance = new Appearance(Selection.PERSONA, true, atlas, null, "account-skin", "", null, BedrockClassicOptions.EMPTY, persona);
+
+        final var skin = appearance.skinData("");
+        final var bytes = Unpooled.buffer();
+        try {
+            new SkinType().write(bytes, skin);
+            final var decoded = new SkinType().read(bytes);
+            assertTrue(decoded.persona());
+            assertEquals("profile-hash", decoded.profileHash());
+            assertEquals("Slim", decoded.armSize());
+            assertEquals(0xFF356789, decoded.skinData().getRGB(2, 3));
+            assertEquals(persona.geometry(), decoded.geometryData());
+            assertEquals(persona.profile().pieces(), decoded.personaPieces());
+            assertEquals(persona.profile().tints().getFirst().type(), decoded.tintColors().getFirst().type());
+            assertEquals(persona.profile().tints().getFirst().colors().stream()
+                .map(color -> Long.parseLong(color.substring(1), 16)).toList(),
+                decoded.tintColors().getFirst().colors().stream()
+                    .map(color -> Long.parseLong(color.substring(1), 16)).toList());
+            assertEquals(2, decoded.animations().getFirst().frames());
+            assertEquals(64, decoded.animations().getFirst().image().getHeight());
+            assertEquals(0, bytes.readableBytes());
+        } finally {
+            bytes.release();
+        }
+    }
+
+    @Test
+    void loadsUsableNativeGeometryWithoutALocalTranslator() throws Exception {
+        final String geometry = BedrockSkinChange.standardGeometry();
+        for (final String identifier : List.of("geometry.humanoid.custom", "geometry.humanoid.customSlim")) {
+            final var model = BedrockClassicModel.read(geometry, identifier);
+            final var decoded = org.cube.converter.model.impl.bedrock.BedrockGeometryModel.fromJson(model.geometry()).getFirst();
+            assertFalse(decoded.getParents().isEmpty());
+        }
+    }
+
+}
