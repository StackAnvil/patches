+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockAppearanceStore.Appearance;
+import com.viaversion.viafabricplus.bedrock.render.BedrockPlayerSkins;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeSkinChange;
+import net.raphimc.viabedrock.api.model.NativeSkinFragment;
+import net.raphimc.viabedrock.api.resourcepack.content.ZipContent;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+
+/** Uses the same negotiated Java transport for direct translation and ViaProxy. */
+public final class BedrockSkinChange {
+    private static final SkinChangeSession<Connection> SESSION = new SkinChangeSession<>();
+    private static String standardGeometry;
+
+    private BedrockSkinChange() {}
+
+    public static void register() {
+        PayloadTypeRegistry.serverboundPlay().register(NativeSkinChangePayload.TYPE, NativeSkinChangePayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(NativeSkinChangeResultPayload.TYPE, NativeSkinChangeResultPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+                ClientPlayNetworking.registerReceiver(NativeSkinChangeResultPayload.TYPE, (payload, context) -> client.execute(() -> {
+                    if (client.getConnection() == listener) {
+                        SESSION.complete(listener.getConnection(), payload.result().request(), payload.result().confirmed());
+                    }
+                })));
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> SESSION.disconnect(listener.getConnection()));
+    }
+
+    /** A local preview is immediate. Only a matching native server echo confirms synchronization. */
+    public static CompletableFuture<Boolean> request(final Appearance appearance) {
+        final Minecraft client = Minecraft.getInstance();
+        final var listener = client.getConnection();
+        if (listener == null || client.player == null || !ClientPlayNetworking.canSend(NativeSkinChangePayload.TYPE)) return null;
+        final Connection owner = listener.getConnection();
+        final UUID request = UUID.randomUUID();
+        final CompletableFuture<Boolean> confirmation = SESSION.begin(owner, request);
+        try {
+            // Read the real bundled native geometry without initializing a local translator on proxy connections.
+            final var skin = appearance.skinData(appearance.persona() == null ? standardGeometry() : "");
+            final byte[] encoded = NativeSkinFragment.encode(skin);
+            BedrockPlayerSkins.accept(owner, listener.getLocalGameProfile().id(), skin);
+            NativeSkinChange.split(request, encoded, fragment -> ClientPlayNetworking.send(new NativeSkinChangePayload(fragment)));
+        } catch (final RuntimeException failure) {
+            SESSION.complete(owner, request, false);
+            ViaFabricPlusBedrock.impl().logger().warn("Could not request live Bedrock skin", failure);
+        }
+        return confirmation;
+    }
+
+    static synchronized String standardGeometry() {
+        if (standardGeometry == null) {
+            try (final var input = BedrockProtocol.class.getResourceAsStream("/assets/viabedrock/skin_packs/vanilla.mcpack")) {
+                if (input == null) throw new IOException("The bundled native skin pack is missing");
+                standardGeometry = new ZipContent(input.readAllBytes()).getSortedJson("geometry.json").toString();
+            } catch (final IOException failure) {
+                throw new UncheckedIOException("Could not read the bundled native skin geometry", failure);
+            }
+        }
+        return standardGeometry;
+    }
+}
