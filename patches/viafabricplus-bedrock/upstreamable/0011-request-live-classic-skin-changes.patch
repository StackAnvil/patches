+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.NativeSkinChange;
+
+public record NativeSkinChangePayload(NativeSkinChange fragment) implements CustomPacketPayload {
+    public static final Type<NativeSkinChangePayload> TYPE = new Type<>(Identifier.parse(NativeSkinChange.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, NativeSkinChangePayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> NativeSkinChange.TYPE.write(buffer, payload.fragment),
+            buffer -> new NativeSkinChangePayload(NativeSkinChange.TYPE.read(buffer)));
+
+    @Override
+    public Type<NativeSkinChangePayload> type() { return TYPE; }
+}
