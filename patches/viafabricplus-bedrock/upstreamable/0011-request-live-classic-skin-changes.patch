+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class SkinChangeSessionTest {
+    @Test
+    void matchesBothRequestAndActualConnectionAndRetiresReplacedSelections() {
+        final var session = new SkinChangeSession<Object>();
+        final Object owner = new Object();
+        final UUID firstId = UUID.randomUUID();
+        final var first = session.begin(owner, firstId);
+        final UUID nextId = UUID.randomUUID();
+        final var next = session.begin(owner, nextId);
+        assertFalse(first.join());
+        session.complete(owner, firstId, true);
+        session.complete(new Object(), nextId, true);
+        session.disconnect(new Object());
+        assertFalse(next.isDone());
+        session.complete(owner, nextId, true);
+        assertTrue(next.join());
+    }
+
+    @Test
+    void rejectsRetiredConnectionRepliesAndDoesNotLetTimeoutCleanupEraseANewerRequest() {
+        final var session = new SkinChangeSession<Object>();
+        final Object oldOwner = new Object();
+        final UUID oldId = UUID.randomUUID();
+        final var old = session.begin(oldOwner, oldId);
+        old.complete(false); // The same conditional cleanup runs after a timeout.
+        final Object owner = new Object();
+        final UUID id = UUID.randomUUID();
+        final var next = session.begin(owner, id);
+        session.complete(oldOwner, oldId, true);
+        session.disconnect(oldOwner);
+        assertFalse(next.isDone());
+        session.disconnect(owner);
+        assertFalse(next.join());
+        session.complete(owner, id, true);
+        assertFalse(next.join());
+    }
+}
