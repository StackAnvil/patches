+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+import net.raphimc.viabedrock.protocol.ServerboundBedrockPackets;
+import net.raphimc.viabedrock.protocol.data.DataValues;
+import net.raphimc.viabedrock.protocol.model.SkinData;
+import net.raphimc.viabedrock.protocol.storage.EntityTracker;
+import net.raphimc.viabedrock.protocol.storage.PlayerListStorage;
+import net.raphimc.viabedrock.protocol.types.BedrockTypes;
+
+/** Requests a selected-skin change in an already connected Bedrock world. */
+public final class BedrockSkinChange {
+
+    private static final ConcurrentHashMap<UserConnection, Pending> PENDING = new ConcurrentHashMap<>();
+
+    private BedrockSkinChange() {
+    }
+
+    /** Returns a future for the server's matching skin packet, or null when no world is connected. */
+    public static CompletableFuture<Boolean> request(final Appearance appearance) {
+        if (!BedrockProtocolVersion.BEDROCK_LATEST.equals(ViaFabricPlus.api().targetVersion())) {
+            return null;
+        }
+        final UserConnection connection = ViaFabricPlus.api().userConnection();
+        if (connection == null) {
+            return null;
+        }
+        final EntityTracker entities = connection.get(EntityTracker.class);
+        if (entities == null || entities.getClientPlayer() == null || !entities.getClientPlayer().isInitiallySpawned()) {
+            return null;
+        }
+        final UUID bedrockUuid = bedrockPlayerUuid(connection.get(PlayerListStorage.class),
+            entities.getClientPlayer().uniqueId());
+        if (bedrockUuid == null) {
+            return null;
+        }
+
+        final String geometryData = appearance.persona() == null
+            ? BedrockProtocol.MAPPINGS.getBedrockSkinPacks().get(DataValues.VANILLA_SKIN_PACK_KEY)
+                .content().getSortedJson("geometry.json").toString() : "";
+        final SkinData skin = skinData(appearance, geometryData);
+        final CompletableFuture<Boolean> confirmation = new CompletableFuture<>();
+        final Pending pending = new Pending(bedrockUuid, skin.skinId(), confirmation);
+        final Pending previous = PENDING.put(connection, pending);
+        if (previous != null) {
+            previous.confirmation().complete(false);
+        }
+        confirmation.completeOnTimeout(false, 10, TimeUnit.SECONDS);
+        confirmation.whenComplete((_, _) -> PENDING.remove(connection, pending));
+        final PacketWrapper packet = PacketWrapper.create(ServerboundBedrockPackets.PLAYER_SKIN, connection);
+        packet.write(BedrockTypes.UUID, bedrockUuid);
+        packet.write(BedrockTypes.SKIN, skin);
+        packet.write(BedrockTypes.STRING, ""); // localized new skin name
+        packet.write(BedrockTypes.STRING, ""); // localized old skin name
+        try {
+            packet.sendToServer(BedrockProtocol.class);
+        } catch (RuntimeException e) {
+            PENDING.remove(connection, pending);
+            confirmation.complete(false);
+            throw e;
+        }
+        BedrockPlayerSkins.accept(connection, entities.getClientPlayer().javaUuid(), skin);
+        return confirmation;
+    }
+
+    public static void acknowledge(final UserConnection connection, final UUID playerUuid, final SkinData skin) {
+        final Pending pending = PENDING.get(connection);
+        if (pending != null && pending.playerUuid().equals(playerUuid) && pending.skinId().equals(skin.skinId())) {
+            pending.confirmation().complete(true);
+        }
+    }
+
+    private record Pending(UUID playerUuid, String skinId, CompletableFuture<Boolean> confirmation) {
+    }
+
+    static UUID bedrockPlayerUuid(final PlayerListStorage players, final long actorUniqueId) {
+        if (players == null) {
+            return null;
+        }
+        final var player = players.getPlayer(actorUniqueId);
+        return player == null ? null : player.key();
+    }
+
+    static SkinData skinData(final Appearance appearance, final String geometryData) {
+        return appearance.skinData(geometryData);
+    }
+
+
+}
