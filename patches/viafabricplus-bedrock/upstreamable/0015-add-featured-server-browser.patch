@@ -0,0 +1,261 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.servers;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.viabedrock.protocol.data.ProtocolConstants;
+import org.jetbrains.annotations.Nullable;
+
+/** The catalog behind Bedrock's Featured and Creator experiences on the Servers tab. */
+public final class BedrockServerCatalog {
+
+    private static final URI DISCOVERY = URI.create("https://client.discovery.minecraft-services.net/api/v1.0/discovery/MinecraftPE/builds/"
+        + ProtocolConstants.BEDROCK_VERSION_NAME);
+    private static final String SEARCH_PATH = "/api/v2.0/discovery/blob/client";
+    private static final String SCID = "4fc10100-5f7a-4470-899b-280835760c07";
+    private static final String FILTER = "(contentType eq '3PP_V2.0') and platforms/any(tp: tp eq 'xboxone.store' and tp eq 'title.bedrockvanilla')";
+    private static final HttpClient HTTP = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build();
+    private static volatile @Nullable URI serviceUri;
+
+    private BedrockServerCatalog() {
+    }
+
+    public static CompletableFuture<List<Server>> load(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final JsonObject query = new JsonObject();
+                query.addProperty("count", true);
+                query.addProperty("filter", FILTER);
+                query.addProperty("orderBy", "startDate desc");
+                query.addProperty("scid", SCID);
+                query.addProperty("select", "images");
+                query.addProperty("top", 75);
+                final HttpRequest listing = authorized(service().resolve(SEARCH_PATH), account)
+                    .timeout(Duration.ofSeconds(20))
+                    .header("Content-Type", "application/json")
+                    .header("Accept", "application/json")
+                    .header("Accept-Language", Locale.getDefault().toLanguageTag())
+                    .POST(HttpRequest.BodyPublishers.ofString(query.toString())).build();
+                return parse(request(listing));
+            } catch (Exception exception) {
+                throw new IllegalStateException("Could not load Bedrock servers", exception);
+            }
+        });
+    }
+
+    public static CompletableFuture<Map<String, Integer>> playerCounts(final BedrockAuthManager account) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final JsonObject response = request(authorized(service().resolve("/api/v2.0/dataquery/playercounts"), account)
+                    .timeout(Duration.ofSeconds(15)).GET().build());
+                final JsonArray entries = array(response, "result");
+                if (entries == null) {
+                    throw new IOException("Bedrock player counts response has no entries");
+                }
+                final Map<String, Integer> counts = new HashMap<>();
+                for (final JsonElement element : entries) {
+                    if (element.isJsonObject()) {
+                        final JsonObject item = element.getAsJsonObject();
+                        final String id = string(item, "experienceId");
+                        if (!id.isBlank()) {
+                            counts.put(id, number(item, "playerCount", 0));
+                        }
+                    }
+                }
+                return Map.copyOf(counts);
+            } catch (Exception exception) {
+                throw new IllegalStateException("Could not load Bedrock player counts", exception);
+            }
+        });
+    }
+
+    public static CompletableFuture<JoinAddress> join(final BedrockAuthManager account, final Server server) {
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final JsonObject body = new JsonObject();
+                body.addProperty("experienceId", server.experienceId());
+                final JsonObject response = request(authorized(service().resolve("/api/v2.0/join/experience"), account)
+                    .timeout(Duration.ofSeconds(20))
+                    .header("Content-Type", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString(body.toString())).build());
+                final JsonObject data = object(response, "result");
+                final String host = string(data, "ipV4Address");
+                final int port = data == null ? 0 : number(data, "port", 0);
+                if (host.isBlank() || port < 1 || port > 65535) {
+                    throw new IOException("Bedrock experience returned no usable server address");
+                }
+                return new JoinAddress(host, port, string(data, "networkProtocol"));
+            } catch (Exception exception) {
+                throw new IllegalStateException("Could not join Bedrock experience", exception);
+            }
+        });
+    }
+
+    private static URI service() throws IOException, InterruptedException {
+        URI uri = serviceUri;
+        if (uri == null) {
+            final JsonObject discovery = request(HttpRequest.newBuilder(DISCOVERY).timeout(Duration.ofSeconds(15)).GET().build());
+            final JsonObject gatherings = object(object(object(discovery, "result"), "serviceEnvironments"), "gatherings");
+            uri = URI.create(string(object(gatherings, "prod"), "serviceUri"));
+            if (!"https".equals(uri.getScheme()) || uri.getHost() == null
+                || !uri.getHost().endsWith(".minecraft-services.net")) {
+                throw new IOException("Discovery returned an unexpected Bedrock gatherings service");
+            }
+            serviceUri = uri;
+        }
+        return uri;
+    }
+
+    private static HttpRequest.Builder authorized(final URI uri, final BedrockAuthManager account) throws Exception {
+        return HttpRequest.newBuilder(uri)
+            .header("Authorization", account.getMinecraftSession().getUpToDate().getAuthorizationHeader())
+            .header("Client-Version", ProtocolConstants.BEDROCK_VERSION_NAME)
+            .header("User-Agent", "libhttpclient/1.0.0.0");
+    }
+
+    private static JsonObject request(final HttpRequest request) throws IOException, InterruptedException {
+        final HttpResponse<String> response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() / 100 != 2) {
+            throw new IOException("Bedrock catalog returned HTTP " + response.statusCode());
+        }
+        final JsonElement json = JsonParser.parseString(response.body());
+        if (!json.isJsonObject()) {
+            throw new IOException("Bedrock catalog returned invalid JSON");
+        }
+        return json.getAsJsonObject();
+    }
+
+    static List<Server> parse(final JsonObject response) throws IOException {
+        final JsonArray items = array(object(response, "data"), "Items");
+        if (items == null) {
+            throw new IOException("Bedrock catalog response has no server items");
+        }
+        final List<Server> servers = new ArrayList<>();
+        for (final JsonElement item : items) {
+            if (!item.isJsonObject()) {
+                continue;
+            }
+            final JsonObject source = item.getAsJsonObject();
+            final JsonObject properties = object(source, "DisplayProperties");
+            final String id = string(source, "Id");
+            final String name = localized(object(source, "Title"));
+            if (id.isBlank() || name.isBlank() || properties == null) {
+                continue;
+            }
+            final Map<String, String> images = new HashMap<>();
+            final JsonArray imageEntries = array(source, "Images");
+            if (imageEntries != null) {
+                for (final JsonElement image : imageEntries) {
+                    if (image.isJsonObject()) {
+                        final JsonObject data = image.getAsJsonObject();
+                        images.putIfAbsent(string(data, "Tag").toLowerCase(Locale.ROOT), string(data, "Url"));
+                    }
+                }
+            }
+            final List<Activity> activities = new ArrayList<>();
+            final JsonArray games = array(properties, "availableGames");
+            if (games != null) {
+                for (final JsonElement game : games) {
+                    if (game.isJsonObject()) {
+                        final JsonObject data = game.getAsJsonObject();
+                        activities.add(new Activity(string(data, "title"), string(data, "subtitle"),
+                            string(data, "description"), images.getOrDefault(string(data, "imageTag").toLowerCase(Locale.ROOT), "")));
+                    }
+                }
+            }
+            final boolean featured = properties.has("rank") && properties.get("rank").isJsonPrimitive()
+                && properties.get("rank").getAsJsonPrimitive().isNumber();
+            final int rank = featured ? properties.get("rank").getAsInt() : 0;
+            final String experienceId = string(properties, "experienceId");
+            servers.add(new Server(id, experienceId.isBlank() ? id : experienceId,
+                name, localized(object(source, "Description")), string(properties, "creatorName"),
+                string(properties, "url"), number(properties, "port", ProtocolConstants.BEDROCK_DEFAULT_PORT),
+                featured, rank, string(properties, "newsTitle"), string(properties, "news"),
+                images.getOrDefault("icon", images.getOrDefault("thumbnail", "")),
+                images.getOrDefault("banner", ""), List.copyOf(activities)));
+        }
+        servers.sort(Comparator.comparing(Server::featured).reversed()
+            .thenComparing(Comparator.comparingInt(Server::rank).reversed()));
+        return List.copyOf(servers);
+    }
+
+    private static @Nullable JsonObject object(final @Nullable JsonObject source, final String key) {
+        final JsonElement value = source == null ? null : source.get(key);
+        return value != null && value.isJsonObject() ? value.getAsJsonObject() : null;
+    }
+
+    private static @Nullable JsonArray array(final @Nullable JsonObject source, final String key) {
+        final JsonElement value = source == null ? null : source.get(key);
+        return value != null && value.isJsonArray() ? value.getAsJsonArray() : null;
+    }
+
+    private static String string(final @Nullable JsonObject source, final String key) {
+        final JsonElement value = source == null ? null : source.get(key);
+        return value != null && value.isJsonPrimitive() ? value.getAsString() : "";
+    }
+
+    private static int number(final JsonObject source, final String key, final int fallback) {
+        final JsonElement value = source.get(key);
+        return value != null && value.isJsonPrimitive() && value.getAsJsonPrimitive().isNumber()
+            ? value.getAsInt() : fallback;
+    }
+
+    private static String localized(final @Nullable JsonObject translations) {
+        if (translations == null) {
+            return "";
+        }
+        final String locale = Locale.getDefault().toString();
+        for (final String key : List.of(locale, locale.replace('_', '-'), "neutral", "NEUTRAL", "en_US", "en-US")) {
+            final String text = string(translations, key);
+            if (!text.isBlank()) {
+                return text;
+            }
+        }
+        return "";
+    }
+
+    public record Server(String id, String experienceId, String name, String description, String creator, String host, int port,
+                         boolean featured, int rank, String newsTitle, String news, String icon, String banner,
+                         List<Activity> activities) {
+
+        public boolean hasAddress() {
+            return !this.host.isBlank() && this.port > 0 && this.port <= 65535;
+        }
+
+        public String address() {
+            return this.host + ':' + this.port;
+        }
+    }
+
+    public record Activity(String title, String subtitle, String description, String image) {
+    }
+
+    public record JoinAddress(String host, int port, String networkProtocol) {
+
+        public String address() {
+            return this.host + ':' + this.port;
+        }
+    }
+
+}
