+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.servers;
+
+import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.BedrockConnectionUtil;
+import com.viaversion.viafabricplus.bedrock.protocoltranslator.network.NetherNetJsonRpcAddress;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog.JoinAddress;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog.Server;
+import com.viaversion.viafabricplus.util.network.ConnectionUtil;
+import java.util.concurrent.CompletableFuture;
+import net.minecraft.client.Minecraft;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import net.raphimc.minecraftauth.extra.realms.model.RealmsJoinInformation;
+import net.raphimc.viabedrock.api.BedrockProtocolVersion;
+import org.cloudburstmc.netty.channel.nethernet.config.NetherNetAddress;
+
+/** Resolves hosted experiences and connects through the transport requested by Gatherings. */
+public final class BedrockServerConnection {
+
+    private BedrockServerConnection() {
+    }
+
+    public static CompletableFuture<Void> join(final BedrockAuthManager account, final Server server) {
+        final CompletableFuture<JoinAddress> destination = server.hasAddress()
+            ? CompletableFuture.completedFuture(new JoinAddress(server.host(), server.port(), RealmsJoinInformation.PROTOCOL_DEFAULT))
+            : BedrockServerCatalog.join(account, server);
+        return destination.thenCompose(address -> {
+            final CompletableFuture<Void> result = new CompletableFuture<>();
+            Minecraft.getInstance().execute(() -> {
+                try {
+                    final String protocol = address.networkProtocol();
+                    if (protocol.isBlank() || protocol.equalsIgnoreCase(RealmsJoinInformation.PROTOCOL_DEFAULT)) {
+                        ConnectionUtil.connect(address.address(), BedrockProtocolVersion.BEDROCK_LATEST);
+                    } else if (protocol.equalsIgnoreCase(RealmsJoinInformation.PROTOCOL_NETHERNET)) {
+                        BedrockConnectionUtil.connectNetherNet(new NetherNetAddress(address.address()));
+                    } else if (protocol.equalsIgnoreCase(RealmsJoinInformation.PROTOCOL_NETHERNET_JSONRPC)) {
+                        BedrockConnectionUtil.connectNetherNet(new NetherNetJsonRpcAddress(address.address()));
+                    } else {
+                        throw new IllegalArgumentException("Unsupported Bedrock server transport: " + protocol);
+                    }
+                    result.complete(null);
+                } catch (Exception exception) {
+                    result.completeExceptionally(exception);
+                }
+            });
+            return result;
+        });
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/servers/BedrockServerStatus.java b/src/main/java/com/viaversion/viafabricplus/bedrock/servers/BedrockServerStatus.java
