+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog.Activity;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog.Server;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerConnection;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerStatus.Status;
+import com.viaversion.viafabricplus.bedrock.visual.BedrockImageCache;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+import com.viaversion.viafabricplus.screen.base.list.VFPList;
+import com.viaversion.viafabricplus.screen.base.list.VFPListEntry;
+import com.viaversion.viafabricplus.screen.base.list.VFPTextEntry;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import org.jetbrains.annotations.Nullable;
+import org.jspecify.annotations.NonNull;
+
+/** Full catalog details for one Bedrock server or featured experience. */
+public final class BedrockServerDetailsScreen extends VFPScreen {
+
+    private static final int LIST_TOP = 184;
+    private static final int SECONDARY = 0xFFB8B8B8;
+
+    private final Server server;
+    private final @Nullable Status status;
+    private final @Nullable Integer playerCount;
+    private Button joinButton;
+    private boolean joining;
+
+    public BedrockServerDetailsScreen(final Server server, final @Nullable Status status, final @Nullable Integer playerCount) {
+        super(Component.literal(server.name()), true);
+        this.server = server;
+        this.status = status;
+        this.playerCount = playerCount;
+    }
+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    protected void init() {
+        this.addRenderableWidget(new DetailList(this.minecraft, this.width, this.height, LIST_TOP,
+            FOOTER_HEIGHT, 64));
+        this.addRenderableOnly((graphics, mouseX, mouseY, delta) -> this.renderHeader(graphics));
+        this.joinButton = Button.builder(Component.translatable("bedrock_servers.viafabricplus.join"), _ -> this.join()).build();
+        this.addFooter(this.joinButton);
+        super.init();
+    }
+
+    @Override
+    public void tick() {
+        super.tick();
+        this.joinButton.active = ViaFabricPlusBedrock.impl().account().get() != null
+            && !this.joining && Minecraft.getInstance().getConnection() == null;
+    }
+
+    private void join() {
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account != null && !this.joining && Minecraft.getInstance().getConnection() == null) {
+            this.joining = true;
+            BedrockServerConnection.join(account, this.server).whenComplete((unused, error) -> Minecraft.getInstance().execute(() -> {
+                this.joining = false;
+                if (error != null) {
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not join Bedrock server " + this.server.name(), error);
+                    showToast(Component.translatable("bedrock_servers.viafabricplus.join_failed"));
+                }
+            }));
+        }
+    }
+
+    private void renderHeader(final GuiGraphicsExtractor graphics) {
+        final int width = Math.min(680, this.width - 30);
+        final int left = (this.width - width) / 2;
+        if (!this.server.banner().isBlank()) {
+            BedrockImageCache.drawRemote(graphics, this.server.banner(), left, 49, width, 75);
+        }
+        graphics.text(this.font, this.font.plainSubstrByWidth(this.server.name(), width), left, 132, -1);
+        graphics.text(this.font, this.font.plainSubstrByWidth(this.server.creator(), width), left, 145, SECONDARY);
+        final Component statusLine = this.playerCount != null
+            ? Component.translatable("bedrock_servers.viafabricplus.players_online", this.playerCount)
+            : this.status != null
+                ? Component.translatable("bedrock_servers.viafabricplus.players", this.status.players(), this.status.maxPlayers())
+                : Component.literal(this.server.hasAddress() ? this.server.address()
+                    : Component.translatable("bedrock_servers.viafabricplus.assigning_address").getString());
+        graphics.text(this.font, this.font.plainSubstrByWidth(statusLine.getString(), width), left, 160, SECONDARY);
+    }
+
+    private final class DetailList extends VFPList {
+
+        private DetailList(final Minecraft minecraft, final int width, final int height, final int top,
+                           final int bottom, final int entryHeight) {
+            super(minecraft, width, height, top, bottom, entryHeight);
+            this.addText(Component.translatable("bedrock_servers.viafabricplus.about"),
+                BedrockServerDetailsScreen.this.server.description());
+            if (!BedrockServerDetailsScreen.this.server.news().isBlank()) {
+                final String heading = BedrockServerDetailsScreen.this.server.newsTitle().isBlank()
+                    ? Component.translatable("bedrock_servers.viafabricplus.news").getString()
+                    : BedrockServerDetailsScreen.this.server.newsTitle();
+                this.addText(Component.literal(heading), BedrockServerDetailsScreen.this.server.news());
+            }
+            final List<Activity> activities = BedrockServerDetailsScreen.this.server.activities();
+            if (!activities.isEmpty()) {
+                this.addEntry(new VFPTextEntry(Component.translatable("bedrock_servers.viafabricplus.activities")));
+                activities.forEach(activity -> this.addEntry(new ActivityEntry(activity)));
+            }
+        }
+
+        private void addText(final Component heading, final String body) {
+            final List<FormattedCharSequence> lines = BedrockServerDetailsScreen.this.font.split(Component.literal(body),
+                Math.max(1, this.getRowWidth() - VFPListEntry.SLOT_MARGIN * 2));
+            int offset = 0;
+            boolean first = true;
+            do {
+                final int end = Math.min(lines.size(), offset + (first ? 3 : 5));
+                this.addEntry(new TextEntry(first ? heading : Component.empty(), first ? body : "",
+                    List.copyOf(lines.subList(offset, end))));
+                offset = end;
+                first = false;
+            } while (offset < lines.size());
+        }
+
+        @Override
+        public int getRowWidth() {
+            return Math.min(680, this.width - 20);
+        }
+    }
+
+    private static final class TextEntry extends VFPListEntry {
+
+        private final Component heading;
+        private final String body;
+        private final List<FormattedCharSequence> lines;
+
+        private TextEntry(final Component heading, final String body, final List<FormattedCharSequence> lines) {
+            this.heading = heading;
+            this.body = body;
+            this.lines = lines;
+        }
+
+        @Override
+        public @NonNull Component getNarration() {
+            return this.heading.getString().isBlank() ? Component.empty() : this.heading.copy().append(": " + this.body);
+        }
+
+        @Override
+        public void mappedRender(final GuiGraphicsExtractor graphics, final int entryWidth, final int entryHeight) {
+            final Font font = Minecraft.getInstance().font;
+            int y = SLOT_MARGIN;
+            if (!this.heading.getString().isBlank()) {
+                graphics.text(font, this.heading, SLOT_MARGIN, y, -1);
+                y += font.lineHeight + 5;
+            }
+            for (final FormattedCharSequence line : this.lines) {
+                if (y + font.lineHeight > entryHeight) {
+                    break;
+                }
+                graphics.text(font, line, SLOT_MARGIN, y, SECONDARY);
+                y += font.lineHeight + 2;
+            }
+        }
+    }
+
+    private static final class ActivityEntry extends VFPListEntry {
+
+        private final Activity activity;
+
+        private ActivityEntry(final Activity activity) {
+            this.activity = activity;
+        }
+
+        @Override
+        public @NonNull Component getNarration() {
+            return Component.literal(this.activity.title() + ", " + this.activity.subtitle());
+        }
+
+        @Override
+        public void mappedRender(final GuiGraphicsExtractor graphics, final int entryWidth, final int entryHeight) {
+            final Font font = Minecraft.getInstance().font;
+            final int imageSize = Math.min(54, entryHeight - 6);
+            BedrockImageCache.drawRemote(graphics, this.activity.image(), SLOT_MARGIN, SLOT_MARGIN, imageSize, imageSize);
+            final int textX = imageSize + 10;
+            final int textWidth = Math.max(0, entryWidth - textX - SLOT_MARGIN);
+            graphics.text(font, font.plainSubstrByWidth(this.activity.title(), textWidth), textX, SLOT_MARGIN, -1);
+            graphics.text(font, font.plainSubstrByWidth(this.activity.subtitle(), textWidth),
+                textX, SLOT_MARGIN + font.lineHeight + 3, SECONDARY);
+            int y = SLOT_MARGIN + (font.lineHeight + 3) * 2;
+            for (final FormattedCharSequence line : font.split(Component.literal(this.activity.description()), textWidth)) {
+                if (y + font.lineHeight > entryHeight) {
+                    break;
+                }
+                graphics.text(font, line, textX, y, SECONDARY);
+                y += font.lineHeight + 2;
+            }
+        }
+    }
+}
