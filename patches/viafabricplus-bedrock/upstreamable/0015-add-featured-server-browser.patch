--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/servers/BedrockServerStatus.java
@@ -0,0 +1,116 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/florianreuth/viafabricplus-bedrock
+ * Copyright (C) 2023-2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.viaversion.viafabricplus.bedrock.servers;
+
+import java.io.IOException;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.InetAddress;
+import java.net.SocketTimeoutException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ThreadLocalRandom;
+import org.jetbrains.annotations.Nullable;
+
+/** Reads live player counts and latency using RakNet's unconnected ping. */
+public final class BedrockServerStatus {
+
+    private static final byte[] MAGIC = {0x00, (byte) 0xFF, (byte) 0xFF, 0x00,
+        (byte) 0xFE, (byte) 0xFE, (byte) 0xFE, (byte) 0xFE,
+        (byte) 0xFD, (byte) 0xFD, (byte) 0xFD, (byte) 0xFD, 0x12, 0x34, 0x56, 0x78};
+    private static final int TIMEOUT_MILLIS = 1200;
+
+    private BedrockServerStatus() {
+    }
+
+    public static CompletableFuture<@Nullable Status> ping(final BedrockServerCatalog.Server server) {
+        if (!server.hasAddress()) {
+            return CompletableFuture.completedFuture(null);
+        }
+        return CompletableFuture.supplyAsync(() -> {
+            try {
+                final InetAddress[] addresses = InetAddress.getAllByName(server.host());
+                // Prefer IPv4 for the common Bedrock server addresses, but use IPv6 when that is all DNS returns.
+                Arrays.sort(addresses, Comparator.comparingInt(address -> address.getAddress().length));
+                for (final InetAddress address : addresses) {
+                    try {
+                        return query(address, server.port());
+                    } catch (IOException ignored) {
+                        // The next address can still answer.
+                    }
+                }
+            } catch (IOException ignored) {
+                // A catalog entry can be unavailable without failing the list.
+            }
+            return null;
+        });
+    }
+
+    private static Status query(final InetAddress address, final int port) throws IOException {
+        final byte[] ping = ByteBuffer.allocate(1 + Long.BYTES + MAGIC.length + Long.BYTES)
+            .order(ByteOrder.BIG_ENDIAN)
+            .put((byte) 0x01)
+            .putLong(System.currentTimeMillis())
+            .put(MAGIC)
+            .putLong(ThreadLocalRandom.current().nextLong())
+            .array();
+        try (DatagramSocket socket = new DatagramSocket()) {
+            socket.setSoTimeout(TIMEOUT_MILLIS);
+            socket.connect(address, port);
+            final long start = System.nanoTime();
+            socket.send(new DatagramPacket(ping, ping.length));
+            final byte[] bytes = new byte[2048];
+            final DatagramPacket reply = new DatagramPacket(bytes, bytes.length);
+            socket.receive(reply);
+            final long latency = (System.nanoTime() - start) / 1_000_000L;
+            return parse(bytes, reply.getLength(), latency);
+        } catch (SocketTimeoutException exception) {
+            throw new IOException("Bedrock server did not answer its status ping", exception);
+        }
+    }
+
+    static Status parse(final byte[] bytes, final int length, final long latency) throws IOException {
+        if (length < 35) {
+            throw new IOException("Bedrock server sent a short status response");
+        }
+        final ByteBuffer reply = ByteBuffer.wrap(bytes, 0, length).order(ByteOrder.BIG_ENDIAN);
+        if (reply.get() != 0x1C) {
+            throw new IOException("Bedrock server sent an unexpected status response");
+        }
+        reply.getLong(); // Timestamp echoed by the server.
+        reply.getLong(); // Server GUID.
+        final byte[] magic = new byte[MAGIC.length];
+        reply.get(magic);
+        if (!Arrays.equals(magic, MAGIC)) {
+            throw new IOException("Bedrock server status has invalid RakNet magic");
+        }
+        final int size = Short.toUnsignedInt(reply.getShort());
+        if (size > reply.remaining()) {
+            throw new IOException("Bedrock server status has an invalid message length");
+        }
+        final byte[] message = new byte[size];
+        reply.get(message);
+        final String[] fields = new String(message, StandardCharsets.UTF_8).split(";", -1);
+        if (fields.length < 6 || !"MCPE".equals(fields[0])) {
+            throw new IOException("Bedrock server status has an invalid MOTD");
+        }
+        try {
+            return new Status(Math.max(0, Integer.parseInt(fields[4])), Math.max(0, Integer.parseInt(fields[5])),
+                latency, fields[1], fields[3]);
+        } catch (NumberFormatException exception) {
+            throw new IOException("Bedrock server status has invalid player counts", exception);
+        }
+    }
+
+    public record Status(int players, int maxPlayers, long latencyMillis, String motd, String version) {
+    }
+
+}
