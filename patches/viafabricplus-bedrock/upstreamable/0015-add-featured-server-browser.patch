+
+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerCatalog.Server;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerConnection;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerStatus;
+import com.viaversion.viafabricplus.bedrock.servers.BedrockServerStatus.Status;
+import com.viaversion.viafabricplus.bedrock.visual.BedrockImageCache;
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+import com.viaversion.viafabricplus.screen.base.list.VFPListEntry;
+import com.viaversion.viafabricplus.screen.base.list.VFPTextEntry;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+import net.raphimc.minecraftauth.bedrock.BedrockAuthManager;
+import org.jetbrains.annotations.Nullable;
+import org.jspecify.annotations.NonNull;
+
+/** A Java-style browser for the Bedrock Servers tab's live catalog. */
+public final class BedrockServersScreen extends VFPScreen {
+
+    public static final Component TITLE = Component.translatable("screen.viafabricplus.bedrock_servers");
+
+    private static final int TABS_TOP = 48;
+    private static final int LIST_TOP = 76;
+    private static final int ROW_WIDTH = 360;
+    private static final int SECONDARY = 0xFFB8B8B8;
+
+    private enum Tab {
+        FEATURED, CREATOR
+    }
+
+    private Tab tab = Tab.FEATURED;
+    private List<Server> servers = List.of();
+    private final Map<String, Status> statuses = new HashMap<>();
+    private Map<String, Integer> counts = Map.of();
+    private final Set<String> pendingPings = new HashSet<>();
+    private boolean requested;
+    private boolean loading;
+    private boolean failed;
+    private boolean joining;
+    private boolean countsLoading;
+    private long lastCountsRefresh;
+    private long lastStatusRefresh;
+    private int generation;
+    private ServerList list;
+    private Button joinButton;
+    private Button detailsButton;
+    private Button refreshButton;
+    private @Nullable BedrockAuthManager visibleAccount;
+
+    public BedrockServersScreen() {
+        super(TITLE, true);
+    }
+
+    @Override
+    public void renderTitle(final GuiGraphicsExtractor graphics) {
+        super.renderTitle(graphics);
+        graphics.centeredText(this.font, this.title, this.width / 2, 32, -1);
+    }
+
+    @Override
+    protected void rebuildWidgets() {
+        final String selectedId = this.selected() == null ? null : this.selected().id();
+        super.rebuildWidgets();
+        if (selectedId != null) {
+            for (final VFPListEntry entry : this.list.children()) {
+                if (entry instanceof ServerEntry serverEntry && serverEntry.server.id().equals(selectedId)) {
+                    this.list.setFocused(entry);
+                    break;
+                }
+            }
+        }
+    }
+
+    @Override
+    protected void init() {
+        final int tabWidth = Math.min(112, (this.width - 20) / Tab.values().length);
+        final int left = (this.width - tabWidth * Tab.values().length) / 2;
+        for (final Tab choice : Tab.values()) {
+            final Button button = Button.builder(Component.translatable("bedrock_servers.viafabricplus.tab."
+                    + choice.name().toLowerCase()), _ -> this.show(choice))
+                .pos(left + choice.ordinal() * tabWidth, TABS_TOP).size(tabWidth, 20).build();
+            button.active = choice != this.tab;
+            this.addRenderableWidget(button);
+        }
+        this.list = this.addRenderableWidget(new ServerList(this.minecraft, this.width, this.height, LIST_TOP,
+            FOOTER_HEIGHT, this.font.lineHeight * 2 + 16));
+        this.addRenderableOnly((graphics, mouseX, mouseY, delta) -> this.renderDetails(graphics));
+        this.joinButton = Button.builder(Component.translatable("bedrock_servers.viafabricplus.join"), _ -> this.joinOrSignIn()).build();
+        this.detailsButton = Button.builder(Component.translatable("bedrock_servers.viafabricplus.details"), _ -> this.details()).build();
+        this.refreshButton = Button.builder(Component.translatable("bedrock_servers.viafabricplus.refresh"), _ -> this.refresh()).build();
+        this.addFooter(this.joinButton, this.detailsButton, this.refreshButton);
+        super.init();
+        if (!this.requested) {
+            this.visibleAccount = ViaFabricPlusBedrock.impl().account().get();
+            this.refresh();
+        }
+    }
+
+    @Override
+    public void tick() {
+        super.tick();
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account != this.visibleAccount) {
+            this.generation++;
+            this.loading = false;
+            this.countsLoading = false;
+            this.visibleAccount = account;
+            this.refresh();
+        }
+        final Server selected = this.selected();
+        this.joinButton.setMessage(Component.translatable(account == null
+            ? "bedrock_servers.viafabricplus.sign_in_button" : "bedrock_servers.viafabricplus.join"));
+        this.joinButton.active = (account == null || selected != null) && !this.joining
+            && Minecraft.getInstance().getConnection() == null;
+        this.detailsButton.active = selected != null;
+        this.refreshButton.active = account != null && !this.loading;
+        if (!this.servers.isEmpty() && !this.loading) {
+            final long now = System.nanoTime();
+            if (now - this.lastCountsRefresh > 30_000_000_000L) {
+                this.refreshCounts(this.generation);
+            }
+            if (now - this.lastStatusRefresh > 30_000_000_000L) {
+                this.lastStatusRefresh = now;
+                this.pingServers(this.generation);
+            }
+        }
+    }
+
+    private void show(final Tab choice) {
+        if (this.tab != choice) {
+            this.tab = choice;
+            this.rebuildWidgets();
+        }
+    }
+
+    private @Nullable Server selected() {
+        return this.list != null && this.list.getFocused() instanceof ServerEntry entry ? entry.server : null;
+    }
+
+    private void refresh() {
+        if (this.loading) {
+            return;
+        }
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null) {
+            this.servers = List.of();
+            this.statuses.clear();
+            this.counts = Map.of();
+            this.failed = false;
+            this.requested = true;
+            this.rebuildWidgets();
+            return;
+        }
+        this.requested = true;
+        this.loading = true;
+        this.failed = false;
+        final int currentGeneration = ++this.generation;
+        this.countsLoading = false;
+        BedrockServerCatalog.load(account).whenComplete((results, error) -> Minecraft.getInstance().execute(() -> {
+            if (currentGeneration != this.generation) {
+                return;
+            }
+            this.loading = false;
+            this.failed = error != null;
+            if (error == null) {
+                this.servers = results;
+                this.statuses.clear();
+                this.pendingPings.clear();
+                this.counts = Map.of();
+                this.lastStatusRefresh = System.nanoTime();
+                this.pingServers(currentGeneration);
+                this.refreshCounts(currentGeneration);
+            } else {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock server catalog", error);
+                if (!this.servers.isEmpty()) {
+                    showToast(Component.translatable("bedrock_servers.viafabricplus.failed"));
+                }
+            }
+            if (Minecraft.getInstance().gui.screen() == this) {
+                this.rebuildWidgets();
+            }
+        }));
+        if (this.list != null) {
+            this.rebuildWidgets();
+        }
+    }
+
+    private void pingServers(final int currentGeneration) {
+        for (final Server server : this.servers) {
+            if (!server.hasAddress() || !this.pendingPings.add(server.id())) {
+                continue;
+            }
+            BedrockServerStatus.ping(server).whenComplete((status, error) -> Minecraft.getInstance().execute(() -> {
+                if (currentGeneration != this.generation) {
+                    return;
+                }
+                this.pendingPings.remove(server.id());
+                if (status != null) {
+                    this.statuses.put(server.id(), status);
+                }
+            }));
+        }
+    }
+
+    private void refreshCounts(final int currentGeneration) {
+        if (this.countsLoading) {
+            return;
+        }
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (account == null) {
+            return;
+        }
+        this.countsLoading = true;
+        this.lastCountsRefresh = System.nanoTime();
+        BedrockServerCatalog.playerCounts(account).whenComplete((results, error) -> Minecraft.getInstance().execute(() -> {
+            if (currentGeneration != this.generation) {
+                return;
+            }
+            this.countsLoading = false;
+            if (error == null) {
+                this.counts = results;
+            } else {
+                ViaFabricPlusBedrock.impl().logger().debug("Could not refresh Bedrock player counts", error);
+            }
+        }));
+    }
+
+    private void join() {
+        final Server selected = this.selected();
+        final BedrockAuthManager account = ViaFabricPlusBedrock.impl().account().get();
+        if (selected != null && account != null && !this.joining && Minecraft.getInstance().getConnection() == null) {
+            this.joining = true;
+            BedrockServerConnection.join(account, selected).whenComplete((unused, error) -> Minecraft.getInstance().execute(() -> {
+                this.joining = false;
+                if (error != null) {
+                    ViaFabricPlusBedrock.impl().logger().warn("Could not join Bedrock server " + selected.name(), error);
+                    showToast(Component.translatable("bedrock_servers.viafabricplus.join_failed"));
+                }
+            }));
+        }
+    }
+
+    private void joinOrSignIn() {
+        if (ViaFabricPlusBedrock.impl().account().get() == null) {
+            ViaFabricPlusBedrock.impl().account().login();
+        } else {
+            this.join();
+        }
+    }
+
+    private void details() {
+        final Server selected = this.selected();
+        if (selected != null) {
+            new BedrockServerDetailsScreen(selected, this.statuses.get(selected.id()), this.counts.get(selected.experienceId())).open(this);
+        }
+    }
+
+    private void renderDetails(final GuiGraphicsExtractor graphics) {
+        if (this.width < 780) {
+            return;
+        }
+        final Server selected = this.selected();
+        if (selected == null) {
+            return;
+        }
+        final int left = this.width / 2 + ROW_WIDTH / 2 + 16;
+        final int width = this.width - left - 14;
+        final int top = LIST_TOP + 4;
+        int y = top;
+        if (!selected.banner().isBlank()) {
+            final int bannerHeight = Math.min(96, Math.max(48, width / 3));
+            BedrockImageCache.drawRemote(graphics, selected.banner(), left, y, width, bannerHeight);
+            y += bannerHeight + 9;
+        }
+        graphics.text(this.font, fit(selected.name(), width), left, y, -1);
+        y += this.font.lineHeight + 5;
+        graphics.text(this.font, fit(selected.creator(), width), left, y, SECONDARY);
+        y += this.font.lineHeight + 10;
+        final Status status = this.statuses.get(selected.id());
+        if (this.counts.containsKey(selected.experienceId())) {
+            graphics.text(this.font, Component.translatable("bedrock_servers.viafabricplus.players_online",
+                this.counts.get(selected.experienceId())), left, y, -1);
+            y += this.font.lineHeight + 4;
+        } else if (status != null) {
+            graphics.text(this.font, Component.translatable("bedrock_servers.viafabricplus.players",
+                status.players(), status.maxPlayers()), left, y, -1);
+            y += this.font.lineHeight + 4;
+        }
+        if (status != null) {
+            graphics.text(this.font, Component.translatable("bedrock_servers.viafabricplus.ping", status.latencyMillis()),
+                left, y, SECONDARY);
+            y += this.font.lineHeight + 10;
+        }
+        final int bottom = this.height - FOOTER_HEIGHT - 5;
+        for (final FormattedCharSequence line : this.font.split(Component.literal(selected.description()), width)) {
+            if (y + this.font.lineHeight >= bottom) {
+                return;
+            }
+            graphics.text(this.font, line, left, y, SECONDARY);
+            y += this.font.lineHeight + 2;
+        }
+        if (!selected.newsTitle().isBlank() && y + this.font.lineHeight * 2 + 14 < bottom) {
+            y += 10;
+            graphics.text(this.font, fit(selected.newsTitle(), width), left, y, -1);
+            y += this.font.lineHeight + 3;
+            graphics.text(this.font, fit(selected.news(), width), left, y, SECONDARY);
+        }
+    }
+
+    private String fit(final String value, final int width) {
+        return this.font.plainSubstrByWidth(value, Math.max(0, width));
+    }
+
+    private final class ServerList extends ActionList {
+
+        private ServerList(final Minecraft minecraft, final int width, final int height, final int top,
+                           final int bottom, final int entryHeight) {
+            super(minecraft, width, height, top, bottom, entryHeight);
+            final List<Server> visible = BedrockServersScreen.this.servers.stream()
+                .filter(server -> server.featured() == (BedrockServersScreen.this.tab == Tab.FEATURED)).toList();
+            if (visible.isEmpty()) {
+                final String key = ViaFabricPlusBedrock.impl().account().get() == null ? "sign_in"
+                    : BedrockServersScreen.this.loading ? "loading"
+                    : BedrockServersScreen.this.failed ? "failed" : "empty";
+                this.addEntry(new VFPTextEntry(Component.translatable("bedrock_servers.viafabricplus." + key)));
+            } else {
+                visible.forEach(server -> this.addEntry(new ServerEntry(this, server)));
+            }
+        }
+
+        @Override
+        public int getRowWidth() {
+            return Math.min(ROW_WIDTH, this.width - 20);
+        }
+
+        @Override
+        protected boolean activate(final VFPListEntry entry) {
+            if (entry instanceof ServerEntry serverEntry) {
+                BedrockServersScreen.this.join();
+                return true;
+            }
+            return false;
+        }
+    }
+
+    private final class ServerEntry extends VFPListEntry {
+
+        private final ServerList parent;
+        private final Server server;
+
+        private ServerEntry(final ServerList parent, final Server server) {
+            this.parent = parent;
+            this.server = server;
+        }
+
+        @Override
+        public @NonNull Component getNarration() {
+            return Component.literal(this.server.name() + ", " + this.server.creator());
+        }
+
+        @Override
+        public void mappedRender(final GuiGraphicsExtractor graphics, final int entryWidth, final int entryHeight) {
+            final Font font = Minecraft.getInstance().font;
+            final int icon = Math.min(32, entryHeight - 6);
+            final int textX = icon + 9;
+            BedrockImageCache.drawRemote(graphics, this.server.icon(), SLOT_MARGIN, (entryHeight - icon) / 2, icon, icon);
+            final Status status = BedrockServersScreen.this.statuses.get(this.server.id());
+            final Integer count = BedrockServersScreen.this.counts.get(this.server.experienceId());
+            final String right = count != null ? Integer.toString(count)
+                : status == null ? "" : status.players() + "/" + status.maxPlayers();
+            final int nameWidth = entryWidth - textX - font.width(right) - SLOT_MARGIN * 2 - 5;
+            graphics.text(font, font.plainSubstrByWidth(this.server.name(), Math.max(0, nameWidth)),
+                textX, SLOT_MARGIN + 1, this.parent.getFocused() == this ? ACCENT_COLOR : -1);
+            if (!right.isEmpty()) {
+                graphics.text(font, right, entryWidth - font.width(right) - SLOT_MARGIN, SLOT_MARGIN + 1, SECONDARY);
+            }
+            final String subtitle = this.server.creator().isBlank() ? this.server.description() : this.server.creator();
+            graphics.text(font, font.plainSubstrByWidth(subtitle, Math.max(0, entryWidth - textX - SLOT_MARGIN)),
+                textX, SLOT_MARGIN + font.lineHeight + 5, SECONDARY);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/servers/BedrockServerCatalog.java b/src/main/java/com/viaversion/viafabricplus/bedrock/servers/BedrockServerCatalog.java
