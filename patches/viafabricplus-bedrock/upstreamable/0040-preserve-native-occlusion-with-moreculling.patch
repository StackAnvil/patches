+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.shapes.VoxelShape;
+
+/** Accepted native terrain retains its face occlusion independently of model-derived caches. */
+public final class BedrockBlockOcclusion {
+    private BedrockBlockOcclusion() {}
+
+    public static VoxelShape select(final BlockState state, final Direction direction, final VoxelShape cached) {
+        return BedrockRenderingMetadata.active() ? state.getFaceOcclusionShape(direction) : cached;
+    }
+}
