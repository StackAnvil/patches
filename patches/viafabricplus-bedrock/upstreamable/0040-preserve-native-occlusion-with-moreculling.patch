+package com.viaversion.viafabricplus.bedrock.block;
+
+import com.viaversion.viafabricplus.bedrock.render.light.BedrockRenderingMetadata;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.Direction;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.properties.BedPart;
+import net.minecraft.world.level.block.BedBlock;
+import net.minecraft.world.phys.shapes.BooleanOp;
+import net.minecraft.world.phys.shapes.Shapes;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BedrockBlockOcclusionTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void modelDerivedBedFacesNeverHideTheFloorInAnAcceptedBedrockWorld() {
+        try (var metadata = mockStatic(BedrockRenderingMetadata.class)) {
+            metadata.when(BedrockRenderingMetadata::active).thenReturn(true);
+            for (var part : BedPart.values()) {
+                final var bed = Blocks.BED.red().defaultBlockState().setValue(BedBlock.PART, part);
+                final var face = BedrockBlockOcclusion.select(bed, Direction.DOWN, Shapes.block());
+                assertTrue(Shapes.joinIsNotEmpty(Shapes.block(), face, BooleanOp.ONLY_FIRST),
+                        "The floor under the " + part + " must remain visible");
+            }
+            final var stone = BedrockBlockOcclusion.select(Blocks.STONE.defaultBlockState(), Direction.DOWN, Shapes.empty());
+            assertFalse(Shapes.joinIsNotEmpty(Shapes.block(), stone, BooleanOp.ONLY_FIRST),
+                    "A solid neighbor must still occlude the complete floor face");
+        }
+    }
+
+    @Test
+    void leavingTheAcceptedWorldRestoresTheModsCachedFaceWithoutMutatingIt() {
+        try (var metadata = mockStatic(BedrockRenderingMetadata.class)) {
+            final var bed = Blocks.BED.red().defaultBlockState();
+            final var cached = Shapes.block();
+            assertSame(cached, BedrockBlockOcclusion.select(bed, Direction.DOWN, cached));
+            metadata.when(BedrockRenderingMetadata::active).thenReturn(true);
+            assertTrue(BedrockBlockOcclusion.select(bed, Direction.DOWN, cached).isEmpty());
+            metadata.when(BedrockRenderingMetadata::active).thenReturn(false);
+            assertSame(cached, BedrockBlockOcclusion.select(bed, Direction.DOWN, cached));
+        }
+    }
+}
