+package com.viaversion.viafabricplus.bedrock.screen;
+
+import com.viaversion.viafabricplus.screen.base.VFPScreen;
+import java.util.List;
+import java.util.function.BooleanSupplier;
+import net.minecraft.client.gui.Font;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.AbstractButton;
+import net.minecraft.network.chat.Component;
+import net.minecraft.util.FormattedCharSequence;
+
+/**
+ * Shared frame for the Dressing Room screens. The title sits in the top row between Back and the Minecoin
+ * balance, content fills the space above the footer, and one reserved status line keeps messages off buttons.
+ */
+final class BedrockDressingRoomUi {
+    static final int TOP_BAR = 30;
+    static final int MARGIN = 8;
+    static final int GAP = 4;
+    static final int ROW = 20 + GAP;
+    static final int FOOTER = 30;
+    static final int STATUS_LINES = 2;
+    static final int PANEL = 0x66000000;
+    static final int PANEL_BORDER = 0x33FFFFFF;
+    static final int MUTED = 0xFFA0A0A0;
+
+    private static final int BACK_RIGHT = 69;
+    private static final int WALLET_LEFT_MARGIN = 140;
+
+    private BedrockDressingRoomUi() {
+    }
+
+    /** Draws the screen title in the top row, shortened to the space between Back and the balance. */
+    static void title(final GuiGraphicsExtractor graphics, final Font font, final int width, final Component title) {
+        final int walletLeft = width - Math.min(120, Math.max(24, (width - WALLET_LEFT_MARGIN) / 2 - 38)) - 34;
+        final int half = Math.max(20, Math.min(width / 2 - BACK_RIGHT, walletLeft - width / 2));
+        graphics.centeredText(font, ellipsize(font, title, half * 2), width / 2, 11, -1);
+    }
+
+    /** Shows a chosen option with the vanilla highlighted button sprite instead of the disabled one. */
+    static <T extends AbstractButton> T selectable(final T button, final BooleanSupplier selected) {
+        button.setOverrideRenderHighlightedSprite(selected::getAsBoolean);
+        return button;
+    }
+
+    /** The top of the area left for status text, which sits directly above the footer. */
+    static int statusTop(final int height, final boolean footer) {
+        return height - (footer ? FOOTER : 4) - STATUS_LINES * 10 - 2;
+    }
+
+    /** The bottom edge for content, leaving room for the status lines and the footer. */
+    static int contentBottom(final int height, final boolean footer) {
+        return statusTop(height, footer) - GAP;
+    }
+
+    /** Centers up to two lines of status text above the footer, shortening the second line if needed. */
+    static void status(final GuiGraphicsExtractor graphics, final Font font, final int width, final int height,
+                       final boolean footer, final Component status) {
+        if (status == null || status.getString().isEmpty()) return;
+        final int lineWidth = Math.min(width - MARGIN * 2, 400);
+        final List<FormattedCharSequence> lines = font.split(status, lineWidth);
+        final int shown = Math.min(STATUS_LINES, lines.size());
+        final int top = statusTop(height, footer) + (STATUS_LINES - shown) * 10;
+        for (int index = 0; index < shown; index++) {
+            FormattedCharSequence line = lines.get(index);
+            if (index == STATUS_LINES - 1 && lines.size() > STATUS_LINES) {
+                final String rest = status.getString().substring(Math.min(status.getString().length(), plain(lines.getFirst()).length())).strip();
+                line = ellipsize(font, Component.literal(rest).withStyle(status.getStyle()), lineWidth);
+            }
+            graphics.centeredText(font, line, width / 2, top + index * 10, VFPScreen.ACCENT_COLOR);
+        }
+    }
+
+    /** A dark frame behind a preview or list, matching the translucent in-game menu lists. */
+    static void panel(final GuiGraphicsExtractor graphics, final int x, final int y, final int width, final int height) {
+        graphics.fill(x, y, x + width, y + height, PANEL);
+        graphics.fill(x, y, x + width, y + 1, PANEL_BORDER);
+        graphics.fill(x, y + height - 1, x + width, y + height, PANEL_BORDER);
+        graphics.fill(x, y + 1, x + 1, y + height - 1, PANEL_BORDER);
+        graphics.fill(x + width - 1, y + 1, x + width, y + height - 1, PANEL_BORDER);
+    }
+
+    /** A preview column beside a content column, centered and capped so wide windows do not stretch it. */
+    record Split(int previewX, int previewWidth, int contentX, int contentWidth, int top, int bottom) {
+        int height() {
+            return this.bottom - this.top;
+        }
+    }
+
+    /** Tall windows get a capped, vertically centered block so the preview keeps a player-like shape. */
+    static Split split(final int width, final int height, final boolean footer, final int maxContentWidth) {
+        final int available = width - MARGIN * 2;
+        final int top = TOP_BAR + 2;
+        final int bottom = contentBottom(height, footer);
+        final int blockHeight = Math.min(bottom - top, 280);
+        final int previewWidth = Math.clamp(Math.min(available / 3, blockHeight * 3 / 5), 80, 168);
+        final int contentWidth = Math.min(maxContentWidth, available - previewWidth - MARGIN);
+        final int left = (width - previewWidth - MARGIN - contentWidth) / 2;
+        final int blockTop = top + (bottom - top - blockHeight) / 2;
+        return new Split(left, previewWidth, left + previewWidth + MARGIN, contentWidth, blockTop, blockTop + blockHeight);
+    }
+
+    /** Lays out buttons in one row with equal widths. */
+    static void row(final int x, final int y, final int width, final AbstractButton... buttons) {
+        final int buttonWidth = (width - (buttons.length - 1) * GAP) / buttons.length;
+        for (int index = 0; index < buttons.length; index++) {
+            buttons[index].setRectangle(index == buttons.length - 1 ? width - index * (buttonWidth + GAP) : buttonWidth, 20,
+                x + index * (buttonWidth + GAP), y);
+        }
+    }
+
+    static FormattedCharSequence ellipsize(final Font font, final Component text, final int width) {
+        if (font.width(text) <= width) return text.getVisualOrderText();
+        final String shortened = font.plainSubstrByWidth(text.getString(), Math.max(0, width - font.width("...")));
+        return Component.literal(shortened.stripTrailing() + "...").withStyle(text.getStyle()).getVisualOrderText();
+    }
+
+    private static String plain(final FormattedCharSequence line) {
+        final StringBuilder text = new StringBuilder();
+        line.accept((_, _, codePoint) -> {
+            text.appendCodePoint(codePoint);
+            return true;
+        });
+        return text.toString();
+    }
+}
