+    BedrockSkinList(final Minecraft minecraft, final int x, final int y, final int width, final int height,
+                    final IntConsumer selected, final IntConsumer activated) {
+        super(minecraft, width, height, y, ROW_HEIGHT);
+        this.setX(x);
+        this.selected = selected;
+        this.activated = activated;
+    }
+
+    void show(final List<Entry> entries, final int selection) {
+        this.clearEntries();
+        for (int index = 0; index < entries.size(); index++) this.addEntry(new Row(index, entries.get(index)));
+        if (selection >= 0 && selection < entries.size()) {
+            super.setSelected(this.children().get(selection));
+            this.scrollToEntry(this.children().get(selection));
+        }
+    }
+
+    @Override
+    public int getRowWidth() {
+        return this.getWidth() - 12;
+    }
+
+    @Override
+    public void setSelected(final @Nullable Row row) {
+        final boolean changed = row != this.getSelected();
+        super.setSelected(row);
+        if (row != null && changed) this.selected.accept(row.index);
+    }
+
+    final class Row extends ObjectSelectionList.Entry<Row> {
+        private final int index;
+        private final BedrockSkinList.Entry entry;
+
+        private Row(final int index, final BedrockSkinList.Entry entry) {
+            this.index = index;
+            this.entry = entry;
+        }
+
+        @Override
+        public void extractContent(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY,
+                                   final boolean hovered, final float delta) {
+            final var font = BedrockSkinList.this.minecraft.font;
+            final int left = BedrockSkinList.this.getRowLeft() + 4;
+            final int width = BedrockSkinList.this.getRowWidth() - 8;
+            graphics.text(font, BedrockDressingRoomUi.ellipsize(font, this.entry.name(), width), left, this.getY() + 3, -1);
+            graphics.text(font, BedrockDressingRoomUi.ellipsize(font, this.entry.detail(), width), left, this.getY() + 14,
+                BedrockDressingRoomUi.MUTED);
+        }
+
+        @Override
+        public boolean mouseClicked(final MouseButtonEvent click, final boolean doubled) {
+            BedrockSkinList.this.setSelected(this);
+            if (doubled) BedrockSkinList.this.activated.accept(this.index);
+            return true;
+        }
+
+        @Override
+        public Component getNarration() {
+            return Component.translatable("narrator.select", this.entry.name());
+        }
+    }
+}
