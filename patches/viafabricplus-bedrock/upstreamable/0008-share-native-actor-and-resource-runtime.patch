+    public record Visibility(boolean specified, List<List<PartVisibility>> controllers) {
+        public static final Visibility UNSPECIFIED = new Visibility(false, List.of());
+
+        public Visibility {
+            controllers = controllers.stream().map(List::copyOf).toList();
+        }
+
+        public boolean visible(final String bone) {
+            return this.visible(bone, false);
+        }
+
+        public boolean visible(final String bone, final boolean humanoidNames) {
+            if (!this.specified) return true;
+            for (final List<PartVisibility> controller : this.controllers) {
+                boolean visible = true;
+                for (final PartVisibility part : controller)
+                    if (part.matches(bone, humanoidNames)) visible = part.visible;
+                if (visible) return true;
+            }
+            return false;
+        }
+    }
