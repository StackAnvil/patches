+                            .parseString(resolved.getAsJsonObject("description").toString()).getAsJsonObject();
+                    final var higher = com.viaversion.viaversion.libs.gson.JsonParser
+                            .parseString(local.getAsJsonObject("description").toString()).getAsJsonObject();
+                    final var description = EntityDefinitions.mergeDescriptions(lower, higher);
+                    resolved = local.deepCopy();
+                    resolved.add("description", JsonParser.parseString(description.toString()));
+                }
+            }
+            if (resolved == null)
+                throw new IOException("The client entity resource is missing: " + identifier);
+            return resolved;
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid client entity resource", invalid);
+        }
+    }
+
+    Map<String, BedrockSoundEvent> soundDefinitions() {
+        return this.sounds;
+    }
+
+    private Map<String, BedrockSoundEvent> readSounds() throws IOException {
+        try {
+            final Map<String, JsonObject> resolved = new LinkedHashMap<>();
+            for (final Pack pack : this.packs) {
+                final byte[] bytes = pack.files.get("sounds/sound_definitions.json");
+                if (bytes == null) continue;
+                final JsonObject document = json(bytes);
+                final JsonObject definitions =
+                        document.has("sound_definitions")
+                                ? document.getAsJsonObject("sound_definitions")
+                                : document;
+                for (final var entry : definitions.entrySet()) {
+                    if (entry.getKey().equals("format_version")) continue;
+                    resolved.put(
+                            entry.getKey(),
+                            entry.getValue().getAsJsonObject());
+                }
+                if (resolved.size() > 4096) throw new IOException("Too many sound definitions");
+            }
+            final Map<String, BedrockSoundEvent> sounds = new LinkedHashMap<>();
+            for (final var entry : resolved.entrySet())
+                sounds.put(entry.getKey(), BedrockSoundEvent.read(entry.getValue()));
+            return Map.copyOf(sounds);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid sound definition catalog", invalid);
+        }
+    }
+
+    private static JsonObject format(final JsonObject document) {
+        final JsonObject selected = new JsonObject();
+        if (document.has("format_version"))
+            selected.add("format_version", document.get("format_version").deepCopy());
+        return selected;
+    }
+
+    private static void addModel(
+            final Map<String, List<JsonObject>> models,
+            final String identifier,
+            final JsonObject document)
+            throws IOException {
+        if (!MODEL_IDENTIFIER.matcher(identifier).matches())
+            throw new IOException("Invalid built-in model identifier");
+        final List<JsonObject> definitions =
+                models.computeIfAbsent(identifier, name -> new ArrayList<>());
+        if (!definitions.contains(document)) definitions.add(document);
+    }
+
+    private static JsonObject json(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("Missing or oversized vanilla resource");
+        try {
+            return JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8))
+                    .getAsJsonObject();
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid vanilla resource", invalid);
+        }
+    }
+
+    record Definition(JsonObject value, String formatVersion) {}
+
+    private record Pack(String name, Map<String, byte[]> files) {}
+}
