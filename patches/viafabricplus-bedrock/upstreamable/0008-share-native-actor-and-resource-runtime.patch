+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.common.collect.MapMaker;
+import java.util.Map;
+import net.minecraft.world.item.component.CustomData;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+
+/** Decodes immutable native item components once, independently of live item use state. */
+public record BedrockItemMetadata(String identifier, ItemAnimationData animation) {
+    private static final BedrockItemMetadata EMPTY = new BedrockItemMetadata(null, ItemAnimationData.EMPTY);
+    // Weak keys use identity comparison and avoid hashing the full tag on every render query.
+    // Values contain only immutable strings/numbers, never the component or its NBT tree.
+    private static final Map<CustomData, BedrockItemMetadata> CACHE = new MapMaker().weakKeys().makeMap();
+
+    public static BedrockItemMetadata get(final CustomData data) {
+        return data == null ? EMPTY : CACHE.computeIfAbsent(data, BedrockItemMetadata::read);
+    }
+
+    private static BedrockItemMetadata read(final CustomData data) {
+        final var tag = data.copyTag();
+        final String identifier = tag.getString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG).orElse(null);
+        final Integer useDuration = tag.getInt(ItemDataRewriter.BEDROCK_USE_DURATION_TAG)
+                .filter(value -> value >= 0).orElse(null);
+        final var animation = tag.getCompoundOrEmpty(ItemDataRewriter.BEDROCK_ANIMATION_TAG);
+        final var tags = animation.getListOrEmpty("tags").stream()
+                .flatMap(value -> value.asString().stream()).toList();
+        final Integer swingTicks = animation.getInt("swing_duration_ticks").orElse(null);
+        final var kinetic = animation.getCompound("kinetic_weapon").map(value ->
+                new ItemAnimationData.KineticWeapon(value.getIntOr("delay", 0),
+                        value.getIntOr("damage_duration", 0), value.getIntOr("knockback_duration", 0),
+                        value.getIntOr("dismount_duration", 0))).orElse(null);
+        return new BedrockItemMetadata(identifier, new ItemAnimationData(useDuration, tags, swingTicks, kinetic));
+    }
+
+    public static void clear() {
+        CACHE.clear();
+    }
+}
