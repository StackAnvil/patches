+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockItemAnimation;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockGeometryQueriesTest {
+    @Test
+    void samplesAbsoluteBindPivotsAcrossParentAnimationAndRenderConversion() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.query","texture_width":64,"texture_height":64},
+                 "bones":[{"name":"body","pivot":[0,24,0],"rotation":[0,30,0]},
+                  {"name":"rightArm","parent":"body","pivot":[-5,22,0]},
+                  {"name":"rightItem","parent":"rightArm","pivot":[-6,15,1]}]}]}
+                """).getFirst();
+        final var queries = BedrockGeometryQueries.of(geometry);
+        final var animation = BedrockBoneAnimation.parse(JsonParser.parseString("""
+                {"bones":{"body":{"position":[0,12,0],"rotation":[20,40,0]},
+                 "rightitem":{"position":[0,"q.get_default_bone_pivot('rightarm',1) - q.get_default_bone_pivot('rightitem','y') - 7", "-q.get_default_bone_pivot('rightitem',2)"]}}}
+                """).getAsJsonObject());
+        final var pose = animation.playback().sample(0, queries);
+        assertEquals(0, pose.get("rightitem").position().y());
+        assertEquals(-1, pose.get("rightitem").position().z());
+        final var model = BedrockGeometry.animatedModel(geometry, Map.of());
+        model.pose(pose);
+        assertEquals(-5, pivot(queries, List.of("rightarm", 0)));
+        assertEquals(22, pivot(queries, List.of("rightarm", "y")));
+        assertEquals(-6, pivot(queries, List.of("rightitem", "x")));
+        assertEquals(15, pivot(queries, List.of("rightitem", 1.9)));
+        assertEquals(-6, pivot(queries, List.of("rightitem", -0.9)));
+        assertEquals(0, pivot(queries, List.of("rightarm", 3)));
+        assertEquals(0, pivot(queries, List.of("rightarm", -1)));
+        assertEquals(0, pivot(queries, List.of("missing", 1)));
+        assertEquals(0, pivot(queries, List.of("rightarm", "Y")));
+        assertEquals(0, pivot(queries, List.of(0, 1)));
+        assertEquals(0, pivot(queries, List.of("rightarm")));
+        assertEquals(0, pivot(queries, List.of("rightArm", 1)));
+        final var inputs = BedrockFirstPersonInput.bind(new BedrockActorAnimation.Frame(queries, Map.of()), new BedrockItemAnimation(
+                BedrockItemAnimation.Item.EMPTY,
+                BedrockItemAnimation.Item.EMPTY,
+                BedrockItemAnimation.Item.EMPTY,
+                BedrockItemAnimation.Item.EMPTY, 0), 1, 1, 1, 1, .5F);
+        assertEquals(0, inputs.variables().get("short_arm_offset_right"));
+    }
+
+    @Test
+    void retainsAuthoredArmorOffsetsInTheOwnerModelSpace() throws Exception {
+        final var document = com.viaversion.viaversion.libs.gson.JsonParser.parseString("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.owner","texture_width":64,"texture_height":64},
+                  "bones":[{"name":"head","pivot":[0,31,0],"rotation":[0,30,0],
+                    "locators":{"armor_offset.helmet":{"offset":[2,7,-3],"rotation":[0,90,0]}}}]}]}
+                """).getAsJsonObject();
+        final var model = BedrockGeometryModel.fromJson(document.toString()).getFirst();
+        final var queries = BedrockGeometryQueries.of(model, BedrockModelLocators.nativeOffsets(document, model.getIdentifier()));
+        final var offset = (BedrockActorAnimation.Query) queries.get("get_root_locator_offset");
+        final var animation = BedrockBoneAnimation.parse(JsonParser.parseString("""
+                {"bones":{"head":{"position":["q.get_root_locator_offset('armor_offset.helmet',0)",
+                  "q.get_root_locator_offset('armor_offset.helmet',1)","q.get_root_locator_offset('armor_offset.helmet',2)"]}}}
+                """).getAsJsonObject());
+        final var pose = animation.playback().sample(0, queries);
+        assertEquals(new BedrockBoneAnimation.Vector(2, 7, -3), pose.get("head").position());
+        BedrockGeometry.animatedModel(model, Map.of()).pose(pose);
+        assertEquals(7F, ((Number) offset.evaluate(List.of("armor_offset.helmet", "y"))).floatValue());
+        assertEquals(0F, ((Number) offset.evaluate(List.of("missing", 0))).floatValue());
+        assertEquals(0F, ((Number) offset.evaluate(List.of("armor_offset.helmet", 3))).floatValue());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_BONE_QUERIES", matches = ".+")
+    void matchesTargetExecutablePivotResults() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_BONE_QUERIES")))).getAsJsonObject();
+        final JsonObject description = new JsonObject();
+        description.addProperty("identifier", "geometry.native_query_fixture");
+        description.addProperty("texture_width", 64);
+        description.addProperty("texture_height", 64);
+        final JsonObject definition = new JsonObject();
+        definition.add("description", description);
+        final JsonArray bones = new JsonArray();
+        for (final var entry : fixture.getAsJsonObject("pivots").entrySet()) {
+            final JsonObject bone = new JsonObject();
+            bone.addProperty("name", entry.getKey());
+            bone.add("pivot", entry.getValue());
+            bones.add(bone);
+        }
+        definition.add("bones", bones);
+        final JsonObject document = new JsonObject();
+        final JsonArray definitions = new JsonArray();
+        definitions.add(definition);
+        document.add("minecraft:geometry", definitions);
+        final var queries = BedrockGeometryQueries.of(BedrockGeometryModel.fromJson(document.toString()).getFirst());
+        final var empty = BedrockGeometryQueries.of(BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.empty","texture_width":64,"texture_height":64},"bones":[]}]}
+                """).getFirst());
+        for (final var value : fixture.getAsJsonArray("bone")) {
+            final var row = value.getAsJsonObject();
+            final List<Object> arguments = new ArrayList<>();
+            for (final JsonElement argument : row.getAsJsonArray("args")) {
+                arguments.add(argument.getAsJsonPrimitive().isString() ? argument.getAsString() : argument.getAsDouble());
+            }
+            if (row.has("axis_bits")) arguments.set(1, Float.intBitsToFloat(row.get("axis_bits").getAsInt()));
+            final boolean missing = row.has("model") && (!row.get("model").getAsBoolean()
+                    || !row.get("actor").getAsBoolean() || !row.get("client").getAsBoolean());
+            assertEquals(row.get("value").getAsFloat(), pivot(missing ? empty : queries, arguments));
+        }
+    }
+
+    private static float pivot(final Map<String, Object> queries, final List<Object> arguments) {
+        return ((Number) ((BedrockActorAnimation.Query) queries.get("get_default_bone_pivot")).evaluate(arguments)).floatValue();
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockHumanoidVisibilityTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockHumanoidVisibilityTest.java
new file mode 100644
index 0000000..b2e4356
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockHumanoidVisibilityTest.java
@@ -0,0 +1,85 @@
+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Pattern;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.junit.jupiter.api.Test;
+
+final class BedrockHumanoidVisibilityTest {
+    @Test
+    void showsNormalizedSkinArmsWithoutChangingCustomActorNames() {
+        final var visibility = new BedrockActorAnimation.Visibility(true, List.of(List.of(
+                rule("*", false), rule("rightArm", true), rule("rightSleeve", true))));
+        final var humanoid = model(true);
+        humanoid.visibility(visibility);
+        assertTrue(cube(humanoid, "rightarm").visible);
+        assertTrue(cube(humanoid, "rightsleeve").visible);
+        assertFalse(cube(humanoid, "leftarm").visible);
+        assertFalse(cube(humanoid, "body").visible);
+
+        final var custom = model(false);
+        custom.visibility(visibility);
+        assertFalse(cube(custom, "rightarm").visible);
+        assertFalse(cube(custom, "rightsleeve").visible);
+        custom.visibility(new BedrockActorAnimation.Visibility(true, List.of(List.of(
+                rule("*", false), rule("rightarm", true)))));
+        assertTrue(cube(custom, "rightarm").visible);
+    }
+
+    @Test
+    void retainsOrderedHidesAndControllerUnionsForNormalizedSkinBones() {
+        final var humanoid = model(true);
+        humanoid.visibility(new BedrockActorAnimation.Visibility(true, List.of(List.of(
+                rule("*", false), rule("right*", true), rule("rightArm", false)))));
+        assertFalse(cube(humanoid, "rightarm").visible);
+        assertTrue(cube(humanoid, "rightsleeve").visible);
+        assertFalse(cube(humanoid, "leftarm").visible);
+
+        humanoid.visibility(new BedrockActorAnimation.Visibility(true, List.of(
+                List.of(rule("*", false), rule("rightArm", true)),
+                List.of(rule("*", false), rule("leftArm", true)))));
+        assertTrue(cube(humanoid, "rightarm").visible);
+        assertTrue(cube(humanoid, "leftarm").visible);
+        assertFalse(cube(humanoid, "rightsleeve").visible);
+        assertFalse(cube(humanoid, "body").visible);
+
+        humanoid.visibility(new BedrockActorAnimation.Visibility(true, List.of(List.of(rule("*", false)))));
+        assertFalse(cube(humanoid, "rightarm").visible);
+        assertFalse(cube(humanoid, "leftarm").visible);
+        humanoid.visibility(BedrockActorAnimation.Visibility.UNSPECIFIED);
+        assertTrue(cube(humanoid, "rightarm").visible);
+        assertTrue(cube(humanoid, "body").visible);
+    }
+
+    private static BedrockActorAnimation.PartVisibility rule(final String wildcard, final boolean visible) {
+        return new BedrockActorAnimation.PartVisibility(
+                Pattern.compile(Pattern.quote(wildcard).replace("*", "\\E.*\\Q")), visible);
+    }
+
+    static BedrockAnimatedModel model(final boolean humanoid) {
+        final var geometry = BedrockGeometryModel.fromJson("""
+                {"minecraft:geometry":[{"description":{"identifier":"geometry.hand","texture_width":64,"texture_height":64},
+                  "bones":[{"name":"body","pivot":[0,24,0],"cubes":[{"origin":[-4,12,-2],"size":[8,12,4],"uv":[0,0]}]},
+                    {"name":"rightarm","parent":"body","pivot":[5,22,0],"cubes":[{"origin":[4,10,-2],"size":[4,12,4],"uv":[0,0]}]},
+                    {"name":"rightsleeve","parent":"rightarm","pivot":[5,22,0],"cubes":[{"origin":[4,10,-2],"size":[4,12,4],"uv":[0,0]}]},
+                    {"name":"leftarm","parent":"body","pivot":[-5,22,0],"cubes":[{"origin":[-8,10,-2],"size":[4,12,4],"uv":[0,0]}]}]}]}
+                """).getFirst();
+        return humanoid ? BedrockGeometry.animatedModel(geometry, Map.of()) : BedrockGeometry.actorModel(geometry);
+    }
+
+    static ModelPart cube(final BedrockAnimatedModel model, final String bone) {
+        final var body = model.model().root().getChild("body");
+        final var part = switch (bone) {
+            case "body" -> body;
+            case "rightsleeve" -> body.getChild("rightarm").getChild("rightsleeve");
+            default -> body.getChild(bone);
+        };
+        return part.getChild("cube_0");
+    }
+}
