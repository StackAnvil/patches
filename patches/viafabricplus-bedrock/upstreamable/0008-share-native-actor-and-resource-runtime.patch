@@ -0,0 +1,137 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * FSB5 and FADPCM decoding derives from vgmstream under the ISC license.
+ * See assets/viafabricplus-bedrock/licenses/vgmstream.txt for its notices.
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+
+/** Decodes the single-stream FSB5 banks supplied by the licensed Bedrock package. */
+final class BedrockSoundBank {
+    static final int MAX_PCM_BYTES = 64 * 1024 * 1024;
+    private static final int[] RATES = {
+        4000, 8000, 11000, 11025, 16000, 22050, 24000, 32000, 44100, 48000, 96000
+    };
+    private static final int[][] COEFFICIENTS = {
+        {0, 0}, {60, 0}, {122, 60}, {115, 52}, {98, 55}, {0, 0}, {0, 0}
+    };
+    private static final int FADPCM_FRAME_BYTES = 140;
+    private static final int FADPCM_FRAME_SAMPLES = 256;
+
+    private BedrockSoundBank() {}
+
+    static Audio read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length < 68 || bytes.length > BedrockBuiltinAssets.MAX_FILE_BYTES)
+            throw new IOException("Missing or oversized Bedrock sound bank");
+        final ByteBuffer data = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        if (data.getInt(0) != 0x35425346 || data.getInt(4) != 1 || data.getInt(8) != 1)
+            throw new IOException("Unsupported Bedrock sound bank header");
+        final long headerSize = Integer.toUnsignedLong(data.getInt(12));
+        final long nameSize = Integer.toUnsignedLong(data.getInt(16));
+        final long dataSize = Integer.toUnsignedLong(data.getInt(20));
+        final long start = 60 + headerSize + nameSize;
+        if (headerSize < 8 || start + dataSize != bytes.length || data.getInt(32) != 0)
+            throw new IOException("Invalid Bedrock sound bank layout or flags");
+        final int codec = data.getInt(24);
+        if (codec != 2 && codec != 16)
+            throw new IOException("Unsupported Bedrock sound bank codec: " + codec);
+        final long mode = data.getLong(60);
+        final long offset = ((mode >>> 7) & 0x7FFFFFFL) << 5;
+        final int samples = (int) (mode >>> 34);
+        int channels = switch ((int) ((mode >>> 5) & 3)) {
+            case 0 -> 1;
+            case 1 -> 2;
+            default -> throw new IOException("Unsupported Bedrock sound channel count");
+        };
+        final int rateIndex = (int) ((mode >>> 1) & 15);
+        if (rateIndex >= RATES.length) throw new IOException("Invalid Bedrock sound sample rate");
+        int rate = RATES[rateIndex], loopStart = 0, loopEnd = 0;
+        int cursor = 68;
+        boolean continuation = (mode & 1) != 0;
+        while (continuation) {
+            if ((long) cursor + 4 > 60 + headerSize)
+                throw new IOException("Truncated Bedrock sound metadata");
+            final int chunk = data.getInt(cursor);
+            final int size = (chunk >>> 1) & 0xFFFFFF, kind = chunk >>> 25;
+            cursor += 4;
+            if ((long) cursor + size > 60 + headerSize)
+                throw new IOException("Invalid Bedrock sound metadata length");
+            switch (kind) {
+                case 1 -> {
+                    if (size != 1) throw new IOException("Invalid sound channel metadata");
+                    channels = Byte.toUnsignedInt(data.get(cursor));
+                }
+                case 2 -> {
+                    if (size != 4) throw new IOException("Invalid sound sample rate metadata");
+                    rate = data.getInt(cursor);
+                }
+                case 3 -> {
+                    if (size != 8) throw new IOException("Invalid sound loop metadata");
+                    loopStart = data.getInt(cursor);
+                    final long end = Integer.toUnsignedLong(data.getInt(cursor + 4)) + 1;
+                    if (loopStart < 0 || end > samples || loopStart >= end)
+                        throw new IOException("Invalid Bedrock sound loop range");
+                    loopEnd = (int) end;
+                }
+                default -> { /* Other chunk types do not change PCM16 or FADPCM decoding. */ }
+            }
+            cursor += size;
+            continuation = (chunk & 1) != 0;
+        }
+        final long pcmSize = (long) samples * channels * 2;
+        if (samples <= 0 || channels < 1 || channels > 2 || rate < 1000 || rate > 192000
+                || pcmSize > MAX_PCM_BYTES || offset > dataSize)
+            throw new IOException("Invalid Bedrock sound dimensions");
+        int source = (int) (start + offset);
+        final byte[] pcm;
+        if (codec == 2) {
+            if (pcmSize > dataSize - offset) throw new IOException("Truncated Bedrock PCM sound");
+            pcm = Arrays.copyOfRange(bytes, source, source + (int) pcmSize);
+        } else {
+            final long blocks = ((long) samples + FADPCM_FRAME_SAMPLES - 1) / FADPCM_FRAME_SAMPLES;
+            if (blocks * channels * FADPCM_FRAME_BYTES > dataSize - offset)
+                throw new IOException("Truncated Bedrock FADPCM sound");
+            pcm = new byte[(int) pcmSize];
+            final ByteBuffer output = ByteBuffer.wrap(pcm).order(ByteOrder.LITTLE_ENDIAN);
+            for (int first = 0; first < samples; first += FADPCM_FRAME_SAMPLES) {
+                for (int channel = 0; channel < channels; channel++) {
+                    frame(data, source, output, first, samples, channel, channels);
+                    source += FADPCM_FRAME_BYTES;
+                }
+            }
+        }
+        return new Audio(pcm, rate, channels, samples, loopStart, loopEnd);
+    }
+
+    private static void frame(
+            final ByteBuffer data, final int offset, final ByteBuffer output, final int first,
+            final int samples, final int channel, final int channels) {
+        final int predictors = data.getInt(offset), shifts = data.getInt(offset + 4);
+        int recent = data.getShort(offset + 8), older = data.getShort(offset + 10);
+        for (int set = 0; set < 8; set++) {
+            final int[] coefficients = COEFFICIENTS[((predictors >>> (set * 4)) & 15) % 7];
+            final int shift = 22 - ((shifts >>> (set * 4)) & 15);
+            for (int word = 0; word < 4; word++) {
+                final int nibbles = data.getInt(offset + 12 + set * 16 + word * 4);
+                for (int nibble = 0; nibble < 8; nibble++) {
+                    int sample = (((nibbles >>> (nibble * 4)) & 15) << 28) >> shift;
+                    sample = Math.clamp((sample - older * coefficients[1] + recent * coefficients[0]) >> 6,
+                            Short.MIN_VALUE, Short.MAX_VALUE);
+                    final int index = first + set * 32 + word * 8 + nibble;
+                    if (index < samples) output.putShort((index * channels + channel) * 2, (short) sample);
+                    older = recent;
+                    recent = sample;
+                }
+            }
+        }
+    }
+
+    record Audio(byte[] pcm, int sampleRate, int channels, int samples, int loopStart, int loopEnd) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockSoundCaptions.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockSoundCaptions.java
