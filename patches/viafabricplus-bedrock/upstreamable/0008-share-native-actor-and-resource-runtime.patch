@@ -0,0 +1,151 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.joml.Vector3f;
+
+import java.io.IOException;
+import java.util.Locale;
+
+/** Native billboard columns preserve reflected and sheared emitter planes. */
+final class BedrockParticleFacing {
+    private static final float EPSILON = Math.ulp(1F), MIN_DIRECTION = .0001F, POLE = .999F;
+    private static final float PLANE_COSINE = 4.3711388e-8F, PLANE_SINE = .99999994F;
+
+    enum Mode {
+        ROTATE_XYZ, ROTATE_Y, LOOKAT_XYZ, LOOKAT_Y, LOOKAT_DIRECTION,
+        DIRECTION_X, DIRECTION_Y, DIRECTION_Z, EMITTER_TRANSFORM_XY, EMITTER_TRANSFORM_XZ, EMITTER_TRANSFORM_YZ;
+
+        static Mode read(final String value) throws IOException {
+            for (final Mode mode : values())
+                if (mode.name().toLowerCase(Locale.ROOT).equals(value)) return mode;
+            throw new IOException("Unsupported particle facing mode: " + value);
+        }
+    }
+
+    record Basis(Vector3f x, Vector3f y, Vector3f z) {
+        private static Basis identity() {
+            return new Basis(new Vector3f(1, 0, 0), new Vector3f(0, 1, 0), new Vector3f(0, 0, 1));
+        }
+
+        Basis rotate(final float degrees) {
+            if (Math.abs(degrees) <= EPSILON) return this;
+            final float radians = degrees * .017453292F;
+            final float cosine = (float) Math.cos(radians), sine = (float) Math.sin(radians);
+            return new Basis(new Vector3f(this.x).mul(cosine).add(new Vector3f(this.y).mul(sine)),
+                    new Vector3f(this.x).mul(-sine).add(new Vector3f(this.y).mul(cosine)), new Vector3f(this.z));
+        }
+
+        Vector3f point(final float x, final float y) {
+            return new Vector3f(this.x).mul(x).add(new Vector3f(this.y).mul(y));
+        }
+
+        Vector3f extent(final float width, final float height) {
+            return new Vector3f(Math.abs(this.x.x * width) + Math.abs(this.y.x * height),
+                    Math.abs(this.x.y * width) + Math.abs(this.y.y * height),
+                    Math.abs(this.x.z * width) + Math.abs(this.y.z * height));
+        }
+
+        boolean finite() { return this.x.isFinite() && this.y.isFinite() && this.z.isFinite(); }
+    }
+
+    static Basis basis(final Mode mode, final Vector3f relative, final Vector3f direction,
+                       final BedrockParticleAttachment.Matrix camera, final BedrockParticleAttachment.Matrix emitter) {
+        return switch (mode) {
+            case ROTATE_XYZ -> columns(camera);
+            case ROTATE_Y -> {
+                final Vector3f forward = columns(camera).z;
+                forward.y = 0;
+                final float length = (float) Math.sqrt(forward.z * forward.z + forward.x * forward.x);
+                if (length <= EPSILON) yield Basis.identity();
+                forward.mul(1F / length);
+                yield new Basis(new Vector3f(forward.z, 0, -forward.x), new Vector3f(0, 1, 0), forward);
+            }
+            case LOOKAT_XYZ -> lookAt(relative);
+            case LOOKAT_Y -> lookAt(new Vector3f(relative.x, 0, relative.z));
+            case LOOKAT_DIRECTION -> {
+                final float length = length(relative);
+                if (length <= EPSILON) yield Basis.identity();
+                final Vector3f view = new Vector3f(relative).negate().mul(1F / length);
+                final Vector3f x = new Vector3f(direction), y = normalized(view.cross(x));
+                yield new Basis(x, y, new Vector3f(x).cross(y));
+            }
+            case DIRECTION_X, DIRECTION_Y, DIRECTION_Z -> along(mode, direction);
+            case EMITTER_TRANSFORM_XY, EMITTER_TRANSFORM_XZ, EMITTER_TRANSFORM_YZ -> emitter(mode, emitter);
+        };
+    }
+
+    static Vector3f direction(final BedrockParticleAttachment.Matrix matrix, final Vector3f value) {
+        final Vector3f result = matrix.direction(new Vector3f(value));
+        final float length = (float) Math.sqrt(result.z * result.z + (result.y * result.y + result.x * result.x));
+        return length < MIN_DIRECTION ? result.zero() : result.div(length);
+    }
+
+    static Basis emitter(final Mode mode, final BedrockParticleAttachment.Matrix matrix) {
+        final Basis columns = columns(matrix);
+        // The native renderer normalizes each column independently before its fixed quarter turn.
+        final Vector3f x = unitColumn(columns.x), y = unitColumn(columns.y), z = unitColumn(columns.z);
+        if (mode == Mode.EMITTER_TRANSFORM_XZ) {
+            return new Basis(new Vector3f(x).mul(PLANE_SINE).add(new Vector3f(y).mul(0)).add(new Vector3f(z).mul(0)),
+                    new Vector3f(x).mul(0).sub(new Vector3f(y).mul(PLANE_COSINE)).sub(z),
+                    new Vector3f(x).mul(0).add(y).sub(new Vector3f(z).mul(PLANE_COSINE)));
+        }
+        if (mode == Mode.EMITTER_TRANSFORM_YZ) {
+            return new Basis(new Vector3f(y).mul(0).sub(new Vector3f(x).mul(PLANE_COSINE)).sub(z),
+                    new Vector3f(x).mul(0).add(new Vector3f(y).mul(PLANE_SINE)).add(new Vector3f(z).mul(0)),
+                    new Vector3f(y).mul(0).add(x).sub(new Vector3f(z).mul(PLANE_COSINE)));
+        }
+        return new Basis(x, y, z);
+    }
+
+    private static Basis lookAt(final Vector3f relative) {
+        final float length = length(relative);
+        if (length <= EPSILON) return Basis.identity();
+        final Vector3f z = new Vector3f(relative).negate().mul(1F / length);
+        final Vector3f x = normalized(new Vector3f(0, 1, 0).cross(z));
+        return new Basis(x, new Vector3f(z).cross(x), z);
+    }
+
+    private static Basis along(final Mode mode, final Vector3f direction) {
+        final Vector3f axis = normalized(new Vector3f(direction));
+        final Vector3f other;
+        if (axis.y > POLE) other = new Vector3f(1, 0, 0);
+        else if (axis.y < -POLE) other = new Vector3f(-1, -0F, -0F);
+        else other = normalized(new Vector3f(axis).cross(0, 1, 0));
+        return switch (mode) {
+            case DIRECTION_X -> Math.abs(axis.y) > POLE
+                    ? new Basis(axis, other, new Vector3f(0, 0, 1))
+                    : new Basis(axis, new Vector3f(other).cross(axis), other);
+            case DIRECTION_Y -> Math.abs(axis.y) > POLE
+                    ? new Basis(other, axis, new Vector3f(0, 0, 1))
+                    : new Basis(other, axis, new Vector3f(other).cross(axis));
+            case DIRECTION_Z -> {
+                final Vector3f x = Math.abs(axis.y) > POLE ? other : other.negate();
+                yield new Basis(x, Math.abs(axis.y) > POLE ? new Vector3f(0, 0, 1) : new Vector3f(axis).cross(x), axis);
+            }
+            default -> throw new IllegalArgumentException("Invalid direction facing mode");
+        };
+    }
+
+    private static Basis columns(final BedrockParticleAttachment.Matrix matrix) {
+        final float[] values = matrix.values();
+        return new Basis(new Vector3f(values[0], values[1], values[2]), new Vector3f(values[4], values[5], values[6]),
+                new Vector3f(values[8], values[9], values[10]));
+    }
+
+    private static Vector3f unitColumn(final Vector3f value) {
+        return value.mul(1F / (float) Math.sqrt((value.x * value.x + value.y * value.y) + value.z * value.z));
+    }
+
+    private static float length(final Vector3f value) {
+        return (float) Math.sqrt((value.z * value.z + value.y * value.y) + value.x * value.x);
+    }
+
+    private static Vector3f normalized(final Vector3f value) {
+        final float length = length(value);
+        return length < MIN_DIRECTION ? value.zero() : value.div(length);
+    }
+}
