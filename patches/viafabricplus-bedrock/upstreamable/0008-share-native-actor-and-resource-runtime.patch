+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonPrimitive;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+
+/** Evaluates the server's player controller graph using one actor-local variable scope. */
+public final class BedrockPlayerControllers {
+    private final BedrockEntityData entity;
+    private final Map<String, BedrockRenderController> controllers;
+    private final Map<String, UvAnimation> uvAnimations;
+    private final Map<String, BedrockBonePattern> visibilityPatterns;
+    private final BedrockMolang molang = new BedrockMolang();
+    private final Map<String, BedrockMolang.Program> programs = new HashMap<>();
+    private final Map<List<String>, BedrockMolang.Program> scripts = new HashMap<>();
+    private boolean initialized;
+    private float previousTime;
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers) {
+        this(entity, controllers, Map.of());
+    }
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers,
+            final Map<String, UvAnimation> uvAnimations) {
+        this.entity = entity;
+        this.controllers = Map.copyOf(controllers);
+        this.uvAnimations = Map.copyOf(uvAnimations);
+        final Map<String, BedrockBonePattern> patterns = new HashMap<>();
+        for (final var controller : this.controllers.values()) {
+            for (final var rule : controller.partVisibility())
+                patterns.computeIfAbsent(rule.pattern(), BedrockBonePattern::wildcard);
+        }
+        this.visibilityPatterns = Map.copyOf(patterns);
