+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.nio.charset.StandardCharsets;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleSoundTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeDispatchOrderCoordinatesAndUnknownSuppression() throws Exception {
+        for (final var entry : fixture("native-particle-sound-dispatch-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final boolean known = row.get("event").getAsInt() != 614;
+            final JsonObject leaf = new JsonObject(), sound = new JsonObject(), document = new JsonObject();
+            // These native cases supply raw enum fields. Compare dispatch, not enum-name mapping.
+            sound.addProperty("event_name", known ? "BLOCK.CLICK" : "unknown.test.event");
+            leaf.add("sound_effect", sound);
+            if (row.get("expression").getAsBoolean()) leaf.addProperty("expression", "v.trace=17;");
+            if (row.get("log").getAsBoolean()) leaf.addProperty("log", "test");
+            document.add("run", leaf);
+            final var position = row.getAsJsonArray("position");
+            final var origin = new Vector3f(position.get(0).getAsFloat(), position.get(1).getAsFloat(), position.get(2).getAsFloat());
+            final var environment = new BedrockMolang();
+            final List<String> actual = new ArrayList<>(), expected = new ArrayList<>();
+            BedrockParticleEvents.read(document).run(List.of("run"), environment, new Random(1), origin, new Vector3f(), action -> {
+                final var request = assertInstanceOf(BedrockParticleEvents.Sound.class, action);
+                assertEquals(origin, request.position());
+                assertEquals(0, environment.evaluate(variable(), 0));
+                actual.add("sound");
+            }, _ -> {
+                assertEquals(row.get("expression").getAsBoolean() ? 17 : 0, environment.evaluate(variable(), 0));
+                actual.add("log");
+            });
+            for (final var receipt : row.getAsJsonArray("trace")) {
+                final var observed = receipt.getAsJsonObject();
+                if (!observed.has("phase")) continue;
+                final String phase = observed.get("phase").getAsString();
+                if (!phase.equals("level")) expected.add(phase);
+            }
+            assertEquals(expected, actual);
+            assertEquals(row.get("expression").getAsBoolean() ? 17 : 0, environment.evaluate(variable(), 0));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeRangeParsingAndSampling() throws Exception {
+        for (final var entry : fixture("native-particle-sound-range-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var incoming = row.getAsJsonArray("incoming");
+            final var result = row.getAsJsonArray("result");
+            assertEquals(new BedrockLevelSounds.Range(result.get(0).getAsFloat(), result.get(1).getAsFloat()),
+                    BedrockLevelSounds.Range.read(row.get("input"), new BedrockLevelSounds.Range(incoming.get(0).getAsFloat(), incoming.get(1).getAsFloat())));
+        }
+        for (final var entry : fixture("native-particle-sound-volume-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final float volume = BedrockLevelSounds.volume(row.get("input").getAsFloat());
+            assertEquals(row.getAsJsonObject("result").get("volume").getAsFloat(), volume);
+            assertEquals(row.getAsJsonObject("result").get("play").getAsBoolean(), volume > 0);
+        }
+        for (final var entry : fixture("native-particle-sound-sample-result.json").getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var limits = row.getAsJsonArray("range");
+            final var draws = row.getAsJsonArray("draws");
+            final int[] index = {0};
+            final var random = new Random() {
