+    static boolean packName(final String name) {
+        if (name.equals("vanilla") || name.equals("vanilla_base")) return true;
+        final var match = VERSION_PACK.matcher(name);
+        if (!match.matches()) return false;
+        try {
+            for (int part = 1; part <= 3; part++)
+                if (match.group(part) != null) Integer.parseInt(match.group(part));
+            return true;
+        } catch (NumberFormatException invalid) {
+            return false;
+        }
+    }
+
+    private static final Comparator<String> PACK_ORDER =
+            (left, right) -> {
+                final int leftRank = rank(left), rightRank = rank(right);
+                if (leftRank != rightRank) return Integer.compare(leftRank, rightRank);
+                if (leftRank < 2) return 0;
+                final String[] leftParts = left.substring("vanilla_".length()).split("\\.");
+                final String[] rightParts = right.substring("vanilla_".length()).split("\\.");
+                for (int part = 0; part < 3; part++) {
+                    final int result =
+                            Integer.compare(
+                                    part < leftParts.length ? Integer.parseInt(leftParts[part]) : 0,
+                                    part < rightParts.length
+                                            ? Integer.parseInt(rightParts[part])
+                                            : 0);
+                    if (result != 0) return result;
+                }
+                return 0;
+            };
