+        assertEquals(new BedrockLevelSounds.Range(1.2F, 1.2F), configurations.get("block.click").pitch());
+        assertEquals(new BedrockLevelSounds.Range(.5F, .8F), configurations.get("drip.lava.pointed_dripstone").pitch());
+        assertEquals(2, configurations.size());
+        final var graph = BedrockParticleEvents.read(json("""
+                {"run":{"particle_effect":{"effect":"test:child","type":"emitter"},
+                  "sound_effect":{"event_name":"BLOCK.CLICK"},"expression":"v.trace=1;","log":"finished"}}
+                """));
+        final var environment = new BedrockMolang();
+        final List<BedrockParticleEvents.Action> requests = new ArrayList<>();
+        graph.run(List.of("run"), environment, new Random(1), new Vector3f(1, 2, 3), new Vector3f(), action -> {
+            assertEquals(0, environment.evaluate(variable(), 0));
+            requests.add(action);
+        }, _ -> assertEquals(1, environment.evaluate(variable(), 0)));
+        assertInstanceOf(BedrockParticleEvents.Request.class, requests.getFirst());
+        final var sound = assertInstanceOf(BedrockParticleEvents.Sound.class, requests.getLast());
+        final var exposed = sound.position(); exposed.zero();
+        assertEquals(new Vector3f(1, 2, 3), sound.position());
+        assertThrows(IOException.class, () -> BedrockLevelSounds.Range.read(JsonParser.parseString("1e99"), BedrockLevelSounds.Range.UNSET));
