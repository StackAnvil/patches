+        private List<Active> create(final List<Reference> references) {
+            final List<Active> values = new ArrayList<>();
+            for (final Reference reference : references) {
+                final String name = reference.direct ? reference.name : aliases.get(reference.name);
+                if (name == null || name.isEmpty()) continue;
+                if (++this.allocated > 4096) break;
+                values.add(
+                        new Active(
+                                reference,
+                                name.startsWith("controller.animation.") || controllers.containsKey(name),
+                                animations.get(name),
+                                controllers.get(name)));
+            }
+            return List.copyOf(values);
+        }
+
+        private void run(final List<BedrockMolang.Program> programs) {
+            programs.forEach(program -> this.molang.evaluate(program, 0));
+        }
+
+        private final class Active {
+            private final Reference reference;
+            private final boolean controllerReference;
+            private final BedrockBoneAnimation animation;
+            private final Controller controller;
+            private final Map<String, StatePlayback> states = new HashMap<>();
+            private BedrockBoneAnimation.Playback playback;
+            private StatePlayback current, outgoing, pending;
+            private float elapsed, blendTime;
+
+            private Active(
+                    final Reference reference,
+                    final boolean controllerReference,
+                    final BedrockBoneAnimation animation,
+                    final Controller controller) {
+                this.reference = reference;
+                this.controllerReference = controllerReference;
+                this.animation = animation;
+                this.controller = controller;
+                if (animation != null) this.playback = animation.playback(molang);
+            }
+
+            private boolean completed() {
+                return this.playback != null
+                        ? this.playback.completed()
+                        : this.current != null && this.current.completed;
+            }
+
+            private void reset() {
+                this.elapsed = 0;
+                if (this.animation != null) this.playback = this.animation.playback(molang);
+                // Native nested controllers retain their selected state when their player resets.
+                else if (this.current != null) this.current.reset();
+            }
+
+            private StatePlayback state(final String name) {
+                return this.states.computeIfAbsent(
+                        name, key -> new StatePlayback(this.controller.states.getOrDefault(key, EMPTY_STATE)));
+            }
+
+            private void apply(
+                    final float time,
+                    final float inheritedWeight,
+                    final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                // Unresolved native animation players retain their incomplete state without
+                // updates.
+                if (this.playback == null && !this.controllerReference) return;
+                final float weight = inheritedWeight * molang.evaluate(this.reference.weight, 1);
+                if (weight < Math.ulp(1F)) return;
+                if (this.playback != null) {
+                    this.elapsed += delta;
+                    this.animation.compose(
+                            pose, this.playback.sample(this.elapsed, queries, pose, eventsEnabled, Playback.this::sound, Playback.this::particle), weight);
+                    molang.queries(queries, 0, time, delta);
+                    return;
+                }
+                if (this.controller == null) return;
+                final var saved = molang.saveVariables(this.controller.variables);
+                StatePlayback entered = null;
+                try {
+                    final boolean first = this.current == null;
+                    if (first) this.current = this.state(this.controller.initial);
+                    if (this.pending != null) {
+                        final StatePlayback previous = this.current;
+                        if (!first) {
+                            queryState = previous;
+                            previous.time += delta;
+                        }
+                        this.current = this.pending;
+                        this.pending = null;
+                        this.current.reset();
+                        this.outgoing = first || previous.definition.blend.isEmpty() ? null : previous;
+                        this.blendTime = 0;
+                        if (!first && previous != this.current && eventsEnabled)
+                            run(previous.definition.exit);
+                        if (first || previous != this.current) {
+                            if (eventsEnabled) run(this.current.definition.entry);
+                            entered = this.current;
+                        }
+                    } else if (first && this.controller.deferredEntry) {
+                        this.current.reset();
+                        if (eventsEnabled) run(this.current.definition.entry);
+                        entered = this.current;
+                    } else {
+                        queryState = this.current;
+                        this.current.time += delta;
+                        boolean transitioned = false;
+                        for (final Transition transition : this.current.definition.transitions) {
+                            if (molang.evaluate(transition.condition, 0) == 0) continue;
+                            final StatePlayback previous = this.current;
+                            this.current = this.state(transition.target);
+                            this.current.reset();
+                            this.outgoing = previous.definition.blend.isEmpty() ? null : previous;
+                            this.blendTime = 0;
+                            if (!first && previous != this.current && eventsEnabled)
+                                run(previous.definition.exit);
+                            if (first || previous != this.current) {
+                                if (eventsEnabled) run(this.current.definition.entry);
+                                entered = this.current;
+                            }
+                            transitioned = true;
+                            break;
+                        }
+                        if (first && !transitioned) {
+                            if (eventsEnabled) run(this.current.definition.entry);
+                            entered = this.current;
+                        }
+                    }
+                    this.applyStates(time, weight, queries, pose);
+                    // The native controller queues entry sounds after its sampled children.
+                    if (entered != null && eventsEnabled) {
+                        entered.definition.particles.forEach(declaration -> Playback.this.particle(
+                                new BedrockAnimationParticle.Cue(declaration, molang.copy())));
+                        entered.definition.sounds.forEach(Playback.this::sound);
+                    }
+                } finally {
+                    queryState = null;
+                    molang.restoreVariables(saved);
+                }
+            }
+
+            private void applyStates(
+                    final float time, final float weight, final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                if (this.outgoing == null) {
+                    this.current.apply(time, weight, queries, pose);
+                    return;
+                }
+                this.outgoing.time += delta;
+                this.blendTime += delta;
+                final float oldWeight = curve(this.outgoing.definition.blend, this.blendTime);
+                if (oldWeight < Math.ulp(1F)) {
+                    final StatePlayback previous = this.outgoing;
+                    this.outgoing = null;
+                    this.blendTime = 0;
+                    this.current.apply(time, weight, queries, pose);
+                    previous.time = 0;
+                } else if (this.outgoing.definition.shortestPath) {
+                    final Map<String, BedrockBoneAnimation.Transform>
+                            before = new LinkedHashMap<>(),
+                            after = new LinkedHashMap<>();
+                    this.outgoing.apply(time, 1, queries, before);
+                    this.current.apply(time, 1, queries, after);
+                    BedrockBoneAnimation.blendStates(pose, before, after, 1 - oldWeight);
+                } else {
+                    // The target controller uses curve weights directly during a crossfade.
+                    this.outgoing.apply(time, oldWeight, queries, pose);
+                    this.current.apply(time, 1 - oldWeight, queries, pose);
+                }
+            }
+        }
+
+        private final class StatePlayback {
+            private State definition;
+            private final List<Active> children;
+            private long commandRevision;
+            private float time;
+            private boolean completed;
+
+            private StatePlayback(final State definition) {
+                this.definition = definition;
+                this.children = new ArrayList<>(create(definition.animations));
+            }
+
+            private void bind(final Reference reference) {
+                if (this.children.stream().noneMatch(child -> child.reference.name.equals(reference.name)))
+                    this.children.addAll(create(List.of(reference)));
+            }
+
+            private void command(final NativeAnimationControllers.State command) throws IOException {
+                if (this.commandRevision == command.selection()) return;
+                final List<Transition> transitions = new ArrayList<>(this.definition.transitions);
+                for (final var transition : command.transitions()) {
+                    if (transitions.stream().noneMatch(existing -> existing.target.equals(transition.target())
+                            && existing.source.equals(transition.expression()))) {
+                        BedrockMolang.Program condition;
+                        try {
+                            condition = BedrockMolang.Program.parse(
+                                    new com.google.gson.JsonPrimitive(transition.expression()), 0);
+                        } catch (IOException invalid) {
+                            java.util.logging.Logger.getLogger(BedrockActorAnimation.class.getName()).log(
+                                    java.util.logging.Level.WARNING, "Invalid server actor stop expression", invalid);
+                            condition = BedrockMolang.Program.parse(null, 0);
+                        }
+                        transitions.add(new Transition(transition.target(), condition, transition.expression()));
+                    }
+                }
+                this.definition = new State(this.definition.animations, List.copyOf(transitions),
+                        this.definition.entry, this.definition.exit, this.definition.sounds, this.definition.particles,
+                        this.definition.variables, command.blendOutTime() == 0 ? List.of()
+                                : List.of(new Point(0, 1), new Point(command.blendOutTime(), 0)), true);
+                this.commandRevision = command.selection();
+            }
+
+            private boolean allFinished() {
+                return this.children.stream().allMatch(Active::completed);
+            }
+
+            private boolean anyFinished() {
+                return this.children.stream().anyMatch(Active::completed);
+            }
+
+            private void reset() {
+                this.time = 0;
+                this.completed = false;
+                this.children.forEach(Active::reset);
+            }
+
+            private void apply(
+                    final float time,
+                    final float weight,
+                    final Map<String, ?> queries,
+                    final Map<String, BedrockBoneAnimation.Transform> pose) {
+                if (weight < Math.ulp(1F)) return;
+                for (final var variable : this.definition.variables.entrySet())
+                    molang.variable(variable.getKey(), variable.getValue().sample(molang));
+                for (final Active child : this.children) child.apply(time, weight, queries, pose);
+                this.completed = this.allFinished();
+            }
+        }
+    }
+
+    private record Reference(String name, BedrockMolang.Program weight, boolean direct) {
+        private Reference(final String name, final BedrockMolang.Program weight) {
+            this(name, weight, false);
+        }
+    }
+
+    private record Transition(String target, BedrockMolang.Program condition, String source) {}
+
+    private record Point(float input, float output) {}
+
+    private record Variable(BedrockMolang.Program input, List<Point> curve) {
+        float sample(final BedrockMolang molang) {
+            final float value = molang.evaluate(this.input, 0);
+            return this.curve.isEmpty() ? value : BedrockActorAnimation.curve(this.curve, value);
+        }
+    }
+
+    private static float curve(final List<Point> points, final float value) {
+        if (value <= points.getFirst().input) return points.getFirst().output;
+        for (int index = 1; index < points.size(); index++) {
+            final Point right = points.get(index), left = points.get(index - 1);
+            if (value <= right.input)
+                return left.output
+                        + (right.output - left.output)
+                                * (value - left.input)
+                                / (right.input - left.input);
+        }
+        return points.getLast().output;
+    }
+
+    private record State(
+            List<Reference> animations,
+            List<Transition> transitions,
+            List<BedrockMolang.Program> entry,
+            List<BedrockMolang.Program> exit,
+            List<BedrockAnimationSound> sounds,
+            List<BedrockAnimationParticle> particles,
+            Map<String, Variable> variables,
+            List<Point> blend,
+            boolean shortestPath) {}
+
+    private static final State EMPTY_STATE = new State(List.of(), List.of(), List.of(), List.of(),
+            List.of(), List.of(), Map.of(), List.of(), false);
+
+    private record ControllerResource(JsonObject definition, boolean deferredEntry) {}
+
+    private record Controller(
+            String initial,
+            Map<String, State> states,
+            Set<String> variables,
+            boolean deferredEntry) {
+        static Controller read(final JsonObject definition, final boolean deferredEntry)
+                throws IOException {
+            final Map<String, State> states = new LinkedHashMap<>();
+            final JsonObject source = definition.getAsJsonObject("states");
+            if (source == null || source.isEmpty() || source.size() > 128)
+                throw new IOException("Invalid actor controller state count");
+            for (final var entry : source.entrySet()) {
+                final JsonObject state = entry.getValue().getAsJsonObject();
+                final List<Transition> transitions = new ArrayList<>();
+                if (state.has("transitions"))
+                    for (final JsonElement transition : state.getAsJsonArray("transitions")) {
+                        if (transition.getAsJsonObject().size() != 1)
+                            throw new IOException("Invalid actor controller transition");
+                        final var target =
+                                transition.getAsJsonObject().entrySet().iterator().next();
+                        if (!source.has(target.getKey()))
+                            throw new IOException(
+                                    "The actor controller transition target is missing");
+                        transitions.add(
+                                new Transition(
+                                        target.getKey(),
+                                        BedrockMolang.Program.parse(target.getValue(), 0), target.getValue().getAsString()));
+                    }
+                final Map<String, Variable> variables = new LinkedHashMap<>();
+                if (state.has("variables"))
+                    for (final var variable : state.getAsJsonObject("variables").entrySet()) {
+                        final JsonObject data = variable.getValue().getAsJsonObject();
+                        final List<Point> curve = new ArrayList<>();
+                        if (data.has("remap_curve"))
+                            for (final var point : data.getAsJsonObject("remap_curve").entrySet()) {
+                                final float input = Float.parseFloat(point.getKey()),
+                                        output = point.getValue().getAsFloat();
+                                if (!Float.isFinite(input) || !Float.isFinite(output))
+                                    throw new IOException("Invalid actor variable curve");
+                                curve.add(new Point(input, output));
+                            }
+                        curve.sort(java.util.Comparator.comparingDouble(Point::input));
+                        for (int index = 1; index < curve.size(); index++)
+                            if (curve.get(index).input == curve.get(index - 1).input)
+                                throw new IOException("Duplicate actor variable curve point");
+                        variables.put(
+                                variable.getKey(),
+                                new Variable(
+                                        BedrockMolang.Program.parse(data.get("input"), 0),
+                                        List.copyOf(curve)));
+                    }
+                states.put(
+                        entry.getKey(),
+                        new State(
+                                references(state.get("animations")),
+                                List.copyOf(transitions),
+                                programs(state.get("on_entry")),
+                                programs(state.get("on_exit")),
+                                BedrockAnimationSound.entries(state.get("sound_effects")),
+                                BedrockAnimationParticle.entries(state.get("particle_effects")),
+                                java.util.Collections.unmodifiableMap(variables),
+                                blend(state.get("blend_transition")),
+                                state.has("blend_via_shortest_path")
+                                        && state.get("blend_via_shortest_path").getAsBoolean()));
+            }
+            final String initial =
+                    definition.has("initial_state")
+                            ? definition.get("initial_state").getAsString()
+                            : "default";
+            if (!states.containsKey(initial))
+                throw new IOException("The actor controller initial state is missing");
+            final Set<String> variables = new HashSet<>();
+            states.values().forEach(state -> variables.addAll(state.variables.keySet()));
+            return new Controller(
+                    initial, Map.copyOf(states), Set.copyOf(variables), deferredEntry);
+        }
+    }
+
+    private static boolean deferredEntry(final String version) throws IOException {
+        final String[] parts = version.split("\\.", -1);
+        if (parts.length != 3) throw new IOException("Invalid actor controller format version");
+        final int[] threshold = {1, 18, 10};
+        int comparison = 0;
+        for (int index = 0; index < parts.length; index++) {
+            final int value;
+            try {
+                if (!parts[index].matches("[0-9]{1,5}")) throw new NumberFormatException();
+                value = Integer.parseInt(parts[index]);
+                if (value > 65535) throw new NumberFormatException();
+            } catch (NumberFormatException e) {
+                throw new IOException("Invalid actor controller format version", e);
+            }
+            if (comparison == 0) comparison = Integer.compare(value, threshold[index]);
+        }
+        return comparison >= 0;
+    }
+
+    private static List<Point> blend(final JsonElement definition) throws IOException {
+        if (definition == null) return List.of();
+        if (!definition.isJsonPrimitive() || !definition.getAsJsonPrimitive().isNumber())
+            throw new IOException("Invalid actor transition blend");
+        final float duration = definition.getAsFloat();
+        if (!Float.isFinite(duration) || duration < 0 || duration > 600)
+            throw new IOException("Invalid actor transition duration");
+        return duration == 0 ? List.of() : List.of(new Point(0, 1), new Point(duration, 0));
+    }
+
+    private static List<Reference> references(final JsonElement definitions) throws IOException {
+        if (definitions == null) return List.of();
+        final List<Reference> result = new ArrayList<>();
+        for (final JsonElement element : definitions.getAsJsonArray()) {
+            if (element.isJsonPrimitive() && element.getAsJsonPrimitive().isString())
+                result.add(
+                        new Reference(element.getAsString(), BedrockMolang.Program.parse(null, 1)));
+            else {
+                if (element.getAsJsonObject().isEmpty())
+                    throw new IOException("Invalid actor animation reference");
+                for (final var entry : element.getAsJsonObject().entrySet()) {
+                    result.add(
+                            new Reference(
+                                    entry.getKey(), BedrockMolang.Program.parse(entry.getValue(), 1)));
+                }
+            }
+        }
+        if (result.size() > 256) throw new IOException("Too many actor animation references");
+        return List.copyOf(result);
+    }
+
+    private static List<BedrockMolang.Program> programs(final JsonElement definitions)
+            throws IOException {
+        return definitions == null ? List.of() : List.of(BedrockMolang.Program.script(definitions));
+    }
+
+}
