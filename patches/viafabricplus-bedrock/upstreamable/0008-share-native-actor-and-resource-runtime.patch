+        }
+
+        private int count(final long value) throws IOException {
+            if (value > MAX_ITEMS) throw new IOException("Particle collection exceeds the limit");
+            return (int) value;
+        }
+
+        private boolean bool() throws IOException {
+            final int value = Byte.toUnsignedInt(this.data.get());
