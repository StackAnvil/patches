+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockParticlePendingTest {
+    @Test
+    void releasesBeforeReentrantCachedStartsAcquireTheirNextSlot() {
+        final var pending = new BedrockParticlePending(32);
+        for (int i = 0; i < 31; i++) assertTrue(pending.acquire());
+        final var completed = new AtomicInteger();
+        class Starts {
+            void next() {
+                assertTrue(pending.acquire());
+                final var started = new CompletableFuture<Boolean>();
+                final var next = started.thenRun(() -> {
+                    if (completed.incrementAndGet() < 128) this.next();
+                });
+                pending.complete(started, () -> true);
+                next.join();
+            }
+        }
+        new Starts().next();
+        assertEquals(128, completed.get());
+        assertTrue(pending.acquire());
+        assertFalse(pending.acquire());
+    }
+
+    @Test
+    void releasesBeforeFailureAndRejectedStartCallbacks() {
+        final var pending = new BedrockParticlePending(1);
+        final var failure = new IllegalStateException();
+        final var failed = new CompletableFuture<Boolean>();
+        assertTrue(pending.acquire());
+        final var observed = failed.handle((_, error) -> {
+            assertSame(failure, error);
+            assertTrue(pending.acquire());
+            return true;
+        });
+        pending.complete(failed, () -> { throw failure; });
+        assertTrue(observed.join());
+        assertFalse(pending.acquire());
+
+        final var rejected = new CompletableFuture<Boolean>();
+        final var retried = rejected.thenApply(result -> {
+            assertFalse(result);
+            return pending.acquire();
+        });
+        pending.complete(rejected, () -> false);
+        assertTrue(retried.join());
+        assertFalse(pending.acquire());
+    }
+}
