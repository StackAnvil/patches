+    private BedrockActorQueries() {}
+
+    public static Map<String, Object> sample(final Entity actor, final NativeActorMessage.Snapshot state,
+                                              final Map<String, ?> rendered) {
+        final Map<String, Object> queries = new HashMap<>(rendered);
+        queries.remove("has_target");
+        NativeActorIntegerQueries.names().forEach(queries::remove);
+        queries.putAll(nativeState(state));
+        queries.put("is_alive", actor.isAlive());
+        queries.put("is_on_ground", actor.onGround());
+        queries.put("is_in_water", actor.isInWater());
+        queries.put("ground_speed", groundSpeed(actor.getDeltaMovement()));
+        queries.put("is_riding", actor.isPassenger());
+        // A native custom actor can use a non-living Java carrier. Retain its native status flags.
+        if (actor instanceof LivingEntity living) {
+            queries.put("is_sneaking", living.isShiftKeyDown());
+            queries.put("is_swimming", living.isSwimming());
+            queries.put("is_gliding", living.isFallFlying());
+            queries.put("is_sleeping", living.isSleeping());
+            queries.put("is_using_item", living.isUsingItem());
+        } else if (state == null) {
+            queries.put("is_sneaking", actor.isShiftKeyDown());
+            queries.put("is_swimming", actor.isSwimming());
+        }
+        return Map.copyOf(queries);
+    }
+
+    /** Refresh native metadata even when the actor has not produced another render frame. */
+    public static Map<String, Object> nativeState(final NativeActorMessage.Snapshot state) {
+        final Map<String, Object> queries = new HashMap<>();
+        queries.putAll(NativeActorIntegerQueries.values(state == null ? null : state.integerMetadata()));
+        final Set<ActorFlags> flags = state == null ? Set.of() : state.flags();
+        if (state != null && state.targetId() != null) queries.put("has_target", state.targetId() != 0);
+        queries.put("is_charging", flags.contains(ActorFlags.CHARGING));
+        queries.put("is_sneaking", flags.contains(ActorFlags.SNEAKING));
+        queries.put("is_riding", flags.contains(ActorFlags.RIDING));
+        queries.put("is_baby", flags.contains(ActorFlags.BABY));
+        queries.put("is_sitting", flags.contains(ActorFlags.SITTING));
+        queries.put("is_saddled", flags.contains(ActorFlags.SADDLED));
+        queries.put("has_dash_cooldown", flags.contains(ActorFlags.HAS_DASH_COOLDOWN));
+        queries.put("is_swimming", flags.contains(ActorFlags.SWIMMING));
+        queries.put("is_gliding", flags.contains(ActorFlags.GLIDING));
+        queries.put("is_sleeping", flags.contains(ActorFlags.SLEEPING));
+        queries.put("is_using_item", flags.contains(ActorFlags.USINGITEM));
+        queries.put("is_crawling", flags.contains(ActorFlags.CRAWLING));
+        final Map<String, Object> properties = state == null ? Map.of() : state.properties();
+        queries.put("variant", state == null ? 0 : state.variant());
+        queries.put("mark_variant", state == null ? 0 : state.markVariant());
+        queries.put("property", (BedrockActorAnimation.Query) args -> args.isEmpty() ? 0F
+                : properties.getOrDefault(String.valueOf(args.getFirst()), 0F));
+        queries.put("has_property", (BedrockActorAnimation.Query) args -> !args.isEmpty()
+                && properties.containsKey(String.valueOf(args.getFirst())));
+        queries.put("spellcolor", state == null || state.spellColor() == null ? BedrockMolangColor.ZERO
+                : BedrockMolangColor.fromArgb(state.spellColor()));
+        return Map.copyOf(queries);
+    }
+
+    public static float groundSpeed(final Vec3 movement) {
+        final float x = (float) movement.x * 20F, y = (float) movement.y * 20F, z = (float) movement.z * 20F;
+        return (float) Math.sqrt(z * z + (y * y + x * x));
+    }
+}
