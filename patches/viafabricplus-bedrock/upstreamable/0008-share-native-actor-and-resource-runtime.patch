@@ -0,0 +1,124 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+
+/** Pack-local announcement translations and the target client's repeat rules. */
+public final class BedrockEmoteMessages {
+    private final Map<String, Map<String, String>> languages;
+
+    private BedrockEmoteMessages(final Map<String, Map<String, String>> languages) {
+        this.languages = Map.copyOf(languages);
+    }
+
+    static BedrockEmoteMessages read(final Map<String, byte[]> files) throws IOException {
+        final Map<String, Map<String, String>> languages = new HashMap<>();
+        for (final var file : files.entrySet()) {
+            String path = file.getKey();
+            if (path.startsWith("texts/")) path = path.substring(6);
+            if (path.contains("/") || !path.endsWith(".lang")) continue;
+            final String language = path.substring(0, path.length() - 5).toLowerCase(Locale.ROOT);
+            if (!language.matches("[a-z]{2,3}_[a-z]{2}")) continue;
+            if (file.getValue().length > 64 * 1024)
+                throw new IOException("The emote translation file is too large");
+            final Map<String, String> messages = new HashMap<>();
+            for (String line : new String(file.getValue(), StandardCharsets.UTF_8).split("\\R")) {
+                if (line.startsWith("\uFEFF")) line = line.substring(1);
+                final int comment = line.indexOf("##");
+                if (comment >= 0) line = line.substring(0, comment);
+                final int equals = line.indexOf('=');
+                if (equals < 0) continue;
+                final String key = line.substring(0, equals).strip();
+                if (!key.equals("persona.emote.chat_message")
+                        && !key.equals("persona.emote.easter_egg")) continue;
+                final String value = line.substring(equals + 1).strip();
+                if (value.length() > 4096)
+                    throw new IOException("The emote announcement is too long");
+                messages.put(key, value);
+            }
+            final var previous = languages.putIfAbsent(language, Map.copyOf(messages));
+            if (previous != null && !previous.equals(messages))
+                throw new IOException("The emote has ambiguous translations");
+        }
+        return new BedrockEmoteMessages(languages);
+    }
+
+    String message(final String language, final boolean alternate, final String player) {
+        final String key = alternate ? "persona.emote.easter_egg" : "persona.emote.chat_message";
+        final String template =
+                languages
+                        .getOrDefault(language.toLowerCase(Locale.ROOT), Map.of())
+                        .getOrDefault(
+                                key,
+                                languages.getOrDefault("en_us", Map.of()).getOrDefault(key, ""));
+        return format(template, player);
+    }
+
+    static String format(final String template, final String player) {
+        final StringBuilder result = new StringBuilder();
+        boolean highlighted = false;
+        int cursor = 0;
+        while (cursor < template.length()) {
+            final int escape = next(template, '\\', cursor);
+            final int actor = next(template, '@', cursor);
+            final int highlight = next(template, '&', cursor);
+            if (escape < actor
+                    && escape < highlight
+                    && (actor - escape == 1 || highlight - escape == 1)) {
+                result.append(template, cursor, escape).append(template.charAt(escape + 1));
+                cursor = escape + 2;
+            } else if (actor < highlight) {
+                result.append(template, cursor, actor).append("§b").append(player).append("§r");
+                cursor = actor + 1;
+            } else if (highlight != Integer.MAX_VALUE) {
+                result.append(template, cursor, highlight).append(highlighted ? "§r" : "§a");
+                highlighted = !highlighted;
+                cursor = highlight + 1;
+            } else {
+                result.append(template, cursor, template.length());
+                if (highlighted) result.append("§r");
+                break;
+            }
+        }
+        return result.toString();
+    }
+
+    private static int next(final String value, final char marker, final int cursor) {
+        final int index = value.indexOf(marker, cursor);
+        return index < 0 ? Integer.MAX_VALUE : index;
+    }
+
+    static final class Repeat {
+        private UUID previous;
+        private long deadline;
+        private int count;
+
+        /**
+         * Returns null during the cooldown; true selects the fifth announcement's alternate text.
+         */
+        Boolean select(final UUID emote, final long nowMillis) {
+            if (!emote.equals(previous) || nowMillis > deadline) {
+                count = 0;
+                previous = emote;
+            }
+            // The native gate compares float milliseconds and extends rejected attempts' deadline.
+            final boolean allowed = (float) (deadline - 28_500) <= (float) nowMillis;
+            deadline = nowMillis + 30_000;
+            if (!allowed) return null;
+            if (++count < 5) return false;
+            count = 0;
+            previous = null;
+            deadline = 0;
+            return true;
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockItemAnimation.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockItemAnimation.java
new file mode 100644
index 0000000..a475715
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockItemAnimation.java
@@ -0,0 +1,173 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+
+/**
+ * The target player's item queries use remaining ticks and distinguish equipped and rendered hands.
+ */
+public record BedrockItemAnimation(
+        Item mainHand,
+        Item offHand,
+        Item renderedMainHand,
+        Item renderedOffHand,
+        int remainingTicks) {
+    public record Item(String name, int maxUseTicks, boolean charged, ItemAnimationData animation) {
+        public static final Item EMPTY = new Item("", 0, false, ItemAnimationData.EMPTY);
+
+        public static Item fromIdentifiers(final String bedrockIdentifier, final String javaName,
+                                           final int maxUseTicks, final boolean charged, final ItemAnimationData animation) {
+            final String name = bedrockIdentifier == null || bedrockIdentifier.isEmpty()
+                    ? javaName : bedrockIdentifier.substring(bedrockIdentifier.indexOf(':') + 1);
+            return new Item(name, animation.useDurationTicks() == null ? maxUseTicks : animation.useDurationTicks(), charged, animation);
+        }
+    }
+
+    /** Keep elapsed use ticks unchanged when Java and native item durations differ. */
+    public static int remainingTicks(final int nativeMax, final int javaMax,
+                                     final int javaRemaining, final boolean using) {
+        if (!using || javaRemaining <= 0 || nativeMax <= 0) return 0;
+        final long elapsed = Math.max(0L, (long) javaMax - javaRemaining);
+        return (int) Math.max(0L, (long) nativeMax - elapsed);
+    }
+
+    public enum Action {
+        OTHER,
+        TRIDENT,
+        SPYGLASS,
+        GOAT_HORN,
+        BRUSH
+    }
+
+    /** The native player keeps the active use stack separate from its equipped hands. */
+    public record Use(Item activeItem, Item mainHand, int remainingTicks, Action mainHandAction) {
+        public Map<String, Float> variables() {
+            final boolean active = !this.activeItem.name().isEmpty();
+            final int elapsed = this.activeItem.maxUseTicks() - this.remainingTicks;
+            final int startupTicks = this.activeItem.maxUseTicks() - 24;
+            final int intervalTicks = elapsed - startupTicks;
+            final boolean specialized = !this.mainHand.name().isEmpty() && this.remainingTicks > 0;
+            final boolean brandishing = specialized && this.mainHandAction == Action.TRIDENT;
+            return Map.of(
+                    "use_item_startup_progress",
+                            !active
+                                    ? 0F
+                                    : intervalTicks > 0
+                                            ? 1F
+                                            : 1F - (float) -intervalTicks / startupTicks,
+                    "use_item_interval_progress",
+                            active && intervalTicks > 0 ? (intervalTicks & 3) * 0.25F : 0F,
+                    "is_brandishing_spear", brandishing ? 1F : 0F,
+                    "charge_amount",
+                            brandishing
+                                    ? Math.clamp(
+                                            (this.mainHand.maxUseTicks() - this.remainingTicks)
+                                                    / 10F,
+                                            0,
+                                            1)
+                                    : 0F,
+                    "is_holding_spyglass",
+                            specialized && this.mainHandAction == Action.SPYGLASS ? 1F : 0F,
+                    "is_tooting_goat_horn",
+                            specialized && this.mainHandAction == Action.GOAT_HORN ? 1F : 0F,
+                    "is_using_brush", specialized && this.mainHandAction == Action.BRUSH ? 1F : 0F);
+        }
+    }
+
+    public Map<String, Object> queries() {
+        final var kinetic = this.mainHand.animation().kineticWeapon();
+        final Integer swingTicks = this.mainHand.animation().swingDurationTicks();
+        return Map.of(
+                "kinetic_weapon_delay", kinetic == null ? 0 : kinetic.delay(),
+                "kinetic_weapon_damage_duration", kinetic == null ? 0 : kinetic.damageDuration(),
+                "kinetic_weapon_knockback_duration", kinetic == null ? 0 : kinetic.knockbackDuration(),
+                "kinetic_weapon_dismount_duration", kinetic == null ? 0 : kinetic.dismountDuration(),
+                "base_swing_duration", (swingTicks == null ? 6 : swingTicks) * 0.05F,
+                "main_hand_item_use_duration",
+                        this.mainHand.name().isEmpty() ? 0 : this.remainingTicks,
+                "main_hand_item_max_duration",
+                        this.mainHand.name().isEmpty() ? 0 : this.mainHand.maxUseTicks(),
+                "item_remaining_use_duration", (BedrockActorAnimation.Query) this::remaining,
+                "item_is_charged",
+                        (BedrockActorAnimation.Query)
+                                arguments -> {
+                                    final Item item = this.hand(arguments, false);
+                                    return item != null && item.charged();
+                                },
+                "get_equipped_item_name",
+                        (BedrockActorAnimation.Query)
+                                arguments -> {
+                                    final boolean rendered =
+                                            arguments.size() == 2
+                                                    && arguments.get(1) instanceof Number number
+                                                    && number.floatValue() != 0;
+                                    final Item item = this.hand(arguments, rendered);
+                                    return item == null ? "" : item.name();
+                                });
+    }
+
+    public static Map<String, Object> equipmentQueries(final Map<String, Item> equipment) {
+        final Map<String, Item> snapshot = Map.copyOf(equipment);
+        return Map.of("equipped_item_any_tag", (BedrockActorAnimation.Query) arguments -> {
+            if (arguments.size() < 2 || !(arguments.getFirst() instanceof String slot)) return false;
+            final Item item = snapshot.get(slot);
+            if (item == null) return false;
+            for (final Object tag : arguments.subList(1, arguments.size())) {
+                if (tag instanceof String name && item.animation().tags().contains(name)) return true;
+            }
+            return false;
+        });
+    }
+
+    private Item hand(final List<Object> arguments, final boolean rendered) {
+        if (arguments.isEmpty() || "main_hand".equals(arguments.getFirst()))
+            return rendered ? this.renderedMainHand : this.mainHand;
+        if ("off_hand".equals(arguments.getFirst()))
+            return rendered ? this.renderedOffHand : this.offHand;
+        if (arguments.getFirst() instanceof Number number && Float.isFinite(number.floatValue())) {
+            return switch ((int) number.floatValue()) {
+                case 0 -> rendered ? this.renderedMainHand : this.mainHand;
+                case 1 -> rendered ? this.renderedOffHand : this.offHand;
+                default -> null;
+            };
+        }
+        return null;
+    }
+
+    private float remaining(final List<Object> arguments) {
+        if (arguments.size() > 2) return 0;
+        Item item = this.mainHand;
+        Number normalization = null;
+        if (!arguments.isEmpty()) {
+            final Object first = arguments.getFirst();
+            if (first instanceof String slot) {
+                item =
+                        switch (slot) {
+                            case "main_hand" -> this.mainHand;
+                            case "off_hand" -> this.offHand;
+                            default -> null;
+                        };
+                if (arguments.size() == 2) {
+                    if (!(arguments.get(1) instanceof Number number)) return 0;
+                    normalization = number;
+                }
+            } else if (first instanceof Number number && arguments.size() == 1) {
+                normalization = number;
+            } else return 0;
+        }
+        if (item == null || item.name().isEmpty()) return 0;
+        if (normalization == null) {
+            // The target retains the ticks-to-seconds bug for an explicit slot-only argument.
+            return this.remainingTicks * (arguments.isEmpty() ? 0.05F : 20F);
+        }
+        if (item.maxUseTicks() < 1) return 0;
+        return normalization.floatValue()
+                * Math.clamp((float) this.remainingTicks / item.maxUseTicks(), 0, 1);
+    }
+}
