+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+final class BedrockServerActorResourcesTest {
+    private static final String ENTITY = """
+            {"minecraft:client_entity":{"description":{"identifier":"minecraft:player",
+             "animations":{"root":"controller.animation.root","pose":"animation.pose"},
+             "scripts":{"initialize":["v.bias=7;"],"animate":["root"]}}}}
+            """;
+
+    @Test
+    void samplesInheritedHandRotationThroughTheNonVrJavaHandFrame() throws Exception {
+        final var definition = JsonParser.parseString("""
+                {"animations":{"pose":"animation.pose"},"scripts":{"animate":["pose"]}}
+                """).getAsJsonObject();
+        final var animations = JsonParser.parseString("""
+                {"animation.pose":{"loop":true,"bones":{"rightarm":{"rotation":[
+                 "95+v.is_using_vr*7.5","-45+v.is_using_vr*7.5","115-v.is_using_vr*2.5"]}}}}
+                """).getAsJsonObject();
+        final var graph = BedrockActorAnimation.read(definition, Map.of(), animations, new JsonObject(), "1.10.0");
+        final var actor = new BedrockActorAnimation.Frame(Map.of(), Map.of("is_using_vr", 1F));
+        final var empty = BedrockItemAnimation.Item.EMPTY;
+        final var bind = Class.forName("com.viaversion.viafabricplus.bedrock.render.BedrockFirstPersonInput")
+                .getDeclaredMethod("bind", BedrockActorAnimation.Frame.class, BedrockItemAnimation.class,
+                        float.class, float.class, float.class, float.class, float.class);
+        bind.setAccessible(true);
+        final var hands = (BedrockActorAnimation.Frame) bind.invoke(null, actor,
+                new BedrockItemAnimation(empty, empty, empty, empty, 0), 1F, 1F, 1F, 1F, 0F);
+        assertEquals(new BedrockBoneAnimation.Vector(95, -45, 115),
+                graph.playback().sample(0, hands).get("rightarm").rotation());
+        assertEquals(new BedrockBoneAnimation.Vector(102.5F, -37.5F, 112.5F),
+                graph.playback().sample(0, actor).get("rightarm").rotation());
+    }
+
+    @Test
+    void inheritsNativeGraphWithoutReplacingTheEffectiveServerEntityOrEffects() throws Exception {
+        final var baseline = baseline("1.10.0", "");
+        final var stack = stack(Map.of("entity/player.entity.json", bytes(ENTITY),
+                "textures/particles/replaced.png", new byte[] {9}));
+        final var library = BedrockResourceLibrary.serverActors(baseline, stack);
+        final var pose = graph(stack, library).playback()
+                .sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(new BedrockBoneAnimation.Vector(7, 2, 0), pose.get("rightarm").position());
+        assertArrayEquals(new byte[] {3}, library.file("textures/particles/inherited.png"));
+        assertArrayEquals(new byte[] {9}, library.file("textures/particles/replaced.png"));
+    }
+
+    @Test
+    void retainsHigherAcceptedAnimationAndControllerOverridesInNativeOrder() throws Exception {
+        final var lower = new HashMap<String, byte[]>();
+        lower.put("entity/player.entity.json", bytes(ENTITY));
+        lower.put("animations/pose.json", bytes("""
+                {"animations":{"animation.pose":{"loop":true,"bones":{
+                 "rightarm":{"position":[11,0,0]}}}}}
+                """));
+        final var higher = Map.of("animations/pose.json", bytes("""
+                {"animations":{"animation.pose":{"loop":true,"bones":{
+                 "rightarm":{"position":[19,0,0]}}}}}
+                """), "animation_controllers/root.json", bytes("""
+                {"format_version":"1.10.0","animation_controllers":{
+                 "controller.animation.root":{"states":{"default":{"animations":[{"pose":0.5}]}}}}}
+                """));
+        final var stack = stack(lower, higher);
+        final var library = BedrockResourceLibrary.serverActors(baseline("1.18.10", ""), stack);
+        final var pose = graph(stack, library).playback()
+                .sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(new BedrockBoneAnimation.Vector(9.5F, 0, 0), pose.get("rightarm").position());
+    }
+
+    @Test
+    void preservesEachWinningControllersInitialTransitionFormat() throws Exception {
+        final var nativeLibrary = baseline("1.18.10", ",\"transitions\":[{\"off\":1}]");
+        final var inheritedStack = stack(Map.of("entity/player.entity.json", bytes(ENTITY)));
+        final var inherited = graph(inheritedStack, BedrockResourceLibrary.serverActors(nativeLibrary, inheritedStack)).playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        assertNotNull(inherited.sample(0, frame).get("rightarm"));
+        assertTrue(inherited.sample(.1F, frame).isEmpty());
+
+        final var overrideStack = stack(Map.of("entity/player.entity.json", bytes(ENTITY),
+                "animation_controllers/override.json", bytes("""
+                {"format_version":"1.10.0","animation_controllers":{"controller.animation.root":{
+                 "states":{"default":{"animations":["pose"],"transitions":[{"off":1}]},"off":{}}}}}
+                """)));
+        final var override = graph(overrideStack, BedrockResourceLibrary.serverActors(nativeLibrary, overrideStack)).playback();
+        assertTrue(override.sample(0, frame).isEmpty());
+    }
+
+    private static BedrockActorAnimation graph(final ResourcePackStorage stack, final BedrockResourceLibrary library)
+            throws Exception {
+        final JsonObject effective = JsonParser.parseString(stack.getEntities()
+                .getDescription("minecraft:player").toString()).getAsJsonObject();
+        return BedrockActorAnimation.read(effective, Map.of(), library);
+    }
+
+    private static BedrockResourceLibrary baseline(final String format, final String extraState) throws Exception {
+        return BedrockResourceLibrary.read(Map.of(
+                "library/vanilla/animations/pose.json", bytes("""
+                {"animations":{"animation.pose":{"loop":true,"bones":{
+                 "rightarm":{"position":["v.bias",2,0]}}}}}
+                """), "library/vanilla/animation_controllers/root.json", bytes("""
+                {"format_version":"%s","animation_controllers":{"controller.animation.root":{
+                 "states":{"default":{"animations":["pose"]%s},"off":{}}}}}
+                """.formatted(format, extraState)),
+                "library/vanilla/textures/particles/inherited.png", new byte[] {3},
+                "library/vanilla/textures/particles/replaced.png", new byte[] {4}));
+    }
+
+    @SafeVarargs
+    private static ResourcePackStorage stack(final Map<String, byte[]>... contents) throws Exception {
+        final var layers = new java.util.ArrayList<NativeActorLibrary.Layer>();
+        for (int index = 0; index < contents.length; index++) {
+            final var files = new HashMap<>(contents[index]);
+            files.put("manifest.json", bytes("""
+                    {"format_version":2,"header":{"name":"test","uuid":"00000000-0000-0000-0000-%012d",
+                     "version":[1,0,0]}}
+                    """.formatted(index + 1)));
+            layers.add(new NativeActorLibrary.Layer(true, files));
+        }
+        return ResourcePackStorage.nativeActors(layers);
+    }
+
+    private static byte[] bytes(final String json) {
+        return json.getBytes(StandardCharsets.UTF_8);
+    }
+}
