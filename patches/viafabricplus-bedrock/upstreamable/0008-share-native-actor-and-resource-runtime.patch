diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorAnimationTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorAnimationTest.java
new file mode 100644
index 0000000..f34f032
--- /dev/null
+++ b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorAnimationTest.java
@@ -0,0 +1,705 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockActorAnimationTest {
+    private static JsonObject json(final String value) {
+        return JsonParser.parseString(value).getAsJsonObject();
+    }
+
+    @Test
+    void appliesEquippedParentSetupAfterEveryOwnerResetAndRemovesItOnUnequip() throws IOException {
+        final var actor = BedrockActorAnimation.read(json("""
+            {"animations":{"pose":"animation.pose"},"scripts":{"pre_animation":["v.layer=1;"],"animate":["pose"]}}
+            """), Map.of(), json("""
+            {"animation.pose":{"loop":true,"bones":{"head":{"position":["v.layer",0,0]}}}}
+            """), new JsonObject(), "1.10.0").playback();
+        final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+        final var equipped = frame.withParentSetup(List.of(new BedrockActorAnimation.ParentSetup(
+                List.of("v.layer = context.layer;"), Map.of("layer", 7))));
+        assertEquals(7F, actor.sample(0, equipped).get("head").position().x());
+        assertEquals(7F, actor.sample(1, equipped).get("head").position().x());
+        assertEquals(1F, actor.sample(2, frame).get("head").position().x());
+    }
+
+    @Test
+    void recoversMissingBoneQueriesWithoutResettingPlaybackOrMolangDefaults() throws IOException {
+        final var graph = BedrockActorAnimation.read(json("""
+            {"animations":{"pose":"animation.pose"},"scripts":{"animate":["pose"]}}
+            """), Map.of(), json("""
+            {"animation.pose":{"animation_length":2,"loop":true,"bones":{"head":{"position":["q.unavailable",0,0],"rotation":[0,0,"q.anim_time*10"]}}}}
+            """), new JsonObject(), "1.10.0");
+        final var supported = graph.playback();
+        assertEquals(8F, supported.sample(0, new BedrockActorAnimation.Frame(Map.of("unavailable", 8F), Map.of())).get("head").position().x());
+        assertTrue(supported.hasCompleteQueries());
+        final var unsupported = graph.playback();
+        assertEquals(0F, unsupported.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of())).get("head").position().x());
+        assertFalse(unsupported.hasCompleteQueries());
+        assertTrue(supported.hasCompleteQueries());
+        assertTrue(unsupported.fork().hasCompleteQueries());
+        unsupported.sample(.5F, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertFalse(unsupported.hasCompleteQueries());
+        final var resumed = unsupported.sample(1.25F, new BedrockActorAnimation.Frame(Map.of("unavailable", 14F), Map.of()));
+        assertTrue(unsupported.hasCompleteQueries());
+        assertEquals(14F, resumed.get("head").position().x());
+        assertEquals(12.5F, resumed.get("head").rotation().z());
+    }
+
+    @Test
+    void retainsEffectBindingsWithoutAnimationOrScriptSections() throws IOException {
+        for (final boolean animations : List.of(false, true)) {
+            for (final boolean scripts : List.of(false, true)) {
+                final var entity = json("""
+                        {"sound_effects":{"clang":"emote.clang"},
+                         "particle_effects":{"spark":"test:spark"}}
+                        """);
+                if (animations) entity.add("animations", new JsonObject());
+                if (scripts) entity.add("scripts", new JsonObject());
+                final var playback = BedrockActorAnimation.read(entity, Map.of(),
+                        new JsonObject(), new JsonObject(), "1.10.0").playback();
+                assertTrue(playback.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of())).isEmpty());
+                final var sound = new BedrockAnimationSound(0, "clang", "hand");
+                final var resolvedSound = playback.soundCue(sound);
+                assertEquals(entity.getAsJsonObject("sound_effects").get(sound.effect()).getAsString(),
+                        resolvedSound.event());
+                assertEquals(sound.locator(), resolvedSound.locator());
+                final var particle = new BedrockAnimationParticle(0, "spark", "head", false,
+                        BedrockMolang.Program.parse(null, 0));
+                final var resolvedParticle = playback.particleCue(
+                        new BedrockAnimationParticle.Cue(particle, new BedrockMolang()));
+                assertEquals(entity.getAsJsonObject("particle_effects").get(particle.effect()).getAsString(),
+                        resolvedParticle.event());
+                assertEquals(particle.locator(), resolvedParticle.locator());
