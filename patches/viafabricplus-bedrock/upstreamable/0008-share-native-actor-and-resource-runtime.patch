+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionException;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleGraphTest {
+    @Test
+    void waitsForNestedSharedAndCyclicDependencies() {
+        final Map<String, CompletableFuture<Set<String>>> assets = new HashMap<>();
+        final List<String> requested = new ArrayList<>();
+        final var graph = BedrockParticleGraph.load("root", 8, name -> {
+            requested.add(name);
+            return assets.computeIfAbsent(name, _ -> new CompletableFuture<>());
+        }, Runnable::run);
+        assets.get("root").complete(Set.of("left", "right"));
+        assertFalse(graph.isDone());
+        assets.get("left").complete(Set.of("shared", "root"));
+        assertFalse(assets.containsKey("shared"));
+        assets.get("right").complete(Set.of("shared"));
+        assertFalse(graph.isDone());
+        assets.get("shared").complete(Set.of("left"));
+        graph.join();
+        assertEquals(Set.of("root", "left", "right", "shared"), Set.copyOf(requested));
+        assertEquals(4, requested.size());
+    }
+
