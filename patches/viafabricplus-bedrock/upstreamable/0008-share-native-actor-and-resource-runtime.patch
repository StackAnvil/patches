+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleRatesTest {
+    @Test
+    void runsEventOnlyEmittersWithoutInventingAnEmissionRate() throws Exception {
+        final var document = definition();
+        document.getAsJsonObject("particle_effect").add("events", json("""
+                {"created":{"expression":"v.created=v.created+1;"},
+                 "expired":{"expression":"v.expired=v.expired+1;"}}
+                """));
+        components(document).add("minecraft:emitter_lifetime_events", json("""
+                {"creation_event":"created","expiration_event":"expired"}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("created", 0);
+        environment.variable("expired", 0);
+        final var emitter = emitter(document, environment);
+        emitter.advance(0, 1000, null, (x, y, z) -> List.of());
+        assertEquals(1, value(environment, "created"));
+        assertEquals(0, emitter.size());
+        assertFalse(emitter.emit(new Vector3f(), new Vector3f(), 1000));
+        emitter.expire();
+        assertEquals(1, value(environment, "expired"));
+        assertFalse(emitter.alive());
+    }
+
+    @Test
+    void sumsRequestsInResourceOrderUsingSharedCapacityAndRateState() throws Exception {
+        for (final boolean steadyFirst : List.of(false, true)) {
+            final var document = definition();
+            for (final String kind : steadyFirst ? List.of("steady", "instant") : List.of("instant", "steady"))
+                components(document).add("minecraft:emitter_rate_" + kind,
+                        kind.equals("steady") ? json("{\"spawn_rate\":20,\"max_particles\":5}")
+                                : json("{\"num_particles\":3}"));
+            final var emitter = emitter(document, new BedrockMolang());
+            emitter.advance(50_000_000, 1000, null, (x, y, z) -> List.of());
+            assertEquals(steadyFirst ? 4 : 3, emitter.size());
+            emitter.advance(50_000_000, 1000, null, (x, y, z) -> List.of());
+            assertEquals(steadyFirst ? 5 : 3, emitter.size());
+        }
+    }
+
+    @Test
+    void evaluatesManualCapacityBeforeCreationAndCountsManualBirthsAgainstInstantEmission() throws Exception {
+        final var document = definition();
+        components(document).add("minecraft:emitter_rate_manual", json("""
+                {"max_particles":"v.calls=v.calls+1;return 2;"}
+                """));
+        components(document).add("minecraft:emitter_rate_instant", json("{\"num_particles\":10}"));
+        components(document).add("minecraft:emitter_initialization", json("""
+                {"creation_expression":"v.initial_calls=v.calls;"}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("calls", 0);
+        final var emitter = emitter(document, environment);
+        assertEquals(1, value(environment, "initial_calls"));
+        assertTrue(emitter.emit(new Vector3f(), new Vector3f(), 1000));
+        emitter.advance(0, 1000, null, (x, y, z) -> List.of());
+        assertEquals(1, emitter.size());
+        assertTrue(emitter.emit(new Vector3f(), new Vector3f(), 1000));
+        assertFalse(emitter.emit(new Vector3f(), new Vector3f(), 1000));
+        assertEquals(4, value(environment, "calls"));
+        assertEquals(2, emitter.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PARTICLE_RATES", matches = ".+")
+    void matchesOriginalFactoryAndCombinedAutomaticAndManualRateDispatch() throws Exception {
+        final var fixture = json(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_PARTICLE_RATES"))));
+        int cases = 0, steps = 0;
+        for (final var item : fixture.getAsJsonArray("rows")) {
+            final var row = item.getAsJsonObject();
+            assertFalse(row.has("error"), row.toString());
+            assertEquals(1, row.get("registered").getAsInt());
+            final var configuration = row.getAsJsonObject("configuration");
+            final var document = definition();
+            for (final var kind : row.getAsJsonArray("kinds")) {
+                final var rate = new JsonObject();
+                switch (kind.getAsString()) {
+                    case "instant" -> rate.add("num_particles", configuration.get("instant"));
+                    case "steady" -> {
+                        rate.add("spawn_rate", configuration.get("steady"));
+                        rate.add("max_particles", configuration.get("capacity"));
+                    }
+                    case "manual" -> rate.add("max_particles", configuration.get("manual"));
+                    default -> fail("Unknown native rate");
+                }
+                components(document).add("minecraft:emitter_rate_" + kind.getAsString(), rate);
+            }
+            final var emitter = emitter(document, new BedrockMolang());
+            for (final var step : row.getAsJsonArray("steps")) {
+                final var expected = step.getAsJsonObject();
+                final int before = emitter.size();
+                final String context = "rate case " + cases + ", step " + steps++;
+                if (expected.get("action").getAsString().equals("manual"))
+                    assertEquals(expected.get("births").getAsInt() > 0,
+                            emitter.emit(new Vector3f(), new Vector3f(), 1000), context);
+                else emitter.advance(expected.get("nanos").getAsLong(), 1000, null, (x, y, z) -> List.of());
+                assertEquals(expected.get("births").getAsInt(), emitter.size() - before, context);
+                assertEquals(expected.get("population").getAsInt(), emitter.size(), context);
+            }
+            cases++;
+        }
+        assertEquals(128, cases);
+        assertEquals(1152, steps);
+    }
+
+    private static JsonObject definition() {
+        final var document = BedrockParticleEffectTest.burst();
+        components(document).remove("minecraft:emitter_rate_instant");
+        components(document).remove("minecraft:emitter_lifetime_once");
+        components(document).getAsJsonObject("minecraft:particle_lifetime_expression").addProperty("max_lifetime", 10);
+        return document;
+    }
+
+    private static JsonObject components(final JsonObject document) {
+        return document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+    }
+
+    private static BedrockParticleEffect.Emitter emitter(final JsonObject document, final BedrockMolang environment) throws Exception {
+        return BedrockParticleEffect.read(document).emitter(environment, new Random(1), Vec3.ZERO);
+    }
+
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+
+    private static float value(final BedrockMolang environment, final String name) throws Exception {
+        return environment.evaluate(BedrockMolang.Program.parse(new com.google.gson.JsonPrimitive("v." + name), -1), -1);
+    }
+}
