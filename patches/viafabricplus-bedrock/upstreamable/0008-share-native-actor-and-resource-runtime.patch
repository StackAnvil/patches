+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+
+import java.io.IOException;
+
+/** Native emitter activation, cycle scheduling, and permanent expiration. */
+record BedrockParticleLifetime(Kind kind, BedrockMolang.Program activeTime, BedrockMolang.Program sleepTime,
+                               BedrockMolang.Program activation, BedrockMolang.Program expiration) {
+    enum Kind { ONCE, LOOPING, DEFAULT }
+
+    static BedrockParticleLifetime read(final JsonObject components) throws IOException {
+        final boolean once = components.has("minecraft:emitter_lifetime_once");
+        final boolean looping = components.has("minecraft:emitter_lifetime_looping");
+        if (once && looping) throw new IOException("Ambiguous emitter duration");
+        final Kind kind = once ? Kind.ONCE : looping ? Kind.LOOPING : Kind.DEFAULT;
+        final JsonObject duration = once ? components.getAsJsonObject("minecraft:emitter_lifetime_once")
+                : looping ? components.getAsJsonObject("minecraft:emitter_lifetime_looping") : null;
+        final JsonObject expression = components.getAsJsonObject("minecraft:emitter_lifetime_expression");
+        return new BedrockParticleLifetime(kind,
+                duration == null ? null : BedrockParticleEffect.program(duration, "active_time", 0),
+                duration == null ? null : BedrockParticleEffect.program(duration, "sleep_time", 0),
+                expression == null ? null : BedrockParticleEffect.program(expression, "activation_expression", 1),
+                expression == null ? null : BedrockParticleEffect.program(expression, "expiration_expression", 0));
+    }
+
+    Clock clock(final BedrockMolang environment) { return new Clock(environment); }
+
+    final class Clock {
+        private long age, active = duration(1_000_000F), sleep;
+        private boolean firstUpdate = true, expired, hadActor;
+
+        private Clock(final BedrockMolang environment) {
+            environment.variable("emitter_age", 0);
+            this.configure(environment);
+        }
+
+        private void configure(final BedrockMolang environment) {
+            if (kind == Kind.ONCE || kind == Kind.LOOPING) {
+                this.active = duration(environment.evaluate(activeTime, 0));
+                this.sleep = kind == Kind.LOOPING ? duration(environment.evaluate(sleepTime, 0)) : 0;
+            }
+        }
+
+        boolean expired() { return this.expired; }
+
+        Frame advance(final long nanos, final boolean actor, final boolean contextValid, final BedrockMolang environment,
+                      final Runnable update, final Runnable restart, final Runnable expirationEvent) {
+            // The frame scheduler caps each incoming delta before accumulating scheduled updates.
+            final long elapsed = nanos;
+            final long previous = this.age;
+            final boolean first = this.firstUpdate;
+            this.age += elapsed;
+            final float age = (float) this.age / 1_000_000_000F;
+            final float lifetime = (float) this.active / 1_000_000_000F;
+            environment.variable("emitter_age", age);
+            environment.variable("emitter_lifetime", lifetime);
+            environment.clock(age, age, (float) elapsed / 1_000_000_000F);
+            if (!contextValid || this.hadActor && !actor) this.expire(expirationEvent);
+            this.hadActor |= actor;
+            final boolean activated = (activation == null || environment.evaluate(activation, 1) != 0)
+                    && (this.age <= this.active || this.firstUpdate);
+            update.run();
+            if (!this.expired) {
+                if (this.age >= this.active + this.sleep) {
+                    this.configure(environment);
+                    if (!actor || kind != Kind.LOOPING && activation == null) this.expire(expirationEvent);
+                    restart.run();
+                    // Native resets once per update, keeps particles, and discards overshoot.
+                    this.age = 0;
+                }
+                if (!this.expired && expiration != null && environment.evaluate(expiration, 0) != 0)
+                    this.expire(expirationEvent);
+            }
+            final boolean emitting = activated && (!this.expired || this.firstUpdate);
+            this.firstUpdate = false;
+            // Molang context retains the age and duration sampled before a cycle restart.
+            return new Frame(elapsed, age, lifetime, emitting, previous, this.age, first);
+        }
+
+        void expire(final Runnable event) {
+            if (this.expired) return;
+            event.run();
+            this.expired = true;
+        }
+    }
+
+    static long duration(final float seconds) {
+        final float nanos = seconds * 1_000_000_000F;
+        // cvttss2si returns the signed minimum for an out-of-range conversion.
+        return !Float.isFinite(nanos) || nanos >= 0x1p63F || nanos < -0x1p63F ? Long.MIN_VALUE : (long) nanos;
+    }
+
+    record Frame(long nanos, float age, float lifetime, boolean emitting, long previous, long current, boolean first) {}
+}
