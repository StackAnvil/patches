+final class BedrockResourceLibraryTest {
+
+    @Test
+    void decodesAndEmitsParticlesUsingPackRelativeTexturePaths() throws Exception {
+        final var source = new java.awt.image.BufferedImage(2, 1, java.awt.image.BufferedImage.TYPE_INT_ARGB);
+        source.setRGB(0, 0, 0xFFFF8000);
+        source.setRGB(1, 0, 0x800080FF);
+        final var encoded = new java.io.ByteArrayOutputStream();
+        assertTrue(javax.imageio.ImageIO.write(source, "png", encoded));
+        for (final String path : List.of("font/glyph_E1", "custom/atlas", "atlas")) {
+            final var document = BedrockParticleEffectTest.burst();
+            final var parameters = document.getAsJsonObject("particle_effect").getAsJsonObject("description")
+                    .getAsJsonObject("basic_render_parameters");
+            parameters.addProperty("texture", path);
+            final var content = new net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent();
+            content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                    + java.util.UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+            content.putString("particles/probe.json", document.toString());
+            content.put(path + ".png", encoded.toByteArray());
+            final var pack = new net.raphimc.viabedrock.api.resourcepack.ResourcePack(content);
+            final byte[] archive = net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary.encode(List.of(pack), ignored -> true);
+            final var layers = net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary.decode(new java.io.ByteArrayInputStream(archive));
+            final var resources = BedrockResourceLibrary.withServerPacks(null, layers.stream()
+                    .map(net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary.Layer::resources).toList());
+            final var effect = BedrockParticleEffect.read(resources.particle("test:burst"));
+            final var image = BedrockParticleTexture.read(effect, resources).orElseThrow();
+            assertEquals(2, image.getWidth());
