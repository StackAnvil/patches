@@ -0,0 +1,67 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/** Native block expiration predicates, sharing the emitter's first nonempty block set. */
+record BedrockParticleBlocks(List<Filter> filters) {
+    BedrockParticleBlocks { filters = List.copyOf(filters); }
+
+    @FunctionalInterface
+    interface World {
+        String block(int x, int y, int z);
+    }
+
+    record Filter(Set<String> blocks, boolean inBlocks) {
+        Filter { blocks = Set.copyOf(blocks); }
+    }
+
+    static BedrockParticleBlocks read(final JsonObject components) throws IOException {
+        final List<Filter> filters = new ArrayList<>();
+        // Both native predicates use the emitter's first initialized block set.
+        for (final String name : List.of("minecraft:particle_expire_if_in_blocks", "minecraft:particle_expire_if_not_in_blocks")) {
+            final var value = components.get(name);
+            if (value == null) continue;
+            if (!value.isJsonArray() || value.getAsJsonArray().size() > 1024)
+                throw new IOException("Invalid particle expiration blocks");
+            final Set<String> blocks = new java.util.HashSet<>();
+            for (final var entry : value.getAsJsonArray()) {
+                if (!entry.isJsonPrimitive() || !entry.getAsJsonPrimitive().isString())
+                    throw new IOException("Invalid particle expiration block");
+                final String declared = entry.getAsString();
+                final String identifier = declared.contains(":") ? declared : "minecraft:" + declared;
+                if (identifier.length() > 256 || !identifier.matches("[a-z0-9_.-]+:[a-z0-9_./-]+"))
+                    throw new IOException("Invalid particle expiration block identifier");
+                blocks.add(identifier);
+            }
+            if (!blocks.isEmpty()) filters.add(new Filter(blocks, name.equals("minecraft:particle_expire_if_in_blocks")));
+        }
+        return new BedrockParticleBlocks(filters);
+    }
+
+    boolean required() { return !this.filters.isEmpty(); }
+
+    boolean expires(final Vector3f position, final Vec3 origin, final World world) {
+        if (!this.required()) return false;
+        final int x = cell(position.x, origin.x), y = cell(position.y, origin.y), z = cell(position.z, origin.z);
+        final String block = world.block(x, y, z);
+        final boolean matches = block != null && this.filters.getFirst().blocks.contains(block);
+        for (final Filter filter : this.filters) if (matches == filter.inBlocks) return true;
+        return false;
+    }
+
+    private static int cell(final float position, final double origin) {
+        return (int) Math.floor(position + (float) origin);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleChildren.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleChildren.java
