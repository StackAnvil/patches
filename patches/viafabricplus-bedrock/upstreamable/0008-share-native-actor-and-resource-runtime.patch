+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockEmitterEventsTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeLifecycleTimelineTravelAndActorLossSchedules() throws Exception {
+        final var fixture = fixture("native-emitter-events-schedule-result.json");
+        final var spec = fixture.getAsJsonObject("spec");
+        int updates = 0;
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var document = BedrockParticleEffectTest.burst();
+            final var definition = document.getAsJsonObject("particle_effect");
+            final var components = definition.getAsJsonObject("components");
+            components.remove("minecraft:emitter_lifetime_once");
+            final var duration = new JsonObject();
+            final String kind = row.get("kind").getAsString();
+            if (kind.equals("expression")) {
+                duration.addProperty("activation_expression", 1);
+                duration.addProperty("expiration_expression", 0);
+            } else {
+                duration.add("active_time", row.get("active"));
+                duration.add("sleep_time", row.get("sleep"));
+            }
+            components.add("minecraft:emitter_lifetime_" + kind, duration);
+            components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 0);
+            components.add("minecraft:emitter_initialization", json("""
+                    {"creation_expression":"q.trace(-1);", "per_update_expression":"q.trace(0);"}
+                    """));
+            final var lifecycle = json("{\"creation_event\":\"1\",\"expiration_event\":\"2\"}");
+            final var timeline = new JsonObject();
+            for (int index = 0; index < spec.getAsJsonArray("times").size(); index++)
+                timeline.addProperty(Double.toString(spec.getAsJsonArray("times").get(index).getAsLong() / 1_000_000_000D), Integer.toString(10 + index));
+            lifecycle.add("timeline", timeline);
+            lifecycle.add("travel_distance_events", distances(spec.getAsJsonArray("distances"), 20));
+            lifecycle.add("looping_travel_distance_events", intervals(spec.getAsJsonArray("intervals"), 30));
+            components.add("minecraft:emitter_lifetime_events", lifecycle);
+            final var graph = new JsonObject();
+            for (int id = 1; id <= 32; id++) {
+                final var event = json("{\"particle_effect\":{\"effect\":\"test:child\",\"type\":\"particle_with_velocity\"}}");
+                event.addProperty("expression", "q.trace(" + id + ");");
+                graph.add(Integer.toString(id), event);
+            }
+            definition.add("events", graph);
+            final List<Integer> observed = new ArrayList<>();
+            final var environment = new BedrockMolang();
+            final var base = vector(row, "base");
+            final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(4), new Vec3(base.x, base.y, base.z));
+            environment.queries(Map.of("trace", (BedrockActorAnimation.Query) arguments -> {
+                observed.add(((Number) arguments.getFirst()).intValue());
+                return 0;
+            }), 0, 0, 0);
+            final List<BedrockParticleEvents.Action> emitterActions = new java.util.ArrayList<>();
+            emitter.dispatcher(emitterActions::add);
+            for (final var update : row.getAsJsonArray("steps")) {
+                updates++;
+                final var expected = update.getAsJsonObject();
+                observed.clear();
+                final var translation = vector(expected, "translation");
+                emitter.advance(expected.get("nanos").getAsLong(), 0, expected.get("actor").getAsBoolean()
+                        ? new BedrockParticleAttachment(new Vec3(translation.x, translation.y, translation.z), 180, null, new AABB(0, 0, 0, 1, 2, 1), java.util.Map.of()) : null,
+                        (x, y, z) -> List.of());
+                final List<Integer> order = new ArrayList<>();
+                final List<JsonObject> requests = new ArrayList<>();
+                for (final var event : expected.getAsJsonArray("events")) {
+                    if (event.isJsonObject()) {
+                        order.add(event.getAsJsonObject().get("id").getAsInt());
+                        requests.add(event.getAsJsonObject());
+                    } else if (event.getAsString().equals("update")) order.add(0);
+                    else if (event.getAsString().equals("creation")) order.add(-1);
+                }
+                assertEquals(order, observed, row + "/" + updates);
+                final var actual = BedrockParticleEventsTest.drain(emitterActions).stream().map(action -> assertInstanceOf(BedrockParticleEvents.Request.class, action)).toList();
+                assertEquals(requests.size(), actual.size());
+                for (int index = 0; index < actual.size(); index++) {
+                    assertEquals(vector(requests.get(index), "position"), actual.get(index).position());
+                    assertEquals(vector(requests.get(index), "velocity"), actual.get(index).velocity());
+                }
+                assertEquals(!expected.get("expired").getAsBoolean(), emitter.alive());
+            }
+        }
+        assertEquals(364, updates);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeDistanceBoundariesRepeatsAndConversionLimits() throws Exception {
+        final var fixture = fixture("native-emitter-travel-events-result.json");
+        final var definition = new JsonObject();
+        definition.add("travel_distance_events", distances(fixture.getAsJsonArray("distances"), 20));
+        definition.add("looping_travel_distance_events", intervals(fixture.getAsJsonArray("intervals"), 30));
+        final var events = BedrockEmitterEvents.read(definition);
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final List<Integer> actual = new ArrayList<>();
+            events.travel(row.get("previous").getAsFloat(), row.get("current").getAsFloat(), row.get("expired").getAsBoolean(),
+                    names -> names.forEach(name -> actual.add(Integer.parseInt(name))));
+            final List<Integer> expected = new ArrayList<>();
+            for (final var event : row.getAsJsonArray("events")) expected.add(event.getAsInt());
+            assertEquals(expected, actual, row.toString());
+        }
+    }
+
+    @Test
+    void preservesLexicalMapOrderAndBoundsMalformedDefinitions() throws Exception {
+        final var values = json("""
+                {"timeline":{"2":"second","10":"tenth"},
+                 "travel_distance_events":{"2":"second","10":"tenth"}}
+                """);
+        final var events = BedrockEmitterEvents.read(values);
+        final List<String> timeline = new ArrayList<>(), travel = new ArrayList<>();
+        events.lifetime().advance(0, 11_000_000_000L, timeline::addAll);
+        events.travel(0, 11, false, travel::addAll);
+        assertEquals(List.of("tenth", "second"), timeline);
+        assertEquals(timeline, travel);
+        assertThrows(IOException.class, () -> BedrockEmitterEvents.read(json("{\"looping_travel_distance_events\":[{}]}")));
+        assertThrows(IOException.class, () -> BedrockEmitterEvents.read(json("{\"travel_distance_events\":{\"NaN\":\"bad\"}}")));
+    }
+
+    @Test
+    void expiresBeforeLoopInitializationAndKeepsExistingParticles() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var definition = document.getAsJsonObject("particle_effect");
+        final var components = definition.getAsJsonObject("components");
+        components.getAsJsonObject("minecraft:emitter_lifetime_once").addProperty("active_time", .05F);
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":10}"));
+        components.add("minecraft:emitter_initialization", json("{\"creation_expression\":\"v.created=(v.created??0)+1;\"}"));
+        components.add("minecraft:emitter_lifetime_events", json("{\"expiration_event\":\"end\"}"));
+        definition.add("events", json("{\"end\":{\"expression\":\"v.ended=v.created;\"}}"));
+        final var environment = new BedrockMolang();
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(4), new Vec3(7,8,9));
+        emitter.advance(0, 100, null, (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        emitter.advance(50_000_000, 100, null, (x, y, z) -> List.of());
+        assertEquals(1, environment.evaluate(BedrockMolang.Program.parse(new JsonPrimitive("v.ended"), 0), 0));
+        assertEquals(2, environment.evaluate(BedrockMolang.Program.parse(new JsonPrimitive("v.created"), 0), 0));
+        assertTrue(emitter.alive());
+        assertEquals(2, emitter.size());
+    }
+
+    private static JsonObject distances(final JsonArray values, final int offset) {
+        final var result = new JsonObject();
+        for (int index = 0; index < values.size(); index++) result.addProperty(Float.toString(values.get(index).getAsFloat()), Integer.toString(offset + index));
+        return result;
+    }
+    private static JsonArray intervals(final JsonArray values, final int offset) {
+        final var result = new JsonArray();
+        for (int index = 0; index < values.size(); index++) {
+            final var entry = new JsonObject(); entry.add("distance", values.get(index)); entry.addProperty("effects", Integer.toString(offset + index)); result.add(entry);
+        }
+        return result;
+    }
+    private static JsonObject fixture(final String name) throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), name))).getAsJsonObject();
+    }
+    private static JsonObject json(final String value) { return JsonParser.parseString(value).getAsJsonObject(); }
+    private static Vector3f vector(final JsonObject object, final String key) {
+        final var value = object.getAsJsonArray(key);
+        return new Vector3f(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+}
