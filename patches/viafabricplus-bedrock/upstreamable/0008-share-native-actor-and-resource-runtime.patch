+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.List;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.StringTag;
+import net.minecraft.world.item.component.CustomData;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import net.raphimc.viabedrock.protocol.rewriter.ItemDataRewriter;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockItemMetadataTest {
+    @AfterEach
+    void clear() {
+        BedrockItemMetadata.clear();
+    }
+
+    @Test
+    void sharesOneDefensiveReadAcrossRepeatedSkinAndAttachableQueries() {
+        final var data = spy(CustomData.of(tag()));
+        final var expected = new ItemAnimationData(72, List.of("minecraft:is_spear"), 9,
+                new ItemAnimationData.KineticWeapon(4, 11, 12, 13));
+        final var metadata = BedrockItemMetadata.get(data);
+        assertEquals("fixture:spear", metadata.identifier());
+        assertEquals(expected, metadata.animation());
+        for (int frame = 0; frame < 1024; frame++) {
+            assertSame(metadata, BedrockItemMetadata.get(data));
+            assertEquals("fixture:spear", BedrockItemMetadata.get(data).identifier());
+        }
+        verify(data, times(1)).copyTag();
+        assertThrows(UnsupportedOperationException.class, () -> metadata.animation().tags().add("other"));
+    }
+
+    @Test
+    void replacementComponentsInvalidateByIdentityAndSessionClearRetiresSnapshots() {
+        final var original = CustomData.of(tag());
+        final var equalCopy = CustomData.of(original.copyTag());
+        assertEquals(original, equalCopy);
+        final var data = spy(original);
+        final var first = BedrockItemMetadata.get(data);
+        final var equivalent = spy(equalCopy);
+        final var second = BedrockItemMetadata.get(equivalent);
+        assertNotSame(first, second);
+        verify(equivalent, times(1)).copyTag();
+        final var replacement = data.update(tag -> {
+            tag.putString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "fixture:replacement");
+            tag.putInt(ItemDataRewriter.BEDROCK_USE_DURATION_TAG, 34);
+        });
+        assertEquals("fixture:replacement", BedrockItemMetadata.get(replacement).identifier());
+        assertEquals(34, BedrockItemMetadata.get(replacement).animation().useDurationTicks());
+        assertSame(first, BedrockItemMetadata.get(data));
+        assertEquals(72, first.animation().useDurationTicks());
+        BedrockItemMetadata.clear();
+        assertNotSame(first, BedrockItemMetadata.get(data));
+    }
+
+    @Test
+    void missingAndInvalidNativeMetadataKeepJavaFallbacks() {
+        assertNull(BedrockItemMetadata.get(null).identifier());
+        assertEquals(ItemAnimationData.EMPTY, BedrockItemMetadata.get(null).animation());
+        final var malformed = new CompoundTag();
+        malformed.putInt(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, 7);
+        malformed.putInt(ItemDataRewriter.BEDROCK_USE_DURATION_TAG, -1);
+        final var metadata = BedrockItemMetadata.get(CustomData.of(malformed));
+        assertNull(metadata.identifier());
+        assertEquals(ItemAnimationData.EMPTY, metadata.animation());
+    }
+
+    private static CompoundTag tag() {
+        final var tag = new CompoundTag();
+        tag.putString(ItemDataRewriter.BEDROCK_IDENTIFIER_TAG, "fixture:spear");
+        tag.putInt(ItemDataRewriter.BEDROCK_USE_DURATION_TAG, 72);
+        final var animation = new CompoundTag();
+        final var tags = new ListTag();
+        tags.add(StringTag.valueOf("minecraft:is_spear"));
+        tags.add(StringTag.valueOf("minecraft:is_spear"));
+        animation.put("tags", tags);
+        animation.putInt("swing_duration_ticks", 9);
+        final var kinetic = new CompoundTag();
+        kinetic.putInt("delay", 4);
+        kinetic.putInt("damage_duration", 11);
+        kinetic.putInt("knockback_duration", 12);
+        kinetic.putInt("dismount_duration", 13);
+        animation.put("kinetic_weapon", kinetic);
+        tag.put(ItemDataRewriter.BEDROCK_ANIMATION_TAG, animation);
+        // Native server items can carry much more data than the animation queries actually need.
+        for (int index = 0; index < 256; index++) {
+            final var payload = new CompoundTag();
+            payload.putByteArray("payload", new byte[256]);
+            tag.put("unrelated_" + index, payload);
+        }
+        return tag;
+    }
+}
