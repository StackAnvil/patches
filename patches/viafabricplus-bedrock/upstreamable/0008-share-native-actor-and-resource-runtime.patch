+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockBoneTransformTest {
+    @Test
+    void preservesTheInheritedOriginAndClearsRotatedScaledAndSingularBases() {
+        final var bone = new ModelPart(List.of(), Map.of());
+        bone.setPos(4, -2, 3);
+        bone.setRotation(.3F, -.7F, .2F);
+        bone.xScale = .4F;
+        bone.yScale = .75F;
+        bone.zScale = 1.15F;
+        for (final var parent : List.of(
+                new Matrix4f().translation(2, -3, 4).rotateZYX(.5F, -.2F, .7F).scale(2, 3, 4),
+                new Matrix4f().translation(2, -3, 4).scale(0, 0, 0))) {
+            final var origin = parent.transformPosition(new Vector3f(bone.x, bone.y, bone.z));
+            final var expected = new Matrix4f().translation(origin).rotateZYX(bone.zRot, bone.yRot, bone.xRot)
+                    .scale(bone.xScale, bone.yScale, bone.zScale);
+            final var actual = BedrockBoneTransform.compose(new Matrix4f(parent), bone, true);
+            assertTrue(expected.equals(actual, .000001F));
+            assertFalse(BedrockBoneTransform.compose(new Matrix4f(parent), bone, false).equals(actual, .000001F));
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_BONE_MATRICES", matches = ".+")
+    void matchesNativeBoneMatrixComposition() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_BONE_MATRICES")))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        final var bone = new ModelPart(List.of(), Map.of());
+        for (final var row : cases) {
+            final var value = row.getAsJsonObject();
+            final float[] position = floats(value.getAsJsonArray("position"));
+            final float[] rotation = floats(value.getAsJsonArray("rotation"));
+            final float[] scale = floats(value.getAsJsonArray("scale"));
+            bone.setPos(position[0], position[1], position[2]);
+            bone.setRotation((float) Math.toRadians(rotation[0]), (float) Math.toRadians(rotation[1]), (float) Math.toRadians(rotation[2]));
+            bone.xScale = scale[0]; bone.yScale = scale[1]; bone.zScale = scale[2];
+            final var matrix = BedrockBoneTransform.compose(new Matrix4f().set(floats(value.getAsJsonArray("parent"))),
+                    bone, value.get("relative").getAsBoolean());
+            assertArrayEquals(floats(value.getAsJsonArray("matrix")), matrix.get(new float[16]), .000008F);
+        }
+        assertEquals(840, cases.size());
+    }
+
+    private static float[] floats(final JsonArray array) {
+        final float[] result = new float[array.size()];
+        for (int index = 0; index < result.length; index++) result[index] = array.get(index).getAsFloat();
+        return result;
+    }
+}
