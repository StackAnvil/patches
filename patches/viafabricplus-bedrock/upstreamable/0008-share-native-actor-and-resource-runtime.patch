@@ -0,0 +1,142 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.blaze3d.audio.ListenerTransform;
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.SoundCaptions;
+import net.raphimc.viabedrock.api.model.SoundPlaybackMessage;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Client pose, asynchronous caption metadata lookup, and native caption HUD presentation. */
+public final class BedrockSoundCaptions {
+    private static final SoundCaptions STATE = new SoundCaptions();
+    private static final AtomicLong GENERATION = new AtomicLong();
+    private static final ThreadPoolExecutor LOOKUP = new ThreadPoolExecutor(1, 1, 0, TimeUnit.SECONDS,
+            new ArrayBlockingQueue<>(256), Thread.ofPlatform().daemon().name("Bedrock caption lookup").factory(),
+            new ThreadPoolExecutor.DiscardPolicy());
+
+    private BedrockSoundCaptions() {}
+
+    static void accept(final SoundPlaybackMessage.Play play, final ListenerTransform listener) {
+        final var source = play.sound().positionEighths();
+        submit(play.sound().name(), play.sound().volume(),
+                new Position3f(source.x() / 8F, source.y() / 8F, source.z() / 8F), listener,
+                locale -> BedrockServerSounds.caption(play, locale));
+    }
+
+    static void accept(final BedrockResourceLibrary resources, final BedrockResourceLibrary.LevelSound sound,
+                       final Position3f source, final ListenerTransform listener) {
+        submit(sound.name(), sound.volume(), source, listener, locale -> {
+            final var definition = resources.soundDefinition(sound.name());
+            if (definition == null || definition.subtitle().isEmpty()) return null;
+            final String key = definition.subtitle();
+            return new BedrockServerSounds.Caption(key, resources.translate(key, locale));
+        });
+    }
+
+    private static void submit(final String event, final float volume, final Position3f source,
+                               final ListenerTransform listener, final CaptionLookup lookup) {
+        final var minecraft = Minecraft.getInstance();
+        final var settings = ViaFabricPlusBedrock.impl().settings();
+        if (!settings.captions().isActive() || !(volume > 0) || event.isEmpty()) return;
+        final boolean hideAmbient = settings.hideAmbientCaptions().isActive();
+        final int duration = settings.captionDuration().value().millis();
+        final String locale = minecraft.options.languageCode;
+        final Position3f player = minecraft.player == null ? Position3f.ZERO : position(minecraft.player.position());
+        // Individual particle sound events use the native unmarked local-emitter path.
+        final var direction = SoundCaptions.direction(source, player, position(listener.forward()), position(listener.up()), false);
+        final long generation = GENERATION.get();
+        LOOKUP.execute(() -> {
+            try {
+                final var caption = lookup.caption(locale);
+                if (caption == null || !SoundCaptions.admits(event, caption.key(), volume, true, hideAmbient)) return;
+                minecraft.execute(() -> {
+                    if (GENERATION.get() == generation && minecraft.level != null) {
+                        STATE.refresh(caption.text(), direction, false, duration);
+                    }
+                });
+            } catch (Exception error) {
+                ViaFabricPlusBedrock.impl().logger().warn("Could not load Bedrock sound caption {}", event, error);
+            }
+        });
+    }
+
+    @FunctionalInterface
+    private interface CaptionLookup {
+        BedrockServerSounds.Caption caption(String locale) throws java.io.IOException;
+    }
+
+    private static Position3f position(final Vec3 position) {
+        return new Position3f((float) position.x, (float) position.y, (float) position.z);
+    }
+
+    public static void clear() {
+        GENERATION.incrementAndGet();
+        LOOKUP.getQueue().clear();
+        STATE.clear();
+    }
+
+    public static void render(final GuiGraphicsExtractor graphics) {
+        STATE.advance(System.nanoTime());
+        final var minecraft = Minecraft.getInstance();
+        final var settings = ViaFabricPlusBedrock.impl().settings();
+        if (minecraft.level == null || minecraft.gui.hud.isHidden() || !settings.captions().isActive()) return;
+        final var captions = STATE.visible(settings.hideOwnCaptions().isActive());
+        if (captions.isEmpty()) return;
+        final int width = Math.max(1, (int) (graphics.guiWidth() * .3F));
+        final int left = graphics.guiWidth() - width - 50;
+        final int maxHeight = (int) (graphics.guiHeight() * .3F);
+        final var font = minecraft.font;
+        final int lineHeight = font.lineHeight + (int) (font.lineHeight * minecraft.options.chatLineSpacing().get()) + 2;
+        final var rows = new ArrayList<Row>();
+        int height = 0;
+        for (final var caption : captions) {
+            final var lines = font.split(Component.literal(caption.text()), Math.max(1, width - 18));
+            final int rowHeight = Math.max(1, lines.size()) * lineHeight;
+            rows.add(new Row(caption, lines, rowHeight));
+            height += rowHeight;
+        }
+        final boolean bottom = settings.captionPosition().value()
+                == com.viaversion.viafabricplus.bedrock.settings.CaptionPosition.BOTTOM_RIGHT;
+        final int top = bottom ? graphics.guiHeight() - Math.min(height, maxHeight) - 50 : 50;
+        graphics.enableScissor(left, top, left + width, top + maxHeight);
+        int y = top;
+        for (final var row : rows) {
+            final float opacity = row.caption.opacity();
+            final int alpha = (int) (255 * opacity);
+            if (alpha >= 4) {
+                final int background = (int) (alpha * minecraft.options.textBackgroundOpacity().get()) << 24;
+                final int color = alpha << 24 | 0xFFFFFF;
+                graphics.fill(left, y, left + width, y + row.height, background);
+                for (int index = 0; index < row.lines.size(); index++) {
+                    final var line = row.lines.get(index);
+                    graphics.text(font, line, left + (width - font.width(line)) / 2, y + index * lineHeight + 1, color, true);
+                }
+                if (!row.caption.ownSound()) {
+                    final int arrowY = y + (row.height - font.lineHeight) / 2;
+                    if (row.caption.direction() == SoundCaptions.Direction.LEFT) graphics.text(font, "<", left + 2, arrowY, color, true);
+                    else if (row.caption.direction() == SoundCaptions.Direction.RIGHT) graphics.text(font, ">", left + width - font.width(">") - 2, arrowY, color, true);
+                }
+            }
+            y += row.height;
+            if (y >= top + maxHeight) break;
+        }
+        graphics.disableScissor();
+    }
+
+    private record Row(SoundCaptions.Caption caption, java.util.List<net.minecraft.util.FormattedCharSequence> lines, int height) {}
+}
