+                return new Reference(alias, BedrockMolang.Program.parse(null, 1));
+            resolve(alias, animationDefinitions, controllerDefinitions, new HashSet<>(), 0, true);
+            return animations.containsKey(alias) || controllers.containsKey(alias)
+                    ? new Reference(alias, BedrockMolang.Program.parse(null, 1), true) : null;
