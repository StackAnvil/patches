@@ -0,0 +1,35 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+/** The player body control uses different turn limits from the generic mob control. */
+public final class BedrockPlayerBodyRotation {
+    private BedrockPlayerBodyRotation() {}
+
+    public static float tick(final float body, final float yaw, final float dx, final float dz,
+                             final boolean attacking, final boolean passenger) {
+        float target = body;
+        if ((float) Math.sqrt(dz * dz + dx * dx) > .05F) {
+            target = (float) Math.atan2(dz, dx) * 57.295776F - 90F;
+        }
+        if (attacking) target = yaw;
+        final float smoothed = wrap(target - body) * .3F + body;
+        if (passenger) return wrap(smoothed);
+
+        float relative = Math.clamp(wrap(yaw - smoothed), -75F, 75F);
+        final float excess = Math.abs(relative) - 50F;
+        if (excess > 0F) {
+            relative += relative > 0F ? -(excess * .75F) : excess * .75F;
+        }
+        return wrap(yaw - relative);
+    }
+
+    private static float wrap(final float angle) {
+        float wrapped = (angle + 180F) % 360F;
+        if (wrapped < 0F) wrapped += 360F;
+        return wrapped - 180F;
+    }
+}
