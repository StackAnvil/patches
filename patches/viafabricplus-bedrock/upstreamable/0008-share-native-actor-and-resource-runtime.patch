+                long selection = this.selections.getOrDefault(controller.name, 0L);
+                for (final CommandState entry : controller.states) {
+                    final var definition = entry.definition;
+                    try {
+                        if (slot == null) slot = this.commandSlot(controller.name, entry.name);
+                        if (slot == null) break;
+                        final StatePlayback state = slot.state(entry.name);
+                        state.bind(entry.animation);
+                        for (final String next : definition.nextStates()) {
+                            final StatePlayback target = slot.state(next);
+                            final Reference child = this.commandReference(next);
+                            if (child != null) target.bind(child);
+                        }
+                        state.command(definition);
+                        if (definition.selection() > selection) {
+                            selected = entry.name;
+                            selection = definition.selection();
+                        }
+                    } catch (IOException invalid) {
+                        this.invalidCommand(entry.name, invalid);
+                    }
+                }
+                if (slot != null && selected != null) {
+                    slot.pending = slot.state(selected);
+                    this.selections.put(controller.name, selection);
+                }
+            }
+        }
+
+        private void invalidCommand(final String animation, final IOException invalid) {
+            java.util.logging.Logger.getLogger(BedrockActorAnimation.class.getName()).log(
+                    java.util.logging.Level.WARNING, "Invalid server actor animation " + animation, invalid);
+        }
+
+        private record CommandState(String name, NativeAnimationControllers.State definition, Reference animation) {}
