@@ -0,0 +1,69 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.resources.sounds.SimpleSoundInstance;
+import net.minecraft.client.resources.sounds.SoundInstance;
+import net.minecraft.client.sounds.SoundManager;
+import net.minecraft.resources.Identifier;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.util.RandomSource;
+import net.raphimc.viabedrock.api.model.SoundPlaybackMessage;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.concurrent.ThreadLocalRandom;
+
+/** Resolves transported server samples, already licensed assets, or the mapped Java fallback. */
+final class BedrockServerSounds {
+    private BedrockServerSounds() {}
+
+    record Caption(String key, String text) {}
+
+    static Caption caption(final SoundPlaybackMessage.Play play, final String locale) throws IOException {
+        final var resources = BedrockServerResources.library();
+        final var nativeSound = resources.soundDefinition(play.sound().name());
+        if (nativeSound != null) {
+            final String key = nativeSound.subtitle();
+            return key.isEmpty() ? null : new Caption(key, resources.translate(key, locale));
+        }
+        if (play.fallback().isEmpty()) return null;
+        final var mapped = Minecraft.getInstance().getSoundManager().getSoundEvent(Identifier.parse(play.fallback()));
+        if (mapped == null || mapped.getSubtitle() == null) return null;
+        final String text = mapped.getSubtitle().getString();
+        return new Caption(text, text);
+    }
+
+    static BedrockBuiltinAssets.Contents.ResolvedSound resolve(final SoundPlaybackMessage.Play play) throws IOException {
+        try {
+            final var nativeSound = BedrockServerResources.library().soundEvent(play.sound().name(), bound -> ThreadLocalRandom.current().nextInt(bound),
+                    play.sound().volume(), play.sound().pitch(), false);
+            if (nativeSound != null) return nativeSound;
+        } catch (IOException unavailable) {
+            if (play.fallback().isEmpty()) throw unavailable;
+        }
+        if (play.fallback().isEmpty()) return null;
+        final var minecraft = Minecraft.getInstance();
+        final var categories = SoundSource.values();
+        final var category = play.category() >= 0 && play.category() < categories.length ? categories[play.category()] : SoundSource.MASTER;
+        final var request = new SimpleSoundInstance(Identifier.parse(play.fallback()), category, 1, 1, RandomSource.create(),
+                false, 0, SoundInstance.Attenuation.LINEAR, 0, 0, 0, false);
+        final var definition = request.getOrResolve(minecraft.getSoundManager());
+        final var sound = request.getSound();
+        if (definition == null || sound == SoundManager.EMPTY_SOUND || sound == SoundManager.INTENTIONALLY_EMPTY_SOUND) return null;
+        final byte[] bytes;
+        try (var input = minecraft.getResourceManager().getResourceOrThrow(sound.getPath()).open()) {
+            bytes = input.readNBytes(BedrockBuiltinAssets.MAX_FILE_BYTES + 1);
+        }
+        final var sample = new BedrockSoundEvent.Sample(sound.getPath().toString(), request.getVolume(), request.getPitch(),
+                1, sound.shouldStream(), true, true, true);
+        final var event = new BedrockSoundEvent(category.getName(), definition.getSubtitle() == null ? "" : definition.getSubtitle().getString(),
+                1, sound.getAttenuationDistance(play.sound().volume()), false, List.of(sample));
+        return new BedrockBuiltinAssets.Contents.ResolvedSound(event,
+                event.select(_ -> 0, play.sound().volume(), play.sound().pitch(), false), BedrockSoundFile.read(bytes));
+    }
+}
