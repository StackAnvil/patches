+        assertThrows(IOException.class, () -> BedrockParticleEvents.read(json("{\"run\":{\"randomize\":[{\"weight\":-1}]}}")));
+        JsonObject node = new JsonObject();
+        for (int index = 0; index < 18; index++) {
+            final var array = new com.google.gson.JsonArray(); array.add(node);
+            node = new JsonObject(); node.add("sequence", array);
