+    @Test
+    void usesMovementBeyondTheNativeThresholdAndSkipsTheLimitForPassengers() {
+        assertEquals(0F, BedrockPlayerBodyRotation.tick(0F, 0F, .05F, 0F, false, true));
+        assertEquals(-27F, BedrockPlayerBodyRotation.tick(0F, 0F, .051F, 0F, false, true));
+        assertEquals(27F, BedrockPlayerBodyRotation.tick(0F, 90F, .051F, 0F, true, true));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PLAYER_BODY", matches = ".+")
+    void matchesNativePlayerBodyControlAndSystemNormalization() throws Exception {
