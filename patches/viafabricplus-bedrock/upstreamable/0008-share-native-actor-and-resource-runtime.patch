+                {"individual_event_sounds":{"volume":"[0.2, 0.6]","pitch":1.2,"events":{
+                  "BLOCK.CLICK":"test:click", "DRIP.LAVA.POINTED_DRIPSTONE":{"sound":"test:lava","pitch":{"min":0.5,"max":0.8}},
