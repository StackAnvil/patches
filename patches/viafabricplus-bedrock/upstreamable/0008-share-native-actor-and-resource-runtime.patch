+        final int[] version = new int[3];
+        for (int index = 0; index < parts.length; index++) {
+            if (!parts[index].matches("[0-9]{1,9}")) throw new IOException("Invalid entity engine version");
+            version[index] = Integer.parseInt(parts[index]);
+        }
+        return version;
+    }
