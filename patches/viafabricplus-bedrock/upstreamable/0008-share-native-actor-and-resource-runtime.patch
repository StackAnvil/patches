+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonObject;
+import java.io.IOException;
+
+/** Authored actor scale, evaluated in the actor's current animation scope. */
+record BedrockActorScale(BedrockMolang.Program uniform, BedrockMolang.Program x,
+                         BedrockMolang.Program y, BedrockMolang.Program z) {
+    static BedrockActorScale read(final JsonObject scripts) throws IOException {
+        return new BedrockActorScale(
+                scripts == null || !scripts.has("scale") ? null : BedrockMolang.Program.parse(scripts.get("scale"), 1),
+                BedrockMolang.Program.parse(scripts == null ? null : scripts.get("scaleX"), 1),
+                BedrockMolang.Program.parse(scripts == null ? null : scripts.get("scaleY"), 1),
+                BedrockMolang.Program.parse(scripts == null ? null : scripts.get("scaleZ"), 1));
+    }
+
+    BedrockBoneAnimation.Vector sample(final BedrockMolang molang) {
+        if (this.uniform != null) {
+            final float scale = molang.evaluate(this.uniform, 1);
+            return new BedrockBoneAnimation.Vector(scale, scale, scale);
+        }
+        // The native actor root requests Z, Y, then X. Expressions can change shared variables.
+        final float scaleZ = molang.evaluate(this.z, 1);
+        final float scaleY = molang.evaluate(this.y, 1);
+        final float scaleX = molang.evaluate(this.x, 1);
+        return new BedrockBoneAnimation.Vector(scaleX, scaleY, scaleZ);
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorVisibility.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockActorVisibility.java
new file mode 100644
