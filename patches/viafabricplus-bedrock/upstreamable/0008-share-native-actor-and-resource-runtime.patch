@@ -0,0 +1,40 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+/** Volume requests and fades remain relative to the selected sample's authored gain. */
+final class BedrockSoundEnvelope {
+    private float start, target;
+    private long begins;
+    private double duration;
+
+    BedrockSoundEnvelope(final float volume) { this.set(volume); }
+
+    void set(final float volume) {
+        this.start = this.target = finite(volume);
+        this.duration = 0;
+    }
+
+    void fade(final float seconds, final float volume, final long now) {
+        final float next = finite(volume);
+        if (!Float.isFinite(seconds) || seconds < 0) throw new IllegalArgumentException("Invalid sound fade duration");
+        this.start = this.volume(now);
+        this.target = next;
+        this.begins = now;
+        this.duration = seconds * 1_000_000_000D;
+    }
+
+    float volume(final long now) {
+        if (this.duration == 0) return this.target;
+        final double amount = Math.clamp((now - this.begins) / this.duration, 0, 1);
+        return (float) (this.start + (this.target - this.start) * amount);
+    }
+
+    private static float finite(final float volume) {
+        if (!Float.isFinite(volume) || volume < 0) throw new IllegalArgumentException("Invalid sound volume");
+        return volume;
+    }
+}
