@@ -0,0 +1,93 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+import java.util.function.ToLongFunction;
+
+/** Manual child handles stay initialized after retirement and expire with their owning emitter. */
+final class BedrockParticleChildren<K, T> {
+    private final Map<K, Entry<T>> children = new HashMap<>();
+    private final List<Entry<T>> order = new ArrayList<>();
+    private final ToLongFunction<K> hash;
+    private int buckets = 8;
+
+    BedrockParticleChildren(final ToLongFunction<K> hash) { this.hash = hash; }
+
+    Resolution<T> acquire(final K key, final Predicate<T> registered, final Supplier<T> factory) {
+        Entry<T> entry = this.children.get(key);
+        if (entry == null) {
+            entry = new Entry<>(this.hash.applyAsLong(key));
+            if (this.children.size() == this.buckets) this.grow();
+            this.insert(entry);
+            this.children.put(key, entry);
+        }
+        if (entry.initialized) {
+            final T child = entry.child.get();
+            if (child != null && registered.test(child)) return new Resolution<>(child, false);
+            entry.child.clear();
+            return new Resolution<>(null, false);
+        }
+        final T child = factory.get();
+        if (child != null) {
+            entry.child = new WeakReference<>(child);
+            entry.initialized = true;
+        }
+        return new Resolution<>(child, child != null);
+    }
+
+    void discard(final K key, final T child) {
+        final Entry<T> entry = this.children.get(key);
+        if (entry != null && entry.child.get() == child) {
+            entry.child.clear();
+            entry.initialized = false;
+        }
+    }
+
+    void retire(final Predicate<T> registered, final Consumer<T> expire) {
+        try {
+            for (final Entry<T> entry : this.order) {
+                final T child = entry.child.get();
+                if (child != null && registered.test(child)) expire.accept(child);
+            }
+        } finally {
+            this.children.clear();
+            this.order.clear();
+            this.buckets = 8;
+        }
+    }
+
+    private void grow() {
+        this.buckets *= this.buckets < 512 ? 8 : 2;
+        final var previous = List.copyOf(this.order);
+        this.order.clear();
+        previous.forEach(this::insert);
+    }
+
+    private void insert(final Entry<T> entry) {
+        final long bucket = entry.hash & (this.buckets - 1);
+        int index = 0;
+        while (index < this.order.size() && (this.order.get(index).hash & (this.buckets - 1)) != bucket) index++;
+        this.order.add(index, entry);
+    }
+
+    private static final class Entry<T> {
+        private final long hash;
+        private WeakReference<T> child = new WeakReference<>(null);
+        private boolean initialized;
+
+        private Entry(final long hash) { this.hash = hash; }
+    }
+
+    record Resolution<T>(T child, boolean created) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCollision.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCollision.java
