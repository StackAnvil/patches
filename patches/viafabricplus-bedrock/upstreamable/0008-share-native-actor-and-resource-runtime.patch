+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.junit.jupiter.api.Test;
+
+import javax.sound.sampled.AudioFormat;
+import java.nio.ByteOrder;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+class BedrockPcmStreamTest {
+    private static final AudioFormat FORMAT = new AudioFormat(1000, 16, 1, true, false);
+    private static final byte[] SAMPLE = {1, 0, 2, 0, 3, 0};
+
+    @Test
+    void finiteLoopsPreserveFrameAlignmentAndOffset() {
+        final var stream = new BedrockPcmStream(SAMPLE, FORMAT, 2, 0.001F);
+        final var first = stream.read(5).order(ByteOrder.LITTLE_ENDIAN);
+        assertEquals(4, first.remaining());
+        assertEquals(2, first.getShort());
+        assertEquals(3, first.getShort());
+        stream.processed(1);
+        assertEquals(1, stream.remainingLoops(0));
+        final var remaining = stream.read(100).order(ByteOrder.LITTLE_ENDIAN);
+        assertEquals(12, remaining.remaining());
+        for (int loop = 0; loop < 2; loop++) {
+            for (int frame = 1; frame <= 3; frame++) assertEquals(frame, remaining.getShort());
+        }
+        assertNull(stream.read(100));
+    }
+
+    @Test
+    void infiniteAndLargeLoopCountsDoNotDuplicateSampleStorage() {
+        for (final int loops : new int[]{-1, Integer.MAX_VALUE}) {
+            final var stream = new BedrockPcmStream(SAMPLE, FORMAT, loops, 0);
+            final var bytes = stream.read(120).order(ByteOrder.LITTLE_ENDIAN);
+            for (int frame = 0; frame < 60; frame++) assertEquals(frame % 3 + 1, bytes.getShort());
+            stream.processed(1);
+            assertEquals(loops == -1 ? -1 : Integer.MAX_VALUE - 20, stream.remainingLoops(0));
+            stream.close();
+            assertNull(stream.read(120));
+        }
+    }
+
+    @Test
+    void remainingLoopsUsePlayedFramesInsteadOfPrefetchedFrames() {
+        final var stream = new BedrockPcmStream(SAMPLE, FORMAT, 100, 0);
+        stream.read(120);
+        stream.read(120);
+        assertEquals(100, stream.remainingLoops(0));
+        stream.processed(1);
+        assertEquals(80, stream.remainingLoops(0));
+        assertEquals(78, stream.remainingLoops(6));
+        assertThrows(IllegalArgumentException.class, () -> stream.read(-1));
+        assertThrows(IllegalArgumentException.class, () -> new BedrockPcmStream(SAMPLE, FORMAT, -2, 0));
+    }
+}
