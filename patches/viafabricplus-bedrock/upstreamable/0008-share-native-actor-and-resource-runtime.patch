+        final var crossbow = new ItemStack(Items.CROSSBOW);
+        assertEquals(0, BedrockFirstPersonItemRendering.animationFrame(crossbow));
+        crossbow.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.ofNonEmpty(List.of(new ItemStack(Items.ARROW))));
+        assertEquals(4, BedrockFirstPersonItemRendering.animationFrame(crossbow));
+        crossbow.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.ofNonEmpty(List.of(new ItemStack(Items.FIREWORK_ROCKET))));
+        assertEquals(5, BedrockFirstPersonItemRendering.animationFrame(crossbow));
