+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.redlance.mocha.runtime.value.ObjectProperty;
+import org.redlance.mocha.runtime.value.ObjectValue;
+import org.redlance.mocha.runtime.value.Value;
+
+import java.util.Locale;
+import java.util.Map;
+
+/** Read-only RGBA query structure with native float32 channels. */
+public record BedrockMolangColor(float r, float g, float b, float a) implements ObjectValue {
+    public static final BedrockMolangColor ZERO = new BedrockMolangColor(0, 0, 0, 0);
+
+    public static BedrockMolangColor fromArgb(final int color) {
+        return new BedrockMolangColor((color >>> 16 & 255) / 255F, (color >>> 8 & 255) / 255F,
+                (color & 255) / 255F, (color >>> 24) / 255F);
+    }
+
+    @Override
+    public ObjectProperty getProperty(final String name) {
+        return switch (name.toLowerCase(Locale.ROOT)) {
+            case "r" -> ObjectProperty.property(Value.of(this.r), true);
+            case "g" -> ObjectProperty.property(Value.of(this.g), true);
+            case "b" -> ObjectProperty.property(Value.of(this.b), true);
+            case "a" -> ObjectProperty.property(Value.of(this.a), true);
+            default -> null;
+        };
+    }
+
+    @Override
+    public Map<String, ObjectProperty> entries() {
+        return Map.of("r", this.getProperty("r"), "g", this.getProperty("g"),
+                "b", this.getProperty("b"), "a", this.getProperty("a"));
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMolangVariables.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockMolangVariables.java
