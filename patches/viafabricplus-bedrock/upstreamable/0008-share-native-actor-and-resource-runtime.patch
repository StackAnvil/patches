+                .getAsJsonObject();
+        for (final var value : fixture.getAsJsonArray("cases")) compare(value.getAsJsonObject());
+        for (final var sequence : fixture.getAsJsonArray("chains")) {
+            for (final var value : sequence.getAsJsonArray()) compare(value.getAsJsonObject());
+        }
+    }
+
+    private static void compare(final JsonObject row) {
+        final float actual = BedrockPlayerBodyRotation.tick(row.get("body").getAsFloat(), row.get("yaw").getAsFloat(),
+                row.get("dx").getAsFloat(), row.get("dz").getAsFloat(), row.get("attacking").getAsBoolean(),
+                row.get("mounted").getAsBoolean());
+        assertEquals(Float.floatToRawIntBits(row.get("result").getAsFloat()), Float.floatToRawIntBits(actual));
+    }
