+            assertEquals(BedrockParticleEvents.Kind.PARTICLE, event.spawn().kind());
+            assertEquals(new Vector3f(), event.velocity());
+            assertTrue(event.position().y > .01F && event.position().y < .011F);
+        }
+        assertEquals(3, splash.size());
+        splash.advance(50_000_000, 100, null, terrain);
+        assertEquals(3, splash.size());
+        for (int step = 0; step < 10 && splash.size() != 0; step++) splash.advance(50_000_000, 100, null, terrain);
+        assertEquals(0, splash.size());
