@@ -0,0 +1,100 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockMolangColor;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.Connection;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.api.model.NativeActorBoundsMessage;
+import net.raphimc.viabedrock.api.model.NativeActorStates;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+
+import java.util.UUID;
+
+/** Native actor inputs received on the current Minecraft connection's client thread. */
+public final class BedrockActorState {
+    private static final NativeActorStates ACTORS = new NativeActorStates();
+    private static volatile long generation;
+    private static boolean uniqueIdsAvailable;
+
+    private BedrockActorState() {}
+
+    public static void accept(final Connection connection, final NativeActorMessage message) {
+        accept(connection, localPlayer -> apply(message, localPlayer));
+    }
+
+    public static void accept(final Connection connection, final NativeActorBoundsMessage message) {
+        accept(connection, localPlayer -> ACTORS.apply(message, localPlayer));
+    }
+
+    public static NativeActorBoundsMessage bounds(final UUID uuid) { return ACTORS.bounds(uuid); }
+
+    private static void accept(final Connection connection, final java.util.function.Consumer<UUID> update) {
+        final long receivedGeneration = generation;
+        Minecraft.getInstance().execute(() -> {
+            final var listener = Minecraft.getInstance().getConnection();
+            if (generation == receivedGeneration && connection.isConnected()
+                    && listener != null && listener.getConnection() == connection) {
+                update.accept(listener.getLocalGameProfile().id());
+            }
+        });
+    }
+
+    static void apply(final NativeActorMessage message, final UUID localPlayer) {
+        if (message instanceof NativeActorMessage.Snapshot snapshot) uniqueIdsAvailable = snapshot.uniqueId() != null;
+        ACTORS.apply(message, localPlayer);
+    }
+
+    public static NativeActorMessage.Snapshot state(final UUID uuid) {
+        return ACTORS.get(uuid);
+    }
+
+    public static NativeActorMessage.Snapshot stateByRuntimeId(final long runtimeId) {
+        return ACTORS.getByRuntimeId(runtimeId);
+    }
+
+    public static boolean supportsUniqueIds() { return uniqueIdsAvailable; }
+
+    public static UUID uuidByUniqueId(final long uniqueId) {
+        return ACTORS.uuidByUniqueId(uniqueId);
+    }
+
+    public static UUID lifetime(final UUID uuid) {
+        final var state = state(uuid);
+        return state == null ? null : state.lifetime();
+    }
+
+    public static boolean isCharging(final UUID uuid) {
+        final var state = state(uuid);
+        return state != null && state.flags().contains(ActorFlags.CHARGING);
+    }
+
+    public static boolean isBlocking(final UUID uuid, final boolean javaBlocking) {
+        final var state = state(uuid);
+        return state == null ? javaBlocking : state.flags().contains(ActorFlags.BLOCKING);
+    }
+
+    public static void tick() {
+        ACTORS.tick();
+    }
+
+    public static float shieldBlockingBob(final UUID uuid, final float frameAlpha) {
+        return ACTORS.shieldBlockingBob(uuid, frameAlpha);
+    }
+
+    public static BedrockMolangColor spellColor(final UUID uuid, final UUID lifetime) {
+        final var state = state(uuid);
+        return state != null && state.lifetime().equals(lifetime) && state.spellColor() != null
+                ? BedrockMolangColor.fromArgb(state.spellColor()) : BedrockMolangColor.ZERO;
+    }
+
+    public static void clear() {
+        generation++;
+        ACTORS.clear();
+        uniqueIdsAvailable = false;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockAnimatedModel.java b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockAnimatedModel.java
new file mode 100644
index 0000000..1c1c8c8
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/render/BedrockAnimatedModel.java
@@ -0,0 +1,190 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+
+import net.minecraft.client.model.Model;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.client.model.player.PlayerModel;
+import net.minecraft.client.renderer.rendertype.RenderTypes;
+
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Matrix4f;
+import org.joml.Quaternionf;
+import org.joml.Vector3f;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/** A menu model retaining the authored hierarchy, including root and waist pivots. */
+public final class BedrockAnimatedModel {
+    private final Model.Simple model;
+    private final boolean humanoidNames;
+    private final Map<String, ModelPart> parts;
+    private final Map<ModelPart, String> names = new HashMap<>();
+    private final Map<ModelPart, ModelPart> parents = new HashMap<>();
+    private final Set<ModelPart> entityRelative = new HashSet<>();
+
+    BedrockAnimatedModel(
+            final ModelPart root,
+            final Map<String, ModelPart> parts,
+            final BedrockGeometryModel geometry) {
+        this(root, parts, geometry, true);
+    }
+
+    BedrockAnimatedModel(final ModelPart root, final Map<String, ModelPart> parts,
+                         final BedrockGeometryModel geometry, final boolean humanoidNames) {
+        this.humanoidNames = humanoidNames;
+        this.model = new Model.Simple(root, RenderTypes::entityTranslucent);
+        final Map<String, ModelPart> normalized = new HashMap<>();
+        parts.forEach((name, part) -> { normalized.put(this.boneName(name), part); this.names.put(part, name); });
+        this.parts = Map.copyOf(normalized);
+        for (final var definition : geometry.getParents()) {
+            final ModelPart child = parts.get(definition.getName());
+            final ModelPart parent = parts.get(definition.getParent());
+            if (parent != null) this.parents.put(child, parent);
+        }
+        BedrockModelTransforms.register(this, root, this.parts.values());
+    }
+
+    public Model.Simple model() {
+        return this.model;
+    }
+
+    Vector3f locator(final BedrockModelLocators.Locator locator) {
+        final Matrix4f matrix = this.locatorTransform(locator);
+        return matrix == null ? null : matrix.getTranslation(new Vector3f());
+    }
+
+    Matrix4f locatorTransform(final BedrockModelLocators.Locator locator) {
+        final ModelPart bone = this.parts.get(this.boneName(locator.bone()));
+        if (bone == null) return null;
+        return BedrockModelLocators.transform(this.global(bone, new HashMap<>()), locator);
+    }
+
+    Matrix4f worldLocator(final BedrockModelLocators.Locator locator, final net.minecraft.world.phys.Vec3 position, final float yaw) {
+        return this.worldLocator(locator, position, yaw, 1F);
+    }
+
+    Matrix4f worldLocator(final BedrockModelLocators.Locator locator, final net.minecraft.world.phys.Vec3 position,
+                          final float yaw, final float scale) {
+        final Matrix4f local = this.locatorTransform(locator);
+        if (local == null) return null;
+        // Bone translations are pixels; particle directions retain the bone's rotation and scale.
+        local.m30(local.m30() / 16F).m31(local.m31() / 16F).m32(local.m32() / 16F);
+        return new Matrix4f().translation((float) position.x, (float) position.y, (float) position.z)
+                .rotateY((float) Math.toRadians(180 - yaw)).scale(scale).translate(0, 1.5F, 0)
+                .scale(-1, -1, 1).mul(local).scale(-1, -1, 1);
+    }
+
+    public void pose(final Map<String, BedrockBoneAnimation.Transform> transforms) {
+        this.model.root().getAllParts().forEach(ModelPart::resetPose);
+        this.entityRelative.clear();
+        transforms.forEach(
+                (name, transform) -> {
+                    final ModelPart part = this.parts.get(this.boneName(name));
+                    if (part == null) return;
+                    if (transform.entityRelativeRotation()) this.entityRelative.add(part);
+                    part.x += transform.position().x();
+                    part.y -= transform.position().y();
+                    part.z += transform.position().z();
+                    part.xRot += (float) Math.toRadians(transform.rotation().x());
+                    part.yRot += (float) Math.toRadians(transform.rotation().y());
+                    part.zRot += (float) Math.toRadians(transform.rotation().z());
+                    part.xScale *= transform.scale().x();
+                    part.yScale *= transform.scale().y();
+                    part.zScale *= transform.scale().z();
+                });
+    }
+
+    void visibility(final com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation.Visibility visibility) {
+        this.names.forEach((part, name) -> {
+            final boolean visible = visibility.visible(name, this.humanoidNames);
+            // A hidden surface does not hide separately controlled child bones.
+            for (int cube = 0; part.hasChild("cube_" + cube); cube++) part.getChild("cube_" + cube).visible = visible;
+            if (part.hasChild("mesh")) part.getChild("mesh").visible = visible;
+        });
+    }
+
+    boolean usesNativeMatrices() {
+        return !this.entityRelative.isEmpty();
+    }
+
+    Map<ModelPart, Matrix4f> drawingMatrices() {
+        final Map<ModelPart, Matrix4f> matrices = new HashMap<>();
+        this.parts.values().forEach(part -> this.global(part, matrices));
+        matrices.values().forEach(matrix -> matrix.m30(matrix.m30() / 16F)
+                .m31(matrix.m31() / 16F).m32(matrix.m32() / 16F));
+        return matrices;
+    }
+
+    /** Flatten global bone transforms only for armor and held-item attachment models. */
+    void copyHumanoidPose(final PlayerModel target) {
+        final Map<ModelPart, Matrix4f> matrices = new HashMap<>();
+        final Map<String, ModelPart> humanoid =
+                Map.of(
+                        "head",
+                        target.head,
+                        "body",
+                        target.body,
+                        "rightarm",
+                        target.rightArm,
+                        "leftarm",
+                        target.leftArm,
+                        "rightleg",
+                        target.rightLeg,
+                        "leftleg",
+                        target.leftLeg);
+        humanoid.forEach(
+                (name, destination) -> {
+                    final ModelPart source = this.parts.get(name);
+                    if (source == null) return;
+                    source.visible = destination.visible;
+                    final Matrix4f matrix = this.global(source, matrices);
+                    final Vector3f position = matrix.getTranslation(new Vector3f());
+                    final Vector3f rotation =
+                            matrix.getUnnormalizedRotation(new Quaternionf())
+                                    .normalize()
+                                    .getEulerAnglesZYX(new Vector3f());
+                    final Vector3f scale = matrix.getScale(new Vector3f());
+                    destination.setPos(position.x, position.y, position.z);
+                    destination.setRotation(rotation.x, rotation.y, rotation.z);
+                    destination.xScale = scale.x;
+                    destination.yScale = scale.y;
+                    destination.zScale = scale.z;
+                });
+        target.hat.loadPose(target.head.storePose());
+        target.rightSleeve.loadPose(target.rightArm.storePose());
+        target.leftSleeve.loadPose(target.leftArm.storePose());
+        target.rightPants.loadPose(target.rightLeg.storePose());
+        target.leftPants.loadPose(target.leftLeg.storePose());
+        target.jacket.loadPose(target.body.storePose());
+    }
+
+    private Matrix4f global(final ModelPart part, final Map<ModelPart, Matrix4f> matrices) {
+        final Matrix4f cached = matrices.get(part);
+        if (cached != null) return cached;
+        final ModelPart parent = this.parents.get(part);
+        final Matrix4f transform =
+                parent == null ? new Matrix4f() : new Matrix4f(this.global(parent, matrices));
+        BedrockBoneTransform.compose(transform, part, this.entityRelative.contains(part));
+        matrices.put(part, transform);
+        return transform;
+    }
+
+    private String boneName(final String name) {
+        return this.humanoidNames ? normalize(name) : name;
+    }
+
+    private static String normalize(final String name) {
+        final String normalized = name.toLowerCase(Locale.ROOT).replace("_", "");
+        return normalized.equals("hip") ? "waist" : normalized;
+    }
+}
