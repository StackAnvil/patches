+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockAcceptedResources;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.packs.PackLocationInfo;
+import net.minecraft.server.packs.PackResources;
+import net.minecraft.server.packs.repository.PackSource;
+import net.minecraft.server.packs.resources.Resource;
+import net.minecraft.server.packs.resources.ResourceManager;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.api.resourcepack.ResourcePack;
+import net.raphimc.viabedrock.api.resourcepack.content.InMemoryContent;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.lang.reflect.Proxy;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockServerResourcesTest {
+
+    @AfterEach
+    void clear() {
+        BedrockServerResources.clear();
+    }
+
+    @Test
+    void refreshesDerivedEffectsAfterActorInvalidationAndResourceManagerReplacement() throws Exception {
+        final var bytes = new AtomicReference<>(archive((byte) 1));
+        final var manager = resources(bytes);
+        final var first = BedrockServerResources.library(manager, null);
+        assertArrayEquals(new byte[]{1}, first.file("textures/shared.png"));
+        bytes.set(archive((byte) 2));
+        assertSame(first, BedrockServerResources.library(manager, null));
+        BedrockAcceptedResources.clear();
+        final var refreshed = BedrockServerResources.library(manager, null);
+        assertNotSame(first, refreshed);
+        assertArrayEquals(new byte[]{2}, refreshed.file("textures/shared.png"));
+        bytes.set(archive((byte) 3));
+        final var replaced = BedrockServerResources.library(resources(bytes), null);
+        assertNotSame(refreshed, replaced);
+        assertArrayEquals(new byte[]{3}, replaced.file("textures/shared.png"));
+    }
+
+    private static byte[] archive(final byte texture) throws IOException {
+        final var content = new InMemoryContent();
+        content.putString("manifest.json", "{\"format_version\":2,\"header\":{\"name\":\"test\",\"uuid\":\""
+                + UUID.randomUUID() + "\",\"version\":[1,0,0]}}");
+        content.put("textures/shared.png", new byte[]{texture});
+        return NativeActorLibrary.encode(List.of(new ResourcePack(content)), ignored -> true);
+    }
+
+    private static ResourceManager resources(final AtomicReference<byte[]> bytes) {
+        final var location = new PackLocationInfo("test", Component.empty(), PackSource.SERVER, Optional.empty());
+        final var pack = (PackResources) Proxy.newProxyInstance(PackResources.class.getClassLoader(), new Class[]{PackResources.class},
+                (proxy, method, arguments) -> method.getName().equals("location") ? location : null);
+        final var resource = new Resource(pack, () -> new ByteArrayInputStream(bytes.get()));
+        return (ResourceManager) Proxy.newProxyInstance(ResourceManager.class.getClassLoader(), new Class[]{ResourceManager.class},
+                (proxy, method, arguments) -> method.getName().equals("getResourceStack") ? List.of(resource) : null);
+    }
+}
