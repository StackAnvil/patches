+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.renderpearl.api.pipeline.BlendFactor;
+import com.mojang.renderpearl.api.pipeline.BlendFunction;
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.DepthStencilState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import com.mojang.renderpearl.api.vertex.VertexFormat;
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderPipelines;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.oit.OitPipelineSet;
+import net.minecraft.resources.Identifier;
+
+import java.util.List;
+import java.util.Optional;
+
+/** Native particle materials with matching forward state and Java transparency passes. */
+public final class BedrockParticleRenderTypes {
+    private static final RenderPipeline OPAQUE = solid(false), ALPHA = solid(true);
+    private static final Translucent BLEND = translucent(false), ADD = translucent(true);
+    public static final List<RenderPipeline> PIPELINES = List.of(OPAQUE, ALPHA,
+            BLEND.forward, BLEND.oit.depthBoundsPipeline(), BLEND.oit.transmittancePipeline(), BLEND.oit.accumulatePipeline(),
+            ADD.forward, ADD.oit.depthBoundsPipeline(), ADD.oit.transmittancePipeline(), ADD.oit.accumulatePipeline());
+
+    private BedrockParticleRenderTypes() {}
+
+    static RenderPipeline pipeline(final String material) {
+        return switch (material) {
+            case "particles_opaque" -> OPAQUE;
+            case "particles_alpha" -> ALPHA;
+            case "particles_blend" -> BLEND.forward;
+            case "particles_add" -> ADD.forward;
+            default -> throw new IllegalArgumentException("Unsupported particle material: " + material);
+        };
+    }
+
+    static Optional<OitPipelineSet> oit(final String material) {
+        return switch (material) {
+            case "particles_blend" -> Optional.of(BLEND.oit);
+            case "particles_add" -> Optional.of(ADD.oit);
+            default -> Optional.empty();
+        };
+    }
+
+    private static RenderPipeline solid(final boolean alphaTest) {
+        final var builder = copy(RenderPipelines.OPAQUE_PARTICLE, alphaTest ? "alpha" : "opaque")
+                .withColorTargetState(new ColorTargetState(Optional.empty(), ColorTargetState.DEFAULT.format(), ColorTargetState.WRITE_COLOR))
+                .withCull(true);
+        if (alphaTest) builder.withShaderDefine("ALPHA_TEST");
+        return BedrockShaderPipelines.register(builder.build(), RenderPipelines.OPAQUE_PARTICLE);
+    }
+
+    private static Translucent translucent(final boolean additive) {
+        final String name = additive ? "add" : "blend";
+        final var blend = additive ? new BlendFunction(BlendFactor.SRC_ALPHA, BlendFactor.ONE)
+                : new BlendFunction(BlendFactor.SRC_ALPHA, BlendFactor.ONE_MINUS_SRC_ALPHA, BlendFactor.ONE, BlendFactor.ONE_MINUS_SRC_ALPHA);
+        final var forward = BedrockShaderPipelines.register(transparent(RenderPipelines.TRANSLUCENT_PARTICLE, name, additive)
+                .withColorTargetState(new ColorTargetState(blend)).build(), RenderPipelines.TRANSLUCENT_PARTICLE);
+        final var original = RenderPipelines.OIT_PARTICLE;
+        final var oit = new OitPipelineSet(
+                transparent(original.depthBoundsPipeline(), name + "_depth", additive).build(),
+                transparent(original.transmittancePipeline(), name + "_transmittance", additive).build(),
+                transparent(original.accumulatePipeline(), name + "_accumulate", additive).build());
+        return new Translucent(forward, oit);
+    }
+
+    private static RenderPipeline.Builder transparent(final RenderPipeline original, final String name, final boolean additive) {
+        final var depth = original.getDepthStencilState();
+        final var builder = copy(original, name).withShaderDefine("TRANSLUCENT").withCull(false)
+                .withDepthStencilState(new DepthStencilState(depth.depthTest(), false, depth.depthBiasScaleFactor(), depth.depthBiasConstant()));
+        if (additive) builder.withShaderDefine("OIT_ADDITIVE");
+        return builder;
+    }
+
+    private static RenderPipeline.Builder copy(final RenderPipeline original, final String name) {
+        final ColorTargetState[] colors = original.getColorTargetStates().toArray(ColorTargetState[]::new);
+        final var snippet = new RenderPipeline.Snippet(original.getShaders(),
+                Optional.of(original.getShaderDefines()), Optional.of(original.getBindGroupLayouts()), colors, colors.length,
+                Optional.ofNullable(original.getDepthStencilState()), Optional.of(original.getPolygonMode()),
+                Optional.of(original.isCull()), original.getVertexFormatBindings().toArray(VertexFormat[]::new),
+                Optional.of(original.getPrimitiveTopology()), original.pushConstantSize());
+        return RenderPipeline.builder(snippet)
+                .withLocation(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "pipeline/particle_" + name))
+                .withFragmentShader(Identifier.fromNamespaceAndPath("viafabricplus-bedrock", "core/bedrock_particle"));
+    }
+
+    private record Translucent(RenderPipeline forward, OitPipelineSet oit) {}
+}
