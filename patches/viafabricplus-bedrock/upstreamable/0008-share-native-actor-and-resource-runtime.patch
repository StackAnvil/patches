+final class BedrockNativeFluidTest {
+    @Test
+    void preservesAllMappedLiquidLevelsAndRejectsNonliquidDictionaryStates() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        for (final var block : new Block[]{Blocks.WATER, Blocks.LAVA}) {
