+
+final class BedrockParticleShapeTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeSamplingProjectionDirectionsAndRandomConsumption() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-shape-result.json"))).getAsJsonObject();
+        final var cases = fixture.getAsJsonArray("cases");
+        for (int index = 0; index < cases.size(); index++) {
+            final var row = cases.get(index).getAsJsonObject();
