--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaAnimations.java
@@ -0,0 +1,128 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+
+import net.raphimc.viabedrock.protocol.model.SkinData.AnimationData;
+import net.raphimc.viabedrock.protocol.types.primitive.ImageType;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+
+import javax.imageio.ImageIO;
+
+/** Stores animation strips as PNGs while supplying the native RGBA client claims. */
+final class BedrockPersonaAnimations {
+    private BedrockPersonaAnimations() {}
+
+    static JsonArray write(final List<AnimationData> animations) throws IOException {
+        final JsonArray result = new JsonArray();
+        for (final var animation : animations) {
+            validate(animation);
+            final ByteArrayOutputStream output = new ByteArrayOutputStream();
+            ImageIO.write(animation.image(), "png", output);
+            final JsonObject entry = new JsonObject();
+            entry.addProperty("image", Base64.getEncoder().encodeToString(output.toByteArray()));
+            entry.addProperty("type", animation.type());
+            entry.addProperty("frames", animation.frames());
+            entry.addProperty("expression", animation.expression());
+            result.add(entry);
+        }
+        return result;
+    }
+
+    static List<AnimationData> read(final JsonArray json) throws IOException {
+        if (json == null) return List.of();
+        if (json.size() > 3) throw new IOException("The character has too many animation surfaces");
+        final List<AnimationData> result = new ArrayList<>();
+        for (final var element : json) {
+            final JsonObject entry = element.getAsJsonObject();
+            final byte[] bytes = Base64.getDecoder().decode(entry.get("image").getAsString());
+            final BufferedImage image = image(bytes);
+            final AnimationData animation =
+                    new AnimationData(
+                            image,
+                            entry.get("type").getAsInt(),
+                            entry.get("frames").getAsFloat(),
+                            entry.get("expression").getAsInt());
+            validate(animation);
+            result.add(animation);
+        }
+        return List.copyOf(result);
+    }
+
+    static BufferedImage image(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("The animation image is missing or too large");
+        try (final var stream = ImageIO.createImageInputStream(new ByteArrayInputStream(bytes))) {
+            final var readers = ImageIO.getImageReaders(stream);
+            if (!readers.hasNext()) throw new IOException("The animation image is invalid");
+            final var reader = readers.next();
+            try {
+                reader.setInput(stream);
+                final int width = reader.getWidth(0);
+                final int height = reader.getHeight(0);
+                if (width < 1
+                        || height < 1
+                        || width > 1024
+                        || height > 32768
+                        || (long) width * height > 4 * 1024 * 1024) {
+                    throw new IOException("The animation image dimensions are invalid");
+                }
+                return reader.read(0);
+            } finally {
+                reader.dispose();
+            }
+        }
+    }
+
+    static List<Map<String, Object>> claims(final List<AnimationData> animations) {
+        return animations.stream()
+                .map(
+                        animation ->
+                                Map.<String, Object>of(
+                                        "Image",
+                                        Base64.getEncoder()
+                                                .encodeToString(
+                                                        ImageType.getImageData(animation.image())),
+                                        "ImageWidth",
+                                        animation.image().getWidth(),
+                                        "ImageHeight",
+                                        animation.image().getHeight(),
+                                        "Type",
+                                        animation.type(),
+                                        "Frames",
+                                        animation.frames(),
+                                        "AnimationExpression",
+                                        animation.expression()))
+                .toList();
+    }
+
+    private static void validate(final AnimationData animation) throws IOException {
+        final BufferedImage image = animation.image();
+        if (image == null
+                || animation.type() < 1
+                || animation.type() > 3
+                || animation.frames() < 1
+                || animation.frames() > 256
+                || animation.frames() != Math.floor(animation.frames())
+                || image.getWidth() < 1
+                || image.getWidth() > 1024
+                || image.getHeight() < 1
+                || (long) image.getWidth() * image.getHeight() > 4 * 1024 * 1024
+                || image.getHeight() % (int) animation.frames() != 0) {
+            throw new IOException("The character animation strip is invalid");
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaSources.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaSources.java
new file mode 100644
index 0000000..a207474
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPersonaSources.java
@@ -0,0 +1,228 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.Predicate;
+
+/** Decodes persona texture sources and their native channel masks without changing tint values. */
+final class BedrockPersonaSources {
+    private BedrockPersonaSources() {}
+
+    static List<JsonObject> metadata(final BedrockMarketplaceAssets.Pack pack) throws IOException {
+        final List<JsonObject> result = new ArrayList<>();
+        try {
+            for (final var entry : pack.files().entrySet()) {
+                if (!entry.getKey().endsWith(".meta.json")) continue;
+                if (entry.getValue().length > 2 * 1024 * 1024)
+                    throw new IOException("The persona metadata is too large");
+                result.add(
+                        JsonParser.parseString(new String(entry.getValue(), StandardCharsets.UTF_8))
+                                .getAsJsonObject());
+            }
+            return List.copyOf(result);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid persona metadata", invalid);
+        }
+    }
+
+    static int order(final String type) throws IOException {
+        if (!type.startsWith("persona_"))
+            throw new IOException("A texture has an unknown persona piece type");
+        final String name =
+                "persona_hand".equals(type)
+                        ? "hands"
+                        : type.substring("persona_".length()).replace("_", "");
+        for (final var value :
+                net.raphimc.viabedrock.protocol.data.enums.bedrock.generated.persona_PieceType
+                        .values())
+            if (value.name().replace("_", "").equalsIgnoreCase(name)) return value.getValue();
+        throw new IOException("A texture has an unknown persona piece type");
+    }
+
+
+
+
+
+    static List<Texture> read(final BedrockMarketplaceAssets.Pack pack) throws IOException {
+        return read(pack, source -> true);
+    }
+
+
+
+    static Map<String, JsonObject> geometries(final BedrockMarketplaceAssets.Pack pack)
+            throws IOException {
+        final Map<String, JsonObject> result = new LinkedHashMap<>();
+        try {
+            for (final var file : pack.files().entrySet()) {
+                if (!file.getKey().endsWith(".geometry.json")) continue;
+                final JsonObject json =
+                        JsonParser.parseString(new String(file.getValue(), StandardCharsets.UTF_8))
+                                .getAsJsonObject();
+                omitNullFields(json);
+                if (json.has("minecraft:geometry")) {
+                    for (final var entry : json.getAsJsonArray("minecraft:geometry")) {
+                        final JsonObject geometry = entry.getAsJsonObject();
+                        final String name =
+                                geometry.getAsJsonObject("description")
+                                        .get("identifier")
+                                        .getAsString();
+                        if (result.putIfAbsent(name, geometry) != null)
+                            throw new IOException("A persona geometry name is ambiguous");
+                    }
+                } else {
+                    for (final var entry : json.entrySet())
+                        if (entry.getKey().startsWith("geometry.")
+                                && result.putIfAbsent(
+                                                entry.getKey(), entry.getValue().getAsJsonObject())
+                                        != null)
+                            throw new IOException("A persona geometry name is ambiguous");
+                }
+            }
+            return Map.copyOf(result);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid persona geometry", invalid);
+        }
+    }
+
+    // Native exports write absent optional transforms as null. Bedrock geometry omits them.
+    private static void omitNullFields(final JsonElement element) {
+        if (element.isJsonObject()) {
+            final var entries = element.getAsJsonObject().entrySet().iterator();
+            while (entries.hasNext()) {
+                final var entry = entries.next();
+                if (entry.getValue().isJsonNull()) entries.remove();
+                else omitNullFields(entry.getValue());
+            }
+        } else if (element.isJsonArray()) {
+            element.getAsJsonArray().forEach(BedrockPersonaSources::omitNullFields);
+        }
+    }
+
+    static List<Texture> read(
+            final BedrockMarketplaceAssets.Pack pack, final Predicate<JsonObject> include)
+            throws IOException {
+        final List<Texture> result = new ArrayList<>();
+        try {
+            for (final JsonObject metadata : metadata(pack)) {
+                for (final String group : List.of("texture_sources", "geometry_sources")) {
+                    if (!metadata.has(group)) continue;
+                    for (final var element : metadata.getAsJsonArray(group)) {
+                        final JsonObject source = element.getAsJsonObject();
+                        if (!source.has("texture") || !include.test(source)) continue;
+                        final String path = source.get("texture").getAsString();
+                        BedrockBuiltinAssets.validPath(path);
+                        final BufferedImage image =
+                                BedrockPersonaAnimations.image(pack.files().get(path));
+                        BufferedImage tint = null;
+                        if (source.has("tint_map")) {
+                            final String mask = source.get("tint_map").getAsString();
+                            BedrockBuiltinAssets.validPath(mask);
+                            tint = tga(pack.files().get(mask));
+                            if (tint.getWidth() != image.getWidth()
+                                    || tint.getHeight() != image.getHeight())
+                                throw new IOException(
+                                        "The persona tint mask has different dimensions");
+                        }
+                        final boolean animated =
+                                source.has("animated") && source.get("animated").getAsBoolean();
+                        final int frames = animated ? source.get("frames").getAsInt() : 1;
+                        if (frames < 1 || frames > 256 || image.getHeight() % frames != 0)
+                            throw new IOException("Invalid persona source frame count");
+                        result.add(
+                                new Texture(
+                                        source.deepCopy(),
+                                        metadata.deepCopy(),
+                                        image,
+                                        tint,
+                                        frames));
+                    }
+                }
+            }
+            return List.copyOf(result);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid persona texture source", invalid);
+        }
+    }
+
+    static BufferedImage tga(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length < 18 || bytes.length > 8 * 1024 * 1024)
+            throw new IOException("The persona tint mask is missing or too large");
+        final ByteBuffer input = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN);
+        final int id = Byte.toUnsignedInt(input.get(0));
+        final int width = Short.toUnsignedInt(input.getShort(12)),
+                height = Short.toUnsignedInt(input.getShort(14));
+        final int depth = Byte.toUnsignedInt(input.get(16)),
+                descriptor = Byte.toUnsignedInt(input.get(17));
+        final long pixels = (long) width * height;
+        final int type = Byte.toUnsignedInt(input.get(2));
+        if (input.get(1) != 0
+                || (type != 2 && type != 10)
+                || (depth != 24 && depth != 32)
+                || width < 1
+                || height < 1
+                || pixels > 4 * 1024 * 1024
+                || (descriptor & 0xC0) != 0
+                || 18L + id > bytes.length)
+            throw new IOException("Unsupported or truncated persona texture map");
+        input.position(18 + id);
+        final BufferedImage image = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+        try {
+            int written = 0;
+            while (written < pixels) {
+                final int packet = type == 10 ? Byte.toUnsignedInt(input.get()) : 0;
+                final int count = type == 10 ? (packet & 127) + 1 : (int) pixels - written;
+                if (count > pixels - written)
+                    throw new IOException("A persona texture map has an oversized run");
+                final boolean repeated = type == 10 && (packet & 128) != 0;
+                final int shared = repeated ? tgaPixel(input, depth) : 0;
+                for (int index = 0; index < count; index++) {
+                    final int value = repeated ? shared : tgaPixel(input, depth);
+                    final int column = written % width, row = written / width;
+                    final int x = (descriptor & 0x10) != 0 ? width - column - 1 : column;
+                    final int y = (descriptor & 0x20) != 0 ? row : height - row - 1;
+                    image.setRGB(x, y, value);
+                    written++;
+                }
+            }
+        } catch (java.nio.BufferUnderflowException truncated) {
+            throw new IOException("A persona texture map is truncated", truncated);
+        }
+        return image;
+    }
+
+    private static int tgaPixel(final ByteBuffer input, final int depth) {
+        final int blue = Byte.toUnsignedInt(input.get()),
+                green = Byte.toUnsignedInt(input.get()),
+                red = Byte.toUnsignedInt(input.get());
+        final int alpha = depth == 32 ? Byte.toUnsignedInt(input.get()) : 255;
+        return alpha << 24 | red << 16 | green << 8 | blue;
+    }
+
+    record Texture(
+            JsonObject source,
+            JsonObject metadata,
+            BufferedImage image,
+            BufferedImage tintMap,
+            int frames) {
+        boolean face() {
+            return source.has("use_face_uv") && source.get("use_face_uv").getAsBoolean();
+        }
+    }
+}
