@@ -0,0 +1,164 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.protocol.BedrockProtocol;
+
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.random.RandomGenerator;
+import java.util.regex.Pattern;
+
+/** Particle events pass no block or entity selector, so they use individual level sounds. */
+final class BedrockLevelSounds {
+    private BedrockLevelSounds() {}
+
+    static String name(final String value) {
+        final StringBuilder lower = new StringBuilder(value.length());
+        for (int index = 0; index < value.length(); index++) {
+            final char c = value.charAt(index);
+            lower.append(c >= 'A' && c <= 'Z' ? (char) (c + ('a' - 'A')) : c);
+        }
+        final String name = lower.toString();
+        return Names.VALUES.contains(name) ? name : null;
+    }
+
+    static Map<String, Configured> read(final JsonObject document) throws IOException {
+        final Map<String, Configured> result = new LinkedHashMap<>();
+        if (!document.has("individual_event_sounds")) return result;
+        try {
+            final JsonObject individual = document.getAsJsonObject("individual_event_sounds");
+            if (!individual.has("events")) return result;
+            final Range volume = Range.read(individual.get("volume"), Range.UNSET);
+            final Range pitch = Range.read(individual.get("pitch"), Range.UNSET);
+            final JsonObject events = individual.getAsJsonObject("events");
+            if (events.size() > 4096) throw new IOException("Too many individual level sounds");
+            for (final var entry : events.entrySet()) {
+                final String name = name(entry.getKey());
+                if (name == null) continue;
+                final JsonElement value = entry.getValue();
+                final String sound;
+                final Range eventVolume, eventPitch;
+                if (value.isJsonObject()) {
+                    final JsonObject object = value.getAsJsonObject();
+                    sound = string(object.get("sound"));
+                    eventVolume = Range.read(object.get("volume"), volume);
+                    eventPitch = Range.read(object.get("pitch"), pitch);
+                } else {
+                    sound = string(value);
+                    eventVolume = volume;
+                    eventPitch = pitch;
+                }
+                if (sound.length() > 512 || sound.indexOf('\0') >= 0)
+                    throw new IOException("Invalid configured level sound");
+                result.put(name, new Configured(sound, eventVolume, eventPitch));
+            }
+            return result;
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid individual level sound definitions", invalid);
+        }
+    }
+
+    private static String string(final JsonElement value) throws IOException {
+        if (value == null || value.isJsonNull()) return "";
+        if (!value.isJsonPrimitive()) throw new IOException("Invalid configured level sound name");
+        return value.getAsString();
+    }
+
+    static float volume(final float value) { return Math.clamp(value, 0, 1); }
+
+    record Configured(String sound, Range volume, Range pitch) {}
+
+    record Range(float minimum, float maximum) {
+        static final Range UNSET = new Range(-1, -1);
+        private static final Pattern NUMBER = Pattern.compile("^[ \t\r\n]*([+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)");
+
+        static Range read(final JsonElement value, final Range inherited) throws IOException {
+            if (value == null || value.isJsonNull()) return inherited;
+            if (value.isJsonObject()) {
+                final var object = value.getAsJsonObject();
+                final float minimum = number(object.get("min"), inherited.minimum);
+                return new Range(minimum, Math.max(minimum, number(object.get("max"), inherited.maximum)));
+            }
+            if (value.isJsonArray()) {
+                final var array = value.getAsJsonArray();
+                if (array.isEmpty()) return inherited;
+                final float first = number(array.get(0), 0);
+                final float second = array.size() < 2 ? first : number(array.get(1), 0);
+                return new Range(Math.min(first, second), Math.max(first, second));
+            }
+            if (value.isJsonPrimitive() && (value.getAsJsonPrimitive().isNumber() || value.getAsJsonPrimitive().isBoolean())) {
+                final float constant = number(value, 0);
+                return new Range(constant, constant);
+            }
+            if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                final String text = value.getAsString();
+                if (text.length() > 256) throw new IOException("Level sound range exceeds its limit");
+                final int start = text.indexOf('['), end = text.indexOf(']', start + 1);
+                if (start < 0) {
+                    final float constant = parsed(text);
+                    return new Range(constant, constant);
+                }
+                if (end < 0) return inherited;
+                final String[] pair = text.substring(start + 1, end).split(",", -1);
+                final float first = parsed(pair[0]);
+                final float second = pair.length < 2 ? first : parsed(pair[1]);
+                return new Range(Math.min(first, second), Math.max(first, second));
+            }
+            return inherited;
+        }
+
+        float sample(final RandomGenerator random) {
+            if (this.minimum >= this.maximum) return this.maximum;
+            final float first = (float) (Integer.toUnsignedLong(random.nextInt()) * 0x1.0p-32);
+            final float second = (float) (Integer.toUnsignedLong(random.nextInt()) * 0x1.0p-32);
+            return (this.maximum + this.minimum) * .5F
+                    + (this.maximum - this.minimum) * (first - second) * .5F;
+        }
+
+        private static float parsed(final String value) throws IOException {
+            final var match = NUMBER.matcher(value);
+            if (!match.find()) throw new IOException("Invalid level sound range string");
+            try { return bounded(Float.parseFloat(match.group(1))); }
+            catch (NumberFormatException invalid) { throw new IOException("Invalid level sound range string", invalid); }
+        }
+
+        private static float number(final JsonElement value, final float fallback) throws IOException {
+            if (value == null || value.isJsonNull()) return fallback;
+            if (!value.isJsonPrimitive()) return 0;
+            if (value.getAsJsonPrimitive().isBoolean()) return value.getAsBoolean() ? 1 : 0;
+            if (!value.getAsJsonPrimitive().isNumber()) return 0;
+            return bounded(value.getAsFloat());
+        }
+
+        private static float bounded(final float number) throws IOException {
+            if (!Float.isFinite(number) || Math.abs(number) > 1_000_000)
+                throw new IOException("Level sound parameter exceeds its limit");
+            return number;
+        }
+    }
+
+    private static final class Names {
+        // Include null mappings too: a server pack can configure a native event without a Java mapping.
+        private static final Set<String> VALUES = read();
+
+        private static Set<String> read() {
+            try (var input = BedrockProtocol.class.getResourceAsStream("/assets/viabedrock/data/bedrock/level_sound_event_mappings.json")) {
+                if (input == null) throw new IOException("Missing target level sound names");
+                return Set.copyOf(JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8)).getAsJsonObject().keySet());
+            } catch (IOException | RuntimeException invalid) {
+                throw new ExceptionInInitializerError(invalid);
+            }
+        }
+    }
+}
