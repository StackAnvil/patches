@@ -0,0 +1,122 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonParser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+
+final class BedrockSoundBankTest {
+    @Test
+    void preservesPcmSamplesAndInclusiveLoopMetadata() throws Exception {
+        final byte[] pcm = new byte[12];
+        final ByteBuffer output = ByteBuffer.wrap(pcm).order(ByteOrder.LITTLE_ENDIAN);
+        for (int i = 0; i < 6; i++) output.putShort((short) (i * 1000 - 2000));
+        final ByteBuffer metadata = ByteBuffer.allocate(12).order(ByteOrder.LITTLE_ENDIAN);
+        metadata.putInt((3 << 25) | (8 << 1)).putInt(1).putInt(2);
+        final var audio = BedrockSoundBank.read(bank(2, 2, 3, metadata.array(), pcm));
+        assertArrayEquals(pcm, audio.pcm());
+        assertEquals(48000, audio.sampleRate());
+        assertEquals(2, audio.channels());
+        assertEquals(1, audio.loopStart());
+        assertEquals(3, audio.loopEnd());
+    }
+
+    @Test
+    void interleavesChannelsAndTrimsTheLastFadpcmFrame() throws Exception {
+        final ByteBuffer encoded = ByteBuffer.allocate(560).order(ByteOrder.LITTLE_ENDIAN);
+        for (final int value : new int[] {1, 14, 3, 12}) {
+            encoded.putInt(0).putInt(0).putShort((short) 0).putShort((short) 0);
+            for (int word = 0; word < 32; word++) encoded.putInt(value * 0x11111111);
+        }
+        final var audio = BedrockSoundBank.read(bank(16, 2, 257, new byte[0], encoded.array()));
+        final ByteBuffer pcm = ByteBuffer.wrap(audio.pcm()).order(ByteOrder.LITTLE_ENDIAN);
+        assertEquals(257 * 4, pcm.remaining());
+        for (int sample = 0; sample < 256; sample++) {
+            assertEquals(1, pcm.getShort());
+            assertEquals(-2, pcm.getShort());
+        }
+        assertEquals(3, pcm.getShort());
+        assertEquals(-4, pcm.getShort());
+    }
+
+    @Test
+    void appliesPredictionClippingAndCustomSampleRates() throws Exception {
+        final ByteBuffer encoded = ByteBuffer.allocate(140).order(ByteOrder.LITTLE_ENDIAN);
+        encoded.putInt(0x11111111).putInt(0).putShort((short) 1000).putShort((short) 0);
+        final ByteBuffer metadata = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN);
+        metadata.putInt((2 << 25) | (4 << 1)).putInt(32000);
+        final var audio = BedrockSoundBank.read(bank(16, 1, 256, metadata.array(), encoded.array()));
+        assertEquals(32000, audio.sampleRate());
+        assertEquals(937, ByteBuffer.wrap(audio.pcm()).order(ByteOrder.LITTLE_ENDIAN).getShort());
+        encoded.putInt(0, 0).putInt(4, -1).putInt(12, 0x77777777);
+        final var clipped = BedrockSoundBank.read(bank(16, 1, 8, new byte[0], encoded.array()));
+        for (int i = 0; i < 8; i++)
+            assertEquals(Short.MAX_VALUE, ByteBuffer.wrap(clipped.pcm()).order(ByteOrder.LITTLE_ENDIAN).getShort(i * 2));
+    }
+
+    @Test
+    void rejectsTruncationInvalidMetadataAndOversizedOutput() {
+        final byte[] bank = bank(16, 1, 256, new byte[0], new byte[140]);
+        for (final int length : new int[] {0, 67, 100, bank.length - 1})
+            assertThrows(IOException.class, () -> BedrockSoundBank.read(Arrays.copyOf(bank, length)));
+        for (final int offset : new int[] {8, 12, 16, 20, 24, 32}) {
+            final byte[] invalid = bank.clone();
+            ByteBuffer.wrap(invalid).order(ByteOrder.LITTLE_ENDIAN).putInt(offset, -1);
+            assertThrows(IOException.class, () -> BedrockSoundBank.read(invalid));
+        }
+        final byte[] excessive = bank.clone();
+        ByteBuffer.wrap(excessive).order(ByteOrder.LITTLE_ENDIAN).putLong(60, 0xFFFFFFFC00000012L);
+        assertThrows(IOException.class, () -> BedrockSoundBank.read(excessive));
+        final byte[] missingFrame = bank.clone();
+        ByteBuffer.wrap(missingFrame).order(ByteOrder.LITTLE_ENDIAN).putLong(60, (513L << 34) | 18);
+        assertThrows(IOException.class, () -> BedrockSoundBank.read(missingFrame));
+        final byte[] chunk = ByteBuffer.allocate(4).order(ByteOrder.LITTLE_ENDIAN)
+                .putInt((2 << 25) | (4 << 1)).array();
+        assertThrows(IOException.class, () -> BedrockSoundBank.read(bank(16, 1, 256, chunk, new byte[140])));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_SOUND_REFERENCE", matches = ".+")
+    void matchesIndependentDecoderOutputForLicensedAndGeneratedBanks() throws Exception {
+        final Path manifest = Path.of(System.getenv("STACKANVIL_SOUND_REFERENCE"));
+        final var reference = JsonParser.parseString(Files.readString(manifest)).getAsJsonObject();
+        final Path root = Path.of(reference.get("root").getAsString());
+        final var library = BedrockBuiltinAssets.index("1.26.51.1",
+                NativeAssetFixture.read(root.resolve("package-assets")));
+        for (final var entry : reference.getAsJsonObject("files").entrySet()) {
+            final var expected = entry.getValue().getAsJsonObject();
+            final String prefix = "package-assets/library/vanilla/";
+            final var audio = entry.getKey().startsWith(prefix)
+                    ? library.sound(entry.getKey().substring(prefix.length()))
+                    : BedrockSoundBank.read(Files.readAllBytes(root.resolve(entry.getKey())));
+            assertEquals(expected.get("hash").getAsString(), BedrockBuiltinAssets.hash(audio.pcm()), entry.getKey());
+            assertEquals(expected.get("rate").getAsInt(), audio.sampleRate(), entry.getKey());
+            assertEquals(expected.get("channels").getAsInt(), audio.channels(), entry.getKey());
+            assertEquals(expected.get("samples").getAsInt(), audio.samples(), entry.getKey());
+            assertEquals(expected.get("loopStart").getAsInt(), audio.loopStart(), entry.getKey());
+            assertEquals(expected.get("loopEnd").getAsInt(), audio.loopEnd(), entry.getKey());
+        }
+    }
+
+    private static byte[] bank(
+            final int codec, final int channels, final int samples, final byte[] metadata,
+            final byte[] encoded) {
+        final ByteBuffer bank = ByteBuffer.allocate(68 + metadata.length + encoded.length)
+                .order(ByteOrder.LITTLE_ENDIAN);
+        bank.putInt(0x35425346).putInt(1).putInt(1).putInt(8 + metadata.length)
+                .putInt(0).putInt(encoded.length).putInt(codec);
+        bank.position(60);
+        bank.putLong(((long) samples << 34) | ((long) (channels - 1) << 5) | (9 << 1)
+                | (metadata.length == 0 ? 0 : 1));
+        bank.put(metadata).put(encoded);
+        return bank.array();
+    }
+}
