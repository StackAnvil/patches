+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+
+import java.io.IOException;
+import java.nio.BufferUnderflowException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Reads text and compiled particle definitions without a native game or external decoder. */
+final class BedrockParticleDefinition {
+    private static final int MAGIC = 0x42434D7F;
+    private static final int MAX_BYTES = 8 * 1024 * 1024;
+    private static final int MAX_ITEMS = 65536;
+    private static final int MAX_DEPTH = 96;
+
+    interface Layout {
+        JsonElement read(Reader reader) throws IOException;
+    }
+
+    static final Layout TEXT = reader -> new JsonPrimitive(reader.text());
+    static final Layout BOOL = reader -> new JsonPrimitive(reader.bool());
+    static final Layout INT = reader -> new JsonPrimitive(reader.data.getInt());
+    static final Layout SHORT = reader -> new JsonPrimitive(reader.data.getShort());
+    static final Layout FLOAT =
+            reader -> {
+                final float value = reader.data.getFloat();
+                if (!Float.isFinite(value)) throw new IOException("Non-finite particle value");
+                return new JsonPrimitive(value);
+            };
+    private static final Map<String, Layout> LAYOUTS = BedrockParticleLayouts.definitions();
+
+    private BedrockParticleDefinition() {}
+
+    static JsonObject read(final byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length == 0 || bytes.length > MAX_BYTES)
+            throw new IOException("Missing or oversized particle definition");
+        try {
+            if (bytes.length < 4
+                    || ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).getInt() != MAGIC) {
+                final String text =
