@@ -0,0 +1,94 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viafabricplus.bedrock.ViaFabricPlusBedrock;
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import io.netty.buffer.Unpooled;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.protocol.game.ClientboundLevelParticlesPacket;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.NativeParticlePlaybackMessage;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.io.IOException;
+import java.util.Map;
+import java.util.function.Supplier;
+
+/** Server effects use accepted native resources, with their complete Java translation as a fallback. */
+public final class BedrockServerParticles {
+    private BedrockServerParticles() {}
+
+    public static void accept(final NativeParticlePlaybackMessage message) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (!minecraft.isSameThread()) { minecraft.execute(() -> accept(message)); return; }
+        final ClientLevel level = minecraft.level;
+        if (level == null) return;
+        final Supplier<BedrockParticleAttachment> attachment;
+        final Vec3 origin;
+        if (message.actor() == null) {
+            origin = position(message.origin());
+            attachment = null;
+        } else {
+            final Entity actor = level.getEntity(message.actor().javaId());
+            if (actor == null || !actor.getUUID().equals(message.actor().javaUuid()) || actor.isRemoved()) return;
+            final Vec3 offset = position(message.effect().position());
+            final var owner = BedrockActorState.lifetime(actor.getUUID());
+            origin = Vec3.ZERO;
+            attachment = () -> {
+                if (minecraft.level != level || actor.isRemoved() || level.getEntity(actor.getId()) != actor) return null;
+                final var current = BedrockActorState.state(actor.getUUID());
+                if (owner != null && (current == null || !owner.equals(current.lifetime()))) return null;
+                final float partialTick = minecraft.getDeltaTracker().getGameTimeDeltaPartialTick(false);
+                return new BedrockParticleAttachment(actor.getPosition(partialTick), actor.getYRot(partialTick), null,
+                        actor.getInterpolatedBoundingBox(partialTick), BedrockActorQueries.sample(actor, current, Map.of())).withOffset(offset);
+            };
+        }
+        try {
+            final var environment = new BedrockMolang();
+            environment.variables(message.variables());
+            BedrockParticlePlayback.play(BedrockServerResources.library(), message.effect().identifier(), environment,
+                    null, origin, attachment).whenComplete((started, error) -> minecraft.execute(() -> {
+                if (minecraft.level == level && (error != null || !Boolean.TRUE.equals(started))) fallback(message, level);
+            }));
+        } catch (IOException | RuntimeException invalid) {
+            ViaFabricPlusBedrock.impl().logger().debug("Could not prepare server particle {}", message.effect().identifier(), invalid);
+            fallback(message, level);
+        }
+    }
+
+    private static Vec3 position(final Position3f position) {
+        return new Vec3(position.x(), position.y(), position.z());
+    }
+
+    private static void fallback(final NativeParticlePlaybackMessage message, final ClientLevel level) {
+        final byte[] body = message.fallback();
+        final Minecraft minecraft = Minecraft.getInstance();
+        if (body.length == 0 || minecraft.level != level || minecraft.getConnection() == null) return;
+        if (message.actor() != null) {
+            final var actor = level.getEntity(message.actor().javaId());
+            if (actor == null || actor.isRemoved() || !actor.getUUID().equals(message.actor().javaUuid())) return;
+        }
+        try {
+            minecraft.getConnection().handleParticleEvent(decodeFallback(body, level.registryAccess()));
+        } catch (RuntimeException invalid) {
+            ViaFabricPlusBedrock.impl().logger().warn("Could not decode Java particle fallback {}", message.effect().identifier(), invalid);
+        }
+    }
+
+    static ClientboundLevelParticlesPacket decodeFallback(final byte[] body, final RegistryAccess registries) {
+        final var buffer = new RegistryFriendlyByteBuf(Unpooled.wrappedBuffer(body), registries);
+        try {
+            final var packet = ClientboundLevelParticlesPacket.STREAM_CODEC.decode(buffer);
+            if (buffer.isReadable()) throw new IllegalArgumentException("Trailing Java particle fallback data");
+            return packet;
+        } finally { buffer.release(); }
+    }
+}
