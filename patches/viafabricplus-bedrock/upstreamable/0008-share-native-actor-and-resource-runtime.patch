+    static BedrockResourceLibrary read(final Map<String, byte[]> files) throws IOException {
+        try {
+            final Map<String, Map<String, byte[]>> grouped = new LinkedHashMap<>();
+            for (final var entry : files.entrySet()) {
+                if (!entry.getKey().startsWith("library/")) continue;
+                BedrockBuiltinAssets.validPath(entry.getKey());
+                final String path = entry.getKey().substring("library/".length());
+                final int separator = path.indexOf('/');
+                if (separator < 0 || !packName(path.substring(0, separator)))
+                    throw new IOException("Invalid vanilla resource pack");
+                grouped.computeIfAbsent(path.substring(0, separator), name -> new LinkedHashMap<>())
+                        .put(path.substring(separator + 1), entry.getValue());
+            }
+            final List<Pack> packs = new ArrayList<>();
+            for (final String name : grouped.keySet().stream().sorted(PACK_ORDER).toList()) {
+                if (!packs.isEmpty() && PACK_ORDER.compare(packs.getLast().name, name) == 0)
+                    throw new IOException("Ambiguous vanilla overlay version");
+                packs.add(new Pack(name, java.util.Collections.unmodifiableMap(grouped.get(name))));
+            }
+            return new BedrockResourceLibrary(packs);
+        } catch (RuntimeException invalid) {
+            throw new IOException("Invalid vanilla resource library", invalid);
+        }
+    }
+
+    static BedrockResourceLibrary withServerPacks(final BedrockResourceLibrary builtin, final List<Map<String, byte[]>> serverPacks) throws IOException {
+        final List<Pack> packs = new ArrayList<>();
+        if (builtin != null) packs.addAll(builtin.packs);
+        for (int index = 0; index < serverPacks.size(); index++) packs.add(new Pack(Integer.toString(index), serverPacks.get(index)));
