+
+    @Test
+    void registersAsciiFoldedAnimationNamesButKeepsReferenceSpelling() throws Exception {
+        final String canonical = "animation.native.ÉİΣ😀upper";
+        final String uppercase = "ANIMATION.Native.ÉİΣ😀UPPER";
+        final JsonObject first = JsonParser.parseString("""
+                {"format_version":"1.8.0","animations":{
+                  "ANIMATION.Native.ÉİΣ😀UPPER":{"loop":true,"bones":{
+                    "head":{"position":[1,0,0]},"body":{"position":[0,3,0]}}},
+                  "animation.retained":{"loop":true,"bones":{"arm":{"position":[0,0,2]}}}}}
+                """).getAsJsonObject();
+        final JsonObject second = JsonParser.parseString("""
+                {"format_version":"1.10.0","animations":{
+                  "AnImAtIoN.nAtIvE.ÉİΣ😀UpPeR":{"loop":true,"bones":{"head":{"position":[4,0,0]}}}}}
+                """).getAsJsonObject();
+        final JsonObject rawAnimations = first.getAsJsonObject("animations").deepCopy();
+        second.getAsJsonObject("animations").entrySet().forEach(entry -> rawAnimations.add(entry.getKey(), entry.getValue()));
+        for (final String reference : List.of(canonical, uppercase)) {
+            final JsonObject entity = JsonParser.parseString("""
+                    {"animations":{"pose":"","retained":"animation.retained"},
+                      "scripts":{"animate":["pose","retained"]}}
+                    """).getAsJsonObject();
+            entity.getAsJsonObject("animations").addProperty("pose", reference);
+            final JsonObject description = new JsonObject(), document = new JsonObject();
+            description.add("description", entity);
+            entity.addProperty("identifier", "minecraft:player");
+            document.add("minecraft:client_entity", description);
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            put(files, "vanilla", "entity/player.json", document.toString());
+            put(files, "vanilla", "animations/first.json", first.toString());
+            put(files, "vanilla", "animations/second.json", second.toString());
+            final Map<String, byte[]> accepted = new LinkedHashMap<>();
+            files.forEach((path, bytes) -> accepted.put(path.substring("library/vanilla/".length()), bytes));
+            final List<BedrockActorAnimation> actors = List.of(
+                    BedrockActorAnimation.read(BedrockResourceLibrary.read(files), BedrockClassicOptions.EMPTY),
