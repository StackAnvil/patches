+        final var emitter = BedrockParticleEffect.read(BedrockParticleEffectTest.burst())
+                .emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var result = children.acquire("automatic", registered::contains, () -> {
+            registered.add(emitter); return emitter;
+        });
+        assertTrue(result.created());
+        assertFalse(emitter.emit(new Vector3f(), new Vector3f(), 10));
+        emitter.advance(0, 10, null, (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        assertSame(emitter, children.acquire("automatic", registered::contains, () -> fail()).child());
+        children.retire(registered::contains, BedrockParticleEffect.Emitter::expire);
+        assertEquals(2, emitter.size());
+    }
+
+    @Test
+    void expiresOwnedChildrenOnRetirementAndLetsTheirParticlesDrainBeforeExpiringGrandchildren() throws Exception {
+        final var parentDocument = BedrockParticleEffectTest.burst();
+        final var components = parentDocument.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.getAsJsonObject("minecraft:emitter_rate_instant").addProperty("num_particles", 0);
+        components.getAsJsonObject("minecraft:emitter_lifetime_once").addProperty("active_time", 0);
+        final var parent = BedrockParticleEffect.read(parentDocument).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        final var child = new Child(4, new ArrayList<>());
+        final var grandchild = new Child(4, new ArrayList<>());
+        final var registered = new ArrayList<>(List.of(parent, child.emitter, grandchild.emitter));
+        final var effects = new IdentityHashMap<BedrockParticleEffect.Emitter, String>();
+        effects.put(parent, "parent"); effects.put(child.emitter, "child"); effects.put(grandchild.emitter, "grandchild");
+        final var ownership = new IdentityHashMap<BedrockParticleEffect.Emitter, BedrockParticleChildren<String, BedrockParticleEffect.Emitter>>();
+        registered.forEach(emitter -> ownership.put(emitter, new BedrockParticleChildren<>(BedrockParticleChildrenTest::hash)));
+        ownership.get(parent).acquire("child", registered::contains, () -> child.emitter);
+        ownership.get(child.emitter).acquire("grandchild", registered::contains, () -> grandchild.emitter);
+        final var counts = new BedrockParticleCounts();
+        effects.values().forEach(counts::created);
+        final var parentCounts = new BedrockMolang(); parentCounts.queries(counts.queries("parent"));
+        child.environment.addQueries(Map.of("expiry", (BedrockActorAnimation.Query) _ -> {
+            assertFalse(registered.contains(parent));
+            assertEquals(0, value(parentCounts, "q.effect_emitter_count"));
+            return 0F;
+        }));
+        assertTrue(child.emitter.emit(new Vector3f(), new Vector3f(), 10));
+        parent.advance(0, 0, null, (x, y, z) -> List.of());
+        final var updated = new ArrayList<BedrockParticleEffect.Emitter>();
+        final Runnable frame = () -> BedrockParticleFrames.advance(registered, counts, effects::get,
+                BedrockParticleEffect.Emitter::alive,
+                emitter -> ownership.get(emitter).retire(registered::contains, BedrockParticleEffect.Emitter::expire),
+                emitter -> { updated.add(emitter); emitter.advance(0, 10, null, (x, y, z) -> List.of()); },
+                BedrockParticleEffect.Emitter::size);
+        frame.run();
+        assertEquals(List.of(grandchild.emitter, child.emitter), registered);
+        assertEquals(registered, updated);
+        assertEquals(1, child.emitter.size());
+        assertFalse(child.emitter.emit(new Vector3f(), new Vector3f(), 10));
+        assertTrue(grandchild.emitter.alive());
+        child.emitter.advance(200_000_000, 10, null, (x, y, z) -> List.of());
+        child.emitter.advance(200_000_000, 10, null, (x, y, z) -> List.of());
+        assertFalse(child.emitter.alive());
+        updated.clear(); frame.run();
+        assertEquals(List.of(grandchild.emitter), registered);
+        assertFalse(grandchild.emitter.alive());
+        updated.clear(); frame.run();
+        assertTrue(registered.isEmpty());
+        assertTrue(updated.isEmpty());
+        assertEquals(0, value(parentCounts, "q.total_emitter_count"));
+    }
+
+    @Test
+    void runsExpiryOnceBeforeClosingManualEmissionAndPreservesExistingParticles() throws Exception {
+        final var trace = new ArrayList<String>();
+        final var child = new Child(4, trace);
+        child.environment.addQueries(Map.of("expiry", (BedrockActorAnimation.Query) _ -> {
+            trace.add("expiry");
+            assertTrue(child.emitter.emit(new Vector3f(7, 8, 9), new Vector3f(), 10));
+            return 0F;
+        }));
+        child.emitter.expire(); child.emitter.expire();
+        assertEquals(List.of("expiry", "birth"), trace);
+        assertEquals(1, child.emitter.size());
+        assertTrue(child.emitter.alive());
+        assertFalse(child.emitter.emit(new Vector3f(), new Vector3f(), 10));
+        child.emitter.advance(50_000_000, 10, null, (x, y, z) -> List.of());
+        assertEquals(1, child.emitter.size());
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PARTICLE_CHILD_LIFETIMES", matches = ".+")
+    void matchesNativeCachedHandleAdmissionAcrossRepeatedManualRequests() throws Exception {
+        int cases = 0;
+        for (final var entry : fixture().getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            if (!row.get("mode").getAsString().equals("dispatch")) continue;
+            cases++;
+            final var trace = new ArrayList<String>();
+            final var child = new Child(row.get("capacity").getAsInt(), trace);
+            final String scenario = row.get("scenario").getAsString();
+            if (scenario.equals("expired")) { child.emitter.expire(); trace.clear(); }
+            final var registered = new ArrayList<Child>();
+            final var children = new BedrockParticleChildren<String, Child>(BedrockParticleChildrenTest::hash);
+            if (!scenario.startsWith("new")) children.acquire("effect", _ -> true, () -> child);
+            if (List.of("live", "expired").contains(scenario)) registered.add(child);
+            for (int step = 0; step < 2; step++) {
+                trace.clear();
+                final var result = children.acquire("effect", registered::contains, () -> {
+                    trace.add("factory");
+                    if (scenario.equals("new-failed")) return null;
+                    registered.add(child); return child;
+                });
+                if (result.child() != null) {
+                    child.emitter.initialize(program("q.initialize();"));
+                    child.emitter.emit(new Vector3f(7, 8, 9), row.get("kind").getAsInt() == 2 ? new Vector3f(2, 3, 4) : new Vector3f(), 100);
+                }
+                trace.add("source");
+                final var expected = row.getAsJsonArray("trace").get(step).getAsJsonArray().asList().stream()
+                        .map(value -> value.getAsString()).filter(value -> !value.equals("context")).toList();
+                assertEquals(expected, trace, row.toString());
+            }
+        }
+        assertEquals(32, cases);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PARTICLE_CHILD_LIFETIMES", matches = ".+")
+    void matchesNativeOwnerRetirementAndStaleHandleGates() throws Exception {
+        int cases = 0;
+        for (final var entry : fixture().getAsJsonArray("rows")) {
+            final var row = entry.getAsJsonObject();
+            if (!row.get("mode").getAsString().equals("retire")) continue;
+            cases++;
+            final var trace = new ArrayList<String>();
+            final int capacity = row.get("capacity").getAsInt();
+            final var child = new Child(capacity, trace);
+            final String scenario = row.get("scenario").getAsString();
+            if (scenario.equals("expired")) child.emitter.expire();
+            child.environment.addQueries(Map.of("expiry", (BedrockActorAnimation.Query) _ -> {
+                trace.add("expiry"); child.emitter.emit(new Vector3f(7, 8, 9), new Vector3f(2, 3, 4), 100); return 0F;
+            }));
+            final var children = new BedrockParticleChildren<String, Child>(BedrockParticleChildrenTest::hash);
+            children.acquire("effect", _ -> true, () -> child); trace.clear();
+            if (!scenario.equals("shutdown")) children.retire(_ -> scenario.equals("live") || scenario.equals("expired"), value -> value.emitter.expire());
+            final var expected = row.getAsJsonArray("trace").get(0).getAsJsonArray().asList().stream()
+                    .map(value -> value.getAsString()).filter(value -> !value.equals("context") && !value.startsWith("expired_during_callback=")).toList();
+            assertEquals(expected, trace, row.toString());
+            assertEquals(!row.get("expiredAfterRetirement").getAsBoolean() && capacity > 0,
+                    child.emitter.emit(new Vector3f(), new Vector3f(), 100));
+        }
+        assertEquals(14, cases);
+    }
+
+    private static long hash(final String name) { return Fnv1.fnv1_64(name.getBytes(StandardCharsets.UTF_8)); }
+
+    private static JsonObject fixture() throws Exception {
+        return JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_PARTICLE_CHILD_LIFETIMES")))).getAsJsonObject();
+    }
+    private static BedrockMolang.Program program(final String expression) throws java.io.IOException {
+        return BedrockMolang.Program.parse(new JsonPrimitive(expression), 0);
+    }
+    private static float value(final BedrockMolang environment, final String expression) {
+        try { return environment.evaluate(program(expression), 0); }
+        catch (java.io.IOException invalid) { throw new AssertionError(invalid); }
+    }
+    private static final class Child {
+        private final BedrockMolang environment = new BedrockMolang();
+        private final BedrockParticleEffect.Emitter emitter;
+        private Child(final int capacity, final List<String> trace) throws Exception {
+            final var document = BedrockParticleEventsTest.manual();
+            final var effect = document.getAsJsonObject("particle_effect");
+            final var components = effect.getAsJsonObject("components");
+            components.getAsJsonObject("minecraft:emitter_rate_manual").addProperty("max_particles", capacity);
+            components.add("minecraft:particle_lifetime_expression", JsonParser.parseString("{\"max_lifetime\":0.1}"));
+            components.add("minecraft:particle_lifetime_events", JsonParser.parseString("{\"creation_event\":\"birth\"}"));
+            components.add("minecraft:emitter_lifetime_events", JsonParser.parseString("{\"expiration_event\":\"expiry\"}"));
+            effect.add("events", JsonParser.parseString("{\"birth\":{\"expression\":\"q.birth();\"},\"expiry\":{\"expression\":\"q.expiry();\"}}"));
+            this.emitter = BedrockParticleEffect.read(document).emitter(this.environment, new Random(1), Vec3.ZERO);
+            this.environment.addQueries(Map.of("initialize", (BedrockActorAnimation.Query) _ -> { trace.add("initialize"); return 0F; },
+                    "birth", (BedrockActorAnimation.Query) _ -> { trace.add("birth"); return 0F; }));
+        }
+    }
+}
