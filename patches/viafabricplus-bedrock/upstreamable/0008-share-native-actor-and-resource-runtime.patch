+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.BooleanSupplier;
+
+/** Counts unfinished starts, releasing each slot before downstream callbacks run. */
+final class BedrockParticlePending {
+    private final AtomicInteger count = new AtomicInteger();
+    private final int limit;
+
+    BedrockParticlePending(final int limit) {
+        this.limit = limit;
+    }
+
+    boolean acquire() {
+        if (this.count.incrementAndGet() <= this.limit) return true;
+        this.release();
+        return false;
+    }
+
+    void release() {
+        this.count.decrementAndGet();
+    }
+
+    void complete(final CompletableFuture<Boolean> started, final BooleanSupplier operation) {
+        boolean success = false;
+        RuntimeException failure = null;
+        try {
+            success = operation.getAsBoolean();
+        } catch (RuntimeException invalid) {
+            failure = invalid;
+        } finally {
+            this.release();
+        }
+        if (failure == null) started.complete(success);
+        else started.completeExceptionally(failure);
+    }
+}
