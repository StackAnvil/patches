+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Live registration counts and particle populations published after a complete manager batch. */
+final class BedrockParticleCounts {
+    private static final BedrockActorAnimation.Query ZERO = _ -> 0F;
+    static final Map<String, Object> UNBOUND = Map.of(
+            "effect_emitter_count", ZERO, "effect_particle_count", ZERO,
+            "total_emitter_count", ZERO, "total_particle_count", ZERO);
+    private final Map<String, Long> emitters = new HashMap<>();
+    private Map<String, Long> particles = Map.of();
+    private long totalEmitters, totalParticles;
+
+    void created(final String effect) {
+        this.emitters.merge(effect, 1L, Long::sum);
+        this.totalEmitters++;
+    }
+
+    void removed(final String effect) {
+        final long remaining = this.emitters.getOrDefault(effect, 0L) - 1;
+        if (remaining < 0) throw new IllegalStateException("Particle emitter was not registered");
+        if (remaining == 0) this.emitters.remove(effect);
+        else this.emitters.put(effect, remaining);
+        this.totalEmitters--;
+    }
+
+    void publish(final Map<String, Long> particles) {
+        this.particles = Map.copyOf(particles);
+        this.totalParticles = 0;
+        for (final long count : this.particles.values()) this.totalParticles += count;
+    }
+
+    Map<String, Object> queries(final String effect) {
+        return Map.of(
+                "effect_emitter_count", (BedrockActorAnimation.Query) _ -> asFloat(this.emitters.getOrDefault(effect, 0L)),
+                "effect_particle_count", (BedrockActorAnimation.Query) _ -> asFloat(this.particles.getOrDefault(effect, 0L)),
+                "total_emitter_count", (BedrockActorAnimation.Query) _ -> asFloat(this.totalEmitters),
+                "total_particle_count", (BedrockActorAnimation.Query) _ -> asFloat(this.totalParticles));
+    }
+
+    void clear() {
+        this.emitters.clear();
+        this.particles = Map.of();
+        this.totalEmitters = this.totalParticles = 0;
+    }
+
+    /** Native callbacks convert an unsigned 64-bit count to float32. */
+    static float asFloat(final long count) {
+        return count >= 0 ? (float) count : (float) ((count >>> 1) | (count & 1)) * 2F;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCurves.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleCurves.java
