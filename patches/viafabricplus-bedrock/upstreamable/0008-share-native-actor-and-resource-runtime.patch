+/** A resource-defined actor graph with shared variables and independent playback clocks. */
+public final class BedrockActorAnimation {
+    // Values contain parsed resources only. They must not retain their weak storage keys.
+    private static final Map<ResourcePackStorage, ServerResources> SERVER_RESOURCES = new WeakHashMap<>();
+
+    private record ServerResources(Map<String, JsonObject> animations,
+                                   Map<String, ControllerResource> controllers,
+                                   BedrockResourceLibrary effects) {
+    }
+
+    private static ServerResources serverResources(final ResourcePackStorage packs) throws IOException {
+        synchronized (SERVER_RESOURCES) {
+            final ServerResources cached = SERVER_RESOURCES.get(packs);
+            if (cached != null) return cached;
+        }
+        final BedrockResourceLibrary builtin = BedrockBuiltinAssets.load().library();
+        final ServerResources inherited = resources(builtin);
+        final Map<String, JsonObject> animations = new LinkedHashMap<>(inherited.animations());
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>(inherited.controllers());
+        // Accepted files keep their established override order, including repeated identifiers in one pack.
+        for (final var pack : packs.getPackStackBottomToTop()) {
+            for (final String folder : List.of("animations/", "animation_controllers/")) {
+                for (final String path : pack.content().getFilesDeep(folder, ".json")) {
+                    final JsonObject document = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject();
+                    final String field = folder.equals("animations/") ? "animations" : "animation_controllers";
+                    final JsonObject definitions = document.getAsJsonObject(field);
+                    if (definitions == null) continue;
+                    final boolean deferred = deferredEntry(document.has("format_version")
+                            ? document.get("format_version").getAsString() : "1.10.0");
+                    for (final var entry : definitions.entrySet()) {
+                        if (field.equals("animations")) animations.put(Ascii.toLowerCase(entry.getKey()), entry.getValue().getAsJsonObject());
+                        else controllers.put(entry.getKey(), new ControllerResource(entry.getValue().getAsJsonObject(), deferred));
+                    }
+                    if (animations.size() > 4096 || controllers.size() > 4096)
+                        throw new IOException("Too many server actor animation resources");
+                }
+            }
+        }
+        final ServerResources resources = new ServerResources(Map.copyOf(animations), Map.copyOf(controllers),
+                BedrockResourceLibrary.serverActors(builtin, packs));
+        synchronized (SERVER_RESOURCES) {
+            final ServerResources existing = SERVER_RESOURCES.putIfAbsent(packs, resources);
+            return existing == null ? resources : existing;
+        }
+    }
+
+    private static ServerResources resources(final BedrockResourceLibrary library) throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>();
+        library.definitions("animations", "animations")
+                .forEach((name, resource) -> animations.put(name, resource.value()));
+        for (final var entry : library.definitions("animation_controllers", "animation_controllers").entrySet()) {
+            final var resource = entry.getValue();
+            controllers.put(entry.getKey(), new ControllerResource(resource.value(), deferredEntry(resource.formatVersion())));
+        }
+        return new ServerResources(Map.copyOf(animations), Map.copyOf(controllers), library);
+    }
+
+    public static BedrockActorAnimation serverEntity(final ResourcePackStorage packs,
+                                                     final String identifier) throws IOException {
+        return serverActor(packs, "entity/", "minecraft:client_entity", identifier);
+    }
+
+    private static BedrockActorAnimation serverActor(final ResourcePackStorage packs,
+                                                    final String folder, final String field, final String identifier) throws IOException {
+        final var effective = field.equals("minecraft:client_entity") ? packs.getEntities().getDescription(identifier) : null;
+        JsonObject entity = effective == null ? null : JsonParser.parseString(effective.toString()).getAsJsonObject();
+        try {
+            for (final var pack : packs.getPackStackBottomToTop()) {
+                if (!field.equals("minecraft:client_entity")) {
+                    for (final String path : pack.content().getFilesDeep(folder, ".json")) {
+                        final JsonObject document = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject();
+                        if (!document.has(field)) continue;
+                        final JsonObject description = document.getAsJsonObject(field).getAsJsonObject("description");
+                        if (identifier.equals(description.get("identifier").getAsString())) entity = description;
+                    }
+                }
+            }
+            if (entity == null) return null;
+            final ServerResources resources = serverResources(packs);
+            return new BedrockActorAnimation(entity, Map.of(), resources.animations(), resources.controllers(), resources.effects());
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid server actor animation graph", e);
+        }
+    }
