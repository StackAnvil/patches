+final class BedrockMolangVariablesTest {
+    private static JsonObject entry(final String name, final com.google.gson.JsonElement value, final boolean members) {
+        final JsonObject typed = new JsonObject();
+        typed.addProperty("type", members ? "member_array" : "float");
+        typed.add("value", value);
+        final JsonObject result = new JsonObject();
+        result.addProperty("name", name);
+        result.add("value", typed);
+        return result;
+    }
+
+    private static float evaluate(final BedrockMolang environment, final String expression) throws IOException {
+        return environment.evaluate(BedrockMolang.Program.parse(new JsonPrimitive(expression), 0), 0);
+    }
+
+    @Test
+    void preservesNativeMemberLookupAndCopiesValuesAcrossEmittersAndAssignments() throws IOException {
+        final JsonArray members = new JsonArray();
+        members.add(entry("R", new JsonPrimitive(9), false));
+        members.add(entry("r", new JsonPrimitive(.25F), false));
+        members.add(entry("r", new JsonPrimitive(.75F), false));
+        final JsonArray roots = new JsonArray();
+        roots.add(entry("variable.color", members, true));
+        roots.add(entry("variable.scale", new JsonPrimitive(1), false));
+        roots.add(entry("variable.scale", new JsonPrimitive(2), false));
+        roots.add(entry("Variable.scale", new JsonPrimitive(3), false));
+        final var environment = new BedrockMolang();
+        environment.variables(MolangVariables.parse(roots.toString()));
+        assertEquals(.25F, evaluate(environment, "v.color.r"));
+        assertEquals(2, evaluate(environment, "v.scale"));
+        final var copy = environment.copy();
+        assertEquals(4, evaluate(copy, "v.color.r=4; return v.color.r;"));
+        assertEquals(.25F, evaluate(environment, "v.color.r"));
+        assertEquals(.25F, evaluate(environment, "v.alias=v.color; v.alias.r=3; return v.color.r;"));
+        assertEquals(3, evaluate(environment, "v.alias.r"));
+        environment.queries(Map.of("spellcolor", new BedrockMolangColor(.5F, .25F, .125F, 1)));
+        assertEquals(.5F, evaluate(environment, "v.color=q.spellcolor; return v.color.r;"));
+        assertEquals(7, evaluate(environment, "v.color.r=7; return v.color.r;"));
+        assertEquals(.5F, evaluate(environment, "q.spellcolor.r"));
+        environment.variable("SCALE", 4);
+        assertEquals(4, evaluate(environment, "v.scale"));
+    }
+    @Test
+    void bindsDottedActorInputsAsMutableStructMembers() throws IOException {
+        final var environment = new BedrockMolang();
+        environment.variables(Map.of("shulker.peekamount", .75F, "shulker.facingdirection", 4F));
+        assertEquals(.75F, evaluate(environment, "variable.Shulker.PeekAmount"));
+        assertEquals(4F, evaluate(environment, "variable.Shulker.FacingDirection"));
+        assertEquals(1F, evaluate(environment, "variable.Shulker.WestFacing = variable.Shulker.FacingDirection == 4; return variable.Shulker.WestFacing;"));
+        environment.variables(Map.of("shulker.peekamount", .25F));
+        assertEquals(4.25F, evaluate(environment, "variable.Shulker.PeekAmount + variable.Shulker.FacingDirection"));
+    }
+
+}
