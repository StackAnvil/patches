+package com.viaversion.viafabricplus.bedrock.render;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockBoneAnimation;
+import java.util.Map;
+import net.minecraft.client.model.geom.ModelPart;
+import org.cube.converter.model.impl.bedrock.BedrockGeometryModel;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+
+final class BedrockModelTransformsTest {
+    @Test
+    void keepsAuthoredChildRotationAndScaleIndependentFromAncestors() throws Exception {
+        final var model = model();
+        for (final float parentScale : new float[]{2, 0}) {
+            model.pose(Map.of("parent", transform(20, 45, -15, parentScale, false),
+                    "child", transform(10, 25, 5, .75F, true)));
+            final var matrices = model.drawingMatrices();
+            final var root = model.model().root();
+            final var parent = root.getChild("parent");
+            final var child = parent.getChild("child");
+            final var offset = new Vector3f(child.x / 16F, child.y / 16F, child.z / 16F);
+            final var expectedOrigin = matrices.get(parent).transformPosition(offset);
+            final var expected = new Matrix4f().translation(expectedOrigin)
+                    .rotateZYX(child.zRot, child.yRot, child.xRot).scale(child.xScale, child.yScale, child.zScale);
+            assertTrue(expected.equals(matrices.get(child), .000002F));
+
+            final var poses = new PoseStack();
+            poses.translate(1, 2, 3);
+            poses.rotate(new org.joml.Quaternionf().rotationY(.8F));
+            poses.scale(2, 3, 4);
+            final var base = new Matrix4f(poses.last().pose());
+            BedrockModelTransforms.visit(root, poses, () -> {
+                apply(root, poses); apply(parent, poses); apply(child, poses);
+                assertTrue(new Matrix4f(base).mul(expected).equals(poses.last().pose(), .000005F));
+                final var normal = poses.last().normal().transform(new Vector3f(0, 1, 0)).normalize();
+                final var expectedNormal = new Matrix4f(base).mul(expected).normal(new org.joml.Matrix3f())
+                        .transform(new Vector3f(0, 1, 0)).normalize();
+                assertEquals(0, normal.distance(expectedNormal), .000001F);
+            });
+        }
+        model.pose(Map.of());
+        assertFalse(model.usesNativeMatrices());
+    }
+
+    @Test
+    void restoresScopesAfterNestedDrawingAndFailures() throws Exception {
+        final var outer = model();
+        final var inner = model();
+        outer.pose(Map.of("child", transform(10, 25, 5, .75F, true)));
+        inner.pose(Map.of("child", transform(-20, 50, 0, 2, true)));
+        final var poses = new PoseStack();
+        final var root = outer.model().root();
+        final var child = root.getChild("parent").getChild("child");
+        BedrockModelTransforms.visit(root, poses, () -> {
+            apply(root, poses);
+            assertThrows(IllegalStateException.class, () -> BedrockModelTransforms.visit(inner.model().root(), poses, () -> {
+                apply(inner.model().root(), poses);
+                throw new IllegalStateException();
+            }));
+            apply(child, poses);
+            assertTrue(outer.drawingMatrices().get(child).equals(poses.last().pose(), .000001F));
+        });
+        poses.setIdentity();
+        apply(child, poses);
+        assertTrue(new Matrix4f().translation(child.x / 16F, child.y / 16F, child.z / 16F)
+                .rotateZYX(child.zRot, child.yRot, child.xRot).scale(child.xScale, child.yScale, child.zScale)
+                .equals(poses.last().pose(), .000001F));
+    }
+
+    private static void apply(final ModelPart part, final PoseStack poses) {
+        BedrockModelTransforms.transform(part, poses, () -> part.translateAndRotate(poses));
+    }
+
+    private static BedrockAnimatedModel model() throws Exception {
+        final var geometry = BedrockGeometryModel.fromJson("""
+            {"minecraft:geometry":[{"description":{"identifier":"geometry.test","texture_width":64,"texture_height":64},
+            "bones":[{"name":"parent","pivot":[0,12,0],"rotation":[15,30,20]},
+            {"name":"child","parent":"parent","pivot":[4,20,3],"rotation":[5,10,-15]}]}]}
+            """).getFirst();
+        return BedrockGeometry.animatedModel(geometry, Map.of());
+    }
+
+    private static BedrockBoneAnimation.Transform transform(final float x, final float y, final float z,
+                                                            final float scale, final boolean relative) {
+        return new BedrockBoneAnimation.Transform(new BedrockBoneAnimation.Vector(0, 0, 0),
+                new BedrockBoneAnimation.Vector(x, y, z), new BedrockBoneAnimation.Vector(scale, scale, scale), relative);
+    }
+}
