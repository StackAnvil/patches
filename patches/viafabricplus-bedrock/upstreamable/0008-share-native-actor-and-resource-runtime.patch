+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.render;
+
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+
+/** Camera-space root for the converted actor hierarchy, whose vertices use sixteen pixels per block. */
+final class BedrockFirstPersonActor {
+    // Native player constructor 0x1401dc620 initializes the render offset separately from camera posture.
+    static final float PLAYER_RENDER_HEIGHT = 1.62001F;
+
+    private BedrockFirstPersonActor() {}
+
+    static Matrix4f root(final float heightOffset, final float modelScale, final Vector3f scriptScale,
+                         final boolean skipOffset, final Matrix4f global) {
+        final var matrix = new Matrix4f().translation(0, -heightOffset, 0)
+                .scale(-1, 1, -1).mul(global).scale(-scriptScale.x, -scriptScale.y, scriptScale.z);
+        if (!skipOffset) matrix.translate(0, modelScale * -24F - 1F / 128F, 0);
+        // Native and converted bones already contain the 24-pixel bind origin.
+        return matrix.scale(modelScale * 16F);
+    }
+
+    static Matrix4f global(final int deathTicks, final float frameAlpha, final String name, final float height) {
+        final var matrix = new Matrix4f();
+        if (deathTicks > 0) {
+            final float progress = (float) Math.sqrt(((deathTicks + frameAlpha - 1F) / 20F) * 1.6F);
+            matrix.rotateZ(Math.min(1F, progress) * 90F * .017453292F);
+        }
+        if ("Dinnerbone".equals(name) || "Grumm".equals(name))
+            matrix.rotateZ((float) Math.PI).translate(0, -(height + .1F), 0);
+        // The native first-person player flag suppresses gliding and riptide rotations.
+        return matrix;
+    }
+}
