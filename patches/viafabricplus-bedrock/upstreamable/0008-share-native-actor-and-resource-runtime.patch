+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+final class BedrockParticleEffectTest {
+    @Test
+    void composesDynamicMotionWithOptionalParametricOverrides() throws Exception {
+        final var document = burst();
+        components(document).add("minecraft:particle_motion_dynamic", json("""
+                {"linear_acceleration":[2,0,0],"rotation_acceleration":20}
+                """));
+        components(document).add("minecraft:particle_motion_parametric", json("""
+                {"rotation":45}
+                """));
+        final var emitter = BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+        emitter.advance(50_000_000, 10, null, (x, y, z) -> List.of());
+        final var first = sample(emitter).getFirst();
+        emitter.advance(50_000_000, 10, null, (x, y, z) -> List.of());
+        final var second = sample(emitter).getFirst();
+        assertTrue(second.position().x > first.position().x);
+        assertEquals(45, second.rotation());
+    }
+
+    @Test
+    void preservesOmittedParametricFieldsAndNativeSpeedThresholds() throws Exception {
+        final var position = new Vector3f(7, 8, 9);
+        final var velocity = new Vector3f(1, 2, 2);
+        final var environment = new BedrockMolang();
+        final var empty = BedrockParticleEffect.ParametricMotion.read(new JsonObject());
+        assertEquals(13, empty.advance(position, velocity, 13, environment));
+        assertEquals(new Vector3f(7, 8, 9), position);
+        assertEquals(new Vector3f(1, 2, 2), velocity);
+        final var redirected = BedrockParticleEffect.ParametricMotion.read(json("""
+                {"relative_position":[4,5,6],"direction":[3,4,0]}
+                """));
+        redirected.advance(position, velocity, 13, environment);
+        assertEquals(new Vector3f(4, 5, 6), position);
+        assertEquals(1.8F, velocity.x, .00001F);
+        assertEquals(2.4F, velocity.y, .00001F);
+        velocity.zero();
+        redirected.advance(position, velocity, 13, environment);
+        assertEquals(new Vector3f(3, 4, 0), velocity);
+        final var tiny = BedrockParticleEffect.ParametricMotion.read(json("{\"direction\":[0.000001,0,0]}"));
+        tiny.advance(position, velocity, 13, environment);
+        assertEquals(new Vector3f(), velocity);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARAMETRIC_REFERENCE", matches = ".+")
+    void matchesExecutedNativeParametricOverrides() throws Exception {
+        final var reference = json(Files.readString(Path.of(System.getenv("STACKANVIL_PARAMETRIC_REFERENCE"))));
+        for (final var element : reference.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
