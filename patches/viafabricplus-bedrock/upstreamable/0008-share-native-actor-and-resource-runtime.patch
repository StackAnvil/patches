+
+    private static List<BedrockParticleCollision.Box> boxes(final JsonObject config, final int x, final int y, final int z) {
+        final List<BedrockParticleCollision.Box> boxes = new ArrayList<>();
+        for (final var entry : config.getAsJsonArray("boxes")) {
+            final var box = entry.getAsJsonArray();
+            if (Math.floor(box.get(0).getAsFloat()) == x && Math.floor(box.get(1).getAsFloat()) == y && Math.floor(box.get(2).getAsFloat()) == z)
+                boxes.add(new BedrockParticleCollision.Box(box.get(0).getAsFloat(), box.get(1).getAsFloat(), box.get(2).getAsFloat(),
+                        box.get(3).getAsFloat(), box.get(4).getAsFloat(), box.get(5).getAsFloat()));
+        }
+        return boxes;
+    }
+    private static JsonObject json(final String value) { return JsonParser.parseString(value).getAsJsonObject(); }
