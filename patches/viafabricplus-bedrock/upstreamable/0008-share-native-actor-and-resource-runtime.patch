+                    // Native numeric array fields retain their float value, including overflow.
+                    programs.add(new BedrockMolang.Program(axis.getAsFloat(), null));
+                } else {
+                    try {
+                        programs.add(BedrockMolang.Program.parse(axis, 0));
+                    } catch (ParseException invalid) {
+                        diagnostics.add("Could not parse custom particle direction component " + programs.size() + ". Used zero.");
+                        programs.add(new BedrockMolang.Program(0, null));
+                    }
+                }
+            }
+            return new Direction(true, List.copyOf(programs), DEFAULT_THRESHOLD_SQUARED, true, List.copyOf(diagnostics));
+        }
+
+        void sample(final BedrockMolang environment, final Vector3f velocity, final Vector3f previous) {
+            if (this.custom) previous.set(evaluated(this.vector, environment));
+            else if (velocity.lengthSquared() > this.thresholdSquared)
+                previous.set(velocity).mul(1F / (float) Math.sqrt(velocity.lengthSquared()));
+        }
+    }
+
+    record View(float width, float height, float u0, float v0, float u1, float v1) {}
+    private record Stop(float time, List<BedrockMolang.Program> color) {}
+    private record Tint(List<Stop> stops, BedrockMolang.Program interpolant) {
+        static Tint read(final JsonElement color) throws IOException {
+            final List<Stop> stops = new ArrayList<>();
+            if (color != null && color.isJsonObject()) {
+                final var object = color.getAsJsonObject();
+                final var gradient = object.get("gradient");
+                if (gradient == null) throw new IOException("Missing particle tint gradient");
+                if (gradient.isJsonArray()) {
+                    final var array = gradient.getAsJsonArray();
+                    if (array.isEmpty() || array.size() > 256) throw new IOException("Invalid particle tint gradient");
+                    for (int index = 0; index < array.size(); index++)
+                        stops.add(new Stop(array.size() == 1 ? 0 : (float) index / (array.size() - 1), color(array.get(index))));
+                } else {
+                    for (final var entry : gradient.getAsJsonObject().entrySet()) {
+                        final float time = Float.parseFloat(entry.getKey());
+                        if (!Float.isFinite(time) || stops.size() >= 256) throw new IOException("Invalid particle tint stop");
+                        stops.add(new Stop(time, color(entry.getValue())));
+                    }
+                }
+                if (stops.isEmpty()) throw new IOException("Empty particle tint gradient");
+                stops.sort(Comparator.comparingDouble(Stop::time));
+                return new Tint(List.copyOf(stops), program(object, "interpolant", 0));
+            }
+            return new Tint(List.of(new Stop(0, color(color))), null);
+        }
+
+        BedrockMolangColor sample(final BedrockMolang environment) {
+            final float time = environment.evaluate(this.interpolant, 0);
+            Stop before = this.stops.getFirst(), after = before;
+            for (final Stop stop : this.stops) {
+                after = stop;
+                if (stop.time >= time) break;
+                before = stop;
+            }
+            final float blend = after.time == before.time ? 0 : Math.clamp((time - before.time) / (after.time - before.time), 0, 1);
+            final float[] channels = new float[4];
+            for (int channel = 0; channel < 4; channel++) {
+                final float from = environment.evaluate(before.color.get(channel), 1);
+                final float to = before == after ? from : environment.evaluate(after.color.get(channel), 1);
+                channels[channel] = from + (to - from) * blend;
+            }
+            return new BedrockMolangColor(channels[0], channels[1], channels[2], channels[3]);
+        }
+
+        private static List<BedrockMolang.Program> color(final JsonElement value) throws IOException {
+            if (value == null) return vector(null, 4, 1);
+            if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                final String hex = value.getAsString();
+                if (!hex.matches("#[a-fA-F0-9]{6}(?:[a-fA-F0-9]{2})?")) throw new IOException("Invalid particle tint color");
+                final long packed = Long.parseLong(hex.substring(1), 16);
+                return List.of(constant((packed >>> 16 & 255) / 255F), constant((packed >>> 8 & 255) / 255F),
+                        constant((packed & 255) / 255F), constant(hex.length() == 7 ? 1 : (packed >>> 24 & 255) / 255F));
+            }
+            final var array = value.getAsJsonArray();
+            if (array.size() != 3 && array.size() != 4) throw new IOException("Invalid particle tint channels");
+            final List<BedrockMolang.Program> result = new ArrayList<>();
+            for (final JsonElement channel : array) result.add(BedrockMolang.Program.parse(channel, 1));
+            if (result.size() == 3) result.add(constant(1));
+            return List.copyOf(result);
+        }
+    }
+
+    private enum RateKind { INSTANT, STEADY, MANUAL }
+
+    private record Rate(RateKind kind, BedrockMolang.Program expression, BedrockMolang.Program capacity) {}
+
+    static int manualCapacity(final float value) {
+        // Native converts through unsigned 64-bit before applying the 2,000-particle cap.
+        return !Float.isFinite(value) || value <= -1 || value >= 2000 ? 2000 : (int) value;
+    }
+    static int boundedCount(final float value, final int maximum) {
+        return Float.isFinite(value) ? (int) Math.clamp(value, 0, maximum) : 0;
+    }
+    private static void randomVariables(final BedrockMolang environment, final RandomGenerator random, final String prefix) {
+        for (int index = 1; index <= 4; index++) environment.variable(prefix + "_random_" + index, random.nextFloat());
+    }
+    static Vector3f evaluated(final List<BedrockMolang.Program> values, final BedrockMolang environment) {
+        return new Vector3f(environment.evaluate(values.get(0), 0), environment.evaluate(values.get(1), 0), environment.evaluate(values.get(2), 0));
+    }
+    static List<BedrockMolang.Program> vector(final JsonElement value, final int length, final float fallback) throws IOException {
+        final List<BedrockMolang.Program> result = new ArrayList<>();
+        if (value != null && (!value.isJsonArray() || value.getAsJsonArray().size() != length)) throw new IOException("Invalid particle vector");
+        for (int index = 0; index < length; index++) result.add(BedrockMolang.Program.parse(value == null ? null : value.getAsJsonArray().get(index), fallback));
+        return List.copyOf(result);
+    }
+    private static BedrockMolang.Program constant(final float value) { return new BedrockMolang.Program(value, null); }
+    static BedrockMolang.Program program(final JsonObject value, final String name, final float fallback) throws IOException {
+        return BedrockMolang.Program.parse(value.get(name), fallback);
+    }
+    static JsonObject object(final JsonObject value, final String name) {
+        return value.has("minecraft:" + name) ? value.getAsJsonObject("minecraft:" + name) : new JsonObject();
+    }
+    static boolean bool(final JsonObject value, final String name) { return value.has(name) && value.get(name).getAsBoolean(); }
+    private static float number(final JsonObject value, final String name, final float fallback) throws IOException {
+        final float result = value.has(name) ? value.get(name).getAsFloat() : fallback;
+        if (!Float.isFinite(result) || Math.abs(result) > 32768) throw new IOException("Invalid particle number");
+        return result;
+    }
+}
