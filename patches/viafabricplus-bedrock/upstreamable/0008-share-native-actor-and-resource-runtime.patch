+        emitter.dispatcher(emitterActions::add);
+        final BedrockParticleCollision.Terrain terrain = (x, y, z) -> x == 11 && y == 0 && z == 0
+                ? List.of(new BedrockParticleCollision.Box(11, 0, 0, 12, 1, 1)) : List.of();
+        emitter.advance(0, 2, null, terrain);
