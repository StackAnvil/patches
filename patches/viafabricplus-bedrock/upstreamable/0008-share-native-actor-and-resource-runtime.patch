+    public static final class PartVisibility {
+        private final BedrockBonePattern pattern;
+        private final boolean visible;
+
+        public PartVisibility(final java.util.regex.Pattern pattern, final boolean visible) {
+            this(new BedrockBonePattern(pattern), visible);
