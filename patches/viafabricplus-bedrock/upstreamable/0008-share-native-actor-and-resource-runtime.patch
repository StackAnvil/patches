+        /** Evaluates a render expression in the variables left by the sampled actor graph. */
+        public float expression(final String source, final float fallback) {
+            try {
+                BedrockMolang.Program program = this.expressions.get(source);
+                if (program == null) {
+                    program = BedrockMolang.Program.parse(new com.google.gson.JsonPrimitive(source), fallback);
+                    this.expressions.put(source, program);
