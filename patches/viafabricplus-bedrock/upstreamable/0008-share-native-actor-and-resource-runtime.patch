+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.concurrent.CompletableFuture;
+
+/** Loads the native player graph for every Bedrock skin, including ordinary classic skins. */
+public final class BedrockPlayerAnimations {
+    private final CompletableFuture<BedrockActorAnimation> animations;
+    private BedrockActorAnimation.Playback playback;
+
+    public BedrockPlayerAnimations(final CompletableFuture<BedrockActorAnimation> animations) {
+        this.animations = animations;
+    }
+
+    public BedrockActorAnimation.Playback body() {
+        return this.nativePlayback();
+    }
+
+    public BedrockActorAnimation.Playback firstPerson(final BedrockActorAnimation.Playback preferred, final boolean alwaysUseJavaHand) {
+        if (alwaysUseJavaHand) return null;
+        return preferred != null ? preferred : this.nativePlayback();
+    }
+
+    private BedrockActorAnimation.Playback nativePlayback() {
+        if (!this.animations.isDone() || this.animations.isCompletedExceptionally()) return null;
+        if (this.playback == null) this.playback = this.animations.join().playback();
+        return this.playback;
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPlayerControllers.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockPlayerControllers.java
