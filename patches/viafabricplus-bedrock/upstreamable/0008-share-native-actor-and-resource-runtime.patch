+        final var scripts = new JsonObject();
+        scripts.addProperty("scale", scale);
+        description.add("scripts", scripts);
+        final var entity = new JsonObject();
+        entity.add("description", description);
+        final var document = new JsonObject();
+        document.addProperty("format_version", "1.8.0");
+        document.add("minecraft:client_entity", entity);
