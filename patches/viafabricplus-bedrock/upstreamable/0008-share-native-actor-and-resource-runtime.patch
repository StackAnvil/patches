+    @Test
+    void replacesRepeatedAnimationsInAdmissionOrderWithoutMergingTheirBones() throws Exception {
+        final String entity = """
+                {"minecraft:client_entity":{"description":{"identifier":"minecraft:player",
+                  "animations":{"pose":"animation.shared","retained":"animation.retained"},
+                  "scripts":{"animate":["pose","retained"]}}}}
+                """;
+        final String first = """
+                {"format_version":"1.8.0","animations":{
+                  "animation.shared":{"loop":true,"bones":{
+                    "head":{"position":[1,0,0]},"body":{"position":[0,3,0]}}},
+                  "animation.retained":{"loop":true,"bones":{"arm":{"position":[0,0,2]}}}}}
+                """;
+        final String second = """
+                {"format_version":"1.10.0","animations":{
+                  "animation.shared":{"loop":true,"bones":{"head":{"position":[4,0,0]}}}}}
+                """;
+        for (final boolean reversed : List.of(false, true)) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            put(files, "vanilla", "entity/player.json", entity);
+            // Admission order is independent of the filenames' lexical order.
+            put(files, "vanilla", "animations/z-first.json", reversed ? second : first);
+            put(files, "vanilla", "animations/a-last.json", reversed ? first : second);
+            final var builtin = BedrockResourceLibrary.read(files);
+            final Map<String, byte[]> server = new LinkedHashMap<>();
+            files.forEach((path, bytes) -> server.put(path.substring("library/vanilla/".length()), bytes));
+            final var accepted = BedrockResourceLibrary.withServerPacks(null, List.of(server));
+            for (final var library : List.of(builtin, accepted)) {
+                final var frame = new BedrockActorAnimation.Frame(Map.of(), Map.of());
+                final var pose = BedrockActorAnimation.read(library, BedrockClassicOptions.EMPTY).playback().sample(0, frame);
+                assertEquals(reversed ? 1 : 4, pose.get("head").position().x());
+                assertEquals(reversed, pose.containsKey("body"));
+                assertEquals(2, pose.get("arm").position().z());
+                // A later pack replaces the identifier while retaining unrelated lower-pack animations.
+                final var higher = BedrockResourceLibrary.withServerPacks(library, List.of(Map.of(
+                        "animations/higher.json", second.replace("[4,0,0]", "[7,0,0]").getBytes(StandardCharsets.UTF_8))));
+                final var overridden = BedrockActorAnimation.read(higher, BedrockClassicOptions.EMPTY).playback().sample(0, frame);
+                assertEquals(7, overridden.get("head").position().x());
+                assertFalse(overridden.containsKey("body"));
+                assertEquals(2, overridden.get("arm").position().z());
+            }
+        }
+    }
