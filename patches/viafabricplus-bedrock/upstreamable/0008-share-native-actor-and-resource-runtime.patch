+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import org.junit.jupiter.api.Test;
+
+final class BedrockTintMaskTest {
+    @Test
+    void decodesTintMaskChannelsAndBothImageOrigins() throws Exception {
+        final int[] colors = {0x00FF0000, 0x0000FF00, 0x000000FF, 0xFF000000};
+        for (final int descriptor : new int[] {8, 0x28, 0x18, 0x38}) {
+            final ByteBuffer bytes = ByteBuffer.allocate(18 + 16).order(ByteOrder.LITTLE_ENDIAN);
+            bytes.put(2, (byte) 2);
+            bytes.putShort(12, (short) 2);
+            bytes.putShort(14, (short) 2);
+            bytes.put(16, (byte) 32);
+            bytes.put(17, (byte) descriptor);
+            bytes.position(18);
+            for (final int color : colors) bytes.putInt(color);
+            final var image = BedrockPersonaSources.tga(bytes.array());
+            for (int row = 0; row < 2; row++)
+                for (int column = 0; column < 2; column++) {
+                    final int x = (descriptor & 0x10) != 0 ? 1 - column : column;
+                    final int y = (descriptor & 0x20) != 0 ? row : 1 - row;
+                    assertEquals(colors[row * 2 + column], image.getRGB(x, y));
+                }
+            assertThrows(
+                    IOException.class,
+                    () -> BedrockPersonaSources.tga(java.util.Arrays.copyOf(bytes.array(), 25)));
+        }
+    }
+
+    @Test
+    void decodesCompressedMapsAndRejectsTruncatedOrOversizedRuns() throws Exception {
+        final ByteBuffer bytes =
+                ByteBuffer.allocate(18 + 1 + 8 + 1 + 4).order(ByteOrder.LITTLE_ENDIAN);
+        bytes.put(2, (byte) 10);
+        bytes.putShort(12, (short) 2);
+        bytes.putShort(14, (short) 2);
+        bytes.put(16, (byte) 32);
+        bytes.put(17, (byte) 0x28);
+        bytes.position(18);
+        bytes.put((byte) 1).putInt(0x00FF0000).putInt(0x0000FF00);
+        bytes.put((byte) 0x81).putInt(0xFF7F8100);
+        final var image = BedrockPersonaSources.tga(bytes.array());
+        assertEquals(0x00FF0000, image.getRGB(0, 0));
+        assertEquals(0x0000FF00, image.getRGB(1, 0));
+        assertEquals(0xFF7F8100, image.getRGB(0, 1));
+        assertEquals(0xFF7F8100, image.getRGB(1, 1));
+        assertThrows(
+                IOException.class,
+                () ->
+                        BedrockPersonaSources.tga(
+                                java.util.Arrays.copyOf(bytes.array(), bytes.capacity() - 1)));
+        bytes.put(27, (byte) 0x82);
+        assertThrows(IOException.class, () -> BedrockPersonaSources.tga(bytes.array()));
+    }
+
+}
