+    void matchesNativeRectanglesFlipbooksAndVelocityThresholds() throws Exception {
+        final var cases = fixture("native-particle-billboard-result.json").getAsJsonArray("cases");
+        for (final var row : cases) {
+            final var config = row.getAsJsonObject().getAsJsonObject("config");
+            final var expected = row.getAsJsonObject().getAsJsonObject("values");
+            final var value = new JsonObject();
+            value.add("size", config.has("size") ? config.get("size") : JsonParser.parseString("[-2,0.4]"));
+            value.addProperty("facing_camera_mode", "rotate_xyz");
+            final var direction = json("{\"mode\":\"derive_from_velocity\"}");
+            // The native fixture's threshold is the reader's already squared runtime field.
+            direction.addProperty("min_speed_threshold", Math.sqrt(config.has("threshold") ? config.get("threshold").getAsFloat() : .01F));
+            if (config.has("mode") && config.get("mode").getAsInt() == 1) {
+                direction.addProperty("mode", "custom");
+                direction.add("custom_direction", JsonParser.parseString("[-0.5,0.25,2]"));
+            }
+            value.add("direction", direction);
+            final var uv = json("{\"texture_width\":128,\"texture_height\":64,\"uv\":[16,24],\"uv_size\":[-8,4]}");
+            if (!config.has("flipbook") || config.get("flipbook").getAsBoolean()) {
+                final var flip = json("{\"base_UV\":[56,12],\"size_UV\":[8,4],\"step_UV\":[-8,2]}");
+                flip.add("max_frame", config.get("max_frame"));
+                flip.add("stretch_to_lifetime", config.get("stretch"));
+                flip.add("loop", config.get("loop"));
+                flip.addProperty("frames_per_second", config.has("fps") ? config.get("fps").getAsFloat() : 8);
+                uv.add("flipbook", flip);
+            }
+            value.add("uv", uv);
+            final var declared = BedrockParticleEffect.Billboard.read(value);
+            final var parsed = new BedrockParticleEffect.Billboard(declared.size(), declared.uv(), declared.uvSize(),
+                    declared.inverseWidth(), declared.inverseHeight(), declared.flipbook(), declared.mode(),
+                    new BedrockParticleEffect.Direction(declared.direction().custom(), declared.direction().vector(),
+                            config.has("threshold") ? config.get("threshold").getAsFloat() : .01F, true, List.of()), declared.diagnostics());
+            final var velocity = config.has("velocity") ? vector(config,"velocity") : new Vector3f(2,-1,3);
+            final var previous = config.has("previous_direction") ? vector(config,"previous_direction") : new Vector3f(0,1,0);
+            final var view = parsed.sample(new BedrockMolang(), config.get("age").getAsFloat(), config.get("lifetime").getAsFloat(), velocity, previous);
+            final var size = expected.getAsJsonArray("size");
+            final var coords = expected.getAsJsonArray("uv");
