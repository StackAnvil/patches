+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class BedrockSoundEnvelopeTest {
+    @Test
+    void replacementFadesStartAtCurrentGainAndVolumeCancelsFade() {
+        final var volume = new BedrockSoundEnvelope(1);
+        volume.fade(2, 0.2F, 0);
+        assertEquals(1, volume.volume(-1));
+        assertEquals(0.6F, volume.volume(1_000_000_000L), 0.000001F);
+        volume.fade(1, 1, 1_000_000_000L);
+        assertEquals(0.8F, volume.volume(1_500_000_000L), 0.000001F);
+        assertEquals(1, volume.volume(3_000_000_000L));
+        volume.set(0.3F);
+        assertEquals(0.3F, volume.volume(3_500_000_000L));
+        volume.fade(0, 0, 3_500_000_000L);
+        assertEquals(0, volume.volume(3_500_000_000L));
+        assertThrows(IllegalArgumentException.class, () -> volume.fade(Float.NaN, 1, 0));
+        assertThrows(IllegalArgumentException.class, () -> volume.set(Float.POSITIVE_INFINITY));
+    }
+}
