+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+final class BedrockWalkingAnimationTest {
+    @Test
+    void preservesTickDistanceAndExtrapolatesWithoutClampingFrameAlpha() {
+        final var walking = new BedrockWalkingAnimation();
+        walking.tick(3, 4);
+        assertEquals(3F, walking.sample(0));
+        assertEquals(4.5F, walking.sample(0.5F));
+        assertEquals(6F, walking.sample(1));
+        walking.tick(0, 0);
+        assertEquals(3F, walking.sample(1));
+        walking.tick(-3, -4);
+        assertEquals(6F, walking.sample(0));
+        assertEquals(10.5F, walking.sample(1.5F));
+        assertEquals(4.5F, walking.sample(-0.5F));
+    }
+
+    @Test
+    void appliesScaleAfterAccumulationAndExtrapolation() {
+        final var walking = new BedrockWalkingAnimation();
+        for (int tick = 0; tick < 1000; tick++) walking.tick(0.023F, -0.019F);
+        // Native 1.26.51.1 component update and query callbacks, after 1,000 ticks.
+        assertEquals(0x418f4e18, Float.floatToRawIntBits(walking.sample(0.75F)));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_WALK_QUERIES", matches = ".+")
+    void matchesTargetExecutableComponentUpdatesAndQueryResults() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(
+                Path.of(System.getenv("STACKANVIL_WALK_QUERIES")))).getAsJsonObject();
+        for (final var value : fixture.getAsJsonArray("cases")) {
+            final var row = value.getAsJsonObject();
+            if (!row.get("actor").getAsBoolean()) continue;
+            assertEquals(row.get("value").getAsFloat(), BedrockWalkingAnimation.sample(
+                    row.get("first").getAsFloat(), row.get("second").getAsFloat(), row.get("alpha").getAsFloat()));
+        }
+        final var walking = new BedrockWalkingAnimation();
+        for (final var value : fixture.getAsJsonArray("updates")) {
+            final var row = value.getAsJsonObject();
+            final float dx = row.get("skip").getAsBoolean() ? 0
+                    : row.get("x").getAsFloat() - row.get("old_x").getAsFloat();
+            final float dz = row.get("skip").getAsBoolean() ? 0
+                    : row.get("z").getAsFloat() - row.get("old_z").getAsFloat();
+            walking.tick(dx, dz);
+            for (final var sample : row.getAsJsonArray("samples")) {
+                final var point = sample.getAsJsonObject();
+                assertEquals(point.get("value").getAsFloat(), walking.sample(point.get("alpha").getAsFloat()));
+            }
+        }
+    }
