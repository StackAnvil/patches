+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.raphimc.viabedrock.api.model.MolangVariables;
+import net.raphimc.viabedrock.api.model.NativeBlockView;
+import net.raphimc.viabedrock.api.model.NativeBlockIdentifiers;
+import net.raphimc.viabedrock.api.model.NativeBlockSection;
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.minecraft.world.phys.Vec3;
+import org.joml.Vector3f;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleBlocksTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeEmptyListsMembershipAndWorldCoordinates() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-particle-block-expiration-result.json"))).getAsJsonObject();
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var filter = new BedrockParticleBlocks(row.get("empty").getAsBoolean() ? List.of()
+                    : List.of(new BedrockParticleBlocks.Filter(Set.of("minecraft:air"), row.get("in_blocks").getAsBoolean())));
+            final var position = vector(row, "position");
+            final var origin = vector(row, "origin");
+            final int[] queries = {0};
+            final boolean expired = filter.expires(position, new Vec3(origin.x, origin.y, origin.z), (x, y, z) -> {
+                queries[0]++;
+                final var expected = row.getAsJsonArray("cell");
+                assertEquals(expected.get(0).getAsInt(), x);
+                assertEquals(expected.get(1).getAsInt(), y);
+                assertEquals(expected.get(2).getAsInt(), z);
+                return row.get("match").getAsBoolean() ? "minecraft:air" : "minecraft:stone";
+            });
+            assertEquals(row.get("expired").getAsBoolean(), expired);
+            assertEquals(row.get("empty").getAsBoolean() ? 0 : 1, queries[0]);
+        }
+    }
+
+    @Test
+    void disablesEmptyFiltersAndSharesTheFirstBlockSet() throws Exception {
+        final var components = new JsonObject();
+        components.add("minecraft:particle_expire_if_not_in_blocks", new JsonArray());
+        assertFalse(BedrockParticleBlocks.read(components).required());
+        components.add("minecraft:particle_expire_if_in_blocks", JsonParser.parseString("[\"water\"]"));
+        components.add("minecraft:particle_expire_if_not_in_blocks", JsonParser.parseString("[\"minecraft:air\"]"));
+        final var filters = BedrockParticleBlocks.read(components);
+        assertTrue(filters.expires(new Vector3f(), Vec3.ZERO, (x, y, z) -> "minecraft:water"));
+        assertTrue(filters.expires(new Vector3f(), Vec3.ZERO, (x, y, z) -> "minecraft:stone"));
+        assertTrue(filters.expires(new Vector3f(), Vec3.ZERO, (x, y, z) -> null));
+        assertThrows(IOException.class, () -> BedrockParticleBlocks.read(JsonParser.parseString(
+                "{\"minecraft:particle_expire_if_in_blocks\":[{}]}").getAsJsonObject()));
+    }
+
+    @Test
+    void checksAfterMotionAndDispatchesExpiration() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var definition = document.getAsJsonObject("particle_effect");
+        final var components = definition.getAsJsonObject("components");
+        components.add("minecraft:particle_initial_speed", JsonParser.parseString("[20,0,0]"));
+        components.add("minecraft:particle_expire_if_not_in_blocks", JsonParser.parseString("[\"minecraft:air\"]"));
+        components.add("minecraft:particle_lifetime_events", JsonParser.parseString("{\"expiration_event\":\"expired\"}"));
+        definition.add("events", JsonParser.parseString("{\"expired\":{\"particle_effect\":{\"effect\":\"test:child\",\"type\":\"particle\"}}}"));
+        final var effect = BedrockParticleEffect.read(document);
+        assertThrows(IllegalArgumentException.class, () -> effect.emitter(new BedrockMolang(), new java.util.Random(4), Vec3.ZERO));
+        final var emitter = effect.emitter(new BedrockMolang(), new java.util.Random(4),
+                BedrockParticleAttachment.Matrix.translation(new Vec3(10, 0, 0)),
+                (x, y, z) -> x < 11 ? "minecraft:air" : "minecraft:stone");
+        final List<BedrockParticleEvents.Action> emitterActions = new java.util.ArrayList<>();
+        emitter.dispatcher(emitterActions::add);
+        emitter.advance(0, 2, null, (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        emitter.advance(50_000_000, 0, null, (x, y, z) -> List.of());
+        assertEquals(0, emitter.size());
+        assertEquals(2, BedrockParticleEventsTest.drain(emitterActions).size());
+    }
+
+    @Test
+    void usesTransportedNativeNamesForExpirationAfterBlockUpdates() {
+        final var view = new NativeBlockView();
+        view.accept(new NativeBlockIdentifiers.Reset(0, -64, 384, 0));
+        view.accept(new NativeBlockIdentifiers.Dictionary(0, List.of(
+                new NativeBlockIdentifiers.Name(17, "test:target", Map.of(), -1),
+                new NativeBlockIdentifiers.Name(41, "test:other", Map.of(), -1))));
+        view.accept(new NativeBlockIdentifiers.Section(0, -2, -4, -3, 0,
+                NativeBlockSection.create(index -> 17)));
+        final var filter = new BedrockParticleBlocks(List.of(new BedrockParticleBlocks.Filter(Set.of("test:target"), true)));
+        final Vec3 origin = new Vec3(-31.75, -63.75, -47.75);
+        final Vector3f offset = new Vector3f(.5F, .5F, .5F);
+        assertTrue(filter.expires(offset, origin, view::block));
+        view.accept(new NativeBlockIdentifiers.Update(0, new BlockPosition(-32, -64, -48), 1, 41));
+        assertTrue(filter.expires(offset, origin, view::block));
+        view.accept(new NativeBlockIdentifiers.Update(0,
+                new BlockPosition(-32, -64, -48), 0, 41));
+        assertFalse(filter.expires(offset, origin, view::block));
+        assertTrue(filter.expires(new Vector3f(1.5F, .5F, .5F), origin, view::block));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_FISHING_GRAPH_REFERENCE", matches = ".+")
+    void appliesTheLicensedSplashAirFilterAtRecordedTeaseOrigins() throws Exception {
+        final Path reference = Path.of(System.getenv("STACKANVIL_FISHING_GRAPH_REFERENCE"));
+        final var fixture = JsonParser.parseString(Files.readString(reference.resolve("native-splash-blocks.json"))).getAsJsonObject();
+        final var effect = BedrockParticleEffect.read(JsonParser.parseString(
+                Files.readString(reference.resolve("water_splash.json"))).getAsJsonObject());
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var origin = vector(row, "origin");
+            final var environment = new BedrockMolang();
+            environment.variables(new MolangVariables(List.of(new MolangVariables.Member("variable.direction",
+                    new MolangVariables.Members(List.of(new MolangVariables.Member("x", new MolangVariables.Scalar(0.1F)),
+                            new MolangVariables.Member("y", new MolangVariables.Scalar(0.1F)),
+                            new MolangVariables.Member("z", new MolangVariables.Scalar(0.1F))))))));
+            final int[] queries = {0};
+            final var emitter = effect.emitter(environment, new java.util.Random(2193),
+                    BedrockParticleAttachment.Matrix.translation(new Vec3(origin.x, origin.y, origin.z)), (x, y, z) -> {
+                        queries[0]++;
+                        final var cell = row.getAsJsonArray("cell");
+                        assertEquals(cell.get(0).getAsInt(), x);
+                        assertEquals(cell.get(1).getAsInt(), y);
+                        assertEquals(cell.get(2).getAsInt(), z);
+                        return row.get("block").getAsString();
+                    });
+            // A zero-time update isolates the actual asset's birth offset and expiration predicate.
+            emitter.advance(0, 1, null, (x, y, z) -> List.of());
+            final int survivors = row.get("expired").getAsBoolean() ? 0 : 1;
+            assertEquals(1, queries[0]);
+            assertEquals(survivors, emitter.size());
+            assertEquals(survivors > 0, emitter.alive());
+            assertEquals(survivors, emitter.visuals(new BedrockParticleInterpolation.Frame(true, false, true, 0F, 0F)).size());
+        }
+    }
+
+    private static Vector3f vector(final JsonObject row, final String key) {
+        final var value = row.getAsJsonArray(key);
+        return new Vector3f(value.get(0).getAsFloat(), value.get(1).getAsFloat(), value.get(2).getAsFloat());
+    }
+}
