+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.raphimc.viabedrock.api.model.NativeBlockIdentifiers;
+import net.raphimc.viabedrock.api.model.NativeBlockView;
+
+import java.util.Objects;
+
+/** Keeps render invalidation aligned with the authoritative native fluid view. */
+final class BedrockNativeBlockUpdates {
+    // Sodium 0.9.2's hidden-fluid exposure walk samples a five-by-five horizontal area.
+    private static final int HORIZONTAL_RADIUS = 2;
+    private static final int VERTICAL_RADIUS = 1;
+    private final NativeBlockView view;
+    private NativeBlockIdentifiers.Reset world;
+
+    BedrockNativeBlockUpdates(final NativeBlockView view) {
+        this.view = view;
+    }
+
+    void clear() {
+        this.view.clear();
+        this.world = null;
+    }
+
+    SectionRange accept(final NativeBlockIdentifiers message) {
+        if (message instanceof NativeBlockIdentifiers.Reset reset) {
+            this.view.accept(reset);
+            this.world = reset;
+            return null;
+        }
+        if (this.world == null || message.dimension() != this.world.dimension()) return null;
+        if (message instanceof NativeBlockIdentifiers.Update update) {
+            final var pos = update.position();
+            final Integer previous = this.view.fluidJavaId(pos.x(), pos.y(), pos.z());
+            this.view.accept(update);
+            if (Objects.equals(previous, this.view.fluidJavaId(pos.x(), pos.y(), pos.z()))) return null;
+            return bounds((long) pos.x() - HORIZONTAL_RADIUS, (long) pos.y() - VERTICAL_RADIUS, (long) pos.z() - HORIZONTAL_RADIUS,
+                    (long) pos.x() + HORIZONTAL_RADIUS, (long) pos.y() + VERTICAL_RADIUS, (long) pos.z() + HORIZONTAL_RADIUS);
+        }
+        this.view.accept(message);
+        if (message instanceof NativeBlockIdentifiers.Section section) {
+            final long x = (long) section.chunkX() << 4;
+            final long y = (long) section.sectionY() << 4;
+            final long z = (long) section.chunkZ() << 4;
+            return bounds(x - HORIZONTAL_RADIUS, y - VERTICAL_RADIUS, z - HORIZONTAL_RADIUS,
+                    x + 15 + HORIZONTAL_RADIUS, y + 15 + VERTICAL_RADIUS, z + 15 + HORIZONTAL_RADIUS);
+        }
+        if (message instanceof NativeBlockIdentifiers.Forget forget) {
+            final long x = (long) forget.chunkX() << 4;
+            final long z = (long) forget.chunkZ() << 4;
+            return bounds(x - HORIZONTAL_RADIUS, (long) this.world.minY() - VERTICAL_RADIUS, z - HORIZONTAL_RADIUS,
+                    x + 15 + HORIZONTAL_RADIUS, (long) this.world.minY() + this.world.height() - 1 + VERTICAL_RADIUS, z + 15 + HORIZONTAL_RADIUS);
+        }
+        return null;
+    }
+
+    private static SectionRange bounds(final long minX, final long minY, final long minZ,
+                                       final long maxX, final long maxY, final long maxZ) {
+        return new SectionRange(section(minX), section(minY), section(minZ), section(maxX), section(maxY), section(maxZ));
+    }
+
+    private static int section(final long coordinate) {
+        return (int) Math.clamp(coordinate >> 4, Integer.MIN_VALUE >> 4, Integer.MAX_VALUE >> 4);
+    }
+
+    record SectionRange(int minX, int minY, int minZ, int maxX, int maxY, int maxZ) {}
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockNativeBlocks.java b/src/main/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockNativeBlocks.java
