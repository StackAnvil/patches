+final class BedrockParticleChildrenTest {
+    @Test
+    void keepsFailedSlotsInNativeGrowthOrderWhenLaterAttemptsSucceed() {
+        final var children = new BedrockParticleChildren<Integer, Integer>(_ -> 7L);
+        for (int index = 0; index < 8; index++)
+            assertNull(children.acquire(index, _ -> true, () -> null).child());
+        assertTrue(children.acquire(8, _ -> true, () -> 8).created());
+        for (int index = 7; index >= 0; index--) {
+            final int child = index;
+            assertTrue(children.acquire(index, _ -> true, () -> child).created());
+        }
+        final var retired = new ArrayList<Integer>();
+        children.retire(_ -> true, retired::add);
+        assertEquals(List.of(8, 0, 1, 2, 3, 4, 5, 6, 7), retired);
+    }
+
+    @Test
+    void dispatchesActualExpiryCallbacksInNativeBucketOrder() throws Exception {
+        final var children = new BedrockParticleChildren<Integer, Child>(index -> index == 2 ? 1L : 0L);
+        final var registered = new ArrayList<Child>();
+        final var expired = new ArrayList<Integer>();
+        for (int index = 0; index < 3; index++) {
+            final int childIndex = index;
+            final var child = new Child(0, new ArrayList<>());
+            child.environment.addQueries(Map.of("expiry", (BedrockActorAnimation.Query) _ -> {
+                expired.add(childIndex); return 0F;
+            }));
+            registered.add(child);
+            children.acquire(index, registered::contains, () -> child);
+        }
+        children.retire(registered::contains, child -> child.emitter.expire());
+        assertEquals(List.of(1, 0, 2), expired);
+        assertTrue(registered.stream().noneMatch(child -> child.emitter.alive()));
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_PARTICLE_CHILD_ORDER", matches = ".+")
+    void matchesOriginalCacheInsertionRehashAndDestructorTraversal() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_PARTICLE_CHILD_ORDER")))).getAsJsonObject();
+        int cases = 0;
+        for (final var item : fixture.getAsJsonArray("rows")) {
+            final var row = item.getAsJsonObject();
+            final Map<String, Long> hashes = new HashMap<>();
+            final Map<String, Integer> registered = new HashMap<>();
+            final var names = row.getAsJsonArray("names");
+            for (int index = 0; index < names.size(); index++) {
+                final String key = names.get(index).getAsString();
+                hashes.put(key, Long.parseUnsignedLong(row.getAsJsonArray("hashes").get(index).getAsString()));
+                if (!registered.containsKey(key)) registered.put(key, registered.size());
+            }
+            final var children = new BedrockParticleChildren<String, Integer>(key -> hashes.get(key));
+            for (final var name : names)
+                assertNull(children.acquire(name.getAsString(), _ -> true, () -> null).child());
+            // Successful retries run in a different order without changing the original cache traversal.
+            final var retry = new ArrayList<>(registered.keySet());
+            java.util.Collections.sort(retry, java.util.Comparator.reverseOrder());
+            for (final String key : retry)
+                assertTrue(children.acquire(key, registered::containsValue, () -> registered.get(key)).created());
+            final var actual = new ArrayList<Integer>();
+            children.retire(registered::containsValue, actual::add);
+            final var expected = row.getAsJsonArray("retirement").asList().stream().map(value -> value.getAsInt()).toList();
+            assertEquals(expected, actual, "native cache case " + cases++);
+        }
+        assertEquals(32, cases);
+    }
+
+    @Test
+    void retainsInitializedHandlesAcrossExpiryAndRetirementWithoutAdoptingReplacements() throws Exception {
+        final var children = new BedrockParticleChildren<String, Child>(BedrockParticleChildrenTest::hash);
+        final List<Child> registered = new ArrayList<>();
+        final var first = new Child(4, new ArrayList<>());
+        final int[] factories = {0};
+        final Supplier<Child> factory = () -> { factories[0]++; registered.add(first); return first; };
+        assertTrue(children.acquire("effect", registered::contains, factory).created());
+        first.emitter.expire();
+        assertFalse(first.emitter.alive());
+        final var expired = children.acquire("effect", registered::contains, factory);
+        assertSame(first, expired.child());
+        assertFalse(expired.created());
+        registered.remove(first);
+        final var replacement = new Child(4, new ArrayList<>());
+        registered.add(replacement);
+        assertNull(children.acquire("effect", registered::contains, factory).child());
+        assertNull(children.acquire("effect", registered::contains, factory).child());
+        assertEquals(1, factories[0]);
+        final var otherOwner = new BedrockParticleChildren<String, Child>(BedrockParticleChildrenTest::hash);
+        assertSame(replacement, otherOwner.acquire("effect", registered::contains, () -> replacement).child());
+        assertNull(children.acquire("missing", registered::contains, () -> null).child());
+        final var retried = children.acquire("missing", registered::contains, () -> replacement);
+        assertTrue(retried.created());
+        children.discard("missing", first);
+        assertSame(replacement, children.acquire("missing", registered::contains, () -> fail()).child());
+        children.discard("missing", replacement);
+        assertTrue(children.acquire("missing", registered::contains, () -> replacement).created());
+    }
+
+    @Test
+    void keepsAutomaticTargetsRegisteredWhenTheirManualCapacityIsZero() throws Exception {
+        final var children = new BedrockParticleChildren<String, BedrockParticleEffect.Emitter>(BedrockParticleChildrenTest::hash);
