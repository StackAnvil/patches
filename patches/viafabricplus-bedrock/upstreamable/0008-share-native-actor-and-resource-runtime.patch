+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.injection.access.IBedrockNativeFluidView;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.material.Fluids;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockFluidRenderingTest {
+    @Test
+    void resolvesEachCellIndependentlyAndDistinguishesDryFromUnknownNativeData() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+        final var world = mock(BlockGetter.class, withSettings().extraInterfaces(IBedrockNativeFluidView.class));
+        final var nativeView = (IBedrockNativeFluidView) world;
+        final var origin = new BlockPos(-17, -1, -33);
+        final var water = Fluids.WATER.defaultFluidState();
+        final var lava = Fluids.FLOWING_LAVA.defaultFluidState();
+        final var dry = Fluids.EMPTY.defaultFluidState();
+        when(nativeView.bedrock$fluidState(origin.getX(), origin.getY(), origin.getZ())).thenReturn(water);
+        when(nativeView.bedrock$fluidState(origin.getX(), origin.getY() + 1, origin.getZ())).thenReturn(lava);
+        when(nativeView.bedrock$fluidState(origin.getX(), origin.getY() - 1, origin.getZ())).thenReturn(dry);
+        assertSame(water, BedrockFluidRendering.fluid(world, origin, dry));
+        assertSame(lava, BedrockFluidRendering.fluid(world, origin.above(), dry));
+        assertSame(dry, BedrockFluidRendering.fluid(world, origin.below(), water));
+        assertSame(water, BedrockFluidRendering.fluid(world, origin.north(), water));
+        assertSame(water, BedrockFluidRendering.fluid(mock(BlockGetter.class), origin, water));
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockGeometryQueriesTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/render/BedrockGeometryQueriesTest.java
