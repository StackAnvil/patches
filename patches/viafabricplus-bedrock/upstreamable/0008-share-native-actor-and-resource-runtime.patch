+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.google.gson.JsonParser;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import net.minecraft.SharedConstants;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorDataIds;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockActorQueriesTest {
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void evaluatesNativeIntegerQueriesAcrossUpdatesAndClearsUnavailableVersions() throws Exception {
+        final var carrier = mock(Entity.class);
+        when(carrier.getDeltaMovement()).thenReturn(Vec3.ZERO);
+        final var legacy = state(Set.of());
+        final var environment = new BedrockMolang();
+        final var expression = BedrockMolang.Program.parse(JsonParser.parseString("\"q.skin_id + 10 * q.trade_tier\""), 0);
+        Map<String, Object> captured = Map.of("geometry_scale", 2F);
+        Map<String, Object> first = null;
+        for (final var metadata : java.util.List.of(Map.of(ActorDataIds.SKIN_ID, 2, ActorDataIds.TRADE_TIER, 3),
+                Map.of(ActorDataIds.SKIN_ID, -1), Map.<ActorDataIds, Integer>of())) {
+            final var current = new NativeActorMessage.Snapshot(legacy.uuid(), legacy.lifetime(), false, legacy.runtimeId(),
+                    legacy.identifier(), legacy.name(), 1F, Set.of(), 0, 0, null, Map.of(), -7L, 0L, metadata);
+            captured = BedrockActorQueries.sample(carrier, current, captured);
+            environment.queries(captured);
+            assertEquals(metadata.getOrDefault(ActorDataIds.SKIN_ID, 0) + 10 * metadata.getOrDefault(ActorDataIds.TRADE_TIER, 0),
+                    environment.evaluate(expression, 0));
+            assertEquals(2F, captured.get("geometry_scale"));
+            if (first == null) first = captured;
+        }
+        environment.queries(first);
+        assertEquals(32, environment.evaluate(expression, 0));
+        for (final var retired : java.util.Arrays.asList(legacy, null)) {
+            final var unavailable = BedrockActorQueries.sample(carrier, retired, first);
+            assertFalse(unavailable.containsKey("skin_id"));
+            assertFalse(unavailable.containsKey("trade_tier"));
+            assertEquals(2F, unavailable.get("geometry_scale"));
+        }
+        assertThrows(UnsupportedOperationException.class, () -> BedrockActorQueries.sample(carrier, legacy, Map.of()).clear());
+    }
+
+    @Test
+    void evaluatesTargetMetadataWithoutTrackedTargetAndClearsUnknownLegacyState() throws Exception {
+        final var carrier = mock(Entity.class);
+        when(carrier.getDeltaMovement()).thenReturn(Vec3.ZERO);
+        final var legacy = state(Set.of());
+        final var environment = new BedrockMolang();
+        final var expression = BedrockMolang.Program.parse(JsonParser.parseString("\"q.has_target ? 9 : 4\""), 0);
+        Map<String, Object> captured = Map.of();
+        for (long target : new long[]{0, 1, -1, Long.MIN_VALUE, Long.MAX_VALUE}) {
+            final var current = new NativeActorMessage.Snapshot(legacy.uuid(), legacy.lifetime(), false, legacy.runtimeId(),
+                    legacy.identifier(), legacy.name(), 1F, Set.of(), 0, 0, null, Map.of(), -7L, target);
+            captured = BedrockActorQueries.sample(carrier, current, captured);
+            environment.queries(captured);
+            assertEquals(target == 0 ? 4 : 9, environment.evaluate(expression, 0));
+        }
+        assertEquals(true, captured.get("has_target"));
+        assertFalse(BedrockActorQueries.sample(carrier, legacy, captured).containsKey("has_target"));
+        assertFalse(BedrockActorQueries.sample(carrier, null, captured).containsKey("has_target"));
+        assertEquals(true, captured.get("has_target"));
+    }
+
+    @Test
+    void refreshesLivingStatusWithoutAnotherAnimationFrameOrSharedMutableQueries() throws Exception {
+        final var actor = mock(LivingEntity.class);
+        when(actor.getDeltaMovement()).thenReturn(Vec3.ZERO);
+        final var nativeState = state(Set.of(ActorFlags.SNEAKING, ActorFlags.RIDING, ActorFlags.SWIMMING,
+                ActorFlags.GLIDING, ActorFlags.SLEEPING, ActorFlags.USINGITEM));
+        final Map<String, Object> stale = Map.of("is_sneaking", false, "is_riding", false, "is_swimming", false,
+                "is_gliding", false, "is_sleeping", false, "is_using_item", false, "geometry_scale", 2F);
+        final var expression = BedrockMolang.Program.parse(JsonParser.parseString(
+                "\"q.is_sneaking+2*q.is_riding+4*q.is_swimming+8*q.is_gliding+16*q.is_sleeping+32*q.is_using_item\""), 0);
+        final var environment = new BedrockMolang();
+        Map<String, Object> first = null;
+        for (int bits = 0; bits < 64; bits++) {
+            when(actor.isShiftKeyDown()).thenReturn((bits & 1) != 0);
+            when(actor.isPassenger()).thenReturn((bits & 2) != 0);
+            when(actor.isSwimming()).thenReturn((bits & 4) != 0);
+            when(actor.isFallFlying()).thenReturn((bits & 8) != 0);
+            when(actor.isSleeping()).thenReturn((bits & 16) != 0);
+            when(actor.isUsingItem()).thenReturn((bits & 32) != 0);
+            final var queries = BedrockActorQueries.sample(actor, nativeState, stale);
+            environment.queries(queries);
+            assertEquals(bits, environment.evaluate(expression, 0));
+            assertEquals(2F, queries.get("geometry_scale"));
+            if (first == null) first = queries;
+        }
+        assertEquals(false, first.get("is_riding"));
+        assertEquals(false, stale.get("is_riding"));
+        assertThrows(UnsupportedOperationException.class, () -> BedrockActorQueries.sample(actor, nativeState, stale).clear());
+    }
+
+    @Test
+    void retainsNativeCarrierStatusAndReplacesRetiredMetadataWithoutARender() throws Exception {
+        final var carrier = mock(Entity.class);
+        when(carrier.getDeltaMovement()).thenReturn(Vec3.ZERO);
+        when(carrier.isPassenger()).thenReturn(true);
+        final var current = BedrockActorQueries.sample(carrier, state(Set.of(ActorFlags.SNEAKING, ActorFlags.SWIMMING,
+                ActorFlags.GLIDING, ActorFlags.SLEEPING, ActorFlags.USINGITEM, ActorFlags.CRAWLING,
+                ActorFlags.BABY, ActorFlags.SITTING, ActorFlags.SADDLED, ActorFlags.CHARGING,
+                ActorFlags.HAS_DASH_COOLDOWN)), Map.of());
+        final var environment = new BedrockMolang();
+        final var expression = BedrockMolang.Program.parse(JsonParser.parseString(
+                "\"q.is_sneaking+q.is_riding+q.is_swimming+q.is_gliding+q.is_sleeping+q.is_using_item"
+                        + "+q.is_crawling+q.is_baby+q.is_sitting+q.is_saddled+q.is_charging+q.has_dash_cooldown\""), 0);
+        environment.queries(current);
+        assertEquals(12, environment.evaluate(expression, 0));
+        when(carrier.isPassenger()).thenReturn(false);
+        environment.queries(BedrockActorQueries.sample(carrier, state(Set.of()), current));
+        assertEquals(0, environment.evaluate(expression, 0));
+        environment.queries(current);
+        assertEquals(12, environment.evaluate(expression, 0));
+        environment.queries(BedrockActorQueries.sample(carrier, null, current));
+        assertEquals(0, environment.evaluate(expression, 0));
+    }
+
+    private static NativeActorMessage.Snapshot state(final Set<ActorFlags> flags) {
+        return new NativeActorMessage.Snapshot(UUID.randomUUID(), UUID.randomUUID(), false, 1,
+                "test:carrier", "", 1, flags, 0, 0, null, Map.of());
+    }
+}
