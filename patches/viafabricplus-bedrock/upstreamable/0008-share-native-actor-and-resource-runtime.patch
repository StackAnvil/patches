+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.NativeActorPickingMessage;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockActorPickingStateTest {
+    @Test
+    void keepsIndependentExactRectanglesRatherThanTheirEnvelopeOrUnion() {
+        final var state = new BedrockActorPickingState();
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        final UUID proxy = UUID.randomUUID();
+        final var part = new NativeActorPickingMessage.Part(proxy, 1F, 2F, .25F);
+        final var second = new NativeActorPickingMessage.Part(UUID.randomUUID(), 1F, 2F, .25F);
+        assertTrue(state.apply(new NativeActorPickingMessage.Snapshot(owner, lifetime, List.of(part, second)), Map.of(owner, lifetime)::get, null));
+        final var box = BedrockActorPicking.bounds(10D, 20D, 30D, state.part(proxy, Map.of(owner, lifetime)::get));
+        assertEquals(1D, box.getXsize());
+        assertEquals(2D, box.getYsize());
+        assertEquals(.25D, box.getZsize());
+        assertTrue(box.clip(new Vec3(8D, 21D, 30.3D), new Vec3(12D, 21D, 30.3D)).isEmpty());
+        assertTrue(box.clip(new Vec3(8D, 21D, 30D), new Vec3(12D, 21D, 30D)).isPresent());
+        // The unchanged Java picker stops its ray at the occluding block or reach bound.
+        assertTrue(box.clip(new Vec3(8D, 21D, 30D), new Vec3(9D, 21D, 30D)).isEmpty());
+        final var other = BedrockActorPicking.bounds(14D, 20D, 30D, second);
+        assertTrue(box.clip(new Vec3(12D, 21D, 28D), new Vec3(12D, 21D, 32D)).isEmpty());
+        assertTrue(other.clip(new Vec3(12D, 21D, 28D), new Vec3(12D, 21D, 32D)).isEmpty());
+    }
+
+    @Test
+    void suppressesOriginalOnlyWhileCurrentPartsExistAndPreservesOwnerEligibility() {
+        final var state = new BedrockActorPickingState();
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        final UUID proxy = UUID.randomUUID();
+        final UUID camera = UUID.randomUUID();
+        final var lifetimes = new HashMap<>(Map.of(owner, lifetime));
+        state.apply(new NativeActorPickingMessage.Snapshot(owner, lifetime,
+                List.of(new NativeActorPickingMessage.Part(proxy, 1F, 2F, 1F))), lifetimes::get, camera);
+        assertFalse(state.eligible(owner, lifetimes::get, camera, uuid -> true));
+        assertTrue(state.eligible(proxy, lifetimes::get, camera, uuid -> uuid.equals(owner)));
+        assertFalse(state.eligible(proxy, lifetimes::get, owner, uuid -> true));
+        assertFalse(state.eligible(proxy, lifetimes::get, camera, uuid -> false));
+        lifetimes.clear();
+        assertFalse(state.eligible(proxy, lifetimes::get, camera, uuid -> true));
+        assertTrue(state.apply(new NativeActorPickingMessage.Remove(owner, lifetime), lifetimes::get, camera));
+        assertNull(state.proxyOwner(proxy, lifetimes::get));
+        lifetimes.put(owner, lifetime);
+        state.apply(new NativeActorPickingMessage.Snapshot(owner, lifetime, List.of()), lifetimes::get, camera);
+        assertTrue(state.eligible(owner, lifetimes::get, camera, uuid -> true));
+    }
+
+    @Test
+    void rejectsOldLifetimeCrossOwnerAliasesLocalPlayerAndQueuedOldConnectionUpdates() {
+        final var state = new BedrockActorPickingState();
+        final UUID owner = UUID.randomUUID();
+        final UUID lifetime = UUID.randomUUID();
+        final UUID proxy = UUID.randomUUID();
+        final UUID local = UUID.randomUUID();
+        final var part = new NativeActorPickingMessage.Part(proxy, 1F, 2F, 1F);
+        final var lifetimes = new HashMap<>(Map.of(owner, lifetime, local, UUID.randomUUID()));
+        final var snapshot = new NativeActorPickingMessage.Snapshot(owner, lifetime, List.of(part));
+        assertFalse(state.apply(new NativeActorPickingMessage.Snapshot(owner, UUID.randomUUID(), List.of(part)), lifetimes::get, local));
+        assertFalse(state.apply(new NativeActorPickingMessage.Snapshot(local, lifetimes.get(local), List.of(part)), lifetimes::get, local));
+        assertTrue(state.apply(snapshot, lifetimes::get, local));
+        final UUID other = UUID.randomUUID();
+        lifetimes.put(other, lifetime);
+        assertFalse(state.apply(new NativeActorPickingMessage.Snapshot(other, lifetime, List.of(part)), lifetimes::get, local));
+        final UUID nextLifetime = UUID.randomUUID();
+        lifetimes.put(owner, nextLifetime);
+        final UUID nextProxy = UUID.randomUUID();
+        assertTrue(state.apply(new NativeActorPickingMessage.Snapshot(owner, nextLifetime,
+                List.of(new NativeActorPickingMessage.Part(nextProxy, 2F, 3F, 1F))), lifetimes::get, local));
+        assertNull(state.proxyOwner(proxy, lifetimes::get));
+        assertFalse(state.apply(new NativeActorPickingMessage.Remove(owner, lifetime), lifetimes::get, local));
+        assertNotNull(state.proxyOwner(nextProxy, lifetimes::get));
+        final long beforeDisconnect = state.generation();
+        state.clear();
+        assertFalse(state.accept(beforeDisconnect, snapshot, lifetimes::get, local));
+        assertNull(state.proxyOwner(nextProxy, lifetimes::get));
+    }
+}
