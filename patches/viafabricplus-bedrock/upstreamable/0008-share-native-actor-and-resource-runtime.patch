+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.mojang.renderpearl.api.pipeline.BlendFactor;
+import com.mojang.renderpearl.api.pipeline.BlendFunction;
+import com.mojang.renderpearl.api.pipeline.ColorTargetState;
+import com.mojang.renderpearl.api.pipeline.RenderPipeline;
+import net.minecraft.client.renderer.RenderPipelines;
+import com.viaversion.viafabricplus.bedrock.render.BedrockShaderPipelines;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleRenderTypesTest {
+    @Test
+    void mapsForwardMaterialsToMatchingParticleShaderFamilies() {
+        for (final String material : List.of("particles_opaque", "particles_alpha", "particles_blend", "particles_add")) {
+            final var nativePipeline = BedrockParticleRenderTypes.pipeline(material);
+            final var expected = material.equals("particles_opaque") || material.equals("particles_alpha")
+                ? RenderPipelines.OPAQUE_PARTICLE : RenderPipelines.TRANSLUCENT_PARTICLE;
+            assertSame(expected, BedrockShaderPipelines.equivalent(nativePipeline));
+            assertEquals(expected.getVertexFormatBindings(), nativePipeline.getVertexFormatBindings());
+        }
+    }
+
+    @Test
+    void preservesNativeColorAndAlphaBlendingWithoutDepthWritesOrCulling() {
+        final var blend = BedrockParticleRenderTypes.pipeline("particles_blend");
+        final var additive = BedrockParticleRenderTypes.pipeline("particles_add");
+        assertEquals(new BlendFunction(BlendFactor.SRC_ALPHA, BlendFactor.ONE_MINUS_SRC_ALPHA,
+                BlendFactor.ONE, BlendFactor.ONE_MINUS_SRC_ALPHA), blend.getColorTargetStates().getFirst().blendFunction().orElseThrow());
+        assertEquals(new BlendFunction(BlendFactor.SRC_ALPHA, BlendFactor.ONE), additive.getColorTargetStates().getFirst().blendFunction().orElseThrow());
+        for (final var pipeline : List.of(blend, additive)) {
+            assertFalse(pipeline.isCull());
+            assertFalse(pipeline.getDepthStencilState().writeDepth());
+            assertEquals(ColorTargetState.WRITE_ALL, pipeline.getColorTargetStates().getFirst().writeMask());
+        }
+        for (final String material : List.of("particles_opaque", "particles_alpha")) {
+            final var pipeline = BedrockParticleRenderTypes.pipeline(material);
+            assertTrue(pipeline.isCull());
+            assertTrue(pipeline.getDepthStencilState().writeDepth());
+            assertTrue(pipeline.getColorTargetStates().getFirst().blendFunction().isEmpty());
+            assertEquals(ColorTargetState.WRITE_COLOR, pipeline.getColorTargetStates().getFirst().writeMask());
+            assertTrue(BedrockParticleRenderTypes.oit(material).isEmpty());
+        }
+    }
+
+    @Test
+    void retainsTheTransparencyStagesTargetsAndBindingsForBothMaterials() {
+        final var original = RenderPipelines.OIT_PARTICLE;
+        final var expected = List.of(original.depthBoundsPipeline(), original.transmittancePipeline(), original.accumulatePipeline());
+        for (final String material : List.of("particles_blend", "particles_add")) {
+            final var oit = BedrockParticleRenderTypes.oit(material).orElseThrow();
+            final var stages = List.of(oit.depthBoundsPipeline(), oit.transmittancePipeline(), oit.accumulatePipeline());
+            for (int i = 0; i < stages.size(); i++) {
+                final RenderPipeline stage = stages.get(i), template = expected.get(i);
+                assertEquals(template.getColorTargetStates(), stage.getColorTargetStates());
+                assertEquals(java.util.Set.copyOf(template.getBindGroupLayouts()), java.util.Set.copyOf(stage.getBindGroupLayouts()));
+                assertEquals(template.getVertexFormatBindings(), stage.getVertexFormatBindings());
+                assertEquals(template.getDepthStencilState().depthTest(), stage.getDepthStencilState().depthTest());
+                assertFalse(stage.getDepthStencilState().writeDepth());
+                assertFalse(stage.isCull());
+                assertTrue(BedrockParticleRenderTypes.PIPELINES.contains(stage));
+            }
+        }
+        assertEquals(10, BedrockParticleRenderTypes.PIPELINES.stream().map(RenderPipeline::getLocation).distinct().count());
+    }
+}
