+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.google.gson.JsonParser;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+final class BedrockActorScaleTest {
+    @Test
+    void uniformScaleOverridesAxesEvenWhenZeroAndDoesNotEvaluateTheirSideEffects() throws Exception {
+        final var graph = graph("""
+                {"scripts":{"initialize":["v.count=0;"],"pre_animation":["v.count=v.count+1;"],
+                  "scale":"v.count*q.amount","scaleX":"v.count=100;return 9;"}}
+                """);
+        final var playback = graph.playback();
+        playback.sample(0, new BedrockActorAnimation.Frame(Map.of("amount", 0), Map.of()));
+        assertEquals(vector(0, 0, 0), playback.scale());
+        playback.sample(1, new BedrockActorAnimation.Frame(Map.of("amount", -2), Map.of()));
+        assertEquals(vector(-4, -4, -4), playback.scale());
+        assertEquals(vector(-4, -4, -4), playback.scale());
+        playback.sample(2, new BedrockActorAnimation.Frame(Map.of("amount", -2), Map.of()));
+        assertEquals(vector(-6, -6, -6), playback.scale());
+    }
+
+    @Test
+    void evaluatesAxesInNativeOrderWithSampledVariablesAndDefaultsMissingAxes() throws Exception {
+        final var playback = graph("""
+                {"scripts":{"pre_animation":["v.count=4;"],
+                 "scaleZ":"v.count=v.count+1;return -v.count;",
+                 "scaleY":"v.count=v.count+1;return v.count;", "scaleX":"v.count"}}
+                """).playback();
+        playback.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(vector(6, 6, -5), playback.scale());
+        assertEquals(vector(8, 8, -7), playback.scale());
+        final var missing = graph("""
+                {"scripts":{"scaleY":0}}
+                """).playback();
+        missing.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of()));
+        assertEquals(vector(1, 0, 1), missing.scale());
+        assertEquals(vector(1, 1, 1), graph("{}").playback().scale());
+    }
+
+    @Test
+    void keepsPerspectiveScopesIndependentAndReinitializesAfterTimeRewind() throws Exception {
+        final var body = graph("""
+                {"scripts":{"initialize":["v.count=2;"],"pre_animation":["v.count=v.count+1;"],
+                 "scale":"v.count+c.is_first_person"}}
+                """).playback();
+        final var hands = body.fork();
+        final var bodyFrame = new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 0));
+        final var handFrame = new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 1));
+        body.sample(0, bodyFrame);
+        hands.sample(0, handFrame);
+        assertEquals(vector(3, 3, 3), body.scale());
+        assertEquals(vector(4, 4, 4), hands.scale());
+        hands.sample(2, handFrame);
+        assertEquals(vector(5, 5, 5), hands.scale());
+        hands.sample(0, handFrame);
+        assertEquals(vector(4, 4, 4), hands.scale());
+        assertEquals(vector(3, 3, 3), body.scale());
+    }
+
+    private static BedrockActorAnimation graph(final String entity) throws Exception {
+        return BedrockActorAnimation.read(JsonParser.parseString(entity).getAsJsonObject(), Map.of(),
+                JsonParser.parseString("{}").getAsJsonObject(), JsonParser.parseString("{}").getAsJsonObject(), "1.10.0");
+    }
+
+    private static BedrockBoneAnimation.Vector vector(final float x, final float y, final float z) {
+        return new BedrockBoneAnimation.Vector(x, y, z);
+    }
+}
