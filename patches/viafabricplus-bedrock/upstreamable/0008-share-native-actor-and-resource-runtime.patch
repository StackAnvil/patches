+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void playsTheExtractedWaterDripSplashFlow() throws Exception {
+        final Path root = Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"), "decoded-particles");
+        final var drip = BedrockParticleEffect.read(JsonParser.parseString(Files.readString(root.resolve("water_drip.json"))).getAsJsonObject())
+                .emitter(new BedrockMolang(), new Random(4), Vec3.ZERO);
+        final List<BedrockParticleEvents.Action> dripActions = new java.util.ArrayList<>();
+        drip.dispatcher(dripActions::add);
+        assertTrue(drip.emit(new Vector3f(.5F, .2F, .5F), new Vector3f(0, -3, 0), 100));
+        final BedrockParticleCollision.Terrain terrain = (x, y, z) -> x == 0 && y == -1 && z == 0
+                ? List.of(new BedrockParticleCollision.Box(0, -1, 0, 1, 0, 1)) : List.of();
+        for (int step = 0; step < 40 && drip.size() != 0; step++) drip.advance(100_000_000, 100, null, terrain);
+        final var events = BedrockParticleEventsTest.drain(dripActions).stream().map(action -> assertInstanceOf(BedrockParticleEvents.Request.class, action)).toList();
+        assertEquals(3, events.size());
+        assertEquals(0, drip.size());
+        final var splash = BedrockParticleEffect.read(JsonParser.parseString(Files.readString(root.resolve("rain_splash.json"))).getAsJsonObject())
+                .emitter(new BedrockMolang(), new Random(4), BedrockParticleAttachment.Matrix.IDENTITY,
+                        (x, y, z) -> y >= 0 ? "minecraft:air" : "minecraft:stone");
+        for (final var event : events) {
