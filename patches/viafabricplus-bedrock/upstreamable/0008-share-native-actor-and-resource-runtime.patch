+    private int[] entityEngineVersion() throws IOException {
+        final int[] target = engineVersion(new JsonPrimitive(ProtocolConstants.BEDROCK_VERSION_NAME));
+        for (final Pack pack : this.packs.reversed()) {
+            final byte[] manifest = pack.files.get("manifest.json");
