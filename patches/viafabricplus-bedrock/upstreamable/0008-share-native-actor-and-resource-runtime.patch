@@ -0,0 +1,87 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.network.Connection;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.material.FluidState;
+import net.minecraft.world.level.material.Fluids;
+import net.raphimc.viabedrock.api.model.NativeBlockIdentifiers;
+import net.raphimc.viabedrock.api.model.NativeBlockView;
+
+/** Client lifecycle adapter for the core's authoritative block mirror. */
+public final class BedrockNativeBlocks {
+    private static final NativeBlockView VIEW = new NativeBlockView();
+    private static final BedrockNativeBlockUpdates UPDATES = new BedrockNativeBlockUpdates(VIEW);
+    private static volatile ClientLevel level;
+    private static volatile long generation;
+
+    private BedrockNativeBlocks() {}
+
+    public static void accept(final Connection connection, final NativeBlockIdentifiers message) {
+        final Minecraft minecraft = Minecraft.getInstance();
+        final long receivedGeneration = generation;
+        minecraft.execute(() -> {
+            final var listener = minecraft.getConnection();
+            if (receivedGeneration != generation || minecraft.level == null || !connection.isConnected()
+                    || listener == null || listener.getConnection() != connection) return;
+            synchronizeLevel(minecraft);
+            final var dirty = UPDATES.accept(message);
+            // A new Java chunk will invalidate its own sections when its packet follows the native snapshot.
+            if (dirty != null && (!(message instanceof NativeBlockIdentifiers.Section section)
+                    || minecraft.level.hasChunk(section.chunkX(), section.chunkZ()))) {
+                minecraft.level.setSectionRangeDirty(dirty.minX(), dirty.minY(), dirty.minZ(), dirty.maxX(), dirty.maxY(), dirty.maxZ());
+            }
+        });
+    }
+
+    public static void clear() {
+        final Minecraft minecraft = Minecraft.getInstance();
+        final long clearedGeneration = ++generation;
+        minecraft.execute(() -> {
+            if (generation != clearedGeneration) return;
+            UPDATES.clear();
+            level = null;
+        });
+    }
+
+    /** Exact native runtime identity and properties for either block layer on the client thread. */
+    public static NativeBlockIdentifiers.Name state(final int x, final int y, final int z, final int layer) {
+        synchronizeLevel(Minecraft.getInstance());
+        return VIEW.state(x, y, z, layer);
+    }
+
+    /** Worker-safe fluid query. Null retains vanilla behavior until this world's native mirror is ready. */
+    public static FluidState fluidState(final Level owner, final int x, final int y, final int z) {
+        if (owner == null || owner != level) return null;
+        return decodeFluid(VIEW.fluidJavaId(x, y, z));
+    }
+
+    static FluidState decodeFluid(final Integer javaId) {
+        if (javaId == null) return null;
+        if (javaId == -1) return Fluids.EMPTY.defaultFluidState();
+        final var state = Block.BLOCK_STATE_REGISTRY.byId(javaId);
+        if (state == null) return null;
+        final var fluid = state.getFluidState();
+        return fluid.getType() == Fluids.WATER || fluid.getType() == Fluids.FLOWING_WATER
+                || fluid.getType() == Fluids.LAVA || fluid.getType() == Fluids.FLOWING_LAVA ? fluid : null;
+    }
+
+    static BedrockParticleBlocks.World world() {
+        final Minecraft minecraft = Minecraft.getInstance();
+        synchronizeLevel(minecraft);
+        return VIEW.ready() ? VIEW::block : null;
+    }
+
+    private static void synchronizeLevel(final Minecraft minecraft) {
+        if (level == minecraft.level) return;
+        UPDATES.clear();
+        level = minecraft.level;
+    }
+}
