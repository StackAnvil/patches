+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockParticleInterpolationTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_INTERPOLATION_REFERENCE", matches = ".+")
+    void matchesExecutedNativeCounterAndStartupSchedules() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_PARTICLE_INTERPOLATION_REFERENCE"), "native-cadence-results.json"))).getAsJsonObject();
+        int frames = 0;
+        for (final var item : fixture.getAsJsonArray("cases")) {
+            final var row = item.getAsJsonObject();
+            final var interpolation = new BedrockParticleInterpolation(row.get("frames").getAsInt());
+            final long duration = row.get("duration").getAsLong();
+            for (final var entry : row.getAsJsonArray("steps")) {
+                final var expected = entry.getAsJsonObject();
+                final var update = interpolation.update(expected.get("nanos").getAsLong());
+                assertEquals(expected.get("updated").getAsBoolean(), update.isPresent());
+                if (update.isPresent()) assertEquals(expected.get("elapsed").getAsLong(), update.getAsLong());
+                final var frame = interpolation.render(duration > 0 && duration < 150_000_001);
+                assertEquals(expected.get("visible").getAsBoolean(), frame.visible());
+                assertEquals(expected.get("motionAlpha").getAsFloat(), frame.motionAlpha());
+                assertEquals(expected.get("appearanceAlpha").getAsFloat(), frame.appearanceAlpha());
+                final var prepares = expected.getAsJsonArray("prepare");
+                assertEquals(frame.force() ? 2 : 1, prepares.size());
+                assertEquals(prepares.get(0).getAsBoolean(), frame.refresh());
+                if (frame.force()) assertTrue(prepares.get(1).getAsBoolean());
+                frames++;
+            }
+        }
+        assertEquals(240, frames);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_INTERPOLATION_REFERENCE", matches = ".+")
+    void matchesExecutedNativeFloatAppearanceProducts() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(
+                System.getenv("STACKANVIL_PARTICLE_INTERPOLATION_REFERENCE"), "native-appearance-results.json"))).getAsJsonObject();
+        int cases = 0;
+        for (final var entry : fixture.getAsJsonArray("cases")) {
+            final var row = entry.getAsJsonObject();
+            final var previous = row.getAsJsonArray("previous");
+            final var current = row.getAsJsonArray("current");
+            final var expected = row.getAsJsonArray("values");
+            for (int component = 0; component < expected.size(); component++) {
+                final float alpha = row.get(component == 0 ? "motionAlpha" : "appearanceAlpha").getAsFloat();
+                assertEquals(expected.get(component).getAsFloat(), BedrockParticleInterpolation.blend(
+                        previous.get(component).getAsFloat(), current.get(component).getAsFloat(), alpha));
+            }
+            cases++;
+        }
+        assertEquals(72, cases);
+    }
+
+    @Test
+    void interpolatesMotionAppearanceAndFloatTintWhileKeepingCurrentUvs() throws Exception {
+        final var components = components();
+        components.add("minecraft:particle_initial_speed", JsonParser.parseString("[2,0,0]"));
+        components.add("minecraft:particle_initial_spin", json("{\"rotation_rate\":90}"));
+        components.add("minecraft:particle_motion_dynamic", new JsonObject());
+        components.add("minecraft:particle_appearance_billboard", json("""
+                {"size":["v.particle_age",1],"uv":{"texture_width":100,"texture_height":100,
+                 "uv":["v.particle_age*100",0],"uv_size":[1,1]}}
+                """));
+        components.add("minecraft:particle_appearance_tinting", json("{\"color\":[\"v.particle_age\",0,0,1]}"));
+        final var emitter = emitter(components);
+        final var interpolation = new BedrockParticleInterpolation(2);
+        final List<List<BedrockParticleEffect.Visual>> visuals = new java.util.ArrayList<>();
+        for (int index = 0; index < 4; index++) {
+            final var update = interpolation.update(30_000_000);
+            if (update.isPresent()) emitter.advance(update.getAsLong(), 100, null, (x, y, z) -> List.of());
+            visuals.add(emitter.visuals(interpolation.render(emitter.shortLived())));
+        }
+        assertTrue(visuals.get(0).isEmpty());
+        assertTrue(visuals.get(1).isEmpty());
+        final var previous = visuals.get(2).getFirst();
+        final var halfway = visuals.get(3).getFirst();
+        assertEquals(.06F, previous.position().x, 1e-7F);
+        assertEquals(.12F, halfway.position().x, 1e-7F);
+        assertEquals(.03F, previous.width());
+        assertEquals(.06F, halfway.width(), 1e-7F);
+        assertEquals(2.7F, previous.rotation(), 1e-6F);
+        assertEquals(5.4F, halfway.rotation(), 1e-6F);
+        assertEquals(.09F, previous.u0(), 1e-7F);
+        assertEquals(previous.u0(), halfway.u0());
+        assertEquals(15, halfway.color() >>> 16 & 255);
+    }
+
+    @Test
+    void capsIncomingFramesBeforeAccumulationAndInitializesNewbornHistoryAfterMotion() throws Exception {
+        final var components = components();
+        components.add("minecraft:particle_initial_speed", JsonParser.parseString("[2,0,0]"));
+        components.add("minecraft:particle_motion_dynamic", new JsonObject());
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":0.15}"));
+        final var emitter = emitter(components);
+        final var interpolation = new BedrockParticleInterpolation(2);
+        final var first = interpolation.update(200_000_000);
+        emitter.advance(first.orElseThrow(), 100, null, (x, y, z) -> List.of());
+        final var initial = emitter.visuals(interpolation.render(emitter.shortLived())).getFirst();
+        assertEquals(new Vector3f(.2F, 0, 0), initial.position());
+        assertTrue(interpolation.update(100_999_999).isEmpty());
+        emitter.visuals(interpolation.render(emitter.shortLived()));
+        final long accumulated = interpolation.update(101_000_000).orElseThrow();
+        assertEquals(200_999_999, accumulated);
+        emitter.advance(accumulated, 100, null, (x, y, z) -> List.of());
+        final var previous = emitter.visuals(interpolation.render(emitter.shortLived())).getFirst();
+        assertEquals(initial.position(), previous.position());
+        assertTrue(interpolation.update(0).isEmpty());
+        final var halfway = emitter.visuals(interpolation.render(emitter.shortLived())).getFirst();
+        assertEquals(.40099996F, halfway.position().x, 1e-7F);
+    }
+
+    @Test
+    void preparesShortStartupTwiceAndNewManualParticlesOnSkippedAppearanceFrames() throws Exception {
+        final var components = components();
+        components.remove("minecraft:emitter_rate_instant");
+        components.add("minecraft:emitter_rate_manual", json("{\"max_particles\":10}"));
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":0.15}"));
+        components.add("minecraft:particle_initialization", json("{\"per_render_expression\":\"v.renders=(v.renders??0)+1;\"}"));
+        components.add("minecraft:particle_appearance_billboard", json("{\"size\":[\"v.renders\",1]}"));
+        final var emitter = emitter(components);
+        final var interpolation = new BedrockParticleInterpolation(2);
+        assertTrue(emitter.emit(new Vector3f(5, 0, 0), new Vector3f(), 100));
+        emitter.advance(interpolation.update(0).orElseThrow(), 100, null, (x, y, z) -> List.of());
+        final var first = emitter.visuals(interpolation.render(emitter.shortLived())).getFirst();
+        assertEquals(1, first.width()); // Second preparation replaces current appearance, alpha remains zero.
+        assertEquals(new Vector3f(5, 0, 0), first.position());
+        interpolation.update(0);
+        assertTrue(emitter.emit(new Vector3f(7, 0, 0), new Vector3f(), 100));
+        final var next = emitter.visuals(interpolation.render(emitter.shortLived()));
+        assertEquals(2.5F, next.get(0).width());
+        assertEquals(1.5F, next.get(1).width());
+        assertEquals(new Vector3f(7, 0, 0), next.get(1).position());
+    }
+
+    private static JsonObject components() {
+        final var components = BedrockParticleEffectTest.burst().getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:emitter_rate_instant", json("{\"num_particles\":1}"));
+        components.add("minecraft:particle_lifetime_expression", json("{\"max_lifetime\":10}"));
+        components.add("minecraft:emitter_shape_point", new JsonObject());
+        return components;
+    }
+
+    private static BedrockParticleEffect.Emitter emitter(final JsonObject components) throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        document.getAsJsonObject("particle_effect").add("components", components);
+        return BedrockParticleEffect.read(document).emitter(new BedrockMolang(), new Random(1), Vec3.ZERO);
+    }
+
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+}
