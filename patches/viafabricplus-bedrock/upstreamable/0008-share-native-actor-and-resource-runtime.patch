+        };
+    }
+
+    record Choice(int tag, Layout layout) {}
+
+    static Choice choice(final int tag, final Layout layout) {
+        return new Choice(tag, layout);
+    }
+
+    static Layout variant(final Choice... choices) {
+        final Map<Integer, Layout> definitions = new LinkedHashMap<>();
+        for (final Choice choice : choices) definitions.put(choice.tag, choice.layout);
+        return reader -> {
+            final Layout selected = definitions.get(Byte.toUnsignedInt(reader.data.get()));
