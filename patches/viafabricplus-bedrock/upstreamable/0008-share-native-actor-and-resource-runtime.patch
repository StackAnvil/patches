+final class BedrockMolangColorTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeFloat32ChannelsThroughNestedQueryAccessAndStructCopies() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-spellcolor-query-result.json"))).getAsJsonObject();
+        for (final var raw : fixture.getAsJsonArray("cases")) {
+            final var row = raw.getAsJsonObject();
+            final boolean present = row.get("actor").getAsBoolean() && row.get("metadata").getAsBoolean()
+                    && row.get("span_bytes").getAsInt() >= 0x270 && row.get("type").getAsInt() == 2;
+            final var color = present ? BedrockMolangColor.fromArgb((int) row.get("argb").getAsLong()) : BedrockMolangColor.ZERO;
+            final var environment = new BedrockMolang();
+            environment.queries(Map.of("spellcolor", (BedrockActorAnimation.Query) _ -> color));
+            evaluate(environment, "v.color=q.spellcolor;");
+            final List<String> channels = List.of("r", "g", "b", "a");
+            for (int index = 0; index < 4; index++) {
+                final String channel = channels.get(index);
+                final float expected = row.getAsJsonArray("rgba").get(index).getAsFloat();
+                assertEquals(expected, evaluate(environment, "query.spellcolor." + channel), row.toString());
+                assertEquals(expected, evaluate(environment, "q.spellcolor()." + channel), row.toString());
+                assertEquals(expected, evaluate(environment, "v.color." + channel), row.toString());
+            }
+        }
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesNativeRefreshedActorAndRegistryContexts() throws Exception {
+        final var fixture = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"),
+                "native-spellcolor-context-result.json"))).getAsJsonObject();
+        for (final var raw : fixture.getAsJsonArray("cases")) {
+            final var row = raw.getAsJsonObject();
+            final boolean actor = row.get("actor_bound").getAsBoolean();
+            final var color = row.get("metadata").getAsBoolean() && row.get("type").getAsInt() == 2
+                    ? BedrockMolangColor.fromArgb((int) row.get("argb").getAsLong()) : BedrockMolangColor.ZERO;
+            final var attachment = actor
+                    ? new BedrockParticleAttachment(Vec3.ZERO, 180, null, null, Map.of("spellcolor", color))
+                    : row.get("binding").getAsString().equals("none") ? null
+                    : BedrockParticleAttachment.registry(Vec3.ZERO, Vec3.ZERO, 0, 0, 0, null);
+            final var environment = new BedrockMolang();
+            environment.queries(BedrockParticleQueries.sample(attachment, new Vector3f(), Vec3.ZERO));
+            for (int index = 0; index < 4; index++)
+                assertEquals(row.getAsJsonArray("rgba").get(index).getAsFloat(),
+                        evaluate(environment, "q.spellcolor." + List.of("r", "g", "b", "a").get(index)), row.toString());
+        }
+        assertEquals(60, fixture.getAsJsonArray("cases").size());
+    }
+
+    @Test
+    void refreshesParticleTintFromLiveActorColorAndUsesZeroWithoutAnActor() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var components = document.getAsJsonObject("particle_effect").getAsJsonObject("components");
+        components.add("minecraft:emitter_local_space", JsonParser.parseString("{\"position\":false}"));
+        components.add("minecraft:particle_appearance_tinting", JsonParser.parseString("""
+                {"color":["q.spellcolor.r", "q.spellcolor.g", "q.spellcolor.b", "q.spellcolor.a"]}
+                """));
+        components.add("minecraft:emitter_initialization", JsonParser.parseString("""
+                {"creation_expression":"v.birth=q.spellcolor.r;"}
+                """));
+        final var color = new AtomicInteger(0x40102030);
+        final var attachment = new BedrockParticleAttachment(Vec3.ZERO, 180, null, null,
+                Map.of("spellcolor", (BedrockActorAnimation.Query) _ -> BedrockMolangColor.fromArgb(color.get())));
+        final var environment = new BedrockMolang();
+        environment.variable("retained", 7);
+        environment.queries(attachment.queries());
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1), Vec3.ZERO);
+        assertEquals(0, evaluate(environment, "v.birth"));
+        emitter.queryContext(attachment, Vec3.ZERO);
+        emitter.initialize(BedrockMolang.Program.parse(new JsonPrimitive("v.live=q.spellcolor.r;"), 0));
+        assertEquals(0x10 / 255F, evaluate(environment, "v.live"));
+        emitter.advance(0, 10, attachment, (x, y, z) -> List.of());
+        assertEquals(2, emitter.size());
+        assertEquals(color.get(), BedrockParticleEffectTest.sample(emitter).getFirst().color());
+        color.set(0xff89abcd);
+        assertEquals(color.get(), BedrockParticleEffectTest.sample(emitter).getFirst().color());
+        emitter.queryContext(null, Vec3.ZERO);
+        assertEquals(0, BedrockParticleEffectTest.sample(emitter).getFirst().color());
+        assertEquals(7, evaluate(environment, "v.retained"));
+        final var missing = new BedrockMolang();
+        missing.queries(BedrockParticleQueries.sample(null, new Vector3f(), Vec3.ZERO));
+        assertEquals(0, evaluate(missing, "q.spellcolor.r+q.spellcolor.g+q.spellcolor.b+q.spellcolor.a"));
+    }
+
+    private static float evaluate(final BedrockMolang environment, final String expression) throws java.io.IOException {
+        return environment.evaluate(BedrockMolang.Program.parse(new JsonPrimitive(expression), 0), 0);
+    }
+}
