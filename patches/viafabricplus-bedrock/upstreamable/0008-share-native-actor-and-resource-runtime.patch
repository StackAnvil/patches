+package com.viaversion.viafabricplus.bedrock.render;
+
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+
+/** Keeps unsupported dedicated item renderers in one coherent hand and camera path. */
+final class BedrockFirstPersonItemRendering {
+    private BedrockFirstPersonItemRendering() {}
+
+    static boolean usesJavaRenderer(final ItemStack main, final ItemStack off, final ItemStack active) {
+        return main.is(Items.FILLED_MAP) || off.is(Items.FILLED_MAP) || active.is(Items.CROSSBOW);
+    }
+
+    static int animationFrame(final ItemStack stack) {
+        if (!stack.is(Items.CROSSBOW)) return 0;
+        final var projectiles = stack.get(DataComponents.CHARGED_PROJECTILES);
+        if (projectiles == null || projectiles.isEmpty()) return 0;
+        // The target-native crossbow controller's array stores arrow and rocket at4 and5.
+        return projectiles.contains(Items.FIREWORK_ROCKET) ? 5 : 4;
+    }
+}
