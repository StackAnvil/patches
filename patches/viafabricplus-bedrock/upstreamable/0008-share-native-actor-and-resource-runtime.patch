+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonParser;
+
+import org.junit.jupiter.api.Test;
+import net.raphimc.viabedrock.protocol.model.ItemAnimationData;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+final class BedrockItemAnimationTest {
+    private static Object query(
+            final Map<String, Object> queries, final String name, final List<Object> arguments) {
+        final Object supplied = queries.get(name);
+        return supplied instanceof BedrockActorAnimation.Query function
+                ? function.evaluate(arguments)
+                : supplied;
+    }
+
+    @Test
+    void preservesElapsedTicksAcrossDifferentNativeAndJavaUseClocks() {
+        final int nativeMax = 1440000;
+        final int javaMax = 72000;
+        final var spear = new BedrockItemAnimation.Item("wooden_spear", nativeMax, false, ItemAnimationData.EMPTY);
+        for (final int elapsed : new int[]{0, 1, 19, 1000, javaMax - 1}) {
+            final int remaining = BedrockItemAnimation.remainingTicks(nativeMax, javaMax, javaMax - elapsed, true);
+            assertEquals(elapsed, nativeMax - remaining);
+            final var queries = new BedrockItemAnimation(spear, BedrockItemAnimation.Item.EMPTY,
+                    spear, BedrockItemAnimation.Item.EMPTY, remaining).queries();
+            assertEquals(nativeMax, queries.get("main_hand_item_max_duration"));
+            assertEquals(remaining, queries.get("main_hand_item_use_duration"));
+            assertEquals((float) remaining / nativeMax,
+                    query(queries, "item_remaining_use_duration", List.of(1)));
+        }
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, javaMax, false));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, 0, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(nativeMax, javaMax, -1, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(0, javaMax, javaMax, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(32, javaMax, javaMax - 33, true));
+        assertEquals(16, BedrockItemAnimation.remainingTicks(32, 32, 16, true));
+        assertEquals(Integer.MAX_VALUE, BedrockItemAnimation.remainingTicks(Integer.MAX_VALUE, 0, 1, true));
+        assertEquals(0, BedrockItemAnimation.remainingTicks(32, Integer.MAX_VALUE, 1, true));
+    }
+
+    @Test
+    void freezesAllEquipmentSlotsAndReadsOnlyMainHandKineticData() {
+        final var metadata = new ItemAnimationData(1440000, List.of("probe:one", "probe:two"), 13,
+                new ItemAnimationData.KineticWeapon(15, 300, 200, 100));
+        final var tagged = BedrockItemAnimation.Item.fromIdentifiers("probe:spear", "paper", 72000, false, metadata);
+        final var slots = new java.util.HashMap<String, BedrockItemAnimation.Item>();
+        for (final String slot : List.of("slot.weapon.mainhand", "slot.weapon.offhand", "slot.armor.head",
+                "slot.armor.chest", "slot.armor.legs", "slot.armor.feet", "slot.armor.body")) slots.put(slot, tagged);
+        final var queries = BedrockItemAnimation.equipmentQueries(slots);
