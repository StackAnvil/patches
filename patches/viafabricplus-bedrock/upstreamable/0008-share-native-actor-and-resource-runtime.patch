+                    final var last = events.get(events.size() - 1).getAsJsonObject();
+                    assertEquals(
+                            last.get("clock").getAsFloat(),
+                            molang.evaluate(eventTime, 0),
+                            0.000001F);
+                    assertEquals(
+                            last.get("delta").getAsFloat(),
+                            molang.evaluate(eventDelta, 0),
+                            0.000001F);
+                }
+                previous = elapsed;
+            }
+        }
+    }
+
+    @Test
+    void rejectsAmbiguousKeysAndInvalidPrograms() {
+        assertThrows(
+                IOException.class,
+                () ->
+                        animation(
+                                """
+                                {"bones":{"head":{"rotation":{"0":[0,0,0],"0.0":[1,2,3]}}}}
+                                """));
+        assertThrows(
+                IOException.class,
+                () ->
+                        animation(
+                                """
+                                {"bones":{"head":{"rotation":"q.anim_time + )"}}}
+                                """));
+    }
+}
