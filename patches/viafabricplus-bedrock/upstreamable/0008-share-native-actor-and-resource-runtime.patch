+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.function.Function;
+
+/** Resolves child definitions before playback, including cycles and unavailable handles. */
+final class BedrockParticleGraph {
+    private BedrockParticleGraph() {}
+
+    static CompletableFuture<Void> load(final String root, final int limit,
+            final Function<String, CompletableFuture<Set<String>>> resolver, final Executor executor) {
+        return load(List.of(root), limit, new LinkedHashSet<>(), resolver, executor);
+    }
+
+    private static CompletableFuture<Void> load(final List<String> names, final int limit, final Set<String> visited,
+            final Function<String, CompletableFuture<Set<String>>> resolver, final Executor executor) {
+        final List<CompletableFuture<Set<String>>> pending = new ArrayList<>();
+        for (final String name : names) {
+            if (!visited.add(name)) continue;
+            if (visited.size() > limit)
+                return CompletableFuture.failedFuture(new IOException("Particle dependency graph exceeds its limit"));
+            // Missing child handles suppress that child, not the source event's expression.
+            pending.add(resolver.apply(name).handle((children, error) -> error == null ? children : Set.of()));
+        }
+        if (pending.isEmpty()) return CompletableFuture.completedFuture(null);
+        return CompletableFuture.allOf(pending.toArray(CompletableFuture[]::new)).thenComposeAsync(_ -> {
+            final Set<String> children = new LinkedHashSet<>();
+            for (final var future : pending) children.addAll(future.join());
+            children.removeAll(visited);
+            return load(List.copyOf(children), limit, visited, resolver, executor);
+        }, executor);
+    }
+}
