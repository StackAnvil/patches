+        assertEquals(0, emitter.size());
+        final var events = BedrockParticleEventsTest.drain(emitterActions).stream().map(action -> assertInstanceOf(BedrockParticleEvents.Request.class, action)).toList();
+        assertEquals(2, events.size());
+        for (final var event : events) {
+            assertEquals(new Vector3f(20, 1, 0), event.velocity());
