+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import com.viaversion.viaversion.api.minecraft.BlockPosition;
+import net.raphimc.viabedrock.api.model.NativeBlockIdentifiers;
+import net.raphimc.viabedrock.api.model.NativeBlockSection;
+import net.raphimc.viabedrock.api.model.NativeBlockView;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockNativeBlockUpdatesTest {
+    @Test
+    void invalidatesFluidChangesAcrossSectionBoundariesWithoutRepeatingEquivalentUpdates() {
+        final var view = new NativeBlockView();
+        final var updates = new BedrockNativeBlockUpdates(view);
+        final var position = new BlockPosition(-17, -1, -33);
+        assertNull(updates.accept(new NativeBlockIdentifiers.Reset(0, -64, 384, 0)));
+        assertNull(updates.accept(new NativeBlockIdentifiers.Dictionary(0, List.of(
+                new NativeBlockIdentifiers.Name(1, "minecraft:bedrock", Map.of(), -1),
+                new NativeBlockIdentifiers.Name(2, "minecraft:water", Map.of(), 100),
+                new NativeBlockIdentifiers.Name(3, "minecraft:water", Map.of(), 100)))));
+        assertEquals(new BedrockNativeBlockUpdates.SectionRange(-3, -2, -4, -1, 0, -2), updates.accept(
+                new NativeBlockIdentifiers.Section(0, -2, -1, -3, 0, NativeBlockSection.create(index -> 1))));
+        final var boundary = new BedrockNativeBlockUpdates.SectionRange(-2, -1, -3, -1, 0, -2);
+        assertEquals(boundary, updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 2)));
+        final var withinTwoCells = new BlockPosition(-18, -1, -34);
+        assertEquals(boundary, updates.accept(new NativeBlockIdentifiers.Update(0, withinTwoCells, 1, 2)));
+        assertNull(updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 2)));
+        assertNull(updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 3)));
+        assertEquals(3, view.state(position.x(), position.y(), position.z(), 1).state());
+        assertNull(updates.accept(new NativeBlockIdentifiers.Update(1, position, 1, 0)));
+        assertEquals(100, view.fluidJavaId(position.x(), position.y(), position.z()));
+        assertEquals(boundary, updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 0)));
+        assertEquals(new BedrockNativeBlockUpdates.SectionRange(-3, -5, -4, -1, 20, -2),
+                updates.accept(new NativeBlockIdentifiers.Forget(0, -2, -3)));
+        updates.clear();
+        assertFalse(view.ready());
+        assertNull(updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 2)));
+        updates.accept(new NativeBlockIdentifiers.Reset(1, -64, 384, 0));
+        assertNull(updates.accept(new NativeBlockIdentifiers.Section(0, -2, -1, -3, 0, NativeBlockSection.create(index -> 2))));
+        assertEquals(-1, view.fluidJavaId(position.x(), position.y(), position.z()));
+    }
+
+    @Test
+    void keepsTheDirtyRegionBoundedAtTheIntegerCoordinateLimits() {
+        final var view = new NativeBlockView();
+        final var updates = new BedrockNativeBlockUpdates(view);
+        updates.accept(new NativeBlockIdentifiers.Reset(0, 0, 16, 0));
+        updates.accept(new NativeBlockIdentifiers.Dictionary(0, List.of(
+                new NativeBlockIdentifiers.Name(1, "minecraft:water", Map.of(), 100))));
+        final var position = new BlockPosition(Integer.MAX_VALUE, 15, Integer.MIN_VALUE);
+        updates.accept(new NativeBlockIdentifiers.Section(0, position.x() >> 4, 0, position.z() >> 4,
+                0, NativeBlockSection.create(index -> 0)));
+        final var dirty = updates.accept(new NativeBlockIdentifiers.Update(0, position, 1, 1));
+        assertEquals(Integer.MAX_VALUE >> 4, dirty.minX());
+        assertEquals(dirty.minX(), dirty.maxX());
+        assertEquals(Integer.MIN_VALUE >> 4, dirty.minZ());
+        assertEquals(dirty.minZ(), dirty.maxZ());
+        assertEquals(0, dirty.minY());
+        assertEquals(1, dirty.maxY());
+    }
+}
