@@ -0,0 +1,120 @@
+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Random;
+
+final class BedrockParticleCurvesTest {
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_PARTICLE_REFERENCE", matches = ".+")
+    void matchesCurvesExecutedFromTheTargetClient() throws Exception {
+        final var fixture = json(Files.readString(Path.of(System.getenv("STACKANVIL_PARTICLE_REFERENCE"))
+                .resolve("native-particle-curves-result.json")));
+        for (final var element : fixture.getAsJsonArray("cases")) {
+            final var row = element.getAsJsonObject();
+            final var curve = new JsonObject();
+            curve.add("type", row.get("type"));
+            curve.add("nodes", row.get("nodes"));
+            curve.add("input", row.get("input"));
+            if (row.has("range")) curve.add("horizontal_range", row.get("range"));
+            final var curves = new JsonObject();
+            curves.add("variable.native", curve);
+            final var environment = new BedrockMolang();
+            environment.variable("native", 7);
+            BedrockParticleCurves.read(curves).apply(environment);
+            final float expected = row.get("value").isJsonNull() ? 7 : row.get("value").getAsFloat();
+            assertEquals(expected, evaluate(environment, "v.native"), row.toString());
+        }
+    }
+
+    @Test
+    void evaluatesCurvesBeforeRenderScriptsWithSeparateParticleState() throws Exception {
+        final var document = BedrockParticleEffectTest.burst();
+        final var effect = document.getAsJsonObject("particle_effect");
+        effect.add("curves", json("""
+                {"variable.size":{"type":"linear","nodes":[0,2],"input":"v.particle_age"}}
+                """));
+        final var components = effect.getAsJsonObject("components");
+        components.add("minecraft:particle_initialization", json("""
+                {"creation_expression":"v.renders=0;","per_render_expression":"v.renders=v.renders+1;v.size=v.size+v.renders;"}
+                """));
+        components.add("minecraft:particle_appearance_billboard", json("""
+                {"size":["v.size",0.25]}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("size", 99);
+        final var emitter = BedrockParticleEffect.read(document).emitter(environment, new Random(1), Vec3.ZERO);
+        emitter.advance(100_000_000, 10, null, (x, y, z) -> List.of());
+        for (final var visual : BedrockParticleEffectTest.sample(emitter)) assertEquals(1.2F, visual.width());
+        for (final var visual : BedrockParticleEffectTest.sample(emitter)) assertEquals(2.2F, visual.width());
+        emitter.advance(100_000_000, 10, null, (x, y, z) -> List.of());
+        for (final var visual : BedrockParticleEffectTest.sample(emitter)) assertEquals(3.4F, visual.width());
+        assertEquals(99, evaluate(environment, "v.size"));
+    }
+
+    @Test
+    void preservesNativeNodeEvaluationOrderAndCurveDependencies() throws Exception {
+        final var environment = new BedrockMolang();
+        environment.variable("order", 0);
+        final var curves = BedrockParticleCurves.read(json("""
+                {"variable.z":{"type":"linear","nodes":["v.order=v.order*10+1;return 3;","v.order=v.order*10+2;return 9;"],"input":"v.a"},
+                 "variable.a":{"type":"linear","nodes":[0,1],"input":0.5}}
+                """));
+        curves.apply(environment);
+        assertEquals(6, evaluate(environment, "v.z"));
+        assertEquals(21, evaluate(environment, "v.order"));
+        environment.variable("order", 0);
+        BedrockParticleCurves.read(json("""
+                {"v.b":{"type":"bezier","nodes":["v.order=v.order*10+1;return 1;","v.order=v.order*10+2;return 2;",
+                "v.order=v.order*10+3;return 3;","v.order=v.order*10+4;return 4;"],"input":-1}}
+                """)).apply(environment);
+        assertEquals(1, evaluate(environment, "v.b"));
+        assertEquals(4321, evaluate(environment, "v.order"));
+    }
+
+    @Test
+    void appliesDynamicRangesAndLeavesEmptyChainsUnchanged() throws Exception {
+        final var curves = BedrockParticleCurves.read(json("""
+                {"v.size":{"type":"linear","nodes":[2,10],"input":1,"horizontal_range":"v.range"},
+                 "v.empty":{"type":"bezier_chain","nodes":{"0":{"value":3}},"input":0.5}}
+                """));
+        final var environment = new BedrockMolang();
+        environment.variable("empty", 9);
+        environment.variable("range", 2);
+        curves.apply(environment);
+        assertEquals(6, evaluate(environment, "v.size"));
+        assertEquals(9, evaluate(environment, "v.empty"));
+        environment.variable("range", -1);
+        curves.apply(environment);
+        assertEquals(10, evaluate(environment, "v.size"));
+    }
+
+    @Test
+    void rejectsMalformedCurvesBeforeStartingPlayback() {
+        for (final String value : List.of(
+                "[]", "{\"v.a\":null}", "{\"a\":{\"type\":\"linear\",\"nodes\":[1]}}",
+                "{\"v.a\":{\"type\":\"unknown\",\"nodes\":[]}}",
+                "{\"v.a\":{\"type\":\"bezier\",\"nodes\":[1,2]}}",
+                "{\"v.a\":{\"type\":\"bezier_chain\",\"nodes\":{\"nan\":{\"value\":1}}}}",
+                "{\"v.a\":{\"type\":\"bezier_chain\",\"nodes\":{\"0\":{\"slope\":\"v.slope\"}}}}")) {
+            assertThrows(IOException.class, () -> BedrockParticleCurves.read(JsonParser.parseString(value)));
+        }
+    }
+
+    private static float evaluate(final BedrockMolang environment, final String expression) throws IOException {
+        return environment.evaluate(BedrockMolang.Program.parse(new JsonPrimitive(expression), 0), 0);
+    }
+
+    private static JsonObject json(final String text) { return JsonParser.parseString(text).getAsJsonObject(); }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleDefinitionTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/appearance/BedrockParticleDefinitionTest.java
