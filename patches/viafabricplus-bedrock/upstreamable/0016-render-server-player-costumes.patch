+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import net.raphimc.viabedrock.api.model.NativeAnimationControllers;
+import net.raphimc.viabedrock.api.resourcepack.NativeActorLibrary;
+import net.raphimc.viabedrock.protocol.model.ActorAnimationCommand;
+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockPlayerCommandResourcesTest {
+    @Test
+    void loadsNativeGraphWithoutServerOverridesAndRetainsCommandsAcrossLookups() throws Exception {
+        final var packs = packs(false);
+        final var result = resources(packs);
+        assertNotNull(result);
+        assertEquals(false, value(result, "override"));
+        assertSame(result, resources(packs));
+        final var graph = (BedrockActorAnimation) value(result, "graph");
+        final var commands = new NativeAnimationControllers();
+        commands.apply(new ActorAnimationCommand("pose", "default", "0", 1, "slot", 0));
+        final var playback = graph.playback();
+        playback.commands(commands);
+        assertEquals(17, playback.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of())).get("arm").rotation().x());
+        final var server = resources(packs(true));
+        assertEquals(true, value(server, "override"));
+        assertNotSame(result, server);
+        assertEquals(false, value(resources(packs(false)), "override"));
+    }
+
+    private static ResourcePackStorage packs(final boolean server) throws Exception {
+        final var files = Map.of(
+                "manifest.json", """
+                        {"format_version":2,"header":{"name":"fixture","description":"fixture",
+                         "uuid":"00000000-0000-0000-0000-000000000001","version":[1,0,0]},
+                         "modules":[{"type":"resources","uuid":"00000000-0000-0000-0000-000000000002","version":[1,0,0]}]}
+                        """.getBytes(StandardCharsets.UTF_8),
+                "entity/player.json", """
+                        {"minecraft:client_entity":{"description":{"identifier":"minecraft:player","animations":{"pose":"animation.pose"}}}}
+                        """.getBytes(StandardCharsets.UTF_8),
+                "animations/player.json", """
+                        {"animations":{"animation.pose":{"loop":true,"bones":{"arm":{"rotation":[17,0,0]}}}}}
+                        """.getBytes(StandardCharsets.UTF_8));
+        return ResourcePackStorage.nativeActors(List.of(new NativeActorLibrary.Layer(server, files)));
+    }
+
+    private static Object resources(final ResourcePackStorage packs) throws Exception {
+        final var method = BedrockPlayerSkins.class.getDeclaredMethod("serverResources", ResourcePackStorage.class);
+        method.setAccessible(true);
+        return method.invoke(null, packs);
+    }
+
+    private static Object value(final Object record, final String name) throws Exception {
+        final var method = record.getClass().getDeclaredMethod(name);
+        method.setAccessible(true);
+        return method.invoke(record);
+    }
+}
