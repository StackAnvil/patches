+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BedrockServerActorVisibilityTest {
+    @Test
+    void retainsServerVisibilityOverridesInTheAnimatedActorScope() throws Exception {
+        final List<ResourcePack> packs = new ArrayList<>();
+        for (final String bone : List.of("rightArm", "leftArm")) {
+            final var content = new InMemoryContent();
+            content.putString("manifest.json", """
+                    {"format_version":2,"header":{"name":"test","uuid":"%s","version":[1,0,0]}}
+                    """.formatted(UUID.randomUUID()));
+            content.putString("entity/player.json", """
+                    {"minecraft:client_entity":{"description":{"identifier":"minecraft:player",
+                     "geometry":{"default":"geometry.body"},
+                     "scripts":{"pre_animation":["v.selected=c.is_first_person;"]},
+                     "render_controllers":[{"controller.test":"v.selected"}]}}}
+                    """);
+            content.putString("render_controllers/player.json", """
+                    {"render_controllers":{"controller.test":{"geometry":"Geometry.default",
+                     "part_visibility":[{"*":false},{"%s":true}]}}}
+                    """.formatted(bone));
+            packs.add(new ResourcePack(content));
+        }
+        final var graph = BedrockActorAnimation.serverPlayer(new ResourcePackStorage(packs.reversed()));
+        assertNotNull(graph);
+        final var actor = graph.playback();
+        actor.sample(0, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 1)));
+        assertTrue(actor.visibility().specified());
+        assertFalse(actor.visibility().visible("rightArm"));
+        assertTrue(actor.visibility().visible("leftArm"));
+        actor.sample(1, new BedrockActorAnimation.Frame(Map.of(), Map.of(), Map.of("is_first_person", 0)));
+        assertFalse(actor.visibility().visible("leftArm"));
+        assertFalse(actor.visibility().visible("rightArm"));
+    }
+}
