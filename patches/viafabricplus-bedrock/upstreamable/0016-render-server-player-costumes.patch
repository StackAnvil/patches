+
+/** Evaluates the server's player controller graph using one actor-local variable scope. */
+public final class BedrockPlayerControllers {
+    private final BedrockEntityData entity;
+    private final Map<String, BedrockRenderController> controllers;
+    private final Map<String, UvAnimation> uvAnimations;
+    private final BedrockMolang molang = new BedrockMolang();
+    private final Map<String, BedrockMolang.Program> programs = new HashMap<>();
+    private final Map<List<String>, BedrockMolang.Program> scripts = new HashMap<>();
+    private boolean initialized;
+    private float previousTime;
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers) {
+        this(entity, controllers, Map.of());
+    }
+
+    public BedrockPlayerControllers(
+            final BedrockEntityData entity, final Map<String, BedrockRenderController> controllers,
+            final Map<String, UvAnimation> uvAnimations) {
+        this.entity = entity;
+        this.controllers = Map.copyOf(controllers);
+        this.uvAnimations = Map.copyOf(uvAnimations);
+        this.molang.binding("geometry", entity.getGeometries());
+        this.molang.binding("texture", entity.getTextures());
+        this.molang.binding("material", entity.getMaterials());
+    }
+
+    public Selection select(
+            final float time,
+            final Map<String, Object> properties,
+            final Map<String, Object> queries,
+            final Map<String, Float> variables)
+            throws IOException {
+        final Map<String, Object> frame = new HashMap<>(queries);
+        frame.put("life_time", time);
+        frame.put("property", (BedrockActorAnimation.Query) args -> args.isEmpty() ? 0 : properties.getOrDefault(String.valueOf(args.getFirst()), 0));
+        frame.put("has_property", (BedrockActorAnimation.Query) args -> !args.isEmpty() && properties.containsKey(String.valueOf(args.getFirst())));
+        this.molang.queries(frame, time, time, this.initialized ? Math.max(0, time - this.previousTime) : 0);
+        this.previousTime = time;
+        if (!this.initialized) {
+            this.run(this.entity.getScripts().initialize());
+            this.initialized = true;
+        }
+        this.molang.variables(variables);
+        this.run(this.entity.getScripts().pre_animation());
+
+        final List<Surface> surfaces = new ArrayList<>();
+        boolean body = false;
+        for (final var reference : this.entity.getControllers()) {
+            if (!reference.condition().isBlank() && !this.value(reference.condition()).getAsBoolean()) continue;
+            final BedrockRenderController controller = this.controllers.get(reference.identifier());
+            if (controller == null) continue;
+            final Map<String, Object> arrays = new HashMap<>();
+            for (final var group : List.of(controller.geometries(), controller.textures(), controller.materials())) {
+                for (final var array : group) {
+                    final String[] values = new String[array.values().size()];
+                    for (int index = 0; index < values.length; index++) values[index] = this.value(array.values().get(index)).getAsString();
+                    arrays.put(array.name().replaceFirst("(?i)^array\\.", ""), values);
+                }
+            }
+            this.molang.binding("array", arrays);
+            final String geometry = this.value(controller.geometryExpression()).getAsString();
+            final String material = controller.materialsMap().containsKey("*") ? this.value(controller.materialsMap().get("*")).getAsString() : "entity_alphatest";
+            final UvAnimation animation = this.uvAnimations.get(reference.identifier());
+            final Uv uv = animation == null ? Uv.IDENTITY : new Uv(
+                    (float) this.value(animation.offsetX()).getAsNumber(), (float) this.value(animation.offsetY()).getAsNumber(),
+                    (float) this.value(animation.scaleX()).getAsNumber(), (float) this.value(animation.scaleY()).getAsNumber());
+            for (final String expression : controller.textureExpressions()) {
+                final String texture = this.value(expression).getAsString();
+                if ((geometry.equals("geometry.humanoid.custom") || geometry.equals("geometry.humanoid.customSlim"))
+                        && (texture.equals("textures/entity/steve") || texture.equals("textures/entity/alex"))) {
+                    body = true;
+                } else if (!geometry.isBlank() && !texture.isBlank()) {
+                    surfaces.add(new Surface(reference.identifier(), geometry, texture, material, uv));
+                }
+            }
+        }
+        return new Selection(body, List.copyOf(surfaces));
+    }
+
+    private void run(final List<String> expressions) throws IOException {
+        BedrockMolang.Program program = this.scripts.get(expressions);
+        if (program == null) {
+            program = BedrockMolang.Program.script(expressions);
+            this.scripts.put(List.copyOf(expressions), program);
+        }
+        this.molang.value(program);
+    }
+
+    private team.unnamed.mocha.runtime.value.Value value(final String expression) throws IOException {
+        BedrockMolang.Program program = this.programs.get(expression);
+        if (program == null) {
+            program = BedrockMolang.Program.parse(new JsonPrimitive(expression), 0);
+            this.programs.put(expression, program);
+        }
+        return this.molang.value(program);
+    }
+
+    public record UvAnimation(String offsetX, String offsetY, String scaleX, String scaleY) {}
+    public record Uv(float offsetX, float offsetY, float scaleX, float scaleY) {
+        public static final Uv IDENTITY = new Uv(0, 0, 1, 1);
+    }
+    public record Surface(String controller, String geometry, String texture, String material, Uv uv) {}
+    public record Selection(boolean bodyVisible, List<Surface> surfaces) {}
+}
