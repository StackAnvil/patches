+package com.viaversion.viafabricplus.bedrock.render;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.joml.Matrix4f;
+import org.joml.Vector3f;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+final class BedrockPlayerQueriesTest {
+    @Test
+    void truncatesPlayerHeadIndexAndRejectsOtherHeadsOrInvalidArguments() {
+        final var query = BedrockPlayerQueries.headPitch(23.588333F);
+        for (final float index : new float[] {0, .75F, -.75F})
+            assertEquals(23.588333F, query.evaluate(List.of(index)));
+        for (final float index : new float[] {1, 2, -1, Float.NaN, Float.POSITIVE_INFINITY})
+            assertEquals(0F, query.evaluate(List.of(index)));
+        assertEquals(0F, query.evaluate(List.of()));
+        assertEquals(0F, query.evaluate(List.of(0, 0)));
+        assertEquals(0F, query.evaluate(List.of("head")));
+    }
+
+    @Test
+    void letsAuthoredWaistRotationCancelCameraPitchWithoutMovingTheHeadToTheWorldOrigin() {
+        for (final float pitch : new float[] {-30, 0, 23.588333F, 30}) {
+            final float headPitch = ((Number) BedrockPlayerQueries.headPitch(pitch).evaluate(List.of(0))).floatValue();
+            final var camera = new Matrix4f().rotateX((float) Math.toRadians(pitch));
+            final var waist = new Matrix4f().translate(0, 12, 0).rotateX((float) Math.toRadians(-headPitch));
+            final var body = new Matrix4f(waist).translate(0, -12, 0);
+            final Vector3f up = camera.mul(body, new Matrix4f()).transformDirection(new Vector3f(0, 1, 0));
+            assertEquals(0, up.z, .00001F);
+            assertEquals(1, up.y, .00001F);
+            assertEquals(12 - 12 * Math.cos(Math.toRadians(pitch)), body.m31(), .00001F);
+            assertEquals(12 * Math.sin(Math.toRadians(pitch)), body.m32(), .00001F);
+        }
+    }
+}
