+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
+
+/** Resolves one actor's native dependencies below accepted server overrides, off the render thread. */
+public final class BedrockEntityResources {
+    private static ResourcePackStorage source;
+    private static final Map<String, CompletableFuture<ResourcePackStorage>> ACTORS = new HashMap<>();
+
+    private BedrockEntityResources() {}
+
+    public static synchronized ResourcePackStorage get(final ResourcePackStorage accepted, final String identifier) {
+        if (accepted == null) return null;
+        if (source != accepted) { clear(); source = accepted; }
+        final var result = ACTORS.computeIfAbsent(identifier, _ -> CompletableFuture.supplyAsync(() -> {
+            try {
+                return merge(BedrockBuiltinAssets.load().library(),
+                        NativeActorLibrary.resources(accepted.getPackStackBottomToTop(), accepted::isServerPack), identifier);
+            } catch (IOException invalid) { throw new CompletionException(invalid); }
+        }));
+        // A failed actor keeps its Java fallback for this generation, without repeated log spam.
+        return result.isCompletedExceptionally() ? null : result.getNow(null);
+    }
+
+    static ResourcePackStorage merge(final BedrockResourceLibrary builtin,
+                                     final List<NativeActorLibrary.Layer> accepted, final String identifier) throws IOException {
+        final var library = BedrockResourceLibrary.withServerPacks(builtin,
+                accepted.stream().map(NativeActorLibrary.Layer::resources).toList());
+        final var entity = library.entity(identifier);
+        if (entity == null) return null;
+        final var description = entity.getAsJsonObject("description");
+        final Set<String> textures = new HashSet<>();
+        if (description.has("textures")) description.getAsJsonObject("textures").entrySet()
+                .forEach(entry -> textures.add(entry.getValue().getAsString()));
+        final List<NativeActorLibrary.Layer> layers = new ArrayList<>(
+                NativeActorLibrary.resources(builtin.resourcePacks(), _ -> false));
+        layers.addAll(accepted);
+        final List<NativeActorLibrary.Layer> selected = new ArrayList<>();
+        for (final var layer : layers) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            for (final var entry : layer.resources().entrySet()) {
+                final String path = entry.getKey();
+                if (path.startsWith("entity/") && path.endsWith(".json")) {
+                    final var nativeEntity = com.google.gson.JsonParser.parseString(new String(entry.getValue(), StandardCharsets.UTF_8))
+                            .getAsJsonObject().getAsJsonObject("minecraft:client_entity");
+                    if (nativeEntity != null && identifier.equals(nativeEntity.getAsJsonObject("description").get("identifier").getAsString()))
+                        files.put(path, entry.getValue());
+                }
+                if (path.equals("manifest.json") || path.startsWith("materials/") || path.startsWith("animations/")
+                        || path.startsWith("animation_controllers/") || path.startsWith("render_controllers/")
+                        || textures.stream().anyMatch(texture -> path.startsWith(texture + "."))) files.put(path, entry.getValue());
+            }
+            selected.add(new NativeActorLibrary.Layer(layer.server(), files));
+        }
+        // Normalize only this actor's geometry, resolving legacy parents against the complete library.
+        final JsonArray geometries = new JsonArray();
+        if (description.has("geometry")) for (final var entry : description.getAsJsonObject("geometry").entrySet()) {
+            final String name = entry.getValue().getAsString();
+            final var document = library.model(name);
+            if (document == null) continue;
+            if (document.has("minecraft:geometry")) document.getAsJsonArray("minecraft:geometry").forEach(geometries::add);
+            else geometries.add(BedrockLegacyGeometry.read(document, name, library::model));
+        }
+        final JsonObject model = new JsonObject();
+        model.addProperty("format_version", "1.12.0");
+        model.add("minecraft:geometry", geometries);
+        final JsonObject definition = new JsonObject(), manifest = new JsonObject();
+        definition.addProperty("format_version", "1.10.0");
+        definition.add("minecraft:client_entity", entity);
+        manifest.addProperty("format_version", 2);
+        final var header = new JsonObject();
+        header.addProperty("name", "Resolved native actor");
+        header.addProperty("uuid", java.util.UUID.nameUUIDFromBytes(identifier.getBytes(StandardCharsets.UTF_8)).toString());
+        final var version = new JsonArray(); version.add(1); version.add(0); version.add(0);
+        header.add("version", version); manifest.add("header", header);
+        selected.add(new NativeActorLibrary.Layer(false, Map.of(
+                "manifest.json", bytes(manifest), "entity/resolved.json", bytes(definition), "models/entity/resolved.json", bytes(model))));
+        return ResourcePackStorage.nativeActors(selected);
+    }
+
+    private static byte[] bytes(final JsonObject json) { return json.toString().getBytes(StandardCharsets.UTF_8); }
+
+    public static synchronized void clear() { source = null; ACTORS.clear(); }
+}
