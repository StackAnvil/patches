+        final var entity = new BedrockEntityData("minecraft:player", scripts, List.of(
+                new BedrockEntityData.RenderController("controller.render.body", "v.visible"),
+                new BedrockEntityData.RenderController("controller.render.hat", "v.visible && v.show_hat")
+        ), Map.of("default", "entity_alphatest"), Map.of(),
+                Map.of("default", "textures/entity/steve", "first", "textures/hat_first", "second", "textures/hat_second"),
