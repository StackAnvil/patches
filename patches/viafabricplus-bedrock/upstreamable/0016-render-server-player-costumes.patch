+                "v.show_hat = q.has_property('example:hat'); v.hat = q.property('example:hat');",
+                combined ? "v.frames = q.has_property('example:animated') && q.property('example:animated') ? 2 : 1;"
+                        : "v.animated = q.has_property('example:animated') && q.property('example:animated'); v.frames = v.animated ? 2 : 1;"
+        ), new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of());
