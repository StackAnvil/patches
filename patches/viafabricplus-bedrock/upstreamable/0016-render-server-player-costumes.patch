+package com.viaversion.viafabricplus.bedrock.render;
+
+import com.viaversion.viafabricplus.bedrock.appearance.BedrockActorAnimation;
+
+/** Player queries whose arguments differ from the generic target rotation queries. */
+final class BedrockPlayerQueries {
+    private BedrockPlayerQueries() {}
+
+    static BedrockActorAnimation.Query headPitch(final float pitch) {
+        return arguments -> {
+            if (arguments.size() != 1 || !(arguments.getFirst() instanceof Number index)) return 0F;
+            final float value = index.floatValue();
+            // Native truncates the index. Players have only head zero; extra heads belong to the wither.
+            return Float.isFinite(value) && (int) value == 0 ? pitch : 0F;
+        };
+    }
+}
