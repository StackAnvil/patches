+
+final class BedrockPlayerCostumeLayer extends RenderLayer<AvatarRenderState, PlayerModel> {
+    BedrockPlayerCostumeLayer(final AvatarRenderer<?> parent) {
+        super(parent);
+    }
+
+    @Override
+    public void submit(final PoseStack poses, final SubmitNodeCollector collector, final int light,
+                       final AvatarRenderState state, final float yaw, final float pitch) {
+        for (final var surface : BedrockPlayerSkins.costumes(state)) {
+            surface.model().setupAnim(state);
+            collector.order(1).submitModel(surface.model(), state, poses,
+                    surface.cutout() ? RenderTypes.entityCutout(surface.texture()) : RenderTypes.entityTranslucent(surface.texture()),
+                    light, OverlayTexture.NO_OVERLAY, state.outlineColor);
+        }
+    }
+}
