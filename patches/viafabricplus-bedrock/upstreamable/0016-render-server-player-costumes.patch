+    static BedrockResourceLibrary serverEffects(final net.raphimc.viabedrock.protocol.storage.ResourcePackStorage stack)
+            throws IOException {
+        final List<Pack> packs = new ArrayList<>();
+        final java.util.Set<String> textures = new java.util.LinkedHashSet<>();
+        final List<net.raphimc.viabedrock.api.resourcepack.ResourcePack> stackPacks = List.copyOf(stack.getPackStackBottomToTop());
+        final List<Map<String, byte[]>> selected = new ArrayList<>();
+        long total = 0;
+        int count = 0;
+        for (final var pack : stackPacks) {
+            final Map<String, byte[]> files = new LinkedHashMap<>();
+            final List<String> paths = new ArrayList<>();
+            if (pack.content().contains("sounds.json")) paths.add("sounds.json");
+            for (final String extension : List.of(".json", ".fsb", ".ogg"))
+                paths.addAll(pack.content().getFilesDeep("sounds/", extension));
+            paths.addAll(pack.content().getFilesDeep("particles/", ".json"));
+            paths.addAll(pack.content().getFilesDeep("render_controllers/", ".json"));
+            for (final String path : paths) {
+                BedrockBuiltinAssets.validPath(path);
+                final byte[] bytes = pack.content().get(path);
+                total += bytes.length;
+                if (++count > 8192 || bytes.length > BedrockBuiltinAssets.MAX_FILE_BYTES
+                        || total > BedrockBuiltinAssets.MAX_TOTAL_BYTES)
+                    throw new IOException("Server effect library exceeds resource limits");
+                files.put(path, bytes);
+                if (path.startsWith("particles/")) {
+                    try {
+                        final String texture = BedrockParticleDefinition.read(bytes).getAsJsonObject("particle_effect")
+                                .getAsJsonObject("description").getAsJsonObject("basic_render_parameters").get("texture").getAsString();
+                        BedrockBuiltinAssets.validPath(texture);
+                        textures.add(texture);
+                    } catch (RuntimeException invalid) { throw new IOException("Invalid server particle definition", invalid); }
+                }
+            }
+            selected.add(files);
+        }
+        for (int index = 0; index < stackPacks.size(); index++) {
+            final var content = stackPacks.get(index).content();
+            final var files = selected.get(index);
+            for (final String texture : textures) {
+                final List<String> paths = texture.endsWith(".png") || texture.endsWith(".tga")
+                        ? List.of(texture) : List.of(texture + ".png", texture + ".tga");
+                for (final String path : paths) {
+                    final byte[] bytes = content.get(path);
+                    if (bytes == null) continue;
+                    total += bytes.length;
+                    if (++count > 8192 || bytes.length > BedrockBuiltinAssets.MAX_FILE_BYTES
+                            || total > BedrockBuiltinAssets.MAX_TOTAL_BYTES)
+                        throw new IOException("Server effect library exceeds resource limits");
+                    files.put(path, bytes);
+                }
+            }
+            packs.add(new Pack(Integer.toString(index), Map.copyOf(files)));
+        }
+        return new BedrockResourceLibrary(packs);
+    }
