+        final String increments = "v.counter=v.counter+1;".repeat(240);
+        final var scripts = new BedrockEntityData.Scripts(List.of("v.counter=0;"), List.of(
+                increments + "v.visible=q.property('visible') ?",
+                "v.counter==q.property('expected') : 0;"
+        ), new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of());
+        final var controllers = controllers(scripts);
+        assertTrue(controllers.select(0, Map.of("visible", true, "expected", 240), Map.of(), Map.of()).bodyVisible());
+        assertTrue(controllers.select(1, Map.of("visible", true, "expected", 480), Map.of(), Map.of()).bodyVisible());
+        assertFalse(controllers.select(2, Map.of("visible", false), Map.of(), Map.of()).bodyVisible());
+    }
