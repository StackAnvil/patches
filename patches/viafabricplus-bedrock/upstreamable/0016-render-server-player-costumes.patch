+class BedrockPlayerControllersTest {
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void selectsAndRemovesAPropertyDrivenHatAfterPreAnimation(final boolean combined) throws Exception {
+        final BedrockPlayerControllers controllers = controllers(combined);
+        final var hidden = controllers.select(0, Map.of(), Map.of(), Map.of());
+        assertTrue(hidden.bodyVisible());
+        assertTrue(hidden.surfaces().isEmpty());
+
+        final var visible = controllers.select(1, Map.of("example:hat", 1, "example:animated", true), Map.of(), Map.of());
+        assertEquals(1, visible.surfaces().size());
+        assertEquals("geometry.hat.second", visible.surfaces().getFirst().geometry());
+        assertEquals("textures/hat_second", visible.surfaces().getFirst().texture());
+        assertEquals(0.5F, visible.surfaces().getFirst().uv().offsetY());
+        assertEquals(0.5F, visible.surfaces().getFirst().uv().scaleY());
+
+        final var changed = controllers.select(2, Map.of("example:hat", 0), Map.of(), Map.of());
+        assertEquals("geometry.hat.first", changed.surfaces().getFirst().geometry());
+        assertEquals(BedrockPlayerControllers.Uv.IDENTITY, changed.surfaces().getFirst().uv());
+        assertTrue(controllers.select(3, Map.of(), Map.of(), Map.of()).surfaces().isEmpty());
+    }
