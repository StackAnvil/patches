+package com.viaversion.viafabricplus.bedrock.appearance;
+
+import java.util.List;
+import java.util.Map;
+import org.cube.converter.data.bedrock.BedrockEntityData;
+import org.cube.converter.data.bedrock.controller.BedrockRenderController;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockPlayerControllersTest {
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void selectsAndRemovesAPropertyDrivenHatAfterPreAnimation(final boolean combined) throws Exception {
+        final BedrockPlayerControllers controllers = controllers(combined);
+        final var hidden = controllers.select(0, Map.of(), Map.of(), Map.of());
+        assertTrue(hidden.bodyVisible());
+        assertTrue(hidden.surfaces().isEmpty());
+
+        final var visible = controllers.select(1, Map.of("example:hat", 1, "example:animated", true), Map.of(), Map.of());
+        assertEquals(1, visible.surfaces().size());
+        assertEquals("geometry.hat.second", visible.surfaces().getFirst().geometry());
+        assertEquals("textures/hat_second", visible.surfaces().getFirst().texture());
+        assertEquals(0.5F, visible.surfaces().getFirst().uv().offsetY());
+        assertEquals(0.5F, visible.surfaces().getFirst().uv().scaleY());
+
+        final var changed = controllers.select(2, Map.of("example:hat", 0), Map.of(), Map.of());
+        assertEquals("geometry.hat.first", changed.surfaces().getFirst().geometry());
+        assertEquals(BedrockPlayerControllers.Uv.IDENTITY, changed.surfaces().getFirst().uv());
+        assertTrue(controllers.select(3, Map.of(), Map.of(), Map.of()).surfaces().isEmpty());
+    }
+
+    @Test
+    void honorsServerPlayerVisibilityWithoutReplacingThePlayerSkinTexture() throws Exception {
+        final var invisible = controllers(false).select(0, Map.of("example:hat", 1), Map.of("mark_variant", 255), Map.of());
+        assertFalse(invisible.bodyVisible());
+        assertTrue(invisible.surfaces().isEmpty());
+    }
+
+    @Test
+    void evaluatesLongScriptsAndSplitExpressionsInOnePersistentActorScope() throws Exception {
+        final String increments = "v.counter=v.counter+1;".repeat(240);
+        final var scripts = new BedrockEntityData.Scripts(List.of("v.counter=0;"), List.of(
+                increments + "v.visible=q.property('visible') ?",
+                "v.counter==q.property('expected') : 0;"
+        ), new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of());
+        final var controllers = controllers(scripts);
+        assertTrue(controllers.select(0, Map.of("visible", true, "expected", 240), Map.of(), Map.of()).bodyVisible());
+        assertTrue(controllers.select(1, Map.of("visible", true, "expected", 480), Map.of(), Map.of()).bodyVisible());
+        assertFalse(controllers.select(2, Map.of("visible", false), Map.of(), Map.of()).bodyVisible());
+    }
+
+    private static BedrockPlayerControllers controllers(final boolean combined) {
+        final var scripts = new BedrockEntityData.Scripts(List.of("v.show_hat = 0;"), List.of(
+                "v.visible = q.mark_variant != 255;",
+                "v.show_hat = q.has_property('example:hat'); v.hat = q.property('example:hat');",
+                combined ? "v.frames = q.has_property('example:animated') && q.property('example:animated') ? 2 : 1;"
+                        : "v.animated = q.has_property('example:animated') && q.property('example:animated'); v.frames = v.animated ? 2 : 1;"
+        ), new BedrockEntityData.Scripts.Scale("1", "1", "1", "1"), List.of());
+        return controllers(scripts);
+    }
+
+    private static BedrockPlayerControllers controllers(final BedrockEntityData.Scripts scripts) {
+        final var entity = new BedrockEntityData("minecraft:player", scripts, List.of(
+                new BedrockEntityData.RenderController("controller.render.body", "v.visible"),
+                new BedrockEntityData.RenderController("controller.render.hat", "v.visible && v.show_hat")
+        ), Map.of("default", "entity_alphatest"), Map.of(),
+                Map.of("default", "textures/entity/steve", "first", "textures/hat_first", "second", "textures/hat_second"),
+                Map.of("default", "geometry.humanoid.custom", "first", "geometry.hat.first", "second", "geometry.hat.second"));
+        final var body = new BedrockRenderController("controller.render.body", Map.of("*", "Material.default"),
+                "Geometry.default", List.of("Texture.default"), List.of(), List.of(), List.of(), false, "1.0", BedrockRenderController.UvAnimation.IDENTITY);
+        final var hat = new BedrockRenderController("controller.render.hat", Map.of("*", "Material.default"),
+                "Array.models[v.hat]", List.of("Array.textures[v.hat]"), List.of(),
+                List.of(new BedrockRenderController.Array("Array.textures", List.of("Texture.first", "Texture.second"))),
+                List.of(new BedrockRenderController.Array("Array.models", List.of("Geometry.first", "Geometry.second"))), false, "1.0", BedrockRenderController.UvAnimation.IDENTITY);
+        return new BedrockPlayerControllers(entity, Map.of(body.identifier(), body, hat.identifier(), hat), Map.of(hat.identifier(),
+                new BedrockPlayerControllers.UvAnimation("0", "math.mod(math.floor(q.life_time * 7), v.frames) / v.frames", "1", "1 / v.frames")));
+    }
+}
