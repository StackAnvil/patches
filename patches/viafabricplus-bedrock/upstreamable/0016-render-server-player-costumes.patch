+import net.raphimc.viabedrock.protocol.storage.ResourcePackStorage;
 
 /** A resource-defined actor graph with shared variables and independent playback clocks. */
 public final class BedrockActorAnimation {
+
+    public static BedrockActorAnimation serverPlayer(final ResourcePackStorage packs) throws IOException {
+        final Map<String, JsonObject> animations = new LinkedHashMap<>();
+        final Map<String, ControllerResource> controllers = new LinkedHashMap<>();
+        JsonObject player = null;
+        try {
+            for (final var pack : packs.getPackStackBottomToTop()) {
+                for (final String path : pack.content().getFilesDeep("entity/", ".json")) {
+                    final JsonObject description = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject()
+                            .getAsJsonObject("minecraft:client_entity").getAsJsonObject("description");
+                    if ("minecraft:player".equals(description.get("identifier").getAsString())) player = description;
+                }
+                for (final String folder : List.of("animations/", "animation_controllers/")) {
+                    for (final String path : pack.content().getFilesDeep(folder, ".json")) {
+                        final JsonObject document = JsonParser.parseString(pack.content().getString(path)).getAsJsonObject();
+                        final String field = folder.equals("animations/") ? "animations" : "animation_controllers";
+                        final JsonObject definitions = document.getAsJsonObject(field);
+                        if (definitions == null) continue;
+                        final boolean deferred = deferredEntry(document.has("format_version") ? document.get("format_version").getAsString() : "1.10.0");
+                        for (final var entry : definitions.entrySet()) {
+                            if (field.equals("animations")) animations.put(entry.getKey(), entry.getValue().getAsJsonObject());
+                            else controllers.put(entry.getKey(), new ControllerResource(entry.getValue().getAsJsonObject(), deferred));
+                        }
+                        if (animations.size() > 4096 || controllers.size() > 4096) throw new IOException("Too many server actor animation resources");
+                    }
+                }
+            }
+            return player == null ? null : new BedrockActorAnimation(player, Map.of(), animations, controllers, BedrockResourceLibrary.serverEffects(packs));
+        } catch (RuntimeException e) {
+            throw new IOException("Invalid server player animation graph", e);
+        }
+    }
