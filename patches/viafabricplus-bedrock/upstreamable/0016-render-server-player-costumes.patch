+final class BedrockEntityResourcesTest {
+    @Test
+    void mergesAnimationOnlyOverridesAndKeepsNativePlayerControllersAndServerProvenance() throws Exception {
+        Assumptions.assumeTrue(getClass().getResource("/assets/viafabricplus-bedrock/builtin/manifest.json") != null);
+        final var override = layer(Map.of("animations/override.json", bytes("""
+                {"format_version":"1.10.0","animations":{"animation.humanoid.base_pose":{
+                 "loop":true,"bones":{"head":{"rotation":[17,0,0]}}}}}
+                """)));
+        final var packs = BedrockEntityResources.merge(BedrockBuiltinAssets.load().library(), List.of(override), "minecraft:player");
+        assertNotNull(packs.getEntities().get("minecraft:player"));
+        assertFalse(packs.getRenderControllers().renderControllers().isEmpty());
+        assertTrue(packs.getPackStackBottomToTop().stream().anyMatch(packs::isServerPack));
+        final var graph = BedrockActorAnimation.serverPlayer(packs).playback();
+        final var pose = graph.sample(0, new BedrockActorAnimation.Frame(Map.of("is_alive", true),
+                Map.of("is_first_person", 0F, "is_paperdoll", 0F, "map_face_icon", 0F)), false, null, null);
+        assertEquals(17F, pose.get("head").rotation().x(), .001F);
+    }
+
+    @Test
+    void normalizesOnlyTheRequestedActorsModelsAndHonorsHigherTextureAndControllerOverrides() throws Exception {
+        Assumptions.assumeTrue(getClass().getResource("/assets/viafabricplus-bedrock/builtin/manifest.json") != null);
+        final var lower = layer(Map.of("textures/entity/endercrystal/endercrystal.png", new byte[]{3}));
+        final var higher = layer(Map.of(
+                "textures/entity/endercrystal/endercrystal.png", new byte[]{9},
+                "render_controllers/crystal.json", bytes("""
+                 {"render_controllers":{"controller.render.ender_crystal":{
+                   "geometry":"Geometry.default","materials":[{"*":"Material.default"}],"textures":["Texture.beam"]}}}
+                 """)));
+        final var packs = BedrockEntityResources.merge(BedrockBuiltinAssets.load().library(), List.of(lower, higher), "minecraft:ender_crystal");
+        assertEquals(1, packs.getModels().entityModels().size());
+        assertNotNull(packs.getModels().entityModels().get("geometry.ender_crystal"));
+        final var controller = packs.getRenderControllers().renderControllers().get("controller.render.ender_crystal");
+        assertEquals(1, controller.textureExpressions().size());
+        final var first = packs.getPackStackTopToBottom().stream().filter(pack -> pack.content().contains("textures/entity/endercrystal/endercrystal.png")).findFirst().orElseThrow();
+        assertArrayEquals(new byte[]{9}, first.content().get("textures/entity/endercrystal/endercrystal.png"));
+    }
