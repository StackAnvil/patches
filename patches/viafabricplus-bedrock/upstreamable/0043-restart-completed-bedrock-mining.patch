+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.misc;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.viaversion.viafabricplus.bedrock.input.BedrockMiningInput;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.HitResult;
+import org.objectweb.asm.Opcodes;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(Minecraft.class)
+public abstract class MixinBedrockMiningInput {
+    @Shadow private int missTime;
+
+    @Inject(method = "continueAttack", at = @At("HEAD"), require = 1)
+    private void reportBedrockMiningInput(final boolean attacking, final CallbackInfo ci) {
+        final Minecraft client = (Minecraft) (Object) this;
+        final boolean continuing = attacking && (this.missTime <= 0 || BedrockMiningInput.applies()) && client.player != null
+                && !client.player.isUsingItem() && client.level != null
+                && client.hitResult instanceof BlockHitResult hit && hit.getType() == HitResult.Type.BLOCK
+                && !client.level.getBlockState(hit.getBlockPos()).isAir();
+        BedrockMiningInput.send(continuing);
+    }
+
+    @ModifyExpressionValue(method = "continueAttack", at = @At(value = "FIELD",
+            target = "Lnet/minecraft/client/Minecraft;missTime:I", opcode = Opcodes.GETFIELD), require = 1)
+    private int continueBedrockMiningAfterMiss(final int missTime) {
+        // A fresh press can hit air just before the server restores a block. Native resumes
+        // held mining when the target returns; Java's attack miss timer must not block it.
+        return BedrockMiningInput.applies() ? 0 : missTime;
+    }
+}
