+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.misc;
+
+import com.llamalad7.mixinextras.injector.ModifyReturnValue;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Constant;
+import org.spongepowered.asm.mixin.injection.ModifyConstant;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(MultiPlayerGameMode.class)
+public abstract class MixinBedrockMining {
+    @Shadow private boolean isDestroying;
+    @Unique private int viaFabricPlusBedrock$miningPause;
+
+    @ModifyReturnValue(method = "sameDestroyTarget", at = @At("RETURN"), require = 1)
+    private boolean requireActiveBedrockGesture(final boolean sameTarget) {
+        // A restored block needs a new Start; continuing an inactive Java target sends none.
+        return sameTarget && (!BedrockInputPermissions.isBedrockConnection() || this.isDestroying);
+    }
+
+    @Inject(method = "tick", at = @At("TAIL"), require = 1)
+    private void advanceBedrockMiningPause(final CallbackInfo ci) {
+        if (this.viaFabricPlusBedrock$miningPause > 0) this.viaFabricPlusBedrock$miningPause--;
+    }
+
+    @WrapOperation(method = "continueDestroyBlock", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/multiplayer/MultiPlayerGameMode;startDestroyBlock(Lnet/minecraft/core/BlockPos;Lnet/minecraft/core/Direction;)Z"), require = 1)
+    private boolean beginBedrockContinuation(final MultiPlayerGameMode mode, final BlockPos position,
+                                             final Direction direction, final Operation<Boolean> original) {
+        final boolean bedrock = BedrockInputPermissions.isBedrockConnection();
+        if (bedrock && this.viaFabricPlusBedrock$miningPause > 0) return false;
+        final boolean started = original.call(mode, position, direction);
+        // The newly active target/item takes the damage branch, so this cannot re-enter the start branch.
+        return bedrock && started && this.isDestroying ? mode.continueDestroyBlock(position, direction) : started;
+    }
+
+    @ModifyConstant(method = "continueDestroyBlock", constant = @Constant(intValue = 5, ordinal = 1), require = 1)
+    private int closeCompletedBedrockGesture(final int javaDelay) {
+        if (!BedrockInputPermissions.isBedrockConnection()) return javaDelay;
+        // Reserve the closing input. Tick this even while a restored block is outside the current raycast.
+        this.viaFabricPlusBedrock$miningPause = 2;
+        return 0;
+    }
+}
