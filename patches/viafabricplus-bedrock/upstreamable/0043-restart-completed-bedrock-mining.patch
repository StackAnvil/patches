+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.Minecraft;
+import net.minecraft.world.level.GameType;
+import net.raphimc.viabedrock.api.model.PlayerMiningInput;
+
+/** Report the release/miss boundary that Java loses when completion clears its active target. */
+public final class BedrockMiningInput {
+    private BedrockMiningInput() {
+    }
+
+    public static boolean applies() {
+        final Minecraft client = Minecraft.getInstance();
+        return supported() && client.gameMode != null && client.gameMode.getPlayerMode() == GameType.SURVIVAL;
+    }
+
+    public static void send(final boolean continuing) {
+        if (supported()) {
+            ClientPlayNetworking.send(new PlayerMiningInputPayload(new PlayerMiningInput(continuing && applies())));
+        }
+    }
+
+    private static boolean supported() {
+        return BedrockInputPermissions.isBedrockConnection() && Minecraft.getInstance().getConnection() != null
+                && ClientPlayNetworking.canSend(PlayerMiningInputPayload.TYPE);
+    }
+}
