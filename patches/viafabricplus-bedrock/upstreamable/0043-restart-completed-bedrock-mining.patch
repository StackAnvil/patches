+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.PlayerMiningInput;
+
+public record PlayerMiningInputPayload(PlayerMiningInput input) implements CustomPacketPayload {
+    public static final Type<PlayerMiningInputPayload> TYPE = new Type<>(Identifier.parse(PlayerMiningInput.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, PlayerMiningInputPayload> CODEC = CustomPacketPayload.codec(
+            (payload, buffer) -> PlayerMiningInput.TYPE.write(buffer, payload.input),
+            buffer -> new PlayerMiningInputPayload(PlayerMiningInput.TYPE.read(buffer)));
+
+    @Override
+    public Type<PlayerMiningInputPayload> type() {
+        return TYPE;
+    }
+}
