+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.misc;
+
+import com.llamalad7.mixinextras.injector.ModifyReturnValue;
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import com.llamalad7.mixinextras.injector.wrapoperation.Operation;
+import com.llamalad7.mixinextras.injector.wrapoperation.WrapOperation;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import com.viaversion.viafabricplus.bedrock.input.BedrockMiningInput;
+import net.minecraft.client.multiplayer.MultiPlayerGameMode;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.level.GameType;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Constant;
+import org.spongepowered.asm.mixin.injection.ModifyConstant;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+@Mixin(MultiPlayerGameMode.class)
+public abstract class MixinBedrockMining {
+    @Shadow private boolean isDestroying;
+    @Shadow private BlockPos destroyBlockPos;
+    @Shadow public abstract GameType getPlayerMode();
+    @Unique private int viaFabricPlusBedrock$miningPause;
+    @Unique private BlockPos viaFabricPlusBedrock$completedTarget;
+    @Unique private long viaFabricPlusBedrock$miningDeadline;
+    @Unique private boolean viaFabricPlusBedrock$automaticStart;
+    @Unique private float viaFabricPlusBedrock$miningRate;
+
+    @ModifyReturnValue(method = "sameDestroyTarget", at = @At("RETURN"), require = 1)
+    private boolean retainActiveBedrockTarget(final boolean sameTarget, final BlockPos position) {
+        if (!BedrockInputPermissions.isBedrockConnection()) return sameTarget;
+        // Survival tool changes retain native progress. Other modes keep Java's item check.
+        // An inactive restored target still needs a fresh Start and cannot reuse Java's old target.
+        return this.isDestroying && (sameTarget || this.getPlayerMode() == GameType.SURVIVAL
+                && this.destroyBlockPos.equals(position));
+    }
+
+    @Inject(method = "stopDestroyBlock", at = @At("HEAD"), require = 1)
+    private void cancelBedrockMiningGesture(final CallbackInfo ci) {
+        this.viaFabricPlusBedrock$completedTarget = null;
+        this.viaFabricPlusBedrock$miningDeadline = 0;
+        BedrockMiningInput.send(false);
+    }
+
+    @Inject(method = "startDestroyBlock", at = @At("HEAD"), require = 1)
+    private void beginFreshBedrockMining(final BlockPos position, final Direction direction,
+                                        final CallbackInfoReturnable<Boolean> cir) {
+        if (!this.viaFabricPlusBedrock$automaticStart) {
+            this.viaFabricPlusBedrock$completedTarget = null;
+            this.viaFabricPlusBedrock$miningDeadline = 0;
+            BedrockMiningInput.send(false);
+        }
+    }
+
+    @Inject(method = "tick", at = @At("TAIL"), require = 1)
+    private void advanceBedrockMiningPause(final CallbackInfo ci) {
+        if (this.viaFabricPlusBedrock$miningPause > 0) this.viaFabricPlusBedrock$miningPause--;
+    }
+
+    @WrapOperation(method = "continueDestroyBlock", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/multiplayer/MultiPlayerGameMode;startDestroyBlock(Lnet/minecraft/core/BlockPos;Lnet/minecraft/core/Direction;)Z"), require = 1)
+    private boolean beginBedrockContinuation(final MultiPlayerGameMode mode, final BlockPos position,
+                                             final Direction direction, final Operation<Boolean> original) {
+        final boolean bedrock = BedrockInputPermissions.isBedrockConnection();
+        final boolean retained = BedrockMiningInput.applies() && this.viaFabricPlusBedrock$completedTarget != null;
+        if (retained && System.nanoTime() < this.viaFabricPlusBedrock$miningDeadline) return false;
+        if (!retained && bedrock && this.viaFabricPlusBedrock$miningPause > 0) return false;
+        final boolean newTarget = retained && !position.equals(this.viaFabricPlusBedrock$completedTarget);
+        final boolean started;
+        this.viaFabricPlusBedrock$automaticStart = true;
+        try {
+            started = original.call(mode, position, direction);
+        } finally {
+            this.viaFabricPlusBedrock$automaticStart = false;
+        }
+        if (started) {
+            this.viaFabricPlusBedrock$completedTarget = null;
+            this.viaFabricPlusBedrock$miningDeadline = 0;
+        }
+        // Retargeting initializes native progress; a fresh press already contributes in its start tick.
+        return bedrock && started && this.isDestroying && !newTarget ? mode.continueDestroyBlock(position, direction) : started;
+    }
+
+    @ModifyExpressionValue(method = "continueDestroyBlock", at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/world/level/block/state/BlockState;getDestroyProgress(Lnet/minecraft/world/entity/player/Player;Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;)F"), require = 1)
+    private float captureBedrockMiningRate(final float rate) {
+        this.viaFabricPlusBedrock$miningRate = rate;
+        return rate;
+    }
+
+    @ModifyConstant(method = "continueDestroyBlock", constant = @Constant(floatValue = 1F, ordinal = 3), require = 1)
+    private float nativeBedrockCompletionThreshold(final float javaThreshold) {
+        // Java 26.3's fourth 1F is the accumulated-progress comparison, after tutorial/tick constants.
+        return BedrockInputPermissions.isBedrockConnection() ? 0.99999F : javaThreshold;
+    }
+
+    @ModifyConstant(method = "continueDestroyBlock", constant = @Constant(intValue = 5, ordinal = 1), require = 1)
+    private int closeCompletedBedrockGesture(final int javaDelay) {
+        if (!BedrockInputPermissions.isBedrockConnection()) return javaDelay;
+        if (BedrockMiningInput.applies()) {
+            this.viaFabricPlusBedrock$completedTarget = this.destroyBlockPos.immutable();
+            // Native applies no additional wait when one update can already break the block.
+            this.viaFabricPlusBedrock$miningDeadline = System.nanoTime()
+                    + (this.viaFabricPlusBedrock$miningRate >= 0.99999F ? 0 : 250_000_000L);
+            this.viaFabricPlusBedrock$miningPause = 0;
+        } else {
+            // Old cores still require a closing input before a restored target can start again.
+            this.viaFabricPlusBedrock$miningPause = 2;
+        }
+        return 0;
+    }
+}
