diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/misc/MixinBedrockMining.java b/src/main/java/com/viaversion/viafabricplus/bedrock/injection/mixin/features/misc/MixinBedrockMining.java
