+import net.raphimc.viabedrock.api.model.FlightMovementContext;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class BedrockFlightPhysicsTest {
+
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void keepsRawJumpAndRejectsUnnegotiatedOrUncontrolledActorsAcrossTransitions() {
+        final LocalPlayer player = mock(LocalPlayer.class);
+        final Minecraft client = mock(Minecraft.class);
+        final Abilities abilities = new Abilities();
+        abilities.flying = true;
+        when(player.getAbilities()).thenReturn(abilities);
+        when(player.isJumping()).thenReturn(true);
+        when(client.getCameraEntity()).thenReturn(player);
+        try (final var connection = mockStatic(BedrockInputPermissions.class);
+             final var game = mockStatic(Minecraft.class);
+             final var effects = mockStatic(BedrockMovementEffects.class)) {
+            game.when(Minecraft::getInstance).thenReturn(client);
+            connection.when(BedrockInputPermissions::isBedrockConnection).thenReturn(false);
+            assertFalse(BedrockFlightPhysics.applies(player));
+            assertFalse(BedrockFlightPhysics.retainSwimming(player, false, true));
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            connection.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            assertFalse(BedrockFlightPhysics.applies(player));
+            assertFalse(BedrockFlightPhysics.retainSwimming(player, false, true));
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            effects.when(() -> BedrockMovementEffects.flightContext(0))
+                    .thenReturn(new FlightMovementContext(0, 1, 0, 1F, false, 1F, 1F));
+            assertTrue(BedrockFlightPhysics.applies(player));
+            assertTrue(BedrockFlightPhysics.retainSwimming(player, false, true));
+            assertFalse(BedrockFlightPhysics.retainSwimming(player, true, false));
+            assertFalse(BedrockFlightPhysics.retainSwimming(mock(Player.class), false, true));
+            assertFalse(BedrockFlightPhysics.isJumping(player));
+            assertTrue(player.isJumping());
+            abilities.flying = false;
+            assertFalse(BedrockFlightPhysics.retainSwimming(player, false, true));
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            abilities.flying = true;
+            when(player.isPassenger()).thenReturn(true);
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            when(player.isPassenger()).thenReturn(false);
+            when(client.getCameraEntity()).thenReturn(null);
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            when(client.getCameraEntity()).thenReturn(player);
+            effects.when(() -> BedrockMovementEffects.flightContext(0)).thenReturn(null);
+            assertTrue(BedrockFlightPhysics.isJumping(player));
+            assertFalse(BedrockFlightPhysics.retainSwimming(player, false, true));
+            verify(player, never()).setJumping(anyBoolean());
+        }
+    }
+    @Test
+    void appliesNativeSwimmingOnceAndLeavesJavaAndMissingWaterUnchanged() {
+        final LocalPlayer player = mock(LocalPlayer.class);
+        final Minecraft client = mock(Minecraft.class);
+        final ClientLevel level = mock(ClientLevel.class);
+        final Abilities abilities = new Abilities();
+        abilities.flying = true;
+        when(player.getAbilities()).thenReturn(abilities);
+        when(client.getCameraEntity()).thenReturn(player);
+        when(player.level()).thenReturn(level);
+        when(player.getEyePosition(0F)).thenReturn(Vec3.ZERO);
+        when(level.getBlockState(any())).thenReturn(Blocks.AIR.defaultBlockState());
+        when(player.getXRot()).thenReturn(90F);
+        when(player.getDeltaMovement()).thenReturn(new Vec3(0.25, 0.2F, -0.5));
+        when(player.isSwimming()).thenReturn(true);
+        when(player.isInWater()).thenReturn(true);
+        when(player.isJumping()).thenReturn(true);
+        try (final var connection = mockStatic(BedrockInputPermissions.class);
+             final var game = mockStatic(Minecraft.class);
+             final var effects = mockStatic(BedrockMovementEffects.class)) {
+            game.when(Minecraft::getInstance).thenReturn(client);
+            effects.when(() -> BedrockMovementEffects.flightContext(0))
+                    .thenReturn(new FlightMovementContext(0, 1, 0, 1F, false, 1F, 1F));
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player, never()).setDeltaMovement(anyDouble(), anyDouble(), anyDouble());
+            connection.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            when(player.isInWater()).thenReturn(false);
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player, never()).setDeltaMovement(anyDouble(), anyDouble(), anyDouble());
+            when(player.isInWater()).thenReturn(true);
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player).setDeltaMovement(0.25, (double) Float.intBitsToFloat(0xBFAE147B), -0.5);
+            clearInvocations(player);
+            when(level.getBlockState(any())).thenReturn(Blocks.STONE.defaultBlockState());
+            when(player.getDeltaMovement()).thenReturn(new Vec3(0.25, -0.03125F, -0.5));
+            when(player.getXRot()).thenReturn(Float.intBitsToFloat((int) 3263193103L));
+            player.xRotO = -90F;
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player).setDeltaMovement(0.25, (double) Float.intBitsToFloat(1066860373), -0.5);
+            clearInvocations(player);
+            player.xRotO = 0F;
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player).setDeltaMovement(0.25, (double) Float.intBitsToFloat(1066859918), -0.5);
+            clearInvocations(player);
+            effects.when(() -> BedrockMovementEffects.flightContext(0)).thenReturn(null);
+            BedrockFlightPhysics.applySwimmingControl(player);
+            verify(player, never()).setDeltaMovement(anyDouble(), anyDouble(), anyDouble());
+            verify(player, never()).getLookAngle();
+            verify(player, never()).setJumping(anyBoolean());
+        }
+    }
+}
