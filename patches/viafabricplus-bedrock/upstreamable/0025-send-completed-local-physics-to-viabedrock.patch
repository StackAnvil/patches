+
+@Mixin(AbstractHorse.class)
+public abstract class MixinHorsePhysicsState implements PhysicalStateAccess.Horse {
+    @Shadow private int eatingCounter;
+    @Shadow private int mouthCounter;
+    @Shadow private int standCounter;
+    @Shadow private int tailCounter;
+    @Shadow private int sprintCounter;
+    @Shadow private float playerJumpPendingScale;
+    @Shadow private boolean allowStandSliding;
+    @Shadow private float eatAnim;
+    @Shadow private float eatAnimO;
+    @Shadow private float standAnim;
+    @Shadow private float standAnimO;
+    @Shadow private float mouthAnim;
+    @Shadow private float mouthAnimO;
+    @Shadow @Final private static EntityDataAccessor<Byte> DATA_ID_FLAGS;
+
+    @Override
+    public void captureHorsePhysics(final PhysicalState.Builder state) {
+        final var data = ((AbstractHorse) (Object) this).getEntityData();
+        state.capture(Field.FLAGS, data.get(DATA_ID_FLAGS), value -> data.set(DATA_ID_FLAGS, value),
+                UnaryOperator.identity(), Objects::equals, (previous, next) -> {
+                    final int changed = previous ^ next;
+                    data.set(DATA_ID_FLAGS, (byte) ((data.get(DATA_ID_FLAGS) & ~changed) | (next & changed)));
+                });
+        state.capture(Field.EATING_COUNTER, this.eatingCounter, value -> this.eatingCounter = value);
+        state.capture(Field.MOUTH_COUNTER, this.mouthCounter, value -> this.mouthCounter = value);
+        state.capture(Field.STAND_COUNTER, this.standCounter, value -> this.standCounter = value);
+        state.capture(Field.TAIL_COUNTER, this.tailCounter, value -> this.tailCounter = value);
+        state.capture(Field.SPRINT_COUNTER, this.sprintCounter, value -> this.sprintCounter = value);
+        state.capture(Field.PLAYER_JUMP_PENDING_SCALE, this.playerJumpPendingScale, value -> this.playerJumpPendingScale = value);
+        state.capture(Field.ALLOW_STAND_SLIDING, this.allowStandSliding, value -> this.allowStandSliding = value);
+        state.capture(Field.EAT_ANIM, this.eatAnim, value -> this.eatAnim = value);
+        state.capture(Field.EAT_ANIM_O, this.eatAnimO, value -> this.eatAnimO = value);
+        state.capture(Field.STAND_ANIM, this.standAnim, value -> this.standAnim = value);
+        state.capture(Field.STAND_ANIM_O, this.standAnimO, value -> this.standAnimO = value);
+        state.capture(Field.MOUTH_ANIM, this.mouthAnim, value -> this.mouthAnim = value);
+        state.capture(Field.MOUTH_ANIM_O, this.mouthAnimO, value -> this.mouthAnimO = value);
+    }
+
+    private enum Field {
+        FLAGS,
+        EATING_COUNTER, MOUTH_COUNTER, STAND_COUNTER, TAIL_COUNTER, SPRINT_COUNTER, PLAYER_JUMP_PENDING_SCALE, ALLOW_STAND_SLIDING, EAT_ANIM, EAT_ANIM_O, STAND_ANIM, STAND_ANIM_O, MOUTH_ANIM, MOUTH_ANIM_O
+    }
