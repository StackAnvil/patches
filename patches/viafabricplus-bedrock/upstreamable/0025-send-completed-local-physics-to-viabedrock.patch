+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.player.LocalPlayer;
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+import net.raphimc.viabedrock.api.model.PlayerCorrectionTracker;
+
+public final class BedrockPlayerCorrections {
+    private static final PlayerCorrectionTracker TRACKER = new PlayerCorrectionTracker();
+
+    private BedrockPlayerCorrections() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(PlayerCorrectionPayload.TYPE, PlayerCorrectionPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            TRACKER.clear();
+            ClientPlayNetworking.registerReceiver(PlayerCorrectionPayload.TYPE,
+                (payload, context) -> {
+                    if (context.client().getConnection() == listener && BedrockInputPermissions.isBedrockConnection()) {
+                        TRACKER.accept(payload.correction());
+                    }
+                });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> TRACKER.clear());
+    }
+
+    public static void apply(final LocalPlayer player, final int teleportId) {
+        if (player == null || !BedrockInputPermissions.isBedrockConnection()) {
+            TRACKER.clear();
+            return;
+        }
+        final PlayerCorrection correction = TRACKER.consume(player.getId(), teleportId);
+        if (correction != null && !player.isPassenger()) {
+            player.setOnGround(correction.onGround());
+        }
+    }
+}
