+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class PhysicalStateTest {
+    @Test
+    void ownsMutableValuesAcrossCaptureAndRepeatedRestore() {
+        final Fixture actor = new Fixture();
+        final PhysicalState saved = actor.capture();
+        actor.values.add(9);
+        actor.position = 30;
+        saved.restore();
+        assertEquals(List.of(2, 3), actor.values);
+        assertEquals(1, actor.position);
+        actor.values.clear();
+        saved.restore();
+        assertEquals(List.of(2, 3), actor.values);
+    }
+
+    @Test
+    void reappliesExternalChangesWithoutReplacingCorrectedMotionWithOldPrediction() {
+        final Fixture actor = new Fixture();
+        final PhysicalState completed = actor.capture();
+        actor.position = 7; // A server position command between completed ticks.
+        final PhysicalState.Changes commands = actor.capture().changesSince(completed);
+        actor.position = 22;
+        actor.motion = -4; // Motion recomputed by an earlier corrected frame.
+        commands.apply();
+        assertEquals(7, actor.position);
+        assertEquals(-4, actor.motion);
+    }
+
+    @Test
+    void preservesCaptureOrderAndDoesNotLetBuilderReuseMutateExistingSnapshot() {
+        final Object owner = new Object();
+        final List<Integer> writes = new ArrayList<>();
+        final var builder = PhysicalState.builder(owner).capture(Field.POSITION, 3, writes::add);
+        final PhysicalState first = builder.build();
+        builder.capture(Field.MOTION, 4, writes::add);
+        final PhysicalState second = builder.build();
+        first.restore();
+        second.restore();
+        assertEquals(List.of(3, 3, 4), writes);
+    }
+
+    @Test
+    void rejectsReusingCommandsAcrossActorIdentityOrComponentLayout() {
+        final Fixture first = new Fixture();
+        final Fixture replacement = new Fixture();
+        assertThrows(IllegalArgumentException.class, () -> replacement.capture().changesSince(first.capture()));
+        final var incomplete = PhysicalState.builder(first).capture(Field.MOTION, first.motion, value -> first.motion = value).build();
+        assertThrows(IllegalArgumentException.class, () -> first.capture().changesSince(incomplete));
+    }
+
+    @Test
+    void copiesArgumentsAgainWhenReconciliationMutatesItsInputs() {
+        final Fixture actor = new Fixture();
+        final var first = actor.captureReconciled();
+        actor.values.add(8);
+        final var commands = actor.captureReconciled().changesSince(first);
+        actor.values.clear();
+        commands.apply();
+        assertEquals(List.of(8), actor.values);
+        actor.values.clear();
+        commands.apply();
+        assertEquals(List.of(8), actor.values);
+    }
+
+    @Test
+    void restoresKinematicsAfterMetadataCallbacksAndDoesNotReadmitOwnedJournalValues() {
+        final Fixture actor = new Fixture();
+        final var before = PhysicalState.builder(actor)
+                .snapshotLate(Field.POSITION, actor.position, value -> actor.position = value)
+                .capture(Field.MOTION, actor.motion, value -> {
+                    actor.motion = value;
+                    actor.position = 90;
+                }).build();
+        actor.position = 18;
+        before.restore();
+        assertEquals(1, actor.position);
+        assertEquals(5, actor.motion);
+        actor.position = 22;
+        final var after = PhysicalState.builder(actor)
+                .snapshotLate(Field.POSITION, actor.position, value -> actor.position = value)
+                .capture(Field.MOTION, actor.motion, value -> actor.motion = value).build();
+        assertTrue(after.changesSince(before).isEmpty());
+    }
+
+    private static final class Fixture {
+        private int position = 1;
+        private int motion = 5;
+        private List<Integer> values = new ArrayList<>(List.of(2, 3));
+
+        private PhysicalState capture() {
+            return PhysicalState.builder(this)
+                    .capture(Field.POSITION, this.position, value -> this.position = value)
+                    .capture(Field.MOTION, this.motion, value -> this.motion = value)
+                    .capture(Field.VALUES, this.values, value -> this.values = value, ArrayList::new, Objects::equals)
+                    .build();
+        }
+
+        private PhysicalState captureReconciled() {
+            return PhysicalState.builder(this)
+                    .capture(Field.VALUES, this.values, value -> this.values = value, ArrayList::new, Objects::equals,
+                            (previous, next) -> {
+                                next.removeAll(previous);
+                                this.values.addAll(next);
+                            }).build();
+        }
+    }
+
+    private enum Field { POSITION, MOTION, VALUES }
+}
