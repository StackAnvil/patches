+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+import net.raphimc.viabedrock.api.model.ActorMotionCommand;
+
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.entity.Entity;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Player, vehicle, and seat members share one capture and one chronological replay. */
+public final class PhysicalGraphState {
+    private final Map<Entity, PhysicalActorState> actors;
+    private final long controlLease;
+
+    private PhysicalGraphState(final Map<Entity, PhysicalActorState> actors, final long controlLease) {
+        this.actors = Collections.unmodifiableMap(new IdentityHashMap<>(actors));
+        this.controlLease = controlLease;
+    }
+
+    public static PhysicalGraphState capture(final Iterable<Entity> actors, final Iterable<Entity> members, final long controlLease) {
+        final Map<Entity, PhysicalActorState> values = new IdentityHashMap<>();
+        actors.forEach(actor -> values.put(actor, PhysicalActorState.capture(actor)));
+        members.forEach(actor -> {
+            if (!values.containsKey(actor)) values.put(actor, PhysicalActorState.relationships(actor));
+        });
+        return new PhysicalGraphState(values, controlLease);
+    }
+
+    public PhysicalActorState correctionTarget(final Entity actor, final LocalPlayer player,
+                                                final PlayerCorrection command, final long currentLease) {
+        final PhysicalActorState state = this.actors.get(actor);
+        return state != null && state.accepts(command, player) && (!command.vehicle() || this.controlLease == currentLease) ? state : null;
+    }
+
+    public boolean acceptsMotion(final Entity actor, final LocalPlayer player, final ActorMotionCommand command, final long currentLease) {
+        final PhysicalActorState state = this.actors.get(actor);
+        return state != null && state.accepts(command, player) && (!command.vehicle() || this.controlLease == currentLease);
+    }
+
+    public boolean valid(final LocalPlayer player) {
+        return this.actors.values().stream().allMatch(actor -> actor.valid(player));
+    }
+
+    public void restore() {
+        this.actors.values().forEach(PhysicalActorState::restore);
+    }
+
+    /** Refresh the historical graph's participants, independently of today's mount and seat layout. */
+    public PhysicalGraphState recapture() {
+        final Map<Entity, PhysicalActorState> values = new IdentityHashMap<>();
+        this.actors.forEach((actor, previous) -> values.put(actor,
+                previous.physical() ? PhysicalActorState.capture(actor) : PhysicalActorState.relationships(actor)));
+        return new PhysicalGraphState(values, this.controlLease);
+    }
+
+    public Changes changesSince(final PhysicalGraphState previous) {
+        final List<Runnable> changes = new ArrayList<>();
+        this.actors.forEach((actor, value) -> {
+            final PhysicalActorState before = previous.actors.get(actor);
+            if (before == null || before.physical() != value.physical()) changes.add(value::restore);
+            else {
+                if (!java.util.Objects.equals(value.metadata(), before.metadata())) {
+                    changes.add(() -> PhysicalReplayContext.actor(value.uuid(), value.metadata()));
+                }
+                changes.add(value.state().changesSince(before.state())::apply);
+            }
+        });
+        return new Changes(changes);
+    }
+
+    public record Changes(List<Runnable> values) {
+        public Changes {
+            values = List.copyOf(values);
+        }
+
+        public void apply() {
+            this.values.forEach(Runnable::run);
+        }
+    }
+}
