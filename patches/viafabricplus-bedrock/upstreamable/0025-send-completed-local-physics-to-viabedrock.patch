+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.network.Connection;
+import net.minecraft.world.level.GameType;
+import net.raphimc.viabedrock.api.model.PlayerInputPermissions;
+import java.util.EnumMap;
+import java.util.IdentityHashMap;
+import net.minecraft.world.level.Level;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.Supplier;
+
+/** Historical physics runs on the client thread. Other threads retain normal network and world behavior. */
+public final class PhysicalReplayContext {
+    private static final ThreadLocal<State> CURRENT = new ThreadLocal<>();
+    private static final ThreadLocal<PhysicalStep> RECORDING = new ThreadLocal<>();
+
+    private PhysicalReplayContext() {}
+
+    public static Scope enter(final Level level, final Connection connection, final Set<Entity> predictedActors) {
+        if (CURRENT.get() != null) throw new IllegalStateException("Physical replay is already running");
+        CURRENT.set(new State(level, connection, predictedActors));
+        return CURRENT::remove;
+    }
+
+    public static boolean replaying() {
+        return CURRENT.get() != null;
+    }
+
+    public static boolean predicts(final Entity actor) {
+        final State state = CURRENT.get();
+        return state != null && (state.step == null ? state.actors : state.step.predictedActors).contains(actor);
+    }
+
+    public static boolean recording() {
+        return RECORDING.get() != null;
+    }
+
+    public static boolean suppressesNetwork(final Connection connection) {
+        final State state = CURRENT.get();
+        return state != null && state.connection == connection;
+    }
+
+    public static PlayerInputPermissions permissions(final PlayerInputPermissions live) {
+        final State state = CURRENT.get();
+        return state != null && state.permissions != null ? state.permissions : live;
+    }
+
+    public static void restorePermissions(final PlayerInputPermissions value) {
+        CURRENT.get().permissions = value;
+    }
+
+    public static GameType gameMode(final GameType live) {
+        final State state = CURRENT.get();
+        return state != null && state.gameMode != null ? state.gameMode : live;
+    }
+
+    public static void restoreGameMode(final GameType value) {
+        CURRENT.get().gameMode = value;
+    }
+
+    public static Entity camera(final Entity liveCamera) {
+        final State state = CURRENT.get();
+        return state != null && state.step != null ? state.step.camera : liveCamera;
+    }
+
+    public static void recordItemUse(final Entity actor, final PhysicalItemUse use) {
+        final PhysicalStep recording = RECORDING.get();
+        if (recording != null) recording.itemUse.put(actor, use);
+    }
+
+    public static PhysicalItemUse itemUse(final Entity actor) {
+        final State state = CURRENT.get();
+        if (state == null || state.step == null || !state.step.itemUse.containsKey(actor)) {
+            throw new IllegalStateException("Historical physics requested unrecorded item-use input");
+        }
+        return state.step.itemUse.get(actor);
+    }
+
+    public static ItemStack equipment(final LivingEntity actor, final EquipmentSlot slot) {
+        final State state = CURRENT.get();
+        if (state == null || state.step == null) return null;
+        final var equipment = state.step.equipment.get(actor);
+        return equipment == null ? null : equipment.get(slot).copy();
+    }
+
+    public static void frame(final long frame) {
+        CURRENT.get().frame = frame;
+    }
+
+    public static long completedFrame(final long liveFrame) {
+        final State state = CURRENT.get();
+        return state == null ? liveFrame : state.frame - 1;
+    }
+
+    public static Long gameTime(final Level level) {
+        final State state = CURRENT.get();
+        return state != null && state.level == level && state.step != null ? state.step.gameTime : null;
+    }
+
+    public static NativeActorMessage.Snapshot actor(final UUID uuid, final Supplier<NativeActorMessage.Snapshot> live) {
+        final State state = CURRENT.get();
+        return state != null && state.metadata.containsKey(uuid) ? state.metadata.get(uuid) : live.get();
+    }
+
+    public static void actor(final UUID uuid, final NativeActorMessage.Snapshot value) {
+        CURRENT.get().metadata.put(uuid, value);
+    }
+
+    public static PhysicalCollisionCache collisions(final Entity actor) {
+        final State state = CURRENT.get();
+        if (state != null) {
+            if (state.step == null || !state.step.predictedActors.contains(actor)) return null;
+            return state.collisions.computeIfAbsent(actor, entity -> new PhysicalCollisionCache(
+                    PhysicalCollisions.position(entity.position()), state.step.collisionInputs.get(entity)));
+        }
+        final PhysicalStep recording = RECORDING.get();
+        if (recording == null || !recording.predictedActors.contains(actor)) return null;
+        return recording.collisions.computeIfAbsent(actor, entity -> new PhysicalCollisionCache(PhysicalCollisions.position(entity.position()), null));
+    }
+
+    public static void poll(final net.minecraft.client.player.ClientInput input, final Runnable livePoll) {
+        final State state = CURRENT.get();
+        if (state != null) {
+            if (state.step == null || state.poll >= state.step.inputs.size()) {
+                throw new IllegalStateException("Historical physics requested an unrecorded input poll");
+            }
+            state.step.inputs.get(state.poll++).restore(input);
+        } else {
+            livePoll.run();
+            final PhysicalStep recording = RECORDING.get();
+            if (recording != null) recording.inputs.add(PhysicalInput.capture(input));
+        }
+    }
+
+    public static final class PhysicalStep {
+        private final long gameTime;
+        private final Runnable run;
+        private final Runnable historical;
+        private final Set<Entity> predictedActors;
+        private final Entity camera;
+        private final Map<Entity, PhysicalItemUse> itemUse = new IdentityHashMap<>();
+        private final Map<LivingEntity, Map<EquipmentSlot, ItemStack>> equipment = new IdentityHashMap<>();
+        private final java.util.List<PhysicalInput> inputs = new java.util.ArrayList<>();
+        private final Map<Entity, PhysicalCollisionCache.Snapshot> collisionInputs = new IdentityHashMap<>();
+        private final Map<Entity, PhysicalCollisionCache> collisions = new IdentityHashMap<>();
+
+        public PhysicalStep(final long gameTime, final Set<Entity> predictedActors, final Entity camera,
+                            final Iterable<Entity> actors, final Runnable run) {
+            this(gameTime, predictedActors, camera, actors, run, run);
+        }
+
+        public PhysicalStep(final long gameTime, final Set<Entity> predictedActors, final Entity camera,
+                            final Iterable<Entity> actors, final Runnable run, final Runnable historical) {
+            this.gameTime = gameTime;
+            this.run = run;
+            this.historical = historical;
+            final Set<Entity> owned = java.util.Collections.newSetFromMap(new IdentityHashMap<>());
+            owned.addAll(predictedActors);
+            this.predictedActors = java.util.Collections.unmodifiableSet(owned);
+            this.camera = camera;
+            actors.forEach(actor -> {
+                if (!(actor instanceof LivingEntity living)) return;
+                final Map<EquipmentSlot, ItemStack> equipment = new EnumMap<>(EquipmentSlot.class);
+                for (EquipmentSlot slot : EquipmentSlot.values()) equipment.put(slot, living.getItemBySlot(slot).copy());
+                this.equipment.put(living, equipment);
+            });
+        }
+
+        public void record() {
+            final PhysicalStep previous = RECORDING.get();
+            RECORDING.set(this);
+            try {
+                this.run.run();
+            } finally {
+                this.collisions.forEach((actor, cache) -> this.collisionInputs.put(actor, cache.snapshot()));
+                this.collisions.clear();
+                if (previous == null) RECORDING.remove();
+                else RECORDING.set(previous);
+            }
+        }
+
+        public void replay() {
+            final State state = CURRENT.get();
+            state.step = this;
+            state.poll = 0;
+            state.collisions.clear();
+            try {
+                this.historical.run();
+                if (state.poll != this.inputs.size()) throw new IllegalStateException("Historical physics skipped a recorded input poll");
+            } finally {
+                state.step = null;
+                state.poll = 0;
+                state.collisions.clear();
+            }
+        }
+    }
+
+    public interface Scope extends AutoCloseable {
+        @Override void close();
+    }
+
+    private static final class State {
+        private final Level level;
+        private final Connection connection;
+        private final Set<Entity> actors;
+        private final Map<UUID, NativeActorMessage.Snapshot> metadata = new HashMap<>();
+        private PlayerInputPermissions permissions;
+        private GameType gameMode;
+        private long frame = -1;
+        private PhysicalStep step;
+        private final Map<Entity, PhysicalCollisionCache> collisions = new IdentityHashMap<>();
+        private int poll;
+
+        private State(final Level level, final Connection connection, final Set<Entity> actors) {
+            this.level = level;
+            this.connection = connection;
+            this.actors = actors;
+        }
+    }
+}
