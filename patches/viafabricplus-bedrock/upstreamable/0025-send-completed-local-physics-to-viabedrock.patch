+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BedrockFluidPhysicsTest {
+
+    @Test
+    void liquidJumpSuppressionIncludesTheHeadBoundaryAndBothBlendTransitions() {
+        for (final float blend : new float[]{0F, 0.1F, 0.5F, 0.9F, 1F}) {
+            assertTrue(BedrockFluidPhysics.shouldSuppressLiquidJump(blend, true, false));
+            assertEquals(blend > 0F && blend < 1F, BedrockFluidPhysics.shouldSuppressLiquidJump(blend, true, true));
+            assertEquals(blend > 0F && blend < 1F, BedrockFluidPhysics.shouldSuppressLiquidJump(blend, false, false));
+            assertEquals(blend > 0F && blend < 1F, BedrockFluidPhysics.shouldSuppressLiquidJump(blend, false, true));
+        }
+    }
+
+    @Test
+    void waterSurfaceUsesTheNativeDepthOffsetForSourceFlowingAndFallingWater() {
+        for (final int blockY : new int[]{-64, -1, 0, 104, 319}) {
+            assertEquals((float) (blockY + 1), BedrockFluidPhysics.waterSurface(blockY, 0));
+            for (int depth = 8; depth < 16; depth++) {
+                assertEquals(BedrockFluidPhysics.waterSurface(blockY, 0), BedrockFluidPhysics.waterSurface(blockY, depth));
+            }
+            for (int depth = 1; depth < 8; depth++) {
+                final float surface = BedrockFluidPhysics.waterSurface(blockY, depth);
+                assertTrue(surface > blockY);
+                assertTrue(surface < BedrockFluidPhysics.waterSurface(blockY, depth - 1));
+                assertEquals(blockY + 1 - depth / 9D, surface, 0.000016);
+            }
+        }
+    }
+
+    @Test
+    void everyUpwardDirectionCapsOutsideLiquidEvenWhenThePoseCannotChange() {
+        for (final double lookY : new double[]{Double.MIN_VALUE, 0.5, 0.57357644, 0.70710677, 1}) {
+            assertTrue(BedrockFluidPhysics.shouldCapSwimming(lookY, false));
+            assertFalse(BedrockFluidPhysics.shouldCapSwimming(lookY, true));
+        }
+        for (final double lookY : new double[]{-1, -0.5, 0}) {
+            assertFalse(BedrockFluidPhysics.shouldCapSwimming(lookY, false));
+            assertFalse(BedrockFluidPhysics.shouldCapSwimming(lookY, true));
+        }
+    }
+
+    @Test
+    void surfaceRetentionUsesTheNativeHorizontalDotProduct() {
+        for (final double lookY : new double[]{0, 0.5, 0.54, -0.70710677, -1}) {
+            assertTrue(BedrockFluidPhysics.canRemainSwimmingAtSurface(new Vec3(0, lookY, Math.sqrt(1 - lookY * lookY))));
+        }
+        for (final double lookY : new double[]{0.545, 0.57357644, 0.70710677, 1}) {
+            assertFalse(BedrockFluidPhysics.canRemainSwimmingAtSurface(new Vec3(0, lookY, Math.sqrt(1 - lookY * lookY))));
+        }
+        assertEquals(BedrockFluidPhysics.canRemainSwimmingAtSurface(new Vec3(0.5, 0.6, Math.sqrt(0.39))),
+                BedrockFluidPhysics.canRemainSwimmingAtSurface(new Vec3(Math.sqrt(0.39), 0.6, 0.5)));
+    }
+
+    @Test
+    void upwardSwimmingRequiresBothBreathingAndBodyProbesBelowAir() {
+        for (final double lookY : new double[]{0.15F, 0.5, 0.70710677}) {
+            assertTrue(BedrockFluidPhysics.canStartSwimming(lookY, false, false));
+            assertFalse(BedrockFluidPhysics.canStartSwimming(lookY, true, false));
+            assertFalse(BedrockFluidPhysics.canStartSwimming(lookY, false, true));
+            assertFalse(BedrockFluidPhysics.canStartSwimming(lookY, true, true));
+        }
+        for (final double lookY : new double[]{-1, 0, Math.nextDown(0.15F)}) {
+            assertTrue(BedrockFluidPhysics.canStartSwimming(lookY, true, true));
+        }
+    }
+
+    @Test
+    void standingBodyProbeCrossesTheWaterBoundaryAtTheNativeCenter() {
+        assertEquals(new BlockPos(-7, 105, 15), BedrockFluidPhysics.aboveBodyCenter(new AABB(-6.8, 103.17427, 15.2, -6.2, 104.97427, 15.8)));
+        assertEquals(new BlockPos(-7, 104, 15), BedrockFluidPhysics.aboveBodyCenter(new AABB(-6.8, 103.06353, 15.2, -6.2, 104.86353, 15.8)));
+        assertEquals(new BlockPos(-1, 0, -1), BedrockFluidPhysics.aboveBodyCenter(new AABB(-0.6, -1.9, -0.6, 0, -0.1, 0)));
+    }
+
+    @Test
+    void verticalInsetPreservesTheCenterAndNeverExpandsShortBoxes() {
+        for (final double height : new double[]{0, 0.2, 0.6, 0.8, 1.0, 1.8}) {
+            final AABB original = new AABB(-0.3, 104.7, -0.3, 0.3, 104.7 + height, 0.3);
+            final AABB adjusted = BedrockFluidPhysics.interactionBox(original);
+            assertEquals(original.getCenter().y, adjusted.getCenter().y, 1E-12);
+            assertEquals(Math.max(0, height - 0.8), adjusted.getYsize(), 1E-12);
+            assertTrue(adjusted.minY >= original.minY);
+            assertTrue(adjusted.maxY <= original.maxY);
+            assertEquals(original.minX, adjusted.minX);
+            assertEquals(original.maxX, adjusted.maxX);
+            assertEquals(original.minZ, adjusted.minZ);
+            assertEquals(original.maxZ, adjusted.maxZ);
+        }
+    }
+
+}
