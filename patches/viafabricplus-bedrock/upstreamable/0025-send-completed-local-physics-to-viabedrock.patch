diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/input/VehiclePredictionSession.java b/src/main/java/com/viaversion/viafabricplus/bedrock/input/VehiclePredictionSession.java
new file mode 100644
index 0000000..949adc6
--- /dev/null
+++ b/src/main/java/com/viaversion/viafabricplus/bedrock/input/VehiclePredictionSession.java
@@ -0,0 +1,91 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.client.multiplayer.ClientPacketListener;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.animal.equine.AbstractHorse;
+import net.minecraft.world.entity.vehicle.boat.AbstractBoat;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import net.raphimc.viabedrock.api.model.VehiclePrediction;
+import net.raphimc.viabedrock.api.model.VehiclePredictionContext;
+import net.raphimc.viabedrock.protocol.data.enums.bedrock.ActorFlags;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.jetbrains.annotations.Nullable;
+
+/** The server epoch and actor lifetime belong to one joined client connection. */
+final class VehiclePredictionSession {
+    private ClientPacketListener owner;
+    private VehiclePredictionContext context;
+    private long lastFrame = -1;
+
+    void begin(final ClientPacketListener listener) {
+        if (this.owner != listener) {
+            this.owner = listener;
+            this.context = null;
+            this.lastFrame = -1;
+        }
+    }
+
+    void end(final ClientPacketListener listener) {
+        if (this.owner == listener) {
+            this.owner = null;
+            this.context = null;
+            this.lastFrame = -1;
+        }
+    }
+
+    boolean accept(final ClientPacketListener listener, final VehiclePredictionContext value) {
+        if (this.owner == listener && (this.context == null || value.epoch() > this.context.epoch()
+                || value.equals(this.context))) {
+            final boolean changed = !java.util.Objects.equals(this.context == null ? null : this.context.vehicle(), value.vehicle());
+            this.context = value;
+            return changed;
+        }
+        return false;
+    }
+
+    @Nullable VehiclePredictionContext context(final ClientPacketListener listener) {
+        return this.owner == listener ? this.context : null;
+    }
+
+    @Nullable VehiclePrediction sample(final ClientPacketListener listener, final LocalPlayer player, final NativeActorMessage.Snapshot actor, final long frame) {
+        if (this.owner == null || this.owner != listener || this.context == null || this.context.vehicle() == null
+                || frame < 0 || frame <= this.lastFrame || !player.isAlive() || player.isSpectator()) {
+            return null;
+        }
+        final Entity mount = player.getVehicle();
+        if (!(mount instanceof AbstractBoat || mount instanceof AbstractHorse) || mount != player.getRootVehicle()
+                || mount.getControllingPassenger() != player || !mount.isLocalInstanceAuthoritative() || !mount.isAlive()
+                || mount.level() != player.level() || player.level().getEntity(mount.getId()) != mount
+                || !player.level().hasChunkAt(player.blockPosition()) || !player.level().hasChunkAt(mount.blockPosition())) {
+            return null;
+        }
+        final VehiclePredictionContext.Identity identity = this.context.vehicle();
+        if (mount.getId() != identity.javaId() || !mount.getUUID().equals(identity.javaUuid()) || actor == null
+                || !actor.uuid().equals(identity.javaUuid()) || !actor.lifetime().equals(identity.lifetime())
+                || actor.runtimeId() != identity.runtimeId() || actor.uniqueId() == null || actor.uniqueId() != identity.uniqueId()
+                || mount instanceof AbstractHorse && (!actor.flags().contains(ActorFlags.TAMED) || !actor.flags().contains(ActorFlags.SADDLED))) {
+            return null;
+        }
+        final Vec3 motion = mount.getDeltaMovement();
+        final Position3f position = finitePosition(mount.getX(), mount.getY(), mount.getZ());
+        final Position3f velocity = finitePosition(motion.x, motion.y, motion.z);
+        if (position == null || velocity == null || !player.level().hasChunkAt(BlockPos.containing(position.x(), position.y(), position.z()))) {
+            return null;
+        }
+        this.lastFrame = frame;
+        return new VehiclePrediction(frame, this.context, position, velocity);
+    }
+
+    private static @Nullable Position3f finitePosition(final double x, final double y, final double z) {
+        final float fx = (float) x, fy = (float) y, fz = (float) z;
+        return Float.isFinite(fx) && Float.isFinite(fy) && Float.isFinite(fz) ? new Position3f(fx, fy, fz) : null;
+    }
+}
