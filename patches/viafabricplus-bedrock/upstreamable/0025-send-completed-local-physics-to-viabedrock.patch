+package com.viaversion.viafabricplus.bedrock.input;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.client.player.LocalPlayer;
+import net.raphimc.viabedrock.api.model.VehiclePrediction;
+import net.raphimc.viabedrock.api.model.VehiclePredictionContext;
+import org.jetbrains.annotations.Nullable;
+
+public final class BedrockVehiclePredictions {
+    private static final VehiclePredictionSession SESSION = new VehiclePredictionSession();
+
+    private BedrockVehiclePredictions() {}
+
+    public static void register() {
+        PayloadTypeRegistry.serverboundPlay().register(VehiclePredictionPayload.TYPE, VehiclePredictionPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(VehiclePredictionContextPayload.TYPE, VehiclePredictionContextPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            SESSION.begin(listener);
+            ClientPlayNetworking.registerReceiver(VehiclePredictionContextPayload.TYPE, (payload, context) -> {
+                if (context.client().getConnection() == listener) {
+                    if (SESSION.accept(listener, payload.context())) BedrockPhysicalReplay.controlChanged();
+                }
+            });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> SESSION.end(listener));
+    }
+
+    static @Nullable VehiclePredictionContext context(final LocalPlayer player) {
+        return SESSION.context(player.connection);
+    }
+
+    public static @Nullable VehiclePrediction capture(final LocalPlayer player, final long frame) {
+        if (!BedrockInputPermissions.isBedrockConnection() || !player.connection.hasClientLoaded()
+                || !player.connection.getConnection().isConnected() || !ClientPlayNetworking.canSend(VehiclePredictionPayload.TYPE)
+                || !BedrockActorState.supportsUniqueIds() || player.getVehicle() == null) {
+            return null;
+        }
+        return SESSION.sample(player.connection, player, BedrockActorState.state(player.getVehicle().getUUID()), frame);
+    }
+}
