@@ -0,0 +1,272 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Supplier;
+import java.util.stream.Collectors;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class PhysicalReplayHistoryTest {
+    @Test
+    void discardsCommandsAfterAuthorityReplacementWithoutRestoringOrReexecutingPhysics() {
+        final Fixture actor = new Fixture(20);
+        final boolean[] controlled = {true};
+        actor.tick(0);
+        actor.tick(1);
+        actor.executed.clear();
+        assertTrue(actor.history.schedule(0, ignored -> controlled[0], () -> actor.motion = 100, true));
+        controlled[0] = false;
+        final int position = actor.position;
+        assertFalse(actor.history.replay());
+        assertEquals(position, actor.position);
+        assertTrue(actor.executed.isEmpty());
+        assertTrue(actor.history.schedule(1, ignored -> true, () -> actor.motion = 10, true));
+        assertTrue(actor.history.replay());
+        assertEquals(List.of(1), actor.executed);
+        assertFalse(actor.history.replay());
+    }
+
+    @Test
+    void restoresThenRerunsEveryRetainedInputInsteadOfAddingPositionDeltas() {
+        final Fixture actor = new Fixture(20);
+        actor.tick(0);
+        actor.tick(1);
+        actor.tick(2);
+        actor.history.begin(3);
+        actor.executed.clear();
+        assertTrue(actor.history.schedule(1, ignored -> true, () -> actor.motion = 10, true));
+        assertTrue(actor.history.replay());
+        assertEquals(List.of(1, 2), actor.executed);
+        assertEquals(20, actor.position);
+        assertEquals(8, actor.motion);
+        // The open frame is ready for ordinary physics, which still runs exactly once.
+        actor.step(3);
+        actor.history.complete(3);
+        assertEquals(List.of(1, 2, 3), actor.executed);
+        assertEquals(28, actor.position);
+    }
+
+    @Test
+    void refreshesLaterSnapshotsAndReappliesOnlyExternalCommands() {
+        final Fixture actor = new Fixture(20);
+        actor.tick(0);
+        actor.motion = 6;
+        actor.tick(1);
+        actor.tick(2);
+        actor.history.begin(3);
+        assertTrue(actor.history.schedule(0, ignored -> true, () -> actor.motion = 10, true));
+        actor.history.replay();
+        assertEquals(21, actor.position); // 10, then the server's 6, then 5.
+        actor.executed.clear();
+        assertTrue(actor.history.schedule(2, ignored -> true, () -> actor.motion = -3, true));
+        actor.history.replay();
+        assertEquals(List.of(2), actor.executed);
+        assertEquals(13, actor.position); // Refreshed frame two starts at 16, not the original 6.
+    }
+
+    @Test
+    void transfersCurrentTickCommandsIntoTheNextCaptureAndRetainsFutureCommandsWithoutDirtying() {
+        final Fixture actor = new Fixture(20);
+        actor.tick(0);
+        actor.tick(1);
+        assertTrue(actor.history.schedule(1, ignored -> true, () -> actor.motion = 7, false));
+        assertFalse(actor.history.replay());
+        assertTrue(actor.history.schedule(2, ignored -> true, () -> actor.motion = 12, true));
+        actor.history.begin(2);
+        assertTrue(actor.history.replay());
+        assertEquals(12, actor.motion);
+        assertTrue(actor.history.schedule(0, ignored -> true, () -> actor.position = 8, true));
+        actor.executed.clear();
+        actor.history.replay();
+        assertEquals(List.of(0, 1), actor.executed);
+        assertEquals(16, actor.position);
+        assertEquals(12, actor.motion);
+    }
+
+    @Test
+    void validatesTheEntireGraphSuffixBeforeAnyRestoreAndDropsDiscontinuousHistory() {
+        final Fixture actor = new Fixture(20);
+        actor.tick(0);
+        actor.tick(1);
+        actor.history.schedule(0, ignored -> true, () -> actor.position = 100, true);
+        actor.valid = false;
+        final int live = actor.position;
+        assertFalse(actor.history.replay());
+        assertEquals(live, actor.position);
+        assertEquals(2, actor.executed.size());
+        actor.valid = true;
+        actor.tick(7);
+        assertFalse(actor.history.schedule(1, ignored -> true, () -> actor.position = 100, true));
+    }
+
+    @Test
+    void evictsOldFramesAndAllowsSeveralOrderedCommandsForOneFrame() {
+        final Fixture actor = new Fixture(2);
+        actor.tick(0);
+        actor.tick(1);
+        actor.tick(2);
+        assertFalse(actor.history.schedule(0, ignored -> true, () -> actor.position = 100, true));
+        actor.history.schedule(1, ignored -> true, () -> actor.motion = 10, true);
+        actor.history.schedule(1, ignored -> true, () -> actor.motion *= 2, true);
+        actor.history.replay();
+        assertEquals(40, actor.position);
+    }
+
+    @Test
+    void reexecutesAnExplicitVelocityCommandBetweenFramesWithoutRestoringOldPredictedMotion() {
+        final int[] actor = {0, 1};
+        final Object owner = new Object();
+        final Supplier<PhysicalState> capture = () -> PhysicalState.builder(owner)
+                        .snapshotLate(Part.POSITION, actor[0], value -> actor[0] = value)
+                        .snapshotLate(Part.MOTION, actor[1], value -> actor[1] = value).build();
+        final PhysicalReplayHistory<PhysicalState> history = new PhysicalReplayHistory<>(20, capture, ignored -> capture.get(), PhysicalState::restore,
+                (previous, next) -> next.changesSince(previous)::apply, ignored -> true, frame -> {}, frame -> {});
+        final Runnable physics = () -> {
+            actor[0] += actor[1];
+            actor[1]--;
+        };
+        history.begin(0);
+        history.record(physics);
+        physics.run();
+        history.complete(0);
+        actor[1] = 6;
+        history.begin(1);
+        history.admitExternal(List.of(() -> actor[1] = 6));
+        history.record(physics);
+        physics.run();
+        history.complete(1);
+        history.schedule(0, ignored -> true, () -> actor[1] = 10, true);
+        history.replay();
+        assertArrayEquals(new int[]{16, 5}, actor);
+        history.schedule(1, ignored -> true, () -> actor[1] = 20, true);
+        history.replay();
+        assertArrayEquals(new int[]{30, 19}, actor);
+    }
+
+    @Test
+    void refreshesEachHistoricalMountLayoutWithoutAddingTodaysParticipantsToEarlierFrames() {
+        final GraphActor player = new GraphActor();
+        final GraphActor oldMount = new GraphActor();
+        final GraphActor nextMount = new GraphActor();
+        final GraphActor currentMount = new GraphActor();
+        final GraphFixture graph = new GraphFixture();
+        graph.active.addAll(List.of(player, oldMount));
+        graph.tick(0, () -> { player.position++; oldMount.position += 10; });
+        graph.active.remove(oldMount);
+        graph.active.add(nextMount);
+        graph.tick(1, () -> { player.position += 2; nextMount.position += 20; });
+        graph.active.remove(nextMount);
+        graph.active.add(currentMount);
+        graph.history.begin(2);
+        assertTrue(graph.history.schedule(0, ignored -> true, () -> player.position = 10, true));
+        assertTrue(graph.history.replay());
+        assertEquals(13, player.position);
+        assertEquals(List.of(Set.of(player, oldMount), Set.of(player, nextMount),
+                Set.of(player, nextMount), Set.of(player, currentMount)), graph.refreshedLayouts);
+        assertTrue(graph.history.schedule(1, ignored -> true, () -> player.position = 40, true));
+        assertTrue(graph.history.replay());
+        assertEquals(42, player.position);
+        assertEquals(20, nextMount.position);
+    }
+
+    @Test
+    void validatesActorsIntroducedDuringAFrameBeforeRestoringAnyHistoricalState() {
+        final GraphActor player = new GraphActor();
+        final GraphActor passenger = new GraphActor();
+        final GraphFixture graph = new GraphFixture();
+        graph.active.add(player);
+        graph.history.begin(0);
+        graph.active.add(passenger);
+        final Runnable physics = () -> { player.position++; passenger.position++; };
+        graph.history.record(physics);
+        physics.run();
+        graph.history.complete(0);
+        passenger.alive = false;
+        assertTrue(graph.history.schedule(0, ignored -> true, () -> player.position = 100, true));
+        assertFalse(graph.history.replay());
+        assertEquals(0, graph.restores);
+        assertEquals(1, player.position);
+        assertEquals(1, passenger.position);
+    }
+
+    private enum Part { POSITION, MOTION }
+
+    private record State(int position, int motion) {}
+
+    private static final class Fixture {
+        private int position;
+        private int motion = 1;
+        private boolean valid = true;
+        private final List<Integer> executed = new ArrayList<>();
+        private final PhysicalReplayHistory<State> history;
+
+        private Fixture(final int capacity) {
+            this.history = new PhysicalReplayHistory<>(capacity, this::capture, ignored -> this.capture(), state -> {
+                this.position = state.position();
+                this.motion = state.motion();
+            }, (previous, next) -> () -> {
+                if (previous.position() != next.position()) this.position = next.position();
+                if (previous.motion() != next.motion()) this.motion = next.motion();
+            }, ignored -> this.valid, frame -> {}, frame -> {});
+        }
+
+        private State capture() {
+            return new State(this.position, this.motion);
+        }
+
+        private void tick(final int frame) {
+            this.history.begin(frame);
+            this.history.record(() -> this.step(frame));
+            this.step(frame);
+            this.history.complete(frame);
+        }
+
+        private void step(final int frame) {
+            this.executed.add(frame);
+            this.position += this.motion;
+            this.motion--;
+        }
+    }
+
+    private static final class GraphActor {
+        private int position;
+        private boolean alive = true;
+    }
+
+    private static final class GraphFixture {
+        private final List<GraphActor> active = new ArrayList<>();
+        private final List<Set<GraphActor>> refreshedLayouts = new ArrayList<>();
+        private int restores;
+        private final PhysicalReplayHistory<Map<GraphActor, Integer>> history = new PhysicalReplayHistory<>(20,
+                () -> this.capture(this.active), previous -> {
+                    this.refreshedLayouts.add(previous.keySet());
+                    return this.capture(previous.keySet());
+                }, state -> {
+                    this.restores++;
+                    state.forEach((actor, position) -> actor.position = position);
+                }, (previous, next) -> () -> next.forEach((actor, position) -> {
+                    if (!position.equals(previous.get(actor))) actor.position = position;
+                }), state -> state.keySet().stream().allMatch(actor -> actor.alive), frame -> {}, frame -> {});
+
+        private Map<GraphActor, Integer> capture(final java.util.Collection<GraphActor> actors) {
+            return actors.stream().collect(Collectors.toUnmodifiableMap(actor -> actor, actor -> actor.position));
+        }
+
+        private void tick(final long frame, final Runnable physics) {
+            this.history.begin(frame);
+            this.history.record(physics);
+            physics.run();
+            this.history.complete(frame);
+        }
+    }
+}
