+import java.util.ArrayList;
+import java.util.ArrayDeque;
+import java.util.Map;
+
+/** Connection-owned recording and real execution of the client's historical physical tick graph. */
+public final class BedrockPhysicalReplay {
+    private static final int HISTORY_CAPACITY = 1000;
+    private static Session session;
+
+    private BedrockPhysicalReplay() {}
+
+    public static void begin(final LocalPlayer player, final long frame) {
+        final Minecraft client = Minecraft.getInstance();
+        if (client.getConnection() != player.connection || client.level != player.level() || !player.connection.getConnection().isConnected()) {
+            clear();
+            return;
+        }
+        if (session == null || session.player != player || session.level != player.level()
+                || session.player.connection != player.connection) session = new Session(player);
+        session.begin(frame);
+    }
+
+    public static void preparePhysics(final ClientLevel level) {
+        if (session != null && session.level == level) session.prepareFrame();
+    }
+
+    public static void complete(final long frame) {
+        if (session != null) {
+            session.prepareFrame();
+            session.history.complete(frame);
+            session.openFrame = false;
+            session.frameActors.clear();
+            session.frameMembers.clear();
+        }
+    }
+
+    public static void controlChanged() {
+        if (session != null) session.controlLease++;
+    }
+
+    public static void correct(final PlayerCorrection correction) {
+        final Minecraft client = Minecraft.getInstance();
+        if (session != null && client.player == session.player && client.level == session.level
+                && client.getConnection() == session.player.connection && session.player.connection.getConnection().isConnected()) {
+            session.commands.add(new Correction(correction));
+        }
+    }
+
+    public static void motion(final ActorMotionCommand command) {
+        final Minecraft client = Minecraft.getInstance();
+        if (session != null && client.player == session.player && client.level == session.level
+                && client.getConnection() == session.player.connection && session.player.connection.getConnection().isConnected()) {
+            session.receiveMotion(command);
+        }
+    }
+
+    public static void synchronizeCorrectedPosition(final LocalPlayer player) {
+        if (session == null || session.player != player || !session.positionSync) return;
+        session.positionSync = false;
+        player.connection.send(new ServerboundMovePlayerPacket.PosRot(player.getX(), player.getY(), player.getZ(),
+                player.getYRot(), player.getXRot(), player.onGround(), player.horizontalCollision));
+        final Entity vehicle = player.getRootVehicle();
+        if (vehicle != player && vehicle.getControllingPassenger() == player && vehicle.isLocalInstanceAuthoritative()) {
+            player.connection.send(ServerboundMoveVehiclePacket.fromEntity(vehicle));
+        }
+    }
+
+    public static boolean active() {
+        return session != null && session.openFrame;
+    }
+
+    public static void clear() {
+        session = null;
+    }
+
+    public static void rootTick(final ClientLevel level, final Entity actor, final Runnable tick) {
+        if (PhysicalReplayContext.replaying()) {
+            tick.run();
+            return;
+        }
+        if (session != null && session.level == level && actor == session.player.getRootVehicle()
+                && (actor == session.player || (actor instanceof AbstractBoat || actor instanceof AbstractHorse)
+                    && actor.getControllingPassenger() == session.player && actor.isLocalInstanceAuthoritative())) {
+            session.record(tick);
+        } else tick.run();
+    }
+
+    public static void passengerTick(final ClientLevel level, final Entity vehicle, final Entity passenger, final Runnable tick) {
+        if (PhysicalReplayContext.replaying()) {
+            if (PhysicalReplayContext.predicts(passenger)) tick.run();
+            return;
+        }
+        if (session != null && session.level == level && passenger == session.player && !PhysicalReplayContext.recording()) {
+            // An unowned mount's transform is an observation, not a second locally simulated vehicle.
+            session.trackVehicle(vehicle);
+            final PhysicalActorState observation = PhysicalActorState.capture(vehicle);
+            session.record(() -> {
+                if (PhysicalReplayContext.replaying()) observation.restore();
+                tick.run();
+            });
+        } else tick.run();
+    }
+
+    public static void passengers(final ClientLevel level, final Entity vehicle, final List<Entity> passengers, final Runnable live) {
+        if (session == null || session.level != level || !session.relevant(vehicle, passengers)) {
+            live.run();
+            return;
+        }
+        session.trackVehicle(vehicle);
+        final Set<Entity> involved = Collections.newSetFromMap(new IdentityHashMap<>());
+        involved.add(vehicle);
+        involved.addAll(vehicle.getPassengers());
+        involved.addAll(passengers);
+        for (Entity passenger : List.copyOf(involved)) {
+            if (passenger.getVehicle() != null) involved.add(passenger.getVehicle());
+        }
+        session.trackMembers(involved);
+        final List<PhysicalActorState> observations = involved.stream()
+                .filter(actor -> actor != session.player && actor.getControllingPassenger() != session.player)
+                .filter(actor -> actor == vehicle || actor.isVehicle())
+                .map(PhysicalActorState::capture).toList();
+        final LocalPlayer player = session.player;
+        final Runnable historical = () -> {
+            observations.forEach(PhysicalActorState::restore);
+            final boolean mounted = vehicle.hasIndirectPassenger(player);
+            vehicle.ejectPassengers();
+            for (Entity passenger : passengers) {
+                passenger.startRiding(vehicle, true, false);
+                if (passenger == player && !mounted && vehicle instanceof AbstractBoat) {
+                    player.yRotO = vehicle.getYRot();
+                    player.setYRot(vehicle.getYRot());
+                    player.setYHeadRot(vehicle.getYRot());
+                }
+            }
+        };
+        session.admit(involved, live, historical);
+    }
+
+    public static void dismount(final Entity actor, final Runnable action) {
+        if (PhysicalReplayContext.replaying() || PhysicalReplayContext.recording() || session == null
+                || !session.allActors().contains(actor)) {
+            action.run();
+            return;
+        }
+        final Set<Entity> involved = Collections.newSetFromMap(new IdentityHashMap<>());
+        involved.add(actor);
+        if (actor.getVehicle() != null) involved.add(actor.getVehicle());
+        session.trackMembers(involved);
+        session.admit(involved, action, action);
+    }
+
+    public static void motion(final Entity actor, final Runnable action) {
+        if (session != null && session.applyingMotion) action.run();
+        else if (PhysicalReplayContext.replaying()) {
+            if (PhysicalReplayContext.predicts(actor)) action.run();
+        } else if (session != null && session.actors.contains(actor) && !PhysicalReplayContext.recording()) {
+            if (session.openFrame && session.prepared) session.record(Set.of(actor), action);
+            else {
+                final var recorded = session.observe(Set.of(actor), action);
+                recorded.record();
+                session.external.add(recorded::replay);
+            }
+        } else action.run();
+    }
+
+    public static void worldPhysics(final Level level, final Runnable action) {
+        if (session != null && session.level == level && !PhysicalReplayContext.replaying()) session.record(action);
+        else action.run();
+    }
+
+    private sealed interface Command permits Correction, Motion {}
+    private record Correction(PlayerCorrection value) implements Command {}
+    private record Motion(ActorMotionCommand value) implements Command {}
+
+    private static final class Session {
+        private final LocalPlayer player;
+        private final ClientLevel level;
+        private final Set<Entity> actors = Collections.newSetFromMap(new IdentityHashMap<>());
+        private final Set<Entity> members = Collections.newSetFromMap(new IdentityHashMap<>());
+        private final Set<Entity> frameActors = Collections.newSetFromMap(new IdentityHashMap<>());
+        private final Set<Entity> frameMembers = Collections.newSetFromMap(new IdentityHashMap<>());
+        private final Map<Entity, Long> lastSeen = new IdentityHashMap<>();
+        private final PhysicalReplayHistory<PhysicalGraphState> history;
+        private final List<Runnable> external = new ArrayList<>();
+        private long frame;
+        private boolean openFrame;
+        private boolean prepared;
+        private Entity controlledRoot;
+        private long controlEpoch = -1;
+        private long controlLease;
+        private VehiclePredictionContext.Identity controlIdentity;
+        private final List<Command> commands = new ArrayList<>();
+        private boolean applyingMotion;
+        private boolean positionSync;
+
+        private Session(final LocalPlayer player) {
+            this.player = player;
+            this.level = (ClientLevel) player.level();
+            this.actors.add(player);
+            this.history = new PhysicalReplayHistory<>(HISTORY_CAPACITY, this::captureFrame, PhysicalGraphState::recapture, PhysicalGraphState::restore,
+                    (previous, next) -> next.changesSince(previous)::apply, state -> state.valid(this.player),
+                    PhysicalReplayContext::frame, frame -> BedrockMovementEffects.applyPhysicalCommands(frame, this::predicted));
+        }
+
+        private boolean predicted(final int id) {
+            return this.actors.stream().anyMatch(actor -> actor.getId() == id
+                    && (actor == this.player || actor instanceof AbstractBoat || actor instanceof AbstractHorse));
+        }
+
+        private void begin(final long frame) {
+            if (this.openFrame && this.frame == frame) return;
+            this.frame = frame;
+            this.openFrame = true;
+            this.prepared = false;
+        }
+
+        private void prepareFrame() {
+            if (!this.openFrame || this.prepared) return;
+            this.prepared = true;
+            final long frame = this.frame;
+            final Entity root = this.player.getRootVehicle();
+            if (root != this.player) this.trackVehicle(root);
+            this.frameParticipants();
+            // Eviction releases old participant references without invalidating a newer, independent graph.
+            this.lastSeen.entrySet().removeIf(entry -> entry.getKey().isRemoved() || entry.getKey().level() != this.level
+                    || entry.getValue() < frame - HISTORY_CAPACITY + 1);
+            this.actors.removeIf(actor -> !this.lastSeen.containsKey(actor));
+            this.members.removeIf(actor -> !this.lastSeen.containsKey(actor));
+            final Entity controlled = (root instanceof AbstractBoat || root instanceof AbstractHorse)
+                    && root.getControllingPassenger() == this.player && root.isLocalInstanceAuthoritative() ? root : null;
+            final var context = BedrockVehiclePredictions.context(this.player);
+            final long epoch = controlled != null && context != null && context.vehicle() != null
+                    && context.vehicle().javaId() == controlled.getId() && context.vehicle().javaUuid().equals(controlled.getUUID())
+                    ? context.epoch() : -1;
+            final var identity = controlled != null && epoch >= 0 ? context.vehicle() : null;
+            if (this.controlledRoot != controlled || !Objects.equals(this.controlIdentity, identity)) this.controlLease++;
+            this.controlIdentity = identity;
+            if (controlled != null && (this.controlledRoot != controlled || this.controlEpoch != epoch)) {
+                final var observation = PhysicalActorState.capture(controlled);
+                this.external.add(observation::restore);
+            }
+            this.controlledRoot = controlled;
+            this.controlEpoch = epoch;
+            this.history.begin(frame);
+            this.history.admitExternal(this.external);
+            this.external.clear();
+            this.scheduleCommands();
+            final long dirty = BedrockMovementEffects.pendingPhysicalFrame(this::predicted);
+            if (dirty >= 0) this.history.markDirty(dirty);
+            if (dirty >= 0 || this.history.needsReplay()) {
+                boolean replayed = false;
+                final boolean flying = this.player.getAbilities().flying;
+                if (this.history.needsReplay()) {
+                    final Set<Entity> all = this.allActors();
+                    final Set<Entity> predicted = this.predictedActors();
+                    final var network = new IdentityHashMap<Entity, NetworkFlags>();
+                    final var unowned = new IdentityHashMap<Entity, PhysicalActorState>();
+                    all.forEach(actor -> {
+                        network.put(actor, new NetworkFlags(actor.needsSync, actor.syncPosition, actor.syncVelocity));
+                        if (!predicted.contains(actor)) unowned.put(actor, PhysicalActorState.capture(actor));
+                    });
+                    try (var ignored = PhysicalReplayContext.enter(this.level, this.player.connection.getConnection(), all)) {
+                        replayed = this.history.replay();
+                        if (replayed) {
+                            final var relationships = all.stream().map(PhysicalActorState::relationships).toList();
+                            unowned.values().forEach(PhysicalActorState::restore);
+                            relationships.forEach(PhysicalActorState::restore);
+                            BedrockMovementEffects.finishPhysicalReplay(this::predicted);
+                        }
+                    } finally {
+                        network.forEach((actor, flags) -> {
+                            actor.needsSync = flags.needsSync;
+                            actor.syncPosition = flags.position;
+                            actor.syncVelocity = flags.velocity;
+                        });
+                    }
+                }
+                if (replayed && flying != this.player.getAbilities().flying) this.player.onUpdateAbilities();
+                if (!replayed && dirty >= 0) {
+                    // No actor snapshot from that epoch survives a teleport, respawn, or lifetime replacement.
+                    BedrockMovementEffects.replayValuesWithoutRetainedPhysics();
+                    this.history.clear();
+                    this.history.begin(frame);
+                }
+                if (this.history.before(frame) == null) this.history.begin(frame);
+            }
+        }
+
+        private void scheduleCommands() {
+            for (Command command : this.commands) {
+                switch (command) {
+                    case Correction correction -> this.scheduleCorrection(correction.value);
+                    case Motion motion -> this.scheduleMotion(motion.value);
+                }
+            }
+            this.commands.clear();
+        }
+
+        private void scheduleCorrection(final PlayerCorrection correction) {
+            final Entity actor = correction.entityId() == this.player.getId() ? this.player : this.level.getEntity(correction.entityId());
+            if (actor == null || actor.level() != this.level || actor.isRemoved() || !actor.getUUID().equals(correction.uuid())
+                    || !Objects.equals(BedrockActorState.liveLifetime(actor.getUUID()), correction.lifetime())) return;
+            if (correction.vehicle()) {
+                final var context = BedrockVehiclePredictions.context(this.player);
+                if (actor != this.controlledRoot || this.controlIdentity == null || context == null
+                        || context.epoch() != correction.vehicleEpoch() || !this.controlIdentity.javaUuid().equals(correction.uuid())
+                        || !this.controlIdentity.lifetime().equals(correction.lifetime())) return;
+            } else if (actor != this.player || this.player.isPassenger()) return;
+            final var placement = correction.timing().locate(this.history.oldestFrame(), this.history.completedFrame());
+            if (placement == null) return;
+            final PhysicalGraphState frame = this.history.before(placement.frame());
+            final PhysicalActorState target = frame == null ? null : frame.correctionTarget(actor, this.player, correction, this.controlLease);
+            if (target == null) return;
+            final long lease = this.controlLease;
+            this.history.schedule(placement.frame(), state -> this.controlLease == lease
+                            && state.correctionTarget(actor, this.player, correction, this.controlLease) != null,
+                    () -> {
+                        PhysicalMovementCorrection.apply(actor, correction);
+                        this.positionSync = true;
+                    }, placement.pending() || placement.dirty() && target.correction().differs(correction));
+        }
+
+        private Entity motionActor(final ActorMotionCommand command) {
+            final Entity actor = command.entityId() == this.player.getId() ? this.player : this.level.getEntity(command.entityId());
+            if (actor == null || actor.level() != this.level || actor.isRemoved() || !actor.getUUID().equals(command.uuid())
+                    || !Objects.equals(BedrockActorState.liveLifetime(actor.getUUID()), command.lifetime())) return null;
+            if (!command.vehicle()) return actor == this.player ? actor : null;
+            final var context = BedrockVehiclePredictions.context(this.player);
+            return actor.getControllingPassenger() == this.player && actor.isLocalInstanceAuthoritative()
+                    && context != null && context.vehicle() != null && context.epoch() == command.vehicleEpoch()
+                    && context.vehicle().javaId() == actor.getId() && context.vehicle().javaUuid().equals(command.uuid())
+                    && context.vehicle().lifetime().equals(command.lifetime()) ? actor : null;
+        }
+
+        private void receiveMotion(final ActorMotionCommand command) {
+            final Entity actor = this.motionActor(command);
+            if (actor == null) return;
+            // The native receiver applies now and also queues the same value for historical input.
+            this.applyingMotion = true;
+            try {
+                actor.lerpMotion(new Vec3(command.motion().x(), command.motion().y(), command.motion().z()));
+            } finally {
+                this.applyingMotion = false;
+            }
+            this.commands.add(new Motion(command));
+        }
+
+        private void scheduleMotion(final ActorMotionCommand command) {
+            final Entity actor = this.motionActor(command);
+            if (actor == null) return;
+            final long lease = this.controlLease;
+            this.history.scheduleMotion(command.timing(), state -> (!command.vehicle() || this.controlLease == lease)
+                            && state.acceptsMotion(actor, this.player, command, this.controlLease),
+                    () -> {
+                        actor.lerpMotion(new Vec3(command.motion().x(), command.motion().y(), command.motion().z()));
+                        this.positionSync = true;
+                    });
+        }
+
+        private Set<Entity> allActors() {
+            final Set<Entity> all = Collections.newSetFromMap(new IdentityHashMap<>());
+            all.addAll(this.actors);
+            all.addAll(this.members);
+            return all;
+        }
+
+        private boolean relevant(final Entity vehicle, final List<Entity> passengers) {
+            return this.actors.contains(vehicle) || vehicle.hasIndirectPassenger(this.player) || passengers.contains(this.player);
+        }
+
+        private void trackVehicle(final Entity vehicle) {
+            this.actors.add(vehicle);
+            this.frameActors.add(vehicle);
+            this.lastSeen.put(vehicle, this.frame);
+            this.trackMembers(vehicle.getPassengers());
+        }
+
+        private void trackMembers(final Iterable<Entity> members) {
+            members.forEach(actor -> {
+                this.members.add(actor);
+                this.frameMembers.add(actor);
+                this.lastSeen.put(actor, this.frame);
+            });
+        }
+
+        private Set<Entity> frameParticipants() {
+            final Set<Entity> result = Collections.newSetFromMap(new IdentityHashMap<>());
+            final var pending = new ArrayDeque<Entity>();
+            pending.add(this.player.getRootVehicle());
+            pending.add(this.player);
+            pending.addAll(this.frameActors);
+            pending.addAll(this.frameMembers);
+            while (!pending.isEmpty()) {
+                final Entity actor = pending.removeFirst();
+                if (!result.add(actor)) continue;
+                pending.addAll(actor.getPassengers());
+                if (actor.getVehicle() != null) pending.add(actor.getVehicle());
+                this.lastSeen.put(actor, this.frame);
+                this.members.add(actor);
+            }
+            return result;
+        }
+
+        private PhysicalGraphState captureFrame() {
+            final Set<Entity> physical = Collections.newSetFromMap(new IdentityHashMap<>());
+            physical.add(this.player);
+            physical.add(this.player.getRootVehicle());
+            physical.addAll(this.frameActors);
+            return PhysicalGraphState.capture(physical, this.frameParticipants(), this.controlLease);
+        }
+
+        private void admit(final Set<Entity> involved, final Runnable live, final Runnable historical) {
+            final var step = new PhysicalReplayContext.PhysicalStep(this.level.getGameTime(), involved,
+                    Minecraft.getInstance().getCameraEntity(), this.frameParticipants(), live, historical);
+            step.record();
+            if (this.openFrame && this.prepared) this.history.record(step::replay);
+            else this.external.add(step::replay);
+        }
+
+        private void record(final Runnable step) {
+            this.record(this.predictedActors(), step);
+        }
+
+        private void record(final Set<Entity> predictedActors, final Runnable step) {
+            if (!this.openFrame) {
+                step.run();
+                return;
+            }
+            this.prepareFrame();
+            final var recorded = this.observe(predictedActors, step);
+            recorded.record();
+            this.history.record(recorded::replay);
+        }
+
+        private PhysicalReplayContext.PhysicalStep observe(final Set<Entity> predictedActors, final Runnable step) {
+            return new PhysicalReplayContext.PhysicalStep(this.level.getGameTime(), predictedActors,
+                    Minecraft.getInstance().getCameraEntity(), this.frameParticipants(), step);
+        }
+
+        private record NetworkFlags(boolean needsSync, boolean position, boolean velocity) {}
+
+        private Set<Entity> predictedActors() {
+            final Set<Entity> result = Collections.newSetFromMap(new IdentityHashMap<>());
+            result.add(this.player);
+            final Entity root = this.player.getRootVehicle();
+            if ((root instanceof AbstractBoat || root instanceof AbstractHorse) && root.getControllingPassenger() == this.player
+                    && root.isLocalInstanceAuthoritative()) result.add(root);
+            return result;
+        }
+    }
+}
