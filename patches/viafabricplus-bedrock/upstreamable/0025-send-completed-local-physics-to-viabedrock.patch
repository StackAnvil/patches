+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.entity.ai.attributes.AttributeMap;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+import net.minecraft.world.entity.ai.attributes.Attributes;
+import net.minecraft.world.entity.player.Player;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class AttributePhysicsStateTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void ownsMaterializedValuesAndRetainsPermanentAndTransientModifierOwnership() {
+        final var attributes = new AttributeMap(Player.createAttributes().build());
+        final var speed = attributes.getInstance(Attributes.MOVEMENT_SPEED);
+        final var permanent = modifier(1, .25);
+        final var temporary = modifier(2, .5);
+        speed.addPermanentModifier(permanent);
+        speed.addTransientModifier(temporary);
+        final var saved = AttributePhysicsState.capture(attributes);
+        speed.removeModifiers();
+        speed.setBaseValue(3);
+        saved.restore(attributes);
+        assertEquals(.1F, speed.getBaseValue());
+        assertTrue(speed.getPermanentModifiers().contains(permanent));
+        assertFalse(speed.getPermanentModifiers().contains(temporary));
+        assertEquals(2, speed.getModifiers().size());
+        speed.removeModifiers();
+        saved.restore(attributes);
+        assertEquals(saved, AttributePhysicsState.capture(attributes));
+    }
+
+    @Test
+    void changesTheServerBaseWithoutReplacingModifiersRecomputedByEarlierPhysics() {
+        final var attributes = new AttributeMap(Player.createAttributes().build());
+        final var speed = attributes.getInstance(Attributes.MOVEMENT_SPEED);
+        final var before = AttributePhysicsState.capture(attributes);
+        speed.setBaseValue(.3);
+        final var serverUpdate = AttributePhysicsState.capture(attributes);
+        before.restore(attributes);
+        final var predicted = modifier(1, .9);
+        speed.addTransientModifier(predicted);
+        serverUpdate.applyChanges(before, attributes);
+        assertEquals(.3, speed.getBaseValue());
+        assertEquals(predicted, speed.getModifier(predicted.id()));
+    }
+
+    @Test
+    void reconcilesRemovedChangedAndNewModifiersWithoutErasingUnchangedPredictedOnes() {
+        final var attributes = new AttributeMap(Player.createAttributes().build());
+        final var speed = attributes.getInstance(Attributes.MOVEMENT_SPEED);
+        speed.addPermanentModifier(modifier(1, .2));
+        speed.addTransientModifier(modifier(2, .3));
+        final var before = AttributePhysicsState.capture(attributes);
+        speed.removeModifier(modifier(1, .2));
+        speed.addOrUpdateTransientModifier(modifier(2, .6));
+        speed.addPermanentModifier(modifier(3, .7));
+        final var serverUpdate = AttributePhysicsState.capture(attributes);
+        before.restore(attributes);
+        speed.addTransientModifier(modifier(4, .8));
+        serverUpdate.applyChanges(before, attributes);
+        assertNull(speed.getModifier(modifier(1, .2).id()));
+        assertEquals(modifier(2, .6), speed.getModifier(modifier(2, .6).id()));
+        assertEquals(modifier(4, .8), speed.getModifier(modifier(4, .8).id()));
+        assertTrue(speed.getPermanentModifiers().contains(modifier(3, .7)));
+        assertFalse(speed.getPermanentModifiers().contains(modifier(2, .6)));
+    }
+
+    @Test
+    void doesNotMaterializeLazyDefaultsAndRestoresAbsenceAfterAnotherPhysicsBranch() {
+        final var attributes = new AttributeMap(Player.createAttributes().build());
+        attributes.getInstance(Attributes.MOVEMENT_SPEED);
+        final int materialized = attributes.attributes.size();
+        final var saved = AttributePhysicsState.capture(attributes);
+        assertEquals(materialized, attributes.attributes.size());
+        assertFalse(attributes.attributes.containsKey(Attributes.GRAVITY));
+        attributes.getInstance(Attributes.GRAVITY).setBaseValue(.5);
+        saved.restore(attributes);
+        assertFalse(attributes.attributes.containsKey(Attributes.GRAVITY));
+        assertEquals(.08, attributes.getValue(Attributes.GRAVITY));
+    }
+
+    private static AttributeModifier modifier(final int id, final double amount) {
+        return new AttributeModifier(Identifier.withDefaultNamespace(Integer.toString(id)), amount, AttributeModifier.Operation.ADD_VALUE);
+    }
+}
