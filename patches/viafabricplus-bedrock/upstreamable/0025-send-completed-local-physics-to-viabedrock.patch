+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.minecraft.network.protocol.game.ClientboundMoveVehiclePacket;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+import net.raphimc.viabedrock.api.model.PlayerCorrectionTracker;
+
+public final class BedrockPlayerCorrections {
+    private static final PlayerCorrectionTracker TRACKER = new PlayerCorrectionTracker();
+
+    private BedrockPlayerCorrections() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(PlayerCorrectionPayload.TYPE, PlayerCorrectionPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(ActorMotionPayload.TYPE, ActorMotionPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) -> {
+            TRACKER.clear();
+            ClientPlayNetworking.registerReceiver(ActorMotionPayload.TYPE, (payload, context) -> {
+                if (context.client().getConnection() == listener && BedrockInputPermissions.isBedrockConnection()) {
+                    BedrockPhysicalReplay.motion(payload.command());
+                }
+            });
+            ClientPlayNetworking.registerReceiver(PlayerCorrectionPayload.TYPE,
+                (payload, context) -> {
+                    if (context.client().getConnection() == listener && BedrockInputPermissions.isBedrockConnection()) {
+                        TRACKER.accept(payload.correction());
+                    }
+                });
+        });
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> {
+            if (client.getConnection() == null || client.getConnection() == listener) TRACKER.clear();
+        });
+    }
+
+    public static boolean consumePlayer(final int teleportId) {
+        return submit(TRACKER.consumePlayer(teleportId));
+    }
+
+    public static boolean consumeVehicle(final ClientboundMoveVehiclePacket packet) {
+        final var target = packet.movingTo();
+        final var position = target.position();
+        return submit(TRACKER.consumeVehicle(new Position3f((float) position.x, (float) position.y, (float) position.z), target.yRot(), target.xRot()));
+    }
+
+    private static boolean submit(final PlayerCorrection correction) {
+        if (!BedrockInputPermissions.isBedrockConnection()) {
+            TRACKER.clear();
+            return false;
+        }
+        if (correction == null) return false;
+        // A paired packet is acknowledged even when its old world, lifetime, or retained frame is gone.
+        BedrockPhysicalReplay.correct(correction);
+        return true;
+    }
+}
