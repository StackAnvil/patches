+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.vehicle.boat.AbstractBoat;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.MovementCorrectionTiming;
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+import net.raphimc.viabedrock.protocol.model.Position2f;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import java.util.UUID;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class PhysicalMovementCorrectionTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    private static PlayerCorrection correction(final boolean vehicle, final Float angular) {
+        return new PlayerCorrection(42, UUID.randomUUID(), UUID.randomUUID(), vehicle ? 0 : -3, vehicle ? 7 : -1,
+                new MovementCorrectionTiming(102, 105, 25, 100, -1), new Position3f(5.75F, 0F, 0F),
+                new Position3f(3F, 0F, 0F), new Position2f(40F, 50F), angular, 1.62F, vehicle ? 90F : 0F, true);
+    }
+
+    @Test
+    void appliesNativeCommandWithFloatBoundsAndPreservesPreviousPositionAndRotation() {
+        final Entity actor = mock(Entity.class);
+        when(actor.getBbWidth()).thenReturn(0.6F);
+        when(actor.getBbHeight()).thenReturn(1.8F);
+        actor.xOld = 4.75;
+        actor.yOld = -2;
+        actor.zOld = -3;
+        actor.xRotO = -11;
+        actor.yRotO = -12;
+        PhysicalMovementCorrection.apply(actor, correction(false, null));
+        verify(actor).setPos(5.75, -1.6200000047683716, 0);
+        verify(actor).setDeltaMovement(new Vec3(3, 0, 0));
+        verify(actor).setOnGround(true);
+        verify(actor, never()).setXRot(anyFloat());
+        verify(actor, never()).setYRot(anyFloat());
+        assertEquals(4.75, actor.xOld);
+        assertEquals(-2, actor.yOld);
+        assertEquals(-3, actor.zOld);
+        assertEquals(-11, actor.xRotO);
+        assertEquals(-12, actor.yRotO);
+        final var box = ArgumentCaptor.forClass(AABB.class);
+        verify(actor).setBoundingBox(box.capture());
+        // Original 1.26.51.1 command application fixture: each face is rounded separately to float.
+        assertEquals(new AABB(5.449999809265137, -1.6200000047683716, -0.30000001192092896,
+                6.050000190734863, 0.1799999475479126, 0.30000001192092896), box.getValue());
+    }
+
+    @Test
+    void correctsVehicleRotationAndOnlyReplacesPresentBoatAngularVelocity() {
+        for (Float angular : new Float[]{null, 0F, -0.75F, 0.75F}) {
+            final AbstractBoat boat = mock(AbstractBoat.class, withSettings().extraInterfaces(PhysicalStateAccess.Boat.class));
+            when(boat.getBbWidth()).thenReturn(0.6F);
+            when(boat.getBbHeight()).thenReturn(1.8F);
+            PhysicalMovementCorrection.apply(boat, correction(true, angular));
+            verify(boat).setXRot(40F);
+            verify(boat).setYRot(-40F);
+            final var access = (PhysicalStateAccess.Boat) boat;
+            if (angular == null) verify(access, never()).correctAngularVelocity(anyFloat());
+            else verify(access).correctAngularVelocity(angular);
+        }
+    }
+}
diff --git a/src/test/java/com/viaversion/viafabricplus/bedrock/movement/replay/PhysicalReplayContextTest.java b/src/test/java/com/viaversion/viafabricplus/bedrock/movement/replay/PhysicalReplayContextTest.java
