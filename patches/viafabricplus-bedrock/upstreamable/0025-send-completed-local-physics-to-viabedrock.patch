+package com.viaversion.viafabricplus.bedrock.movement;
+
+import com.viaversion.viafabricplus.bedrock.input.BedrockMovementEffects;
+import com.viaversion.viafabricplus.bedrock.input.BedrockInputPermissions;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.PotentSulfurBlock;
+import net.minecraft.world.level.block.state.properties.PotentSulfurState;
+import net.minecraft.world.level.material.Fluids;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.GeyserMovement;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+/** Supplies local block and collision observations to the core geyser rule. */
+public final class BedrockGeyserPhysics {
+
+    public static void admit(final Level level, final BlockPos position) {
+        final LocalPlayer player = Minecraft.getInstance().player;
+        if (player == null || player.level() != level || !BedrockInputPermissions.isBedrockConnection()) {
+            return;
+        }
+        final var box = player.getBoundingBox();
+        if (GeyserMovement.admits(new Position3f((float) box.minX, (float) box.minY, (float) box.minZ),
+                new Position3f((float) box.maxX, (float) box.maxY, (float) box.maxZ),
+                position.getX(), position.getY(), position.getZ(),
+                (x, y, z) -> cell(level, new BlockPos(x, y, z)))) {
+            BedrockMovementEffects.predictGeyserBoost(player.getId());
+        }
+    }
+
+    public static void apply(final LocalPlayer player) {
+        if (!BedrockMovementEffects.hasGeyserBoost(player.getId()) || player.getAbilities().flying) {
+            return;
+        }
+        final var box = player.getBoundingBox();
+        final Vec3 motion = player.getDeltaMovement();
+        final float velocity = GeyserMovement.calculate(
+                new Position3f((float) box.minX, (float) box.minY, (float) box.minZ),
+                new Position3f((float) box.maxX, (float) box.maxY, (float) box.maxZ),
+                (float) motion.y, true, false, (x, y, z) -> cell(player.level(), new BlockPos(x, y, z)));
+        if (Float.floatToRawIntBits(velocity) != Float.floatToRawIntBits((float) motion.y)) {
+            player.setDeltaMovement(new Vec3(motion.x, velocity, motion.z));
+        }
+    }
+
+    public static GeyserMovement.Cell cell(final BlockGetter level, final BlockPos position) {
+        final var state = level.getBlockState(position);
+        final var fluid = state.getFluidState();
+        final boolean mainWater = state.is(Blocks.WATER);
+        final boolean sourceWater = fluid.is(Fluids.WATER) && fluid.isSource();
+        final boolean erupting = state.is(Blocks.POTENT_SULFUR)
+                && (state.getValue(PotentSulfurBlock.STATE) == PotentSulfurState.ERUPTING
+                || state.getValue(PotentSulfurBlock.STATE) == PotentSulfurState.CONTINUOUS);
+        return new GeyserMovement.Cell(!state.getCollisionShape(level, position).isEmpty(), erupting,
+                mainWater && sourceWater, !mainWater && sourceWater, fluid.isSource());
+    }
+
+    private BedrockGeyserPhysics() {
+    }
+
+}
