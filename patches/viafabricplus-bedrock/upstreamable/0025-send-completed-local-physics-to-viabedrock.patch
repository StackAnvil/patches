+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.client.player.ClientInput;
+import net.minecraft.network.Connection;
+import net.minecraft.network.protocol.PacketFlow;
+import net.minecraft.world.entity.player.Input;
+import net.minecraft.world.phys.Vec2;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class PhysicalReplayContextTest {
+    @Test
+    void confinesNetworkAndWorldOverridesToTheReplayThreadAndClosesOnFailure() throws Exception {
+        assertFalse(PhysicalReplayContext.replaying());
+        final Connection owned = new Connection(PacketFlow.CLIENTBOUND);
+        final Connection other = new Connection(PacketFlow.CLIENTBOUND);
+        try (var ignored = PhysicalReplayContext.enter(null, owned, Set.of())) {
+            PhysicalReplayContext.frame(8);
+            assertTrue(PhysicalReplayContext.suppressesNetwork(owned));
+            assertFalse(PhysicalReplayContext.suppressesNetwork(other));
+            assertEquals(7, PhysicalReplayContext.completedFrame(20));
+            assertFalse(CompletableFuture.supplyAsync(() -> PhysicalReplayContext.suppressesNetwork(owned))
+                    .get(5, TimeUnit.SECONDS));
+            assertThrows(IllegalStateException.class, () -> PhysicalReplayContext.enter(null, null, Set.of()));
+        }
+        assertFalse(PhysicalReplayContext.replaying());
+        assertFalse(PhysicalReplayContext.suppressesNetwork(null));
+        assertEquals(20, PhysicalReplayContext.completedFrame(20));
+    }
+
+    @Test
+    void reusesRecordedInputAndWorldTimeWithoutPollingHardwareAgain() {
+        final TestInput input = new TestInput();
+        final AtomicInteger polls = new AtomicInteger();
+        final var step = new PhysicalReplayContext.PhysicalStep(44, Set.of(), null, List.of(), () -> {
+            PhysicalReplayContext.poll(input, () -> {
+                polls.incrementAndGet();
+                input.set(new Input(true, false, true, false, false, true, false), .25F, .75F);
+            });
+            if (PhysicalReplayContext.replaying()) assertEquals(44L, PhysicalReplayContext.gameTime(null));
+        });
+        step.record();
+        final PhysicalInput expected = PhysicalInput.capture(input);
+        input.set(new Input(false, true, false, true, true, false, true), -1, -1);
+        try (var ignored = PhysicalReplayContext.enter(null, null, Set.of())) {
+            PhysicalReplayContext.frame(3);
+            step.replay();
+            assertEquals(expected, PhysicalInput.capture(input));
+            input.set(new Input(false, false, false, false, false, false, false), 0, 0);
+            step.replay();
+            assertEquals(expected, PhysicalInput.capture(input));
+            assertNull(PhysicalReplayContext.gameTime(null));
+        }
+        assertEquals(1, polls.get());
+    }
+
+    @Test
+    void failsBeforePollingHardwareWhenPhysicsRequestsAnUnrecordedInput() {
+        final TestInput input = new TestInput();
+        final AtomicInteger polls = new AtomicInteger();
+        try (var ignored = PhysicalReplayContext.enter(null, null, Set.of())) {
+            assertThrows(IllegalStateException.class, () -> PhysicalReplayContext.poll(input, polls::incrementAndGet));
+            assertEquals(0, polls.get());
+        }
+    }
+
+    private static final class TestInput extends ClientInput implements PhysicalStateAccess.Input {
+        private void set(final Input input, final float strafe, final float forward) {
+            this.keyPresses = input;
+            this.moveVector = new Vec2(strafe, forward);
+        }
+
+        @Override
+        public void restorePhysicalInput(final PhysicalInput value) {
+            this.set(value.keys(), value.strafe(), value.forward());
+        }
+    }
+}
