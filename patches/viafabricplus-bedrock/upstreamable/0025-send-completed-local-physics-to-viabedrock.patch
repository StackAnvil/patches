@@ -0,0 +1,90 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.core.Holder;
+import net.minecraft.world.effect.MobEffect;
+import net.minecraft.world.effect.MobEffectInstance;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+
+public record EffectPhysicsState(Map<Holder<MobEffect>, Value> values) {
+    public EffectPhysicsState {
+        values = Map.copyOf(values);
+    }
+
+    public static EffectPhysicsState capture(final Map<Holder<MobEffect>, MobEffectInstance> effects) {
+        final Map<Holder<MobEffect>, Value> values = new HashMap<>();
+        effects.forEach((type, effect) -> values.put(type, Value.capture(effect)));
+        return new EffectPhysicsState(values);
+    }
+
+    public void restore(final Map<Holder<MobEffect>, MobEffectInstance> effects) {
+        effects.clear();
+        this.values.forEach((type, value) -> effects.put(type, value.create()));
+    }
+
+    public void applyChanges(final EffectPhysicsState previous, final Map<Holder<MobEffect>, MobEffectInstance> effects) {
+        previous.values.keySet().stream().filter(type -> !this.values.containsKey(type)).forEach(effects::remove);
+        this.values.forEach((type, value) -> {
+            if (!value.equals(previous.values.get(type))) effects.put(type, value.create());
+        });
+    }
+
+    public interface HiddenEffect {
+        MobEffectInstance hiddenEffect();
+    }
+
+    /** The blend copy is owned but excluded from physical equality; rendering does not author movement commands. */
+    public static final class Value {
+        private final Holder<MobEffect> type;
+        private final int duration;
+        private final int amplifier;
+        private final boolean ambient;
+        private final boolean visible;
+        private final boolean icon;
+        private final Value hidden;
+        private final MobEffectInstance blend;
+
+        private Value(final MobEffectInstance effect, final Value hidden) {
+            this.type = effect.getEffect();
+            this.duration = effect.getDuration();
+            this.amplifier = effect.getAmplifier();
+            this.ambient = effect.isAmbient();
+            this.visible = effect.isVisible();
+            this.icon = effect.showIcon();
+            this.hidden = hidden;
+            this.blend = new MobEffectInstance(effect);
+            this.blend.copyBlendState(effect);
+        }
+
+        private static Value capture(final MobEffectInstance effect) {
+            final MobEffectInstance hidden = ((HiddenEffect) effect).hiddenEffect();
+            return new Value(effect, hidden == null ? null : capture(hidden));
+        }
+
+        private MobEffectInstance create() {
+            final var result = new MobEffectInstance(this.type, this.duration, this.amplifier,
+                    this.ambient, this.visible, this.icon, this.hidden == null ? null : this.hidden.create());
+            result.copyBlendState(this.blend);
+            return result;
+        }
+
+        @Override
+        public boolean equals(final Object other) {
+            return other instanceof Value value && this.type.equals(value.type) && this.duration == value.duration
+                    && this.amplifier == value.amplifier && this.ambient == value.ambient && this.visible == value.visible
+                    && this.icon == value.icon && Objects.equals(this.hidden, value.hidden);
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(this.type, this.duration, this.amplifier, this.ambient, this.visible, this.icon, this.hidden);
+        }
+    }
+}
