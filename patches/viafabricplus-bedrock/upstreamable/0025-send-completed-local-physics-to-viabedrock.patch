+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.SharedConstants;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.Bootstrap;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.PotentSulfurBlock;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+import net.minecraft.world.level.block.state.properties.PotentSulfurState;
+import net.minecraft.world.level.material.FluidState;
+import net.raphimc.viabedrock.api.model.GeyserMovement;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockGeyserPhysicsTest {
+
+    @BeforeAll
+    static void initializeBlocks() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void distinguishesEruptingFromInactiveSulfurStates() {
+        for (final PotentSulfurState state : PotentSulfurState.values()) {
+            final var cell = cell(Blocks.POTENT_SULFUR.defaultBlockState().setValue(PotentSulfurBlock.STATE, state));
+            assertTrue(cell.colliding());
+            assertEquals(state == PotentSulfurState.ERUPTING || state == PotentSulfurState.CONTINUOUS, cell.erupting());
+            assertFalse(cell.sourceLiquid());
+        }
+    }
+
+    @Test
+    void distinguishesSourceFlowingFallingAndExtraLayerWater() {
+        final var source = cell(Blocks.WATER.defaultBlockState());
+        assertTrue(source.mainSourceWater());
+        assertTrue(source.sourceLiquid());
+        assertFalse(source.colliding());
+        for (int depth = 1; depth < 16; depth++) {
+            final var flowing = cell(Blocks.WATER.defaultBlockState().setValue(BlockStateProperties.LEVEL, depth));
+            assertFalse(flowing.mainSourceWater());
+            assertFalse(flowing.sourceLiquid());
+        }
+        final var wetSlab = cell(Blocks.OAK_SLAB.defaultBlockState().setValue(BlockStateProperties.WATERLOGGED, true));
+        assertTrue(wetSlab.extraSourceWater());
+        assertFalse(wetSlab.mainSourceWater());
+        assertTrue(wetSlab.colliding());
+        final var drySlab = cell(Blocks.OAK_SLAB.defaultBlockState());
+        assertFalse(drySlab.extraSourceWater());
+    }
+
+    @Test
+    void lavaRejectsTheCapWithoutContributingWaterDepth() {
+        final var source = cell(Blocks.LAVA.defaultBlockState());
+        assertTrue(source.sourceLiquid());
+        assertFalse(source.mainSourceWater());
+        assertFalse(source.extraSourceWater());
+        assertFalse(cell(Blocks.LAVA.defaultBlockState().setValue(BlockStateProperties.LEVEL, 1)).sourceLiquid());
+    }
+
+    private static GeyserMovement.Cell cell(final BlockState state) {
+        final BlockGetter level = new BlockGetter() {
+            @Override
+            public BlockEntity getBlockEntity(final BlockPos position) {
+                return null;
+            }
+
+            @Override
+            public BlockState getBlockState(final BlockPos position) {
+                return state;
+            }
+
+            @Override
+            public FluidState getFluidState(final BlockPos position) {
+                return state.getFluidState();
+            }
+
+            @Override
+            public int getHeight() {
+                return 384;
+            }
+
+            @Override
+            public int getMinY() {
+                return -64;
+            }
+        };
+        return BedrockGeyserPhysics.cell(level, BlockPos.ZERO);
+    }
+
+}
