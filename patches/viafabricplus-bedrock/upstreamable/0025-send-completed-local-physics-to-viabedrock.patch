@@ -0,0 +1,190 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.raphimc.viabedrock.api.model.MovementCorrectionTiming;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.SequencedMap;
+import java.util.function.BiFunction;
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import java.util.function.LongConsumer;
+import java.util.function.Supplier;
+import java.util.function.UnaryOperator;
+
+/** One bounded journal for an actor graph. Current input is executed by the ordinary client tick exactly once. */
+public final class PhysicalReplayHistory<S> {
+    private final int capacity;
+    private final Supplier<S> capture;
+    private final UnaryOperator<S> recapture;
+    private final Consumer<S> restore;
+    private final BiFunction<S, S, Runnable> changes;
+    private final Predicate<S> valid;
+    private final LongConsumer beginReplayFrame;
+    private final LongConsumer applyFrameCommands;
+    private final SequencedMap<Long, Frame<S>> frames = new LinkedHashMap<>();
+    private final List<Command<S>> pending = new ArrayList<>();
+    private Frame<S> open;
+    private long completed = -1;
+
+    public PhysicalReplayHistory(final int capacity, final Supplier<S> capture, final UnaryOperator<S> recapture, final Consumer<S> restore,
+                                 final BiFunction<S, S, Runnable> changes, final Predicate<S> valid, final LongConsumer beginReplayFrame, final LongConsumer applyFrameCommands) {
+        this.capacity = Math.clamp(capacity, 1, 1000);
+        this.capture = capture;
+        this.recapture = recapture;
+        this.restore = restore;
+        this.changes = changes;
+        this.valid = valid;
+        this.beginReplayFrame = beginReplayFrame;
+        this.applyFrameCommands = applyFrameCommands;
+    }
+
+    public void begin(final long frame) {
+        if (this.open != null && this.open.id == frame) return;
+        if (frame < 0) throw new IllegalArgumentException("Negative physical frame");
+        if (this.open != null || !this.frames.isEmpty() && frame != this.completed + 1) this.clear();
+        final S state = this.capture.get();
+        final Frame<S> previous = this.frames.get(this.completed);
+        final Runnable external = previous == null ? () -> {} : this.changes.apply(previous.after, state);
+        this.open = new Frame<>(frame, state, external);
+        this.frames.put(frame, this.open);
+        this.open.commands.addAll(this.pending);
+        this.pending.clear();
+        while (this.frames.size() > this.capacity) this.frames.pollFirstEntry();
+    }
+
+    public void admitExternal(final List<Runnable> commands) {
+        if (this.open != null) this.open.externalCommands.addAll(commands);
+    }
+
+    public void record(final Runnable physicalStep) {
+        if (this.open != null) this.open.steps.add(physicalStep);
+    }
+
+    public void complete(final long frame) {
+        if (this.open == null || this.open.id != frame) return;
+        this.open.after = this.capture.get();
+        this.completed = frame;
+        this.open = null;
+    }
+
+    public boolean markDirty(final long frame) {
+        final Frame<S> target = this.frames.get(frame);
+        if (target == null) return false;
+        target.dirty = true;
+        return true;
+    }
+
+    public long oldestFrame() {
+        return this.frames.isEmpty() ? -1 : this.frames.firstEntry().getKey();
+    }
+
+    public long completedFrame() {
+        return this.completed;
+    }
+
+    public S before(final long frame) {
+        final Frame<S> value = this.frames.get(frame);
+        return value == null ? null : value.before;
+    }
+
+    public boolean schedule(final long frame, final Predicate<S> applicable, final Runnable command, final boolean dirty) {
+        final Frame<S> target = this.frames.get(frame);
+        if (target != null) {
+            target.commands.add(new Command<>(applicable, command, dirty));
+            return true;
+        }
+        if (!this.frames.isEmpty() && frame == this.completed + 1 && this.open == null) {
+            this.pending.add(new Command<>(applicable, command, true));
+            return true;
+        }
+        return false;
+    }
+
+    /** The live velocity is already applied; retain its native tick placement independently. */
+    public boolean scheduleMotion(final MovementCorrectionTiming timing, final Predicate<S> applicable, final Runnable action) {
+        final var placement = timing.locateMotion(this.oldestFrame(), this.completedFrame());
+        return placement != null && this.schedule(placement.frame(), applicable, action, placement.dirty() || placement.pending());
+    }
+
+    public boolean needsReplay() {
+        return this.frames.values().stream().anyMatch(frame -> frame.dirty
+                || frame.commands.stream().anyMatch(command -> command.dirty && command.applicable.test(frame.before)));
+    }
+
+    /** Refresh each later snapshot after external writes and before that frame's authoritative commands. */
+    public boolean replay() {
+        final Frame<S> first = this.frames.values().stream().filter(frame -> frame.dirty || frame.commands.stream().anyMatch(command -> command.dirty && command.applicable.test(frame.before))).findFirst().orElse(null);
+        if (first == null) return false;
+        // Validate the entire suffix before restoring any actor or seat pointer.
+        if (this.frames.values().stream().filter(frame -> frame.id >= first.id)
+                .anyMatch(frame -> !this.valid.test(frame.before) || frame.after != null && !this.valid.test(frame.after))) {
+            this.clear();
+            return false;
+        }
+        this.beginReplayFrame.accept(first.id);
+        this.restore.accept(first.before);
+        for (Frame<S> frame : this.frames.values()) {
+            if (frame.id < first.id) continue;
+            if (frame != first) this.beginReplayFrame.accept(frame.id);
+            if (frame != first) {
+                frame.external.run();
+                frame.externalCommands.forEach(Runnable::run);
+                frame.before = this.recapture.apply(frame.before);
+            }
+            this.applyFrameCommands.accept(frame.id);
+            frame.commands.forEach(command -> {
+                if (command.applicable.test(frame.before)) command.action.run();
+                command.dirty = false;
+            });
+            if (frame.after != null) {
+                frame.steps.forEach(Runnable::run);
+                frame.after = this.recapture.apply(frame.after);
+            }
+            frame.dirty = false;
+        }
+        return true;
+    }
+
+    public void clear() {
+        this.frames.clear();
+        this.pending.clear();
+        this.open = null;
+        this.completed = -1;
+    }
+
+    private static final class Command<S> {
+        private final Predicate<S> applicable;
+        private final Runnable action;
+        private boolean dirty;
+
+        private Command(final Predicate<S> applicable, final Runnable action, final boolean dirty) {
+            this.applicable = applicable;
+            this.action = action;
+            this.dirty = dirty;
+        }
+    }
+
+    private static final class Frame<S> {
+        private final long id;
+        private S before;
+        private S after;
+        private final Runnable external;
+        private final List<Runnable> externalCommands = new ArrayList<>();
+        private final List<Runnable> steps = new ArrayList<>();
+        private final List<Command<S>> commands = new ArrayList<>();
+        private boolean dirty;
+
+        private Frame(final long id, final S before, final Runnable external) {
+            this.id = id;
+            this.before = before;
+            this.external = external;
+        }
+    }
+}
