+
+class BedrockCollisionContactsTest {
+
+    @Test
+    void blocksTheRoundedTeleportAtTheFlowingChannelWall() {
+        final VoxelShape wall = Shapes.box(608, 250, 8, 609, 252, 9);
+        final float width = 0.6F;
+        for (final double center : new double[]{7.699999809265137, 7.700000762939453}) {
+            final AABB body = new AABB(608.5 - width / 2D, 250, center - width / 2D, 608.5 + width / 2D, 250 + 1.8F, center + width / 2D);
+            assertEquals(0D, BedrockCollisionContacts.collide(wall, Direction.Axis.Z, body, 0.014), 0D);
+            assertEquals(-0.014, BedrockCollisionContacts.collide(wall, Direction.Axis.Z, body, -0.014));
+        }
+    }
+
+    @Test
+    void retainsGapsBetweenSeparateShapeBoxes() {
+        final VoxelShape posts = Shapes.or(Shapes.box(0, 0, 0, 0.25, 1, 1), Shapes.box(0.75, 0, 0, 1, 1, 1));
+        final AABB throughGap = new AABB(0.3, 0, -1, 0.7, 0.8, -0.1);
+        assertEquals(0.5, BedrockCollisionContacts.collide(posts, Direction.Axis.Z, throughGap, 0.5));
+        final AABB intoPost = new AABB(0.05, 0, -1, 0.2, 0.8, -0.1);
+        assertEquals((double) 0.1F, BedrockCollisionContacts.collide(posts, Direction.Axis.Z, intoPost, 0.5));
+        assertEquals(0.5, BedrockCollisionContacts.collide(Shapes.empty(), Direction.Axis.Z, intoPost, 0.5));
+    }
+
+}
