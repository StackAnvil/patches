+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.world.entity.Pose;
+import net.minecraft.world.phys.AABB;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class BedrockPlayerPostureTest {
+
+    @Test
+    void usesNativeFloatRoundingAndInsetAtWorldCoordinates() {
+        final var body = new AABB(-7.3, 104.5, 15.7, -6.7, 105.1, 16.3);
+        for (final var pose : new Pose[]{Pose.STANDING, Pose.CROUCHING, Pose.SWIMMING}) {
+            final var probe = BedrockPlayerPosture.probe(body, pose);
+            final float height = pose == Pose.STANDING ? 1.8F : pose == Pose.CROUCHING ? 1.49F : 0.6F;
+            assertEquals((double) ((float) body.minX + 0.01F), probe.minX);
+            assertEquals((double) ((float) body.maxX - 0.01F), probe.maxX);
+            assertEquals((double) ((float) body.minY + 0.01F), probe.minY);
+            assertEquals((double) (((float) body.minY + height) - 0.01F), probe.maxY);
+            assertEquals((double) ((float) body.minZ + 0.01F), probe.minZ);
+            assertEquals((double) ((float) body.maxZ - 0.01F), probe.maxZ);
+        }
+        final var ceiling = new AABB(-8, 106, 15, -6, 107, 17);
+        assertTrue(BedrockPlayerPosture.probe(body, Pose.STANDING).intersects(ceiling));
+        assertFalse(BedrockPlayerPosture.probe(body, Pose.CROUCHING).intersects(ceiling));
+        assertFalse(BedrockPlayerPosture.probe(body, Pose.SWIMMING).intersects(ceiling));
+    }
+
+    @Test
+    void collapsesInvertedInsetAxesAndRejectsUnrelatedPoses() {
+        final var probe = BedrockPlayerPosture.probe(new AABB(0, 0, 0, 0.01, 1, 0.01), Pose.SWIMMING);
+        assertEquals(probe.minX, probe.maxX);
+        assertEquals(probe.minZ, probe.maxZ);
+        assertTrue(probe.minY < probe.maxY);
+        assertThrows(IllegalArgumentException.class,
+                () -> BedrockPlayerPosture.probe(new AABB(0, 0, 0, 1, 1, 1), Pose.SLEEPING));
+    }
+
+}
