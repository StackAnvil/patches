+package com.viaversion.viafabricplus.bedrock.input;
+
+import io.netty.buffer.Unpooled;
+import net.minecraft.SharedConstants;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.server.Bootstrap;
+import net.raphimc.viabedrock.api.model.VehiclePrediction;
+import net.raphimc.viabedrock.api.model.VehiclePredictionContext;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class VehiclePredictionPayloadTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void transportsContextAndCompletedMotionThroughActualFabricCodecs() {
+        final var context = context();
+        final var prediction = new VehiclePrediction(7, context, new Position3f(7, 63, -9), new Position3f(-.125F, .25F, .375F));
+        final var buffer = new RegistryFriendlyByteBuf(Unpooled.buffer(), RegistryAccess.EMPTY);
+        try {
+            VehiclePredictionContextPayload.CODEC.encode(buffer, new VehiclePredictionContextPayload(context));
+            assertEquals(context, VehiclePredictionContextPayload.CODEC.decode(buffer).context());
+            assertFalse(buffer.isReadable());
+            buffer.clear();
+            VehiclePredictionPayload.CODEC.encode(buffer, new VehiclePredictionPayload(prediction));
+            final var decoded = VehiclePredictionPayload.CODEC.decode(buffer).prediction();
+            assertEquals(prediction, decoded);
+            assertEquals(-17L, decoded.context().vehicle().uniqueId());
+            assertEquals(23L, decoded.context().vehicle().runtimeId());
+            assertFalse(buffer.isReadable());
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void transportsClearAndRefusesTrailingContextOrFrameData() {
+        final var buffer = new RegistryFriendlyByteBuf(Unpooled.buffer(), RegistryAccess.EMPTY);
+        try {
+            final var clear = new VehiclePredictionContextPayload(new VehiclePredictionContext(8, null));
+            VehiclePredictionContextPayload.CODEC.encode(buffer, clear);
+            assertEquals(clear, VehiclePredictionContextPayload.CODEC.decode(buffer));
+            buffer.clear();
+            VehiclePredictionContextPayload.CODEC.encode(buffer, clear);
+            buffer.writeByte(1);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePredictionContextPayload.CODEC.decode(buffer));
+            buffer.clear();
+            VehiclePredictionPayload.CODEC.encode(buffer, new VehiclePredictionPayload(new VehiclePrediction(8, context(),
+                    new Position3f(0, 0, 0), new Position3f(0, 0, 0))));
+            buffer.writeByte(1);
+            assertThrows(IllegalArgumentException.class, () -> VehiclePredictionPayload.CODEC.decode(buffer));
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private static VehiclePredictionContext context() {
+        return new VehiclePredictionContext(4, new VehiclePredictionContext.Identity(2, UUID.randomUUID(), UUID.randomUUID(), 23, -17));
+    }
+}
