+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.injection.mixin.features.movement;
+
+import com.viaversion.viafabricplus.bedrock.movement.replay.PhysicalState;
+import com.viaversion.viafabricplus.bedrock.movement.replay.PhysicalStateAccess;
+import net.minecraft.network.syncher.EntityDataAccessor;
+import net.minecraft.world.entity.AgeableMob;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+
+@Mixin(AgeableMob.class)
+public abstract class MixinAgePhysicsState implements PhysicalStateAccess.Age {
+    @Shadow @Final private static EntityDataAccessor<Boolean> DATA_BABY_ID;
+    @Shadow @Final private static EntityDataAccessor<Boolean> AGE_LOCKED;
+    @Shadow protected int age;
+    @Shadow protected int forcedAge;
+    @Shadow protected int forcedAgeTimer;
+    @Shadow protected int ageLockParticleTimer;
+
+    @Override
+    public void captureAgePhysics(final PhysicalState.Builder state) {
+        final var data = ((AgeableMob) (Object) this).getEntityData();
+        state.capture(Field.BABY, data.get(DATA_BABY_ID), value -> data.set(DATA_BABY_ID, value));
+        state.capture(Field.LOCKED, data.get(AGE_LOCKED), value -> data.set(AGE_LOCKED, value));
+        state.capture(Field.AGE, this.age, value -> this.age = value);
+        state.capture(Field.FORCED_AGE, this.forcedAge, value -> this.forcedAge = value);
+        state.capture(Field.FORCED_TIMER, this.forcedAgeTimer, value -> this.forcedAgeTimer = value);
+        state.capture(Field.PARTICLE_TIMER, this.ageLockParticleTimer, value -> this.ageLockParticleTimer = value);
+    }
+
+    private enum Field { BABY, LOCKED, AGE, FORCED_AGE, FORCED_TIMER, PARTICLE_TIMER }
+}
