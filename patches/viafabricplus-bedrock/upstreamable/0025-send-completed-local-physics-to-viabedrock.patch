@@ -0,0 +1,84 @@
+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.core.Holder;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.entity.ai.attributes.Attribute;
+import net.minecraft.world.entity.ai.attributes.AttributeInstance;
+import net.minecraft.world.entity.ai.attributes.AttributeMap;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/** Base values and modifier ownership are independent of cached attribute totals and dirty synchronization sets. */
+public record AttributePhysicsState(Map<Holder<Attribute>, Value> values, Set<Holder<Attribute>> update, Set<Holder<Attribute>> sync) {
+    public AttributePhysicsState {
+        values = Map.copyOf(values);
+        update = Set.copyOf(update);
+        sync = Set.copyOf(sync);
+    }
+
+    public static AttributePhysicsState capture(final AttributeMap attributes) {
+        final Map<Holder<Attribute>, Value> values = new HashMap<>();
+        attributes.attributes.forEach((holder, attribute) -> {
+            final Map<Identifier, Modifier> modifiers = new HashMap<>();
+            attribute.getModifiers().forEach(modifier -> modifiers.put(modifier.id(),
+                    new Modifier(modifier, attribute.getPermanentModifiers().contains(modifier))));
+            values.put(holder, new Value(attribute.getBaseValue(), modifiers));
+        });
+        return new AttributePhysicsState(values,
+                attributes.getAttributesToUpdate().stream().map(AttributeInstance::getAttribute).collect(Collectors.toSet()),
+                attributes.getAttributesToSync().stream().map(AttributeInstance::getAttribute).collect(Collectors.toSet()));
+    }
+
+    public void restore(final AttributeMap attributes) {
+        attributes.attributes.keySet().removeIf(holder -> !this.values.containsKey(holder));
+        this.values.forEach((holder, value) -> {
+            final AttributeInstance attribute = attributes.getInstance(holder);
+            attribute.removeModifiers();
+            attribute.setBaseValue(value.base());
+            value.modifiers().values().forEach(modifier -> modifier.apply(attribute));
+        });
+        attributes.getAttributesToUpdate().clear();
+        this.update.forEach(holder -> attributes.getAttributesToUpdate().add(attributes.getInstance(holder)));
+        attributes.getAttributesToSync().clear();
+        this.sync.forEach(holder -> attributes.getAttributesToSync().add(attributes.getInstance(holder)));
+    }
+
+    public void applyChanges(final AttributePhysicsState previous, final AttributeMap attributes) {
+        this.values.forEach((holder, next) -> {
+            final Value before = previous.values.get(holder);
+            final AttributeInstance attribute = attributes.getInstance(holder);
+            if (before == null || Double.compare(before.base(), next.base()) != 0) attribute.setBaseValue(next.base());
+            if (before != null) {
+                before.modifiers().keySet().stream().filter(id -> !next.modifiers().containsKey(id)).forEach(attribute::removeModifier);
+            }
+            next.modifiers().forEach((id, modifier) -> {
+                if (before == null || !modifier.equals(before.modifiers().get(id))) {
+                    attribute.removeModifier(id);
+                    modifier.apply(attribute);
+                }
+            });
+        });
+    }
+
+    public record Value(double base, Map<Identifier, Modifier> modifiers) {
+        public Value {
+            modifiers = Map.copyOf(modifiers);
+        }
+    }
+
+    public record Modifier(AttributeModifier value, boolean permanent) {
+        private void apply(final AttributeInstance attribute) {
+            if (this.permanent) attribute.addPermanentModifier(this.value);
+            else attribute.addTransientModifier(this.value);
+        }
+    }
+}
diff --git a/src/main/java/com/viaversion/viafabricplus/bedrock/movement/replay/EffectPhysicsState.java b/src/main/java/com/viaversion/viafabricplus/bedrock/movement/replay/EffectPhysicsState.java
