+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.core.Direction;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BedrockCollisionContactsTest {
+
+    @Test
+    void blocksTheRoundedTeleportAtTheFlowingChannelWall() {
+        final VoxelShape wall = Shapes.box(608, 250, 8, 609, 252, 9);
+        final float width = 0.6F;
+        for (final double center : new double[]{7.699999809265137, 7.700000762939453}) {
+            final AABB body = new AABB(608.5 - width / 2D, 250, center - width / 2D, 608.5 + width / 2D, 250 + 1.8F, center + width / 2D);
+            assertEquals(0D, BedrockCollisionContacts.collide(wall, Direction.Axis.Z, body, 0.014), 0D);
+            assertEquals(-0.014, BedrockCollisionContacts.collide(wall, Direction.Axis.Z, body, -0.014));
+        }
+    }
+
+    @Test
+    void retainsGapsBetweenSeparateShapeBoxes() {
+        final VoxelShape posts = Shapes.or(Shapes.box(0, 0, 0, 0.25, 1, 1), Shapes.box(0.75, 0, 0, 1, 1, 1));
+        final AABB throughGap = new AABB(0.3, 0, -1, 0.7, 0.8, -0.1);
+        assertEquals(0.5, BedrockCollisionContacts.collide(posts, Direction.Axis.Z, throughGap, 0.5));
+        final AABB intoPost = new AABB(0.05, 0, -1, 0.2, 0.8, -0.1);
+        assertEquals(0.1, BedrockCollisionContacts.collide(posts, Direction.Axis.Z, intoPost, 0.5));
+        assertEquals(0.5, BedrockCollisionContacts.collide(Shapes.empty(), Direction.Axis.Z, intoPost, 0.5));
+    }
+
+    @Test
+    void landsExactlyOnFullBlockFacesWithUnroundedJavaBounds() {
+        for (final Direction.Axis axis : Direction.Axis.values()) {
+            for (final double origin : new double[]{0, 250, 608, 8192, -8192}) {
+                final VoxelShape block = Shapes.box(origin, origin, origin, origin + 1, origin + 1, origin + 1);
+                for (final double gap : new double[]{0.014, 0.137, 0.499}) {
+                    final double[] lower = {origin + 0.2, origin + 0.2, origin + 0.2};
+                    final double[] upper = {origin + 0.8, origin + 0.8, origin + 0.8};
+                    final int component = axis.ordinal();
+                    lower[component] = origin - gap - 0.6;
+                    upper[component] = origin - gap;
+                    final AABB approachingPositive = new AABB(lower[0], lower[1], lower[2], upper[0], upper[1], upper[2]);
+                    final double positive = BedrockCollisionContacts.collide(block, axis, approachingPositive, 1);
+                    assertEquals(origin, approachingPositive.max(axis) + positive, 0D);
+                    assertEquals(-1, BedrockCollisionContacts.collide(block, axis, approachingPositive, -1));
+
+                    lower[component] = origin + 1 + gap;
+                    upper[component] = origin + 1 + gap + 0.6;
+                    final AABB approachingNegative = new AABB(lower[0], lower[1], lower[2], upper[0], upper[1], upper[2]);
+                    final double negative = BedrockCollisionContacts.collide(block, axis, approachingNegative, -1);
+                    assertEquals(origin + 1, approachingNegative.min(axis) + negative, 0D);
+                    assertEquals(1, BedrockCollisionContacts.collide(block, axis, approachingNegative, 1));
+                }
+            }
+        }
+    }
+
+    @Test
+    void clipsRequestsThatReachTheFaceBeforeTheirFloatRoundedDistance() {
+        final VoxelShape floor = Shapes.box(0, 249, 0, 1, 250, 1);
+        final AABB body = new AABB(0.2, 250.014, 0.2, 0.8, 251.814, 0.8);
+        final double requested = -(body.minY - 250) - 0.000001;
+        final double clipped = BedrockCollisionContacts.collide(floor, Direction.Axis.Y, body, requested);
+        assertEquals(250, body.minY + clipped, 0D);
+        assertTrue(clipped > requested);
+    }
+
+    @Test
+    void edgeGuardRequiresTheSameSupportAsVerticalCollision() {
+        final VoxelShape floor = Shapes.block();
+        for (final double origin : new double[]{0, 608, -608, 8192, -8192}) {
+            final VoxelShape translated = floor.move(origin, 0, 0);
+            final AABB touchingEdge = new AABB(origin + 0.9999995, 1, 0.2, origin + 1.5999995, 2.8, 0.8);
+            assertTrue(BedrockCollisionContacts.canFallAtLeast(List.of(translated), touchingEdge, 0.6));
+            assertEquals(-0.6, BedrockCollisionContacts.collide(translated, Direction.Axis.Y, touchingEdge, -0.6));
+
+            final AABB supported = touchingEdge.move(-0.05, 0, 0);
+            assertFalse(BedrockCollisionContacts.canFallAtLeast(List.of(translated), supported, 0.6));
+            assertEquals(0, BedrockCollisionContacts.collide(translated, Direction.Axis.Y, supported, -0.6));
+        }
+        assertTrue(BedrockCollisionContacts.canFallAtLeast(List.of(), new AABB(0, 1, 0, 0.6, 2.8, 0.6), 0.6));
+    }
+}
