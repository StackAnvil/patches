+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.Shapes;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class PhysicalWorldCollisionTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    private static ClientLevel world() {
+        final var level = mock(ClientLevel.class);
+        when(level.getMinY()).thenReturn(-64);
+        when(level.getMaxY()).thenReturn(319);
+        when(level.getWorldBorder()).thenReturn(mock(WorldBorder.class));
+        when(level.getBlockState(any(BlockPos.class))).thenReturn(Blocks.AIR.defaultBlockState());
+        return level;
+    }
+
+    private static Entity actor(final ClientLevel level, final AtomicReference<Vec3> position) {
+        final var actor = mock(Entity.class);
+        when(actor.level()).thenReturn(level);
+        when(actor.position()).thenAnswer(ignored -> position.get());
+        when(actor.getBoundingBox()).thenAnswer(ignored -> new AABB(position.get().x, position.get().y, position.get().z,
+                position.get().x + 0.6, position.get().y + 1.8, position.get().z + 0.6));
+        when(actor.maxUpStep()).thenReturn(0.6F);
+        return actor;
+    }
+
+    @Test
+    void retainsUnavailableChunkBarrierAfterArrivalAndFetchesCurrentStateAtTheReuseBoundary() {
+        final var level = world();
+        final var chunks = mock(ClientChunkCache.class);
+        final var chunk = mock(LevelChunk.class);
+        final var arrived = new AtomicBoolean();
+        when(level.getChunkSource()).thenReturn(chunks);
+        when(chunks.getChunk(anyInt(), anyInt(), eq(ChunkStatus.FULL), eq(false))).thenAnswer(invocation ->
+                invocation.<Integer>getArgument(0) == 1 && !arrived.get() ? null : chunk);
+        final var position = new AtomicReference<>(new Vec3(15, 70, 0));
+        final var actor = actor(level, position);
+        final var displacements = new ArrayList<Double>();
+        final var step = new PhysicalReplayContext.PhysicalStep(10, Set.of(actor), actor, List.of(), () ->
+                PhysicalCollisions.collide(actor, new Vec3(1, 0, 0), motion -> {
+                    displacements.add(Shapes.collide(Direction.Axis.X, actor.getBoundingBox(), PhysicalCollisions.collect(level), motion.x));
+                    return motion;
+                }));
+        step.record();
+        arrived.set(true);
+        clearInvocations(level, chunks);
+        try (var ignored = PhysicalReplayContext.enter(level, null, Set.of(actor))) {
+            step.replay();
+            verifyNoInteractions(chunks);
+            verify(level, never()).getBlockState(any(BlockPos.class));
+            position.set(new Vec3(17, 70, 0));
+            step.replay();
+        }
+        assertEquals(3, displacements.size());
+        assertEquals(0.4, displacements.get(0), 1E-9);
+        assertEquals(displacements.get(0), displacements.get(1));
+        assertEquals(1, displacements.get(2));
+        verify(chunks, never()).getChunk(anyInt(), anyInt(), any(), eq(true));
+    }
+
+    @Test
+    void collidesWithNativeBelowWorldFloorWithoutReadingOutOfHeightBlocks() {
+        final var level = world();
+        final var chunks = mock(ClientChunkCache.class);
+        when(level.getChunkSource()).thenReturn(chunks);
+        when(chunks.getChunk(anyInt(), anyInt(), eq(ChunkStatus.FULL), eq(false))).thenReturn(mock(LevelChunk.class));
+        final var actor = actor(level, new AtomicReference<>(new Vec3(0, -100, 0)));
+        final var clipped = new ArrayList<Double>();
+        final var step = new PhysicalReplayContext.PhysicalStep(10, Set.of(actor), actor, List.of(), () ->
+                PhysicalCollisions.collide(actor, new Vec3(0, -16, 0), motion -> {
+                    clipped.add(Shapes.collide(Direction.Axis.Y, actor.getBoundingBox(), PhysicalCollisions.collect(level), motion.y));
+                    return motion;
+                }));
+        step.record();
+        assertEquals(List.of(-4D), clipped);
+        verify(level, never()).getBlockState(any(BlockPos.class));
+    }
+}
