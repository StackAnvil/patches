+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.AgeableMob;
+import net.minecraft.world.entity.animal.equine.AbstractHorse;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.entity.vehicle.boat.AbstractBoat;
+
+import java.util.Objects;
+import net.raphimc.viabedrock.api.model.NativeActorMessage;
+import java.util.UUID;
+
+public record PhysicalActorState(Entity actor, ClientLevel level, int id, UUID uuid, UUID nativeLifetime, NativeActorMessage.Snapshot metadata, boolean physical, CorrectionValues correction, PhysicalState state) {
+    public static PhysicalActorState capture(final Entity actor) {
+        final var builder = PhysicalState.builder(actor);
+        com.viaversion.viafabricplus.bedrock.input.BedrockMovementEffects.capturePhysicalValues(actor.getId(), builder);
+        ((PhysicalStateAccess.Base) actor).captureBasePhysics(builder);
+        if (actor instanceof LivingEntity) ((PhysicalStateAccess.Living) actor).captureLivingPhysics(builder);
+        if (actor instanceof AgeableMob) ((PhysicalStateAccess.Age) actor).captureAgePhysics(builder);
+        if (actor instanceof Player) ((PhysicalStateAccess.Player) actor).capturePlayerPhysics(builder);
+        if (actor instanceof LocalPlayer) ((PhysicalStateAccess.Local) actor).captureLocalPhysics(builder);
+        if (actor instanceof AbstractBoat) ((PhysicalStateAccess.Boat) actor).captureBoatPhysics(builder);
+        if (actor instanceof AbstractHorse) ((PhysicalStateAccess.Horse) actor).captureHorsePhysics(builder);
+        return new PhysicalActorState(actor, (ClientLevel) actor.level(), actor.getId(), actor.getUUID(),
+                BedrockActorState.lifetime(actor.getUUID()), BedrockActorState.state(actor.getUUID()), true, CorrectionValues.capture(actor), builder.build());
+    }
+
+    public static PhysicalActorState relationships(final Entity actor) {
+        final var builder = PhysicalState.builder(actor);
+        ((PhysicalStateAccess.Base) actor).captureRelationships(builder);
+        return new PhysicalActorState(actor, (ClientLevel) actor.level(), actor.getId(), actor.getUUID(),
+                BedrockActorState.lifetime(actor.getUUID()), BedrockActorState.state(actor.getUUID()), false, null, builder.build());
+    }
+
+    public boolean accepts(final PlayerCorrection command, final LocalPlayer player) {
+        return this.physical && this.valid(player) && this.id == command.entityId() && this.uuid.equals(command.uuid())
+                && Objects.equals(this.nativeLifetime, command.lifetime()) && this.correction != null
+                && (command.vehicle() ? this.correction.authoritative && player.getUUID().equals(this.correction.controller)
+                : this.actor == player && !this.correction.passenger);
+    }
+
+    public boolean accepts(final ActorMotionCommand command, final LocalPlayer player) {
+        return this.physical && this.valid(player) && this.id == command.entityId() && this.uuid.equals(command.uuid())
+                && Objects.equals(this.nativeLifetime, command.lifetime()) && this.correction != null
+                && (command.vehicle() ? this.correction.authoritative && player.getUUID().equals(this.correction.controller) : this.actor == player);
+    }
+
+    public record CorrectionValues(Position3f position,
+                                   Position3f motion, boolean onGround,
+                                   Position2f rotation, Float angular,
+                                   boolean passenger, boolean authoritative, UUID controller) {
+        private static CorrectionValues capture(final Entity actor) {
+            final var velocity = actor.getDeltaMovement();
+            return new CorrectionValues(new Position3f((float) actor.getX(), (float) actor.getY(), (float) actor.getZ()),
+                    new Position3f((float) velocity.x, (float) velocity.y, (float) velocity.z), actor.onGround(),
+                    new Position2f(actor.getXRot(), actor.getYRot()),
+                    actor instanceof AbstractBoat ? ((PhysicalStateAccess.Boat) actor).angularVelocity() : null,
+                    actor.isPassenger(), actor.isLocalInstanceAuthoritative(),
+                    actor.getControllingPassenger() == null ? null : actor.getControllingPassenger().getUUID());
+        }
+
+        public boolean differs(final PlayerCorrection command) {
+            return command.differs(this.position, this.motion, this.onGround, this.rotation, this.angular);
+        }
+    }
+
+    public void restore() {
+        PhysicalReplayContext.actor(this.uuid, this.metadata);
+        this.state.restore();
+    }
+
+    public boolean valid(final LocalPlayer player) {
+        return !this.actor.isRemoved() && this.actor.level() == this.level && this.actor.getId() == this.id
+                && this.actor.getUUID().equals(this.uuid) && (this.actor == player || this.level.getEntity(this.id) == this.actor)
+                && Objects.equals(BedrockActorState.liveLifetime(this.uuid), this.nativeLifetime);
+    }
+}
