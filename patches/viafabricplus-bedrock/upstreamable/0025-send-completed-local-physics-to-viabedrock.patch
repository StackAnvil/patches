+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.world.entity.Pose;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.phys.AABB;
+import net.raphimc.viabedrock.api.model.PlayerPosture;
+
+/** Native block-space probes. Entity overlap does not prevent a native posture change. */
+public final class BedrockPlayerPosture {
+
+    public static final float CROUCHING_HEIGHT = 1.49F;
+    private static final float PROBE_INSET = 0.01F;
+
+    private BedrockPlayerPosture() {
+    }
+
+    public static PlayerPosture.Space space(final Player player) {
+        final boolean standing = fits(player, Pose.STANDING);
+        final boolean crouching = standing || fits(player, Pose.CROUCHING);
+        return new PlayerPosture.Space(standing, crouching, crouching || fits(player, Pose.SWIMMING));
+    }
+
+    public static boolean fits(final Player player, final Pose pose) {
+        final AABB probe = probe(player.getBoundingBox(), pose);
+        for (final var collision : player.level().getBlockCollisions(player, probe)) {
+            if (!collision.isEmpty()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static AABB probe(final AABB body, final Pose pose) {
+        final float height = switch (pose) {
+            case STANDING -> 1.8F;
+            case CROUCHING -> CROUCHING_HEIGHT;
+            case SWIMMING -> 0.6F;
+            default -> throw new IllegalArgumentException("Unsupported posture probe");
+        };
+        float minX = (float) body.minX + PROBE_INSET;
+        float minY = (float) body.minY + PROBE_INSET;
+        float minZ = (float) body.minZ + PROBE_INSET;
+        float maxX = (float) body.maxX - PROBE_INSET;
+        float maxY = ((float) body.minY + height) - PROBE_INSET;
+        float maxZ = (float) body.maxZ - PROBE_INSET;
+        if (maxX < minX) {
+            minX = maxX = (minX + maxX) * 0.5F;
+        }
+        if (maxY < minY) {
+            minY = maxY = (minY + maxY) * 0.5F;
+        }
+        if (maxZ < minZ) {
+            minZ = maxZ = (minZ + maxZ) * 0.5F;
+        }
+        return new AABB(minX, minY, minZ, maxX, maxY, maxZ);
+    }
+
+}
