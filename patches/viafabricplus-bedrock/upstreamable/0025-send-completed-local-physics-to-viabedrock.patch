+    }
+    public interface FluidAccumulator {
+        FluidPhysicsState.Current captureFluidCurrent();
+        void restoreFluidCurrent(FluidPhysicsState.Current state);
+    }
+    public interface Fluid { void captureFluidPhysics(PhysicalState.Builder state); }
