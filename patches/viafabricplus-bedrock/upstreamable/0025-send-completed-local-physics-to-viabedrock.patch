+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PhysicalColliderSourcesTest {
+
+    private static final AABB RETAINED = new AABB(9.25, 11.5, 13.75, 14.25, 16.5, 18.75);
+
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @AfterEach
+    void clearRegistry() {
+        BedrockActorState.clear();
+    }
+
+    @Test
+    void movedJavaPoseWithoutANativeSourceKeepsTheRetainedBoxEvenForAPredictedActor() {
+        final var fixture = new Fixture();
+        final var captured = fixture.capture();
+        when(fixture.actor.position()).thenReturn(new Vec3(1, 0, 0));
+        when(fixture.actor.getBoundingBox()).thenReturn(RETAINED.move(1, 0, 0));
+        try (var ignored = PhysicalReplayContext.enter(fixture.level, null, Set.of(fixture.actor))) {
+            assertEquals(RETAINED, fixture.refresh(captured));
+        }
+    }
+
+    @Test
+    void activeNativeTargetRefreshesAnUnchangedJavaPoseWithTheOriginalFloatBounds() {
+        final var fixture = new Fixture();
+        BedrockActorState.apply(new NativeActorBoundsMessage(fixture.uuid, fixture.lifetime, false, 3.7F, 1.8F), null);
+        final var target = new Position3f(-17.75273323059082F, -84.07622528076172F, 95.51299285888672F);
+        fixture.command(1, target, false, false, 1.62F);
+        final var movement = BedrockActorState.movement(fixture.uuid);
+        movement.beforePhysics(Position3f.ZERO);
+        movement.beforePhysics(Position3f.ZERO);
+        final var captured = fixture.capture();
+        assertEquals(new AABB(-19.602733612060547, -85.69622802734375, 93.66299438476562,
+                -15.902732849121094, -83.89622497558594, 97.36299133300781), fixture.refresh(captured));
+        assertEquals(RETAINED, captured.shapes().getFirst().bounds());
+    }
+
+    @Test
+    void historicalTargetSurvivesLaterPacketsAndLiveCounterCompletion() {
+        final var fixture = new Fixture();
+        fixture.command(1, new Position3f(10, 20, 30), false, false, 0F);
+        final var captured = fixture.capture();
+        fixture.command(2, new Position3f(100, 200, 300), false, false, 0F);
+        final var movement = BedrockActorState.movement(fixture.uuid);
+        for (int tick = 0; tick < 3; tick++) movement.beforePhysics(Position3f.ZERO);
+        assertFalse(movement.interpolation().active());
+        assertEquals(new AABB(7.5, 20, 27.5, 12.5, 25, 32.5), fixture.refresh(captured));
+    }
+
+    @Test
+    void liveNetworkHistoryTakesPriorityOverTheJavaPose() {
+        final var fixture = new Fixture();
+        fixture.command(0, new Position3f(10, 20, 30), true, false, .375F);
+        final var captured = fixture.capture();
+        fixture.command(1, new Position3f(40, 50, 60), true, false, .375F);
+        when(fixture.actor.getBoundingBox()).thenReturn(RETAINED.move(1000, 1000, 1000));
+        assertEquals(new AABB(37.5, 49.625, 57.5, 42.5, 54.625, 62.5), fixture.refresh(captured));
+    }
+
+    @Test
+    void normalPhaseAdvancesOnceAndReplayDoesNotAdvanceTheLiveInterpolator() {
+        final var fixture = new Fixture();
+        fixture.command(1, new Position3f(10, 20, 30), false, false, 0F);
+        final var movement = BedrockActorState.movement(fixture.uuid);
+        BedrockActorState.beforePhysics(fixture.level);
+        assertEquals(2, movement.interpolation().positionSteps());
+        try (var ignored = PhysicalReplayContext.enter(fixture.level, null, Set.of(fixture.actor))) {
+            BedrockActorState.beforePhysics(fixture.level);
+        }
+        assertEquals(2, movement.interpolation().positionSteps());
+    }
+
+    @Test
+    void dimensionAbsenceAndLifetimeRetirementPreserveTheCapturedGeometry() {
+        final var fixture = new Fixture();
+        fixture.command(0, new Position3f(10, 20, 30), true, false, 0F);
+        final var captured = fixture.capture();
+        BedrockActorState.apply(new NativeActorBoundsMessage(fixture.uuid, fixture.lifetime, false, null, 5F), null);
+        assertEquals(RETAINED, fixture.refresh(captured));
+        BedrockActorState.apply(new NativeActorMessage.Remove(fixture.uuid, fixture.lifetime, false), null);
+        assertEquals(RETAINED, fixture.refresh(captured));
+    }
+
+    private static final class Fixture {
+        private final UUID uuid = UUID.randomUUID(), lifetime = UUID.randomUUID();
+        private final ClientLevel level = mock(ClientLevel.class);
+        private final Entity actor = mock(Entity.class);
+        private final CollisionContact.Box region = new CollisionContact.Box(-1000, -1000, -1000, 1000, 1000, 1000);
+
+        private Fixture() {
+            BedrockActorState.apply(new NativeActorMessage.Snapshot(this.uuid, this.lifetime, false, 7,
+                    "minecraft:player", "", 1F, Set.of(), 0, 0, null, Map.of(), 7L), null);
+            BedrockActorState.apply(new NativeActorBoundsMessage(this.uuid, this.lifetime, false, 5F, 5F), null);
+            when(this.actor.level()).thenReturn(this.level);
+            when(this.actor.getId()).thenReturn(7);
+            when(this.actor.getUUID()).thenReturn(this.uuid);
+            when(this.actor.position()).thenReturn(Vec3.ZERO);
+            when(this.actor.getBoundingBox()).thenReturn(RETAINED);
+            when(this.level.getEntity(7)).thenReturn(this.actor);
+        }
+
+        private void command(final long revision, final Position3f position, final boolean prediction, final boolean controlled, final float offset) {
+            BedrockActorState.apply(new ActorSpatialCommand(ActorSpatialCommand.Action.MOVE, 7, this.uuid, this.lifetime, false, revision, position,
+                    (short) 0, 3, prediction, false, controlled, offset), null);
+        }
+
+        private PhysicalCollisionCache.Snapshot capture() {
+            return new PhysicalCollisionCache.Snapshot(Position3f.ZERO, this.region, List.of(PhysicalCollisionCache.Shape.actor(this.actor)));
+        }
+
+        private AABB refresh(final PhysicalCollisionCache.Snapshot captured) {
+            return new PhysicalCollisionCache(Position3f.ZERO, captured).snapshot().shapes().getFirst().bounds();
+        }
+    }
+}
