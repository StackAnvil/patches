+    public FluidPhysicsState {
+        trackers = List.copyOf(trackers);
+        currents = Map.copyOf(currents);
+    }
+
+    public record Tracker(Holder<Fluid> type, double height, boolean eyesInside) {}
+    public record Current(double height, Vec3 current, int count, FluidCurrent.State nativeCurrent) {}
+}
