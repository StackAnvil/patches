+                                               final PotentSulfurBlockEntity blockEntity, final CallbackInfo ci) {
+        BedrockGeyserPhysics.admit(level, position);
+    }
+
+    @WrapOperation(method = "lambda$static$5", at = @At(value = "INVOKE", target = "Lnet/minecraft/world/level/Level;getEntitiesOfClass(Ljava/lang/Class;Lnet/minecraft/world/phys/AABB;Ljava/util/function/Predicate;)Ljava/util/List;"))
+    private static <T extends Entity> List<T> excludeNativeLocalTravel(final Level level, final Class<T> type, final AABB box,
+                                                                      final Predicate<? super T> predicate, final Operation<List<T>> original) {
+        // Core applies native lift during local travel. Java's block ticker must not add a second impulse or reset fall distance.
+        return original.call(level, type, box, (Predicate<T>) entity -> predicate.test(entity)
+                && !(entity instanceof LocalPlayer && BedrockInputPermissions.isBedrockConnection()));
+    }
