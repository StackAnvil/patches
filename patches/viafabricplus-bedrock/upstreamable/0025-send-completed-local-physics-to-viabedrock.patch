+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.vehicle.boat.AbstractBoat;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+import net.raphimc.viabedrock.api.model.PlayerCorrection;
+
+/** The native command changes current kinematics, preserving the restored previous transform. */
+public final class PhysicalMovementCorrection {
+    private PhysicalMovementCorrection() {}
+
+    public static void apply(final Entity actor, final PlayerCorrection correction) {
+        final var position = correction.javaPosition();
+        actor.setPos(position.x(), position.y(), position.z());
+        actor.setDeltaMovement(new Vec3(correction.motion().x(), correction.motion().y(), correction.motion().z()));
+        actor.setOnGround(correction.onGround());
+        if (correction.vehicle()) {
+            actor.setXRot(correction.rotation().x());
+            actor.setYRot(correction.javaYaw());
+            if (correction.angularVelocity() != null && actor instanceof AbstractBoat) {
+                ((PhysicalStateAccess.Boat) actor).correctAngularVelocity(correction.angularVelocity());
+            }
+        }
+        final float halfWidth = actor.getBbWidth() * 0.5F;
+        final float minY = correction.position().y() - correction.originOffset();
+        actor.setBoundingBox(new AABB(correction.position().x() - halfWidth, minY, correction.position().z() - halfWidth,
+                correction.position().x() + halfWidth, minY + actor.getBbHeight(), correction.position().z() + halfWidth));
+    }
+}
