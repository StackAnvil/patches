+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class BedrockVehiclePredictionsTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @Test
+    void leavesOrdinaryJavaAndUnnegotiatedSessionsWithoutOptionalFrames() {
+        final LocalPlayer player = mock(LocalPlayer.class);
+        try (final var permissions = mockStatic(BedrockInputPermissions.class);
+             final var networking = mockStatic(ClientPlayNetworking.class)) {
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            networking.verifyNoInteractions();
+            verifyNoInteractions(player);
+        }
+    }
+
+    @Test
+    void actualPlayRegistrationPairsIdentityAndDropsOldCallbacksAcrossReconnect() {
+        final var listener = mock(ClientPacketListener.class, RETURNS_DEEP_STUBS);
+        when(listener.getLocalGameProfile()).thenReturn(new GameProfile(UUID.randomUUID(), "vehicle-test"));
+        when(listener.hasClientLoaded()).thenReturn(true);
+        when(listener.getConnection().isConnected()).thenReturn(true);
+        final var level = mock(ClientLevel.class, RETURNS_DEEP_STUBS);
+        final var game = mock(Minecraft.class);
+        when(game.getConnection()).thenReturn(listener);
+        final LocalPlayer player = mock(LocalPlayer.class, withSettings().useConstructor(
+                game, level, listener, null, null, Input.EMPTY, false, null, null));
+        final var mount = mock(AbstractBoat.class);
+        final var uuid = UUID.randomUUID();
+        final var lifetime = UUID.randomUUID();
+        when(player.getVehicle()).thenReturn(mount);
+        when(player.getRootVehicle()).thenReturn(mount);
+        when(player.level()).thenReturn(level);
+        when(player.blockPosition()).thenReturn(BlockPos.ZERO);
+        when(player.isAlive()).thenReturn(true);
+        when(mount.level()).thenReturn(level);
+        when(mount.getId()).thenReturn(2);
+        when(mount.getUUID()).thenReturn(uuid);
+        when(mount.blockPosition()).thenReturn(BlockPos.ZERO);
+        when(mount.getControllingPassenger()).thenReturn(player);
+        when(mount.isLocalInstanceAuthoritative()).thenReturn(true);
+        when(mount.isAlive()).thenReturn(true);
+        when(mount.getDeltaMovement()).thenReturn(new Vec3(-.125, .25, .375));
+        when(level.getEntity(2)).thenReturn(mount);
+        when(level.hasChunkAt(any())).thenReturn(true);
+        final var actor = new NativeActorMessage.Snapshot(uuid, lifetime, false, 23, "minecraft:boat", "", 1F,
+                Set.of(), 0, 0, null, Map.of(), -17L);
+        final var context = new VehiclePredictionContext(1, new VehiclePredictionContext.Identity(2, uuid, lifetime, 23, -17));
+        final AtomicReference<ClientPlayNetworking.PlayPayloadHandler<VehiclePredictionContextPayload>> receiver = new AtomicReference<>();
+        try (final var permissions = mockStatic(BedrockInputPermissions.class);
+             final var networking = mockStatic(ClientPlayNetworking.class);
+             final var actors = mockStatic(BedrockActorState.class)) {
+            permissions.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            networking.when(() -> ClientPlayNetworking.canSend(VehiclePredictionPayload.TYPE)).thenReturn(true);
+            networking.when(() -> ClientPlayNetworking.registerReceiver(eq(VehiclePredictionContextPayload.TYPE), any()))
+                    .thenAnswer(call -> { receiver.set(call.getArgument(1)); return true; });
+            actors.when(BedrockActorState::supportsUniqueIds).thenReturn(true);
+            actors.when(() -> BedrockActorState.state(uuid)).thenReturn(actor);
+            BedrockVehiclePredictions.register();
+            ClientPlayConnectionEvents.INIT.invoker().onPlayInit(listener, game);
+            assertNull(BedrockVehiclePredictions.capture(player, 7));
+            final var callback = mock(ClientPlayNetworking.Context.class);
+            when(callback.client()).thenReturn(game);
+            receiver.get().receive(new VehiclePredictionContextPayload(context), callback);
+            final var frame = BedrockVehiclePredictions.capture(player, 7);
+            assertNotNull(frame);
+            assertEquals(7, frame.frameId());
+            assertEquals(context, frame.context());
+            assertEquals(-.125F, frame.motion().x());
+            receiver.get().receive(new VehiclePredictionContextPayload(context), callback);
+            assertNull(BedrockVehiclePredictions.capture(player, 7));
+            assertNotNull(BedrockVehiclePredictions.capture(player, 8));
+            final var oldReceiver = receiver.get();
+            final var next = mock(ClientPacketListener.class);
+            ClientPlayConnectionEvents.INIT.invoker().onPlayInit(next, game);
+            oldReceiver.receive(new VehiclePredictionContextPayload(context), callback);
+            ClientPlayConnectionEvents.DISCONNECT.invoker().onPlayDisconnect(listener, game);
+            assertNull(BedrockVehiclePredictions.capture(player, 9));
+            when(game.getConnection()).thenReturn(next);
+            receiver.get().receive(new VehiclePredictionContextPayload(context), callback);
+            ClientPlayConnectionEvents.DISCONNECT.invoker().onPlayDisconnect(next, game);
+            assertNull(BedrockVehiclePredictions.capture(player, 10));
+        } finally {
+            ClientPlayConnectionEvents.DISCONNECT.invoker().onPlayDisconnect(listener, game);
+        }
+    }
+
+    @Test
+    void checksJoinedConnectionCapabilitiesAndActorRevisionBeforeSampling() {
+        final var listener = mock(ClientPacketListener.class, RETURNS_DEEP_STUBS);
+        when(listener.getLocalGameProfile()).thenReturn(new GameProfile(UUID.randomUUID(), "vehicle-test"));
+        final var level = mock(ClientLevel.class, RETURNS_DEEP_STUBS);
+        final LocalPlayer player = mock(LocalPlayer.class, withSettings().useConstructor(
+                mock(Minecraft.class), level, listener, null, null, Input.EMPTY, false, null, null));
+        assertSame(listener, player.connection);
+        try (final var permissions = mockStatic(BedrockInputPermissions.class);
+             final var networking = mockStatic(ClientPlayNetworking.class);
+             final var actors = mockStatic(BedrockActorState.class)) {
+            permissions.when(BedrockInputPermissions::isBedrockConnection).thenReturn(true);
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            networking.verifyNoInteractions();
+            when(listener.hasClientLoaded()).thenReturn(true);
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            networking.verifyNoInteractions();
+            when(listener.getConnection().isConnected()).thenReturn(true);
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            actors.verifyNoInteractions();
+            networking.when(() -> ClientPlayNetworking.canSend(VehiclePredictionPayload.TYPE)).thenReturn(true);
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            actors.verify(BedrockActorState::supportsUniqueIds);
+            actors.clearInvocations();
+            actors.when(BedrockActorState::supportsUniqueIds).thenReturn(true);
+            assertNull(BedrockVehiclePredictions.capture(player, 1));
+            verify(player).getVehicle();
+            actors.verify(BedrockActorState::supportsUniqueIds);
+            actors.verifyNoMoreInteractions();
+        }
+    }
+}
