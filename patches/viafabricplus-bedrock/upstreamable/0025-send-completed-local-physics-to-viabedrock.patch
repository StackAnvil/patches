+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+final class PhysicalReplayLifetimeTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    @ParameterizedTest
+    @EnumSource(Retirement.class)
+    void historicalMetadataCannotMakeRetiredActorOrColliderOwnershipValid(final Retirement retirement) {
+        final var fixture = new Fixture();
+        try {
+            BedrockActorState.apply(fixture.original, null);
+            final var captured = fixture.capture();
+            final var physical = fixture.physical();
+            switch (retirement) {
+                case REPLACED -> BedrockActorState.apply(snapshot(fixture.uuid, UUID.randomUUID(), Set.of()), null);
+                case REMOVED -> BedrockActorState.apply(new NativeActorMessage.Remove(fixture.uuid, fixture.lifetime, false), null);
+                case CLEARED -> BedrockActorState.clear();
+            }
+            when(fixture.actor.getBoundingBox()).thenReturn(fixture.retained.move(1, 0, 0));
+            try (var ignored = PhysicalReplayContext.enter(fixture.level, null, Set.of(fixture.actor))) {
+                PhysicalReplayContext.actor(fixture.uuid, fixture.original);
+                assertSame(fixture.original, BedrockActorState.state(fixture.uuid));
+                assertFalse(physical.valid(mock(LocalPlayer.class)));
+                final var replay = new PhysicalCollisionCache(Position3f.ZERO, captured);
+                assertEquals(fixture.retained, replay.snapshot().shapes().getFirst().bounds());
+                assertSame(fixture.original, BedrockActorState.state(fixture.uuid));
+            }
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    @Test
+    void unchangedLiveLifetimeAcceptsOwnershipWhilePhysicsReadsHistoricalMetadata() {
+        final var fixture = new Fixture();
+        try {
+            BedrockActorState.apply(fixture.original, null);
+            final var captured = fixture.capture();
+            final var physical = fixture.physical();
+            final var current = snapshot(fixture.uuid, fixture.lifetime, Set.of(ActorFlags.BLOCKING));
+            BedrockActorState.apply(current, null);
+            final var bounds = fixture.retained.move(1, 0, 0);
+            when(fixture.actor.getBoundingBox()).thenReturn(bounds);
+            BedrockActorState.apply(new ActorSpatialCommand(ActorSpatialCommand.Action.MOVE, 7, fixture.uuid, fixture.lifetime, false, 1,
+                    new Position3f(2.5F, 0F, .5F), (short) 0, 0, true, false, false, 0F), null);
+            try (var ignored = PhysicalReplayContext.enter(fixture.level, null, Set.of(fixture.actor))) {
+                PhysicalReplayContext.actor(fixture.uuid, fixture.original);
+                assertTrue(physical.valid(mock(LocalPlayer.class)));
+                assertEquals(bounds, new PhysicalCollisionCache(Position3f.ZERO, captured).snapshot().shapes().getFirst().bounds());
+                assertSame(fixture.original, BedrockActorState.state(fixture.uuid));
+            }
+            assertSame(current, BedrockActorState.state(fixture.uuid));
+        } finally {
+            BedrockActorState.clear();
+        }
+    }
+
+    private static NativeActorMessage.Snapshot snapshot(final UUID uuid, final UUID lifetime, final Set<ActorFlags> flags) {
+        return new NativeActorMessage.Snapshot(uuid, lifetime, false, 17, "minecraft:boat", "", 1F, flags, 0, 0, null, Map.of(), 29L);
+    }
+
+    @Test
+    void recapturedHistoricalPhysicsKeepsItsOriginalOwnershipAndRejectsTheLiveReplacement() {
+        final var fixture = new Fixture();
+        try {
+            final var current = snapshot(fixture.uuid, UUID.randomUUID(), Set.of());
+            BedrockActorState.apply(current, null);
+            try (var ignored = PhysicalReplayContext.enter(fixture.level, null, Set.of(fixture.actor))) {
+                PhysicalReplayContext.actor(fixture.uuid, fixture.original);
+                final var relationships = PhysicalActorState.relationships(fixture.actor);
+                assertEquals(fixture.lifetime, relationships.nativeLifetime());
