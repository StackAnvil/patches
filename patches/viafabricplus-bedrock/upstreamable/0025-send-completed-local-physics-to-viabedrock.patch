+        return captured != null ? captured : original.call(actor, level, entities, bounds);
+    }
+
+    @WrapMethod(method = "collectCollidersIgnoringWorldBorder(Lnet/minecraft/world/phys/shapes/CollisionContext;Lnet/minecraft/world/level/Level;Ljava/util/List;Lnet/minecraft/world/phys/AABB;)Ljava/util/List;")
