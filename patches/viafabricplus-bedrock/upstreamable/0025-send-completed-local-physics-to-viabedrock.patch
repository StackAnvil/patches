+
+    protected MixinLocalPlayer(final ClientLevel level, final GameProfile profile) {
+        super(level, profile);
+    }
+
+    @Override
+    public void updateSwimming() {
+        if (!BedrockInputPermissions.isBedrockConnection()) {
+            super.updateSwimming();
+        }
+    }
+
+    @Inject(method = "aiStep", at = @At("HEAD"))
+    private void rememberPreviousSwimming(final CallbackInfo ci) {
+        this.viaFabricPlusBedrock$wasSwimming = this.isSwimming();
+    }
+
+    @ModifyExpressionValue(method = "isMovingSlowly", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/player/LocalPlayer;isVisuallyCrawling()Z"))
+    private boolean ignoreSwimmingExitPose(final boolean crawling) {
+        // Java updates the visual pose after travel, so a surface exit can look like crawling for one frame.
+        return crawling && !(BedrockInputPermissions.isBedrockConnection() && this.viaFabricPlusBedrock$wasSwimming);
+    }
+
+    @ModifyExpressionValue(method = "shouldStopSwimSprinting", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/player/ClientInput;hasForwardImpulse()Z"))
+    private boolean retainSprintUntilSwimmingStops(final boolean forward) {
+        // Native checks the previous swimming state before updating this frame's pose.
+        return forward || BedrockInputPermissions.isBedrockConnection();
+    }
+
+    @Inject(method = "aiStep", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/player/AbstractClientPlayer;aiStep()V"))
+    private void updateSwimmingBeforeTravel(final CallbackInfo ci) {
+        if (BedrockInputPermissions.isBedrockConnection()) {
+            if (this.viaFabricPlusBedrock$wasSwimming && !this.canPlayerFitWithinBlocksAndEntitiesWhen(Pose.STANDING)) {
+                // Native cannot leave the swimming pose until its standing-space probe is clear.
+                this.setSwimming(true);
+                return;
+            }
+            super.updateSwimming();
+            final boolean breathingInAir = this.level().getBlockState(BlockPos.containing(this.getEyePosition(0F))).isAir();
+            if (!this.input.hasForwardImpulse()) {
+                this.setSwimming(false);
+            } else if (this.viaFabricPlusBedrock$wasSwimming && breathingInAir
+                    && !BedrockFluidPhysics.canRemainSwimmingAtSurface(this.getLookAngle())
+                    && this.canPlayerFitWithinBlocksAndEntitiesWhen(Pose.STANDING)) {
+                this.setSwimming(false);
+            } else if (!this.viaFabricPlusBedrock$wasSwimming && this.isSwimming()) {
+                final boolean airAboveBodyCenter = this.level().getBlockState(BedrockFluidPhysics.aboveBodyCenter(this.getBoundingBox())).isAir();
