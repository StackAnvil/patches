+public record MovementEffectPayload(MovementEffect effect) implements CustomPacketPayload {
+    public static final Type<MovementEffectPayload> TYPE = new Type<>(Identifier.parse(MovementEffect.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, MovementEffectPayload> CODEC = CustomPacketPayload.codec(
