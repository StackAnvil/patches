+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+
+import java.util.HashMap;
+import java.util.List;
+
+@Mixin(EntityFluidInteraction.class)
+public abstract class MixinEntityFluidPhysicsState implements PhysicalStateAccess.Fluid {
+    @Shadow @Final private List<EntityFluidInteraction.Tracker> fluidTrackers;
+    @Shadow @Final private Reference2ObjectMap<TagKey<Fluid>, EntityFluidInteraction.CurrentAccumulator> currentAccumulators;
+
+    @Override
+    public void captureFluidPhysics(final PhysicalState.Builder state) {
+        final var trackers = this.fluidTrackers.stream()
+                .map(tracker -> ((PhysicalStateAccess.FluidTracker) tracker).captureFluidTracker()).toList();
+        final var currents = new HashMap<TagKey<Fluid>, FluidPhysicsState.Current>();
+        this.currentAccumulators.forEach((tag, current) -> currents.put(tag,
+                ((PhysicalStateAccess.FluidAccumulator) current).captureFluidCurrent()));
+        state.capture(Field.FLUIDS, new FluidPhysicsState(trackers, currents), value -> {
+            this.fluidTrackers.clear();
+            for (var saved : value.trackers()) {
+                final var tracker = new EntityFluidInteraction.Tracker(saved.type());
+                ((PhysicalStateAccess.FluidTracker) tracker).restoreFluidTracker(saved);
+                this.fluidTrackers.add(tracker);
+            }
+            this.currentAccumulators.clear();
+            value.currents().forEach((tag, saved) -> {
+                final var accumulator = new EntityFluidInteraction.CurrentAccumulator();
+                ((PhysicalStateAccess.FluidAccumulator) accumulator).restoreFluidCurrent(saved);
+                this.currentAccumulators.put(tag, accumulator);
+            });
+        });
+    }
+
+    private enum Field { FLUIDS }
+}
