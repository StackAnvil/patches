+import net.minecraft.client.Minecraft;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.player.Player;
+import net.raphimc.viabedrock.api.model.FlightMovement;
+import net.raphimc.viabedrock.api.model.WaterMovement;
+
+public final class BedrockFlightPhysics {
+    private BedrockFlightPhysics() {
+    }
+
+    public static boolean applies(final LocalPlayer player) {
+        return BedrockInputPermissions.isBedrockConnection() && player.getAbilities().flying
+                && com.viaversion.viafabricplus.bedrock.movement.replay.PhysicalReplayContext.camera(Minecraft.getInstance().getCameraEntity()) == player && !player.isPassenger()
+                && BedrockMovementEffects.flightContext(player.getId()) != null;
+    }
+
+    public static boolean retainSwimming(final Player player, final boolean original, final boolean actorSwimming) {
+        return player instanceof LocalPlayer local && applies(local) ? actorSwimming : original;
+    }
+
+    public static boolean isJumping(final Player player) {
+        return FlightMovement.isJumping(player.isJumping(), player instanceof LocalPlayer local && applies(local));
+    }
+
+    public static void applySwimmingControl(final LocalPlayer player) {
+        if (!applies(player) || !player.isSwimming() || !player.isInWater() || isJumping(player)) {
+            return;
+        }
+        final var material = player.level().getBlockState(BlockPos.containing(player.getEyePosition(0F)));
+        final var motion = player.getDeltaMovement();
+        // Normal descent remains WantDown. Java has no independent WantDownSlow binding.
+        final float vertical = WaterMovement.swimmingVertical((float) motion.y,
+                WaterMovement.swimmingLookY(player.getXRot(), player.xRotO),
+                true, true, material.isAir(), material.liquid(), false);
+        player.setDeltaMovement(motion.x, vertical, motion.z);
+    }
+
+    public static void applyInput(final LocalPlayer player) {
+        if (!applies(player)) {
+            return;
+        }
+        ((IBedrockFlightMotion) player).viaFabricPlusBedrock$prepareFlightInput(player.xxa, player.zza);
+        final var motion = player.getDeltaMovement();
+        // Java has no independent slow ascent/descent bindings. Its filtered jump/sneak requests match normal native flight.
+        final float vertical = FlightMovement.verticalInput((float) motion.y, player.xxa, player.zza, true,
+                player.input.keyPresses.jump(), player.input.keyPresses.shift(), false, false,
+                BedrockMovementEffects.flightContext(player.getId()));
+        player.setDeltaMovement(motion.x, vertical, motion.z);
+    }
+}
