+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
+import net.minecraft.resources.Identifier;
+import net.raphimc.viabedrock.api.model.PlayerPrediction;
+
+public record PlayerPredictionPayload(PlayerPrediction prediction) implements CustomPacketPayload {
+    public static final Type<PlayerPredictionPayload> TYPE = new Type<>(Identifier.parse(PlayerPrediction.CHANNEL));
+    public static final StreamCodec<RegistryFriendlyByteBuf, PlayerPredictionPayload> CODEC = CustomPacketPayload.codec(
+        (payload, buffer) -> PlayerPrediction.TYPE.write(buffer, payload.prediction),
+        buffer -> new PlayerPredictionPayload(PlayerPrediction.TYPE.read(buffer)));
+
+    @Override
+    public Type<PlayerPredictionPayload> type() {
+        return TYPE;
+    }
+}
