+    @Test
+    void keepsLiveMotionAndReplaysItAtItsOriginalInputBeforeLaterCorrections() {
+        final var actor = new Actor();
+        actor.completeSixInputs();
+        final var motion = new Position3f(9.25F, -.5F, 1.125F);
+        actor.velocity = motion;
+        assertTrue(actor.history.scheduleMotion(new MovementCorrectionTiming(102, 105, 5, 100, -1), ignored -> true, () -> actor.velocity = motion));
+        assertTrue(actor.history.replay());
+        assertEquals(new Position3f(40.25F, -1.5F, 3.375F), actor.position);
+        assertEquals(new Position3f(13F, -.5F, 1.125F), actor.velocity);
+        // A later correction reexecutes the original velocity command without losing its tick placement.
+        actor.history.schedule(1, ignored -> true, () -> actor.position = Position3f.ZERO, true);
+        assertTrue(actor.history.replay());
+        assertEquals(new Position3f(39F, -1.5F, 3.375F), actor.position);
+        assertEquals(new Position3f(13F, -.5F, 1.125F), actor.velocity);
+    }
+
+    @Test
+    void defersCurrentInputAndDropsHistoricalApplicationAfterAuthorityChanges() {
+        final var actor = new Actor();
+        actor.completeSixInputs();
+        final var velocity = new Position3f(-3F, .5F, 0);
+        actor.velocity = velocity;
+        actor.history.scheduleMotion(new MovementCorrectionTiming(105, 105, 5, 100, -1), ignored -> true, () -> actor.velocity = velocity);
+        assertFalse(actor.history.replay());
+        actor.history.begin(6);
+        assertTrue(actor.history.replay());
+        assertEquals(velocity, actor.velocity);
+        final boolean[] controlled = {true};
+        actor.history.scheduleMotion(new MovementCorrectionTiming(102, 105, 5, 100, -1), ignored -> controlled[0], () -> actor.velocity = Position3f.ZERO);
+        controlled[0] = false;
+        assertFalse(actor.history.replay());
+        assertEquals(velocity, actor.velocity);
+    }
+
+    @Test
+    @EnabledIfEnvironmentVariable(named = "STACKANVIL_NATIVE_TICKED_MOTION", matches = ".+")
+    void matchesOriginalCommandApplicationAndReplayAcrossRetainedClocks() throws Exception {
+        final var reference = JsonParser.parseString(Files.readString(Path.of(System.getenv("STACKANVIL_NATIVE_TICKED_MOTION")))).getAsJsonObject();
+        int compared = 0;
+        for (var value : reference.getAsJsonArray("rows")) {
+            final var row = value.getAsJsonObject();
+            if (!row.get("accept").getAsBoolean()) continue;
+            final var actor = new Actor();
+            actor.completeSixInputs();
+            final var motion = vector(row.getAsJsonArray("motion"));
+            actor.velocity = motion;
+            final long tick = Long.parseUnsignedLong(row.get("tick").getAsString());
+            actor.history.scheduleMotion(new MovementCorrectionTiming(tick, 105, 5, 100, -1), ignored -> true, () -> actor.velocity = motion);
+            actor.history.replay();
+            assertEquals(vector(row.getAsJsonArray("positionAfter")), actor.position);
+            assertEquals(vector(row.getAsJsonArray("afterVector")), actor.velocity);
+            compared++;
+        }
+        assertEquals(reference.get("cases").getAsInt() / 2, compared);
+    }
+
+    private static Position3f vector(final JsonArray values) {
+        return new Position3f(values.get(0).getAsFloat(), values.get(1).getAsFloat(), values.get(2).getAsFloat());
+    }
+
+    private record State(Position3f position, Position3f velocity) {}
+
+    private static final class Actor {
+        private Position3f position = Position3f.ZERO;
+        private Position3f velocity = new Position3f(1, 0, 0);
+        private final PhysicalReplayHistory<State> history = new PhysicalReplayHistory<>(20,
+                this::capture, ignored -> this.capture(), state -> { this.position = state.position; this.velocity = state.velocity; },
+                (previous, next) -> () -> {}, ignored -> true, frame -> {}, frame -> {});
+
+        private State capture() { return new State(this.position, this.velocity); }
+
+        private void completeSixInputs() {
+            for (int frame = 0; frame < 6; frame++) {
+                this.history.begin(frame);
+                final float acceleration = (frame + 1) * .25F;
+                final Runnable physics = () -> { this.velocity = this.velocity.add(acceleration, 0, 0); this.position = this.position.add(this.velocity); };
+                this.history.record(physics);
+                physics.run();
+                this.history.complete(frame);
+            }
+        }
+    }
+}
