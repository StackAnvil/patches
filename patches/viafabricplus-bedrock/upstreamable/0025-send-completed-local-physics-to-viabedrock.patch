+/*
+ * This file is part of ViaFabricPlus Bedrock - https://github.com/ViaVersionAddons/viafabricplus-bedrock
+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.input;
+
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayConnectionEvents;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
+import net.raphimc.viabedrock.api.model.MovementEffectTimeline;
+import net.raphimc.viabedrock.api.model.FlightMovementContext;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.IntPredicate;
+
+public final class BedrockMovementEffects {
+    private static final MovementEffectTimeline TIMELINE = new MovementEffectTimeline();
+    private static final Map<Integer, Float> UNDERWATER_SPEEDS = new HashMap<>();
+    private static final Map<Integer, FlightMovementContext> FLIGHT_CONTEXTS = new HashMap<>();
+
+    private BedrockMovementEffects() {}
+
+    public static void register() {
+        PayloadTypeRegistry.clientboundPlay().register(MovementEffectPayload.TYPE, MovementEffectPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(UnderwaterMovementPayload.TYPE, UnderwaterMovementPayload.CODEC);
+        PayloadTypeRegistry.clientboundPlay().register(FlightMovementPayload.TYPE, FlightMovementPayload.CODEC);
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(MovementEffectPayload.TYPE,
+                (payload, context) -> {
+                    if (context.client().getConnection() == listener) {
+                        TIMELINE.accept(payload.effect());
+                    }
+                }));
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(UnderwaterMovementPayload.TYPE,
+                (payload, context) -> {
+                    if (context.client().getConnection() == listener) {
+                        UNDERWATER_SPEEDS.put(payload.attribute().entityId(), payload.attribute().speed());
+                    }
+                }));
+        ClientPlayConnectionEvents.INIT.register((listener, client) ->
+            ClientPlayNetworking.registerReceiver(FlightMovementPayload.TYPE,
+                (payload, context) -> {
+                    if (context.client().getConnection() == listener) {
+                        FLIGHT_CONTEXTS.put(payload.context().entityId(), payload.context());
+                    }
+                }));
+        ClientPlayConnectionEvents.DISCONNECT.register((listener, client) -> {
+            TIMELINE.clear();
+            UNDERWATER_SPEEDS.clear();
+            FLIGHT_CONTEXTS.clear();
+        });
+        ClientTickEvents.END_CLIENT_TICK.register(client -> {
+            if (client.level != null) {
+                // The local player temporarily leaves the entity index during death and respawn.
+                final IntPredicate present = id -> (client.player != null && client.player.getId() == id)
+                        || client.level.getEntity(id) != null;
+                TIMELINE.retainEntities(present);
+                UNDERWATER_SPEEDS.keySet().removeIf(id -> !present.test(id));
+                FLIGHT_CONTEXTS.keySet().removeIf(id -> !present.test(id));
+            }
+        });
+    }
+
+    public static long completeFrame() {
+        return TIMELINE.completeFrame();
+    }
+
+    public static boolean hasGlideBoost(final int entityId) {
+        return TIMELINE.hasGlideBoost(entityId);
+    }
+
+    public static boolean hasDolphinBoost(final int entityId) {
+        return TIMELINE.hasDolphinBoost(entityId);
+    }
+
+    public static boolean hasGeyserBoost(final int entityId) {
+        return TIMELINE.hasGeyserBoost(entityId);
+    }
+
+    public static void predictGeyserBoost(final int entityId) {
+        TIMELINE.predictGeyserBoost(entityId);
+    }
+
+    public static @Nullable Float underwaterSpeed(final int entityId) {
+        return UNDERWATER_SPEEDS.get(entityId);
+    }
+    public static @Nullable FlightMovementContext flightContext(final int entityId) {
+        return FLIGHT_CONTEXTS.get(entityId);
+    }
+
+}
