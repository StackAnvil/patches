+ * Copyright (C) 2026 ViaVersion and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+package com.viaversion.viafabricplus.bedrock.movement.replay;
+
+import com.viaversion.viafabricplus.bedrock.render.BedrockActorState;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+import net.raphimc.viabedrock.api.model.CollisionContact;
+import net.raphimc.viabedrock.api.model.MovementCollisionQuery;
+import net.raphimc.viabedrock.api.model.NativeMovementSources;
+import net.raphimc.viabedrock.api.model.NativeActorBoundsMessage;
+import net.raphimc.viabedrock.protocol.model.Position3f;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+import java.util.function.Function;
+
+/** Each execution owns its mutable query cache; retained inputs own immutable geometry. */
+public final class PhysicalCollisionCache {
+    private final Position3f position;
+    private CollisionContact.Box bounds;
+    private final List<Shape> shapes = new ArrayList<>();
+
+    public PhysicalCollisionCache(final Position3f position, final Snapshot captured) {
+        this.position = position;
+        if (captured != null && MovementCollisionQuery.reuses(captured.position, position)) {
+            this.bounds = captured.bounds;
+            captured.shapes.forEach(shape -> this.shapes.add(shape.refresh()));
+        }
+    }
+
+    public List<VoxelShape> gather(final CollisionContact.Box requested, final Function<CollisionContact.Box, List<Shape>> fetch) {
+        final var missing = MovementCollisionQuery.missing(requested, this.bounds);
+        if (!missing.isEmpty()) {
+            for (var region : missing) this.shapes.addAll(fetch.apply(region));
+            this.bounds = requested;
+        }
+        return this.shapes.stream().map(shape -> Shapes.create(shape.bounds)).toList();
+    }
+
+    public Snapshot snapshot() {
+        return new Snapshot(this.position, this.bounds, this.shapes);
+    }
+
+    public record Shape(AABB bounds, Owner owner) {
+        public static Shape fixed(final AABB bounds) {
+            return new Shape(bounds, null);
+        }
+
+        public static Shape actor(final Entity actor) {
+            final var movement = BedrockActorState.movement(actor.getUUID());
+            return new Shape(actor.getBoundingBox(), new Owner(actor, actor.level(), actor.getId(), actor.getUUID(),
+                    BedrockActorState.lifetime(actor.getUUID()), movement == null ? NativeMovementSources.Interpolation.EMPTY : movement.interpolation()));
+        }
+
+        private Shape refresh() {
+            if (this.owner == null || !this.owner.valid()) return this;
+            final var movement = BedrockActorState.movement(this.owner.uuid);
+            final var dimensions = BedrockActorState.bounds(this.owner.uuid);
+            final var metadata = BedrockActorState.state(this.owner.uuid);
+            if (movement == null || dimensions == null || metadata == null || dimensions.width() == null || dimensions.height() == null
+                    || !movement.command().lifetime().equals(this.owner.lifetime)) return this;
+            final var point = movement.position(this.owner.interpolation);
+            if (point == null) return this;
+            final CollisionContact.Box refreshed;
+            try {
+                refreshed = NativeMovementSources.bounds(point,
+                        NativeActorBoundsMessage.scaledDimension(dimensions.width(), metadata.scale()),
+                        NativeActorBoundsMessage.scaledDimension(dimensions.height(), metadata.scale()), movement.command().originOffset());
+            } catch (IllegalArgumentException unavailableDimensions) {
+                return this;
+            }
+            return new Shape(new AABB(refreshed.minX(), refreshed.minY(), refreshed.minZ(), refreshed.maxX(), refreshed.maxY(), refreshed.maxZ()), this.owner);
+        }
+    }
+
+    public record Owner(Entity actor, Level level, int id, UUID uuid, UUID lifetime, NativeMovementSources.Interpolation interpolation) {
+        private boolean valid() {
+            return !this.actor.isRemoved() && this.actor.level() == this.level && this.actor.getId() == this.id
+                    && this.actor.getUUID().equals(this.uuid) && this.level.getEntity(this.id) == this.actor
+                    && Objects.equals(BedrockActorState.liveLifetime(this.uuid), this.lifetime);
+        }
+    }
+
+    public record Snapshot(Position3f position, CollisionContact.Box bounds, List<Shape> shapes) {
+        public Snapshot {
+            shapes = List.copyOf(shapes);
+        }
+    }
+}
