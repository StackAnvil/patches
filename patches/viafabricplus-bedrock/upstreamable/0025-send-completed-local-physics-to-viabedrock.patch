+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.tags.FluidTags;
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.material.FlowingFluid;
+import net.minecraft.world.level.material.FluidState;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+
+public final class BedrockFluidPhysics {
+
+    private BedrockFluidPhysics() {
+    }
+
+    public static BlockPos aboveBodyCenter(final AABB box) {
+        // The native trigger calculates its center in single precision before flooring each coordinate.
+        final float x = (float) box.minX + ((float) box.maxX - (float) box.minX) * 0.5F;
+        final float y = (float) box.minY + ((float) box.maxY - (float) box.minY) * 0.5F;
+        final float z = (float) box.minZ + ((float) box.maxZ - (float) box.minZ) * 0.5F;
+        return BlockPos.containing(x, y, z).above();
+    }
+
+    public static boolean shouldCapSwimming(final double lookY, final boolean breathingInLiquid) {
+        return lookY > 0 && !breathingInLiquid;
+    }
+
+    public static boolean isHeadInWater(final BlockGetter level, final Vec3 breathingPoint) {
+        final BlockPos position = BlockPos.containing((float) breathingPoint.x, (float) breathingPoint.y, (float) breathingPoint.z);
+        final FluidState fluid = level.getFluidState(position);
+        if (!fluid.is(FluidTags.WATER)) {
+            return false;
+        }
+        final int depth = fluid.getValue(FlowingFluid.FALLING) ? 8 : 8 - fluid.getAmount();
+        return (float) breathingPoint.y < waterSurface(position.getY(), depth);
+    }
+
+    public static float waterSurface(final int blockY, final int depth) {
+        final int effectiveDepth = depth < 8 ? depth + 1 : 1;
+        // Native adds the block top after the depth division and offset, with float rounding at each step.
+        return (float) (blockY + 1) - (effectiveDepth / 9F - 1F / 9F);
+    }
+
+    public static boolean shouldSuppressLiquidJump(final float swimAmount, final boolean swimming, final boolean headInWater) {
+        return swimming && !headInWater || swimAmount > 0F && swimAmount < 1F;
+    }
+
+    public static boolean canRemainSwimmingAtSurface(final Vec3 look) {
+        final float x = (float) look.x;
+        final float z = (float) look.z;
+        final float angle = (float) Math.acos(x * x + z * z) * Mth.RAD_TO_DEG;
+        return angle <= 45F || look.y <= 0;
+    }
+
+    public static boolean canStartSwimming(final double lookY, final boolean breathingInAir, final boolean airAboveBodyCenter) {
+        return lookY < 0.15F || (!breathingInAir && !airAboveBodyCenter);
+    }
+
+    public static AABB interactionBox(final AABB box) {
+        final double inset = Math.min(0.4, box.getYsize() * 0.5);
+        return new AABB(box.minX, box.minY + inset, box.minZ, box.maxX, box.maxY - inset, box.maxZ);
+    }
+
+}
