-        return this.isSprintingPossible(allowedInShallowWater || BedrockInputPermissions.isBedrockConnection() && (instance.isSwimming() || instance.onGround()));
+        return this.isSprintingPossible(allowedInShallowWater || BedrockInputPermissions.isBedrockConnection());
     }
 
