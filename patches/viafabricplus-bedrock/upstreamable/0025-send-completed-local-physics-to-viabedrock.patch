+package com.viaversion.viafabricplus.bedrock.movement;
+
+import net.minecraft.core.Direction;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.shapes.Shapes;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class BedrockClimbingPhysicsTest {
+
+    @Test
+    void advancesJumpClimbingBeforeGravityRatherThanMovingByThePreviousDampedImpulse() {
+        double position = 250;
+        double motion = -0.0784F;
+        for (int tick = 0; tick < 40; tick++) {
+            final double movement = BedrockClimbingPhysics.beforeMovement(motion, true, false);
+            position += movement;
+            motion = BedrockClimbingPhysics.afterGravity((movement - 0.08F) * 0.98F, false);
+            assertEquals(0.11760000884532928, motion, 0.00000001);
+        }
+        assertEquals(258, position, 0.000001);
+    }
+
+    @Test
+    void clampsNativeDescentAndRetainsSneakingHoldWithoutSuppressingUpwardMotion() {
+        assertEquals(-0.2F, BedrockClimbingPhysics.beforeMovement(-1, false, false));
+        assertEquals(-0.2744F, (BedrockClimbingPhysics.beforeMovement(-1, false, false) - 0.08F) * 0.98F, 0.00000002);
+        assertEquals(0, BedrockClimbingPhysics.beforeMovement(-1, false, true));
+        assertEquals(0.1, BedrockClimbingPhysics.beforeMovement(0.1, false, true));
+        assertEquals(0.2F, BedrockClimbingPhysics.beforeMovement(-1, true, true));
+    }
+
+    @Test
+    void wallContactAppliesItsImpulseAfterGravityAndJumpClimbingRetainsCeilingCollision() {
+        assertEquals(0.2F, BedrockClimbingPhysics.afterGravity(-0.0784F, true));
+        final var body = new AABB(0.2, 0, 0.2, 0.8, 1.8F, 0.8);
+        final double requested = BedrockClimbingPhysics.beforeMovement(-0.0784F, true, false);
+        final double clipped = BedrockCollisionContacts.collide(Shapes.box(0, 1.9, 0, 1, 2.9, 1), Direction.Axis.Y, body, requested);
+        assertEquals(0.1, clipped, 0.000001);
+        assertTrue(clipped < requested);
+        // Entity.restituteMovementAfterCollisions clears velocity at a non-bouncing ceiling.
+        final double collisionMotion = 0;
+        assertEquals(-0.0784F, BedrockClimbingPhysics.afterGravity((collisionMotion - 0.08F) * 0.98F, false), 0.00000001);
+    }
+
+}
