+                                               final PotentSulfurBlockEntity blockEntity, final CallbackInfo ci) {
+        com.viaversion.viafabricplus.bedrock.input.BedrockPhysicalReplay.worldPhysics(level, () -> BedrockGeyserPhysics.admit(level, position));
