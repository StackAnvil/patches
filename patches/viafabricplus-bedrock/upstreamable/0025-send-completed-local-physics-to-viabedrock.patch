+
+final class PhysicalCollisionCacheTest {
+    @BeforeAll
+    static void initializeGame() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    private static List<AABB> boxes(final PhysicalCollisionCache.Snapshot snapshot) {
+        return snapshot.shapes().stream().map(PhysicalCollisionCache.Shape::bounds).toList();
+    }
+
+    @Test
+    void usesCapturedGeometryAfterAWorldChangeAndFetchesFreshGeometryAtTheNativeDistanceBoundary() {
+        final var query = new CollisionContact.Box(-1F, -1F, -1F, 4F, 3F, 1F);
+        final var oldWall = new AABB(1, 0, 0, 2, 2, 1);
+        final var newWall = new AABB(3, 0, 0, 4, 2, 1);
+        final var calls = new AtomicInteger();
+        final var source = new ArrayList<>(List.of(PhysicalCollisionCache.Shape.fixed(oldWall)));
+        final var original = new PhysicalCollisionCache(Position3f.ZERO, null);
+        original.gather(query, ignored -> { calls.incrementAndGet(); return source; });
+        final var captured = original.snapshot();
+        source.clear();
+        source.add(PhysicalCollisionCache.Shape.fixed(newWall));
+        final var replay = new PhysicalCollisionCache(new Position3f(0.25F, 0F, 0F), captured);
+        final var reused = replay.gather(query, ignored -> { calls.incrementAndGet(); return source; });
+        assertEquals(1, calls.get());
+        assertEquals(List.of(oldWall), reused.stream().map(shape -> shape.bounds()).toList());
+        final var outside = new PhysicalCollisionCache(new Position3f(2F, 0F, 0F), captured);
+        final var refreshed = outside.gather(query, ignored -> { calls.incrementAndGet(); return source; });
+        assertEquals(2, calls.get());
+        assertEquals(List.of(newWall), refreshed.stream().map(shape -> shape.bounds()).toList());
+        assertEquals(List.of(oldWall), boxes(captured));
+    }
+
+    @Test
+    void queriesOnlyTheNewRegionAndKeepsRetainedInputsIndependentOfLaterReplayCaches() {
+        final var first = new CollisionContact.Box(0F, 0F, 0F, 1F, 1F, 1F);
+        final var second = new CollisionContact.Box(0F, 0F, 0F, 2F, 1F, 1F);
+        final var oldWall = new AABB(0, 0, 0, 0.25, 1, 1);
+        final var addedWall = new AABB(1.5, 0, 0, 1.75, 1, 1);
+        final var original = new PhysicalCollisionCache(Position3f.ZERO, null);
+        original.gather(first, ignored -> List.of(PhysicalCollisionCache.Shape.fixed(oldWall)));
+        final var captured = original.snapshot();
+        final var replay = new PhysicalCollisionCache(new Position3f(0.5F, 0F, 0F), captured);
+        final List<CollisionContact.Box> queries = new ArrayList<>();
+        replay.gather(second, region -> { queries.add(region); return List.of(PhysicalCollisionCache.Shape.fixed(addedWall)); });
+        assertEquals(List.of(new CollisionContact.Box(1.00001F, 0.00001F, 0.00001F, 2F, 1F, 1F)), queries);
+        assertEquals(List.of(oldWall, addedWall), boxes(replay.snapshot()));
+        assertEquals(List.of(oldWall), boxes(captured));
+        replay.gather(second, region -> { fail(); return List.of(); });
+        final var again = new PhysicalCollisionCache(new Position3f(0.5F, 0F, 0F), captured);
+        again.gather(first, region -> { fail(); return List.of(); });
+        assertEquals(List.of(oldWall), boxes(again.snapshot()));
+    }
+
+    @Test
+    void refreshesMovingColliderGeometryWithoutFollowingRecycledIdsOrMutatingCapturedShapes() {
+        try (var metadata = mockStatic(BedrockActorState.class)) {
+            final Entity collider = mock(Entity.class);
+            final ClientLevel level = mock(ClientLevel.class);
+            final UUID uuid = UUID.randomUUID(), lifetime = UUID.randomUUID();
+            when(collider.level()).thenReturn(level);
+            when(collider.getId()).thenReturn(7);
+            when(collider.getUUID()).thenReturn(uuid);
+            when(level.getEntity(7)).thenReturn(collider);
+            metadata.when(() -> BedrockActorState.lifetime(uuid)).thenReturn(lifetime);
+            metadata.when(() -> BedrockActorState.liveLifetime(uuid)).thenReturn(lifetime);
+            final var nativeState = new NativeActorMessage.Snapshot(uuid, lifetime, false, 7, "minecraft:boat", "", 1F, Set.of(), 0, 0, null, java.util.Map.of(), 7L);
+            final var movement = new NativeMovementSources(new ActorSpatialCommand(ActorSpatialCommand.Action.MOVE, 7, uuid, lifetime, false, 0,
+                    new Position3f(1.5F, 0F, .5F), (short) 0, 0, true, false, false, 0F));
+            metadata.when(() -> BedrockActorState.state(uuid)).thenReturn(nativeState);
+            metadata.when(() -> BedrockActorState.bounds(uuid)).thenReturn(new NativeActorBoundsMessage(uuid, lifetime, false, 1F, 2F));
+            metadata.when(() -> BedrockActorState.movement(uuid)).thenReturn(movement);
+            final AABB before = new AABB(1, 0, 0, 2, 2, 1), after = before.move(0.5, 0, 0);
+            when(collider.position()).thenReturn(new Vec3(1.5, 0, 0.5));
+            when(collider.getBoundingBox()).thenReturn(before);
+            final var region = new CollisionContact.Box(0F, -1F, -1F, 4F, 3F, 2F);
+            final var captured = new PhysicalCollisionCache.Snapshot(Position3f.ZERO, region,
+                    List.of(PhysicalCollisionCache.Shape.actor(collider)));
+            when(collider.position()).thenReturn(new Vec3(2, 0, 0.5));
+            when(collider.getBoundingBox()).thenReturn(after);
+            movement.apply(new ActorSpatialCommand(ActorSpatialCommand.Action.MOVE, 7, uuid, lifetime, false, 1,
+                    new Position3f(2F, 0F, .5F), (short) 0, 0, true, false, false, 0F));
+            final var moving = new PhysicalCollisionCache(Position3f.ZERO, captured);
+            moving.gather(region, ignored -> { fail(); return List.of(); });
+            assertEquals(List.of(after), boxes(moving.snapshot()));
+            assertEquals(List.of(before), boxes(captured));
+            when(level.getEntity(7)).thenReturn(mock(Entity.class));
+            final var replacement = new PhysicalCollisionCache(Position3f.ZERO, captured);
+            replacement.gather(region, ignored -> { fail(); return List.of(); });
+            assertEquals(List.of(before), boxes(replacement.snapshot()));
+            when(level.getEntity(7)).thenReturn(collider);
+            metadata.when(() -> BedrockActorState.liveLifetime(uuid)).thenReturn(UUID.randomUUID());
+            final var newLifetime = new PhysicalCollisionCache(Position3f.ZERO, captured);
+            newLifetime.gather(region, ignored -> { fail(); return List.of(); });
+            assertEquals(List.of(before), boxes(newLifetime.snapshot()));
+        }
+    }
+
+    @Test
+    void recordsZeroDisplacementCollisionRequestsBeforeTheOrdinaryCollisionCallback() {
+        final Entity actor = mock(Entity.class);
+        final ClientLevel level = mock(ClientLevel.class);
+        when(actor.level()).thenReturn(level);
+        when(actor.position()).thenReturn(Vec3.ZERO);
+        when(actor.getBoundingBox()).thenReturn(new AABB(0, 0, 0, 0.6, 1.8, 0.6));
+        when(actor.maxUpStep()).thenReturn(0.6F);
+        when(level.getWorldBorder()).thenReturn(mock(WorldBorder.class));
+        when(level.getMinY()).thenReturn(-64);
+        when(level.getMaxY()).thenReturn(319);
+        final var chunks = mock(ClientChunkCache.class);
+        when(level.getChunkSource()).thenReturn(chunks);
+        when(chunks.getChunk(anyInt(), anyInt(), eq(ChunkStatus.FULL), eq(false))).thenReturn(mock(LevelChunk.class));
+        final var wall = new AABB(1, 0, 0, 2, 1, 1);
+        when(level.getBlockState(any(BlockPos.class))).thenAnswer(invocation -> {
+            final BlockPos position = invocation.getArgument(0);
+            return position.getX() == 1 && position.getY() == 0 && position.getZ() == 0 ? Blocks.STONE.defaultBlockState() : Blocks.AIR.defaultBlockState();
+        });
+        final var seen = new ArrayList<List<AABB>>();
+        final var step = new PhysicalReplayContext.PhysicalStep(10, Set.of(actor), actor, List.of(), () ->
+                PhysicalCollisions.collide(actor, Vec3.ZERO, motion -> {
+                    seen.add(PhysicalCollisions.collect(level).stream().map(shape -> shape.bounds()).toList());
+                    return motion;
+                }));
+        step.record();
+        clearInvocations(level);
+        when(level.getBlockState(any(BlockPos.class))).thenReturn(Blocks.AIR.defaultBlockState());
+        try (var ignored = PhysicalReplayContext.enter(level, null, Set.of(actor))) {
+            step.replay();
+        }
+        assertEquals(List.of(List.of(wall), List.of(wall)), seen);
+        verify(level, never()).getBlockState(any(BlockPos.class));
+        assertNull(PhysicalCollisions.collect(level));
+    }
+
+    @Test
+    void capturesAndRestoresCollisionInputsThroughActualPhysicalStepScopes() {
+        final Entity actor = mock(Entity.class);
+        final Entity other = mock(Entity.class);
+        when(actor.position()).thenReturn(Vec3.ZERO);
+        final var query = new CollisionContact.Box(0F, 0F, 0F, 2F, 2F, 2F);
+        final var source = new ArrayList<>(List.of(PhysicalCollisionCache.Shape.fixed(new AABB(1, 0, 0, 2, 2, 2))));
+        final var queries = new AtomicInteger();
+        final List<List<AABB>> observed = new ArrayList<>();
+        final var step = new PhysicalReplayContext.PhysicalStep(10, Set.of(actor), actor, List.of(), () -> {
+            assertNull(PhysicalReplayContext.collisions(other));
+            final var cache = PhysicalReplayContext.collisions(actor);
+            assertNotNull(cache);
+            final var shapes = cache.gather(query, ignored -> { queries.incrementAndGet(); return source; });
+            observed.add(shapes.stream().map(shape -> shape.bounds()).toList());
+        });
+        assertNull(PhysicalReplayContext.collisions(actor));
+        step.record();
+        source.clear();
+        when(actor.position()).thenReturn(new Vec3(0.25, 0, 0));
+        try (var ignored = PhysicalReplayContext.enter(null, null, Set.of(actor))) {
+            step.replay();
+            step.replay();
+        }
+        assertEquals(1, queries.get());
+        assertEquals(3, observed.size());
+        assertEquals(observed.getFirst(), observed.get(1));
+        assertEquals(observed.getFirst(), observed.getLast());
+        assertNull(PhysicalReplayContext.collisions(actor));
+    }
+}
